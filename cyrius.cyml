[package]
name = "hisab"
version = "${file:VERSION}"
description = "hisab — higher mathematics library (linear algebra, geometry, calculus, numerical methods)"
license = "GPL-3.0-only"
repository = "https://github.com/MacCracken/hisab"
language = "cyrius"
cyrius = "6.6.2"

[build]
src = "src/main.cyr"
output = "build/hisab"

# `[lib]` declares the bundle layout that `cyrius distlib` writes
# into `dist/hisab.cyr`. The 35 math modules live in `src/` (the
# library source); `lib/` holds only vendored stdlib + first-party
# deps managed by `cyrius deps`. Order = dependency order:
# foundation → types → transforms → numeric types → geometry →
# calculus → numerical → physics → symbolic. The bundler is a
# strip-include concatenator; every module here is self-contained
# (no `include` lines) and resolves stdlib from the consumer's
# `[deps] stdlib` list.
#
# Bundle weight: 1,103,166 B / 26,457 lines across 35 modules, so
# consumers compile it via [deps.hisab] modules = ["dist/hisab.cyr"].
# All 35 modules ship (collision_core + collision_mesh since 2.2.2).
#
# ⚠ THERE ARE TWO CEILINGS, NOT ONE, AND THIS COMMENT NAMED NEITHER
# OF THEM CORRECTLY. Until 2.11.3 it read "5.4% of cycc 6.5.33's
# 16 MB input_buf", and before 2.11.2 "76.8% of a 1 MB input_buf".
# Both figures describe `_SRC_CAP`, the raw read buffer — but the
# limit that actually REJECTS a source on the consumer path is the
# EXPANDED-source cap, and a TOKEN cap can bind before either.
# Measured on 6.6.1 against 6.5.33, not read off a string:
#
#   expanded source   6.5.33: 8 MB       6.6.1: 24 MB
#   token count       6.5.33: 1,048,576  6.6.1: 4,194,304
#
# A generated 9,002,640 B source is REJECTED by 6.5.33 with
# "expanded source exceeds 8MB (9002660 bytes)" and compiles CLEAN
# through `cyrius check` on 6.6.1 — the PAIR is the measurement; a
# one-sided "it compiled" proves only that the cap exceeds that file,
# which is exactly the shortcut the retired 16 MB figure rested on.
# ⭐ AND THE TOKEN CAP BIT FIRST: an 8,202,798 B source under 6.5.33
# died on "token limit exceeded: needed 1048577, cap is 1048576"
# WITHOUT ever reaching the byte check, so bytes are not the binding
# constraint and a bytes-only headroom claim is the wrong instrument.
# [measured: 2026-09-09]
#
# At ~1.04 MB the bundle is ~4.1% of the 24 MiB expanded ceiling, so
# there is no size pressure on this file either way. **A constant
# derived from a dependency is a measurement, and it goes stale
# silently** — the third consecutive release in which one of these
# numbers moved (1 MB -> 16 MB -> two caps that are neither), the same
# shape as 2.11.1's ALLOC_MAX 256 MiB -> 2 GiB. Re-derive BOTH caps on
# any toolchain bump, and check which one binds.
[lib]
modules = [
    "src/error.cyr",
    "src/f64_util.cyr",
    "src/vec2.cyr",
    "src/vec3.cyr",
    "src/vec4.cyr",
    "src/quat.cyr",
    "src/mat3.cyr",
    "src/mat4.cyr",
    "src/transforms.cyr",
    "src/color.cyr",
    "src/complex.cyr",
    "src/interval.cyr",
    "src/autodiff.cyr",
    "src/tensor.cyr",
    "src/geo.cyr",
    "src/geo_advanced.cyr",
    "src/geo_diff.cyr",
    "src/spatial.cyr",
    "src/collision_core.cyr",
    "src/collision_mesh.cyr",
    "src/calc.cyr",
    "src/calc_ext.cyr",
    "src/num.cyr",
    "src/num_ext.cyr",
    "src/ode.cyr",
    "src/optimize.cyr",
    "src/linalg_ext.cyr",
    "src/linalg_precision.cyr",
    "src/einsum.cyr",
    "src/noise_simplex.cyr",
    "src/lie.cyr",
    "src/lie_ext.cyr",
    "src/diffgeo.cyr",
    "src/symbolic.cyr",
    "src/symbolic_ext.cyr",
]

[deps]
stdlib = [
    "syscalls",
    "string",
    "alloc",
    "str",
    "fmt",
    "vec",
    "io",
    "args",
    "assert",
    "math",
    "ganita",
    "tagged",
    "result",
    "fnptr",
    "bench",
    "callback",
]

[deps.sakshi]
git = "https://github.com/MacCracken/sakshi.git"
tag = "2.5.1"
modules = ["dist/sakshi.cyr"]
