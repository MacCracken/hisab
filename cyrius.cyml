[package]
name = "hisab"
version = "${file:VERSION}"
description = "hisab — higher mathematics library (linear algebra, geometry, calculus, numerical methods)"
license = "GPL-3.0-only"
repository = "https://github.com/MacCracken/hisab"
language = "cyrius"
cyrius = "6.5.33"

[build]
src = "src/main.cyr"
output = "build/hisab"

# `[lib]` declares the bundle layout that `cyrius distlib` writes
# into `dist/hisab.cyr`. The 35 math modules live in `src/` (the
# library source); `lib/` holds only vendored stdlib + first-party
# deps managed by `cyrius deps`. Order = dependency order:
# foundation → types → transforms → numeric types → geometry →
# calculus → numerical → physics → symbolic. The bundler is a
# strip-include concatenator; every module here is self-contained
# (no `include` lines) and resolves stdlib from the consumer's
# `[deps] stdlib` list.
#
# Bundle weight: 898,472 B / 23,311 lines — 5.4% of cycc 6.5.33's
# 16 MB input_buf (15,878,744 B headroom), so consumers compile it
# via `[deps.hisab] modules = ["dist/hisab.cyr"]`. All 35 modules
# ship (collision_core + collision_mesh included since 2.2.2).
#
# ⚠ EVERY FIGURE IN THAT SENTENCE WAS WRONG BEFORE 2.11.2, AND THE
# CEILING WAS THE WORST OF THEM. It read "~786 KB / 21,368 lines —
# 76.8% of cycc 6.5.16's 1 MB input_buf (243,097 B headroom)" and
# the module count above it read 34. cyrius **6.5.22** relocated
# `input_buf` from 0x00000 to 0x4D9D000 and raised `_SRC_CAP` from
# 1 MB to 16,777,216 B — it had been refusing sigil (1,084,265 B),
# mabda (1,259,999 B) and drishti (1,403,806 B) outright. Verified
# here, not read off a comment: a 1,162,472 B source (111% of the
# retired cap) compiles clean through
# `cyrius check --with-deps`. [measured: 2026-08-21]
#
# So the bundle-size pressure that shaped this file is GONE — hisab
# is at 5.4% of the buffer, not 77%. **A constant derived from a
# dependency is a measurement, and it goes stale silently**; this is
# the same shape as 2.11.1's ALLOC_MAX 256 MiB → 2 GiB finding.
# Re-derive both numbers on any toolchain bump.
[lib]
modules = [
    "src/error.cyr",
    "src/f64_util.cyr",
    "src/vec2.cyr",
    "src/vec3.cyr",
    "src/vec4.cyr",
    "src/quat.cyr",
    "src/mat3.cyr",
    "src/mat4.cyr",
    "src/transforms.cyr",
    "src/color.cyr",
    "src/complex.cyr",
    "src/interval.cyr",
    "src/autodiff.cyr",
    "src/tensor.cyr",
    "src/geo.cyr",
    "src/geo_advanced.cyr",
    "src/geo_diff.cyr",
    "src/spatial.cyr",
    "src/collision_core.cyr",
    "src/collision_mesh.cyr",
    "src/calc.cyr",
    "src/calc_ext.cyr",
    "src/num.cyr",
    "src/num_ext.cyr",
    "src/ode.cyr",
    "src/optimize.cyr",
    "src/linalg_ext.cyr",
    "src/linalg_precision.cyr",
    "src/einsum.cyr",
    "src/noise_simplex.cyr",
    "src/lie.cyr",
    "src/lie_ext.cyr",
    "src/diffgeo.cyr",
    "src/symbolic.cyr",
    "src/symbolic_ext.cyr",
]

[deps]
stdlib = [
    "syscalls",
    "string",
    "alloc",
    "str",
    "fmt",
    "vec",
    "io",
    "args",
    "assert",
    "math",
    "ganita",
    "tagged",
    "fnptr",
    "bench",
    "callback",
]

[deps.sakshi]
git = "https://github.com/MacCracken/sakshi.git"
tag = "2.4.11"
modules = ["dist/sakshi.cyr"]
