# The H9 repro (2026-11-09-allocator-scoped-calls-repro.cyr, beside this) switched to the 3.4.2
# scope: each call is one "step" run under hisab_alloc_scope(arena), the arena reset after it, as a
# per-step consumer would; the first step of each is warm-up (the arena's chunks). Exit 0 while no
# call takes global heap after its first step, 1 otherwise.
#
#   cyrius build docs/development/issues/archived/2026-11-09-allocator-scoped-calls-repro-3.4.2.cyr /tmp/h9s
#   /tmp/h9s; echo "exit=$?"
include "dist/hisab.cyr"

var leaking = 0;
var al = 0;
var sink = 0;
var a = 0;
var b = 0;
var q = 0;
var m = 0;
var sa = 0;
var sb = 0;
var nrm = 0;
var dep = 0;
var contacts = 0;
var boxes = 0;

fn sphere_new(x, y, z, r): i64 {
    var s = alloc(16);
    store64(s, hvec3_new(x, y, z));
    store64(s + 8, r);
    return s;
}
fn sphere_support(shape, dir): i64 {
    var r: f64 = load64(shape + 8);
    return hvec3_add(load64(shape), hvec3_scale(hvec3_normalize(dir), r));
}
fn c_add() { sink = hvec3_add(a, b); return 0; }
fn c_cross() { sink = hvec3_cross(a, b); return 0; }
fn c_rot() { sink = hquat_rotate_vec3(q, a); return 0; }
fn c_m3() { sink = m3_mul_vec3(m, a); return 0; }
fn c_gjk() { sink = gjk_epa_3d(&sphere_support, sa, &sphere_support, sb, nrm, dep); return 0; }
fn c_isl() { sink = detect_islands(contacts, 50, 100); return 0; }
fn c_bvh() { sink = bvh_build(boxes, 100); return 0; }

fn measure(name, fp) {
    var grow = 0;
    for (var s = 0; s < 101; s = s + 1) {
        var before = alloc_used();
        var p = hisab_alloc_scope(al);
        fncall0(fp);
        hisab_alloc_scope(p);
        reset_via(al);
        if (s > 0) { grow = grow + (alloc_used() - before); }
    }
    var per = grow / 100;
    if (per > 0) { leaking = leaking + 1; }
    print(name, strlen(name));
    print(": ", 2);
    fmt_int(per);
    println(" bytes of global heap per scoped step, after the first");
    return 0;
}

fn main() {
    alloc_init();
    al = arena_allocator_growable(1 << 20);
    a = hvec3_new(1.0, 2.0, 3.0);
    b = hvec3_new(0.5, -1.0, 2.0);
    q = hquat_from_rotation_z(0.3);
    m = m3_from_quat(q);
    sa = sphere_new(0.0, 0.0, 0.0, 1.0);
    sb = sphere_new(1.5, 0.0, 0.0, 1.0);
    nrm = alloc(8);
    dep = alloc(8);
    contacts = vec_new();
    var up = hvec3_new(0.0, 1.0, 0.0);
    for (var k = 0; k < 50; k = k + 1) {
        vec_push(contacts, contact_new(2 * k, 2 * k + 1, up, 0.01, 0.5, 0.0, 1.0, 1.0));
    }
    boxes = alloc(100 * 8);
    for (var k = 0; k < 100; k = k + 1) {
        var lo = hvec3_new(f64_from(k), 0.0, 0.0);
        var hi = hvec3_new(f64_from(k + 1), 1.0, 1.0);
        store64(boxes + k * 8, geo_aabb_new(lo, hi));
    }
    measure("hvec3_add", &c_add);
    measure("hvec3_cross", &c_cross);
    measure("hquat_rotate_vec3", &c_rot);
    measure("m3_mul_vec3", &c_m3);
    measure("gjk_epa_3d (two spheres)", &c_gjk);
    measure("detect_islands (100 bodies, 50 contacts)", &c_isl);
    measure("bvh_build (100 boxes)", &c_bvh);
    if (leaking > 0) {
        fmt_int(leaking);
        println(" of 7 calls leak");
        return 1;
    }
    println("no call leaks");
    return 0;
}

var r = main();
sys_exit_group(r);
