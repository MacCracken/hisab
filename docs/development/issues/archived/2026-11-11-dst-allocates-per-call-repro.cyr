# Repro for 2026-11-11-dst-allocates-per-call.md (pravash's ledger L6).
#
# A grid fluid solver's DST pressure solve transforms every interior row and column twice per step (a 64² grid:
# 62 + 62 transforms, forward and inverse). num_dst / num_idst allocate on every call, and the bump heap never
# gets it back.
#
#   cyrius build docs/development/issues/archived/2026-11-11-dst-allocates-per-call-repro.cyr /tmp/dst
#   /tmp/dst; echo "exit=$?"
#
# Exit 1 while a call grows the global heap; exit 0 once a transform can run in caller-provided scratch (and this
# repro is switched to it).
include "dist/hisab.cyr"

fn put(s: cstring): i64 {
    print(s, strlen(s));
    return 0;
}

fn measure(n, calls): i64 {
    var row = alloc(n * 8);
    for (var i = 0; i < n; i = i + 1) { var v: f64 = f64_from(i) * 0.01; store64(row + i * 8, v); }
    var before = alloc_used();
    for (var k = 0; k < calls; k = k + 1) {
        var t, e = num_dst(row, n);
        var t2, e2 = num_idst(row, n);
    }
    return (alloc_used() - before) / (calls * 2);
}

fn main(): i64 {
    alloc_init();
    var growth = 0;
    var ns = alloc(24);
    store64(ns, 14);
    store64(ns + 8, 62);
    store64(ns + 16, 126);
    for (var k = 0; k < 3; k = k + 1) {
        var n = load64(ns + k * 8);
        var per = measure(n, 200);
        put("n = ");
        fmt_int(n);
        put(": ");
        fmt_int(per);
        println(" B of global heap per num_dst / num_idst call, never returned");
        growth = growth + per;
    }
    if (growth > 0) { return 1; }
    return 0;
}

var rc = main();
sys_exit_group(rc);
