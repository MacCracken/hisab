# Repro for 2026-11-11-spatial-hash-per-step-rebuild-allocates.md (pravash's request P2, ledger L4),
# switched to 3.4.2's spatial_hash_query_cell_into: exit 0.
#
# SPH rebuilds its neighbour hash every step: clear it, insert every particle, then look up the 27 cells
# around each particle. With hisab's spatial_hash that leaks on every step, after any warm-up:
# `spatial_hash_query_cell` returns a fresh vec per call, and the bump heap never gets it back.
#
#   cyrius build docs/development/issues/archived/2026-11-11-spatial-hash-per-step-rebuild-allocates-repro-3.4.2.cyr /tmp/p2
#   /tmp/p2; echo "exit=$?"
#
# Exit 1 while a step after the first still grows the global heap; exit 0 once a rebuild reuses its storage and a
# query can write into a caller's buffer (and this repro is switched to it).
include "dist/hisab.cyr"

fn put(s: cstring): i64 {
    print(s, strlen(s));
    return 0;
}

fn main(): i64 {
    alloc_init();
    var np = 1000;
    var pts = alloc(np * 8);
    for (var i = 0; i < np; i = i + 1) {
        var fx: f64 = f64_from(i % 10) * 0.05;
        var fy: f64 = f64_from((i / 10) % 10) * 0.05;
        var fz: f64 = f64_from(i / 100) * 0.05;
        store64(pts + i * 8, hvec3_new(fx, fy, fz));
    }
    var sh = spatial_hash_new(0.05);
    var buf = alloc(64 * 8);
    var sink = 0;
    var insert_growth = 0;
    var query_growth = 0;
    for (var s = 0; s < 5; s = s + 1) {
        var a = alloc_used();
        spatial_hash_clear(sh);
        for (var i = 0; i < np; i = i + 1) { spatial_hash_insert(sh, load64(pts + i * 8), i); }
        var b = alloc_used();
        for (var i = 0; i < np; i = i + 1) {
            for (var c = 0; c < 27; c = c + 1) { sink = spatial_hash_query_cell_into(sh, load64(pts + i * 8), buf, 64); }
        }
        var e = alloc_used();
        # Step 0 may grow the hash's own storage; every later step should grow nothing.
        if (s > 0) {
            insert_growth = insert_growth + (b - a);
            query_growth = query_growth + (e - b);
        }
    }
    put("per step after the first, 1,000 particles: clear + insert grew the heap by ");
    fmt_int(insert_growth / 4);
    put(" B, the 27,000 query_cell calls by ");
    fmt_int(query_growth / 4);
    println(" B");
    if (insert_growth + query_growth > 0) { return 1; }
    return 0;
}

var rc = main();
sys_exit_group(rc);
