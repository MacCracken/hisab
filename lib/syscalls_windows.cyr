# syscalls_windows.cyr — Win32 API wrappers for Cyrius PE targets.
# Usage: include "lib/syscalls.cyr" (selector picks this peer when
#        CYRIUS_TARGET_WIN is defined by cycc_win.cyr; do NOT include
#        this file directly).
#
# Shipped v5.5.0 as the Windows-side counterpart to
# lib/syscalls_x86_64_linux.cyr and lib/syscalls_aarch64_linux.cyr.
# Covers the syscall surface that the cyrius PE backend reroutes at
# parse time (syscall(N, ...) → WriteFile / ReadFile / VirtualAlloc
# / ExitProcess etc. via the IAT).
#
# DESIGN NOTE: the SysNr constants below match the LINUX x86_64
# syscall numbers, not Win32 ordinals. This is intentional — the
# cyrius PE backend reroutes `syscall(N, ...)` calls based on N,
# mapping them to the appropriate kernel32.dll / ntdll.dll / etc.
# import at emit time. Keeping the numbers Linux-compatible means
# user code written to the `sys_write(fd, buf, len)` surface
# compiles on both Linux ELF and Windows PE without source changes.
#
# Syscalls WITHOUT a Win32 equivalent (fork, clone, futex, epoll,
# signalfd, etc.) are deliberately omitted — attempting to use
# them on Windows produces an undefined-syscall warning at compile
# time (escalatable to a hard error via `cycc_win --strict`).

# ================================================================
# Syscall numbers — cyrius cross-platform convention
# ================================================================
# These match Linux x86_64 numbers so cross-platform stdlib code
# can use a single constant name. The PE backend reroutes at emit.
enum SysNr {
    SYS_READ = 0;       # → ReadFile (via GetStdHandle for fd 0)
    SYS_WRITE = 1;      # → WriteFile (via GetStdHandle for fd 1/2)
    SYS_OPEN = 2;       # → CreateFileW
    SYS_CLOSE = 3;      # → CloseHandle
    SYS_LSEEK = 8;      # → SetFilePointerEx
    SYS_MMAP = 9;       # → VirtualAlloc(MEM_COMMIT|MEM_RESERVE)
    SYS_BRK = 12;       # → VirtualAlloc (grow-at-end via committed pages)
    SYS_MUNMAP = 11;    # → VirtualFree(MEM_RELEASE)
    SYS_EXIT = 60;      # → ExitProcess
    SYS_EXIT_GROUP = 231; # NOT rerouted — call sys_exit_group(), never syscall(231)
    # v6.5.25 — NOT rerouted (Windows has no ioctl; DeviceIoControl is a different
    # contract and the request codes are Linux device numbers regardless). The constant
    # exists so cross-platform stdlib code that names it can COMPILE for PE: without it,
    # `lib/yukti.cyr`'s CD-ROM eject path made `undefined variable 'SYS_IOCTL'` a HARD
    # ERROR that blocked a PE build of yukti, vani and mabda — measured: rc=1 with 4 error
    # lines, clean rc=0 on Linux. Adding the constant is only safe as of v6.5.25, which
    # made an unrouted LITERAL syscall number return -38/-ENOSYS instead of emitting a raw
    # `0F 05` that traps as STATUS_ILLEGAL_INSTRUCTION (0xC000001D) on Windows; before
    # that, defining this would have swapped a loud compile error for a runtime crash.
    # Callers already handle the failure — yukti checks `if (r < 0)` and reports it.
    SYS_IOCTL = 16;
    # v6.6.5 — same "constant exists so cross-platform source COMPILES" contract as
    # SYS_IOCTL above, and safe for the same reason: since v6.5.25 an unrouted literal
    # syscall number returns -38/-ENOSYS instead of emitting a raw `0F 05` that traps as
    # STATUS_ILLEGAL_INSTRUCTION. NOT rerouted: Windows has no sendmsg/sendto (ws2_32's
    # WSASendMsg is a different contract and takes an OVERLAPPED), no truncate/ftruncate
    # (SetEndOfFile needs a seek first) and no memfd (a named section object is a different
    # object model). The stub wrappers below decline explicitly rather than issuing them.
    # ⚠ SYS_NANOSLEEP is the exception — the PE backend HAS rerouted 35 to kernel32 Sleep
    # since v6.1.17 (ENANOSLEEP_PE), so sys_nanosleep issues it for real.
    SYS_SENDTO = 44;
    SYS_SENDMSG = 46;
    SYS_TRUNCATE = 76;
    SYS_FTRUNCATE = 77;
    SYS_MEMFD_CREATE = 319;
    SYS_NANOSLEEP = 35;
    SYS_SCHED_YIELD = 24;
    # v6.6.6 — the statfs pair, same "the constant exists so cross-platform source COMPILES"
    # contract, and NOT rerouted: Windows has no statfs. GetDiskFreeSpaceExW answers the same
    # question but is a kernel32 import with a different shape (three out-params, no struct,
    # wide path), so a row would be a lie; the stubs below decline explicitly. CHANGELOG [6.6.6]
    SYS_STATFS = 137;
    SYS_FSTATFS = 138;
}

# File descriptors mirror Linux convention. GetStdHandle maps
# STD_INPUT_HANDLE (-10) / STD_OUTPUT_HANDLE (-11) / STD_ERROR_HANDLE
# (-12) to these inside the PE reroute.
enum FdNr {
    STDIN_FD = 0;
    STDOUT_FD = 1;
    STDERR_FD = 2;
}

# Standard open flags (Linux-shaped; PE backend maps to Win32).
# Full fcntl.h subset — arithmetic on these is preserved in the
# reroute so `O_WRONLY | O_CREAT | O_TRUNC` computes correctly
# before translation to CreateFileW's dwDesiredAccess /
# dwCreationDisposition pair.
enum OFlags {
    O_RDONLY = 0;
    O_WRONLY = 1;
    O_RDWR = 2;
    O_CREAT = 64;       # 0100
    O_EXCL = 128;       # 0200
    O_TRUNC = 512;      # 01000
    O_APPEND = 1024;    # 02000
    # ⛔ v6.6.6 — the note that stood here said O_TRUNC and the access mode "are not
    # decoded", filed as a cosmetic gap alongside O_DIRECTORY/O_NOFOLLOW. It was not
    # cosmetic: an undecoded O_TRUNC means `open(p, O_WRONLY|O_CREAT|O_TRUNC)` SUCCEEDS
    # and then leaves the old tail of the file behind, and an undecoded O_APPEND
    # overwrites from offset 0. Silent data loss on every Windows rewrite. EOPEN_PE now
    # decodes the access mode, O_CREAT, O_EXCL, O_TRUNC and O_APPEND (`_pe_open_flags`,
    # src/backend/x86/emit.cyr); pinned by tests/tcyr/crossos/open_flag_translation.tcyr
    # on real cass. CHANGELOG [6.6.6]
    #
    # ⚠ TWO RESIDUAL DIVERGENCES, both from ONE Win32 rule: TRUNCATE_EXISTING is REFUSED
    # (ERROR_INVALID_PARAMETER) unless dwDesiredAccess carries GENERIC_WRITE — measured on
    # real cass; FILE_WRITE_DATA and FILE_APPEND_DATA do NOT satisfy it, and wine does not
    # enforce the rule at all. `_pe_open_flags` therefore adds GENERIC_WRITE whenever it
    # selects that disposition, which buys the POSIX-visible behaviour (the file IS
    # truncated) at the cost of:
    #   · `open(p, O_RDONLY|O_TRUNC)` — the Windows handle can also be written; Linux
    #     returns EBADF for a write on it. No caller in the ecosystem passes that pair.
    #   · `open(p, O_TRUNC|O_APPEND)` WITHOUT O_CREAT — the handle carries GENERIC_WRITE
    #     beside FILE_APPEND_DATA, so NT writes at the file pointer rather than at EOF. The
    #     file has just been truncated, so a single writer sees no difference; a concurrent
    #     appender would. (With O_CREAT the disposition is CREATE_ALWAYS, which needs no
    #     extra access, so the real append survives there.)
    #
    # ⚠ STILL NOT HONOURED, and deliberately so — these two are dwFlagsAndAttributes bits
    # whose Win32 near-equivalents do NOT mean what POSIX means, so mapping them is a
    # semantic decision, not a port: FILE_FLAG_OPEN_REPARSE_POINT opens the symlink
    # instead of REFUSING like O_NOFOLLOW does (lib/sigil.cyr's keyfile path relies on the
    # refusal), and a Windows directory handle cannot be ReadFile'd the way O_DIRECTORY's
    # caller expects. Defined so portable code still compiles.
    #
    # ⛔ AND NAME WHAT THAT COSTS, now that O_EXCL IS honoured. `luks_write_keyfile`
    # (lib/sigil.cyr:3857) opens `O_WRONLY|O_CREAT|O_TRUNC|O_EXCL|O_NOFOLLOW` and treats
    # the refusal as its guarantee that it created the keyfile itself. On PE that becomes
    # CreateFileW CREATE_NEW, which RESOLVES a final reparse point instead of refusing it:
    # measured on real cass 2026-09-19 — CREATE_NEW over a dangling symlink SUCCEEDS and
    # creates the symlink's TARGET, where the same flags on Linux fail (verified both ways
    # with the same source). So on Windows an O_EXCL|O_NOFOLLOW create is NOT the Linux
    # refusal: a pre-planted symlink at the keyfile path redirects the write. A Windows
    # caller that needs the Linux guarantee must stat the path first (FILE_ATTRIBUTE_REPARSE_POINT)
    # or open with FILE_FLAG_OPEN_REPARSE_POINT and check — neither is wired yet. CHANGELOG [6.6.6]
    O_DIRECTORY = 65536;
    O_NOFOLLOW = 131072;
}

# ================================================================
# Wrapper fns — the public surface
# ================================================================
# Thin wrappers around `syscall(N, ...)`. Parse-time rerouting in
# src/backend/pe/emit.cyr picks up each SYS_* and emits the Win32
# equivalent through the IAT.

# Write `count` bytes from `buf` to descriptor `fd`. Rerouted to
# kernel32!WriteFile via the PE IAT at emit time (v5.4.7 reroute).
# For fd 1/2 the PE backend inserts a GetStdHandle(-11/-12) call
# first so the WriteFile `hFile` arg is a real Windows handle.
fn sys_write(fd, buf, count) {
    return syscall(SYS_WRITE, fd, buf, count);
}

# Read up to `count` bytes from `fd` into `buf`. Rerouted to
# kernel32!ReadFile by the PE backend. GetStdHandle(-10) is
# inserted for fd 0 (stdin). Returns bytes read or -1 on error.
fn sys_read(fd, buf, count) {
    return syscall(SYS_READ, fd, buf, count);
}

# Open a file and return a descriptor. Rerouted to
# kernel32!CreateFileW; `flags` (Linux-shaped) is decomposed into
# Win32 `dwDesiredAccess` + `dwCreationDisposition` inside the
# reroute. `mode` is passed as the security-attributes hint
# (usually 0). Returns a handle usable by sys_read/write/close or
# -1 on failure.
fn sys_open(path, flags, mode) {
    return syscall(SYS_OPEN, path, flags, mode);
}

# Close the descriptor `fd`. Rerouted to kernel32!CloseHandle.
# Returns 0 on success, -1 on failure.
fn sys_close(fd) {
    return syscall(SYS_CLOSE, fd);
}

# Seek within `fd`. `whence`: 0=SEEK_SET, 1=SEEK_CUR, 2=SEEK_END.
# Rerouted to kernel32!SetFilePointerEx (the 64-bit-capable form).
# Returns the new offset or -1 on failure.
fn sys_lseek(fd, offset, whence) {
    return syscall(SYS_LSEEK, fd, offset, whence);
}

# Terminate the process with exit code `code`. Rerouted to
# kernel32!ExitProcess (v5.4.4 reroute). Never returns.
fn sys_exit(code) {
    syscall(SYS_EXIT, code);
    return 0;   # unreachable
}

# Terminate every thread in the process — the Linux exit_group(2) peer.
# Routes through SYS_EXIT deliberately: ExitProcess already tears down all
# threads, so on Windows this IS sys_exit. It exists so a portable epilogue
# can call one name on every target. Do NOT issue SYS_EXIT_GROUP here — 231
# has no PE reroute and would emit a raw `0F 05` (illegal instruction).
# CHANGELOG [6.5.6]
fn sys_exit_group(code) {
    syscall(SYS_EXIT, code);
    return 0;   # unreachable
}

# Change the working directory — NOT WIRED on Windows.
#
# There is no SetCurrentDirectoryW reroute, and inventing one is a COMPILER
# change (a new 0xF0xx pseudo-syscall + a PE emitter arm), not a stdlib one.
# Returns -1, the same honest degrade xstat and xrmdir already make on PE.
# Wire the reroute when a consumer actually needs it. CHANGELOG [6.5.7]
fn sys_chdir(path) { return 0 - 1; }

# fchownat — no Windows equivalent (no POSIX uid/gid model). Returns -1, the same
# honest degrade xstat/xrmdir make on PE. CHANGELOG [6.5.7]
fn sys_fchownat(dirfd, path, uid, gid, flags) { return 0 - 1; }

# at-family constants. The Linux values, defined here so the PORTABLE surface is
# complete: this peer is STANDALONE (it does not include syscalls_linux_common.cyr,
# where these live for the Linux/macOS peers), so without them a consumer calling
# sys_fchownat(AT_FDCWD, ...) fails to compile on this target even though the
# wrapper exists. The wrapper is a stub here, so the values are nominal — but
# source portability is the whole point of having the name. CHANGELOG [6.5.7]
var AT_FDCWD = 0 - 100;
var AT_SYMLINK_NOFOLLOW = 256;   # 0x100
var AT_REMOVEDIR = 512;          # 0x200

# VirtualAlloc-backed allocation. The PE reroute intercepts
# syscall(SYS_MMAP, ...) and emits a VirtualAlloc call with
# MEM_COMMIT | MEM_RESERVE + PAGE_READWRITE.
fn sys_mmap(addr, length, prot, flags, fd, offset) {
    return syscall(SYS_MMAP, addr, length, prot, flags, fd, offset);
}

# Release a VirtualAlloc'd region. Rerouted to kernel32!VirtualFree
# with MEM_RELEASE. `length` is ignored for MEM_RELEASE per Win32
# semantics (the whole reservation is released), but the Linux-
# compat surface keeps it for source-level portability.
fn sys_munmap(addr, length) {
    return syscall(SYS_MUNMAP, addr, length);
}

# brk-shaped allocator anchor. Reroutes to VirtualAlloc-based
# growable region so lib/alloc.cyr's bump logic works unchanged.
# See lib/alloc_windows.cyr for the Windows-specific alloc_init
# that bootstraps the heap.
fn sys_brk(addr) {
    return syscall(SYS_BRK, addr);
}

# v6.2.12 (CVE-19 follow-on): real Windows CSPRNG via bcryptprimitives.dll!
# ProcessPrng, reached through the 0xF01A PE reroute (src/backend/pe/emit.cyr +
# x86/emit.cyr). `BOOL ProcessPrng(PBYTE pbData, SIZE_T cbData)` fills `buf` with
# `len` cryptographically-secure bytes and returns nonzero on success; on the
# (practically-never) failure we return -1 so random_bytes() and its
# ws/sandhi/sigil/tls_native consumers fail loudly. NEVER add a weak fallback
# (uninitialised buffer / clock-ns / PID-mix) — a predictable mask/TXID/key is
# worse than a failed op (exactly what CVE-19 closed). `flags` is ignored
# (Linux getrandom flags have no ProcessPrng analog). See
# issues/2026-06-11-windows-entropy-primitive.md.
fn sys_getrandom(buf, len, flags): i64 {
    if (syscall(0xF01A, buf, len) != 0) { return len; }
    return 0 - 1;
}

# v6.3.2: POSIX process/wait/fs ops referenced on shared CLI paths that are
# DEAD on Windows (the CLI spawns via CreateProcessW reroutes, not fork/exec/
# wait). Stubbed so the PE cross-build has no undefined-fn reference under the
# v6.3.2 default reachable-undef hard error. Returns degrade safely (better than
# the pre-v6.3.2 ud2 stub, which would SIGILL if ever hit).
# Windows has no fork(); the CLI spawns via CreateProcessW. Returns -1.
fn sys_fork(): i64 { return 0 - 1; }
# No execve on Windows; CreateProcessW is used instead. Returns -1.
fn sys_execve(path, argv, envp): i64 { return 0 - 1; }
# No POSIX waitpid; process exit is read via GetExitCodeProcess. Returns -1.
fn sys_waitpid(pid, status_ptr, options): i64 { return 0 - 1; }
# POSIX wait-status accessor: on Windows the exit code IS the status. Pass-through.
fn WEXITSTATUS(status): i64 { return status; }
# POSIX wait-status predicate: Windows exits are always "exited" (no signals). 1.
fn WIFEXITED(status): i64 { return 1; }
# POSIX wait-status predicate: no POSIX signals on Windows. 0.
fn WIFSIGNALED(status): i64 { return 0; }
# POSIX wait-status accessor: no terminating signal on Windows. 0.
fn WTERMSIG(status): i64 { return 0; }
# v6.5.19: `cyrius test`'s child deadline polls `sys_waitpid(pid, &st, WNOHANG)`
# and SIGKILLs on expiry (cbt/build.cyr `run_binary_timed`). Both names are
# referenced OUTSIDE any target guard so the shared code stays single-path; on
# Windows the loop is unreachable anyway (`sys_fork` above returns -1, so the poll
# takes the `w < 0` exit on its first pass). Same stub contract as the block above:
# degrade safely rather than leave an undefined reference for the PE cross-build.
var WNOHANG = 1;
# No POSIX signals on Windows; a process is terminated via TerminateProcess
# (PE reroute 0xF01D), not kill(2). Returns -1.
fn sys_kill(pid, sig): i64 { return 0 - 1; }
# chmod has no Windows equivalent (ACL model differs); no-op success.
fn sys_chmod(path, mode): i64 { return 0; }
# Best-effort dup2 stub: returns the requested newfd (handle dup is rerouted).
fn sys_dup2(oldfd, newfd): i64 { return newfd; }
# mkdir — routed to kernel32!CreateDirectoryW by the PE backend's syscall(83)
# reroute (src/backend/pe/emit.cyr _pe_ensure_createdir, v5.11.22). Returns 0 on
# success, -1 on failure. (Was a no-op `return 0` stub through v6.3.42 — VR-01
# surfaced that it never actually created the directory on Windows.)
fn sys_mkdir(path, mode): i64 { return syscall(83, path, mode); }
# unlink — routed to kernel32!DeleteFileW by the PE backend's syscall(87) reroute
# (_pe_ensure_deletef, v5.11.22). Returns 0 on success, -1 on failure. (Was a
# no-op `return 0` stub through v6.3.42 — VR-01 surfaced the file was never deleted.)
fn sys_unlink(path): i64 { return syscall(87, path); }

# --- v6.5.25: raw floor wrappers this STANDALONE peer never defined ---
# This file includes nothing, so it inherits nothing: a name missing here is missing for
# PE entirely, and under the v6.3.2 reachable-undef hard error that is a build failure, not
# a degrade. All three were roadmap band-D (.25) "cass residual" items, and the premise-check
# found the same thing for each: the 0xF0xx REROUTE was already live and shipped, and the
# only missing piece was the wrapper here. No compiler change, no new band slot.

# getpid — 0xF01C (61468) → kernel32!GetCurrentProcessId, live since v6.3.44 and already
# used by lib/process_win.cyr's portable getpid(). Only this raw-floor name was absent, so
# `sys_getpid()` failed to COMPILE for PE while every other peer defines it.
fn sys_getpid(): i64 { return syscall(61468); }
# No POSIX parent-pid on Windows (a process does not retain its parent). Honest degrade,
# matching lib/process_win.cyr's own documented behaviour.
fn sys_getppid(): i64 { return 0 - 1; }

# ================================================================
# Stat buffer contract — v6.5.30
# ================================================================
#
# ⛔ THESE ARE A COMPILE-TIME CONTRACT, NOT A WINDOWS STAT LAYOUT. `xstat` (lib/io.cyr)
# returns **-1 unconditionally** on `CYRIUS_TARGET_WIN` — GetFileAttributesExW is not wired,
# and every correct caller already bails on `r < 0`. Nothing on Windows ever populates a stat
# buffer, so no byte at these offsets is ever read.
#
# They exist because the OTHER four peers all define a `Stat` enum and consumers reference it
# unconditionally. yukti 2.3.8 does exactly that — `var buf[STAT_BUFSZ]` then
# `load32(&buf + STAT_MODE)` — so without these names a PE build of yukti (and of anything
# including it) failed to COMPILE, with `array size identifier must be an enum constant`
# followed by a run of undefined-variable errors. A build failure, not a runtime one.
#
# ⚠ THE HALF-FIX TRAP THIS AVOIDS, which CLAUDE.md records from v6.5.7: adding `STAT_SIZE`
# alone, or only the names in the first error message, leaves the next consumer hitting the
# next missing member. The full set the peers publish is defined here in one go.
#
# Values mirror the x86_64-Linux peer purely so the buffer SIZE contract (144) matches and the
# offsets stay in range; they carry no Windows meaning. If GetFileAttributesExW is ever wired,
# these offsets must be re-derived from what that fills in — do not assume they are already
# right because the code compiles.
enum Stat {
    STAT_MODE = 24;
    STAT_NLINK = 16;
    STAT_UID = 28;
    STAT_GID = 32;
    STAT_SIZE = 48;
    STAT_MTIME = 88;
    STAT_MTIME_NSEC = 96;
    STAT_BUFSZ = 144;
}

# v6.6.6 — the statfs offsets, on exactly the Stat contract argued above and for exactly the
# same reason: every peer that can statfs publishes a `Statfs` enum — the three Linux/macOS
# peers share one in lib/syscalls_linux_common.cyr and agnos has its own, and this peer is
# STANDALONE (it includes neither), so it needs a copy — and yukti's
# `filesystem_usage` writes `var buf[STATFS_BUFSZ]` then `load64(&buf + STATFS_BLOCKS)`
# unconditionally. Without these names a PE build of yukti fails to COMPILE. `sys_statfs`
# below declines with -38, so no byte at these offsets is ever populated on Windows — the
# values mirror the Linux peer only to keep the buffer-size contract identical.
enum Statfs {
    STATFS_BSIZE = 8;
    STATFS_BLOCKS = 16;
    STATFS_BFREE = 24;
    STATFS_BAVAIL = 32;
    STATFS_BUFSZ = 2176;
}

# access(path, mode) — 0xF019 (61465) → kernel32!GetFileAttributesW, live since v6.1.18.
# ⚠ THE REROUTE TAKES AN ALREADY-WIDE (UTF-16) PATH, which is the one non-obvious part; the
# widen loop below is the same shape lib/io.cyr uses for its own CreateFileW calls.
# INVALID_FILE_ATTRIBUTES is 0xFFFFFFFF → the path does not exist (or is unreachable).
# Returns 0 on success and -1 otherwise, the POSIX contract callers expect.
# NOTE: existence only. W_OK is deliberately NOT modelled from FILE_ATTRIBUTE_READONLY —
# a read-only ACL, a directory and a locked file all differ from the DOS attribute bit, and
# a wrong "writable" answer is worse than an unmodelled one. Callers needing write
# permission should attempt the open and handle the failure.
fn sys_access(path, mode): i64 {
    var wp[520];
    var i = 0;
    while (i < 259) {
        var c = load8(path + i);
        store8(&wp + i * 2, c);
        store8(&wp + i * 2 + 1, 0);
        if (c == 0) { i = 259; } else { i = i + 1; }
    }
    store8(&wp + 518, 0);
    store8(&wp + 519, 0);
    var attrs = syscall(61465, &wp);
    if (attrs == 4294967295) { return 0 - 1; }
    return 0;
}

# socketpair — Windows has NO socketpair primitive, and no blocking-accept reroute to build
# a loopback pair from, so this is an honest degrade rather than an emulation. A real one
# needs a NEW PE pseudo-syscall plus fd↔HANDLE namespace decisions — a design-level task,
# NOT the wrapper-parity item the roadmap bundled it with. Filed separately; this line only
# stops the hard compile error, which is what blocked PE builds.
fn sys_socketpair(domain, type, protocol, fds): i64 { return 0 - 1; }

# ── v6.6.5: PE peers for the new lib/syscalls_linux_common.cyr wrappers.
# This peer is STANDALONE (it does not include linux_common), so a PE build of any
# consumer that NAMES one of these would fail with `undefined variable` without them —
# the v6.5.25 SYS_IOCTL shape, one surface wider. Each returns -38/-ENOSYS so a caller's
# `if (r < 0)` check fires; none of them fakes an emulation.
# Send a message over a socket. Declines on Windows: ws2_32's WSASendMsg is a different
# contract (OVERLAPPED + a WSAMSG layout), not a renumber of this one.
fn sys_sendmsg(fd, msghdr, flags): i64 { return 0 - 38; }
# Send a datagram to an address. Declines on Windows for the same reason as sys_sendmsg.
fn sys_sendto(fd, buf, len, flags, dstaddr, dstaddrlen): i64 { return 0 - 38; }
# Set a file's length by descriptor. Declines on Windows: SetEndOfFile truncates at the
# CURRENT file pointer, so an honest peer has to seek first and restore after.
fn sys_ftruncate(fd, length): i64 { return 0 - 38; }
# Set a file's length by path. Declines on Windows, same reason as sys_ftruncate.
fn sys_truncate(path, length): i64 { return 0 - 38; }
# Filesystem statistics by path. Declines on Windows: the nearest peer is GetDiskFreeSpaceExW,
# a kernel32 import with three out-params and a wide path — a different contract, not a
# renumber. Callers already bail on r < 0. v6.6.6.
fn sys_statfs(path, buf): i64 { return 0 - 38; }
# Filesystem statistics by descriptor. Declines on Windows, same reason as sys_statfs.
fn sys_fstatfs(fd, buf): i64 { return 0 - 38; }
# f_bsize accessor — present so cross-platform source compiles for PE. Never reached with a
# populated buffer, because sys_statfs above always declines.
fn statfs_bsize(buf): i64 { return 0; }
# Create an anonymous in-memory file. Declines on Windows: the nearest object is a named
# section (CreateFileMappingW), a different object model with no fd.
fn sys_memfd_create(name, flags): i64 { return 0 - 38; }
# Sleep for a `struct timespec`. REAL on Windows — the PE backend has rerouted syscall(35)
# to kernel32 Sleep since v6.1.17, reading tv_sec/tv_nsec and converting to flat ms.
fn sys_nanosleep(req, rem): i64 { return syscall(SYS_NANOSLEEP, req, rem); }
# Yield the remainder of this thread's timeslice. Declines on Windows: the peer is
# SwitchToThread/Sleep(0), a kernel32 import this backend does not reroute.
fn sys_sched_yield(): i64 { return 0 - 38; }

# v6.4.66 — getpeername / getsockname now route to ws2_32 (was a fail-closed -ENOSYS
# stub v6.4.64→.65). The PE syscall router maps 0xF036 → ws2_32!getpeername and
# 0xF037 → ws2_32!getsockname (src/backend/x86/emit.cyr EGETPEERNAME_PE / EGETSOCKNAME_PE),
# 3-arg, same shape as bind — so sandhi's per-IP rate limiting has a real peer address
# on Windows. Winsock returns 0 on success, SOCKET_ERROR (-1) with WSAGetLastError =
# WSAENOTCONN (10057) on an unconnected socket (NOT the POSIX errno space). Consumers
# still treat <0 as "peer unknown" and fail open — sandhi's peer API already does.
# Closes docs/development/issues/2026-07-14-windows-getpeername-reroute-missing.md
#
# Normalize to the POSIX contract consumers check (`r < 0` = failure): ws2_32
# returns 0 on success (peer written) or SOCKET_ERROR (int -1, which cyrius sees
# ZERO-extended as 0xFFFFFFFF — a POSITIVE value that would defeat a `< 0` check
# and let a caller fabricate a peer, cf. sandhi_server_peer_sockaddr's
# `if (r < 0) return 0`). On failure return `-WSAGetLastError` (negative, and it
# carries the real Winsock error, e.g. -10057 WSAENOTCONN). WSAGetLastError is read
# immediately, before any other call can reset the per-thread last-error.
fn sys_getpeername(fd, addr, addrlen): i64 {
    var r = syscall(61494, fd, addr, addrlen);
    if (r == 0) { return 0; }
    return 0 - syscall(61476);      # -WSAGetLastError (0xF024)
}
# getsockname (0xF037 → ws2_32!getsockname): same normalization as getpeername.
fn sys_getsockname(fd, addr, addrlen): i64 {
    var r = syscall(61495, fd, addr, addrlen);
    if (r == 0) { return 0; }
    return 0 - syscall(61476);
}

# ================================================================
# QueryPerformanceCounter / QueryPerformanceFrequency (v6.6.5)
# ================================================================
# 0xF038 → kernel32!QueryPerformanceCounter(LARGE_INTEGER*)
# 0xF039 → kernel32!QueryPerformanceFrequency(LARGE_INTEGER*)
# (src/backend/x86/emit.cyr EQPC_PE / EQPF_PE, routed in src/frontend/parse_expr.cyr.)
#
# ⛔ WHY: Windows had NO sub-millisecond clock in cyrius at all. `syscall(228)` reroutes
# to kernel32!GetTickCount64, whose counter advances in **15 ms** steps (measured on
# cass, 2026-08-11) — so lib/chrono.cyr's monotonic clock and lib/bench.cyr's timer both
# quantized every duration under 15 ms to 0 or to one whole tick, and the bench
# framework's floor calibrated to 0 because 1,024 GetTickCount64 calls do not move the
# counter. QPC is the documented high-resolution source (its frequency is typically
# 10 MHz on Win10+, i.e. a 100 ns tick) and is monotonic since system start.
#
# Both return BOOL (nonzero = success) and write a 64-bit count at the pointer arg.
# Filed as part of docs/development/issues/2026-09-16-mabda-lib-bench-min-minus-mean-floor.md
# QueryPerformanceCounter(&count): writes the current 64-bit performance count at `ptr`.
# Returns the Win32 BOOL (nonzero = success). Monotonic since system start.
fn sys_qpc(ptr): i64 {
    return syscall(61496, ptr);
}

# QueryPerformanceFrequency(&hz): writes the counter's ticks-per-second at `ptr`.
# Returns the Win32 BOOL. Fixed at boot, so one call per process is enough.
fn sys_qpf(ptr): i64 {
    return syscall(61497, ptr);
}

# Cached frequency. QPF is fixed at boot and documented not to change while the system
# runs, so one call is enough; 0 means "not read yet".
var _sys_qpf_hz = 0;

# Monotonic nanoseconds from QPC. The conversion is split so it cannot overflow: a raw
# `count * 1e9` wraps i64 after ~29 years of uptime at 10 MHz, and after ~9 seconds if a
# machine ever reports a 1 GHz frequency.
#
# ⚠ Falls back to GetTickCount64 × 1e6 if QPF reports a non-positive frequency — that
# cannot happen on any supported Windows, but returning a wrong-scaled count would be
# silent while a 15 ms clock is merely coarse.
fn sys_qpc_ns(): i64 {
    var c[16];
    if (_sys_qpf_hz == 0) {
        store64(&c, 0);
        sys_qpf(&c);
        _sys_qpf_hz = load64(&c);
    }
    if (_sys_qpf_hz <= 0) {
        return syscall(228, 1, &c) * 1000000;
    }
    store64(&c, 0);
    sys_qpc(&c);
    var t = load64(&c);
    return (t / _sys_qpf_hz) * 1000000000 + ((t % _sys_qpf_hz) * 1000000000) / _sys_qpf_hz;
}

# ================================================================
# v6.6.6 — the two raw-floor names a POSIX tool reaches for path work
# ================================================================
#
# ⛔ This peer INCLUDES NOTHING, so a name missing here is missing for PE entirely, and
# under the v6.3.2 reachable-undef hard error that is a BUILD FAILURE, not a degrade.
# `programs/cyrius-init.cyr` named `sys_readlink` and `sys_rename` unguarded, so it did
# not cross-compile to PE at all and `cyrius init` / `cyrius port` were absent from every
# Windows install — the CLI answered `tool not found`. Same shape as the v6.5.25
# getpid/getppid gap, one surface wider. See
# docs/development/issues/archived/2026-09-18-cyrius-init-does-not-build-for-windows.md.
#
# ⛔ AND `sys_readlink` IS DELIBERATELY NOT ONE OF THEM. The first cut of this fix added a
# third wrapper returning -38/ENOSYS, and it was measured to buy nothing: with the
# scaffolder's readlink call now behind `#ifndef CYRIUS_TARGET_WIN`, deleting the stub
# leaves the PE build byte-for-byte the same (rc=0, MZ, 155,648 B, 0 undefined fns). What
# it cost was the diagnostic. `readlink("/proc/self/exe")` is the ONE shape this filing is
# about, and with a -38 stub present that line COMPILES for PE and then silently falls
# back to argv(0) — which on Windows is whatever the parent typed, so a tool that needs
# its own install root gets the wrong directory and scaffolds nothing. That is exactly the
# half-fix `tests/gates/toolchain/cyrius_init_builds_for_pe.sh` exists to forbid, and a
# stub here would have made it compile. The hard error is the feature: it forces the next
# PE consumer to pick `sys_self_exe_w` (below) or `xreadlink` (lib/io.cyr, which already
# degrades to -1 behind its own `#ifdef`), instead of getting a silent wrong answer.
# A REAL readlink — DeviceIoControl + FSCTL_GET_REPARSE_POINT — would be welcome; a stub
# that only makes the wrong code build is not. CHANGELOG [6.6.6].

# rename(old, new) — REAL, not a degrade: 0xF034 (61492) → kernel32!MoveFileExW with
# MOVEFILE_REPLACE_EXISTING, live since v6.4.57 and already the Windows arm of
# lib/io.cyr's portable `file_rename`. Returns 0 on success / -1 on failure (the BOOL is
# folded to the POSIX contract by the emitter), which is what POSIX callers check.
# ⚠ Unlike rename(2) this CAN move across volumes (MOVEFILE_COPY_ALLOWED is not set, so
# it does not; a cross-volume move fails, as rename(2) does with EXDEV).
fn sys_rename(oldpath, newpath): i64 { return syscall(61492, oldpath, newpath); }

# GetModuleFileNameW(NULL, wbuf, cch) — 0xF03A (61498), the Windows source for the full
# path of THIS executable. `cch` is the buffer capacity in WCHARs (wbuf must hold
# cch * 2 bytes); the result is UTF-16LE, and the return value is the WCHAR count written
# (0 on failure). NOT narrowed here — the caller converts with `_args_w2u8`
# (lib/args.cyr), exactly as lib/args_win.cyr does for GetCommandLineW's raw LPWSTR.
#
# ⚠ argv(0) is NOT a substitute and that is why this reroute exists: on Windows argv[0]
# is whatever the parent wrote on the command line, so it can be relative or a bare name,
# and a tool that derives an install root from its own GRANDPARENT directory (the
# scaffolder's templates dir) gets the wrong answer or none. CHANGELOG [6.6.6].
fn sys_self_exe_w(wbuf, cch): i64 { return syscall(61498, wbuf, cch); }
