# autodiff.cyr -- forward-mode automatic differentiation (dual numbers)
# Usage: include "lib/autodiff.cyr"
# Requires: alloc.cyr, math.cyr
#
# A dual number a + beps where eps^2=0.
# Layout: { val: f64, deriv: f64 } = 16 bytes

# ================================================================
# Local constants
# ================================================================

# The smallest MAGNITUDE whose reciprocal is still finite (DBL_MIN). 2.11.0 uses
# it wherever a guard's real job is "can I divide by this", replacing thresholds
# that were about geometry rather than about the division. Same constant and same
# rule as geo.cyr's `_GEO_F64_TINY`; the modules are self-contained by design, so
# each carries its own and the constant gate verifies both.
var _AD_F64_TINY = F64_TINY;   # alias of error.cyr's F64_TINY (DBL_MIN)

#derive(accessors)
public struct Dual { val; deriv; }

#must_use
public fn dual_new(val, deriv) {
    var d = alloc(sizeof(Dual));
    Dual_set_val(d, val);
    Dual_set_deriv(d, deriv);
    return d;
}

# Variable: derivative = 1
#must_use
public fn dual_var(val) { return dual_new(val, F64_ONE); }

# Constant: derivative = 0
#must_use
public fn dual_const(val) { return dual_new(val, 0); }

# ================================================================
# Arithmetic (chain rule propagation)
# ================================================================

#must_use
public fn dual_add(a, b) {
    return dual_new(f64_add(Dual_val(a), Dual_val(b)),
      f64_add(Dual_deriv(a), Dual_deriv(b)));
}

#must_use
public fn dual_sub(a, b) {
    return dual_new(f64_sub(Dual_val(a), Dual_val(b)),
      f64_sub(Dual_deriv(a), Dual_deriv(b)));
}

#must_use
public fn dual_mul(a, b) {
    # (a + a'eps)(b + b'eps) = ab + (a'b + ab')eps
    return dual_new(f64_mul(Dual_val(a), Dual_val(b)),
      f64_add(f64_mul(Dual_deriv(a), Dual_val(b)),
        f64_mul(Dual_val(a), Dual_deriv(b))));
}

# 2.11.0: the guard was `|b| < EPSILON_F64` (1e-12) returning (0, 0) -- it
# fabricated BOTH a value and a derivative where the answer is exactly
# representable. Measured: 1/1e-13 returned 0.0 where the truth is 1e13, and the
# derivative 0.0 where the truth is -1e26. The guard's real job is to avoid a
# division that produces no usable answer, so the threshold is DBL_MIN.
# [measured: docs/development/issues/archived/2026-08-11-forward-mode-dual-guards.md]
#must_use
public fn dual_div(a, b) {
    var bv = Dual_val(b);
    if (f64_lt(f64_abs(bv), _AD_F64_TINY) == 1) { return dual_new(0, 0); }
    var bv2 = f64_mul(bv, bv);
    return dual_new(f64_div(Dual_val(a), bv),
      f64_div(f64_sub(f64_mul(Dual_deriv(a), bv),
          f64_mul(Dual_val(a), Dual_deriv(b))), bv2));
}

#must_use
public fn dual_neg(a) {
    return dual_new(f64_neg(Dual_val(a)), f64_neg(Dual_deriv(a)));
}

# ================================================================
# Elementary functions
# ================================================================

#must_use
public fn dual_sin(a) {
    return dual_new(f64_sin(Dual_val(a)),
      f64_mul(Dual_deriv(a), f64_cos(Dual_val(a))));
}

#must_use
public fn dual_cos(a) {
    return dual_new(f64_cos(Dual_val(a)),
      f64_neg(f64_mul(Dual_deriv(a), f64_sin(Dual_val(a)))));
}

#must_use
public fn dual_exp(a) {
    var e = f64_exp(Dual_val(a));
    return dual_new(e, f64_mul(Dual_deriv(a), e));
}

# 2.11.0: the guard tested `f64_abs(v)`, which is not the domain of ln. Two
# consequences, both measured:
#   * dual_ln(-5) returned (NaN, -0.2) -- a NaN value paired with a CONFIDENT
#     finite derivative, which is worse than either alone, because a caller
#     checking only the derivative sees nothing wrong.
#   * dual_ln(1e-13) returned (0, 0) where the truth is (-29.9336, 1e13).
# The domain of ln is v > 0, and inside it ln is fine all the way to DBL_MIN
# (ln(5e-324) = -744). `f64_gt(v, 0) != 1` rejects negatives, zero AND NaN.
# [measured: docs/development/issues/archived/2026-08-11-forward-mode-dual-guards.md]
#must_use
public fn dual_ln(a) {
    var v = Dual_val(a);
    if (f64_gt(v, 0) != 1) { return dual_new(0, 0); }
    return dual_new(f64_ln(v), f64_div(Dual_deriv(a), v));
}

# 2.11.0: the guard ran AFTER `s = f64_sqrt(v)`, so a negative input was already
# NaN before anything checked it -- dual_sqrt(-4) returned (NaN, NaN). The domain
# test belongs on the INPUT. At v == 0 the derivative is unbounded, so that is a
# miss too; above it, sqrt is fine to DBL_MIN (sqrt(1e-300) = 1e-150, derivative
# 5e149, both finite).
# [measured: docs/development/issues/archived/2026-08-11-forward-mode-dual-guards.md]
#must_use
public fn dual_sqrt(a) {
    var v = Dual_val(a);
    if (f64_gt(v, 0) != 1) { return dual_new(0, 0); }
    var s = f64_sqrt(v);
    return dual_new(s, f64_div(Dual_deriv(a), f64_mul(F64_TWO, s)));
}

# base^n for a plain f64 exponent n -- the power both dual_pow and the tape's ad_pow use,
# for the value AND for the n * base^(n-1) derivative.
#
# ⭐ 3.2.2: EVERY EXPONENT BUT THREE GOES TO `ganita_f64_pow`, AND THE REPEATED-
# MULTIPLICATION LOOP THAT USED TO BE THIS FUNCTION (2.11.0-3.2.1) IS RETIRED. Its last
# stated reason was accuracy: ganita 1.2.4-1.2.7 raised an integral power by binary
# exponentiation, which doubles its relative error at every squaring (0.9^1024 was 137
# ulp out against the loop's 7). ganita 1.2.8 (cyrius 6.6.10) moved every finite case
# onto fdlibm's e_pow core, and against an exact rational oracle over 2088 (base, n)
# pairs -- 36 bases of both signs, integral |n| <= 1024 -- it is within 1 ulp on all of
# them and correctly rounded on 1964, while the loop was worse on 1110 and better on 26,
# by one ulp each. The history of the two earlier reasons is in the CHANGELOG (2.11.0,
# 2.11.2, 2.11.4). [measured: scratch harness, not reproducible in-tree, 2026-09-30]
#
# ⛔ THE LOOP ALSO FABRICATED ZEROS. For a negative n it formed base^|n| and returned
# the reciprocal, so wherever base^|n| overflowed while base^n is a representable
# SUBNORMAL it returned 0: 10^-310 and 2^-1024 both read 0, 201 of 36,864 (base, n)
# pairs over the same bases and every n in -1024..-1. ganita scales a subnormal result
# in one rounding instead. Pinned in tests/modules.tcyr (group "3.2.2 autodiff").
# [measured: scratch harness, not reproducible in-tree, 2026-09-30]
#
# The three kept exponents are the ones whose C99 pow IS a single correctly-rounded
# IEEE operation, special values included: x^1 = x, x^2 = x*x and x^-1 = 1/x give the
# C99 answer for +-0, +-Inf and NaN too (pow(+-0, -1) = +-Inf is 1/+-0). They are as
# accurate as ganita -- 0 ulp on all 36 bases each -- and they are the common ones: a
# call is ~10 ns there against ~180 ns for ganita. At n = 64 the two costs meet, and at
# n = 1024 ganita is ~12x FASTER than the loop was (188 ns vs 2.37 us).
# [measured: scratch harness, not reproducible in-tree, 2026-09-30]
#
# ⚠ A consumer compiles dist/hisab.cyr against ITS OWN toolchain's ganita, so outside
# those three exponents this is that ganita's accuracy: <= 1 ulp from cyrius 6.6.10,
# the binary-exponentiation and exp/ln paths described above below it -- the contract
# every other transcendental in this library already has.
#
# (`AdPowLimit` / `AD_POW_MAX_K`, the old window bound that loop matched, was kept as
# an unused public name through 3.2.2 and removed in 3.3.0.)

fn _ad_pow(base, n) {
    if (f64_eq(n, F64_TWO) == 1) { return f64_mul(base, base); }
    if (f64_eq(n, F64_ONE) == 1) { return base; }
    if (f64_eq(n, f64_neg(F64_ONE)) == 1) { return f64_div(F64_ONE, base); }
    return ganita_f64_pow(base, n);
}

# [measured: docs/development/issues/archived/2026-08-11-forward-mode-dual-guards.md]
#must_use
public fn dual_pow(a, n) {
    # a^n, where n is a plain f64 (not dual)
    var v = _ad_pow(Dual_val(a), n);
    return dual_new(v, f64_mul(Dual_deriv(a),
        f64_mul(n, _ad_pow(Dual_val(a), f64_sub(n, F64_ONE)))));
}

# ⚠ AT v == 0 THE DERIVATIVE DOES NOT EXIST, and this returns the RIGHT-hand one
# (+a'). That is a choice, not a truth, and it is written down rather than left
# for a reader to discover: |x| has a kink at 0 and any single number there is a
# convention. The siblings that face a genuinely non-differentiable point in this
# library -- geo_diff.cyr's jets at an edge or at grazing incidence -- return a
# miss sentinel instead, but Dual has no such sentinel and adding one would
# change every arithmetic op's signature.
#must_use
public fn dual_abs(a) {
    var v = Dual_val(a);
    if (f64_lt(v, 0) == 1) {
        return dual_new(f64_neg(v), f64_neg(Dual_deriv(a)));
    }
    return dual_new(v, Dual_deriv(a));
}

# ================================================================
# REVERSE MODE (tape-based), 2.11.0
# ================================================================
#
# Forward mode above carries ONE seed per evaluation, so a gradient of an
# n-input scalar costs n passes. Reverse mode records the computation once and
# sweeps it backwards once, so the same gradient costs ONE pass regardless of n.
# That is the entire reason this exists, and `bench-history.csv` carries the
# ratio rather than this comment asserting it.
#
# It lives in the SAME module as the duals deliberately. Reverse mode is verified
# against forward mode, so keeping the two together makes that pairing structural
# instead of a convention someone has to remember. ⚠ Agreement between them is
# NOT sufficient on its own -- they share the domain guards below, so agreement
# is partly tautological. What it genuinely tests is the reverse ACCUMULATION
# against the forward PROPAGATION; finite differences remain the independent
# oracle, and the suite checks both modes against them.
#
# TAPE LAYOUT. One node per operation:
#   val   the value produced
#   d1    d(this) / d(input 1)          i1  index of input 1, or AD_NONE
#   d2    d(this) / d(input 2)          i2  index of input 2, or AD_NONE
# A variable or constant is a node with no inputs. Because every node's inputs
# have STRICTLY SMALLER indices, a single descending loop is a valid reverse
# topological order -- no sort, no visited set.

public var AD_NONE = 0 - 1;      # "this input does not exist"
public var AD_FULL = 0 - 2;      # returned by every op when the tape is full

#derive(accessors)
public struct AdTape { nodes; adj; n; cap; }

# 40 bytes per node: val, d1, d2, i1, i2
var _AD_NODE_BYTES = 40;

# ⚠ BOTH BODY ALLOCATIONS ARE CHECKED, and 0 is returned if either fails.
#
# 2.11.1: this returned a NON-ZERO handle whose `nodes` pointer was 0 whenever
# cap * 40 exceeded ALLOC_MAX (2 GiB, i.e. cap > 53,687,091). A caller's
# `if (t != 0)` therefore passed, and the first ad_var SIGSEGVed inside _ad_push
# -- whose only bound is `n >= cap`, which n = 0 satisfies happily. Construction
# is the ONLY place that can catch this.
# [measured: docs/development/issues/archived/2026-08-11-ad-tape-new-null-nodes.md]
#
# Returning 0 is not an invention: the first line already reserves 0 as this
# function's reject value, and it returns a handle rather than an error code so
# there is no HSB_ERR_ALLOC channel to use. No dimension cap is added, for the
# reason the num_ext filing states -- the honest failure is "I could not
# allocate that", not "I refuse sizes above an arbitrary line".
# [measured: docs/development/issues/archived/2026-08-11-ad-tape-new-null-nodes.md]
#must_use
public fn ad_tape_new(cap) {
    if (cap < 1) { return 0; }
    var t = alloc(sizeof(AdTape));
    if (t == 0) { return 0; }
    var nodes = alloc(cap * _AD_NODE_BYTES);
    if (nodes == 0) { return 0; }
    var adj = alloc(cap * 8);
    if (adj == 0) { return 0; }
    AdTape_set_nodes(t, nodes);
    AdTape_set_adj(t, adj);
    AdTape_set_n(t, 0);
    AdTape_set_cap(t, cap);
    return t;
}

# Number of nodes recorded so far.
public fn ad_tape_len(t) { return AdTape_n(t); }

# Reset without reallocating -- the bump allocator never frees, so a caller
# running many gradients reuses one tape rather than leaking one per iteration.
public fn ad_tape_reset(t) {
    AdTape_set_n(t, 0);
    return 0;
}

fn _ad_node(t, i) { return AdTape_nodes(t) + i * _AD_NODE_BYTES; }

# Append a node. Returns its index, or AD_FULL if the tape is full -- checkable,
# never a silently dropped operation.
fn _ad_push(t, val, d1, i1, d2, i2) {
    var n = AdTape_n(t);
    if (n >= AdTape_cap(t)) { return AD_FULL; }
    var p = _ad_node(t, n);
    store64(p, val);
    store64(p + 8, d1);
    store64(p + 16, d2);
    store64(p + 24, i1);
    store64(p + 32, i2);
    AdTape_set_n(t, n + 1);
    return n;
}

# An independent variable: no inputs, so the reverse sweep stops here and its
# accumulated adjoint IS the gradient component.
#must_use
public fn ad_var(t, val) { return _ad_push(t, val, 0, AD_NONE, 0, AD_NONE); }

# A constant: identical shape, named separately so a reader can tell which
# entries of the gradient are meaningful.
#must_use
public fn ad_const(t, val) { return _ad_push(t, val, 0, AD_NONE, 0, AD_NONE); }

# The value at a node, or 0 for an invalid index.
public fn ad_val(t, i) {
    if (i < 0) { return 0; }
    if (i >= AdTape_n(t)) { return 0; }
    return load64(_ad_node(t, i));
}

# 1 when `i` is a usable node index. Every op returns AD_FULL on overflow, and
# that value propagates: an op with a bad input is itself bad.
public fn ad_ok(t, i) {
    if (i < 0) { return 0; }
    if (i >= AdTape_n(t)) { return 0; }
    return 1;
}

# ================================================================
# Reverse-mode operations
# ================================================================
#
# Each records the local partials and nothing else -- the chain rule is applied
# once, later, by ad_grad. ⚠ THE DOMAIN GUARDS MIRROR THE DUAL OPS ABOVE
# EXACTLY, including the repairs 2.11.0 made to them. A guard that differed
# would make "reverse agrees with forward" fail for a reason that has nothing to
# do with the chain rule, which is the one thing that comparison is for.

fn _ad_bad2(t, a, b) {
    if (ad_ok(t, a) == 0) { return 1; }
    if (ad_ok(t, b) == 0) { return 1; }
    return 0;
}

#must_use
public fn ad_add(t, a, b) {
    if (_ad_bad2(t, a, b) == 1) { return AD_FULL; }
    return _ad_push(t, f64_add(ad_val(t, a), ad_val(t, b)), F64_ONE, a, F64_ONE, b);
}

#must_use
public fn ad_sub(t, a, b) {
    if (_ad_bad2(t, a, b) == 1) { return AD_FULL; }
    return _ad_push(t, f64_sub(ad_val(t, a), ad_val(t, b)), F64_ONE, a,
      f64_neg(F64_ONE), b);
}

#must_use
public fn ad_mul(t, a, b) {
    if (_ad_bad2(t, a, b) == 1) { return AD_FULL; }
    var av = ad_val(t, a);
    var bv = ad_val(t, b);
    return _ad_push(t, f64_mul(av, bv), bv, a, av, b);
}

# d(a/b)/da = 1/b,  d(a/b)/db = -a/b^2. Guard as dual_div does: DBL_MIN, because
# the only thing that fails is the division.
#must_use
public fn ad_div(t, a, b) {
    if (_ad_bad2(t, a, b) == 1) { return AD_FULL; }
    var av = ad_val(t, a);
    var bv = ad_val(t, b);
    if (f64_lt(f64_abs(bv), _AD_F64_TINY) == 1) { return _ad_push(t, 0, 0, a, 0, b); }
    var inv = f64_div(F64_ONE, bv);
    return _ad_push(t, f64_mul(av, inv), inv, a,
      f64_neg(f64_mul(av, f64_mul(inv, inv))), b);
}

#must_use
public fn ad_neg(t, a) {
    if (ad_ok(t, a) == 0) { return AD_FULL; }
    return _ad_push(t, f64_neg(ad_val(t, a)), f64_neg(F64_ONE), a, 0, AD_NONE);
}

#must_use
public fn ad_sin(t, a) {
    if (ad_ok(t, a) == 0) { return AD_FULL; }
    var av = ad_val(t, a);
    return _ad_push(t, f64_sin(av), f64_cos(av), a, 0, AD_NONE);
}

#must_use
public fn ad_cos(t, a) {
    if (ad_ok(t, a) == 0) { return AD_FULL; }
    var av = ad_val(t, a);
    return _ad_push(t, f64_cos(av), f64_neg(f64_sin(av)), a, 0, AD_NONE);
}

#must_use
public fn ad_exp(t, a) {
    if (ad_ok(t, a) == 0) { return AD_FULL; }
    var e = f64_exp(ad_val(t, a));
    return _ad_push(t, e, e, a, 0, AD_NONE);
}

# Domain is v > 0 -- the same test dual_ln uses, which rejects negatives, zero
# and NaN alike.
#must_use
public fn ad_ln(t, a) {
    if (ad_ok(t, a) == 0) { return AD_FULL; }
    var av = ad_val(t, a);
    if (f64_gt(av, 0) != 1) { return _ad_push(t, 0, 0, a, 0, AD_NONE); }
    return _ad_push(t, f64_ln(av), f64_div(F64_ONE, av), a, 0, AD_NONE);
}

#must_use
public fn ad_sqrt(t, a) {
    if (ad_ok(t, a) == 0) { return AD_FULL; }
    var av = ad_val(t, a);
    if (f64_gt(av, 0) != 1) { return _ad_push(t, 0, 0, a, 0, AD_NONE); }
    var s = f64_sqrt(av);
    return _ad_push(t, s, f64_div(F64_ONE, f64_mul(F64_TWO, s)), a, 0, AD_NONE);
}

# n is a plain f64, not a tape node -- the same shape as dual_pow, through the same
# _ad_pow, so the two modes agree bit for bit on every exponent.
#must_use
public fn ad_pow(t, a, n) {
    if (ad_ok(t, a) == 0) { return AD_FULL; }
    var av = ad_val(t, a);
    return _ad_push(t, _ad_pow(av, n),
      f64_mul(n, _ad_pow(av, f64_sub(n, F64_ONE))), a, 0, AD_NONE);
}

# ⚠ At 0 the derivative does not exist; this takes the RIGHT-hand one, matching
# dual_abs. See the note there.
#must_use
public fn ad_abs(t, a) {
    if (ad_ok(t, a) == 0) { return AD_FULL; }
    var av = ad_val(t, a);
    if (f64_lt(av, 0) == 1) { return _ad_push(t, f64_neg(av), f64_neg(F64_ONE), a, 0, AD_NONE); }
    return _ad_push(t, av, F64_ONE, a, 0, AD_NONE);
}

# ================================================================
# The reverse sweep
# ================================================================
#
# Seed the root's adjoint with 1 and walk DOWN the tape. Every node's inputs have
# strictly smaller indices, so one descending loop visits each node only after
# every consumer of it has contributed -- no topological sort, no visited set,
# no recursion.
#
#     adj[root] = 1
#     for k = root down to 0:
#         adj[i1(k)] += adj[k] * d1(k)
#         adj[i2(k)] += adj[k] * d2(k)
#
# ONE sweep produces the gradient with respect to EVERY node, which is the whole
# point: an n-input scalar costs one reverse pass here and n forward passes with
# duals. Read the ratio off `bench-history.csv` (`grad_rev_16` against
# `grad_fwd_16`) rather than from this comment.
# [measured: bench-history.csv grad_rev_16]
#
# Returns Ok(0) on success and a negative HSB_ERR_* on a bad root. The adjoints live
# in the tape and are read back with ad_grad_of.
#must_use
# ⚠ COST, AND THE JACOBIAN TRAP IT CREATES. This sweep is O(tape length), twice:
# it clears every adjoint on the tape, then scans from `root` down to index 0.
# Both are the FULL tape, not the part `root` reaches.
# ⛔ So the obvious multi-residual Jacobian driver — build all m residuals on ONE
# shared tape, then call `ad_grad_into` once per residual — is **O(m^2) by
# construction**, because call j scans a tape that already holds all m residuals.
# ⭐ Resetting the tape per residual is O(m) and needs NO new API: `ad_tape_reset`,
# re-push the n inputs, build residual j, sweep. Measured at n = 8, load ~1.0:
#     m      shared      per-tape     ratio
#     256    1214 us       227 us       5x
#     512    4860 us       387 us      12x
#    1024   17779 us       748 us      23x
#    2048   67232 us      1425 us      47x
# Shared QUADRUPLES per doubling of m (4.00x, 3.66x, 3.78x); per-tape DOUBLES
# (1.70x, 1.93x, 1.90x). ⚠ **The ratio is therefore not a constant and must not be
# quoted as one** — 5x at m = 256, 47x at m = 2048, growing without bound. An
# earlier note recorded this as "6.8x faster", which is one point on a curve.
# ⛔ AND THE FIRST VERSION OF THIS TABLE WAS MEASURED ON A TRUNCATED TAPE. It read
# 461/1240/4667/18398 us for the shared driver — about 2.6x low — because the
# probe sized its tape `n + 4*m + 8` while the loop pushes `n + m*n` nodes, so
# `_ad_push` returned AD_FULL for half the residuals and the driver silently
# measured half the work. The benchmark rows shipped with the same bug and the
# same release documented it. **A driver that reports success while overflowing
# its own tape is a benchmark on its own truncated case.** The probe now asserts
# the push did not return AD_FULL.
# [measured: shared vs per-tape drivers, n=8, m=64..2048, correctly-sized tapes]
# ⚠ Halving the clear would not fix it: the SCAN is O(root) on its own, so the
# driver stays quadratic. Making this sub-linear needs a reachability sweep rather
# than a linear scan, which is an algorithm change, not a tuning knob.
# ⚠ The full clear is load-bearing as written: `ad_grad_of(t, i)` for i above
# `root` must read 0, and it has no way to know where the last sweep started.
public fn ad_grad(t, root) {
    if (ad_ok(t, root) == 0) { return Err(HSB_ERR_INVALID_INPUT); }
    var n = AdTape_n(t);
    var adj = AdTape_adj(t);
    # ⚠ Clear the WHOLE tape, not just up to `root`. A caller taking a second
    # gradient from a shorter root would otherwise read the previous sweep's
    # adjoints on every node above it.
    for (var i = 0; i < n; i = i + 1) { store64(adj + i * 8, 0); }
    store64(adj + root * 8, F64_ONE);
    var k = root;
    while (k >= 0) {
        var a = load64(adj + k * 8);
        # Skip nodes the root does not depend on. This is an optimisation, not a
        # correctness condition -- adding 0 * d would be a no-op anyway.
        if (a != 0) {
            var p = _ad_node(t, k);
            var i1 = load64(p + 24);
            var i2 = load64(p + 32);
            if (i1 >= 0) {
                store64(adj + i1 * 8,
                  f64_add(load64(adj + i1 * 8), f64_mul(a, load64(p + 8))));
            }
            if (i2 >= 0) {
                store64(adj + i2 * 8,
                  f64_add(load64(adj + i2 * 8), f64_mul(a, load64(p + 16))));
            }
        }
        k = k - 1;
    }
    return Ok(0);
}

# d(root)/d(node i), valid after ad_grad. Returns 0 for an invalid index, which
# is also the honest answer for a node the root does not depend on.
public fn ad_grad_of(t, i) {
    if (ad_ok(t, i) == 0) { return 0; }
    return load64(AdTape_adj(t) + i * 8);
}

# ================================================================
# Pairing with optimize.cyr
# ================================================================
#
# `opt_gradient_descent`, `opt_conjugate_gradient`, `opt_bfgs` and `opt_lbfgs`
# all take a gradient as `fncall2(grad, x_ptr, out)` -- and that signature needs
# NO change to accept a tape. A capturing closure holds the tape and matches it
# exactly:
#
#     var tape = ad_tape_new(256);
#     var grad = |x, out| {
#         ad_tape_reset(tape);
#         var i0 = ad_var(tape, load64(x));
#         var i1 = ad_var(tape, load64(x + 8));
#         ... build the objective ...
#         var gt, gv = ad_grad_into(tape, root, ids, 2, out);
#         return 0;
#     };
#     var t, v = opt_lbfgs(&f, grad, x0, 2, m, tol, max_iter, out_x, out_fmin);
#
# The optimizers never read the gradient's return value, so the closure binds
# both halves of `ad_grad_into`'s Result and returns 0.
# ⚠ THROUGH 3.3.0 THIS RECIPE ENDED `return ad_grad_into(...)`, and it was wrong
# on every pin from 6.6.3 to 6.6.12: cycc warned about the enclosing fn when the
# closure was built inline, and refused to compile it inside a helper fn
# ("a `: stack` enum returns two values"). The form above builds clean on all of
# them. [measured: scratch harness, not reproducible in-tree, 2026-09-30]
#
# ⚠ AND ON A CONSUMER'S PIN IT CAN STILL CRASH IN THE CALLER'S CODE, NOT HISAB'S.
# A capturing closure called as a BARE STATEMENT, `fncall2(grad, x, g);`, is
# SIGSEGV on cycc 6.6.2-6.6.4 and correct from 6.6.5. Through 3.3.0 every opt_*
# solver called its gradient exactly that way, so this recipe exited 139 inside
# opt_lbfgs under 6.6.3, the pin of six direct consumers, while it converged
# under 6.6.5. Since 3.3.1 hisab binds every such call (see optimize.cyr). A
# caller on 6.6.2-6.6.4 that invokes a closure itself must bind the result too.
# [measured: scratch harness, not reproducible in-tree, 2026-09-30]
# What keeps hisab's index sorts hand-written is tie ORDER, not the closure — see
# `_col_sort_indices_by_xy` and
# issues/archived/2026-08-10-cyrius-capturing-closure-across-fn-boundary.md.
#
# ⚠ NO `ad_minimize` CONVENIENCE IS SHIPPED, and that is a decision. It would put
# a call to optimize.cyr inside autodiff.cyr -- a module dependency that buys a
# caller four lines, in exchange for an ordering constraint in `[lib]` and a
# module that can no longer be read on its own. The closure form above is already
# the whole integration. Revisit if a consumer asks.

# Write d(root)/d(x_k) for the n variable nodes named by `ids` into a flat array.
# `ids` holds the indices returned by ad_var, in the caller's parameter order.
#
# It exists because the alternative is a per-variable
# `store64(out + k * 8, ad_grad_of(t, load64(ids + k * 8)))` at every call site,
# which is exactly the shape an off-by-one hides in.
#must_use
public fn ad_grad_write(t, ids, n, out) {
    if (n < 0) { return Err(HSB_ERR_INVALID_INPUT); }
    for (var k = 0; k < n; k = k + 1) {
        store64(out + k * 8, ad_grad_of(t, load64(ids + k * 8)));
    }
    return Ok(0);
}

# The reverse sweep and the write-back in one call -- the form an optimizer's
# gradient closure wants. Returns 0, or the sweep's error unchanged.
# ⭐ 3.0.0 — THIS FUNCTION HAS NO `HSB_ERR` OF ITS OWN, AND STILL HAD TO MIGRATE.
# It forwards two callees that now return `Result`, so a purely
# grep-for-`return HSB_ERR` pass would have skipped it and left a caller reading
# a tag as a code. `?` is exactly the construct the roadmap wanted here: it
# replaces the manual `if (rc != 0) { return rc; }` chain and propagates the Err
# payload untouched, and the tail `return ad_grad_write(...)` already forwards
# both halves without ceremony.
#must_use
public fn ad_grad_into(t, root, ids, n, out) {
    var rc = ad_grad(t, root)?;
    return ad_grad_write(t, ids, n, out);
}
