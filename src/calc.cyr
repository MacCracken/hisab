# calc.cyr -- calculus, interpolation, easing, noise
# Usage: shipped inside dist/hisab.cyr; in-tree, include "src/calc.cyr" after what it requires
# Requires: src/error.cyr, src/vec2.cyr, src/vec3.cyr (stdlib resolves via cyrius.cyml [deps])

# ================================================================
# CONSTANTS (f64 bit patterns)
# ================================================================

var _CALC_F64_THREE = 0x4008_0000_0000_0000;  # 3.0
var _CALC_F64_FOUR = 0x4010_0000_0000_0000;  # 4.0
var _CALC_F64_FIVE = 0x4014_0000_0000_0000;  # 5.0
var _CALC_F64_SIX = 0x4018_0000_0000_0000;  # 6.0
var _CALC_F64_TEN = 0x4024_0000_0000_0000;  # 10.0
var _CALC_F64_FIFTEEN = 0x402E_0000_0000_0000; # 15.0

# ================================================================
# 1. BASIC CALCULUS
# ================================================================

# Numerical derivative via central difference: (f(x+h) - f(x-h)) / (2h)
# f: function pointer (f64 -> f64), x: f64, h: f64
public fn calc_derivative(f, x, h) {
    var xph = f64_add(x, h);
    var xmh = f64_sub(x, h);
    var fph = fncall1(f, xph);
    var fmh = fncall1(f, xmh);
    return f64_div(f64_sub(fph, fmh), f64_mul(F64_TWO, h));
}

# Trapezoidal rule integration.
# f: function pointer (f64 -> f64), a/b: interval bounds (f64),
# steps: integer count, out: pointer to store f64 result.
# Returns Ok(0) on success, HSB_ERR_ZERO_STEPS if steps == 0,
# HSB_ERR_INVALID_INPUT if steps < 0 (`out` untouched on both). A zero-width
# interval stores exactly +0 without calling f.
#
# ⛔ 3.3.3 — A NEGATIVE STEP COUNT WAS A WRONG ANSWER REPORTED AS Ok (audit D072).
# Only `steps == 0` was refused. A negative count divided the interval by a
# negative number, skipped the summation loop, and stored the half-endpoint
# term: steps = -5 over x^2 on [0,1] stored -0.1 with Ok, where 1/3 is the
# integral. The code is HSB_ERR_INVALID_INPUT, as calc_ext's calc_gradient,
# calc_jacobian and calc_hessian return for a negative dimension; HSB_ERR_ZERO_STEPS
# keeps its one meaning.
# ⛔ 3.3.3 — b == a WITH AN INFINITE f(a) STORED NaN, as Ok: h = 0 and the sum
# is Inf, so `sum * h` is 0 * Inf. The integral over a point is exactly 0. The
# test is the width, b - a == 0, which is a == b for finite endpoints; equal
# infinite endpoints have a NaN width and are left to the arithmetic.
# [measured: steps and zero-width probe on the 3.3.2 bundle, 2026-10-01]
# ⚠ ONLY AN EXACT ZERO WIDTH IS HANDLED. h is also 0 when (b - a) / steps
# underflows at a non-zero width, and that 0 * Inf is not repaired: f = +Inf over
# [0, 2^-1074] with 4 steps stores NaN as Ok, here and on 3.3.2.
# [measured: underflowing-width probe on the 3.3.2 bundle and this tree, 2026-10-01]
# ⭐ 3.0.0 — THE ERROR CHANNEL IS NOW `Result<T, E>`, AND THE OUT-PARAMETERS STAY.
# `Ok(0)` rather than `Ok(value)` is deliberate and mechanical: these functions
# already deliver their result through an out-pointer, and moving it into the Ok
# payload would change two things at once — the error channel AND the value
# contract — in a migration whose whole safety argument rests on changing one.
# The `E` payload is the existing `HSB_ERR_*` code, exactly as the roadmap
# specifies, so nothing about the failure taxonomy moves either.
# ⛔ CALL SITES MUST BIND BOTH HALVES: `var tag, val = f(...)`. A Result in
# ARGUMENT position does not error — `rdx` never reaches a parameter, so the
# callee silently receives the TAG — and since `Ok` tag = 0 and
# `HSB_ERR_NONE` = 0, an old `assert_eq(f(...), HSB_ERR_NONE, "...")` KEEPS
# PASSING WHILE TESTING NOTHING. `scripts/check-result-migration.sh` exists for
# exactly that class and is verified to catch it.
# [measured: tag probe on cycc 6.6.2; 98 such test lines counted pre-migration]
#must_use
public fn calc_integral_trapez(f, a, b, steps, out) {
    if (steps == 0) { return Err(HSB_ERR_ZERO_STEPS); }
    if (steps < 0) { return Err(HSB_ERR_INVALID_INPUT); }
    if (f64_eq(f64_sub(b, a), 0) == 1) {
        store64(out, 0);
        return Ok(0);
    }
    var h = f64_div(f64_sub(b, a), f64_from(steps));
    var fa = fncall1(f, a);
    var fb = fncall1(f, b);
    var sum = f64_mul(F64_HALF, f64_add(fa, fb));
    var i = 1;
    while (i < steps) {
        var xi = f64_add(a, f64_mul(f64_from(i), h));
        sum = f64_add(sum, fncall1(f, xi));
        i = i + 1;
    }
    store64(out, f64_mul(sum, h));
    return Ok(0);
}

# Internal: the class of a NON-FINITE sample for calc_integral_simpson's true-sum rule
# (see the end of its body): 1 for +Inf, 2 for -Inf, 4 for NaN.
fn _calc_nonfinite_class(v) {
    if (f64_eq(v, F64_POS_INF) == 1) { return 1; }
    if (f64_eq(v, 0xFFF0000000000000) == 1) { return 2; }    # -Infinity
    return 4;
}

# Simpson's rule integration. steps is rounded up to even if odd.
# f: function pointer (f64 -> f64), a/b: interval bounds (f64),
# steps: integer count, out: pointer to store f64 result.
# Returns Ok(0) on success, HSB_ERR_ZERO_STEPS if steps == 0,
# HSB_ERR_INVALID_INPUT if steps < 0 or is the one odd count, 2^63 - 1, whose
# round-up does not fit (`out` untouched on all three). A zero-width interval
# stores exactly +0 without calling f.
#
# ⛔ 3.3.3 — THE PAIR OF calc_integral_trapez's NEGATIVE-COUNT REPAIR (audit D072;
# see there): steps = -4 stored -0.0833 and steps = -1 stored -1/3, both as Ok.
# One test serves both cases because it sits AFTER the round-up: Cyrius `%`
# truncates, so a negative odd count has `steps % 2 == -1` and is never rounded
# into range, while 2^63 - 1 rounds up to -2^63 and stored -3.6e-20 as Ok.
# The zero-width repair is trapez's too: b == a with f(a) = +Inf stored NaN.
# [measured: steps and zero-width probe on the 3.3.2 bundle, 2026-10-01]
# So is its limit: only an EXACT zero width is handled, and an h that underflows at
# a non-zero width still forms 0 * Inf — f = +Inf over [0, 2^-1074] with 4 steps
# stores NaN as Ok, here and on 3.3.2.
# [measured: underflowing-width probe on the 3.3.2 bundle and this tree, 2026-10-01]
# An infinite or NaN sample stores the class of the true sum (see the end of the body):
# ±Inf for infinite samples of one sign, NaN for both signs or a NaN sample. Finite
# samples whose weighted sum overflows store NaN, as on 3.3.2.
#must_use
public fn calc_integral_simpson(f, a, b, steps, out) {
    # Round up to even
    if (steps % 2 == 1) { steps = steps + 1; }
    if (steps == 0) { return Err(HSB_ERR_ZERO_STEPS); }
    if (steps < 0) { return Err(HSB_ERR_INVALID_INPUT); }
    if (f64_eq(f64_sub(b, a), 0) == 1) {
        store64(out, 0);
        return Ok(0);
    }
    var h = f64_div(f64_sub(b, a), f64_from(steps));
    var fa = fncall1(f, a);
    var fb = fncall1(f, b);
    var sum = f64_add(fa, fb);
    var comp = 0;  # Neumaier compensation (stored as f64 bits)
    var spec = 0;  # classes of the non-finite samples (see the end of the body)
    if (f64_lt(f64_abs(fa), F64_POS_INF) == 0) { spec = spec | _calc_nonfinite_class(fa); }
    if (f64_lt(f64_abs(fb), F64_POS_INF) == 0) { spec = spec | _calc_nonfinite_class(fb); }

    var i = 1;
    while (i < steps) {
        var xi = f64_add(a, f64_mul(f64_from(i), h));
        var fxi = fncall1(f, xi);
        if (f64_lt(f64_abs(fxi), F64_POS_INF) == 0) { spec = spec | _calc_nonfinite_class(fxi); }

        # Odd indices get coefficient 4, even indices get 2
        var coeff = F64_TWO;
        if (i % 2 == 1) { coeff = _CALC_F64_FOUR; }
        var val = f64_mul(coeff, fxi);

        # Neumaier compensated add
        var t = f64_add(sum, val);
        if (f64_lt(f64_abs(sum), f64_abs(val)) == 0) {
            comp = f64_add(comp, f64_add(f64_sub(sum, t), val));
        } else {
            comp = f64_add(comp, f64_add(f64_sub(val, t), sum));
        }
        sum = t;

        i = i + 1;
    }

    # ⛔ 3.3.3 — ONE INFINITE SAMPLE MADE THE RESULT NaN, where calc_integral_trapez
    # gives +Inf. Once a term is infinite, `t` is too, and the correction above forms
    # Inf - Inf: comp went NaN and so did `sum + comp`. f(0.5) = +Inf, else 1, on
    # [0, 1] with 4 steps stored NaN as Ok. Once a sample is infinite the true sum of
    # the terms does not depend on the finite ones: infinite samples of one sign make
    # it that infinity, and both signs or a NaN sample make it NaN. `spec` collects
    # the classes of the non-finite samples, and only infinite samples of one sign
    # replace the result; every other result is 3.3.2's `sum + comp`, bit for bit,
    # the NaN for both signs or a NaN sample included.
    # [measured: tests/edge_cases.tcyr, group "3.3.3 R3b: simpson with a non-finite sample"]
    # ⚠ FINITE SAMPLES WHOSE SUM OVERFLOWS STAY NaN, AS ON 3.3.2. One weighted sample
    # (2f or 4f) or a running partial sum can pass DBL_MAX while the exact sum is finite
    # and of either sign: samples [0, 0x7FCFFFFFFFFFFFFF, 0xFFE3333333333333,
    # 0x7FCFFFFFFFFFFFFF, 0] on [0, 1] with 4 steps integrate to about +1.2e307, and
    # the plain running sum, which an earlier form of this repair returned for every
    # non-finite sum, gave -Inf as Ok. NaN is the loud answer; overflow is not repaired.
    # [measured: tests/edge_cases.tcyr, group "3.3.3 R5calc: simpson, finite samples whose sum overflows"]
    # Over 60,000 random sample tables (N = 2..64; ordinary, near-overflow, non-finite
    # and smooth large integrands) the 51,235 with every sample finite store 3.3.2's
    # bits (15,607 of them NaN from an overflowed sum), and each of the 8,765 with an
    # infinite or NaN sample stores its true sum's class: +Inf on 1,550, -Inf on 1,574,
    # NaN on 5,641. 3.3.2 stored NaN on all 8,765.
    # [measured: 60,000-table sweep on the 3.3.2 bundle and this tree; 2026-10-01]
    var total = f64_add(sum, comp);
    if (spec == 1) { total = F64_POS_INF; }
    if (spec == 2) { total = 0xFFF0000000000000; }    # -Infinity
    store64(out, f64_div(f64_mul(total, h), _CALC_F64_THREE));
    return Ok(0);
}

# 5-point Gauss-Legendre quadrature over [a, b].
# f: function pointer (f64 -> f64), a/b: interval bounds (f64).
# Returns f64 result directly (cannot fail).
# ⛔ 3.3.3 — THE SAME ZERO-WIDTH 0 * Inf AS calc_integral_trapez's (see there):
# b == a with f(a) = +Inf returned NaN, and a negative integrand -0. A zero-width
# interval now returns exactly +0 without calling f.
# [measured: zero-width probe on the 3.3.2 bundle, 2026-10-01]
# ⚠ Only an EXACT zero width: the half-width (b - a) / 2 underflows to 0 at
# b - a = 2^-1074, and f = +Inf over [0, 2^-1074] still returns NaN, as on 3.3.2.
# [measured: underflowing-width probe on the 3.3.2 bundle and this tree, 2026-10-01]
public fn calc_integral_gauss5(f, a, b) {
    if (f64_eq(f64_sub(b, a), 0) == 1) { return 0; }
    # Nodes on [-1, 1]
    var n0 = 0xBFECFF6CE0533A69;  # -0.906179845938664
    var n1 = 0xBFE13B23FD99B705;  # -0.538469310105683
    var n2 = 0;                     #  0.0
    var n3 = 0x3FE13B23FD99B705;  #  0.538469310105683
    var n4 = 0x3FECFF6CE0533A69;  #  0.906179845938664

    # Weights
    var w0 = 0x3FCE539EC36E038C;  # 0.236926885056189
    var w1 = 0x3FDEA1DA25AE415B;  # 0.478628670499366
    var w2 = 0x3FE23456789ABCDF;  # 0.568888888888889
    var w3 = 0x3FDEA1DA25AE415B;  # 0.478628670499366
    var w4 = 0x3FCE539EC36E038C;  # 0.236926885056189

    var half = f64_mul(f64_sub(b, a), F64_HALF);
    var mid = f64_mul(f64_add(a, b), F64_HALF);

    var s0 = f64_mul(w0, fncall1(f, f64_add(mid, f64_mul(half, n0))));
    var s1 = f64_mul(w1, fncall1(f, f64_add(mid, f64_mul(half, n1))));
    var s2 = f64_mul(w2, fncall1(f, f64_add(mid, f64_mul(half, n2))));
    var s3 = f64_mul(w3, fncall1(f, f64_add(mid, f64_mul(half, n3))));
    var s4 = f64_mul(w4, fncall1(f, f64_add(mid, f64_mul(half, n4))));

    var sum = f64_add(f64_add(f64_add(f64_add(s0, s1), s2), s3), s4);
    return f64_mul(sum, half);
}

# ================================================================
# 2. INTERPOLATION
# ================================================================

# Linear interpolation between two f64 values: a + (b - a) * t
public fn calc_lerp(a, b, t) {
    return f64_add(a, f64_mul(f64_sub(b, a), t));
}

# Quadratic Bezier 2D: B(t) = (1-t)^2*p0 + 2(1-t)t*p1 + t^2*p2
# p0, p1, p2: HVec2 pointers, t: f64
# Returns: HVec2 pointer
public fn calc_bezier_quad_2d(p0, p1, p2, t) {
    var u = f64_sub(F64_ONE, t);
    var uu = f64_mul(u, u);
    var tt = f64_mul(t, t);
    var ut2 = f64_mul(F64_TWO, f64_mul(u, t));

    # x = uu*p0.x + ut2*p1.x + tt*p2.x
    var rx = f64_add(f64_add(
        f64_mul(uu, HVec2_x(p0)),
        f64_mul(ut2, HVec2_x(p1))),
      f64_mul(tt, HVec2_x(p2)));

    var ry = f64_add(f64_add(
        f64_mul(uu, HVec2_y(p0)),
        f64_mul(ut2, HVec2_y(p1))),
      f64_mul(tt, HVec2_y(p2)));

    return hvec2_new(rx, ry);
}

# Cubic Bezier 2D: B(t) = (1-t)^3*p0 + 3(1-t)^2*t*p1 + 3(1-t)*t^2*p2 + t^3*p3
# p0..p3: HVec2 pointers, t: f64
# Returns: HVec2 pointer
public fn calc_bezier_cubic_2d(p0, p1, p2, p3, t) {
    var u = f64_sub(F64_ONE, t);
    var uu = f64_mul(u, u);
    var tt = f64_mul(t, t);
    var uuu = f64_mul(uu, u);
    var ttt = f64_mul(tt, t);
    var uut3 = f64_mul(_CALC_F64_THREE, f64_mul(uu, t));
    var utt3 = f64_mul(_CALC_F64_THREE, f64_mul(u, tt));

    var rx = f64_add(f64_add(f64_add(
          f64_mul(uuu, HVec2_x(p0)),
          f64_mul(uut3, HVec2_x(p1))),
        f64_mul(utt3, HVec2_x(p2))),
      f64_mul(ttt, HVec2_x(p3)));

    var ry = f64_add(f64_add(f64_add(
          f64_mul(uuu, HVec2_y(p0)),
          f64_mul(uut3, HVec2_y(p1))),
        f64_mul(utt3, HVec2_y(p2))),
      f64_mul(ttt, HVec2_y(p3)));

    return hvec2_new(rx, ry);
}

# Cubic Bezier 3D: B(t) = (1-t)^3*p0 + 3(1-t)^2*t*p1 + 3(1-t)*t^2*p2 + t^3*p3
# p0..p3: HVec3 pointers, t: f64
# Returns: HVec3 pointer
public fn calc_bezier_cubic_3d(p0, p1, p2, p3, t) {
    var u = f64_sub(F64_ONE, t);
    var uu = f64_mul(u, u);
    var tt = f64_mul(t, t);
    var uuu = f64_mul(uu, u);
    var ttt = f64_mul(tt, t);
    var uut3 = f64_mul(_CALC_F64_THREE, f64_mul(uu, t));
    var utt3 = f64_mul(_CALC_F64_THREE, f64_mul(u, tt));

    var rx = f64_add(f64_add(f64_add(
          f64_mul(uuu, HVec3_x(p0)),
          f64_mul(uut3, HVec3_x(p1))),
        f64_mul(utt3, HVec3_x(p2))),
      f64_mul(ttt, HVec3_x(p3)));

    var ry = f64_add(f64_add(f64_add(
          f64_mul(uuu, HVec3_y(p0)),
          f64_mul(uut3, HVec3_y(p1))),
        f64_mul(utt3, HVec3_y(p2))),
      f64_mul(ttt, HVec3_y(p3)));

    var rz = f64_add(f64_add(f64_add(
          f64_mul(uuu, HVec3_z(p0)),
          f64_mul(uut3, HVec3_z(p1))),
        f64_mul(utt3, HVec3_z(p2))),
      f64_mul(ttt, HVec3_z(p3)));

    return hvec3_new(rx, ry, rz);
}

# Catmull-Rom spline segment at parameter t in [0, 1].
# p0..p3: HVec3 pointers (curve interpolates p1 to p2).
# t: f64. Returns: HVec3 pointer.
# Uses standard matrix form with alpha = 0.5:
#   q(t) = 0.5 * [(2*p1) + (-p0+p2)*t + (2*p0 - 5*p1 + 4*p2 - p3)*t^2 + (-p0 + 3*p1 - 3*p2 + p3)*t^3]
public fn calc_catmull_rom(p0, p1, p2, p3, t) {
    var t2 = f64_mul(t, t);
    var t3 = f64_mul(t2, t);

    # Compute per-component: x, y, z
    var p0x = HVec3_x(p0); var p1x = HVec3_x(p1);
    var p2x = HVec3_x(p2); var p3x = HVec3_x(p3);

    var p0y = HVec3_y(p0); var p1y = HVec3_y(p1);
    var p2y = HVec3_y(p2); var p3y = HVec3_y(p3);

    var p0z = HVec3_z(p0); var p1z = HVec3_z(p1);
    var p2z = HVec3_z(p2); var p3z = HVec3_z(p3);

    # Helper: catmull_rom_component(a, b, c, d, t, t2, t3)
    # 0.5 * [2b + (-a+c)*t + (2a - 5b + 4c - d)*t2 + (-a + 3b - 3c + d)*t3]
    var rx = _cmr_comp(p0x, p1x, p2x, p3x, t, t2, t3);
    var ry = _cmr_comp(p0y, p1y, p2y, p3y, t, t2, t3);
    var rz = _cmr_comp(p0z, p1z, p2z, p3z, t, t2, t3);

    return hvec3_new(rx, ry, rz);
}

# Internal: Catmull-Rom per-component
#
# Through 2.8.2 this was exercised only at t = 0 and t = 1, on four collinear
# equally-spaced points. At t = 0 the t/t2/t3 terms all vanish; at t = 1 the
# four coefficients telescope to 2*c; and on equally-spaced collinear input
# coeff2 and coeff3 are BOTH identically zero, so the cubic half of the basis
# was multiplied by zero twice over. It is now pinned at t = 1/4 and t = 1/2 on
# non-collinear points against the exact dyadic values the closed form gives --
# q(1/2) = (-p0 + 9p1 + 9p2 - p3)/16, the standard Catmull-Rom midpoint
# identity, and q(1/4) = (-9p0 + 111p1 + 29p2 - 3p3)/128.
fn _cmr_comp(a, b, c, d, t, t2, t3) {
    # term0 = 2*b
    var term0 = f64_mul(F64_TWO, b);
    # term1 = (-a + c) * t
    var term1 = f64_mul(f64_add(f64_neg(a), c), t);
    # term2 = (2a - 5b + 4c - d) * t2
    var coeff2 = f64_sub(f64_add(f64_sub(f64_mul(F64_TWO, a), f64_mul(_CALC_F64_FIVE, b)),
        f64_mul(_CALC_F64_FOUR, c)), d);
    var term2 = f64_mul(coeff2, t2);
    # term3 = (-a + 3b - 3c + d) * t3
    var coeff3 = f64_add(f64_sub(f64_add(f64_neg(a), f64_mul(_CALC_F64_THREE, b)),
        f64_mul(_CALC_F64_THREE, c)), d);
    var term3 = f64_mul(coeff3, t3);

    return f64_mul(F64_HALF, f64_add(f64_add(f64_add(term0, term1), term2), term3));
}

# ================================================================
# 3. EASING FUNCTIONS
# ================================================================

# Quadratic ease-in: t^2
public fn ease_in(t) {
    return f64_mul(t, t);
}

# Quadratic ease-out: t*(2 - t)
public fn ease_out(t) {
    return f64_mul(t, f64_sub(F64_TWO, t));
}

# Quadratic ease-in-out (smoothstep): t^2 * (3 - 2t)
public fn ease_in_out(t) {
    return f64_mul(f64_mul(t, t), f64_sub(_CALC_F64_THREE, f64_mul(F64_TWO, t)));
}

# Cubic ease-in: t^3
public fn ease_in_cubic(t) {
    return f64_mul(f64_mul(t, t), t);
}

# Cubic ease-out: 1 - (1-t)^3
public fn ease_out_cubic(t) {
    var u = f64_sub(F64_ONE, t);
    return f64_sub(F64_ONE, f64_mul(f64_mul(u, u), u));
}

# Smootherstep (quintic): t^3 * (t*(6t - 15) + 10)
# C2 continuous, zero 1st and 2nd derivatives at endpoints.
public fn ease_in_out_smooth(t) {
    var t3 = f64_mul(f64_mul(t, t), t);
    var inner = f64_add(f64_mul(t, f64_sub(f64_mul(_CALC_F64_SIX, t), _CALC_F64_FIFTEEN)), _CALC_F64_TEN);
    return f64_mul(t3, inner);
}

# ================================================================
# 3b. SPRING + CUBIC BEZIER EASE
# ================================================================

# Damped spring step: returns (new_position, new_velocity) via out params
public fn spring_step(pos, target, vel, stiffness, damping, dt, out_pos, out_vel) {
    var force = f64_mul(stiffness, f64_sub(target, pos));
    var damp = f64_mul(damping, vel);
    var accel = f64_sub(force, damp);
    var new_vel = f64_add(vel, f64_mul(accel, dt));
    var new_pos = f64_add(pos, f64_mul(new_vel, dt));
    store64(out_pos, new_pos);
    store64(out_vel, new_vel);
    return 0;
}

# Cubic bezier easing: solve for t given x, then evaluate y
# Control points: (0,0), (x1,y1), (x2,y2), (1,1)
public fn cubic_bezier_ease(x1, y1, x2, y2, x) {
    # Newton's method to find t where bezier_x(t) = x
    var t = x;  # Initial guess
    var i = 0;
    while (i < 8) {
        var u = f64_sub(F64_ONE, t);
        var uu = f64_mul(u, u);
        var tt = f64_mul(t, t);
        # B_x(t) = 3*u^2*t*x1 + 3*u*t^2*x2 + t^3
        var three = f64_from(3);
        var bx = f64_add(f64_add(
            f64_mul(three, f64_mul(uu, f64_mul(t, x1))),
            f64_mul(three, f64_mul(u, f64_mul(tt, x2)))),
          f64_mul(tt, t));
        var err = f64_sub(bx, x);
        if (f64_lt(f64_abs(err), EPSILON_F64) == 1) { i = 8; }
        else {
            # dB_x/dt = 3*u^2*x1 + 6*u*t*(x2-x1) + 3*t^2*(1-x2)
            var dbx = f64_add(f64_add(
                f64_mul(three, f64_mul(uu, x1)),
                f64_mul(f64_mul(_CALC_F64_SIX, f64_mul(u, t)), f64_sub(x2, x1))),
              f64_mul(three, f64_mul(tt, f64_sub(F64_ONE, x2))));
            if (f64_lt(f64_abs(dbx), EPSILON_F64) == 1) { i = 8; }
            else { t = f64_sub(t, f64_div(err, dbx)); }
        }
        i = i + 1;
    }
    # Evaluate B_y(t)
    var u = f64_sub(F64_ONE, t);
    var uu = f64_mul(u, u);
    var tt = f64_mul(t, t);
    var three = f64_from(3);
    return f64_add(f64_add(
        f64_mul(three, f64_mul(uu, f64_mul(t, y1))),
        f64_mul(three, f64_mul(u, f64_mul(tt, y2)))),
      f64_mul(tt, t));
}

# ================================================================
# 4. NOISE
# ================================================================

# Perlin permutation table (256 entries, doubled for wrapping).
# Stored as a flat allocation of 512 bytes (u8 values).
var _PERM_TABLE = 0;

fn _perm_init() {
    if (_PERM_TABLE != 0) { return 0; }
    _PERM_TABLE = alloc(512);

    # The standard Perlin permutation (Ken Perlin's reference table).
    # Stored through the 10-arg `_perm_store_8` (base + off + 8 bytes), 32 calls.
    # It replaced an 18-arg `_perm_store_block` (16 bytes per call) because cc5
    # 5.7.10 scrambled register/stack params on calls with more than 16 args
    # (upstream's root cause; hisab saw it at 18), which corrupted this table and
    # crashed downstream `perlin_2d` calls. cyrius 6.0.57 fixed that codegen defect
    # upstream; hisab first built on a fixed toolchain at its 6.0.14 -> 6.2.11 bump,
    # when the filing was archived as RESOLVED.
    # [measured: docs/development/issues/archived/2026-04-26-cc5-18-arg-fn-scrambles-params.md]
    # The 10-arg form stays on purpose: it is correct on every toolchain pin, this
    # table is built once per process (see the guard above), and a revert would
    # change code for no gain.
    var base = alloc(256);
    _perm_store_8(base,   0, 151, 160, 137,  91,  90,  15, 131,  13);
    _perm_store_8(base,   8, 201,  95,  96,  53, 194, 233,   7, 225);
    _perm_store_8(base,  16, 140,  36, 103,  30,  69, 142,   8,  99);
    _perm_store_8(base,  24,  37, 240,  21,  10,  23, 190,   6, 148);
    _perm_store_8(base,  32, 247, 120, 234,  75,   0,  26, 197,  62);
    _perm_store_8(base,  40,  94, 252, 219, 203, 117,  35,  11,  32);
    _perm_store_8(base,  48,  57, 177,  33,  88, 237, 149,  56,  87);
    _perm_store_8(base,  56, 174,  20, 125, 136, 171, 168,  68, 175);
    _perm_store_8(base,  64,  74, 165,  71, 134, 139,  48,  27, 166);
    _perm_store_8(base,  72,  77, 146, 158, 231,  83, 111, 229, 122);
    _perm_store_8(base,  80,  60, 211, 133, 230, 220, 105,  92,  41);
    _perm_store_8(base,  88,  55,  46, 245,  40, 244, 102, 143,  54);
    _perm_store_8(base,  96,  65,  25,  63, 161,   1, 216,  80,  73);
    _perm_store_8(base, 104, 209,  76, 132, 187, 208,  89,  18, 169);
    _perm_store_8(base, 112, 200, 196, 135, 130, 116, 188, 159,  86);
    _perm_store_8(base, 120, 164, 100, 109, 198, 173, 186,   3,  64);
    _perm_store_8(base, 128,  52, 217, 226, 250, 124, 123,   5, 202);
    _perm_store_8(base, 136,  38, 147, 118, 126, 255,  82,  85, 212);
    _perm_store_8(base, 144, 207, 206,  59, 227,  47,  16,  58,  17);
    _perm_store_8(base, 152, 182, 189,  28,  42, 223, 183, 170, 213);
    _perm_store_8(base, 160, 119, 248, 152,   2,  44, 154, 163,  70);
    _perm_store_8(base, 168, 221, 153, 101, 155, 167,  43, 172,   9);
    _perm_store_8(base, 176, 129,  22,  39, 253,  19,  98, 108, 110);
    _perm_store_8(base, 184,  79, 113, 224, 232, 178, 185, 112, 104);
    _perm_store_8(base, 192, 218, 246,  97, 228, 251,  34, 242, 193);
    _perm_store_8(base, 200, 238, 210, 144,  12, 191, 179, 162, 241);
    _perm_store_8(base, 208,  81,  51, 145, 235, 249,  14, 239, 107);
    _perm_store_8(base, 216,  49, 192, 214,  31, 181, 199, 106, 157);
    _perm_store_8(base, 224, 184,  84, 204, 176, 115, 121,  50,  45);
    _perm_store_8(base, 232, 127,   4, 150, 254, 138, 236, 205,  93);
    _perm_store_8(base, 240, 222, 114,  67,  29,  24,  72, 243, 141);
    _perm_store_8(base, 248, 128, 195,  78,  66, 215,  61, 156, 180);

    # Double the table for wrapping: perm[i] = base[i & 255]
    var i = 0;
    while (i < 512) {
        store8(_PERM_TABLE + i, load8(base + (i & 255)));
        i = i + 1;
    }
    return 0;
}

# Store 8 bytes into base+offset. 10 args: the split that worked around cc5
# 5.7.10's >16-arg codegen bug, fixed upstream in cyrius 6.0.57 -- see `_perm_init`
# for why it stays.
fn _perm_store_8(base, off, a, b, c, d, e, f, g, h) {
    store8(base + off,     a); store8(base + off + 1, b);
    store8(base + off + 2, c); store8(base + off + 3, d);
    store8(base + off + 4, e); store8(base + off + 5, f);
    store8(base + off + 6, g); store8(base + off + 7, h);
    return 0;
}

# Perm table lookup (returns integer 0-255)
# The unchecked lookup, for this file's perlin_2d, which builds the table first.
fn _perm(idx) {
    return load8(_PERM_TABLE + (idx & 511));
}

# Perlin's reference permutation: P[idx & 511], the 256-entry table doubled for
# wrapping. Builds the table on first use, so no call order can read it unbuilt.
# Shared by perlin_2d here, perlin_3d (calc_ext.cyr) and both simplex noises
# (noise_simplex.cyr). (Was the pair `_perm_init()` + `_perm(idx)` through 3.2.x,
# reached across files and unsafe before the init.)
#must_use
public fn noise_perm(idx) {
    if (_PERM_TABLE == 0) { _perm_init(); }
    return load8(_PERM_TABLE + (idx & 511));
}

# 2D gradient: select one of 4 gradient directions based on hash & 3
fn _grad2(hash, x, y) {
    var h = hash & 3;
    if (h == 0) { return f64_add(x, y); }
    if (h == 1) { return f64_add(f64_neg(x), y); }
    if (h == 2) { return f64_sub(x, y); }
    return f64_sub(f64_neg(x), y);
}

# 2D Perlin noise. Returns f64 in approximately [-1, 1].
#
# Certified by tests/modules.tcyr against a reference written from Perlin's
# published algorithm, not from this file: bit-exact at sample points and on the
# L1 mass of a 1600-sample grid, plus the exact cell-centre histogram (fade(1/2)
# is exactly 1/2, so every cell centre is an exact multiple of 1/4 and the
# distribution of those 256 values fingerprints the permutation table, the corner
# hashing and the gradient set at once). Until 2.8.3 the only assertions were
# |v| < 1 and determinism, which `return 0;` satisfies.
public fn perlin_2d(x, y) {
    _perm_init();

    # Grid cell coordinates (integer, masked to 0-255)
    var xf = f64_floor(x);
    var yf = f64_floor(y);
    var xi = f64_to(xf) & 255;
    var yi = f64_to(yf) & 255;

    # Fractional position within cell
    var xfr = f64_sub(x, xf);
    var yfr = f64_sub(y, yf);

    # Fade curves
    var u = ease_in_out_smooth(xfr);
    var v = ease_in_out_smooth(yfr);

    # Hash the four corners
    var aa = _perm(_perm(xi) + yi);
    var ab = _perm(_perm(xi) + yi + 1);
    var ba = _perm(_perm(xi + 1) + yi);
    var bb = _perm(_perm(xi + 1) + yi + 1);

    # Gradient dot products and bilinear interpolation
    var x1 = calc_lerp(_grad2(aa, xfr, yfr),
      _grad2(ba, f64_sub(xfr, F64_ONE), yfr), u);
    var x2 = calc_lerp(_grad2(ab, xfr, f64_sub(yfr, F64_ONE)),
      _grad2(bb, f64_sub(xfr, F64_ONE), f64_sub(yfr, F64_ONE)), u);
    return calc_lerp(x1, x2, v);
}

# Fractional Brownian Motion (fBm) using 2D Perlin noise.
# x, y: coordinates (f64), octaves: integer count,
# freq: initial frequency (f64), amp: initial amplitude (f64),
# persistence: amplitude multiplier per octave (f64, typically 0.5).
# Returns: f64 noise value normalized to approximately [-1, 1].
public fn fbm_2d(x, y, octaves, freq, amp, persistence) {
    var sum = 0;          # f64 accumulator (starts at 0.0)
    var max_amp = 0;      # f64 normalization
    var cur_freq = freq;
    var cur_amp = amp;

    var i = 0;
    while (i < octaves) {
        var nx = f64_mul(x, cur_freq);
        var ny = f64_mul(y, cur_freq);
        sum = f64_add(sum, f64_mul(cur_amp, perlin_2d(nx, ny)));
        max_amp = f64_add(max_amp, cur_amp);
        cur_amp = f64_mul(cur_amp, persistence);
        cur_freq = f64_mul(cur_freq, F64_TWO);
        i = i + 1;
    }

    # Guard the normalisation divide. `max_amp` only accumulates inside the octave
    # loop, so it is still exactly 0 when octaves <= 0 (or when amp is 0), and the
    # unguarded divide returned NaN — for a function documenting an approximately
    # [-1, 1] range. NaN then propagates silently through every downstream sample.
    if (f64_eq(max_amp, 0) == 1) { return 0; }
    return f64_div(sum, max_amp);
}
