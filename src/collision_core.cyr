# collision_core.cyr -- narrowphase, contact solving, hull and triangulation
# Usage: include "lib/collision_core.cyr"
# Requires: alloc.cyr, math.cyr, vec.cyr, fnptr.cyr, error.cyr, vec2.cyr
#
# MPR/XenoCollide (mpr_intersect, mpr_penetration) lived here through 3.2.x and
# reached into geo_advanced.cyr's EPA helpers; 3.3.0 moved it into geo_advanced.cyr
# beside gjk_epa_3d. That took geo, geo_advanced, quat and vec3 out of this file's
# include set, and out of collision_mesh's.
#
# Provides:
#   Sequential impulse solver + PGS/LCP
#   Convex hull 2D (Andrew's monotone chain, heapsort pre-pass)
#   Polygon triangulation (ear clipping)
#
# NOT here -- Delaunay triangulation, half-edge mesh and island detection moved
# to collision_mesh.cyr when this file was split at 2.2.2. Through 2.6.14 the
# header still named the pre-split file (`collision.cyr`, which does not exist)
# and still advertised all three.

# ================================================================
# Constants
# ================================================================

var _COL_MAX_ITER     = 64;
var _COL_F64_ZERO     = 0;
var _COL_F64_ONE      = 0x3FF0_0000_0000_0000;  # 1.0
var _COL_F64_TWO      = 0x4000_0000_0000_0000;  # 2.0
var _COL_F64_HALF     = 0x3FE0_0000_0000_0000;  # 0.5
var _COL_F64_QUARTER  = 0x3FD0_0000_0000_0000;  # 0.25
var _COL_F64_TEN      = 0x4024_0000_0000_0000;  # 10.0
var _COL_F64_NEG_ONE  = 0xBFF0_0000_0000_0000;  # -1.0
var _COL_F64_POS_INF = F64_POS_INF;   # alias of error.cyr
var _COL_F64_NEG_INF  = 0xFFF0_0000_0000_0000;  # -Infinity
var _COL_F64_THREE    = 0x4008_0000_0000_0000;  # 3.0
var _COL_F64_THIRD    = 0x3FD5_5555_5555_5555;  # 1/3

# ================================================================
# 1. Sequential Impulse Solver
# ================================================================
# Contact constraint: 72 bytes (9 fields x 8 bytes)
#   offset 0:  body_a       (index)
#   offset 8:  body_b       (index)
#   offset 16: normal       (HVec3 pointer)
#   offset 24: penetration  (f64)
#   offset 32: friction     (f64)   -- Coulomb mu
#   offset 40: restitution  (f64)
#   offset 48: inv_mass_a   (f64)
#   offset 56: inv_mass_b   (f64)
#   offset 64: tangent_vel  (f64)   -- signed relative tangential speed
#
# `tangent_vel` (2.8.4) is the relative sliding speed of body A with respect to
# body B, measured along a caller-chosen unit tangent t^ that lies in the contact
# plane. It is a SIGNED SCALAR, not a vector: the solver reports one friction
# magnitude per contact, so the tangent direction lives with the caller and the
# solver only needs the component along it. The returned friction impulse is the
# signed magnitude along that same t^ applied to A (its negation applies to B),
# so a positive tangent_vel yields a negative friction impulse.
#
# It exists because `friction` had no input to act on. The reduced model here
# derives the whole relative velocity from `penetration` ALONG THE NORMAL, so the
# tangential component was structurally zero and `friction` was a silently
# ignored parameter (see the block in sequential_impulse). Contacts built by the
# 8-argument `contact_new` get tangent_vel = 0 and therefore behave exactly as
# they did before 2.8.4, friction impulse included.

#derive(accessors)
public struct ColContact {
    body_a; body_b; normal; penetration; friction; restitution;
    inv_mass_a; inv_mass_b; tangent_vel;
}

public fn contact_new_fric(body_a, body_b, normal, penetration, friction, restitution,
  inv_mass_a, inv_mass_b, tangent_vel) {
    var c = alloc(sizeof(ColContact));
    ColContact_set_body_a(c, body_a);
    ColContact_set_body_b(c, body_b);
    ColContact_set_normal(c, normal);
    ColContact_set_penetration(c, penetration);
    ColContact_set_friction(c, friction);
    ColContact_set_restitution(c, restitution);
    ColContact_set_inv_mass_a(c, inv_mass_a);
    ColContact_set_inv_mass_b(c, inv_mass_b);
    ColContact_set_tangent_vel(c, tangent_vel);
    return c;
}

# Frictionless-input constructor: identical to contact_new_fric with a zero
# tangential relative velocity. Kept at its original 8-argument arity so every
# existing caller (and every consumer) is source-compatible.
public fn contact_new(body_a, body_b, normal, penetration, friction, restitution, inv_mass_a, inv_mass_b) {
    return contact_new_fric(body_a, body_b, normal, penetration, friction, restitution,
      inv_mass_a, inv_mass_b, _COL_F64_ZERO);
}

# sequential_impulse -- solve normal + friction impulses
# contacts: vec of ColContact pointers
# n: number of contacts
# iterations: solver iterations
# out_impulses: pre-allocated flat array, 2 f64 per contact (normal, friction magnitude)
#   Layout: [n0, f0, n1, f1, ...] -- total 16*n bytes
#   n_i is the normal impulse, >= 0. f_i is the SIGNED friction impulse along the
#   caller's tangent t^ (the one ColContact.tangent_vel was measured along), so it
#   is negative for a positive tangent_vel; |f_i| <= friction * n_i always.
# Returns: Ok(0) on success and for n <= 0 (a no-op frame, which was the
#   incumbent behaviour and is now contracted); Err(HSB_ERR_INVALID_INPUT) if
#   `contacts` is null or `n` exceeds `vec_len(contacts)`.
#must_use
public fn sequential_impulse(contacts, n, iterations, out_impulses) {
    # ⛔ THE ZEROING LOOP BELOW RUNS BEFORE THE FIRST `vec_get`, SO WITHOUT THIS
    # GUARD THE FUNCTION WROTE OUT OF BOUNDS AND RETURNED **SUCCESS**.
    #
    # `n` is documented as "number of contacts" — i.e. it is a restatement of
    # `vec_len(contacts)` — but nothing checked it. Two failure modes, and the
    # quiet one is worse:
    #   iterations > 0 : the `vec_get(contacts, ci)` below is bounds-checked by
    #                    the stdlib and calls `_vec_die()` -> `syscall(60, 1)`,
    #                    which ENDS THE CALLER'S PROCESS. A library must not.
    #   iterations = 0 : the vec is never touched at all, so the zeroing loop
    #                    writes 16*n bytes and returns 0. Reproduced: an EMPTY
    #                    contacts vec with n = 1000 and a 64-byte out_impulses
    #                    clobbered all 8 words of an adjacent canary with rc = 0
    #                    and no diagnostic — ~16 KB past the buffer, silently.
    #                    CWE-787.
    # [measured: scratch harness, not reproducible in-tree, 2026-09-09; cycc 6.6.2]
    #
    # ⚠ THE ZEROING LOOP IS THE ONE THAT MUST BE BOUNDED, not just the solver
    # loop. Guarding only the `vec_get` would leave the silent write intact,
    # which is the half that cannot announce itself.
    #
    # [measured: scratch harness, not reproducible in-tree, 2026-09-09; cycc 6.6.2]
    # ⚠ `out_impulses` is sized `16*n` by the caller and its extent is genuinely
    # unknowable here — that half stays the caller's contract. What is knowable,
    # and now enforced, is that `n` may not exceed the contacts actually present.
    # ⛔ ORDER IS LOAD-BEARING, AND THE FIRST VERSION OF THIS GUARD GOT IT WRONG.
    # `vec_len(v)` is `load64(v + 8)` with NO null or validity check. On the
    # unguarded function `contacts` was dereferenced only inside the solver loop,
    # so an `n <= 0` call never touched it — null, stale or wild, harmless. A
    # guard that reads `vec_len` before establishing `n > 0` moves that
    # dereference onto a path that never had one. Measured:
    # `sequential_impulse(0x1000, 0, 0, out)` — the natural "no contacts this
    # frame" call with a stale handle — returned 0 untouched before, and
    # **SIGSEGV'd** with the null-check-first ordering. A non-null bad handle is
    # not null, so the null check does not cover it.
    # ⭐ `n <= 0` FIRST, RETURNING SUCCESS, is what makes this a pure addition:
    # both loops are already no-ops there, so the early return is bit-identical
    # in memory effect and rc for EVERY handle value.
    if (n <= 0) { return Ok(0); }
    if (contacts == 0) { return Err(HSB_ERR_INVALID_INPUT); }
    if (n > vec_len(contacts)) { return Err(HSB_ERR_INVALID_INPUT); }

    # Zero out impulses
    for (var zi = 0; zi < n; zi = zi + 1) {
        store64(out_impulses + zi * 16,     _COL_F64_ZERO);
        store64(out_impulses + zi * 16 + 8, _COL_F64_ZERO);
    }

    for (var it = 0; it < iterations; it = it + 1) {
        for (var ci = 0; ci < n; ci = ci + 1) {
            var c = vec_get(contacts, ci);
            var inv_mass = f64_add(ColContact_inv_mass_a(c), ColContact_inv_mass_b(c));

            # ⛔ `inv_mass` is a sum of INVERSE MASSES — units 1/mass — against an
            # absolute 1e-12, so whether two bodies counted as "both static"
            # depended on whether the caller works in kilograms or tonnes. Heavy
            # but genuinely dynamic bodies were skipped, and the contact's two
            # output slots kept the zeros the entry loop wrote: impulse exactly
            # +0.0, indistinguishable from a real zero-impulse contact.
            # ⭐ The division is by `inv_mass`, so DBL_MIN is the test: below it
            # there is no finite impulse to compute, and at 0 both really are
            # static, which is the documented case this branch is for.
            # [measured: docs/audit/2026-09-09-epsilon-open.json]
            if (f64_lt(inv_mass, F64_TINY) == 1) {
                # Both bodies are static -- skip
            } else {
                var normal = ColContact_normal(c);
                var rest = ColContact_restitution(c);
                var fric = ColContact_friction(c);
                var pen = ColContact_penetration(c);

                # Relative velocity along normal (simplified -- use penetration as
                # proxy). In a full solver the caller supplies rel_velocities; here a
                # penetration-based approaching velocity (negative) drives separation.
                var v_n = f64_neg(pen);

                # RESTITUTION IS A BIAS ON THE TARGET VELOCITY, APPLIED ONCE.
                #
                # Through 2.8.2 the (1 + e) factor multiplied the *effective* velocity
                # -- the one that already carries the accumulated impulse -- so it was
                # re-applied on every sweep. That turns the update into the affine map
                # λ_{k+1} = -e·λ_k + (1+e)·pen/inv_mass, whose fixed point is only
                # reached when |e| < 1. At e = 1 it is a period-2 orbit: λ alternates
                # 0, 2·pen/inv_mass, 0, ... so an EVEN `iterations` returned 0 (no
                # impulse at all) and an ODD one returned twice the correct value. The
                # answer depended on the parity of a convergence parameter, and e > 1
                # diverged before the >= 0 clamp folded it back to the same orbit.
                #
                # The textbook formulation biases the TARGET velocity by -e times the
                # INITIAL approach velocity and drives the effective velocity to that
                # target, so e enters exactly once no matter how many sweeps run:
                #   v_bias = -e·v_n      (the separating speed we want after impact)
                #   Δλ     = -(v_eff - v_bias) / inv_mass
                # The update is now idempotent -- λ = (1 + e)·pen / inv_mass after the
                # first sweep, for every e >= 0 and every iteration count.
                var v_bias = f64_neg(f64_mul(rest, v_n));

                var old_impulse = load64(out_impulses + ci * 16);
                var v_n_eff = f64_add(v_n, f64_mul(old_impulse, inv_mass));

                # Δλ = -(v_eff - v_bias) / inv_mass  (positive while still approaching)
                var delta = f64_neg(f64_div(f64_sub(v_n_eff, v_bias), inv_mass));

                # Accumulate and clamp the *total* impulse >= 0
                var new_impulse = f64_add(old_impulse, delta);
                if (f64_lt(new_impulse, _COL_F64_ZERO) == 1) {
                    new_impulse = _COL_F64_ZERO;
                }
                store64(out_impulses + ci * 16, new_impulse);

                # FRICTION IS A COULOMB-CLAMPED ACCUMULATED IMPULSE.
                #
                # Through 2.8.4 this block LOADED the friction slot it had itself
                # zeroed at entry, clamped that zero, and stored it back -- there
                # was no update between the load and the clamp. |0| > mu*lambda_n
                # is never true for a non-negative bound, so the friction impulse
                # was identically 0 for every contact, at every mu, at every
                # iteration count (measured: 0 of 320 sampled configs nonzero) and
                # `friction` was a silently ignored parameter. It survived because
                # every solver fixture used friction = 0, so the branch was never
                # even entered.
                #
                # The tangential constraint drives the relative sliding speed to
                # zero, using the same effective-velocity convention as the normal
                # path above (the accumulated impulse folded back into the
                # velocity it already produced):
                #   v_t_eff = v_t + lambda_t * inv_mass
                #   dlambda = -(v_t_eff - 0) / inv_mass
                #   lambda_t = clamp(lambda_t + dlambda, -mu*lambda_n, +mu*lambda_n)
                # The accumulate-then-clamp order is what makes it Coulomb rather
                # than a per-sweep cap: the clamp bounds the TOTAL tangential
                # impulse, so a contact that saturates stays saturated instead of
                # gaining another mu*lambda_n on the next sweep.
                #
                # The unclamped update telescopes to lambda_t = -v_t / inv_mass --
                # reached in ONE sweep and idempotent thereafter, so the answer
                # does not depend on `iterations`, exactly like the 2.8.3
                # restitution repair. Clamped, the closed form is
                #   lambda_t = clamp(-v_t / inv_mass, +/- mu * lambda_n)
                # and the sign always opposes v_t, since -v_t/inv_mass and the
                # saturated bound -sign(v_t)*mu*lambda_n both do.
                if (f64_gt(fric, EPSILON_F64) == 1) {
                    var v_t = ColContact_tangent_vel(c);
                    # Cone half-width: mu times the normal impulse just solved.
                    var max_fric = f64_mul(fric, new_impulse);
                    var old_fric = load64(out_impulses + ci * 16 + 8);
                    var v_t_eff = f64_add(v_t, f64_mul(old_fric, inv_mass));
                    var new_fric = f64_sub(old_fric, f64_div(v_t_eff, inv_mass));
                    # Clamp the TOTAL tangential impulse into the Coulomb cone.
                    if (f64_gt(f64_abs(new_fric), max_fric) == 1) {
                        if (f64_lt(new_fric, _COL_F64_ZERO) == 1) {
                            new_fric = f64_neg(max_fric);
                        } else {
                            new_fric = max_fric;
                        }
                    }
                    store64(out_impulses + ci * 16 + 8, new_fric);
                }
            }
        }
    }
    return Ok(0);
}

# ================================================================
# 2. Convex Hull 2D -- Andrew's Monotone Chain
# ================================================================
# Input: points = vec of HVec2 pointers, n = vec_len(points)
# Returns: vec of indices into the original points array (CCW order)

# 2D cross product of vectors OA and OB: (A-O) x (B-O)
fn _col_cross2d(ox, oy, ax, ay, bx, by) {
    return f64_sub(f64_mul(f64_sub(ax, ox), f64_sub(by, oy)),
      f64_mul(f64_sub(ay, oy), f64_sub(bx, ox)));
}

# Order predicate for the hull pre-sort: is the point at index `ia` strictly
# after the point at index `ib` in (x, then y) ascending order?
#
# x-equality is EXACT since 2.15.0 (it used the insertion sort's EPSILON_F64
# band from 2.6.15 to 2.14.0; see the comment inside for why a tolerance is
# not an order), so the ordering is the pre-2.6.15 one with exact ties.
fn _col_xy_greater(points, ia, ib) {
    var pa = vec_get(points, ia);
    var pb = vec_get(points, ib);
    var ax = HVec2_x(pa);
    var bx = HVec2_x(pb);
    # ⛔ A SORT COMPARATOR WITH A TOLERANCE IS NOT AN ORDER. `|ax - bx|` is a
    # LENGTH in the caller's units, so which points compared "equal" changed with
    # the unit — and an epsilon-equality is not transitive, so the relation this
    # produced was not a total order at all. A sort driven by a non-order does not
    # merely mis-rank: it can drop or duplicate elements, and the hull built on it
    # inherits that silently, with no error channel.
    # ⭐ Exact lexicographic comparison. It is total, transitive and scale-free by
    # construction, and it is what the neighbouring `_col_point_in_tri` already
    # does with the same kind of quantity.
    # [measured: docs/audit/2026-09-09-epsilon-open.json]
    if (f64_gt(ax, bx) == 1) { return 1; }
    if (f64_eq(ax, bx) == 1) {
        if (f64_gt(HVec2_y(pa), HVec2_y(pb)) == 1) { return 1; }
    }
    return 0;
}

# Sift `root` down through a max-heap of size `n` held in `indices`.
fn _col_sift_down(indices, points, root, n) {
    var r = root;
    var sifting = 1;
    while (sifting == 1) {
        var child = r * 2 + 1;
        if (child >= n) {
            sifting = 0;
        } else {
            # pick the larger child
            if (child + 1 < n) {
                if (_col_xy_greater(points, vec_get(indices, child + 1),
                    vec_get(indices, child)) == 1) {
                    child = child + 1;
                }
            }
            if (_col_xy_greater(points, vec_get(indices, child),
                vec_get(indices, r)) == 1) {
                var tmp = vec_get(indices, r);
                vec_set(indices, r, vec_get(indices, child));
                vec_set(indices, child, tmp);
                r = child;
            } else {
                sifting = 0;
            }
        }
    }
    return 0;
}

# Sort indices by (x, then y ascending) — heapsort, O(n log n) worst case and
# O(1) extra memory.
#
# This was an insertion sort, the only super-linear step in convex_hull_2d (the
# monotone chain itself is O(n)) and unbounded because the public entry point
# caps nothing: the 2026-08-03 audit measured 690 ms on 8,000 points, and the
# in-repo benchmark 21.7 ms on 2,000.
#
# Heapsort rather than merge sort deliberately: merge sort's n-slot scratch would
# be LEAKED on every call under the never-freeing bump allocator, which is the
# same reasoning cyrius stdlib gives for `vec_sort_by`.
#
# ⚠ 2.9.3 CORRECTION: this used to say "and Cyrius has no closures". **That is
# false and has been for a while** — Cyrius has capturing closures (`|x| base + x`,
# captured by value into a heap environment, guide §Closures, v6.3.8). The claim
# was inherited and repeated across four files without anyone running it. A
# second reason then took its place — on 6.5.16 a capturing closure SIGSEGVed
# when passed through a function and called there — and that one is gone too,
# fixed in 6.5.17 (issues/archived/2026-08-10-cyrius-capturing-closure-across-
# fn-boundary.md): a closure over `points` runs through `vec_sort_by` on 6.6.4.
#
# ⛔ WHY IT STAYS HAND-WRITTEN ANYWAY: THE OUTPUT ORDER OF TIES IS OBSERVABLE.
# This sorts INDICES, and coincident points are equal keys with distinct
# indices. `vec_sort_by` is an introsort, heapsort is not, and unstable sorts
# permute equal keys differently: on a unit square with each corner listed
# twice this loop yields 4 0 7 3 5 1 6 2 and `vec_sort_by` yields 0 4 3 7 1 5
# 2 6; the monotone chain's cross-product ties then select a different member
# of each coincident pair depending on which came first, so the hull comes back
# as (4 1 2 7) here and (0 5 6 3) through the stdlib -- the same polygon,
# different indices, which a caller keying on indices would see. (Which member
# survives is not a one-line rule: the anchor keeps the FIRST of its pair and
# the lower chain the LAST; the indices above are the measurement.)
# The introsort's pure-insertion regime below 17 elements is STABLE and still
# differs on 8 of 8 slots; at n = 40 (quicksort regime) the two diverge on
# 35 of 40. Swapping the algorithm is therefore a behaviour change, not a
# consolidation.
# [measured: scratch probe on the 3.1.1 tree, cycc 6.6.4, 2026-09-14, not reproducible in-tree]
#
# Ordering is identical to the insertion sort this replaced in 2.6.15, except
# that the x-equality band is exact rather than EPSILON_F64 since 2.15.0 (see
# `_col_xy_greater`).
fn _col_sort_indices_by_xy(indices, points, n) {
    if (n < 2) { return 0; }

    # Build a max-heap.
    var h = n / 2 - 1;
    while (h >= 0) {
        _col_sift_down(indices, points, h, n);
        h = h - 1;
    }

    # Repeatedly move the max to the back and restore the heap.
    var end = n - 1;
    while (end > 0) {
        var tmp2 = vec_get(indices, 0);
        vec_set(indices, 0, vec_get(indices, end));
        vec_set(indices, end, tmp2);
        _col_sift_down(indices, points, 0, end);
        end = end - 1;
    }
    return 0;
}

public fn convex_hull_2d(points, n) {
    var result = vec_new();
    # ⛔ `n` IS A RESTATEMENT OF `vec_len(points)` AND WAS NEVER CHECKED, so a
    # caller passing a larger `n` did not get a wrong answer — it lost its
    # PROCESS. The stdlib's `vec_get` is bounds-checked and calls `_vec_die()`
    # -> `syscall(60, 1)`. Reproduced: 3 points with n = 100 prints
    # `vec: index out of bounds` and exits 1; the same call with n = 3 exits 0.
    # [measured: scratch harness, not reproducible in-tree, 2026-09-09; cycc 6.6.2]
    # **A library must not end its caller's process.**
    #
    # Rejection returns the empty `result` vec, which is this function's
    # established convention for degenerate input (n < 2) and what every
    # assertion in `tests/abuse.tcyr` calls `vec_len` on — returning a designed 0
    # here would null-deref in the suite's own idiom.
    if (points == 0) { return result; }
    if (n > vec_len(points)) { return result; }

    if (n < 2) {
        for (var i = 0; i < n; i = i + 1) {
            vec_push(result, i);
        }
        return result;
    }

    # Build sorted index array
    var sorted = vec_new();
    for (var i = 0; i < n; i = i + 1) {
        vec_push(sorted, i);
    }
    _col_sort_indices_by_xy(sorted, points, n);

    # Lower hull
    var hull = vec_new();
    for (var i = 0; i < n; i = i + 1) {
        var pi = vec_get(sorted, i);
        var pp = vec_get(points, pi);
        var px = HVec2_x(pp);
        var py = HVec2_y(pp);
        var hlen = vec_len(hull);
        var cont = 1;
        while (cont == 1) {
            hlen = vec_len(hull);
            if (hlen < 2) { cont = 0; } else {
                var h1i = vec_get(hull, hlen - 1);
                var h2i = vec_get(hull, hlen - 2);
                var h1p = vec_get(points, h1i);
                var h2p = vec_get(points, h2i);
                var c = _col_cross2d(HVec2_x(h2p), HVec2_y(h2p),
                  HVec2_x(h1p), HVec2_y(h1p),
                  px, py);
                if (f64_le(c, _COL_F64_ZERO) == 1) {
                    vec_pop(hull);
                } else {
                    cont = 0;
                }
            }
        }
        vec_push(hull, pi);
    }

    # Upper hull
    var lower_len = vec_len(hull) + 1;
    for (var i = n - 1; i >= 0; i = i - 1) {
        var pi = vec_get(sorted, i);
        var pp = vec_get(points, pi);
        var px = HVec2_x(pp);
        var py = HVec2_y(pp);
        var cont = 1;
        while (cont == 1) {
            var hlen = vec_len(hull);
            if (hlen < lower_len) { cont = 0; } else {
                var h1i = vec_get(hull, hlen - 1);
                var h2i = vec_get(hull, hlen - 2);
                var h1p = vec_get(points, h1i);
                var h2p = vec_get(points, h2i);
                var c = _col_cross2d(HVec2_x(h2p), HVec2_y(h2p),
                  HVec2_x(h1p), HVec2_y(h1p),
                  px, py);
                if (f64_le(c, _COL_F64_ZERO) == 1) {
                    vec_pop(hull);
                } else {
                    cont = 0;
                }
            }
        }
        vec_push(hull, pi);
    }

    # Remove last (duplicate of first)
    vec_pop(hull);

    # Copy to result
    var hull_len = vec_len(hull);
    for (var i = 0; i < hull_len; i = i + 1) {
        vec_push(result, vec_get(hull, i));
    }
    return result;
}

# ================================================================
# 3. Polygon Triangulation -- Ear Clipping
# ================================================================
# Input: vertices = vec of HVec2 pointers, n = number of vertices
#
# Returns: vec of index triples [i0, i1, i2, ...], flat.
#
#   length == 3*(n-2)  -- COMPLETE triangulation
#   length <  3*(n-2)  -- PARTIAL. The ear-clipping pass found no ear among the
#                         remaining vertices and stopped; what is returned is a
#                         valid triangulation of the part that WAS clipped.
#   length == 0        -- no ear found on the very first pass.
#
# Through 2.7.0 this comment stated `length = 3*(n-2)` unconditionally, which is
# false: the `if (ear_found == 0) { return result; }` bail below returns early on
# degenerate or self-intersecting input, with no error signal. The information to
# detect that was always present but never documented, so callers could not tell
# a complete triangulation from a truncated one.
#
# CHECK `vec_len(result) == 3*(n-2)` before trusting the output. Ear clipping is
# only defined for SIMPLE polygons; a self-intersecting input has no ear
# decomposition and a short return is the honest answer, not a failure to fix.

# Sign of 2D cross product for winding test
fn _col_triangle_area_2x(ax, ay, bx, by, cx, cy) {
    return f64_sub(f64_mul(f64_sub(bx, ax), f64_sub(cy, ay)),
      f64_mul(f64_sub(cx, ax), f64_sub(by, ay)));
}

# Point-in-triangle test (2D, BOUNDARY-INCLUSIVE).
#
# 2.9.3: this comment read "(2D, strict interior)" and was false. A point on an
# edge makes that edge's signed area exactly 0, which sets NEITHER has_neg nor
# has_pos, so the "all signs agree" test below passes and the function returns 1.
# Vertices are included for the same reason (two of the three areas vanish). The
# closed test is the correct one for the ear-clipping caller -- an ear must not
# be cut when another vertex lies ON its boundary, only when it lies strictly
# outside -- so the CODE was right and only the contract was mis-stated.
fn _col_point_in_tri(px, py, ax, ay, bx, by, cx, cy) {
    var d1 = _col_triangle_area_2x(px, py, ax, ay, bx, by);
    var d2 = _col_triangle_area_2x(px, py, bx, by, cx, cy);
    var d3 = _col_triangle_area_2x(px, py, cx, cy, ax, ay);

    var has_neg = 0;
    var has_pos = 0;
    if (f64_lt(d1, _COL_F64_ZERO) == 1) { has_neg = 1; }
    if (f64_gt(d1, _COL_F64_ZERO) == 1) { has_pos = 1; }
    if (f64_lt(d2, _COL_F64_ZERO) == 1) { has_neg = 1; }
    if (f64_gt(d2, _COL_F64_ZERO) == 1) { has_pos = 1; }
    if (f64_lt(d3, _COL_F64_ZERO) == 1) { has_neg = 1; }
    if (f64_gt(d3, _COL_F64_ZERO) == 1) { has_pos = 1; }

    # Point is inside if all signs are the same
    if (has_neg == 1) {
        if (has_pos == 1) { return 0; }
    }
    return 1;
}

# Convexity of the ring vertex at position p, using the SAME predicate and
# the SAME EPSILON_F64 threshold as the ear gate below, so "not convex here"
# is exactly "would be rejected as an ear tip there".
fn _col_ring_is_convex(vertices, idx, remaining, p, ccw) {
    var pv = p - 1;
    if (pv < 0) { pv = remaining - 1; }
    var nx = p + 1;
    if (nx >= remaining) { nx = 0; }
    var ap = vec_get(vertices, vec_get(idx, pv));
    var bp = vec_get(vertices, vec_get(idx, p));
    var cp = vec_get(vertices, vec_get(idx, nx));
    var cross = _col_triangle_area_2x(HVec2_x(ap), HVec2_y(ap),
      HVec2_x(bp), HVec2_y(bp),
      HVec2_x(cp), HVec2_y(cp));
    # ⛔ `cross` is TWICE THE SIGNED AREA — degree TWO in the caller's coordinates
    # — against an absolute 1e-12, so a strictly convex vertex of a small polygon
    # was classified "not convex". That is not a plausible number, it is a
    # plausible DIAGNOSIS, which is worse: the vertex is marked blocked and the
    # triangulation quietly comes back short or empty.
    # ⭐ Convexity is the SIGN of the determinant and nothing else. That is exactly
    # what `_col_point_in_tri` already does to this same quantity three functions
    # up in this file, so this is consistency, not a new rule.
    # ⚠ All four sites move together (:706, :709 here and :800, :802 in
    # triangulate_polygon) or the ear test and the ring test disagree.
    # [measured: unit square at 2^-20 returned an EMPTY triangulation]
    if (ccw == 1) {
        if (f64_gt(cross, _COL_F64_ZERO) == 1) { return 1; }
        return 0;
    }
    if (f64_lt(cross, _COL_F64_ZERO) == 1) { return 1; }
    return 0;
}

# ⚠ RETURN-LENGTH CONTRACT, and the one place it is stated in the SOURCE.
# `3*(n-2)` indices means a COMPLETE triangulation; fewer means PARTIAL, and
# partial is inside the contract rather than a failure. Ear clipping is defined
# only for SIMPLE polygons; on self-intersecting input the output length is not
# specified and callers must not assume completeness.
# ⛔ 2.20.0 — 2.7.1's reflex-only prune DOES change that length on
# self-intersecting input, and for thirteen releases the CHANGELOG recorded the
# direction BACKWARDS, twice. It read "old-partial -> new-complete, the new code
# succeeds where the old bailed". Measured by building the 2.7.0 tree and this
# one side by side on cyrius 6.6.2 and running both on
# `(0,0),(1,2),(1,1),(0,2),(2,1)`: **old returns 9 indices (COMPLETE), this code
# returns 6 (PARTIAL)** — old `[0 1 2 4 0 2 4 2 3]`, new `[4 0 1 1 2 3]`. The new
# code BAILS WHERE THE OLD SUCCEEDED. The decision is unchanged (the divergence
# is confined to input ear clipping does not define) but the sentence was wrong,
# and it was wrong in the CHANGELOG where no gate could reach it. It is stated
# here now, beside the code it describes.
# ⚠ The marker below deliberately does not START with "2.7.0": the provenance
# gate parses a leading token containing a dot as a FILE PATH, and reports a
# version number there as a file that does not exist.
# [measured: the 2.7.0 tree vs HEAD, both built on cyrius 6.6.2, 2026-09-10]
public fn triangulate_polygon(vertices, n) {
    var result = vec_new();
    # ⛔ `n` IS A RESTATEMENT OF `vec_len(vertices)` AND WAS NEVER CHECKED, so a
    # caller passing a larger `n` did not get a wrong answer — it lost its
    # PROCESS. The stdlib's `vec_get` is bounds-checked and calls `_vec_die()`
    # -> `syscall(60, 1)`. Reproduced: 3 vertices with n = 100 prints
    # `vec: index out of bounds` and exits 1; the same call with n = 3 exits 0.
    # [measured: scratch harness, not reproducible in-tree, 2026-09-09; cycc 6.6.2]
    # **A library must not end its caller's process.**
    #
    # Rejection returns the empty `result` vec, which is this function's
    # established convention for degenerate input (n < 3) and what every
    # assertion in `tests/abuse.tcyr` calls `vec_len` on — returning a designed 0
    # here would null-deref in the suite's own idiom.
    if (vertices == 0) { return result; }
    if (n > vec_len(vertices)) { return result; }

    if (n < 3) { return result; }

    # Build index list (will shrink as ears are clipped)
    var idx = vec_new();
    for (var i = 0; i < n; i = i + 1) {
        vec_push(idx, i);
    }

    # Determine winding: sum of signed areas
    var total_area = _COL_F64_ZERO;
    for (var i = 0; i < n; i = i + 1) {
        var ni = i + 1;
        if (ni >= n) { ni = 0; }
        var pi = vec_get(vertices, i);
        var pn = vec_get(vertices, ni);
        total_area = f64_add(total_area,
          f64_sub(f64_mul(HVec2_x(pi), HVec2_y(pn)),
            f64_mul(HVec2_x(pn), HVec2_y(pi))));
    }
    # ccw = 1 if total_area > 0 (standard CCW winding)
    var ccw = 1;
    if (f64_lt(total_area, _COL_F64_ZERO) == 1) { ccw = 0; }

    # Blocker cache, keyed by ORIGINAL vertex index (never shifts as idx
    # shrinks). blocked[v] = 1 iff v is NOT strictly convex -- i.e. reflex or
    # collinear. Only such a vertex can sit inside a candidate ear of a simple
    # polygon, so every 0 here is a point-in-triangle test we can skip. Built
    # in O(n); a clip changes the ring only at the two neighbours of the
    # removed vertex, so each clip refreshes exactly 2 entries.
    var blocked = alloc(n * 8);
    if (blocked == 0) { return result; }
    for (var i = 0; i < n; i = i + 1) {
        store64(blocked + i * 8, 1 - _col_ring_is_convex(vertices, idx, n, i, ccw));
    }

    var remaining = n;
    var max_iters = n * n;  # Safety bound
    var iter_count = 0;

    while (remaining > 2) {
        iter_count = iter_count + 1;
        if (iter_count > max_iters) { return result; }  # Degenerate -- bail

        var ear_found = 0;
        for (var i = 0; i < remaining; i = i + 1) {
            var prev = i - 1;
            if (prev < 0) { prev = remaining - 1; }
            var next = i + 1;
            if (next >= remaining) { next = 0; }

            var ai = vec_get(idx, prev);
            var bi = vec_get(idx, i);
            var ci = vec_get(idx, next);

            var ap = vec_get(vertices, ai);
            var bp = vec_get(vertices, bi);
            var cp = vec_get(vertices, ci);

            var ax = HVec2_x(ap);
            var ay = HVec2_y(ap);
            var bx = HVec2_x(bp);
            var by = HVec2_y(bp);
            var cx = HVec2_x(cp);
            var cy = HVec2_y(cp);

            var cross = _col_triangle_area_2x(ax, ay, bx, by, cx, cy);

            # Check convexity: for CCW polygon, ear has positive cross
            var convex = 0;
            # ⛔ Same quantity, same class, and it must match `_col_ring_is_convex`
            # above exactly — an ear accepted by one and rejected by the other
            # stalls the triangulation.
            if (ccw == 1) {
                if (f64_gt(cross, _COL_F64_ZERO) == 1) { convex = 1; }
            } else {
                if (f64_lt(cross, _COL_F64_ZERO) == 1) { convex = 1; }
            }

            if (convex == 1) {
                # Check no other BLOCKING vertex inside this triangle
                var has_point = 0;
                for (var j = 0; j < remaining; j = j + 1) {
                    if (j != prev) {
                        if (j != i) {
                            if (j != next) {
                                var ji = vec_get(idx, j);
                                if (load64(blocked + ji * 8) == 1) {
                                    var jp = vec_get(vertices, ji);
                                    var inside = _col_point_in_tri(
                                      HVec2_x(jp), HVec2_y(jp),
                                      ax, ay, bx, by, cx, cy);
                                    if (inside == 1) { has_point = 1; break; }
                                }
                            }
                        }
                    }
                }

                if (has_point == 0) {
                    # Clip this ear
                    vec_push(result, ai);
                    vec_push(result, bi);
                    vec_push(result, ci);
                    vec_remove(idx, i);
                    remaining = remaining - 1;
                    ear_found = 1;
                    # Removing position i leaves the old prev at i-1 and pulls
                    # the old next down into slot i; only those two vertices
                    # changed neighbours, so only those two flags are stale.
                    # ⚠ `prev_slot`/`next_slot`, not `pn`/`nn`: the winding loop at the
                    # top of THIS SAME FUNCTION already binds `pn`, and there it is an
                    # HVec2 POINTER while here it is a ring INDEX. Nothing broke — that
                    # loop finishes long before this runs — but two unrelated quantities
                    # under one name inside one function is how a later edit picks the
                    # wrong one. ⚠ The filing that recorded this also claimed `nn`
                    # shadowed something. It does not: the winding loop uses `ni`, so
                    # `pn` was the only true shadow. Renamed as a pair anyway.
                    # ⚠ Inertness is CHECKED, and so is the check: a folded checksum over
                    # every index tuple on a 3x3 grid for n=4 and n=5 (65,610 calls) is
                    # bit-identical across the rename — and the same checksum MOVES when
                    # the refresh is disabled or the prev flag is forced, so it can see a
                    # change. ⚠ `prev_slot = i - 2` does NOT move it: an equivalence on
                    # this family, not evidence the probe is blind.
                    # [measured: 65,610-case checksum, inert across rename, 2 of 3 mutants move it]
                    if (remaining > 2) {
                        var prev_slot = i - 1;
                        if (prev_slot < 0) { prev_slot = remaining - 1; }
                        var next_slot = i;
                        if (next_slot >= remaining) { next_slot = 0; }
                        store64(blocked + vec_get(idx, prev_slot) * 8,
                          1 - _col_ring_is_convex(vertices, idx, remaining, prev_slot, ccw));
                        store64(blocked + vec_get(idx, next_slot) * 8,
                          1 - _col_ring_is_convex(vertices, idx, remaining, next_slot, ccw));
                    }
                    break;
                }
            }
        }

        # If no ear found this pass, polygon may be degenerate
        if (ear_found == 0) { return result; }
    }
    return result;
}

# ================================================================
