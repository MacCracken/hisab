# collision_mesh.cyr -- Delaunay triangulation, half-edge mesh, island detection
# Usage: shipped inside dist/hisab.cyr; in-tree, include "src/collision_mesh.cyr" after what it requires
# Requires: src/collision_core.cyr, src/error.cyr, src/vec2.cyr (stdlib resolves via cyrius.cyml [deps])
#           (island detection reads the bodies of collision_core's `ColContact`)
#
# Split out of collision_core.cyr in 2.2.2. Through 3.2.x it also reached into
# collision_core's internals, for three f64 literals and the half-edge sentinel;
# 3.3.0 gave it its own `HALFEDGE_NONE`, a plain 0 and the stdlib's `F64_ONE`, so
# what it uses from that file now is public API only. (Module sets derived by
# compiling each module against exactly its listed set -- docs/architecture/overview.md,
# "Module dependency manifest".)
#
# The half-edge mesh's "no such index" value: the `twin` of a boundary half-edge,
# the `vertex_edge` of an isolated vertex, an empty slot in the twin-matching table
# and an unassigned island index all read HALFEDGE_NONE. Public because callers of
# `halfedge_from_triangles` read `twin` and `vertex_edge` through the public
# `HalfEdge` / `HalfEdgeMesh` accessors and compare against it. (It was `_COL_SENTINEL` in collision_core,
# which never used it, through 3.2.x.)
public var HALFEDGE_NONE = 0x7FFF_FFFF_FFFF_FFFF;   # usize::MAX sentinel

# 5. Delaunay Triangulation -- Bowyer-Watson over triangle adjacency
# ================================================================
# Input: points = vec of HVec2 pointers, n = number of points
# Returns: vec of index triples [i0, i1, i2, ...] (flat)
#
# Each point is placed by WALKING the adjacency graph to the triangle that
# contains it and then FLOOD-FILLING the bad set across shared edges. The
# earlier form rescanned every live triangle per point, which is O(n^2)
# circumcircle determinants; the flood fill touches only the cavity.

# --- exact triangle orientation (Shewchuk orient2d, adaptive) --------------
#
# 2.9.3. The winding term of the in-circle test below was a plain floating-point
# 2x2 determinant, and it LOST ITS SIGN whenever one set mixes scales -- not a
# latent case, a silently wrong `delaunay_2d`. With one vertex at ~6e5 and five
# points clustered inside ~5e-17 of the origin, the shipped predicate drops an
# input point outright: 5 of 6 points used, 4 triangles where the exact hull
# says 6. Failing seeds are dense, 8 of the first 20 on a 3,999-seed sweep.
# [measured: tests/modules.tcyr "wide dynamic range", and the filing below]
#
# ⛔ MAKING THE DETERMINANT EXACT IS NOT ENOUGH, AND THAT WAS TRIED FIRST. An
# earlier 2.9.3 attempt fed an exact expansion the SAME operands the float code
# used -- i.e. coordinates already differenced in floating point -- and changed
# nothing, because the information is gone before the exact arithmetic starts:
# with b, c at ~1e-17 and a at ~4e5, `f64_sub(bx, ax)` and `f64_sub(cx, ax)`
# round to the SAME double, so b and c become one point and the exact answer of
# that rounded question is a faithful 0. The exactness has to extend back
# THROUGH the subtraction, which is why this operates on RAW coordinates and
# expands the determinant into six products rather than differencing first.
#
# It is ADAPTIVE: the float value is computed first and returned whenever it
# clears the error bound, which is every ordinary call. Only a determinant that
# could be a sign error pays for the expansion.
#
# ⛔ 3.3.5 -- THE BOUND AND THE EXPANSION BOTH ASSUME NOTHING LEAVES THE NORMAL RANGE.
# A product that rounds in the subnormal range errs by up to 2^-1075 whatever its
# size, which no relative bound covers, so the filters add an F64_TINY term to their
# bounds: a constant one for the orientation, dot and distance filters, F64_TINY times
# (1 + its degree-2 values) for the in-circle (`_col_ic_sign`). The linear filter
# needs none -- every error it carries is relative (the note on `_COL_DL_LIN_ERRB`).
# A value under its bound is decided exactly. The expansion is exact
# only while each raw product and its rounding error are representable, which
# `_col_o2d_in_window` checks; outside that window -- and for every other exact
# predicate here -- the sign comes from `_col_bi_*`, integer arithmetic that holds
# for any finite doubles.
var _COL_O2D_SPLITTER = 0x41A0_0000_0200_0000;   # 2^27 + 1 = 134217729.0
var _COL_O2D_ERRBOUND = 0x3CB8_0000_0000_0004;   # (3 + 16*2^-53) * 2^-53 = 3.330669073875471e-16
# Window of `_col_o2d_exact_raw`: every coordinate 0 or 2^-480 <= |x| < 2^510. Then
# every raw product is below 2^1020 and a multiple of 2^-1064 (each factor's last bit
# is at least 2^-532), so it, its error term and the six-term sums are all exact.
var _COL_O2D_WIN_LO = 0x21F0_0000_0000_0000;     # 2^-480
var _COL_O2D_WIN_HI = 0x5FD0_0000_0000_0000;     # 2^510
# 40 doubles: aa[4], bb[4], cc[4], ab[8], fin[12]. Allocated on first use of the
# exact path -- the bump allocator never frees, so a per-predicate buffer in
# delaunay_2d's inner loop would be a leak.
# ⛔ 3.3.5 -- ONCE PER delaunay_2d CALL, NOT ONCE PER PROCESS. Through 3.3.4 the
# pointer was cached for good, so after a caller's alloc_reset() it pointed into
# memory the allocator hands out again, and the next delaunay_2d wrote expansions
# over its own triangle vecs. delaunay_2d now clears it, and _COL_BI_BUF, on entry.
var _COL_O2D_BUF = 0;
# Set when one of those buffers cannot be allocated; delaunay_2d then returns its
# empty result instead of writing at an address near 0.
var _COL_DL_NOMEM = 0;

# Exact error terms. `a op b == f64_op(a, b) + <err>(a, b)` for each of these.
fn _col_o2d_sum_err(a, b) {
    var x = f64_add(a, b);
    var bv = f64_sub(x, a);
    var av = f64_sub(x, bv);
    return f64_add(f64_sub(a, av), f64_sub(b, bv));
}

fn _col_o2d_diff_err(a, b) {
    var x = f64_sub(a, b);
    var bv = f64_sub(a, x);
    var av = f64_add(x, bv);
    return f64_add(f64_sub(a, av), f64_sub(bv, b));
}

# Dekker's FastTwoSum tail -- valid only when |a| >= |b|, which the merge below
# guarantees by always consuming the smaller-magnitude component first.
fn _col_o2d_fast_sum_err(a, b) {
    return f64_sub(b, f64_sub(f64_add(a, b), a));
}

fn _col_o2d_prod_err(a, b) {
    var x = f64_mul(a, b);
    var c = f64_mul(_COL_O2D_SPLITTER, a);
    var ab = f64_sub(c, a);
    var ahi = f64_sub(c, ab);
    var alo = f64_sub(a, ahi);
    var d = f64_mul(_COL_O2D_SPLITTER, b);
    var bb = f64_sub(d, b);
    var bhi = f64_sub(d, bb);
    var blo = f64_sub(b, bhi);
    var e1 = f64_sub(x, f64_mul(ahi, bhi));
    var e2 = f64_sub(e1, f64_mul(alo, bhi));
    var e3 = f64_sub(e2, f64_mul(ahi, blo));
    return f64_sub(f64_mul(alo, blo), e3);
}

# (a1 + a0) - (b1 + b0) as a 4-component non-overlapping expansion in `out`,
# increasing in magnitude.
fn _col_o2d_two_two_diff(a1, a0, b1, b0, out) {
    var i0 = f64_sub(a0, b0);
    store64(out, _col_o2d_diff_err(a0, b0));
    var j = f64_add(a1, i0);
    var z = _col_o2d_sum_err(a1, i0);
    var i1 = f64_sub(z, b1);
    store64(out + 8, _col_o2d_diff_err(z, b1));
    store64(out + 24, f64_add(j, i1));
    store64(out + 16, _col_o2d_sum_err(j, i1));
    return 4;
}

# Merge two non-overlapping increasing-magnitude expansions into one, dropping
# zero components (Shewchuk's fast_expansion_sum_zeroelim). Always consuming the
# smaller-magnitude of the two heads is what makes the FastTwoSum above legal.
fn _col_o2d_expsum(e, elen, f, flen, h) {
    var ei = 0;
    var fi = 0;
    var hi = 0;
    var enow = load64(e);
    var fnow = load64(f);
    var q = 0;
    if (f64_gt(f64_abs(fnow), f64_abs(enow)) == 1) {
        q = enow;
        ei = ei + 1;
        if (ei < elen) { enow = load64(e + ei * 8); }
    } else {
        q = fnow;
        fi = fi + 1;
        if (fi < flen) { fnow = load64(f + fi * 8); }
    }
    var first = 1;
    while (ei < elen || fi < flen) {
        var take_e = 0;
        if (ei < elen) {
            if (fi >= flen) { take_e = 1; }
            else { if (f64_gt(f64_abs(fnow), f64_abs(enow)) == 1) { take_e = 1; } }
        }
        var v = 0;
        if (take_e == 1) {
            v = enow;
            ei = ei + 1;
            if (ei < elen) { enow = load64(e + ei * 8); }
        } else {
            v = fnow;
            fi = fi + 1;
            if (fi < flen) { fnow = load64(f + fi * 8); }
        }
        var hh = 0;
        if (first == 1) { hh = _col_o2d_fast_sum_err(v, q); q = f64_add(v, q); first = 0; }
        else { hh = _col_o2d_sum_err(q, v); q = f64_add(q, v); }
        if (f64_eq(hh, 0) == 0) { store64(h + hi * 8, hh); hi = hi + 1; }
    }
    if (f64_eq(q, 0) == 0) { store64(h + hi * 8, q); hi = hi + 1; }
    if (hi == 0) { store64(h, 0); hi = 1; }
    return hi;
}

# Exact sign of orient(a, b, c) = (bx-ax)(cy-ay) - (cx-ax)(by-ay), expanded into
# the six raw products so no difference is ever rounded. The final expansion's
# most significant component carries the sign; components do not overlap, so no
# summation and therefore no rounding is involved in reading it.
fn _col_o2d_exact_raw(ax, ay, bx, by, cx, cy) {
    if (_COL_O2D_BUF == 0) { _COL_O2D_BUF = alloc(40 * 8); }
    if (_COL_O2D_BUF == 0) {
        _COL_DL_NOMEM = 1;
        return 0;
    }
    var aa = _COL_O2D_BUF;
    var bb = _COL_O2D_BUF + 32;
    var cc = _COL_O2D_BUF + 64;
    var ab = _COL_O2D_BUF + 96;
    var fin = _COL_O2D_BUF + 160;
    _col_o2d_two_two_diff(f64_mul(ax, by), _col_o2d_prod_err(ax, by),
      f64_mul(ax, cy), _col_o2d_prod_err(ax, cy), aa);
    _col_o2d_two_two_diff(f64_mul(bx, cy), _col_o2d_prod_err(bx, cy),
      f64_mul(bx, ay), _col_o2d_prod_err(bx, ay), bb);
    _col_o2d_two_two_diff(f64_mul(cx, ay), _col_o2d_prod_err(cx, ay),
      f64_mul(cx, by), _col_o2d_prod_err(cx, by), cc);
    var ablen = _col_o2d_expsum(aa, 4, bb, 4, ab);
    var finlen = _col_o2d_expsum(ab, ablen, cc, 4, fin);
    return _col_f64_sign(load64(fin + (finlen - 1) * 8));
}

# 1 when x is 0 or inside the expansion's window (`_COL_O2D_WIN_LO` above).
fn _col_o2d_win1(x) {
    var m = f64_abs(x);
    if (f64_eq(m, 0) == 1) { return 1; }
    if (f64_lt(m, _COL_O2D_WIN_LO) == 1) { return 0; }
    if (f64_lt(m, _COL_O2D_WIN_HI) == 1) { return 1; }
    return 0;
}

fn _col_o2d_in_window(ax, ay, bx, by, cx, cy) {
    if (_col_o2d_win1(ax) == 0) { return 0; }
    if (_col_o2d_win1(ay) == 0) { return 0; }
    if (_col_o2d_win1(bx) == 0) { return 0; }
    if (_col_o2d_win1(by) == 0) { return 0; }
    if (_col_o2d_win1(cx) == 0) { return 0; }
    return _col_o2d_win1(cy);
}

# Exact sign of orient(a, b, c) for any finite coordinates: the expansion inside
# its window, integers outside it.
#
# 3.3.5: inside the window a certificate comes first. There every difference of two
# coordinates is a multiple of 2^-532 (each coordinate's last bit is at least that),
# every product of two differences a multiple of 2^-1064 below 2^1022, so each
# difference, each product and their error-free tails are exact. When the four
# difference tails and both product tails are 0, l and r are the exact products of the
# exact differences; a subtraction rounds to 0 only when its operands are equal and
# otherwise keeps the sign of their difference, so sign(fl(l - r)) is the orientation.
# That is the common way here: collinear lattice triples, whose float determinant is
# exactly 0, are decided in six error-free transforms instead of the expansion's dozen
# (all 112 such calls of the delaunay_2d_400 bench input). Removing the certificate
# changes no answer, only the cost: the expansion behind it is exact too.
# [measured: scratch instrumented copy on the bench input, 2026-10-11; cycc 6.6.14]
fn _col_o2d_exact(ax, ay, bx, by, cx, cy) {
    if (_col_o2d_in_window(ax, ay, bx, by, cx, cy) == 1) {
        var d1 = f64_sub(bx, ax);
        var d2 = f64_sub(cy, ay);
        var d3 = f64_sub(cx, ax);
        var d4 = f64_sub(by, ay);
        var t = _col_o2d_diff_err(bx, ax) | _col_o2d_diff_err(cy, ay);
        t = t | _col_o2d_diff_err(cx, ax) | _col_o2d_diff_err(by, ay);
        t = t | _col_o2d_prod_err(d1, d2) | _col_o2d_prod_err(d3, d4);
        if ((t & 0x7FFF_FFFF_FFFF_FFFF) == 0) {
            return _col_f64_sign(f64_sub(f64_mul(d1, d2), f64_mul(d3, d4)));
        }
        return _col_o2d_exact_raw(ax, ay, bx, by, cx, cy);
    }
    return _col_bi_pp(bx, ax, cy, ay, cx, ax, by, ay, 0 - 1);
}

# The orientation filter: 1 when the float determinant `det`, formed from the
# products l and r, has its true sign. The bound covers the rounding the two
# subtractions and two products carried in, which is what the cancellation then
# exposes -- so it is taken on |l| + |r|, not on |det| -- plus F64_TINY for a product
# that rounded in the subnormal range. An overflow makes det or the bound +Inf or
# NaN, and the comparison then fails.
fn _col_o2d_clear(det, l, r) {
    var errb = f64_add(f64_mul(_COL_O2D_ERRBOUND, f64_add(f64_abs(l), f64_abs(r))), F64_TINY);
    return f64_gt(f64_abs(det), errb);
}

# -1 / 0 / +1 for the winding of triangle (a, b, c), from RAW coordinates.
#
# ⚠ ON "RAW": passing raw coordinates rather than query-translated ones is one fewer
# rounding step and is what Shewchuk's orient2d takes. Through 3.3.4 no assertion
# told the two apart (2,000,000 mixed-magnitude and 3,000,000 near-degenerate triples
# searched, none found). One exists: (0,0), (1,0), (2, 1e-30) with p = (0.1, 0.3).
# Translated by p, all three y coordinates round to -0.3, so the translated triple is
# collinear while the raw one turns counter-clockwise, and `_col_in_circumcircle`
# would read its determinant against the wrong winding. tests/modules_b.tcyr pins it
# ("3.3.5 Delaunay predicates are exact").
# [measured: scratch search, not reproducible in-tree]
fn _col_orient2d_sign(ax, ay, bx, by, cx, cy) {
    var l = f64_mul(f64_sub(bx, ax), f64_sub(cy, ay));
    var r = f64_mul(f64_sub(cx, ax), f64_sub(by, ay));
    var det = f64_sub(l, r);
    if (_col_o2d_clear(det, l, r) == 1) { return _col_f64_sign(det); }
    return _col_o2d_exact(ax, ay, bx, by, cx, cy);
}

# --- exact signs over the whole double range (3.3.5) -----------------------
#
# Every predicate delaunay_2d evaluates is the sign of an integer polynomial in its
# coordinates, of degree 1 (a ghost's leading term), 2 (an orientation, a dot
# product, a distance comparison) or 4 (the in-circle determinant). A finite double
# is m * 2^e with m an integer, so dividing every coordinate of one call by 2^e0,
# e0 the lowest set bit among them, makes them integers, and the polynomial's sign
# is that of an integer computed exactly. Expansions (above) are faster but need
# every product and its error term representable; these hold for any finite input,
# DBL_MAX beside 2^-1074 included. They run only when a filter cannot decide.
#
# A number lives in one slot: sign (-1 / 0 / +1), limb count, then base-2^30 limbs,
# least significant first, with no leading zero limb. One call's coordinates span at
# most 2^1024 / 2^-1074, so an integer is under 2^2098 (70 limbs), a degree-2 value
# under 2^4199 (140) and the in-circle determinant under 2^8400 (280, and no product
# is written wider than 140 + 140); `_COL_BI_CAP` leaves 20 limbs spare. A limb
# product is under 2^60, so a row of the schoolbook multiply never passes 2^61.
enum _ColBi {
    _COL_BI_MASK = 1073741823;    # 2^30 - 1
    _COL_BI_CAP = 300;
    _COL_BI_SLOT = 2416;          # (2 + _COL_BI_CAP) * 8 bytes
    _COL_BI_NSLOT = 12;
}
# _COL_BI_NSLOT slots, allocated on first use, once per delaunay_2d call, like
# _COL_O2D_BUF (and cleared with it on entry).
var _COL_BI_BUF = 0;

# 1 when the slots are there, allocating them if need be; 0, with _COL_DL_NOMEM
# set, when they cannot be. Every `_col_bi_*` entry asks before touching a slot.
fn _col_bi_ready() {
    if (_COL_BI_BUF == 0) { _COL_BI_BUF = alloc(_COL_BI_NSLOT * _COL_BI_SLOT); }
    if (_COL_BI_BUF == 0) {
        _COL_DL_NOMEM = 1;
        return 0;
    }
    return 1;
}

fn _col_bi_slot(k) {
    return _COL_BI_BUF + k * _COL_BI_SLOT;
}

# Lowest set bit of a finite double, as a power of two; 4096 for a zero, so a zero
# never lowers a minimum. `m` and `e` give |x| = m * 2^e.
fn _col_bi_lsb(x) {
    var m = x & 0x7FFF_FFFF_FFFF_FFFF;
    if (m == 0) { return 4096; }
    var be = m >> 52;
    var e = 0 - 1074;
    m = m & 0x000F_FFFF_FFFF_FFFF;
    if (be > 0) {
        m = m | 0x0010_0000_0000_0000;
        e = be - 1075;
    }
    if ((m & 0xFFFF_FFFF) == 0) { m = m >> 32; e = e + 32; }
    if ((m & 0xFFFF) == 0) { m = m >> 16; e = e + 16; }
    if ((m & 0xFF) == 0) { m = m >> 8; e = e + 8; }
    if ((m & 0xF) == 0) { m = m >> 4; e = e + 4; }
    if ((m & 0x3) == 0) { m = m >> 2; e = e + 2; }
    if ((m & 0x1) == 0) { e = e + 1; }
    return e;
}

fn _col_bi_min(e, x) {
    var b = _col_bi_lsb(x);
    if (b < e) { return b; }
    return e;
}

# Slot r = x / 2^e0, an integer because e0 is at most x's lowest set bit.
fn _col_bi_set(r, x, e0) {
    var m = x & 0x7FFF_FFFF_FFFF_FFFF;
    if (m == 0) {
        store64(r, 0);
        store64(r + 8, 0);
        return 0;
    }
    var be = m >> 52;
    var e = 0 - 1074;
    m = m & 0x000F_FFFF_FFFF_FFFF;
    if (be > 0) {
        m = m | 0x0010_0000_0000_0000;
        e = be - 1075;
    }
    # Shift the trailing zeros out first, so the shift below is never negative.
    var el = _col_bi_lsb(x);
    m = m >> (el - e);
    var sh = el - e0;
    var q = sh / 30;
    var rb = sh - q * 30;
    for (var i = 0; i < q; i = i + 1) { store64(r + 16 + i * 8, 0); }
    store64(r + 16 + q * 8, (m << rb) & _COL_BI_MASK);
    store64(r + 24 + q * 8, (m >> (30 - rb)) & _COL_BI_MASK);
    store64(r + 32 + q * 8, (m >> (60 - rb)) & _COL_BI_MASK);
    var len = q + 3;
    while (load64(r + 8 + len * 8) == 0) { len = len - 1; }
    store64(r + 8, len);
    if ((x >> 63) == 0) { store64(r, 1); } else { store64(r, 0 - 1); }
    return 0;
}

# -1 / 0 / +1 comparing |a| with |b|.
fn _col_bi_cmpmag(a, b) {
    var la = load64(a + 8);
    var lb = load64(b + 8);
    if (la > lb) { return 1; }
    if (la < lb) { return 0 - 1; }
    var i = la - 1;
    while (i >= 0) {
        var va = load64(a + 16 + i * 8);
        var vb = load64(b + 16 + i * 8);
        if (va > vb) { return 1; }
        if (va < vb) { return 0 - 1; }
        i = i - 1;
    }
    return 0;
}

# |r| = |a| + |b|. Limb i of r is written after limb i of a and b is read, so r may be
# a or b.
fn _col_bi_addmag(r, a, b) {
    var la = load64(a + 8);
    var lb = load64(b + 8);
    var n = la;
    if (lb > n) { n = lb; }
    var carry = 0;
    for (var i = 0; i < n; i = i + 1) {
        var s = carry;
        if (i < la) { s = s + load64(a + 16 + i * 8); }
        if (i < lb) { s = s + load64(b + 16 + i * 8); }
        store64(r + 16 + i * 8, s & _COL_BI_MASK);
        carry = s >> 30;
    }
    if (carry != 0) {
        store64(r + 16 + n * 8, carry);
        n = n + 1;
    }
    store64(r + 8, n);
    return 0;
}

# |r| = |a| - |b| for |a| > |b|; r may be a or b, as above.
fn _col_bi_submag(r, a, b) {
    var la = load64(a + 8);
    var lb = load64(b + 8);
    var borrow = 0;
    for (var i = 0; i < la; i = i + 1) {
        var s = load64(a + 16 + i * 8) - borrow;
        if (i < lb) { s = s - load64(b + 16 + i * 8); }
        borrow = 0;
        if (s < 0) {
            s = s + 1073741824;
            borrow = 1;
        }
        store64(r + 16 + i * 8, s);
    }
    var n = la;
    while (load64(r + 8 + n * 8) == 0) { n = n - 1; }
    store64(r + 8, n);
    return 0;
}

# r = a + sb * b, sb = +1 or -1. r may be a or b.
fn _col_bi_add(r, a, b, sb) {
    var sa = load64(a);
    var sbv = load64(b) * sb;
    if (sbv == 0) {
        if (r != a) {
            var la = load64(a + 8);
            for (var i = 0; i < la; i = i + 1) { store64(r + 16 + i * 8, load64(a + 16 + i * 8)); }
            store64(r + 8, la);
        }
        store64(r, sa);
        return 0;
    }
    if (sa == 0) {
        if (r != b) {
            var lb = load64(b + 8);
            for (var i = 0; i < lb; i = i + 1) { store64(r + 16 + i * 8, load64(b + 16 + i * 8)); }
            store64(r + 8, lb);
        }
        store64(r, sbv);
        return 0;
    }
    if (sa == sbv) {
        _col_bi_addmag(r, a, b);
        store64(r, sa);
        return 0;
    }
    var c = _col_bi_cmpmag(a, b);
    if (c == 0) {
        store64(r, 0);
        store64(r + 8, 0);
        return 0;
    }
    if (c > 0) {
        _col_bi_submag(r, a, b);
        store64(r, sa);
        return 0;
    }
    _col_bi_submag(r, b, a);
    store64(r, sbv);
    return 0;
}

# r = a * b; r is neither a nor b.
fn _col_bi_mul(r, a, b) {
    var sa = load64(a);
    var sb = load64(b);
    if (sa * sb == 0) {
        store64(r, 0);
        store64(r + 8, 0);
        return 0;
    }
    var la = load64(a + 8);
    var lb = load64(b + 8);
    var n = la + lb;
    for (var k = 0; k < n; k = k + 1) { store64(r + 16 + k * 8, 0); }
    for (var i = 0; i < la; i = i + 1) {
        var ai = load64(a + 16 + i * 8);
        var carry = 0;
        for (var j = 0; j < lb; j = j + 1) {
            var p = r + 16 + (i + j) * 8;
            var t = load64(p) + ai * load64(b + 16 + j * 8) + carry;
            store64(p, t & _COL_BI_MASK);
            carry = t >> 30;
        }
        store64(r + 16 + (i + lb) * 8, carry);
    }
    while (load64(r + 8 + n * 8) == 0) { n = n - 1; }
    store64(r + 8, n);
    store64(r, sa * sb);
    return 0;
}

# r = a * k for a small integer k (|k| <= 4); r may be a.
fn _col_bi_scale(r, a, k) {
    var sa = load64(a);
    if (sa * k == 0) {
        store64(r, 0);
        store64(r + 8, 0);
        return 0;
    }
    var ka = k;
    var sk = 1;
    if (k < 0) {
        ka = 0 - k;
        sk = 0 - 1;
    }
    var la = load64(a + 8);
    var carry = 0;
    for (var i = 0; i < la; i = i + 1) {
        var t = load64(a + 16 + i * 8) * ka + carry;
        store64(r + 16 + i * 8, t & _COL_BI_MASK);
        carry = t >> 30;
    }
    if (carry != 0) {
        store64(r + 16 + la * 8, carry);
        la = la + 1;
    }
    store64(r + 8, la);
    store64(r, sa * sk);
    return 0;
}

# sign(k1 * (x1 - y1) + k2 * (x2 - y2)), k1 and k2 small integers.
fn _col_bi_lin(k1, x1, y1, k2, x2, y2) {
    if (_col_bi_ready() == 0) { return 0; }
    var e0 = _col_bi_min(_col_bi_min(_col_bi_min(_col_bi_min(4096, x1), y1), x2), y2);
    var s0 = _col_bi_slot(0);
    var s1 = _col_bi_slot(1);
    var s2 = _col_bi_slot(2);
    var s3 = _col_bi_slot(3);
    _col_bi_set(s0, x1, e0);
    _col_bi_set(s1, y1, e0);
    _col_bi_add(s0, s0, s1, 0 - 1);
    _col_bi_scale(s0, s0, k1);
    _col_bi_set(s2, x2, e0);
    _col_bi_set(s3, y2, e0);
    _col_bi_add(s2, s2, s3, 0 - 1);
    _col_bi_scale(s2, s2, k2);
    _col_bi_add(s0, s0, s2, 1);
    return load64(s0);
}

# sign((x1 - y1)(x2 - y2) + sg * (x3 - y3)(x4 - y4)), sg = +1 or -1: an orientation
# or a dot product of differences.
fn _col_bi_pp(x1, y1, x2, y2, x3, y3, x4, y4, sg) {
    if (_col_bi_ready() == 0) { return 0; }
    var e0 = _col_bi_min(_col_bi_min(_col_bi_min(_col_bi_min(4096, x1), y1), x2), y2);
    e0 = _col_bi_min(_col_bi_min(_col_bi_min(_col_bi_min(e0, x3), y3), x4), y4);
    var s0 = _col_bi_slot(0);
    var s1 = _col_bi_slot(1);
    var s2 = _col_bi_slot(2);
    var s3 = _col_bi_slot(3);
    var s4 = _col_bi_slot(4);
    var s5 = _col_bi_slot(5);
    _col_bi_set(s0, x1, e0);
    _col_bi_set(s1, y1, e0);
    _col_bi_add(s0, s0, s1, 0 - 1);
    _col_bi_set(s1, x2, e0);
    _col_bi_set(s2, y2, e0);
    _col_bi_add(s1, s1, s2, 0 - 1);
    _col_bi_mul(s4, s0, s1);
    _col_bi_set(s0, x3, e0);
    _col_bi_set(s1, y3, e0);
    _col_bi_add(s0, s0, s1, 0 - 1);
    _col_bi_set(s1, x4, e0);
    _col_bi_set(s2, y4, e0);
    _col_bi_add(s1, s1, s2, 0 - 1);
    _col_bi_mul(s5, s0, s1);
    _col_bi_add(s4, s4, s5, sg);
    return load64(s4);
}

# sign(|r - a|^2 - |p - a|^2).
fn _col_bi_dist(rx, ry, ax, ay, px, py) {
    if (_col_bi_ready() == 0) { return 0; }
    var e0 = _col_bi_min(_col_bi_min(_col_bi_min(4096, rx), ry), ax);
    e0 = _col_bi_min(_col_bi_min(_col_bi_min(e0, ay), px), py);
    var s0 = _col_bi_slot(0);
    var s1 = _col_bi_slot(1);
    var s2 = _col_bi_slot(2);
    var s3 = _col_bi_slot(3);
    var s4 = _col_bi_slot(4);
    var s5 = _col_bi_slot(5);
    var s6 = _col_bi_slot(6);
    _col_bi_set(s4, ax, e0);
    _col_bi_set(s5, ay, e0);
    _col_bi_set(s0, rx, e0);
    _col_bi_add(s0, s0, s4, 0 - 1);
    _col_bi_set(s1, ry, e0);
    _col_bi_add(s1, s1, s5, 0 - 1);
    _col_bi_set(s2, px, e0);
    _col_bi_add(s2, s2, s4, 0 - 1);
    _col_bi_set(s3, py, e0);
    _col_bi_add(s3, s3, s5, 0 - 1);
    _col_bi_mul(s4, s0, s0);
    _col_bi_mul(s5, s1, s1);
    _col_bi_add(s4, s4, s5, 1);
    _col_bi_mul(s5, s2, s2);
    _col_bi_mul(s6, s3, s3);
    _col_bi_add(s5, s5, s6, 1);
    _col_bi_add(s4, s4, s5, 0 - 1);
    return load64(s4);
}

# One row of the in-circle determinant: acc += lift(u) * (v x w), with u, v, w the
# translated points in slots (ux, uy), (vx, vy), (wx, wy).
fn _col_bi_ic_row(acc, ux, uy, vx, vy, wx, wy) {
    var t0 = _col_bi_slot(8);
    var t1 = _col_bi_slot(9);
    var t2 = _col_bi_slot(10);
    _col_bi_mul(t0, vx, wy);
    _col_bi_mul(t1, wx, vy);
    _col_bi_add(t0, t0, t1, 0 - 1);
    _col_bi_mul(t1, ux, ux);
    _col_bi_mul(t2, uy, uy);
    _col_bi_add(t1, t1, t2, 1);
    _col_bi_mul(t2, t1, t0);
    _col_bi_add(acc, acc, t2, 1);
    return 0;
}

# Sign of the in-circle determinant of a, b, c against p -- Shewchuk's
# incircle(a, b, c, p): positive when p is inside the circle through a, b, c taken
# counter-clockwise.
fn _col_bi_incircle(ax, ay, bx, by, cx, cy, px, py) {
    if (_col_bi_ready() == 0) { return 0; }
    var e0 = _col_bi_min(_col_bi_min(_col_bi_min(_col_bi_min(4096, ax), ay), bx), by);
    e0 = _col_bi_min(_col_bi_min(_col_bi_min(_col_bi_min(e0, cx), cy), px), py);
    var sax = _col_bi_slot(0);
    var say = _col_bi_slot(1);
    var sbx = _col_bi_slot(2);
    var sby = _col_bi_slot(3);
    var scx = _col_bi_slot(4);
    var scy = _col_bi_slot(5);
    var spx = _col_bi_slot(6);
    var spy = _col_bi_slot(7);
    var acc = _col_bi_slot(11);
    _col_bi_set(spx, px, e0);
    _col_bi_set(spy, py, e0);
    _col_bi_set(sax, ax, e0);
    _col_bi_add(sax, sax, spx, 0 - 1);
    _col_bi_set(say, ay, e0);
    _col_bi_add(say, say, spy, 0 - 1);
    _col_bi_set(sbx, bx, e0);
    _col_bi_add(sbx, sbx, spx, 0 - 1);
    _col_bi_set(sby, by, e0);
    _col_bi_add(sby, sby, spy, 0 - 1);
    _col_bi_set(scx, cx, e0);
    _col_bi_add(scx, scx, spx, 0 - 1);
    _col_bi_set(scy, cy, e0);
    _col_bi_add(scy, scy, spy, 0 - 1);
    store64(acc, 0);
    store64(acc + 8, 0);
    _col_bi_ic_row(acc, sax, say, sbx, sby, scx, scy);
    _col_bi_ic_row(acc, sbx, sby, scx, scy, sax, say);
    _col_bi_ic_row(acc, scx, scy, sax, say, sbx, sby);
    return load64(acc);
}

# Shewchuk's in-circle filter bound, (10 + 96e)e with e = 2^-53.
var _COL_ICC_ERRBOUND = 0x3CD4_0000_0000_0006;   # (10 + 96*2^-53) * 2^-53 = 1.1102230246251577e-15

# --- the in-circle's middle stage (3.3.5) ----------------------------------
#
# A failed in-circle filter is, on near-cocircular input, the common case: the
# determinant of four sites rounded from one circle is a few ulps of the permanent.
# Between the filter and `_col_bi_incircle` sits Shewchuk's adaptive idea in
# double-double form, for calls whose six differences d = h + t (h = fl(x - p), t
# its exact tail) have every nonzero |h| in [2^-240, 2^252]:
#   * D(h), the determinant of the highs, in double-double: each degree-2 product
#     and the lift and cross sums as error-free pairs, each row's product with its
#     first-order correction, and the three rows summed with error-free transforms.
#     The pairs carry 3e^2 of their sums each, a row about 23e^2 L(|p1| + |p2|) and
#     summing the three rows about 19e^2 * perm more, so D(h) is within about
#     42e^2 * perm of exact (e = 2^-53, perm the permanent);
#   * T1 = sum over the six differences of dD/dd * t, in floats. Since D is a
#     degree-4 polynomial and |t| <= e|h|, D(h + t) - D(h) - T1 is within 6.1e^2 * perm,
#     and T1 itself (at most 4e * perm) is evaluated within about 40e^2 * perm.
# So D(h) + T1 is within about 95e^2 * perm of D (a count re-derived by the second
# review). The stage answers only when its value clears 2^-86 * perm (2^20 e^2, a
# margin of four orders of magnitude). The margin comes from that derivation, not from
# testing: 2^-106 answers wrong on a pinned witness, but 2^-100 (64e^2, under the
# derived worst case) had no witness in 1,050,000 cases. Near-cocircular
# sites clear it by far more: over 2,999 nondegenerate quadruples of nearby sites of the
# delaunay_2d_circle_150 bench input, |D| / perm has median 10^-15.9 and least 10^-20.7.
# [measured: scratch exact-rational survey of the bench input, 2026-10-11; cycc 6.6.14]
# The window keeps every degree-2 product of highs and its error term normal and every
# degree-4 value under 2^1012. A degree-4 product's tail (tht) can be subnormal, and is
# exact all the same: each factor's last bit is at least 2^-532, so the product and its
# tail lie on the 2^-1064 grid. And when every error-free tail comes out exactly 0 --
# integer grids, the four corners of a lattice square -- nothing was rounded at all,
# so D(h) is D and its sign is final, a tie included. Anything else goes on to the
# integers.
var _COL_IC_WIN_LO = 0x30F0_0000_0000_0000;      # 2^-240
var _COL_IC_WIN_HI = 0x4FB0_0000_0000_0000;      # 2^252
var _COL_IC_DD_ERRB = 0x3A90_0000_0000_0000;     # 2^-86

# 1 when h is 0 or in the middle stage's window.
fn _col_ic_win1(h) {
    var m = f64_abs(h);
    if (f64_eq(m, 0) == 1) { return 1; }
    if (f64_lt(m, _COL_IC_WIN_LO) == 1) { return 0; }
    if (f64_gt(m, _COL_IC_WIN_HI) == 1) { return 0; }
    return 1;
}

# -1 / 0 / +1 for Shewchuk's incircle(a, b, c, p) when the middle stage can decide,
# 2 when it cannot (outside its window, or too close to a tie).
fn _col_ic_adapt(ax, ay, bx, by, cx, cy, px, py) {
    var adx = f64_sub(ax, px);
    var ady = f64_sub(ay, py);
    var bdx = f64_sub(bx, px);
    var bdy = f64_sub(by, py);
    var cdx = f64_sub(cx, px);
    var cdy = f64_sub(cy, py);
    if (_col_ic_win1(adx) + _col_ic_win1(ady) + _col_ic_win1(bdx) < 3) { return 2; }
    if (_col_ic_win1(bdy) + _col_ic_win1(cdx) + _col_ic_win1(cdy) < 3) { return 2; }
    var adxt = _col_o2d_diff_err(ax, px);
    var adyt = _col_o2d_diff_err(ay, py);
    var bdxt = _col_o2d_diff_err(bx, px);
    var bdyt = _col_o2d_diff_err(by, py);
    var cdxt = _col_o2d_diff_err(cx, px);
    var cdyt = _col_o2d_diff_err(cy, py);
    # `z` ORs every error-free tail's magnitude bits: 0 means nothing was rounded.
    # Each tail below is load-bearing except where marked. p1t and p2t are implied:
    # for significands m1, m2, m1 * m2 <= max(m1^2, m2^2), so a rounded product of two
    # highs means one of their squares rounds, and every high is squared in some row's
    # lift. cht, e1, e2 and row c's tht had no witness in 1,050,000 cases -- kept, an
    # open question rather than a proof.
    # [measured: second-review corpus and compiled mutants, 2026-10-11; cycc 6.6.14]
    var mag = 0x7FFF_FFFF_FFFF_FFFF;
    var z = (adxt | adyt | bdxt | bdyt | cdxt | cdyt) & mag;
    # Row a: lift(a) * (b x c), b x c = bdx*cdy - cdx*bdy.
    var p1 = f64_mul(bdx, cdy);
    var p2 = f64_mul(cdx, bdy);
    var p1t = _col_o2d_prod_err(bdx, cdy);
    var p2t = _col_o2d_prod_err(cdx, bdy);
    var cha = f64_sub(p1, p2);
    var cht = _col_o2d_diff_err(p1, p2);
    var cla = f64_add(cht, f64_sub(p1t, p2t));
    var pma = f64_add(f64_abs(p1), f64_abs(p2));
    var q1 = f64_mul(adx, adx);
    var q2 = f64_mul(ady, ady);
    var q1t = _col_o2d_prod_err(adx, adx);
    var q2t = _col_o2d_prod_err(ady, ady);
    var lha = f64_add(q1, q2);
    var lht = _col_o2d_sum_err(q1, q2);
    var lla = f64_add(lht, f64_add(q1t, q2t));
    var tha = f64_mul(lha, cha);
    var tht = _col_o2d_prod_err(lha, cha);
    var tla = f64_add(tht, f64_add(f64_mul(lha, cla), f64_mul(lla, cha)));
    z = z | ((p1t | p2t | cht | q1t | q2t | lht | tht) & mag);
    # Row b: lift(b) * (c x a), c x a = cdx*ady - adx*cdy.
    p1 = f64_mul(cdx, ady);
    p2 = f64_mul(adx, cdy);
    p1t = _col_o2d_prod_err(cdx, ady);
    p2t = _col_o2d_prod_err(adx, cdy);
    var chb = f64_sub(p1, p2);
    cht = _col_o2d_diff_err(p1, p2);
    var clb = f64_add(cht, f64_sub(p1t, p2t));
    var pmb = f64_add(f64_abs(p1), f64_abs(p2));
    q1 = f64_mul(bdx, bdx);
    q2 = f64_mul(bdy, bdy);
    q1t = _col_o2d_prod_err(bdx, bdx);
    q2t = _col_o2d_prod_err(bdy, bdy);
    var lhb = f64_add(q1, q2);
    lht = _col_o2d_sum_err(q1, q2);
    var llb = f64_add(lht, f64_add(q1t, q2t));
    var thb = f64_mul(lhb, chb);
    tht = _col_o2d_prod_err(lhb, chb);
    var tlb = f64_add(tht, f64_add(f64_mul(lhb, clb), f64_mul(llb, chb)));
    z = z | ((p1t | p2t | cht | q1t | q2t | lht | tht) & mag);
    # Row c: lift(c) * (a x b), a x b = adx*bdy - bdx*ady.
    p1 = f64_mul(adx, bdy);
    p2 = f64_mul(bdx, ady);
    p1t = _col_o2d_prod_err(adx, bdy);
    p2t = _col_o2d_prod_err(bdx, ady);
    var chc = f64_sub(p1, p2);
    cht = _col_o2d_diff_err(p1, p2);
    var clc = f64_add(cht, f64_sub(p1t, p2t));
    var pmc = f64_add(f64_abs(p1), f64_abs(p2));
    q1 = f64_mul(cdx, cdx);
    q2 = f64_mul(cdy, cdy);
    q1t = _col_o2d_prod_err(cdx, cdx);
    q2t = _col_o2d_prod_err(cdy, cdy);
    var lhc = f64_add(q1, q2);
    lht = _col_o2d_sum_err(q1, q2);
    var llc = f64_add(lht, f64_add(q1t, q2t));
    var thc = f64_mul(lhc, chc);
    tht = _col_o2d_prod_err(lhc, chc);
    var tlc = f64_add(tht, f64_add(f64_mul(lhc, clc), f64_mul(llc, chc)));
    z = z | ((p1t | p2t | cht | q1t | q2t | lht | tht) & mag);
    # D(h) = dh + dl.
    var s1 = f64_add(tha, thb);
    var e1 = _col_o2d_sum_err(tha, thb);
    var dh = f64_add(s1, thc);
    var e2 = _col_o2d_sum_err(s1, thc);
    z = z | ((e1 | e2) & mag);
    if (z == 0) { return _col_f64_sign(dh); }
    var dl = f64_add(f64_add(e1, e2), f64_add(f64_add(tla, tlb), tlc));
    # T1: each difference's tail times dD/dd at the highs.
    var two = F64_TWO;
    var g1 = f64_mul(adxt, f64_add(f64_mul(f64_mul(two, adx), cha), f64_sub(f64_mul(lhc, bdy), f64_mul(lhb, cdy))));
    var g2 = f64_mul(adyt, f64_add(f64_mul(f64_mul(two, ady), cha), f64_sub(f64_mul(lhb, cdx), f64_mul(lhc, bdx))));
    var g3 = f64_mul(bdxt, f64_add(f64_mul(f64_mul(two, bdx), chb), f64_sub(f64_mul(lha, cdy), f64_mul(lhc, ady))));
    var g4 = f64_mul(bdyt, f64_add(f64_mul(f64_mul(two, bdy), chb), f64_sub(f64_mul(lhc, adx), f64_mul(lha, cdx))));
    var g5 = f64_mul(cdxt, f64_add(f64_mul(f64_mul(two, cdx), chc), f64_sub(f64_mul(lhb, ady), f64_mul(lha, bdy))));
    var g6 = f64_mul(cdyt, f64_add(f64_mul(f64_mul(two, cdy), chc), f64_sub(f64_mul(lha, bdx), f64_mul(lhb, adx))));
    var t1 = f64_add(f64_add(f64_add(g1, g2), f64_add(g3, g4)), f64_add(g5, g6));
    var v = f64_add(dh, f64_add(dl, t1));
    var perm = f64_add(f64_add(f64_mul(pma, lha), f64_mul(pmb, lhb)), f64_mul(pmc, lhc));
    # No F64_TINY term: a nonzero D has a monomial of four nonzero highs, each at least
    # 2^-240, so perm is at least 2^-961 and the bound at least 2^-1047, far above the
    # 2^-1075 each of the few dozen corrections can lose by rounding in the subnormal range.
    if (f64_gt(f64_abs(v), f64_mul(_COL_IC_DD_ERRB, perm)) == 1) { return _col_f64_sign(v); }
    return 2;
}

# -1 / 0 / +1: the sign of Shewchuk's incircle(a, b, c, p), from RAW coordinates --
# positive when p is strictly inside the circle through a, b, c taken
# counter-clockwise. The float value, on coordinates translated to p, is returned
# whenever it clears Shewchuk's bound (which covers the rounding of that translation)
# plus F64_TINY * (1 + every degree-2 value). A product rounded in the subnormal range
# errs by up to 2^-1075 whatever its size: a degree-2 product's error is then
# multiplied by a lift or a cross term, hence those values, and the three degree-4
# products' own errors are multiplied by nothing, hence the 1 -- on four sites whose
# lifts and cross terms are all far below DBL_MIN it is the whole bound.
# Anything else goes to the middle stage `_col_ic_adapt`, then `_col_bi_incircle`.
fn _col_ic_sign(ax, ay, bx, by, cx, cy, px, py) {
    var adx = f64_sub(ax, px);
    var ady = f64_sub(ay, py);
    var bdx = f64_sub(bx, px);
    var bdy = f64_sub(by, py);
    var cdx = f64_sub(cx, px);
    var cdy = f64_sub(cy, py);
    var bdxcdy = f64_mul(bdx, cdy);
    var cdxbdy = f64_mul(cdx, bdy);
    var cdxady = f64_mul(cdx, ady);
    var adxcdy = f64_mul(adx, cdy);
    var adxbdy = f64_mul(adx, bdy);
    var bdxady = f64_mul(bdx, ady);
    var alift = f64_add(f64_mul(adx, adx), f64_mul(ady, ady));
    var blift = f64_add(f64_mul(bdx, bdx), f64_mul(bdy, bdy));
    var clift = f64_add(f64_mul(cdx, cdx), f64_mul(cdy, cdy));
    var ta = f64_mul(alift, f64_sub(bdxcdy, cdxbdy));
    var tb = f64_mul(blift, f64_sub(cdxady, adxcdy));
    var tc = f64_mul(clift, f64_sub(adxbdy, bdxady));
    var det = f64_add(f64_add(ta, tb), tc);
    var pa = f64_add(f64_abs(bdxcdy), f64_abs(cdxbdy));
    var pb = f64_add(f64_abs(cdxady), f64_abs(adxcdy));
    var pc = f64_add(f64_abs(adxbdy), f64_abs(bdxady));
    var perm = f64_add(f64_add(f64_mul(pa, alift), f64_mul(pb, blift)), f64_mul(pc, clift));
    var lifts = f64_add(f64_add(alift, blift), f64_add(clift, F64_ONE));
    var deg2 = f64_add(lifts, f64_add(f64_add(pa, pb), pc));
    var errb = f64_add(f64_mul(_COL_ICC_ERRBOUND, perm), f64_mul(F64_TINY, deg2));
    if (f64_gt(f64_abs(det), errb) == 1) { return _col_f64_sign(det); }
    var mid = _col_ic_adapt(ax, ay, bx, by, cx, cy, px, py);
    if (mid != 2) { return mid; }
    return _col_bi_incircle(ax, ay, bx, by, cx, cy, px, py);
}

# Check if point p is inside circumcircle of triangle (a, b, c).
# Real vertices only -- see _col_dl_incircle for the ghost-aware entry point.
#
# ⛔ 3.3.5 -- THE DETERMINANT IS EXACT (`_col_ic_sign`). Through 3.3.4 it was a float
# determinant on coordinates translated to p, left non-adaptive because no sweep of
# single-scale sets found it wrong (the D055 decision, archived in
# docs/development/issues/archived/2026-08-04-incircle-precision.md). Its reopen trigger
# was a caller passing coordinates not drawn from one scale -- and delaunay_2d is one:
# sets mixing magnitudes came back wrong at scale 1, a 3-site triangle empty among
# them. The translation is kept for the filter, where it keeps the determinant on the
# scale of the triangle (a 1e-8-wide cluster at x = 1e9 differences exactly into
# 1e-8-scale operands); the exact path reads raw coordinates.
fn _col_in_circumcircle(points, ai, bi, ci, px, py) {
    var ap = vec_get(points, ai);
    var bp = vec_get(points, bi);
    var cp = vec_get(points, ci);
    var det = _col_ic_sign(HVec2_x(ap), HVec2_y(ap), HVec2_x(bp), HVec2_y(bp),
      HVec2_x(cp), HVec2_y(cp), px, py);

    # Sign depends on winding of triangle.
    #
    # 2.9.3: taken from the RAW coordinates, not from coordinates translated to the
    # query point. That differencing is the step that loses the sign on a
    # mixed-scale set -- see the note on _col_orient2d_sign.
    # [measured: docs/development/issues/archived/2026-08-04-incircle-precision.md]
    var cross = _col_orient2d_sign(HVec2_x(ap), HVec2_y(ap),
      HVec2_x(bp), HVec2_y(bp), HVec2_x(cp), HVec2_y(cp));

    if (cross > 0) {
        if (det > 0) { return 1; }
        return 0;
    }
    if (det < 0) { return 1; }
    return 0;
}

# --- symbolic ghost vertices -----------------------------------------------
#
# Bowyer-Watson must start from a triangle containing every input point. The
# classic device is a "super-triangle" placed some multiple of the bounding box
# away, and until 2.8.2 that multiple was 10 -- which is why delaunay_2d shipped
# SILENTLY INCOMPLETE. Reduction to the true Delaunay triangulation requires
# that no super-vertex lie inside the circumcircle of any real triangle; at 10x
# that is routinely false, the real triangle is never created, and the
# compaction pass then drops the super-vertex triangle that had been covering
# the gap. Measured against exact rational arithmetic, 15-37% of uniform-random
# point sets came back short at least one triangle, and 29 of 40 seeds at
# n = 160.
# [measured: CHANGELOG.md 2.8.2, the 15-37% figure and its class table (uniform-unit n=160: 11/40 correct)]
#
# Enlarging the multiplier does NOT fix it. It moves the failure into the
# in-circle determinant, which then differences quantities separated by twenty
# or more orders of magnitude and loses every significant bit of the sign. The
# two defects are coupled -- the multiplier trades super-triangle adequacy
# against determinant conditioning, and no value wins both (see
# docs/development/issues/archived/2026-08-04-incircle-precision.md). The old
# `dx = max(span, 1.0)` floor made this concrete: a cluster of span 1e-14 got a
# super-triangle 1e15 times its own size, and 16 of 40 such sets came back
# unsound or short; at span 1e-20 it was 40 of 40, one of them covering 1.69x
# its own convex hull.
# [measured: CHANGELOG.md 2.8.2 class table (cluster span 1e-14 24/40, 1e-20 0/40 correct); the 1.69x is unrecorded]
#
# So the three apexes are not placed anywhere. They are vertices AT INFINITY in
# three fixed directions,
#
#     u0 = (1, 2)     u1 = (-2, 1)     u2 = (1, -2)
#
# i.e. vertex index n + k denotes the limit of A + M * u_k as M -> infinity,
# with A = points[0] as the (arbitrary but fixed) apex. The directions
# positively span the plane, so for large enough M the triangle they form
# contains any bounded input; they are listed counter-clockwise; and their
# components are exact powers of two, so multiplying a coordinate by one is
# exact.
#
# Every predicate involving a ghost is evaluated as the sign of the leading
# nonzero coefficient of its determinant expanded as a polynomial in M -- which
# is its sign for all sufficiently large finite M. A build evaluates finitely
# many predicates, so a single M satisfies all of them at once: the ghost
# predicate set is realisable by an actual point configuration, which is exactly
# what the walk and the flood fill need in order to stay consistent. No
# multiplier is ever chosen and nothing is stored for a ghost.
#
# Two things fall out:
#   * a ghost can never lie inside a real circumcircle, so completeness is
#     structural rather than tuned; and
#   * every determinant the build evaluates is either over real points only
#     (translated to the query point, the well-conditioned form) or collapses to
#     an orientation test / distance comparison against u components in
#     {1, 2, -2}. The magnitude spread that used to destroy the sign is gone.
#
# The expansions used below were derived by exact polynomial expansion in M and
# each rule was then re-verified against the exact rational determinant at
# M = 1e5 ... 1e34, including all four degenerate (leading-coefficient-zero)
# branches.
#
# All three |u_k|^2 are equal (5). That is not decoration: it makes the M^2
# coefficient of the two-ghost in-circle determinant collapse to
# (u_j x u_k) * (|R - A|^2 - |A - p|^2), a plain distance comparison against the
# apex. With unequal norms that coefficient keeps a query-position-dependent
# tail and there is no clean tie-break.
var _COL_DL_U0X = 0x3FF0_0000_0000_0000;   # 1.0
var _COL_DL_U0Y = 0x4000_0000_0000_0000;   # 2.0
var _COL_DL_U1X = 0xC000_0000_0000_0000;   # -2.0
var _COL_DL_U1Y = 0x3FF0_0000_0000_0000;   # 1.0
var _COL_DL_U2X = 0x3FF0_0000_0000_0000;   # 1.0
var _COL_DL_U2Y = 0xC000_0000_0000_0000;   # -2.0

fn _col_ghost_ux(k) {
    if (k == 0) { return _COL_DL_U0X; }
    if (k == 1) { return _COL_DL_U1X; }
    return _COL_DL_U2X;
}

fn _col_ghost_uy(k) {
    if (k == 0) { return _COL_DL_U0Y; }
    if (k == 1) { return _COL_DL_U1Y; }
    return _COL_DL_U2Y;
}

# -1 / 0 / +1 for an f64 bit pattern. NaN reports 0 (neither comparison holds),
# which is the same "degenerate, take the next term" branch a true zero takes.
fn _col_f64_sign(v) {
    if (f64_gt(v, 0) == 1) { return 1; }
    if (f64_lt(v, 0) == 1) { return 0 - 1; }
    return 0;
}

# u_j x u_k, as a sign. Never zero for j != k (the three directions are
# pairwise non-parallel), and positive exactly for the cyclic pairs (0,1),
# (1,2), (2,0) -- which is what makes the ghost triangle counter-clockwise.
fn _col_ghost_cross(j, k) {
    return _col_f64_sign(f64_sub(f64_mul(_col_ghost_ux(j), _col_ghost_uy(k)),
        f64_mul(_col_ghost_uy(j), _col_ghost_ux(k))));
}

# --- adjacency-based Bowyer-Watson: representation -------------------------
#
# delaunay_2d keeps two parallel flat vecs plus a stamp vec:
#
#   tris[t * 3 + k]  vertex k of triangle t, or (0 - 1) in slot k=0 when the
#                    triangle has been TOMBSTONED (removed but not compacted)
#   nbrs[t * 3 + e]  the triangle across edge e of t, or (0 - 1) at a boundary
#   tstamp[t]        how far triangle t got during the current insertion
#
# Edge e is the edge OPPOSITE vertex e, i.e. the directed segment
# (tris[t*3 + (e+1)%3], tris[t*3 + (e+2)%3]). Every triangle is stored
# counter-clockwise, so for a point strictly inside, all three of those
# directed edges have positive orientation -- which is what makes the walk in
# _col_dl_walk directional and the flood fill in delaunay_2d local.

# --- exact signs of the ghost terms (3.3.5) ---------------------------------
#
# The leading coefficient of a ghost predicate is a linear form in coordinate
# differences with small integer weights (u components 1, 2, -2, or their pairwise
# differences, up to 4 in magnitude), and its tie-breaks are an orientation, a dot
# product or a distance comparison. Through 3.3.4 each was a float expression on
# coordinates translated to p and was trusted whenever it came out nonzero -- but
# the translation rounds, so a site at 1 beside a query at 2^100 lost itself in the
# subtraction and the sign was noise. Each now has a filter and an exact fallback.

# Linear-form filter bound: 8e (e = 2^-53) times |t1| + |t2|. The two subtractions,
# a weight of 3 (the only weight that rounds) and the sum err by at most
# (3e + 4e^2)(|t1| + |t2|), all of it relative: a subtraction, a power-of-two weight
# and a sum are exact whenever their result is subnormal, and 3 * d rounds only to a
# normal result. So no F64_TINY floor is needed. Below |t1| + |t2| = 2^-1022 nothing
# rounds at all, and above it the 5e of slack exceeds the 2^-1075 the bound's own
# product can lose.
var _COL_DL_LIN_ERRB = 0x3CD0_0000_0000_0000;    # 2^-50
# Distance-comparison filter bound: 8e times the four squares, plus F64_TINY -- a
# square, unlike a difference, can round in the subnormal range.
var _COL_DL_SQ_ERRB = 0x3CD0_0000_0000_0000;     # 2^-50

# -1 / 0 / +1 for k1 * (x1 - y1) + k2 * (x2 - y2), k1 and k2 small integers as f64.
fn _col_dl_lin_sign(k1, x1, y1, k2, x2, y2) {
    var t1 = f64_mul(k1, f64_sub(x1, y1));
    var t2 = f64_mul(k2, f64_sub(x2, y2));
    var s = f64_add(t1, t2);
    var errb = f64_mul(_COL_DL_LIN_ERRB, f64_add(f64_abs(t1), f64_abs(t2)));
    if (f64_gt(f64_abs(s), errb) == 1) { return _col_f64_sign(s); }
    return _col_bi_lin(f64_to(k1), x1, y1, f64_to(k2), x2, y2);
}

# -1 / 0 / +1 for (a - p) . (b - p). The orientation bound holds for a sum of two
# products as it does for their difference.
fn _col_dl_dot_sign(px, py, ax, ay, bx, by) {
    var l = f64_mul(f64_sub(ax, px), f64_sub(bx, px));
    var r = f64_mul(f64_sub(ay, py), f64_sub(by, py));
    var s = f64_add(l, r);
    if (_col_o2d_clear(s, l, r) == 1) { return _col_f64_sign(s); }
    return _col_bi_pp(ax, px, bx, px, ay, py, by, py, 1);
}

# -1 / 0 / +1 for |r - a|^2 - |a - p|^2.
fn _col_dl_dist_sign(rx, ry, ax, ay, px, py) {
    var e1x = f64_sub(rx, ax);
    var e1y = f64_sub(ry, ay);
    var e2x = f64_sub(ax, px);
    var e2y = f64_sub(ay, py);
    var q1 = f64_add(f64_mul(e1x, e1x), f64_mul(e1y, e1y));
    var q2 = f64_add(f64_mul(e2x, e2x), f64_mul(e2y, e2y));
    var v = f64_sub(q1, q2);
    var errb = f64_add(f64_mul(_COL_DL_SQ_ERRB, f64_add(q1, q2)), F64_TINY);
    if (f64_gt(f64_abs(v), errb) == 1) { return _col_f64_sign(v); }
    return _col_bi_dist(rx, ry, ax, ay, px, py);
}

# -1 / 0 / +1 for the triangle (p, a, b), where p = (px, py): positive when p, a, b
# turn counter-clockwise, negative when p lies strictly on the right of the
# directed edge a -> b, which is the "step across edge e" test. `nr` is the number
# of real points; an index >= nr is the ghost nr + k.
#
# A ghost contributes M * u_k, so the determinant is linear (or, for two ghosts,
# quadratic) in M and its sign is that of the leading nonzero coefficient. Every
# sign here is exact (3.3.5): two real vertices take the orientation filter and
# `_col_o2d_exact`, a ghost's leading term `_col_dl_lin_sign`, and its tie the
# apex's orientation. Through 3.3.4 the real-by-real return was a float
# determinant on coordinates translated to p, and the one-ghost term was trusted
# whenever it came out nonzero.
fn _col_dl_orient(points, nr, ai, bi, px, py) {
    if (ai >= nr) {
        if (bi >= nr) {
            # Two ghosts: M^2 (u_j x u_k), constant and never zero. The query
            # point does not enter at all.
            return _col_ghost_cross(ai - nr, bi - nr);
        }
        var gj = ai - nr;
        var bpg = vec_get(points, bi);
        var sg = _col_dl_lin_sign(_col_ghost_ux(gj), HVec2_y(bpg), py,
          f64_neg(_col_ghost_uy(gj)), HVec2_x(bpg), px);
        if (sg != 0) { return sg; }
        # p lies exactly on the ghost's ray: the M^0 term decides, which is the
        # orientation of the apex A = points[0] against the same edge.
        var apg = vec_get(points, 0);
        return _col_orient2d_sign(px, py, HVec2_x(apg), HVec2_y(apg), HVec2_x(bpg), HVec2_y(bpg));
    }
    var ap = vec_get(points, ai);
    if (bi >= nr) {
        var gk = bi - nr;
        var sk = _col_dl_lin_sign(_col_ghost_uy(gk), HVec2_x(ap), px,
          f64_neg(_col_ghost_ux(gk)), HVec2_y(ap), py);
        if (sk != 0) { return sk; }
        var apk = vec_get(points, 0);
        return _col_orient2d_sign(px, py, HVec2_x(ap), HVec2_y(ap), HVec2_x(apk), HVec2_y(apk));
    }
    # Two real vertices: `_col_o2d_clear`'s filter written out (this is the walk's
    # inner test, and a 3-argument helper cannot be inlined), translated by p so both
    # products stay on the scale of the edge. det is nonzero once it clears the bound.
    var bp = vec_get(points, bi);
    var ax = HVec2_x(ap);
    var ay = HVec2_y(ap);
    var bx = HVec2_x(bp);
    var by = HVec2_y(bp);
    var l = f64_mul(f64_sub(ax, px), f64_sub(by, py));
    var r = f64_mul(f64_sub(ay, py), f64_sub(bx, px));
    var det = f64_sub(l, r);
    var errb = f64_add(f64_mul(_COL_O2D_ERRBOUND, f64_add(f64_abs(l), f64_abs(r))), F64_TINY);
    if (f64_gt(f64_abs(det), errb) == 1) {
        if (f64_gt(det, 0) == 1) { return 1; }
        return 0 - 1;
    }
    return _col_o2d_exact(px, py, ax, ay, bx, by);
}

# In-circle test for a triangle with ONE ghost, rotated so the ghost is last.
# The M^2 coefficient of the determinant is |u_k|^2 * ((a - p) x (b - p)) and
# |u_k|^2 > 0, so the test degenerates to a half-plane test: the circumcircle
# through a, b and a receding third point tends to the half-plane bounded by
# line(a, b) on the side the third point receded towards.
#
# 2.9.3: WHICH side that is, is `w = sign((b - a) x u_k)` -- the limiting
# winding of the stored triple (a, b, G_k). Through 2.9.2 this function did not
# form w; it read the sign of the M^2 coefficient directly and took the positive
# side on trust, because `delaunay_2d` happens to store every triangle CCW. That
# made the whole entry point CCW-only: "is p inside the circumcircle of these
# three points" is a question about a SET, so an answer that depends on the
# order the vertices arrive in is wrong however the caller happens to store
# them -- the same defect class as the operand-order asymmetry repaired in
# `mpr_intersect` in 2.9.1. `_col_dl_ic_g2` already divided its winding out
# (its `cr`) and `_col_dl_ic_g3` became the constant 1 in 2.9.1, so g1 was the
# last helper reading the convention instead of the geometry.
#
# Cost is one cross product on a path that already does two, and it buys the
# entry point the order-freedom the other two helpers already had. Asserted by
# `_dlg1_run` / `_DLG1_BAD` in tests/modules.tcyr over all six orderings; the
# pre-2.9.3 body scores 846 of 1500 on that grid.
# [measured: tests/modules.tcyr _dlg1_run / _DLG1_BAD, mutant = drop the `* w`]
# See docs/development/issues/archived/2026-08-06-ghost-incircle-g1-g3-assume-ccw.md.
#
# 3.3.5: every sign below is exact. Through 3.3.4 they were float expressions on
# coordinates translated to p, and (b - a) was formed as (b - p) - (a - p), two
# roundings where none is needed.
fn _col_dl_ic_g1(points, ai, bi, k, px, py) {
    var ap = vec_get(points, ai);
    var bp = vec_get(points, bi);
    var ax = HVec2_x(ap);
    var ay = HVec2_y(ap);
    var bx = HVec2_x(bp);
    var by = HVec2_y(bp);
    # (b - a) x u_k = uy * (bx - ax) - ux * (by - ay): p does not enter.
    var w = _col_dl_lin_sign(_col_ghost_uy(k), bx, ax, f64_neg(_col_ghost_ux(k)), by, ay);
    # w == 0 means the edge is PARALLEL to u_k. That is NOT degenerate, and the
    # first draft of this repair got it wrong by assuming it was. G_k is
    # A + M*u_k with A the apex, so an edge parallel to u_k leaves the triangle
    # (a, b, G_k) with area |(b - a) x (A - a)| / 2 -- CONSTANT in M, not
    # vanishing. The third vertex recedes parallel to line(a, b) at a fixed
    # perpendicular offset, and the limiting circle is the half-plane on the
    # side that offset is on: the apex's side. So the winding falls back to
    # sign((b - a) x (A - a)), with A = points[0] -- the same apex convention
    # _col_dl_ic_g2's tie branch uses.
    if (w == 0) {
        var apx = vec_get(points, 0);
        w = _col_orient2d_sign(ax, ay, bx, by, HVec2_x(apx), HVec2_y(apx));
    }
    # Both zero: the edge is parallel to u_k AND the apex is on line(a, b), so
    # all three vertices are collinear for every M and there is no circle at all.
    # 0 is a convention here rather than a derived answer -- an exact oracle has
    # nothing to say about it -- but it is order-free, which is what matters.
    if (w == 0) { return 0; }
    var s = _col_orient2d_sign(px, py, ax, ay, bx, by);
    if (s * w > 0) { return 1; }
    if (s != 0) { return 0; }
    # p lies exactly ON line(a, b), so the answer is "p strictly between a and b"
    # -- a point on the segment is inside the limiting circle, a point on the line
    # outside the segment is not, and p coinciding with a or b gives zero, i.e. a
    # duplicate point, not inside. That is exactly dot(a - p, b - p) < 0.
    #
    # 2.9.1: this WAS the M^1 coefficient of the determinant, evaluated as
    # u_x*(ay*|b|^2 - |a|^2*by) + u_y*(|a|^2*bx - ax*|b|^2). That expression
    # factors as |b|^2*(u x a) - |a|^2*(u x b), and on this branch a and b are
    # already collinear, so with b = lambda*a it collapses to
    # |a|^2 * (u x a) * lambda*(lambda - 1). Two independent failures fall out:
    #   - it VANISHES whenever the edge is parallel to u_k, because (u x a) = 0,
    #     so the branch returned 0 for every such p regardless of position;
    #   - lambda*(lambda - 1) > 0 for lambda > 1 as well as lambda < 0, so even
    #     when it did not vanish it could not separate "between a and b" from
    #     "beyond b on the same ray".
    # Measured against an exact-rational circumcircle oracle: 228 wrong of
    # 463,086 CCW-presented triples -- REACHABLE input, not a latent case. Every
    # one of the 228 answered 0 where the truth is 1, and every one had
    # dot(a - p, b - p) < 0, i.e. the exact case this comment already claimed to
    # return 1 for. Reproducer: k = 0, u_0 = (1, 2), a = (-2, 0), b = (-4, -4),
    # p = (-3, -2) -- p is the midpoint of ab, the old t is exactly 0.
    # [measured: CHANGELOG.md 2.9.1, "228 of 463,086 probes on correctly CCW-stored input"]
    #
    # The betweenness test needs no ghost direction and no magnitudes, so it is
    # both correct and strictly cheaper than what it replaces.
    if (_col_dl_dot_sign(px, py, ax, ay, bx, by) < 0) { return 1; }
    return 0;
}

# In-circle test for a triangle with TWO ghosts, rotated so the real vertex is
# first. The M^3 coefficient is |u|^2 * ((R - p) x (u_j - u_k)): the limiting
# circle is the line through R parallel to the edge at infinity, and the test is
# which side of it p falls on.
#
# "Inside the circumcircle" is a question about a SET of three points, so the
# answer must not depend on the order they arrive in -- but the determinant's
# sign does. cr = sign(u_j x u_k) is the winding of (R, G_j, G_k) in the limit
# (the M^2 term of its orientation dominates), so multiplying the leading
# coefficient's sign by cr exactly ONCE recovers the order-free answer. Each
# branch below must therefore contribute cr exactly once in total:
#
#   M^3 coefficient = |u|^2 * (r x (u_j - u_k))          -- carries NO cr, so
#                                                           the branch supplies it
#   M^2 coefficient = (u_j x u_k) * (|R - A|^2 - |A - p|^2) -- ALREADY carries cr,
#                                                           so the branch must not
#
# Through 2.9.0 the tie branch applied cr a second time. With cr^2 = 1 that is
# the identity when cr = +1 and a sign INVERSION when cr = -1, so the function
# answered correctly on the three cyclic pairs and backwards on the three
# anti-cyclic ones -- latent, because _col_dl_incircle only ever rotates a
# CCW-stored triangle and every rotation is even. See
# docs/development/issues/archived/2026-08-05-two-ghost-tie-branch-sign-rule-inconsistent.md.
#
# NOTE (2.9.3): all three helpers are order-free now, and so is _col_dl_incircle
# as a whole. This note used to say the opposite -- that the one-ghost and
# all-ghost helpers take CCW storage as a precondition -- and it was accurate
# when written: g3 dropped the winding until 2.9.1 (now the constant 1) and g1
# until 2.9.3 (now forms sign((b - a) x u_k), falling back to the apex's side
# when the edge is parallel to u_k). Asserted at all three arities:
# _dlg_perm_bad (two ghosts), _dlg1_run (one), _dlg3_run (all three).
#
# 3.3.5: both signs are exact (`_col_dl_lin_sign`, `_col_dl_dist_sign`); through
# 3.3.4 they were float expressions on coordinates translated to p.
fn _col_dl_ic_g2(points, ri, j, k, px, py) {
    var rp = vec_get(points, ri);
    var dx = f64_sub(_col_ghost_ux(j), _col_ghost_ux(k));
    var dy = f64_sub(_col_ghost_uy(j), _col_ghost_uy(k));
    var cr = _col_ghost_cross(j, k);
    var s = _col_dl_lin_sign(dy, HVec2_x(rp), px, f64_neg(dx), HVec2_y(rp), py);
    if (s != 0) {
        if (s * cr > 0) { return 1; }
        return 0;
    }
    # p lies exactly on that line. Because all three |u_k|^2 are equal, the M^2
    # coefficient collapses to (u_j x u_k) * (|R - A|^2 - |A - p|^2): the ghosts
    # sit on a circle of radius M about the apex A = points[0], so the tie is
    # broken by which of R and p is farther from A. Both distances are on the
    # data scale, so the comparison is well conditioned.
    var apx = vec_get(points, 0);
    var s2 = _col_dl_dist_sign(HVec2_x(rp), HVec2_y(rp), HVec2_x(apx), HVec2_y(apx), px, py);
    # No `* cr` here, unlike the M^3 branch above: (u_j x u_k) is already a
    # factor of this coefficient, so s2 IS sign(M^2 coeff) * cr. Applying cr
    # again would square it away and invert the answer for anti-cyclic pairs.
    #
    # Both coefficients zero needs p on that line AND equidistant from A with R;
    # that is codimension 2, and "not inside" is what the M^1 term gives.
    if (s2 > 0) { return 1; }
    return 0;
}

# In-circle test for the all-ghost triangle -- the initial one, and the only
# one, since every triangle created afterwards carries the inserted point.
#
# THE ANSWER IS THE CONSTANT 1, WHICH IS WHY THIS PREDICATE TAKES NO ARGUMENTS.
# It is not a stub. Two independent derivations, both verified in exact
# rationals against the circumcircle of the three actual points:
#
#   Geometric. All three |u_k|^2 are equal (5), so all three ghosts sit at
#   distance M*sqrt(5) from the apex A -- A IS their circumcenter, and their
#   circumcircle is the circle of radius M*sqrt(5) about A. Every finite p is
#   inside it once M*sqrt(5) > |p - A|, and a ghost predicate is by definition
#   the sign for all sufficiently large M.
#
#   Algebraic. The M^4 coefficient of the determinant is |u|^2 *
#   orient(u_a, u_b, u_c) -- the query point cancels out of the leading term
#   entirely -- while the ghost triangle's own orientation is
#   M^2 * orient(u_a, u_b, u_c). "Inside" is sign(det) == sign(orient), and the
#   SAME factor orient(u) appears in both, so it cancels: the answer is +1 for
#   all six orderings and every finite p. |u|^2 * orient(u) = 60 != 0, so the
#   leading coefficient never vanishes and there is no tie-break branch.
#
# This is precisely the containment property the old super-triangle had to buy
# with a multiplier, and it is now structural rather than tuned.
#
# The equal-norm premise is load-bearing, so do not weaken it by "generalising"
# the ghost directions: for three directions chosen without that constraint the
# answer is NOT constant -- a sweep of random direction triples answers 0 about
# ~28% of the time (the origin then falls outside the circumcircle of the u's).
# That rate is DISTRIBUTION-DEPENDENT and the distribution must be named with it:
# measured 27.6/27.9/28.0% for directions uniform in [-1,1]^2 and 27.1/26.9/27.4%
# in the unit disc, 20,000 triples per seed in exact rationals. An earlier draft
# of this comment said "about 36%" and named no distribution; it did not
# reproduce and had already propagated into three other files before a verifying
# pass re-ran it. The magnitude is what matters here -- roughly a quarter to a
# third, not a rounding error -- and that is what makes the premise load-bearing.
# Equal norms give it, and so independently does positive spanning, since the
# origin is then interior to the triangle of the u's and hence to its
# circumcircle. hisab's u0 = (1,2), u1 = (-2,1), u2 = (1,-2) satisfy both.
# [measured: docs/development/issues/archived/2026-08-06-ghost-incircle-g1-g3-assume-ccw.md, the 28% sweep]
#
# Through 2.9.1 the body returned sign(orient(u_a, u_b, u_c)) > 0 -- it dropped
# the orientation correction and so reported the WINDING of the presented
# triple rather than the in-circle answer. Measured against an exact-rational
# circumcircle oracle: 243 of 243 CW-presented triples wrong, 0 of 243 cyclic.
# The header above it already said "every finite point is inside"; the body had
# always contradicted its own documentation. Latent, because _col_dl_incircle
# stores every triangle CCW and its three rotations are even permutations --
# the same latency class as the 2.9.1 _col_dl_ic_g2 tie branch. Note the
# contrast with that sibling: g2 must DIVIDE OUT the winding with `cr` because
# its leading coefficient does not already carry it, whereas here the winding
# cancels identically and there is nothing left to divide.
# See docs/development/issues/archived/2026-08-06-ghost-incircle-g1-g3-assume-ccw.md.
# [measured: CHANGELOG.md 2.9.1, "243 of 243 CW-presented triples wrong, 0 of 243 cyclic"]
fn _col_dl_ic_g3() {
    return 1;
}

# Ghost-aware in-circle test: 1 when (px, py) is strictly inside the
# circumcircle of triangle (ai, bi, ci), which may carry ghost vertices.
# Rotating a triangle is an even permutation, so the determinant's sign is
# unchanged by it -- each ghost count is rotated into its canonical layout and
# handed to the helper above.
fn _col_dl_incircle(points, nr, ai, bi, ci, px, py) {
    var ga = 0;
    var gb = 0;
    var gc = 0;
    if (ai >= nr) { ga = 1; }
    if (bi >= nr) { gb = 1; }
    if (ci >= nr) { gc = 1; }
    var g = ga + gb + gc;
    if (g == 0) { return _col_in_circumcircle(points, ai, bi, ci, px, py); }
    if (g == 3) { return _col_dl_ic_g3(); }
    if (g == 1) {
        if (gc == 1) { return _col_dl_ic_g1(points, ai, bi, ci - nr, px, py); }
        if (ga == 1) { return _col_dl_ic_g1(points, bi, ci, ai - nr, px, py); }
        return _col_dl_ic_g1(points, ci, ai, bi - nr, px, py);
    }
    if (ga == 0) { return _col_dl_ic_g2(points, ai, bi - nr, ci - nr, px, py); }
    if (gb == 0) { return _col_dl_ic_g2(points, bi, ci - nr, ai - nr, px, py); }
    return _col_dl_ic_g2(points, ci, ai - nr, bi - nr, px, py);
}

# 1 when (px, py) is strictly inside CCW triangle (v0, v1, v2), 0 otherwise
# (including on an edge or a vertex).
# ⚠ 3.3.3 — through 3.3.4 the orientation was a float, and `f64_gt(o, 0) == 0` is TRUE
# for NaN, so a NaN orientation read as "not strictly inside" and delaunay_2d's
# insertion override below did not fire. Two
# inputs have produced one, and the reading means something different for each:
#   * a NaN COORDINATE. Not-inside was the right reading: a point with no position is
#     inside nothing. Flipped to answer 1 for NaN, the override inserted the NaN point,
#     and a square with a NaN interior point came back as 4 triangles, 3 of them using
#     it. delaunay_2d has rejected every non-finite site before any work since 3.3.3,
#     so this input no longer arrives.
#     [measured: scratch harness, not reproducible in-tree, 2026-10-01; cycc 6.6.12]
#   * FINITE sites whose differences or products overflow (Inf - Inf), from a
#     coordinate scale of 2^513 up. The NaN carries no sign, and both readings give a
#     wrong mesh; not-inside is the lesser wrong answer. The square at ±2^520 with an
#     interior site at (2^518, 2^517) is located in triangle (0, 2, 3), which does not
#     contain it -- the walk's own test on the diagonal 0-2 reads the same NaN as "not
#     outside" -- and reaches this test once, with orientations (+Inf, +Inf, NaN), the
#     NaN on that diagonal. Read as not-inside, the site is dropped: the square's 2
#     triangles, [0 1 2, 0 2 3], where the same shape at every scale from 2^-536 to
#     2^512 gives 4. Flipped to inside, the override inserts the site into a triangle
#     that does not contain it: [0 1 2, 2 3 4, 3 0 4, 0 2 4], overlapping, (0, 2, 4)
#     clockwise. That was the scale class, and through 3.3.3 it was not repaired.
#     [measured: scratch instrumented copy of the 3.3.3 tree and a k = -1019..1023 sweep, 2026-10-01; cycc 6.6.12]
#     ⛔ 3.3.4 — delaunay_2d now scales a set outside its band into it (the note above
#     _ColDlBand), so that square comes back as the 4-triangle fan and never gets here
#     with a NaN. A set WIDER than the band is still run unscaled and still can: the same
#     square plus a site at (2^-300, 0) reaches this test exactly as above, and the drop
#     is still the lesser wrong answer there.
#     [measured: tests/abuse.tcyr, group "3.3.3 R4sym: delaunay_2d at an overflowing scale"]
#     ⛔ 3.3.5 — `_col_dl_orient` is an exact -1 / 0 / +1 for any finite sites, so no
#     set reaches this test with a NaN; that wide square now comes back as its Delaunay
#     mesh (pinned in the same group).
fn _col_dl_strict_inside(points, nr, v0, v1, v2, px, py) {
    if (_col_dl_orient(points, nr, v1, v2, px, py) <= 0) { return 0; }
    if (_col_dl_orient(points, nr, v2, v0, px, py) <= 0) { return 0; }
    if (_col_dl_orient(points, nr, v0, v1, px, py) <= 0) { return 0; }
    return 1;
}

# Locate the triangle containing (px, py) by walking the adjacency graph from
# `start`, stepping across whichever edge the point is outside of. Returns the
# triangle index, or (0 - 1) if the walk exceeded `budget` or fell off the
# boundary.
#
# The first edge tried rotates with the step count. A walk that always tries
# edge 0 first can enter a two- or three-triangle cycle when the orientation
# determinant round-trips through zero on near-degenerate geometry; rotating
# the entry point breaks those cycles. `budget` is the backstop for the rest:
# the predicate has been exact since 3.3.5, but the walk's termination is not
# proved here, so the caller still falls back to a linear scan.
fn _col_dl_walk(points, nr, tris, nbrs, start, px, py, budget) {
    var cur = start;
    var steps = 0;
    while (steps < budget) {
        var b = cur * 3;
        # Liveness guard. Every back-pointer into the cavity is rewired when
        # the fan is built, so a tombstone should be unreachable -- but a
        # vertex index of (0 - 1) reaches vec_get, which aborts the process
        # rather than returning an error. Bail to the caller's linear scan
        # instead of trusting the invariant.
        if (vec_get(tris, b) < 0) { return 0 - 1; }
        var nxt = 0 - 1;
        var outside = 0;
        var j = 0;
        while (j < 3) {
            var e = (steps + j) % 3;
            var ea = vec_get(tris, b + (e + 1) % 3);
            var eb = vec_get(tris, b + (e + 2) % 3);
            if (_col_dl_orient(points, nr, ea, eb, px, py) < 0) {
                outside = 1;
                nxt = vec_get(nbrs, b + e);
                j = 3;
            } else {
                j = j + 1;
            }
        }
        if (outside == 0) { return cur; }
        if (nxt < 0) { return 0 - 1; }
        cur = nxt;
        steps = steps + 1;
    }
    return 0 - 1;
}

# Fallback for _col_dl_walk: scan every live slot for one containing the point.
# `mode` 0 tests containment, mode 1 tests the circumcircle (the last resort,
# used only when no triangle claims to contain the point at all).
fn _col_dl_locate_scan(points, nr, tris, n_slots, px, py, mode) {
    for (var t = 0; t < n_slots; t = t + 1) {
        var b = t * 3;
        var v0 = vec_get(tris, b);
        if (v0 >= 0) {
            var v1 = vec_get(tris, b + 1);
            var v2 = vec_get(tris, b + 2);
            if (mode == 0) {
                var ok = 1;
                if (_col_dl_orient(points, nr, v1, v2, px, py) < 0) { ok = 0; }
                if (_col_dl_orient(points, nr, v2, v0, px, py) < 0) { ok = 0; }
                if (_col_dl_orient(points, nr, v0, v1, px, py) < 0) { ok = 0; }
                if (ok == 1) { return t; }
            } else {
                if (_col_dl_incircle(points, nr, v0, v1, v2, px, py) == 1) { return t; }
            }
        }
    }
    return 0 - 1;
}

# --- the scale band ---------------------------------------------------------
#
# Every predicate above is homogeneous in the coordinates -- degree 2 for an
# orientation, 4 for the in-circle determinant, the ghost terms degree 1 or 2 -- and
# compares only against 0 or against a quantity of its own degree. So multiplying
# every site by the same power of two changes no decision, PROVIDED nothing
# overflows and nothing lands below the normal range on the way. The band is where
# that provably holds: every nonzero coordinate of magnitude in [2^-180, 2^251).
#   * Above: differences stay under 2^252, the in-circle's degree-4 terms under 2^1010.
#   * Below: every coordinate, and so every difference the predicates form, is a
#     whole multiple of g = 2^-232 (52 bits under the smallest nonzero coordinate).
#     A nonzero degree-4 term is then at least g^4 * 2^-52 = 2^-980 -- the 2^-52
#     covers the one cancelling subtraction inside each term -- and the raw-coordinate
#     products and error terms of `_col_o2d_exact_raw` at least 2^-464. Nothing
#     reaches the subnormal range, so nothing rounds differently than it would at
#     any other scale in the band.
# These are worst-case bounds, so the band is narrower than where meshes actually
# break: the R4sym square with its interior site (tests/abuse.tcyr) broke only from
# 2^256 up and 2^-270 down, the 20 uniform sites of tests/modules.tcyr from 2^258 and
# 2^-266. MID is the band's centre: a set out of the band whose nonzero magnitudes
# span at most HI - LO = 430 binades is centred there, which puts all of it inside.
# [measured: scratch sweep of every exact 2^e of both fixtures on the 3.3.4 base bundle, 2026-10-03; cycc 6.6.14]
#
# ⛔ 3.3.5 -- every predicate is exact for any finite sites (the filters above, with
# `_col_bi_*` behind them), so no scale changes a decision, and a set returns the same
# triangles at every scale at which it is exactly representable, wide sets included.
# The band stays for speed: inside it the filters decide on the float value except
# near a true tie, and the orientation expansion's window holds, where a set left at
# an extreme scale would send most of its predicates to the integer path.
enum _ColDlBand {
    _COL_DL_EXP_LO = -180;
    _COL_DL_EXP_HI = 250;
    _COL_DL_EXP_MID = 35;
}

# floor(log2 |x|) for a nonzero finite f64, from its sign-cleared bits `m`.
fn _col_dl_ilogb(m) {
    var be = m >> 52;
    if (be > 0) { return be - 1023; }
    # Subnormal: the bits are the significand itself, in units of 2^-1074.
    var e = 0 - 1074;
    while (m > 1) {
        m = m >> 1;
        e = e + 1;
    }
    return e;
}

# The power of two delaunay_2d multiplies every site by, from the smallest nonzero
# and the largest sign-cleared coordinate bits. 0 -- no scaling -- for a set that is
# all zeros, already in the band, or wider than the band. Otherwise the exponent
# that centres the set's [emin, emax] on MID: `+ 4096 ... - 2048` keeps the halving
# a floor for negative sums, so a set and its every power-of-two multiple are moved
# to the same place.
fn _col_dl_band_shift(amin, amax) {
    if (amax == 0) { return 0; }
    var emax = _col_dl_ilogb(amax);
    var emin = _col_dl_ilogb(amin);
    if (emin >= _COL_DL_EXP_LO) {
        if (emax <= _COL_DL_EXP_HI) { return 0; }
    }
    if (emax - emin > _COL_DL_EXP_HI - _COL_DL_EXP_LO) { return 0; }
    return _COL_DL_EXP_MID - ((emax + emin + 4096) / 2 - 2048);
}

# The first n sites times 2^k, as a new vec of new HVec2s; the caller's are not
# touched. k is in [-988, 1109], so it is applied as 2^k1 * 2^k2 with both factors
# normal. Every product is exact: the result lands in the band, and the one
# intermediate lies between the input and the result.
fn _col_dl_scaled(points, n, k) {
    var k1 = k;
    var k2 = 0;
    if (k > 1000) {
        k1 = 1000;
        k2 = k - 1000;
    }
    var s1 = (1023 + k1) << 52;
    var s2 = (1023 + k2) << 52;
    var sp = vec_new();
    for (var i = 0; i < n; i = i + 1) {
        var p = vec_get(points, i);
        vec_push(sp, hvec2_new(f64_mul(f64_mul(HVec2_x(p), s1), s2),
            f64_mul(f64_mul(HVec2_y(p), s1), s2)));
    }
    return sp;
}

public fn delaunay_2d(points, n) {
    var result = vec_new();
    # 3.3.5: the exact paths' scratch buffers belong to this call -- a pointer kept
    # from an earlier call may point into memory a caller's alloc_reset() has handed
    # out again (the note above _COL_O2D_BUF). Each is allocated at most once below.
    _COL_O2D_BUF = 0;
    _COL_BI_BUF = 0;
    _COL_DL_NOMEM = 0;
    # ⛔ `n` RESTATES `vec_len(points)` AND WAS NEVER CHECKED -- the guard 2.12.0
    # gave convex_hull_2d, triangulate_polygon and sequential_impulse, missed here.
    # Three points with n = 4 printed `vec: index out of bounds` and exited 1 (the
    # stdlib's bounds-checked `vec_get` ends the process), and a null `points`
    # with n = 3 exited 139. A library must not end its caller's process.
    # [measured: scratch harness, not reproducible in-tree, 2026-09-30; cycc 6.6.12]
    # Rejection returns the empty `result`, this function's convention for n < 3.
    if (points == 0) { return result; }
    if (n > vec_len(points)) { return result; }
    if (n < 3) { return result; }
    # ⛔ 3.3.3 — NOR WERE THE COORDINATES. A non-finite site came back as a
    # plausible mesh, and which one depended on where it sat. On the square
    # (0,0), (4,0), (4,4), (0,4) plus one site:
    #   * a NaN at index 1-4 was skipped: the square's 2 triangles;
    #   * a NaN at index 0, the apex `_col_dl_orient`'s ghost tie-break reads for
    #     every point, lost the whole square: 0 triangles;
    #   * an infinite site was INSERTED at 13 of its 20 placements (indices 0-3)
    #     — (+Inf, 1) at index 1 gave the triangle (4,0), (+Inf,1), (4,4) — and
    #     6 of those also dropped a finite corner: (1, +Inf) at index 0 gave the
    #     single triangle [0 1 2], with (4,4) and (0,4) in no triangle at all.
    # [measured: W2 probe on the 3.3.2 bundle, 6 site shapes x 5 indices, 2026-10-01; cycc 6.6.12]
    # A Delaunay triangulation of a set holding a point with no position does
    # not exist, so every site in [0, n) must be finite, checked once before any
    # work, with the house test (NaN and ±Inf in one comparison). Rejection is
    # the empty `result`, this function's answer for every input it rejects.
    # ⛔ 3.3.4 — THE SCALE CLASS. Through 3.3.3 a finite set at an extreme scale came
    # back short, overlapping or empty, because its orientation products (degree 2) and
    # in-circle determinants (degree 4) overflowed or flushed to zero. The square at ±2^k
    # with an interior site at (2^(k-2), 2^(k-3)) gave its Delaunay fan only for k from
    # -269 to 255; beyond, the non-Delaunay triangle (0, 2, 3) was kept, a site was lost
    # from k = 513 up and at k = -537 and -538, and every site from k = -539 down -- an
    # empty vec, which read exactly like a rejected input.
    # [measured: scratch instrumented copy of the 3.3.3 tree and a k = -1019..1023 sweep, 2026-10-01; cycc 6.6.12]
    # The scan below also takes the largest and the smallest nonzero magnitude, and a set
    # outside the band (the note above _ColDlBand) whose magnitudes span no more than the
    # band does is triangulated on a copy scaled into it. A power of two changes no
    # decision in the band, so the set returns the same triangles, in the same order, at
    # every scale at which it is exactly representable; a set already in the band is not
    # copied and runs exactly as before.
    # [measured: scratch sweep of every exact 2^e, 25 fixtures and 2,550 random sets, 2026-10-03; cycc 6.6.14]
    # ⚠ That includes scale 1. A set outside the band AT SCALE 1 -- a nonzero magnitude
    # outside [2^-180, 2^251), or an aspect ratio over about 2^180 -- is scaled too, and
    # can return a different list than 3.3.3 did. Mostly that is wrong to right (DBL_MAX
    # and subnormal sets), but a cocircular set's correct mesh can come back reordered:
    # the R4sym square with y times 2^-400, 2^-426 or 2^-427 gives [2 3 4, 1 2 4, 3 0 4,
    # 0 1 4] where 3.3.3 gave [1 2 4, 0 1 4, 2 3 4, 3 0 4].
    # [measured: R4sym square, y scaled, 3.3.4 base vs this tree, 2026-10-03; cycc 6.6.14]
    # ⚠ A set WIDER than the band -- nonzero magnitudes more than 430 binades apart --
    # has no scale that puts it inside, and runs unscaled. Through 3.3.4 it still failed
    # at extreme scales: the square (0,0)..(4,4) plus (DBL_MAX, 1), whose W2 mesh is right
    # at scale 1, came back empty from 2^-540 down, and centring wide sets as well was
    # measured and rejected (thousands that 3.3.3 got right came back wrong).
    # [measured: scratch sweep, 750 random sets spanning 450-1000 binades, both policies, 2026-10-03; cycc 6.6.14]
    # ⛔ 3.3.5 -- the predicates are exact over the whole double range, so a wide set is
    # triangulated exactly, unscaled: that square returns its scale-1 list at every scale
    # from 2^-1074 to 1, and each of 65 wide sets swept over every 2^e returns one list
    # at all its exact scales, where 3.3.4 returned between 2 and 97 different ones.
    # [measured: scratch sweep of every 2^e, exact oracle and port, 2026-10-11; cycc 6.6.14]
    var amax = 0;
    var amin = F64_POS_INF;
    for (var fi = 0; fi < n; fi = fi + 1) {
        var fp = vec_get(points, fi);
        var fx = f64_abs(HVec2_x(fp));
        var fy = f64_abs(HVec2_y(fp));
        if (f64_lt(fx, F64_POS_INF) == 0) { return result; }
        if (f64_lt(fy, F64_POS_INF) == 0) { return result; }
        # Finite and sign-cleared, the bits order as the magnitudes do.
        if (fx > amax) { amax = fx; }
        if (fy > amax) { amax = fy; }
        if (fx != 0) { if (fx < amin) { amin = fx; } }
        if (fy != 0) { if (fy < amin) { amin = fy; } }
    }
    # Outside the band, the build runs on a copy scaled into it. `points` names that
    # copy from here on; the indices returned index the caller's vec all the same.
    var shift = _col_dl_band_shift(amin, amax);
    if (shift != 0) { points = _col_dl_scaled(points, n, shift); }

    # The enclosing triangle is the three SYMBOLIC ghosts n, n+1, n+2 -- see the
    # ghost-vertex note above _col_ghost_ux. There is no bounding box to
    # measure, no multiplier to pick and no extra points vec to build: a ghost
    # has no coordinates, so `points` is used unextended and every predicate
    # branches on the index instead.
    var st_a = n;
    var st_b = n + 1;
    var st_c = n + 2;

    # Triangles + adjacency, both flat. See the representation note above
    # _col_dl_orient. The ghost triangle is CCW because u0, u1, u2 are listed
    # counter-clockwise; every triangle created below inherits CCW winding
    # because a cavity boundary edge is oriented CCW around the cavity.
    var tris = vec_new();
    var nbrs = vec_new();
    var tstamp = vec_new();
    vec_push(tris, st_a);
    vec_push(tris, st_b);
    vec_push(tris, st_c);
    vec_push(nbrs, 0 - 1);
    vec_push(nbrs, 0 - 1);
    vec_push(nbrs, 0 - 1);
    vec_push(tstamp, 0);
    # Slots ever allocated, tombstones included. Slots are never reused, so an
    # adjacency index stays valid for the whole build; the compaction pass at
    # the bottom drops the tombstones once.
    var n_slots = 1;

    # Working buffers, allocated ONCE. alloc() is a bump allocator that never
    # frees, so a vec_new() inside the insertion loop would leak one buffer per
    # point; vec_truncate reuses the same storage instead.
    var bad = vec_new();
    var pending = vec_new();
    var ep_u = vec_new();       # cavity boundary edge, first vertex
    var ep_v = vec_new();       # cavity boundary edge, second vertex
    var ep_nb = vec_new();      # triangle outside that edge, or (0 - 1)
    var ep_ne = vec_new();      # which edge of ep_nb faces back into the cavity

    # vertex -> new triangle maps, used to stitch the fan created around each
    # point in O(boundary) instead of the O(boundary^2) pairwise edge match.
    # Sized over every vertex index, the three ghosts included; reset only
    # at the entries touched, so the per-point cost stays proportional to the
    # cavity boundary.
    var first_of = vec_new();
    var second_of = vec_new();
    for (var i = 0; i < n + 3; i = i + 1) {
        vec_push(first_of, 0 - 1);
        vec_push(second_of, 0 - 1);
    }

    # Incrementally insert each point
    var hint = 0;
    for (var i = 0; i < n; i = i + 1) {
        var p = vec_get(points, i);
        var px = HVec2_x(p);
        var py = HVec2_y(p);
        # Stamp values for this insertion: mark + 1 = "tested, kept",
        # mark + 2 = "tested, bad". Step i uses 2i+1 and 2i+2, so a stamp left
        # by any earlier step is strictly less than mark + 1 and reads as
        # untested -- no per-point clear of an n_slots-sized array.
        var mark = i * 2;

        # 1. LOCATE the containing triangle, walking from the fan created for
        #    the previous point. Consecutive points are usually close, so this
        #    is a few steps; the linear scans are the degenerate-input paths.
        var seed = _col_dl_walk(points, n, tris, nbrs, hint, px, py, n_slots + 16);
        if (seed < 0) { seed = _col_dl_locate_scan(points, n, tris, n_slots, px, py, 0); }
        if (seed < 0) { seed = _col_dl_locate_scan(points, n, tris, n_slots, px, py, 1); }

        # 2. FLOOD-FILL the bad set across shared edges. Only triangles
        #    reachable from the containing one can have the point in their
        #    circumcircle, so this costs O(bad set) rather than O(all
        #    triangles) -- the whole point of carrying adjacency.
        vec_truncate(bad, 0);
        vec_truncate(pending, 0);
        if (seed >= 0) {
            var sb = seed * 3;
            var sv0 = vec_get(tris, sb);
            var sv1 = vec_get(tris, sb + 1);
            var sv2 = vec_get(tris, sb + 2);
            var seed_bad = _col_dl_incircle(points, n, sv0, sv1, sv2, px, py);
            # A point strictly inside a triangle is strictly inside that
            # triangle's circumcircle, so through 3.3.4 a "no" here could only be
            # round-off in the non-adaptive determinant, and believing it would
            # leave the point uninserted and punch a hole in the mesh; strict
            # containment overrides it. Containment is NOT strict when the point
            # coincides with an existing vertex, which is exactly when an empty
            # bad set is the right answer (a duplicate point adds nothing).
            # Since 3.3.5 every predicate is exact and the override cannot fire
            # (0 times on 1,973 sets, against 50 for the 3.3.4 predicates); it
            # stays as the guard against a hole.
            # [measured: scratch port of delaunay_2d (python3 fractions), not reproducible in-tree, 2026-10-11]
            if (seed_bad == 0) {
                if (_col_dl_strict_inside(points, n, sv0, sv1, sv2, px, py) == 1) {
                    seed_bad = 1;
                }
            }
            if (seed_bad == 1) {
                vec_set(tstamp, seed, mark + 2);
                vec_push(bad, seed);
                vec_push(pending, seed);
            } else {
                vec_set(tstamp, seed, mark + 1);
            }
        }
        while (vec_len(pending) > 0) {
            var t = vec_pop(pending);
            var tb = t * 3;
            for (var e = 0; e < 3; e = e + 1) {
                var nb = vec_get(nbrs, tb + e);
                if (nb >= 0) {
                    if (vec_get(tstamp, nb) < mark + 1) {
                        var nbb = nb * 3;
                        var w0 = vec_get(tris, nbb);
                        # Same liveness guard as the walk: a tombstone's
                        # (0 - 1) vertex index would reach vec_get, which
                        # aborts the process. Stamp it kept and move on.
                        var keep_it = mark + 1;
                        if (w0 >= 0) {
                            var w1 = vec_get(tris, nbb + 1);
                            var w2 = vec_get(tris, nbb + 2);
                            if (_col_dl_incircle(points, n, w0, w1, w2, px, py) == 1) {
                                keep_it = mark + 2;
                                vec_push(bad, nb);
                                vec_push(pending, nb);
                            }
                        }
                        vec_set(tstamp, nb, keep_it);
                    }
                }
            }
        }

        # 3. Collect the cavity BOUNDARY: every edge of a bad triangle whose
        #    other side is not bad. Recorded with the outside triangle and the
        #    slot in that triangle pointing back, so the back-pointer can be
        #    rewired in step 5 without re-searching.
        vec_truncate(ep_u, 0);
        vec_truncate(ep_v, 0);
        vec_truncate(ep_nb, 0);
        vec_truncate(ep_ne, 0);
        var n_bad = vec_len(bad);
        for (var bi = 0; bi < n_bad; bi = bi + 1) {
            var t = vec_get(bad, bi);
            var tb = t * 3;
            for (var e = 0; e < 3; e = e + 1) {
                var nb = vec_get(nbrs, tb + e);
                var outer = 1;
                if (nb >= 0) {
                    if (vec_get(tstamp, nb) == mark + 2) { outer = 0; }
                }
                if (outer == 1) {
                    var ne = 0 - 1;
                    if (nb >= 0) {
                        if (vec_get(nbrs, nb * 3) == t) { ne = 0; }
                        if (vec_get(nbrs, nb * 3 + 1) == t) { ne = 1; }
                        if (vec_get(nbrs, nb * 3 + 2) == t) { ne = 2; }
                    }
                    vec_push(ep_u, vec_get(tris, tb + (e + 1) % 3));
                    vec_push(ep_v, vec_get(tris, tb + (e + 2) % 3));
                    vec_push(ep_nb, nb);
                    vec_push(ep_ne, ne);
                }
            }
        }

        # 4. TOMBSTONE the bad triangles. Swap-removing here would renumber a
        #    live triangle and silently invalidate every nbrs entry aimed at
        #    it, so the slot is only marked dead.
        for (var bi = 0; bi < n_bad; bi = bi + 1) {
            vec_set(tris, vec_get(bad, bi) * 3, 0 - 1);
        }

        # 5. Fan one new triangle (u, v, p) per boundary edge. Vertex order
        #    puts the boundary edge opposite p, so edge 2 is the outward one
        #    and edges 0/1 face the two fan siblings.
        var m = vec_len(ep_u);
        var base_new = n_slots;
        for (var j = 0; j < m; j = j + 1) {
            var u = vec_get(ep_u, j);
            var v = vec_get(ep_v, j);
            var nb = vec_get(ep_nb, j);
            var nt = n_slots;
            vec_push(tris, u);
            vec_push(tris, v);
            vec_push(tris, i);
            vec_push(nbrs, 0 - 1);
            vec_push(nbrs, 0 - 1);
            vec_push(nbrs, nb);
            vec_push(tstamp, 0);
            n_slots = n_slots + 1;
            if (nb >= 0) {
                var ne = vec_get(ep_ne, j);
                if (ne >= 0) { vec_set(nbrs, nb * 3 + ne, nt); }
            }
            # Triangle nt owns edge (p, u) and edge (v, p); index it by both
            # endpoints so its two siblings can find it.
            vec_set(first_of, u, nt);
            vec_set(second_of, v, nt);
        }
        for (var j = 0; j < m; j = j + 1) {
            var nt = base_new + j;
            vec_set(nbrs, nt * 3, vec_get(first_of, vec_get(ep_v, j)));
            vec_set(nbrs, nt * 3 + 1, vec_get(second_of, vec_get(ep_u, j)));
        }
        for (var j = 0; j < m; j = j + 1) {
            vec_set(first_of, vec_get(ep_u, j), 0 - 1);
            vec_set(second_of, vec_get(ep_v, j), 0 - 1);
        }
        # Start the next walk inside the fan just built. Only updated when the
        # fan exists, because otherwise nothing was tombstoned and the previous
        # hint is still a live triangle.
        if (m > 0) { hint = base_new; }
    }

    # A predicate that could not get its scratch buffer answered 0 instead of a
    # sign, so the mesh above cannot be trusted: the empty result, as for any input
    # this function cannot triangulate. The compaction's winding test below runs after
    # this check and can fail the same way; a 0 there only skips the swap, which never
    # fires on these counter-clockwise triangles, so the list is unchanged.
    if (_COL_DL_NOMEM != 0) { return result; }

    # Compact: skip tombstones, drop the ghost triangles (every one of which is
    # outside the convex hull, so nothing real is lost), and emit CCW.
    #
    # The CCW normalisation below is part of the published contract and, through
    # 2.8.2, nothing checked it: every delaunay_2d assertion used either
    # |signed area| (the _dl_area2_abs / _dl_tiles_hull coverage harness) or an
    # orientation-free property (empty circumcircle, edge-share count, point
    # usage), all of which a clockwise triangle satisfies just as well. The
    # winding is now asserted directly -- strictly positive signed area on every
    # emitted triangle across all five fixture classes.
    for (var t = 0; t < n_slots; t = t + 1) {
        var tb = t * 3;
        var t0 = vec_get(tris, tb);
        if (t0 >= 0) {
            var t1 = vec_get(tris, tb + 1);
            var t2 = vec_get(tris, tb + 2);
            var keep = 1;
            if (t0 >= n) { keep = 0; }
            if (t1 >= n) { keep = 0; }
            if (t2 >= n) { keep = 0; }
            if (keep == 1) {
                var ap = vec_get(points, t0);
                var bp = vec_get(points, t1);
                var cp = vec_get(points, t2);

                # 3.3.5: the exact winding. 3.3.4's float one misread thin
                # counter-clockwise triangles as clockwise and swapped them
                # (an 18-site set emitted one). Every stored triangle is now
                # counter-clockwise, so the swap no longer fires (0 times on
                # 1,973 sets); it stays as the normalisation the contract names.
                # [measured: scratch port of delaunay_2d (python3 fractions), not reproducible in-tree, 2026-10-11]
                var cross = _col_orient2d_sign(HVec2_x(ap), HVec2_y(ap),
                  HVec2_x(bp), HVec2_y(bp), HVec2_x(cp), HVec2_y(cp));

                if (cross < 0) {
                    # Swap t0 and t1 for CCW
                    vec_push(result, t1);
                    vec_push(result, t0);
                    vec_push(result, t2);
                } else {
                    vec_push(result, t0);
                    vec_push(result, t1);
                    vec_push(result, t2);
                }
            }
        }
    }

    return result;
}

# ================================================================
# 6. Half-Edge Mesh
# ================================================================
# HalfEdge: { vertex, face, next, twin } = 32 bytes
#   offset 0:  vertex (index this half-edge points TO)
#   offset 8:  face   (face index)
#   offset 16: next   (index of next half-edge in face, CCW)
#   offset 24: twin   (index of twin half-edge, or HALFEDGE_NONE)
#
# Mesh handle: { half_edges (vec), vertex_edge (vec), face_edge (vec) } = 24 bytes

#derive(accessors)
public struct HalfEdge { vertex; face; next; twin; }

#derive(accessors)
public struct HalfEdgeMesh { half_edges; vertex_edge; face_edge; }

fn _col_he_new(vertex, face, next, twin) {
    var he = alloc(sizeof(HalfEdge));
    HalfEdge_set_vertex(he, vertex);
    HalfEdge_set_face(he, face);
    HalfEdge_set_next(he, next);
    HalfEdge_set_twin(he, twin);
    return he;
}

# Build half-edge mesh from triangle index triples
# triangles: flat vec of index triples [i0, i1, i2, ...]
# n_tris: number of triangles (vec_len(triangles) / 3)
# n_verts: total number of vertices
# Returns: HalfEdgeMesh pointer, or 0 on error
#
# VALIDATES ITS INPUT INSTEAD OF ABORTING. "0 on error" was the documented
# contract and the only error this function could actually report was n_tris < 1.
# Everything else went straight into vec_get, which is bounds-checked in lib/vec
# and calls _vec_die() -- so a caller that passed n_tris larger than the triples
# it supplied, or a vertex index outside [0, n_verts), did not get 0 back: the
# whole PROCESS exited 1, printing "vec: index out of bounds", with no way to
# catch it. A mesh loader handing this function a malformed index buffer could
# not defend itself. The three checks below cost one O(3 * n_tris) pass over
# data the very next loop reads anyway (halfedge_2k_tris benchmark: no
# measurable change), and turn every one of those aborts into the documented 0.
# [measured: tests/modules_b.tcyr group "halfedge_from_triangles: malformed input returns 0, it does not abort"]
public fn halfedge_from_triangles(triangles, n_tris, n_verts) {
    if (triangles == 0) { return 0; }
    if (n_tris < 1) { return 0; }
    if (n_verts < 1) { return 0; }
    if (vec_len(triangles) < n_tris * 3) { return 0; }
    # ⛔ THE ONE ABORT PATH THE 2.9.x GUARDS ABOVE DID NOT CLOSE. `n_verts` sizes
    # the `vertex_edge` vec directly, one `vec_push` per vertex, and nothing
    # bounded it from ABOVE — the index check below only proves each index is
    # *below* n_verts, never that n_verts itself is buildable. Past the stdlib's
    # own cap the push dies: `vec: capacity overflow`, `_vec_die()`,
    # `syscall(60, 1)`. Reproduced with `n_verts = VEC_CAP_MAX + 1` — exit 1,
    # and it arrives fast because the vec doubles, so it never allocates the
    # 2 GB the count implies.
    # [measured: scratch harness, not reproducible in-tree, 2026-09-09; cycc 6.6.2]
    #
    # ⭐ The bound is `VEC_CAP_MAX` ITSELF, not a number chosen for it: this
    # guards exactly what makes the operation fail and nothing more, and it is
    # read from the dependency rather than transcribed — a constant derived from
    # a dependency is a measurement, and this one moves when the stdlib moves.
    # [measured: scratch harness, not reproducible in-tree, 2026-09-09; cycc 6.6.2]
    if (n_verts > VEC_CAP_MAX) { return 0; }
    for (var ci = 0; ci < n_tris * 3; ci = ci + 1) {
        var cv = vec_get(triangles, ci);
        if (cv < 0 || cv >= n_verts) { return 0; }
    }

    var n_he = n_tris * 3;
    var half_edges = vec_new();
    var vertex_edge = vec_new();
    var face_edge = vec_new();

    # Initialize vertex_edge to sentinel
    for (var vi = 0; vi < n_verts; vi = vi + 1) {
        vec_push(vertex_edge, HALFEDGE_NONE);
    }

    # Create half-edges: for face f, half-edges at indices 3f, 3f+1, 3f+2
    for (var f = 0; f < n_tris; f = f + 1) {
        var base = f * 3;
        vec_push(face_edge, base);

        for (var k = 0; k < 3; k = k + 1) {
            var src_idx = vec_get(triangles, base + k);
            var dst_k = k + 1;
            if (dst_k >= 3) { dst_k = 0; }
            var dst_idx = vec_get(triangles, base + dst_k);

            var next_k = k + 1;
            if (next_k >= 3) { next_k = 0; }
            var next_he = base + next_k;

            var he = _col_he_new(dst_idx, f, next_he, HALFEDGE_NONE);
            vec_push(half_edges, he);

            # Record one outgoing half-edge per vertex
            if (vec_get(vertex_edge, src_idx) == HALFEDGE_NONE) {
                vec_set(vertex_edge, src_idx, base + k);
            }
        }
    }

    # Assign twins: for each half-edge (src->dst), find (dst->src)
    # ---- Twin pairing via an open-addressed hash of directed edges ----
    #
    # This was an O(n_he^2) double loop that scanned every later half-edge and
    # never broke after a match, giving ~2.25*n_tris^2 inner iterations. Measured
    # on a 33x33 grid (2048 triangles): 184 ms. A directed edge (src -> dst) has
    # exactly one possible twin, (dst -> src), so one hash lookup replaces the
    # scan and the pass becomes O(n_he) expected.
    # [measured: bench-history.csv halfedge_2k_tris (its 2.6.15 before-row, and CHANGELOG.md 2.6.15, read 190.1 ms)]
    #
    # The table is open-addressed with linear probing at most half full, sized to a
    # power of two so the mask is a single AND. Slots hold (src, dst, index) and
    # an empty slot is marked by src == HALFEDGE_NONE. Keys are compared exactly,
    # so a hash collision costs a probe, never a wrong pairing.
    var _he_cap = 1;
    while (_he_cap < n_he * 2) { _he_cap = _he_cap * 2; }
    var _he_mask = _he_cap - 1;
    var _he_src = alloc(_he_cap * 8);
    var _he_dst = alloc(_he_cap * 8);
    var _he_idx = alloc(_he_cap * 8);
    for (var s = 0; s < _he_cap; s = s + 1) {
        store64(_he_src + s * 8, HALFEDGE_NONE);
    }

    # Pass 1: index every half-edge by its (src, dst) pair.
    for (var i = 0; i < n_he; i = i + 1) {
        var he_i = vec_get(half_edges, i);
        var dst_i = HalfEdge_vertex(he_i);
        var face_i = HalfEdge_face(he_i);
        var src_i = vec_get(triangles, face_i * 3 + (i - face_i * 3));
        # Multiplicative mix of the two endpoints. Masking with a power-of-two
        # mask keeps the slot in range regardless of multiplication overflow.
        var h = (src_i * 73856093) ^ (dst_i * 19349663);
        var slot = h & _he_mask;
        while (load64(_he_src + slot * 8) != HALFEDGE_NONE) {
            slot = (slot + 1) & _he_mask;
        }
        store64(_he_src + slot * 8, src_i);
        store64(_he_dst + slot * 8, dst_i);
        store64(_he_idx + slot * 8, i);
    }

    # Pass 2: for each unpaired half-edge, look up the reverse edge directly.
    for (var i2 = 0; i2 < n_he; i2 = i2 + 1) {
        var he_a = vec_get(half_edges, i2);
        if (HalfEdge_twin(he_a) == HALFEDGE_NONE) {
            var dst_a = HalfEdge_vertex(he_a);
            var face_a = HalfEdge_face(he_a);
            var src_a = vec_get(triangles, face_a * 3 + (i2 - face_a * 3));

            # The twin of (src_a -> dst_a) is (dst_a -> src_a).
            var h2 = (dst_a * 73856093) ^ (src_a * 19349663);
            var slot2 = h2 & _he_mask;
            var probing = 1;
            while (probing == 1) {
                var cur = load64(_he_src + slot2 * 8);
                if (cur == HALFEDGE_NONE) {
                    probing = 0;               # boundary edge, no twin
                } else {
                    if (cur == dst_a && load64(_he_dst + slot2 * 8) == src_a) {
                        var j = load64(_he_idx + slot2 * 8);
                        if (j != i2) {
                            var he_b = vec_get(half_edges, j);
                            if (HalfEdge_twin(he_b) == HALFEDGE_NONE) {
                                store64(he_a + 24, j);
                                store64(he_b + 24, i2);
                            }
                        }
                        probing = 0;
                    } else {
                        slot2 = (slot2 + 1) & _he_mask;
                    }
                }
            }
        }
    }

    # Build mesh handle
    var mesh = alloc(sizeof(HalfEdgeMesh));
    HalfEdgeMesh_set_half_edges(mesh, half_edges);
    HalfEdgeMesh_set_vertex_edge(mesh, vertex_edge);
    HalfEdgeMesh_set_face_edge(mesh, face_edge);
    return mesh;
}

# Get faces adjacent to a given face (sharing an edge)
# Returns: vec of face indices, or 0 if mesh is null / face is out of range
#
# BOUNDS ITS INDEX INSTEAD OF ABORTING. halfedge_from_triangles above validates
# n_tris, n_verts and every vertex id, but this accessor -- reached with the very
# face indices that function's own output hands back -- fed `face` straight into
# vec_get. Measured before this guard on a 2-triangle mesh:
#   halfedge_adjacent_faces(mesh, -1)  "vec: index < 0",           exit 1
#   halfedge_adjacent_faces(mesh, 99)  "vec: index out of bounds", exit 1
#   halfedge_adjacent_faces(0, 0)                                  exit 139
# so a caller iterating a face list it got from somewhere else could not defend
# itself.
# [measured: CHANGELOG.md 2.9.0 "Six measured signals"; pinned in tests/abuse.tcyr, each assertion naming its "was"]
#
# 0, NOT AN EMPTY VEC. The success value is a vec HANDLE, so 0 is the error value
# -- and it is the only rejection that stays honest: a face with no neighbours
# (an isolated triangle, asserted in modules.tcyr) legitimately returns a
# non-null EMPTY vec, so answering an out-of-range face with vec_new() would be
# indistinguishable from that real answer. Same contract as
# halfedge_from_triangles, which already documents 0 on error.
public fn halfedge_adjacent_faces(mesh, face) {
    if (mesh == 0) { return 0; }
    if (face < 0) { return 0; }
    var result = vec_new();
    var half_edges = HalfEdgeMesh_half_edges(mesh);
    var face_edge_vec = HalfEdgeMesh_face_edge(mesh);
    if (face >= vec_len(face_edge_vec)) { return 0; }
    var base = vec_get(face_edge_vec, face);

    for (var k = 0; k < 3; k = k + 1) {
        var he = vec_get(half_edges, base + k);
        var twin = HalfEdge_twin(he);
        if (twin != HALFEDGE_NONE) {
            var twin_he = vec_get(half_edges, twin);
            vec_push(result, HalfEdge_face(twin_he));
        }
    }
    return result;
}

# Check if a vertex is on the mesh boundary
# Returns: 1 if boundary, 0 if interior,
#          HSB_ERR_INVALID_INPUT if mesh is null,
#          HSB_ERR_OUT_OF_RANGE if vertex is outside [0, n_verts)
#
# Same unbounded index as halfedge_adjacent_faces above. Measured before this
# guard on a 2-triangle / 4-vertex mesh:
#   halfedge_is_boundary(mesh, -1)  "vec: index < 0",           exit 1
#   halfedge_is_boundary(mesh, 99)  "vec: index out of bounds", exit 1
#   halfedge_is_boundary(0, 0)                                  exit 139
# [measured: CHANGELOG.md 2.9.0 "Six measured signals"; pinned in tests/abuse.tcyr, each assertion naming its "was"]
#
# A NEGATIVE CODE, NOT 0. This one is a PREDICATE, so unlike its sibling it has
# no free handle value to reject with: returning 0 for a vertex that does not
# exist would assert "interior", which is a wrong answer, and returning 1 would
# assert "boundary". The two documented HSB_ERR_* codes are outside {0, 1}, so
# `== 1` and `== 0` callers both keep their meaning and a caller that wants to
# tell "not a boundary" from "not a vertex" can.
#must_use
# ⛔ 3.0.0 — THIS ONE IS NOT MECHANICAL, AND THE BLANKET RULE WAS WRONG FOR IT.
# The other migrated functions deliver their result through an out-pointer and
# return only a status, so `Ok(0)` is right for them. `halfedge_is_boundary`
# returns its ANSWER — the boolean — directly, so its success returns must be
# `Ok(1)` / `Ok(0)`, not `Ok(0)` uniformly.
# ⚠ Caught by the SUITE, not by the compiler: wrapping only the error paths left
# a function returning a `: stack` pair on some paths and a bare int on others,
# and the bare-int paths then read as a TAG — `got 6388772, expected 1`. The
# compiler warns about this shape at the return site, but the warning is not an
# error, so the tests are what stopped it. **A mechanical migration needs a
# per-function check of what success actually carries.**
public fn halfedge_is_boundary(mesh, vertex) {
    if (mesh == 0) { return Err(HSB_ERR_INVALID_INPUT); }
    if (vertex < 0) { return Err(HSB_ERR_OUT_OF_RANGE); }
    var half_edges = HalfEdgeMesh_half_edges(mesh);
    var vertex_edge_vec = HalfEdgeMesh_vertex_edge(mesh);
    var face_edge_vec = HalfEdgeMesh_face_edge(mesh);
    if (vertex >= vec_len(vertex_edge_vec)) { return Err(HSB_ERR_OUT_OF_RANGE); }
    var start = vec_get(vertex_edge_vec, vertex);

    if (start == HALFEDGE_NONE) { return Ok(0); }

    var he_idx = start;
    var first = 1;
    for (var guard = 0; guard < 1000; guard = guard + 1) {
        var he = vec_get(half_edges, he_idx);
        if (HalfEdge_twin(he) == HALFEDGE_NONE) { return Ok(1); }

        # Walk: next -> next -> twin to get next outgoing half-edge
        var n1 = HalfEdge_next(he);
        var he_n1 = vec_get(half_edges, n1);
        var n2 = HalfEdge_next(he_n1);
        var he_n2 = vec_get(half_edges, n2);
        var incoming_twin = HalfEdge_twin(he_n2);

        if (incoming_twin == HALFEDGE_NONE) { return Ok(1); }

        he_idx = incoming_twin;
        if (he_idx == start) { return Ok(0); }  # Full loop -- interior
    }
    return Ok(0);
}

# ================================================================
# 7. Island Detection -- Union-Find
# ================================================================
# Detects connected components in a contact graph using union-find
# with path compression and union-by-rank.
#
# contacts: vec of ColContact pointers (uses body_a, body_b fields)
# n_contacts: number of contacts
# n_bodies: total number of bodies
# Returns: vec of vecs, each sub-vec is a list of body indices in one island

# Union-find structure: two flat arrays (parent, rank) of size n_bodies
# parent: alloc(n_bodies * 8), rank: alloc(n_bodies * 8)

fn _col_uf_new(n) {
    var uf = alloc(16);
    var parent = alloc(n * 8);
    var rank = alloc(n * 8);
    for (var i = 0; i < n; i = i + 1) {
        store64(parent + i * 8, i);
        store64(rank + i * 8, 0);
    }
    store64(uf, parent);
    store64(uf + 8, rank);
    return uf;
}

fn _col_uf_find(uf, x) {
    var parent = load64(uf);
    var px = load64(parent + x * 8);
    while (px != x) {
        # Path halving
        var ppx = load64(parent + px * 8);
        store64(parent + x * 8, ppx);
        x = ppx;
        px = load64(parent + x * 8);
    }
    return x;
}

fn _col_uf_union(uf, a, b) {
    var ra = _col_uf_find(uf, a);
    var rb = _col_uf_find(uf, b);
    if (ra == rb) { return 0; }

    var rank_arr = load64(uf + 8);
    var rank_a = load64(rank_arr + ra * 8);
    var rank_b = load64(rank_arr + rb * 8);

    var parent = load64(uf);
    if (rank_a < rank_b) {
        store64(parent + ra * 8, rb);
    } else {
        if (rank_a > rank_b) {
            store64(parent + rb * 8, ra);
        } else {
            store64(parent + rb * 8, ra);
            store64(rank_arr + ra * 8, rank_a + 1);
        }
    }
    return 1;
}

public fn detect_islands(contacts, n_contacts, n_bodies) {
    var result = vec_new();  # vec of vecs
    if (n_bodies == 0) { return result; }
    # ⛔ CALLER-SIZED ALLOCATION STORED THROUGH UNCHECKED — reproduced as SIGSEGV.
    # `n_bodies` sizes three allocations that nothing bounded: `_col_uf_new`'s
    # `parent` and `rank` (`alloc(n * 8)` each) and `comp_index` below. Above
    # `ALLOC_MAX` the stdlib's `alloc` returns its designed **0**, and the very
    # next `store64(parent + i * 8, i)` writes to address 0. Measured: n_bodies =
    # 268,435,457 exits **139**, and so does 1,152,921,504,606,846,976 — that
    # second one via a different door, because `n_bodies * 8` OVERFLOWS to a
    # negative and `alloc` rejects `size <= 0` with the same designed 0.
    # Control: n_bodies = 4 exits 0 and returns 4 islands.
    # [measured: scratch harness, not reproducible in-tree, 2026-09-09; cycc 6.6.2]
    #
    # ⭐ The bound is derived, not chosen: `ALLOC_MAX / 8` is exactly the largest
    # `n_bodies` whose `n * 8` request `alloc` will honour. Dividing rather than
    # multiplying is what makes it also catch the overflow case — there is no
    # `n_bodies` that passes this and then wraps.
    #
    # ⚠ API NOTE: this function returns a **vec of vecs**, so it has no rc to
    # report through. Rejection returns the same empty `result` as `n_bodies == 0`
    # — the convention every `detect_islands` assertion in `tests/abuse.tcyr`
    # already reads via `vec_len`. A designed 0 here would null-deref that idiom.
    if (n_bodies > ALLOC_MAX / 8) { return result; }
    # ⛔ `n_contacts` RESTATES `vec_len(contacts)` AND WAS NEVER CHECKED. One
    # contact with n_contacts = 2 printed `vec: index out of bounds` and exited 1;
    # a null `contacts` with n_contacts = 1 exited 139. Checked only when the loop
    # below will index it, so `detect_islands(0, 0, n)` still returns n singleton
    # islands, as it always has.
    # [measured: scratch harness, not reproducible in-tree, 2026-09-30; cycc 6.6.12]
    if (n_contacts > 0) {
        if (contacts == 0) { return result; }
        if (n_contacts > vec_len(contacts)) { return result; }
    }

    var uf = _col_uf_new(n_bodies);

    # Build forest from contact edges
    for (var ci = 0; ci < n_contacts; ci = ci + 1) {
        var c = vec_get(contacts, ci);
        var ba = ColContact_body_a(c);
        var bb = ColContact_body_b(c);
        # BOTH bounds, not just the upper one. Through 2.6.15 only `< n_bodies`
        # was checked, so a NEGATIVE body index passed the guard and _col_uf_find
        # subscripted parent[ba] BEFORE the array. parent[-1] aliases the uf
        # header's rank POINTER, making `parent + rank_ptr * 8` a wild address --
        # observed SIGSEGV, exit 139. Small negatives land inside the heap
        # instead and corrupt silently: with n_bodies = 4 and body_a = -3 the
        # out-of-bounds read returned root 0, fusing unrelated bodies 0 and 1, so
        # detect_islands answered 3 islands where the correct answer is 4.
        # Skipping an out-of-range endpoint is the decision this line already
        # made for out-of-range-HIGH indices; it now covers both directions.
        # [measured: CHANGELOG.md 2.7.0, "SIGSEGV, exit 139" and "3 islands where the correct answer is 4"]
        if (ba >= 0 && ba < n_bodies && bb >= 0 && bb < n_bodies) {
            _col_uf_union(uf, ba, bb);
        }
    }

    # Collect components: map root -> component index
    # Use a flat array of size n_bodies for the mapping
    var comp_index = alloc(n_bodies * 8);
    for (var i = 0; i < n_bodies; i = i + 1) {
        store64(comp_index + i * 8, HALFEDGE_NONE);
    }
    var n_comp = 0;

    for (var body = 0; body < n_bodies; body = body + 1) {
        var root = _col_uf_find(uf, body);
        var idx = load64(comp_index + root * 8);
        if (idx == HALFEDGE_NONE) {
            idx = n_comp;
            store64(comp_index + root * 8, idx);
            vec_push(result, vec_new());
            n_comp = n_comp + 1;
        }
        var island = vec_get(result, idx);
        vec_push(island, body);
    }

    return result;
}
