# complex.cyr -- complex numbers and complex matrices
# Usage: shipped inside dist/hisab.cyr; in-tree, include "src/complex.cyr" after what it requires
# Requires: src/error.cyr, src/f64_util.cyr (stdlib resolves via cyrius.cyml [deps]; f64_copysign)
#
# Complex: { re: f64, im: f64 } = 16 bytes
# ComplexMatrix: row-major { rows, cols, data_ptr } = 24 bytes
#   data is rows*cols*16 bytes (each element is re,im pair)

#derive(accessors)
public struct HComplex { re; im; }

# A complex number re + i im, an HComplex holding the two f64 as given, or 0 when its 16
# bytes cannot be allocated (3.4.0). Every cx_* below returns what cx_new returns, so each
# reports its own refused allocation the same way; an operand of 0 (a refusal the caller
# did not check) is not tested for, and is read through.
#must_use
public fn cx_new(re, im) {
    var c = alloc(sizeof(HComplex));
    if (c == 0) { return 0; }
    HComplex_set_re(c, re);
    HComplex_set_im(c, im);
    return c;
}

# 0 + 0i (cx_new: 0 when it cannot be allocated).
#must_use
public fn cx_zero() { return cx_new(0, 0); }
# 1 + 0i (cx_new: 0 when it cannot be allocated).
#must_use
public fn cx_one() { return cx_new(F64_ONE, 0); }
# 0 + 1i, the imaginary unit (cx_new: 0 when it cannot be allocated).
#must_use
public fn cx_i() { return cx_new(0, F64_ONE); }
# r + 0i (cx_new: 0 when it cannot be allocated).
#must_use
public fn cx_real(r) { return cx_new(r, 0); }

# The sign bit (3.4.1 SYM2): every negation that can meet a zero flips it with an XOR, which
# is IEEE 754's negate on every pin (a few left here negate the constant 1). f64_neg(+-0)
# returned +0 below cyrius 6.6.8 (six direct consumers pin 6.6.3), so there cx_conj(1 + 0i)
# was 1 + 0i and cx_inv(Inf + 1i) lost Smith's -0.
enum _CxBits {
    _CX_SIGN = 0x8000_0000_0000_0000;   # the sign-bit mask
}

# _cx_div_wide's scaling (3.4.1): from 2^1021 a divisor part takes the quarter scale.
# _CX_DIV_SAFE is cx_div's fast-path bound (3.4.1 SYM2): below it no Smith sum overflows.
enum _CxDivWide {
    _CX_DIV_WIDE = 0x7FC0_0000_0000_0000;      # 2^1021
    _CX_DIV_QUARTER = 0x3FD0_0000_0000_0000;   # 0.25
    _CX_DIV_FOUR = 0x4010_0000_0000_0000;      # 4
    _CX_DIV_SAFE = 0x7FD0_0000_0000_0000;      # 2^1022
}

# The extended-exponent quotient's bits (3.4.1 SYM3): _CX_EXP picks the exponent field, zero
# exactly for a subnormal or zero; _CX_TWO64 lifts a subnormal to read its exponent, and
# _CX_TWOM1000 is where _cx_xd puts a numerator to divide straight into the subnormals.
enum _CxExt {
    _CX_EXP = 0x7FF0_0000_0000_0000;       # the exponent-field mask: bits, not a value
    _CX_TWO64 = 0x43F0_0000_0000_0000;     # 2^64
    _CX_TWOM1000 = 0x0170_0000_0000_0000;  # 2^-1000
}

# ================================================================
# Arithmetic
# ================================================================

# a + b, each part one IEEE addition (correctly rounded). 0 when not allocated.
#must_use
public fn cx_add(a, b) {
    return cx_new(f64_add(HComplex_re(a), HComplex_re(b)),
      f64_add(HComplex_im(a), HComplex_im(b)));
}

# a - b, each part one IEEE subtraction (correctly rounded). 0 when not allocated.
#must_use
public fn cx_sub(a, b) {
    return cx_new(f64_sub(HComplex_re(a), HComplex_re(b)),
      f64_sub(HComplex_im(a), HComplex_im(b)));
}

# a * b = (ar br - ai bi) + i (ar bi + ai br), the textbook form with no compensated or
# fused products: each part is within a few ulp of |a| |b| (normwise), but a part whose two
# products cancel can lose its relative accuracy, and a product that passes DBL_MAX makes
# its part +-Inf or NaN (Inf - Inf) even where the exact part fits: (1e300 + 1e300 i) *
# (1e10 - 1e10 i) is (+Inf, NaN) for (2e310, 0). 0 when not allocated.
#must_use
public fn cx_mul(a, b) {
    var ar = HComplex_re(a); var ai = HComplex_im(a);
    var br = HComplex_re(b); var bi = HComplex_im(b);
    return cx_new(f64_sub(f64_mul(ar, br), f64_mul(ai, bi)),
      f64_add(f64_mul(ar, bi), f64_mul(ai, br)));
}

# a / b. Smith's algorithm (below), so the quotient is scale-covariant over the whole
# range: no |b|^2 is formed. Accuracy: a few ulp normwise; a component of the quotient
# that cancels (|re| or |im| << |a / b|) carries the rounding of the larger one. The
# pole b = 0 + 0i exactly (either zero's sign) answers cx_zero(), 0 + 0i, the sentinel
# 2.6.14 documented (a [3.5.0] row); a NaN part anywhere gives NaN parts; a finite a
# over a b with an infinite part is 0 (C99 G.5.1, its signs from the reference
# _Cdivd). Returns 0 when the result cannot be allocated; an operand of 0 (a refused
# cx_*) is the caller's unchecked failure and is not tested.
#must_use
public fn cx_div(a, b) {
    # ⛔ THIS IS THE DEFECT `complex.cyr` HAS NAMED IN ITS OWN COMMENT SINCE 2.6.14
    # AND KEPT DOING. 2.6.14 fixed the EXPONENT — squared modulus against a squared
    # tolerance — and left the SCALE, so `cx_div` still flushed legitimate small
    # divisors to exactly 0+0i, a value bit-identical to a real zero quotient with
    # no error channel to distinguish them.
    #
    # ⭐ AND NO THRESHOLD FIXES IT. Measured over a 401-decade covariance sweep of
    # `cx_div(k*a, k*b)`, which is degree 0 in k and must not move: 1e-12 fails 241
    # decades, the shipped 1e-24 fails 235, sqrt(DBL_MIN) fails 170, DBL_MIN fails
    # 93, and *removing the guard entirely* still fails 89 — because `br² + bi²`
    # OVERFLOWS to +Inf above k = 1e154 and UNDERFLOWS to 0 below 1e-154, and no
    # comparison against a number can repair a quantity that was destroyed before
    # the comparison ran. **Judging a repair against 89 rather than 0 would have
    # licensed leaving 89 decades broken.**
    # [measured: docs/audit/2026-09-09-epsilon-open.json]
    #
    # ⭐ SMITH'S ALGORITHM IS 0/401. Divide through by the LARGER component first,
    # so the intermediate is |smaller/larger| <= 1 and the squaring never happens:
    # the whole dynamic range stays representable and the result is scale-covariant
    # everywhere. Threshold candidates fail 241/235/170/93/89 decades; Smith's fails
    # none. (Through 3.3.1 a NaN real part with a zero imaginary part reached the pole
    # sentinel too; see the guard below.)
    # [measured: docs/audit/2026-09-09-epsilon-open.json]
    # ⛔ 3.4.1 — "THE ONLY INPUT THAT STILL FAILS IS b = 0 EXACTLY" WAS FALSE AT THE TOP
    # OF THE RANGE. Smith's denominator br + bi*rb is up to twice max|b|, and its
    # numerators up to twice max|a|, so either one overflowed from about DBL_MAX / 2 and
    # the quotient came back 0 (x / Inf) or +-Inf or NaN (Inf / Inf) where it is an
    # ordinary number: cx_div(2^1023 + 0i, 7FE8F0A3D70A3D71 + 7FE724C3FA1D5B7A i) was
    # (0, -0) for 0.3447 - 0.3199i, cx_div(DBL_MAX(1 + i), 2 + 1.9i) had the real part
    # +Inf for 7FE06643F3E3BE10. When the sum or a numerator is not finite and every part
    # of b is, the quotient is taken again on operands scaled by 1/4 (_cx_div_wide); the
    # fast path is the 3.4.0 arithmetic, bit for bit. And a finite a over an infinite b, NaN
    # through 3.4.0 when both of b's parts were infinite, is 0 (C99 G.5.1).
    # [measured: tests/hisab.tcyr, group "3.4.1: cx_div / cx_inv near DBL_MAX and over an infinite divisor"]
    # The rescue also runs for an INFINITE dividend over a finite b (3.4.1 SYM2, RV-SYM N3):
    # an infinite part of a passes the 1/4 scaling unchanged, so where Smith's unscaled sum
    # made Inf / Inf = NaN, the scaled one is Inf / (a finite denominator): (Inf + 0i) /
    # (2^1023 (1 + i)) is Inf - Inf i (3.4.0: NaN + NaN i). Each part is what Smith's formula
    # gives on the scaled operands -- a signed infinity, or a NaN where the formula itself
    # forms Inf - Inf or Inf * 0, as 3.4.0's did away from DBL_MAX: (Inf + 0i) / (2 + 0i) is
    # Inf + NaN i in both. It is not C99's recovery for an infinite dividend.
    # ⭐ 3.4.1 SYM2 — ONE TEST ON THE INPUTS INSTEAD OF THREE ON THE SUMS (RV-SYM S4). When
    # |ar| + |ai| + |b's larger part| < 2^1022 no sum can overflow -- |db| <= 2 max|b| <
    # 2^1023 and |nr|, |ni| <= |ar| + |ai| < 2^1022, each within a few roundings of those
    # bounds -- and a NaN or infinite part fails the test, so the three finiteness tests run
    # only where it fails: the same quotient bit for bit, on one test in the common case.
    # [measured: scratch bit-identity probe, 3.4.1 SYM2 tree, 400,000 inputs, 2026-10-31; cycc 6.7.18]
    # ⛔ 3.4.1 SYM3 — AND AT THE BOTTOM OF THE RANGE SMITH'S INTERMEDIATES UNDERFLOWED. Its
    # ratio rb = bi / br is subnormal or 0 when |bi| < 2^-1022 |br|, and the ai * rb term went
    # with it: cx_div(0 + 2^1000 i, 2^100 + 2^-1000 i) had the real part 0 for 2^-200. A
    # subnormal denominator (b itself subnormal) and a subnormal numerator over a |b| below 1
    # (which the division then scales up) lost bits the same way: of 200,000 quotients with
    # every part on every binade, 3,656 had a part off by more than 4 ulp times its
    # cancellation, up to 9.1e15 ulp. When the ratio or the denominator is subnormal or zero,
    # or a numerator is subnormal, or zero where its plain term is too (one integer test on
    # their exponent fields, then _cx_lost), and b's smaller part is not 0, the same Smith's
    # formula is evaluated again on numbers that keep their exponent apart (_cx_div_x), every
    # operation rounded to 53 bits as here and none underflowing, and each part rounded once
    # into place: Smith's quotient as if the exponent range had no floor. Of the 200,000
    # quotients none is now outside the bound, and the worst part that does not cancel in that
    # sample is 2.6 ulp off, as on ordinary inputs (2.8; a sample's worst, not a bound: 2.9 at
    # cancellation 1.71 over subnormal divisors). Every quotient whose Smith
    # intermediates are all normal is the arithmetic below, bit for bit (0 of 341,795 such
    # among 400,000 inputs changed), and the new path gives those same bits wherever its own
    # intermediates are normal: of the 6,929 parts that changed, 3,778 were outside the bound,
    # 3,135 moved closer or kept their error (most a zero that now has the sign of the value
    # it rounds), and 16 moved away by at most 1 ulp, inside it. Cost: the fast path's one
    # extra integer test; a quotient that takes the new path costs about 250 ns, and on most
    # of them it returns Smith's own bits (a subnormal may have lost nothing): 88% of those in
    # a full-range sample, 82% where the ratio is subnormal.
    # ⛔ 3.4.1 SYM4 — AND THAT TEST FIRED ON EXACT ZEROS. A zero's exponent field is 0 as a
    # subnormal's is, and nr or ni is exactly 0 on ordinary inputs: 0 / b, z / z, a real or an
    # imaginary quotient took the path and got Smith's bits back, at ×6.7 to ×9.5 of 3.4.0. A
    # zero numerator can have lost bits only where its plain term is itself zero or subnormal
    # while the other part is not (_cx_lost); those are all the path takes now, and the second
    # test sits inside the rare branch, so the fast path pays nothing: bit-identical on 360,000
    # rows, and an exact zero costs ×1.6 to ×1.8 of 3.4.0 (45 to 50 ns), the price of that test.
    # [measured: scratch exact-rational sweeps cxora.py / cxbit.py / cxchg.py, 3.4.0, s11 and the SYM3 tree, 2026-11-01]
    # [measured: scratch exact-rational sweep (cxora.py), 3.4.0 / s11 / SYM3 trees, 2026-10-31; cycc 6.7.18]
    # [measured: scratch probes r2cnt2.cyr and r2b.cyr, 3.4.0, s23 and the SYM4 tree, 2026-11-01]
    var br = HComplex_re(b); var bi = HComplex_im(b);
    var ar = HComplex_re(a); var ai = HComplex_im(a);
    if (f64_lt(f64_abs(bi), f64_abs(br)) == 1) {
        var rb = f64_div(bi, br);
        var db = f64_add(br, f64_mul(bi, rb));
        if (f64_eq(db, 0) == 1) { return cx_zero(); }
        var nr = f64_add(ar, f64_mul(ai, rb));
        var ni = f64_sub(ai, f64_mul(ar, rb));
        if (f64_lt(f64_add(f64_add(f64_abs(ar), f64_abs(ai)), f64_abs(br)), _CX_DIV_SAFE) == 0) {
            if (f64_lt(f64_abs(db), F64_POS_INF) == 0 || f64_lt(f64_abs(nr), F64_POS_INF) == 0
              || f64_lt(f64_abs(ni), F64_POS_INF) == 0) {
                return _cx_div_wide(ar, ai, br, bi, f64_div(nr, db), f64_div(ni, db));
            }
        }
        var lb = ((rb & _CX_EXP) - 1) | ((db & _CX_EXP) - 1);
        if ((lb | ((nr & _CX_EXP) - 1) | ((ni & _CX_EXP) - 1)) < 0 && (bi << 1) != 0) {
            if (lb < 0 || _cx_lost(nr, ar, ai) == 1 || _cx_lost(ni, ai, ar) == 1) {
                return _cx_div_x(ar, ai, br, bi);
            }
        }
        return cx_new(f64_div(nr, db), f64_div(ni, db));
    }
    # Reached when |bi| >= |br| OR when the comparison is unordered (a NaN). So
    # bi == 0 implies br == 0 only for a non-NaN br, and the pole test reads both.
    # ⛔ Through 3.3.1 it read bi alone: b = NaN+0i (or NaN-0i, any NaN payload) got
    # the pole sentinel, a fabricated 0+0i, where NaN must propagate. Testing both
    # parts changes nothing else: for a non-NaN b, br == 0 already holds here.
    # [measured: scratch harness, not reproducible in-tree, 2026-10-01; cycc 6.6.12]
    if (f64_eq(bi, 0) == 1 && f64_eq(br, 0) == 1) { return cx_zero(); }
    var ri = f64_div(br, bi);
    var di = f64_add(f64_mul(br, ri), bi);
    if (f64_eq(di, 0) == 1) { return cx_zero(); }
    var nr2 = f64_add(f64_mul(ar, ri), ai);
    var ni2 = f64_sub(f64_mul(ai, ri), ar);
    if (f64_lt(f64_add(f64_add(f64_abs(ar), f64_abs(ai)), f64_abs(bi)), _CX_DIV_SAFE) == 0) {
        if (f64_lt(f64_abs(di), F64_POS_INF) == 0 || f64_lt(f64_abs(nr2), F64_POS_INF) == 0
          || f64_lt(f64_abs(ni2), F64_POS_INF) == 0) {
            return _cx_div_wide(ar, ai, br, bi, f64_div(nr2, di), f64_div(ni2, di));
        }
    }
    var li = ((ri & _CX_EXP) - 1) | ((di & _CX_EXP) - 1);
    if ((li | ((nr2 & _CX_EXP) - 1) | ((ni2 & _CX_EXP) - 1)) < 0 && (br << 1) != 0) {
        if (li < 0 || _cx_lost(nr2, ai, ar) == 1 || _cx_lost(ni2, ar, ai) == 1) {
            return _cx_div_x(ar, ai, br, bi);
        }
    }
    return cx_new(f64_div(nr2, di), f64_div(ni2, di));
}

# Internal: 1 when the numerator n = p + m * ratio (either sign) may have lost bits below the
# range, 0 when it has not. A normal n has not. A subnormal n has. A ZERO n has only where its
# plain term p is itself zero or subnormal while m is not, so that the m * ratio term may have
# underflowed; a zero beside a normal p is an exact cancellation, and 0 / b has nothing to lose.
fn _cx_lost(n, p, m) {
    if ((n & _CX_EXP) != 0) { return 0; }
    if ((n << 1) != 0) { return 1; }
    if ((p & _CX_EXP) == 0 && (m << 1) != 0) { return 1; }
    return 0;
}

# Internal: the exponent e of a finite x != 0, 2^e <= |x| < 2^(e + 1), subnormals included.
fn _cx_xe(x) {
    var f = (x >> 52) & 0x7FF;
    if (f != 0) { return f - 1023; }
    return (((f64_mul(x, _CX_TWO64) >> 52) & 0x7FF) - 1023) - 64;
}

# Internal: the significand of a finite x != 0 with x's sign, |.| in [1, 2): x = it * 2^_cx_xe(x).
fn _cx_xm(x) {
    var y = x;
    if (((x >> 52) & 0x7FF) == 0) { y = f64_mul(x, _CX_TWO64); }
    return (y & 0x800F_FFFF_FFFF_FFFF) | 0x3FF0_0000_0000_0000;
}

# Internal: m * 2^e for a finite m and an integer e whose product is 2^-1022 or more in
# magnitude, or +-Inf past DBL_MAX: exact, a power-of-two scaling of a normal result. Its two
# callers never ask for less (_cx_xs scales by at most 2^-60, _cx_xd only quotients of
# 2^-1022 or more).
fn _cx_xl(m, e) {
    if ((m << 1) == 0) { return m; }
    var k = _cx_xe(m) + e;
    if (k > 1023) { return (m & _CX_SIGN) | 0x7FF0_0000_0000_0000; }
    return f64_mul(_cx_xm(m), (k + 1023) << 52);
}

# The extended numbers of _cx_div_x and _cx_inv_x (3.4.1 SYM3): an i64[2] block { m, e } for
# m * 2^e, m a double with |m| in [1, 2) or a signed zero (e is then 0), e any integer. Each
# operation rounds its significand once, as the double operation would, and keeps the exponent
# apart, so none under- or overflows; on values whose double results are normal each gives the
# double result's bits exactly, since a rounding to 53 bits does not depend on the scale.

# Internal: o = m * 2^e, normalised.
fn _cx_xn(m, e, o) {
    if ((m << 1) == 0) {
        store64(o, m);
        store64(o + 8, 0);
        return 0;
    }
    store64(o, _cx_xm(m));
    store64(o + 8, e + _cx_xe(m));
    return 0;
}

# Internal: o = a * b, o = a / b, o = a + b and o = -a for extended a, b; o may be a or b.
fn _cx_xp(a, b, o) { return _cx_xn(f64_mul(load64(a), load64(b)), load64(a + 8) + load64(b + 8), o); }
fn _cx_xq(a, b, o) { return _cx_xn(f64_div(load64(a), load64(b)), load64(a + 8) - load64(b + 8), o); }
fn _cx_xg(a, o) {
    store64(o, load64(a) ^ _CX_SIGN);
    store64(o + 8, load64(a + 8));
    return 0;
}
# A term more than 2^60 below the other is below a quarter of its last bit, so the double
# sum rounds it away too and so does this; zeros add with their IEEE signs.
fn _cx_xs(a, b, o) {
    var ma = load64(a);
    var ea = load64(a + 8);
    var mb = load64(b);
    var eb = load64(b + 8);
    if ((mb << 1) == 0) {
        if ((ma << 1) == 0) { ma = f64_add(ma, mb); }
        return _cx_xn(ma, ea, o);
    }
    if ((ma << 1) == 0) { return _cx_xn(mb, eb, o); }
    if (ea < eb) {
        var tm = ma;
        var te = ea;
        ma = mb;
        ea = eb;
        mb = tm;
        eb = te;
    }
    if (ea - eb > 60) { return _cx_xn(ma, ea, o); }
    return _cx_xn(f64_add(ma, _cx_xl(mb, eb - ea)), ea, o);
}

# Internal: the double nearest n / d for extended n, d (d not 0), one rounding: a quotient of
# 2^-1022 or more is the significands' quotient scaled exactly (or +-Inf past DBL_MAX); a
# smaller one is one IEEE division of n's significand at 2^-1000 by d's scaled to match, so
# it rounds once into the subnormals, as a double division would.
fn _cx_xd(n, d) {
    var mn = load64(n);
    var md = load64(d);
    if ((mn << 1) == 0) { return f64_div(mn, md); }
    var e = load64(n + 8) - load64(d + 8);
    if (e >= 0 - 1021) { return _cx_xl(f64_div(mn, md), e); }
    if (e < 0 - 1130) { return f64_div(mn, md) & _CX_SIGN; }
    return f64_div(f64_mul(mn, _CX_TWOM1000), f64_mul(md, (23 - e) << 52));
}

# Internal: cx_div's quotient for finite a, b with b's smaller part not 0, when Smith's ratio,
# denominator or a numerator came out subnormal or zero (3.4.1 SYM3): the same Smith's
# formula, branch for branch and operation for operation, on extended numbers, rounded once
# into place (_cx_xd). It is the quotient Smith's algorithm gives where no intermediate
# underflows, and where cx_div's doubles underflowed it keeps the bits they lost.
fn _cx_div_x(ar, ai, br, bi) {
    var xr: i64[2];
    var xi: i64[2];
    var yr: i64[2];
    var yi: i64[2];
    var r: i64[2];
    var d: i64[2];
    var n1: i64[2];
    var n2: i64[2];
    var t: i64[2];
    _cx_xn(ar, 0, &xr);
    _cx_xn(ai, 0, &xi);
    _cx_xn(br, 0, &yr);
    _cx_xn(bi, 0, &yi);
    if (f64_lt(f64_abs(bi), f64_abs(br)) == 1) {
        _cx_xq(&yi, &yr, &r);
        _cx_xp(&yi, &r, &t);
        _cx_xs(&yr, &t, &d);
        _cx_xp(&xi, &r, &t);
        _cx_xs(&xr, &t, &n1);
        _cx_xp(&xr, &r, &t);
        _cx_xg(&t, &t);
        _cx_xs(&xi, &t, &n2);
    } else {
        _cx_xq(&yr, &yi, &r);
        _cx_xp(&yr, &r, &t);
        _cx_xs(&t, &yi, &d);
        _cx_xp(&xr, &r, &t);
        _cx_xs(&t, &xi, &n1);
        _cx_xp(&xi, &r, &t);
        _cx_xg(&xr, &n2);
        _cx_xs(&t, &n2, &n2);
    }
    return cx_new(_cx_xd(&n1, &d), _cx_xd(&n2, &d));
}

# Smith's quotient (ar + i ai) / (br + i bi), both branches of cx_div, into out[0], out[1].
# _cx_div_wide calls it on scaled operands that are finite with b != 0 and every part at
# most 2^1022, so no sum below can overflow.
fn _cx_smith_into(ar, ai, br, bi, out) {
    if (f64_lt(f64_abs(bi), f64_abs(br)) == 1) {
        var rb = f64_div(bi, br);
        var db = f64_add(br, f64_mul(bi, rb));
        store64(out, f64_div(f64_add(ar, f64_mul(ai, rb)), db));
        store64(out + 8, f64_div(f64_sub(ai, f64_mul(ar, rb)), db));
        return 0;
    }
    var ri = f64_div(br, bi);
    var di = f64_add(f64_mul(br, ri), bi);
    store64(out, f64_div(f64_add(f64_mul(ar, ri), ai), di));
    store64(out + 8, f64_div(f64_sub(f64_mul(ai, ri), ar), di));
    return 0;
}

# cx_div / cx_inv's quotient when Smith's sum or a numerator came out non-finite; qr, qi
# are the quotient that arithmetic gave, returned unchanged unless a rule below applies.
#   - every part of b finite: a sum passes DBL_MAX only from a part of 2^1022 or more.
#     When b's larger part is 2^1021 or more, a and b are both scaled by 1/4,
#     which leaves the quotient unchanged and every sum below 2^1023; otherwise it was
#     a numerator, so a alone is scaled and the quotient multiplied by 4 after, exact
#     unless the quotient itself overflows. A power-of-two scaling is exact, except that
#     a subnormal part of a scaled operand loses its two lowest bits, which is below
#     the quotient's own rounding: wherever a sum of finite parts overflows, Smith's ratio
#     is at least 2^-53, so _cx_div_lo's subnormal ratio cannot arise here (3.4.1 SYM3). An infinite
#     or NaN part of a passes through the scaling unchanged, so an
#     infinite a over a b of 2^1023 is the infinity it is, (Inf + 0i) / (2^1023 (1 + i))
#     = Inf - Inf i, where the unscaled Inf / Inf made it NaN + NaN i.
#   - b infinite (a part +-Inf, the other anything), where Smith's gave a NaN (Inf / Inf
#     in its ratio): 0 * (ar c + ai d) + i 0 * (ai c - ar d), c and d each +-1 for an
#     infinite part and +-0 otherwise, with the part's sign -- the recovery the reference
#     _Cdivd runs on the same NaN. For a finite a it is C99 G.5.1's zero; for an a with an
#     infinite or NaN part each sum is infinite or NaN, so both parts are NaN, as they
#     were. Where Smith's already gave zeros (one infinite part: x / Inf), they are kept.
#   - otherwise (b has a NaN part and no infinite one): qr + i qi, Smith's own NaN.
fn _cx_div_wide(ar, ai, br, bi, qr, qi) {
    var fb = 0;
    if (f64_lt(f64_abs(br), F64_POS_INF) == 1 && f64_lt(f64_abs(bi), F64_POS_INF) == 1) { fb = 1; }
    if (fb == 1) {
        var q: i64[2];
        var mb = f64_abs(br);
        if (f64_lt(mb, f64_abs(bi)) == 1) { mb = f64_abs(bi); }
        if (f64_lt(mb, _CX_DIV_WIDE) == 0) {
            _cx_smith_into(f64_mul(ar, _CX_DIV_QUARTER), f64_mul(ai, _CX_DIV_QUARTER),
              f64_mul(br, _CX_DIV_QUARTER), f64_mul(bi, _CX_DIV_QUARTER), &q);
            return cx_new(load64(&q), load64(&q + 8));
        }
        _cx_smith_into(f64_mul(ar, _CX_DIV_QUARTER), f64_mul(ai, _CX_DIV_QUARTER), br, bi, &q);
        return cx_new(f64_mul(load64(&q), _CX_DIV_FOUR), f64_mul(load64(&q + 8), _CX_DIV_FOUR));
    }
    var binf = 0;
    if (f64_eq(f64_abs(br), F64_POS_INF) == 1 || f64_eq(f64_abs(bi), F64_POS_INF) == 1) { binf = 1; }
    var qnan = 0;
    if (f64_eq(qr, qr) == 0 || f64_eq(qi, qi) == 0) { qnan = 1; }
    if (binf == 1 && qnan == 1) {
        var c = br & 0x8000_0000_0000_0000;
        if (f64_eq(f64_abs(br), F64_POS_INF) == 1) { c = c | F64_ONE; }
        var d = bi & 0x8000_0000_0000_0000;
        if (f64_eq(f64_abs(bi), F64_POS_INF) == 1) { d = d | F64_ONE; }
        return cx_new(f64_mul(0, f64_add(f64_mul(ar, c), f64_mul(ai, d))),
          f64_mul(0, f64_sub(f64_mul(ai, c), f64_mul(ar, d))));
    }
    return cx_new(qr, qi);
}

# The conjugate re - i im, exact (the sign bit of im flipped). 0 when not allocated.
#must_use
public fn cx_conj(a) { return cx_new(HComplex_re(a), HComplex_im(a) ^ _CX_SIGN); }
# -a, exact (both sign bits flipped). 0 when not allocated.
#must_use
public fn cx_neg(a) { return cx_new(HComplex_re(a) ^ _CX_SIGN, HComplex_im(a) ^ _CX_SIGN); }

# a * s for a real f64 s, each part one IEEE product. 0 when not allocated.
#must_use
public fn cx_scale(a, s) {
    return cx_new(f64_mul(HComplex_re(a), s), f64_mul(HComplex_im(a), s));
}

# |a|^2 = re^2 + im^2, the plain sum of squares (three roundings): it overflows to +Inf
# once |a| passes about 2^512 and flushes toward 0 below about 2^-537, where |a|^2 itself is
# out of range. cx_abs does not go through it there.
#must_use
public fn cx_norm_sq(a) {
    return f64_add(f64_mul(HComplex_re(a), HComplex_re(a)),
      f64_mul(HComplex_im(a), HComplex_im(a)));
}

# ⛔ 2.17.0 — THIS SQUARED BEFORE SUMMING, so `cx_abs` — the modulus that `cx_ln`,
# `cx_sqrt`, `cx_powf` and `cmat_exp` are every one of them built on — was wrong
# on 994 of 2041 binades. `re*re` underflows to zero below 2^-537 and overflows to
# +Inf above 2^511, so |3k + 4ki| came back as exactly 0 or exactly +Inf where 5k
# is perfectly representable — measured +Inf at k = 2^700 for an answer of 5·2^700.
# ⚠ And the silent band is worse than either end: at k = 2^-539 the sum is
# SUBNORMAL, so the answer is finite, plausible and **13.1% too large**, with
# nothing at all to signal it.
# [measured: 2041-binade two-sided sweep on the 2.16.0 tree, 2026-09-10]
#
# ⭐ FAST PATH, NOT UNCONDITIONAL SCALING — the same shape as `hvec3_length`. The
# naive sum announces its own failure: it is subnormal, zero or +Inf exactly when
# it cannot be trusted, and exact otherwise, so take it when it is NORMAL and
# rescale only when it is not.
# ⭐ The rescue is `ganita_f64_hypot` rather than a hand-rolled copy of the
# scale-by-the-larger-leg loop: the stdlib ships exactly this function for exactly
# this reason, and this file already calls into ganita for `cx_arg`/`cx_powf`.
# ⚠ A NaN never reaches the rescue — a NaN norm_sq satisfies neither guard and
# falls through to `f64_sqrt`, so hisab's NaN-in/NaN-out contract is unchanged and
# ganita's differing (Inf, NaN) rule is unreachable from here.
#must_use
public fn cx_abs(a) {
    var ns = cx_norm_sq(a);
    if (f64_lt(ns, F64_TINY) == 1) { return ganita_f64_hypot(HComplex_re(a), HComplex_im(a)); }
    if (f64_eq(ns, F64_POS_INF) == 1) { return ganita_f64_hypot(HComplex_re(a), HComplex_im(a)); }
    return f64_sqrt(ns);
}

# arg a = ganita_f64_atan2(im, re), in [-pi, pi], with ganita's accuracy and its signed
# zero and infinity cases: arg(-0 - 0i) = -pi.
#must_use
public fn cx_arg(a) { return ganita_f64_atan2(HComplex_im(a), HComplex_re(a)); }

# 1 / a: cx_div(1 + 0i, a) specialised, the same Smith's form and the same answers at
# the edges -- a = 0 + 0i exactly answers the cx_zero() sentinel, a NaN part NaN parts,
# an infinite a 0 (C99 G.5.1), and parts near DBL_MAX are rescaled (3.4.1). Returns 0
# when the result cannot be allocated.
#must_use
public fn cx_inv(a) {
    # ⭐ Smith's, specialised to a numerator of 1+0i — same reason as `cx_div`, and
    # deliberately the same shape so the two cannot drift apart. `cx_norm_sq` was
    # the whole problem here: it squares before anything else, so |a|² was already
    # 0 or +Inf outside ~1e±154 and no threshold could see past it.
    # ⛔ 3.4.1 — AND ITS DENOMINATOR OVERFLOWED FROM ABOUT DBL_MAX / 2, as cx_div's did:
    # cx_inv(DBL_MAX(1 + i)) was (0, -0) for (0002000000000000, 8002000000000000). The
    # same rescue, _cx_div_wide, with the numerator 1 + 0i.
    # [measured: tests/hisab.tcyr, group "3.4.1: cx_div / cx_inv near DBL_MAX and over an infinite divisor"]
    # ⛔ 3.4.1 SYM3 — AND AT THE BOTTOM, AS cx_div's: a subnormal ratio kept only the bits
    # above 2^-1074, and dividing it by a denominator below 1 scaled that rounding up into a
    # normal part: cx_inv(1.25 * 2^-40 + 2^-1074 i).im was 1,311 ulp off. A subnormal
    # denominator lost both parts. Of 200,000 inverses with every part on every binade, 104
    # were off by more than 4 ulp, up to 1.0e7 ulp. When the ratio or the denominator is
    # subnormal or zero and the smaller part is not 0, the same Smith's formula is evaluated
    # on cx_div's extended numbers (_cx_inv_x): none of the 200,000 is off by more than 2.0
    # ulp now, and every inverse whose Smith intermediates are normal is the arithmetic below,
    # bit for bit.
    # [measured: scratch exact-rational sweeps cxora.py / cxbit.py, 3.4.0, s11 and the SYM3 tree, 2026-11-01]
    var ar = HComplex_re(a); var ai = HComplex_im(a);
    if (f64_lt(f64_abs(ai), f64_abs(ar)) == 1) {
        var rb = f64_div(ai, ar);
        var db = f64_add(ar, f64_mul(ai, rb));
        if (f64_eq(db, 0) == 1) { return cx_zero(); }
        if (f64_lt(f64_abs(db), F64_POS_INF) == 0) {
            return _cx_div_wide(F64_ONE, 0, ar, ai, f64_div(F64_ONE, db), f64_div(rb, db) ^ _CX_SIGN);
        }
        if (((((rb & _CX_EXP) - 1) | ((db & _CX_EXP) - 1)) < 0) && (ai << 1) != 0) {
            return _cx_inv_x(ar, ai);
        }
        return cx_new(f64_div(F64_ONE, db), f64_div(rb, db) ^ _CX_SIGN);
    }
    # Both parts, as in cx_div: a NaN+0i argument returned 0+0i through 3.3.1.
    if (f64_eq(ai, 0) == 1 && f64_eq(ar, 0) == 1) { return cx_zero(); }
    var ri = f64_div(ar, ai);
    var di = f64_add(f64_mul(ar, ri), ai);
    if (f64_eq(di, 0) == 1) { return cx_zero(); }
    if (f64_lt(f64_abs(di), F64_POS_INF) == 0) {
        return _cx_div_wide(F64_ONE, 0, ar, ai, f64_div(ri, di), f64_div(F64_ONE, di) ^ _CX_SIGN);
    }
    if (((((ri & _CX_EXP) - 1) | ((di & _CX_EXP) - 1)) < 0) && (ar << 1) != 0) {
        return _cx_inv_x(ar, ai);
    }
    return cx_new(f64_div(ri, di), f64_div(F64_ONE, di) ^ _CX_SIGN);
}

# Internal: cx_inv's inverse for finite a with its smaller part not 0, when Smith's ratio or
# denominator came out subnormal or zero (3.4.1 SYM3): cx_inv's Smith's formula, branch for
# branch, on _cx_div_x's extended numbers, each part rounded once into place.
fn _cx_inv_x(ar, ai) {
    var yr: i64[2];
    var yi: i64[2];
    var one: i64[2];
    var r: i64[2];
    var d: i64[2];
    var t: i64[2];
    _cx_xn(ar, 0, &yr);
    _cx_xn(ai, 0, &yi);
    _cx_xn(F64_ONE, 0, &one);
    if (f64_lt(f64_abs(ai), f64_abs(ar)) == 1) {
        _cx_xq(&yi, &yr, &r);
        _cx_xp(&yi, &r, &t);
        _cx_xs(&yr, &t, &d);
        return cx_new(_cx_xd(&one, &d), _cx_xd(&r, &d) ^ _CX_SIGN);
    }
    _cx_xq(&yr, &yi, &r);
    _cx_xp(&yr, &r, &t);
    _cx_xs(&t, &yi, &d);
    return cx_new(_cx_xd(&r, &d), _cx_xd(&one, &d) ^ _CX_SIGN);
}

# r (cos theta + i sin theta), ganita's cos and sin times r. It cannot land on an axis
# (cos(fl(pi / 2)) is about 6e-17, not 0), and an infinite r beside a zero sine or cosine
# gives a NaN part: cx_from_polar(+Inf, 0) is (+Inf, NaN). 0 when not allocated.
#must_use
public fn cx_from_polar(r, theta) {
    return cx_new(f64_mul(r, f64_cos(theta)), f64_mul(r, f64_sin(theta)));
}

# ================================================================
# Elementary functions
# ================================================================

# e^a = e^re (cos im + i sin im). e^re overflows to +Inf above re = 709.78 even where the
# product with a cosine or sine below 1 fits, and then a zero sine or cosine gives a NaN
# part: cx_exp(710 + 0i) is (+Inf, NaN), where C99 cexp gives (+Inf, +0). 0 when not
# allocated.
#must_use
public fn cx_exp(a) {
    var r = f64_exp(HComplex_re(a));
    return cx_new(f64_mul(r, f64_cos(HComplex_im(a))),
      f64_mul(r, f64_sin(HComplex_im(a))));
}

# ln a = ln|a| + i arg a, the principal branch, with cx_abs's rescaled modulus and ganita's
# ln and atan2. ln 0 is (-Inf, arg 0). The real part is ln of a rounded modulus, so it
# loses its relative accuracy as |a| nears 1: cx_ln(1 + 1e-10 i).re is 0, exact 5e-21.
# 0 when not allocated.
#must_use
public fn cx_ln(a) {
    return cx_new(f64_ln(cx_abs(a)), cx_arg(a));
}

# cx_sqrt's rescaling. Every factor is a power of two, so scaling the input by 4^-k
# and the result by 2^k changes no bits wherever nothing is subnormal.
var _CX_SQRT_BIG = 0x7FC0_0000_0000_0000;      # 2^1021
var _CX_SQRT_SMALL = 0x0020_0000_0000_0000;    # 2^-1021
var _CX_SQRT_QUARTER = 0x3FD0_0000_0000_0000;  # 0.25
var _CX_SQRT_UP = 0x4350_0000_0000_0000;       # 2^54
var _CX_SQRT_UP_ROOT = 0x3E40_0000_0000_0000;  # 2^-27
var _CX_SQRT_UP_DIV = 0x41B0_0000_0000_0000;   # 2^28

# C99 G.6.4.2 for an operand with a non-finite part. The rows are tested in the
# table's precedence: an infinite imaginary part decides the answer whatever the real
# part is, a NaN one included, so it goes first.
# ⚠ NaN CHOICE. C99 asks only for "a NaN"; this returns the NaN OPERAND, the real
# part's when it has one, in every NaN slot, QUIETED: the quiet bit (bit 51) is set and
# the payload and sign kept. Those are the bits the polar form's arithmetic handed back,
# a signaling NaN's included -- returning the operand raw would hand a signaling NaN
# out of an arithmetic function, which IEEE 754 forbids. For -Inf + i NaN, where C99
# leaves the sign of the infinite imaginary part unspecified, it takes the sign BIT of
# the NaN, so csqrt(conj z) = conj(csqrt z) holds there too.
# [measured: scratch csqrt probe (special-value table), 2026-10-03; cycc 6.6.14]
fn _cx_sqrt_nonfinite(x, y) {
    var qx = x | 0x0008_0000_0000_0000;   # x with its quiet bit set; unchanged unless x is NaN
    var qy = y | 0x0008_0000_0000_0000;
    # csqrt(x + i Inf) = +Inf + i Inf, for EVERY x.
    if (f64_eq(f64_abs(y), F64_POS_INF) == 1) { return cx_new(F64_POS_INF, y); }
    # csqrt(NaN + i y) = NaN + i NaN.
    if (f64_eq(x, x) == 0) { return cx_new(qx, qx); }
    # A finite x reaches here only with a NaN y: NaN + i NaN.
    if (f64_eq(f64_abs(x), F64_POS_INF) == 0) { return cx_new(qy, qy); }
    if (f64_lt(x, 0) == 1) {
        # csqrt(-Inf + i y) = +0 + i Inf with y's sign; for a NaN y, NaN +- i Inf.
        if (f64_eq(y, y) == 0) { return cx_new(qy, f64_copysign(F64_POS_INF, y)); }
        return cx_new(0, f64_copysign(F64_POS_INF, y));
    }
    # csqrt(+Inf + i y) = +Inf + i 0 with y's sign; for a NaN y, +Inf + i NaN.
    if (f64_eq(y, y) == 0) { return cx_new(F64_POS_INF, qy); }
    return cx_new(F64_POS_INF, f64_copysign(0, y));
}

# ⛔ 3.3.4 — THIS WAS `cx_from_polar(sqrt|a|, arg(a)/2)`, and the polar form cannot
# land ON an axis: cos(fl(pi)/2) is about 6e-17, not 0, so sqrt(-4 + 0i).re came back
# 0x3CA1A62633145C07 where C99 csqrt gives +0. Near the negative real axis the real
# part is r*cos(theta/2) with theta/2 within an ulp of pi/2, so its RELATIVE error had
# no bound at all: over a two-sided binade grid of 506944 points, 121520 real parts
# were more than 2^40 ulp out or not finite. The special values were wrong too:
# csqrt(+Inf + i y) had a NaN imaginary part (Inf * sin 0), csqrt(-Inf + i y) was
# +Inf + i Inf for +0 + i Inf, and wherever |z| overflowed near DBL_MAX the root came
# back infinite.
# [measured: scratch csqrt probe (Decimal oracle, prec 110), not reproducible in-tree, 2026-10-03; cycc 6.6.14]
#
# ⭐ CACM ALGORITHM 312 (Friedland 1967), the form FreeBSD msun's s_csqrt.c uses; the
# special values follow C99 G.6.4.2 (Kahan's 1987 branch-cut rules).
# For x >= 0, t = sqrt((x + |z|)/2) and the root is (t, y/(2t)); for x < 0,
# t = sqrt((|z| - x)/2) and it is (|y|/(2t), copysign(t, y)). Both sums add two
# non-negative numbers, so nothing cancels. The axes come out exact: on the real axis
# |z| = |x|, so t is sqrt(|x|) correctly rounded and the other part an exact zero with
# its sign; on the imaginary axis both parts are sqrt(|y|/2), so t is returned twice
# (y/(2t) can sit an ulp away from t). The sign comes from y's sign BIT, never an
# ordered compare, which would send sqrt(-4 - 0i) to +2i instead of -2i.
#
# ⭐ POWER-OF-FOUR SCALING. x + |z| overflows once max(|x|, |y|) passes
# DBL_MAX/(1 + sqrt 2), so from 2^1021 up the input is scaled by 1/4 and the root by 2.
# Below 2^-1021 the halving (x + |z|)/2 can go subnormal and drop a bit, so the input
# is scaled by 2^54 and the root by 2^-27; that bound is sharp, and 2^-1022 leaves roots
# an ulp out. The quotient part divides by the SCALED 2t instead of being scaled
# afterwards, so a subnormal result is rounded once, not twice. Zeros take the
# up-scaled path too and come out exact: an explicit zero row changed no bits.
# [measured: scratch csqrt probe (mutation run), 2026-10-03; cycc 6.6.14]
#
# ⚠ ACCURACY, ON THE SAMPLED SETS (a two-sided binade grid, the axes, random and
# near-axis points): every component within 2.16 ulp of the Decimal oracle and 80-82%
# correctly rounded (glibc 2.44's csqrt on the same points: 80-82%, at most 1.95 ulp,
# bit-identical to this on 96.7% or more); every axis point correctly rounded with the
# C99 zero sign. It is not a bound: a targeted search on |x| << |y| finds 2.43 ulp at
# cx_sqrt(0xBF81197459105F69 + 0xBFE03CFA7141501E i).re, where glibc is 0.43 ulp out and
# the polar form 2.57. Nor is it closer than the polar form at every point: on 0.1-4.1%
# of points, by component and depending on the set, the polar form had landed more than
# 0.5 ulp closer, by at most 2 ulp.
# [measured: scratch csqrt probe + independent check (10M-point search), 2026-10-03; cycc 6.6.14]
#must_use
public fn cx_sqrt(a) {
    var x = HComplex_re(a);
    var y = HComplex_im(a);
    var ax = f64_abs(x);
    var ay = f64_abs(y);
    if (f64_lt(ax, F64_POS_INF) == 0 || f64_lt(ay, F64_POS_INF) == 0) { return _cx_sqrt_nonfinite(x, y); }
    var m = ax;
    if (f64_lt(m, ay) == 1) { m = ay; }
    var s = F64_ONE;    # the root's scale
    var ds = F64_TWO;   # the divisor's: 2t comes out as t * ds, which is 2t / s
    var r = 0;
    # The scaled operand is a stack HComplex (3.4.0): cx_abs only reads it, and a heap
    # copy here was read unchecked.
    var xy: i64[2];
    if (f64_lt(m, _CX_SQRT_BIG) == 0) {
        x = f64_mul(x, _CX_SQRT_QUARTER);
        y = f64_mul(y, _CX_SQRT_QUARTER);
        s = F64_TWO;
        ds = F64_ONE;
        store64(&xy, x);
        store64(&xy + 8, y);
        r = cx_abs(&xy);
    } else {
        if (f64_lt(m, _CX_SQRT_SMALL) == 1) {
            x = f64_mul(x, _CX_SQRT_UP);
            y = f64_mul(y, _CX_SQRT_UP);
            s = _CX_SQRT_UP_ROOT;
            ds = _CX_SQRT_UP_DIV;
            store64(&xy, x);
            store64(&xy + 8, y);
            r = cx_abs(&xy);
        } else {
            r = cx_abs(a);
        }
    }
    var t = 0;
    if (f64_lt(x, 0) == 1) {
        t = f64_sqrt(f64_mul(f64_sub(r, x), F64_HALF));
        return cx_new(f64_div(f64_abs(y), f64_mul(t, ds)), f64_copysign(f64_mul(t, s), y));
    }
    t = f64_sqrt(f64_mul(f64_add(x, r), F64_HALF));
    var u = f64_mul(t, s);
    # The imaginary axis, and csqrt(+-0 + i 0) = +0 + i 0 with it: -0 + 0 is +0, so t
    # is +0 and y's sign bit is the only sign the root of a zero carries.
    if (f64_eq(x, 0) == 1) { return cx_new(u, f64_copysign(u, y)); }
    return cx_new(u, f64_div(y, f64_mul(t, ds)));
}

# From here up every f64 is a whole multiple of 4.
var _CX_POWF_WHOLE_TURNS = 0x4350_0000_0000_0000;  # 2^54

# ⛔ 3.3.4 — THE POLAR FORM CANNOT LAND ON AN AXIS. arg(i) is fl(pi/2), not pi/2, so
# cx_powf(i, 2) was -1 + 0x3CA1A62633145C07 i rather than -1 + 0i, (-4 + 0i)^0.5 had
# the real part 0x3CA1A62633145C07 where csqrt gives +0, and cx_powf(i, 2^60) -- a
# whole number of turns -- was 0x3FB6F22BC9948F49 + 0xBFEFDF06B916C886 i, an arbitrary
# point on the unit circle, because 2^60 * fl(pi/2) is 70.6 radians from 2^59 * pi.
# An overflowing r turned the stray 1e-16 into an infinity: cx_powf(1e200 i, 2) was
# -Inf + Inf i. glibc 2.44's cpow gives the same answers on these rows, and C99 does
# not specify cpow's accuracy, so this is an improvement, not a conformance repair.
# [measured: scratch csqrt probe (cx_powf differential), not reproducible in-tree, 2026-10-03; cycc 6.6.14]
#
# ⭐ When z is EXACTLY on the negative real or the imaginary axis -- a zero part, not
# an angle that merely rounds to fl(pi) -- arg z is q quarter turns (q = +-2 or +-1),
# and z^n is on an axis whenever k = n*q is a whole number: the point r * i^k. The zero
# part takes its sign from the side n*arg(z) reaches the axis from: y's sign bit on the
# negative real axis, x's on the imaginary one, and a negative n turns the other way.
# Those are the signs IEEE repeated multiplication gives -- (+0 + 2i)^2 = -4 + 0i,
# (-0 + 2i)^2 = -4 - 0i -- and on k = 1 (n = 0.5) the signs csqrt gives. Returns 1 for
# every other input, which then takes the polar form exactly as before; 0 is a refused
# allocation (3.4.1), the caller's answer, where it used to fall through to the polar form and
# come back with an ulp-sized part in place of the exact zero.
fn _cx_powf_axis(a, n, r) {
    var x = HComplex_re(a);
    var y = HComplex_im(a);
    var q = 0;
    var dir = 0 - 1;   # -1: n*arg(z) reaches the axis from below; +1: from above
    if (f64_eq(y, 0) == 1 && f64_lt(x, 0) == 1) { q = 2; }
    if (f64_eq(x, 0) == 1 && f64_eq(y, y) == 1) {
        q = 1;
        if (((x >> 63) & 1) == 1) { dir = 1; }
    }
    if (q == 0) { return 1; }
    if (((y >> 63) & 1) == 1) { q = 0 - q; dir = 0 - dir; }
    if (((n >> 63) & 1) == 1) { dir = 0 - dir; }
    # Only k mod 4 picks the axis. Below 2^54, n*q is exact and f64_to cannot
    # overflow; from 2^54 up n is a multiple of 4, so k is too. An infinite n turns
    # without end and has no axis; a NaN n fails both compares and has none either.
    var j = 0;
    if (f64_lt(f64_abs(n), _CX_POWF_WHOLE_TURNS) == 1) {
        var k = f64_mul(n, f64_from(q));
        if (f64_eq(f64_trunc(k), k) == 0) { return 1; }
        j = f64_to(k) & 3;
    } else {
        if (f64_lt(f64_abs(n), F64_POS_INF) == 0) { return 1; }
    }
    var zs = 0;
    if (dir < 0) { zs = 0x8000_0000_0000_0000; }
    var zo = zs ^ 0x8000_0000_0000_0000;
    if (j == 0) { return cx_new(r, zs); }
    if (j == 1) { return cx_new(zo, r); }
    if (j == 2) { return cx_new(r ^ _CX_SIGN, zo); }
    return cx_new(zs, r ^ _CX_SIGN);
}

# a^n for a real n: |a|^n cis(n arg a) through ganita_f64_pow, exact on the axes (see the
# notes in the body: a point on the negative real or imaginary axis raised to a whole
# number of quarter turns lands on an axis exactly), and C99's cexp rows for an angle with
# no direction. a = 0 + 0i returns 0 + 0i for every n -- 0^0 and n < 0 included, a [3.5.0]
# row (num_modpow and dual_pow give 1 for 0^0, C99 +Inf for n < 0). 0 when not allocated.
#must_use
public fn cx_powf(a, n) {
    # ⛔ 2.17.0 — THIS GUARDED THE SQUARE. The 2.15.0 note it replaces argued a
    # threshold on |a|² was exactly right here "because `cx_abs` is itself
    # `sqrt(cx_norm_sq)`, so the value is already gone once |a|² is subnormal".
    # That premise died with the rewrite of `cx_abs` above: the modulus is exact at
    # every scale now, so the value is NOT gone and this guard was fabricating a
    # zero for every modulus below ~1.5e-154. Measured: `cx_powf(2^-600 + 0i, 1)`
    # returned exactly 0 where the answer is 2^-600, bit for bit.
    # ⭐ Guard the MODULUS, not its square, and guard exactly what fails:
    # `ganita_f64_pow(m, n)` needs a non-zero `m`, and `m == 0` holds only for an
    # exactly zero `a`. There is no scale left to choose, which is the point.
    # ⛔ The tempting sharper form `m == 0 && n <= 0` is REFUTED, not deferred: it
    # does not fire at n = 0, so ganita's `pow(x,0) = 1` reaches cx_from_polar and
    # `cx_powf(0+0i, 0)` returns 1.0 — measured, it fails tests/abuse.tcyr's 0^0
    # assertion. Changing that is a decision about hisab's 0^0, not a free
    # sharpening, and is not folded in here.
    # [measured: scratch two-sided binade probe on the 2.16.0 tree, 2026-09-10]
    var m = cx_abs(a);
    if (f64_eq(m, 0) == 1) { return cx_zero(); }
    var r = ganita_f64_pow(m, n);
    var arg = cx_arg(a);
    var theta = f64_mul(arg, n);
    # ⛔ 3.3.5 — 0 * Inf MADE THE ANGLE NaN ON THE POSITIVE REAL AXIS. arg z = +-0 there,
    # and n = +-Inf gave theta = NaN, so cx_powf(2 + 0i, +Inf) was NaN + NaN i where z^n
    # is the real pow(2, +Inf) = +Inf, and cx_powf(0.5 + 0i, +Inf) NaN + NaN i where it
    # is 0. ⭐ On the axis -- a zero imaginary part, not an angle that underflowed -- the
    # angle is the zero every finite n gives it, its sign that of arg * n, and the
    # zero-angle path below returns (r, theta). An angle that underflowed (|y| far below
    # x) is not zero: n = +-Inf turns it without end, so theta is the infinity of that
    # sign, and the undefined-angle rows below apply.
    if (f64_eq(arg, 0) == 1 && f64_eq(f64_abs(n), F64_POS_INF) == 1) {
        theta = (arg ^ n) & 0x8000_0000_0000_0000;
        if (f64_eq(HComplex_im(a), 0) == 0) { theta = theta | F64_POS_INF; }
    }
    # ⛔ 3.3.4 — A ZERO ANGLE MADE A NaN FROM NON-NaN INPUT. cx_from_polar computes
    # r * sin(0), and once r is +Inf -- cx_powf(+Inf + 0i, 2), or 2^n overflowing at
    # cx_powf(2 + 0i, 1e300) -- that is Inf * 0 = NaN, where a power of a positive
    # real is a positive real. ⭐ For a finite r the polar form returns (r * 1, r * +-0)
    # = (r, theta) bit for bit, so returning that directly changes no other bits and
    # carries the same answer up to r = +Inf.
    # ⚠ Both new paths are taken only for a non-NaN r. Under the ganita a consumer on
    # cyrius 6.6.3 or 6.6.6 compiles, ganita_f64_pow(+Inf, n) is NaN, and either path
    # would turn that NaN + NaN i into a half-NaN result; a NaN r keeps the polar form,
    # so those pins see 3.3.3's bits.
    # [measured: scratch cx_powf differential, 2026-10-03; cycc 6.6.3, 6.6.6, 6.6.14]
    if (f64_eq(r, r) == 1) {
        if (f64_eq(theta, 0) == 1) { return cx_new(r, theta); }
        var ax = _cx_powf_axis(a, n, r);
        if (ax != 1) { return ax; }
        # ⛔ 3.3.5 — AN ANGLE WITH NO DIRECTION MADE r * cis(theta) NaN WHATEVER r WAS.
        # theta is +-Inf when arg * n overflows (cx_powf(-0.5 + 0.1i, DBL_MAX)) or as set
        # above, and cos/sin of it are NaN. ⭐ Where r = 0 the point is 0 whatever the
        # angle -- each part's magnitude is at most r -- so it is +0 + i0 with theta's
        # sign, C99's cexp(-Inf + i Inf). Where r = +Inf it is C99's cexp(+Inf + i Inf),
        # +Inf + i NaN: infinite, in no known direction. A finite non-zero r (|z| = 1
        # exactly) keeps NaN + NaN i, as cexp(x + i Inf) does. The NaN is the quiet
        # 0x7FF8000000000000 on every target. No NaN theta reaches here with r 0 or +Inf:
        # a NaN arg or n makes r NaN or 1. Over 1,200,000 rows (special values, every
        # binade, both axes, underflowing args, n from +-0 to +-Inf) 45,681 changed under
        # 6.6.14, every one NaN + NaN i on 3.3.4 and every one in the classes above; the
        # rest keep their bits. Under 6.6.3 and 6.6.6 ganita_f64_pow(m, +-Inf) is NaN for
        # every m, so an infinite n keeps NaN + NaN i there, and 18,257 rows changed, all
        # with a finite n whose arg * n overflows.
        # [measured: scratch cx_powf differential, 3.3.4 tree and this tree, cycc 6.6.3, 6.6.6, 6.6.14, 2026-10-11]
        if (f64_eq(f64_abs(theta), F64_POS_INF) == 1) {
            if (f64_eq(r, 0) == 1) { return cx_new(0, theta & 0x8000_0000_0000_0000); }
            if (f64_eq(r, F64_POS_INF) == 1) { return cx_new(F64_POS_INF, 0x7FF8_0000_0000_0000); }
        }
    }
    return cx_from_polar(r, theta);
}

# sin a = sin re cosh im + i cos re sinh im, the textbook form with ganita's functions:
# cosh and sinh overflow to +Inf above |im| = 710.5, and then a zero sine or cosine gives a
# NaN part: cx_sin(0 + 800i) is (NaN, +Inf), exact (0, +Inf). 0 when not allocated.
#must_use
public fn cx_sin(a) {
    return cx_new(f64_mul(f64_sin(HComplex_re(a)), ganita_f64_cosh(HComplex_im(a))),
      f64_mul(f64_cos(HComplex_re(a)), ganita_f64_sinh(HComplex_im(a))));
}

# cos a = cos re cosh im - i sin re sinh im, as cx_sin: cx_cos(0 + 800i) is (+Inf, NaN),
# exact (+Inf, -0). 0 when not allocated.
#must_use
public fn cx_cos(a) {
    return cx_new(f64_mul(f64_cos(HComplex_re(a)), ganita_f64_cosh(HComplex_im(a))),
      f64_mul(f64_sin(HComplex_re(a)), ganita_f64_sinh(HComplex_im(a))) ^ _CX_SIGN);
}

# 1 when |a| < tol, comparing cx_abs (rescaled, so it neither overflows nor flushes) with
# the caller's tol; 0 otherwise, a NaN modulus or tol included.
#must_use
public fn cx_is_zero(a, tol) {
    # ⛔ 2.17.0 — THIS SQUARED BOTH SIDES: `cx_norm_sq(a) < tol*tol`. It is
    # dimensionally consistent, which is why the note beside it in
    # tests/edge_cases.tcyr called it correct while the rest of the module was
    # being repaired — and it is still numerically wrong, because BOTH squares
    # flush. Measured: `cx_is_zero(2^-700 + 0i, 2^-600)` answered 0 for a value a
    # hundred binades BELOW the tolerance, since 2^-1400 and 2^-1200 both underflow
    # to exactly 0 and `0 < 0` is false. The overflow end fails the same way:
    # `cx_is_zero(2^600 + 0i, 2^700)` compares +Inf against +Inf.
    # ⭐ Compare the modulus against the tolerance the caller actually passed.
    # `cx_abs` is exact at every scale now, so nothing is squared and the caller's
    # tolerance keeps the units it was written in.
    # [measured: scratch probe on the 2.16.0 tree, 2026-09-10]
    if (f64_lt(cx_abs(a), tol) == 1) { return 1; }
    return 0;
}

# ================================================================
# Complex Matrix (row-major)
# Layout: { rows: i64, cols: i64, data_ptr: i64 } = 24 bytes
# Each element is 16 bytes (re, im)
# ================================================================

var _CMAT_MAX_ELEMS = 65536;  # 64K elements max (1MB)

# A rows x cols complex matrix of zeros, row-major { rows, cols, data }, or 0 -- the designed
# failure every cmat_* passes on -- when a dimension is <= 0, rows * cols exceeds
# _CMAT_MAX_ELEMS (its element cap, above), or an allocation is refused.
public fn cmat_new(rows, cols) {
    if (rows <= 0 || cols <= 0) { return 0; }
    if (rows > _CMAT_MAX_ELEMS / cols) { return 0; }  # Overflow guard
    var m = alloc(24);
    if (m == 0) { return 0; }
    store64(m, rows);
    store64(m + 8, cols);
    var sz = rows * cols * 16;
    var dp = alloc(sz);
    if (dp == 0) { return 0; }
    var i = 0;
    while (i < rows * cols * 2) {
        store64(dp + i * 8, 0);
        i = i + 1;
    }
    store64(m + 16, dp);
    return m;
}

# The number of rows of m. A raw read: m must not be 0 (cmat_get's precondition).
public fn cmat_rows(m) { return load64(m); }
# The number of columns of m. A raw read: m must not be 0 (cmat_get's precondition).
public fn cmat_cols(m) { return load64(m + 8); }
fn _cmat_data(m) { return load64(m + 16); }

# RAW ACCESSORS -- PRECONDITION, NOT GUARD. Deliberately unchecked, reviewed as
# part of the crash-tier pass and left that way; this block is the record of why,
# so the next reader does not "fix" it.
#
#   PRECONDITION: m != 0, 0 <= r < cmat_rows(m), 0 <= c < cmat_cols(m).
#   Violating it reads or writes outside the data buffer. Callers validate.
#
# 1. THERE IS NO ERROR CHANNEL. cmat_get's success value is a HANDLE from
#    cx_new. Returning 0 for a bad index only moves the crash one frame out --
#    the caller's HComplex_re(0) is load64(0) -- and returning cx_zero() is
#    WORSE: it is bit-identical to a legitimate 0+0i element, so an out-of-range
#    read would silently feed a real-looking zero into cmat_mul, cqr_decompose
#    and every other consumer. A guard whose rejection value cannot be told
#    apart from a valid answer is not a fix.
# 2. THE VALIDATED SURFACE IS ONE LEVEL UP, and it is complete. cmat_new caps at
#    _CMAT_MAX_ELEMS and returns the designed 0; every public cmat_* entry point
#    -- mul, add, sub, scale, adjoint, trace, mul_vec, commutator,
#    anticommutator, kronecker, exp, inverse, identity -- rejects that 0 before
#    it reaches an accessor, and cmat_mul additionally enforces conformability.
#    All of that is asserted in tests/abuse.tcyr. Every in-tree call site (41
#    cmat_get, 57 cmat_set in src/, re-counted for 3.3.2; this said 39 and 58
#    before) is inside such a validated routine, inside cqr_decompose, which
#    rejects the same 0 and checks its out-params' shapes, or inside a fixed-size
#    constructor (pauli_x/y/z, gamma_0, gamma_spatial, gell_mann) whose
#    dimensions and indices are constants.
#    [measured: grep of src/*.cyr with comments stripped, definitions excluded]
# 3. THEY MIRROR THE STDLIB. ganita_mat_get / ganita_mat_set (lib/ganita.cyr, where
#    both are marked UNCHECKED BY DESIGN) are the same two-line unchecked stride
#    computation, and the real matrix family here is built on them. Checking
#    only the complex half would make the two families disagree about what an
#    accessor promises.
# 4. IT IS THE INNER LOOP. Measured with the bounds tests temporarily added to
#    both accessors, 120x120 complex matmul (1.728M inner iterations), best of
#    5: 276 ms unguarded -> 294 ms guarded, +6.5%, for a check every legitimate
#    caller has already done. Same c[0][0] checksum (583220) either way.
#
# The register in tests/abuse.tcyr carried `cmat_get(cmat_new(2, 2), -1, 0)` as
# an exit-139 crash. IT IS NOT ONE -- re-measured, that call exits 0 and returns
# 0+0i, because -1 * 2 * 16 = -32 bytes lands inside the 24-byte header the bump
# allocator handed out just before the data buffer. What does fault is a far
# index (+-1e8, exit 139) or a null handle (exit 139), both of which are
# precondition violations by the contract above.
# [measured: CHANGELOG.md 2.9.0, "The register's reproducer did not reproduce": exit 0, and the two exit 139s]
public fn cmat_get(m, r, c) {
    var off = (r * cmat_cols(m) + c) * 16;
    var dp = _cmat_data(m);
    return cx_new(load64(dp + off), load64(dp + off + 8));
}

# Same precondition as cmat_get above. Returns 0 (HSB_ERR_NONE) always -- no
# in-tree caller reads it, and there is no failure it could report.
public fn cmat_set(m, r, c, val) {
    var off = (r * cmat_cols(m) + c) * 16;
    var dp = _cmat_data(m);
    store64(dp + off, HComplex_re(val));
    store64(dp + off + 8, HComplex_im(val));
    return 0;
}

# ⛔ 3.4.0 -- THE cmat_* ROUTINES BELOW NO LONGER BUILD AN HComplex PER ELEMENT. Each read
# went through cmat_get (a fresh cx_new) and each product or sum through cx_mul / cx_add,
# so every term of a product made four heap temporaries, any of which could be refused and
# then read (the review's exhaustion sweep crashed pauli_x, gamma_0, gamma_spatial and
# cmat_mul_vec this way). They read and write the two f64 of an element directly, and form
# each product and sum with cx_mul's and cx_add's own expressions in their order, so every
# result bit is unchanged.
# [measured: lane AL review sweep, then a scratch sweep of every 8-byte point on AL2, 2026-10-31; cycc 6.7.9]
fn _cmat_re(m, r, c) { return load64(_cmat_data(m) + (r * cmat_cols(m) + c) * 16); }
fn _cmat_im(m, r, c) { return load64(_cmat_data(m) + (r * cmat_cols(m) + c) * 16 + 8); }
fn _cmat_put(m, r, c, re, im) {
    var off = (r * cmat_cols(m) + c) * 16;
    var dp = _cmat_data(m);
    store64(dp + off, re);
    store64(dp + off + 8, im);
    return 0;
}

# Propagates cmat_new's documented 0-on-failure return. Every cmat_* constructor
# below does the same: cmat_new caps at _CMAT_MAX_ELEMS and returns 0 above it, and
# storing through that 0 turns a designed error signal into a SIGSEGV.
# [measured: CHANGELOG.md 2.6.14, the capped-constructor entry; its complex.cyr revert exits 139 (SIGSEGV)]
public fn cmat_identity(n) {
    var m = cmat_new(n, n);
    if (m == 0) { return 0; }
    var i = 0;
    while (i < n) {
        _cmat_put(m, i, i, F64_ONE, 0);
        i = i + 1;
    }
    return m;
}

# The product a b, a new rows(a) x cols(b) matrix: each entry a plain left-to-right sum of
# cx_mul's products, not compensated. 0 when a or b is 0, cols(a) != rows(b), the product
# would exceed _CMAT_MAX_ELEMS, or an allocation is refused.
public fn cmat_mul(a, b) {
    if (a == 0) { return 0; }
    if (b == 0) { return 0; }
    var ar = cmat_rows(a); var ac = cmat_cols(a);
    var bc = cmat_cols(b);
    # CONFORMABILITY. a is ar x ac, so b must be ac x bc. The inner loop below
    # indexes cmat_get(b, k, j) for k up to ac; when rows(b) < ac that reads past
    # b's data buffer, which is allocated at exactly rows(b)*cols(b)*16 bytes.
    # Through 2.6.15 there was no check at all -- a 2x3 times a 2x2 silently read
    # two complex numbers of adjacent heap.
    if (ac != cmat_rows(b)) { return 0; }
    # ar*bc can exceed the cap even when both operands are under it — a 1000x1
    # times a 1x1000 asks for 1e6 elements against a 65536 ceiling.
    var r = cmat_new(ar, bc);
    if (r == 0) { return 0; }
    var i = 0;
    while (i < ar) {
        var j = 0;
        while (j < bc) {
            var sr = 0;
            var si = 0;
            var k = 0;
            while (k < ac) {
                var xr = _cmat_re(a, i, k);
                var xi = _cmat_im(a, i, k);
                var yr = _cmat_re(b, k, j);
                var yi = _cmat_im(b, k, j);
                sr = f64_add(sr, f64_sub(f64_mul(xr, yr), f64_mul(xi, yi)));
                si = f64_add(si, f64_add(f64_mul(xr, yi), f64_mul(xi, yr)));
                k = k + 1;
            }
            _cmat_put(r, i, j, sr, si);
            j = j + 1;
        }
        i = i + 1;
    }
    return r;
}

# Matrix-vector product. v is an array of cols(m) complex numbers (cols*16 bytes).
# Returns a freshly allocated rows*16-byte complex vector, or 0 if either handle
# is null.
public fn cmat_mul_vec(m, v) {
    # m may be the designed 0 that cmat_new returns above _CMAT_MAX_ELEMS or that
    # cmat_mul returns on a non-conformable product; cmat_cols(0) is a null
    # dereference, so guard before reading dims. v is a raw caller buffer and gets
    # the same treatment -- load64(0) is the identical fault one line further in.
    if (m == 0) { return 0; }
    if (v == 0) { return 0; }
    # v is array of n complex numbers (ptr to n*16 bytes)
    var n = cmat_cols(m);
    var rows = cmat_rows(m);
    var out = alloc(rows * 16);
    if (out == 0) { return 0; }
    var i = 0;
    while (i < rows) {
        var sr = 0;
        var si = 0;
        var j = 0;
        while (j < n) {
            var xr = _cmat_re(m, i, j);
            var xi = _cmat_im(m, i, j);
            var yr = load64(v + j * 16);
            var yi = load64(v + j * 16 + 8);
            sr = f64_add(sr, f64_sub(f64_mul(xr, yr), f64_mul(xi, yi)));
            si = f64_add(si, f64_add(f64_mul(xr, yi), f64_mul(xi, yr)));
            j = j + 1;
        }
        store64(out + i * 16, sr);
        store64(out + i * 16 + 8, si);
        i = i + 1;
    }
    return out;
}

# The conjugate transpose m^H, a new cols x rows matrix (exact: entries are moved and
# their imaginary parts negated). 0 when m is 0 or the matrix cannot be allocated.
public fn cmat_adjoint(m) {
    if (m == 0) { return 0; }
    # Conjugate transpose
    var rows = cmat_rows(m);
    var cols = cmat_cols(m);
    var r = cmat_new(cols, rows);
    if (r == 0) { return 0; }
    var i = 0;
    while (i < rows) {
        var j = 0;
        while (j < cols) {
            _cmat_put(r, j, i, _cmat_re(m, i, j), _cmat_im(m, i, j) ^ _CX_SIGN);
            j = j + 1;
        }
        i = i + 1;
    }
    return r;
}

# The trace of a square complex matrix, sum of m[i][i], as a new HComplex (each part a
# plain left-to-right f64 sum, so not compensated). 0 -- not cx_zero(), since zero is a
# valid trace -- when m is 0, when m is not square, or when the result cannot be
# allocated.
# ⛔ 3.4.1 — A NON-SQUARE m WAS READ PAST ITS BUFFER. The loop ran i to rows(m) and read
# m[i][i], which for a tall matrix walks off the end of the data: cmat_new(3, 1) holding
# 1, 2, 3 gave 6 + 0i (the 2.0 past the end was the next heap object), and a 65536 x 1 at
# a heap-chunk edge exited 139. A trace is defined for square matrices only, and
# threat-model.md has claimed a shape guard here since 2.9.0; there is one now.
# [measured: tests/hisab.tcyr, group "3.4.1: cmat_trace refuses a non-square matrix"]
public fn cmat_trace(m) {
    if (m == 0) { return 0; }
    var n = cmat_rows(m);
    if (n != cmat_cols(m)) { return 0; }
    var sr = 0;
    var si = 0;
    var i = 0;
    while (i < n) {
        sr = f64_add(sr, _cmat_re(m, i, i));
        si = f64_add(si, _cmat_im(m, i, i));
        i = i + 1;
    }
    return cx_new(sr, si);
}

# s m for a complex scalar s (an HComplex): every entry times s, cx_mul's form. 0 when m or
# s is 0 or the matrix cannot be allocated.
public fn cmat_scale(m, s) {
    if (m == 0) { return 0; }
    # s may be a refused cx_real / cx_i (3.4.0): HComplex_re(0) is a null read.
    if (s == 0) { return 0; }
    var rows = cmat_rows(m);
    var cols = cmat_cols(m);
    var r = cmat_new(rows, cols);
    if (r == 0) { return 0; }
    var sr = HComplex_re(s);
    var si = HComplex_im(s);
    var i = 0;
    while (i < rows) {
        var j = 0;
        while (j < cols) {
            var xr = _cmat_re(m, i, j);
            var xi = _cmat_im(m, i, j);
            _cmat_put(r, i, j, f64_sub(f64_mul(xr, sr), f64_mul(xi, si)), f64_add(f64_mul(xr, si), f64_mul(xi, sr)));
            j = j + 1;
        }
        i = i + 1;
    }
    return r;
}

# a + b entry by entry, each part one IEEE addition. 0 when a or b is 0, their shapes
# differ, or the matrix cannot be allocated.
public fn cmat_add(a, b) {
    # Either operand may be the designed 0 that cmat_new and cmat_mul return when
    # a dimension cap or conformability check fails; cmat_commutator feeds exactly
    # that in. load64(0) is a null dereference, so guard before reading dims.
    if (a == 0) { return 0; }
    if (b == 0) { return 0; }
    var rows = cmat_rows(a);
    var cols = cmat_cols(a);
    # Elementwise ops are only defined on matching shapes; a smaller b was read
    # out of bounds through 2.6.15.
    if (cmat_rows(b) != rows) { return 0; }
    if (cmat_cols(b) != cols) { return 0; }
    var r = cmat_new(rows, cols);
    if (r == 0) { return 0; }
    var i = 0;
    while (i < rows) {
        var j = 0;
        while (j < cols) {
            _cmat_put(r, i, j, f64_add(_cmat_re(a, i, j), _cmat_re(b, i, j)),
              f64_add(_cmat_im(a, i, j), _cmat_im(b, i, j)));
            j = j + 1;
        }
        i = i + 1;
    }
    return r;
}

# a - b entry by entry, each part one IEEE subtraction. 0 when a or b is 0, their shapes
# differ, or the matrix cannot be allocated.
public fn cmat_sub(a, b) {
    # Either operand may be the designed 0 that cmat_new and cmat_mul return when
    # a dimension cap or conformability check fails; cmat_commutator feeds exactly
    # that in. load64(0) is a null dereference, so guard before reading dims.
    if (a == 0) { return 0; }
    if (b == 0) { return 0; }
    var rows = cmat_rows(a);
    var cols = cmat_cols(a);
    # Elementwise ops are only defined on matching shapes; a smaller b was read
    # out of bounds through 2.6.15.
    if (cmat_rows(b) != rows) { return 0; }
    if (cmat_cols(b) != cols) { return 0; }
    var r = cmat_new(rows, cols);
    if (r == 0) { return 0; }
    var i = 0;
    while (i < rows) {
        var j = 0;
        while (j < cols) {
            _cmat_put(r, i, j, f64_sub(_cmat_re(a, i, j), _cmat_re(b, i, j)),
              f64_sub(_cmat_im(a, i, j), _cmat_im(b, i, j)));
            j = j + 1;
        }
        i = i + 1;
    }
    return r;
}

# Commutator [A, B] = AB - BA
public fn cmat_commutator(a, b) {
    return cmat_sub(cmat_mul(a, b), cmat_mul(b, a));
}

# Anticommutator {A, B} = AB + BA
public fn cmat_anticommutator(a, b) {
    return cmat_add(cmat_mul(a, b), cmat_mul(b, a));
}

# Kronecker (tensor) product
public fn cmat_kronecker(a, b) {
    # Either operand may be the designed 0 that cmat_new and cmat_mul return when
    # a dimension cap or conformability check fails; cmat_rows(0) is a null
    # dereference, so guard before reading dims. Same wording and placement as
    # cmat_add/cmat_sub, which already carried this guard.
    if (a == 0) { return 0; }
    if (b == 0) { return 0; }
    var ar = cmat_rows(a); var ac = cmat_cols(a);
    var br = cmat_rows(b); var bc = cmat_cols(b);
    # The Kronecker product multiplies both dimensions, so two modest operands
    # easily exceed the cap: 16x16 (x) 16x16 asks for 65536 elements.
    var r = cmat_new(ar * br, ac * bc);
    if (r == 0) { return 0; }
    var i = 0;
    while (i < ar) {
        var j = 0;
        while (j < ac) {
            var xr = _cmat_re(a, i, j);
            var xi = _cmat_im(a, i, j);
            var ii = 0;
            while (ii < br) {
                var jj = 0;
                while (jj < bc) {
                    var yr = _cmat_re(b, ii, jj);
                    var yi = _cmat_im(b, ii, jj);
                    _cmat_put(r, i * br + ii, j * bc + jj, f64_sub(f64_mul(xr, yr), f64_mul(xi, yi)),
                      f64_add(f64_mul(xr, yi), f64_mul(xi, yr)));
                    jj = jj + 1;
                }
                ii = ii + 1;
            }
            j = j + 1;
        }
        i = i + 1;
    }
    return r;
}

# Largest scaling-squaring exponent cmat_exp will use. 2^64 ~ 1.8e19 bounds any
# Frobenius norm whose exponential is representable (exp overflows f64 at 709).
var _CMAT_EXP_MAX_SCALING = 64;

# Matrix exponential (Taylor series with scaling-squaring).
# Returns a fresh n x n matrix, or 0 if m is null or not square.
public fn cmat_exp(m) {
    # m may be the designed 0 that cmat_new returns above _CMAT_MAX_ELEMS or that
    # cmat_mul returns on a non-conformable product; cmat_rows(0) is a null
    # dereference, so guard before reading dims. No cap breach is needed to reach
    # here -- cmat_exp(cmat_mul(2x3, 2x2)) is enough, since cmat_mul's own
    # conformability guard hands back the 0.
    if (m == 0) { return 0; }
    var n = cmat_rows(m);
    # exp(M) is only defined for a square M, and the Frobenius-norm loop below
    # indexes cmat_get(m, i, j) for both i and j up to rows-1. On a 3x2 that
    # reads a column that does not exist, past the end of m's data buffer.
    if (n != cmat_cols(m)) { return 0; }
    # Scale: find s such that ||M/2^s|| < 1
    # Simple heuristic: use Frobenius norm
    var fnorm = 0;
    var i = 0;
    while (i < n) {
        var j = 0;
        while (j < n) {
            var er = _cmat_re(m, i, j);
            var ei = _cmat_im(m, i, j);
            fnorm = f64_add(fnorm, f64_add(f64_mul(er, er), f64_mul(ei, ei)));
            j = j + 1;
        }
        i = i + 1;
    }
    fnorm = f64_sqrt(fnorm);
    var s = 0;
    var scaled_norm = fnorm;
    # BOUNDED. Halving does not converge for a non-finite norm: +Inf * 0.5 is
    # still +Inf and still > 1, so through 2.6.15 a single +Inf or overflowing
    # entry anywhere in m hung this loop forever with s incrementing without
    # limit. The cap is not a heuristic -- exp(x) overflows f64 above x = 709,
    # so a scaling parameter beyond _CMAT_EXP_MAX_SCALING cannot describe a
    # representable result, and halting with a NaN matrix is the honest answer
    # for a non-finite input.
    # [measured: CHANGELOG.md 2.7.0, cmat_exp entry: the pre-fix suite did not finish in 110 seconds]
    while (f64_gt(scaled_norm, F64_ONE) == 1) {
        if (s >= _CMAT_EXP_MAX_SCALING) { break; }
        s = s + 1;
        scaled_norm = f64_mul(scaled_norm, F64_HALF);
    }
    # Scale matrix
    # Every intermediate is checked (3.4.0): a refused one is the designed 0 as a whole.
    var scale_factor = cx_real(f64_div(F64_ONE, ganita_f64_pow(F64_TWO, f64_from(s))));
    if (scale_factor == 0) { return 0; }
    var ms = cmat_scale(m, scale_factor);
    if (ms == 0) { return 0; }
    # Taylor: sum = I + M + M^2/2! + M^3/3! + ...
    var result = cmat_identity(n);
    if (result == 0) { return 0; }
    var term = cmat_identity(n);
    if (term == 0) { return 0; }
    var k = 1;
    while (k <= 20) {
        var tm = cmat_mul(term, ms);
        if (tm == 0) { return 0; }
        var fk = cx_real(f64_div(F64_ONE, f64_from(k)));
        if (fk == 0) { return 0; }
        term = cmat_scale(tm, fk);
        if (term == 0) { return 0; }
        result = cmat_add(result, term);
        if (result == 0) { return 0; }
        k = k + 1;
    }
    # Square s times
    i = 0;
    while (i < s) {
        result = cmat_mul(result, result);
        if (result == 0) { return 0; }
        i = i + 1;
    }
    return result;
}

# ================================================================
# Pauli matrices (2x2)
# ================================================================

# sigma_0, the 2 x 2 identity. 0 when it cannot be allocated.
public fn pauli_0() { return cmat_identity(2); }

# sigma_x = [[0, 1], [1, 0]]. 0 when it cannot be allocated.
public fn pauli_x() {
    var m = cmat_new(2, 2);
    if (m == 0) { return 0; }
    _cmat_put(m, 0, 1, F64_ONE, 0);
    _cmat_put(m, 1, 0, F64_ONE, 0);
    return m;
}

# sigma_y = [[0, -i], [i, 0]]. 0 when it cannot be allocated.
public fn pauli_y() {
    var m = cmat_new(2, 2);
    if (m == 0) { return 0; }
    _cmat_put(m, 0, 1, 0, f64_neg(F64_ONE));
    _cmat_put(m, 1, 0, 0, F64_ONE);
    return m;
}

# sigma_z = [[1, 0], [0, -1]]. 0 when it cannot be allocated.
public fn pauli_z() {
    var m = cmat_new(2, 2);
    if (m == 0) { return 0; }
    _cmat_put(m, 0, 0, F64_ONE, 0);
    _cmat_put(m, 1, 1, f64_neg(F64_ONE), 0);
    return m;
}

# ================================================================
# Dirac gamma matrices (4x4)
# ================================================================

# The Dirac matrix gamma^0 = diag(1, 1, -1, -1), Dirac representation. 0 when it cannot be allocated.
public fn gamma_0() {
    # gamma^0 = diag(I, -I) in Dirac representation
    var m = cmat_new(4, 4);
    if (m == 0) { return 0; }
    _cmat_put(m, 0, 0, F64_ONE, 0);
    _cmat_put(m, 1, 1, F64_ONE, 0);
    _cmat_put(m, 2, 2, f64_neg(F64_ONE), 0);
    _cmat_put(m, 3, 3, f64_neg(F64_ONE), 0);
    return m;
}

# The Dirac matrix gamma^k = [[0, sigma_k], [-sigma_k, 0]] for idx = k - 1 (0: sigma_x,
# 1: sigma_y, 2: sigma_z), Dirac representation. An idx outside 0..2 returns the 4 x 4 zero
# matrix, a documented sentinel ([3.5.0]); 0 when a matrix cannot be allocated.
public fn gamma_spatial(idx) {
    # gamma^i = [[0, sigma^i], [-sigma^i, 0]], idx: 0=gamma^1(sigmax), 1=gamma^2(sigmay), 2=gamma^3(sigmaz)
    if (idx < 0 || idx > 2) { return cmat_new(4, 4); }  # Invalid -> zero matrix
    var sigma = 0;
    if (idx == 0) { sigma = pauli_x(); }
    if (idx == 1) { sigma = pauli_y(); }
    if (idx == 2) { sigma = pauli_z(); }
    if (sigma == 0) { return 0; }
    var m = cmat_new(4, 4);
    if (m == 0) { return 0; }
    # Top-right: sigma
    _cmat_put(m, 0, 2, _cmat_re(sigma, 0, 0), _cmat_im(sigma, 0, 0));
    _cmat_put(m, 0, 3, _cmat_re(sigma, 0, 1), _cmat_im(sigma, 0, 1));
    _cmat_put(m, 1, 2, _cmat_re(sigma, 1, 0), _cmat_im(sigma, 1, 0));
    _cmat_put(m, 1, 3, _cmat_re(sigma, 1, 1), _cmat_im(sigma, 1, 1));
    # Bottom-left: -sigma
    _cmat_put(m, 2, 0, _cmat_re(sigma, 0, 0) ^ _CX_SIGN, _cmat_im(sigma, 0, 0) ^ _CX_SIGN);
    _cmat_put(m, 2, 1, _cmat_re(sigma, 0, 1) ^ _CX_SIGN, _cmat_im(sigma, 0, 1) ^ _CX_SIGN);
    _cmat_put(m, 3, 0, _cmat_re(sigma, 1, 0) ^ _CX_SIGN, _cmat_im(sigma, 1, 0) ^ _CX_SIGN);
    _cmat_put(m, 3, 1, _cmat_re(sigma, 1, 1) ^ _CX_SIGN, _cmat_im(sigma, 1, 1) ^ _CX_SIGN);
    return m;
}

# gamma^5 = i gamma^0 gamma^1 gamma^2 gamma^3, exact (every product and sum is of 0, +-1 and
# +-i): [[0, I], [I, 0]]. 0 when an allocation is refused.
public fn gamma_5() {
    # gamma^5 = igamma^0gamma^1gamma^2gamma^3
    var g0 = gamma_0();
    var g1 = gamma_spatial(0);
    var g2 = gamma_spatial(1);
    var g3 = gamma_spatial(2);
    var prod = cmat_mul(cmat_mul(cmat_mul(g0, g1), g2), g3);
    return cmat_scale(prod, cx_i());
}
