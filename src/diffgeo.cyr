# diffgeo.cyr -- differential geometry for curved spacetimes and manifolds
# Usage: shipped inside dist/hisab.cyr; in-tree, include "src/diffgeo.cyr" after what it requires
# Requires: src/error.cyr (stdlib resolves via cyrius.cyml [deps])
#
# Provides:
#   Christoffel symbols, Riemann curvature tensor, Ricci tensor/scalar,
#   Einstein tensor, geodesic RK4 integration, Killing vector residual,
#   exterior algebra (wedge product, Hodge star).
#
# All tensors are stored as flat f64 arrays in heap memory:
#   metric[i*dim+j]
#   christoffel[(a*dim+mu)*dim+nu]
#   riemann[((rho*dim+sigma)*dim+mu)*dim+nu]
# Each element is 8 bytes (f64 bit pattern), accessed via load64/store64.

# ================================================================
# CONSTANTS
# ================================================================

var _DG_F64_SIX = 0x4018_0000_0000_0000;  # 6.0

# Shared dimension cap for every tensor entry point in this module.
# christoffel_symbols and riemann_tensor have capped at 16 and returned 0 above it
# since they were written; the downstream contractions did neither, so they both
# (a) dereferenced that documented 0 error signal and (b) sized their own alloc
# from an unbounded dim. Same class as the 2.6.14 cmat_new / opt_bfgs repairs
# (CWE-190 -> CWE-476).
# ⛔ "Every entry point" was not true until 3.3.1. sectional_curvature and
# geodesic_deviation checked neither dim nor a pointer, christoffel_symbols and
# riemann_tensor hard-coded the 16 and read null inputs, and hodge_star_2form_4d,
# wedge_2_1 and wedge_3_1 read null inputs: each null case exited 139, and so did
# sectional_curvature at dim = 1e5. Invalid input now returns the module's
# designed 0, as every other entry point here already did.
# [measured: scratch harness, not reproducible in-tree, 2026-09-30; cycc 6.6.12]
var _DG_MAX_DIM = 16;

# ================================================================
# INTERNAL HELPERS
# ================================================================

# Flat-index helpers for tensors stored in heap memory.
# All return byte offsets suitable for load64/store64.

# Index into a dim*dim matrix: offset = (i*dim + j) * 8
fn _dg_idx2(i, j, dim) {
    return (i * dim + j) * 8;
}

# Index into a dim*dim*dim rank-3 tensor: offset = ((a*dim + b)*dim + c) * 8
fn _dg_idx3(a, b, c, dim) {
    return ((a * dim + b) * dim + c) * 8;
}

# Index into a dim^4 rank-4 tensor: offset = (((a*dim + b)*dim + c)*dim + d) * 8
fn _dg_idx4(a, b, c, d, dim) {
    return (((a * dim + b) * dim + c) * dim + d) * 8;
}

# ================================================================
# 1. CHRISTOFFEL SYMBOLS  Gamma^a_{mu nu}
# ================================================================
# Gamma^a_{mu nu} = 1/2 g^{a lambda} (d_mu g_{nu lambda}
#                                     + d_nu g_{mu lambda}
#                                     - d_lambda g_{mu nu})
#
# metric_inv: flat f64 array (dim*dim) -- g^{ij}
# metric_deriv: flat f64 array (dim*dim*dim) -- d_k g_{ij}
#   indexed as metric_deriv[(i*dim + j)*dim + k] = partial_k g_{ij}
# Returns: pointer to allocated flat f64 array of dim^3 elements, or the designed 0 for a
#   null pointer, a dim outside 1..16 or a refused allocation.
#
# NOTE for anyone adding a fixture: an all-zero metric_deriv makes the bracket
# below identically zero, so the lambda contraction, the three derivative
# permutations, the sign on d3 and the 1/2 are all unreachable and the function
# is indistinguishable from `return zeros`. Both call sites did exactly that
# until 2.8.3. tests/modules.tcyr now pins the unit 2-sphere at th = pi/3
# (closed form) and a generic dyadic 2-metric (bit-exact, exact-rational
# reference) -- keep any new fixture non-flat.

public fn christoffel_symbols(metric_inv, metric_deriv, dim) {
    if (dim <= 0 || dim > _DG_MAX_DIM) { return 0; }  # 16^3 = 4096 slots at the cap
    if (metric_inv == 0 || metric_deriv == 0) { return 0; }
    var n3 = dim * dim * dim;
    var out = alloc(n3 * 8);
    if (out == 0) { return 0; }

    var alpha = 0;
    while (alpha < dim) {
        var mu = 0;
        while (mu < dim) {
            var nu = 0;
            while (nu < dim) {
                var sum = 0;  # f64 0.0
                var lambda = 0;
                while (lambda < dim) {
                    # g^{alpha, lambda}
                    var g_al = load64(metric_inv + _dg_idx2(alpha, lambda, dim));

                    # d_mu g_{nu lambda}
                    var d1 = load64(metric_deriv + _dg_idx3(nu, lambda, mu, dim));
                    # d_nu g_{mu lambda}
                    var d2 = load64(metric_deriv + _dg_idx3(mu, lambda, nu, dim));
                    # d_lambda g_{mu nu}
                    var d3 = load64(metric_deriv + _dg_idx3(mu, nu, lambda, dim));

                    # bracket = d1 + d2 - d3
                    var bracket = f64_sub(f64_add(d1, d2), d3);
                    sum = f64_add(sum, f64_mul(g_al, bracket));

                    lambda = lambda + 1;
                }
                # Gamma^a_{mu nu} = 0.5 * sum
                store64(out + _dg_idx3(alpha, mu, nu, dim), f64_mul(F64_HALF, sum));

                nu = nu + 1;
            }
            mu = mu + 1;
        }
        alpha = alpha + 1;
    }
    return out;
}

# Get Gamma^a_{mu nu} from a Christoffel array
public fn christoffel_get(christoffel, dim, a, mu, nu) {
    return load64(christoffel + _dg_idx3(a, mu, nu, dim));
}

# ================================================================
# 2. RIEMANN CURVATURE TENSOR  R^rho_{sigma mu nu}
# ================================================================
# R^rho_{sigma mu nu} = d_mu Gamma^rho_{nu sigma}
#                      - d_nu Gamma^rho_{mu sigma}
#                      + Gamma^rho_{mu lambda} Gamma^lambda_{nu sigma}
#                      - Gamma^rho_{nu lambda} Gamma^lambda_{mu sigma}
#
# christoffel: flat f64 array (dim^3) -- Gamma^a_{mu nu}
# christoffel_deriv: flat f64 array (dim^4) -- d_k Gamma^a_{mu nu}
#   indexed as christoffel_deriv[(((a*dim + mu)*dim + nu)*dim + k)] = d_k Gamma^a_{mu nu}
# Returns: pointer to allocated flat f64 array of dim^4 elements, or the designed 0 for a
#   null pointer, a dim outside 1..16 or a refused allocation.

public fn riemann_tensor(christoffel, christoffel_deriv, dim) {
    if (dim <= 0 || dim > _DG_MAX_DIM) { return 0; }  # 16^4 = 65536 slots at the cap
    if (christoffel == 0 || christoffel_deriv == 0) { return 0; }
    var n4 = dim * dim * dim * dim;
    var out = alloc(n4 * 8);
    if (out == 0) { return 0; }
    var d2 = dim * dim;

    var rho = 0;
    while (rho < dim) {
        var sigma = 0;
        while (sigma < dim) {
            var mu = 0;
            while (mu < dim) {
                var nu = 0;
                while (nu < dim) {
                    # d_mu Gamma^rho_{nu sigma}
                    var dg1 = load64(christoffel_deriv + _dg_idx4(rho, nu, sigma, mu, dim));
                    # d_nu Gamma^rho_{mu sigma}
                    var dg2 = load64(christoffel_deriv + _dg_idx4(rho, mu, sigma, nu, dim));

                    var val = f64_sub(dg1, dg2);

                    # Sum over lambda:
                    # + Gamma^rho_{mu lambda} * Gamma^lambda_{nu sigma}
                    # - Gamma^rho_{nu lambda} * Gamma^lambda_{mu sigma}
                    var lambda = 0;
                    while (lambda < dim) {
                        var g_rml = load64(christoffel + _dg_idx3(rho, mu, lambda, dim));
                        var g_lns = load64(christoffel + _dg_idx3(lambda, nu, sigma, dim));
                        var g_rnl = load64(christoffel + _dg_idx3(rho, nu, lambda, dim));
                        var g_lms = load64(christoffel + _dg_idx3(lambda, mu, sigma, dim));

                        val = f64_add(val, f64_sub(f64_mul(g_rml, g_lns),
                            f64_mul(g_rnl, g_lms)));
                        lambda = lambda + 1;
                    }

                    store64(out + _dg_idx4(rho, sigma, mu, nu, dim), val);

                    nu = nu + 1;
                }
                mu = mu + 1;
            }
            sigma = sigma + 1;
        }
        rho = rho + 1;
    }
    return out;
}

# Get R^rho_{sigma mu nu} from a Riemann array
public fn riemann_get(riemann, dim, rho, sigma, mu, nu) {
    return load64(riemann + _dg_idx4(rho, sigma, mu, nu, dim));
}

# ================================================================
# 3. RICCI TENSOR  R_{mu nu}
# ================================================================
# R_{mu nu} = R^lambda_{mu lambda nu}   (contract 1st and 3rd indices)
#
# riemann: flat f64 array (dim^4)
# Returns: pointer to allocated flat f64 array of dim^2 elements, or the designed 0 for a
#   null pointer, a dim outside 1..16 or a refused allocation.

public fn ricci_tensor(riemann, dim) {
    if (dim <= 0 || dim > _DG_MAX_DIM) { return 0; }
    if (riemann == 0) { return 0; }
    var n2 = dim * dim;
    var out = alloc(n2 * 8);
    if (out == 0) { return 0; }

    var mu = 0;
    while (mu < dim) {
        var nu = 0;
        while (nu < dim) {
            var sum = 0;  # f64 0.0
            var lambda = 0;
            while (lambda < dim) {
                # R^lambda_{mu lambda nu}
                sum = f64_add(sum, load64(riemann + _dg_idx4(lambda, mu, lambda, nu, dim)));
                lambda = lambda + 1;
            }
            store64(out + _dg_idx2(mu, nu, dim), sum);
            nu = nu + 1;
        }
        mu = mu + 1;
    }
    return out;
}

# Get R_{mu nu} from a Ricci tensor array
public fn ricci_get(ricci, dim, mu, nu) {
    return load64(ricci + _dg_idx2(mu, nu, dim));
}

# ================================================================
# 4. RICCI SCALAR  R = g^{mu nu} R_{mu nu}
# ================================================================
# ricci: R_{mu nu} (flat dim^2); metric_inv: g^{mu nu} (flat dim^2). Returns the scalar
# as f64, summed in index order; the designed 0 for a null pointer or a dim outside 1..16.

public fn ricci_scalar(ricci, metric_inv, dim) {
    if (dim <= 0 || dim > _DG_MAX_DIM) { return 0; }
    if (ricci == 0 || metric_inv == 0) { return 0; }
    var scalar = 0;  # f64 0.0
    var mu = 0;
    while (mu < dim) {
        var nu = 0;
        while (nu < dim) {
            var g_mn = load64(metric_inv + _dg_idx2(mu, nu, dim));
            var r_mn = load64(ricci + _dg_idx2(mu, nu, dim));
            scalar = f64_add(scalar, f64_mul(g_mn, r_mn));
            nu = nu + 1;
        }
        mu = mu + 1;
    }
    return scalar;
}

# ================================================================
# 5. EINSTEIN TENSOR  G_{mu nu} = R_{mu nu} - 1/2 R g_{mu nu}
# ================================================================
# ricci: R_{mu nu}; metric: g_{mu nu}; metric_inv: g^{mu nu} (each flat dim^2). Returns a
# fresh flat dim^2 array, or the designed 0 for a null pointer, a dim outside 1..16 or a
# refused allocation.

public fn einstein_tensor(ricci, metric, metric_inv, dim) {
    if (dim <= 0 || dim > _DG_MAX_DIM) { return 0; }
    if (ricci == 0 || metric == 0 || metric_inv == 0) { return 0; }
    var r = ricci_scalar(ricci, metric_inv, dim);
    var half_r = f64_mul(F64_HALF, r);

    var n2 = dim * dim;
    var out = alloc(n2 * 8);
    if (out == 0) { return 0; }

    var mu = 0;
    while (mu < dim) {
        var nu = 0;
        while (nu < dim) {
            var r_mn = load64(ricci + _dg_idx2(mu, nu, dim));
            var g_mn = load64(metric + _dg_idx2(mu, nu, dim));
            # G_{mu nu} = R_{mu nu} - (R/2) * g_{mu nu}
            store64(out + _dg_idx2(mu, nu, dim),
              f64_sub(r_mn, f64_mul(half_r, g_mn)));
            nu = nu + 1;
        }
        mu = mu + 1;
    }
    return out;
}

# Metric inner product ⟨a,b⟩ = g_{ij} a^i b^j. (sectional_curvature stopped using it in
# 3.4.1; tests/hisab.tcyr's parallel-transport check still measures lengths with it.)
fn _dg_inner(metric, a, b, dim) {
    var sum = 0;
    var i = 0;
    while (i < dim) {
        var j = 0;
        while (j < dim) {
            var g = load64(metric + _dg_idx2(i, j, dim));
            sum = f64_add(sum, f64_mul(f64_mul(g, load64(a + i * 8)), load64(b + j * 8)));
            j = j + 1;
        }
        i = i + 1;
    }
    return sum;
}

# The exponent e of a finite nonzero x, x in [2^e, 2^(e+1)), subnormals included.
fn _dg_exp2(x) {
    var b = (x >> 52) & 0x7FF;
    if (b != 0) { return b - 1023; }
    var m = x & 0xFFFFFFFFFFFFF;
    var p = 0;
    while (m > 1) { m = m >> 1; p = p + 1; }
    return p - 1074;
}

# x * 2^k, in exact steps of 2^+-1000 and one last that may round (k any i64 in range).
fn _dg_ldexp(x, k) {
    while (k > 1000) { x = f64_mul(x, (1023 + 1000) << 52); k = k - 1000; }
    while (k < 0 - 1000) { x = f64_mul(x, (1023 - 1000) << 52); k = k + 1000; }
    return f64_mul(x, (1023 + k) << 52);
}

# -e for the largest |entry| of n f64s at p (so that p * 2^-e has its largest in [1, 2)),
# or 0 when that largest is 0 or not finite (no scaling; the zero or the NaN / Inf then
# answers for itself). A NaN entry is skipped here and propagates through the arithmetic.
fn _dg_unit_shift(p, n) {
    var mx = 0;
    var i = 0;
    while (i < n) {
        var a = f64_abs(load64(p + i * 8));
        if (f64_gt(a, mx) == 1) { mx = a; }
        i = i + 1;
    }
    if (f64_gt(mx, 0) == 0 || f64_lt(mx, F64_POS_INF) == 0) { return 0; }
    return 0 - _dg_exp2(mx);
}

# u^a v^s - u^s v^a with both products exact (Dekker's two-product, |entries| < 2^995) and
# their difference carried: within an ulp or two of the exact determinant.
fn _dg_det2(a, b, c, d) {
    var sa = f64_mul(a, 0x41A0_0000_0200_0000);   # 2^27 + 1
    var ah = f64_sub(sa, f64_sub(sa, a)); var al = f64_sub(a, ah);
    var sb = f64_mul(b, 0x41A0_0000_0200_0000);
    var bh = f64_sub(sb, f64_sub(sb, b)); var bl = f64_sub(b, bh);
    var sc = f64_mul(c, 0x41A0_0000_0200_0000);
    var ch = f64_sub(sc, f64_sub(sc, c)); var cl = f64_sub(c, ch);
    var sd = f64_mul(d, 0x41A0_0000_0200_0000);
    var dh = f64_sub(sd, f64_sub(sd, d)); var dl = f64_sub(d, dh);
    var p = f64_mul(a, b);
    var pe = f64_add(f64_add(f64_add(f64_sub(f64_mul(ah, bh), p), f64_mul(ah, bl)), f64_mul(al, bh)),
      f64_mul(al, bl));
    var q = f64_mul(c, d);
    var qe = f64_add(f64_add(f64_add(f64_sub(f64_mul(ch, dh), q), f64_mul(ch, dl)), f64_mul(cl, dh)),
      f64_mul(cl, dl));
    return f64_add(f64_sub(p, q), f64_sub(pe, qe));
}

# ================================================================
# 5b. SECTIONAL CURVATURE  K(u,v)
# ================================================================
# K(u,v) = R(u,v,v,u) / (⟨u,u⟩⟨v,v⟩ − ⟨u,v⟩²)
# with R(u,v,v,u) = R_{ασμν} u^α v^σ u^μ v^ν and the first Riemann index lowered
# by the metric: R_{ασμν} = g_{αρ} R^ρ_{σμν}. Positive for a sphere (verified
# against hisab's Riemann convention at the equator: R^θ_{φθφ} = +1).
#
# riemann: (1,3) tensor R^ρ_{σμν} (flat dim⁴, from riemann_tensor)
# metric:  covariant g_{ij} (flat dim², for the index lowering + inner products)
# u, v:    contravariant vectors (flat dim)
# Returns: the sectional curvature, a function of the plane u∧v alone; 0 for a
#   degenerate plane: u ∥ v exactly (u∧v = 0, the zero vector included), or a plane the
#   metric is null on (|u∧v|² = 0, possible only in indefinite signature). NaN in an input
#   it reads propagates. The designed 0 also answers a null pointer or a dim outside 1..16.
# Accuracy (3.4.1): u∧v is formed componentwise to an ulp or two, so planes any angle
#   apart are answered; the result is backward stable (the rounding of R's and g's
#   contractions, a few ulp of their terms), and range-free in every input: u, v, u∧v, g
#   and R are each scaled by a power of two before anything is squared.
public fn sectional_curvature(riemann, metric, u, v, dim) {
    if (dim <= 0 || dim > _DG_MAX_DIM) { return 0; }
    if (riemann == 0 || metric == 0 || u == 0 || v == 0) { return 0; }
    # ⛔ 3.4.0 AND EARLIER — THE PLANE'S AREA WAS FORMED AS <u,u><v,v> - <u,v>^2, and
    # the numerator as the four-fold sum over u^a v^s u^m v^n, both of which cancel to
    # sin^2(angle) of their terms: planes 1e-6 rad apart read sin^2 < 1e-12, which the
    # degeneracy test then called a degenerate plane, and the answer was 0, "flat"
    # (exact 1). And both are degree four in u and v and two in g: spanning vectors at
    # 2^-256 gave 0 (an absolute DBL_MIN backstop on the area), at 2^256 NaN, and the
    # metric 2^-600 I gave 0, exact 2^600.
    # [measured: tests/abuse.tcyr "3.4.1: sectional_curvature", baseline 3.4.0]
    # ⭐ 3.4.1 — on the bivector B = u∧v, B^{as} = u^a v^s - u^s v^a, formed exactly enough
    # (_dg_det2) that it keeps the angle to the last bits, with K = R(B, B) / |B|^2:
    #   R(B, B) = 1/4 sum R_{asmn} B^{as} B^{mn},  |B|^2 = 1/2 sum g_am g_sn B^{as} B^{mn}
    # (the old two quantities exactly, for a curvature tensor and a symmetric g; for a
    # tensor with a rounding-level symmetric part in (a, s) or (m, n), its projection onto
    # the antisymmetric part, which is the part a plane can see). u, v, B, g and R are each
    # scaled by a power of two (exact) to put their largest entry in [1, 2): K does not see
    # the scale of u, v or B, and R's and g's come back as one power of two at the end.
    # u∧v = 0 exactly gives |B|^2 = 0, the degenerate plane, as does a null plane; both
    # return 0 at the one test below.
    # Contracting R with B first is O(dim^4), where the old loop was O(dim^5).
    var nb = dim * dim;
    var uh: i64[16];
    var vh: i64[16];
    var su = _dg_unit_shift(u, dim);
    var sv = _dg_unit_shift(v, dim);
    var i = 0;
    while (i < dim) {
        store64(&uh + i * 8, _dg_ldexp(load64(u + i * 8), su));
        store64(&vh + i * 8, _dg_ldexp(load64(v + i * 8), sv));
        i = i + 1;
    }
    # B, full and antisymmetric, row-major dim x dim.
    var bf: i64[256];
    var a = 0;
    while (a < dim) {
        store64(&bf + _dg_idx2(a, a, dim), 0);
        var s = a + 1;
        while (s < dim) {
            var bv = _dg_det2(load64(&uh + a * 8), load64(&vh + s * 8), load64(&uh + s * 8), load64(&vh + a * 8));
            store64(&bf + _dg_idx2(a, s, dim), bv);
            store64(&bf + _dg_idx2(s, a, dim), f64_neg(bv));
            s = s + 1;
        }
        a = a + 1;
    }
    var sb = _dg_unit_shift(&bf, nb);
    var sg = _dg_unit_shift(metric, nb);
    var sr = _dg_unit_shift(riemann, nb * nb);
    i = 0;
    while (i < nb) { store64(&bf + i * 8, _dg_ldexp(load64(&bf + i * 8), sb)); i = i + 1; }
    # T^rho_s = sum_mn Rh^rho_{s m n} B^{mn}, then L_as = sum_rho gh_{a rho} T^rho_s.
    var tt: i64[256];
    var rho = 0;
    while (rho < dim) {
        var s2 = 0;
        while (s2 < dim) {
            var acc = 0;
            var m = 0;
            while (m < dim) {
                var n = 0;
                while (n < dim) {
                    if (m != n) {
                        var rv = _dg_ldexp(riemann_get(riemann, dim, rho, s2, m, n), sr);
                        acc = f64_add(acc, f64_mul(rv, load64(&bf + _dg_idx2(m, n, dim))));
                    }
                    n = n + 1;
                }
                m = m + 1;
            }
            store64(&tt + _dg_idx2(rho, s2, dim), acc);
            s2 = s2 + 1;
        }
        rho = rho + 1;
    }
    var ll: i64[256];
    var gb: i64[256];
    a = 0;
    while (a < dim) {
        var c = 0;
        while (c < dim) {
            var lacc = 0;
            var gacc = 0;
            var k = 0;
            while (k < dim) {
                var gak = _dg_ldexp(load64(metric + _dg_idx2(a, k, dim)), sg);
                lacc = f64_add(lacc, f64_mul(gak, load64(&tt + _dg_idx2(k, c, dim))));
                gacc = f64_add(gacc, f64_mul(gak, load64(&bf + _dg_idx2(k, c, dim))));
                k = k + 1;
            }
            store64(&ll + _dg_idx2(a, c, dim), lacc);
            store64(&gb + _dg_idx2(a, c, dim), gacc);
            c = c + 1;
        }
        a = a + 1;
    }
    # num = sum_{a<s} B^{as} (L_as - L_sa);  den = sum_{a<s} B^{as} (C_as - C_sa), with
    # C = (g B) g^T. K = (num / 2) / den: 1/4 and 1/2 of the full sums above.
    var num = 0;
    var den = 0;
    a = 0;
    while (a < dim) {
        var s3 = a + 1;
        while (s3 < dim) {
            var bas = load64(&bf + _dg_idx2(a, s3, dim));
            var cas = 0;
            var csa = 0;
            var k2 = 0;
            while (k2 < dim) {
                cas = f64_add(cas, f64_mul(load64(&gb + _dg_idx2(a, k2, dim)),
                    _dg_ldexp(load64(metric + _dg_idx2(s3, k2, dim)), sg)));
                csa = f64_add(csa, f64_mul(load64(&gb + _dg_idx2(s3, k2, dim)),
                    _dg_ldexp(load64(metric + _dg_idx2(a, k2, dim)), sg)));
                k2 = k2 + 1;
            }
            num = f64_add(num, f64_mul(bas, f64_sub(load64(&ll + _dg_idx2(a, s3, dim)),
                  load64(&ll + _dg_idx2(s3, a, dim)))));
            den = f64_add(den, f64_mul(bas, f64_sub(cas, csa)));
            s3 = s3 + 1;
        }
        a = a + 1;
    }
    if (f64_eq(den, 0) == 1) { return 0; }   # u ∥ v, or a null plane
    # K = Kh * 2^(sg - sr): Rh = R 2^sr and gh = g 2^sg make num scale as 2^(sg + sr) and
    # den as 2^(2 sg).
    return _dg_ldexp(f64_div(f64_mul(num, F64_HALF), den), sg - sr);
}

# ================================================================
# 5c. WEYL CONFORMAL-CURVATURE TENSOR  C_{ρσμν}
# ================================================================
# The fully trace-free part of Riemann (the conformally-invariant curvature):
#   C_{ρσμν} = R_{ρσμν}
#            − 1/(n−2) (g_{ρμ}R_{σν} − g_{ρν}R_{σμ} − g_{σμ}R_{ρν} + g_{σν}R_{ρμ})
#            + R/((n−1)(n−2)) (g_{ρμ}g_{σν} − g_{ρν}g_{σμ})
# with R_{ρσμν} = g_{ρλ} R^λ_{σμν}. Defined for n ≥ 3; vanishes identically for
# n ≤ 3 and for any conformally-flat metric (e.g. constant-curvature space forms,
# where Riemann ≠ 0 but C = 0).
#
# riemann: (1,3) R^ρ_{σμν} (flat dim⁴);  ricci: R_{μν} (flat dim²);
# scalar: Ricci scalar R;  metric: covariant g_{ij} (flat dim²).
# Returns: covariant C_{ρσμν} (flat dim⁴); all-zero when dim < 3.
public fn weyl_tensor(riemann, ricci, scalar, metric, dim) {
    if (dim <= 0 || dim > _DG_MAX_DIM) { return 0; }
    if (riemann == 0 || ricci == 0 || metric == 0) { return 0; }
    var n4 = dim * dim * dim * dim;
    var out = alloc(n4 * 8);
    if (out == 0) { return 0; }
    var zi = 0;
    while (zi < n4) { store64(out + zi * 8, 0); zi = zi + 1; }
    if (dim < 3) { return out; }  # Weyl undefined / identically zero for n ≤ 2

    var c1 = f64_div(F64_ONE, f64_from(dim - 2));
    var c2 = f64_div(scalar, f64_from((dim - 1) * (dim - 2)));

    var rho = 0;
    while (rho < dim) {
        var sigma = 0;
        while (sigma < dim) {
            var mu = 0;
            while (mu < dim) {
                var nu = 0;
                while (nu < dim) {
                    # Lowered Riemann R_{rho sigma mu nu} = g_{rho lambda} R^lambda_{sigma mu nu}
                    var rcov = 0;
                    var lam = 0;
                    while (lam < dim) {
                        rcov = f64_add(rcov, f64_mul(load64(metric + _dg_idx2(rho, lam, dim)),
                            riemann_get(riemann, dim, lam, sigma, mu, nu)));
                        lam = lam + 1;
                    }
                    var g_rm = load64(metric + _dg_idx2(rho, mu, dim));
                    var g_rn = load64(metric + _dg_idx2(rho, nu, dim));
                    var g_sm = load64(metric + _dg_idx2(sigma, mu, dim));
                    var g_sn = load64(metric + _dg_idx2(sigma, nu, dim));
                    var r_sn = load64(ricci + _dg_idx2(sigma, nu, dim));
                    var r_sm = load64(ricci + _dg_idx2(sigma, mu, dim));
                    var r_rn = load64(ricci + _dg_idx2(rho, nu, dim));
                    var r_rm = load64(ricci + _dg_idx2(rho, mu, dim));
                    # Ricci term: c1 (g_rm R_sn − g_rn R_sm − g_sm R_rn + g_sn R_rm)
                    var rt = f64_sub(f64_mul(g_rm, r_sn), f64_mul(g_rn, r_sm));
                    rt = f64_sub(rt, f64_mul(g_sm, r_rn));
                    rt = f64_add(rt, f64_mul(g_sn, r_rm));
                    rt = f64_mul(c1, rt);
                    # Scalar term: c2 (g_rm g_sn − g_rn g_sm)
                    var st = f64_mul(c2, f64_sub(f64_mul(g_rm, g_sn), f64_mul(g_rn, g_sm)));
                    store64(out + _dg_idx4(rho, sigma, mu, nu, dim), f64_add(f64_sub(rcov, rt), st));
                    nu = nu + 1;
                }
                mu = mu + 1;
            }
            sigma = sigma + 1;
        }
        rho = rho + 1;
    }
    return out;
}

# Get C_{rho sigma mu nu} from a Weyl array
public fn weyl_get(weyl, dim, rho, sigma, mu, nu) {
    return load64(weyl + _dg_idx4(rho, sigma, mu, nu, dim));
}

# ================================================================
# 5d. GEODESIC DEVIATION  (Jacobi equation)
# ================================================================
# The tidal acceleration of a separation field J between neighbouring geodesics
# with tangent u:
#   D²J^ρ/dτ² = −R^ρ_{σμν} u^σ J^μ u^ν
# (hisab's Riemann is antisymmetric in its last two indices, so the J and the
# second u sit in that pair — the contraction is nonzero.) For a space form this
# evaluates to −(|u|² J − ⟨u,J⟩ u): on a unit-speed geodesic of a unit sphere a
# separation orthogonal to u obeys J'' = −J (geodesics converge), while a
# separation parallel to u gives 0.
#
# riemann: (1,3) R^ρ_{σμν} (flat dim⁴);  u: geodesic tangent (flat dim);
# jac: separation field J (flat dim). Returns the acceleration A^ρ (new alloc).
public fn geodesic_deviation(riemann, u, jac, dim) {
    if (dim <= 0 || dim > _DG_MAX_DIM) { return 0; }
    if (riemann == 0 || u == 0 || jac == 0) { return 0; }
    var out = alloc(dim * 8);
    if (out == 0) { return 0; }
    var rho = 0;
    while (rho < dim) {
        var acc = 0;
        var sigma = 0;
        while (sigma < dim) {
            var u_s = load64(u + sigma * 8);
            var mu = 0;
            while (mu < dim) {
                var j_m = load64(jac + mu * 8);
                var nu = 0;
                while (nu < dim) {
                    var r = riemann_get(riemann, dim, rho, sigma, mu, nu);
                    acc = f64_add(acc, f64_mul(f64_mul(r, u_s), f64_mul(j_m, load64(u + nu * 8))));
                    nu = nu + 1;
                }
                mu = mu + 1;
            }
            sigma = sigma + 1;
        }
        store64(out + rho * 8, f64_neg(acc));
        rho = rho + 1;
    }
    return out;
}

# ================================================================
# 6. GEODESIC SOLVER -- RK4 integration
# ================================================================
# Geodesic equation:
#   d^2 x^a / dtau^2 + Gamma^a_{mu nu} (dx^mu/dtau)(dx^nu/dtau) = 0
#
# State: flat f64 array of 2*dim elements.
#   [0..dim-1] = position x^mu
#   [dim..2*dim-1] = velocity dx^mu/dtau

# Create a new geodesic state from position and velocity arrays
# pos, vel: pointers to f64 arrays of length dim
# Returns: pointer to allocated flat f64 array of 2*dim elements
public fn geodesic_state_new(pos, vel, dim) {
    if (dim <= 0 || dim > _DG_MAX_DIM) { return 0; }
    if (pos == 0 || vel == 0) { return 0; }
    var state = alloc(dim * 2 * 8);
    if (state == 0) { return 0; }
    var i = 0;
    while (i < dim) {
        store64(state + i * 8, load64(pos + i * 8));
        store64(state + (dim + i) * 8, load64(vel + i * 8));
        i = i + 1;
    }
    return state;
}

# Compute geodesic acceleration: a^alpha = -Gamma^alpha_{mu nu} u^mu u^nu
# vel_ptr: pointer to the dim velocity components. There is no position argument:
#   Γ is the one array passed in, not a function of position (see geodesic_rk4).
#   (Through 3.3.2 this took a `pos_ptr` first and never read it.)
# christoffel: flat f64 Christoffel array (dim^3)
# out_acc: pointer to write dim f64 acceleration values
fn _geodesic_accel(vel_ptr, christoffel, dim, out_acc) {
    var alpha = 0;
    while (alpha < dim) {
        var sum = 0;  # f64 0.0
        var mu = 0;
        while (mu < dim) {
            var u_mu = load64(vel_ptr + mu * 8);
            var nu = 0;
            while (nu < dim) {
                var u_nu = load64(vel_ptr + nu * 8);
                var gamma_val = load64(christoffel + _dg_idx3(alpha, mu, nu, dim));
                sum = f64_add(sum, f64_mul(gamma_val, f64_mul(u_mu, u_nu)));
                nu = nu + 1;
            }
            mu = mu + 1;
        }
        store64(out_acc + alpha * 8, f64_neg(sum));
        alpha = alpha + 1;
    }
    return 0;
}

# RK4 integration of the geodesic equation.
# ⚠ The connection is FROZEN: the one `christoffel` array is used at every RK4
# stage of every step, for the whole `steps * dt` path, and `_geodesic_accel`
# takes no position. So the RK4 stages need no stage POSITION either: x' = u, and
# each kNx is dt times that stage's velocity. (Through 3.3.2 the k2..k4 stages also
# built a stage position, x + k/2 and x + k3, in a `tmp_x` array that only
# `_geodesic_accel`'s unread `pos_ptr` received; both are gone, with no change to
# any result: 200 random calls, dims 1-4, gave the same 1000 output words, bit for bit.)
# [measured: scratch differential probe, 3.3.2 bundle vs 3.3.3, 2026-10-01; cycc 6.6.12]
# The frozen Γ is the true one only where Γ really is
# constant along the trajectory (flat space in Cartesian coordinates, where it is
# zero, or a geodesic along a sphere's equator); wherever Γ varies along the path
# (any curved metric off such a curve, and flat space in curvilinear coordinates
# such as polar) it is an approximation that degrades as Γ varies, on top of RK4's
# own truncation error. `parallel_transport` below uses the same convention. A
# variant taking a position-dependent connection is demand-gated: roadmap
# "3.x.x — demand-gated", audit D092.
# state: pointer to geodesic state (2*dim f64 values)
# christoffel: flat f64 Christoffel array (dim^3), evaluated at one point
# dt: f64 proper time step
# steps: integer number of steps
# Returns: pointer to new state after integration (2*dim f64 values)
public fn geodesic_rk4(state, christoffel, dim, dt, steps) {
    if (dim <= 0 || dim > _DG_MAX_DIM) { return 0; }
    if (state == 0 || christoffel == 0) { return 0; }
    # Working arrays: current position and velocity
    var x = alloc(dim * 8);
    var u = alloc(dim * 8);
    if (x == 0 || u == 0) { return 0; }
    var i = 0;
    while (i < dim) {
        store64(x + i * 8, load64(state + i * 8));
        store64(u + i * 8, load64(state + (dim + i) * 8));
        i = i + 1;
    }

    # Temporary arrays for RK4 stages
    var k1x = alloc(dim * 8);
    var k1u = alloc(dim * 8);
    var k2x = alloc(dim * 8);
    var k2u = alloc(dim * 8);
    var k3x = alloc(dim * 8);
    var k3u = alloc(dim * 8);
    var k4x = alloc(dim * 8);
    var k4u = alloc(dim * 8);
    var tmp_u = alloc(dim * 8);
    var tmp_acc = alloc(dim * 8);
    if (k1x == 0 || k1u == 0 || k2x == 0 || k2u == 0 || k3x == 0) { return 0; }
    if (k3u == 0 || k4x == 0 || k4u == 0 || tmp_u == 0 || tmp_acc == 0) { return 0; }

    var step = 0;
    while (step < steps) {
        # ---- k1 ----
        # k1x = dt * u
        # k1u = dt * accel(u)
        _geodesic_accel(u, christoffel, dim, tmp_acc);
        i = 0;
        while (i < dim) {
            store64(k1x + i * 8, f64_mul(dt, load64(u + i * 8)));
            store64(k1u + i * 8, f64_mul(dt, load64(tmp_acc + i * 8)));
            i = i + 1;
        }

        # ---- k2 ----
        # tmp_u = u + 0.5 * k1u
        i = 0;
        while (i < dim) {
            store64(tmp_u + i * 8, f64_add(load64(u + i * 8),
                f64_mul(F64_HALF, load64(k1u + i * 8))));
            i = i + 1;
        }
        _geodesic_accel(tmp_u, christoffel, dim, tmp_acc);
        i = 0;
        while (i < dim) {
            store64(k2x + i * 8, f64_mul(dt, load64(tmp_u + i * 8)));
            store64(k2u + i * 8, f64_mul(dt, load64(tmp_acc + i * 8)));
            i = i + 1;
        }

        # ---- k3 ----
        # tmp_u = u + 0.5 * k2u
        i = 0;
        while (i < dim) {
            store64(tmp_u + i * 8, f64_add(load64(u + i * 8),
                f64_mul(F64_HALF, load64(k2u + i * 8))));
            i = i + 1;
        }
        _geodesic_accel(tmp_u, christoffel, dim, tmp_acc);
        i = 0;
        while (i < dim) {
            store64(k3x + i * 8, f64_mul(dt, load64(tmp_u + i * 8)));
            store64(k3u + i * 8, f64_mul(dt, load64(tmp_acc + i * 8)));
            i = i + 1;
        }

        # ---- k4 ----
        # tmp_u = u + k3u
        i = 0;
        while (i < dim) {
            store64(tmp_u + i * 8, f64_add(load64(u + i * 8), load64(k3u + i * 8)));
            i = i + 1;
        }
        _geodesic_accel(tmp_u, christoffel, dim, tmp_acc);
        i = 0;
        while (i < dim) {
            store64(k4x + i * 8, f64_mul(dt, load64(tmp_u + i * 8)));
            store64(k4u + i * 8, f64_mul(dt, load64(tmp_acc + i * 8)));
            i = i + 1;
        }

        # ---- Update: x += (k1 + 2*k2 + 2*k3 + k4) / 6 ----
        i = 0;
        while (i < dim) {
            var dx = f64_div(
              f64_add(f64_add(load64(k1x + i * 8),
                  f64_mul(F64_TWO, load64(k2x + i * 8))),
                f64_add(f64_mul(F64_TWO, load64(k3x + i * 8)),
                  load64(k4x + i * 8))),
              _DG_F64_SIX);
            var du = f64_div(
              f64_add(f64_add(load64(k1u + i * 8),
                  f64_mul(F64_TWO, load64(k2u + i * 8))),
                f64_add(f64_mul(F64_TWO, load64(k3u + i * 8)),
                  load64(k4u + i * 8))),
              _DG_F64_SIX);
            store64(x + i * 8, f64_add(load64(x + i * 8), dx));
            store64(u + i * 8, f64_add(load64(u + i * 8), du));
            i = i + 1;
        }

        step = step + 1;
    }

    # Pack result into a new state
    var result = alloc(dim * 2 * 8);
    if (result == 0) { return 0; }
    i = 0;
    while (i < dim) {
        store64(result + i * 8, load64(x + i * 8));
        store64(result + (dim + i) * 8, load64(u + i * 8));
        i = i + 1;
    }
    return result;
}

# RHS of the transport ODE: out^a = −Γ^a_{μν} v^μ ẋ^ν
fn _pt_deriv(v, curve_vel, christoffel, dim, out) {
    var a = 0;
    while (a < dim) {
        var acc = 0;
        var mu = 0;
        while (mu < dim) {
            var v_mu = load64(v + mu * 8);
            var nu = 0;
            while (nu < dim) {
                var g = load64(christoffel + _dg_idx3(a, mu, nu, dim));
                acc = f64_add(acc, f64_mul(f64_mul(g, v_mu), load64(curve_vel + nu * 8)));
                nu = nu + 1;
            }
            mu = mu + 1;
        }
        store64(out + a * 8, f64_neg(acc));
        a = a + 1;
    }
    return 0;
}

# ================================================================
# 6b. PARALLEL TRANSPORT along a curve
# ================================================================
# Transport a vector V along a curve with coordinate velocity ẋ:
#   dV^a/dt = −Γ^a_{μν}(x) V^μ ẋ^ν
# The one Christoffel array is held constant for the whole path, every stage of
# every step (same convention as geodesic_rk4) — the true connection only on
# constant-connection curves (flat space in Cartesian coordinates, or a
# fixed-latitude circle on a sphere), an approximation otherwise that degrades
# as Γ varies along the path. The Levi-Civita connection is metric-compatible,
# so exact transport preserves ⟨V,V⟩; this RK4 form does so only up to its
# truncation error, and only where the frozen connection is the true one.
#
# v0:        contravariant vector to transport (flat dim)
# curve_vel: ẋ^ν, the curve's coordinate velocity (flat dim), held constant
# christoffel: Γ^a_{μν} (flat dim³), evaluated on the curve
# Returns: the transported vector (new alloc, flat dim), or the designed 0 for a null
#   pointer, a dim outside 1..16 or a refused allocation. steps <= 0 returns a copy of v0.
public fn parallel_transport(v0, curve_vel, christoffel, dim, dt, steps) {
    if (dim <= 0 || dim > _DG_MAX_DIM) { return 0; }
    if (v0 == 0 || curve_vel == 0 || christoffel == 0) { return 0; }
    var v = alloc(dim * 8);
    if (v == 0) { return 0; }
    var i = 0;
    while (i < dim) { store64(v + i * 8, load64(v0 + i * 8)); i = i + 1; }
    var k1 = alloc(dim * 8);
    var k2 = alloc(dim * 8);
    var k3 = alloc(dim * 8);
    var k4 = alloc(dim * 8);
    var tmp = alloc(dim * 8);
    if (k1 == 0 || k2 == 0 || k3 == 0 || k4 == 0 || tmp == 0) { return 0; }
    var six = f64_from(6);

    var step = 0;
    while (step < steps) {
        # k1 = dt * f(v)
        _pt_deriv(v, curve_vel, christoffel, dim, k1);
        i = 0;
        while (i < dim) { store64(k1 + i * 8, f64_mul(dt, load64(k1 + i * 8))); i = i + 1; }
        # k2 = dt * f(v + k1/2)
        i = 0;
        while (i < dim) {
            store64(tmp + i * 8, f64_add(load64(v + i * 8), f64_mul(F64_HALF, load64(k1 + i * 8))));
            i = i + 1;
        }
        _pt_deriv(tmp, curve_vel, christoffel, dim, k2);
        i = 0;
        while (i < dim) { store64(k2 + i * 8, f64_mul(dt, load64(k2 + i * 8))); i = i + 1; }
        # k3 = dt * f(v + k2/2)
        i = 0;
        while (i < dim) {
            store64(tmp + i * 8, f64_add(load64(v + i * 8), f64_mul(F64_HALF, load64(k2 + i * 8))));
            i = i + 1;
        }
        _pt_deriv(tmp, curve_vel, christoffel, dim, k3);
        i = 0;
        while (i < dim) { store64(k3 + i * 8, f64_mul(dt, load64(k3 + i * 8))); i = i + 1; }
        # k4 = dt * f(v + k3)
        i = 0;
        while (i < dim) { store64(tmp + i * 8, f64_add(load64(v + i * 8), load64(k3 + i * 8))); i = i + 1; }
        _pt_deriv(tmp, curve_vel, christoffel, dim, k4);
        i = 0;
        while (i < dim) { store64(k4 + i * 8, f64_mul(dt, load64(k4 + i * 8))); i = i + 1; }
        # v += (k1 + 2 k2 + 2 k3 + k4) / 6
        i = 0;
        while (i < dim) {
            var inc = f64_add(f64_add(load64(k1 + i * 8), f64_mul(F64_TWO, load64(k2 + i * 8))),
              f64_add(f64_mul(F64_TWO, load64(k3 + i * 8)), load64(k4 + i * 8)));
            store64(v + i * 8, f64_add(load64(v + i * 8), f64_div(inc, six)));
            i = i + 1;
        }
        step = step + 1;
    }
    return v;
}

# ================================================================
# 7. KILLING VECTOR RESIDUAL
# ================================================================
# Killing's equation: nabla_mu xi_nu + nabla_nu xi_mu = 0
#
# nabla_mu xi_nu = g_{nu lambda} (d_mu xi^lambda + Gamma^lambda_{mu rho} xi^rho)
#
# field: pointer to f64 array of dim*dim+dim values, laid out as:
#   [0..dim-1] = xi^mu (contravariant Killing field)
#   [dim..dim+dim*dim-1] = d_nu xi^mu as flat dim*dim array
#     indexed as field[dim + mu*dim + nu] = partial_nu xi^mu
# metric: flat f64 array (dim*dim) -- g_{ij}
# metric_deriv: not used directly; Christoffel symbols encode the
#   connection. We compute via the metric and the field derivatives.
#
# To keep the interface simple and match the spec, we take:
#   field: pointer to flat f64 array laid out as:
#     [0 .. dim-1]              = xi^mu  (the vector field)
#     [dim .. dim + dim*dim - 1] = partial derivatives dxi[mu*dim + nu] = d_nu xi^mu
#   metric: flat f64 array (dim*dim) -- g_{ij}
#   christoffel: flat f64 array (dim^3) -- Gamma^a_{mu nu}
#
# Returns: f64 -- maximum absolute residual of nabla_mu xi_nu + nabla_nu xi_mu, over
#   mu <= nu; 0 means the field satisfies Killing's equation to the last bit. A NaN
#   residual returns NaN (3.4.1). The designed 0 also answers a null pointer or a dim
#   outside 1..16, as everywhere in this module.

public fn killing_residual(field, metric, christoffel, dim) {
    if (dim <= 0 || dim > _DG_MAX_DIM) { return 0; }
    if (field == 0 || metric == 0 || christoffel == 0) { return 0; }
    # Extract xi pointer and dxi pointer from field layout
    var xi = field;
    var dxi = field + dim * 8;

    var max_res = 0;  # f64 0.0

    var mu = 0;
    while (mu < dim) {
        var nu = mu;
        while (nu < dim) {
            # nabla_mu xi_nu = g_{nu lambda} (d_mu xi^lambda + Gamma^lambda_{mu rho} xi^rho)
            var nabla_mu_xi_nu = 0;  # f64 0.0
            var lambda = 0;
            while (lambda < dim) {
                var g_nl = load64(metric + _dg_idx2(nu, lambda, dim));

                # d_mu xi^lambda = dxi[lambda * dim + mu]
                var d_mu_xi_l = load64(dxi + (lambda * dim + mu) * 8);

                # Gamma^lambda_{mu rho} xi^rho summed over rho
                var gamma_sum = 0;  # f64 0.0
                var rho = 0;
                while (rho < dim) {
                    var g_val = load64(christoffel + _dg_idx3(lambda, mu, rho, dim));
                    var xi_rho = load64(xi + rho * 8);
                    gamma_sum = f64_add(gamma_sum, f64_mul(g_val, xi_rho));
                    rho = rho + 1;
                }

                nabla_mu_xi_nu = f64_add(nabla_mu_xi_nu,
                  f64_mul(g_nl, f64_add(d_mu_xi_l, gamma_sum)));

                lambda = lambda + 1;
            }

            # nabla_nu xi_mu = g_{mu lambda} (d_nu xi^lambda + Gamma^lambda_{nu rho} xi^rho)
            var nabla_nu_xi_mu = 0;  # f64 0.0
            lambda = 0;
            while (lambda < dim) {
                var g_ml = load64(metric + _dg_idx2(mu, lambda, dim));

                # d_nu xi^lambda = dxi[lambda * dim + nu]
                var d_nu_xi_l = load64(dxi + (lambda * dim + nu) * 8);

                var gamma_sum2 = 0;  # f64 0.0
                var rho2 = 0;
                while (rho2 < dim) {
                    var g_val2 = load64(christoffel + _dg_idx3(lambda, nu, rho2, dim));
                    var xi_rho2 = load64(xi + rho2 * 8);
                    gamma_sum2 = f64_add(gamma_sum2, f64_mul(g_val2, xi_rho2));
                    rho2 = rho2 + 1;
                }

                nabla_nu_xi_mu = f64_add(nabla_nu_xi_mu,
                  f64_mul(g_ml, f64_add(d_nu_xi_l, gamma_sum2)));

                lambda = lambda + 1;
            }

            var residual = f64_abs(f64_add(nabla_mu_xi_nu, nabla_nu_xi_mu));
            # ⛔ 3.4.0 AND EARLIER — `residual > max_res` is false for a NaN, so a NaN residual
            # was dropped and a field with a NaN derivative reported 0.0, "exactly Killing":
            # dim 2, d xi = [[0, NaN], [3, 0]] -> 0. ⭐ 3.4.1: a NaN residual is the answer.
            # [measured: tests/abuse.tcyr "3.4.1: killing_residual", baseline 3.4.0]
            if (f64_eq(residual, residual) == 0) { return residual; }
            if (f64_gt(residual, max_res) == 1) {
                max_res = residual;
            }

            nu = nu + 1;
        }
        mu = mu + 1;
    }

    return max_res;
}

# ================================================================
# 8. EXTERIOR ALGEBRA
# ================================================================

# Wedge product of two 1-forms: (alpha ^ beta)_{ij} = alpha_i * beta_j - alpha_j * beta_i
# alpha, beta: pointers to f64 arrays of length dim
# Returns: pointer to allocated f64 array of C(dim, 2) = dim*(dim-1)/2 elements -- for dim = 1
#   an empty array (Lambda^2 of R^1 has no components): a valid pointer with nothing to read --
#   or the designed 0 for a null pointer, a dim outside 1..16, or a refused allocation.
# Each component is fl(fl(alpha_i beta_j) - fl(alpha_j beta_i)): exact when both products are,
#   otherwise within u (|alpha_i beta_j| + |alpha_j beta_i|) + u |result| of the exact value
#   (u = 2^-53; a product that underflows adds up to 2^-1075, one that overflows gives +-Inf/NaN).
# Stored in strictly-increasing index order: (0,1), (0,2), ..., (0,dim-1), (1,2), ...

public fn wedge_1_1(alpha, beta, dim) {
    # Identical defect to the contractions above, and NOT part of the original
    # finding: n2 = dim*(dim-1)/2 with dim = 100000 asks for 40 GB, so alloc
    # returns 0 and the store below writes to address 0. Measured: exit 139.
    # [measured: CHANGELOG.md 2.7.0 records the wedge_1_1 defect; the exit 139 run is not reproducible in-tree]
    if (dim <= 0 || dim > _DG_MAX_DIM) { return 0; }
    if (alpha == 0 || beta == 0) { return 0; }
    var n2 = dim * (dim - 1) / 2;
    # ⛔ 3.4.0 AND EARLIER -- dim = 1 asked alloc for 0 bytes, which answers 0, so a valid input
    # read as a refusal. ⭐ 3.4.1: the empty array is 8 reserved bytes, never read, and 0 stays
    # the refusal. [measured: tests/modules_c.tcyr "3.4.1 LIE3: wedge_1_1", baseline 3.4.0]
    var nbytes = n2 * 8;
    if (nbytes == 0) { nbytes = 8; }
    var out = alloc(nbytes);
    if (out == 0) { return 0; }

    var pos = 0;
    var i = 0;
    while (i < dim) {
        var j = i + 1;
        while (j < dim) {
            var ai = load64(alpha + i * 8);
            var bj = load64(beta + j * 8);
            var aj = load64(alpha + j * 8);
            var bi = load64(beta + i * 8);
            # (alpha ^ beta)_{ij} = alpha_i * beta_j - alpha_j * beta_i
            store64(out + pos * 8, f64_sub(f64_mul(ai, bj), f64_mul(aj, bi)));
            pos = pos + 1;
            j = j + 1;
        }
        i = i + 1;
    }
    return out;
}

# Hodge star operator for a 2-form in 4D Minkowski spacetime.
# (*F)_{mu nu} = 1/2 epsilon_{mu nu rho sigma} F^{rho sigma}
#
# form: pointer to 6 f64 values (2-form components in order:
#   (01), (02), (03), (12), (13), (23))
# sign: f64 OVERALL MULTIPLIER on the Lorentzian dual below. It is live, not
#   decorative. Pass +1 for the standard eta = diag(+1,-1,-1,-1) result; pass -1
#   to negate it, which is what the opposite signature convention (-+++ vs +---)
#   amounts to for a 2-form dual.
#
#   It does NOT select a Euclidean Hodge star: the Euclidean dual on 4D 2-forms
#   has a different per-component sign pattern, not a global factor, so no value
#   of `sign` produces it. Through 2.6.14 this block said three contradictory
#   things -- "+1 Euclidean, -1 Lorentzian", then "baked in; parameter kept for
#   API consistency" (it is not baked in), then "1 for Lorentzian, -1 for
#   Euclidean" -- and the Euclidean claim was false under all of them.
#
# Returns: pointer to allocated 6-element f64 array (the dual 2-form)
#
# With eta = diag(+1,-1,-1,-1) and sign = +1:
#   *(01) =  F_{23},  *(02) = -F_{13}, *(03) =  F_{12}
#   *(12) = -F_{03},  *(13) =  F_{02}, *(23) = -F_{01}
public fn hodge_star_2form_4d(form, sign) {
    if (form == 0) { return 0; }
    var out = alloc(48);
    if (out == 0) { return 0; }  # 6 * 8 bytes

    # Components: 0=(01), 1=(02), 2=(03), 3=(12), 4=(13), 5=(23)
    var f01 = load64(form);
    var f02 = load64(form + 8);
    var f03 = load64(form + 16);
    var f12 = load64(form + 24);
    var f13 = load64(form + 32);
    var f23 = load64(form + 40);

    # Lorentzian Hodge: *F = sign * (standard mapping)
    var s = sign;
    store64(out,      f64_mul(f23, s));           # *(01) = s * F_{23}
    store64(out + 8,  f64_mul(f64_neg(f13), s));  # *(02) = s * -F_{13}
    store64(out + 16, f64_mul(f12, s));           # *(03) = s * F_{12}
    store64(out + 24, f64_mul(f64_neg(f03), s));  # *(12) = s * -F_{03}
    store64(out + 32, f64_mul(f02, s));           # *(13) = s * F_{02}
    store64(out + 40, f64_mul(f64_neg(f01), s));  # *(23) = s * -F_{01}

    return out;
}

# Higher-grade exterior products (4D), in the reduced strictly-increasing basis
# used by wedge_1_1: 1-form = [0,1,2,3]; 2-form = [01,02,03,12,13,23];
# 3-form = [012, 013, 023, 123]; 4-form = [0123]. Build e0∧e1∧e2∧e3 by chaining
# wedge_1_1 → wedge_2_1 → wedge_3_1.

# Wedge of a 2-form ω and a 1-form α → 3-form.
# (ω ∧ α)_{ijk} = ω_{ij} α_k − ω_{ik} α_j + ω_{jk} α_i   (i < j < k)
public fn wedge_2_1(omega, alpha) {
    if (omega == 0 || alpha == 0) { return 0; }
    var out = alloc(32);
    if (out == 0) { return 0; }  # C(4,3) = 4
    var w01 = load64(omega);
    var w02 = load64(omega + 8);
    var w03 = load64(omega + 16);
    var w12 = load64(omega + 24);
    var w13 = load64(omega + 32);
    var w23 = load64(omega + 40);
    var a0 = load64(alpha);
    var a1 = load64(alpha + 8);
    var a2 = load64(alpha + 16);
    var a3 = load64(alpha + 24);
    store64(out, f64_add(f64_sub(f64_mul(w01, a2), f64_mul(w02, a1)), f64_mul(w12, a0)));        # 012
    store64(out + 8, f64_add(f64_sub(f64_mul(w01, a3), f64_mul(w03, a1)), f64_mul(w13, a0)));    # 013
    store64(out + 16, f64_add(f64_sub(f64_mul(w02, a3), f64_mul(w03, a2)), f64_mul(w23, a0)));   # 023
    store64(out + 24, f64_add(f64_sub(f64_mul(w12, a3), f64_mul(w13, a2)), f64_mul(w23, a1)));   # 123
    return out;
}

# Wedge of a 3-form β and a 1-form α → 4-form (the top form in 4D).
# (β ∧ α)_{0123} = β_{012} α_3 − β_{013} α_2 + β_{023} α_1 − β_{123} α_0
public fn wedge_3_1(beta, alpha) {
    if (beta == 0 || alpha == 0) { return 0; }
    var out = alloc(8);
    if (out == 0) { return 0; }
    var b012 = load64(beta);
    var b013 = load64(beta + 8);
    var b023 = load64(beta + 16);
    var b123 = load64(beta + 24);
    var v = f64_sub(f64_mul(b012, load64(alpha + 24)), f64_mul(b013, load64(alpha + 16)));
    v = f64_add(v, f64_mul(b023, load64(alpha + 8)));
    v = f64_sub(v, f64_mul(b123, load64(alpha)));
    store64(out, v);
    return out;
}
