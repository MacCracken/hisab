# error.cyr -- hisab error codes
# Usage: include "lib/error.cyr"
#
# Replaces Rust's HisabError enum with integer error codes.
#
# ⛔ 3.0.0 — THESE ARE NOW THE `E` HALF OF A `Result<T, E>`, NOT A RETURN VALUE.
# The 48 fallible entry points return `Ok(0)` / `Err(HSB_ERR_*)` from
# `lib/result.cyr` (the v6.6.0 VALUE form), so a caller binds both halves —
# `var t, v = f(...)` — and tests with `is_err_result(t)`. `var r = f(...)` is a
# hard compile error. The codes below are unchanged in name and value; what
# changed is where they travel. See `docs/guides/migration-3.0.md`.
# ⚠ A handful of functions that can only ever succeed still return a plain 0
# (`solve_pgs`, `svd_compute`); annotating those would train readers to ignore
# the distinction.

# ⭐ 2.19.0 — AN ENUM, NOT TWELVE `var` GLOBALS. Call sites are unchanged: the
# names and the values are identical, so nothing outside this block moves (all
# twelve values re-read through a probe and compared against the old `(0 - N)`
# forms — 0 mismatches).
# ⚠ THE PROJECT RULE THAT MOTIVATED THIS NAMES THE WRONG MECHANISM, and
# measuring the conversion is what showed it. CLAUDE.md says "enums for constants
# — zero `gvar_toks` cost vs. var globals"; the saving is NOT in the variable
# table. `CYRIUS_STATS=1` over the whole bundle reads **var_table: 615 on BOTH
# sides**, and cycc's own diagnostic says that table counts
# "too many globals+enums+arrays" — an enum member occupies an entry exactly as a
# global does. What actually moves is RELOCATIONS: a `var` global is a memory
# load needing a fixup per reference, an enum member is an immediate folded at
# compile time. Measured: **fixup_table 3092 → 2933 (−159)** and
# **code_size 748,024 → 747,320 B (−704)** across the 170 non-comment reference
# sites in the bundle — ~94% of sites losing a fixup, at ~4.4 code bytes each.
# The rule is right and the reason written beside it was not.
# [measured: CYRIUS_STATS=1 cyrius check --with-deps dist/hisab.cyr on both trees, 2026-09-10]
# ⚠ THE VALUES HAD TO BECOME LITERALS. Each was written `(0 - N)` because that is
# what a `var` initialiser accepts; an enum member takes a NUMBER, not an
# expression — `E = (0 - 1)` is `expected number, got '('`. Measured on 6.6.2:
# a literal `-1` in a NAMED enum compiles and compares equal to `(0 - 1)`, while
# an ANONYMOUS `enum { ... }` is `expected identifier, got '{'`. Both facts are
# why this could not simply be a search-and-replace.
# [measured: three-way probe on cycc 6.6.2, 2026-09-10]
public enum HsbError {
    HSB_ERR_NONE              = 0;
    HSB_ERR_INVALID_TRANSFORM = -1;
    HSB_ERR_SINGULAR_MATRIX   = -2;
    HSB_ERR_OUT_OF_RANGE      = -3;
    HSB_ERR_DIVISION_BY_ZERO  = -4;
    HSB_ERR_DEGENERATE        = -5;
    HSB_ERR_INVALID_INTERVAL  = -6;
    HSB_ERR_ZERO_STEPS        = -7;
    HSB_ERR_NO_CONVERGENCE    = -8;
    HSB_ERR_SINGULAR_PIVOT    = -9;
    HSB_ERR_INVALID_INPUT     = -10;
    # Allocation failed, or a request was rejected by a dimension cap before it
    # could overflow. Added 2.6.14: solvers that size a working buffer from
    # caller-supplied dimensions previously stored through alloc's null return
    # instead of reporting.
    HSB_ERR_ALLOC             = -11;
}

# Tolerances
public var EPSILON_F32 = 0x33D6BF95;               # 1e-7 as f32 bits (unused -- all math is f64)
public var EPSILON_F64 = 0x3D719799812DEA11;        # 1e-12 as f64 bits

# The smallest MAGNITUDE whose reciprocal is still finite: DBL_MIN.
#
# ⭐ THE THIRD INSTANCE, so by this project's own rule it gets extracted. 2.10.2
# settled the rule this constant exists for — **guard exactly what makes the
# operation fail and nothing more; a threshold that needs a scale chosen for it
# IS the defect** — and three modules then wrote the same value under three
# different names: `_GEO_F64_TINY` (geo, 15 uses), `_AD_F64_TINY` (autodiff, 4)
# and `_QUAT_F64_TINY` (quat, 3). All three were byte-identical
# `0x0010_0000_0000_0000` and became aliases of this one, so the VALUE has a
# single definition and the constant gate has one literal to check instead of
# three.
# ⚠ `_QUAT_F64_TINY` IS GONE as of 2.17.0 — not renamed, RETIRED. Both of its
# uses were guards on a length or a squared length, and both turned out to be the
# wrong test once the norms below them stopped flushing: DBL_MIN is one binade too
# strict for a reciprocal, so `hquat_normalize` moved onto the overflow test the
# vec family uses, and `hquat_inverse` onto an exact zero. The alias had no
# remaining caller and an unused global is not free.
#
# ⚠ NOT A REPLACEMENT FOR `EPSILON_F64`. This is the right threshold when the
# guard protects a DIVISION and the only thing that can actually fail is a zero
# (or subnormal) denominator. `EPSILON_F64` remains right for a genuinely
# dimensionless, bounded quantity — a normalised cosine, a barycentric weight, a
# parameter in [0,1] — where an absolute tolerance means something.
public var F64_TINY = 0x0010_0000_0000_0000;        # 2.2250738585072014e-308 (DBL_MIN)

# +Infinity, as a bit pattern.
#
# ⭐ THE FIFTH INSTANCE — this one was overdue. `_COL_F64_POS_INF`,
# `_SP_F64_POS_INF`, `_GA_F64_POS_INF` and `_GEO_F64_POS_INF` are byte-identical
# and are now aliases of this one, so the value has a single definition and the
# constant gate has one literal to check instead of five.
# ⚠ `interval.cyr` keeps its own `_IVL_F64_POS_INF` literal on purpose: it is one
# of the four fully STANDALONE modules and does not include `error`, so aliasing
# it here would be a dependency, not a de-duplication.
#
# ⭐ Its main use is not a sentinel but a GUARD. When the operation that can fail
# is a RECIPROCAL, `f64_lt(f64_abs(1/x), F64_POS_INF)` is the exact test: it is 1
# for every finite reciprocal and 0 for both +Inf and NaN, so one comparison
# rejects x = 0, any x too small to invert, and a NaN — with no scale chosen for
# it. ⚠ `F64_TINY` is NOT equivalent there and is one binade too strict:
# 1/2^-1023 = 2^1023 is finite, so DBL_MIN refuses inputs that work.
public var F64_POS_INF = 0x7FF0_0000_0000_0000;     # +Infinity

public fn hisab_is_err(code) {
    if (code < 0) { return 1; }
    return 0;
}
