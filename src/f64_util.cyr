# f64_util.cyr -- f64 helpers needed by hisab but not in cyrius stdlib
# Usage: include "lib/f64_util.cyr"
# Requires: math.cyr (for F64_ONE, f64_sin, f64_cos, etc.)
#
# Note: `f64_le` / `f64_ge` used to live here — they are now provided
# (NaN-correctly) by the stdlib `math` module as of Cyrius 6.2.x, so the
# local copies were removed to avoid a duplicate-definition collision.
# Transcendentals (`f64_acos`, `f64_pow`, `f64_atan2`, `f64_cosh`,
# `f64_sinh`, …) now come from the stdlib `ganita` module.

# tan(x) = sin(x) / cos(x)
fn f64_tan(x) {
    return f64_div(f64_sin(x), f64_cos(x));
}

# fmod(x, y) = x - trunc(x/y) * y. Returns 0 if y == 0.
#
# TRUNC, not floor. They diverge for every non-integer negative quotient, and the
# difference is not a rounding detail: floor gives the sign of the DIVISOR while
# C/IEEE-754 fmod (which this function's name promises) gives the sign of the
# DIVIDEND. fmod(-7, 3) is -1, not the +2 the floor form returned through 2.6.15.
fn f64_fmod(x, y) {
    if (f64_lt(f64_abs(y), EPSILON_F64) == 1) { return 0; }
    var q = f64_trunc(f64_div(x, y));
    return f64_sub(x, f64_mul(q, y));
}

# copysign(x, y) -- magnitude of x, sign of y.
#
# IEEE-754 defines copysign on the SIGN BIT of y, so it is a bit operation, not a
# comparison. Through 2.6.15 this tested `f64_lt(y, 0)`, an ORDERED comparison,
# which is false for both -0.0 (equal to +0.0) and for a negative NaN (unordered)
# -- so copysign(3, -0.0) returned +3 and the function could never produce -0.0 at
# all. Splicing the bits handles every case including NaN payloads.
fn f64_copysign(x, y) {
    return (x & 0x7FFF_FFFF_FFFF_FFFF) | (y & 0x8000_0000_0000_0000);
}

# Approximate equality within tolerance
fn f64_approx_eq(a, b, tol) {
    if (f64_lt(f64_abs(f64_sub(a, b)), tol) == 1) { return 1; }
    return 0;
}
