# geo.cyr -- geometric primitives, intersection tests, and closest-point queries
# Usage: shipped inside dist/hisab.cyr; in-tree, include "src/geo.cyr" after what it requires
# Requires: src/error.cyr, src/quat.cyr, src/vec3.cyr (stdlib resolves via cyrius.cyml [deps])
#
# Convention: intersection functions return 0 on miss, positive f64 t on hit.
# Overlap tests return 1 (true) or 0 (false).
# Closest-point functions return an HVec3 pointer.

# ================================================================
# Local constants
# ================================================================

# ⭐ 3.3.7 — AN ENUM, NOT `var` GLOBALS. A `var` is a memory load and a relocation at every
# reference; an enum member is an immediate (CLAUDE.md, "Enums for constants"). The two that
# were aliases of error.cyr's public `F64_POS_INF` and `F64_TINY` hold the same literals: an
# enum member cannot name a `var`, and those two stay `var` (public API). The constant gate
# reads hex enum members as it reads `var` declarations (scripts/check-constants.sh).
enum _GeoF64 {
    _GEO_F64_NEG_INF = 0xFFF0_0000_0000_0000;  # -Infinity
    _GEO_F64_POS_INF = 0x7FF0_0000_0000_0000;  # +Infinity
    _GEO_F64_FOUR    = 0x4010_0000_0000_0000;  # 4.0
    # ⚠ 3.3.4 — `_GEO_F64_EPS_SQ` (1e-24, EPSILON_F64 squared) is GONE. 2.10.1 added
    # it for the two squared-length guards in _geo_sphere_roots and
    # geo_ray_capsule_branch, and 2.14.0 moved both onto `_GEO_F64_TINY` below; from
    # then on nothing in src/ read it, and its comment here still said guards did.
    # The degree audit (roadmap "Named hex thresholds") found no use to audit.
    # The smallest MAGNITUDE whose reciprocal is still finite (DBL_MIN). Anything at
    # or above this can be divided by; anything below it makes 1/x overflow. 2.10.2
    # used it as the slab method's parallel test; geo_ray_aabb_face's is an exact zero
    # since 3.3.5 and geo_ray_obb_face's since 3.3.6 (see each), which keep it only for an
    # infinite origin (or e) against a subnormal direction component.
    _GEO_F64_TINY    = 0x0010_0000_0000_0000;  # 2.2250738585072014e-308 (DBL_MIN)
    # 3.3.5: below this squared length a ray direction is pre-scaled in the sphere and
    # capsule quadratics (see _geo_sphere_roots): 54 binades above the DBL_MIN at which
    # d.d itself flushes, so a direction above 2^-484 meeting unit-scale geometry keeps
    # every product normal and runs unscaled.
    _GEO_DIR_LO      = 0x0370_0000_0000_0000;  # 2^-968 = 4.008336720017946e-292
    _GEO_F64_THREE   = 0x4008_0000_0000_0000;  # 3.0
    _GEO_F64_THIRD   = 0x3FD5_5555_5555_5555;  # 1.0/3.0
}

# ================================================================
# Power-of-two pre-scaling (3.3.4)
# ================================================================
# A unit normal, a direction, barycentric weights and the region of a closest
# point do not change when every vector they are formed from is multiplied by
# the same s > 0, but the products that form them are degree two (a cross
# product, a dot product) or four (a Gram determinant) and flush or overflow
# long before the inputs do. So those routines first multiply by a power of
# two that brings the largest component near 1. A power of two changes only the
# exponent: every product, sum and quotient after it is exactly s, s^2 or s^4
# times the unscaled one, so wherever the unscaled arithmetic stayed in the
# normal range the answer is bit-identical, and elsewhere it is the answer the
# same shape gives at unit size. Roadmap [3.3.4] D037, D038, D087.

# The largest |component| of v, as the bit pattern of a non-negative f64. With
# the sign cleared, f64 order is integer order, and a NaN (0x7FF8...) sorts above
# +Inf above every finite value, so one integer max finds all three.
fn _geo_absmax_bits(v) {
    var m = HVec3_x(v) & 0x7FFF_FFFF_FFFF_FFFF;
    var y = HVec3_y(v) & 0x7FFF_FFFF_FFFF_FFFF;
    var z = HVec3_z(v) & 0x7FFF_FFFF_FFFF_FFFF;
    if (y > m) { m = y; }
    if (z > m) { m = z; }
    return m;
}

# 2^k for an integer k <= 1023, clamped below to the least normal exponent and built
# as `(1023 + k) << 52`: never `1 << k`, which x86 masks silently from k = 64. Both
# callers pass k in [-1023, 1023]; -1023 (a magnitude in the top binade) becomes
# 2^-1022, which takes it to [2, 4) instead of [1, 2).
fn _geo_pow2(k) {
    if (k < 0 - 1022) { k = 0 - 1022; }
    return (1023 + k) << 52;
}

# The power of two that takes a magnitude with biased exponent field `e` (the
# bits above 52 of a non-negative f64) into [1, 4): 2^(1023 - e). A subnormal
# (e = 0) gets 2^1023 and lands in [2^-51, 2); zero stays zero. For e = 2047, an
# Inf or a NaN, it is 1.0, so a non-finite input meets the unscaled arithmetic.
fn _geo_scale_for(e) {
    if (e == 2047) { return F64_ONE; }
    return _geo_pow2(1023 - e);
}

# ⛔ 3.4.1 (lane INS5) -- A TEMPORARY THAT NEVER LEAVES ITS FUNCTION NEEDS NO HEAP. Each of these
# writes the operation into a three-word vector the caller holds on its stack and returns it, the
# same arithmetic as hvec3_sub, hvec3_add and hvec3_scale, so the same bits. Through 3.4.0 a
# refused temporary here was read as a vector: a SIGSEGV from geo_triangle_area,
# geo_closest_point_on_triangle, geo_ray_capsule and eleven more entries at their first
# refused allocation. Stack storage cannot be refused, so these functions have no check to make:
# the one allocation left in each is its result, whose 0 is the designed failure.
# [measured: lane INS5 refused-allocation sweep over every public entry, 3.4.1-dev and this tree, 2026-11-01]
fn _geo_sub_to(r, a, b) {
    f64v_sub(r, a, b, 2);
    HVec3_set_z(r, f64_sub(HVec3_z(a), HVec3_z(b)));
    return r;
}
fn _geo_add_to(r, a, b) {
    f64v_add(r, a, b, 2);
    HVec3_set_z(r, f64_add(HVec3_z(a), HVec3_z(b)));
    return r;
}
fn _geo_scale_to(r, v, s) {
    f64v_scale(r, v, s, 2);
    HVec3_set_z(r, f64_mul(HVec3_z(v), s));
    return r;
}

# v / |v| at any magnitude, or `fallback` for the zero vector. The scaled copy's
# largest component is in [1, 4), or in [2^-51, 2) when all three are subnormal, so
# its length is normal and well inside the range, its reciprocal finite and normal,
# and a subnormal or overflowing |v| never meets `1 / |v|`. A NaN or infinite
# component leaves v unscaled and takes the shipped arithmetic: NaN in, NaN out.
fn _geo_unit_or(v, fallback) {
    var ws: i64[3];
    var w = _geo_scale_to(&ws, v, _geo_scale_for(_geo_absmax_bits(v) >> 52));
    var len = hvec3_length(w);
    if (f64_eq(len, 0) == 1) { return fallback; }
    return hvec3_scale(w, f64_div(F64_ONE, len));
}

# 1 when the largest |component| of the four vectors is in the top binade, 2^1023 to
# DBL_MAX: every component is then finite (a NaN or an Inf has exponent field 2047)
# and the difference of two of them can reach 2^1023 or overflow. Halving all four is
# exact there but for a subnormal component's last bit, which is below 2^-2097 of the
# largest. Where two large coordinates cancel exactly, that bit can be the whole
# difference, and halving it to 0 hands the caller's degenerate fallback a shape that
# is not degenerate. So no caller halves because this is 1 alone: geo_segment_direction
# halves when end - start has overflowed, and the three triangle routines when a
# difference they form has reached 2^1023 (see geo_triangle_unit_normal). Through
# 3.3.5 those three halved whenever this was 1, and the triangle (2^1023, 0, 0),
# (2^1023, 2^-1074, 0), (2^1023, 0, 2^-1074) got the unit normal (0, 1, 0) and the
# centroid weights where its 2^1022 copy gets (1, 0, 0) and the exact weights. 0
# otherwise, and the caller is unchanged.
# [measured: G1 top-binade sibling probe, 3.3.4 tree and this one, not in-tree, 2026-10-11; cycc 6.6.14]
fn _geo_top_binade(a, b, c, d) {
    var m = _geo_absmax_bits(a);
    var t = _geo_absmax_bits(b);
    if (t > m) { m = t; }
    t = _geo_absmax_bits(c);
    if (t > m) { m = t; }
    t = _geo_absmax_bits(d);
    if (t > m) { m = t; }
    if ((m >> 52) == 2046) { return 1; }
    return 0;
}

# ================================================================
# Primitives
# ================================================================

# Ray: origin (HVec3), direction (HVec3) -- 16 bytes (two pointers)
#derive(accessors)
public struct GeoRay { origin; direction; }

# A ray from `origin` along direction / |direction| (hvec3_normalize: any finite magnitude,
# subnormal included). The origin is stored by reference, the unit direction is a new HVec3. 0, the
# designed failure, when an allocation is refused. A zero direction is stored as the zero vector.
public fn geo_ray_new(origin, direction) {
    var dir = hvec3_normalize(direction);
    if (dir == 0) { return 0; }   # (3.4.0: its own allocation refused: the designed 0, not a null direction)
    var r = alloc(sizeof(GeoRay));
    if (r == 0) { return 0; }   # (3.4.0: a refused allocation is the designed 0)
    GeoRay_set_origin(r, origin);
    GeoRay_set_direction(r, dir);
    return r;
}

# Point along the ray at parameter t
public fn geo_ray_at(ray, t) {
    # (3.4.0: o + t d formed once, the same operations as hvec3_add(o, hvec3_scale(d, t)), so the
    # same bits, in one allocation instead of two.)
    var o = GeoRay_origin(ray);
    var d = GeoRay_direction(ray);
    return hvec3_new(f64_add(HVec3_x(o), f64_mul(HVec3_x(d), t)), f64_add(HVec3_y(o), f64_mul(HVec3_y(d), t)),
      f64_add(HVec3_z(o), f64_mul(HVec3_z(d), t)));
}

# Plane: normal (HVec3), distance (f64) -- 16 bytes
#derive(accessors)
public struct GeoPlane { normal; distance; }

# The plane through `point` with unit normal normal / |normal| (hvec3_normalize: any finite
# non-zero magnitude, subnormal included), stored as (n, d = n . point): signed distances are
# n . x - d. 0, the designed failure, for a zero normal (3.4.1: no plane has one, and the plane it
# built answered distance 0 for every point) or a refused allocation. A NaN or infinite normal
# builds a plane whose every query is NaN.
public fn geo_plane_from_point_normal(point, normal) {
    var n = hvec3_normalize(normal);
    if (n == 0) { return 0; }   # (3.4.0: refused, the designed 0 before n is read)
    if (_geo_hvec3_is_zero(n) == 1) { return 0; }
    var d = hvec3_dot(n, point);
    var p = alloc(sizeof(GeoPlane));
    if (p == 0) { return 0; }   # (3.4.0: a refused allocation is the designed 0)
    GeoPlane_set_normal(p, n);
    GeoPlane_set_distance(p, d);
    return p;
}

# n . point - d: positive on the normal's side, in the units of the plane's unit normal. NaN in,
# NaN out.
public fn geo_plane_signed_distance(plane, point) {
    return f64_sub(hvec3_dot(GeoPlane_normal(plane), point), GeoPlane_distance(plane));
}

# AABB: min (HVec3), max (HVec3) -- 16 bytes
#derive(accessors)
public struct GeoAabb { min; max; }

# The axis-aligned box spanned by corners a and b, sorted per axis (hvec3_min / hvec3_max) into
# new min and max HVec3s. 0, the designed failure, when an allocation is refused.
public fn geo_aabb_new(a, b) {
    var box = alloc(sizeof(GeoAabb));
    if (box == 0) { return 0; }   # (3.4.0: a refused allocation is the designed 0)
    # (3.4.0: and so is either corner's: the box fails as a whole, never with a null corner that a
    # caller such as octree_query would read.)
    var mn = hvec3_min(a, b);
    var mx = hvec3_max(a, b);
    if (mn == 0 || mx == 0) { return 0; }
    GeoAabb_set_min(box, mn);
    GeoAabb_set_max(box, mx);
    return box;
}

# (a + b) / 2 for one coordinate, correctly rounded at every magnitude (3.4.1). a + b overflows
# only when both are large and of one sign, and then a / 2 + b / 2 is exact but for a subnormal
# operand's last bit, below 2^-2097 of the answer: min 7FE8000000000000 and max 7FEC000000000000
# gave +Inf for the midpoint 7FEA000000000000. Below that the sum is the 3.4.0 arithmetic, bit
# for bit. A NaN or infinite operand keeps it too: NaN in, NaN out; Inf + -Inf is NaN.
# [measured: GEO 3.4.1 AU2-G2-F7 repro, exact Fraction oracle, 3.4.0 vs this tree, not in-tree, 2026-10-31]
fn _geo_mid1(a, b) {
    var s = f64_add(a, b);
    if ((s & 0x7FFF_FFFF_FFFF_FFFF) == 0x7FF0_0000_0000_0000) {
        var ma = a & 0x7FFF_FFFF_FFFF_FFFF;
        var mb = b & 0x7FFF_FFFF_FFFF_FFFF;
        if (ma < 0x7FF0_0000_0000_0000 && mb < 0x7FF0_0000_0000_0000) {
            return f64_add(f64_mul(a, F64_HALF), f64_mul(b, F64_HALF));
        }
    }
    return f64_mul(s, F64_HALF);
}

# The midpoint of two points, (a + b) / 2 per coordinate (_geo_mid1), as a new HVec3; 0 when its
# allocation is refused.
fn _geo_mid3(a, b) {
    var sx = f64_add(HVec3_x(a), HVec3_x(b));
    var sy = f64_add(HVec3_y(a), HVec3_y(b));
    var sz = f64_add(HVec3_z(a), HVec3_z(b));
    var m = sx & 0x7FFF_FFFF_FFFF_FFFF;
    var my = sy & 0x7FFF_FFFF_FFFF_FFFF;
    var mz = sz & 0x7FFF_FFFF_FFFF_FFFF;
    if (my > m) { m = my; }
    if (mz > m) { m = mz; }
    if (m >= 0x7FF0_0000_0000_0000) {   # an overflow or a non-finite input: per coordinate
        return hvec3_new(_geo_mid1(HVec3_x(a), HVec3_x(b)), _geo_mid1(HVec3_y(a), HVec3_y(b)),
          _geo_mid1(HVec3_z(a), HVec3_z(b)));
    }
    return hvec3_new(f64_mul(sx, F64_HALF), f64_mul(sy, F64_HALF), f64_mul(sz, F64_HALF));
}

# The centre of the box, (min + max) / 2 per axis, correctly rounded for every finite pair of
# corners, the top binade included (_geo_mid1). A new HVec3, or 0 when its allocation is refused.
# A setter-built (inverted) box has the same centre. NaN in, NaN out.
public fn geo_aabb_center(aabb) {
    return _geo_mid3(GeoAabb_min(aabb), GeoAabb_max(aabb));
}

# The box's extent, max - min per axis (negative on an inverted axis, which only the setters
# build). A new HVec3, or 0 when its allocation is refused. Corners more than DBL_MAX apart give
# +Inf on that axis, or -Inf on an inverted one (min DBL_MAX, max -DBL_MAX): the extent is not
# representable.
public fn geo_aabb_size(aabb) {
    return hvec3_sub(GeoAabb_max(aabb), GeoAabb_min(aabb));
}

# Sphere: center (HVec3), radius (f64) -- 16 bytes
#derive(accessors)
public struct GeoSphere { center; radius; }

# A sphere; the centre is stored by reference, the radius as given. 0 when the allocation is
# refused.
public fn geo_sphere_new(center, radius) {
    var s = alloc(sizeof(GeoSphere));
    if (s == 0) { return 0; }   # (3.4.0: a refused allocation is the designed 0)
    GeoSphere_set_center(s, center);
    GeoSphere_set_radius(s, radius);
    return s;
}

# OBB: center (HVec3), half_extents (HVec3), rotation (HQuat) -- 24 bytes
#derive(accessors)
public struct GeoObb { center; half_extents; rotation; }

# An oriented box: centre, half-extents along its local axes, and a unit quaternion rotating local
# into world axes, each stored by reference. 0 when the allocation is refused.
public fn geo_obb_new(center, half_extents, rotation) {
    var o = alloc(sizeof(GeoObb));
    if (o == 0) { return 0; }   # (3.4.0: a refused allocation is the designed 0)
    GeoObb_set_center(o, center);
    GeoObb_set_half_extents(o, half_extents);
    GeoObb_set_rotation(o, rotation);
    return o;
}

# Returns three axis vectors as an array of 3 HVec3 pointers (alloc 24 bytes)
public fn geo_obb_axes(obb) {
    # (3.4.0: the unit vectors on the stack and each rotation checked, _geo_obb_axes_into: a refused
    # allocation anywhere is the designed 0.)
    var axb[72];
    var axp[24];
    if (_geo_obb_axes_into(obb, &axb, &axp) == 0) { return 0; }
    var arr = alloc(24);
    if (arr == 0) { return 0; }   # (3.4.0: a refused allocation is the designed 0)
    store64(arr, load64(&axp));
    store64(arr + 8, load64(&axp + 8));
    store64(arr + 16, load64(&axp + 16));
    return arr;
}

# Capsule: start (HVec3), end (HVec3), radius (f64) -- 24 bytes
#derive(accessors)
public struct GeoCapsule { start; end; radius; }

# A capsule, the points within `radius` of the segment [start, end]; the ends are stored by
# reference. start == end is a sphere. 0 when the allocation is refused.
public fn geo_capsule_new(start, end, radius) {
    var c = alloc(sizeof(GeoCapsule));
    if (c == 0) { return 0; }   # (3.4.0: a refused allocation is the designed 0)
    GeoCapsule_set_start(c, start);
    GeoCapsule_set_end(c, end);
    GeoCapsule_set_radius(c, radius);
    return c;
}

# Triangle: v0, v1, v2 (three HVec3 pointers) -- 24 bytes
#derive(accessors)
public struct GeoTriangle { v0; v1; v2; }

# A triangle with vertices a, b, c (stored by reference; the winding fixes the normal's sign).
# 0 when the allocation is refused.
public fn geo_triangle_new(a, b, c) {
    var t = alloc(sizeof(GeoTriangle));
    if (t == 0) { return 0; }   # (3.4.0: a refused allocation is the designed 0)
    GeoTriangle_set_v0(t, a);
    GeoTriangle_set_v1(t, b);
    GeoTriangle_set_v2(t, c);
    return t;
}

# The unnormalised normal (v1 - v0) x (v2 - v0), |n| = twice the area, as a new HVec3. Plain
# products of the edges: subnormal (fewer bits) below edges of about 2^-511, zero below 2^-537,
# +Inf or NaN above about 2^512. geo_triangle_unit_normal forms the cross product exactly (finite
# vertices): its direction holds at any scale.
public fn geo_triangle_normal(tri) {
    var edge1: i64[3];
    var edge2: i64[3];
    _geo_sub_to(&edge1, GeoTriangle_v1(tri), GeoTriangle_v0(tri));
    _geo_sub_to(&edge2, GeoTriangle_v2(tri), GeoTriangle_v0(tri));
    return hvec3_cross(&edge1, &edge2);
}

# 2.10.2: the degeneracy guard tests `len_sq`, the SQUARED length of the cross
# product -- which for legs of size s is s^4, so against the unsquared
# EPSILON_F64 it fired for every triangle smaller than 1e-3 and returned a
# FABRICATED unit_y with no error signal. Measured: a right triangle with 1e-4
# legs in the xy-plane returned (0,1,0) where the truth is (0,0,1).
# [measured: docs/development/issues/archived/2026-08-10-squared-epsilon-guards-in-geo-ray.md]
#
# ⚠ That paragraph is history: neither `_GEO_F64_TINY` nor `len_sq` survives in
# this function as of 2.17.0. See the block inside it for what replaced them and
# why the exact-zero test was not enough on its own.
# [measured: docs/development/issues/archived/2026-08-10-squared-epsilon-guards-in-geo-ray.md]
public fn geo_triangle_unit_normal(tri) {
    var v0 = GeoTriangle_v0(tri);
    var v1 = GeoTriangle_v1(tri);
    var v2 = GeoTriangle_v2(tri);
    # ⛔ 3.4.1 — THE CROSS PRODUCT IS EXACT, SO NOTHING FLUSHES AND NOTHING CANCELS (review RV-GEO
    # S4). A factor per edge still flushed the small components of an edge whose own components
    # span more than 2^1074: v1 = (1, 0, 0), v2 = (1.5 * 2^1000, 1.3 * 2^-80, 0) from 0 got the
    # fallback (0, 1, 0) for (0, 0, 1). For finite vertices each component of (v1 - v0) x (v2 - v0)
    # is the exact one correctly rounded, the three taken to a common power of two before the
    # length: the unit normal of the exact edges to a few ulps for every non-degenerate triangle,
    # and (0, 1, 0) exactly when the cross product is exactly zero. A non-finite vertex keeps the
    # scaled float arithmetic below (NaN in, NaN out).
    # [measured: GEO2 3.4.1 un2.py full-range families, Fraction oracle, 2026-10-31]
    # ⭐ 3.4.1 — THE ROUNDING IS CERTIFIED IN DOUBLES FIRST, AND THE INTEGER SUM RUNS ONLY WHERE IT
    # CANNOT BE (GEO2 G2-F3: the integer sum alone cost 730 ns against 3.4.0's 192). The fast path
    # (_geo_unit_normal_fast: Dekker products, two_sum edges and a proven bound) writes the same
    # doubles as the exact one (_geo_unit_normal_exact) wherever it answers, so the result is the
    # same bits either way: 0 differences from the integer-only form, and 0 wrong, over GEO2's
    # 80,000 triangles in six families (4 seeds), and 0 differences between the two paths' doubles
    # over 400,000 triangles chosen to sit on its limits (near-colinear to 2^-52, exact ties,
    # cancelling coordinates, mixed exponents, axis-aligned grids). Cost on 64 ordinary
    # triangles: 220 to 236 ns where 3.4.0 takes 196 to 209 (1.12 to 1.13 times; the integer-only
    # form 770 to 800); a triangle the bound declines (near-colinear: about 1 in 5 at 2^-20..2^-52)
    # pays both, about 940 ns (integer-only 840), and one with an edge component outside
    # [2^-400, 2^401) goes straight to the integer sum, about 780 ns (800).
    # [measured: GEO3 3.4.1 un3.py, fstress.py, tb_un3.bcyr, Fraction oracle and exact path, 2026-10-31]
    var w: i64[3];
    var nz = _geo_unit_normal_fast(v0, v1, v2, &w);
    if (nz < 0 && (_geo_hvec3_finite(v0) & _geo_hvec3_finite(v1) & _geo_hvec3_finite(v2)) == 1) {
        nz = _geo_unit_normal_exact(v0, v1, v2, &w);
    }
    if (nz >= 0) {
        if (nz == 0) { return hvec3_unit_y(); }
        var len = f64_sqrt(hvec3_dot(&w, &w));
        return hvec3_new(f64_div(HVec3_x(&w), len), f64_div(HVec3_y(&w), len), f64_div(HVec3_z(&w), len));
    }
    # A non-finite vertex: the scaled float arithmetic, whose history follows.
    var e1s: i64[3];
    var e2s: i64[3];
    var e1 = _geo_sub_to(&e1s, v1, v0);
    var e2 = _geo_sub_to(&e2s, v2, v0);
    # ⛔ 2.10.2 MOVED THIS THRESHOLD AND LEFT THE EXPONENT WRONG. `len_sq` is a
    # cross product SQUARED — degree FOUR in the caller's units — and DBL_MIN is
    # the threshold for a degree-ONE quantity, so the guard still fired 77 decades
    # early and still returned a FABRICATED (0,1,0) for a well-formed right
    # triangle. Measured on the 2.13.0 tree: correct through legs of 1e-76, then
    # unit_y from 1e-77 down, which is exactly where sc^4 crosses DBL_MIN.
    # 2.10.2 replaced that with `f64_gt(len_sq, 0) == 0`, reasoning that sqrt of
    # any non-zero double is normal so only an exact zero fails — sound as far as
    # it went, and it also closed a NaN hole (`f64_lt(NaN, x)` is 0, so a NaN
    # triangle used to return a NaN normal instead of the degenerate fallback).
    # [measured: tests/modules.tcyr _sc_sweep, first bad decade 77 of 90]
    #
    # ⛔ 2.17.0 — AND `len_sq` ITSELF WAS THE DEFECT, SO THE EXACT GUARD FIRED
    # ANYWAY. `hvec3_length_sq` squares before summing, so for legs below 2^-269
    # the squared cross product flushed to exactly zero, `f64_gt(0, 0) == 0` was
    # true, and the FABRICATED (0,1,0) came back for a perfectly well-formed
    # triangle — the very outcome 2.10.2 records as repaired, twice over now.
    # Measured on the 2.16.0 tree: **877 of 1401 leg scales wrong**, legs below
    # 2^-269 and at or above 2^256. ⭐ Half-depth bands because a cross product is
    # degree TWO — derived from the arithmetic, not chosen.
    # ⚠ THE `len_sq` TEST IS GONE, NOT SUPPLEMENTED. The first attempt kept it and
    # added the repaired path below, which fixed nothing at all on the low side:
    # the flushed `len_sq` still returned the fallback before the new code ran.
    # The order of the guard is the guard.
    # ⭐ `hvec3_length` (repaired earlier in this release) replaces the re-derived
    # sqrt, and what is guarded is what actually fails: a zero length and a length
    # too small to invert.
    # ⚠ WHAT THIS DOES NOT FIX, STATED SO IT IS NOT READ AS A FULL REPAIR: the
    # residual band is now `hvec3_cross` itself. Legs at 2^-512 give cross
    # components that are already subnormal or zero, and legs at 2^512 give +Inf,
    # before any norm runs. The repair moves the floor from 2^-269 to 2^-512 and
    # the ceiling from 2^256 to 2^512 — 243 and 256 binades — and what remains is
    # destroyed upstream of this function. Measured after: 378 of 1401.
    # [measured: 1401-binade two-sided sweep before and after, 2026-09-10]
    #
    # ⛔ 3.3.3 — THE NaN HALF OF 2.10.2'S CONTRACT WAS THE FABRICATED-ANSWER CLASS.
    # Through 3.3.2 the guard was `f64_gt(len, 0) == 0`, which is TRUE for a NaN
    # length, so a triangle with a NaN coordinate — or an infinite one whose cross
    # product picks up `Inf * 0` — returned (0, 1, 0): a valid-looking unit normal
    # with nothing to say it was invented. 2.10.2 recorded that fold as closing a
    # NaN hole; it opened one. The test is now an exact zero: a zero length still
    # returns the documented degenerate unit_y, and a NaN length falls through to
    # `n * (1 / NaN)`, NaN in all three components — what
    # `hvec3_normalize(geo_triangle_normal(tri))` returns on the same input.
    # [measured: G6 scratch probe on the 3.3.2 bundle, not reproducible in-tree, 2026-10-01; cycc 6.6.12]
    #
    # ⚠ THAT MOVES FINITE INPUT TOO, AND IT IS MEANT TO. A finite triangle whose
    # cross product overflows in both products of one component gets `Inf - Inf`
    # there, a NaN length, and the fold answered (0, 1, 0) for it as well:
    # (0,0,0), (1e300,1e300,0), (1e300,1e300,1), whose unit normal is
    # (0.7071, -0.7071, 0) — what the same triangle scaled to 1e150 returns —
    # gave unit_y through 3.3.2 and is NaN in all three now. Not every moved answer
    # was wrong: the fold's (0, 1, 0) was right by coincidence where the true normal
    # is +y. (0,0,0), (1e300,0,1e300), (2e300,0,1e300) has the cross product
    # (0, NaN, 0) and the normal +y (its 1e150 copy gives (0, 0x3FEFFFFFFFFFFFFF, 0)),
    # and its mirror, the last two vertices swapped and the normal -y, got the same
    # (0, 1, 0); both are NaN now, which loses the coincidence with the error.
    # [measured: R5geo unit-normal probe, 3.3.2 and repaired bundles, not in-tree, 2026-10-01; cycc 6.6.12]
    # Over 64 random finite triangles per binade, coordinates up to about 2^e for
    # e in [400, 1023], 32636 of 39936 moved from unit_y to NaN, every one at e in
    # [512, 1023]. The
    # 100 that were NaN already, 50 in all three components and 50 in part (each
    # infinite component times 1 / Inf = 0), and the 7200 finite answers did not
    # move. NaN is the loud answer until the edges are pre-scaled (roadmap [3.3.4]
    # D037). The 2.17.0 note above that legs at 2^512 "give +Inf" is the right
    # triangle's case, whose (0, 0, Inf) cross product has no `Inf - Inf`.
    # [measured: R4geo unit-normal binade sweep, 3.3.2 and repaired bundles, not in-tree, 2026-10-01; cycc 6.6.12]
    #
    # ⛔ 3.3.4 — THE EDGES ARE PRE-SCALED, SO `hvec3_cross` IS NO LONGER THE FLOOR
    # (roadmap D037). Both edges are multiplied by the power of two that brings the
    # larger's largest component into [1, 2) (see "Power-of-two pre-scaling" at the
    # top), the cross product is formed there, and `_geo_unit_or` normalises it the
    # same way, so a cross product that is subnormal relative to its own edges (a
    # thin triangle) is not a reciprocal overflow either. The answer is the one the
    # same triangle gives at unit size, bit for bit, except where top-binade vertices
    # cancel to a subnormal last bit (_geo_top_binade). The right triangle with legs
    # 2^e is right for every e in [-1074, 1023] (3.3.3: 378 wrong of the 1401 legs
    # 2^-700 to 2^700, unit_y at or below 2^-512 and NaN from 2^512; 1075 of 2098 on
    # the full range). 24 random triangles at every scale 2^e: 25731 wrong of 50304
    # before, none now. Vertices more than DBL_MAX apart make b - a itself Inf, so
    # when any coordinate is in the top binade every vertex is halved first
    # (_geo_top_binade); 20000 triangles with coordinates up to DBL_MAX: none right
    # before, 19878 now, and the 122 others within sin 0.13 of colinear. In
    # 27395 mixed configurations (translated, thin, near-colinear) no answer within
    # 4 * 2^-53 of the exact unit normal of the rounded edges left that band, and
    # 6432 entered it. 1024 of the 24-triangle answers and 331 mixed ones are further
    # from the exact value than 3.3.3's, at most 3.4 * 2^-53, where 3.3.3's length
    # took `_hvec3_len_scaled`; each is the unit-size answer.
    # [measured: georay triangle sweeps, exact oracle, 3.3.3 geo.cyr vs repaired, 2026-10-03; cycc 6.6.14]
    # The 3.3.3 binade sweep above, repeated (64 random triangles per binade, e in
    # [400, 1023]): 39861 of 39936 right, against 7184 (32736 NaN). The 75 others are
    # within sin 0.17 of colinear, wrong by the cross product's cancellation, and
    # bit-identical to 3.3.3's answer for the same triangle at unit size.
    # [measured: georay unit-normal binade sweep, exact oracle, 3.3.3 geo.cyr vs repaired, 2026-10-03; cycc 6.6.14]
    # ⛔ 3.3.6 — HALVED ONLY WHEN AN EDGE REACHES 2^1023, NOT WHEN A COORDINATE DOES.
    # 3.3.4 halved every vertex whenever a coordinate was in the top binade, which drops
    # a subnormal last bit, and where the big coordinates cancel that bit is the whole
    # edge: (2^1023, 0, 0), (2^1023, 2^-1074, 0), (2^1023, 0, 2^-1074) got unit_y, not
    # +x, where its 2^1022 copy was right. The edges are now formed first and halved
    # only when one reaches 2^1023 (or overflows) from finite vertices. 80024 triangles
    # (the repros, and 20000 each with top-binade coordinates shared so that they
    # cancel, with vertices more than DBL_MAX apart, with random top-binade vertices,
    # and with none in the top binade), against the exact unit normal of the exact
    # edges within 4 * 2^-53: 572 wrong -> right, none right -> wrong. Only the
    # cancelling family moved (575 right answers, within 1.00 * 2^-53 before and
    # after), and the 14816 of it that translate exactly to an ordinary position give
    # that position's answer bit for bit (3.3.5: 14024).
    # [measured: C336 row-6 sweep, exact Fraction oracle, 3.3.5 vs this tree, not in-tree, 2026-10-11; cycc 6.6.14]
    # ⚠ 2^1023, NOT OVERFLOW ALONE (geo_segment_direction's test). An edge in the top
    # binade scales by 2^-1022 into [2, 4), one binade above every smaller triangle's
    # [1, 2), so where a scaled component is subnormal it rounds differently; halving
    # there keeps the answer the unit-size one through the top binade. Halving on
    # overflow alone changed it for 2 of 42947 exactly scaled mixed-magnitude triangles
    # and moved 610 right answers with vertices more than DBL_MAX apart or random
    # top-binade vertices; this moves none of those from 3.3.5's bits.
    # [measured: C336 row-6 covariance and variant sweeps, 3.3.5 vs this tree, not in-tree, 2026-10-11; cycc 6.6.14]
    var m = _geo_absmax_bits(e1);
    var m2 = _geo_absmax_bits(e2);
    if (m2 > m) { m = m2; }
    if ((m >> 52) >= 2046) {
        if (_geo_top_binade(v0, v1, v2, v0) == 1) {
            var h0: i64[3];
            var h1: i64[3];
            var h2: i64[3];
            _geo_scale_to(&h0, v0, F64_HALF);
            e1 = _geo_sub_to(&e1s, _geo_scale_to(&h1, v1, F64_HALF), &h0);
            e2 = _geo_sub_to(&e2s, _geo_scale_to(&h2, v2, F64_HALF), &h0);
            m = _geo_absmax_bits(e1);
            m2 = _geo_absmax_bits(e2);
            if (m2 > m) { m = m2; }
        }
    }
    # ⛔ 3.4.1 — EACH EDGE HAS ITS OWN POWER OF TWO (AU2-G2-F5). One factor for both took the longer
    # edge into [1, 2) and flushed the shorter one: v1 = (4C73C0CA428C59FB, 0, 0), v2 = (0,
    # 017E06522C8B909A, 0176A09E667F3BCD) from 0 got the fallback (0, 1, 0) for (0,
    # BFE3425F773FB196, 3FE98E315CDBC591). The direction of e1 x e2 does not change when e1 and e2
    # are scaled separately, and where no product leaves the normal range the cross product differs
    # from the one-factor one by a power of two only, which _geo_unit_or takes out: the same bits.
    # [measured: GEO 3.4.1 un_sweep.py, 30000 triangles x2 seeds, 3.4.0 vs this tree, not in-tree, 2026-10-31]
    var s1 = _geo_scale_for(_geo_absmax_bits(e1) >> 52);
    var s2 = _geo_scale_for(_geo_absmax_bits(e2) >> 52);
    var c1: i64[3];
    var c2: i64[3];
    var cr: i64[3];
    _geo_cross_into(_geo_scale_to(&c1, e1, s1), _geo_scale_to(&c2, e2, s2), &cr);
    return _geo_unit_or(&cr, hvec3_unit_y());
}

# The cross product of finite vertices for geo_triangle_unit_normal, exactly (3.4.1): component i of
# (v1 - v0) x (v2 - v0) summed as an integer from the edges' two words (two_sum, so exact), or from
# v1 x v2 + v2 x v0 + v0 x v1 where an edge overflows; each correctly rounded with its own power of
# two, the three taken to the largest one's (the largest into [1, 2)) and written to w. Returns 1,
# or 0 for an exactly zero cross product (w then unwritten).
fn _geo_unit_normal_exact(v0, v1, v2, w) {
    var de1: i64[19];
    var de2: i64[19];
    _geo_xi_dvec(v1, v0, &de1);
    _geo_xi_dvec(v2, v0, &de2);
    var pts: i64[27];
    _geo_xi_vec(v0, &pts);
    _geo_xi_vec(v1, &pts + 72);
    _geo_xi_vec(v2, &pts + 144);
    # The edges' two words where at most one edge has a second word (two or four products a
    # component), else the vertices (six).
    var pt = 0;
    var k1 = load64(&de1 + 144);
    var k2 = load64(&de2 + 144);
    if (k1 < 0 || k2 < 0 || (k1 > 0 && k2 > 0)) { pt = 1; }
    var acc: i64[208];
    var mg: i64[6];
    var sg: i64[3];
    var em = 0 - 100000;
    for (var i = 0; i < 3; i = i + 1) {
        var j = i + 1;
        if (j == 3) { j = 0; }
        var k = j + 1;
        if (k == 3) { k = 0; }
        _geo_xi_init(&acc);
        if (pt == 0) {
            _geo_xi_add2(&acc, &de1 + j * 24, &de2 + k * 24, 0);
            _geo_xi_add2(&acc, &de1 + k * 24, &de2 + j * 24, 1);
            if (k1 > 0) {
                _geo_xi_add2(&acc, &de1 + 72 + j * 24, &de2 + k * 24, 0);
                _geo_xi_add2(&acc, &de1 + 72 + k * 24, &de2 + j * 24, 1);
            }
            if (k2 > 0) {
                _geo_xi_add2(&acc, &de1 + j * 24, &de2 + 72 + k * 24, 0);
                _geo_xi_add2(&acc, &de1 + k * 24, &de2 + 72 + j * 24, 1);
            }
        } else {
            # v1 x v2 + v2 x v0 + v0 x v1, component i
            _geo_xi_add2(&acc, &pts + 72 + j * 24, &pts + 144 + k * 24, 0);
            _geo_xi_add2(&acc, &pts + 72 + k * 24, &pts + 144 + j * 24, 1);
            _geo_xi_add2(&acc, &pts + 144 + j * 24, &pts + k * 24, 0);
            _geo_xi_add2(&acc, &pts + 144 + k * 24, &pts + j * 24, 1);
            _geo_xi_add2(&acc, &pts + j * 24, &pts + 72 + k * 24, 0);
            _geo_xi_add2(&acc, &pts + k * 24, &pts + 72 + j * 24, 1);
        }
        store64(&sg + i * 8, _geo_xi_norm(&acc));
        _geo_xi_mag(&acc, &mg + i * 16);
        if (load64(&sg + i * 8) != 0) {
            if (load64(&mg + i * 16 + 8) > em) { em = load64(&mg + i * 16 + 8); }
        }
    }
    if (em == 0 - 100000) { return 0; }
    for (var m = 0; m < 3; m = m + 1) {
        # m_i 2^(e_i - em - 52): the largest component in [1, 2); one far below flushes, as its
        # share of the unit normal does.
        var x = _geo_ldexp(load64(&mg + m * 16), load64(&mg + m * 16 + 8) - em - 52);
        if (load64(&sg + m * 8) < 0) { x = f64_neg(x); }
        store64(w + m * 8, x);
    }
    return 1;
}

# geo_triangle_unit_normal's certified fast path (3.4.1, GEO3): each component of the exact cross
# product (v1 - v0) x (v2 - v0) correctly rounded, from double arithmetic and a proven bound on its
# error, or -1 where the bound cannot certify that rounding (the caller then takes
# _geo_unit_normal_exact). On success w holds the three rounded components times the power of two
# that takes the largest into [1, 2), the doubles _geo_unit_normal_exact writes (each a single
# rounding of the same real number), so the unit normal is the exact path's bit for bit; the return
# is 1, or 0 for an exactly zero cross product. Every non-zero edge component must lie in
# [2^-400, 2^401) (else -1): nothing below overflows, and every product is normal. A non-finite
# vertex makes an edge non-finite, so it never passes.
# Component i is c = (A + a)(B + b) - (C + k)(D + d), A = RN(v1_j - v0_j) and a its rounding error
# (two_sum, exact; |a| <= u |A|, u = 2^-53), likewise B = e2_k, C = e1_k, D = e2_j.
#   * P = RN(A B) and Q = RN(C D) with their exact errors p, q: Dekker's product, each edge split
#     into two halves of at most 26 bits by rounding its significand at bit 27 in integer
#     arithmetic (the structure of Veltkamp's split; exact for normal factors, 1.6 million pairs
#     against exact rationals, ties and carries included). s = RN(P - Q) with its exact error r
#     (Fast2Sum, the larger product first). So c = s + T exactly, T = r + p - q + (A b + a B
#     - C d - k D) + (a b - k d).
#   * T~ forms the first four groups in doubles. With Pi = |A B| + |C D|: |r| + |p| + |q| <= 2 u Pi
#     (1 + u)^2, the products A b, a B, C d, k D sum to at most 2 u Pi and a b - k d (not formed) to
#     u^2 Pi; the ten roundings (four products, six sums) are each u times a partial sum below
#     4 u Pi (1 + u)^2, 14 u^2 Pi (1 + 5u) in all, so |T - T~| < 16 u^2 Pi, plus 2^-1072 for
#     products of a subnormal error (b can be one): below Eb = 2^-99 max(|P|, |Q|) by at least
#     94 u^2 max (Pi <= 2 (1 + u) max, and max >= 2^-800).
#   * y = RN(s + T~), z = s + T~ - y exactly (Fast2Sum, when |T~| <= |s|), so c lies strictly
#     between y + (z - Eb) and y + (z + Eb). The computed z +- Eb is within u |z +- Eb| < 5 u^2 max
#     of the true one (|z| <= u |y| <= 4 u (1 + u)^2 max), inside the margin, so when y + RN(z + Eb)
#     and y + RN(z - Eb) both round to y, every point between does (rounding is monotone): RN(c) = y.
#     When |T~| > |s| (z may then be inexact), |y| < 2^-48 max, so Eb > 3 ulp(y): y + RN(z + Eb) and
#     y + RN(z - Eb) are more than an ulp apart and cannot both round to y, and the test declines.
#   * Both products zero: a zero factor in each (they cannot underflow), and A + a is 0 exactly
#     when A is, so c = 0 exactly. When nothing was rounded (a, b, k, d, r, p, q all 0), c = s
#     exactly, certified whatever the bound says (integer vertices, exact cancellations).
fn _geo_unit_normal_fast(v0, v1, v2, w) {
    var p0x = load64(v0 + 0);
    var p0y = load64(v0 + 8);
    var p0z = load64(v0 + 16);
    var q1x = load64(v1 + 0);
    var e1x = f64_sub(q1x, p0x);
    var t1x = (e1x >> 52) & 0x7FF;
    if ((t1x < 623 || t1x > 1423) && (e1x & 0x7FFF_FFFF_FFFF_FFFF) != 0) { return 0 - 1; }
    var b1x = f64_sub(e1x, q1x);
    var f1x = f64_sub(f64_sub(q1x, f64_sub(e1x, b1x)), f64_add(p0x, b1x));
    var h1x = (e1x + 0x0400_0000) & 0xFFFF_FFFF_F800_0000;
    var l1x = f64_sub(e1x, h1x);
    var q2x = load64(v2 + 0);
    var e2x = f64_sub(q2x, p0x);
    var t2x = (e2x >> 52) & 0x7FF;
    if ((t2x < 623 || t2x > 1423) && (e2x & 0x7FFF_FFFF_FFFF_FFFF) != 0) { return 0 - 1; }
    var b2x = f64_sub(e2x, q2x);
    var f2x = f64_sub(f64_sub(q2x, f64_sub(e2x, b2x)), f64_add(p0x, b2x));
    var h2x = (e2x + 0x0400_0000) & 0xFFFF_FFFF_F800_0000;
    var l2x = f64_sub(e2x, h2x);
    var q1y = load64(v1 + 8);
    var e1y = f64_sub(q1y, p0y);
    var t1y = (e1y >> 52) & 0x7FF;
    if ((t1y < 623 || t1y > 1423) && (e1y & 0x7FFF_FFFF_FFFF_FFFF) != 0) { return 0 - 1; }
    var b1y = f64_sub(e1y, q1y);
    var f1y = f64_sub(f64_sub(q1y, f64_sub(e1y, b1y)), f64_add(p0y, b1y));
    var h1y = (e1y + 0x0400_0000) & 0xFFFF_FFFF_F800_0000;
    var l1y = f64_sub(e1y, h1y);
    var q2y = load64(v2 + 8);
    var e2y = f64_sub(q2y, p0y);
    var t2y = (e2y >> 52) & 0x7FF;
    if ((t2y < 623 || t2y > 1423) && (e2y & 0x7FFF_FFFF_FFFF_FFFF) != 0) { return 0 - 1; }
    var b2y = f64_sub(e2y, q2y);
    var f2y = f64_sub(f64_sub(q2y, f64_sub(e2y, b2y)), f64_add(p0y, b2y));
    var h2y = (e2y + 0x0400_0000) & 0xFFFF_FFFF_F800_0000;
    var l2y = f64_sub(e2y, h2y);
    var q1z = load64(v1 + 16);
    var e1z = f64_sub(q1z, p0z);
    var t1z = (e1z >> 52) & 0x7FF;
    if ((t1z < 623 || t1z > 1423) && (e1z & 0x7FFF_FFFF_FFFF_FFFF) != 0) { return 0 - 1; }
    var b1z = f64_sub(e1z, q1z);
    var f1z = f64_sub(f64_sub(q1z, f64_sub(e1z, b1z)), f64_add(p0z, b1z));
    var h1z = (e1z + 0x0400_0000) & 0xFFFF_FFFF_F800_0000;
    var l1z = f64_sub(e1z, h1z);
    var q2z = load64(v2 + 16);
    var e2z = f64_sub(q2z, p0z);
    var t2z = (e2z >> 52) & 0x7FF;
    if ((t2z < 623 || t2z > 1423) && (e2z & 0x7FFF_FFFF_FFFF_FFFF) != 0) { return 0 - 1; }
    var b2z = f64_sub(e2z, q2z);
    var f2z = f64_sub(f64_sub(q2z, f64_sub(e2z, b2z)), f64_add(p0z, b2z));
    var h2z = (e2z + 0x0400_0000) & 0xFFFF_FFFF_F800_0000;
    var l2z = f64_sub(e2z, h2z);
    var cx = 0;
    var ppx = f64_mul(e1y, e2z);
    var qqx = f64_mul(e1z, e2y);
    var svx = f64_sub(ppx, qqx);
    var mxx = ppx & 0x7FFF_FFFF_FFFF_FFFF;
    var rvx = 0;
    if ((qqx & 0x7FFF_FFFF_FFFF_FFFF) > mxx) {
        mxx = qqx & 0x7FFF_FFFF_FFFF_FFFF;
        rvx = f64_sub(ppx, f64_add(svx, qqx));   # Fast2Sum, |Q| > |P|
    } else {
        rvx = f64_sub(f64_sub(ppx, svx), qqx);   # Fast2Sum, |P| >= |Q|
    }
    if (mxx != 0) {
        var pex = f64_add(f64_add(f64_add(f64_sub(f64_mul(h1y, h2z), ppx), f64_mul(h1y, l2z)),
            f64_mul(l1y, h2z)), f64_mul(l1y, l2z));
        var qex = f64_add(f64_add(f64_add(f64_sub(f64_mul(h1z, h2y), qqx), f64_mul(h1z, l2y)),
            f64_mul(l1z, h2y)), f64_mul(l1z, l2y));
        var tvx = f64_add(f64_sub(f64_add(rvx, pex), qex), f64_sub(f64_add(f64_mul(e1y, f2z),
              f64_mul(f1y, e2z)), f64_add(f64_mul(e1z, f2y), f64_mul(f1z, e2y))));
        cx = f64_add(svx, tvx);
        var zvx = f64_sub(tvx, f64_sub(cx, svx));
        var epx = mxx - 0x0630_0000_0000_0000;   # 2^-99 max(|P|, |Q|)
        if (f64_add(cx, f64_add(zvx, epx)) != cx || f64_add(cx, f64_sub(zvx, epx)) != cx) {
            if (((f1y | f2z | f1z | f2y | rvx | pex | qex) & 0x7FFF_FFFF_FFFF_FFFF) != 0) { return 0 - 1; }
            cx = svx;   # nothing was rounded: the exact value
        }
    }
    var cy = 0;
    var ppy = f64_mul(e1z, e2x);
    var qqy = f64_mul(e1x, e2z);
    var svy = f64_sub(ppy, qqy);
    var mxy = ppy & 0x7FFF_FFFF_FFFF_FFFF;
    var rvy = 0;
    if ((qqy & 0x7FFF_FFFF_FFFF_FFFF) > mxy) {
        mxy = qqy & 0x7FFF_FFFF_FFFF_FFFF;
        rvy = f64_sub(ppy, f64_add(svy, qqy));   # Fast2Sum, |Q| > |P|
    } else {
        rvy = f64_sub(f64_sub(ppy, svy), qqy);   # Fast2Sum, |P| >= |Q|
    }
    if (mxy != 0) {
        var pey = f64_add(f64_add(f64_add(f64_sub(f64_mul(h1z, h2x), ppy), f64_mul(h1z, l2x)),
            f64_mul(l1z, h2x)), f64_mul(l1z, l2x));
        var qey = f64_add(f64_add(f64_add(f64_sub(f64_mul(h1x, h2z), qqy), f64_mul(h1x, l2z)),
            f64_mul(l1x, h2z)), f64_mul(l1x, l2z));
        var tvy = f64_add(f64_sub(f64_add(rvy, pey), qey), f64_sub(f64_add(f64_mul(e1z, f2x),
              f64_mul(f1z, e2x)), f64_add(f64_mul(e1x, f2z), f64_mul(f1x, e2z))));
        cy = f64_add(svy, tvy);
        var zvy = f64_sub(tvy, f64_sub(cy, svy));
        var epy = mxy - 0x0630_0000_0000_0000;   # 2^-99 max(|P|, |Q|)
        if (f64_add(cy, f64_add(zvy, epy)) != cy || f64_add(cy, f64_sub(zvy, epy)) != cy) {
            if (((f1z | f2x | f1x | f2z | rvy | pey | qey) & 0x7FFF_FFFF_FFFF_FFFF) != 0) { return 0 - 1; }
            cy = svy;   # nothing was rounded: the exact value
        }
    }
    var cz = 0;
    var ppz = f64_mul(e1x, e2y);
    var qqz = f64_mul(e1y, e2x);
    var svz = f64_sub(ppz, qqz);
    var mxz = ppz & 0x7FFF_FFFF_FFFF_FFFF;
    var rvz = 0;
    if ((qqz & 0x7FFF_FFFF_FFFF_FFFF) > mxz) {
        mxz = qqz & 0x7FFF_FFFF_FFFF_FFFF;
        rvz = f64_sub(ppz, f64_add(svz, qqz));   # Fast2Sum, |Q| > |P|
    } else {
        rvz = f64_sub(f64_sub(ppz, svz), qqz);   # Fast2Sum, |P| >= |Q|
    }
    if (mxz != 0) {
        var pez = f64_add(f64_add(f64_add(f64_sub(f64_mul(h1x, h2y), ppz), f64_mul(h1x, l2y)),
            f64_mul(l1x, h2y)), f64_mul(l1x, l2y));
        var qez = f64_add(f64_add(f64_add(f64_sub(f64_mul(h1y, h2x), qqz), f64_mul(h1y, l2x)),
            f64_mul(l1y, h2x)), f64_mul(l1y, l2x));
        var tvz = f64_add(f64_sub(f64_add(rvz, pez), qez), f64_sub(f64_add(f64_mul(e1x, f2y),
              f64_mul(f1x, e2y)), f64_add(f64_mul(e1y, f2x), f64_mul(f1y, e2x))));
        cz = f64_add(svz, tvz);
        var zvz = f64_sub(tvz, f64_sub(cz, svz));
        var epz = mxz - 0x0630_0000_0000_0000;   # 2^-99 max(|P|, |Q|)
        if (f64_add(cz, f64_add(zvz, epz)) != cz || f64_add(cz, f64_sub(zvz, epz)) != cz) {
            if (((f1x | f2y | f1y | f2x | rvz | pez | qez) & 0x7FFF_FFFF_FFFF_FFFF) != 0) { return 0 - 1; }
            cz = svz;   # nothing was rounded: the exact value
        }
    }
    var big = cx & 0x7FFF_FFFF_FFFF_FFFF;
    if ((cy & 0x7FFF_FFFF_FFFF_FFFF) > big) { big = cy & 0x7FFF_FFFF_FFFF_FFFF; }
    if ((cz & 0x7FFF_FFFF_FFFF_FFFF) > big) { big = cz & 0x7FFF_FFFF_FFFF_FFFF; }
    if (big == 0) { return 0; }
    var sc = (2046 - (big >> 52)) << 52;   # 2^(1023 - E): the largest component into [1, 2)
    store64(w, f64_mul(cx, sc));
    store64(w + 8, f64_mul(cy, sc));
    store64(w + 16, f64_mul(cz, sc));
    return 1;
}

# Half the length of geo_triangle_normal: the area, within its range (above).
public fn geo_triangle_area(tri) {
    var edge1: i64[3];
    var edge2: i64[3];
    var n: i64[3];
    _geo_sub_to(&edge1, GeoTriangle_v1(tri), GeoTriangle_v0(tri));
    _geo_sub_to(&edge2, GeoTriangle_v2(tri), GeoTriangle_v0(tri));
    _geo_cross_into(&edge1, &edge2, &n);
    return f64_mul(hvec3_length(&n), F64_HALF);
}

# (a + b + c) * RN(1/3) for one coordinate (3.4.1): where the sum overflows from finite
# operands it is formed from quarters, exact there, and multiplied back by 4, so the answer is the
# one the same arithmetic gives where it does not overflow. Through 3.4.0 three vertices at
# 7FE8000000000000 / 7FEC000000000000 gave +Inf. NaN in, NaN out.
# [measured: GEO 3.4.1 AU2-G2-F7 repro, exact Fraction oracle, 3.4.0 vs this tree, not in-tree, 2026-10-31]
fn _geo_third1(a, b, c) {
    var s = f64_add(f64_add(a, b), c);
    if ((s & 0x7FFF_FFFF_FFFF_FFFF) == 0x7FF0_0000_0000_0000) {
        var m = a & 0x7FFF_FFFF_FFFF_FFFF;
        var t = b & 0x7FFF_FFFF_FFFF_FFFF;
        if (t > m) { m = t; }
        t = c & 0x7FFF_FFFF_FFFF_FFFF;
        if (t > m) { m = t; }
        if (m < 0x7FF0_0000_0000_0000) {
            var q = f64_add(f64_add(f64_mul(a, 0x3FD0_0000_0000_0000), f64_mul(b, 0x3FD0_0000_0000_0000)),
              f64_mul(c, 0x3FD0_0000_0000_0000));   # each / 4, exact: m >= 2^1021 here
            return f64_mul(f64_mul(q, _GEO_F64_THIRD), _GEO_F64_FOUR);
        }
    }
    return f64_mul(s, _GEO_F64_THIRD);
}

# The centroid (v0 + v1 + v2) / 3, as (v0 + v1 + v2) * RN(1/3) per coordinate, at every finite
# magnitude (_geo_third1). A new HVec3, or 0 when its allocation is refused. NaN in, NaN out.
public fn geo_triangle_centroid(tri) {
    var a = GeoTriangle_v0(tri);
    var b = GeoTriangle_v1(tri);
    var c = GeoTriangle_v2(tri);
    return hvec3_new(_geo_third1(HVec3_x(a), HVec3_x(b), HVec3_x(c)), _geo_third1(HVec3_y(a), HVec3_y(b), HVec3_y(c)),
      _geo_third1(HVec3_z(a), HVec3_z(b), HVec3_z(c)));
}

# Line: origin (HVec3), direction (HVec3) -- 16 bytes
#derive(accessors)
public struct GeoLine { origin; direction; }

# 1 when all three components of v are zero, of either sign (3.4.1: the zero normal or direction
# that hvec3_normalize returns as the zero vector).
fn _geo_hvec3_is_zero(v) {
    if (((HVec3_x(v) | HVec3_y(v) | HVec3_z(v)) & 0x7FFF_FFFF_FFFF_FFFF) == 0) { return 1; }
    return 0;
}

# The line through `origin` along direction / |direction| (hvec3_normalize: any finite non-zero
# magnitude). 0, the designed failure, for a zero direction (3.4.1: no line has one, and the line
# it built returned the origin for every query) or a refused allocation.
public fn geo_line_new(origin, direction) {
    var dir = hvec3_normalize(direction);
    if (dir == 0) { return 0; }   # (3.4.0: refused, the designed 0)
    if (_geo_hvec3_is_zero(dir) == 1) { return 0; }
    var l = alloc(sizeof(GeoLine));
    if (l == 0) { return 0; }   # (3.4.0: a refused allocation is the designed 0)
    GeoLine_set_origin(l, origin);
    GeoLine_set_direction(l, dir);
    return l;
}

# The point of the line nearest `point`: origin + ((point - origin) . u) u for the stored unit
# direction u. A new HVec3, or 0 when its allocation is refused (3.4.1: the temporaries are on the
# stack, the same operations, so the same bits; a refused temporary used to be read as a vector).
public fn geo_line_closest_point(line, point) {
    var o = GeoLine_origin(line);
    var u = GeoLine_direction(line);
    var v: i64[3];
    store64(&v, f64_sub(HVec3_x(point), HVec3_x(o)));
    store64(&v + 8, f64_sub(HVec3_y(point), HVec3_y(o)));
    store64(&v + 16, f64_sub(HVec3_z(point), HVec3_z(o)));
    var t = hvec3_dot(&v, u);
    return hvec3_new(f64_add(HVec3_x(o), f64_mul(HVec3_x(u), t)), f64_add(HVec3_y(o), f64_mul(HVec3_y(u), t)),
      f64_add(HVec3_z(o), f64_mul(HVec3_z(u), t)));
}

# Segment: start (HVec3), end (HVec3) -- 16 bytes
#derive(accessors)
public struct GeoSegment { start; end; }

# A segment from start to end, both stored by reference. 0 when the allocation is refused.
public fn geo_segment_new(start, end) {
    var s = alloc(sizeof(GeoSegment));
    if (s == 0) { return 0; }   # (3.4.0: a refused allocation is the designed 0)
    GeoSegment_set_start(s, start);
    GeoSegment_set_end(s, end);
    return s;
}

# |end - start| (hvec3_length: no flush or overflow of the squares); +Inf when the ends are
# more than DBL_MAX apart.
public fn geo_segment_length(seg) {
    var d: i64[3];
    return hvec3_length(_geo_sub_to(&d, GeoSegment_end(seg), GeoSegment_start(seg)));
}

# The midpoint (start + end) / 2, correctly rounded for every finite pair of ends, the top binade
# included (_geo_mid1). A new HVec3, or 0 when its allocation is refused. NaN in, NaN out.
public fn geo_segment_midpoint(seg) {
    return _geo_mid3(GeoSegment_start(seg), GeoSegment_end(seg));
}

# 2.10.2: squared length against an unsquared tolerance -- see
# geo_triangle_unit_normal. A segment shorter than 1e-6 got a fabricated unit_x.
public fn geo_segment_direction(seg) {
    var p0 = GeoSegment_start(seg);
    var p1 = GeoSegment_end(seg);
    var ds: i64[3];
    var d = _geo_sub_to(&ds, p1, p0);
    if ((_geo_absmax_bits(d) >> 52) == 2047) {
        if (_geo_top_binade(p0, p1, p0, p1) == 1) {
            var h0: i64[3];
            var h1: i64[3];
            d = _geo_sub_to(&ds, _geo_scale_to(&h1, p1, F64_HALF), _geo_scale_to(&h0, p0, F64_HALF));
        }
    }
    # ⛔ Same shape as geo_triangle_unit_normal above: a SQUARED length against a
    # threshold meant for an unsquared one, so a valid short segment still got a
    # fabricated unit_x. `1 / sqrt(len_sq)` fails only at an exact zero.
    # ⛔ 2.17.0 — same residue as `geo_triangle_unit_normal`: `len_sq` squares
    # before summing, so a segment whose components sit below 2^-538 flushes to a
    # zero length and gets the FABRICATED unit_x, and one above 2^509 gets a
    # length of +Inf and a direction of (0,0,0). Measured: **994 of 2041 scales
    # wrong**, and at 2^-600 a (3k, 4k, 0) segment returns (1, 0, 0) where the
    # direction is (0.6, 0.8, 0).
    # ⚠ AN AXIS-ALIGNED FIXTURE CANNOT SEE THIS. The first probe used a segment
    # along +x, and the fabricated unit_x fallback IS the right answer there, so
    # it reported the low band clean. The diagonal is what discriminates.
    # [measured: 2041-binade two-sided sweep on a (3k,4k,0) segment, 2026-09-10]
    # ⛔ 3.3.3 — and a NaN length took the zero-length fallback too: `f64_gt(NaN, 0)`
    # is 0, so a segment with a NaN at either end returned the fabricated (1, 0, 0).
    # The test is now an exact zero, and a NaN direction is NaN in every component,
    # as `hvec3_normalize(end - start)` is. See geo_triangle_unit_normal.
    # [measured: G6 scratch probe on the 3.3.2 bundle, not reproducible in-tree, 2026-10-01; cycc 6.6.12]
    # ⛔ 3.3.4 — `1 / len` OVERFLOWS FOR A SUBNORMAL LENGTH, SO THE SECOND unit_x
    # FALLBACK WAS STILL A FABRICATION (roadmap D087). Below about 2^-1024 the
    # reciprocal is +Inf and every such segment got unit_x. `_geo_unit_or` scales d
    # by a power of two first, exactly, so the length it divides by is normal and the
    # fallback is left for the zero segment. On the integer grid
    # (i, j, l) * 2^-1074, |i|, |j| <= 6, l in {0, 1, 3}, 500 of 506 directions were
    # wrong and none is now; over 83513 segments in all (30 directions at every
    # 2^e, and 20000 mixed ends) 2361 moved into 4 * 2^-53 of the exact direction
    # and none left it.
    # ⚠ NOT DIRECT DIVISION BY `len`. A subnormal `len` is itself rounded to the
    # subnormal grid: (-6, -6, 0) * 2^-1074 has a length of 8 * 2^-1074 there, and
    # d / len gives (-0.75, -0.75, 0), a vector of length 1.06. That route was wrong
    # for 452 of the 506 grid directions and 2134 of the 83513.
    # [measured: georay segment sweep, exact oracle, 3.3.3 geo.cyr vs repaired, 2026-10-03; cycc 6.6.14]
    # Ends more than DBL_MAX apart overflow end - start itself, so with a coordinate
    # in the top binade both ends are halved first (_geo_top_binade). 20000 segments
    # with coordinates up to DBL_MAX: 14443 right before, all 20000 now.
    # [measured: georay top-binade segment sweep, exact oracle, 3.3.3 geo.cyr vs repaired, 2026-10-03; cycc 6.6.14]
    # ⛔ 3.3.5 — HALVED ONLY WHEN THE DIFFERENCE OVERFLOWED. 3.3.4 halved whenever a
    # coordinate was in the top binade, which drops a subnormal last bit, and where
    # the big coordinates cancel that bit is the whole difference:
    # (2^1023, 2^-1074, 0) -> (2^1023, 0, 0) got the unit_x fallback, not (0, -1, 0).
    # An infinite component of d from finite ends can only be an overflow, so that is
    # the test. 80001 segments (the repro, and 20000 each: top-binade coordinates
    # shared by both ends, overflowing differences, random top-binade ends, none in
    # the top binade), against the exact direction within 4 * 2^-53: 120 wrong ->
    # right, none right -> wrong, and the 20000 without a top-binade coordinate keep
    # their bits. 748 right answers moved, 249 closer and 102 further (at most
    # 1.61 * 2^-53 off, from `_geo_unit_or`'s reciprocal of the exact difference's
    # length where 3.3.4 took the halved difference's).
    # [measured: G1 segment sweep, exact Fraction/Decimal oracle, 3.3.4 tree vs this one, 2026-10-11; cycc 6.6.14]
    return _geo_unit_or(d, hvec3_unit_x());
}

# 2.10.2, and this one is LOAD-BEARING beyond itself: geo_segment_distance_to_point
# builds on it and is what a caller reaches for as an ORACLE when checking a
# capsule surface. Against the unsquared EPSILON_F64 it collapsed any segment
# shorter than 1e-6 to its start point, so the distance from that segment's own
# MIDPOINT came back as half its length instead of 0. The commissioned probe that
# found the capsule defects was silently misled by exactly that.
public fn geo_segment_closest_point(seg, point) {
    var a = GeoSegment_start(seg);
    var b = GeoSegment_end(seg);
    var ab: i64[3];
    var w: i64[3];
    for (var i = 0; i < 3; i = i + 1) {
        store64(&ab + i * 8, f64_sub(load64(b + i * 8), load64(a + i * 8)));
        store64(&w + i * 8, f64_sub(load64(point + i * 8), load64(a + i * 8)));
    }
    var len_sq = hvec3_dot(&ab, &ab);
    # ⛔ Same class. Here the division IS by `len_sq`, but `t` is clamped to [0,1]
    # immediately after, so a subnormal denominator cannot produce a bad answer —
    # only an exact zero can. Collapsing a valid short segment to its start point
    # is what 2.10.2 recorded as misleading its own capsule probe.
    # ⛔ 3.3.3 — the test was `f64_gt(len_sq, 0) == 0`, TRUE for NaN, so a segment
    # whose END was NaN collapsed to its finite start: the closest point to (1,1,1)
    # on (0,0,0)-(NaN,0,0) came back (0,0,0) and the distance sqrt(3), both
    # plausible. Only an exact zero is a point segment; a NaN `len_sq` now reaches
    # the division, `f64_clamp` passes the NaN `t` through, and every component of
    # the point, and so `geo_segment_distance_to_point`, is NaN. (A NaN START was
    # NaN only in its own NaN coordinate: the fallback returned the start itself.)
    # [measured: G6 scratch probe on the 3.3.2 bundle, not reproducible in-tree, 2026-10-01; cycc 6.6.12]
    # ⛔ 3.4.1 — |ab|^2 AND (p - a) . ab LEAVE THE RANGE LONG BEFORE THE SEGMENT DOES (AU2-G2-F2): ends
    # 2^-540 apart flushed |ab|^2 to 0 and the end itself, queried, came back as the start (distance
    # 1E453C1BB13EF484 for 0); the midpoint of a segment at 2^600 was Inf / Inf, NaN. Where |ab|^2 is
    # normal and the numerator finite this is 3.4.0's arithmetic, bit for bit (the temporaries on the
    # stack, the same operations); elsewhere t comes from copies of ab and p - a each scaled near 1
    # (_geo_seg_t_scaled), and only ab = 0 exactly, a point segment, is the start. 1,628 segments
    # (AU2's families): 700 wrong before, every one at <= 2^-519 or >= 2^511.
    # [measured: GEO 3.4.1 seg_sweep.py, 20000 segments x2 seeds, 3.4.0 vs this tree, 2026-10-31]
    var lsg = len_sq & 0x7FFF_FFFF_FFFF_FFFF;
    if (lsg < 0x0010_0000_0000_0000 || lsg >= 0x7FF0_0000_0000_0000) {
        return _geo_seg_closest_scaled(a, b, point, &ab, &w);
    }
    var num = hvec3_dot(&w, &ab);
    if ((num & 0x7FFF_FFFF_FFFF_FFFF) >= 0x7FF0_0000_0000_0000) {
        return _geo_seg_closest_scaled(a, b, point, &ab, &w);
    }
    var t = f64_clamp(f64_div(num, len_sq), 0, F64_ONE);
    return hvec3_new(f64_add(HVec3_x(a), f64_mul(HVec3_x(&ab), t)), f64_add(HVec3_y(a), f64_mul(HVec3_y(&ab), t)),
      f64_add(HVec3_z(a), f64_mul(HVec3_z(&ab), t)));
}

# geo_segment_closest_point outside the range of |ab|^2 (3.4.1), with ab = b - a and w = p - a formed
# (stack vectors). A NaN or infinite input keeps 3.4.0's arithmetic (NaN in, NaN out; the start for
# a zero length). ab = 0 exactly is a point segment: the start. Where ab or w overflowed from finite
# input both are formed from halved points (t does not change) and the point is formed at half size
# and doubled. t = (w . ab) / (ab . ab) is invariant under scaling w and ab separately but for the
# factor s_ab / s_w, so each is multiplied by the power of two that takes it near 1, t' formed there
# and taken back exactly (_geo_ldexp), then clamped to [0, 1].
fn _geo_seg_closest_scaled(a, b, p, ab, w) {
    if ((_geo_hvec3_finite(a) & _geo_hvec3_finite(b) & _geo_hvec3_finite(p)) == 0) {
        var ls = hvec3_dot(ab, ab);
        if (f64_eq(ls, 0) == 1) { return a; }
        var tp = f64_clamp(f64_div(hvec3_dot(w, ab), ls), 0, F64_ONE);
        return hvec3_new(f64_add(HVec3_x(a), f64_mul(HVec3_x(ab), tp)), f64_add(HVec3_y(a), f64_mul(HVec3_y(ab), tp)),
          f64_add(HVec3_z(a), f64_mul(HVec3_z(ab), tp)));
    }
    var hv = 0;
    if ((_geo_hvec3_finite(ab) & _geo_hvec3_finite(w)) == 0) {
        for (var i = 0; i < 3; i = i + 1) {
            var ah = f64_mul(load64(a + i * 8), F64_HALF);
            store64(ab + i * 8, f64_sub(f64_mul(load64(b + i * 8), F64_HALF), ah));
            store64(w + i * 8, f64_sub(f64_mul(load64(p + i * 8), F64_HALF), ah));
        }
        hv = 1;
    }
    var mab = _geo_absmax_bits(ab);
    if (mab == 0) { return a; }
    var mw = _geo_absmax_bits(w);
    var sa = _geo_scale_for(mab >> 52);
    var sw = _geo_scale_for(mw >> 52);
    var abs: i64[3];
    var ws: i64[3];
    for (var k = 0; k < 3; k = k + 1) {
        store64(&abs + k * 8, f64_mul(load64(ab + k * 8), sa));
        store64(&ws + k * 8, f64_mul(load64(w + k * 8), sw));
    }
    var t = f64_div(hvec3_dot(&ws, &abs), hvec3_dot(&abs, &abs));
    t = f64_clamp(_geo_ldexp(t, (sa >> 52) - (sw >> 52)), 0, F64_ONE);
    if (hv == 0) {
        return hvec3_new(f64_add(HVec3_x(a), f64_mul(HVec3_x(ab), t)), f64_add(HVec3_y(a), f64_mul(HVec3_y(ab), t)),
          f64_add(HVec3_z(a), f64_mul(HVec3_z(ab), t)));
    }
    var r: i64[3];
    for (var j = 0; j < 3; j = j + 1) {
        var hj = f64_add(f64_mul(load64(a + j * 8), F64_HALF), f64_mul(load64(ab + j * 8), t));
        store64(&r + j * 8, f64_mul(hj, F64_TWO));
    }
    return hvec3_new(HVec3_x(&r), HVec3_y(&r), HVec3_z(&r));
}

# |point - closest point of the segment| (geo_segment_closest_point, then hvec3_length: no flush or
# overflow of the squares); +Inf where that distance passes DBL_MAX. NaN in, NaN out, and NaN when
# the closest point's allocation is refused.
public fn geo_segment_distance_to_point(seg, point) {
    var q = geo_segment_closest_point(seg, point);
    if (q == 0) { return 0x7FF8_0000_0000_0000; }
    var d: i64[3];
    return hvec3_length(_geo_sub_to(&d, point, q));
}

# ================================================================
# Ray intersection tests
# ================================================================
# All return 0 on miss, positive f64 t parameter on hit.
#
# A CONTACT AT t = 0 IS THE MISS (3.3.6, the one rule for every primal and jet). A ray
# whose origin lies on the surface has t = 0, which is the miss sentinel; the plane,
# triangle, sphere and slab routines return +0.0 or -0.0 there, the sign being whatever
# their arithmetic gives (a plane met from the back, a triangle along +z from its own
# face, a slab's 0 / d_k with d_k < 0), so the sign is not a discriminator: test the
# answer with f64_eq(t, 0), which is 1 for both. Every jet in geo_diff.cyr does, and
# answers its miss for either zero. Through 3.3.5 the jets tested the integer t == 0,
# so a -0.0 contact got a hit jet with gradients and a +0.0 one the miss. The face
# routines still report the contact's face in `out` beside the zero t.
#
# ----------------------------------------------------------------
# FACE-REPORTING VARIANTS (2.10.1)
# ----------------------------------------------------------------
#
# `geo_ray_aabb` and `geo_ray_obb` pick their answer through f64_max / f64_min
# across three slabs and then DISCARD which slab won. A differentiable caller
# needs that back -- the derivative of t is per-face, and `src/geo_diff.cyr`
# cannot form it from t alone -- and so does an ordinary caller that wants the
# surface normal at the hit without recomputing it.
#
# So each has a `_face` variant taking an out-pointer, with the plain entry point
# becoming a one-line wrapper that passes 0. THE VALUE PATH IS UNCHANGED BY
# CONSTRUCTION: the f64_max / f64_min calls are byte-for-byte what they were, the
# face bookkeeping is additive, and every added line sits behind `if (out != 0)`,
# so a non-differentiating caller pays one i64 compare per slab and nothing else.
# The existing assertions gate that equivalence.
#
# FACE ENCODING: 2 * axis + plane, where axis is 0/1/2 for x/y/z (for the OBB,
# its own local axis 0/1/2) and plane is 0 for the min side, 1 for the max side.
# GEO_FACE_NONE (-1) means no face was selected.
# ⛔ 3.3.4 — A NaN NO LONGER COMES BACK AS A NUMBER (roadmap D034). Through 3.3.3
# f64_max / f64_min erased a NaN slab whenever a later slab won, and a parallel
# slab's two tests, both false against a NaN, skipped it: a NaN input came back as
# a finite t (with a real face or GEO_FACE_NONE), as the miss 0, or as a NaN t
# that kept an earlier slab's real face. CHANGELOG 3.3.3 lists each pairing. Now a
# NaN anywhere in the ray, the box or the OBB (rotation included) returns a NaN t
# with GEO_FACE_NONE and no tie, as geo_ray_sphere, _plane and _capsule do:
#   * a slab whose arithmetic forms a NaN returns the first NaN among the inputs
#     (_geo_ray_aabb_nan_or_miss, _geo_ray_obb_nan). `t_min < t_max` replaces the
#     `t_min > t_max` miss test: one compare on the hit path, as before, and only
#     when it fails are the miss, the tie and the NaN told apart;
#   * a parallel slab tests its own inputs for NaN, after its two miss tests;
#   * a miss found before the last slab has read every input returns the first
#     NaN among them instead, if there is one (_geo_ray_aabb_nan_or_miss; for the
#     OBB only the half-extents, because local axis 0 reads every other input);
#   * so for NaN input a real face comes back only with a finite t, and the
#     pairings are GEO_FACE_NONE with the miss 0, GEO_FACE_NONE with a NaN t, and a
#     face with a finite t. The jets in src/geo_diff.cyr answer their miss for the
#     first two. A NaN made from input with none is another matter (below).
# Over 2500 random rays and boxes per routine, aimed and not, a third along an
# axis, with a NaN put in each input slot in turn: geo_ray_aabb_face returned a
# finite t > 0 for 11621 of 30000 (9477 with a real face), the miss 0 for 13123
# and a NaN t with a real face for 4163; geo_ray_obb_face (16 slots) a finite
# t > 0 for 3473 of 40000 and the miss for 2475. All 70000 are NaN with
# GEO_FACE_NONE, no tie and the miss jet now. The 2500 clean inputs per routine,
# and 14400 AABB inputs with one infinite slot, are bit-identical in t, face, tie
# and jet; for the half-extent signs see geo_ray_obb_face.
# [measured: georay slab sweep, 3.3.3 geo.cyr vs repaired, 3.3.4 tree, not in-tree, 2026-10-03; cycc 6.6.14]
# ⚠ ONLY A NaN THE CALLER SUPPLIED IS RETURNED. The arithmetic also makes NaN from
# input with none: Inf - Inf where an infinite origin meets an infinite bound of the
# same sign, and in the OBB's frame 0 * Inf where an axis's exact zero component
# meets an infinite component of the ray or of c - o, which overflows for finite
# ends more than DBL_MAX apart. Such a slab finds no NaN among the inputs and goes
# on as in 3.3.3, so that NaN can still leave as t with an earlier slab's real face
# (tests/modules.tcyr pins one per routine), and the jets' own t test answers their
# miss for it. Returning it instead, as the first draft of D034 did, turned 1377 of
# 6000 finite OBB inputs with an overflowing c - o (all but 4 geometric misses) and
# 473 of 4000 AABB inputs with two infinite slots into NaN.
# [measured: D034 review sweep, 3.3.3 geo.cyr vs 3.3.4 drafts, not in-tree, 2026-10-03; cycc 6.6.14]
# Inputs with no NaN keep 3.3.3's bits but for the OBB's half-extent signs
# (geo_ray_obb_face) and an inverted AABB (AN INVERTED BOX, below): over 14235 AABB
# and 20200 OBB inputs (finite, near DBL_MAX, one or two infinite slots, +-0,
# subnormal), t, face, tie, jet and the plain entry match 3.3.3 in all but 10 OBB
# inputs, each with a negative half-extent. 28000 NaN inputs (four payloads, one per
# slot) are each a NaN t, GEO_FACE_NONE, no tie, the miss jet and a NaN plain t.
# [measured: slab differential, 3.3.4-base bundle vs this tree, not in-tree, 2026-10-03; cycc 6.6.14]
# The siblings differ already: from (0, Inf, 1.5) and from (-Inf, 0.5, 0.5) along +x,
# geo_ray_sphere and _capsule answer NaN, geo_ray_plane NaN and +Inf, geo_ray_aabb
# and _triangle the miss. No contract says which a non-finite input should get, and this does not
# decide it (3.4.1: through 3.4.0 this and five comments below cited an open roadmap row on it that
# did not exist).
# [measured: georay infinite-origin probe, 3.3.4 tree before this change, not in-tree, 2026-10-03; cycc 6.6.14]
#
# OUT BLOCK: 16 bytes, two i64 slots.
#   out[0] = the face index above
#   out[1] = 1 when the selected extremum was achieved by MORE THAN ONE slab,
#            i.e. the ray hit an edge or a corner exactly. `t` has a genuine kink
#            there -- the selected face, and therefore the derivative, differs on
#            either side -- so a differentiating caller must not read a gradient.
#            Reported rather than resolved: picking a side would be a silent
#            wrong answer, and the grazing-incidence convention in geo_diff.cyr
#            is already to return the miss sentinel at a non-differentiable point.
public var GEO_FACE_NONE      = -1;
public var GEO_FACE_OUT_BYTES = 16;

# THE CAPSULE reports a BRANCH, not a face: its surface is three pieces, and the
# derivative differs per piece even though the surface itself is C1 where they
# meet. out[1] is unused (always 0) -- a capsule has no edge, so there is no tie
# to report. The cap/cylinder seam IS differentiable: hemisphere and cylinder are
# tangent there, and the two branches' gradients agree in the limit, which the
# suite asserts rather than assumes.
public var GEO_CAP_CYLINDER  = 0;
public var GEO_CAP_START_CAP = 1;
public var GEO_CAP_END_CAP   = 2;
public var GEO_CAP_SPHERE    = 3;    # degenerate capsule: start == end, a plain sphere

# 1 when x is +/-Infinity, 0 otherwise -- INCLUDING for NaN, which is the whole
# point of writing it this way. 2.10.2: the slab routines return `0 on miss,
# positive f64 t on hit` and +Inf is neither; an adversarial fuzz found 230 of
# 20,000 configurations returning a non-finite t from entirely FINITE inputs,
# where the true value simply overflowed the exponent range.
# [measured: docs/development/issues/archived/2026-08-10-slab-parallel-test-is-scale-free.md]
#
# ⚠ NaN IS DELIBERATELY LEFT ALONE, and the first draft of this got it wrong.
# A `f64_lt(f64_abs(x), POS_INF)` finiteness test rejects NaN too -- and that
# broke tests/abuse.tcyr's "geo_ray_aabb: a NaN ray yields NaN, not a fabricated
# hit distance", which 2.9.0 asserted with a written reason: the miss sentinel is
# 0, so turning a NaN ray into 0 reports "no hit" for an input the caller has no
# business supplying, while a NaN return is unmistakable at the call site. That
# is a considered contract decision and this repair has no business overturning
# it in passing. The remaining NaN question -- a NaN in ONE axis being erased by
# f64_max and laundered into a plausible finite t -- is real, is module-wide
# (geo_ray_sphere, _plane and _triangle behave the same), and is filed rather
# than decided here.
# ⚠ 3.3.3 — "MODULE-WIDE" WAS WRONG. With one NaN coordinate in each input of
# each ray routine, over 2000 random rays aimed at the shape, geo_ray_sphere and
# geo_ray_plane answer NaN for every input coordinate, on 3.3.2 too;
# geo_ray_triangle answers NaN for a NaN origin and its miss, 0, for a NaN
# direction or vertex (its reciprocal guard); geo_ray_capsule answers NaN for
# every input coordinate since its 3.3.3 NaN-axis exit. Only the two slab
# routines turn the NaN into a finite t, through f64_max / f64_min and the
# parallel-slab branch: roadmap [3.3.4] D034. The `t < 0` tail tests of these
# two and of geo_ray_sphere stay NaN-true on purpose: each PAIR respelled
# NaN-false turns the NaN that reaches it into the miss 0 (every NaN-direction
# OBB ray did); one test alone changes no t, because the other still returns the
# NaN. tests/abuse.tcyr pins all three pairs.
# [measured: W1 ray sweep on the 3.3.2 and 3.3.3 bundles, not reproducible in-tree, 2026-10-01; cycc 6.6.12]
# ⚠ 3.3.4 — D034 is repaired (see FACE ENCODING above), and no NaN INPUT reaches the
# two slab routines' tails any more: the slab that reads it returns it. A NaN made
# from input with none (Inf - Inf, 0 * Inf) still does, as in 3.3.3, and their
# NaN-true tail pairs carry it out: respelled NaN-false, either pair turns it into
# the miss 0 (tests/modules.tcyr pins both). geo_ray_sphere's pair still carries a
# NaN input.
# THE INFINITY TEST, written inline at its four use sites rather than as a
# function:
#
#     is_inf(x)  ==  f64_eq(f64_abs(x), _GEO_F64_POS_INF)
#
# Measured, and the reason it is not a function: as a call it cost 5 ns of a
# 90 ns routine (+5.6% on `ray_aabb`, A higher in 3 of 3 interleaved pairs);
# inlined, the same repair measures +1.1% there -- inside this release's 3.5%
# noise floor -- and +2.9% on `ray_aabb_diag`, which reaches the tail check on
# every call. [measured: bench-history.csv ray_aabb_diag]

# Axis (0/1/2) of an encoded face.
public fn geo_face_axis(face) {
    return face / 2;
}

# 1 if the face is a max-side plane, 0 if min-side.
public fn geo_face_is_max(face) {
    return face % 2;
}

# Ray-plane intersection
# Returns t > 0 on hit, 0 on miss -- and a ZERO is also what a t = 0 hit returns,
# so a ray whose origin lies exactly in the plane is reported as a miss. That
# collision is the module convention (file header, ray-section header, every
# sibling), not an oversight: callers who must distinguish an origin-on-surface
# hit use the dedicated predicate idiom (0 miss, 1 hit, 2 cannot tell), as
# `_bvh_ray_hits_aabb` does for AABBs.
#
# WHICH zero comes back depends on the sign of `denom`, because t is 0 / denom:
# denom < 0 gives -0.0 (0x8000000000000000) and denom > 0 gives +0.0 (0), which is
# byte-identical to the miss return. Both are f64-equal to zero, so no f64_lt /
# f64_gt / f64_eq test separates a grazing hit from a miss in either direction --
# do not read the raw bits as a discriminator. Measured, and pinned in
# tests/modules.tcyr.
# [measured: tests/modules.tcyr "geo_ray_plane: origin ON the plane, denom < 0 -> negative zero" and its +0.0 twin]
#
# BEHAVIOUR CHANGE at 2.7.0: returns 0 on a miss, matching this module's stated
# convention (twice: file header and the ray-section header) and every sibling
# intersection function. Through 2.6.15 it returned the raw i64 -1, which as an
# f64 bit pattern is 0xFFFFFFFFFFFFFFFF -- a NEGATIVE NaN. That sentinel was
# detectable only by raw integer comparison; any consumer that did f64 arithmetic
# on it, or tested it with f64_lt/f64_gt, silently propagated NaN. No caller in
# src/ depended on -1.
#
# The line this replaces claimed the OPPOSITE ("-1 on miss, negative sentinel, not
# 0, to distinguish t = 0 hits") and sat directly above the 2.7.0 note correcting
# it; it described the pre-2.7.0 code and was never updated. Audit 2026-08-04,
# api-consistency (low). Pinned by tests/modules.tcyr, "geo_ray_plane: the doc's
# return convention, pinned".
public fn geo_ray_plane(ray, plane) {
    var denom = hvec3_dot(GeoPlane_normal(plane), GeoRay_direction(ray));
    # ⛔ `denom` = n·d carries the MAGNITUDE of the ray direction, so this absolute
    # 1e-12 made the answer depend on how long the caller's direction vector is.
    # Measured: plane z = 0, ray from (0,0,5) along (0,0,-2^-40) returns 0 — the
    # module's documented MISS — where the true hit is t = 5*2^40.
    # [measured: shipped binary, direction magnitude sweep]
    # ⛔ 3.4.1 — AND THE DBL_MIN THAT REPLACED IT REFUSED FINITE HITS (AU2-G2-F4): plane z = 0, origin
    # (0, 0, 8173C0CA428C59FB) along (1, 0, 00001E06522C8B91) has n . d subnormal and t =
    # 41C50D793FFAFE38 (7.06e8), and answered the miss. Below DBL_MIN the quotient is formed from
    # exact products instead (_geo_ray_plane_small); only an exactly parallel ray is the miss.
    # [measured: GEO 3.4.1 plane_sweep.py, 20000 rays x2 seeds, 3.4.0 vs this tree, 2026-10-31]
    if (f64_lt(f64_abs(denom), _GEO_F64_TINY) == 1) {
        # (A zero factor in each of the three products: exactly parallel, the miss, as 3.4.0 cheaply.)
        if ((denom & 0x7FFF_FFFF_FFFF_FFFF) == 0) {
            var pn = GeoPlane_normal(plane);
            var pd = GeoRay_direction(ray);
            if (((HVec3_x(pn) & 0x7FFF_FFFF_FFFF_FFFF) == 0 || (HVec3_x(pd) & 0x7FFF_FFFF_FFFF_FFFF) == 0)
              && ((HVec3_y(pn) & 0x7FFF_FFFF_FFFF_FFFF) == 0 || (HVec3_y(pd) & 0x7FFF_FFFF_FFFF_FFFF) == 0)
              && ((HVec3_z(pn) & 0x7FFF_FFFF_FFFF_FFFF) == 0 || (HVec3_z(pd) & 0x7FFF_FFFF_FFFF_FFFF) == 0)) {
                return 0;
            }
        }
        return _geo_ray_plane_small(ray, plane, denom);
    }
    var t = f64_div(f64_sub(GeoPlane_distance(plane), hvec3_dot(GeoPlane_normal(plane), GeoRay_origin(ray))), denom);
    if (f64_lt(t, 0) == 1) { return 0; }
    return t;
}

# c0 + a . b (neg 0) or c0 - a . b (neg 1) correctly rounded to 53 bits, from double arithmetic behind
# a proven bound (3.4.1, GEO5), in _geo_xi_val's form: out[0] = +-m (m an integer in [2^52, 2^53), held
# as a double) and out[1] the exponent, the sum being out[0] 2^out[1]. Returns the sum's sign (-1, 1,
# or 0 for a sum that is exactly 0 because every pair has a zero factor and c0 is 0), or -2 where the
# bound cannot certify the rounding: the caller then forms the sum as an integer (_geo_xi_add2), so
# either way the pair is the same. a and b are finite vectors, c0 a finite double.
#   * A pair with a zero factor adds exactly 0 and is dropped; a and b are taken by the powers of two
#     2^ka, 2^kb that bring the largest of their remaining components into [1, 2) (exact, but where a
#     much smaller component falls below 2^-1022), c0 by 2^(ka + kb) through its exponent field (a
#     subnormal c0, or the scaled exponent outside [61, 1985], declines).
#   * Each product a_i b_i = P_i + p_i exactly (Dekker: both factors split into 26-bit halves at bit 27,
#     as _geo_unit_normal_fast splits them); P_x + P_y + P_z (negated for neg) and c0 are summed by
#     two_sum into s and their errors, so the scaled sum is s + T, T the two_sum errors plus or minus
#     p_x + p_y + p_z, formed as T~ with |T - T~| <= 5.01 u (|p| + |two_sum errors|) <= 20.1 u^2 (sum
#     |P_i| + |c0|) < 2^-101.6 (sum |P_i| + |c0|) (u = 2^-53), and up to 2^-1073 more for each product
#     a component below 2^-1022 made inexact: Eb = 2^-100 (sum |P_i| + |c0|) + 2^-1060 covers both
#     with a third of itself to spare. s exactly 0 (the leading terms cancel) declines at once.
#   * y = RN(s + T~), z = T~ - (y - s) (Fast2Sum, exact when |T~| <= |s|): the sum lies within Eb of
#     y + z, and when y + RN(z + Eb) and y + RN(z - Eb) both round to y, so does every point between
#     (rounding is monotone; the spare third covers RN(z +- Eb)'s own rounding): the sum's rounding is
#     y (_geo_unit_normal_fast's certificate). When |T~| > |s|, |y| <= 8.01 u (sum |P_i| + |c0|), so
#     Eb > 3.9 ulp(y) and the test declines whatever z is. y must also lie in [2^-1000, 2^1000), where
#     its rounding is the 53-bit one.
fn _geo_plane_dot_fast(a, b, c0, neg, out) {
    # A pair with a zero factor adds exactly 0 whatever the other factor: both are dropped, so only
    # the pairs that contribute set the scales.
    var ax = load64(a);
    var bx = load64(b);
    if ((ax & 0x7FFF_FFFF_FFFF_FFFF) == 0 || (bx & 0x7FFF_FFFF_FFFF_FFFF) == 0) {
        ax = 0;
        bx = 0;
    }
    var ay = load64(a + 8);
    var by = load64(b + 8);
    if ((ay & 0x7FFF_FFFF_FFFF_FFFF) == 0 || (by & 0x7FFF_FFFF_FFFF_FFFF) == 0) {
        ay = 0;
        by = 0;
    }
    var az = load64(a + 16);
    var bz = load64(b + 16);
    if ((az & 0x7FFF_FFFF_FFFF_FFFF) == 0 || (bz & 0x7FFF_FFFF_FFFF_FFFF) == 0) {
        az = 0;
        bz = 0;
    }
    var ma = ax & 0x7FFF_FFFF_FFFF_FFFF;
    var mt = ay & 0x7FFF_FFFF_FFFF_FFFF;
    if (mt > ma) { ma = mt; }
    mt = az & 0x7FFF_FFFF_FFFF_FFFF;
    if (mt > ma) { ma = mt; }
    if (ma == 0) {
        # a . b is exactly 0: the sum is c0, already a double (a subnormal c0 takes the integer sum).
        store64(out, 0);
        store64(out + 8, 0);
        if ((c0 & 0x7FFF_FFFF_FFFF_FFFF) == 0) { return 0; }
        if ((c0 & 0x7FF0_0000_0000_0000) == 0) { return 0 - 2; }
        store64(out, (c0 & 0x800F_FFFF_FFFF_FFFF) | 0x4330_0000_0000_0000);
        store64(out + 8, ((c0 >> 52) & 0x7FF) - 1075);
        if (c0 < 0) { return 0 - 1; }
        return 1;
    }
    var mb = bx & 0x7FFF_FFFF_FFFF_FFFF;
    mt = by & 0x7FFF_FFFF_FFFF_FFFF;
    if (mt > mb) { mb = mt; }
    mt = bz & 0x7FFF_FFFF_FFFF_FFFF;
    if (mt > mb) { mb = mt; }
    var ka = 1023 - (ma >> 52);
    if (ka < 0 - 1022) { ka = 0 - 1022; }
    var kb = 1023 - (mb >> 52);
    if (kb < 0 - 1022) { kb = 0 - 1022; }
    var sa = (1023 + ka) << 52;
    var sb = (1023 + kb) << 52;
    var cs = 0;
    if ((c0 & 0x7FFF_FFFF_FFFF_FFFF) != 0) {
        var ec = ((c0 >> 52) & 0x7FF) + ka + kb;
        if ((c0 & 0x7FF0_0000_0000_0000) == 0 || ec < 61 || ec > 1985) { return 0 - 2; }
        cs = (c0 & 0x800F_FFFF_FFFF_FFFF) | (ec << 52);
    }
    ax = f64_mul(ax, sa);
    ay = f64_mul(ay, sa);
    az = f64_mul(az, sa);
    bx = f64_mul(bx, sb);
    by = f64_mul(by, sb);
    bz = f64_mul(bz, sb);
    var px = f64_mul(ax, bx);
    var py = f64_mul(ay, by);
    var pz = f64_mul(az, bz);
    var s1 = f64_add(px, py);
    var hb = f64_sub(s1, px);
    var tt = f64_add(f64_sub(px, f64_sub(s1, hb)), f64_sub(py, hb));
    var s2 = f64_add(s1, pz);
    hb = f64_sub(s2, s1);
    tt = f64_add(tt, f64_add(f64_sub(s1, f64_sub(s2, hb)), f64_sub(pz, hb)));
    var sm = f64_add(f64_add(f64_abs(px), f64_abs(py)), f64_abs(pz));
    if (neg == 1) {
        s2 = f64_neg(s2);
        tt = f64_neg(tt);
    }
    if (cs != 0) {
        var s3 = f64_add(cs, s2);
        hb = f64_sub(s3, cs);
        tt = f64_add(tt, f64_add(f64_sub(cs, f64_sub(s3, hb)), f64_sub(s2, hb)));
        s2 = s3;
        sm = f64_add(sm, f64_abs(cs));
    }
    if ((s2 & 0x7FFF_FFFF_FFFF_FFFF) == 0) { return 0 - 2; }   # the leading terms cancel exactly: the integer sum
    # Dekker's product errors (the halves rounded at bit 27, as _geo_unit_normal_fast splits them).
    var ha = (ax + 0x0400_0000) & 0xFFFF_FFFF_F800_0000;
    var la = f64_sub(ax, ha);
    var hc = (bx + 0x0400_0000) & 0xFFFF_FFFF_F800_0000;
    var lc = f64_sub(bx, hc);
    var pe = f64_add(f64_add(f64_add(f64_sub(f64_mul(ha, hc), px), f64_mul(ha, lc)), f64_mul(la, hc)), f64_mul(la, lc));
    ha = (ay + 0x0400_0000) & 0xFFFF_FFFF_F800_0000;
    la = f64_sub(ay, ha);
    hc = (by + 0x0400_0000) & 0xFFFF_FFFF_F800_0000;
    lc = f64_sub(by, hc);
    pe = f64_add(pe, f64_add(f64_add(f64_add(f64_sub(f64_mul(ha, hc), py), f64_mul(ha, lc)), f64_mul(la, hc)),
        f64_mul(la, lc)));
    ha = (az + 0x0400_0000) & 0xFFFF_FFFF_F800_0000;
    la = f64_sub(az, ha);
    hc = (bz + 0x0400_0000) & 0xFFFF_FFFF_F800_0000;
    lc = f64_sub(bz, hc);
    pe = f64_add(pe, f64_add(f64_add(f64_add(f64_sub(f64_mul(ha, hc), pz), f64_mul(ha, lc)), f64_mul(la, hc)),
        f64_mul(la, lc)));
    if (neg == 1) { pe = f64_neg(pe); }
    tt = f64_add(tt, pe);
    var y = f64_add(s2, tt);
    var yb = y & 0x7FFF_FFFF_FFFF_FFFF;
    if (yb < 0x0170_0000_0000_0000 || yb >= 0x7E70_0000_0000_0000) { return 0 - 2; }   # [2^-1000, 2^1000)
    var zz = f64_sub(tt, f64_sub(y, s2));
    var eb = f64_add(f64_mul(sm, 0x39B0_0000_0000_0000), 0x4000);   # 2^-100 (sum |P| + |c0|) + 2^-1060
    if (f64_add(y, f64_add(zz, eb)) != y || f64_add(y, f64_sub(zz, eb)) != y) { return 0 - 2; }
    # y's significand as the integer m (its bits with the exponent field of 2^52), and its exponent
    # less the scales'.
    store64(out, (y & 0x800F_FFFF_FFFF_FFFF) | 0x4330_0000_0000_0000);
    store64(out + 8, ((yb >> 52) - 1075) - ka - kb);
    if (y < 0) { return 0 - 1; }
    return 1;
}

# geo_ray_plane where |n . d| is below DBL_MIN (3.4.1): n . d and d0 - n . o correctly rounded to 53
# bits, as exact integer sums of their products (_geo_xi_add2), so no product is lost however far
# below the others it lies (a cancellation of the large ones leaves it: see "Exact sums" below), and t
# is their quotient with one more rounding back (_geo_ldexp); +Inf past DBL_MAX, as the plain quotient
# gives it. n . d exactly 0 is a parallel ray, the miss. A non-finite origin or distance takes the
# plain quotient (NaN in, NaN out). n and d are finite here: an infinite component of either makes
# n . d infinite or NaN.
# ⭐ 3.4.1 — EACH SUM IS FIRST CERTIFIED IN DOUBLES (GEO5, GF3-3: the integer sums cost the row 12%,
# 304-318 -> 346-347 ns). _geo_plane_dot_fast returns the integer sum's own rounding wherever its bound
# certifies it, so every answer is the integer path's bit for bit: 0 differences from the integer-only
# form over 38941 small-path rays (GEO3's cancelling and tiny families, 10566 of them, and five more:
# one tiny product beside zero pairs, unrelated scales, an origin at 0, cancellation to 2^-40..2^-1000),
# the fast path answering 31964 denominators and 24015 numerators; the integer sum is formed only
# where it declines (exact cancellation of the leading products, a result below 2^-1000 of the
# scale, a subnormal or far d0). Cost: ray_plane_subnormal 341 -> 227 ns; a ray whose leading
# products cancel exactly (ray_plane_small_cancel) pays the attempt, about 10 ns, before the integer
# sums.
# [measured: GEO5 3.4.1 psw5.py, 4 seeds, first 3.4.1 tree's bits, Fraction oracle; tb_arr.bcyr, 2026-11-01]
fn _geo_ray_plane_small(ray, plane, denom) {
    var n = GeoPlane_normal(plane);
    var o = GeoRay_origin(ray);
    var dist = GeoPlane_distance(plane);
    var rr: i64[33];
    var acc: i64[208];
    var rd: i64[2];
    if (_geo_plane_dot_fast(n, GeoRay_direction(ray), 0, 0, &rd) == 0 - 2) {
        _geo_xi_vec(n, &rr);
        _geo_xi_vec(GeoRay_direction(ray), &rr + 72);
        _geo_xi_init(&acc);
        for (var i = 0; i < 3; i = i + 1) { _geo_xi_add2(&acc, &rr + i * 24, &rr + 72 + i * 24, 0); }
        if (_geo_xi_val(&acc, 0, &rd) == 0) { return 0; }
    }
    if ((_geo_hvec3_finite(o) == 0) || (f64_lt(f64_abs(dist), _GEO_F64_POS_INF) == 0)) {
        var tp = f64_div(f64_sub(dist, hvec3_dot(n, o)), denom);
        if (f64_lt(tp, 0) == 1) { return 0; }
        return tp;
    }
    var rn: i64[2];
    if (_geo_plane_dot_fast(n, o, dist, 1, &rn) == 0 - 2) {
        # d0 1 - n . o: the normal's records, the origin's, and 1 as (2^52, -52, +).
        _geo_xi_vec(n, &rr);
        _geo_xi_vec(o, &rr + 72);
        store64(&rr + 144, 0x0010_0000_0000_0000);
        store64(&rr + 152, 0 - 52);
        store64(&rr + 160, 0);
        var b = (dist >> 52) & 0x7FF;
        var m = dist & 0x000F_FFFF_FFFF_FFFF;
        if (b == 0) { b = 1; } else { m = m | 0x0010_0000_0000_0000; }
        store64(&rr + 168, m);
        store64(&rr + 176, b - 1075);
        store64(&rr + 184, dist >> 63);
        _geo_xi_init(&acc);
        _geo_xi_add2(&acc, &rr + 168, &rr + 144, 0);
        for (var j = 0; j < 3; j = j + 1) { _geo_xi_add2(&acc, &rr + j * 24, &rr + 72 + j * 24, 1); }
        _geo_xi_val(&acc, 0, &rn);
    }
    var t = _geo_ldexp(f64_div(load64(&rn), load64(&rd)), load64(&rn + 8) - load64(&rd + 8));
    if (f64_lt(t, 0) == 1) { return 0; }
    return t;
}

# x * 2^e with a single rounding (3.3.6), for a finite x and any integer e: the
# sphere and capsule quadratics solved at unit size (_geo_sphere_roots_scaled,
# geo_ray_capsule_branch) multiply their roots back by a power of two that can lie
# outside the range of one double. A step that keeps x normal is exact, so x is first
# taken no lower than the least normal binade and only the last multiplication can
# round (to a subnormal or to zero); an overflow is the answer, +-Inf. ⚠ An x of 2 or
# more is first taken into [1, 2): the one step to the least normal binade would be a
# power below 2^-1022, which `(1023 + k) << 52` cannot spell (a sphere root of 3.1 at
# e = -1050 was multiplied by +0, and an origin inside the sphere read the miss).
# ⚠ 3.4.1 — e ABOVE 2100 IS 2100: the two 2^1023 steps reached e up to 3069 only, and past it the
# last power's exponent field ran into the sign bit (a barycentric weight of 2^3300 came back
# -Inf). Every finite non-zero x times 2^2100 overflows, so the clamp changes no other answer.
fn _geo_ldexp(x, e) {
    if (e > 2100) { e = 2100; }   # (see the note above)
    if (e > 1023) {
        x = f64_mul(x, 0x7FE0_0000_0000_0000);   # 2^1023
        e = e - 1023;
        if (e > 1023) {
            x = f64_mul(x, 0x7FE0_0000_0000_0000);
            e = e - 1023;
        }
    }
    if (e < 0 - 1022) {
        var ex = ((x >> 52) & 0x7FF) - 1023;
        if (ex == 1024) { return x; }   # +-Inf or NaN: unchanged by any 2^e
        if (ex > 0) {
            x = f64_mul(x, (1023 - ex) << 52);   # into [1, 2), exact
            e = e + ex;
            ex = 0;
        }
        var k = 0 - 1022 - ex;   # x * 2^k sits in the least normal binade
        if (k > 0) { k = 0; }
        if (k < e) { k = e; }
        x = f64_mul(x, (1023 + k) << 52);
        e = e - k;
        if (e < 0 - 1022) {
            if (e < 0 - 1074) { e = 0 - 1074; }
            return f64_mul(x, 1 << (e + 1074));   # 2^e, a subnormal power of two
        }
    }
    return f64_mul(x, (1023 + e) << 52);
}

# A root multiplied back by 2^e (_geo_ldexp) that stays below zero when it was: a negative
# root that underflows reads -2^-1074, not the -0 the callers take for a contact at t = 0
# (3.3.6). From (1 - 2^-53, 0, 0) inside the unit sphere along -2^1023 x, the root behind
# the origin read -0 and was the answer, for the exit 2^-1022; likewise a sphere of radius
# 2^-1030 met from just inside along -2 x answered -0 for its exit 2^-1030.
# [measured: C336 probe and exact Fraction roots, this tree, 2026-10-11; cycc 6.6.14]
fn _geo_root_ldexp(x, e) {
    var y = _geo_ldexp(x, e);
    if (y == 0x8000_0000_0000_0000) {
        if (x != y) { return 0x8000_0000_0000_0001; }
    }
    return y;
}

# Both roots of a t^2 + 2 hb t + c = 0, sorted, into out; 0 when there is none
# (delta < 0, NaN-false so a NaN carries through). `delta` is r^2 - |f|^2 with f the
# offset of the centre from the line, and sq = sqrt(a * delta), the root of the
# discriminant hb^2 - a c in the Ray Tracing Gems form (3.3.6, see _geo_sphere_roots).
# The larger root in magnitude is q / a with q = -(hb + sign(hb) sq), which never
# subtracts, and the other is c / q; q = 0 (hb = 0 and a tangent) is the double
# root -hb / a. ⚠ c = 0, an origin on the surface, is the root +0, as the classic
# (-hb + sqrt) / a gives it: c / q is -0 when the ray leaves (hb > 0, q < 0), and an
# origin on the sphere moving out answered -0 for 3.3.5's +0. ⚠ And a non-zero root that
# underflows below zero is -2^-1074, not -0: a -0 root is the contact at t = 0 to the
# callers, so a root behind an origin just outside read as the answer (see
# _geo_root_ldexp). (q / a is the root of larger magnitude, and no ray of the sweeps
# underflowed it; its line keeps the reading the same for both roots.)
fn _geo_quad_roots(hb, a, c, delta, sq, out) {
    if (f64_lt(delta, 0) == 1) { return 0; }
    var q = f64_neg(f64_add(hb, sq));
    if (f64_lt(hb, 0) == 1) { q = f64_sub(sq, hb); }
    var t1 = f64_div(q, a);
    var t2 = t1;
    if (f64_eq(q, 0) == 0) {
        if (t1 == 0x8000_0000_0000_0000) { t1 = 0x8000_0000_0000_0001; }
        t2 = f64_div(c, q);
        if (f64_eq(c, 0) == 1) { t2 = 0; }
        elif (t2 == 0x8000_0000_0000_0000) { t2 = 0x8000_0000_0000_0001; }
    }
    if (f64_gt(t1, t2) == 1) {
        var tt = t1;
        t1 = t2;
        t2 = tt;
    }
    store64(out, t1);
    store64(out + 8, t2);
    return 1;
}

# delta = r^2 - |f|^2 formed at the scale of f and r (3.3.6): when both are small their
# squares flush, and delta read 0, a tangent hit, for a line that misses the sphere by
# more than its radius. f and r are multiplied by the power of two that takes the
# larger into [1, 2); p[0] is delta there (its sign is the verdict) and p[1] is
# sqrt(a * delta) multiplied back, exactly, to the caller's scale.
fn _geo_delta_fine(fv, r, a, p) {
    var m = _geo_absmax_bits(fv);
    var mr = r & 0x7FFF_FFFF_FFFF_FFFF;
    if (mr > m) { m = mr; }
    var sf = _geo_scale_for(m >> 52);
    var fs[24];
    store64(&fs, f64_mul(HVec3_x(fv), sf));
    store64(&fs + 8, f64_mul(HVec3_y(fv), sf));
    store64(&fs + 16, f64_mul(HVec3_z(fv), sf));
    var rs = f64_mul(r, sf);
    var df = f64_sub(f64_mul(rs, rs), hvec3_dot(&fs, &fs));
    store64(p, df);
    store64(p + 8, _geo_ldexp(f64_sqrt(f64_mul(a, df)), 1023 - (sf >> 52)));
    return 0;
}

# x^2 as an unevaluated sum p[0] + p[1], exactly (Dekker's split; no fused multiply),
# for |x| below 2^995 so that x * (2^27 + 1) cannot overflow.
fn _geo_two_sq(x, p) {
    var sp = f64_mul(x, 0x41A0_0000_0200_0000);   # 2^27 + 1
    var hi = f64_sub(sp, f64_sub(sp, x));
    var lo = f64_sub(x, hi);
    var sq = f64_mul(x, x);
    var e = f64_add(f64_sub(f64_mul(hi, hi), sq), f64_mul(F64_TWO, f64_mul(hi, lo)));
    store64(p, sq);
    store64(p + 8, f64_add(e, f64_mul(lo, lo)));
    return 0;
}

# a + b as s + err, exactly (Knuth's two-sum): s returned, err added to p[0].
fn _geo_two_sum(a, b, p) {
    var sm = f64_add(a, b);
    var bb = f64_sub(sm, a);
    var er = f64_add(f64_sub(a, f64_sub(sm, bb)), f64_sub(b, bb));
    store64(p, f64_add(load64(p), er));
    return sm;
}

# c = |oc|^2 - r^2 for an origin near the sphere (3.3.6): there the two squares agree in
# their leading bits and the plain difference keeps only the rounding of each, which
# the near root c / q inherits: 7.2 ulp for an origin 0.066 radii out, and a median of
# 1.5e4 ulp (8.6e5 at most) within 1e-4 radii of the surface, with the plain c. Each
# square is formed exactly as two doubles and the eight parts summed with their errors
# carried, so c is good to an ulp of itself plus about 2^-104 of |oc|^2. For |oc| and r
# below 2^995.
# [measured: C336 sphere sweep, a draft without this helper vs this tree, 2026-10-11; cycc 6.6.14]
fn _geo_sphere_c_exact(oc, r) {
    var px[16];
    var py[16];
    var pz[16];
    var pr[16];
    _geo_two_sq(HVec3_x(oc), &px);
    _geo_two_sq(HVec3_y(oc), &py);
    _geo_two_sq(HVec3_z(oc), &pz);
    _geo_two_sq(r, &pr);
    var er[8];
    store64(&er, 0);
    var sm = _geo_two_sum(load64(&px), load64(&py), &er);
    sm = _geo_two_sum(sm, load64(&pz), &er);
    sm = _geo_two_sum(sm, f64_neg(load64(&pr)), &er);
    var tail = f64_add(f64_add(load64(&px + 8), load64(&py + 8)), f64_sub(load64(&pz + 8), load64(&pr + 8)));
    return f64_add(sm, f64_add(load64(&er), tail));
}

# ================================================================
# Exact expansions (3.4.0)
# ================================================================
# An expansion is a list of doubles, nonoverlapping and in increasing magnitude, whose exact
# sum is the value (Shewchuk, "Adaptive Precision Floating-Point Arithmetic", 1997). Adding a
# double to one (_geo_xgrow) and adding exact products (_geo_xprod, _geo_xsq) keep the sum
# exact as long as no product leaves the normal range, so a polynomial in the inputs is
# formed with no rounding at all and rounded once at the end (_geo_xval). The quantities that
# need it are few and cancel to far below double-double: c = |oc|^2 - r^2 for an origin on a
# sphere (the surface rounded to an ulp, c is 2^-52 of |oc|^2 or less), and the coefficients
# of a barrel 2^100 radii or more from its start.

# b added to the expansion at e of n words, exactly (Shewchuk's Grow-Expansion, zero
# components dropped); returns the new length, at most n + 1. A component is read before the
# slot it lands in is written (m <= i), so the expansion is grown in place.
fn _geo_xgrow(e, n, b) {
    var q = b;
    var m = 0;
    for (var i = 0; i < n; i = i + 1) {
        var ei = load64(e + i * 8);
        var s = f64_add(q, ei);
        var bv = f64_sub(s, q);
        var h = f64_add(f64_sub(q, f64_sub(s, bv)), f64_sub(ei, bv));
        q = s;
        if (f64_eq(h, 0) == 0) {
            store64(e + m * 8, h);
            m = m + 1;
        }
    }
    if (f64_eq(q, 0) == 0 || m == 0) {
        store64(e + m * 8, q);
        m = m + 1;
    }
    return m;
}

# x y added to the expansion at e of n words, exactly (_geo_two_prod, so |x| and |y| below
# 2^995 and the product's low part clear of the subnormals); returns the new length.
fn _geo_xprod(e, n, x, y) {
    var pp[16];
    _geo_two_prod(x, y, &pp);
    n = _geo_xgrow(e, n, load64(&pp + 8));
    return _geo_xgrow(e, n, load64(&pp));
}

# The expansion's value, its components summed from the smallest: within about an ulp of the
# exact sum, and 0 exactly when that is 0.
fn _geo_xval(e, n) {
    var s = 0;
    for (var i = 0; i < n; i = i + 1) { s = f64_add(s, load64(e + i * 8)); }
    return s;
}

# The expansion at e of n words compressed in place (Shewchuk's Compress, with Knuth's two-sum):
# the same exact value in nonoverlapping components, adjacent ones merged wherever their sum is a
# double. Returns the new length, never more than n. Each pass writes a slot only after reading it
# (the first writes at `bottom`, above the component it reads; the second at `top`, below it).
fn _geo_xcompress(e, n) {
    if (n <= 1) { return n; }
    var q = load64(e + (n - 1) * 8);
    var bottom = n - 1;
    var i = n - 2;
    while (i >= 0) {
        var ei = load64(e + i * 8);
        var s = f64_add(q, ei);
        var bv = f64_sub(s, q);
        var h = f64_add(f64_sub(q, f64_sub(s, bv)), f64_sub(ei, bv));
        if (f64_eq(h, 0) == 0) {
            store64(e + bottom * 8, s);
            bottom = bottom - 1;
            q = h;
        } else { q = s; }
        i = i - 1;
    }
    store64(e + bottom * 8, q);
    var top = 0;
    for (var j = bottom + 1; j < n; j = j + 1) {
        var gj = load64(e + j * 8);
        var s2 = f64_add(gj, q);
        var bv2 = f64_sub(s2, gj);
        var h2 = f64_add(f64_sub(gj, f64_sub(s2, bv2)), f64_sub(q, bv2));
        if (f64_eq(h2, 0) == 0) {
            store64(e + top * 8, h2);
            top = top + 1;
        }
        q = s2;
    }
    store64(e + top * 8, q);
    return top + 1;
}

# The product of the expansions a (na words) and b (nb, at most 96), times the double k, added to
# the expansion at e of n words, exactly; returns the new length, or -1 (e then unusable). (k is +-1
# or a power of two, so that each product stays exact.) Each row b a_i k is formed whole
# (_geo_xscale) and summed into e in one linear pass (_geo_xlsum), Shewchuk's Scale-Expansion and
# Linear-Expansion-Sum: work in the lengths' sum per row, where growing e by each two-word product
# took work in e's length per product (3.4.0 review: 1.8 ms for one seam test, 0.5 ms for one exact
# barrel, on a decimal-palette ray). The expansion is held under `cap` words by construction: e is
# compressed when a row would pass cap - 2, and the call fails rather than write past it (after the
# review's M1: the uncompressed growth of 3.4.0's first draft reached 54 to 73 words of a 48-word
# buffer and wrote past it). The failure is the assertion; its caller then solves as before.
# [measured: tests/hisab.bcyr ray_capsule_seam_graze and a counting probe, this tree vs the grown form, 2026-10-31]
fn _geo_xmul(e, n, a, na, b, nb, k, cap) {
    return _geo_xmul_c(e, n, a, na, b, nb, k, cap, 0);
}

# _geo_xmul counting at lost (when not 0) every product that rounded (_geo_xscale).
fn _geo_xmul_c(e, n, a, na, b, nb, k, cap, lost) {
    if (n < 0) { return n; }
    if (nb > 96) { return 0 - 1; }
    var p: i64[192];
    var g: i64[288];
    for (var i = 0; i < na; i = i + 1) {
        var lp = _geo_xscale(b, nb, f64_mul(load64(a + i * 8), k), &p, lost);
        if (n + lp > cap - 2) {
            n = _geo_xcompress(e, n);
            if (n + lp > cap - 2) { return 0 - 1; }
        }
        n = _geo_xlsum(e, n, &p, lp, &g);
    }
    return n;
}

# The expansion at a (n words, nonoverlapping, increasing) times the double b into out, exactly
# (Shewchuk's Scale-Expansion, zero components dropped, each sum a full two-sum); returns its
# length, at most 2n. A product of two nonzero words under 2^-969 may round (its low part leaves
# the subnormals, or the whole product does): each such product adds 1 at lost when lost is not 0
# (3.4.0, _geo_barrel_xact's count; off by 2^-1073 at most, the product and its parts' roundings).
# A product x y that may have rounded (under 2^-969, _geo_xscale) counted at lost (two words: the
# count, then a bound on the sum of their errors in units of 2^-1072, as a double): each is off by
# 2^-1072 or less, and by no more than its own size, under 2^(ub(x) + ub(y)) (3.4.0, the second
# review's N2: a product of two words far under their vectors' largest is far under 2^-1072, and
# _geo_barrel_xact's bounds by count alone refused rays those products cannot move).
fn _geo_xlost(lost, x, y) {
    store64(lost, load64(lost) + 1);
    var k = _geo_xub(x) + _geo_xub(y) + 1072;
    var e = F64_ONE;
    if (k < 0) { e = _geo_pow2(k); }   # (2^-1022 at the least: a bound still)
    store64(lost + 8, f64_add(load64(lost + 8), e));
    return 0;
}

# An exponent above |x| (3.4.0, _geo_xlost and _geo_barrel_xact's bounds): |x| < 2^return; -1022 for a
# subnormal, -4000 for 0 (nothing: sums of a few stay far under every real exponent).
fn _geo_xub(x) {
    var f = (x & 0x7FFF_FFFF_FFFF_FFFF) >> 52;
    if ((x & 0x7FFF_FFFF_FFFF_FFFF) == 0) { return 0 - 4000; }
    if (f == 0) { return 0 - 1022; }
    return f - 1022;
}

# The scale a units sum (_geo_xlost) stands for: an exponent above u 2^-1072 (3.4.0).
fn _geo_xue(u) { return _geo_xub(u) - 1072; }

fn _geo_imax(a, b) {
    if (a > b) { return a; }
    return b;
}

fn _geo_xscale(a, n, b, out, lost) {
    var pp[16];
    var bz = f64_eq(b, 0);
    _geo_two_prod(load64(a), b, &pp);
    if (lost != 0 && bz == 0 && f64_eq(load64(a), 0) == 0) {
        if ((load64(&pp) & 0x7FFF_FFFF_FFFF_FFFF) < 0x0360_0000_0000_0000) { _geo_xlost(lost, load64(a), b); }
    }
    var q = load64(&pp);
    var m = 0;
    if (f64_eq(load64(&pp + 8), 0) == 0) {
        store64(out, load64(&pp + 8));
        m = 1;
    }
    for (var i = 1; i < n; i = i + 1) {
        _geo_two_prod(load64(a + i * 8), b, &pp);
        if (lost != 0 && bz == 0 && f64_eq(load64(a + i * 8), 0) == 0) {
            if ((load64(&pp) & 0x7FFF_FFFF_FFFF_FFFF) < 0x0360_0000_0000_0000) {
                _geo_xlost(lost, load64(a + i * 8), b);
            }
        }
        var th = load64(&pp);
        var tl = load64(&pp + 8);
        var s = f64_add(q, tl);
        var bv = f64_sub(s, q);
        var h1 = f64_add(f64_sub(q, f64_sub(s, bv)), f64_sub(tl, bv));
        if (f64_eq(h1, 0) == 0) {
            store64(out + m * 8, h1);
            m = m + 1;
        }
        q = f64_add(th, s);
        var bv2 = f64_sub(q, th);
        var h2 = f64_add(f64_sub(th, f64_sub(q, bv2)), f64_sub(s, bv2));
        if (f64_eq(h2, 0) == 0) {
            store64(out + m * 8, h2);
            m = m + 1;
        }
    }
    if (f64_eq(q, 0) == 0 || m == 0) {
        store64(out + m * 8, q);
        m = m + 1;
    }
    return m;
}

# e (ne words) + f (nf words), each nonoverlapping and increasing, back into e, exactly
# (Shewchuk's Linear-Expansion-Sum, every sum a full two-sum, zero components dropped), with g
# (ne + nf words) for the merge; returns the new length, at most ne + nf.
fn _geo_xlsum(e, ne, f, nf, g) {
    var i = 0;
    var j = 0;
    var n = 0;
    while (i < ne || j < nf) {
        var take = 0;   # 0: from e, 1: from f
        if (i >= ne) { take = 1; }
        elif (j < nf) {
            if ((load64(f + j * 8) & 0x7FFF_FFFF_FFFF_FFFF) < (load64(e + i * 8) & 0x7FFF_FFFF_FFFF_FFFF)) { take = 1; }
        }
        if (take == 0) {
            store64(g + n * 8, load64(e + i * 8));
            i = i + 1;
        } else {
            store64(g + n * 8, load64(f + j * 8));
            j = j + 1;
        }
        n = n + 1;
    }
    if (n == 1) {
        store64(e, load64(g));
        return 1;
    }
    var g0 = load64(g);
    var g1 = load64(g + 8);
    var bq = f64_add(g1, g0);
    var bb = f64_sub(bq, g1);
    var q = f64_add(f64_sub(g1, f64_sub(bq, bb)), f64_sub(g0, bb));
    var m = 0;
    for (var k = 2; k < n; k = k + 1) {
        var gk = load64(g + k * 8);
        var r = f64_add(gk, q);
        var br = f64_sub(r, gk);
        var hk = f64_add(f64_sub(gk, f64_sub(r, br)), f64_sub(q, br));
        if (f64_eq(hk, 0) == 0) {
            store64(e + m * 8, hk);
            m = m + 1;
        }
        var s = f64_add(bq, r);
        var bs = f64_sub(s, bq);
        q = f64_add(f64_sub(bq, f64_sub(s, bs)), f64_sub(r, bs));
        bq = s;
    }
    if (f64_eq(q, 0) == 0) {
        store64(e + m * 8, q);
        m = m + 1;
    }
    if (f64_eq(bq, 0) == 0 || m == 0) {
        store64(e + m * 8, bq);
        m = m + 1;
    }
    return m;
}

# The sign of an expansion: that of its largest component (the last non-zero one).
fn _geo_xsign(e, n) {
    var i = n - 1;
    while (i >= 0) {
        var x = load64(e + i * 8);
        if (f64_gt(x, 0) == 1) { return 1; }
        if (f64_lt(x, 0) == 1) { return 0 - 1; }
        i = i - 1;
    }
    return 0;
}

# |oc + lo|^2 - r^2 exactly, rounded once (3.4.0): oc as rounded and its rounding lo (0 for
# none), each square and cross product exact. For an origin on the surface, where the
# double-double form (_geo_sphere_c_fused, _geo_c_lo) is off by about 2^-104 |oc|^2: an origin
# of radius 3.7e16, |c| 5.2e-18 of r^2, read the exit 15 ulp off. For |oc| and r below
# 2^995, and above 2^-430 for the low parts of the squares to stay exact.
# [measured: rt340 ray sweeps (sweep.py, fixtures.py), exact Fraction oracle, base vs this tree, 2026-10-31]
fn _geo_c_xact(oc, lo, r) {
    var e: i64[24];
    var n = 0;
    for (var i = 0; i < 3; i = i + 1) {
        var x = load64(oc + i * 8);
        n = _geo_xprod(&e, n, x, x);
        if (lo != 0) {
            var l = load64(lo + i * 8);
            n = _geo_xprod(&e, n, f64_mul(x, F64_TWO), l);
            n = _geo_xprod(&e, n, l, l);
        }
    }
    n = _geo_xprod(&e, n, f64_neg(r), r);
    return _geo_xval(&e, n);
}

# _geo_c_xact for a sphere's origin near its surface (_geo_sphere_roots_full), o - c's rounding
# formed here (3.4.0).
fn _geo_c_near(o, cen, ocv, r) {
    var lox[24];
    _geo_oc_lo(o, cen, F64_ONE, ocv, &lox);
    return _geo_c_xact(ocv, &lox, r);
}

# _geo_hb_lo for the same, o - c's rounding formed here (3.4.0).
fn _geo_hb_near(o, cen, ocv, dx, dy, dz) {
    var lox[24];
    _geo_oc_lo(o, cen, F64_ONE, ocv, &lox);
    return _geo_hb_lo(ocv, &lox, 0, dx, dy, dz);
}

# The sign of |oc + lo|^2 - r^2 at any magnitude (3.4.0, after the review's M2): oc, lo and r
# multiplied by the power of two that takes the larger of |oc| and r into [1, 2) (a sign does not
# change with it), then _geo_c_xact, whose squares overflow from 2^512 and flush below 2^-537. The
# half-infinite capsule's inside tests read the miss for r = 1e160 or 1e-170 before. oc and lo are
# overwritten. Finite input.
fn _geo_c_xact_sc(oc, lo, r) {
    var m = _geo_absmax_bits(oc);
    var mr = r & 0x7FFF_FFFF_FFFF_FFFF;
    if (mr > m) { m = mr; }
    var sc = _geo_scale_for(m >> 52);
    for (var i = 0; i < 3; i = i + 1) {
        store64(oc + i * 8, f64_mul(load64(oc + i * 8), sc));
        store64(lo + i * 8, f64_mul(load64(lo + i * 8), sc));
    }
    return _geo_c_xact(oc, lo, f64_mul(r, sc));
}

# _geo_sphere_c_exact(oc, r) followed by _geo_c_lo with o - c's rounding (_geo_oc_lo, h = 1),
# the same operations in the same order without their thirteen calls and five stack arrays: c
# for an origin near a sphere's surface (_geo_sphere_roots_full).
# ⭐ 3.3.7 — WRITTEN OUT FOR COST, BIT FOR BIT: an origin 1.78e-6 radii outside a unit sphere
# 228 -> 208 ns (3.3.6 191, 3.3.5 57; the rest is the exact c the 3.3.6 and 3.3.7 repairs
# form), and 40,000 rays from origins 2^-59 to 1 radii off spheres of radius 2^-600 to 2^600
# give the same bits.
# [measured: tests/hisab.bcyr ray_sphere_near_surface, 4-tree A/B; scratch pfb/rsweep.cyr; 2026-10-31]
fn _geo_sphere_c_fused(o, cen, oc, r) {
    var x = HVec3_x(oc);
    var y = HVec3_y(oc);
    var z = HVec3_z(oc);
    var sp = f64_mul(x, 0x41A0_0000_0200_0000);   # 2^27 + 1
    var hi = f64_sub(sp, f64_sub(sp, x));
    var lo = f64_sub(x, hi);
    var px = f64_mul(x, x);
    var pxl = f64_add(f64_add(f64_sub(f64_mul(hi, hi), px), f64_mul(F64_TWO, f64_mul(hi, lo))), f64_mul(lo, lo));
    sp = f64_mul(y, 0x41A0_0000_0200_0000);
    hi = f64_sub(sp, f64_sub(sp, y));
    lo = f64_sub(y, hi);
    var py = f64_mul(y, y);
    var pyl = f64_add(f64_add(f64_sub(f64_mul(hi, hi), py), f64_mul(F64_TWO, f64_mul(hi, lo))), f64_mul(lo, lo));
    sp = f64_mul(z, 0x41A0_0000_0200_0000);
    hi = f64_sub(sp, f64_sub(sp, z));
    lo = f64_sub(z, hi);
    var pz = f64_mul(z, z);
    var pzl = f64_add(f64_add(f64_sub(f64_mul(hi, hi), pz), f64_mul(F64_TWO, f64_mul(hi, lo))), f64_mul(lo, lo));
    sp = f64_mul(r, 0x41A0_0000_0200_0000);
    hi = f64_sub(sp, f64_sub(sp, r));
    lo = f64_sub(r, hi);
    var pr = f64_mul(r, r);
    var prl = f64_add(f64_add(f64_sub(f64_mul(hi, hi), pr), f64_mul(F64_TWO, f64_mul(hi, lo))), f64_mul(lo, lo));
    var sm = f64_add(px, py);
    var bb = f64_sub(sm, px);
    var er = f64_add(0, f64_add(f64_sub(px, f64_sub(sm, bb)), f64_sub(py, bb)));
    var s2 = f64_add(sm, pz);
    bb = f64_sub(s2, sm);
    er = f64_add(er, f64_add(f64_sub(sm, f64_sub(s2, bb)), f64_sub(pz, bb)));
    var npr = f64_neg(pr);
    var s3 = f64_add(s2, npr);
    bb = f64_sub(s3, s2);
    er = f64_add(er, f64_add(f64_sub(s2, f64_sub(s3, bb)), f64_sub(npr, bb)));
    var c = f64_add(s3, f64_add(er, f64_add(f64_add(pxl, pyl), f64_sub(pzl, prl))));
    var lov[24];
    bb = f64_sub(x, HVec3_x(o));
    store64(&lov, f64_add(f64_sub(HVec3_x(o), f64_sub(x, bb)), f64_sub(f64_neg(HVec3_x(cen)), bb)));
    bb = f64_sub(y, HVec3_y(o));
    store64(&lov + 8, f64_add(f64_sub(HVec3_y(o), f64_sub(y, bb)), f64_sub(f64_neg(HVec3_y(cen)), bb)));
    bb = f64_sub(z, HVec3_z(o));
    store64(&lov + 16, f64_add(f64_sub(HVec3_z(o), f64_sub(z, bb)), f64_sub(f64_neg(HVec3_z(cen)), bb)));
    return f64_add(c, f64_mul(F64_TWO, hvec3_dot(oc, &lov)));
}

# x * y as an unevaluated sum p[0] + p[1], exactly (Dekker's two-product, the split
# _geo_two_sq uses), for |x| and |y| below 2^995 and a product clear of the subnormals.
fn _geo_two_prod(x, y, p) {
    var sx = f64_mul(x, 0x41A0_0000_0200_0000);   # 2^27 + 1
    var xh = f64_sub(sx, f64_sub(sx, x));
    var xl = f64_sub(x, xh);
    var sy = f64_mul(y, 0x41A0_0000_0200_0000);
    var yh = f64_sub(sy, f64_sub(sy, y));
    var yl = f64_sub(y, yh);
    var pr = f64_mul(x, y);
    var e = f64_add(f64_add(f64_sub(f64_mul(xh, yh), pr), f64_mul(xh, yl)), f64_mul(xl, yh));
    store64(p, pr);
    store64(p + 8, f64_add(e, f64_mul(xl, yl)));
    return 0;
}

# The rounding error of s = fl(a - b), exactly: a - b = s + the return (Knuth's two-sum),
# for finite a and b whose difference does not overflow.
fn _geo_diff_err(a, b, s) {
    var nb = f64_neg(b);
    var bb = f64_sub(s, a);
    return f64_add(f64_sub(a, f64_sub(s, bb)), f64_sub(nb, bb));
}

# a b - c d with both products exact (_geo_two_prod) and their difference summed with
# its error carried: within an ulp of the result plus about 2^-104 of the products.
fn _geo_dpd(a, b, c, d) {
    var pp[16];
    var qq[16];
    _geo_two_prod(a, b, &pp);
    _geo_two_prod(c, d, &qq);
    var er[8];
    store64(&er, 0);
    var sm = _geo_two_sum(load64(&pp), f64_neg(load64(&qq)), &er);
    return f64_add(sm, f64_add(load64(&er), f64_sub(load64(&pp + 8), load64(&qq + 8))));
}

# hb = (oc + lo) . (d + dlo) for a ray near a sphere's surface (3.4.0): oc is o - c as rounded
# and lo its rounding (a vector, or 0 for none), dlo d's (the barrel's d_perp; 0 for none). Each
# product oc_i d_i is exact (_geo_two_prod) and their sum is formed with its error carried, so hb
# is good to an ulp of itself plus about 2^-104 of |oc| |d|, however far the products cancel. For
# |oc| and |d| below 2^995.
fn _geo_hb_lo(oc, lo, dlo, dx, dy, dz) {
    var pp[16];
    var er[8];
    store64(&er, 0);
    _geo_two_prod(HVec3_x(oc), dx, &pp);
    var sm = load64(&pp);
    var tail = load64(&pp + 8);
    _geo_two_prod(HVec3_y(oc), dy, &pp);
    sm = _geo_two_sum(sm, load64(&pp), &er);
    tail = f64_add(tail, load64(&pp + 8));
    _geo_two_prod(HVec3_z(oc), dz, &pp);
    sm = _geo_two_sum(sm, load64(&pp), &er);
    tail = f64_add(tail, load64(&pp + 8));
    if (lo != 0) {
        var ld = f64_add(f64_add(f64_mul(HVec3_x(lo), dx), f64_mul(HVec3_y(lo), dy)), f64_mul(HVec3_z(lo), dz));
        tail = f64_add(tail, ld);
    }
    if (dlo != 0) { tail = f64_add(tail, hvec3_dot(oc, dlo)); }
    return f64_add(sm, f64_add(load64(&er), tail));
}

# The part of v + vl across the axis u + ul as two doubles, times 2^e, minus ref, into lo
# (3.4.0): v + vl and u + ul exact (vl may be 0, none), ref a vector near that part at its scale.
# It is formed as (v + vl) - (u + ul) k1 with each product u_i k1 exact (k1 = (v . u) / uu
# rounded), then the part along u that k1's rounding leaves is removed by one more projection.
# Across u it is good to about 2^-104 of |v|; along u it keeps about 2^-53 of itself, which moves
# a square or a dot product with another vector across u only to second order. (That second order
# is not nothing: without the projection an origin exactly on a barrel, c = 0, read a positive c
# from |lo|^2 and its contact became the miss, tests/modules_c.tcyr's d_perp-reads-0 pin.)
# The first pair is renormalized (value, rounding) before it is used: where v - u k1 cancels to 0,
# its low word holds the whole part (an origin 2^-1002 from a unit capsule's axis through its
# middle, o - start rounding to -start exactly), and the unnormalized pair kept only 2^-52 of it
# through the second projection: 7.4 ulp, where the caller without this low part had 1.4. (The
# second pair renormalized too moved no answer of the review's families or this lane's sweeps.)
# [measured: rt340 review families (REV-RT-py tE3, past 2^1000) and sweep.py, exact Fractions, 2026-10-31]
# 0, lo unwritten, when k1 is not finite or is 2^990 or more (the products' split would overflow).
fn _geo_perp_dd(v, vl, u, ul, uu, e, ref, lo) {
    var k1 = f64_div(hvec3_dot(v, u), uu);
    if (f64_lt(f64_abs(k1), 0x7DD0_0000_0000_0000) == 0) { return 0; }   # 2^990
    var pp[16];
    var xh[24];
    var xt[24];
    for (var i = 0; i < 3; i = i + 1) {
        var vi = load64(v + i * 8);
        _geo_two_prod(load64(u + i * 8), k1, &pp);
        var s = f64_sub(vi, load64(&pp));
        var t = f64_sub(_geo_diff_err(vi, load64(&pp), s), f64_add(load64(&pp + 8), f64_mul(load64(ul + i * 8), k1)));
        if (vl != 0) { t = f64_add(t, load64(vl + i * 8)); }
        var sh = f64_add(s, t);   # (renormalized: t can be as large as s, see above)
        store64(&xh + i * 8, sh);
        store64(&xt + i * 8, _geo_diff_err(s, f64_neg(t), sh));
    }
    var kd = 0;
    for (var j = 0; j < 3; j = j + 1) {
        kd = f64_add(kd, f64_mul(f64_add(load64(&xh + j * 8), load64(&xt + j * 8)), load64(u + j * 8)));
    }
    var k = f64_div(kd, uu);
    for (var m = 0; m < 3; m = m + 1) {
        _geo_two_prod(k, load64(u + m * 8), &pp);
        var xm = load64(&xh + m * 8);
        var s2 = f64_sub(xm, load64(&pp));
        var l2 = f64_add(_geo_diff_err(xm, load64(&pp), s2), f64_sub(load64(&xt + m * 8), load64(&pp + 8)));
        store64(lo + m * 8, f64_add(f64_sub(_geo_ldexp(s2, e), load64(ref + m * 8)), _geo_ldexp(l2, e)));
    }
    return 1;
}

# d_perp with end - start's rounding carried, for a ray near parallel to the axis (3.4.1 GEO6): out is 2^e
# times the part of d across the exact axis, e returned, good to an ulp of itself and 2^-103 |d| (_geo_perp_dd);
# 0x7FFF_FFFF, out unwritten, when it cannot be formed. The plain projection carries up to 2^-52 |d| of rounding
# and ab's rounding 2^-53 |d| more: over a small |d_perp| about 2^-53 / sin(angle) of it, at worst 3 times that.
fn _geo_dperp_fine(ray, capsule, ao, oh, u, usa, uh, uu, out) {
    var aol[24];
    var ul[24];
    _geo_cap_lows(ray, capsule, ao, oh, u, usa, uh, &aol, &ul);
    if (_geo_hvec3_nonfinite(&ul) != 0) { return 0x7FFF_FFFF; }
    var d = GeoRay_direction(ray);
    var sd = _geo_scale_for(_geo_absmax_bits(d) >> 52);
    var ds[24];
    var zr[24];
    for (var j = 0; j < 3; j = j + 1) {
        store64(&ds + j * 8, f64_mul(load64(d + j * 8), sd));
        store64(&zr + j * 8, 0);
    }
    if (_geo_perp_dd(&ds, 0, u, &ul, uu, 0, &zr, out) == 0) { return 0x7FFF_FFFF; }
    return (sd >> 52) - 1023;
}

# The roundings of the barrel's copy at unit size (3.4.0): bx as for _geo_cap_axis_offset (ray,
# capsule, ao, oh, u, usa, uh, e) and, at bx + 64, the power of two (log2) from d_perp to its copy.
# ocs and dsc are the copy's o_perp and d_perp as the caller formed them; their exact values less
# them go to lo and (when dlo is not 0) dlo (_geo_perp_dd, with the roundings of o - start and
# end - start from _geo_cap_lows). 0, nothing written, when an input is not finite or a part
# cannot be formed.
fn _geo_cap_perp_lo(bx, ocs, dsc, lo, dlo) {
    var ray = load64(bx);
    var capsule = load64(bx + 8);
    var ao = load64(bx + 16);
    var u = load64(bx + 32);
    var d = GeoRay_direction(ray);
    if (_geo_hvec3_nonfinite(ao) + _geo_hvec3_nonfinite(u) + _geo_hvec3_nonfinite(d) != 0) { return 0; }
    if (_geo_absmax_bits(u) == 0 || _geo_absmax_bits(ao) == 0 || _geo_absmax_bits(d) == 0) { return 0; }
    var aol[24];
    var ul[24];
    _geo_cap_lows(ray, capsule, ao, load64(bx + 24), u, load64(bx + 40), load64(bx + 48), &aol, &ul);
    if (_geo_hvec3_nonfinite(&aol) + _geo_hvec3_nonfinite(&ul) != 0) { return 0; }
    # (3.4.0, review S3: ao and d each at unit size first, ao's rounding with it: a part across u is
    # covariant in v, so v's power of two goes into the result's. At |E - S| past 2^993 the products
    # overflowed, k1 passed 2^990 and this gave up, and 24 to 31 of 60 near-barrel origins there were
    # wrong. u arrives at its caller's scale, usa: taking it to unit size as well moved no answer of
    # 1,680 such origins from |E - S| 2^-1054 to 2^1018, and is not done.)
    # [measured: REV-RT-py tO2.py and tO3.py, scales widened, exact Fractions, integ-snap6 vs this tree, 2026-10-31]
    var sa = _geo_scale_for(_geo_absmax_bits(ao) >> 52);
    var as[24];
    var als[24];
    for (var i = 0; i < 3; i = i + 1) {
        store64(&as + i * 8, f64_mul(load64(ao + i * 8), sa));
        store64(&als + i * 8, f64_mul(load64(&aol + i * 8), sa));
    }
    var uu = hvec3_dot(u, u);
    var lt[24];
    if (_geo_perp_dd(&as, &als, u, &ul, uu, load64(bx + 56) - ((sa >> 52) - 1023), ocs, &lt) == 0) { return 0; }
    if (dlo != 0) {
        var sdd = _geo_scale_for(_geo_absmax_bits(d) >> 52);
        var ds[24];
        for (var j = 0; j < 3; j = j + 1) { store64(&ds + j * 8, f64_mul(load64(d + j * 8), sdd)); }
        if (_geo_perp_dd(&ds, 0, u, &ul, uu, load64(bx + 64) - ((sdd >> 52) - 1023), dsc, dlo) == 0) { return 0; }
    }
    store64(lo, load64(&lt));
    store64(lo + 8, load64(&lt + 8));
    store64(lo + 16, load64(&lt + 16));
    return 1;
}

# The part of v across the line of w, (w x v) x w / (w . w), into out (3.3.6). v minus
# its projection on w keeps the projection's rounding, about 2^-52 |v| along w, and
# that swamps a part across w smaller than it: a ray within 2^-500 of a coordinate axis,
# or an origin 2^-500 of its distance along the axis away from it. This form subtracts
# nothing along w, and each component of both cross products is a b - c d formed with
# exact products (_geo_dpd). ⚠ With plain products the cross product cancelled for a w
# off the coordinate axes: a part across w under about 2^-50 |v| read 0, and a ray that
# misses the sphere (or a capsule's barrel or cap) by less than that, 3.3.5's miss, was
# a tangent or a hit. Callers pass w with its largest component in [1, 2) ([2^-51, 2) for a
# fully subnormal direction, _geo_scale_for) and |v| below 2^512.
fn _geo_perp_part(v, w, out) {
    var vx = HVec3_x(v);
    var vy = HVec3_y(v);
    var vz = HVec3_z(v);
    var wx = HVec3_x(w);
    var wy = HVec3_y(w);
    var wz = HVec3_z(w);
    var cx = _geo_dpd(wy, vz, wz, vy);
    var cy = _geo_dpd(wz, vx, wx, vz);
    var cz = _geo_dpd(wx, vy, wy, vx);
    var ww = hvec3_dot(w, w);
    store64(out, f64_div(_geo_dpd(cy, wz, cz, wy), ww));
    store64(out + 8, f64_div(_geo_dpd(cz, wx, cx, wz), ww));
    store64(out + 16, f64_div(_geo_dpd(cx, wy, cy, wx), ww));
    # Where w_i is 0 the part's component i is v_i exactly (v_i ww - w_i (w . v), over ww);
    # the form above rounds it three times, about 1.5 ulp, and for a capsule along a
    # coordinate axis that rounding of an otherwise exact o_perp moved a barrel root from
    # 0.75 ulp to 65 (an origin near the barrel, which amplifies it).
    if (f64_eq(wx, 0) == 1) { store64(out, vx); }
    if (f64_eq(wy, 0) == 1) { store64(out + 8, vy); }
    if (f64_eq(wz, 0) == 1) { store64(out + 16, vz); }
    return 0;
}

# The rounding of oc = h o - h c (h = 1, or 1/2 where o - c overflowed) into lo, so that
# h (o - c) = oc + lo exactly (3.3.7). o and c finite; a halved subnormal component's last
# bit, below 2^-2098 of the largest, is not carried.
fn _geo_oc_lo(o, c, h, oc, lo) {
    if (h == F64_ONE) {
        store64(lo, _geo_diff_err(HVec3_x(o), HVec3_x(c), HVec3_x(oc)));
        store64(lo + 8, _geo_diff_err(HVec3_y(o), HVec3_y(c), HVec3_y(oc)));
        store64(lo + 16, _geo_diff_err(HVec3_z(o), HVec3_z(c), HVec3_z(oc)));
        return 0;
    }
    store64(lo, _geo_diff_err(f64_mul(HVec3_x(o), h), f64_mul(HVec3_x(c), h), HVec3_x(oc)));
    store64(lo + 8, _geo_diff_err(f64_mul(HVec3_y(o), h), f64_mul(HVec3_y(c), h), HVec3_y(oc)));
    store64(lo + 16, _geo_diff_err(f64_mul(HVec3_z(o), h), f64_mul(HVec3_z(c), h), HVec3_z(oc)));
    return 0;
}

# c = |oc|^2 - r^2 (formed exactly from the rounded oc) corrected to |oc + lo|^2 - r^2, lo
# being oc's rounding: + 2 oc . lo, with |lo|^2 below 2^-104 of |oc|^2 and dropped (3.3.7).
fn _geo_c_lo(c, oc, lo) {
    return f64_add(c, f64_mul(F64_TWO, hvec3_dot(oc, lo)));
}

# f + lo's part across the line of w, into f (3.3.7): f being v's part (_geo_perp_part) and
# lo the rounding of v, |lo| at most 2^-53 |v|, so its plain projection is enough.
fn _geo_add_perp(f, lo, w) {
    var k = f64_div(hvec3_dot(lo, w), hvec3_dot(w, w));
    store64(f, f64_add(HVec3_x(f), f64_sub(HVec3_x(lo), f64_mul(k, HVec3_x(w)))));
    store64(f + 8, f64_add(HVec3_y(f), f64_sub(HVec3_y(lo), f64_mul(k, HVec3_y(w)))));
    store64(f + 16, f64_add(HVec3_z(f), f64_sub(HVec3_z(lo), f64_mul(k, HVec3_z(w)))));
    return 0;
}

# 1 when the radius r is under 2^-4 of v's largest component, by exponent (3.3.6): the
# capsule's test, where a square overflowed, for taking both perpendicular parts exactly
# (geo_ray_capsule_branch). Through round 2 an overflowed square sent every ray at that
# scale to the exact parts; for C2's capsules at 2^1000, whose radius is about |o - start|,
# that moved answers both ways (19 right -> wrong against 675 wrong -> right), and with the
# ratio test alone a ray past a capsule 2^1022 away, radius 2^998, went from 0.19 ulp to
# 9.1e4 (the plain o_perp is off by 2^-52 |o - start|, 2^-28 of r). With this test the
# C2 family has no right -> wrong against 3.3.5.
# [measured: C336 capsule sweeps (seeds 51-53) and C2's seed-71 capsules, round 2 vs this tree, 2026-10-11; cycc 6.6.14]
fn _geo_cap_thin(r, v) {
    if (((r & 0x7FFF_FFFF_FFFF_FFFF) >> 52) + 4 < (_geo_absmax_bits(v) >> 52)) { return 1; }
    return 0;
}

# 1 when p, v's part across an axis as the projection formed it, may be the projection's
# rounding rather than the geometry (see _geo_perp_part): |p|^2 under 2^-80 of |v|^2, or p
# not finite (the projection overflowed). For the capsule when |p|^2 or |v|^2 is not finite:
# the two are compared on copies scaled by v's own power of two. Through round 2 of 3.3.6 an
# overflowed |v|^2 (|d| or |o - start| past 2^511) made every ray suspect, and the exact
# form, about as accurate as the projection there, ran on every ray at that scale and moved
# answers both ways (C2's capsules at 2^1000: 19 right -> wrong against 675 wrong -> right).
fn _geo_perp_suspect(p, v, th) {
    if (_geo_hvec3_nonfinite(p) + _geo_hvec3_nonfinite(v) != 0) { return 1; }
    var s = _geo_scale_for(_geo_absmax_bits(v) >> 52);
    var pt: i64[3];
    var vt: i64[3];
    var ps = _geo_scale_to(&pt, p, s);
    var vs = _geo_scale_to(&vt, v, s);
    return f64_lt(hvec3_dot(ps, ps), f64_mul(hvec3_dot(vs, vs), th));
}

# v's part across the axis u, from copies of both with their largest components in
# [1, 2): written to out as 2^e times the true part, e returned. v and u finite.
fn _geo_perp_rescue(v, u, out) {
    var ut: i64[3];
    var vt: i64[3];
    var ub = _geo_scale_to(&ut, u, _geo_scale_for(_geo_absmax_bits(u) >> 52));
    var sv = _geo_scale_for(_geo_absmax_bits(v) >> 52);
    _geo_perp_part(_geo_scale_to(&vt, v, sv), ub, out);
    return (sv >> 52) - 1023;
}

# The roundings of the capsule's two differences (3.3.7): aol with h (o - start) = ao + aol
# exactly (h = 1/2 when oh = 1), and ul with usa h' (end - start) = u + ul exactly, u being
# usa times the axis formed from the ends (halved first, h' = 1/2, when uh = 1). Finite
# input; a halved subnormal component's last bit is not carried.
fn _geo_cap_lows(ray, capsule, ao, oh, u, usa, uh, aol, ul) {
    _geo_oc_lo(GeoRay_origin(ray), GeoCapsule_start(capsule), _geo_pow2(0 - oh), ao, aol);
    if (usa == F64_ONE) {
        if (uh == 0) {
            _geo_oc_lo(GeoCapsule_end(capsule), GeoCapsule_start(capsule), F64_ONE, u, ul);
            return 0;
        }
    }
    var abt: i64[3];
    var abh = _geo_scale_to(&abt, u, f64_div(F64_ONE, usa));
    _geo_oc_lo(GeoCapsule_end(capsule), GeoCapsule_start(capsule), _geo_pow2(0 - uh), abh, ul);
    store64(ul, f64_mul(HVec3_x(ul), usa));
    store64(ul + 8, f64_mul(HVec3_y(ul), usa));
    store64(ul + 16, f64_mul(HVec3_z(ul), usa));
    return 0;
}

# The offset of the ray's line from the capsule's axis line, as a vector across both (along
# n = u x d) whose length is |(ao + aol) . (u + ul) x d| / |n| (3.3.7), written to out times
# 2^e. The barrel's solver takes it (bx, _geo_sph_solve) where its own offset, formed from
# o_perp and d_perp each rounded, may be their rounding: an origin far from a thin barrel. The
# triple product is formed from the inputs, with n's components exact as two-term sums
# (_geo_two_prod) and ao's rounding carried, to about 2^-104 of |ao| (exactly enough for a
# ray along a coordinate axis, whose n has a zero component). bx holds ray, capsule, ao, oh,
# u, usa, uh and e. 0 when an input is not finite or n is 0 (the caller keeps its own).
fn _geo_cap_axis_offset(bx, out) {
    var ray = load64(bx);
    var capsule = load64(bx + 8);
    var ao = load64(bx + 16);
    var u = load64(bx + 32);
    var d = GeoRay_direction(ray);
    if (_geo_hvec3_nonfinite(ao) + _geo_hvec3_nonfinite(u) + _geo_hvec3_nonfinite(d) != 0) { return 0; }
    var aol[24];
    var ul[24];
    _geo_cap_lows(ray, capsule, ao, load64(bx + 24), u, load64(bx + 40), load64(bx + 48), &aol, &ul);
    if (_geo_hvec3_nonfinite(&aol) + _geo_hvec3_nonfinite(&ul) != 0) { return 0; }
    var sa = _geo_scale_for(_geo_absmax_bits(ao) >> 52);
    var su = _geo_scale_for(_geo_absmax_bits(u) >> 52);
    var dst: i64[3];
    var a2t: i64[3];
    var alt: i64[3];
    var u2t: i64[3];
    var ult: i64[3];
    var ds = _geo_scale_to(&dst, d, _geo_scale_for(_geo_absmax_bits(d) >> 52));
    var a2 = _geo_scale_to(&a2t, ao, sa);
    var al = _geo_scale_to(&alt, &aol, sa);
    var u2 = _geo_scale_to(&u2t, u, su);
    var ul2 = _geo_scale_to(&ult, &ul, su);
    var nh[24];
    var nl[24];
    var p1[16];
    var p2[16];
    var er[8];
    for (var i = 0; i < 3; i = i + 1) {
        var j = (i + 1) % 3;
        var k = (i + 2) % 3;
        _geo_two_prod(load64(u2 + j * 8), load64(ds + k * 8), &p1);
        _geo_two_prod(load64(u2 + k * 8), load64(ds + j * 8), &p2);
        store64(&er, 0);
        var sm = _geo_two_sum(load64(&p1), f64_neg(load64(&p2)), &er);
        var lo = f64_add(load64(&er), f64_sub(load64(&p1 + 8), load64(&p2 + 8)));
        lo = f64_add(lo, f64_sub(f64_mul(load64(ul2 + j * 8), load64(ds + k * 8)),
            f64_mul(load64(ul2 + k * 8), load64(ds + j * 8))));
        store64(&nh + i * 8, sm);
        store64(&nl + i * 8, lo);
    }
    var nn = hvec3_dot(&nh, &nh);
    if (f64_eq(nn, 0) == 1) { return 0; }
    store64(&er, 0);
    var tail = 0;
    var dt = 0;
    for (var i2 = 0; i2 < 3; i2 = i2 + 1) {
        _geo_two_prod(load64(a2 + i2 * 8), load64(&nh + i2 * 8), &p1);
        dt = _geo_two_sum(dt, load64(&p1), &er);
        tail = f64_add(tail, f64_add(load64(&p1 + 8), f64_add(f64_mul(load64(a2 + i2 * 8), load64(&nl + i2 * 8)),
              f64_mul(load64(al + i2 * 8), load64(&nh + i2 * 8)))));
    }
    dt = f64_add(dt, f64_add(load64(&er), tail));
    var q = f64_div(dt, nn);
    var e = load64(bx + 56) - ((sa >> 52) - 1023);
    store64(out, _geo_ldexp(f64_mul(HVec3_x(&nh), q), e));
    store64(out + 8, _geo_ldexp(f64_mul(HVec3_y(&nh), q), e));
    store64(out + 16, _geo_ldexp(f64_mul(HVec3_z(&nh), q), e));
    return 1;
}

# The part of ao + aol (o - start exactly, as a value and its rounding) across the axis u,
# into out: (ao + aol) - u opar with each product u_i opar exact (_geo_two_prod), then the
# part along u that opar's own rounding left, removed by one more projection.
fn _geo_perp_comp(ao, aol, u, ul, uu, opar, out) {
    var pp[16];
    _geo_two_prod(HVec3_x(u), opar, &pp);
    var x = f64_add(f64_sub(HVec3_x(ao), load64(&pp)),
      f64_sub(HVec3_x(aol), f64_add(load64(&pp + 8), f64_mul(HVec3_x(ul), opar))));
    _geo_two_prod(HVec3_y(u), opar, &pp);
    var y = f64_add(f64_sub(HVec3_y(ao), load64(&pp)),
      f64_sub(HVec3_y(aol), f64_add(load64(&pp + 8), f64_mul(HVec3_y(ul), opar))));
    _geo_two_prod(HVec3_z(u), opar, &pp);
    var z = f64_add(f64_sub(HVec3_z(ao), load64(&pp)),
      f64_sub(HVec3_z(aol), f64_add(load64(&pp + 8), f64_mul(HVec3_z(ul), opar))));
    var k = f64_div(f64_add(f64_add(f64_mul(x, HVec3_x(u)), f64_mul(y, HVec3_y(u))), f64_mul(z, HVec3_z(u))), uu);
    store64(out, f64_sub(x, f64_mul(HVec3_x(u), k)));
    store64(out + 8, f64_sub(y, f64_mul(HVec3_y(u), k)));
    store64(out + 16, f64_sub(z, f64_mul(HVec3_z(u), k)));
    return 0;
}

# _geo_cap_lows then _geo_perp_comp for the common case (u = ab = end - start itself, nothing
# halved), fused into one loop: the same operations in the same order, so the same bits, without
# the eleven calls between them (3.3.7: they were most of the compensation's cost).
fn _geo_perp_comp1(o, st, en, ao, u, uu, opar, out) {
    var sy = f64_mul(opar, 0x41A0_0000_0200_0000);   # 2^27 + 1
    var yh = f64_sub(sy, f64_sub(sy, opar));
    var yl = f64_sub(opar, yh);
    var xv[24];
    for (var i = 0; i < 3; i = i + 1) {
        var oi = load64(o + i * 8);
        var si = load64(st + i * 8);
        var ai = load64(ao + i * 8);
        var ui = load64(u + i * 8);
        var ei = load64(en + i * 8);
        var nb = f64_neg(si);
        var bb = f64_sub(ai, oi);
        var aol = f64_add(f64_sub(oi, f64_sub(ai, bb)), f64_sub(nb, bb));
        var bb2 = f64_sub(ui, ei);
        var ul = f64_add(f64_sub(ei, f64_sub(ui, bb2)), f64_sub(nb, bb2));
        var sx = f64_mul(ui, 0x41A0_0000_0200_0000);
        var xh = f64_sub(sx, f64_sub(sx, ui));
        var xl = f64_sub(ui, xh);
        var pr = f64_mul(ui, opar);
        var e = f64_add(f64_add(f64_sub(f64_mul(xh, yh), pr), f64_mul(xh, yl)), f64_mul(xl, yh));
        e = f64_add(e, f64_mul(xl, yl));
        store64(&xv + i * 8, f64_add(f64_sub(ai, pr), f64_sub(aol, f64_add(e, f64_mul(ul, opar)))));
    }
    var x = load64(&xv);
    var y = load64(&xv + 8);
    var z = load64(&xv + 16);
    var k = f64_div(f64_add(f64_add(f64_mul(x, HVec3_x(u)), f64_mul(y, HVec3_y(u))), f64_mul(z, HVec3_z(u))), uu);
    store64(out, f64_sub(x, f64_mul(HVec3_x(u), k)));
    store64(out + 8, f64_sub(y, f64_mul(HVec3_y(u), k)));
    store64(out + 16, f64_sub(z, f64_mul(HVec3_z(u), k)));
    return 0;
}

# The barrel of a capsule thin against the origin's distance from its start, solved from exact
# coefficients (3.4.0). With w = o - start and u = end - start taken exactly (each as its rounded
# value and its rounding), n = u x d and m = u x w, the barrel's quadratic times |u|^2 is
#     N t^2 + 2 M t + K = 0,   N = |n|^2,  M = m . n,  K = |m|^2 - r^2 |u|^2,
# and its discriminant M^2 - N K is |u|^2 (r^2 N - det^2), det = w . n (Lagrange's identity, and
# m x n = det u). Each of N, M, K, r^2 N - det^2 and |u|^2 is formed as an exact expansion and
# rounded once; the sign of r^2 N - det^2 is the verdict, exactly, and the roots are q / N and
# K / q with q = -(M + sign(M) sqrt(|u|^2 (r^2 N - det^2))), within a few ulps wherever they are.
# ⛔ DOUBLE-DOUBLE WAS NOT ENOUGH BEYOND 2^100 RADII. The axis offset (_geo_cap_axis_offset) and
# o_perp (_geo_perp_comp1) are good to about 2^-104 of |o - start|, which is more than the radius of
# a barrel 2^104 radii away: the roadmap's barrel 2^168 radii from the origin, an exact miss, read
# the hit 0x4019829250689FF4 (3.3.6 0x401982924B798BAA); 529 of a 1,000-ray family of thin
# barrels 2^100 to 2^300 radii away were wrong. w, u and d are first scaled to unit size, so every
# product stays exact.
# ⛔ 3.4.0 review repairs. (M1) Every expansion lives in a 96-word buffer whose bound is held by
# construction (_geo_xmul fails, -1, before it could pass it, rather than write past it); the first
# draft grew them uncompressed in 48 words and crashed on decimal inputs whose components spread
# over many binades. Each stage is compressed before it is multiplied, which keeps them far under.
# (S1) A ray whose line provably passes the axis farther than r, by a float bound with its rounding
# (_geo_barrel_far), is answered 0 before any expansion: a unit capsule of radius 1e-16 missed by 5
# units cost 21 us a call and is about base's 0.5 us again. (S2) r is not tied to w's scale: the
# discriminant and K are each formed at a power of two of their own (kd, km: det and r, m and r
# taken to unit size together; only up, so no component is lost), which keeps r^2 in range far past
# the first draft's 2^400 radii; the caller's bound is now 2^1000.
# Exactness, and where it ends. A product of two words is exact, low part included, when it is
# 2^-969 or more, and a power-of-two scaling when it stays normal; each product that is not
# (_geo_xscale) and each scaling that goes subnormal (_geo_xsc) is counted (lost, under 2^lb), and is
# off by 2^-1072 or less where it happens, at unit size. The inputs' components are under 2 there;
# n and m under 8 (under 2 once taken up by sn, km), det under 48 (under 2 once taken up by kd), r
# under 2. An error grows only by those sizes and by the scalings taken up after it, so at the scale
# each is formed: |err(n')| < 2^(lb - 1072) sn, |err(det)| < 2^(lb - 1068.6) sn, |err(N)| <
# 2^(lb - 1066.3) sn, |err(r^2 N - det^2)| < 2^(lb - 1061) sn 2^kd, |err(M)| < 2^(lb - 1065.4)
# max(sn, 2^km), |err(K)| < 2^(lb - 1065.3) 2^km. The verdict needs only the sign of r^2 N - det^2:
# it is taken when that is above twice its bound; the roots, q / N and K / q, when M and K are 2^55
# above theirs and r^2 N - det^2's reaches q only as (sq / |q|) err / |ds| / 2 under 2^-55; else the
# barrel goes back to the caller (-1). With nothing counted, as for every input whose components sit
# within about 2^450 of their vector's largest, there is nothing to check. (The first draft of these
# repairs refused any word under 2^-450: every ray from within 2^-450 of a unit capsule's axis; the
# second counted every product of a call that could round and asked 2^60 of every quantity, and
# refused 74 to 195 of 200 thin barrels at gx 990 to 1000, the second review's N2, whose double-
# double fallback is wrong there. The review's capsule rays with a 1e300 and a 1e41 component in one
# vector, a hit for a miss and 3.9e13 ulp unrefused, are still refused.)
# The roots go to out unscaled, sorted, and the return is 1 with their power of two (log2) in
# out[2]; 0 when the barrel is not crossed (r^2 N < det^2, or the ray is parallel to the axis);
# -1 when an input is not finite, r is not positive, r leaves the normal range at w's scale, or an
# expansion would pass its bound (the caller then solves as before).
# [measured: rt340 thin-barrel family (sweep.py thin), exact Fraction oracle, 3.4.0 base vs this tree, 2026-10-31]
fn _geo_barrel_xact(ray, capsule, out) {
    if (_geo_barrel_far0(ray, capsule) == 1) { return 0; }
    var x: i64[26];
    if (_geo_xunit(ray, capsule, &x) == 0) { return 0 - 1; }
    var rs = load64(&x + 176);
    # (bits: rs subnormal, 0, or past range)
    if (rs < 0x0010_0000_0000_0000 || rs >= 0x7FF0_0000_0000_0000) { return 0 - 1; }
    var wx = &x;
    var ux = &x + 48;
    var dx = &x + 96;
    var wn = &x + 120;
    var un = &x + 144;
    var lostv: i64[2];   # products and scalings that may have rounded, and their sizes (_geo_xlost)
    store64(&lostv, load64(&x + 168));
    store64(&lostv + 8, f64_from(load64(&x + 168)));
    var lost = &lostv;
    var sw = load64(&x + 184);
    var sd = load64(&x + 200);
    # n = u x d and m = u x w, componentwise expansions (96 words each).
    var nx: i64[288];
    var mx: i64[288];
    var nl: i64[3];
    var ml: i64[3];
    var lnu: i64[3];   # the sizes of n's and m's own roundings, per component (_geo_xlost's units)
    var lmu: i64[3];
    for (var k = 0; k < 3; k = k + 1) {
        var j1 = (k + 1) % 3;
        var j2 = (k + 2) % 3;
        var pn = &nx + k * 768;
        var pm = &mx + k * 768;
        var a1 = ux + j1 * 16;
        var a2 = ux + j2 * 16;
        var n1 = load64(un + j1 * 8);
        var n2 = load64(un + j2 * 8);
        var ut = load64(lost + 8);
        store64(lost + 8, 0);
        var lnk = _geo_xmul_l(pn, 0, a1, n1, dx + j2 * 8, 1, F64_ONE, lost);
        lnk = _geo_xmul_l(pn, lnk, a2, n2, dx + j1 * 8, 1, f64_neg(F64_ONE), lost);
        store64(&lnu + k * 8, load64(lost + 8));
        store64(lost + 8, 0);
        var lmk = _geo_xmul_l(pm, 0, a1, n1, wx + j2 * 16, load64(wn + j2 * 8), F64_ONE, lost);
        lmk = _geo_xmul_l(pm, lmk, a2, n2, wx + j1 * 16, load64(wn + j1 * 8), f64_neg(F64_ONE), lost);
        store64(&lmu + k * 8, load64(lost + 8));
        store64(lost + 8, f64_add(ut, f64_add(load64(&lnu + k * 8), load64(&lmu + k * 8))));
        if (lnk < 0 || lmk < 0) { return 0 - 1; }
        store64(&nl + k * 8, _geo_xcompress(pn, lnk));
        store64(&ml + k * 8, _geo_xcompress(pm, lmk));
    }
    # A ray within a small angle of the axis has a small n, and r^2 |n|^2 could leave the range:
    # n is taken to unit size (d multiplied by sn, exact on expansions), its roots then times sn.
    var nmax = 0;
    for (var k2 = 0; k2 < 3; k2 = k2 + 1) {
        var nb = f64_abs(_geo_xval(&nx + k2 * 768, load64(&nl + k2 * 8)));
        if (nb > nmax) { nmax = nb; }
    }
    if (nmax == 0) {
        # parallel to the axis: no barrel crossing, unless n is 0 only by a counted rounding
        if (load64(lost) != 0) { return 0 - 1; }
        return 0;
    }
    var sn = F64_ONE;
    if (nmax < 0x3FF0_0000_0000_0000) {
        sn = _geo_scale_for(nmax >> 52);
        for (var k3 = 0; k3 < 3; k3 = k3 + 1) {
            var pn3 = &nx + k3 * 768;
            for (var i3 = 0; i3 < load64(&nl + k3 * 8); i3 = i3 + 1) {
                store64(pn3 + i3 * 8, f64_mul(load64(pn3 + i3 * 8), sn));
            }
        }
    }
    var dt: i64[96];
    var nn: i64[96];
    var uu: i64[96];
    var ldt = 0;
    var lnn = 0;
    var luu = 0;
    store64(lost + 8, 0);   # (from here, the later products' own: lr below)
    for (var c2 = 0; c2 < 3; c2 = c2 + 1) {
        var pn2 = &nx + c2 * 768;
        var ln2 = load64(&nl + c2 * 8);
        ldt = _geo_xmul_l(&dt, ldt, wx + c2 * 16, load64(wn + c2 * 8), pn2, ln2, F64_ONE, lost);
        lnn = _geo_xmul_l(&nn, lnn, pn2, ln2, pn2, ln2, F64_ONE, lost);
        var pu2 = ux + c2 * 16;
        var lu2 = load64(un + c2 * 8);
        luu = _geo_xmul_l(&uu, luu, pu2, lu2, pu2, lu2, F64_ONE, lost);
    }
    if (ldt < 0 || lnn < 0 || luu < 0) { return 0 - 1; }
    ldt = _geo_xcompress(&dt, ldt);
    lnn = _geo_xcompress(&nn, lnn);
    luu = _geo_xcompress(&uu, luu);
    var nv = _geo_xval(&nn, lnn);
    # disc = r^2 N - det^2 at 2^(2 kd): det and r taken up together until the larger of |det| and
    # r |n| is near 1 (up only; a sign, and a root's scale, are the same at any power of two).
    var kd = _geo_xup(f64_abs(_geo_xval(&dt, ldt)), rs);   # (|n| is near 1 now)
    var sdk = _geo_pow2(kd);
    for (var i4 = 0; i4 < ldt; i4 = i4 + 1) { store64(&dt + i4 * 8, f64_mul(load64(&dt + i4 * 8), sdk)); }
    var r1: i64[1];
    store64(&r1, f64_mul(rs, sdk));
    var r2: i64[2];
    var lr2 = _geo_xmul_l(&r2, 0, &r1, 1, &r1, 1, F64_ONE, lost);
    var ds: i64[96];
    var lds = _geo_xmul_l(&ds, 0, &r2, lr2, &nn, lnn, F64_ONE, lost);
    lds = _geo_xmul_l(&ds, lds, &dt, ldt, &dt, ldt, f64_neg(F64_ONE), lost);
    if (lds < 0) { return 0 - 1; }
    lds = _geo_xcompress(&ds, lds);
    # r^2 N - det^2 and N 2^60 clear of what the counted roundings can have moved (see above).
    var lb = _geo_xbits(load64(lost));
    var es = (sn >> 52) - 1023;
    var dsv = _geo_xval(&ds, lds);
    # The same bounds component by component, from the roundings' sizes (_geo_xlost; 3.4.0, the
    # second review's N2): exponents above the errors of n' = n sn (each component's own units and
    # 8 per input scaling, times sn), det = w . n' (|w_k| times those, and 8 per input scaling and
    # the later products' units), N (|n'_k|), det at 2^kd, r1^2 and r^2 N - det^2. Taken where the
    # count's worst case cannot settle the verdict below (the roots keep the count's tests: no
    # family here met one that only these bounds would pass): a product of two words far under their
    # vectors' largest is far under 2^-1072, and |w_k| can be far under 2, so a ray whose n has a
    # word 2^-791 under its largest (a needle capsule met along its axis, its end 2^-1033 from an
    # axis 2^-244 long) was refused at the verdict; both its roots are now within 3.2e-78 ulp. (Its
    # answer is still wrong: that capsule is far from the origin against its size, and the far copy
    # (_geo_capsule_far), which does not call this solver, reads a hit at t = 1 for the exact miss
    # that 3.3.7 and integ-snap6 gave; nor could _geo_barrel_seam_x place the root, its N A^2 +
    # 2 M A B + K B^2 flushing below 2^-1074 at unit size there.)
    # [measured: R2E aimed family (x_len.aimed, seed 1), exact Fractions, base, integ-snap6 and this tree, 2026-10-31]
    var lxd = f64_mul(f64_from(load64(&x + 168)), 0x4020_0000_0000_0000);   # 8 per input scaling
    var lr = load64(lost + 8);
    var dte = _geo_xue(f64_add(lxd, lr));
    var nre = _geo_xue(lr);
    for (var c5 = 0; c5 < 3; c5 = c5 + 1) {
        var enk = _geo_xue(f64_add(load64(&lnu + c5 * 8), lxd)) + es;
        var wk = _geo_xub(_geo_xval(wx + c5 * 16, load64(wn + c5 * 8)));
        var nk = _geo_xub(_geo_xval(&nx + c5 * 768, load64(&nl + c5 * 8)));
        dte = _geo_imax(dte, wk + enk);
        nre = _geo_imax(nre, _geo_imax(nk + 1, enk + 1) + enk);
    }
    var dke = dte + 2 + kd;
    nre = nre + 2;
    var r2e = _geo_xue(lr);
    var dse = _geo_imax(_geo_xub(_geo_xval(&r2, lr2)) + nre, _geo_xub(nv) + r2e);
    dse = _geo_imax(dse, _geo_imax(r2e + nre, _geo_xue(lr)));
    dse = _geo_imax(dse, _geo_imax(_geo_xub(_geo_xval(&dt, ldt)) + 1, dke + 1) + dke) + 3;
    if (lb > 0) {
        # (the verdict needs only its sign: r^2 N - det^2 above what the count can move, twice over,
        # or above its bound component by component four times over; N 2^56 above its error)
        var vok = _geo_xabove(dsv, lb + es + kd - 1060) & _geo_xabove(nv, lb + es - 1010);
        if (vok == 0) { vok = _geo_xabove(dsv, dse + 2) & _geo_xabove(nv, nre + 56); }
        if (vok == 0) { return 0 - 1; }
    }
    if (_geo_xsign(&ds, lds) < 0) { return 0; }
    var dd: i64[96];
    var ldd = _geo_xmul_l(&dd, 0, &uu, luu, &ds, lds, F64_ONE, lost);
    if (ldd < 0) { return 0 - 1; }
    # K = |m|^2 - r^2 |u|^2 and M = m . n at 2^(2 km) and 2^km, m and r taken up together likewise.
    var mmax = 0;
    for (var k4 = 0; k4 < 3; k4 = k4 + 1) {
        var mb = f64_abs(_geo_xval(&mx + k4 * 768, load64(&ml + k4 * 8)));
        if (mb > mmax) { mmax = mb; }
    }
    var km = _geo_xup(mmax, rs);   # (|u| is in [1, 2))
    var smk = _geo_pow2(km);
    var mm: i64[96];
    var kk: i64[96];
    var lmm = 0;
    var lkk = 0;
    for (var c3 = 0; c3 < 3; c3 = c3 + 1) {
        var pm3 = &mx + c3 * 768;
        var lm3 = load64(&ml + c3 * 8);
        for (var i5 = 0; i5 < lm3; i5 = i5 + 1) { store64(pm3 + i5 * 8, f64_mul(load64(pm3 + i5 * 8), smk)); }
        lmm = _geo_xmul_l(&mm, lmm, pm3, lm3, &nx + c3 * 768, load64(&nl + c3 * 8), F64_ONE, lost);
        lkk = _geo_xmul_l(&kk, lkk, pm3, lm3, pm3, lm3, F64_ONE, lost);
    }
    store64(&r1, f64_mul(rs, smk));
    var rk: i64[2];
    var lrk = _geo_xmul_l(&rk, 0, &r1, 1, &r1, 1, F64_ONE, lost);
    lkk = _geo_xmul_l(&kk, lkk, &rk, lrk, &uu, luu, f64_neg(F64_ONE), lost);
    if (lmm < 0 || lkk < 0) { return 0 - 1; }
    var mv = _geo_xval(&mm, lmm);
    var kv = _geo_xval(&kk, lkk);
    # sqrt(|u|^2 disc) is at 2^kd, M at 2^km: q at 2^km.
    var sq = _geo_ldexp(f64_sqrt(_geo_xval(&dd, ldd)), km - kd);
    var q = f64_neg(f64_add(mv, sq));
    if (f64_lt(mv, 0) == 1) { q = f64_sub(sq, mv); }
    lb = _geo_xbits(load64(lost));
    if (lb > 0) {
        # The roots: M's and K's roundings under q and K, and r^2 N - det^2's through the square root,
        # err(ds) / |ds| times sq / |q| / 2 (small for a ray near tangency, whose square root is small
        # against q), each held under 2^(gx - 106), where gx = log2(|w| / r): the double-double solve
        # the caller would fall back to is good to about 2^(gx - 104) of a root, so these roots are
        # handed back only where that would do better (from gx 49 on, 2^-57 and looser; the second
        # review's N2 subnormal ray, an exact miss, read a hit at 5.2e-315 from that solve at gx 963).
        var kq = km;
        if (es > kq) { kq = es; }
        var gx = 0 - _geo_xexp(rs);
        var rok = _geo_xabove(q, lb + kq - 1065 + 106 - gx) & _geo_xabove(kv, lb + km - 1065 + 106 - gx);
        if (_geo_xexp(dsv) - (lb + es + kd - 1061) < 107 - gx + _geo_xexp(sq) - _geo_xexp(q)) { rok = 0; }
        if (rok == 0) { return 0 - 1; }
    }
    var t1 = f64_div(q, nv);
    var t2 = t1;
    if (f64_eq(q, 0) == 0) { t2 = f64_div(kv, q); }
    if (f64_gt(t1, t2) == 1) {
        var tt = t1;
        t1 = t2;
        t2 = tt;
    }
    store64(out, t1);
    store64(out + 8, t2);
    store64(out + 16, ((sd >> 52) - 1023) + ((sn >> 52) - 1023) - ((sw >> 52) - 1023) - km);
    return 1;
}

# The barrel's inputs at unit size, for _geo_barrel_xact, _geo_barrel_seam_x and _geo_barrel_csign
# (3.4.0): w = o - start and u = end - start each as two words (its scaled rounding, then its scaled
# value; one word where the rounding is 0) and d, each times the power of two that takes its largest
# component into [1, 2). Into x (26 words): w at 0 (6 words), u at 48, d at 96 (3), the word counts
# of w's and u's components at 120 and 144, at 168 the count of scalings that may have rounded
# (_geo_xsc), at 176 r times w's power, and the three powers (sw, su, sd) at 184, 192, 200.
# 0 when an input is not finite, r is not finite and positive, or w, u or d is zero.
fn _geo_xunit(ray, capsule, x) {
    var o = GeoRay_origin(ray);
    var d = GeoRay_direction(ray);
    var st = GeoCapsule_start(capsule);
    var en = GeoCapsule_end(capsule);
    var r = GeoCapsule_radius(capsule);
    var nf = _geo_hvec3_nonfinite(o) + _geo_hvec3_nonfinite(d) + _geo_hvec3_nonfinite(st) + _geo_hvec3_nonfinite(en);
    if (nf != 0 || f64_gt(r, 0) == 0 || f64_lt(r, _GEO_F64_POS_INF) == 0) { return 0; }
    var w[24];
    var wl[24];
    var u[24];
    var ul[24];
    for (var i = 0; i < 3; i = i + 1) {
        var oi = load64(o + i * 8);
        var si = load64(st + i * 8);
        var ei = load64(en + i * 8);
        var wi = f64_sub(oi, si);
        var ui = f64_sub(ei, si);
        if (f64_lt(f64_abs(wi), _GEO_F64_POS_INF) == 0 || f64_lt(f64_abs(ui), _GEO_F64_POS_INF) == 0) { return 0; }
        store64(&w + i * 8, wi);
        store64(&wl + i * 8, _geo_diff_err(oi, si, wi));
        store64(&u + i * 8, ui);
        store64(&ul + i * 8, _geo_diff_err(ei, si, ui));
    }
    var mw = _geo_absmax_bits(&w);
    var mu = _geo_absmax_bits(&u);
    var md = _geo_absmax_bits(d);
    if (mw == 0 || mu == 0 || md == 0) { return 0; }
    var sw = _geo_scale_for(mw >> 52);
    var su = _geo_scale_for(mu >> 52);
    var sd = _geo_scale_for(md >> 52);
    var lost = x + 168;
    store64(lost, 0);
    for (var c = 0; c < 3; c = c + 1) {
        var wlo = _geo_xsc(load64(&wl + c * 8), sw, lost);
        var ulo = _geo_xsc(load64(&ul + c * 8), su, lost);
        store64(x + c * 16, wlo);
        store64(x + c * 16 + 8, _geo_xsc(load64(&w + c * 8), sw, lost));
        store64(x + 48 + c * 16, ulo);
        store64(x + 48 + c * 16 + 8, _geo_xsc(load64(&u + c * 8), su, lost));
        store64(x + 96 + c * 8, _geo_xsc(load64(d + c * 8), sd, lost));
        # (a zero rounding is left out, so the two words are an expansion)
        store64(x + 120 + c * 8, 2);
        if (f64_eq(wlo, 0) == 1) {
            store64(x + c * 16, load64(x + c * 16 + 8));
            store64(x + 120 + c * 8, 1);
        }
        store64(x + 144 + c * 8, 2);
        if (f64_eq(ulo, 0) == 1) {
            store64(x + 48 + c * 16, load64(x + 48 + c * 16 + 8));
            store64(x + 144 + c * 8, 1);
        }
    }
    store64(x + 176, _geo_xsc(r, sw, lost));
    store64(x + 184, sw);
    store64(x + 192, su);
    store64(x + 200, sd);
    return 1;
}

# The sign of the barrel's c = |o_perp|^2 - r^2, exactly (3.4.0): -1, 0 or 1 as the origin is inside,
# on or outside the infinite barrel, from K = |u x w|^2 - r^2 |u|^2 = c |u|^2 formed as an exact
# expansion at unit size (_geo_xunit); 3 when an input is not finite, an expansion would pass its
# bound, or a counted rounding (each 2^-1072 or less, every word under 2^4) could reach the sign.
fn _geo_barrel_csign(ray, capsule) {
    var x: i64[26];
    if (_geo_xunit(ray, capsule, &x) == 0) { return 3; }
    var lostv: i64[2];
    store64(&lostv, load64(&x + 168));
    store64(&lostv + 8, f64_from(load64(&x + 168)));
    var lost = &lostv;
    var kk: i64[96];
    var lkk = 0;
    var mc: i64[96];
    for (var k = 0; k < 3; k = k + 1) {
        var j1 = (k + 1) % 3;
        var j2 = (k + 2) % 3;
        var a1 = &x + 48 + j1 * 16;
        var a2 = &x + 48 + j2 * 16;
        var n1 = load64(&x + 144 + j1 * 8);
        var n2 = load64(&x + 144 + j2 * 8);
        var lm = _geo_xmul_l(&mc, 0, a1, n1, &x + j2 * 16, load64(&x + 120 + j2 * 8), F64_ONE, lost);
        lm = _geo_xmul_l(&mc, lm, a2, n2, &x + j1 * 16, load64(&x + 120 + j1 * 8), f64_neg(F64_ONE), lost);
        if (lm < 0) { return 3; }
        lm = _geo_xcompress(&mc, lm);
        lkk = _geo_xmul_l(&kk, lkk, &mc, lm, &mc, lm, F64_ONE, lost);
    }
    var uu: i64[96];
    var luu = 0;
    for (var c = 0; c < 3; c = c + 1) {
        var pu = &x + 48 + c * 16;
        var lu = load64(&x + 144 + c * 8);
        luu = _geo_xmul_l(&uu, luu, pu, lu, pu, lu, F64_ONE, lost);
    }
    if (luu < 0) { return 3; }
    luu = _geo_xcompress(&uu, luu);
    var r2: i64[2];
    var lr2 = _geo_xmul_l(&r2, 0, &x + 176, 1, &x + 176, 1, F64_ONE, lost);
    lkk = _geo_xmul_l(&kk, lkk, &r2, lr2, &uu, luu, f64_neg(F64_ONE), lost);
    if (lkk < 0) { return 3; }
    lkk = _geo_xcompress(&kk, lkk);
    var lb = _geo_xbits(load64(lost));
    if (lb > 0 && _geo_xabove(_geo_xval(&kk, lkk), lb - 1040) == 0) { return 3; }
    return _geo_xsign(&kk, lkk);
}

# x s (s a power of two), with 1 added to the count at lost when that may have rounded: x not 0
# and the product under 2^-1022 (3.4.0, _geo_barrel_xact; the rounding is then 2^-1075 at most).
fn _geo_xsc(x, s, lost) {
    var y = f64_mul(x, s);
    if ((x & 0x7FFF_FFFF_FFFF_FFFF) != 0 && (y & 0x7FFF_FFFF_FFFF_FFFF) < 0x0010_0000_0000_0000) {
        store64(lost, load64(lost) + 1);
    }
    return y;
}

# _geo_xmul at a 96-word cap with k = +-1, counting at lost each product that rounded (_geo_xscale:
# a product of nonzero words under 2^-969, off by 2^-1073 at most), 3.4.0, _geo_barrel_xact. (Through
# the second review every product of a call was counted when its smallest words' exponents allowed one
# to round: the count, and the bounds below, ran ~2^10 high, and solvable barrels were refused, N2.)
fn _geo_xmul_l(e, n, a, na, b, nb, k, lost) {
    return _geo_xmul_c(e, n, a, na, b, nb, k, 96, lost);
}

# The number of bits in the count c (c < 2^result; 0 for 0).
fn _geo_xbits(c) {
    var b = 0;
    while ((c >> b) != 0) { b = b + 1; }
    return b;
}

# The exponent of |x| (finite): e with 2^e <= |x| < 2^(e + 1), or -1075 for a subnormal or 0 (3.4.0).
fn _geo_xexp(x) {
    var f = (x & 0x7FFF_FFFF_FFFF_FFFF) >> 52;
    if (f == 0) { return 0 - 1075; }
    return f - 1023;
}

# 1 when |v| is 2^x or more (x clamped up to -1022; 0 when x passes 1023).
fn _geo_xabove(v, x) {
    if (x > 1023) { return 0; }
    if (x < 0 - 1022) { x = 0 - 1022; }
    if ((v & 0x7FFF_FFFF_FFFF_FFFF) >= ((x + 1023) << 52)) { return 1; }
    return 0;
}

# The power of two (log2, 0 or more) that takes the larger of |x| and |y| (finite, non-negative)
# into [1, 2), or 0 when it is already 1 or more, or both are 0 (3.4.0, _geo_barrel_xact).
fn _geo_xup(x, y) {
    var m = x & 0x7FFF_FFFF_FFFF_FFFF;
    var my = y & 0x7FFF_FFFF_FFFF_FFFF;
    if (my > m) { m = my; }
    if (m == 0 || m >= 0x3FF0_0000_0000_0000) { return 0; }
    var e = (m >> 52) - 1023;
    if (e < 0 - 1022) { e = 0 - 1022; }   # a subnormal: 2^1022 takes it to [2^-52, 2)
    return 0 - e;
}

# Where the barrel's exact roots (out2[0] the near, out2[1] the far) lie against the segment's end
# planes (3.4.0): -1 before the start plane, 2 past the end plane, 0 on the segment (its planes
# included), or 3 when that cannot be decided exactly here (the caller then keeps its own test). For a root
# _geo_barrel_xact solved whose segment test, formed from the root rounded, is within its rounding
# of a plane: a ray grazing a thin barrel at its seam, where the barrel's two roots and the cap
# sphere's can agree in every bit and only the exact place of the root says which surface is hit.
# With the inputs at unit size and exact as there (w = o - start, u = end - start, d), the barrel is
# f(tau) = N tau^2 + 2 M tau + K = 0 (N = |u x d|^2, M = (u x w) . (u x d), K = |u x w|^2 - r^2 |u|^2)
# and a plane is crossed at tau_p = A / B, B = d . u, A = -(w . u) for the start and c |u|^2 - w . u
# for the end (c the ratio of the two scalings). f(tau_p) B^2 = N A^2 + 2 M A B + K B^2 is negative
# when tau_p lies between the roots, and (A N + M B) B has the sign of tau_p less the vertex -M / N;
# both are exact expansions, so the root's side of each plane is exact. 3 when an input is not
# finite, a counted rounding (_geo_xmul_l, _geo_xsc) could reach one of those signs, an expansion
# would pass its bound, or the end plane is wanted with |u| more than 2^60 times |w|.
fn _geo_barrel_seam_x(ray, capsule, out2) {
    store64(out2, 3);
    store64(out2 + 8, 3);
    var x: i64[26];
    if (_geo_xunit(ray, capsule, &x) == 0) { return 0; }
    var wx = &x;
    var ux = &x + 48;
    var dx = &x + 96;
    var wn = &x + 120;
    var un = &x + 144;
    var lostv: i64[2];
    store64(&lostv, load64(&x + 168));
    store64(&lostv + 8, f64_from(load64(&x + 168)));
    var lost = &lostv;
    var sw = load64(&x + 184);
    var su = load64(&x + 192);
    var r1: i64[1];
    store64(&r1, load64(&x + 176));
    # n = u x d, m = u x w; then N, M, K, |u|^2, w . u and B = d . u.
    var nx: i64[288];
    var mx: i64[288];
    var nl: i64[3];
    var ml: i64[3];
    for (var k = 0; k < 3; k = k + 1) {
        var j1 = (k + 1) % 3;
        var j2 = (k + 2) % 3;
        var a1 = ux + j1 * 16;
        var a2 = ux + j2 * 16;
        var n1 = load64(un + j1 * 8);
        var n2 = load64(un + j2 * 8);
        var lnk = _geo_xmul_l(&nx + k * 768, 0, a1, n1, dx + j2 * 8, 1, F64_ONE, lost);
        lnk = _geo_xmul_l(&nx + k * 768, lnk, a2, n2, dx + j1 * 8, 1, f64_neg(F64_ONE), lost);
        var lmk = _geo_xmul_l(&mx + k * 768, 0, a1, n1, wx + j2 * 16, load64(wn + j2 * 8), F64_ONE, lost);
        lmk = _geo_xmul_l(&mx + k * 768, lmk, a2, n2, wx + j1 * 16, load64(wn + j1 * 8), f64_neg(F64_ONE), lost);
        if (lnk < 0 || lmk < 0) { return 0; }
        store64(&nl + k * 8, _geo_xcompress(&nx + k * 768, lnk));
        store64(&ml + k * 8, _geo_xcompress(&mx + k * 768, lmk));
    }
    var q: i64[10];   # N, M, K, B with their lengths, and lost
    var nn: i64[96];
    var mn: i64[96];
    var kk: i64[96];
    var uu: i64[96];
    var wu: i64[96];
    var bb: i64[96];
    var lnn = 0;
    var lmn = 0;
    var lkk = 0;
    var luu = 0;
    var lwu = 0;
    var lbb = 0;
    for (var c2 = 0; c2 < 3; c2 = c2 + 1) {
        var pn = &nx + c2 * 768;
        var pm = &mx + c2 * 768;
        var ln = load64(&nl + c2 * 8);
        var lm = load64(&ml + c2 * 8);
        var pu = ux + c2 * 16;
        var lu = load64(un + c2 * 8);
        lnn = _geo_xmul_l(&nn, lnn, pn, ln, pn, ln, F64_ONE, lost);
        lmn = _geo_xmul_l(&mn, lmn, pm, lm, pn, ln, F64_ONE, lost);
        lkk = _geo_xmul_l(&kk, lkk, pm, lm, pm, lm, F64_ONE, lost);
        luu = _geo_xmul_l(&uu, luu, pu, lu, pu, lu, F64_ONE, lost);
        lwu = _geo_xmul_l(&wu, lwu, wx + c2 * 16, load64(wn + c2 * 8), pu, lu, F64_ONE, lost);
        lbb = _geo_xmul_l(&bb, lbb, dx + c2 * 8, 1, pu, lu, F64_ONE, lost);
    }
    if (luu < 0) { return 0; }
    luu = _geo_xcompress(&uu, luu);
    var r2: i64[2];
    var lr2 = _geo_xmul_l(&r2, 0, &r1, 1, &r1, 1, F64_ONE, lost);
    lkk = _geo_xmul_l(&kk, lkk, &r2, lr2, &uu, luu, f64_neg(F64_ONE), lost);
    if (lnn < 0 || lmn < 0 || lkk < 0 || lwu < 0 || lbb < 0) { return 0; }
    lnn = _geo_xcompress(&nn, lnn);
    lmn = _geo_xcompress(&mn, lmn);
    lkk = _geo_xcompress(&kk, lkk);
    lwu = _geo_xcompress(&wu, lwu);
    lbb = _geo_xcompress(&bb, lbb);
    if (_geo_xsign(&nn, lnn) <= 0) { return 0; }   # (parallel to the axis: not the barrel's)
    var sb = _geo_xsign(&bb, lbb);
    # A = -(w . u): the start plane.
    var ax: i64[96];
    for (var i2 = 0; i2 < lwu; i2 = i2 + 1) { store64(&ax + i2 * 8, f64_neg(load64(&wu + i2 * 8))); }
    var lax = lwu;
    var ce = ((sw >> 52) - 1023) - ((su >> 52) - 1023);   # log2 c
    var ae: i64[96];
    var lae = 0 - 1;
    if (ce <= 60) {
        # A = c |u|^2 - w . u: the end plane.
        lae = 0;
        for (var i3 = 0; i3 < luu; i3 = i3 + 1) {
            var uw = load64(&uu + i3 * 8);
            var cw = _geo_ldexp(uw, ce);
            if ((cw & 0x7FFF_FFFF_FFFF_FFFF) < 0x0010_0000_0000_0000) {
                store64(lost, load64(lost) + 1);
                store64(lost + 8, f64_add(load64(lost + 8), F64_ONE));
            }
            lae = _geo_xgrow(&ae, lae, cw);
        }
        for (var i4 = 0; i4 < lax; i4 = i4 + 1) {
            if (lae > 92) { lae = _geo_xcompress(&ae, lae); }
            if (lae > 92) { return 0; }
            lae = _geo_xgrow(&ae, lae, load64(&ax + i4 * 8));
        }
        lae = _geo_xcompress(&ae, lae);
    }
    if (sb == 0) {
        # The ray runs parallel to the end planes: every point is at the axial place w . u.
        var sp = 0;
        if (_geo_xsign(&wu, lwu) < 0) { sp = 0 - 1; }
        elif (lae < 0) { sp = 3; }
        elif (_geo_xsign(&ae, lae) < 0) { sp = 2; }
        store64(out2, sp);
        store64(out2 + 8, sp);
        return 0;
    }
    store64(&q, &nn);
    store64(&q + 8, lnn);
    store64(&q + 16, &mn);
    store64(&q + 24, lmn);
    store64(&q + 32, &kk);
    store64(&q + 40, lkk);
    store64(&q + 48, &bb);
    store64(&q + 56, lbb);
    store64(&q + 64, lost);
    store64(&q + 72, sb);
    # Each root on or past the start plane: (w + tau d) . u >= 0, tau on tau_s's side that B points
    # to; then on or before the end plane. (Both roots at once: the planes' signs are shared.)
    var vs: i64[2];
    var ve: i64[2];
    if (_geo_seam_cmp(&q, &ax, lax, &vs) == 3) { return 0; }
    var ves = 3;
    if (lae >= 0) { ves = _geo_seam_cmp(&q, &ae, lae, &ve); }
    for (var ri = 0; ri < 2; ri = ri + 1) {
        var an = 0;
        if (load64(&vs + ri * 8) * sb < 0) { an = 0 - 1; }
        elif (ves == 3) { an = 3; }
        elif (load64(&ve + ri * 8) * sb > 0) { an = 2; }
        store64(out2 + ri * 8, an);
    }
    return 0;
}

# For _geo_barrel_seam_x: the exact roots against tau_p = A / B (A at a, la words; N, M, K, B, B's
# sign and the rounding count at q), each -1, 0 or 1 as the root is below, at or above it, into out2
# (near, far); returns 3 when not decided, else 0. A rounding counted at q's lost moves N A^2 + 2 M A B + K B^2 by under
# 2^(lb - 1048 + 2 eA + 2 eB + eK) and A N + M B by under 2^(lb - 1048 + eA + eB + eK), each e the
# exponent (0 or more) of the largest of its kind (every word of N, M, K, B is under 2^8 at unit
# size, and each rounding is 2^-1072 or less): a sign within that is not taken.
fn _geo_seam_cmp(q, a, la, out2) {
    var nn = load64(q);
    var lnn = load64(q + 8);
    var mn = load64(q + 16);
    var lmn = load64(q + 24);
    var kk = load64(q + 32);
    var lkk = load64(q + 40);
    var bb = load64(q + 48);
    var lbb = load64(q + 56);
    var lost = load64(q + 64);
    var sb = load64(q + 72);
    var a2: i64[96];
    var ab: i64[96];
    var b2: i64[96];
    var la2 = _geo_xmul_l(&a2, 0, a, la, a, la, F64_ONE, lost);
    var lab = _geo_xmul_l(&ab, 0, a, la, bb, lbb, F64_TWO, lost);
    var lb2 = _geo_xmul_l(&b2, 0, bb, lbb, bb, lbb, F64_ONE, lost);
    if (la2 < 0 || lab < 0 || lb2 < 0) { return 3; }
    la2 = _geo_xcompress(&a2, la2);
    lab = _geo_xcompress(&ab, lab);
    lb2 = _geo_xcompress(&b2, lb2);
    var f: i64[96];
    var lf = _geo_xmul_l(&f, 0, nn, lnn, &a2, la2, F64_ONE, lost);
    lf = _geo_xmul_l(&f, lf, mn, lmn, &ab, lab, F64_ONE, lost);
    lf = _geo_xmul_l(&f, lf, kk, lkk, &b2, lb2, F64_ONE, lost);
    var g: i64[96];
    var lg = _geo_xmul_l(&g, 0, a, la, nn, lnn, F64_ONE, lost);
    lg = _geo_xmul_l(&g, lg, mn, lmn, bb, lbb, F64_ONE, lost);
    if (lf < 0 || lg < 0) { return 3; }
    lf = _geo_xcompress(&f, lf);
    lg = _geo_xcompress(&g, lg);
    var lb = _geo_xbits(load64(lost));
    if (lb > 0) {
        var ea = _geo_xexp0(_geo_xval(a, la));
        var eb = _geo_xexp0(_geo_xval(bb, lbb));
        var ek = f64_add(f64_abs(_geo_xval(nn, lnn)), f64_abs(_geo_xval(mn, lmn)));
        ek = _geo_xexp0(f64_add(ek, f64_abs(_geo_xval(kk, lkk))));
        if (_geo_xabove(_geo_xval(&f, lf), lb - 1048 + 2 * ea + 2 * eb + ek) == 0) { return 3; }
        if (_geo_xabove(_geo_xval(&g, lg), lb - 1048 + ea + eb + ek) == 0) { return 3; }
    }
    var sf = _geo_xsign(&f, lf);
    var sv = _geo_xsign(&g, lg) * sb;   # the sign of tau_p less the vertex
    var c0 = 0;
    var c1 = 0;
    if (sf < 0) {
        c0 = 0 - 1;   # tau_p between the roots
        c1 = 1;
    } elif (sf > 0) {
        if (sv == 0) { return 3; }
        c0 = 0 - sv;   # tau_p below both roots (sv < 0): each root is above it
        c1 = 0 - sv;
    } elif (sv < 0) {   # tau_p is the near root
        c1 = 1;
    } elif (sv > 0) {   # tau_p is the far root
        c0 = 0 - 1;
    }
    store64(out2, c0);   # (a double root at tau_p: both 0)
    store64(out2 + 8, c1);
    return 0;
}

# The exponent of |x| when it is 1 or more (finite), else 0.
fn _geo_xexp0(x) {
    var e = ((x & 0x7FFF_FFFF_FFFF_FFFF) >> 52) - 1023;
    if (e < 0) { return 0; }
    return e;
}

# _geo_barrel_far on the plain differences w = o - start and u = end - start (their roundings, 2^-53
# of each, are inside its 2^-46 bounds) and d, each taken to unit size: run before any expansion is
# formed, so that a ray far from a thin capsule costs a few products (3.4.0 review S1: after the
# expansions' set-up it was 676 ns against base's 474 for the review's far miss). 0 when an input
# is not finite or a vector is zero (the exact solve then decides).
# [measured: REV-RT-py tM2.py, in-process loops, base vs this tree, 2026-10-31]
fn _geo_barrel_far0(ray, capsule) {
    var o = GeoRay_origin(ray);
    var d = GeoRay_direction(ray);
    var st = GeoCapsule_start(capsule);
    var en = GeoCapsule_end(capsule);
    var wq: i64[6];
    var uq: i64[6];
    var dq: i64[3];
    for (var i = 0; i < 3; i = i + 1) {
        var si = load64(st + i * 8);
        store64(&wq + i * 16 + 8, f64_sub(load64(o + i * 8), si));
        store64(&uq + i * 16 + 8, f64_sub(load64(en + i * 8), si));
        store64(&dq + i * 8, load64(d + i * 8));
    }
    var mw = load64(&wq + 8) & 0x7FFF_FFFF_FFFF_FFFF;
    var mw1 = load64(&wq + 24) & 0x7FFF_FFFF_FFFF_FFFF;
    var mw2 = load64(&wq + 40) & 0x7FFF_FFFF_FFFF_FFFF;
    if (mw1 > mw) { mw = mw1; }
    if (mw2 > mw) { mw = mw2; }
    var mu = load64(&uq + 8) & 0x7FFF_FFFF_FFFF_FFFF;
    var mu1 = load64(&uq + 24) & 0x7FFF_FFFF_FFFF_FFFF;
    var mu2 = load64(&uq + 40) & 0x7FFF_FFFF_FFFF_FFFF;
    if (mu1 > mu) { mu = mu1; }
    if (mu2 > mu) { mu = mu2; }
    var md = _geo_absmax_bits(d);
    var r = GeoCapsule_radius(capsule);
    if (mw == 0 || mu == 0 || md == 0 || mw >= 0x7FF0_0000_0000_0000 || mu >= 0x7FF0_0000_0000_0000) { return 0; }
    if (md >= 0x7FF0_0000_0000_0000 || f64_gt(r, 0) == 0 || f64_lt(r, _GEO_F64_POS_INF) == 0) { return 0; }
    var sw = _geo_scale_for(mw >> 52);
    var su = _geo_scale_for(mu >> 52);
    var sd = _geo_scale_for(md >> 52);
    for (var c = 0; c < 3; c = c + 1) {
        store64(&wq + c * 16 + 8, f64_mul(load64(&wq + c * 16 + 8), sw));
        store64(&uq + c * 16 + 8, f64_mul(load64(&uq + c * 16 + 8), su));
        store64(&dq + c * 8, f64_mul(load64(&dq + c * 8), sd));
    }
    return _geo_barrel_far(&wq, &uq, &dq, f64_mul(r, sw));
}

# 1 when the ray's line provably passes the axis line farther than rs (3.4.0, _geo_barrel_xact's
# filter): det = w . (u x d) and n = u x d in plain doubles from the scaled inputs' leading words
# (all components 4 or less), each with a bound on its rounding and on the dropped low words, 2^-46
# of the magnitudes it is formed from; the line distance |det| / |n| then exceeds rs by more than
# those bounds can reach. 0 otherwise, or when anything is not decided (the exact solve follows).
fn _geo_barrel_far(wx, ux, dx, rs) {
    var w0 = load64(wx + 8);
    var w1 = load64(wx + 24);
    var w2 = load64(wx + 40);
    var u0 = load64(ux + 8);
    var u1 = load64(ux + 24);
    var u2 = load64(ux + 40);
    var d0 = load64(dx);
    var d1 = load64(dx + 8);
    var d2 = load64(dx + 16);
    var n0 = f64_sub(f64_mul(u1, d2), f64_mul(u2, d1));
    var n1 = f64_sub(f64_mul(u2, d0), f64_mul(u0, d2));
    var n2 = f64_sub(f64_mul(u0, d1), f64_mul(u1, d0));
    var det = f64_add(f64_add(f64_mul(w0, n0), f64_mul(w1, n1)), f64_mul(w2, n2));
    var wm = f64_add(f64_add(f64_abs(w0), f64_abs(w1)), f64_abs(w2));
    var um = f64_add(f64_add(f64_abs(u0), f64_abs(u1)), f64_abs(u2));
    var dm = f64_add(f64_add(f64_abs(d0), f64_abs(d1)), f64_abs(d2));
    var en = f64_mul(f64_mul(um, dm), 0x3D10_0000_0000_0000);   # 2^-46
    var edet = f64_mul(f64_mul(wm, f64_mul(um, dm)), 0x3D10_0000_0000_0000);
    var lo = f64_sub(f64_abs(det), edet);
    if (f64_gt(lo, 0) == 0) { return 0; }
    var nq = f64_add(f64_add(f64_mul(n0, n0), f64_mul(n1, n1)), f64_mul(n2, n2));
    var nh = f64_add(f64_sqrt(nq), f64_mul(en, F64_TWO));
    # (|det| - edet) > rs (|n| + 2 en), with 2^-46 to spare for this comparison's own roundings
    if (f64_gt(lo, f64_mul(f64_mul(rs, nh), 0x3FF0_0000_0000_0040)) == 1) { return 1; }
    return 0;
}

# 1 when the ray's and the sphere's ten inputs are finite (_geo_hvec3_nonfinite).
fn _geo_sphere_finite(ray, sphere) {
    if (_geo_hvec3_nonfinite(GeoRay_origin(ray)) == 1) { return 0; }
    if (_geo_hvec3_nonfinite(GeoRay_direction(ray)) == 1) { return 0; }
    if (_geo_hvec3_nonfinite(GeoSphere_center(sphere)) == 1) { return 0; }
    if (f64_lt(f64_abs(GeoSphere_radius(sphere)), _GEO_F64_POS_INF) == 0) { return 0; }
    return 1;
}

# 1 when a barrel's hb, a, c and discriminant dv (the copy's, formed with o_perp's and d_perp's lows) hold against
# the lows' own error (3.4.1 GEO6): _geo_perp_dd forms each to about 2^-103 of |o - start| and |d| (2^-100 here,
# largest components), which neither _geo_disc_dd's bound nor the expansions, exact in what they are given, can
# see. Near tangency with the origin near the closest approach, or on the surface, far along a long axis, dv and c
# are smaller than that moves them: t was 4.4e4 ulp off, 2^20 radii along. 1 when dv keeps its sign (four times)
# and, for a hit, q and c move by under 2^-54 of themselves.
fn _geo_lows_hold(bx, hb, a, c, dv, ococ) {
    var eo = f64_mul(_geo_ldexp(_geo_absmax_bits(load64(bx + 16)), load64(bx + 56)), 0x39B0_0000_0000_0000);   # 2^-100
    var dm = _geo_absmax_bits(GeoRay_direction(load64(bx)));
    var ed = f64_mul(_geo_ldexp(dm, load64(bx + 64)), 0x39B0_0000_0000_0000);
    var no = f64_sqrt(ococ);
    var nd = f64_sqrt(a);
    var ec = f64_mul(F64_TWO, f64_mul(no, eo));
    var eh = f64_add(f64_mul(no, ed), f64_mul(nd, eo));
    var er = f64_mul(F64_TWO, f64_mul(f64_abs(hb), eh));
    er = f64_add(er, f64_add(f64_mul(a, ec), f64_mul(F64_TWO, f64_mul(f64_abs(c), f64_mul(nd, ed)))));
    if (f64_lt(f64_mul(er, _GEO_F64_FOUR), f64_abs(dv)) == 0) { return 0; }
    if (f64_lt(dv, 0) == 1) { return 1; }
    if (f64_eq(c, 0) == 0) {
        if (f64_le(f64_mul(ec, 0x4350_0000_0000_0000), f64_abs(c)) == 0) { return 0; }   # 2^54
    }
    var sq = f64_sqrt(dv);
    if (f64_le(f64_mul(er, 0x4350_0000_0000_0000), f64_mul(sq, f64_add(f64_abs(hb), sq))) == 0) { return 0; }
    return 1;
}

# Both roots of |ocs + t dsc|^2 = rs^2 for a copy at unit size (3.3.6): ocs and rs with
# their largest in [1, 2) or below, dsc with its largest component in [1, 2). The sphere's
# copy (_geo_sphere_roots_scaled) and the capsule barrel's (geo_ray_capsule_branch) are
# solved here, in the form _geo_sphere_roots uses, so nothing in it can overflow; 0 when
# there is no root or dsc is zero. 3.3.7: lo, when not 0, is ocs's rounding (the sphere's
# o - c, at the copy's scale), carried into c and the offset f where those are formed
# exactly; bx, when not 0, is the barrel's (_geo_cap_axis_offset), which forms its offset f
# from the inputs where the one formed here may be o_perp's and d_perp's rounding.
# ⛔ 3.3.7 — THE CLASSIC DISCRIMINANT WAS REFUSED BELOW 2^-968, AND ITS STAND-IN CANCELLED. For
# an origin just outside or inside a huge sphere moving along its surface, hb^2 - a c is a
# normal 2^-1013 at the copy's scale while r^2 - |f|^2 cancels to its rounding: the radius
# -DBL_MAX sphere at (-4.40, DBL_MAX, 3.28) from (1.01, -0.32, 4.67) along (-0.30, -0, 0.52),
# a miss 0.32 below its surface, read a hit at 2.45 once c carried o - c's rounding (3.3.6
# read the contact 0, by its rounding). A normal hb^2 - a c is formed from products whose
# underflow costs at most 2^-1074, an ulp of it, so it is used down to DBL_MIN.
# [measured: rt337 special-value sweep (nonfin.py, seed 1201), exact roots, 3.3.6 vs this tree, 2026-10-31]
fn _geo_sph_solve(ocs, dsc, rs, lo, bx, out) {
    var bxl = 0;   # 1 once lo is the barrel's (_geo_cap_perp_lo), and bdlo d_perp's rounding
    var bdlo[24];
    var a = hvec3_dot(dsc, dsc);
    if (f64_eq(a, 0) == 1) { return 0; }
    var hb = hvec3_dot(ocs, dsc);
    var rr = f64_mul(rs, rs);
    var ococ = hvec3_dot(ocs, ocs);
    var c = f64_sub(ococ, rr);
    if ((c & 0x7FFF_FFFF_FFFF_FFFF) < (ococ & 0x7FFF_FFFF_FFFF_FFFF) - 0x0020_0000_0000_0000) {
        # ⛔ 3.4.0 — THE BARREL'S o_perp CARRIES ITS ROUNDING HERE TOO. c = |o_perp|^2 - r^2 was formed
        # exactly from the rounded o_perp, whose rounding (about an ulp of each component, more from
        # o - start and end - start) is that of c for an origin near the barrel: 11.7 ulp for the
        # roadmap's origin 3% of r outside, and up to 7.3e5 ulp within 2^-45 of r. bx's offset of
        # the origin from the axis is formed as two doubles (_geo_cap_perp_lo) and its low part,
        # at the copy's scale, carried into c and hb as o - c's is for a sphere.
        # [measured: rt340 ray sweeps (sweep.py, fixtures.py), exact Fraction oracle, base vs this tree, 2026-10-31]
        var blo[24];
        var hlo = 0;
        var grz = f64_lt(f64_mul(hb, hb), f64_mul(f64_mul(ococ, a), 0x3FB0_0000_0000_0000));   # |cos| < 1/4
        if (lo == 0 && bx != 0) {
            # (d_perp's rounding too where hb cancels: a ray grazing the barrel there.)
            var wdl = 0;
            wdl = &bdlo;
            if (_geo_cap_perp_lo(bx, ocs, dsc, &blo, wdl) == 1) {
                lo = &blo;
                hlo = 2;
                bxl = 1;
                a = f64_add(a, f64_mul(F64_TWO, hvec3_dot(dsc, &bdlo)));
            }
        }
        c = _geo_sphere_c_exact(ocs, rs);
        if (lo != 0) { c = _geo_c_lo(c, ocs, lo); }
        # (3.4.0: within 2^-48 of |oc|^2 c is formed exactly, as in _geo_sphere_roots_full.)
        if (f64_lt(f64_abs(c), f64_mul(ococ, 0x3CF0_0000_0000_0000)) == 1) { c = _geo_c_xact(ocs, lo, rs); }   # 2^-48
        # (hb with the products exact and lo carried: always for the barrel, whose lo can be several
        # ulps; for a sphere where it cancels under |cos| 1/4, as in _geo_sphere_roots_full.)
        if (lo != 0) {
            if (hlo != 0 || grz == 1) {
                var hdl = 0;
                if (hlo == 2) { hdl = &bdlo; }
                hb = _geo_hb_lo(ocs, lo, hdl, HVec3_x(dsc), HVec3_y(dsc), HVec3_z(dsc));
            }
        }
    }
    var k = f64_div(hb, a);
    var fv[24];
    store64(&fv, f64_sub(HVec3_x(ocs), f64_mul(k, HVec3_x(dsc))));
    store64(&fv + 8, f64_sub(HVec3_y(ocs), f64_mul(k, HVec3_y(dsc))));
    store64(&fv + 16, f64_sub(HVec3_z(ocs), f64_mul(k, HVec3_z(dsc))));
    # (3.4.0, the second review's N5: with the barrel's lows carried into hb, a and c, the offset f is
    # formed with them too, f = (ocs + lo) - k (dsc + dlo); from the rounded o_perp and d_perp alone,
    # d_perp 210 ulps off in a component, r^2 - |f|^2 disagreed with c at 1e-14 and an ordinary
    # barrel root read 18.1 ulp, where 3.3.7, rounded everywhere alike, read 1.9.)
    # [measured: R2E N5 repros and random-scale sweep (x_sweep.py), exact Fractions, base vs this tree, 2026-10-31]
    if (bxl == 1) {
        for (var fi = 0; fi < 3; fi = fi + 1) {
            var fl = f64_sub(load64(lo + fi * 8), f64_mul(k, load64(&bdlo + fi * 8)));
            store64(&fv + fi * 8, f64_add(load64(&fv + fi * 8), fl));
        }
    }
    var ff = hvec3_dot(&fv, &fv);
    var pn = f64_lt(rr, f64_mul(ococ, 0x3DF0_0000_0000_0000));   # 2^-32
    if (pn == 1) { pn = f64_lt(ff, f64_mul(ococ, 0x3AF0_0000_0000_0000)); }   # 2^-80
    if (pn == 1) {
        var bxo = 0;
        if (bx != 0) { bxo = _geo_cap_axis_offset(bx, &fv); }
        if (bxo == 0) {
            _geo_perp_part(ocs, dsc, &fv);
            if (lo != 0) { _geo_add_perp(&fv, lo, dsc); }
        }
        ff = hvec3_dot(&fv, &fv);
    }
    var delta = f64_sub(rr, ff);
    var sq = 0;
    var dsel = 0;
    var cff = f64_lt(c, ff);
    var rtgx = 0;   # a barrel's r^2 - |f|^2 cancelled by two bits or more
    var ard = delta & 0x7FFF_FFFF_FFFF_FFFF;
    if (cff == 0 && bx != 0 && ard < (rr & 0x7FFF_FFFF_FFFF_FFFF) - 0x0020_0000_0000_0000) {
        # (only where o_perp's lows hold it: they are good to about 2^-104 of |o - start|, so not for
        # an o_perp under 2^-96 of that, where the offset f from the inputs is the better: an origin a
        # few units of 2^-1074 off a unit capsule's axis read the miss for the exact hit at 1e-323)
        # [measured: R2E tE3 family (gx 1070), exact Fractions, base, integ-snap12 and this tree, 2026-10-31]
        var ope = (_geo_absmax_bits(ocs) >> 52) - 1023 - load64(bx + 56);
        if (ope >= (_geo_absmax_bits(load64(bx + 16)) >> 52) - 1023 - 96) { rtgx = 1; }
    }
    if (cff == 1 || rtgx == 1) {
        var hh = f64_mul(hb, hb);
        var dc = f64_sub(hh, f64_mul(a, c));
        var dok = cff;   # 1 where hb^2 - a c is the discriminant to take
        # ⛔ 3.4.0 (review M4) — WHERE hb^2 AND a c CANCEL by two bits or more (a ray near tangency
        # from close by), each product's rounding is amplified hb^2 / dc times, and an hb or c made
        # more accurate by 3.4.0 only exposed it: 9 of 20,000 grazing rays at a sphere and 2 of
        # 120,000 capsule caps went right -> wrong. hb, a, c and hb^2 - a c are then formed as exact
        # expansions from ocs and dsc with their roundings (_geo_disc_x) and each rounded once.
        # For a barrel, o_perp's and d_perp's lows (_geo_cap_perp_lo) go in, and the same is done where
        # the offset form r^2 - |f|^2 has cancelled by two bits (rtgx): an exact hb^2 - a c is a (r^2 -
        # |f|^2) exactly. (The second review's N3: with an exact discriminant beside an offset f formed
        # without the lows, 14 grazing ordinary barrels of 20,000 went right -> wrong against
        # integ-snap6, one 1.57 -> 70.4 ulp; with f formed with them, above, and the offset form's
        # cancellation taken here too, that family's wrong answers fell from 933 to 697, none right ->
        # wrong, and the review's grazing N5 barrel from 12.2 ulp to 0.82, 3.3.7 2.2.) The second
        # review's S-a: the expansions cost 9 us on a thin barrel aimed near its axis (|o_perp| / r
        # 2^30 to 2^40, hb^2 / dc to 2^80), 10 to 27 times integ-snap6, so the offset form's case
        # takes _geo_disc_dd alone: where it certifies hb, a and c but not hb^2 - a c (2), the offset
        # form stands, its f formed from the inputs; only where it cannot hold hb, a or c (0: lows as
        # large as their words) do the expansions decide. (The classic form's case keeps _geo_disc_x,
        # whose double-double stage decides first.)
        # [measured: rt340 review families (REV-RT-py tP, tP2, tG, tG2) and sweep.py, exact Fractions, 2026-10-31]
        # [measured: R2E x_bgraze.py and N5 repros, exact Fractions, base and integ-snap6 vs this tree, 2026-10-31]
        # [measured: R2E x_time.py capsule set, in-process loops, integ-snap6 vs this tree, 2026-10-31]
        if (rtgx == 1 || (hh >= 0x0100_0000_0000_0000 && (dc & 0x7FFF_FFFF_FFFF_FFFF) < hh - 0x0020_0000_0000_0000)) {
            var dlo2 = 0;
            var blo2[24];
            var bdlo2[24];
            if (bxl == 1) { dlo2 = &bdlo; }
            if (lo == 0 && bx != 0) {
                if (_geo_cap_perp_lo(bx, ocs, dsc, &blo2, &bdlo2) == 1) {
                    lo = &blo2;
                    dlo2 = &bdlo2;
                }
            }
            var dx4[32];
            var dgot = 0;
            if (cff == 0) { dgot = _geo_disc_dd(ocs, lo, dsc, dlo2, rs, &dx4); }
            if (dgot == 2) { store64(bx + 72, 1); }   # (nothing here certifies this discriminant: the caller's)
            if (dgot == 0) {
                _geo_disc_x(ocs, lo, dsc, dlo2, rs, &dx4);
                dgot = 1;
            }
            if (dgot == 1) {
                hb = load64(&dx4);
                a = load64(&dx4 + 8);
                c = load64(&dx4 + 16);
                dc = load64(&dx4 + 24);
                dok = 1;
            }
        }
        if (dok == 1 && f64_lt(f64_abs(dc), _GEO_F64_TINY) == 0) {
            delta = dc;
            sq = f64_sqrt(dc);
            dsel = 1;
        }
    }
    if (dsel == 0) {
        sq = f64_sqrt(f64_mul(a, delta));
        if (f64_lt(f64_abs(delta), _GEO_DIR_LO) == 1) {
            var dq[16];
            _geo_delta_fine(&fv, rs, a, &dq);
            delta = load64(&dq);
            sq = load64(&dq + 8);
        }
    }
    # (3.4.0: the barrel's lo is good to about 2^-104 of |o - start| across the axis, and along it
    # keeps the second projection's rounding, so a c within 2^-90 of |o_perp|^2 of 0 is not sure of
    # its sign: an origin exactly on the barrel, c = 0, read c = |lo|^2 > 0 and its contact became the
    # miss, tests/modules_c.tcyr's d_perp-reads-0 pin. Its sign is then taken exactly (_geo_barrel_csign).)
    # [measured: tests/modules_c.tcyr on this tree without the exact sign, 2026-10-31; cyrius 6.7.9]
    if (bxl == 1 && f64_lt(f64_abs(c), f64_mul(ococ, 0x3A50_0000_0000_0000)) == 1) {   # 2^-90
        var csg = _geo_barrel_csign(load64(bx), load64(bx + 8));
        if (csg == 0) { c = 0; }
        elif (csg == 1 && f64_lt(c, 0) == 1) { c = f64_neg(c); }
        elif (csg == 0 - 1 && f64_gt(c, 0) == 1) { c = f64_neg(c); }
    }
    if (bx != 0 && lo != 0) {
        var dv = delta;
        if (dsel == 0) { dv = f64_mul(a, delta); }
        if (_geo_lows_hold(bx, hb, a, c, dv, ococ) == 0) { store64(bx + 72, 1); }
    }
    return _geo_quad_roots(hb, a, c, delta, sq, out);
}

# _geo_disc_x's quantities in double-double, each with a bound on its error, into out as there
# (3.4.0, second review S-a: the expansions cost 3 to 9 us a call, on grazing rays from close
# origins and on thin barrels, whose discriminants cancel by a few bits to 2^-60 or so). Returns 1
# when its doubles serve as the expansions' do: hb, a and c within an ulp of the exact values
# (their bounds 2^56 under |hb| + sqrt|dc|, which is what q is formed from, a and |c|), and
# hb^2 - a c sure of its sign (four times its bound) with its bound 2^56 under sqrt|dc| (|hb| +
# sqrt|dc|), which moves q = -(hb + sign(hb) sqrt) and both roots by 2^-57 of themselves at most.
# 0 when hb, a or c is not (lows as large as the words they belong to, or an origin on the
# surface), 2 when hb^2 - a c is not: the expansions then decide. |oc|, |d|, their lows and r below
# 2^995.
# [measured: rt4 tim/t.bcyr (S-a sphere repro) and R2E x_time.py capsule set, integ-snap12 vs this tree, 2026-10-31]
fn _geo_disc_dd(oc, lo, d, dlo, r, out) {
    var sp = 0x41A0_0000_0200_0000;   # 2^27 + 1
    # Per quantity: its leading products, each exact (Dekker's product, written out), summed with
    # the sums' errors carried (s, e), and a tail t of the products' low words.
    var hs = 0;
    var he = 0;
    var ht = 0;
    var as2 = 0;
    var ae = 0;
    var at = 0;
    var cs = 0;
    var ce = 0;
    var ct = 0;
    for (var i = 0; i < 3; i = i + 1) {
        var x = load64(oc + i * 8);
        var y = load64(d + i * 8);
        var u = f64_mul(x, sp);
        var xh = f64_sub(u, f64_sub(u, x));
        var xt = f64_sub(x, xh);
        u = f64_mul(y, sp);
        var yh = f64_sub(u, f64_sub(u, y));
        var yt = f64_sub(y, yh);
        var p = f64_mul(x, x);
        var w = f64_add(f64_add(f64_sub(f64_mul(xh, xh), p), f64_mul(F64_TWO, f64_mul(xh, xt))), f64_mul(xt, xt));
        var s = f64_add(cs, p);
        var v = f64_sub(s, cs);
        ce = f64_add(ce, f64_add(f64_sub(cs, f64_sub(s, v)), f64_sub(p, v)));
        cs = s;
        ct = f64_add(ct, w);
        p = f64_mul(x, y);
        w = f64_add(f64_add(f64_sub(f64_mul(xh, yh), p), f64_mul(xh, yt)), f64_mul(xt, yh));
        w = f64_add(w, f64_mul(xt, yt));
        s = f64_add(hs, p);
        v = f64_sub(s, hs);
        he = f64_add(he, f64_add(f64_sub(hs, f64_sub(s, v)), f64_sub(p, v)));
        hs = s;
        ht = f64_add(ht, w);
        p = f64_mul(y, y);
        w = f64_add(f64_add(f64_sub(f64_mul(yh, yh), p), f64_mul(F64_TWO, f64_mul(yh, yt))), f64_mul(yt, yt));
        s = f64_add(as2, p);
        v = f64_sub(s, as2);
        ae = f64_add(ae, f64_add(f64_sub(as2, f64_sub(s, v)), f64_sub(p, v)));
        as2 = s;
        at = f64_add(at, w);
    }
    var xx = cs;   # |oc|^2 and |d|^2 to an ulp, for the bounds
    var yy = as2;
    var u2 = f64_mul(r, sp);
    var rh = f64_sub(u2, f64_sub(u2, r));
    var rt = f64_sub(r, rh);
    var pr = f64_mul(r, r);
    var wr = f64_add(f64_add(f64_sub(f64_mul(rh, rh), pr), f64_mul(F64_TWO, f64_mul(rh, rt))), f64_mul(rt, rt));
    var s2 = f64_sub(cs, pr);
    var v2 = f64_sub(s2, cs);
    ce = f64_add(ce, f64_add(f64_sub(cs, f64_sub(s2, v2)), f64_sub(f64_neg(pr), v2)));
    cs = s2;
    ct = f64_sub(ct, wr);
    # The lows' terms, rounded (x yl + xl (y + yl) for hb, yl (2 y + yl) for a, xl (2 x + xl) for
    # c), and |lo|^2 and |dlo|^2 for their bounds.
    var ll = 0;
    var dl = 0;
    if (lo != 0 || dlo != 0) {
        for (var j = 0; j < 3; j = j + 1) {
            var x2 = load64(oc + j * 8);
            var y2 = load64(d + j * 8);
            var xl = 0;
            var yl = 0;
            if (lo != 0) { xl = load64(lo + j * 8); }
            if (dlo != 0) { yl = load64(dlo + j * 8); }
            ht = f64_add(ht, f64_add(f64_mul(x2, yl), f64_mul(xl, f64_add(y2, yl))));
            at = f64_add(at, f64_mul(yl, f64_add(f64_mul(F64_TWO, y2), yl)));
            ct = f64_add(ct, f64_mul(xl, f64_add(f64_mul(F64_TWO, x2), xl)));
            ll = f64_add(ll, f64_mul(xl, xl));
            dl = f64_add(dl, f64_mul(yl, yl));
        }
    }
    var h: i64[2];
    var aa: i64[2];
    var cc: i64[2];
    _geo_dd_fin(hs, f64_add(he, ht), &h);
    _geo_dd_fin(as2, f64_add(ae, at), &aa);
    _geo_dd_fin(cs, f64_add(ce, ct), &cc);
    # Each within 2^-99 of its leading products' magnitudes (sum |x_i y_i| at most |oc| |d|, by
    # Cauchy-Schwarz) and 2^-47 of its lows' terms' (bounded alike: sum |x_i| |yl_i| at most |oc|
    # |dlo|), and 2^-1040 for the roundings that fall below the normal range (each under 2^-1075,
    # and they are a few dozen): the carried errors' roundings are under 2^-100 of the first; the
    # tail's, and the rounded products', under 2^-48 of the second and 2^-102 of the first.
    var fl = 0x0000_0004_0000_0000;   # 2^-1040
    var nx = f64_sqrt(xx);
    var ny = f64_sqrt(yy);
    var nl = f64_sqrt(ll);
    var nd = f64_sqrt(dl);
    var eh = f64_mul(f64_mul(nx, ny), 0x39C0_0000_0000_0000);   # 2^-99
    eh = f64_add(eh, f64_mul(f64_add(f64_mul(nx, nd), f64_mul(nl, f64_add(ny, nd))), 0x3D00_0000_0000_0000));   # 2^-47
    var ea = f64_mul(f64_mul(nd, f64_add(f64_mul(F64_TWO, ny), nd)), 0x3D00_0000_0000_0000);
    var ec = f64_mul(f64_mul(nl, f64_add(f64_mul(F64_TWO, nx), nl)), 0x3D00_0000_0000_0000);
    eh = f64_add(eh, fl);
    ea = f64_add(f64_add(ea, f64_mul(yy, 0x39C0_0000_0000_0000)), fl);
    ec = f64_add(f64_add(ec, f64_mul(f64_add(xx, pr), 0x39C0_0000_0000_0000)), fl);
    var h1 = load64(&h);
    var a1 = load64(&aa);
    var c1 = load64(&cc);
    var h2 = load64(&h + 8);
    var a2 = load64(&aa + 8);
    var c2 = load64(&cc + 8);
    var pp[16];
    var pq[16];
    _geo_two_sq(h1, &pp);
    _geo_two_prod(a1, c1, &pq);
    var er[8];
    store64(&er, 0);
    var sm = _geo_two_sum(load64(&pp), f64_neg(load64(&pq)), &er);
    var x1 = f64_mul(F64_TWO, f64_mul(h1, h2));
    var y1 = f64_mul(a1, c2);
    var y3 = f64_mul(a2, c1);
    var z1 = f64_mul(h2, h2);
    var z2 = f64_mul(a2, c2);
    var tl = f64_add(f64_sub(f64_sub(load64(&pp + 8), load64(&pq + 8)), f64_add(y1, y3)), f64_add(x1, f64_sub(z1, z2)));
    var dc = f64_add(sm, f64_add(load64(&er), tl));
    # Its bound, twice the sum of: hb's, a's and c's errors through the products; 2^-99 of the two
    # leading products (the carried error's rounding); 2^-47 of the others; and 2^-1040.
    var es = f64_add(f64_add(f64_abs(x1), f64_add(f64_abs(y1), f64_abs(y3))), f64_add(z1, f64_abs(z2)));
    es = f64_add(es, f64_add(f64_abs(load64(&pp + 8)), f64_abs(load64(&pq + 8))));
    var eb = f64_mul(eh, f64_add(f64_mul(F64_TWO, f64_abs(h1)), eh));
    eb = f64_add(eb, f64_add(f64_mul(a1, ec), f64_add(f64_mul(f64_abs(c1), ea), f64_mul(ea, ec))));
    eb = f64_add(eb, f64_mul(f64_add(load64(&pp), f64_abs(load64(&pq))), 0x39C0_0000_0000_0000));   # 2^-99
    eb = f64_add(eb, f64_add(f64_mul(es, 0x3D00_0000_0000_0000), fl));   # 2^-47
    eb = f64_mul(F64_TWO, eb);
    var big = 0x4370_0000_0000_0000;   # 2^56
    var sq = f64_sqrt(f64_abs(dc));
    var hq = f64_add(f64_abs(h1), sq);
    # (Each test is false for a NaN, which goes to the expansions.)
    if (f64_le(f64_mul(eh, big), hq) == 0 || f64_le(f64_mul(ea, big), a1) == 0) { return 0; }
    if (f64_le(f64_mul(ec, big), f64_abs(c1)) == 0 || f64_lt(hq, _GEO_F64_POS_INF) == 0) { return 0; }
    # (2: the coefficients stand, hb^2 - a c cancels past what double-double can certify)
    if (f64_le(f64_mul(eb, 0x4010_0000_0000_0000), f64_abs(dc)) == 0) { return 2; }
    if (f64_le(f64_mul(eb, big), f64_mul(sq, hq)) == 0) { return 2; }
    store64(out, f64_add(h1, h2));
    store64(out + 8, f64_add(a1, a2));
    store64(out + 16, f64_add(c1, c2));
    store64(out + 24, dc);
    return 1;
}

# s + t as a double-double, into out: out[0] the rounded sum and out[1] its rounding, exactly
# (Knuth's two-sum; 3.4.0, _geo_disc_dd).
fn _geo_dd_fin(s, t, out) {
    var hi = f64_add(s, t);
    var bv = f64_sub(hi, s);
    store64(out, hi);
    store64(out + 8, f64_add(f64_sub(s, f64_sub(hi, bv)), f64_sub(t, bv)));
    return 0;
}

# hb = (oc + lo) . (d + dlo), a = |d + dlo|^2, c = |oc + lo|^2 - r^2 and hb^2 - a c, each an exact
# expansion rounded once, into out[0..3] (3.4.0, review M4): oc, d and r at unit size (_geo_sph_solve's
# copy), lo and dlo their roundings or 0. hb, a and c are at most 24 words by count (two grows a
# product, twelve products); hb^2 - a c goes through _geo_xmul's bounded, compressed accumulator,
# and if that ever reported its bound the plain products are kept (out[3] = hb^2 - a c rounded).
fn _geo_disc_x(oc, lo, d, dlo, r, out) {
    if (_geo_disc_dd(oc, lo, d, dlo, r, out) == 1) { return 1; }
    var hbx: i64[32];
    var ax: i64[32];
    var cx: i64[32];
    var nh = 0;
    var na = 0;
    var nc = 0;
    for (var i = 0; i < 3; i = i + 1) {
        var oi = load64(oc + i * 8);
        var di = load64(d + i * 8);
        var li = 0;
        var dli = 0;
        if (lo != 0) { li = load64(lo + i * 8); }
        if (dlo != 0) { dli = load64(dlo + i * 8); }
        nh = _geo_xprod(&hbx, nh, oi, di);
        nh = _geo_xprod(&hbx, nh, oi, dli);
        nh = _geo_xprod(&hbx, nh, li, di);
        nh = _geo_xprod(&hbx, nh, li, dli);
        na = _geo_xprod(&ax, na, di, di);
        na = _geo_xprod(&ax, na, f64_mul(di, F64_TWO), dli);
        na = _geo_xprod(&ax, na, dli, dli);
        nc = _geo_xprod(&cx, nc, oi, oi);
        nc = _geo_xprod(&cx, nc, f64_mul(oi, F64_TWO), li);
        nc = _geo_xprod(&cx, nc, li, li);
    }
    nc = _geo_xprod(&cx, nc, f64_neg(r), r);
    nh = _geo_xcompress(&hbx, nh);
    na = _geo_xcompress(&ax, na);
    nc = _geo_xcompress(&cx, nc);
    var hb = _geo_xval(&hbx, nh);
    var a = _geo_xval(&ax, na);
    var c = _geo_xval(&cx, nc);
    store64(out, hb);
    store64(out + 8, a);
    store64(out + 16, c);
    var dx: i64[96];
    var nd = _geo_xmul(&dx, 0, &hbx, nh, &hbx, nh, F64_ONE, 96);
    nd = _geo_xmul(&dx, nd, &ax, na, &cx, nc, f64_neg(F64_ONE), 96);
    if (nd < 0) {
        store64(out + 24, f64_sub(f64_mul(hb, hb), f64_mul(a, c)));
        return 0;
    }
    store64(out + 24, _geo_xval(&dx, _geo_xcompress(&dx, nd)));
    return 1;
}

# _geo_sph_solve for a barrel whose o_perp, r and d_perp have their largest components between
# 2^-100 and 2^100, written out without the copies at unit size (3.3.7): its operations in its
# order, and powers of two being exact, the bits of the scaled solve multiplied back. It runs only
# where that routine takes its plain branches, and hands back 2 (the caller then solves the scaled
# copy) where c cancelled, the offset may be its rounding, or the discriminant is under 2^-600
# (dc) or 2^-700 (r^2 - |f|^2): thresholds that, moved by at most 2^400 or 2^200 to the copy's
# scale, still clear its DBL_MIN and 2^-968. 1 with the two roots in out, sorted; 0 for no root.
# Handing back always (the scaled copy for every barrel) changes none of 101,000 rays: the
# review's five capsule families, the lane's thirteen and 20,000 special-value rays. It saves the
# copies' two scalings and multiplications back.
# [measured: rt2 mutant M47 (always hand back) vs this tree, rt2e/evalcap.py and rtp families, 2026-10-31]
fn _geo_barrel_fast(op, dp, rb, out) {
    var mp = _geo_absmax_bits(op);
    var mr = rb & 0x7FFF_FFFF_FFFF_FFFF;
    if (mr > mp) { mp = mr; }
    var md = _geo_absmax_bits(dp);
    if ((mp >> 52) < 923 || (mp >> 52) > 1123 || (md >> 52) < 923 || (md >> 52) > 1123) { return 2; }
    var ox = HVec3_x(op);
    var oy = HVec3_y(op);
    var oz = HVec3_z(op);
    var dx = HVec3_x(dp);
    var dy = HVec3_y(dp);
    var dz = HVec3_z(dp);
    var a = f64_add(f64_add(f64_mul(dx, dx), f64_mul(dy, dy)), f64_mul(dz, dz));
    var hb = f64_add(f64_add(f64_mul(ox, dx), f64_mul(oy, dy)), f64_mul(oz, dz));
    var rr = f64_mul(rb, rb);
    var ococ = f64_add(f64_add(f64_mul(ox, ox), f64_mul(oy, oy)), f64_mul(oz, oz));
    var c = f64_sub(ococ, rr);
    if ((c & 0x7FFF_FFFF_FFFF_FFFF) < (ococ & 0x7FFF_FFFF_FFFF_FFFF) - 0x0020_0000_0000_0000) { return 2; }
    var k = f64_div(hb, a);
    var fx = f64_sub(ox, f64_mul(k, dx));
    var fy = f64_sub(oy, f64_mul(k, dy));
    var fz = f64_sub(oz, f64_mul(k, dz));
    var ff = f64_add(f64_add(f64_mul(fx, fx), f64_mul(fy, fy)), f64_mul(fz, fz));
    if (f64_lt(rr, f64_mul(ococ, 0x3DF0_0000_0000_0000)) == 1) {   # 2^-32
        if (f64_lt(ff, f64_mul(ococ, 0x3AF0_0000_0000_0000)) == 1) { return 2; }   # 2^-80
    }
    var sq = 0;
    if (f64_lt(c, ff) == 1) {
        var hh = f64_mul(hb, hb);
        var dc = f64_sub(hh, f64_mul(a, c));
        if (f64_lt(f64_abs(dc), 0x1A70_0000_0000_0000) == 1) { return 2; }   # 2^-600
        # (3.4.0: hb^2 and a c cancelled by two bits, and below r^2 - |f|^2 likewise, go to
        # _geo_sph_solve, whose exact discriminant carries o_perp's and d_perp's lows; the second
        # review's N5 grazing barrel.)
        if ((dc & 0x7FFF_FFFF_FFFF_FFFF) < hh - 0x0020_0000_0000_0000) { return 2; }
        if (f64_lt(dc, 0) == 1) { return 0; }
        sq = f64_sqrt(dc);
    } else {
        var delta = f64_sub(rr, ff);
        if (f64_lt(f64_abs(delta), 0x1430_0000_0000_0000) == 1) { return 2; }   # 2^-700
        if ((delta & 0x7FFF_FFFF_FFFF_FFFF) < (rr & 0x7FFF_FFFF_FFFF_FFFF) - 0x0020_0000_0000_0000) { return 2; }
        if (f64_lt(delta, 0) == 1) { return 0; }
        sq = f64_sqrt(f64_mul(a, delta));
    }
    var q = f64_neg(f64_add(hb, sq));
    if (f64_lt(hb, 0) == 1) { q = f64_sub(sq, hb); }
    var t1 = f64_div(q, a);
    var t2 = f64_div(c, q);
    if (f64_gt(t1, t2) == 1) {
        var tt = t1;
        t1 = t2;
        t2 = tt;
    }
    store64(out, t1);
    store64(out + 8, t2);
    return 1;
}

# _geo_sphere_roots for finite input whose quadratic overflowed (3.3.6): the same
# quadratic for a copy at unit size. o - c and r are multiplied by the power of two
# that takes the larger of them into [1, 2) (o and c are halved first when o - c
# overflows), d by the one that takes its largest component there, and the roots are
# multiplied back by the ratio (_geo_ldexp). Powers of two are exact, so this is the
# unit-size answer scaled. A radius far below |o - c| flushes in the copy, and so does
# the offset f it is compared with; _geo_sph_solve compares the two at their own scale
# (_geo_delta_fine), where reading both as 0 had made a tangent hit of a ray missing a
# unit sphere at 2^600 by one radius.
fn _geo_sphere_roots_scaled(ray, sphere, out) {
    var o = GeoRay_origin(ray);
    var cen = GeoSphere_center(sphere);
    var d = GeoRay_direction(ray);
    var r = GeoSphere_radius(sphere);
    var oc[24];
    var h = 0;
    store64(&oc, f64_sub(HVec3_x(o), HVec3_x(cen)));
    store64(&oc + 8, f64_sub(HVec3_y(o), HVec3_y(cen)));
    store64(&oc + 16, f64_sub(HVec3_z(o), HVec3_z(cen)));
    var ohf = F64_ONE;
    if (_geo_hvec3_nonfinite(&oc) == 1) {
        store64(&oc, f64_sub(f64_mul(HVec3_x(o), F64_HALF), f64_mul(HVec3_x(cen), F64_HALF)));
        store64(&oc + 8, f64_sub(f64_mul(HVec3_y(o), F64_HALF), f64_mul(HVec3_y(cen), F64_HALF)));
        store64(&oc + 16, f64_sub(f64_mul(HVec3_z(o), F64_HALF), f64_mul(HVec3_z(cen), F64_HALF)));
        r = f64_mul(r, F64_HALF);
        h = 1;
        ohf = F64_HALF;
    }
    var mp = _geo_absmax_bits(&oc);
    var mr = r & 0x7FFF_FFFF_FFFF_FFFF;
    if (mr > mp) { mp = mr; }
    var sp = _geo_scale_for(mp >> 52);
    var sd = _geo_scale_for(_geo_absmax_bits(d) >> 52);
    var ocs[24];
    var dsc[24];
    store64(&ocs, f64_mul(load64(&oc), sp));
    store64(&ocs + 8, f64_mul(load64(&oc + 8), sp));
    store64(&ocs + 16, f64_mul(load64(&oc + 16), sp));
    store64(&dsc, f64_mul(HVec3_x(d), sd));
    store64(&dsc + 8, f64_mul(HVec3_y(d), sd));
    store64(&dsc + 16, f64_mul(HVec3_z(d), sd));
    var rs = f64_mul(r, sp);
    var los[24];   # o - c's rounding (3.3.7, see _geo_sphere_roots_full), at the copy's scale
    _geo_oc_lo(o, cen, ohf, &oc, &los);
    store64(&los, f64_mul(load64(&los), sp));
    store64(&los + 8, f64_mul(load64(&los + 8), sp));
    store64(&los + 16, f64_mul(load64(&los + 16), sp));
    if (_geo_sph_solve(&ocs, &dsc, rs, &los, 0, out) == 0) { return 0; }
    var e = (sd >> 52) - (sp >> 52) + h;
    store64(out, _geo_root_ldexp(load64(out), e));
    store64(out + 8, _geo_root_ldexp(load64(out + 8), e));
    return 1;
}

# Ray-sphere intersection (quadratic, half-b form for normalized direction)
# BOTH roots of the ray/sphere quadratic, 2.10.2. Writes t1 <= t2 into out (two
# i64 slots) and returns 1; returns 0 on a miss or a degenerate direction,
# leaving `out` untouched.
#
# Split out of geo_ray_sphere because `geo_ray_capsule` needs BOTH roots to
# decide a cap hit and the single-root entry point only ever gave it one -- so a
# cap root rejected by the hemisphere test meant the other root was never
# considered, and the routine either answered with a point inside the solid or
# dropped a real exit entirely. geo_ray_sphere is now the root SELECTION on top
# of this, so there is one copy of the quadratic and the two cannot drift.
# 3.3.6: this is the general routine, _geo_sphere_roots_full; _geo_sphere_roots below is
# its common case written out on its own and hands it every other ray.
# A sphere ray's roots from _geo_disc_dd's coefficients, formed from o - c with its rounding
# carried, d and r, each at unit size as _geo_sphere_roots_scaled takes them (3.4.0, the second
# review's S-a; unscaled, a sphere 2^-246 across left its bounds on the subnormal floor and took the
# scaled copy after all, 1.5 us): 1 with the roots in out, 0 for the miss, -1 where the
# double-double cannot certify them (the caller goes on). Finite input, o - c finite.
# [measured: R2E x_time.py sphere set, in-process loops, integ-snap6 vs this tree, 2026-10-31]
fn _geo_sphere_dd(ray, sphere, out) {
    var o = GeoRay_origin(ray);
    var cen = GeoSphere_center(sphere);
    var d = GeoRay_direction(ray);
    var r = GeoSphere_radius(sphere);
    var oc[24];
    store64(&oc, f64_sub(HVec3_x(o), HVec3_x(cen)));
    store64(&oc + 8, f64_sub(HVec3_y(o), HVec3_y(cen)));
    store64(&oc + 16, f64_sub(HVec3_z(o), HVec3_z(cen)));
    var lo[24];
    _geo_oc_lo(o, cen, F64_ONE, &oc, &lo);
    var mp = _geo_absmax_bits(&oc);
    if ((r & 0x7FFF_FFFF_FFFF_FFFF) > mp) { mp = r & 0x7FFF_FFFF_FFFF_FFFF; }
    var sp = _geo_scale_for(mp >> 52);
    var sd = _geo_scale_for(_geo_absmax_bits(d) >> 52);
    var ds[24];
    for (var i = 0; i < 3; i = i + 1) {
        store64(&oc + i * 8, f64_mul(load64(&oc + i * 8), sp));
        store64(&lo + i * 8, f64_mul(load64(&lo + i * 8), sp));
        store64(&ds + i * 8, f64_mul(load64(d + i * 8), sd));
    }
    var dx4[32];
    if (_geo_disc_dd(&oc, &lo, &ds, 0, f64_mul(r, sp), &dx4) != 1) { return 0 - 1; }
    var dc = load64(&dx4 + 24);
    if (_geo_quad_roots(load64(&dx4), load64(&dx4 + 8), load64(&dx4 + 16), dc, f64_sqrt(dc), out) == 0) { return 0; }
    var e = (sd >> 52) - (sp >> 52);
    store64(out, _geo_root_ldexp(load64(out), e));
    store64(out + 8, _geo_root_ldexp(load64(out + 8), e));
    return 1;
}

# sqrt(a delta) for a delta > 0 whose product with a falls under DBL_MIN, where it keeps a few bits or none: the
# product taken at 2^1500 and the root back by 2^750, exactly, so the bits of the same quadratic at any direction's
# scale. a is 2^-968 or more, delta 2^-1074 or more, their product under 2^-968: so a is under 2^106, and neither
# factor nor the product leaves the normal range.
fn _geo_sqrt_tiny(a, delta) {
    var p = f64_mul(f64_mul(a, 0x5F30_0000_0000_0000), f64_mul(delta, 0x7E70_0000_0000_0000));   # 2^500, 2^1000
    return f64_mul(f64_sqrt(p), 0x1110_0000_0000_0000);   # 2^-750
}

# 1 when the RTG root of a ray whose offset f was formed in plain arithmetic (f = oc - (hb / a) d,
# _geo_sphere_roots) is certified (3.4.1 GEO4), u = 2^-53. Each f_i is off by e_i with |e_i| <= u
# (|oc_i| + |k d_i| + |f_i|) (o - c, the product, the difference) and by k's rounding along d, at most
# 7 u |oc|: that part is orthogonal to f, so |f|^2 is off by 2 |f . e| <= u (4 |f| |oc| + 2 |f|^2),
# the squares and their sum 3 u |f|^2, and second order at most 100 u^2 |oc|^2, and r^2 - |f|^2 = delta
# by that plus u (r^2 + |delta|). The roots q / a and c / q move by (sq / |q|) err(delta) / (2 delta)
# of themselves, |q| = |hb| + sq. Certified when that is 6 u or less, i.e. sq (4.25 sqrt(|f|^2 |oc|^2)
# + 5 |f|^2 + r^2 + |delta| + 2^-46 |oc|^2) <= 12 delta |q| (the 0.25 for the rounding of the bound
# itself). With s = sq / |q| and k^2 = |f|^2 / delta that is at most 2.125 (s k^2 + (1 - s) k) +
# s (3 k^2 + 1) u, under 6 u from delta = 1.0625 |f|^2 up, so the callers ask below that alone.
# A negative delta (the miss) is certified when err(delta) is under |delta|.
# ⛔ The near-tangent class this closes: rays within 2^-5 .. 2^-50 of tangency had their t off by
# 31 to 3e4 ulp, at every distance (1.5 to 20 radii: 1,124 and 1,156 of 3,000 such rays wrong, two
# seeds; 2^30 radii: 1,306 and 1,317, a quarter of them the wrong verdict), in 3.3.7, 3.4.0 and every
# 3.4.1 tree before.
# [measured: GEO4 3.4.1 stan / stan30 families (fam.py), Fraction oracle, 3.3.7 / 3.4.0 / s14 / this tree, 2026-11-01]
fn _geo_sph_graze(hb, sq, delta, ff, ococ, rr) {
    # (|f|^2 |oc|^2 flushes for a sphere of radius 2^-474 met from 2^-455 away, and with it this bound's main term.
    # _geo_sph_comp's 2^-101 of it needs no such care: it is under its own 2^-99 |oc|^2 wherever that happens.
    # It overflows once r |oc| passes 2^512, with |f| |oc| in range: the roots taken apart there too.)
    var e = f64_mul(ff, ococ);
    if (e < 0x0370_0000_0000_0000 || e == 0x7FF0_0000_0000_0000) {   # 2^-968, +Inf
        e = f64_mul(f64_sqrt(ff), f64_sqrt(ococ));
    } else { e = f64_sqrt(e); }
    e = f64_mul(e, 0x4011_0000_0000_0000);   # 4.25
    e = f64_add(e, f64_mul(ff, 0x4014_0000_0000_0000));   # 5
    e = f64_add(e, f64_add(f64_add(rr, f64_abs(delta)), f64_mul(ococ, 0x3D10_0000_0000_0000)));   # 2^-46
    if (f64_gt(delta, 0) == 0) {
        if (f64_lt(f64_mul(e, 0x3CB0_0000_0000_0000), f64_abs(delta)) == 1) { return 1; }   # 2^-52
        return 0;
    }
    var q = f64_add(f64_abs(hb), sq);
    var rhs = f64_mul(f64_mul(delta, q), 0x4028_0000_0000_0000);   # 12
    # (Under 2^-968 both sides can flush, and 0 <= 0 certified an exact miss on a sphere of radius 2^-400: by
    # the quotient, which stays in range.)
    if (rhs < 0x0370_0000_0000_0000) {
        if (f64_le(f64_mul(sq, f64_div(e, delta)), f64_mul(q, 0x4028_0000_0000_0000)) == 1) { return 1; }
        return 0;
    }
    # ⛔ 3.4.1 (GEO7) — PAST DBL_MAX BOTH SIDES OVERFLOWED, AND Inf <= Inf CERTIFIED. rhs reads +Inf once 12 delta q
    # passes DBL_MAX, sq e with it, and nothing was tested: an exact miss on a sphere of radius 5e120 read a hit, and
    # from r near 2^360 about 6% of the rays built within 4 ulps of tangency did. The same test on sq / q, 1 at most,
    # each side over 16: the right side is finite, so only an e that is itself +Inf, the true bound past DBL_MAX,
    # refuses for want of range. (q is finite unless sq is: sq is under 2^512 and hb finite wherever big_d is finite.
    # A +Inf sq, which _geo_sphere_roots_full can bring when it forms big_d again, reads NaN here and fails.) Against
    # the exact inequality on 40,000 arguments: 0 false certificates, 28 true ones refused, each with the bound past
    # DBL_MAX (s24 16,059 false; "refuse when sq e is +Inf" 0 false, but 2,354 true ones refused).
    # [measured: GEO7 3.4.1 gz.py arguments, gs3.py scale map, exact Fraction oracle, s24 / this tree, 2026-11-01]
    if (rhs == 0x7FF0_0000_0000_0000) {
        var hs = f64_mul(f64_div(sq, q), f64_mul(e, 0x3FB0_0000_0000_0000));   # 1/16
        if (f64_le(hs, f64_mul(delta, 0x3FE8_0000_0000_0000)) == 1) { return 1; }   # 3/4
        return 0;
    }
    if (f64_le(f64_mul(sq, e), rhs) == 1) { return 1; }
    return 0;
}

# The roots of a grazing ray from the offset formed with o - c's rounding and (hb / a) d's products
# carried, and r^2 - |f|^2 in double-double (3.4.1 GEO4, the first step after _geo_sph_graze), u = 2^-53.
# f_i = hi + fl with hi = RN(oc_i - p_i) and fl its error plus o - c's rounding less pl_i (p + pl = k d_i
# exactly, k = hb / a), and delta = r^2 - |f|^2 summed from the exact squares of r and hi_i (Dekker) and
# 2 hi_i fl_i with their errors carried. Against the true r^2 - |F|^2, F the line's offset (GEO6, re-derived):
#   the sums' roundings and fl's own: under 2 u^2 r^2 + 37 u^2 |f|^2 + 36 u^2 |f| |oc|, all of it inside the
#     two bound terms below once 2^-99's spare 64 u^2 |oc|^2 takes the 4 past 2^-101;
#   fl_i^2, which the sum drops: |fl_i| <= u (|oc_i| + |p_i| + |hi_i|), so delta reads high by up to 5.83 u^2 |oc|^2
#     (and f small, 4 u^2 |oc|^2: f is NOT good to 2^-104 |oc| through its square);
#   k's rounding, which moves f along d, across F, so to second order only, but in full: hb's 4 u |oc| |d| and
#     k's own 4 u |k| make |dk| |d| <= 8 u |oc|, and delta reads low by up to 64 u^2 |oc|^2.
# The last two have opposite signs, so the bound must cover the larger either way: 64 u^2 = 2^-100, taken
# twice over, 2^-99 |oc|^2, as _geo_sph_graze's 2^-46 u is. (GEO4's 2^-105, 2 u^2, was a wrong constant under a
# comment reading 27 u^2: 458-495 of 6,000 rays within 2 ulps of tangency had the wrong verdict, in both
# directions, from r = 2^-27 |oc| on.) The roots (from hb, a, c as the caller formed them, at its direction
# d = (dx, dy, dz), possibly scaled) stand where that moves them by 3 u or less; 1 with them in out, -1 for
# a certified miss, 0 when neither (or a magnitude outside 2^-900 .. 2^900).
# [measured: R2-GEO tg1.py family, seeds 1-3, exact Fraction oracle and Decimal, s19 / GEO6, 2026-11-01]
fn _geo_sph_comp(o, cen, dx, dy, dz, r, hb, a, c, out) {
    var k = f64_div(hb, a);
    var d: i64[3];
    store64(&d, dx);
    store64(&d + 8, dy);
    store64(&d + 16, dz);
    var sh = 0;   # the squares' running sum and its carried error
    var se = 0;
    var ococ = 0;
    var mx = r & 0x7FFF_FFFF_FFFF_FFFF;
    var pp: i64[2];
    var qq: i64[2];
    for (var i = 0; i < 3; i = i + 1) {
        var oi = load64(o + i * 8);
        var ci = load64(cen + i * 8);
        var x = f64_sub(oi, ci);
        var lo = _geo_diff_err(oi, ci, x);
        _geo_two_prod(k, load64(&d + i * 8), &pp);
        var hi = f64_sub(x, load64(&pp));
        var fl = f64_add(_geo_diff_err(x, load64(&pp), hi), f64_sub(lo, load64(&pp + 8)));
        if ((hi & 0x7FFF_FFFF_FFFF_FFFF) > mx) { mx = hi & 0x7FFF_FFFF_FFFF_FFFF; }
        _geo_two_sq(hi, &qq);
        var s = f64_add(sh, load64(&qq));
        var tl = f64_add(load64(&qq + 8), f64_mul(f64_mul(F64_TWO, hi), fl));
        se = f64_add(se, f64_add(_geo_diff_err(sh, f64_neg(load64(&qq)), s), tl));
        sh = s;
        ococ = f64_add(ococ, f64_mul(x, x));
    }
    # (Past 2^900 or under 2^-900 no bound below means anything. Nearer, a square past 2^1024 is +Inf and delta
    # NaN, which fails every test; a square that flushes loses under 2^-1074, and the callers ask only where r^2
    # or |f|^2 is 2^-968 or more, so ed, at least 2^-1068, holds it.)
    if ((mx >> 52) > 1923 || (mx >> 52) < 123) { return 0; }
    _geo_two_sq(r, &qq);
    var dh = f64_sub(load64(&qq), sh);
    var delta = f64_add(dh, f64_add(_geo_diff_err(load64(&qq), sh, dh), f64_sub(load64(&qq + 8), se)));
    var rr = load64(&qq);
    var ff = sh;
    var ed = f64_mul(f64_add(rr, ff), 0x39B0_0000_0000_0000);   # 2^-100
    ed = f64_add(ed, f64_mul(f64_sqrt(f64_mul(ff, ococ)), 0x39A0_0000_0000_0000));   # 2^-101
    ed = f64_add(ed, f64_mul(ococ, 0x39C0_0000_0000_0000));   # 2^-99
    ed = f64_add(ed, f64_mul(f64_abs(delta), 0x3CA0_0000_0000_0000));   # 2^-53
    if (f64_gt(delta, 0) == 0) {
        if (f64_lt(ed, f64_abs(delta)) == 1) { return 0 - 1; }
        return 0;
    }
    var sq = f64_mul(a, delta);
    if (sq < 0x0370_0000_0000_0000) { sq = _geo_sqrt_tiny(a, delta); }   # 2^-968
    else { sq = f64_sqrt(sq); }
    var q = f64_add(f64_abs(hb), sq);
    # (3.4.1 GEO7: a delta past DBL_MAX where the caller's was not, delta being better here. sq and q then read +Inf,
    # so the test below is Inf <= Inf: a hit on a sphere met along |d| near 2^483 read as the miss. _geo_sphere_acc
    # answers on its unit-size copy.)
    if (q == 0x7FF0_0000_0000_0000) { return 0; }
    # ((sq / q) ed / (2 delta) <= 3 u, by the quotient: at a tiny sphere's scale the products flush)
    if (f64_le(f64_mul(sq, f64_div(ed, delta)), f64_mul(q, 0x3CC8_0000_0000_0000)) == 0) { return 0; }   # 6 2^-53
    return _geo_quad_roots(hb, a, c, delta, sq, out);
}

# The roots of a grazing ray the plain offset cannot certify (3.4.1 GEO4, _geo_sph_graze): from the
# double-double coefficients where their bounds certify them, else exactly.
fn _geo_sphere_acc(ray, sphere, out) {
    var g = _geo_sphere_dd(ray, sphere, out);
    if (g >= 0) { return g; }
    return _geo_sph_xroots(ray, sphere, out);
}

# _geo_sphere_roots_full's own steps for a ray _geo_sph_graze refuses, from _geo_sphere_roots (where
# hb, a and c are what that routine would hold there: the direction unscaled, no exact offset, hb and
# c not re-formed past what the fast path did), without forming them all again.
fn _geo_sph_refine(ray, sphere, hb, a, c, out) {
    var d = GeoRay_direction(ray);
    var cv = _geo_sph_comp(GeoRay_origin(ray), GeoSphere_center(sphere), HVec3_x(d), HVec3_y(d), HVec3_z(d),
      GeoSphere_radius(sphere), hb, a, c, out);
    if (cv < 0) { return 0; }
    if (cv == 1) { return 1; }
    return _geo_sphere_acc(ray, sphere, out);
}

fn _geo_sphere_roots_full(ray, sphere, out) {
    var o = GeoRay_origin(ray);
    var cen = GeoSphere_center(sphere);
    var d = GeoRay_direction(ray);
    var r = GeoSphere_radius(sphere);
    # 3.3.6: o - c and the products below are scalars, with the dot products written out
    # in hvec3_dot's order ((x x' + y y') + z z', the same bits): allocating o - c through
    # hvec3_sub and forming each dot product through a call cost as much as the quadratic.
    var ox = f64_sub(HVec3_x(o), HVec3_x(cen));
    var oy = f64_sub(HVec3_y(o), HVec3_y(cen));
    var oz = f64_sub(HVec3_z(o), HVec3_z(cen));
    var dx = HVec3_x(d);
    var dy = HVec3_y(d);
    var dz = HVec3_z(d);

    # 2.10.0: `a` is carried explicitly. This was the REDUCED half-b form, which
    # drops `a = d.d` from both the discriminant and the division and is therefore
    # correct only for a UNIT direction. `geo_ray_new` normalises, so the intended
    # path was safe -- but `GeoRay` is #derive(accessors), `GeoRay_set_direction`
    # is public, and nothing documented a unit-length precondition. With a
    # non-unit direction the routine returned a `t` whose hit point was not on the
    # sphere at all: for a UNIT-RADIUS sphere and d = (1,2,3) it returned 1.0,
    # putting geo_ray_at(ray, t) **3.741657387 from the centre**, silently.
    #
    # The contract every geo_ray_* shares -- "the hit point is o + t*d" -- makes t
    # degree -1 homogeneous in d, and `plane`, `triangle`, `aabb` and `obb` all
    # honoured it. This was a sibling asymmetry, the same class 2.9.1 repaired in
    # mpr_intersect vs gjk_intersect_3d, where "keep the strict reading and
    # document it" was rejected for the same reason: a contract that depends on
    # how the caller got there is not a contract.
    #
    # `geo_ray_capsule`'s own cylinder quadratic was already correct; it failed
    # the same sweep only because its end-cap branches call this function.
    # Asserted by _homog_sweep / _HG_BAD in tests/modules.tcyr, oracle-free.
    var a = f64_add(f64_add(f64_mul(dx, dx), f64_mul(dy, dy)), f64_mul(dz, dz));
    # Reject only a genuinely zero-length direction. `a` is d.d, a SQUARED
    # length, so the threshold was EPSILON_F64 SQUARED (`_GEO_F64_EPS_SQ`, gone in 3.3.4).
    # Testing it against EPSILON_F64 directly (2.10.0) made every |d| < 1e-6 a
    # miss, breaking the degree -1 homogeneity this same repair established:
    # a unit sphere at (0,0,5) with d = (0,0,1e-7) has t = 4e7, and it returned 0.
    # geo_ray_capsule inherited it through its end caps, exactly as in 2.10.0.
    # [measured: docs/development/issues/archived/2026-08-10-squared-epsilon-guards-in-geo-ray.md]
    # ⚠ 2.14.0: 2.10.2 fixed the EXPONENT here (squared length vs squared epsilon)
    # but kept an absolute SCALE, so the miss just moved: a unit sphere at (0,0,5)
    # with d = (0,0,2^-40) still returned 0. `a` only has to admit a finite
    # reciprocal (`inv_a` below), and DBL_MIN guarantees that (1/DBL_MIN = 2^1022).
    # [measured: shipped binary, hit at k = 0 and miss from k = -41]
    # ⛔ 3.3.5 — BELOW 2^-511 A RAW DIRECTION WAS STILL A MISS: `a` = d.d is under
    # DBL_MIN there (a unit sphere at (0,0,5) with d = (0,0,2^-512), true t = 5 * 2^512,
    # returned 0) while plane, triangle and AABB answer to about 2^-1022, and just
    # above it half_b^2 and a * c were subnormal. A d with d.d below 2^-968
    # (_GEO_DIR_LO) is multiplied by the power of two `sc` that takes its largest
    # component into [1, 2) (a stack copy, no allocation), the quadratic is solved for
    # it, and its roots, t / sc, are multiplied back by sc. Powers of two are exact, so
    # this is the copy's answer scaled, bit for bit the unscaled one wherever that kept
    # every product normal, and a t past DBL_MAX is +Inf as it is for a far sphere.
    # Only a zero d is still the miss, and a NaN d (a NaN `a` fails the `<`) keeps the
    # old arithmetic, as does every ray with d.d of 2^-968 or more.
    # 48 rays, each at every 2^k from 2^-1074 to 2^-400 and from 2^-20 to 2^20 (34368):
    # against an exact root, sphere answers 20229 wrong -> right and none right ->
    # wrong, and t(2^k d) is 2^-k t(d) bit for bit in all 31853 exact scalings
    # (3.3.4 differed in 11 at 2^-512..2^-510, from subnormal products, by up to
    # 22.6 ulp against the copy's 8.6). The capsule (geo_ray_capsule_branch, with
    # its barrel scaled alike) became covariant in t and branch in 20933 and lost it
    # in none; 11 differ only past DBL_MAX, where t is +Inf and the branch arbitrary.
    # The 6064 rays with d.d of 2^-968 or more kept their bits.
    # [measured: G1 ray sweep, exact Fraction/Decimal roots, 3.3.4 tree vs this one, 2026-10-11; cycc 6.6.14]
    var sc = 0;
    if (f64_lt(a, _GEO_DIR_LO) == 1) {
        var m = _geo_absmax_bits(d);
        if (m == 0) { return 0; }
        sc = _geo_scale_for(m >> 52);
        dx = f64_mul(dx, sc);
        dy = f64_mul(dy, sc);
        dz = f64_mul(dz, sc);
        a = f64_add(f64_add(f64_mul(dx, dx), f64_mul(dy, dy)), f64_mul(dz, dz));
    }
    var half_b = f64_add(f64_add(f64_mul(ox, dx), f64_mul(oy, dy)), f64_mul(oz, dz));
    var rr = f64_mul(r, r);
    var ococ = f64_add(f64_add(f64_mul(ox, ox), f64_mul(oy, oy)), f64_mul(oz, oz));
    var c = f64_sub(ococ, rr);
    # ⛔ 3.3.6 — THE DISCRIMINANT CANCELLED. hb^2 - a c subtracts two products that agree
    # in their leading bits whenever the sphere is small against its distance or the
    # ray nearly grazes it, and the near root (-hb - sqrt) / a then subtracted again:
    # 8.06 ulp on an ordinary unit-size ray (o = (4.13, 4.19, 2.15) toward a radius-1.29
    # sphere 4.5 radii away), and 1.2e6 ulp for an origin 1e-6 radii off the surface.
    # The discriminant is a (r^2 - |f|^2) with f = oc - (hb / a) d the centre's offset
    # from the line (the Ray Tracing Gems form), and the larger root in magnitude is
    # q / a with q = -(hb + sign(hb) sqrt), the other c / q, so no root subtracts
    # (_geo_quad_roots). Where the origin is inside or close (c < |f|^2) the classic
    # hb^2 - a c is kept instead, since there it is a sum, or a difference smaller than
    # |f|^2's; and c itself, which cancels near the surface, is formed exactly as two
    # doubles when it has lost two bits or more (_geo_sphere_c_exact). Over 192000 rays
    # (two seeds: the item's unit-size family with the origin 1e-6 to 4 radii out,
    # random rays and raw directions, large and small scales, tangent and on-surface
    # origins), every finite one judged against its exact verdict and root: 85296 wrong ->
    # right at 4 ulp and 35 right -> wrong, 34 of them 0.7-3.96 ulp moving to 4.0-5.9 and
    # one near-tangent ray 2.69 -> 19.3. 3542 stay wrong: 3172 rays tangent to within 1e-9
    # of the radius or from an origin on the surface, where r^2 - |f|^2 is 2e-9 of r^2
    # (at most 1.9e5 ulp; 3.3.5 4.2e17), 195 aimed from an origin below an ulp of the
    # centre's coordinates, where o - c rounds to -c and a miss reads as a hit (3.3.5:
    # NaN), and 175 more past 4 ulp (at most 45). On the unit-size family the largest
    # error fell from 1.29e6 to 11.2 ulp and the median from 90-100 to 0.55; on its origins
    # at least one radius outside the sphere, from 42.8 to 8.0 and from 1.82-1.90 to
    # 0.58-0.59. Every hit changes its bits.
    # [measured: C336 sphere sweep, seeds 41 and 42, exact Decimal roots, 3.3.5 vs this tree, 2026-10-11; cycc 6.6.14]
    var k = f64_div(half_b, a);
    var fx = f64_sub(ox, f64_mul(k, dx));
    var fy = f64_sub(oy, f64_mul(k, dy));
    var fz = f64_sub(oz, f64_mul(k, dz));
    var ff = f64_add(f64_add(f64_mul(fx, fx), f64_mul(fy, fy)), f64_mul(fz, fz));
    var delta = f64_sub(rr, ff);
    var big_d = f64_mul(a, delta);
    # ⛔ 3.3.6 — ABOVE 2^511 THE QUADRATIC OVERFLOWED, AND NaN CAME BACK. A raw direction
    # past 2^511 overflows d . d, an origin 2^512 from the centre |oc|^2, a centre at
    # 2^600 likewise: a unit sphere at (0,0,5) with d = (0,0,2^600) gave NaN for
    # t = 2^-598, and (0,0,-2^512) along +z NaN for t = 2^512. Only an overflow makes
    # a (r^2 - |f|^2) or c non-finite from finite input, so either sends the ray to
    # _geo_sphere_roots_scaled, which solves the same quadratic for a unit-size copy
    # and scales the roots back; a t past DBL_MAX is +Inf there as here. A NaN or an
    # infinite input keeps 3.3.5's arithmetic exactly (12000 such rays, bit for bit).
    # On the sweep's large-scale family (oc to DBL_MAX, d to 2^1023, o - c overflowing)
    # 39642 rays went wrong -> right and none right -> wrong; 205 stay wrong, 195 of them
    # the origins below an ulp of the centre noted above.
    # [measured: C336 sphere sweep, seeds 41 and 42, exact Decimal roots, 3.3.5 vs this tree, 2026-10-11; cycc 6.6.14]
    if (f64_lt(f64_abs(big_d), _GEO_F64_POS_INF) == 0 || f64_lt(f64_abs(c), _GEO_F64_POS_INF) == 0) {
        if (_geo_sphere_finite(ray, sphere) == 1) { return _geo_sphere_roots_scaled(ray, sphere, out); }
        # A NaN or infinite input: 3.3.5's arithmetic, unchanged (no contract specifies
        # a non-finite input's answer beyond NaN in, NaN out).
        var disc = f64_sub(f64_mul(half_b, half_b), f64_mul(a, c));
        if (f64_lt(disc, 0) == 1) { return 0; }
        var sqrt_d = f64_sqrt(disc);
        var inv_a = f64_div(F64_ONE, a);
        var u1 = f64_mul(f64_sub(f64_neg(half_b), sqrt_d), inv_a);
        var u2 = f64_mul(f64_add(f64_neg(half_b), sqrt_d), inv_a);
        if (sc != 0) {
            u1 = f64_mul(u1, sc);
            u2 = f64_mul(u2, sc);
        }
        store64(out, u1);
        store64(out + 8, u2);
        return 1;
    }
    # |oc| and r both under 2^-484: their squares are subnormal or flushed, and so is c,
    # which the near root c / q is formed from: a sphere of radius 2^-960 whose centre is
    # 3 * 2^-960 away, met along 2^56 x, read the near root 2^-1015 as 0 (3.3.5, whose
    # discriminant flushed too, as the tangent root 3 * 2^-1016). The unit-size copy forms
    # c at its own scale. Over 20000 such rays (spheres of radius 2^-1000 to 2^-20, raw
    # directions taking t to 2^-1110 .. 2^-990) against exact roots: 12003 wrong -> right,
    # none right -> wrong (31 without this test), 16 still past 4 ulp (at most 21).
    # [measured: C336 tiny-sphere family (x7.py, seed 43), 3.3.5 vs this tree, 2026-10-11; cycc 6.6.14]
    if (f64_lt(ococ, _GEO_DIR_LO) == 1 && f64_lt(rr, _GEO_DIR_LO) == 1) {
        if (_geo_sphere_finite(ray, sphere) == 1) { return _geo_sphere_roots_scaled(ray, sphere, out); }
    }
    # ⛔ 3.4.0 (the second review's S-a) — A RAY GRAZING THE SPHERE FROM CLOSE BY, hb^2 and a c
    # cancelling by two bits or more, took the hand-offs below to the scaled copy and there
    # _geo_disc_x's exact expansions: 4 us a ray, 46 times integ-snap6. Its coefficients are formed
    # here instead, in double-double with their error bounds (_geo_sphere_dd, _geo_disc_dd), and the
    # roots taken from them where the bounds certify them; elsewhere the ray goes on as before.
    # (_geo_sphere_roots does the same at the same point, as it must.)
    # [measured: R2E S-a repro and x_time.py/x_sphtime.py, in-process loops, integ-snap6 vs this tree, 2026-10-31]
    if (sc == 0 && f64_lt(c, ff) == 1) {
        var hg = f64_mul(half_b, half_b);
        var hgd = f64_sub(hg, f64_mul(a, c)) & 0x7FFF_FFFF_FFFF_FFFF;
        if (hg >= 0x0100_0000_0000_0000 && hgd < hg - 0x0020_0000_0000_0000) {
            var gz = _geo_sphere_dd(ray, sphere, out);
            if (gz >= 0) { return gz; }
        }
    }
    # c lost a bit or more to cancellation: |c| under half of |oc|^2. (3.4.0 review: from two bits
    # through 3.3.7. Between one and two the plain c is off by up to about 3 ulp, which the near root
    # c / q takes whole: the review's random capsule whose end cap read 4.18 ulp, at unit size in base
    # too, reads 1.18; the fast path hands off at the same bit, so that the two agree word for word.
    # The barrel's solve (_geo_sph_solve, _geo_barrel_fast) keeps two bits. Its offset is formed with o_perp's
    # lows now, so one bit would be right there too: the rows past 4 ulp of 30,000 ordinary capsules fall from
    # 11 to 2 (none right -> wrong). But it sends every origin 1.15 to 1.41 radii off the axis down the slow path,
    # +4.0% on those capsules' mean and +7.1% on the mixed family's, so a near root c / q with c one bit down stays
    # the class that reads up to 9.2 ulp.)
    # [measured: rt340 review families (REV-RT-py tG, tG2, seed 4), exact Fractions, base vs this tree, 2026-10-31]
    # [measured: GEO6 3.4.1 cord / rand families, Fraction oracle, tm3.py per-ray loops, s22 / variant, 2026-11-01]
    var ocv[24];   # o - c for the helpers below, which take a vector
    if ((c & 0x7FFF_FFFF_FFFF_FFFF) < (ococ & 0x7FFF_FFFF_FFFF_FFFF) - 0x0010_0000_0000_0000) {
        store64(&ocv, ox);
        store64(&ocv + 8, oy);
        store64(&ocv + 16, oz);
        c = _geo_sphere_c_fused(o, cen, &ocv, r);
        # (3.4.0: under 2^-48 of |oc|^2, the origin within about 2^-49 radii of the surface, that
        # form's 2^-104 |oc|^2 can pass an ulp of c, and c is formed exactly, _geo_c_near; |c| <
        # 2^-48 |oc|^2 is tested on the bits: |oc|^2 is 2^-970 or more here, so taking 48 from its
        # exponent field is the exact product.)
        if ((c & 0x7FFF_FFFF_FFFF_FFFF) < (ococ & 0x7FFF_FFFF_FFFF_FFFF) - 0x0300_0000_0000_0000) {
            c = _geo_c_near(o, cen, &ocv, r);
        }
        # ⛔ 3.4.0 — AND hb CANCELLED FOR A RAY GRAZING THERE. With c near 0 the far root is about
        # -2 hb / a, and hb = (o - c) . d is a sum whose terms cancel when d is nearly tangent: off
        # by the rounding of each product and of o - c itself, |cos(oc, d)|^-1 times an ulp of hb.
        # The roadmap's origin on a sphere of radius 1.3 * 2^191, met at cos 0.014, was 8.9 ulp off
        # (0x48C7CDFEAF27296F; exact 0x48C7CDFEAF272978). Under |cos| = 1/4 hb is formed with the
        # products exact and o - c's rounding carried (_geo_hb_near). The work of both is in helpers,
        # so that this routine's frame and locals stay 3.3.7's: written inline the two cost the
        # near-surface row 8 ns over 3.3.7 (240 vs 232 ns), in helpers 4.5 (235.5 vs 231).
        # [measured: rt340 ray sweeps (sweep.py, fixtures.py), exact Fraction oracle, base vs this tree, 2026-10-31]
        # [measured: rt340 focused bench (fb/rtbench.bcyr), 4 interleaved rounds, base vs this tree, 2026-10-31]
        # (On the roots: under 2^-537 for |d| |oc| both squares flushed, 0 < 0, and a near-tangent hb stayed plain.)
        if (f64_lt(f64_mul(f64_abs(half_b), _GEO_F64_FOUR), f64_mul(f64_sqrt(ococ), f64_sqrt(a))) == 1) {
            half_b = _geo_hb_near(o, cen, &ocv, dx, dy, dz);
        }
    }
    # f under 2^-40 of |oc| may be the rounding of oc - (hb / a) d along d, not the
    # offset, and _geo_perp_part forms it without that subtraction. For a ray along z
    # nearly through the centre of a unit sphere 2^133 away 3.3.5 answered the miss (and
    # was 9.65e7 ulp off at 2^137); the form above alone leaves the same residual.
    # [measured: C336 fixture search, exact Decimal roots, 3.3.5 vs this tree, 2026-10-11; cycc 6.6.14]
    # It runs only where that rounding can reach the answer: the plain f is off by about
    # 2^-52 |oc| (its part along d drops out of |f|^2 to second order), so |f|^2 under
    # 2^-80 |oc|^2 is off by less than 2^-91 |oc|^2, and with r^2 at least 2^-32 |oc|^2
    # that is under 2^-59 of r^2 - |f|^2: a ray through the centre of an ordinary sphere
    # keeps the plain form (the exact one, many times its cost, gives the same answer).
    var pn = f64_lt(rr, f64_mul(ococ, 0x3DF0_0000_0000_0000));   # 2^-32
    if (pn == 1) { pn = f64_lt(ff, f64_mul(ococ, 0x3AF0_0000_0000_0000)); }   # 2^-80
    var fv[24];
    if (pn == 1) {
        var d2[24];
        store64(&d2, dx);
        store64(&d2 + 8, dy);
        store64(&d2 + 16, dz);
        var s2 = _geo_scale_for(_geo_absmax_bits(&d2) >> 52);
        store64(&d2, f64_mul(dx, s2));
        store64(&d2 + 8, f64_mul(dy, s2));
        store64(&d2 + 16, f64_mul(dz, s2));
        store64(&ocv, ox);
        store64(&ocv + 8, oy);
        store64(&ocv + 16, oz);
        _geo_perp_part(&ocv, &d2, &fv);
        # ⛔ 3.3.7 — THE OFFSET OF A ROUNDED oc. An origin under half an ulp of a centre's
        # coordinates has o - c = -c exactly, and a ray aimed along c then passes through the
        # centre: a unit sphere at (1.5, 1.25, 0) 2^100 from (0, 2^40, 0) along that centre read
        # t = 1 for a miss 2^40 wide. lo, o - c's rounding, has its own part across d added.
        var lo2[24];
        _geo_oc_lo(o, cen, F64_ONE, &ocv, &lo2);
        _geo_add_perp(&fv, &lo2, &d2);
        fx = load64(&fv);
        fy = load64(&fv + 8);
        fz = load64(&fv + 16);
        ff = f64_add(f64_add(f64_mul(fx, fx), f64_mul(fy, fy)), f64_mul(fz, fz));
        delta = f64_sub(rr, ff);
        big_d = f64_mul(a, delta);
    }
    # The discriminant's form (see the 3.3.6 note above): classic for an origin inside
    # or near (c < |f|^2) unless it is not finite or too small, the RTG form otherwise,
    # with r^2 - |f|^2 formed at f's own scale when it is too small to trust
    # (_geo_delta_fine: both squares flush for a sphere and an offset below 2^-537).
    var sq = 0;
    var dsel = 0;
    if (f64_lt(c, ff) == 1) {
        var hh0 = f64_mul(half_b, half_b);
        var dc = f64_sub(hh0, f64_mul(a, c));
        # (3.4.0, review M4: where hb^2 and a c cancel by two bits or more the discriminant is formed
        # exactly, on the unit-size copy, _geo_sph_solve.)
        if (hh0 >= 0x0100_0000_0000_0000 && (dc & 0x7FFF_FFFF_FFFF_FFFF) < hh0 - 0x0020_0000_0000_0000) {
            if (_geo_sphere_finite(ray, sphere) == 1) { return _geo_sphere_roots_scaled(ray, sphere, out); }
        }
        if (f64_lt(f64_abs(dc), _GEO_F64_POS_INF) == 1) {
            if (f64_lt(f64_abs(dc), _GEO_DIR_LO) == 0) {
                delta = dc;
                sq = f64_sqrt(dc);
                dsel = 1;
            }
        }
    }
    if (dsel == 0) {
        sq = f64_sqrt(big_d);
        # ⛔ 3.4.1 (GEO4) — A GRAZING RAY'S r^2 - |f|^2 WAS ITS ROUNDING. See _geo_sph_graze: where the
        # offset's rounding can move the root by more than 3 ulp, the roots come from double-double
        # coefficients with their bounds (_geo_sphere_dd) or, where those cannot certify them, exactly
        # (_geo_sph_xroots). The fast path takes those steps on the same test, _geo_sph_refine.
        # (Not where r^2 and |f|^2 both flush: _geo_delta_fine below forms delta at their scale.)
        if (f64_lt(delta, f64_mul(ff, 0x3FF1_0000_0000_0000)) == 1) {   # 1.0625
            if (f64_lt(rr, _GEO_DIR_LO) == 0 || f64_lt(ff, _GEO_DIR_LO) == 0) {
                # (sq's rounding is not the bound's to pass on: under DBL_MIN big_d keeps a few bits or none)
                var sqg = sq;
                if (f64_gt(delta, 0) == 1 && f64_lt(big_d, _GEO_F64_TINY) == 1) { sqg = _geo_sqrt_tiny(a, delta); }
                if (_geo_sph_graze(half_b, sqg, delta, ff, ococ, rr) == 0) {
                    # (at the direction as scaled above, its roots then multiplied back, as below)
                    var cpv = _geo_sph_comp(o, cen, dx, dy, dz, r, half_b, a, c, out);
                    if (cpv < 0) { return 0; }
                    if (cpv == 1) {
                        if (sc != 0) {
                            store64(out, f64_mul(load64(out), sc));
                            store64(out + 8, f64_mul(load64(out + 8), sc));
                        }
                        return 1;
                    }
                    return _geo_sphere_acc(ray, sphere, out);
                }
            }
        }
        if (f64_lt(f64_abs(delta), _GEO_DIR_LO) == 1) {
            var dq[16];
            store64(&fv, fx);
            store64(&fv + 8, fy);
            store64(&fv + 16, fz);
            _geo_delta_fine(&fv, r, a, &dq);
            delta = load64(&dq);
            sq = load64(&dq + 8);
        } elif (f64_gt(delta, 0) == 1 && f64_lt(big_d, _GEO_F64_TINY) == 1) {
            # ⛔ 3.4.0 — a (r^2 - |f|^2) UNDERFLOWED. Each factor is 2^-968 or more here (a smaller
            # `a` was scaled above, a smaller delta took the line before), but their product can
            # still fall under DBL_MIN, and sqrt(a delta) then read 0 or a few bits: the tangent
            # root -hb / a came back for a ray through the sphere. A sphere of radius 2^-410 met
            # along a direction near 2^-179 long (roadmap [3.3.8]) answered 0x3182C719D9D92556
            # where the exact root is 0x317F734637AA02EF (19% off). The quadratic is solved on the
            # unit-size copy (_geo_sphere_roots_scaled), where a is at least 1. (A negative delta
            # is the miss whatever its product.)
            # [measured: rt340 ray sweeps (sweep.py, fixtures.py), exact Fraction oracle, base vs this tree, 2026-10-31]
            if (_geo_sphere_finite(ray, sphere) == 1) { return _geo_sphere_roots_scaled(ray, sphere, out); }
        }
    }
    if (_geo_quad_roots(half_b, a, c, delta, sq, out) == 0) { return 0; }
    if (sc != 0) {
        store64(out, f64_mul(load64(out), sc));
        store64(out + 8, f64_mul(load64(out + 8), sc));
    }
    return 1;
}

# _geo_sphere_c_fused from o - c's components: apart so that its stack vector is not in the frame of
# _geo_sphere_roots, every ray's.
fn _geo_sphere_c_at(o, cen, ox, oy, oz, r) {
    var ocv[24];
    store64(&ocv, ox);
    store64(&ocv + 8, oy);
    store64(&ocv + 16, oz);
    return _geo_sphere_c_fused(o, cen, &ocv, r);
}

# Both roots of the ray/sphere quadratic (the contract above), for the common case: a
# direction with d . d of 2^-968 or more, a finite quadratic, |oc| or r of 2^-484 or more, c
# that kept its leading bits, an offset f that needs no exact form, and a discriminant that
# is not too small to trust. That is _geo_sphere_roots_full's arithmetic for such a ray,
# operation for operation, so the bits are its bits; every other ray is handed to it
# (3.3.6). Written apart because cycc keeps five locals in registers, and with the general
# routine's other cases in the same body the common ray's locals were spilled.
# ⚠ The two copies must not drift: tests/modules_c.tcyr compares them word for word over
# rays that take each of the hand-offs below and rays that take none.
fn _geo_sphere_roots(ray, sphere, out) {
    var o = GeoRay_origin(ray);
    var cen = GeoSphere_center(sphere);
    var d = GeoRay_direction(ray);
    var ox = f64_sub(HVec3_x(o), HVec3_x(cen));
    var oy = f64_sub(HVec3_y(o), HVec3_y(cen));
    var oz = f64_sub(HVec3_z(o), HVec3_z(cen));
    var dx = HVec3_x(d);
    var dy = HVec3_y(d);
    var dz = HVec3_z(d);
    var a = f64_add(f64_add(f64_mul(dx, dx), f64_mul(dy, dy)), f64_mul(dz, dz));
    # (The tests below compare bit patterns as integers: for a non-negative double, or one whose
    # NaN would have been handed off already, that is the order of the values.)
    if (a < 0x0370_0000_0000_0000) { return _geo_sphere_roots_full(ray, sphere, out); }   # 2^-968
    var r = GeoSphere_radius(sphere);
    var half_b = f64_add(f64_add(f64_mul(ox, dx), f64_mul(oy, dy)), f64_mul(oz, dz));
    var rr = f64_mul(r, r);
    var ococ = f64_add(f64_add(f64_mul(ox, ox), f64_mul(oy, oy)), f64_mul(oz, oz));
    var c = f64_sub(ococ, rr);
    var k = f64_div(half_b, a);
    var fx = f64_sub(ox, f64_mul(k, dx));
    var fy = f64_sub(oy, f64_mul(k, dy));
    var fz = f64_sub(oz, f64_mul(k, dz));
    var ff = f64_add(f64_add(f64_mul(fx, fx), f64_mul(fy, fy)), f64_mul(fz, fz));
    var delta = f64_sub(rr, ff);
    var big_d = f64_mul(a, delta);
    # The hand-offs, in _geo_sphere_roots_full's order: an overflow (or a non-finite input),
    # |oc| and r both under 2^-484, c cancelled, the offset f possibly rounding. (The general
    # routine's test of c is not repeated: a c that is not finite comes from |oc|^2 or r^2
    # not finite; an r^2 or a NaN makes a (r^2 - |f|^2) non-finite too, and an |oc|^2 of
    # +Inf with r finite meets the offset's test below, r^2 and |f|^2 being under +Inf * 2^-32.)
    if ((big_d & 0x7FFF_FFFF_FFFF_FFFF) >= 0x7FF0_0000_0000_0000) { return _geo_sphere_roots_full(ray, sphere, out); }
    if (ococ < 0x0370_0000_0000_0000) {
        if (rr < 0x0370_0000_0000_0000) { return _geo_sphere_roots_full(ray, sphere, out); }
    }
    if (f64_lt(c, ff) == 1) {
        var hg = f64_mul(half_b, half_b);
        var hgd = f64_sub(hg, f64_mul(a, c)) & 0x7FFF_FFFF_FFFF_FFFF;
        if (hg >= 0x0100_0000_0000_0000 && hgd < hg - 0x0020_0000_0000_0000) {
            var gz = _geo_sphere_dd(ray, sphere, out);
            if (gz >= 0) { return gz; }
        }
    }
    if ((c & 0x7FFF_FFFF_FFFF_FFFF) < (ococ & 0x7FFF_FFFF_FFFF_FFFF) - 0x0010_0000_0000_0000) {
        # ⛔ 3.4.1 (GEO4) — c CANCELLED, HANDLED HERE WHERE THE GENERAL ROUTINE WOULD ONLY FUSE IT. An origin
        # near the surface (|c| under |oc|^2 / 2) went to _geo_sphere_roots_full, which formed every value
        # again before _geo_sphere_c_fused: 3.4.0's gates there cost ray_sphere_near_surface 4.5% over
        # 3.3.7. Where that routine's other cases do not apply its arithmetic is this routine's with the
        # fused c, so the roots are formed here, the same bits: 176 ns, 3.3.7 229. They are the ray inside
        # or grazing (c < |f|^2) and c under 2^-48 |oc|^2 once fused (_geo_c_near), both tested here. Its
        # hb gate, |hb| under |oc| sqrt(a) / 4 (_geo_hb_near), needs no test: there |f|^2 >= 15/16 |oc|^2,
        # past this |c|, so the first test below has taken the ray. Nor its offset's: r^2 is at least
        # about |oc|^2 / 2 here.
        # [measured: GEO4 3.4.1 near-surface ray, per-ray loops, 3.3.7 / s14 / this tree, 2026-11-01]
        if (f64_lt(c, ff) == 1) { return _geo_sphere_roots_full(ray, sphere, out); }
        c = _geo_sphere_c_at(o, cen, ox, oy, oz, r);
        if ((c & 0x7FFF_FFFF_FFFF_FFFF) < (ococ & 0x7FFF_FFFF_FFFF_FFFF) - 0x0300_0000_0000_0000) {
            return _geo_sphere_roots_full(ray, sphere, out);
        }
        if (f64_lt(c, ff) == 1) { return _geo_sphere_roots_full(ray, sphere, out); }
    }
    if (f64_lt(rr, f64_mul(ococ, 0x3DF0_0000_0000_0000)) == 1) {   # 2^-32
        if (f64_lt(ff, f64_mul(ococ, 0x3AF0_0000_0000_0000)) == 1) { return _geo_sphere_roots_full(ray, sphere, out); }
    }
    # The discriminant: classic for an origin inside or near unless it is not finite or
    # under 2^-968 (handed off), the RTG form otherwise unless under 2^-968 (handed off).
    var sq = 0;
    if (f64_lt(c, ff) == 1) {
        var hh = f64_mul(half_b, half_b);
        var dc = f64_sub(hh, f64_mul(a, c));
        var adc = dc & 0x7FFF_FFFF_FFFF_FFFF;
        if (adc >= 0x7FF0_0000_0000_0000) { return _geo_sphere_roots_full(ray, sphere, out); }
        if (adc < 0x0370_0000_0000_0000) { return _geo_sphere_roots_full(ray, sphere, out); }
        # (3.4.0, review M4: hb^2 and a c cancelled by two bits or more, handed off; see _geo_sph_solve.)
        if (adc < hh - 0x0020_0000_0000_0000) { return _geo_sphere_roots_full(ray, sphere, out); }
        if (f64_lt(dc, 0) == 1) { return 0; }
        sq = f64_sqrt(dc);
    } else {
        if (delta < 0x0370_0000_0000_0000) {   # (a negative delta's bits are negative)
            if ((delta & 0x7FFF_FFFF_FFFF_FFFF) < 0x0370_0000_0000_0000) {
                return _geo_sphere_roots_full(ray, sphere, out);
            }
            # (3.4.1 GEO4: a near-tangent miss, its sign not certified: _geo_sph_graze; past
            # 2^-48 |oc|^2 it always is)
            if (f64_lt(f64_abs(delta), f64_mul(ococ, 0x3CF0_0000_0000_0000)) == 1) {
                if (_geo_sph_graze(half_b, 0, delta, ff, ococ, rr) == 0) {
                    return _geo_sph_refine(ray, sphere, half_b, a, c, out);
                }
            }
            return 0;
        }
        # a (r^2 - |f|^2) below DBL_MIN, a and delta each 2^-968 or more: the product lost its
        # bits (3.4.0, handed off as the general routine hands it to the scaled copy).
        if (big_d < 0x0010_0000_0000_0000) { return _geo_sphere_roots_full(ray, sphere, out); }
        sq = f64_sqrt(big_d);
        # (3.4.1 GEO4: a grazing ray whose r^2 - |f|^2 is not certified, _geo_sph_graze)
        if (f64_lt(delta, f64_mul(ff, 0x3FF1_0000_0000_0000)) == 1) {   # 1.0625
            if (_geo_sph_graze(half_b, sq, delta, ff, ococ, rr) == 0) {
                return _geo_sph_refine(ray, sphere, half_b, a, c, out);
            }
        }
    }
    # _geo_quad_roots, written out, without its cases for c = 0, q = 0 and a root that
    # underflows: none reaches here. c is not 0 (a cancelled c is handed off), sq is at least
    # 2^-484 so q is not 0, and |q| / a >= |c| / |q| >= sqrt(|c| / a) >= 2^-999, both roots
    # normal, from |c| >= |oc|^2 / 4 with |oc|^2 or r^2 at least 2^-968 and a < 2^1024.
    var q = f64_neg(f64_add(half_b, sq));
    if (f64_lt(half_b, 0) == 1) { q = f64_sub(sq, half_b); }
    var t1 = f64_div(q, a);
    var t2 = f64_div(c, q);
    if (f64_gt(t1, t2) == 1) {
        var tt = t1;
        t1 = t2;
        t2 = tt;
    }
    store64(out, t1);
    store64(out + 8, t2);
    return 1;
}

# The first non-negative root, or 0 on a miss -- the shipped contract, unchanged.
# Near tangency (finite input, largest components): on 337,252 sampled rays built within 4 ulps of it, with r of
# 2^-484 or more, r, |o - c| and |d| under 2^510 and |d| max(r, |o - c|) under 2^512, the verdict was exact and t within
# 4 ulp on all but 3, those within 16 ulp. A smaller radius, or a ray past those limits, can read the wrong verdict or
# t, as on 3.4.0.
# [measured: GEO7 3.4.1 samp.py sphere samples, 480,000 rays, exact Fraction oracle, 3.4.0 / this tree, 2026-11-01]
public fn geo_ray_sphere(ray, sphere) {
    # STACK, not alloc: the bump allocator never frees, so a 16-byte alloc here
    # would leak per call in the module's hottest routine -- the same objection
    # geo_diff.cyr's header raises against threading dual numbers through it.
    #
    # ⚠ `&rt`, not `rt`. A stack array is a VALUE; bare `rt` passes its first
    # eight bytes as if they were an address, which stores through a wild
    # pointer and SIGSEGVs on the first call. `lib/fmt.cyr` has used `&buf`
    # since forever and it is the only correct form. Written down because the
    # bare version fails so immediately and so totally that it reads like a
    # toolchain defect, and a minimal repro was most of the way to being filed
    # as one before the stdlib was read.
    var rt[16];
    if (_geo_sphere_roots(ray, sphere, &rt) == 0) { return 0; }
    var t1 = load64(&rt);
    var t2 = load64(&rt + 8);

    if (f64_lt(t1, 0) != 1) { return t1; }
    if (f64_lt(t2, 0) != 1) { return t2; }
    return 0;
}

# Ray-AABB intersection (slab method)
#
# DEGENERATE DIRECTION, repaired 2.10.1. A slab whose direction component is
# below EPSILON_F64 is skipped as parallel, and if ALL THREE are skipped nothing
# ever narrows the interval: t_min stays -Inf, t_max stays +Inf, and the tail
# below returned +Inf. That is neither the documented miss (0) nor a usable hit
# parameter -- geo_ray_at(ray, +Inf) on a zero direction is NaN in every
# component. Reachable through the public `GeoRay_set_direction`, exactly as the
# 2.10.0 unit-direction defect was; `geo_ray_new` normalizes, so the intended
# path never saw it. Four of the six geo_ray_* siblings already returned 0 here;
# this and geo_ray_obb were the two that did not.
#
# The guard is a COUNT of contributing slabs rather than a `d.d < EPSILON` test
# up front, because that test would also reject legitimate small directions --
# (0, 0, 1e-5) has |d|^2 = 1e-10 < EPSILON_F64 but its z slab is not parallel and
# its hit is real. Counting changes behaviour on exactly the path that produced
# +Inf and nowhere else.
#
# THE PARALLEL TEST ITSELF, repaired 2.10.2. It used to be
# `|d_k| < EPSILON_F64` (1e-12), which deletes the slab. That threshold is
# scale-free and the consequence is not: what decides whether a slab matters is
# |d_k| * t_range against the box extent, and none of those appear in the test.
# Over t ~ 1e12 a component of 9e-13 moves the coordinate by ~0.9 -- most of a
# unit box -- so the slab that would have REJECTED the ray was deleted and the
# routine returned a confident hit. Measured on 2.10.1: box [0,1]^3, origin
# (0.5, 0.5, -1e12), direction (9e-13, 0, 1) with |d| = 1.0 EXACTLY returned
# t = 1e12 whose hit point sits at x = 1.4. geo_ray_new normalizes and did not
# protect. The same input from inside a tall box returned an exit 18x too large.
# [measured: docs/development/issues/archived/2026-08-10-slab-parallel-test-is-scale-free.md]
#
# The guard's only real job is to avoid a division that yields no usable
# reciprocal, so the threshold is now exactly that: _GEO_F64_TINY, the smallest
# magnitude whose 1/x is finite. Every direction component that CAN be divided by
# now is. This also makes geo_ray_obb agree with this function at the boundary --
# the two used opposite comparison senses around EPSILON_F64, so a component
# equal to it took the slab branch here and the parallel branch there, and the
# same box expressed both ways answered 0 and 4.5e12.
#
# ⚠ geo_ray_obb spells its test `f64_lt(f64_abs(f), _GEO_F64_TINY) != 1` -- the
# negation of this one rather than the more natural `f64_gt(..., TINY) == 1`, and
# that is deliberate. A mutant swapping it to the `f64_gt` form SURVIVES the
# suite, and the reason is that the two are behaviourally equivalent: they differ
# only at |f| EXACTLY equal to DBL_MIN, where 1/f is 4.5e307 and the resulting
# slab interval is so wide it constrains nothing -- which is precisely what the
# parallel branch also expresses. The form is chosen so the two functions'
# tests are textually identical, because "they agree at the boundary" should be
# checkable by reading and not only by running. (Since 3.3.5 they are not: see the
# next note.)
# [measured: docs/development/issues/archived/2026-08-10-slab-parallel-test-is-scale-free.md]
# [measured: tests/modules.tcyr "2.10.1 degenerate-direction contract"]
# ⛔ 3.3.5 — A COMPONENT BELOW DBL_MIN WAS READ AS PARALLEL, AND EVERY CROSSING
# ROUNDED TWICE. The reciprocal needed |d_k| >= DBL_MIN, so a direction normalised
# from (1e-310, 1, 0) had its x slab skipped: a ray that leaves that slab at a finite
# t answered a hit, and one that enters it a miss. The slabs now divide (b - o) / d_k,
# which needs only d_k != 0, so the parallel test is an exact zero; a crossing past
# DBL_MAX overflows to +-Inf (an entry there is the miss, as before), and each
# crossing is one correctly rounded quotient of the rounded b - o, not (b - o) *
# RN(1/d). Over 90000 finite box-ray pairs (12159 with an inverted box) against an
# exact rational oracle, 105 answers moved wrong -> right (21 with an inverted box)
# and none right -> wrong; 3339 within 2^-48 of a tie, or at t = 0, are not scored.
# t's bits changed in 4461, 3968 of them right before and after, no face with them;
# correctly rounded hits went from 13650 to 17582 of 17830 and the largest error of a
# right answer from 1.70 to 1.30 ulp. All 6000 inputs with a NaN keep D034's contract,
# and of 6000 with an infinity 80 moved, none right -> wrong against an
# extended-real oracle (24 of them Inf - Inf, which it cannot judge).
# [measured: G1 slab sweep, exact Fraction oracle, 3.3.4 tree vs this one, 2026-10-11; cycc 6.6.14]
# ⚠ geo_ray_obb_face kept the DBL_MIN test and the reciprocal through 3.3.5; 3.3.6 gives
# it the same exact zero and division (see there). The three notes below are the
# history of its old spelling, `f64_lt(|f|, DBL_MIN) != 1`: the new test,
# `f64_eq(f, 0) == 0` with the infinite-e clause, also sends a NaN f to the slab
# arithmetic, so the NaN pins they describe hold unchanged.
# ⚠ 3.3.3 — "ONLY AT |f| EXACTLY DBL_MIN" MISSES NaN. For a NaN `f` the `f64_gt`
# form is 0 and sends the slab to the parallel branch, which skips it or returns
# the miss 0; the `!= 1` form keeps the NaN in the slab arithmetic, as this
# function's `== 1` test does for a NaN `d`. Swapped on its own, each of the
# three OBB tests turned about half of 2000 NaN-direction rays from NaN into 0,
# so the mutant is not equivalent once a NaN is in play. tests/abuse.tcyr pins
# each axis with a NaN direction from outside that axis's slab.
# [measured: W1 ray sweep, one test swapped at a time, not reproducible in-tree, 2026-10-01; cycc 6.6.12]
# ⚠ 3.3.4 — FOR A NaN INPUT ONLY AXIS 0's SPELLING MATTERS. f0 = a0 . d reads every
# direction component (0 * NaN is NaN), so a NaN direction meets axis 0 first, and
# since D034 that slab returns it: swapped on axis 1 or 2 alone the test is
# equivalent for NaN input, and the suites pass. Swapped on axis 0 it still sends
# the NaN to the parallel branch, whose miss tests read only e0 and he0, and the pin
# from outside the x slab comes back 0.
# [measured: georay mutation run, one test swapped at a time, 3.3.4 tree, not in-tree, 2026-10-03; cycc 6.6.14]
#
# ⛔ 3.3.4 — AN INVERTED BOX IS READ SORTED, AS geo_ray_obb READS |he|. Only the
# setters build one (min above max on an axis; geo_aabb_new sorts its corners). A
# slab the ray crosses has always sorted its two t, so it read the slab [5, 1] as
# [1, 5], while the parallel test read the same slab as empty: an oblique ray hit
# the box and an axial one missed it. Each parallel miss test now also asks that the
# origin be outside the OTHER bound, so the slab misses only below both bounds or
# above both. For min <= max the second test is implied by the first, and for a NaN
# bound it is false, so it changes no answer there and only the miss path runs it.
# The t is the sorted box's; a face names the stored slot (face 0 is the plane at
# min.x wherever it lies), which is the plane geo_jet_aabb differentiates. Over 19803
# random boxes with one to three axes inverted (a third with a +-0, subnormal, DBL_MAX
# or infinite slot), t matches the sorted box's in all but 5, each a zero of the other
# sign from an infinite direction component, and the tie, the jet and the BVH leaf
# test in all; boxes that are not inverted keep their bits (FACE ENCODING, above).
# [measured: inverted-AABB differential, this tree, not in-tree, 2026-10-03; cycc 6.6.14]
#
# 3.3.4, D034 (see FACE ENCODING): the first NaN component of v, or 0 (+0.0) when
# it has none. A NaN's bits are never 0, so `== 0` reads "no NaN".
fn _geo_hvec3_nan(v) {
    if (f64_eq(HVec3_x(v), HVec3_x(v)) == 0) { return HVec3_x(v); }
    if (f64_eq(HVec3_y(v), HVec3_y(v)) == 0) { return HVec3_y(v); }
    if (f64_eq(HVec3_z(v), HVec3_z(v)) == 0) { return HVec3_z(v); }
    return 0;
}

# The miss 0, or the first NaN among the ray's and the box's twelve inputs. Every
# miss geo_ray_aabb_face finds before its last slab has read its inputs returns
# this: a parallel slab's two tests fire before its own NaN tests, and a slab
# later than the one that missed is never read.
fn _geo_ray_aabb_nan_or_miss(ray, aabb) {
    var n = _geo_hvec3_nan(GeoRay_origin(ray));
    if (n == 0) { n = _geo_hvec3_nan(GeoRay_direction(ray)); }
    if (n == 0) { n = _geo_hvec3_nan(GeoAabb_min(aabb)); }
    if (n == 0) { n = _geo_hvec3_nan(GeoAabb_max(aabb)); }
    return n;
}

# The first NaN among the ray's and the OBB's sixteen inputs, or 0. A NaN slab in
# geo_ray_obb_face can come from FINITE input too: an axis's exact zero component
# times a centre-to-origin offset that overflowed (0 * Inf). Only a NaN the caller
# supplied is returned; one the arithmetic made is left to the slab test as in 3.3.3.
fn _geo_ray_obb_nan(ray, obb) {
    var n = _geo_hvec3_nan(GeoRay_origin(ray));
    if (n == 0) { n = _geo_hvec3_nan(GeoRay_direction(ray)); }
    if (n == 0) { n = _geo_hvec3_nan(GeoObb_center(obb)); }
    if (n == 0) { n = _geo_hvec3_nan(GeoObb_half_extents(obb)); }
    var q = GeoObb_rotation(obb);
    if (n == 0) { if (f64_eq(HQuat_x(q), HQuat_x(q)) == 0) { n = HQuat_x(q); } }
    if (n == 0) { if (f64_eq(HQuat_y(q), HQuat_y(q)) == 0) { n = HQuat_y(q); } }
    if (n == 0) { if (f64_eq(HQuat_z(q), HQuat_z(q)) == 0) { n = HQuat_z(q); } }
    if (n == 0) { if (f64_eq(HQuat_w(q), HQuat_w(q)) == 0) { n = HQuat_w(q); } }
    return n;
}

# ================================================================
# Exact slab ordering (3.3.6), shared by geo_ray_aabb_face and geo_ray_obb_face
# ================================================================
# Each slab crossing is (p - q) / d: (bound - o) / d_k for the AABB, (e -+ he) / f_k for
# the OBB. The double the slab code forms, RN(RN(p - q) / d), loses its order with the
# other crossings in two ways on finite input:
#   * p - q OVERFLOWS (|p - q| > DBL_MAX) while the quotient is finite, so a crossing
#     at, say, 2^1022 reads +Inf and loses the min to a later exit, or the max to a
#     smaller entry;
#   * the quotient UNDERFLOWS to zero, and its sign is all that is left: a zero crossing
#     reads the same whether it is exact (p = q, the origin on that plane) or the rounding
#     of a crossing truly behind the origin (-0) or ahead of it (+0), and no f64 compare
#     tells -0 from +0, so an exit at -2^-2074 read as the hit t = 0. Crossings that land
#     among the subnormals keep their sign but round on the absolute 2^-1074 grid, so two
#     of them a factor of two apart can read equal.
# _bvh_ray_hits_aabb (src/geo_advanced.cyr) settles the same class through its own
# extended-real copy; modules cannot share `_` names, so this is geo.cyr's. The slab
# routines keep their double arithmetic and send a box here only when a reading can
# be one of these (an exit read +Inf, an entry read +Inf, or the t that decides the
# answer is zero or subnormal) and every slab input is finite. Here each crossing is
# an extended real: the same two roundings as the double (RN(p - q), formed as
# p/2 - q/2 one binade up when it overflows, and one correctly rounded quotient of the
# mantissas) with an unbounded exponent, so two crossings order exactly as their
# double values would with no overflow and no underflow. The t returned is the
# selected crossing's double, RN(RN(p - q) / d), the value the slab code forms
# wherever p - q does not overflow.

# The exponent field and the [1, 2) mantissa (as f64 bits) of a finite non-zero x,
# subnormals normalised; written to p[0], p[1] with p[0] the unbiased exponent.
fn _geo_frexp(x, p) {
    var a = x & 0x7FFF_FFFF_FFFF_FFFF;
    var e = a >> 52;
    var adj = 0;
    if (e == 0) {
        a = f64_mul(a, 0x43F0_0000_0000_0000) & 0x7FFF_FFFF_FFFF_FFFF;   # * 2^64, exact
        e = a >> 52;
        adj = 64;
    }
    store64(p, e - 1023 - adj);
    store64(p + 8, (a & 0x000F_FFFF_FFFF_FFFF) | 0x3FF0_0000_0000_0000);
    return 0;
}

# The crossing (p - q) / d, for finite p, q and a finite non-zero d, as an extended
# real at x: x[0] the class (0 zero, 1 positive, -1 negative), x[8] a binary exponent E
# and x[16] a mantissa m in [1, 2), the value m * 2^E. p - q rounds once; when it
# overflows it is p/2 - q/2 with E one higher: one of the two is then at least 2^1023
# and halves exactly, and a subnormal last bit the other may drop is below half an ulp
# of the difference, so the rounding is the same. ⚠ Not p/2 - q/2 always: halving a
# subnormal can be the whole difference (2^-1074 - 0 halves to 0).
fn _geo_xcross(p, q, d, x) {
    var n = f64_sub(p, q);
    var eh = 0;
    if ((n & 0x7FFF_FFFF_FFFF_FFFF) == 0x7FF0_0000_0000_0000) {
        n = f64_sub(f64_mul(p, F64_HALF), f64_mul(q, F64_HALF));
        eh = 1;
    }
    store64(x + 8, 0);
    store64(x + 16, 0);
    if (f64_eq(n, 0) == 1) {
        store64(x, 0);
        return 0;
    }
    var fnum[16];
    var fden[16];
    _geo_frexp(n, &fnum);
    _geo_frexp(d, &fden);
    var m = f64_div(load64(&fnum + 8), load64(&fden + 8));
    var e = load64(&fnum) - load64(&fden) + eh;
    if (f64_lt(m, F64_ONE) == 1) {
        m = f64_mul(m, F64_TWO);
        e = e - 1;
    }
    var sg = 1;
    if (f64_lt(n, 0) == 1) { sg = 0 - sg; }
    if (f64_lt(d, 0) == 1) { sg = 0 - sg; }
    store64(x, sg);
    store64(x + 8, e);
    store64(x + 16, m);
    return 0;
}

# -1, 0 or 1 as the extended crossing at a is below, equal to or above the one at b.
# Classes -2 and 2 are the -Inf / +Inf start values of the running entry and exit.
# The order of two NEGATIVE crossings never reaches the answer (an entry behind the origin
# is never returned, and an exit behind it is the miss by its class alone), so a mutant
# that drops the `ca < 0` flip survives as equivalent; it is kept so the order is true.
# [measured: C336 final mutation run on tests/modules.tcyr, 2026-10-11; cycc 6.6.14]
fn _geo_xcmp(a, b) {
    var ca = load64(a);
    var cb = load64(b);
    if (ca != cb) {
        if (ca < cb) { return 0 - 1; }
        return 1;
    }
    if (ca == 0 || ca == 2 || ca == 0 - 2) { return 0; }
    var r = 0;
    var ea = load64(a + 8);
    var eb = load64(b + 8);
    if (ea < eb) { r = 0 - 1; }
    elif (ea > eb) { r = 1; }
    elif (f64_lt(load64(a + 16), load64(b + 16)) == 1) { r = 0 - 1; }
    elif (f64_gt(load64(a + 16), load64(b + 16)) == 1) { r = 1; }
    if (ca < 0) { r = 0 - r; }
    return r;
}

# The double the slab code forms for (p - q) / d, RN(RN(p - q) / d), also where p - q
# overflows: then (p/2 - q/2) / d is at least 1/2 in magnitude, so doubling it is exact
# and the value is the one an unbounded exponent would give (+-Inf when the crossing
# itself is past DBL_MAX).
fn _geo_cross_dbl(p, q, d) {
    var n = f64_sub(p, q);
    if ((n & 0x7FFF_FFFF_FFFF_FFFF) == 0x7FF0_0000_0000_0000) {
        return f64_mul(f64_div(f64_sub(f64_mul(p, F64_HALF), f64_mul(q, F64_HALF)), d), F64_TWO);
    }
    return f64_div(n, d);
}

# The slab answer from extended crossings. `s` holds three slabs of five words,
# (p1, q1, p2, q2, d): the min-side crossing (p1 - q1) / d is face 2k, the max-side one
# (p2 - q2) / d face 2k + 1; a slab with d = 0 is parallel and read here as the slab
# code reads it, because a box can be sent here from an earlier slab's miss test before
# the later slabs were read. Every word is finite. The face, tie and t rules are the slab code's,
# step for step, with each double compare replaced by the extended one: the swap, the
# strict-increase face and the equal-value tie per slab, the t_min = t_max tie, and the
# return of the entry when it is at or after the origin, the exit when only that is,
# the miss 0 otherwise. Among tied crossings the t kept is the later slab's, as
# f64_max / f64_min keep it, which only decides the sign of a zero.
fn _geo_slabs_exact(s, out) {
    var te[24];
    var tx[24];
    var c1[24];
    var c2[24];
    store64(&te, 0 - 2);
    store64(&tx, 2);
    var td_min = _GEO_F64_NEG_INF;
    var td_max = _GEO_F64_POS_INF;
    var face_near = GEO_FACE_NONE;
    var face_far  = GEO_FACE_NONE;
    var tie_near = 0;
    var tie_far  = 0;
    for (var k = 0; k < 3; k = k + 1) {
        var b = s + k * 40;
        var d = load64(b + 32);
        if (f64_eq(d, 0) == 1) {
            # A parallel slab misses when the origin is outside it: both differences of
            # one strict sign (their rounding keeps the sign). The caller may send the box
            # here from a slab before this one, so this slab is read here too.
            var n1 = f64_sub(load64(b), load64(b + 8));
            var n2 = f64_sub(load64(b + 16), load64(b + 24));
            if (f64_gt(n1, 0) == 1) { if (f64_gt(n2, 0) == 1) { return 0; } }
            if (f64_lt(n1, 0) == 1) { if (f64_lt(n2, 0) == 1) { return 0; } }
        } else {
            var t1 = _geo_cross_dbl(load64(b), load64(b + 8), d);
            var t2 = _geo_cross_dbl(load64(b + 16), load64(b + 24), d);
            _geo_xcross(load64(b), load64(b + 8), d, &c1);
            _geo_xcross(load64(b + 16), load64(b + 24), d, &c2);
            var lo = &c1;
            var hi = &c2;
            var f1 = 2 * k;
            var f2 = 2 * k + 1;
            if (_geo_xcmp(&c1, &c2) > 0) {
                lo = &c2;
                hi = &c1;
                var tt = t1; t1 = t2; t2 = tt;
                f1 = 2 * k + 1;
                f2 = 2 * k;
            }
            var r = _geo_xcmp(lo, &te);
            if (r >= 0) {
                if (r > 0) {
                    store64(&te, load64(lo));
                    store64(&te + 8, load64(lo + 8));
                    store64(&te + 16, load64(lo + 16));
                    face_near = f1;
                    tie_near = 0;
                } else { tie_near = 1; }
                td_min = t1;
            }
            r = _geo_xcmp(hi, &tx);
            if (r <= 0) {
                if (r < 0) {
                    store64(&tx, load64(hi));
                    store64(&tx + 8, load64(hi + 8));
                    store64(&tx + 16, load64(hi + 16));
                    face_far = f2;
                    tie_far = 0;
                } else { tie_far = 1; }
                td_max = t2;
            }
        }
    }
    var rr = _geo_xcmp(&te, &tx);
    if (rr > 0) { return 0; }
    if (rr == 0) { tie_near = 1; tie_far = 1; }
    if (load64(&te) >= 0) {
        if (f64_eq(f64_abs(td_min), _GEO_F64_POS_INF) == 1) { return 0; }
        if (out != 0) { store64(out, face_near); store64(out + 8, tie_near); }
        return td_min;
    }
    if (load64(&tx) >= 0) {
        if (f64_eq(f64_abs(td_max), _GEO_F64_POS_INF) == 1) { return 0; }
        if (out != 0) { store64(out, face_far); store64(out + 8, tie_far); }
        return td_max;
    }
    return 0;
}

# 1 when a slab's crossing nlo / d or nhi / d is zero or subnormal although its numerator is
# not 0, the crossing then having underflowed (3.3.6). A t_min or t_max that reads zero or
# subnormal sends the box to the exact order only when some crossing did: a numerator of 0
# (the origin on that face's plane, b - o = 0 exactly) is the crossing 0 exactly, and with
# none underflowed every zero or subnormal reading is exact and every other one at least
# 2^-1022, so the order holds. (Through round 2 every zero reading took the exact order, an
# origin on a face, the contact, on every call.) d = 0 is a parallel slab, which crosses
# nothing.
fn _geo_slab_uf(nlo, nhi, d) {
    if (f64_eq(d, 0) == 1) { return 0; }
    if (f64_eq(nlo, 0) == 0) {
        if ((f64_div(nlo, d) & 0x7FFF_FFFF_FFFF_FFFF) < 0x0010_0000_0000_0000) { return 1; }
    }
    if (f64_eq(nhi, 0) == 0) {
        if ((f64_div(nhi, d) & 0x7FFF_FFFF_FFFF_FFFF) < 0x0010_0000_0000_0000) { return 1; }
    }
    return 0;
}

# _geo_slab_uf over the box's three slabs (the crossings formed again from the ray and the
# box: the tail that asks is rare, and the slab code's own locals kept for it would hold
# registers through the common path).
fn _geo_ray_aabb_uf(ray, aabb) {
    var o = load64(ray);
    var d = load64(ray + 8);
    var lo = load64(aabb);
    var hi = load64(aabb + 8);
    var d0 = load64(d + 0);
    if ((d0 & 0x7FFF_FFFF_FFFF_FFFF) != 0) {
        var o0 = load64(o + 0);
        var a0 = f64_sub(load64(lo + 0), o0);
        if ((a0 & 0x7FFF_FFFF_FFFF_FFFF) != 0) {
            if ((f64_div(a0, d0) & 0x7FFF_FFFF_FFFF_FFFF) < 0x0010_0000_0000_0000) { return 1; }
        }
        var b0 = f64_sub(load64(hi + 0), o0);
        if ((b0 & 0x7FFF_FFFF_FFFF_FFFF) != 0) {
            if ((f64_div(b0, d0) & 0x7FFF_FFFF_FFFF_FFFF) < 0x0010_0000_0000_0000) { return 1; }
        }
    }
    var d1 = load64(d + 8);
    if ((d1 & 0x7FFF_FFFF_FFFF_FFFF) != 0) {
        var o1 = load64(o + 8);
        var a1 = f64_sub(load64(lo + 8), o1);
        if ((a1 & 0x7FFF_FFFF_FFFF_FFFF) != 0) {
            if ((f64_div(a1, d1) & 0x7FFF_FFFF_FFFF_FFFF) < 0x0010_0000_0000_0000) { return 1; }
        }
        var b1 = f64_sub(load64(hi + 8), o1);
        if ((b1 & 0x7FFF_FFFF_FFFF_FFFF) != 0) {
            if ((f64_div(b1, d1) & 0x7FFF_FFFF_FFFF_FFFF) < 0x0010_0000_0000_0000) { return 1; }
        }
    }
    var d2 = load64(d + 16);
    if ((d2 & 0x7FFF_FFFF_FFFF_FFFF) != 0) {
        var o2 = load64(o + 16);
        var a2 = f64_sub(load64(lo + 16), o2);
        if ((a2 & 0x7FFF_FFFF_FFFF_FFFF) != 0) {
            if ((f64_div(a2, d2) & 0x7FFF_FFFF_FFFF_FFFF) < 0x0010_0000_0000_0000) { return 1; }
        }
        var b2 = f64_sub(load64(hi + 16), o2);
        if ((b2 & 0x7FFF_FFFF_FFFF_FFFF) != 0) {
            if ((f64_div(b2, d2) & 0x7FFF_FFFF_FFFF_FFFF) < 0x0010_0000_0000_0000) { return 1; }
        }
    }
    return 0;
}

# 1 when a zero reading of the selected crossing is known exact without the general check
# (3.4.0): the caller tracks faces (out != 0), the crossing reads +-0 (tz, its bits without the
# sign, is 0), no other slab tied it, and the selected face's bound equals the origin's
# coordinate, so its numerator is 0 and the crossing is 0 exactly. With no tie every other
# crossing on its side reads strictly beyond 0 (below it for an entry, above for an exit), and a
# crossing that underflows keeps its sign, so it is truly beyond 0 as well; every crossing on the
# other side already reads past it (the interval was not empty). So the exact order picks this
# crossing, with this face, no tie and this double: _geo_slabs_exact's answer, without the six
# divisions of the general check. (Through 3.3.7 every zero reading took that check, an origin on a
# face 117 ns where 3.3.5 took 78; a draft also asked the other end to read DBL_MIN or more, which no
# input distinguishes, its mutant surviving every suite and 160,000 differential rays.)
# [measured: rt340 slab differential (slabdiff.py), 3.4.0 base vs this tree, t/face/tie bit for bit, 2026-10-31]
fn _geo_aabb_face_exact0(ray, aabb, face, tie, tz, out) {
    if (out == 0 || tz != 0 || tie != 0 || face < 0) { return 0; }
    var k = (face >> 1) * 8;
    var b = load64(load64(aabb + (face & 1) * 8) + k);
    if (f64_eq(b, load64(load64(ray) + k)) == 1) { return 1; }
    return 0;
}

# 1 when all twelve of the ray's and the box's inputs are finite (_geo_hvec3_nonfinite is
# the house test). Only a box whose inputs are all finite is sent to _geo_slabs_exact:
# a non-finite input keeps the slab code's 3.3.5 answer (no contract specifies a non-finite
# input's answer beyond NaN in, NaN out).
fn _geo_ray_aabb_finite(ray, aabb) {
    if (_geo_hvec3_nonfinite(GeoRay_origin(ray)) == 1) { return 0; }
    if (_geo_hvec3_nonfinite(GeoRay_direction(ray)) == 1) { return 0; }
    if (_geo_hvec3_nonfinite(GeoAabb_min(aabb)) == 1) { return 0; }
    if (_geo_hvec3_nonfinite(GeoAabb_max(aabb)) == 1) { return 0; }
    return 1;
}

# geo_ray_aabb_face's answer from _geo_slabs_exact: the crossings (min_k - o_k) / d_k and
# (max_k - o_k) / d_k of each axis.
fn _geo_ray_aabb_exact(ray, aabb, out) {
    var o = GeoRay_origin(ray);
    var d = GeoRay_direction(ray);
    var lo = GeoAabb_min(aabb);
    var hi = GeoAabb_max(aabb);
    var s[120];
    store64(&s, HVec3_x(lo));
    store64(&s + 8, HVec3_x(o));
    store64(&s + 16, HVec3_x(hi));
    store64(&s + 24, HVec3_x(o));
    store64(&s + 32, HVec3_x(d));
    store64(&s + 40, HVec3_y(lo));
    store64(&s + 48, HVec3_y(o));
    store64(&s + 56, HVec3_y(hi));
    store64(&s + 64, HVec3_y(o));
    store64(&s + 72, HVec3_y(d));
    store64(&s + 80, HVec3_z(lo));
    store64(&s + 88, HVec3_z(o));
    store64(&s + 96, HVec3_z(hi));
    store64(&s + 104, HVec3_z(o));
    store64(&s + 112, HVec3_z(d));
    return _geo_slabs_exact(&s, out);
}

# ⛔ 3.3.5 — AN INFINITE ORIGIN WITH 0 < |d_k| < DBL_MIN TAKES THE PARALLEL BRANCH, as
# every |d_k| below DBL_MIN did in 3.3.4. A finite origin's slab now crosses such a d_k,
# (bound - o) / d_k; an infinite origin's crossings are only +-Inf or Inf - Inf, and the
# parallel tests read exactly what they would say: a miss when the origin is outside
# the slab (read sorted, AN INVERTED BOX, above), the slab skipped when the origin lies
# on a bound of the same infinity, and the slab's own NaN first. Crossing it instead
# gave two infinite t of one sign, which the slab's miss test reads as a tie, and a
# later slab's Inf - Inf NaN then reported a hit: 11 hits where 3.3.4 missed, and 342
# NaN t with another NaN's payload, in 60000 rays with one or two infinite origin
# coordinates. Now 180000 such rays differ from 3.3.4 only in a 1-ulp t (the division).
# [measured: second G1 review's infinite-origin sweep, seeds 61-63, 3.3.4/round 2/this tree, 2026-10-11; cycc 6.6.14]
# ⚠ ONLY BELOW DBL_MIN, so that no answer moves from 3.3.4. Through a normal d_k the
# Inf - Inf crossing is left to the slab arithmetic, pinned since 3.3.3 ("a NaN made
# from input with no NaN"), which answers by the order of the stored bounds and the
# sign of d_k: on the box [-0.16, +Inf] from x = +Inf, the y slab's hit along +x and a
# miss along -x. No contract says which answer that class should have, and this does
# not decide it. The test is inline with its integer half first, so a finite
# origin pays one AND and one compare per slab and no call. _bvh_ray_hits_aabb holds
# the slab for every finite d_k.
# [measured: G1 review probe, 3.3.4 tree and this one, 2026-10-11; cycc 6.6.14]
# On z, the last slab, crossing an off-bound origin or a NaN bound gives what the
# parallel branch gives (two infinite t of one sign end in the miss, and the slab's
# own first NaN is the first one unread), so those two mutants survive as equivalent.
# [measured: G1 mutation run on tests/modules.tcyr, 2026-10-11; cycc 6.6.14]

# Ray-box intersection with the face hit (the slab method): the entry t > 0, or the exit for an
# origin inside, or 0 on a miss, with out (GEO_FACE_OUT_BYTES, when not 0) holding the face (2 *
# axis + plane, GEO_FACE_NONE on a miss) and the edge/corner tie flag. An inverted (setter-built)
# box is read sorted. NaN in, NaN out with GEO_FACE_NONE (FACE ENCODING above); a crossing past
# DBL_MAX is the miss. The direction need not be unit.
public fn geo_ray_aabb_face(ray, aabb, out) {
    var ox = HVec3_x(GeoRay_origin(ray));
    var oy = HVec3_y(GeoRay_origin(ray));
    var oz = HVec3_z(GeoRay_origin(ray));
    var dx = HVec3_x(GeoRay_direction(ray));
    var dy = HVec3_y(GeoRay_direction(ray));
    var dz = HVec3_z(GeoRay_direction(ray));
    var bmin_x = HVec3_x(GeoAabb_min(aabb));
    var bmin_y = HVec3_y(GeoAabb_min(aabb));
    var bmin_z = HVec3_z(GeoAabb_min(aabb));
    var bmax_x = HVec3_x(GeoAabb_max(aabb));
    var bmax_y = HVec3_y(GeoAabb_max(aabb));
    var bmax_z = HVec3_z(GeoAabb_max(aabb));

    var t_min = _GEO_F64_NEG_INF;
    var t_max = _GEO_F64_POS_INF;
    var slabs = 0;
    var face_near = GEO_FACE_NONE;
    var face_far  = GEO_FACE_NONE;
    var tie_near = 0;
    var tie_far  = 0;
    if (out != 0) {
        store64(out, GEO_FACE_NONE);
        store64(out + 8, 0);
    }

    # X slab
    if (f64_eq(dx, 0) == 1 || ((ox & 0x7FFF_FFFF_FFFF_FFFF) == 0x7FF0_0000_0000_0000
        && f64_lt(f64_abs(dx), _GEO_F64_TINY) == 1)) {
        # Parallel: the miss tests are false for a NaN, so the slab's own inputs
        # are tested after them (D034, header). Each reads the slab SORTED: below
        # both bounds, or above both (AN INVERTED BOX, above). For min <= max
        # the inner test is implied by the outer, and for a NaN bound it is false.
        if (f64_lt(ox, bmin_x) == 1) {
            if (f64_ge(ox, bmax_x) == 0) { return _geo_ray_aabb_nan_or_miss(ray, aabb); }
        }
        if (f64_gt(ox, bmax_x) == 1) {
            if (f64_le(ox, bmin_x) == 0) { return _geo_ray_aabb_nan_or_miss(ray, aabb); }
        }
        if (f64_eq(ox, ox) == 0) { return ox; }
        if (f64_eq(bmin_x, bmin_x) == 0) { return bmin_x; }
        if (f64_eq(bmax_x, bmax_x) == 0) { return bmax_x; }
    } else {
        var t1 = f64_div(f64_sub(bmin_x, ox), dx);
        var t2 = f64_div(f64_sub(bmax_x, ox), dx);
        var f1 = 0;
        var f2 = 1;
        if (f64_gt(t1, t2) == 1) {
            var tmp = t1; t1 = t2; t2 = tmp;
            f1 = 1; f2 = 0;
        }
        if (t2 == 0x7FF0_0000_0000_0000) {   # an exit read +Inf (see the tail)
            var xb = bmax_x;
            if (f2 == 0) { xb = bmin_x; }
            if ((f64_sub(xb, ox) & 0x7FFF_FFFF_FFFF_FFFF) == 0x7FF0_0000_0000_0000) {
                if (_geo_ray_aabb_finite(ray, aabb) == 1) { return _geo_ray_aabb_exact(ray, aabb, out); }
            }
        }
        # Face bookkeeping, BEFORE the update so `t_min` still holds the running
        # value: a strict increase means this slab now owns the near face and any
        # earlier tie is void; exact equality means two slabs achieve it, which is
        # an edge or corner hit. f64_max returns `t1` whenever t1 >= t_min, so
        # `f64_gt(t1, t_min)` is exactly "this slab changed the answer".
        if (out != 0) {
            if (f64_gt(t1, t_min) == 1) {
                face_near = f1;
                tie_near = 0;
            }
            else { if (f64_eq(t1, t_min) == 1) { tie_near = 1; } }
            if (f64_lt(t2, t_max) == 1) {
                face_far = f2;
                tie_far = 0;
            }
            else { if (f64_eq(t2, t_max) == 1) { tie_far = 1; } }
        }
        t_min = f64_max(t_min, t1);
        t_max = f64_min(t_max, t2);
        slabs = slabs + 1;
        # NaN-true: t_min < t_max fails for the miss, for the tie (which falls
        # through) and for a NaN this slab read, which leaves as t (D034, header).
        # On the first slab the miss arm cannot fire: t1 <= t2 after the swap.
        if (f64_lt(t_min, t_max) == 0) {
            if (f64_gt(t_min, t_max) == 1) { return _geo_ray_aabb_nan_or_miss(ray, aabb); }
            if (f64_eq(t_min, t_max) == 0) {
                var nn = _geo_ray_aabb_nan_or_miss(ray, aabb);
                if (nn != 0) { return nn; }
            }
        }
    }

    # Y slab
    if (f64_eq(dy, 0) == 1 || ((oy & 0x7FFF_FFFF_FFFF_FFFF) == 0x7FF0_0000_0000_0000
        && f64_lt(f64_abs(dy), _GEO_F64_TINY) == 1)) {
        if (f64_lt(oy, bmin_y) == 1) {
            if (f64_ge(oy, bmax_y) == 0) { return _geo_ray_aabb_nan_or_miss(ray, aabb); }
        }
        if (f64_gt(oy, bmax_y) == 1) {
            if (f64_le(oy, bmin_y) == 0) { return _geo_ray_aabb_nan_or_miss(ray, aabb); }
        }
        if (f64_eq(oy, oy) == 0) { return oy; }
        if (f64_eq(bmin_y, bmin_y) == 0) { return bmin_y; }
        if (f64_eq(bmax_y, bmax_y) == 0) { return bmax_y; }
    } else {
        var t1 = f64_div(f64_sub(bmin_y, oy), dy);
        var t2 = f64_div(f64_sub(bmax_y, oy), dy);
        var f1 = 2;
        var f2 = 3;
        if (f64_gt(t1, t2) == 1) {
            var tmp = t1; t1 = t2; t2 = tmp;
            f1 = 3; f2 = 2;
        }
        if (t2 == 0x7FF0_0000_0000_0000) {   # an exit read +Inf (see the tail)
            var xb = bmax_y;
            if (f2 == 2) { xb = bmin_y; }
            if ((f64_sub(xb, oy) & 0x7FFF_FFFF_FFFF_FFFF) == 0x7FF0_0000_0000_0000) {
                if (_geo_ray_aabb_finite(ray, aabb) == 1) { return _geo_ray_aabb_exact(ray, aabb, out); }
            }
        }
        # Face bookkeeping, BEFORE the update so `t_min` still holds the running
        # value: a strict increase means this slab now owns the near face and any
        # earlier tie is void; exact equality means two slabs achieve it, which is
        # an edge or corner hit. f64_max returns `t1` whenever t1 >= t_min, so
        # `f64_gt(t1, t_min)` is exactly "this slab changed the answer".
        if (out != 0) {
            if (f64_gt(t1, t_min) == 1) {
                face_near = f1;
                tie_near = 0;
            }
            else { if (f64_eq(t1, t_min) == 1) { tie_near = 1; } }
            if (f64_lt(t2, t_max) == 1) {
                face_far = f2;
                tie_far = 0;
            }
            else { if (f64_eq(t2, t_max) == 1) { tie_far = 1; } }
        }
        t_min = f64_max(t_min, t1);
        t_max = f64_min(t_max, t2);
        slabs = slabs + 1;
        if (f64_lt(t_min, t_max) == 0) {
            if (f64_gt(t_min, t_max) == 1) {
                # An entry read +Inf may be finite (3.3.6, see the tail).
                if (t_min == 0x7FF0_0000_0000_0000) {
                    if (_geo_ray_aabb_finite(ray, aabb) == 1) { return _geo_ray_aabb_exact(ray, aabb, out); }
                }
                return _geo_ray_aabb_nan_or_miss(ray, aabb);
            }
            if (f64_eq(t_min, t_max) == 0) {
                var nn = _geo_ray_aabb_nan_or_miss(ray, aabb);
                if (nn != 0) { return nn; }
            }
        }
    }

    # Z slab
    if (f64_eq(dz, 0) == 1 || ((oz & 0x7FFF_FFFF_FFFF_FFFF) == 0x7FF0_0000_0000_0000
        && f64_lt(f64_abs(dz), _GEO_F64_TINY) == 1)) {
        if (f64_lt(oz, bmin_z) == 1) {
            if (f64_ge(oz, bmax_z) == 0) { return _geo_ray_aabb_nan_or_miss(ray, aabb); }
        }
        if (f64_gt(oz, bmax_z) == 1) {
            if (f64_le(oz, bmin_z) == 0) { return _geo_ray_aabb_nan_or_miss(ray, aabb); }
        }
        if (f64_eq(oz, oz) == 0) { return oz; }
        if (f64_eq(bmin_z, bmin_z) == 0) { return bmin_z; }
        if (f64_eq(bmax_z, bmax_z) == 0) { return bmax_z; }
    } else {
        var t1 = f64_div(f64_sub(bmin_z, oz), dz);
        var t2 = f64_div(f64_sub(bmax_z, oz), dz);
        var f1 = 4;
        var f2 = 5;
        if (f64_gt(t1, t2) == 1) {
            var tmp = t1; t1 = t2; t2 = tmp;
            f1 = 5; f2 = 4;
        }
        if (t2 == 0x7FF0_0000_0000_0000) {   # an exit read +Inf (see the tail)
            var xb = bmax_z;
            if (f2 == 4) { xb = bmin_z; }
            if ((f64_sub(xb, oz) & 0x7FFF_FFFF_FFFF_FFFF) == 0x7FF0_0000_0000_0000) {
                if (_geo_ray_aabb_finite(ray, aabb) == 1) { return _geo_ray_aabb_exact(ray, aabb, out); }
            }
        }
        # Face bookkeeping, BEFORE the update so `t_min` still holds the running
        # value: a strict increase means this slab now owns the near face and any
        # earlier tie is void; exact equality means two slabs achieve it, which is
        # an edge or corner hit. f64_max returns `t1` whenever t1 >= t_min, so
        # `f64_gt(t1, t_min)` is exactly "this slab changed the answer".
        if (out != 0) {
            if (f64_gt(t1, t_min) == 1) {
                face_near = f1;
                tie_near = 0;
            }
            else { if (f64_eq(t1, t_min) == 1) { tie_near = 1; } }
            if (f64_lt(t2, t_max) == 1) {
                face_far = f2;
                tie_far = 0;
            }
            else { if (f64_eq(t2, t_max) == 1) { tie_far = 1; } }
        }
        t_min = f64_max(t_min, t1);
        t_max = f64_min(t_max, t2);
        slabs = slabs + 1;
        if (f64_lt(t_min, t_max) == 0) {
            if (f64_gt(t_min, t_max) == 1) {
                if (t_min == 0x7FF0_0000_0000_0000) {
                    if (_geo_ray_aabb_finite(ray, aabb) == 1) { return _geo_ray_aabb_exact(ray, aabb, out); }
                }
                return 0;
            }
            if (f64_eq(t_min, t_max) == 0) {
                var nn = _geo_ray_aabb_nan_or_miss(ray, aabb);
                if (nn != 0) { return nn; }
            }
        }
    }

    # See the header: every slab parallel means nothing narrowed the interval and
    # the two returns below would hand back +Inf.
    if (slabs == 0) { return 0; }

    # t_min == t_max: ONE test, TWO non-differentiable situations, both of which
    # the per-slab tie above is blind to because it compares near against near
    # and far against far, never t_min against t_max.
    #
    #   TANGENTIAL CLIP -- different slabs own the entry and the exit and they
    #   coincide. The hit sits on the BOUNDARY of the hit set: an arbitrarily
    #   small sideways perturbation makes it a miss.
    #
    #   ZERO-WIDTH SLAB -- min_k == max_k (a flat box, or a zero half-extent).
    #   Then t1 == t2 on that axis, the swap never runs (f64_gt is false on
    #   equality), and the face would be labelled the MIN slot unconditionally --
    #   right only when d_k > 0. For d_k < 0 the whole gradient belongs to the MAX
    #   slot and the jet reported it in the min one with tie = 0. Measured on the
    #   2.10.1 draft: exactly half of all flat-box configurations.
    #   [measured: docs/development/issues/archived/2026-08-10-jet-tie-blind-to-degenerate-slabs.md]
    #
    # ⚠ A SEPARATE per-slab `f64_eq(t1, t2)` guard was written for the second
    # case and then DELETED as dead code: a zero-width slab pins both t_min and
    # t_max to the same value, so it can never fire without this line firing too.
    # Mutation-measured, not argued -- removing the per-slab guard changed
    # nothing, removing this line changed both fixtures.
    # [measured: docs/development/issues/archived/2026-08-10-jet-tie-blind-to-degenerate-slabs.md]
    #
    # Reported rather than relabelled: t is genuinely not two-sided differentiable
    # at either, and for the flat box a central difference averages the two
    # one-sided answers into a number that is neither.
    if (f64_eq(t_min, t_max) == 1) { tie_near = 1; tie_far = 1; }

    # ⛔ 3.3.6 — A READING THAT LOST ITS ORDER IS SETTLED EXACTLY (see "Exact slab
    # ordering" above). Three readings can be wrong on finite input: an exit read +Inf
    # may be a finite crossing whose b - o overflowed (each slab diverts where it reads one
    # whose numerator did; an exit whose quotient alone overflowed is a crossing past
    # DBL_MAX, which +Inf orders right against every finite crossing, so a world box with
    # +-DBL_MAX bounds keeps this arithmetic), an entry read +Inf likewise, and a t_min or
    # t_max that is zero or subnormal may be a crossing that underflowed, whose sign alone
    # survives (an exit at -2^-2074 read -0, which the `< 0` tests below take for t = 0;
    # sent on only when some crossing did underflow, _geo_slab_uf). Each sends the box to
    # _geo_slabs_exact when the twelve inputs are finite; a non-finite input keeps this
    # arithmetic. The common hit path pays one integer compare per crossed slab and one AND
    # and compare here.
    # o = (-2^1023, 0, 0), d = (4, 1, 0) against x [-DBL_MAX, 2^1023], y [1.5 * 2^1022,
    # DBL_MAX] answered 1.5 * 2^1022 on face 2 though x is left at 2^1022, before y is
    # entered; o = 0, d = (2^1000, 1, 0) against x [-1, -2^-1074] answered -0 on face 1
    # for an exit at -2^-2074: both are the miss now. Over 235997 box-ray pairs (two
    # seeds of the slab sweep, with families whose b - o overflows and whose crossings
    # underflow) against an exact rational oracle: 7562 wrong -> right (40 overflow,
    # 5217 underflow, 2305 at random scales), none right -> wrong. 4627 right answers
    # changed bits, all but one at a zero t: 2943 jets of a -0 contact (see "A CONTACT AT
    # t = 0" above) and 1683 ties, faces or zero signs that the exact order settles; the
    # one, t = 2^-1074, lost a tie two subnormal crossings had rounded into. The 8000
    # NaN inputs keep their bits, and of 8000 with an infinity 6 moved, each a -0 jet.
    # _geo_ray_aabb_exact run on every finite pair returns the same t, face and tie.
    # [measured: C336 slab sweep, seeds 11 and 12, exact Fraction oracle, 3.3.5 vs this tree, 2026-10-11; cycc 6.6.14]
    # The contract admits 0 or a positive f64. An overflow in the slab arithmetic
    # can make t infinite from entirely finite inputs, which is not a hit.
    # ⚠ Only +/-Inf. NaN is left to propagate, on purpose -- see the is_inf note by geo_face_axis.
    if (f64_lt(t_min, 0) != 1) {
        var tmn = t_min & 0x7FFF_FFFF_FFFF_FFFF;   # (its bit tests: zero or subnormal, +-Inf)
        if (tmn < 0x0010_0000_0000_0000) {
            if (_geo_aabb_face_exact0(ray, aabb, face_near, tie_near, tmn, out) == 0) {
                if (_geo_ray_aabb_uf(ray, aabb) == 1) {
                    if (_geo_ray_aabb_finite(ray, aabb) == 1) { return _geo_ray_aabb_exact(ray, aabb, out); }
                }
            }
        }
        # (An entry read +Inf whose numerator overflowed had its exit's overflow too -- the
        # exit's bound lies beyond the entry's -- and the slab diverted there; an entry whose
        # quotient alone overflowed is a crossing past DBL_MAX, the miss either way.)
        if (tmn == 0x7FF0_0000_0000_0000) { return 0; }
        if (out != 0) { store64(out, face_near); store64(out + 8, tie_near); }
        return t_min;
    }
    if (f64_lt(t_max, 0) != 1) {
        # Origin inside the box: the answer is the EXIT face, not the entry one.
        var tmx = t_max & 0x7FFF_FFFF_FFFF_FFFF;
        if (tmx < 0x0010_0000_0000_0000) {
            if (_geo_aabb_face_exact0(ray, aabb, face_far, tie_far, tmx, out) == 0) {
                if (_geo_ray_aabb_uf(ray, aabb) == 1) {
                    if (_geo_ray_aabb_finite(ray, aabb) == 1) { return _geo_ray_aabb_exact(ray, aabb, out); }
                }
            }
        }
        if (tmx == 0x7FF0_0000_0000_0000) { return 0; }
        if (out != 0) { store64(out, face_far); store64(out + 8, tie_far); }
        return t_max;
    }
    return 0;
}

# The plain entry point: identical t, no face bookkeeping, out = 0.
public fn geo_ray_aabb(ray, aabb) {
    return geo_ray_aabb_face(ray, aabb, 0);
}

# Ray-triangle intersection (Moller-Trumbore): the t > 0 at which the ray crosses the triangle,
# both faces, or 0 on a miss (a parallel ray, a degenerate triangle, a hit behind the origin, or a
# contact at t = 0); a hit beyond DBL_MAX is +Inf, its rounding, as geo_ray_plane and
# geo_ray_sphere answer it. The direction need not be unit. NaN origin -> NaN; a NaN direction or
# vertex -> the miss (its reciprocal guard).
# ⛔ 3.4.1 — EVERY VERDICT IS CERTIFIED OR EXACT, AT EVERY SCALE (AU2-G2-F1; review RV-GEO M1, M3).
# The verdict (u >= 0, v >= 0, 1 - u - v >= 0, t > 0; a boundary is a hit) is the float
# arithmetic's only where a proven error bound separates each quantity it reads from its threshold;
# anywhere else it is decided from exact determinants (_geo_ray_tri_exact), and t is the float
# one only where the same bound puts it within 2^-33 of itself. Through 3.4.0 a triangle far
# smaller than its distance from the origin was a hit or a miss by o - v0's rounding at any scale,
# and outside 2^-341..2^341 the products flushed or overflowed: a scene at 2^-359 missed, 2^342
# gave +Inf, 2^512 NaN. The paths, cheapest first:
# - Here: 3.4.0's arithmetic, operation for operation (the same bits wherever it is certified),
#   and the bound c (B_X + |X| B_a) / |a| on each quotient X, B_X a product of the inputs' 1-norms
#   (each with 2^-330 added, so that a product that underflowed is inside it). An overflow makes a
#   bound or the value it bounds infinite, and no comparison here certifies an infinite or NaN.
# - _geo_ray_tri_slow: a non-finite input keeps 3.4.0's arithmetic (_geo_ray_tri_plain); otherwise
#   the edges, o - v0 and d each multiplied by the power of two that takes it near 1 and each
#   quotient bounded by the absolute products of its own triple product (16 eps). A verdict it
#   certifies is returned; the quantities it cannot certify go to the exact path, and only those.
# - _geo_ray_tri_exact: the determinants from the vertices, o and d themselves (or their two_sum
#   differences), summed as integers (_geo_xi_*): exact signs over the whole double range, and t
#   from two exact numerators.
# [measured: GEO2 3.4.1 tsw.py families (RV-GEO trisw3, fam_flush, band), Fraction oracle, 2026-10-31]
# Cost: an ordinary ray 90 to 100 ns where 3.4.0 took 104 to 114 (its bench row); the exact path
# 1.06 us for one determinant after the scaled pass and 3.7 us for all five.
# [measured: tests/hisab.bcyr rows ray_triangle, ray_triangle_exact_edge, ray_triangle_exact_dense, GEO2 A/B 2026-10-31]
public fn geo_ray_triangle(ray, tri) {
    var o = GeoRay_origin(ray);
    var dir = GeoRay_direction(ray);
    var p0 = GeoTriangle_v0(tri);
    var p1 = GeoTriangle_v1(tri);
    var p2 = GeoTriangle_v2(tri);
    # (3.4.1: 3.4.0's operations written out. hvec3_dot's packed sum differs from this scalar one
    # only in a zero's sign, and a zero t is never certified here, so the answers are 3.4.0's bits.)
    var v0x = load64(p0);
    var v0y = load64(p0 + 8);
    var v0z = load64(p0 + 16);
    var e1x = f64_sub(load64(p1), v0x);
    var e1y = f64_sub(load64(p1 + 8), v0y);
    var e1z = f64_sub(load64(p1 + 16), v0z);
    var e2x = f64_sub(load64(p2), v0x);
    var e2y = f64_sub(load64(p2 + 8), v0y);
    var e2z = f64_sub(load64(p2 + 16), v0z);
    var sx = f64_sub(load64(o), v0x);
    var sy = f64_sub(load64(o + 8), v0y);
    var sz = f64_sub(load64(o + 16), v0z);
    var dx = load64(dir);
    var dy = load64(dir + 8);
    var dz = load64(dir + 16);
    var hx = f64_sub(f64_mul(dy, e2z), f64_mul(dz, e2y));
    var hy = f64_sub(f64_mul(dz, e2x), f64_mul(dx, e2z));
    var hz = f64_sub(f64_mul(dx, e2y), f64_mul(dy, e2x));
    var a = f64_add(f64_add(f64_mul(e1x, hx), f64_mul(e1y, hy)), f64_mul(e1z, hz));
    # The 1-norms, 2^-330 added (an underflowed product's 2^-1075 is then inside the bound).
    var n1 = f64_add(f64_add(f64_add(e1x & 0x7FFF_FFFF_FFFF_FFFF, e1y & 0x7FFF_FFFF_FFFF_FFFF),
        e1z & 0x7FFF_FFFF_FFFF_FFFF), 0x2B50_0000_0000_0000);
    var n2 = f64_add(f64_add(f64_add(e2x & 0x7FFF_FFFF_FFFF_FFFF, e2y & 0x7FFF_FFFF_FFFF_FFFF),
        e2z & 0x7FFF_FFFF_FFFF_FFFF), 0x2B50_0000_0000_0000);
    var ns = f64_add(f64_add(f64_add(sx & 0x7FFF_FFFF_FFFF_FFFF, sy & 0x7FFF_FFFF_FFFF_FFFF),
        sz & 0x7FFF_FFFF_FFFF_FFFF), 0x2B50_0000_0000_0000);
    var nd = f64_add(f64_add(f64_add(dx & 0x7FFF_FFFF_FFFF_FFFF, dy & 0x7FFF_FFFF_FFFF_FFFF),
        dz & 0x7FFF_FFFF_FFFF_FFFF), 0x2B50_0000_0000_0000);
    var dn = f64_mul(nd, n2);
    var ba = f64_mul(n1, dn);
    # a certified: |a| over 8 c B_a (c = 2^-49 bounds each numerator's rounding by c B), which also
    # refuses a zero, NaN or overflowed a and an infinite bound.
    if (f64_gt(f64_abs(a), f64_mul(ba, 0x3D10_0000_0000_0000)) == 0) { return _geo_ray_tri_slow(ray, tri); }
    var f = f64_div(F64_ONE, a);
    var g = f64_mul(f64_abs(f), 0x3CF0_0000_0000_0000);   # 2^-48 |1/a| >= 8/7 c (1 + 2^-52) / |a|
    var bu = f64_mul(ns, dn);
    var u = f64_mul(f, f64_add(f64_add(f64_mul(sx, hx), f64_mul(sy, hy)), f64_mul(sz, hz)));
    if (f64_lt(u, 0) == 1) {
        # (g B_a < 1/4 here, so |u| > 1.5 g B_u leaves |u| (1 - g B_a - 2^-51) above g B_u.)
        if (f64_gt(f64_neg(u), f64_mul(f64_mul(g, bu), 0x3FF8_0000_0000_0000)) == 1) { return 0; }
        return _geo_ray_tri_slow(ray, tri);
    }
    var x = f64_mul(g, ba);
    if (f64_gt(u, F64_ONE) == 1) {
        if (f64_gt(f64_sub(u, F64_ONE), f64_add(f64_mul(g, bu), f64_mul(f64_add(x, 0x3CC0_0000_0000_0000), u))) == 1) {
            return 0;
        }
        return _geo_ray_tri_slow(ray, tri);
    }
    var qx = f64_sub(f64_mul(sy, e1z), f64_mul(sz, e1y));
    var qy = f64_sub(f64_mul(sz, e1x), f64_mul(sx, e1z));
    var qz = f64_sub(f64_mul(sx, e1y), f64_mul(sy, e1x));
    var sn = f64_mul(ns, n1);
    var bv = f64_mul(nd, sn);
    var v = f64_mul(f, f64_add(f64_add(f64_mul(dx, qx), f64_mul(dy, qy)), f64_mul(dz, qz)));
    if (f64_lt(v, 0) == 1) {
        if (f64_gt(f64_neg(v), f64_mul(f64_mul(g, bv), 0x3FF8_0000_0000_0000)) == 1) { return 0; }
        return _geo_ray_tri_slow(ray, tri);
    }
    var sw = f64_add(u, v);
    if (f64_gt(sw, F64_ONE) == 1) {
        var ew = f64_add(f64_mul(g, f64_add(bu, bv)), f64_mul(f64_add(x, 0x3CD0_0000_0000_0000), sw));
        if (f64_gt(f64_sub(sw, F64_ONE), ew) == 1) { return 0; }
        return _geo_ray_tri_slow(ray, tri);
    }
    var nt = f64_add(f64_add(f64_mul(e2x, qx), f64_mul(e2y, qy)), f64_mul(e2z, qz));
    var t = f64_mul(f, nt);
    var gt = f64_mul(g, f64_mul(n2, sn));
    if (f64_lt(t, 0) == 1) {
        if (f64_gt(f64_neg(t), f64_mul(gt, 0x3FF8_0000_0000_0000)) == 1) { return 0; }
        return _geo_ray_tri_slow(ray, tri);
    }
    # A hit: u, v and 1 - u - v above their bounds (u, v <= 1 here), and t within 2^-33 of itself.
    var eu = f64_add(f64_add(f64_mul(g, bu), x), 0x3CC0_0000_0000_0000);
    var ev = f64_add(f64_add(f64_mul(g, bv), x), 0x3CC0_0000_0000_0000);
    if (f64_gt(u, eu) == 0) { return _geo_ray_tri_slow(ray, tri); }
    if (f64_gt(v, ev) == 0) { return _geo_ray_tri_slow(ray, tri); }
    if (f64_gt(f64_sub(F64_ONE, sw), f64_add(f64_add(eu, ev), 0x3CC0_0000_0000_0000)) == 0) {
        return _geo_ray_tri_slow(ray, tri);
    }
    # (2^-1000 more: a t below 2^-967, whose rounding to a subnormal is absolute, is not taken here.)
    if (f64_lt(f64_add(f64_add(gt, f64_mul(x, t)), 0x0170_0000_0000_0000), f64_mul(t, 0x3DE0_0000_0000_0000)) == 0) {
        return _geo_ray_tri_slow(ray, tri);
    }
    return t;
}

# 1 when every component of the HVec3 is finite.
fn _geo_hvec3_finite(v) {
    if (_geo_absmax_bits(v) < 0x7FF0_0000_0000_0000) { return 1; }
    return 0;
}

# 1 when every one of the six terms of x . (y x z) has a zero factor: the triple product is then
# exactly 0, whatever the other factors' magnitudes (3.4.1).
fn _geo_tri_struct_zero(x, y, z) {
    for (var i = 0; i < 3; i = i + 1) {
        var j = (i + 1) % 3;
        var k = (i + 2) % 3;
        if (f64_eq(load64(x + i * 8), 0) == 0) {
            if (f64_eq(load64(y + j * 8), 0) == 0 && f64_eq(load64(z + k * 8), 0) == 0) { return 0; }
            if (f64_eq(load64(y + k * 8), 0) == 0 && f64_eq(load64(z + j * 8), 0) == 0) { return 0; }
        }
    }
    return 1;
}

# geo_ray_triangle where its float bound did not certify (3.4.1). A non-finite input keeps 3.4.0's
# arithmetic (_geo_ray_tri_plain: the same bits). An edge or o - v0 that overflowed from finite
# input is formed again from halved points (t halves with them). Then the edges are multiplied by
# 2^P, o - v0 by 2^R and d by 2^M, each power taking its vector's largest component near 1 (P = R
# when the edges and o - v0 lie within 2^250 of each other, so that u and v are the band's own
# bits), and Moller-Trumbore runs there: u' = u 2^(R - P), v' likewise, t' = t 2^(R - M). Each
# numerator's rounding is bounded by 16 eps times its sum of absolute products (the rounded inputs'
# eps included), each quotient's by _geo_tri_err. A quantity whose sign that bound fixes on the
# wrong side of its threshold is the miss; when every one is fixed on the right side and t is
# within 2^-33 of itself (and, below 2^-1021, within 2^-1076 absolute), the hit; otherwise
# _geo_ray_tri_exact decides the quantities that are not fixed, and only those.
fn _geo_ray_tri_slow(ray, tri) {
    var o = GeoRay_origin(ray);
    var dir = GeoRay_direction(ray);
    var v0 = GeoTriangle_v0(tri);
    var v1 = GeoTriangle_v1(tri);
    var v2 = GeoTriangle_v2(tri);
    var e1: i64[3];
    var e2: i64[3];
    var sv: i64[3];
    for (var i = 0; i < 3; i = i + 1) {
        store64(&e1 + i * 8, f64_sub(load64(v1 + i * 8), load64(v0 + i * 8)));
        store64(&e2 + i * 8, f64_sub(load64(v2 + i * 8), load64(v0 + i * 8)));
        store64(&sv + i * 8, f64_sub(load64(o + i * 8), load64(v0 + i * 8)));
    }
    if ((_geo_hvec3_finite(o) & _geo_hvec3_finite(dir) & _geo_hvec3_finite(v0) & _geo_hvec3_finite(v1) &
        _geo_hvec3_finite(v2)) == 0) {
        return _geo_ray_tri_plain(dir, &e1, &e2, &sv);
    }
    # A zero edge, d = 0 or o = v0 (exactly: a difference that rounds to 0 is exact) is 3.4.0's
    # miss or contact at t = 0, and a parallel ray whose a has a zero factor in each term is the miss.
    if (_geo_absmax_bits(&e1) == 0 || _geo_absmax_bits(&e2) == 0 || _geo_absmax_bits(&sv) == 0 ||
      _geo_absmax_bits(dir) == 0) {
        return _geo_ray_tri_plain(dir, &e1, &e2, &sv);
    }
    if (_geo_tri_struct_zero(&e1, dir, &e2) == 1) { return 0; }
    var hp = 0;
    if ((_geo_hvec3_finite(&e1) & _geo_hvec3_finite(&e2) & _geo_hvec3_finite(&sv)) == 0) {
        for (var i2 = 0; i2 < 3; i2 = i2 + 1) {
            var w0 = f64_mul(load64(v0 + i2 * 8), F64_HALF);
            store64(&e1 + i2 * 8, f64_sub(f64_mul(load64(v1 + i2 * 8), F64_HALF), w0));
            store64(&e2 + i2 * 8, f64_sub(f64_mul(load64(v2 + i2 * 8), F64_HALF), w0));
            store64(&sv + i2 * 8, f64_sub(f64_mul(load64(o + i2 * 8), F64_HALF), w0));
        }
        hp = 1;
    }
    var m1 = _geo_absmax_bits(&e1);
    var mm2 = _geo_absmax_bits(&e2);
    var ms = _geo_absmax_bits(&sv);
    var md = _geo_absmax_bits(dir);
    # (Halving drops a subnormal last bit, which may have been a whole edge: decided exactly.)
    if (m1 == 0 || mm2 == 0 || ms == 0) { return _geo_ray_tri_exact(ray, tri, 31, 0, 0); }
    if (mm2 > m1) { m1 = mm2; }
    var ee = m1 >> 52;
    var es = ms >> 52;
    var sp = _geo_scale_for(ee);
    var sr = _geo_scale_for(es);
    if (ee - es <= 250 && es - ee <= 250) {
        if (es > ee) { sp = sr; } else { sr = sp; }
    }
    var sm = _geo_scale_for(md >> 52);
    var d: i64[3];
    for (var k = 0; k < 3; k = k + 1) {
        store64(&e1 + k * 8, f64_mul(load64(&e1 + k * 8), sp));
        store64(&e2 + k * 8, f64_mul(load64(&e2 + k * 8), sp));
        store64(&sv + k * 8, f64_mul(load64(&sv + k * 8), sr));
        store64(&d + k * 8, f64_mul(load64(dir + k * 8), sm));
    }
    var h: i64[3];
    var q: i64[3];
    var ph: i64[3];
    var pq: i64[3];
    _geo_cross_into(&d, &e2, &h);
    _geo_cross_into(&sv, &e1, &q);
    _geo_perm_into(&d, &e2, &ph);
    _geo_perm_into(&sv, &e1, &pq);
    var a = hvec3_dot(&e1, &h);
    var ba = _geo_tri_bound(&e1, &ph);
    if (f64_gt(f64_abs(a), f64_mul(ba, _GEO_F64_FOUR)) == 0) { return _geo_ray_tri_exact(ray, tri, 31, 0, 0); }
    var f = f64_div(F64_ONE, a);
    if (f64_lt(f64_abs(f), _GEO_F64_POS_INF) == 0) { return _geo_ray_tri_exact(ray, tri, 31, 0, 0); }
    var sa = 1;
    if (f64_lt(a, 0) == 1) { sa = 0 - 1; }
    var ra = f64_abs(f64_mul(ba, f));   # B_a / |a|, below 1/4
    var us = f64_mul(f, hvec3_dot(&sv, &h));
    var eu = _geo_tri_err(us, _geo_tri_bound(&sv, &ph), f, ra);
    var vs = f64_mul(f, hvec3_dot(&d, &q));
    var ev = _geo_tri_err(vs, _geo_tri_bound(&d, &pq), f, ra);
    var one = _geo_ldexp(F64_ONE, (sr >> 52) - (sp >> 52));   # 2^(R - P): u = 1 there
    var ws = f64_sub(f64_sub(one, us), vs);
    var ew = f64_add(f64_add(f64_add(eu, ev), f64_mul(f64_add(f64_add(one, f64_abs(us)), f64_abs(vs)),
          0x3CC0_0000_0000_0000)), 0x1000);   # (and 2^-1062 for one's rounding if subnormal)
    var ts = f64_mul(f, hvec3_dot(&e2, &q));
    var et = _geo_tri_err(ts, _geo_tri_bound(&e2, &pq), f, ra);
    # A quantity fixed below its threshold is the miss, whatever the others.
    if (f64_lt(us, 0) == 1 && f64_gt(f64_abs(us), eu) == 1) { return 0; }
    if (f64_lt(vs, 0) == 1 && f64_gt(f64_abs(vs), ev) == 1) { return 0; }
    if (f64_lt(ws, 0) == 1 && f64_gt(f64_abs(ws), ew) == 1) { return 0; }
    if (f64_lt(ts, 0) == 1 && f64_gt(f64_abs(ts), et) == 1) { return 0; }
    var need = 0;
    if (f64_gt(f64_abs(us), eu) == 0) { need = need | 2; }
    if (f64_gt(f64_abs(vs), ev) == 0) { need = need | 4; }
    if (f64_gt(f64_abs(ws), ew) == 0) { need = need | 8; }
    if (f64_lt(et, f64_mul(f64_abs(ts), 0x3DE0_0000_0000_0000)) == 0) { need = need | 16; }
    var sh = (sm >> 52) - (sr >> 52) + hp;   # M - R, and 1 for the halving
    var t = _geo_ldexp(ts, sh);
    # (Below 2^-1021 the answer is good to 2^-1074 only if the bound is under 2^-1076 there.)
    if ((t & 0x7FFF_FFFF_FFFF_FFFF) < 0x0020_0000_0000_0000) {
        if (f64_lt(_geo_ldexp(et, sh + 1076), F64_ONE) == 0) { need = need | 16; }
    }
    if (need == 0) { return t; }
    return _geo_ray_tri_exact(ray, tri, need, sa, t);
}

# |a_j b_k| + |a_k b_j| per component into out: the absolute products of a x b (3.4.1).
fn _geo_perm_into(a, b, out) {
    for (var i = 0; i < 3; i = i + 1) {
        var j = (i + 1) % 3;
        var k = (i + 2) % 3;
        store64(out + i * 8, f64_add(f64_abs(f64_mul(load64(a + j * 8), load64(b + k * 8))),
            f64_abs(f64_mul(load64(a + k * 8), load64(b + j * 8)))));
    }
    return 0;
}

# 16 eps sum |x_i| p_i: a bound on the rounding of x . (a cross product with absolute products p),
# the rounded differences' own eps included (3.4.1; the analysis gives 9 eps), plus 2^-1062 for
# the products that left the normal range (each off by at most 2^-1075 there, a few dozen in all).
fn _geo_tri_bound(x, p) {
    var s = f64_add(f64_add(f64_mul(f64_abs(HVec3_x(x)), HVec3_x(p)), f64_mul(f64_abs(HVec3_y(x)), HVec3_y(p))),
      f64_mul(f64_abs(HVec3_z(x)), HVec3_z(p)));
    return f64_add(f64_mul(s, 0x3CF0_0000_0000_0000), 0x1000);   # 2^-48 = 16 eps; 2^-1062
}

# A bound on |q - N/a| for the computed q = RN(RN(1/a) N), given the numerator's bound b, f = RN(1/a)
# and ra = B_a / |a| <= 1/4: 4 eps |q| for the two roundings and 2 (b + |q| B_a) / |a| for the inputs.
fn _geo_tri_err(q, b, f, ra) {
    var aq = f64_abs(q);
    return f64_add(f64_mul(aq, 0x3CD0_0000_0000_0000),
      f64_mul(F64_TWO, f64_add(f64_abs(f64_mul(b, f)), f64_mul(aq, ra))));
}

# Moller-Trumbore's verdict and t from exact determinants (3.4.1), for the quantities `need` names
# (1 the sign of a, 2 u, 4 v, 8 w = 1 - u - v, 16 t: its sign and value); the others are taken as
# certified, with sa the sign of a when bit 1 is clear and tf the answer when bit 16 is. With
# E1 = v1 - v0, E2 = v2 - v0, S = o - v0, P1 = v1 - o and P2 = v2 - o:
#   a = -d . (E1 x E2),  u a = d . (E2 x S),  v a = d . (S x E1),  w a = d . (P2 x P1),
#   t a = S . (E1 x E2),
# each a sum of products of three doubles accumulated as an integer (_geo_xi_add3): its sign is
# exact for every finite input. A difference that two_sum shows to be exact (or exact but for one
# vector's second word) is used as it is, six products a vector pair; otherwise the determinant is
# expanded in the points themselves (_geo_xi_cdot3: 18 products, 24 for t a), which no rounding
# reaches. A hit has u a, v a, w a of a's sign or zero and t a of a's sign; t is the quotient of the
# two exact numerators, each correctly rounded (_geo_xi_mag).
fn _geo_ray_tri_exact(ray, tri, need, sa, tf) {
    var r: i64[45];
    _geo_xi_vec(GeoRay_origin(ray), &r);
    _geo_xi_vec(GeoRay_direction(ray), &r + 72);
    _geo_xi_vec(GeoTriangle_v0(tri), &r + 144);
    _geo_xi_vec(GeoTriangle_v1(tri), &r + 216);
    _geo_xi_vec(GeoTriangle_v2(tri), &r + 288);
    var o = &r;
    var d = &r + 72;
    var p0 = &r + 144;
    var p1 = &r + 216;
    var p2 = &r + 288;
    # Differences as two words: hi at word 0, lo at word 9, and word 18 the count of non-zero lo
    # parts (-1 when the difference overflows).
    var de1: i64[19];
    var de2: i64[19];
    var dsv: i64[19];
    _geo_xi_dvec(GeoTriangle_v1(tri), GeoTriangle_v0(tri), &de1);
    _geo_xi_dvec(GeoTriangle_v2(tri), GeoTriangle_v0(tri), &de2);
    _geo_xi_dvec(GeoRay_origin(ray), GeoTriangle_v0(tri), &dsv);
    var ac: i64[208];
    var bc: i64[208];
    var have = 0;
    if ((need & 1) != 0) {
        _geo_xi_init(&ac);
        if (_geo_xi_det2(&ac, d, &de1, &de2) == 0) { _geo_xi_cdot3(&ac, d, p1, p2, p0); }
        sa = 0 - _geo_xi_norm(&ac);
        if (sa == 0) { return 0; }
        have = 1;
    }
    if ((need & 2) != 0) {
        _geo_xi_init(&bc);
        if (_geo_xi_det2(&bc, d, &de2, &dsv) == 0) { _geo_xi_cdot3(&bc, d, p2, o, p0); }
        if (_geo_xi_norm(&bc) * sa < 0) { return 0; }
    }
    if ((need & 4) != 0) {
        _geo_xi_init(&bc);
        if (_geo_xi_det2(&bc, d, &dsv, &de1) == 0) { _geo_xi_cdot3(&bc, d, o, p1, p0); }
        if (_geo_xi_norm(&bc) * sa < 0) { return 0; }
    }
    if ((need & 8) != 0) {
        var dp2: i64[19];
        var dp1: i64[19];
        _geo_xi_dvec(GeoTriangle_v2(tri), GeoRay_origin(ray), &dp2);
        _geo_xi_dvec(GeoTriangle_v1(tri), GeoRay_origin(ray), &dp1);
        _geo_xi_init(&bc);
        if (_geo_xi_det2(&bc, d, &dp2, &dp1) == 0) { _geo_xi_cdot3(&bc, d, p2, p1, o); }
        if (_geo_xi_norm(&bc) * sa < 0) { return 0; }
    }
    if ((need & 16) == 0) { return tf; }
    _geo_xi_init(&bc);
    var ks = load64(&dsv + 144);
    var k1 = load64(&de1 + 144);
    var k2 = load64(&de2 + 144);
    if (ks >= 0 && k1 >= 0 && k2 >= 0 && (ks > 0) + (k1 > 0) + (k2 > 0) <= 1) {
        _geo_xi_cdot(&bc, &dsv, &de1, &de2, 0);
        if (ks > 0) { _geo_xi_cdot(&bc, &dsv + 72, &de1, &de2, 0); }
        if (k1 > 0) { _geo_xi_cdot(&bc, &dsv, &de1 + 72, &de2, 0); }
        if (k2 > 0) { _geo_xi_cdot(&bc, &dsv, &de1, &de2 + 72, 0); }
    } else {
        _geo_xi_cdot3(&bc, o, p1, p2, p0);
        _geo_xi_cdot(&bc, p0, p1, p2, 1);
    }
    if (_geo_xi_norm(&bc) * sa <= 0) { return 0; }
    if (have == 0) {
        _geo_xi_init(&ac);
        if (_geo_xi_det2(&ac, d, &de1, &de2) == 0) { _geo_xi_cdot3(&ac, d, p1, p2, p0); }
        _geo_xi_norm(&ac);
    }
    var mt: i64[2];
    var ma: i64[2];
    _geo_xi_mag(&bc, &mt);
    _geo_xi_mag(&ac, &ma);
    return _geo_ldexp(f64_div(load64(&mt), load64(&ma)), load64(&mt + 8) - load64(&ma + 8));
}

# p - q as two words per component, exactly (two_sum), as records (_geo_xi_vec) into r: the
# rounded difference at word 0, its error at word 9, and at word 18 the number of non-zero errors,
# or -1 when a difference overflowed (3.4.1).
fn _geo_xi_dvec(p, q, r) {
    var hv: i64[3];
    var lv: i64[3];
    var k = 0;
    for (var i = 0; i < 3; i = i + 1) {
        var x = load64(p + i * 8);
        var y = f64_neg(load64(q + i * 8));
        var s = f64_add(x, y);
        var bb = f64_sub(s, x);
        var er = f64_add(f64_sub(x, f64_sub(s, bb)), f64_sub(y, bb));
        if ((s & 0x7FF0_0000_0000_0000) == 0x7FF0_0000_0000_0000) { k = 0 - 100; }
        if (f64_eq(er, 0) == 0) { k = k + 1; }
        store64(&hv + i * 8, s);
        store64(&lv + i * 8, er);
    }
    _geo_xi_vec(&hv, r);
    _geo_xi_vec(&lv, r + 72);
    if (k < 0) { k = 0 - 1; }
    store64(r + 144, k);
    return 0;
}

# x . (y x z) for a single-word x and two-word differences y, z (_geo_xi_dvec), added to the sum when
# at most one of y, z has a second word (six products, or twelve); 0, adding nothing, otherwise.
fn _geo_xi_det2(acc, x, y, z) {
    var ky = load64(y + 144);
    var kz = load64(z + 144);
    if (ky < 0 || kz < 0) { return 0; }
    if (ky > 0 && kz > 0) { return 0; }
    _geo_xi_cdot(acc, x, y, z, 0);
    if (ky > 0) { _geo_xi_cdot(acc, x, y + 72, z, 0); }
    if (kz > 0) { _geo_xi_cdot(acc, x, y, z + 72, 0); }
    return 1;
}

# x . ((y - w) x (z - w)) = x . (y x z + z x w + w x y) from the points (18 products).
fn _geo_xi_cdot3(acc, x, y, z, w) {
    _geo_xi_cdot(acc, x, y, z, 0);
    _geo_xi_cdot(acc, x, z, w, 0);
    _geo_xi_cdot(acc, x, w, y, 0);
    return 0;
}

# 3.4.0's Moller-Trumbore on the formed e1, e2 and sv, for a non-finite input (_geo_ray_tri_slow).
fn _geo_ray_tri_plain(dir, e1, e2, sv) {
    var h: i64[3];
    var q: i64[3];
    _geo_cross_into(dir, e2, &h);
    var f = f64_div(F64_ONE, hvec3_dot(e1, &h));
    if (f64_lt(f64_abs(f), _GEO_F64_POS_INF) == 0) { return 0; }
    var u = f64_mul(f, hvec3_dot(sv, &h));
    if (f64_lt(u, 0) == 1) { return 0; }
    if (f64_gt(u, F64_ONE) == 1) { return 0; }
    _geo_cross_into(sv, e1, &q);
    var v = f64_mul(f, hvec3_dot(dir, &q));
    if (f64_lt(v, 0) == 1) { return 0; }
    if (f64_gt(f64_add(u, v), F64_ONE) == 1) { return 0; }
    var t = f64_mul(f, hvec3_dot(e2, &q));
    if (f64_lt(t, 0) == 1) { return 0; }
    return t;
}

# ================================================================
# Exact integer sums of products (3.4.1)
# ================================================================
# Every finite double is (-1)^s m 2^q with m < 2^53 an integer and q in [-1074, 971], so a product
# of two is an integer below 2^106 times 2^q, q >= -2148, and of three below 2^159 times 2^q, q in
# [-3222, 2913]. A sum of such products is held exactly as an integer in units of 2^-3222, in
# 32-bit limbs each kept in an i64 word whose carries wait for _geo_xi_norm (a word takes 2^30
# limbs added or subtracted before it can overflow; no caller adds more than a few hundred). So
# every bit of every term is kept and no magnitude is out of range: the sign is exact for every
# finite input. The buffer is 208 words: word 0 holds the lowest limb in use, word 1 one past the
# highest, word 2 the top carry after _geo_xi_norm, and word 3 + k limb k, the bits from 32 k up
# above 2^-3222 (a term reaches limb 197 at most; the next takes the carries). The barycentric thin
# path's dot products of two-word cross products (_geo_xw_dot) pass records whose exponents carry
# 2^_GEO_XW_BIAS more each and use 288 words (see "Exact sums" below).

# An empty sum.
fn _geo_xi_init(acc) {
    store64(acc, 1000);
    store64(acc + 8, 0);
    store64(acc + 16, 0);
    return 0;
}

# The three components of v as (m, q, s) records at r (nine words): v_i = (-1)^s m 2^q exactly.
fn _geo_xi_vec(v, r) {
    for (var i = 0; i < 3; i = i + 1) {
        var x = load64(v + i * 8);
        var e = (x >> 52) & 0x7FF;
        var m = x & 0x000F_FFFF_FFFF_FFFF;
        if (e == 0) { e = 1; } else { m = m | 0x0010_0000_0000_0000; }
        store64(r + i * 24, m);
        store64(r + i * 24 + 8, e - 1075);
        store64(r + i * 24 + 16, x >> 63);
    }
    return 0;
}

# The product of the three records at ra, rb, rc added to the sum (subtracted when neg is 1): the
# integer m_a m_b m_c (below 2^159: words t0, t1, t2, unsigned) at bit p = q_a + q_b + q_c + 3222,
# shifted into six 32-bit limbs from limb p / 32. Limbs below or above the range in use are zeroed
# as the range grows (one more above, for the carries).
fn _geo_xi_add3(acc, ra, rb, rc, neg) {
    var ma = load64(ra);
    var mb = load64(rb);
    var mc = load64(rc);
    if (ma == 0 || mb == 0 || mc == 0) { return 0; }
    var lo = ma * mb;
    var hi = mulh64(ma, mb);
    var t1a = hi * mc;
    var t1 = mulh64(lo, mc) + t1a;
    var t2 = mulh64(hi, mc);
    if ((t1 ^ 0x8000_0000_0000_0000) < (t1a ^ 0x8000_0000_0000_0000)) { t2 = t2 + 1; }   # (unsigned carry)
    var t0 = lo * mc;
    var p = load64(ra + 8) + load64(rb + 8) + load64(rc + 8) + 3222;
    var b = p & 31;
    var l = p >> 5;
    var bot = load64(acc);
    var top = load64(acc + 8);
    if (bot >= top) {
        bot = l;
        top = l;
    }
    while (l < bot) {
        bot = bot - 1;
        store64(acc + 24 + bot * 8, 0);
    }
    while (top < l + 7) {
        store64(acc + 24 + top * 8, 0);
        top = top + 1;
    }
    store64(acc, bot);
    store64(acc + 8, top);
    var c = 63 - b;
    var s0 = t0 << b;
    var s1 = (t1 << b) | ((t0 >> 1) >> c);
    var s2 = (t2 << b) | ((t1 >> 1) >> c);
    var q = acc + 24 + l * 8;
    if ((load64(ra + 16) ^ load64(rb + 16) ^ load64(rc + 16) ^ neg) == 0) {
        store64(q, load64(q) + (s0 & 0xFFFF_FFFF));
        store64(q + 8, load64(q + 8) + (s0 >> 32));
        store64(q + 16, load64(q + 16) + (s1 & 0xFFFF_FFFF));
        store64(q + 24, load64(q + 24) + (s1 >> 32));
        store64(q + 32, load64(q + 32) + (s2 & 0xFFFF_FFFF));
        store64(q + 40, load64(q + 40) + (s2 >> 32));
    } else {
        store64(q, load64(q) - (s0 & 0xFFFF_FFFF));
        store64(q + 8, load64(q + 8) - (s0 >> 32));
        store64(q + 16, load64(q + 16) - (s1 & 0xFFFF_FFFF));
        store64(q + 24, load64(q + 24) - (s1 >> 32));
        store64(q + 32, load64(q + 32) - (s2 & 0xFFFF_FFFF));
        store64(q + 40, load64(q + 40) - (s2 >> 32));
    }
    return 0;
}

# The product of the two records at ra, rb added to the sum (subtracted when neg is 1): the integer
# m_a m_b (below 2^106) at bit q_a + q_b + 3222, as _geo_xi_add3 inserts a product of three.
fn _geo_xi_add2(acc, ra, rb, neg) {
    var ma = load64(ra);
    var mb = load64(rb);
    if (ma == 0 || mb == 0) { return 0; }
    var t0 = ma * mb;
    var t1 = mulh64(ma, mb);
    var p = load64(ra + 8) + load64(rb + 8) + 3222;
    var b = p & 31;
    var l = p >> 5;
    var bot = load64(acc);
    var top = load64(acc + 8);
    if (bot >= top) {
        bot = l;
        top = l;
    }
    while (l < bot) {
        bot = bot - 1;
        store64(acc + 24 + bot * 8, 0);
    }
    while (top < l + 7) {
        store64(acc + 24 + top * 8, 0);
        top = top + 1;
    }
    store64(acc, bot);
    store64(acc + 8, top);
    var c = 63 - b;
    var s0 = t0 << b;
    var s1 = (t1 << b) | ((t0 >> 1) >> c);
    var s2 = (t1 >> 1) >> c;
    var q = acc + 24 + l * 8;
    if ((load64(ra + 16) ^ load64(rb + 16) ^ neg) == 0) {
        store64(q, load64(q) + (s0 & 0xFFFF_FFFF));
        store64(q + 8, load64(q + 8) + (s0 >> 32));
        store64(q + 16, load64(q + 16) + (s1 & 0xFFFF_FFFF));
        store64(q + 24, load64(q + 24) + (s1 >> 32));
        store64(q + 32, load64(q + 32) + s2);
    } else {
        store64(q, load64(q) - (s0 & 0xFFFF_FFFF));
        store64(q + 8, load64(q + 8) - (s0 >> 32));
        store64(q + 16, load64(q + 16) - (s1 & 0xFFFF_FFFF));
        store64(q + 24, load64(q + 24) - (s1 >> 32));
        store64(q + 32, load64(q + 32) - s2);
    }
    return 0;
}

# w . (p x q) added to the sum (negated when neg is 1): six products of three, w, p and q
# three-record vectors (_geo_xi_vec).
fn _geo_xi_cdot(acc, w, p, q, neg) {
    var m = neg ^ 1;
    _geo_xi_add3(acc, w, p + 24, q + 48, neg);
    _geo_xi_add3(acc, w, p + 48, q + 24, m);
    _geo_xi_add3(acc, w + 24, p + 48, q, neg);
    _geo_xi_add3(acc, w + 24, p, q + 48, m);
    _geo_xi_add3(acc, w + 48, p, q + 24, neg);
    _geo_xi_add3(acc, w + 48, p + 24, q, m);
    return 0;
}

# Carries the limbs into 0 .. 2^32 - 1 and returns the sum's sign, -1, 0 or 1 (exact).
fn _geo_xi_norm(acc) {
    var lo = load64(acc);
    var hi = load64(acc + 8);
    var c = 0;
    var nz = 0;
    for (var k = lo; k < hi; k = k + 1) {
        var q = acc + 24 + k * 8;
        var v = load64(q) + c;
        var l = v & 0xFFFF_FFFF;
        store64(q, l);
        nz = nz | l;
        c = v >>> 32;
    }
    store64(acc + 16, c);
    if (c < 0) { return 0 - 1; }
    if (nz != 0) { return 1; }
    return 0;
}

# |sum| correctly rounded to 53 bits, as out[0] 2^out[1] with out[0] an integer in [2^52, 2^53)
# held as a double, or (0, 0) for a zero sum (3.4.1). After _geo_xi_norm; a negative sum is negated
# in place first. The 64 bits below the top one are taken from the three highest limbs, the rest
# kept as a sticky bit, and rounded to nearest, ties to even.
fn _geo_xi_mag(acc, out) {
    var lo = load64(acc);
    var hi = load64(acc + 8);
    store64(out, 0);
    store64(out + 8, 0);
    if (load64(acc + 16) < 0) {
        var c = 0;
        for (var k = lo; k < hi; k = k + 1) {
            var q = acc + 24 + k * 8;
            var v = c - load64(q);
            store64(q, v & 0xFFFF_FFFF);
            c = v >>> 32;
        }
        store64(acc + 16, 0);
    }
    var top = hi - 1;
    while (top >= lo && load64(acc + 24 + top * 8) == 0) { top = top - 1; }
    if (top < lo) { return 0; }
    var l0 = load64(acc + 24 + top * 8);
    var l1 = 0;
    var l2 = 0;
    if (top - 1 >= lo) { l1 = load64(acc + 24 + (top - 1) * 8); }
    if (top - 2 >= lo) { l2 = load64(acc + 24 + (top - 2) * 8); }
    var st = 0;
    for (var j = lo; j < top - 2; j = j + 1) { st = st | load64(acc + 24 + j * 8); }
    var bl = ((f64_from(l0) >> 52) & 0x7FF) - 1022;   # bits in the top limb, 1 .. 32
    var w = (l0 << (64 - bl)) | (l1 << (32 - bl)) | (l2 >> bl);
    st = st | (l2 & ((1 << bl) - 1)) | (w & 0x3FF);
    var m = w >> 11;
    var e = 11 + bl + 32 * (top - 2) - 3222;
    if (((w >> 10) & 1) == 1) {
        if (st != 0 || (m & 1) == 1) { m = m + 1; }
        if (m == 0x0020_0000_0000_0000) {
            m = 0x0010_0000_0000_0000;
            e = e + 1;
        }
    }
    store64(out, f64_from(m));
    store64(out + 8, e);
    return 0;
}

# a x b into out, hvec3_cross's operations in its order (3.4.0: no allocation).
fn _geo_cross_into(a, b, out) {
    store64(out, f64_sub(f64_mul(HVec3_y(a), HVec3_z(b)), f64_mul(HVec3_z(a), HVec3_y(b))));
    store64(out + 8, f64_sub(f64_mul(HVec3_z(a), HVec3_x(b)), f64_mul(HVec3_x(a), HVec3_z(b))));
    store64(out + 16, f64_sub(f64_mul(HVec3_x(a), HVec3_y(b)), f64_mul(HVec3_y(a), HVec3_x(b))));
    return 0;
}

# Fills `s` with geo_ray_obb_face's three slabs for _geo_slabs_exact, in the box's frame:
# the crossings (e_k - he_k) / f_k and (e_k + he_k) / f_k, with e_k = a_k . (c - o) and
# f_k = a_k . d formed exactly as the slab code forms them. 1 when all nine of e, f and
# he are finite, else 0 and the slab code's answer stands (an e that overflowed, or the
# 0 * Inf NaN of the header: no contract specifies that answer). axes is the caller's three
# (3.4.1): forming them again here was three more rotations, each refusable, and a refusal
# read as "not finite", so the slab code's unordered answer stood.
# The OBB's three axes as geo_obb_axes forms them (3.4.0): each unit vector rotated by
# hquat_rotate_vec3, the same call, so the same bits, but the unit vectors on the stack (buf, nine
# words) and the three pointers to ptrs instead of a 24-byte array: four allocations fewer than
# geo_obb_axes, none of them to be refused. 0 when a rotation's own allocation was refused.
fn _geo_obb_axes_into(obb, buf, ptrs) {
    var q = GeoObb_rotation(obb);
    for (var k = 0; k < 3; k = k + 1) {
        var v = buf + k * 24;
        store64(v, 0);
        store64(v + 8, 0);
        store64(v + 16, 0);
        store64(v + k * 8, F64_ONE);
        var w = hquat_rotate_vec3(q, v);
        if (w == 0) { return 0; }
        store64(ptrs + k * 8, w);
    }
    return 1;
}

fn _geo_ray_obb_slabs(ray, obb, axes, s) {
    var dt: i64[3];
    var d = _geo_sub_to(&dt, GeoObb_center(obb), GeoRay_origin(ray));
    var he = GeoObb_half_extents(obb);
    for (var k = 0; k < 3; k = k + 1) {
        var ax = load64(axes + k * 8);
        var h = HVec3_x(he);
        if (k == 1) { h = HVec3_y(he); }
        if (k == 2) { h = HVec3_z(he); }
        var e = hvec3_dot(ax, d);
        var f = hvec3_dot(ax, GeoRay_direction(ray));
        if (f64_lt(f64_abs(e), _GEO_F64_POS_INF) == 0) { return 0; }
        if (f64_lt(f64_abs(f), _GEO_F64_POS_INF) == 0) { return 0; }
        if (f64_lt(f64_abs(h), _GEO_F64_POS_INF) == 0) { return 0; }
        var b = s + k * 40;
        store64(b, e);
        store64(b + 8, h);
        store64(b + 16, e);
        store64(b + 24, f64_neg(h));
        store64(b + 32, f);
    }
    return 1;
}

# 1 when the OBB crossing of face `face` has a numerator of exactly 0: e - he for an even face,
# e + he for an odd one, on axis face / 2 (3.4.0, the OBB's _geo_aabb_face_exact0).
fn _geo_obb_face_num0(face, e0, he0, e1, he1, e2, he2) {
    var e = e0;
    var h = he0;
    if (face == 2 || face == 3) {
        e = e1;
        h = he1;
    } elif (face == 4 || face == 5) {
        e = e2;
        h = he2;
    }
    if ((face & 1) == 1) { h = f64_neg(h); }
    if (f64_eq(e, h) == 1) { return 1; }
    return 0;
}

# Ray-OBB intersection (slab test in OBB local space)
#
# DEGENERATE DIRECTION, repaired 2.10.1 -- the same defect as geo_ray_aabb above
# and repaired the same way. When every local axis has |a_k . d| below
# EPSILON_F64 no slab narrows the interval, and the tail returned +Inf where the
# module contract says 0. See the geo_ray_aabb header for why the guard counts
# contributing slabs instead of testing |d| up front.
# [measured: tests/modules.tcyr "2.10.1 degenerate-direction contract"]
#
# ⛔ 3.3.4 — A NEGATIVE HALF-EXTENT IS ITS MAGNITUDE, ON EVERY RAY (roadmap D035).
# A slab the ray crosses solves a.(p - c) = -he and = +he and sorts the two t, so
# it has always read he = -1 as the slab |he| = 1, while the parallel branch tested
# -e - he > 0 and -e + he < 0 and read the same box as EMPTY: one OBB was solid to
# an oblique ray and missed by an axial one. The parallel branch now takes |he| as
# well. That is the reading the crossing slabs, the face labels and the jet already
# give a signed he (face 0 is the plane a.(p - c) = -he, and dt/dhe = sign/f_k
# differentiates exactly that plane), so only the axial rays move, and they move to
# what an oblique ray already answered. The alternative, a negative extent as an
# empty box, needed a test on every crossing slab of every ray. Over 2500 random
# OBBs and rays, each with the seven sign patterns of he, t matches the |he| box in
# 17500 of 17500 (1040 moved, every one an axial ray from the miss to the |he|
# box's t); on the 1031 identity rotations an exact rational slab oracle of the
# |he| box agrees with 7210 of 7217 answers, the 7 being one configuration that
# 3.3.3 already answered 11 ulp off with he > 0, against 6174 before.
# [measured: georay slab sweep and rational oracle, 3.3.3 geo.cyr vs repaired, not in-tree, 2026-10-03; cycc 6.6.14]
# geo_ray_aabb_face split the same way on a box INVERTED through the setters (min
# above max): min (1,1,1), max (0,0,0) answered 4.5 * sqrt3 to the ray from
# (-4.5,-4.5,-4.5) along (1,1,1)/sqrt3 and the miss to (-5,0.5,0.5) along +x. It now
# reads such a box sorted, as this reads |he| (see "AN INVERTED BOX" above it).
# [measured: georay inverted-AABB probe, 3.3.4 tree, not in-tree, 2026-10-03; cycc 6.6.14]
#
# ⛔ 3.3.6 — THE OBB SLABS HAD THE AABB'S 3.3.4 SHAPE: |f_k| < DBL_MIN read as parallel and
# each crossing (e -+ he) * RN(1/f_k), rounded twice. A centre (1.5, 0, 0) with
# half-extents (0.5, 2^1008, 0.5) and the ray from x = 1 - 2^-40 along (2^-1030, 1, 0),
# which enters the x slab at t = 2^990, answered the miss 0. The parallel test is now
# f_k = 0 exactly and each crossing one quotient (e -+ he) / f_k, as geo_ray_aabb_face
# has had since 3.3.5; an infinite e against a subnormal f_k stays parallel, as an
# infinite origin does there, so no infinite-input answer moves for it. A NaN f_k is not
# 0 and keeps the slab arithmetic, the NaN routing the old `!= 1` spelling had, and a
# negative half-extent still reads as |he|. Crossings that overflow or underflow are
# then ordered exactly (_geo_slabs_exact, through _geo_ray_obb_slabs) when e, f and he
# are finite on every axis. Over 182000 OBB-ray pairs (two seeds: random frames, a
# subnormal f_k, e -+ he past DBL_MAX, underflowing crossings, contacts) against an exact
# rational slab oracle on the e, f and he the code forms: 5622 wrong -> right, none right
# -> wrong; correctly rounded t went from 13397 to 16852 of 18700 hits and the largest
# error of a right answer from 1.96 to 1.40 ulp. The 8000 NaN inputs keep D034's contract
# bit for bit; of 8000 with an infinity, 40 moved. On the C1 review's OBB sweep (7499
# pairs with an infinity) 91 moved: 82 by a 1-ulp t from the division, 9 in verdict or face
# (contacts with an infinite half-extent now crossed, and zero-width near-ties, by the
# review's reading). A hit whose 1 / f_k overflows is the jet's miss, as for the AABB.
# [measured: C336 OBB sweep, seeds 21 and 22, exact Fraction oracle, 3.3.5 vs this tree, 2026-10-11; cycc 6.6.14]
# [measured: C336 run of the C1 review's OBB sweep, seed 311, 3.3.5 vs this tree, 2026-10-11; cycc 6.6.14]
public fn geo_ray_obb_face(ray, obb, out) {
    # (3.4.0: c - o on the stack, the same operations as hvec3_sub, so the same bits, and the axes
    # from _geo_obb_axes_into: NaN, not a dereferenced 0, when a rotation's allocation was refused.)
    var dv[24];
    var d = &dv;
    store64(d, f64_sub(HVec3_x(GeoObb_center(obb)), HVec3_x(GeoRay_origin(ray))));
    store64(d + 8, f64_sub(HVec3_y(GeoObb_center(obb)), HVec3_y(GeoRay_origin(ray))));
    store64(d + 16, f64_sub(HVec3_z(GeoObb_center(obb)), HVec3_z(GeoRay_origin(ray))));
    var axb[72];
    var axp[24];
    if (_geo_obb_axes_into(obb, &axb, &axp) == 0) { return f64_sub(_GEO_F64_POS_INF, _GEO_F64_POS_INF); }
    var axes = &axp;
    var he = GeoObb_half_extents(obb);

    var t_min = _GEO_F64_NEG_INF;
    var t_max = _GEO_F64_POS_INF;
    var slabs = 0;
    var face_near = GEO_FACE_NONE;
    var face_far  = GEO_FACE_NONE;
    var tie_near = 0;
    var tie_far  = 0;
    var s[120];    # the three slabs for _geo_slabs_exact
    if (out != 0) {
        store64(out, GEO_FACE_NONE);
        store64(out + 8, 0);
    }

    # Axis 0
    var ax0 = load64(axes);
    var he0 = HVec3_x(he);
    var e0 = hvec3_dot(ax0, d);
    var f0 = hvec3_dot(ax0, GeoRay_direction(ray));
    if (f64_eq(f0, 0) == 0 && ((e0 & 0x7FFF_FFFF_FFFF_FFFF) < 0x7FF0_0000_0000_0000
        || f64_lt(f64_abs(f0), _GEO_F64_TINY) == 0)) {
        # t1 solves a.(p - c) = -he (the min-side face), t2 the +he face --
        # before the swap, which reorders them when the ray runs down the axis.
        var t1 = f64_div(f64_sub(e0, he0), f0);
        var t2 = f64_div(f64_add(e0, he0), f0);
        var g1 = 0;
        var g2 = 1;
        if (f64_gt(t1, t2) == 1) {
            var tmp = t1; t1 = t2; t2 = tmp;
            g1 = 1; g2 = 0;
        }
        if (t2 == 0x7FF0_0000_0000_0000) {   # an exit read +Inf (see geo_ray_aabb_face)
            var xn = f64_add(e0, he0);
            if (g2 == 0) { xn = f64_sub(e0, he0); }
            if ((xn & 0x7FFF_FFFF_FFFF_FFFF) == 0x7FF0_0000_0000_0000) {
                if (_geo_ray_obb_slabs(ray, obb, axes, &s) == 1) { return _geo_slabs_exact(&s, out); }
            }
        }
        # Face bookkeeping -- see geo_ray_aabb_face; identical rule, local axes.
        if (out != 0) {
            if (f64_gt(t1, t_min) == 1) {
                face_near = g1;
                tie_near = 0;
            }
            else { if (f64_eq(t1, t_min) == 1) { tie_near = 1; } }
            if (f64_lt(t2, t_max) == 1) {
                face_far = g2;
                tie_far = 0;
            }
            else { if (f64_eq(t2, t_max) == 1) { tie_far = 1; } }
        }
        t_min = f64_max(t_min, t1);
        t_max = f64_min(t_max, t2);
        slabs = slabs + 1;
        # As in geo_ray_aabb_face. A miss before axis 2 can only have skipped a NaN
        # in a later half-extent: e0 and f0 read every origin, centre, direction and
        # rotation component (0 * NaN is NaN), so those are NaN here already. For the
        # same reason each parallel e test below is masked by the others for a NaN
        # INPUT (only all three together are not, at a zero direction). A NaN e1 or
        # e2 made from infinite input (0 * Inf) has no NaN to find and falls through.
        if (f64_lt(t_min, t_max) == 0) {
            if (f64_gt(t_min, t_max) == 1) { return _geo_hvec3_nan(he); }
            if (f64_eq(t_min, t_max) == 0) {
                var nn = _geo_ray_obb_nan(ray, obb);
                if (nn != 0) { return nn; }
            }
        }
    } else {
        # Ray parallel to slab -- check if origin is outside
        # Rust: (-e - he) > 0 || (-e + he) < 0, with |he| since 3.3.4 (D035, header)
        var neg_e0 = f64_neg(e0);
        var ahe0 = f64_abs(he0);
        if (f64_gt(f64_sub(neg_e0, ahe0), 0) == 1) { return _geo_hvec3_nan(he); }
        if (f64_lt(f64_add(neg_e0, ahe0), 0) == 1) { return _geo_hvec3_nan(he); }
        if (f64_eq(e0, e0) == 0) {
            var ne0 = _geo_ray_obb_nan(ray, obb);
            if (ne0 != 0) { return ne0; }
        }
        if (f64_eq(he0, he0) == 0) { return he0; }
    }

    # Axis 1
    var ax1 = load64(axes + 8);
    var he1 = HVec3_y(he);
    var e1 = hvec3_dot(ax1, d);
    var f1 = hvec3_dot(ax1, GeoRay_direction(ray));
    if (f64_eq(f1, 0) == 0 && ((e1 & 0x7FFF_FFFF_FFFF_FFFF) < 0x7FF0_0000_0000_0000
        || f64_lt(f64_abs(f1), _GEO_F64_TINY) == 0)) {
        # t1 solves a.(p - c) = -he (the min-side face), t2 the +he face --
        # before the swap, which reorders them when the ray runs down the axis.
        var t1 = f64_div(f64_sub(e1, he1), f1);
        var t2 = f64_div(f64_add(e1, he1), f1);
        var g1 = 2;
        var g2 = 3;
        if (f64_gt(t1, t2) == 1) {
            var tmp = t1; t1 = t2; t2 = tmp;
            g1 = 3; g2 = 2;
        }
        if (t2 == 0x7FF0_0000_0000_0000) {   # an exit read +Inf (see geo_ray_aabb_face)
            var xn = f64_add(e1, he1);
            if (g2 == 2) { xn = f64_sub(e1, he1); }
            if ((xn & 0x7FFF_FFFF_FFFF_FFFF) == 0x7FF0_0000_0000_0000) {
                if (_geo_ray_obb_slabs(ray, obb, axes, &s) == 1) { return _geo_slabs_exact(&s, out); }
            }
        }
        # Face bookkeeping -- see geo_ray_aabb_face; identical rule, local axes.
        if (out != 0) {
            if (f64_gt(t1, t_min) == 1) {
                face_near = g1;
                tie_near = 0;
            }
            else { if (f64_eq(t1, t_min) == 1) { tie_near = 1; } }
            if (f64_lt(t2, t_max) == 1) {
                face_far = g2;
                tie_far = 0;
            }
            else { if (f64_eq(t2, t_max) == 1) { tie_far = 1; } }
        }
        t_min = f64_max(t_min, t1);
        t_max = f64_min(t_max, t2);
        slabs = slabs + 1;
        if (f64_lt(t_min, t_max) == 0) {
            if (f64_gt(t_min, t_max) == 1) { return _geo_hvec3_nan(he); }
            if (f64_eq(t_min, t_max) == 0) {
                var nn = _geo_ray_obb_nan(ray, obb);
                if (nn != 0) { return nn; }
            }
        }
    } else {
        var neg_e1 = f64_neg(e1);
        var ahe1 = f64_abs(he1);
        if (f64_gt(f64_sub(neg_e1, ahe1), 0) == 1) { return _geo_hvec3_nan(he); }
        if (f64_lt(f64_add(neg_e1, ahe1), 0) == 1) { return _geo_hvec3_nan(he); }
        if (f64_eq(e1, e1) == 0) {
            var ne1 = _geo_ray_obb_nan(ray, obb);
            if (ne1 != 0) { return ne1; }
        }
        if (f64_eq(he1, he1) == 0) { return he1; }
    }

    # Axis 2
    var ax2 = load64(axes + 16);
    var he2 = HVec3_z(he);
    var e2 = hvec3_dot(ax2, d);
    var f2 = hvec3_dot(ax2, GeoRay_direction(ray));
    if (f64_eq(f2, 0) == 0 && ((e2 & 0x7FFF_FFFF_FFFF_FFFF) < 0x7FF0_0000_0000_0000
        || f64_lt(f64_abs(f2), _GEO_F64_TINY) == 0)) {
        # t1 solves a.(p - c) = -he (the min-side face), t2 the +he face --
        # before the swap, which reorders them when the ray runs down the axis.
        var t1 = f64_div(f64_sub(e2, he2), f2);
        var t2 = f64_div(f64_add(e2, he2), f2);
        var g1 = 4;
        var g2 = 5;
        if (f64_gt(t1, t2) == 1) {
            var tmp = t1; t1 = t2; t2 = tmp;
            g1 = 5; g2 = 4;
        }
        if (t2 == 0x7FF0_0000_0000_0000) {   # an exit read +Inf (see geo_ray_aabb_face)
            var xn = f64_add(e2, he2);
            if (g2 == 4) { xn = f64_sub(e2, he2); }
            if ((xn & 0x7FFF_FFFF_FFFF_FFFF) == 0x7FF0_0000_0000_0000) {
                if (_geo_ray_obb_slabs(ray, obb, axes, &s) == 1) { return _geo_slabs_exact(&s, out); }
            }
        }
        # Face bookkeeping -- see geo_ray_aabb_face; identical rule, local axes.
        if (out != 0) {
            if (f64_gt(t1, t_min) == 1) {
                face_near = g1;
                tie_near = 0;
            }
            else { if (f64_eq(t1, t_min) == 1) { tie_near = 1; } }
            if (f64_lt(t2, t_max) == 1) {
                face_far = g2;
                tie_far = 0;
            }
            else { if (f64_eq(t2, t_max) == 1) { tie_far = 1; } }
        }
        t_min = f64_max(t_min, t1);
        t_max = f64_min(t_max, t2);
        slabs = slabs + 1;
        if (f64_lt(t_min, t_max) == 0) {
            if (f64_gt(t_min, t_max) == 1) { return 0; }
            if (f64_eq(t_min, t_max) == 0) {
                var nn = _geo_ray_obb_nan(ray, obb);
                if (nn != 0) { return nn; }
            }
        }
    } else {
        var neg_e2 = f64_neg(e2);
        var ahe2 = f64_abs(he2);
        if (f64_gt(f64_sub(neg_e2, ahe2), 0) == 1) { return 0; }
        if (f64_lt(f64_add(neg_e2, ahe2), 0) == 1) { return 0; }
        if (f64_eq(e2, e2) == 0) {
            var ne2 = _geo_ray_obb_nan(ray, obb);
            if (ne2 != 0) { return ne2; }
        }
        if (f64_eq(he2, he2) == 0) { return he2; }
    }

    # See the header: every axis parallel means nothing narrowed the interval.
    if (slabs == 0) { return 0; }

    # Tangential clip and zero half-extent -- see geo_ray_aabb_face for both.
    if (f64_eq(t_min, t_max) == 1) { tie_near = 1; tie_far = 1; }

    # 3.3.6: a reading that lost its order is settled exactly, as in geo_ray_aabb_face,
    # when e, f and he are finite on all three axes (_geo_ray_obb_slabs). Unlike the
    # AABB's b - o, no entry can read +Inf from an overflowed numerator: with e finite,
    # e - |he| cannot pass +DBL_MAX (it can pass -DBL_MAX, e = -1.5 * 2^1023 against
    # he = 1.5 * 2^1023, but an entry read -Inf is behind the origin as its true value
    # is, and only the exit is then returned). So an entry read +Inf is a crossing past
    # DBL_MAX, the miss either way, and the per-axis miss tests need no exact order. An exit
    # read +Inf whose numerator e -+ he overflowed diverts where it is read; a zero or
    # subnormal t_min or t_max only when a crossing underflowed (_geo_slab_uf).

    # See geo_ray_aabb_face: 0 or a positive FINITE t, nothing else.
    if (f64_lt(t_min, 0) != 1) {
        var tmn = t_min & 0x7FFF_FFFF_FFFF_FFFF;
        if (tmn < 0x0010_0000_0000_0000) {
            var z0 = 0;
            if (out != 0 && tmn == 0 && tie_near == 0) {   # (see _geo_aabb_face_exact0)
                z0 = _geo_obb_face_num0(face_near, e0, he0, e1, he1, e2, he2);
            }
            if (z0 == 0) {
                var uf = _geo_slab_uf(f64_sub(e0, he0), f64_add(e0, he0), f0);
                uf = uf | _geo_slab_uf(f64_sub(e1, he1), f64_add(e1, he1), f1);
                uf = uf | _geo_slab_uf(f64_sub(e2, he2), f64_add(e2, he2), f2);
                if (uf == 1) {
                    if (_geo_ray_obb_slabs(ray, obb, axes, &s) == 1) { return _geo_slabs_exact(&s, out); }
                }
            }
        }
        if (tmn == 0x7FF0_0000_0000_0000) { return 0; }
        if (out != 0) { store64(out, face_near); store64(out + 8, tie_near); }
        return t_min;
    }
    if (f64_lt(t_max, 0) != 1) {
        # Origin inside the box: the EXIT face, not the entry one.
        var tmx = t_max & 0x7FFF_FFFF_FFFF_FFFF;
        if (tmx < 0x0010_0000_0000_0000) {
            var z1 = 0;
            if (out != 0 && tmx == 0 && tie_far == 0) {
                z1 = _geo_obb_face_num0(face_far, e0, he0, e1, he1, e2, he2);
            }
            if (z1 == 0) {
                var uf2 = _geo_slab_uf(f64_sub(e0, he0), f64_add(e0, he0), f0);
                uf2 = uf2 | _geo_slab_uf(f64_sub(e1, he1), f64_add(e1, he1), f1);
                uf2 = uf2 | _geo_slab_uf(f64_sub(e2, he2), f64_add(e2, he2), f2);
                if (uf2 == 1) {
                    if (_geo_ray_obb_slabs(ray, obb, axes, &s) == 1) { return _geo_slabs_exact(&s, out); }
                }
            }
        }
        if (tmx == 0x7FF0_0000_0000_0000) { return 0; }
        if (out != 0) { store64(out, face_far); store64(out + 8, tie_far); }
        return t_max;
    }
    return 0;
}

# The plain entry point: identical t, no face bookkeeping, out = 0.
public fn geo_ray_obb(ray, obb) {
    return geo_ray_obb_face(ray, obb, 0);
}

# ================================================================
# Exact products of exact sums, and the capsule solved exactly (3.4.1 GEO4)
# ================================================================
# A number is (-1)^s sum_k L_k 2^(32 (b + k)): word 0 b, word 1 the limb count n (0 for zero), word
# 2 the sign s (-1, 0, 1), word 3 + k limb k (0 .. 2^32 - 1), the top limb non-zero. Products and sums of them
# are exact, so every sign below is exact.

fn _geo_bn_zero(x) {
    store64(x, 0);
    store64(x + 8, 0);
    store64(x + 16, 0);
    return 0;
}

# The sum held in acc (_geo_xi_add2 / _geo_xi_add3; normalised here, and left negated when it was
# negative) as a number at x. Returns its sign.
fn _geo_bn_acc(acc, x) {
    var sg = _geo_xi_norm(acc);
    _geo_bn_zero(x);
    if (sg == 0) { return 0; }
    var lo = load64(acc);
    var hi = load64(acc + 8);
    if (sg < 0) {
        var c = 0;
        for (var k = lo; k < hi; k = k + 1) {
            var q = acc + 24 + k * 8;
            var v = c - load64(q);
            store64(q, v & 0xFFFF_FFFF);
            c = v >>> 32;
        }
    }
    while (load64(acc + 24 + (hi - 1) * 8) == 0) { hi = hi - 1; }
    while (load64(acc + 24 + lo * 8) == 0) { lo = lo + 1; }
    # (limb k is worth 2^(32 k - 3222) = 2^(32 (k - 101) + 10): each moves up 10 bits)
    var n = 0;
    var cy = 0;
    for (var k2 = lo; k2 < hi; k2 = k2 + 1) {
        var v2 = load64(acc + 24 + k2 * 8);
        store64(x + 24 + n * 8, ((v2 << 10) | cy) & 0xFFFF_FFFF);
        cy = v2 >> 22;
        n = n + 1;
    }
    if (cy != 0) {
        store64(x + 24 + n * 8, cy);
        n = n + 1;
    }
    store64(x, lo - 101);
    store64(x + 8, n);
    store64(x + 16, sg);
    return sg;
}

# sum over i < k of ts[i] ta[i] tb[i] into x (ta, tb arrays of numbers, ts of +-1); x may not be
# one of them. Returns the sign.
fn _geo_bn_sop(ta, tb, ts, k, x) {
    var lo = 0x7FFF_FFFF;
    var hi = 0 - 0x7FFF_FFFF;
    for (var i = 0; i < k; i = i + 1) {
        var a = load64(ta + i * 8);
        var b = load64(tb + i * 8);
        if (load64(a + 8) != 0 && load64(b + 8) != 0) {
            var bl = load64(a) + load64(b);
            var bh = bl + load64(a + 8) + load64(b + 8);
            if (bl < lo) { lo = bl; }
            if (bh > hi) { hi = bh; }
        }
    }
    _geo_bn_zero(x);
    if (hi < lo) { return 0; }
    var n = hi - lo + 1;
    var col = x + 24;
    for (var j = 0; j < n; j = j + 1) { store64(col + j * 8, 0); }
    for (var i2 = 0; i2 < k; i2 = i2 + 1) {
        var a2 = load64(ta + i2 * 8);
        var b2 = load64(tb + i2 * 8);
        var na = load64(a2 + 8);
        var nb = load64(b2 + 8);
        if (na != 0 && nb != 0) {
            var base = col + (load64(a2) + load64(b2) - lo) * 8;
            var pb = b2 + 24;
            if (load64(a2 + 16) * load64(b2 + 16) * load64(ts + i2 * 8) > 0) {
                for (var p = 0; p < na; p = p + 1) {
                    var ap = load64(a2 + 24 + p * 8);
                    var q = base + p * 8;
                    for (var r = 0; r < nb; r = r + 1) {
                        var pr = ap * load64(pb + r * 8);
                        store64(q, load64(q) + (pr & 0xFFFF_FFFF));
                        store64(q + 8, load64(q + 8) + (pr >> 32));
                        q = q + 8;
                    }
                }
            } else {
                for (var p2 = 0; p2 < na; p2 = p2 + 1) {
                    var ap2 = load64(a2 + 24 + p2 * 8);
                    var q2 = base + p2 * 8;
                    for (var r2 = 0; r2 < nb; r2 = r2 + 1) {
                        var pr2 = ap2 * load64(pb + r2 * 8);
                        store64(q2, load64(q2) - (pr2 & 0xFFFF_FFFF));
                        store64(q2 + 8, load64(q2 + 8) - (pr2 >> 32));
                        q2 = q2 + 8;
                    }
                }
            }
        }
    }
    var c = 0;
    var nz = 0;
    for (var j2 = 0; j2 < n; j2 = j2 + 1) {
        var v = load64(col + j2 * 8) + c;
        var l = v & 0xFFFF_FFFF;
        store64(col + j2 * 8, l);
        nz = nz | l;
        c = v >>> 32;
    }
    var sg = 0;
    if (c < 0) {
        sg = 0 - 1;
        var cb = 0;
        for (var j3 = 0; j3 < n; j3 = j3 + 1) {
            var v3 = cb - load64(col + j3 * 8);
            store64(col + j3 * 8, v3 & 0xFFFF_FFFF);
            cb = v3 >>> 32;
        }
    } elif (nz != 0) { sg = 1; }
    if (sg == 0) { return 0; }
    while (load64(col + (n - 1) * 8) == 0) { n = n - 1; }
    store64(x, lo);
    store64(x + 8, n);
    store64(x + 16, sg);
    return sg;
}

# a b into x (_geo_bn_sop with one term).
fn _geo_bn_mul(a, b, x) {
    var ta: i64[1];
    var tb: i64[1];
    var ts: i64[1];
    store64(&ta, a);
    store64(&tb, b);
    store64(&ts, 1);
    return _geo_bn_sop(&ta, &tb, &ts, 1, x);
}

# sa a + sb b into x (sa, sb +-1).
fn _geo_bn_lin(a, sa, b, sb, x) {
    var one: i64[4];
    store64(&one, 0);
    store64(&one + 8, 1);
    store64(&one + 16, 1);
    store64(&one + 24, 1);
    var ta: i64[2];
    var tb: i64[2];
    var ts: i64[2];
    store64(&ta, a);
    store64(&ta + 8, b);
    store64(&tb, &one);
    store64(&tb + 8, &one);
    store64(&ts, sa);
    store64(&ts + 8, sb);
    return _geo_bn_sop(&ta, &tb, &ts, 2, x);
}

# x correctly rounded: out[0] = +-m (a double, m an integer in [2^52, 2^53)) and out[1] its power of
# two, x = m 2^out[1]; (0, 0) for zero. The 64 bits below the top one from the three highest limbs,
# the rest a sticky bit, to nearest, ties to even (as _geo_xi_mag).
fn _geo_bn_val(x, out) {
    store64(out, 0);
    store64(out + 8, 0);
    var n = load64(x + 8);
    if (n == 0) { return 0; }
    var top = n - 1;
    var l0 = load64(x + 24 + top * 8);
    var l1 = 0;
    var l2 = 0;
    if (top >= 1) { l1 = load64(x + 24 + (top - 1) * 8); }
    if (top >= 2) { l2 = load64(x + 24 + (top - 2) * 8); }
    var st = 0;
    for (var j = 0; j < top - 2; j = j + 1) { st = st | load64(x + 24 + j * 8); }
    var bl = ((f64_from(l0) >> 52) & 0x7FF) - 1022;   # bits in the top limb, 1 .. 32
    var w = (l0 << (64 - bl)) | (l1 << (32 - bl)) | (l2 >> bl);
    st = st | (l2 & ((1 << bl) - 1)) | (w & 0x3FF);
    var m = w >> 11;
    var e = 11 + bl + 32 * (load64(x) + top - 2);
    if (((w >> 10) & 1) == 1) {
        if (st != 0 || (m & 1) == 1) { m = m + 1; }
        if (m == 0x0020_0000_0000_0000) {
            m = 0x0010_0000_0000_0000;
            e = e + 1;
        }
    }
    var mf = f64_from(m);
    if (load64(x + 16) < 0) { mf = f64_neg(mf); }
    store64(out, mf);
    store64(out + 8, e);
    return 0;
}

# sqrt(x) for x >= 0 as (m, e) at out, m a double in [2^26, 2^27) times 2^e... (m within 0.75 ulp: the root of a
# value rounded once.)
fn _geo_bn_sqrt(x, out) {
    _geo_bn_val(x, out);
    var m = load64(out);
    var e = load64(out + 8);
    if (m == 0) { return 0; }
    if ((e & 1) != 0) {
        m = f64_mul(m, F64_TWO);
        e = e - 1;
    }
    store64(out, f64_sqrt(m));
    store64(out + 8, e >>> 1);
    return 0;
}

# A double as one record at r (as _geo_xi_vec forms each component).
fn _geo_xi_rec1(x, r) {
    var e = (x >> 52) & 0x7FF;
    var m = x & 0x000F_FFFF_FFFF_FFFF;
    if (e == 0) { e = 1; } else { m = m | 0x0010_0000_0000_0000; }
    store64(r, m);
    store64(r + 8, e - 1075);
    store64(r + 16, x >> 63);
    return 0;
}

# Component k of a x b (records) added to acc, negated when neg is 1.
fn _geo_xc_cr(acc, a, b, k, neg) {
    var i = k + 1;
    if (i == 3) { i = 0; }
    var j = i + 1;
    if (j == 3) { j = 0; }
    _geo_xi_add2(acc, a + i * 24, b + j * 24, neg);
    _geo_xi_add2(acc, a + j * 24, b + i * 24, neg ^ 1);
    return 0;
}

# a . b (records) added to acc.
fn _geo_xc_dot(acc, a, b, neg) {
    for (var i = 0; i < 3; i = i + 1) { _geo_xi_add2(acc, a + i * 24, b + i * 24, neg); }
    return 0;
}

# The sign of a sqrt(c1) + sg b sqrt(c2) (c1, c2 >= 0; sg +-1), exactly: from the signs, else from
# a^2 c1 - b^2 c2. t1, t2, t3 are scratch numbers.
fn _geo_xc_sgn2(a, c1, b, sg, c2, t1, t2, t3) {
    var sa = load64(a + 16);
    if (load64(c1 + 16) == 0) { sa = 0; }
    var sb = load64(b + 16) * sg;
    if (load64(c2 + 16) == 0) { sb = 0; }
    if (sb == 0) { return sa; }
    if (sa == 0) { return sb; }
    if (sa == sb) { return sa; }
    # (a^2 c1 against b^2 c2 from the rounded values first: each within 2^-49 of its own, so a
    # ratio past 1 + 2^-40 decides it)
    var va: i64[2];
    var vb: i64[2];
    var vc: i64[2];
    var vd: i64[2];
    _geo_bn_val(a, &va);
    _geo_bn_val(b, &vb);
    _geo_bn_val(c1, &vc);
    _geo_bn_val(c2, &vd);
    var q1 = f64_mul(f64_mul(load64(&va), load64(&va)), load64(&vc));
    var q2 = f64_mul(f64_mul(load64(&vb), load64(&vb)), load64(&vd));
    var dq = 2 * load64(&va + 8) + load64(&vc + 8) - 2 * load64(&vb + 8) - load64(&vd + 8);
    if (dq > 64) { return sa; }
    if (dq < 0 - 64) { return sb; }
    q1 = _geo_ldexp(q1, dq);
    if (f64_gt(q1, f64_mul(q2, 0x3FF0_0000_0010_0000)) == 1) { return sa; }   # 1 + 2^-32
    if (f64_gt(q2, f64_mul(q1, 0x3FF0_0000_0010_0000)) == 1) { return sb; }
    _geo_bn_mul(a, a, t1);
    _geo_bn_mul(b, b, t2);
    var ta: i64[2];
    var tb: i64[2];
    var ts: i64[2];
    store64(&ta, t1);
    store64(&tb, c1);
    store64(&ts, 1);
    store64(&ta + 8, t2);
    store64(&tb + 8, c2);
    store64(&ts + 8, 0 - 1);
    var g = _geo_bn_sop(&ta, &tb, &ts, 2, t3);
    if (g > 0) { return sa; }
    if (g < 0) { return sb; }
    return 0;
}

# 1 when the root (-hb + sg sq) / a cancels (hb and sg sq of opposite signs, |hb| under 8 sq): it is
# then formed as c / (-hb - sg sq). hb and sq as (m, e) pairs.
fn _geo_xc_cancels(hb, sq, sg) {
    var mh = load64(hb);
    var ms = load64(sq);
    if (f64_eq(mh, 0) == 1 || f64_eq(ms, 0) == 1) { return 0; }
    if (sg > 0) {
        if (f64_gt(mh, 0) == 0) { return 0; }
    } else {
        if (f64_lt(mh, 0) == 0) { return 0; }
    }
    var lim = _geo_ldexp(ms, load64(sq + 8) - load64(hb + 8) + 3);
    if (f64_lt(f64_abs(mh), lim) == 1) { return 1; }
    return 0;
}

# The root (-hb + sg sq) / a, or c / (-hb - sg sq) where that cancels (c needed only then: the
# caller forms it when _geo_xc_cancels says so). Each argument an (m, e) pair.
fn _geo_xc_root(hb, sq, sg, a, c) {
    var mh = f64_neg(load64(hb));
    var eh = load64(hb + 8);
    var ms = load64(sq);
    if (sg < 0) { ms = f64_neg(ms); }
    var es = load64(sq + 8);
    var em = eh;
    if (f64_eq(mh, 0) == 1) { em = es; }
    elif (f64_eq(ms, 0) == 0 && es > eh) { em = es; }
    if (c != 0) {
        # c / (-hb - sg sq)
        var den = f64_sub(_geo_ldexp(mh, eh - em), _geo_ldexp(ms, es - em));
        if (f64_eq(load64(c), 0) == 1) { return 0; }
        return _geo_ldexp(f64_div(load64(c), den), load64(c + 8) - em);
    }
    var num = f64_add(_geo_ldexp(mh, eh - em), _geo_ldexp(ms, es - em));
    return _geo_ldexp(f64_div(num, load64(a)), em - load64(a + 8));
}

# The first hit of a ray on a capsule, decided and placed exactly (3.4.1 GEO4): finite o, d, start,
# end, r >= 0, start != end, d != 0. With w = o - start, u = end - start, n = u x d: the line meets
# the infinite cylinder iff P1 = r^2 |n|^2 - det(w, u, d)^2 >= 0, at t = (-M -+ S) / N (N = |n|^2,
# M = uu (w . d) - (u . d)(w . u), S = sqrt(uu P1), uu = u . u); the segment coordinate of those
# roots, times uu N, is uu W -+ (u . d) S with W = (w x d) . n (and W - N in place of W for the end
# plane), so each root's side of each end plane is a sign of a sqrt(c1) + b sqrt(c2). A line that
# enters the cylinder before the start plane enters the capsule through the start cap or not at
# all (it crosses that plane inside the cylinder, so inside the start sphere), and likewise at the
# end, so the entry is the barrel's root, the near cap's or the miss, and the exit likewise. A cap
# sphere at c: hb = (o - c) . d, Delta = r^2 (d . d) - |(o - c) x d|^2, roots (-hb -+ sqrt(Delta)) /
# d . d. Every quantity is an exact integer (_geo_xi_add2/3, _geo_bn_*) rounded once; a root that
# would cancel is c / q instead. u and w are each two exact records per component
# (_geo_xc_dif). Returns t (+0 for a contact; the exit from inside) and the branch at out[0]; 0 and
# GEO_FACE_NONE on a miss.
# Cost: O(n^2) in limbs, and a record's limbs follow the spread of its coordinates' exponents, up to 660 in
# _geo_xc_sgn2. 2.7 to 7.5 us at ordinary scale; on coordinates spread over the whole exponent range median 213 us,
# worst 1.7 ms. geo_ray_capsule on those rows: median 3.2 us, worst 1.6 ms, where 3.3.7's worst was 7.7 us (204
# times) and its answers wrong. Stack: 59,712 bytes of local arrays here, so geo_ray_capsule needs 64 to 72 KB
# (THREAD_STACK_SIZE is 2 MB).
# [measured: R2-GEO xt.py extreme and boundary rows, 400 / 600 per-ray loops, 3.3.7 / this tree, load 3, 2026-11-01]
# [measured: R2-GEO and GEO6 ulimit -s bisection of geo_ray_capsule, s19 and this tree, 2026-11-01]
fn _geo_cap_xsolve(ray, capsule, out) {
    if (out != 0) { store64(out, GEO_FACE_NONE); }
    var ru: i64[18];
    var rw: i64[18];
    var rd: i64[9];
    var rr: i64[3];
    _geo_xc_dif(GeoCapsule_end(capsule), GeoCapsule_start(capsule), &ru);
    _geo_xc_dif(GeoRay_origin(ray), GeoCapsule_start(capsule), &rw);
    _geo_xi_vec(GeoRay_direction(ray), &rd);
    _geo_xi_rec1(GeoCapsule_radius(capsule), &rr);
    var acc: i64[208];
    var nv: i64[432];     # n_k, three numbers of 144 words
    var msv: i64[432];    # ((o - start) x d)_k
    var t1: i64[700];
    var t2: i64[700];
    var t3: i64[700];
    var ta: i64[4];
    var tb: i64[4];
    var ts: i64[4];
    var nz = 0;
    for (var k = 0; k < 3; k = k + 1) {
        _geo_xi_init(&acc);
        _geo_xc_cr(&acc, &ru, &rd, k, 0);
        _geo_xc_cr(&acc, &ru + 72, &rd, k, 0);
        if (_geo_bn_acc(&acc, &nv + k * 1152) != 0) { nz = 1; }
    }
    var r2: i64[144];
    _geo_xi_init(&acc);
    _geo_xi_add2(&acc, &rr, &rr, 0);
    _geo_bn_acc(&acc, &r2);
    var nn: i64[290];
    var p1: i64[410];
    if (nz != 0) {
        for (var k2 = 0; k2 < 3; k2 = k2 + 1) {
            store64(&ta + k2 * 8, &nv + k2 * 1152);
            store64(&tb + k2 * 8, &nv + k2 * 1152);
            store64(&ts + k2 * 8, 1);
        }
        _geo_bn_sop(&ta, &tb, &ts, 3, &nn);
        var dt: i64[212];
        _geo_xi_init(&acc);
        _geo_xi_cdot(&acc, &rw, &ru, &rd, 0);
        _geo_xi_cdot(&acc, &rw, &ru + 72, &rd, 0);
        _geo_xi_cdot(&acc, &rw + 72, &ru, &rd, 0);
        _geo_xi_cdot(&acc, &rw + 72, &ru + 72, &rd, 0);
        _geo_bn_acc(&acc, &dt);
        store64(&ta, &r2);
        store64(&tb, &nn);
        store64(&ts, 1);
        store64(&ta + 8, &dt);
        store64(&tb + 8, &dt);
        store64(&ts + 8, 0 - 1);
        if (_geo_bn_sop(&ta, &tb, &ts, 2, &p1) < 0) { return 0; }   # the line misses the cylinder
    }
    for (var k1 = 0; k1 < 3; k1 = k1 + 1) {
        _geo_xi_init(&acc);
        _geo_xc_cr(&acc, &rw, &rd, k1, 0);
        _geo_xc_cr(&acc, &rw + 72, &rd, k1, 0);
        _geo_bn_acc(&acc, &msv + k1 * 1152);
    }
    var uu: i64[144];
    var ud: i64[144];
    _geo_xi_init(&acc);
    _geo_xc_dot2(&acc, &ru, &ru);
    _geo_bn_acc(&acc, &uu);
    _geo_xi_init(&acc);
    _geo_xc_dot(&acc, &ru, &rd, 0);
    _geo_xc_dot(&acc, &ru + 72, &rd, 0);
    _geo_bn_acc(&acc, &ud);
    var dd: i64[144];
    var mev: i64[432];
    var hme = 0;
    var dls: i64[290];
    var dle: i64[290];
    var hds = 0;   # dls formed
    # The pieces of the entry and the exit: 0 barrel, 1 start cap, 2 end cap; -1 the miss.
    var pin = 0 - 1;
    var pout = 0 - 1;
    var w: i64[290];
    var we: i64[290];
    var s2: i64[560];
    if (nz == 0) {
        # parallel to the axis: within r of it, the near cap's entry and the far cap's exit
        _geo_xc_disc(&acc, &rd, &r2, &msv, &dd, &dls, &ta, &tb, &ts);
        hds = 1;
        if (load64(&dls + 16) >= 0) {
            pin = 2;
            pout = 1;
            if (load64(&ud + 16) > 0) {
                pin = 1;
                pout = 2;
            }
        }
    } else {
        for (var k5 = 0; k5 < 3; k5 = k5 + 1) {
            store64(&ta + k5 * 8, &msv + k5 * 1152);
            store64(&tb + k5 * 8, &nv + k5 * 1152);
            store64(&ts + k5 * 8, 1);
        }
        _geo_bn_sop(&ta, &tb, &ts, 3, &w);
        _geo_bn_lin(&w, 1, &nn, 0 - 1, &we);
        # the entry (-M - S) / N: its coordinate's sign is that of sqrt(uu) W - (u . d) sqrt(P1). On an end
        # plane exactly (the seam, both pieces' point) the cap's label, as before 3.4.0.
        pin = 0;
        if (_geo_xc_sgn2(&w, &uu, &ud, 0 - 1, &p1, &t1, &t2, &t3) <= 0) { pin = 1; }
        elif (_geo_xc_sgn2(&we, &uu, &ud, 0 - 1, &p1, &t1, &t2, &t3) >= 0) { pin = 2; }
    }
    if (pin == 1 || pin == 2) {
        # the cap's discriminant, r^2 d . d - |(o - cap) x d|^2 (the miss below 0)
        var dl0 = &dls;
        if (pin == 2) {
            _geo_xc_mend(&msv, &nv, &mev);
            hme = 1;
            dl0 = &dle;
            _geo_xc_disc(&acc, &rd, &r2, &mev, &dd, &dle, &ta, &tb, &ts);
        } elif (hds == 0) {
            _geo_xc_disc(&acc, &rd, &r2, &msv, &dd, &dls, &ta, &tb, &ts);
            hds = 1;
        }
        if (load64(dl0 + 16) < 0) { return 0; }
    }
    if (pin < 0) { return 0; }
    var wd: i64[144];
    _geo_xi_init(&acc);
    _geo_xc_dot(&acc, &rw, &rd, 0);
    _geo_xc_dot(&acc, &rw + 72, &rd, 0);
    _geo_bn_acc(&acc, &wd);
    var wu: i64[150];
    var hwu = 0;
    var mm: i64[290];
    var res = 0;
    var lab = 0;
    for (var side = 0; side < 2; side = side + 1) {
        var pc = pin;
        var sg = 0 - 1;
        if (side == 1) {
            sg = 1;
            if (nz != 0) {
                # the exit (-M + S) / N
                pout = 0;
                if (_geo_xc_sgn2(&w, &uu, &ud, 1, &p1, &t1, &t2, &t3) <= 0) { pout = 1; }
                elif (_geo_xc_sgn2(&we, &uu, &ud, 1, &p1, &t1, &t2, &t3) >= 0) { pout = 2; }
            }
            pc = pout;
            if (pc == 2 && hme == 0) {
                _geo_xc_mend(&msv, &nv, &mev);
                hme = 1;
                _geo_xc_disc(&acc, &rd, &r2, &mev, &dd, &dle, &ta, &tb, &ts);
            }
            if (pc == 1 && hds == 0) {
                _geo_xc_disc(&acc, &rd, &r2, &msv, &dd, &dls, &ta, &tb, &ts);
                hds = 1;
            }
        }
        var hv: i64[2];
        var sv: i64[2];
        var av: i64[2];
        var cv: i64[2];
        var cp = 0;
        if (pc == 0) {
            if (hwu == 0) {
                _geo_xi_init(&acc);
                _geo_xc_dot2(&acc, &rw, &ru);
                _geo_bn_acc(&acc, &wu);
                hwu = 1;
                store64(&ta, &uu);
                store64(&tb, &wd);
                store64(&ts, 1);
                store64(&ta + 8, &ud);
                store64(&tb + 8, &wu);
                store64(&ts + 8, 0 - 1);
                _geo_bn_sop(&ta, &tb, &ts, 2, &mm);
                _geo_bn_mul(&uu, &p1, &s2);
            }
            _geo_bn_val(&mm, &hv);
            _geo_bn_sqrt(&s2, &sv);
            _geo_bn_val(&nn, &av);
            if (_geo_xc_cancels(&hv, &sv, sg) == 1) {
                # K = uu |w|^2 - (w . u)^2 - r^2 uu
                _geo_xi_init(&acc);
                _geo_xc_dot2(&acc, &rw, &rw);
                _geo_bn_acc(&acc, &t2);
                store64(&ta, &uu);
                store64(&tb, &t2);
                store64(&ts, 1);
                store64(&ta + 8, &wu);
                store64(&tb + 8, &wu);
                store64(&ts + 8, 0 - 1);
                store64(&ta + 16, &r2);
                store64(&tb + 16, &uu);
                store64(&ts + 16, 0 - 1);
                _geo_bn_sop(&ta, &tb, &ts, 3, &t1);
                _geo_bn_val(&t1, &cv);
                cp = &cv;
            }
        } else {
            var dl2 = &dls;
            var hb = &wd;
            if (pc == 2) {
                dl2 = &dle;
                _geo_bn_lin(&wd, 1, &ud, 0 - 1, &t3);
                hb = &t3;
            }
            _geo_bn_val(hb, &hv);
            _geo_bn_sqrt(dl2, &sv);
            _geo_bn_val(&dd, &av);
            if (_geo_xc_cancels(&hv, &sv, sg) == 1) {
                # c = |o - cap|^2 - r^2: |w|^2 - r^2 at the start, |w - u|^2 - r^2 at the end
                _geo_xi_init(&acc);
                if (pc == 2) {
                    _geo_xc_dot2(&acc, &rw, &ru);
                    _geo_xc_dot2(&acc, &rw, &ru);
                    _geo_xc_neg(&acc);
                    _geo_xc_dot2(&acc, &ru, &ru);
                }
                _geo_xc_dot2(&acc, &rw, &rw);
                _geo_xi_add2(&acc, &rr, &rr, 1);
                _geo_bn_acc(&acc, &t1);
                _geo_bn_val(&t1, &cv);
                cp = &cv;
            }
        }
        # (a negative root that underflows is -2^-1074, not the -0 of a contact)
        var tt = _geo_xc_neg0(_geo_xc_root(&hv, &sv, sg, &av, cp), &hv, &sv, sg, cp);
        if (side == 0) {
            # the entry ahead of the origin, or at it (+0, a contact), is the answer; else the exit
            if (f64_lt(tt, 0) == 0) {
                res = tt;
                if (tt == 0x8000_0000_0000_0000) { res = 0; }
                lab = pc;
                side = 2;
            }
        } else {
            if (f64_lt(tt, 0) == 1) { return 0; }   # the capsule is behind the origin
            res = tt;
            if (tt == 0x8000_0000_0000_0000) { res = 0; }
            lab = pc;
        }
    }
    if (out != 0) {
        var br = GEO_CAP_CYLINDER;
        if (lab == 1) { br = GEO_CAP_START_CAP; }
        if (lab == 2) { br = GEO_CAP_END_CAP; }
        store64(out, br);
    }
    return res;
}

# a - b for vectors a, b as two records per component (18 words): the rounded difference and its
# rounding (each exact, so a - b = hi + lo), or where a difference overflows a and -b themselves.
fn _geo_xc_dif(a, b, r) {
    var h: i64[3];
    var l: i64[3];
    var ov = 0;
    for (var i = 0; i < 3; i = i + 1) {
        var ai = load64(a + i * 8);
        var bi = load64(b + i * 8);
        var s = f64_sub(ai, bi);
        if (f64_lt(f64_abs(s), _GEO_F64_POS_INF) == 0) { ov = 1; }
        store64(&h + i * 8, s);
        store64(&l + i * 8, _geo_diff_err(ai, bi, s));
    }
    if (ov == 1) {
        _geo_xi_vec(a, r);
        _geo_xi_vec(b, r + 72);
        for (var j = 0; j < 3; j = j + 1) { store64(r + 72 + j * 24 + 16, 1 - load64(r + 72 + j * 24 + 16)); }
        return 0;
    }
    _geo_xi_vec(&h, r);
    _geo_xi_vec(&l, r + 72);
    return 0;
}

# (a_hi + a_lo) . (b_hi + b_lo) added to acc (two-record vectors, _geo_xc_dif).
fn _geo_xc_dot2(acc, a, b) {
    _geo_xc_dot(acc, a, b, 0);
    _geo_xc_dot(acc, a, b + 72, 0);
    _geo_xc_dot(acc, a + 72, b, 0);
    _geo_xc_dot(acc, a + 72, b + 72, 0);
    return 0;
}

# The accumulator's sum negated in place (its limbs; before _geo_xi_norm).
fn _geo_xc_neg(acc) {
    var lo = load64(acc);
    var hi = load64(acc + 8);
    for (var k = lo; k < hi; k = k + 1) { store64(acc + 24 + k * 8, 0 - load64(acc + 24 + k * 8)); }
    return 0;
}

# ((o - end) x d)_k = ((o - start) x d)_k - n_k, into mev (three numbers of 144 words).
fn _geo_xc_mend(msv, nv, mev) {
    for (var k = 0; k < 3; k = k + 1) { _geo_bn_lin(msv + k * 1152, 1, nv + k * 1152, 0 - 1, mev + k * 1152); }
    return 0;
}

# A cap's discriminant r^2 (d . d) - |m|^2 into dl (m three numbers), d . d into dd on the way.
fn _geo_xc_disc(acc, rd, r2, mv, dd, dl, ta, tb, ts) {
    _geo_xi_init(acc);
    _geo_xc_dot(acc, rd, rd, 0);
    _geo_bn_acc(acc, dd);
    store64(ta, r2);
    store64(tb, dd);
    store64(ts, 1);
    for (var c = 0; c < 3; c = c + 1) {
        store64(ta + 8 + c * 8, mv + c * 1152);
        store64(tb + 8 + c * 8, mv + c * 1152);
        store64(ts + 8 + c * 8, 0 - 1);
    }
    return _geo_bn_sop(ta, tb, ts, 4, dl);
}

# A root from _geo_xc_root that came back -0 for a negative root reads -2^-1074, as _geo_root_ldexp
# keeps it (a -0 root is the contact at t = 0 to the callers). With hb = sq = 0 there is no negative root: an
# origin on the surface, tangent, has the double root 0, and that entry reads -2^-1074 too; the exit, +0, answers.
fn _geo_xc_neg0(t, hb, sq, sg, c) {
    if (t != 0x8000_0000_0000_0000) { return t; }
    if (c != 0) {
        if (f64_eq(load64(c), 0) == 1) { return 0; }
    }
    return 0x8000_0000_0000_0001;
}

# Both roots of the ray's sphere quadratic exactly (3.4.1 GEO4), _geo_sphere_roots' contract
# (sorted into out, 1; 0 for a miss): Delta = r^2 (d . d) - |(o - c) x d|^2 decides, exactly, and
# the roots (-hb -+ sqrt(Delta)) / d . d, hb = (o - c) . d, are formed from the exact values each
# rounded once, the one that would cancel as c / q (c = |o - c|^2 - r^2). Finite input, d != 0.
fn _geo_sph_xroots(ray, sphere, out) {
    var ro: i64[9];
    var rd: i64[9];
    var rc: i64[9];
    var rr: i64[3];
    _geo_xi_vec(GeoRay_origin(ray), &ro);
    _geo_xi_vec(GeoRay_direction(ray), &rd);
    _geo_xi_vec(GeoSphere_center(sphere), &rc);
    _geo_xi_rec1(GeoSphere_radius(sphere), &rr);
    var acc: i64[208];
    var mv: i64[432];
    for (var k = 0; k < 3; k = k + 1) {
        _geo_xi_init(&acc);
        _geo_xc_cr(&acc, &ro, &rd, k, 0);
        _geo_xc_cr(&acc, &rc, &rd, k, 1);
        _geo_bn_acc(&acc, &mv + k * 1152);
    }
    var r2: i64[144];
    _geo_xi_init(&acc);
    _geo_xi_add2(&acc, &rr, &rr, 0);
    _geo_bn_acc(&acc, &r2);
    var dd: i64[144];
    var dl: i64[290];
    var ta: i64[4];
    var tb: i64[4];
    var ts: i64[4];
    if (_geo_xc_disc(&acc, &rd, &r2, &mv, &dd, &dl, &ta, &tb, &ts) < 0) { return 0; }
    var hb: i64[144];
    _geo_xi_init(&acc);
    _geo_xc_dot(&acc, &ro, &rd, 0);
    _geo_xc_dot(&acc, &rc, &rd, 1);
    _geo_bn_acc(&acc, &hb);
    var hv: i64[2];
    var sv: i64[2];
    var av: i64[2];
    var cv: i64[2];
    _geo_bn_val(&hb, &hv);
    _geo_bn_sqrt(&dl, &sv);
    _geo_bn_val(&dd, &av);
    var cp = 0;
    if (_geo_xc_cancels(&hv, &sv, 0 - 1) + _geo_xc_cancels(&hv, &sv, 1) != 0) {
        _geo_xi_init(&acc);
        for (var i = 0; i < 3; i = i + 1) {
            _geo_xi_add2(&acc, &ro + i * 24, &ro + i * 24, 0);
            _geo_xi_add2(&acc, &ro + i * 24, &rc + i * 24, 1);
            _geo_xi_add2(&acc, &ro + i * 24, &rc + i * 24, 1);
            _geo_xi_add2(&acc, &rc + i * 24, &rc + i * 24, 0);
        }
        _geo_xi_add2(&acc, &rr, &rr, 1);
        var cb: i64[144];
        _geo_bn_acc(&acc, &cb);
        _geo_bn_val(&cb, &cv);
        cp = &cv;
    }
    var c0 = 0;
    if (_geo_xc_cancels(&hv, &sv, 0 - 1) == 1) { c0 = cp; }
    var c1 = 0;
    if (_geo_xc_cancels(&hv, &sv, 1) == 1) { c1 = cp; }
    var t1 = _geo_xc_neg0(_geo_xc_root(&hv, &sv, 0 - 1, &av, c0), &hv, &sv, 0 - 1, c0);
    var t2 = _geo_xc_neg0(_geo_xc_root(&hv, &sv, 1, &av, c1), &hv, &sv, 1, c1);
    if (f64_gt(t1, t2) == 1) {
        var tt = t1;
        t1 = t2;
        t2 = tt;
    }
    store64(out, t1);
    store64(out + 8, t2);
    return 1;
}

# The segment coordinate ((o + t d) - st) . u / uu of a barrel root (3.4.0): the hit point to p (a
# stack vector) as geo_ray_at forms it, then the same operations as hvec3_sub, hvec3_dot and the
# division, so the same bits, without three allocations per root.
fn _geo_cap_proj0(ray, st, u, uu, t, p) {
    var o = GeoRay_origin(ray);
    var d = GeoRay_direction(ray);
    var px = f64_add(HVec3_x(o), f64_mul(HVec3_x(d), t));
    var py = f64_add(HVec3_y(o), f64_mul(HVec3_y(d), t));
    var pz = f64_add(HVec3_z(o), f64_mul(HVec3_z(d), t));
    store64(p, px);
    store64(p + 8, py);
    store64(p + 16, pz);
    var wx = f64_sub(px, HVec3_x(st));
    var wy = f64_sub(py, HVec3_y(st));
    var wz = f64_sub(pz, HVec3_z(st));
    return f64_div(f64_add(f64_add(f64_mul(wx, HVec3_x(u)), f64_mul(wy, HVec3_y(u))), f64_mul(wz, HVec3_z(u))), uu);
}

# The barrel hit's fraction along the axis, (w . u) / uu times 2^eu, for the u-form axis of
# geo_ray_capsule_branch (u = 2^eu ab, 3.3.6), with w = p - st (halved when that overflows,
# as it can between ends more than DBL_MAX apart). w is taken to unit size first: w . u
# overflows for a hit far along such a capsule (the barrel at t = 2 between (-0.9, 0, 0) *
# DBL_MAX and its mirror read proj = +Inf, and the one-step 2^eu of an earlier draft of
# _geo_ldexp had turned that into a NaN that the proj tests accepted). Powers of two are
# exact, so where nothing overflowed this is the bits of (w . u) / uu * 2^eu.
fn _geo_cap_proj_u(p, st, u, uu, eu) {
    var wt: i64[3];
    var h0: i64[3];
    var h1: i64[3];
    var w = _geo_sub_to(&wt, p, st);
    if (_geo_hvec3_nonfinite(w) == 1) {
        if (_geo_hvec3_nonfinite(p) + _geo_hvec3_nonfinite(st) == 0) {
            w = _geo_sub_to(&wt, _geo_scale_to(&h0, p, F64_HALF), _geo_scale_to(&h1, st, F64_HALF));
            eu = eu + 1;
        }
    }
    var sw = _geo_scale_for(_geo_absmax_bits(w) >> 52);
    var pr = f64_div(hvec3_dot(_geo_scale_to(&h0, w, sw), u), uu);
    return _geo_ldexp(pr, eu - ((sw >> 52) - 1023));
}

# The segment coordinate (p - start) . ab / |ab|^2 of a barrel root that overflowed to +Inf
# (3.3.6): o's coordinate (_geo_cap_proj_u, which survives an o - start or a product that
# overflows) plus t (d . u) / uu 2^eu, with t = ts 2^te (ts the finite root before it was
# multiplied back) and d taken to unit size first, so nothing on the way overflows; u is
# 2^eu ab. The hit point o + Inf d the other roots are tested at is infinite or NaN here,
# and the NaN-true tests
# took it: a subnormal d = (2, 3, 6) * 2^-1074 from (2 + 2^-51, 3, 6) against
# (0,0,0)-(0,0,-8), r = 7, read +Inf for an exact miss (3.3.5: 0, its barrel flushed), and
# 3.3.5 itself read +Inf for the miss of (-5, 3, 0) along -2^-1030 (1, 1, 0) against
# (0,0,0)-(10,0,0), r = 1. A coordinate past DBL_MAX is +-Inf, off the segment; a crossing
# on it past DBL_MAX is still the hit +Inf, as for a far sphere.
# [measured: C336 review repros (L1) and its edge family, 3.3.5 vs this tree, 2026-10-11; cycc 6.6.14]
fn _geo_cap_far_proj(ts, te, ray, capsule, u, uu, eu) {
    var dir = GeoRay_direction(ray);
    var s4 = _geo_scale_for(_geo_absmax_bits(dir) >> 52);
    var dt: i64[3];
    var y = f64_div(f64_mul(ts, hvec3_dot(_geo_scale_to(&dt, dir, s4), u)), uu);
    var z = _geo_ldexp(y, te - ((s4 >> 52) - 1023) + eu);
    return f64_add(_geo_cap_proj_u(GeoRay_origin(ray), GeoCapsule_start(capsule), u, uu, eu), z);
}

# _geo_cap_accepts for a cap root that overflowed to +Inf (3.3.6): the half-space term
# o_dot + t d_dot is formed from the root of a copy whose direction is taken to unit size
# times 16, t' = t / s (finite), as o_dot + t' (s d) . u, o_dot being 2^oce times its
# value as the caller holds it. With t = +Inf the term read +-Inf or NaN whatever the side:
# a ray from an origin near 2^1001 along a direction near 2^-500 long meets the start cap of a
# capsule near 2^1001 long past DBL_MAX on the cap's own side (exact t 4.3e441), and the cap
# was refused (round 2 answered the +Inf through the barrel, whose crossing is behind the
# start, at the segment coordinate -0.97).
# Finite input only: any other returns -1, and the caller keeps _geo_cap_accepts.
# [measured: C336 review edge family (rnd, k1000), round 2 vs this tree, 2026-10-11; cycc 6.6.14]
fn _geo_cap_far_accepts(ray, sph, u, o_dot, oce, is_end, root_i) {
    if (_geo_sphere_finite(ray, sph) == 0 || _geo_hvec3_nonfinite(u) == 1) { return 0 - 1; }
    var d = GeoRay_direction(ray);
    var r2s[16];   # (3.4.0: the copy's ray on the stack, as the caps' spheres are: no allocation to refuse)
    var r2 = &r2s;
    GeoRay_set_origin(r2, GeoRay_origin(ray));
    # (In steps: a subnormal d is taken only to [2^-51, 2) by the first, whose factor is then
    # 2^1023 already, so a second takes it to [1, 2) and the third multiplies by 16; t' is then
    # under (|o - c| + r) / 16, finite.)
    var d1t: i64[3];
    var d2t: i64[3];
    var d1 = _geo_scale_to(&d1t, d, _geo_scale_for(_geo_absmax_bits(d) >> 52));
    d1 = _geo_scale_to(&d1t, d1, _geo_scale_for(_geo_absmax_bits(d1) >> 52));
    GeoRay_set_direction(r2, _geo_scale_to(&d2t, d1, 0x4030_0000_0000_0000));   # x 16
    var rt2[16];
    if (_geo_sphere_roots(r2, sph, &rt2) == 0) { return 0; }
    var t2 = load64(&rt2 + root_i * 8);
    return _geo_cap_accepts(_geo_ldexp(t2, oce), o_dot, hvec3_dot(GeoRay_direction(r2), u), is_end);
}

# The cap's half-space test for root root_i of its sphere, from where that root lies rather
# than from o_dot + t d_dot (3.3.7): with f the offset of the cap's centre from the ray's line
# (_geo_perp_part on unit-size copies, o - cap's rounding carried), the root's point is
# cap + f -+ h d / |d|, h = sqrt(r^2 - |f|^2), so its side is f . u -+ h (d . u) / |d|. For an
# origin far from a small cap, o_dot and t d_dot agree in all their bits and their sum is
# their rounding; f is formed to about 2^-104 of |o - cap| (exactly for a ray along a
# coordinate axis). 1 or 0 as _geo_cap_accepts; -1 when an input is not finite.
fn _geo_cap_side_exact(ray, cap_pt, r, u, root_i, is_end) {
    var o = GeoRay_origin(ray);
    var d = GeoRay_direction(ray);
    var csx[16];
    store64(&csx, cap_pt);
    store64(&csx + 8, r);
    if (_geo_sphere_finite(ray, &csx) == 0 || _geo_hvec3_nonfinite(u) == 1) { return 0 - 1; }
    var oc[24];
    store64(&oc, f64_sub(HVec3_x(o), HVec3_x(cap_pt)));
    store64(&oc + 8, f64_sub(HVec3_y(o), HVec3_y(cap_pt)));
    store64(&oc + 16, f64_sub(HVec3_z(o), HVec3_z(cap_pt)));
    if (_geo_hvec3_nonfinite(&oc) == 1) { return 0 - 1; }
    var lo[24];
    _geo_oc_lo(o, cap_pt, F64_ONE, &oc, &lo);
    var mp = _geo_absmax_bits(&oc);
    var mr = r & 0x7FFF_FFFF_FFFF_FFFF;
    if (mr > mp) { mp = mr; }
    var sp = _geo_scale_for(mp >> 52);
    var dst: i64[3];
    var tv: i64[3];
    var ds = _geo_scale_to(&dst, d, _geo_scale_for(_geo_absmax_bits(d) >> 52));
    var f[24];
    _geo_perp_part(_geo_scale_to(&tv, &oc, sp), ds, &f);
    _geo_add_perp(&f, _geo_scale_to(&tv, &lo, sp), ds);
    # f and r at their own scale (as _geo_delta_fine takes them): a cap far below |o - cap|
    # flushes in the copy above. The side's sign does not depend on the power of two.
    var rs = f64_mul(r, sp);
    var mf = _geo_absmax_bits(&f);
    var mr2 = rs & 0x7FFF_FFFF_FFFF_FFFF;
    if (mr2 > mf) { mf = mr2; }
    var s2 = _geo_scale_for(mf >> 52);
    var fst: i64[3];
    var fs = _geo_scale_to(&fst, &f, s2);
    rs = f64_mul(rs, s2);
    var hh = f64_sub(f64_mul(rs, rs), hvec3_dot(fs, fs));
    if (f64_lt(hh, 0) == 1) { hh = 0; }
    var h = f64_div(f64_sqrt(hh), hvec3_length(ds));
    var du = f64_mul(h, hvec3_dot(ds, u));
    if (root_i == 0) { du = f64_neg(du); }
    var side = f64_add(hvec3_dot(fs, u), du);
    if (is_end == 1) {
        if (f64_lt(side, 0) == 1) { return 0; }
        return 1;
    }
    if (f64_gt(side, 0) == 1) { return 0; }
    return 1;
}

# Ray-capsule intersection
# 1 when root `t` is a real hit on the cap whose plane term is (o_dot, d_dot).
# A cap owns the half-space on its own side of the capsule's end plane: the START
# cap takes points with (p - start) . ab <= 0, the END cap those with
# (p - end) . ab >= 0. Anything else is a point on the cap's SPHERE that is not
# on the capsule.
#
# The test is done in SCALARS. With p = o + t*d,
#     (p - cap_pt) . ab  ==  (o - cap_pt) . ab  +  t * (d . ab)
# so the caller hoists both dot products -- one per cap and one per ray -- and
# this is two arithmetic ops. Materialising the point instead costs a geo_ray_at
# and an hvec3_sub, both of which ALLOCATE, four times per capsule query under an
# allocator that never frees. Measured: it was +92% on `ray_capsule`.
# [measured: docs/development/issues/archived/2026-08-10-capsule-cyl-missed-tags-a-sphere-root-as-a-cap.md]
#
# ⚠ 3.3.3 — BOTH HALF-SPACE TESTS ARE NaN-TRUE ON PURPOSE. A NaN radius, ray
# origin or ray direction makes every cap root NaN, and accepting it is what
# carries the NaN out. Both respelled NaN-false, a ray along the axis, where the
# cylinder is skipped and only the caps can answer, came back as the miss 0 for
# a NaN radius or a NaN origin coordinate: capsule (0,0,0)-(3,0,0), r = 1, ray
# from (-5,0,0) along +x. Either one alone changes no t, at most the branch label.
# tests/abuse.tcyr pins the NaN radius. A NaN axis never reaches this: it leaves
# right after the sphere case in geo_ray_capsule_branch.
# [measured: W1 probe on a NaN-false variant of the 3.3.3 tree, not reproducible in-tree, 2026-10-01; cycc 6.6.12]
fn _geo_cap_accepts(t, o_dot, d_dot, is_end) {
    if (f64_lt(t, 0) == 1) { return 0; }
    var dot_ab = f64_add(o_dot, f64_mul(t, d_dot));
    if (is_end == 1) {
        if (f64_lt(dot_ab, 0) != 1) { return 1; }
        return 0;
    }
    if (f64_gt(dot_ab, 0) != 1) { return 1; }
    return 0;
}

# A capsule whose length, radius and origin offset (o - start) are all under 2^-484 is solved
# as a copy at unit size (3.3.6): o - start and end - start multiplied by the power of two
# that takes the largest of the three into [1, 2), r by the same, d by the one that takes
# its own largest component there, the copy's start at 0 (3.4.0: in each component whose
# difference was exact; see the body); the copy's t is t * sp / sd. At
# the capsule's own size the squares and products the barrel, the caps and their half-space
# tests are formed from are subnormal or flushed: for a capsule 2^-537 long of radius
# 2^-540, an origin on its axis just past the start moving along it read the cap root at the
# far side of the start sphere (2^-652, an interior point) because (o - start) . (end -
# start) flushed to 0 and the half-space test took the root's side from that 0 (3.3.5:
# 2^-599, right, its roots having flushed alike). The copy's origin, direction, start, end
# and radius go to tv (13 words); the return is log2(sd / sp), or 0x7FFF_FFFF when the
# capsule is not that small, an input is not finite or d is zero.
# [measured: C336 review repro (L2) and its edge family, 3.3.5 vs this tree, 2026-10-11; cycc 6.6.14]
fn _geo_capsule_tiny(ray, capsule, tv) {
    var st = GeoCapsule_start(capsule);
    var en = GeoCapsule_end(capsule);
    var o = GeoRay_origin(ray);
    var d = GeoRay_direction(ray);
    var r = GeoCapsule_radius(capsule);
    var nf = _geo_hvec3_nonfinite(st) + _geo_hvec3_nonfinite(en);
    nf = nf + _geo_hvec3_nonfinite(o) + _geo_hvec3_nonfinite(d);
    if (nf != 0) { return 0x7FFF_FFFF; }
    if (f64_lt(f64_abs(r), _GEO_F64_POS_INF) == 0) { return 0x7FFF_FFFF; }
    var abt: i64[3];
    var aot: i64[3];
    var ab = _geo_sub_to(&abt, en, st);
    var ao = _geo_sub_to(&aot, o, st);
    var m = _geo_absmax_bits(ab);
    var m2 = _geo_absmax_bits(ao);
    if (m2 > m) { m = m2; }
    var mr = r & 0x7FFF_FFFF_FFFF_FFFF;
    if (mr > m) { m = mr; }
    if (m == 0 || m >= 0x21B0_0000_0000_0000) { return 0x7FFF_FFFF; }   # 2^-484
    var md = _geo_absmax_bits(d);
    if (md == 0) { return 0x7FFF_FFFF; }
    var sp = _geo_scale_for(m >> 52);
    var sd = _geo_scale_for(md >> 52);
    # ⛔ 3.4.0 — THE COPY KEEPS THE ROUNDINGS OF o - start AND end - start. Translated to a start at
    # 0, the copy's o - start and end - start were the rounded ones, exact in the copy, so the
    # compensations that carry them (_geo_cap_lows) read 0: an origin near the barrel of a capsule
    # 2^-520 long, c from a rounded o_perp, was up to 3.2e10 ulp off. A component whose difference
    # rounded is copied untranslated (o, start and end times sp): it rounded only because the two
    # are not within a factor of two of each other, so each is under twice the difference, below
    # 2^-483, and its copy below 8. Elsewhere the difference is exact and the copy is translated.
    # [measured: rt340 barrel-origin family (sweep.py bout), exact roots, 3.4.0 base vs this tree, 2026-10-31]
    for (var i = 0; i < 3; i = i + 1) {
        var oi = load64(o + i * 8);
        var si = load64(st + i * 8);
        var ei = load64(en + i * 8);
        var ai = load64(ao + i * 8);
        var bi = load64(ab + i * 8);
        store64(tv + i * 8, f64_mul(ai, sp));
        store64(tv + 48 + i * 8, 0);
        store64(tv + 72 + i * 8, f64_mul(bi, sp));
        if (f64_eq(_geo_diff_err(oi, si, ai), 0) == 0 || f64_eq(_geo_diff_err(ei, si, bi), 0) == 0) {
            store64(tv + i * 8, f64_mul(oi, sp));
            store64(tv + 48 + i * 8, f64_mul(si, sp));
            store64(tv + 72 + i * 8, f64_mul(ei, sp));
        }
    }
    store64(tv + 24, f64_mul(HVec3_x(d), sd));
    store64(tv + 32, f64_mul(HVec3_y(d), sd));
    store64(tv + 40, f64_mul(HVec3_z(d), sd));
    store64(tv + 96, f64_mul(r, sp));
    return (sd >> 52) - (sp >> 52);
}

# A capsule far from the ray's origin against its own size (3.3.7): |o - start| more than 2^30
# times its length and radius. The ray is moved, in exact terms, to where it passes the
# start: the start's offset from the ray's line, w = (o - start) minus its part along d, is
# formed with exact cross products and o - start's rounding carried (_geo_perp_part,
# _geo_oc_lo), and the capsule is solved from K = 8 (|ab| + r) (largest components) before
# that point, on a copy at the capsule's own size with its start at 0. The answer is
# t0 - K / |d| + the copy's t, t0 = -(o - start) . d / d . d being the closest approach.
# Formed from o + t d instead, every quantity the barrel, the caps and the segment test read
# is its own rounding, about 2^-53 |o - start|, which is more than the capsule. Returns
# NaN(0x7FF8_0000_0000_0001) when an input is not finite or d is zero (the caller goes on).
# ⛔ 3.4.1 (GEO4) — THE COPY'S VERDICT WAS ITS ROUNDING FOR A THIN CAPSULE. The copy's geometry is
# good to about 2^-50 of the capsule's size plus 2^-104 |o - start| (w0's rounding and the copy's
# own), more than a thin capsule's radius: 145 / 166 / 123 / 138 of 4,000 rays aimed at far thin
# capsules (RV-GEO's rebuilt family, seeds 1-4) had the wrong hit/miss in 3.4.0, s14 and 3.3.7 alike,
# and a needle met along its axis (2^-244 long, r = 2^-911) read a hit at t = 1 for the exact miss
# that 3.3.7 gave. The copy's answer now stands only where a float certificate on it holds
# (_geo_cap_far_cert: the line's distance from the segment, the side of the entry's end planes and
# the entry's own conditioning, each against that error and the arithmetic's); a certified miss
# skips the copy; everything else is solved exactly (_geo_cap_xsolve). 0 wrong over 16,000 aimed rays
# and 4,000 spread ones against an exact Fraction oracle; certified rays keep their bits.
# [measured: GEO4 3.4.1 aimed (RV-GEO aimed.py) and aspread families, Fraction oracle, 3.3.7 / 3.4.0 / s14, 2026-11-01]
fn _geo_capsule_far(ray, capsule, ao, ab, out) {
    var o = GeoRay_origin(ray);
    var d = GeoRay_direction(ray);
    var st = GeoCapsule_start(capsule);
    var r = GeoCapsule_radius(capsule);
    var nf = _geo_hvec3_nonfinite(o) + _geo_hvec3_nonfinite(d) + _geo_hvec3_nonfinite(st);
    nf = nf + _geo_hvec3_nonfinite(GeoCapsule_end(capsule)) + _geo_hvec3_nonfinite(ab) + _geo_hvec3_nonfinite(ao);
    if (f64_lt(f64_abs(r), _GEO_F64_POS_INF) == 0) { nf = nf + 1; }
    var md = _geo_absmax_bits(d);
    if (nf != 0 || md == 0) { return 0x7FF8_0000_0000_0001; }
    var lo[24];
    _geo_oc_lo(o, st, F64_ONE, ao, &lo);
    var sw = _geo_scale_for(_geo_absmax_bits(ao) >> 52);
    var sd = _geo_scale_for(md >> 52);
    var dst: i64[3];
    var wst: i64[3];
    var lst: i64[3];
    var ds = _geo_scale_to(&dst, d, sd);
    var ws = _geo_scale_to(&wst, ao, sw);
    var wp[24];
    _geo_perp_part(ws, ds, &wp);
    _geo_add_perp(&wp, _geo_scale_to(&lst, &lo, sw), ds);
    var ew = 0 - ((sw >> 52) - 1023);    # wp is 2^-ew times the world offset
    var ed = (sd >> 52) - 1023;
    var w0t: i64[3];
    store64(&w0t, _geo_ldexp(HVec3_x(&wp), ew));
    store64(&w0t + 8, _geo_ldexp(HVec3_y(&wp), ew));
    store64(&w0t + 16, _geo_ldexp(HVec3_z(&wp), ew));
    var w0 = &w0t;
    var ext = f64_add(_geo_absmax_bits(ab), f64_abs(r));
    # (3.4.1: w0 is good to about 2^-50 of itself and 2^-104 |o - start|; ew0 bounds that, four times over)
    var ew0 = f64_mul(_geo_absmax_bits(w0), 0x3CF0_0000_0000_0000);   # 2^-48
    ew0 = f64_add(ew0, f64_mul(_geo_absmax_bits(ao), 0x39B0_0000_0000_0000));   # 2^-100
    if (f64_gt(_geo_absmax_bits(w0), f64_mul(F64_TWO, f64_add(ext, ew0))) == 1) { return 0; }   # passes outside it
    var dd = hvec3_dot(ds, ds);
    var t0 = _geo_ldexp(f64_div(f64_neg(hvec3_dot(ws, ds)), dd), ed + ew);
    if (f64_gt(t0, 0) == 0) { return 0; }   # the capsule is behind the origin
    if (f64_lt(ew0, ext) == 0) { return _geo_cap_xsolve(ray, capsule, out); }   # (the copy holds nothing)
    var kk = f64_mul(0x4020_0000_0000_0000, ext);   # 8 (|ab| + r)
    var sc = _geo_scale_for(kk >> 52);
    var dl = hvec3_length(ds);
    var kd = f64_div(f64_mul(kk, sc), dl);   # K over |ds|, at the copy's scale
    var cray[16];
    var ccap[24];
    var c0t: i64[3];
    var c1t: i64[3];
    var c2t: i64[3];
    store64(&c0t, f64_sub(f64_mul(HVec3_x(w0), sc), f64_mul(kd, HVec3_x(ds))));
    store64(&c0t + 8, f64_sub(f64_mul(HVec3_y(w0), sc), f64_mul(kd, HVec3_y(ds))));
    store64(&c0t + 16, f64_sub(f64_mul(HVec3_z(w0), sc), f64_mul(kd, HVec3_z(ds))));
    store64(&c1t, 0);
    store64(&c1t + 8, 0);
    store64(&c1t + 16, 0);
    store64(&cray, &c0t);
    store64(&cray + 8, ds);
    store64(&ccap, &c1t);
    store64(&ccap + 8, _geo_scale_to(&c2t, ab, sc));
    store64(&ccap + 16, f64_mul(r, sc));
    # The copy's geometry error, at its scale: w0's (ew0), the copy origin's rounding (2^-52 of its
    # terms, generously) and ab's (2^-53 |ab|, generously 2^-51).
    var ein = f64_add(f64_mul(_geo_absmax_bits(w0), sc), f64_mul(kd, _geo_absmax_bits(ds)));
    ein = f64_add(f64_mul(ew0, sc), f64_mul(ein, 0x3CD0_0000_0000_0000));   # 2^-50
    ein = f64_add(ein, f64_mul(f64_mul(_geo_absmax_bits(ab), sc), 0x3CC0_0000_0000_0000));   # 2^-51
    var cert: i64[2];
    var cv = _geo_cap_far_cert(&cray, &ccap, ein, &cert);
    if (cv == 0) { return 0; }   # a certified miss
    if (cv < 0) { return _geo_cap_xsolve(ray, capsule, out); }
    var cbv: i64[2];   # (geo_ray_capsule_branch's out is two words, GEO_FACE_OUT_BYTES)
    var tc = geo_ray_capsule_branch(&cray, &ccap, &cbv);
    var cb = load64(&cbv);
    # the copy's answer stands where it is the certified piece and its root's error, dtc at the
    # copy's scale, is under 2^-55 of t
    if (f64_eq(tc, 0) == 1 || cb != load64(&cert)) { return _geo_cap_xsolve(ray, capsule, out); }
    var dtw = _geo_ldexp(load64(&cert + 8), ed - ((sc >> 52) - 1023));   # (the root's move, at the world's scale)
    if (f64_lt(dtw, f64_mul(t0, 0x3C80_0000_0000_0000)) == 0) {   # 2^-55
        return _geo_cap_xsolve(ray, capsule, out);
    }
    if (out != 0) { store64(out, cb); }
    # t = t0 + (tc - K / |ds|) sd / sc, the copy's t and K over |ds| taken at the copy's scale
    # and then to the world's: the copy's part first, so that a t0 past DBL_MAX is +Inf, not
    # Inf - Inf.
    if (t0 == 0x7FF0_0000_0000_0000) { return t0; }   # past DBL_MAX: +Inf, as for a far sphere
    var es = ed - ((sc >> 52) - 1023);
    return f64_add(t0, _geo_ldexp(f64_sub(tc, kd), es));
}

# How far the line the barrel was solved for (o_perp op, d_perp dp, 2^-es of the true scale, for both) can lie from
# the true one, at op's scale (3.4.1 GEO4, GEO6). op itself is within 2^-51 (|o - start| + |op|) (largest
# components: o - start's rounding and the projection's, about 3.4 2^-53 of them in length), or, where it was formed
# with o - start's rounding carried (cmp), 2^-100 |o - start| + 2^-51 |op|. And dp's direction carries 2^-51 |d| /
# |dp| of rounding, or, where it was formed with end - start's rounding carried (dfn, _geo_dperp_fine), 2^-51 +
# 2^-100 |d| / |dp|: that turns the line about the origin, which moves its offset by |op| times that.
fn _geo_barrel_err(ao, op, cmp, dp, dir, es, dfn) {
    var e = f64_mul(f64_add(_geo_absmax_bits(ao), _geo_absmax_bits(op)), 0x3CC0_0000_0000_0000);   # 2^-51
    if (cmp == 1) {
        e = f64_mul(_geo_absmax_bits(ao), 0x39B0_0000_0000_0000);   # 2^-100
        e = f64_add(e, f64_mul(_geo_absmax_bits(op), 0x3CC0_0000_0000_0000));   # 2^-51
    }
    var rd = f64_div(_geo_ldexp(_geo_absmax_bits(dir), es), _geo_absmax_bits(dp));
    var ed = f64_mul(rd, 0x3CC0_0000_0000_0000);   # 2^-51
    if (dfn == 1) { ed = f64_add(0x3CC0_0000_0000_0000, f64_mul(rd, 0x39B0_0000_0000_0000)); }   # 2^-100
    return f64_add(e, f64_mul(_geo_absmax_bits(op), ed));
}

# 1 when a barrel solved in floating point (_geo_barrel_fast / _geo_sph_solve, at the solve's scale:
# o_perp op, d_perp dp, radius rb, roots at rt when hit is 1) stands against the line's error e
# (_geo_barrel_err) (3.4.1 GEO4): r^2 - |f|^2 (f the line's offset from the axis) is within ed = 4 (|f| + rb) e +
# e^2 + 2^-50 (rb^2 + |f|^2) of the solve's. A miss stands when r^2 - |f|^2 is under -ed; a hit when it is over ed,
# and each root ahead of the origin, as a distance across the axis (s_par -+ h, h = sqrt(r^2 - |f|^2)), moved by
# rb e / h, moves by under 2^-49 of itself: a ray from that far whose offset is not near r keeps the plain solve's
# few ulps, and one grazing the barrel is solved exactly. (All of it at op's and dp's own scale: f and the distances
# do not depend on dp's. t is that distance over |dp|, whose own rounding is another 2^-52 |d| / |dp| of it: a ray
# within 1/8 of the axis has dp formed fine, _geo_dperp_fine, and that is 2^-51; past 1/8 it is under 2^-49.)
fn _geo_barrel_cert(op, dp, rb, e, hit) {
    var a = hvec3_dot(dp, dp);
    var rbb = f64_mul(rb, rb);
    var k = f64_div(hvec3_dot(op, dp), a);
    var fx = f64_sub(HVec3_x(op), f64_mul(k, HVec3_x(dp)));
    var fy = f64_sub(HVec3_y(op), f64_mul(k, HVec3_y(dp)));
    var fz = f64_sub(HVec3_z(op), f64_mul(k, HVec3_z(dp)));
    var ff = f64_add(f64_add(f64_mul(fx, fx), f64_mul(fy, fy)), f64_mul(fz, fz));
    # (|f|^2 moves by 2 |f| e + e^2: 4 (|f| + rb) e + e^2 bounds it with the f near rb, and holds where
    # the computed f is itself the error, an offset of a few 2^-1074 against o - start's 2^-54)
    var ed = f64_mul(f64_mul(f64_add(f64_sqrt(ff), rb), e), _GEO_F64_FOUR);
    ed = f64_add(ed, f64_add(f64_mul(e, e), f64_mul(f64_add(rbb, ff), 0x3CD0_0000_0000_0000)));   # 2^-50
    var dl = f64_sub(rbb, ff);
    if (hit == 0) {
        if (f64_lt(dl, f64_neg(ed)) == 1) { return 1; }
        return 0;
    }
    if (f64_gt(dl, ed) == 0) { return 0; }
    # the roots as distances across the axis, s_par -+ h (s_par the closest approach's), each moved by
    # rb e / h
    var h = f64_sqrt(dl);
    var sp = f64_div(f64_neg(hvec3_dot(op, dp)), f64_sqrt(a));
    var mv = f64_div(f64_mul(rb, e), h);
    var s1 = f64_sub(sp, h);
    var s2 = f64_add(sp, h);
    if (f64_lt(s1, 0) == 0) {
        if (f64_lt(mv, f64_mul(s1, 0x3CE0_0000_0000_0000)) == 0) { return 0; }   # 2^-49
    }
    if (f64_lt(s2, 0) == 0) {
        if (f64_lt(mv, f64_mul(s2, 0x3CE0_0000_0000_0000)) == 0) { return 0; }
    }
    return 1;
}

# _geo_cap_xsolve for a ray and capsule whose inputs are finite (r >= 0, end != start, d != 0), or
# 0x7FF8_0000_0000_0003 (the caller goes on) (3.4.1 GEO4).
fn _geo_cap_xroute(ray, capsule, out) {
    var r = GeoCapsule_radius(capsule);
    var fin = _geo_hvec3_finite(GeoRay_origin(ray)) + _geo_hvec3_finite(GeoRay_direction(ray));
    fin = fin + _geo_hvec3_finite(GeoCapsule_start(capsule)) + _geo_hvec3_finite(GeoCapsule_end(capsule));
    if (fin != 4) { return 0x7FF8_0000_0000_0003; }
    if (f64_lt(r, 0) == 1 || f64_lt(r, _GEO_F64_POS_INF) == 0) { return 0x7FF8_0000_0000_0003; }
    if (_geo_absmax_bits(GeoRay_direction(ray)) == 0) { return 0x7FF8_0000_0000_0003; }
    return _geo_cap_xsolve(ray, capsule, out);
}

# 1 when a barrel entry root t1 (and the exit t2, the plain d_perp, d . d and r^2) is well conditioned
# (3.4.1 GEO4): the half-chord (t2 - t1) |d_perp| / 2 at least r / 4 and d_perp at least 2^-10 of d,
# so the root's error, and its segment coordinate's, is a few ulps of |o - start| over |u|, inside what
# sends a root near an end plane to the exact solve (within 2^-20 of the plane, _geo_seam_doubt's w). Then the
# caps cannot come first and need not be solved.
fn _geo_barrel_entry_ok(t1, t2, dperp, ddd, rbb) {
    var dpp = hvec3_dot(dperp, dperp);
    if (f64_lt(dpp, f64_mul(ddd, 0x3EB0_0000_0000_0000)) == 1) { return 0; }   # 2^-20
    var hw = f64_mul(f64_sub(t2, t1), F64_HALF);
    var hh = f64_mul(f64_mul(hw, hw), dpp);
    if (f64_lt(hh, f64_mul(rbb, 0x3FB0_0000_0000_0000)) == 1) { return 0; }   # 1/16
    if (f64_lt(hh, _GEO_F64_POS_INF) == 0) { return 0; }
    return 1;
}

# 1 when a barrel root's segment coordinate proj may be on the other side of an end plane than it reads
# (3.4.1 GEO4): within 4 times its own rounding, 2^-48 (|o - start| + |t| |d|) / |u| (largest
# components), and the root's move under the line's error e (_geo_barrel_err) carried to the
# coordinate, e r |d| / (|u| |d_perp| h) with h = (t2 - t1) |d_perp| / 2 the half-chord: the root of a ray
# grazing the barrel is that ill-conditioned, so near a seam its side is decided exactly. A half-chord of 0 is
# always in doubt.
fn _geo_seam_doubt(proj, t, t1, t2, ao, e, dperp, ddd, uu, rb, dir, u) {
    var um = _geo_absmax_bits(u);
    var w = f64_add(_geo_absmax_bits(ao), f64_mul(f64_abs(t), _geo_absmax_bits(dir)));
    w = f64_div(f64_mul(w, 0x3CF0_0000_0000_0000), um);   # 2^-48
    var dpp = hvec3_dot(dperp, dperp);
    var hd = f64_mul(f64_mul(f64_sub(t2, t1), F64_HALF), dpp);   # h |d_perp|
    if (f64_gt(hd, 0) == 0) { return 1; }
    w = f64_add(w, f64_div(f64_mul(f64_mul(e, rb), f64_sqrt(ddd)), f64_mul(f64_sqrt(uu), hd)));
    w = f64_mul(w, _GEO_F64_FOUR);
    if (f64_lt(w, _GEO_F64_POS_INF) == 0) { return 1; }
    if (f64_le(f64_abs(proj), w) == 1 || f64_le(f64_abs(f64_sub(proj, F64_ONE)), w) == 1) { return 1; }
    return 0;
}

# The far copy's certificate (3.4.1 GEO4, _geo_capsule_far): the ray (P, D) and the capsule [0, U],
# radius R, at the copy's scale, each point of the true geometry within ein of the copy's. The
# line's distance g from the segment is min over w in [0, 1] of |(w U - P) x D| / |D| (w at
# ((P x D) . n) / |n|^2 clamped, n = U x D), 1-Lipschitz in the geometry, so the true one is within
# 2 ein of the copy's, and the float g within 2^-45 (|P| + |U|) of it: past R by more than both, the
# miss (0). Within, the hit, whose entry's piece is read from the segment coordinate of the line's
# entry into the cylinder, w* - h (U . D) / (|U| |n|), h = sqrt(R^2 - f^2) (f the line's distance from
# the axis), which moves by el / |U| + el |D| R / (|n| h) when the geometry moves by e, el = e (1 + |w*| + |sh|)
# (the far end of U moves too, and the axis turns about the start); or, within 2^-20 of parallel, from the line's
# distance rho from the axis where it crosses the near end plane: under R by 4 e, the near cap. A piece is
# certified 4 times that from each end plane; out[0] is its branch and out[1] the entry root's error at the copy's
# scale, e R / (|D| h) times 4 for a cap and 4 e |U| R / (|n| h) for the barrel. Returns 1 (certified hit), 0 (the
# miss) or -1 (not certified: the caller solves exactly).
fn _geo_cap_far_cert(cray, ccap, ein, out) {
    var p = load64(cray);
    var dv = load64(cray + 8);
    var u = load64(ccap + 8);
    var rr = load64(ccap + 16);
    var px = HVec3_x(p);
    var py = HVec3_y(p);
    var pz = HVec3_z(p);
    var dx = HVec3_x(dv);
    var dy = HVec3_y(dv);
    var dz = HVec3_z(dv);
    var ux = HVec3_x(u);
    var uy = HVec3_y(u);
    var uz = HVec3_z(u);
    # n = U x D, m = P x D
    var nx = f64_sub(f64_mul(uy, dz), f64_mul(uz, dy));
    var ny = f64_sub(f64_mul(uz, dx), f64_mul(ux, dz));
    var nz = f64_sub(f64_mul(ux, dy), f64_mul(uy, dx));
    var mx = f64_sub(f64_mul(py, dz), f64_mul(pz, dy));
    var my = f64_sub(f64_mul(pz, dx), f64_mul(px, dz));
    var mz = f64_sub(f64_mul(px, dy), f64_mul(py, dx));
    var nn = f64_add(f64_add(f64_mul(nx, nx), f64_mul(ny, ny)), f64_mul(nz, nz));
    var dd = f64_add(f64_add(f64_mul(dx, dx), f64_mul(dy, dy)), f64_mul(dz, dz));
    var uu = f64_add(f64_add(f64_mul(ux, ux), f64_mul(uy, uy)), f64_mul(uz, uz));
    var ud = f64_add(f64_add(f64_mul(ux, dx), f64_mul(uy, dy)), f64_mul(uz, dz));
    # (Near parallel n's plain products cancel: its rounding, 2^-53 |U| |D| / |n| of itself, moved f past e and
    # a label with it. Each component then a difference of exact products, _geo_dpd.)
    if (f64_lt(nn, f64_mul(f64_mul(uu, dd), 0x3F30_0000_0000_0000)) == 1) {   # 2^-12
        nx = _geo_dpd(uy, dz, uz, dy);
        ny = _geo_dpd(uz, dx, ux, dz);
        nz = _geo_dpd(ux, dy, uy, dx);
        nn = f64_add(f64_add(f64_mul(nx, nx), f64_mul(ny, ny)), f64_mul(nz, nz));
    }
    var dl = f64_sqrt(dd);
    var ws = 0;
    if (f64_gt(nn, 0) == 1) {
        ws = f64_div(f64_add(f64_add(f64_mul(mx, nx), f64_mul(my, ny)), f64_mul(mz, nz)), nn);
    }
    var wc = ws;
    if (f64_lt(wc, 0) == 1) { wc = 0; }
    if (f64_gt(wc, F64_ONE) == 1) { wc = F64_ONE; }
    var vx = f64_sub(f64_mul(wc, nx), mx);
    var vy = f64_sub(f64_mul(wc, ny), my);
    var vz = f64_sub(f64_mul(wc, nz), mz);
    var gq = f64_div(f64_sqrt(f64_add(f64_add(f64_mul(vx, vx), f64_mul(vy, vy)), f64_mul(vz, vz))), dl);
    var pm = _geo_absmax_bits(p);
    var um = _geo_absmax_bits(u);
    var eg = f64_mul(ein, F64_TWO);   # (the geometry's error: the root moves by it)
    var e = f64_add(eg, f64_mul(f64_add(pm, um), 0x3D20_0000_0000_0000));   # (and this g's own: 2^-45)
    if (f64_gt(gq, f64_add(rr, e)) == 1) { return 0; }
    if (f64_lt(gq, f64_sub(rr, e)) == 0) { return 0 - 1; }
    var ul = f64_sqrt(uu);
    var lam = 0;
    var eta = 0;
    var br = GEO_CAP_CYLINDER;
    if (f64_gt(nn, f64_mul(f64_mul(uu, dd), 0x3D70_0000_0000_0000)) == 1) {   # 2^-40
        var nl = f64_sqrt(nn);
        var f = f64_div(f64_abs(f64_add(f64_add(f64_mul(px, nx), f64_mul(py, ny)), f64_mul(pz, nz))), nl);
        var hh = f64_sub(f64_mul(rr, rr), f64_mul(f, f));
        if (f64_gt(hh, 0) == 0) { return 0 - 1; }
        var h = f64_sqrt(hh);
        var sh = f64_div(f64_mul(h, ud), f64_mul(ul, nl));
        lam = f64_sub(ws, sh);
        var et = f64_div(f64_mul(f64_mul(eg, ul), rr), f64_mul(nl, h));   # the barrel root's move
        # (U's far end moves by ein too, which turns the axis: the line's offset moves by e times the
        # coordinate it is read at, ws, and h with it, and the slope sh / h by e |sh| / |U| of itself)
        var el = f64_mul(e, f64_add(F64_ONE, f64_add(f64_abs(ws), f64_abs(sh))));
        eta = f64_add(f64_div(el, ul), f64_div(f64_mul(f64_div(f64_mul(f64_mul(el, ul), rr), f64_mul(nl, h)), dl), ul));
        var ef = f64_mul(f64_add(f64_abs(ws), f64_abs(sh)), 0x3D00_0000_0000_0000);   # 2^-47, its own rounding
        eta = f64_add(f64_mul(eta, _GEO_F64_FOUR), ef);
        if (f64_lt(lam, eta) == 0 && f64_gt(lam, f64_sub(F64_ONE, eta)) == 0) {
            store64(out, GEO_CAP_CYLINDER);
            store64(out + 8, f64_mul(et, _GEO_F64_FOUR));
            return 1;
        }
        if (f64_lt(lam, f64_neg(eta)) == 1) { br = GEO_CAP_START_CAP; }
        elif (f64_gt(lam, f64_add(F64_ONE, eta)) == 1) { br = GEO_CAP_END_CAP; }
        else { return 0 - 1; }
    } else {
        # (near parallel: the line's piece is decided where it crosses the near end plane. Inside the
        # cylinder there, by more than the errors, the line entered it before the segment and the near cap
        # answers; outside it enters the barrel past the plane, however near the axis the line then comes,
        # and fc < R is no test of that: at rho / R - 1 under sin^2 / 2 it still reads the cap.)
        if (f64_eq(ud, 0) == 1) { return 0 - 1; }
        br = GEO_CAP_END_CAP;
        var ckx = ux;
        var cky = uy;
        var ckz = uz;
        if (f64_gt(ud, 0) == 1) {
            br = GEO_CAP_START_CAP;
            ckx = 0;
            cky = 0;
            ckz = 0;
        }
        var wk = f64_div(f64_add(f64_add(f64_mul(f64_sub(ckx, px), ux), f64_mul(f64_sub(cky, py), uy)),
            f64_mul(f64_sub(ckz, pz), uz)), ud);
        var xx = f64_sub(f64_add(px, f64_mul(wk, dx)), ckx);
        var xy = f64_sub(f64_add(py, f64_mul(wk, dy)), cky);
        var xz = f64_sub(f64_add(pz, f64_mul(wk, dz)), ckz);
        var rho = f64_sqrt(f64_add(f64_add(f64_mul(xx, xx), f64_mul(xy, xy)), f64_mul(xz, xz)));
        if (f64_lt(rho, f64_sub(rr, f64_mul(e, _GEO_F64_FOUR))) == 0) { return 0 - 1; }
    }
    # the cap's chord: f_c = |(P - C) x D| / |D|
    var cx = mx;
    var cy = my;
    var cz = mz;
    if (br == GEO_CAP_END_CAP) {
        cx = f64_sub(mx, nx);
        cy = f64_sub(my, ny);
        cz = f64_sub(mz, nz);
    }
    var fc2 = f64_div(f64_add(f64_add(f64_mul(cx, cx), f64_mul(cy, cy)), f64_mul(cz, cz)), dd);
    var hc2 = f64_sub(f64_mul(rr, rr), fc2);
    if (f64_gt(hc2, 0) == 0) { return 0 - 1; }
    store64(out, br);
    store64(out + 8, f64_div(f64_mul(f64_mul(eg, rr), _GEO_F64_FOUR), f64_mul(dl, f64_sqrt(hc2))));
    return 1;
}

# The plain segment test's rounding scale for geo_ray_capsule_branch's window (3.3.7):
# returns 2^-48 (|o| + |start|), writes 2^-48 |d| to w1 and |ab| to wab (largest components,
# the sum and products of their bit patterns read as doubles: each is a non-negative double).
fn _geo_seam_window(ray, capsule, ab, w1, wab) {
    var o = GeoRay_origin(ray);
    var st = GeoCapsule_start(capsule);
    var d = GeoRay_direction(ray);
    store64(w1, f64_mul(_geo_absmax_bits(d), 0x3CF0_0000_0000_0000));   # 2^-48
    store64(wab, _geo_absmax_bits(ab));
    return f64_mul(f64_add(_geo_absmax_bits(o), _geo_absmax_bits(st)), 0x3CF0_0000_0000_0000);
}

# The segment coordinate's stand-in for _geo_barrel_seam_x's answer (-1, 2, 0): -1, 2 or 1/2.
fn _geo_seam_stand(sx) {
    if (sx == 0 - 1) { return f64_neg(F64_ONE); }
    if (sx == 2) { return F64_TWO; }
    return F64_HALF;
}

# For a barrel root root_i whose segment coordinate proj (formed from p = o + t d) is within its
# own rounding of 0 or 1 (the caller's window, _geo_seam_window), a stand-in that is right by
# sign (3.3.7): -1 or 2 off the segment, 0.5 on it. p carries about 2^-53 (|o| + |t d|),
# which is more than a thin barrel's own radius; the root's side of each end plane is taken
# instead from where the root lies against the inputs: with w = o - end point, w_d its part
# across d (_geo_perp_part, its rounding carried), h = sqrt(r^2 - f^2) for f the offset of the
# ray's line from the axis (_geo_cap_axis_offset), and s = -1 for the near root, +1 for the far,
#     (p - end point) . ab  has the sign of  (ab . w_d) |ab| (d . d) + s h (d . ab) |ab x d|.
# Finite input whose ab and differences do not overflow only: otherwise proj is returned.
fn _geo_cap_seam_proj(ray, capsule, ab, t, proj, root_i) {
    var o = GeoRay_origin(ray);
    var d = GeoRay_direction(ray);
    var st = GeoCapsule_start(capsule);
    var r = GeoCapsule_radius(capsule);
    var en = GeoCapsule_end(capsule);
    var nf = _geo_hvec3_nonfinite(o) + _geo_hvec3_nonfinite(d) + _geo_hvec3_nonfinite(st) + _geo_hvec3_nonfinite(en);
    if (nf + _geo_hvec3_nonfinite(ab) != 0 || f64_lt(f64_abs(r), _GEO_F64_POS_INF) == 0) { return proj; }
    var wat: i64[3];
    var wbt: i64[3];
    var dst: i64[3];
    var abt: i64[3];
    var tv: i64[3];
    var tc: i64[3];
    var wa = _geo_sub_to(&wat, o, st);
    var wb = _geo_sub_to(&wbt, o, en);
    if (_geo_hvec3_nonfinite(wa) + _geo_hvec3_nonfinite(wb) != 0) { return proj; }
    var md = _geo_absmax_bits(d);
    var mab = _geo_absmax_bits(ab);
    if (md == 0 || mab == 0) { return proj; }
    var mw = _geo_absmax_bits(wa);
    var mb = _geo_absmax_bits(wb);
    if (mb > mw) { mw = mb; }
    var mr = r & 0x7FFF_FFFF_FFFF_FFFF;
    if (mr > mw) { mw = mr; }
    var s0 = _geo_scale_for(mw >> 52);
    var ds = _geo_scale_to(&dst, d, _geo_scale_for(md >> 52));
    var abs_ = _geo_scale_to(&abt, ab, _geo_scale_for(mab >> 52));
    var bx[64];
    store64(&bx, ray);
    store64(&bx + 8, capsule);
    store64(&bx + 16, wa);
    store64(&bx + 24, 0);
    store64(&bx + 32, ab);
    store64(&bx + 40, F64_ONE);
    store64(&bx + 48, 0);
    store64(&bx + 56, (s0 >> 52) - 1023);
    var fb[24];
    if (_geo_cap_axis_offset(&bx, &fb) == 0) { return proj; }
    var rs = f64_mul(r, s0);
    var mf = _geo_absmax_bits(&fb);
    var mr2 = rs & 0x7FFF_FFFF_FFFF_FFFF;
    if (mr2 > mf) { mf = mr2; }
    var s2 = _geo_scale_for(mf >> 52);
    var fst: i64[3];
    var fs = _geo_scale_to(&fst, &fb, s2);
    var rs2 = f64_mul(rs, s2);
    var hh = f64_sub(f64_mul(rs2, rs2), hvec3_dot(fs, fs));
    if (f64_lt(hh, 0) == 1) { hh = 0; }
    var h = f64_div(f64_sqrt(hh), s2);
    _geo_cross_into(abs_, ds, &tc);
    var nc = hvec3_length(&tc);
    var t2 = f64_mul(f64_mul(h, hvec3_dot(ds, abs_)), nc);
    if (root_i == 0) { t2 = f64_neg(t2); }
    var k1 = f64_mul(hvec3_length(abs_), hvec3_dot(ds, ds));
    var lo[24];
    var wp[24];
    _geo_oc_lo(o, st, F64_ONE, wa, &lo);
    _geo_perp_part(_geo_scale_to(&tv, wa, s0), ds, &wp);
    _geo_add_perp(&wp, _geo_scale_to(&tv, &lo, s0), ds);
    if (f64_lt(f64_add(f64_mul(hvec3_dot(abs_, &wp), k1), t2), 0) == 1) { return f64_neg(F64_ONE); }
    _geo_oc_lo(o, en, F64_ONE, wb, &lo);
    _geo_perp_part(_geo_scale_to(&tv, wb, s0), ds, &wp);
    _geo_add_perp(&wp, _geo_scale_to(&tv, &lo, s0), ds);
    if (f64_gt(f64_add(f64_mul(hvec3_dot(abs_, &wp), k1), t2), 0) == 1) { return F64_TWO; }
    return F64_HALF;
}

# ================================================================
# A capsule with an infinite end or a radius that is not finite and positive (3.4.0)
# ================================================================
# A capsule is the set of points within r of the segment [S, E]. The roadmap's [3.4.0]
# contract, from that definition:
#   * r < 0 (-Inf and -DBL_MAX included): the set is empty, the miss 0 (GEO_FACE_NONE).
#   * r = +Inf with an axis that has a limit (below): every point is within r, the origin is
#     inside, and the contract for an origin inside a capsule answers its exit, which is past
#     every distance: +Inf, branch the piece the exit lies on as the radius grows (the end cap
#     for d . (E - S) > 0, the start cap below 0, at 0 the piece across from the origin).
#   * E - S with exactly one infinite component, along axis k (one end infinite there, or S and
#     E infinite there with opposite signs): the set is the limit of [S, E_m] as E_m -> E. With
#     one end F finite it is the half-infinite capsule from F along +-e_k: F's cap on its own
#     side of the plane through F across e_k, and the barrel of radius r about F's line along
#     e_k on the other side, unbounded. (Only the sign along k survives in the limit: the other
#     components of the infinite end drop out.) With both ends infinite along k the limit of
#     [S_m, E_m] is the whole line, the infinite cylinder, when their other two components are
#     equal, and depends on the rates at which they go to infinity when they are not: the miss.
#   * Two or more infinite components in E - S, or Inf - Inf (both ends infinite on the same
#     side): no direction has a limit, there is no set, the miss.
# ⚠ NOT DONE HERE, AND REPORTED: the contract's "a NaN radius or any NaN coordinate is the miss"
# contradicts the documented 3.3.3 decision below (a NaN end, a NaN start and a NaN radius are
# NaN out, pinned in tests/modules.tcyr and tests/abuse.tcyr, as every other ray routine propagates
# a NaN input). A NaN keeps that contract: the general code below answers it.
# Inputs this cannot answer from the limit: a ray with an infinite origin or direction against a
# capsule with an infinite end has no computed answer here, NaN (as geo_closest_point_on_triangle
# answers an infinite input); a NaN ray coordinate is NaN out; a zero direction is the miss, as
# for every capsule.
# The return is the answer, or 0x7FF8_0000_0000_0002 when the capsule is finite with a finite
# radius of 0 or more (or has a NaN): the caller goes on.
# [measured: rt340 non-finite capsule probe (capinf.py), exact Fraction oracle, 3.4.0 base vs this tree, 2026-10-31]
fn _geo_capsule_nonfinite(ray, capsule, out) {
    var r = GeoCapsule_radius(capsule);
    var st = GeoCapsule_start(capsule);
    var en = GeoCapsule_end(capsule);
    if (f64_lt(r, 0) == 1) { return 0; }   # empty (not -0: f64_lt(-0, 0) is 0)
    if (f64_eq(r, r) == 0 || _geo_hvec3_nan(st) != 0 || _geo_hvec3_nan(en) != 0) { return 0x7FF8_0000_0000_0002; }
    var fin = 1 - _geo_hvec3_nonfinite(st) - _geo_hvec3_nonfinite(en);
    if (fin == 1 && f64_lt(r, _GEO_F64_POS_INF) == 1) { return 0x7FF8_0000_0000_0002; }
    var o = GeoRay_origin(ray);
    var d = GeoRay_direction(ray);
    var rn = _geo_hvec3_nan(o);
    if (rn == 0) { rn = _geo_hvec3_nan(d); }
    if (rn != 0) { return rn; }
    if (_geo_absmax_bits(d) == 0) { return 0; }
    # The axis: k and its sign for one infinite component of E - S, kind 1 (one end infinite,
    # F = the finite one, fb its cap's branch) or 2 (both, the infinite cylinder); kind 0 for a
    # finite E - S, -1 for no limit.
    var kind = 0;
    var k = 0 - 1;
    var sg = F64_ONE;
    var nk = 0;
    for (var i = 0; i < 3; i = i + 1) {
        var si = load64(st + i * 8);
        var ei = load64(en + i * 8);
        var di = f64_sub(ei, si);
        if (f64_eq(di, di) == 0) { return 0; }   # Inf - Inf: no limit
        if (f64_lt(f64_abs(di), _GEO_F64_POS_INF) == 0) {
            nk = nk + 1;
            k = i;
            if (f64_lt(di, 0) == 1) { sg = f64_neg(F64_ONE); }
        }
    }
    if (nk > 1) { return 0; }   # no limit
    var fp = st;
    var fb = GEO_CAP_START_CAP;
    if (nk == 1) {
        var sk = load64(st + k * 8);
        var ek = load64(en + k * 8);
        var sinf = f64_lt(f64_abs(sk), _GEO_F64_POS_INF) == 0;
        var einf = f64_lt(f64_abs(ek), _GEO_F64_POS_INF) == 0;
        kind = 1;
        if (sinf == 1 && einf == 1) {
            # Both ends infinite along k: the line only when they agree off it.
            for (var j = 0; j < 3; j = j + 1) {
                if (j != k) {
                    if (f64_eq(load64(st + j * 8), load64(en + j * 8)) == 0) { return 0; }
                }
            }
            kind = 2;
        } elif (sinf == 1) {
            # The start is the infinite end: the capsule runs from E toward the start's infinity.
            fp = en;
            fb = GEO_CAP_END_CAP;
            sg = f64_neg(sg);
        }
    }
    # (An infinite ray with an infinite end: no answer is computed, see the header.)
    if (kind != 0) {
        if (_geo_hvec3_nonfinite(o) + _geo_hvec3_nonfinite(d) != 0) {
            return f64_sub(_GEO_F64_POS_INF, _GEO_F64_POS_INF);
        }
    }
    if (r == 0x7FF0_0000_0000_0000) {
        # All of space: the exit +Inf, on the piece the exit lies on as r grows.
        var br = GEO_CAP_CYLINDER;
        if (kind == 0) {
            var ut: i64[3];
            var h0: i64[3];
            var h1: i64[3];
            var u = _geo_sub_to(&ut, en, st);
            if (_geo_hvec3_nonfinite(u) == 1) {
                u = _geo_sub_to(&ut, _geo_scale_to(&h0, en, F64_HALF), _geo_scale_to(&h1, st, F64_HALF));
            }
            u = _geo_scale_to(&ut, u, _geo_scale_for(_geo_absmax_bits(u) >> 52));
            var du = hvec3_dot(_geo_scale_to(&h0, d, _geo_scale_for(_geo_absmax_bits(d) >> 52)), u);
            if (f64_gt(du, 0) == 1) { br = GEO_CAP_END_CAP; }
            elif (f64_lt(du, 0) == 1) { br = GEO_CAP_START_CAP; }
            elif (_geo_absmax_bits(u) == 0) { br = GEO_CAP_SPHERE; }
            else {
                # d across the axis: the origin's own coordinate along it decides.
                var pr = _geo_cap_proj_u(o, st, u, hvec3_dot(u, u), 0);
                var pe = _geo_cap_proj_u(o, en, u, hvec3_dot(u, u), 0);
                if (f64_lt(pr, 0) == 1) { br = GEO_CAP_START_CAP; }
                elif (f64_gt(pe, 0) == 1) { br = GEO_CAP_END_CAP; }
            }
        } elif (kind == 1) {
            var dk = f64_mul(load64(d + k * 8), sg);
            if (f64_lt(dk, 0) == 1) { br = fb; }
            elif (f64_eq(dk, 0) == 1) {
                if (f64_lt(f64_mul(f64_sub(load64(o + k * 8), load64(fp + k * 8)), sg), 0) == 1) { br = fb; }
            }
        }
        if (out != 0) { store64(out, br); }
        return _GEO_F64_POS_INF;
    }
    if (kind == 0) { return 0x7FF8_0000_0000_0002; }   # (r finite: not reached; kept for the reader)
    return _geo_capsule_ray_inf(ray, fp, k, sg, r, kind, fb, out);
}

# The half-infinite capsule (kind 1: F's cap on its side, the barrel from F along sg e_k, with no
# end) or the infinite cylinder along e_k through F (kind 2), for a finite ray and a finite r of 0
# or more (3.4.0, _geo_capsule_nonfinite). The barrel about a line along e_k is a circle in the
# other two coordinates, so its roots are those of the sphere about F with F's k-th coordinate
# replaced by o's, met along d with its k-th component 0 (_geo_sphere_roots, every repair of the
# sphere's quadratic with it); a root is on the barrel where sg (o_k + t d_k - F_k) >= 0. The cap
# is F's sphere, a root on it where that is <= 0. The two meet tangentially at the seam, where
# each is accepted within the rounding of its own coordinate (2^-48 of |o_k - F_k| + |t d_k|), so
# a crossing there is not lost between them. The answer is the least accepted root >= 0.
fn _geo_capsule_ray_inf(ray, fp, k, sg, r, kind, fb, out) {
    var o = GeoRay_origin(ray);
    var d = GeoRay_direction(ray);
    var ok = load64(o + k * 8);
    var dk = load64(d + k * 8);
    var fk = load64(fp + k * 8);
    var ofk = f64_sub(ok, fk);
    var best = 0;
    var found = 0;
    var branch = GEO_FACE_NONE;
    var rt[16];
    var sph[16];
    var cc[24];
    var d2[24];
    var r2[16];
    for (var i = 0; i < 3; i = i + 1) {
        store64(&cc + i * 8, load64(fp + i * 8));
        store64(&d2 + i * 8, load64(d + i * 8));
    }
    store64(&cc + k * 8, ok);
    store64(&d2 + k * 8, 0);
    store64(&sph, &cc);
    store64(&sph + 8, r);
    store64(&r2, o);
    store64(&r2 + 8, &d2);
    if (_geo_absmax_bits(&d2) != 0) {
        if (_geo_sphere_roots(&r2, &sph, &rt) == 1) {
            for (var j = 0; j < 2; j = j + 1) {
                var t = load64(&rt + j * 8);
                if (f64_lt(t, 0) == 0) {
                    var tdk = f64_mul(t, dk);
                    var lam = f64_mul(f64_add(ofk, tdk), sg);
                    var win = f64_mul(f64_add(f64_abs(ofk), f64_abs(tdk)), 0x3CF0_0000_0000_0000);   # 2^-48
                    if (kind == 2 || f64_lt(f64_add(lam, win), 0) == 0) {
                        if (found == 0 || f64_lt(t, best) == 1) {
                            best = t;
                            branch = GEO_CAP_CYLINDER;
                            found = 1;
                        }
                    }
                }
            }
        }
    }
    if (kind == 1) {
        store64(&sph, fp);
        if (_geo_sphere_roots(ray, &sph, &rt) == 1) {
            for (var m = 0; m < 2; m = m + 1) {
                var tc = load64(&rt + m * 8);
                if (f64_lt(tc, 0) == 0) {
                    var tdk2 = f64_mul(tc, dk);
                    var lam2 = f64_mul(f64_add(ofk, tdk2), sg);
                    var win2 = f64_mul(f64_add(f64_abs(ofk), f64_abs(tdk2)), 0x3CF0_0000_0000_0000);
                    if (f64_gt(f64_sub(lam2, win2), 0) == 0) {
                        if (found == 0 || f64_lt(tc, best) == 1) {
                            best = tc;
                            branch = fb;
                            found = 1;
                        }
                    }
                }
            }
        }
    }
    # A ray parallel to the axis from inside the solid, moving toward its unbounded end (either way
    # for the cylinder), never leaves it: the exits of [F, E_m] go to +Inf with E_m, on the barrel.
    # (Outside the barrel's section such a ray is the miss, or meets F's cap, found above.)
    if (found == 0 && _geo_absmax_bits(&d2) == 0) {
        var dsg = f64_mul(dk, sg);
        if (kind == 2 || f64_gt(dsg, 0) == 1) {
            # (Inside: |o - F|^2 - r^2 across the axis below 0, exactly with o - F's rounding.)
            var ocf[24];
            var olo[24];
            for (var m2 = 0; m2 < 3; m2 = m2 + 1) {
                store64(&ocf + m2 * 8, f64_sub(load64(o + m2 * 8), load64(fp + m2 * 8)));
            }
            _geo_oc_lo(o, fp, F64_ONE, &ocf, &olo);
            var ocs[24];   # (the whole o - F, kept for the sphere test: _geo_c_xact_sc scales in place)
            var ols[24];
            for (var m3 = 0; m3 < 3; m3 = m3 + 1) {
                store64(&ocs + m3 * 8, load64(&ocf + m3 * 8));
                store64(&ols + m3 * 8, load64(&olo + m3 * 8));
            }
            store64(&ocf + k * 8, 0);
            store64(&olo + k * 8, 0);
            if (f64_lt(_geo_c_xact_sc(&ocf, &olo, r), 0) == 1) {
                if (kind == 2 || f64_lt(f64_mul(ofk, sg), 0) == 0) { found = 2; }
                else {
                    # behind F: inside F's sphere it enters the barrel and stays
                    if (f64_lt(_geo_c_xact_sc(&ocs, &ols, r), 0) == 1) { found = 2; }
                }
            }
            if (found == 2) {
                if (out != 0) { store64(out, GEO_CAP_CYLINDER); }
                return _GEO_F64_POS_INF;
            }
        }
    }
    if (out != 0) { store64(out, branch); }
    return best;
}

# Ray-capsule intersection with the piece hit: the first t > 0 at which the ray meets the capsule
# (its exit for an origin inside), or 0 on a miss, with out[0] (when out != 0; out[1] is 0) the
# branch: GEO_CAP_CYLINDER, _START_CAP, _END_CAP, GEO_CAP_SPHERE for start == end, or
# GEO_FACE_NONE on a miss. The direction need not be unit. The infinite-end and radius contract is
# _geo_capsule_nonfinite's. NaN in, NaN out, and a NaN t is always GEO_FACE_NONE (3.4.1: through
# 3.4.0 a NaN ray component or radius came back tagged with a capsule branch).
# Accuracy (finite input, not every magnitude, largest components): the verdict and piece were exact on all but 3 of
# 216,561 sampled rays, within 3 ulps of barrel tangency and in the ordinary, near-axis, seam, far thin, near-parallel
# and surface-origin families, with r of 2^-484 or more, each coordinate, r and |d| under 2^510 and |d| times the
# largest of them under 2^512; those 3 have t past DBL_MAX and read the miss. With coordinates and r all under 2^-484
# they were exact on all 93,719 sampled. Past those limits, or with r under 2^-484 and coordinates above it, a ray
# within ulps of tangency can read the wrong verdict or t, as on 3.4.0. t is within 4 ulp on all but about 1 ray in
# 2,000 of ordinary capsules, at most 9.2 ulp (a barrel's near root with c one bit down). Coordinates spread across
# the whole exponent range can read NaN or the wrong verdict, and an infinite end has no near-tangent repair.
# Cost: an ordinary ray about 0.7 us, 1.1 us within 1/8 of the axis; a ray only the exact solve can answer
# (_geo_cap_xsolve) 3 to 8 us at ordinary scale, up to 1.6 ms on coordinates spread over the exponent range. The
# stack it needs is 64 to 72 KB.
# [measured: GEO 3.4.1 AU2-G2-F11 repro, exact Fraction oracle, 3.4.0 vs this tree, not in-tree, 2026-10-31]
# [measured: GEO6 3.4.1 families (fam.py, capb.py, capc.py, ext2.py, xt.py), exact Fraction oracle, 2026-11-01]
# [measured: GEO7 3.4.1 csamp.py capsule samples (gt.py, gcap.py), exact Fraction oracle, 3.4.0 / this tree, 2026-11-01]
public fn geo_ray_capsule_branch(ray, capsule, out) {
    var t = _geo_ray_capsule_branch0(ray, capsule, out);
    if (out != 0) {
        if (f64_eq(t, t) == 0) { store64(out, GEO_FACE_NONE); }
    }
    return t;
}

# geo_ray_capsule_branch's body (3.4.1: the public entry takes the tag off a NaN t).
fn _geo_ray_capsule_branch0(ray, capsule, out) {
    if (out != 0) {
        store64(out, GEO_FACE_NONE);
        store64(out + 8, 0);
    }
    # (3.4.0: ab, ao, d_perp and o_perp on the stack, each formed in hvec3_sub's and hvec3_scale's
    # order, so with the same bits, and without their six allocations; each root's segment
    # coordinate likewise, _geo_cap_proj0.)
    var abv[24];
    var ab = &abv;
    store64(ab, f64_sub(HVec3_x(GeoCapsule_end(capsule)), HVec3_x(GeoCapsule_start(capsule))));
    store64(ab + 8, f64_sub(HVec3_y(GeoCapsule_end(capsule)), HVec3_y(GeoCapsule_start(capsule))));
    store64(ab + 16, f64_sub(HVec3_z(GeoCapsule_end(capsule)), HVec3_z(GeoCapsule_start(capsule))));
    var ab_len_sq = hvec3_dot(ab, ab);
    # 3.4.0: a radius below 0 or +Inf, or an end that is not finite, takes the contract above
    # (_geo_capsule_nonfinite). One integer test on the radius (a negative double's bits are
    # negative, -0's included; +Inf and a positive NaN are 0x7FF0... and above) and the finiteness
    # of |ab|^2 (an infinite end makes it +Inf or NaN) keep the common capsule from the call.
    var rq = GeoCapsule_radius(capsule);
    if (rq < 0 || rq >= 0x7FF0_0000_0000_0000 || f64_lt(ab_len_sq, _GEO_F64_POS_INF) == 0) {
        var tn = _geo_capsule_nonfinite(ray, capsule, out);
        if (tn != 0x7FF8_0000_0000_0002) { return tn; }
    }
    # A capsule whose ab . ab is under 2^-968 may be tiny all through (_geo_capsule_tiny): the
    # rest of the routine then runs on its copy, on the stack, its barrel on the scaled path
    # (`tiny`, below), and the answer is multiplied back by 2^tiny_e.
    var tiny = 0;
    var tiny_e = 0;
    var tv[104];
    var tray[16];
    var tcap[24];
    if (f64_lt(ab_len_sq, 0x0370_0000_0000_0000) == 1) {   # 2^-968
        tiny_e = _geo_capsule_tiny(ray, capsule, &tv);
        if (tiny_e != 0x7FFF_FFFF) {
            store64(&tray, &tv);
            store64(&tray + 8, &tv + 24);
            store64(&tcap, &tv + 48);
            store64(&tcap + 8, &tv + 72);
            store64(&tcap + 16, load64(&tv + 96));
            ray = &tray;
            capsule = &tcap;
            ab = _geo_sub_to(&abv, &tv + 72, &tv + 48);   # end - start (3.4.0: the start need not be 0)
            ab_len_sq = hvec3_dot(ab, ab);
            tiny = 1;
        } else { tiny_e = 0; }
    }

    # Degenerate capsule: just a sphere.
    # 2.10.2: threshold was the unsquared EPSILON_F64 against a SQUARED length,
    # so every capsule shorter than 1e-6 was silently treated as a sphere at
    # `start`. Measured: capsule (0,0,0)-(s,0,0) with radius s/4 answers 1.75s at
    # every scale down to 1e-6 and then 0 (a miss) at 1e-7.
    # [measured: docs/development/issues/archived/2026-08-10-squared-epsilon-guards-in-geo-ray.md]
    # ⚠ 2.14.0: the threshold moved again, for the reason above it. `d_par` is
    # `dot(dir, ab) / ab_len_sq` with a unit `dir`, so |d_par| <= 1/|ab| and stays
    # finite for any non-zero ab_len_sq, subnormal included. Only an exact zero
    # makes a capsule genuinely a sphere.
    # ⛔ 3.3.3 — AND THE SPELLING OF THAT EXACT ZERO WAS NaN-TRUE. It was
    # `f64_gt(ab_len_sq, 0) == 0`, so a capsule whose END had a NaN coordinate was
    # taken for a sphere at its finite start and answered with a real-looking
    # hit: the ray from (-5,0,0) along +x against (0,0,0)-(NaN,0,0), r = 1,
    # returned t = 4 tagged GEO_CAP_SPHERE, and `geo_jet_capsule` built a full
    # jet on it. A NaN start, radius, ray origin or ray direction already
    # returned NaN.
    # ⚠ THE NaN EXIT AFTER THE SPHERE CASE IS THE OTHER HALF OF THE REPAIR. With
    # the exact zero alone the NaN reaches the body and is laundered there
    # instead: `_geo_cap_accepts` is NaN-true as well, and `f64_min(NaN, t)`
    # returns t. Measured with the exact zero alone: the NaN END comes out NaN but
    # tagged GEO_CAP_END_CAP, and a NaN START, (NaN,0,0)-(3,0,0) on the same ray —
    # NaN on 3.3.2, its sphere being centred on the NaN — becomes the end cap's
    # t = 7, with a jet. A NaN axis poisons every quantity below this point, so
    # it leaves with the NaN and the branch at GEO_FACE_NONE, and the jet reads
    # that as its miss. It is a NaN test, not the non-finite one: an infinite
    # axis is the scale class and keeps its 3.3.2 path. Propagate rather than
    # miss, because that is what the capsule's other NaN inputs and
    # `geo_ray_sphere` already do.
    # [measured: G6 probe, 3.3.2 + exact-zero-only variant, not reproducible in-tree, 2026-10-01; cycc 6.6.12]
    # ⛔ 3.3.7 — AND |ab|^2 IS 0 FOR EVERY ab UNDER 2^-537.5. Tested on the square, a capsule
    # shorter than that was this sphere at its start: the barrel and end cap were never
    # seen, and every hit came back GEO_CAP_SPHERE (its jet's endpoint gradients those of the
    # start alone), or a miss where the ray passes beside the start sphere but through the
    # barrel: (0,0,0)-(2^-600,0,0), r = 2^-602, from (2^-601, 1, 0) along -y, a barrel hit at
    # 1 - 3 * 2^-602, read the miss. The test is now on ab itself; a non-zero ab whose square
    # underflows takes the scaled axis below.
    var abz = 0;
    if (f64_eq(ab_len_sq, 0) == 1) { if (_geo_absmax_bits(ab) == 0) { abz = 1; } }
    if (abz == 1) {
        var sph: i64[2];   # (3.4.1: a GeoSphere on the stack, as the caps' spheres are)
        GeoSphere_set_center(&sph, GeoCapsule_start(capsule));
        GeoSphere_set_radius(&sph, GeoCapsule_radius(capsule));
        var dt = geo_ray_sphere(ray, &sph);
        if (out != 0) { if (dt != 0) { store64(out, GEO_CAP_SPHERE); } }
        if (tiny == 1) { dt = _geo_ldexp(dt, tiny_e); }
        return dt;
    }
    if (f64_eq(ab_len_sq, ab_len_sq) == 0) { return ab_len_sq; }

    # ⛔ 3.3.6 — A CAPSULE LONGER THAN 2^511.5 OVERFLOWED ab . ab: d_par and o_par read 0,
    # and the capsule (0,0,0)-(2^600, 0, 0) of radius 1 missed the ray from (5, 3, 0) along
    # -y, whose barrel hit is at t = 2. The projections, the proj test and the caps'
    # half-space tests only need the axis's direction, so where ab . ab is +Inf from finite
    # ends they use u = 2^eu ab, ab scaled to unit size (its ends halved first when ab
    # itself overflows), and proj is multiplied back by 2^eu. Otherwise u is ab and every
    # line below forms exactly what it did. (3.3.7: likewise where ab . ab is under 2^-968
    # and the capsule is not solved on _geo_capsule_tiny's copy, eu then being positive.)
    var hat: i64[3];
    var ust: i64[3];
    var u = ab;
    var uu = ab_len_sq;
    var us = 0;    # 1 when u is the multiple 2^eu * ab of the axis, not ab itself
    var eu = 0;
    var uh = 0;    # 1 when u was formed from the halved ends
    var usa = F64_ONE;   # u's power of two over the ab (or halved ab) it was formed from
    if (ab_len_sq == 0x7FF0_0000_0000_0000 || ab_len_sq < 0x0370_0000_0000_0000) {   # +Inf, or under 2^-968
        var ca = GeoCapsule_start(capsule);
        var cb = GeoCapsule_end(capsule);
        if (_geo_hvec3_nonfinite(ca) + _geo_hvec3_nonfinite(cb) == 0) {
            var ah = ab;
            if (_geo_hvec3_nonfinite(ab) == 1) {
                var hb: i64[3];
                var ha: i64[3];
                ah = _geo_sub_to(&hat, _geo_scale_to(&hb, cb, F64_HALF), _geo_scale_to(&ha, ca, F64_HALF));
                eu = 0 - 1;
                uh = 1;
            }
            var sa = _geo_scale_for(_geo_absmax_bits(ah) >> 52);
            u = _geo_scale_to(&ust, ah, sa);
            uu = hvec3_dot(u, u);
            us = 1;
            usa = sa;
            eu = eu + (sa >> 52) - 1023;
        }
    }

    # Closest approach of ray to segment axis (infinite cylinder test)
    var aov[24];
    var ao = &aov;
    store64(ao, f64_sub(HVec3_x(GeoRay_origin(ray)), HVec3_x(GeoCapsule_start(capsule))));
    store64(ao + 8, f64_sub(HVec3_y(GeoRay_origin(ray)), HVec3_y(GeoCapsule_start(capsule))));
    store64(ao + 16, f64_sub(HVec3_z(GeoRay_origin(ray)), HVec3_z(GeoCapsule_start(capsule))));
    # 3.3.6: o - start overflows for an origin more than DBL_MAX from the start (between
    # ends that far apart, or far from a short capsule), and o_par, o_perp and the barrel
    # read NaN: 1164 of 9066 rays along capsules whose ends are more than DBL_MAX apart
    # answered NaN. ao is then (o - start) / 2, exactly (oh = 1), the barrel is solved for
    # it and r / 2 on the scaled path, and its roots are doubled there. Finite input only.
    # With this, the proj and cap-side repairs below, those 9066 rays (3.3.5 wrong on
    # every one) are 8672 right and 394 wrong, each of the 394 from an origin at least
    # 2.3e5 radii from the start: projecting it onto the axis carries 2^-52 of that
    # distance, more than 4 ulp of the radius, unless the part across the axis is under
    # 2^-40 of it and the exact cross product (_geo_perp_rescue) forms it.
    # [measured: C336 far-capsule family (x7.py, seed 53), 3.3.5 vs this tree, 2026-10-11; cycc 6.6.14]
    var oh = 0;
    # (A non-finite component makes the sum non-finite; a finite sum that overflows only
    # sends ao to the exact test.)
    var aos = f64_add(f64_add(HVec3_x(ao), HVec3_y(ao)), HVec3_z(ao));
    if (f64_lt(f64_abs(aos), _GEO_F64_POS_INF) == 0) {
        if (_geo_hvec3_nonfinite(ao) == 1) {
            var fo = _geo_hvec3_nonfinite(GeoRay_origin(ray)) + _geo_hvec3_nonfinite(GeoCapsule_start(capsule));
            fo = fo + _geo_hvec3_nonfinite(GeoCapsule_end(capsule)) + _geo_hvec3_nonfinite(GeoRay_direction(ray));
            if (f64_lt(f64_abs(GeoCapsule_radius(capsule)), _GEO_F64_POS_INF) == 0) { fo = fo + 1; }
            if (fo == 0) {
                var ho: i64[3];
                var hs: i64[3];
                ao = _geo_sub_to(&aov, _geo_scale_to(&ho, GeoRay_origin(ray), F64_HALF),
                  _geo_scale_to(&hs, GeoCapsule_start(capsule), F64_HALF));
                oh = 1;
            }
        }
    }
    # A capsule far from the origin against its size is solved from where the ray passes it
    # (_geo_capsule_far, 3.3.7).
    # (A capsule that far has |o - start|^2 over 2^58 (|ab|^2 + r^2), so the exponents are read
    # only past that, or where that bound overflowed: it is false for every ray nearer.)
    var aoao = hvec3_dot(ao, ao);
    var rcap = GeoCapsule_radius(capsule);
    var farb = f64_mul(f64_add(ab_len_sq, f64_mul(rcap, rcap)), 0x4390_0000_0000_0000);   # 2^58
    if (oh == 0 && uh == 0 && (f64_gt(aoao, farb) == 1 || farb == 0x7FF0_0000_0000_0000)) {
        var mcap = _geo_absmax_bits(ab);
        var mrr = rcap & 0x7FFF_FFFF_FFFF_FFFF;
        if (mrr > mcap) { mcap = mrr; }
        if (mcap != 0 && (_geo_absmax_bits(ao) >> 52) > (mcap >> 52) + 30) {
            var tf = _geo_capsule_far(ray, capsule, ao, ab, out);
            if (tf != 0x7FF8_0000_0000_0001) {
                if (tiny == 1) { tf = _geo_ldexp(tf, tiny_e); }
                return tf;
            }
        }
    }
    var d_par = f64_div(hvec3_dot(GeoRay_direction(ray), u), uu);
    var o_par = f64_div(hvec3_dot(ao, u), uu);

    var dpv0[24];
    var opv0[24];
    var d_perp = &dpv0;
    var opt: i64[3];
    var o_perp = &opv0;
    store64(d_perp, f64_sub(HVec3_x(GeoRay_direction(ray)), f64_mul(HVec3_x(u), d_par)));
    store64(d_perp + 8, f64_sub(HVec3_y(GeoRay_direction(ray)), f64_mul(HVec3_y(u), d_par)));
    store64(d_perp + 16, f64_sub(HVec3_z(GeoRay_direction(ray)), f64_mul(HVec3_z(u), d_par)));
    store64(o_perp, f64_sub(HVec3_x(ao), f64_mul(HVec3_x(u), o_par)));
    store64(o_perp + 8, f64_sub(HVec3_y(ao), f64_mul(HVec3_y(u), o_par)));
    store64(o_perp + 16, f64_sub(HVec3_z(ao), f64_mul(HVec3_z(u), o_par)));
    # 3.3.6: d_perp and o_perp are the projections' remainders, which keep about 2^-52 of
    # d and ao along the axis; a part across the axis smaller than that, or a projection
    # that overflowed, is formed again from scaled copies without the subtraction
    # (_geo_perp_suspect, _geo_perp_rescue). For an origin 1.7 * 2^500 along the axis of
    # (0,0,0)-(1.3 * 2^501, 0, 0), 3 from it, 3.3.5 answered the barrel hit at t = 2 with
    # the miss.
    # [measured: C336 fixture probe, 3.3.5 vs this tree, 2026-10-11; cycc 6.6.14]
    var de = 0;     # the rescued d_perp is 2^de times the true one
    var dres = 0;
    var dfn = 0;    # 1 when it carries end - start's rounding too (_geo_dperp_fine)
    var dpv[24];
    var dir = GeoRay_direction(ray);
    var a = hvec3_dot(d_perp, d_perp);
    var r = GeoCapsule_radius(capsule);
    var rb = r;   # the barrel's radius, at ao's scale
    if (oh == 1) { rb = f64_mul(r, F64_HALF); }
    var rbb = f64_mul(rb, rb);
    var oo = hvec3_dot(o_perp, o_perp);
    var ddd = hvec3_dot(dir, dir);
    # A ray whose d_perp reads exactly 0 (a = 0, d . d at least 2^-968) is parallel to the
    # axis to within 7 * 2^-53 |d|, so across the segment's slab its distance from the axis
    # moves by under 14 * 2^-53 (|ao| + 2 |ab|), and o_perp's own rounding is 6 * 2^-53 |ao|.
    # When | |o_perp|^2 - r^2 | exceeds 2^-40 (|ao|^2 + |ab|^2 + r^2), | |o_perp| - r |
    # exceeds 2^-40.5 of that root, above both by 2^7: the barrel is not crossed on the
    # segment, and the caps answer (`par`, skipping both rescues below): a ray along a
    # capsule's axis, the bench's, no longer pays for two exact parts that are both 0.
    var par = 0;
    if (f64_eq(a, 0) == 1 && us == 0) {
        if (f64_lt(ddd, _GEO_DIR_LO) == 0) {
            var m2 = f64_add(f64_add(aoao, uu), rbb);
            if (f64_lt(m2, _GEO_F64_POS_INF) == 1 && f64_lt(m2, _GEO_DIR_LO) == 0) {
                if (f64_gt(f64_abs(f64_sub(oo, rbb)), f64_mul(m2, 0x3D70_0000_0000_0000)) == 1) { par = 1; }   # 2^-40
            }
        }
    }
    # ⛔ 3.3.7 — o_perp WITH ITS ROUNDING. ao - u o_par rounds each product u_i o_par and ao
    # itself (o - start), and ab (end - start) rounds too: o_perp is off by about 2^-52 |ao| in
    # every direction, which for an origin far along the axis is many ulps of r, and the barrel
    # root with it (the roadmap's ray 1.6e4 radii along was 4,993 ulp off; a median of 994 ulp
    # at 1e4 radii, 9.5e6 at 1e8). Where |ao| is over twice |o_perp| it is formed as
    # (ao + aol) - (u + ul) o_par with each product u_i o_par exact and the roundings aol and ul
    # of the two differences carried (_geo_cap_lows, _geo_perp_comp), the part along u that
    # o_par's rounding leaves removed by one more projection: off by about an ulp of itself
    # plus 2^-105 |ao|. (It is not needed nearer: there |ao| and |o_perp| are alike, and the
    # projection costs 114 floating-point operations and a division.) Not for a ray `par`, whose
    # barrel is skipped. Finite input whose magnitudes lie within 2^+-900 only; the exact cross
    # products below rescue the rest as before.
    # [measured: rt337 barrel families (fam2.py, seeds 201-203), exact roots, 3.3.6 vs this tree, 2026-10-31]
    var opc[24];
    var aol[24];
    var cmp = 0;
    if (oh == 0 && par == 0) {
        var cg = f64_gt(aoao, f64_mul(oo, _GEO_F64_FOUR));
        # (Where a square overflowed, |o - start| past 2^511, the same test by exponents.)
        if (f64_lt(f64_add(aoao, oo), _GEO_F64_POS_INF) == 0) {
            cg = 0;
            if ((_geo_absmax_bits(ao) >> 52) > (_geo_absmax_bits(o_perp) >> 52)) { cg = 1; }
        }
        if (cg == 1) {
            var ae = _geo_absmax_bits(ao) >> 52;
            var ue = _geo_absmax_bits(u) >> 52;
            if (ae > 123 && ae < 1923 && ue > 123 && ue < 1923) {
                if (((o_par & 0x7FFF_FFFF_FFFF_FFFF) >> 52) < 1923) { cmp = 1; }
            }
        }
    }
    if (cmp == 1) {
        if (us == 0) {
            _geo_perp_comp1(GeoRay_origin(ray), GeoCapsule_start(capsule), GeoCapsule_end(capsule), ao, u, uu, o_par,
              &opc);
        } else {
            var ulv[24];
            _geo_cap_lows(ray, capsule, ao, 0, u, usa, uh, &aol, &ulv);
            _geo_perp_comp(ao, &aol, u, &ulv, uu, o_par, &opc);
        }
        o_perp = &opc;
        oo = hvec3_dot(o_perp, o_perp);
    }

    # (_geo_perp_suspect, inline where the squares are finite: under 2^-80 of the vector's
    # squared length for o_perp, 1/64 for d_perp, below.) Where a square overflowed (|d| or |o - start|
    # past 2^511) both parts are also formed exactly when r is under 2^-4 of |o - start| (_geo_cap_thin):
    # the projection's rounding, 2^-52 |o - start|, then reaches past an ulp of r. Where r is
    # comparable to |o - start| neither form is the better there, and the plain one is 3.3.5's.
    # ⛔ 3.4.1 (GEO6) — d_perp'S ROUNDING WAS NOT IN ANY ROOT. The plain d_perp carries 2^-53 |d| and ab's
    # rounding another 2^-53 |d|: over |d_perp| that is 2^-53 / sin(angle to the axis) of itself, and the barrel's
    # roots, a distance across the axis over |d_perp|, take it whole, and the line's offset takes it times the
    # distance from the origin. Inside the barrel, or from a few radii off the end of a long one, a ray 2^-20 off
    # the axis read t 3.3e6 ulp off, and one 2^-40 off 5.8e11, at every scale, in 3.3.7, 3.4.0 and every 3.4.1
    # tree (1,695 of 3,000 rays 2^-3 .. 2^-40 off the axis past 4 ulp, 13 now, the worst 7.3); near tangency the
    # same rounding read the wrong verdict (134 hit -> miss of 3,000) and on seams the wrong t by 2e15 ulp. A ray
    # within 1/8 of the axis (a < d . d / 64) takes d_perp with end - start's rounding carried, _geo_dperp_fine.
    # (1/4 costs four times the rays, spared 2 or 3 of those 3,000, and took one ordinary ray from 3.2 ulp to 5.2.)
    # [measured: GEO6 3.4.1 nv / nv1 / pt / st families (capc.py), exact Fraction oracle, s22 / this tree, 2026-11-01]
    if (par == 0) {
        var sus = f64_lt(a, f64_mul(ddd, 0x3F90_0000_0000_0000));   # 1/64
        if (f64_lt(f64_add(a, ddd), _GEO_F64_POS_INF) == 0) {
            sus = _geo_perp_suspect(d_perp, dir, 0x3F90_0000_0000_0000) | _geo_cap_thin(rb, ao);
        }
        if (sus == 1) {
            if (_geo_hvec3_nonfinite(u) + _geo_hvec3_nonfinite(dir) == 0) {
                var dfz = _geo_dperp_fine(ray, capsule, ao, oh, u, usa, uh, uu, &dpv);
                if (dfz != 0x7FFF_FFFF) {
                    de = dfz;
                    dfn = 1;
                } else {
                    de = _geo_perp_rescue(dir, u, &dpv);
                }
                dres = 1;
            }
        }
        sus = f64_lt(oo, f64_mul(aoao, 0x3AF0_0000_0000_0000));   # 2^-80
        if (f64_lt(f64_add(oo, aoao), _GEO_F64_POS_INF) == 0) {
            sus = _geo_perp_suspect(o_perp, ao, 0x3AF0_0000_0000_0000) | _geo_cap_thin(rb, ao);   # 2^-80
        }
        if (cmp == 1) { sus = 0; }   # (o_perp is already formed with its rounding)
        if (sus == 1) {
            if (_geo_hvec3_nonfinite(u) + _geo_hvec3_nonfinite(ao) == 0) {
                var opv[24];
                var e3 = 0 - _geo_perp_rescue(ao, u, &opv);
                store64(&opt, _geo_ldexp(load64(&opv), e3));
                store64(&opt + 8, _geo_ldexp(load64(&opv + 8), e3));
                store64(&opt + 16, _geo_ldexp(load64(&opv + 16), e3));
                o_perp = &opt;
                oo = hvec3_dot(o_perp, o_perp);
            }
        }
    }
    # (The classic quadratic's b, c and disc are formed below only for a non-finite input; see
    # "THE CLASSIC QUADRATIC IS GONE". 3.3.6's two repairs of it, an exact c where |o_perp|^2 and
    # r^2 rounded equal and a root that cancelled to 0 formed again as c / q, are the sphere
    # form's own: _geo_sph_solve forms c exactly where it cancelled and the near root as c / q.)
    var b = 0;
    var disc = 0;

    # Two ways the infinite-cylinder test yields nothing, both answered by the caps.
    #
    #   disc < 0  -- the ray passes outside the cylinder.
    #   a == 0    -- the ray is PARALLEL to the capsule axis, so d_perp is the zero
    #                vector and b == 0 too, making disc exactly +0.0. That does not
    #                satisfy `disc < 0`, so through 2.6.15 this fell through to the
    #                quadratic and computed inv_2a = 0.5/0 = +Inf, returning NaN
    #                from a function documented to return 0 on a miss.
    #
    # 2.10.1: the threshold is EPSILON_F64 SQUARED, because `a` is d_perp.d_perp
    # -- a squared length. Against the unsquared EPSILON_F64 this rejected the
    # cylinder for any perpendicular component below 1e-6 and silently answered
    # with a CAP hit instead: measured 0.942% relative error on t, constant at
    # every direction scale from 1e-6 down, for a ray that hits the body. Not a
    # miss and not an Inf -- a wrong number, which is why nothing caught it.
    # Same squared-vs-unsquared mistake 2.6.14 repaired in cx_div/cx_inv/cx_powf
    # (see cx_div in complex.cyr) and 2.10.1 repaired in geo_ray_sphere above.
    # [measured: docs/development/issues/archived/2026-08-10-squared-epsilon-guards-in-geo-ray.md]
    var cyl_missed = 0;
    # ⚠ 2.14.0, same correction as _geo_sphere_roots: the exponent was fixed in
    # 2.10.2, the absolute scale was not. `a` is the squared perpendicular
    # component of the direction and only needs a finite reciprocal.
    # ⛔ 3.3.5 — AND A SMALL RAW DIRECTION FLUSHED `a` THE SAME WAY: below 2^-511 the
    # barrel was a miss for every ray (as the caps were, in _geo_sphere_roots), and a
    # ray just above it at an angle to the axis lost the barrel too, its |d_perp|^2
    # under DBL_MIN. When `a` is under 2^-968 (_GEO_DIR_LO) and the largest |d_i| is
    # below 1, so that scaling up can lift it, d is multiplied by the power of two
    # `csc` that takes that component into [1, 2), and d_par, d_perp, a, b and disc are
    # formed for the copy (scalars and a stack copy, no allocation); the roots,
    # t / csc, are multiplied back. Bit for bit the unscaled answer wherever that kept
    # every product normal. A ray parallel to the axis still has a = 0 and takes the
    # caps; every other ray runs as before. (Measured with the sphere, in
    # _geo_sphere_roots.) ⚠ A d with a component of 1 or more is not scaled: that would
    # scale it down, which lifts nothing and can flush its `a`. No suite or sweep
    # answer moves without the test; it matters only for a ray within about 2^-510 of
    # parallel whose barrel crossing, some 2^458 or more along it, is still on the
    # segment. A ray whose |d_perp| is under 2^-511 once its largest component is in
    # [1, 2) still skips the barrel, as at unit size.
    # [measured: G1 mutation run and ray sweep, 2026-10-11; cycc 6.6.14]
    # (3.3.6: no longer. Such a ray, and every other `a` under 2^-968 that is not 0, takes
    # the scaled barrel below, which scales d_perp itself.)
    var csc = 0;
    var dpr[24];
    var dp = d_perp;   # the perpendicular direction the quadratic below is formed from
    if (dres == 1) { dp = &dpv; }
    if (dres == 0 && par == 0 && f64_lt(f64_abs(a), _GEO_DIR_LO) == 1) {
        var dm = _geo_absmax_bits(GeoRay_direction(ray));
        if (dm != 0 && (dm >> 52) < 1023) {
            csc = _geo_scale_for(dm >> 52);
            var dsx = f64_mul(HVec3_x(GeoRay_direction(ray)), csc);
            var dsy = f64_mul(HVec3_y(GeoRay_direction(ray)), csc);
            var dsz = f64_mul(HVec3_z(GeoRay_direction(ray)), csc);
            store64(&dpr, dsx);
            store64(&dpr + 8, dsy);
            store64(&dpr + 16, dsz);
            var d_par_s = f64_div(hvec3_dot(&dpr, u), uu);
            store64(&dpr, f64_sub(dsx, f64_mul(HVec3_x(u), d_par_s)));
            store64(&dpr + 8, f64_sub(dsy, f64_mul(HVec3_y(u), d_par_s)));
            store64(&dpr + 16, f64_sub(dsz, f64_mul(HVec3_z(u), d_par_s)));
            a = hvec3_dot(&dpr, &dpr);
            dp = &dpr;
            # (near parallel as above, seen only here: |d| under 2^-537 flushes both squares)
            store64(&dpr, dsx);
            store64(&dpr + 8, dsy);
            store64(&dpr + 16, dsz);
            var dsq = hvec3_dot(&dpr, &dpr);
            store64(&dpr, f64_sub(dsx, f64_mul(HVec3_x(u), d_par_s)));
            store64(&dpr + 8, f64_sub(dsy, f64_mul(HVec3_y(u), d_par_s)));
            store64(&dpr + 16, f64_sub(dsz, f64_mul(HVec3_z(u), d_par_s)));
            if (f64_lt(a, f64_mul(dsq, 0x3F90_0000_0000_0000)) == 1 && _geo_hvec3_nonfinite(u) == 0) {   # 1/64
                var dfy = _geo_dperp_fine(ray, capsule, ao, oh, u, usa, uh, uu, &dpv);
                if (dfy != 0x7FFF_FFFF) {
                    de = dfy;
                    dfn = 1;
                    dres = 1;
                    csc = 0;
                    dp = &dpv;
                }
            }
        }
    }
    # ⛔ 3.3.6 — THE BARREL AT LARGE SCALES, AND NEAR PARALLEL. Its quadratic overflowed for
    # a radius, an offset o_perp or a d_perp past 2^511 (NaN, or a barrel skipped), and an
    # `a` = |d_perp|^2 under DBL_MIN skipped the barrel whatever d_perp was: the capsule
    # (0,0,0)-(1.5 * 2^511, 0, 0), radius 1, and the ray from (1, 0.5, 0) along
    # (1, 2^-512, 0) lost its barrel exit at 2^511 and answered the end cap at
    # 1.5 * 2^511. When `a` is under 2^-968 but not 0, disc or c is not finite, or d_perp
    # was rescued above, the barrel is solved for copies of d_perp, o_perp and r scaled to
    # unit size (_geo_sph_solve, the sphere's form, so it does not cancel either), and the
    # roots are multiplied back (_geo_ldexp). (Every other ray kept the classic quadratic
    # through 3.3.6; since 3.3.7 every finite one takes this path, see below.)
    # With the caps' new quadratic (_geo_sphere_roots) and the axis and perpendicular
    # repairs above, over 160000 capsule rays (two seeds: ordinary capsules, axis-aligned
    # capsules 2^400 to 2^1021 long with near-parallel rays, general ones, raw directions
    # past 2^505, positions past 2^500, degenerate capsules), every finite one judged
    # against its exact verdict and root: 76226 wrong -> right at 4 ulp and 4 right ->
    # wrong: 3 degenerate capsules (spheres) whose t moved past 4 ulp (to at most 5.6),
    # and 1 end-cap verdict on a capsule 2^437 long, where the hit point lies 1.1 units
    # past the end plane and its own rounding, 2^385, decides the side (o_dot + t * d_dot,
    # both near |ab|^2; 3.3.5 answered the hit). 20914 stay wrong, wrong in 3.3.5 too:
    # 19506 the barrel's classic quadratic at ordinary scale, not repaired here (a median
    # of 1.3 ulp on ordinary capsules), 1387 from origins far along or far off a long
    # axis, as for the far capsules above, and 21 more past 4 ulp. Of 10000 rays with a
    # non-finite input, 302 moved, each an infinite start answered through the finite end
    # cap's new root, 294 of them closer to it (at most 9.1 ulp, where 3.3.5 had 441).
    # [measured: C336 capsule sweep, seeds 51 and 52, exact Decimal roots, 3.3.5 vs this tree, 2026-10-11; cycc 6.6.14]
    # ⛔ 3.3.7 — THE CLASSIC QUADRATIC IS GONE FROM EVERY FINITE BARREL. 3.3.6 kept it for the
    # rays it did not hand to the scaled path, and it lost accuracy twice: b^2 - 4 a c cancels
    # near tangency and (-b - sqrt) / 2a for an origin near the barrel, and with the projection's
    # rounding of o_perp (see "o_perp WITH ITS ROUNDING" above) a ray from an origin far along
    # the axis was off by about 0.2 |o - start| / r ulp: 4,993 ulp at 1.6e4 radii. Every barrel
    # whose d_perp, o_perp and r are finite is now solved in the sphere's form (_geo_sph_solve:
    # the offset f of the axis from the ray, r^2 - |f|^2, the roots q / a and c / q) on copies of
    # d_perp, o_perp and r scaled to unit size, its roots multiplied back by 2^be; where the
    # offset it forms is suspect (a barrel thin against o_perp) it takes the offset from the
    # inputs (_geo_cap_axis_offset, through bx). Only a non-finite input keeps the classic
    # quadratic below, 3.3.5's arithmetic (no contract specifies a non-finite input's answer).
    # [measured: rt337 barrel families (fam2.py, seeds 201-203), exact roots, 3.3.6 vs this tree, 2026-10-31]
    var bsc = 0;
    var be = 0;
    var bhit = 0;
    var bxa = 0;   # 1 when the barrel's roots are _geo_barrel_xact's
    var bdd = 0;   # 1 when _geo_sph_solve left a cancelled discriminant uncertified
    var broots[24];
    var bfin = 0;
    if (par == 1) { bfin = 0 - 1; }   # parallel, the barrel not crossed: the caps answer
    else {
        bfin = _geo_hvec3_nonfinite(dp) + _geo_hvec3_nonfinite(o_perp);
        if (f64_lt(f64_abs(r), _GEO_F64_POS_INF) == 0) { bfin = bfin + 1; }
    }
    # 3.4.0: a barrel 2^48 to 2^400 radii from the origin, by exponents, is solved from exact
    # coefficients (_geo_barrel_xact): o_perp and the axis offset formed in double-double carry
    # about 2^-104 of |o - start|, more than an ulp of r there.
    # ⛔ 3.4.1 (GEO4) — AND THAT EXACT SOLVE COST 5.5 TIMES 3.3.7's (6.5 us against 1.2 on thin barrels 2^48 to
    # 2^1000 radii away), its seam test more. From 2^48 radii on the whole capsule is now solved exactly
    # (_geo_cap_xsolve: integer-exact coefficients, the entry's piece from exact signs): 2.7 us at ordinary
    # coordinates, 2.4 times 3.3.7 (none past 10 times on 2,000 such rays; for the spread-exponent worst
    # case, see its comment), its roots within 2 ulps, and the piece exact at a
    # seam; _geo_barrel_xact stays for an input that is not finite there.
    # [measured: GEO4 3.4.1 t1 / span families (fam.py), per-ray loops, 3.3.7 / s14 / this tree, 2026-11-01]
    var gx = 0 - 9999;   # (o - start against r by exponents, where it is read)
    if (bfin == 0 && oh == 0 && uh == 0) {
        gx = (_geo_absmax_bits(ao) >> 52) - ((r & 0x7FFF_FFFF_FFFF_FFFF) >> 52);
        if (gx >= 48) {
            # (a line provably farther than r from the axis misses the cylinder, and so the capsule:
            # _geo_barrel_far0's few products, as before the exact solve)
            if (_geo_barrel_far0(ray, capsule) == 1) {
                if (tiny == 1) { return 0; }
                return 0;
            }
            var txg = _geo_cap_xroute(ray, capsule, out);
            if (txg != 0x7FF8_0000_0000_0003) {
                if (tiny == 1) { txg = _geo_ldexp(txg, tiny_e); }
                return txg;
            }
        }
        if (gx >= 48 && gx <= 1000) {
            var xr = _geo_barrel_xact(ray, capsule, &broots);
            if (xr >= 0) {
                bhit = xr;
                bsc = 1;
                bxa = 1;
                be = load64(&broots + 16);
                bfin = 1;   # (solved: the two paths below are skipped)
            }
        }
    }
    if (bfin == 0) {
        # The common barrel, every magnitude within 2^+-100, in _geo_sph_solve's form written out
        # (_geo_barrel_fast, which hands back 2 where that routine would take another branch).
        bhit = _geo_barrel_fast(o_perp, dp, rb, &broots);
        if (bhit != 2) {
            bsc = 1;
            be = de + oh;
            if (csc != 0) { be = be + (csc >> 52) - 1023; }
        }
    }
    if (bfin == 0 && bsc == 0) {
        var bsd = _geo_scale_for(_geo_absmax_bits(dp) >> 52);
        var bmp = _geo_absmax_bits(o_perp);
        var bmr = rb & 0x7FFF_FFFF_FFFF_FFFF;
        if (bmr > bmp) { bmp = bmr; }
        var bsp = _geo_scale_for(bmp >> 52);
        var bop[24];
        var bdp[24];
        store64(&bop, f64_mul(HVec3_x(o_perp), bsp));
        store64(&bop + 8, f64_mul(HVec3_y(o_perp), bsp));
        store64(&bop + 16, f64_mul(HVec3_z(o_perp), bsp));
        store64(&bdp, f64_mul(HVec3_x(dp), bsd));
        store64(&bdp + 8, f64_mul(HVec3_y(dp), bsd));
        store64(&bdp + 16, f64_mul(HVec3_z(dp), bsd));
        var bx[80];   # what _geo_cap_axis_offset forms the offset from, at the copy's scale
        store64(&bx, ray);
        store64(&bx + 8, capsule);
        store64(&bx + 16, ao);
        store64(&bx + 24, oh);
        store64(&bx + 32, u);
        store64(&bx + 40, usa);
        store64(&bx + 48, uh);
        store64(&bx + 56, (bsp >> 52) - 1023);
        # (3.4.0: d_perp's copy is 2^bx[64] times the exact d_perp: bsd, csc's copy, the rescue's de.)
        var edp = (bsd >> 52) - 1023 + de;
        if (csc != 0) { edp = edp + (csc >> 52) - 1023; }
        store64(&bx + 64, edp);
        store64(&bx + 72, 0);
        bhit = _geo_sph_solve(&bop, &bdp, f64_mul(rb, bsp), 0, &bx, &broots);
        bdd = load64(&bx + 72);
        bsc = 1;
        be = (bsd >> 52) - (bsp >> 52);
        if (csc != 0) { be = be + (csc >> 52) - 1023; }
        be = be + de + oh;
    }
    # ⛔ 3.4.1 (GEO4, GEO6) — A THIN BARREL NEAR TANGENCY. The offset a solve forms carries o - start's rounding,
    # 2^-52 |o - start|: rays tangent to within 2^-15 .. 2^-50 of a barrel 2^5 .. 2^47 radii away had the wrong
    # verdict or t (518 of 4,000, the hit's t up to 1e15 ulp off, in 3.3.7 / 3.4.0 / s14 alike). The exact solve
    # (_geo_cap_xsolve) takes every ray a solve cannot vouch for, on two tests.
    # - bdd, at any distance: r^2 - |f|^2 cancelled, and _geo_sph_solve's double-double cannot certify hb^2 - a c
    #   (_geo_disc_dd's 2), or its lows do not hold it (_geo_lows_hold). That is the test that matters. GEO4 had
    #   only the distance gate below, its comment saying the solve's error stays under its margin nearer in, and
    #   it does not: 165 of 4,000 rays within 2 ulps of tangency 2^11 .. 2^20 radii away had the wrong verdict.
    #   A distance gate is the wrong tool: _geo_barrel_cert must refuse a root it cannot place within 2^-50, which
    #   from far off is nearly every hit, so a gate at 2^6 radii closes that family at 8.4 times s22's cost on
    #   ordinary rays from 2^5 .. 2^19 radii (254 of 600 past 10 times), every one of them right already.
    # - from 2^20 radii away (by exponents), _geo_barrel_cert, for the rays that do not reach the solve's branch.
    # [measured: GEO4 3.4.1 ctang and seam families (fam.py), Fraction oracle, 3.3.7 / 3.4.0 / s14, 2026-11-01]
    # [measured: GEO6 3.4.1 bt family (capb.py), gfar timing (tm3.py), per-ray loops, s22 / this tree, 2026-11-01]
    var des = de;   # (dp is 2^des times the true d_perp)
    if (csc != 0) { des = des + (csc >> 52) - 1023; }
    if (bsc == 1 && bxa == 0 && oh == 0) {
        if (gx == 0 - 9999) { gx = (_geo_absmax_bits(ao) >> 52) - ((rb & 0x7FFF_FFFF_FFFF_FFFF) >> 52); }
        if (bdd == 0 && gx >= 20) {
            var ee0 = _geo_barrel_err(ao, o_perp, cmp, dp, dir, des, dfn);
            if (_geo_barrel_cert(o_perp, dp, rb, ee0, bhit) == 0) { bdd = 1; }
        }
        if (bdd == 1) {
            var tx = _geo_cap_xsolve(ray, capsule, out);
            if (tiny == 1) { tx = _geo_ldexp(tx, tiny_e); }
            return tx;
        }
    }
    if (bsc == 1) {
        cyl_missed = 1 - bhit;
    } elif (bfin < 0) {
        cyl_missed = 1;
    } else {
        # A non-finite input: 3.3.5's classic quadratic (d_perp as the csc copy when that ran;
        # the rescued one never reached it).
        var cdp = d_perp;
        if (csc != 0) { cdp = &dpr; }
        b = f64_mul(F64_TWO, hvec3_dot(cdp, o_perp));
        var c = f64_sub(oo, rbb);
        disc = f64_sub(f64_mul(b, b), f64_mul(_GEO_F64_FOUR, f64_mul(a, c)));
        if (f64_lt(f64_abs(a), _GEO_F64_TINY) == 1) { cyl_missed = 1; }
        if (f64_lt(disc, 0) == 1) { cyl_missed = 1; }
    }

    var best = 0;
    # Which piece of the surface produced `best`. Written only through out at the
    # end, so a non-differentiating caller pays one i64 store per accepted branch.
    var branch = GEO_FACE_NONE;
    # 1 once a root is accepted (3.3.6). Through round 2 `best == 0` stood for "none yet",
    # so an accepted root of +0, an origin on the surface moving in, was overwritten by the
    # exit: the capsule answered the exit where the sphere answers the contact, 0, and the
    # one rule for every primal (see "A CONTACT AT t = 0" above) says the contact. (A -0
    # root, whose bits are not 0, already stayed.) For the origin (3, 4, 0) on the start cap
    # of (0,0,0)-(0,0,-8), r = 5, moving along (-3, -4, 0), every release answered 2.
    # [measured: C336 review edge family, 3.3.5 vs this tree, 2026-10-11; cycc 6.6.14]
    var found = 0;
    var bent = 0;   # 1 when best is the barrel's near root, its side decided exactly (the caps' tie below)
    # 1 when the barrel's near root, ahead of the origin, is on the segment and well conditioned (3.4.1
    # GEO4, _geo_barrel_entry_ok): it is where the line enters the cylinder, which holds the whole
    # capsule, at a point of the capsule, so it is the capsule's entry and no cap root can come before
    # it; the caps are not solved. (A root in doubt near an end plane went to the exact solve above.)
    var bin = 0;
    var bsx0 = 0;   # 1 when the near root's side of the end planes came from _geo_barrel_seam_x

    if (cyl_missed == 0) {
        var cyl_t1 = 0;
        var cyl_t2 = 0;
        if (bsc == 0) {
            var inv_2a = f64_div(F64_HALF, a);
            var sqrt_disc = f64_sqrt(disc);
            cyl_t1 = f64_mul(f64_sub(f64_neg(b), sqrt_disc), inv_2a);
            cyl_t2 = f64_mul(f64_add(f64_neg(b), sqrt_disc), inv_2a);
        }
        var cs1 = cyl_t1;   # the roots before they are multiplied back, by 2^ce
        var cs2 = cyl_t2;
        var ce = 0;
        # The segment test's own rounding (_geo_cap_seam_proj), as a window around 0 and 1 in
        # proj |ab|: 2^-48 (|o| + |t| |d| + |start|), largest components; formed for the first
        # root that needs it (sw1 < 0 until then).
        var sw0 = 0;
        var sw1 = 0 - 1;
        var swab = 0;
        var sxd = 0;   # 1 once _geo_barrel_seam_x has answered for both roots (sxa)
        var sxa: i64[2];
        if (bsc == 1) {
            cs1 = load64(&broots);
            cs2 = load64(&broots + 8);
            ce = be;
            cyl_t1 = cs1;
            cyl_t2 = cs2;
            if (be != 0) {
                cyl_t1 = _geo_root_ldexp(cs1, be);
                cyl_t2 = _geo_root_ldexp(cs2, be);
            }
        } elif (csc != 0) {
            ce = (csc >> 52) - 1023;
            cyl_t1 = f64_mul(cyl_t1, csc);
            cyl_t2 = f64_mul(cyl_t2, csc);
        }

        # Check cylinder hit at cyl_t1
        if (f64_lt(cyl_t1, 0) != 1) {
            var proj = 0;
            var tx1 = 0x7FF8_0000_0000_0003;   # (the exact answer, once routed below)
            if (cyl_t1 == 0x7FF0_0000_0000_0000) { proj = _geo_cap_far_proj(cs1, ce, ray, capsule, u, uu, eu); }
            else {
                var pv[24];
                proj = _geo_cap_proj0(ray, GeoCapsule_start(capsule), u, uu, cyl_t1, &pv);
                if (us == 1) { proj = _geo_cap_proj_u(&pv, GeoCapsule_start(capsule), u, uu, eu); }
                # (3.4.1 GEO4: a root whose side of an end plane is in doubt, _geo_seam_doubt, or within the
                # window below, is solved exactly, _geo_cap_xroute: there its side, and the label, can be the
                # root's rounding or the coordinate's, and the float side tests below were wrong on 4 graze /
                # 3 cross seam rays of 2,000 where 3.3.7 was right)
                # [measured: GEO4 3.4.1 seam families (fam.py), exact Fraction oracle, 3.3.7 / s14, 2026-11-01]
                var pq = f64_sub(proj, F64_ONE) & 0x7FFF_FFFF_FFFF_FFFF;
                if ((proj & 0x7FFF_FFFF_FFFF_FFFF) < 0x3EB0_0000_0000_0000 || pq < 0x3EB0_0000_0000_0000) {   # (2^-20)
                    var ee1 = _geo_barrel_err(ao, o_perp, cmp, dp, dir, des, dfn);
                    var sdb = _geo_seam_doubt(proj, cyl_t1, cyl_t1, cyl_t2, ao, ee1, d_perp, ddd, uu, rb, dir, u);
                    if (sdb == 1) {
                        tx1 = _geo_cap_xroute(ray, capsule, out);
                    }
                }
                # (3.3.7: near an end plane, taken from where the root lies, _geo_cap_seam_proj.)
                if (bsc == 1) {
                    if (sw1 < 0) {
                        sw0 = _geo_seam_window(ray, capsule, ab, &sw1, &swab);
                    }
                    var swm = f64_add(sw0, f64_mul(f64_abs(cyl_t1), sw1));
                    if (f64_lt(f64_mul(f64_abs(proj), swab), swm) == 1
                      || f64_lt(f64_mul(f64_abs(f64_sub(proj, F64_ONE)), swab), swm) == 1) {
                        if (tx1 == 0x7FF8_0000_0000_0003) { tx1 = _geo_cap_xroute(ray, capsule, out); }
                        var sx0 = 3;
                        if (tx1 != 0x7FF8_0000_0000_0003) { sx0 = 4; }   # (answered exactly; skip the float side)
                        if (bxa == 1 && sx0 == 3) {
                            if (sxd == 0) {
                                _geo_barrel_seam_x(ray, capsule, &sxa);
                                sxd = 1;
                            }
                            sx0 = load64(&sxa + 0);
                        }
                        if (sx0 == 3) { proj = _geo_cap_seam_proj(ray, capsule, ab, cyl_t1, proj, 0); }
                        elif (sx0 != 4) {
                            proj = _geo_seam_stand(sx0);
                            bsx0 = 1;
                        }
                    }
                }
            }
            if (tx1 != 0x7FF8_0000_0000_0003) {
                if (tiny == 1) { tx1 = _geo_ldexp(tx1, tiny_e); }
                return tx1;
            }
            if (f64_lt(proj, 0) != 1) {
                if (f64_gt(proj, F64_ONE) != 1) {
                    best = cyl_t1;
                    branch = GEO_CAP_CYLINDER;
                    found = 1;
                    bent = bsx0;
                    if (f64_lt(cyl_t1, 0) == 0 && bsc == 1) {
                        bin = _geo_barrel_entry_ok(cyl_t1, cyl_t2, d_perp, ddd, rbb);
                    }
                }
            }
        }

        # Check cylinder hit at cyl_t2
        if (f64_lt(cyl_t2, 0) != 1) {
            var proj = 0;
            var tx2 = 0x7FF8_0000_0000_0003;   # (the exact answer, once routed below)
            if (cyl_t2 == 0x7FF0_0000_0000_0000) { proj = _geo_cap_far_proj(cs2, ce, ray, capsule, u, uu, eu); }
            else {
                var pv[24];
                proj = _geo_cap_proj0(ray, GeoCapsule_start(capsule), u, uu, cyl_t2, &pv);
                if (us == 1) { proj = _geo_cap_proj_u(&pv, GeoCapsule_start(capsule), u, uu, eu); }
                # (3.4.1 GEO4: a root whose side of an end plane is in doubt, _geo_seam_doubt, or within the
                # window below, is solved exactly, _geo_cap_xroute: there its side, and the label, can be the
                # root's rounding or the coordinate's, and the float side tests below were wrong on 4 graze /
                # 3 cross seam rays of 2,000 where 3.3.7 was right)
                # [measured: GEO4 3.4.1 seam families (fam.py), exact Fraction oracle, 3.3.7 / s14, 2026-11-01]
                var pq = f64_sub(proj, F64_ONE) & 0x7FFF_FFFF_FFFF_FFFF;
                if ((proj & 0x7FFF_FFFF_FFFF_FFFF) < 0x3EB0_0000_0000_0000 || pq < 0x3EB0_0000_0000_0000) {   # (2^-20)
                    var ee2 = _geo_barrel_err(ao, o_perp, cmp, dp, dir, des, dfn);
                    var sdb = _geo_seam_doubt(proj, cyl_t2, cyl_t1, cyl_t2, ao, ee2, d_perp, ddd, uu, rb, dir, u);
                    if (sdb == 1) {
                        tx2 = _geo_cap_xroute(ray, capsule, out);
                    }
                }
                if (bsc == 1) {
                    if (sw1 < 0) {
                        sw0 = _geo_seam_window(ray, capsule, ab, &sw1, &swab);
                    }
                    var swm = f64_add(sw0, f64_mul(f64_abs(cyl_t2), sw1));
                    if (f64_lt(f64_mul(f64_abs(proj), swab), swm) == 1
                      || f64_lt(f64_mul(f64_abs(f64_sub(proj, F64_ONE)), swab), swm) == 1) {
                        if (tx2 == 0x7FF8_0000_0000_0003) { tx2 = _geo_cap_xroute(ray, capsule, out); }
                        var sx1 = 3;
                        if (tx2 != 0x7FF8_0000_0000_0003) { sx1 = 4; }   # (answered exactly; skip the float side)
                        if (bxa == 1 && sx1 == 3) {
                            if (sxd == 0) {
                                _geo_barrel_seam_x(ray, capsule, &sxa);
                                sxd = 1;
                            }
                            sx1 = load64(&sxa + 8);
                        }
                        if (sx1 == 3) { proj = _geo_cap_seam_proj(ray, capsule, ab, cyl_t2, proj, 1); }
                        elif (sx1 != 4) { proj = _geo_seam_stand(sx1); }
                    }
                }
            }
            if (tx2 != 0x7FF8_0000_0000_0003) {
                if (tiny == 1) { tx2 = _geo_ldexp(tx2, tiny_e); }
                return tx2;
            }
            if (f64_lt(proj, 0) != 1) {
                if (f64_gt(proj, F64_ONE) != 1) {
                    if (found == 0) {
                        best = cyl_t2;
                        branch = GEO_CAP_CYLINDER;
                        found = 1;
                    } else {
                        # NO branch update here, and that is measured rather than an
                        # omission: cyl_t1 <= cyl_t2 always (a > 0 and sqrt(disc) >= 0
                        # give t1 = (-b - s)/2a <= (-b + s)/2a = t2), so reaching this
                        # arm means cyl_t1 already owns `best` AND already set the
                        # branch to the cylinder. A mutant that adds an update here
                        # cannot change any answer -- one was written, and it survived
                        # the whole suite, which is what says the line is dead code
                        # rather than defensive symmetry.
                        # [measured: docs/development/issues/archived/2026-08-10-squared-epsilon-guards-in-geo-ray.md]
                        best = f64_min(best, cyl_t2);
                    }
                }
            }
        }

    }

    # ================================================================
    # THE CAPS, 2.10.2 -- BOTH roots of each cap sphere, half-space filtered
    # ================================================================
    #
    # This used to call geo_ray_sphere, which returns only the FIRST non-negative
    # root, and then test that one root against the cap's half-space. Two defects
    # followed, and they are the same defect seen from either side:
    #
    #   * If the first root failed the half-space test, the OTHER root was never
    #     considered -- so a ray leaving the capsule through a cap reported a MISS.
    #     Measured over 600 random interior origins: 32 of them, 5.3%, dropped a
    #     real exit, with t from 1.09 to 10.0.
    #     [measured: docs/development/issues/archived/2026-08-10-capsule-cyl-missed-tags-a-sphere-root-as-a-cap.md]
    #   * When the cylinder test yielded nothing, a separate fallback returned the
    #     smaller of the two spheres' first roots with NO half-space test at all.
    #     Measured: capsule (0,0,0)-(10,0,0) r = 1 with a ray from (5,0,0) along
    #     +x returned t = 4, whose hit point (9,0,0) is ON THE AXIS -- a full
    #     radius inside the solid -- where the true exit is t = 6.
    #
    # Both are gone because that fallback is gone: the caps are now evaluated on
    # every path, and a cap root is a candidate only if it is non-negative AND on
    # the correct side of that cap's plane. The contract this restores is the one
    # every sibling already honours and this function's own cylinder branch
    # already honoured -- an origin inside the shape gets the EXIT parameter.
    # [measured: docs/development/issues/archived/2026-08-10-capsule-cyl-missed-tags-a-sphere-root-as-a-cap.md]
    var rt[16];
    var d_dot_ab = hvec3_dot(dir, u);
    var csph[16];
    var cape = 0;   # 3.3.6: d . u overflowed; it is 2^cape times this, so t is scaled by 2^-cape
    if (f64_lt(f64_abs(d_dot_ab), _GEO_F64_POS_INF) == 0) {
        if (_geo_hvec3_nonfinite(u) + _geo_hvec3_nonfinite(dir) == 0) {
            var s4 = _geo_scale_for(_geo_absmax_bits(dir) >> 52);
            var dst: i64[3];
            d_dot_ab = hvec3_dot(_geo_scale_to(&dst, dir, s4), u);
            cape = (s4 >> 52) - 1023;
        }
    }
    # ⛔ 3.4.1 — AND THE UNDERFLOW HALF (AU2-G2-F14): a setter-built direction of 2^-590 against a
    # capsule at 2^-461 made d . u subnormal or 0, and the cap's side test rejected the start cap's
    # hit (t 49FFBC7CA92F338B) for the miss. A d . u below DBL_MIN from a direction below 1 is formed
    # again from d taken near 1, as for the overflow (only a subnormal or zero d . u moves).
    # [measured: GEO 3.4.1 AU2-G2-F14 repro; ident2.py, 30000 capsule rays, 3.4.0 vs this tree, 2026-10-31]
    if ((d_dot_ab & 0x7FFF_FFFF_FFFF_FFFF) < 0x0010_0000_0000_0000) {
        var dm4 = _geo_absmax_bits(dir);
        if (dm4 != 0 && (dm4 >> 52) < 1023 && _geo_hvec3_finite(u) == 1) {
            var s5 = _geo_scale_for(dm4 >> 52);
            var ds5: i64[3];
            for (var q5 = 0; q5 < 3; q5 = q5 + 1) { store64(&ds5 + q5 * 8, f64_mul(load64(dir + q5 * 8), s5)); }
            d_dot_ab = hvec3_dot(&ds5, u);
            cape = (s5 >> 52) - 1023;
        }
    }
    var ncap = 2;
    if (bin == 1) { ncap = 0; }
    for (var cap_i = 0; cap_i < ncap; cap_i = cap_i + 1) {
        var cap_pt = GeoCapsule_start(capsule);
        var cap_br = GEO_CAP_START_CAP;
        if (cap_i == 1) {
            cap_pt = GeoCapsule_end(capsule);
            cap_br = GEO_CAP_END_CAP;
        }
        # ((o - cap_pt) . u, as scalars in hvec3_dot's order: the same bits, no allocation.)
        var wcx = f64_sub(HVec3_x(GeoRay_origin(ray)), HVec3_x(cap_pt));
        var wcy = f64_sub(HVec3_y(GeoRay_origin(ray)), HVec3_y(cap_pt));
        var wcz = f64_sub(HVec3_z(GeoRay_origin(ray)), HVec3_z(cap_pt));
        var o_dot_ab = f64_add(f64_add(f64_mul(wcx, HVec3_x(u)), f64_mul(wcy, HVec3_y(u))), f64_mul(wcz, HVec3_z(u)));
        # 3.3.6: (o - cap_pt) . u overflows (or o - cap_pt does) for an origin far from a cap
        # of such a capsule; the side test needs only the sign of o_dot + t * d_dot, so it
        # is formed from (o - cap_pt) / 2 taken to unit size, 2^-oce times o_dot, and t is
        # multiplied by the same power below. Finite input only.
        var oce = 0;
        if (f64_lt(f64_abs(o_dot_ab), _GEO_F64_POS_INF) == 0) {
            var fc = _geo_hvec3_nonfinite(GeoRay_origin(ray)) + _geo_hvec3_nonfinite(cap_pt);
            if (fc + _geo_hvec3_nonfinite(u) == 0) {
                var hw: i64[3];
                var hc: i64[3];
                var wct: i64[3];
                var wc = _geo_sub_to(&wct, _geo_scale_to(&hw, GeoRay_origin(ray), F64_HALF),
                  _geo_scale_to(&hc, cap_pt, F64_HALF));
                var swc = _geo_scale_for(_geo_absmax_bits(wc) >> 52);
                o_dot_ab = hvec3_dot(_geo_scale_to(&hw, wc, swc), u);
                oce = (swc >> 52) - 1023 - 1;
            }
        }
        store64(&csph, cap_pt);   # the cap's sphere, a GeoSphere on the stack
        store64(&csph + 8, r);
        if (_geo_sphere_roots(ray, &csph, &rt) == 1) {
            for (var root_i = 0; root_i < 2; root_i = root_i + 1) {
                var tc = load64(&rt + root_i * 8);
                var tcs = tc;
                # (A negative root stays negative here: the scale reaches below 2^-1022 only
                # with the origin past DBL_MAX / 4 from the cap, where |tc| is at least 2^-51.)
                if (oce != cape) { tcs = _geo_ldexp(tc, oce - cape); }
                var acc = 0 - 1;
                if (tc == 0x7FF0_0000_0000_0000) {
                    acc = _geo_cap_far_accepts(ray, &csph, u, o_dot_ab, oce, cap_i, root_i);
                }
                if (acc == 0 - 1) {
                    acc = _geo_cap_accepts(tcs, o_dot_ab, d_dot_ab, cap_i);
                    # 3.3.7: a side term within its own rounding of 0, under 2^-48 of |o_dot| +
                    # |t d_dot| (each formed from a rounded o - cap or d), is decided from where the
                    # root lies (_geo_cap_side_exact). A negative, infinite or NaN t never is.
                    if (oce == cape) {
                        var tdd = f64_mul(tcs, d_dot_ab);
                        var swm = f64_mul(f64_add(f64_abs(o_dot_ab), f64_abs(tdd)), 0x3CF0_0000_0000_0000);   # 2^-48
                        # (3.4.1 GEO4: within 2^-46 of its terms the cap root's side is decided exactly: the root is
                        # good to a few ulps since _geo_sph_graze, and the float side test here was the label's
                        # error at a seam)
                        var sdt = f64_abs(f64_add(o_dot_ab, tdd));
                        if (f64_lt(sdt, f64_mul(swm, _GEO_F64_FOUR)) == 1 && f64_lt(tcs, 0) == 0) {   # 2^-46
                            var tx3 = _geo_cap_xroute(ray, capsule, out);
                            if (tx3 != 0x7FF8_0000_0000_0003) {
                                if (tiny == 1) { tx3 = _geo_ldexp(tx3, tiny_e); }
                                return tx3;
                            }
                        }
                        if (f64_lt(f64_abs(f64_add(o_dot_ab, tdd)), swm) == 1 && f64_lt(tcs, 0) == 0) {
                            var acx = _geo_cap_side_exact(ray, cap_pt, r, u, root_i, cap_i);
                            if (acx != 0 - 1) { acc = acx; }
                        }
                    }
                }
                if (acc == 1) {
                    if (found == 0) {
                        best = tc;
                        branch = cap_br;
                        found = 1;
                    } else {
                        # A cap root equal to the barrel's near root, as doubles, is the same point
                        # (the seam) or the cap's exit past it: a cap sphere lies inside the barrel's
                        # cylinder, and a line meets a capsule's surface at two points at most. Its
                        # label stays the barrel's (3.4.0) -- where the near root's side of the planes
                        # was decided exactly (_geo_barrel_seam_x). Decided in floats it can be the
                        # wrong side within its rounding while the cap's side is exact
                        # (_geo_cap_side_exact), and the cap's label is taken, as before 3.4.0 (the
                        # second review's N4: 11 of 2,000 seam rays at r ~ |u| went right -> wrong).
                        # Equal to the barrel's far root it is the cap's entry or its exit before it,
                        # and the cap's label is taken, as before.
                        # [measured: rt340 span and dpal families (sweep.py), exact Fraction oracle, 2026-10-31]
                        if (f64_lt(best, tc) != 1) {
                            if (bent == 0 || f64_lt(tc, best) == 1) { branch = cap_br; }
                        }
                        best = f64_min(best, tc);
                    }
                }
            }
        }
    }

    if (out != 0) { store64(out, branch); }
    if (tiny == 1) { best = _geo_ldexp(best, tiny_e); }
    return best;
}

# The plain entry point: identical t, no branch bookkeeping, out = 0.
public fn geo_ray_capsule(ray, capsule) {
    return geo_ray_capsule_branch(ray, capsule, 0);
}

# ================================================================
# Primitive overlap tests
# ================================================================

# 1 when the slabs [alo, ahi] and [blo, bhi], each read sorted, overlap. A NaN bound is
# never swapped (f64_gt is false for it) and fails the test that reads it: 0.
fn _geo_slabs_meet(alo, ahi, blo, bhi) {
    if (f64_gt(alo, ahi) == 1) {
        var ta = alo;
        alo = ahi;
        ahi = ta;
    }
    if (f64_gt(blo, bhi) == 1) {
        var tb = blo;
        blo = bhi;
        bhi = tb;
    }
    if (f64_le(alo, bhi) == 0) { return 0; }
    if (f64_le(blo, ahi) == 0) { return 0; }
    return 1;
}

# geo_aabb_aabb for two boxes each read sorted, axis by axis.
fn _geo_aabb_aabb_sorted(a, b) {
    var a_min = GeoAabb_min(a);
    var a_max = GeoAabb_max(a);
    var b_min = GeoAabb_min(b);
    var b_max = GeoAabb_max(b);
    if (_geo_slabs_meet(HVec3_x(a_min), HVec3_x(a_max), HVec3_x(b_min), HVec3_x(b_max)) == 0) { return 0; }
    if (_geo_slabs_meet(HVec3_y(a_min), HVec3_y(a_max), HVec3_y(b_min), HVec3_y(b_max)) == 0) { return 0; }
    if (_geo_slabs_meet(HVec3_z(a_min), HVec3_z(a_max), HVec3_z(b_min), HVec3_z(b_max)) == 0) { return 0; }
    return 1;
}

# AABB-AABB overlap test. Returns 1 if overlapping, 0 otherwise.
#
# ⛔ 3.3.4 — A NaN BOX OVERLAPPED. Each test answered 0 only for an axis provably
# separated, and a test that reads a NaN bound is false, so a box NaN in both bounds
# of an axis (what geo_aabb_new((NaN,0,0), (1,1,1)) builds since 3.3.3) overlapped
# every box it did not clear on another axis: [100,101] x [0,1] x [0,1] among them.
# Each test now asks "overlaps on this axis", spelled NaN-false, so a NaN bound in
# either box is no overlap -- the rule geo_sphere_sphere below and the collision entry
# points keep: a NaN shape is never a contact. For every input with no NaN the two
# spellings give the same answer.
# The spatial walkers prune with their own NaN-true copies of the old tests
# (`_bvh_aabb_may_overlap` in src/geo_advanced.cyr, `_ot_aabb_may_overlap` in
# src/spatial.cyr): a node's bounds turn NaN for reasons that say nothing about what
# is below it (a NaN box anywhere in a BVH subtree; the centre of an octree root with
# an infinite axis), and this test there would prune the finite boxes and points too.
# bvh_query_aabb's leaves are this function, so a NaN box is never returned, and
# neither is anything for a NaN query box.
# [measured: spatial lane probe, 3.3.4-base and repaired bundles, not in-tree, 2026-10-03; cycc 6.6.14]
# ⛔ 3.3.4 — AN INVERTED BOX (min above max on an axis, which only the setters build:
# geo_aabb_new sorts its corners) IS READ SORTED, as geo_ray_aabb reads it and
# geo_ray_obb reads |he|. Through 3.3.3 these tests answered the x-slab [5, 1] against
# [0, 10], [3, 4] and [0, 2] with 1, 0, 0, which is neither the empty slab nor [1, 5],
# while a ray crossing x read it as [1, 5]. When a test fails, _geo_aabb_aabb_sorted
# gives the answer for the two sorted boxes. A pair that passes all six tests
# overlaps sorted as well (sorting only widens what each test compares), and for
# boxes with min <= max, or with a NaN bound, a failed test is the sorted answer
# already: those answers are unchanged, and the overlap path runs no extra compare.
# 40100 random pairs with an inverted box answer as the sorted pair, and 19900 without
# one (NaN, +-Inf, +-0, subnormal and DBL_MAX bounds among them) as before.
# [measured: overlap differential, 3.3.4 tree before this and after, not in-tree, 2026-10-03; cycc 6.6.14]
public fn geo_aabb_aabb(a, b) {
    var a_min = GeoAabb_min(a);
    var a_max = GeoAabb_max(a);
    var b_min = GeoAabb_min(b);
    var b_max = GeoAabb_max(b);

    # a.min <= b.max && b.min <= a.max on all 3 axes
    if (f64_le(HVec3_x(a_min), HVec3_x(b_max)) == 0) { return _geo_aabb_aabb_sorted(a, b); }
    if (f64_le(HVec3_y(a_min), HVec3_y(b_max)) == 0) { return _geo_aabb_aabb_sorted(a, b); }
    if (f64_le(HVec3_z(a_min), HVec3_z(b_max)) == 0) { return _geo_aabb_aabb_sorted(a, b); }
    if (f64_le(HVec3_x(b_min), HVec3_x(a_max)) == 0) { return _geo_aabb_aabb_sorted(a, b); }
    if (f64_le(HVec3_y(b_min), HVec3_y(a_max)) == 0) { return _geo_aabb_aabb_sorted(a, b); }
    if (f64_le(HVec3_z(b_min), HVec3_z(a_max)) == 0) { return _geo_aabb_aabb_sorted(a, b); }
    return 1;
}

# Sphere-sphere overlap test. Returns 1 if overlapping, 0 otherwise.
#
# ⛔ 3.3.3 — A NaN SPHERE WAS A CONTACT. The test read "`dist_sq > (r1 + r2)^2`
# is a miss, anything else a hit", and anything else includes NaN, so a NaN
# centre coordinate or radius overlapped everything: a unit sphere at (NaN,0,0),
# or one of radius NaN at the origin, touched a unit sphere at (100,0,0). It is
# now "`dist_sq <= (r1 + r2)^2` is a hit", spelled NaN-false, so a NaN shape is a
# miss — the rule tests/modules.tcyr pins for the collision entry points ("a NaN
# shape is never a contact"). That includes the NaN infinite input makes: two
# centres infinite with one sign in one slot give `Inf - Inf`, and 6562 of 20000
# random configurations with infinite coordinates moved from 1 to 0. Finite input
# cannot make a NaN here (a sum of squares never subtracts), and two sweeps of
# 40000 pairs each, one at random magnitudes with DBL_MAX, -0 and subnormal
# coordinates and one at and around exact touching, are bit-identical to 3.3.2.
# No bench row and no caller in src/ reaches this function.
# [measured: R4geo probes and sweeps, 3.3.2, 3.3.3-base and repaired bundles, not in-tree, 2026-10-01; cycc 6.6.12]
# ⛔ 3.4.1 — THE SQUARES FLUSHED AND OVERFLOWED, AND EVERY SUCH PAIR WAS A CONTACT (AU2-G2-F3):
# centres 0 and (1A73C0CA428C59FB, 1A7E06522C8B909A, 0) with radii summing to 0.9 of their distance
# read 0 <= 0, touching; 427 of 1,746 scaled pairs below 2^-538 or above 2^512 were such false
# contacts. Where both squares are at least 2^-968 and finite this is 3.4.0's arithmetic (the
# difference on the stack: one allocation fewer, the same bits); elsewhere the test is made on
# c_a - c_b and r_a + r_b scaled together near 1 (_geo_sphere_sphere_scaled). The radii still enter
# squared: a negative sum is read as its magnitude, as before.
# [measured: GEO 3.4.1 seg_sweep.py sphere pairs, 20000 x2 seeds, 3.4.0 vs this tree, not in-tree, 2026-10-31]
public fn geo_sphere_sphere(a, b) {
    var ca = GeoSphere_center(a);
    var cb = GeoSphere_center(b);
    var r_sum = f64_add(GeoSphere_radius(a), GeoSphere_radius(b));
    var d: i64[3];
    store64(&d, f64_sub(HVec3_x(ca), HVec3_x(cb)));
    store64(&d + 8, f64_sub(HVec3_y(ca), HVec3_y(cb)));
    store64(&d + 16, f64_sub(HVec3_z(ca), HVec3_z(cb)));
    var dist_sq = hvec3_length_sq(&d);
    var rr = f64_mul(r_sum, r_sum);
    var lo = dist_sq;
    if (rr < lo) { lo = rr; }
    var hi = dist_sq;
    if (rr > hi) { hi = rr; }
    # (A square under 2^-968 decides nothing on its own: against one of 2^-966 or more the plain
    # comparison stands, coincident centres included, as its rounding is far below the gap.)
    if (hi >= 0x7FF0_0000_0000_0000 || (lo < 0x0370_0000_0000_0000 && hi < 0x0390_0000_0000_0000)) {
        return _geo_sphere_sphere_scaled(a, b, &d, r_sum);
    }
    if (f64_lt(dist_sq, rr) == 1) { return 1; }
    if (f64_eq(dist_sq, rr) == 1) { return 1; }
    return 0;
}

# geo_sphere_sphere outside the range of its squares (3.4.1), with d = c_a - c_b formed (a stack
# vector) and r_sum = r_a + r_b. A NaN or infinite input keeps 3.4.0's arithmetic (a NaN is never a
# contact). A difference or a sum that overflowed from finite input is formed again at half size.
# Then d and r_sum are multiplied by the one power of two that takes the larger near 1, and
# |d|^2 <= r_sum^2 is decided there, where neither square flushes nor overflows.
fn _geo_sphere_sphere_scaled(a, b, d, r_sum) {
    var ca = GeoSphere_center(a);
    var cb = GeoSphere_center(b);
    var ra = GeoSphere_radius(a);
    var rb = GeoSphere_radius(b);
    var fin = _geo_hvec3_finite(ca) & _geo_hvec3_finite(cb);
    if (fin == 0 || f64_lt(f64_abs(ra), _GEO_F64_POS_INF) == 0 || f64_lt(f64_abs(rb), _GEO_F64_POS_INF) == 0) {
        var ds = hvec3_length_sq(d);
        var r2 = f64_mul(r_sum, r_sum);
        if (f64_lt(ds, r2) == 1) { return 1; }
        if (f64_eq(ds, r2) == 1) { return 1; }
        return 0;
    }
    if (_geo_hvec3_finite(d) == 0 || f64_lt(f64_abs(r_sum), _GEO_F64_POS_INF) == 0) {
        for (var i = 0; i < 3; i = i + 1) {
            store64(d + i * 8, f64_sub(f64_mul(load64(ca + i * 8), F64_HALF), f64_mul(load64(cb + i * 8), F64_HALF)));
        }
        r_sum = f64_add(f64_mul(ra, F64_HALF), f64_mul(rb, F64_HALF));
    }
    var m = _geo_absmax_bits(d);
    var mr = r_sum & 0x7FFF_FFFF_FFFF_FFFF;
    if (mr > m) { m = mr; }
    var s = _geo_scale_for(m >> 52);
    var ds2: i64[3];
    for (var k = 0; k < 3; k = k + 1) { store64(&ds2 + k * 8, f64_mul(load64(d + k * 8), s)); }
    var rs = f64_mul(r_sum, s);
    if (f64_le(hvec3_length_sq(&ds2), f64_mul(rs, rs)) == 1) { return 1; }
    return 0;
}

# ================================================================
# Closest point queries
# ================================================================

# Closest point on a plane to a given point. Returns HVec3.
public fn geo_closest_point_on_plane(plane, point) {
    var sd = geo_plane_signed_distance(plane, point);
    var ns: i64[3];
    return hvec3_sub(point, _geo_scale_to(&ns, GeoPlane_normal(plane), sd));
}

# Closest point on a sphere surface to a given point. Returns HVec3.
# If point is at sphere center, returns center + (radius, 0, 0).
public fn geo_closest_point_on_sphere(sphere, point) {
    var dt: i64[3];
    var wt: i64[3];
    var dir = _geo_sub_to(&dt, point, GeoSphere_center(sphere));
    # ⛔ `len` is a DISTANCE, absolute 1e-12, so a query point near a small sphere
    # got center + (radius,0,0) — a point genuinely ON the sphere, in a direction
    # the caller never asked for. Measured at radius 2^-32 with the query on +y.
    # ⚠ Asserting |cp - center| == radius does NOT catch this; the fabrication has
    # the right length. Only the DIRECTION discriminates.
    # [measured: tests/modules.tcyr closest_point_on_sphere 3-axis sweep]
    # ⛔ 3.3.6 — NORMALISED ON A POWER-OF-TWO COPY, AS _geo_unit_or DOES. Unscaled,
    # `hvec3_length` rounds on its scaled path (a sum of squares below DBL_MIN or past
    # DBL_MAX) differently from the plain root, 1/len is subnormal past 2^1022, a length
    # past DBL_MAX was +Inf and the answer the centre itself, and below DBL_MIN the
    # guard answered centre + (radius, 0, 0) for a point that is not at the centre. So
    # 2^k times the inputs did not give 2^k times the answer: of 81761 points (40
    # directions at every 2^k where they scale exactly; centre 0, radius 1), 13322 got
    # another answer than the unit-size one (4108 by up to 1 ulp, 9194 by up to 2, 11
    # by up to 4, 7 the centre, 2 the +x fallback) and none does now; with centre and
    # radius scaled too, 1032 of 24510 and none. The copy's largest component is in
    # [1, 4), so its length is normal and 1/len at most 2^51 (the bound the two-step
    # note below needs), and only the zero vector, a point exactly at the centre, takes
    # the fallback: all 2957 points a non-zero subnormal distance away got +x (2887 of
    # them wrong) and none does. Against the exact closest point (4 ulp per
    # component), the largest error of a right answer on the 81761 falls from 3.94 to
    # 1.61 ulp (1043 above 2 ulp, none now); over 30000 random magnitudes 3 wrong ->
    # right, none right -> wrong. The one right -> wrong, a scaled input at 2^1019, is
    # 2^1019 times 3.3.5's own unit-size answer (8.76 ulp, where centre + radius * u
    # cancels). NaN and infinite inputs keep their bits (3000 of 3000).
    # [measured: C336 row-10 sweep, exact Decimal oracle, 3.3.5 vs this tree, not in-tree, 2026-10-11; cycc 6.6.14]
    # ⛔ 3.3.7 — AND point - centre THAT OVERFLOWED WAS NaN. The point (DBL_MAX, 0, 0) against
    # the centre (-DBL_MAX, 0, 0), radius 1, made dir (+Inf, 0, 0), its copy's length +Inf and
    # the answer (Inf * 0 = NaN, 0, 0) for the exact (-DBL_MAX, 0, 0). When dir is not finite
    # but the point, the centre and the radius are, it is formed from the halved inputs, exact
    # but for a subnormal component's last bit (2^-2098 of the largest), and only its direction
    # is used. A NaN or infinite input keeps its arithmetic. Of 3,995 pairs whose difference
    # overflows, 2,227 went wrong -> right and none right -> wrong; the 15 still past 4 ulp are
    # each a component where centre + radius u cancels. 4,000 ordinary inputs keep their bits.
    # [measured: rt337 overflow sweep (row7.py, seed 701), exact Decimal points, 3.3.6 vs this tree, 2026-10-31]
    var mb = _geo_absmax_bits(dir);
    if ((mb >> 52) == 2047) {
        var pc = GeoSphere_center(sphere);
        var nfr = _geo_hvec3_nonfinite(point) + _geo_hvec3_nonfinite(pc);
        if (f64_lt(f64_abs(GeoSphere_radius(sphere)), _GEO_F64_POS_INF) == 0) { nfr = 1; }
        if (nfr == 0) {
            var h0: i64[3];
            var h1: i64[3];
            dir = _geo_sub_to(&dt, _geo_scale_to(&h0, point, F64_HALF), _geo_scale_to(&h1, pc, F64_HALF));
            mb = _geo_absmax_bits(dir);
        }
    }
    var s = _geo_scale_for(mb >> 52);
    var w = _geo_scale_to(&wt, dir, s);
    var len = hvec3_length(w);
    if (f64_eq(len, 0) == 1) {
        var rv: i64[3];
        store64(&rv, GeoSphere_radius(sphere));
        store64(&rv + 8, 0);
        store64(&rv + 16, 0);
        return hvec3_add(GeoSphere_center(sphere), &rv);
    }
    # ⭐ TWO STEPS, AND THAT IS PART OF THE REPAIR. `radius / len` overflows to
    # +Inf whenever the ratio exceeds DBL_MAX — measured 77 of 601 radii at a
    # fixed offset — so normalise FIRST and scale second. This is only safe
    # because of the guard above: 1/len is bounded by 1/DBL_MIN, which is finite.
    # [measured: 3-axis sweep; 1-step fails 77 of 601, 2-step 0 of 601]
    # ⚠ THE ORIGINAL IS MULTIPLIED, NOT THE COPY, WHEREVER THAT IS EXACT. Scaled down,
    # the copy can underflow a tiny component, which the product then rounds a second
    # time. s / len is exact and normal up to a length of 2^1022, so dir * (s / len)
    # rounds once, and it is bit-identical to 3.3.5's dir * (1 / len) wherever that
    # took the plain root: 61122 of 61129 such inputs, the 7 others where a square in
    # 3.3.5's sum was subnormal. Multiplying the copy throughout kept 61100 of them and
    # lost 2 right answers of the 30000 random magnitudes to the double rounding.
    # [measured: C336 row-10 sweep, exact Decimal oracle, 3.3.5 vs this tree, not in-tree, 2026-10-11; cycc 6.6.14]
    var inv = f64_div(F64_ONE, len);
    var u = w;
    if (f64_lt(s, F64_ONE) == 1) {
        var f = f64_mul(s, inv);
        if (f64_lt(f, _GEO_F64_TINY) == 0) {
            u = dir;
            inv = f;
        }
    }
    var ut: i64[3];
    _geo_scale_to(&ut, u, inv);
    return hvec3_add(GeoSphere_center(sphere), _geo_scale_to(&ut, &ut, GeoSphere_radius(sphere)));
}

# Closest point on an AABB to a given point (clamp to box). Returns HVec3.
#
# ⛔ 3.3.3 — A NaN BOUND WAS CLAMPED STRAIGHT PAST. `f64_clamp(x, lo, hi)` tests
# `x < lo` and `x > hi`, both false against a NaN, so on an axis with a NaN bound
# it returned the query's own coordinate: the box geo_aabb_new((NaN,0,0), (1,1,1))
# and the point (-5, 0.5, 0.5) gave (-5, 0.5, 0.5), finite and with nothing to say
# the box had no x extent. (3.3.2 got (1, 0.5, 0.5) by another route: its
# hvec3_min/hvec3_max dropped the NaN corner and built the slab [1, 1].) A NaN
# bound is now NaN in its own component — the bound itself — as a NaN query
# coordinate already was; the other two components are their own clamps, which
# do not depend on that axis. Finite and infinite bounds are bit-identical to
# 3.3.2: 120000 random and near-boundary boxes, and 20000 with infinite bounds.
# [measured: R4geo probes and sweeps, 3.3.2, 3.3.3-base and repaired bundles, not in-tree, 2026-10-01; cycc 6.6.12]
# The six NaN tests cost about 4.6 ns of a 41 ns call against 3.3.2, +11% (41.7 ->
# 46.2 and 41.0 -> 45.8 ns, medians of a 64-box scratch row over two interleaved
# runs of 60 rounds at load 4-7 on 16 cores); no bench row and no caller in src/
# reaches this function. Each bound is read once per axis.
# [measured: R5geo interleaved micro A/B, 3.3.2, 3.3.3-base and repaired trees, not in-tree, 2026-10-01; cycc 6.6.12]
# ⛔ 3.4.1 — AN INVERTED BOX IS READ SORTED, as geo_aabb_aabb, geo_ray_aabb_face and geo_jet_aabb
# read it since 3.3.4 (AN INVERTED BOX, above). Only the setters build one (geo_aabb_new sorts);
# min (2, 0, 0), max (1, 1, 1) clamped x = 0.04 to 2 where the box [1, 2] gives 1. Each axis
# swaps a bound pair that is NaN-false `lo > hi`, so a sorted or NaN bound is untouched.
# [measured: GEO 3.4.1 AU2-G2-F12 repro, exact Fraction oracle, 3.4.0 vs this tree, not in-tree, 2026-10-31]
public fn geo_closest_point_on_aabb(aabb, point) {
    var mn = GeoAabb_min(aabb);
    var mx = GeoAabb_max(aabb);
    var lo = HVec3_x(mn);
    var hi = HVec3_x(mx);
    var sw = lo;
    if (f64_gt(lo, hi) == 1) { lo = hi; hi = sw; }
    var cx = f64_clamp(HVec3_x(point), lo, hi);
    if (f64_eq(lo, lo) == 0) { cx = lo; }
    if (f64_eq(hi, hi) == 0) { cx = hi; }
    lo = HVec3_y(mn);
    hi = HVec3_y(mx);
    sw = lo;
    if (f64_gt(lo, hi) == 1) { lo = hi; hi = sw; }
    var cy = f64_clamp(HVec3_y(point), lo, hi);
    if (f64_eq(lo, lo) == 0) { cy = lo; }
    if (f64_eq(hi, hi) == 0) { cy = hi; }
    lo = HVec3_z(mn);
    hi = HVec3_z(mx);
    sw = lo;
    if (f64_gt(lo, hi) == 1) { lo = hi; hi = sw; }
    var cz = f64_clamp(HVec3_z(point), lo, hi);
    if (f64_eq(lo, lo) == 0) { cz = lo; }
    if (f64_eq(hi, hi) == 0) { cz = hi; }
    return hvec3_new(cx, cy, cz);
}

# 1 when any component of `v` is NaN or +/-Inf, 0 otherwise: the house non-finite
# test, `f64_lt(|x|, +Inf) == 0`, one comparison that catches all three. Every
# finite value, DBL_MAX included, passes.
fn _geo_hvec3_nonfinite(v) {
    if (f64_lt(f64_abs(HVec3_x(v)), _GEO_F64_POS_INF) == 0) { return 1; }
    if (f64_lt(f64_abs(HVec3_y(v)), _GEO_F64_POS_INF) == 0) { return 1; }
    if (f64_lt(f64_abs(HVec3_z(v)), _GEO_F64_POS_INF) == 0) { return 1; }
    return 0;
}

# A new HVec3 holding v, or 2v when the closest-point query halved its inputs (`hv` = 1, see
# _geo_top_binade). The answer lies in the triangle's bounding box, so 2v is finite
# unless rounding carried a coordinate past DBL_MAX / 2 by an ulp. v is a stack vector, so this
# is the query's one allocation: 0, the designed failure, when it is refused (3.4.1).
fn _geo_unhalve(v, hv) {
    if (hv == 1) { return hvec3_scale(v, F64_TWO); }
    return hvec3_new(HVec3_x(v), HVec3_y(v), HVec3_z(v));
}

# 1 when b - a, c - a or p - a has a component of 2^1023 or more, an overflow to Inf
# included. The other differences the closest-point query forms (c - b, p - b, p - c)
# are differences of two of these, so they cannot overflow while these stay below
# 2^1023: an exact difference at the midpoint just below 2^1023 rounds up to it (ties to
# even). Called only on finite input (_geo_top_binade is 1), so an exponent field of
# 2047 here is an overflow.
fn _geo_spread_top_binade(a, b, c, p) {
    var d: i64[3];
    if ((_geo_absmax_bits(_geo_sub_to(&d, b, a)) >> 52) >= 2046) { return 1; }
    if ((_geo_absmax_bits(_geo_sub_to(&d, c, a)) >> 52) >= 2046) { return 1; }
    if ((_geo_absmax_bits(_geo_sub_to(&d, p, a)) >> 52) >= 2046) { return 1; }
    return 0;
}

# Closest point on a triangle to a given point (Voronoi region test). Returns HVec3.
public fn geo_closest_point_on_triangle(tri, point) {
    var a = GeoTriangle_v0(tri);
    var b = GeoTriangle_v1(tri);
    var c = GeoTriangle_v2(tri);
    # ⛔ 3.3.3 — A NaN INPUT CAME BACK AS A POINT ON THE TRIANGLE. All fifteen
    # Voronoi tests below are spelled `f64_gt(x, y) != 1` or `f64_lt(x, y) != 1`,
    # TRUE for NaN, so the first test a NaN reached read it as "in this region".
    # On the triangle (0,0,0), (4,0,0), (0,4,0), 3.3.2 returned vertex A (0,0,0)
    # for the query (NaN,NaN,NaN), (NaN,1,0) or (1,1,NaN); with C at (0,NaN,0) it
    # returned A for (-1,1,0), B (4,0,0) for (5,1,0) and the edge-AB point (1,0,0)
    # for (1,-1,0); with B at (NaN,0,0), A for (1,-1,0) and B itself, NaN only in
    # x, for (-1,5,0). Over 5200 NaN inputs — 400 random triangles and queries, a
    # NaN in each of the twelve coordinates and an all-NaN query — every answer
    # came from vertex A (3301), vertex B (1161) or edge AB (738), and every one
    # had a finite component. Now NaN in any coordinate is NaN in all three out.
    # [measured: W1 probe and sweep on the 3.3.2 bundle, not reproducible in-tree, 2026-10-01; cycc 6.6.12]
    #
    # ⭐ THE GUARD IS ON THE INPUTS, NOT ON THE FIFTEEN TESTS, AND THAT IS MEASURED.
    # A NaN also reaches the tests from FINITE input. Scaling 24 random triangles
    # and queries (coordinates below 8) by 2^e for every e in [-1022, 1023], the
    # degree-four `vc`, `vb` and `va` overflow from e = 253 on, and `Inf - Inf` is
    # NaN. There, respelling NaN-false the six tests that decide a NaN input's
    # answer (the other nine are equivalent for it) turned 1799 bit-exact answers
    # into NaN and 255 into a WRONG finite point (the NaN-true edge-BC test then
    # answers; respelling it as well removes those 255), and respelling all
    # fifteen still lost 3072 exact answers, beside the 10778 wrong ones it did
    # turn into NaN. That is the scale class, not repaired here.
    # [measured: W1 sweep, model checked against the 3.3.2 bundle, not reproducible in-tree, 2026-10-01; cycc 6.6.12]
    #
    # ⛔ 3.3.3 — AN INFINITE INPUT IS THE SAME DEFECT ONE STEP LATER, SO THE GUARD
    # IS ON NON-FINITE INPUT, NOT ON NaN ALONE. An infinite coordinate makes its
    # NaN inside (`0 * Inf` in a dot product, `Inf - Inf` in `vc`, `vb` and `va`),
    # the same NaN-true tests read it as region membership, and a vertex or an
    # edge point came back. On the triangle above, 3.3.2 returned B (4,0,0) for
    # (0,+Inf,0), where (0,2^30,0) gives C; A for (1,1,+Inf), where (1,1,2^30)
    # gives (1,1,0); A for (+Inf,-Inf,0), where (2^30,-2^30,0) gives B; and A for
    # (+Inf,+Inf,0), whose finite neighbours land on edge BC: (2,2,0) for
    # (2^30,2^30,0), B for (2^31,2^30,0), C for (2^30,2^31,0). Even (+Inf,0,0) -> B,
    # the limit along +x, came out of that path: d4 = 0 * Inf is NaN and the
    # vertex-B test accepts it. Over 4000 random triangles with one or two infinite
    # query coordinates, 1221 answers were finite and away from the answer with the
    # infinity replaced by 2^30, and none was NaN; with one infinite vertex
    # coordinate, 1686 of 3000 were finite. A guard of `f64_eq(x, x)` leaves every
    # one of those as it was. This one is the house non-finite test, so a NaN or an
    # infinity in any coordinate is NaN in all three out, as a NaN vertex is in
    # `geo_triangle_unit_normal`: the arithmetic cannot form the limit reliably, and
    # (+Inf,+Inf,0) has none. The guard is 0 for every finite input: on a sweep of
    # the shape above, 24 random triangles and queries by 2^e for every e in
    # [-1022, 1023], the 49056 all-finite cases (the other 48 overflow to Inf in
    # the scaling itself), and 39857 mixed-magnitude cases with DBL_MAX, -0 and
    # subnormal coordinates, are bit-identical to 3.3.2.
    # [measured: R4geo sweeps, 3.3.2, 3.3.3-base and repaired bundles, not in-tree, 2026-10-01; cycc 6.6.12]
    # ⚠ THE GUARD REFUSES THE RIGHT ANSWERS WITH THE WRONG ONES. Most infinite
    # queries came out at the limit on 3.3.2, bit-identical to the answer with each
    # infinity replaced by 2^30 and by 2^60: with one infinite query coordinate, 3349
    # of 4000 random triangles and queries (coordinates below 128), against 651
    # wrong; with two, 2233 against 1767; with one infinite vertex coordinate, 1360
    # against 76 wrong and 1859 NaN (705 more had no limit at those scales). Every
    # one is NaN now: the price of refusing the wrong ones (16% with one infinite
    # query coordinate, 44% with two), since nothing inside the routine tells them
    # from the right ones. The siblings keep their 3.3.2 answers at an infinite
    # query, which are the limit where a clamp forms it: geo_segment_closest_point
    # of (+Inf,0,0) on (0,0,0)-(4,0,0) is (4,0,0), and geo_closest_point_on_aabb of
    # (1,1,+Inf) on [0,4] x [0,4] x [0,0] is (1,1,0). On the triangle above, this
    # routine answered those two queries with B (the limit) and A (wrong) on 3.3.2,
    # and NaN now. The family is not aligned here.
    # [measured: R5geo infinite-input sweep and probe, 3.3.2 and repaired bundles, not in-tree, 2026-10-01; cycc 6.6.12]
    # THE GUARD COSTS about 29 ns a call against 3.3.2, +22% (132.9 -> 162.0 and
    # 131.3 -> 159.9 ns, medians of a 64-input scratch row over two interleaved runs
    # of 60 rounds at load 4-7 on 16 cores); no bench row and no caller in src/
    # reaches this function.
    # [measured: R5geo interleaved micro A/B, 3.3.2 vs 3.3.3 trees, not in-tree, 2026-10-01; cycc 6.6.12]
    var nonfinite = _geo_hvec3_nonfinite(a) + _geo_hvec3_nonfinite(b) + _geo_hvec3_nonfinite(c);
    if (nonfinite + _geo_hvec3_nonfinite(point) > 0) {
        var nan = f64_sub(_GEO_F64_POS_INF, _GEO_F64_POS_INF);   # +Inf - +Inf: a quiet NaN
        return hvec3_new(nan, nan, nan);
    }
    var at: i64[3];
    var bt: i64[3];
    var ct: i64[3];
    var pt: i64[3];
    var hv = 0;
    var a_ = a;
    var b_ = b;
    var c_ = c;
    var p_ = point;
    # ⛔ 3.3.6 — HALVED ONLY WHEN B, C OR THE QUERY IS 2^1023 OR MORE FROM A
    # (_geo_spread_top_binade), not whenever a coordinate is in the top binade (see
    # geo_triangle_unit_normal): on that note's triangle the query (2^1023, 2 * 2^-1074,
    # 0) got vertex A, not B. Testing c - b, p - b and p - c as well changed no answer
    # in the sweep below, 22 inputs where only one of those reached 2^1023 included.
    # 2^1023 and not overflow alone, because the interior answer sums ab * v + ac * w:
    # unhalved, with ab and ac near DBL_MAX and v + w a rounding above 1, that sum
    # overflowed to -Inf for one random top-binade triangle 3.3.5 answers.
    # Over the 80024 triangles and queries, against the exact closest point (each
    # component within 8 * 2^-53 of max(|exact|, the largest edge component), or a
    # faithful rounding of it): 1317 wrong -> right, and 1 right -> wrong, (-2^-1074, y,
    # 0) for (0, y, 0) inside a triangle with legs of a few 2^-1074, where the interior
    # sum's two 2^-1075 halves round to even: what 3.3.5 answers for that triangle
    # translated exactly to y = 0. Only the cancelling family moved (634 right answers).
    # [measured: C336 row-6 sweep, exact Fraction oracle, 3.3.5 vs this tree, not in-tree, 2026-10-11; cycc 6.6.14]
    if (_geo_top_binade(a, b, c, point) == 1) {
        if (_geo_spread_top_binade(a, b, c, point) == 1) {
            a_ = _geo_scale_to(&at, a, F64_HALF);
            b_ = _geo_scale_to(&bt, b, F64_HALF);
            c_ = _geo_scale_to(&ct, c, F64_HALF);
            p_ = _geo_scale_to(&pt, point, F64_HALF);
            hv = 1;
        }
    }
    var abt: i64[3];
    var act: i64[3];
    var apt: i64[3];
    var ab = _geo_sub_to(&abt, b_, a_);
    var ac = _geo_sub_to(&act, c_, a_);
    var ap = _geo_sub_to(&apt, p_, a_);
    # ⛔ 3.3.4 — THE SCALE CLASS ABOVE, REPAIRED BY PRE-SCALING (roadmap [3.3.4],
    # carried from 3.3.3). Every region quantity is a dot product of an edge with a
    # point offset (d1..d6, degree two) or a product of two (va, vb, vc, degree
    # four), and each is s^2 or s^4 times itself when all five vectors are
    # multiplied by the same power of two s: the region tests are sign tests and the
    # weights are ratios, so neither changes, and the answer is built from the
    # UNSCALED a, ab, ac, b, c. s takes the larger edge's largest component into
    # [1, 2): the edges set the scale, not the query, because d1..d6 measure the
    # query's offset ALONG the edges, which a query far off the plane does not grow
    # (a scale from the offset, tried first, flushed vc for a query 2^600 above a
    # unit triangle in z = 0 where 3.3.3 is right). Only when the offset would then
    # pass 2^1018, and a dot product with it overflow, is s held to that.
    # 24 random triangles and queries (coordinates below 8) at every 2^e, e in
    # [-1074, 1023]: 28575 of 50304 answers were more than 8 ulp of the triangle's
    # largest coordinate from the exact closest point (16012 below e = 0, 12563 above) and
    # none is now; every exactly scaled input is 2^e times its e = 0 answer, bit for
    # bit (48999, 3.3.3: 21672). The 20 at e = 1021 have an edge past DBL_MAX, and
    # the inputs are halved first there and the answer doubled (_geo_top_binade,
    # _geo_unhalve); 20000 triangles with coordinates up to DBL_MAX: 3305 right
    # before, 19960 now. The right triangle with legs 2^e: 890 of the 1401 legs
    # 2^-700 to 2^700 wrong before, none now.
    # [measured: georay triangle sweeps, exact Fraction oracle, 3.3.3 geo.cyr vs repaired, 2026-10-03; cycc 6.6.14]
    # ⚠ 35 ANSWERS GOT WORSE, AND EACH IS 3.3.3'S OWN AT UNIT SIZE. Over 27395 mixed
    # configurations (translated, thin, near-colinear, near and far queries), 5738
    # moved within 8 ulp of the exact point and 4 moved out, all four within a sine
    # of 3.1e-10 of colinear. Over 14612 with the query 2^-40 to 2^1500 edges off the
    # plane, 4631 moved in and 31 out, all 31 at least 2^100 edges off a plane in
    # general orientation, where the offset's rounding in ab . ap swamps the
    # in-plane part. In each, 3.3.3's d1..d6 or va..vc had flushed or overflowed
    # into the right region (A, or edge AB) by chance, and 3.3.3 scaled to unit size
    # answers it exactly as this does: the Voronoi tests' conditioning, not their
    # range, and not repaired here. Here "8 ulp" is of the triangle's largest
    # coordinate, so a far query's own size does not hide an in-plane error.
    # [measured: georay triangle sweeps, exact Fraction oracle, 3.3.3 geo.cyr vs repaired, 2026-10-03; cycc 6.6.14]
    var ee = _geo_absmax_bits(ab);
    var ec = _geo_absmax_bits(ac);
    if (ec > ee) { ee = ec; }
    ee = ee >> 52;
    var ep = _geo_absmax_bits(ap) >> 52;
    var k = 1023 - ee;
    if (2039 - ep < k) { k = 2039 - ep; }
    var s = _geo_pow2(k);
    var sabt: i64[3];
    var sact: i64[3];
    var sapt: i64[3];
    var bpt: i64[3];
    var cpt: i64[3];
    var dt: i64[3];
    var et: i64[3];
    var rt: i64[3];
    var sab = _geo_scale_to(&sabt, ab, s);
    var sac = _geo_scale_to(&sact, ac, s);
    var sap = _geo_scale_to(&sapt, ap, s);

    var d1 = hvec3_dot(sab, sap);
    var d2 = hvec3_dot(sac, sap);
    # Vertex A region
    if (f64_gt(d1, 0) != 1) {
        if (f64_gt(d2, 0) != 1) {
            return a;
        }
    }

    var bp = _geo_scale_to(&bpt, _geo_sub_to(&bpt, p_, b_), s);
    var d3 = hvec3_dot(sab, bp);
    var d4 = hvec3_dot(sac, bp);
    # Vertex B region
    if (f64_lt(d3, 0) != 1) {
        if (f64_gt(d4, d3) != 1) {
            return b;
        }
    }

    # Edge AB
    # ⛔ 3.3.6 — A ZERO-LENGTH EDGE AB WAS 0 / 0. With A = B (or ab flushed by the scale s)
    # d1 = d3 = 0 passes this region's tests and v = d1 / (d1 - d3) is NaN: a = b = 0, c =
    # (0,0,1), p = (0,0,0.5) gave (NaN, NaN, NaN) for (0,0,0.5), in 3.3.5 too, and the
    # top-binade triangle a = b = (B,0,0), c = (B,0,2^-1074), p = (B,0,1), B =
    # 0x7FE3819AC4F90C8F, that 3.3.5 halved into (B,0,0) became NaN once 3.3.6 stopped
    # halving it. The edge is then a point, and the answer lies on edge AC or at C, whose
    # tests follow (an AC or BC of zero length is caught by vertex B or edge AB first, so
    # their divisions are not 0 / 0).
    # [measured: C336 probe and C2 review sweep, 3.3.5 vs this tree, 2026-10-11; cycc 6.6.14]
    var vc = f64_sub(f64_mul(d1, d4), f64_mul(d3, d2));
    if (f64_gt(vc, 0) != 1) {
        if (f64_lt(d1, 0) != 1) {
            if (f64_gt(d3, 0) != 1) {
                var d13 = f64_sub(d1, d3);
                if (f64_eq(d13, 0) == 0) {
                    var v = f64_div(d1, d13);
                    return _geo_unhalve(_geo_add_to(&rt, a_, _geo_scale_to(&dt, ab, v)), hv);
                }
            }
        }
    }

    var cp = _geo_scale_to(&cpt, _geo_sub_to(&cpt, p_, c_), s);
    var d5 = hvec3_dot(sab, cp);
    var d6 = hvec3_dot(sac, cp);
    # Vertex C region
    if (f64_lt(d6, 0) != 1) {
        if (f64_gt(d5, d6) != 1) {
            return c;
        }
    }

    # Edge AC
    var vb = f64_sub(f64_mul(d5, d2), f64_mul(d1, d6));
    if (f64_gt(vb, 0) != 1) {
        if (f64_lt(d2, 0) != 1) {
            if (f64_gt(d6, 0) != 1) {
                var w = f64_div(d2, f64_sub(d2, d6));
                return _geo_unhalve(_geo_add_to(&rt, a_, _geo_scale_to(&dt, ac, w)), hv);
            }
        }
    }

    # Edge BC
    var va = f64_sub(f64_mul(d3, d6), f64_mul(d5, d4));
    if (f64_gt(va, 0) != 1) {
        var d4_d3 = f64_sub(d4, d3);
        var d5_d6 = f64_sub(d5, d6);
        if (f64_lt(d4_d3, 0) != 1) {
            if (f64_lt(d5_d6, 0) != 1) {
                var w = f64_div(d4_d3, f64_add(d4_d3, d5_d6));
                return _geo_unhalve(_geo_add_to(&rt, b_, _geo_scale_to(&dt, _geo_sub_to(&dt, c_, b_), w)), hv);
            }
        }
    }

    # Interior
    var denom = f64_div(F64_ONE, f64_add(f64_add(va, vb), vc));
    var v = f64_mul(vb, denom);
    var w = f64_mul(vc, denom);
    _geo_scale_to(&dt, ab, v);
    _geo_scale_to(&et, ac, w);
    return _geo_unhalve(_geo_add_to(&rt, a_, _geo_add_to(&dt, &dt, &et)), hv);
}

# ================================================================
# Exact sums for the thin and colinear triangle paths and the subnormal plane (3.4.1)
# ================================================================
# The thin and colinear triangle paths work on the UNSCALED exact differences (the caller's power of
# two flushed a subnormal edge component and called a thin triangle colinear: (0,0,0), (1,0,0),
# (2, 2^-1074, 0)), and their cross products and Gram quantities pass the double range (|n| under
# 2^-537 made |n|^2 0 and the weights NaN), so every one is an exact integer sum of products
# (_geo_xi_add2, the accumulator of _geo_ray_tri_exact), its sign exact and its value rounded once.
# ⛔ 3.4.1 — THE EXTENDED-EXPONENT SUMS THEY REPLACE LOST WHAT A CANCELLATION LEFT (GEO2 G2-F1, the
# class of RV-GEO M1). 3.4.0 formed each product as two doubles times a power of two of its own and
# summed them at the largest one's power (_geo_esum, now gone), where a product more than 2^1074 below
# the largest flushed to 0; where the large products cancel exactly, the flushed ones are the sum.
# The colinear (2^500, 2^-500, 0), (2^500, 3 2^-500, 0), (2^500, 3.5 2^-500, 0) with the point at
# y = 5 2^-500 read |g|^2 = 0 and got NaN weights for (-0.738, 0.690, 1.048), and so did the same
# shape at x = 1e6 with y extents 1e-300; the thin (0, 2^1000, 2^1000), (0, 3 2^-540, 2^-540),
# (0, 2^-538, 2^-539) read its cross product 0 and was answered as colinear: (0, 0.5, 0.5) for
# the point t1 + 2 (t2 - t1), whose weights are (0, -1, 2); and geo_ray_plane's small path read
# n . d = 2^-1200 as 0 (n = (1, 1, 2^-600), d = (1, -1, 2^-600)) and answered the miss for t = 1.
# 3.4.0 and the first 3.4.1 passes gave each of these answers. Over families built to reach them
# (exactly cancelling large products at every scale) and controls, 4 seeds of 24,000: the thin
# path is never wrong now, where 3.4.0 and s7 were on 2146-2200 of about 3985 slivers and
# 1486-1588 of 4000 far colinear triangles a seed; the small plane path is never wrong either
# (s7: 1272-1332 of about 2470 cancelling rays a seed, 3.4.0 1615-1695).
# [measured: GEO3 3.4.1 repro1.py, plane_repro.py, bsw.py, psw.py, Fraction oracle, 3.4.0 / s7 / this tree, 2026-10-31]

# The exponent bias of _geo_xw_dot's records: products of two words of exact cross products lie in
# 2^-4400 .. 2^4000, below the 2^-3222 at which the accumulator starts; each record carries
# 2^_GEO_XW_BIAS more, so a product lands at bit 102 or above, and limb 272 at most (288 words).
enum _GeoXi {
    _GEO_XW_BIAS = 640;
}

# The sum's sign (-1, 0, 1), and its value correctly rounded at out: out[0] = +-m (a double, m an
# integer in [2^52, 2^53)) and out[1] the exponent less `bias`, or (0, 0) for a zero sum.
fn _geo_xi_val(acc, bias, out) {
    var sg = _geo_xi_norm(acc);
    _geo_xi_mag(acc, out);
    if (sg == 0) { return 0; }
    store64(out + 8, load64(out + 8) - bias);
    if (sg < 0) { store64(out, f64_neg(load64(out))); }
    return sg;
}

# The sum at acc as two records at out (six words, _geo_xi_vec's form, exponents raised by
# _GEO_XW_BIAS): hi the sum correctly rounded and lo the rest of it rounded (|S - hi - lo| <= 2^-53
# |lo|); m = 0 for a zero word. Returns the sum's sign. (|S| - |hi| is formed in the accumulator
# itself, which _geo_xi_mag leaves holding |S|.)
fn _geo_xi_words(acc, out) {
    for (var i = 0; i < 6; i = i + 1) { store64(out + i * 8, 0); }
    var sg = _geo_xi_norm(acc);
    if (sg == 0) { return 0; }
    var mg: i64[2];
    _geo_xi_mag(acc, &mg);
    var hr: i64[3];
    store64(&hr, (load64(&mg) & 0x000F_FFFF_FFFF_FFFF) | 0x0010_0000_0000_0000);
    store64(&hr + 8, load64(&mg + 8));
    store64(&hr + 16, 0);
    var one: i64[3];
    store64(&one, 1);
    store64(&one + 8, 0);
    store64(&one + 16, 0);
    var neg = 0;
    if (sg < 0) { neg = 1; }
    store64(out, load64(&hr));
    store64(out + 8, load64(&hr + 8) + _GEO_XW_BIAS);
    store64(out + 16, neg);
    _geo_xi_add2(acc, &hr, &one, 1);
    var s2 = _geo_xi_norm(acc);
    if (s2 == 0) { return sg; }
    _geo_xi_mag(acc, &mg);
    store64(out + 24, (load64(&mg) & 0x000F_FFFF_FFFF_FFFF) | 0x0010_0000_0000_0000);
    store64(out + 32, load64(&mg + 8) + _GEO_XW_BIAS);
    if (s2 < 0) { neg = neg ^ 1; }
    store64(out + 40, neg);
    return sg;
}

# Component i of (a + m) x (b + m) exactly, as two words (_geo_xi_words) at out; a, b and m
# three-record vectors (_geo_xi_vec), m the negated common vertex, so the edges a + m and b + m are
# exact: a x b + a x m + m x b, six products of two (m x m is 0). Returns its sign.
fn _geo_xi_cross_c(a, b, m, i, out) {
    var j = i + 1;
    if (j == 3) { j = 0; }
    var k = j + 1;
    if (k == 3) { k = 0; }
    var acc: i64[208];
    _geo_xi_init(&acc);
    _geo_xi_add2(&acc, a + j * 24, b + k * 24, 0);
    _geo_xi_add2(&acc, a + k * 24, b + j * 24, 1);
    _geo_xi_add2(&acc, a + j * 24, m + k * 24, 0);
    _geo_xi_add2(&acc, a + k * 24, m + j * 24, 1);
    _geo_xi_add2(&acc, m + j * 24, b + k * 24, 0);
    _geo_xi_add2(&acc, m + k * 24, b + j * 24, 1);
    return _geo_xi_words(&acc, out);
}

# (a + m) x (b + m) into out as three two-word components (18 words); 1 when it is exactly 0.
fn _geo_xi_cross3(a, b, m, out) {
    var z = 0;
    for (var i = 0; i < 3; i = i + 1) {
        if (_geo_xi_cross_c(a, b, m, i, out + i * 48) != 0) { z = 1; }
    }
    return 1 - z;
}

# (a + al) . (b + bl) exactly, correctly rounded as out[0] 2^out[1] (_geo_xi_val); three-record
# vectors, twelve products of two.
fn _geo_xi_xdot(a, al, b, bl, out) {
    var acc: i64[208];
    _geo_xi_init(&acc);
    for (var i = 0; i < 3; i = i + 1) {
        _geo_xi_add2(&acc, a + i * 24, b + i * 24, 0);
        _geo_xi_add2(&acc, a + i * 24, bl + i * 24, 0);
        _geo_xi_add2(&acc, al + i * 24, b + i * 24, 0);
        _geo_xi_add2(&acc, al + i * 24, bl + i * 24, 0);
    }
    return _geo_xi_val(&acc, 0, out);
}

# The dot product of two vectors of two-word components (_geo_xi_cross3), exactly, correctly rounded
# as out[0] 2^out[1]: the twelve products of their words. (3.4.0, second review S-b: with each
# component rounded to one word, the triangle normal's direction error, 2^-53, let the query's
# distance off the plane into the weights: 482 ulp at 2^10 heights, 4.5e8 at 2^30.)
fn _geo_xw_dot(a, b, out) {
    var acc: i64[288];
    _geo_xi_init(&acc);
    for (var i = 0; i < 3; i = i + 1) {
        var pa = a + i * 48;
        var pb = b + i * 48;
        _geo_xi_add2(&acc, pa, pb, 0);
        _geo_xi_add2(&acc, pa, pb + 24, 0);
        _geo_xi_add2(&acc, pa + 24, pb, 0);
        _geo_xi_add2(&acc, pa + 24, pb + 24, 0);
    }
    return _geo_xi_val(&acc, 2 * _GEO_XW_BIAS, out);
}

# The weights of a thin or degenerate triangle (3.4.0, geo_barycentric_coords): t0, t1, t2 and tp
# the vertices and the point AS GIVEN, each edge carried exactly as the two words (vertex, -t0).
# (The second review's N1: formed from the top-binade caller's halved vertices, a subnormal component
# halved to 0 and an exactly colinear triangle was answered as a thin one, (1, 0, 0) for the
# contract's (5/6, 1/3, -1/6); and a thin one as colinear the other way, S6's case in the top binade.)
#   * EXACTLY COLINEAR, coincident vertices included ((b - a) x (c - a) exactly 0): the [3.4.0]
#     contract, the least-squares answer of minimum norm, lambda with sum 1 and sum lambda_i v_i the
#     orthogonal projection of p onto the line, of least |lambda| among those: with B_i the vertices'
#     coordinates along the line from a (B_0 = 0) and P the point's, M their mean and S2 the sum of
#     the (B_i - M)^2, lambda_i = 1/3 + (P - M)(B_i - M) / S2. It reproduces a point on the line
#     (exactly in exact arithmetic), and gives (1/3, 1/3, 1/3) when the vertices coincide. (It is
#     the pseudo-inverse answer of [a b c; 1 1 1] lambda = [p; 1] in a frame whose origin lies on
#     the line; in a frame whose origin does not, that pseudo-inverse is not translation invariant
#     and its weights need not sum to 1, so the frame-free form is the one taken.) The coordinates
#     B_i and P are exact dot products with the longer edge AS TWO WORDS (its rounding carried: a
#     point 2^20 edges off the line had P off by 2^-53 of that distance from the edge's direction
#     alone, review S4).
#   * OTHERWISE, a thin triangle: the weights of p's projection onto its plane from exact cross
#     products, n = v0 x v1, v = ((v2 x v1) . n) / |n|^2 and w = ((v0 x v2) . n) / |n|^2, u = 1 - v - w,
#     where the Gram form d00 d11 - d01^2 has lost 16 bits or more to cancellation; every cross
#     and dot product is an exact integer sum rounded once ("Exact sums" above), so a triangle
#     2^-1074 off its line is answered, and so is one whose large products cancel exactly.
#   * Weights past DBL_MAX are +-Inf: v and w are quotients formed at their own powers of two;
#     where both overflow with opposite signs, u comes from its own cross product, ((t1 - p) x
#     (t2 - p)) . n / |n|^2, not from 1 - v - w; and a colinear point more than 2^1000 edge
#     lengths squared along the line has P c_i / S2 formed at P's power of two, so a c_i of 0
#     keeps its weight 1/3 (3.4.1).
# [measured: rt340 barycentric families (bary.py) and the review's tN, tC (REV-RT-py), exact Fractions, 2026-10-31]
fn _geo_bary_thin(t0, t1, t2, tp) {
    # (A NaN or infinite input: NaN weights, as the Gram form gives them.)
    var nf = _geo_hvec3_nonfinite(t0) + _geo_hvec3_nonfinite(t1) + _geo_hvec3_nonfinite(t2);
    if (nf + _geo_hvec3_nonfinite(tp) != 0) {
        var nan = f64_sub(_GEO_F64_POS_INF, _GEO_F64_POS_INF);
        return hvec3_new(nan, nan, nan);
    }
    # Each edge is the two words (vertex, -t0): exact, at any magnitude, nothing halved or rounded;
    # every vertex as three records (_geo_xi_vec), -t0's with its signs flipped.
    var rv: i64[36];
    _geo_xi_vec(t0, &rv);
    for (var i = 0; i < 3; i = i + 1) { store64(&rv + i * 24 + 16, load64(&rv + i * 24 + 16) ^ 1); }
    _geo_xi_vec(t1, &rv + 72);
    _geo_xi_vec(t2, &rv + 144);
    _geo_xi_vec(tp, &rv + 216);
    var na = &rv;
    var r1 = &rv + 72;
    var r2 = &rv + 144;
    var rp = &rv + 216;
    var n: i64[18];
    if (_geo_xi_cross3(r1, r2, na, &n) == 0) {
        var m1: i64[18];
        var m2: i64[18];
        _geo_xi_cross3(rp, r2, na, &m1);
        _geo_xi_cross3(r1, rp, na, &m2);
        var dn[16];
        var d1[16];
        var d2[16];
        _geo_xw_dot(&n, &n, &dn);
        _geo_xw_dot(&m1, &n, &d1);
        _geo_xw_dot(&m2, &n, &d2);
        var v = _geo_ldexp(f64_div(load64(&d1), load64(&dn)), load64(&d1 + 8) - load64(&dn + 8));
        var w = _geo_ldexp(f64_div(load64(&d2), load64(&dn)), load64(&d2 + 8) - load64(&dn + 8));
        var u = f64_sub(F64_ONE, f64_add(v, w));
        if (f64_eq(u, u) == 0) {
            # v and w past DBL_MAX with opposite signs (+Inf + -Inf): u from its own cross product,
            # ((t1 - p) x (t2 - p)) . n / |n|^2, the point's words negated in place.
            for (var k = 0; k < 3; k = k + 1) { store64(rp + k * 24 + 16, load64(rp + k * 24 + 16) ^ 1); }
            _geo_xi_cross3(r1, r2, rp, &m1);
            _geo_xw_dot(&m1, &n, &d1);
            u = _geo_ldexp(f64_div(load64(&d1), load64(&dn)), load64(&d1 + 8) - load64(&dn + 8));
        }
        return hvec3_new(u, v, w);
    }
    # Colinear: coordinates along the line through a, from the longer edge g (two words; the edges
    # compared at half size, where their differences cannot overflow).
    var e0z = 1;
    var e1z = 1;
    var h0[24];
    var h1[24];
    for (var j = 0; j < 3; j = j + 1) {
        var aj = load64(t0 + j * 8);
        if (f64_eq(load64(t1 + j * 8), aj) == 0) { e0z = 0; }
        if (f64_eq(load64(t2 + j * 8), aj) == 0) { e1z = 0; }
        var ah = f64_mul(aj, F64_HALF);
        store64(&h0 + j * 8, f64_sub(f64_mul(load64(t1 + j * 8), F64_HALF), ah));
        store64(&h1 + j * 8, f64_sub(f64_mul(load64(t2 + j * 8), F64_HALF), ah));
    }
    if (e0z == 1 && e1z == 1) {
        return hvec3_new(_GEO_F64_THIRD, _GEO_F64_THIRD, _GEO_F64_THIRD);   # coincident: the projection is that point
    }
    var g = r1;
    if (e0z == 1 || (e1z == 0 && _geo_absmax_bits(&h1) > _geo_absmax_bits(&h0))) { g = r2; }
    var x1[16];
    var x2[16];
    var xp[16];
    _geo_xi_xdot(r1, na, g, na, &x1);
    _geo_xi_xdot(r2, na, g, na, &x2);
    _geo_xi_xdot(rp, na, g, na, &xp);
    # The edges' coordinates set the scale (B_1 or B_2 is |g|^2 > 0; the larger taken into [1, 2)); P
    # is taken there too.
    var eb = load64(&x1 + 8);
    if (f64_eq(load64(&x1), 0) == 1 || (f64_eq(load64(&x2), 0) == 0 && load64(&x2 + 8) > eb)) { eb = load64(&x2 + 8); }
    eb = eb + 52;
    var b1 = _geo_ldexp(load64(&x1), load64(&x1 + 8) - eb);
    var b2 = _geo_ldexp(load64(&x2), load64(&x2 + 8) - eb);
    var mm = f64_mul(f64_add(b1, b2), _GEO_F64_THIRD);
    var c0 = f64_neg(mm);
    var c1 = f64_sub(b1, mm);
    var c2 = f64_sub(b2, mm);
    var s2 = f64_add(f64_add(f64_mul(c0, c0), f64_mul(c1, c1)), f64_mul(c2, c2));
    var de = load64(&xp + 8) - eb;
    if (de > 947 && f64_eq(load64(&xp), 0) == 0) {
        # P past 2^1000 edge lengths squared (the b's are below 2): P - M is P to 2^-947, and P c_i / S2
        # is formed at P's own power of two, so a weight past DBL_MAX is +-Inf and one whose c_i is
        # 0 stays 1/3 (P's double would be +Inf, and Inf * 0 the NaN).
        var hp = load64(&xp);
        return hvec3_new(f64_add(_GEO_F64_THIRD, _geo_ldexp(f64_div(f64_mul(hp, c0), s2), de)),
          f64_add(_GEO_F64_THIRD, _geo_ldexp(f64_div(f64_mul(hp, c1), s2), de)),
          f64_add(_GEO_F64_THIRD, _geo_ldexp(f64_div(f64_mul(hp, c2), s2), de)));
    }
    var pp = _geo_ldexp(load64(&xp), de);
    var kk = f64_div(f64_sub(pp, mm), s2);
    return hvec3_new(f64_add(_GEO_F64_THIRD, f64_mul(kk, c0)), f64_add(_GEO_F64_THIRD, f64_mul(kk, c1)),
      f64_add(_GEO_F64_THIRD, f64_mul(kk, c2)));
}

# geo_barycentric_coords' routing and its certified weights (3.4.1, GEO5). Fills w with (u, v, w) and
# returns 1 when they are certified; returns 2 for a NaN or infinite input, w then holding the Gram
# form's weights (3.4.0's bits); returns 0 when the caller is to take _geo_bary_thin: a thin, colinear
# or top-binade triangle, or one outside this path's range or its bound.
# ROUTING, 3.4.0's bit for bit but without its seven allocations: the rounded differences e1 = v1 - v0,
# e2 = v2 - v0 and s = p - v0, taken by the power of two that brings the larger edge's largest
# component into [1, 2), the Gram floats (hvec3_dot's arithmetic: f64v_dot of x and y, plus z), and the
# switch: |d00 d11 - d01^2| under 2^-16 d00 d11 or DBL_MIN takes _geo_bary_thin, so every thin and
# colinear triangle keeps the bits 3.4.0 and GEO3 gave it.
# THE CERTIFIED WEIGHTS. Above the switch 3.4.0 answered the Gram solve (v0, w0), whose error is the
# Gram form's conditioning, |e1|^2 |e2|^2 / |d00 d11 - d01^2| (the angle's at v0 squared): up to
# 1.8e5 ulps of the largest weight (GF3-1), RT F4's triangles 2^-6 from colinear 282 of 300 beyond 64
# ulps. It is now refined once with an EXACT residual, and the result certified by a proven bound:
#   * v' and w' are v0 and w0 rounded to 26 bits; each scaled edge component is split at bit 27 into
#     a 26-bit head h and lf, the rest of the EXACT edge ((component - h) plus the difference's two_sum
#     error, scaled), so v' h is exact. Per component, y = v' h1 + w' h2 with its two_sum error ey,
#     z = RN(y - s~) and lo = ey + v' lf1 + w' lf2 - g (g the offset's two_sum error): the residual
#     R = v' e1 + w' e2 - s of the exact scaled edges is z + lo, up to z's rounding (u |z|, u = 2^-53)
#     and lo's (6.01 u of terms below 2^-25.9 lt, lt = (|v'| + |w'|) A + |s|max, A the edges' largest
#     |component|).
#   * The exact weights satisfy s = v e1 + w e2 + a n (n = e1 x e2), so R = x1 e1 + x2 e2 - a n with
#     x = (v' - v, w' - w), and (R . e1, R . e2) = G x exactly, G the exact edges' Gram matrix: the
#     point's distance off the plane drops out. (dv, dw) solves it with the Gram floats G~ and
#     v = RN(v' - dv), w = RN(w' - dw), u = RN(1 - RN(v + w)).
#   * (dv, dw) - x = G~^-1 ((b~ - b) + (G - G~) x) plus the solve's roundings, b~ the formed right
#     side: |G00 - d00| <= 5.02 u d00, |G01 - d01| <= 5.02 u (sum |e1_c e2_c|) and |G11 - d11| <= 5.02 u
#     d11 (the edges' roundings and the dots'), and |denom~| is within 2^-35.9 of det G~ (the switch
#     keeps it above 2^-16 d00 d11).
#   * NEAR THE PLANE (|z|_1 < 2^-8 lt): b~ = (R~ . e1~, R~ . e2~) in plain doubles, R~ = z + lo,
#     |b~_i - b_i| <= 7.31 u rs A (the dot's 3u, the omitted R . f's u, the residual's 3.3u; rs = |z|_1
#     + 2^-23 lt + 2^-1000), so with K = (max(d00, d11) + |d01|) |inv| (each row of |G~^-1| summed)
#     and C = 5.25 u (d00 + d11) K < 2^-20: |dv - x1|, |dw - x2| <= (9.5 u rs K A + (C + 2^-33)(|dv|
#     + |dw|)) (1 + 2^-18) (the 2^-33 the solve's 2u and the denominator's 2^-35.9 times |dv|).
#   * OFF THE PLANE a n puts its length h into R, and the plain sums' roundings, about u h A, into b~:
#     h / (|e1| sin^2) of a weight, which that bound reports. The second stage forms b from R as two
#     words (z, and lo + ez, ez z's two_sum error) and z's 26-bit head t: t h exactly, the three summed
#     by two_sum, the rest (t lf + ((z - t) + lo + ez) e~, below 2^-25 of it) in plain sums, so
#     |b~_i - b_i| <= 2.01 u |b~_i| + (2^-73 |z|_1 + 2^-49.4 |lo|_1 + 2^-74.4 lt) A_i, and |dv - x1| <=
#     4.25 u Qv + (2^-71 |z|_1 + 2^-49 |lo|_1 + 2^-74 lt) Pv + (c11 + 2^-33)|dv| + cv2 |dw| + cm (both
#     errors), first with the shared K (Qv <= K max|b~|, Pv <= K A, the c's <= C), else row by row:
#     Qv = (d11 |b~1| + |d01| |b~2|) |inv|, Pv = (d11 A1 + |d01| A2) |inv|, c11 = 10.125 u g^2 |inv|,
#     cv2 = 10.125 u g d11 |inv|, cw1 = 10.125 u g d00 |inv| (g = sqrt(d00 d11), at least sum |e1_c
#     e2_c|), cm their largest, below 2^-20 (Ew likewise, d00 and d11 exchanged).
#   * CERTIFIED when both bounds are at most 2^-52 (1 - 2^-20) M~, M~ the largest computed |weight|.
#     Then v and w are within 2^-53 |v| + 2^-52 M~ <= 3.01 2^-53 M of the exact weights (M the largest
#     exact |weight|; M~ is within 9.01 2^-53 M of it) and u within 2^-53 (|u| + |v + w|) plus both,
#     9.01 2^-53 M: the bounds _geo_bary_thin's exact cross products give (3 2^-53 |v| for v and w,
#     9 2^-53 M for u).
#   * Range: the two edges' largest components within 2^300 of each other, the scaled offset below
#     2^300 and v0, w0 below 2^600, so nothing overflows, and a product of tiny components that
#     underflows errs by at most 2^-1074, inside the 2^-1000 and lt terms. Outside it, where C or cm
#     reaches 2^-20, and wherever the bound declines, _geo_bary_thin.
#   * WHERE IT DECLINES. The floor is the residual's own rounding, 2^-74 lt: in a row it weighs
#     2^-74 / (rho sin^2 a) of a weight, rho the shorter edge over the longer and a the angle at v0, so
#     the bound reaches the 2^-52 threshold near rho sin^2 a = 2^-22 with the point in the plane and
#     near 2^-20 off it. Ordinary triangles (rho near 1) are certified down to the switch. Carrying
#     v0 and w0 whole instead of their 26-bit heads only raised the floor (more declined in every
#     cell of a rho / a grid), so a tighter bound needs an exact lo, at the thin path's kind of cost.
# [measured: GEO3 3.4.1 bsw_gram.py (GF3-1); GEO5 3.4.1 fams.py rtf4, Fraction oracle, 2026-11-01]
fn _geo_bary_cert(t0, t1, t2, tp, w) {
    var p0x = load64(t0);
    var p0y = load64(t0 + 8);
    var p0z = load64(t0 + 16);
    var q1x = load64(t1);
    var q1y = load64(t1 + 8);
    var q1z = load64(t1 + 16);
    var q2x = load64(t2);
    var q2y = load64(t2 + 8);
    var q2z = load64(t2 + 16);
    var qpx = load64(tp);
    var qpy = load64(tp + 8);
    var qpz = load64(tp + 16);
    var u1x = f64_sub(q1x, p0x);
    var u1y = f64_sub(q1y, p0y);
    var u1z = f64_sub(q1z, p0z);
    var u2x = f64_sub(q2x, p0x);
    var u2y = f64_sub(q2y, p0y);
    var u2z = f64_sub(q2z, p0z);
    var usx = f64_sub(qpx, p0x);
    var usy = f64_sub(qpy, p0y);
    var usz = f64_sub(qpz, p0z);
    # The largest |component| of each difference, as bits (_geo_absmax_bits).
    var m1 = u1x & 0x7FFF_FFFF_FFFF_FFFF;
    var mt = u1y & 0x7FFF_FFFF_FFFF_FFFF;
    if (mt > m1) { m1 = mt; }
    mt = u1z & 0x7FFF_FFFF_FFFF_FFFF;
    if (mt > m1) { m1 = mt; }
    var m2 = u2x & 0x7FFF_FFFF_FFFF_FFFF;
    mt = u2y & 0x7FFF_FFFF_FFFF_FFFF;
    if (mt > m2) { m2 = mt; }
    mt = u2z & 0x7FFF_FFFF_FFFF_FFFF;
    if (mt > m2) { m2 = mt; }
    var ms = usx & 0x7FFF_FFFF_FFFF_FFFF;
    mt = usy & 0x7FFF_FFFF_FFFF_FFFF;
    if (mt > ms) { ms = mt; }
    mt = usz & 0x7FFF_FFFF_FFFF_FFFF;
    if (mt > ms) { ms = mt; }
    var m = m1;
    if (m2 > m) { m = m2; }
    var mo = m;
    if (ms > mo) { mo = ms; }
    # ⛔ 3.3.6 — HALVED ONLY WHEN v0, v1 OR v2 REACHES 2^1023 (or overflows), not
    # whenever a coordinate is in the top binade (see geo_triangle_unit_normal): on that
    # note's triangle the query (2^1023, 2^-1074, 2^-1074) got the centroid where the
    # weights are (-1, 1, 1). Over the 80024 triangles and queries, within 64 * 2^-53 of
    # the largest exact weight: 3672 wrong -> right and 27 right -> wrong, each of the
    # 27 the weights 3.3.5 itself gives that triangle translated exactly to an ordinary
    # position. 23 are exactly colinear, where the Gram form does not cancel to zero and
    # 3.3.5 answered the centroid only because halving rounded the subnormal legs; 4 are
    # thin with subnormal legs (19-50 -> 104-356 * 2^-53: the Gram form's conditioning,
    # not its range). Only the cancelling family moved (82 right answers).
    # [measured: C336 row-6 sweep, exact Fraction oracle, 3.3.5 vs this tree, not in-tree, 2026-10-11; cycc 6.6.14]
    # ⛔ 3.4.1 — THE HALVED COPY IS CERTIFIED TOO (GEO5): 3.4.0 answered it by the Gram form alone, 160 of
    # 8000 top-binade triangles beyond 64 2^-53 of the largest weight (up to 5.1e7); now none. The copy is
    # halved as 3.4.0 halved it and taken through this routine, so where every half is exact it is the
    # same triangle at half size and gets the unscaled answer's bits (the 2^-1021..2^1021 sweep in
    # modules_c); a component whose half rounds (a subnormal's odd last bit) takes _geo_bary_thin.
    # [measured: GEO5 3.4.1 g5sw.py topbin family, Fraction oracle, 3.4.0 / s14 / this tree, 4 seeds, 2026-11-01]
    if ((mo >> 52) >= 2046) {
        if (_geo_top_binade(t0, t1, t2, tp) == 1) {
            var hv: i64[12];
            for (var i = 0; i < 12; i = i + 1) {
                var src = t0;
                if (i >= 9) { src = tp; } elif (i >= 6) { src = t2; } elif (i >= 3) { src = t1; }
                var c = load64(src + (i % 3) * 8);
                var h = f64_mul(c, F64_HALF);
                if (f64_add(h, h) != c) { return 0; }   # the half rounded: not the same triangle
                store64(&hv + i * 8, h);
            }
            return _geo_bary_cert(&hv, &hv + 24, &hv + 48, &hv + 72, w);
        }
    }
    # ⛔ 3.3.4 — PRE-SCALED (roadmap D038): v0, v1 and v2 by the power of two that
    # brings the larger edge's largest component into [1, 2). The weights are degree
    # zero in it, so they are the unit-size answer, bit for bit; the edges set the
    # scale and not the point, because a far point only makes the weights large.
    # See the `denom` note below for what this repairs. ⚠ So a NON-FINITE query with
    # finite edges is scaled too, and its answer need not be 3.3.3's: a right triangle
    # with legs 2^-294 and the query (-Inf, 0, 0) gives NaN weights, where 3.3.3 gave
    # the centroid (102 of 3000 such inputs moved).
    # [measured: barycentric review sweep and probe, 3.3.4-base vs this tree, not in-tree, 2026-10-03; cycc 6.6.14]
    # 3.4.0's scale (_geo_scale_for / _geo_pow2, written out): 2^k, k = 1023 - e(m), held to 2037 - e(s)
    # (as in geo_closest_point_on_triangle: the query's offset below 2^1015, where d20 * d11 and
    # d21 * d01 cannot overflow).
    var sc = F64_ONE;
    var em = m >> 52;
    if (em < 2047) {
        var k = 1023 - em;
        var ep = ms >> 52;
        if (ep < 2047) {
            if (2037 - ep < k) { k = 2037 - ep; }
        }
        if (k < 0 - 1022) { k = 0 - 1022; }
        sc = (1023 + k) << 52;
    }
    var sa: i64[3];
    var sb: i64[3];
    var ss: i64[3];
    var ax = f64_mul(u1x, sc);
    var ay = f64_mul(u1y, sc);
    var az = f64_mul(u1z, sc);
    var bx = f64_mul(u2x, sc);
    var by = f64_mul(u2y, sc);
    var bz = f64_mul(u2z, sc);
    var sx = f64_mul(usx, sc);
    var sy = f64_mul(usy, sc);
    var sz = f64_mul(usz, sc);
    store64(&sa, ax);
    store64(&sa + 8, ay);
    store64(&sb, bx);
    store64(&sb + 8, by);
    store64(&ss, sx);
    store64(&ss + 8, sy);
    var d00 = f64_add(f64v_dot(&sa, &sa, 2), f64_mul(az, az));   # hvec3_dot's arithmetic, without the call
    var d01 = f64_add(f64v_dot(&sa, &sb, 2), f64_mul(az, bz));
    var d11 = f64_add(f64v_dot(&sb, &sb, 2), f64_mul(bz, bz));
    var dd = f64_mul(d00, d11);
    var denom = f64_sub(dd, f64_mul(d01, d01));
    # ⛔ `denom` is the Gram determinant — (2*Area)², degree FOUR in the triangle's
    # units — and it was tested against an absolute 1e-12, with a fallback that is a
    # FABRICATION that cannot be told from success: (1/3, 1/3, 1/3) sums to 1 and
    # lies inside the triangle. Measured in 241 of 241 failing samples for a point
    # whose true weights are (0.25, 0.25, 0.5). The threshold became DBL_MIN on the
    # reasoning that only `1 / denom` can fail, at `inv_denom` below.
    # [measured: triangle-scale sweep on the shipped binary]
    # ⛔ 3.3.4 — THAT REASONING WAS WRONG: A DEGREE-FOUR QUANTITY FAILS BEFORE ITS
    # RECIPROCAL. Unscaled, legs at or below 2^-256 flushed d00 * d11 and returned
    # the centroid, and legs at or above 2^256 overflowed it to NaN: 890 of the 1401
    # right triangles with legs 2^-700 to 2^700 were wrong (1587 of 2098 from 2^-1074
    # to 2^1023), and 38031 of 50304 random triangles across every 2^e. With the
    # pre-scaling above none is, nor 18297 of 20000 with coordinates up to DBL_MAX
    # (none right before; the inputs are halved first there, as in
    # geo_triangle_unit_normal). In 27395 mixed configurations no answer within
    # 64 * 2^-53 of the largest exact weight left that band and 9345 entered it.
    # [measured: georay triangle sweeps, exact Fraction oracle, 3.3.3 geo.cyr vs repaired, 2026-10-03; cycc 6.6.14]
    # ⚠ (3.3.4 — superseded in 3.4.0, below: the guard and its centroid are gone.) THE GUARD STAYS, AND
    # STILL ANSWERS FOR MORE THAN AN EXACT ZERO. After the
    # scaling, a triangle that is not exactly colinear got the centroid in 1488 of
    # those 27395, every one with the sine of the angle at v0 below about 2^-25.4:
    # there |v0|²|v1|² sin² is under one rounding of d00 * d11, so the Gram form
    # cancels to zero. That is its conditioning, not its range, and not repaired.
    # [measured: georay triangle sweeps, exact Fraction oracle, repaired bundle, 2026-10-03; cycc 6.6.14]
    # ⛔ 3.4.0 — THE CENTROID FALLBACK IS GONE. It answered (1/3, 1/3, 1/3) for every triangle whose
    # Gram form read under DBL_MIN, whatever the point: of the roadmap's 400 full-mantissa exactly
    # colinear triangles with the point on their line, 134 took it and none reproduced the point
    # (residual up to 3.32 of the triangle); of this lane's 400, 6 had weights within 64 ulps of the
    # contract's (worst residual 11.3), and now 400 do (1.3e-13). A triangle whose Gram form is
    # under 2^-16 of d00 d11 (an angle at v0 under 2^-8 rad, where that form has lost 16 bits or more) takes
    # _geo_bary_thin: exactly colinear vertices (or coincident ones) get the [3.4.0] contract's
    # least-squares answer, every other thin triangle its weights from exact cross products.
    # [measured: rt340 barycentric families (bary.py), exact Fraction oracle, 3.4.0 base vs this tree, 2026-10-31]
    if (f64_lt(f64_abs(denom), f64_mul(dd, 0x3EF0_0000_0000_0000)) == 1   # 2^-16
      || f64_lt(f64_abs(denom), _GEO_F64_TINY) == 1) {
        return 0;
    }
    var d20 = f64_add(f64v_dot(&ss, &sa, 2), f64_mul(sz, az));
    var d21 = f64_add(f64v_dot(&ss, &sb, 2), f64_mul(sz, bz));
    var inv = f64_div(F64_ONE, denom);
    var v0 = f64_mul(f64_sub(f64_mul(d11, d20), f64_mul(d01, d21)), inv);
    var w0 = f64_mul(f64_sub(f64_mul(d00, d21), f64_mul(d01, d20)), inv);
    if ((mo >> 52) == 2047) {
        # A NaN or infinite input: the Gram form's weights, 3.4.0's bits.
        store64(w, f64_sub(F64_ONE, f64_add(v0, w0)));
        store64(w + 8, v0);
        store64(w + 16, w0);
        return 2;
    }
    # The range: the edges' largest components within 2^300 of each other, the offset below 2^300
    # and v0, w0 below 2^600 (scaled; 2^300 = 0x52B0..., 2^600 = 0x6570...).
    var de = (m1 >> 52) - (m2 >> 52);
    if (de > 300 || de < 0 - 300) { return 0; }
    var sm = f64_mul(ms, sc);
    if (sm >= 0x52B0_0000_0000_0000) { return 0; }
    if ((v0 & 0x7FFF_FFFF_FFFF_FFFF) >= 0x6570_0000_0000_0000) { return 0; }
    if ((w0 & 0x7FFF_FFFF_FFFF_FFFF) >= 0x6570_0000_0000_0000) { return 0; }
    var am = f64_mul(m, sc);   # the edges' largest |component|, in [1, 4)
    # v' and w' (26 bits); each scaled edge component's 26-bit head h and the rest of the exact
    # edge, l = (component - h) + its two_sum error times sc (lf1x for e1's x, and so on).
    var vt = (v0 + 0x0400_0000) & 0xFFFF_FFFF_F800_0000;
    var wt = (w0 + 0x0400_0000) & 0xFFFF_FFFF_F800_0000;
    var hb = f64_sub(u1x, q1x);
    var h1x = (ax + 0x0400_0000) & 0xFFFF_FFFF_F800_0000;
    var lf1x = f64_add(f64_sub(ax, h1x), f64_mul(f64_sub(f64_sub(q1x, f64_sub(u1x, hb)), f64_add(p0x, hb)), sc));
    hb = f64_sub(u1y, q1y);
    var h1y = (ay + 0x0400_0000) & 0xFFFF_FFFF_F800_0000;
    var lf1y = f64_add(f64_sub(ay, h1y), f64_mul(f64_sub(f64_sub(q1y, f64_sub(u1y, hb)), f64_add(p0y, hb)), sc));
    hb = f64_sub(u1z, q1z);
    var h1z = (az + 0x0400_0000) & 0xFFFF_FFFF_F800_0000;
    var lf1z = f64_add(f64_sub(az, h1z), f64_mul(f64_sub(f64_sub(q1z, f64_sub(u1z, hb)), f64_add(p0z, hb)), sc));
    hb = f64_sub(u2x, q2x);
    var h2x = (bx + 0x0400_0000) & 0xFFFF_FFFF_F800_0000;
    var lf2x = f64_add(f64_sub(bx, h2x), f64_mul(f64_sub(f64_sub(q2x, f64_sub(u2x, hb)), f64_add(p0x, hb)), sc));
    hb = f64_sub(u2y, q2y);
    var h2y = (by + 0x0400_0000) & 0xFFFF_FFFF_F800_0000;
    var lf2y = f64_add(f64_sub(by, h2y), f64_mul(f64_sub(f64_sub(q2y, f64_sub(u2y, hb)), f64_add(p0y, hb)), sc));
    hb = f64_sub(u2z, q2z);
    var h2z = (bz + 0x0400_0000) & 0xFFFF_FFFF_F800_0000;
    var lf2z = f64_add(f64_sub(bz, h2z), f64_mul(f64_sub(f64_sub(q2z, f64_sub(u2z, hb)), f64_add(p0z, hb)), sc));
    # R = v' e1 + w' e2 - s, a component at a time: y = v' h1 + w' h2 (exact products) with its
    # two_sum error ey, z = RN(y - s~), lo = ey + v' lf1 + w' lf2 - g (g the offset's error).
    var pa = f64_mul(vt, h1x);
    var pb = f64_mul(wt, h2x);
    var yx = f64_add(pa, pb);
    hb = f64_sub(yx, pa);
    var zx = f64_sub(yx, sx);
    hb = f64_add(f64_sub(pa, f64_sub(yx, hb)), f64_sub(pb, hb));
    var gb = f64_sub(usx, qpx);
    var lox = f64_add(f64_add(hb, f64_mul(vt, lf1x)), f64_sub(f64_mul(wt, lf2x),
        f64_mul(f64_sub(f64_sub(qpx, f64_sub(usx, gb)), f64_add(p0x, gb)), sc)));
    pa = f64_mul(vt, h1y);
    pb = f64_mul(wt, h2y);
    var yy = f64_add(pa, pb);
    hb = f64_sub(yy, pa);
    var zy = f64_sub(yy, sy);
    hb = f64_add(f64_sub(pa, f64_sub(yy, hb)), f64_sub(pb, hb));
    gb = f64_sub(usy, qpy);
    var loy = f64_add(f64_add(hb, f64_mul(vt, lf1y)), f64_sub(f64_mul(wt, lf2y),
        f64_mul(f64_sub(f64_sub(qpy, f64_sub(usy, gb)), f64_add(p0y, gb)), sc)));
    pa = f64_mul(vt, h1z);
    pb = f64_mul(wt, h2z);
    var yz = f64_add(pa, pb);
    hb = f64_sub(yz, pa);
    var zz = f64_sub(yz, sz);
    hb = f64_add(f64_sub(pa, f64_sub(yz, hb)), f64_sub(pb, hb));
    gb = f64_sub(usz, qpz);
    var loz = f64_add(f64_add(hb, f64_mul(vt, lf1z)), f64_sub(f64_mul(wt, lf2z),
        f64_mul(f64_sub(f64_sub(qpz, f64_sub(usz, gb)), f64_add(p0z, gb)), sc)));
    # The near-plane stage's bound, one factor for both rows: K = (max(d00, d11) + |d01|) |inv| (each
    # row of |G~^-1| summed), P = K max|e|, C = 5.25 u (d00 + d11) K.
    var ai = f64_abs(inv);
    var ad = f64_abs(d01);
    var mx = d00;
    if (d11 > mx) { mx = d11; }
    var kk = f64_mul(f64_add(mx, ad), ai);
    var cc = f64_mul(f64_mul(f64_add(d00, d11), kk), 0x3CC5_0000_0000_0000);   # 5.25 * 2^-53
    var lt = f64_add(f64_mul(f64_add(f64_abs(vt), f64_abs(wt)), am), sm);
    var rzs = f64_add(f64_add(f64_abs(zx), f64_abs(zy)), f64_abs(zz));
    var dv = 0;
    var dw = 0;
    var v = 0;
    var ww = 0;
    var uu = 0;
    var mm = 0;
    var ee = 0;
    if (cc < 0x3EB0_0000_0000_0000 && f64_lt(rzs, f64_mul(lt, 0x3F70_0000_0000_0000)) == 1) {   # 2^-20; |R| < 2^-8 lt
        var rx = f64_add(zx, lox);
        var ry = f64_add(zy, loy);
        var rz = f64_add(zz, loz);
        dv = f64_add(f64_add(f64_mul(rx, ax), f64_mul(ry, ay)), f64_mul(rz, az));
        dw = f64_add(f64_add(f64_mul(rx, bx), f64_mul(ry, by)), f64_mul(rz, bz));
        var nv = f64_mul(f64_sub(f64_mul(d11, dv), f64_mul(d01, dw)), inv);
        dw = f64_mul(f64_sub(f64_mul(d00, dw), f64_mul(d01, dv)), inv);
        dv = nv;
        # rs = |z|_1 + 2^-23 lt + 2^-1000
        var rs = f64_add(f64_add(rzs, f64_mul(lt, 0x3E80_0000_0000_0000)), 0x0170_0000_0000_0000);
        ee = f64_add(f64_mul(f64_mul(f64_mul(rs, kk), am), 0x3CD3_0000_0000_0000),
          f64_mul(f64_add(cc, 0x3DE0_0000_0000_0000), f64_add(f64_abs(dv), f64_abs(dw))));   # 9.5 * 2^-53; + 2^-33
        ee = f64_mul(ee, 0x3FF0_0004_0000_0000);   # (1 + 2^-18)
        v = f64_sub(vt, dv);
        ww = f64_sub(wt, dw);
        uu = f64_sub(F64_ONE, f64_add(v, ww));
        mm = uu & 0x7FFF_FFFF_FFFF_FFFF;
        if ((v & 0x7FFF_FFFF_FFFF_FFFF) > mm) { mm = v & 0x7FFF_FFFF_FFFF_FFFF; }
        if ((ww & 0x7FFF_FFFF_FFFF_FFFF) > mm) { mm = ww & 0x7FFF_FFFF_FFFF_FFFF; }
        if (f64_le(ee, f64_mul(mm, 0x3CAF_FFFE_0000_0000)) == 1) {   # 2^-52 (1 - 2^-20)
            store64(w, uu);
            store64(w + 8, v);
            store64(w + 16, ww);
            return 1;
        }
    }
    # The second stage (see above): R as two words, z exact (two_sum: ez) and lo + ez; z's 26-bit
    # head t times the edges' heads exactly, summed with one two_sum; the rest, below 2^-25 of it,
    # t lf + ((z - t) + lo + ez) e, in plain sums.
    hb = f64_sub(zx, yx);
    var nx = f64_add(lox, f64_sub(f64_sub(yx, f64_sub(zx, hb)), f64_add(sx, hb)));
    var tx = (zx + 0x0400_0000) & 0xFFFF_FFFF_F800_0000;
    nx = f64_add(f64_sub(zx, tx), nx);
    hb = f64_sub(zy, yy);
    var ny = f64_add(loy, f64_sub(f64_sub(yy, f64_sub(zy, hb)), f64_add(sy, hb)));
    var ty = (zy + 0x0400_0000) & 0xFFFF_FFFF_F800_0000;
    ny = f64_add(f64_sub(zy, ty), ny);
    hb = f64_sub(zz, yz);
    var nz = f64_add(loz, f64_sub(f64_sub(yz, f64_sub(zz, hb)), f64_add(sz, hb)));
    var tz = (zz + 0x0400_0000) & 0xFFFF_FFFF_F800_0000;
    nz = f64_add(f64_sub(zz, tz), nz);
    pa = f64_mul(tx, h1x);
    pb = f64_mul(ty, h1y);
    var s1 = f64_add(pa, pb);
    hb = f64_sub(s1, pa);
    var b1 = f64_add(f64_add(s1, f64_mul(tz, h1z)), f64_add(f64_add(f64_sub(pa, f64_sub(s1, hb)), f64_sub(pb, hb)),
        f64_add(f64_add(f64_add(f64_mul(tx, lf1x), f64_mul(nx, ax)), f64_add(f64_mul(ty, lf1y), f64_mul(ny, ay))),
          f64_add(f64_mul(tz, lf1z), f64_mul(nz, az)))));
    pa = f64_mul(tx, h2x);
    pb = f64_mul(ty, h2y);
    s1 = f64_add(pa, pb);
    hb = f64_sub(s1, pa);
    var b2 = f64_add(f64_add(s1, f64_mul(tz, h2z)), f64_add(f64_add(f64_sub(pa, f64_sub(s1, hb)), f64_sub(pb, hb)),
        f64_add(f64_add(f64_add(f64_mul(tx, lf2x), f64_mul(nx, bx)), f64_add(f64_mul(ty, lf2y), f64_mul(ny, by))),
          f64_add(f64_mul(tz, lf2z), f64_mul(nz, bz)))));
    dv = f64_mul(f64_sub(f64_mul(d11, b1), f64_mul(d01, b2)), inv);
    dw = f64_mul(f64_sub(f64_mul(d00, b2), f64_mul(d01, b1)), inv);
    v = f64_sub(vt, dv);
    ww = f64_sub(wt, dw);
    uu = f64_sub(F64_ONE, f64_add(v, ww));
    mm = uu & 0x7FFF_FFFF_FFFF_FFFF;
    if ((v & 0x7FFF_FFFF_FFFF_FFFF) > mm) { mm = v & 0x7FFF_FFFF_FFFF_FFFF; }
    if ((ww & 0x7FFF_FFFF_FFFF_FFFF) > mm) { mm = ww & 0x7FFF_FFFF_FFFF_FFFF; }
    var th = f64_mul(mm, 0x3CAF_FFFE_0000_0000);   # 2^-52 (1 - 2^-20)
    var qb1 = f64_abs(b1);
    var qb2 = f64_abs(b2);
    var adv = f64_abs(dv);
    var adw = f64_abs(dw);
    var rl = f64_add(f64_add(f64_abs(lox), f64_abs(loy)), f64_abs(loz));
    # 2^-71 |z|_1 + 2^-49 |lo|_1 + 2^-74 lt + 2^-1000 (lt with the shared A first)
    var rr = f64_add(f64_mul(rzs, 0x3B80_0000_0000_0000), f64_mul(rl, 0x3CE0_0000_0000_0000));
    rr = f64_add(rr, 0x0170_0000_0000_0000);
    if (cc < 0x3EB0_0000_0000_0000) {   # 2^-20: the shared bound first (K, P = K A, C)
        var qm = qb1;
        if (qb2 > qm) { qm = qb2; }
        ee = f64_add(f64_add(f64_mul(f64_mul(kk, qm), 0x3CC1_0000_0000_0000),
            f64_mul(f64_add(rr, f64_mul(lt, 0x3B50_0000_0000_0000)), f64_mul(kk, am))),
          f64_mul(f64_add(cc, 0x3DE0_0000_0000_0000), f64_add(adv, adw)));   # 4.25 * 2^-53; 2^-74; + 2^-33
        if (f64_le(f64_mul(ee, 0x3FF0_0004_0000_0000), th) == 1) {   # (1 + 2^-18)
            store64(w, uu);
            store64(w + 8, v);
            store64(w + 16, ww);
            return 1;
        }
    }
    # Row by row: Pv = (d11 A1 + |d01| A2) |inv|, and with g = sqrt(d00 d11) (>= the sum of
    # |e1_c e2_c|), c11 = 10.125 u g^2 |inv|, cv2 = 10.125 u g d11 |inv|, cw1 = 10.125 u g d00 |inv|.
    var a1 = f64_mul(m1, sc);
    var a2 = f64_mul(m2, sc);
    var pv = f64_mul(f64_add(f64_mul(d11, a1), f64_mul(ad, a2)), ai);
    var pw = f64_mul(f64_add(f64_mul(ad, a1), f64_mul(d00, a2)), ai);
    var sg = f64_sqrt(dd);
    var qg = f64_mul(f64_mul(sg, ai), 0x3CD4_4000_0000_0000);   # 10.125 * 2^-53
    var c11 = f64_mul(qg, sg);
    var cv2 = f64_mul(qg, d11);
    var cw1 = f64_mul(qg, d00);
    var cm = c11;
    if (cv2 > cm) { cm = cv2; }
    if (cw1 > cm) { cm = cw1; }
    if (cm >= 0x3EB0_0000_0000_0000) { return 0; }   # 2^-20 (non-negative doubles order as their bits)
    c11 = f64_add(c11, 0x3DE0_0000_0000_0000);   # + 2^-33
    rr = f64_add(rr, f64_mul(f64_add(f64_add(f64_mul(f64_abs(vt), a1), f64_mul(f64_abs(wt), a2)), sm),
        0x3B50_0000_0000_0000));   # + 2^-74 lt
    var fv = f64_add(f64_add(f64_mul(f64_mul(f64_add(f64_mul(d11, qb1), f64_mul(ad, qb2)), ai), 0x3CC1_0000_0000_0000),
        f64_mul(rr, pv)), f64_add(f64_mul(c11, adv), f64_mul(cv2, adw)));   # 4.25 * 2^-53
    var fw = f64_add(f64_add(f64_mul(f64_mul(f64_add(f64_mul(ad, qb1), f64_mul(d00, qb2)), ai), 0x3CC1_0000_0000_0000),
        f64_mul(rr, pw)), f64_add(f64_mul(cw1, adv), f64_mul(c11, adw)));
    var fs = f64_mul(f64_add(fv, fw), 0x3EC0_0000_0000_0000);   # 2^-19
    if (f64_le(f64_add(fv, fs), th) == 1 && f64_le(f64_add(fw, fs), th) == 1) {
        store64(w, uu);
        store64(w + 8, v);
        store64(w + 16, ww);
        return 1;
    }
    return 0;
}

# Barycentric coordinates of a point projected onto a triangle.
# Returns an HVec3 where x=u, y=v, z=w such that point ~ u*v0 + v*v1 + w*v2: the weights of the
# point's orthogonal projection onto the triangle's plane (u + v + w = 1 in exact arithmetic); for an
# exactly colinear triangle the [3.4.0] least-squares weights of minimum norm, (1/3, 1/3, 1/3) for
# coincident vertices (_geo_bary_thin states that contract). A NaN or infinite input gives 3.4.0's
# Gram-form weights (NaN for most); the designed 0 when the result's allocation is refused.
# ⭐ 3.4.1 — ACCURACY (GEO5): for a finite triangle that is not exactly colinear, v and w are within
# 3.01 2^-53 M and u within 9.01 2^-53 M of the exact weights, M the largest exact |weight|: by
# _geo_bary_cert's certificate where it answers (every ordinary triangle), else by _geo_bary_thin's
# exact cross products (v = RN(RN(Dv) / RN(N)), its degree-four sums each rounded once), which add up
# to 2^-104 |p - v0| / (|v1 - v0| sin a) for a point off the plane, a the angle at v0 (its cross
# products are carried as two words). Exactly colinear (the minimum-norm contract): measured within
# 3.7 2^-53 M. Through 3.4.0 a triangle above the 2^-16 switch got the Gram solve alone (the angle's
# conditioning squared, GF3-1): of ordinary triangles with full-mantissa coordinates, 98 of 3952 with
# the point in their plane, 60 of 4048 with it off and 63 of 4000 at random scales were beyond 64 ulps
# of the largest weight (up to 1.4e4), 1141 of 1200 of RT F4's triangles 2^-6 from colinear (up to
# 1.6e4), 4219 of 24000 in a sweep from 2^-1 to 2^-30 from colinear (up to 1.8e7), and 15330 of 16000
# elongated triangles (edge ratio 2^-2 to 2^-16, angle 2^-1 to 2^-8, up to 7.7e9). Now 0 in
# 119592 triangles over every family (largest errors 1.01 2^-53 M for v and w and 3.1 for u where the
# certificate answers, 4.5 on _geo_bary_thin's path), 0 answers moved from right to wrong against
# 3.4.0 or the first 3.4.1 tree, every thin and colinear triangle's bits and every non-finite input's
# bits unchanged.
# Cost: 64 ordinary triangles with the point in their plane 1.13 to 1.14 times 3.4.0, with it off the plane
# 1.45 times (the second stage's exact right side); a thin or colinear triangle, or one the bound
# declines pays _geo_bary_thin (2 to 5 us): 0 of the 12000 ordinary triangles and 132 of 29091 others
# above the switch (near it, or far off the plane), but 4675 of those 16000 elongated ones, where the
# bound's floor reaches a weight's last bit (see _geo_bary_cert).
# [measured: GEO5 3.4.1 g5sw.py, fams.py's eleven families, 4 seeds; tb_bary.bcyr, Fraction oracle, 2026-11-01]
public fn geo_barycentric_coords(tri, point) {
    var r = alloc(sizeof(HVec3));
    if (r == 0) { return 0; }
    if (_geo_bary_cert(GeoTriangle_v0(tri), GeoTriangle_v1(tri), GeoTriangle_v2(tri), point, r) != 0) { return r; }
    return _geo_bary_thin(GeoTriangle_v0(tri), GeoTriangle_v1(tri), GeoTriangle_v2(tri), point);
}
