# geo.cyr -- geometric primitives, intersection tests, and closest-point queries
# Usage: shipped inside dist/hisab.cyr; in-tree, include "src/geo.cyr" after what it requires
# Requires: src/error.cyr, src/quat.cyr, src/vec3.cyr (stdlib resolves via cyrius.cyml [deps])
#
# Convention: intersection functions return 0 on miss, positive f64 t on hit.
# Overlap tests return 1 (true) or 0 (false).
# Closest-point functions return an HVec3 pointer.

# ================================================================
# Local constants
# ================================================================

var _GEO_F64_NEG_INF = 0xFFF0_0000_0000_0000;  # -Infinity
var _GEO_F64_POS_INF = F64_POS_INF;   # alias of error.cyr
var _GEO_F64_FOUR    = 0x4010_0000_0000_0000;  # 4.0
# ⚠ 3.3.4 — `_GEO_F64_EPS_SQ` (1e-24, EPSILON_F64 squared) is GONE. 2.10.1 added
# it for the two squared-length guards in _geo_sphere_roots and
# geo_ray_capsule_branch, and 2.14.0 moved both onto `_GEO_F64_TINY` below; from
# then on nothing in src/ read it, and its comment here still said guards did.
# The degree audit (roadmap "Named hex thresholds") found no use to audit.
# The smallest MAGNITUDE whose reciprocal is still finite (DBL_MIN). Anything at
# or above this can be divided by; anything below it makes 1/x overflow. 2.10.2
# used it as the slab method's parallel test; geo_ray_aabb_face's is an exact zero
# since 3.3.5 and geo_ray_obb_face's since 3.3.6 (see each), which keep it only for an
# infinite origin (or e) against a subnormal direction component.
var _GEO_F64_TINY    = F64_TINY;   # alias of error.cyr's F64_TINY (DBL_MIN)
# 3.3.5: below this squared length a ray direction is pre-scaled in the sphere and
# capsule quadratics (see _geo_sphere_roots): 54 binades above the DBL_MIN at which
# d.d itself flushes, so a direction above 2^-484 meeting unit-scale geometry keeps
# every product normal and runs unscaled.
var _GEO_DIR_LO      = 0x0370_0000_0000_0000;  # 2^-968 = 4.008336720017946e-292
var _GEO_F64_THREE   = 0x4008_0000_0000_0000;  # 3.0
var _GEO_F64_THIRD   = 0x3FD5_5555_5555_5555;  # 1.0/3.0

# ================================================================
# Power-of-two pre-scaling (3.3.4)
# ================================================================
# A unit normal, a direction, barycentric weights and the region of a closest
# point do not change when every vector they are formed from is multiplied by
# the same s > 0, but the products that form them are degree two (a cross
# product, a dot product) or four (a Gram determinant) and flush or overflow
# long before the inputs do. So those routines first multiply by a power of
# two that brings the largest component near 1. A power of two changes only the
# exponent: every product, sum and quotient after it is exactly s, s^2 or s^4
# times the unscaled one, so wherever the unscaled arithmetic stayed in the
# normal range the answer is bit-identical, and elsewhere it is the answer the
# same shape gives at unit size. Roadmap [3.3.4] D037, D038, D087.

# The largest |component| of v, as the bit pattern of a non-negative f64. With
# the sign cleared, f64 order is integer order, and a NaN (0x7FF8...) sorts above
# +Inf above every finite value, so one integer max finds all three.
fn _geo_absmax_bits(v) {
    var m = HVec3_x(v) & 0x7FFF_FFFF_FFFF_FFFF;
    var y = HVec3_y(v) & 0x7FFF_FFFF_FFFF_FFFF;
    var z = HVec3_z(v) & 0x7FFF_FFFF_FFFF_FFFF;
    if (y > m) { m = y; }
    if (z > m) { m = z; }
    return m;
}

# 2^k for an integer k <= 1023, clamped below to the least normal exponent and built
# as `(1023 + k) << 52`: never `1 << k`, which x86 masks silently from k = 64. Both
# callers pass k in [-1023, 1023]; -1023 (a magnitude in the top binade) becomes
# 2^-1022, which takes it to [2, 4) instead of [1, 2).
fn _geo_pow2(k) {
    if (k < 0 - 1022) { k = 0 - 1022; }
    return (1023 + k) << 52;
}

# The power of two that takes a magnitude with biased exponent field `e` (the
# bits above 52 of a non-negative f64) into [1, 4): 2^(1023 - e). A subnormal
# (e = 0) gets 2^1023 and lands in [2^-51, 2); zero stays zero. For e = 2047, an
# Inf or a NaN, it is 1.0, so a non-finite input meets the unscaled arithmetic.
fn _geo_scale_for(e) {
    if (e == 2047) { return F64_ONE; }
    return _geo_pow2(1023 - e);
}

# v / |v| at any magnitude, or `fallback` for the zero vector. The scaled copy's
# largest component is in [1, 4), or in [2^-51, 2) when all three are subnormal, so
# its length is normal and well inside the range, its reciprocal finite and normal,
# and a subnormal or overflowing |v| never meets `1 / |v|`. A NaN or infinite
# component leaves v unscaled and takes the shipped arithmetic: NaN in, NaN out.
fn _geo_unit_or(v, fallback) {
    var w = hvec3_scale(v, _geo_scale_for(_geo_absmax_bits(v) >> 52));
    var len = hvec3_length(w);
    if (f64_eq(len, 0) == 1) { return fallback; }
    return hvec3_scale(w, f64_div(F64_ONE, len));
}

# 1 when the largest |component| of the four vectors is in the top binade, 2^1023 to
# DBL_MAX: every component is then finite (a NaN or an Inf has exponent field 2047)
# and the difference of two of them can reach 2^1023 or overflow. Halving all four is
# exact there but for a subnormal component's last bit, which is below 2^-2097 of the
# largest. Where two large coordinates cancel exactly, that bit can be the whole
# difference, and halving it to 0 hands the caller's degenerate fallback a shape that
# is not degenerate. So no caller halves because this is 1 alone: geo_segment_direction
# halves when end - start has overflowed, and the three triangle routines when a
# difference they form has reached 2^1023 (see geo_triangle_unit_normal). Through
# 3.3.5 those three halved whenever this was 1, and the triangle (2^1023, 0, 0),
# (2^1023, 2^-1074, 0), (2^1023, 0, 2^-1074) got the unit normal (0, 1, 0) and the
# centroid weights where its 2^1022 copy gets (1, 0, 0) and the exact weights. 0
# otherwise, and the caller is unchanged.
# [measured: G1 top-binade sibling probe, 3.3.4 tree and this one, not in-tree, 2026-10-11; cycc 6.6.14]
fn _geo_top_binade(a, b, c, d) {
    var m = _geo_absmax_bits(a);
    var t = _geo_absmax_bits(b);
    if (t > m) { m = t; }
    t = _geo_absmax_bits(c);
    if (t > m) { m = t; }
    t = _geo_absmax_bits(d);
    if (t > m) { m = t; }
    if ((m >> 52) == 2046) { return 1; }
    return 0;
}

# ================================================================
# Primitives
# ================================================================

# Ray: origin (HVec3), direction (HVec3) -- 16 bytes (two pointers)
#derive(accessors)
public struct GeoRay { origin; direction; }

public fn geo_ray_new(origin, direction) {
    var dir = hvec3_normalize(direction);
    var r = alloc(sizeof(GeoRay));
    GeoRay_set_origin(r, origin);
    GeoRay_set_direction(r, dir);
    return r;
}

# Point along the ray at parameter t
public fn geo_ray_at(ray, t) {
    return hvec3_add(GeoRay_origin(ray), hvec3_scale(GeoRay_direction(ray), t));
}

# Plane: normal (HVec3), distance (f64) -- 16 bytes
#derive(accessors)
public struct GeoPlane { normal; distance; }

public fn geo_plane_from_point_normal(point, normal) {
    var n = hvec3_normalize(normal);
    var d = hvec3_dot(n, point);
    var p = alloc(sizeof(GeoPlane));
    GeoPlane_set_normal(p, n);
    GeoPlane_set_distance(p, d);
    return p;
}

public fn geo_plane_signed_distance(plane, point) {
    return f64_sub(hvec3_dot(GeoPlane_normal(plane), point), GeoPlane_distance(plane));
}

# AABB: min (HVec3), max (HVec3) -- 16 bytes
#derive(accessors)
public struct GeoAabb { min; max; }

public fn geo_aabb_new(a, b) {
    var box = alloc(sizeof(GeoAabb));
    GeoAabb_set_min(box, hvec3_min(a, b));
    GeoAabb_set_max(box, hvec3_max(a, b));
    return box;
}

public fn geo_aabb_center(aabb) {
    return hvec3_scale(hvec3_add(GeoAabb_min(aabb), GeoAabb_max(aabb)), F64_HALF);
}

public fn geo_aabb_size(aabb) {
    return hvec3_sub(GeoAabb_max(aabb), GeoAabb_min(aabb));
}

# Sphere: center (HVec3), radius (f64) -- 16 bytes
#derive(accessors)
public struct GeoSphere { center; radius; }

public fn geo_sphere_new(center, radius) {
    var s = alloc(sizeof(GeoSphere));
    GeoSphere_set_center(s, center);
    GeoSphere_set_radius(s, radius);
    return s;
}

# OBB: center (HVec3), half_extents (HVec3), rotation (HQuat) -- 24 bytes
#derive(accessors)
public struct GeoObb { center; half_extents; rotation; }

public fn geo_obb_new(center, half_extents, rotation) {
    var o = alloc(sizeof(GeoObb));
    GeoObb_set_center(o, center);
    GeoObb_set_half_extents(o, half_extents);
    GeoObb_set_rotation(o, rotation);
    return o;
}

# Returns three axis vectors as an array of 3 HVec3 pointers (alloc 24 bytes)
public fn geo_obb_axes(obb) {
    var q = GeoObb_rotation(obb);
    var ax = hquat_rotate_vec3(q, hvec3_unit_x());
    var ay = hquat_rotate_vec3(q, hvec3_unit_y());
    var az = hquat_rotate_vec3(q, hvec3_unit_z());
    var arr = alloc(24);
    store64(arr, ax);
    store64(arr + 8, ay);
    store64(arr + 16, az);
    return arr;
}

# Capsule: start (HVec3), end (HVec3), radius (f64) -- 24 bytes
#derive(accessors)
public struct GeoCapsule { start; end; radius; }

public fn geo_capsule_new(start, end, radius) {
    var c = alloc(sizeof(GeoCapsule));
    GeoCapsule_set_start(c, start);
    GeoCapsule_set_end(c, end);
    GeoCapsule_set_radius(c, radius);
    return c;
}

# Triangle: v0, v1, v2 (three HVec3 pointers) -- 24 bytes
#derive(accessors)
public struct GeoTriangle { v0; v1; v2; }

public fn geo_triangle_new(a, b, c) {
    var t = alloc(sizeof(GeoTriangle));
    GeoTriangle_set_v0(t, a);
    GeoTriangle_set_v1(t, b);
    GeoTriangle_set_v2(t, c);
    return t;
}

public fn geo_triangle_normal(tri) {
    var edge1 = hvec3_sub(GeoTriangle_v1(tri), GeoTriangle_v0(tri));
    var edge2 = hvec3_sub(GeoTriangle_v2(tri), GeoTriangle_v0(tri));
    return hvec3_cross(edge1, edge2);
}

# 2.10.2: the degeneracy guard tests `len_sq`, the SQUARED length of the cross
# product -- which for legs of size s is s^4, so against the unsquared
# EPSILON_F64 it fired for every triangle smaller than 1e-3 and returned a
# FABRICATED unit_y with no error signal. Measured: a right triangle with 1e-4
# legs in the xy-plane returned (0,1,0) where the truth is (0,0,1).
# [measured: docs/development/issues/archived/2026-08-10-squared-epsilon-guards-in-geo-ray.md]
#
# ⚠ That paragraph is history: neither `_GEO_F64_TINY` nor `len_sq` survives in
# this function as of 2.17.0. See the block inside it for what replaced them and
# why the exact-zero test was not enough on its own.
# [measured: docs/development/issues/archived/2026-08-10-squared-epsilon-guards-in-geo-ray.md]
public fn geo_triangle_unit_normal(tri) {
    var v0 = GeoTriangle_v0(tri);
    var v1 = GeoTriangle_v1(tri);
    var v2 = GeoTriangle_v2(tri);
    var e1 = hvec3_sub(v1, v0);
    var e2 = hvec3_sub(v2, v0);
    # ⛔ 2.10.2 MOVED THIS THRESHOLD AND LEFT THE EXPONENT WRONG. `len_sq` is a
    # cross product SQUARED — degree FOUR in the caller's units — and DBL_MIN is
    # the threshold for a degree-ONE quantity, so the guard still fired 77 decades
    # early and still returned a FABRICATED (0,1,0) for a well-formed right
    # triangle. Measured on the 2.13.0 tree: correct through legs of 1e-76, then
    # unit_y from 1e-77 down, which is exactly where sc^4 crosses DBL_MIN.
    # 2.10.2 replaced that with `f64_gt(len_sq, 0) == 0`, reasoning that sqrt of
    # any non-zero double is normal so only an exact zero fails — sound as far as
    # it went, and it also closed a NaN hole (`f64_lt(NaN, x)` is 0, so a NaN
    # triangle used to return a NaN normal instead of the degenerate fallback).
    # [measured: tests/modules.tcyr _sc_sweep, first bad decade 77 of 90]
    #
    # ⛔ 2.17.0 — AND `len_sq` ITSELF WAS THE DEFECT, SO THE EXACT GUARD FIRED
    # ANYWAY. `hvec3_length_sq` squares before summing, so for legs below 2^-269
    # the squared cross product flushed to exactly zero, `f64_gt(0, 0) == 0` was
    # true, and the FABRICATED (0,1,0) came back for a perfectly well-formed
    # triangle — the very outcome 2.10.2 records as repaired, twice over now.
    # Measured on the 2.16.0 tree: **877 of 1401 leg scales wrong**, legs below
    # 2^-269 and at or above 2^256. ⭐ Half-depth bands because a cross product is
    # degree TWO — derived from the arithmetic, not chosen.
    # ⚠ THE `len_sq` TEST IS GONE, NOT SUPPLEMENTED. The first attempt kept it and
    # added the repaired path below, which fixed nothing at all on the low side:
    # the flushed `len_sq` still returned the fallback before the new code ran.
    # The order of the guard is the guard.
    # ⭐ `hvec3_length` (repaired earlier in this release) replaces the re-derived
    # sqrt, and what is guarded is what actually fails: a zero length and a length
    # too small to invert.
    # ⚠ WHAT THIS DOES NOT FIX, STATED SO IT IS NOT READ AS A FULL REPAIR: the
    # residual band is now `hvec3_cross` itself. Legs at 2^-512 give cross
    # components that are already subnormal or zero, and legs at 2^512 give +Inf,
    # before any norm runs. The repair moves the floor from 2^-269 to 2^-512 and
    # the ceiling from 2^256 to 2^512 — 243 and 256 binades — and what remains is
    # destroyed upstream of this function. Measured after: 378 of 1401.
    # [measured: 1401-binade two-sided sweep before and after, 2026-09-10]
    #
    # ⛔ 3.3.3 — THE NaN HALF OF 2.10.2'S CONTRACT WAS THE FABRICATED-ANSWER CLASS.
    # Through 3.3.2 the guard was `f64_gt(len, 0) == 0`, which is TRUE for a NaN
    # length, so a triangle with a NaN coordinate — or an infinite one whose cross
    # product picks up `Inf * 0` — returned (0, 1, 0): a valid-looking unit normal
    # with nothing to say it was invented. 2.10.2 recorded that fold as closing a
    # NaN hole; it opened one. The test is now an exact zero: a zero length still
    # returns the documented degenerate unit_y, and a NaN length falls through to
    # `n * (1 / NaN)`, NaN in all three components — what
    # `hvec3_normalize(geo_triangle_normal(tri))` returns on the same input.
    # [measured: G6 scratch probe on the 3.3.2 bundle, not reproducible in-tree, 2026-10-01; cycc 6.6.12]
    #
    # ⚠ THAT MOVES FINITE INPUT TOO, AND IT IS MEANT TO. A finite triangle whose
    # cross product overflows in both products of one component gets `Inf - Inf`
    # there, a NaN length, and the fold answered (0, 1, 0) for it as well:
    # (0,0,0), (1e300,1e300,0), (1e300,1e300,1), whose unit normal is
    # (0.7071, -0.7071, 0) — what the same triangle scaled to 1e150 returns —
    # gave unit_y through 3.3.2 and is NaN in all three now. Not every moved answer
    # was wrong: the fold's (0, 1, 0) was right by coincidence where the true normal
    # is +y. (0,0,0), (1e300,0,1e300), (2e300,0,1e300) has the cross product
    # (0, NaN, 0) and the normal +y (its 1e150 copy gives (0, 0x3FEFFFFFFFFFFFFF, 0)),
    # and its mirror, the last two vertices swapped and the normal -y, got the same
    # (0, 1, 0); both are NaN now, which loses the coincidence with the error.
    # [measured: R5geo unit-normal probe, 3.3.2 and repaired bundles, not in-tree, 2026-10-01; cycc 6.6.12]
    # Over 64 random finite triangles per binade, coordinates up to about 2^e for
    # e in [400, 1023], 32636 of 39936 moved from unit_y to NaN, every one at e in
    # [512, 1023]. The
    # 100 that were NaN already, 50 in all three components and 50 in part (each
    # infinite component times 1 / Inf = 0), and the 7200 finite answers did not
    # move. NaN is the loud answer until the edges are pre-scaled (roadmap [3.3.4]
    # D037). The 2.17.0 note above that legs at 2^512 "give +Inf" is the right
    # triangle's case, whose (0, 0, Inf) cross product has no `Inf - Inf`.
    # [measured: R4geo unit-normal binade sweep, 3.3.2 and repaired bundles, not in-tree, 2026-10-01; cycc 6.6.12]
    #
    # ⛔ 3.3.4 — THE EDGES ARE PRE-SCALED, SO `hvec3_cross` IS NO LONGER THE FLOOR
    # (roadmap D037). Both edges are multiplied by the power of two that brings the
    # larger's largest component into [1, 2) (see "Power-of-two pre-scaling" at the
    # top), the cross product is formed there, and `_geo_unit_or` normalises it the
    # same way, so a cross product that is subnormal relative to its own edges (a
    # thin triangle) is not a reciprocal overflow either. The answer is the one the
    # same triangle gives at unit size, bit for bit, except where top-binade vertices
    # cancel to a subnormal last bit (_geo_top_binade). The right triangle with legs
    # 2^e is right for every e in [-1074, 1023] (3.3.3: 378 wrong of the 1401 legs
    # 2^-700 to 2^700, unit_y at or below 2^-512 and NaN from 2^512; 1075 of 2098 on
    # the full range). 24 random triangles at every scale 2^e: 25731 wrong of 50304
    # before, none now. Vertices more than DBL_MAX apart make b - a itself Inf, so
    # when any coordinate is in the top binade every vertex is halved first
    # (_geo_top_binade); 20000 triangles with coordinates up to DBL_MAX: none right
    # before, 19878 now, and the 122 others within sin 0.13 of colinear. In
    # 27395 mixed configurations (translated, thin, near-colinear) no answer within
    # 4 * 2^-53 of the exact unit normal of the rounded edges left that band, and
    # 6432 entered it. 1024 of the 24-triangle answers and 331 mixed ones are further
    # from the exact value than 3.3.3's, at most 3.4 * 2^-53, where 3.3.3's length
    # took `_hvec3_len_scaled`; each is the unit-size answer.
    # [measured: georay triangle sweeps, exact oracle, 3.3.3 geo.cyr vs repaired, 2026-10-03; cycc 6.6.14]
    # The 3.3.3 binade sweep above, repeated (64 random triangles per binade, e in
    # [400, 1023]): 39861 of 39936 right, against 7184 (32736 NaN). The 75 others are
    # within sin 0.17 of colinear, wrong by the cross product's cancellation, and
    # bit-identical to 3.3.3's answer for the same triangle at unit size.
    # [measured: georay unit-normal binade sweep, exact oracle, 3.3.3 geo.cyr vs repaired, 2026-10-03; cycc 6.6.14]
    # ⛔ 3.3.6 — HALVED ONLY WHEN AN EDGE REACHES 2^1023, NOT WHEN A COORDINATE DOES.
    # 3.3.4 halved every vertex whenever a coordinate was in the top binade, which drops
    # a subnormal last bit, and where the big coordinates cancel that bit is the whole
    # edge: (2^1023, 0, 0), (2^1023, 2^-1074, 0), (2^1023, 0, 2^-1074) got unit_y, not
    # +x, where its 2^1022 copy was right. The edges are now formed first and halved
    # only when one reaches 2^1023 (or overflows) from finite vertices. 80024 triangles
    # (the repros, and 20000 each with top-binade coordinates shared so that they
    # cancel, with vertices more than DBL_MAX apart, with random top-binade vertices,
    # and with none in the top binade), against the exact unit normal of the exact
    # edges within 4 * 2^-53: 572 wrong -> right, none right -> wrong. Only the
    # cancelling family moved (575 right answers, within 1.00 * 2^-53 before and
    # after), and the 14816 of it that translate exactly to an ordinary position give
    # that position's answer bit for bit (3.3.5: 14024).
    # [measured: C336 row-6 sweep, exact Fraction oracle, 3.3.5 vs this tree, not in-tree, 2026-10-11; cycc 6.6.14]
    # ⚠ 2^1023, NOT OVERFLOW ALONE (geo_segment_direction's test). An edge in the top
    # binade scales by 2^-1022 into [2, 4), one binade above every smaller triangle's
    # [1, 2), so where a scaled component is subnormal it rounds differently; halving
    # there keeps the answer the unit-size one through the top binade. Halving on
    # overflow alone changed it for 2 of 42947 exactly scaled mixed-magnitude triangles
    # and moved 610 right answers with vertices more than DBL_MAX apart or random
    # top-binade vertices; this moves none of those from 3.3.5's bits.
    # [measured: C336 row-6 covariance and variant sweeps, 3.3.5 vs this tree, not in-tree, 2026-10-11; cycc 6.6.14]
    var m = _geo_absmax_bits(e1);
    var m2 = _geo_absmax_bits(e2);
    if (m2 > m) { m = m2; }
    if ((m >> 52) >= 2046) {
        if (_geo_top_binade(v0, v1, v2, v0) == 1) {
            e1 = hvec3_sub(hvec3_scale(v1, F64_HALF), hvec3_scale(v0, F64_HALF));
            e2 = hvec3_sub(hvec3_scale(v2, F64_HALF), hvec3_scale(v0, F64_HALF));
            m = _geo_absmax_bits(e1);
            m2 = _geo_absmax_bits(e2);
            if (m2 > m) { m = m2; }
        }
    }
    var s = _geo_scale_for(m >> 52);
    return _geo_unit_or(hvec3_cross(hvec3_scale(e1, s), hvec3_scale(e2, s)), hvec3_unit_y());
}

public fn geo_triangle_area(tri) {
    return f64_mul(hvec3_length(geo_triangle_normal(tri)), F64_HALF);
}

public fn geo_triangle_centroid(tri) {
    var sum = hvec3_add(hvec3_add(GeoTriangle_v0(tri), GeoTriangle_v1(tri)), GeoTriangle_v2(tri));
    return hvec3_scale(sum, _GEO_F64_THIRD);
}

# Line: origin (HVec3), direction (HVec3) -- 16 bytes
#derive(accessors)
public struct GeoLine { origin; direction; }

public fn geo_line_new(origin, direction) {
    var dir = hvec3_normalize(direction);
    var l = alloc(sizeof(GeoLine));
    GeoLine_set_origin(l, origin);
    GeoLine_set_direction(l, dir);
    return l;
}

public fn geo_line_closest_point(line, point) {
    var v = hvec3_sub(point, GeoLine_origin(line));
    var t = hvec3_dot(v, GeoLine_direction(line));
    return hvec3_add(GeoLine_origin(line), hvec3_scale(GeoLine_direction(line), t));
}

# Segment: start (HVec3), end (HVec3) -- 16 bytes
#derive(accessors)
public struct GeoSegment { start; end; }

public fn geo_segment_new(start, end) {
    var s = alloc(sizeof(GeoSegment));
    GeoSegment_set_start(s, start);
    GeoSegment_set_end(s, end);
    return s;
}

public fn geo_segment_length(seg) {
    return hvec3_length(hvec3_sub(GeoSegment_end(seg), GeoSegment_start(seg)));
}

public fn geo_segment_midpoint(seg) {
    return hvec3_scale(hvec3_add(GeoSegment_start(seg), GeoSegment_end(seg)), F64_HALF);
}

# 2.10.2: squared length against an unsquared tolerance -- see
# geo_triangle_unit_normal. A segment shorter than 1e-6 got a fabricated unit_x.
public fn geo_segment_direction(seg) {
    var p0 = GeoSegment_start(seg);
    var p1 = GeoSegment_end(seg);
    var d = hvec3_sub(p1, p0);
    if ((_geo_absmax_bits(d) >> 52) == 2047) {
        if (_geo_top_binade(p0, p1, p0, p1) == 1) {
            d = hvec3_sub(hvec3_scale(p1, F64_HALF), hvec3_scale(p0, F64_HALF));
        }
    }
    # ⛔ Same shape as geo_triangle_unit_normal above: a SQUARED length against a
    # threshold meant for an unsquared one, so a valid short segment still got a
    # fabricated unit_x. `1 / sqrt(len_sq)` fails only at an exact zero.
    # ⛔ 2.17.0 — same residue as `geo_triangle_unit_normal`: `len_sq` squares
    # before summing, so a segment whose components sit below 2^-538 flushes to a
    # zero length and gets the FABRICATED unit_x, and one above 2^509 gets a
    # length of +Inf and a direction of (0,0,0). Measured: **994 of 2041 scales
    # wrong**, and at 2^-600 a (3k, 4k, 0) segment returns (1, 0, 0) where the
    # direction is (0.6, 0.8, 0).
    # ⚠ AN AXIS-ALIGNED FIXTURE CANNOT SEE THIS. The first probe used a segment
    # along +x, and the fabricated unit_x fallback IS the right answer there, so
    # it reported the low band clean. The diagonal is what discriminates.
    # [measured: 2041-binade two-sided sweep on a (3k,4k,0) segment, 2026-09-10]
    # ⛔ 3.3.3 — and a NaN length took the zero-length fallback too: `f64_gt(NaN, 0)`
    # is 0, so a segment with a NaN at either end returned the fabricated (1, 0, 0).
    # The test is now an exact zero, and a NaN direction is NaN in every component,
    # as `hvec3_normalize(end - start)` is. See geo_triangle_unit_normal.
    # [measured: G6 scratch probe on the 3.3.2 bundle, not reproducible in-tree, 2026-10-01; cycc 6.6.12]
    # ⛔ 3.3.4 — `1 / len` OVERFLOWS FOR A SUBNORMAL LENGTH, SO THE SECOND unit_x
    # FALLBACK WAS STILL A FABRICATION (roadmap D087). Below about 2^-1024 the
    # reciprocal is +Inf and every such segment got unit_x. `_geo_unit_or` scales d
    # by a power of two first, exactly, so the length it divides by is normal and the
    # fallback is left for the zero segment. On the integer grid
    # (i, j, l) * 2^-1074, |i|, |j| <= 6, l in {0, 1, 3}, 500 of 506 directions were
    # wrong and none is now; over 83513 segments in all (30 directions at every
    # 2^e, and 20000 mixed ends) 2361 moved into 4 * 2^-53 of the exact direction
    # and none left it.
    # ⚠ NOT DIRECT DIVISION BY `len`. A subnormal `len` is itself rounded to the
    # subnormal grid: (-6, -6, 0) * 2^-1074 has a length of 8 * 2^-1074 there, and
    # d / len gives (-0.75, -0.75, 0), a vector of length 1.06. That route was wrong
    # for 452 of the 506 grid directions and 2134 of the 83513.
    # [measured: georay segment sweep, exact oracle, 3.3.3 geo.cyr vs repaired, 2026-10-03; cycc 6.6.14]
    # Ends more than DBL_MAX apart overflow end - start itself, so with a coordinate
    # in the top binade both ends are halved first (_geo_top_binade). 20000 segments
    # with coordinates up to DBL_MAX: 14443 right before, all 20000 now.
    # [measured: georay top-binade segment sweep, exact oracle, 3.3.3 geo.cyr vs repaired, 2026-10-03; cycc 6.6.14]
    # ⛔ 3.3.5 — HALVED ONLY WHEN THE DIFFERENCE OVERFLOWED. 3.3.4 halved whenever a
    # coordinate was in the top binade, which drops a subnormal last bit, and where
    # the big coordinates cancel that bit is the whole difference:
    # (2^1023, 2^-1074, 0) -> (2^1023, 0, 0) got the unit_x fallback, not (0, -1, 0).
    # An infinite component of d from finite ends can only be an overflow, so that is
    # the test. 80001 segments (the repro, and 20000 each: top-binade coordinates
    # shared by both ends, overflowing differences, random top-binade ends, none in
    # the top binade), against the exact direction within 4 * 2^-53: 120 wrong ->
    # right, none right -> wrong, and the 20000 without a top-binade coordinate keep
    # their bits. 748 right answers moved, 249 closer and 102 further (at most
    # 1.61 * 2^-53 off, from `_geo_unit_or`'s reciprocal of the exact difference's
    # length where 3.3.4 took the halved difference's).
    # [measured: G1 segment sweep, exact Fraction/Decimal oracle, 3.3.4 tree vs this one, 2026-10-11; cycc 6.6.14]
    return _geo_unit_or(d, hvec3_unit_x());
}

# 2.10.2, and this one is LOAD-BEARING beyond itself: geo_segment_distance_to_point
# builds on it and is what a caller reaches for as an ORACLE when checking a
# capsule surface. Against the unsquared EPSILON_F64 it collapsed any segment
# shorter than 1e-6 to its start point, so the distance from that segment's own
# MIDPOINT came back as half its length instead of 0. The commissioned probe that
# found the capsule defects was silently misled by exactly that.
public fn geo_segment_closest_point(seg, point) {
    var ab = hvec3_sub(GeoSegment_end(seg), GeoSegment_start(seg));
    var len_sq = hvec3_dot(ab, ab);
    # ⛔ Same class. Here the division IS by `len_sq`, but `t` is clamped to [0,1]
    # immediately after, so a subnormal denominator cannot produce a bad answer —
    # only an exact zero can. Collapsing a valid short segment to its start point
    # is what 2.10.2 recorded as misleading its own capsule probe.
    # ⛔ 3.3.3 — the test was `f64_gt(len_sq, 0) == 0`, TRUE for NaN, so a segment
    # whose END was NaN collapsed to its finite start: the closest point to (1,1,1)
    # on (0,0,0)-(NaN,0,0) came back (0,0,0) and the distance sqrt(3), both
    # plausible. Only an exact zero is a point segment; a NaN `len_sq` now reaches
    # the division, `f64_clamp` passes the NaN `t` through, and every component of
    # the point, and so `geo_segment_distance_to_point`, is NaN. (A NaN START was
    # NaN only in its own NaN coordinate: the fallback returned the start itself.)
    # [measured: G6 scratch probe on the 3.3.2 bundle, not reproducible in-tree, 2026-10-01; cycc 6.6.12]
    if (f64_eq(len_sq, 0) == 1) { return GeoSegment_start(seg); }
    var t = f64_clamp(f64_div(hvec3_dot(hvec3_sub(point, GeoSegment_start(seg)), ab), len_sq), 0, F64_ONE);
    return hvec3_add(GeoSegment_start(seg), hvec3_scale(ab, t));
}

public fn geo_segment_distance_to_point(seg, point) {
    return hvec3_length(hvec3_sub(point, geo_segment_closest_point(seg, point)));
}

# ================================================================
# Ray intersection tests
# ================================================================
# All return 0 on miss, positive f64 t parameter on hit.
#
# A CONTACT AT t = 0 IS THE MISS (3.3.6, the one rule for every primal and jet). A ray
# whose origin lies on the surface has t = 0, which is the miss sentinel; the plane,
# triangle, sphere and slab routines return +0.0 or -0.0 there, the sign being whatever
# their arithmetic gives (a plane met from the back, a triangle along +z from its own
# face, a slab's 0 / d_k with d_k < 0), so the sign is not a discriminator: test the
# answer with f64_eq(t, 0), which is 1 for both. Every jet in geo_diff.cyr does, and
# answers its miss for either zero. Through 3.3.5 the jets tested the integer t == 0,
# so a -0.0 contact got a hit jet with gradients and a +0.0 one the miss. The face
# routines still report the contact's face in `out` beside the zero t.
#
# ----------------------------------------------------------------
# FACE-REPORTING VARIANTS (2.10.1)
# ----------------------------------------------------------------
#
# `geo_ray_aabb` and `geo_ray_obb` pick their answer through f64_max / f64_min
# across three slabs and then DISCARD which slab won. A differentiable caller
# needs that back -- the derivative of t is per-face, and `src/geo_diff.cyr`
# cannot form it from t alone -- and so does an ordinary caller that wants the
# surface normal at the hit without recomputing it.
#
# So each has a `_face` variant taking an out-pointer, with the plain entry point
# becoming a one-line wrapper that passes 0. THE VALUE PATH IS UNCHANGED BY
# CONSTRUCTION: the f64_max / f64_min calls are byte-for-byte what they were, the
# face bookkeeping is additive, and every added line sits behind `if (out != 0)`,
# so a non-differentiating caller pays one i64 compare per slab and nothing else.
# The existing assertions gate that equivalence.
#
# FACE ENCODING: 2 * axis + plane, where axis is 0/1/2 for x/y/z (for the OBB,
# its own local axis 0/1/2) and plane is 0 for the min side, 1 for the max side.
# GEO_FACE_NONE (-1) means no face was selected.
# ⛔ 3.3.4 — A NaN NO LONGER COMES BACK AS A NUMBER (roadmap D034). Through 3.3.3
# f64_max / f64_min erased a NaN slab whenever a later slab won, and a parallel
# slab's two tests, both false against a NaN, skipped it: a NaN input came back as
# a finite t (with a real face or GEO_FACE_NONE), as the miss 0, or as a NaN t
# that kept an earlier slab's real face. CHANGELOG 3.3.3 lists each pairing. Now a
# NaN anywhere in the ray, the box or the OBB (rotation included) returns a NaN t
# with GEO_FACE_NONE and no tie, as geo_ray_sphere, _plane and _capsule do:
#   * a slab whose arithmetic forms a NaN returns the first NaN among the inputs
#     (_geo_ray_aabb_nan_or_miss, _geo_ray_obb_nan). `t_min < t_max` replaces the
#     `t_min > t_max` miss test: one compare on the hit path, as before, and only
#     when it fails are the miss, the tie and the NaN told apart;
#   * a parallel slab tests its own inputs for NaN, after its two miss tests;
#   * a miss found before the last slab has read every input returns the first
#     NaN among them instead, if there is one (_geo_ray_aabb_nan_or_miss; for the
#     OBB only the half-extents, because local axis 0 reads every other input);
#   * so for NaN input a real face comes back only with a finite t, and the
#     pairings are GEO_FACE_NONE with the miss 0, GEO_FACE_NONE with a NaN t, and a
#     face with a finite t. The jets in src/geo_diff.cyr answer their miss for the
#     first two. A NaN made from input with none is another matter (below).
# Over 2500 random rays and boxes per routine, aimed and not, a third along an
# axis, with a NaN put in each input slot in turn: geo_ray_aabb_face returned a
# finite t > 0 for 11621 of 30000 (9477 with a real face), the miss 0 for 13123
# and a NaN t with a real face for 4163; geo_ray_obb_face (16 slots) a finite
# t > 0 for 3473 of 40000 and the miss for 2475. All 70000 are NaN with
# GEO_FACE_NONE, no tie and the miss jet now. The 2500 clean inputs per routine,
# and 14400 AABB inputs with one infinite slot, are bit-identical in t, face, tie
# and jet; for the half-extent signs see geo_ray_obb_face.
# [measured: georay slab sweep, 3.3.3 geo.cyr vs repaired, 3.3.4 tree, not in-tree, 2026-10-03; cycc 6.6.14]
# ⚠ ONLY A NaN THE CALLER SUPPLIED IS RETURNED. The arithmetic also makes NaN from
# input with none: Inf - Inf where an infinite origin meets an infinite bound of the
# same sign, and in the OBB's frame 0 * Inf where an axis's exact zero component
# meets an infinite component of the ray or of c - o, which overflows for finite
# ends more than DBL_MAX apart. Such a slab finds no NaN among the inputs and goes
# on as in 3.3.3, so that NaN can still leave as t with an earlier slab's real face
# (tests/modules.tcyr pins one per routine), and the jets' own t test answers their
# miss for it. Returning it instead, as the first draft of D034 did, turned 1377 of
# 6000 finite OBB inputs with an overflowing c - o (all but 4 geometric misses) and
# 473 of 4000 AABB inputs with two infinite slots into NaN.
# [measured: D034 review sweep, 3.3.3 geo.cyr vs 3.3.4 drafts, not in-tree, 2026-10-03; cycc 6.6.14]
# Inputs with no NaN keep 3.3.3's bits but for the OBB's half-extent signs
# (geo_ray_obb_face) and an inverted AABB (AN INVERTED BOX, below): over 14235 AABB
# and 20200 OBB inputs (finite, near DBL_MAX, one or two infinite slots, +-0,
# subnormal), t, face, tie, jet and the plain entry match 3.3.3 in all but 10 OBB
# inputs, each with a negative half-extent. 28000 NaN inputs (four payloads, one per
# slot) are each a NaN t, GEO_FACE_NONE, no tie, the miss jet and a NaN plain t.
# [measured: slab differential, 3.3.4-base bundle vs this tree, not in-tree, 2026-10-03; cycc 6.6.14]
# The siblings differ already: from (0, Inf, 1.5) and from (-Inf, 0.5, 0.5) along +x,
# geo_ray_sphere and _capsule answer NaN, geo_ray_plane NaN and +Inf, geo_ray_aabb
# and _triangle the miss. The family's non-finite contract is the open roadmap row
# "Collision siblings disagree on partly-NaN and infinite shapes", not decided here.
# [measured: georay infinite-origin probe, 3.3.4 tree before this change, not in-tree, 2026-10-03; cycc 6.6.14]
#
# OUT BLOCK: 16 bytes, two i64 slots.
#   out[0] = the face index above
#   out[1] = 1 when the selected extremum was achieved by MORE THAN ONE slab,
#            i.e. the ray hit an edge or a corner exactly. `t` has a genuine kink
#            there -- the selected face, and therefore the derivative, differs on
#            either side -- so a differentiating caller must not read a gradient.
#            Reported rather than resolved: picking a side would be a silent
#            wrong answer, and the grazing-incidence convention in geo_diff.cyr
#            is already to return the miss sentinel at a non-differentiable point.
public var GEO_FACE_NONE      = -1;
public var GEO_FACE_OUT_BYTES = 16;

# THE CAPSULE reports a BRANCH, not a face: its surface is three pieces, and the
# derivative differs per piece even though the surface itself is C1 where they
# meet. out[1] is unused (always 0) -- a capsule has no edge, so there is no tie
# to report. The cap/cylinder seam IS differentiable: hemisphere and cylinder are
# tangent there, and the two branches' gradients agree in the limit, which the
# suite asserts rather than assumes.
public var GEO_CAP_CYLINDER  = 0;
public var GEO_CAP_START_CAP = 1;
public var GEO_CAP_END_CAP   = 2;
public var GEO_CAP_SPHERE    = 3;    # degenerate capsule: start == end, a plain sphere

# 1 when x is +/-Infinity, 0 otherwise -- INCLUDING for NaN, which is the whole
# point of writing it this way. 2.10.2: the slab routines return `0 on miss,
# positive f64 t on hit` and +Inf is neither; an adversarial fuzz found 230 of
# 20,000 configurations returning a non-finite t from entirely FINITE inputs,
# where the true value simply overflowed the exponent range.
# [measured: docs/development/issues/archived/2026-08-10-slab-parallel-test-is-scale-free.md]
#
# ⚠ NaN IS DELIBERATELY LEFT ALONE, and the first draft of this got it wrong.
# A `f64_lt(f64_abs(x), POS_INF)` finiteness test rejects NaN too -- and that
# broke tests/abuse.tcyr's "geo_ray_aabb: a NaN ray yields NaN, not a fabricated
# hit distance", which 2.9.0 asserted with a written reason: the miss sentinel is
# 0, so turning a NaN ray into 0 reports "no hit" for an input the caller has no
# business supplying, while a NaN return is unmistakable at the call site. That
# is a considered contract decision and this repair has no business overturning
# it in passing. The remaining NaN question -- a NaN in ONE axis being erased by
# f64_max and laundered into a plausible finite t -- is real, is module-wide
# (geo_ray_sphere, _plane and _triangle behave the same), and is filed rather
# than decided here.
# ⚠ 3.3.3 — "MODULE-WIDE" WAS WRONG. With one NaN coordinate in each input of
# each ray routine, over 2000 random rays aimed at the shape, geo_ray_sphere and
# geo_ray_plane answer NaN for every input coordinate, on 3.3.2 too;
# geo_ray_triangle answers NaN for a NaN origin and its miss, 0, for a NaN
# direction or vertex (its reciprocal guard); geo_ray_capsule answers NaN for
# every input coordinate since its 3.3.3 NaN-axis exit. Only the two slab
# routines turn the NaN into a finite t, through f64_max / f64_min and the
# parallel-slab branch: roadmap [3.3.4] D034. The `t < 0` tail tests of these
# two and of geo_ray_sphere stay NaN-true on purpose: each PAIR respelled
# NaN-false turns the NaN that reaches it into the miss 0 (every NaN-direction
# OBB ray did); one test alone changes no t, because the other still returns the
# NaN. tests/abuse.tcyr pins all three pairs.
# [measured: W1 ray sweep on the 3.3.2 and 3.3.3 bundles, not reproducible in-tree, 2026-10-01; cycc 6.6.12]
# ⚠ 3.3.4 — D034 is repaired (see FACE ENCODING above), and no NaN INPUT reaches the
# two slab routines' tails any more: the slab that reads it returns it. A NaN made
# from input with none (Inf - Inf, 0 * Inf) still does, as in 3.3.3, and their
# NaN-true tail pairs carry it out: respelled NaN-false, either pair turns it into
# the miss 0 (tests/modules.tcyr pins both). geo_ray_sphere's pair still carries a
# NaN input.
# THE INFINITY TEST, written inline at its four use sites rather than as a
# function:
#
#     is_inf(x)  ==  f64_eq(f64_abs(x), _GEO_F64_POS_INF)
#
# Measured, and the reason it is not a function: as a call it cost 5 ns of a
# 90 ns routine (+5.6% on `ray_aabb`, A higher in 3 of 3 interleaved pairs);
# inlined, the same repair measures +1.1% there -- inside this release's 3.5%
# noise floor -- and +2.9% on `ray_aabb_diag`, which reaches the tail check on
# every call. [measured: bench-history.csv ray_aabb_diag]

# Axis (0/1/2) of an encoded face.
public fn geo_face_axis(face) {
    return face / 2;
}

# 1 if the face is a max-side plane, 0 if min-side.
public fn geo_face_is_max(face) {
    return face % 2;
}

# Ray-plane intersection
# Returns t > 0 on hit, 0 on miss -- and a ZERO is also what a t = 0 hit returns,
# so a ray whose origin lies exactly in the plane is reported as a miss. That
# collision is the module convention (file header, ray-section header, every
# sibling), not an oversight: callers who must distinguish an origin-on-surface
# hit use the dedicated predicate idiom (0 miss, 1 hit, 2 cannot tell), as
# `_bvh_ray_hits_aabb` does for AABBs.
#
# WHICH zero comes back depends on the sign of `denom`, because t is 0 / denom:
# denom < 0 gives -0.0 (0x8000000000000000) and denom > 0 gives +0.0 (0), which is
# byte-identical to the miss return. Both are f64-equal to zero, so no f64_lt /
# f64_gt / f64_eq test separates a grazing hit from a miss in either direction --
# do not read the raw bits as a discriminator. Measured, and pinned in
# tests/modules.tcyr.
# [measured: tests/modules.tcyr "geo_ray_plane: origin ON the plane, denom < 0 -> negative zero" and its +0.0 twin]
#
# BEHAVIOUR CHANGE at 2.7.0: returns 0 on a miss, matching this module's stated
# convention (twice: file header and the ray-section header) and every sibling
# intersection function. Through 2.6.15 it returned the raw i64 -1, which as an
# f64 bit pattern is 0xFFFFFFFFFFFFFFFF -- a NEGATIVE NaN. That sentinel was
# detectable only by raw integer comparison; any consumer that did f64 arithmetic
# on it, or tested it with f64_lt/f64_gt, silently propagated NaN. No caller in
# src/ depended on -1.
#
# The line this replaces claimed the OPPOSITE ("-1 on miss, negative sentinel, not
# 0, to distinguish t = 0 hits") and sat directly above the 2.7.0 note correcting
# it; it described the pre-2.7.0 code and was never updated. Audit 2026-08-04,
# api-consistency (low). Pinned by tests/modules.tcyr, "geo_ray_plane: the doc's
# return convention, pinned".
public fn geo_ray_plane(ray, plane) {
    var denom = hvec3_dot(GeoPlane_normal(plane), GeoRay_direction(ray));
    # ⛔ `denom` = n·d carries the MAGNITUDE of the ray direction, so this absolute
    # 1e-12 made the answer depend on how long the caller's direction vector is.
    # Measured: plane z = 0, ray from (0,0,5) along (0,0,-2^-40) returns 0 — the
    # module's documented MISS — where the true hit is t = 5*2^40.
    # [measured: shipped binary, direction magnitude sweep]
    if (f64_lt(f64_abs(denom), _GEO_F64_TINY) == 1) { return 0; }
    var t = f64_div(f64_sub(GeoPlane_distance(plane), hvec3_dot(GeoPlane_normal(plane), GeoRay_origin(ray))), denom);
    if (f64_lt(t, 0) == 1) { return 0; }
    return t;
}

# x * 2^e with a single rounding (3.3.6), for a finite x and any integer e: the
# sphere and capsule quadratics solved at unit size (_geo_sphere_roots_scaled,
# geo_ray_capsule_branch) multiply their roots back by a power of two that can lie
# outside the range of one double. A step that keeps x normal is exact, so x is first
# taken no lower than the least normal binade and only the last multiplication can
# round (to a subnormal or to zero); an overflow is the answer, +-Inf. ⚠ An x of 2 or
# more is first taken into [1, 2): the one step to the least normal binade would be a
# power below 2^-1022, which `(1023 + k) << 52` cannot spell (a sphere root of 3.1 at
# e = -1050 was multiplied by +0, and an origin inside the sphere read the miss).
fn _geo_ldexp(x, e) {
    if (e > 1023) {
        x = f64_mul(x, 0x7FE0_0000_0000_0000);   # 2^1023
        e = e - 1023;
        if (e > 1023) {
            x = f64_mul(x, 0x7FE0_0000_0000_0000);
            e = e - 1023;
        }
    }
    if (e < 0 - 1022) {
        var ex = ((x >> 52) & 0x7FF) - 1023;
        if (ex == 1024) { return x; }   # +-Inf or NaN: unchanged by any 2^e
        if (ex > 0) {
            x = f64_mul(x, (1023 - ex) << 52);   # into [1, 2), exact
            e = e + ex;
            ex = 0;
        }
        var k = 0 - 1022 - ex;   # x * 2^k sits in the least normal binade
        if (k > 0) { k = 0; }
        if (k < e) { k = e; }
        x = f64_mul(x, (1023 + k) << 52);
        e = e - k;
        if (e < 0 - 1022) {
            if (e < 0 - 1074) { e = 0 - 1074; }
            return f64_mul(x, 1 << (e + 1074));   # 2^e, a subnormal power of two
        }
    }
    return f64_mul(x, (1023 + e) << 52);
}

# A root multiplied back by 2^e (_geo_ldexp) that stays below zero when it was: a negative
# root that underflows reads -2^-1074, not the -0 the callers take for a contact at t = 0
# (3.3.6). From (1 - 2^-53, 0, 0) inside the unit sphere along -2^1023 x, the root behind
# the origin read -0 and was the answer, for the exit 2^-1022; likewise a sphere of radius
# 2^-1030 met from just inside along -2 x answered -0 for its exit 2^-1030.
# [measured: C336 probe and exact Fraction roots, this tree, 2026-10-11; cycc 6.6.14]
fn _geo_root_ldexp(x, e) {
    var y = _geo_ldexp(x, e);
    if (y == 0x8000_0000_0000_0000) {
        if (x != y) { return 0x8000_0000_0000_0001; }
    }
    return y;
}

# Both roots of a t^2 + 2 hb t + c = 0, sorted, into out; 0 when there is none
# (delta < 0, NaN-false so a NaN carries through). `delta` is r^2 - |f|^2 with f the
# offset of the centre from the line, and sq = sqrt(a * delta), the root of the
# discriminant hb^2 - a c in the Ray Tracing Gems form (3.3.6, see _geo_sphere_roots).
# The larger root in magnitude is q / a with q = -(hb + sign(hb) sq), which never
# subtracts, and the other is c / q; q = 0 (hb = 0 and a tangent) is the double
# root -hb / a. ⚠ c = 0, an origin on the surface, is the root +0, as the classic
# (-hb + sqrt) / a gives it: c / q is -0 when the ray leaves (hb > 0, q < 0), and an
# origin on the sphere moving out answered -0 for 3.3.5's +0. ⚠ And a non-zero root that
# underflows below zero is -2^-1074, not -0: a -0 root is the contact at t = 0 to the
# callers, so a root behind an origin just outside read as the answer (see
# _geo_root_ldexp). (q / a is the root of larger magnitude, and no ray of the sweeps
# underflowed it; its line keeps the reading the same for both roots.)
fn _geo_quad_roots(hb, a, c, delta, sq, out) {
    if (f64_lt(delta, 0) == 1) { return 0; }
    var q = f64_neg(f64_add(hb, sq));
    if (f64_lt(hb, 0) == 1) { q = f64_sub(sq, hb); }
    var t1 = f64_div(q, a);
    var t2 = t1;
    if (f64_eq(q, 0) == 0) {
        if (t1 == 0x8000_0000_0000_0000) { t1 = 0x8000_0000_0000_0001; }
        t2 = f64_div(c, q);
        if (f64_eq(c, 0) == 1) { t2 = 0; }
        elif (t2 == 0x8000_0000_0000_0000) { t2 = 0x8000_0000_0000_0001; }
    }
    if (f64_gt(t1, t2) == 1) {
        var tt = t1;
        t1 = t2;
        t2 = tt;
    }
    store64(out, t1);
    store64(out + 8, t2);
    return 1;
}

# delta = r^2 - |f|^2 formed at the scale of f and r (3.3.6): when both are small their
# squares flush, and delta read 0, a tangent hit, for a line that misses the sphere by
# more than its radius. f and r are multiplied by the power of two that takes the
# larger into [1, 2); p[0] is delta there (its sign is the verdict) and p[1] is
# sqrt(a * delta) multiplied back, exactly, to the caller's scale.
fn _geo_delta_fine(fv, r, a, p) {
    var m = _geo_absmax_bits(fv);
    var mr = r & 0x7FFF_FFFF_FFFF_FFFF;
    if (mr > m) { m = mr; }
    var sf = _geo_scale_for(m >> 52);
    var fs[24];
    store64(&fs, f64_mul(HVec3_x(fv), sf));
    store64(&fs + 8, f64_mul(HVec3_y(fv), sf));
    store64(&fs + 16, f64_mul(HVec3_z(fv), sf));
    var rs = f64_mul(r, sf);
    var df = f64_sub(f64_mul(rs, rs), hvec3_dot(&fs, &fs));
    store64(p, df);
    store64(p + 8, _geo_ldexp(f64_sqrt(f64_mul(a, df)), 1023 - (sf >> 52)));
    return 0;
}

# x^2 as an unevaluated sum p[0] + p[1], exactly (Dekker's split; no fused multiply),
# for |x| below 2^995 so that x * (2^27 + 1) cannot overflow.
fn _geo_two_sq(x, p) {
    var sp = f64_mul(x, 0x41A0_0000_0200_0000);   # 2^27 + 1
    var hi = f64_sub(sp, f64_sub(sp, x));
    var lo = f64_sub(x, hi);
    var sq = f64_mul(x, x);
    var e = f64_add(f64_sub(f64_mul(hi, hi), sq), f64_mul(F64_TWO, f64_mul(hi, lo)));
    store64(p, sq);
    store64(p + 8, f64_add(e, f64_mul(lo, lo)));
    return 0;
}

# a + b as s + err, exactly (Knuth's two-sum): s returned, err added to p[0].
fn _geo_two_sum(a, b, p) {
    var sm = f64_add(a, b);
    var bb = f64_sub(sm, a);
    var er = f64_add(f64_sub(a, f64_sub(sm, bb)), f64_sub(b, bb));
    store64(p, f64_add(load64(p), er));
    return sm;
}

# c = |oc|^2 - r^2 for an origin near the sphere (3.3.6): there the two squares agree in
# their leading bits and the plain difference keeps only the rounding of each, which
# the near root c / q inherits: 7.2 ulp for an origin 0.066 radii out, and a median of
# 1.5e4 ulp (8.6e5 at most) within 1e-4 radii of the surface, with the plain c. Each
# square is formed exactly as two doubles and the eight parts summed with their errors
# carried, so c is good to an ulp of itself plus about 2^-104 of |oc|^2. For |oc| and r
# below 2^995.
# [measured: C336 sphere sweep, a draft without this helper vs this tree, 2026-10-11; cycc 6.6.14]
fn _geo_sphere_c_exact(oc, r) {
    var px[16];
    var py[16];
    var pz[16];
    var pr[16];
    _geo_two_sq(HVec3_x(oc), &px);
    _geo_two_sq(HVec3_y(oc), &py);
    _geo_two_sq(HVec3_z(oc), &pz);
    _geo_two_sq(r, &pr);
    var er[8];
    store64(&er, 0);
    var sm = _geo_two_sum(load64(&px), load64(&py), &er);
    sm = _geo_two_sum(sm, load64(&pz), &er);
    sm = _geo_two_sum(sm, f64_neg(load64(&pr)), &er);
    var tail = f64_add(f64_add(load64(&px + 8), load64(&py + 8)), f64_sub(load64(&pz + 8), load64(&pr + 8)));
    return f64_add(sm, f64_add(load64(&er), tail));
}

# x * y as an unevaluated sum p[0] + p[1], exactly (Dekker's two-product, the split
# _geo_two_sq uses), for |x| and |y| below 2^995 and a product clear of the subnormals.
fn _geo_two_prod(x, y, p) {
    var sx = f64_mul(x, 0x41A0_0000_0200_0000);   # 2^27 + 1
    var xh = f64_sub(sx, f64_sub(sx, x));
    var xl = f64_sub(x, xh);
    var sy = f64_mul(y, 0x41A0_0000_0200_0000);
    var yh = f64_sub(sy, f64_sub(sy, y));
    var yl = f64_sub(y, yh);
    var pr = f64_mul(x, y);
    var e = f64_add(f64_add(f64_sub(f64_mul(xh, yh), pr), f64_mul(xh, yl)), f64_mul(xl, yh));
    store64(p, pr);
    store64(p + 8, f64_add(e, f64_mul(xl, yl)));
    return 0;
}

# a b - c d with both products exact (_geo_two_prod) and their difference summed with
# its error carried: within an ulp of the result plus about 2^-104 of the products.
fn _geo_dpd(a, b, c, d) {
    var pp[16];
    var qq[16];
    _geo_two_prod(a, b, &pp);
    _geo_two_prod(c, d, &qq);
    var er[8];
    store64(&er, 0);
    var sm = _geo_two_sum(load64(&pp), f64_neg(load64(&qq)), &er);
    return f64_add(sm, f64_add(load64(&er), f64_sub(load64(&pp + 8), load64(&qq + 8))));
}

# The part of v across the line of w, (w x v) x w / (w . w), into out (3.3.6). v minus
# its projection on w keeps the projection's rounding, about 2^-52 |v| along w, and
# that swamps a part across w smaller than it: a ray within 2^-500 of a coordinate axis,
# or an origin 2^-500 of its distance along the axis away from it. This form subtracts
# nothing along w, and each component of both cross products is a b - c d formed with
# exact products (_geo_dpd). ⚠ With plain products the cross product cancelled for a w
# off the coordinate axes: a part across w under about 2^-50 |v| read 0, and a ray that
# misses the sphere (or a capsule's barrel or cap) by less than that, 3.3.5's miss, was
# a tangent or a hit. Callers pass w with its largest component in [1, 2) ([2^-51, 2) for a
# fully subnormal direction, _geo_scale_for) and |v| below 2^512.
fn _geo_perp_part(v, w, out) {
    var vx = HVec3_x(v);
    var vy = HVec3_y(v);
    var vz = HVec3_z(v);
    var wx = HVec3_x(w);
    var wy = HVec3_y(w);
    var wz = HVec3_z(w);
    var cx = _geo_dpd(wy, vz, wz, vy);
    var cy = _geo_dpd(wz, vx, wx, vz);
    var cz = _geo_dpd(wx, vy, wy, vx);
    var ww = hvec3_dot(w, w);
    store64(out, f64_div(_geo_dpd(cy, wz, cz, wy), ww));
    store64(out + 8, f64_div(_geo_dpd(cz, wx, cx, wz), ww));
    store64(out + 16, f64_div(_geo_dpd(cx, wy, cy, wx), ww));
    # Where w_i is 0 the part's component i is v_i exactly (v_i ww - w_i (w . v), over ww);
    # the form above rounds it three times, about 1.5 ulp, and for a capsule along a
    # coordinate axis that rounding of an otherwise exact o_perp moved a barrel root from
    # 0.75 ulp to 65 (an origin near the barrel, which amplifies it).
    if (f64_eq(wx, 0) == 1) { store64(out, vx); }
    if (f64_eq(wy, 0) == 1) { store64(out + 8, vy); }
    if (f64_eq(wz, 0) == 1) { store64(out + 16, vz); }
    return 0;
}

# 1 when the radius r is under 2^-4 of v's largest component, by exponent (3.3.6): the
# capsule's test, where a square overflowed, for taking both perpendicular parts exactly
# (geo_ray_capsule_branch). Through round 2 an overflowed square sent every ray at that
# scale to the exact parts; for C2's capsules at 2^1000, whose radius is about |o - start|,
# that moved answers both ways (19 right -> wrong against 675 wrong -> right), and with the
# ratio test alone a ray past a capsule 2^1022 away, radius 2^998, went from 0.19 ulp to
# 9.1e4 (the plain o_perp is off by 2^-52 |o - start|, 2^-28 of r). With this test the
# C2 family has no right -> wrong against 3.3.5.
# [measured: C336 capsule sweeps (seeds 51-53) and C2's seed-71 capsules, round 2 vs this tree, 2026-10-11; cycc 6.6.14]
fn _geo_cap_thin(r, v) {
    if (((r & 0x7FFF_FFFF_FFFF_FFFF) >> 52) + 4 < (_geo_absmax_bits(v) >> 52)) { return 1; }
    return 0;
}

# 1 when p, v's part across an axis as the projection formed it, may be the projection's
# rounding rather than the geometry (see _geo_perp_part): |p|^2 under 2^-80 of |v|^2, or p
# not finite (the projection overflowed). For the capsule when |p|^2 or |v|^2 is not finite:
# the two are compared on copies scaled by v's own power of two. Through round 2 of 3.3.6 an
# overflowed |v|^2 (|d| or |o - start| past 2^511) made every ray suspect, and the exact
# form, about as accurate as the projection there, ran on every ray at that scale and moved
# answers both ways (C2's capsules at 2^1000: 19 right -> wrong against 675 wrong -> right).
fn _geo_perp_suspect(p, v) {
    if (_geo_hvec3_nonfinite(p) + _geo_hvec3_nonfinite(v) != 0) { return 1; }
    var s = _geo_scale_for(_geo_absmax_bits(v) >> 52);
    var ps = hvec3_scale(p, s);
    var vs = hvec3_scale(v, s);
    return f64_lt(hvec3_dot(ps, ps), f64_mul(hvec3_dot(vs, vs), 0x3AF0_0000_0000_0000));   # 2^-80
}

# v's part across the axis u, from copies of both with their largest components in
# [1, 2): written to out as 2^e times the true part, e returned. v and u finite.
fn _geo_perp_rescue(v, u, out) {
    var ub = hvec3_scale(u, _geo_scale_for(_geo_absmax_bits(u) >> 52));
    var sv = _geo_scale_for(_geo_absmax_bits(v) >> 52);
    _geo_perp_part(hvec3_scale(v, sv), ub, out);
    return (sv >> 52) - 1023;
}

# 1 when the ray's and the sphere's ten inputs are finite (_geo_hvec3_nonfinite).
fn _geo_sphere_finite(ray, sphere) {
    if (_geo_hvec3_nonfinite(GeoRay_origin(ray)) == 1) { return 0; }
    if (_geo_hvec3_nonfinite(GeoRay_direction(ray)) == 1) { return 0; }
    if (_geo_hvec3_nonfinite(GeoSphere_center(sphere)) == 1) { return 0; }
    if (f64_lt(f64_abs(GeoSphere_radius(sphere)), _GEO_F64_POS_INF) == 0) { return 0; }
    return 1;
}

# Both roots of |ocs + t dsc|^2 = rs^2 for a copy at unit size (3.3.6): ocs and rs with
# their largest in [1, 2) or below, dsc with its largest component in [1, 2). The sphere's
# copy (_geo_sphere_roots_scaled) and the capsule barrel's (geo_ray_capsule_branch) are
# solved here, in the form _geo_sphere_roots uses, so nothing in it can overflow; 0 when
# there is no root or dsc is zero.
fn _geo_sph_solve(ocs, dsc, rs, out) {
    var a = hvec3_dot(dsc, dsc);
    if (f64_eq(a, 0) == 1) { return 0; }
    var hb = hvec3_dot(ocs, dsc);
    var rr = f64_mul(rs, rs);
    var ococ = hvec3_dot(ocs, ocs);
    var c = f64_sub(ococ, rr);
    if ((c & 0x7FFF_FFFF_FFFF_FFFF) < (ococ & 0x7FFF_FFFF_FFFF_FFFF) - 0x0020_0000_0000_0000) {
        c = _geo_sphere_c_exact(ocs, rs);
    }
    var k = f64_div(hb, a);
    var fv[24];
    store64(&fv, f64_sub(HVec3_x(ocs), f64_mul(k, HVec3_x(dsc))));
    store64(&fv + 8, f64_sub(HVec3_y(ocs), f64_mul(k, HVec3_y(dsc))));
    store64(&fv + 16, f64_sub(HVec3_z(ocs), f64_mul(k, HVec3_z(dsc))));
    var ff = hvec3_dot(&fv, &fv);
    var pn = f64_lt(rr, f64_mul(ococ, 0x3DF0_0000_0000_0000));   # 2^-32
    if (pn == 1) { pn = f64_lt(ff, f64_mul(ococ, 0x3AF0_0000_0000_0000)); }   # 2^-80
    if (pn == 1) {
        _geo_perp_part(ocs, dsc, &fv);
        ff = hvec3_dot(&fv, &fv);
    }
    var delta = f64_sub(rr, ff);
    var sq = 0;
    var dsel = 0;
    if (f64_lt(c, ff) == 1) {
        var dc = f64_sub(f64_mul(hb, hb), f64_mul(a, c));
        if (f64_lt(f64_abs(dc), _GEO_DIR_LO) == 0) {
            delta = dc;
            sq = f64_sqrt(dc);
            dsel = 1;
        }
    }
    if (dsel == 0) {
        sq = f64_sqrt(f64_mul(a, delta));
        if (f64_lt(f64_abs(delta), _GEO_DIR_LO) == 1) {
            var dq[16];
            _geo_delta_fine(&fv, rs, a, &dq);
            delta = load64(&dq);
            sq = load64(&dq + 8);
        }
    }
    return _geo_quad_roots(hb, a, c, delta, sq, out);
}

# _geo_sphere_roots for finite input whose quadratic overflowed (3.3.6): the same
# quadratic for a copy at unit size. o - c and r are multiplied by the power of two
# that takes the larger of them into [1, 2) (o and c are halved first when o - c
# overflows), d by the one that takes its largest component there, and the roots are
# multiplied back by the ratio (_geo_ldexp). Powers of two are exact, so this is the
# unit-size answer scaled. A radius far below |o - c| flushes in the copy, and so does
# the offset f it is compared with; _geo_sph_solve compares the two at their own scale
# (_geo_delta_fine), where reading both as 0 had made a tangent hit of a ray missing a
# unit sphere at 2^600 by one radius.
fn _geo_sphere_roots_scaled(ray, sphere, out) {
    var o = GeoRay_origin(ray);
    var cen = GeoSphere_center(sphere);
    var d = GeoRay_direction(ray);
    var r = GeoSphere_radius(sphere);
    var oc[24];
    var h = 0;
    store64(&oc, f64_sub(HVec3_x(o), HVec3_x(cen)));
    store64(&oc + 8, f64_sub(HVec3_y(o), HVec3_y(cen)));
    store64(&oc + 16, f64_sub(HVec3_z(o), HVec3_z(cen)));
    if (_geo_hvec3_nonfinite(&oc) == 1) {
        store64(&oc, f64_sub(f64_mul(HVec3_x(o), F64_HALF), f64_mul(HVec3_x(cen), F64_HALF)));
        store64(&oc + 8, f64_sub(f64_mul(HVec3_y(o), F64_HALF), f64_mul(HVec3_y(cen), F64_HALF)));
        store64(&oc + 16, f64_sub(f64_mul(HVec3_z(o), F64_HALF), f64_mul(HVec3_z(cen), F64_HALF)));
        r = f64_mul(r, F64_HALF);
        h = 1;
    }
    var mp = _geo_absmax_bits(&oc);
    var mr = r & 0x7FFF_FFFF_FFFF_FFFF;
    if (mr > mp) { mp = mr; }
    var sp = _geo_scale_for(mp >> 52);
    var sd = _geo_scale_for(_geo_absmax_bits(d) >> 52);
    var ocs[24];
    var dsc[24];
    store64(&ocs, f64_mul(load64(&oc), sp));
    store64(&ocs + 8, f64_mul(load64(&oc + 8), sp));
    store64(&ocs + 16, f64_mul(load64(&oc + 16), sp));
    store64(&dsc, f64_mul(HVec3_x(d), sd));
    store64(&dsc + 8, f64_mul(HVec3_y(d), sd));
    store64(&dsc + 16, f64_mul(HVec3_z(d), sd));
    var rs = f64_mul(r, sp);
    if (_geo_sph_solve(&ocs, &dsc, rs, out) == 0) { return 0; }
    var e = (sd >> 52) - (sp >> 52) + h;
    store64(out, _geo_root_ldexp(load64(out), e));
    store64(out + 8, _geo_root_ldexp(load64(out + 8), e));
    return 1;
}

# Ray-sphere intersection (quadratic, half-b form for normalized direction)
# BOTH roots of the ray/sphere quadratic, 2.10.2. Writes t1 <= t2 into out (two
# i64 slots) and returns 1; returns 0 on a miss or a degenerate direction,
# leaving `out` untouched.
#
# Split out of geo_ray_sphere because `geo_ray_capsule` needs BOTH roots to
# decide a cap hit and the single-root entry point only ever gave it one -- so a
# cap root rejected by the hemisphere test meant the other root was never
# considered, and the routine either answered with a point inside the solid or
# dropped a real exit entirely. geo_ray_sphere is now the root SELECTION on top
# of this, so there is one copy of the quadratic and the two cannot drift.
# 3.3.6: this is the general routine, _geo_sphere_roots_full; _geo_sphere_roots below is
# its common case written out on its own and hands it every other ray.
fn _geo_sphere_roots_full(ray, sphere, out) {
    var o = GeoRay_origin(ray);
    var cen = GeoSphere_center(sphere);
    var d = GeoRay_direction(ray);
    var r = GeoSphere_radius(sphere);
    # 3.3.6: o - c and the products below are scalars, with the dot products written out
    # in hvec3_dot's order ((x x' + y y') + z z', the same bits): allocating o - c through
    # hvec3_sub and forming each dot product through a call cost as much as the quadratic.
    var ox = f64_sub(HVec3_x(o), HVec3_x(cen));
    var oy = f64_sub(HVec3_y(o), HVec3_y(cen));
    var oz = f64_sub(HVec3_z(o), HVec3_z(cen));
    var dx = HVec3_x(d);
    var dy = HVec3_y(d);
    var dz = HVec3_z(d);

    # 2.10.0: `a` is carried explicitly. This was the REDUCED half-b form, which
    # drops `a = d.d` from both the discriminant and the division and is therefore
    # correct only for a UNIT direction. `geo_ray_new` normalises, so the intended
    # path was safe -- but `GeoRay` is #derive(accessors), `GeoRay_set_direction`
    # is public, and nothing documented a unit-length precondition. With a
    # non-unit direction the routine returned a `t` whose hit point was not on the
    # sphere at all: for a UNIT-RADIUS sphere and d = (1,2,3) it returned 1.0,
    # putting geo_ray_at(ray, t) **3.741657387 from the centre**, silently.
    #
    # The contract every geo_ray_* shares -- "the hit point is o + t*d" -- makes t
    # degree -1 homogeneous in d, and `plane`, `triangle`, `aabb` and `obb` all
    # honoured it. This was a sibling asymmetry, the same class 2.9.1 repaired in
    # mpr_intersect vs gjk_intersect_3d, where "keep the strict reading and
    # document it" was rejected for the same reason: a contract that depends on
    # how the caller got there is not a contract.
    #
    # `geo_ray_capsule`'s own cylinder quadratic was already correct; it failed
    # the same sweep only because its end-cap branches call this function.
    # Asserted by _homog_sweep / _HG_BAD in tests/modules.tcyr, oracle-free.
    var a = f64_add(f64_add(f64_mul(dx, dx), f64_mul(dy, dy)), f64_mul(dz, dz));
    # Reject only a genuinely zero-length direction. `a` is d.d, a SQUARED
    # length, so the threshold was EPSILON_F64 SQUARED (`_GEO_F64_EPS_SQ`, gone in 3.3.4).
    # Testing it against EPSILON_F64 directly (2.10.0) made every |d| < 1e-6 a
    # miss, breaking the degree -1 homogeneity this same repair established:
    # a unit sphere at (0,0,5) with d = (0,0,1e-7) has t = 4e7, and it returned 0.
    # geo_ray_capsule inherited it through its end caps, exactly as in 2.10.0.
    # [measured: docs/development/issues/archived/2026-08-10-squared-epsilon-guards-in-geo-ray.md]
    # ⚠ 2.14.0: 2.10.2 fixed the EXPONENT here (squared length vs squared epsilon)
    # but kept an absolute SCALE, so the miss just moved: a unit sphere at (0,0,5)
    # with d = (0,0,2^-40) still returned 0. `a` only has to admit a finite
    # reciprocal (`inv_a` below), and DBL_MIN guarantees that (1/DBL_MIN = 2^1022).
    # [measured: shipped binary, hit at k = 0 and miss from k = -41]
    # ⛔ 3.3.5 — BELOW 2^-511 A RAW DIRECTION WAS STILL A MISS: `a` = d.d is under
    # DBL_MIN there (a unit sphere at (0,0,5) with d = (0,0,2^-512), true t = 5 * 2^512,
    # returned 0) while plane, triangle and AABB answer to about 2^-1022, and just
    # above it half_b^2 and a * c were subnormal. A d with d.d below 2^-968
    # (_GEO_DIR_LO) is multiplied by the power of two `sc` that takes its largest
    # component into [1, 2) (a stack copy, no allocation), the quadratic is solved for
    # it, and its roots, t / sc, are multiplied back by sc. Powers of two are exact, so
    # this is the copy's answer scaled, bit for bit the unscaled one wherever that kept
    # every product normal, and a t past DBL_MAX is +Inf as it is for a far sphere.
    # Only a zero d is still the miss, and a NaN d (a NaN `a` fails the `<`) keeps the
    # old arithmetic, as does every ray with d.d of 2^-968 or more.
    # 48 rays, each at every 2^k from 2^-1074 to 2^-400 and from 2^-20 to 2^20 (34368):
    # against an exact root, sphere answers 20229 wrong -> right and none right ->
    # wrong, and t(2^k d) is 2^-k t(d) bit for bit in all 31853 exact scalings
    # (3.3.4 differed in 11 at 2^-512..2^-510, from subnormal products, by up to
    # 22.6 ulp against the copy's 8.6). The capsule (geo_ray_capsule_branch, with
    # its barrel scaled alike) became covariant in t and branch in 20933 and lost it
    # in none; 11 differ only past DBL_MAX, where t is +Inf and the branch arbitrary.
    # The 6064 rays with d.d of 2^-968 or more kept their bits.
    # [measured: G1 ray sweep, exact Fraction/Decimal roots, 3.3.4 tree vs this one, 2026-10-11; cycc 6.6.14]
    var sc = 0;
    if (f64_lt(a, _GEO_DIR_LO) == 1) {
        var m = _geo_absmax_bits(d);
        if (m == 0) { return 0; }
        sc = _geo_scale_for(m >> 52);
        dx = f64_mul(dx, sc);
        dy = f64_mul(dy, sc);
        dz = f64_mul(dz, sc);
        a = f64_add(f64_add(f64_mul(dx, dx), f64_mul(dy, dy)), f64_mul(dz, dz));
    }
    var half_b = f64_add(f64_add(f64_mul(ox, dx), f64_mul(oy, dy)), f64_mul(oz, dz));
    var rr = f64_mul(r, r);
    var ococ = f64_add(f64_add(f64_mul(ox, ox), f64_mul(oy, oy)), f64_mul(oz, oz));
    var c = f64_sub(ococ, rr);
    # ⛔ 3.3.6 — THE DISCRIMINANT CANCELLED. hb^2 - a c subtracts two products that agree
    # in their leading bits whenever the sphere is small against its distance or the
    # ray nearly grazes it, and the near root (-hb - sqrt) / a then subtracted again:
    # 8.06 ulp on an ordinary unit-size ray (o = (4.13, 4.19, 2.15) toward a radius-1.29
    # sphere 4.5 radii away), and 1.2e6 ulp for an origin 1e-6 radii off the surface.
    # The discriminant is a (r^2 - |f|^2) with f = oc - (hb / a) d the centre's offset
    # from the line (the Ray Tracing Gems form), and the larger root in magnitude is
    # q / a with q = -(hb + sign(hb) sqrt), the other c / q, so no root subtracts
    # (_geo_quad_roots). Where the origin is inside or close (c < |f|^2) the classic
    # hb^2 - a c is kept instead, since there it is a sum, or a difference smaller than
    # |f|^2's; and c itself, which cancels near the surface, is formed exactly as two
    # doubles when it has lost two bits or more (_geo_sphere_c_exact). Over 192000 rays
    # (two seeds: the item's unit-size family with the origin 1e-6 to 4 radii out,
    # random rays and raw directions, large and small scales, tangent and on-surface
    # origins), every finite one judged against its exact verdict and root: 85296 wrong ->
    # right at 4 ulp and 35 right -> wrong, 34 of them 0.7-3.96 ulp moving to 4.0-5.9 and
    # one near-tangent ray 2.69 -> 19.3. 3542 stay wrong: 3172 rays tangent to within 1e-9
    # of the radius or from an origin on the surface, where r^2 - |f|^2 is 2e-9 of r^2
    # (at most 1.9e5 ulp; 3.3.5 4.2e17), 195 aimed from an origin below an ulp of the
    # centre's coordinates, where o - c rounds to -c and a miss reads as a hit (3.3.5:
    # NaN), and 175 more past 4 ulp (at most 45). On the unit-size family the largest
    # error fell from 1.29e6 to 11.2 ulp and the median from 90-100 to 0.55; on its origins
    # at least one radius outside the sphere, from 42.8 to 8.0 and from 1.82-1.90 to
    # 0.58-0.59. Every hit changes its bits.
    # [measured: C336 sphere sweep, seeds 41 and 42, exact Decimal roots, 3.3.5 vs this tree, 2026-10-11; cycc 6.6.14]
    var k = f64_div(half_b, a);
    var fx = f64_sub(ox, f64_mul(k, dx));
    var fy = f64_sub(oy, f64_mul(k, dy));
    var fz = f64_sub(oz, f64_mul(k, dz));
    var ff = f64_add(f64_add(f64_mul(fx, fx), f64_mul(fy, fy)), f64_mul(fz, fz));
    var delta = f64_sub(rr, ff);
    var big_d = f64_mul(a, delta);
    # ⛔ 3.3.6 — ABOVE 2^511 THE QUADRATIC OVERFLOWED, AND NaN CAME BACK. A raw direction
    # past 2^511 overflows d . d, an origin 2^512 from the centre |oc|^2, a centre at
    # 2^600 likewise: a unit sphere at (0,0,5) with d = (0,0,2^600) gave NaN for
    # t = 2^-598, and (0,0,-2^512) along +z NaN for t = 2^512. Only an overflow makes
    # a (r^2 - |f|^2) or c non-finite from finite input, so either sends the ray to
    # _geo_sphere_roots_scaled, which solves the same quadratic for a unit-size copy
    # and scales the roots back; a t past DBL_MAX is +Inf there as here. A NaN or an
    # infinite input keeps 3.3.5's arithmetic exactly (12000 such rays, bit for bit).
    # On the sweep's large-scale family (oc to DBL_MAX, d to 2^1023, o - c overflowing)
    # 39642 rays went wrong -> right and none right -> wrong; 205 stay wrong, 195 of them
    # the origins below an ulp of the centre noted above.
    # [measured: C336 sphere sweep, seeds 41 and 42, exact Decimal roots, 3.3.5 vs this tree, 2026-10-11; cycc 6.6.14]
    if (f64_lt(f64_abs(big_d), _GEO_F64_POS_INF) == 0 || f64_lt(f64_abs(c), _GEO_F64_POS_INF) == 0) {
        if (_geo_sphere_finite(ray, sphere) == 1) { return _geo_sphere_roots_scaled(ray, sphere, out); }
        # A NaN or infinite input: 3.3.5's arithmetic, unchanged (the open non-finite
        # contract row).
        var disc = f64_sub(f64_mul(half_b, half_b), f64_mul(a, c));
        if (f64_lt(disc, 0) == 1) { return 0; }
        var sqrt_d = f64_sqrt(disc);
        var inv_a = f64_div(F64_ONE, a);
        var u1 = f64_mul(f64_sub(f64_neg(half_b), sqrt_d), inv_a);
        var u2 = f64_mul(f64_add(f64_neg(half_b), sqrt_d), inv_a);
        if (sc != 0) {
            u1 = f64_mul(u1, sc);
            u2 = f64_mul(u2, sc);
        }
        store64(out, u1);
        store64(out + 8, u2);
        return 1;
    }
    # |oc| and r both under 2^-484: their squares are subnormal or flushed, and so is c,
    # which the near root c / q is formed from: a sphere of radius 2^-960 whose centre is
    # 3 * 2^-960 away, met along 2^56 x, read the near root 2^-1015 as 0 (3.3.5, whose
    # discriminant flushed too, as the tangent root 3 * 2^-1016). The unit-size copy forms
    # c at its own scale. Over 20000 such rays (spheres of radius 2^-1000 to 2^-20, raw
    # directions taking t to 2^-1110 .. 2^-990) against exact roots: 12003 wrong -> right,
    # none right -> wrong (31 without this test), 16 still past 4 ulp (at most 21).
    # [measured: C336 tiny-sphere family (x7.py, seed 43), 3.3.5 vs this tree, 2026-10-11; cycc 6.6.14]
    if (f64_lt(ococ, _GEO_DIR_LO) == 1 && f64_lt(rr, _GEO_DIR_LO) == 1) {
        if (_geo_sphere_finite(ray, sphere) == 1) { return _geo_sphere_roots_scaled(ray, sphere, out); }
    }
    # c lost two bits or more to cancellation: |c| under a quarter of |oc|^2.
    var ocv[24];   # o - c for the helpers below, which take a vector
    if ((c & 0x7FFF_FFFF_FFFF_FFFF) < (ococ & 0x7FFF_FFFF_FFFF_FFFF) - 0x0020_0000_0000_0000) {
        store64(&ocv, ox);
        store64(&ocv + 8, oy);
        store64(&ocv + 16, oz);
        c = _geo_sphere_c_exact(&ocv, r);
    }
    # f under 2^-40 of |oc| may be the rounding of oc - (hb / a) d along d, not the
    # offset, and _geo_perp_part forms it without that subtraction. For a ray along z
    # nearly through the centre of a unit sphere 2^133 away 3.3.5 answered the miss (and
    # was 9.65e7 ulp off at 2^137); the form above alone leaves the same residual.
    # [measured: C336 fixture search, exact Decimal roots, 3.3.5 vs this tree, 2026-10-11; cycc 6.6.14]
    # It runs only where that rounding can reach the answer: the plain f is off by about
    # 2^-52 |oc| (its part along d drops out of |f|^2 to second order), so |f|^2 under
    # 2^-80 |oc|^2 is off by less than 2^-91 |oc|^2, and with r^2 at least 2^-32 |oc|^2
    # that is under 2^-59 of r^2 - |f|^2: a ray through the centre of an ordinary sphere
    # keeps the plain form (the exact one, many times its cost, gives the same answer).
    var pn = f64_lt(rr, f64_mul(ococ, 0x3DF0_0000_0000_0000));   # 2^-32
    if (pn == 1) { pn = f64_lt(ff, f64_mul(ococ, 0x3AF0_0000_0000_0000)); }   # 2^-80
    var fv[24];
    if (pn == 1) {
        var d2[24];
        store64(&d2, dx);
        store64(&d2 + 8, dy);
        store64(&d2 + 16, dz);
        var s2 = _geo_scale_for(_geo_absmax_bits(&d2) >> 52);
        store64(&d2, f64_mul(dx, s2));
        store64(&d2 + 8, f64_mul(dy, s2));
        store64(&d2 + 16, f64_mul(dz, s2));
        store64(&ocv, ox);
        store64(&ocv + 8, oy);
        store64(&ocv + 16, oz);
        _geo_perp_part(&ocv, &d2, &fv);
        fx = load64(&fv);
        fy = load64(&fv + 8);
        fz = load64(&fv + 16);
        ff = f64_add(f64_add(f64_mul(fx, fx), f64_mul(fy, fy)), f64_mul(fz, fz));
        delta = f64_sub(rr, ff);
        big_d = f64_mul(a, delta);
    }
    # The discriminant's form (see the 3.3.6 note above): classic for an origin inside
    # or near (c < |f|^2) unless it is not finite or too small, the RTG form otherwise,
    # with r^2 - |f|^2 formed at f's own scale when it is too small to trust
    # (_geo_delta_fine: both squares flush for a sphere and an offset below 2^-537).
    var sq = 0;
    var dsel = 0;
    if (f64_lt(c, ff) == 1) {
        var dc = f64_sub(f64_mul(half_b, half_b), f64_mul(a, c));
        if (f64_lt(f64_abs(dc), _GEO_F64_POS_INF) == 1) {
            if (f64_lt(f64_abs(dc), _GEO_DIR_LO) == 0) {
                delta = dc;
                sq = f64_sqrt(dc);
                dsel = 1;
            }
        }
    }
    if (dsel == 0) {
        sq = f64_sqrt(big_d);
        if (f64_lt(f64_abs(delta), _GEO_DIR_LO) == 1) {
            var dq[16];
            store64(&fv, fx);
            store64(&fv + 8, fy);
            store64(&fv + 16, fz);
            _geo_delta_fine(&fv, r, a, &dq);
            delta = load64(&dq);
            sq = load64(&dq + 8);
        }
    }
    if (_geo_quad_roots(half_b, a, c, delta, sq, out) == 0) { return 0; }
    if (sc != 0) {
        store64(out, f64_mul(load64(out), sc));
        store64(out + 8, f64_mul(load64(out + 8), sc));
    }
    return 1;
}

# Both roots of the ray/sphere quadratic (the contract above), for the common case: a
# direction with d . d of 2^-968 or more, a finite quadratic, |oc| or r of 2^-484 or more, c
# that kept its leading bits, an offset f that needs no exact form, and a discriminant that
# is not too small to trust. That is _geo_sphere_roots_full's arithmetic for such a ray,
# operation for operation, so the bits are its bits; every other ray is handed to it
# (3.3.6). Written apart because cycc keeps five locals in registers, and with the general
# routine's other cases in the same body the common ray's locals were spilled.
# ⚠ The two copies must not drift: tests/modules_b.tcyr compares them word for word over
# rays that take each of the hand-offs below and rays that take none.
fn _geo_sphere_roots(ray, sphere, out) {
    var o = GeoRay_origin(ray);
    var cen = GeoSphere_center(sphere);
    var d = GeoRay_direction(ray);
    var ox = f64_sub(HVec3_x(o), HVec3_x(cen));
    var oy = f64_sub(HVec3_y(o), HVec3_y(cen));
    var oz = f64_sub(HVec3_z(o), HVec3_z(cen));
    var dx = HVec3_x(d);
    var dy = HVec3_y(d);
    var dz = HVec3_z(d);
    var a = f64_add(f64_add(f64_mul(dx, dx), f64_mul(dy, dy)), f64_mul(dz, dz));
    # (The tests below compare bit patterns as integers: for a non-negative double, or one whose
    # NaN would have been handed off already, that is the order of the values.)
    if (a < 0x0370_0000_0000_0000) { return _geo_sphere_roots_full(ray, sphere, out); }   # 2^-968
    var r = GeoSphere_radius(sphere);
    var half_b = f64_add(f64_add(f64_mul(ox, dx), f64_mul(oy, dy)), f64_mul(oz, dz));
    var rr = f64_mul(r, r);
    var ococ = f64_add(f64_add(f64_mul(ox, ox), f64_mul(oy, oy)), f64_mul(oz, oz));
    var c = f64_sub(ococ, rr);
    var k = f64_div(half_b, a);
    var fx = f64_sub(ox, f64_mul(k, dx));
    var fy = f64_sub(oy, f64_mul(k, dy));
    var fz = f64_sub(oz, f64_mul(k, dz));
    var ff = f64_add(f64_add(f64_mul(fx, fx), f64_mul(fy, fy)), f64_mul(fz, fz));
    var delta = f64_sub(rr, ff);
    var big_d = f64_mul(a, delta);
    # The hand-offs, in _geo_sphere_roots_full's order: an overflow (or a non-finite input),
    # |oc| and r both under 2^-484, c cancelled, the offset f possibly rounding. (The general
    # routine's test of c is not repeated: a c that is not finite comes from |oc|^2 or r^2
    # not finite; an r^2 or a NaN makes a (r^2 - |f|^2) non-finite too, and an |oc|^2 of
    # +Inf with r finite meets the offset's test below, r^2 and |f|^2 being under +Inf * 2^-32.)
    if ((big_d & 0x7FFF_FFFF_FFFF_FFFF) >= 0x7FF0_0000_0000_0000) { return _geo_sphere_roots_full(ray, sphere, out); }
    if (ococ < 0x0370_0000_0000_0000) {
        if (rr < 0x0370_0000_0000_0000) { return _geo_sphere_roots_full(ray, sphere, out); }
    }
    if ((c & 0x7FFF_FFFF_FFFF_FFFF) < (ococ & 0x7FFF_FFFF_FFFF_FFFF) - 0x0020_0000_0000_0000) {
        return _geo_sphere_roots_full(ray, sphere, out);
    }
    if (f64_lt(rr, f64_mul(ococ, 0x3DF0_0000_0000_0000)) == 1) {   # 2^-32
        if (f64_lt(ff, f64_mul(ococ, 0x3AF0_0000_0000_0000)) == 1) { return _geo_sphere_roots_full(ray, sphere, out); }
    }
    # The discriminant: classic for an origin inside or near unless it is not finite or
    # under 2^-968 (handed off), the RTG form otherwise unless under 2^-968 (handed off).
    var sq = 0;
    if (f64_lt(c, ff) == 1) {
        var dc = f64_sub(f64_mul(half_b, half_b), f64_mul(a, c));
        var adc = dc & 0x7FFF_FFFF_FFFF_FFFF;
        if (adc >= 0x7FF0_0000_0000_0000) { return _geo_sphere_roots_full(ray, sphere, out); }
        if (adc < 0x0370_0000_0000_0000) { return _geo_sphere_roots_full(ray, sphere, out); }
        if (f64_lt(dc, 0) == 1) { return 0; }
        sq = f64_sqrt(dc);
    } else {
        if (delta < 0x0370_0000_0000_0000) {   # (a negative delta's bits are negative)
            if ((delta & 0x7FFF_FFFF_FFFF_FFFF) < 0x0370_0000_0000_0000) {
                return _geo_sphere_roots_full(ray, sphere, out);
            }
            return 0;
        }
        sq = f64_sqrt(big_d);
    }
    # _geo_quad_roots, written out, without its cases for c = 0, q = 0 and a root that
    # underflows: none reaches here. c is not 0 (a cancelled c is handed off), sq is at least
    # 2^-484 so q is not 0, and |q| / a >= |c| / |q| >= sqrt(|c| / a) >= 2^-999, both roots
    # normal, from |c| >= |oc|^2 / 4 with |oc|^2 or r^2 at least 2^-968 and a < 2^1024.
    var q = f64_neg(f64_add(half_b, sq));
    if (f64_lt(half_b, 0) == 1) { q = f64_sub(sq, half_b); }
    var t1 = f64_div(q, a);
    var t2 = f64_div(c, q);
    if (f64_gt(t1, t2) == 1) {
        var tt = t1;
        t1 = t2;
        t2 = tt;
    }
    store64(out, t1);
    store64(out + 8, t2);
    return 1;
}

# The first non-negative root, or 0 on a miss -- the shipped contract, unchanged.
public fn geo_ray_sphere(ray, sphere) {
    # STACK, not alloc: the bump allocator never frees, so a 16-byte alloc here
    # would leak per call in the module's hottest routine -- the same objection
    # geo_diff.cyr's header raises against threading dual numbers through it.
    #
    # ⚠ `&rt`, not `rt`. A stack array is a VALUE; bare `rt` passes its first
    # eight bytes as if they were an address, which stores through a wild
    # pointer and SIGSEGVs on the first call. `lib/fmt.cyr` has used `&buf`
    # since forever and it is the only correct form. Written down because the
    # bare version fails so immediately and so totally that it reads like a
    # toolchain defect, and a minimal repro was most of the way to being filed
    # as one before the stdlib was read.
    var rt[16];
    if (_geo_sphere_roots(ray, sphere, &rt) == 0) { return 0; }
    var t1 = load64(&rt);
    var t2 = load64(&rt + 8);

    if (f64_lt(t1, 0) != 1) { return t1; }
    if (f64_lt(t2, 0) != 1) { return t2; }
    return 0;
}

# Ray-AABB intersection (slab method)
#
# DEGENERATE DIRECTION, repaired 2.10.1. A slab whose direction component is
# below EPSILON_F64 is skipped as parallel, and if ALL THREE are skipped nothing
# ever narrows the interval: t_min stays -Inf, t_max stays +Inf, and the tail
# below returned +Inf. That is neither the documented miss (0) nor a usable hit
# parameter -- geo_ray_at(ray, +Inf) on a zero direction is NaN in every
# component. Reachable through the public `GeoRay_set_direction`, exactly as the
# 2.10.0 unit-direction defect was; `geo_ray_new` normalizes, so the intended
# path never saw it. Four of the six geo_ray_* siblings already returned 0 here;
# this and geo_ray_obb were the two that did not.
#
# The guard is a COUNT of contributing slabs rather than a `d.d < EPSILON` test
# up front, because that test would also reject legitimate small directions --
# (0, 0, 1e-5) has |d|^2 = 1e-10 < EPSILON_F64 but its z slab is not parallel and
# its hit is real. Counting changes behaviour on exactly the path that produced
# +Inf and nowhere else.
#
# THE PARALLEL TEST ITSELF, repaired 2.10.2. It used to be
# `|d_k| < EPSILON_F64` (1e-12), which deletes the slab. That threshold is
# scale-free and the consequence is not: what decides whether a slab matters is
# |d_k| * t_range against the box extent, and none of those appear in the test.
# Over t ~ 1e12 a component of 9e-13 moves the coordinate by ~0.9 -- most of a
# unit box -- so the slab that would have REJECTED the ray was deleted and the
# routine returned a confident hit. Measured on 2.10.1: box [0,1]^3, origin
# (0.5, 0.5, -1e12), direction (9e-13, 0, 1) with |d| = 1.0 EXACTLY returned
# t = 1e12 whose hit point sits at x = 1.4. geo_ray_new normalizes and did not
# protect. The same input from inside a tall box returned an exit 18x too large.
# [measured: docs/development/issues/archived/2026-08-10-slab-parallel-test-is-scale-free.md]
#
# The guard's only real job is to avoid a division that yields no usable
# reciprocal, so the threshold is now exactly that: _GEO_F64_TINY, the smallest
# magnitude whose 1/x is finite. Every direction component that CAN be divided by
# now is. This also makes geo_ray_obb agree with this function at the boundary --
# the two used opposite comparison senses around EPSILON_F64, so a component
# equal to it took the slab branch here and the parallel branch there, and the
# same box expressed both ways answered 0 and 4.5e12.
#
# ⚠ geo_ray_obb spells its test `f64_lt(f64_abs(f), _GEO_F64_TINY) != 1` -- the
# negation of this one rather than the more natural `f64_gt(..., TINY) == 1`, and
# that is deliberate. A mutant swapping it to the `f64_gt` form SURVIVES the
# suite, and the reason is that the two are behaviourally equivalent: they differ
# only at |f| EXACTLY equal to DBL_MIN, where 1/f is 4.5e307 and the resulting
# slab interval is so wide it constrains nothing -- which is precisely what the
# parallel branch also expresses. The form is chosen so the two functions'
# tests are textually identical, because "they agree at the boundary" should be
# checkable by reading and not only by running. (Since 3.3.5 they are not: see the
# next note.)
# [measured: docs/development/issues/archived/2026-08-10-slab-parallel-test-is-scale-free.md]
# [measured: tests/modules.tcyr "2.10.1 degenerate-direction contract"]
# ⛔ 3.3.5 — A COMPONENT BELOW DBL_MIN WAS READ AS PARALLEL, AND EVERY CROSSING
# ROUNDED TWICE. The reciprocal needed |d_k| >= DBL_MIN, so a direction normalised
# from (1e-310, 1, 0) had its x slab skipped: a ray that leaves that slab at a finite
# t answered a hit, and one that enters it a miss. The slabs now divide (b - o) / d_k,
# which needs only d_k != 0, so the parallel test is an exact zero; a crossing past
# DBL_MAX overflows to +-Inf (an entry there is the miss, as before), and each
# crossing is one correctly rounded quotient of the rounded b - o, not (b - o) *
# RN(1/d). Over 90000 finite box-ray pairs (12159 with an inverted box) against an
# exact rational oracle, 105 answers moved wrong -> right (21 with an inverted box)
# and none right -> wrong; 3339 within 2^-48 of a tie, or at t = 0, are not scored.
# t's bits changed in 4461, 3968 of them right before and after, no face with them;
# correctly rounded hits went from 13650 to 17582 of 17830 and the largest error of a
# right answer from 1.70 to 1.30 ulp. All 6000 inputs with a NaN keep D034's contract,
# and of 6000 with an infinity 80 moved, none right -> wrong against an
# extended-real oracle (24 of them Inf - Inf, which it cannot judge).
# [measured: G1 slab sweep, exact Fraction oracle, 3.3.4 tree vs this one, 2026-10-11; cycc 6.6.14]
# ⚠ geo_ray_obb_face kept the DBL_MIN test and the reciprocal through 3.3.5; 3.3.6 gives
# it the same exact zero and division (see there). The three notes below are the
# history of its old spelling, `f64_lt(|f|, DBL_MIN) != 1`: the new test,
# `f64_eq(f, 0) == 0` with the infinite-e clause, also sends a NaN f to the slab
# arithmetic, so the NaN pins they describe hold unchanged.
# ⚠ 3.3.3 — "ONLY AT |f| EXACTLY DBL_MIN" MISSES NaN. For a NaN `f` the `f64_gt`
# form is 0 and sends the slab to the parallel branch, which skips it or returns
# the miss 0; the `!= 1` form keeps the NaN in the slab arithmetic, as this
# function's `== 1` test does for a NaN `d`. Swapped on its own, each of the
# three OBB tests turned about half of 2000 NaN-direction rays from NaN into 0,
# so the mutant is not equivalent once a NaN is in play. tests/abuse.tcyr pins
# each axis with a NaN direction from outside that axis's slab.
# [measured: W1 ray sweep, one test swapped at a time, not reproducible in-tree, 2026-10-01; cycc 6.6.12]
# ⚠ 3.3.4 — FOR A NaN INPUT ONLY AXIS 0's SPELLING MATTERS. f0 = a0 . d reads every
# direction component (0 * NaN is NaN), so a NaN direction meets axis 0 first, and
# since D034 that slab returns it: swapped on axis 1 or 2 alone the test is
# equivalent for NaN input, and the suites pass. Swapped on axis 0 it still sends
# the NaN to the parallel branch, whose miss tests read only e0 and he0, and the pin
# from outside the x slab comes back 0.
# [measured: georay mutation run, one test swapped at a time, 3.3.4 tree, not in-tree, 2026-10-03; cycc 6.6.14]
#
# ⛔ 3.3.4 — AN INVERTED BOX IS READ SORTED, AS geo_ray_obb READS |he|. Only the
# setters build one (min above max on an axis; geo_aabb_new sorts its corners). A
# slab the ray crosses has always sorted its two t, so it read the slab [5, 1] as
# [1, 5], while the parallel test read the same slab as empty: an oblique ray hit
# the box and an axial one missed it. Each parallel miss test now also asks that the
# origin be outside the OTHER bound, so the slab misses only below both bounds or
# above both. For min <= max the second test is implied by the first, and for a NaN
# bound it is false, so it changes no answer there and only the miss path runs it.
# The t is the sorted box's; a face names the stored slot (face 0 is the plane at
# min.x wherever it lies), which is the plane geo_jet_aabb differentiates. Over 19803
# random boxes with one to three axes inverted (a third with a +-0, subnormal, DBL_MAX
# or infinite slot), t matches the sorted box's in all but 5, each a zero of the other
# sign from an infinite direction component, and the tie, the jet and the BVH leaf
# test in all; boxes that are not inverted keep their bits (FACE ENCODING, above).
# [measured: inverted-AABB differential, this tree, not in-tree, 2026-10-03; cycc 6.6.14]
#
# 3.3.4, D034 (see FACE ENCODING): the first NaN component of v, or 0 (+0.0) when
# it has none. A NaN's bits are never 0, so `== 0` reads "no NaN".
fn _geo_hvec3_nan(v) {
    if (f64_eq(HVec3_x(v), HVec3_x(v)) == 0) { return HVec3_x(v); }
    if (f64_eq(HVec3_y(v), HVec3_y(v)) == 0) { return HVec3_y(v); }
    if (f64_eq(HVec3_z(v), HVec3_z(v)) == 0) { return HVec3_z(v); }
    return 0;
}

# The miss 0, or the first NaN among the ray's and the box's twelve inputs. Every
# miss geo_ray_aabb_face finds before its last slab has read its inputs returns
# this: a parallel slab's two tests fire before its own NaN tests, and a slab
# later than the one that missed is never read.
fn _geo_ray_aabb_nan_or_miss(ray, aabb) {
    var n = _geo_hvec3_nan(GeoRay_origin(ray));
    if (n == 0) { n = _geo_hvec3_nan(GeoRay_direction(ray)); }
    if (n == 0) { n = _geo_hvec3_nan(GeoAabb_min(aabb)); }
    if (n == 0) { n = _geo_hvec3_nan(GeoAabb_max(aabb)); }
    return n;
}

# The first NaN among the ray's and the OBB's sixteen inputs, or 0. A NaN slab in
# geo_ray_obb_face can come from FINITE input too: an axis's exact zero component
# times a centre-to-origin offset that overflowed (0 * Inf). Only a NaN the caller
# supplied is returned; one the arithmetic made is left to the slab test as in 3.3.3.
fn _geo_ray_obb_nan(ray, obb) {
    var n = _geo_hvec3_nan(GeoRay_origin(ray));
    if (n == 0) { n = _geo_hvec3_nan(GeoRay_direction(ray)); }
    if (n == 0) { n = _geo_hvec3_nan(GeoObb_center(obb)); }
    if (n == 0) { n = _geo_hvec3_nan(GeoObb_half_extents(obb)); }
    var q = GeoObb_rotation(obb);
    if (n == 0) { if (f64_eq(HQuat_x(q), HQuat_x(q)) == 0) { n = HQuat_x(q); } }
    if (n == 0) { if (f64_eq(HQuat_y(q), HQuat_y(q)) == 0) { n = HQuat_y(q); } }
    if (n == 0) { if (f64_eq(HQuat_z(q), HQuat_z(q)) == 0) { n = HQuat_z(q); } }
    if (n == 0) { if (f64_eq(HQuat_w(q), HQuat_w(q)) == 0) { n = HQuat_w(q); } }
    return n;
}

# ================================================================
# Exact slab ordering (3.3.6), shared by geo_ray_aabb_face and geo_ray_obb_face
# ================================================================
# Each slab crossing is (p - q) / d: (bound - o) / d_k for the AABB, (e -+ he) / f_k for
# the OBB. The double the slab code forms, RN(RN(p - q) / d), loses its order with the
# other crossings in two ways on finite input:
#   * p - q OVERFLOWS (|p - q| > DBL_MAX) while the quotient is finite, so a crossing
#     at, say, 2^1022 reads +Inf and loses the min to a later exit, or the max to a
#     smaller entry;
#   * the quotient UNDERFLOWS to zero, and its sign is all that is left: a zero crossing
#     reads the same whether it is exact (p = q, the origin on that plane) or the rounding
#     of a crossing truly behind the origin (-0) or ahead of it (+0), and no f64 compare
#     tells -0 from +0, so an exit at -2^-2074 read as the hit t = 0. Crossings that land
#     among the subnormals keep their sign but round on the absolute 2^-1074 grid, so two
#     of them a factor of two apart can read equal.
# _bvh_ray_hits_aabb (src/geo_advanced.cyr) settles the same class through its own
# extended-real copy; modules cannot share `_` names, so this is geo.cyr's. The slab
# routines keep their double arithmetic and send a box here only when a reading can
# be one of these (an exit read +Inf, an entry read +Inf, or the t that decides the
# answer is zero or subnormal) and every slab input is finite. Here each crossing is
# an extended real: the same two roundings as the double (RN(p - q), formed as
# p/2 - q/2 one binade up when it overflows, and one correctly rounded quotient of the
# mantissas) with an unbounded exponent, so two crossings order exactly as their
# double values would with no overflow and no underflow. The t returned is the
# selected crossing's double, RN(RN(p - q) / d), the value the slab code forms
# wherever p - q does not overflow.

# The exponent field and the [1, 2) mantissa (as f64 bits) of a finite non-zero x,
# subnormals normalised; written to p[0], p[1] with p[0] the unbiased exponent.
fn _geo_frexp(x, p) {
    var a = x & 0x7FFF_FFFF_FFFF_FFFF;
    var e = a >> 52;
    var adj = 0;
    if (e == 0) {
        a = f64_mul(a, 0x43F0_0000_0000_0000) & 0x7FFF_FFFF_FFFF_FFFF;   # * 2^64, exact
        e = a >> 52;
        adj = 64;
    }
    store64(p, e - 1023 - adj);
    store64(p + 8, (a & 0x000F_FFFF_FFFF_FFFF) | 0x3FF0_0000_0000_0000);
    return 0;
}

# The crossing (p - q) / d, for finite p, q and a finite non-zero d, as an extended
# real at x: x[0] the class (0 zero, 1 positive, -1 negative), x[8] a binary exponent E
# and x[16] a mantissa m in [1, 2), the value m * 2^E. p - q rounds once; when it
# overflows it is p/2 - q/2 with E one higher: one of the two is then at least 2^1023
# and halves exactly, and a subnormal last bit the other may drop is below half an ulp
# of the difference, so the rounding is the same. ⚠ Not p/2 - q/2 always: halving a
# subnormal can be the whole difference (2^-1074 - 0 halves to 0).
fn _geo_xcross(p, q, d, x) {
    var n = f64_sub(p, q);
    var eh = 0;
    if ((n & 0x7FFF_FFFF_FFFF_FFFF) == 0x7FF0_0000_0000_0000) {
        n = f64_sub(f64_mul(p, F64_HALF), f64_mul(q, F64_HALF));
        eh = 1;
    }
    store64(x + 8, 0);
    store64(x + 16, 0);
    if (f64_eq(n, 0) == 1) {
        store64(x, 0);
        return 0;
    }
    var fnum[16];
    var fden[16];
    _geo_frexp(n, &fnum);
    _geo_frexp(d, &fden);
    var m = f64_div(load64(&fnum + 8), load64(&fden + 8));
    var e = load64(&fnum) - load64(&fden) + eh;
    if (f64_lt(m, F64_ONE) == 1) {
        m = f64_mul(m, F64_TWO);
        e = e - 1;
    }
    var sg = 1;
    if (f64_lt(n, 0) == 1) { sg = 0 - sg; }
    if (f64_lt(d, 0) == 1) { sg = 0 - sg; }
    store64(x, sg);
    store64(x + 8, e);
    store64(x + 16, m);
    return 0;
}

# -1, 0 or 1 as the extended crossing at a is below, equal to or above the one at b.
# Classes -2 and 2 are the -Inf / +Inf start values of the running entry and exit.
# The order of two NEGATIVE crossings never reaches the answer (an entry behind the origin
# is never returned, and an exit behind it is the miss by its class alone), so a mutant
# that drops the `ca < 0` flip survives as equivalent; it is kept so the order is true.
# [measured: C336 final mutation run on tests/modules.tcyr, 2026-10-11; cycc 6.6.14]
fn _geo_xcmp(a, b) {
    var ca = load64(a);
    var cb = load64(b);
    if (ca != cb) {
        if (ca < cb) { return 0 - 1; }
        return 1;
    }
    if (ca == 0 || ca == 2 || ca == 0 - 2) { return 0; }
    var r = 0;
    var ea = load64(a + 8);
    var eb = load64(b + 8);
    if (ea < eb) { r = 0 - 1; }
    elif (ea > eb) { r = 1; }
    elif (f64_lt(load64(a + 16), load64(b + 16)) == 1) { r = 0 - 1; }
    elif (f64_gt(load64(a + 16), load64(b + 16)) == 1) { r = 1; }
    if (ca < 0) { r = 0 - r; }
    return r;
}

# The double the slab code forms for (p - q) / d, RN(RN(p - q) / d), also where p - q
# overflows: then (p/2 - q/2) / d is at least 1/2 in magnitude, so doubling it is exact
# and the value is the one an unbounded exponent would give (+-Inf when the crossing
# itself is past DBL_MAX).
fn _geo_cross_dbl(p, q, d) {
    var n = f64_sub(p, q);
    if ((n & 0x7FFF_FFFF_FFFF_FFFF) == 0x7FF0_0000_0000_0000) {
        return f64_mul(f64_div(f64_sub(f64_mul(p, F64_HALF), f64_mul(q, F64_HALF)), d), F64_TWO);
    }
    return f64_div(n, d);
}

# The slab answer from extended crossings. `s` holds three slabs of five words,
# (p1, q1, p2, q2, d): the min-side crossing (p1 - q1) / d is face 2k, the max-side one
# (p2 - q2) / d face 2k + 1; a slab with d = 0 is parallel and read here as the slab
# code reads it, because a box can be sent here from an earlier slab's miss test before
# the later slabs were read. Every word is finite. The face, tie and t rules are the slab code's,
# step for step, with each double compare replaced by the extended one: the swap, the
# strict-increase face and the equal-value tie per slab, the t_min = t_max tie, and the
# return of the entry when it is at or after the origin, the exit when only that is,
# the miss 0 otherwise. Among tied crossings the t kept is the later slab's, as
# f64_max / f64_min keep it, which only decides the sign of a zero.
fn _geo_slabs_exact(s, out) {
    var te[24];
    var tx[24];
    var c1[24];
    var c2[24];
    store64(&te, 0 - 2);
    store64(&tx, 2);
    var td_min = _GEO_F64_NEG_INF;
    var td_max = _GEO_F64_POS_INF;
    var face_near = GEO_FACE_NONE;
    var face_far  = GEO_FACE_NONE;
    var tie_near = 0;
    var tie_far  = 0;
    for (var k = 0; k < 3; k = k + 1) {
        var b = s + k * 40;
        var d = load64(b + 32);
        if (f64_eq(d, 0) == 1) {
            # A parallel slab misses when the origin is outside it: both differences of
            # one strict sign (their rounding keeps the sign). The caller may send the box
            # here from a slab before this one, so this slab is read here too.
            var n1 = f64_sub(load64(b), load64(b + 8));
            var n2 = f64_sub(load64(b + 16), load64(b + 24));
            if (f64_gt(n1, 0) == 1) { if (f64_gt(n2, 0) == 1) { return 0; } }
            if (f64_lt(n1, 0) == 1) { if (f64_lt(n2, 0) == 1) { return 0; } }
        } else {
            var t1 = _geo_cross_dbl(load64(b), load64(b + 8), d);
            var t2 = _geo_cross_dbl(load64(b + 16), load64(b + 24), d);
            _geo_xcross(load64(b), load64(b + 8), d, &c1);
            _geo_xcross(load64(b + 16), load64(b + 24), d, &c2);
            var lo = &c1;
            var hi = &c2;
            var f1 = 2 * k;
            var f2 = 2 * k + 1;
            if (_geo_xcmp(&c1, &c2) > 0) {
                lo = &c2;
                hi = &c1;
                var tt = t1; t1 = t2; t2 = tt;
                f1 = 2 * k + 1;
                f2 = 2 * k;
            }
            var r = _geo_xcmp(lo, &te);
            if (r >= 0) {
                if (r > 0) {
                    store64(&te, load64(lo));
                    store64(&te + 8, load64(lo + 8));
                    store64(&te + 16, load64(lo + 16));
                    face_near = f1;
                    tie_near = 0;
                } else { tie_near = 1; }
                td_min = t1;
            }
            r = _geo_xcmp(hi, &tx);
            if (r <= 0) {
                if (r < 0) {
                    store64(&tx, load64(hi));
                    store64(&tx + 8, load64(hi + 8));
                    store64(&tx + 16, load64(hi + 16));
                    face_far = f2;
                    tie_far = 0;
                } else { tie_far = 1; }
                td_max = t2;
            }
        }
    }
    var rr = _geo_xcmp(&te, &tx);
    if (rr > 0) { return 0; }
    if (rr == 0) { tie_near = 1; tie_far = 1; }
    if (load64(&te) >= 0) {
        if (f64_eq(f64_abs(td_min), _GEO_F64_POS_INF) == 1) { return 0; }
        if (out != 0) { store64(out, face_near); store64(out + 8, tie_near); }
        return td_min;
    }
    if (load64(&tx) >= 0) {
        if (f64_eq(f64_abs(td_max), _GEO_F64_POS_INF) == 1) { return 0; }
        if (out != 0) { store64(out, face_far); store64(out + 8, tie_far); }
        return td_max;
    }
    return 0;
}

# 1 when a slab's crossing nlo / d or nhi / d is zero or subnormal although its numerator is
# not 0, the crossing then having underflowed (3.3.6). A t_min or t_max that reads zero or
# subnormal sends the box to the exact order only when some crossing did: a numerator of 0
# (the origin on that face's plane, b - o = 0 exactly) is the crossing 0 exactly, and with
# none underflowed every zero or subnormal reading is exact and every other one at least
# 2^-1022, so the order holds. (Through round 2 every zero reading took the exact order, an
# origin on a face, the contact, on every call.) d = 0 is a parallel slab, which crosses
# nothing.
fn _geo_slab_uf(nlo, nhi, d) {
    if (f64_eq(d, 0) == 1) { return 0; }
    if (f64_eq(nlo, 0) == 0) {
        if ((f64_div(nlo, d) & 0x7FFF_FFFF_FFFF_FFFF) < 0x0010_0000_0000_0000) { return 1; }
    }
    if (f64_eq(nhi, 0) == 0) {
        if ((f64_div(nhi, d) & 0x7FFF_FFFF_FFFF_FFFF) < 0x0010_0000_0000_0000) { return 1; }
    }
    return 0;
}

# _geo_slab_uf over the box's three slabs (the crossings formed again from the ray and the
# box: the tail that asks is rare, and the slab code's own locals kept for it would hold
# registers through the common path).
fn _geo_ray_aabb_uf(ray, aabb) {
    var o = GeoRay_origin(ray);
    var d = GeoRay_direction(ray);
    var lo = GeoAabb_min(aabb);
    var hi = GeoAabb_max(aabb);
    var uf = _geo_slab_uf(f64_sub(HVec3_x(lo), HVec3_x(o)), f64_sub(HVec3_x(hi), HVec3_x(o)), HVec3_x(d));
    uf = uf | _geo_slab_uf(f64_sub(HVec3_y(lo), HVec3_y(o)), f64_sub(HVec3_y(hi), HVec3_y(o)), HVec3_y(d));
    uf = uf | _geo_slab_uf(f64_sub(HVec3_z(lo), HVec3_z(o)), f64_sub(HVec3_z(hi), HVec3_z(o)), HVec3_z(d));
    return uf;
}

# 1 when all twelve of the ray's and the box's inputs are finite (_geo_hvec3_nonfinite is
# the house test). Only a box whose inputs are all finite is sent to _geo_slabs_exact:
# a non-finite input keeps the slab code's 3.3.5 answer (the open non-finite contract
# row).
fn _geo_ray_aabb_finite(ray, aabb) {
    if (_geo_hvec3_nonfinite(GeoRay_origin(ray)) == 1) { return 0; }
    if (_geo_hvec3_nonfinite(GeoRay_direction(ray)) == 1) { return 0; }
    if (_geo_hvec3_nonfinite(GeoAabb_min(aabb)) == 1) { return 0; }
    if (_geo_hvec3_nonfinite(GeoAabb_max(aabb)) == 1) { return 0; }
    return 1;
}

# geo_ray_aabb_face's answer from _geo_slabs_exact: the crossings (min_k - o_k) / d_k and
# (max_k - o_k) / d_k of each axis.
fn _geo_ray_aabb_exact(ray, aabb, out) {
    var o = GeoRay_origin(ray);
    var d = GeoRay_direction(ray);
    var lo = GeoAabb_min(aabb);
    var hi = GeoAabb_max(aabb);
    var s[120];
    store64(&s, HVec3_x(lo));
    store64(&s + 8, HVec3_x(o));
    store64(&s + 16, HVec3_x(hi));
    store64(&s + 24, HVec3_x(o));
    store64(&s + 32, HVec3_x(d));
    store64(&s + 40, HVec3_y(lo));
    store64(&s + 48, HVec3_y(o));
    store64(&s + 56, HVec3_y(hi));
    store64(&s + 64, HVec3_y(o));
    store64(&s + 72, HVec3_y(d));
    store64(&s + 80, HVec3_z(lo));
    store64(&s + 88, HVec3_z(o));
    store64(&s + 96, HVec3_z(hi));
    store64(&s + 104, HVec3_z(o));
    store64(&s + 112, HVec3_z(d));
    return _geo_slabs_exact(&s, out);
}

# ⛔ 3.3.5 — AN INFINITE ORIGIN WITH 0 < |d_k| < DBL_MIN TAKES THE PARALLEL BRANCH, as
# every |d_k| below DBL_MIN did in 3.3.4. A finite origin's slab now crosses such a d_k,
# (bound - o) / d_k; an infinite origin's crossings are only +-Inf or Inf - Inf, and the
# parallel tests read exactly what they would say: a miss when the origin is outside
# the slab (read sorted, AN INVERTED BOX, above), the slab skipped when the origin lies
# on a bound of the same infinity, and the slab's own NaN first. Crossing it instead
# gave two infinite t of one sign, which the slab's miss test reads as a tie, and a
# later slab's Inf - Inf NaN then reported a hit: 11 hits where 3.3.4 missed, and 342
# NaN t with another NaN's payload, in 60000 rays with one or two infinite origin
# coordinates. Now 180000 such rays differ from 3.3.4 only in a 1-ulp t (the division).
# [measured: second G1 review's infinite-origin sweep, seeds 61-63, 3.3.4/round 2/this tree, 2026-10-11; cycc 6.6.14]
# ⚠ ONLY BELOW DBL_MIN, so that no answer moves from 3.3.4. Through a normal d_k the
# Inf - Inf crossing is left to the slab arithmetic, pinned since 3.3.3 ("a NaN made
# from input with no NaN"), which answers by the order of the stored bounds and the
# sign of d_k: on the box [-0.16, +Inf] from x = +Inf, the y slab's hit along +x and a
# miss along -x. Which answer that class should have is the open non-finite contract
# row, not decided here. The test is inline with its integer half first, so a finite
# origin pays one AND and one compare per slab and no call. _bvh_ray_hits_aabb holds
# the slab for every finite d_k.
# [measured: G1 review probe, 3.3.4 tree and this one, 2026-10-11; cycc 6.6.14]
# On z, the last slab, crossing an off-bound origin or a NaN bound gives what the
# parallel branch gives (two infinite t of one sign end in the miss, and the slab's
# own first NaN is the first one unread), so those two mutants survive as equivalent.
# [measured: G1 mutation run on tests/modules.tcyr, 2026-10-11; cycc 6.6.14]

public fn geo_ray_aabb_face(ray, aabb, out) {
    var ox = HVec3_x(GeoRay_origin(ray));
    var oy = HVec3_y(GeoRay_origin(ray));
    var oz = HVec3_z(GeoRay_origin(ray));
    var dx = HVec3_x(GeoRay_direction(ray));
    var dy = HVec3_y(GeoRay_direction(ray));
    var dz = HVec3_z(GeoRay_direction(ray));
    var bmin_x = HVec3_x(GeoAabb_min(aabb));
    var bmin_y = HVec3_y(GeoAabb_min(aabb));
    var bmin_z = HVec3_z(GeoAabb_min(aabb));
    var bmax_x = HVec3_x(GeoAabb_max(aabb));
    var bmax_y = HVec3_y(GeoAabb_max(aabb));
    var bmax_z = HVec3_z(GeoAabb_max(aabb));

    var t_min = _GEO_F64_NEG_INF;
    var t_max = _GEO_F64_POS_INF;
    var slabs = 0;
    var face_near = GEO_FACE_NONE;
    var face_far  = GEO_FACE_NONE;
    var tie_near = 0;
    var tie_far  = 0;
    if (out != 0) {
        store64(out, GEO_FACE_NONE);
        store64(out + 8, 0);
    }

    # X slab
    if (f64_eq(dx, 0) == 1 || ((ox & 0x7FFF_FFFF_FFFF_FFFF) == 0x7FF0_0000_0000_0000
        && f64_lt(f64_abs(dx), _GEO_F64_TINY) == 1)) {
        # Parallel: the miss tests are false for a NaN, so the slab's own inputs
        # are tested after them (D034, header). Each reads the slab SORTED: below
        # both bounds, or above both (AN INVERTED BOX, above). For min <= max
        # the inner test is implied by the outer, and for a NaN bound it is false.
        if (f64_lt(ox, bmin_x) == 1) {
            if (f64_ge(ox, bmax_x) == 0) { return _geo_ray_aabb_nan_or_miss(ray, aabb); }
        }
        if (f64_gt(ox, bmax_x) == 1) {
            if (f64_le(ox, bmin_x) == 0) { return _geo_ray_aabb_nan_or_miss(ray, aabb); }
        }
        if (f64_eq(ox, ox) == 0) { return ox; }
        if (f64_eq(bmin_x, bmin_x) == 0) { return bmin_x; }
        if (f64_eq(bmax_x, bmax_x) == 0) { return bmax_x; }
    } else {
        var t1 = f64_div(f64_sub(bmin_x, ox), dx);
        var t2 = f64_div(f64_sub(bmax_x, ox), dx);
        var f1 = 0;
        var f2 = 1;
        if (f64_gt(t1, t2) == 1) {
            var tmp = t1; t1 = t2; t2 = tmp;
            f1 = 1; f2 = 0;
        }
        if (t2 == 0x7FF0_0000_0000_0000) {   # an exit read +Inf (see the tail)
            var xb = bmax_x;
            if (f2 == 0) { xb = bmin_x; }
            if ((f64_sub(xb, ox) & 0x7FFF_FFFF_FFFF_FFFF) == 0x7FF0_0000_0000_0000) {
                if (_geo_ray_aabb_finite(ray, aabb) == 1) { return _geo_ray_aabb_exact(ray, aabb, out); }
            }
        }
        # Face bookkeeping, BEFORE the update so `t_min` still holds the running
        # value: a strict increase means this slab now owns the near face and any
        # earlier tie is void; exact equality means two slabs achieve it, which is
        # an edge or corner hit. f64_max returns `t1` whenever t1 >= t_min, so
        # `f64_gt(t1, t_min)` is exactly "this slab changed the answer".
        if (out != 0) {
            if (f64_gt(t1, t_min) == 1) {
                face_near = f1;
                tie_near = 0;
            }
            else { if (f64_eq(t1, t_min) == 1) { tie_near = 1; } }
            if (f64_lt(t2, t_max) == 1) {
                face_far = f2;
                tie_far = 0;
            }
            else { if (f64_eq(t2, t_max) == 1) { tie_far = 1; } }
        }
        t_min = f64_max(t_min, t1);
        t_max = f64_min(t_max, t2);
        slabs = slabs + 1;
        # NaN-true: t_min < t_max fails for the miss, for the tie (which falls
        # through) and for a NaN this slab read, which leaves as t (D034, header).
        # On the first slab the miss arm cannot fire: t1 <= t2 after the swap.
        if (f64_lt(t_min, t_max) == 0) {
            if (f64_gt(t_min, t_max) == 1) { return _geo_ray_aabb_nan_or_miss(ray, aabb); }
            if (f64_eq(t_min, t_max) == 0) {
                var nn = _geo_ray_aabb_nan_or_miss(ray, aabb);
                if (nn != 0) { return nn; }
            }
        }
    }

    # Y slab
    if (f64_eq(dy, 0) == 1 || ((oy & 0x7FFF_FFFF_FFFF_FFFF) == 0x7FF0_0000_0000_0000
        && f64_lt(f64_abs(dy), _GEO_F64_TINY) == 1)) {
        if (f64_lt(oy, bmin_y) == 1) {
            if (f64_ge(oy, bmax_y) == 0) { return _geo_ray_aabb_nan_or_miss(ray, aabb); }
        }
        if (f64_gt(oy, bmax_y) == 1) {
            if (f64_le(oy, bmin_y) == 0) { return _geo_ray_aabb_nan_or_miss(ray, aabb); }
        }
        if (f64_eq(oy, oy) == 0) { return oy; }
        if (f64_eq(bmin_y, bmin_y) == 0) { return bmin_y; }
        if (f64_eq(bmax_y, bmax_y) == 0) { return bmax_y; }
    } else {
        var t1 = f64_div(f64_sub(bmin_y, oy), dy);
        var t2 = f64_div(f64_sub(bmax_y, oy), dy);
        var f1 = 2;
        var f2 = 3;
        if (f64_gt(t1, t2) == 1) {
            var tmp = t1; t1 = t2; t2 = tmp;
            f1 = 3; f2 = 2;
        }
        if (t2 == 0x7FF0_0000_0000_0000) {   # an exit read +Inf (see the tail)
            var xb = bmax_y;
            if (f2 == 2) { xb = bmin_y; }
            if ((f64_sub(xb, oy) & 0x7FFF_FFFF_FFFF_FFFF) == 0x7FF0_0000_0000_0000) {
                if (_geo_ray_aabb_finite(ray, aabb) == 1) { return _geo_ray_aabb_exact(ray, aabb, out); }
            }
        }
        # Face bookkeeping, BEFORE the update so `t_min` still holds the running
        # value: a strict increase means this slab now owns the near face and any
        # earlier tie is void; exact equality means two slabs achieve it, which is
        # an edge or corner hit. f64_max returns `t1` whenever t1 >= t_min, so
        # `f64_gt(t1, t_min)` is exactly "this slab changed the answer".
        if (out != 0) {
            if (f64_gt(t1, t_min) == 1) {
                face_near = f1;
                tie_near = 0;
            }
            else { if (f64_eq(t1, t_min) == 1) { tie_near = 1; } }
            if (f64_lt(t2, t_max) == 1) {
                face_far = f2;
                tie_far = 0;
            }
            else { if (f64_eq(t2, t_max) == 1) { tie_far = 1; } }
        }
        t_min = f64_max(t_min, t1);
        t_max = f64_min(t_max, t2);
        slabs = slabs + 1;
        if (f64_lt(t_min, t_max) == 0) {
            if (f64_gt(t_min, t_max) == 1) {
                # An entry read +Inf may be finite (3.3.6, see the tail).
                if (t_min == 0x7FF0_0000_0000_0000) {
                    if (_geo_ray_aabb_finite(ray, aabb) == 1) { return _geo_ray_aabb_exact(ray, aabb, out); }
                }
                return _geo_ray_aabb_nan_or_miss(ray, aabb);
            }
            if (f64_eq(t_min, t_max) == 0) {
                var nn = _geo_ray_aabb_nan_or_miss(ray, aabb);
                if (nn != 0) { return nn; }
            }
        }
    }

    # Z slab
    if (f64_eq(dz, 0) == 1 || ((oz & 0x7FFF_FFFF_FFFF_FFFF) == 0x7FF0_0000_0000_0000
        && f64_lt(f64_abs(dz), _GEO_F64_TINY) == 1)) {
        if (f64_lt(oz, bmin_z) == 1) {
            if (f64_ge(oz, bmax_z) == 0) { return _geo_ray_aabb_nan_or_miss(ray, aabb); }
        }
        if (f64_gt(oz, bmax_z) == 1) {
            if (f64_le(oz, bmin_z) == 0) { return _geo_ray_aabb_nan_or_miss(ray, aabb); }
        }
        if (f64_eq(oz, oz) == 0) { return oz; }
        if (f64_eq(bmin_z, bmin_z) == 0) { return bmin_z; }
        if (f64_eq(bmax_z, bmax_z) == 0) { return bmax_z; }
    } else {
        var t1 = f64_div(f64_sub(bmin_z, oz), dz);
        var t2 = f64_div(f64_sub(bmax_z, oz), dz);
        var f1 = 4;
        var f2 = 5;
        if (f64_gt(t1, t2) == 1) {
            var tmp = t1; t1 = t2; t2 = tmp;
            f1 = 5; f2 = 4;
        }
        if (t2 == 0x7FF0_0000_0000_0000) {   # an exit read +Inf (see the tail)
            var xb = bmax_z;
            if (f2 == 4) { xb = bmin_z; }
            if ((f64_sub(xb, oz) & 0x7FFF_FFFF_FFFF_FFFF) == 0x7FF0_0000_0000_0000) {
                if (_geo_ray_aabb_finite(ray, aabb) == 1) { return _geo_ray_aabb_exact(ray, aabb, out); }
            }
        }
        # Face bookkeeping, BEFORE the update so `t_min` still holds the running
        # value: a strict increase means this slab now owns the near face and any
        # earlier tie is void; exact equality means two slabs achieve it, which is
        # an edge or corner hit. f64_max returns `t1` whenever t1 >= t_min, so
        # `f64_gt(t1, t_min)` is exactly "this slab changed the answer".
        if (out != 0) {
            if (f64_gt(t1, t_min) == 1) {
                face_near = f1;
                tie_near = 0;
            }
            else { if (f64_eq(t1, t_min) == 1) { tie_near = 1; } }
            if (f64_lt(t2, t_max) == 1) {
                face_far = f2;
                tie_far = 0;
            }
            else { if (f64_eq(t2, t_max) == 1) { tie_far = 1; } }
        }
        t_min = f64_max(t_min, t1);
        t_max = f64_min(t_max, t2);
        slabs = slabs + 1;
        if (f64_lt(t_min, t_max) == 0) {
            if (f64_gt(t_min, t_max) == 1) {
                if (t_min == 0x7FF0_0000_0000_0000) {
                    if (_geo_ray_aabb_finite(ray, aabb) == 1) { return _geo_ray_aabb_exact(ray, aabb, out); }
                }
                return 0;
            }
            if (f64_eq(t_min, t_max) == 0) {
                var nn = _geo_ray_aabb_nan_or_miss(ray, aabb);
                if (nn != 0) { return nn; }
            }
        }
    }

    # See the header: every slab parallel means nothing narrowed the interval and
    # the two returns below would hand back +Inf.
    if (slabs == 0) { return 0; }

    # t_min == t_max: ONE test, TWO non-differentiable situations, both of which
    # the per-slab tie above is blind to because it compares near against near
    # and far against far, never t_min against t_max.
    #
    #   TANGENTIAL CLIP -- different slabs own the entry and the exit and they
    #   coincide. The hit sits on the BOUNDARY of the hit set: an arbitrarily
    #   small sideways perturbation makes it a miss.
    #
    #   ZERO-WIDTH SLAB -- min_k == max_k (a flat box, or a zero half-extent).
    #   Then t1 == t2 on that axis, the swap never runs (f64_gt is false on
    #   equality), and the face would be labelled the MIN slot unconditionally --
    #   right only when d_k > 0. For d_k < 0 the whole gradient belongs to the MAX
    #   slot and the jet reported it in the min one with tie = 0. Measured on the
    #   2.10.1 draft: exactly half of all flat-box configurations.
    #   [measured: docs/development/issues/archived/2026-08-10-jet-tie-blind-to-degenerate-slabs.md]
    #
    # ⚠ A SEPARATE per-slab `f64_eq(t1, t2)` guard was written for the second
    # case and then DELETED as dead code: a zero-width slab pins both t_min and
    # t_max to the same value, so it can never fire without this line firing too.
    # Mutation-measured, not argued -- removing the per-slab guard changed
    # nothing, removing this line changed both fixtures.
    # [measured: docs/development/issues/archived/2026-08-10-jet-tie-blind-to-degenerate-slabs.md]
    #
    # Reported rather than relabelled: t is genuinely not two-sided differentiable
    # at either, and for the flat box a central difference averages the two
    # one-sided answers into a number that is neither.
    if (f64_eq(t_min, t_max) == 1) { tie_near = 1; tie_far = 1; }

    # ⛔ 3.3.6 — A READING THAT LOST ITS ORDER IS SETTLED EXACTLY (see "Exact slab
    # ordering" above). Three readings can be wrong on finite input: an exit read +Inf
    # may be a finite crossing whose b - o overflowed (each slab diverts where it reads one
    # whose numerator did; an exit whose quotient alone overflowed is a crossing past
    # DBL_MAX, which +Inf orders right against every finite crossing, so a world box with
    # +-DBL_MAX bounds keeps this arithmetic), an entry read +Inf likewise, and a t_min or
    # t_max that is zero or subnormal may be a crossing that underflowed, whose sign alone
    # survives (an exit at -2^-2074 read -0, which the `< 0` tests below take for t = 0;
    # sent on only when some crossing did underflow, _geo_slab_uf). Each sends the box to
    # _geo_slabs_exact when the twelve inputs are finite; a non-finite input keeps this
    # arithmetic. The common hit path pays one integer compare per crossed slab and one AND
    # and compare here.
    # o = (-2^1023, 0, 0), d = (4, 1, 0) against x [-DBL_MAX, 2^1023], y [1.5 * 2^1022,
    # DBL_MAX] answered 1.5 * 2^1022 on face 2 though x is left at 2^1022, before y is
    # entered; o = 0, d = (2^1000, 1, 0) against x [-1, -2^-1074] answered -0 on face 1
    # for an exit at -2^-2074: both are the miss now. Over 235997 box-ray pairs (two
    # seeds of the slab sweep, with families whose b - o overflows and whose crossings
    # underflow) against an exact rational oracle: 7562 wrong -> right (40 overflow,
    # 5217 underflow, 2305 at random scales), none right -> wrong. 4627 right answers
    # changed bits, all but one at a zero t: 2943 jets of a -0 contact (see "A CONTACT AT
    # t = 0" above) and 1683 ties, faces or zero signs that the exact order settles; the
    # one, t = 2^-1074, lost a tie two subnormal crossings had rounded into. The 8000
    # NaN inputs keep their bits, and of 8000 with an infinity 6 moved, each a -0 jet.
    # _geo_ray_aabb_exact run on every finite pair returns the same t, face and tie.
    # [measured: C336 slab sweep, seeds 11 and 12, exact Fraction oracle, 3.3.5 vs this tree, 2026-10-11; cycc 6.6.14]
    # The contract admits 0 or a positive f64. An overflow in the slab arithmetic
    # can make t infinite from entirely finite inputs, which is not a hit.
    # ⚠ Only +/-Inf. NaN is left to propagate, on purpose -- see the is_inf note by geo_face_axis.
    if (f64_lt(t_min, 0) != 1) {
        var tmn = t_min & 0x7FFF_FFFF_FFFF_FFFF;   # (its bit tests: zero or subnormal, +-Inf)
        if (tmn < 0x0010_0000_0000_0000) {
            if (_geo_ray_aabb_uf(ray, aabb) == 1) {
                if (_geo_ray_aabb_finite(ray, aabb) == 1) { return _geo_ray_aabb_exact(ray, aabb, out); }
            }
        }
        # (An entry read +Inf whose numerator overflowed had its exit's overflow too -- the
        # exit's bound lies beyond the entry's -- and the slab diverted there; an entry whose
        # quotient alone overflowed is a crossing past DBL_MAX, the miss either way.)
        if (tmn == 0x7FF0_0000_0000_0000) { return 0; }
        if (out != 0) { store64(out, face_near); store64(out + 8, tie_near); }
        return t_min;
    }
    if (f64_lt(t_max, 0) != 1) {
        # Origin inside the box: the answer is the EXIT face, not the entry one.
        var tmx = t_max & 0x7FFF_FFFF_FFFF_FFFF;
        if (tmx < 0x0010_0000_0000_0000) {
            if (_geo_ray_aabb_uf(ray, aabb) == 1) {
                if (_geo_ray_aabb_finite(ray, aabb) == 1) { return _geo_ray_aabb_exact(ray, aabb, out); }
            }
        }
        if (tmx == 0x7FF0_0000_0000_0000) { return 0; }
        if (out != 0) { store64(out, face_far); store64(out + 8, tie_far); }
        return t_max;
    }
    return 0;
}

# The plain entry point: identical t, no face bookkeeping, out = 0.
public fn geo_ray_aabb(ray, aabb) {
    return geo_ray_aabb_face(ray, aabb, 0);
}

# Ray-triangle intersection (Moller-Trumbore algorithm)
public fn geo_ray_triangle(ray, tri) {
    var edge1 = hvec3_sub(GeoTriangle_v1(tri), GeoTriangle_v0(tri));
    var edge2 = hvec3_sub(GeoTriangle_v2(tri), GeoTriangle_v0(tri));
    var h = hvec3_cross(GeoRay_direction(ray), edge2);
    var a = hvec3_dot(edge1, h);

    # ⛔ `a` is a scalar triple product — degree TWO in the triangle's edge lengths
    # for a unit direction — against an absolute 1e-12, so a small triangle was a
    # silent MISS. Measured: legs 2^-30, a ray through the interior, u = v = 0.25,
    # returns 0 where the answer is t = 1.
    # ⭐ AND THE THRESHOLD IS NOT THE FIX. What fails is `1 / a`, so test THAT:
    # `f64_lt(|f|, +Inf)` is 1 for every finite f and 0 for both +Inf and NaN, so
    # one comparison rejects a = 0, any `a` whose reciprocal overflows, and a NaN
    # triangle — with no scale to choose. ⚠ NOT an exact-zero test like the
    # `1/sqrt(x)` guards above (spelled `f64_gt(x, 0) == 0` through 3.3.2 and
    # `f64_eq(x, 0)` since): sqrt of any non-zero double is normal, but a
    # RECIPROCAL overflows for subnormal a, and an exact-zero test returns +Inf
    # here on a corner-on ray where u and v are NaN and the [0,1] tests cannot
    # reject it.
    # [measured: 7-point bracket x 5 mutants; DBL_MIN fails 2 of 7, this fails 0]
    var f = f64_div(F64_ONE, a);
    if (f64_lt(f64_abs(f), _GEO_F64_POS_INF) == 0) { return 0; }
    var s = hvec3_sub(GeoRay_origin(ray), GeoTriangle_v0(tri));
    var u = f64_mul(f, hvec3_dot(s, h));

    if (f64_lt(u, 0) == 1) { return 0; }
    if (f64_gt(u, F64_ONE) == 1) { return 0; }

    var q = hvec3_cross(s, edge1);
    var v = f64_mul(f, hvec3_dot(GeoRay_direction(ray), q));

    if (f64_lt(v, 0) == 1) { return 0; }
    if (f64_gt(f64_add(u, v), F64_ONE) == 1) { return 0; }

    var t = f64_mul(f, hvec3_dot(edge2, q));
    if (f64_lt(t, 0) == 1) { return 0; }
    return t;
}

# Fills `s` with geo_ray_obb_face's three slabs for _geo_slabs_exact, in the box's frame:
# the crossings (e_k - he_k) / f_k and (e_k + he_k) / f_k, with e_k = a_k . (c - o) and
# f_k = a_k . d formed exactly as the slab code forms them. 1 when all nine of e, f and
# he are finite, else 0 and the slab code's answer stands (an e that overflowed, or the
# 0 * Inf NaN of the header, is the open non-finite contract row).
fn _geo_ray_obb_slabs(ray, obb, s) {
    var d = hvec3_sub(GeoObb_center(obb), GeoRay_origin(ray));
    var axes = geo_obb_axes(obb);
    var he = GeoObb_half_extents(obb);
    for (var k = 0; k < 3; k = k + 1) {
        var ax = load64(axes + k * 8);
        var h = HVec3_x(he);
        if (k == 1) { h = HVec3_y(he); }
        if (k == 2) { h = HVec3_z(he); }
        var e = hvec3_dot(ax, d);
        var f = hvec3_dot(ax, GeoRay_direction(ray));
        if (f64_lt(f64_abs(e), _GEO_F64_POS_INF) == 0) { return 0; }
        if (f64_lt(f64_abs(f), _GEO_F64_POS_INF) == 0) { return 0; }
        if (f64_lt(f64_abs(h), _GEO_F64_POS_INF) == 0) { return 0; }
        var b = s + k * 40;
        store64(b, e);
        store64(b + 8, h);
        store64(b + 16, e);
        store64(b + 24, f64_neg(h));
        store64(b + 32, f);
    }
    return 1;
}

# Ray-OBB intersection (slab test in OBB local space)
#
# DEGENERATE DIRECTION, repaired 2.10.1 -- the same defect as geo_ray_aabb above
# and repaired the same way. When every local axis has |a_k . d| below
# EPSILON_F64 no slab narrows the interval, and the tail returned +Inf where the
# module contract says 0. See the geo_ray_aabb header for why the guard counts
# contributing slabs instead of testing |d| up front.
# [measured: tests/modules.tcyr "2.10.1 degenerate-direction contract"]
#
# ⛔ 3.3.4 — A NEGATIVE HALF-EXTENT IS ITS MAGNITUDE, ON EVERY RAY (roadmap D035).
# A slab the ray crosses solves a.(p - c) = -he and = +he and sorts the two t, so
# it has always read he = -1 as the slab |he| = 1, while the parallel branch tested
# -e - he > 0 and -e + he < 0 and read the same box as EMPTY: one OBB was solid to
# an oblique ray and missed by an axial one. The parallel branch now takes |he| as
# well. That is the reading the crossing slabs, the face labels and the jet already
# give a signed he (face 0 is the plane a.(p - c) = -he, and dt/dhe = sign/f_k
# differentiates exactly that plane), so only the axial rays move, and they move to
# what an oblique ray already answered. The alternative, a negative extent as an
# empty box, needed a test on every crossing slab of every ray. Over 2500 random
# OBBs and rays, each with the seven sign patterns of he, t matches the |he| box in
# 17500 of 17500 (1040 moved, every one an axial ray from the miss to the |he|
# box's t); on the 1031 identity rotations an exact rational slab oracle of the
# |he| box agrees with 7210 of 7217 answers, the 7 being one configuration that
# 3.3.3 already answered 11 ulp off with he > 0, against 6174 before.
# [measured: georay slab sweep and rational oracle, 3.3.3 geo.cyr vs repaired, not in-tree, 2026-10-03; cycc 6.6.14]
# geo_ray_aabb_face split the same way on a box INVERTED through the setters (min
# above max): min (1,1,1), max (0,0,0) answered 4.5 * sqrt3 to the ray from
# (-4.5,-4.5,-4.5) along (1,1,1)/sqrt3 and the miss to (-5,0.5,0.5) along +x. It now
# reads such a box sorted, as this reads |he| (see "AN INVERTED BOX" above it).
# [measured: georay inverted-AABB probe, 3.3.4 tree, not in-tree, 2026-10-03; cycc 6.6.14]
#
# ⛔ 3.3.6 — THE OBB SLABS HAD THE AABB'S 3.3.4 SHAPE: |f_k| < DBL_MIN read as parallel and
# each crossing (e -+ he) * RN(1/f_k), rounded twice. A centre (1.5, 0, 0) with
# half-extents (0.5, 2^1008, 0.5) and the ray from x = 1 - 2^-40 along (2^-1030, 1, 0),
# which enters the x slab at t = 2^990, answered the miss 0. The parallel test is now
# f_k = 0 exactly and each crossing one quotient (e -+ he) / f_k, as geo_ray_aabb_face
# has had since 3.3.5; an infinite e against a subnormal f_k stays parallel, as an
# infinite origin does there, so no infinite-input answer moves for it. A NaN f_k is not
# 0 and keeps the slab arithmetic, the NaN routing the old `!= 1` spelling had, and a
# negative half-extent still reads as |he|. Crossings that overflow or underflow are
# then ordered exactly (_geo_slabs_exact, through _geo_ray_obb_slabs) when e, f and he
# are finite on every axis. Over 182000 OBB-ray pairs (two seeds: random frames, a
# subnormal f_k, e -+ he past DBL_MAX, underflowing crossings, contacts) against an exact
# rational slab oracle on the e, f and he the code forms: 5622 wrong -> right, none right
# -> wrong; correctly rounded t went from 13397 to 16852 of 18700 hits and the largest
# error of a right answer from 1.96 to 1.40 ulp. The 8000 NaN inputs keep D034's contract
# bit for bit; of 8000 with an infinity, 40 moved. On the C1 review's OBB sweep (7499
# pairs with an infinity) 91 moved: 82 by a 1-ulp t from the division, 9 in verdict or face
# (contacts with an infinite half-extent now crossed, and zero-width near-ties, by the
# review's reading). A hit whose 1 / f_k overflows is the jet's miss, as for the AABB.
# [measured: C336 OBB sweep, seeds 21 and 22, exact Fraction oracle, 3.3.5 vs this tree, 2026-10-11; cycc 6.6.14]
# [measured: C336 run of the C1 review's OBB sweep, seed 311, 3.3.5 vs this tree, 2026-10-11; cycc 6.6.14]
public fn geo_ray_obb_face(ray, obb, out) {
    var d = hvec3_sub(GeoObb_center(obb), GeoRay_origin(ray));
    var axes = geo_obb_axes(obb);
    var he = GeoObb_half_extents(obb);

    var t_min = _GEO_F64_NEG_INF;
    var t_max = _GEO_F64_POS_INF;
    var slabs = 0;
    var face_near = GEO_FACE_NONE;
    var face_far  = GEO_FACE_NONE;
    var tie_near = 0;
    var tie_far  = 0;
    var s[120];    # the three slabs for _geo_slabs_exact
    if (out != 0) {
        store64(out, GEO_FACE_NONE);
        store64(out + 8, 0);
    }

    # Axis 0
    var ax0 = load64(axes);
    var he0 = HVec3_x(he);
    var e0 = hvec3_dot(ax0, d);
    var f0 = hvec3_dot(ax0, GeoRay_direction(ray));
    if (f64_eq(f0, 0) == 0 && ((e0 & 0x7FFF_FFFF_FFFF_FFFF) < 0x7FF0_0000_0000_0000
        || f64_lt(f64_abs(f0), _GEO_F64_TINY) == 0)) {
        # t1 solves a.(p - c) = -he (the min-side face), t2 the +he face --
        # before the swap, which reorders them when the ray runs down the axis.
        var t1 = f64_div(f64_sub(e0, he0), f0);
        var t2 = f64_div(f64_add(e0, he0), f0);
        var g1 = 0;
        var g2 = 1;
        if (f64_gt(t1, t2) == 1) {
            var tmp = t1; t1 = t2; t2 = tmp;
            g1 = 1; g2 = 0;
        }
        if (t2 == 0x7FF0_0000_0000_0000) {   # an exit read +Inf (see geo_ray_aabb_face)
            var xn = f64_add(e0, he0);
            if (g2 == 0) { xn = f64_sub(e0, he0); }
            if ((xn & 0x7FFF_FFFF_FFFF_FFFF) == 0x7FF0_0000_0000_0000) {
                if (_geo_ray_obb_slabs(ray, obb, &s) == 1) { return _geo_slabs_exact(&s, out); }
            }
        }
        # Face bookkeeping -- see geo_ray_aabb_face; identical rule, local axes.
        if (out != 0) {
            if (f64_gt(t1, t_min) == 1) {
                face_near = g1;
                tie_near = 0;
            }
            else { if (f64_eq(t1, t_min) == 1) { tie_near = 1; } }
            if (f64_lt(t2, t_max) == 1) {
                face_far = g2;
                tie_far = 0;
            }
            else { if (f64_eq(t2, t_max) == 1) { tie_far = 1; } }
        }
        t_min = f64_max(t_min, t1);
        t_max = f64_min(t_max, t2);
        slabs = slabs + 1;
        # As in geo_ray_aabb_face. A miss before axis 2 can only have skipped a NaN
        # in a later half-extent: e0 and f0 read every origin, centre, direction and
        # rotation component (0 * NaN is NaN), so those are NaN here already. For the
        # same reason each parallel e test below is masked by the others for a NaN
        # INPUT (only all three together are not, at a zero direction). A NaN e1 or
        # e2 made from infinite input (0 * Inf) has no NaN to find and falls through.
        if (f64_lt(t_min, t_max) == 0) {
            if (f64_gt(t_min, t_max) == 1) { return _geo_hvec3_nan(he); }
            if (f64_eq(t_min, t_max) == 0) {
                var nn = _geo_ray_obb_nan(ray, obb);
                if (nn != 0) { return nn; }
            }
        }
    } else {
        # Ray parallel to slab -- check if origin is outside
        # Rust: (-e - he) > 0 || (-e + he) < 0, with |he| since 3.3.4 (D035, header)
        var neg_e0 = f64_neg(e0);
        var ahe0 = f64_abs(he0);
        if (f64_gt(f64_sub(neg_e0, ahe0), 0) == 1) { return _geo_hvec3_nan(he); }
        if (f64_lt(f64_add(neg_e0, ahe0), 0) == 1) { return _geo_hvec3_nan(he); }
        if (f64_eq(e0, e0) == 0) {
            var ne0 = _geo_ray_obb_nan(ray, obb);
            if (ne0 != 0) { return ne0; }
        }
        if (f64_eq(he0, he0) == 0) { return he0; }
    }

    # Axis 1
    var ax1 = load64(axes + 8);
    var he1 = HVec3_y(he);
    var e1 = hvec3_dot(ax1, d);
    var f1 = hvec3_dot(ax1, GeoRay_direction(ray));
    if (f64_eq(f1, 0) == 0 && ((e1 & 0x7FFF_FFFF_FFFF_FFFF) < 0x7FF0_0000_0000_0000
        || f64_lt(f64_abs(f1), _GEO_F64_TINY) == 0)) {
        # t1 solves a.(p - c) = -he (the min-side face), t2 the +he face --
        # before the swap, which reorders them when the ray runs down the axis.
        var t1 = f64_div(f64_sub(e1, he1), f1);
        var t2 = f64_div(f64_add(e1, he1), f1);
        var g1 = 2;
        var g2 = 3;
        if (f64_gt(t1, t2) == 1) {
            var tmp = t1; t1 = t2; t2 = tmp;
            g1 = 3; g2 = 2;
        }
        if (t2 == 0x7FF0_0000_0000_0000) {   # an exit read +Inf (see geo_ray_aabb_face)
            var xn = f64_add(e1, he1);
            if (g2 == 2) { xn = f64_sub(e1, he1); }
            if ((xn & 0x7FFF_FFFF_FFFF_FFFF) == 0x7FF0_0000_0000_0000) {
                if (_geo_ray_obb_slabs(ray, obb, &s) == 1) { return _geo_slabs_exact(&s, out); }
            }
        }
        # Face bookkeeping -- see geo_ray_aabb_face; identical rule, local axes.
        if (out != 0) {
            if (f64_gt(t1, t_min) == 1) {
                face_near = g1;
                tie_near = 0;
            }
            else { if (f64_eq(t1, t_min) == 1) { tie_near = 1; } }
            if (f64_lt(t2, t_max) == 1) {
                face_far = g2;
                tie_far = 0;
            }
            else { if (f64_eq(t2, t_max) == 1) { tie_far = 1; } }
        }
        t_min = f64_max(t_min, t1);
        t_max = f64_min(t_max, t2);
        slabs = slabs + 1;
        if (f64_lt(t_min, t_max) == 0) {
            if (f64_gt(t_min, t_max) == 1) { return _geo_hvec3_nan(he); }
            if (f64_eq(t_min, t_max) == 0) {
                var nn = _geo_ray_obb_nan(ray, obb);
                if (nn != 0) { return nn; }
            }
        }
    } else {
        var neg_e1 = f64_neg(e1);
        var ahe1 = f64_abs(he1);
        if (f64_gt(f64_sub(neg_e1, ahe1), 0) == 1) { return _geo_hvec3_nan(he); }
        if (f64_lt(f64_add(neg_e1, ahe1), 0) == 1) { return _geo_hvec3_nan(he); }
        if (f64_eq(e1, e1) == 0) {
            var ne1 = _geo_ray_obb_nan(ray, obb);
            if (ne1 != 0) { return ne1; }
        }
        if (f64_eq(he1, he1) == 0) { return he1; }
    }

    # Axis 2
    var ax2 = load64(axes + 16);
    var he2 = HVec3_z(he);
    var e2 = hvec3_dot(ax2, d);
    var f2 = hvec3_dot(ax2, GeoRay_direction(ray));
    if (f64_eq(f2, 0) == 0 && ((e2 & 0x7FFF_FFFF_FFFF_FFFF) < 0x7FF0_0000_0000_0000
        || f64_lt(f64_abs(f2), _GEO_F64_TINY) == 0)) {
        # t1 solves a.(p - c) = -he (the min-side face), t2 the +he face --
        # before the swap, which reorders them when the ray runs down the axis.
        var t1 = f64_div(f64_sub(e2, he2), f2);
        var t2 = f64_div(f64_add(e2, he2), f2);
        var g1 = 4;
        var g2 = 5;
        if (f64_gt(t1, t2) == 1) {
            var tmp = t1; t1 = t2; t2 = tmp;
            g1 = 5; g2 = 4;
        }
        if (t2 == 0x7FF0_0000_0000_0000) {   # an exit read +Inf (see geo_ray_aabb_face)
            var xn = f64_add(e2, he2);
            if (g2 == 4) { xn = f64_sub(e2, he2); }
            if ((xn & 0x7FFF_FFFF_FFFF_FFFF) == 0x7FF0_0000_0000_0000) {
                if (_geo_ray_obb_slabs(ray, obb, &s) == 1) { return _geo_slabs_exact(&s, out); }
            }
        }
        # Face bookkeeping -- see geo_ray_aabb_face; identical rule, local axes.
        if (out != 0) {
            if (f64_gt(t1, t_min) == 1) {
                face_near = g1;
                tie_near = 0;
            }
            else { if (f64_eq(t1, t_min) == 1) { tie_near = 1; } }
            if (f64_lt(t2, t_max) == 1) {
                face_far = g2;
                tie_far = 0;
            }
            else { if (f64_eq(t2, t_max) == 1) { tie_far = 1; } }
        }
        t_min = f64_max(t_min, t1);
        t_max = f64_min(t_max, t2);
        slabs = slabs + 1;
        if (f64_lt(t_min, t_max) == 0) {
            if (f64_gt(t_min, t_max) == 1) { return 0; }
            if (f64_eq(t_min, t_max) == 0) {
                var nn = _geo_ray_obb_nan(ray, obb);
                if (nn != 0) { return nn; }
            }
        }
    } else {
        var neg_e2 = f64_neg(e2);
        var ahe2 = f64_abs(he2);
        if (f64_gt(f64_sub(neg_e2, ahe2), 0) == 1) { return 0; }
        if (f64_lt(f64_add(neg_e2, ahe2), 0) == 1) { return 0; }
        if (f64_eq(e2, e2) == 0) {
            var ne2 = _geo_ray_obb_nan(ray, obb);
            if (ne2 != 0) { return ne2; }
        }
        if (f64_eq(he2, he2) == 0) { return he2; }
    }

    # See the header: every axis parallel means nothing narrowed the interval.
    if (slabs == 0) { return 0; }

    # Tangential clip and zero half-extent -- see geo_ray_aabb_face for both.
    if (f64_eq(t_min, t_max) == 1) { tie_near = 1; tie_far = 1; }

    # 3.3.6: a reading that lost its order is settled exactly, as in geo_ray_aabb_face,
    # when e, f and he are finite on all three axes (_geo_ray_obb_slabs). Unlike the
    # AABB's b - o, no entry can read +Inf from an overflowed numerator: with e finite,
    # e - |he| cannot pass +DBL_MAX (it can pass -DBL_MAX, e = -1.5 * 2^1023 against
    # he = 1.5 * 2^1023, but an entry read -Inf is behind the origin as its true value
    # is, and only the exit is then returned). So an entry read +Inf is a crossing past
    # DBL_MAX, the miss either way, and the per-axis miss tests need no exact order. An exit
    # read +Inf whose numerator e -+ he overflowed diverts where it is read; a zero or
    # subnormal t_min or t_max only when a crossing underflowed (_geo_slab_uf).

    # See geo_ray_aabb_face: 0 or a positive FINITE t, nothing else.
    if (f64_lt(t_min, 0) != 1) {
        var tmn = t_min & 0x7FFF_FFFF_FFFF_FFFF;
        if (tmn < 0x0010_0000_0000_0000) {
            var uf = _geo_slab_uf(f64_sub(e0, he0), f64_add(e0, he0), f0);
            uf = uf | _geo_slab_uf(f64_sub(e1, he1), f64_add(e1, he1), f1);
            uf = uf | _geo_slab_uf(f64_sub(e2, he2), f64_add(e2, he2), f2);
            if (uf == 1) {
                if (_geo_ray_obb_slabs(ray, obb, &s) == 1) { return _geo_slabs_exact(&s, out); }
            }
        }
        if (tmn == 0x7FF0_0000_0000_0000) { return 0; }
        if (out != 0) { store64(out, face_near); store64(out + 8, tie_near); }
        return t_min;
    }
    if (f64_lt(t_max, 0) != 1) {
        # Origin inside the box: the EXIT face, not the entry one.
        var tmx = t_max & 0x7FFF_FFFF_FFFF_FFFF;
        if (tmx < 0x0010_0000_0000_0000) {
            var uf2 = _geo_slab_uf(f64_sub(e0, he0), f64_add(e0, he0), f0);
            uf2 = uf2 | _geo_slab_uf(f64_sub(e1, he1), f64_add(e1, he1), f1);
            uf2 = uf2 | _geo_slab_uf(f64_sub(e2, he2), f64_add(e2, he2), f2);
            if (uf2 == 1) {
                if (_geo_ray_obb_slabs(ray, obb, &s) == 1) { return _geo_slabs_exact(&s, out); }
            }
        }
        if (tmx == 0x7FF0_0000_0000_0000) { return 0; }
        if (out != 0) { store64(out, face_far); store64(out + 8, tie_far); }
        return t_max;
    }
    return 0;
}

# The plain entry point: identical t, no face bookkeeping, out = 0.
public fn geo_ray_obb(ray, obb) {
    return geo_ray_obb_face(ray, obb, 0);
}

# The barrel hit's fraction along the axis, (w . u) / uu times 2^eu, for the u-form axis of
# geo_ray_capsule_branch (u = 2^eu ab, 3.3.6), with w = p - st (halved when that overflows,
# as it can between ends more than DBL_MAX apart). w is taken to unit size first: w . u
# overflows for a hit far along such a capsule (the barrel at t = 2 between (-0.9, 0, 0) *
# DBL_MAX and its mirror read proj = +Inf, and the one-step 2^eu of an earlier draft of
# _geo_ldexp had turned that into a NaN that the proj tests accepted). Powers of two are
# exact, so where nothing overflowed this is the bits of (w . u) / uu * 2^eu.
fn _geo_cap_proj_u(p, st, u, uu, eu) {
    var w = hvec3_sub(p, st);
    if (_geo_hvec3_nonfinite(w) == 1) {
        if (_geo_hvec3_nonfinite(p) + _geo_hvec3_nonfinite(st) == 0) {
            w = hvec3_sub(hvec3_scale(p, F64_HALF), hvec3_scale(st, F64_HALF));
            eu = eu + 1;
        }
    }
    var sw = _geo_scale_for(_geo_absmax_bits(w) >> 52);
    var pr = f64_div(hvec3_dot(hvec3_scale(w, sw), u), uu);
    return _geo_ldexp(pr, eu - ((sw >> 52) - 1023));
}

# The segment coordinate (p - start) . ab / |ab|^2 of a barrel root that overflowed to +Inf
# (3.3.6): o's coordinate (_geo_cap_proj_u, which survives an o - start or a product that
# overflows) plus t (d . u) / uu 2^eu, with t = ts 2^te (ts the finite root before it was
# multiplied back) and d taken to unit size first, so nothing on the way overflows; u is
# 2^eu ab. The hit point o + Inf d the other roots are tested at is infinite or NaN here,
# and the NaN-true tests
# took it: a subnormal d = (2, 3, 6) * 2^-1074 from (2 + 2^-51, 3, 6) against
# (0,0,0)-(0,0,-8), r = 7, read +Inf for an exact miss (3.3.5: 0, its barrel flushed), and
# 3.3.5 itself read +Inf for the miss of (-5, 3, 0) along -2^-1030 (1, 1, 0) against
# (0,0,0)-(10,0,0), r = 1. A coordinate past DBL_MAX is +-Inf, off the segment; a crossing
# on it past DBL_MAX is still the hit +Inf, as for a far sphere.
# [measured: C336 review repros (L1) and its edge family, 3.3.5 vs this tree, 2026-10-11; cycc 6.6.14]
fn _geo_cap_far_proj(ts, te, ray, capsule, u, uu, eu) {
    var dir = GeoRay_direction(ray);
    var s4 = _geo_scale_for(_geo_absmax_bits(dir) >> 52);
    var y = f64_div(f64_mul(ts, hvec3_dot(hvec3_scale(dir, s4), u)), uu);
    var z = _geo_ldexp(y, te - ((s4 >> 52) - 1023) + eu);
    return f64_add(_geo_cap_proj_u(GeoRay_origin(ray), GeoCapsule_start(capsule), u, uu, eu), z);
}

# _geo_cap_accepts for a cap root that overflowed to +Inf (3.3.6): the half-space term
# o_dot + t d_dot is formed from the root of a copy whose direction is taken to unit size
# times 16, t' = t / s (finite), as o_dot + t' (s d) . u, o_dot being 2^oce times its
# value as the caller holds it. With t = +Inf the term read +-Inf or NaN whatever the side:
# a ray from an origin near 2^1001 along a direction near 2^-500 long meets the start cap of a
# capsule near 2^1001 long past DBL_MAX on the cap's own side (exact t 4.3e441), and the cap
# was refused (round 2 answered the +Inf through the barrel, whose crossing is behind the
# start, at the segment coordinate -0.97).
# Finite input only: any other returns -1, and the caller keeps _geo_cap_accepts.
# [measured: C336 review edge family (rnd, k1000), round 2 vs this tree, 2026-10-11; cycc 6.6.14]
fn _geo_cap_far_accepts(ray, sph, u, o_dot, oce, is_end, root_i) {
    if (_geo_sphere_finite(ray, sph) == 0 || _geo_hvec3_nonfinite(u) == 1) { return 0 - 1; }
    var d = GeoRay_direction(ray);
    var r2 = alloc(sizeof(GeoRay));
    GeoRay_set_origin(r2, GeoRay_origin(ray));
    # (In steps: a subnormal d is taken only to [2^-51, 2) by the first, whose factor is then
    # 2^1023 already, so a second takes it to [1, 2) and the third multiplies by 16; t' is then
    # under (|o - c| + r) / 16, finite.)
    var d1 = hvec3_scale(d, _geo_scale_for(_geo_absmax_bits(d) >> 52));
    d1 = hvec3_scale(d1, _geo_scale_for(_geo_absmax_bits(d1) >> 52));
    GeoRay_set_direction(r2, hvec3_scale(d1, 0x4030_0000_0000_0000));   # x 16
    var rt2[16];
    if (_geo_sphere_roots(r2, sph, &rt2) == 0) { return 0; }
    var t2 = load64(&rt2 + root_i * 8);
    return _geo_cap_accepts(_geo_ldexp(t2, oce), o_dot, hvec3_dot(GeoRay_direction(r2), u), is_end);
}

# Ray-capsule intersection
# 1 when root `t` is a real hit on the cap whose plane term is (o_dot, d_dot).
# A cap owns the half-space on its own side of the capsule's end plane: the START
# cap takes points with (p - start) . ab <= 0, the END cap those with
# (p - end) . ab >= 0. Anything else is a point on the cap's SPHERE that is not
# on the capsule.
#
# The test is done in SCALARS. With p = o + t*d,
#     (p - cap_pt) . ab  ==  (o - cap_pt) . ab  +  t * (d . ab)
# so the caller hoists both dot products -- one per cap and one per ray -- and
# this is two arithmetic ops. Materialising the point instead costs a geo_ray_at
# and an hvec3_sub, both of which ALLOCATE, four times per capsule query under an
# allocator that never frees. Measured: it was +92% on `ray_capsule`.
# [measured: docs/development/issues/archived/2026-08-10-capsule-cyl-missed-tags-a-sphere-root-as-a-cap.md]
#
# ⚠ 3.3.3 — BOTH HALF-SPACE TESTS ARE NaN-TRUE ON PURPOSE. A NaN radius, ray
# origin or ray direction makes every cap root NaN, and accepting it is what
# carries the NaN out. Both respelled NaN-false, a ray along the axis, where the
# cylinder is skipped and only the caps can answer, came back as the miss 0 for
# a NaN radius or a NaN origin coordinate: capsule (0,0,0)-(3,0,0), r = 1, ray
# from (-5,0,0) along +x. Either one alone changes no t, at most the branch label.
# tests/abuse.tcyr pins the NaN radius. A NaN axis never reaches this: it leaves
# right after the sphere case in geo_ray_capsule_branch.
# [measured: W1 probe on a NaN-false variant of the 3.3.3 tree, not reproducible in-tree, 2026-10-01; cycc 6.6.12]
fn _geo_cap_accepts(t, o_dot, d_dot, is_end) {
    if (f64_lt(t, 0) == 1) { return 0; }
    var dot_ab = f64_add(o_dot, f64_mul(t, d_dot));
    if (is_end == 1) {
        if (f64_lt(dot_ab, 0) != 1) { return 1; }
        return 0;
    }
    if (f64_gt(dot_ab, 0) != 1) { return 1; }
    return 0;
}

# A capsule whose length, radius and origin offset (o - start) are all under 2^-484 is solved
# as a copy at unit size (3.3.6): o - start and end - start multiplied by the power of two
# that takes the largest of the three into [1, 2), r by the same, d by the one that takes
# its own largest component there, the copy's start at 0; the copy's t is t * sp / sd. At
# the capsule's own size the squares and products the barrel, the caps and their half-space
# tests are formed from are subnormal or flushed: for a capsule 2^-537 long of radius
# 2^-540, an origin on its axis just past the start moving along it read the cap root at the
# far side of the start sphere (2^-652, an interior point) because (o - start) . (end -
# start) flushed to 0 and the half-space test took the root's side from that 0 (3.3.5:
# 2^-599, right, its roots having flushed alike). The copy's origin, direction, start, end
# and radius go to tv (13 words); the return is log2(sd / sp), or 0x7FFF_FFFF when the
# capsule is not that small, an input is not finite or d is zero.
# [measured: C336 review repro (L2) and its edge family, 3.3.5 vs this tree, 2026-10-11; cycc 6.6.14]
fn _geo_capsule_tiny(ray, capsule, tv) {
    var st = GeoCapsule_start(capsule);
    var en = GeoCapsule_end(capsule);
    var o = GeoRay_origin(ray);
    var d = GeoRay_direction(ray);
    var r = GeoCapsule_radius(capsule);
    var nf = _geo_hvec3_nonfinite(st) + _geo_hvec3_nonfinite(en);
    nf = nf + _geo_hvec3_nonfinite(o) + _geo_hvec3_nonfinite(d);
    if (nf != 0) { return 0x7FFF_FFFF; }
    if (f64_lt(f64_abs(r), _GEO_F64_POS_INF) == 0) { return 0x7FFF_FFFF; }
    var ab = hvec3_sub(en, st);
    var ao = hvec3_sub(o, st);
    var m = _geo_absmax_bits(ab);
    var m2 = _geo_absmax_bits(ao);
    if (m2 > m) { m = m2; }
    var mr = r & 0x7FFF_FFFF_FFFF_FFFF;
    if (mr > m) { m = mr; }
    if (m == 0 || m >= 0x21B0_0000_0000_0000) { return 0x7FFF_FFFF; }   # 2^-484
    var md = _geo_absmax_bits(d);
    if (md == 0) { return 0x7FFF_FFFF; }
    var sp = _geo_scale_for(m >> 52);
    var sd = _geo_scale_for(md >> 52);
    store64(tv, f64_mul(HVec3_x(ao), sp));
    store64(tv + 8, f64_mul(HVec3_y(ao), sp));
    store64(tv + 16, f64_mul(HVec3_z(ao), sp));
    store64(tv + 24, f64_mul(HVec3_x(d), sd));
    store64(tv + 32, f64_mul(HVec3_y(d), sd));
    store64(tv + 40, f64_mul(HVec3_z(d), sd));
    store64(tv + 48, 0);
    store64(tv + 56, 0);
    store64(tv + 64, 0);
    store64(tv + 72, f64_mul(HVec3_x(ab), sp));
    store64(tv + 80, f64_mul(HVec3_y(ab), sp));
    store64(tv + 88, f64_mul(HVec3_z(ab), sp));
    store64(tv + 96, f64_mul(r, sp));
    return (sd >> 52) - (sp >> 52);
}

public fn geo_ray_capsule_branch(ray, capsule, out) {
    if (out != 0) {
        store64(out, GEO_FACE_NONE);
        store64(out + 8, 0);
    }
    var ab = hvec3_sub(GeoCapsule_end(capsule), GeoCapsule_start(capsule));
    var ab_len_sq = hvec3_dot(ab, ab);
    # A capsule whose ab . ab is under 2^-968 may be tiny all through (_geo_capsule_tiny): the
    # rest of the routine then runs on its copy, on the stack, its barrel on the scaled path
    # (`tiny`, below), and the answer is multiplied back by 2^tiny_e.
    var tiny = 0;
    var tiny_e = 0;
    var tv[104];
    var tray[16];
    var tcap[24];
    if (f64_lt(ab_len_sq, 0x0370_0000_0000_0000) == 1) {   # 2^-968
        tiny_e = _geo_capsule_tiny(ray, capsule, &tv);
        if (tiny_e != 0x7FFF_FFFF) {
            store64(&tray, &tv);
            store64(&tray + 8, &tv + 24);
            store64(&tcap, &tv + 48);
            store64(&tcap + 8, &tv + 72);
            store64(&tcap + 16, load64(&tv + 96));
            ray = &tray;
            capsule = &tcap;
            ab = &tv + 72;   # end - start, the start being 0
            ab_len_sq = hvec3_dot(ab, ab);
            tiny = 1;
        } else { tiny_e = 0; }
    }

    # Degenerate capsule: just a sphere.
    # 2.10.2: threshold was the unsquared EPSILON_F64 against a SQUARED length,
    # so every capsule shorter than 1e-6 was silently treated as a sphere at
    # `start`. Measured: capsule (0,0,0)-(s,0,0) with radius s/4 answers 1.75s at
    # every scale down to 1e-6 and then 0 (a miss) at 1e-7.
    # [measured: docs/development/issues/archived/2026-08-10-squared-epsilon-guards-in-geo-ray.md]
    # ⚠ 2.14.0: the threshold moved again, for the reason above it. `d_par` is
    # `dot(dir, ab) / ab_len_sq` with a unit `dir`, so |d_par| <= 1/|ab| and stays
    # finite for any non-zero ab_len_sq, subnormal included. Only an exact zero
    # makes a capsule genuinely a sphere.
    # ⛔ 3.3.3 — AND THE SPELLING OF THAT EXACT ZERO WAS NaN-TRUE. It was
    # `f64_gt(ab_len_sq, 0) == 0`, so a capsule whose END had a NaN coordinate was
    # taken for a sphere at its finite start and answered with a real-looking
    # hit: the ray from (-5,0,0) along +x against (0,0,0)-(NaN,0,0), r = 1,
    # returned t = 4 tagged GEO_CAP_SPHERE, and `geo_jet_capsule` built a full
    # jet on it. A NaN start, radius, ray origin or ray direction already
    # returned NaN.
    # ⚠ THE NaN EXIT AFTER THE SPHERE CASE IS THE OTHER HALF OF THE REPAIR. With
    # the exact zero alone the NaN reaches the body and is laundered there
    # instead: `_geo_cap_accepts` is NaN-true as well, and `f64_min(NaN, t)`
    # returns t. Measured with the exact zero alone: the NaN END comes out NaN but
    # tagged GEO_CAP_END_CAP, and a NaN START, (NaN,0,0)-(3,0,0) on the same ray —
    # NaN on 3.3.2, its sphere being centred on the NaN — becomes the end cap's
    # t = 7, with a jet. A NaN axis poisons every quantity below this point, so
    # it leaves with the NaN and the branch at GEO_FACE_NONE, and the jet reads
    # that as its miss. It is a NaN test, not the non-finite one: an infinite
    # axis is the scale class and keeps its 3.3.2 path. Propagate rather than
    # miss, because that is what the capsule's other NaN inputs and
    # `geo_ray_sphere` already do.
    # [measured: G6 probe, 3.3.2 + exact-zero-only variant, not reproducible in-tree, 2026-10-01; cycc 6.6.12]
    if (f64_eq(ab_len_sq, 0) == 1) {
        var sph = geo_sphere_new(GeoCapsule_start(capsule), GeoCapsule_radius(capsule));
        var dt = geo_ray_sphere(ray, sph);
        if (out != 0) { if (dt != 0) { store64(out, GEO_CAP_SPHERE); } }
        if (tiny == 1) { dt = _geo_ldexp(dt, tiny_e); }
        return dt;
    }
    if (f64_eq(ab_len_sq, ab_len_sq) == 0) { return ab_len_sq; }

    # ⛔ 3.3.6 — A CAPSULE LONGER THAN 2^511.5 OVERFLOWED ab . ab: d_par and o_par read 0,
    # and the capsule (0,0,0)-(2^600, 0, 0) of radius 1 missed the ray from (5, 3, 0) along
    # -y, whose barrel hit is at t = 2. The projections, the proj test and the caps'
    # half-space tests only need the axis's direction, so where ab . ab is +Inf from finite
    # ends they use u = 2^eu ab, ab scaled to unit size (its ends halved first when ab
    # itself overflows), and proj is multiplied back by 2^eu. Otherwise u is ab and every
    # line below forms exactly what it did.
    var u = ab;
    var uu = ab_len_sq;
    var us = 0;    # 1 when u is the multiple 2^eu * ab of the axis, not ab itself
    var eu = 0;
    if (ab_len_sq == 0x7FF0_0000_0000_0000) {
        var ca = GeoCapsule_start(capsule);
        var cb = GeoCapsule_end(capsule);
        if (_geo_hvec3_nonfinite(ca) + _geo_hvec3_nonfinite(cb) == 0) {
            var ah = ab;
            if (_geo_hvec3_nonfinite(ab) == 1) {
                ah = hvec3_sub(hvec3_scale(cb, F64_HALF), hvec3_scale(ca, F64_HALF));
                eu = 0 - 1;
            }
            var sa = _geo_scale_for(_geo_absmax_bits(ah) >> 52);
            u = hvec3_scale(ah, sa);
            uu = hvec3_dot(u, u);
            us = 1;
            eu = eu + (sa >> 52) - 1023;
        }
    }

    # Closest approach of ray to segment axis (infinite cylinder test)
    var ao = hvec3_sub(GeoRay_origin(ray), GeoCapsule_start(capsule));
    # 3.3.6: o - start overflows for an origin more than DBL_MAX from the start (between
    # ends that far apart, or far from a short capsule), and o_par, o_perp and the barrel
    # read NaN: 1164 of 9066 rays along capsules whose ends are more than DBL_MAX apart
    # answered NaN. ao is then (o - start) / 2, exactly (oh = 1), the barrel is solved for
    # it and r / 2 on the scaled path, and its roots are doubled there. Finite input only.
    # With this, the proj and cap-side repairs below, those 9066 rays (3.3.5 wrong on
    # every one) are 8672 right and 394 wrong, each of the 394 from an origin at least
    # 2.3e5 radii from the start: projecting it onto the axis carries 2^-52 of that
    # distance, more than 4 ulp of the radius, unless the part across the axis is under
    # 2^-40 of it and the exact cross product (_geo_perp_rescue) forms it.
    # [measured: C336 far-capsule family (x7.py, seed 53), 3.3.5 vs this tree, 2026-10-11; cycc 6.6.14]
    var oh = 0;
    # (A non-finite component makes the sum non-finite; a finite sum that overflows only
    # sends ao to the exact test.)
    var aos = f64_add(f64_add(HVec3_x(ao), HVec3_y(ao)), HVec3_z(ao));
    if (f64_lt(f64_abs(aos), _GEO_F64_POS_INF) == 0) {
        if (_geo_hvec3_nonfinite(ao) == 1) {
            var fo = _geo_hvec3_nonfinite(GeoRay_origin(ray)) + _geo_hvec3_nonfinite(GeoCapsule_start(capsule));
            fo = fo + _geo_hvec3_nonfinite(GeoCapsule_end(capsule)) + _geo_hvec3_nonfinite(GeoRay_direction(ray));
            if (f64_lt(f64_abs(GeoCapsule_radius(capsule)), _GEO_F64_POS_INF) == 0) { fo = fo + 1; }
            if (fo == 0) {
                ao = hvec3_sub(hvec3_scale(GeoRay_origin(ray), F64_HALF),
                  hvec3_scale(GeoCapsule_start(capsule), F64_HALF));
                oh = 1;
            }
        }
    }
    var d_par = f64_div(hvec3_dot(GeoRay_direction(ray), u), uu);
    var o_par = f64_div(hvec3_dot(ao, u), uu);

    var d_perp = hvec3_sub(GeoRay_direction(ray), hvec3_scale(u, d_par));
    var o_perp = hvec3_sub(ao, hvec3_scale(u, o_par));

    # 3.3.6: d_perp and o_perp are the projections' remainders, which keep about 2^-52 of
    # d and ao along the axis; a part across the axis smaller than that, or a projection
    # that overflowed, is formed again from scaled copies without the subtraction
    # (_geo_perp_suspect, _geo_perp_rescue). For an origin 1.7 * 2^500 along the axis of
    # (0,0,0)-(1.3 * 2^501, 0, 0), 3 from it, 3.3.5 answered the barrel hit at t = 2 with
    # the miss.
    # [measured: C336 fixture probe, 3.3.5 vs this tree, 2026-10-11; cycc 6.6.14]
    var de = 0;     # the rescued d_perp is 2^de times the true one
    var dres = 0;
    var dpv[24];
    var dir = GeoRay_direction(ray);
    var a = hvec3_dot(d_perp, d_perp);
    var r = GeoCapsule_radius(capsule);
    var rb = r;   # the barrel's radius, at ao's scale
    if (oh == 1) { rb = f64_mul(r, F64_HALF); }
    var rbb = f64_mul(rb, rb);
    var oo = hvec3_dot(o_perp, o_perp);
    var aoao = hvec3_dot(ao, ao);
    var ddd = hvec3_dot(dir, dir);
    # A ray whose d_perp reads exactly 0 (a = 0, d . d at least 2^-968) is parallel to the
    # axis to within 7 * 2^-53 |d|, so across the segment's slab its distance from the axis
    # moves by under 14 * 2^-53 (|ao| + 2 |ab|), and o_perp's own rounding is 6 * 2^-53 |ao|.
    # When | |o_perp|^2 - r^2 | exceeds 2^-40 (|ao|^2 + |ab|^2 + r^2), | |o_perp| - r |
    # exceeds 2^-40.5 of that root, above both by 2^7: the barrel is not crossed on the
    # segment, and the caps answer (`par`, skipping both rescues below): a ray along a
    # capsule's axis, the bench's, no longer pays for two exact parts that are both 0.
    var par = 0;
    if (f64_eq(a, 0) == 1 && us == 0) {
        if (f64_lt(ddd, _GEO_DIR_LO) == 0) {
            var m2 = f64_add(f64_add(aoao, uu), rbb);
            if (f64_lt(m2, _GEO_F64_POS_INF) == 1 && f64_lt(m2, _GEO_DIR_LO) == 0) {
                if (f64_gt(f64_abs(f64_sub(oo, rbb)), f64_mul(m2, 0x3D70_0000_0000_0000)) == 1) { par = 1; }   # 2^-40
            }
        }
    }
    # (_geo_perp_suspect, inline where the squares are finite: under 2^-80 of the vector's
    # squared length.) Where a square overflowed (|d| or |o - start| past 2^511) both parts are
    # also formed exactly when r is under 2^-4 of |o - start| (_geo_cap_thin): the
    # projection's rounding, 2^-52 |o - start|, then reaches past an ulp of r. Where r is
    # comparable to |o - start| neither form is the better there, and the plain one is 3.3.5's.
    if (par == 0) {
        var sus = f64_lt(a, f64_mul(ddd, 0x3AF0_0000_0000_0000));   # 2^-80
        if (f64_lt(f64_add(a, ddd), _GEO_F64_POS_INF) == 0) {
            sus = _geo_perp_suspect(d_perp, dir) | _geo_cap_thin(rb, ao);
        }
        if (sus == 1) {
            if (_geo_hvec3_nonfinite(u) + _geo_hvec3_nonfinite(dir) == 0) {
                de = _geo_perp_rescue(dir, u, &dpv);
                dres = 1;
            }
        }
        sus = f64_lt(oo, f64_mul(aoao, 0x3AF0_0000_0000_0000));   # 2^-80
        if (f64_lt(f64_add(oo, aoao), _GEO_F64_POS_INF) == 0) {
            sus = _geo_perp_suspect(o_perp, ao) | _geo_cap_thin(rb, ao);
        }
        if (sus == 1) {
            if (_geo_hvec3_nonfinite(u) + _geo_hvec3_nonfinite(ao) == 0) {
                var opv[24];
                var e3 = 0 - _geo_perp_rescue(ao, u, &opv);
                o_perp = hvec3_new(_geo_ldexp(load64(&opv), e3), _geo_ldexp(load64(&opv + 8), e3),
                  _geo_ldexp(load64(&opv + 16), e3));
                oo = hvec3_dot(o_perp, o_perp);
            }
        }
    }
    var b = f64_mul(F64_TWO, hvec3_dot(d_perp, o_perp));
    var c = f64_sub(oo, rbb);
    # c read exactly 0 with o_perp off the axis: |o_perp|^2 and r^2 rounded to the same double,
    # and a 0 here makes a root 0, the contact (`found` below). It is formed exactly instead
    # (_geo_sphere_c_exact; oo finite keeps |o_perp| and r under 2^512): for
    # (3 - 1.5 * 2^-51, 4, 0) inside (0,0,0)-(0,0,-8), r = 5, c read 0 for -2.7e-15 and the
    # contact was the answer for a hit at 2.14 / |d|. Only the exact 0: on ordinary capsules
    # o_perp's own rounding outweighs the squares', and an exact c from it moved roots both ways.
    # [measured: C336 review edge family and C2's seed-71 capsules, 3.3.5 vs this tree, 2026-10-11; cycc 6.6.14]
    if (c == 0) {
        if (f64_eq(oo, 0) == 0) { c = _geo_sphere_c_exact(o_perp, rb); }
    }

    var disc = f64_sub(f64_mul(b, b), f64_mul(_GEO_F64_FOUR, f64_mul(a, c)));

    # Two ways the infinite-cylinder test yields nothing, both answered by the caps.
    #
    #   disc < 0  -- the ray passes outside the cylinder.
    #   a == 0    -- the ray is PARALLEL to the capsule axis, so d_perp is the zero
    #                vector and b == 0 too, making disc exactly +0.0. That does not
    #                satisfy `disc < 0`, so through 2.6.15 this fell through to the
    #                quadratic and computed inv_2a = 0.5/0 = +Inf, returning NaN
    #                from a function documented to return 0 on a miss.
    #
    # 2.10.1: the threshold is EPSILON_F64 SQUARED, because `a` is d_perp.d_perp
    # -- a squared length. Against the unsquared EPSILON_F64 this rejected the
    # cylinder for any perpendicular component below 1e-6 and silently answered
    # with a CAP hit instead: measured 0.942% relative error on t, constant at
    # every direction scale from 1e-6 down, for a ray that hits the body. Not a
    # miss and not an Inf -- a wrong number, which is why nothing caught it.
    # Same squared-vs-unsquared mistake 2.6.14 repaired in cx_div/cx_inv/cx_powf
    # (see cx_div in complex.cyr) and 2.10.1 repaired in geo_ray_sphere above.
    # [measured: docs/development/issues/archived/2026-08-10-squared-epsilon-guards-in-geo-ray.md]
    var cyl_missed = 0;
    # ⚠ 2.14.0, same correction as _geo_sphere_roots: the exponent was fixed in
    # 2.10.2, the absolute scale was not. `a` is the squared perpendicular
    # component of the direction and only needs a finite reciprocal.
    # ⛔ 3.3.5 — AND A SMALL RAW DIRECTION FLUSHED `a` THE SAME WAY: below 2^-511 the
    # barrel was a miss for every ray (as the caps were, in _geo_sphere_roots), and a
    # ray just above it at an angle to the axis lost the barrel too, its |d_perp|^2
    # under DBL_MIN. When `a` is under 2^-968 (_GEO_DIR_LO) and the largest |d_i| is
    # below 1, so that scaling up can lift it, d is multiplied by the power of two
    # `csc` that takes that component into [1, 2), and d_par, d_perp, a, b and disc are
    # formed for the copy (scalars and a stack copy, no allocation); the roots,
    # t / csc, are multiplied back. Bit for bit the unscaled answer wherever that kept
    # every product normal. A ray parallel to the axis still has a = 0 and takes the
    # caps; every other ray runs as before. (Measured with the sphere, in
    # _geo_sphere_roots.) ⚠ A d with a component of 1 or more is not scaled: that would
    # scale it down, which lifts nothing and can flush its `a`. No suite or sweep
    # answer moves without the test; it matters only for a ray within about 2^-510 of
    # parallel whose barrel crossing, some 2^458 or more along it, is still on the
    # segment. A ray whose |d_perp| is under 2^-511 once its largest component is in
    # [1, 2) still skips the barrel, as at unit size.
    # [measured: G1 mutation run and ray sweep, 2026-10-11; cycc 6.6.14]
    # (3.3.6: no longer. Such a ray, and every other `a` under 2^-968 that is not 0, takes
    # the scaled barrel below, which scales d_perp itself.)
    var csc = 0;
    var dpr[24];
    var dp = d_perp;   # the perpendicular direction the quadratic below is formed from
    if (dres == 1) { dp = &dpv; }
    if (dres == 0 && par == 0 && f64_lt(f64_abs(a), _GEO_DIR_LO) == 1) {
        var dm = _geo_absmax_bits(GeoRay_direction(ray));
        if (dm != 0 && (dm >> 52) < 1023) {
            csc = _geo_scale_for(dm >> 52);
            var dsx = f64_mul(HVec3_x(GeoRay_direction(ray)), csc);
            var dsy = f64_mul(HVec3_y(GeoRay_direction(ray)), csc);
            var dsz = f64_mul(HVec3_z(GeoRay_direction(ray)), csc);
            store64(&dpr, dsx);
            store64(&dpr + 8, dsy);
            store64(&dpr + 16, dsz);
            var d_par_s = f64_div(hvec3_dot(&dpr, u), uu);
            store64(&dpr, f64_sub(dsx, f64_mul(HVec3_x(u), d_par_s)));
            store64(&dpr + 8, f64_sub(dsy, f64_mul(HVec3_y(u), d_par_s)));
            store64(&dpr + 16, f64_sub(dsz, f64_mul(HVec3_z(u), d_par_s)));
            a = hvec3_dot(&dpr, &dpr);
            b = f64_mul(F64_TWO, hvec3_dot(&dpr, o_perp));
            disc = f64_sub(f64_mul(b, b), f64_mul(_GEO_F64_FOUR, f64_mul(a, c)));
            dp = &dpr;
        }
    }
    # ⛔ 3.3.6 — THE BARREL AT LARGE SCALES, AND NEAR PARALLEL. Its quadratic overflowed for
    # a radius, an offset o_perp or a d_perp past 2^511 (NaN, or a barrel skipped), and an
    # `a` = |d_perp|^2 under DBL_MIN skipped the barrel whatever d_perp was: the capsule
    # (0,0,0)-(1.5 * 2^511, 0, 0), radius 1, and the ray from (1, 0.5, 0) along
    # (1, 2^-512, 0) lost its barrel exit at 2^511 and answered the end cap at
    # 1.5 * 2^511. When `a` is under 2^-968 but not 0, disc or c is not finite, or d_perp
    # was rescued above, the barrel is solved for copies of d_perp, o_perp and r scaled to
    # unit size (_geo_sph_solve, the sphere's form, so it does not cancel either), and the
    # roots are multiplied back (_geo_ldexp). Every other ray keeps the classic quadratic
    # and its bits; its accuracy is not repaired here.
    # With the caps' new quadratic (_geo_sphere_roots) and the axis and perpendicular
    # repairs above, over 160000 capsule rays (two seeds: ordinary capsules, axis-aligned
    # capsules 2^400 to 2^1021 long with near-parallel rays, general ones, raw directions
    # past 2^505, positions past 2^500, degenerate capsules), every finite one judged
    # against its exact verdict and root: 76226 wrong -> right at 4 ulp and 4 right ->
    # wrong: 3 degenerate capsules (spheres) whose t moved past 4 ulp (to at most 5.6),
    # and 1 end-cap verdict on a capsule 2^437 long, where the hit point lies 1.1 units
    # past the end plane and its own rounding, 2^385, decides the side (o_dot + t * d_dot,
    # both near |ab|^2; 3.3.5 answered the hit). 20914 stay wrong, wrong in 3.3.5 too:
    # 19506 the barrel's classic quadratic at ordinary scale, not repaired here (a median
    # of 1.3 ulp on ordinary capsules), 1387 from origins far along or far off a long
    # axis, as for the far capsules above, and 21 more past 4 ulp. Of 10000 rays with a
    # non-finite input, 302 moved, each an infinite start answered through the finite end
    # cap's new root, 294 of them closer to it (at most 9.1 ulp, where 3.3.5 had 441).
    # [measured: C336 capsule sweep, seeds 51 and 52, exact Decimal roots, 3.3.5 vs this tree, 2026-10-11; cycc 6.6.14]
    var bsc = 0;
    var be = 0;
    var bhit = 0;
    var broots[16];
    var bneed = dres;
    if (oh == 1) { bneed = 1; }
    # (The tiny capsule's copy, _geo_capsule_tiny, as round 2 solved such barrels: its
    # classic quadratic, ordinary at the copy's size, loses the near root's bits.)
    if (tiny == 1) { bneed = 1; }
    # |o_perp| and r both under 2^-484: c is formed from squares that are subnormal or
    # flushed, as in _geo_sphere_roots, and read 0 where they flushed, so disc = b^2 - 4 a c
    # flushed too and a ray missing the barrel by three radii read the tangent hit -b / 2a.
    # The copy at unit size forms them at their own scale. (Through 3.3.5 o_perp's rounding,
    # up to 2^-52 |ao|, usually stood in for the flushed square and the ray read the miss;
    # this tree's exact o_perp exposed the flush.) TINYCAP
    if (f64_lt(oo, _GEO_DIR_LO) == 1 && f64_lt(rbb, _GEO_DIR_LO) == 1) { bneed = 1; }
    if (f64_lt(f64_abs(a), _GEO_DIR_LO) == 1) { if (f64_eq(a, 0) == 0) { bneed = 1; } }
    # (A c that is not finite makes disc +-Inf or NaN, so the disc test covers it.)
    if (f64_lt(f64_abs(disc), _GEO_F64_POS_INF) == 0) { bneed = 1; }
    if (bneed == 1) {
        var bfin = _geo_hvec3_nonfinite(dp) + _geo_hvec3_nonfinite(o_perp);
        if (f64_lt(f64_abs(r), _GEO_F64_POS_INF) == 0) { bfin = bfin + 1; }
        if (bfin == 0) {
            var bsd = _geo_scale_for(_geo_absmax_bits(dp) >> 52);
            var bmp = _geo_absmax_bits(o_perp);
            var bmr = rb & 0x7FFF_FFFF_FFFF_FFFF;
            if (bmr > bmp) { bmp = bmr; }
            var bsp = _geo_scale_for(bmp >> 52);
            bhit = _geo_sph_solve(hvec3_scale(o_perp, bsp), hvec3_scale(dp, bsd), f64_mul(rb, bsp), &broots);
            bsc = 1;
            be = (bsd >> 52) - (bsp >> 52);
            if (csc != 0) { be = be + (csc >> 52) - 1023; }
            be = be + de + oh;
        }
    }
    if (bsc == 1) {
        cyl_missed = 1 - bhit;
    } else {
        if (f64_lt(f64_abs(a), _GEO_F64_TINY) == 1) { cyl_missed = 1; }
        if (f64_lt(disc, 0) == 1) { cyl_missed = 1; }
    }

    var best = 0;
    # Which piece of the surface produced `best`. Written only through out at the
    # end, so a non-differentiating caller pays one i64 store per accepted branch.
    var branch = GEO_FACE_NONE;
    # 1 once a root is accepted (3.3.6). Through round 2 `best == 0` stood for "none yet",
    # so an accepted root of +0, an origin on the surface moving in, was overwritten by the
    # exit: the capsule answered the exit where the sphere answers the contact, 0, and the
    # one rule for every primal (see "A CONTACT AT t = 0" above) says the contact. (A -0
    # root, whose bits are not 0, already stayed.) For the origin (3, 4, 0) on the start cap
    # of (0,0,0)-(0,0,-8), r = 5, moving along (-3, -4, 0), every release answered 2.
    # [measured: C336 review edge family, 3.3.5 vs this tree, 2026-10-11; cycc 6.6.14]
    var found = 0;

    if (cyl_missed == 0) {
        var inv_2a = f64_div(F64_HALF, a);
        var sqrt_disc = f64_sqrt(disc);
        var cyl_t1 = f64_mul(f64_sub(f64_neg(b), sqrt_disc), inv_2a);
        var cyl_t2 = f64_mul(f64_add(f64_neg(b), sqrt_disc), inv_2a);
        # 3.3.6: a classic root that cancelled to exactly 0 (sqrt(disc) equal to |b|, 4ac under
        # half an ulp of b^2) is formed again as c / q, q = -(b + sign(b) sqrt(disc)) / 2, which
        # keeps its sign: a 0 is the contact to the root selection below (`found`), and for an
        # origin just inside the barrel near (3, 4, 0) of (0,0,0)-(0,0,-8), r = 5, the near root
        # behind it read +0 and the contact was the answer for a hit at 2.14 / |d|. Only an
        # origin on the barrel (c = 0) keeps the root 0. Every other root keeps its bits.
        # [measured: C336 review edge family, 3.3.5 vs this tree, 2026-10-11; cycc 6.6.14]
        if (bsc == 0 && f64_eq(c, 0) == 0) {
            if ((cyl_t1 & 0x7FFF_FFFF_FFFF_FFFF) == 0 || (cyl_t2 & 0x7FFF_FFFF_FFFF_FFFF) == 0) {
                var qn = f64_mul(F64_HALF, f64_sub(sqrt_disc, b));
                if (f64_lt(b, 0) == 0) { qn = f64_neg(f64_mul(F64_HALF, f64_add(b, sqrt_disc))); }
                if (f64_eq(qn, 0) == 0) {
                    if ((cyl_t1 & 0x7FFF_FFFF_FFFF_FFFF) == 0) { cyl_t1 = f64_div(c, qn); }
                    else { cyl_t2 = f64_div(c, qn); }
                }
            }
        }
        var cs1 = cyl_t1;   # the roots before they are multiplied back, by 2^ce
        var cs2 = cyl_t2;
        var ce = 0;
        if (bsc == 1) {
            cs1 = load64(&broots);
            cs2 = load64(&broots + 8);
            ce = be;
            cyl_t1 = _geo_root_ldexp(cs1, be);
            cyl_t2 = _geo_root_ldexp(cs2, be);
        } elif (csc != 0) {
            ce = (csc >> 52) - 1023;
            cyl_t1 = f64_mul(cyl_t1, csc);
            cyl_t2 = f64_mul(cyl_t2, csc);
        }

        # Check cylinder hit at cyl_t1
        if (f64_lt(cyl_t1, 0) != 1) {
            var proj = 0;
            if (cyl_t1 == 0x7FF0_0000_0000_0000) { proj = _geo_cap_far_proj(cs1, ce, ray, capsule, u, uu, eu); }
            else {
                var p = geo_ray_at(ray, cyl_t1);
                if (us == 1) { proj = _geo_cap_proj_u(p, GeoCapsule_start(capsule), u, uu, eu); }
                else { proj = f64_div(hvec3_dot(hvec3_sub(p, GeoCapsule_start(capsule)), u), uu); }
            }
            if (f64_lt(proj, 0) != 1) {
                if (f64_gt(proj, F64_ONE) != 1) {
                    best = cyl_t1;
                    branch = GEO_CAP_CYLINDER;
                    found = 1;
                }
            }
        }

        # Check cylinder hit at cyl_t2
        if (f64_lt(cyl_t2, 0) != 1) {
            var proj = 0;
            if (cyl_t2 == 0x7FF0_0000_0000_0000) { proj = _geo_cap_far_proj(cs2, ce, ray, capsule, u, uu, eu); }
            else {
                var p = geo_ray_at(ray, cyl_t2);
                if (us == 1) { proj = _geo_cap_proj_u(p, GeoCapsule_start(capsule), u, uu, eu); }
                else { proj = f64_div(hvec3_dot(hvec3_sub(p, GeoCapsule_start(capsule)), u), uu); }
            }
            if (f64_lt(proj, 0) != 1) {
                if (f64_gt(proj, F64_ONE) != 1) {
                    if (found == 0) {
                        best = cyl_t2;
                        branch = GEO_CAP_CYLINDER;
                        found = 1;
                    } else {
                        # NO branch update here, and that is measured rather than an
                        # omission: cyl_t1 <= cyl_t2 always (a > 0 and sqrt(disc) >= 0
                        # give t1 = (-b - s)/2a <= (-b + s)/2a = t2), so reaching this
                        # arm means cyl_t1 already owns `best` AND already set the
                        # branch to the cylinder. A mutant that adds an update here
                        # cannot change any answer -- one was written, and it survived
                        # the whole suite, which is what says the line is dead code
                        # rather than defensive symmetry.
                        # [measured: docs/development/issues/archived/2026-08-10-squared-epsilon-guards-in-geo-ray.md]
                        best = f64_min(best, cyl_t2);
                    }
                }
            }
        }

    }

    # ================================================================
    # THE CAPS, 2.10.2 -- BOTH roots of each cap sphere, half-space filtered
    # ================================================================
    #
    # This used to call geo_ray_sphere, which returns only the FIRST non-negative
    # root, and then test that one root against the cap's half-space. Two defects
    # followed, and they are the same defect seen from either side:
    #
    #   * If the first root failed the half-space test, the OTHER root was never
    #     considered -- so a ray leaving the capsule through a cap reported a MISS.
    #     Measured over 600 random interior origins: 32 of them, 5.3%, dropped a
    #     real exit, with t from 1.09 to 10.0.
    #     [measured: docs/development/issues/archived/2026-08-10-capsule-cyl-missed-tags-a-sphere-root-as-a-cap.md]
    #   * When the cylinder test yielded nothing, a separate fallback returned the
    #     smaller of the two spheres' first roots with NO half-space test at all.
    #     Measured: capsule (0,0,0)-(10,0,0) r = 1 with a ray from (5,0,0) along
    #     +x returned t = 4, whose hit point (9,0,0) is ON THE AXIS -- a full
    #     radius inside the solid -- where the true exit is t = 6.
    #
    # Both are gone because that fallback is gone: the caps are now evaluated on
    # every path, and a cap root is a candidate only if it is non-negative AND on
    # the correct side of that cap's plane. The contract this restores is the one
    # every sibling already honours and this function's own cylinder branch
    # already honoured -- an origin inside the shape gets the EXIT parameter.
    # [measured: docs/development/issues/archived/2026-08-10-capsule-cyl-missed-tags-a-sphere-root-as-a-cap.md]
    var rt[16];
    var d_dot_ab = hvec3_dot(dir, u);
    var csph[16];
    var cape = 0;   # 3.3.6: d . u overflowed; it is 2^cape times this, so t is scaled by 2^-cape
    if (f64_lt(f64_abs(d_dot_ab), _GEO_F64_POS_INF) == 0) {
        if (_geo_hvec3_nonfinite(u) + _geo_hvec3_nonfinite(dir) == 0) {
            var s4 = _geo_scale_for(_geo_absmax_bits(dir) >> 52);
            d_dot_ab = hvec3_dot(hvec3_scale(dir, s4), u);
            cape = (s4 >> 52) - 1023;
        }
    }
    for (var cap_i = 0; cap_i < 2; cap_i = cap_i + 1) {
        var cap_pt = GeoCapsule_start(capsule);
        var cap_br = GEO_CAP_START_CAP;
        if (cap_i == 1) {
            cap_pt = GeoCapsule_end(capsule);
            cap_br = GEO_CAP_END_CAP;
        }
        # ((o - cap_pt) . u, as scalars in hvec3_dot's order: the same bits, no allocation.)
        var wcx = f64_sub(HVec3_x(GeoRay_origin(ray)), HVec3_x(cap_pt));
        var wcy = f64_sub(HVec3_y(GeoRay_origin(ray)), HVec3_y(cap_pt));
        var wcz = f64_sub(HVec3_z(GeoRay_origin(ray)), HVec3_z(cap_pt));
        var o_dot_ab = f64_add(f64_add(f64_mul(wcx, HVec3_x(u)), f64_mul(wcy, HVec3_y(u))), f64_mul(wcz, HVec3_z(u)));
        # 3.3.6: (o - cap_pt) . u overflows (or o - cap_pt does) for an origin far from a cap
        # of such a capsule; the side test needs only the sign of o_dot + t * d_dot, so it
        # is formed from (o - cap_pt) / 2 taken to unit size, 2^-oce times o_dot, and t is
        # multiplied by the same power below. Finite input only.
        var oce = 0;
        if (f64_lt(f64_abs(o_dot_ab), _GEO_F64_POS_INF) == 0) {
            var fc = _geo_hvec3_nonfinite(GeoRay_origin(ray)) + _geo_hvec3_nonfinite(cap_pt);
            if (fc + _geo_hvec3_nonfinite(u) == 0) {
                var wc = hvec3_sub(hvec3_scale(GeoRay_origin(ray), F64_HALF), hvec3_scale(cap_pt, F64_HALF));
                var swc = _geo_scale_for(_geo_absmax_bits(wc) >> 52);
                o_dot_ab = hvec3_dot(hvec3_scale(wc, swc), u);
                oce = (swc >> 52) - 1023 - 1;
            }
        }
        store64(&csph, cap_pt);   # the cap's sphere, a GeoSphere on the stack
        store64(&csph + 8, r);
        if (_geo_sphere_roots(ray, &csph, &rt) == 1) {
            for (var root_i = 0; root_i < 2; root_i = root_i + 1) {
                var tc = load64(&rt + root_i * 8);
                var tcs = tc;
                # (A negative root stays negative here: the scale reaches below 2^-1022 only
                # with the origin past DBL_MAX / 4 from the cap, where |tc| is at least 2^-51.)
                if (oce != cape) { tcs = _geo_ldexp(tc, oce - cape); }
                var acc = 0 - 1;
                if (tc == 0x7FF0_0000_0000_0000) {
                    acc = _geo_cap_far_accepts(ray, &csph, u, o_dot_ab, oce, cap_i, root_i);
                }
                if (acc == 0 - 1) { acc = _geo_cap_accepts(tcs, o_dot_ab, d_dot_ab, cap_i); }
                if (acc == 1) {
                    if (found == 0) {
                        best = tc;
                        branch = cap_br;
                        found = 1;
                    } else {
                        if (f64_lt(best, tc) != 1) { branch = cap_br; }
                        best = f64_min(best, tc);
                    }
                }
            }
        }
    }

    if (out != 0) { store64(out, branch); }
    if (tiny == 1) { best = _geo_ldexp(best, tiny_e); }
    return best;
}

# The plain entry point: identical t, no branch bookkeeping, out = 0.
public fn geo_ray_capsule(ray, capsule) {
    return geo_ray_capsule_branch(ray, capsule, 0);
}

# ================================================================
# Primitive overlap tests
# ================================================================

# 1 when the slabs [alo, ahi] and [blo, bhi], each read sorted, overlap. A NaN bound is
# never swapped (f64_gt is false for it) and fails the test that reads it: 0.
fn _geo_slabs_meet(alo, ahi, blo, bhi) {
    if (f64_gt(alo, ahi) == 1) {
        var ta = alo;
        alo = ahi;
        ahi = ta;
    }
    if (f64_gt(blo, bhi) == 1) {
        var tb = blo;
        blo = bhi;
        bhi = tb;
    }
    if (f64_le(alo, bhi) == 0) { return 0; }
    if (f64_le(blo, ahi) == 0) { return 0; }
    return 1;
}

# geo_aabb_aabb for two boxes each read sorted, axis by axis.
fn _geo_aabb_aabb_sorted(a, b) {
    var a_min = GeoAabb_min(a);
    var a_max = GeoAabb_max(a);
    var b_min = GeoAabb_min(b);
    var b_max = GeoAabb_max(b);
    if (_geo_slabs_meet(HVec3_x(a_min), HVec3_x(a_max), HVec3_x(b_min), HVec3_x(b_max)) == 0) { return 0; }
    if (_geo_slabs_meet(HVec3_y(a_min), HVec3_y(a_max), HVec3_y(b_min), HVec3_y(b_max)) == 0) { return 0; }
    if (_geo_slabs_meet(HVec3_z(a_min), HVec3_z(a_max), HVec3_z(b_min), HVec3_z(b_max)) == 0) { return 0; }
    return 1;
}

# AABB-AABB overlap test. Returns 1 if overlapping, 0 otherwise.
#
# ⛔ 3.3.4 — A NaN BOX OVERLAPPED. Each test answered 0 only for an axis provably
# separated, and a test that reads a NaN bound is false, so a box NaN in both bounds
# of an axis (what geo_aabb_new((NaN,0,0), (1,1,1)) builds since 3.3.3) overlapped
# every box it did not clear on another axis: [100,101] x [0,1] x [0,1] among them.
# Each test now asks "overlaps on this axis", spelled NaN-false, so a NaN bound in
# either box is no overlap -- the rule geo_sphere_sphere below and the collision entry
# points keep: a NaN shape is never a contact. For every input with no NaN the two
# spellings give the same answer.
# The spatial walkers prune with their own NaN-true copies of the old tests
# (`_bvh_aabb_may_overlap` in src/geo_advanced.cyr, `_ot_aabb_may_overlap` in
# src/spatial.cyr): a node's bounds turn NaN for reasons that say nothing about what
# is below it (a NaN box anywhere in a BVH subtree; the centre of an octree root with
# an infinite axis), and this test there would prune the finite boxes and points too.
# bvh_query_aabb's leaves are this function, so a NaN box is never returned, and
# neither is anything for a NaN query box.
# [measured: spatial lane probe, 3.3.4-base and repaired bundles, not in-tree, 2026-10-03; cycc 6.6.14]
# ⛔ 3.3.4 — AN INVERTED BOX (min above max on an axis, which only the setters build:
# geo_aabb_new sorts its corners) IS READ SORTED, as geo_ray_aabb reads it and
# geo_ray_obb reads |he|. Through 3.3.3 these tests answered the x-slab [5, 1] against
# [0, 10], [3, 4] and [0, 2] with 1, 0, 0, which is neither the empty slab nor [1, 5],
# while a ray crossing x read it as [1, 5]. When a test fails, _geo_aabb_aabb_sorted
# gives the answer for the two sorted boxes. A pair that passes all six tests
# overlaps sorted as well (sorting only widens what each test compares), and for
# boxes with min <= max, or with a NaN bound, a failed test is the sorted answer
# already: those answers are unchanged, and the overlap path runs no extra compare.
# 40100 random pairs with an inverted box answer as the sorted pair, and 19900 without
# one (NaN, +-Inf, +-0, subnormal and DBL_MAX bounds among them) as before.
# [measured: overlap differential, 3.3.4 tree before this and after, not in-tree, 2026-10-03; cycc 6.6.14]
public fn geo_aabb_aabb(a, b) {
    var a_min = GeoAabb_min(a);
    var a_max = GeoAabb_max(a);
    var b_min = GeoAabb_min(b);
    var b_max = GeoAabb_max(b);

    # a.min <= b.max && b.min <= a.max on all 3 axes
    if (f64_le(HVec3_x(a_min), HVec3_x(b_max)) == 0) { return _geo_aabb_aabb_sorted(a, b); }
    if (f64_le(HVec3_y(a_min), HVec3_y(b_max)) == 0) { return _geo_aabb_aabb_sorted(a, b); }
    if (f64_le(HVec3_z(a_min), HVec3_z(b_max)) == 0) { return _geo_aabb_aabb_sorted(a, b); }
    if (f64_le(HVec3_x(b_min), HVec3_x(a_max)) == 0) { return _geo_aabb_aabb_sorted(a, b); }
    if (f64_le(HVec3_y(b_min), HVec3_y(a_max)) == 0) { return _geo_aabb_aabb_sorted(a, b); }
    if (f64_le(HVec3_z(b_min), HVec3_z(a_max)) == 0) { return _geo_aabb_aabb_sorted(a, b); }
    return 1;
}

# Sphere-sphere overlap test. Returns 1 if overlapping, 0 otherwise.
#
# ⛔ 3.3.3 — A NaN SPHERE WAS A CONTACT. The test read "`dist_sq > (r1 + r2)^2`
# is a miss, anything else a hit", and anything else includes NaN, so a NaN
# centre coordinate or radius overlapped everything: a unit sphere at (NaN,0,0),
# or one of radius NaN at the origin, touched a unit sphere at (100,0,0). It is
# now "`dist_sq <= (r1 + r2)^2` is a hit", spelled NaN-false, so a NaN shape is a
# miss — the rule tests/modules.tcyr pins for the collision entry points ("a NaN
# shape is never a contact"). That includes the NaN infinite input makes: two
# centres infinite with one sign in one slot give `Inf - Inf`, and 6562 of 20000
# random configurations with infinite coordinates moved from 1 to 0. Finite input
# cannot make a NaN here (a sum of squares never subtracts), and two sweeps of
# 40000 pairs each, one at random magnitudes with DBL_MAX, -0 and subnormal
# coordinates and one at and around exact touching, are bit-identical to 3.3.2.
# No bench row and no caller in src/ reaches this function.
# [measured: R4geo probes and sweeps, 3.3.2, 3.3.3-base and repaired bundles, not in-tree, 2026-10-01; cycc 6.6.12]
public fn geo_sphere_sphere(a, b) {
    var r_sum = f64_add(GeoSphere_radius(a), GeoSphere_radius(b));
    var dist_sq = hvec3_length_sq(hvec3_sub(GeoSphere_center(a), GeoSphere_center(b)));
    var rr = f64_mul(r_sum, r_sum);
    if (f64_lt(dist_sq, rr) == 1) { return 1; }
    if (f64_eq(dist_sq, rr) == 1) { return 1; }
    return 0;
}

# ================================================================
# Closest point queries
# ================================================================

# Closest point on a plane to a given point. Returns HVec3.
public fn geo_closest_point_on_plane(plane, point) {
    var sd = geo_plane_signed_distance(plane, point);
    return hvec3_sub(point, hvec3_scale(GeoPlane_normal(plane), sd));
}

# Closest point on a sphere surface to a given point. Returns HVec3.
# If point is at sphere center, returns center + (radius, 0, 0).
public fn geo_closest_point_on_sphere(sphere, point) {
    var dir = hvec3_sub(point, GeoSphere_center(sphere));
    # ⛔ `len` is a DISTANCE, absolute 1e-12, so a query point near a small sphere
    # got center + (radius,0,0) — a point genuinely ON the sphere, in a direction
    # the caller never asked for. Measured at radius 2^-32 with the query on +y.
    # ⚠ Asserting |cp - center| == radius does NOT catch this; the fabrication has
    # the right length. Only the DIRECTION discriminates.
    # [measured: tests/modules.tcyr closest_point_on_sphere 3-axis sweep]
    # ⛔ 3.3.6 — NORMALISED ON A POWER-OF-TWO COPY, AS _geo_unit_or DOES. Unscaled,
    # `hvec3_length` rounds on its scaled path (a sum of squares below DBL_MIN or past
    # DBL_MAX) differently from the plain root, 1/len is subnormal past 2^1022, a length
    # past DBL_MAX was +Inf and the answer the centre itself, and below DBL_MIN the
    # guard answered centre + (radius, 0, 0) for a point that is not at the centre. So
    # 2^k times the inputs did not give 2^k times the answer: of 81761 points (40
    # directions at every 2^k where they scale exactly; centre 0, radius 1), 13322 got
    # another answer than the unit-size one (4108 by up to 1 ulp, 9194 by up to 2, 11
    # by up to 4, 7 the centre, 2 the +x fallback) and none does now; with centre and
    # radius scaled too, 1032 of 24510 and none. The copy's largest component is in
    # [1, 4), so its length is normal and 1/len at most 2^51 (the bound the two-step
    # note below needs), and only the zero vector, a point exactly at the centre, takes
    # the fallback: all 2957 points a non-zero subnormal distance away got +x (2887 of
    # them wrong) and none does. Against the exact closest point (4 ulp per
    # component), the largest error of a right answer on the 81761 falls from 3.94 to
    # 1.61 ulp (1043 above 2 ulp, none now); over 30000 random magnitudes 3 wrong ->
    # right, none right -> wrong. The one right -> wrong, a scaled input at 2^1019, is
    # 2^1019 times 3.3.5's own unit-size answer (8.76 ulp, where centre + radius * u
    # cancels). NaN and infinite inputs keep their bits (3000 of 3000).
    # [measured: C336 row-10 sweep, exact Decimal oracle, 3.3.5 vs this tree, not in-tree, 2026-10-11; cycc 6.6.14]
    var s = _geo_scale_for(_geo_absmax_bits(dir) >> 52);
    var w = hvec3_scale(dir, s);
    var len = hvec3_length(w);
    if (f64_eq(len, 0) == 1) {
        return hvec3_add(GeoSphere_center(sphere),
          hvec3_new(GeoSphere_radius(sphere), 0, 0));
    }
    # ⭐ TWO STEPS, AND THAT IS PART OF THE REPAIR. `radius / len` overflows to
    # +Inf whenever the ratio exceeds DBL_MAX — measured 77 of 601 radii at a
    # fixed offset — so normalise FIRST and scale second. This is only safe
    # because of the guard above: 1/len is bounded by 1/DBL_MIN, which is finite.
    # [measured: 3-axis sweep; 1-step fails 77 of 601, 2-step 0 of 601]
    # ⚠ THE ORIGINAL IS MULTIPLIED, NOT THE COPY, WHEREVER THAT IS EXACT. Scaled down,
    # the copy can underflow a tiny component, which the product then rounds a second
    # time. s / len is exact and normal up to a length of 2^1022, so dir * (s / len)
    # rounds once, and it is bit-identical to 3.3.5's dir * (1 / len) wherever that
    # took the plain root: 61122 of 61129 such inputs, the 7 others where a square in
    # 3.3.5's sum was subnormal. Multiplying the copy throughout kept 61100 of them and
    # lost 2 right answers of the 30000 random magnitudes to the double rounding.
    # [measured: C336 row-10 sweep, exact Decimal oracle, 3.3.5 vs this tree, not in-tree, 2026-10-11; cycc 6.6.14]
    var inv = f64_div(F64_ONE, len);
    var u = w;
    if (f64_lt(s, F64_ONE) == 1) {
        var f = f64_mul(s, inv);
        if (f64_lt(f, _GEO_F64_TINY) == 0) {
            u = dir;
            inv = f;
        }
    }
    return hvec3_add(GeoSphere_center(sphere),
      hvec3_scale(hvec3_scale(u, inv), GeoSphere_radius(sphere)));
}

# Closest point on an AABB to a given point (clamp to box). Returns HVec3.
#
# ⛔ 3.3.3 — A NaN BOUND WAS CLAMPED STRAIGHT PAST. `f64_clamp(x, lo, hi)` tests
# `x < lo` and `x > hi`, both false against a NaN, so on an axis with a NaN bound
# it returned the query's own coordinate: the box geo_aabb_new((NaN,0,0), (1,1,1))
# and the point (-5, 0.5, 0.5) gave (-5, 0.5, 0.5), finite and with nothing to say
# the box had no x extent. (3.3.2 got (1, 0.5, 0.5) by another route: its
# hvec3_min/hvec3_max dropped the NaN corner and built the slab [1, 1].) A NaN
# bound is now NaN in its own component — the bound itself — as a NaN query
# coordinate already was; the other two components are their own clamps, which
# do not depend on that axis. Finite and infinite bounds are bit-identical to
# 3.3.2: 120000 random and near-boundary boxes, and 20000 with infinite bounds.
# [measured: R4geo probes and sweeps, 3.3.2, 3.3.3-base and repaired bundles, not in-tree, 2026-10-01; cycc 6.6.12]
# The six NaN tests cost about 4.6 ns of a 41 ns call against 3.3.2, +11% (41.7 ->
# 46.2 and 41.0 -> 45.8 ns, medians of a 64-box scratch row over two interleaved
# runs of 60 rounds at load 4-7 on 16 cores); no bench row and no caller in src/
# reaches this function. Each bound is read once per axis.
# [measured: R5geo interleaved micro A/B, 3.3.2, 3.3.3-base and repaired trees, not in-tree, 2026-10-01; cycc 6.6.12]
public fn geo_closest_point_on_aabb(aabb, point) {
    var mn = GeoAabb_min(aabb);
    var mx = GeoAabb_max(aabb);
    var lo = HVec3_x(mn);
    var hi = HVec3_x(mx);
    var cx = f64_clamp(HVec3_x(point), lo, hi);
    if (f64_eq(lo, lo) == 0) { cx = lo; }
    if (f64_eq(hi, hi) == 0) { cx = hi; }
    lo = HVec3_y(mn);
    hi = HVec3_y(mx);
    var cy = f64_clamp(HVec3_y(point), lo, hi);
    if (f64_eq(lo, lo) == 0) { cy = lo; }
    if (f64_eq(hi, hi) == 0) { cy = hi; }
    lo = HVec3_z(mn);
    hi = HVec3_z(mx);
    var cz = f64_clamp(HVec3_z(point), lo, hi);
    if (f64_eq(lo, lo) == 0) { cz = lo; }
    if (f64_eq(hi, hi) == 0) { cz = hi; }
    return hvec3_new(cx, cy, cz);
}

# 1 when any component of `v` is NaN or +/-Inf, 0 otherwise: the house non-finite
# test, `f64_lt(|x|, +Inf) == 0`, one comparison that catches all three. Every
# finite value, DBL_MAX included, passes.
fn _geo_hvec3_nonfinite(v) {
    if (f64_lt(f64_abs(HVec3_x(v)), _GEO_F64_POS_INF) == 0) { return 1; }
    if (f64_lt(f64_abs(HVec3_y(v)), _GEO_F64_POS_INF) == 0) { return 1; }
    if (f64_lt(f64_abs(HVec3_z(v)), _GEO_F64_POS_INF) == 0) { return 1; }
    return 0;
}

# v, or 2v when the closest-point query halved its inputs (`hv` = 1, see
# _geo_top_binade). The answer lies in the triangle's bounding box, so 2v is finite
# unless rounding carried a coordinate past DBL_MAX / 2 by an ulp.
fn _geo_unhalve(v, hv) {
    if (hv == 1) { return hvec3_scale(v, F64_TWO); }
    return v;
}

# 1 when b - a, c - a or p - a has a component of 2^1023 or more, an overflow to Inf
# included. The other differences the closest-point query forms (c - b, p - b, p - c)
# are differences of two of these, so they cannot overflow while these stay below
# 2^1023: an exact difference at the midpoint just below 2^1023 rounds up to it (ties to
# even). Called only on finite input (_geo_top_binade is 1), so an exponent field of
# 2047 here is an overflow.
fn _geo_spread_top_binade(a, b, c, p) {
    if ((_geo_absmax_bits(hvec3_sub(b, a)) >> 52) >= 2046) { return 1; }
    if ((_geo_absmax_bits(hvec3_sub(c, a)) >> 52) >= 2046) { return 1; }
    if ((_geo_absmax_bits(hvec3_sub(p, a)) >> 52) >= 2046) { return 1; }
    return 0;
}

# Closest point on a triangle to a given point (Voronoi region test). Returns HVec3.
public fn geo_closest_point_on_triangle(tri, point) {
    var a = GeoTriangle_v0(tri);
    var b = GeoTriangle_v1(tri);
    var c = GeoTriangle_v2(tri);
    # ⛔ 3.3.3 — A NaN INPUT CAME BACK AS A POINT ON THE TRIANGLE. All fifteen
    # Voronoi tests below are spelled `f64_gt(x, y) != 1` or `f64_lt(x, y) != 1`,
    # TRUE for NaN, so the first test a NaN reached read it as "in this region".
    # On the triangle (0,0,0), (4,0,0), (0,4,0), 3.3.2 returned vertex A (0,0,0)
    # for the query (NaN,NaN,NaN), (NaN,1,0) or (1,1,NaN); with C at (0,NaN,0) it
    # returned A for (-1,1,0), B (4,0,0) for (5,1,0) and the edge-AB point (1,0,0)
    # for (1,-1,0); with B at (NaN,0,0), A for (1,-1,0) and B itself, NaN only in
    # x, for (-1,5,0). Over 5200 NaN inputs — 400 random triangles and queries, a
    # NaN in each of the twelve coordinates and an all-NaN query — every answer
    # came from vertex A (3301), vertex B (1161) or edge AB (738), and every one
    # had a finite component. Now NaN in any coordinate is NaN in all three out.
    # [measured: W1 probe and sweep on the 3.3.2 bundle, not reproducible in-tree, 2026-10-01; cycc 6.6.12]
    #
    # ⭐ THE GUARD IS ON THE INPUTS, NOT ON THE FIFTEEN TESTS, AND THAT IS MEASURED.
    # A NaN also reaches the tests from FINITE input. Scaling 24 random triangles
    # and queries (coordinates below 8) by 2^e for every e in [-1022, 1023], the
    # degree-four `vc`, `vb` and `va` overflow from e = 253 on, and `Inf - Inf` is
    # NaN. There, respelling NaN-false the six tests that decide a NaN input's
    # answer (the other nine are equivalent for it) turned 1799 bit-exact answers
    # into NaN and 255 into a WRONG finite point (the NaN-true edge-BC test then
    # answers; respelling it as well removes those 255), and respelling all
    # fifteen still lost 3072 exact answers, beside the 10778 wrong ones it did
    # turn into NaN. That is the scale class, not repaired here.
    # [measured: W1 sweep, model checked against the 3.3.2 bundle, not reproducible in-tree, 2026-10-01; cycc 6.6.12]
    #
    # ⛔ 3.3.3 — AN INFINITE INPUT IS THE SAME DEFECT ONE STEP LATER, SO THE GUARD
    # IS ON NON-FINITE INPUT, NOT ON NaN ALONE. An infinite coordinate makes its
    # NaN inside (`0 * Inf` in a dot product, `Inf - Inf` in `vc`, `vb` and `va`),
    # the same NaN-true tests read it as region membership, and a vertex or an
    # edge point came back. On the triangle above, 3.3.2 returned B (4,0,0) for
    # (0,+Inf,0), where (0,2^30,0) gives C; A for (1,1,+Inf), where (1,1,2^30)
    # gives (1,1,0); A for (+Inf,-Inf,0), where (2^30,-2^30,0) gives B; and A for
    # (+Inf,+Inf,0), whose finite neighbours land on edge BC: (2,2,0) for
    # (2^30,2^30,0), B for (2^31,2^30,0), C for (2^30,2^31,0). Even (+Inf,0,0) -> B,
    # the limit along +x, came out of that path: d4 = 0 * Inf is NaN and the
    # vertex-B test accepts it. Over 4000 random triangles with one or two infinite
    # query coordinates, 1221 answers were finite and away from the answer with the
    # infinity replaced by 2^30, and none was NaN; with one infinite vertex
    # coordinate, 1686 of 3000 were finite. A guard of `f64_eq(x, x)` leaves every
    # one of those as it was. This one is the house non-finite test, so a NaN or an
    # infinity in any coordinate is NaN in all three out, as a NaN vertex is in
    # `geo_triangle_unit_normal`: the arithmetic cannot form the limit reliably, and
    # (+Inf,+Inf,0) has none. The guard is 0 for every finite input: on a sweep of
    # the shape above, 24 random triangles and queries by 2^e for every e in
    # [-1022, 1023], the 49056 all-finite cases (the other 48 overflow to Inf in
    # the scaling itself), and 39857 mixed-magnitude cases with DBL_MAX, -0 and
    # subnormal coordinates, are bit-identical to 3.3.2.
    # [measured: R4geo sweeps, 3.3.2, 3.3.3-base and repaired bundles, not in-tree, 2026-10-01; cycc 6.6.12]
    # ⚠ THE GUARD REFUSES THE RIGHT ANSWERS WITH THE WRONG ONES. Most infinite
    # queries came out at the limit on 3.3.2, bit-identical to the answer with each
    # infinity replaced by 2^30 and by 2^60: with one infinite query coordinate, 3349
    # of 4000 random triangles and queries (coordinates below 128), against 651
    # wrong; with two, 2233 against 1767; with one infinite vertex coordinate, 1360
    # against 76 wrong and 1859 NaN (705 more had no limit at those scales). Every
    # one is NaN now: the price of refusing the wrong ones (16% with one infinite
    # query coordinate, 44% with two), since nothing inside the routine tells them
    # from the right ones. The siblings keep their 3.3.2 answers at an infinite
    # query, which are the limit where a clamp forms it: geo_segment_closest_point
    # of (+Inf,0,0) on (0,0,0)-(4,0,0) is (4,0,0), and geo_closest_point_on_aabb of
    # (1,1,+Inf) on [0,4] x [0,4] x [0,0] is (1,1,0). On the triangle above, this
    # routine answered those two queries with B (the limit) and A (wrong) on 3.3.2,
    # and NaN now. The family is not aligned here.
    # [measured: R5geo infinite-input sweep and probe, 3.3.2 and repaired bundles, not in-tree, 2026-10-01; cycc 6.6.12]
    # THE GUARD COSTS about 29 ns a call against 3.3.2, +22% (132.9 -> 162.0 and
    # 131.3 -> 159.9 ns, medians of a 64-input scratch row over two interleaved runs
    # of 60 rounds at load 4-7 on 16 cores); no bench row and no caller in src/
    # reaches this function.
    # [measured: R5geo interleaved micro A/B, 3.3.2 vs 3.3.3 trees, not in-tree, 2026-10-01; cycc 6.6.12]
    var nonfinite = _geo_hvec3_nonfinite(a) + _geo_hvec3_nonfinite(b) + _geo_hvec3_nonfinite(c);
    if (nonfinite + _geo_hvec3_nonfinite(point) > 0) {
        var nan = f64_sub(_GEO_F64_POS_INF, _GEO_F64_POS_INF);   # +Inf - +Inf: a quiet NaN
        return hvec3_new(nan, nan, nan);
    }
    var hv = 0;
    var a_ = a;
    var b_ = b;
    var c_ = c;
    var p_ = point;
    # ⛔ 3.3.6 — HALVED ONLY WHEN B, C OR THE QUERY IS 2^1023 OR MORE FROM A
    # (_geo_spread_top_binade), not whenever a coordinate is in the top binade (see
    # geo_triangle_unit_normal): on that note's triangle the query (2^1023, 2 * 2^-1074,
    # 0) got vertex A, not B. Testing c - b, p - b and p - c as well changed no answer
    # in the sweep below, 22 inputs where only one of those reached 2^1023 included.
    # 2^1023 and not overflow alone, because the interior answer sums ab * v + ac * w:
    # unhalved, with ab and ac near DBL_MAX and v + w a rounding above 1, that sum
    # overflowed to -Inf for one random top-binade triangle 3.3.5 answers.
    # Over the 80024 triangles and queries, against the exact closest point (each
    # component within 8 * 2^-53 of max(|exact|, the largest edge component), or a
    # faithful rounding of it): 1317 wrong -> right, and 1 right -> wrong, (-2^-1074, y,
    # 0) for (0, y, 0) inside a triangle with legs of a few 2^-1074, where the interior
    # sum's two 2^-1075 halves round to even: what 3.3.5 answers for that triangle
    # translated exactly to y = 0. Only the cancelling family moved (634 right answers).
    # [measured: C336 row-6 sweep, exact Fraction oracle, 3.3.5 vs this tree, not in-tree, 2026-10-11; cycc 6.6.14]
    if (_geo_top_binade(a, b, c, point) == 1) {
        if (_geo_spread_top_binade(a, b, c, point) == 1) {
            a_ = hvec3_scale(a, F64_HALF);
            b_ = hvec3_scale(b, F64_HALF);
            c_ = hvec3_scale(c, F64_HALF);
            p_ = hvec3_scale(point, F64_HALF);
            hv = 1;
        }
    }
    var ab = hvec3_sub(b_, a_);
    var ac = hvec3_sub(c_, a_);
    var ap = hvec3_sub(p_, a_);
    # ⛔ 3.3.4 — THE SCALE CLASS ABOVE, REPAIRED BY PRE-SCALING (roadmap [3.3.4],
    # carried from 3.3.3). Every region quantity is a dot product of an edge with a
    # point offset (d1..d6, degree two) or a product of two (va, vb, vc, degree
    # four), and each is s^2 or s^4 times itself when all five vectors are
    # multiplied by the same power of two s: the region tests are sign tests and the
    # weights are ratios, so neither changes, and the answer is built from the
    # UNSCALED a, ab, ac, b, c. s takes the larger edge's largest component into
    # [1, 2): the edges set the scale, not the query, because d1..d6 measure the
    # query's offset ALONG the edges, which a query far off the plane does not grow
    # (a scale from the offset, tried first, flushed vc for a query 2^600 above a
    # unit triangle in z = 0 where 3.3.3 is right). Only when the offset would then
    # pass 2^1018, and a dot product with it overflow, is s held to that.
    # 24 random triangles and queries (coordinates below 8) at every 2^e, e in
    # [-1074, 1023]: 28575 of 50304 answers were more than 8 ulp of the triangle's
    # largest coordinate from the exact closest point (16012 below e = 0, 12563 above) and
    # none is now; every exactly scaled input is 2^e times its e = 0 answer, bit for
    # bit (48999, 3.3.3: 21672). The 20 at e = 1021 have an edge past DBL_MAX, and
    # the inputs are halved first there and the answer doubled (_geo_top_binade,
    # _geo_unhalve); 20000 triangles with coordinates up to DBL_MAX: 3305 right
    # before, 19960 now. The right triangle with legs 2^e: 890 of the 1401 legs
    # 2^-700 to 2^700 wrong before, none now.
    # [measured: georay triangle sweeps, exact Fraction oracle, 3.3.3 geo.cyr vs repaired, 2026-10-03; cycc 6.6.14]
    # ⚠ 35 ANSWERS GOT WORSE, AND EACH IS 3.3.3'S OWN AT UNIT SIZE. Over 27395 mixed
    # configurations (translated, thin, near-colinear, near and far queries), 5738
    # moved within 8 ulp of the exact point and 4 moved out, all four within a sine
    # of 3.1e-10 of colinear. Over 14612 with the query 2^-40 to 2^1500 edges off the
    # plane, 4631 moved in and 31 out, all 31 at least 2^100 edges off a plane in
    # general orientation, where the offset's rounding in ab . ap swamps the
    # in-plane part. In each, 3.3.3's d1..d6 or va..vc had flushed or overflowed
    # into the right region (A, or edge AB) by chance, and 3.3.3 scaled to unit size
    # answers it exactly as this does: the Voronoi tests' conditioning, not their
    # range, and not repaired here. Here "8 ulp" is of the triangle's largest
    # coordinate, so a far query's own size does not hide an in-plane error.
    # [measured: georay triangle sweeps, exact Fraction oracle, 3.3.3 geo.cyr vs repaired, 2026-10-03; cycc 6.6.14]
    var ee = _geo_absmax_bits(ab);
    var ec = _geo_absmax_bits(ac);
    if (ec > ee) { ee = ec; }
    ee = ee >> 52;
    var ep = _geo_absmax_bits(ap) >> 52;
    var k = 1023 - ee;
    if (2039 - ep < k) { k = 2039 - ep; }
    var s = _geo_pow2(k);
    var sab = hvec3_scale(ab, s);
    var sac = hvec3_scale(ac, s);
    var sap = hvec3_scale(ap, s);

    var d1 = hvec3_dot(sab, sap);
    var d2 = hvec3_dot(sac, sap);
    # Vertex A region
    if (f64_gt(d1, 0) != 1) {
        if (f64_gt(d2, 0) != 1) {
            return a;
        }
    }

    var bp = hvec3_scale(hvec3_sub(p_, b_), s);
    var d3 = hvec3_dot(sab, bp);
    var d4 = hvec3_dot(sac, bp);
    # Vertex B region
    if (f64_lt(d3, 0) != 1) {
        if (f64_gt(d4, d3) != 1) {
            return b;
        }
    }

    # Edge AB
    # ⛔ 3.3.6 — A ZERO-LENGTH EDGE AB WAS 0 / 0. With A = B (or ab flushed by the scale s)
    # d1 = d3 = 0 passes this region's tests and v = d1 / (d1 - d3) is NaN: a = b = 0, c =
    # (0,0,1), p = (0,0,0.5) gave (NaN, NaN, NaN) for (0,0,0.5), in 3.3.5 too, and the
    # top-binade triangle a = b = (B,0,0), c = (B,0,2^-1074), p = (B,0,1), B =
    # 0x7FE3819AC4F90C8F, that 3.3.5 halved into (B,0,0) became NaN once 3.3.6 stopped
    # halving it. The edge is then a point, and the answer lies on edge AC or at C, whose
    # tests follow (an AC or BC of zero length is caught by vertex B or edge AB first, so
    # their divisions are not 0 / 0).
    # [measured: C336 probe and C2 review sweep, 3.3.5 vs this tree, 2026-10-11; cycc 6.6.14]
    var vc = f64_sub(f64_mul(d1, d4), f64_mul(d3, d2));
    if (f64_gt(vc, 0) != 1) {
        if (f64_lt(d1, 0) != 1) {
            if (f64_gt(d3, 0) != 1) {
                var d13 = f64_sub(d1, d3);
                if (f64_eq(d13, 0) == 0) {
                    var v = f64_div(d1, d13);
                    return _geo_unhalve(hvec3_add(a_, hvec3_scale(ab, v)), hv);
                }
            }
        }
    }

    var cp = hvec3_scale(hvec3_sub(p_, c_), s);
    var d5 = hvec3_dot(sab, cp);
    var d6 = hvec3_dot(sac, cp);
    # Vertex C region
    if (f64_lt(d6, 0) != 1) {
        if (f64_gt(d5, d6) != 1) {
            return c;
        }
    }

    # Edge AC
    var vb = f64_sub(f64_mul(d5, d2), f64_mul(d1, d6));
    if (f64_gt(vb, 0) != 1) {
        if (f64_lt(d2, 0) != 1) {
            if (f64_gt(d6, 0) != 1) {
                var w = f64_div(d2, f64_sub(d2, d6));
                return _geo_unhalve(hvec3_add(a_, hvec3_scale(ac, w)), hv);
            }
        }
    }

    # Edge BC
    var va = f64_sub(f64_mul(d3, d6), f64_mul(d5, d4));
    if (f64_gt(va, 0) != 1) {
        var d4_d3 = f64_sub(d4, d3);
        var d5_d6 = f64_sub(d5, d6);
        if (f64_lt(d4_d3, 0) != 1) {
            if (f64_lt(d5_d6, 0) != 1) {
                var w = f64_div(d4_d3, f64_add(d4_d3, d5_d6));
                return _geo_unhalve(hvec3_add(b_, hvec3_scale(hvec3_sub(c_, b_), w)), hv);
            }
        }
    }

    # Interior
    var denom = f64_div(F64_ONE, f64_add(f64_add(va, vb), vc));
    var v = f64_mul(vb, denom);
    var w = f64_mul(vc, denom);
    return _geo_unhalve(hvec3_add(a_, hvec3_add(hvec3_scale(ab, v), hvec3_scale(ac, w))), hv);
}

# Barycentric coordinates of a point projected onto a triangle.
# Returns an HVec3 where x=u, y=v, z=w such that point ~ u*v0 + v*v1 + w*v2.
public fn geo_barycentric_coords(tri, point) {
    var t0 = GeoTriangle_v0(tri);
    var t1 = GeoTriangle_v1(tri);
    var t2 = GeoTriangle_v2(tri);
    var tp = point;
    var v0 = hvec3_sub(t1, t0);
    var v1 = hvec3_sub(t2, t0);
    var v2 = hvec3_sub(tp, t0);
    # ⛔ 3.3.6 — HALVED ONLY WHEN v0, v1 OR v2 REACHES 2^1023 (or overflows), not
    # whenever a coordinate is in the top binade (see geo_triangle_unit_normal): on that
    # note's triangle the query (2^1023, 2^-1074, 2^-1074) got the centroid where the
    # weights are (-1, 1, 1). Over the 80024 triangles and queries, within 64 * 2^-53 of
    # the largest exact weight: 3672 wrong -> right and 27 right -> wrong, each of the
    # 27 the weights 3.3.5 itself gives that triangle translated exactly to an ordinary
    # position. 23 are exactly colinear, where the Gram form does not cancel to zero and
    # 3.3.5 answered the centroid only because halving rounded the subnormal legs; 4 are
    # thin with subnormal legs (19-50 -> 104-356 * 2^-53: the Gram form's conditioning,
    # not its range). Only the cancelling family moved (82 right answers).
    # [measured: C336 row-6 sweep, exact Fraction oracle, 3.3.5 vs this tree, not in-tree, 2026-10-11; cycc 6.6.14]
    var mo = _geo_absmax_bits(v0);
    var mo1 = _geo_absmax_bits(v1);
    if (mo1 > mo) { mo = mo1; }
    mo1 = _geo_absmax_bits(v2);
    if (mo1 > mo) { mo = mo1; }
    if ((mo >> 52) >= 2046) {
        if (_geo_top_binade(t0, t1, t2, tp) == 1) {
            t0 = hvec3_scale(t0, F64_HALF);
            t1 = hvec3_scale(t1, F64_HALF);
            t2 = hvec3_scale(t2, F64_HALF);
            tp = hvec3_scale(tp, F64_HALF);
            v0 = hvec3_sub(t1, t0);
            v1 = hvec3_sub(t2, t0);
            v2 = hvec3_sub(tp, t0);
        }
    }
    # ⛔ 3.3.4 — PRE-SCALED (roadmap D038): v0, v1 and v2 by the power of two that
    # brings the larger edge's largest component into [1, 2). The weights are degree
    # zero in it, so they are the unit-size answer, bit for bit; the edges set the
    # scale and not the point, because a far point only makes the weights large.
    # See the `denom` note below for what this repairs. ⚠ So a NON-FINITE query with
    # finite edges is scaled too, and its answer need not be 3.3.3's: a right triangle
    # with legs 2^-294 and the query (-Inf, 0, 0) gives NaN weights, where 3.3.3 gave
    # the centroid (102 of 3000 such inputs moved).
    # [measured: barycentric review sweep and probe, 3.3.4-base vs this tree, not in-tree, 2026-10-03; cycc 6.6.14]
    var m = _geo_absmax_bits(v0);
    var m1 = _geo_absmax_bits(v1);
    if (m1 > m) { m = m1; }
    var s = _geo_scale_for(m >> 52);
    if ((m >> 52) < 2047) {
        # As in geo_closest_point_on_triangle: held so the query's offset stays below
        # 2^1015, where d20 * d11 and d21 * d01 cannot overflow.
        var k = 1023 - (m >> 52);
        var ep = _geo_absmax_bits(v2) >> 52;
        if (ep < 2047) {
            if (2037 - ep < k) { k = 2037 - ep; }
        }
        s = _geo_pow2(k);
    }
    v0 = hvec3_scale(v0, s);
    v1 = hvec3_scale(v1, s);
    v2 = hvec3_scale(v2, s);

    var d00 = hvec3_dot(v0, v0);
    var d01 = hvec3_dot(v0, v1);
    var d11 = hvec3_dot(v1, v1);
    var d20 = hvec3_dot(v2, v0);
    var d21 = hvec3_dot(v2, v1);

    var denom = f64_sub(f64_mul(d00, d11), f64_mul(d01, d01));
    # ⛔ `denom` is the Gram determinant — (2*Area)², degree FOUR in the triangle's
    # units — and it was tested against an absolute 1e-12, with a fallback that is a
    # FABRICATION that cannot be told from success: (1/3, 1/3, 1/3) sums to 1 and
    # lies inside the triangle. Measured in 241 of 241 failing samples for a point
    # whose true weights are (0.25, 0.25, 0.5). The threshold became DBL_MIN on the
    # reasoning that only `1 / denom` can fail, at `inv_denom` below.
    # [measured: triangle-scale sweep on the shipped binary]
    # ⛔ 3.3.4 — THAT REASONING WAS WRONG: A DEGREE-FOUR QUANTITY FAILS BEFORE ITS
    # RECIPROCAL. Unscaled, legs at or below 2^-256 flushed d00 * d11 and returned
    # the centroid, and legs at or above 2^256 overflowed it to NaN: 890 of the 1401
    # right triangles with legs 2^-700 to 2^700 were wrong (1587 of 2098 from 2^-1074
    # to 2^1023), and 38031 of 50304 random triangles across every 2^e. With the
    # pre-scaling above none is, nor 18297 of 20000 with coordinates up to DBL_MAX
    # (none right before; the inputs are halved first there, as in
    # geo_triangle_unit_normal). In 27395 mixed configurations no answer within
    # 64 * 2^-53 of the largest exact weight left that band and 9345 entered it.
    # [measured: georay triangle sweeps, exact Fraction oracle, 3.3.3 geo.cyr vs repaired, 2026-10-03; cycc 6.6.14]
    # ⚠ THE GUARD STAYS, AND STILL ANSWERS FOR MORE THAN AN EXACT ZERO. After the
    # scaling, a triangle that is not exactly colinear got the centroid in 1488 of
    # those 27395, every one with the sine of the angle at v0 below about 2^-25.4:
    # there |v0|²|v1|² sin² is under one rounding of d00 * d11, so the Gram form
    # cancels to zero. That is its conditioning, not its range, and not repaired.
    # [measured: georay triangle sweeps, exact Fraction oracle, repaired bundle, 2026-10-03; cycc 6.6.14]
    if (f64_lt(f64_abs(denom), _GEO_F64_TINY) == 1) {
        # Degenerate triangle -- return centroid weights
        return hvec3_new(_GEO_F64_THIRD, _GEO_F64_THIRD, _GEO_F64_THIRD);
    }
    var inv_denom = f64_div(F64_ONE, denom);
    var v = f64_mul(f64_sub(f64_mul(d11, d20), f64_mul(d01, d21)), inv_denom);
    var w = f64_mul(f64_sub(f64_mul(d00, d21), f64_mul(d01, d20)), inv_denom);
    var u = f64_sub(F64_ONE, f64_add(v, w));
    return hvec3_new(u, v, w);
}
