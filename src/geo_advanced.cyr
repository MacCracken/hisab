# geo_advanced.cyr -- advanced geometry: GJK/EPA 3D, BVH, SDF, swept AABB/TOI, CGA
# Usage: include "lib/geo_advanced.cyr"
# Requires: alloc.cyr, math.cyr, vec3.cyr, vec.cyr, fnptr.cyr, geo.cyr, error.cyr, f64_util.cyr
#
# Ported from hisab rust-old/src/geo/{collision,spatial,sdf,cga}.rs
#
# Conventions:
#   - All f64 values are IEEE 754 bit patterns (same as rest of hisab)
#   - Functions returning 1/0 indicate success/failure or true/false
#   - Pointers to output params (out_normal, out_depth, out_t) are written via store64
#   - Support functions are passed as function pointers: fncall2(support_fp, shape, dir)
#   - Multivectors are 256-byte (32 * 8) heap blocks accessed via load64/store64

# ================================================================
# Local f64 constants
# ================================================================

var _GA_F64_QUARTER     = 0x3FD0_0000_0000_0000;  # 0.25
var _GA_F64_NEG_HALF    = 0xBFE0_0000_0000_0000;  # -0.5
var _GA_F64_NEG_ONE     = 0xBFF0_0000_0000_0000;  # -1.0
var _GA_F64_POS_INF     = 0x7FF0_0000_0000_0000;  # +Infinity
var _GA_F64_NEG_INF     = 0xFFF0_0000_0000_0000;  # -Infinity
# _GA_F64_001 (0.01) is gone: its only consumer was time_of_impact's sampling
# step, and an absolute world length was exactly the wrong thing for that loop
# to be built on.

# time_of_impact tolerances.
#   _GA_TOI_REL     relative optimality gap that ends the GJK distance loop
#   _GA_TOI_TOL_REL contact gap, RELATIVE to the Minkowski difference's own
#                   extent along the direction of travel, at which two shapes
#                   count as touching. Relative, so the query behaves the same
#                   on millimetre and on kilometre geometry.
# There is deliberately NO absolute length epsilon here. An earlier draft used
# 1e-24 as a "squared length that counts as zero"; on 1e-6-scale geometry that
# is LOOSER than the contact tolerance itself, and it reported three misses out
# of forty as impacts. Every degeneracy test below is scale-free instead --
# each one compares a quantity against zero or against another quantity of the
# same units, never against a hard-coded world length.
var _GA_TOI_REL         = 0x3D719799812DEA11;     # 1e-12
var _GA_TOI_TOL_REL     = 0x3E112E0BE826D695;     # 1e-9

# GJK/EPA iteration limits
var GJK_MAX_ITER = 64;
# Conservative-advancement step budget for time_of_impact. Distinct from
# GJK_MAX_ITER: that bounds GJK's simplex refinement, this bounds how many
# advancement steps span [0, max_t]. Conflating them capped the search horizon
# at 0.64 units regardless of max_t (see time_of_impact).
var _GA_TOI_MAX_STEPS = 256;
var EPA_MAX_ITER = 64;

# ================================================================
# 1. GJK / EPA 3D collision detection
# ================================================================
#
# The caller provides a support function pointer:
#   support_fp(shape_ptr, direction_hvec3) -> HVec3
#
# This returns the farthest point on the shape in the given direction.
# GJK works on the Minkowski difference: support_A(d) - support_B(-d).

# Minkowski difference support: A(dir) - B(-dir)
fn _gjk_mink_support(sup_a, shape_a, sup_b, shape_b, dir) {
    var pa = fncall2(sup_a, shape_a, dir);
    var neg_dir = hvec3_neg(dir);
    var pb = fncall2(sup_b, shape_b, neg_dir);
    return hvec3_sub(pa, pb);
}

# --- Simplex helpers (tetrahedron-based GJK in 3D) ---
# Simplex stored as flat array: up to 4 HVec3 pointers + count
# Layout: [v0, v1, v2, v3, count] = 40 bytes

fn _gjk_simplex_new() {
    var s = alloc(40);
    store64(s, 0);
    store64(s + 8, 0);
    store64(s + 16, 0);
    store64(s + 24, 0);
    store64(s + 32, 0);  # count = 0
    return s;
}

fn _gjk_simplex_count(s) { return load64(s + 32); }

fn _gjk_simplex_set_count(s, n) { store64(s + 32, n); return 0; }

fn _gjk_simplex_get(s, i) { return load64(s + i * 8); }

fn _gjk_simplex_set(s, i, v) { store64(s + i * 8, v); return 0; }

fn _gjk_simplex_push(s, v) {
    var n = load64(s + 32);
    store64(s + n * 8, v);
    store64(s + 32, n + 1);
    return 0;
}

fn _gjk_simplex_clear(s) {
    store64(s + 32, 0);
    return 0;
}

# Do-simplex for line case (2 points). Returns 1 if origin enclosed, 0 otherwise.
# Updates simplex and direction (dir_ptr is pointer to HVec3 slot).
fn _gjk_do_line(simplex, dir_ptr) {
    var a = _gjk_simplex_get(simplex, 1);  # newest
    var b = _gjk_simplex_get(simplex, 0);
    var ab = hvec3_sub(b, a);
    var ao = hvec3_neg(a);

    if (f64_gt(hvec3_dot(ab, ao), 0) == 1) {
        # Direction perpendicular to AB toward origin: AB x AO x AB
        var tmp = hvec3_cross(ab, ao);
        store64(dir_ptr, hvec3_cross(tmp, ab));
    } else {
        _gjk_simplex_clear(simplex);
        _gjk_simplex_push(simplex, a);
        store64(dir_ptr, ao);
    }
    return 0;
}

# Do-simplex for triangle case (3 points). Returns 1 if origin enclosed in volume sense.
fn _gjk_do_triangle(simplex, dir_ptr) {
    var a = _gjk_simplex_get(simplex, 2);  # newest
    var b = _gjk_simplex_get(simplex, 1);
    var c = _gjk_simplex_get(simplex, 0);
    var ab = hvec3_sub(b, a);
    var ac = hvec3_sub(c, a);
    var ao = hvec3_neg(a);
    var abc = hvec3_cross(ab, ac);

    # Check if origin is outside edge AC (on the side of ABC x AC)
    var abc_x_ac = hvec3_cross(abc, ac);
    if (f64_gt(hvec3_dot(abc_x_ac, ao), 0) == 1) {
        if (f64_gt(hvec3_dot(ac, ao), 0) == 1) {
            # Region AC
            _gjk_simplex_clear(simplex);
            _gjk_simplex_push(simplex, c);
            _gjk_simplex_push(simplex, a);
            var tmp = hvec3_cross(ac, ao);
            store64(dir_ptr, hvec3_cross(tmp, ac));
        } else {
            # Reduce to line AB
            _gjk_simplex_clear(simplex);
            _gjk_simplex_push(simplex, b);
            _gjk_simplex_push(simplex, a);
            _gjk_do_line(simplex, dir_ptr);
        }
        return 0;
    }

    # Check if origin is outside edge AB (on the side of AB x ABC)
    var ab_x_abc = hvec3_cross(ab, abc);
    if (f64_gt(hvec3_dot(ab_x_abc, ao), 0) == 1) {
        _gjk_simplex_clear(simplex);
        _gjk_simplex_push(simplex, b);
        _gjk_simplex_push(simplex, a);
        _gjk_do_line(simplex, dir_ptr);
        return 0;
    }

    # Origin is above or below the triangle
    if (f64_gt(hvec3_dot(abc, ao), 0) == 1) {
        store64(dir_ptr, abc);
    } else {
        # Flip winding
        _gjk_simplex_clear(simplex);
        _gjk_simplex_push(simplex, b);
        _gjk_simplex_push(simplex, c);
        _gjk_simplex_push(simplex, a);
        store64(dir_ptr, hvec3_neg(abc));
    }
    return 0;
}

# Do-simplex for tetrahedron case (4 points). Returns 1 if origin is inside.
fn _gjk_do_tetra(simplex, dir_ptr) {
    var a = _gjk_simplex_get(simplex, 3);  # newest
    var b = _gjk_simplex_get(simplex, 2);
    var c = _gjk_simplex_get(simplex, 1);
    var d = _gjk_simplex_get(simplex, 0);
    var ab = hvec3_sub(b, a);
    var ac = hvec3_sub(c, a);
    var ad = hvec3_sub(d, a);
    var ao = hvec3_neg(a);

    # Face normals, oriented outward (away from opposite vertex)
    var abc = hvec3_cross(ab, ac);
    if (f64_gt(hvec3_dot(abc, ad), 0) == 1) { abc = hvec3_neg(abc); }

    var acd = hvec3_cross(ac, ad);
    if (f64_gt(hvec3_dot(acd, ab), 0) == 1) { acd = hvec3_neg(acd); }

    var adb = hvec3_cross(ad, ab);
    if (f64_gt(hvec3_dot(adb, ac), 0) == 1) { adb = hvec3_neg(adb); }

    # Check each face
    if (f64_gt(hvec3_dot(abc, ao), 0) == 1) {
        _gjk_simplex_clear(simplex);
        _gjk_simplex_push(simplex, c);
        _gjk_simplex_push(simplex, b);
        _gjk_simplex_push(simplex, a);
        return _gjk_do_triangle(simplex, dir_ptr);
    }
    if (f64_gt(hvec3_dot(acd, ao), 0) == 1) {
        _gjk_simplex_clear(simplex);
        _gjk_simplex_push(simplex, d);
        _gjk_simplex_push(simplex, c);
        _gjk_simplex_push(simplex, a);
        return _gjk_do_triangle(simplex, dir_ptr);
    }
    if (f64_gt(hvec3_dot(adb, ao), 0) == 1) {
        _gjk_simplex_clear(simplex);
        _gjk_simplex_push(simplex, b);
        _gjk_simplex_push(simplex, d);
        _gjk_simplex_push(simplex, a);
        return _gjk_do_triangle(simplex, dir_ptr);
    }

    # Origin is inside the tetrahedron
    return 1;
}

# Process the simplex. Returns 1 if origin is enclosed.
fn _gjk_do_simplex(simplex, dir_ptr) {
    var n = _gjk_simplex_count(simplex);
    if (n == 2) { return _gjk_do_line(simplex, dir_ptr); }
    if (n == 3) { return _gjk_do_triangle(simplex, dir_ptr); }
    if (n == 4) { return _gjk_do_tetra(simplex, dir_ptr); }
    return 0;
}

# Core GJK 3D. Returns the simplex pointer if intersecting, 0 if not.
fn _gjk_core_3d(sup_a, shape_a, sup_b, shape_b) {
    var simplex = _gjk_simplex_new();
    var dir = hvec3_unit_x();
    var dir_slot = alloc(8);
    store64(dir_slot, dir);

    var s = _gjk_mink_support(sup_a, shape_a, sup_b, shape_b, dir);
    _gjk_simplex_push(simplex, s);
    store64(dir_slot, hvec3_neg(s));

    for (var gi = 0; gi < GJK_MAX_ITER; gi = gi + 1) {
        dir = load64(dir_slot);
        # 2.9.0: these three tests were `< EPSILON_F64` (1e-12) on a SQUARED
        # length. A scene at scale 1e-9 has |dir|^2 ~ 1e-18, so every direction
        # GJK ever computed was declared degenerate, the search wandered off down
        # a cardinal axis and the whole overlap test failed: two 1e-9 boxes with
        # an exact overlap of 7e-10 came back "no intersection", taking
        # gjk_epa_3d's depth with them. The support function only reads the
        # DIRECTION of `dir`, never its magnitude, so the only value that is
        # genuinely unusable is zero -- and testing against zero is scale-free.
        if (f64_gt(hvec3_length_sq(dir), 0) == 0) {
            # Degenerate direction, pick perpendicular
            if (_gjk_simplex_count(simplex) >= 2) {
                var edge = hvec3_sub(_gjk_simplex_get(simplex, _gjk_simplex_count(simplex) - 1),
                _gjk_simplex_get(simplex, 0));
                dir = hvec3_cross(edge, hvec3_unit_x());
                if (f64_gt(hvec3_length_sq(dir), 0) == 0) {
                    dir = hvec3_cross(edge, hvec3_unit_y());
                }
            } else {
                dir = hvec3_unit_y();
            }
            if (f64_gt(hvec3_length_sq(dir), 0) == 0) {
                dir = hvec3_unit_z();
            }
        }

        var new_pt = _gjk_mink_support(sup_a, shape_a, sup_b, shape_b, dir);
        if (f64_lt(hvec3_dot(new_pt, dir), 0) == 1) {
            return 0;  # No intersection
        }
        _gjk_simplex_push(simplex, new_pt);

        if (_gjk_do_simplex(simplex, dir_slot) == 1) {
            return simplex;  # Intersection found
        }
    }
    return 0;
}

# GJK intersection test (3D). Returns 1 if shapes overlap, 0 otherwise.
# support_a/support_b: function pointers  fn(shape, dir) -> HVec3
fn gjk_intersect_3d(support_a, shape_a, support_b, shape_b) {
    var result = _gjk_core_3d(support_a, shape_a, support_b, shape_b);
    if (result != 0) { return 1; }
    return 0;
}

# --- EPA 3D (Expanding Polytope Algorithm) ---
#
# Expands a tetrahedron that contains the origin, in Minkowski-difference space,
# until the closest supporting plane of the difference is pinned. That plane's
# distance from the origin IS the minimum translation vector: for a convex body
# M with the origin in its interior, min over unit n of h_M(n) equals the
# distance from the origin to M's boundary.
#
# 2.9.0 REWRITE. Three defects, each measured against an exact reference
# (15-axis OBB SAT for box/box in rationals, r0+r1-|c1-c0| for sphere/sphere,
# r-sdBox(c,h) for sphere/box) over a 455-configuration sweep:
#
#   1. THE LOOP HAD A FIXED POINT INSTEAD OF A LIMIT. `_epa_face_normal_dist`
#      flipped a face normal whenever the plane distance came out negative, to
#      "ensure outward", but the visible-face test in the expansion step used the
#      RAW winding normal. When the two disagreed the closest face was never
#      marked visible, so it survived the rebuild, was selected again on the next
#      pass, produced the identical support point, and the polytope stopped
#      growing. Two concentric unit spheres (exact depth 2.0) returned 1.8875 at
#      the 64-iteration cap and still only 1.9794 at 400 -- not iteration
#      starvation, a stall. Every face record now carries ONE oriented normal and
#      both the min-search and the visibility test read that single field.
#
#   2. THE CONVERGENCE TEST WAS ABSOLUTE. `|d - dist| < EPSILON_F64` (1e-12) is
#      unreachable at scene scale 1e3 and is met far too early at 1e-3; the same
#      sphere pair scaled by 1e-3 / 1e3 / 1e6 all came back at 1.078e-5 relative
#      error. Termination is now a two-sided certificate:
#        * the closest face's plane distance is a LOWER bound on the depth (the
#          polytope is inscribed in the difference),
#        * best_d = min over probed directions of h_M(n) is an UPPER bound (every
#          supporting plane already separates the two shapes),
#      and the loop stops when the gap closes to a RELATIVE tolerance. best_d is
#      what gets returned, so the reported depth is always a translation that
#      genuinely separates -- returning the face distance can under-separate.
#
#   3. A DEGENERATE GJK SIMPLEX WAS REPORTED AS "no penetration". The old code
#      bailed with 0 once the seed tetrahedron's volume fell under 1e-12, leaving
#      both out-params unwritten for shapes that provably overlap: box(h=1,1,1)
#      vs sphere(c=(1.2,0,0.7), r=1), exact depth 0.8, came back 2.2e-16. A
#      rejected seed now falls back to the Minkowski portal construction.
#
# DELIBERATELY NOT CHANGED: the visible set is still found by a FULL SCAN over
# every live face. The 2.8.2 heap + flood-fill rewrite was rejected because the
# flood fill under-reports the visible set when rounding splits that set into
# disconnected components; a scan cannot. The per-face record plus in-place
# compaction below is the low-risk half of that proposal (cached face records, no
# alloc per face per iteration) and it is what removes the arena growth.

# Face record: 6 slots, 48 bytes.
#   [0]  i0   [8] i1   [16] i2   vertex indices, wound to match `normal`
#   [24] normal  unit HVec3, outward (pointing away from the origin)
#   [32] dist    plane distance from the origin along `normal`
#   [40] state   0 = removed, 1 = live, 2 = live but zero-area,
#                3 = live but EXHAUSTED (its support point is already a vertex,
#                    so expanding through it cannot grow the hull; it still
#                    bounds the depth from below and still takes part in the
#                    visibility test, it is just never chosen for expansion)
var _EPA_FACE_SIZE = 48;
# Pattern-search budget for _epa_polish: 4 support calls per round, and the
# angular step halves whenever a round finds nothing.
var _EPA_POLISH_ITER = 64;

# Relative convergence tolerance for the EPA upper/lower bound gap. Relative,
# not absolute: see note 2 above.
var _GA_EPA_REL_TOL = 0x3DDB7CDFD9D7BDBB;  # 1e-10
# Fraction of the difference's own extent used to nudge a portal interior point
# that lands exactly on the origin.
var _GA_F64_1EM6    = 0x3EB0C6F7A0B5ED8D;  # 1e-6

# Normalise without EPSILON_F64's ABSOLUTE cutoff. hvec3_normalize returns the
# zero vector for any |v| < 1e-12, which silently kills every direction in a
# scene scaled to 1e-6. Here the only unusable input is a length that is zero,
# subnormal or NaN -- all caught by requiring len > 0.
fn _epa_unit(v) {
    var l = hvec3_length(v);
    if (f64_gt(l, 0) == 0) { return hvec3_zero(); }
    return hvec3_scale(v, f64_div(F64_ONE, l));
}

# Any unit vector perpendicular to v. Crossing with the cardinal axis v is LEAST
# aligned with keeps the cross product well away from zero.
fn _epa_perp(v) {
    var ax = hvec3_unit_x();
    var m = f64_abs(HVec3_x(v));
    if (f64_lt(f64_abs(HVec3_y(v)), m) == 1) {
        ax = hvec3_unit_y();
        m = f64_abs(HVec3_y(v));
    }
    if (f64_lt(f64_abs(HVec3_z(v)), m) == 1) { ax = hvec3_unit_z(); }
    return _epa_unit(hvec3_cross(v, ax));
}

# Store face `fi` and its oriented plane. `iref` selects the orientation rule:
#   iref >= 0 -- orient away from vertex `iref` (the seed tetrahedron, where
#                nothing is yet known about the winding),
#   iref <  0 -- trust the winding, repairing it only if the plane distance comes
#                out strictly negative (faces fanned onto a horizon edge inherit
#                their winding from the face they replace).
# The origin-based repair is applied only for a STRICTLY negative distance, so a
# face that legitimately passes through the origin -- a touching contact -- keeps
# its winding instead of being flipped on the sign of a rounding error.
# Returns 1 for a usable plane, 0 for a zero-area triangle.
fn _epa_face_set(fbuf, fi, verts, i0, i1, i2, iref) {
    var base = fbuf + fi * _EPA_FACE_SIZE;
    var a = load64(verts + i0 * 8);
    var b = load64(verts + i1 * 8);
    var c = load64(verts + i2 * 8);
    var ab = hvec3_sub(b, a);
    var ac = hvec3_sub(c, a);
    var cr = hvec3_cross(ab, ac);
    var len = hvec3_length(cr);
    store64(base, i0);
    store64(base + 8, i1);
    store64(base + 16, i2);
    # |ab x ac| = |ab| |ac| sin(t), so this is the scale-free test sin(t) <= 1e-12.
    # Comparing the area itself against 1e-12 would call every face of a
    # millimetre-scale scene degenerate.
    if (f64_le(len, f64_mul(EPSILON_F64, f64_mul(hvec3_length(ab), hvec3_length(ac)))) == 1) {
        store64(base + 24, hvec3_zero());
        store64(base + 32, _GA_F64_POS_INF);
        store64(base + 40, 2);
        return 0;
    }
    var nrm = hvec3_scale(cr, f64_div(F64_ONE, len));
    var flip = 0;
    if (iref >= 0) {
        if (f64_gt(hvec3_dot(nrm, hvec3_sub(load64(verts + iref * 8), a)), 0) == 1) { flip = 1; }
    } elif (f64_lt(hvec3_dot(nrm, a), 0) == 1) {
        flip = 1;
    }
    if (flip == 1) {
        nrm = hvec3_neg(nrm);
        store64(base + 8, i2);
        store64(base + 16, i1);
    }
    store64(base + 24, nrm);
    store64(base + 32, hvec3_dot(nrm, a));
    store64(base + 40, 1);
    return 1;
}

# Push directed edge (ea, eb) onto the horizon list, cancelling against an
# already-present reversed edge (eb, ea). Two visible faces sharing an edge
# traverse it in opposite directions, so what survives is exactly the boundary of
# the removed region. Returns the new edge count.
fn _epa_edge_push(ebuf, ne, ea, eb) {
    for (var i = 0; i < ne; i = i + 1) {
        if (load64(ebuf + i * 16) == eb && load64(ebuf + i * 16 + 8) == ea) {
            var last = ne - 1;
            store64(ebuf + i * 16, load64(ebuf + last * 16));
            store64(ebuf + i * 16 + 8, load64(ebuf + last * 16 + 8));
            return last;
        }
    }
    store64(ebuf + ne * 16, ea);
    store64(ebuf + ne * 16 + 8, eb);
    return ne + 1;
}

# Signed distance from the origin to the plane of triangle (a, b, c), positive
# on the side that `opp` -- the tetrahedron's fourth vertex -- lies on.
fn _epa_face_gap(a, b, c, opp) {
    var nrm = _epa_unit(hvec3_cross(hvec3_sub(b, a), hvec3_sub(c, a)));
    if (f64_gt(hvec3_length_sq(nrm), 0) == 0) { return _GA_F64_NEG_INF; }
    if (f64_lt(hvec3_dot(nrm, hvec3_sub(opp, a)), 0) == 1) { nrm = hvec3_neg(nrm); }
    return f64_sub(hvec3_dot(nrm, hvec3_sub(hvec3_zero(), a)), 0);
}

# A usable EPA seed: a volume that is non-degenerate RELATIVE to its own edge
# lengths, and the origin STRICTLY inside -- off every face plane by a margin
# scaled to the tetrahedron's own size.
#
# Strictly, not merely "inside or on". _epa_face_set decides a face's outward
# direction from the sign of its plane distance, and that sign is undecidable
# for a plane through the origin. It is not a theoretical worry: the MPR portal
# of any SMOOTH body degenerates exactly this way. v1 is the support point in the
# direction of the origin, so for a ball it is antiparallel to v0 and the origin
# lands ON the v0-v1 EDGE of the portal tetrahedron -- two faces at distance
# zero. Fed to EPA that seed produced 4.0 for two radius-2 spheres whose exact
# depth is 1.3599 (it stalled on iteration 1). Rejecting it here is what routes
# the smooth cases to the GJK seed, which has no such alignment.
fn _epa_tetra_ok(seed) {
    var a = load64(seed);
    var b = load64(seed + 8);
    var c = load64(seed + 16);
    var d = load64(seed + 24);
    var ab = hvec3_sub(b, a);
    var ac = hvec3_sub(c, a);
    var ad = hvec3_sub(d, a);
    var vol = f64_abs(hvec3_dot(ab, hvec3_cross(ac, ad)));
    var la = hvec3_length(ab);
    var lb = hvec3_length(ac);
    var lc = hvec3_length(ad);
    var eref = f64_mul(la, f64_mul(lb, lc));
    if (f64_gt(eref, 0) == 0) { return 0; }
    if (f64_le(vol, f64_mul(EPSILON_F64, eref)) == 1) { return 0; }
    var margin = f64_neg(f64_mul(EPSILON_F64, f64_max(la, f64_max(lb, lc))));
    if (f64_lt(_epa_face_gap(a, b, c, d), margin) == 1) { return 0; }
    if (f64_lt(_epa_face_gap(a, b, d, c), margin) == 1) { return 0; }
    if (f64_lt(_epa_face_gap(a, c, d, b), margin) == 1) { return 0; }
    if (f64_lt(_epa_face_gap(b, c, d, a), margin) == 1) { return 0; }
    return 1;
}

# As _epa_tetra_ok, but the origin must be STRICTLY off every face plane by a
# margin scaled to the tetrahedron's own size. Used to decide whether a candidate
# seed is good enough to prefer over another -- never to reject outright, because
# a tetrahedron whose face happens to pass through the origin is still usable
# once the expansion gets going.
fn _epa_tetra_strict(seed) {
    if (_epa_tetra_ok(seed) == 0) { return 0; }
    var a = load64(seed);
    var b = load64(seed + 8);
    var c = load64(seed + 16);
    var d = load64(seed + 24);
    var lmax = f64_max(hvec3_length(hvec3_sub(b, a)),
    f64_max(hvec3_length(hvec3_sub(c, a)), hvec3_length(hvec3_sub(d, a))));
    var margin = f64_mul(EPSILON_F64, lmax);
    if (f64_le(_epa_face_gap(a, b, c, d), margin) == 1) { return 0; }
    if (f64_le(_epa_face_gap(a, b, d, c), margin) == 1) { return 0; }
    if (f64_le(_epa_face_gap(a, c, d, b), margin) == 1) { return 0; }
    if (f64_le(_epa_face_gap(b, c, d, a), margin) == 1) { return 0; }
    return 1;
}

# Seed from GJK's terminating simplex.
# Returns 0 = shapes do not overlap, 1 = out4 holds a usable tetrahedron,
# 2 = they overlap but the simplex is not a usable seed (caller should fall back).
fn _epa_seed_gjk(sup_a, shape_a, sup_b, shape_b, out4) {
    var simplex = _gjk_core_3d(sup_a, shape_a, sup_b, shape_b);
    if (simplex == 0) { return 0; }
    if (_gjk_simplex_count(simplex) < 4) { return 2; }
    for (var i = 0; i < 4; i = i + 1) { store64(out4 + i * 8, _gjk_simplex_get(simplex, i)); }
    if (_epa_tetra_ok(out4) == 1) { return 1; }
    return 2;
}

# Minkowski portal construction -- XenoCollide phase 1 (discover) plus the
# portal refinement that pushes the portal outward until the origin is on the
# near side of it. Used here as an EPA seed: it ends with a tetrahedron
# (v0, v1, v2, v3) containing the origin, where v0 is an interior point of the
# difference and (v1, v2, v3) is a boundary triangle the ray v0 -> origin
# crosses. Returns 1 when out4 was written, 0 otherwise.
fn _epa_seed_portal(sup_a, shape_a, sup_b, shape_b, out4) {
    var px = _gjk_mink_support(sup_a, shape_a, sup_b, shape_b, hvec3_unit_x());
    var nx = _gjk_mink_support(sup_a, shape_a, sup_b, shape_b, hvec3_neg(hvec3_unit_x()));
    # Midpoint of the difference's x-extent: the midpoint of two of its own
    # points, hence interior. Same interior point _mpr_center picks.
    var v0 = hvec3_scale(hvec3_add(px, nx), F64_HALF);
    var scale = hvec3_length(hvec3_sub(px, nx));
    if (f64_gt(scale, 0) == 0) { return 0; }
    if (f64_le(hvec3_length(v0), f64_mul(EPSILON_F64, scale)) == 1) {
        # v0 IS the origin, so the ray v0 -> origin has no direction. Nudge the
        # interior point rather than the ray: a millionth of the body's own
        # extent cannot leave a body whose x-midpoint is the origin.
        v0 = hvec3_new(f64_mul(_GA_F64_1EM6, scale), 0, 0);
    }

    var dir = _epa_unit(hvec3_neg(v0));
    if (f64_gt(hvec3_length_sq(dir), 0) == 0) { return 0; }
    var v1 = _gjk_mink_support(sup_a, shape_a, sup_b, shape_b, dir);
    if (f64_lt(hvec3_dot(v1, dir), 0) == 1) { return 0; }

    # Second portal vertex: perpendicular to the plane through origin, v0 and v1.
    # When those three are colinear the ray is an axis of symmetry of the
    # difference (two concentric spheres, say) and ANY perpendicular to v0 will
    # do -- the shipped code treated this as a failure and bailed.
    dir = hvec3_cross(v0, v1);
    if (f64_le(hvec3_length(dir),
    f64_mul(EPSILON_F64, f64_mul(hvec3_length(v0), hvec3_length(v1)))) == 1) {
        dir = _epa_perp(v0);
    }
    dir = _epa_unit(dir);
    if (f64_gt(hvec3_length_sq(dir), 0) == 0) { return 0; }
    var v2 = _gjk_mink_support(sup_a, shape_a, sup_b, shape_b, dir);
    if (f64_lt(hvec3_dot(v2, dir), 0) == 1) { return 0; }

    # Third: normal of (v0, v1, v2), pointed along the ray, i.e. away from v0.
    dir = hvec3_cross(hvec3_sub(v1, v0), hvec3_sub(v2, v0));
    if (f64_gt(hvec3_dot(dir, v0), 0) == 1) {
        var sw = v1;
        v1 = v2;
        v2 = sw;
        dir = hvec3_neg(dir);
    }

    var v3 = hvec3_zero();
    var found = 0;
    for (var it = 0; it < GJK_MAX_ITER; it = it + 1) {
        dir = _epa_unit(dir);
        if (f64_gt(hvec3_length_sq(dir), 0) == 0) { return 0; }
        v3 = _gjk_mink_support(sup_a, shape_a, sup_b, shape_b, dir);
        if (f64_lt(hvec3_dot(v3, dir), 0) == 1) { return 0; }
        var cont = 0;
        if (f64_lt(hvec3_dot(hvec3_cross(v1, v3), v0), 0) == 1) {
            v2 = v3;
            cont = 1;
        } elif (f64_lt(hvec3_dot(hvec3_cross(v3, v2), v0), 0) == 1) {
            v1 = v3;
            cont = 1;
        }
        if (cont == 0) {
            found = 1;
            break;
        }
        dir = hvec3_cross(hvec3_sub(v1, v0), hvec3_sub(v2, v0));
    }
    if (found == 0) { return 0; }

    # Push the portal outward until the origin lies between v0 and the portal
    # plane. Only then does the tetrahedron (v0, v1, v2, v3) contain the origin,
    # which is the whole point of building it.
    for (var it = 0; it < GJK_MAX_ITER; it = it + 1) {
        var pn = hvec3_cross(hvec3_sub(v2, v1), hvec3_sub(v3, v1));
        if (f64_lt(hvec3_dot(pn, hvec3_sub(v1, v0)), 0) == 1) { pn = hvec3_neg(pn); }
        pn = _epa_unit(pn);
        if (f64_gt(hvec3_length_sq(pn), 0) == 0) { break; }
        if (f64_ge(hvec3_dot(pn, v1), 0) == 1) { break; }
        var v4 = _gjk_mink_support(sup_a, shape_a, sup_b, shape_b, pn);
        var d4 = hvec3_dot(v4, pn);
        if (f64_lt(d4, 0) == 1) { return 0; }
        if (f64_le(f64_sub(d4, hvec3_dot(v1, pn)),
        f64_mul(EPSILON_F64, f64_abs(d4))) == 1) { break; }
        # Replace whichever portal vertex keeps the ray v0 -> origin inside the
        # portal wedge (libccd's expandPortal decision).
        var v4v0 = hvec3_cross(v4, v0);
        if (f64_gt(hvec3_dot(v1, v4v0), 0) == 1) {
            if (f64_gt(hvec3_dot(v2, v4v0), 0) == 1) { v1 = v4; } else { v3 = v4; }
        } elif (f64_gt(hvec3_dot(v3, v4v0), 0) == 1) {
            v2 = v4;
        } else {
            v1 = v4;
        }
    }

    # PREFER FOUR BOUNDARY POINTS. v0 is an INTERIOR point, and for a smooth body
    # v1 -- the support toward the origin -- is antiparallel to it, so the origin
    # lands exactly ON the v0-v1 edge of the portal tetrahedron. That tetrahedron
    # is a legal portal but a terrible EPA seed: two of its faces pass through the
    # origin, EPA's first probe asks for a support point that is already v3, and
    # the refinement stalls (two radius-2 spheres, exact depth 1.3599, came back
    # 4.0). Swapping v0 for the support point OPPOSITE the portal replaces it with
    # a fourth boundary point and puts the origin strictly inside. Kept only if it
    # really does enclose the origin; otherwise the original portal stands.
    var pn = _epa_unit(hvec3_cross(hvec3_sub(v2, v1), hvec3_sub(v3, v1)));
    if (f64_gt(hvec3_length_sq(pn), 0) == 1) {
        if (f64_lt(hvec3_dot(pn, hvec3_sub(v1, v0)), 0) == 1) { pn = hvec3_neg(pn); }
        var v0b = _gjk_mink_support(sup_a, shape_a, sup_b, shape_b, hvec3_neg(pn));
        store64(out4, v0b);
        store64(out4 + 8, v1);
        store64(out4 + 16, v2);
        store64(out4 + 24, v3);
        if (_epa_tetra_strict(out4) == 1) { return 1; }
    }
    store64(out4, v0);
    store64(out4 + 8, v1);
    store64(out4 + 16, v2);
    store64(out4 + 24, v3);
    return _epa_tetra_ok(out4);
}

# Local pattern search on the DIRECTION, run only when the expansion loop ran out
# of iterations without closing its certificate.
#
# Why this is safe, and why it is not just "more EPA": the returned depth is
# min over probed directions of h_M(n), and EVERY h_M(n) is >= the true MTV
# because every supporting plane already separates the shapes. So probing more
# directions can only lower an upper bound that can never go under the answer --
# monotone, with no way to trade one error for another.
#
# Why it is needed: EPA resolves the direction only as finely as it can afford to
# triangulate a curved surface, and near-concentric smooth bodies are the worst
# case because h_M is almost flat there -- two spheres 0.1 apart left the probe
# direction 0.14 rad off the true one, a 2.7e-4 relative error that no realistic
# iteration budget fixes by triangulating harder. A few dozen support calls do.
# Polytopes never reach here: their certificate closes exactly.
fn _epa_polish(sup_a, shape_a, sup_b, shape_b, n0, d0, out_normal, out_depth) {
    var n = n0;
    var d = d0;
    var step = _GA_F64_QUARTER;  # start at 0.25 rad
    for (var it = 0; it < _EPA_POLISH_ITER; it = it + 1) {
        var u = _epa_perp(n);
        var v = hvec3_cross(n, u);
        var moved = 0;
        for (var k = 0; k < 4; k = k + 1) {
            var t = u;
            if (k == 1) { t = hvec3_neg(u); }
            if (k == 2) { t = v; }
            if (k == 3) { t = hvec3_neg(v); }
            var cand = _epa_unit(hvec3_add(n, hvec3_scale(t, step)));
            if (f64_gt(hvec3_length_sq(cand), 0) == 1) {
                var p = _gjk_mink_support(sup_a, shape_a, sup_b, shape_b, cand);
                var dc = hvec3_dot(p, cand);
                if (f64_lt(dc, d) == 1) {
                    d = dc;
                    n = cand;
                    moved = 1;
                }
            }
        }
        if (moved == 0) {
            step = f64_mul(step, F64_HALF);
            if (f64_lt(step, EPSILON_F64) == 1) { break; }
        }
    }
    store64(out_normal, n);
    store64(out_depth, d);
    return 0;
}

# Expand `seed` (4 HVec3 pointers, a tetrahedron containing the origin) until the
# closest supporting plane of the Minkowski difference is pinned. Writes the unit
# outward normal and the depth. Returns 1 on success, 0 if the seed is unusable.
fn _epa_refine(sup_a, shape_a, sup_b, shape_b, seed, out_normal, out_depth) {
    var vmax = 4 + EPA_MAX_ITER;
    var fmax = 2 * vmax + 8;
    var verts = alloc(vmax * 8);
    var fbuf = alloc(fmax * _EPA_FACE_SIZE);
    var ebuf = alloc(fmax * 3 * 16);
    if (verts == 0 || fbuf == 0 || ebuf == 0) { return 0; }
    for (var i = 0; i < 4; i = i + 1) { store64(verts + i * 8, load64(seed + i * 8)); }
    var nv = 4;
    _epa_face_set(fbuf, 0, verts, 0, 1, 2, 3);
    _epa_face_set(fbuf, 1, verts, 0, 1, 3, 2);
    _epa_face_set(fbuf, 2, verts, 0, 2, 3, 1);
    _epa_face_set(fbuf, 3, verts, 1, 2, 3, 0);
    var nf = 4;

    var best_n = hvec3_unit_x();
    var best_d = _GA_F64_POS_INF;
    var prev_lo = _GA_F64_NEG_INF;
    var certified = 0;
    # Does the seed put the origin strictly inside? If not, `lo` is not a valid
    # lower bound on the depth and the two-sided certificate below cannot be
    # trusted -- see the note at the convergence test.
    var strict = _epa_tetra_strict(seed);
    var eps2 = f64_mul(EPSILON_F64, EPSILON_F64);

    for (var it = 0; it < EPA_MAX_ITER; it = it + 1) {
        # Closest live face -- full scan over every face, deliberately not a
        # heap; see the note at the top of this section.
        # `lo` is the LOWER bound and must range over every live face, exhausted
        # ones included -- dropping them would make the certificate claim more
        # than it knows. `bi` is the face to expand through and must skip them.
        var bi = 0 - 1;
        var lo = _GA_F64_POS_INF;
        var bd_sel = _GA_F64_POS_INF;
        for (var f = 0; f < nf; f = f + 1) {
            var fst = load64(fbuf + f * _EPA_FACE_SIZE + 40);
            var fdi = load64(fbuf + f * _EPA_FACE_SIZE + 32);
            if (fst == 1 || fst == 3) {
                if (f64_lt(fdi, lo) == 1) { lo = fdi; }
            }
            if (fst == 1) {
                if (f64_lt(fdi, bd_sel) == 1) {
                    bd_sel = fdi;
                    bi = f;
                }
            }
        }
        if (bi < 0) { break; }

        var nrm = load64(fbuf + bi * _EPA_FACE_SIZE + 24);
        var p = _gjk_mink_support(sup_a, shape_a, sup_b, shape_b, nrm);
        var d = hvec3_dot(p, nrm);
        if (f64_lt(d, best_d) == 1) {
            best_d = d;
            best_n = nrm;
        }

        # Tolerance relative to the SHAPE scale, not to the depth. EPA's
        # accuracy on a curved surface is set by how finely the polytope
        # approximates it, which is a property of the body, not of how deeply the
        # two overlap: demanding 1e-10 OF A 1e-6 DEPTH asks the hull to track a
        # radius-2 sphere to 1e-16 and simply burns the iteration budget. |p| is
        # a support point of the difference, so it is that body's own scale.
        var tol = f64_mul(_GA_EPA_REL_TOL, f64_max(f64_abs(best_d), hvec3_length(p)));
        if (f64_le(f64_sub(best_d, lo), tol) == 1) {
            # The certificate is only meaningful while the lower bound is
            # POSITIVE. lo <= 0 means a face plane passes through or behind the
            # origin, i.e. the origin sits on the hull rather than inside it --
            # an exactly tangent contact. There the gap can close on a value that
            # is not the depth at all (two spheres touching at exactly 4.0
            # apart, true depth 0, closed the gap at 0.0105), so leave
            # `certified` clear and let the direction polish finish the job.
            # The same applies when the SEED was not strictly enclosing: the
            # lower-bound argument assumes the origin is inside the polytope, so
            # a seed that only just contains it cannot certify anything.
            if (f64_gt(lo, 0) == 1 && strict == 1) { certified = 1; }
            break;
        }
        # The closest-face distance of an EPA polytope can only grow: the hull
        # only ever gains vertices. A decrease proves the last rebuild corrupted
        # the surface -- the exact failure mode that sank the 2.8.2 flood-fill
        # rewrite -- so stop and keep the certified upper bound rather than
        # continue on top of a broken hull.
        if (f64_lt(lo, f64_sub(prev_lo, tol)) == 1) { break; }
        prev_lo = lo;
        if (nv >= vmax) { break; }

        # Support point already on the hull: the polytope cannot grow further.
        var dup = 0;
        for (var q = 0; q < nv; q = q + 1) {
            var vq = load64(verts + q * 8);
            var sc2 = f64_add(hvec3_length_sq(p), hvec3_length_sq(vq));
            if (f64_le(hvec3_length_sq(hvec3_sub(vq, p)), f64_mul(eps2, sc2)) == 1) { dup = 1; }
        }
        if (dup == 1) {
            # The support point through this face is already a hull vertex, so
            # expanding here cannot grow the polytope. Retire the face from the
            # expansion search and take the next one instead of abandoning the
            # whole refinement -- a portal seed on a smooth body reaches this on
            # its FIRST iteration (v3 is exactly the support point the first
            # probe asks for), and breaking there returned 4.0 for two radius-2
            # spheres whose exact depth is 1.3599.
            store64(fbuf + bi * _EPA_FACE_SIZE + 40, 3);
            continue;
        }

        var ne = 0;
        for (var f = 0; f < nf; f = f + 1) {
            var fb = fbuf + f * _EPA_FACE_SIZE;
            var st = load64(fb + 40);
            if (st != 0) {
                var vis = 0;
                if (st == 2) {
                    # Zero-area face: it has no usable plane, so it cannot be
                    # tested. Always retire it -- its edges rejoin the horizon and
                    # the fan re-triangulates the region properly.
                    vis = 1;
                } elif (f64_lt(hvec3_dot(load64(fb + 24), p),
                f64_sub(load64(fb + 32), f64_mul(EPSILON_F64,
                f64_add(f64_abs(load64(fb + 32)), hvec3_length(p))))) == 0) {
                    # COPLANAR FACES MUST GO TOO. A box's Minkowski difference is
                    # a box, so its own face is split into coplanar triangles and
                    # the support point lands EXACTLY on several of their planes.
                    # A strict "> dist" test then removes one and keeps its
                    # coplanar neighbours, the removed region is no longer a disc,
                    # the horizon does not close into one cycle, and the rebuilt
                    # surface folds. That fold was measurable: axis-aligned unit
                    # boxes offset (0.3, 0, -0.39) had the closest-face distance
                    # COLLAPSE 1.5962 -> 0.4879 at iteration 7 and the answer came
                    # out 2.0 against an exact MTV of 1.61. The test is therefore
                    # "not strictly behind the plane", with the slack scaled to
                    # the plane's own magnitude.
                    vis = 1;
                }
                if (vis == 1) {
                    store64(fb + 40, 0);
                    ne = _epa_edge_push(ebuf, ne, load64(fb), load64(fb + 8));
                    ne = _epa_edge_push(ebuf, ne, load64(fb + 8), load64(fb + 16));
                    ne = _epa_edge_push(ebuf, ne, load64(fb + 16), load64(fb));
                }
            }
        }
        if (ne < 3) { break; }

        # Compact the survivors to the front, then fan the horizon onto the new
        # vertex. Compaction keeps `nf` at O(V) instead of accumulating every
        # face ever built.
        var w = 0;
        for (var f = 0; f < nf; f = f + 1) {
            if (load64(fbuf + f * _EPA_FACE_SIZE + 40) != 0) {
                if (w != f) {
                    for (var s = 0; s < 6; s = s + 1) {
                        store64(fbuf + w * _EPA_FACE_SIZE + s * 8,
                        load64(fbuf + f * _EPA_FACE_SIZE + s * 8));
                    }
                }
                w = w + 1;
            }
        }
        nf = w;

        var pi = nv;
        store64(verts + pi * 8, p);
        nv = nv + 1;
        for (var e = 0; e < ne; e = e + 1) {
            if (nf < fmax) {
                _epa_face_set(fbuf, nf, verts, load64(ebuf + e * 16),
                load64(ebuf + e * 16 + 8), pi, 0 - 1);
                nf = nf + 1;
            }
        }
    }

    if (f64_lt(best_d, _GA_F64_POS_INF) == 0) { return 0; }
    if (f64_lt(best_d, 0) == 1) { best_d = 0; }
    if (certified == 0) {
        _epa_polish(sup_a, shape_a, sup_b, shape_b, best_n, best_d, out_normal, out_depth);
        if (f64_lt(load64(out_depth), 0) == 1) { store64(out_depth, 0); }
        return 1;
    }
    store64(out_normal, best_n);
    store64(out_depth, best_d);
    return 1;
}

# Minimum-translation direction for a Minkowski difference that contains the
# origin but has NO VOLUME (a planar patch, a segment, or a point).
#
# EPA cannot run on such a set -- there is no polytope to expand -- but the answer
# is not undefined: a convex set of dimension < 3 containing the origin is escaped
# by ANY translation off its affine hull, so the penetration depth is exactly 0 and
# a valid separating direction is a unit normal of that hull. For a planar set that
# is the plane normal; for a segment, any perpendicular; for a point, anything.
# Returns a UNIT vector in every case, so the caller can always scale by the depth.
#
# The simplex is recomputed rather than read from the seed buffer: _epa_seed_gjk
# returns 2 WITHOUT writing out4 when the simplex has fewer than 4 vertices, which
# is precisely the case that lands here.
fn _epa_degenerate_normal(sup_a, shape_a, sup_b, shape_b) {
    var simplex = _gjk_core_3d(sup_a, shape_a, sup_b, shape_b);
    if (simplex == 0) { return hvec3_unit_x(); }
    var n = _gjk_simplex_count(simplex);
    if (n < 2) { return hvec3_unit_x(); }
    var v0 = _gjk_simplex_get(simplex, 0);

    # First vertex genuinely distinct from v0 gives the hull's primary direction.
    var e1 = hvec3_zero();
    for (var i = 1; i < n; i = i + 1) {
        if (f64_lt(hvec3_length_sq(e1), EPSILON_F64) == 1) {
            e1 = hvec3_sub(_gjk_simplex_get(simplex, i), v0);
        }
    }
    if (f64_lt(hvec3_length_sq(e1), EPSILON_F64) == 1) { return hvec3_unit_x(); }

    # A second direction off that line makes the set planar, and the plane normal
    # is the cross product. If no such direction exists the set is a segment, and
    # any perpendicular to it escapes.
    for (var j = 1; j < n; j = j + 1) {
        var c = hvec3_cross(e1, hvec3_sub(_gjk_simplex_get(simplex, j), v0));
        if (f64_gt(hvec3_length_sq(c), EPSILON_F64) == 1) { return _epa_unit(c); }
    }
    return _epa_unit(_epa_perp(e1));
}

# GJK + EPA 3D: returns 1 if penetrating, writes normal and depth.
# out_normal: pointer where the unit HVec3 normal will be stored
# out_depth: pointer where the f64 depth will be stored
# The normal is the outward normal of the Minkowski difference A (-) B at the
# closest supporting plane, and the depth is h_M(normal) -- translating B by
# depth * normal separates the pair.
fn gjk_epa_3d(support_a, shape_a, support_b, shape_b, out_normal, out_depth) {
    var seed = alloc(32);
    if (seed == 0) { return 0; }
    var s = _epa_seed_gjk(support_a, shape_a, support_b, shape_b, seed);
    if (s == 0) { return 0; }
    if (s != 1) {
        # GJK enclosed the origin but its simplex is flat, or rounding left the
        # origin just outside it. Rebuild from the portal instead of reporting
        # "no penetration" -- that is what made box(h=1,1,1) against
        # sphere(c=(1.2,0,0.7), r=1) return 0 for an exact depth of 0.8.
        if (_epa_seed_portal(support_a, shape_a, support_b, shape_b, seed) == 0) {
            # No portal either: the Minkowski difference has no volume, yet GJK
            # placed the origin inside it (s == 2 means the simplex enclosed the
            # origin). That is a contact of depth 0, not an absence of contact.
            # Returning 0 here left out_normal holding the NULL HVec3 for every
            # caller that trusted "returns 1 => out_normal is a normal" -- the
            # reproducer is two coplanar zero-height boxes.
            store64(out_normal, _epa_degenerate_normal(support_a, shape_a, support_b, shape_b));
            store64(out_depth, 0);
            return 1;
        }
    }
    return _epa_refine(support_a, shape_a, support_b, shape_b, seed, out_normal, out_depth);
}

# ================================================================
# 2. BVH (Bounding Volume Hierarchy)
# ================================================================
#
# Corrected 2.7.0. The description here was wrong in five ways, all of which
# would mislead anyone reading the block before touching it:
#   * it is NOT a flattened arena -- each node is its own alloc(),
#   * nodes are 32 bytes, not 40 (_BVH_NODE_SIZE below),
#   * there is no [32] padding slot; the node is exactly 4 slots,
#   * [8] and [16] hold child POINTERS, not indices,
#   * bvh_build returns the ROOT NODE pointer, not a { nodes_ptr, count } handle.
#
# A binary BVH of individually-allocated nodes. Each node: 32 bytes, 4 slots.
#   [0]  aabb (GeoAabb ptr) -- bounds of this node's whole subtree
#   [8]  left child node ptr   (-1 for a leaf)
#   [16] right child node ptr  (-1 for a leaf)
#   [24] leaf primitive index  (-1 for an internal node)
#
# So `leaf_idx != -1` is the leaf test, and it is the one the query walkers use.
# bvh_build(aabbs, count) returns the root node pointer, or 0 when count == 0.

var _BVH_NODE_SIZE = 32;  # 4 slots * 8 bytes

fn _bvh_node_alloc(aabb, left, right, leaf_idx) {
    var n = alloc(_BVH_NODE_SIZE);
    store64(n, aabb);
    store64(n + 8, left);
    store64(n + 16, right);
    store64(n + 24, leaf_idx);
    return n;
}

fn _bvh_node_aabb(n) { return load64(n); }
fn _bvh_node_left(n) { return load64(n + 8); }
fn _bvh_node_right(n) { return load64(n + 16); }
fn _bvh_node_leaf_idx(n) { return load64(n + 24); }

# CENTROIDS ONCE, BOUNDS WITHOUT A HEAP BLOCK (2.8.3).
#
# The build item grew from 2 slots to 5. The extra three hold the AABB's
# centroid, computed once in bvh_build. Through 2.8.2 the partition loop
# called geo_aabb_center() on every item at every tree level -- two HVec3
# allocations per item per level, i.e. Theta(n log n) allocations for a
# quantity that never changes -- and the range bounds were folded with
# _bvh_aabb_merge, which cost FIVE heap blocks per step (hvec3_min,
# hvec3_max, then geo_aabb_new's own hvec3_min/hvec3_max/alloc). Building a
# 16k-primitive BVH allocated 36.6 MB of never-freed arena.
#
# The fold is now six f64 registers and one GeoAabb per internal node, and
# it is bit-identical to the old one: f64_min/f64_max are exactly what
# hvec3_min/hvec3_max apply componentwise, in the same left-to-right
# argument order (accumulator first), and the centroid is the same
# (min + max) * 0.5. So mid_val, the axis choice and the partition -- hence
# the whole tree shape -- are unchanged, and the repair is checked by
# comparing every node AABB against the pre-2.8.3 build, not just the query
# answers. Measured at n = 16k uniform: 85.3 ms -> 31.2 ms and 36.6 MB ->
# 4.14 MB of arena; at n = 8k coincident, 35.8 ms -> 8.1 ms and 16.7 MB ->
# 2.07 MB. What remains is the one O(n log n) bounds scan a top-down binary
# BVH inherently needs.
var _BVH_ITEM_SIZE = 5;  # aabb_ptr, index, centroid x, y, z

fn _bvh_item_swap(items, i, j) {
    var ib = i * _BVH_ITEM_SIZE;
    var jb = j * _BVH_ITEM_SIZE;
    for (var k = 0; k < _BVH_ITEM_SIZE; k = k + 1) {
        var t = vec_get(items, ib + k);
        vec_set(items, ib + k, vec_get(items, jb + k));
        vec_set(items, jb + k, t);
    }
    return 0;
}

# Build BVH recursively from a vec of {aabb, index, cx, cy, cz} records.
# items: vec of interleaved [aabb_ptr, index, cx, cy, cz, ...] -- item i
#        occupies items[i*5 .. i*5+4]
# start, end: half-open item range
fn _bvh_build_rec(items, start, end) {
    var count = end - start;
    if (count == 1) {
        var aabb = vec_get(items, start * _BVH_ITEM_SIZE);
        var idx = vec_get(items, start * _BVH_ITEM_SIZE + 1);
        return _bvh_node_alloc(aabb, 0 - 1, 0 - 1, idx);
    }

    # Bounding box of the whole range, folded into six registers
    var first = GeoAabb_min(vec_get(items, start * _BVH_ITEM_SIZE));
    var lo_x = HVec3_x(first);
    var lo_y = HVec3_y(first);
    var lo_z = HVec3_z(first);
    first = GeoAabb_max(vec_get(items, start * _BVH_ITEM_SIZE));
    var hi_x = HVec3_x(first);
    var hi_y = HVec3_y(first);
    var hi_z = HVec3_z(first);
    for (var bi = start + 1; bi < end; bi = bi + 1) {
        var box = vec_get(items, bi * _BVH_ITEM_SIZE);
        var bmin = GeoAabb_min(box);
        var bmax = GeoAabb_max(box);
        lo_x = f64_min(lo_x, HVec3_x(bmin));
        lo_y = f64_min(lo_y, HVec3_y(bmin));
        lo_z = f64_min(lo_z, HVec3_z(bmin));
        hi_x = f64_max(hi_x, HVec3_x(bmax));
        hi_y = f64_max(hi_y, HVec3_y(bmax));
        hi_z = f64_max(hi_z, HVec3_z(bmax));
    }

    # Find longest axis
    var sx = f64_abs(f64_sub(hi_x, lo_x));
    var sy = f64_abs(f64_sub(hi_y, lo_y));
    var sz = f64_abs(f64_sub(hi_z, lo_z));
    var axis = 0;
    if (f64_gt(sy, sx) == 1) {
        if (f64_gt(sy, sz) == 1) { axis = 1; } else { axis = 2; }
    } else {
        if (f64_gt(sz, sx) == 1) { axis = 2; }
    }

    # Midpoint of bounding box on chosen axis
    var mid_val = f64_mul(f64_add(lo_x, hi_x), F64_HALF);
    if (axis == 1) { mid_val = f64_mul(f64_add(lo_y, hi_y), F64_HALF); }
    if (axis == 2) { mid_val = f64_mul(f64_add(lo_z, hi_z), F64_HALF); }

    # One GeoAabb per node. geo_aabb_new would re-run hvec3_min/hvec3_max
    # over an already-sorted pair for two more heap blocks; lo_* <= hi_*
    # holds by construction of the fold above.
    var bounds = alloc(sizeof(GeoAabb));
    GeoAabb_set_min(bounds, hvec3_new(lo_x, lo_y, lo_z));
    GeoAabb_set_max(bounds, hvec3_new(hi_x, hi_y, hi_z));

    # Partition: items with center < mid go to left.
    # Centroid components sit at item slots 2, 3, 4 -- so slot 2 + axis.
    var lo = start;
    for (var pi = start; pi < end; pi = pi + 1) {
        var cv = vec_get(items, pi * _BVH_ITEM_SIZE + 2 + axis);
        if (f64_lt(cv, mid_val) == 1) {
            if (pi != lo) { _bvh_item_swap(items, lo, pi); }
            lo = lo + 1;
        }
    }

    # DEGENERATE PARTITION -> MEDIAN, not 1-vs-(n-1).
    #
    # When every center lands on the same side of mid_val, lo never advances.
    # That is not a rare case: for coincident or tightly clustered AABBs every
    # center IS mid_val, and `cv < mid_val` is false for all of them. Through
    # 2.6.15 the clamp here then forced a 1-vs-(n-1) split. Because each level
    # re-merges its whole remaining range to compute `bounds`, that made build
    # cost O(n^2) in both time and arena -- the unfixed sibling of the 2.6.14
    # kdtree_build defect. Splitting at the median restores O(n log n). See the
    # `bvh_degenerate_4k` benchmark for the measured before/after.
    var split = lo;
    if (split <= start) { split = start + count / 2; }
    if (split >= end) { split = start + count / 2; }

    var left = _bvh_build_rec(items, start, split);
    var right = _bvh_build_rec(items, split, end);
    return _bvh_node_alloc(bounds, left, right, 0 - 1);
}

# Build a BVH from arrays of AABBs.
# aabbs: pointer to array of GeoAabb pointers (contiguous, 8 bytes each)
# count: number of AABBs
# Returns BVH root node pointer, or 0 if count == 0.
fn bvh_build(aabbs, count) {
    if (count == 0) { return 0; }
    var items = vec_new();
    for (var bi = 0; bi < count; bi = bi + 1) {
        var box = load64(aabbs + bi * 8);
        var bmin = GeoAabb_min(box);
        var bmax = GeoAabb_max(box);
        vec_push(items, box);
        vec_push(items, bi);
        # Centroid ONCE, here -- the same (min + max) * 0.5 geo_aabb_center
        # returns, but computed n times instead of n per tree level.
        vec_push(items, f64_mul(f64_add(HVec3_x(bmin), HVec3_x(bmax)), F64_HALF));
        vec_push(items, f64_mul(f64_add(HVec3_y(bmin), HVec3_y(bmax)), F64_HALF));
        vec_push(items, f64_mul(f64_add(HVec3_z(bmin), HVec3_z(bmax)), F64_HALF));
    }
    return _bvh_build_rec(items, 0, count);
}

# Does the ray meet the box at any t >= 0? Returns 1 or 0.
#
# THE BVH WALKER NEEDS A PREDICATE, NOT A DISTANCE. geo_ray_aabb returns the hit
# parameter t and uses 0 as its miss sentinel, so "miss" and "hit exactly at
# t = 0" are the same return value. Testing it with `== 0` -- which is what the
# walker did through 2.8.2 -- therefore prunes any node the ray enters at t = 0,
# and pruning a node discards its ENTIRE subtree.
#
# That is not an exotic input. A ray starting on a face of a box, or on the
# shared face of two adjacent boxes, or at the minimum corner of the scene, all
# give t_min = 0 for some node -- and the root's bounds are the whole scene, so
# a ray launched from the scene's minimum corner returned NOTHING at all. On the
# two-unit-box fixture in tests/modules.tcyr the truth is 2 candidates and the
# walker reported 0.
#
# The slab arithmetic below is geo_ray_aabb's, with the final "which t do I
# report" step replaced by the question the caller actually asked: the slab
# intersection must be non-empty (t_min <= t_max) and must reach forward from
# the origin (t_max >= 0). geo_ray_aabb itself is left alone -- its 0-on-miss
# convention is documented, shared with every other geo_ray_* function, and
# depended on elsewhere; the defect was reading a distance as a boolean.
fn _bvh_ray_hits_aabb(ray, aabb) {
    var ox = HVec3_x(GeoRay_origin(ray));
    var oy = HVec3_y(GeoRay_origin(ray));
    var oz = HVec3_z(GeoRay_origin(ray));
    var dx = HVec3_x(GeoRay_direction(ray));
    var dy = HVec3_y(GeoRay_direction(ray));
    var dz = HVec3_z(GeoRay_direction(ray));
    var bmin = GeoAabb_min(aabb);
    var bmax = GeoAabb_max(aabb);

    var t_min = _GA_F64_NEG_INF;
    var t_max = _GA_F64_POS_INF;

    # X slab
    if (f64_lt(f64_abs(dx), EPSILON_F64) == 1) {
        if (f64_lt(ox, HVec3_x(bmin)) == 1) { return 0; }
        if (f64_gt(ox, HVec3_x(bmax)) == 1) { return 0; }
    } else {
        var ix = f64_div(F64_ONE, dx);
        var x1 = f64_mul(f64_sub(HVec3_x(bmin), ox), ix);
        var x2 = f64_mul(f64_sub(HVec3_x(bmax), ox), ix);
        if (f64_gt(x1, x2) == 1) { var xt = x1; x1 = x2; x2 = xt; }
        t_min = f64_max(t_min, x1);
        t_max = f64_min(t_max, x2);
        if (f64_gt(t_min, t_max) == 1) { return 0; }
    }

    # Y slab
    if (f64_lt(f64_abs(dy), EPSILON_F64) == 1) {
        if (f64_lt(oy, HVec3_y(bmin)) == 1) { return 0; }
        if (f64_gt(oy, HVec3_y(bmax)) == 1) { return 0; }
    } else {
        var iy = f64_div(F64_ONE, dy);
        var y1 = f64_mul(f64_sub(HVec3_y(bmin), oy), iy);
        var y2 = f64_mul(f64_sub(HVec3_y(bmax), oy), iy);
        if (f64_gt(y1, y2) == 1) { var yt = y1; y1 = y2; y2 = yt; }
        t_min = f64_max(t_min, y1);
        t_max = f64_min(t_max, y2);
        if (f64_gt(t_min, t_max) == 1) { return 0; }
    }

    # Z slab
    if (f64_lt(f64_abs(dz), EPSILON_F64) == 1) {
        if (f64_lt(oz, HVec3_z(bmin)) == 1) { return 0; }
        if (f64_gt(oz, HVec3_z(bmax)) == 1) { return 0; }
    } else {
        var iz = f64_div(F64_ONE, dz);
        var z1 = f64_mul(f64_sub(HVec3_z(bmin), oz), iz);
        var z2 = f64_mul(f64_sub(HVec3_z(bmax), oz), iz);
        if (f64_gt(z1, z2) == 1) { var zt = z1; z1 = z2; z2 = zt; }
        t_min = f64_max(t_min, z1);
        t_max = f64_min(t_max, z2);
        if (f64_gt(t_min, t_max) == 1) { return 0; }
    }

    # Behind the origin entirely -> not a forward hit, same as geo_ray_aabb.
    if (f64_lt(t_max, 0) == 1) { return 0; }
    return 1;
}

# Query BVH for ray hits. Returns a vec of hit primitive indices.
fn _bvh_query_ray_rec(node, ray, results) {
    if (node == 0) { return 0; }
    var aabb = _bvh_node_aabb(node);
    if (_bvh_ray_hits_aabb(ray, aabb) == 0) { return 0; }

    var leaf_idx = _bvh_node_leaf_idx(node);
    if (leaf_idx != 0 - 1) {
        # Leaf node
        vec_push(results, leaf_idx);
    } else {
        _bvh_query_ray_rec(_bvh_node_left(node), ray, results);
        _bvh_query_ray_rec(_bvh_node_right(node), ray, results);
    }
    return 0;
}

fn bvh_query_ray(bvh, ray) {
    var results = vec_new();
    _bvh_query_ray_rec(bvh, ray, results);
    return results;
}

# Query BVH for AABB overlaps. Returns a vec of overlapping primitive indices.
fn _bvh_query_aabb_rec(node, query, results) {
    if (node == 0) { return 0; }
    var aabb = _bvh_node_aabb(node);
    if (geo_aabb_aabb(aabb, query) == 0) { return 0; }

    var leaf_idx = _bvh_node_leaf_idx(node);
    if (leaf_idx != 0 - 1) {
        vec_push(results, leaf_idx);
    } else {
        _bvh_query_aabb_rec(_bvh_node_left(node), query, results);
        _bvh_query_aabb_rec(_bvh_node_right(node), query, results);
    }
    return 0;
}

fn bvh_query_aabb(bvh, aabb) {
    var results = vec_new();
    _bvh_query_aabb_rec(bvh, aabb, results);
    return results;
}

# ================================================================
# 3. SDF primitives (Signed Distance Fields)
# ================================================================
# All operate on f64 values. Negative = inside, positive = outside.

# Signed distance from point to sphere surface.
fn sdf_sphere(point, center, radius) {
    return f64_sub(hvec3_length(hvec3_sub(point, center)), radius);
}

# Signed distance from point to axis-aligned box.
fn sdf_box(point, center, half_extents) {
    var d = hvec3_sub(hvec3_abs(hvec3_sub(point, center)), half_extents);
    var dx = HVec3_x(d);
    var dy = HVec3_y(d);
    var dz = HVec3_z(d);
    var outside = hvec3_length(hvec3_new(f64_max(dx, 0), f64_max(dy, 0), f64_max(dz, 0)));
    var inside = f64_min(f64_max(dx, f64_max(dy, dz)), 0);
    return f64_add(outside, inside);
}

# Signed distance from point to capsule (segment + radius).
fn sdf_capsule(point, a, b, radius) {
    var ab = hvec3_sub(b, a);
    var ap = hvec3_sub(point, a);
    var t = f64_clamp(f64_div(hvec3_dot(ap, ab), hvec3_dot(ab, ab)), 0, F64_ONE);
    var closest = hvec3_add(a, hvec3_scale(ab, t));
    return f64_sub(hvec3_length(hvec3_sub(point, closest)), radius);
}

# SDF boolean operations
fn sdf_union(d1, d2) { return f64_min(d1, d2); }

fn sdf_intersection(d1, d2) { return f64_max(d1, d2); }

fn sdf_subtraction(d1, d2) { return f64_max(d1, f64_neg(d2)); }

# Smooth union (smooth minimum blending). k controls blend radius.
fn sdf_smooth_union(d1, d2, k) {
    var h = f64_clamp(f64_add(F64_HALF, f64_mul(F64_HALF, f64_div(f64_sub(d2, d1), k))),
    0, F64_ONE);
    var blend = f64_sub(f64_mul(d2, f64_sub(F64_ONE, h)),
    f64_sub(f64_mul(d1, h),
    f64_mul(k, f64_mul(h, f64_sub(F64_ONE, h)))));
    # Correction: d2*(1-h) + d1*h - k*h*(1-h)
    var one_minus_h = f64_sub(F64_ONE, h);
    var r = f64_add(f64_mul(d2, one_minus_h), f64_mul(d1, h));
    r = f64_sub(r, f64_mul(k, f64_mul(h, one_minus_h)));
    return r;
}

# ================================================================
# 4. Swept AABB / Time-of-Impact
# ================================================================

# Expand an AABB along a velocity vector by dt to create a swept volume.
# Returns a new GeoAabb that encloses the original and the displaced AABB.
fn swept_aabb(aabb, velocity, dt) {
    var displacement = hvec3_scale(velocity, dt);
    var end_min = hvec3_add(GeoAabb_min(aabb), displacement);
    var end_max = hvec3_add(GeoAabb_max(aabb), displacement);
    return geo_aabb_new(hvec3_min(GeoAabb_min(aabb), end_min),
    hvec3_max(GeoAabb_max(aabb), end_max));
}

# --- GJK distance sub-algorithm (used only by time_of_impact) --------------
#
# WHY A DISTANCE AND NOT A BOOLEAN.
#
# `time_of_impact` advertises conservative advancement, but through 2.8.2 it was
# a fixed-step SAMPLER: it walked t from 0 to max_t in _GA_TOI_MAX_STEPS equal
# steps and asked gjk_intersect_3d "do they overlap NOW?" at each one. A boolean
# overlap test carries no information about how far away the shapes are, so the
# step length could only be chosen from the horizon, never from the geometry.
# The overlap window in t has width ~2R/|v_rel| (R the contact radius), so any
# pair whose shapes are small, or fast, or whose horizon is long, has a window
# narrower than the step and is tunnelled straight through -- reported as "no
# collision" with no error signal. 2.7.0-B fixed the horizon budget; the step
# being blind to geometry is a different defect in the same loop.
#
# Conservative advancement needs the DISTANCE. Everything below computes the
# nearest point of a convex set to the ORIGIN via the standard GJK distance
# sub-algorithm, so the loop can take a step that is provably no larger than the
# time remaining to contact. That cannot tunnel by construction: it never
# advances past the first contact, so there is no window to step over.

# Closest point of segment [a, b] to the ORIGIN.
# out_mask receives the endpoints that span the answer: 1 = a, 2 = b, 3 = both.
fn _toi_seg_closest(a, b, out_mask) {
    var ab = hvec3_sub(b, a);
    var d2 = hvec3_dot(ab, ab);
    # Only an EXACTLY coincident pair is degenerate. For a merely short segment
    # the t below loses precision but is then clamped into [0, 1], so the answer
    # still lies between two points that are themselves nearly identical.
    if (f64_le(d2, 0) == 1) {
        store64(out_mask, 1);
        return a;
    }
    var t = f64_div(f64_neg(hvec3_dot(a, ab)), d2);
    if (f64_le(t, 0) == 1) {
        store64(out_mask, 1);
        return a;
    }
    if (f64_ge(t, F64_ONE) == 1) {
        store64(out_mask, 2);
        return b;
    }
    store64(out_mask, 3);
    return hvec3_add(a, hvec3_scale(ab, t));
}

# Closest point of triangle (a, b, c) to the ORIGIN, by Voronoi region.
# out_mask bits: 1 = a, 2 = b, 4 = c.
fn _toi_tri_closest(a, b, c, out_mask) {
    var ab = hvec3_sub(b, a);
    var ac = hvec3_sub(c, a);
    var ap = hvec3_neg(a);
    var d1 = hvec3_dot(ab, ap);
    var d2 = hvec3_dot(ac, ap);
    if (f64_le(d1, 0) == 1 && f64_le(d2, 0) == 1) {
        store64(out_mask, 1);
        return a;
    }

    var bp = hvec3_neg(b);
    var d3 = hvec3_dot(ab, bp);
    var d4 = hvec3_dot(ac, bp);
    if (f64_ge(d3, 0) == 1 && f64_le(d4, d3) == 1) {
        store64(out_mask, 2);
        return b;
    }

    var vc = f64_sub(f64_mul(d1, d4), f64_mul(d3, d2));
    if (f64_le(vc, 0) == 1 && f64_ge(d1, 0) == 1 && f64_le(d3, 0) == 1) {
        store64(out_mask, 3);
        return hvec3_add(a, hvec3_scale(ab, f64_div(d1, f64_sub(d1, d3))));
    }

    var cp = hvec3_neg(c);
    var d5 = hvec3_dot(ab, cp);
    var d6 = hvec3_dot(ac, cp);
    if (f64_ge(d6, 0) == 1 && f64_le(d5, d6) == 1) {
        store64(out_mask, 4);
        return c;
    }

    var vb = f64_sub(f64_mul(d5, d2), f64_mul(d1, d6));
    if (f64_le(vb, 0) == 1 && f64_ge(d2, 0) == 1 && f64_le(d6, 0) == 1) {
        store64(out_mask, 5);
        return hvec3_add(a, hvec3_scale(ac, f64_div(d2, f64_sub(d2, d6))));
    }

    var va = f64_sub(f64_mul(d3, d6), f64_mul(d5, d4));
    var d43 = f64_sub(d4, d3);
    var d56 = f64_sub(d5, d6);
    if (f64_le(va, 0) == 1 && f64_ge(d43, 0) == 1 && f64_ge(d56, 0) == 1) {
        store64(out_mask, 6);
        return hvec3_add(b, hvec3_scale(hvec3_sub(c, b), f64_div(d43, f64_add(d43, d56))));
    }

    # Reaching here means the origin projects into the FACE region, where the
    # three barycentric numerators are all strictly positive; den <= 0 is
    # therefore possible only for a colinear triangle. Comparing against zero
    # keeps the test scale-free -- va/vb/vc carry length^4, so any absolute
    # epsilon would be wrong by twelve orders of magnitude per metre of scale.
    var den = f64_add(f64_add(va, vb), vc);
    if (f64_le(den, 0) == 1) {
        return _toi_seg_closest(a, b, out_mask);
    }
    var inv = f64_div(F64_ONE, den);
    store64(out_mask, 7);
    return hvec3_add(a, hvec3_add(hvec3_scale(ab, f64_mul(vb, inv)),
    hvec3_scale(ac, f64_mul(vc, inv))));
}

# Is the ORIGIN on the far side of plane(a, b, c) from d? Coplanar counts as
# "outside" so a degenerate tetrahedron still has all four faces examined --
# its hull is then contained in the union of its faces, so the minimum over the
# faces is still the right answer.
fn _toi_outside_plane(a, b, c, d) {
    var n = hvec3_cross(hvec3_sub(b, a), hvec3_sub(c, a));
    var sp = hvec3_dot(hvec3_neg(a), n);
    var sd = hvec3_dot(hvec3_sub(d, a), n);
    if (f64_gt(f64_mul(sp, sd), 0) == 1) { return 0; }
    return 1;
}

# Remap a triangle mask (bits over the triangle's own 3 vertices) onto the
# tetrahedron's 4-vertex numbering. b0/b1/b2 are the tetra bits of the face.
fn _toi_remap(m, b0, b1, b2) {
    var r = 0;
    if (m % 2 == 1) { r = r + b0; }
    if ((m / 2) % 2 == 1) { r = r + b1; }
    if ((m / 4) % 2 == 1) { r = r + b2; }
    return r;
}

# Closest point of tetrahedron (a, b, c, d) to the ORIGIN.
# out_mask bits: 1 = a, 2 = b, 4 = c, 8 = d. Mask 15 means the origin is INSIDE.
fn _toi_tetra_closest(a, b, c, d, out_mask) {
    var best = hvec3_zero();
    var best2 = _GA_F64_POS_INF;
    var best_mask = 0;
    var any_out = 0;
    var fm = alloc(8);

    if (_toi_outside_plane(a, b, c, d) == 1) {
        any_out = 1;
        var p1 = _toi_tri_closest(a, b, c, fm);
        var q1 = hvec3_length_sq(p1);
        if (f64_lt(q1, best2) == 1) {
            best2 = q1;
            best = p1;
            best_mask = _toi_remap(load64(fm), 1, 2, 4);
        }
    }
    if (_toi_outside_plane(a, c, d, b) == 1) {
        any_out = 1;
        var p2 = _toi_tri_closest(a, c, d, fm);
        var q2 = hvec3_length_sq(p2);
        if (f64_lt(q2, best2) == 1) {
            best2 = q2;
            best = p2;
            best_mask = _toi_remap(load64(fm), 1, 4, 8);
        }
    }
    if (_toi_outside_plane(a, d, b, c) == 1) {
        any_out = 1;
        var p3 = _toi_tri_closest(a, d, b, fm);
        var q3 = hvec3_length_sq(p3);
        if (f64_lt(q3, best2) == 1) {
            best2 = q3;
            best = p3;
            best_mask = _toi_remap(load64(fm), 1, 8, 2);
        }
    }
    if (_toi_outside_plane(b, d, c, a) == 1) {
        any_out = 1;
        var p4 = _toi_tri_closest(b, d, c, fm);
        var q4 = hvec3_length_sq(p4);
        if (f64_lt(q4, best2) == 1) {
            best2 = q4;
            best = p4;
            best_mask = _toi_remap(load64(fm), 2, 8, 4);
        }
    }

    if (any_out == 0) {
        # The origin is on the inner side of all four faces -- it is inside.
        store64(out_mask, 15);
        return hvec3_zero();
    }
    store64(out_mask, best_mask);
    return best;
}

# Reduce the simplex held in `w` (up to 4 HVec3 pointers, count at cnt_ptr) to
# the smallest face that supports the closest point, and return that point.
fn _toi_simplex_closest(w, cnt_ptr) {
    var n = load64(cnt_ptr);
    if (n <= 1) { return load64(w); }

    var mk = alloc(8);
    var pt = 0;
    if (n == 2) {
        pt = _toi_seg_closest(load64(w), load64(w + 8), mk);
    } elif (n == 3) {
        pt = _toi_tri_closest(load64(w), load64(w + 8), load64(w + 16), mk);
    } else {
        pt = _toi_tetra_closest(load64(w), load64(w + 8), load64(w + 16), load64(w + 24), mk);
    }

    var mask = load64(mk);
    var keep = 0;
    var i = 0;
    var bit = 1;
    while (i < n) {
        if ((mask / bit) % 2 == 1) {
            store64(w + keep * 8, load64(w + i * 8));
            keep = keep + 1;
        }
        bit = bit * 2;
        i = i + 1;
    }
    store64(cnt_ptr, keep);
    return pt;
}

# Support point of the Minkowski difference A - B, translated by -offset.
# The whole TOI search runs against the FIXED difference A - B with a moving
# query point rel_vel * t, so `offset` is that query point and nothing else
# needs re-wrapping per step (the pre-2.8.3 loop allocated a 24-byte support
# descriptor on every one of up to 256 iterations, into a never-freeing bump
# allocator, purely to express this subtraction).
fn _toi_msup(sup_a, shape_a, sup_b, shape_b, offset, dir) {
    return hvec3_sub(_gjk_mink_support(sup_a, shape_a, sup_b, shape_b, dir), offset);
}

# Nearest point of (A - B - offset) to the ORIGIN.
#   out_v:  receives that point. |out_v| is an UPPER bound on the distance,
#           because the point is a genuine member of the set.
#   out_lb: receives a LOWER bound, valid even if the iteration is cut short --
#           it comes from a supporting plane, which is a certificate rather than
#           an estimate. Conservative advancement steps on this one.
# Returns 1 if the origin is inside (the shapes overlap), 0 otherwise.
fn _toi_near_point(sup_a, shape_a, sup_b, shape_b, offset, seed_dir, out_v, out_lb) {
    var w = alloc(40);          # 4 vertex slots + count at +32, hoisted
    var v = _toi_msup(sup_a, shape_a, sup_b, shape_b, offset, seed_dir);
    store64(w, v);
    store64(w + 32, 1);

    var best = v;
    var best2 = hvec3_length_sq(v);
    var lb = 0;
    store64(out_lb, 0);

    for (var it = 0; it < GJK_MAX_ITER; it = it + 1) {
        var vv = hvec3_length_sq(v);
        # Exactly on the origin: the sets touch. Anything larger than that is
        # left to the CALLER's scale-relative contact tolerance -- deciding
        # "close enough" here with an absolute length is what made this query
        # report grazing misses as impacts on micro-scale geometry.
        if (f64_le(vv, 0) == 1) {
            store64(out_v, v);
            store64(out_lb, 0);
            return 1;
        }

        var p = _toi_msup(sup_a, shape_a, sup_b, shape_b, offset, hvec3_neg(v));
        var vp = hvec3_dot(v, p);
        if (f64_gt(vp, 0) == 1) {
            var cand = f64_div(vp, f64_sqrt(vv));
            if (f64_gt(cand, lb) == 1) { lb = cand; }
        }

        # Optimality: v is the projection of the origin onto the whole set once
        # no support point lies closer to the origin along v than v itself.
        if (f64_le(f64_sub(vv, vp), f64_mul(_GA_TOI_REL, vv)) == 1) { break; }

        var cnt = load64(w + 32);
        store64(w + cnt * 8, p);
        store64(w + 32, cnt + 1);
        v = _toi_simplex_closest(w, w + 32);

        if (load64(w + 32) == 4) {
            # The reduced simplex is the full tetrahedron: the origin is in it.
            store64(out_v, hvec3_zero());
            store64(out_lb, lb);
            return 1;
        }

        var nv2 = hvec3_length_sq(v);
        if (f64_lt(nv2, best2) == 1) {
            best = v;
            best2 = nv2;
        } else {
            # No improvement -- a near-degenerate simplex made the barycentric
            # solve unreliable. |v| is monotone in exact arithmetic, so this is
            # a rounding event, not a geometry event: keep the best point.
            v = best;
            break;
        }
    }

    store64(out_v, v);
    store64(out_lb, lb);
    return 0;
}

# Compute time of impact between two moving convex shapes.
#
# Conservative advancement (Mirtich): at each step measure the distance d
# between the shapes at the current t, then advance by d / (rel_vel . n) where n
# is the direction of closest approach. Because d is a distance and the shapes
# translate at a bounded rate along n, that step provably cannot reach contact,
# so t only ever approaches the true impact time FROM BELOW and never steps over
# it. Two facts fall out that the pre-2.8.3 sampler could not provide:
#   * rel_vel . n <= 0 is a PROOF of "no collision, ever" (not "none sampled");
#   * the reported t is a lower bound on the true impact time, tight to the
#     contact tolerance, rather than an over-estimate quantised to the step.
#
# support_a/b, shape_a/b: support function pointers and shape data
# vel_a, vel_b: HVec3 velocities
# max_t: f64 maximum time horizon
# out_t: pointer where f64 time of impact will be stored
# out_normal: pointer where the HVec3 contact normal will be stored -- always a
#             unit vector, never 0 (the direction of closest approach at impact)
# Returns 1 if collision found within max_t, 0 otherwise.
#
# CONTACT TOLERANCE. Impact is declared once the gap falls under
# _GA_TOI_TOL_REL times the Minkowski difference's own extent along the motion,
# i.e. relative to the size of the two shapes rather than to any world scale.
# A pass that misses by less than that reads as a touch, which is the standard
# and unavoidable contract for a continuous query on floating point.
fn time_of_impact(support_a, shape_a, vel_a, support_b, shape_b, vel_b, max_t, out_t, out_normal) {
    # Overlap at t = 0.
    if (gjk_intersect_3d(support_a, shape_a, support_b, shape_b) == 1) {
        store64(out_t, 0);
        var n_slot = alloc(8);
        var d_slot = alloc(8);
        gjk_epa_3d(support_a, shape_a, support_b, shape_b, n_slot, d_slot);
        var n0 = load64(n_slot);
        # EPA returns 0 on a degenerate polytope and left out_normal holding a
        # NULL pointer for every caller that dereferenced it.
        if (n0 == 0) { n0 = hvec3_unit_x(); }
        store64(out_normal, n0);
        return 1;
    }

    var rel_vel = hvec3_sub(vel_b, vel_a);
    var speed = hvec3_length(rel_vel);
    if (f64_lt(speed, EPSILON_F64) == 1) { return 0; }

    # Contact tolerance from the geometry, not from the horizon: the extent of
    # the Minkowski difference along the direction of travel is exactly
    # (diameter of A + diameter of B) in that direction, independent of how far
    # apart the two shapes start.
    var u0 = hvec3_scale(rel_vel, f64_div(F64_ONE, speed));
    var ext_p = _gjk_mink_support(support_a, shape_a, support_b, shape_b, u0);
    var ext_n = _gjk_mink_support(support_a, shape_a, support_b, shape_b, hvec3_neg(u0));
    var gscale = hvec3_length(hvec3_sub(ext_p, ext_n));
    # Two point shapes have no extent; then the only length in the problem is
    # how far apart they are, so use that instead of a fabricated 1.0.
    if (f64_le(gscale, 0) == 1) { gscale = hvec3_length(ext_p); }
    if (f64_le(gscale, 0) == 1) { gscale = F64_ONE; }
    var tol = f64_mul(gscale, _GA_TOI_TOL_REL);

    var v_slot = alloc(8);
    var lb_slot = alloc(8);
    var t = 0;
    var seed = hvec3_neg(rel_vel);

    for (var ti = 0; ti < _GA_TOI_MAX_STEPS; ti = ti + 1) {
        var offset = hvec3_scale(rel_vel, t);
        var inside = _toi_near_point(support_a, shape_a, support_b, shape_b,
        offset, seed, v_slot, lb_slot);
        var v = load64(v_slot);
        var dist = hvec3_length(v);

        if (inside == 1 || f64_le(dist, tol) == 1) {
            store64(out_t, t);
            var nrm = hvec3_unit_x();
            if (f64_gt(dist, 0) == 1) { nrm = hvec3_scale(v, f64_div(F64_ONE, dist)); }
            store64(out_normal, nrm);
            return 1;
        }

        var u = hvec3_scale(v, f64_div(F64_ONE, dist));
        var denom = hvec3_dot(rel_vel, u);
        if (f64_le(denom, 0) == 1) {
            # PROOF of no collision: every point of the Minkowski difference is
            # on the far side of the plane through v with normal u, and the
            # query point rel_vel * t moves away from (or parallel to) that
            # plane. No later t can put it inside. This is the branch the old
            # sampler could never take -- it could only run out of samples.
            return 0;
        }

        var lb = load64(lb_slot);
        if (f64_lt(lb, tol) == 1) { lb = tol; }
        t = f64_add(t, f64_div(lb, denom));
        if (f64_gt(t, max_t) == 1) { return 0; }
        seed = hvec3_neg(v);
    }
    return 0;
}

# ================================================================
# 5. CGA (Conformal Geometric Algebra)
# ================================================================
#
# 5D multivector: 32 f64 components = 256 bytes.
# Metric: e1^2 = e2^2 = e3^2 = ep^2 = +1, em^2 = -1
#
# Blade index layout (lexicographic):
#   Grade 0: [0]   = scalar
#   Grade 1: [1]=e1, [2]=e2, [3]=e3, [4]=ep, [5]=em
#   Grade 2: [6]=e12, [7]=e13, [8]=e1p, [9]=e1m, [10]=e23, [11]=e2p, [12]=e2m,
#            [13]=e3p, [14]=e3m, [15]=epm
#   Grade 3: [16]=e123, [17]=e12p, [18]=e12m, [19]=e13p, [20]=e13m, [21]=e1pm,
#            [22]=e23p, [23]=e23m, [24]=e2pm, [25]=e3pm
#   Grade 4: [26]=e123p, [27]=e123m, [28]=e12pm, [29]=e13pm, [30]=e23pm
#   Grade 5: [31] = e123pm (pseudoscalar)
#
# Access: load64(mv + idx * 8), store64(mv + idx * 8, val)

var CGA_NUM_BLADES = 32;
var CGA_MV_SIZE = 256;  # 32 * 8 bytes

# Blade-to-bitmask table (e1=bit0, e2=bit1, e3=bit2, ep=bit3, em=bit4)
# Stored as a flat array of 32 bytes (one u8 per blade, packed in i64 words)
fn _cga_blade_bits(idx) {
    # Inlined lookup table (each value is the bitmask for that blade index)
    if (idx == 0)  { return 0; }     # scalar
    if (idx == 1)  { return 1; }     # e1
    if (idx == 2)  { return 2; }     # e2
    if (idx == 3)  { return 4; }     # e3
    if (idx == 4)  { return 8; }     # ep
    if (idx == 5)  { return 16; }    # em
    if (idx == 6)  { return 3; }     # e12
    if (idx == 7)  { return 5; }     # e13
    if (idx == 8)  { return 9; }     # e1p
    if (idx == 9)  { return 17; }    # e1m
    if (idx == 10) { return 6; }     # e23
    if (idx == 11) { return 10; }    # e2p
    if (idx == 12) { return 18; }    # e2m
    if (idx == 13) { return 12; }    # e3p
    if (idx == 14) { return 20; }    # e3m
    if (idx == 15) { return 24; }    # epm
    if (idx == 16) { return 7; }     # e123
    if (idx == 17) { return 11; }    # e12p
    if (idx == 18) { return 19; }    # e12m
    if (idx == 19) { return 13; }    # e13p
    if (idx == 20) { return 21; }    # e13m
    if (idx == 21) { return 25; }    # e1pm
    if (idx == 22) { return 14; }    # e23p
    if (idx == 23) { return 22; }    # e23m
    if (idx == 24) { return 26; }    # e2pm
    if (idx == 25) { return 28; }    # e3pm
    if (idx == 26) { return 15; }    # e123p
    if (idx == 27) { return 23; }    # e123m
    if (idx == 28) { return 27; }    # e12pm
    if (idx == 29) { return 29; }    # e13pm
    if (idx == 30) { return 30; }    # e23pm
    if (idx == 31) { return 31; }    # e123pm
    return 0;
}

# Reverse lookup: bitmask -> blade index
fn _cga_bits_blade(bits) {
    for (var bi = 0; bi < 32; bi = bi + 1) {
        if (_cga_blade_bits(bi) == bits) { return bi; }
    }
    return 0;
}

# Grade of a blade
fn _cga_blade_grade(idx) {
    if (idx == 0) { return 0; }
    if (idx <= 5) { return 1; }
    if (idx <= 15) { return 2; }
    if (idx <= 25) { return 3; }
    if (idx <= 30) { return 4; }
    return 5;
}

# Count set bits in a 5-bit mask
fn _cga_popcount5(x) {
    var c = 0;
    if ((x & 1) != 0) { c = c + 1; }
    if ((x & 2) != 0) { c = c + 1; }
    if ((x & 4) != 0) { c = c + 1; }
    if ((x & 8) != 0) { c = c + 1; }
    if ((x & 16) != 0) { c = c + 1; }
    return c;
}

# Geometric product of two basis blades.
# Returns sign * 256 + result_blade_index (packed).
# Sign: 0 = zero, 1 = positive, 2 = negative (sign = 1 - (packed >> 8) * 2... etc)
# Actually, let's return two values via a 16-byte struct: {sign_i32, blade_idx}
fn _cga_geo_blades(a, b) {
    var bits_a = _cga_blade_bits(a);
    var bits_b = _cga_blade_bits(b);

    var sign = 1;
    var bb = bits_b;

    # Count sign from reordering: for each bit in a (high to low),
    # count how many lower bits in b need to swap past it
    for (var bi = 4; bi >= 0; bi = bi - 1) {
        if ((bits_a & (1 << bi)) != 0) {
            var mask = (1 << bi) - 1;
            var count = _cga_popcount5(bb & mask);
            if ((count & 1) != 0) { sign = 0 - sign; }

            # If both have this basis vector, apply metric and remove
            if ((bb & (1 << bi)) != 0) {
                # em (bit 4) squares to -1, all others to +1
                if (bi == 4) { sign = 0 - sign; }
                bb = bb ^ (1 << bi);
            }
        }
    }

    var result_bits = (bits_a ^ bits_b) & 31;
    var result_blade = _cga_bits_blade(result_bits);

    # Pack: sign in high word, blade in low
    var packed = alloc(16);
    store64(packed, sign);
    store64(packed + 8, result_blade);
    return packed;
}

# Allocate a zero multivector
fn cga_mv_zero() {
    var mv = alloc(CGA_MV_SIZE);
    for (var zi = 0; zi < 32; zi = zi + 1) {
        store64(mv + zi * 8, 0);
    }
    return mv;
}

# Get component at blade index
fn cga_mv_get(mv, idx) { return load64(mv + idx * 8); }

# Set component at blade index
fn cga_mv_set(mv, idx, val) { store64(mv + idx * 8, val); return 0; }

# Clone a multivector
fn cga_mv_clone(mv) {
    var r = alloc(CGA_MV_SIZE);
    for (var ci = 0; ci < 32; ci = ci + 1) {
        store64(r + ci * 8, load64(mv + ci * 8));
    }
    return r;
}

# Add two multivectors
fn cga_mv_add(a, b) {
    var r = alloc(CGA_MV_SIZE);
    for (var ai = 0; ai < 32; ai = ai + 1) {
        store64(r + ai * 8, f64_add(load64(a + ai * 8), load64(b + ai * 8)));
    }
    return r;
}

# Subtract two multivectors
fn cga_mv_sub(a, b) {
    var r = alloc(CGA_MV_SIZE);
    for (var si = 0; si < 32; si = si + 1) {
        store64(r + si * 8, f64_sub(load64(a + si * 8), load64(b + si * 8)));
    }
    return r;
}

# Scale a multivector
fn cga_mv_scale(mv, s) {
    var r = alloc(CGA_MV_SIZE);
    for (var si = 0; si < 32; si = si + 1) {
        store64(r + si * 8, f64_mul(load64(mv + si * 8), s));
    }
    return r;
}

# Reverse: negate grades 2 and 3 (sign = (-1)^{k(k-1)/2})
fn cga_mv_reverse(mv) {
    var r = alloc(CGA_MV_SIZE);
    for (var ri = 0; ri < 32; ri = ri + 1) {
        var g = _cga_blade_grade(ri);
        var val = load64(mv + ri * 8);
        # Grades 2,3 get negated; 0,1,4,5 keep sign
        if (g == 2) { val = f64_neg(val); }
        if (g == 3) { val = f64_neg(val); }
        store64(r + ri * 8, val);
    }
    return r;
}

# Geometric product of two multivectors
fn cga_geometric_product(a, b) {
    var r = cga_mv_zero();
    for (var gi = 0; gi < 32; gi = gi + 1) {
        var ai = load64(a + gi * 8);
        if (f64_lt(f64_abs(ai), EPSILON_F64) != 1) {
            for (var gj = 0; gj < 32; gj = gj + 1) {
                var bj = load64(b + gj * 8);
                if (f64_lt(f64_abs(bj), EPSILON_F64) != 1) {
                    var packed = _cga_geo_blades(gi, gj);
                    var sign = load64(packed);
                    var blade = load64(packed + 8);
                    if (sign != 0) {
                        var contrib = f64_mul(ai, bj);
                        if (sign < 0) { contrib = f64_neg(contrib); }
                        var cur = load64(r + blade * 8);
                        store64(r + blade * 8, f64_add(cur, contrib));
                    }
                }
            }
        }
    }
    return r;
}

# Outer (wedge) product: keep only terms where result grade = grade(a) + grade(b)
fn cga_outer_product(a, b) {
    var r = cga_mv_zero();
    for (var gi = 0; gi < 32; gi = gi + 1) {
        var ai = load64(a + gi * 8);
        if (f64_lt(f64_abs(ai), EPSILON_F64) != 1) {
            for (var gj = 0; gj < 32; gj = gj + 1) {
                var bj = load64(b + gj * 8);
                if (f64_lt(f64_abs(bj), EPSILON_F64) != 1) {
                    var grade_sum = _cga_blade_grade(gi) + _cga_blade_grade(gj);
                    var packed = _cga_geo_blades(gi, gj);
                    var sign = load64(packed);
                    var blade = load64(packed + 8);
                    if (sign != 0) {
                        if (_cga_blade_grade(blade) == grade_sum) {
                            var contrib = f64_mul(ai, bj);
                            if (sign < 0) { contrib = f64_neg(contrib); }
                            var cur = load64(r + blade * 8);
                            store64(r + blade * 8, f64_add(cur, contrib));
                        }
                    }
                }
            }
        }
    }
    return r;
}

# Left contraction A ⌋ B: keep terms where grade(result) = grade(b) − grade(a).
# The interior product that "lowers B by A" — zero when grade(a) > grade(b)
# (the negative target never matches a non-negative blade grade, so those terms
# drop). Same loop as the outer product with a grade-difference selector.
fn cga_left_contraction(a, b) {
    var r = cga_mv_zero();
    for (var gi = 0; gi < 32; gi = gi + 1) {
        var ai = load64(a + gi * 8);
        if (f64_lt(f64_abs(ai), EPSILON_F64) != 1) {
            for (var gj = 0; gj < 32; gj = gj + 1) {
                var bj = load64(b + gj * 8);
                if (f64_lt(f64_abs(bj), EPSILON_F64) != 1) {
                    var target = _cga_blade_grade(gj) - _cga_blade_grade(gi);
                    var packed = _cga_geo_blades(gi, gj);
                    var sign = load64(packed);
                    var blade = load64(packed + 8);
                    if (sign != 0) {
                        if (_cga_blade_grade(blade) == target) {
                            var contrib = f64_mul(ai, bj);
                            if (sign < 0) { contrib = f64_neg(contrib); }
                            var cur = load64(r + blade * 8);
                            store64(r + blade * 8, f64_add(cur, contrib));
                        }
                    }
                }
            }
        }
    }
    return r;
}

# Right contraction A ⌊ B: keep terms where grade(result) = grade(a) − grade(b).
# Mirror of the left contraction with the grade difference flipped; zero when
# grade(b) > grade(a).
fn cga_right_contraction(a, b) {
    var r = cga_mv_zero();
    for (var gi = 0; gi < 32; gi = gi + 1) {
        var ai = load64(a + gi * 8);
        if (f64_lt(f64_abs(ai), EPSILON_F64) != 1) {
            for (var gj = 0; gj < 32; gj = gj + 1) {
                var bj = load64(b + gj * 8);
                if (f64_lt(f64_abs(bj), EPSILON_F64) != 1) {
                    var target = _cga_blade_grade(gi) - _cga_blade_grade(gj);
                    var packed = _cga_geo_blades(gi, gj);
                    var sign = load64(packed);
                    var blade = load64(packed + 8);
                    if (sign != 0) {
                        if (_cga_blade_grade(blade) == target) {
                            var contrib = f64_mul(ai, bj);
                            if (sign < 0) { contrib = f64_neg(contrib); }
                            var cur = load64(r + blade * 8);
                            store64(r + blade * 8, f64_add(cur, contrib));
                        }
                    }
                }
            }
        }
    }
    return r;
}

# Sandwich product: versor * x * versor_reverse
fn cga_sandwich(x, versor) {
    var rev = cga_mv_reverse(versor);
    return cga_geometric_product(versor, cga_geometric_product(x, rev));
}

# Scalar part (grade 0)
fn cga_scalar_part(mv) { return load64(mv); }

# Norm squared: scalar part of mv * reverse(mv)
fn cga_norm_sq(mv) {
    return cga_scalar_part(cga_geometric_product(mv, cga_mv_reverse(mv)));
}

# Norm: sqrt(|norm_sq|)
fn cga_norm(mv) {
    return f64_sqrt(f64_abs(cga_norm_sq(mv)));
}

# Unit pseudoscalar I = e1∧e2∧e3∧ep∧em (grade-5 blade [31]).
fn cga_pseudoscalar() {
    var i = cga_mv_zero();
    cga_mv_set(i, 31, F64_ONE);
    return i;
}

# Inverse pseudoscalar: I⁻¹ = reverse(I) / (I · reverse(I))_scalar. In this
# metric (em² = −1) the pseudoscalar squares to −1, so I⁻¹ = −I — but we derive
# the scale from the geometric product rather than hard-coding the sign.
fn cga_pseudoscalar_inv() {
    var i = cga_pseudoscalar();
    var rev = cga_mv_reverse(i);
    var denom = cga_scalar_part(cga_geometric_product(i, rev));
    return cga_mv_scale(rev, f64_div(F64_ONE, denom));
}

# Dual: x* = x · I⁻¹. Maps a grade-k blade to grade 5−k (Hodge-style duality).
# Since I is the top blade the geometric product here is exactly the contraction
# onto the pseudoscalar. Involution in this metric: dual(dual(x)) = −x.
fn cga_dual(x) {
    return cga_geometric_product(x, cga_pseudoscalar_inv());
}

# Blade inverse: B⁻¹ = reverse(B) / (B · reverse(B))_scalar. Returns the zero
# multivector for a null blade (norm² ≈ 0) rather than dividing by zero — e.g.
# conformal points are null, so projecting onto them is undefined.
fn cga_blade_inverse(b) {
    var nsq = cga_norm_sq(b);
    if (f64_lt(f64_abs(nsq), EPSILON_F64) == 1) { return cga_mv_zero(); }
    return cga_mv_scale(cga_mv_reverse(b), f64_div(F64_ONE, nsq));
}

# Projection of blade X onto blade B: project(X,B) = (X ⌋ B) ⌋ B⁻¹. Preserves
# grade(X) (the inner contraction lowers by grade(X), the outer raises back), so
# the result lives in the same grade as X — the component of X lying in B.
fn cga_project(x, b) {
    return cga_left_contraction(cga_left_contraction(x, b), cga_blade_inverse(b));
}

# Rejection: the part of X orthogonal to B. reject(X,B) = X − project(X,B);
# grade-consistent since the projection preserves grade(X).
fn cga_reject(x, b) {
    return cga_mv_sub(x, cga_project(x, b));
}

# --- Conformal model constructors ---

# Embed a 3D point into the conformal model.
# P = x*e1 + y*e2 + z*e3 + (x^2/2 - 1/2)*ep + (x^2/2 + 1/2)*em
fn cga_point(x, y, z) {
    var mv = cga_mv_zero();
    var x2 = f64_add(f64_add(f64_mul(x, x), f64_mul(y, y)), f64_mul(z, z));
    cga_mv_set(mv, 1, x);   # e1
    cga_mv_set(mv, 2, y);   # e2
    cga_mv_set(mv, 3, z);   # e3
    cga_mv_set(mv, 4, f64_sub(f64_mul(F64_HALF, x2), F64_HALF));  # ep: (x^2-1)/2
    cga_mv_set(mv, 5, f64_add(f64_mul(F64_HALF, x2), F64_HALF));  # em: (x^2+1)/2
    return mv;
}

# Create a conformal sphere: S = P - (r^2/2)*e_inf
# e_inf = ep + em
fn cga_sphere(cx, cy, cz, r) {
    var p = cga_point(cx, cy, cz);
    var half_r2 = f64_mul(F64_HALF, f64_mul(r, r));
    # Subtract half_r2 from both ep and em components (e_inf = ep + em)
    cga_mv_set(p, 4, f64_sub(cga_mv_get(p, 4), half_r2));
    cga_mv_set(p, 5, f64_sub(cga_mv_get(p, 5), half_r2));
    return p;
}

# Create a conformal plane: pi = nx*e1 + ny*e2 + nz*e3 + d*(ep + em)
# Normal is normalized.
fn cga_plane(nx, ny, nz, d) {
    var mv = cga_mv_zero();
    var norm = f64_sqrt(f64_add(f64_add(f64_mul(nx, nx), f64_mul(ny, ny)), f64_mul(nz, nz)));
    var inv = F64_ONE;
    if (f64_gt(norm, EPSILON_F64) == 1) {
        inv = f64_div(F64_ONE, norm);
    }
    cga_mv_set(mv, 1, f64_mul(nx, inv));
    cga_mv_set(mv, 2, f64_mul(ny, inv));
    cga_mv_set(mv, 3, f64_mul(nz, inv));
    var d_scaled = f64_mul(d, inv);
    cga_mv_set(mv, 4, d_scaled);  # ep component
    cga_mv_set(mv, 5, d_scaled);  # em component
    return mv;
}

# --- Versors (geometric transformations) ---

# Translator: T = 1 - (1/2) * t * e_inf
# where t = tx*e1 + ty*e2 + tz*e3 and e_inf = ep + em
# T = scalar(1) - 0.5*(tx*(e1p + e1m) + ty*(e2p + e2m) + tz*(e3p + e3m))
fn cga_translator(tx, ty, tz) {
    var mv = cga_mv_zero();
    cga_mv_set(mv, 0, F64_ONE);  # scalar = 1

    var htx = f64_mul(_GA_F64_NEG_HALF, tx);
    var hty = f64_mul(_GA_F64_NEG_HALF, ty);
    var htz = f64_mul(_GA_F64_NEG_HALF, tz);

    cga_mv_set(mv, 8,  htx);  # e1p
    cga_mv_set(mv, 9,  htx);  # e1m
    cga_mv_set(mv, 11, hty);  # e2p
    cga_mv_set(mv, 12, hty);  # e2m
    cga_mv_set(mv, 13, htz);  # e3p
    cga_mv_set(mv, 14, htz);  # e3m
    return mv;
}

# Rotor: R = cos(theta/2) - sin(theta/2) * (nz*e12 - ny*e13 + nx*e23)
# Axis (ax, ay, az) is normalized internally.
fn cga_rotor(ax, ay, az, angle) {
    var norm = f64_sqrt(f64_add(f64_add(f64_mul(ax, ax), f64_mul(ay, ay)), f64_mul(az, az)));
    if (f64_lt(norm, EPSILON_F64) == 1) {
        # Degenerate axis: return identity
        var mv = cga_mv_zero();
        cga_mv_set(mv, 0, F64_ONE);
        return mv;
    }
    var inv = f64_div(F64_ONE, norm);
    var nx = f64_mul(ax, inv);
    var ny = f64_mul(ay, inv);
    var nz = f64_mul(az, inv);

    var half = f64_mul(angle, F64_HALF);
    var c = f64_cos(half);
    var s = f64_sin(half);

    var mv = cga_mv_zero();
    cga_mv_set(mv, 0,  c);                       # scalar
    cga_mv_set(mv, 6,  f64_neg(f64_mul(s, nz))); # e12
    cga_mv_set(mv, 7,  f64_mul(s, ny));           # e13
    cga_mv_set(mv, 10, f64_neg(f64_mul(s, nx))); # e23
    return mv;
}

# Note: hvec3_abs is provided by vec3.cyr (must be included before this file)
