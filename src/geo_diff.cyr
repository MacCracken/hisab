# geo_diff.cyr -- differentiable ray-surface intersection (forward-mode jets)
# Usage: shipped inside dist/hisab.cyr; in-tree, include "src/geo_diff.cyr" after what it requires
# Requires: src/error.cyr, src/geo.cyr, src/quat.cyr, src/vec3.cyr (stdlib resolves via cyrius.cyml [deps])
#
# 2.10.0. Consumers that optimise THROUGH geometry -- differentiable rendering,
# inverse problems, shape fitting -- need not just the hit parameter `t` but its
# gradient with respect to the ray and the surface. This module returns both,
# from ONE evaluation, with no allocation beyond the returned jet.
#
# ================================================================
# WHY THIS IS NOT DUAL NUMBERS
# ================================================================
#
# `autodiff.cyr` ships forward-mode duals, and threading them through the
# intersection routines is the obvious construction. It was rejected on two
# measured grounds:
# [measured: CHANGELOG.md 2.10.0, "Not dual numbers, and that was a measured decision"; the grounds follow]
#
#   * Dual is a HEAP struct and every dual_* op allocates 16 bytes. Under the
#     bump allocator -- which never frees -- one ray/sphere intersection would
#     leak dozens of them per call, in a routine that costs 96 ns.
#   * Forward mode carries ONE seed direction per evaluation. A sphere jet has
#     7 independent parameters (origin 3, direction 3, radius 1) and a triangle
#     has 15, so a full gradient would need that many passes.
# [measured: CHANGELOG.md 2.10.0, "a 96 ns intersection" (ray_sphere)]
#
# The implicit function theorem gives the whole gradient in closed form instead.
# `t` is the root of F(o + t*d; theta) = 0, so differentiating along the surface:
#
#     dt/do     = -g / (g . d)
#     dt/dd     = t * dt/do                     [see the note on scaling below]
#     dt/dtheta = -(dF/dtheta) / (g . d)
#
# where g = grad F at the hit point and (g . d) is the denominator throughout --
# it vanishes exactly at grazing incidence, which is where `t` is genuinely
# non-differentiable, so the degenerate case is the true one rather than a
# numerical artefact.
#
# Everything below is therefore a POST-PASS on the shipped primal: each entry
# point calls the same `geo_ray_*` a non-differentiating caller would, then
# forms the gradient from the hit point. There is no second copy of any
# intersection algorithm, so none can drift from the one under test.
#
# ================================================================
# THE SCALING CONVENTION FOR dt/dd, STATED BECAUSE IT IS A CHOICE
# ================================================================
#
# `dt/dd` here is the RAW partial derivative of t with respect to the stored
# direction, treating d as a free vector. That is well-posed only because 2.10.0
# repaired `geo_ray_sphere` to carry its leading coefficient: before that, `t`
# was not degree -1 homogeneous in d and the radial part of this derivative
# described a function the primal was not computing.
# See docs/development/issues/archived/2026-08-10-ray-sphere-capsule-assume-unit-direction.md.
#
# A caller whose direction is CONSTRAINED to unit length -- which is what
# `geo_ray_new` produces -- wants only the tangential part, since a radial
# perturbation leaves the unit sphere. `geo_jet_dt_dd_unit` applies that
# projection, (I - d d^T) v. It is offered rather than baked in: silently
# projecting would make `d . (dt/dd)` read 0 when the true value is -t, and a
# consumer treating d as free would get a wrong answer with no way to see it.
#
# ================================================================
# LAYOUT
# ================================================================
#
# One fixed 72-byte jet regardless of primitive, with a `kind` tag. The shape
# derivative slots are typed by that tag and reached ONLY through per-primitive
# named accessors -- reading a sphere's radius slot off a plane jet returns the
# error sentinel rather than that plane's distance derivative. An untyped slot
# block would make those two indistinguishable at the call site.
#
# 2.10.1 added the `face` slot (64 -> 72 bytes), appended so no existing offset
# moves. It carries geo.cyr's face encoding for the branchy primitives and
# GEO_FACE_NONE for the smooth ones, which is also what a miss carries.

public var GEO_JET_MISS     = 0;
public var GEO_JET_PLANE    = 1;
public var GEO_JET_SPHERE   = 2;
public var GEO_JET_TRIANGLE = 3;
public var GEO_JET_AABB     = 4;
public var GEO_JET_OBB      = 5;
public var GEO_JET_CAPSULE  = 6;

# ⛔ 3.3.1 — A MANUAL LAYOUT, AND NO STRUCT, ON PURPOSE. Through 3.3.0 this was
# `#derive(accessors) struct _GeoJet`, and 3.3.0 said a consumer could no longer
# change a jet's kind, t, ss or face. That was false on every consumer pin from
# 6.6.3 to 6.6.12: Cyrius type names carry no visibility, so
# `var j: _GeoJet = geo_jet_sphere(...); j.kind = 77;` compiled against the
# shipped bundle and rewrote the field (and `j.dt_do = v;` replaced a slot).
# [measured: scratch harness, not reproducible in-tree, 2026-09-30; cycc 6.6.3, 6.6.12]
# (exit 42 against the 3.3.0 bundle on both pins; a compile error against this one)
# With no type name there is no field syntax to reach the slots through: the
# private accessors below, which are exactly what `#derive(accessors)` generated
# (a load64 / store64 at the field's offset), are the only way in.
# ⚠ This closes the ordinary-syntax path, not memory. A caller holding the pointer
# can still `store64(j + offset, v)`; nothing in a Cyrius bundle can stop a write
# through a pointer the caller owns. The offsets below are enum members, and enum
# members carry no visibility either, so the layout is readable by anyone.
# ⚠ ALL 18 ACCESSORS ARE `#inline` BECAUSE THE DERIVED ONES WERE. cycc registers
# every `#derive(accessors)` getter AND setter for auto-inlining; plain fns here put
# a real call on every slot access and cost the jet rows +3% to +29% (jet_plane
# 100 -> 129 ns), and inlining only the getters recovered none of it. All 18 inline:
# within each row's own spread of the derived struct (jet_plane 106 vs 106 ns).
# [measured: same-boot interleaved A/B over the six jet rows, 3 rounds, 2026-10-01; cycc 6.6.12]
enum _GeoJetLayout {
    _GJ_KIND  = 0;
    _GJ_T     = 8;
    _GJ_DT_DO = 16;
    _GJ_DT_DD = 24;
    _GJ_SV    = 32;
    _GJ_SV1   = 40;
    _GJ_SV2   = 48;
    _GJ_SS    = 56;
    _GJ_FACE  = 64;
    _GJ_BYTES = 72
}
#inline fn _GeoJet_kind(j) { return load64(j + _GJ_KIND); }
#inline fn _GeoJet_set_kind(j, v) { store64(j + _GJ_KIND, v); return 0; }
#inline fn _GeoJet_t(j) { return load64(j + _GJ_T); }
#inline fn _GeoJet_set_t(j, v) { store64(j + _GJ_T, v); return 0; }
#inline fn _GeoJet_dt_do(j) { return load64(j + _GJ_DT_DO); }
#inline fn _GeoJet_set_dt_do(j, v) { store64(j + _GJ_DT_DO, v); return 0; }
#inline fn _GeoJet_dt_dd(j) { return load64(j + _GJ_DT_DD); }
#inline fn _GeoJet_set_dt_dd(j, v) { store64(j + _GJ_DT_DD, v); return 0; }
#inline fn _GeoJet_sv(j) { return load64(j + _GJ_SV); }
#inline fn _GeoJet_set_sv(j, v) { store64(j + _GJ_SV, v); return 0; }
#inline fn _GeoJet_sv1(j) { return load64(j + _GJ_SV1); }
#inline fn _GeoJet_set_sv1(j, v) { store64(j + _GJ_SV1, v); return 0; }
#inline fn _GeoJet_sv2(j) { return load64(j + _GJ_SV2); }
#inline fn _GeoJet_set_sv2(j, v) { store64(j + _GJ_SV2, v); return 0; }
#inline fn _GeoJet_ss(j) { return load64(j + _GJ_SS); }
#inline fn _GeoJet_set_ss(j, v) { store64(j + _GJ_SS, v); return 0; }
#inline fn _GeoJet_face(j) { return load64(j + _GJ_FACE); }
#inline fn _GeoJet_set_face(j, v) { store64(j + _GJ_FACE, v); return 0; }

# The shape-parameter slots, typed by `kind` and reachable only through the
# per-primitive accessors below:
#   plane     sv = dt/d(normal)   ss = dt/d(distance)
#   sphere    sv = dt/d(center)   ss = dt/d(radius)
#   triangle  sv = dt/d(v0)       sv1 = dt/d(v1)      sv2 = dt/d(v2)
#   aabb      sv = dt/d(min)      sv1 = dt/d(max)     face = the selected face
#   obb       sv = dt/d(center)   sv1 = dt/d(half_extents)   sv2 = dt/d(rotation)
#                                                                  face = ditto
#   capsule   sv = dt/d(start)    sv1 = dt/d(end)     ss = dt/d(radius)
#                                 face = the BRANCH (GEO_CAP_*), not a face

# Component k (0 = x, 1 = y, 2 = z) of an HVec3. Written as branches rather than
# load64(v + 8*k) so it does not depend on the struct's memory layout.
fn _geo_jet_comp(v, k) {
    if (k == 0) { return HVec3_x(v); }
    if (k == 1) { return HVec3_y(v); }
    return HVec3_z(v);
}

# A vector carrying `val` in component k and zero elsewhere. The box gradients
# are all of this shape: only the axis whose slab was selected moves t.
fn _geo_jet_axis(k, val) {
    if (k == 0) { return hvec3_new(val, 0, 0); }
    if (k == 1) { return hvec3_new(0, val, 0); }
    return hvec3_new(0, 0, val);
}

# ⛔ 3.3.3 — A HIT JET COULD CARRY A NON-FINITE t. Each builder below tested its
# primal's t only against the miss 0 and then guarded `1 / den`, so a NaN or
# infinite t whose `den` stayed finite came back as a HIT, kind set, t = NaN or
# +Inf, with gradients formed from it. geo_ray_aabb_face and geo_ray_obb_face
# return a NaN t with a REAL face when the NaN enters on a later slab (f64_max
# hands the NaN on and the face an earlier slab set stays): the unit box and a
# ray from (-5, 0.5, NaN) along (1, 0, 1)/sqrt2 gave kind GEO_JET_AABB, hit 1,
# t NaN on 3.3.2, and so, before this test, did the box geo_aabb_new((0,0,NaN),
# (1,1,1)) on that ray, which 3.3.2 answered with the miss jet only because its
# geo_aabb_new dropped the NaN corner. geo_ray_plane and geo_ray_triangle return
# a NaN t for a NaN origin, and +Inf when t overflows, with `den` finite;
# geo_ray_sphere and geo_ray_capsule return +Inf when the radius squared
# overflows, and where `den` is then infinite, `1 / den` = 0 passes the reciprocal
# test. Every builder now answers its miss for a t that is not finite, the house
# test `f64_lt(|t|, +Inf) == 0`: an infinite t is not a hit (the slab routines'
# own tail says so) and a NaN t is not a contact. Every jet with a finite t is
# unchanged by it in every slot (41788
# hits in the R5geo sweep: one input scalar of each builder set to NaN, +-Inf,
# +-DBL_MAX or 2^600, and whole scenes scaled up to 2^1019). Of the sweep's 102300
# all-finite inputs, the 6582 that moved from 3.3.2 are exactly those whose t
# overflowed: a hit jet carrying +Inf or NaN then, the miss jet now. The primal
# still returns that t, so a caller can tell the overflow from a real miss there.
# [measured: R5geo jet sweep, 3.3.2, 3.3.3-base and repaired bundles, not in-tree, 2026-10-01; cycc 6.6.12]
# ⚠ 3.3.4 — the slab routines now return a NaN INPUT as a NaN t with GEO_FACE_NONE
# (roadmap D034, src/geo.cyr), but a NaN their arithmetic makes from input with none
# (Inf - Inf, 0 * Inf) still leaves with an earlier slab's real face, as above, so
# the box jets' t test still decides those (tests/modules.tcyr pins one per box).
# No cost measurable: over three interleaved runs, the six jet rows moved -0.4% to
# +1.4% against the tree without the test, each inside its own per-run spread,
# while the unchanged ray_aabb_diag row moved +0.1% to +2.6% between the same
# pairs of binaries.
# [measured: R5geo interleaved micro A/B, three runs of 60 rounds at load 4-10, not in-tree, 2026-10-01; cycc 6.6.12]
# ⛔ 3.3.6 — A -0.0 CONTACT WAS A HIT. The primals answer a contact at t = 0 (the origin
# on the surface) with +0.0 or -0.0 by the sign their arithmetic gives, and both mean the
# miss (src/geo.cyr, "A CONTACT AT t = 0"); these builders tested the integer t == 0,
# which only +0.0 passes, so the triangle (0,0,0), (1,0,0), (0,1,0) from (0.25, 0.25, 0)
# got the miss jet along -z (t = +0.0) and a hit jet with gradients along +z (t = -0.0),
# and the plane and box builders likewise (tests/modules.tcyr pins each). All six test
# f64_eq(t, 0), 1 for both zeros, so a contact is the miss jet on every primal. Of the slab sweep's
# 235997 box rays, 2943 jets moved, every one from a hit at t = -0.0 to the miss.
# [measured: C336 slab sweep and probes, 3.3.5 vs this tree, 2026-10-11; cycc 6.6.14]
# (The sphere and capsule primals give -0.0 only for a ray tangent at its origin, whose
# den is 0 and is the miss jet anyway: a root that underflows below zero reads -2^-1074
# and the c = 0 contact +0. Their `t == 0` mutants survive as equivalent; the shared test
# keeps the rule one rule.)
# [measured: C336 mutation run on tests/modules.tcyr, 2026-10-11; cycc 6.6.14]
#must_use
fn _geo_jet_miss() {
    # The five zero vectors are allocated BEFORE the jet and each is checked (3.4.0): a
    # refused one makes the whole miss jet the designed 0. Through 3.3.7 the jet was
    # allocated first and a refused vector was stored into it, so a miss could come back
    # with a 0 where this contract promises a readable zero vector.
    # (3.4.1: the jet and its five zero vectors are one allocation, 72 + 5 * 24 bytes, where 3.4.0
    # made six; each vector is still its own HVec3, never shared, and a refusal is still the whole
    # miss jet's designed 0. jet_plane's bench row is this path: its ray is parallel to the plane.)
    # [measured: GEO 3.4.1 fb.bcyr jet_plane, 3.4.0 vs this tree, not in-tree, 2026-10-31]
    var j = alloc(_GJ_BYTES + 120);
    if (j == 0) { return 0; }
    for (var zi = 0; zi < 15; zi = zi + 1) { store64(j + _GJ_BYTES + zi * 8, 0); }
    var z0 = j + _GJ_BYTES;
    var z1 = z0 + 24;
    var z2 = z0 + 48;
    var z3 = z0 + 72;
    var z4 = z0 + 96;
    _GeoJet_set_kind(j, GEO_JET_MISS);
    _GeoJet_set_t(j, 0);
    # A miss still returns READABLE vectors, never null. Callers branch on
    # geo_jet_hit(); a caller that reads first must not fault -- the same
    # contract gjk_epa_3d was given in 2.8.3 and mpr_penetration in 2.9.1.
    _GeoJet_set_dt_do(j, z0);
    _GeoJet_set_dt_dd(j, z1);
    _GeoJet_set_sv(j, z2);
    _GeoJet_set_sv1(j, z3);
    _GeoJet_set_sv2(j, z4);
    _GeoJet_set_ss(j, 0);
    _GeoJet_set_face(j, GEO_FACE_NONE);
    return j;
}

# The slots every jet carries, whatever the primitive: its kind (GEO_JET_*), the hit
# distance t, and t's partials with respect to the ray's origin and direction (each
# an HVec3). A miss reads kind GEO_JET_MISS, t = 0 and zero vectors, never null.
# ⚠ 3.3.0 made the layout private and removed the nine public setters, and claimed
# that kind, t, ss and face could no longer be changed. Through 3.2.x these four
# slots were read through the derived `GeoJet_kind` / `_t` / `_dt_do` / `_dt_dd`
# getters, with nine derived setters public beside them.
# ⛔ The 3.3.0 claim was false (typed field access on the struct name, see the
# layout note above) until 3.3.1 removed the struct. What holds now: no
# hisab-provided name or syntax writes a slot. A raw store64 through the pointer
# still can.
# ⚠ The vector slots (dorigin, ddirection and the per-primitive partials) are
# returned BY REFERENCE: they are the jet's own HVec3s, and `HVec3_set_*` is public,
# so a caller can still change their components. Copy a vector before modifying it.
#must_use
public fn geo_jet_kind(j) { return _GeoJet_kind(j); }

# The hit distance t of the primal the jet was built from; 0 on a miss jet.
#must_use
public fn geo_jet_t(j) { return _GeoJet_t(j); }

# dt/d(origin), the jet's own HVec3 (by reference, see above); (0, 0, 0) on a miss jet.
#must_use
public fn geo_jet_dorigin(j) { return _GeoJet_dt_do(j); }

# dt/d(direction), the RAW partial for a free direction (see the scaling note in the module
# header; geo_jet_dt_dd_unit projects it); (0, 0, 0) on a miss jet.
#must_use
public fn geo_jet_ddirection(j) { return _GeoJet_dt_dd(j); }

# 1 when the jet carries a real intersection, 0 for a miss. A contact at t = +0 or -0
# (the origin on the surface) is the miss jet, whichever zero the primal gives (3.3.6).
public fn geo_jet_hit(j) {
    if (_GeoJet_kind(j) == GEO_JET_MISS) { return 0; }
    return 1;
}

# Ray-sphere jet. Gradients w.r.t. ray origin, ray direction, sphere centre and
# sphere radius, from a single intersection.
#
#   F = |p - c|^2 - r^2,  g = grad F / 2 = p - c
#   dt/do = -g/(g.d)      dt/dc = +g/(g.d)      dt/dr = r/(g.d)
#
# dt/dc is exactly -dt/do: translating the sphere one way is translating the ray
# the other. That is a real symmetry of the problem, not a shortcut -- but it
# also means an assertion comparing only those two is vacuous, so the suite
# checks each against finite differences of the primal independently.
#
# Verified against central differences of the shipped `geo_ray_sphere` over 200
# random configurations: worst |analytic - FD| was 4.2e-9 on dt/do and dt/dc,
# 6.3e-9 on dt/dd, 9.9e-10 on dt/dr.
# [measured: tests/modules.tcyr "2.10.0 geo_jet_sphere"]
#must_use
public fn geo_jet_sphere(ray, sphere) {
    var mr = GeoSphere_radius(sphere) & 0x7FFF_FFFF_FFFF_FFFF;
    if (mr < 0x0370_0000_0000_0000 && mr != 0) {   # 2^-968: see _geo_jet_sphere_up (3.4.1)
        var ju = _geo_jet_sphere_up(ray, sphere);
        if (ju != 1) { return ju; }
    }
    var t = geo_ray_sphere(ray, sphere);
    if (f64_eq(t, 0) == 1) { return _geo_jet_miss(); }   # +0 or -0: see _geo_jet_miss
    if (f64_lt(f64_abs(t), F64_POS_INF) == 0) { return _geo_jet_miss(); }   # see _geo_jet_miss

    var d = GeoRay_direction(ray);
    var p = geo_ray_at(ray, t);
    if (p == 0) { return 0; }
    var g = hvec3_sub(p, GeoSphere_center(sphere));
    if (g == 0) { return 0; }
    var den = hvec3_dot(g, d);
    # ⛔ 3.3.7 — g = p - c IS ITS OWN ROUNDING WHEN r IS BELOW AN ULP OF THE HIT. p = o + t d
    # carries 2^-53 of |p|, so for a unit sphere at (3.5e252, 0, 0) met from 0 along +x, g
    # read 0, den 0, and the jet answered the miss for the primal's hit (dt/do = (-1, 0, 0),
    # dt/dr = -1); likewise a unit sphere at 1e17. Where |o| + |t d| + |c| is over 2^12 r
    # (_geo_jet_far), g and r are formed from the inputs instead (_geo_jet_round_g) and the
    # gradients from them on scaled copies (_geo_jet_round_scaled).
    # [measured: rt337 jet families (row4*.py, seeds 401-403), exact jets, 3.3.6 vs this tree, 2026-10-31]
    var rgf = 0;
    var gp[32];
    if (_geo_jet_far(ray, t, GeoSphere_center(sphere), GeoSphere_radius(sphere)) == 1) {
        rgf = _geo_jet_round_g(ray, t, GeoSphere_center(sphere), GeoSphere_radius(sphere), &gp);
        if (rgf < 0) { return 0; }
    }

    # Grazing incidence: the ray is tangent, the two roots have merged, and t is
    # genuinely non-differentiable there. Report the miss sentinel rather than a
    # gradient of +/-Inf -- the non-differentiable point is a property of the
    # geometry, not a failure of this routine.
    # ⛔ ALL SIX JETS GUARDED THIS AGAINST AN ABSOLUTE 1e-12 while the thing that
    # actually fails is `1 / den` on the very next line. `den` carries the ray
    # direction's magnitude (and, for the triangle, twice the area), so the jets
    # reported "grazing, non-differentiable" for perfectly ordinary geometry
    # expressed in small units — and `_geo_jet_miss()` cannot be told from a real
    # tangency by the caller.
    # ⭐ Test the RECIPROCAL, not the operand: `f64_lt(|inv|, +Inf)` is 1 for every
    # finite reciprocal and 0 for both +Inf and NaN, so one comparison covers
    # den = 0, den too small to invert, and a NaN ray, with no scale to choose.
    # ⚠ DBL_MIN would be one binade too conservative, for the same reason it was
    # in geo_ray_triangle: 1/2^-1023 = 2^1023 is finite and must be allowed.
    # ⚠ And the sixth site was NOT on the triage list — `geo_jet_plane` has the
    # identical shape and was found by grepping for it rather than trusting the
    # list. It matters more than the others: its primal `geo_ray_plane` is
    # repaired in this same release, so leaving this one would have left the jet
    # rejecting rays its own primal accepts.
    # [measured: tests/modules.tcyr geo jet scale sweeps, 2026-09-09]
    var inv = f64_div(F64_ONE, den);
    var dt_do = 0;
    var sv = 0;
    var ss = 0;
    if (f64_lt(f64_abs(inv), F64_POS_INF) == 0 || f64_eq(inv, 0) == 1 || rgf == 1) {
        # 3.3.6: den overflowed or is too small to invert (_geo_jet_round_scaled).
        var rp[24];
        var gg = g;
        var rr = GeoSphere_radius(sphere);
        if (rgf == 1) {
            gg = load64(&gp);
            rr = load64(&gp + 8);
        }
        var rsc = _geo_jet_round_scaled(gg, d, rr, &rp);
        if (rsc < 0) { return 0; }
        if (rsc == 0) { return _geo_jet_miss(); }
        dt_do = hvec3_scale(load64(&rp), f64_neg(load64(&rp + 8)));
        if (dt_do == 0) { return 0; }
        sv = hvec3_scale(load64(&rp), load64(&rp + 8));
        if (sv == 0) { return 0; }
        ss = load64(&rp + 16);
        var dtt = hvec3_scale(dt_do, t);
        if (dtt == 0) { return 0; }
        if (_geo_jet_finite3(dt_do) + _geo_jet_finite3(dtt) != 2) { return _geo_jet_miss(); }
        if (f64_lt(f64_abs(ss), F64_POS_INF) == 0) { return _geo_jet_miss(); }
    } else {
        dt_do = hvec3_scale(g, f64_neg(inv));
        if (dt_do == 0) { return 0; }
        sv = hvec3_scale(g, inv);
        if (sv == 0) { return 0; }
        ss = f64_mul(GeoSphere_radius(sphere), inv);
    }

    var dt_dd = hvec3_scale(dt_do, t);
    if (dt_dd == 0) { return 0; }
    var j = alloc(_GJ_BYTES);
    if (j == 0) { return 0; }
    _GeoJet_set_kind(j, GEO_JET_SPHERE);
    _GeoJet_set_t(j, t);
    _GeoJet_set_dt_do(j, dt_do);
    _GeoJet_set_dt_dd(j, dt_dd);
    _GeoJet_set_sv(j, sv);
    _GeoJet_set_ss(j, ss);
    _GeoJet_set_face(j, GEO_FACE_NONE);
    return j;
}

# Ray-plane jet. Gradients w.r.t. ray origin, ray direction, plane normal and
# plane distance.
#
#   F = n.p - dist,  g = n
#   dt/do = -n/(n.d)   dt/dn = -p/(n.d)   dt/ddist = 1/(n.d)
#
# dt/dn treats the normal as a free vector, matching how `GeoPlane` stores it;
# a caller holding it unit-constrained wants the tangential part, exactly as for
# dt/dd, and `geo_jet_dt_dd_unit` works on any HVec3.
#
# Verified against central differences of the shipped `geo_ray_plane` over 200
# random configurations: worst |analytic - FD| was 1.3e-8 on dt/do, 1.5e-6 on
# dt/dd, 3.0e-6 on dt/dn, 5.8e-9 on dt/ddist -- the larger residuals are FD
# truncation at near-grazing incidence, not disagreement.
# [measured: tests/modules.tcyr "2.10.0 geo_jet_plane"]
#must_use
public fn geo_jet_plane(ray, plane) {
    var t = geo_ray_plane(ray, plane);
    if (f64_eq(t, 0) == 1) { return _geo_jet_miss(); }   # +0 or -0: see _geo_jet_miss
    if (f64_lt(f64_abs(t), F64_POS_INF) == 0) { return _geo_jet_miss(); }   # see _geo_jet_miss

    var d = GeoRay_direction(ray);
    var n = GeoPlane_normal(plane);
    var den = hvec3_dot(n, d);
    var inv = f64_div(F64_ONE, den);
    if (f64_lt(f64_abs(inv), F64_POS_INF) == 0) { return _geo_jet_miss(); }
    # (3.4.1: the hit point on the stack, geo_ray_at's operations, so the same bits and one allocation
    # fewer.)
    var o = GeoRay_origin(ray);
    var p: i64[3];
    store64(&p, f64_add(HVec3_x(o), f64_mul(HVec3_x(d), t)));
    store64(&p + 8, f64_add(HVec3_y(o), f64_mul(HVec3_y(d), t)));
    store64(&p + 16, f64_add(HVec3_z(o), f64_mul(HVec3_z(d), t)));
    var dt_do = hvec3_scale(n, f64_neg(inv));
    if (dt_do == 0) { return 0; }
    var dt_dd = hvec3_scale(dt_do, t);
    if (dt_dd == 0) { return 0; }
    var sv = hvec3_scale(&p, f64_neg(inv));
    if (sv == 0) { return 0; }
    # ⛔ 3.4.1 — A PARTIAL PAST DBL_MAX IS THE MISS JET, as the sphere, capsule and triangle jets
    # answer it (AU2-G2-F10): o (0, 0, 1) along (1, 0, -2^-600) meets z = 0 at t = 2^600, right,
    # and dt/dd_z = dt/dn_x = 2^1200 came back as +Inf in a hit jet. inv is finite here, so dt/ddist
    # is; dt/do, dt/dd and dt/dn are tested, nine exponent fields in one pass.
    # [measured: GEO 3.4.1 AU2-G2-F10 repro; fb.bcyr jet_plane_hit, 3.4.0 vs this tree, 2026-10-31]
    var mf = 0;
    for (var fi = 0; fi < 3; fi = fi + 1) {
        mf = mf | ((load64(dt_dd + fi * 8) & 0x7FF0_0000_0000_0000) + 0x0010_0000_0000_0000);
        mf = mf | ((load64(dt_do + fi * 8) & 0x7FF0_0000_0000_0000) + 0x0010_0000_0000_0000);
        mf = mf | ((load64(sv + fi * 8) & 0x7FF0_0000_0000_0000) + 0x0010_0000_0000_0000);
    }
    if (mf < 0) { return _geo_jet_miss(); }   # (an exponent field of 2047 carries into the sign bit)

    var j = alloc(_GJ_BYTES);
    if (j == 0) { return 0; }
    _GeoJet_set_kind(j, GEO_JET_PLANE);
    _GeoJet_set_t(j, t);
    _GeoJet_set_dt_do(j, dt_do);
    _GeoJet_set_dt_dd(j, dt_dd);
    _GeoJet_set_sv(j, sv);
    _GeoJet_set_ss(j, inv);
    _GeoJet_set_face(j, GEO_FACE_NONE);
    return j;
}

# The largest |component| of v as the bits of a non-negative f64 (a NaN sorts above
# +Inf above every finite value), and the power of two that takes such a magnitude into
# [1, 2) -- [2^-51, 2) for a subnormal one -- held to [2^-1022, 2^1023] (3.3.6, see
# geo_jet_triangle). geo.cyr has the same helpers; modules cannot share `_` names.
fn _geo_jet_absmax_bits(v) {
    var m = HVec3_x(v) & 0x7FFF_FFFF_FFFF_FFFF;
    var y = HVec3_y(v) & 0x7FFF_FFFF_FFFF_FFFF;
    var z = HVec3_z(v) & 0x7FFF_FFFF_FFFF_FFFF;
    if (y > m) { m = y; }
    if (z > m) { m = z; }
    return m;
}

fn _geo_jet_pow2_for(m) {
    var k = 1023 - (m >> 52);
    if (k > 1023) { k = 1023; }
    if (k < 0 - 1022) { k = 0 - 1022; }
    return (1023 + k) << 52;
}

# 1 when every component of v is finite: the house test, one compare per component.
fn _geo_jet_finite3(v) {
    if (f64_lt(f64_abs(HVec3_x(v)), F64_POS_INF) == 0) { return 0; }
    if (f64_lt(f64_abs(HVec3_y(v)), F64_POS_INF) == 0) { return 0; }
    if (f64_lt(f64_abs(HVec3_z(v)), F64_POS_INF) == 0) { return 0; }
    return 1;
}

# geo_jet_triangle's gradients when 1 / den overflowed: e1, e2 and w = p - v0 scaled by
# one power of two, d by another, so that n = e1 x e2 and den = n . d are formed with
# normal products. The quotients are degree 0 in the first scale and -1 in d's, so
# each is multiplied back by d's. The miss jet when den is still too small to invert
# (the ray is parallel to the plane), when an input is not finite, or when a gradient
# overflows on the way back.
#must_use
fn _geo_jet_tri_scaled(ray, t, v0, e1, e2) {
    var d = GeoRay_direction(ray);
    var pa = geo_ray_at(ray, t);
    if (pa == 0) { return 0; }
    var w = hvec3_sub(pa, v0);
    if (w == 0) { return 0; }
    if (_geo_jet_finite3(e1) + _geo_jet_finite3(e2) + _geo_jet_finite3(d) + _geo_jet_finite3(w) != 4) {
        return _geo_jet_miss();
    }
    var me = _geo_jet_absmax_bits(e1);
    var m2 = _geo_jet_absmax_bits(e2);
    if (m2 > me) { me = m2; }
    var se = _geo_jet_pow2_for(me);
    var sd = _geo_jet_pow2_for(_geo_jet_absmax_bits(d));
    var e1s = hvec3_scale(e1, se);
    if (e1s == 0) { return 0; }
    var e2s = hvec3_scale(e2, se);
    if (e2s == 0) { return 0; }
    var ws = hvec3_scale(w, se);
    if (ws == 0) { return 0; }
    var n = hvec3_cross(e1s, e2s);
    if (n == 0) { return 0; }
    var ds = hvec3_scale(d, sd);
    if (ds == 0) { return 0; }
    var inv = f64_div(F64_ONE, hvec3_dot(n, ds));
    if (f64_lt(f64_abs(inv), F64_POS_INF) == 0) { return _geo_jet_miss(); }
    var ninv = f64_neg(inv);
    var nn = hvec3_scale(n, ninv);
    if (nn == 0) { return 0; }
    var dt_do = hvec3_scale(nn, sd);
    if (dt_do == 0) { return 0; }
    var dt_dd = hvec3_scale(dt_do, t);
    if (dt_dd == 0) { return 0; }
    var e12 = hvec3_sub(e1s, e2s);
    if (e12 == 0) { return 0; }
    var c0 = hvec3_cross(e12, ws);
    if (c0 == 0) { return 0; }
    var c0n = hvec3_sub(c0, n);
    if (c0n == 0) { return 0; }
    var s0 = hvec3_scale(c0n, ninv);
    if (s0 == 0) { return 0; }
    var sv = hvec3_scale(s0, sd);
    if (sv == 0) { return 0; }
    var c1 = hvec3_cross(e2s, ws);
    if (c1 == 0) { return 0; }
    var s1 = hvec3_scale(c1, ninv);
    if (s1 == 0) { return 0; }
    var sv1 = hvec3_scale(s1, sd);
    if (sv1 == 0) { return 0; }
    var c2 = hvec3_cross(ws, e1s);
    if (c2 == 0) { return 0; }
    var s2 = hvec3_scale(c2, ninv);
    if (s2 == 0) { return 0; }
    var sv2 = hvec3_scale(s2, sd);
    if (sv2 == 0) { return 0; }
    var ok = _geo_jet_finite3(dt_do) + _geo_jet_finite3(dt_dd) + _geo_jet_finite3(sv);
    if (ok + _geo_jet_finite3(sv1) + _geo_jet_finite3(sv2) != 5) { return _geo_jet_miss(); }

    var j = alloc(_GJ_BYTES);
    if (j == 0) { return 0; }
    _GeoJet_set_kind(j, GEO_JET_TRIANGLE);
    _GeoJet_set_t(j, t);
    _GeoJet_set_dt_do(j, dt_do);
    _GeoJet_set_dt_dd(j, dt_dd);
    _GeoJet_set_sv(j, sv);
    _GeoJet_set_sv1(j, sv1);
    _GeoJet_set_sv2(j, sv2);
    _GeoJet_set_ss(j, 0);
    _GeoJet_set_face(j, GEO_FACE_NONE);
    return j;
}

# t's partials on a round surface (a sphere, or a capsule's cap or barrel) when
# 1 / den is not a usable double (3.3.6): den = g . d, about r |d|, overflows past 2^1024
# (a radius near DBL_MAX met by a unit direction, which 3.3.5 never reached because its
# primal returned +Inf there) and 1 / den overflows below 2^-1024 (a radius of 2^-500 met
# by a raw direction 2^-600 long). g / den and r / den are
# degree 0 in g and r together and -1 in d, so g and r are multiplied by one power of
# two and d by another, each largest component into [1, 2), and the quotients by d's.
# p[0] = the scaled g', p[1] = m with g / den = g' * m, p[2] = r / den. 0 when den is
# still zero (grazing) or an input is not finite: the caller's miss jet. -1 when a vector
# could not be allocated (3.4.0): the caller's designed 0, never the miss jet.
fn _geo_jet_round_scaled(g, d, r, p) {
    if (_geo_jet_finite3(g) + _geo_jet_finite3(d) != 2) { return 0; }
    if (f64_lt(f64_abs(r), F64_POS_INF) == 0) { return 0; }
    var mg = _geo_jet_absmax_bits(g);
    var mr = r & 0x7FFF_FFFF_FFFF_FFFF;
    if (mr > mg) { mg = mr; }
    var sg = _geo_jet_pow2_for(mg);
    var sd = _geo_jet_pow2_for(_geo_jet_absmax_bits(d));
    var gs = hvec3_scale(g, sg);
    if (gs == 0) { return 0 - 1; }
    var dsc = hvec3_scale(d, sd);
    if (dsc == 0) { return 0 - 1; }
    var inv = f64_div(F64_ONE, hvec3_dot(gs, dsc));
    if (f64_lt(f64_abs(inv), F64_POS_INF) == 0) { return 0; }
    if (f64_eq(inv, 0) == 1) { return 0; }
    var m = f64_mul(inv, sd);
    store64(p, gs);
    store64(p + 8, m);
    store64(p + 16, f64_mul(f64_mul(r, sg), m));
    return 1;
}

# x * y as p[0] + p[1] exactly (Dekker; geo.cyr's _geo_two_prod, which modules cannot share).
fn _geo_jet_two_prod(x, y, p) {
    var sx = f64_mul(x, 0x41A0_0000_0200_0000);   # 2^27 + 1
    var xh = f64_sub(sx, f64_sub(sx, x));
    var xl = f64_sub(x, xh);
    var sy = f64_mul(y, 0x41A0_0000_0200_0000);
    var yh = f64_sub(sy, f64_sub(sy, y));
    var yl = f64_sub(y, yh);
    var pr = f64_mul(x, y);
    var e = f64_add(f64_add(f64_sub(f64_mul(xh, yh), pr), f64_mul(xh, yl)), f64_mul(xl, yh));
    store64(p, pr);
    store64(p + 8, f64_add(e, f64_mul(xl, yl)));
    return 0;
}

# a + b + c with the two additions' errors carried (Knuth's two-sum): within an ulp of the sum.
fn _geo_jet_sum3(a, b, c) {
    var s = f64_add(a, b);
    var bb = f64_sub(s, a);
    var er = f64_add(f64_sub(a, f64_sub(s, bb)), f64_sub(b, bb));
    var s2 = f64_add(s, c);
    var cc = f64_sub(s2, s);
    var er2 = f64_add(f64_sub(s, f64_sub(s2, cc)), f64_sub(c, cc));
    return f64_add(s2, f64_add(er, er2));
}

# w = p - v0 for the triangle jet's hit p = o + t d, formed as (o - v0) + t d with every
# rounding but t's carried, then moved along d onto the triangle's plane (w . n = 0): t's own
# rounding moves p along d only (3.3.7). The plain p - v0 carries 2^-53 of |o|, |p| and |v0|
# in every direction, against a w the size of the triangle.
fn _geo_jet_tri_w(ray, t, v0, n, den) {
    var o = GeoRay_origin(ray);
    var d = GeoRay_direction(ray);
    var pp[16];
    var w[24];
    for (var i = 0; i < 3; i = i + 1) {
        var oi = load64(o + i * 8);
        var vi = load64(v0 + i * 8);
        var di = f64_sub(oi, vi);
        var nb = f64_neg(vi);
        var bb = f64_sub(di, oi);
        var er = f64_add(f64_sub(oi, f64_sub(di, bb)), f64_sub(nb, bb));
        _geo_jet_two_prod(t, load64(d + i * 8), &pp);
        store64(&w + i * 8, _geo_jet_sum3(di, load64(&pp), f64_add(er, load64(&pp + 8))));
    }
    var k = f64_div(hvec3_dot(&w, n), den);
    return hvec3_new(f64_sub(HVec3_x(&w), f64_mul(k, HVec3_x(d))), f64_sub(HVec3_y(&w), f64_mul(k, HVec3_y(d))),
      f64_sub(HVec3_z(&w), f64_mul(k, HVec3_z(d))));
}

# a b - c d with both products exact and their difference's error carried (geo.cyr's _geo_dpd).
fn _geo_jet_dpd(a, b, c, d) {
    var pp[16];
    var qq[16];
    _geo_jet_two_prod(a, b, &pp);
    _geo_jet_two_prod(c, d, &qq);
    return _geo_jet_sum3(load64(&pp), f64_neg(load64(&qq)), f64_sub(load64(&pp + 8), load64(&qq + 8)));
}

# The part of v across the line of w, (w x v) x w / (w . w), with exact products (geo.cyr's
# _geo_perp_part): nothing is subtracted along w. w with its largest component in [1, 2).
fn _geo_jet_perp(v, w, out) {
    var vx = HVec3_x(v);
    var vy = HVec3_y(v);
    var vz = HVec3_z(v);
    var wx = HVec3_x(w);
    var wy = HVec3_y(w);
    var wz = HVec3_z(w);
    var cx = _geo_jet_dpd(wy, vz, wz, vy);
    var cy = _geo_jet_dpd(wz, vx, wx, vz);
    var cz = _geo_jet_dpd(wx, vy, wy, vx);
    var ww = hvec3_dot(w, w);
    store64(out, f64_div(_geo_jet_dpd(cy, wz, cz, wy), ww));
    store64(out + 8, f64_div(_geo_jet_dpd(cz, wx, cx, wz), ww));
    store64(out + 16, f64_div(_geo_jet_dpd(cx, wy, cy, wx), ww));
    if (f64_eq(wx, 0) == 1) { store64(out, vx); }
    if (f64_eq(wy, 0) == 1) { store64(out + 8, vy); }
    if (f64_eq(wz, 0) == 1) { store64(out + 16, vz); }
    return 0;
}

# h (o - c) - fl(h o - h c) per component, into lo, and h o - h c's rounded value into oc.
fn _geo_jet_diff(o, c, oc, lo) {
    for (var i = 0; i < 3; i = i + 1) {
        var a = load64(o + i * 8);
        var b = f64_neg(load64(c + i * 8));
        var sm = f64_add(a, b);
        var bb = f64_sub(sm, a);
        store64(oc + i * 8, sm);
        store64(lo + i * 8, f64_add(f64_sub(a, f64_sub(sm, bb)), f64_sub(b, bb)));
    }
    return 0;
}

# x * 2^e with one rounding, for a finite x and any integer e (3.4.1): geo.cyr's _geo_ldexp, which
# modules cannot share (no module reaches another's `_` name).
fn _geo_jet_ldexp(x, e) {
    if (e > 1023) {
        x = f64_mul(x, 0x7FE0_0000_0000_0000);   # 2^1023
        e = e - 1023;
        if (e > 1023) {
            x = f64_mul(x, 0x7FE0_0000_0000_0000);
            e = e - 1023;
        }
    }
    if (e < 0 - 1022) {
        var ex = ((x >> 52) & 0x7FF) - 1023;
        if (ex == 1024) { return x; }
        if (ex > 0) {
            x = f64_mul(x, (1023 - ex) << 52);
            e = e + ex;
            ex = 0;
        }
        var k = 0 - 1022 - ex;
        if (k > 0) { k = 0; }
        if (k < e) { k = e; }
        x = f64_mul(x, (1023 + k) << 52);
        e = e - k;
        if (e < 0 - 1022) {
            if (e < 0 - 1074) { e = 0 - 1074; }
            return f64_mul(x, 1 << (e + 1074));
        }
    }
    return f64_mul(x, (1023 + e) << 52);
}

# (g . ab) / (ab . ab) where ab . ab flushes or overflows (3.4.1, AU2-G2-F8): the barrel weight of a
# capsule hit. Through 3.4.0 it was the plain quotient, so a capsule 2^-550 across (or 2^512) got
# 0 / 0 or x / Inf and answered its miss jet, or a wrong one, for a barrel hit the primal answered:
# hit jets for scenes 2^-536..2^512 only. ab and g are each taken near 1 by a power of two, the
# quotient formed there and multiplied back exactly (_geo_ldexp). A non-finite input keeps the
# plain quotient.
# [measured: GEO 3.4.1 jet_sweep.py, 22600 capsule jets x2 seeds, 3.4.0 vs this tree, not in-tree, 2026-10-31]
fn _geo_jet_sfrac(g, ab) {
    if (_geo_jet_finite3(g) + _geo_jet_finite3(ab) != 2) {
        return f64_div(hvec3_dot(g, ab), hvec3_dot(ab, ab));
    }
    var sa = _geo_jet_pow2_for(_geo_jet_absmax_bits(ab));
    var sg = _geo_jet_pow2_for(_geo_jet_absmax_bits(g));
    var abs_: i64[3];
    var gs: i64[3];
    for (var i = 0; i < 3; i = i + 1) {
        store64(&abs_ + i * 8, f64_mul(load64(ab + i * 8), sa));
        store64(&gs + i * 8, f64_mul(load64(g + i * 8), sg));
    }
    return _geo_jet_ldexp(f64_div(hvec3_dot(&gs, &abs_), hvec3_dot(&abs_, &abs_)), (sa >> 52) - (sg >> 52));
}

# The jet of a sphere whose radius is below 2^-968 (3.4.1, AU2-G2-F9), formed on a copy at unit
# size: origin, centre and radius each multiplied by the power of two s that takes r near 1. Below
# 2^-969 the hit point's rounding to the subnormal grid (t itself is rounded there) is a large part
# of g = p - c, and dt/do came back 2.9e-3 relative off with t exact. Every partial but dt/dd is of
# degree 0 in the scene's size, so the copy's are the answer; t and dt/dd = t dt/do are taken back
# from the primal's own t. ⚠ THE COPY IS SCALED, NOT TRANSLATED (review RV-GEO M2): multiplying by
# s is exact, so the copy is the same scene, and the jet's own arithmetic forms o - c there with
# whatever care it takes at unit size; a copy translated first (o - c, then scaled) carried the
# rounding of o - c, which a thin capsule amplifies by |ab| / r. 1 (the caller goes on) where the
# copy cannot be made exactly (a non-finite input, a coordinate that overflows at the copy's
# scale) or where its primal is not a hit: the shipped arithmetic answers those. 0 when an
# allocation is refused.
# [measured: GEO2 3.4.1 jets.py (RV-GEO), 3 seeds, and jet_subcap.py, 3.4.0 vs this tree, 2026-10-31]
fn _geo_jet_sphere_up(ray, sphere) {
    var o = GeoRay_origin(ray);
    var c = GeoSphere_center(sphere);
    var r = GeoSphere_radius(sphere);
    if (_geo_jet_finite3(o) + _geo_jet_finite3(c) + _geo_jet_finite3(GeoRay_direction(ray)) != 3) { return 1; }
    var t = geo_ray_sphere(ray, sphere);
    if (f64_eq(t, 0) == 1 || f64_lt(f64_abs(t), F64_POS_INF) == 0) { return 1; }
    var s = _geo_jet_pow2_for((r & 0x7FFF_FFFF_FFFF_FFFF));
    var os: i64[3];
    var cs: i64[3];
    for (var i = 0; i < 3; i = i + 1) {
        store64(&os + i * 8, f64_mul(load64(o + i * 8), s));
        store64(&cs + i * 8, f64_mul(load64(c + i * 8), s));
    }
    if (_geo_jet_finite3(&os) + _geo_jet_finite3(&cs) != 2) { return 1; }
    var rc[16];
    var sc[16];
    store64(&rc, &os);
    store64(&rc + 8, GeoRay_direction(ray));
    store64(&sc, &cs);
    store64(&sc + 8, f64_mul(r, s));
    var j = geo_jet_sphere(&rc, &sc);
    if (j == 0) { return 0; }
    if (_GeoJet_kind(j) != GEO_JET_SPHERE) { return 1; }
    return _geo_jet_retime(j, t);
}

# The capsule's _geo_jet_sphere_up (3.4.1): origin, start, end and radius each multiplied by the
# power of two k that takes the larger of |e - s| and r near 1 (exact: the copy is the same scene),
# so that the copy's radius is normal; the copy's branch must be the primal's.
fn _geo_jet_capsule_up(ray, capsule) {
    var o = GeoRay_origin(ray);
    var a = GeoCapsule_start(capsule);
    var b = GeoCapsule_end(capsule);
    var r = GeoCapsule_radius(capsule);
    var nfin = _geo_jet_finite3(o) + _geo_jet_finite3(a) + _geo_jet_finite3(b);
    if (nfin + _geo_jet_finite3(GeoRay_direction(ray)) != 4) { return 1; }
    var ob: i64[2];
    var t = geo_ray_capsule_branch(ray, capsule, &ob);
    if (f64_eq(t, 0) == 1 || f64_lt(f64_abs(t), F64_POS_INF) == 0) { return 1; }
    var ab: i64[3];
    for (var i = 0; i < 3; i = i + 1) {
        store64(&ab + i * 8, f64_sub(load64(b + i * 8), load64(a + i * 8)));
    }
    var m = _geo_jet_absmax_bits(&ab);
    var mr = r & 0x7FFF_FFFF_FFFF_FFFF;
    if (mr > m) { m = mr; }
    var s = _geo_jet_pow2_for(m);
    if ((f64_mul(r, s) & 0x7FFF_FFFF_FFFF_FFFF) < 0x0370_0000_0000_0000) { return 1; }   # (still tiny: no gain)
    var os: i64[3];
    var as_: i64[3];
    var bs: i64[3];
    for (var k = 0; k < 3; k = k + 1) {
        store64(&os + k * 8, f64_mul(load64(o + k * 8), s));
        store64(&as_ + k * 8, f64_mul(load64(a + k * 8), s));
        store64(&bs + k * 8, f64_mul(load64(b + k * 8), s));
    }
    if (_geo_jet_finite3(&os) + _geo_jet_finite3(&as_) + _geo_jet_finite3(&bs) != 3) { return 1; }
    var rc[16];
    var cc[24];
    store64(&rc, &os);
    store64(&rc + 8, GeoRay_direction(ray));
    store64(&cc, &as_);
    store64(&cc + 8, &bs);
    store64(&cc + 16, f64_mul(r, s));
    var j = geo_jet_capsule(&rc, &cc);
    if (j == 0) { return 0; }
    if (_GeoJet_kind(j) != GEO_JET_CAPSULE || _GeoJet_face(j) != load64(&ob)) { return 1; }
    return _geo_jet_retime(j, t);
}

# The jet j with t replaced and dt/dd = t dt/do formed again from it (3.4.1, the up-scaled jets).
fn _geo_jet_retime(j, t) {
    _GeoJet_set_t(j, t);
    var dd = _GeoJet_dt_dd(j);
    var dn = _GeoJet_dt_do(j);
    HVec3_set_x(dd, f64_mul(HVec3_x(dn), t));
    HVec3_set_y(dd, f64_mul(HVec3_y(dn), t));
    HVec3_set_z(dd, f64_mul(HVec3_z(dn), t));
    return j;
}

# 1 when p - c, formed from p = o + t d, may be mostly its own rounding against r (3.3.7):
# |o| + |t d| + |c| (largest components) more than 2^12 r, so that the plain g = p - c is off
# by more than 2^-40 of r.
fn _geo_jet_far(ray, t, c, r) {
    var o = GeoRay_origin(ray);
    var d = GeoRay_direction(ray);
    var mo = 0;
    var md = 0;
    var mc = 0;
    for (var i = 0; i < 3; i = i + 1) {
        var x = load64(o + i * 8) & 0x7FFF_FFFF_FFFF_FFFF;
        if (x > mo) { mo = x; }
        x = load64(d + i * 8) & 0x7FFF_FFFF_FFFF_FFFF;
        if (x > md) { md = x; }
        x = load64(c + i * 8) & 0x7FFF_FFFF_FFFF_FFFF;
        if (x > mc) { mc = x; }
    }
    var m = f64_add(f64_add(mo, f64_mul(f64_abs(t), md)), mc);
    return f64_gt(m, f64_mul(f64_abs(r), 0x40B0_0000_0000_0000));   # 2^12
}

# -1 for the near root (t before the closest approach t_c = -(o - c) . d / d . d), +1 for the
# far one; -1 when the two are within 2^-40 of each other (an origin far outside, whose first
# root is the near one).
fn _geo_jet_root_side(t, tc) {
    var df = f64_sub(t, tc);
    if (f64_lt(f64_abs(df), f64_mul(f64_add(f64_abs(t), f64_abs(tc)), 0x3D70_0000_0000_0000)) == 1) { return 0 - 1; }
    if (f64_gt(df, 0) == 1) { return 1; }
    return 0 - 1;
}

# g = p - c and r on one scale, where the plain g is its rounding (3.3.7): with f the offset of
# c from the ray's line (_geo_jet_perp, o - c's rounding carried) and h = sqrt(r^2 - |f|^2), the
# root's point is c + f + s h d / |d| (s from _geo_jet_root_side), so g = f + s h d / |d|, every
# part formed from the inputs at their own scale. gp[0] = g' (an HVec3), gp[1] = r', with
# g' / r' = g / r. 0 when an input is not finite; -1 when a vector could not be allocated.
fn _geo_jet_round_g(ray, t, c, r, gp) {
    var o = GeoRay_origin(ray);
    var d = GeoRay_direction(ray);
    if (_geo_jet_finite3(o) + _geo_jet_finite3(d) + _geo_jet_finite3(c) != 3) { return 0; }
    if (f64_lt(f64_abs(r), F64_POS_INF) == 0) { return 0; }
    var oc[24];
    var lo[24];
    _geo_jet_diff(o, c, &oc, &lo);
    if (_geo_jet_finite3(&oc) == 0) { return 0; }
    var md = _geo_jet_absmax_bits(d);
    if (md == 0) { return 0; }
    var ds = hvec3_scale(d, _geo_jet_pow2_for(md));
    if (ds == 0) { return 0 - 1; }
    var mw = _geo_jet_absmax_bits(&oc);
    var mr = r & 0x7FFF_FFFF_FFFF_FFFF;
    if (mr > mw) { mw = mr; }
    var s0 = _geo_jet_pow2_for(mw);
    var f[24];
    var fl[24];
    var ocs = hvec3_scale(&oc, s0);
    if (ocs == 0) { return 0 - 1; }
    _geo_jet_perp(ocs, ds, &f);
    var los = hvec3_scale(&lo, s0);
    if (los == 0) { return 0 - 1; }
    _geo_jet_perp(los, ds, &fl);
    store64(&f, f64_add(HVec3_x(&f), HVec3_x(&fl)));
    store64(&f + 8, f64_add(HVec3_y(&f), HVec3_y(&fl)));
    store64(&f + 16, f64_add(HVec3_z(&f), HVec3_z(&fl)));
    var tc = f64_div(f64_neg(hvec3_dot(&oc, d)), hvec3_dot(d, d));
    return _geo_jet_g_from(&f, f64_mul(r, s0), ds, _geo_jet_root_side(t, tc), gp);
}

# g' = f + s h e / |e| and r' for an offset f, a radius r (one scale) and a direction e across
# which f lies, both taken to f's own scale first so that r^2 - |f|^2 does not flush.
# 1, or -1 when a vector could not be allocated.
fn _geo_jet_g_from(f, r, e, sg, gp) {
    var mf = _geo_jet_absmax_bits(f);
    var mr = r & 0x7FFF_FFFF_FFFF_FFFF;
    if (mr > mf) { mf = mr; }
    var s2 = _geo_jet_pow2_for(mf);
    var fs = hvec3_scale(f, s2);
    if (fs == 0) { return 0 - 1; }
    var rs = f64_mul(r, s2);
    var hh = f64_sub(f64_mul(rs, rs), hvec3_dot(fs, fs));
    if (f64_lt(hh, 0) == 1) { hh = 0; }
    var k = f64_div(f64_sqrt(hh), hvec3_length(e));
    if (sg < 0) { k = f64_neg(k); }
    var ek = hvec3_scale(e, k);
    if (ek == 0) { return 0 - 1; }
    var g = hvec3_add(fs, ek);
    if (g == 0) { return 0 - 1; }
    store64(gp, g);
    store64(gp + 8, rs);
    store64(gp + 16, f64_sqrt(hh));
    store64(gp + 24, s2);
    return 1;
}

# geo_jet_capsule's barrel g (the part of p - a across ab) and segment coordinate s where the
# plain ones are their rounding (3.3.7). With w the start's offset from the ray's line
# (_geo_jet_perp, o - a's rounding carried) and n = ab x d (exact products, ab's rounding
# carried), the offset of the ray's line from the axis is F = n (w . n) / |n|^2, and the root's
# point lies at F + s h d_ab / |d_ab| across the axis (d_ab: d's part across ab; h as in
# _geo_jet_round_g); along it, (p - a) . ab = (ab . w) |ab|^2 (d . d) / |n|^2 + s h (d . ab) |ab| / |n|.
# gp[0] = g', gp[1] = r' as _geo_jet_round_g, gp[4] = s. 0 when an input is not finite or n = 0;
# -1 when a vector could not be allocated.
fn _geo_jet_barrel_g(ray, t, a, b, r, gp) {
    var o = GeoRay_origin(ray);
    var d = GeoRay_direction(ray);
    if (_geo_jet_finite3(o) + _geo_jet_finite3(d) + _geo_jet_finite3(a) + _geo_jet_finite3(b) != 4) { return 0; }
    if (f64_lt(f64_abs(r), F64_POS_INF) == 0) { return 0; }
    var ao[24];
    var aol[24];
    var ab[24];
    var abl[24];
    _geo_jet_diff(o, a, &ao, &aol);
    _geo_jet_diff(b, a, &ab, &abl);
    if (_geo_jet_finite3(&ao) + _geo_jet_finite3(&ab) != 2) { return 0; }
    var md = _geo_jet_absmax_bits(d);
    var mab = _geo_jet_absmax_bits(&ab);
    if (md == 0 || mab == 0) { return 0; }
    var ds = hvec3_scale(d, _geo_jet_pow2_for(md));
    if (ds == 0) { return 0 - 1; }
    var sab = _geo_jet_pow2_for(mab);
    var abs_ = hvec3_scale(&ab, sab);
    if (abs_ == 0) { return 0 - 1; }
    var abls = hvec3_scale(&abl, sab);
    if (abls == 0) { return 0 - 1; }
    var mw = _geo_jet_absmax_bits(&ao);
    var mr = r & 0x7FFF_FFFF_FFFF_FFFF;
    if (mr > mw) { mw = mr; }
    var s0 = _geo_jet_pow2_for(mw);
    var w[24];
    var wl[24];
    var aos = hvec3_scale(&ao, s0);
    if (aos == 0) { return 0 - 1; }
    _geo_jet_perp(aos, ds, &w);
    var aols = hvec3_scale(&aol, s0);
    if (aols == 0) { return 0 - 1; }
    _geo_jet_perp(aols, ds, &wl);
    store64(&w, f64_add(HVec3_x(&w), HVec3_x(&wl)));
    store64(&w + 8, f64_add(HVec3_y(&w), HVec3_y(&wl)));
    store64(&w + 16, f64_add(HVec3_z(&w), HVec3_z(&wl)));
    var nh[24];
    var p1[16];
    var dt = 0;
    var tail = 0;
    for (var i = 0; i < 3; i = i + 1) {
        var j = (i + 1) % 3;
        var k = (i + 2) % 3;
        var nl = f64_sub(f64_mul(load64(abls + j * 8), load64(ds + k * 8)),
          f64_mul(load64(abls + k * 8), load64(ds + j * 8)));
        var pa[16];
        var pb[16];
        _geo_jet_two_prod(load64(abs_ + j * 8), load64(ds + k * 8), &pa);
        _geo_jet_two_prod(load64(abs_ + k * 8), load64(ds + j * 8), &pb);
        var nhi = f64_sub(load64(&pa), load64(&pb));
        var bb = f64_sub(nhi, load64(&pa));
        var er = f64_add(f64_sub(load64(&pa), f64_sub(nhi, bb)), f64_sub(f64_neg(load64(&pb)), bb));
        nl = f64_add(nl, f64_add(er, f64_sub(load64(&pa + 8), load64(&pb + 8))));
        store64(&nh + i * 8, nhi);
        _geo_jet_two_prod(load64(&w + i * 8), nhi, &p1);
        var s1 = f64_add(dt, load64(&p1));
        var b1 = f64_sub(s1, dt);
        tail = f64_add(tail, f64_add(f64_add(f64_sub(dt, f64_sub(s1, b1)), f64_sub(load64(&p1), b1)),
            f64_add(load64(&p1 + 8), f64_mul(load64(&w + i * 8), nl))));
        dt = s1;
    }
    dt = f64_add(dt, tail);
    var nn = hvec3_dot(&nh, &nh);
    if (f64_eq(nn, 0) == 1) { return 0; }
    var fv = hvec3_scale(&nh, f64_div(dt, nn));
    if (fv == 0) { return 0 - 1; }
    var dab[24];   # d's part across ab, exactly formed (it cancels for a d near the axis)
    _geo_jet_perp(ds, abs_, &dab);
    # the near or the far root: t against the closest approach to the axis, both plain
    var abw = hvec3_sub(b, a);
    if (abw == 0) { return 0 - 1; }
    var dwa = hvec3_scale(abw, f64_div(hvec3_dot(d, abw), hvec3_dot(abw, abw)));
    if (dwa == 0) { return 0 - 1; }
    var dw = hvec3_sub(d, dwa);
    if (dw == 0) { return 0 - 1; }
    var owa = hvec3_scale(abw, f64_div(hvec3_dot(&ao, abw), hvec3_dot(abw, abw)));
    if (owa == 0) { return 0 - 1; }
    var ow = hvec3_sub(&ao, owa);
    if (ow == 0) { return 0 - 1; }
    var sg = _geo_jet_root_side(t, f64_div(f64_neg(hvec3_dot(ow, dw)), hvec3_dot(dw, dw)));
    var gf = _geo_jet_g_from(fv, f64_mul(r, s0), &dab, sg, gp);
    if (gf <= 0) { return gf; }
    var h = f64_div(load64(gp + 16), load64(gp + 24));    # h at s0's scale
    var aa = hvec3_dot(abs_, abs_);
    var x1 = f64_div(f64_mul(f64_mul(hvec3_dot(abs_, &w), aa), hvec3_dot(ds, ds)), nn);
    var x2 = f64_div(f64_mul(f64_mul(h, hvec3_dot(ds, abs_)), f64_sqrt(aa)), f64_sqrt(nn));
    if (sg < 0) { x2 = f64_neg(x2); }
    store64(gp + 32, f64_div(f64_mul(f64_add(x1, x2), sab), f64_mul(s0, aa)));
    return 1;
}

# Ray-triangle jet. Gradients w.r.t. ray origin, ray direction and all three
# vertices -- 15 parameters from one intersection.
#
# The surface is the triangle's plane, F = n . (p - v0) with n = e1 x e2,
# e1 = v1 - v0, e2 = v2 - v0. The barycentric bounds decide only WHETHER there
# is a hit, not where it is, so they contribute nothing to the derivative in the
# interior -- and on the boundary `t` is not differentiable at all, which is
# what the primal's miss return already expresses.
#
# Both n and the constant term depend on the vertices, so the vertex gradients
# carry two contributions. With w = p - v0 and den = n . d:
#
#   dt/dv0 = -[ (e1 - e2) x w  -  n ] / den
#   dt/dv1 = -[ e2 x w ] / den
#   dt/dv2 = -[ w x e1 ] / den
#
# Verified against central differences of the shipped `geo_ray_triangle` over 382
# accepted random configurations: worst |analytic - FD| was 9.6e-10 across all
# five gradients.
# [measured: tests/modules.tcyr "2.10.0 geo_jet_triangle"]
#
# ⚠ The translation identity dt/dv0 + dt/dv1 + dt/dv2 == -dt/do holds, but it is
# an ALGEBRAIC identity of the three expressions above (the cross-product terms
# cancel exactly, leaving n/den), so it cannot detect a shared error in them.
# It is asserted as a smoke test only; finite differences are the real oracle.
#
# ⛔ 3.3.6 — THE JET REFUSED HITS ITS PRIMAL ACCEPTED. The primal tests 1 / a with
# a = e1 . (d x e2); this tests 1 / den with den = n . d = (e1 x e2) . d, the same
# number in exact arithmetic (-a) but rounded through other products. Where they
# fall among the subnormals, near |a| = 2^-1024, the two roundings land on either
# side of the reciprocal's overflow: legs of s = 0x1FF1F5FAB7CD0488 (about 2^-511)
# give n = (0, 0, s^2), subnormal, so den lost the bits a kept, and the jet answered
# its miss for a hit at a finite t. Every quotient below is a ratio of a degree-two
# quantity in the triangle's size to den, and has degree -1 in d, so when 1 / den
# overflows the gradients are formed again from copies of e1, e2 and w multiplied by
# one power of two and of d by another (each largest component into [1, 2)), and
# multiplied back by d's (_geo_jet_tri_scaled). Wherever den is normal the shipped
# arithmetic runs unchanged. Over 70000 rays (triangles with legs 2^-560 to 2^-470, raw
# directions 2^-1030 to 2^40, and 20000 straddling |a| = 2^-1024), the 52 hits the jet
# refused are hit jets now, each dt/do within 2.1e-16 relative of the exact -n / (n . d).
# [measured: C336 triangle-jet sweep, exact Fraction oracle, 3.3.5 vs this tree, 2026-10-11; cycc 6.6.14]
#must_use
public fn geo_jet_triangle(ray, tri) {
    var t = geo_ray_triangle(ray, tri);
    if (f64_eq(t, 0) == 1) { return _geo_jet_miss(); }   # +0 or -0: see _geo_jet_miss
    if (f64_lt(f64_abs(t), F64_POS_INF) == 0) { return _geo_jet_miss(); }   # see _geo_jet_miss

    var d = GeoRay_direction(ray);
    var v0 = GeoTriangle_v0(tri);
    var e1 = hvec3_sub(GeoTriangle_v1(tri), v0);
    if (e1 == 0) { return 0; }
    var e2 = hvec3_sub(GeoTriangle_v2(tri), v0);
    if (e2 == 0) { return 0; }
    var n = hvec3_cross(e1, e2);
    if (n == 0) { return 0; }
    var den = hvec3_dot(n, d);
    var inv = f64_div(F64_ONE, den);
    if (f64_lt(f64_abs(inv), F64_POS_INF) == 0) { return _geo_jet_tri_scaled(ray, t, v0, e1, e2); }
    # n under 2^-1019: its products rounded among the subnormals and kept only the bits
    # above 2^-1074, though 1 / den is finite (legs about 2^-530 with d near 2^37 gave
    # dt/do 3.5e-5 off). The scaled copy forms n with normal products. On the sweep above
    # this moved 4935 hit jets of triangles with legs under 2^-510: 3113 closer to the exact
    # dt/do, 381 further, the rest no nearer or further; every one within 3.0e-15 relative
    # (1.7e-15 before), a cross product's own rounding.
    # [measured: C336 probe and triangle-jet sweep (seed 31), exact Fraction oracle, 2026-10-11; cycc 6.6.14]
    if (_geo_jet_absmax_bits(n) < 0x0040_0000_0000_0000) { return _geo_jet_tri_scaled(ray, t, v0, e1, e2); }
    var pa = geo_ray_at(ray, t);
    if (pa == 0) { return 0; }
    var w = hvec3_sub(pa, v0);
    if (w == 0) { return 0; }
    var me = _geo_jet_absmax_bits(e1);
    var me2 = _geo_jet_absmax_bits(e2);
    if (me2 > me) { me = me2; }
    var mo = f64_add(f64_add(_geo_jet_absmax_bits(GeoRay_origin(ray)), f64_mul(f64_abs(t), _geo_jet_absmax_bits(d))),
      _geo_jet_absmax_bits(v0));
    # ⛔ 3.3.7 — w = p - v0 CARRIED 2^-53 OF |o|, |p| AND |v0|, against a w the size of the
    # triangle: for a 1e-6 triangle met from distance 1 the vertex gradients were off by a
    # median 5e-10 and up to 1e-5 relative (dt/do, which does not read w, by 1e-16). Where
    # |o| + |t d| + |v0| is over 2^8 times the triangle's legs, w is formed with its roundings
    # carried and moved onto the plane (_geo_jet_tri_w).
    # [measured: rt337 triangle-jet families (row5.py, seeds 501-504), exact jets, 3.3.6 vs this tree, 2026-10-31]
    if (f64_gt(mo, f64_mul(me, 0x4070_0000_0000_0000)) == 1) { w = _geo_jet_tri_w(ray, t, v0, n, den); }   # 2^8
    if (w == 0) { return 0; }
    var dt_do = hvec3_scale(n, f64_neg(inv));
    if (dt_do == 0) { return 0; }
    var dt_dd = hvec3_scale(dt_do, t);
    if (dt_dd == 0) { return 0; }
    var e12 = hvec3_sub(e1, e2);
    if (e12 == 0) { return 0; }
    var c0 = hvec3_cross(e12, w);
    if (c0 == 0) { return 0; }
    var c0n = hvec3_sub(c0, n);
    if (c0n == 0) { return 0; }
    var sv = hvec3_scale(c0n, f64_neg(inv));
    if (sv == 0) { return 0; }
    var c1 = hvec3_cross(e2, w);
    if (c1 == 0) { return 0; }
    var sv1 = hvec3_scale(c1, f64_neg(inv));
    if (sv1 == 0) { return 0; }
    var c2 = hvec3_cross(w, e1);
    if (c2 == 0) { return 0; }
    var sv2 = hvec3_scale(c2, f64_neg(inv));
    if (sv2 == 0) { return 0; }

    var j = alloc(_GJ_BYTES);
    if (j == 0) { return 0; }
    _GeoJet_set_kind(j, GEO_JET_TRIANGLE);
    _GeoJet_set_t(j, t);
    _GeoJet_set_dt_do(j, dt_do);
    _GeoJet_set_dt_dd(j, dt_dd);
    _GeoJet_set_sv(j, sv);
    _GeoJet_set_sv1(j, sv1);
    _GeoJet_set_sv2(j, sv2);
    _GeoJet_set_ss(j, 0);
    _GeoJet_set_face(j, GEO_FACE_NONE);
    return j;
}

# Ray-AABB jet. Gradients w.r.t. ray origin, ray direction, box min and box max
# -- 12 parameters from one intersection.
#
# The slab method reduces, once the winning face is known, to a SINGLE plane:
# with face = 2*k + p, the answer is
# [measured: tests/modules.tcyr "2.10.1 geo_jet_aabb"]
#
#     t = (b_k - o_k) / d_k,   b = min when p = 0, max when p = 1
#
# and every other slab contributed only an inequality that decided WHETHER there
# is a hit, not where. So all four gradients have support on axis k alone:
# [measured: tests/modules.tcyr "2.10.1 geo_jet_aabb"]
#
#     dt/do   : component k = -1/d_k          dt/dd  : component k = -t/d_k
#     dt/dmin : component k =  1/d_k if p = 0, else the zero vector
#     dt/dmax : component k =  1/d_k if p = 1, else the zero vector
#
# Homogeneity: d . (dt/dd) = d_k * (-t/d_k) = -t, as the shared contract requires.
#
# ⚠ EDGES AND CORNERS ARE NOT DIFFERENTIABLE, and this is the whole reason the
# core reports a tie rather than a face alone. When two slabs achieve the
# selected extremum exactly, the ray strikes an edge; three, a corner. `t` has a
# genuine kink there -- the gradient differs on either side -- so returning one
# side's answer would be a silent wrong number. The miss sentinel comes back
# instead, which is the same convention geo_jet_sphere uses at grazing incidence.
#
# Verified against central differences of the shipped `geo_ray_aabb` over
# randomised ray/box configurations, both from outside the box and from within
# it (the inside case returns the EXIT face, and is a different code path).
# [measured: tests/modules.tcyr "2.10.1 geo_jet_aabb"]
#must_use
public fn geo_jet_aabb(ray, aabb) {
    var out = alloc(GEO_FACE_OUT_BYTES);
    if (out == 0) { return 0; }
    var t = geo_ray_aabb_face(ray, aabb, out);
    if (f64_eq(t, 0) == 1) { return _geo_jet_miss(); }   # +0 or -0: see _geo_jet_miss
    if (f64_lt(f64_abs(t), F64_POS_INF) == 0) { return _geo_jet_miss(); }   # see _geo_jet_miss

    var face = load64(out);
    if (face == GEO_FACE_NONE) { return _geo_jet_miss(); }
    if (load64(out + 8) == 1) { return _geo_jet_miss(); }   # edge or corner: kink

    var k = geo_face_axis(face);
    var dk = _geo_jet_comp(GeoRay_direction(ray), k);
    # The core only assigns a face from a slab it did not skip. Through 3.3.4 that
    # made |dk| at least DBL_MIN (the parallel test was |d_k| < _GEO_F64_TINY; it was
    # EPSILON_F64 when this note was written, in 2.10.1). ⛔ 3.3.5 — the core skips
    # only d_k = 0 now and divides by a subnormal d_k, so a face can come from one, and
    # then 1/dk overflows below 2^-1024: dt/do = -1/dk is past DBL_MAX and this test
    # returns the miss jet, as for any gradient that overflows. Of the G1 slab sweep's
    # 90000 finite pairs, 1 hit jet became the miss this way (the 3.3.4 primal there
    # was wrong, on another face) and 88 misses became hits.
    # [measured: G1 slab sweep, 3.3.4 tree vs this one, 2026-10-11; cycc 6.6.14]
    var inv = f64_div(F64_ONE, dk);
    if (f64_lt(f64_abs(inv), F64_POS_INF) == 0) { return _geo_jet_miss(); }
    var zero = hvec3_new(0, 0, 0);
    if (zero == 0) { return 0; }
    var dt_db = _geo_jet_axis(k, inv);
    if (dt_db == 0) { return 0; }
    var dt_do = _geo_jet_axis(k, f64_neg(inv));
    if (dt_do == 0) { return 0; }
    var dt_dd = _geo_jet_axis(k, f64_neg(f64_mul(t, inv)));
    if (dt_dd == 0) { return 0; }

    var j = alloc(_GJ_BYTES);
    if (j == 0) { return 0; }
    _GeoJet_set_kind(j, GEO_JET_AABB);
    _GeoJet_set_t(j, t);
    _GeoJet_set_dt_do(j, dt_do);
    _GeoJet_set_dt_dd(j, dt_dd);
    if (geo_face_is_max(face) == 0) {
        _GeoJet_set_sv(j, dt_db);
        _GeoJet_set_sv1(j, zero);
    } else {
        _GeoJet_set_sv(j, zero);
        _GeoJet_set_sv1(j, dt_db);
    }
    _GeoJet_set_sv2(j, zero);
    _GeoJet_set_ss(j, 0);
    _GeoJet_set_face(j, face);
    return j;
}

# ONE local axis, not all three. geo_obb_axes rotates all three unit vectors and
# allocates a 24-byte array; the jet needs only the selected axis, and this is
# bit-identical to the entry geo_obb_axes would have written because it is the
# same call. 2.10.1 measured it at 1.083 us -> 872 ns (-19.5%) on a jet of twelve partials; that
# configuration predates 2.10.2's rotation partial, and the jet carries fifteen now. The 3.4.0
# rows read jet_obb 571 ns against ray_obb 281 ns, 2.0x its primal (3.4.1: this comment still
# quoted the 2.10.1 figures as current).
# [measured: bench-history.csv jet_obb]
fn _geo_jet_obb_axis(obb, k) {
    var q = GeoObb_rotation(obb);
    var u = 0;
    if (k == 0) {
        u = hvec3_unit_x();
    } else {
        if (k == 1) { u = hvec3_unit_y(); } else { u = hvec3_unit_z(); }
    }
    if (u == 0) { return 0; }
    return hquat_rotate_vec3(q, u);
}

# Ray-OBB jet. Gradients w.r.t. ray origin, ray direction, box centre and box
# half-extents -- 12 parameters from one intersection.
#
# Same reduction as the AABB, in the box's own frame. With face = 2*k + p, local
# axis a_k, e_k = a_k . (c - o), f_k = a_k . d and sg = -1 for p = 0 / +1 for
# p = 1, the selected plane gives
#
#     t = (e_k + sg * he_k) / f_k
#
#     dt/do     = -a_k / f_k              dt/dd = -t * a_k / f_k
#     dt/dcentre = +a_k / f_k             dt/dhalf_extents: component k = sg/f_k
#
# Homogeneity: d . (dt/dd) = -t * (a_k . d)/f_k = -t.
#
# dt/d(ROTATION), added 2.10.2 -- 15 partials in total.
#
# 2.10.1 deferred this, and the objection it recorded was correct: a FREE
# perturbation of an axis leaves the rotation group entirely, so the perturbed
# "OBB" is not an OBB and a finite difference across it measures nothing. The
# answer is to perturb WITHIN the group. For a world-frame angular vector w the
# rotation moves every axis by a_k -> a_k + w x a_k, and differentiating the face
# equation a_k . (p - c) = sg * he_k gives
#
#     (w x a_k) . (p - c) + f_k * dt = 0
#     w . [a_k x (p - c)] + f_k * dt = 0          [scalar triple product, cyclic]
#
#     dt/dw = [a_k x (c - p)] / f_k
#
# One cross product. It is a WORLD-FRAME ANGULAR gradient, three components, not
# a four-component quaternion one: that is the shape an optimiser wants (it lives
# in the Lie algebra, so a step is a valid rotation by construction), and it is
# the shape the derivation produces without a chain rule. A caller holding a
# quaternion applies the standard so(3) -> quaternion map itself, at the call
# site where the convention is known -- the same reasoning that left dt/dd a raw
# partial with geo_jet_dt_dd_unit offered separately.
#
# Verified against central differences of the shipped `geo_ray_obb`, perturbing
# the rotation by hquat_mul(from_axis_angle(e_i, +/-h), q): 36 comparisons over
# 12 ray configurations, worst |analytic - FD| 1.9e-10.
# [measured: tests/modules.tcyr "2.10.2 geo_jet_obb dt/d(rotation)"]
#
# Edges and corners behave exactly as for the AABB: the core reports the tie and
# this returns the miss sentinel.
#
# Verified against central differences of the shipped `geo_ray_obb`, over a box
# rotated off-axis so a mistake that only shows up under rotation cannot hide.
# [measured: tests/modules.tcyr "2.10.1 geo_jet_obb"]
#must_use
public fn geo_jet_obb(ray, obb) {
    var out = alloc(GEO_FACE_OUT_BYTES);
    if (out == 0) { return 0; }
    # geo_ray_obb_face's NaN for a refused rotation comes before it writes `out`, and only then
    # is this word left: the designed 0, where a NaN from a NaN input is the miss jet (3.4.1).
    store64(out, 0 - 1000);
    var t = geo_ray_obb_face(ray, obb, out);
    if (load64(out) == 0 - 1000) { return 0; }
    if (f64_eq(t, 0) == 1) { return _geo_jet_miss(); }   # +0 or -0: see _geo_jet_miss
    if (f64_lt(f64_abs(t), F64_POS_INF) == 0) { return _geo_jet_miss(); }   # see _geo_jet_miss

    var face = load64(out);
    if (face == GEO_FACE_NONE) { return _geo_jet_miss(); }
    if (load64(out + 8) == 1) { return _geo_jet_miss(); }   # edge or corner: kink

    var k = geo_face_axis(face);
    var axis = _geo_jet_obb_axis(obb, k);
    if (axis == 0) { return 0; }
    var fk = hvec3_dot(axis, GeoRay_direction(ray));
    # Since 3.3.6 the core divides by a subnormal f_k as geo_jet_aabb's does by d_k, so a
    # face can come from one; below 2^-1024 1 / f_k overflows and this is the miss jet,
    # as for any gradient that overflows.
    var inv = f64_div(F64_ONE, fk);
    if (f64_lt(f64_abs(inv), F64_POS_INF) == 0) { return _geo_jet_miss(); }
    var dt_dc = hvec3_scale(axis, inv);
    if (dt_dc == 0) { return 0; }
    var sg = f64_neg(inv);
    if (geo_face_is_max(face) == 1) { sg = inv; }

    var dt_do = hvec3_scale(axis, f64_neg(inv));
    if (dt_do == 0) { return 0; }
    var dt_dd = hvec3_scale(axis, f64_neg(f64_mul(t, inv)));
    if (dt_dd == 0) { return 0; }
    var sv1 = _geo_jet_axis(k, sg);
    if (sv1 == 0) { return 0; }
    var pa = geo_ray_at(ray, t);
    if (pa == 0) { return 0; }
    var cp = hvec3_sub(GeoObb_center(obb), pa);
    if (cp == 0) { return 0; }
    var ac = hvec3_cross(axis, cp);
    if (ac == 0) { return 0; }
    var sv2 = hvec3_scale(ac, inv);
    if (sv2 == 0) { return 0; }
    var j = alloc(_GJ_BYTES);
    if (j == 0) { return 0; }
    _GeoJet_set_kind(j, GEO_JET_OBB);
    _GeoJet_set_t(j, t);
    _GeoJet_set_dt_do(j, dt_do);
    _GeoJet_set_dt_dd(j, dt_dd);
    _GeoJet_set_sv(j, dt_dc);
    _GeoJet_set_sv1(j, sv1);
    _GeoJet_set_sv2(j, sv2);
    _GeoJet_set_ss(j, 0);
    _GeoJet_set_face(j, face);
    return j;
}

# The axis of a capsule with an infinite end, as src/geo.cyr's contract reads it (3.4.0): end - start
# with exactly one infinite component, along k. Writes k, the finite end F (a pointer; for the infinite
# cylinder, both ends infinite along k, the start, whose other coordinates the end's equal) and the
# end slot F's gradient goes to (0 start, 1 end) into ax, and returns 1 for the half-infinite capsule,
# 2 for the infinite cylinder, 0 otherwise (a finite capsule; no limit is the primal's miss).
fn _geo_jet_cap_axis(capsule, ax) {
    var st = GeoCapsule_start(capsule);
    var en = GeoCapsule_end(capsule);
    var nk = 0;
    var k = 0;
    for (var i = 0; i < 3; i = i + 1) {
        var di = f64_sub(load64(en + i * 8), load64(st + i * 8));
        if (f64_eq(di, di) == 0) { return 0; }
        if (f64_lt(f64_abs(di), F64_POS_INF) == 0) {
            nk = nk + 1;
            k = i;
        }
    }
    if (nk != 1) { return 0; }
    var sinf = f64_lt(f64_abs(load64(st + k * 8)), F64_POS_INF) == 0;
    var einf = f64_lt(f64_abs(load64(en + k * 8)), F64_POS_INF) == 0;
    store64(ax, k);
    store64(ax + 8, st);
    store64(ax + 16, 0);
    if (sinf == 1 && einf == 1) { return 2; }
    if (sinf == 1) {
        store64(ax + 8, en);
        store64(ax + 16, 1);
    }
    return 1;
}

# Ray-capsule jet. Gradients w.r.t. ray origin, ray direction, both endpoints and
# the radius -- 13 parameters from one intersection.
#
# A capsule is three surfaces, and the derivative differs per piece, so the
# primal reports which one produced the answer and this forms the matching
# gradient. Both are post-passes on the shipped primal, as everywhere else here.
#
# CAPS (and the degenerate start == end case) are a sphere at that endpoint:
# g = p - endpoint, and the gradients are geo_jet_sphere's, with the gradient
# w.r.t. the OTHER endpoint identically zero. That is not an approximation --
# moving the far endpoint does not move this cap.
#
# CYLINDER. With a = start, b = end, ab = b - a, u = p - a,
#   s = (u . ab)/(ab . ab)   and   q = u - s*ab   (the perpendicular component),
# the surface is F = q.q - r^2, whose gradient in p is 2q -- q is already
# perpendicular to ab, so the projector leaves it alone. Writing den = q.d:
#
#     dt/do = -q/den      dt/dd = t * dt/do      dt/dr = r/den
#     dt/da = (1 - s) * q/den                    dt/db = s * q/den
#
# The endpoint gradients come from dq: the `ds * ab` term drops out of q.dq
# because q . ab = 0, leaving dF/da = 2(s-1)q and dF/db = -2s q.
#
# ⚠ dt/da + dt/db = q/den = -dt/do is an ALGEBRAIC identity of those two
# expressions -- the s cancels -- so it holds for ANY shared error in them and
# cannot verify either. Exactly the trap recorded for the triangle's translation
# identity. It is asserted as a smoke test with that stated; finite differences
# of the shipped primal are the only real oracle.
#
# ⚠ THE CAP/CYLINDER SEAM IS DIFFERENTIABLE, unlike a box edge, so no tie
# sentinel is reported there. Hemisphere and cylinder are tangent at the seam, so
# the two branches' gradients agree in the limit: at s = 0, u is already
# perpendicular to ab so q = u = g, and (1-s) = 1 makes dt/da agree with the
# cap's +g/(g.d) while dt/db = 0 agrees with the cap's zero. The suite asserts
# that convergence across the seam rather than taking this paragraph's word.
#
# Verified against central differences of the shipped `geo_ray_capsule`, with the
# fixture required to exercise ALL THREE branches -- a sweep that only ever hits
# the barrel proves nothing about the caps, and the caps are where 2.10.0's
# defect lived.
# [measured: tests/modules.tcyr "2.10.1 geo_jet_capsule"]
#must_use
public fn geo_jet_capsule(ray, capsule) {
    var mcr = GeoCapsule_radius(capsule) & 0x7FFF_FFFF_FFFF_FFFF;
    if (mcr < 0x0370_0000_0000_0000 && mcr != 0) {   # 2^-968: see _geo_jet_sphere_up (3.4.1)
        var ju = _geo_jet_capsule_up(ray, capsule);
        if (ju != 1) { return ju; }
    }
    var out = alloc(GEO_FACE_OUT_BYTES);
    if (out == 0) { return 0; }
    var t = geo_ray_capsule_branch(ray, capsule, out);
    if (f64_eq(t, 0) == 1) { return _geo_jet_miss(); }   # +0 or -0: see _geo_jet_miss
    if (f64_lt(f64_abs(t), F64_POS_INF) == 0) { return _geo_jet_miss(); }   # see _geo_jet_miss

    var branch = load64(out);
    if (branch == GEO_FACE_NONE) { return _geo_jet_miss(); }

    var d = GeoRay_direction(ray);
    var p = geo_ray_at(ray, t);
    if (p == 0) { return 0; }
    var a = GeoCapsule_start(capsule);
    var b = GeoCapsule_end(capsule);
    var r = GeoCapsule_radius(capsule);
    # 3.4.0: a barrel hit on a capsule with an infinite end (src/geo.cyr's contract: the half-infinite
    # capsule from its finite end F along +-e_k, or the infinite cylinder) is differentiated about a
    # finite stretch of its axis line (ap, bp), and its end weights are set below. Through 3.3.7 and
    # 3.4.0's first lane the barrel's segment coordinate was Inf / Inf and the jet the miss.
    var hk = 0;
    var hslot = 0;
    var hkx = 0;
    var ap[24];
    var bp[24];
    if (branch == GEO_CAP_CYLINDER) {
        var hax: i64[3];
        hk = _geo_jet_cap_axis(capsule, &hax);
        if (hk != 0) {
            var kx = load64(&hax);
            hkx = kx;
            var fpt = load64(&hax + 8);
            hslot = load64(&hax + 16);
            for (var ci = 0; ci < 3; ci = ci + 1) {
                store64(&ap + ci * 8, load64(fpt + ci * 8));
                store64(&bp + ci * 8, load64(fpt + ci * 8));
            }
            if (hk == 2) { store64(&ap + kx * 8, 0); }
            var akx = load64(&ap + kx * 8);
            var bkx = f64_add(akx, F64_ONE);   # (exact unless |akx| >= 1; then halved toward 0, exact)
            if (f64_lt(f64_abs(akx), F64_ONE) == 0) { bkx = f64_sub(akx, f64_mul(akx, F64_HALF)); }
            store64(&bp + kx * 8, bkx);
            a = &ap;
            b = &bp;
        }
    }

    var g = hvec3_sub(p, a);
    if (g == 0) { return 0; }
    var wa = F64_ONE;               # weight of dt/da
    var wb = 0;                     # weight of dt/db
    var cpt = a;
    if (branch == GEO_CAP_END_CAP) {
        g = hvec3_sub(p, b);
        if (g == 0) { return 0; }
        wa = 0;
        wb = F64_ONE;
        cpt = b;
    }
    if (branch == GEO_CAP_CYLINDER) {
        var ab = hvec3_sub(b, a);
        if (ab == 0) { return 0; }
        var abab = hvec3_dot(ab, ab);
        var sfrac = 0;
        if ((abab & 0x7FFF_FFFF_FFFF_FFFF) < 0x0370_0000_0000_0000 || abab >= 0x7FF0_0000_0000_0000) {
            sfrac = _geo_jet_sfrac(g, ab);   # (3.4.1: |ab|^2 below 2^-968 or past DBL_MAX)
        } else { sfrac = f64_div(hvec3_dot(g, ab), abab); }
        var abs_ = hvec3_scale(ab, sfrac);
        if (abs_ == 0) { return 0; }
        g = hvec3_sub(g, abs_);
        if (g == 0) { return 0; }
        wa = f64_sub(F64_ONE, sfrac);
        wb = sfrac;
        # (3.4.0: along an axis e_k the part across it is exactly g with its k component 0; the
        # projection's rounding there, 2^-53 of p - F along the axis, is not.)
        if (hk != 0) { store64(g + hkx * 8, 0); }
    }
    # 3.3.7: as geo_jet_sphere, where r is below an ulp of the hit: the caps' g from
    # _geo_jet_round_g, the barrel's g and segment coordinate from _geo_jet_barrel_g. The
    # roadmap's capsule (0.05 DBL_MAX, 0, 0)-(0.06 DBL_MAX, 0, 0), r = 1, met from 0 along +x
    # at its start cap, read the miss jet.
    var rgf = 0;
    var gp[40];
    if (_geo_jet_far(ray, t, cpt, r) == 1) {
        if (branch == GEO_CAP_CYLINDER) {
            rgf = _geo_jet_barrel_g(ray, t, a, b, r, &gp);
            if (rgf < 0) { return 0; }
            if (rgf == 1) {
                wb = load64(&gp + 32);
                wa = f64_sub(F64_ONE, wb);
            }
        } else {
            rgf = _geo_jet_round_g(ray, t, cpt, r, &gp);
            if (rgf < 0) { return 0; }
        }
    }

    # 3.4.0: the ends of a capsule with an infinite end. Moving F across the axis moves the barrel
    # with it, along the axis it moves nothing (g has no part along e_k): dt/dF = g / (g . d), weight
    # 1. The infinite end's other coordinates drop out of the limit set: weight 0. The infinite
    # cylinder exists only while its ends agree off the axis, so neither end has a derivative alone:
    # its two end slots are NaN (set at the end; weight 1 here only for the finiteness tests).
    if (hk == 1) {
        wa = F64_ONE;
        wb = 0;
        if (hslot == 1) {
            wa = 0;
            wb = F64_ONE;
        }
    }
    if (hk == 2) {
        wa = F64_ONE;
        wb = 0;
    }

    var den = hvec3_dot(g, d);
    # Grazing incidence: the ray is tangent to this piece and t is genuinely
    # non-differentiable. Same convention as geo_jet_sphere.
    var inv = f64_div(F64_ONE, den);
    var dt_do = 0;
    var back = 0;
    var ss = 0;
    if (f64_lt(f64_abs(inv), F64_POS_INF) == 0 || f64_eq(inv, 0) == 1 || rgf == 1) {
        # 3.3.6: den overflowed or is too small to invert (_geo_jet_round_scaled).
        var rp[24];
        var gg = g;
        var rr = r;
        if (rgf == 1) {
            gg = load64(&gp);
            rr = load64(&gp + 8);
        }
        var rsc = _geo_jet_round_scaled(gg, d, rr, &rp);
        if (rsc < 0) { return 0; }
        if (rsc == 0) { return _geo_jet_miss(); }
        dt_do = hvec3_scale(load64(&rp), f64_neg(load64(&rp + 8)));
        if (dt_do == 0) { return 0; }
        back = hvec3_scale(load64(&rp), load64(&rp + 8));
        if (back == 0) { return 0; }
        ss = load64(&rp + 16);
        var dtt = hvec3_scale(dt_do, t);
        if (dtt == 0) { return 0; }
        if (_geo_jet_finite3(dt_do) + _geo_jet_finite3(dtt) != 2) { return _geo_jet_miss(); }
        var bwa = hvec3_scale(back, wa);
        if (bwa == 0) { return 0; }
        var bwb = hvec3_scale(back, wb);
        if (bwb == 0) { return 0; }
        if (_geo_jet_finite3(bwa) + _geo_jet_finite3(bwb) != 2) {
            return _geo_jet_miss();
        }
        if (f64_lt(f64_abs(ss), F64_POS_INF) == 0) { return _geo_jet_miss(); }
    } else {
        dt_do = hvec3_scale(g, f64_neg(inv));
        if (dt_do == 0) { return 0; }
        back = hvec3_scale(g, inv);      # +g/den, the shared endpoint direction
        if (back == 0) { return 0; }
        ss = f64_mul(r, inv);
    }

    var dt_dd = hvec3_scale(dt_do, t);
    if (dt_dd == 0) { return 0; }
    var sv = hvec3_scale(back, wa);
    if (sv == 0) { return 0; }
    var sv1 = hvec3_scale(back, wb);
    if (sv1 == 0) { return 0; }
    var sv2 = hvec3_new(0, 0, 0);
    if (sv2 == 0) { return 0; }
    if (hk == 2) {
        var hnan = f64_sub(F64_POS_INF, F64_POS_INF);
        sv = hvec3_new(hnan, hnan, hnan);
        if (sv == 0) { return 0; }
        sv1 = hvec3_new(hnan, hnan, hnan);
        if (sv1 == 0) { return 0; }
    }
    var j = alloc(_GJ_BYTES);
    if (j == 0) { return 0; }
    _GeoJet_set_kind(j, GEO_JET_CAPSULE);
    _GeoJet_set_t(j, t);
    _GeoJet_set_dt_do(j, dt_do);
    _GeoJet_set_dt_dd(j, dt_dd);
    _GeoJet_set_sv(j, sv);
    _GeoJet_set_sv1(j, sv1);
    _GeoJet_set_sv2(j, sv2);
    _GeoJet_set_ss(j, ss);
    _GeoJet_set_face(j, branch);
    return j;
}

# ================================================================
# Typed shape-derivative accessors
# ================================================================
#
# Each checks `kind` and returns the error sentinel on a mismatch. The whole
# point of the tag: `sv` holds dt/d(center) on a sphere jet and dt/d(normal) on
# a plane jet, and those are different quantities in the same slot.

# dt/d(center) of a sphere jet (an HVec3, by reference); 0 for any other kind, a miss included.
#must_use
public fn geo_jet_sphere_dcenter(j) {
    if (_GeoJet_kind(j) != GEO_JET_SPHERE) { return 0; }
    return _GeoJet_sv(j);
}

# dt/d(radius) of a sphere jet, an f64; 0 for any other kind, a miss included.
#must_use
public fn geo_jet_sphere_dradius(j) {
    if (_GeoJet_kind(j) != GEO_JET_SPHERE) { return 0; }
    return _GeoJet_ss(j);
}

# dt/d(normal) of a plane jet (an HVec3, by reference), the partial with respect to the stored
# normal treated as a free vector; 0 for any other kind, a miss included.
#must_use
public fn geo_jet_plane_dnormal(j) {
    if (_GeoJet_kind(j) != GEO_JET_PLANE) { return 0; }
    return _GeoJet_sv(j);
}

# dt/d(distance) of a plane jet, an f64 (1 / (n . d)); 0 for any other kind, a miss included.
#must_use
public fn geo_jet_plane_ddistance(j) {
    if (_GeoJet_kind(j) != GEO_JET_PLANE) { return 0; }
    return _GeoJet_ss(j);
}

# dt/d(min corner) of an AABB jet (an HVec3, by reference): non-zero only on the axis of the
# face hit when that face is a min plane; 0 for any other kind, a miss included.
#must_use
public fn geo_jet_aabb_dmin(j) {
    if (_GeoJet_kind(j) != GEO_JET_AABB) { return 0; }
    return _GeoJet_sv(j);
}

# dt/d(max corner) of an AABB jet (an HVec3, by reference): non-zero only on the axis of the
# face hit when that face is a max plane; 0 for any other kind, a miss included.
#must_use
public fn geo_jet_aabb_dmax(j) {
    if (_GeoJet_kind(j) != GEO_JET_AABB) { return 0; }
    return _GeoJet_sv1(j);
}

# dt/d(center) of an OBB jet (an HVec3, by reference, world frame); 0 for any other kind, a miss
# included.
#must_use
public fn geo_jet_obb_dcenter(j) {
    if (_GeoJet_kind(j) != GEO_JET_OBB) { return 0; }
    return _GeoJet_sv(j);
}

# dt/d(half_extents), in the OBB's LOCAL frame -- component k is the extent along
# local axis k, which is how GeoObb stores it. Only the selected axis is nonzero.
#must_use
public fn geo_jet_obb_dhalf_extents(j) {
    if (_GeoJet_kind(j) != GEO_JET_OBB) { return 0; }
    return _GeoJet_sv1(j);
}

# dt/d(start) of a capsule jet (an HVec3, by reference); 0 for any other kind, a miss included.
#must_use
public fn geo_jet_capsule_dstart(j) {
    if (_GeoJet_kind(j) != GEO_JET_CAPSULE) { return 0; }
    return _GeoJet_sv(j);
}

# dt/d(end) of a capsule jet (an HVec3, by reference); 0 for any other kind, a miss included.
#must_use
public fn geo_jet_capsule_dend(j) {
    if (_GeoJet_kind(j) != GEO_JET_CAPSULE) { return 0; }
    return _GeoJet_sv1(j);
}

# dt/d(radius) of a capsule jet, an f64; 0 for any other kind, a miss included.
#must_use
public fn geo_jet_capsule_dradius(j) {
    if (_GeoJet_kind(j) != GEO_JET_CAPSULE) { return 0; }
    return _GeoJet_ss(j);
}

# dt/d(rotation): the WORLD-FRAME ANGULAR gradient, three components. A step
# along it is a valid rotation by construction, which a four-component quaternion
# gradient would not be. See the derivation in geo_jet_obb's header.
#must_use
public fn geo_jet_obb_drotation(j) {
    if (_GeoJet_kind(j) != GEO_JET_OBB) { return 0; }
    return _GeoJet_sv2(j);
}

# The face the primal selected, in geo.cyr's encoding (2 * axis + plane), or
# GEO_FACE_NONE for a miss and for the primitives that have no faces. Exposed
# because a differentiable-rendering caller usually wants the surface normal at
# the hit, and recomputing it from the hit point reintroduces exactly the
# edge/corner ambiguity the jet just resolved.
#must_use
public fn geo_jet_face(j) {
    return _GeoJet_face(j);
}

# dt/d(v0) of a triangle jet (an HVec3, by reference); 0 for any other kind, a miss included.
#must_use
public fn geo_jet_tri_dv0(j) {
    if (_GeoJet_kind(j) != GEO_JET_TRIANGLE) { return 0; }
    return _GeoJet_sv(j);
}

# dt/d(v1) of a triangle jet (an HVec3, by reference); 0 for any other kind, a miss included.
#must_use
public fn geo_jet_tri_dv1(j) {
    if (_GeoJet_kind(j) != GEO_JET_TRIANGLE) { return 0; }
    return _GeoJet_sv1(j);
}

# dt/d(v2) of a triangle jet (an HVec3, by reference); 0 for any other kind, a miss included.
#must_use
public fn geo_jet_tri_dv2(j) {
    if (_GeoJet_kind(j) != GEO_JET_TRIANGLE) { return 0; }
    return _GeoJet_sv2(j);
}

# Tangential part of a direction gradient, (I - d d^T) v, for a caller whose
# direction is constrained to unit length. `dir` must be unit -- which is what
# `geo_ray_new` guarantees. Offered rather than applied automatically; see the
# scaling note in the module header.
#must_use
public fn geo_jet_dt_dd_unit(v, dir) {
    var pr = hvec3_scale(dir, hvec3_dot(v, dir));
    if (pr == 0) { return 0; }
    return hvec3_sub(v, pr);
}

# Pushforward of the hit POINT, not just the parameter. Given a perturbation of
# the ray (do, dd), the hit point moves by
#
#     dp = do + t*dd + d*(dt/do . do + dt/dd . dd)
#
# which is the chain rule through geo_ray_at. Returned for a caller that wants
# the surface point's motion rather than the parameter's. A new HVec3, or 0 when an allocation
# is refused. ON A MISS JET there is no hit point and the answer is (0, 0, 0), as the miss jet's
# own partials are: test geo_jet_hit first (3.4.1: this was not stated).
#must_use
public fn geo_jet_dpoint(j, ray, d_origin, d_dir) {
    if (geo_jet_hit(j) == 0) { return hvec3_new(0, 0, 0); }
    var t = _GeoJet_t(j);
    var dt = f64_add(hvec3_dot(_GeoJet_dt_do(j), d_origin),
      hvec3_dot(_GeoJet_dt_dd(j), d_dir));
    var dd = hvec3_scale(d_dir, t);
    if (dd == 0) { return 0; }
    var p = hvec3_add(d_origin, dd);
    if (p == 0) { return 0; }
    var rd = hvec3_scale(GeoRay_direction(ray), dt);
    if (rd == 0) { return 0; }
    return hvec3_add(p, rd);
}
