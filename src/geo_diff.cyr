# geo_diff.cyr -- differentiable ray-surface intersection (forward-mode jets)
# Usage: include "lib/geo_diff.cyr"
# Requires: alloc.cyr, math.cyr, error.cyr, f64_util.cyr, vec3.cyr, geo.cyr
#
# 2.10.0. Consumers that optimise THROUGH geometry -- differentiable rendering,
# inverse problems, shape fitting -- need not just the hit parameter `t` but its
# gradient with respect to the ray and the surface. This module returns both,
# from ONE evaluation, with no allocation beyond the returned jet.
#
# ================================================================
# WHY THIS IS NOT DUAL NUMBERS
# ================================================================
#
# `autodiff.cyr` ships forward-mode duals, and threading them through the
# intersection routines is the obvious construction. It was rejected on two
# measured grounds:
#
#   * Dual is a HEAP struct and every dual_* op allocates 16 bytes. Under the
#     bump allocator -- which never frees -- one ray/sphere intersection would
#     leak dozens of them per call, in a routine that costs 96 ns.
#   * Forward mode carries ONE seed direction per evaluation. A sphere jet has
#     7 independent parameters (origin 3, direction 3, radius 1) and a triangle
#     has 15, so a full gradient would need that many passes.
#
# The implicit function theorem gives the whole gradient in closed form instead.
# `t` is the root of F(o + t*d; theta) = 0, so differentiating along the surface:
#
#     dt/do     = -g / (g . d)
#     dt/dd     = t * dt/do                     [see the note on scaling below]
#     dt/dtheta = -(dF/dtheta) / (g . d)
#
# where g = grad F at the hit point and (g . d) is the denominator throughout --
# it vanishes exactly at grazing incidence, which is where `t` is genuinely
# non-differentiable, so the degenerate case is the true one rather than a
# numerical artefact.
#
# Everything below is therefore a POST-PASS on the shipped primal: each entry
# point calls the same `geo_ray_*` a non-differentiating caller would, then
# forms the gradient from the hit point. There is no second copy of any
# intersection algorithm, so none can drift from the one under test.
#
# ================================================================
# THE SCALING CONVENTION FOR dt/dd, STATED BECAUSE IT IS A CHOICE
# ================================================================
#
# `dt/dd` here is the RAW partial derivative of t with respect to the stored
# direction, treating d as a free vector. That is well-posed only because 2.10.0
# repaired `geo_ray_sphere` to carry its leading coefficient: before that, `t`
# was not degree -1 homogeneous in d and the radial part of this derivative
# described a function the primal was not computing.
# See docs/development/issues/archived/2026-08-10-ray-sphere-capsule-assume-unit-direction.md.
#
# A caller whose direction is CONSTRAINED to unit length -- which is what
# `geo_ray_new` produces -- wants only the tangential part, since a radial
# perturbation leaves the unit sphere. `geo_jet_dt_dd_unit` applies that
# projection, (I - d d^T) v. It is offered rather than baked in: silently
# projecting would make `d . (dt/dd)` read 0 when the true value is -t, and a
# consumer treating d as free would get a wrong answer with no way to see it.
#
# ================================================================
# LAYOUT
# ================================================================
#
# One fixed 72-byte jet regardless of primitive, with a `kind` tag. The shape
# derivative slots are typed by that tag and reached ONLY through per-primitive
# named accessors -- reading a sphere's radius slot off a plane jet returns the
# error sentinel rather than that plane's distance derivative. An untyped slot
# block would make those two indistinguishable at the call site.
#
# 2.10.1 added the `face` slot (64 -> 72 bytes), appended so no existing offset
# moves. It carries geo.cyr's face encoding for the branchy primitives and
# GEO_FACE_NONE for the smooth ones, which is also what a miss carries.

var GEO_JET_MISS     = 0;
var GEO_JET_PLANE    = 1;
var GEO_JET_SPHERE   = 2;
var GEO_JET_TRIANGLE = 3;
var GEO_JET_AABB     = 4;
var GEO_JET_OBB      = 5;
var GEO_JET_CAPSULE  = 6;

#derive(accessors)
struct GeoJet { kind; t; dt_do; dt_dd; sv; sv1; sv2; ss; face; }

# The shape-parameter slots, typed by `kind` and reachable only through the
# per-primitive accessors below:
#   plane     sv = dt/d(normal)   ss = dt/d(distance)
#   sphere    sv = dt/d(center)   ss = dt/d(radius)
#   triangle  sv = dt/d(v0)       sv1 = dt/d(v1)      sv2 = dt/d(v2)
#   aabb      sv = dt/d(min)      sv1 = dt/d(max)     face = the selected face
#   obb       sv = dt/d(center)   sv1 = dt/d(half_extents)   sv2 = dt/d(rotation)
#                                                                  face = ditto
#   capsule   sv = dt/d(start)    sv1 = dt/d(end)     ss = dt/d(radius)
#                                 face = the BRANCH (GEO_CAP_*), not a face

# Component k (0 = x, 1 = y, 2 = z) of an HVec3. Written as branches rather than
# load64(v + 8*k) so it does not depend on the struct's memory layout.
fn _geo_jet_comp(v, k) {
    if (k == 0) { return HVec3_x(v); }
    if (k == 1) { return HVec3_y(v); }
    return HVec3_z(v);
}

# A vector carrying `val` in component k and zero elsewhere. The box gradients
# are all of this shape: only the axis whose slab was selected moves t.
fn _geo_jet_axis(k, val) {
    if (k == 0) { return hvec3_new(val, 0, 0); }
    if (k == 1) { return hvec3_new(0, val, 0); }
    return hvec3_new(0, 0, val);
}

#must_use
fn _geo_jet_miss() {
    var j = alloc(sizeof(GeoJet));
    GeoJet_set_kind(j, GEO_JET_MISS);
    GeoJet_set_t(j, 0);
    # A miss still returns READABLE vectors, never null. Callers branch on
    # geo_jet_hit(); a caller that reads first must not fault -- the same
    # contract gjk_epa_3d was given in 2.8.3 and mpr_penetration in 2.9.1.
    GeoJet_set_dt_do(j, hvec3_new(0, 0, 0));
    GeoJet_set_dt_dd(j, hvec3_new(0, 0, 0));
    GeoJet_set_sv(j, hvec3_new(0, 0, 0));
    GeoJet_set_sv1(j, hvec3_new(0, 0, 0));
    GeoJet_set_sv2(j, hvec3_new(0, 0, 0));
    GeoJet_set_ss(j, 0);
    GeoJet_set_face(j, GEO_FACE_NONE);
    return j;
}

# 1 when the jet carries a real intersection, 0 for a miss.
fn geo_jet_hit(j) {
    if (GeoJet_kind(j) == GEO_JET_MISS) { return 0; }
    return 1;
}

# Ray-sphere jet. Gradients w.r.t. ray origin, ray direction, sphere centre and
# sphere radius, from a single intersection.
#
#   F = |p - c|^2 - r^2,  g = grad F / 2 = p - c
#   dt/do = -g/(g.d)      dt/dc = +g/(g.d)      dt/dr = r/(g.d)
#
# dt/dc is exactly -dt/do: translating the sphere one way is translating the ray
# the other. That is a real symmetry of the problem, not a shortcut -- but it
# also means an assertion comparing only those two is vacuous, so the suite
# checks each against finite differences of the primal independently.
#
# Verified against central differences of the shipped `geo_ray_sphere` over 200
# random configurations: worst |analytic - FD| was 4.2e-9 on dt/do and dt/dc,
# 6.3e-9 on dt/dd, 9.9e-10 on dt/dr.
# [measured: tests/modules.tcyr "2.10.0 geo_jet_sphere"]
#must_use
fn geo_jet_sphere(ray, sphere) {
    var t = geo_ray_sphere(ray, sphere);
    if (t == 0) { return _geo_jet_miss(); }

    var d = GeoRay_direction(ray);
    var p = geo_ray_at(ray, t);
    var g = hvec3_sub(p, GeoSphere_center(sphere));
    var den = hvec3_dot(g, d);

    # Grazing incidence: the ray is tangent, the two roots have merged, and t is
    # genuinely non-differentiable there. Report the miss sentinel rather than a
    # gradient of +/-Inf -- the non-differentiable point is a property of the
    # geometry, not a failure of this routine.
    if (f64_lt(f64_abs(den), EPSILON_F64) == 1) { return _geo_jet_miss(); }

    var inv = f64_div(F64_ONE, den);
    var dt_do = hvec3_scale(g, f64_neg(inv));

    var j = alloc(sizeof(GeoJet));
    GeoJet_set_kind(j, GEO_JET_SPHERE);
    GeoJet_set_t(j, t);
    GeoJet_set_dt_do(j, dt_do);
    GeoJet_set_dt_dd(j, hvec3_scale(dt_do, t));
    GeoJet_set_sv(j, hvec3_scale(g, inv));
    GeoJet_set_ss(j, f64_mul(GeoSphere_radius(sphere), inv));
    GeoJet_set_face(j, GEO_FACE_NONE);
    return j;
}

# Ray-plane jet. Gradients w.r.t. ray origin, ray direction, plane normal and
# plane distance.
#
#   F = n.p - dist,  g = n
#   dt/do = -n/(n.d)   dt/dn = -p/(n.d)   dt/ddist = 1/(n.d)
#
# dt/dn treats the normal as a free vector, matching how `GeoPlane` stores it;
# a caller holding it unit-constrained wants the tangential part, exactly as for
# dt/dd, and `geo_jet_dt_dd_unit` works on any HVec3.
#
# Verified against central differences of the shipped `geo_ray_plane` over 200
# random configurations: worst |analytic - FD| was 1.3e-8 on dt/do, 1.5e-6 on
# dt/dd, 3.0e-6 on dt/dn, 5.8e-9 on dt/ddist -- the larger residuals are FD
# truncation at near-grazing incidence, not disagreement.
# [measured: tests/modules.tcyr "2.10.0 geo_jet_plane"]
#must_use
fn geo_jet_plane(ray, plane) {
    var t = geo_ray_plane(ray, plane);
    if (t == 0) { return _geo_jet_miss(); }

    var d = GeoRay_direction(ray);
    var n = GeoPlane_normal(plane);
    var den = hvec3_dot(n, d);
    if (f64_lt(f64_abs(den), EPSILON_F64) == 1) { return _geo_jet_miss(); }

    var inv = f64_div(F64_ONE, den);
    var p = geo_ray_at(ray, t);
    var dt_do = hvec3_scale(n, f64_neg(inv));

    var j = alloc(sizeof(GeoJet));
    GeoJet_set_kind(j, GEO_JET_PLANE);
    GeoJet_set_t(j, t);
    GeoJet_set_dt_do(j, dt_do);
    GeoJet_set_dt_dd(j, hvec3_scale(dt_do, t));
    GeoJet_set_sv(j, hvec3_scale(p, f64_neg(inv)));
    GeoJet_set_ss(j, inv);
    GeoJet_set_face(j, GEO_FACE_NONE);
    return j;
}

# Ray-triangle jet. Gradients w.r.t. ray origin, ray direction and all three
# vertices -- 15 parameters from one intersection.
#
# The surface is the triangle's plane, F = n . (p - v0) with n = e1 x e2,
# e1 = v1 - v0, e2 = v2 - v0. The barycentric bounds decide only WHETHER there
# is a hit, not where it is, so they contribute nothing to the derivative in the
# interior -- and on the boundary `t` is not differentiable at all, which is
# what the primal's miss return already expresses.
#
# Both n and the constant term depend on the vertices, so the vertex gradients
# carry two contributions. With w = p - v0 and den = n . d:
#
#   dt/dv0 = -[ (e1 - e2) x w  -  n ] / den
#   dt/dv1 = -[ e2 x w ] / den
#   dt/dv2 = -[ w x e1 ] / den
#
# Verified against central differences of the shipped `geo_ray_triangle` over 382
# accepted random configurations: worst |analytic - FD| was 9.6e-10 across all
# five gradients.
# [measured: tests/modules.tcyr "2.10.0 geo_jet_triangle"]
#
# ⚠ The translation identity dt/dv0 + dt/dv1 + dt/dv2 == -dt/do holds, but it is
# an ALGEBRAIC identity of the three expressions above (the cross-product terms
# cancel exactly, leaving n/den), so it cannot detect a shared error in them.
# It is asserted as a smoke test only; finite differences are the real oracle.
#must_use
fn geo_jet_triangle(ray, tri) {
    var t = geo_ray_triangle(ray, tri);
    if (t == 0) { return _geo_jet_miss(); }

    var d = GeoRay_direction(ray);
    var v0 = GeoTriangle_v0(tri);
    var e1 = hvec3_sub(GeoTriangle_v1(tri), v0);
    var e2 = hvec3_sub(GeoTriangle_v2(tri), v0);
    var n = hvec3_cross(e1, e2);
    var den = hvec3_dot(n, d);
    if (f64_lt(f64_abs(den), EPSILON_F64) == 1) { return _geo_jet_miss(); }

    var inv = f64_div(F64_ONE, den);
    var w = hvec3_sub(geo_ray_at(ray, t), v0);
    var dt_do = hvec3_scale(n, f64_neg(inv));

    var j = alloc(sizeof(GeoJet));
    GeoJet_set_kind(j, GEO_JET_TRIANGLE);
    GeoJet_set_t(j, t);
    GeoJet_set_dt_do(j, dt_do);
    GeoJet_set_dt_dd(j, hvec3_scale(dt_do, t));
    GeoJet_set_sv(j, hvec3_scale(hvec3_sub(hvec3_cross(hvec3_sub(e1, e2), w), n),
    f64_neg(inv)));
    GeoJet_set_sv1(j, hvec3_scale(hvec3_cross(e2, w), f64_neg(inv)));
    GeoJet_set_sv2(j, hvec3_scale(hvec3_cross(w, e1), f64_neg(inv)));
    GeoJet_set_ss(j, 0);
    GeoJet_set_face(j, GEO_FACE_NONE);
    return j;
}

# Ray-AABB jet. Gradients w.r.t. ray origin, ray direction, box min and box max
# -- 12 parameters from one intersection.
#
# The slab method reduces, once the winning face is known, to a SINGLE plane:
# with face = 2*k + p, the answer is
# [measured: tests/modules.tcyr "2.10.1 geo_jet_aabb"]
#
#     t = (b_k - o_k) / d_k,   b = min when p = 0, max when p = 1
#
# and every other slab contributed only an inequality that decided WHETHER there
# is a hit, not where. So all four gradients have support on axis k alone:
# [measured: tests/modules.tcyr "2.10.1 geo_jet_aabb"]
#
#     dt/do   : component k = -1/d_k          dt/dd  : component k = -t/d_k
#     dt/dmin : component k =  1/d_k if p = 0, else the zero vector
#     dt/dmax : component k =  1/d_k if p = 1, else the zero vector
#
# Homogeneity: d . (dt/dd) = d_k * (-t/d_k) = -t, as the shared contract requires.
#
# ⚠ EDGES AND CORNERS ARE NOT DIFFERENTIABLE, and this is the whole reason the
# core reports a tie rather than a face alone. When two slabs achieve the
# selected extremum exactly, the ray strikes an edge; three, a corner. `t` has a
# genuine kink there -- the gradient differs on either side -- so returning one
# side's answer would be a silent wrong number. The miss sentinel comes back
# instead, which is the same convention geo_jet_sphere uses at grazing incidence.
#
# Verified against central differences of the shipped `geo_ray_aabb` over
# randomised ray/box configurations, both from outside the box and from within
# it (the inside case returns the EXIT face, and is a different code path).
# [measured: tests/modules.tcyr "2.10.1 geo_jet_aabb"]
#must_use
fn geo_jet_aabb(ray, aabb) {
    var out = alloc(GEO_FACE_OUT_BYTES);
    var t = geo_ray_aabb_face(ray, aabb, out);
    if (t == 0) { return _geo_jet_miss(); }

    var face = load64(out);
    if (face == GEO_FACE_NONE) { return _geo_jet_miss(); }
    if (load64(out + 8) == 1) { return _geo_jet_miss(); }   # edge or corner: kink

    var k = geo_face_axis(face);
    var dk = _geo_jet_comp(GeoRay_direction(ray), k);
    # The core only assigns a face from a slab it did not skip, so |dk| is already
    # above EPSILON_F64. Re-checked rather than assumed: this reads `dk` back
    # through a different path than the one that set the face.
    if (f64_lt(f64_abs(dk), EPSILON_F64) == 1) { return _geo_jet_miss(); }

    var inv = f64_div(F64_ONE, dk);
    var zero = hvec3_new(0, 0, 0);
    var dt_db = _geo_jet_axis(k, inv);

    var j = alloc(sizeof(GeoJet));
    GeoJet_set_kind(j, GEO_JET_AABB);
    GeoJet_set_t(j, t);
    GeoJet_set_dt_do(j, _geo_jet_axis(k, f64_neg(inv)));
    GeoJet_set_dt_dd(j, _geo_jet_axis(k, f64_neg(f64_mul(t, inv))));
    if (geo_face_is_max(face) == 0) {
        GeoJet_set_sv(j, dt_db);
        GeoJet_set_sv1(j, zero);
    } else {
        GeoJet_set_sv(j, zero);
        GeoJet_set_sv1(j, dt_db);
    }
    GeoJet_set_sv2(j, zero);
    GeoJet_set_ss(j, 0);
    GeoJet_set_face(j, face);
    return j;
}

# ONE local axis, not all three. geo_obb_axes rotates all three unit vectors and
# allocates a 24-byte array; the jet needs only the selected axis, and this is
# bit-identical to the entry geo_obb_axes would have written because it is the
# same call. Measured, bench_batch(2000, 200), mean of three runs:
# jet_obb 1.083 us -> 872 ns, -19.5%, which takes the jet from 2.2x its primal
# to 1.8x for all twelve partials.
# [measured: bench-history.csv jet_obb]
fn _geo_jet_obb_axis(obb, k) {
    var q = GeoObb_rotation(obb);
    if (k == 0) { return hquat_rotate_vec3(q, hvec3_unit_x()); }
    if (k == 1) { return hquat_rotate_vec3(q, hvec3_unit_y()); }
    return hquat_rotate_vec3(q, hvec3_unit_z());
}

# Ray-OBB jet. Gradients w.r.t. ray origin, ray direction, box centre and box
# half-extents -- 12 parameters from one intersection.
#
# Same reduction as the AABB, in the box's own frame. With face = 2*k + p, local
# axis a_k, e_k = a_k . (c - o), f_k = a_k . d and sg = -1 for p = 0 / +1 for
# p = 1, the selected plane gives
#
#     t = (e_k + sg * he_k) / f_k
#
#     dt/do     = -a_k / f_k              dt/dd = -t * a_k / f_k
#     dt/dcentre = +a_k / f_k             dt/dhalf_extents: component k = sg/f_k
#
# Homogeneity: d . (dt/dd) = -t * (a_k . d)/f_k = -t.
#
# dt/d(ROTATION), added 2.10.2 -- 15 partials in total.
#
# 2.10.1 deferred this, and the objection it recorded was correct: a FREE
# perturbation of an axis leaves the rotation group entirely, so the perturbed
# "OBB" is not an OBB and a finite difference across it measures nothing. The
# answer is to perturb WITHIN the group. For a world-frame angular vector w the
# rotation moves every axis by a_k -> a_k + w x a_k, and differentiating the face
# equation a_k . (p - c) = sg * he_k gives
#
#     (w x a_k) . (p - c) + f_k * dt = 0
#     w . [a_k x (p - c)] + f_k * dt = 0          [scalar triple product, cyclic]
#
#     dt/dw = [a_k x (c - p)] / f_k
#
# One cross product. It is a WORLD-FRAME ANGULAR gradient, three components, not
# a four-component quaternion one: that is the shape an optimiser wants (it lives
# in the Lie algebra, so a step is a valid rotation by construction), and it is
# the shape the derivation produces without a chain rule. A caller holding a
# quaternion applies the standard so(3) -> quaternion map itself, at the call
# site where the convention is known -- the same reasoning that left dt/dd a raw
# partial with geo_jet_dt_dd_unit offered separately.
#
# Verified against central differences of the shipped `geo_ray_obb`, perturbing
# the rotation by hquat_mul(from_axis_angle(e_i, +/-h), q): 36 comparisons over
# 12 ray configurations, worst |analytic - FD| 1.9e-10.
# [measured: tests/modules.tcyr "2.10.2 geo_jet_obb dt/d(rotation)"]
#
# Edges and corners behave exactly as for the AABB: the core reports the tie and
# this returns the miss sentinel.
#
# Verified against central differences of the shipped `geo_ray_obb`, over a box
# rotated off-axis so a mistake that only shows up under rotation cannot hide.
# [measured: tests/modules.tcyr "2.10.1 geo_jet_obb"]
#must_use
fn geo_jet_obb(ray, obb) {
    var out = alloc(GEO_FACE_OUT_BYTES);
    var t = geo_ray_obb_face(ray, obb, out);
    if (t == 0) { return _geo_jet_miss(); }

    var face = load64(out);
    if (face == GEO_FACE_NONE) { return _geo_jet_miss(); }
    if (load64(out + 8) == 1) { return _geo_jet_miss(); }   # edge or corner: kink

    var k = geo_face_axis(face);
    var axis = _geo_jet_obb_axis(obb, k);
    var fk = hvec3_dot(axis, GeoRay_direction(ray));
    if (f64_lt(f64_abs(fk), EPSILON_F64) == 1) { return _geo_jet_miss(); }

    var inv = f64_div(F64_ONE, fk);
    var dt_dc = hvec3_scale(axis, inv);
    var sg = f64_neg(inv);
    if (geo_face_is_max(face) == 1) { sg = inv; }

    var j = alloc(sizeof(GeoJet));
    GeoJet_set_kind(j, GEO_JET_OBB);
    GeoJet_set_t(j, t);
    GeoJet_set_dt_do(j, hvec3_scale(axis, f64_neg(inv)));
    GeoJet_set_dt_dd(j, hvec3_scale(axis, f64_neg(f64_mul(t, inv))));
    GeoJet_set_sv(j, dt_dc);
    GeoJet_set_sv1(j, _geo_jet_axis(k, sg));
    GeoJet_set_sv2(j, hvec3_scale(hvec3_cross(axis,
    hvec3_sub(GeoObb_center(obb), geo_ray_at(ray, t))), inv));
    GeoJet_set_ss(j, 0);
    GeoJet_set_face(j, face);
    return j;
}

# Ray-capsule jet. Gradients w.r.t. ray origin, ray direction, both endpoints and
# the radius -- 13 parameters from one intersection.
#
# A capsule is three surfaces, and the derivative differs per piece, so the
# primal reports which one produced the answer and this forms the matching
# gradient. Both are post-passes on the shipped primal, as everywhere else here.
#
# CAPS (and the degenerate start == end case) are a sphere at that endpoint:
# g = p - endpoint, and the gradients are geo_jet_sphere's, with the gradient
# w.r.t. the OTHER endpoint identically zero. That is not an approximation --
# moving the far endpoint does not move this cap.
#
# CYLINDER. With a = start, b = end, ab = b - a, u = p - a,
#   s = (u . ab)/(ab . ab)   and   q = u - s*ab   (the perpendicular component),
# the surface is F = q.q - r^2, whose gradient in p is 2q -- q is already
# perpendicular to ab, so the projector leaves it alone. Writing den = q.d:
#
#     dt/do = -q/den      dt/dd = t * dt/do      dt/dr = r/den
#     dt/da = (1 - s) * q/den                    dt/db = s * q/den
#
# The endpoint gradients come from dq: the `ds * ab` term drops out of q.dq
# because q . ab = 0, leaving dF/da = 2(s-1)q and dF/db = -2s q.
#
# ⚠ dt/da + dt/db = q/den = -dt/do is an ALGEBRAIC identity of those two
# expressions -- the s cancels -- so it holds for ANY shared error in them and
# cannot verify either. Exactly the trap recorded for the triangle's translation
# identity. It is asserted as a smoke test with that stated; finite differences
# of the shipped primal are the only real oracle.
#
# ⚠ THE CAP/CYLINDER SEAM IS DIFFERENTIABLE, unlike a box edge, so no tie
# sentinel is reported there. Hemisphere and cylinder are tangent at the seam, so
# the two branches' gradients agree in the limit: at s = 0, u is already
# perpendicular to ab so q = u = g, and (1-s) = 1 makes dt/da agree with the
# cap's +g/(g.d) while dt/db = 0 agrees with the cap's zero. The suite asserts
# that convergence across the seam rather than taking this paragraph's word.
#
# Verified against central differences of the shipped `geo_ray_capsule`, with the
# fixture required to exercise ALL THREE branches -- a sweep that only ever hits
# the barrel proves nothing about the caps, and the caps are where 2.10.0's
# defect lived.
# [measured: tests/modules.tcyr "2.10.1 geo_jet_capsule"]
#must_use
fn geo_jet_capsule(ray, capsule) {
    var out = alloc(GEO_FACE_OUT_BYTES);
    var t = geo_ray_capsule_branch(ray, capsule, out);
    if (t == 0) { return _geo_jet_miss(); }

    var branch = load64(out);
    if (branch == GEO_FACE_NONE) { return _geo_jet_miss(); }

    var d = GeoRay_direction(ray);
    var p = geo_ray_at(ray, t);
    var a = GeoCapsule_start(capsule);
    var b = GeoCapsule_end(capsule);
    var r = GeoCapsule_radius(capsule);

    var g = hvec3_sub(p, a);
    var wa = F64_ONE;               # weight of dt/da
    var wb = 0;                     # weight of dt/db
    if (branch == GEO_CAP_END_CAP) {
        g = hvec3_sub(p, b);
        wa = 0;
        wb = F64_ONE;
    }
    if (branch == GEO_CAP_CYLINDER) {
        var ab = hvec3_sub(b, a);
        var sfrac = f64_div(hvec3_dot(g, ab), hvec3_dot(ab, ab));
        g = hvec3_sub(g, hvec3_scale(ab, sfrac));
        wa = f64_sub(F64_ONE, sfrac);
        wb = sfrac;
    }

    var den = hvec3_dot(g, d);
    # Grazing incidence: the ray is tangent to this piece and t is genuinely
    # non-differentiable. Same convention as geo_jet_sphere.
    if (f64_lt(f64_abs(den), EPSILON_F64) == 1) { return _geo_jet_miss(); }

    var inv = f64_div(F64_ONE, den);
    var dt_do = hvec3_scale(g, f64_neg(inv));
    var back = hvec3_scale(g, inv);      # +g/den, the shared endpoint direction

    var j = alloc(sizeof(GeoJet));
    GeoJet_set_kind(j, GEO_JET_CAPSULE);
    GeoJet_set_t(j, t);
    GeoJet_set_dt_do(j, dt_do);
    GeoJet_set_dt_dd(j, hvec3_scale(dt_do, t));
    GeoJet_set_sv(j, hvec3_scale(back, wa));
    GeoJet_set_sv1(j, hvec3_scale(back, wb));
    GeoJet_set_sv2(j, hvec3_new(0, 0, 0));
    GeoJet_set_ss(j, f64_mul(r, inv));
    GeoJet_set_face(j, branch);
    return j;
}

# ================================================================
# Typed shape-derivative accessors
# ================================================================
#
# Each checks `kind` and returns the error sentinel on a mismatch. The whole
# point of the tag: `sv` holds dt/d(center) on a sphere jet and dt/d(normal) on
# a plane jet, and those are different quantities in the same slot.

#must_use
fn geo_jet_sphere_dcenter(j) {
    if (GeoJet_kind(j) != GEO_JET_SPHERE) { return 0; }
    return GeoJet_sv(j);
}

#must_use
fn geo_jet_sphere_dradius(j) {
    if (GeoJet_kind(j) != GEO_JET_SPHERE) { return 0; }
    return GeoJet_ss(j);
}

#must_use
fn geo_jet_plane_dnormal(j) {
    if (GeoJet_kind(j) != GEO_JET_PLANE) { return 0; }
    return GeoJet_sv(j);
}

#must_use
fn geo_jet_plane_ddistance(j) {
    if (GeoJet_kind(j) != GEO_JET_PLANE) { return 0; }
    return GeoJet_ss(j);
}

#must_use
fn geo_jet_aabb_dmin(j) {
    if (GeoJet_kind(j) != GEO_JET_AABB) { return 0; }
    return GeoJet_sv(j);
}

#must_use
fn geo_jet_aabb_dmax(j) {
    if (GeoJet_kind(j) != GEO_JET_AABB) { return 0; }
    return GeoJet_sv1(j);
}

#must_use
fn geo_jet_obb_dcenter(j) {
    if (GeoJet_kind(j) != GEO_JET_OBB) { return 0; }
    return GeoJet_sv(j);
}

# dt/d(half_extents), in the OBB's LOCAL frame -- component k is the extent along
# local axis k, which is how GeoObb stores it. Only the selected axis is nonzero.
#must_use
fn geo_jet_obb_dhalf_extents(j) {
    if (GeoJet_kind(j) != GEO_JET_OBB) { return 0; }
    return GeoJet_sv1(j);
}

#must_use
fn geo_jet_capsule_dstart(j) {
    if (GeoJet_kind(j) != GEO_JET_CAPSULE) { return 0; }
    return GeoJet_sv(j);
}

#must_use
fn geo_jet_capsule_dend(j) {
    if (GeoJet_kind(j) != GEO_JET_CAPSULE) { return 0; }
    return GeoJet_sv1(j);
}

#must_use
fn geo_jet_capsule_dradius(j) {
    if (GeoJet_kind(j) != GEO_JET_CAPSULE) { return 0; }
    return GeoJet_ss(j);
}

# dt/d(rotation): the WORLD-FRAME ANGULAR gradient, three components. A step
# along it is a valid rotation by construction, which a four-component quaternion
# gradient would not be. See the derivation in geo_jet_obb's header.
#must_use
fn geo_jet_obb_drotation(j) {
    if (GeoJet_kind(j) != GEO_JET_OBB) { return 0; }
    return GeoJet_sv2(j);
}

# The face the primal selected, in geo.cyr's encoding (2 * axis + plane), or
# GEO_FACE_NONE for a miss and for the primitives that have no faces. Exposed
# because a differentiable-rendering caller usually wants the surface normal at
# the hit, and recomputing it from the hit point reintroduces exactly the
# edge/corner ambiguity the jet just resolved.
#must_use
fn geo_jet_face(j) {
    return GeoJet_face(j);
}

#must_use
fn geo_jet_tri_dv0(j) {
    if (GeoJet_kind(j) != GEO_JET_TRIANGLE) { return 0; }
    return GeoJet_sv(j);
}

#must_use
fn geo_jet_tri_dv1(j) {
    if (GeoJet_kind(j) != GEO_JET_TRIANGLE) { return 0; }
    return GeoJet_sv1(j);
}

#must_use
fn geo_jet_tri_dv2(j) {
    if (GeoJet_kind(j) != GEO_JET_TRIANGLE) { return 0; }
    return GeoJet_sv2(j);
}

# Tangential part of a direction gradient, (I - d d^T) v, for a caller whose
# direction is constrained to unit length. `dir` must be unit -- which is what
# `geo_ray_new` guarantees. Offered rather than applied automatically; see the
# scaling note in the module header.
#must_use
fn geo_jet_dt_dd_unit(v, dir) {
    return hvec3_sub(v, hvec3_scale(dir, hvec3_dot(v, dir)));
}

# Pushforward of the hit POINT, not just the parameter. Given a perturbation of
# the ray (do, dd), the hit point moves by
#
#     dp = do + t*dd + d*(dt/do . do + dt/dd . dd)
#
# which is the chain rule through geo_ray_at. Returned for a caller that wants
# the surface point's motion rather than the parameter's.
#must_use
fn geo_jet_dpoint(j, ray, d_origin, d_dir) {
    if (geo_jet_hit(j) == 0) { return hvec3_new(0, 0, 0); }
    var t = GeoJet_t(j);
    var dt = f64_add(hvec3_dot(GeoJet_dt_do(j), d_origin),
    hvec3_dot(GeoJet_dt_dd(j), d_dir));
    var p = hvec3_add(d_origin, hvec3_scale(d_dir, t));
    return hvec3_add(p, hvec3_scale(GeoRay_direction(ray), dt));
}
