# interval.cyr -- interval arithmetic for verified numerics
# Usage: shipped inside dist/hisab.cyr; in-tree, include "src/interval.cyr" after what it requires
# Requires: no other hisab module (stdlib resolves via cyrius.cyml [deps])
#
# Closed interval [lo, hi]. Operations propagate bounds.
# Layout: { lo: f64, hi: f64 } = 16 bytes

#derive(accessors)
public struct Interval { lo; hi; }

# Unbounded endpoints. An interval endpoint of +/-Infinity means "this bound is
# not finite", i.e. the enclosed SET is unbounded in that direction -- it does
# NOT mean the set contains an infinity. ivl_div needs them: dividing by an
# interval that straddles zero has an unbounded true range, and the only sound
# enclosure of an unbounded set is an unbounded interval.
var _IVL_F64_POS_INF = 0x7FF0_0000_0000_0000;  # +Infinity
var _IVL_F64_NEG_INF = 0xFFF0_0000_0000_0000;  # -Infinity
# The largest finite doubles: where ivl_new puts an INNER endpoint that overflowed.
var _IVL_F64_MAX     = 0x7FEF_FFFF_FFFF_FFFF;  # (2 - 2^-52) * 2^1023 = 1.7976931348623157e308
var _IVL_F64_NEG_MAX = 0xFFEF_FFFF_FFFF_FFFF;  # -(2 - 2^-52) * 2^1023 = -1.7976931348623157e308

# Every interval this module returns is built here, so this is where the two
# invariants live: lo <= hi, and lo < +Infinity and hi > -Infinity.
#
# ⛔ 3.3.3 — AN OVERFLOWED INNER ENDPOINT WAS STORED AS A DEGENERATE [+Inf, +Inf].
# The endpoints are rounded to nearest, so a bound beyond the largest finite double
# becomes Infinity, the INNER bound included: [1.23e308, 1.41e308] + [9.88e307,
# 1.11e308] returned [+Inf, +Inf], and so did ivl_sub, ivl_mul, ivl_div (also when a
# subnormal divisor's reciprocal overflows) and ivl_exp past 709.78. Under this
# module's convention an infinite endpoint means "unbounded", so a lower bound of
# +Infinity encloses no real number at all, not even the true sum 2.22e308, and
# [1.23e-300, 1.31e-300] / [101, 2025] * 2^-1074 excluded its finite true range
# (1.2e20 to 2.6e21). Adding [+Inf, +Inf] to its mirror [-Inf, -Inf] then formed
# Inf - Inf, and [NaN, NaN] is a catch-all that ivl_contains accepts everything into.
# Round-to-nearest overflows only for a value above the largest finite double, so
# replacing that endpoint with the largest finite double is exactly what outward
# rounding would have returned for it, and the interval stays a valid enclosure.
# A NaN endpoint is left alone: f64_eq is false for it.
# [measured: tests/edge_cases.tcyr, group "3.3.3 G3: an overflowed inner endpoint"]
#
# A sweep of 3000 random add, sub, mul, div and exp cases near the overflow
# thresholds, checked against exact rationals, returned no degenerate interval, and
# every INNER bound whose true value overflowed came back as exactly +/-DBL_MAX (311
# of them). 3.3.2 returned 467 degenerate intervals on the same cases.
# [measured: scratch harness, not reproducible in-tree, 2026-10-01; python3 Fraction oracle]
#
# LIMIT: no endpoint is rounded outward, so a finite endpoint can sit inside the
# exact bound. In the same sweep 1412 of 3262 finite endpoints did, by at most half
# an ulp for add, sub and mul, 0.67 ulp for exp and 0.99 ulp for div, which rounds
# twice (reciprocal, product).
# [measured: scratch harness, not reproducible in-tree, 2026-10-01; python3 Fraction oracle]
# ⚠ Those are the largest gaps THAT SWEEP met, not bounds. A divisor above 2^1022
# in magnitude has a subnormal reciprocal, which carries fewer bits: the point quotient
# 3.12e10 / 1.73e308 (0x421D0BDA51A75F88 / 0x7FEEB7102C030F84) comes back 3.6 ulp
# below the exact value, which it therefore excludes, and [-1.12e305, -1.38e278] /
# [-1.80e308, -1.00e-295] has a lower bound 4.1 ulp inside. f64_exp is 0.745 ulp off
# at -702.16. And an OUTER bound that underflows rounds to 0, the mirror of the
# overflow above: ivl_exp([-1000, -900]) and [1e-200, 2e-200] * [1e-200, 2e-200]
# are the degenerate [0, 0], excluding true ranges that are entirely positive, where
# outward rounding would give an upper bound of 2^-1074.
# [measured: scratch probe against a 3.3.3 bundle, cycc 6.6.12, 2026-10-01; python3 Fraction, 80-digit Decimal]
#must_use
public fn ivl_new(a, b) {
    var lo = a;
    var hi = b;
    if (f64_lt(b, a) == 1) {
        lo = b;
        hi = a;
    }
    if (f64_eq(lo, _IVL_F64_POS_INF) == 1) { lo = _IVL_F64_MAX; }
    if (f64_eq(hi, _IVL_F64_NEG_INF) == 1) { hi = _IVL_F64_NEG_MAX; }
    var v = alloc(sizeof(Interval));
    Interval_set_lo(v, lo);
    Interval_set_hi(v, hi);
    return v;
}

#must_use
public fn ivl_point(x) { return ivl_new(x, x); }

#must_use
public fn ivl_width(iv) { return f64_sub(Interval_hi(iv), Interval_lo(iv)); }

# ⛔ 3.3.3 — (lo + hi) / 2 OVERFLOWS FOR A FINITE INTERVAL NEAR THE TOP OF THE RANGE:
# the midpoint of [1.23e308, 1.41e308] came back +Infinity, outside the interval.
# When the sum is not finite, the halves are summed instead. That fallback fires
# for finite endpoints only when |lo + hi| rounds past the largest finite double,
# which needs both endpoints at least 2^970 in magnitude, so each half is exact and
# the result is the correctly rounded midpoint. The sum form stays first because
# halving first would lose a subnormal's last bit. With an infinite or NaN endpoint
# the fallback returns what the sum form did (+/-Infinity, or NaN for [-Inf, +Inf]).
# [measured: tests/edge_cases.tcyr, group "3.3.3 G3: ivl_midpoint near the top of the range"]
# The single rounding is what separates it from lo + (hi - lo) / 2, which rounds
# twice: for [2^970, DBL_MAX] the exact midpoint 2^1023 - 2^969 is a tie, the halves
# form gives the even 2^1023, and the textbook form 2^1023 - 2^970, one ulp below.
# [measured: tests/edge_cases.tcyr, group "3.3.3 R4num: ivl_midpoint's fallback rounds once"]
#must_use
public fn ivl_midpoint(iv) {
    var lo = Interval_lo(iv);
    var hi = Interval_hi(iv);
    var s = f64_add(lo, hi);
    if (f64_lt(f64_abs(s), _IVL_F64_POS_INF) == 0) {
        return f64_add(f64_mul(lo, F64_HALF), f64_mul(hi, F64_HALF));
    }
    return f64_mul(s, F64_HALF);
}

#must_use
public fn ivl_contains(iv, x) {
    if (f64_lt(x, Interval_lo(iv)) == 1) { return 0; }
    if (f64_gt(x, Interval_hi(iv)) == 1) { return 0; }
    return 1;
}

#must_use
public fn ivl_overlaps(a, b) {
    if (f64_gt(Interval_lo(a), Interval_hi(b)) == 1) { return 0; }
    if (f64_gt(Interval_lo(b), Interval_hi(a)) == 1) { return 0; }
    return 1;
}

# ================================================================
# Arithmetic
# ================================================================

#must_use
public fn ivl_add(a, b) {
    return ivl_new(f64_add(Interval_lo(a), Interval_lo(b)),
      f64_add(Interval_hi(a), Interval_hi(b)));
}

#must_use
public fn ivl_sub(a, b) {
    return ivl_new(f64_sub(Interval_lo(a), Interval_hi(b)),
      f64_sub(Interval_hi(a), Interval_lo(b)));
}

# Endpoint product with the 0 * Infinity convention interval arithmetic requires.
#
# An infinite endpoint means the enclosed SET is unbounded, not that it contains
# an infinity, so the products contributed by the element x = 0 of the other
# operand are all exactly 0 -- there is no element to pair with "infinity". IEEE
# 754 has no way to know that and returns NaN, which ivl_new cannot order around,
# so a single NaN endpoint turns the interval into a catch-all that ivl_contains
# reports as containing everything (the same failure mode ivl_sqrt had before
# 2.6.12). Only the exact (0, +/-Infinity) pair is special-cased: a NaN operand
# still propagates as NaN, because an interval with a NaN endpoint is already
# meaningless and silently rewriting it to 0 would hide that.
fn _ivl_mul_pt(x, y) {
    if (f64_eq(x, 0) == 1 && f64_eq(f64_abs(y), _IVL_F64_POS_INF) == 1) { return 0; }
    if (f64_eq(y, 0) == 1 && f64_eq(f64_abs(x), _IVL_F64_POS_INF) == 1) { return 0; }
    return f64_mul(x, y);
}

#must_use
public fn ivl_mul(a, b) {
    var al = Interval_lo(a); var ah = Interval_hi(a);
    var bl = Interval_lo(b); var bh = Interval_hi(b);
    var p1 = _ivl_mul_pt(al, bl);
    var p2 = _ivl_mul_pt(al, bh);
    var p3 = _ivl_mul_pt(ah, bl);
    var p4 = _ivl_mul_pt(ah, bh);
    var lo = f64_min(f64_min(p1, p2), f64_min(p3, p4));
    var hi = f64_max(f64_max(p1, p2), f64_max(p3, p4));
    return ivl_new(lo, hi);
}

# Enclosure of a/b over the two intervals, excluding the divisor value 0.
#
# The result is the interval HULL of  S = { x / y : x in A, y in B, y != 0 }.
#
# ENCLOSURE SOUNDNESS. Through 2.8.2 a divisor straddling zero returned the
# FINITE interval [-1e9, +1e9], which is not an enclosure of anything: S is
# unbounded whenever 0 is in B and A is not {0}, so [1,2] / [0,1] = [1, +inf)
# and the shipped answer excluded every quotient above 1e9 -- 1/1e-12 = 1e12 for
# one. This module's entire contract is that the returned interval CONTAINS the
# true range; an under-approximation is worse than no interval type at all,
# because every bound derived from it is silently wrong and nothing says so.
# 1e9 was not a bound, it was a decoration.
#
# The zero test goes through f64_le/f64_ge, NOT a raw integer `== 0`. Through
# 2.6.12 this read `bl == 0`, which compares the f64 BIT PATTERN against integer
# zero and therefore matches only +0.0 — negative zero is 0x8000000000000000,
# non-zero as an integer, so an interval whose endpoint was -0.0 slipped past the
# guard and divided by zero.
#
# The zero-straddling case is Kahan/Ratz extended division: B minus {0} splits
# into at most two half-lines,
#     y in [bl, 0)  ->  1/y in (-inf, 1/bl]
#     y in (0, bh]  ->  1/y in [1/bh, +inf)
# and the answer is the hull of A times each present half-line. That is EXACT --
# the tightest interval containing S -- not merely sound: [1,2]/[0,1] gives
# [1, +inf), [1,2]/[-1,0] gives (-inf, -1], [1,2]/[-1,1] gives the whole line
# (S really is (-inf,-1] union [1,+inf), whose hull is entire), and [0,0]/[-1,1]
# gives [0,0] because 0/y is 0 for every admissible y.
#
# UNBOUNDED RESULTS ARE SAFE TO ADD. ivl_add and ivl_sub form Infinity - Infinity
# only from an interval whose lower bound is +Infinity or whose upper bound is
# -Infinity, and ivl_new refuses to store either (3.3.3). An unbounded result of
# this function has its infinite bound on the OUTER side, so [1, +inf) + (-inf, -1]
# is (-inf, +inf), as it should be. ⛔ 3.3.3 — through 3.3.2 this paragraph was a
# LIMIT that blamed the unbounded results themselves, saying that adding one to
# another unbounded interval formed Inf - Inf. An infinite OUTER bound never does.
# The NaN that 3.3.2 did form came from an overflowed INNER bound, in ivl_new's
# callers (see there) and here, in the half-line bounds 1/bl and 1/bh of a
# zero-straddling divisor. A subnormal endpoint's reciprocal rounds to Infinity, so
# [1.23e-300, 1.31e-300] / [0, 2025 * 2^-1074] was the degenerate [+Inf, +Inf],
# which excluded its true range [1.2e20, +inf), its mirror over [-2025 * 2^-1074, 0]
# was [-Inf, -Inf], and the sum of the two was [NaN, NaN], an interval ivl_contains
# accepts every number into. Both half-line bounds are now clamped below, as
# ivl_new clamps, and that sum is the entire line.
# [measured: scratch probe against dist/hisab.cyr 3.3.2, cycc 6.6.12, 2026-10-01]
# [measured: tests/edge_cases.tcyr, group "3.3.3 R4num: ivl_new's guard order and an unbounded sum"]
#
# The clamped bound is sound but loose. The quotient goes through the reciprocal,
# so that division's lower bound is now lo(a) * DBL_MAX = 2.2e8 where the true one
# is 1.2e20, and the same holds for a subnormal divisor that does not straddle 0.
# Dividing the endpoints directly would keep 1.2e20, but it changes the rounding of
# every quotient, so it is not done here.
# [measured: tests/edge_cases.tcyr, group "3.3.3 G3: an overflowed inner endpoint"]
#
# An OUTER bound is not clamped, since an infinite outer bound is the honest
# "unbounded", so when the reciprocal overflows on that side a BOUNDED quotient comes
# back as the entire line. That needs a divisor endpoint below 1/DBL_MAX = 5.6e-309
# in magnitude: [-1.98e-308, 5.37e-309] / [-1.22e293, -5.14e-309], whose exact range
# is [-1.045, 3.857], returns (-inf, +inf). Sound, but no tighter than no answer.
# [measured: scratch probe against a 3.3.3 bundle, cycc 6.6.12, 2026-10-01; python3 Fraction oracle]
#
# LIMIT: there is no empty interval. A [0, 0] divisor leaves S empty, and this
# returns the entire line, which encloses the empty set vacuously. ivl_sqrt
# returns [0, 0] for the same reason. An explicit entire/empty tag on the type
# would say "empty" instead; it is demand-gated.
#must_use
public fn ivl_div(a, b) {
    var al = Interval_lo(a); var ah = Interval_hi(a);
    var bl = Interval_lo(b); var bh = Interval_hi(b);

    if (f64_le(bl, 0) == 1 && f64_ge(bh, 0) == 1) {
        # B has a negative part iff bl < 0, a positive part iff bh > 0. Both
        # tests are FP comparisons, so -0.0 counts as zero and contributes no
        # half-line -- [-0.0, 1] behaves exactly like [0, 1], as it must.
        var has_neg = f64_lt(bl, 0);
        var has_pos = f64_gt(bh, 0);
        if (has_neg == 0 && has_pos == 0) {
            # B == [0, 0]: S is empty. hisab has no empty-interval
            # representation, so return the widest interval -- every interval
            # vacuously encloses the empty set, and entire is the one that
            # cannot be mistaken for a useful bound.
            return ivl_new(_IVL_F64_NEG_INF, _IVL_F64_POS_INF);
        }
        var lo = _IVL_F64_POS_INF;
        var hi = _IVL_F64_NEG_INF;
        if (has_neg == 1) {
            var nu = f64_div(F64_ONE, bl);          # half-line [-inf, 1/bl]
            if (f64_eq(nu, _IVL_F64_NEG_INF) == 1) { nu = _IVL_F64_NEG_MAX; }
            var n1 = _ivl_mul_pt(al, _IVL_F64_NEG_INF);
            var n2 = _ivl_mul_pt(al, nu);
            var n3 = _ivl_mul_pt(ah, _IVL_F64_NEG_INF);
            var n4 = _ivl_mul_pt(ah, nu);
            lo = f64_min(lo, f64_min(f64_min(n1, n2), f64_min(n3, n4)));
            hi = f64_max(hi, f64_max(f64_max(n1, n2), f64_max(n3, n4)));
        }
        if (has_pos == 1) {
            var pv = f64_div(F64_ONE, bh);          # half-line [1/bh, +inf]
            if (f64_eq(pv, _IVL_F64_POS_INF) == 1) { pv = _IVL_F64_MAX; }
            var q1 = _ivl_mul_pt(al, pv);
            var q2 = _ivl_mul_pt(al, _IVL_F64_POS_INF);
            var q3 = _ivl_mul_pt(ah, pv);
            var q4 = _ivl_mul_pt(ah, _IVL_F64_POS_INF);
            lo = f64_min(lo, f64_min(f64_min(q1, q2), f64_min(q3, q4)));
            hi = f64_max(hi, f64_max(f64_max(q1, q2), f64_max(q3, q4)));
        }
        return ivl_new(lo, hi);
    }
    return ivl_mul(a, ivl_new(f64_div(F64_ONE, bh), f64_div(F64_ONE, bl)));
}

#must_use
public fn ivl_neg(iv) {
    return ivl_new(f64_neg(Interval_hi(iv)), f64_neg(Interval_lo(iv)));
}

#must_use
public fn ivl_abs(iv) {
    var al = f64_abs(Interval_lo(iv));
    var ah = f64_abs(Interval_hi(iv));
    if (ivl_contains(iv, 0) == 1) {
        return ivl_new(0, f64_max(al, ah));
    }
    return ivl_new(f64_min(al, ah), f64_max(al, ah));
}

# Enclosure of sqrt over the interval, restricted to the non-negative part.
#
# The upper bound must be clamped too, not just the lower one. Through 2.6.12 only
# `lo` was clamped, so a wholly-negative interval called f64_sqrt on a negative hi
# and returned [0, NaN] — and ivl_new cannot order around a NaN, so ivl_contains
# then reported that interval as containing EVERYTHING, silently poisoning every
# downstream bound. Clamping both ends yields [0, 0] for a wholly-negative input.
# hisab has no empty-interval representation, and [0, 0] vacuously encloses the
# empty set, so this is sound where [0, NaN] was not.
#must_use
public fn ivl_sqrt(iv) {
    var lo = Interval_lo(iv);
    var hi = Interval_hi(iv);
    if (f64_lt(lo, 0) == 1) { lo = 0; }
    if (f64_lt(hi, 0) == 1) { hi = 0; }
    return ivl_new(f64_sqrt(lo), f64_sqrt(hi));
}

#must_use
public fn ivl_exp(iv) {
    return ivl_new(f64_exp(Interval_lo(iv)), f64_exp(Interval_hi(iv)));
}

# Enclosure of sin over the interval.
#
# The result is guaranteed to CONTAIN the true range — that is the whole contract
# of an interval type, and through 2.6.12 this function broke it. It returned only
# [min(sin a, sin b), max(sin a, sin b)] for any width <= PI, which is strictly
# NARROWER than the truth whenever the interval straddles an extremum without
# containing an endpoint at it: ivl_sin([1.4, 1.8]) returned [0.9738, 0.9854] and
# excluded 1.0, even though sin peaks at PI/2 ~ 1.5708 inside. An interval library
# that under-approximates is worse than none, because every downstream bound
# silently becomes unsound.
#
# The old "width > PI -> [-1, 1]" shortcut was sound but imprecise, and it is now
# unnecessary: extrema are located exactly rather than guessed at. sin attains +1
# at PI/2 + 2k*PI and -1 at -PI/2 + 2k*PI, so an extremum lies in [a, b] iff there
# is an integer k in the corresponding range — i.e. iff ceil(lo_k) <= floor(hi_k).
# This is both sound AND tighter than the shortcut: [0.1, 3.3] contains a maximum
# but no minimum, so it now yields [sin(3.3), 1] instead of the whole of [-1, 1].
#
# Rounding note: if an extremum sits within an ulp of an endpoint the integer test
# may not fire, but sin is flat there (its derivative is 0), so the endpoint value
# is already within O(eps^2) of +/-1. The enclosure stays sound to that order.
#must_use
public fn ivl_sin(iv) {
    var a = Interval_lo(iv);
    var b = Interval_hi(iv);
    var w = f64_sub(b, a);
    # A span of a full period always covers both extrema.
    if (f64_ge(w, F64_TAU) == 1) {
        return ivl_new(f64_neg(F64_ONE), F64_ONE);
    }
    var sa = f64_sin(a);
    var sb = f64_sin(b);
    var lo = f64_min(sa, sb);
    var hi = f64_max(sa, sb);

    # Maximum (+1) at PI/2 + 2k*PI: contained iff some integer k satisfies
    # (a - PI/2)/TAU <= k <= (b - PI/2)/TAU.
    var max_k_lo = f64_ceil(f64_div(f64_sub(a, F64_PI_2), F64_TAU));
    var max_k_hi = f64_floor(f64_div(f64_sub(b, F64_PI_2), F64_TAU));
    if (f64_le(max_k_lo, max_k_hi) == 1) { hi = F64_ONE; }

    # Minimum (-1) at -PI/2 + 2k*PI.
    var min_k_lo = f64_ceil(f64_div(f64_add(a, F64_PI_2), F64_TAU));
    var min_k_hi = f64_floor(f64_div(f64_add(b, F64_PI_2), F64_TAU));
    if (f64_le(min_k_lo, min_k_hi) == 1) { lo = f64_neg(F64_ONE); }

    return ivl_new(lo, hi);
}
