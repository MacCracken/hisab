# lie_ext.cyr -- Lie group extensions: SE(3), SO(3) explicit, adjoint, BCH
# Usage: shipped inside dist/hisab.cyr; in-tree, include "src/lie_ext.cyr" after what it requires
# Requires: src/complex.cyr, src/error.cyr, src/f64_util.cyr, src/lie.cyr, src/mat3.cyr, src/mat4.cyr,
#           src/quat.cyr, src/vec3.cyr, src/vec4.cyr (stdlib resolves via cyrius.cyml [deps])
#
# Provides:
#   SE(3)  -- Special Euclidean group (rigid body motions)
#   SO(3)  -- rotation group (3x3 matrix representation)
#   Adjoint representations for SO(3,1) and SE(3) (su2_adjoint is in lie.cyr since 3.3.0)
#   Baker-Campbell-Hausdorff formula (2nd and 3rd order)
#
# SE(3) layout: { rotation: SU(2) ptr, translation: HVec3 ptr } = 16 bytes
# SO(3) uses Mat3 from mat3.cyr (72 bytes, column-major)
# Twists (se(3) algebra) are 6-vectors stored as 48 bytes: [omega(3), v(3)].
#   Build one with se3_twist_new and read it with se3_twist_omega /
#   se3_twist_v. se3_exp and se3_adjoint take a twist, NOT an HVec3 -- an
#   HVec3 is 24 bytes and both read 48, which is a silent out-of-bounds read
#   that no null check can catch (see se3_twist_new).

# ================================================================
# CONSTANTS
# ================================================================

# Membership tolerance for so3_from_mat3. Every entry of a rotation matrix is
# bounded by 1, so an ABSOLUTE tolerance is the right scale here -- there is no
# dynamic range to normalise against. The rotations this module builds
# (so3_exp, so3_from_axis_angle, so3_from_quat) reproduce R^T R = I and
# det R = 1 to ~1e-16, seven orders inside this bound, so a legitimate rotation
# that has been through a compose chain is still accepted while a reflection
# (det = -1), a shear or a scaled rotation is rejected by a wide margin.
# 2.16.0 — where the small-angle SERIES takes over from the closed forms in
# `se3_exp` and `se3_log`. MEASURED, not chosen: below this the closed forms
# cancel catastrophically — at theta = 1e-7 `(theta - sin theta)/theta^3` reads
# 0.172 against a true 1/6, and at 1e-8 it is exactly 0 — while above it the
# truncated series starts to drift (1.6e-7 relative at theta = 1). At 0.1 the two
# agree to 2e-14, which is the closed form's own cancellation error, so the series
# is the accurate one there.
# [measured: series-vs-closed-form comparison over theta = 1e-4 .. 1, 2026-09-10]
var _LIE_SERIES_CUT = 0x3FB9_9999_9999_999A;  # 0.1
# 3.3.4 — DEGREE AUDIT of `_SO3_ORTHO_TOL` (its rationale is the first paragraph above). Both
# quantities it bounds, |(R^T R)_ij - delta_ij| and |det R - 1|, are dimensionless and of
# degree ONE in a perturbation E of R: R^T R - I = R^T E + E^T R + E^T E, and det(R + E) - 1
# is tr(R^T E) to first order. A degree-one 1e-9 matches them; nothing is squared against
# an unsquared bound, and a NaN or infinite entry fails `<` and is refused. Measured edge:
# R[0][0] of so3_exp((0.3, -0.2, 0.5)) moved by 2^-31 is accepted and by 1.5 * 2^-31
# refused; R^100000 of that rotation, and so3_exp of a subnormal omega, are accepted.
# [measured: scratch harness, not reproducible in-tree, 2026-10-03; cycc 6.6.14]
var _SO3_ORTHO_TOL = 0x3E112E0BE826D695;  # 1e-9

# ================================================================
# Internal helpers
# ================================================================

# Allocate a 6-vector (48 bytes): [v0, v1, v2, v3, v4, v5]
fn _vec6_new(a, b, c, d, e, f) {
    var v = alloc(48);
    if (v == 0) { return 0; }
    store64(v, a);
    store64(v + 8, b);
    store64(v + 16, c);
    store64(v + 24, d);
    store64(v + 32, e);
    store64(v + 40, f);
    return v;
}

fn _vec6_get(v, i) { return load64(v + i * 8); }

# Extract omega (first 3) and v (last 3) from a 6-vector twist
fn _twist_omega(tw) {
    return hvec3_new(_vec6_get(tw, 0), _vec6_get(tw, 1), _vec6_get(tw, 2));
}

fn _twist_v(tw) {
    return hvec3_new(_vec6_get(tw, 3), _vec6_get(tw, 4), _vec6_get(tw, 5));
}

# Build a twist 6-vector from omega (Vec3) and v (Vec3)
fn _twist_from(omega, v) {
    return _vec6_new(HVec3_x(omega), HVec3_y(omega), HVec3_z(omega),
      HVec3_x(v), HVec3_y(v), HVec3_z(v));
}

# Hat map: Vec3 -> 3x3 skew-symmetric matrix
# [omega]_x = [[0, -oz, oy], [oz, 0, -ox], [-oy, ox, 0]]
fn _skew3(v) {
    var ox = HVec3_x(v); var oy = HVec3_y(v); var oz = HVec3_z(v);
    var m = m3_new();
    if (m == 0) { return 0; }
    m3_set(m, 0, 1, oz);
    m3_set(m, 0, 2, f64_neg(oy));
    m3_set(m, 1, 0, f64_neg(oz));
    m3_set(m, 1, 2, ox);
    m3_set(m, 2, 0, oy);
    m3_set(m, 2, 1, f64_neg(ox));
    return m;
}

# 3x3 real matrix commutator [A, B] = AB - BA
fn _m3_commutator(a, b) {
    var ab = m3_mul(a, b);
    if (ab == 0) { return 0; }
    var ba = m3_mul(b, a);
    if (ba == 0) { return 0; }
    var nba = m3_scale(ba, f64_neg(F64_ONE));
    if (nba == 0) { return 0; }
    return m3_add(ab, nba);
}

# ================================================================
# SO(3) -- Rotation group (3x3 matrix representation)
# ================================================================
# Uses Mat3 from mat3.cyr. Column-major, 72 bytes.

# Rodrigues formula: R = I + sin(a) * K + (1 - cos(a)) * K^2
# where K = skew-symmetric matrix of normalized axis
public fn so3_from_axis_angle(axis, angle) {
    var nx = HVec3_x(axis); var ny = HVec3_y(axis); var nz = HVec3_z(axis);
    # 2.17.0: scaled norm, shared with lie.cyr — see `lie_norm3` there.
    var norm = lie_norm3(nx, ny, nz);
    # ⛔ Through 2.14.0 `norm`, the length of the caller's axis in the caller's own units,
    # was tested against an absolute 1e-12 (`EPSILON_F64`), and the fallback here, the
    # identity rotation, is a structurally valid element returned with no rc, so a caller
    # cannot tell it from a real answer. Measured on the sibling `so3_exp`: the general
    # Rodrigues path is exact across the whole range, so that guard was the sole cause of
    # ~296 decades of discarded rotation. 2.15.0 moved it to F64_TINY.
    # [measured: docs/audit/2026-09-09-epsilon-open.json]
    # ⚠ In 2.15.0 and 2.16.0 F64_TINY was exactly `norm == 0` here, because `norm` was a
    # raw sqrt of a sum of SQUARES, whose smallest non-zero value is ~2^-537. Since 2.17.0
    # it is the scaled `lie_norm3`, which returns subnormals, so through 3.3.3 this guard
    # returned the identity for a non-zero axis whose norm is below 2^-1022: axis
    # (2^-1023, 0, 0) at pi/2 gave R[1][1] = 1 where the answer is cos(pi/2). Audit D086.
    # [measured: scratch harness, not reproducible in-tree, 2026-09-30; cycc 6.6.12]
    # ⭐ 3.3.4: both ends of `norm` now take an exact power-of-two copy of the axis, as in
    # `su2_from_axis_angle` (lie.cyr), which says why; a zero axis keeps the identity.
    # Since 3.3.5 the top copy starts where 1/norm goes subnormal, as there.
    if (f64_lt(norm, F64_TINY) == 1) {
        if (f64_eq(norm, 0) == 1) { return m3_identity(); }
        var up = (1023 + 1023) << 52;   # 2^1023
        nx = f64_mul(nx, up); ny = f64_mul(ny, up); nz = f64_mul(nz, up);
        norm = lie_norm3(nx, ny, nz);
    }
    var inv = f64_div(F64_ONE, norm);
    if (f64_lt(inv, F64_TINY) == 1) {
        var dn = (1023 - 600) << 52;    # 2^-600
        nx = f64_mul(nx, dn); ny = f64_mul(ny, dn); nz = f64_mul(nz, dn);
        inv = f64_div(F64_ONE, lie_norm3(nx, ny, nz));
    }
    nx = f64_mul(nx, inv); ny = f64_mul(ny, inv); nz = f64_mul(nz, inv);

    var c = f64_cos(angle);
    var s = f64_sin(angle);
    # ⛔ 3.4.0 AND EARLIER — 1 - cos(angle) by subtraction, which is exact where cos > 1/2
    # (Sterbenz) and so keeps only cos's own rounding, amplified by cos / (1 - cos): up to
    # 6e15 ulp at small angles, and exactly 0 below ~2^-26, dropping the n n^T term: axis
    # (0.31, 0.71, 0) at 1e-5 had (col 0, row 1) 8.3e-8 relative off, and so3_exp, which
    # builds here, 7.9e-7. (Normwise the matrix was fine; componentwise it was not.)
    # ⭐ 3.4.1 — where cos > 3/4 the identity 1 - cos = sin^2 / (1 + cos), from the sin and
    # cos already in hand: no cancellation, within 2.6 ulp (2 sin^2(angle/2) is 1.9, for a
    # third transcendental call on the small-angle path so3_exp takes); at or below 3/4,
    # where the errors cross, the subtraction, within 1.5 ulp there and unchanged bit for
    # bit. (lie.cyr's lorentz_rotate does the same.)
    # [measured: tests/abuse.tcyr "3.4.1: 1 - cos and cosh - 1"; mpmath angle sweeps, LIE lane 2026-10-31]
    var omc = f64_sub(F64_ONE, c);
    if (f64_gt(c, 0x3FE8000000000000) == 1) {   # 0.75
        omc = f64_div(f64_mul(s, s), f64_add(F64_ONE, c));
    }

    var m = m3_new();
    if (m == 0) { return 0; }
    # R_ij = c * delta_ij + (1-c) * n_i * n_j - s * epsilon_ijk * n_k
    # col 0
    m3_set(m, 0, 0, f64_add(c, f64_mul(omc, f64_mul(nx, nx))));
    m3_set(m, 0, 1, f64_add(f64_mul(omc, f64_mul(nx, ny)), f64_mul(s, nz)));
    m3_set(m, 0, 2, f64_sub(f64_mul(omc, f64_mul(nx, nz)), f64_mul(s, ny)));
    # col 1
    m3_set(m, 1, 0, f64_sub(f64_mul(omc, f64_mul(ny, nx)), f64_mul(s, nz)));
    m3_set(m, 1, 1, f64_add(c, f64_mul(omc, f64_mul(ny, ny))));
    m3_set(m, 1, 2, f64_add(f64_mul(omc, f64_mul(ny, nz)), f64_mul(s, nx)));
    # col 2
    m3_set(m, 2, 0, f64_add(f64_mul(omc, f64_mul(nz, nx)), f64_mul(s, ny)));
    m3_set(m, 2, 1, f64_sub(f64_mul(omc, f64_mul(nz, ny)), f64_mul(s, nx)));
    m3_set(m, 2, 2, f64_add(c, f64_mul(omc, f64_mul(nz, nz))));
    return m;
}

# Convert SU(2) quaternion to 3x3 rotation matrix
public fn so3_from_quat(q) {
    var hq = su2_to_quat(q);
    if (hq == 0) { return 0; }
    return m3_from_quat(hq);
}

# Validate and return a Mat3 as SO(3).
# Checks R^T R == I on all nine entries and det(R) == +1, both to
# _SO3_ORTHO_TOL. Returns a fresh Mat3 copy, or 0 if m is null or is not a
# rotation.
#
# Through 2.8.2 this doc block claimed both checks and the body performed
# NEITHER -- it was a bare m3_copy, so a reflection, a shear or a scaled
# rotation was accepted and propagated into so3_compose/so3_log/so3_inverse as
# if it were a rotation (so3_inverse is a transpose, which is only an inverse
# for an orthogonal matrix). The only assertion was `!= 0`, which m3_copy
# cannot fail for any input. Implemented rather than deleting the doc: every
# other constructor in this file returns 0 on invalid input, and a caller
# reaching for `from_mat3` rather than `from_axis_angle`/`from_quat` is exactly
# the caller holding a matrix of unknown provenance.
public fn so3_from_mat3(m) {
    if (m == 0) { return 0; }

    # Orthogonality: R^T R - I must vanish on every entry.
    var mt = m3_transpose(m);
    if (mt == 0) { return 0; }
    var gram = m3_mul(mt, m);
    if (gram == 0) { return 0; }
    for (var c = 0; c < 3; c = c + 1) {
        for (var r = 0; r < 3; r = r + 1) {
            var want = 0;
            if (c == r) { want = F64_ONE; }
            if (f64_lt(f64_abs(f64_sub(m3_get(gram, c, r), want)), _SO3_ORTHO_TOL) == 0) {
                return 0;
            }
        }
    }

    # Orthogonal leaves det = +/-1. SO(3) is the +1 component: a determinant of
    # -1 is a reflection, which is orthogonal but not a rotation.
    if (f64_lt(f64_abs(f64_sub(m3_determinant(m), F64_ONE)), _SO3_ORTHO_TOL) == 0) {
        return 0;
    }

    return m3_copy(m);
}

# Group multiplication: matrix multiply
public fn so3_compose(a, b) { return m3_mul(a, b); }

# Inverse: transpose (R is orthogonal => R^-1 = R^T)
public fn so3_inverse(r) { return m3_transpose(r); }

# Exponential map: so(3) (3-vector omega) -> SO(3)
# Uses Rodrigues formula: exp([omega]_x) = I + sinc(theta)*K + (1-cos(theta))/theta^2 * K^2
public fn so3_exp(omega) {
    var ox = HVec3_x(omega); var oy = HVec3_y(omega); var oz = HVec3_z(omega);
    var theta = lie_norm3(ox, oy, oz);
    # ⛔ 3.3.4 — THIS WAS `theta < F64_TINY`, AND IT RETURNED THE IDENTITY FOR A NON-ZERO
    # SUBNORMAL omega, whose rotation carries omega_k off the diagonal: 52 of 52 binades of
    # (2^-k, 0, 0), k = 1023 .. 1074 (audit D086). Only omega = 0 has the identity for its
    # exponential.
    # [measured: scratch harness and Decimal oracle, not reproducible in-tree, 2026-10-03; cycc 6.6.14]
    # ⭐ Below DBL_MIN the answer is I + [omega]x to the last bit: sin(theta)/theta is within
    # 2^-2044 of 1, and (1 - cos(theta))/theta^2 * omega_i * omega_j is below 2^-2044, so an
    # off-diagonal entry's nearest double is +-omega_k itself (a zero entry's sign aside) and a
    # diagonal one's is 1. Through `so3_from_axis_angle` the entry is sin(theta) * n_k, rounded
    # twice on the subnormal grid: 350 of 3,342 subnormal omegas came back one ulp off there.
    # [measured: verify-liever scratch harness and Decimal oracle, not reproducible in-tree, 2026-10-03; cycc 6.6.14]
    if (f64_eq(theta, 0) == 1) {
        return m3_identity();
    }
    if (f64_lt(theta, F64_TINY) == 1) {
        var m = m3_identity();
        if (m == 0) { return 0; }
        m3_set(m, 0, 1, oz); m3_set(m, 1, 0, f64_neg(oz));
        m3_set(m, 2, 0, oy); m3_set(m, 0, 2, f64_neg(oy));
        m3_set(m, 1, 2, ox); m3_set(m, 2, 1, f64_neg(ox));
        return m;
    }
    return so3_from_axis_angle(omega, theta);
}

# Logarithmic map: SO(3) -> so(3) (3-vector), the principal log: omega = theta n with
# theta in [0, pi]. theta = atan2(|a| / 2, (tr(R) - 1) / 2) with a = [R32-R23, R13-R31,
# R21-R12] = 2 sin(theta) n; the axis is a / |a| up to a quarter turn and comes from the
# symmetric part R + R^T past it (3.4.1). A rotation by exactly pi has two logarithms,
# +-pi n; the one with its largest axis component positive is returned. For a rotation
# rounded to doubles (each entry within half an ulp of a rotation's), omega past a quarter
# turn is within 7 ulps of pi of the exact log of R's polar factor, the first-order bound
# derived below; the worst of 2,400,000 such rotations is 2.35 ulps of pi.
# R is meant to be a rotation, and this is no test that it is. A matrix with no rotation axis
# in its symmetric part, such as -I (det -1), returns NaN in every slot (3.4.0 returned (0, 0,
# pi)), but its neighbours are not rotations either and return finite logs: -0.999 I and the
# zero matrix give (pi, 0, 0), diag(-1, -1, -1 + 1e-9) gives (0, 0, pi). A non-finite
# entry gives NaN in every slot; the designed 0 is returned only for a refused allocation.
# [measured: review R2-LIE so3big.py, 40-digit polar-factor log; tests/modules_c.tcyr "3.4.1 LIE4: so3_log"]
public fn so3_log(R) {
    var tr = m3_trace(R);
    # ⛔ 3.3.3 — THE CLAMP BELOW TURNED AN INFINITE TRACE INTO A VALID ANGLE. An
    # infinite diagonal entry made cos_theta +-Inf and the clamp made it exactly +-1,
    # so the angle came from a cosine the matrix never had. so3_log(I with +Inf at
    # [0][0]) was (0, 0, 0), the logarithm of the identity; so3_exp((0.3, -0.2, 0.5))
    # with +Inf or -Inf on its diagonal came back as a finite, different rotation.
    # [measured: scratch harness, not reproducible in-tree, 2026-10-01; cycc 6.6.12]
    # ⭐ The house non-finite test on the trace, before the clamp can hide it: any
    # non-finite diagonal entry, or a finite diagonal whose sum overflows (no rotation
    # has one — its entries are at most 1 in magnitude), is NaN in every slot. An entry
    # OFF the diagonal does not reach this test; the same test on `asym` below covers it.
    if (f64_lt(f64_abs(tr), F64_POS_INF) == 0) {
        return hvec3_new(0x7FF8000000000000, 0x7FF8000000000000, 0x7FF8000000000000);
    }
    var cos_theta = f64_mul(f64_sub(tr, F64_ONE), F64_HALF);
    cos_theta = f64_clamp(cos_theta, f64_neg(F64_ONE), F64_ONE);

    # ⛔ 2.16.0 — SAME DEFECT AS `su2_log`, SAME CAUSE. `theta = acos((tr-1)/2)` and
    # for a small rotation the trace is 3 - theta^2, so (tr-1)/2 rounds to EXACTLY
    # 1.0 below theta ~ 1.5e-8 and acos returns 0. Measured on the 2.15.0 tree:
    # `so3_log(so3_exp((0,0,t)))` recovers t down to 2^-24 and returns exactly 0
    # from 2^-28 — the whole rotation, gone.
    # ⭐ The antisymmetric part of R is 2*sin(theta)*n, and sin keeps full relative
    # precision near 0 where cos keeps none, so the angle comes from
    # `atan2(|antisym|/2, cos_theta)` instead. No series is needed: theta/|antisym|
    # tends to 1/2 with both operands going to zero together.
    # [measured: round-trip probe over 60 decades, 2026-09-10]
    var ax = f64_sub(m3_get(R, 1, 2), m3_get(R, 2, 1));
    var ay = f64_sub(m3_get(R, 2, 0), m3_get(R, 0, 2));
    var az = f64_sub(m3_get(R, 0, 1), m3_get(R, 1, 0));
    # ⚠ Scaled, for the same reason as `su2_log`: squaring first would flush the
    # antisymmetric part to zero below ~2^-511 and lose the rotation again.
    # 2.17.0: this was 2.16.0's own inline copy of the technique; it is now the
    # shared `lie_norm3`, so there is one implementation rather than three.
    var asym = lie_norm3(ax, ay, az);

    # |antisym| == 0 is either the identity or a rotation by exactly pi; the trace
    # separates them, and only the pi case needs the eigenvector extraction below.
    # ⛔ 3.3.3 — BOTH TESTS WERE `f64_gt(asym, 0) == 0`, WHICH IS TRUE FOR NaN, and
    # each laundered a NaN off-diagonal entry differently. The first returned the zero
    # vector for the identity with one NaN off the diagonal. The second sent a NaN
    # `asym` into the eigenvector branch, which scales by `theta` — and ganita's
    # `atan2(NaN, 0)` was -pi/2, not NaN, through ganita 1.2.10 (D140; NaN from 1.2.11,
    # cyrius 6.6.13, and a consumer pinned below 6.6.13 still gets -pi/2) — so the EXACT quarter-turn
    # Rz(pi/2) with one NaN off the diagonal came back finite: (-0, -0, -pi/2), a
    # rotation by the right angle in the wrong direction, or (-1.11, -1.11, -0).
    # [measured: scratch harness, not reproducible in-tree, 2026-10-01; cycc 6.6.12]
    # ⭐ Exact-zero tests on both, so a NaN goes past them to the non-finite test below.
    if (f64_eq(asym, 0) == 1) {
        if (f64_gt(cos_theta, 0) == 1) { return hvec3_new(0, 0, 0); }
    }

    # ⛔ 3.3.3 — AN INFINITE ENTRY OFF THE DIAGONAL GAVE ZEROS BESIDE ONE NaN. The trace
    # test above cannot see it. `asym` was +Inf, so `theta / asym` below was exactly 0,
    # and 0 times each component is 0 except in the infinite one's slot, where it is
    # NaN: I with +Inf at (col 0, row 1) gave (0, 0, NaN). Finite entries whose
    # difference overflows did the same, and two whose differences are finite but
    # whose norm overflows gave (0, 0, 0), the identity's log.
    # [measured: scratch harness, not reproducible in-tree, 2026-10-01; cycc 6.6.12]
    # ⭐ The house non-finite test on `asym`, a norm, so it needs no `f64_abs`. The exit
    # above returns only for an `asym` of exactly 0, so this decides nothing it does. A
    # NaN `asym` (a NaN entry), NaN in every slot already, now returns here. (3.4.1: it
    # runs before the half-turn branch below, which reads the same entries.)
    if (f64_lt(asym, F64_POS_INF) == 0) {
        return hvec3_new(0x7FF8000000000000, 0x7FF8000000000000, 0x7FF8000000000000);
    }

    var theta = ganita_f64_atan2(f64_mul(asym, F64_HALF), cos_theta);

    # ⛔ 3.4.0 AND EARLIER — THE AXIS OF EVERY ROTATION NEAR A HALF TURN WAS ROUNDING NOISE.
    # The axis came from the antisymmetric part, 2 sin(theta) n, whose entries are
    # differences of O(1) matrix entries: their absolute error is ~2^-53, so the direction's
    # error is ~2^-53 / sin(theta), unbounded as theta -> pi. The eigenvector branch that
    # was meant for that end ran only when the antisymmetric part was EXACTLY 0, which a
    # rotation built in floating point almost never has: so3_from_axis_angle(n, F64_PI)
    # for n = (0.31, 0.71, -0.56) came back as (0, 2.8, -1.4), a different rotation
    # (|exp(log R) - R|_F = 0.33), and 100 of 100 random axes at pi were off by more than
    # 1e-3, 79 of them by more than 10%.
    # [measured: tests/abuse.tcyr "3.4.1: so3_log near a half turn", baseline 3.4.0]
    # ⭐ 3.4.1 — past a quarter turn (cos theta < 0) the axis comes from the SYMMETRIC part,
    # (R + R^T)/2 = cos(theta) I + (1 - cos theta) n n^T, where 1 - cos theta is in (1, 2]
    # and so loses nothing. Its column k minus cos(theta) e_k is (1 - cos theta) n_k n: on
    # the largest diagonal entry k, v = (R_kk - cos theta, (R_kj + R_jk) / 2, ...) has
    # v_k = (1 - cos theta) n_k^2 >= 1/3 (no cancellation) and is parallel to n, so n is
    # v normalised (below). Its sign is the one that makes
    # n . (antisymmetric part) >= 0, i.e. the axis the rotation turns about by theta < pi;
    # at an exact half turn there is no such sign, and v_k > 0 (the largest component
    # positive) is returned (-n is the other logarithm). theta itself is unchanged. Up to a
    # quarter turn the antisymmetric path is the better conditioned of the two
    # (sin theta >= 1 - cos theta) and keeps its bits.
    # A matrix that is not a rotation gets no axis from this: -I (det -1, trace -3) has
    # v = 0 and returns NaN in every slot (3.4.0 returned (0, 0, pi), a rotation by pi that
    # -I is not), as does any input whose v is 0: its largest diagonal entry equal to the
    # clamped cosine and that entry's symmetric off-diagonal part 0.
    # [measured: tests/modules_c.tcyr "3.4.1 LIE2: so3_log", review RV-LIE S1/N1]
    # ⚠ COST: past a quarter turn so3_log takes ~217 ns against 3.4.0's ~153 (+42%; the
    # first 3.4.1 form, 2 roots and 6 divisions, took ~243); up to a quarter turn, unchanged.
    # [measured: LIE2 lane direct-loop timing, same binary, 2026-10-31; tests/hisab.bcyr b41_so3_log_near_pi]
    if (f64_lt(cos_theta, 0) == 1 || f64_eq(asym, 0) == 1) {
        var r00 = m3_get(R, 0, 0); var r11 = m3_get(R, 1, 1); var r22 = m3_get(R, 2, 2);
        # (R_ij + R_ji) / 2, from m3_get (col, row); a halving is exact.
        var vx = 0; var vy = 0; var vz = 0;
        if (f64_ge(r00, r11) == 1 && f64_ge(r00, r22) == 1) {
            vx = f64_sub(r00, cos_theta);
            vy = f64_mul(f64_add(m3_get(R, 1, 0), m3_get(R, 0, 1)), F64_HALF);
            vz = f64_mul(f64_add(m3_get(R, 2, 0), m3_get(R, 0, 2)), F64_HALF);
        } elif (f64_ge(r11, r22) == 1) {
            vy = f64_sub(r11, cos_theta);
            vx = f64_mul(f64_add(m3_get(R, 1, 0), m3_get(R, 0, 1)), F64_HALF);
            vz = f64_mul(f64_add(m3_get(R, 2, 1), m3_get(R, 1, 2)), F64_HALF);
        } else {
            vz = f64_sub(r22, cos_theta);
            vx = f64_mul(f64_add(m3_get(R, 2, 0), m3_get(R, 0, 2)), F64_HALF);
            vy = f64_mul(f64_add(m3_get(R, 2, 1), m3_get(R, 1, 2)), F64_HALF);
        }
        # For a rotation |v| is in [1/3, 2], so the plain norm cannot flush or overflow; any
        # other matrix whose |v| leaves [2^-500, 2^500] takes the scaled norm instead.
        var vn = f64_sqrt(f64_add(f64_add(f64_mul(vx, vx), f64_mul(vy, vy)), f64_mul(vz, vz)));
        if (f64_gt(vn, 0x20B0000000000000) == 0 || f64_lt(vn, 0x5F30000000000000) == 0) {
            vn = lie_norm3(vx, vy, vz);
        }
        # Normalised twice: n0 = v / |v| carries |v|'s rounding as a common scale error, and
        # |n0|, the root of a sum within a few ulps of 1, takes most of it back out. With one
        # stage (omega = (theta / |v|) v, one root and one division) the log was less
        # accurate: the worst of one sample 2.27 ulps of pi against 1.78 here, its RMS 13-16% higher.
        # [measured: LIE2 lane, 32,000 rotations past a quarter turn, 50-digit polar-factor log, 2026-10-31]
        #
        # The doc block's bound, to first order, with u = 2^-53. R = Q (I + S): Q the polar factor,
        # S symmetric, ||S||_F <= 3 2^-54. Along omega: theta read from R is off by (sin / 2)
        # n^T S n (at most 1.1 u near pi, where |a| stops following the sine), the roundings of
        # the trace, |a| and atan2 add 2.6 u at pi, and nn, s and the product 4.5 u of theta: 17.8 u
        # at most. Across it: v = (1 - c) n_k n + (sym(QS) - dc I) e_k with n_k^2 >= 1/3, so the
        # axis moves by (1.5 u + 0.82 |dc|) / ((1 - c) n_k), 3.1 u at pi, and the roundings of v,
        # n0 and omega add 3 u of it: 19.2 u at most. Together 26.2 u, 6.6 ulps of pi, both largest
        # at theta = pi, n_k^2 = 1/3. The worst rotations found reach 0.41 of it.
        # [measured: LIE4 lane so3bound.py, so3chk.py on review R2-LIE's worst of 2,400,000 + 120,000 fresh]
        var nx = f64_div(vx, vn); var ny = f64_div(vy, vn); var nz = f64_div(vz, vn);
        var nn = f64_sqrt(f64_add(f64_add(f64_mul(nx, nx), f64_mul(ny, ny)), f64_mul(nz, nz)));
        var s = f64_div(theta, nn);
        var dot = f64_add(f64_add(f64_mul(vx, ax), f64_mul(vy, ay)), f64_mul(vz, az));
        if (f64_lt(dot, 0) == 1) { s = f64_neg(s); }
        return hvec3_new(f64_mul(s, nx), f64_mul(s, ny), f64_mul(s, nz));
    }

    # omega = theta * n, and (ax, ay, az) is 2*sin(theta)*n, so the scale is
    # theta / |antisym| — one division, by a quantity already known non-zero.
    var sc = f64_div(theta, asym);
    return hvec3_new(f64_mul(sc, ax), f64_mul(sc, ay), f64_mul(sc, az));
}

# ================================================================
# SE(3) -- Special Euclidean group (rigid body motions)
# ================================================================
# Layout: { rotation: SU(2) ptr, translation: HVec3 ptr } = 16 bytes
# rotation is an SU(2) element (32 bytes at the pointed-to address)
# translation is an HVec3 (24 bytes at the pointed-to address)

fn _se3_alloc(rot_ptr, trans_ptr) {
    var se = alloc(16);
    if (se == 0) { return 0; }
    store64(se, rot_ptr);
    store64(se + 8, trans_ptr);
    return se;
}

fn _se3_rot(se) { return load64(se); }
fn _se3_trans(se) { return load64(se + 8); }

# Construct SE(3) from SU(2) rotation and HVec3 translation.
# ⚠ The pose stores the two HANDLES it is given, not copies (3.4.1 states it; it has
# always been so): a later write through `rotation` or `translation` moves the pose, and
# two poses built from one handle share it. Every other SE(3) operation here returns
# fresh parts and never writes through a pose's. Neither handle is checked: a 0 part is
# stored as given, and reading it faults, so pass the designed 0 of a refused
# constructor only after checking it. Returns the 16-byte pose, or 0 when it cannot be
# allocated.
public fn se3_new(rotation, translation) {
    return _se3_alloc(rotation, translation);
}

# Build an se(3) twist -- a 48-byte 6-vector [omega(3), v(3)] -- from two HVec3.
# omega is the angular part, v the linear part. Returns 0 if either is null.
#
# This is the ONLY correct input shape for se3_exp and se3_adjoint, and until
# 2.8.2 there was no exported way to build one: every twist in the library came
# out of _twist_from, an internal. The suite duly passed a 24-byte HVec3 to
# se3_adjoint and asserted only `!= 0` -- which cannot see the 24-byte
# out-of-bounds read that _twist_v then performs at offsets 24/32/40. A pointer
# carries no length in Cyrius, so no guard inside se3_adjoint can detect a short
# buffer; the fix is to make the right shape the easy one to build.
public fn se3_twist_new(omega, v) {
    if (omega == 0 || v == 0) { return 0; }
    return _twist_from(omega, v);
}

# Angular part (components 0-2) of a 48-byte twist, as a fresh HVec3.
# Returns 0 if twist is null.
public fn se3_twist_omega(twist) {
    if (twist == 0) { return 0; }
    return _twist_omega(twist);
}

# Linear part (components 3-5) of a 48-byte twist, as a fresh HVec3.
# Returns 0 if twist is null.
public fn se3_twist_v(twist) {
    if (twist == 0) { return 0; }
    return _twist_v(twist);
}

# Identity: no rotation, no translation
public fn se3_identity() {
    # Both parts are checked (3.4.0): a pose with a 0 rotation or translation is not a
    # pose, and through 3.3.7 it came back as one when either was refused.
    var r = su2_identity();
    if (r == 0) { return 0; }
    var t = hvec3_zero();
    if (t == 0) { return 0; }
    return _se3_alloc(r, t);
}

# Extract rotation + translation from a 4x4 homogeneous matrix.
# Upper-left 3x3 -> quaternion via SU(2), column 3 rows 0-2 -> translation.
# ⚠ Assumes a RIGID transform: Shepperd's method below is only meaningful when the
# upper-left 3x3 is a rotation, and a scaled or sheared block is not detected.
# There is no scale-recovering (SRT) decompose.
public fn se3_from_mat4(m) {
    # Build quaternion from upper-left 3x3
    # Using Shepperd's method for robustness
    var r00 = m4_get(m, 0, 0); var r11 = m4_get(m, 1, 1); var r22 = m4_get(m, 2, 2);
    var tr = f64_add(f64_add(r00, r11), r22);

    var qw = 0; var qx = 0; var qy = 0; var qz = 0;

    if (f64_gt(tr, 0) == 1) {
        var s = f64_sqrt(f64_add(tr, F64_ONE));
        qw = f64_mul(s, F64_HALF);
        s = f64_div(F64_HALF, s);
        # qx = (R21 - R12) * s = (m4_get(m,1,2) - m4_get(m,2,1)) * s
        qx = f64_mul(f64_sub(m4_get(m, 1, 2), m4_get(m, 2, 1)), s);
        qy = f64_mul(f64_sub(m4_get(m, 2, 0), m4_get(m, 0, 2)), s);
        qz = f64_mul(f64_sub(m4_get(m, 0, 1), m4_get(m, 1, 0)), s);
    } else {
        if (f64_gt(r00, r11) == 1) {
            if (f64_gt(r00, r22) == 1) {
                # r00 largest
                var s = f64_sqrt(f64_add(f64_sub(f64_sub(r00, r11), r22), F64_ONE));
                qx = f64_mul(s, F64_HALF);
                s = f64_div(F64_HALF, s);
                qw = f64_mul(f64_sub(m4_get(m, 1, 2), m4_get(m, 2, 1)), s);
                qy = f64_mul(f64_add(m4_get(m, 0, 1), m4_get(m, 1, 0)), s);
                qz = f64_mul(f64_add(m4_get(m, 0, 2), m4_get(m, 2, 0)), s);
            } else {
                # r22 largest
                var s = f64_sqrt(f64_add(f64_sub(f64_sub(r22, r00), r11), F64_ONE));
                qz = f64_mul(s, F64_HALF);
                s = f64_div(F64_HALF, s);
                qw = f64_mul(f64_sub(m4_get(m, 0, 1), m4_get(m, 1, 0)), s);
                qx = f64_mul(f64_add(m4_get(m, 0, 2), m4_get(m, 2, 0)), s);
                qy = f64_mul(f64_add(m4_get(m, 1, 2), m4_get(m, 2, 1)), s);
            }
        } else {
            if (f64_gt(r11, r22) == 1) {
                # r11 largest
                var s = f64_sqrt(f64_add(f64_sub(f64_sub(r11, r00), r22), F64_ONE));
                qy = f64_mul(s, F64_HALF);
                s = f64_div(F64_HALF, s);
                qw = f64_mul(f64_sub(m4_get(m, 2, 0), m4_get(m, 0, 2)), s);
                qx = f64_mul(f64_add(m4_get(m, 0, 1), m4_get(m, 1, 0)), s);
                qz = f64_mul(f64_add(m4_get(m, 1, 2), m4_get(m, 2, 1)), s);
            } else {
                # r22 largest
                var s = f64_sqrt(f64_add(f64_sub(f64_sub(r22, r00), r11), F64_ONE));
                qz = f64_mul(s, F64_HALF);
                s = f64_div(F64_HALF, s);
                qw = f64_mul(f64_sub(m4_get(m, 0, 1), m4_get(m, 1, 0)), s);
                qx = f64_mul(f64_add(m4_get(m, 0, 2), m4_get(m, 2, 0)), s);
                qy = f64_mul(f64_add(m4_get(m, 1, 2), m4_get(m, 2, 1)), s);
            }
        }
    }

    var q = hquat_new(qx, qy, qz, qw);
    if (q == 0) { return 0; }
    var rot = su2_from_quat(q);
    if (rot == 0) { return 0; }
    var trans = hvec3_new(m4_get(m, 3, 0), m4_get(m, 3, 1), m4_get(m, 3, 2));
    if (trans == 0) { return 0; }
    return _se3_alloc(rot, trans);
}

# Convert SE(3) to 4x4 homogeneous matrix
public fn se3_to_mat4(se) {
    var rot = _se3_rot(se);
    var trans = _se3_trans(se);
    var q = su2_to_quat(rot);
    if (q == 0) { return 0; }
    var s = hvec3_new(F64_ONE, F64_ONE, F64_ONE);
    if (s == 0) { return 0; }
    return m4_from_srt(s, q, trans);
}

# Group multiplication: (R_a, t_a) * (R_b, t_b) = (R_a * R_b, R_a * t_b + t_a)
public fn se3_compose(a, b) {
    var ra = _se3_rot(a); var ta = _se3_trans(a);
    var rb = _se3_rot(b); var tb = _se3_trans(b);

    var r_new = su2_compose(ra, rb);
    if (r_new == 0) { return 0; }

    # Rotate t_b by R_a: use quaternion rotation q * v * q^-1
    # Convert tb to quat with w=0, then q*v*q^-1
    var rotated_t = su2_adjoint(ra, tb);
    if (rotated_t == 0) { return 0; }

    var t_new = hvec3_add(rotated_t, ta);
    if (t_new == 0) { return 0; }
    return _se3_alloc(r_new, t_new);
}

# Inverse: (R^-1, -R^-1 * t)
public fn se3_inverse(se) {
    var r = _se3_rot(se);
    var t = _se3_trans(se);
    var r_inv = su2_inv(r);
    if (r_inv == 0) { return 0; }

    # Rotate -t by R_inv
    var nt = hvec3_neg(t);
    if (nt == 0) { return 0; }
    var t_new = su2_adjoint(r_inv, nt);
    if (t_new == 0) { return 0; }

    return _se3_alloc(r_inv, t_new);
}

# Transform a point: R * v + t
public fn se3_transform_point(se, v) {
    var r = _se3_rot(se);
    var t = _se3_trans(se);

    # Rotate v by quaternion
    var rv = su2_adjoint(r, v);
    if (rv == 0) { return 0; }

    return hvec3_add(rv, t);
}

# Exponential map: se(3) twist (6-vector [omega, v]) -> SE(3)
# twist is a 48-byte allocation: [omega_x, omega_y, omega_z, v_x, v_y, v_z]
# SE(3) exp: R = exp([omega]_x), t = V * v
# where V = I + (1-cos(theta))/theta^2 * K + (theta - sin(theta))/theta^3 * K^2
# and K = skew(omega), theta = |omega|
public fn se3_exp(twist) {
    var omega = _twist_omega(twist);
    if (omega == 0) { return 0; }
    var vel = _twist_v(twist);
    if (vel == 0) { return 0; }

    var ox = HVec3_x(omega); var oy = HVec3_y(omega); var oz = HVec3_z(omega);
    var theta = lie_norm3(ox, oy, oz);

    # ⛔ 2.16.0 — THE GUARD COULD NOT SIMPLY BE LOWERED, WHICH IS WHY THIS WAITED.
    # 2.15.0 measured that putting DBL_MIN here introduces a NEW defect: the V
    # matrix divides by theta^2 and theta^3, and at theta <= 2.2e-162 both
    # `theta*theta` and `1 - cos(theta)` are exactly 0, so the coefficient becomes
    # 0/0 = NaN. The coefficients had to become computable at small theta FIRST.
    # [measured: docs/audit/2026-09-09-epsilon-open.json]
    # ⚠ An exactly zero twist has R = I and t = v, which is the identity of the
    # group and not an approximation of anything.
    # ⛔ 3.3.3 — AND ONLY THAT. This was `f64_gt(theta, 0) == 0`, TRUE for NaN, so a
    # NaN in ANY slot of omega returned R = I and t = v, a valid-looking motion: the z
    # slot here, x and y through `lie_norm3`'s dropped NaN. Exact-zero test now.
    # [measured: scratch harness, not reproducible in-tree, 2026-10-01; cycc 6.6.12]
    if (f64_eq(theta, 0) == 1) {
        var r0 = su2_identity();
        if (r0 == 0) { return 0; }
        return _se3_alloc(r0, vel);
    }

    # Rotation via SU(2) exp
    var rot = su2_exp(omega);
    if (rot == 0) { return 0; }

    # ⛔ 3.4.0 AND EARLIER — THE FORM BELOW HAS TWO ENDS. (1) Past theta ~ 2^341 theta^3
    # overflows, c2 is 0, and the K^2 term goes with it: |omega| = 1.7e103 gave t = v
    # where t is (n.v) n to the last bit, and past 2^511 K^2 itself overflows. (2) It is
    # also an amplifier on the way there: v + c2 K^2 v cancels to (sin theta / theta) v
    # off the axis, 486 eps of |t| at theta ~ 2^5 where the problem's own conditioning
    # is ~theta eps. [measured: tests/abuse.tcyr "3.4.1: se3_exp at the ends of |omega|"]
    # ⭐ 3.4.1 — from theta = 4 the same V on the unit axis n = omega / theta, with no
    # power of theta formed: t = s v + (1 - s)(n.v) n + a (n x v), s = sin(theta) / theta,
    # a = 2 sin^2(theta/2) / theta. 75 eps where the form below gave 486, and right at
    # every finite theta. Below 4 the form below is as accurate (3.1 against 4.5 eps on
    # [2, 4)) and keeps its bits. [measured: 600-twist mpmath sweep, LIE lane 2026-10-31]
    if (f64_ge(theta, 0x4010000000000000) == 1) {   # 4.0
        var nx = f64_div(ox, theta); var ny = f64_div(oy, theta); var nz = f64_div(oz, theta);
        var vx = HVec3_x(vel); var vy = HVec3_y(vel); var vz = HVec3_z(vel);
        var s = f64_div(f64_sin(theta), theta);
        var shf = f64_sin(f64_mul(theta, F64_HALF));
        var a = f64_div(f64_mul(F64_TWO, f64_mul(shf, shf)), theta);
        var k = f64_mul(f64_sub(F64_ONE, s), f64_add(f64_add(f64_mul(nx, vx), f64_mul(ny, vy)), f64_mul(nz, vz)));
        var cx = f64_sub(f64_mul(ny, vz), f64_mul(nz, vy));   # n x v
        var cy = f64_sub(f64_mul(nz, vx), f64_mul(nx, vz));
        var cz = f64_sub(f64_mul(nx, vy), f64_mul(ny, vx));
        var tx = f64_add(f64_add(f64_mul(s, vx), f64_mul(k, nx)), f64_mul(a, cx));
        var ty = f64_add(f64_add(f64_mul(s, vy), f64_mul(k, ny)), f64_mul(a, cy));
        var tz = f64_add(f64_add(f64_mul(s, vz), f64_mul(k, nz)), f64_mul(a, cz));
        var tl = hvec3_new(tx, ty, tz);
        if (tl == 0) { return 0; }
        return _se3_alloc(rot, tl);
    }

    # Compute V matrix: V = I + (1-cos)/theta^2 * K + (theta-sin)/theta^3 * K^2
    var K = _skew3(omega);
    if (K == 0) { return 0; }
    var K2 = m3_mul(K, K);
    if (K2 == 0) { return 0; }
    # ⭐ c1 NEEDS NO SERIES AND NO THETA^2 AT ALL. The half-angle identity
    # 1 - cos(t) = 2 sin^2(t/2) turns it into (sin(h)/h)^2 / 2 with h = t/2 — one
    # division by a quantity that is zero only when theta is, and no subtraction of
    # nearly-equal numbers anywhere. It is exact as theta -> 0, where sin(h) IS h.
    # ⛔ 3.4.0 AND EARLIER — "zero only when theta is" missed theta = 2^-1074, whose half
    # rounds to 0 (a tie, to even): sin(0)/0 was NaN and so was t, where t = v to the last
    # bit (ganita's sin(h) is h there, so the quotient is 1 for every h that is not 0).
    # [measured: tests/abuse.tcyr "3.4.1: se3_exp at the ends of |omega|", baseline 3.4.0]
    var hh = f64_mul(theta, F64_HALF);
    var sinc_h = F64_ONE;
    if (f64_eq(hh, 0) == 0) { sinc_h = f64_div(f64_sin(hh), hh); }
    var c1 = f64_mul(F64_HALF, f64_mul(sinc_h, sinc_h));

    # ⭐ c2 HAS NO SUCH IDENTITY, so this is the series the release is named for:
    #   (t - sin t)/t^3  =  1/6 - t^2/120 + t^4/5040 - t^6/362880 + ...
    # ⚠ Note what it buys: at theta = 1e-7 the closed form reads 0.172 against a
    # true 1/6 — a 3% error — and at 1e-8 it is exactly 0. The series is exact in
    # the limit and never touches theta^3, so a subnormal theta simply gives 1/6.
    # [measured: series-vs-closed-form comparison, theta = 1e-4 .. 1, 2026-09-10]
    var theta2 = f64_mul(theta, theta);
    var c2 = 0;
    if (f64_lt(theta, _LIE_SERIES_CUT) == 1) {
        var t4 = f64_mul(theta2, theta2);
        c2 = f64_sub(f64_div(F64_ONE, f64_from(6)), f64_div(theta2, f64_from(120)));
        c2 = f64_add(c2, f64_div(t4, f64_from(5040)));
        c2 = f64_sub(c2, f64_div(f64_mul(t4, theta2), f64_from(362880)));
    } else {
        c2 = f64_div(f64_sub(theta, f64_sin(theta)), f64_mul(theta2, theta));
    }

    var vi = m3_identity();
    if (vi == 0) { return 0; }
    var vk = m3_scale(K, c1);
    if (vk == 0) { return 0; }
    var vk2 = m3_scale(K2, c2);
    if (vk2 == 0) { return 0; }
    var v1 = m3_add(vi, vk);
    if (v1 == 0) { return 0; }
    var V = m3_add(v1, vk2);
    if (V == 0) { return 0; }
    var trans = m3_mul_vec3(V, vel);
    if (trans == 0) { return 0; }

    return _se3_alloc(rot, trans);
}

# Logarithmic map: SE(3) -> se(3) twist (6-vector), the principal log.
# Returns a 48-byte allocation: [omega_x, omega_y, omega_z, v_x, v_y, v_z], or the designed
# 0 for a refused allocation. omega is the rotation's principal log, |omega| <= pi up to
# rounding, and v = V(omega)^-1 t. That rounding is under 4.29 ulps of F64_PI over (4.01 above
# the true pi): su2_log's half
# angle is at most F64_PI_2 (exactly that at w = +-0; on x86 at every w > 0 as well), and its
# norm (3.46 u), division and products leave |omega| <= F64_PI (1 + 5.46 u), u = 2^-53. The
# worst of 200,000 exact half turns is 2.31; a search over w = 0 elements a little off unit
# length found 2.82.
# q and -q are one rotation: an element with w < 0 is logged as -q (3.4.1), so
# se3_exp(se3_log(T)) returns -q for it -- the same rigid motion, the other SU(2) sign
# (3.4.0 returned q, through the 2*pi - theta turn). At exactly pi (w = +0 or -0) nothing
# is negated and omega = pi (x, y, z) / |(x, y, z)| takes the element's own sign, which can
# be the opposite of so3_log's choice for the same matrix (largest component positive):
# both are logarithms. A non-finite component gives NaN in omega (su2_log).
# [measured: LIE2 lane se3_log probe, 7,000 elements; LIE4 lane normbound.py, se3climb.py; review R2-LIE se3max0.py]
public fn se3_log(se) {
    var rot = _se3_rot(se);
    var trans = _se3_trans(se);

    # ⛔ 3.4.0 AND EARLIER — NOT THE PRINCIPAL LOG FOR AN ELEMENT WITH w < 0. q and -q are
    # one rotation, and su2_log reads a negative w as a turn past pi: se3_from_mat4 builds
    # w < 0 for about half the rotations of 120 degrees or more (Shepperd's branches take
    # w's sign from the matrix), and se3_log returned the turn of 2*pi - theta about -n,
    # disagreeing with so3_log of the same matrix; at a turn near 2*pi V is near singular
    # and v blew up (x-axis at 2*pi: |v| ~ 4.6e15 for t = (1, 2, 3)), and 3.3.3 refused the
    # turns su2_log rescues there with NaN in all six slots.
    # [measured: tests/abuse.tcyr "3.4.1: se3_log is the principal log", baseline 3.4.0]
    # ⭐ 3.4.1 — log -q when w < 0: the same rigid motion, a turn of at most pi, where V is
    # well-conditioned. -q is q times the exact -1 (su2_compose by (-1, 0, 0, 0) negates
    # every component exactly). The 3.3.3 refusal is gone with the turns it refused.
    # ⚠ COST: su2_to_quat allocates an HQuat on every call (and w < 0 two SU(2) temporaries
    # more): se3_log +1.7% and +5.3% at a w > 0 element in two A/Bs, each inside its spread.
    # [measured: tests/hisab.bcyr se3_log, LIE lane A/B 2026-10-31]
    var q0 = su2_to_quat(rot);
    if (q0 == 0) { return 0; }
    if (f64_lt(HQuat_w(q0), 0) == 1) {
        var mq = hquat_new(0, 0, 0, f64_neg(F64_ONE));
        if (mq == 0) { return 0; }
        var m1 = su2_from_quat(mq);
        if (m1 == 0) { return 0; }
        rot = su2_compose(rot, m1);
        if (rot == 0) { return 0; }
    }

    # Get omega from rotation
    var omega = su2_log(rot);
    if (omega == 0) { return 0; }
    var ox = HVec3_x(omega); var oy = HVec3_y(omega); var oz = HVec3_z(omega);
    var theta = lie_norm3(ox, oy, oz);

    # ⛔ Same story as `se3_exp`: V^-1 divides by theta^2, so the guard could not be
    # lowered until the coefficient could be computed at small theta.
    # ⛔ 3.3.3 — and the same NaN-true `f64_gt(theta, 0) == 0`: a NaN omega from
    # `su2_log` returned v = t untouched beside it, a translation that looks valid.
    # [measured: scratch harness, not reproducible in-tree, 2026-10-01; cycc 6.6.12]
    if (f64_eq(theta, 0) == 1) {
        # Near identity: v ~ t
        return _twist_from(omega, trans);
    }

    # Compute V^{-1}: V^{-1} = I - 1/2 K + (1/theta^2)(1 - theta*cot(theta/2)/2) * K^2
    # Simplified: V^{-1} = I - 1/2 K + c * K^2
    # where c = (1 - theta/(2*tan(theta/2))) / theta^2
    var K = _skew3(omega);
    if (K == 0) { return 0; }
    var K2 = m3_mul(K, K);
    if (K2 == 0) { return 0; }
    var theta2 = f64_mul(theta, theta);
    var half_theta = f64_mul(theta, F64_HALF);
    # The sin/cos quotient hisab's `f64_tan` computed until 3.3.4 (f64_util.cyr says why).
    var tan_half = f64_div(f64_sin(half_theta), f64_cos(half_theta));

    # ⭐ THE OLD CODE ALREADY HAD A ONE-TERM SERIES — `c = 1/12` — but reached it
    # only when |tan(theta/2)| < 1e-12, i.e. theta < 2e-12, while the closed form
    # has already collapsed by 1e-7 (measured: it reads 0.0777 against a true
    # 1/12 = 0.0833, and 0 by 1e-8). The series takes over where it is actually
    # better, and carries enough terms to be exact there:
    #   (1 - (t/2)/tan(t/2))/t^2 = 1/12 + t^2/720 + t^4/30240 + t^6/1209600 + ...
    # [measured: series-vs-closed-form comparison, theta = 1e-4 .. 1, 2026-09-10]
    var c = 0;
    if (f64_lt(theta, _LIE_SERIES_CUT) == 1) {
        var s4 = f64_mul(theta2, theta2);
        c = f64_add(f64_div(F64_ONE, f64_from(12)), f64_div(theta2, f64_from(720)));
        c = f64_add(c, f64_div(s4, f64_from(30240)));
        c = f64_add(c, f64_div(f64_mul(s4, theta2), f64_from(1209600)));
    } else {
        c = f64_div(f64_sub(F64_ONE, f64_div(half_theta, tan_half)), theta2);
    }

    var vi = m3_identity();
    if (vi == 0) { return 0; }
    var vk = m3_scale(K, f64_neg(F64_HALF));
    if (vk == 0) { return 0; }
    var vk2 = m3_scale(K2, c);
    if (vk2 == 0) { return 0; }
    var v1 = m3_add(vi, vk);
    if (v1 == 0) { return 0; }
    var V_inv = m3_add(v1, vk2);
    if (V_inv == 0) { return 0; }
    var vel = m3_mul_vec3(V_inv, trans);
    if (vel == 0) { return 0; }

    return _twist_from(omega, vel);
}

# ================================================================
# Adjoint representations
# ================================================================
# (su2_adjoint lives in lie.cyr since 3.3.0, beside the SU(2) group it acts through.)

# Lorentz adjoint: Ad_L(X) = L * X * L^{-1}
# L is Lorentz group element (Mat4), X is 4x4 generator matrix (Mat4)
# Result is 4x4 matrix (Mat4)
public fn lorentz_adjoint(L, X) {
    var L_inv = lorentz_inv(L);
    if (L_inv == 0) { return 0; }
    var lx = m4_mul(L, X);
    if (lx == 0) { return 0; }
    return m4_mul(lx, L_inv);
}

# SE(3) adjoint: Ad_{(R,t)}(twist)
# For SE(3) element (R, t) and twist [omega, v]:
# Ad = [[R, 0], [[t]_x R, R]]
# Result: [R*omega, [t]_x * R * omega + R * v]
#
# se: SE(3) element. twist: a 48-byte se(3) twist -- build it with
# se3_twist_new, NEVER with hvec3_new. An HVec3 here is 24 bytes where 48 are
# read, and since a Cyrius pointer carries no length the guard below can only
# reject null; the size mistake is caught by construction, not by validation.
# Returns a fresh 48-byte twist, or 0 if either argument is null.
public fn se3_adjoint(se, twist) {
    if (se == 0 || twist == 0) { return 0; }
    var rot = _se3_rot(se);
    var trans = _se3_trans(se);
    var omega = _twist_omega(twist);
    if (omega == 0) { return 0; }
    var vel = _twist_v(twist);
    if (vel == 0) { return 0; }

    # R * omega (quaternion rotation)
    var R_omega = su2_adjoint(rot, omega);
    if (R_omega == 0) { return 0; }

    # R * v
    var R_v = su2_adjoint(rot, vel);
    if (R_v == 0) { return 0; }

    # [t]_x * (R * omega)
    var t_cross_Rw = hvec3_cross(trans, R_omega);
    if (t_cross_Rw == 0) { return 0; }

    # Result: [R*omega, [t]_x * R * omega + R * v]
    var new_v = hvec3_add(t_cross_Rw, R_v);
    if (new_v == 0) { return 0; }

    return _twist_from(R_omega, new_v);
}

# ================================================================
# Baker-Campbell-Hausdorff formula
# ================================================================
# BCH: exp(X) exp(Y) = exp(Z) where
# Z = X + Y + 1/2[X,Y] + 1/12([X,[X,Y]] - [Y,[X,Y]]) + ...
#
# Works on matrix Lie algebra elements.
# For SU(2): 2x2 complex matrices, uses cmat_commutator
# For SO(3): 3x3 real skew-symmetric matrices, uses _m3_commutator

# 2nd order BCH for complex matrices: Z = X + Y + 1/2 [X,Y]
public fn bch_2nd_order(X, Y) {
    var sum = cmat_add(X, Y);
    var comm = cmat_commutator(X, Y);
    var half_c = cx_new(F64_HALF, 0);
    return cmat_add(sum, cmat_scale(comm, half_c));
}

# 3rd order BCH for complex matrices:
# Z = X + Y + 1/2[X,Y] + 1/12([X,[X,Y]] - [Y,[X,Y]])
public fn bch_3rd_order(X, Y) {
    var z2 = bch_2nd_order(X, Y);
    var comm_xy = cmat_commutator(X, Y);
    var comm_x_xy = cmat_commutator(X, comm_xy);
    var comm_y_xy = cmat_commutator(Y, comm_xy);
    var diff = cmat_sub(comm_x_xy, comm_y_xy);
    var twelfth = cx_new(f64_div(F64_ONE, f64_from(12)), 0);
    return cmat_add(z2, cmat_scale(diff, twelfth));
}

# 2nd order BCH for 3x3 real skew-symmetric matrices (SO(3) algebra)
# Input/output are Mat3. Z = X + Y + 1/2[X,Y]
public fn bch_so3_2nd_order(X, Y) {
    var sum = m3_add(X, Y);
    if (sum == 0) { return 0; }
    var comm = _m3_commutator(X, Y);
    if (comm == 0) { return 0; }
    var hc = m3_scale(comm, F64_HALF);
    if (hc == 0) { return 0; }
    return m3_add(sum, hc);
}

# 3rd order BCH for 3x3 real skew-symmetric matrices
# Z = X + Y + 1/2[X,Y] + 1/12([X,[X,Y]] - [Y,[X,Y]])
public fn bch_so3_3rd_order(X, Y) {
    var z2 = bch_so3_2nd_order(X, Y);
    if (z2 == 0) { return 0; }
    var comm_xy = _m3_commutator(X, Y);
    if (comm_xy == 0) { return 0; }
    var comm_x_xy = _m3_commutator(X, comm_xy);
    if (comm_x_xy == 0) { return 0; }
    var comm_y_xy = _m3_commutator(Y, comm_xy);
    if (comm_y_xy == 0) { return 0; }
    var ncy = m3_scale(comm_y_xy, f64_neg(F64_ONE));
    if (ncy == 0) { return 0; }
    var diff = m3_add(comm_x_xy, ncy);
    if (diff == 0) { return 0; }
    var twelfth = f64_div(F64_ONE, f64_from(12));
    var dt = m3_scale(diff, twelfth);
    if (dt == 0) { return 0; }
    return m3_add(z2, dt);
}
