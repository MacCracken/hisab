# linalg_ext.cyr -- sparse linear algebra, iterative solvers, SVD wrappers,
#                   eigendecomposition, Lyapunov exponents, inertia tensors
# Usage: include "lib/linalg_ext.cyr"
# Requires: alloc.cyr, math.cyr, matrix.cyr, linalg.cyr, error.cyr, fnptr.cyr
#
# Ported from rust-old/src/num/{sparse,solvers,svd,eigen,stability,inertia}.rs
#
# CSR sparse matrix layout (48 bytes header + data arrays):
#   { nrows: i64, ncols: i64, nnz: i64, row_ptr: ptr, col_idx: ptr, values: ptr }
#   Offset 0:  nrows
#   Offset 8:  ncols
#   Offset 16: nnz
#   Offset 24: row_ptr  -- flat i64 array, length nrows+1
#   Offset 32: col_idx  -- flat i64 array, length nnz
#   Offset 40: values   -- flat f64 array, length nnz

# ================================================================
# Section 0 -- Guarded matrix constructor
# ================================================================

# Element cap for the overflow-guarded real-matrix constructor: 16M elements
# (128 MB at 8 B/elem). Keeps rows*cols well below 2^60, so `16 + rows*cols*8`
# cannot wrap i64.
var _MAT_MAX_ELEMS = 16777216;

# Overflow-guarded real-matrix constructor (CWE-190). Returns 0 (null) for
# non-positive or overflow-prone dimensions; otherwise delegates to the stdlib
# `mat_new`.
#
# As of the cyrius 6.5.6 pin (hisab 2.6.11) the stdlib is guarded too: ganita
# 1.0.4 added the same check to `ganita_mat_new` (GANITA_MAT_MAX_ELEMS =
# 33_554_430, the ALLOC_MAX-derived ceiling). Before that fix, stdlib `mat_new`
# computed `16 + rows*cols*8` unguarded and `mat_new(-5, 3)` SEGFAULTED —
# measured, not theoretical. This wrapper predates the upstream fix and is kept
# because it is deliberately STRICTER: 16M elements (128 MB at 8 B/elem) against
# upstream's 33.5M, so it still rejects allocations hisab considers unreasonable
# even though upstream would now accept them. Use it when sizing a matrix from
# untrusted / external input. hisab's own internal callers pass dimensions taken
# from already-allocated matrices, so they are not exposed.
fn mat_new_guarded(rows, cols) {
    if (rows <= 0 || cols <= 0) { return 0; }
    if (rows > _MAT_MAX_ELEMS / cols) { return 0; }
    return ganita_mat_new(rows, cols);
}

# ================================================================
# Section 1 -- CSR Sparse Matrix
# ================================================================

# Construct a CSR matrix from pre-built arrays.
# row_ptr: flat i64 array (nrows+1 entries)
# col_idx: flat i64 array (nnz entries)
# values:  flat f64 array (nnz entries)
# Returns pointer to CSR struct (48 bytes).
fn csr_new(nrows, ncols, nnz, row_ptr, col_idx, values) {
    var csr = alloc(48);
    store64(csr,      nrows);
    store64(csr + 8,  ncols);
    store64(csr + 16, nnz);
    store64(csr + 24, row_ptr);
    store64(csr + 32, col_idx);
    store64(csr + 40, values);
    return csr;
}

# Accessors
fn csr_nrows(csr)   { return load64(csr); }
fn csr_ncols(csr)   { return load64(csr + 8); }
fn csr_nnz(csr)     { return load64(csr + 16); }
fn csr_row_ptr(csr) { return load64(csr + 24); }
fn csr_col_idx(csr) { return load64(csr + 32); }
fn csr_values(csr)  { return load64(csr + 40); }

# Convert a stdlib dense matrix (from matrix.cyr) to CSR.
# Drops entries with |value| < EPSILON_F64.
# Returns pointer to CSR struct.
fn csr_from_dense(dense_mat) {
    var nrows = ganita_mat_rows(dense_mat);
    var ncols = ganita_mat_cols(dense_mat);

    # First pass: count non-zeros
    var count = 0;
    var i = 0;
    while (i < nrows) {
        var j = 0;
        while (j < ncols) {
            var v = ganita_mat_get(dense_mat, i, j);
            # ⛔ SPARSITY IS A STRUCTURAL QUESTION, NOT A TOLERANCE ONE. An entry
            # is stored or it is not, and `|A_ij| > 1e-12` made that depend on the
            # caller's units — a matrix in millimetres kept entries a matrix in
            # metres silently dropped. ⚠ AND THE TWO PASSES MUST AGREE EXACTLY:
            # this test counts the entries and the identical one below emits them,
            # so any disagreement mis-sizes the arrays.
            # [measured: docs/audit/2026-09-09-epsilon-open.json]
            if (f64_eq(v, f64_from(0)) == 0) {
                count = count + 1;
            }
            j = j + 1;
        }
        i = i + 1;
    }

    var row_ptr = alloc((nrows + 1) * 8);
    var col_idx = alloc(count * 8);
    var values  = alloc(count * 8);

    var pos = 0;
    store64(row_ptr, 0);
    i = 0;
    while (i < nrows) {
        var j = 0;
        while (j < ncols) {
            var v = ganita_mat_get(dense_mat, i, j);
            # ⚠ Byte-identical to the counting pass above, deliberately.
            if (f64_eq(v, f64_from(0)) == 0) {
                store64(col_idx + pos * 8, j);
                store64(values + pos * 8, v);
                pos = pos + 1;
            }
            j = j + 1;
        }
        store64(row_ptr + (i + 1) * 8, pos);
        i = i + 1;
    }

    return csr_new(nrows, ncols, count, row_ptr, col_idx, values);
}

# Sparse matrix-vector multiply: y = CSR * x.
# x: flat f64 array of length ncols.
# Returns: flat f64 array of length nrows.
fn csr_spmv(csr, x) {
    var nrows   = load64(csr);
    var row_ptr = load64(csr + 24);
    var col_idx = load64(csr + 32);
    var vals    = load64(csr + 40);

    var y = alloc(nrows * 8);
    var i = 0;
    while (i < nrows) {
        var sum = f64_from(0);
        var start = load64(row_ptr + i * 8);
        var end   = load64(row_ptr + (i + 1) * 8);
        var idx = start;
        while (idx < end) {
            var col = load64(col_idx + idx * 8);
            var val = load64(vals + idx * 8);
            sum = f64_add(sum, f64_mul(val, load64(x + col * 8)));
            idx = idx + 1;
        }
        store64(y + i * 8, sum);
        i = i + 1;
    }
    return y;
}

# Sparse matrix addition: C = A + B (both CSR, same dimensions).
# Uses sorted merge of each row. Drops zeros.
# Returns new CSR struct, or 0 on dimension mismatch.
fn csr_add(a, b) {
    var nrows_a = load64(a);
    var ncols_a = load64(a + 8);
    var nrows_b = load64(b);
    var ncols_b = load64(b + 8);
    if (nrows_a != nrows_b) { return 0; }
    if (ncols_a != ncols_b) { return 0; }

    var nrows = nrows_a;
    var ncols = ncols_a;
    var a_rp = load64(a + 24);
    var a_ci = load64(a + 32);
    var a_v  = load64(a + 40);
    var b_rp = load64(b + 24);
    var b_ci = load64(b + 32);
    var b_v  = load64(b + 40);

    # Upper bound on nnz: sum of both nnz counts
    var max_nnz = load64(a + 16) + load64(b + 16);
    var out_rp = alloc((nrows + 1) * 8);
    var out_ci = alloc(max_nnz * 8);
    var out_v  = alloc(max_nnz * 8);

    var pos = 0;
    store64(out_rp, 0);

    var i = 0;
    while (i < nrows) {
        var ai = load64(a_rp + i * 8);
        var ae = load64(a_rp + (i + 1) * 8);
        var bi = load64(b_rp + i * 8);
        var be = load64(b_rp + (i + 1) * 8);

        while (ai < ae && bi < be) {
            var ac = load64(a_ci + ai * 8);
            var bc = load64(b_ci + bi * 8);
            if (ac < bc) {
                store64(out_ci + pos * 8, ac);
                store64(out_v + pos * 8, load64(a_v + ai * 8));
                pos = pos + 1;
                ai = ai + 1;
            } else {
                if (ac > bc) {
                    store64(out_ci + pos * 8, bc);
                    store64(out_v + pos * 8, load64(b_v + bi * 8));
                    pos = pos + 1;
                    bi = bi + 1;
                } else {
                    # Same column -- add values
                    var s = f64_add(load64(a_v + ai * 8), load64(b_v + bi * 8));
                    # ⛔ Same class: a genuinely non-zero sum was dropped from the
                    # pattern because it was small in the caller's units. ⚠ Exact
                    # `!= 0` rather than `|s| > 0`, so a NaN sum is KEPT rather
                    # than silently deleted from the matrix.
                    if (f64_eq(s, f64_from(0)) == 0) {
                        store64(out_ci + pos * 8, ac);
                        store64(out_v + pos * 8, s);
                        pos = pos + 1;
                    }
                    ai = ai + 1;
                    bi = bi + 1;
                }
            }
        }
        # Drain remaining from A
        while (ai < ae) {
            store64(out_ci + pos * 8, load64(a_ci + ai * 8));
            store64(out_v + pos * 8, load64(a_v + ai * 8));
            pos = pos + 1;
            ai = ai + 1;
        }
        # Drain remaining from B
        while (bi < be) {
            store64(out_ci + pos * 8, load64(b_ci + bi * 8));
            store64(out_v + pos * 8, load64(b_v + bi * 8));
            pos = pos + 1;
            bi = bi + 1;
        }
        store64(out_rp + (i + 1) * 8, pos);
        i = i + 1;
    }

    return csr_new(nrows, ncols, pos, out_rp, out_ci, out_v);
}

# Transpose a CSR matrix. Returns new CSR struct.
fn csr_transpose(csr) {
    var nrows   = load64(csr);
    var ncols   = load64(csr + 8);
    var nnz     = load64(csr + 16);
    var row_ptr = load64(csr + 24);
    var col_idx = load64(csr + 32);
    var vals    = load64(csr + 40);

    # Count entries per column (= rows of transposed)
    var row_counts = alloc(ncols * 8);
    var k = 0;
    while (k < ncols) { store64(row_counts + k * 8, 0); k = k + 1; }

    k = 0;
    while (k < nnz) {
        var c = load64(col_idx + k * 8);
        store64(row_counts + c * 8, load64(row_counts + c * 8) + 1);
        k = k + 1;
    }

    # Build new row_ptr from counts
    var new_rp = alloc((ncols + 1) * 8);
    var cum = 0;
    store64(new_rp, 0);
    k = 0;
    while (k < ncols) {
        cum = cum + load64(row_counts + k * 8);
        store64(new_rp + (k + 1) * 8, cum);
        k = k + 1;
    }

    # Fill transposed data
    var new_ci = alloc(nnz * 8);
    var new_v  = alloc(nnz * 8);
    # cursor tracks current write position per row of transposed
    var cursor = alloc(ncols * 8);
    k = 0;
    while (k < ncols) {
        store64(cursor + k * 8, load64(new_rp + k * 8));
        k = k + 1;
    }

    var i = 0;
    while (i < nrows) {
        var start = load64(row_ptr + i * 8);
        var end   = load64(row_ptr + (i + 1) * 8);
        var idx = start;
        while (idx < end) {
            var col = load64(col_idx + idx * 8);
            var dest = load64(cursor + col * 8);
            store64(new_ci + dest * 8, i);
            store64(new_v + dest * 8, load64(vals + idx * 8));
            store64(cursor + col * 8, dest + 1);
            idx = idx + 1;
        }
        i = i + 1;
    }

    return csr_new(ncols, nrows, nnz, new_rp, new_ci, new_v);
}

# ================================================================
# Section 2 -- Iterative Solvers
# ================================================================

# Helper: compute dot product of two flat f64 arrays of length n
fn _lext_dot(a, b, n) {
    var sum = f64_from(0);
    var i = 0;
    while (i < n) {
        sum = f64_add(sum, f64_mul(load64(a + i * 8), load64(b + i * 8)));
        i = i + 1;
    }
    return sum;
}

# ⭐ n-LEG SCALED RESCUE — `_hvec3_len_scaled` generalised to a length-n array.
# ⚠ NaN NEVER REACHES HERE, and it is worth saying why rather than guarding for
# it: a NaN component makes the caller's sum NaN, which satisfies neither
# `< F64_TINY` nor `== +Inf`, so the fast path returns `f64_sqrt(NaN)` and this
# helper is not called. ⛔ An earlier draft of this comment claimed the `mx == 0`
# exit propagated NaN because it returns `mx`. Measured, it does NOT: this max is
# an explicit `f64_gt` loop, and `f64_gt(NaN, mx)` is 0, so a NaN never raises
# `mx` and an all-NaN vector would return 0 here. `_hvec3_len_scaled` uses
# `f64_max` and does propagate — the two are not interchangeable, and returning
# `mx` versus a literal zero is an EQUIVALENCE in this shape, mutation-confirmed.
# ⚠ The `+Inf` exit is REQUIRED: without it `Inf/Inf` is NaN and an infinite
# component would turn a well-defined +Inf norm into a NaN.
# [measured: NaN probe on both scaled helpers, 2026-09-10]
fn _lext_norm_scaled(v, n) {
    var mx = f64_from(0);
    var i = 0;
    while (i < n) {
        var a = f64_abs(load64(v + i * 8));
        if (f64_gt(a, mx) == 1) { mx = a; }
        i = i + 1;
    }
    if (f64_gt(mx, 0) == 0) { return mx; }
    if (f64_eq(mx, F64_POS_INF) == 1) { return mx; }
    var s = f64_from(0);
    i = 0;
    while (i < n) {
        var q = f64_div(load64(v + i * 8), mx);
        s = f64_add(s, f64_mul(q, q));
        i = i + 1;
    }
    return f64_mul(mx, f64_sqrt(s));
}

# Helper: Euclidean norm of flat f64 array of length n
# ⛔ 2.17.0 — THIS SQUARED BEFORE SUMMING, and it is the residual norm the Krylov
# solvers converge on. A component below 2^-537 squares to zero, so `r_norm` is
# exactly 0, `f64_lt(r_norm, tol)` fires, and `solve_gmres` returns `x0` as the
# answer — or, one line later, normalises by `1/0`. Measured on A = 2I with the
# caller scaling `tol` with the problem as a careful caller would: **461 of 1001
# scales wrong, first at 2^-539.**
# ⭐ Fast path plus the scaled rescue: two scalar compares per call on a pass that
# is already O(n) and sits beside the caller's own matvec.
# [measured: 1001-scale sweep on solve_gmres, 2026-09-10]
fn _lext_norm(v, n) {
    var ss = _lext_dot(v, v, n);
    if (f64_lt(ss, F64_TINY) == 1) { return _lext_norm_scaled(v, n); }
    if (f64_eq(ss, F64_POS_INF) == 1) { return _lext_norm_scaled(v, n); }
    return f64_sqrt(ss);
}

# Helper: y = a - b, flat f64 arrays of length n. Returns new array.
fn _lext_sub(a, b, n) {
    var out = alloc(n * 8);
    var i = 0;
    while (i < n) {
        store64(out + i * 8, f64_sub(load64(a + i * 8), load64(b + i * 8)));
        i = i + 1;
    }
    return out;
}

# Helper: copy flat f64 array of length n. Returns new array.
fn _lext_copy(src, n) {
    var out = alloc(n * 8);
    var i = 0;
    while (i < n) {
        store64(out + i * 8, load64(src + i * 8));
        i = i + 1;
    }
    return out;
}

# GMRES(m) iterative solver for non-symmetric systems Ax = b.
# A_fn: function pointer, called as fncall1(A_fn, x_ptr) -> Ax (flat f64 array).
# b:    flat f64 array of length n.
# x0:   initial guess, flat f64 array of length n.
# n:    system dimension.
# tol:  convergence tolerance on residual norm.
# max_iter: maximum total matrix-vector products. COUNTED, not estimated.
# restart:  restart dimension (Krylov subspace size per cycle).
# Returns: flat f64 array of length n (solution).
fn solve_gmres(A_fn, b, x0, n, tol, max_iter, restart) {
    # ⛔ `n` SIZES THE VERY FIRST ALLOCATION AND WAS UNCHECKED. `_lext_copy(x0, n)`
    # does `alloc(n * 8)` and stores through it; past ALLOC_MAX that is the
    # designed 0 and the copy loop writes to address 0. Measured: n = 268,435,457
    # with restart = 2 exits **139** — i.e. it never reached the Hessenberg guard
    # below.
    # [measured: scratch harness, not reproducible in-tree, 2026-09-09; cycc 6.6.2]
    # ⭐ FOUND BY A MUTANT THAT DID NOT DIE. The Hessenberg guard was written
    # against an overflow of `(m + 1) * m * 8`; replacing it with the overflowing
    # multiply form left the suite green, which said the overflow was unreachable.
    # It is — because THIS allocation fails first on any `n` large enough to
    # overflow it. The surviving mutant was pointing at a second defect, not at a
    # redundant guard.
    if (n > ALLOC_MAX / 8) { return 0; }
    var x = _lext_copy(x0, n);
    var m = restart;
    if (m > n) { m = n; }
    if (m < 1) { m = 1; }

    # ⛔ THE HESSENBERG IS QUADRATIC IN `m` AND WAS STORED THROUGH UNCHECKED.
    # `h = alloc((m + 1) * m * 8)`; above `ALLOC_MAX` the stdlib returns its
    # designed **0** and the zeroing loop immediately writes to address 0.
    # Measured: n = 16385 with restart = 16385 asks for 2,147,893,... B against a
    # 2 GiB cap and exits **139**. ⭐ Two controls isolate the quadratic term
    # rather than the inputs: the SAME n with restart = 2 exits 0, and the same
    # restart == n shape at n = 64 exits 0.
    # [measured: scratch harness, not reproducible in-tree, 2026-09-09; cycc 6.6.2]
    #
    # ⚠ Written as a DIVISION rather than `(m + 1) * m * 8 > ALLOC_MAX`. Both are
    # correct HERE — the `n` guard above means `m` can never reach the ~1.07e9
    # needed to overflow the product, and a mutation swapping the two forms was
    # green, which is how that was established rather than assumed. The division
    # form is kept because it stays correct if that `n` guard is ever loosened.
    # Exact at the boundary, asserted both ways in the suite: m = 16383 passes
    # (2,147,352,576 B, fits) and m = 16384 is rejected (2,147,614,720 B).
    # [measured: scratch harness, not reproducible in-tree, 2026-09-09; cycc 6.6.2]
    #
    # ⚠ Returns a designed 0. This function hands back the solution ARRAY and has
    # no rc, and `tests/abuse.tcyr` already reads its failure channel as
    # `assert_neq(..., 0)`. ⛔ Returning `x` — the untouched initial guess — was
    # the tempting alternative and is exactly the fabricated-plausible-answer
    # class the 2026-08-11 audit filed against this very function.
    if (m + 1 > (ALLOC_MAX / 8) / m) { return 0; }

    # COUNT the matrix-vector products rather than deriving an outer-cycle bound
    # from them. Through 2.7.0 this computed
    #     outer_limit = trunc(max_iter / m) + 1
    # and then spent 1 + m products per cycle, so the true cost was
    #     (trunc(max_iter/m) + 1) * (m + 1)
    # which is neither max_iter nor a bounded multiple of it. Measured: budget 1
    # with restart 100 spent 4 products on a 3x3 system, and the ratio grows
    # without limit as restart rises relative to max_iter -- no fixed safety
    # factor fixes it.
    #
    # The caller's budget is a resource limit: A_fn may be arbitrarily expensive,
    # which is the whole reason it is a callback. Honouring it exactly is the
    # contract, not a nicety.
    var mv_used = 0;

    var outer = 0;
    while (mv_used < max_iter) {
        # r = b - A*x
        var ax = fncall1(A_fn, x);
        mv_used = mv_used + 1;
        var r = _lext_sub(b, ax, n);
        var r_norm = _lext_norm(r, n);

        if (f64_lt(r_norm, tol) == 1) { return x; }

        # Normalize r -> v[0]
        var inv_r = f64_div(f64_from(1), r_norm);
        var i = 0;
        while (i < n) {
            store64(r + i * 8, f64_mul(load64(r + i * 8), inv_r));
            i = i + 1;
        }

        # v_basis: array of pointers to basis vectors (up to m+1)
        var v_basis = alloc((m + 1) * 8);
        store64(v_basis, r);

        # Hessenberg matrix H: (m+1) x m stored row-major
        var h = alloc((m + 1) * m * 8);
        i = 0;
        while (i < (m + 1) * m) { store64(h + i * 8, f64_from(0)); i = i + 1; }

        # g vector: length m+1
        var g = alloc((m + 1) * 8);
        i = 0;
        while (i < m + 1) { store64(g + i * 8, f64_from(0)); i = i + 1; }
        store64(g, r_norm);

        # Givens rotation coefficients
        var cs = alloc(m * 8);
        var sn = alloc(m * 8);

        var k = 0;  # number of completed Arnoldi steps
        var j = 0;
        while (j < m) {
            # Stop mid-cycle the moment the budget is spent. The Krylov space
            # built so far is still valid, so the least-squares solve below uses
            # k steps and returns the best answer available within budget.
            if (mv_used >= max_iter) { break; }
            var vj = load64(v_basis + j * 8);
            var wj = fncall1(A_fn, vj);
            mv_used = mv_used + 1;

            # Modified Gram-Schmidt
            i = 0;
            while (i <= j) {
                var vi = load64(v_basis + i * 8);
                var hij = _lext_dot(wj, vi, n);
                store64(h + (i * m + j) * 8, hij);  # H[i][j]
                var l = 0;
                while (l < n) {
                    store64(wj + l * 8, f64_sub(load64(wj + l * 8),
                        f64_mul(hij, load64(vi + l * 8))));
                    l = l + 1;
                }
                i = i + 1;
            }

            var wj_norm = _lext_norm(wj, n);
            store64(h + ((j + 1) * m + j) * 8, wj_norm);  # H[j+1][j]

            # ⛔ `wj_norm` is a LENGTH in the caller's units against an absolute
            # 1e-12, so Arnoldi declared a perfectly good basis vector degenerate
            # and broke down early on any small system. The reciprocal on the next
            # line is unbounded, so DBL_MIN is the bound, not an exact zero.
            if (f64_lt(wj_norm, F64_TINY) == 0) {
                var inv_w = f64_div(f64_from(1), wj_norm);
                var l = 0;
                while (l < n) {
                    store64(wj + l * 8, f64_mul(load64(wj + l * 8), inv_w));
                    l = l + 1;
                }
            }
            store64(v_basis + (j + 1) * 8, wj);

            # Apply previous Givens rotations to column j of H
            i = 0;
            while (i < j) {
                var ci = load64(cs + i * 8);
                var si = load64(sn + i * 8);
                var h_ij   = load64(h + (i * m + j) * 8);
                var h_i1j  = load64(h + ((i + 1) * m + j) * 8);
                var temp = f64_add(f64_mul(ci, h_ij), f64_mul(si, h_i1j));
                store64(h + ((i + 1) * m + j) * 8,
                  f64_add(f64_mul(f64_neg(si), h_ij), f64_mul(ci, h_i1j)));
                store64(h + (i * m + j) * 8, temp);
                i = i + 1;
            }

            # Compute new Givens rotation for row j
            var hjj  = load64(h + (j * m + j) * 8);
            var hj1j = load64(h + ((j + 1) * m + j) * 8);
            # ⛔ 2.17.0 — THE GIVENS RADIUS SQUARED BEFORE SUMMING TOO, and
            # repairing `_lext_norm` alone does not move the entry point: both
            # legs are degree ONE in the caller's ||A|| (h[i][j] is a dot against
            # a UNIT basis vector, h[j+1][j] is `wj_norm`), so both reach the
            # flush band together. ⚠ In the silent middle the stored rotation is
            # not even orthogonal — `cs² + sn² != 1` — so the least-squares solve
            # downstream is wrong in a way no residual check would catch.
            # ⭐ Same fast-path shape as `hvec2_length`, whose scaled helper IS
            # `ganita_f64_hypot`.
            var r_ls = f64_add(f64_mul(hjj, hjj), f64_mul(hj1j, hj1j));
            var r_val = f64_sqrt(r_ls);
            if (f64_lt(r_ls, F64_TINY) == 1) { r_val = ganita_f64_hypot(hjj, hj1j); }
            if (f64_eq(r_ls, F64_POS_INF) == 1) { r_val = ganita_f64_hypot(hjj, hj1j); }
            # ⭐ |hjj| <= r_val and |hj1j| <= r_val, so these quotients are in
            # [-1,1] and cannot overflow at any non-zero radius — the exact-zero
            # test is what the division requires, as in linalg_precision's Givens.
            if (f64_gt(r_val, 0) == 1) {
                store64(cs + j * 8, f64_div(hjj, r_val));
                store64(sn + j * 8, f64_div(hj1j, r_val));
            } else {
                store64(cs + j * 8, f64_from(1));
                store64(sn + j * 8, f64_from(0));
            }
            store64(h + (j * m + j) * 8, r_val);
            store64(h + ((j + 1) * m + j) * 8, f64_from(0));

            # Apply new rotation to g
            var cj = load64(cs + j * 8);
            var sj = load64(sn + j * 8);
            var gj = load64(g + j * 8);
            store64(g + (j + 1) * 8, f64_mul(f64_neg(sj), gj));
            store64(g + j * 8, f64_mul(cj, gj));

            k = j + 1;

            if (f64_lt(f64_abs(load64(g + k * 8)), tol) == 1) {
                j = m;  # break
            } else {
                j = j + 1;
            }
        }

        # Back-substitution: solve upper triangular H * y = g
        var y = alloc(k * 8);
        i = k - 1;
        while (i >= 0) {
            var yi = load64(g + i * 8);
            var jj = i + 1;
            while (jj < k) {
                yi = f64_sub(yi, f64_mul(load64(h + (i * m + jj) * 8), load64(y + jj * 8)));
                jj = jj + 1;
            }
            var hii = load64(h + (i * m + i) * 8);
            # ⛔ TWO DEFECTS. The absolute 1e-12 skipped the divide for a small but
            # perfectly good pivot — and when it skipped, it stored the UNDIVIDED
            # numerator as if it were the solution component. At hii = 0 the true
            # y_i is unbounded, so the numerator is not an approximation of it; 0
            # at least says "no contribution" rather than asserting a wrong one.
            if (f64_lt(f64_abs(hii), F64_TINY) == 0) {
                yi = f64_div(yi, hii);
            } else {
                yi = f64_from(0);
            }
            store64(y + i * 8, yi);
            i = i - 1;
        }

        # Update x: x += V * y
        i = 0;
        while (i < n) {
            var xi = load64(x + i * 8);
            var jj = 0;
            while (jj < k) {
                var vj_ptr = load64(v_basis + jj * 8);
                xi = f64_add(xi, f64_mul(load64(y + jj * 8), load64(vj_ptr + i * 8)));
                jj = jj + 1;
            }
            store64(x + i * 8, xi);
            i = i + 1;
        }

        if (f64_lt(f64_abs(load64(g + k * 8)), tol) == 1) {
            return x;
        }

        outer = outer + 1;
    }

    return x;
}

# BiCGSTAB iterative solver for non-symmetric systems Ax = b.
# A_fn: function pointer, called as fncall1(A_fn, x_ptr) -> Ax.
# b:    flat f64 array of length n.
# x0:   initial guess, flat f64 array of length n.
# n:    system dimension.
# tol:  convergence tolerance on residual norm.
# max_iter: maximum iterations.
# Returns: flat f64 array of length n (solution).
fn solve_bicgstab(A_fn, b, x0, n, tol, max_iter) {
    # ⛔ IDENTICAL DEFECT TO `solve_gmres`, and found only because that one was
    # repaired and the same shape was then grepped for rather than assumed
    # absent. `_lext_copy(x0, n)` is an unchecked `alloc(n * 8)`; past ALLOC_MAX
    # that is the designed 0 and the copy loop writes to address 0. Measured:
    # n = ALLOC_MAX / 8 + 1 exits **139**. Same guard, same designed-0 channel
    # (`tests/abuse.tcyr` already reads this function's failures as
    # `assert_neq(..., 0)`).
    # [measured: scratch harness, not reproducible in-tree, 2026-09-09; cycc 6.6.2]
    if (n > ALLOC_MAX / 8) { return 0; }
    var x = _lext_copy(x0, n);
    var ax = fncall1(A_fn, x);
    var r = _lext_sub(b, ax, n);
    var r_hat = _lext_copy(r, n);  # Shadow residual (fixed)

    var rho   = f64_from(1);
    var alpha = f64_from(1);
    var omega = f64_from(1);

    var v = alloc(n * 8);
    var p = alloc(n * 8);
    # `s` is hoisted here with `v` and `p`. It used to be allocated INSIDE the
    # iteration loop, and alloc() is a bump allocator that NEVER frees, so every
    # pass abandoned another n*8 bytes: arena use was 8*n*(6 + 3*max_iter) rather
    # than 8*n*(7 + 2*max_iter) -- measured at n=1024, max_iter=128 as
    # 3,194,880 B before vs 2,154,496 B after (-32.6%). Same hot-loop-allocation
    # class 2.6.15 cleared out of LM and L-BFGS.
    #
    # Deliberately NOT zero-filled below: all n slots are overwritten at the top
    # of every iteration before any read, so reuse is bit-identical.
    var s = alloc(n * 8);
    var i = 0;
    while (i < n) {
        store64(v + i * 8, f64_from(0));
        store64(p + i * 8, f64_from(0));
        i = i + 1;
    }

    # NOT f64_from(...) — f64_from CONVERTS an integer to a double, it does not
    # reinterpret bits. Through 2.6.11 this read `f64_from(0x3C32725DD1D243AC)`,
    # which yielded 4.34e18 rather than 1e-18, so the very first breakdown check
    # (`|rho| < tol`) was always true and solve_bicgstab returned the initial
    # guess without ever iterating. The literal already IS the f64 bit pattern.
    # (The old comment also mis-stated the value as ~1e-30.)
    var breakdown_tol = 0x3C32725DD1D243AC;  # 1e-18

    var iter = 0;
    while (iter < max_iter) {
        var rho_new = _lext_dot(r_hat, r, n);

        if (f64_lt(f64_abs(rho_new), breakdown_tol) == 1) {
            return x;  # Breakdown
        }

        var beta = f64_mul(f64_div(rho_new, rho), f64_div(alpha, omega));
        rho = rho_new;

        # p = r + beta * (p - omega * v)
        i = 0;
        while (i < n) {
            var pi = load64(p + i * 8);
            var vi = load64(v + i * 8);
            var ri = load64(r + i * 8);
            store64(p + i * 8, f64_add(ri, f64_mul(beta, f64_sub(pi, f64_mul(omega, vi)))));
            i = i + 1;
        }

        v = fncall1(A_fn, p);

        var r_hat_v = _lext_dot(r_hat, v, n);
        if (f64_lt(f64_abs(r_hat_v), breakdown_tol) == 1) {
            return x;  # Breakdown
        }
        alpha = f64_div(rho, r_hat_v);

        # s = r - alpha * v  (buffer hoisted above the loop)
        i = 0;
        while (i < n) {
            store64(s + i * 8, f64_sub(load64(r + i * 8), f64_mul(alpha, load64(v + i * 8))));
            i = i + 1;
        }

        var s_norm = _lext_norm(s, n);
        if (f64_lt(s_norm, tol) == 1) {
            i = 0;
            while (i < n) {
                store64(x + i * 8, f64_add(load64(x + i * 8), f64_mul(alpha, load64(p + i * 8))));
                i = i + 1;
            }
            return x;
        }

        var t = fncall1(A_fn, s);

        var t_dot_s = _lext_dot(t, s, n);
        var t_dot_t = _lext_dot(t, t, n);
        if (f64_lt(f64_abs(t_dot_t), breakdown_tol) == 1) {
            return x;  # Breakdown
        }
        omega = f64_div(t_dot_s, t_dot_t);

        # x += alpha * p + omega * s
        i = 0;
        while (i < n) {
            store64(x + i * 8, f64_add(load64(x + i * 8),
                f64_add(f64_mul(alpha, load64(p + i * 8)),
                  f64_mul(omega, load64(s + i * 8)))));
            i = i + 1;
        }

        # r = s - omega * t
        i = 0;
        while (i < n) {
            store64(r + i * 8, f64_sub(load64(s + i * 8), f64_mul(omega, load64(t + i * 8))));
            i = i + 1;
        }

        var r_norm = _lext_norm(r, n);
        if (f64_lt(r_norm, tol) == 1) {
            return x;
        }

        iter = iter + 1;
    }

    return x;
}

# Projected Gauss-Seidel (PGS) for contact/constraint solvers.
# Solves A*x = b subject to lo[i] <= x[i] <= hi[i].
# A:   stdlib matrix (n x n, via ganita_mat_get/ganita_mat_set).
# b:   flat f64 array of length n.
# x:   flat f64 array of length n (initial guess, modified in place).
# n:   system dimension.
# lo:  flat f64 array of lower bounds (length n).
# hi:  flat f64 array of upper bounds (length n).
# max_iter: maximum iterations.
# Returns: 0 on success (solution written into x).
fn solve_pgs(A, b, x, n, lo, hi, max_iter) {
    var iter = 0;
    while (iter < max_iter) {
        var max_change = f64_from(0);
        var i = 0;
        while (i < n) {
            var aii = ganita_mat_get(A, i, i);
            # ⛔ A diagonal entry in the caller's units against an absolute 1e-12,
            # so rows of a small system were silently skipped and left at their
            # initial value. `sigma/aii` gives the best available answer for any
            # non-zero aii, subnormal included; only an exact zero has no answer.
            if (f64_gt(f64_abs(aii), 0) == 0) {
                i = i + 1;
                # skip near-zero diagonal
            } else {
                var sigma = load64(b + i * 8);
                var j = 0;
                while (j < n) {
                    if (j != i) {
                        sigma = f64_sub(sigma, f64_mul(ganita_mat_get(A, i, j), load64(x + j * 8)));
                    }
                    j = j + 1;
                }
                var gs_x = f64_div(sigma, aii);
                var new_x = f64_clamp(gs_x, load64(lo + i * 8), load64(hi + i * 8));
                var change = f64_abs(f64_sub(new_x, load64(x + i * 8)));
                if (f64_gt(change, max_change) == 1) { max_change = change; }
                store64(x + i * 8, new_x);
                i = i + 1;
            }
        }
        # ⛔ `max_change` is a change in the SOLUTION, in the caller's units — an
        # impulse in a contact solver — so an absolute 1e-12 declared convergence
        # after one sweep on a small problem and refused to converge on a large
        # one. ⚠ Nothing DIVIDES here, so DBL_MIN would be meaningless: the
        # question is whether the iterate has stopped moving RELATIVE to its own
        # size. The DBL_MIN floor keeps an exactly-zero solution terminating.
        var x_mag = f64_from(0);
        var xm = 0;
        while (xm < n) {
            var xv = f64_abs(load64(x + xm * 8));
            if (f64_gt(xv, x_mag) == 1) { x_mag = xv; }
            xm = xm + 1;
        }
        var pgs_tol = f64_mul(EPSILON_F64, x_mag);
        if (f64_lt(pgs_tol, F64_TINY) == 1) { pgs_tol = F64_TINY; }
        if (f64_lt(max_change, pgs_tol) == 1) {
            return 0;
        }
        iter = iter + 1;
    }
    return 0;
}

# ================================================================
# Section 3 -- SVD (thin wrappers around ganita's ganita_mat_svd)
# ================================================================

# Full SVD: A = U * diag(S) * Vt.
# A:      stdlib matrix (m x n).
# out_U:  stdlib matrix (m x n, caller allocates via ganita_mat_new).
# out_S:  flat f64 array of length n (caller allocates via alloc(n*8)).
# out_Vt: stdlib matrix (n x n, caller allocates via ganita_mat_new).
# Returns: 0 on success.
fn svd_compute(A, out_U, out_S, out_Vt) {
    return ganita_mat_svd(A, out_U, out_S, out_Vt);
}

# Truncated (rank-k) SVD: keep only the top k singular values.
# A:      stdlib matrix (m x n).
# k:      number of singular values to keep (1 <= k <= n).
# out_U:  stdlib matrix (m x k, caller allocates).
# out_S:  flat f64 array of length k (caller allocates).
# out_Vt: stdlib matrix (k x n, caller allocates).
# Returns: 0 on success, HSB_ERR_INVALID_INPUT if k is invalid.
#must_use
fn svd_truncated(A, k, out_U, out_S, out_Vt) {
    var rows = ganita_mat_rows(A);
    var cols = ganita_mat_cols(A);
    if (k < 1) { return Err(HSB_ERR_INVALID_INPUT); }
    if (k > cols) { return Err(HSB_ERR_INVALID_INPUT); }

    # Compute full SVD into temporaries
    var full_u  = ganita_mat_new(rows, cols);
    var full_s  = alloc(cols * 8);
    var full_vt = ganita_mat_new(cols, cols);
    ganita_mat_svd(A, full_u, full_s, full_vt);

    # Copy top k singular values
    var i = 0;
    while (i < k) {
        store64(out_S + i * 8, load64(full_s + i * 8));
        i = i + 1;
    }

    # Copy first k columns of U into out_U (m x k)
    i = 0;
    while (i < rows) {
        var j = 0;
        while (j < k) {
            ganita_mat_set(out_U, i, j, ganita_mat_get(full_u, i, j));
            j = j + 1;
        }
        i = i + 1;
    }

    # Copy first k rows of Vt into out_Vt (k x n)
    i = 0;
    while (i < k) {
        var j = 0;
        while (j < cols) {
            ganita_mat_set(out_Vt, i, j, ganita_mat_get(full_vt, i, j));
            j = j + 1;
        }
        i = i + 1;
    }

    return Ok(0);
}

# ================================================================
# Section 4 -- Eigendecomposition
# ================================================================

# Power iteration for the dominant eigenvalue.
# A:        stdlib matrix (n x n -- SHAPE ENFORCED, see below).
# n:        matrix dimension.
# max_iter: maximum iterations.
# out_val:  pointer to store eigenvalue (f64, allocate 8 bytes).
# out_vec:  flat f64 array of length n (caller allocates, receives eigenvector).
# Returns:  0 on success, HSB_ERR_NO_CONVERGENCE if max_iter exceeded,
#           HSB_ERR_INVALID_INPUT on a null handle or a shape that does not
#           match n, HSB_ERR_ALLOC if the working vectors cannot be allocated.
#must_use
fn eigen_power(A, n, max_iter, out_val, out_vec) {
    # NULL HANDLES. A may be the designed 0 that mat_new_guarded returns above
    # its element cap, and ganita_mat_rows(0) is a null dereference.
    if (A == 0 || out_val == 0) { return Err(HSB_ERR_INVALID_INPUT); }
    if (out_vec == 0) { return Err(HSB_ERR_INVALID_INPUT); }

    # n WAS NOT BOUNDED AT ALL. `alloc(n * 8)` was called with whatever arrived
    # and stored through unconditionally, so both ends crashed (measured, exit
    # 139): n = -3 asks alloc for a negative size, and n = 1e9 asks for 8 GB --
    # over ALLOC_MAX = 2 GiB -- so alloc returns its designed 0 and `store64(v, ...)`
    # writes to address 0.
    if (n <= 0) { return Err(HSB_ERR_INVALID_INPUT); }

    # THE n x n PRECONDITION IS NOW CHECKED, NOT JUST DOCUMENTED. `n` is a
    # restatement of A's own extent: the matvec below reads ganita_mat_get(A, i, j) for
    # i, j < n, so n > A's extent is an out-of-bounds read and n < it silently
    # iterates on A's leading n x n block and returns 0 with the dominant
    # eigenvalue of a matrix the caller did not pass. Neither is a shape this
    # routine can legitimately answer for, so both are rejected.
    if (ganita_mat_rows(A) != n || ganita_mat_cols(A) != n) { return Err(HSB_ERR_INVALID_INPUT); }

    # Initial guess: unit vector e_0
    var v = alloc(n * 8);
    if (v == 0) { return Err(HSB_ERR_ALLOC); }
    var i = 0;
    while (i < n) { store64(v + i * 8, f64_from(0)); i = i + 1; }
    store64(v, f64_from(1));

    var w = alloc(n * 8);
    if (w == 0) { return Err(HSB_ERR_ALLOC); }
    var eigenvalue = f64_from(0);
    var tol = EPSILON_F64;

    var iter = 0;
    while (iter < max_iter) {
        # w = A * v
        i = 0;
        while (i < n) {
            var sum = f64_from(0);
            var j = 0;
            while (j < n) {
                sum = f64_add(sum, f64_mul(ganita_mat_get(A, i, j), load64(v + j * 8)));
                j = j + 1;
            }
            store64(w + i * 8, sum);
            i = i + 1;
        }

        # Find component with largest absolute value
        var max_val = f64_from(0);
        i = 0;
        while (i < n) {
            var wi = load64(w + i * 8);
            if (f64_gt(f64_abs(wi), f64_abs(max_val)) == 1) {
                max_val = wi;
            }
            i = i + 1;
        }

        # ⛔ `max_val` is the largest component of A*v, in the caller's units, so
        # an absolute 1e-12 made power iteration give up on any small-normed
        # matrix — reporting NO_CONVERGENCE for a problem with a perfectly good
        # dominant eigenvalue.
        # ⭐ THE GUARD AND THE NORMALISATION ARE ONE REPAIR. Lowering the threshold
        # alone is not enough while the loop multiplies by a RECIPROCAL: 1/max_val
        # overflows for a subnormal max_val even though w_i/max_val would not.
        # Dividing directly makes the exact-zero test the correct one, because
        # every |w_i| <= |max_val| by construction.
        # [measured: docs/audit/2026-09-09-epsilon-open.json]
        if (f64_gt(f64_abs(max_val), 0) == 0) {
            return Err(HSB_ERR_NO_CONVERGENCE);
        }

        var new_eigenvalue = max_val;

        # Normalize w -> v
        i = 0;
        while (i < n) {
            store64(v + i * 8, f64_div(load64(w + i * 8), max_val));
            i = i + 1;
        }

        # ⛔ The convergence test compared an ABSOLUTE change in the eigenvalue
        # against `tol`, and an eigenvalue carries the matrix's units — so the same
        # problem converged in one iteration or never, depending on the caller's
        # scale. `tol` is kept, now as a RELATIVE factor, which is what a caller
        # passing 1e-12 always meant.
        if (f64_lt(f64_abs(f64_sub(new_eigenvalue, eigenvalue)),
            f64_mul(tol, f64_abs(new_eigenvalue))) == 1) {
            store64(out_val, new_eigenvalue);
            i = 0;
            while (i < n) {
                store64(out_vec + i * 8, load64(v + i * 8));
                i = i + 1;
            }
            return Ok(0);
        }

        eigenvalue = new_eigenvalue;
        iter = iter + 1;
    }

    return Err(HSB_ERR_NO_CONVERGENCE);
}

# Symmetric eigendecomposition via Jacobi rotation.
# Wrapper around ganita_mat_eigen_sym with hisab API convention.
# A:        stdlib matrix (n x n, must be symmetric).
# n:        matrix dimension.
# out_vals: flat f64 array of length n (caller allocates, receives eigenvalues,
#           SORTED BY DESCENDING |lambda| -- see the ordering note below).
# out_vecs: stdlib matrix (n x n, caller allocates, receives eigenvectors as
#           columns, permuted to stay paired with out_vals).
# Returns:  HSB_ERR_NONE on success, HSB_ERR_NO_CONVERGENCE if the Jacobi sweep
#           does not reduce the off-diagonal below ganita's LINALG_EPS within its
#           own 100 * n^2 iteration budget.
#
# THIS ROUTINE HAS NO max_iter PARAMETER. The doc line this replaces named one --
# "HSB_ERR_NO_CONVERGENCE if max_iter exceeded" -- directly above a four-parameter
# signature that has never had it; the budget belongs to ganita_mat_eigen_sym
# (lib/ganita.cyr:890, `var max_iter = 100 * n * n;`) and is not caller-settable
# here. Audit 2026-08-04, api-consistency (low).
#
# ORDERING, and why it changed. The same audit row recorded that this routine and
# eigen_qr carry the same documented contract but returned eigenvalues in
# DIFFERENT orders, neither documented. Measured on the 2.8.4 tree, symmetric
# A = [[2,0,0],[0,3,1],[0,1,3]]:
#     eigen_symmetric -> 2, 4, 2      (Jacobi's final diagonal order: arbitrary)
#     eigen_qr        -> 4, 2, 2      (descending |lambda|, sorted at :1334)
# and on diag(1,5,3): eigen_symmetric -> 1, 5, 3 (input order), eigen_qr -> 5, 3, 1.
# eigen_qr already sorted and already had a suite pinning that order
# (tests/abuse.tcyr:730-734, tests/hisab.tcyr:2309-2312), so the siblings were made
# to agree by giving eigen_symmetric the SAME descending-|lambda| sort, permuting
# out_vecs' columns with it so a (lambda, v) pair is never broken. eigen_qr is
# unchanged. This is a behaviour change for any caller that read eigen_symmetric's
# raw Jacobi order -- see CHANGELOG "Breaking".
#must_use
fn eigen_symmetric(A, n, out_vals, out_vecs) {
    var result = ganita_mat_eigen_sym(A, out_vals, out_vecs);
    if (result < 0) { return Err(HSB_ERR_NO_CONVERGENCE); }

    # Selection sort by descending |eigenvalue|, columns of out_vecs carried
    # along. Identical to eigen_qr's step 3 (src/linalg_precision.cyr:1334) so the
    # two routines cannot disagree on order again. O(n^2) on an O(n^3)
    # decomposition, so it is free at every n the Jacobi path is used for.
    var i = 0;
    while (i < n) {
        var max_idx = i;
        var max_abs = f64_abs(load64(out_vals + i * 8));
        var j = i + 1;
        while (j < n) {
            var aj = f64_abs(load64(out_vals + j * 8));
            if (f64_gt(aj, max_abs) == 1) {
                max_abs = aj;
                max_idx = j;
            }
            j = j + 1;
        }
        if (max_idx != i) {
            var tmp = load64(out_vals + i * 8);
            store64(out_vals + i * 8, load64(out_vals + max_idx * 8));
            store64(out_vals + max_idx * 8, tmp);
            var k = 0;
            while (k < n) {
                var tv = ganita_mat_get(out_vecs, k, i);
                ganita_mat_set(out_vecs, k, i, ganita_mat_get(out_vecs, k, max_idx));
                ganita_mat_set(out_vecs, k, max_idx, tv);
                k = k + 1;
            }
        }
        i = i + 1;
    }

    return Ok(0);
}

# ================================================================
# Section 5 -- Lyapunov Exponent
# ================================================================

# Compute the maximal Lyapunov exponent via QR method.
# A:          stdlib matrix (n x n -- SHAPE ENFORCED), the Jacobian of the system.
# n:          state dimension.
# iterations: number of QR iterations.
# out:        pointer to store the result (f64, allocate 8 bytes).
# Returns:    0 on success, HSB_ERR_INVALID_INPUT on a null handle or a shape
#             that does not match n, HSB_ERR_ALLOC if the working matrices
#             cannot be allocated.
#
# Method: repeatedly QR-decompose A^k. The growth rate of R's diagonal
# entries gives the Lyapunov exponent. This is the simplified discrete
# version: repeatedly multiply A, QR-factor, and track log growth.
#must_use
fn lyapunov_max(A, n, iterations, out) {
    # NULL HANDLES. A may be the designed 0 from mat_new_guarded's cap.
    if (A == 0 || out == 0) { return Err(HSB_ERR_INVALID_INPUT); }

    # n WAS NOT BOUNDED AT ALL. `mat_new(n, n)` returns the designed 0 for a
    # non-positive n and the 0 went straight into mat_mul, so lyapunov_max(A, 0,
    # ...) and lyapunov_max(A, -2, ...) both SIGSEGV'd (measured, exit 139).
    if (n <= 0) { return Err(HSB_ERR_INVALID_INPUT); }

    # THE n x n PRECONDITION IS NOW CHECKED, NOT JUST DOCUMENTED. n is a
    # restatement of A's extent and ganita_mat_mul(A, Q) conforms only when A is n x n;
    # a mismatch is a caller error with no meaningful answer, so it is rejected.
    if (ganita_mat_rows(A) != n || ganita_mat_cols(A) != n) { return Err(HSB_ERR_INVALID_INPUT); }

    # mat_new_guarded, not ganita_mat_new: it propagates the designed 0 for an n this
    # module considers unreasonable instead of allocating it.
    var Q = mat_new_guarded(n, n);
    if (Q == 0) { return Err(HSB_ERR_ALLOC); }
    var R = mat_new_guarded(n, n);
    if (R == 0) { return Err(HSB_ERR_ALLOC); }

    # Initialize Q to identity
    var i = 0;
    while (i < n) { ganita_mat_set(Q, i, i, f64_from(1)); i = i + 1; }

    var sum_log = f64_from(0);
    var count = 0;

    var iter = 0;
    while (iter < iterations) {
        # Z = A * Q
        var Z = ganita_mat_mul(A, Q);
        # ganita_mat_mul allocates; a failed allocation is a 0 that ganita_mat_qr would read
        # through. Bail with the allocation code rather than store into address 0.
        if (Z == 0) { return Err(HSB_ERR_ALLOC); }

        # QR decompose Z -> Q, R
        ganita_mat_qr(Z, Q, R);

        # Accumulate log of |R[0][0]| (dominant direction growth)
        var r00 = f64_abs(ganita_mat_get(R, 0, 0));
        # ⛔ `r00` is a growth factor in the matrix's units against an absolute
        # 1e-12, so genuine contraction was silently excluded from the average and
        # the exponent came back biased. ⚠ NOT DBL_MIN: `ln` is defined for every
        # positive double including subnormals, so a floor there would still drop
        # samples the logarithm handles. Guard the domain, nothing more.
        if (f64_gt(r00, 0) == 1) {
            sum_log = f64_add(sum_log, f64_ln(r00));
            count = count + 1;
        }

        iter = iter + 1;
    }

    if (count == 0) {
        store64(out, f64_from(0));
    } else {
        store64(out, f64_div(sum_log, f64_from(count)));
    }
    return Ok(0);
}

# ================================================================
# Section 6 -- Inertia Tensors
# ================================================================

# Inertia tensor of a solid sphere.
# Returns: 3x3 stdlib matrix.
fn inertia_sphere(mass, radius) {
    var I = f64_mul(f64_div(f64_from(2), f64_from(5)), f64_mul(mass, f64_mul(radius, radius)));
    var m = ganita_mat_new(3, 3);
    ganita_mat_set(m, 0, 0, I);
    ganita_mat_set(m, 1, 1, I);
    ganita_mat_set(m, 2, 2, I);
    return m;
}

# Inertia tensor of a solid box (cuboid).
# hx, hy, hz are half-extents.
# Returns: 3x3 stdlib matrix.
fn inertia_box(mass, hx, hy, hz) {
    var w = f64_mul(f64_from(2), hx);
    var h = f64_mul(f64_from(2), hy);
    var d = f64_mul(f64_from(2), hz);
    var c = f64_div(mass, f64_from(12));

    var m = ganita_mat_new(3, 3);
    ganita_mat_set(m, 0, 0, f64_mul(c, f64_add(f64_mul(h, h), f64_mul(d, d))));
    ganita_mat_set(m, 1, 1, f64_mul(c, f64_add(f64_mul(w, w), f64_mul(d, d))));
    ganita_mat_set(m, 2, 2, f64_mul(c, f64_add(f64_mul(w, w), f64_mul(h, h))));
    return m;
}

# ================================================================
# 7. CONDITION NUMBER
# ================================================================

# Condition number of a square matrix: cond(A) = ||A|| * ||A^-1||
# Uses Frobenius norm. Returns f64. Returns -1 if singular.
fn matrix_condition_number(A) {
    var n = ganita_mat_rows(A);
    var norm_a = ganita_mat_frobenius(A);
    var inv_a = ganita_mat_inv(A);
    if (inv_a == 0) { return f64_neg(F64_ONE); }
    var norm_inv = ganita_mat_frobenius(inv_a);
    return f64_mul(norm_a, norm_inv);
}

# ================================================================
# 8. COMPLEX MATRIX INVERSE
# ================================================================

# Inverse of a square complex matrix via Gauss-Jordan elimination.
# Returns a fresh n x n matrix, or 0 if m is null, not square, or singular.
fn cmat_inverse(m) {
    # m may be the designed 0 that cmat_new returns above _CMAT_MAX_ELEMS or that
    # cmat_mul returns on a non-conformable product; cmat_rows(0) is a null
    # dereference, so guard before reading dims. The 2.7.0-B family guarded the
    # augmented cmat_new below but not the argument itself.
    if (m == 0) { return 0; }
    var n = cmat_rows(m);
    if (n != cmat_cols(m)) { return 0; }
    # Build augmented [M | I]. This doubles the width, so an input at the
    # _CMAT_MAX_ELEMS ceiling asks for twice it and cmat_new correctly returns 0 —
    # which was then stored through, turning the guard into a segfault.
    var aug = cmat_new(n, n * 2);
    if (aug == 0) { return 0; }
    var i = 0;
    while (i < n) {
        var j = 0;
        while (j < n) {
            cmat_set(aug, i, j, cmat_get(m, i, j));
            if (i == j) { cmat_set(aug, i, j + n, cx_one()); }
            j = j + 1;
        }
        i = i + 1;
    }
    # Forward elimination with partial pivoting
    var col = 0;
    while (col < n) {
        # Find pivot
        var max_norm = 0;
        var pivot_row = col;
        # The scale the pivot is judged RELATIVE to: the largest magnitude
        # anywhere in the active submatrix row-band, so an all-zero column in a
        # non-zero matrix is still recognised as a singular pivot rather than as
        # "everything here is small".
        var col_scale = f64_from(0);
        i = col;
        while (i < n) {
            # ⛔ 2.17.0 — `max_norm` HELD A SQUARED MODULUS and the two guards
            # below compared it against degree-ONE quantities. It is now a
            # MODULUS, via the repaired `cx_abs`, so both sides of both tests are
            # in the same units and neither operand has been through a square
            # that flushes. Pivot SELECTION is unchanged — sqrt is monotone.
            var nrm = cx_abs(cmat_get(aug, i, col));
            if (f64_gt(nrm, max_norm) == 1) {
                max_norm = nrm;
                pivot_row = i;
            }
            var kk = col;
            while (kk < n) {
                # ⛔ 2.17.0 — THIS WAS THE PRE-REPAIR `cx_abs` BODY, INLINED
                # VERBATIM, so the 2.17.0 repair of `cx_abs` sailed straight past
                # it. `col_scale` is the scale every pivot is judged relative to,
                # and a +Inf or 0 entry here decides the whole matrix is singular.
                var em = cx_abs(cmat_get(aug, i, kk));
                if (f64_gt(em, col_scale) == 1) { col_scale = em; }
                kk = kk + 1;
            }
            i = i + 1;
        }
        # ⛔ THREE THINGS WRONG ON ONE LINE. `max_norm` is a SQUARED modulus
        # (cx_norm_sq) compared against an unsquared 1e-12; the comparison is
        # absolute where pivoting is a question of relative magnitude; and the
        # result is a silent 0 return that reads as "singular".
        # ⭐ Un-square, make it relative to the column's own largest entry, and
        # FLOOR it. ⚠ The floor is not belt-and-braces: with a bare relative test
        # an ALL-ZERO matrix has scale 0, so the threshold is 0, `0 < 0` is false,
        # the guard does not fire and the routine would return a zero MATRIX where
        # it currently returns 0. Measured — that is a live behaviour, not a
        # hypothetical. [measured: docs/audit/2026-09-09-epsilon-open.json]
        if (f64_lt(max_norm, F64_TINY) == 1) { return 0; }  # genuinely singular
        # ⛔ 2.17.0 — the `f64_sqrt` here is GONE, not moved: `max_norm` is a
        # modulus now, so un-squaring it would be wrong. Measured on the shipped
        # tree, `cmat_inverse(diag(2^e, 2^(e+1)))` returned a FABRICATED SINGULAR
        # for **498 of 1010 exponents**, first at 2^-512, and
        # `[[2^500, 2^520], [0, 1]]` — whose inverse is wholly representable —
        # came back singular as well.
        # ⚠ All three lines had to move together. Measured: repairing only the
        # `em` line takes 489 of 2001 to 488. [measured: 1010-exponent sweep]
        if (f64_lt(max_norm, f64_mul(EPSILON_F64, col_scale)) == 1) {
            return 0;                                        # negligible pivot
        }
        # Swap rows
        if (pivot_row != col) {
            var k = 0;
            while (k < n * 2) {
                var tmp = cmat_get(aug, col, k);
                cmat_set(aug, col, k, cmat_get(aug, pivot_row, k));
                cmat_set(aug, pivot_row, k, tmp);
                k = k + 1;
            }
        }
        # Scale pivot row
        var pivot_val = cmat_get(aug, col, col);
        var pivot_inv = cx_inv(pivot_val);
        var k = 0;
        while (k < n * 2) {
            cmat_set(aug, col, k, cx_mul(cmat_get(aug, col, k), pivot_inv));
            k = k + 1;
        }
        # Eliminate column
        i = 0;
        while (i < n) {
            if (i != col) {
                var factor = cmat_get(aug, i, col);
                k = 0;
                while (k < n * 2) {
                    cmat_set(aug, i, k, cx_sub(cmat_get(aug, i, k), cx_mul(factor, cmat_get(aug, col, k))));
                    k = k + 1;
                }
            }
            i = i + 1;
        }
        col = col + 1;
    }
    # Extract right half
    var result = cmat_new(n, n);
    i = 0;
    while (i < n) {
        var j = 0;
        while (j < n) {
            cmat_set(result, i, j, cmat_get(aug, i, j + n));
            j = j + 1;
        }
        i = i + 1;
    }
    return result;
}
