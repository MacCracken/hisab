# linalg_ext.cyr -- sparse linear algebra, iterative solvers, SVD wrappers,
#                   eigendecomposition, Lyapunov exponents, inertia tensors
# Usage: shipped inside dist/hisab.cyr; in-tree, include "src/linalg_ext.cyr" after what it requires
# Requires: src/complex.cyr, src/error.cyr, src/f64_util.cyr, src/linalg_precision.cyr, src/num.cyr (stdlib via [deps]);
#           linalg_precision since 3.3.4: its `svd_golub_kahan` is svd_compute_checked's fallback
#
# Ported from rust-old/src/num/{sparse,solvers,svd,eigen,stability,inertia}.rs
#
# CSR sparse matrix layout (48 bytes header + data arrays):
#   { nrows: i64, ncols: i64, nnz: i64, row_ptr: ptr, col_idx: ptr, values: ptr }
#   Offset 0:  nrows
#   Offset 8:  ncols
#   Offset 16: nnz
#   Offset 24: row_ptr  -- flat i64 array, length nrows+1
#   Offset 32: col_idx  -- flat i64 array, length nnz
#   Offset 40: values   -- flat f64 array, length nnz

# ================================================================
# Section 0 -- Guarded matrix constructor
# ================================================================

# Element cap for the overflow-guarded real-matrix constructor: 16M elements
# at 8 B/elem (128 MB). Keeps rows*cols well below 2^60, so `16 + rows*cols*8`
# cannot wrap i64.
var _MAT_MAX_ELEMS = 16777216;

# Overflow-guarded real-matrix constructor (CWE-190). Returns 0 (null) for
# non-positive or overflow-prone dimensions; otherwise delegates to the stdlib
# `mat_new`.
#
# As of the cyrius 6.5.6 pin (hisab 2.6.11) the stdlib is guarded too: ganita
# 1.0.4 added the same check to `ganita_mat_new` (GANITA_MAT_MAX_ELEMS =
# 33_554_430, the ALLOC_MAX-derived ceiling). Before that fix, stdlib `mat_new`
# computed `16 + rows*cols*8` unguarded and `mat_new(-5, 3)` SEGFAULTED —
# measured, not theoretical. This wrapper predates the upstream fix and is kept
# because it is deliberately STRICTER: 16M elements (128 MB at 8 B/elem) against
# upstream's 33.5M, so it still rejects allocations hisab considers unreasonable
# even though upstream would now accept them. Use it when sizing a matrix from
# untrusted / external input. hisab's own internal callers pass dimensions taken
# from already-allocated matrices, so they are not exposed.
# [measured: CHANGELOG.md 2.6.11, the vendored-ganita table: mat_new(-5, 3) under 1.0.3 was SIGSEGV, exit 139]
public fn mat_new_guarded(rows, cols) {
    if (rows <= 0 || cols <= 0) { return 0; }
    if (rows > _MAT_MAX_ELEMS / cols) { return 0; }
    return ganita_mat_new(rows, cols);
}

# ================================================================
# Section 1 -- CSR Sparse Matrix
# ================================================================

# Construct a CSR matrix from pre-built arrays.
# row_ptr: flat i64 array (nrows+1 entries)
# col_idx: flat i64 array (nnz entries)
# values:  flat f64 array (nnz entries)
# Returns pointer to CSR struct (48 bytes), or 0 when it cannot be allocated (3.4.0: the
# header was stored through a refused allocation).
#
# ⛔ 3.4.0 — THE CSR SECTION STORED THROUGH EVERY ALLOCATION UNCHECKED (roadmap [3.3.8],
# "linalg_ext CSR / GMRES / BiCGSTAB"). Each routine below now returns its designed 0 when an
# allocation is refused, and the ones that size an array from a CSR header (a struct the
# caller built, so any i64) first refuse a negative count or one past ALLOC_MAX / 8 words.
public fn csr_new(nrows, ncols, nnz, row_ptr, col_idx, values) {
    var csr = alloc(48);
    if (csr == 0) { return 0; }
    store64(csr,      nrows);
    store64(csr + 8,  ncols);
    store64(csr + 16, nnz);
    store64(csr + 24, row_ptr);
    store64(csr + 32, col_idx);
    store64(csr + 40, values);
    return csr;
}

# Accessors: csr_nrows, csr_ncols and csr_nnz return the header's three counts as stored (i64),
# csr_row_ptr, csr_col_idx and csr_values its three array pointers (the caller's arrays for a
# csr_new matrix, fresh ones for the CSR constructors below). RAW AND UNCHECKED, as cmat_rows and
# ganita_mat_rows are: csr must be a live CSR handle, never the designed 0 a refused constructor
# returns, which they would read through; nothing here allocates or fails.
public fn csr_nrows(csr)   { return load64(csr); }
# The column count, as stored: a raw read of a live handle, no failure channel (see above). For
# a csr_new matrix it is the number the caller gave, which nothing checks against col_idx.
public fn csr_ncols(csr)   { return load64(csr + 8); }
# The stored entry count, as stored: a raw read of a live handle, no failure channel (see above).
# A count of entries kept, not of non-zero values: csr_new's arrays may hold an explicit 0.0.
public fn csr_nnz(csr)     { return load64(csr + 16); }
# The row pointers: nrows + 1 i64 offsets, row i holding entries row_ptr[i] .. row_ptr[i + 1] - 1
# of the two arrays below. The array itself, not a copy, so a write through it changes the matrix;
# a raw read of a live handle, no failure channel (see above).
public fn csr_row_ptr(csr) { return load64(csr + 24); }
# The column index of each entry, nnz i64 values parallel to csr_values. The array itself, not a
# copy; a raw read of a live handle, no failure channel (see above).
public fn csr_col_idx(csr) { return load64(csr + 32); }
# The value of each entry, nnz f64 values parallel to csr_col_idx. The array itself, not a copy,
# so a write through it changes the matrix; a raw read of a live handle, no failure channel (see
# above).
public fn csr_values(csr)  { return load64(csr + 40); }

# Convert a stdlib dense matrix (from matrix.cyr) to CSR. Returns 0 when an array cannot be
# allocated (3.4.0). Its counts come from an allocated ganita matrix, at most
# GANITA_MAT_MAX_ELEMS entries, so no size here can overflow.
# Stores exactly the entries that are not 0.0. (This line still said
# "drops |value| < EPSILON_F64" until 3.2.0; the drop became structural in 2.15.0 --
# the 2.14.0 tag still ships the EPSILON_F64 guard.)
# A CSR that must carry an EXPLICIT zero -- a pattern fixed ahead of its values,
# as an assembly loop does -- is built with csr_new, the only constructor that
# takes the arrays as given.
# Returns pointer to CSR struct.
#
# ⛔ 3.4.0 — THE LIBRARY'S OWN DESIGNED 0 CRASHED THE CSR SECTION (D102 audit, AU2-G3-F2):
# csr_from_dense(mat_new_guarded(0, 3)), csr_spmv / csr_transpose of csr_add's mismatch 0, and
# csr_add(0, b) each read through the null handle (exit 139). A null handle is now refused with
# the same designed 0 each routine already returns.
# [measured: D102 audit AU2 G3-F2 repros, re-run on 3.3.7 base (LA probes pd_1..pd_5), cycc 6.7.9, 2026-10-31]
public fn csr_from_dense(dense_mat) {
    if (dense_mat == 0) { return 0; }
    var nrows = ganita_mat_rows(dense_mat);
    var ncols = ganita_mat_cols(dense_mat);

    # First pass: count non-zeros
    var count = 0;
    var i = 0;
    while (i < nrows) {
        var j = 0;
        while (j < ncols) {
            var v = ganita_mat_get(dense_mat, i, j);
            # ⛔ SPARSITY IS A STRUCTURAL QUESTION, NOT A TOLERANCE ONE. An entry
            # is stored or it is not, and `|A_ij| > 1e-12` made that depend on the
            # caller's units — a matrix in millimetres kept entries a matrix in
            # metres silently dropped. ⚠ AND THE TWO PASSES MUST AGREE EXACTLY:
            # this test counts the entries and the identical one below emits them,
            # so any disagreement mis-sizes the arrays.
            # [measured: docs/audit/2026-09-09-epsilon-open.json]
            if (f64_eq(v, f64_from(0)) == 0) {
                count = count + 1;
            }
            j = j + 1;
        }
        i = i + 1;
    }

    var row_ptr = alloc((nrows + 1) * 8);
    var col_idx = alloc(count * 8);
    var values  = alloc(count * 8);
    # alloc(0) is the designed 0 too, and an all-zero matrix is the empty CSR (nnz 0, null data
    # arrays), so only a request of some size is refused
    if (row_ptr == 0 || (count > 0 && (col_idx == 0 || values == 0))) { return 0; }

    var pos = 0;
    store64(row_ptr, 0);
    i = 0;
    while (i < nrows) {
        var j = 0;
        while (j < ncols) {
            var v = ganita_mat_get(dense_mat, i, j);
            # ⚠ Byte-identical to the counting pass above, deliberately.
            if (f64_eq(v, f64_from(0)) == 0) {
                store64(col_idx + pos * 8, j);
                store64(values + pos * 8, v);
                pos = pos + 1;
            }
            j = j + 1;
        }
        store64(row_ptr + (i + 1) * 8, pos);
        i = i + 1;
    }

    return csr_new(nrows, ncols, count, row_ptr, col_idx, values);
}

# Sparse matrix-vector multiply: y = CSR * x.
# x: flat f64 array of length ncols.
# Returns: flat f64 array of length nrows, or 0 for a null csr, a negative nrows or one past
# ALLOC_MAX / 8, or a refused allocation (3.4.0).
public fn csr_spmv(csr, x) {
    if (csr == 0) { return 0; }
    var nrows   = load64(csr);
    var row_ptr = load64(csr + 24);
    var col_idx = load64(csr + 32);
    var vals    = load64(csr + 40);

    if (nrows < 0 || nrows > ALLOC_MAX / 8) { return 0; }
    var y = alloc(nrows * 8);
    if (y == 0) { return 0; }   # nrows = 0 included: alloc(0) is 0, as through 3.3.7
    var i = 0;
    while (i < nrows) {
        var sum = f64_from(0);
        var start = load64(row_ptr + i * 8);
        var end   = load64(row_ptr + (i + 1) * 8);
        var idx = start;
        while (idx < end) {
            var col = load64(col_idx + idx * 8);
            var val = load64(vals + idx * 8);
            sum = f64_add(sum, f64_mul(val, load64(x + col * 8)));
            idx = idx + 1;
        }
        store64(y + i * 8, sum);
        i = i + 1;
    }
    return y;
}

# Sparse matrix addition: C = A + B (both CSR, same dimensions).
# Uses sorted merge of each row. Drops zeros.
# Returns new CSR struct, or 0 on dimension mismatch, a null operand, a negative count or
# counts whose arrays would pass ALLOC_MAX / 8 words, or a refused allocation (3.4.0).
public fn csr_add(a, b) {
    if (a == 0 || b == 0) { return 0; }
    var nrows_a = load64(a);
    var ncols_a = load64(a + 8);
    var nrows_b = load64(b);
    var ncols_b = load64(b + 8);
    if (nrows_a != nrows_b) { return 0; }
    if (ncols_a != ncols_b) { return 0; }

    var nrows = nrows_a;
    var ncols = ncols_a;
    var a_rp = load64(a + 24);
    var a_ci = load64(a + 32);
    var a_v  = load64(a + 40);
    var b_rp = load64(b + 24);
    var b_ci = load64(b + 32);
    var b_v  = load64(b + 40);

    # Upper bound on nnz: sum of both nnz counts, bounded before it is formed
    var nnz_a = load64(a + 16);
    var nnz_b = load64(b + 16);
    var cap = ALLOC_MAX / 8;
    if (nrows < 0 || nrows >= cap || nnz_a < 0 || nnz_b < 0) { return 0; }
    if (nnz_a > cap || nnz_b > cap - nnz_a) { return 0; }
    var max_nnz = nnz_a + nnz_b;
    var out_rp = alloc((nrows + 1) * 8);
    var out_ci = alloc(max_nnz * 8);
    var out_v  = alloc(max_nnz * 8);
    if (out_rp == 0 || (max_nnz > 0 && (out_ci == 0 || out_v == 0))) { return 0; }   # empty: null arrays

    var pos = 0;
    store64(out_rp, 0);

    var i = 0;
    while (i < nrows) {
        var ai = load64(a_rp + i * 8);
        var ae = load64(a_rp + (i + 1) * 8);
        var bi = load64(b_rp + i * 8);
        var be = load64(b_rp + (i + 1) * 8);

        while (ai < ae && bi < be) {
            var ac = load64(a_ci + ai * 8);
            var bc = load64(b_ci + bi * 8);
            if (ac < bc) {
                store64(out_ci + pos * 8, ac);
                store64(out_v + pos * 8, load64(a_v + ai * 8));
                pos = pos + 1;
                ai = ai + 1;
            } else {
                if (ac > bc) {
                    store64(out_ci + pos * 8, bc);
                    store64(out_v + pos * 8, load64(b_v + bi * 8));
                    pos = pos + 1;
                    bi = bi + 1;
                } else {
                    # Same column -- add values
                    var s = f64_add(load64(a_v + ai * 8), load64(b_v + bi * 8));
                    # ⛔ Same class: a genuinely non-zero sum was dropped from the
                    # pattern because it was small in the caller's units. ⚠ Exact
                    # `!= 0` rather than `|s| > 0`, so a NaN sum is KEPT rather
                    # than silently deleted from the matrix.
                    if (f64_eq(s, f64_from(0)) == 0) {
                        store64(out_ci + pos * 8, ac);
                        store64(out_v + pos * 8, s);
                        pos = pos + 1;
                    }
                    ai = ai + 1;
                    bi = bi + 1;
                }
            }
        }
        # Drain remaining from A
        while (ai < ae) {
            store64(out_ci + pos * 8, load64(a_ci + ai * 8));
            store64(out_v + pos * 8, load64(a_v + ai * 8));
            pos = pos + 1;
            ai = ai + 1;
        }
        # Drain remaining from B
        while (bi < be) {
            store64(out_ci + pos * 8, load64(b_ci + bi * 8));
            store64(out_v + pos * 8, load64(b_v + bi * 8));
            pos = pos + 1;
            bi = bi + 1;
        }
        store64(out_rp + (i + 1) * 8, pos);
        i = i + 1;
    }

    return csr_new(nrows, ncols, pos, out_rp, out_ci, out_v);
}

# Transpose a CSR matrix. Returns new CSR struct, or 0 for a null csr, a negative count or
# one whose array would pass ALLOC_MAX / 8 words, or a refused allocation (3.4.0).
public fn csr_transpose(csr) {
    if (csr == 0) { return 0; }
    var nrows   = load64(csr);
    var ncols   = load64(csr + 8);
    var nnz     = load64(csr + 16);
    var row_ptr = load64(csr + 24);
    var col_idx = load64(csr + 32);
    var vals    = load64(csr + 40);
    var cap = ALLOC_MAX / 8;
    if (nrows < 0 || ncols < 0 || nnz < 0 || ncols >= cap || nnz > cap) { return 0; }

    # Count entries per column (= rows of transposed)
    var row_counts = alloc(ncols * 8);
    if (ncols > 0 && row_counts == 0) { return 0; }
    var k = 0;
    while (k < ncols) { store64(row_counts + k * 8, 0); k = k + 1; }

    k = 0;
    while (k < nnz) {
        var c = load64(col_idx + k * 8);
        store64(row_counts + c * 8, load64(row_counts + c * 8) + 1);
        k = k + 1;
    }

    # Build new row_ptr from counts
    var new_rp = alloc((ncols + 1) * 8);
    if (new_rp == 0) { return 0; }
    var cum = 0;
    store64(new_rp, 0);
    k = 0;
    while (k < ncols) {
        cum = cum + load64(row_counts + k * 8);
        store64(new_rp + (k + 1) * 8, cum);
        k = k + 1;
    }

    # Fill transposed data
    var new_ci = alloc(nnz * 8);
    var new_v  = alloc(nnz * 8);
    # cursor tracks current write position per row of transposed
    var cursor = alloc(ncols * 8);
    if ((nnz > 0 && (new_ci == 0 || new_v == 0)) || (ncols > 0 && cursor == 0)) { return 0; }
    k = 0;
    while (k < ncols) {
        store64(cursor + k * 8, load64(new_rp + k * 8));
        k = k + 1;
    }

    var i = 0;
    while (i < nrows) {
        var start = load64(row_ptr + i * 8);
        var end   = load64(row_ptr + (i + 1) * 8);
        var idx = start;
        while (idx < end) {
            var col = load64(col_idx + idx * 8);
            var dest = load64(cursor + col * 8);
            store64(new_ci + dest * 8, i);
            store64(new_v + dest * 8, load64(vals + idx * 8));
            store64(cursor + col * 8, dest + 1);
            idx = idx + 1;
        }
        i = i + 1;
    }

    return csr_new(ncols, nrows, nnz, new_rp, new_ci, new_v);
}

# ================================================================
# Section 2 -- Iterative Solvers
# ================================================================

# Helper: compute dot product of two flat f64 arrays of length n
fn _lext_dot(a, b, n) {
    var sum = f64_from(0);
    var i = 0;
    while (i < n) {
        sum = f64_add(sum, f64_mul(load64(a + i * 8), load64(b + i * 8)));
        i = i + 1;
    }
    return sum;
}

# ⭐ n-LEG SCALED RESCUE — `_hvec3_len_scaled` generalised to a length-n array.
# ⚠ NaN NEVER REACHES HERE, and it is worth saying why rather than guarding for
# it: a NaN component makes the caller's sum NaN, which satisfies neither
# `< F64_TINY` nor `== +Inf`, so the fast path returns `f64_sqrt(NaN)` and this
# helper is not called. ⛔ An earlier draft of this comment claimed the `mx == 0`
# exit propagated NaN because it returns `mx`. Measured, it does NOT: this max is
# an explicit `f64_gt` loop, and `f64_gt(NaN, mx)` is 0, so a NaN never raises
# `mx` and an all-NaN vector would return 0 here. `_hvec3_len_scaled` uses
# `f64_max` and does propagate — the two are not interchangeable, and returning
# `mx` versus a literal zero is an EQUIVALENCE in this shape, mutation-confirmed.
# ⚠ The `+Inf` exit is REQUIRED: without it `Inf/Inf` is NaN and an infinite
# component would turn a well-defined +Inf norm into a NaN.
# [measured: NaN probe on both scaled helpers, 2026-09-10]
# ⚠ 3.3.3 — `f64_gt(mx, 0) == 0` BELOW IS THE NaN-TRUE SHAPE, AUDITED AND KEPT, for
# the two reasons above: mx is an f64_gt max seeded with 0 and is never NaN, and
# `_lext_norm` (this helper's only caller) never routes a NaN vector here. The exit
# fires only for a vector of zeros, whose norm is 0. `f64_eq(mx, 0)` there is an
# equivalent mutant; routing a NaN sum in from `_lext_norm` is not -- modules.tcyr's
# "_lext_norm: NaN propagates" fails on it.
# [measured: G2a mutant run, cycc 6.6.12, 2026-10-01]
fn _lext_norm_scaled(v, n) {
    var mx = f64_from(0);
    var i = 0;
    while (i < n) {
        var a = f64_abs(load64(v + i * 8));
        if (f64_gt(a, mx) == 1) { mx = a; }
        i = i + 1;
    }
    if (f64_gt(mx, 0) == 0) { return mx; }
    if (f64_eq(mx, F64_POS_INF) == 1) { return mx; }
    var s = f64_from(0);
    i = 0;
    while (i < n) {
        var q = f64_div(load64(v + i * 8), mx);
        s = f64_add(s, f64_mul(q, q));
        i = i + 1;
    }
    return f64_mul(mx, f64_sqrt(s));
}

# omega = t . s / t . t for BiCGSTAB's breakdown test (3.4.1), from a numerator whose zero is
# decided rigorously: t and s are divided by the powers of two at their largest |entries| (each
# then below 2 in modulus; exact, but for parts under 2^-1074 of their vector's largest, flushed:
# each costs at most 2^-1073 of a term), every product is split exactly (Dekker; exact while it
# is not below about 2^-969, and short of 2^-1073 otherwise) and the pieces are summed with Knuth's
# TwoSum (Ogita, Rump and Oishi's Dot2), whose result is within u |t.s| + gamma_n^2 sum|t_i s_i|
# of the scaled t . s. A result within 4 n^2 u^2 sum|t_i s_i| + 2 n 2^-1072 of 0 (bounding both,
# with room for the rounding of the bound itself) is a breakdown: 0 is returned. Otherwise
# omega, the scaled numerator over the scaled sum of t_i^2 times 2^(es - et), in one rounding
# past the quotient.
fn _lext_dot_acc(t, s, n) {
    var tm = f64_from(0);
    var sm = f64_from(0);
    for (var i = 0; i < n; i = i + 1) {
        var ta = f64_abs(load64(t + i * 8));
        var sa = f64_abs(load64(s + i * 8));
        if (f64_gt(ta, tm) == 1) { tm = ta; }
        if (f64_gt(sa, sm) == 1) { sm = sa; }
    }
    if ((tm & 0x7FFF_FFFF_FFFF_FFFF) == 0 || (sm & 0x7FFF_FFFF_FFFF_FFFF) == 0) { return f64_from(0); }
    var et = _lext_xexp(tm);
    var es = _lext_xexp(sm);
    var sh = f64_from(0);
    var sl = f64_from(0);
    var ab = f64_from(0);
    var tt = f64_from(0);
    var pr: i64[2];
    var ps: i64[2];
    for (var j = 0; j < n; j = j + 1) {
        var a = _lext_pow2mul(load64(t + j * 8), 0 - et);
        var b = _lext_pow2mul(load64(s + j * 8), 0 - es);
        tt = f64_add(tt, f64_mul(a, a));
        _lext_two_prod(a, b, &pr);
        ab = f64_add(ab, f64_abs(load64(&pr)));
        _lext_two_sum(sh, load64(&pr), &ps);
        sh = load64(&ps);
        sl = f64_add(sl, f64_add(load64(&ps + 8), load64(&pr + 8)));
    }
    var res = f64_add(sh, sl);
    var nn = f64_from(n * n);
    # 4 n^2 2^-106 sum|t_i s_i| + 2 n (4 2^-1074)
    var bnd = f64_add(f64_mul(f64_mul(nn, 0x3970000000000000), ab), f64_mul(f64_from(2 * n), 4));
    if (f64_le(f64_abs(res), bnd) == 1) { return f64_from(0); }
    return _lext_pow2mul(f64_div(res, tt), es - et);
}

# Helper: Euclidean norm of flat f64 array of length n
# ⛔ 2.17.0 — THIS SQUARED BEFORE SUMMING, and it is the residual norm the Krylov
# solvers converge on. A component below 2^-537 squares to zero, so `r_norm` is
# exactly 0, `f64_lt(r_norm, tol)` fires, and `solve_gmres` returns `x0` as the
# answer — or, one line later, normalises by `1/0`. Measured on A = 2I with the
# caller scaling `tol` with the problem as a careful caller would: **461 of 1001
# scales wrong, first at 2^-539.**
# ⭐ Fast path plus the scaled rescue: two scalar compares per call on a pass that
# is already O(n) and sits beside the caller's own matvec.
# [measured: 1001-scale sweep on solve_gmres, 2026-09-10]
fn _lext_norm(v, n) {
    var ss = _lext_dot(v, v, n);
    if (f64_lt(ss, F64_TINY) == 1) { return _lext_norm_scaled(v, n); }
    if (f64_eq(ss, F64_POS_INF) == 1) { return _lext_norm_scaled(v, n); }
    return f64_sqrt(ss);
}

# Helper: y = a - b, flat f64 arrays of length n. Returns new array, or 0 when it cannot be
# allocated (3.4.0: it stored through the refused allocation before its callers could look).
fn _lext_sub(a, b, n) {
    var out = alloc(n * 8);
    if (out == 0) { return 0; }
    var i = 0;
    while (i < n) {
        store64(out + i * 8, f64_sub(load64(a + i * 8), load64(b + i * 8)));
        i = i + 1;
    }
    return out;
}

# Helper: copy flat f64 array of length n. Returns new array, or 0 when it cannot be
# allocated (3.4.0, as _lext_sub).
fn _lext_copy(src, n) {
    var out = alloc(n * 8);
    if (out == 0) { return 0; }
    var i = 0;
    while (i < n) {
        store64(out + i * 8, load64(src + i * 8));
        i = i + 1;
    }
    return out;
}

# Descending selection sort of `vals[0..n)`, carrying matrix columns and/or rows
# along with every swap so a (value, vector) pair is never broken.
#   by_abs:   1 to order by |value| (eigenvalues), 0 to order by value (singular
#             values, already non-negative when sorted).
#   col_mat:  stdlib matrix whose columns i / max_idx are swapped over `col_rows`
#             rows (0 = none) -- eigenvector columns, the U of an SVD.
#   row_mat:  stdlib matrix whose rows i / max_idx are swapped over `row_cols`
#             columns (0 = none) -- the Vt of an SVD.
#
# ONE routine for eigen_symmetric (here), eigen_qr and svd_golub_kahan
# (src/linalg_precision.cyr). Those three carried near-identical copies of this
# loop and had already disagreed on order once (the 2026-08-04 audit found
# eigen_symmetric returning Jacobi's raw diagonal order while eigen_qr sorted --
# see eigen_symmetric's ORDERING note); a single body is what makes agreement
# structural rather than a promise in three comments.
#
# ⚠ TIE ORDER IS PART OF THE CONTRACT, which is why this stays a hand-written
# selection sort rather than stdlib `vec_sort_by`. Equal eigenvalues carry
# DISTINCT eigenvectors, so the order of tied columns is observable, and
# `vec_sort_by` is an introsort (unstable above its 16-element insertion
# cutoff) that permutes ties differently from this loop. The order is pinned in
# tests/hisab.tcyr ("tie order" block): the first max is taken (strict `f64_gt`,
# so a later equal value never displaces an earlier one) and the swap is
# i <-> max_idx, so values (2, 2, 4) give column order (e3, e2, e1) where a
# stable sort would give (e3, e1, e2).
#
# O(n^2) on an O(n^3) decomposition, so it is free at every n these are used
# for. A NaN key never becomes the max (`f64_gt` is false either way), exactly
# as in the three loops this replaces.
# (Was `_lext_sort_desc` through 3.2.x; public since 3.3.0 -- it is the ordering every
# eigen/SVD entry point returns through, and its tie rule is observable to callers.)
# Returns: Ok(0), or Err(HSB_ERR_INVALID_INPUT) when vals is null with n > 0, or a
# matrix is smaller than the region it is told to swap over (col_mat needs col_rows
# rows and n columns, row_mat n rows and row_cols columns).
# ⛔ 3.3.0 — THE SWAPS GO THROUGH `ganita_mat_set`, WHICH IS UNCHECKED BY DESIGN, and
# as a private helper this needed no guard: its three callers size every matrix.
# Made public, a 3x2 col_mat with n = 3 wrote 8 bytes past the matrix and returned
# normally. Bounded the way eigen_qr bounds out_vecs, before the loop that writes.
# [measured: tests/modules.tcyr, group "3.3.0 the promoted helpers, called as API"]
#must_use
public fn linalg_sort_desc(vals, n, by_abs, col_mat, col_rows, row_mat, row_cols) {
    if (n > 0 && vals == 0) { return Err(HSB_ERR_INVALID_INPUT); }
    if (n > 0 && col_mat != 0 && col_rows > 0) {
        if (ganita_mat_rows(col_mat) < col_rows || ganita_mat_cols(col_mat) < n) {
            return Err(HSB_ERR_INVALID_INPUT);
        }
    }
    if (n > 0 && row_mat != 0 && row_cols > 0) {
        if (ganita_mat_rows(row_mat) < n || ganita_mat_cols(row_mat) < row_cols) {
            return Err(HSB_ERR_INVALID_INPUT);
        }
    }
    var i = 0;
    while (i < n) {
        var max_idx = i;
        var max_key = load64(vals + i * 8);
        if (by_abs == 1) { max_key = f64_abs(max_key); }
        var j = i + 1;
        while (j < n) {
            var kj = load64(vals + j * 8);
            if (by_abs == 1) { kj = f64_abs(kj); }
            if (f64_gt(kj, max_key) == 1) {
                max_key = kj;
                max_idx = j;
            }
            j = j + 1;
        }
        if (max_idx != i) {
            var tmp = load64(vals + i * 8);
            store64(vals + i * 8, load64(vals + max_idx * 8));
            store64(vals + max_idx * 8, tmp);
            var k = 0;
            if (col_mat != 0) {
                while (k < col_rows) {
                    var tc = ganita_mat_get(col_mat, k, i);
                    ganita_mat_set(col_mat, k, i, ganita_mat_get(col_mat, k, max_idx));
                    ganita_mat_set(col_mat, k, max_idx, tc);
                    k = k + 1;
                }
            }
            if (row_mat != 0) {
                k = 0;
                while (k < row_cols) {
                    var tr = ganita_mat_get(row_mat, i, k);
                    ganita_mat_set(row_mat, i, k, ganita_mat_get(row_mat, max_idx, k));
                    ganita_mat_set(row_mat, max_idx, k, tr);
                    k = k + 1;
                }
            }
        }
        i = i + 1;
    }
    return Ok(0);
}

# ---- 3.4.0: the Krylov solvers' common entry checks ----
# The arguments solve_gmres_checked and solve_bicgstab_checked refuse before any work:
# HSB_ERR_INVALID_INPUT for a null A_fn, b or x0, n <= 0, max_iter <= 0, a tol that is
# negative, NaN or infinite, or a NaN or infinite entry in b or x0 (such a system has no finite
# solution to iterate towards, and a NaN iterate would only spend the budget);
# HSB_ERR_ALLOC for an n whose n-word vectors are past ALLOC_MAX. 0 when they pass.
fn _lext_krylov_args(A_fn, b, x0, n, tol, max_iter) {
    if (A_fn == 0 || b == 0 || x0 == 0) { return HSB_ERR_INVALID_INPUT; }
    if (n <= 0 || max_iter <= 0) { return HSB_ERR_INVALID_INPUT; }
    # 3.4.0 review: +Inf as well (a tolerance every residual meets, an infinite one included)
    if (f64_ge(tol, 0) == 0 || f64_lt(tol, F64_POS_INF) == 0) { return HSB_ERR_INVALID_INPUT; }
    if (n > ALLOC_MAX / 8) { return HSB_ERR_ALLOC; }
    if (_lext_vec_all_finite(b, n) == 0 || _lext_vec_all_finite(x0, n) == 0) { return HSB_ERR_INVALID_INPUT; }
    return 0;
}

# ---- 3.4.0 review: the Krylov solvers' scaled frame ----
# Both solvers solve A' x' = b' with b' = b 2^-eb (largest |b'_i| in [1, 2)) and A' = A 2^-ea,
# applied as A'(v) = A_fn(v 2^-ea): ea is read off a probe A_fn(b') (`_lext_kprobe`). Then
# x = x' 2^(eb - ea). Every operation inside is homogeneous, so a system and its copy scaled by
# powers of two run the same arithmetic in this frame and their answers differ by that power of
# two exactly, wherever it is representable; and ||b'|| is finite whenever b is.
#
# v 2^e for an exact power of two, rounded once (`_lext_xld`) where the result leaves the
# normal range. n words from v to out.
fn _lext_kscale(v, n, e, out) {
    if (e >= 0 - 1022 && e <= 1023) {
        var p = (1023 + e) << 52;
        for (var i = 0; i < n; i = i + 1) { store64(out + i * 8, f64_mul(load64(v + i * 8), p)); }
        return out;
    }
    for (var i2 = 0; i2 < n; i2 = i2 + 1) {
        var x = load64(v + i2 * 8);
        store64(out + i2 * 8, _lext_xld(_lext_xman(x), _lext_xexp(x) + e));
    }
    return out;
}

# A'(v) = A_fn(v 2^-ea): A_fn's input is sc, hisab's own storage, except when ea = 0. sc holds
# 2n words.
# ⛔ 3.4.0 second review (R2A note 1, SF5) — THE INPUT v 2^-ea HAD NO HEADROOM. For a small A
# (ea near -1020) an iterate of 2^4 already overflowed it: A = 2^-1020 [[1, 0.99], [0.99, 1]],
# b = (2^-720, 0) was NO_CONVERGENCE though x = (1.0236e92, -1.0134e92) is representable; and
# for a large A (ea near 1010) the input went subnormal and rounded, so the scaled solve stopped
# being bit for bit the unit one. Where |ea| > 800, so that it can matter, A_fn now gets
# v 2^(c - ea) with c the power of two that keeps the input's largest |entry| in
# [2^-960, 2^1000], and its product, times 2^-c, lands in sc's second half: still A' v, from
# products A_fn forms as it does at unit scale.
# [measured: LA3 probes kh.py (R2A note 1 and kbit.py rows) and ksw (the 2D sweep), integ-snap9 vs LA3, 2026-10-31]
fn _lext_kmv(A_fn, v, n, ea, sc) {
    # (0 from A_fn is its own refused allocation (3.4.1): each caller answers Err(HSB_ERR_ALLOC).)
    if (ea == 0) { return fncall1(A_fn, v); }
    if (ea >= 0 - 800 && ea <= 800) { return fncall1(A_fn, _lext_kscale(v, n, 0 - ea, sc)); }
    var vm = f64_from(0);
    for (var i = 0; i < n; i = i + 1) {
        var a = f64_abs(load64(v + i * 8));
        if (f64_gt(a, vm) == 1) { vm = a; }
    }
    var c = 0;
    if ((vm & 0x7FFF_FFFF_FFFF_FFFF) != 0) {
        var t = _lext_xexp(vm) - ea;
        if (t > 1000) { c = 1000 - t; }
        if (t < 0 - 960) { c = 0 - 960 - t; }
    }
    if (c == 0) { return fncall1(A_fn, _lext_kscale(v, n, 0 - ea, sc)); }
    var w = fncall1(A_fn, _lext_kscale(v, n, c - ea, sc));
    if (w == 0) { return 0; }
    return _lext_kscale(w, n, 0 - c, sc + n * 8);
}

# The probe: ea such that A_fn(b') 2^-ea has largest |entry| in [1, 2). res[0] = ea, res[1] = the
# matvecs spent (1, or 2 when A_fn(b') overflowed and b' 2^-600 is tried). Returns 0, or 1 when
# A_fn gives a non-finite product even at b' 2^-600 (A_fn is not a finite linear map there). A
# zero product (b' in A's null space) leaves ea = 0. An A_fn(b') below 2^-1022 (an A whose
# entries are all subnormal) gives an ea below -1022, and `_lext_kmv` keeps A_fn's input
# representable there (since the second review): 2^-1030 I x = 2^-100 (1, 1) and
# 2^-1060 I x = 2^-1060 (1, 1), Errs through the first review, are answered (x = 2^930 (1, 1) and
# (1, 1), the GMRES ones 1 ulp above). Returns 2 when A_fn answers 0, its own refused allocation (3.4.1).
# [measured: LA2 probe k5 on integ-snap5, LA2 and LA3, cycc 6.7.9, 2026-10-31]
fn _lext_kprobe(A_fn, bs, n, sc, res) {
    var w = fncall1(A_fn, bs);
    if (w == 0) { return 2; }
    var calls = 1;
    var off = 0;
    var wm = f64_from(0);
    var fin = 1;
    for (var i = 0; i < n; i = i + 1) {
        var a = f64_abs(load64(w + i * 8));
        if (f64_lt(a, F64_POS_INF) == 0) { fin = 0; }
        if (f64_gt(a, wm) == 1) { wm = a; }
    }
    if (fin == 0) {
        off = 0 - 600;
        w = fncall1(A_fn, _lext_kscale(bs, n, off, sc));
        if (w == 0) { return 2; }
        calls = 2;
        wm = f64_from(0);
        for (var i2 = 0; i2 < n; i2 = i2 + 1) {
            var a2 = f64_abs(load64(w + i2 * 8));
            if (f64_lt(a2, F64_POS_INF) == 0) {
                store64(res + 8, calls);
                return 1;
            }
            if (f64_gt(a2, wm) == 1) { wm = a2; }
        }
    }
    var ea = 0;
    if ((wm & 0x7FFF_FFFF_FFFF_FFFF) != 0) { ea = _lext_xexp(wm) - 1 - off; }
    store64(res, ea);
    store64(res + 8, calls);
    return 0;
}

# 1 when every entry of v[0..n) is a zero of either sign.
fn _lext_kzero(v, n) {
    for (var i = 0; i < n; i = i + 1) {
        if ((load64(v + i * 8) & 0x7FFF_FFFF_FFFF_FFFF) != 0) { return 0; }
    }
    return 1;
}

# x' 2^(eb - ea) back into x, in place. 0, or 1 when an entry overflows: the solution of the
# caller's system is past DBL_MAX.
fn _lext_kunscale(x, n, e) {
    _lext_kscale(x, n, e, x);
    if (_lext_vec_all_finite(x, n) == 0) { return 1; }
    return 0;
}

# GMRES(m) iterative solver for non-symmetric systems Ax = b.
# A_fn: function pointer, called as fncall1(A_fn, x_ptr) -> Ax (flat f64 array).
#       Its input is always storage hisab owns, and the vector it returns is read
#       into hisab's own storage before A_fn is called again: A_fn may return one
#       buffer it reuses on every call, or its own input pointer. hisab never writes
#       into a buffer of A_fn's own, or keeps one. ⛔ A_fn MUST NOT WRITE INTO ITS
#       INPUT, which is the current iterate or a Krylov basis vector: an in-place 2I
#       (x *= 2; return x) on b = (6, 10, 8) from x0 = 0 spends GMRES(3)'s whole
#       budget of 60 matvecs and returns about (3193, 5322, 4257) for (3, 5, 4), with
#       no report.
#       [measured: R4le probe, this tree, cycc 6.6.12, 2026-10-01]
# b:    flat f64 array of length n.
# x0:   initial guess, flat f64 array of length n.
# n:    system dimension.
# tol:  RELATIVE tolerance, finite and >= 0: x is accepted when ||b - A x||_2 <= tol ||b||_2
#       (since 3.4.0), both sides formed in the scaled frame below, so ||b|| never overflows.
#       ⚠ The test is normwise: a row of b far larger than the others decides it, and the
#       other rows' residuals can be far above tol of their own size. R2A note 2: A = [[3 2^400,
#       2^400, 0], [1, 3.5, 1], [0, 2^-400, 2^-399]], b = (2^401, 1.5, 3 2^-400), tol 1e-10 is Ok
#       from both solvers with x = (0.667, 1.9e-121, 1.5e-241), for (0.75, -0.25, 1.625). Scale
#       the rows first when each must meet tol.
#       [measured: review R2A note 2; LA3 probe n2, cycc 6.7.9, 2026-10-31]
# max_iter: maximum total matrix-vector products. COUNTED, not estimated: the probe that
#       fixes the frame is one of them, and x0 = 0 spends none on b - A x0.
# restart:  restart dimension (Krylov subspace size per cycle), clamped to [1, n].
# Returns: Ok(x), x a fresh flat f64 array of length n, when the TRUE residual b - A x,
#          formed with A_fn, meets tol; x = 0 at once for b = 0, the exact solution.
#          ⚠ "Meets" is in f64: at a tol near n 2^-52 cond(A) the exact residual can be over
#          it by the rounding of b - A x itself (2 of 23 Ok answers at tol 1e-15 on 30 random
#          12 x 12, worst 1.67 tol ||b||; none at 1e-14; seeds 2 and 3).
#          Err(HSB_ERR_NO_CONVERGENCE) when the budget ends first, when a restart cycle
#          leaves x bit for bit as it was (a breakdown it cannot move from), when a
#          residual stops being finite (A_fn returned a NaN or an overflow), when the
#          probe's A_fn(b) is not finite even at b 2^-600, or when the solution is past
#          DBL_MAX (it is finite in the frame, and overflows on the way out);
#          Err(HSB_ERR_INVALID_INPUT) / Err(HSB_ERR_ALLOC) for the arguments
#          `_lext_krylov_args` refuses, and Err(HSB_ERR_ALLOC) when a working buffer
#          cannot be allocated (the Hessenberg's (m + 1) m words included).
# ⛔ 3.4.0 — RETIRED `solve_gmres`, WHICH RETURNED THE CURRENT x WHATEVER HAPPENED: at the end of
# the budget, after a breakdown, and on its Givens estimate of the residual alone, so an
# unconverged or broken-down solve looked exactly like a converged one (roadmap D015). Its tol
# was ABSOLUTE, so a system and its 2^k-scaled copy stopped on different passes and gave
# different x. solve_gmres_checked reports every exit that is not a solution, measures tol
# against ||b||, and verifies with the true residual: the Givens estimate meeting tol ends a
# cycle, and the next cycle's b - A x decides (one more matvec than the estimate alone).
# Every operation is homogeneous in A and b and runs in a frame fixed by powers of two (3.4.0
# review), so (2^i A, 2^j b, 2^(j-i) x0) gives 2^(j-i) times the x of (A, b, x0), bit for bit.
# Measured on a 3 x 3 for both solvers: all 7303 cells of i, j in [-1020, 1020] step 20 with
# |j - i| <= 900. ⛔ Second review (R2A SF5): until A_fn's input was kept in [2^-960, 2^1000]
# (`_lext_kmv`), the claim read "wherever x and A_fn's products are representable" and was false
# above about 2^1010, where the input went subnormal: 46 of the 7303 cells differed from the
# unit solve for each solver on integ-snap9 (all at i = 1020), and near 2^-1020 an iterate
# overflowed the input (R2A's 2^-1020 [[1, 0.99], [0.99, 1]]). Outside the measured range,
# where A_fn's own products leave the normal range, it is not claimed.
# [measured: LA2 probe sw; LA3 probe ksw (2D sweep, step 20), integ-snap9 vs LA3, cycc 6.7.9, 2026-10-31]
# [measured: review REV-LA S3 (kr2.py, seeds 2 and 3, true residual in Fractions) on LA2, cycc 6.7.9, 2026-10-31]
# A caller of solve_gmres writes `var t, x = solve_gmres_checked(...)`, tests `is_ok(t)`,
# and passes a relative tol.
#must_use
public fn solve_gmres_checked(A_fn, b, x0, n, tol, max_iter, restart) {
    # (3.4.0 review: the arguments, then the scaled frame -- see `_lext_kprobe`)
    # ⛔ `n` SIZES THE VERY FIRST ALLOCATION AND WAS UNCHECKED. `_lext_copy(x0, n)`
    # does `alloc(n * 8)` and stores through it; past ALLOC_MAX that is the
    # designed 0 and the copy loop writes to address 0. Measured: n = 268,435,457
    # with restart = 2 exits **139** — i.e. it never reached the Hessenberg guard
    # below.
    # [measured: scratch harness, not reproducible in-tree, 2026-09-09; cycc 6.6.2]
    # ⭐ FOUND BY A MUTANT THAT DID NOT DIE. The Hessenberg guard was written
    # against an overflow of `(m + 1) * m * 8`; replacing it with the overflowing
    # multiply form left the suite green, which said the overflow was unreachable.
    # It is — because THIS allocation fails first on any `n` large enough to
    # overflow it. The surviving mutant was pointing at a second defect, not at a
    # redundant guard.
    var ka = _lext_krylov_args(A_fn, b, x0, n, tol, max_iter);
    if (ka != 0) { return Err(ka); }
    var x = alloc(n * 8);
    if (x == 0) { return Err(HSB_ERR_ALLOC); }
    var m = restart;
    if (m > n) { m = n; }
    if (m < 1) { m = 1; }

    # ⛔ THE HESSENBERG IS QUADRATIC IN `m` AND WAS STORED THROUGH UNCHECKED.
    # `h = alloc((m + 1) * m * 8)`; above `ALLOC_MAX` the stdlib returns its
    # designed **0** and the zeroing loop immediately writes to address 0.
    # Measured: n = 16385 with restart = 16385 asks for 2,147,893,... B against a
    # 2 GiB cap and exits **139**. ⭐ Two controls isolate the quadratic term
    # rather than the inputs: the SAME n with restart = 2 exits 0, and the same
    # restart == n shape at n = 64 exits 0.
    # [measured: scratch harness, not reproducible in-tree, 2026-09-09; cycc 6.6.2]
    #
    # ⚠ Written as a DIVISION rather than `(m + 1) * m * 8 > ALLOC_MAX`. Both are
    # correct HERE — the `n` guard above means `m` can never reach the ~1.07e9
    # needed to overflow the product, and a mutation swapping the two forms was
    # green, which is how that was established rather than assumed. The division
    # form is kept because it stays correct if that `n` guard is ever loosened.
    # Exact at the boundary, asserted both ways in the suite: m = 16383 passes
    # (2,147,352,576 B, fits) and m = 16384 is rejected (2,147,614,720 B).
    # [measured: scratch harness, not reproducible in-tree, 2026-09-09; cycc 6.6.2]
    #
    # ⚠ Through 3.3.7 this returned a designed 0 pointer (the old function had no rc);
    # ⛔ returning `x`, the untouched initial guess, was the tempting alternative and is
    # exactly the fabricated-plausible-answer class the 2026-08-11 audit filed against it.
    if (m + 1 > (ALLOC_MAX / 8) / m) { return Err(HSB_ERR_ALLOC); }

    # ⛔ 3.3.3 — THE ARNOLDI VECTOR WAS THE CALLER'S OWN BUFFER. `wj = fncall1(A_fn, vj)`
    # was orthogonalised and normalised IN PLACE and then kept as basis vector j+1: an
    # unwritten "A_fn returns a fresh buffer" contract (audit M6, 2026-04-15). An A_fn
    # that reuses one output buffer, the natural way to write a matvec, made every basis
    # vector the same pointer and was handed its own output back as input. Measured on
    # N = [[4,1,0],[-1,3,1],[0,-2,2]], b = (1.1, 2.1, 2.9), tol 1e-10, budget 60, restart
    # 3: **60 matvecs**, the whole budget, against 4 with fresh buffers, the worst
    # component of x off by 1.2e-4 relative, and the caller's buffer written 44 times
    # behind its back. An A_fn that returns its input pointer (the identity) got x = x0
    # back instead of b.
    # [measured: scratch harness, not reproducible in-tree, 2026-10-01; cycc 6.6.12]
    #
    # A_fn's result now lands in a basis slot hisab owns: the first Gram-Schmidt update
    # below reads A_fn's vector and writes the slot. ⚠ The slots are allocated LAZILY and
    # ONCE PER CALL, then reused by every restart cycle, so the cost is (m + k * n) * 8 B
    # per call for the deepest Arnoldi step k reached, never m * n * 8 up front (the abuse
    # suite's m = n = 16383 call has a 2-matvec budget). Measured with a fresh-buffer A_fn
    # on that fixture: 376 -> 472 B at restart 3 (4 matvecs), 3112 -> 3176 B at restart 2
    # (38 matvecs); the tests/hisab.tcyr arena bounds hold both properties. The slot
    # allocations are most of what the repair costs in time: 770 -> 843 ns (+9.4%) on the
    # restart-3 solve. The per-cycle buffers below are untouched by this.
    # [measured: scratch harness, not reproducible in-tree, 2026-10-01; cycc 6.6.12]
    var v_own = alloc(m * 8);
    if (v_own == 0) { return Err(HSB_ERR_ALLOC); }
    var vo = 0;
    while (vo < m) { store64(v_own + vo * 8, 0); vo = vo + 1; }

    # ⭐ 3.4.0 review — THE SCALED FRAME. ||b||_2 overflowed for a finite b (two entries of
    # 1.5e308), made the threshold +Inf, and every x0 came back Ok after one matvec, the right x
    # being b itself for A = I; and a system scaled by 2^600 (both A and b) was answered but no
    # longer bit for bit. Now b' = b 2^-eb, A' = A 2^-ea from a probe, x' = x0 2^(ea - eb), and x =
    # x' 2^(eb - ea) at the end (`_lext_kprobe`). The probe is one matvec of the budget; when x0
    # is all zeros the first residual is b' itself, which saves the A x0 matvec 3.3.7 spent.
    # [measured: review REV-LA M1 (kr1.py) and note 2 (kr3.py); LA2 probe k1, cycc 6.7.9, 2026-10-31]
    var bm = f64_from(0);
    for (var bi = 0; bi < n; bi = bi + 1) {
        var ba = f64_abs(load64(b + bi * 8));
        if (f64_gt(ba, bm) == 1) { bm = ba; }
    }
    if ((bm & 0x7FFF_FFFF_FFFF_FFFF) == 0) {
        var zi = 0;
        while (zi < n) { store64(x + zi * 8, f64_from(0)); zi = zi + 1; }
        return Ok(x);
    }
    var bs = alloc(n * 8);
    var sc = alloc(2 * n * 8);
    if (bs == 0 || sc == 0) { return Err(HSB_ERR_ALLOC); }
    var eb = _lext_xexp(bm) - 1;
    _lext_kscale(b, n, 0 - eb, bs);
    var pr: i64[2];
    var prc = _lext_kprobe(A_fn, bs, n, sc, &pr);
    if (prc == 2) { return Err(HSB_ERR_ALLOC); }
    if (prc == 1) { return Err(HSB_ERR_NO_CONVERGENCE); }
    var ea = load64(&pr);
    _lext_kscale(x0, n, ea - eb, x);
    var x0z = _lext_kzero(x0, n);

    # COUNT the matrix-vector products rather than deriving an outer-cycle bound
    # from them. Through 2.7.0 this computed
    #     outer_limit = trunc(max_iter / m) + 1
    # and then spent 1 + m products per cycle, so the true cost was
    #     (trunc(max_iter/m) + 1) * (m + 1)
    # which is neither max_iter nor a bounded multiple of it. Measured: budget 1
    # with restart 100 spent 4 products on a 3x3 system, and the ratio grows
    # without limit as restart rises relative to max_iter -- no fixed safety
    # factor fixes it.
    # [measured: CHANGELOG.md 2.7.0, solve_gmres entry: budget 1 with restart 100 spent 4 products]
    #
    # The caller's budget is a resource limit: A_fn may be arbitrarily expensive,
    # which is the whole reason it is a callback. Honouring it exactly is the
    # contract, not a nicety.
    var mv_used = load64(&pr + 8);

    # ⭐ 3.3.7 — THE CYCLE'S WORK BUFFERS ARE ALLOCATED ONCE PER CALL (roadmap D016). Through
    # 3.3.6 the restart loop allocated r, the basis pointer array, H, g, the two Givens arrays
    # and y on every cycle, 8 (n + m^2 + 5m + 2 + k) B a cycle under a bump allocator that
    # never frees. Each is now allocated on the first cycle that needs it and reused: every
    # cycle writes each entry before reading it (H and g are zeroed per cycle as before, r and
    # the basis pointers are rewritten, the Givens pairs and y are stored before they are
    # read), so every value is the same, bit for bit. A call that converges on its first
    # residual allocates what it did. tests/hisab.tcyr's arena bound on the gmres(2) run holds
    # it: 14,672 -> 2,208 B over its 20 cycles. The time does not move (solve_gmres_64_m4, 40.4
    # -> 40.2 us, inside its spread): a bump allocation is cheap, the arena it never returns is not.
    # [measured: scratch pfb/gm.cyr (alloc_used) and tests/hisab.bcyr 4-tree A/B, 2026-10-31]
    var r = 0;
    var v_basis = 0;
    var h = 0;
    var g = 0;
    var cs = 0;
    var sn = 0;
    var y = 0;
    var ycap = 0;

    # 3.4.0: the acceptance threshold, tol ||b'||, finite (||b'|| <= 2 sqrt n); b = 0 answered above
    var thr = f64_mul(tol, _lext_norm(bs, n));

    var outer = 0;
    while (mv_used < max_iter || x0z == 1) {
        if (r == 0) {
            r = alloc(n * 8);
            if (r == 0) { return Err(HSB_ERR_ALLOC); }
        }
        var si = 0;
        if (x0z == 1) {
            # x0 = 0: r = b' exactly, as b' - A' 0 would give, without the matvec
            while (si < n) { store64(r + si * 8, load64(bs + si * 8)); si = si + 1; }
            x0z = 0;
        } else {
            # r = b' - A' x
            var ax = _lext_kmv(A_fn, x, n, ea, sc);
            if (ax == 0) { return Err(HSB_ERR_ALLOC); }
            mv_used = mv_used + 1;
            while (si < n) {
                store64(r + si * 8, f64_sub(load64(bs + si * 8), load64(ax + si * 8)));
                si = si + 1;
            }
        }
        var r_norm = _lext_norm(r, n);

        # a residual that is not finite first (3.4.0 review: tested after thr, it could pass)
        if (f64_lt(r_norm, F64_POS_INF) == 0) { return Err(HSB_ERR_NO_CONVERGENCE); }
        if (f64_le(r_norm, thr) == 1) {
            if (_lext_kunscale(x, n, eb - ea) == 1) { return Err(HSB_ERR_NO_CONVERGENCE); }
            return Ok(x);
        }

        # Normalize r -> v[0]
        var inv_r = f64_div(f64_from(1), r_norm);
        var i = 0;
        while (i < n) {
            store64(r + i * 8, f64_mul(load64(r + i * 8), inv_r));
            i = i + 1;
        }

        # v_basis: array of pointers to basis vectors (up to m+1)
        if (v_basis == 0) {
            v_basis = alloc((m + 1) * 8);
            h = alloc((m + 1) * m * 8);
            g = alloc((m + 1) * 8);
            cs = alloc(m * 8);
            sn = alloc(m * 8);
            if (v_basis == 0 || h == 0 || g == 0 || cs == 0 || sn == 0) { return Err(HSB_ERR_ALLOC); }
        }
        store64(v_basis, r);

        # Hessenberg matrix H: (m+1) x m stored row-major
        i = 0;
        while (i < (m + 1) * m) { store64(h + i * 8, f64_from(0)); i = i + 1; }

        # g vector: length m+1
        i = 0;
        while (i < m + 1) { store64(g + i * 8, f64_from(0)); i = i + 1; }
        store64(g, r_norm);

        # Givens rotation coefficients (cs, sn)

        var k = 0;  # number of completed Arnoldi steps
        var j = 0;
        while (j < m) {
            # Stop mid-cycle the moment the budget is spent. The Krylov space
            # built so far is still valid, so the least-squares solve below uses
            # k steps and returns the best answer available within budget.
            if (mv_used >= max_iter) { break; }
            var vj = load64(v_basis + j * 8);
            var wj = load64(v_own + j * 8);
            if (wj == 0) {
                wj = alloc(n * 8);
                if (wj == 0) { return Err(HSB_ERR_ALLOC); }
                store64(v_own + j * 8, wj);
            }
            var aw = _lext_kmv(A_fn, vj, n, ea, sc);
            if (aw == 0) { return Err(HSB_ERR_ALLOC); }
            mv_used = mv_used + 1;

            # Modified Gram-Schmidt. Step 0 reads A_fn's vector and writes hisab's slot,
            # so the copy IS the first update rather than a pass of its own: the same
            # operations in the same order, bit-identical to copying first. A separate
            # copy pass cost a 64-dim GMRES(8) solve 6.4%; fused, 0.4%, inside 3.3.2's
            # own spread.
            # [measured: scratch harness, not reproducible in-tree, 2026-10-01; cycc 6.6.12]
            i = 0;
            while (i <= j) {
                var vi = load64(v_basis + i * 8);
                var wsrc = wj;
                if (i == 0) { wsrc = aw; }
                var hij = _lext_dot(wsrc, vi, n);
                store64(h + (i * m + j) * 8, hij);  # H[i][j]
                var l = 0;
                while (l < n) {
                    store64(wj + l * 8, f64_sub(load64(wsrc + l * 8),
                        f64_mul(hij, load64(vi + l * 8))));
                    l = l + 1;
                }
                i = i + 1;
            }

            var wj_norm = _lext_norm(wj, n);
            store64(h + ((j + 1) * m + j) * 8, wj_norm);  # H[j+1][j]

            # ⛔ `wj_norm` is a LENGTH in the caller's units against an absolute
            # 1e-12, so Arnoldi declared a perfectly good basis vector degenerate
            # and broke down early on any small system. The reciprocal on the next
            # line is unbounded, so DBL_MIN is the bound, not an exact zero.
            if (f64_lt(wj_norm, F64_TINY) == 0) {
                var inv_w = f64_div(f64_from(1), wj_norm);
                var l = 0;
                while (l < n) {
                    store64(wj + l * 8, f64_mul(load64(wj + l * 8), inv_w));
                    l = l + 1;
                }
            }
            store64(v_basis + (j + 1) * 8, wj);

            # Apply previous Givens rotations to column j of H
            i = 0;
            while (i < j) {
                var ci = load64(cs + i * 8);
                var si = load64(sn + i * 8);
                var h_ij   = load64(h + (i * m + j) * 8);
                var h_i1j  = load64(h + ((i + 1) * m + j) * 8);
                var temp = f64_add(f64_mul(ci, h_ij), f64_mul(si, h_i1j));
                store64(h + ((i + 1) * m + j) * 8,
                  f64_add(f64_mul(f64_neg(si), h_ij), f64_mul(ci, h_i1j)));
                store64(h + (i * m + j) * 8, temp);
                i = i + 1;
            }

            # Compute new Givens rotation for row j
            var hjj  = load64(h + (j * m + j) * 8);
            var hj1j = load64(h + ((j + 1) * m + j) * 8);
            # ⛔ 2.17.0 — THE GIVENS RADIUS SQUARED BEFORE SUMMING TOO, and
            # repairing `_lext_norm` alone does not move the entry point: both
            # legs are degree ONE in the caller's ||A|| (h[i][j] is a dot against
            # a UNIT basis vector, h[j+1][j] is `wj_norm`), so both reach the
            # flush band together. ⚠ In the silent middle the stored rotation is
            # not even orthogonal — `cs² + sn² != 1` — so the least-squares solve
            # downstream is wrong in a way no residual check would catch.
            # ⭐ Same fast-path shape as `hvec2_length`, whose scaled helper IS
            # `ganita_f64_hypot`.
            var r_ls = f64_add(f64_mul(hjj, hjj), f64_mul(hj1j, hj1j));
            var r_val = f64_sqrt(r_ls);
            if (f64_lt(r_ls, F64_TINY) == 1) { r_val = ganita_f64_hypot(hjj, hj1j); }
            if (f64_eq(r_ls, F64_POS_INF) == 1) { r_val = ganita_f64_hypot(hjj, hj1j); }
            # ⭐ |hjj| <= r_val and |hj1j| <= r_val, so these quotients are in
            # [-1,1] and cannot overflow at any non-zero radius — the exact-zero
            # test is what the division requires, as in linalg_precision's Givens.
            if (f64_gt(r_val, 0) == 1) {
                store64(cs + j * 8, f64_div(hjj, r_val));
                store64(sn + j * 8, f64_div(hj1j, r_val));
            } else {
                store64(cs + j * 8, f64_from(1));
                store64(sn + j * 8, f64_from(0));
            }
            store64(h + (j * m + j) * 8, r_val);
            store64(h + ((j + 1) * m + j) * 8, f64_from(0));

            # Apply new rotation to g
            var cj = load64(cs + j * 8);
            var sj = load64(sn + j * 8);
            var gj = load64(g + j * 8);
            store64(g + (j + 1) * 8, f64_mul(f64_neg(sj), gj));
            store64(g + j * 8, f64_mul(cj, gj));

            k = j + 1;

            # the estimate meeting tol ends the cycle; the next cycle's true residual decides
            if (f64_le(f64_abs(load64(g + k * 8)), thr) == 1) {
                j = m;  # break
            } else {
                j = j + 1;
            }
        }

        # Back-substitution: solve upper triangular H * y = g
        if (k > ycap) {
            y = alloc(k * 8);
            if (y == 0) { return Err(HSB_ERR_ALLOC); }
            ycap = k;
        }
        i = k - 1;
        while (i >= 0) {
            var yi = load64(g + i * 8);
            var jj = i + 1;
            while (jj < k) {
                yi = f64_sub(yi, f64_mul(load64(h + (i * m + jj) * 8), load64(y + jj * 8)));
                jj = jj + 1;
            }
            var hii = load64(h + (i * m + i) * 8);
            # ⛔ TWO DEFECTS. The absolute 1e-12 skipped the divide for a small but
            # perfectly good pivot — and when it skipped, it stored the UNDIVIDED
            # numerator as if it were the solution component. At hii = 0 the true
            # y_i is unbounded, so the numerator is not an approximation of it; 0
            # at least says "no contribution" rather than asserting a wrong one.
            if (f64_lt(f64_abs(hii), F64_TINY) == 0) {
                yi = f64_div(yi, hii);
            } else {
                yi = f64_from(0);
            }
            store64(y + i * 8, yi);
            i = i - 1;
        }

        # Update x: x += V * y
        var moved = 0;
        i = 0;
        while (i < n) {
            var xi = load64(x + i * 8);
            var xi0 = xi;
            var jj = 0;
            while (jj < k) {
                var vj_ptr = load64(v_basis + jj * 8);
                xi = f64_add(xi, f64_mul(load64(y + jj * 8), load64(vj_ptr + i * 8)));
                jj = jj + 1;
            }
            if (xi != xi0) { moved = 1; }
            store64(x + i * 8, xi);
            i = i + 1;
        }
        # A cycle that moves no component of x will be repeated exactly by the next one (the
        # same x, the same residual, the same Krylov space): a breakdown, reported (3.4.0).
        # [[0, 0], [0, 0]] x = (1, 1) ends here after 2 matvecs, where 3.3.7 returned x0 as
        # converged on the Givens estimate of its singular Hessenberg, g = -0 * g_0.
        if (moved == 0 && k > 0) { return Err(HSB_ERR_NO_CONVERGENCE); }

        outer = outer + 1;
    }

    return Err(HSB_ERR_NO_CONVERGENCE);
}

# BiCGSTAB's shadow residual: r_hat = r divided by the power of two at or below max|r_i| (exact;
# see solve_bicgstab_checked), r_hat = r when r = 0.
fn _lext_bicg_rhat(r, r_hat, n) {
    _lext_vec_copy_n(r_hat, r, n);
    var rh_mx = f64_from(0);
    for (var i = 0; i < n; i = i + 1) {
        var rh_a = f64_abs(load64(r + i * 8));
        if (f64_gt(rh_a, rh_mx) == 1) { rh_mx = rh_a; }
    }
    if (f64_gt(rh_mx, 0) == 1) {
        var rh_p = rh_mx & 0x7FF0_0000_0000_0000;
        if (rh_p == 0) {
            # A subnormal max: the power of two at or below it is its own leading bit.
            rh_p = 1 << 51;
            while ((rh_mx & rh_p) == 0) { rh_p = rh_p >> 1; }
        }
        for (var i2 = 0; i2 < n; i2 = i2 + 1) { store64(r_hat + i2 * 8, f64_div(load64(r + i2 * 8), rh_p)); }
    }
    return 0;
}

# The true residual of the frame from the product ax = A' x: rt = b' - ax, and its norm.
fn _lext_kresid(ax, bs, n, rt) {
    for (var i = 0; i < n; i = i + 1) { store64(rt + i * 8, f64_sub(load64(bs + i * 8), load64(ax + i * 8))); }
    return _lext_norm(rt, n);
}

# BiCGSTAB iterative solver for non-symmetric systems Ax = b.
# A_fn: function pointer, called as fncall1(A_fn, x_ptr) -> Ax. Its input is always
#       storage hisab owns; the A p it returns is copied before the next call, and
#       every other result is read before it, so A_fn may return one buffer it
#       reuses on every call, or its own input pointer. hisab never writes into a
#       buffer of A_fn's own. ⛔ A_fn MUST NOT WRITE INTO ITS INPUT, which is the
#       current iterate, p or s: an in-place 2I (x *= 2; return x) on b = (6, 10, 8)
#       from x0 = 0 returns (6, 10, 8) after 2 matvecs, for (3, 5, 4), with no
#       report.
#       [measured: R4le probe, 3.3.2 bundle and this tree, cycc 6.6.12, 2026-10-01]
# b:    flat f64 array of length n.
# x0:   initial guess, flat f64 array of length n.
# n:    system dimension.
# tol:  RELATIVE tolerance, finite and >= 0: x is accepted when the residual BiCGSTAB
#       carries, r or the half step's s, has ||.||_2 <= tol ||b||_2 (since 3.4.0) AND the true
#       residual b - A x, formed with A_fn, meets it too (3.4.0 review); when only the first
#       does, the run restarts from the true one. The initial b - A x0 is tested too. Both
#       sides are formed in the scaled frame below, so ||b|| never overflows. ⚠ Normwise, as
#       solve_gmres_checked's (see there: a dominant row of b decides it).
# max_iter: maximum iterations (each two matvecs). Not counted against it: the probe that fixes
#       the frame, the initial b - A x0 (none when x0 = 0) and each confirmation; a
#       confirmation that fails ends its iteration.
# Returns: Ok(x), x a fresh flat f64 array of length n, when both tests pass; x = 0 at
#          once for b = 0, the exact solution. ⚠ As GMRES's: the true residual is formed
#          in f64 (at tol 1e-15 on 30 random 12 x 12, seed 2, 8 of 29 Ok answers sit over
#          tol ||b|| by its rounding, worst 2.61 times; at 1e-14, 1 at 1.34; the recurrence
#          alone gave 15 of 30 at up to 1780 times, and 6 at up to 178).
#          Err(HSB_ERR_NO_CONVERGENCE) on every other exit: max_iter spent; a breakdown
#          (r_hat . r, r_hat . A p or omega exactly zero, or a t = A s orthogonal to s:
#          since 3.4.1 a t . s within the rigorous bound of an accurately formed dot product,
#          4 n^2 u^2 sum|t_i s_i|, where through 3.4.0 the plain sum's n u bound refused some
#          true non-zeros that converge); a residual that stops
#          being finite; a probe A_fn(b) that is not finite even at b 2^-600; a solution
#          past DBL_MAX;
#          Err(HSB_ERR_INVALID_INPUT) / Err(HSB_ERR_ALLOC) for the arguments
#          `_lext_krylov_args` refuses, and Err(HSB_ERR_ALLOC) when a working vector
#          cannot be allocated.
# ⛔ 3.4.0 — RETIRED `solve_bicgstab`, WHICH RETURNED THE CURRENT x ON EVERY EXIT: a breakdown
# returned the iterate (or, for an orthogonal t, an all-NaN x or the half step), and a stop at
# max_iter the last iterate, all unreported (roadmap D015: 941 of 43,000 runs in the 3.3.4
# sweep returned a finite wrong iterate, and the exact-zero-t stop a half step, 36 wrong of
# 549). Its tol was ABSOLUTE. solve_bicgstab_checked reports each, and measures tol against
# ||b||: every operation is homogeneous in A and b (r_hat is scaled by a power of two, the
# breakdown tests are exact zeros, omega's rescue is a ratio) and, since the 3.4.0 review,
# runs in a frame fixed by powers of two, so (2^i A, 2^j b, 2^(j-i) x0) gives 2^(j-i) times
# the x of (A, b, x0), bit for bit, for i, j in [-1020, 1020] (the 7303-cell sweep in
# solve_gmres_checked's doc; the first 3.4.0 tree excused 110 of 435 cells in [-500, 500]).
# [measured: review REV-LA S3 kr2.py, seeds 2 and 3, on integ-snap5 and LA2, cycc 6.7.9, 2026-10-31]
# A caller of solve_bicgstab writes `var t, x = solve_bicgstab_checked(...)`, tests `is_ok(t)`,
# and passes a relative tol.
#must_use
public fn solve_bicgstab_checked(A_fn, b, x0, n, tol, max_iter) {
    # ⛔ IDENTICAL DEFECT TO `solve_gmres`, and found only because that one was
    # repaired and the same shape was then grepped for rather than assumed
    # absent. `_lext_copy(x0, n)` is an unchecked `alloc(n * 8)`; past ALLOC_MAX
    # that is the designed 0 and the copy loop writes to address 0. Measured:
    # n = ALLOC_MAX / 8 + 1 exits **139**. Same guard, same designed-0 channel
    # (`tests/abuse.tcyr` already reads this function's failures as
    # `assert_neq(..., 0)`).
    # [measured: scratch harness, not reproducible in-tree, 2026-09-09; cycc 6.6.2]
    var ka = _lext_krylov_args(A_fn, b, x0, n, tol, max_iter);
    if (ka != 0) { return Err(ka); }
    var x = alloc(n * 8);
    if (x == 0) { return Err(HSB_ERR_ALLOC); }
    # ⭐ 3.4.0 review — THE SCALED FRAME, as solve_gmres_checked's (`_lext_kprobe`): b = 0 is
    # x = 0; otherwise b' = b 2^-eb, A' = A 2^-ea from a probe (not counted against max_iter,
    # which counts iterations), x' = x0 2^(ea - eb). (2^600 A, 2^600 b) was NO_CONVERGENCE on 8
    # of 8 well-conditioned 8 x 8 (A p overflowed), and A = I with b = 7.5e307 (1, 1) too.
    # [measured: review REV-LA note 2 (kr3.py); LA2 probe k1, cycc 6.7.9, 2026-10-31]
    var bm = f64_from(0);
    for (var bi = 0; bi < n; bi = bi + 1) {
        var ba = f64_abs(load64(b + bi * 8));
        if (f64_gt(ba, bm) == 1) { bm = ba; }
    }
    if ((bm & 0x7FFF_FFFF_FFFF_FFFF) == 0) {
        var zi = 0;
        while (zi < n) { store64(x + zi * 8, f64_from(0)); zi = zi + 1; }
        return Ok(x);
    }
    var bs = alloc(n * 8);
    var sc = alloc(2 * n * 8);
    var r = alloc(n * 8);
    var rt = alloc(n * 8);
    if (bs == 0 || sc == 0 || r == 0 || rt == 0) { return Err(HSB_ERR_ALLOC); }
    var eb = _lext_xexp(bm) - 1;
    _lext_kscale(b, n, 0 - eb, bs);
    var pr: i64[2];
    var prc = _lext_kprobe(A_fn, bs, n, sc, &pr);
    if (prc == 2) { return Err(HSB_ERR_ALLOC); }
    if (prc == 1) { return Err(HSB_ERR_NO_CONVERGENCE); }
    var ea = load64(&pr);
    _lext_kscale(x0, n, ea - eb, x);
    var thr = f64_mul(tol, _lext_norm(bs, n));   # finite: ||b'|| <= 2 sqrt n
    if (_lext_kzero(x0, n) == 1) {
        _lext_vec_copy_n(r, bs, n);   # b' - A' 0, without the matvec
    } else {
        var ax = _lext_kmv(A_fn, x, n, ea, sc);
        if (ax == 0) { return Err(HSB_ERR_ALLOC); }
        for (var ri = 0; ri < n; ri = ri + 1) {
            store64(r + ri * 8, f64_sub(load64(bs + ri * 8), load64(ax + ri * 8)));
        }
    }
    var r0n = _lext_norm(r, n);
    # a residual that is not finite first (3.4.0 review: tested after thr, it could pass)
    if (f64_lt(r0n, F64_POS_INF) == 0) { return Err(HSB_ERR_NO_CONVERGENCE); }
    if (f64_le(r0n, thr) == 1) {
        if (_lext_kunscale(x, n, eb - ea) == 1) { return Err(HSB_ERR_NO_CONVERGENCE); }
        return Ok(x);
    }
    # Shadow residual (fixed), divided by the power of two at or below max|r0_i|.
    # ⛔ 3.3.3 — UNSCALED, `r_hat` CARRIED THE RESIDUAL'S UNITS INTO EVERY DOT AGAINST IT,
    # so rho = r_hat . r was degree two in b and r_hat . A p degree two in b and one in A.
    # Both reached the flush band (or overflowed) long before the vectors themselves did,
    # and an exact-zero breakdown test then reads a zero the arithmetic made up.
    # ⭐ BiCGSTAB is invariant under any scaling of r_hat (alpha and beta are ratios of two
    # dots against it), and dividing by a power of two is exact, so every iterate is
    # BIT-IDENTICAL to the unscaled form wherever that one stayed in range. Measured on the
    # 2D sweep described at the breakdown tests: 2081 of 3281 cells without this, 3281 with.
    # [measured: scratch harness, not reproducible in-tree, 2026-10-01; cycc 6.6.12]
    var r_hat = alloc(n * 8);
    if (r_hat == 0) { return Err(HSB_ERR_ALLOC); }
    # ⚠ The `> 0` test is required: r = 0 (x0 already exact) has no leading bit, and the
    # subnormal loop below would never end. There is deliberately no `< +Inf` test: an
    # infinite max makes rh_p = +Inf and r_hat NaN where r is infinite, and on five Inf
    # and overflow inputs the result is the all-NaN x 3.3.2 gives, bit for bit.
    # [measured: scratch harness, not reproducible in-tree, 2026-10-01; cycc 6.6.12]
    _lext_bicg_rhat(r, r_hat, n);
    var i = 0;

    var rho   = f64_from(1);
    var alpha = f64_from(1);
    var omega = f64_from(1);

    var v = alloc(n * 8);
    var p = alloc(n * 8);
    # `s` is hoisted here with `v` and `p`. It used to be allocated INSIDE the
    # iteration loop, and alloc() is a bump allocator that NEVER frees, so every
    # pass abandoned another n*8 bytes: arena use was 8*n*(6 + 3*max_iter) rather
    # than 8*n*(7 + 2*max_iter) -- measured at n=1024, max_iter=128 as
    # 3,194,880 B before vs 2,154,496 B after (-32.6%). Same hot-loop-allocation
    # class 2.6.15 cleared out of LM and L-BFGS.
    # [measured: CHANGELOG.md 2.7.0, the solve_bicgstab arena table (n=1024, max_iter=128)]
    #
    # Deliberately NOT zero-filled below: all n slots are overwritten at the top
    # of every iteration before any read, so reuse is bit-identical.
    var s = alloc(n * 8);
    if (v == 0 || p == 0 || s == 0) { return Err(HSB_ERR_ALLOC); }
    i = 0;
    while (i < n) {
        store64(v + i * 8, f64_from(0));
        store64(p + i * 8, f64_from(0));
        i = i + 1;
    }

    # ⛔ 3.3.3 — THE THREE BREAKDOWN TESTS COMPARED DEGREE-TWO TO DEGREE-FOUR QUANTITIES
    # WITH AN ABSOLUTE 1e-18, written as the literal `0x3C32725DD1D243AC`, which is why the
    # 2026-09-09 census of `EPSILON_F64` thresholds walked past them. rho = r_hat . r,
    # r_hat . A p and t . t carry the caller's units squared or worse, so the threshold was
    # a scale chosen for one problem. On A = k[[4,1,0],[1,3,1],[0,1,2]], b = k(6,10,8),
    # x = (1,2,3), tol = k * 1e-10, 3.3.2 returned x0 for every k <= 1e-5, a wrong partial
    # iterate up to k = 10^-4.4, and was right (1e-12 relative) for 81 of the 601 decades
    # 1e-300..1e300. It also fired at UNIT scale: with tol <= 1e-17 the t . t test returned
    # the iterate BEFORE the converging half step, x = (0.98986, 1.99766, 2.95940), where
    # tol = 1e-16 gives (1, 2, 3) to an ulp.
    # [measured: scratch harness, not reproducible in-tree, 2026-10-01; cycc 6.6.12]
    #
    # Each test is now exact-zero, because the division it protects fails at zero and
    # nowhere else, and the quantities it reads are formed so they cannot flush early
    # (r_hat scaled above, omega scaled below). Measured on a 2D sweep, A = 2^ea * N and
    # b = 2^eb * c with ea, eb in [-1000, 1000] step 25, over the 3281 cells where x and
    # the caller's own A p are representable: 3.3.2 is right (1e-12 relative) in 483,
    # exact-zero tests alone in 1491, the full repair in all 3281. Wherever 3.3.2 was
    # right the answer is bit-identical. The same 601 decades, with an A_fn that forms
    # k (M x): 81 -> 310, every decade from 1e-156 to 1e153 -- and 309, from 1e-155,
    # with one that multiplies by pre-scaled entries, (k M) x; 3.3.2 has 81 either way.
    # The rest is where the caller's own A p, of order k^2, leaves the f64 range.
    # [measured: scratch harness, not reproducible in-tree, 2026-10-01; cycc 6.6.12]
    # [measured: R4le decade probe, both matvec forms, 3.3.2 bundle and this tree, cycc 6.6.12, 2026-10-01]
    #
    # (Through 2.6.11 the threshold was `f64_from(0x3C32725DD1D243AC)`, a CONVERSION
    # to 4.34e18 rather than a reinterpretation, so the first test always fired and the
    # solver returned the initial guess without iterating. The solution asserts in
    # tests/hisab.tcyr group "linalg_ext" are what a no-op cannot pass.)
    # [measured: scratch harness, not reproducible in-tree, 2026-10-01; cycc 6.6.12]
    #
    # ⭐ 3.4.0 — every breakdown below is Err(HSB_ERR_NO_CONVERGENCE): the iterate it used to
    # return is not a solution to tol (a solution would have passed a residual test first).
    var iter = 0;
    while (iter < max_iter) {
        var rho_new = _lext_dot(r_hat, r, n);

        if (f64_eq(rho_new, 0) == 1) {
            return Err(HSB_ERR_NO_CONVERGENCE);  # Breakdown: r_hat . r is exactly zero
        }
        # ⛔ 3.3.3 — omega WAS NEVER TESTED, and `alpha / omega` below divides by it. When
        # omega is exactly 0, r = s, r_hat . s is zero only up to rounding, beta is +-Inf,
        # and every later iterate is NaN. Measured with an A_fn whose first t is the zero
        # vector: without this test, 101 matvecs and a NaN x; with it, 3 matvecs and the
        # half-step iterate x0 + alpha p, bit-identical to what tol = +Inf returns. On
        # A = 2^e N, b = 2^e c it also stops 13 scales between 2^-538 and 2^-523, where
        # the caller's own A p is subnormal, at a finite stagnation iterate instead of a
        # 401-matvec NaN. Neither is right there, and the stop is as unreported as every
        # other breakdown.
        # [measured: scratch harness, not reproducible in-tree, 2026-10-01; cycc 6.6.12]
        # ⚠ WHEN omega IS EXACTLY 0 HERE. When the last t = A s was exactly zero (the
        # rescue below then leaves omega at 0), when every term of the rescue's numerator
        # is zero or below DBL_MIN and their sum is 0, or when either path's quotient
        # underflows. The fast path's t . s is never 0 (it needs |t . s| >= DBL_MIN), and
        # a t NUMERICALLY ORTHOGONAL to s never reaches this test: the rescue returns
        # first (see there). In every case here x already holds the half step
        # x + alpha p; through 3.3.7 that came back unreported, and since 3.4.0 it is an Err.
        # ⚠ THE HALF STEP IS NOT THE SOLUTION HERE. s = 0 never reaches this test: with
        # tol > 0 the s-norm test returns first, and with tol <= 0, r = s = 0 makes
        # r_hat . r = 0 and the test above returns first. So the half step's residual s
        # is non-zero, and at least tol: the zero-t fixture in hisab.tcyr gets
        # (1.41, 2.35, 1.88) for (1, 2, 3), where 3.3.2 returned x0. It stays
        # finite because NaN here makes inputs worse than 3.3.2: on 3000 systems
        # A = 2^ea M, b = 2^eb c, the 95 that stop here with t = 0 (A s underflows to
        # exactly zero) include 9 that 3.3.2 answered to 1e-9 and the half step answers
        # too. 3.4.0 reports it (Err(HSB_ERR_NO_CONVERGENCE)).
        # [measured: R5le BiCGSTAB differential, 3.3.2 bundle and this tree, cycc 6.6.12, 2026-10-01]
        if (f64_eq(omega, 0) == 1) {
            return Err(HSB_ERR_NO_CONVERGENCE);  # Stagnation: the last step could not move along s
        }

        var beta = f64_mul(f64_div(rho_new, rho), f64_div(alpha, omega));
        rho = rho_new;

        # p = r + beta * (p - omega * v)
        i = 0;
        while (i < n) {
            var pi = load64(p + i * 8);
            var vi = load64(v + i * 8);
            var ri = load64(r + i * 8);
            store64(p + i * 8, f64_add(ri, f64_mul(beta, f64_sub(pi, f64_mul(omega, vi)))));
            i = i + 1;
        }

        # v = A p, COPIED into hisab's own buffer.
        # ⛔ 3.3.3 — `v` WAS THE CALLER'S BUFFER, KEPT ACROSS THE NEXT CALL. It is read
        # again at the top of the next iteration, after `t = fncall1(A_fn, s)`, so an
        # A_fn that reuses one output buffer handed back A s where A p belonged. Nothing
        # faulted and nothing was reported: on the GMRES fixture above (max_iter 60) it
        # returned after 65 matvecs against 6 with fresh buffers, at a true residual of
        # 1.7e-9 for a tol of 1e-10, its worst component off by 1.8e-9 relative. It never
        # wrote into that buffer; it only kept it. This `v` was allocated above but, until
        # now, only ever held the first zero.
        # [measured: scratch harness, not reproducible in-tree, 2026-10-01; cycc 6.6.12]
        var av = _lext_kmv(A_fn, p, n, ea, sc);
        if (av == 0) { return Err(HSB_ERR_ALLOC); }
        i = 0;
        while (i < n) {
            store64(v + i * 8, load64(av + i * 8));
            i = i + 1;
        }

        var r_hat_v = _lext_dot(r_hat, v, n);
        if (f64_eq(r_hat_v, 0) == 1) {
            return Err(HSB_ERR_NO_CONVERGENCE);  # Breakdown: r_hat . A p is exactly zero
        }
        alpha = f64_div(rho, r_hat_v);

        # s = r - alpha * v  (buffer hoisted above the loop)
        i = 0;
        while (i < n) {
            store64(s + i * 8, f64_sub(load64(r + i * 8), f64_mul(alpha, load64(v + i * 8))));
            i = i + 1;
        }

        var s_norm = _lext_norm(s, n);
        if (f64_lt(s_norm, F64_POS_INF) == 0) { return Err(HSB_ERR_NO_CONVERGENCE); }
        var conf = 0;
        if (f64_le(s_norm, thr) == 1) {
            i = 0;
            while (i < n) {
                store64(x + i * 8, f64_add(load64(x + i * 8), f64_mul(alpha, load64(p + i * 8))));
                i = i + 1;
            }
            conf = 1;
        }
        if (conf == 1) {
            # ⭐ 3.4.0 review — CONFIRMED WITH THE TRUE RESIDUAL (see the r test below)
            var hax = _lext_kmv(A_fn, x, n, ea, sc);
            if (hax == 0) { return Err(HSB_ERR_ALLOC); }
            var hrn = _lext_kresid(hax, bs, n, rt);
            if (f64_lt(hrn, F64_POS_INF) == 0) { return Err(HSB_ERR_NO_CONVERGENCE); }
            if (f64_le(hrn, thr) == 1) {
                if (_lext_kunscale(x, n, eb - ea) == 1) { return Err(HSB_ERR_NO_CONVERGENCE); }
                return Ok(x);
            }
            # restart from it: the recurrence had drifted from b' - A' x
            _lext_vec_copy_n(r, rt, n);
            _lext_bicg_rhat(r, r_hat, n);
            rho = F64_ONE;
            alpha = F64_ONE;
            omega = F64_ONE;
            i = 0;
            while (i < n) {
                store64(v + i * 8, f64_from(0));
                store64(p + i * 8, f64_from(0));
                i = i + 1;
            }
            iter = iter + 1;
            continue;
        }

        # `t` is read only before the next call to A_fn, so it needs no copy.
        var t = _lext_kmv(A_fn, s, n, ea, sc);
        if (t == 0) { return Err(HSB_ERR_ALLOC); }

        # omega = (t . s) / (t . t), the minimiser of |s - omega t|.
        # ⛔ 3.3.3 — t . t IS A NAIVE SUM OF SQUARES, degree two in t (and t . s its
        # partner), and its 1e-18 test returned `x` WITHOUT the half step alpha p just
        # earned. Both dots stay as the fast path, bit-identical to 3.3.2 whenever each is
        # normal and finite. Otherwise omega is formed as ((t / |t|) . s) / |t|, with |t|
        # from the scaled `_lext_norm`, so nothing is squared out of range. Each of the
        # four fast-path bounds is load-bearing: dropping one costs 24 to 300 cells of the
        # 2D sweep, and taking the fast path unconditionally costs 1650. A t that is
        # exactly zero leaves omega = 0: x keeps the half step, and the omega test above
        # stops the loop.
        # [measured: scratch harness, not reproducible in-tree, 2026-10-01; cycc 6.6.12]
        # ⛔ 3.3.3 — A t NUMERICALLY ORTHOGONAL TO s CAME BACK AS A FINITE, WRONG x. Then
        # the minimiser of |s - omega t| is 0 and the stabilising step cannot move. 3.3.2
        # formed omega = t . s / t . t = 0 exactly, went on to beta = +-Inf and returned
        # NaN. Here the fast path refuses a t . s below DBL_MIN, and the rescue re-forms
        # it as a sum whose terms no longer cancel exactly, so omega came out exactly 0
        # (the stop above returned the half step) or as a rounding residue (the loop went
        # on, to a later breakdown or, by luck, convergence). On the reviewer's fixture,
        # an A_fn whose third call returns t = (-s1, s0, 0) on [[4,1,0],[1,3,1],[0,1,2]]
        # for 340 random solutions (LCG seeds 99 and 7, tol 1e-10), x came back finite
        # and wrong in 225 runs, 0.07 to 54 relative off and unreported, and right in
        # 115; 3.3.2 returned NaN in 330 and a wrong x in 10.
        # [measured: R5le probe, 3.3.2 bundle, the tree before this repair and this tree, cycc 6.6.12, 2026-10-01]
        # ⭐ So the rescue asks whether its numerator is distinguishable from zero:
        # |sum| <= n 2^-52 sum|term| bounds the rounding of an n-term dot product of
        # exactly orthogonal vectors (each term carries at most two roundings, the sum
        # n - 1). It is asked only when some term is at least DBL_MIN: below it a term
        # has lost its relative precision, and a numerator whose terms are all zero is
        # structural, not a cancellation. (A sum of |term|s that overflows makes the
        # bound +Inf, so such a step is reported as well.) When the numerator is zero to
        # rounding the step is a breakdown: 3.3.3-3.3.7 returned an all-NaN x, 3.3.2's loud
        # answer (or, with |s| <= 2^-52 |r0|, the half step), and 3.4.0 returns
        # Err(HSB_ERR_NO_CONVERGENCE). All 340 fixture runs stop there after 3 matvecs.
        # Measured against the shipped 3.3.2 on 57800 runs of 13 families (the
        # orthogonal-t and zero-t fakes, diagonally dominant, general, skew + 0.01 I,
        # singular, zero-diagonal cyclic, and each scaled by 2^ea, 2^eb with ea, eb in
        # [-1000, 1000]; tol 1e-10, 1e-9, 1e-17 and 0): this test makes no answer that
        # 3.3.2 gave to 1e-9 come back NaN or wrong, and no NaN of 3.3.2's come back
        # finite and wrong. Of the 2256 runs where the tree before it returned a finite,
        # wrong x for 3.3.2's NaN, it turns 2068 back into NaN; the other 188 (scaled
        # singular, skew and general systems) end elsewhere, bit-identical to before. Outside
        # the fakes it changes 19 runs: 15 singular systems become NaN (3.3.2: NaN or
        # wrong) and 4 stay right. ⚠ THE COST, as plainly: 921 fake-t runs that the tree
        # before it answered right, because a rounding residue let the loop go on, now
        # return NaN; 3.3.2 returned NaN or a wrong x in every one.
        # [measured: R5le BiCGSTAB differential, 3.3.2, pre-repair and this tree, cycc 6.6.12, 2026-10-01]
        # (3.3.3-3.3.7) Both conditions were load-bearing. Without the |s| one (gone in 3.4.0,
        # where a stop that does not meet tol is reported whatever |s| is), a skew 4x4 system
        # (entries near 1e-36, b near 1e61, tol 0), right on 3.3.2 after 25 matvecs and
        # on the tree before this test after 244, came back NaN at the 239th, where the
        # stagnated iterate meets an orthogonal t. Without the DBL_MIN one,
        # [[0,1],[3,0]] x = (5,1) at tol 0, whose second t has a zero term against every
        # non-zero s_i, came back NaN for the right (1/3, 5).
        # [measured: R5le BiCGSTAB differential and variant runs, cycc 6.6.12, 2026-10-01]
        # ⚠ 3.4.0 review — NEITHER FIXTURE DISTINGUISHES THEM NOW (REV-LA S1): each ends in an
        # Err either way. The n is pinned again by a fixture where it decides Ok against Err (a
        # t . s at 2^-51 of its term sum: n 2^-52 refuses at the 3rd matvec, 2^-52 goes on and
        # converges at the 9th; modules_b.tcyr, "3.4.0 review: the Krylov frame"). On 40,000
        # runs of that injected-t family dropping n changes 117: 107 end in the same Err later,
        # 10 are answered to tol, a cost of the bound being a rounding bound. The DBL_MIN
        # condition changed none (tol 0 included) and is verdict-equivalent here: every term
        # below DBL_MIN needs |s| under about 2^-1022 in a frame where max|b'_i| is in [1, 2).
        # [measured: LA2 probe s1f, 40,000 injected-t runs with and without each, cycc 6.7.9, 2026-10-31]
        var t_dot_s = _lext_dot(t, s, n);
        var t_dot_t = _lext_dot(t, t, n);
        var om_fast = 0;
        if (f64_lt(t_dot_t, F64_TINY) == 0 && f64_lt(t_dot_t, F64_POS_INF) == 1) {
            var om_ats = f64_abs(t_dot_s);
            if (f64_lt(om_ats, F64_TINY) == 0 && f64_lt(om_ats, F64_POS_INF) == 1) { om_fast = 1; }
        }
        if (om_fast == 1) {
            omega = f64_div(t_dot_s, t_dot_t);
        } else {
            var t_norm = _lext_norm(t, n);
            omega = f64_from(0);
            # ⛔ 3.3.4 — |t| CAN PASS DBL_MAX WHILE EVERY t_i IS FINITE (sqrt(n) max|t_i|), and
            # the rescue then divided by +Inf: every term (t_i / |t|) s_i was 0, omega was 0,
            # and the omega test returned the half step with |r| = |r0|, unreported. Now t is
            # divided by the power of two at or below max|t_i| instead, and omega takes the sum
            # of the squared quotients as its denominator. On 53000 runs of the krylov
            # differential (43000 at scales 2^-1000..2^1000, 10000 with A b near 2^1005..2^1030)
            # it changes 149, all finite and wrong on 3.3.3 where 3.3.2 gave NaN: 9 are right,
            # 135 NaN again, 5 still wrong. An infinite t_i keeps the old path (NaN either way).
            # [measured: krylov BiCGSTAB differentials, exact Fractions oracle, cycc 6.6.14, 2026-10-03]
            var om_den = F64_ONE;
            if (f64_eq(t_norm, F64_POS_INF) == 1) {
                var tn_mx = f64_from(0);
                i = 0;
                while (i < n) {
                    var tn_a = f64_abs(load64(t + i * 8));
                    if (f64_gt(tn_a, tn_mx) == 1) { tn_mx = tn_a; }
                    i = i + 1;
                }
                if (f64_lt(tn_mx, F64_POS_INF) == 1) {
                    t_norm = tn_mx & 0x7FF0_0000_0000_0000;
                    om_den = f64_from(0);
                    i = 0;
                    while (i < n) {
                        var tn_q = f64_div(load64(t + i * 8), t_norm);
                        om_den = f64_add(om_den, f64_mul(tn_q, tn_q));
                        i = i + 1;
                    }
                }
            }
            if (f64_eq(t_norm, 0) == 0) {
                var om_us = f64_from(0);
                var om_ab = f64_from(0);   # sum of |term|: the numerator's rounding scale
                var om_pm = f64_from(0);   # largest |term|
                i = 0;
                while (i < n) {
                    var om_pr = f64_mul(f64_div(load64(t + i * 8), t_norm), load64(s + i * 8));
                    om_us = f64_add(om_us, om_pr);
                    var om_pa = f64_abs(om_pr);
                    om_ab = f64_add(om_ab, om_pa);
                    if (f64_gt(om_pa, om_pm) == 1) { om_pm = om_pa; }
                    i = i + 1;
                }
                omega = f64_div(f64_div(om_us, om_den), t_norm);
                if (f64_lt(om_pm, F64_TINY) == 0) {
                    var om_u52 = (1023 - 52) << 52;   # 2^-52
                    if (f64_le(f64_abs(om_us), f64_mul(f64_mul(f64_from(n), om_u52), om_ab)) == 1) {
                        # ⭐ 3.4.0 — a breakdown, reported. Through 3.3.7 this returned the half
                        # step x + alpha p when |s| <= 2^-52 |r0| and an all-NaN x otherwise; the
                        # half step meeting tol has already returned Ok above.
                        # ⛔ 3.4.1 — BUT THE BOUND ABOVE IS A ROUNDING BOUND: inside it t . s may
                        # be a true non-zero the rounded sum cannot see (10 of 40,000 injected-t
                        # runs refused here converged without the n; roadmap [3.4.1]). So the
                        # numerator is formed again, accurately (`_lext_dot_acc`: t and s scaled
                        # by powers of two, Dekker products, a compensated sum), and only one
                        # within that sum's own rigorous bound (n^2 u^2 of the term sum, plus the
                        # flushed parts) is a breakdown; otherwise omega takes it. On 20,000
                        # injected-t runs (3 x 3, entries 2^-700..2^-450, b 2^-600..2^-350, t
                        # orthogonal to 2^-40..2^-60 at matvec 3..9, tol 1e-10..0) 170 refusals
                        # became answers, 165 within tol in exact arithmetic and 5 (tol <= 1e-14)
                        # at a relative residual under 1e-12, the true-residual check's own floor
                        # (102 of the 7,452 answers 3.4.0 gave sit there too); every 3.4.0 answer
                        # is bit for bit the same, and none became a refusal.
                        # [measured: LA probe kinj (Fraction residuals), 3.4.0 base and this tree, 2026-10-31]
                        var om_acc = _lext_dot_acc(t, s, n);
                        if (f64_eq(om_acc, 0) == 1) { return Err(HSB_ERR_NO_CONVERGENCE); }
                        omega = om_acc;
                    }
                }
            }
        }

        # x += alpha * p + omega * s
        i = 0;
        while (i < n) {
            store64(x + i * 8, f64_add(load64(x + i * 8),
                f64_add(f64_mul(alpha, load64(p + i * 8)),
                  f64_mul(omega, load64(s + i * 8)))));
            i = i + 1;
        }

        # r = s - omega * t
        i = 0;
        while (i < n) {
            store64(r + i * 8, f64_sub(load64(s + i * 8), f64_mul(omega, load64(t + i * 8))));
            i = i + 1;
        }

        var r_norm = _lext_norm(r, n);
        if (f64_lt(r_norm, F64_POS_INF) == 0) { return Err(HSB_ERR_NO_CONVERGENCE); }
        if (f64_le(r_norm, thr) == 1) {
            # ⭐ 3.4.0 review — CONFIRMED WITH THE TRUE RESIDUAL b' - A' x (one matvec, not an
            # iteration), as GMRES confirms its Givens estimate. The recurrence's r can sit orders
            # of magnitude under it at a small tol: on 30 random 12 x 12 at tol 1e-14, 6 answers came
            # back Ok with a true residual up to 178 tol ||b||, 16 at 1e-15. When it fails the run
            # restarts from it (a fresh r_hat), on the iterations left.
            # [measured: review REV-LA S3 (kr2.py: true residual in Fractions); LA2 probe k2, cycc 6.7.9, 2026-10-31]
            var cax = _lext_kmv(A_fn, x, n, ea, sc);
            if (cax == 0) { return Err(HSB_ERR_ALLOC); }
            var crn = _lext_kresid(cax, bs, n, rt);
            if (f64_lt(crn, F64_POS_INF) == 0) { return Err(HSB_ERR_NO_CONVERGENCE); }
            if (f64_le(crn, thr) == 1) {
                if (_lext_kunscale(x, n, eb - ea) == 1) { return Err(HSB_ERR_NO_CONVERGENCE); }
                return Ok(x);
            }
            _lext_vec_copy_n(r, rt, n);
            _lext_bicg_rhat(r, r_hat, n);
            rho = F64_ONE;
            alpha = F64_ONE;
            omega = F64_ONE;
            i = 0;
            while (i < n) {
                store64(v + i * 8, f64_from(0));
                store64(p + i * 8, f64_from(0));
                i = i + 1;
            }
        }

        iter = iter + 1;
    }

    return Err(HSB_ERR_NO_CONVERGENCE);
}

# Projected Gauss-Seidel (PGS) for contact/constraint solvers.
# Solves A*x = b subject to lo[i] <= x[i] <= hi[i].
# A:   stdlib matrix (at least n x n, via ganita_mat_get); x must not overlap its storage.
# b:   flat f64 array of length n.
# x:   flat f64 array of length n (initial guess, modified in place).
# n:   system dimension.
# lo:  flat f64 array of lower bounds (length n); -Inf for none.
# hi:  flat f64 array of upper bounds (length n); +Inf for none.
# max_iter: maximum sweeps.
# Returns: Ok(0) when a sweep moves no x_i by 1e-12 of max|x|: the solution is in x, and every
#            x_i is finite. Since 3.4.1 that test is relative at every scale: a problem whose
#            solution (estimated as the largest |b_i / a_ii| and |x_i|) is below 2^-960 is swept
#            in a frame 2^sh up (exact) and x rounded once on the way out, and the floor under
#            the test, which lets x = 0 stop, is 4 * 2^-1074 (through 3.4.0 DBL_MIN, which
#            stopped such a problem after one sweep, up to 175% off).
#          Err(HSB_ERR_INVALID_INPUT), before anything is written, for a null A, b, x, lo or
#            hi, n <= 0, max_iter <= 0, an A smaller than n x n, a NaN or infinite entry in
#            A's n x n block, in b or in x, a NaN bound, lo_i = +Inf, hi_i = -Inf, or
#            lo_i > hi_i (an empty box: no solution);
#          Err(HSB_ERR_SINGULAR_PIVOT), before anything is written, for a diagonal entry that
#            is exactly 0 (either sign): Gauss-Seidel cannot solve that row for x_i;
#          Err(HSB_ERR_NO_CONVERGENCE) when max_iter sweeps end without the stopping test (x
#            then holds the last sweep, which is not a solution);
#          Err(HSB_ERR_ALLOC) when the private copies of b, lo and hi (and, since 3.4.1, their
#            frame copies) cannot be allocated.
#          x may be the same storage as b, lo or hi, whole or in part: they are copied before
#          x is written.
# ⛔ 3.4.0 review — RETIRED `solve_pgs`, WHICH RETURNED 0 FOR EVERY OUTCOME: an unconverged
# stop (the fabricated answer the 2026-08-11 audit lists), a skipped zero-diagonal row whose
# x_i kept the caller's guess, non-finite input that reached x or was clamped away (its doc
# listed six such cases and said the list was not exhaustive), and an x passed as b, which it
# overwrote while still reading it every sweep: A = [[5,1,1],[1,3,0],[1,0,2]], b = (11, 7, 9),
# bounds +-1000, max_iter 50, x = b returned 0 and about (-3.7e-8, 2.4e-8, 6.7e-8), and x = lo
# returned 0 and (402.2, -131.7, -196.6), where the solution is (1, 2, 4); max_iter 1 returned
# 0 and (-1, 2.67, 5). Each aliased call now matches the same call on separate storage bit for
# bit, and max_iter 1 is NO_CONVERGENCE. The first 3.4.0 tree also returned a raw -10 for a
# null handle, from a function documented as returning 0. A caller writes
# `var t, e = solve_pgs_checked(...)` and tests `is_ok(t)`.
# [measured: LA2 probe p1g, the AU1 F-A1 repro on integ-snap5 and on LA2, cycc 6.7.9, 2026-10-31]
#must_use
public fn solve_pgs_checked(A, b, x, n, lo, hi, max_iter) {
    if (A == 0 || b == 0 || x == 0 || lo == 0 || hi == 0) { return Err(HSB_ERR_INVALID_INPUT); }
    if (n <= 0 || max_iter <= 0) { return Err(HSB_ERR_INVALID_INPUT); }
    if (ganita_mat_rows(A) < n || ganita_mat_cols(A) < n) { return Err(HSB_ERR_INVALID_INPUT); }
    if (n > ALLOC_MAX / 8) { return Err(HSB_ERR_ALLOC); }
    var zp = 0;
    for (var i = 0; i < n; i = i + 1) {
        if (f64_lt(f64_abs(load64(b + i * 8)), F64_POS_INF) == 0) { return Err(HSB_ERR_INVALID_INPUT); }
        if (f64_lt(f64_abs(load64(x + i * 8)), F64_POS_INF) == 0) { return Err(HSB_ERR_INVALID_INPUT); }
        var l = load64(lo + i * 8);
        var h = load64(hi + i * 8);
        # a NaN bound fails every compare, so each test below refuses it too
        if (f64_lt(l, F64_POS_INF) == 0) { return Err(HSB_ERR_INVALID_INPUT); }
        if (f64_lt(f64_sub(0, h), F64_POS_INF) == 0) { return Err(HSB_ERR_INVALID_INPUT); }
        if (f64_le(l, h) == 0) { return Err(HSB_ERR_INVALID_INPUT); }
        for (var j = 0; j < n; j = j + 1) {
            if (f64_lt(f64_abs(ganita_mat_get(A, i, j)), F64_POS_INF) == 0) { return Err(HSB_ERR_INVALID_INPUT); }
        }
        if (f64_eq(ganita_mat_get(A, i, i), 0) == 1) { zp = 1; }
    }
    if (zp == 1) { return Err(HSB_ERR_SINGULAR_PIVOT); }
    var bb = alloc(n * 8);
    var ll = alloc(n * 8);
    var hh = alloc(n * 8);
    if (bb == 0 || ll == 0 || hh == 0) { return Err(HSB_ERR_ALLOC); }
    _lext_vec_copy_n(bb, b, n);
    _lext_vec_copy_n(ll, lo, n);
    _lext_vec_copy_n(hh, hi, n);
    # ⭐ 3.4.1 — A PROBLEM BELOW 2^-960 IS SOLVED IN A FRAME 2^sh UP. Its solution's scale is
    # estimated as the largest of |b_r / a_rr| and |x_r| (by exponents); below 2^-960, x, b, lo
    # and hi are multiplied by 2^sh, which brings it to about 1 and is exact (a bound may overflow
    # to +-Inf there: it lies past DBL_MAX 2^-sh, where no finite frame value reaches). Gauss-Seidel
    # is invariant under it, so the sweeps run in the normal range, stop on the same relative test,
    # and x is rounded once on the way out. Without it the sweeps run on the subnormal grid, whose
    # spacing passes 1e-12 of |x| below about 2^-1034, and cycle there. A frame value at 2^1000 or
    # past (a solution 2^1000 past the estimate) leaves the frame: x is scaled back and the sweep
    # is run again in the caller's units, on the same budget.
    # [measured: LA probe pgs2 (300 systems, n 2..6, b at 2^-1030..2^-1060), this tree, cycc 6.7.18, 2026-10-31]
    var sh = 0;
    var rb = bb;
    var rl = ll;
    var rh = hh;
    var fe = 0 - 100000;
    var be = 0 - 100000;
    for (var fr = 0; fr < n; fr = fr + 1) {
        var fb = load64(bb + fr * 8);
        var fx = load64(x + fr * 8);
        if ((fb & 0x7FFF_FFFF_FFFF_FFFF) != 0) {
            var e1 = _lext_xexp(fb) - _lext_xexp(ganita_mat_get(A, fr, fr)) + 1;
            if (e1 > fe) { fe = e1; }
            if (_lext_xexp(fb) > be) { be = _lext_xexp(fb); }
        }
        if ((fx & 0x7FFF_FFFF_FFFF_FFFF) != 0) {
            if (_lext_xexp(fx) > fe) { fe = _lext_xexp(fx); }
            if (_lext_xexp(fx) > be) { be = _lext_xexp(fx); }
        }
    }
    if (fe > 0 - 100000 && fe < 0 - 960) {
        sh = 0 - fe;
        if (sh > 1020 - be) { sh = 1020 - be; }
        if (sh > 0) {
            rb = alloc(n * 8);
            rl = alloc(n * 8);
            rh = alloc(n * 8);
            if (rb == 0 || rl == 0 || rh == 0) { return Err(HSB_ERR_ALLOC); }
            for (var fs = 0; fs < n; fs = fs + 1) {
                store64(x + fs * 8, _lext_pow2mul(load64(x + fs * 8), sh));
                store64(rb + fs * 8, _lext_pow2mul(load64(bb + fs * 8), sh));
                store64(rl + fs * 8, _lext_pow2mul(load64(ll + fs * 8), sh));
                store64(rh + fs * 8, _lext_pow2mul(load64(hh + fs * 8), sh));
            }
        } else {
            sh = 0;
        }
    }
    var iter = 0;
    while (iter < max_iter) {
        var max_change = f64_from(0);
        var r = 0;
        while (r < n) {
            var sigma = load64(rb + r * 8);
            var c = 0;
            while (c < n) {
                if (c != r) {
                    sigma = f64_sub(sigma, f64_mul(ganita_mat_get(A, r, c), load64(x + c * 8)));
                }
                c = c + 1;
            }
            var gs_x = f64_div(sigma, ganita_mat_get(A, r, r));
            if (sh != 0 && f64_lt(f64_abs(gs_x), 0x7E70000000000000) == 0) {   # 2^1000, or not finite
                # leave the frame (see above): x scaled back, this sweep run again unscaled
                for (var fu = 0; fu < n; fu = fu + 1) {
                    store64(x + fu * 8, _lext_pow2mul(load64(x + fu * 8), 0 - sh));
                }
                sh = 0;
                rb = bb;
                rl = ll;
                rh = hh;
                r = 0 - 1;
                break;
            }
            var new_x = f64_clamp(gs_x, load64(rl + r * 8), load64(rh + r * 8));
            var change = f64_abs(f64_sub(new_x, load64(x + r * 8)));
            # A finite input can still overflow (a divergent sweep): a NaN change is
            # kept, so the stopping test below never passes on it.
            if (f64_gt(change, max_change) == 1 || f64_eq(change, change) == 0) { max_change = change; }
            store64(x + r * 8, new_x);
            r = r + 1;
        }
        if (r < 0) { continue; }   # left the frame: the sweep again, unscaled, on the same budget
        # ⛔ `max_change` is a change in the SOLUTION, in the caller's units — an
        # impulse in a contact solver — so an absolute 1e-12 declared convergence
        # after one sweep on a small problem and refused to converge on a large
        # one. ⚠ Nothing DIVIDES here, so DBL_MIN would be meaningless: the
        # question is whether the iterate has stopped moving RELATIVE to its own
        # size. A floor keeps an exactly-zero solution terminating (3.4.1: see below).
        var x_mag = f64_from(0);
        var xm = 0;
        while (xm < n) {
            var xv = f64_abs(load64(x + xm * 8));
            if (f64_gt(xv, x_mag) == 1) { x_mag = xv; }
            xm = xm + 1;
        }
        # ⛔ 3.4.1 — THE FLOOR WAS DBL_MIN, an absolute tolerance in force wherever 1e-12 max|x|
        # is below it: [[4, 1], [1, 3]], b = (1, 2) 2^-1030 stopped after one sweep at
        # (0000040000000000, 0000095555555555), exact (1, 7)/11 2^-1030 = (000001745D1745D1,
        # 00000A2E8BA2E8BA), 175% off. Such a problem now runs in the frame above; the floor that
        # stays, for an iterate that falls below 2^-982 in the caller's units, is four units of
        # the subnormal grid (an x that stops moving there passes it, x = 0 included). From
        # 2^-982 up the test is the old one, bit for bit.
        # [measured: LA probes pgs, pgs2, 3.4.0 base and this tree, cycc 6.7.18, 2026-10-31]
        var pgs_tol = f64_mul(EPSILON_F64, x_mag);
        if (f64_lt(pgs_tol, 4) == 1) { pgs_tol = 4; }   # 4 * 2^-1074
        if (f64_lt(max_change, pgs_tol) == 1) {
            if (sh != 0) {
                for (var fo = 0; fo < n; fo = fo + 1) {
                    store64(x + fo * 8, _lext_pow2mul(load64(x + fo * 8), 0 - sh));
                }
            }
            return Ok(0);
        }
        iter = iter + 1;
    }
    if (sh != 0) {
        # the last sweep, in the caller's units (see the frame above)
        for (var fn2 = 0; fn2 < n; fn2 = fn2 + 1) {
            store64(x + fn2 * 8, _lext_pow2mul(load64(x + fn2 * 8), 0 - sh));
        }
    }
    return Err(HSB_ERR_NO_CONVERGENCE);
}

# ================================================================
# Section 3 -- SVD (wrappers around ganita's ganita_mat_svd; svd_golub_kahan
#              answers when ganita gives no answer: its -1 since 3.3.4, its -3
#              and a non-finite singular value since 3.3.7)
# ================================================================

# 1 when every entry of the rows x cols matrix A is finite, 0 otherwise.
# ⛔ 3.3.3 — ganita_mat_svd DOES NOT REFUSE A NON-FINITE A, IT ANSWERS FOR IT. It
# scales A by its largest |entry|, found with an ordered compare that never takes
# a NaN, so an all-NaN 2x2 A has scale 0, takes ganita's all-zeros branch and
# returns 0 with both singular values exactly 0: NaN in, success and S = 0 out.
# [[3, NaN], [0, 2]] returned 0 with S = (3, NaN), and [[-Inf, 0], [0, 2]] returned
# 0 with S = (NaN, NaN). A non-finite entry leaves A with no SVD at all, so
# svd_compute_checked and svd_truncated refuse it, as svd_golub_kahan has since 2.22.0.
# [measured: G2a probe on the 3.3.2 bundle, cycc 6.6.12, 2026-10-01]
# ⚠ ganita 1.2.12 refuses one itself (-2; cyrius 6.6.16 folds 1.2.13). The check stays:
# a consumer compiles this bundle against its own pin's ganita, 1.2.11 or older below 6.6.16.
# ⭐ One `f64_lt(|x|, +Inf) == 0` catches +Inf, -Inf and NaN together. This is
# linalg_precision's `_lp_mat_all_finite` again; that one sits later in the
# bundle and is that module's own, so it cannot be called from here.
#must_use
fn _lext_mat_all_finite(A, rows, cols) {
    var i = 0;
    while (i < rows) {
        var j = 0;
        while (j < cols) {
            if (f64_lt(f64_abs(ganita_mat_get(A, i, j)), F64_POS_INF) == 0) { return 0; }
            j = j + 1;
        }
        i = i + 1;
    }
    return 1;
}

# 1 when every one of v[0..n) is finite, 0 otherwise -- for ganita's singular values,
# which 1.2.12 can return as +Inf with status 0 (see svd_compute_checked).
#must_use
fn _lext_vec_all_finite(v, n) {
    var i = 0;
    while (i < n) {
        if (f64_lt(f64_abs(load64(v + i * 8)), F64_POS_INF) == 0) { return 0; }
        i = i + 1;
    }
    return 1;
}

# dst[0..n) = src[0..n), bit for bit.
fn _lext_vec_copy_n(dst, src, n) {
    var i = 0;
    while (i < n) {
        store64(dst + i * 8, load64(src + i * 8));
        i = i + 1;
    }
    return 0;
}

# ---- 3.3.7: a singular value at the overflow line, in ganita's answer ----
# These three are linalg_precision's `_lp_two_sum`, `_lp_two_prod` and `_lp_sv_past_max`,
# copied line for line (the same reason as `_lext_mat_all_finite` above): that module sits
# later in the bundle and its `_` names are its own, and a patch release adds no public name.
# Keep the copies in step with the originals; `_lp_sv_past_max`'s comment has the bound.
# a + b = s + e (Knuth's TwoSum) and a b = p + e (Dekker's product on Veltkamp's split, exact
# while |a|, |b| <= 2^995 and a b is not below about 2^-969), each pair to out and out + 8.
fn _lext_two_sum(a, b, out) {
    var s = f64_add(a, b);
    var bb = f64_sub(s, a);
    store64(out, s);
    store64(out + 8, f64_add(f64_sub(a, f64_sub(s, bb)), f64_sub(b, bb)));
    return 0;
}
fn _lext_two_prod(a, b, out) {
    var p = f64_mul(a, b);
    var ca = f64_mul(0x41A0000002000000, a);   # (2^27 + 1) a
    var ah = f64_sub(ca, f64_sub(ca, a));
    var al = f64_sub(a, ah);
    var cb = f64_mul(0x41A0000002000000, b);
    var bh = f64_sub(cb, f64_sub(cb, b));
    var bl = f64_sub(b, bh);
    var e = f64_add(f64_add(f64_sub(f64_mul(ah, bh), p), f64_mul(ah, bl)), f64_mul(al, bh));
    store64(out, p);
    store64(out + 8, f64_add(e, f64_mul(al, bl)));
    return 0;
}
# 1 when column k of U and row k of Vt prove that the m x n A has a singular value past the
# overflow line 2^1024 - 2^970: the Rayleigh quotient 2 u'Av / (u'u + v'v) of
# [[0, A], [A', 0]] is at most sigma_1 for ANY u and v, so it holds for ganita's vectors as
# for svd_golub_kahan's. buf: 32 bytes of scratch.
fn _lext_sv_past_max(A, m, n, U, Vt, k, buf) {
    var nh = f64_from(0);
    var nl = f64_from(0);
    var dh = f64_from(0);
    var dl = f64_from(0);
    var sab = f64_from(0);
    for (var i = 0; i < m + n; i = i + 1) {
        var x = 0;
        if (i < m) { x = ganita_mat_get(U, i, k); } else { x = ganita_mat_get(Vt, k, i - m); }
        _lext_two_prod(x, x, buf);
        _lext_two_sum(dh, load64(buf), buf + 16);
        dh = load64(buf + 16);
        dl = f64_add(dl, f64_add(load64(buf + 24), load64(buf + 8)));
    }
    for (var i = 0; i < m; i = i + 1) {
        var ui = ganita_mat_get(U, i, k);
        for (var j = 0; j < n; j = j + 1) {
            _lext_two_prod(ui, ganita_mat_get(Vt, k, j), buf);   # u_i v_j = th + tl
            var th = load64(buf);
            var tl = load64(buf + 8);
            var a = f64_mul(ganita_mat_get(A, i, j), 0x3BF0000000000000);   # a_ij 2^-64
            _lext_two_prod(a, th, buf);
            var pl = f64_add(load64(buf + 8), f64_mul(a, tl));
            _lext_two_sum(nh, load64(buf), buf + 16);
            nh = load64(buf + 16);
            nl = f64_add(nl, f64_add(load64(buf + 24), pl));
            sab = f64_add(sab, f64_abs(load64(buf)));
        }
    }
    _lext_two_sum(nh, nl, buf);
    nh = load64(buf);
    nl = load64(buf + 8);
    _lext_two_sum(dh, dl, buf);
    dh = load64(buf);
    dl = load64(buf + 8);
    if (f64_gt(dh, 0) == 0) { return 0; }
    # q / 2 = q1 + q2 = (nh + nl) / (dh + dl), the remainder taken against q1 (dh + dl) exactly
    var q1 = f64_div(nh, dh);
    _lext_two_prod(q1, dh, buf);
    var r = f64_sub(f64_add(f64_sub(f64_sub(nh, load64(buf)), load64(buf + 8)), nl), f64_mul(q1, dl));
    var q2 = f64_div(r, dh);
    # doubling is exact: |q| <= sigma_1 2^-64 <= sqrt(mn) 2^960, and a subnormal doubles exactly
    q1 = f64_mul(q1, F64_TWO);
    q2 = f64_mul(q2, F64_TWO);
    # (q1 - 2^960) is exact wherever the comparison is close (Sterbenz)
    var past = f64_add(f64_add(f64_sub(q1, 0x7BF0000000000000), q2), 0x7890000000000000);   # - 2^960, + 2^906
    var nn = f64_add(f64_from(m * n + m + n), f64_from(4));
    var rel = f64_add(f64_mul(F64_TWO, f64_div(sab, dh)), F64_ONE);
    var bnd = f64_mul(f64_mul(f64_mul(nn, nn), 0x39B0000000000000), rel);   # 2^-100
    return f64_gt(past, bnd);
}

# 1 when ganita's answer (U m x n, S[0..n), Vt n x n) has a singular value within 2^-40 of
# the line that its own singular pair proves past it (see svd_compute_checked).
fn _lext_svd_past_line(A, m, n, U, S, Vt) {
    var w: i64[4];
    for (var i = 0; i < n; i = i + 1) {
        if (f64_ge(load64(S + i * 8), 0x7FEFFFFFFFFFE000) == 1) {   # (1 - 2^-40) 2^1024
            if (_lext_sv_past_max(A, m, n, U, Vt, i, &w) == 1) { return 1; }
        }
    }
    return 0;
}

# Full SVD: A = U * diag(S) * Vt.
# A:      stdlib matrix (m x n, m >= n).
# out_U:  stdlib matrix (m x n, caller allocates via ganita_mat_new).
# out_S:  flat f64 array of length n (caller allocates via alloc(n*8)).
# out_Vt: stdlib matrix (n x n, caller allocates via ganita_mat_new).
# Returns: Ok(0) on success, with ganita's answer or, where ganita gives none (below),
#            svd_golub_kahan's;
#          Err(HSB_ERR_INVALID_INPUT) for a null A or out-param, a WIDE A (m < n), an
#            out_U / out_Vt whose shape is not exactly m x n / n x n, or a NaN or
#            infinite entry in A, all refused before anything is written;
#          Err(HSB_ERR_ALLOC) when its n-slot scratch cannot be allocated, or ganita
#            gives no answer and svd_golub_kahan cannot allocate either;
#          Err(HSB_ERR_NO_CONVERGENCE) when ganita gives no answer and svd_golub_kahan
#            does not converge (which includes a singular value above DBL_MAX), or when
#            ganita's answer has a singular value its own singular pair proves past the
#            rounding line (since 3.3.7; no fallback is tried, see below).
#          On any Err out_S is untouched; on ALLOC and NO_CONVERGENCE out_U and out_Vt may
#          hold ganita's or the fallback's partial work.
# ⛔ 3.4.0 — RETIRED `svd_compute`, WHICH RETURNED ganita_mat_svd's STATUS VOCABULARY:
# 0, -1 or -2 as bare integers, bit-identical to HSB_ERR_INVALID_TRANSFORM and
# HSB_ERR_SINGULAR_MATRIX, and -1 for an allocation failure, a fallback that did not
# converge and a sigma proven past the line alike. svd_compute_checked returns the hisab
# codes svd_truncated already used for the same failures (roadmap [3.4.0], D012); its -2
# conditions are now checked here, so no ganita vocabulary reaches the caller. A caller of
# svd_compute writes `var t, v = svd_compute_checked(...)` and tests `is_ok(t)`.
# "ganita gives no answer" is any of: its -1 (through ganita 1.2.11, cyrius <= 6.6.15,
# either an allocation failure or 60 sweeps without convergence; from 1.2.12 an
# allocation failure only), its -3 (1.2.12's non-convergence code), or a status of 0
# with a singular value that is not finite (1.2.12 documents that a sigma_1 within a
# few ulps of DBL_MAX can come back +Inf). A consumer compiles this bundle against its
# own pin's ganita, so svd_compute treated both vocabularies alike and passed neither
# -3 nor a non-finite sigma on: its codes were the same 0 / -1 / -2 under every pin, as
# svd_compute_checked's Errs are now.
# ⛔ 3.3.3 — A NON-FINITE ENTRY CAME BACK AS SUCCESS. ganita answers for one (see
# _lext_mat_all_finite): an all-NaN 2x2 returned 0 with S = (0, 0), [[3, NaN],
# [0, 2]] returned 0 with S = (3, NaN), and [[+-Inf, 0], [0, 2]] returned 0 with
# S = (NaN, NaN). It is now refused with -2, the code ganita itself gives for an
# argument it cannot decompose, before ganita is called. ganita 1.2.12 refuses a
# non-finite A with -2 itself; the check stays for consumers whose pins carry ganita
# 1.2.11 or older (every direct consumer's, at cyrius 6.6.2-6.6.10).
# [measured: scratch probe on the 3.3.2 bundle, not reproducible in-tree, 2026-10-01; cycc 6.6.12]
# ⛔ 3.3.3 — THIS SAID "Returns: 0 on success" AND error.cyr LISTED IT AMONG THE
# FUNCTIONS THAT "CAN ONLY EVER SUCCEED". Neither was true: a 2x3 A returns -2, and
# -1 / -2 are bit-identical to HSB_ERR_INVALID_TRANSFORM / HSB_ERR_SINGULAR_MATRIX,
# so a caller comparing against the hisab codes reads a wide matrix as SINGULAR.
# 3.3.3 kept the signature and wrote the contract down; 3.4.0 retired the name (below).
# [measured: G2a probe on the 3.3.2 bundle, cycc 6.6.12, 2026-10-01]
# ⭐ 3.3.4 — GANITA'S -1 FALLS BACK TO svd_golub_kahan (src/linalg_precision.cyr). Through
# 3.3.3 both wrappers refused whatever ganita refused, and ganita refuses ordinary
# rank-deficient square matrices: -1 for 2399 of 2400 random n x n with a zero row, 2397 of
# 2400 with a duplicated row and 2216 of 2400 with two zero rows (n = 3..10), and for
# [[1,2,3],[1,2,3],[4,5,6]]. The fallback answers all 7012 of those rows, and the witnesses
# in tests/abuse.tcyr ([[1,t],[t,t],[t,-t]] at t = 2^-513 among them). Against an
# 80-digit Decimal oracle its S is within 7.75 eps S0 (ganita's own answers on dense,
# rank-1 and duplicated-column rows: 8.36) and U, Vt are orthonormal to 14.6 eps. U S Vt
# is looser: 4820 eps ||A||_F at worst, median 5.8, where ganita's answers reach 12.9 --
# the order of svd_golub_kahan's ~2900 eps on graded bidiagonals (roadmap [3.6.0]).
# [measured: fallback probe, 300 rows per n and class + Decimal oracle, 2026-10-03; cycc 6.6.14]
# ⚠ Every input ganita answers is returned exactly as before (svd_compute against a direct
# ganita_mat_svd call: 7390 of 7390 probe rows bit-identical). The conventions match -- S
# non-negative and descending, U m x n, Vt = V^T n x n -- with one difference: for an exact
# zero singular value ganita writes a zero U column, svd_golub_kahan a unit one.
# [measured: fallback probe, the same rows, 2026-10-03; cycc 6.6.14]
# ⛔ 3.3.7 — CYRIUS 6.6.16 FOLDED GANITA 1.2.13, AND THE FALLBACK ABOVE STOPPED RUNNING
# WHERE IT IS NEEDED. Non-convergence became -3 and this wrapper fell back on -1 only.
# No finite input is known to reach 1.2.14's -3, but its status 0 with sigma_1 = +Inf is
# reachable: the duplicated-row witness times 2^1021 (sigma_1 = 1.27 * 2^1024) came back
# 0 with S = (+Inf, ...), where 3.3.6 under 6.6.14 returned -1 with out_S untouched, the
# contract above. ganita's sigmas now go to an n-slot scratch first and reach out_S only
# when every one is finite; -1, -3 and a non-finite sigma all take the fallback.
# [measured: tests/abuse.tcyr 3.3.4 fallback group, run under cyrius 6.6.14 and 6.6.20, 2026-10-31]
# ⛔ 3.3.7 — AND GANITA'S FINITE ANSWER CAN BE PAST THE LINE. ganita 1.2.14 returns 0 with
# sigma_1 = DBL_MAX for [[h, h], [h, h]], h = 2^1023, whose sigma_1 is 2^1024 and rounds to
# +Inf, and others just past the line come back a few ulp below DBL_MAX, so both wrappers
# answered what svd_golub_kahan refuses since 3.3.7 (under 6.6.14, ganita 1.2.11 returned
# +Inf there and the fallback refused). When ganita answers with a singular value within
# 2^-40 of the line, its own U column and Vt row now go through svd_golub_kahan's
# certificate (`_lext_sv_past_max`: the quotient bounds sigma_1 for any vectors), and a
# value proven past it is -1 at once, out_S untouched. The fallback is not tried: no finite
# answer is right. Nor does every near-line value go to the fallback, whose own rescale
# refuses some that fit: that turned 216 of the 3,932 fitting rows below into -1. On 8,000
# matrices (2x1 to 8x2: uniform, rank-1-ish, graded, duplicated row) with sigma_1 within
# 2^13 units of 2^-53 of the line, on both sides: the 159 of 4,034 past it that 3.3.6
# answered are refused by both wrappers, none of the 3,966 that fit, and every row answered
# is byte-identical.
# [measured: wrapper near-line sweep, seed 3371, + route-to-fallback variant, 3.3.6 vs this tree, 2026-10-31]
#must_use
public fn svd_compute_checked(A, out_U, out_S, out_Vt) {
    if (A == 0 || out_U == 0 || out_S == 0 || out_Vt == 0) { return Err(HSB_ERR_INVALID_INPUT); }
    var m = ganita_mat_rows(A);
    var n = ganita_mat_cols(A);
    if (m <= 0 || n <= 0 || m < n) { return Err(HSB_ERR_INVALID_INPUT); }
    if (ganita_mat_rows(out_U) != m || ganita_mat_cols(out_U) != n) { return Err(HSB_ERR_INVALID_INPUT); }
    if (ganita_mat_rows(out_Vt) != n || ganita_mat_cols(out_Vt) != n) { return Err(HSB_ERR_INVALID_INPUT); }
    if (_lext_mat_all_finite(A, m, n) == 0) { return Err(HSB_ERR_INVALID_INPUT); }
    var sv = alloc(n * 8);
    if (sv == 0) { return Err(HSB_ERR_ALLOC); }
    var rc = ganita_mat_svd(A, out_U, sv, out_Vt);
    if (rc == 0) {
        if (_lext_vec_all_finite(sv, n) == 1) {
            # proven past the line: no finite answer is right, so no fallback (see above)
            if (_lext_svd_past_line(A, m, n, out_U, sv, out_Vt) == 1) { return Err(HSB_ERR_NO_CONVERGENCE); }
            _lext_vec_copy_n(out_S, sv, n);
            return Ok(0);
        }
    } else {
        # ganita's -2 conditions are all refused above, so its -2 cannot come back; any
        # code but -1 and -3 is refused rather than fallen back on
        if (rc != 0 - 1 && rc != 0 - 3) { return Err(HSB_ERR_INVALID_INPUT); }
    }
    # Whatever ganita wrote went to sv, out_U and out_Vt; the fallback rewrites all of
    # out_U and out_Vt, and writes out_S only on success.
    var gt, gv = svd_golub_kahan(A, out_U, out_S, out_Vt);
    if (is_err_result(gt) == 1) {
        # (A fallback that fails after ganita's own request was refused: the refusal is the cause.)
        if (rc == 0 - 1) { return Err(HSB_ERR_ALLOC); }
        return Err(gv);
    }
    return Ok(0);
}

# Truncated (rank-k) SVD: keep only the top k singular values.
# A:      stdlib matrix (m x n, m >= n).
# k:      number of singular values to keep (1 <= k <= n).
# out_U:  stdlib matrix (m x k, caller allocates).
# out_S:  flat f64 array of length k (caller allocates).
# out_Vt: stdlib matrix (k x n, caller allocates).
# Returns: Ok(0) on success;
#          Err(HSB_ERR_INVALID_INPUT) for a null A or out-param, k outside [1, n], a
#            WIDE A (m < n -- ganita's one-sided Jacobi needs m >= n), an out_U
#            smaller than m x k / an out_Vt smaller than k x n, or a non-finite
#            entry in A;
#          Err(HSB_ERR_ALLOC) if the full-SVD temporaries cannot be allocated, or
#            the svd_golub_kahan fallback cannot allocate its own;
#          Err(HSB_ERR_NO_CONVERGENCE) if ganita_mat_svd gives no answer (its -1 or
#            -3, or a non-finite singular value; see svd_compute_checked) and the fallback
#            does not converge either, which includes a singular value above
#            DBL_MAX (since 3.3.4; -3 and the non-finite value since 3.3.7), or (since
#            3.3.7) if ganita's answer has a singular value its own singular pair
#            proves past the rounding line (see svd_compute_checked); out_S untouched.
# ⛔ 3.3.3 — THE DECOMPOSITION'S STATUS WAS DISCARDED. `ganita_mat_svd(...)` was a
# bare statement, so every failure came back Ok(0) with out_S/out_U/out_Vt copied
# out of temporaries the SVD never wrote: a 2x3 A (ganita's -2) gave Ok(0) and
# S[0] = 0, a 3x2 A whose Jacobi sweep never ends (ganita's -1) gave Ok(0) and
# S[0] = 0, and A = 0 or a null out-param was a null dereference (exit 139). The
# out-params were stored through unchecked too -- a 1x1 out_U for k = 2 on a 3x3 A
# overwrote the 3 words after it -- the class linalg_sort_desc and eigen_qr bound
# before their write loops.
# [measured: G2a probe on the 3.3.2 bundle, cycc 6.6.12, 2026-10-01]
#must_use
public fn svd_truncated(A, k, out_U, out_S, out_Vt) {
    if (A == 0) { return Err(HSB_ERR_INVALID_INPUT); }
    if (out_U == 0 || out_S == 0 || out_Vt == 0) { return Err(HSB_ERR_INVALID_INPUT); }
    var rows = ganita_mat_rows(A);
    var cols = ganita_mat_cols(A);
    if (k < 1) { return Err(HSB_ERR_INVALID_INPUT); }
    if (k > cols) { return Err(HSB_ERR_INVALID_INPUT); }
    # ⚠ BEFORE THE TEMPORARIES, NOT AFTER. ganita refuses a wide A with -2, but by
    # then full_vt -- cols x cols -- has been asked for, and for a 1 x 6000 A that is
    # 36M elements, over ganita's 33,554,430 cap: on 3.3.2 ganita_mat_new returned 0
    # and the copy loop read through it (exit 139). With rows >= cols,
    # cols * cols <= rows * cols, so no temporary is larger than A itself.
    # [measured: G2a probe on the 3.3.2 bundle, cycc 6.6.12, 2026-10-01]
    if (rows < cols) { return Err(HSB_ERR_INVALID_INPUT); }
    # The copy loops below write rows x k into out_U and k x cols into out_Vt
    # through ganita_mat_set, which is unchecked by design.
    if (ganita_mat_rows(out_U) < rows || ganita_mat_cols(out_U) < k) { return Err(HSB_ERR_INVALID_INPUT); }
    if (ganita_mat_rows(out_Vt) < k || ganita_mat_cols(out_Vt) < cols) { return Err(HSB_ERR_INVALID_INPUT); }
    # A non-finite entry: see _lext_mat_all_finite.
    if (_lext_mat_all_finite(A, rows, cols) == 0) { return Err(HSB_ERR_INVALID_INPUT); }

    # Compute full SVD into temporaries. None is larger than A (see above), so
    # ganita's element cap cannot refuse one; only an exhausted heap can.
    var full_u  = ganita_mat_new(rows, cols);
    var full_s  = alloc(cols * 8);
    var full_vt = ganita_mat_new(cols, cols);
    if (full_u == 0 || full_s == 0 || full_vt == 0) { return Err(HSB_ERR_ALLOC); }
    # None of ganita's -2 conditions can arise here: A is non-null, finite and not
    # wide, and the temporaries are non-null with exactly the shapes it demands. What
    # remains is its -1 or -3, or a status of 0 with a non-finite singular value
    # (1.2.12; see svd_compute_checked); svd_golub_kahan then decomposes A into the same
    # temporaries, and its Err is returned as is. out_S is written only below.
    var g_rc = ganita_mat_svd(A, full_u, full_s, full_vt);
    if (g_rc != 0 || _lext_vec_all_finite(full_s, cols) == 0) {
        var gt, gv = svd_golub_kahan(A, full_u, full_s, full_vt);
        if (is_err_result(gt) == 1) {
            if (g_rc == 0 - 1) { return Err(HSB_ERR_ALLOC); }   # (as svd_compute_checked)
            return Err(gv);
        }
    } else {
        # ganita's answer proven past the line (see svd_compute_checked): refused, no fallback
        if (_lext_svd_past_line(A, rows, cols, full_u, full_s, full_vt) == 1) {
            return Err(HSB_ERR_NO_CONVERGENCE);
        }
    }

    # Copy top k singular values
    var i = 0;
    while (i < k) {
        store64(out_S + i * 8, load64(full_s + i * 8));
        i = i + 1;
    }

    # Copy first k columns of U into out_U (m x k)
    i = 0;
    while (i < rows) {
        var j = 0;
        while (j < k) {
            ganita_mat_set(out_U, i, j, ganita_mat_get(full_u, i, j));
            j = j + 1;
        }
        i = i + 1;
    }

    # Copy first k rows of Vt into out_Vt (k x n)
    i = 0;
    while (i < k) {
        var j = 0;
        while (j < cols) {
            ganita_mat_set(out_Vt, i, j, ganita_mat_get(full_vt, i, j));
            j = j + 1;
        }
        i = i + 1;
    }

    return Ok(0);
}

# ================================================================
# Section 4 -- Eigendecomposition
# ================================================================

# ---- eigen_power's wide-exponent fallback (3.3.4) ----
# A finite double x as m * 2^e with 0.5 <= |m| < 1, exactly (x = 0 gives m = x, e = 0).
# A subnormal x is first multiplied by 2^54, which is exact and makes it normal.
fn _lext_xexp(x) {
    var bx = x & 0x7FFF_FFFF_FFFF_FFFF;
    if (bx == 0) { return 0; }
    if ((bx >> 52) == 0) {
        var y = f64_mul(bx, (1023 + 54) << 52);
        return (y >> 52) - 1022 - 54;
    }
    return (bx >> 52) - 1022;
}
fn _lext_xman(x) {
    var bx = x & 0x7FFF_FFFF_FFFF_FFFF;
    if (bx == 0) { return x; }
    var y = x;
    if ((bx >> 52) == 0) { y = f64_mul(x, (1023 + 54) << 52); }
    return (y & 0x800F_FFFF_FFFF_FFFF) | 0x3FE0_0000_0000_0000;
}
# m * 2^e rounded ONCE to a double, for 0.5 <= |m| < 1 or m = 0 and any i64 e. Below
# 2^-1022 the product is formed as (m * 2^(e + 1074)) * 2^-1074: the first factor keeps
# it normal and exact, so the multiply by the subnormal 2^-1074 is the only rounding.
fn _lext_xld(m, e) {
    if ((m & 0x7FFF_FFFF_FFFF_FFFF) == 0) { return m; }
    if (e > 1024) { return (m & 0x8000_0000_0000_0000) | 0x7FF0_0000_0000_0000; }
    if (e == 1024) { return f64_mul(f64_mul(m, 0x4000_0000_0000_0000), (1023 + 1023) << 52); }
    if (e >= 0 - 1022) { return f64_mul(m, (1023 + e) << 52); }
    if (e < 0 - 2095) { return m & 0x8000_0000_0000_0000; }
    return f64_mul(f64_mul(m, (1023 + e + 1074) << 52), 1);
}

# Is |m1| 2^e1 > thr |m2| 2^e2? For wide components (0.5 <= |m| < 1, or m = 0) and 1 <= thr <= 2,
# so an exponent gap past 60 decides it alone.
fn _lext_wgt(m1, e1, m2, e2, thr) {
    if ((m1 & 0x7FFF_FFFF_FFFF_FFFF) == 0) { return 0; }
    if ((m2 & 0x7FFF_FFFF_FFFF_FFFF) == 0) { return 1; }
    var d = e1 - e2;
    if (d > 60) { return 1; }
    if (d < 0 - 60) { return 0; }
    return f64_gt(f64_abs(m1), f64_mul(thr, _lext_xld(f64_abs(m2), 0 - d)));
}

# Power iteration with every component carried as m * 2^e (m a double, e an i64), so no
# component of the iterate, of A v or of the estimate can leave the f64 range. The same
# seed, max-component normalisation, up-to-sign comparison and tests as eigen_power's
# loop; where that loop's arithmetic stays normal this one rounds the same way (every
# rescaling is by a power of two). Side by side on 24000 matrices of eight kinds
# (symmetric, positive, general, integer, block, entries near 2^-1000, near DBL_MAX and at
# DBL_MAX / n) the two gave the same bits or the same refusal on every one; they differ
# where a plain component or product leaves the normal range. Called by eigen_power when
# its converged iterate has a component the plain arithmetic may have lost, below DBL_MIN
# or below the rounding grid of A v (see there). Returns 0 with out_val / out_vec
# written, or the error code, with neither touched.
# [measured: krylov white-box probe, plain and wide runs side by side, cycc 6.6.14, 2026-10-03]
# Since 3.3.5 it has eigen_power's growth test too (see `_lext_grows`), without the subnormal
# floor (a wide component has no subnormal grid): a candidate whose components grew more than
# twofold is held for one more pass, and returned exactly as it stood unless a flagged
# component grows more than twofold again (so the side-by-side figure above predates it).
fn _lext_power_wide(A, n, max_iter, out_val, out_vec) {
    var i = 0;
    var j = 0;
    while (i < n) {
        j = 0;
        while (j < n) {
            if (f64_lt(f64_abs(ganita_mat_get(A, i, j)), F64_POS_INF) == 0) { return HSB_ERR_NO_CONVERGENCE; }
            j = j + 1;
        }
        i = i + 1;
    }
    var vm = alloc(n * 8);   # the iterate: v_i = vm_i * 2^ve_i
    var ve = alloc(n * 8);
    var sm = alloc(n * 8);   # A v: w_i = sm_i * 2^sx_i
    var sx = alloc(n * 8);
    var gfl = alloc(n * 8);  # the growth test's flags for a pending candidate (see below)
    var c_vec = alloc(n * 8);
    if (vm == 0 || ve == 0 || sm == 0 || sx == 0) { return HSB_ERR_ALLOC; }
    if (gfl == 0 || c_vec == 0) { return HSB_ERR_ALLOC; }
    var pend = 0;
    var c_lam = f64_from(0);
    i = 0;
    while (i < n) {
        # eigen_power's seed: SplitMix64's (i+1)-th output in [0.5, 1), which is m, e = 0.
        var z = (i + 1) * 0x9E3779B97F4A7C15;
        z = (z ^ (z >> 30)) * 0xBF58476D1CE4E5B9;
        z = (z ^ (z >> 27)) * 0x94D049BB133111EB;
        z = z ^ (z >> 31);
        store64(vm + i * 8, 0x3FE0000000000000 | (z >> 12));
        store64(ve + i * 8, 0);
        i = i + 1;
    }
    var tol = EPSILON_F64;
    var est_m = f64_from(0);   # the previous estimate, est_m * 2^est_e
    var est_e = 0;
    var iter = 0;
    while (iter < max_iter) {
        # w = A v. Row i's exponent X is the largest of its non-zero terms'; each term is
        # (m(a_ij) * vm_j) * 2^(e(a_ij) + ve_j - X), so the sum is formed below 1 in size.
        i = 0;
        while (i < n) {
            var big = 0;
            var have = 0;
            j = 0;
            while (j < n) {
                var a = ganita_mat_get(A, i, j);
                if ((a & 0x7FFF_FFFF_FFFF_FFFF) != 0 && (load64(vm + j * 8) & 0x7FFF_FFFF_FFFF_FFFF) != 0) {
                    var te = _lext_xexp(a) + load64(ve + j * 8);
                    if (have == 0 || te > big) { big = te; }
                    have = 1;
                }
                j = j + 1;
            }
            var acc = f64_from(0);
            if (have == 1) {
                j = 0;
                while (j < n) {
                    var a2 = ganita_mat_get(A, i, j);
                    var vmj = load64(vm + j * 8);
                    if ((a2 & 0x7FFF_FFFF_FFFF_FFFF) != 0 && (vmj & 0x7FFF_FFFF_FFFF_FFFF) != 0) {
                        var tm = f64_mul(_lext_xman(a2), vmj);
                        var td = _lext_xexp(a2) + load64(ve + j * 8) - big;
                        acc = f64_add(acc, _lext_xld(_lext_xman(tm), _lext_xexp(tm) + td));
                    }
                    j = j + 1;
                }
            }
            if (f64_eq(acc, acc) == 0) { return HSB_ERR_NO_CONVERGENCE; }
            store64(sm + i * 8, _lext_xman(acc));
            store64(sx + i * 8, _lext_xexp(acc) + big);
            i = i + 1;
        }

        # The largest |w_i| (the first, on a tie), compared by exponent, then mantissa.
        var max_i = 0 - 1;
        i = 0;
        while (i < n) {
            var mi_m = load64(sm + i * 8);
            if ((mi_m & 0x7FFF_FFFF_FFFF_FFFF) != 0) {
                if (max_i < 0) {
                    max_i = i;
                } else {
                    var bx_e = load64(sx + max_i * 8);
                    var ix_e = load64(sx + i * 8);
                    if (ix_e > bx_e || (ix_e == bx_e && f64_gt(f64_abs(mi_m), f64_abs(load64(sm + max_i * 8))) == 1)) {
                        max_i = i;
                    }
                }
            }
            i = i + 1;
        }
        if (max_i < 0) { return HSB_ERR_NO_CONVERGENCE; }
        var mx_m = load64(sm + max_i * 8);
        var mx_e = load64(sx + max_i * 8);

        var flip = 0;
        if (f64_lt(load64(vm + max_i * 8), 0) == 1) { flip = 1; }
        var nw_m = mx_m;
        if (flip == 1) { nw_m = f64_neg(mx_m); }

        # v = w / max, and whether any component moved by tol (compared as doubles).
        var moved = 0;
        var grow = 0;
        var conf = 0;
        i = 0;
        while (i < n) {
            var q = f64_div(load64(sm + i * 8), mx_m);
            var q_m = _lext_xman(q);
            var q_e = _lext_xexp(q) + load64(sx + i * 8) - mx_e;
            var v_old = _lext_xld(load64(vm + i * 8), load64(ve + i * 8));
            if (flip == 1) { v_old = f64_neg(v_old); }
            if (f64_lt(f64_abs(f64_sub(_lext_xld(q_m, q_e), v_old)), tol) == 0) { moved = 1; }
            # grown more than twofold since the last pass (see eigen_power's growth test)
            var g1 = _lext_wgt(q_m, q_e, load64(vm + i * 8), load64(ve + i * 8), F64_TWO);
            if (pend == 0) {
                store64(gfl + i * 8, g1);
                if (g1 == 1) { grow = 1; }
            } else {
                if (g1 == 1 && load64(gfl + i * 8) == 1) { conf = 1; }
            }
            store64(vm + i * 8, q_m);
            store64(ve + i * 8, q_e);
            i = i + 1;
        }

        # |new - old| < tol |new|, in units of 2^nw_e (the estimates differ by at most
        # a factor 4 when it can hold, so the shift is small and exact).
        var close = 0;
        if (moved == 0 && (est_m & 0x7FFF_FFFF_FFFF_FFFF) != 0) {
            var de = est_e - mx_e;
            if (de >= 0 - 2 && de <= 2) {
                var old_s = f64_mul(est_m, (1023 + de) << 52);
                if (f64_lt(f64_abs(f64_sub(nw_m, old_s)), f64_mul(tol, f64_abs(nw_m))) == 1) { close = 1; }
            }
        }
        if (pend == 1) {
            # the pass after a candidate whose components grew: a flagged one grew again, or
            # the candidate stands, exactly as it would have been returned
            if (conf == 1) {
                pend = 0;
            } else {
                store64(out_val, c_lam);
                i = 0;
                while (i < n) {
                    store64(out_vec + i * 8, load64(c_vec + i * 8));
                    i = i + 1;
                }
                return 0;
            }
        } else {
            if (close == 1) {
                var lam = _lext_xld(nw_m, mx_e);
                if (f64_lt(f64_abs(lam), F64_POS_INF) == 0) { return HSB_ERR_NO_CONVERGENCE; }
                if (grow == 1) {
                    c_lam = lam;
                    i = 0;
                    while (i < n) {
                        store64(c_vec + i * 8, _lext_xld(load64(vm + i * 8), load64(ve + i * 8)));
                        i = i + 1;
                    }
                    pend = 1;
                } else {
                    store64(out_val, lam);
                    i = 0;
                    while (i < n) {
                        store64(out_vec + i * 8, _lext_xld(load64(vm + i * 8), load64(ve + i * 8)));
                        i = i + 1;
                    }
                    return 0;
                }
            }
        }
        est_m = nw_m;
        est_e = mx_e;
        iter = iter + 1;
    }
    if (pend == 1) {
        store64(out_val, c_lam);
        i = 0;
        while (i < n) {
            store64(out_vec + i * 8, load64(c_vec + i * 8));
            i = i + 1;
        }
        return 0;
    }
    return HSB_ERR_NO_CONVERGENCE;
}

# The radius floor's fast filter (3.3.6): 1 when plain doubles prove |lam| n >= (1 - 2^-27)
# (1 - 2u) |tr A| and lam^2 n >= (1 - 2^-27)(1 - 3u) |tr A^2| (u = 2^-53), which is past where
# `_lext_below_rho` could return 1 (it needs |lam| n below (1 - 2^-26)(1 + 5u) |tr A|, or lam^2 n
# below (1 - 2^-25)(1 + 8u) |tr A^2|), so its answer is 0; 0 when they cannot prove it.
# THE BOUND. Summed in order, t = sum x_i has |t - sum| <= gamma_(m-1) sum |x_i| (m terms,
# gamma_k about k u); a product adds u of itself and, if it lands below 2^-1022, at most
# 2^-1075 (2^-1074 doubled); an addition adds no absolute error. So U = |t| + 4 (m + 2) u s +
# n^k p (s the sum of |x_i|; m = n for tr A, n (n + 1) / 2 <= n^2 for tr A^2; p = 2^-1073) is at
# least |tr A^k| even after its own three roundings, and U (1 - 2^-27), rounded, is the
# threshold. Ranges: n <= 2^20, both sums of |x_i| at most 2^1000 (a non-finite sum fails that
# test too), and |lam| = m 2^e with |e| <= 450. For 450 < |e| <= 1022 every entry is first
# multiplied by 2^-e, so that the scaled |lam| is in [1, 2): exact going up (an entry that
# overflows makes a sum non-finite), and going down each entry lands below 2^573 and rounds by
# at most 2^-1075, which moves a product by under 2^-500, so p = 2^-500 there. A pair with an
# exact zero is skipped (its product is exactly 0; scaled, an overflowed partner would make it
# NaN). Outside these ranges (a zero or subnormal lam among them) the filter answers 0 and the
# m * 2^e path decides.
# tr A^2 is summed over i <= j (2 a_ij a_ji off the diagonal), n^2 / 2 + n / 2 terms and
# n^2 element reads: about one pass of the iteration, against the m * 2^e path's 4 n^2 reads
# and 11 n^2 helper calls.
# Against the m * 2^e path alone, the decision is the same on all 8,571,847 (lambda, A) pairs
# of a 66,000-matrix adversarial set (full-range entries, nilpotent cancellation, near DBL_MAX,
# subnormal, c I + N; lambdas at and a few ulps around 1 - 2^-26 and 1 - 2^-27 of each floor,
# and past the ranges) and the 803,325 of a 6,000-matrix set up to n = 40, and the filter
# settled none that the path answers 1. eigen_power returns the same bytes on the P1 / P2
# sweeps (115,000), families F1-F8 (32,000) and 24,000 matrices of six more families. On
# 14,347 converged answers of generic matrices (n = 2..12: Gaussian, symmetric, positive,
# integer, entries scaled by 10^-300 to 10^300) and the eigen_power timing fixtures (3x3, 5x5,
# the bench's 12x12, the wide 2x2) the m * 2^e path ran 0 times; it runs on an answer the floor
# refuses (the roadmap repro's first).
# [measured: filter vs m * 2^e floor probes, eigen_power dumps, call count; base vs this tree, 2026-10-11; cycc 6.6.14]
fn _lext_rho_clear(A, n, lam) {
    if (n > 1048576) { return 0; }
    var la = f64_abs(lam);
    # |lam|'s exponent: NaN and +-Inf read 1024, zero and subnormals -1023, both refused
    var ex = (la >> 52) - 1023;
    if (ex < 0 - 1022 || ex > 1022) { return 0; }
    var sc = F64_ONE;
    var pad = 2;   # 2^-1073
    if (ex < 0 - 450 || ex > 450) {
        sc = (1023 - ex) << 52;   # 2^-ex
        la = f64_mul(la, sc);
        pad = (1023 - 500) << 52;   # 2^-500
    }
    var t1 = f64_from(0);
    var s1 = f64_from(0);
    var t2 = f64_from(0);
    var s2 = f64_from(0);
    for (var i = 0; i < n; i = i + 1) {
        var d = f64_mul(ganita_mat_get(A, i, i), sc);
        t1 = f64_add(t1, d);
        s1 = f64_add(s1, f64_abs(d));
        var dd = f64_mul(d, d);
        t2 = f64_add(t2, dd);
        s2 = f64_add(s2, dd);
        for (var j = i + 1; j < n; j = j + 1) {
            var x = ganita_mat_get(A, i, j);
            var y = ganita_mat_get(A, j, i);
            if ((x & 0x7FFF_FFFF_FFFF_FFFF) != 0 && (y & 0x7FFF_FFFF_FFFF_FFFF) != 0) {
                var p = f64_mul(f64_mul(x, sc), f64_mul(y, sc));
                p = f64_add(p, p);
                t2 = f64_add(t2, p);
                s2 = f64_add(s2, f64_abs(p));
            }
        }
    }
    var top = (1023 + 1000) << 52;   # 2^1000
    if (f64_le(s1, top) == 0 || f64_le(s2, top) == 0) { return 0; }
    var kf = 0x3FEFFFFFFC000000;   # 1 - 2^-27
    var c51 = (1023 - 51) << 52;   # 2^-51, four times u
    var fn_ = f64_from(n);
    var nn = f64_mul(fn_, fn_);
    # U1 = |t1| + (n + 2) 2^-51 s1 + n p
    var u1 = f64_add(f64_add(f64_abs(t1), f64_mul(f64_mul(f64_add(fn_, F64_TWO), c51), s1)), f64_mul(fn_, pad));
    if (f64_lt(f64_mul(la, fn_), f64_mul(u1, kf)) == 1) { return 0; }
    # U2 = |t2| + (n^2 + 2) 2^-51 s2 + n^2 p
    var u2 = f64_add(f64_add(f64_abs(t2), f64_mul(f64_mul(f64_add(nn, F64_TWO), c51), s2)), f64_mul(nn, pad));
    if (f64_lt(f64_mul(f64_mul(la, la), fn_), f64_mul(u2, kf)) == 1) { return 0; }
    return 1;
}

# eigen_power's spectral-radius floor (3.3.6): 1 when |lam| is provably below rho(A), the
# modulus of A's dominant eigenvalue, so that lam cannot be it. tr A^k is the sum of the k-th
# powers of the eigenvalues, so rho(A) >= |tr A| / n and rho(A)^2 >= |tr A^2| / n for any A.
# Each sum is formed with its terms carried as m * 2^e and scaled together so its largest term
# sits near 2^960 (the diagonal for tr A, the products a_ij a_ji for tr A^2), each term rounded
# once; a term that lands below the subnormal grid is off by under 2^-1074, and lam, scaled
# alike, is rounded up and may overflow, which leaves the test false. A bound on the rounding,
# n 2^-52 sum |a_ii| (plus n 2^-1074) and (n^2 + 2) 2^-52 sum |a_ij a_ji| (plus n^2 2^-1074),
# is taken off each sum, and the answer is 1 only when |lam| falls short by more than a factor
# 1 - 2^-26 (the larger-only rule's 2^-26): an answer within 2^-26 of either floor is never
# refused, and the margin also covers the rounding of these comparisons.
# The m * 2^e sums run only when `_lext_rho_clear` (above) cannot settle the answer in plain
# doubles; where it settles it, it proves this routine would return 0.
fn _lext_below_rho(A, n, lam) {
    if (_lext_rho_clear(A, n, lam) == 1) { return 0; }
    var fn_ = f64_from(n);
    var keep = 0x3FEFFFFFF8000000;   # 1 - 2^-26
    var eps2 = 0x3CB0000000000000;   # 2^-52, twice the unit roundoff
    var la = f64_abs(lam);
    var lm = _lext_xman(la);
    var le = _lext_xexp(la);
    # |tr A| / n, scaled by 2^(960 - E1), E1 the largest diagonal exponent
    var e1x = 0 - 100000;
    for (var i = 0; i < n; i = i + 1) {
        var d = ganita_mat_get(A, i, i);
        if ((d & 0x7FFF_FFFF_FFFF_FFFF) != 0 && _lext_xexp(d) > e1x) { e1x = _lext_xexp(d); }
    }
    if (e1x > 0 - 100000) {
        var t1 = f64_from(0);
        var s1 = f64_from(0);
        for (var i1 = 0; i1 < n; i1 = i1 + 1) {
            var d1 = ganita_mat_get(A, i1, i1);
            var ds = _lext_xld(_lext_xman(d1), _lext_xexp(d1) + 960 - e1x);
            t1 = f64_add(t1, ds);
            s1 = f64_add(s1, f64_abs(ds));
        }
        var ls1 = f64_add(f64_mul(_lext_xld(lm, le + 960 - e1x), 0x3FF0000000000002), 1);   # (1 + 2^-51), + 2^-1074
        var r1 = f64_mul(f64_sub(f64_sub(f64_abs(t1), f64_mul(f64_mul(fn_, eps2), s1)), f64_mul(fn_, 1)), keep);
        if (f64_lt(f64_mul(ls1, fn_), r1) == 1) { return 1; }
    }
    # |tr A^2| / n, scaled by 2^(960 - E2), E2 the largest exponent of a product a_ij a_ji
    var e2x = 0 - 100000;
    for (var i2 = 0; i2 < n; i2 = i2 + 1) {
        for (var j2 = 0; j2 < n; j2 = j2 + 1) {
            var x = ganita_mat_get(A, i2, j2);
            var y = ganita_mat_get(A, j2, i2);
            if ((x & 0x7FFF_FFFF_FFFF_FFFF) != 0 && (y & 0x7FFF_FFFF_FFFF_FFFF) != 0) {
                if (_lext_xexp(x) + _lext_xexp(y) > e2x) { e2x = _lext_xexp(x) + _lext_xexp(y); }
            }
        }
    }
    if (e2x == 0 - 100000) { return 0; }
    var t2 = f64_from(0);
    var s2 = f64_from(0);
    for (var i3 = 0; i3 < n; i3 = i3 + 1) {
        for (var j3 = 0; j3 < n; j3 = j3 + 1) {
            var x3 = ganita_mat_get(A, i3, j3);
            var y3 = ganita_mat_get(A, j3, i3);
            if ((x3 & 0x7FFF_FFFF_FFFF_FFFF) != 0 && (y3 & 0x7FFF_FFFF_FFFF_FFFF) != 0) {
                var pm = f64_mul(_lext_xman(x3), _lext_xman(y3));
                var ps = _lext_xld(_lext_xman(pm), _lext_xexp(pm) + _lext_xexp(x3) + _lext_xexp(y3) + 960 - e2x);
                t2 = f64_add(t2, ps);
                s2 = f64_add(s2, f64_abs(ps));
            }
        }
    }
    var l2 = f64_mul(lm, lm);
    var ls2 = f64_add(f64_mul(_lext_xld(_lext_xman(l2), _lext_xexp(l2) + 2 * le + 960 - e2x), 0x3FF0000000000002), 1);
    var nn = f64_mul(fn_, fn_);
    var r2 = f64_sub(f64_sub(f64_abs(t2), f64_mul(f64_mul(f64_add(nn, F64_TWO), eps2), s2)), f64_mul(nn, 1));
    r2 = f64_mul(r2, f64_mul(keep, keep));
    if (f64_lt(f64_mul(ls2, fn_), r2) == 1) { return 1; }
    return 0;
}

# ⭐ 3.3.7 — eigen_power's exact diagonal floor. Where a_ii is a strongly connected component
# of A's graph on its own (edges i -> j for a_ij != 0, i != j, exact zeros only), A is a
# permutation of a block triangular matrix with a_ii as a 1 x 1 diagonal block, so a_ii IS an
# eigenvalue and rho(A) >= |a_ii|, with no rounding anywhere. Every diagonal entry of a
# triangular or permuted-triangular A is one. The trace floors above miss these when the other
# eigenvalues cancel in tr A^k: [[1e-3, 0, -1e20], [0, 1.3, 0], [0, 0, -1]] has lambda_1 = 1.3
# and both floors below 1.
# 1 when |lam| < |d| (1 - 2^-26): the larger-only rule's margin, so an answer within 2^-26 of
# |d| is never refused. The product rounds to nearest, so a double below the rounded product is
# below the exact one, on the subnormal grid too (where the margin can round away, and then
# only an answer at least one grid step below |d| is refused). A NaN on either side is false.
fn _lext_diag_past(d, la) {
    return f64_lt(la, f64_mul(f64_abs(d), 0x3FEFFFFFF8000000));   # 1 - 2^-26
}

# ⭐ 3.4.0 — the same floor for a component of two vertices p, q: B = [[a, b], [c, d]] (a = a_pp,
# b = a_pq, c = a_qp, d = a_qq) is a diagonal block of a permutation of A, so its eigenvalues are
# A's, and rho(A) >= rho(B) >= max(|a + d| / 2, sqrt |ad - bc|): the mean of B's two eigenvalues
# and the geometric mean of their moduli. When B's pair is complex the second IS its modulus.
# 1 when |lam| is below either by the margin of `_lext_diag_past`. Each is formed so it cannot
# exceed its exact value: |a + d| / 2 from halves (exact above 2^-1021), and used only above
# 2^-1000, where the rounding of a subnormal half is far inside the margin; ad and bc as m * 2^e
# products (`_lext_xman` / `_lext_xexp`), so neither overflows or flushes, their difference taken
# at the larger exponent with a bound on every rounding (3 2^-53 (|ad| + |bc|) + 2^-1072) taken
# off before the square root.
fn _lext_blk2_past(A, p, q, la) {
    var a = ganita_mat_get(A, p, p);
    var b = ganita_mat_get(A, p, q);
    var c = ganita_mat_get(A, q, p);
    var d = ganita_mat_get(A, q, q);
    var mg = 0x3FEFFFFFF8000000;   # 1 - 2^-26
    var th = f64_abs(f64_add(f64_mul(a, 0x3FE0000000000000), f64_mul(d, 0x3FE0000000000000)));   # |a/2 + d/2|
    if (f64_ge(th, 0x0170000000000000) == 1) {   # 2^-1000
        if (f64_lt(la, f64_mul(th, mg)) == 1) { return 1; }
    }
    # ad and bc as m * 2^e (a zero factor gives the zero product, exponent ignored)
    var pm = f64_mul(_lext_xman(a), _lext_xman(d));
    var pe = _lext_xexp(pm) + _lext_xexp(a) + _lext_xexp(d);
    pm = _lext_xman(pm);
    var qm = f64_mul(_lext_xman(b), _lext_xman(c));
    var qe = _lext_xexp(qm) + _lext_xexp(b) + _lext_xexp(c);
    qm = _lext_xman(qm);
    var top = pe;
    if ((pm & 0x7FFF_FFFF_FFFF_FFFF) == 0 || ((qm & 0x7FFF_FFFF_FFFF_FFFF) != 0 && qe > pe)) { top = qe; }
    var x = _lext_xld(pm, pe - top);
    var y = _lext_xld(qm, qe - top);
    if ((pm & 0x7FFF_FFFF_FFFF_FFFF) == 0) { x = f64_from(0); }
    if ((qm & 0x7FFF_FFFF_FFFF_FFFF) == 0) { y = f64_from(0); }
    # 3 2^-53 (|x| + |y|) + 2^-1072
    var err = f64_add(f64_mul(0x3CB8000000000000, f64_add(f64_abs(x), f64_abs(y))), 4);
    var lo = f64_sub(f64_abs(f64_sub(x, y)), err);
    if (f64_gt(lo, 0) == 0) { return 0; }
    # sqrt(lo 2^top) = sqrt(lo 2^r) 2^h, top = 2h + r, r in {0, 1}
    var h = top >> 1;
    if (top < 0) { h = 0 - ((1 - top) >> 1); }
    var rr = top - 2 * h;
    if (rr == 1) { lo = f64_mul(lo, F64_TWO); }
    var sq = f64_sqrt(lo);
    # |lam| 2^-h, rounded once: a quotient that flushes is far below sq, one that overflows above
    var las = la;
    if ((la & 0x7FFF_FFFF_FFFF_FFFF) != 0) { las = _lext_xld(_lext_xman(la), _lext_xexp(la) - h); }
    return f64_lt(las, f64_mul(sq, mg));
}

# 1 when A's graph is not strongly connected (some vertex is not reached from vertex 0, or does
# not reach it), 0 when it is. A breadth-first search each way that stops once every vertex is
# reached, so a dense row 0 and column 0 settle it in 2n reads. s: 2 n words of scratch.
fn _lext_reducible(A, n, s) {
    var seen = s;
    var qu = s + n * 8;
    for (var dir = 0; dir < 2; dir = dir + 1) {
        for (var i = 0; i < n; i = i + 1) { store64(seen + i * 8, 0); }
        store64(seen, 1);
        store64(qu, 0);
        var qh = 0;
        var qt = 1;
        while (qh < qt && qt < n) {
            var v = load64(qu + qh * 8);
            qh = qh + 1;
            for (var j = 0; j < n && qt < n; j = j + 1) {
                var e = 0;
                if (dir == 0) { e = ganita_mat_get(A, v, j); } else { e = ganita_mat_get(A, j, v); }
                if ((e & 0x7FFF_FFFF_FFFF_FFFF) != 0 && load64(seen + j * 8) == 0) {
                    store64(seen + j * 8, 1);
                    store64(qu + qt * 8, j);
                    qt = qt + 1;
                }
            }
        }
        if (qt < n) { return 1; }
    }
    return 0;
}

# 1 when some a_ii past |lam| is a component on its own: Tarjan's strongly connected components,
# iterative, O(n^2) reads of A and no arithmetic. s: 6 n words of scratch (the DFS index,
# low-link, on-stack flag, component stack, call stack and next-neighbour cursor per vertex).
# The diagonal is read as an edge too: a self-edge finds v on the stack with idx[v] = low[v]
# already, so it changes no low-link and no component.
fn _lext_scc_floor(A, n, lam, s) {
    var la = f64_abs(lam);
    var idx = s;
    var low = s + n * 8;
    var onst = s + 2 * n * 8;
    var stk = s + 3 * n * 8;
    var cs = s + 4 * n * 8;
    var cur = s + 5 * n * 8;
    for (var i = 0; i < n; i = i + 1) {
        store64(idx + i * 8, 0 - 1);
        store64(onst + i * 8, 0);
    }
    var cnt = 0;
    var sp = 0;
    for (var r = 0; r < n; r = r + 1) {
        if (load64(idx + r * 8) < 0) {
            store64(idx + r * 8, cnt);
            store64(low + r * 8, cnt);
            cnt = cnt + 1;
            store64(stk + sp * 8, r);
            sp = sp + 1;
            store64(onst + r * 8, 1);
            store64(cur + r * 8, 0);
            store64(cs, r);
            var csp = 1;
            while (csp > 0) {
                var v = load64(cs + (csp - 1) * 8);
                var j = load64(cur + v * 8);
                if (j < n) {
                    store64(cur + v * 8, j + 1);
                    if ((ganita_mat_get(A, v, j) & 0x7FFF_FFFF_FFFF_FFFF) != 0) {
                        if (load64(idx + j * 8) < 0) {
                            store64(idx + j * 8, cnt);
                            store64(low + j * 8, cnt);
                            cnt = cnt + 1;
                            store64(stk + sp * 8, j);
                            sp = sp + 1;
                            store64(onst + j * 8, 1);
                            store64(cur + j * 8, 0);
                            store64(cs + csp * 8, j);
                            csp = csp + 1;
                        } else {
                            if (load64(onst + j * 8) == 1 && load64(idx + j * 8) < load64(low + v * 8)) {
                                store64(low + v * 8, load64(idx + j * 8));
                            }
                        }
                    }
                } else {
                    csp = csp - 1;
                    if (csp > 0) {
                        var p = load64(cs + (csp - 1) * 8);
                        if (load64(low + v * 8) < load64(low + p * 8)) { store64(low + p * 8, load64(low + v * 8)); }
                    }
                    if (load64(low + v * 8) == load64(idx + v * 8)) {
                        # v roots a component: pop it, counting its vertices (w1: the other one
                        # of a pair)
                        var csz = 0;
                        var w1 = v;
                        var w = 0 - 1;
                        while (w != v) {
                            sp = sp - 1;
                            w = load64(stk + sp * 8);
                            store64(onst + w * 8, 0);
                            if (w != v) { w1 = w; }
                            csz = csz + 1;
                        }
                        if (csz == 1 && _lext_diag_past(ganita_mat_get(A, v, v), la) == 1) { return 1; }
                        if (csz == 2 && _lext_blk2_past(A, v, w1, la) == 1) { return 1; }
                    }
                }
            }
        }
    }
    return 0;
}

# 1 when lam is provably not A's dominant eigenvalue (the trace floors, then the floors of the
# components of one and two vertices), 0 when it cannot be shown, 2 when the components'
# scratch cannot be allocated. Those components exist only in a reducible A (or one of n = 2),
# so Tarjan runs only there (3.4.0: through 3.3.7 it ran when some |a_ii| was past |lam|, a
# test a pair's floor does not pass through).
fn _lext_not_dominant(A, n, lam) {
    if (_lext_below_rho(A, n, lam) == 1) { return 1; }
    if (n < 2) { return 0; }
    var s = alloc(6 * n * 8);
    if (s == 0) { return 2; }
    if (n > 2 && _lext_reducible(A, n, s) == 0) { return 0; }
    return _lext_scc_floor(A, n, lam, s);
}

# ---- 3.4.0 review: eigen_power's dominance certificate (Gelfand) ----
# log2 |x| for a finite non-zero double x, from its exponent and eleven terms of 2 atanh(s) / ln 2, s =
# (m - 1) / (m + 1), m in [sqrt(1/2), sqrt 2): only multiplies, adds and divides, each rounded alike on
# every target, so these are the same bits on x86_64 and aarch64 (3.4.1 LA4: through LA3 this was
# f64_ln, x87 on the one and fdlibm's polyfill on the other, and a bound at the line could decide
# differently: m = 128, e = -16, x = 41F22F05FB58C101). The tail past the eleventh term is below 3.2e-19 in
# the log2 units returned (2.2e-19 in ln units).
# [measured: LA4 probe lg.py, 2e6 doubles, x86_64 and qemu-aarch64 alike; 125,000 within 3.7 ulps of mpmath, 2026-11-01]
fn _lext_log2abs(x) {
    var m = f64_abs(_lext_xman(x));   # in [1/2, 1)
    var e = _lext_xexp(x);
    if (f64_lt(m, f64_mul(F64_SQRT2, F64_HALF)) == 1) {
        m = f64_add(m, m);
        e = e - 1;
    }
    var s = f64_div(f64_sub(m, F64_ONE), f64_add(m, F64_ONE));
    var z = f64_mul(s, s);
    var t = f64_from(0);
    var k = 21;
    while (k > 0) {
        t = f64_add(f64_mul(t, z), f64_div(F64_ONE, f64_from(k)));
        k = k - 2;
    }
    return f64_add(f64_from(e), f64_div(f64_mul(f64_add(s, s), t), F64_LN2));
}

# x 2^e for an exact power of two and any i64 e, as one or more exact multiplies (a result below
# the normal range is rounded there, once per multiply).
fn _lext_pow2mul(x, e) {
    var y = x;
    var r = e;
    while (r > 1000) { y = f64_mul(y, (1023 + 1000) << 52); r = r - 1000; }
    while (r < 0 - 1000) { y = f64_mul(y, (1023 - 1000) << 52); r = r + 1000; }
    return f64_mul(y, (1023 + r) << 52);
}

# The inertia certificate for an exactly symmetric A (3.4.0, third review): every eigenvalue of
# A lies in (-mu - eps, mu + eps) when both mu I - A and mu I + A have Cholesky factors, and
# lam is then certified because mu + eps < 1.001 |lam|. T holds A row-major (it is rescaled in
# place), W is n x n scratch. 1 certified, 0 refused, -1 undecided (n so large that the rounding
# slack could pass 2^-12 |lam|; the caller falls back to Gelfand's squarings).
# Rigour. In units where |lam| = ls is in [1, 2), mu = ls (1 + 2^-11) rounded. The factored matrix
# is C = fl(mu -+ a_ii) on the diagonal and -+a_ij off it, so mu I -+ A = C - diag(rho) with
# |rho_i| <= 2u c_ii (u = 2^-53). A Cholesky factorization of C that runs to completion gives
# R^T R = C + dC with |dC| <= gamma_(n+1) |R^T| |R| (Higham, Accuracy and Stability, Thm 10.3);
# since (R^T R)_ii <= c_ii / (1 - gamma) and by Cauchy-Schwarz, |dC_ij| <= gamma / (1 - gamma)
# sqrt(c_ii c_jj), so ||dC||_2 <= gamma / (1 - gamma) tr(C) (the bound of Rump's isspd). R^T R is
# positive semidefinite, so the smallest eigenvalue of mu I -+ A is at least
# -(gamma / (1 - gamma) + 2u) tr(C) >= -2 (n + 2) u tr(C) for (n + 1) u <= 1/4: that is eps, with
# tr(C) <= (1 + 2^-20) sum_i (mu + |a_ii|) and n^2 2^-1000 more for anything that underflows
# (every |entry| is at most 4 here, so nothing overflows). It is used only while eps <= 2^-12 ls,
# which holds to n of about 7e5; then every eigenvalue is within ls (1 + 2^-11 + 2^-12) <
# 1.001 ls. A factorization that fails refuses the answer: some eigenvalue is then within the
# factorization's rounding of mu or beyond, about 1.0005 |lam|, so the answer is short of rho(A).
fn _lext_sym_cert(T, W, n, la) {
    var mx = f64_from(0);
    for (var q = 0; q < n * n; q = q + 1) {
        var aq = f64_abs(load64(T + q * 8));
        if (f64_gt(aq, mx) == 1) { mx = aq; }
    }
    # |a_ij| <= ||A||_2 = rho(A) for a symmetric A: an entry past 2 |lam| refutes it at once
    if (f64_gt(f64_mul(mx, F64_HALF), la) == 1) { return 0; }
    var k = 1 - _lext_xexp(la);
    for (var q1 = 0; q1 < n * n; q1 = q1 + 1) { store64(T + q1 * 8, _lext_pow2mul(load64(T + q1 * 8), k)); }
    var ls = _lext_pow2mul(la, k);
    var mu = f64_mul(ls, 0x3FF0020000000000);   # 1 + 2^-11 = 1.00048828125
    var tr = f64_from(0);
    for (var i = 0; i < n; i = i + 1) { tr = f64_add(tr, f64_add(mu, f64_abs(load64(T + (i * n + i) * 8)))); }
    tr = f64_mul(tr, 0x3FF0000100000000);   # 1 + 2^-20 = 1.00000095367431640625
    var g2 = f64_mul(f64_from(2 * (n + 2)), 0x3CA0000000000000);   # 2^-53
    var eps = f64_add(f64_mul(g2, tr), f64_mul(f64_from(n * n), 0x0170000000000000));   # 2^-1000
    if (f64_le(eps, f64_mul(ls, 0x3F30000000000000)) == 0) { return 0 - 1; }   # 2^-12
    for (var sg = 0; sg < 2; sg = sg + 1) {
        # W = mu I - A (sg = 0) or mu I + A (sg = 1), lower triangle, factored in place
        for (var r = 0; r < n; r = r + 1) {
            for (var c = 0; c <= r; c = c + 1) {
                var a = load64(T + (r * n + c) * 8);
                if (sg == 0) { a = f64_neg(a); }
                if (r == c) { a = f64_add(mu, a); }
                store64(W + (r * n + c) * 8, a);
            }
        }
        for (var j = 0; j < n; j = j + 1) {
            var wj = W + j * n * 8;
            var s = load64(wj + j * 8);
            for (var k2 = 0; k2 < j; k2 = k2 + 1) {
                var lj = load64(wj + k2 * 8);
                s = f64_sub(s, f64_mul(lj, lj));
            }
            # written as "not above", so a NaN pivot fails too
            if (f64_gt(s, 0) == 0) { return 0; }
            var ljj = f64_sqrt(s);
            store64(wj + j * 8, ljj);
            for (var i2 = j + 1; i2 < n; i2 = i2 + 1) {
                var wi = W + i2 * n * 8;
                var t = load64(wi + j * 8);
                for (var k3 = 0; k3 < j; k3 = k3 + 1) {
                    t = f64_sub(t, f64_mul(load64(wi + k3 * 8), load64(wj + k3 * 8)));
                }
                store64(wi + j * 8, f64_div(t, ljj));
            }
        }
    }
    return 1;
}

# The Collatz-Wielandt bound on rho(|T|), so on rho(T), for the n x n row-major T (3.4.1): z (n
# words, positive, kept between calls as a warm start) takes five steps z <- |T| z / max(|T| z)
# with each entry floored at 2^-52, and the bound is max_i (|T| z)_i / z_i of the last, which holds
# for ANY positive z. w: n words of scratch. +Inf when a sum is not finite (no bound).
fn _lext_cw(T, n, z, w) {
    var b = F64_POS_INF;
    for (var it = 0; it < 5; it = it + 1) {
        var zm = f64_from(0);
        b = f64_from(0);
        for (var r = 0; r < n; r = r + 1) {
            var pt = T + r * n * 8;
            var pe = pt + n * 8;
            var pz = z;
            var a = f64_from(0);
            while (pt < pe) {
                a = f64_add(a, f64_mul(f64_abs(load64(pt)), load64(pz)));
                pt = pt + 8;
                pz = pz + 8;
            }
            # written as "not below +Inf", so a NaN sum ends it too
            if (f64_lt(a, F64_POS_INF) == 0) { return F64_POS_INF; }
            store64(w + r * 8, a);
            if (f64_gt(a, zm) == 1) { zm = a; }
            var q = f64_div(a, load64(z + r * 8));
            if (f64_gt(q, b) == 1) { b = q; }
        }
        if ((zm & 0x7FFF_FFFF_FFFF_FFFF) == 0) { return b; }   # |T| z = 0: T = 0, the bound 0
        for (var r2 = 0; r2 < n; r2 = r2 + 1) {
            var zv = f64_div(load64(w + r2 * 8), zm);
            if (f64_lt(zv, 0x3CB0000000000000) == 1) { zv = 0x3CB0000000000000; }   # 2^-52
            store64(z + r2 * 8, zv);
        }
    }
    return b;
}

# Wielandt's deflation of B' = M (the certificate's frame, D^-1 B D times a power of two), in
# place, by a similarity: with x = D^-1 v / (D^-1 v)_p (p the index of v's largest |entry|, so
# x_p = 1 and |x_i| <= 1), S = I + (x - e_p) e_p^T has S^-1 = I - (x - e_p) e_p^T, and
# S^-1 M S keeps row p of M off the diagonal, holds y_p = (M x)_p at (p, p), y_i - x_i y_p
# (the residual of the answer: about 1e-12 of |y|) down column p, and M_ij - x_i M_pj elsewhere.
# Then row p is divided and column p multiplied by the power of two 2^k nearest
# sqrt(sum_j |row p| / max_i |column p|), which leaves both at about the geometric mean of the
# two, far below 1. The result is similar to B, so Gelfand's bound on it bounds rho(B) as any
# similarity does, whatever x is; for a right answer the dominant eigenvalue's direction is now
# e_p in both its right and left vectors, and the squarings no longer wait out its condition.
# Returns 1 (done), 0 (left as it was: v has a NaN, or a part at 2^900 past the frame).
fn _lext_deflate(M, n, v, mv, d, y) {
    var p = 0;
    var vp = f64_from(0);
    for (var i = 0; i < n; i = i + 1) {
        var va = f64_abs(load64(v + i * 8));
        if (f64_eq(va, va) == 0) { return 0; }
        if (f64_gt(va, vp) == 1) {
            vp = va;
            p = i;
        }
    }
    var sg = F64_ONE;
    if (f64_lt(load64(v + p * 8), 0) == 1) { sg = f64_neg(F64_ONE); }
    # x into y's second half (y: the squarings' n^2 scratch), M x into its first
    var x = y + n * 8;
    for (var i1 = 0; i1 < n; i1 = i1 + 1) {
        var xi = f64_mul(f64_div(f64_div(load64(v + i1 * 8), mv), load64(d + i1 * 8)), sg);
        store64(x + i1 * 8, xi);
    }
    store64(x + p * 8, F64_ONE);
    for (var r = 0; r < n; r = r + 1) {
        var acc = f64_from(0);
        for (var c = 0; c < n; c = c + 1) {
            acc = f64_add(acc, f64_mul(load64(M + (r * n + c) * 8), load64(x + c * 8)));
        }
        store64(y + r * 8, acc);
    }
    var yp = load64(y + p * 8);
    for (var r2 = 0; r2 < n; r2 = r2 + 1) {
        if (r2 != p) {
            var xr = load64(x + r2 * 8);
            for (var c2 = 0; c2 < n; c2 = c2 + 1) {
                if (c2 != p) {
                    var o = (r2 * n + c2) * 8;
                    store64(M + o, f64_sub(load64(M + o), f64_mul(xr, load64(M + (p * n + c2) * 8))));
                }
            }
            store64(M + (r2 * n + p) * 8, f64_sub(load64(y + r2 * 8), f64_mul(xr, yp)));
        }
    }
    store64(M + (p * n + p) * 8, yp);
    var bs = f64_from(0);
    var rm = f64_from(0);
    for (var j = 0; j < n; j = j + 1) {
        if (j != p) {
            bs = f64_add(bs, f64_abs(load64(M + (p * n + j) * 8)));
            var ra = f64_abs(load64(M + (j * n + p) * 8));
            if (f64_gt(ra, rm) == 1) { rm = ra; }
        }
    }
    if ((bs & 0x7FFF_FFFF_FFFF_FFFF) == 0) { return 1; }
    var k = 0;
    if ((rm & 0x7FFF_FFFF_FFFF_FFFF) == 0) {
        k = 0 - 900;
    } else {
        k = (_lext_xexp(rm) - _lext_xexp(bs)) / 2;
    }
    if (k < 0 - 900) { k = 0 - 900; }
    if (k > 0) { k = 0; }
    if (k != 0) {
        for (var j2 = 0; j2 < n; j2 = j2 + 1) {
            if (j2 != p) {
                store64(M + (p * n + j2) * 8, _lext_pow2mul(load64(M + (p * n + j2) * 8), k));
                store64(M + (j2 * n + p) * 8, _lext_pow2mul(load64(M + (j2 * n + p) * 8), 0 - k));
            }
        }
    }
    return 1;
}
# Gelfand's frame (3.4.0, `_lext_gelfand`): B' = D^-1 (A / |lam|) D times 2^-e0 into M (e0 to
# eo[0]) and A into T, with the two m = 1 bounds taken in the same pass. Returns 1 when they
# certify (or A = 0), 0 otherwise.
fn _lext_gf_form(A, n, la, d, di, M, T, eo) {
    var thr = 0x3F57A013FACA6C6B;   # ln(1.001)/ln(2) = 0.00144197417390648...
    # B' into M with both m = 1 bounds in the same pass. With |lam| in [2^-900, 2^900] each factor
    # d_c / (d_r |lam|) is a normal double; an overflow sends the matrix to the wide form below.
    # An entry of B' that underflows is below 2^-1022, against a largest row sum of at least
    # rho(B'), which is 1 for a right answer.
    var e0 = 0;
    var wide = 1;
    var lmin = (1023 - 900) << 52;   # 2^-900
    var lmax = (1023 + 900) << 52;   # 2^900
    if (f64_ge(la, lmin) == 1 && f64_le(la, lmax) == 1) {
        var il = f64_div(F64_ONE, la);
        var bm = f64_from(0);
        var rs1 = f64_from(0);
        var ss1 = f64_from(0);
        for (var r = 0; r < n; r = r + 1) {
            var ri = f64_mul(load64(di + r * 8), il);
            var s1 = f64_from(0);
            for (var c = 0; c < n; c = c + 1) {
                var a = ganita_mat_get(A, r, c);
                store64(T + (r * n + c) * 8, a);
                var bv = f64_mul(a, f64_mul(load64(d + c * 8), ri));
                store64(M + (r * n + c) * 8, bv);
                var ba = f64_abs(bv);
                if (f64_gt(ba, bm) == 1) { bm = ba; }
                s1 = f64_add(s1, ba);
                var b0 = f64_mul(a, il);
                ss1 = f64_add(ss1, f64_mul(b0, b0));
            }
            if (f64_gt(s1, rs1) == 1 || f64_eq(s1, s1) == 0) { rs1 = s1; }
        }
        if (f64_lt(rs1, F64_POS_INF) == 1) {
            if ((bm & 0x7FFF_FFFF_FFFF_FFFF) == 0) { return 1; }   # A = 0: rho(A) = 0
            if (f64_le(_lext_log2abs(rs1), thr) == 1) { return 1; }
            if (f64_gt(ss1, 0) == 1 && f64_lt(ss1, F64_POS_INF) == 1) {
                if (f64_le(f64_mul(F64_HALF, _lext_log2abs(ss1)), thr) == 1) { return 1; }
            }
            e0 = _lext_xexp(bm);
            if (e0 >= 0 - 1022 && e0 <= 1022) {
                var p0 = (1023 - e0) << 52;
                for (var q0 = 0; q0 < n * n; q0 = q0 + 1) { store64(M + q0 * 8, f64_mul(load64(M + q0 * 8), p0)); }
            } else {
                for (var q1 = 0; q1 < n * n; q1 = q1 + 1) {
                    store64(M + q1 * 8, _lext_pow2mul(load64(M + q1 * 8), 0 - e0));
                }
            }
            wide = 0;
        }
    }
    if (wide == 1) {
        # far from the normal range: each entry as w 2^e, w = m_a / m_lam * d_c / d_r, then one
        # rounding into M at the common exponent (the m = 1 bounds are left to the squarings)
        var emax = 0 - 1000000;
        for (var r2 = 0; r2 < n; r2 = r2 + 1) {
            for (var c2 = 0; c2 < n; c2 = c2 + 1) {
                var aw = ganita_mat_get(A, r2, c2);
                if ((aw & 0x7FFF_FFFF_FFFF_FFFF) != 0) {
                    var dd2 = f64_mul(load64(d + c2 * 8), load64(di + r2 * 8));
                    var w2 = f64_mul(f64_div(_lext_xman(aw), _lext_xman(la)), dd2);
                    var ew = _lext_xexp(w2) + _lext_xexp(aw) - _lext_xexp(la);
                    if (ew > emax) { emax = ew; }
                }
            }
        }
        if (emax == 0 - 1000000) { return 1; }   # A = 0
        for (var r3 = 0; r3 < n; r3 = r3 + 1) {
            for (var c3 = 0; c3 < n; c3 = c3 + 1) {
                var a3 = ganita_mat_get(A, r3, c3);
                store64(T + (r3 * n + c3) * 8, a3);
                var w3 = f64_from(0);
                if ((a3 & 0x7FFF_FFFF_FFFF_FFFF) != 0) {
                    var dd3 = f64_mul(load64(d + c3 * 8), load64(di + r3 * 8));
                    w3 = f64_mul(f64_div(_lext_xman(a3), _lext_xman(la)), dd3);
                    w3 = _lext_xld(_lext_xman(w3), _lext_xexp(w3) + _lext_xexp(a3) - _lext_xexp(la) - emax);
                }
                store64(M + (r3 * n + c3) * 8, w3);
            }
        }
        e0 = emax;
    }
    store64(eo, e0);
    return 0;
}

# Gelfand's squarings (3.4.0, `_lext_gelfand`) on M = B' 2^-e0, at most kmax of them: 1 when
# min(||T||_inf, ||D T D^-1||_F, cw(T))^(1/m) 2^(...) certifies (d = 0: the Frobenius norm of T
# itself), 0 otherwise. T: n^2 words of scratch; z: n words, cw's warm start; zs: n words of scratch.
fn _lext_gf_loop(M, T, n, d, di, z, zs, e0, thr, kmax) {
    # T_r += m_rl M_l a row at a time: f64v_scale into zs (cw's scratch, free until cw runs) then
    # f64v_add, a separately rounded multiply and add on every target, so the sums are the scalar
    # loop's bit for bit, and with `_lext_log2abs` a bound at the edge decides alike everywhere (3.4.1
    # LA3, LA4; f64v_axpy is fused on aarch64, f64v_fmadd too). Both step in pairs, so an odd n's last
    # entry is added alone.
    var ne = n - (n & 1);
    var e_int = e0;
    var m = 1;
    for (var k = 1; k <= kmax; k = k + 1) {
        # T = M M, row by row; the largest row sum of |T|, and the sum of squares of D T D^-1
        var rs = f64_from(0);
        var ss = f64_from(0);
        for (var r5 = 0; r5 < n; r5 = r5 + 1) {
            var tr = T + r5 * n * 8;
            var mr = M + r5 * n * 8;
            for (var c4 = 0; c4 < n; c4 = c4 + 1) { store64(tr + c4 * 8, f64_from(0)); }
            for (var l = 0; l < n; l = l + 1) {
                var ml = load64(mr + l * 8);
                if ((ml & 0x7FFF_FFFF_FFFF_FFFF) != 0) {
                    var rl = M + l * n * 8;
                    f64v_scale(zs, rl, ml, ne);   # pairs: the even part (see above)
                    f64v_add(tr, tr, zs, ne);
                    if (ne < n) {
                        store64(tr + ne * 8, f64_add(load64(tr + ne * 8), f64_mul(ml, load64(rl + ne * 8))));
                    }
                }
            }
            var s5 = f64_from(0);
            var dr = F64_ONE;
            if (d != 0) { dr = load64(d + r5 * 8); }
            for (var c6 = 0; c6 < n; c6 = c6 + 1) {
                var sum = load64(tr + c6 * 8);
                s5 = f64_add(s5, f64_abs(sum));
                var u5 = sum;
                if (d != 0) { u5 = f64_mul(sum, f64_mul(dr, load64(di + c6 * 8))); }
                ss = f64_add(ss, f64_mul(u5, u5));
            }
            if (f64_gt(s5, rs) == 1 || f64_eq(s5, s5) == 0) { rs = s5; }
        }
        if ((rs & 0x7FFF_FFFF_FFFF_FFFF) == 0) { return 1; }   # B'^m = 0 here: rho(B) = 0
        if (f64_lt(rs, F64_POS_INF) == 0) { return 0; }   # not finite: no bound
        m = 2 * m;
        # log2 of the bound: (log2 min(||T||_inf, ||D T D^-1||_F, cw(T)) + 2 e_int) / m
        var ln = _lext_log2abs(rs);
        if (f64_gt(ss, 0) == 1 && f64_lt(ss, F64_POS_INF) == 1) {
            var lf = f64_mul(F64_HALF, _lext_log2abs(ss));
            if (f64_lt(lf, ln) == 1) { ln = lf; }
        }
        var cwm = _lext_cw(T, n, z, zs);
        if (f64_gt(cwm, 0) == 1 && f64_lt(cwm, F64_POS_INF) == 1) {
            var lc = _lext_log2abs(cwm);
            if (f64_lt(lc, ln) == 1) { ln = lc; }
        }
        var lb = f64_div(f64_add(ln, f64_from(2 * e_int)), f64_from(m));
        if (f64_le(lb, thr) == 1) { return 1; }
        var ex = _lext_xexp(rs);
        if (ex >= 0 - 1022 && ex <= 1022) {
            var p6 = (1023 - ex) << 52;
            for (var q6 = 0; q6 < n * n; q6 = q6 + 1) { store64(M + q6 * 8, f64_mul(load64(T + q6 * 8), p6)); }
        } else {
            for (var q7 = 0; q7 < n * n; q7 = q7 + 1) {
                store64(M + q7 * 8, _lext_pow2mul(load64(T + q7 * 8), 0 - ex));
            }
        }
        e_int = 2 * e_int + ex;
    }
    return 0;
}

# Gelfand's bound, on every answer of eigen_power's iteration (3.4.0 review: through the first
# review only where a normality gate fired, which let short answers through). For B = A / |lam|,
# any positive diagonal D, any submultiplicative norm and any m,
# rho(A) / |lam| = rho(B) <= ||B^m||^(1/m) = ||D^-1 B^m D||^(1/m).
# D is |v| (the answer's vector, its largest |entry| 1), each entry kept at or above 2^-60: any
# positive D gives a valid bound, and this one makes the m = 1 infinity-norm bound the
# Collatz-Wielandt ratio max_i (|B| |v|)_i / |v_i|, which is 1 to rounding for a non-negative A
# (or any A whose signs match its Perron vector's): those are certified in the one pass over A
# that forms B' = D^-1 B D. An exactly symmetric A that pass does not certify goes to
# `_lext_sym_cert` (two Cholesky factorizations) instead (3.4.0, third review). Otherwise B' is
# squared (m = 2, 4, ...), renormalised by a power of
# two each time with the exponent carried as an integer, and after each squaring the bound is the
# smaller of ||B'^m||_inf and ||B^m||_F = ||D B'^m D^-1||_F (both n^2 from the product just
# formed). It is 1 as soon as the bound is at most 1.001 (no eigenvalue is larger than
# 1.001 |lam| in modulus), 0 when 24 squarings leave it above, 2 when the scratch cannot be
# allocated. A right answer's bound falls to 1 like C^(1/m): for a symmetric A the Frobenius
# bound is (1 + sum_i>1 (lambda_i / lam)^(2m))^(1/2m), so a few squarings; for a non-normal A,
# C is the dominant eigenvalue's condition (||x y^T|| for its right and left eigenvectors) and
# the squarings needed grow like log2(log2 C / 0.00144). An answer short of rho never falls below
# rho(B). Each squaring is n^3 multiply-adds. lam = 0 (or not finite) is never certified: no
# finite bound shows rho(A) <= 0.
# ⭐ 3.4.1 — a non-symmetric A is first deflated by the answer's own vector (`_lext_deflate`, a
# similarity, so the bounds stay valid whatever the vector is), which takes the C factor above
# out of the squarings, and every power is bounded by its Collatz-Wielandt ratio too (`_lext_cw`)
# beside the two norms. Those squarings stop after 12; an answer they leave undecided is put
# through 3.4.0's frame and squarings (`_lext_gf_form`, `_lext_gf_loop`, with cw added, which can
# only lower a bound), so every answer 3.4.0 certified is certified. On the n = 30 / 60 / 100
# strongly non-normal fixtures (dominant 2 on diag(U(-1, 1)) + 3 triu(randn) / sqrt(n) +
# 0.01 tril(randn)) the squarings go 5 / 8 / 8 -> 3 / 3 / 3. Each squaring's product is formed a
# row at a time with f64v_scale then f64v_add (3.4.1 LA3; the even part of the row in pairs, an odd
# n's last entry alone, since both step in pairs and would write one past an odd row): the
# certificate then costs 157 / 773 / 2,800 us (3.4.0's: 535 / 6,470 / 30,050 us; the first 3.4.1
# form's, four scalar entries a step: 320 / 2,100 / 8,870 us), and a certified answer takes 308 /
# 1,750 / 4,940 us in all, less than 3.4.0's UNcertified run (358 / 2,545 / 5,630 us): 0.86 / 0.69 /
# 0.88 times it (each tree against its own build without the certificate, same boot, medians of 5
# interleaved runs, twice). A multiply and an add are rounded separately on every target, as in
# the scalar loop, so every product is the earlier form's bit for bit (3,500 of LA's family matrices:
# every verdict and answer unchanged), and every log2 is formed from those operations too (3.4.1 LA4,
# `_lext_log2abs`), so for the same A, lam and v no verdict here depends on the target. f64v_axpy would
# take 5 / 6 / 10% less in all (277 / 1,550 / 4,181 against 291 / 1,648 / 4,670 us, the same run) but is
# fused on aarch64, so a bound at the edge would decide differently there.
# [measured: LA3 probes timcert.py (LA fx_tim.json), famcmp.py (famA / famB); 3.4.0, 3.4.1-dev, this tree, 2026-11-01]
# On 4,200 matrices of the 3.4.0 review families (nearly
# reducible, general, complex pair, nine ordinary kinds, triangular-dominant, seed-orthogonal
# symmetric and non-normal; n = 2..20) every answer, error and vector bit of the 4,170 with
# n >= 3 is 3.4.0's; the 30 2 x 2s now take `_lext_power_2x2`, and its 21 answers are each the
# correctly rounded root (17 of them moved).
# [measured: LA probes tim.py (fx seed 5) and epdiff.py (fam.py seeds 1-5), 3.4.0 base and this tree, 2026-10-31]
fn _lext_gelfand(A, n, lam, v, T, z, zs) {
    var la = f64_abs(lam);
    if (f64_eq(la, 0) == 1 || f64_lt(la, F64_POS_INF) == 0) { return 0; }
    var M = alloc(n * n * 8);
    var d = alloc(n * 8);
    var di = alloc(n * 8);
    if (M == 0 || d == 0 || di == 0) { return 2; }
    var mv = f64_from(0);
    for (var i = 0; i < n; i = i + 1) {
        var va = f64_abs(load64(v + i * 8));
        if (f64_gt(va, mv) == 1) { mv = va; }
    }
    var dfl = (1023 - 60) << 52;   # 2^-60
    var usev = 0;
    if (f64_lt(mv, F64_POS_INF) == 1 && f64_gt(mv, 0) == 1) { usev = 1; }
    for (var i1 = 0; i1 < n; i1 = i1 + 1) {
        var dv = F64_ONE;
        if (usev == 1) { dv = f64_div(f64_abs(load64(v + i1 * 8)), mv); }
        # written as "not at or above", so a NaN entry takes the floor too
        if (f64_ge(dv, dfl) == 0) { dv = dfl; }
        store64(d + i1 * 8, dv);
        store64(di + i1 * 8, f64_div(F64_ONE, dv));
    }
    var thr = 0x3F57A013FACA6C6B;   # ln(1.001)/ln(2) = 0.00144197417390648...
    var eo: i64[1];
    if (_lext_gf_form(A, n, la, d, di, M, T, &eo) == 1) { return 1; }
    var e0 = load64(&eo);
    # An exactly symmetric A (T holds it, from the pass above) is certified by its inertia: two
    # Cholesky factorizations, n^3 / 3 multiply-adds in all, where the squarings cost n^3 each.
    var sym = 1;
    for (var r6 = 0; r6 < n && sym == 1; r6 = r6 + 1) {
        for (var c6 = r6 + 1; c6 < n; c6 = c6 + 1) {
            if (load64(T + (r6 * n + c6) * 8) != load64(T + (c6 * n + r6) * 8)) { sym = 0; }
        }
    }
    if (sym == 1) {
        # -1 (undecided) is decided before M is touched, and T is the squarings' scratch
        var scr = _lext_sym_cert(T, M, n, la);
        if (scr >= 0) { return scr; }
    }
    # ⭐ 3.4.1 — A NON-SYMMETRIC A IS DEFLATED FIRST, AND EVERY POWER IS ALSO BOUNDED BY ITS
    # COLLATZ-WIELANDT RATIO. Through 3.4.0 the squarings had to wait out two things: the dominant
    # eigenvalue's own condition (||D^-1 B^m D||_inf tends to |y|^T |x| / |y^T x| times |lam|^m, so
    # a factor K costs log2(log2 K / 0.00144) squarings) and the transient of the rest. Deflating
    # by the answer's own vector (`_lext_deflate`, a similarity) removes the first; bounding |T| by
    # max_i (|T| z)_i / z_i with z from five power steps (`_lext_cw`: any positive z bounds rho(|T|),
    # and so rho(T); this z nears the Perron vector, where the bound is the best any diagonal
    # scaling gives) cuts the second. The product T = M M is formed row by row (each T_rc still
    # summed over l in order from +0, by f64v_scale and f64v_add since 3.4.1 LA3: a multiply
    # then an add, rounded separately on every target, so the inf and Frobenius bounds are 3.4.0's
    # bit for bit; see above).
    for (var q9 = 0; q9 < n; q9 = q9 + 1) { store64(z + q9 * 8, F64_ONE); }
    if (usev == 1) {
        if (_lext_deflate(M, n, v, mv, d, T) == 1) {
            var cw1 = _lext_cw(M, n, z, zs);
            if (f64_lt(cw1, F64_POS_INF) == 1) {
                if (f64_le(f64_add(_lext_log2abs(cw1), f64_from(e0)), thr) == 1) { return 1; }
            }
            if (_lext_gf_loop(M, T, n, 0, 0, z, zs, e0, thr, 12) == 1) { return 1; }
            # undecided: 3.4.0's frame again, with cw beside its two norms
            if (_lext_gf_form(A, n, la, d, di, M, T, &eo) == 1) { return 1; }
            for (var q10 = 0; q10 < n; q10 = q10 + 1) { store64(z + q10 * 8, F64_ONE); }
        }
    }
    return _lext_gf_loop(M, T, n, d, di, z, zs, e0, thr, 24);
}

# w = A u for eigen_power's iteration (3.4.1), from Af, a row-major copy of A: each w_i summed
# over j in order from +0, as the ganita_mat_get loop it replaced did, so every bit is the same.
# Returns the largest |w_i| (the first, on a tie), with its sign.
fn _lext_flat_mv(Af, n, u, w) {
    var mx = f64_from(0);
    var pa = Af;
    for (var i = 0; i < n; i = i + 1) {
        var sum = f64_from(0);
        var pu = u;
        var pe = pa + n * 8;
        while (pa < pe) {
            sum = f64_add(sum, f64_mul(load64(pa), load64(pu)));
            pa = pa + 8;
            pu = pu + 8;
        }
        store64(w + i * 8, sum);
        if (f64_gt(f64_abs(sum), f64_abs(mx)) == 1) { mx = sum; }
    }
    return mx;
}

# eigen_power's growth test (3.3.5): flag the components of iterate k (v) that grew more than
# twofold since iterate k-1 (vp); if any, run one more pass and return 1 only when a flagged
# component grows more than twofold again. w and fl are scratch (n each); with sc_e > 0, u is
# the scaled-input buffer and is refilled from v. Af: A row-major (3.4.1, `_lext_flat_mv`).
# ⚠ No rounding floor under the flag: one (four steps of v's subnormal grid) was tried, and on
# the 115,000 sweep matrices and 32,000 family matrices it moved only vector components below
# 1e-150 of one matrix, so it is not kept.
# [measured: floor / no-floor builds over the eigen_power sweeps and review families, 2026-10-11; cycc 6.6.14]
fn _lext_grows(Af, n, u, vp, v, sc_e, w, fl) {
    var any = 0;
    for (var i = 0; i < n; i = i + 1) {
        store64(fl + i * 8, 0);
        if (f64_gt(f64_abs(load64(v + i * 8)), f64_mul(F64_TWO, f64_abs(load64(vp + i * 8)))) == 1) {
            store64(fl + i * 8, 1);
            any = 1;
        }
    }
    if (any == 0) { return 0; }
    # one more pass: w = A u', u' = v (times 2^-sc_e after a switch)
    var up = v;
    if (sc_e != 0) {
        var dn = (1023 - sc_e) << 52;
        for (var i2 = 0; i2 < n; i2 = i2 + 1) { store64(u + i2 * 8, f64_mul(load64(v + i2 * 8), dn)); }
        up = u;
    }
    var mx = _lext_flat_mv(Af, n, up, w);
    # A pass that overflows or vanishes confirms nothing, with no test of its own: with mx
    # infinite each finite w_t / mx is +-0 and an infinite one NaN, and with mx = 0 every w_t is
    # 0 and the quotient NaN, and `>` is false for all of them.
    for (var t = 0; t < n; t = t + 1) {
        if (load64(fl + t * 8) == 1) {
            var v3 = f64_div(load64(w + t * 8), mx);
            if (f64_gt(f64_abs(v3), f64_mul(F64_TWO, f64_abs(load64(v + t * 8)))) == 1) { return 1; }
        }
    }
    return 0;
}

# ---- 3.4.0: eigen_power's exact spectrum ----
# When every strongly connected component of A's graph is a single vertex, A is a permutation of
# a triangular matrix and its eigenvalues are exactly its diagonal entries. Then the dominant
# eigenvalue needs no iteration, and an iteration on a non-normal A of this kind could stop above
# rho(A) (see eigen_power).

# Tarjan's strongly connected components, the traversal of `_lext_scc_floor`: 1 when every
# component has at most maxc vertices, with ord[0..n) the vertices in the order Tarjan completes
# them, every component's vertices after all the vertices they reach (an edge i -> j for a_ij != 0,
# i != j), a component's vertices consecutive, and csz[t] its size at its first place t (0 at the
# others); 0 at the first component that has more. s: 6 n words of scratch.
fn _lext_scc_order(A, n, s, ord, csz, maxc) {
    var idx = s;
    var low = s + n * 8;
    var onst = s + 2 * n * 8;
    var stk = s + 3 * n * 8;
    var cs = s + 4 * n * 8;
    var cur = s + 5 * n * 8;
    for (var i = 0; i < n; i = i + 1) {
        store64(idx + i * 8, 0 - 1);
        store64(onst + i * 8, 0);
    }
    var cnt = 0;
    var sp = 0;
    var no = 0;
    for (var r = 0; r < n; r = r + 1) {
        if (load64(idx + r * 8) < 0) {
            store64(idx + r * 8, cnt);
            store64(low + r * 8, cnt);
            cnt = cnt + 1;
            store64(stk + sp * 8, r);
            sp = sp + 1;
            store64(onst + r * 8, 1);
            store64(cur + r * 8, 0);
            store64(cs, r);
            var csp = 1;
            while (csp > 0) {
                var v = load64(cs + (csp - 1) * 8);
                var j = load64(cur + v * 8);
                if (j < n) {
                    store64(cur + v * 8, j + 1);
                    if ((ganita_mat_get(A, v, j) & 0x7FFF_FFFF_FFFF_FFFF) != 0) {
                        if (load64(idx + j * 8) < 0) {
                            store64(idx + j * 8, cnt);
                            store64(low + j * 8, cnt);
                            cnt = cnt + 1;
                            store64(stk + sp * 8, j);
                            sp = sp + 1;
                            store64(onst + j * 8, 1);
                            store64(cur + j * 8, 0);
                            store64(cs + csp * 8, j);
                            csp = csp + 1;
                        } else {
                            if (load64(onst + j * 8) == 1 && load64(idx + j * 8) < load64(low + v * 8)) {
                                store64(low + v * 8, load64(idx + j * 8));
                            }
                        }
                    }
                } else {
                    csp = csp - 1;
                    if (csp > 0) {
                        var p = load64(cs + (csp - 1) * 8);
                        if (load64(low + v * 8) < load64(low + p * 8)) { store64(low + p * 8, load64(low + v * 8)); }
                    }
                    if (load64(low + v * 8) == load64(idx + v * 8)) {
                        # v roots a component: the stack from v up
                        var bot = sp - 1;
                        while (load64(stk + bot * 8) != v) { bot = bot - 1; }
                        if (sp - bot > maxc) { return 0; }
                        for (var kk = sp - 1; kk >= bot; kk = kk - 1) {
                            var wv = load64(stk + kk * 8);
                            store64(onst + wv * 8, 0);
                            store64(ord + no * 8, wv);
                            store64(csz + no * 8, 0);
                            if (kk == sp - 1) { store64(csz + no * 8, sp - bot); }
                            no = no + 1;
                        }
                        sp = bot;
                    }
                }
            }
        }
    }
    return 1;
}

# eigen_power's answer when A's spectrum is its diagonal (and, since 3.4.1, when every component of
# A's graph has one or two vertices: those with a pair go to `_lext_power_blk`, whose returns
# these are too). Returns
#   0  answered: out_val = the dominant a_kk, out_vec its eigenvector (largest component +1);
#   1  not this case (a component of three or more vertices, an irreducible 2 x 2, which
#      `_lext_power_2x2` answers, or a NaN or infinite entry), nothing written;
#   HSB_ERR_NO_CONVERGENCE when the dominant |a_kk| is shared by entries of both signs (no real
#      dominant eigenvalue), HSB_ERR_ALLOC when the scratch cannot be allocated; nothing written.
# The eigenvector solves (A - lambda I) v = 0 by substitution in Tarjan's completion order, so
# every vertex is solved after the ones it reaches: v_k = 1, and every other
# v_i = sum_j a_ij v_j / (lambda - a_ii). A vertex that does not reach k gets 0 (its sum is 0).
# ⭐ 3.4.0 review — k is the LAST vertex in completion order with a_kk = lambda, so a REPEATED
# dominant value (defective, non-defective, or 0 in a nilpotent A) is answered too: a vertex
# that reaches k completes after it, so its a_ii is not lambda and the division is defined;
# every other lambda-vertex gets 0. diag(1, 1, 1 - 2^-30), [[2, 1], [0, 2]] and the zero 2 x 2
# were NO_CONVERGENCE (the iteration's) and now come back exactly: e_1 (the last of the
# repeated 1s), e_0, e_1. Every component is carried as m * 2^e (`_lext_power_wide`'s
# representation), so a chain of large couplings cannot overflow it or flush it, and the
# largest component is divided out last.
fn _lext_power_exact(A, n, out_val, out_vec) {
    # A sink component, one with no edge leaving it, exists whenever every component has one or two
    # vertices, and a row of it has at most one entry off the diagonal. A dense row leaves this scan
    # at its second off-diagonal entry, so a matrix with no such row costs O(n) reads here.
    var sink = 0;
    for (var i = 0; i < n && sink == 0; i = i + 1) {
        var ho = 0;
        for (var j = 0; j < n && ho < 2; j = j + 1) {
            if (j != i && (ganita_mat_get(A, i, j) & 0x7FFF_FFFF_FFFF_FFFF) != 0) { ho = ho + 1; }
        }
        if (ho < 2) { sink = 1; }
    }
    if (sink == 0) { return 1; }
    if (_lext_mat_all_finite(A, n, n) == 0) { return 1; }
    var s = alloc(6 * n * 8);
    var ord = alloc(n * 8);
    var csz = alloc(n * 8);
    var vm = alloc(n * 8);
    var ve = alloc(n * 8);
    if (s == 0 || ord == 0 || csz == 0 || vm == 0 || ve == 0) { return HSB_ERR_ALLOC; }
    if (_lext_scc_order(A, n, s, ord, csz, 2) == 0) { return 1; }
    # 3.4.1 LA2: a component of two vertices goes to `_lext_power_blk` (an irreducible 2 x 2 to
    # `_lext_power_2x2`, through eigen_power's own hook)
    var pairs = 0;
    for (var tp = 0; tp < n; tp = tp + 1) {
        if (load64(csz + tp * 8) == 2) { pairs = 1; }
    }
    if (pairs == 1) {
        if (n == 2) { return 1; }
        return _lext_power_blk(A, n, ord, csz, out_val, out_vec);
    }

    # The dominant modulus; a tie of opposite signs has no real dominant eigenvalue.
    var dmax = f64_from(0);
    for (var i2 = 0; i2 < n; i2 = i2 + 1) {
        var da = f64_abs(ganita_mat_get(A, i2, i2));
        if (f64_gt(da, dmax) == 1) { dmax = da; }
    }
    var lam = 0 - 1;
    var k = 0 - 1;
    for (var t3 = 0; t3 < n; t3 = t3 + 1) {
        var r3 = load64(ord + t3 * 8);
        var d3 = ganita_mat_get(A, r3, r3);
        if (f64_eq(f64_abs(d3), dmax) == 1) {
            if (k >= 0 && f64_eq(d3, lam) == 0) { return HSB_ERR_NO_CONVERGENCE; }
            lam = d3;
            k = r3;   # the last in completion order
        }
    }

    for (var i4 = 0; i4 < n; i4 = i4 + 1) {
        store64(vm + i4 * 8, 0);
        store64(ve + i4 * 8, 0);
    }
    # lambda - a_ii without overflow: halved when |lambda| >= 2^1022 (exact, since then
    # lambda is normal and an a_ii that rounds is below every rounding of the difference)
    var big_l = 0;
    if (f64_ge(dmax, 0x7FD0000000000000) == 1) { big_l = 1; }   # 2^1022
    for (var t = 0; t < n; t = t + 1) {
        var r = load64(ord + t * 8);
        if (r == k) {
            store64(vm + r * 8, 0x3FE0000000000000);   # 1 = 0.5 * 2^1
            store64(ve + r * 8, 1);
        } else {
            var top = 0;
            var have = 0;
            for (var c = 0; c < n; c = c + 1) {
                var a = ganita_mat_get(A, r, c);
                if (c != r && (a & 0x7FFF_FFFF_FFFF_FFFF) != 0 && (load64(vm + c * 8) & 0x7FFF_FFFF_FFFF_FFFF) != 0) {
                    var te = _lext_xexp(a) + load64(ve + c * 8);
                    if (have == 0 || te > top) { top = te; }
                    have = 1;
                }
            }
            if (have == 1) {
                var acc = f64_from(0);
                for (var c2 = 0; c2 < n; c2 = c2 + 1) {
                    var a2 = ganita_mat_get(A, r, c2);
                    var m2 = load64(vm + c2 * 8);
                    if (c2 != r && (a2 & 0x7FFF_FFFF_FFFF_FFFF) != 0 && (m2 & 0x7FFF_FFFF_FFFF_FFFF) != 0) {
                        var tm = f64_mul(_lext_xman(a2), m2);
                        var te2 = _lext_xexp(tm) + _lext_xexp(a2) + load64(ve + c2 * 8) - top;
                        acc = f64_add(acc, _lext_xld(_lext_xman(tm), te2));
                    }
                }
                if ((acc & 0x7FFF_FFFF_FFFF_FFFF) != 0) {
                    var arr = ganita_mat_get(A, r, r);
                    var dd = 0;
                    var de = 0;
                    if (big_l == 1) {
                        dd = f64_sub(f64_mul(lam, 0x3FE0000000000000), f64_mul(arr, 0x3FE0000000000000));   # halves
                        de = 1;
                    } else {
                        dd = f64_sub(lam, arr);
                    }
                    var q = f64_div(acc, _lext_xman(dd));
                    store64(vm + r * 8, _lext_xman(q));
                    store64(ve + r * 8, _lext_xexp(q) + top - _lext_xexp(dd) - de);
                }
            }
        }
    }
    # Divide out the largest component (the first, on a tie), compared by exponent, then mantissa.
    var mi = 0 - 1;
    for (var i5 = 0; i5 < n; i5 = i5 + 1) {
        var m5 = load64(vm + i5 * 8);
        if ((m5 & 0x7FFF_FFFF_FFFF_FFFF) != 0) {
            if (mi < 0) {
                mi = i5;
            } else {
                var e5 = load64(ve + i5 * 8);
                var eb = load64(ve + mi * 8);
                if (e5 > eb || (e5 == eb && f64_gt(f64_abs(m5), f64_abs(load64(vm + mi * 8))) == 1)) { mi = i5; }
            }
        }
    }
    var mm = load64(vm + mi * 8);
    var me = load64(ve + mi * 8);
    for (var i6 = 0; i6 < n; i6 = i6 + 1) {
        var m6 = load64(vm + i6 * 8);
        if ((m6 & 0x7FFF_FFFF_FFFF_FFFF) == 0) {
            store64(out_vec + i6 * 8, f64_from(0));
        } else {
            var q6 = f64_div(m6, mm);
            store64(out_vec + i6 * 8, _lext_xld(_lext_xman(q6), _lext_xexp(q6) + load64(ve + i6 * 8) - me));
        }
    }
    store64(out_val, lam);
    return 0;
}

# ---- 3.4.1 (LA2): eigen_power's exact path through components of two vertices ----
# A wide double-double (`_lext_w2_add`'s form) from a double.
fn _lext_w_from(w, x) {
    _lext_w_set(w, x, f64_from(0), 0);
    return 0;
}
# out <- x y for wide double-doubles x, y (out may alias neither): the product of the hi parts exact
# (Dekker), the cross terms beside it, the exponents added.
fn _lext_w2_mul(x, y, out) {
    var t2: i64[2];
    _lext_two_prod(load64(x), load64(y), &t2);
    var lo = f64_add(load64(&t2 + 8), f64_add(f64_mul(load64(x), load64(y + 8)), f64_mul(load64(x + 8), load64(y))));
    _lext_two_sum(load64(&t2), lo, &t2);
    _lext_w_set(out, load64(&t2), load64(&t2 + 8), load64(x + 16) + load64(y + 16));
    return 0;
}
# out <- x / y for wide double-doubles (y not 0; out may alias neither): q = xh / yh, then the
# remainder x - q y formed with Dekker's exact q yh, divided again.
fn _lext_w2_div(x, y, out) {
    var xh = load64(x);
    if ((xh & 0x7FFF_FFFF_FFFF_FFFF) == 0) {
        _lext_w_set(out, f64_from(0), f64_from(0), 0);
        return 0;
    }
    var yh = load64(y);
    var q = f64_div(xh, yh);
    var t2: i64[2];
    _lext_two_prod(q, yh, &t2);
    var rem = f64_sub(f64_sub(xh, load64(&t2)), load64(&t2 + 8));
    rem = f64_add(rem, f64_sub(load64(x + 8), f64_mul(q, load64(y + 8))));
    _lext_two_sum(q, f64_div(rem, yh), &t2);
    _lext_w_set(out, load64(&t2), load64(&t2 + 8), load64(x + 16) - load64(y + 16));
    return 0;
}
# s sqrt(Q 2^gq) / 2 (Q >= 0, s = +-1) as a wide double-double into w: Q's top limbs as a pair, its
# square root with one Newton correction on Dekker's exact r^2 (as `_lext_power_2x2` forms sqrt D).
fn _lext_bn_sqrt2(qb, gq, sgn, w) {
    store64(w, f64_from(0));
    store64(w + 8, f64_from(0));
    store64(w + 16, 0);
    if (load64(qb) <= 0) { return 0; }
    var qw: i64[3];
    _lext_bn_wide(qb, gq - 2, &qw);   # Q / 4
    var dm = load64(&qw);
    var dl = load64(&qw + 8);
    var de = load64(&qw + 16);
    if ((de & 1) != 0) {
        dm = f64_mul(dm, F64_TWO);
        dl = f64_mul(dl, F64_TWO);
        de = de - 1;
    }
    var r = f64_sqrt(dm);
    var t2: i64[2];
    _lext_two_prod(r, r, &t2);
    var cor = f64_div(f64_add(f64_sub(f64_sub(dm, load64(&t2)), load64(&t2 + 8)), dl), f64_mul(F64_TWO, r));
    var sm = F64_ONE;
    if (sgn < 0) { sm = f64_neg(F64_ONE); }
    _lext_w_set(w, f64_mul(sm, r), f64_mul(sm, cor), de / 2);
    return 0;
}
# L = (|P| 2^gp + sqrt(Q 2^gq)) / 2 (Q >= 0) as a wide double-double into w (within about 2^-100).
fn _lext_bn_lest(pb, gp, qb, gq, w) {
    var pw: i64[3];
    var rw: i64[3];
    _lext_bn_wide(pb, gp - 1, &pw);
    if (f64_lt(load64(&pw), 0) == 1) {
        store64(&pw, f64_neg(load64(&pw)));
        store64(&pw + 8, f64_neg(load64(&pw + 8)));
    }
    _lext_bn_sqrt2(qb, gq, 1, &rw);
    _lext_w2_add(&pw, &rw, w);
    return 0;
}
# The double nearest L = (|P| 2^gp + sqrt(Q 2^gq)) / 2 (Q >= 0): a double-double estimate, then
# `_lext_p2_round`. -1 when L rounds past DBL_MAX. s: four integers of scratch.
fn _lext_bn_round(pb, gp, qb, gq, s) {
    var lw: i64[3];
    _lext_bn_lest(pb, gp, qb, gq, &lw);
    var y = f64_abs(_lext_xld(f64_add(load64(&lw), load64(&lw + 8)), load64(&lw + 16)));
    if (f64_lt(y, F64_POS_INF) == 0) { y = 0x7FEF_FFFF_FFFF_FFFF; }
    var sg = load64(pb);
    if (sg < 0) { store64(pb, 1); }
    var r = _lext_p2_round(pb, gp, qb, gq, y, s);
    store64(pb, sg);
    return r;
}

# sign((A1 + sqrt Q1) - (A2 + sqrt Q2)) for A = |P| 2^gp, Q 2^gq (Q >= 0; a P or Q of 0 needs no
# exponent), decided on exact integers: with R = A2 - A1 and X = sqrt Q1 - sqrt Q2, the signs of R
# and X (that of Q1 - Q2) decide unless both are positive (or both negative, the same with the roles
# swapped); then X > R exactly when Z = Q1 - Q2 - R^2 > 2 R sqrt Q2, i.e. Z > 0 and Z^2 > 4 R^2 Q2.
# s: eight integers of 302 words (Z^2 reaches 2^8410).
fn _lext_cmp_qi(p1, gp1, q1, gq1, p2, gp2, q2, gq2, s) {
    var a1 = s;
    var a2 = s + 2416;
    var x1 = s + 4832;
    var x2 = s + 7248;
    var r = s + 9664;
    var big = 1 << 40;
    var g = big;
    if (load64(p1) != 0 && 2 * gp1 < g) { g = 2 * gp1; }
    if (load64(q1) != 0 && gq1 < g) { g = gq1; }
    if (load64(p2) != 0 && 2 * gp2 < g) { g = 2 * gp2; }
    if (load64(q2) != 0 && gq2 < g) { g = gq2; }
    if (g == big) { return 0; }   # both 0
    if ((g & 1) != 0) { g = g - 1; }   # even (floor), so sqrt(2^g) = 2^(g / 2)
    var hg = g / 2;
    _lext_bn_copy(p1, a1);
    if (load64(a1) != 0) {
        store64(a1, 1);
        _lext_bn_shl(a1, gp1 - hg);
    }
    _lext_bn_copy(p2, a2);
    if (load64(a2) != 0) {
        store64(a2, 1);
        _lext_bn_shl(a2, gp2 - hg);
    }
    _lext_bn_copy(q1, x1);
    if (load64(x1) != 0) { _lext_bn_shl(x1, gq1 - g); }
    _lext_bn_copy(q2, x2);
    if (load64(x2) != 0) { _lext_bn_shl(x2, gq2 - g); }
    _lext_bn_add(a2, a1, 1, r);   # R
    _lext_bn_add(x1, x2, 1, a1);   # Q1 - Q2 (a1 is free now)
    var sx = load64(a1);
    var sr = load64(r);
    if (sx >= 0 && sr <= 0) {
        if (sx == 0 && sr == 0) { return 0; }
        return 1;
    }
    if (sx <= 0 && sr >= 0) { return 0 - 1; }
    if (sx > 0) { return _lext_cmp_qi_pos(x1, x2, r, s + 12080); }
    store64(r, 1);   # -R > 0
    return 0 - _lext_cmp_qi_pos(x2, x1, r, s + 12080);
}
# sign(sqrt X1 - sqrt X2 - R) for exact X1 > X2 >= 0 and R > 0. s: three integers of 302 words.
fn _lext_cmp_qi_pos(x1, x2, r, s) {
    var z = s;
    var u = s + 2416;
    var v = s + 4832;
    _lext_bn_mul(r, r, u);
    _lext_bn_add(x1, x2, 1, z);
    _lext_bn_add(z, u, 1, z);   # Z = X1 - X2 - R^2
    if (load64(z) < 0) { return 0 - 1; }
    if (load64(z) == 0) {
        if (load64(x2) == 0) { return 0; }
        return 0 - 1;
    }
    _lext_bn_mul(u, x2, v);   # R^2 X2
    _lext_bn_shl(v, 2);       # 4 R^2 X2
    _lext_bn_mul(z, z, u);    # Z^2
    _lext_bn_add(u, v, 1, z);
    return load64(z);
}
fn _lext_bn_copy(x, y) {
    var nl = load64(x + 8);
    for (var i = 0; i < nl + 2; i = i + 1) { store64(y + i * 8, load64(x + i * 8)); }
    return 0;
}

# eigen_power's answer when every strongly connected component of A's graph has one or two vertices
# and at least one has two (`_lext_power_exact` answers the rest). ord / csz: Tarjan's completion
# order from `_lext_scc_order` (csz[t] = 2 at the first vertex of a pair, 0 at the second, 1 for a
# single vertex). A's eigenvalues are its components': a_kk, and the roots of each 2 x 2 block
# [[a, b], [c, d]], (P +- sqrt Q) / 2 with P = a + d, Q = (a - d)^2 + 4bc exact (`_lext_pq`), a complex
# pair when Q < 0 (modulus sqrt(P^2 - Q) / 2). Each component's largest modulus is put as
# (A + sqrt Q) / 2 with A = |P|, 2|a_kk| or 0, and the dominant decided exactly: correctly rounded
# moduli (`_lext_bn_round`) that differ order their values; equal ones are compared on integers
# (`_lext_cmp_qi`). Returns
#   0  answered: out_val = the dominant eigenvalue, correctly rounded; out_vec its eigenvector
#      (largest component +1), by substitution through the blocks in completion order: the chosen
#      component's own eigenvector (a 2 x 2's from whichever of (lambda - d, c), (b, lambda - a) does
#      not cancel, as `_lext_power_2x2`), then for each later component C, (A_CC - lambda I) v_C =
#      -sum A_Cw v_w, a 2 x 2 solved by Cramer's rule with det(lambda I - A_CC) formed from double-
#      double lambda - a, lambda - d and an exact bc; every value a wide double-double, (h + l) 2^e;
#   HSB_ERR_NO_CONVERGENCE  no real dominant eigenvalue (the largest modulus is a complex pair's, a
#      block's +-sqrt Q, or shared by values of both signs), or one past DBL_MAX;
#   HSB_ERR_ALLOC  the vector's 3 n words cannot be allocated;
#   1  a lambda - a_rr or a block's det(lambda I - A_CC) that rounds to 0 (lambda from a block within
#      2^-100 of another component's eigenvalue, never met): the iteration takes it, as before 3.4.1.
# Nothing is written unless 0 is returned.
# A repeated dominant value takes the LAST component holding it in completion order, as the
# single-vertex path does: every component that reaches it completes after it and does not hold it,
# so each solve is defined.
fn _lext_power_blk(A, n, ord, csz, out_val, out_vec) {
    var bw = 160 * 8;
    var bsa: i64[4016];   # ten integers of 160 words and eight of 302, on the stack
    var bs = &bsa;
    var vw = alloc(3 * n * 8);
    if (vw == 0) { return HSB_ERR_ALLOC; }
    var cp = bs;              # the candidate's |P| (or 2|a_kk|), Q
    var cq = bs + bw;
    var ch = bs + 2 * bw;     # a - d
    var bp = bs + 3 * bw;     # the best so far
    var bq = bs + 4 * bw;
    var sc = bs + 5 * bw;     # four integers: `_lext_pq`'s, `_lext_p2_side`'s scratch
    var cs = bs + 10 * bw;    # eight of 302 words: `_lext_cmp_qi`'s
    var gpq: i64[2];
    var xo: i64[2];
    var bt = 0 - 1;           # the best component's first index in ord
    var brho = f64_from(0);
    var bsg = 1;
    var bgp = 0;
    var bgq = 0;
    var bbad = 0;
    var conflict = 0;
    var t = 0;
    while (t < n) {
        var sz = load64(csz + t * 8);
        var cgp = 0;
        var cgq = 0;
        var csg = 1;
        var cbad = 0;
        var crho = f64_from(0);
        store64(cq, 0);
        store64(cq + 8, 0);
        if (sz == 1) {
            var x = ganita_mat_get(A, load64(ord + t * 8), load64(ord + t * 8));
            _lext_xint(x, &xo);
            var mx = load64(&xo);
            if (mx < 0) {
                mx = 0 - mx;
                csg = 0 - 1;
            }
            _lext_bn_set(cp, mx, 0);
            cgp = load64(&xo + 8) + 1;   # 2 |x|
            crho = f64_abs(x);
        } else {
            var i = load64(ord + t * 8);
            var j = load64(ord + (t + 1) * 8);
            _lext_pq(ganita_mat_get(A, i, i), ganita_mat_get(A, i, j), ganita_mat_get(A, j, i), ganita_mat_get(A, j, j),
              cp, cq, ch, sc, &gpq);
            cgp = load64(&gpq);
            cgq = load64(&gpq + 8);
            if (load64(cp) < 0) { csg = 0 - 1; }
            if (load64(cq) < 0) {
                # a complex pair: modulus sqrt(P^2 - Q) / 2, put as (0 + sqrt(P^2 - Q)) / 2
                cbad = 1;
                var g2 = cgq;
                if (load64(cp) != 0 && 2 * cgp < g2) { g2 = 2 * cgp; }
                _lext_bn_shl(cq, cgq - g2);
                if (load64(cp) != 0) {
                    _lext_bn_mul(cp, cp, ch);
                    _lext_bn_shl(ch, 2 * cgp - g2);
                } else {
                    store64(ch, 0);
                    store64(ch + 8, 0);
                }
                _lext_bn_add(ch, cq, 1, cq);
                cgq = g2;
                store64(cp, 0);
                store64(cp + 8, 0);
            } else {
                if (load64(cp) == 0 && load64(cq) > 0) { cbad = 1; }   # +-sqrt(Q) / 2
            }
            crho = _lext_bn_round(cp, cgp, cq, cgq, sc);
            if (crho == 0 - 1) { return HSB_ERR_NO_CONVERGENCE; }   # a modulus past DBL_MAX
        }
        var take = 0;
        if (bt < 0) {
            take = 1;
        } else {
            if (crho > brho) {   # non-negative doubles order as their bits
                take = 1;
            } else {
                if (crho == brho) {
                    var cmp = _lext_cmp_qi(cp, cgp, cq, cgq, bp, bgp, bq, bgq, cs);
                    if (cmp > 0) { take = 1; }
                    if (cmp == 0) {
                        if (cbad == 1 || bbad == 1 || csg != bsg) {
                            conflict = 1;
                        } else {
                            take = 2;   # the same value, later in completion order
                        }
                    }
                }
            }
        }
        if (take > 0) {
            if (take == 1) { conflict = cbad; }
            bt = t;
            brho = crho;
            bsg = csg;
            bgp = cgp;
            bgq = cgq;
            bbad = cbad;
            _lext_bn_copy(cp, bp);
            _lext_bn_copy(cq, bq);
        }
        t = t + sz;
    }
    if (conflict == 1) { return HSB_ERR_NO_CONVERGENCE; }
    var lam = brho;
    if (bsg < 0 && (brho & 0x7FFF_FFFF_FFFF_FFFF) != 0) { lam = brho | 0x8000_0000_0000_0000; }
    # lambda as a wide double-double: exact for a single vertex, within 2^-100 from a block
    var lw: i64[3];
    if (load64(csz + bt * 8) == 1) {
        _lext_w_from(&lw, lam);
    } else {
        _lext_bn_lest(bp, bgp, bq, bgq, &lw);
        if (bsg < 0) {
            store64(&lw, f64_neg(load64(&lw)));
            store64(&lw + 8, f64_neg(load64(&lw + 8)));
        }
    }
    # every component a wide double-double, three words at vw + 24 i
    for (var i0 = 0; i0 < 3 * n; i0 = i0 + 1) { store64(vw + i0 * 8, 0); }
    var w1: i64[3];
    var w2: i64[3];
    var w3: i64[3];
    var w4: i64[3];
    t = 0;
    while (t < n) {
        var sz2 = load64(csz + t * 8);
        var r = load64(ord + t * 8);
        if (t == bt) {
            if (sz2 == 1) {
                _lext_w_from(vw + r * 24, F64_ONE);
            } else {
                # the block's own eigenvector, as `_lext_power_2x2` forms it: h = (a - d) / 2 and s sqrt D
                var rj = load64(ord + (t + 1) * 8);
                var hw: i64[3];
                var sw: i64[3];
                _lext_pq(ganita_mat_get(A, r, r), ganita_mat_get(A, r, rj), ganita_mat_get(A, rj, r),
                  ganita_mat_get(A, rj, rj), cp, cq, ch, sc, &gpq);
                _lext_bn_wide(ch, load64(&gpq) - 1, &hw);
                _lext_bn_sqrt2(cq, load64(&gpq + 8), bsg, &sw);
                var hneg = 0;
                if (f64_lt(load64(&hw), 0) == 1) { hneg = 1; }
                var sneg = 0;
                if (bsg < 0) { sneg = 1; }
                if ((load64(&hw) & 0x7FFF_FFFF_FFFF_FFFF) == 0 || hneg == sneg) {
                    _lext_w2_add(&hw, &sw, vw + r * 24);   # (lambda - d, c)
                    _lext_w_from(vw + rj * 24, ganita_mat_get(A, rj, r));
                } else {
                    store64(&hw, f64_neg(load64(&hw)));
                    store64(&hw + 8, f64_neg(load64(&hw + 8)));
                    _lext_w_from(vw + r * 24, ganita_mat_get(A, r, rj));   # (b, lambda - a)
                    _lext_w2_add(&hw, &sw, vw + rj * 24);
                }
            }
        } else {
            if (t > bt) {
                # rhs = sum over the solved components outside this one of a_rw v_w, in double-double
                var rj2 = r;
                if (sz2 == 2) { rj2 = load64(ord + (t + 1) * 8); }
                var have = 0;
                for (var k = 0; k < sz2; k = k + 1) {
                    var row = r;
                    var dst = &w3;
                    if (k == 1) {
                        row = rj2;
                        dst = &w4;
                    }
                    _lext_w_from(dst, f64_from(0));
                    for (var c = 0; c < n; c = c + 1) {
                        var a = ganita_mat_get(A, row, c);
                        if (c != r && c != rj2 && (a & 0x7FFF_FFFF_FFFF_FFFF) != 0
                          && (load64(vw + c * 24) & 0x7FFF_FFFF_FFFF_FFFF) != 0) {
                            _lext_w_from(&w1, a);
                            _lext_w2_mul(&w1, vw + c * 24, &w2);
                            _lext_w2_add(dst, &w2, &w1);
                            store64(dst, load64(&w1));
                            store64(dst + 8, load64(&w1 + 8));
                            store64(dst + 16, load64(&w1 + 16));
                        }
                    }
                    if ((load64(dst) & 0x7FFF_FFFF_FFFF_FFFF) != 0) { have = 1; }
                }
                if (have == 1) {
                    if (sz2 == 1) {
                        # v_r = rhs / (lambda - a_rr), the difference from lambda's double-double
                        _lext_w_from(&w1, f64_neg(ganita_mat_get(A, r, r)));
                        _lext_w2_add(&lw, &w1, &w2);
                        if ((load64(&w2) & 0x7FFF_FFFF_FFFF_FFFF) == 0) { return 1; }   # see the doc
                        _lext_w2_div(&w3, &w2, vw + r * 24);
                    } else {
                        # det(lambda I - A_CC) exactly when lambda is a diagonal entry (3.4.1 LA3)
                        var dsc = 0;
                        if (load64(csz + bt * 8) == 1) { dsc = bs; }
                        if (_lext_blk_solve(A, r, rj2, &lw, &w3, &w4, vw, dsc) != 0) { return 1; }
                    }
                }
            }
        }
        t = t + sz2;
    }
    # Divide out the largest component (the first, on a tie), compared by exponent, then mantissa,
    # each quotient rounded once.
    var mi = 0 - 1;
    var mim = f64_from(0);
    for (var i5 = 0; i5 < n; i5 = i5 + 1) {
        var m5 = f64_abs(f64_add(load64(vw + i5 * 24), load64(vw + i5 * 24 + 8)));
        if ((m5 & 0x7FFF_FFFF_FFFF_FFFF) != 0) {
            var e5 = load64(vw + i5 * 24 + 16);
            if (mi < 0) {
                mi = i5;
                mim = m5;
            } else {
                var eb = load64(vw + mi * 24 + 16);
                if (e5 > eb || (e5 == eb && f64_gt(m5, mim) == 1)) {
                    mi = i5;
                    mim = m5;
                }
            }
        }
    }
    if (mi < 0) { return HSB_ERR_NO_CONVERGENCE; }   # unreachable: the chosen component's vector is not 0
    for (var i6 = 0; i6 < n; i6 = i6 + 1) {
        if ((load64(vw + i6 * 24) & 0x7FFF_FFFF_FFFF_FFFF) == 0) {
            store64(out_vec + i6 * 8, f64_from(0));
        } else {
            _lext_w2_div(vw + i6 * 24, vw + mi * 24, &w1);
            store64(out_vec + i6 * 8, _lext_xld(f64_add(load64(&w1), load64(&w1 + 8)), load64(&w1 + 16)));
        }
    }
    store64(out_vec + mi * 8, F64_ONE);
    store64(out_val, lam);
    return 0;
}
# (lambda I - A_CC) v_C = rhs for the block C = {i, j} (lambda, rhs_i, rhs_j wide double-doubles):
# det = (lambda - a)(lambda - d) - bc, v_i = ((lambda - d) rhs_i + b rhs_j) / det,
# v_j = (c rhs_i + (lambda - a) rhs_j) / det, into vw (three words per component). det is formed
# EXACTLY when lambda is a double (s != 0, four integers of scratch: `_lext_blk_det`), so it carries
# no error however close lambda is to an eigenvalue of A_CC (3.4.1 LA3: from the double-double
# product it was off by 2^-104 of its terms, and with det cancelling to 2^-71 of them a component
# came back 6.3e4 ulps off; R2-LA S2); for lambda a block's root (s = 0) it is the double-double
# product, within about 2^-104 of |lambda - a| |lambda - d| + |bc|. Returns 0, or 1 when det comes
# out 0 (exactly, or lambda within its double-double's 2^-100 of an eigenvalue of A_CC; see the
# caller).
# [measured: R2-LA probe n1run.py (3.4.1-dev) and LA3 probe n1run3.py (3.4.1-dev, this tree), 2026-11-01]
fn _lext_blk_solve(A, i, j, lw, ri, rj, vw, s) {
    var xa: i64[3];
    var xd: i64[3];
    var t1: i64[3];
    var t2: i64[3];
    var t3: i64[3];
    var dt: i64[3];
    var ni: i64[3];
    var tp: i64[2];
    var bb = ganita_mat_get(A, i, j);
    var cc = ganita_mat_get(A, j, i);
    _lext_w_from(&t1, f64_neg(ganita_mat_get(A, i, i)));
    _lext_w2_add(lw, &t1, &xa);   # lambda - a
    _lext_w_from(&t1, f64_neg(ganita_mat_get(A, j, j)));
    _lext_w2_add(lw, &t1, &xd);   # lambda - d
    if (s != 0) {
        var lx = _lext_xld(load64(lw), load64(lw + 16));   # lambda, exactly
        if (_lext_blk_det(lx, ganita_mat_get(A, i, i), bb, cc, ganita_mat_get(A, j, j), s, &dt) == 1) { return 1; }
    } else {
        _lext_w2_mul(&xa, &xd, &t2);
        _lext_two_prod(_lext_xman(bb), f64_neg(_lext_xman(cc)), &tp);   # -bc, exactly, on mantissas
        _lext_w_set(&t3, load64(&tp), load64(&tp + 8), _lext_xexp(bb) + _lext_xexp(cc));
        _lext_w2_add(&t2, &t3, &dt);
        if ((load64(&dt) & 0x7FFF_FFFF_FFFF_FFFF) == 0) { return 1; }
    }
    var bw: i64[3];
    _lext_w_from(&bw, bb);
    _lext_w2_mul(&xd, ri, &t1);
    _lext_w2_mul(&bw, rj, &t2);
    _lext_w2_add(&t1, &t2, &ni);
    _lext_w2_div(&ni, &dt, vw + i * 24);
    _lext_w_from(&bw, cc);
    _lext_w2_mul(&bw, ri, &t1);
    _lext_w2_mul(&xa, rj, &t2);
    _lext_w2_add(&t1, &t2, &ni);
    _lext_w2_div(&ni, &dt, vw + j * 24);
    return 0;
}

# det(lambda I - [[a, b], [c, d]]) = (lambda - a)(lambda - d) - bc for doubles lambda, a, b, c, d, formed
# EXACTLY as integers at a common power of two (`_lext_bn_*`; every value below 2^4200, within the
# 160-word integers), then as a wide value into out (`_lext_bn_wide`: within about 2^-106 relative). Returns
# 1 when it is exactly 0, else 0. s: four integers of 160 words (3.4.1 LA3).
fn _lext_blk_det(lam, a, b, c, d, s, out) {
    var x = s;
    var y = s + 1280;
    var z = s + 2560;
    var u = s + 3840;
    var g1 = _lext_bn_dsub(lam, a, x, u);   # (lambda - a) 2^-g1
    var g2 = _lext_bn_dsub(lam, d, y, u);   # (lambda - d) 2^-g2
    _lext_bn_mul(x, y, z);
    var gz = g1 + g2;
    var xo: i64[2];
    _lext_xint(b, &xo);
    _lext_bn_set(x, load64(&xo), 0);
    var gu = load64(&xo + 8);
    _lext_xint(c, &xo);
    _lext_bn_set(y, load64(&xo), 0);
    gu = gu + load64(&xo + 8);
    _lext_bn_mul(x, y, u);   # b c at 2^gu (b, c are not 0)
    var g = gu;
    if (load64(z) != 0 && gz < g) { g = gz; }
    if (load64(z) != 0) { _lext_bn_shl(z, gz - g); }
    _lext_bn_shl(u, gu - g);
    _lext_bn_add(z, u, 1, x);
    if (load64(x) == 0) { return 1; }
    _lext_bn_wide(x, g, out);
    return 0;
}
# x <- (p - q) 2^-g for doubles p, q, exactly; returns g (0 when both are 0). t: a scratch integer.
fn _lext_bn_dsub(p, q, x, t) {
    var xo: i64[2];
    _lext_xint(p, &xo);
    var mp = load64(&xo);
    var ep = load64(&xo + 8);
    _lext_xint(q, &xo);
    var mq = load64(&xo);
    var eq = load64(&xo + 8);
    var g = 0;
    if (mp != 0) { g = ep; }
    if (mq != 0 && (mp == 0 || eq < g)) { g = eq; }
    _lext_bn_set(x, mp, ep - g);
    _lext_bn_set(t, mq, eq - g);
    _lext_bn_add(x, t, 1, x);
    return g;
}

# ---- 3.4.1: eigen_power's irreducible 2 x 2, from its characteristic polynomial ----
# Wide double-doubles: a value (h + l) 2^e held in three words, h and l doubles with
# |l| <= ulp(h) / 2 (h = 0: the value is 0).
# out <- x + y for wide x, y (each 3 words; out may alias neither). The smaller is moved to the
# larger's exponent (dropped past 2^-1100 of it, where it is below every rounding here), the
# two hi parts added exactly (TwoSum) and the lo parts beside them, and the sum renormalised to
# a hi part in [0.5, 1).
fn _lext_w2_add(x, y, out) {
    var xh = load64(x);
    var yh = load64(y);
    if ((xh & 0x7FFF_FFFF_FFFF_FFFF) == 0) {
        store64(out, yh); store64(out + 8, load64(y + 8)); store64(out + 16, load64(y + 16));
        return 0;
    }
    if ((yh & 0x7FFF_FFFF_FFFF_FFFF) == 0) {
        store64(out, xh); store64(out + 8, load64(x + 8)); store64(out + 16, load64(x + 16));
        return 0;
    }
    var ex = load64(x + 16);
    var ey = load64(y + 16);
    var e = ex;
    var ah = xh;
    var al = load64(x + 8);
    var bh = yh;
    var bl = load64(y + 8);
    var gap = ex - ey;
    if (ey > ex) {
        e = ey;
        ah = yh;
        al = load64(y + 8);
        bh = xh;
        bl = load64(x + 8);
        gap = ey - ex;
    }
    if (gap > 1100) {
        bh = f64_from(0);
        bl = f64_from(0);
    } else {
        bh = _lext_pow2mul(bh, 0 - gap);
        bl = _lext_pow2mul(bl, 0 - gap);
    }
    var ts: i64[2];
    _lext_two_sum(ah, bh, &ts);
    var lo = f64_add(load64(&ts + 8), f64_add(al, bl));
    var hi2: i64[2];
    _lext_two_sum(load64(&ts), lo, &hi2);
    var h = load64(&hi2);
    var l = load64(&hi2 + 8);
    if ((h & 0x7FFF_FFFF_FFFF_FFFF) == 0) {
        store64(out, f64_from(0)); store64(out + 8, f64_from(0)); store64(out + 16, 0);
        return 0;
    }
    var k = _lext_xexp(h);
    store64(out, _lext_pow2mul(h, 0 - k));
    store64(out + 8, _lext_pow2mul(l, 0 - k));
    store64(out + 16, e + k);
    return 0;
}

# ---- 3.4.1: exact integers, for the 2 x 2's correct rounding ----
# A signed integer b: b[0] = its sign (-1, 0 or +1), b[1] = its number of limbs L (0 for 0), b[2 ..
# 2 + L) its magnitude in limbs of base 2^30, least significant first, the top one non-zero. Each
# routine assumes its result fits the caller's buffer (`_lext_power_2x2` sizes them below).
fn _lext_bn_set(b, m, sh) {   # b <- m 2^sh, |m| < 2^62, sh >= 0
    store64(b, 0);
    store64(b + 8, 0);
    if (m == 0) { return 0; }
    var mag = m;
    store64(b, 1);
    if (m < 0) {
        mag = 0 - m;
        store64(b, 0 - 1);
    }
    var nl = 0;
    while (mag != 0) {
        store64(b + 16 + nl * 8, mag & 0x3FFF_FFFF);
        mag = mag >> 30;
        nl = nl + 1;
    }
    store64(b + 8, nl);
    _lext_bn_shl(b, sh);
    return 0;
}
fn _lext_bn_shl(b, sh) {   # b <- b 2^sh in place, sh >= 0
    var nl = load64(b + 8);
    if (nl == 0 || sh <= 0) { return 0; }
    var q = sh / 30;
    var r = sh % 30;
    var nn = nl + q;
    if (r > 0 && (load64(b + 16 + (nl - 1) * 8) >> (30 - r)) != 0) { nn = nn + 1; }
    var i = nn - 1;
    while (i >= q) {
        var s = i - q;
        var v = 0;
        if (s < nl) { v = (load64(b + 16 + s * 8) << r) & 0x3FFF_FFFF; }
        if (r > 0 && s >= 1) { v = v | (load64(b + 16 + (s - 1) * 8) >> (30 - r)); }
        store64(b + 16 + i * 8, v);
        i = i - 1;
    }
    for (var k = 0; k < q; k = k + 1) { store64(b + 16 + k * 8, 0); }
    store64(b + 8, nn);
    return 0;
}
fn _lext_bn_cmpmag(x, y) {   # sign of |x| - |y|
    var lx = load64(x + 8);
    var ly = load64(y + 8);
    if (lx != ly) {
        if (lx > ly) { return 1; }
        return 0 - 1;
    }
    var i = lx - 1;
    while (i >= 0) {
        var u = load64(x + 16 + i * 8);
        var v = load64(y + 16 + i * 8);
        if (u != v) {
            if (u > v) { return 1; }
            return 0 - 1;
        }
        i = i - 1;
    }
    return 0;
}
# |out| <- |x| + |y| (add = 1) or |x| - |y| (add = 0, |x| >= |y|); out may be x or y. Sign untouched.
fn _lext_bn_mag(x, y, add, out) {
    var lx = load64(x + 8);
    var ly = load64(y + 8);
    var nl = lx;
    if (ly > nl) { nl = ly; }
    var cy = 0;
    for (var i = 0; i < nl; i = i + 1) {
        var u = 0;
        var v = 0;
        if (i < lx) { u = load64(x + 16 + i * 8); }
        if (i < ly) { v = load64(y + 16 + i * 8); }
        var t = 0;
        if (add == 1) {
            t = u + v + cy;
            cy = 0;
            if (t >= 0x4000_0000) {
                t = t - 0x4000_0000;
                cy = 1;
            }
        } else {
            t = u - v - cy;   # cy is the borrow here (`>>` is logical, so it is kept as 0 / 1)
            cy = 0;
            if (t < 0) {
                t = t + 0x4000_0000;
                cy = 1;
            }
        }
        store64(out + 16 + i * 8, t);
    }
    if (add == 1 && cy > 0) {
        store64(out + 16 + nl * 8, cy);
        nl = nl + 1;
    }
    while (nl > 0 && load64(out + 16 + (nl - 1) * 8) == 0) { nl = nl - 1; }
    store64(out + 8, nl);
    return 0;
}
fn _lext_bn_add(x, y, neg, out) {   # out <- x + y (neg = 0) or x - y (neg = 1); out may be x or y
    var sx = load64(x);
    var sy = load64(y);
    if (neg == 1) { sy = 0 - sy; }
    if (sy == 0) {
        if (out != x) {
            var lx = load64(x + 8);
            for (var i = 0; i < lx + 2; i = i + 1) { store64(out + i * 8, load64(x + i * 8)); }
        }
        return 0;
    }
    if (sx == 0) {
        if (out != y) {
            var ly = load64(y + 8);
            for (var j = 0; j < ly + 2; j = j + 1) { store64(out + j * 8, load64(y + j * 8)); }
        }
        store64(out, sy);
        return 0;
    }
    if (sx == sy) {
        _lext_bn_mag(x, y, 1, out);
        store64(out, sx);
        return 0;
    }
    var c = _lext_bn_cmpmag(x, y);
    if (c == 0) {
        store64(out, 0);
        store64(out + 8, 0);
        return 0;
    }
    if (c > 0) {
        _lext_bn_mag(x, y, 0, out);
        store64(out, sx);
    } else {
        _lext_bn_mag(y, x, 0, out);
        store64(out, sy);
    }
    return 0;
}
fn _lext_bn_mul(x, y, out) {   # out <- x y; out is neither x nor y
    var lx = load64(x + 8);
    var ly = load64(y + 8);
    store64(out, load64(x) * load64(y));
    if (lx == 0 || ly == 0) {
        store64(out + 8, 0);
        return 0;
    }
    for (var k = 0; k < lx + ly; k = k + 1) { store64(out + 16 + k * 8, 0); }
    for (var i = 0; i < lx; i = i + 1) {
        var u = load64(x + 16 + i * 8);
        var cy = 0;
        for (var j = 0; j < ly; j = j + 1) {
            var t = load64(out + 16 + (i + j) * 8) + u * load64(y + 16 + j * 8) + cy;
            store64(out + 16 + (i + j) * 8, t & 0x3FFF_FFFF);
            cy = t >> 30;
        }
        store64(out + 16 + (i + ly) * 8, cy);
    }
    var nl = lx + ly;
    while (nl > 0 && load64(out + 16 + (nl - 1) * 8) == 0) { nl = nl - 1; }
    store64(out + 8, nl);
    return 0;
}
# b's value 2^g as a wide double-double (`_lext_w_set`), from its top five limbs (at least 121
# significant bits, the rest truncated; the double-double then holds about 2^-106 relative).
fn _lext_bn_wide(b, g, w) {
    var nl = load64(b + 8);
    if (nl == 0) {
        _lext_w_set(w, f64_from(0), f64_from(0), 0);
        return 0;
    }
    var k = nl - 5;
    if (k < 0) { k = 0; }
    var hi = f64_from(0);
    var lo = f64_from(0);
    var t2: i64[2];
    var i = nl - 1;
    while (i >= k) {
        hi = f64_mul(hi, 0x41D0000000000000);   # 2^30
        lo = f64_mul(lo, 0x41D0000000000000);
        _lext_two_sum(hi, f64_from(load64(b + 16 + i * 8)), &t2);
        hi = load64(&t2);
        lo = f64_add(lo, load64(&t2 + 8));
        _lext_two_sum(hi, lo, &t2);
        hi = load64(&t2);
        lo = load64(&t2 + 8);
        i = i - 1;
    }
    if (load64(b) < 0) {
        hi = f64_neg(hi);
        lo = f64_neg(lo);
    }
    _lext_w_set(w, hi, lo, g + 30 * k);
    return 0;
}

# sign(L - mu) for L = (|P| + sqrt(Q 2^gq)) / 2, |P| = pm 2^gp (pm a non-negative exact integer, gp
# unused when it is 0), Q >= 0 an exact integer, and mu = (y1 + y2) / 2, the midpoint of two
# non-negative doubles given as integers m1 2^e1, m2 2^e2 (`_lext_xint`'s form). L > mu exactly when
# sqrt(Q 2^gq) > T = y1 + y2 - |P|: always when T < 0, otherwise when Q 2^gq > T^2, decided on exact
# integers at their common power of two. s: four scratch integers of _LEXT_BNW words each.
fn _lext_p2_side(pm, gp, q, gq, m1, e1, m2, e2, s) {
    var t = s;
    var u = s + 160 * 8;
    var x = s + 320 * 8;
    var y = s + 480 * 8;
    var g = e1;
    if (e2 < g) { g = e2; }
    if (load64(pm) != 0 && gp < g) { g = gp; }
    _lext_bn_set(t, m1, e1 - g);
    _lext_bn_set(u, m2, e2 - g);
    _lext_bn_add(t, u, 0, t);
    if (load64(pm) != 0) {
        for (var i = 0; i < load64(pm + 8) + 2; i = i + 1) { store64(u + i * 8, load64(pm + i * 8)); }
        _lext_bn_shl(u, gp - g);
        _lext_bn_add(t, u, 1, t);
    }
    if (load64(t) < 0) { return 1; }
    _lext_bn_mul(t, t, u);   # T^2 at 2^(2g)
    var c = gq;
    if (2 * g < c) { c = 2 * g; }
    for (var j = 0; j < load64(q + 8) + 2; j = j + 1) { store64(x + j * 8, load64(q + j * 8)); }
    _lext_bn_shl(x, gq - c);
    _lext_bn_shl(u, 2 * g - c);
    _lext_bn_add(x, u, 1, y);
    return load64(y);
}

# P = a + d and Q = (a - d)^2 + 4bc as exact integers: P = pb 2^g[0], Q = qb 2^g[1], and a - d =
# hb 2^g[0] (pb, qb, hb: `_lext_bn_*` integers of 160 words; s: three more, scratch). Every value is a
# double's integer times a power of two, so nothing rounds, overflows or flushes.
fn _lext_pq(a, b, c, d, pb, qb, hb, s, g) {
    var t1 = s;
    var t2b = s + 1280;
    var t3 = s + 2560;
    var xo: i64[2];
    _lext_xint(a, &xo);
    var ma = load64(&xo);
    var ea = load64(&xo + 8);
    _lext_xint(d, &xo);
    var md = load64(&xo);
    var ed = load64(&xo + 8);
    _lext_xint(b, &xo);
    var mb = load64(&xo);
    var eb = load64(&xo + 8);
    _lext_xint(c, &xo);
    var mc = load64(&xo);
    var ec = load64(&xo + 8);
    var gp = 0;
    if (ma != 0) { gp = ea; }
    if (md != 0 && (ma == 0 || ed < gp)) { gp = ed; }
    _lext_bn_set(t1, ma, 0);
    if (ma != 0) { _lext_bn_shl(t1, ea - gp); }
    _lext_bn_set(t2b, md, 0);
    if (md != 0) { _lext_bn_shl(t2b, ed - gp); }
    _lext_bn_add(t1, t2b, 0, pb);
    _lext_bn_add(t1, t2b, 1, hb);   # a - d
    _lext_bn_mul(hb, hb, qb);       # (a - d)^2 at 2^(2 gp)
    _lext_bn_set(t1, mb, 0);
    _lext_bn_set(t2b, mc, 0);
    _lext_bn_mul(t1, t2b, t3);      # bc, and 4 bc at 2^(eb + ec + 2)
    var gq = eb + ec + 2;
    if (load64(qb) != 0 && 2 * gp < gq) { gq = 2 * gp; }
    if (load64(qb) != 0) { _lext_bn_shl(qb, 2 * gp - gq); }
    _lext_bn_shl(t3, eb + ec + 2 - gq);
    _lext_bn_add(qb, t3, 0, qb);
    store64(g, gp);
    store64(g + 8, gq);
    return 0;
}

# The double nearest L = (|P| + sqrt(Q 2^gq)) / 2 (`_lext_p2_side`'s operands), a tie to the even
# one, from any non-negative finite candidate y: y moves up while L is past its upper midpoint and
# down while L is short of its lower one, each decided exactly. Returns its bits, -1 when L rounds
# past DBL_MAX (at or beyond DBL_MAX + ulp / 2, where the upper neighbour is 2^1024), or -2 after 64
# moves (a candidate that far off is never passed here). s: `_lext_p2_side`'s scratch.
fn _lext_p2_round(pm, gp, q, gq, y0, s) {
    var y = y0;
    var yo: i64[2];
    var y2o: i64[2];
    var moved = 1;
    var steps = 0;
    while (moved == 1) {
        moved = 0;
        steps = steps + 1;
        if (steps > 64) { return 0 - 2; }
        _lext_xint(y, &yo);
        if (y == 0x7FEF_FFFF_FFFF_FFFF) {
            store64(&y2o, 1);   # 2^1024, where the rounding to nearest overflows
            store64(&y2o + 8, 1024);
        } else {
            _lext_xint(y + 1, &y2o);
        }
        var cu = _lext_p2_side(pm, gp, q, gq, load64(&yo), load64(&yo + 8), load64(&y2o), load64(&y2o + 8), s);
        if (cu > 0 || (cu == 0 && (y & 1) == 1)) {
            if (y == 0x7FEF_FFFF_FFFF_FFFF) { return 0 - 1; }
            y = y + 1;
            moved = 1;
        } else {
            if (y != 0) {
                _lext_xint(y - 1, &y2o);
                var cl = _lext_p2_side(pm, gp, q, gq, load64(&y2o), load64(&y2o + 8), load64(&yo), load64(&yo + 8), s);
                if (cl < 0 || (cl == 0 && (y & 1) == 1)) {
                    y = y - 1;
                    moved = 1;
                }
            }
        }
    }
    return y;
}

# ---- 3.4.1 (LA3): the 2 x 2's float filter ----
# lambda_1's correct rounding certified in double-double where that is enough, so the exact integers
# (`_lext_p2_exact`) run only where they are needed. In units where |a|, |d| and sqrt|bc| are below 2
# and one of them is at least 1/2 (a and d times 2^k, b times 2^kb and c times 2^(2k - kb), kb putting
# b in [1, 2): a similarity, so the eigenvalues are A's times 2^k; each scaling exact but for an entry
# that falls below 2^-1022, then off by at most 2^-1074), P = a + d is an exact pair (TwoSum), a - d =
# s + t likewise, and Q = 4D = s^2 + 2st + t^2 + 4bc is summed from Dekker's exact products (every
# factor below 8) in double-double: |Q - Q~| <= E = 2^-96 S + 2^-1000 with S = s^2 + |2st| +
# t^2 + |4bc| (the sum's own error is below 27 u^2 S = 2^-101.2 S, u = 2^-53; every flush, product
# below 2^-969 and subnormal rounding together below 2^-1060). With Q~h > 4E (so Q > 0), |sqrt Q -
# sqrt Q~| <= E / sqrt(Q~h); R, Q~'s square root with one Newton step on Dekker's exact r^2, is within
# 6 u^2 R of sqrt Q~; and 2L = |P| + R summed in double-double is within 7 u^2 (2L) more. So 2L lies
# within e = E / sqrt(Q~h) + 2^-99 2L + 2^-1000 of the double-double sum, the 2^-1000 for P's flushed
# entries. Its nearest double y is the correctly rounded 2L when the sum minus y, widened by 2e on
# each side, stays inside y's rounding interval (half a gap up, half a gap down: a quarter ulp below
# a power of two); then lambda_1 = sign(P) y 2^(-k-1), exact while it is a normal double. Otherwise
# 0 is returned (|Q~h| <= 4E: a double root, D cancelling by more than about 40 bits; |P| below
# 2^-1000 in these units; 2L within e of a midpoint, an exact tie included; lambda_1
# subnormal) and the exact path decides; or 1 (never a certified lambda_1's bits), with no real
# dominant root, or none below the overflow line, proved: Q~h < -4E (a complex pair), a = -d exactly
# with Q~h > 4E (+-sqrt(D)), or a certified rounding to 2^1024 or beyond (|lambda_1| past DBL_MAX +
# ulp / 2, where the gap below 2^1024 is DBL_MAX's ulp, half the scaled frame's: the quarter-ulp
# test at a power of two covers it). On success rw is s sqrt(D) = sign(P) R 2^(-k-1), as a wide
# value, and the bits of lambda_1 are returned (|lambda_1| >= 2^-1022).
fn _lext_p2_fast(a, b, c, d, rw) {
    var eb = _lext_xexp(b);
    var em = (eb + _lext_xexp(c) + 4001) / 2 - 2000;   # ceil((eb + ec) / 2): sqrt|bc| < 2^em
    if ((a & 0x7FFF_FFFF_FFFF_FFFF) != 0 && _lext_xexp(a) > em) { em = _lext_xexp(a); }
    if ((d & 0x7FFF_FFFF_FFFF_FFFF) != 0 && _lext_xexp(d) > em) { em = _lext_xexp(d); }
    var k = 1 - em;
    var a1 = _lext_pow2mul(a, k);
    var d1 = _lext_pow2mul(d, k);
    var b1 = _lext_pow2mul(b, 1 - eb);           # in [1, 2)
    var c1 = _lext_pow2mul(c, 2 * k - 1 + eb);   # b1 c1 = b c 2^(2k), |c1| < 2
    var t2: i64[2];
    _lext_two_sum(a1, d1, &t2);
    var ph = load64(&t2);
    var pl = load64(&t2 + 8);
    _lext_two_sum(a1, f64_neg(d1), &t2);
    var s = load64(&t2);
    var t = load64(&t2 + 8);
    _lext_two_prod(s, s, &t2);
    var q1h = load64(&t2);
    var q1l = load64(&t2 + 8);
    _lext_two_prod(f64_mul(0x4010_0000_0000_0000, b1), c1, &t2);   # 4 b c (4 b exact)
    var q4h = load64(&t2);
    var q4l = load64(&t2 + 8);
    var st = f64_mul(f64_mul(F64_TWO, s), t);
    var tt = f64_mul(t, t);
    _lext_two_sum(q1h, q4h, &t2);
    var lo = f64_add(f64_add(f64_add(load64(&t2 + 8), q1l), q4l), f64_add(st, tt));
    _lext_two_sum(load64(&t2), lo, &t2);
    var qh = load64(&t2);
    var ql = load64(&t2 + 8);
    var sS = f64_add(f64_add(q1h, f64_abs(q4h)), f64_add(f64_abs(st), tt));
    var eq = f64_add(f64_mul(sS, 0x39F0_0000_0000_0000), 0x0170_0000_0000_0000);   # 2^-96 S + 2^-1000
    var e4 = f64_mul(0x4010_0000_0000_0000, eq);
    if (f64_lt(qh, f64_neg(e4)) == 1) { return 1; }   # Q < 0: a complex pair
    if (f64_eq(a, f64_neg(d)) == 1) {
        if (f64_gt(qh, e4) == 1) { return 1; }   # P = 0 < Q: +-sqrt(D)
        return 0;
    }
    if (f64_lt(f64_abs(ph), 0x0170_0000_0000_0000) == 1) { return 0; }   # |P| < 2^-1000
    if (f64_gt(qh, e4) == 0) { return 0; }
    var r = f64_sqrt(qh);
    _lext_two_prod(r, r, &t2);
    var cor = f64_div(f64_add(f64_sub(f64_sub(qh, load64(&t2)), load64(&t2 + 8)), ql), f64_mul(F64_TWO, r));
    var apl = pl;
    if (f64_lt(ph, 0) == 1) { apl = f64_neg(pl); }
    _lext_two_sum(f64_abs(ph), r, &t2);
    var ll = f64_add(f64_add(load64(&t2 + 8), apl), cor);
    _lext_two_sum(load64(&t2), ll, &t2);
    var lh = load64(&t2);
    var lw = load64(&t2 + 8);
    var y = f64_add(lh, lw);
    if (f64_lt(y, 0x07B0_0000_0000_0000) == 1) { return 0; }   # below 2^-900: not this filter's
    # 2e, and the sum minus y (exact: y is lh or its neighbour)
    var e1 = f64_add(f64_div(eq, r), f64_mul(lh, 0x39C0_0000_0000_0000));   # E / r + 2^-99 lh
    var e2 = f64_mul(F64_TWO, f64_add(e1, 0x0170_0000_0000_0000));         # 2 (that + 2^-1000)
    var dl = f64_add(f64_sub(lh, y), lw);
    var hu = ((y >> 52) - 53) << 52;   # half y's ulp
    var hd = hu;
    if ((y & 0x000F_FFFF_FFFF_FFFF) == 0) { hd = ((y >> 52) - 54) << 52; }
    if (f64_lt(f64_add(dl, e2), hu) == 0) { return 0; }
    if (f64_lt(f64_sub(e2, dl), hd) == 0) { return 0; }
    var ey = (y >> 52) - 1023 - k - 1;   # lambda_1's exponent
    if (ey > 1023) { return 1; }   # |lambda_1| rounds to 2^1024 or past: beyond DBL_MAX + ulp / 2
    if (ey < 0 - 1022) { return 0; }
    var lam = (y & 0x000F_FFFF_FFFF_FFFF) | ((ey + 1023) << 52);
    var sm = F64_ONE;
    if (f64_lt(ph, 0) == 1) {
        lam = lam | 0x8000_0000_0000_0000;
        sm = f64_neg(F64_ONE);
    }
    _lext_w_set(rw, f64_mul(sm, r), f64_mul(sm, cor), 0 - k - 1);
    return lam;
}

# `_lext_power_2x2`'s exact path (3.4.1 LA2; a function of its own since 3.4.1 LA3, so the float
# filter's calls do not carry its 9 KB of integers): P and Q exact, the candidate from a double-double
# estimate, then the exact midpoint comparisons. w: the caller's wide values (m at w + 24 in, s sqrt D
# out at w + 120). Returns 0 with lo[0] = lambda_1's bits, HSB_ERR_NO_CONVERGENCE (complex, +-sqrt(D),
# past DBL_MAX), or 1 (unreachable).
# [measured: src/linalg_ext.cyr, its bsa: i64[1120] (seven integers of 160 words)]
fn _lext_p2_exact(a, b, c, d, w, lo) {
    var bsa: i64[1120];   # seven exact integers of 160 words
    var bs = &bsa;
    var pb = bs;              # P = a + d
    var qb = bs + 1280;       # Q = (a - d)^2 + 4 bc
    var t3 = bs + 2560;       # a - d
    var sc = bs + 3840;       # four more, `_lext_pq`'s and `_lext_p2_side`'s scratch
    var gpq: i64[2];
    _lext_pq(a, b, c, d, pb, qb, t3, sc, &gpq);
    var gp = load64(&gpq);
    var gq = load64(&gpq + 8);
    if (load64(qb) < 0) { return HSB_ERR_NO_CONVERGENCE; }   # a complex pair
    if (load64(pb) == 0 && load64(qb) > 0) { return HSB_ERR_NO_CONVERGENCE; }   # +-sqrt(D)

    var mw = w + 24;      # m (the caller's)
    var dw = w + 96;      # D
    var sq = w + 120;     # sqrt(D) (signed s), for the caller
    var lw = w + 144;     # lambda_1
    var t2: i64[2];
    # the estimate: D from Q's top limbs
    _lext_bn_wide(qb, gq - 2, dw);
    var sm = F64_ONE;
    if (load64(pb) < 0) { sm = f64_neg(F64_ONE); }
    # s sqrt(D): sqrt of the pair, one Newton correction on Dekker's exact r^2
    store64(sq, f64_from(0)); store64(sq + 8, f64_from(0)); store64(sq + 16, 0);
    if (load64(qb) > 0) {
        var dm = load64(dw);
        var dl = load64(dw + 8);
        var de = load64(dw + 16);
        if ((de & 1) != 0) {
            dm = f64_mul(dm, F64_TWO);
            dl = f64_mul(dl, F64_TWO);
            de = de - 1;
        }
        var r = f64_sqrt(dm);
        _lext_two_prod(r, r, &t2);
        var cor = f64_div(f64_add(f64_sub(f64_sub(dm, load64(&t2)), load64(&t2 + 8)), dl), f64_mul(F64_TWO, r));
        _lext_w_set(sq, f64_mul(sm, r), f64_mul(sm, cor), de / 2);
    }
    _lext_w2_add(mw, sq, lw);
    # the candidate |lambda_1|, then the nearest double to L = (|P| + sqrt Q) / 2, decided exactly
    var y = f64_abs(_lext_xld(f64_add(load64(lw), load64(lw + 8)), load64(lw + 16)));
    if (f64_lt(y, F64_POS_INF) == 0) { y = 0x7FEF_FFFF_FFFF_FFFF; }
    if (load64(pb) < 0) {
        store64(pb, 1);   # |P|
    }
    y = _lext_p2_round(pb, gp, qb, gq, y, sc);
    if (y == 0 - 1) { return HSB_ERR_NO_CONVERGENCE; }   # past DBL_MAX
    if (y == 0 - 2) { return 1; }   # unreachable: the estimate is within 2^-100 of L
    var lam = y;
    if (f64_lt(sm, 0) == 1) { lam = y | 0x8000_0000_0000_0000; }
    store64(lo, lam);
    return 0;
}

# The dominant eigenpair of the 2 x 2 [[a, b], [c, d]] with b != 0 and c != 0 (one strongly
# connected component), from lambda^2 - (a + d) lambda + ad - bc = 0: lambda = m +- sqrt(D),
# m = (a + d) / 2, D = h^2 + bc, h = (a - d) / 2. P = a + d = 2m and Q = (a - d)^2 + 4bc = 4D are
# formed EXACTLY, as integers times powers of two over the whole range of the entries (3.4.1 LA2:
# the first 3.4.1 form dropped the (ht)^2 of h = hs + ht, and with D cancelling by 80 to 99 bits
# answered Ok up to 5.5e-7 off; RV-LA M1). Returns
#   0  answered: lambda_1 = m + sign(m) sqrt(D) (no cancellation: both terms share the sign),
#      CORRECTLY ROUNDED: a double-double estimate picks a candidate, and exact comparisons of L =
#      |lambda_1| with the midpoints on either side of it (`_lext_p2_side`) move it to the nearest
#      double, a tie to the even one; a double root (Q = 0) is lambda = m, defective as it then is.
#      The eigenvector, largest component +1 (the first on a tie), comes from whichever of
#      (lambda - d, c) and (b, lambda - a) has no cancellation, each formed from the double-double
#      estimate (h + s sqrt D, or s sqrt D - h) and divided once: within a few ulps;
#   HSB_ERR_NO_CONVERGENCE  no real dominant eigenvalue: Q < 0 (a complex pair) or P = 0 < Q
#      (+-sqrt(D)); or |lambda_1| rounds past DBL_MAX;
#   1  a NaN or infinite entry, or b or c = 0 (not this case), nothing written.
# Size: every integer here is below 2^4210 (entries in [2^-1074, 2^1024), so 2h, P < 2^1025 on a
# grid of 2^-1074, Q < 2^2051 on 2^-2148, T^2 likewise), within 157 limbs of 30 bits.
fn _lext_power_2x2(A, out_val, out_vec) {
    var a = ganita_mat_get(A, 0, 0);
    var b = ganita_mat_get(A, 0, 1);
    var c = ganita_mat_get(A, 1, 0);
    var d = ganita_mat_get(A, 1, 1);
    if (_lext_mat_all_finite(A, 2, 2) == 0) { return 1; }
    if ((b & 0x7FFF_FFFF_FFFF_FFFF) == 0 || (c & 0x7FFF_FFFF_FFFF_FFFF) == 0) { return 1; }
    var w: i64[24];   # eight wide values of three words
    var hw = &w;           # h
    var mw = &w + 24;      # m
    var sq = &w + 120;     # sqrt(D) (signed s)
    var xw = &w + 168;     # the eigenvector's free component
    var t2: i64[2];
    # a and d at their common exponent ea2 (the smaller flushed only below 2^-1074 of the larger), h
    # and m as exact pairs there
    var ea2 = 0 - 2000;
    if ((a & 0x7FFF_FFFF_FFFF_FFFF) != 0) { ea2 = _lext_xexp(a); }
    if ((d & 0x7FFF_FFFF_FFFF_FFFF) != 0 && _lext_xexp(d) > ea2) { ea2 = _lext_xexp(d); }
    var a1 = f64_from(0);
    var d1 = f64_from(0);
    if (ea2 > 0 - 2000) {
        a1 = _lext_pow2mul(a, 0 - ea2);
        d1 = _lext_pow2mul(d, 0 - ea2);
    }
    _lext_two_sum(a1, f64_neg(d1), &t2);
    _lext_w_set(hw, load64(&t2), load64(&t2 + 8), ea2 - 1);
    _lext_two_sum(a1, d1, &t2);
    _lext_w_set(mw, load64(&t2), load64(&t2 + 8), ea2 - 1);
    var hm = load64(hw);
    # lambda_1 certified in double-double (3.4.1 LA3), else decided on exact integers
    var lam = _lext_p2_fast(a, b, c, d, sq);
    if (lam == 1) { return HSB_ERR_NO_CONVERGENCE; }   # complex, or +-sqrt(D)
    if (lam == 0) {
        var lo: i64[1];
        var rc = _lext_p2_exact(a, b, c, d, &w, &lo);
        if (rc != 0) { return rc; }
        lam = load64(&lo);
    }
    var sm = F64_ONE;
    if ((lam & 0x8000_0000_0000_0000) != 0) { sm = f64_neg(F64_ONE); }
    # the eigenvector: x = lambda - d = h + s sqrt(D) when s h >= 0, giving (x, c); otherwise
    # y = lambda - a = s sqrt(D) - h, giving (b, y). Neither cancels.
    var v0m = f64_from(0);
    var v0e = 0;
    var v1m = f64_from(0);
    var v1e = 0;
    var hneg = 0;
    if (f64_lt(hm, 0) == 1) { hneg = 1; }
    var smneg = 0;
    if (f64_lt(sm, 0) == 1) { smneg = 1; }
    if ((hm & 0x7FFF_FFFF_FFFF_FFFF) == 0 || hneg == smneg) {
        _lext_w2_add(hw, sq, xw);
        var xv = f64_add(load64(xw), load64(xw + 8));
        v0m = _lext_xman(xv);
        v0e = _lext_xexp(xv) + load64(xw + 16);
        v1m = _lext_xman(c);
        v1e = _lext_xexp(c);
    } else {
        _lext_w_set(xw, f64_neg(load64(hw)), f64_neg(load64(hw + 8)), load64(hw + 16));
        var yw = hw;   # h is not needed again
        _lext_w2_add(xw, sq, yw);
        var yv = f64_add(load64(yw), load64(yw + 8));
        v0m = _lext_xman(b);
        v0e = _lext_xexp(b);
        v1m = _lext_xman(yv);
        v1e = _lext_xexp(yv) + load64(yw + 16);
    }
    if ((v0m & 0x7FFF_FFFF_FFFF_FFFF) == 0 && (v1m & 0x7FFF_FFFF_FFFF_FFFF) == 0) { return 1; }
    # largest component +1, the first on a tie
    var first = 1;
    if (v1e > v0e || (v1e == v0e && f64_gt(f64_abs(v1m), f64_abs(v0m)) == 1)) { first = 0; }
    if ((v0m & 0x7FFF_FFFF_FFFF_FFFF) == 0) { first = 0; }
    if (first == 1) {
        var q1 = f64_div(v1m, v0m);
        store64(out_vec, F64_ONE);
        store64(out_vec + 8, _lext_xld(_lext_xman(q1), _lext_xexp(q1) + v1e - v0e));
    } else {
        var q0 = f64_div(v0m, v1m);
        store64(out_vec, _lext_xld(_lext_xman(q0), _lext_xexp(q0) + v0e - v1e));
        store64(out_vec + 8, F64_ONE);
    }
    store64(out_val, lam);
    return 0;
}

# A wide value from the pair (h, l) at 2^e, renormalised to h in [0.5, 1) (or 0).
fn _lext_w_set(w, h, l, e) {
    if ((h & 0x7FFF_FFFF_FFFF_FFFF) == 0) {
        store64(w, l); store64(w + 8, f64_from(0)); store64(w + 16, e);
        if ((l & 0x7FFF_FFFF_FFFF_FFFF) != 0) {
            var k0 = _lext_xexp(l);
            store64(w, _lext_pow2mul(l, 0 - k0));
            store64(w + 16, e + k0);
        }
        return 0;
    }
    var k = _lext_xexp(h);
    store64(w, _lext_pow2mul(h, 0 - k));
    store64(w + 8, _lext_pow2mul(l, 0 - k));
    store64(w + 16, e + k);
    return 0;
}

# Power iteration for the dominant eigenvalue.
# A:        stdlib matrix (n x n -- SHAPE ENFORCED, see below).
# n:        matrix dimension.
# max_iter: maximum iterations.
# out_val:  pointer to store eigenvalue (f64, allocate 8 bytes).
# out_vec:  flat f64 array of length n (caller allocates, receives eigenvector).
# Returns:  Ok(0) on success, HSB_ERR_NO_CONVERGENCE if max_iter exceeded,
#           HSB_ERR_INVALID_INPUT on a null handle, a shape that does not
#           match n, or (since 3.4.0) max_iter <= 0, HSB_ERR_ALLOC if the working vectors (or, since 3.3.7, the
#           diagonal floor's scratch, or since 3.4.0 the exact path's, or since 3.4.1 the n x n row-major
#           copy of A the iteration reads) cannot be allocated.
#           ⭐ AN IRREDUCIBLE 2 x 2 (3.4.1) is answered from its characteristic polynomial without
#           iterating (`_lext_power_2x2`): lambda_1 = m + sign(m) sqrt(D), m = (a + d) / 2,
#           D = ((a - d) / 2)^2 + bc, with a + d and (a - d)^2 + 4bc formed EXACTLY (integers, over
#           the whole exponent range of the entries), so D's sign is never in doubt, and lambda_1
#           CORRECTLY ROUNDED (a tie to the even double), decided by exact comparisons with the
#           midpoints on either side: all 4,747 of 6,433 probe matrices with a real dominant root
#           (double roots, defective, exact ties, entries 2^-1074..2^1023, D cancelling by up to
#           2000 bits), against an exact rational oracle; 3.4.0's iteration was up to 2.4e13 ulps
#           off on such matrices, or refused. The eigenvector, largest component +1, comes from
#           whichever of (lambda - d, c) and (b, lambda - a) does not cancel, within 1.5 ulps.
#           NO_CONVERGENCE for a complex pair (D < 0), for +-sqrt(D) (m = 0), and for a lambda_1
#           that rounds past DBL_MAX (the other 1,686). max_iter does not bound it.
#           [measured: LA2 probe p2check.py (p2fams.py seeds 1, 7, 11; Fraction oracle, mpmath 1300 digits), 2026-10-31]
#           ⛔ 3.4.1's first form formed D from rounded pairs: it dropped a 2^-105 h^2 term when
#           a - d is not a double, and answered a D cancelling by 80 to 99 bits Ok with 2^-5 of D
#           wrong (RV-LA's 300 such matrices: all 300 Ok up to 5.5e-7 off, where 3.4.0 refused),
#           and across an exponent gap between a and d it answered matrices with no real root
#           (58 of the 600 above) and refused real ones (146); the same probe set gave 433 wrong.
#           [measured: LA2 probe p2check.py, the first 3.4.1 form (3.4.1-dev) against this tree, 2026-10-31]
#           ⭐ COST (3.4.1 LA3). The exact integers took 2.4 us a call on ordinary entries and up to
#           73 us on entries spread across the exponent range (30 times 3.4.0's iteration there).
#           lambda_1's rounding is now certified in double-double first (`_lext_p2_fast`, under a
#           rigorous error bound, through a similarity that keeps every product in range), and the
#           integers are formed only where that cannot decide: on R2-LA's 22,673 probe matrices it
#           certified 11,923 roots and proved 6,203 refusals, every one the exact path's answer (0
#           changed, eigenvectors included), leaving 4,475 (exact midpoint ties, double roots,
#           subnormal roots, D cancelling past about 40 bits) to the exact path. A call takes about
#           1 us where certified (3.4.0's iteration: 1.5 to 70 us), 1.9 to 2.9 us on the exact path,
#           and at most 1.05 times 3.4.0 over 1,200 full-range matrices (48 us at worst, as 3.4.0).
#           [measured: LA3 fast2.py, run2b.py, tim2x2.py (R2-LA fam2.py); 3.4.0, 3.4.1-dev, this tree; 2026-11-01]
#           ⭐ A SPECTRUM THAT IS THE DIAGONAL (3.4.0). When every strongly connected
#           component of A's graph is one vertex (every triangular or permuted-triangular
#           A), the answer is read off the diagonal without iterating: a dominant a_kk
#           unique in modulus comes back exactly, with the eigenvector solved by
#           substitution (carried as m * 2^e, so no chain of couplings overflows it); a
#           modulus shared by entries of both signs is NO_CONVERGENCE at once; one shared by
#           equal entries (a repeated eigenvalue, defective or not, 0 in a nilpotent A) is
#           answered exactly too, with the eigenvector of the last such vertex in Tarjan's
#           completion order. ⭐ COMPONENTS OF TWO VERTICES (3.4.1). When every component has
#           one or two vertices, A's eigenvalues are the diagonal entries of the single ones and
#           the roots of each 2 x 2 block, formed exactly as for an irreducible 2 x 2: the dominant
#           is decided exactly (correctly rounded moduli, and exact integer comparisons where two
#           round alike) and returned correctly rounded; a complex pair, a block's +-sqrt(D), or
#           values of both signs at the largest modulus is NO_CONVERGENCE; the eigenvector is
#           solved by substitution through the 1 x 1 and 2 x 2 blocks in double-double (3.4.0
#           iterated: up to 1e-9 off, and the review's [[1e-3, 0, -1e20, 0.25], [0, 1.3, 0, 0],
#           [0, 0, -1, 0], [0.5, 0, 0, 0.1]] was NO_CONVERGENCE at any max_iter; now 1.3 and e_1).
#           [measured: LA2 probe scccheck.py (Q(sqrt D) Fractions), RV-LA scc2.json + sccfams.py seeds 5, 6, 2026-10-31]
#           Its accuracy: when lambda is a diagonal entry (exact), every block's det(lambda I -
#           A_CC) is formed exactly (3.4.1 LA3), and each component came within 0.5 ulp of the
#           exact one on R2-LA's families, its constructed near-coincidences included (a block
#           eigenvalue within 2^-71 of lambda: the double-double det had put a component 6.3e4
#           ulps off); when lambda is a 2 x 2 block's root it is carried as a double-double, within
#           about 2^-104 of it, and a component solved through a component whose eigenvalue lies
#           within a relative distance g of lambda carries about 2^-104 / g of relative error (up
#           to 10 ulps where g is a few ulps; normwise within 5.4e-17, the final roundings). A
#           component whose exact value is far below the terms of its substitution sum carries an
#           error of about 2^-104 of those terms in every case.
#           [measured: LA3 probes runblk3.py (R2-LA famblk.py 401-403, oblk.py at 1200 digits), n1run3.py, 2026-11-01]
#           max_iter must be positive (INVALID_INPUT otherwise, on every
#           path) but does not bound the exact path.
#           ⚠ BELOW 2^-511 (3.4.0). A matrix whose largest |a_ij| is under 2^-511 is iterated
#           as A 2^s (exact), and lambda rounded once on the way back, so a dominant |lambda|
#           down to the subnormal range is answered (3.3.7 refused below about 2.47e-312).
#           Success means BOTH the eigenvalue estimate and the eigenvector (scaled
#           so its largest component is exactly 1) stopped moving, to 1e-12
#           relative; the eigenvector is compared up to sign, so one whose two
#           largest components tie with opposite signs converges as well. A NaN or
#           infinite entry in A is NO_CONVERGENCE, as are a dominant eigenvalue tied
#           in magnitude with another (+1 and -1), a defective one the iteration meets
#           (one not read off a diagonal or a 2 x 2, as [[2,1],[0,2]] and [[-9,1],[-9,-3]] now
#           are), and one whose
#           magnitude is past DBL_MAX. Entries up to DBL_MAX do not
#           overflow the iteration itself (see the scaled iterate in the loop).
#           ⚠ COMPONENTS THE ARITHMETIC CAN LOSE (3.3.4). When a converged iterate has
#           components below DBL_MIN, or below the rounding grid of A v in A's units,
#           that could move a row of A v, the iteration is run again with every
#           component held as m * 2^e, at up to max_iter further passes; its
#           NO_CONVERGENCE is returned, and its answer when its eigenvalue is the
#           larger. That repairs a lost component only where a check sees it and the
#           plain answer is the smaller; some mixed-scale matrices are still answered
#           wrong (see the loop).
#           ⚠ THE SPECTRAL-RADIUS FLOOR (3.3.6). An answer whose modulus is provably below
#           |tr A| / n or sqrt(|tr A^2| / n), both at most rho(A), or (since 3.3.7) below
#           |a_ii| for a diagonal entry that is a strongly connected component of A on its
#           own (an exact eigenvalue), or (since 3.4.0) below max(|a + d| / 2, sqrt |ad - bc|)
#           for a component of two vertices (its eigenvalues are A's; the second is a complex
#           pair's modulus), is not the dominant eigenvalue: the wide iteration is run (if it
#           has not been) and its answer taken only if larger and clear of the floor; otherwise
#           NO_CONVERGENCE (see the loop). A complex dominant pair has no real dominant
#           eigenvalue, so NO_CONVERGENCE is its answer.
#           ⭐ EVERY ANSWER OF THE ITERATION IS CERTIFIED (3.4.0): it is returned only when a
#           Gelfand bound shows no eigenvalue larger than 1.001 |lambda| in modulus
#           (`_lext_gelfand`), otherwise NO_CONVERGENCE. That catches an answer short of
#           rho(A) by more than 0.1% whatever the cause, including a dominant LEFT eigenvector
#           orthogonal to the fixed seed, which no number of passes reaches. It does not see
#           an answer above rho(A). Where the first pass over A does not certify the answer, an
#           exactly symmetric A costs two Cholesky factorizations (n^3 / 3 multiply-adds in
#           all), and any other A is deflated by the answer's own vector and squared, n^3 per
#           squaring, each power also bounded by its Collatz-Wielandt ratio (3.4.1): at n = 30 /
#           60 / 100 a strongly non-normal A takes 3 squarings (3.4.0: 5 / 8 / 8) and about 1.3 /
#           1.2 / 2.0 times 3.4.0's uncertified run (3.4.0: 2.5 / 3.5 / 6.3 times); an answer the
#           deflated squarings leave undecided after 12 is put through 3.4.0's 24 as well, so a
#           refused one costs up to 36 (see the loop for the measured costs).
#           ⚠ GROWTH BELOW tol (3.3.5). A pass that meets both tests is not taken at
#           once if some component grew more than twofold since the pass before: one more
#           pass is run (one matvec, not counted against max_iter), and if that component
#           grows more than twofold again the iteration goes on, on counted passes (a
#           larger eigenvalue's direction was still growing below tol); otherwise that
#           pass's answer is returned unchanged. A slowly rotating complex subdominant
#           pair can do this too, and then a right answer needs a few more passes.
#           ⚠ PASSES NEEDED (3.3.3). The seed is not an eigenvector of a diagonal or
#           triangular matrix, as 3.3.2's e_0 was, and the vector must stop moving
#           as well, so a result needs about log(1e-12) / log|lambda_2 / lambda_1| + 2
#           passes (a little fewer on every matrix measured): diag(4,3,2), which 3.3.2
#           answered in 2 from e_0, now needs 92; [[3,1],[0,1]] 26 and [[10,0],[0,9]]
#           239, where 3.3.2 needed 2. (The identity, where every vector is an
#           eigenvector, needs 3.) A max_iter below that is NO_CONVERGENCE, and a ratio
#           near 1 needs a large one.
#           [measured: R5le min-max_iter probe, 3.3.2 bundle and this tree, cycc 6.6.12, 2026-10-01]
#must_use
public fn eigen_power(A, n, max_iter, out_val, out_vec) {
    # NULL HANDLES. A may be the designed 0 that mat_new_guarded returns above
    # its element cap, and ganita_mat_rows(0) is a null dereference.
    if (A == 0 || out_val == 0) { return Err(HSB_ERR_INVALID_INPUT); }
    if (out_vec == 0) { return Err(HSB_ERR_INVALID_INPUT); }

    # n WAS NOT BOUNDED AT ALL. `alloc(n * 8)` was called with whatever arrived
    # and stored through unconditionally, so both ends crashed (measured, exit
    # 139): n = -3 asks alloc for a negative size, and n = 1e9 asks for 8 GB --
    # over ALLOC_MAX = 2 GiB -- so alloc returns its designed 0 and `store64(v, ...)`
    # writes to address 0.
    # [measured: tests/abuse.tcyr, group "abuse: eigen_power / lyapunov_max dimension + null contract", n = -3 and 1e9]
    if (n <= 0) { return Err(HSB_ERR_INVALID_INPUT); }

    # THE n x n PRECONDITION IS NOW CHECKED, NOT JUST DOCUMENTED. `n` is a
    # restatement of A's own extent: the matvec below reads ganita_mat_get(A, i, j) for
    # i, j < n, so n > A's extent is an out-of-bounds read and n < it silently
    # iterates on A's leading n x n block and returns 0 with the dominant
    # eigenvalue of a matrix the caller did not pass. Neither is a shape this
    # routine can legitimately answer for, so both are rejected.
    if (ganita_mat_rows(A) != n || ganita_mat_cols(A) != n) { return Err(HSB_ERR_INVALID_INPUT); }
    # 3.4.0 — a budget of no passes is refused on every path, the exact one included (through
    # 3.3.7 the loop ran zero times and answered NO_CONVERGENCE), as lyapunov_max refuses its own.
    if (max_iter <= 0) { return Err(HSB_ERR_INVALID_INPUT); }

    # ⭐ 3.4.0 — A SPECTRUM THAT IS THE DIAGONAL IS ANSWERED EXACTLY (`_lext_power_exact`).
    var ex_buf: i64[1];
    var ex_rc = _lext_power_exact(A, n, &ex_buf, out_vec);
    if (ex_rc == 0) {
        store64(out_val, load64(&ex_buf));
        return Ok(0);
    }
    if (ex_rc < 0) { return Err(ex_rc); }
    # ⭐ 3.4.1 — AN IRREDUCIBLE 2 x 2 IS ANSWERED FROM ITS CHARACTERISTIC POLYNOMIAL
    # (`_lext_power_2x2`). The iteration answered above rho on ones whose eigenvector sits on the
    # subnormal grid: [[3F4FFFFFFF800000, 7FE0000000000000], [0000000000000001, 3F40000000000000]]
    # gave Ok(3F50000000200000), exact 2^-10 (4.7e-10 off), and [[3EA504B73F812A3C,
    # 7FE28392F4312526], [13 2^-1074, 3EA1BA1B90F3D9A9]] Ok(3EA69AF208C555CB), exact
    # 3EA69232FBAA0889 (1.5e-3 off); 19 of 60 such matrices Ok more than 1e-9 off.
    # [measured: LA probe rep1 and p2fam, 3.4.0 base and this tree, mpmath 60-digit roots, cycc 6.7.18, 2026-10-31]
    if (n == 2) {
        var p2_buf: i64[1];
        var p2_rc = _lext_power_2x2(A, &p2_buf, out_vec);
        if (p2_rc == 0) {
            store64(out_val, load64(&p2_buf));
            return Ok(0);
        }
        if (p2_rc < 0) { return Err(p2_rc); }
    }

    # ⛔ 3.3.3 — THE SEED WAS e_0, AND e_0 IS AN EIGENVECTOR OF EVERY MATRIX WHOSE
    # FIRST COLUMN IS A MULTIPLE OF e_0 -- every diagonal and every upper-triangular
    # one among them. The iteration was stationary from its first step and returned
    # A[0][0] as "the dominant eigenvalue": diag(2,3,4), [[2,0,0],[0,3,1],[0,1,3]]
    # and [[2,1,0],[0,3,1],[0,0,4]] all gave Ok(0) and 2, where the answer is 4.
    # [measured: G2a probe on the 3.3.2 bundle, cycc 6.6.12, 2026-10-01]
    # ⭐ The seed is now SplitMix64's output stream from state 0: v_i is the double
    # in [0.5, 1) whose 52 mantissa bits are the top 52 bits of the (i+1)-th output,
    # so it begins 0.9416554041068212, 0.715763998524255, 0.5132168857962989.
    #   - deterministic and formed from integer operations alone, so every result
    #     reproduces bit for bit (abuse.tcyr pins it through the identity matrix);
    #   - every component POSITIVE, so the seed has a non-zero component along the
    #     dominant eigenvector of any non-negative irreducible matrix (its left and
    #     right Perron vectors are positive);
    #   - every component in [0.5, 1), so no larger than any later iterate's (whose
    #     largest component is exactly 1). That keeps no matvec below DBL_MAX: until
    #     the iterate settles, any pass's |A v|, the seed's or a later one's, can reach
    #     n max|a_ij|. See the scaled iterate in the loop below;
    #   - the mantissas are hash output, so no SHORT integer combination of the
    #     components vanishes. A seed with structure satisfies one -- a ramp
    #     (1, 2, 3) is orthogonal to (1, -2, 1) -- and so misses every eigenvector
    #     with those coefficients.
    # ⛔ The ALL-ONES vector, the obvious alternative, is orthogonal to every
    # zero-sum vector, so it misses a dominant eigenvector that alternates in sign:
    # tridiag(-1, 2, -1) 4x4 gave Ok(0) and 2.618 from it, where the answer is
    # 2 + 2cos(pi/5) = 3.618 (e_0 and this seed both give 3.618).
    # [measured: G2a seed-variant probes, cycc 6.6.12, 2026-10-01]
    # ⚠ RESIDUAL RISK, which no choice removes: ANY fixed seed has zero component
    # along the dominant eigenvector of SOME matrix -- one built so the seed lies in
    # the span of the other eigenvectors -- and there power iteration returns the
    # next eigenvalue down unless rounding restores the missing component before the
    # iteration settles. For a symmetric A, eigen_qr / eigen_symmetric are the
    # cross-check.
    var v = alloc(n * 8);
    if (v == 0) { return Err(HSB_ERR_ALLOC); }
    var i = 0;
    while (i < n) {
        # SplitMix64 (Steele, Lea, Flood 2014): the golden-gamma increment, then its
        # two multiply-xorshift rounds. `>>` is Cyrius's LOGICAL shift.
        var z = (i + 1) * 0x9E3779B97F4A7C15;
        z = (z ^ (z >> 30)) * 0xBF58476D1CE4E5B9;
        z = (z ^ (z >> 27)) * 0x94D049BB133111EB;
        z = z ^ (z >> 31);
        store64(v + i * 8, 0x3FE0000000000000 | (z >> 12));
        i = i + 1;
    }

    var w = alloc(n * 8);
    if (w == 0) { return Err(HSB_ERR_ALLOC); }
    # vn: the other iterate buffer (the previous iterate, after the swap below); gfl: the
    # growth test's scratch
    var vn = alloc(n * 8);
    var gfl = alloc(n * 8);
    if (vn == 0 || gfl == 0) { return Err(HSB_ERR_ALLOC); }
    # 3.4.1: A row-major, so the matvec walks a pointer instead of calling ganita_mat_get
    if (n > (ALLOC_MAX / 8) / n) { return Err(HSB_ERR_ALLOC); }
    var Af = alloc(n * n * 8);
    if (Af == 0) { return Err(HSB_ERR_ALLOC); }
    for (var fa = 0; fa < n; fa = fa + 1) {
        for (var fb = 0; fb < n; fb = fb + 1) { store64(Af + (fa * n + fb) * 8, ganita_mat_get(A, fa, fb)); }
    }
    var eigenvalue = f64_from(0);
    var tol = EPSILON_F64;
    # The matvec reads `u`: v itself, until a pass overflows; v * 2^-sc_e after that.
    var u = v;
    var sc_e = 0;

    var iter = 0;
    while (iter < max_iter) {
        if (sc_e == 0) { u = v; }
        if (sc_e != 0) {
            var sc_dn = (1023 - sc_e) << 52;   # 2^-sc_e
            i = 0;
            while (i < n) {
                store64(u + i * 8, f64_mul(load64(v + i * 8), sc_dn));
                i = i + 1;
            }
        }

        # w = A * u (3.4.1: from the row-major copy Af, bit for bit the same sums)
        _lext_flat_mv(Af, n, u, w);

        # ⛔ 3.3.3 — ANY PASS CAN OVERFLOW ONCE SOME |a_ij| > DBL_MAX / n, NOT ONLY THE
        # FIRST. Every iterate's largest component is exactly 1 (the seed's is below 1),
        # so |w_i| can reach sum_j |a_ij| on any pass until the iterate settles near the
        # dominant eigenvector, where |A v| is about |lambda|. Which matrices hit it
        # depends on the path the iterate takes, so 3.3.2 (from e_0) and the 3.3.3 seed
        # hit it on different matrices. [[-3e307, 1.6e308], [0, 2e307]] (lambda =
        # -3e307, 0.167 DBL_MAX) has a finite first pass; on a later one v is
        # (1, -0.948) and -3e307 + 1.6e308 * -0.948 is -Inf, so it returned
        # NO_CONVERGENCE at max_iter 1000 and 100000, where 3.3.2 returned -3e307
        # exactly. [[1.4e308, 1.2e308], [0, 1.3e308]] (3.3.2: 1.4e308 exactly) did the
        # same. On the 2x2 grid with entries (k/10) 1e308, k = -17..17, 53354 matrices
        # with a dominant eigenvalue that 3.3.2 answered to 1e-9 came back
        # NO_CONVERGENCE; round 4's redo of the FIRST pass reached none of them.
        # [measured: R5le grid and repro probes, 3.3.2 bundle and this tree before the repair, cycc 6.6.12, 2026-10-01]
        # ⭐ So the first pass with a non-finite component switches the iteration to a
        # SCALED ITERATE for good, and is run again: from then on the matvec reads
        # u = v * 2^-s, with 2^s > 2n. Every |a_ij| is at most DBL_MAX and every |u_j|
        # at most 2^-s, so no |w_i| and no partial sum can exceed n * DBL_MAX * 2^-s,
        # under half of DBL_MAX, on any later pass. v itself is unchanged: its largest
        # component is still exactly 1, so the normalisation, the vector test and the
        # returned vector never see the scale. max_val is then in units of 2^-s, and the
        # value returned is +-max_val * 2^s, refused as NO_CONVERGENCE when that is past
        # DBL_MAX. The estimate kept from before the switch is in the caller's units, so
        # the pass run again cannot stop; the next compares like with like. (Rescaling
        # it changed no result on the grid and the random sweep below, 1538625
        # matrices, so it is not done.) Scaling by a power of two is exact away from the
        # subnormal range, so the scaled iteration IS the unscaled one: both matrices
        # above return what the same matrix times 2^-64 returns, times 2^64 (-3e307 to
        # 4.0e-13 relative, 1.4e308 to 1.1e-11), and every grid matrix with a dominant
        # eigenvalue that 3.3.2 answered is answered.
        # [measured: R5le grid and repro probes, 3.3.2 bundle and this tree, cycc 6.6.12, 2026-10-01]
        # A pass that does not overflow does not switch, so every matrix answered without
        # an overflow is bit-identical to the iteration before this repair; and a pass
        # that overflowed always ended in NO_CONVERGENCE there (its Inf or NaN reaches
        # every component one pass later), with one exception: round 4's first-pass redo
        # answered some. 17 of the 38000 random matrices below are those; their
        # eigenvalue is bit-identical, and only subnormal vector components moved. A NaN
        # or infinite entry of A is non-finite after the switch too, and fails as before;
        # the switch happens once, so it cannot loop. The cost on every input is one
        # finiteness test of max_val per pass; after a switch, n multiplies per pass and
        # one n-vector allocation.
        # [measured: R5le random sweep, the tree before this repair and this tree, cycc 6.6.12, 2026-10-01]
        # ⚠ WHAT IS STILL REFUSED, compared with 3.3.2 matrix by matrix, max_iter 1000.
        # On the 1500625-matrix grid every matrix 3.3.2 answered to 1e-9 is answered,
        # except 1156 defective ones and 1190 whose two eigenvalues are +-lambda, the
        # trades the doc names; no answer is wrong. On 38000 random matrices of 16
        # kinds (n = 2..5: symmetric, positive, general, triangular, block, entries up
        # to DBL_MAX, at the DBL_MAX / n threshold, near 2^-1000, mixed scales), the 388
        # that 3.3.2 answered and this tree refuses are 163 ties, 153 defective and 72
        # with |lambda_2 / lambda_1| between 0.969 and 0.999, every one of which is
        # right by max_iter 100000. 23 answers are wrong on both trees, with the same
        # eigenvalue: mixed-scale matrices (1e308 beside 1e-302) whose dominant
        # eigenvector has components below the f64 range (3.3.4: see the converged-iterate
        # check below).
        # [measured: R5le grid and random sweep, 3.3.2 bundle and this tree, numpy 2.5.0, cycc 6.6.12, 2026-10-01]

        # Find component with largest absolute value (the first, on a tie)
        var max_val = f64_from(0);
        var max_i = 0;
        i = 0;
        while (i < n) {
            var wi = load64(w + i * 8);
            if (f64_gt(f64_abs(wi), f64_abs(max_val)) == 1) {
                max_val = wi;
                max_i = i;
            }
            i = i + 1;
        }

        # ⛔ 3.4.0 — A DOMINANT |lambda| BELOW ABOUT 2.47e-312 WAS REFUSED. The relative test below,
        # |new - old| < tol |new|, needs tol |new| above zero, and tol |new| < 2^-1075 rounds to 0:
        # [[x]] for x = 0x00000000000ABCDE (3.5e-318) at max_iter 1000, or 0x00000000ABCDEF12 at
        # 100,000, gave NO_CONVERGENCE, and the matvec itself rounds on the subnormal grid long
        # before that. So when the first pass shows |A v| below n 2^-511, which A's largest |a_ij|,
        # M, must then be too (|v_j| <= 1), M is read, and if it is below 2^-511 the iteration
        # switches to u = v 2^s (sc_e = -s, M 2^s in [1, 2), s at most 1023) and runs the pass
        # again. Scaling up is exact, so where the unscaled iteration stays normal the scaled one
        # IS it, bit for bit, and the eigenvalue max_val 2^-s is rounded once at the end.
        # [measured: LA probe p1, 3.3.7 base and this tree, cycc 6.7.9, 2026-10-31]
        var up_lim = f64_mul(f64_from(n), 0x2000000000000000);   # n 2^-511
        if (iter == 0 && sc_e == 0 && f64_lt(f64_abs(max_val), up_lim) == 1) {
            var am = f64_from(0);
            for (var ai = 0; ai < n; ai = ai + 1) {
                for (var aj = 0; aj < n; aj = aj + 1) {
                    var aa = f64_abs(ganita_mat_get(A, ai, aj));
                    if (f64_gt(aa, am) == 1) { am = aa; }
                }
            }
            if (f64_gt(am, 0) == 1 && f64_lt(am, 0x2000000000000000) == 1) {   # 2^-511
                var up = 1 - _lext_xexp(am);
                if (up > 1023) { up = 1023; }
                u = alloc(n * 8);
                if (u == 0) { return Err(HSB_ERR_ALLOC); }
                sc_e = 0 - up;
                continue;
            }
        }

        # The switch (see above): 2^-sc_e with 2^sc_e > 2n, and this pass run again. An
        # overflow leaves some w_i at +-Inf, so max_val is +-Inf: for a finite A every
        # product is finite (|u_j| <= 1), and a partial sum that overflows stays +-Inf,
        # never NaN. A NaN in A can leave max_val finite and not switch; it fails one
        # pass later all the same.
        if (sc_e == 0 && f64_lt(f64_abs(max_val), F64_POS_INF) == 0) {
            u = alloc(n * 8);
            if (u == 0) { return Err(HSB_ERR_ALLOC); }
            sc_e = 1;
            while ((1 << sc_e) <= 2 * n) { sc_e = sc_e + 1; }
            continue;
        }

        # ⛔ `max_val` is the largest component of A*v, in the caller's units, so
        # an absolute 1e-12 made power iteration give up on any small-normed
        # matrix — reporting NO_CONVERGENCE for a problem with a perfectly good
        # dominant eigenvalue.
        # ⭐ THE GUARD AND THE NORMALISATION ARE ONE REPAIR. Lowering the threshold
        # alone is not enough while the loop multiplies by a RECIPROCAL: 1/max_val
        # overflows for a subnormal max_val even though w_i/max_val would not.
        # Dividing directly makes the exact-zero test the correct one, because
        # every |w_i| <= |max_val| by construction.
        # [measured: docs/audit/2026-09-09-epsilon-open.json]
        # ⚠ 3.3.3 — THE NaN-TRUE SHAPE, AUDITED AND KEPT. `f64_gt(x, 0) == 0` is true
        # for NaN, but max_val cannot be NaN: it starts at 0 and the f64_gt max above
        # never takes a NaN w_i. What reaches here as 0 is "every w_i is 0 or NaN",
        # and both are the designed NO_CONVERGENCE. A NaN or Inf entry of A is never
        # laundered: its row's w_i is NaN or Inf at once, its v_i is NaN after the
        # first normalisation, and since 0 * NaN is NaN every w_i is NaN on the next
        # pass -- which lands here -- while the first pass cannot satisfy the
        # convergence test (the previous estimate is 0). NaN at [0][0], [1][0] or
        # [0][1], +Inf or -Inf on the diagonal, and max_iter = 1: all NO_CONVERGENCE,
        # on 3.3.2 and on this tree. `f64_eq(max_val, 0)` here is an equivalent mutant.
        # [measured: G2a probe and mutant run, cycc 6.6.12, 2026-10-01]
        if (f64_gt(f64_abs(max_val), 0) == 0) {
            return Err(HSB_ERR_NO_CONVERGENCE);
        }

        # ⛔ 3.3.3 — THE ITERATE WAS COMPARED WITH ITS OWN SIGN, AND THE ESTIMATE TOOK
        # max_val's. When the dominant eigenvector has two largest components of equal
        # size and OPPOSITE sign, and lambda_2 / lambda_1 < 0, the decaying lambda_2 term
        # alternates in sign, so the lead swaps between the tied indices on every pass.
        # v = w / max_val then flips sign each time, `moved` never cleared, and max_val,
        # read at an index whose component in v was about -1, was always about -lambda.
        # [[1,-3],[-3,1]] (lambda = 4, -2), [[2,-5],[-5,2]] (7, -3), [[-1,3],[3,-1]]
        # (-4, 2) and [[1,-3,0],[-3,1,0],[0,0,1]] (4, -2, 1) returned NO_CONVERGENCE at
        # max_iter = 1000 (the first also at 100000); 3.3.2, which judged the eigenvalue
        # alone, returned Ok(0) with the sign wrong: -4, -7, +4 and -4. [[1,-2],[-2,1]]
        # (3, -1) came back Ok(0) and 3, by the rounding of its ties.
        # [measured: R4le probe, 3.3.2 bundle and this tree before the repair, cycc 6.6.12, 2026-10-01]
        # ⭐ The iterate is now compared UP TO SIGN. When the new lead's component in
        # the old v is negative, w / max_val points the other way, so the old v is
        # negated before the comparison and the estimate is -max_val. The test below
        # still demands w / max_val = s v to tol, s the sign used, which is exactly
        # max|A v - lambda v| < tol |lambda| for lambda = s max_val: the residual test,
        # for the eigenvalue it reports. A non-negative old v_k -- the seed's every
        # component, every pass whose lead stays put -- is the old test and the old
        # estimate, bit for bit. [[0,1],[1,0]] (+1 and -1) still never settles: its
        # iterate alternates between (1, r) and (r, 1), which are not negatives.
        # All five matrices above now return the right sign, to 2.4e-13 relative, the
        # tied components within 4.2e-13 of -1. ⚠ The cost, stated as plainly: a
        # matrix of this class whose lead happened to settle used to run on until it
        # did, and came back exact -- [[1,-2],[-2,1]] gave 3 -- and it now stops at
        # the first pass the test is met, like any other matrix: 2.9999999999993587.
        # Across 10400 matrices of five kinds (the two of the sweep below, random real,
        # integer triangular and integer [[a,b],[b,a]]) 62 refusals became answers and
        # 49 answers moved, 48 of them away from the exact integer eigenvalue; all 111
        # are within 4.6e-13 relative of numpy's eigenvalue. Every other result is
        # bit-identical, and none is wrong.
        # [measured: R4le eigen_power dump, this tree before and after, numpy 2.5.0, cycc 6.6.12, 2026-10-01]
        var flip = 0;
        if (f64_lt(load64(v + max_i * 8), 0) == 1) { flip = 1; }
        var new_eigenvalue = max_val;
        if (flip == 1) { new_eigenvalue = f64_neg(max_val); }

        # Normalize w -> v, noting whether any component moved by tol or more.
        # ⛔ 3.3.3 — CONVERGENCE WAS JUDGED ON THE EIGENVALUE ALONE, and any seed but
        # e_0 exposes it. The estimate is the largest component of A*v, so when that
        # component's row has no off-diagonal entries -- a diagonal matrix, the last
        # row of an upper-triangular one -- it is EXACT as soon as the right index
        # leads, while the vector is still far from converged. With the new seed and
        # the old test, diag(2,3,4) returned Ok(0), lambda = 4 and v = (0.115, 0.441, 1),
        # whose residual max|Av - lambda v| is 0.441, and diag(4,3,2), which e_0 had
        # got exactly right, returned v = (1, 0.321, 0.068). [[0,1],[1,0]], whose
        # eigenvalues +1 and -1 tie in magnitude so that power iteration has no
        # answer, returned Ok(0) and lambda = 1 with a v that is not an eigenvector
        # (residual 0.240) -- as 3.3.2 did from e_0, with residual 1.
        # [measured: G2a seed-variant probes, cycc 6.6.12, 2026-10-01]
        # ⭐ So the iterate must ALSO stop moving: every |v_new_i - v_i| < tol. With
        # lambda = max_val, v_new_i - v_i = (A v - lambda v)_i / lambda for the v that A
        # was just applied to, so this IS the relative residual test
        # max|A v - lambda v| < tol |lambda|, at no extra matvec. v is normalised so its
        # largest component is exactly 1 -- dimensionless and bounded -- so an
        # absolute tol is the right kind of number for it, the reasoning error.cyr
        # gives for EPSILON_F64.
        # ⚠ WHAT THE SEED AND THIS TEST COST TOGETHER, against eigen_symmetric on 4000
        # random symmetric integer matrices (n = 2..5; the 70 with a near-tie for the
        # dominant |lambda| set aside), max_iter = 1000: Ok(0) with lambda or the
        # residual off by more than 1e-9 relative went 79 -> 0, and NO_CONVERGENCE went
        # 155 -> 153. Every one of the 79 old wrong answers is now right -- 11 of them
        # only since the up-to-sign comparison above, which the vector test alone
        # refused -- 8 trials converge that did not, and 6 that converged correctly, all
        # with |lambda_2/lambda_1| near 0.97, now need between 1000 and 2000 iterations.
        # On 2000 positive non-symmetric matrices, Ok(0) with a residual over 1e-9
        # relative went 18 -> 0. The defective [[2,1],[0,2]], which e_0 answered by the
        # same accident as diag(4,3,2), now returns NO_CONVERGENCE: on a Jordan block
        # power iteration converges like 1/k.
        # [measured: G2a eigen_power sweep, re-run by R4le, 3.3.2 bundle vs this tree, cycc 6.6.12, 2026-10-01]
        # ⚠ Written as "a component that FAILS f64_lt" rather than a running f64_gt
        # max, so a NaN difference counts as moved. No input is known to need it: a
        # NaN v_i makes every w_i NaN on the next pass, and the guard above returns
        # NO_CONVERGENCE.
        var moved = 0;
        i = 0;
        while (i < n) {
            var vi = f64_div(load64(w + i * 8), max_val);
            var v_old = load64(v + i * 8);
            if (flip == 1) { v_old = f64_neg(v_old); }
            if (f64_lt(f64_abs(f64_sub(vi, v_old)), tol) == 0) { moved = 1; }
            store64(vn + i * 8, vi);
            i = i + 1;
        }
        var v_sw = v;
        v = vn;
        vn = v_sw;

        # ⛔ The convergence test compared an ABSOLUTE change in the eigenvalue
        # against `tol`, and an eigenvalue carries the matrix's units — so the same
        # problem converged in one iteration or never, depending on the caller's
        # scale. `tol` is kept, now as a RELATIVE factor, which is what a caller
        # passing 1e-12 always meant.
        var conv = 0;
        if (moved == 0 && f64_lt(f64_abs(f64_sub(new_eigenvalue, eigenvalue)),
            f64_mul(tol, f64_abs(new_eigenvalue))) == 1) { conv = 1; }
        # ⛔ 3.3.5 — AND BOTH TESTS ARE BLIND TO A DIRECTION GROWING BELOW tol. A component
        # that is a share s of the iterate and grows by rho a pass moves by s (rho - 1), which
        # the vector test misses while s < tol / (rho - 1): [[a, 0, b], [0, c, 0], [0, d, e]]
        # (a = 7.03e-288, b = -2.60e188, c = 5.63e169, d = 3.82e-22, e = -2.69e168) leaves c's
        # direction at a share of 3e-19 after one pass, growing 20.9-fold a pass, and 3.3.4
        # stopped on e. So a pass that meets both tests is held when some component grew more
        # than twofold since the last pass (`_lext_grows`): one more pass is run, uncounted, and
        # only that component growing more than twofold again keeps the iteration going (on
        # counted passes). Otherwise this pass's answer stands exactly as before. A real larger
        # eigenvalue grows its direction by the same factor every pass. A complex or +-lambda
        # subdominant pair can swing a small component through zero, more than twofold on one
        # pass: the same test without its second pass refused 39 of the 71,000 sweep matrices
        # answered right.
        # [measured: eigen_power sweeps + fixture traces, 3.3.4 vs this tree + Aberth oracle, 2026-10-11]
        # ⚠ AND SOMETIMES ON TWO PASSES IN A ROW. On 6,000 block-triangular matrices whose
        # subdominant eigenvalues are a complex pair at 0.9 to 0.9999 of |lambda_1|, 23 of the
        # 1,896 answered right keep iterating; all stay right (worst error 4.4e-10 -> 2.3e-10),
        # but the iteration needs more passes: the 3x3 with rows (0x3FF1D409B846C0AE, 0,
        # 0x3FC5A7B7A102A37F), (0x3F5AD138B103A727, 0xBFF29F9DD444D583, 0xC019CB8ABB14F9F4),
        # (0xBFC5A7B7A102A37F, 0, 0x3FF1D409B846C0AE), dominant eigenvalue -1.16397, is
        # answered at max_iter 859 by 3.3.4 and needs 860 here.
        # [measured: complex-subdominant family F3 (6,000), 3.3.4 vs this tree, 2026-10-11; cycc 6.6.14]
        if (conv == 1) {
            if (_lext_grows(Af, n, u, vn, v, sc_e, w, gfl) == 1) { conv = 0; }
        }
        if (conv == 1) {
            # After a switch the estimate is in units of 2^-sc_e; one past DBL_MAX in the
            # caller's units has no f64 answer, and out_val is left untouched.
            var lam = new_eigenvalue;
            if (sc_e > 0) {
                lam = f64_mul(new_eigenvalue, (1023 + sc_e) << 52);   # times 2^sc_e
                if (f64_lt(f64_abs(lam), F64_POS_INF) == 0) { return Err(HSB_ERR_NO_CONVERGENCE); }
            }
            # the scaled-up frame (3.4.0): one rounding, into the subnormal range too
            if (sc_e < 0) { lam = _lext_xld(_lext_xman(new_eigenvalue), _lext_xexp(new_eigenvalue) + sc_e); }
            # (a) and (b) read |a_ij| / |lambda| in the frame the matvec ran in: after a switch up
            # (sc_e < 0) lambda can be subnormal in the caller's units, and the ratio is formed from
            # a_ij 2^-sc_e and max_val there; otherwise from a_ij and lam, as through 3.3.7.
            var lam_c = lam;
            var a_up = F64_ONE;
            if (sc_e < 0) {
                lam_c = new_eigenvalue;
                a_up = (1023 - sc_e) << 52;
            }
            # ⛔ 3.3.4 — A COMPONENT BELOW DBL_MIN CAN CARRY THE DOMINANT EIGENVECTOR AWAY.
            # On [[a, b], [0, d]] with |d| > |a| and |b| / |d - a| above about 2^1074, the
            # dominant eigenvector, scaled so its largest component is 1, is (1, (d - a) / b),
            # and its second component is below the f64 range. The iterate's second component
            # decays towards it, flushes to zero, and from then on the iterate is (1, 0)
            # EXACTLY, the eigenvector of a: [[-4.70e-303, 1.37e306], [0, -8.90e-303]]
            # returned Ok(0) and -4.70e-303, where the dominant eigenvalue is -8.90e-303. Every
            # pass was consistent with the flushed arithmetic, so the residual test could not
            # see it. A subnormal component does the same more quietly: it keeps a few bits,
            # and a graded matrix multiplies their error up a chain of huge entries
            # ([[0.83, -9.4e160, 3.7e306], [-5.7e-162, -0.66, -8.8e160], [0, -1.7e-162, 0.57]]
            # gave 1.16798, for 1.16890). On 20000 matrices with entries near 1e307 and 1e-303,
            # 43 came back Ok(0) with a non-dominant eigenvalue or one a complex pair exceeds;
            # on 51000 of 17 kinds, 900. (3.3.3 recorded 23 on its sweep.)
            # [measured: krylov eigen_power sweeps, exact characteristic-polynomial oracle, cycc 6.6.14, 2026-10-03]
            # ⭐ So a converged iterate is checked once, two ways, for a component the plain
            # arithmetic may have lost. If either trips, the iteration is run again from the
            # seed with every component held as m * 2^e (_lext_power_wide), where nothing
            # flushes, and its NO_CONVERGENCE is returned as such.
            #   (a) Below DBL_MIN. For each row i whose v_i is normal, s_i is the sum of
            #       |a_ij| / |lambda| over the components below DBL_MIN (zero included). The
            #       check trips only when s_i / |v_i| overflows, at about 2^1024. A finite
            #       s_i / |v_i| times 2^-1074 is at most 2^-50, below tol (about 2^-39.9), so
            #       the test written at tol (about 2^1034) never fires, and the overflow rule
            #       is the one kept, deliberately more sensitive than tol: the tol rule, done
            #       exactly, turned 46 right answers of a 44000-matrix sweep wrong again
            #       (measured before (b) was added).
            #   (b) Below the grid of A v. v = w / max_val, and each w_j is rounded on the
            #       subnormal grid in A's units, so v sits on a grid of about
            #       g = 2^-1074 (1 + n / |max_val|). When |max_val| < 1 that is coarser than
            #       2^-1074, and a component well above DBL_MIN can flush where (a) sees
            #       nothing: [[1e-200, 1], [0, 3e-200]], whose dominant eigenvector (1, 2e-200)
            #       is normal throughout, returned Ok(0) and 1e-200 under (a) alone; it now
            #       gives 3e-200 to 2.6e-13. Components below 2^52 g count as lost, and the
            #       check trips when g times the sum of |a_ij| / |lambda| over them reaches
            #       tol |v_i|, in a row with |v_i| >= 2^52 g or |v_i| = 1 (both sides times
            #       2^1000, so the product with g stays normal).
            # [measured: eigen_power probes, 44000-matrix sweep, 3.3.4 tree before/after, cycc 6.6.14, 2026-10-03]
            # The wide eigenvalue replaces the plain one only when its modulus is larger, by
            # more than 2^-26 (3.3.5 re-measured this rule; see below). The checks also trip
            # where the small component is a true zero
            # ([[a, b], [0, d]] with |a| > |d| has the eigenvector (1, 0) exactly); there the
            # plain answer is exact and the wide run stops within about
            # tol / (1 - |lambda_2 / lambda_1|) of it. And a wide run could settle on a smaller
            # eigenvalue while the dominant direction was still growing from far below tol
            # (fixture (4) in tests/abuse.tcyr; 3.3.5's growth test stops that, in both runs).
            # Nothing else changes: a matrix that trips
            # neither check is bit-identical to 3.3.3, and one that does can take up to
            # max_iter more passes, each splitting every entry and product into m * 2^e (not
            # timed: no bench row trips the check).
            # ⚠ THE RULE ASSUMES THE PLAIN ANSWER IS AN EIGENVALUE OF A, AND IT NEED NOT BE.
            # When the flush zeroes trailing components, the plain run converges on an
            # eigenvalue of the leading block that is left, which can be LARGER in modulus
            # than A's dominant one; the wide run is then right, and is discarded. A banded
            # 5x5 with entries from 6.65e-219 to 1.6e224 returns 13680.224441530525, the
            # dominant eigenvalue of its leading 3x3 block; A's is 13601.365844822938, and the
            # wide run gives it to 1.8e-12. Taking the wide answer whenever a check trips
            # fixed 442 such matrices of the 44000 (measured before check (b) was added) and
            # turned 2 right answers wrong, both of the fixture-(4) shape; a wide run seeded
            # from the plain vector fixed 49. No rule tried separates the two (see the roadmap).
            # [measured: eigen_power probes, 44000-matrix sweep, 3.3.4 tree before/after, cycc 6.6.14, 2026-10-03]
            # ⚠ WHAT IT COSTS AND WHAT IT LEAVES, judged by a second exact oracle (the
            # characteristic polynomial in Fractions, its roots by Aberth iteration in 90-digit
            # Decimal), which counts 988 of the 71000 matrices above wrong on 3.3.3. With both
            # checks 816 of those are right, 50 NO_CONVERGENCE and 122 still wrong. On 44000
            # more, n = 2..5, built to reach a flush (triangular, permuted triangular, graded,
            # mixed-scale, block-triangular, special values), wrong went 6867 -> 910 and
            # NO_CONVERGENCE 9224 -> 9746. No right answer became wrong on either. Some
            # became NO_CONVERGENCE: 20 of the 71000; of the 44000, 44 before check (b) and
            # 11 more with it. There the flush had landed on the exact eigenvector, which let
            # the plain run stop early, and max_iter is below the roughly
            # log(1e-12) / log|lambda_2 / lambda_1| passes the wide run needs: of the 44, 37
            # are at max_iter 200 with ratios 0.89 to 0.99, 43 are right at max_iter 100000,
            # and one is defective, NO_CONVERGENCE by contract. So the wide run repairs a lost
            # component only where a check sees it and the plain answer is the smaller. What
            # stays wrong includes the larger-block case above, and a dominant direction whose
            # share of the iterate is below tol and still growing when both tests pass, which
            # needs no flush at all (see the roadmap).
            # [measured: eigen_power 71000- and 44000-matrix sweeps, Aberth oracle, cycc 6.6.14, 2026-10-03]
            # ⭐ 3.3.5 — THE GROWTH CLASS. The growth test (`_lext_grows`, and its copy in the
            # wide run) keeps a run going while a direction grows below tol. On sweeps rebuilt
            # to 3.3.4's descriptions (71,000 of 18 kinds, 44,000 flush-built, the same
            # 120-digit Aberth oracle) wrong went 460 -> 57 and 549 -> 88; no right answer
            # became wrong or NO_CONVERGENCE; 9 wrong ones became NO_CONVERGENCE (5 have no
            # real dominant eigenvalue, 3 are answered right at max_iter 100000, one has a
            # ratio of 1 - 8e-9). 37 right answers changed bits: 34 only in vector components
            # a continued iteration moved, 3 in the eigenvalue (2 closer to the oracle, 1 from
            # exact to 1.4e-16 off). The larger-block case above stays wrong (tests/abuse.tcyr
            # pins one as a tripwire).
            # [measured: eigen_power sweeps P1/P2, 3.3.4 vs this tree + Aberth oracle, 2026-10-11; cycc 6.6.14]
            # ⚠ THE LARGER-ONLY RULE IS LOAD-BEARING. Taking the wide answer whenever it differs
            # from the plain one by more than 2^-26 repairs that case (one matrix on each sweep)
            # and breaks another: when the flush lands the plain run exactly on the dominant
            # eigenvalue, the wide run, whose vector test compares components as doubles, cannot
            # see components near 1e-600 move, stops on the eigenvalue test alone up to about
            # tol / (1 - |lambda_2 / lambda_1|) short of it, and differs. On 4,000 such matrices
            # (dominant a near 1e-300, couplings near 1e275, a second eigenvalue a (1 - 1e-4 ..
            # 1e-9)) that rule turned 867 exact answers wrong, by 1.5e-8 to 8.4e-6; taking the
            # wide answer whenever a check trips does the same and moves 1,664 right answers'
            # bits on the sweeps.
            # [measured: family F6 (4,000) + sweeps P1/P2, selection-rule variants, 2026-10-11; cycc 6.6.14]
            var low_any = 0;
            i = 0;
            while (i < n) {
                if (f64_lt(f64_abs(load64(v + i * 8)), F64_TINY) == 1) { low_any = 1; }
                i = i + 1;
            }
            var low_trip = 0;
            if (low_any == 1) {
                i = 0;
                while (i < n && low_trip == 0) {
                    var low_vi = f64_abs(load64(v + i * 8));
                    if (f64_lt(low_vi, F64_TINY) == 0) {
                        # (a): sum of |a_ij| / |lambda| over the components below DBL_MIN, each term
                        # divided first; an overflow here or in low_q is what trips (see above)
                        var low_s = f64_from(0);
                        var low_j = 0;
                        while (low_j < n) {
                            if (f64_lt(f64_abs(load64(v + low_j * 8)), F64_TINY) == 1) {
                                var low_a = f64_abs(f64_mul(ganita_mat_get(A, i, low_j), a_up));
                                low_s = f64_add(low_s, f64_div(low_a, f64_abs(lam_c)));
                            }
                            low_j = low_j + 1;
                        }
                        # (low_s / |v_i|) * 2^-1074 is at most 2^-50 < tol unless low_q is +Inf,
                        # so this trips on overflow alone (see above: the rule kept on purpose)
                        var low_q = f64_div(low_s, low_vi);
                        if (f64_le(tol, f64_mul(low_q, 1)) == 1) { low_trip = 1; }
                    }
                    i = i + 1;
                }
            }
            # (b): v's grid in the matvec's units, g = 2^-1074 (1 + n / |max_val|) (see above)
            if (low_trip == 0) {
                var g2_g = f64_mul(f64_add(F64_ONE, f64_div(f64_from(n), f64_abs(max_val))), 1);
                var g2_lim = f64_mul(g2_g, (1023 + 52) << 52);
                var g2_gs = f64_mul(g2_g, (1023 + 1000) << 52);
                i = 0;
                while (i < n && low_trip == 0) {
                    var g2_vi = f64_abs(load64(v + i * 8));
                    if (f64_lt(g2_vi, g2_lim) == 0 || f64_eq(g2_vi, F64_ONE) == 1) {
                        var g2_s = f64_from(0);
                        var g2_j = 0;
                        while (g2_j < n) {
                            if (f64_lt(f64_abs(load64(v + g2_j * 8)), g2_lim) == 1) {
                                var g2_a = f64_abs(f64_mul(ganita_mat_get(A, i, g2_j), a_up));
                                g2_s = f64_add(g2_s, f64_div(g2_a, f64_abs(lam_c)));
                            }
                            g2_j = g2_j + 1;
                        }
                        var g2_rhs = f64_mul(f64_mul(tol, (1023 + 1000) << 52), g2_vi);
                        if (f64_le(g2_rhs, f64_mul(g2_s, g2_gs)) == 1) { low_trip = 1; }
                    }
                    i = i + 1;
                }
            }
            # ⛔ 3.3.6 — AND A DIRECTION BELOW THE f64 RANGE TRIPS NEITHER CHECK. Both read
            # rows whose v_i is normal, so a dominant eigenvector whose own large component is
            # below 2^-1074 is invisible to them: upper-triangular a00 = -8.9e-18, a01 =
            # -1.684e170, a02 = -8.978e268, a11 = 5.209e-227, a12 = 2.622e248, a22 = 6.05e23 has
            # the dominant eigenvector (1, -3.594e-147, -8.30e-372) (scaled to max 1); its third component
            # flushes on the second pass, and the run settles on a00, Ok(-8.9e-18) for
            # lambda_1 = a22. The radius floor (`_lext_below_rho`) proves such an answer is not
            # dominant: |tr A| / n = 2.0e23 already exceeds it. So an answer below the floor sends
            # the run to the wide iteration if it has not been there, whose answer is taken when
            # it is larger and clears the floor, and is NO_CONVERGENCE otherwise. On the 3.3.5
            # sweeps rebuilt (71,000 and 44,000, the 120-digit Aberth oracle) wrong went 57 -> 42
            # and 88 -> 41 (51 now right, 11 NO_CONVERGENCE); no right answer moved a bit, so no
            # answer that clears the floor changed. On the 3.3.5 review families (4,000 each),
            # 3 + 1 wrong became NO_CONVERGENCE and 3 right; the rest are byte-identical.
            # [measured: eigen_power sweeps P1/P2 + review families F1-F8, 3.3.5 vs this tree, 2026-10-11; cycc 6.6.14]
            # ⚠ What the floor leaves. Exactly, |tr A^3| / n and |tr A^4| / n would catch 8 and 34
            # of the 42 and 41 still wrong (none right), but they cost an O(n^3) sum per answer
            # against O(n^2) per pass, so they are not taken. Still wrong: answers with a complex
            # dominant pair (30 and 15 of them), and real ones a non-normal matrix leaves far from
            # its residual (triangular with near-equal diagonal and couplings up to 1e307 keeps 455
            # of 4,000 wrong; 458 on 3.3.5), and the larger-only rule's
            # weak wide answers from above, 766 of 4,000 of their family, are unchanged).
            # [measured: exact Fraction traces over the remaining wrong rows + review families, 2026-10-11]
            # ⛔ 3.3.7 — AND AN ANSWER BOTH TRACE FLOORS PASS COULD STILL BE NON-DOMINANT.
            # [[1e-3, 0, -1e20], [0, 1.3, 0], [0, 0, -1]] has lambda_1 = 1.3, but the coupling
            # leaves 1.3's direction a share of about 1e-20 of the iterate, growing 1.3-fold a
            # pass (under the growth test's twofold), and the run stopped on -1:
            # Ok(-1.0000000000000002), and the same times 2^558. |tr A| / 3 = 0.10 and
            # sqrt(|tr A^2| / 3) = 0.95 sit below 1. Its 1.3 is a diagonal entry that is a strongly
            # connected component on its own, so an exact eigenvalue (`_lext_scc_floor`): the
            # answer is now proved non-dominant and goes the floor's way, to the wide run and
            # then NO_CONVERGENCE. On 5,000 triangular and block-triangular matrices built for
            # the class (n = 3..5, a second eigenvalue at 0.3 to 1 - 1e-9 of lambda_1, couplings
            # up to 1e300 times it, half of them permuted), 247 of the 263 answers 3.3.6 returned
            # wrong are NO_CONVERGENCE and no right answer moved; the 16 left are 8 answers whose
            # modulus is above rho(A) (a non-normal matrix, far from its residual: no floor sees
            # those) and 8 with a complex dominant pair. On 10,000 generic matrices (dense,
            # sparse to 300 binades, non-negative, symmetric; n = 2..9) one answer, wrong by the
            # same proof, became NO_CONVERGENCE and every other row is byte-identical. An
            # independent SCC analysis agrees with the refusals row for row. The cost was the
            # O(n) diagonal scan of a `_lext_diag_cand` per floor test; Tarjan's O(n^2) reads ran
            # on 184 of the 10,000 and on none of the three bench fixtures. (3.4.0: the gate is
            # `_lext_reducible`, O(n) for a dense A, since a pair's floor needs no diagonal
            # entry past the answer; and a matrix whose components are all single vertices no
            # longer reaches this point at all: `_lext_power_exact` answers it.)
            # [measured: families, seeds 7337/7338/9001, 3.3.6 vs this tree + Fraction oracle, SCC check, 2026-10-31]
            # ⚠ THE |tr A^4| / n FLOOR THE ROADMAP PROPOSED WAS EVALUATED AND NOT TAKEN. It needs
            # A^2, n^3 multiply-adds per answer: on the bench's 12x12 (18 passes of 144) that is
            # +67% of the run's matrix-vector work, on its 3x3 (59 of 9) +5%. On the 263 wrong
            # answers above it would catch 45, 44 of which the diagonal floor catches, and |tr A^3|
            # / n catches 3. The irreducible part of the class (no singleton component) is left to
            # it, and to the roadmap.
            # [measured: same families, exact Fraction traces; pass counts, counting build, 2026-10-31; cycc 6.6.20]
            # ⚠ 3.4.0 — THE IRREDUCIBLE CLASS, MEASURED (the first 3.4.0 tree took no acceptance
            # test for it; the review's certificate below does). On 3,000
            # irreducible 3 x 3 / 4 x 4 (triangular cores with couplings up to 1e20 lambda_1, closed
            # into one component by an entry of 1e-40 to 1e-22; oracle: the characteristic
            # polynomial in Fractions, roots to 70 digits), 2,332 answers are right, 657
            # NO_CONVERGENCE and 11 wrong: each the second real eigenvalue, |lambda_2 / lambda_1|
            # 0.85 to 0.994, the dominant direction growing 1.006 to 1.18-fold a pass, under the
            # growth test's twofold. |tr A^3| / n and |tr A^4| / n floors catch none of the 11; the
            # same iteration on A^T (a second run) catches 1 and refuses 3 right answers; the answer's
            # vector perturbed by 2^-20 and run on catches all 11 in 8 passes but refuses 98% of the
            # right answers, and 3 of 11 in 64 passes refusing 55%. A growth threshold of 1.1 for 2
            # repairs 3 of the 11 and moved nothing else in those 3,000 or in 700 control matrices,
            # but it was not run on the 3.3.5 sweeps the twofold constant was chosen on.
            # [measured: LA-work/r4 drive.py families R (seeds 1-3), G, C + probe, this tree, cycc 6.7.9, 2026-10-31]
            var res_lam = lam;
            var res_vec = v;
            var below = 0;
            if (low_trip == 0) { below = _lext_not_dominant(A, n, lam); }
            if (low_trip == 1 || below == 1) {
                var wide_val = alloc(8);
                var wide_vec = alloc(n * 8);
                if (wide_val == 0 || wide_vec == 0) { return Err(HSB_ERR_ALLOC); }
                var wide_rc = _lext_power_wide(A, n, max_iter, wide_val, wide_vec);
                if (wide_rc != 0) { return Err(wide_rc); }
                var wide_lam = load64(wide_val);
                # |wide| > |plain| (1 + 2^-26): the wide run found a larger eigenvalue
                if (f64_gt(f64_abs(wide_lam), f64_mul(f64_abs(lam), 0x3FF0000004000000)) == 1) {
                    res_lam = wide_lam;
                    res_vec = wide_vec;
                }
                below = _lext_not_dominant(A, n, res_lam);
            }
            # whichever answer stands, one the floor proves is not dominant is not returned, and
            # one it could not check (its scratch refused) is not returned either
            if (below == 2) { return Err(HSB_ERR_ALLOC); }
            if (below == 1) { return Err(HSB_ERR_NO_CONVERGENCE); }
            # ⭐ 3.4.0 review — THE DOMINANCE CERTIFICATE (row 4). The answer must pass Gelfand's
            # bound (`_lext_gelfand`): rho(A) <= 1.001 |lambda|, or it is not returned.
            # ⛔ SECOND REVIEW (R2A SF1, SF4) — ON EVERY ANSWER, NOT BEHIND A GATE. The first review
            # asked for the bound only when ||A||_F^2 > n lambda^2 and said that gate fired on
            # "a non-normal A, the only kind on which a dominant direction can sit below tol, or
            # on an answer short of rho". Both halves were false: a dominant LEFT eigenvector
            # orthogonal to the fixed seed hides the dominant direction on any A, and a short
            # answer passes the gate whenever ||A||_F^2 <= n lambda^2. On 240 such matrices
            # (n = 3..8, lambda_2 / lambda_1 = 0.9 to 0.999, half symmetric) integ-snap9 returned
            # 139 short answers (116 of the 120 symmetric ones, which the gate never asked); all
            # 139 are NO_CONVERGENCE now and the 9 right answers stay. R2A's 12 seed-orthogonal
            # non-normal 4 x 4: Ok(0.99) for rho = 1 in 6, now 0. The row-4 family (drive.py R,
            # seeds 1-3 x 1,000): 10 wrong answers of the first 3.4.0 tree NO_CONVERGENCE and the
            # 2,351 right ones unchanged; 2,100 ordinary matrices (Gaussian, non-negative,
            # Hessenberg, symmetric, companion, tridiagonal, S J S^-1, graded, sparse; n = 2..20):
            # every answer and error identical to integ-snap9, no right answer refused.
            # COST, against the same tree without the certificate (same boot, interleaved, best of
            # 5 x 100 calls, median of 3): one pass over A where the first bound certifies (a
            # non-negative A, or signs matching its Perron vector): eigen_power_3x3 +6.0%,
            # eigen_power_12x12 +11.5%, 2x2_wide +10.5%, tiny2 +14.7%, wide3 +1.9%; and squarings
            # (n^3 each) where it does not: R2A's non-normal fixtures (dominant 2 on a triangular
            # 3 triu(randn) + 0.01 tril(randn)) +9% to +47% at n = 3, +31% to +68% at n = 6,
            # +35% to +47% at n = 12, +20% to +26% at n = 20. integ-snap9's gated version is 8% to
            # 56% slower than this one on 10 of the 11 answered (its squarings were n max|B^m|);
            # this one is 39% slower on the eleventh, where that gate did not fire. At n = 30 /
            # 60 / 100 the squarings cost a symmetric A +119% / +191% / +412% and a
            # triangular-dominant one +143% / +252% / +536%, where a non-negative one costs +7% to
            # +11%.
            # ⭐ THIRD REVIEW — A SYMMETRIC A IS CERTIFIED BY ITS INERTIA (`_lext_sym_cert`): two
            # Cholesky factorizations, of mu I - A and mu I + A with mu = |lambda| (1 + 2^-11), with
            # a rigorous rounding slack, in place of the squarings. Against the same tree without a
            # certificate: n = 30 / 60 / 100 symmetric (dominant entry boosted) +29% / +40% / +56%
            # (the squarings: +104% / +204% / +479% on the same matrices), Gaussian symmetric +9% /
            # +5% / +4% (squarings +51% / +57% / +60%), n = 3 and 12 +0.5% to +33% (squarings +8%
            # to +37%). A non-symmetric A keeps the squarings: at n = 30 / 60 / 100 a
            # triangular-dominant one costs +147% / +250% / +528% (unchanged; 3.4.1: see
            # `_lext_gelfand`: a certified answer is now 0.86 / 0.69 / 0.88 of 3.4.0's uncertified run). Seed-orthogonal
            # symmetric matrices with dominant +1 or -1 (n = 3 to 8): 307 short answers without a
            # certificate, all NO_CONVERGENCE, as through the squarings; 1,200 symmetric matrices
            # (Gaussian, prescribed spectra with gaps to 0.999, non-negative, graded, at 2^+-600 and
            # 2^+-1000): every answer identical to integ-snap12, none refused. The inertia
            # certificate refuses an answer with an eigenvalue at or past about 1.0005 |lambda|
            # (the squarings: past 1.001 |lambda|), so an answer 0.05% to 0.1% short of rho is
            # NO_CONVERGENCE now where it was Ok.
            # [measured: LA4 probes tim2.py, tim3.py; LA4 with and without the certificate, integ-snap12, 2026-10-31]
            # [measured: LA4 probes so.py (seeds 1, 2 + a dominant -1 set), symfam.py (seeds 1, 2), 2026-10-31]
            # ⚠ It cannot see an answer ABOVE rho (Gelfand bounds rho from above), nor one less
            # than 0.1% below it. An irreducible 2 x 2 with a01 near DBL_MAX and a subnormal a10
            # (the dominant eigenvector's second component on the subnormal grid) can stall the
            # plain run with that component off: 19 of 60 such matrices come back Ok more than
            # 1e-9 off (17 above rho, 2 below), the worst 1.5e-3, as on 3.3.7 (3.4.1: a 2 x 2 no
            # longer reaches this loop; see `_lext_power_2x2`. Larger matrices of the kind, whose
            # dominant eigenvector has a component on the subnormal grid, were not probed).
            # [measured: LA2 r4 drive.py, R seeds 1-3 x 1000, G and C x 1000, integ-snap5 vs LA2, 2026-10-31]
            # [measured: LA3 probes so.py, adv.py, fam.py (seeds 1-3) and r4 drive.py, integ-snap9 vs LA3, 2026-10-31]
            # [measured: LA3 probes tim.py and tim2.py, LA3 with and without the certificate, cycc 6.7.9, 2026-10-31]
            # [measured: LA2 probe w4 + w4an.py (60-digit Decimal), 3.3.7, integ-snap5, LA2, 2026-10-31]
            # T, z, zs: Af, w and gfl, none read again after this (3.4.1 LA3: a fresh z took 2 n words a
            # call past 3.4.0's)
            var gc = _lext_gelfand(A, n, res_lam, res_vec, Af, w, gfl);
            if (gc == 2) { return Err(HSB_ERR_ALLOC); }
            if (gc == 0) { return Err(HSB_ERR_NO_CONVERGENCE); }
            store64(out_val, res_lam);
            i = 0;
            while (i < n) {
                store64(out_vec + i * 8, load64(res_vec + i * 8));
                i = i + 1;
            }
            return Ok(0);
        }

        eigenvalue = new_eigenvalue;
        iter = iter + 1;
    }

    return Err(HSB_ERR_NO_CONVERGENCE);
}

# ---- eigen_symmetric's Jacobi (3.4.1) ----
# The column of the largest |W[r][j]| over j > r (W row-major n x n), ties to the lowest j: ganita's
# `_linalg_row_max_col`, which 3.4.0's eigen_symmetric pivoted through, on the flat copy.
fn _lext_jrow_max(W, n, r) {
    var best = r + 1;
    if (best >= n) { return best; }
    var bv = f64_abs(load64(W + (r * n + best) * 8));
    for (var j = r + 2; j < n; j = j + 1) {
        var v = f64_abs(load64(W + (r * n + j) * 8));
        if (f64_gt(v, bv) == 1) {
            bv = v;
            best = j;
        }
    }
    return best;
}

# One Jacobi rotation of the symmetric W (row-major n x n) at (p, q), accumulated into V's columns
# p and q, in ganita_mat_eigen_sym's arithmetic: t the smaller root of t^2 + 2 theta t - 1 = 0,
# theta = (a_qq - a_pp) / 2 a_pq, NEGATIVE for theta = 0 (ganita's `theta > 0` test, which is what
# orders the two entries of an exact tie, [[0, 1], [1, 0]] -> diag(1, -1)), and 0 once theta^2
# overflows (|theta| past 2^511: a_pq^2 / (a_qq - a_pp) is then below 2^-1024 |a_qq - a_pp|, under
# the rounding of either diagonal entry), every update in ganita's form and order.
fn _lext_jrot(W, V, n, p, q) {
    var app = load64(W + (p * n + p) * 8);
    var aqq = load64(W + (q * n + q) * 8);
    var apq = load64(W + (p * n + q) * 8);
    var theta = f64_div(f64_sub(aqq, app), f64_mul(F64_TWO, apq));
    var denom = f64_add(f64_abs(theta), f64_sqrt(f64_add(f64_mul(theta, theta), F64_ONE)));
    var t = f64_neg(f64_div(F64_ONE, denom));
    if (f64_gt(theta, 0) == 1) { t = f64_div(F64_ONE, denom); }
    var c = f64_div(F64_ONE, f64_sqrt(f64_add(f64_mul(t, t), F64_ONE)));
    var sn = f64_mul(t, c);
    var tau = f64_div(sn, f64_add(F64_ONE, c));
    for (var r = 0; r < n; r = r + 1) {
        if (r != p && r != q) {
            var arp = load64(W + (r * n + p) * 8);
            var arq = load64(W + (r * n + q) * 8);
            var nrp = f64_sub(arp, f64_mul(sn, f64_add(arq, f64_mul(tau, arp))));
            var nrq = f64_add(arq, f64_mul(sn, f64_sub(arp, f64_mul(tau, arq))));
            store64(W + (r * n + p) * 8, nrp);
            store64(W + (r * n + q) * 8, nrq);
            store64(W + (p * n + r) * 8, nrp);
            store64(W + (q * n + r) * 8, nrq);
        }
    }
    store64(W + (p * n + p) * 8, f64_sub(app, f64_mul(t, apq)));
    store64(W + (q * n + q) * 8, f64_add(aqq, f64_mul(t, apq)));
    store64(W + (p * n + q) * 8, f64_from(0));
    store64(W + (q * n + p) * 8, f64_from(0));
    for (var r2 = 0; r2 < n; r2 = r2 + 1) {
        var vrp = load64(V + (r2 * n + p) * 8);
        var vrq = load64(V + (r2 * n + q) * 8);
        store64(V + (r2 * n + p) * 8, f64_sub(vrp, f64_mul(sn, f64_add(vrq, f64_mul(tau, vrp)))));
        store64(V + (r2 * n + q) * 8, f64_add(vrq, f64_mul(sn, f64_sub(vrp, f64_mul(tau, vrq)))));
    }
    return 0;
}

# Jacobi on a row-major copy of the symmetric n x n A, in two phases.
# 1. 3.4.0's Jacobi, ganita_mat_eigen_sym's, step for step: the classical pivot (the largest
#    |a_pq| over the upper triangle, read off per-row maxima, ties to the lowest index), its
#    rotation (`_lext_jrot`), until the largest |a_pq| <= 1e-12 max|a_ij| or 100 n^2 rotations.
#    Where 3.4.0's arithmetic stayed in range this is 3.4.0's diagonal and vectors bit for bit, so
#    the eigenvalues come out in 3.4.0's places, and the sort (`linalg_sort_desc`) puts a +-lambda
#    pair, whose moduli tie, in 3.4.0's order.
# 2. Cyclic sweeps with the relative stopping test of Demmel and Veselic: a pair (p, q) is left
#    alone, and a_pq set to 0, when |a_pq| <= 2^-53 sqrt|a_pp| sqrt|a_qq|; the sweeps end when one
#    rotates nothing (at most 100). Phase 1's absolute stop is what left 3.4.0 up to 997 eps
#    |lambda|_max off; this phase moves only what it left, below 1e-12 max|a_ij|.
# A is first scaled by a power of two: up into [1, 2) when its largest |entry| is below 2^-500
# (exact), down by the least power that keeps n max|a_ij| <= 2^1020 (every eigenvalue, and so every
# diagonal entry and every rotated pair, then stays finite), and not at all otherwise. W: n^2 words
# (A, diagonalised in place), V: n^2 words (the rotations, from I). The eigenvalues go to out_vals
# unsorted, V to out_vecs as columns. Returns 0, -3 when 100 sweeps still rotate, or -4 when an
# eigenvalue scaled back passes DBL_MAX; -1 when phase 1's n words of scratch are refused.
fn _lext_jacobi(A, n, W, V, out_vals, out_vecs) {
    var mx = f64_from(0);
    for (var i = 0; i < n; i = i + 1) {
        for (var j = 0; j < n; j = j + 1) {
            var a = ganita_mat_get(A, i, j);
            store64(W + (i * n + j) * 8, a);
            store64(V + (i * n + j) * 8, f64_from(0));
            var aa = f64_abs(a);
            if (f64_gt(aa, mx) == 1) { mx = aa; }
        }
        store64(V + (i * n + i) * 8, F64_ONE);
    }
    var k = 0;
    if ((mx & 0x7FFF_FFFF_FFFF_FFFF) != 0) {
        var lgn = 0;
        while ((1 << lgn) < n) { lgn = lgn + 1; }
        var ex = _lext_xexp(mx);   # mx in [2^(ex-1), 2^ex)
        if (ex <= 0 - 500) { k = 1 - ex; }
        if (ex + lgn > 1020) { k = 1020 - lgn - ex; }
        if (k != 0) {
            for (var q0 = 0; q0 < n * n; q0 = q0 + 1) { store64(W + q0 * 8, _lext_pow2mul(load64(W + q0 * 8), k)); }
        }
    }
    # phase 1: 3.4.0's classical Jacobi, to its 1e-12 max|a_ij| stop (EPSILON_F64 = ganita's LINALG_EPS)
    var rmax = alloc(n * 8);
    if (rmax == 0) { return 0 - 1; }
    var eig_tol = f64_mul(EPSILON_F64, _lext_pow2mul(mx, k));
    for (var i0 = 0; i0 < n - 1; i0 = i0 + 1) { store64(rmax + i0 * 8, _lext_jrow_max(W, n, i0)); }
    var it = 0;
    var go = 1;
    while (go == 1 && it < 100 * n * n) {
        var max_off = f64_from(0);
        var p = 0;
        var q = 1;
        for (var i1 = 0; i1 < n - 1; i1 = i1 + 1) {
            var rc = load64(rmax + i1 * 8);
            var rv = f64_abs(load64(W + (i1 * n + rc) * 8));
            if (f64_gt(rv, max_off) == 1) {
                max_off = rv;
                p = i1;
                q = rc;
            }
        }
        if (f64_le(max_off, eig_tol) == 1) {
            go = 0;
        } else {
            _lext_jrot(W, V, n, p, q);
            # ganita's repair of the per-row maxima: rows p and q in full, every other row from its two
            # changed entries, rescanned only when its maximum was at column p or q
            store64(rmax + p * 8, _lext_jrow_max(W, n, p));
            if (q < n - 1) { store64(rmax + q * 8, _lext_jrow_max(W, n, q)); }
            for (var i2 = 0; i2 < n - 1; i2 = i2 + 1) {
                if (i2 != p && i2 != q) {
                    var rc2 = load64(rmax + i2 * 8);
                    if (rc2 == p || rc2 == q) {
                        store64(rmax + i2 * 8, _lext_jrow_max(W, n, i2));
                    } else {
                        var cv = f64_abs(load64(W + (i2 * n + rc2) * 8));
                        if (p > i2) {
                            var vp = f64_abs(load64(W + (i2 * n + p) * 8));
                            if (f64_gt(vp, cv) == 1) {
                                cv = vp;
                                rc2 = p;
                            }
                        }
                        if (q > i2) {
                            var vq = f64_abs(load64(W + (i2 * n + q) * 8));
                            if (f64_gt(vq, cv) == 1) { rc2 = q; }
                        }
                        store64(rmax + i2 * 8, rc2);
                    }
                }
            }
            it = it + 1;
        }
    }
    # phase 2: cyclic sweeps to the relative stop
    var tolu = 0x3CA0000000000000;   # 2^-53
    var sweep = 0;
    var rot = 1;
    while (rot > 0) {
        if (sweep >= 100) { return 0 - 3; }
        rot = 0;
        for (var pp = 0; pp < n - 1; pp = pp + 1) {
            for (var qq = pp + 1; qq < n; qq = qq + 1) {
                var apq = load64(W + (pp * n + qq) * 8);
                if ((apq & 0x7FFF_FFFF_FFFF_FFFF) != 0) {
                    var app = load64(W + (pp * n + pp) * 8);
                    var aqq = load64(W + (qq * n + qq) * 8);
                    var thr = f64_mul(tolu, f64_mul(f64_sqrt(f64_abs(app)), f64_sqrt(f64_abs(aqq))));
                    if (f64_le(f64_abs(apq), thr) == 1) {
                        store64(W + (pp * n + qq) * 8, f64_from(0));
                        store64(W + (qq * n + pp) * 8, f64_from(0));
                    } else {
                        rot = rot + 1;
                        _lext_jrot(W, V, n, pp, qq);
                    }
                }
            }
        }
        sweep = sweep + 1;
    }
    for (var e = 0; e < n; e = e + 1) {
        var lam = load64(W + (e * n + e) * 8);
        if (k != 0) { lam = _lext_pow2mul(lam, 0 - k); }
        if (f64_lt(f64_abs(lam), F64_POS_INF) == 0) { return 0 - 4; }
        store64(W + (e * n + e) * 8, lam);
    }
    for (var e2 = 0; e2 < n; e2 = e2 + 1) {
        store64(out_vals + e2 * 8, load64(W + (e2 * n + e2) * 8));
        for (var e3 = 0; e3 < n; e3 = e3 + 1) { ganita_mat_set(out_vecs, e2, e3, load64(V + (e2 * n + e3) * 8)); }
    }
    return 0;
}

# Symmetric eigendecomposition via Jacobi rotation (since 3.4.1 hisab's own, `_lext_jacobi`:
# 3.4.0's classical Jacobi, then cyclic sweeps to a relative stop; through 3.4.0 a wrapper around
# ganita_mat_eigen_sym).
# A:        stdlib matrix (n x n, must be symmetric: both triangles are read, and a
#           non-symmetric A is not refused, but what comes back is not its decomposition).
# n:        matrix dimension.
# out_vals: flat f64 array of length n (caller allocates, receives eigenvalues,
#           SORTED BY DESCENDING |lambda| -- see the ordering note below).
# out_vecs: stdlib matrix (n x n, caller allocates, receives eigenvectors as
#           columns, permuted to stay paired with out_vals).
# Returns:  Ok(0) on success, Err(HSB_ERR_NO_CONVERGENCE) if 100 Jacobi sweeps still rotate
#           or an eigenvalue is past DBL_MAX, Err(HSB_ERR_INVALID_INPUT) (since 3.3.6) on a null
#           handle, n <= 0, an A or out_vecs that is not n x n, or a NaN or infinite entry in A, and
#           Err(HSB_ERR_ALLOC) (since 3.3.6) if the two n x n working copies cannot be allocated.
#           Through 3.3.5 every failure was NO_CONVERGENCE. out_vals and out_vecs are written only
#           on Ok.
# Accuracy (3.4.1): 3.4.0's classical Jacobi runs first, then cyclic sweeps rotate each pair until
#           |a_pq| <= 2^-53 sqrt|a_pp| sqrt|a_qq| (Demmel and Veselic's relative test; see
#           `_lext_jacobi`), so every eigenvalue is within a few eps |lambda|_max (worst 5.7 on the
#           review's 482 probe matrices: Gaussian, repeated, ones, K_n, paths, +-1 zero-diagonal,
#           graded over 2^+-60, clustered within 1e-13, Clement, rank 1, wide, Wilkinson, at
#           2^-1070..2^1015, n = 1..30; 3.4.0 up to 997 on 640 matrices of the first lane probe) and
#           the eigenvectors orthonormal to 8.3 eps; on graded positive definite D H D each
#           eigenvalue is within 2.8 eps of itself. A is scaled by a power of two first: up into
#           [1, 2) below 2^-500, down when n max|a_ij| would pass 2^1020.
#           [measured: LA probe jac.py (seeds 1, 2; mpmath 60-digit eigsy), 3.4.0 base and this tree, 2026-10-31]
#           [measured: LA2 probe jrun.py + RV-LA jan.py / jgr.py (mpmath), RV-LA jfam seeds 1, 2, 2026-10-31]
#
# ⛔ 3.4.1 — ganita's Jacobi stopped at max|a_pq| <= 1e-12 max|a_ij| (its LINALG_EPS, absolute
# in A's scale), so an off-diagonal below that was left standing and every eigenvalue near it
# was off by up to that much, with Ok: [[1, e], [e, 1]], e = 1e-13 (3D3C25C268497682), gave
# 1 and 1 with identity vectors, where the eigenvalues are 1 +- e (3FF00000000001C2,
# 3FEFFFFFFFFFFC7B, 450 ulps off) and the vectors (1, +-1) / sqrt 2. On the first lane probe's
# 640 matrices the ganita path was up to 997 eps |lambda|_max off (clustered spectra); the
# relative phase leaves 5.7 at worst on the review's 482 (above). ⚠ eigen_qr is no
# cross-check here: its own 1e-12 deflation (roadmap [3.6.0]) answers that matrix 1 and 1 too.
# [measured: LA probes rep1 and jac.py, 3.4.0 base and this tree, cycc 6.7.18, 2026-10-31]
#
# ⛔ 3.3.6 — n WAS NEVER CHECKED AGAINST A. ganita_mat_eigen_sym takes its n from A and
# writes that many eigenvalues, so diag(1, 2) with n = 1 and an 8-byte out_vals returned
# Ok and overwrote the word after out_vals with 2.0 (the sort then read only n). NaN and
# infinite entries came back Ok with the NaN erased ([[1, NaN], [NaN, 2]] gave (2, 1));
# ganita 1.2.12 (cyrius 6.6.16) refuses them itself, as -2. And every ganita failure was
# mapped to NO_CONVERGENCE, so a 2 x 3 A gave -8 where eigen_qr gives -10.
# ⭐ So this routine checks, before anything is written, every condition ganita's -2
# stood for (and n), as eigen_qr does, with eigen_qr's codes. (Through 3.4.0 ganita could
# then still return its own failures: -1 allocation and -3 the iteration budget, and -2 its
# working copy through 1.2.11; since 3.4.1 ganita's routine is not called.)
# [measured: scratch repro on the 3.3.5 tree, not reproducible in-tree, 2026-10-11; cycc 6.6.14]
# (ganita read at the cyrius tags 6.6.3, 6.6.14 and 6.6.16)
# tests/hisab.tcyr ("3.3.6 eigen_symmetric") pins each refusal and the canary.
#
# THIS ROUTINE HAS NO max_iter PARAMETER. The doc line this replaces named one --
# "HSB_ERR_NO_CONVERGENCE if max_iter exceeded" -- directly above a four-parameter
# signature that has never had it; the budget belonged to ganita_mat_eigen_sym
# (its `var max_iter = 100 * n * n;`, lib/ganita.cyr) and since 3.4.1 is
# `_lext_jacobi`'s 100 sweeps, neither caller-settable. Audit 2026-08-04, api-consistency (low).
#
# ORDERING, and why it changed. The same audit row recorded that this routine and
# eigen_qr carry the same documented contract but returned eigenvalues in
# DIFFERENT orders, neither documented. Measured on the 2.8.4 tree, symmetric
# A = [[2,0,0],[0,3,1],[0,1,3]]:
#     eigen_symmetric -> 2, 4, 2      (Jacobi's final diagonal order: arbitrary)
#     eigen_qr        -> 4, 2, 2      (descending |lambda|, eigen_qr's step-3 sort)
# and on diag(1,5,3): eigen_symmetric -> 1, 5, 3 (input order), eigen_qr -> 5, 3, 1.
# eigen_qr already sorted and already had a suite pinning that order (the
# `eigen_qr 4x4 cond 240` values in tests/hisab.tcyr), so the siblings were made
# to agree by giving eigen_symmetric the SAME descending-|lambda| sort, permuting
# out_vecs' columns with it so a (lambda, v) pair is never broken. eigen_qr is
# unchanged. This is a behaviour change for any caller that read eigen_symmetric's
# raw Jacobi order -- see CHANGELOG "Breaking".
# [measured: CHANGELOG.md 2.9.0, the eigen_symmetric ordering entry ("Measured on the 2.8.4 tree")]
# ⚠ WHAT THE SHARED SORT DOES NOT FIX: A +-lambda PAIR. Both routines sort by the COMPUTED
# |lambda| (the first maximum kept), so they agree wherever their computed moduli are ordered
# alike, which is wherever the moduli differ by more than the two routines' errors. A pair lambda,
# -lambda has one modulus, and its two computed moduli are ordered by rounding, which is each
# algorithm's own: on the 73 matrices of the review's 482 that have such a pair, 3.4.0's
# eigen_symmetric and eigen_qr put them in different orders on 62 (the path [[0,1,0],[1,0,1],
# [0,1,0]]: eigen_symmetric -sqrt 2, +sqrt 2; eigen_qr +sqrt 2, -sqrt 2), and they still do. Only
# a tie-break that ignores rounding could make the two agree, and it would reorder results of
# both: a 3.5.0 question.
# ⛔ 3.4.1 (first form) — the relative Jacobi alone REORDERED THOSE PAIRS: its rotation chose
# t > 0 at theta = 0 where ganita's chose t < 0, and its cyclic order rounded each pair
# differently, so [[0, 1], [1, 0]] gave (-1, 1) where 3.4.0 gave (1, -1), and 71 of those 73
# matrices moved. ⭐ The Jacobi now runs 3.4.0's own sequence first (`_lext_jacobi`, phase 1),
# so the pairs come back in 3.4.0's order: 0 of the 73 differ, except two on the 2^-1070 grid
# whose 3.4.0 values were off by whole grid units (no order to keep there). Not every pair: on R2-LA's
# 796 matrices with exact +-lambda pairs one differs, a graded bipartite 11 x 11 whose 3.4.0 values were
# 0.0043 off (its 1e-12 stop), where the relative sweeps then move the pair by more than its split.
# [measured: LA2 probe pmord.py on RV-LA jfam seeds 1, 2, 3.4.0 base, first 3.4.1 form and this tree, 2026-10-31]
# [measured: R2-LA probe runsym.py (796 matrices with +-lambda pairs), 3.4.0 and 3.4.1-dev, 2026-10-31]
#must_use
public fn eigen_symmetric(A, n, out_vals, out_vecs) {
    if (A == 0 || out_vals == 0) { return Err(HSB_ERR_INVALID_INPUT); }
    if (out_vecs == 0) { return Err(HSB_ERR_INVALID_INPUT); }
    if (n <= 0) { return Err(HSB_ERR_INVALID_INPUT); }
    if (ganita_mat_rows(A) != n || ganita_mat_cols(A) != n) { return Err(HSB_ERR_INVALID_INPUT); }
    # exactly n x n: ganita refuses any other out_vecs
    if (ganita_mat_rows(out_vecs) != n || ganita_mat_cols(out_vecs) != n) { return Err(HSB_ERR_INVALID_INPUT); }
    if (_lext_mat_all_finite(A, n, n) == 0) { return Err(HSB_ERR_INVALID_INPUT); }

    if (n > (ALLOC_MAX / 8) / n) { return Err(HSB_ERR_ALLOC); }
    var jw = alloc(n * n * 8);
    var jv = alloc(n * n * 8);
    if (jw == 0 || jv == 0) { return Err(HSB_ERR_ALLOC); }
    var result = _lext_jacobi(A, n, jw, jv, out_vals, out_vecs);
    if (result == 0 - 1) { return Err(HSB_ERR_ALLOC); }
    if (result < 0) { return Err(HSB_ERR_NO_CONVERGENCE); }

    # Sort by descending |eigenvalue|, columns of out_vecs carried along -- the
    # SAME body eigen_qr's step 3 runs (`linalg_sort_desc`, above), so the two
    # routines order distinct moduli alike (a +-lambda pair: see the ORDERING note).
    # Until 3.2.0 that was two copies asserted identical in comments; it is now one function.
    # ⚠ The line number this once cited (`:1334`) had DRIFTED — that line ended
    # up inside the wrong-sign eigenvalue note, ~420 lines above the sort. Cite
    # by name, not by number: a citation that drifted sends the next reader to
    # code that has nothing to do with the claim.
    var _srt = linalg_sort_desc(out_vals, n, 1, out_vecs, n, 0, 0)?;

    return Ok(0);
}

# ================================================================
# Section 5 -- Lyapunov Exponent
# ================================================================

# ---- lyapunov_max's step (3.4.0) ----
# af: A (times lyapunov_max's 2^s), row-major, n x n words; Q, Z: n x n words, row-major; qc: n
# words of scratch for Q's column. Z <- A Q, one column at a time, each entry summed in order
# (k = 0..n-1 from +0), then every column scaled by the nearest power of two to its largest
# |entry| (which then lies in [2^-1/2, 2^1/2)). out_e[j] receives that power's exponent, so
# column j of A Q is 2^out_e[j] times column j of Z. A column with a non-finite entry is formed
# again from 2^-64 q_j and its exponent raised by 64: A and Q are finite and |q_kj| <= 1, so only
# a sum can overflow, and 2^-64 n DBL_MAX cannot. A zero column is left as it is, exponent 0.
fn _lext_ly_step(af, Q, Z, n, qc, out_e) {
    for (var j = 0; j < n; j = j + 1) {
        for (var c = 0; c < n; c = c + 1) { store64(qc + c * 8, load64(Q + (c * n + j) * 8)); }
        var fin = 1;
        for (var i = 0; i < n; i = i + 1) {
            var sum = f64_from(0);
            var ar = af + i * n * 8;
            for (var k = 0; k < n; k = k + 1) {
                sum = f64_add(sum, f64_mul(load64(ar + k * 8), load64(qc + k * 8)));
            }
            if (f64_lt(f64_abs(sum), F64_POS_INF) == 0) { fin = 0; }
            store64(Z + (i * n + j) * 8, sum);
        }
        var ex = 0;
        if (fin == 0) {
            ex = 64;
            for (var c2 = 0; c2 < n; c2 = c2 + 1) {
                store64(qc + c2 * 8, f64_mul(load64(qc + c2 * 8), 0x3BF0000000000000));   # 2^-64
            }
            for (var i2 = 0; i2 < n; i2 = i2 + 1) {
                var s2 = f64_from(0);
                var ar2 = af + i2 * n * 8;
                for (var k2 = 0; k2 < n; k2 = k2 + 1) {
                    s2 = f64_add(s2, f64_mul(load64(ar2 + k2 * 8), load64(qc + k2 * 8)));
                }
                store64(Z + (i2 * n + j) * 8, s2);
            }
        }
        var mx = f64_from(0);
        for (var i3 = 0; i3 < n; i3 = i3 + 1) {
            var za = f64_abs(load64(Z + (i3 * n + j) * 8));
            if (f64_gt(za, mx) == 1) { mx = za; }
        }
        if ((mx & 0x7FFF_FFFF_FFFF_FFFF) != 0) {
            # mx = m 2^x with 0.5 <= m < 1: scaled by the NEAREST power of two, so the largest
            # |entry| lands in [2^-1/2, 2^1/2), and a column already there (sh = 0) is not touched.
            # ⚠ Nearest, not floor: a growth factor near 1 then keeps sh = 0 and its logarithm
            # whole. Scaling a column of (0.6, 0.8) by 2 and adding -ln 2 back cost a rotation's
            # 100-step exponent its accuracy: 1.0e-15 where the unscaled sum gives 4.2e-17 (the
            # exponent itself is ln sqrt(det) = 2.2e-17 for the rounded entries).
            # [measured: LA probe p7 + orc.py, floor vs nearest, cycc 6.7.9, 2026-10-31]
            # ⛔ 3.4.0 second review (R2A SF3) — THE LARGEST |ENTRY| NOW LANDS NEAR 2^1000, NOT 1.
            # Scaled to 1, an entry below 2^-1074 of its column's largest was flushed, though the
            # caller's units held it: [[1.3 2^-80, 1.7e308], [0, 1.7 2^-60]] gave ln a00 = -55.19 at
            # k = 20, where every k's exact value is ln a11 = -41.06 (column 1 was (1, 0) after
            # scaling, so r11 = 0). Near 2^1000 a column keeps entries down to 2^-2074 of its
            # largest. Every operation of the QR that follows is homogeneous, so its r_jj is the
            # old one times 2^1000 exactly wherever the old one was normal, and lyapunov_max takes
            # that 2^1000 back out (see there): every result that did not lose an entry is bit for
            # bit what it was.
            # [measured: LA3 probe ly.py (R2A ly2.py rows + 80 random, exact oracle), integ-snap9 vs LA3, 2026-10-31]
            var sh = _lext_xexp(mx);
            if (f64_lt(_lext_xman(mx), F64_FRAC_1_SQRT2) == 1) { sh = sh - 1; }
            var up = 1000 - sh;
            if (up >= 0 - 1022 && up <= 1023) {
                var pu = (1023 + up) << 52;
                for (var i4 = 0; i4 < n; i4 = i4 + 1) {
                    store64(Z + (i4 * n + j) * 8, f64_mul(load64(Z + (i4 * n + j) * 8), pu));
                }
            } else {
                for (var i5 = 0; i5 < n; i5 = i5 + 1) {
                    store64(Z + (i5 * n + j) * 8, _lext_pow2mul(load64(Z + (i5 * n + j) * 8), up));
                }
            }
            ex = ex + sh - 1000;
        }
        store64(out_e + j * 8, ex);
    }
    return 0;
}

# The Euclidean norm of the n - k entries W[k..n-1][k] of the row-major n x n W (column k from
# row k down), scaled by their largest |entry| so no square under- or overflows. 0 for all zero.
fn _lext_ly_colnorm(W, n, k) {
    var mx = f64_from(0);
    for (var i = k; i < n; i = i + 1) {
        var a = f64_abs(load64(W + (i * n + k) * 8));
        if (f64_gt(a, mx) == 1) { mx = a; }
    }
    if ((mx & 0x7FFF_FFFF_FFFF_FFFF) == 0) { return mx; }
    var s = f64_from(0);
    for (var i2 = k; i2 < n; i2 = i2 + 1) {
        var q = f64_div(load64(W + (i2 * n + k) * 8), mx);
        s = f64_add(s, f64_mul(q, q));
    }
    return f64_mul(mx, f64_sqrt(s));
}

# Householder QR of the row-major n x n W, in place: W becomes R above the diagonal (its
# diagonal's moduli go to rd), and Q (n x n, row-major) becomes the orthogonal factor, W = Q R.
# u: n words of scratch. ⭐ A reflector is skipped ONLY for a column that is exactly zero from
# the diagonal down (then r_kk = 0 and H = I). ganita_mat_qr skipped one whose column was at most
# 1e-12 of W's largest entry and read r_kk off the diagonal, which held the flag fixed for ever
# on some matrices (see lyapunov_max). The reflector u = x - alpha e_0 is divided by its largest
# |entry| before u.u is formed, so a tiny column neither underflows nor loses its direction.
fn _lext_ly_qr(W, Q, n, rd, u) {
    for (var i = 0; i < n * n; i = i + 1) { store64(Q + i * 8, f64_from(0)); }
    for (var d = 0; d < n; d = d + 1) { store64(Q + (d * n + d) * 8, F64_ONE); }
    for (var k = 0; k < n; k = k + 1) {
        var nrm = _lext_ly_colnorm(W, n, k);
        store64(rd + k * 8, nrm);
        if ((nrm & 0x7FFF_FFFF_FFFF_FFFF) != 0 && k < n - 1) {
            var x0 = load64(W + (k * n + k) * 8);
            var alpha = f64_neg(nrm);
            if (f64_lt(x0, 0) == 1) { alpha = nrm; }
            # u = (x - alpha e_0) / max|.|, no cancellation in u_0 (alpha has x0's opposite sign)
            store64(u, f64_sub(x0, alpha));
            for (var i2 = k + 1; i2 < n; i2 = i2 + 1) { store64(u + (i2 - k) * 8, load64(W + (i2 * n + k) * 8)); }
            var um = f64_from(0);
            for (var i3 = 0; i3 < n - k; i3 = i3 + 1) {
                var ua = f64_abs(load64(u + i3 * 8));
                if (f64_gt(ua, um) == 1) { um = ua; }
            }
            var beta = f64_from(0);
            for (var i4 = 0; i4 < n - k; i4 = i4 + 1) {
                var q4 = f64_div(load64(u + i4 * 8), um);
                store64(u + i4 * 8, q4);
                beta = f64_add(beta, f64_mul(q4, q4));
            }
            var tb = f64_div(F64_TWO, beta);
            # W[k.., k..] <- H W[k.., k..]; column k becomes (alpha, 0, ..., 0)
            store64(W + (k * n + k) * 8, alpha);
            for (var i5 = k + 1; i5 < n; i5 = i5 + 1) { store64(W + (i5 * n + k) * 8, f64_from(0)); }
            for (var j = k + 1; j < n; j = j + 1) {
                var s = f64_from(0);
                for (var i6 = k; i6 < n; i6 = i6 + 1) {
                    s = f64_add(s, f64_mul(load64(u + (i6 - k) * 8), load64(W + (i6 * n + j) * 8)));
                }
                var f = f64_mul(tb, s);
                for (var i7 = k; i7 < n; i7 = i7 + 1) {
                    var wv = load64(W + (i7 * n + j) * 8);
                    store64(W + (i7 * n + j) * 8, f64_sub(wv, f64_mul(f, load64(u + (i7 - k) * 8))));
                }
            }
            # Q <- Q H (columns k.. of every row)
            for (var r = 0; r < n; r = r + 1) {
                var s2 = f64_from(0);
                for (var c = k; c < n; c = c + 1) {
                    s2 = f64_add(s2, f64_mul(load64(Q + (r * n + c) * 8), load64(u + (c - k) * 8)));
                }
                var f2 = f64_mul(tb, s2);
                for (var c2 = k; c2 < n; c2 = c2 + 1) {
                    var qv = load64(Q + (r * n + c2) * 8);
                    store64(Q + (r * n + c2) * 8, f64_sub(qv, f64_mul(f2, load64(u + (c2 - k) * 8))));
                }
            }
        }
    }
    return 0;
}

# Compute the maximal Lyapunov exponent of the linear map x -> A x by the QR method.
# A:          stdlib matrix (n x n -- SHAPE ENFORCED), the Jacobian of the system.
# n:          state dimension.
# iterations: number of QR steps k, at least 1.
# out:        pointer to store the result (f64, allocate 8 bytes).
# Returns:    Ok(0) on success, with out the largest of the n column averages
#             (1/k) sum_t ln |r_jj(t)| (see Method); -Inf only when the arithmetic itself
#             annihilates every column (exact zeros: a strictly triangular A, or one whose
#             nilpotency survives rounding). ⚠ A dense A that is exactly nilpotent gives a
#             finite value at the rounding level instead: rounding makes A Q non-nilpotent
#             (R2A: an integer S J S^-1 with A^3 = 0 gave -10.48 / -10.03 / -11.72 at k = 3 / 10
#             / 50, [[1, 1], [-1, -1]] -24.1 to -35.7, where the exact method gives -Inf).
#             HSB_ERR_INVALID_INPUT on a null handle, a shape that
#             does not match n, a NaN or infinite entry in A (since 3.3.7), or (since 3.4.0)
#             iterations <= 0; HSB_ERR_ALLOC if the working storage cannot be allocated. out is
#             written only on Ok.
#
# Method. Q_0 = I; each step forms Z = A Q_(t-1), factors Z = Q_t R_t, and adds ln |r_jj| to
# column j's sum. The column sums are logarithms of volume growth: over k steps, the first j + 1
# of them add up to ln of the (j + 1)-dimensional volume A^k stretches span(e_0 .. e_j) by. For a
# flag in general position the averages are the Lyapunov exponents in decreasing order, the
# first the largest. Q_0 = I is not in general position for every A, and then the averages are
# the same exponents in another order, a column whose space A annihilates averaging -Inf; so the
# answer is the LARGEST average, not the first. For x -> A x the exponents are ln |lambda_i|,
# and the largest is ln rho(A). Each average converges like 1 / k. That holds for the exact QR
# factor of each Z, which is why the QR is hisab's own (below).
#
# ⛔ 3.4.0 — ONLY COLUMN 0 WAS READ, AND e_0 IS NOT IN GENERAL POSITION FOR EVERY A. An
# upper-triangular A keeps e_0 an eigenvector, so r00 is |a00| on every step: diag(1, 2) and
# [[1, 1], [0, 2]] returned Ok(0) for ln 2, and diag(0, 2), whose A e_0 is 0, gave r00 = 0 on
# every step, which the domain guard skipped, so count stayed 0 and Ok(0) came back for ln 2.
# A nilpotent [[0, 1], [0, 0]] gave Ok(0) as well, where the exponent is -Inf; and
# iterations <= 0 returned Ok(0) as an exponent averaged over no samples.
# [measured: LA probe p2, 3.3.7 base and this tree, cycc 6.7.9, 2026-10-31]
#
# ⛔ 3.4.0 — ganita_mat_qr WAS HANDED Z IN THE CALLER'S UNITS, and its Householder vector
# overflows for a column norm in about (DBL_MAX / 2.61, DBL_MAX / 2.41]: it then returns 0 with
# Q = I and R = Z, finite and wrong, and above that band non-finite factors. The all-equal 2 x 2
# a = 1.6 * 2^1022 returned Ok(ln a) = 708.866 for 10 steps, where the exponent is ln 2a and the
# 10-step answer (ln(a sqrt 2) + 9 ln 2a) / 10 = 709.525; at a = 1.5 * 2^1022 and above, where
# A Q (or the reflector) overflows, it returned NO_CONVERGENCE for a finite A.
# [measured: LA probe p2, 3.3.7 base and this tree, cycc 6.7.9, 2026-10-31]
# ⭐ So every column of Z is scaled by a power of two first (`_lext_ly_step`): Z D = Q (R D) for
# a diagonal D, so the QR of the scaled Z has the same Q and r_jj scaled by D's entry, whose
# exponent goes into the column's sum as an integer and is multiplied by ln 2 once, at the end.
# The QR then sees columns with largest |entry| in [2^999.5, 2^1000.5) (in [2^-1/2, 2^1/2) until
# the second review), whatever A's scale, and a column of A Q that overflows is formed from
# 2^-64 q_j instead. Every finite A is answered. ⚠ What it cannot keep: an entry of a column of
# A Q below about 2^-2074 of that column's largest, and a direction the orthogonal Q itself
# cannot hold. R2A's [[1.7 2^-60, 0], [1.7e308, 1.3 2^-80]]: the first q_0 = (a/c, 1) has
# a/c = 8.6e-327, which flushes, and from then on the method runs on ln |a11|: k = 20 gives
# -16.94 where the exact finite-k value is -3.519. Dense 2 x 2 and 3 x 3 whose entries span
# 10^-150 to 10^150 come back up to 9 times off in 3 of 12 (the same bits through the first
# review); the rest are within 1e-16.
# [measured: LA3 probe ly.py (exact finite-k oracle), integ-snap9 vs LA3, cycc 6.7.9, 2026-10-31]
# [measured: review R2A notes 3 and 4 (ly2.py), cycc 6.7.9, 2026-10-31]
#
# ⛔ 3.4.0 review — AND ganita_mat_qr's SKIP WAS NOT HARMLESS. It skips a reflector whose column,
# below the diagonal, is at most 1e-12 of Z's largest entry, reads r_kk off the diagonal, and
# leaves that column of Q unrotated, so the dominant direction can stay out of the flag at every
# k. A = [[1, 1, 0], [0, 0, 3e13], [0, 1e-13, 0.5]] (eigenvalues 1, 2, -1.5) returned 0 at k = 10,
# 100 and 1000 where the exact QR method gives 0.6156573381623287 (k = 10) and 0.6846742019560775
# (k = 100); the comment here called the skip harmless. The QR is now `_lext_ly_qr`, which skips
# only an exactly zero column, and lyapunov_max no longer calls ganita's QR at all.
# [measured: review REV-LA M2 (t1.py, ly5.py: Fractions + mpmath oracle) and LA2 probe y1, cycc 6.7.9, 2026-10-31]
#
# ⛔ 3.4.0 review — A WITH SUBNORMAL ENTRIES LOST DIGITS: A Q was formed in the caller's units, so
# its products rounded on the subnormal grid before any column scaling (2.8e-7 relative at
# 2^-1065, 4.1e-8 at 2^-1060). A whose largest |a_ij| is below 1 is now scaled up by the power of
# two 2^s that puts it in [1, 2), exactly, and s k is taken off the exponent sums at the end.
# [measured: review REV-LA S4 (t3.py) and LA2 probe y1, cycc 6.7.9, 2026-10-31]
#
# Working storage is allocated once per call (A's scaled copy, Q, Z, five n-word arrays): through
# 3.3.7 ganita_mat_mul allocated a new n x n matrix per step that the bump allocator never
# returned.
#must_use
public fn lyapunov_max(A, n, iterations, out) {
    # NULL HANDLES. A may be the designed 0 from mat_new_guarded's cap.
    if (A == 0 || out == 0) { return Err(HSB_ERR_INVALID_INPUT); }

    # n WAS NOT BOUNDED AT ALL. `mat_new(n, n)` returns the designed 0 for a
    # non-positive n and the 0 went straight into mat_mul, so lyapunov_max(A, 0,
    # ...) and lyapunov_max(A, -2, ...) both SIGSEGV'd (measured, exit 139).
    # [measured: tests/abuse.tcyr, group "abuse: eigen_power / lyapunov_max dimension + null contract", n = 0 and -2]
    if (n <= 0) { return Err(HSB_ERR_INVALID_INPUT); }

    # THE n x n PRECONDITION IS NOW CHECKED, NOT JUST DOCUMENTED. n is a
    # restatement of A's extent and A * Q conforms only when A is n x n;
    # a mismatch is a caller error with no meaningful answer, so it is rejected.
    if (ganita_mat_rows(A) != n || ganita_mat_cols(A) != n) { return Err(HSB_ERR_INVALID_INPUT); }
    # ⛔ 3.3.7 — A NON-FINITE A CAME BACK AS A NUMBER: a NaN entry made every r00 NaN, which
    # the domain guard skipped, so out held the average of whatever was finite (0 for
    # an all-NaN A), with Ok. Refused here, as eigen_symmetric and the SVD wrappers do.
    if (_lext_mat_all_finite(A, n, n) == 0) { return Err(HSB_ERR_INVALID_INPUT); }
    # An average over no steps has no value (3.4.0: Ok(0) through 3.3.7).
    if (iterations <= 0) { return Err(HSB_ERR_INVALID_INPUT); }

    # A ganita matrix of n x n exists, so n n is at most GANITA_MAT_MAX_ELEMS and
    # n n 8 cannot overflow; the allocations below are checked.
    var af = alloc(n * n * 8);   # A 2^s, row-major
    var Q = alloc(n * n * 8);
    var Z = alloc(n * n * 8);
    var sl = alloc(n * 8);   # column j's sum of ln |r_jj| in the scaled frame
    var se = alloc(n * 8);   # ... and of its scale exponents (an integer)
    var ze = alloc(n * 8);   # this step's scale exponents
    var qc = alloc(n * 8);   # Q's column j
    var rd = alloc(n * 8);   # |r_jj| of this step
    var u = alloc(n * 8);    # the reflector
    if (af == 0 || Q == 0 || Z == 0 || sl == 0 || se == 0) { return Err(HSB_ERR_ALLOC); }
    if (ze == 0 || qc == 0 || rd == 0 || u == 0) { return Err(HSB_ERR_ALLOC); }
    # 2^s with max|a_ij| 2^s in [1, 2) when max|a_ij| < 1 (exact, going up), else s = 0
    var amx = f64_from(0);
    for (var ai = 0; ai < n; ai = ai + 1) {
        for (var aj = 0; aj < n; aj = aj + 1) {
            var aa = f64_abs(ganita_mat_get(A, ai, aj));
            if (f64_gt(aa, amx) == 1) { amx = aa; }
        }
    }
    var s = 0;
    if ((amx & 0x7FFF_FFFF_FFFF_FFFF) != 0 && f64_lt(amx, F64_ONE) == 1) { s = 1 - _lext_xexp(amx); }
    for (var bi = 0; bi < n; bi = bi + 1) {
        for (var bj = 0; bj < n; bj = bj + 1) {
            var a = ganita_mat_get(A, bi, bj);
            if (s != 0) { a = _lext_xld(_lext_xman(a), _lext_xexp(a) + s); }
            store64(af + (bi * n + bj) * 8, a);
        }
    }
    var i = 0;
    while (i < n * n) {
        store64(Q + i * 8, f64_from(0));
        i = i + 1;
    }
    i = 0;
    while (i < n) {
        store64(Q + (i * n + i) * 8, F64_ONE);
        store64(sl + i * 8, f64_from(0));
        store64(se + i * 8, 0);
        i = i + 1;
    }

    var iter = 0;
    while (iter < iterations) {
        _lext_ly_step(af, Q, Z, n, qc, ze);
        _lext_ly_qr(Z, Q, n, rd, u);
        i = 0;
        while (i < n) {
            # r_jj is in units of 2^1000 (see _lext_ly_step). Where r_jj 2^-1000 is a normal
            # double its logarithm is taken there, as through the first review; below that, as
            # ln m + e ln 2 for r_jj = m 2^e, m in [1/2, 1), with e carried exactly.
            # ln 0 = -Inf: a column the arithmetic annihilates stays at -Inf.
            var rj = load64(rd + i * 8);
            var ej = load64(ze + i * 8) + 1000;
            if (f64_ge(rj, 0x3E90000000000000) == 1 || f64_eq(rj, 0) == 1) {   # 2^-22
                store64(sl + i * 8, f64_add(load64(sl + i * 8), f64_ln(_lext_pow2mul(rj, 0 - 1000))));
            } else {
                store64(sl + i * 8, f64_add(load64(sl + i * 8), f64_ln(_lext_xman(rj))));
                ej = ej + _lext_xexp(rj) - 1000;
            }
            store64(se + i * 8, load64(se + i * 8) + ej);
            i = i + 1;
        }
        iter = iter + 1;
    }

    # (L + S ln 2) / k per column, S less s k for the prescaling, with ln 2 split so S ln2_hi is
    # exact for |S| < 2^21
    var ln2_hi = 0x3FE62E42FEE00000;   # 0.69314718036912381649017333984375 (ln 2, high 32 bits)
    var ln2_lo = 0x3DEA39EF35793C76;   # ln(2) - 0.69314718036912381649017333984375
    var kf = f64_from(iterations);
    var best = 0xFFF0000000000000;   # -Inf
    i = 0;
    while (i < n) {
        var sf = f64_from(load64(se + i * 8) - s * iterations);
        var tot = f64_add(f64_mul(sf, ln2_hi), f64_add(load64(sl + i * 8), f64_mul(sf, ln2_lo)));
        var avg = f64_div(tot, kf);
        if (f64_gt(avg, best) == 1) { best = avg; }
        i = i + 1;
    }
    store64(out, best);
    return Ok(0);
}

# ================================================================
# Section 6 -- Inertia Tensors
# ================================================================

# Inertia tensor of a solid sphere: diag(I, I, I), I = (2/5) m r^2.
# Returns: 3x3 stdlib matrix, or 0 when it cannot be allocated (3.4.0: stored through it).
# I is the 3.4.0 expression 0.4 (m (r r)) (0.4 = fl(2/5)), bit for bit wherever r r and m r^2 are
# normal doubles; where either would overflow or fall below 2^-1022 (3.4.1: r = 1.6e160, m = 2.3e-101
# gave +Inf for the representable 6DC70FB664EDE14B, and a subnormal r^2 lost 6.2%) the same three
# products are formed on the mantissas of m and r and the power of two put back by one rounding
# (`_lext_xld`), so I is finite wherever its exact value is more than 4 ulps below 2^1024. Accuracy is
# 3.4.0's expression's in either form: its four roundings (0.4 itself is 0.5 u off) and at most one more
# into the subnormal grid bound the error by 4 ulps; measured, at most 2.41 ulps over 20,002 values
# across the whole range (3.4.0: 2,062 of them off or +Inf). Within those ulps of the overflow line I
# may be +-Inf or +-DBL_MAX either way: of 56,964 values aimed at it, 890 are +-Inf where the exact value
# rounds to DBL_MAX and 253 finite where it rounds past. A NaN or infinite m or r, or m or r = 0, takes
# 3.4.0's expression as it is. The range test costs an ordinary call 3 ns (57 -> 61 ns, the 3 x 3
# allocation included).
# [measured: LA3 probe inertia.py seeds 1 and 2 (Fraction oracle, 3.4.0 base and this tree), 2026-11-01]
# [measured: R3-LA probe ine.py seed 1, 56,964 values, Fraction oracle, re-run on this tree, 2026-11-01]
# [measured: LA3 probe ib (200,000 calls, best of 5, 3.4.0 and this tree interleaved x3), 2026-11-01]
public fn inertia_sphere(mass, radius) {
    var c = f64_div(f64_from(2), f64_from(5));
    var r2 = f64_mul(radius, radius);
    var mr2 = f64_mul(mass, r2);
    var I = f64_mul(c, mr2);
    # r^2 and m r^2 both normal (the bits tested in line): 3.4.0's I; otherwise `_lext_isph`
    var br = r2 & 0x7FFF_FFFF_FFFF_FFFF;
    var bm = mr2 & 0x7FFF_FFFF_FFFF_FFFF;
    if (br < 0x0010_0000_0000_0000 || br >= 0x7FF0_0000_0000_0000 || bm < 0x0010_0000_0000_0000
      || bm >= 0x7FF0_0000_0000_0000) {
        I = _lext_isph(mass, radius);
    }
    var m = ganita_mat_new(3, 3);
    if (m == 0) { return 0; }
    ganita_mat_set(m, 0, 0, I);
    ganita_mat_set(m, 1, 1, I);
    ganita_mat_set(m, 2, 2, I);
    return m;
}
# (2/5) m r^2 for `inertia_sphere` (3.4.1 LA3).
fn _lext_isph(mass, radius) {
    var c = f64_div(f64_from(2), f64_from(5));
    var r2 = f64_mul(radius, radius);
    var mr2 = f64_mul(mass, r2);
    var I = f64_mul(c, mr2);
    if (_lext_fin_nz(mass) == 0 || _lext_fin_nz(radius) == 0) { return I; }
    if (_lext_normal(r2) == 1 && _lext_normal(mr2) == 1) { return I; }
    var rm = _lext_xman(radius);
    var y = f64_mul(c, f64_mul(_lext_xman(mass), f64_mul(rm, rm)));
    return _lext_xld(_lext_xman(y), _lext_xexp(y) + _lext_xexp(mass) + 2 * _lext_xexp(radius));
}
# 1 when x is finite and not 0, else 0; 1 when x is a normal double (finite, |x| >= 2^-1022), else 0.
fn _lext_fin_nz(x) {
    var bx = x & 0x7FFF_FFFF_FFFF_FFFF;
    if (bx == 0 || bx >= 0x7FF0_0000_0000_0000) { return 0; }
    return 1;
}
fn _lext_normal(x) {
    var bx = x & 0x7FFF_FFFF_FFFF_FFFF;
    if (bx < 0x0010_0000_0000_0000 || bx >= 0x7FF0_0000_0000_0000) { return 0; }
    return 1;
}

# Inertia tensor of a solid box (cuboid): diag(c (h^2 + d^2), c (w^2 + d^2), c (w^2 + h^2)), c = m / 12,
# w, h, d = 2 hx, 2 hy, 2 hz (hx, hy, hz are half-extents).
# Returns: 3x3 stdlib matrix, or 0 when it cannot be allocated (3.4.0, as inertia_sphere).
# Each entry is the 3.4.0 expression c (u u + v v) bit for bit wherever c, the squares of the doubled
# extents and their sums are normal doubles (or an extent is exactly 0); otherwise (3.4.1: the same overflow to
# +Inf and loss below 2^-1022 as inertia_sphere) it is formed on mantissas with the powers of two put
# back by one rounding, finite wherever the exact value is more than 4.5 ulps below 2^1024 (within them
# +Inf or DBL_MAX either way, as for inertia_sphere). 3.4.0's five roundings, and at most one into the
# subnormal grid, bound the error by 4.5 ulps; measured, at most 2.45 ulps over 76,964 entries across
# the range and at that line (3.4.0: 2,648 of the first 20,000 off or +Inf). A NaN or infinite input, or
# m = 0, takes 3.4.0's expression as it is. The range tests cost an ordinary call 6 ns (65 -> 71 ns).
# [measured: LA3 probe inertia.py seeds 1 and 2 (Fraction oracle, 3.4.0 base and this tree), 2026-11-01]
# [measured: R3-LA probe ine.py seed 1, 56,964 values, Fraction oracle, re-run on this tree, 2026-11-01]
# [measured: LA3 probe ib (200,000 calls, best of 5, 3.4.0 and this tree interleaved x3), 2026-11-01]
public fn inertia_box(mass, hx, hy, hz) {
    var w = f64_mul(f64_from(2), hx);
    var h = f64_mul(f64_from(2), hy);
    var d = f64_mul(f64_from(2), hz);
    var c = f64_div(mass, f64_from(12));
    var ww = f64_mul(w, w);
    var hh = f64_mul(h, h);
    var dd = f64_mul(d, d);
    var s0 = f64_add(hh, dd);
    var s1 = f64_add(ww, dd);
    var s2 = f64_add(ww, hh);
    var I0 = f64_mul(c, s0);
    var I1 = f64_mul(c, s1);
    var I2 = f64_mul(c, s2);
    # c, the three squares and the three sums normal (the bits tested in line): 3.4.0's entries;
    # otherwise each from `_lext_ibox`
    var lo = 0x0010_0000_0000_0000;
    var hi = 0x7FF0_0000_0000_0000;
    var bc = c & 0x7FFF_FFFF_FFFF_FFFF;
    var b0 = ww & 0x7FFF_FFFF_FFFF_FFFF;
    var b1 = hh & 0x7FFF_FFFF_FFFF_FFFF;
    var b2 = dd & 0x7FFF_FFFF_FFFF_FFFF;
    var big = 0;   # a sum past DBL_MAX (each is at least its squares, so never below lo here)
    if (s0 >= hi || s1 >= hi || s2 >= hi) { big = 1; }
    if (bc < lo || bc >= hi || b0 < lo || b0 >= hi || b1 < lo || b1 >= hi || b2 < lo || b2 >= hi || big == 1) {
        I0 = _lext_ibox(mass, hy, hz);
        I1 = _lext_ibox(mass, hx, hz);
        I2 = _lext_ibox(mass, hx, hy);
    }
    var m = ganita_mat_new(3, 3);
    if (m == 0) { return 0; }
    ganita_mat_set(m, 0, 0, I0);
    ganita_mat_set(m, 1, 1, I1);
    ganita_mat_set(m, 2, 2, I2);
    return m;
}
# (m / 12) ((2a)^2 + (2b)^2) for `inertia_box` (3.4.1 LA3).
fn _lext_ibox(mass, a, b) {
    var c = f64_div(mass, f64_from(12));
    var h = f64_mul(f64_from(2), a);
    var d = f64_mul(f64_from(2), b);
    var hh = f64_mul(h, h);
    var dd = f64_mul(d, d);
    var sm = f64_add(hh, dd);
    var I = f64_mul(c, sm);
    if (_lext_fin_nz(mass) == 0 || f64_lt(f64_abs(a), F64_POS_INF) == 0 || f64_lt(f64_abs(b), F64_POS_INF) == 0) {
        return I;
    }
    if ((a & 0x7FFF_FFFF_FFFF_FFFF) == 0 && (b & 0x7FFF_FFFF_FFFF_FFFF) == 0) { return I; }
    var ok = _lext_normal(c) * _lext_normal(sm);
    if ((a & 0x7FFF_FFFF_FFFF_FFFF) != 0) { ok = ok * _lext_normal(hh); }
    if ((b & 0x7FFF_FFFF_FFFF_FFFF) != 0) { ok = ok * _lext_normal(dd); }
    if (ok == 1) { return I; }
    # the larger extent's mantissa in [1/2, 1): (2a)^2 = (a 2^-k)^2 2^(2k + 2), the same for b
    var k = _lext_xexp(a);
    if ((a & 0x7FFF_FFFF_FFFF_FFFF) == 0 || ((b & 0x7FFF_FFFF_FFFF_FFFF) != 0 && _lext_xexp(b) > k)) {
        k = _lext_xexp(b);
    }
    var a1 = _lext_pow2mul(a, 0 - k);
    var b1 = _lext_pow2mul(b, 0 - k);
    var y = f64_mul(f64_div(_lext_xman(mass), f64_from(12)), f64_add(f64_mul(a1, a1), f64_mul(b1, b1)));
    return _lext_xld(_lext_xman(y), _lext_xexp(y) + _lext_xexp(mass) + 2 * k + 2);
}

# ================================================================
# 7. CONDITION NUMBER
# ================================================================

# ---- an exact singularity test and a scaled Gauss-Jordan inverse (3.4.1) ----
# matrix_condition_number and cmat_inverse decide "singular" exactly (`_lext_det_zero`) and
# invert with `_lext_gj_inv`. Arithmetic modulo a prime p < 2^31: every product of two residues
# is below 2^62, so it is formed and reduced in i64 directly.
fn _lext_mpow(b, e, p) {
    var r = 1;
    var bb = b % p;
    var ee = e;
    while (ee > 0) {
        if ((ee & 1) == 1) { r = (r * bb) % p; }
        bb = (bb * bb) % p;
        ee = ee >> 1;
    }
    return r;
}

# A finite double x as m 2^e with m an integer below 2^53 in modulus (sign kept): out[0] = m,
# out[1] = e (the exponent of x's last mantissa bit; -1074 for a subnormal). x = 0 gives m = 0.
fn _lext_xint(x, out) {
    var bx = x & 0x7FFF_FFFF_FFFF_FFFF;
    var be = bx >> 52;
    var m = bx & 0x000F_FFFF_FFFF_FFFF;
    var e = 0 - 1074;
    if (be != 0) {
        m = m | 0x0010_0000_0000_0000;
        e = be - 1075;
    }
    if ((x & 0x8000_0000_0000_0000) != 0) { m = 0 - m; }
    store64(out, m);
    store64(out + 8, e);
    return 0;
}
# The exponent of the lowest set bit of |x| (x = m 2^e with m odd), 2^40 for x = 0; and of the highest,
# floor(lg |x|). Each read off the exponent of an exact double (3.4.1 LA3).
fn _lext_xlow(x) {
    var bx = x & 0x7FFF_FFFF_FFFF_FFFF;
    if (bx == 0) { return 1 << 40; }
    var be = bx >> 52;
    var m = bx & 0x000F_FFFF_FFFF_FFFF;
    var e = 0 - 1074;
    if (be != 0) {
        m = m | 0x0010_0000_0000_0000;
        e = be - 1075;
    }
    return e + (f64_from(m & (0 - m)) >> 52) - 1023;
}
fn _lext_xtop(x) {
    var bx = x & 0x7FFF_FFFF_FFFF_FFFF;
    var be = bx >> 52;
    if (be != 0) { return be - 1023; }
    return (f64_from(bx) >> 52) - 1023 - 1074;
}

# Is det(R + i I) exactly 0? R, I: n x n row-major doubles (I = 0 for a real matrix), each finite;
# only read. Returns 1 (singular), 0 (not), -1 (scratch refused). The scratch is this call's own
# (3.4.1 LA3: nothing is kept between calls, which a caller's alloc_reset() would hand out again):
# n^2 + n + 2 words of heap (`_lext_dz_run`'s H and MD) and a fixed stack buffer.
# 1. INTEGERS. Each entry is m 2^e (m an ODD integer below 2^53); each row's least e, then each
#    column's least remaining one, is factored out (det moves by a power of two), leaving m 2^s with
#    s >= 0 and some s = 0 in every row and every column (`_lext_dz_form`), so an integer matrix keeps
#    its own integers whatever their magnitudes. A zero row or column is singular at once. Each row's
#    and column's norm is bounded from its entries' true bit lengths (floor(lg |x|) + 1 less the two
#    shifts: `_lext_dz_rcb`), and Hadamard's bound on |det| is the lesser of the products of the row
#    and the column bounds. Only the shifts are stored; every entry is decoded from R when it is read.
# 2. ELIMINATION MODULO A PRIME p = 1 (mod 4) just below 2^26 (`_lext_dz_elim`): a complex entry
#    a + bi maps to a + b iota (iota^2 = -1 mod p, a ring map Z[i] -> F_p). Products of residues are
#    below 2^52, so the row updates are left unreduced (a residue is reduced only when it is read:
#    a pivot column, a pivot row, every 1024 pivots), one multiply-subtract each. Full rank modulo p
#    proves det != 0: an invertible matrix stops here.
# 3. A REAL MATRIX OF RANK r < n MODULO p (`_lext_dz_dixon`): B, the r x r block on the pivot rows
#    and columns, is invertible modulo p, so over the p-adic integers too, and det A = +-det B
#    det S with S = E - R B^-1 C the Schur complement on the other rows and columns, S = 0 (mod p).
#    One column of S is lifted p-adically (Dixon: x = B^-1 res mod p, res <- (res - B x) / p, and
#    S's column digit by digit). Each of its entries is an (r + 1)-minor of A over det B, so once the
#    column is 0 mod p^k with p^k past those minors' Hadamard bound, every one of them is 0: that
#    column of A lies in the span of the pivot columns, and det A = 0. A lifting that ends exactly
#    (res = 0: the column of A is an integer combination of the pivot ones) gives that column of S
#    exactly; the same is tried on a row (B^T) for three digits first, so a row or column that is an
#    integer combination of others, its coefficients still integers after the power-of-two scaling
#    (a duplicated row; R2-LA's weighted Laplacians), costs one elimination and a few digits. A digit
#    of S that is not 0 proves S != 0: det A != 0 when n - r = 1; otherwise rank(A) > r is proved,
#    and the next prime is tried (3.4.1 LA3: at every prime, not only the four tabled ones; a prime
#    whose rank is below the proved one is unlucky and only counted). B's LU, which the elimination
#    left in H, is packed in place into 32-bit residues (`_lext_dz_pk`) so that the lifting's integers
#    fit in the rest of H. Whatever the rank, k with p^k past Hadamard's bound on |det A| is enough
#    (3.4.1 LA4): a column of S that is 0 mod p^k makes det S, so det A = +-det B det S, 0 mod p^k
#    with det B a p-adic unit. The bound on those (r + 1)-minors is kept only because it can be lower
#    at a low rank: the form's row and column bounds, as u16 in the stack buffer, up to n =
#    `_LEXT_DZ_KEEP` (through LA3 a larger n went to step 4: hours where this takes seconds). Where
#    the entries spread widely, a lifting that gets past the probe first lowers Hadamard's bound by a
#    scaling (`_lext_dz_scale`), so nothing that ends sooner pays for it.
# 4. Otherwise (a complex matrix, or primes that each left the question open), det is reduced modulo
#    further primes until their product passes Hadamard's bound (|det|^2 for a complex matrix: every
#    prime dividing a + b iota divides a^2 + b^2): zero modulo all of them proves det = 0.
# The last call's primes and lifted p-adic digits (3.4.1 LA3), so the tests can see what a matrix costs.
var _lext_dz_stat: i64[2];
# The largest n whose row and column bounds Dixon keeps in the stack buffer: they and
# `_lext_dz_pk`'s scratch would fit to about n = 4,900, and past this n a matrix takes minutes anyway.
enum _LextDz { _LEXT_DZ_KEEP = 3000; }
fn _lext_det_zero(R, I, n) {
    if (n <= 0 || n > (ALLOC_MAX / 8) / n) { return 0 - 1; }
    var H = alloc(n * n * 8);
    var MD = alloc(n * 8 + 16);
    if (H == 0 || MD == 0) { return 0 - 1; }
    return _lext_dz_run(R, I, n, H, MD, _LEXT_DZ_KEEP);
}
# `_lext_det_zero` on the caller's H (n^2 words) and MD (n + 2 words), so matrix_condition_number can
# use them again after it. MD holds four u16 arrays: each row's least exponent plus 1100, each
# column's, and the pivot rows and columns. The stack buffer `sb` holds the context, the power table,
# the pivot flags (u8) and whatever of the lifting's set does not fit in H. blim: the largest n whose
# bounds are kept for Dixon (`_LEXT_DZ_KEEP`; the tests pass 0 to run that case at a small n).
fn _lext_dz_run(R, I, n, H, MD, blim) {
    store64(&_lext_dz_stat, 0);
    store64(&_lext_dz_stat + 8, 0);
    var sb: i64[8192];   # not cleared (every word is written before it is read)
    var ctx = &sb;               # 28 words
    var tbl = &sb + 28 * 8;      # 100 words: 2^k for k < 32, then 2^(32 j) for j <= 2097 / 32
    var used = &sb + 128 * 8;    # n bytes
    var nu = (n + 7) / 8;
    var spill = used + nu * 8;
    var spw = 8192 - 128 - nu;   # words in the spill area
    var nn = n * n;
    var fs = spill;              # the form's 4 n words: the spill area when they fit, else H's far half
    if (4 * n > spw) { fs = H + nn * 4; }
    var fo: i64[3];   # (`_lext_dz_form`)
    if (_lext_dz_form(R, I, n, MD, fs, &fo, H) == 1) { return 1; }
    var hbits = load64(&fo);
    # each row's and column's bound (u16) for Dixon, ahead of the lifting's part of the spill area,
    # which leaves that part more than `_lext_dz_pk`'s 4 n bytes at this limit
    var bd = 0;
    if (I == 0 && n <= blim) {
        bd = spill;
        for (var q1 = 0; q1 < 2 * n; q1 = q1 + 1) { store16(bd + q1 * 2, load64(fs + q1 * 8)); }
        spill = spill + (n + 1) * 8;
        spw = spw - (n + 1);
    }
    var pr = MD + 4 * n;
    var pc = MD + 6 * n;
    var need = hbits + 1;
    if (I != 0) { need = 2 * hbits + 1; }
    for (var q0 = 0; q0 < 28; q0 = q0 + 1) { store64(ctx + q0 * 8, 0); }
    store64(ctx, n);
    store64(ctx + 40, R);
    store64(ctx + 48, MD);
    store64(ctx + 56, H);
    store64(ctx + 64, spill);
    store64(ctx + 72, spw);
    store64(ctx + 80, tbl);
    store64(ctx + 192, bd);
    store64(ctx + 200, hbits);
    store64(ctx + 208, load64(&fo + 16));
    var lgn = 0;
    while ((1 << lgn) < n) { lgn = lgn + 1; }
    store64(ctx + 24, (load64(&fo + 8) + lgn + 76) / 24 + 1);   # wa
    var have = 0;
    var p = 0;
    var np = 0;
    var rlow = 0;   # a proved lower bound on rank(A)
    while (have < need) {
        var iota = 0;
        if (np == 0) { p = 67108837; iota = 55262216; }
        if (np == 1) { p = 67108777; iota = 48722652; }
        if (np == 2) { p = 67108757; iota = 2509185; }
        if (np == 3) { p = 67108753; iota = 60589810; }
        if (np >= 4) {
            p = p - 4;
            while (num_is_prime(p) == 0) { p = p - 4; }
            if (I != 0) {
                var g = 2;
                while (_lext_mpow(g, (p - 1) / 2, p) != p - 1) { g = g + 1; }
                iota = _lext_mpow(g, (p - 1) / 4, p);
            }
        }
        np = np + 1;
        store64(&_lext_dz_stat, np);
        _lext_dz_tbl(tbl, p);
        _lext_dz_map(R, I, n, MD, iota, p, tbl, H);
        var rk = _lext_dz_elim(H, n, p, pr, pc, used);
        if (rk == n) { return 0; }
        # rank modulo p is at most rank(A); below the proved bound p is unlucky, and its lifting
        # could only come back undecided
        if (I == 0 && rk >= rlow) {
            store64(ctx + 8, rk);
            store64(ctx + 32, p);
            var dx = _lext_dz_dixon(ctx, used);
            if (dx == 0 || dx == 1) { return dx; }
            if (dx == 2) { rlow = rk + 1; }   # S != 0: an (rk + 1)-minor of A is not 0
        }
        # (each prime rebuilds H, and a complex matrix leaves the spill area alone)
        if (I != 0 && np == 1 && load64(&fo + 16) == 1 && 9 * n <= spw) {
            need = 2 * _lext_dz_scale(R, I, n, MD, H, spill, hbits) + 1;
        }
        have = have + 25;   # p > 2^25
    }
    return 1;
}

# The least row and column shifts as MD stores them (u16: a row's plus 1100).
fn _lext_dz_rs(MD, i) { return load16(MD + i * 2) - 1100; }
fn _lext_dz_cs(MD, n, j) { return load16(MD + (n + j) * 2); }

# Step 1 of `_lext_det_zero`: each row's least exponent of a part's lowest set bit (`_lext_xlow`), then
# each column's least remaining one, into MD (u16); 1 for a zero row or column (singular), else 0, with
# fo[0] = log2 of Hadamard's bound rounded up (the lesser of the row and column products of
# `_lext_dz_rcb`'s bounds), fo[1] = the largest bit length and fo[2] = 1 when `_lext_dz_scale` is worth
# running should the bound come to matter. fs: 4 n words of scratch, the bounds in its first 2 n; cl:
# n^2 u16 of scratch, each entry's least exponent plus 1200 (0xFFFF for 0), so that each is decoded once.
fn _lext_dz_form(R, I, n, MD, fs, fo, cl) {
    var big = 1 << 40;
    var rmn = fs;
    var cmn = fs + n * 8;
    var q = 0;
    for (var r = 0; r < n; r = r + 1) {
        var rmin = big;
        for (var c1 = 0; c1 < n; c1 = c1 + 1) {
            var bx = load64(R + q * 8) & 0x7FFF_FFFF_FFFF_FFFF;
            var e = big;
            if (bx != 0) {   # `_lext_xlow`, in line: this loop is the form's only decode
                var be = bx >> 52;
                var m = bx & 0x000F_FFFF_FFFF_FFFF;
                e = 0 - 1074;
                if (be != 0) {
                    m = m | 0x0010_0000_0000_0000;
                    e = be - 1075;
                }
                e = e + (f64_from(m & (0 - m)) >> 52) - 1023;
            }
            if (I != 0) {
                var e2 = _lext_xlow(load64(I + q * 8));
                if (e2 < e) { e = e2; }
            }
            if (e < rmin) { rmin = e; }
            if (e == big) {
                store16(cl + q * 2, 0xFFFF);
            } else {
                store16(cl + q * 2, e + 1200);
            }
            q = q + 1;
        }
        if (rmin == big) { return 1; }   # a zero row
        store64(rmn + r * 8, rmin);
    }
    for (var c = 0; c < n; c = c + 1) { store64(cmn + c * 8, big); }
    q = 0;
    for (var r2 = 0; r2 < n; r2 = r2 + 1) {
        var rm2 = load64(rmn + r2 * 8) + 1200;
        for (var c2 = 0; c2 < n; c2 = c2 + 1) {
            var cv = load16(cl + q * 2);
            if (cv != 0xFFFF && cv - rm2 < load64(cmn + c2 * 8)) { store64(cmn + c2 * 8, cv - rm2); }
            q = q + 1;
        }
    }
    for (var c3 = 0; c3 < n; c3 = c3 + 1) {
        if (load64(cmn + c3 * 8) == big) { return 1; }   # a zero column
    }
    for (var i = 0; i < n; i = i + 1) {
        store16(MD + i * 2, load64(rmn + i * 8) + 1100);
        store16(MD + (n + i) * 2, load64(cmn + i * 8));
    }
    var rb = fs;
    var cb = fs + n * 8;
    _lext_dz_rcb(R, I, n, MD, fs, fo);
    var hr = 0;
    var hc = 0;
    for (var t = 0; t < n; t = t + 1) {
        hr = hr + load64(rb + t * 8);
        hc = hc + load64(cb + t * 8);
    }
    if (hc < hr) { hr = hc; }
    store64(fo, hr);
    return 0;
}
# Each row's and each column's log2 bound on its norm, into fs (rb) and fs + n words (cb), the rest of
# fs being scratch; fo[1], fo[2] as `_lext_dz_form` says. A part x has |x| < 2^b, b = floor(lg |x|) + 1
# less its row's and column's shifts; with M the largest b, sum |part|^2 < 4^M T 2^-40, T = sum of
# 2^(2 (b - M) + 40) (a term below 1 counted as 1), so the norm is below 2^(M + ceil((lg T - 40) / 2))
# (`_lext_dz_bnd`). The two lines of fo[2] are `_lext_dz_scale`'s.
fn _lext_dz_rcb(R, I, n, MD, fs, fo) {
    var rb = fs;
    var cb = fs + n * 8;
    var cmx = fs + 2 * n * 8;
    var ctt = fs + 3 * n * 8;
    for (var c = 0; c < n; c = c + 1) {
        store64(cmx + c * 8, 0);
        store64(ctt + c * 8, 0);
        store64(cb + c * 8, 1 << 40);   # (the sweep's credits until the column bounds go here)
    }
    var np = 1;
    if (I != 0) { np = 2; }
    var csh = MD + n * 2;
    var bmax = 0;
    var sprd = 0;
    for (var pass = 0; pass < 2; pass = pass + 1) {
        for (var r = 0; r < n; r = r + 1) {
            var rm = load16(MD + r * 2) - 1100;
            var mx = 0;
            var mn = 1 << 40;
            if (pass == 1) { mx = load64(rb + r * 8); }
            var rt = 0;
            var o = r * n * 8;
            for (var c1 = 0; c1 < n; c1 = c1 + 1) {
                for (var part = 0; part < np; part = part + 1) {
                    var bx = 0;
                    if (part == 0) {
                        bx = load64(R + o) & 0x7FFF_FFFF_FFFF_FFFF;
                    } else {
                        bx = load64(I + o) & 0x7FFF_FFFF_FFFF_FFFF;
                    }
                    if (bx != 0) {
                        var b = (bx >> 52) - 1022;
                        if (b == 0 - 1022) { b = _lext_xtop(bx) + 1; }   # subnormal
                        b = b - rm - load16(csh + c1 * 2);
                        if (pass == 0) {
                            if (b > mx) { mx = b; }
                            if (b < mn) { mn = b; }
                            if (b > load64(cmx + c1 * 8)) { store64(cmx + c1 * 8, b); }
                        } else {
                            var s1 = 2 * (b - mx) + 40;
                            if (s1 < 0) { s1 = 0; }
                            rt = rt + (1 << s1);
                            if (mx - b < load64(cb + c1 * 8)) { store64(cb + c1 * 8, mx - b); }
                            var s2 = 2 * (b - load64(cmx + c1 * 8)) + 40;
                            if (s2 < 0) { s2 = 0; }
                            store64(ctt + c1 * 8, load64(ctt + c1 * 8) + (1 << s2));
                        }
                    }
                }
                o = o + 8;
            }
            if (pass == 0) {
                store64(rb + r * 8, mx);
                if (mx > bmax) { bmax = mx; }
                sprd = sprd + mx - mn;
            } else {
                store64(rb + r * 8, _lext_dz_bnd(mx, rt));
            }
        }
    }
    var crd = 0;
    for (var c2 = 0; c2 < n; c2 = c2 + 1) {
        crd = crd + load64(cb + c2 * 8);
        store64(cb + c2 * 8, _lext_dz_bnd(load64(cmx + c2 * 8), load64(ctt + c2 * 8)));
    }
    store64(fo + 8, bmax);
    store64(fo + 16, 0);
    if (crd >= 4 * n || sprd >= 16 * n) { store64(fo + 16, 1); }
    return 0;
}
# M + ceil((lg T - 40) / 2) or one more, for T >= 2^40: lg T rounded up is read off the exponent of the
# double nearest T - 1 (its bit length, or one more when the conversion rounds up).
fn _lext_dz_bnd(mx, tt) {
    return mx + ((f64_from(tt - 1) >> 52) - 1022 - 39) / 2;
}

# ---- step 1 of `_lext_det_zero`: a bound for a matrix whose entries spread widely (3.4.1 LA4) ----
# Why. The raw bounds charge a row or a column for its largest entry whether or not any term of the
# determinant can use it: in [[B, C], [0, D]] no term of det A touches C, yet C at 2^1000 put about
# 1000 n / 2 bits in both products, 1,900 digits at n = 100 where det A is below 2^900.
# THE BOUND. Let A be the integer matrix after the shifts and c_j >= 0 ANY integers, D = diag(2^c_j).
# det A = det(A D) 2^-(sum of c_j), and Hadamard's inequality on the rows of A D gives
#     |det A| < 2^(sum of w_i - sum of c_j),  w_i >= lg ||row i of A D||.
# That is all the proof there is. It holds for every c, so nothing here can make the bound short and
# no property of the algorithm below is used; each w_i is formed from the same inequality as a raw row
# bound (`_lext_dz_wrow`), with b + c_j for b. Only that one number moves: step 3 needs no more.
# CHOOSING c. With u_i the largest b_ij + c_j of row i, b_ij the entries' bit lengths, each w_i is u_i
# and at most lg(n) / 2 more, and the least over c of sum u_i - sum c_j is the tropical determinant, the
# largest sum of b_ij over a permutation (duality for the assignment problem). c_j = min over i of (u_i
# - b_ij) is the sweep (one pass: a second moved nothing on any family measured, since it stops at a
# coordinate minimum); it takes C's 2^1000 out at once. It stops short on a chain, [[B1, C1, 0], [0, B2,
# C2], [0, 0, B3]], whose credits must add up along the path, and on an arrow (a wide first row and
# column), where it finds no credit at all; so where a row still spreads widely after it, the
# potentials go through shortest augmenting paths (`_lext_dz_asg`).
# WHEN. A cost, not a soundness matter. `_lext_dz_rcb` asks for this when the sweep's credits sum to 4
# bits a column or the rows' spreads (largest less least bit length) to 16 bits a row, and the paths
# run on 16 bits a row of spread after the sweep. Without a credit the most saved is the rows' spreads,
# so the Gram, U V and uniform matrices measured (at most 13 bits a row at n = 10 to 100, credits below
# 1 bit a column) run neither and pay a compare or two an entry; and it runs only once a matrix has
# got past `_lext_dz_dixon`'s probe (or, complex, past one prime), so one that ends sooner pays nothing.
# ce: n^2 u16 of scratch; ws: 9 n words. Returns the lesser of hb and this bound.
# [measured: LA4 probes pt.py, pt2.py, pt3.py (the bit sums, 24 families, n = 10 to 100), mg.py, 2026-11-01]
fn _lext_dz_scale(R, I, n, MD, ce, ws, hb) {
    var u = ws;
    var cr = ws + n * 8;
    var w = ws + 2 * n * 8;
    var csh = MD + n * 2;
    var np = 1;
    if (I != 0) { np = 2; }
    for (var c = 0; c < n; c = c + 1) { store64(cr + c * 8, 1 << 40); }
    var q = 0;
    for (var r = 0; r < n; r = r + 1) {
        var rm = load16(MD + r * 2) - 1100;
        var mx = 0;
        for (var c1 = 0; c1 < n; c1 = c1 + 1) {
            var bx = load64(R + q * 8) & 0x7FFF_FFFF_FFFF_FFFF;
            if (I != 0) {
                var bi = load64(I + q * 8) & 0x7FFF_FFFF_FFFF_FFFF;
                if (bi > bx) { bx = bi; }
            }
            var cv = 0xFFFF;
            if (bx != 0) {
                cv = (bx >> 52) - 1022;
                if (cv == 0 - 1022) { cv = _lext_xtop(bx) + 1; }   # subnormal
                cv = cv - rm - load16(csh + c1 * 2);
                if (cv > mx) { mx = cv; }
            }
            store16(ce + q * 2, cv);
            q = q + 1;
        }
        var rw = ce + r * n * 2;
        for (var c2 = 0; c2 < n; c2 = c2 + 1) {
            var cv2 = load16(rw + c2 * 2);
            if (cv2 != 0xFFFF && mx - cv2 < load64(cr + c2 * 8)) { store64(cr + c2 * 8, mx - cv2); }
        }
    }
    if (_lext_dz_wrow(ce, n, u, cr, w, np) >= 16 * n && _lext_dz_asg(ce, n, u, cr, ws + 3 * n * 8) > 0) {
        var cm = 1 << 40;
        for (var t = 0; t < n; t = t + 1) {
            if (load64(cr + t * 8) < cm) { cm = load64(cr + t * 8); }
        }
        for (var t1 = 0; t1 < n; t1 = t1 + 1) { store64(cr + t1 * 8, load64(cr + t1 * 8) - cm); }
        _lext_dz_wrow(ce, n, u, cr, w, np);
    }
    var tot = 0;
    for (var t2 = 0; t2 < n; t2 = t2 + 1) { tot = tot + load64(w + t2 * 8) - load64(cr + t2 * 8); }
    if (tot < hb) { return tot; }
    return hb;
}
# For each row of A D (`_lext_dz_scale`): u[r] = M, the largest bit length b + c_j there, and w[r] the
# bound on its norm from T as in `_lext_dz_rcb`, every entry's b bounding each of its np parts. Returns
# the sum of the rows' spreads, M less the least b + c_j. ce: b_ij (u16, 0xFFFF for 0); c_j >= 0.
fn _lext_dz_wrow(ce, n, u, cr, w, np) {
    var sprd = 0;
    for (var r = 0; r < n; r = r + 1) {
        var rw = ce + r * n * 2;
        var mx = 0;
        var mn = 1 << 40;
        for (var c = 0; c < n; c = c + 1) {
            var cv = load16(rw + c * 2);
            if (cv != 0xFFFF) {
                cv = cv + load64(cr + c * 8);
                if (cv > mx) { mx = cv; }
                if (cv < mn) { mn = cv; }
            }
        }
        var tt = 0;
        for (var c2 = 0; c2 < n; c2 = c2 + 1) {
            var cv2 = load16(rw + c2 * 2);
            if (cv2 != 0xFFFF) {
                var s = 2 * (cv2 + load64(cr + c2 * 8) - mx) + 40;
                if (s < 0) { s = 0; }
                tt = tt + (np << s);
            }
        }
        store64(u + r * 8, mx);
        store64(w + r * 8, _lext_dz_bnd(mx, tt));
        sprd = sprd + mx - mn;
    }
    return sprd;
}
# Lower sum u - sum c over u_i - c_j >= b_ij on the non-zero entries (u, cr: n words each, feasible on
# entry and at every step, c_j free in sign): shortest augmenting paths on the reduced costs u_i - c_j -
# b_ij >= 0 (Hungarian, in the Jonker-Volgenant order: tight entries matched greedily first, then each
# row left free from its own path). A path's length D comes off the sum, which the sum of them returned
# says. Only a cheaper bound rests on this: `_lext_dz_scale` derives u again from c, so the proof above
# does not depend on one line here. It stops after 16 n^2 column steps, against the method's n^3: the
# families that reach it took at most 6.5 n^2 (a chain's gains come at the end, so a stop on the gain so
# far would stop short). A row with no path (no permutation of non-zero entries through it) is left.
# ws: 6 n words.
fn _lext_dz_asg(ce, n, u, cr, ws) {
    var rowm = ws;
    var colm = ws + n * 8;
    var dist = ws + 2 * n * 8;
    var prev = ws + 3 * n * 8;
    var tree = ws + 4 * n * 8;
    var seen = ws + 5 * n * 8;
    for (var i = 0; i < n; i = i + 1) {
        store64(rowm + i * 8, 0 - 1);
        store64(colm + i * 8, 0 - 1);
    }
    for (var i1 = 0; i1 < n; i1 = i1 + 1) {
        var rw = ce + i1 * n * 2;
        var ui = load64(u + i1 * 8);
        var j = 0;
        while (j < n && load64(rowm + i1 * 8) < 0) {
            var cv = load16(rw + j * 2);
            if (cv != 0xFFFF && load64(colm + j * 8) < 0 && ui - load64(cr + j * 8) == cv) {
                store64(rowm + i1 * 8, j);
                store64(colm + j * 8, i1);
            }
            j = j + 1;
        }
    }
    var budget = 16 * n * n;
    var gain = 0;
    var inf = 1 << 60;
    for (var i0 = 0; i0 < n; i0 = i0 + 1) {
        if (load64(rowm + i0 * 8) < 0) {
            for (var j0 = 0; j0 < n; j0 = j0 + 1) {
                store64(dist + j0 * 8, inf);
                store64(seen + j0 * 8, 0);
            }
            var i2 = i0;
            var d0 = 0;
            var nt = 0;
            var last = 0 - 1;
            while (last < 0 && i2 >= 0) {
                budget = budget - n;   # (each pass of the loop below reads n columns)
                if (budget < 0) { return gain; }
                var rw2 = ce + i2 * n * 2;
                var base = d0 + load64(u + i2 * 8);
                var dm = inf;
                var jm = 0 - 1;
                for (var j1 = 0; j1 < n; j1 = j1 + 1) {
                    if (load64(seen + j1 * 8) == 0) {
                        var dj = load64(dist + j1 * 8);
                        var cv2 = load16(rw2 + j1 * 2);
                        if (cv2 != 0xFFFF) {
                            var nd = base - load64(cr + j1 * 8) - cv2;
                            if (nd < dj) {
                                dj = nd;
                                store64(dist + j1 * 8, nd);
                                store64(prev + j1 * 8, i2);
                            }
                        }
                        if (dj < dm) {
                            dm = dj;
                            jm = j1;
                        }
                    }
                }
                if (jm < 0) {
                    i2 = 0 - 1;   # no path from this row
                } else {
                    store64(seen + jm * 8, 1);
                    store64(tree + nt * 8, jm);
                    nt = nt + 1;
                    if (load64(colm + jm * 8) < 0) {
                        last = jm;
                    } else {
                        i2 = load64(colm + jm * 8);
                        d0 = dm;
                    }
                }
            }
            if (last >= 0) {
                var dd = load64(dist + last * 8);
                gain = gain + dd;
                store64(u + i0 * 8, load64(u + i0 * 8) - dd);
                for (var t = 0; t < nt - 1; t = t + 1) {
                    var j2 = load64(tree + t * 8);
                    var e = dd - load64(dist + j2 * 8);
                    var i3 = load64(colm + j2 * 8);
                    store64(cr + j2 * 8, load64(cr + j2 * 8) - e);
                    store64(u + i3 * 8, load64(u + i3 * 8) - e);
                }
                var j3 = last;
                var i4 = 0 - 1;
                while (i4 != i0) {
                    i4 = load64(prev + j3 * 8);
                    var nx = load64(rowm + i4 * 8);
                    store64(rowm + i4 * 8, j3);
                    store64(colm + j3 * 8, i4);
                    j3 = nx;
                }
            }
        }
    }
    return gain;
}

# tbl: 2^k mod p for k < 32, then 2^(32 j) mod p for j = 0..65, so 2^s = tbl[s & 31] tbl[32 + s / 32]
# for every s <= 2097 (the largest shift: an exponent of 1023 against a least one of -1074).
fn _lext_dz_tbl(tbl, p) {
    var t = 1;
    for (var k = 0; k < 32; k = k + 1) {
        store64(tbl + k * 8, t);
        t = (t * 2) % p;
    }
    var t2 = 1;
    for (var j = 0; j < 66; j = j + 1) {
        store64(tbl + (32 + j) * 8, t2);
        t2 = (t2 * t) % p;   # t = 2^32 mod p
    }
    return 0;
}
# x 2^-sh mod p for a double x that is an integer multiple of 2^sh (sh at most its lowest set bit's
# exponent; the mantissa then has the trailing zeros a negative shift needs).
fn _lext_dz_res(x, sh, p, tbl) {
    var bx = x & 0x7FFF_FFFF_FFFF_FFFF;
    if (bx == 0) { return 0; }
    var be = bx >> 52;
    var m = bx & 0x000F_FFFF_FFFF_FFFF;
    var e = 0 - 1074;
    if (be != 0) {
        m = m | 0x0010_0000_0000_0000;
        e = be - 1075;
    }
    var s = e - sh;
    if (s < 0) {
        m = m >> (0 - s);
        s = 0;
    }
    var a = (((m % p) * load64(tbl + (s & 31) * 8)) % p * load64(tbl + (32 + s / 32) * 8)) % p;
    if (x != bx && a != 0) { a = p - a; }
    return a;
}
# The residue of every entry, m 2^s (+ iota m' 2^s') mod p, into w (n x n words).
fn _lext_dz_map(R, I, n, MD, iota, p, tbl, w) {
    for (var r = 0; r < n; r = r + 1) {
        var rm = _lext_dz_rs(MD, r);
        for (var c = 0; c < n; c = c + 1) {
            var q = (r * n + c) * 8;
            var sh = rm + _lext_dz_cs(MD, n, c);
            var a = _lext_dz_res(load64(R + q), sh, p, tbl);
            if (I != 0) {
                var b = _lext_dz_res(load64(I + q), sh, p, tbl);
                a = (a + (b * iota) % p) % p;
            }
            store64(w + q, a);
        }
    }
    return 0;
}

# Rank-revealing Gaussian elimination of the n x n residues w modulo p (p < 2^26), in place. Column
# by column: the unused rows' entries in it are reduced and the first non-zero one is the pivot
# (none: a column off the pivot set); the pivot row is reduced and every unused row with a non-zero
# entry there takes multiplier f = w_ij / pivot (stored in its place) and is updated unreduced,
# w_ic -= f w_pc, each product below 2^52 (the unused rows are reduced every 1024 pivots, so no
# entry passes 2^63). Returns the rank r, with pr[0..r) and pc[0..r) the pivot rows and columns in
# order (u16 arrays): B = A[pr, pc] = L U modulo p. used: n bytes (1 for a pivot row).
fn _lext_dz_elim(w, n, p, pr, pc, used) {
    for (var i = 0; i < n; i = i + 1) { store8(used + i, 0); }
    var r = 0;
    for (var j = 0; j < n; j = j + 1) {
        var piv = 0 - 1;
        for (var i1 = 0; i1 < n; i1 = i1 + 1) {
            if (load8(used + i1) == 0) {
                var v = load64(w + (i1 * n + j) * 8) % p;
                if (v < 0) { v = v + p; }
                store64(w + (i1 * n + j) * 8, v);
                if (piv < 0 && v != 0) { piv = i1; }
            }
        }
        if (piv >= 0) {
            store8(used + piv, 1);
            store16(pr + r * 2, piv);
            store16(pc + r * 2, j);
            var pw = w + piv * n * 8;
            for (var c = j + 1; c < n; c = c + 1) {
                var v2 = load64(pw + c * 8) % p;
                if (v2 < 0) { v2 = v2 + p; }
                store64(pw + c * 8, v2);
            }
            var inv = _lext_mpow(load64(pw + j * 8), p - 2, p);
            store64(pw + j * 8, inv);   # U's diagonal is only ever divided by (`_lext_dz_pk`)
            for (var i2 = 0; i2 < n; i2 = i2 + 1) {
                var rw = w + i2 * n * 8;
                if (load8(used + i2) == 0 && load64(rw + j * 8) != 0) {
                    var f = (load64(rw + j * 8) * inv) % p;
                    store64(rw + j * 8, f);
                    for (var c2 = j + 1; c2 < n; c2 = c2 + 1) {
                        store64(rw + c2 * 8, load64(rw + c2 * 8) - f * load64(pw + c2 * 8));
                    }
                }
            }
            r = r + 1;
            if ((r & 1023) == 0) {
                for (var i3 = 0; i3 < n; i3 = i3 + 1) {
                    if (load8(used + i3) == 0) {
                        for (var c3 = j + 1; c3 < n; c3 = c3 + 1) {
                            var v3 = load64(w + (i3 * n + c3) * 8) % p;
                            if (v3 < 0) { v3 = v3 + p; }
                            store64(w + (i3 * n + c3) * 8, v3);
                        }
                    }
                }
            }
        }
    }
    return r;
}

# ---- step 3 of `_lext_det_zero`: Dixon's p-adic lifting of the Schur complement ----
# Exact integers in limbs of 2^24, wa signed words, value sum v_k 2^(24 k); normalised, the limbs
# below the top one are in [0, 2^24) and the top one carries the sign. An entry x = m 2^s (its shifts
# sh taken out) is decoded from the double when it is read: q = s / 24 and the four 24-bit pieces of
# |m| 2^(s mod 24) (3.4.1 LA3: no copy of A's integers is kept).
# v <- the entry x of shift sh.
fn _lext_dz_ld(v, wa, x, sh) {
    for (var k = 0; k < wa; k = k + 1) { store64(v + k * 8, 0); }
    _lext_dz_put(v, x, sh, 0 - 1);
    return 0;
}
# v <- v - xv x for the entry x of shift sh (decoded as in `_lext_dz_mac`).
fn _lext_dz_put(v, x, sh, xv) {
    var bx = x & 0x7FFF_FFFF_FFFF_FFFF;
    if (bx == 0) { return 0; }
    var be = bx >> 52;
    var m = bx & 0x000F_FFFF_FFFF_FFFF;
    var e = 0 - 1074;
    if (be != 0) {
        m = m | 0x0010_0000_0000_0000;
        e = be - 1075;
    }
    var s = e - sh;
    if (s < 0) {
        m = m >> (0 - s);
        s = 0;
    }
    var q = (s * 2731) >> 16;   # s / 24, exact over the range of s
    var t0 = (m & 0xFF_FFFF) << (s - 24 * q);
    var t1 = ((m >> 24) & 0xFF_FFFF) << (s - 24 * q);
    var t2 = (m >> 48) << (s - 24 * q);
    var u1 = t1 + (t0 >> 24);
    var u2 = t2 + (u1 >> 24);
    var xx = xv;
    if (x != bx) { xx = 0 - xv; }
    var vq = v + q * 8;
    store64(vq, load64(vq) - (t0 & 0xFF_FFFF) * xx);
    store64(vq + 8, load64(vq + 8) - (u1 & 0xFF_FFFF) * xx);
    store64(vq + 16, load64(vq + 16) - (u2 & 0xFF_FFFF) * xx);
    store64(vq + 24, load64(vq + 24) - (u2 >> 24) * xx);
    return 0;
}
# v <- v - sum over t < r of x[t] times the entry at base + oa[t] (its shift sb + os[t]), the decode
# and the four multiply-subtracts written out in the loop (one call a row, not one an entry); each
# term is below 2^49 a limb, and v is normalised every 4096 terms.
fn _lext_dz_mac(v, base, oa, os, sb, x, r, wa) {
    for (var t = 0; t < r; t = t + 1) {
        var xv = load64(x + t * 8);
        if (xv != 0) {
            var xd = load64(base + load64(oa + t * 8));
            var bx = xd & 0x7FFF_FFFF_FFFF_FFFF;
            if (bx != 0) {
                var be = bx >> 52;
                var m = bx & 0x000F_FFFF_FFFF_FFFF;
                var e = 0 - 1074;
                if (be != 0) {
                    m = m | 0x0010_0000_0000_0000;
                    e = be - 1075;
                }
                var s = e - sb - load64(os + t * 8);
                if (s < 0) {
                    m = m >> (0 - s);
                    s = 0;
                }
                var q = (s * 2731) >> 16;
                var sh = s - 24 * q;
                var t0 = (m & 0xFF_FFFF) << sh;
                var t1 = ((m >> 24) & 0xFF_FFFF) << sh;
                var t2 = (m >> 48) << sh;
                var u1 = t1 + (t0 >> 24);
                var u2 = t2 + (u1 >> 24);
                var xx = xv;
                if (xd != bx) { xx = 0 - xv; }
                var vq = v + q * 8;
                store64(vq, load64(vq) - (t0 & 0xFF_FFFF) * xx);
                store64(vq + 8, load64(vq + 8) - (u1 & 0xFF_FFFF) * xx);
                if (u2 != 0) {
                    store64(vq + 16, load64(vq + 16) - (u2 & 0xFF_FFFF) * xx);
                    store64(vq + 24, load64(vq + 24) - (u2 >> 24) * xx);
                }
            }
        }
        if ((t & 4095) == 4095) { _lext_dz_norm(v, wa); }
    }
    return 0;
}
# Normalise v (floor carries), then divide it by p exactly in place; returns v mod p (0 when p | v).
fn _lext_dz_divp(v, wa, p) {
    var cy = 0;
    for (var k = 0; k < wa - 1; k = k + 1) {
        var t = load64(v + k * 8) + cy;
        var lo = t & 0xFF_FFFF;   # t - lo is a multiple of 2^24 whatever t's sign
        cy = (t - lo) / 0x100_0000;
        store64(v + k * 8, lo);
    }
    store64(v + (wa - 1) * 8, load64(v + (wa - 1) * 8) + cy);
    var rem = 0;
    var k2 = wa - 1;
    while (k2 >= 0) {
        var cur = rem * 0x100_0000 + load64(v + k2 * 8);
        var qq = cur / p;
        if (cur - qq * p < 0) { qq = qq - 1; }   # floor
        rem = cur - qq * p;
        store64(v + k2 * 8, qq);
        k2 = k2 - 1;
    }
    return rem;
}
fn _lext_dz_iszero(v, wa) {
    for (var k = 0; k < wa; k = k + 1) {
        if (load64(v + k * 8) != 0) { return 0; }
    }
    return 1;
}
# x = B^-1 y (tr = 0) or B^-T y (tr = 1) modulo p, from B's LU in f (r x r, row-major, packed u32: L
# below the diagonal, U from it) and the inverses of U's diagonal dinv (u32); each x in balanced form
# (-p/2, p/2]. Sums are reduced once per entry (every 1024 terms past that), each product being below
# 2^52.
fn _lext_dz_solve(f, dinv, r, p, tr, y, x) {
    for (var u = 0; u < r; u = u + 1) {
        var acc = load64(y + u * 8);
        for (var v = 0; v < u; v = v + 1) {
            var fe = load32(f + (u * r + v) * 4);
            if (tr == 1) { fe = load32(f + (v * r + u) * 4); }
            acc = acc - fe * load64(x + v * 8);
            if ((v & 1023) == 1023) { acc = acc % p; }
        }
        acc = acc % p;
        if (acc < 0) { acc = acc + p; }
        if (tr == 1) { acc = (acc * load32(dinv + u * 4)) % p; }
        store64(x + u * 8, acc);
    }
    var u2 = r - 1;
    while (u2 >= 0) {
        var acc2 = load64(x + u2 * 8);
        for (var v2 = u2 + 1; v2 < r; v2 = v2 + 1) {
            var fe2 = load32(f + (u2 * r + v2) * 4);
            if (tr == 1) { fe2 = load32(f + (v2 * r + u2) * 4); }
            var xv = load64(x + v2 * 8);
            if (xv < 0) { xv = xv + p; }
            acc2 = acc2 - fe2 * xv;
            if ((v2 & 1023) == 1023) { acc2 = acc2 % p; }
        }
        acc2 = acc2 % p;
        if (acc2 < 0) { acc2 = acc2 + p; }
        if (tr == 0) { acc2 = (acc2 * load32(dinv + u2 * 4)) % p; }
        if (acc2 > p / 2) { acc2 = acc2 - p; }
        store64(x + u2 * 8, acc2);
        u2 = u2 - 1;
    }
    return 0;
}
# `nb` words from the lifting's two regions: H past ctx[22] words, then the stack spill area past
# ctx[23]; 0 when neither has them (the prime is then left undecided, and CRT decides).
fn _lext_dz_take(ctx, nb) {
    var n = load64(ctx);
    var hu = load64(ctx + 176);
    if (hu + nb <= n * n) {
        store64(ctx + 176, hu + nb);
        return load64(ctx + 56) + hu * 8;
    }
    var su = load64(ctx + 184);
    if (su + nb <= load64(ctx + 72)) {
        store64(ctx + 184, su + nb);
        return load64(ctx + 64) + su * 8;
    }
    return 0;
}
# Step 3 of `_lext_det_zero` for a real A of rank r = ctx.r < n modulo p = ctx.p (`_lext_dz_elim` left
# the pivots in MD and `used`). Returns 1 (det A = 0), 0 (det A != 0), 2 (undecided with this prime:
# n - r >= 2 and S != 0 mod p^k for some k, so rank(A) > r), 4 (no information: its working set did
# not fit: CRT then decides).
# ctx words: 0 n, 1 r, 2 c = n - r, 3 wa, 4 p, 5 R, 6 MD, 7 H, 8 the stack spill area, 9 its words, 10
# tbl, 11 LU (packed u32), 12 dinv (u32), 13 y, 14 x, 15 ip, 16 jp (the other rows and columns), 17 oc
# (pc[t] 8) and 18 cs (column t's shift) for a row's terms, 19 orr (pr[t] n 8) and 20 rs (row t's
# shift) for a column's, 21 rp (the lifted integers' addresses: res rows, then sig rows), 22 / 23
# the words taken from H / the spill area, 24 the form's row and column bounds (u16; 0 past blim),
# 25 Hadamard's bound on |det A|, 26 fo[2].
fn _lext_dz_dixon(ctx, used) {
    var n = load64(ctx);
    var r = load64(ctx + 8);
    var wa = load64(ctx + 24);
    var p = load64(ctx + 32);
    var R = load64(ctx + 40);
    var MD = load64(ctx + 48);
    var H = load64(ctx + 56);
    var pr = MD + 4 * n;
    var pc = MD + 6 * n;
    var c = n - r;
    var bd = load64(ctx + 192);
    if (n > 2 * load64(ctx + 72)) { return 4; }   # (`_lext_dz_pk`'s 4 n bytes must fit the spill area)
    store64(ctx + 16, c);
    store64(ctx + 176, 0);
    store64(ctx + 184, 0);
    var hmx = 0;
    if (bd != 0) {
        for (var i0 = 0; i0 < n; i0 = i0 + 1) {
            if (load8(used + i0) == 0 && load16(bd + i0 * 2) > hmx) { hmx = load16(bd + i0 * 2); }
        }
    }
    # the working set, LU first: H's start, where `_lext_dz_pk` packs B's LU before the rest is written
    var LU = _lext_dz_take(ctx, (r * r + 1) / 2);
    var dinv = _lext_dz_take(ctx, (r + 1) / 2);
    var y = _lext_dz_take(ctx, r);
    var x = _lext_dz_take(ctx, r);
    var ip = _lext_dz_take(ctx, c);
    var jp = _lext_dz_take(ctx, c);
    var oc = _lext_dz_take(ctx, r);
    var cs = _lext_dz_take(ctx, r);
    var orr = _lext_dz_take(ctx, r);
    var rs = _lext_dz_take(ctx, r);
    var rp = _lext_dz_take(ctx, n);
    if (LU == 0 || dinv == 0 || y == 0 || x == 0 || ip == 0 || jp == 0 || oc == 0 || cs == 0 || orr == 0
      || rs == 0 || rp == 0) {
        return 4;
    }
    _lext_dz_pk(H, n, r, pr, pc, used, load64(ctx + 64));
    for (var d0 = 0; d0 < r; d0 = d0 + 1) { store32(dinv + d0 * 4, load32(LU + (d0 * r + d0) * 4)); }
    store64(ctx + 88, LU);
    store64(ctx + 96, dinv);
    store64(ctx + 104, y);
    store64(ctx + 112, x);
    store64(ctx + 120, ip);
    store64(ctx + 128, jp);
    store64(ctx + 136, oc);
    store64(ctx + 144, cs);
    store64(ctx + 152, orr);
    store64(ctx + 160, rs);
    store64(ctx + 168, rp);
    for (var t = 0; t < r; t = t + 1) {
        var pt = load16(pr + t * 2);
        var qt = load16(pc + t * 2);
        store64(oc + t * 8, qt * 8);
        store64(cs + t * 8, _lext_dz_cs(MD, n, qt));
        store64(orr + t * 8, pt * n * 8);
        store64(rs + t * 8, _lext_dz_rs(MD, pt));
    }
    var a1 = 0;
    for (var i = 0; i < n; i = i + 1) {
        if (load8(used + i) == 0) {
            store64(ip + a1 * 8, i);
            a1 = a1 + 1;
        }
    }
    var b1 = 0;
    for (var j = 0; j < n; j = j + 1) { store8(used + j, 0); }   # (used: now the pivot columns)
    for (var t2 = 0; t2 < r; t2 = t2 + 1) { store8(used + load16(pc + t2 * 2), 1); }
    for (var j2 = 0; j2 < n; j2 = j2 + 1) {
        if (load8(used + j2) == 0) {
            store64(jp + b1 * 8, j2);
            b1 = b1 + 1;
        }
    }
    # One column of S suffices. It makes det A = +-det B det S 0 mod p^k, so det A = 0 once p^k passes
    # |det A|: h1 = Hadamard's bound. And S's column b is (det A[pr + a, pc + b]) / det B over the other
    # rows a, so at a low rank h1 may be less: those minors' bound, the lesser of their rows' (the pivot
    # rows and the largest other one) and their columns' (the pivot columns and b). p^k past that with
    # S[., b] = 0 mod p^k makes every such minor 0, so column b of A lies in the span of the pivot
    # columns: det A = 0 again.
    var b0 = load64(jp);
    var h1 = load64(ctx + 200);
    if (bd != 0) {
        var h1r = hmx;
        var h1c = load16(bd + (n + b0) * 2);
        for (var t1 = 0; t1 < r; t1 = t1 + 1) {
            h1r = h1r + load16(bd + load16(pr + t1 * 2) * 2);
            h1c = h1c + load16(bd + (n + load16(pc + t1 * 2)) * 2);
        }
        h1 = h1r;   # (each bound being at least 1, these are at most the totals Hadamard's bound took)
        if (h1c < h1) { h1 = h1c; }
    }
    var hu0 = load64(ctx + 176);
    var su0 = load64(ctx + 184);
    for (var q = 0; q < n; q = q + 1) {
        var rw = _lext_dz_take(ctx, wa);
        if (rw == 0) { return 4; }
        store64(rp + q * 8, rw);
    }
    # the probe: an integer combination of rows (B^T) ends exactly within a few digits
    var pr1 = _lext_dz_lift(ctx, 1, load64(ip), 3);
    if (pr1 != 3) { return pr1; }
    # entries that spread widely, and the bound now matters: a scaling (its scratch the lifted integers',
    # which each lifting writes afresh)
    if (load64(ctx + 208) == 1) {
        store64(ctx + 176, hu0);
        store64(ctx + 184, su0);
        var ce = _lext_dz_take(ctx, (n * n + 3) / 4);
        var ws = _lext_dz_take(ctx, 9 * n);
        if (ce != 0 && ws != 0) {
            store64(ctx + 200, _lext_dz_scale(R, 0, n, MD, ce, ws, load64(ctx + 200)));
            if (load64(ctx + 200) < h1) { h1 = load64(ctx + 200); }
        }
    }
    # p^k > 2^(h1 + 2): p > 2^25 always; p >= 2^26 - 2^17 gives lg p > 26 + lg(1 - 2^-9) > 25.99
    var k = (h1 + 2 + 24) / 25;
    if (p >= 67108864 - 131072) { k = (100 * (h1 + 2) + 2598) / 2599; }
    # S's column b0, to the bound (it ends at once if column b0 is an integer combination of the others)
    var lr = _lext_dz_lift(ctx, 0, b0, k);
    if (lr != 3) { return lr; }
    return 1;   # S's column b0 is 0 mod p^k, p^k past |det A| or every minor that makes it up
}
# B = A[pr, pc] = L U modulo p is what `_lext_dz_elim` left in H: row pr[i] holds L's multipliers and
# U's entries at the columns pc[j], with the pivot's inverse at pc[i] (L has a unit diagonal, so B's LU
# without pivoting is exactly these). H's start becomes the r x r LU, row-major and packed u32, with no
# word of scratch but ws (4 n bytes, u16): each row is packed at its own start, the rows are slid down
# in H's order, and they are swapped into pivot order. Only H's first r^2 u32 are then in use.
fn _lext_dz_pk(H, n, r, pr, pc, used, ws) {
    for (var t = 0; t < r; t = t + 1) {
        var b = H + load16(pr + t * 2) * n * 8;
        for (var j = 0; j < r; j = j + 1) { store32(b + j * 4, load64(b + load16(pc + j * 2) * 8)); }
    }
    var at = ws + n * 2;
    var k = 0;
    for (var i = 0; i < n; i = i + 1) {
        if (load8(used + i) == 1) {
            var src = H + i * n * 8;
            var dst = H + k * r * 4;
            for (var j2 = 0; j2 < r; j2 = j2 + 1) { store32(dst + j2 * 4, load32(src + j2 * 4)); }
            store16(ws + i * 2, k);
            k = k + 1;
        }
    }
    for (var t2 = 0; t2 < r; t2 = t2 + 1) { store16(at + load16(ws + load16(pr + t2 * 2) * 2) * 2, t2); }
    for (var s = 0; s < r; s = s + 1) {
        var d = load16(at + s * 2);
        while (d != s) {
            var a = H + s * r * 4;
            var b2 = H + d * r * 4;
            for (var j3 = 0; j3 < r; j3 = j3 + 1) {
                var v = load32(a + j3 * 4);
                store32(a + j3 * 4, load32(b2 + j3 * 4));
                store32(b2 + j3 * 4, v);
            }
            store16(at + s * 2, load16(at + d * 2));
            store16(at + d * 2, d);
            d = load16(at + s * 2);
        }
    }
    return 0;
}
# One column (tr = 0: A's column jb of the non-pivot ones) or row (tr = 1: A's row jb) of S, lifted
# up to kmax p-adic digits. Returns 3 (every digit 0: no conclusion yet), 1 (the lifting ended
# exactly with that part of S = 0: det A = 0), 0 (a part of S that is not 0, with n - r = 1: det A
# != 0), 2 (one that is not 0, n - r >= 2).
fn _lext_dz_lift(ctx, tr, jb, kmax) {
    var n = load64(ctx);
    var r = load64(ctx + 8);
    var c = load64(ctx + 16);
    var wa = load64(ctx + 24);
    var p = load64(ctx + 32);
    var R = load64(ctx + 40);
    var MD = load64(ctx + 48);
    var y = load64(ctx + 104);
    var x = load64(ctx + 112);
    var ip = load64(ctx + 120);
    var jp = load64(ctx + 128);
    var oc = load64(ctx + 136);
    var cs = load64(ctx + 144);
    var orr = load64(ctx + 152);
    var rs = load64(ctx + 160);
    var rp = load64(ctx + 168);
    var oa = oc;   # the terms of a row of B (tr = 0) run over the pivot columns; of B^T over the pivot rows
    var os = cs;
    if (tr == 1) {
        oa = orr;
        os = rs;
    }
    var nz = 2;
    if (c == 1) { nz = 0; }
    # the fixed index's base address and shift for each res row (u < r) and sig row (r + a)
    for (var u = 0; u < r; u = u + 1) {
        if (tr == 0) {
            _lext_dz_ld(load64(rp + u * 8), wa, load64(R + load64(orr + u * 8) + jb * 8),
              load64(rs + u * 8) + _lext_dz_cs(MD, n, jb));
        } else {
            _lext_dz_ld(load64(rp + u * 8), wa, load64(R + jb * n * 8 + load64(oc + u * 8)),
              _lext_dz_rs(MD, jb) + load64(cs + u * 8));
        }
    }
    for (var a = 0; a < c; a = a + 1) {
        var ia = load64(ip + a * 8);
        var ja = load64(jp + a * 8);
        if (tr == 0) {
            _lext_dz_ld(load64(rp + (r + a) * 8), wa, load64(R + (ia * n + jb) * 8),
              _lext_dz_rs(MD, ia) + _lext_dz_cs(MD, n, jb));
        } else {
            _lext_dz_ld(load64(rp + (r + a) * 8), wa, load64(R + (jb * n + ja) * 8),
              _lext_dz_rs(MD, jb) + _lext_dz_cs(MD, n, ja));
        }
    }
    for (var step = 0; step < kmax; step = step + 1) {
        store64(&_lext_dz_stat + 8, load64(&_lext_dz_stat + 8) + 1);
        for (var u2 = 0; u2 < r; u2 = u2 + 1) { store64(y + u2 * 8, _lext_dz_divp_mod(load64(rp + u2 * 8), wa, p)); }
        _lext_dz_solve(load64(ctx + 88), load64(ctx + 96), r, p, tr, y, x);
        var allz = 1;
        for (var u3 = 0; u3 < r; u3 = u3 + 1) {
            var rv = load64(rp + u3 * 8);
            # B's row u3 (tr = 0: A's row pr[u3]) or column u3 (tr = 1: A's column pc[u3])
            if (tr == 0) {
                _lext_dz_mac(rv, R + load64(orr + u3 * 8), oa, os, load64(rs + u3 * 8), x, r, wa);
            } else {
                _lext_dz_mac(rv, R + load64(oc + u3 * 8), oa, os, load64(cs + u3 * 8), x, r, wa);
            }
            if (_lext_dz_divp(rv, wa, p) != 0) { return 2; }   # never: B x = res (mod p)
            if (allz == 1 && _lext_dz_iszero(rv, wa) == 0) { allz = 0; }
        }
        var sz = 1;
        for (var a3 = 0; a3 < c; a3 = a3 + 1) {
            var sv = load64(rp + (r + a3) * 8);
            if (tr == 0) {
                var i3 = load64(ip + a3 * 8);
                _lext_dz_mac(sv, R + i3 * n * 8, oa, os, _lext_dz_rs(MD, i3), x, r, wa);
            } else {
                var j3 = load64(jp + a3 * 8);
                _lext_dz_mac(sv, R + j3 * 8, oa, os, _lext_dz_cs(MD, n, j3), x, r, wa);
            }
            if (_lext_dz_divp(sv, wa, p) != 0) { return nz; }   # a digit of S that is not 0
            if (sz == 1 && _lext_dz_iszero(sv, wa) == 0) { sz = 0; }
        }
        if (allz == 1) {
            # the lifting ended: that column (row) of S is exactly p^(step + 1) sig
            if (sz == 1) { return 1; }
            return nz;
        }
    }
    return 3;
}
# v mod p (v left as it was, normalised).
fn _lext_dz_divp_mod(v, wa, p) {
    _lext_dz_norm(v, wa);
    var rem = load64(v + (wa - 1) * 8) % p;
    if (rem < 0) { rem = rem + p; }
    var k = wa - 2;
    while (k >= 0) {
        rem = (rem * 0x100_0000 + load64(v + k * 8)) % p;
        k = k - 1;
    }
    return rem;
}
fn _lext_dz_norm(v, wa) {
    var cy = 0;
    for (var k = 0; k < wa - 1; k = k + 1) {
        var t = load64(v + k * 8) + cy;
        var lo = t & 0xFF_FFFF;
        cy = (t - lo) / 0x100_0000;
        store64(v + k * 8, lo);
    }
    store64(v + (wa - 1) * 8, load64(v + (wa - 1) * 8) + cy);
    return 0;
}

# Gauss-Jordan inverse of R + i I (n x n row-major, I = 0 for a real matrix; both overwritten),
# into XR + i XI (n x n row-major). Each row is first scaled by 2^sc[r], the power of two that puts
# its largest |part| in [1/2, 1) (sc: n words, written here); partial pivoting by modulus. That is a
# row operation, so A^-1's column j is the computed column j times 2^sc[j]: with apply = 1 that is
# done here, once per entry, with the code 2 for an entry that then passes DBL_MAX; with apply = 0 X is
# left in the scaled frame for the caller. Returns 0, or 1 when a pivot column is exactly 0 (lost
# to rounding: a singular A, or an invertible one with cond(A) past about 1/u), or -1.
fn _lext_gj_inv(R, I, n, XR, XI, sc, apply) {
    for (var r = 0; r < n; r = r + 1) {
        var mx = f64_from(0);
        for (var c = 0; c < n; c = c + 1) {
            var ar = f64_abs(load64(R + (r * n + c) * 8));
            if (f64_gt(ar, mx) == 1) { mx = ar; }
            if (I != 0) {
                var ai = f64_abs(load64(I + (r * n + c) * 8));
                if (f64_gt(ai, mx) == 1) { mx = ai; }
            }
        }
        var k = 0;
        if ((mx & 0x7FFF_FFFF_FFFF_FFFF) != 0) { k = 0 - _lext_xexp(mx); }
        store64(sc + r * 8, k);   # (a zero row only reaches here from a caller that did not ask)
        for (var c1 = 0; c1 < n; c1 = c1 + 1) {
            store64(R + (r * n + c1) * 8, _lext_pow2mul(load64(R + (r * n + c1) * 8), k));
            if (I != 0) { store64(I + (r * n + c1) * 8, _lext_pow2mul(load64(I + (r * n + c1) * 8), k)); }
            store64(XR + (r * n + c1) * 8, f64_from(0));
            if (I != 0) { store64(XI + (r * n + c1) * 8, f64_from(0)); }
        }
        store64(XR + (r * n + r) * 8, F64_ONE);
    }
    for (var col = 0; col < n; col = col + 1) {
        var best = f64_from(0);
        var pr = col;
        for (var i = col; i < n; i = i + 1) {
            var md = f64_abs(load64(R + (i * n + col) * 8));
            if (I != 0) { md = ganita_f64_hypot(md, load64(I + (i * n + col) * 8)); }
            if (f64_gt(md, best) == 1) {
                best = md;
                pr = i;
            }
        }
        if ((best & 0x7FFF_FFFF_FFFF_FFFF) == 0) { return 1; }
        if (pr != col) {
            for (var k2 = 0; k2 < n; k2 = k2 + 1) {
                var o1 = (col * n + k2) * 8;
                var o2 = (pr * n + k2) * 8;
                var t1 = load64(R + o1); store64(R + o1, load64(R + o2)); store64(R + o2, t1);
                var t2 = load64(XR + o1); store64(XR + o1, load64(XR + o2)); store64(XR + o2, t2);
                if (I != 0) {
                    var t3 = load64(I + o1); store64(I + o1, load64(I + o2)); store64(I + o2, t3);
                    var t4 = load64(XI + o1); store64(XI + o1, load64(XI + o2)); store64(XI + o2, t4);
                }
            }
        }
        # 1 / pivot: real 1 / pr when the pivot is real; otherwise conj(z) / |z|^2 with z scaled
        # by the power of two that puts its larger part in [1, 2) (no square can overflow or
        # underflow), and the scale applied back once
        var pvr = load64(R + (col * n + col) * 8);
        var ivr = f64_div(F64_ONE, pvr);
        var ivi = f64_from(0);
        if (I != 0) {
            var pvi = load64(I + (col * n + col) * 8);
            if ((pvi & 0x7FFF_FFFF_FFFF_FFFF) != 0) {
                var pk = 1 - _lext_xexp(best);
                var zr = _lext_pow2mul(pvr, pk);
                var zi = _lext_pow2mul(pvi, pk);
                var d = f64_add(f64_mul(zr, zr), f64_mul(zi, zi));
                ivr = _lext_pow2mul(f64_div(zr, d), pk);
                ivi = _lext_pow2mul(f64_div(f64_neg(zi), d), pk);
            }
        }
        for (var k3 = 0; k3 < n; k3 = k3 + 1) {
            var o3 = (col * n + k3) * 8;
            var ar3 = load64(R + o3);
            var xr3 = load64(XR + o3);
            if (I == 0) {
                store64(R + o3, f64_mul(ar3, ivr));
                store64(XR + o3, f64_mul(xr3, ivr));
            } else {
                var ai3 = load64(I + o3);
                var xi3 = load64(XI + o3);
                store64(R + o3, f64_sub(f64_mul(ar3, ivr), f64_mul(ai3, ivi)));
                store64(I + o3, f64_add(f64_mul(ar3, ivi), f64_mul(ai3, ivr)));
                store64(XR + o3, f64_sub(f64_mul(xr3, ivr), f64_mul(xi3, ivi)));
                store64(XI + o3, f64_add(f64_mul(xr3, ivi), f64_mul(xi3, ivr)));
            }
        }
        for (var i2 = 0; i2 < n; i2 = i2 + 1) {
            if (i2 != col) {
                var fr = load64(R + (i2 * n + col) * 8);
                var fi = f64_from(0);
                if (I != 0) { fi = load64(I + (i2 * n + col) * 8); }
                if ((fr & 0x7FFF_FFFF_FFFF_FFFF) != 0 || (fi & 0x7FFF_FFFF_FFFF_FFFF) != 0) {
                    for (var k4 = 0; k4 < n; k4 = k4 + 1) {
                        var oa = (i2 * n + k4) * 8;
                        var ob = (col * n + k4) * 8;
                        if (I == 0) {
                            store64(R + oa, f64_sub(load64(R + oa), f64_mul(fr, load64(R + ob))));
                            store64(XR + oa, f64_sub(load64(XR + oa), f64_mul(fr, load64(XR + ob))));
                        } else {
                            var br = load64(R + ob);
                            var bi = load64(I + ob);
                            store64(R + oa, f64_sub(load64(R + oa), f64_sub(f64_mul(fr, br), f64_mul(fi, bi))));
                            store64(I + oa, f64_sub(load64(I + oa), f64_add(f64_mul(fr, bi), f64_mul(fi, br))));
                            var yr = load64(XR + ob);
                            var yi = load64(XI + ob);
                            store64(XR + oa, f64_sub(load64(XR + oa), f64_sub(f64_mul(fr, yr), f64_mul(fi, yi))));
                            store64(XI + oa, f64_sub(load64(XI + oa), f64_add(f64_mul(fr, yi), f64_mul(fi, yr))));
                        }
                    }
                }
            }
        }
    }
    # (D A)^-1 = A^-1 D^-1 for the row scaling D, so A^-1's column j is the computed column j
    # times D's j-th factor (the swaps act on the inverse's rows only: E [D A | I] = [I | (D A)^-1])
    if (apply == 0) { return 0; }
    for (var r5 = 0; r5 < n; r5 = r5 + 1) {
        for (var c5 = 0; c5 < n; c5 = c5 + 1) {
            var o5 = (r5 * n + c5) * 8;
            var x5 = _lext_pow2mul(load64(XR + o5), load64(sc + c5 * 8));
            store64(XR + o5, x5);
            if (f64_lt(f64_abs(x5), F64_POS_INF) == 0) { return 2; }
            if (I != 0) {
                var y5 = _lext_pow2mul(load64(XI + o5), load64(sc + c5 * 8));
                store64(XI + o5, y5);
                if (f64_lt(f64_abs(y5), F64_POS_INF) == 0) { return 2; }
            }
        }
    }
    return 0;
}

# Frobenius norm of the n x n row-major X with column c scaled by 2^cs[c] (cs = 0: unscaled), as
# m 2^e, 0.5 <= m < 1 or m = 0: out[0] = m, out[1] = e. Each column's sum of squares is formed
# with that column's largest |entry| scaled to [1, 2) (none can overflow or flush a term that
# matters), the columns then added at the largest exponent. ws: 2 n words of the caller's scratch.
fn _lext_frob_wide(X, n, cs, out, ws) {
    var cm = ws;
    var ce = ws + n * 8;
    var emax = 0 - 100000;
    for (var c = 0; c < n; c = c + 1) {
        var mx = f64_from(0);
        for (var r = 0; r < n; r = r + 1) {
            var a = f64_abs(load64(X + (r * n + c) * 8));
            if (f64_gt(a, mx) == 1) { mx = a; }
        }
        store64(cm + c * 8, f64_from(0));
        store64(ce + c * 8, 0);
        if ((mx & 0x7FFF_FFFF_FFFF_FFFF) != 0) {
            var k = 1 - _lext_xexp(mx);
            var ss = f64_from(0);
            for (var r2 = 0; r2 < n; r2 = r2 + 1) {
                var y = _lext_pow2mul(load64(X + (r2 * n + c) * 8), k);
                ss = f64_add(ss, f64_mul(y, y));
            }
            # column norm^2 = ss 2^(2 (cs[c] - k)) = m 2^e
            var e = _lext_xexp(ss) + 2 * (0 - k);
            if (cs != 0) { e = e + 2 * load64(cs + c * 8); }
            store64(cm + c * 8, _lext_xman(ss));
            store64(ce + c * 8, e);
            if (e > emax) { emax = e; }
        }
    }
    if (emax == 0 - 100000) {
        store64(out, f64_from(0));
        store64(out + 8, 0);
        return 0;
    }
    if ((emax & 1) == 1) { emax = emax + 1; }   # even, so the square root halves it exactly
    var tot = f64_from(0);
    for (var c2 = 0; c2 < n; c2 = c2 + 1) {
        var m2 = load64(cm + c2 * 8);
        if ((m2 & 0x7FFF_FFFF_FFFF_FFFF) != 0) {
            tot = f64_add(tot, _lext_xld(m2, load64(ce + c2 * 8) - emax));
        }
    }
    var rt = f64_sqrt(tot);
    store64(out, _lext_xman(rt));
    store64(out + 8, _lext_xexp(rt) + emax / 2);
    return 0;
}

# Condition number of a square matrix in the Frobenius norm: cond(A) = ||A||_F ||A^-1||_F.
# Returns it as an f64 (+Inf when it is past DBL_MAX), or -1 for a null A, a non-square A, a NaN
# or infinite entry, or a singular A (3.4.1: decided exactly), and -1 too when the elimination loses
# a pivot of an invertible A to rounding (cond(A) past about 1/u = 2^53; see `_lext_gj_inv`).
# The inverse is Gauss-Jordan with partial pivoting on A with its rows scaled by powers of two, so
# the result is accurate to about n cond(A) u relative (u = 2^-53): to 1e-3 or better while
# cond(A) < 1e12, its magnitude only near 1/u. The answer is the same for A and 2^k A.
# ⛔ 3.4.1 — "SINGULAR" WAS GANITA'S LU PIVOT TEST (relative 1e-12), and the norms were taken in the
# caller's units: diag(1e-13, 1) gave -1 (exact 1e13), Hilbert 11 and 12 gave -1 (5.33e14 and
# 1.72e16), and [[3FF3C0CA4587E6B7, BFE5F1A2B3C4D5E7], [3FE9D8C7B6A59483, 4001234567890ABD]] 2^-1030
# gave +Inf (exact 40021902856E217C, 2.26). Singular is now exact (`_lext_det_zero`), the inverse
# hisab's own (`_lext_gj_inv`), and both norms formed scaled (`_lext_frob_wide`).
# [measured: LA probe rep1 and cond sweep, 3.4.0 base and this tree, Fraction oracle, cycc 6.7.18, 2026-10-31]
# COST (3.4.1 LA3 figures, 3.4.0's in brackets, each at n = 10 / 30 / 60 / 100, us). An invertible A pays
# one elimination modulo a 26-bit prime before its inverse: 24 / 352 / 2,365 / 10,134 (16 / 329 / 2,494 /
# 11,245). A singular one is proved singular (`_lext_det_zero`), not guessed by a pivot test: a
# duplicated row 14 / 104 / 506 / 1,776 (9 / 183 / 1,363 / 6,085); exact rank 1 16 / 80 / 274 / 708 (4 /
# 26 / 105 / 282); rank n / 2 19 / 194 / 1,180 / 4,829 (8 / 156 / 1,177 / 5,263); rank n - 1 with no small
# integer dependency (a Gram matrix X^T X) 30 / 441 / 3,330 / 15,654 (8 / 169 / 1,297 / 5,877), an
# integer U V with entries to +-1000 45 / 791 / 6,243 / 28,597 (9 / 183 / 1,365 / 6,096); row n - 1 =
# (row 0 + row 1) / 2 13 / 105 / 532 / 1,839 (9 / 180 / 1,352 / 6,079); rank n - 1 but n - 2 modulo all
# four tabled primes 39 / 278 / - / 5,768 (9 / 179 / - / 6,060); a duplicated row with columns scaled
# 2^1000 and 2^-1000 13 / 108 / 498 / 1,781 (5 / 36 / 144 / 387); per-entry exponents across 2^+-1000
# with a duplicated row 25 / 148 / 604 / 1,940 (3 / 53 / 384 / 227). Among these the largest ratio is
# that last family's, 8.6 times (n = 10 and n = 100), and the rank n - 1 families with small entries are
# at most 5.3 times. The earlier 3.4.1 forms took 9 to 15 times 3.4.0's time on the rank n - 1 families
# (their bound charged 54 bits an entry) and 20 to 40 times on the unlucky one (CRT after the four tabled
# primes). The exact test keeps no copy of A's integers (its heap is 3.4.0's), so each lifted digit
# decodes A's doubles.
# [measured: LA3 probe cost3.py (R2-LA generators); 3.4.0, 3.4.1-dev, this tree; medians of 3, load 3, 2026-11-01]
# A rank n - 1 matrix with no small integer dependency costs by its entries' true bit length, the bound
# being about n of them: X^T X with |x| to 2^4 / 2^12 / 2^24 is 3.8 / 6.3 / 10.1 times 3.4.0 at n = 10 and
# 3.0 / 5.4 / 10.1 at n = 30; entries of about 50 bits are 8 to 10 times at n = 10 to 60 (U V and X^T X,
# medians over two runs), 10.7 at worst on one instance.
# [measured: LA4 probes c2.py, c5.py (R3-LA's), 3.4.0, 3.4.1-dev, this tree interleaved, load 3 to 7, 2026-11-01]
# PAST 10 TIMES, BY CLASS: a singular matrix on which 3.4.0's LU stopped at its first pivot. A singular
# block under a block of wide entries is proved singular here, by one elimination (1.8 ms at n = 100, 16
# times 3.4.0's 0.11 ms before any digit) and a lifting. [[B, C], [0, D]], B of rank n / 2 - 1, at n = 10 /
# 30 / 60 / 100 in us (3.4.0): C at 2^60 27 / 267 / 1,542 / 5,965 (2 / 11 / 40 / 112), 11 to 53 times; C at
# 2^1000 61 / 476 / 2,335 / 8,059 (3 / 20 / 72 / 201), 22 to 40 times; that with B and D at 2^-1000 96 / 692 /
# 3,146 / 10,243 (3 / 21 / 76 / 209), 29 to 49 times. A chain of 5 x 5 blocks, one singular, under blocks
# at 2^1000: 70 / 462 / 1,842 / 5,496 (2 / 18 / 67 / 184), 26 to 30 times. Across those and the other
# sizes tried (2^200, chains at 2^60 and 2^+-1000) the range is 11 to 56 times, 56 at n = 100; with rows
# and columns permuted 11 to 25 times, transposed 2.3 to 6.5. Before `_lext_dz_scale` the same families
# were 18 to 7,700 times, 1.4 s at n = 100.
# [measured: LA4 probe w4.py (R3-LA's Kwide), 3.4.0, 3.4.1-dev, this tree, x3, 4 instances, load 4 to 7, 2026-11-01]
# MEMORY (3.4.1 LA3). A call allocates n^2 + n + 2 words for a singular A (`_lext_dz_run`'s H and MD)
# and 2 n^2 + n + 2 for an invertible one (H then holds the copy of A the inverse is formed on, MD the
# row scales, and X the inverse): 3.4.0's n^2 + n + 2 and 2 n^2 + 3 n + 4 or less at every n, with a
# 64 KB stack buffer beside them. Nothing is kept between calls.
# [measured: LA3 probe hd (alloc_used() around each call, n = 3, 10, 30, 100), 3.4.0 and this tree, 2026-11-01]
# ⛔ 3.4.1 (first form) — the singular case took det modulo enough primes to pass Hadamard's bound,
# n^3 / 3 reductions each: a singular 100 x 100 took 1.0 s, 34 s with two columns scaled 2^+-1000.
# [measured: LA2 probe dzcost.py, 3.4.0, 3.4.1-dev and this tree interleaved x3, medians, 2026-10-31]
# Since 3.4.0 a null A is -1, not a read through the designed 0 of mat_new_guarded (exit 139;
# D102 audit, AU2-G3-F2).
# [measured: D102 audit AU2 G3-F2 repro, re-run on 3.3.7 base (LA probe pd_1), cycc 6.7.9, 2026-10-31]
public fn matrix_condition_number(A) {
    var neg1 = f64_neg(F64_ONE);
    if (A == 0) { return neg1; }
    var n = ganita_mat_rows(A);
    if (n <= 0 || ganita_mat_cols(A) != n) { return neg1; }
    if (_lext_mat_all_finite(A, n, n) == 0) { return neg1; }
    if (n > (ALLOC_MAX / 8) / n) { return neg1; }
    # 3.4.1 LA3: one n^2 block (H) and n + 2 words (MD), this call's own; the exact test reads A's
    # entries in place (its row-major data, as `_lp_mat_max_abs` reads them)
    var H = alloc(n * n * 8);
    var MD = alloc(n * 8 + 16);
    if (H == 0 || MD == 0) { return neg1; }
    var dz = _lext_dz_run(A + 16, 0, n, H, MD, _LEXT_DZ_KEEP);
    if (dz != 0) { return neg1; }   # singular (1), or its scratch refused (-1)
    # invertible: H becomes R, a copy of A the elimination works on, X the inverse, MD the row scales
    var R = H;
    for (var q = 0; q < n * n; q = q + 1) { store64(R + q * 8, load64(A + 16 + q * 8)); }
    var X = alloc(n * n * 8);
    if (X == 0) { return neg1; }
    var sc = MD;
    var w1: i64[2];   # the norms' 2 n words of scratch for n = 1 (X and R otherwise)
    var ws1 = X;
    var ws2 = R;
    if (n < 2) {
        ws1 = &w1;
        ws2 = &w1;
    }
    var na: i64[2];
    _lext_frob_wide(R, n, 0, &na, ws1);   # (X as scratch: it is written below)
    # A^-1 is left in the row-scaled frame and its norm formed wide, so no entry of it past
    # DBL_MAX can overflow a condition number that is not
    if (_lext_gj_inv(R, 0, n, X, 0, sc, 0) != 0) { return neg1; }
    var ni: i64[2];
    _lext_frob_wide(X, n, sc, &ni, ws2);   # (R as scratch: the elimination has spent it)
    var pm = f64_mul(load64(&na), load64(&ni));
    return _lext_xld(_lext_xman(pm), _lext_xexp(pm) + load64(&na + 8) + load64(&ni + 8));
}

# ================================================================
# 8. COMPLEX MATRIX INVERSE
# ================================================================

# Inverse of a square complex matrix, as a fresh n x n cmat (3.4.1: from `_lext_gj_inv`, Gauss-
# Jordan with partial pivoting on m with its rows scaled by powers of two, so accurate to about
# n cond(m) u normwise, u = 2^-53, and carrying no correct digit once cond(m) passes about 1/(n u)).
# Returns 0 for a null or non-square m, a NaN or infinite part (3.4.1: diag(+Inf, 1) answered
# diag(0, 1)), a singular m (decided exactly, `_lext_det_zero`), an inverse with an entry past
# DBL_MAX, an elimination that loses a pivot of an invertible m to rounding (cond(m) past about
# 1/u), or a temporary that cannot be allocated (cmat_new's cap on the 3.4.0 augmented [m | I]
# kept: n above 181).
# ⛔ 3.4.1 — "SINGULAR" WAS A PIVOT BELOW 1e-12 OF THE ACTIVE BLOCK'S LARGEST ENTRY, or below
# DBL_MIN: diag(1e-13, 1) came back 0 (exact diag(1e13, 1)), and so did [000C000000000000] (exact
# 7FD5555555555555), while complex Hilbert 11 and 12 (cond 5e14, 1.7e16) were answered. Every
# element and every product also went through a fresh HComplex (four heap temporaries per term,
# none checked: a refused one was read through). Singular is now exact, the elimination runs on
# two flat f64 arrays, and m's elements are read, and the result's written, in place (3.4.1 LA3: no
# HComplex at all).
# [measured: LA probe rep1 and cinv sweep, 3.4.0 base and this tree, Fraction oracle, cycc 6.7.18, 2026-10-31]
# COST. Singular is decided by determinants modulo 26-bit primes (`_lext_det_zero`, step 4), as many as
# Hadamard's bound on |det|^2 needs: a singular m (a duplicated row) costs n = 10 / 30 / 60: 0.45 / 9.4 /
# 100 ms (3.4.0, which inverted these with wrong finite entries: 0.23 / 6.2 / 49 ms), and with columns
# scaled 2^+-1000 2.2 / 22 / 163 ms (9.5 times 3.4.0 at n = 10). An invertible one is 0.04 / 0.72 / 5.0 ms
# (3.4.0: 0.23 / 6.2 / 49). A singular block under a block of wide entries, where 3.4.0's elimination
# stopped at its first pivot (0.01 to 0.1 ms), is the class past 10 times: at n = 10 / 20 / 30, 0.041 /
# 0.30 / 0.96 ms, 3.4 to 12 times 3.4.0 (C at 2^60, 2^1000, 2^+-1000; before `_lext_dz_scale` 24 to 1,130
# times, 0.12 s at n = 30).
# MEMORY (3.4.1 LA3): each call's own scratch (four n^2 copies, the exact test's n^2 + n + 2 words, and
# n row scales) besides the result; nothing is kept between calls.
# [measured: LA3 probe cost3.py (R2-LA's C0 / C1 / C2), 3.4.0 base and this tree, medians of 3, load 3, 2026-11-01]
# [measured: LA4 probe ck.py (R3-LA's), 3.4.0, 3.4.1-dev, this tree interleaved x2, 2 instances, load 5, 2026-11-01]
public fn cmat_inverse(m) {
    if (m == 0) { return 0; }
    var n = cmat_rows(m);
    if (n <= 0 || n != cmat_cols(m)) { return 0; }
    # [measured: CHANGELOG.md 2.6.14, the capped-constructor entry (cmat_inverse, 250x500 augmented over the cap)]
    # 2.6.14 refused an n whose augmented [m | I] passed cmat_new's cap; that bound is kept, so
    # no n inverts here that did not before.
    if (n > 65536 / (2 * n)) { return 0; }
    # this call's own scratch (3.4.1 LA3: nothing kept between calls), and m's elements read in place
    # through cmat's documented layout ({ rows, cols, data }, each element (re, im): complex.cyr),
    # not through cmat_get, which allocates an HComplex for every read
    var R = alloc(n * n * 8);
    var I = alloc(n * n * 8);
    var XR = alloc(n * n * 8);
    var XI = alloc(n * n * 8);
    var sc = alloc(n * 8);
    if (R == 0 || I == 0 || XR == 0 || XI == 0 || sc == 0) { return 0; }
    var md = load64(m + 16);
    for (var q = 0; q < n * n; q = q + 1) {
        var zr = load64(md + q * 16);
        var zi = load64(md + q * 16 + 8);
        if (f64_lt(f64_abs(zr), F64_POS_INF) == 0 || f64_lt(f64_abs(zi), F64_POS_INF) == 0) { return 0; }
        store64(R + q * 8, zr);
        store64(I + q * 8, zi);
    }
    if (_lext_det_zero(R, I, n) != 0) { return 0; }
    if (_lext_gj_inv(R, I, n, XR, XI, sc, 1) != 0) { return 0; }
    var result = cmat_new(n, n);
    if (result == 0) { return 0; }
    var rd = load64(result + 16);   # (the same layout: written in place, no HComplex per element)
    for (var q2 = 0; q2 < n * n; q2 = q2 + 1) {
        store64(rd + q2 * 16, load64(XR + q2 * 8));
        store64(rd + q2 * 16 + 8, load64(XI + q2 * 8));
    }
    return result;
}
