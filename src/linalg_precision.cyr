# linalg_precision.cyr -- precision linear algebra algorithms
# Usage: include "lib/linalg_precision.cyr"
# Requires: alloc.cyr, math.cyr, matrix.cyr, linalg.cyr, complex.cyr, error.cyr
#
# Higher-precision replacements for linalg.cyr's SVD and eigendecomposition:
#
#   svd_golub_kahan   -- Golub-Kahan bidiagonalization + implicit QR iteration
#                       (replaces A^T*A eigendecomposition which squares cond #)
#
#   eigen_qr          -- Householder tridiagonalization + implicit symmetric QR
#                       with Wilkinson shift, O(n^3) vs Jacobi's O(n^5)
#
#   cqr_decompose     -- Householder QR for complex matrices
#
# All functions use out-params and return error codes
# (HSB_ERR_NONE / HSB_ERR_NO_CONVERGENCE / HSB_ERR_ALLOC).

# ================================================================
# Internal helpers
# ================================================================

# Compute sign of an f64 value: +1.0 if x >= 0, -1.0 if x < 0
fn _lp_sign(x) {
    if (f64_lt(x, f64_from(0)) == 1) {
        return f64_neg(F64_ONE);
    }
    return F64_ONE;
}

# Compute the 2-norm of a segment of a flat f64 array
# arr: pointer to f64 array, start: starting index, len: number of elements
# ⛔ 2.22.0 — THIS SQUARED BEFORE SUMMING, AND IT IS THE ONE SITE 2.17.0's NORM
# TIER MISSED. That release repaired 39 of 51 `f64_sqrt(sum of squares)` sites so a
# component below 2^-537 could not flush the whole norm to zero; this one serves
# the THREE Householder reflectors in this file and kept the naive form.
# ⚠ It is the FLOOR of the repair below it, not a separate nicety: the reflector
# gates now ask `norm > 0`, so a norm that flushes to zero for a non-zero vector
# would reinstate the exact skip those gates were repaired to stop.
# ⭐ Fast path, not unconditional scaling — same shape as `hvec3_length`: the naive
# sum announces its own failure (subnormal, zero or +Inf exactly when it cannot be
# trusted, exact otherwise), so take it when it is NORMAL and rescale only when it
# is not. ⚠ The trigger is `< F64_TINY`, not `== 0`: a SUBNORMAL sum has already
# lost most of its mantissa, which is the silent third of the class.
# [measured: two-sided binade sweep through svd_golub_kahan and eigen_qr, 2026-09-11]
fn _lp_vec_norm_scaled(arr, start, len) {
    var mx = f64_from(0);
    var i = 0;
    while (i < len) {
        var a = f64_abs(load64(arr + (start + i) * 8));
        if (f64_gt(a, mx) == 1) { mx = a; }
        i = i + 1;
    }
    if (f64_gt(mx, 0) == 0) { return mx; }
    # ⚠ Inf/Inf is NaN, so an infinite component needs its own exit.
    if (f64_eq(mx, F64_POS_INF) == 1) { return mx; }
    var sum = f64_from(0);
    i = 0;
    while (i < len) {
        # ⚠ DIVIDE, never multiply by 1/mx: for a subnormal mx the reciprocal is
        # +Inf and every zero component becomes 0 * Inf = NaN.
        var q = f64_div(load64(arr + (start + i) * 8), mx);
        sum = f64_add(sum, f64_mul(q, q));
        i = i + 1;
    }
    return f64_mul(mx, f64_sqrt(sum));
}

fn _lp_vec_norm(arr, start, len) {
    var sum = f64_from(0);
    var i = 0;
    while (i < len) {
        var v = load64(arr + (start + i) * 8);
        sum = f64_add(sum, f64_mul(v, v));
        i = i + 1;
    }
    if (f64_lt(sum, F64_TINY) == 1) { return _lp_vec_norm_scaled(arr, start, len); }
    if (f64_eq(sum, F64_POS_INF) == 1) { return _lp_vec_norm_scaled(arr, start, len); }
    return f64_sqrt(sum);
}

# Allocate a zero-filled flat f64 array of length n
# Balancing helpers (2.7.0). EVERY step of these decompositions squares matrix
# entries -- the Householder norms in _lp_bidiagonalize/_lp_tridiagonalize, and the
# Wilkinson shifts, which form entries of B^T*B explicitly. |x| > 1.34e154 squares
# to +Inf and |x| < 1.49e-154 squares to 0, so the usable band was only about
# 1 .. 1e23: measured across 440 random matrices, svd_golub_kahan failed 40/40 at
# scale 1e-10 on a relative reconstruction check. Balancing to unit max magnitude
# first also converts the ABSOLUTE EpsilonF64 deflation thresholds into relative
# ones, which is what fixes the small-magnitude half.
#
# NOTE: these _lp_* internals are NOT individually overflow-safe. They are only
# sound when reached through the balanced public entry points below.

# Largest |entry| of a stdlib matrix (0 for the zero matrix).
fn _lp_mat_max_abs(A) {
    var total = ganita_mat_rows(A) * ganita_mat_cols(A);
    var mx = f64_from(0);
    var i = 0;
    while (i < total) {
        var a = f64_abs(load64(A + 16 + i * 8));
        if (f64_gt(a, mx) == 1) { mx = a; }
        i = i + 1;
    }
    return mx;
}

# Round a positive scale DOWN to a power of two. Dividing and re-multiplying by
# 2^e is EXACT, so balancing costs zero rounding and unit-scale results stay
# bit-identical to what shipped before this change.
# ⛔ 2.18.0 — THE `e == 0` ARM RETURNED 1.0, WHICH MEANS "DO NOT BALANCE", AND
# THE EXPONENT FIELD IS ZERO FOR EVERY SUBNORMAL. So a matrix whose largest entry
# is below DBL_MIN ran the whole decomposition UNBALANCED — precisely the input
# that needs balancing most. Measured: `eigen_qr` on an all-subnormal symmetric
# matrix failed from 2^-1025 down, and 2.17.0's norm repairs moved that only to
# 2^-1039 because the residue was here, not in a norm.
# ⭐ For a subnormal the floor is the mantissa's highest set bit, and that bit
# pattern IS the subnormal 2^(p-1074). Only a true zero returns 1.0 now.
# [measured: 1061-magnitude uniform sweep on eigen_qr, 2026-09-10]
fn _lp_pow2_floor(s) {
    var e = s & 0x7FF0_0000_0000_0000;
    if (e != 0) { return e; }
    var m = s & 0x000F_FFFF_FFFF_FFFF;
    if (m == 0) { return F64_ONE; }
    var b = 1 << 51;
    while (m & b == 0) { b = b >> 1; }
    return b;
}

# ⛔ 2.18.0 — AN EXACTLY ZERO OFF-DIAGONAL WAS NEVER DEFLATED. Every deflation
# test in this file read `f64_lt(|off|, EPSILON_F64 * (|a| + |b|))`, and for a
# sub-block whose diagonals sit at 2^-1050 that product is below the smallest
# subnormal — i.e. exactly 0. The test then reads `|off| < 0`, which is false for
# EVERY `|off|` including zero, so a block that had already fully decoupled was
# never recognised and the routine burned its whole iteration budget. Measured
# across the 72 subnormal block ratios: **37 failing -> 28**.
# ⭐ THE ZERO ARM IS THE WHOLE REPAIR, and that is measured rather than argued.
# ⚠ I FIRST WROTE THIS AS "the product flushes, so divide instead" AND THAT
# CAUSAL STORY WAS WRONG. The division changes no measurable behaviour: running
# the product form WITH this zero arm gives the identical 28 of 72, and its mutant
# survives every fixture. It is equivalent because on the subnormal grid there is
# no representable non-zero value below `1e-12 * scale` — the only case the two
# forms could disagree on is exactly the one the zero arm already answers. So the
# product stays, minimal and proven, rather than a rewrite with nothing behind it.
# ⚠ THE ZERO TEST IS `f64_eq`, NOT `f64_gt(a, 0) == 0`: the latter is TRUE for NaN
# as well, so it would declare a NaN off-diagonal negligible and zero it. With
# `f64_eq` a NaN falls through and `NaN < threshold` is false, so it stays
# non-negligible — which is what the shipped code always did.
# [measured: 72-ratio subnormal scan, three variants, 2026-09-10]
fn _lp_negligible_rel(x, scale) {
    var a = f64_abs(x);
    if (f64_eq(a, 0) == 1) { return 1; }
    if (f64_lt(a, f64_mul(EPSILON_F64, scale)) == 1) { return 1; }
    return 0;
}

# Is `off` negligible beside the two diagonal entries it sits between?
fn _lp_negligible(off, a, b) {
    return _lp_negligible_rel(off, f64_add(f64_abs(a), f64_abs(b)));
}

# Fresh copy of A with every entry divided by s (s > 0). Divide, never multiply
# by 1/s: a subnormal s makes 1/s overflow to +Inf.
fn _lp_mat_div_scalar(A, s) {
    var B = ganita_mat_copy(A);
    if (B == 0) { return 0; }
    var total = ganita_mat_rows(A) * ganita_mat_cols(A);
    var i = 0;
    while (i < total) {
        store64(B + 16 + i * 8, f64_div(load64(B + 16 + i * 8), s));
        i = i + 1;
    }
    return B;
}

# Largest |re| or |im| over a complex matrix (0 for the zero matrix).
fn _lp_cmat_max_abs(A) {
    var rows = cmat_rows(A);
    var cols = cmat_cols(A);
    var mx = f64_from(0);
    var i = 0;
    while (i < rows) {
        var j = 0;
        while (j < cols) {
            var z = cmat_get(A, i, j);
            var a = f64_abs(HComplex_re(z));
            if (f64_gt(a, mx) == 1) { mx = a; }
            a = f64_abs(HComplex_im(z));
            if (f64_gt(a, mx) == 1) { mx = a; }
            j = j + 1;
        }
        i = i + 1;
    }
    return mx;
}

# ⛔ 2.22.1 — A BALANCE SCALE CHOSEN FROM THE LARGEST ENTRY SAYS NOTHING ABOUT
# THE SMALLEST, AND THAT IS WHERE THE VALUE WAS BEING LOST. `pow2_floor(max|A|)`
# puts the largest entry in [1,2); for a matrix whose entries span more than 1022
# binades the smallest is then SUBNORMAL after the divide — and a power-of-two
# divide is exact only while the quotient stays NORMAL, because below DBL_MIN the
# representable grid is absolute rather than relative, so dividing walks off it.
# ⛔ Measured on the 2.20.0 acceptance fixture at c = 2^-1073: the entry is 18
# units of 2^-1074, `pow2_floor(9)` is 8, 18/8 = 2.25 ROUNDS TO 2, and 2*8 = 16,
# so **11% was destroyed before `_lp_bidiagonalize` was ever called**.
# ⭐ THE FIX IS TO CHOOSE THE SCALE FROM BOTH ENDS. Halve it — i.e. scale the
# matrix UP — until the smallest non-zero entry is normal, stopping if the
# largest would overflow. Still a power of two, so still exact, and when every
# entry is already normal the loop does not execute and the behaviour is
# unchanged.
# ⚠ 2.22.1's issue filing first claimed "no single global scalar can work". That
# is FALSE and measurement refuted it: f64's normal range spans 2045 binades and
# these fixtures need ~1076, so one scalar is sufficient — the defect was WHICH
# scalar, not how many. **A filing is a measurement like any other.**
# ⚠ Dividing can never lift a subnormal INPUT into the normal range, so the loop
# must be allowed past 1 into sc < 1. An earlier draft guarded `sc > 1` and
# therefore did nothing at all for exactly the inputs it was written for —
# measured, it turned a correct row at 2^-1065 into HSB_ERR_NO_CONVERGENCE.
# [measured: 3 fixtures x 52 subnormal scales vs a 200-digit oracle, 2026-09-11]
#must_use
fn _lp_balance_scale(A, rows, cols) {
    var hi = _lp_mat_max_abs(A);
    var sc = _lp_pow2_floor(hi);
    var lo = F64_POS_INF;
    for (var bi = 0; bi < rows; bi = bi + 1) {
        for (var bj = 0; bj < cols; bj = bj + 1) {
            var av = f64_abs(ganita_mat_get(A, bi, bj));
            if (f64_gt(av, 0) == 1) {
                if (f64_lt(av, lo) == 1) { lo = av; }
            }
        }
    }
    if (f64_lt(lo, F64_POS_INF) == 0) { return sc; }
    while (f64_lt(f64_div(lo, sc), F64_TINY) == 1) {
        var nsc = f64_mul(sc, F64_HALF);
        # ⚠ Both exits are required: `nsc` can reach 0 by repeated halving, and
        # `hi / nsc` can overflow to +Inf for a matrix that genuinely spans more
        # than f64's normal range. `f64_lt(x, +Inf) == 0` catches Inf and NaN.
        if (f64_gt(nsc, 0) == 0) { break; }
        if (f64_lt(f64_div(hi, nsc), F64_POS_INF) == 0) { break; }
        sc = nsc;
    }
    return sc;
}

# ⛔ 2.22.0 — A NON-FINITE ENTRY MADE BOTH DECOMPOSITIONS RETURN SUCCESS WITH A
# NaN PAYLOAD. Measured on the 2.21.0 tree: `svd_golub_kahan` on [[+Inf,0],[0,1]]
# returns HSB_ERR_NONE with BOTH singular values NaN, and `eigen_qr` on the same
# matrix returns HSB_ERR_NONE with both eigenvalues NaN. -Inf and NaN inputs do
# the same. That is the fabricated-success class, not a representation nicety: a
# caller checking the return code is told the decomposition worked.
# ⭐ `f64_lt(f64_abs(x), F64_POS_INF) == 0` catches Inf AND NaN in one test,
# because **every f64 comparison involving NaN returns 0** — the property that has
# burned this project repeatedly is here the one that makes the guard complete.
# ⚠ Written as "not finite" rather than "is Inf or is NaN" deliberately: the
# two-test form invites someone to drop the NaN arm, which is exactly the mistake
# `_opt_armijo` documents and which made 2.17.0's SVD figure wrong.
# ⚠ Rejecting is the honest contract here, matching the m < n precedent in
# `svd_golub_kahan`: a matrix with a non-finite entry has no SVD and no spectrum,
# and the caller's out_S / out_vals have nowhere to put "undefined".
# ⚠ IT IS NOT FREE, AND THE FIRST DRAFT OF THIS COMMENT SAID IT WAS. "O(n^2)
# against an O(n^3) decomposition, measured at no detectable cost" was written
# before it was measured; measured, `svd_golub_kahan_12` moves **+2.98%**
# (113.85 -> 117.24 us) and `eigen_qr_12` **+0.75%** (86.17 -> 86.82), against an
# untouched control of **+0.29% median over 23 rows, 0 past 10%**. Small, in the
# direction the added scan predicts, inside that row's own historical spread —
# and stated rather than hidden behind it.
# [measured: +Inf / -Inf / NaN probes both entry points; 3x3 bench with control]
#must_use
fn _lp_mat_all_finite(A, rows, cols) {
    for (var i = 0; i < rows; i = i + 1) {
        for (var j = 0; j < cols; j = j + 1) {
            if (f64_lt(f64_abs(ganita_mat_get(A, i, j)), F64_POS_INF) == 0) { return 0; }
        }
    }
    return 1;
}

fn _lp_vec_new(n) {
    var v = alloc(n * 8);
    var i = 0;
    while (i < n) {
        store64(v + i * 8, f64_from(0));
        i = i + 1;
    }
    return v;
}

# Copy flat f64 array: dst[0..n) = src[0..n)
fn _lp_vec_copy(dst, src, n) {
    var i = 0;
    while (i < n) {
        store64(dst + i * 8, load64(src + i * 8));
        i = i + 1;
    }
    return 0;
}

# Copy matrix data: dst = src (same dimensions assumed)
fn _lp_mat_copy_into(dst, src) {
    var n = ganita_mat_rows(src) * ganita_mat_cols(src);
    var i = 0;
    while (i < n) {
        store64(dst + 16 + i * 8, load64(src + 16 + i * 8));
        i = i + 1;
    }
    return 0;
}

# ================================================================
# Section 1 -- Golub-Kahan SVD
# ================================================================
#
# svd_golub_kahan(A, out_U, out_S, out_Vt) -> error code
#
# A:      stdlib matrix (m x n, m >= n).
# out_U:  stdlib matrix (m x n, caller allocates).
# out_S:  flat f64 array of length n (caller allocates, receives singular values).
# out_Vt: stdlib matrix (n x n, caller allocates).
# Returns: HSB_ERR_NONE on success, HSB_ERR_NO_CONVERGENCE if QR iteration
#          fails, HSB_ERR_ALLOC if the balancing copy fails.
# A is balanced to unit max magnitude before decomposing and rescaled on the way
# out; the balance uses a power-of-two divisor, so it is exact..
#
# Algorithm:
#   Step 1: Householder bidiagonalization  A = U1 * B * V1^T
#   Step 2: Implicit QR iteration on bidiagonal B for singular values
#   Step 3: Accumulate singular vectors into U and Vt

# Step 1a: Householder bidiagonalization
# Reduces m x n matrix (m >= n) to upper bidiagonal form.
# On return:
#   - diag[0..n):   main diagonal of B
#   - superdiag[0..n-1): superdiagonal of B
#   - U_acc:  m x n orthogonal matrix (left Householder product)
#   - Vt_acc: n x n orthogonal matrix (right Householder product transposed)
fn _lp_bidiagonalize(A, m, n, diag, superdiag, U_acc, Vt_acc) {
    # Work on a copy of A
    var W = ganita_mat_copy(A);

    # Initialize U_acc to m x n slice of identity
    var i = 0;
    while (i < m * n) {
        store64(U_acc + 16 + i * 8, f64_from(0));
        i = i + 1;
    }
    i = 0;
    while (i < n) {
        ganita_mat_set(U_acc, i, i, F64_ONE);
        i = i + 1;
    }

    # Initialize Vt_acc to n x n identity
    i = 0;
    while (i < n * n) {
        store64(Vt_acc + 16 + i * 8, f64_from(0));
        i = i + 1;
    }
    i = 0;
    while (i < n) {
        ganita_mat_set(Vt_acc, i, i, F64_ONE);
        i = i + 1;
    }

    # Storage for the left Householder reflectors, so U can be accumulated in
    # REVERSE afterwards. A = H_0*H_1*...*H_{n-1} * B * (right reflectors), so
    # U = H_0*H_1*...*H_{n-1}. Applying them to the identity in FORWARD order —
    # which is what this loop did through 2.6.12 — builds H_{n-1}*...*H_0, the
    # transpose, so `A != U*S*Vt` while `A == U^T*B*Vt` held. (Vt_acc is
    # unaffected: V^T is literally G_{n-1}*...*G_0, so forward order is correct
    # there, which is why S and Vt were right and only U was wrong.)
    # v_k has length m-k and lives at lv_store[k*m ...]; lv_tv[k] == 0 means the
    # reflector was skipped for that k.
    var lv_store = _lp_vec_new(m * n);
    var lv_tv = _lp_vec_new(n);

    var k = 0;
    while (k < n) {
        # ---- Left Householder: zero out column k below diagonal ----
        var len_l = m - k;
        var v_l = _lp_vec_new(len_l);

        # Extract column k, rows k..m
        i = 0;
        while (i < len_l) {
            store64(v_l + i * 8, ganita_mat_get(W, k + i, k));
            i = i + 1;
        }

        # ⛔ 2.22.0 — THIS WAS AN ABSOLUTE 1e-12 ON A LENGTH, AND IT SILENTLY
        # DISCARDED THE MASS IT DECLINED TO REFLECT. `norm_l` is degree ONE in
        # the caller's units; below 1e-12 the reflector was skipped, and the
        # extraction below reads only the (bi)diagonal band — so the entries this
        # reflector would have zeroed were simply DROPPED and the routine returned
        # the factorisation of a DIFFERENT matrix with rc = HSB_ERR_NONE.
        # ⭐ GUARD WHAT ACTUALLY FAILS. The only operation at risk is `2/vtv`, and
        # it already has its own degree-TWO `F64_TINY` test a few lines below
        # (2.15.0). What is left for this gate to ask is only "is there anything
        # to reflect?", which is an EXACT ZERO question — there is no scale to
        # choose here, and a threshold that needs one chosen for it is the defect.
        # [measured: block-ratio sweep through the public entry point, 2026-09-11]
        var norm_l = _lp_vec_norm(v_l, 0, len_l);
        if (f64_gt(norm_l, 0) == 1) {
            var v0 = load64(v_l);
            var sgn = _lp_sign(v0);
            # v[0] += sign(v[0]) * ||v||
            store64(v_l, f64_add(v0, f64_mul(sgn, norm_l)));

            # Compute vTv for normalization
            # ⛔ 2.22.1 — NORMALISE v, SO `vtv` IS 1 BY CONSTRUCTION. `vtv` is
            # degree TWO, and at the bottom of the NORMAL range (entries around
            # 2^-1022) every square underflows to zero — so the `F64_TINY` guard
            # below correctly refuses to divide, and **the consequence is exactly
            # the silent drop the absolute gate used to cause**: the reflector is
            # skipped and the extraction discards the mass below the diagonal.
            # ⭐ `H = I - 2vv'/v'v` is identically `I - 2uu'` for `u = v/||v||`,
            # and `||v||` now comes from the scale-free `_lp_vec_norm`, so there
            # is nothing left to underflow. The guard below is kept — it is still
            # the right test for a genuinely zero vector — but it can no longer
            # fire for a well-formed reflector.
            # ⚠ 2.22.1's first attempt repaired only the BALANCE and left this,
            # which measured **30 loud rows converted into silent wrong answers**
            # — the precise trade the 2.19.0 refutation named. Both halves are
            # required; either alone is worse than neither.
            # [measured: 3 fixtures x 52 scales vs a 200-digit oracle, 2026-09-11]
            var nv_l = _lp_vec_norm(v_l, 0, len_l);
            if (f64_gt(nv_l, 0) == 1) {
                i = 0;
                while (i < len_l) {
                    store64(v_l + i * 8, f64_div(load64(v_l + i * 8), nv_l));
                    i = i + 1;
                }
            }
            var vtv = f64_from(0);
            i = 0;
            while (i < len_l) {
                var vi = load64(v_l + i * 8);
                vtv = f64_add(vtv, f64_mul(vi, vi));
                i = i + 1;
            }

            # ⛔ `vtv` is a Householder v·v — degree TWO in the matrix entries —
            # against an absolute 1e-12, so a well-formed reflector on a small
            # matrix was skipped and the factorisation silently came back wrong.
            # ⭐ DBL_MIN here, and NOT `vtv > 0`, because the numerator is the
            # CONSTANT 2: `2/vtv` overflows for a subnormal vtv even though the
            # quotient of a bounded pair would not. Contrast the Givens radii
            # below, where |y|/r <= 1 and an exact-zero test is the right one.
            # [measured: docs/audit/2026-09-09-epsilon-open.json]
            if (f64_lt(vtv, F64_TINY) == 0) {
                var two_over_vtv = f64_div(F64_TWO, vtv);

                # Apply H_l to W: W[k:m, k:n] -= (2/vTv) * v * (v^T * W[k:m, k:n])
                var j = k;
                while (j < n) {
                    # dot = v^T * W[k:m, j]
                    var dot = f64_from(0);
                    i = 0;
                    while (i < len_l) {
                        dot = f64_add(dot, f64_mul(load64(v_l + i * 8),
                            ganita_mat_get(W, k + i, j)));
                        i = i + 1;
                    }
                    var coeff = f64_mul(two_over_vtv, dot);
                    i = 0;
                    while (i < len_l) {
                        var wij = ganita_mat_get(W, k + i, j);
                        ganita_mat_set(W, k + i, j,
                          f64_sub(wij, f64_mul(coeff, load64(v_l + i * 8))));
                        i = i + 1;
                    }
                    j = j + 1;
                }

                # Save this reflector; U is accumulated in reverse after the loop.
                store64(lv_tv + k * 8, vtv);
                i = 0;
                while (i < len_l) {
                    store64(lv_store + (k * m + i) * 8, load64(v_l + i * 8));
                    i = i + 1;
                }
            }
        }

        # ---- Right Householder: zero out row k to the right of superdiagonal ----
        if (k < n - 2) {
            var len_r = n - k - 1;
            var v_r = _lp_vec_new(len_r);

            # Extract row k, cols (k+1)..n
            i = 0;
            while (i < len_r) {
                store64(v_r + i * 8, ganita_mat_get(W, k, k + 1 + i));
                i = i + 1;
            }

            # ⛔ 2.22.0 — the RIGHT reflector's half of the same gate. Repaired
            # together with the left one on purpose: 2.18.0's finding here was that
            # a guard repaired on ONE side of a pair is a new defect, not half a
            # repair (it applied a reflector under one threshold and replayed it
            # into U under another, so U*S*Vt stopped being A). Same rule as the
            # left gate above: the division has its own F64_TINY test, so this asks
            # only whether there is anything to reflect.
            # [measured: block-ratio sweep through svd_golub_kahan, 2026-09-11]
            var norm_r = _lp_vec_norm(v_r, 0, len_r);
            if (f64_gt(norm_r, 0) == 1) {
                var r0 = load64(v_r);
                var sgn_r = _lp_sign(r0);
                store64(v_r, f64_add(r0, f64_mul(sgn_r, norm_r)));

                # ⭐ 2.22.1 — normalised, same as the left reflector above.
                var nv_r = _lp_vec_norm(v_r, 0, len_r);
                if (f64_gt(nv_r, 0) == 1) {
                    i = 0;
                    while (i < len_r) {
                        store64(v_r + i * 8, f64_div(load64(v_r + i * 8), nv_r));
                        i = i + 1;
                    }
                }
                var vtv_r = f64_from(0);
                i = 0;
                while (i < len_r) {
                    var vi = load64(v_r + i * 8);
                    vtv_r = f64_add(vtv_r, f64_mul(vi, vi));
                    i = i + 1;
                }

                # ⛔ Same class, the RIGHT reflector. ⚠ And here `vtv_r > 0` is
                # measurably NOT equivalent to DBL_MIN — a subnormal vtv_r makes
                # 2/vtv_r overflow — so the constant is load-bearing, not stylistic.
                if (f64_lt(vtv_r, F64_TINY) == 0) {
                    var two_over_vtv_r = f64_div(F64_TWO, vtv_r);

                    # Apply H_r to W: W[k:m, (k+1):n] -= (2/vTv) * (W * v) * v^T
                    # i.e., for each row i of W[k:m, :]: row -= (2/vTv) * (row . v) * v^T
                    var ri = k;
                    while (ri < m) {
                        var dot = f64_from(0);
                        i = 0;
                        while (i < len_r) {
                            dot = f64_add(dot, f64_mul(ganita_mat_get(W, ri, k + 1 + i),
                                load64(v_r + i * 8)));
                            i = i + 1;
                        }
                        var coeff = f64_mul(two_over_vtv_r, dot);
                        i = 0;
                        while (i < len_r) {
                            var wij = ganita_mat_get(W, ri, k + 1 + i);
                            ganita_mat_set(W, ri, k + 1 + i,
                              f64_sub(wij, f64_mul(coeff, load64(v_r + i * 8))));
                            i = i + 1;
                        }
                        ri = ri + 1;
                    }

                    # Accumulate into Vt_acc: Vt_acc[(k+1):n, :] -= (2/vTv) * v * (v^T * Vt_acc)
                    var j = 0;
                    while (j < n) {
                        var dot = f64_from(0);
                        i = 0;
                        while (i < len_r) {
                            dot = f64_add(dot, f64_mul(load64(v_r + i * 8),
                                ganita_mat_get(Vt_acc, k + 1 + i, j)));
                            i = i + 1;
                        }
                        var coeff = f64_mul(two_over_vtv_r, dot);
                        i = 0;
                        while (i < len_r) {
                            var vtij = ganita_mat_get(Vt_acc, k + 1 + i, j);
                            ganita_mat_set(Vt_acc, k + 1 + i, j,
                              f64_sub(vtij, f64_mul(coeff, load64(v_r + i * 8))));
                            i = i + 1;
                        }
                        j = j + 1;
                    }
                }
            }
        }

        k = k + 1;
    }

    # ---- Backward accumulation of U ----
    # U = H_0 * H_1 * ... * H_{n-1}, so left-applying to the identity must run
    # from the LAST reflector to the first. Running it forward (as through 2.6.12)
    # produces the transpose and silently breaks A = U*S*Vt.
    k = n - 1;
    while (k >= 0) {
        var bvtv = load64(lv_tv + k * 8);
        # ⛔ 2.18.0 — THIS GUARD AND THE ONE THAT STORED THE REFLECTOR DISAGREED,
        # AND THAT IS THE WHOLE `A != U*S*Vt` DEFECT 2.15.0 FOUND AND COULD NOT
        # EXPLAIN. The forward pass applies a reflector to W and records it when
        # `vtv >= F64_TINY`; this replay put it into U only when
        # `vtv > EPSILON_F64`. For any `vtv` in [DBL_MIN, 1e-12] the reflector is
        # therefore IN B AND NOT IN U, so the factorisation is internally
        # inconsistent — `B` is right, `S` is right, `U` and `Vt` are each
        # perfectly orthogonal, and `U*S*Vt` is simply not `A`.
        # ⚠ **2.15.0 CREATED THIS BAND.** Before it, both guards read
        # `EPSILON_F64` and agreed; 2.15.0 repaired the storing guard to DBL_MIN —
        # correctly, `2/vtv` overflows for a subnormal `vtv` — and left its twin
        # forty lines away untouched. A guard repaired on one side of a pair is a
        # new defect, not half a repair.
        # ⭐ Measured on a 4x4 whose second block sits at ratio c: the small block
        # is reconstructed with the WRONG SIGN — residual exactly 2x the block —
        # for **19 ratios, 2^-21 through 2^-39**, worst 9.5e-7. The band ends at
        # 2^-39 because below it the column norm itself drops under EPSILON_F64
        # and the FORWARD pass skips too, so the two agree again by accident.
        # [measured: 999-ratio reconstruction scan before and after, 2026-09-10]
        if (f64_lt(bvtv, F64_TINY) == 0) {
            var blen = m - k;
            var btwo = f64_div(F64_TWO, bvtv);
            var bj = 0;
            while (bj < n) {
                var bdot = f64_from(0);
                i = 0;
                while (i < blen) {
                    bdot = f64_add(bdot, f64_mul(load64(lv_store + (k * m + i) * 8),
                        ganita_mat_get(U_acc, k + i, bj)));
                    i = i + 1;
                }
                var bcoeff = f64_mul(btwo, bdot);
                i = 0;
                while (i < blen) {
                    var buij = ganita_mat_get(U_acc, k + i, bj);
                    ganita_mat_set(U_acc, k + i, bj,
                      f64_sub(buij, f64_mul(bcoeff, load64(lv_store + (k * m + i) * 8))));
                    i = i + 1;
                }
                bj = bj + 1;
            }
        }
        k = k - 1;
    }

    # Extract bidiagonal entries from W
    i = 0;
    while (i < n) {
        store64(diag + i * 8, ganita_mat_get(W, i, i));
        i = i + 1;
    }
    i = 0;
    while (i < n - 1) {
        store64(superdiag + i * 8, ganita_mat_get(W, i, i + 1));
        i = i + 1;
    }

    return Ok(0);
}

# Split the active bidiagonal block at a negligible DIAGONAL entry.
#
# The implicit-shift step in _lp_bidiag_qr builds its first rotation from the
# pair (d[p_lo]^2 - mu, d[p_lo]*f[p_lo]). When d[p_lo] is zero that pair is
# (-mu, 0), whose rotation is a bare sign flip: the sweep reproduces the block
# unchanged and spins until max_iter, so svd_golub_kahan returns
# HSB_ERR_NO_CONVERGENCE with out_S never written. This is TYPICAL of, but not
# universal to, rank-deficient input: bidiagonalization can instead leave an
# exactly-zero SUPERdiagonal, which lets the outer deflation loop split the block
# before any zero diagonal sits inside an active one. Measured on the pre-fix
# code: 104 of 240 random rank-deficient matrices failed, but 60 of 60 did once
# columns were forced dependent. The rank-1 [[1,2,3],[2,4,6],[3,6,9]] bidiagonalizes to
# d = (-3.7417, 0, 0), f = (13.4907, 0), and one sweep drives it to
# d = (~1e-16, 0, 0), f = (-14, 0), which then repeats forever.
#
# A negligible d[k] means row k (for k < p_hi) or column p_hi (for k == p_hi)
# of the block is empty apart from one superdiagonal entry, and a chase of exact
# Givens rotations removes that entry outright -- splitting the block and
# deflating a singular value of exactly 0. This is the zero-diagonal case of
# Golub & Van Loan Alg. 8.6.2, omitted from the original transcription.
#
# Returns 1 if a split was performed (caller must restart the sweep), else 0.
fn _lp_split_zero_diag(diag, superdiag, n, m, U_acc, Vt_acc, p_lo, p_hi) {
    # The zero test must be RELATIVE to the block: a bare EPSILON_F64 would call
    # every entry of a 1e-20-scaled block zero and no entry of a 1e+20 one.
    var scale = f64_from(0);
    var i = p_lo;
    while (i <= p_hi) {
        var dv = f64_abs(load64(diag + i * 8));
        if (f64_gt(dv, scale) == 1) { scale = dv; }
        if (i < p_hi) {
            var fv = f64_abs(load64(superdiag + i * 8));
            if (f64_gt(fv, scale) == 1) { scale = fv; }
        }
        i = i + 1;
    }
    # NOTE: EPSILON_F64 is 1e-12, not machine epsilon (2.22e-16), so this snaps
    # any singular value below 1e-12 * ||B_block||_inf to exactly 0 where LAPACK's
    # dbdsqr would keep it. Probed at 1e-9 / 1e-11 / 1e-13: no regression -- at
    # 1e-13 the PRE-FIX code already returned NO_CONVERGENCE with S all zero, so
    # the fix is strictly better. Consistent with the deflation threshold above.
    # ⛔ 2.18.0 — SAME PRODUCT, SAME FLUSH. `EPSILON_F64 * scale` is 0 for a block
    # at 2^-1050, so every `f64_lt(x, tol)` below became `x < 0` and neither the
    # zero-diagonal scan nor either chase could ever fire. `scale` is carried to
    # the three comparison sites instead and each divides, via
    # `_lp_negligible_rel`. [measured: subnormal sub-block probe, 2026-09-10]

    var hit = (0 - 1);
    i = p_lo;
    while (i <= p_hi) {
        if (_lp_negligible_rel(load64(diag + i * 8), scale) == 1) {
            hit = i;
            break;
        }
        i = i + 1;
    }
    if (hit < 0) { return 0; }

    # Snap it to a hard zero first: both chases assume row `hit` (resp. column
    # p_hi) is empty, and a residual 1e-16 left there would be rotated into the
    # sub-diagonal and destroy the bidiagonal form.
    store64(diag + hit * 8, f64_from(0));

    if (hit < p_hi) {
        # Row `hit` holds only f[hit], at column hit+1. Rotate it away against
        # d[hit+1] (rows hit, hit+1); that pulls f[hit+1] into column hit+2 of
        # row `hit`, so the entry is chased one column right per rotation until
        # it falls off the end of the block.
        var carry = load64(superdiag + hit * 8);
        store64(superdiag + hit * 8, f64_from(0));
        var j = hit + 1;
        while (j <= p_hi) {
            var dj = load64(diag + j * 8);
            # ⛔ 2.17.0 — THE GIVENS RADIUS SQUARED BEFORE SUMMING. Both legs are
            # degree ONE bidiagonal entries, so below 2^-537 both squares flush
            # and `r` is exactly 0 — and the very next line breaks out of the
            # chase, after :477 has ALREADY zeroed the superdiagonal entry. The
            # mass is simply gone and `svd_golub_kahan` still returns
            # HSB_ERR_NONE. ⚠ `tol` here is relative to the ACTIVE BLOCK, so for
            # a block at 1e-200 the true radius is ~188 decades ABOVE tol and the
            # break is flatly wrong.
            var r_ss = f64_add(f64_mul(dj, dj), f64_mul(carry, carry));
            var r = f64_sqrt(r_ss);
            if (f64_lt(r_ss, F64_TINY) == 1) { r = ganita_f64_hypot(dj, carry); }
            if (f64_eq(r_ss, F64_POS_INF) == 1) { r = ganita_f64_hypot(dj, carry); }
            if (_lp_negligible_rel(r, scale) == 1) { break; }
            var cs = f64_div(dj, r);
            var sn = f64_div(carry, r);
            store64(diag + j * 8, r);
            if (j < p_hi) {
                var fj = load64(superdiag + j * 8);
                store64(superdiag + j * 8, f64_mul(cs, fj));
                carry = f64_mul(f64_neg(sn), fj);
            } else {
                carry = f64_from(0);
            }
            # Left rotation on rows (hit, j) of B == columns (hit, j) of U --
            # same G = [[cs, -sn], [sn, cs]] convention as the bulge chase.
            var t = 0;
            while (t < m) {
                var u0 = ganita_mat_get(U_acc, t, hit);
                var u1 = ganita_mat_get(U_acc, t, j);
                ganita_mat_set(U_acc, t, hit, f64_sub(f64_mul(cs, u0), f64_mul(sn, u1)));
                ganita_mat_set(U_acc, t, j, f64_add(f64_mul(sn, u0), f64_mul(cs, u1)));
                t = t + 1;
            }
            j = j + 1;
        }
        return 1;
    }

    # hit == p_hi: column p_hi holds only f[p_hi-1], at row p_hi-1. Rotate it
    # away against d[p_hi-1] (columns p_hi-1, p_hi); that pulls f[p_hi-2] into
    # row p_hi-2 of column p_hi, chasing the entry one row up per rotation.
    var ccarry = load64(superdiag + (p_hi - 1) * 8);
    store64(superdiag + (p_hi - 1) * 8, f64_from(0));
    var c = p_hi - 1;
    while (c >= p_lo) {
        var dc = load64(diag + c * 8);
        # ⛔ 2.17.0 — the OTHER arm of the same chase, taken when the negligible
        # diagonal is the LAST in the block. ⚠ Repairing only the arm above
        # leaves this one live on a fixture one line different: measured, the
        # :481-only patch leaves 3 of 3 probe magnitudes byte-identical to the
        # unpatched run.
        # [measured: 2-arm zero-diagonal probe on the 2.16.0 tree, 2026-09-10]
        var r2_ss = f64_add(f64_mul(dc, dc), f64_mul(ccarry, ccarry));
        var r2 = f64_sqrt(r2_ss);
        if (f64_lt(r2_ss, F64_TINY) == 1) { r2 = ganita_f64_hypot(dc, ccarry); }
        if (f64_eq(r2_ss, F64_POS_INF) == 1) { r2 = ganita_f64_hypot(dc, ccarry); }
        if (_lp_negligible_rel(r2, scale) == 1) { break; }
        var cs2 = f64_div(dc, r2);
        var sn2 = f64_div(f64_neg(ccarry), r2);
        store64(diag + c * 8, r2);
        if (c > p_lo) {
            var fc = load64(superdiag + (c - 1) * 8);
            store64(superdiag + (c - 1) * 8, f64_mul(cs2, fc));
            ccarry = f64_mul(sn2, fc);
        } else {
            ccarry = f64_from(0);
        }
        # Right rotation on columns (c, p_hi) of B == rows (c, p_hi) of Vt.
        var t2 = 0;
        while (t2 < n) {
            var v0 = ganita_mat_get(Vt_acc, c, t2);
            var v1 = ganita_mat_get(Vt_acc, p_hi, t2);
            ganita_mat_set(Vt_acc, c, t2, f64_sub(f64_mul(cs2, v0), f64_mul(sn2, v1)));
            ganita_mat_set(Vt_acc, p_hi, t2, f64_add(f64_mul(sn2, v0), f64_mul(cs2, v1)));
            t2 = t2 + 1;
        }
        c = c - 1;
    }
    return 1;
}

# Step 2: Implicit QR iteration on bidiagonal matrix for SVD.
# Operates on diag[0..n) and superdiag[0..n-1) in place.
# Accumulates Givens rotations into U_acc (m x n) and Vt_acc (n x n).
# max_iter: maximum total QR sweeps.
#must_use
fn _lp_bidiag_qr(diag, superdiag, n, m, U_acc, Vt_acc, max_iter) {
    var iter = 0;
    var p_hi = n - 1;  # active submatrix upper bound

    while (p_hi > 0 && iter < max_iter) {
        # Check for negligible superdiagonal entries -- deflation
        var i = 0;
        while (i < p_hi) {
            if (_lp_negligible(load64(superdiag + i * 8),
                load64(diag + i * 8), load64(diag + (i + 1) * 8)) == 1) {
                store64(superdiag + i * 8, f64_from(0));
            }
            i = i + 1;
        }

        # ⛔ 2.22.0 — A DEAD 20-LINE BLOCK COMPUTING `q` STOOD HERE, AND IT WAS
        # DEAD IN A WAY THAT HID A DEFECT. It scanned the superdiagonal with a
        # "force exit trick" (`q = q + p_hi`) and an "undo the forced exit trick"
        # that restored `q` — after which `q` was NEVER READ AGAIN, the comment
        # below it beginning "Recalculate: ... Simpler approach". Verified by
        # grepping every `q` in this function: the last use is inside the block
        # itself.
        # ⚠ It also contained the file's SECOND absolute `EPSILON_F64` comparison
        # on a superdiagonal entry, so a threshold census grepping for the shape
        # found two sites here and one of them could never have fired. Deleting it
        # is what makes the remaining one legible.
        # ⭐ Output is bit-identical across the deletion — verified over the
        # 12-scale determinant sweep and all 3991 assertions.

        # Recalculate: find the bottom block where superdiag is zero
        # Simpler approach: find p_lo and p_hi for the active unreduced block
        # p_hi: largest index where superdiag[p_hi-1] != 0
        # ⛔ THIS ONE IS NOT A DIVISION GUARD, so DBL_MIN would be wrong for it:
        # it asks whether an off-diagonal is NEGLIGIBLE RELATIVE TO its neighbours,
        # which is a question about significant digits, not about representability.
        # Against an absolute 1e-12 a small matrix never deflated at all.
        # ⭐ The relative form is already computed by the sibling deflation loop
        # twenty lines up, so this is consistency rather than a new rule — and the
        # entry is zeroed when the test fires, exactly as that sibling does.
        while (p_hi > 0 &&
          _lp_negligible(load64(superdiag + (p_hi - 1) * 8),
            load64(diag + (p_hi - 1) * 8), load64(diag + p_hi * 8)) == 1) {
            store64(superdiag + (p_hi - 1) * 8, f64_from(0));
            p_hi = p_hi - 1;
        }
        if (p_hi == 0) {
            # Fully converged
            p_hi = 0;  # will exit while loop
        } else {
            # Find p_lo: smallest index in the unreduced block
            var p_lo = p_hi - 1;
            # ⛔ 2.22.0 — THIS ASKED AN ABSOLUTE QUESTION AND FROZE THE ACTIVE
            # BLOCK AT 2x2. It walks `p_lo` left while the superdiagonal above it
            # is still COUPLING, and it tested that coupling against an absolute
            # 1e-12 — while the two deflation loops fifty lines above ask the same
            # question RELATIVELY via `_lp_negligible`, and the symmetric twin
            # `_lp_tridiag_qr` has used the relative form since 2.7.0. The SVD
            # half of that pair was never converted.
            # ⛔ Below a block ratio of ~2^-40 every superdiagonal in the small
            # block is under 1e-12, so this loop exits immediately, `p_lo` never
            # walks left, and the shifted step runs on a 2x2 window of a block
            # that is NOT unreduced — a step that is not a similarity transform of
            # the real active block. The accumulators still receive the rotations,
            # so U and Vt stay orthogonal to 3e-16 while U*S*Vt stops being A.
            # ⚠ A 2x2 SUB-BLOCK CANNOT EXPOSE THIS, which is why the whole 2.20.0
            # acceptance family missed it: for a 2x2 the only superdiagonal
            # `p_lo` would examine is the exactly-zero coupling BETWEEN blocks, so
            # `p_lo` is correct by accident. It takes a 3x3 or larger block, whose
            # own interior superdiagonal is small, to reach the defect.
            # ⭐ The relative form is the one its sibling already computes, so this
            # is consistency rather than a new rule.
            # [measured: 6x6 blockdiag with a 3x3 sub-block, 2026-09-11]
            while (p_lo > 0 &&
              _lp_negligible(load64(superdiag + (p_lo - 1) * 8),
                load64(diag + (p_lo - 1) * 8), load64(diag + p_lo * 8)) == 0) {
                p_lo = p_lo - 1;
            }

            # A zero diagonal entry inside the block makes the shifted step below
            # a no-op (see _lp_split_zero_diag), which is what rank-deficient
            # input typically produces. Split there instead and restart.
            if (_lp_split_zero_diag(diag, superdiag, n, m, U_acc, Vt_acc,
                p_lo, p_hi) == 1) {
                iter = iter + 1;
                continue;
            }

            # Wilkinson shift: eigenvalue of trailing 2x2 of B^T*B closer to d[p_hi]^2
            var d_end = load64(diag + p_hi * 8);
            var d_prev = load64(diag + (p_hi - 1) * 8);
            var f_end = load64(superdiag + (p_hi - 1) * 8);
            var d_lo = load64(diag + p_lo * 8);
            var f_lo = load64(superdiag + p_lo * 8);
            var f_prev = f64_from(0);
            if (p_hi - 1 > p_lo) { f_prev = load64(superdiag + (p_hi - 2) * 8); }

            # ⭐ 2.18.0 — SCALE THE SHIFT BY A POWER OF TWO BEFORE SQUARING, and
            # this is what actually reaches the bottom. `a11`/`a12`/`a22` are
            # entries of B^T*B, so they are degree TWO however the shift is then
            # rearranged: for a sub-block at ratio c they are ~c², which goes
            # subnormal below c = 2^-511 and flushes below 2^-537. Rearranging
            # alone therefore moves the floor from 2^-268.5 to 2^-537 and stops.
            # ⚠ It also opened a SILENT band on the way: measured, the degree-two
            # rearrangement alone answers 512 ratios but returns five FINITE WRONG
            # singular values at 2^-514..2^-518, where the products are subnormal
            # rather than zero. Trading 5 loud failures for 5 silent wrong answers
            # is not an improvement, which is why the rearrangement does not ship
            # on its own.
            # ⭐ Dividing the six operands by an exact power of two costs nothing
            # in accuracy and the shift is only ever used to form the FIRST Givens
            # rotation, whose `cs`/`sn` depend on the RATIO y:z — so y and z are
            # computed in the same scaled space and never converted back. Nothing
            # downstream sees the scale at all.
            # [measured: 999-ratio classification, rearrangement alone vs scaled]
            var sh_m = f64_abs(d_end);
            if (f64_gt(f64_abs(d_prev), sh_m) == 1) { sh_m = f64_abs(d_prev); }
            if (f64_gt(f64_abs(f_end), sh_m) == 1) { sh_m = f64_abs(f_end); }
            if (f64_gt(f64_abs(f_prev), sh_m) == 1) { sh_m = f64_abs(f_prev); }
            if (f64_gt(f64_abs(d_lo), sh_m) == 1) { sh_m = f64_abs(d_lo); }
            if (f64_gt(f64_abs(f_lo), sh_m) == 1) { sh_m = f64_abs(f_lo); }
            var sh_s = F64_ONE;
            if (f64_gt(sh_m, 0) == 1) { sh_s = _lp_pow2_floor(sh_m); }
            # ⚠ Divide, never multiply by a reciprocal: a subnormal scale makes
            # 1/s overflow to +Inf and every zero operand becomes 0 * Inf = NaN.
            d_end = f64_div(d_end, sh_s);
            d_prev = f64_div(d_prev, sh_s);
            f_end = f64_div(f_end, sh_s);
            f_prev = f64_div(f_prev, sh_s);
            d_lo = f64_div(d_lo, sh_s);
            f_lo = f64_div(f_lo, sh_s);

            var a11 = f64_mul(d_prev, d_prev);
            # If p_hi-2 >= p_lo, add superdiag[p_hi-2]^2 (f_prev is 0 otherwise)
            a11 = f64_add(a11, f64_mul(f_prev, f_prev));
            var a12 = f64_mul(d_prev, f_end);
            var a22 = f64_add(f64_mul(d_end, d_end), f64_mul(f_end, f_end));

            # ⛔ 2.18.0 — THIS FORMED DEGREE-FOUR QUANTITIES AND THAT SET THE
            # WHOLE ROUTINE'S FLOOR. `a11`, `a12` and `a22` are already degree TWO
            # in the bidiagonal entries (they are entries of B^T*B), so `tr*tr`,
            # `a11*a22` and `a12*a12` are degree FOUR — and a degree-four quantity
            # flushes to zero at the FOURTH root of the subnormal floor,
            # 2^-537/2 = 2^-268.5. Measured on the 2.17.0 tree: `svd_golub_kahan`
            # answers correctly down to a block ratio of **2^-269 and no further**,
            # returning HSB_ERR_NO_CONVERGENCE for the 731 ratios below it. The
            # boundary is not near 2^-268.5, it IS 2^-268.5.
            # ⭐ The Wilkinson shift has a closed form that never leaves degree
            # two: with `delta = (a11 - a22)/2`,
            #     mu = a22 - a12 * (a12 / (delta + sign(delta)*hypot(delta, a12)))
            # picks the eigenvalue CLOSER TO a22 directly, so the explicit
            # discriminant and the two-root comparison both disappear. Same
            # rearrangement the symmetric shift in `_lp_tridiag_qr` got in 2.17.0,
            # and the same two reasons it is safe: `|a12| <= |denom|` so the inner
            # quotient is bounded by 1, and `denom = sign(delta)*(|delta| + h)`
            # cannot cancel.
            # ⚠ THIS DOES NOT MAKE THE ROUTINE SCALE-FREE. `a11`/`a22` are still
            # built from `d*d` and `f*f` one block above, so the floor moves from
            # the fourth root to the SQUARE root of the subnormal floor — 2^-268.5
            # to 2^-537 — and no further. Going below that needs the entries
            # themselves never to be squared, which is a different algorithm
            # (dqds / Demmel-Kahan) and not this change.
            # [measured: 999-ratio block-ratio classification before and after]
            var delta = f64_mul(F64_HALF, f64_sub(a11, a22));
            var h = ganita_f64_hypot(delta, a12);
            var sgn = _lp_sign(delta);
            var denom = f64_add(delta, f64_mul(sgn, h));
            var mu = a22;
            # The only input with no shift is an exactly zero denominator, which
            # needs delta == 0 and a12 == 0 — a block that has already deflated.
            if (f64_eq(denom, 0) == 0) {
                mu = f64_sub(a22, f64_mul(a12, f64_div(a12, denom)));
            }

            # Golub-Kahan implicit QR step (chase the bulge)
            # Initial: apply Givens to first column of B^T*B - mu*I
            # ⚠ IN THE SHIFT'S SCALED SPACE, deliberately. `mu` is scaled by
            # sh_s², so `d_lo` and `f_lo` must be too — and they already are. The
            # pair is only used to build one Givens rotation, which depends on
            # y:z and not on their common scale, so nothing is converted back.
            var y = f64_sub(f64_mul(d_lo, d_lo), mu);
            var z = f64_mul(d_lo, f_lo);

            var k = p_lo;
            while (k < p_hi) {
                # Right Givens rotation to zero z (acts on columns k, k+1)
                # ⛔ 2.17.0 — AND THE CLAIM BELOW WAS FALSE IN EXACTLY ONE BAND,
                # WHICH IS HOW THIS SITE HID. `|y| <= r` holds only while `r` is
                # the true radius; when both squares flush, `r` is 0 while `y` is
                # not, the invariant is violated, and the "only an exact zero
                # fails" test fires on a perfectly ordinary rotation.
                # ⚠ HONEST LIMIT, STATED SO THIS IS NOT READ AS A FULL REPAIR:
                # `y` and `z` are themselves degree-TWO products formed at :639
                # and :661-664, so this recovers bidiagonal entries in
                # (2^-537, 2^-268.5] and NOTHING below — beneath 2^-537 the
                # products have already arrived as exact zero and the sqrt is no
                # longer where the information was lost. Reaching further needs
                # an implicit (scaled) Wilkinson shift instead of forming B^T*B,
                # which is an algorithm change and is on the roadmap.
                var r_ss = f64_add(f64_mul(y, y), f64_mul(z, z));
                var r = f64_sqrt(r_ss);
                if (f64_lt(r_ss, F64_TINY) == 1) { r = ganita_f64_hypot(y, z); }
                if (f64_eq(r_ss, F64_POS_INF) == 1) { r = ganita_f64_hypot(y, z); }
                # ⭐ |y| <= r and |z| <= r by construction, so `y/r` and `z/r`
                # are in [-1,1] and CANNOT overflow however small r is — the only
                # input that fails is an exact zero. That is TRUE now that `r` is
                # the true radius; it was not before.
                var cs = f64_div(y, r);
                var sn = f64_div(f64_neg(z), r);
                if (f64_gt(r, 0) == 0) {
                    cs = F64_ONE;
                    sn = f64_from(0);
                }

                # Apply right rotation to B (affects columns k, k+1)
                # Rows k-1 (if exists), k, k+1 (if exists) of bidiagonal
                if (k > p_lo) {
                    store64(superdiag + (k - 1) * 8, r);
                }

                var dk = load64(diag + k * 8);
                var fk = load64(superdiag + k * 8);
                var dk1 = load64(diag + (k + 1) * 8);

                var new_dk  = f64_add(f64_mul(cs, dk), f64_mul(f64_neg(sn), fk));
                var new_fk  = f64_add(f64_mul(sn, dk), f64_mul(cs, fk));
                var bulge   = f64_mul(f64_neg(sn), dk1);
                var new_dk1 = f64_mul(cs, dk1);

                store64(diag + k * 8, new_dk);
                store64(superdiag + k * 8, new_fk);
                store64(diag + (k + 1) * 8, new_dk1);

                # Accumulate right rotation into Vt_acc (rows k, k+1)
                var j = 0;
                while (j < n) {
                    var vk  = ganita_mat_get(Vt_acc, k, j);
                    var vk1 = ganita_mat_get(Vt_acc, k + 1, j);
                    ganita_mat_set(Vt_acc, k, j,
                      f64_add(f64_mul(cs, vk), f64_mul(f64_neg(sn), vk1)));
                    ganita_mat_set(Vt_acc, k + 1, j,
                      f64_add(f64_mul(sn, vk), f64_mul(cs, vk1)));
                    j = j + 1;
                }

                # Left Givens rotation to zero the bulge (acts on rows k, k+1)
                y = load64(diag + k * 8);
                z = bulge;
                # ⛔ 2.17.0 — same class, but degree ONE here (y is a diagonal
                # entry, z the bulge), so this one reaches the full 2^-537 floor.
                # ⚠ EXPECT THE FAILURE TO GET LOUDER RATHER THAN DISAPPEAR IN THE
                # DEEPEST BAND, and do not read that as a regression: below
                # 2^-537 the right rotation's operands have already flushed, so
                # its rotation stays the identity, the sweep becomes a
                # sign-normalising no-op and `svd_golub_kahan` returns
                # HSB_ERR_NO_CONVERGENCE instead of a silent spurious zero.
                # Trading a silent wrong answer for a loud rc is the correct
                # outcome of repairing this line.
                var l_ss = f64_add(f64_mul(y, y), f64_mul(z, z));
                r = f64_sqrt(l_ss);
                if (f64_lt(l_ss, F64_TINY) == 1) { r = ganita_f64_hypot(y, z); }
                if (f64_eq(l_ss, F64_POS_INF) == 1) { r = ganita_f64_hypot(y, z); }
                # ⭐ Same as the right rotation above: the quotients are bounded
                # by 1, so only an exact zero fails.
                cs = f64_div(y, r);
                sn = f64_div(f64_neg(z), r);
                if (f64_gt(r, 0) == 0) {
                    cs = F64_ONE;
                    sn = f64_from(0);
                }

                store64(diag + k * 8, r);

                # Update superdiag[k] and diag[k+1]
                var old_fk = load64(superdiag + k * 8);
                var old_dk1 = load64(diag + (k + 1) * 8);
                store64(superdiag + k * 8,
                  f64_add(f64_mul(cs, old_fk), f64_mul(f64_neg(sn), old_dk1)));
                store64(diag + (k + 1) * 8,
                  f64_add(f64_mul(sn, old_fk), f64_mul(cs, old_dk1)));

                # If not last step, compute new bulge
                if (k + 1 < p_hi) {
                    var fk1 = load64(superdiag + (k + 1) * 8);
                    y = load64(superdiag + k * 8);
                    # Actually y and z for next iteration
                    y = load64(superdiag + k * 8);
                    z = f64_mul(f64_neg(sn), fk1);
                    store64(superdiag + (k + 1) * 8, f64_mul(cs, fk1));
                } else {
                    y = f64_from(0);
                    z = f64_from(0);
                }

                # Accumulate left rotation into U_acc (columns k, k+1)
                j = 0;
                while (j < m) {
                    var uk  = ganita_mat_get(U_acc, j, k);
                    var uk1 = ganita_mat_get(U_acc, j, k + 1);
                    ganita_mat_set(U_acc, j, k,
                      f64_add(f64_mul(cs, uk), f64_mul(f64_neg(sn), uk1)));
                    ganita_mat_set(U_acc, j, k + 1,
                      f64_add(f64_mul(sn, uk), f64_mul(cs, uk1)));
                    j = j + 1;
                }

                k = k + 1;
            }

            iter = iter + 1;
        }
    }

    if (iter >= max_iter && p_hi > 0) {
        return Err(HSB_ERR_NO_CONVERGENCE);
    }

    return Ok(0);
}

# Public: Golub-Kahan SVD
# A:      stdlib matrix (m x n, m >= n -- ENFORCED, see below).
# out_U:  stdlib matrix (m x n, caller allocates).
# out_S:  flat f64 array of length n (caller allocates).
# out_Vt: stdlib matrix (n x n, caller allocates).
# Returns: HSB_ERR_NONE on success, HSB_ERR_NO_CONVERGENCE on failure,
#          HSB_ERR_INVALID_INPUT if m < n or either dimension is non-positive.
#must_use
fn svd_golub_kahan(A, out_U, out_S, out_Vt) {
    # Any of these may be the designed 0 that ganita_mat_new returns above its own
    # element cap; ganita_mat_rows(0) is a null dereference -- guard before reading dims.
    if (A == 0 || out_U == 0) { return Err(HSB_ERR_INVALID_INPUT); }
    if (out_S == 0 || out_Vt == 0) { return Err(HSB_ERR_INVALID_INPUT); }
    var m = ganita_mat_rows(A);
    var n = ganita_mat_cols(A);

    # THE m >= n PRECONDITION IS NOW CHECKED, NOT JUST DOCUMENTED.
    #
    # It was stated in the line above and enforced nowhere, so a wide matrix ran
    # the whole decomposition and returned HSB_ERR_NONE with numbers that are not
    # its singular values. This is not a marginal-accuracy story -- it is
    # structurally impossible for the documented output SHAPE to hold an SVD when
    # m < n, because out_U is m x n and a rank-m matrix cannot carry n orthonormal
    # columns. Measured on 200 random wide matrices (m = 2..4, n = m+1..m+2)
    # against the exact identity sum(sigma_i^2) == ||A||_F^2, which needs no
    # reference implementation: 200 of 200 violated it, silently. The same sweep
    # on 200 tall matrices violated it 0 times. B = [[2,0,0],[0,1,0]] returned
    # (2, 2, 1) where the true spectrum is (2, 1).
    #
    # Rejecting is the honest contract: the caller's out_U/out_Vt are sized for
    # the tall case, so there is nowhere to put a wide-case answer. A caller that
    # wants the SVD of a wide A should decompose A^T and swap U with V.
    if (m <= 0 || n <= 0) { return Err(HSB_ERR_INVALID_INPUT); }
    if (m < n) { return Err(HSB_ERR_INVALID_INPUT); }

    # ⛔ 2.22.0 — see `_lp_mat_all_finite`. Without this, [[+Inf,0],[0,1]] returned
    # HSB_ERR_NONE with BOTH singular values NaN.
    if (_lp_mat_all_finite(A, m, n) == 0) { return Err(HSB_ERR_INVALID_INPUT); }

    var max_iter = 30 * n * n;

    # Step 1: Bidiagonalize
    var diag = _lp_vec_new(n);
    var superdiag = _lp_vec_new(n);  # n-1 used, extra slot harmless

    # Balance to unit max magnitude before decomposing; undo it on the singular
    # values below. sv(c*A) = c*sv(A) for c > 0 and U/Vt are invariant.
    # ⛔ 2.22.0 — THIS COMMENT USED TO END "and the power-of-two divisor makes both
    # the divide and the un-scale exact." THAT IS FALSE FOR A SUBNORMAL ENTRY, and
    # the claim is load-bearing: it is why the balancing was never suspected as a
    # source of loss. A power of two is exact only while the quotient stays
    # NORMAL. Below DBL_MIN the grid is absolute, not relative, so dividing walks
    # off it. Measured on the 2.20.0 acceptance fixture [[9,1],[0,2]] at
    # c = 2^-1073: the entry is 18 units of 2^-1074, `pow2_floor(9)` is 8,
    # 18/8 = 2.25 ROUNDS TO 2 units, and 2*8 = 16 != 18 — **11% of the value is
    # gone before the decomposition starts**, and no repair downstream can return
    # it. That is why `svd_golub_kahan` still reports HSB_ERR_NONE with a
    # fabricated ZERO smallest singular value there, and why 2.22.0's Householder
    # and p_lo repairs both leave that row byte-identical.
    # ⚠ Filed as `docs/development/issues/2026-09-11-svd-balancing-divide-lossy-
    # for-subnormal-blocks.md` rather than repaired here: the fix is a scaling
    # POLICY change (per-block, or an honest refusal), and this project's rule is
    # that a class is sized before it is touched.
    # [measured: balance-divide round-trip probe on the shipped tree, 2026-09-11]
    var sc = _lp_balance_scale(A, m, n);
    var As = _lp_mat_div_scalar(A, sc);
    if (As == 0) { return Err(HSB_ERR_ALLOC); }

    var err = _lp_bidiagonalize(As, m, n, diag, superdiag, out_U, out_Vt)?;

    # Step 2: QR iteration on bidiagonal
    # ⚠ 3.0.0 — a REASSIGNMENT rather than a fresh `var`, so the mechanical pass
    # missed it and then wrapped the forwarded code as a SUCCESS. `?` needs a
    # binding, hence the second name. Same shape as num_ext's two.
    var err_qr = _lp_bidiag_qr(diag, superdiag, n, m, out_U, out_Vt, max_iter)?;

    # Step 3: Make singular values non-negative; flip U column signs as needed
    var i = 0;
    while (i < n) {
        var sv = load64(diag + i * 8);
        if (f64_lt(sv, f64_from(0)) == 1) {
            store64(diag + i * 8, f64_neg(sv));
            # Flip sign of corresponding U column
            var j = 0;
            while (j < m) {
                ganita_mat_set(out_U, j, i, f64_neg(ganita_mat_get(out_U, j, i)));
                j = j + 1;
            }
        }
        i = i + 1;
    }

    # Step 4: Sort singular values in descending order (selection sort)
    i = 0;
    while (i < n) {
        var max_idx = i;
        var max_sv = load64(diag + i * 8);
        var j = i + 1;
        while (j < n) {
            if (f64_gt(load64(diag + j * 8), max_sv) == 1) {
                max_sv = load64(diag + j * 8);
                max_idx = j;
            }
            j = j + 1;
        }
        if (max_idx != i) {
            # Swap singular values
            var tmp = load64(diag + i * 8);
            store64(diag + i * 8, load64(diag + max_idx * 8));
            store64(diag + max_idx * 8, tmp);
            # Swap U columns i and max_idx
            var k = 0;
            while (k < m) {
                var tu = ganita_mat_get(out_U, k, i);
                ganita_mat_set(out_U, k, i, ganita_mat_get(out_U, k, max_idx));
                ganita_mat_set(out_U, k, max_idx, tu);
                k = k + 1;
            }
            # Swap Vt rows i and max_idx
            k = 0;
            while (k < n) {
                var tv = ganita_mat_get(out_Vt, i, k);
                ganita_mat_set(out_Vt, i, k, ganita_mat_get(out_Vt, max_idx, k));
                ganita_mat_set(out_Vt, max_idx, k, tv);
                k = k + 1;
            }
        }
        i = i + 1;
    }

    # Undo the balancing: sv(c*A) = c*sv(A), U and Vt are invariant.
    var sv_i = 0;
    while (sv_i < n) {
        store64(diag + sv_i * 8, f64_mul(sc, load64(diag + sv_i * 8)));
        sv_i = sv_i + 1;
    }

    # Copy singular values to output
    _lp_vec_copy(out_S, diag, n);

    return Ok(0);
}

# ================================================================
# Section 2 -- QR iteration for symmetric eigendecomposition
# ================================================================
#
# eigen_qr(A, n, max_iter, out_vals, out_vecs) -> error code
#
# A:        stdlib matrix (n x n, must be symmetric).
# n:        matrix dimension.
# max_iter: maximum QR iterations.
# out_vals: flat f64 array of length n (caller allocates, receives eigenvalues,
#           SORTED BY DESCENDING |lambda| -- step 3 below).
# out_vecs: stdlib matrix (n x n, caller allocates, receives eigenvectors as
#           columns, permuted alongside out_vals).
# Returns:  HSB_ERR_NONE on success, HSB_ERR_NO_CONVERGENCE if max_iter exceeded.
#
# The descending-|lambda| order has always been implemented here (the selection
# sort at the end of eigen_qr) but was never stated; the 2026-08-04 audit's
# api-consistency row recorded that eigen_symmetric returned a different,
# undocumented order for the same contract. Both are now documented AND sorted the
# same way -- eigen_symmetric (src/linalg_ext.cyr) was given this routine's sort.
#
# Algorithm:
#   Step 1: Householder tridiagonalization  A = Q * T * Q^T
#   Step 2: Implicit symmetric QR with Wilkinson shift on T
#   Step 3: Eigenvalues from diagonal of T, eigenvectors from accumulated Q,
#           then sorted by descending |lambda| with the columns carried along

# Step 1: Householder tridiagonalization of symmetric matrix
# A: n x n symmetric matrix.
# diag: flat f64 array of length n (receives main diagonal of T).
# offdiag: flat f64 array of length n (receives sub/superdiagonal; offdiag[0] unused).
# Q: n x n matrix (caller allocates, receives orthogonal transform).
fn _lp_tridiagonalize(A, n, diag, offdiag, Q) {
    # Work on a copy
    var W = ganita_mat_copy(A);

    # Initialize Q to identity
    var i = 0;
    var total = n * n;
    while (i < total) { store64(Q + 16 + i * 8, f64_from(0)); i = i + 1; }
    i = 0;
    while (i < n) { ganita_mat_set(Q, i, i, F64_ONE); i = i + 1; }

    var k = 0;
    while (k < n - 2) {
        # Extract column k below the subdiagonal: W[k+1..n, k]
        var len = n - k - 1;
        var v = _lp_vec_new(len);
        i = 0;
        while (i < len) {
            store64(v + i * 8, ganita_mat_get(W, k + 1 + i, k));
            i = i + 1;
        }

        # ⛔ 2.22.0 — THE SYMMETRIC TWIN OF THE SVD GATE, AND IT IS WHY THIS
        # RELEASE COVERS TWO PUBLIC ENTRY POINTS RATHER THAN ONE. Identical shape,
        # identical boundary: an absolute 1e-12 on a degree-ONE norm, and when it
        # fires the tridiagonal extraction drops the entries the reflector would
        # have zeroed, so `eigen_qr` returns the spectrum of a DIFFERENT matrix
        # with rc = HSB_ERR_NONE.
        # ⛔ Measured on A = [1] (+) c*B3 with B3 = [[1,1,2],[1,4,1],[2,1,1]]
        # (exact eigenvalues -1, 2, 5; the leading 1 pins max|A| so balancing is
        # the identity and nothing here is subnormal): correct at c = 2^-41,
        # and from 2^-42 down it returns lambda/c = {4.5615528, 1, 0.4384472} —
        # THE SMALLEST EIGENVALUE COMES BACK WITH THE WRONG SIGN.
        # ⭐ Those three numbers are exactly (5+sqrt17)/2, 1, (5-sqrt17)/2, the
        # spectrum of tridiag(diag = (c,4c,c), offdiag = (c,c)) — i.e. of the
        # matrix you get by dropping W[3,1] = 2c. The mechanism is confirmed by
        # the VALUES, independently of the symptom.
        # [measured: 1074-scale sweep, first wrong scale 2^-42, 2026-09-11]
        var norm = _lp_vec_norm(v, 0, len);
        if (f64_gt(norm, 0) == 1) {
            var v0 = load64(v);
            var sgn = _lp_sign(v0);
            store64(v, f64_add(v0, f64_mul(sgn, norm)));

            # Normalize: vtv
            # ⭐ 2.22.1 — normalised, same as the two bidiagonal reflectors. The
            # symmetric path squares the same way and loses the same value, and
            # repairing one of a pair is how 2.18.0's U-replay defect was created.
            var nv_t = _lp_vec_norm(v, 0, len);
            if (f64_gt(nv_t, 0) == 1) {
                i = 0;
                while (i < len) {
                    store64(v + i * 8, f64_div(load64(v + i * 8), nv_t));
                    i = i + 1;
                }
            }
            var vtv = f64_from(0);
            i = 0;
            while (i < len) {
                var vi = load64(v + i * 8);
                vtv = f64_add(vtv, f64_mul(vi, vi));
                i = i + 1;
            }

            # ⛔ `vtv` is a Householder v·v — degree TWO in the matrix entries —
            # against an absolute 1e-12, so a well-formed reflector on a small
            # matrix was skipped and the factorisation silently came back wrong.
            # ⭐ DBL_MIN here, and NOT `vtv > 0`, because the numerator is the
            # CONSTANT 2: `2/vtv` overflows for a subnormal vtv even though the
            # quotient of a bounded pair would not. Contrast the Givens radii
            # below, where |y|/r <= 1 and an exact-zero test is the right one.
            # [measured: docs/audit/2026-09-09-epsilon-open.json]
            if (f64_lt(vtv, F64_TINY) == 0) {
                var two_over_vtv = f64_div(F64_TWO, vtv);

                # Compute p = (2/vtv) * W[k+1:n, k+1:n] * v
                var p = _lp_vec_new(len);
                i = 0;
                while (i < len) {
                    var sum = f64_from(0);
                    var j = 0;
                    while (j < len) {
                        sum = f64_add(sum, f64_mul(ganita_mat_get(W, k + 1 + i, k + 1 + j),
                            load64(v + j * 8)));
                        j = j + 1;
                    }
                    store64(p + i * 8, f64_mul(two_over_vtv, sum));
                    i = i + 1;
                }

                # Compute K = (v^T * p) / 2 * (2/vtv) -- but simpler: K = v^T * p / 2
                var vtp = f64_from(0);
                i = 0;
                while (i < len) {
                    vtp = f64_add(vtp, f64_mul(load64(v + i * 8), load64(p + i * 8)));
                    i = i + 1;
                }
                var K = f64_mul(F64_HALF, f64_mul(two_over_vtv, vtp));

                # q = p - K * v
                var q = _lp_vec_new(len);
                i = 0;
                while (i < len) {
                    store64(q + i * 8, f64_sub(load64(p + i * 8),
                        f64_mul(K, load64(v + i * 8))));
                    i = i + 1;
                }

                # W[k+1:n, k+1:n] -= v*q^T + q*v^T  (symmetric update)
                i = 0;
                while (i < len) {
                    var j = 0;
                    while (j < len) {
                        var wij = ganita_mat_get(W, k + 1 + i, k + 1 + j);
                        var update = f64_add(
                          f64_mul(load64(v + i * 8), load64(q + j * 8)),
                          f64_mul(load64(q + i * 8), load64(v + j * 8)));
                        ganita_mat_set(W, k + 1 + i, k + 1 + j, f64_sub(wij, update));
                        j = j + 1;
                    }
                    i = i + 1;
                }

                # Update the tridiagonal entries in column/row k
                ganita_mat_set(W, k, k + 1, f64_neg(f64_mul(sgn, norm)));
                ganita_mat_set(W, k + 1, k, f64_neg(f64_mul(sgn, norm)));
                i = 2;
                while (i < len + 1) {
                    ganita_mat_set(W, k, k + i, f64_from(0));
                    ganita_mat_set(W, k + i, k, f64_from(0));
                    i = i + 1;
                }

                # Accumulate Q: Q[:, k+1:n] -= (2/vtv) * (Q[:, k+1:n] * v) * v^T
                var j = 0;
                while (j < n) {
                    var dot = f64_from(0);
                    i = 0;
                    while (i < len) {
                        dot = f64_add(dot, f64_mul(ganita_mat_get(Q, j, k + 1 + i),
                            load64(v + i * 8)));
                        i = i + 1;
                    }
                    var coeff = f64_mul(two_over_vtv, dot);
                    i = 0;
                    while (i < len) {
                        var qij = ganita_mat_get(Q, j, k + 1 + i);
                        ganita_mat_set(Q, j, k + 1 + i,
                          f64_sub(qij, f64_mul(coeff, load64(v + i * 8))));
                        i = i + 1;
                    }
                    j = j + 1;
                }
            }
        }

        k = k + 1;
    }

    # Extract tridiagonal entries
    i = 0;
    while (i < n) {
        store64(diag + i * 8, ganita_mat_get(W, i, i));
        i = i + 1;
    }
    i = 0;
    while (i < n - 1) {
        store64(offdiag + (i + 1) * 8, ganita_mat_get(W, i + 1, i));
        i = i + 1;
    }
    store64(offdiag, f64_from(0));

    return Ok(0);
}

# Step 2: Implicit symmetric QR iteration with Wilkinson shift on tridiagonal T.
# diag[0..n): main diagonal (modified in place to eigenvalues).
# offdiag[0..n): sub/superdiagonal (offdiag[i] = T[i,i-1], offdiag[0] = 0).
# Q: n x n matrix (accumulates Givens rotations).
# max_iter: maximum iterations.
#must_use
fn _lp_tridiag_qr(diag, offdiag, n, Q, max_iter) {
    var iter = 0;
    var p_hi = n - 1;

    while (p_hi > 0 && iter < max_iter) {
        # Deflation: check if offdiag[p_hi] is negligible
        if (_lp_negligible(load64(offdiag + p_hi * 8),
            load64(diag + p_hi * 8), load64(diag + (p_hi - 1) * 8)) == 1) {
            store64(offdiag + p_hi * 8, f64_from(0));
            p_hi = p_hi - 1;
        } else {
            # Find p_lo: the start of the unreduced block containing p_hi.
            #
            # Through 2.7.0 this was two loops. The first had a FAKE break -- a
            # `var _break = 1;` and two no-op `p_lo = p_lo;` statements with a
            # `# break` comment -- so it never exited early and always ran to 0,
            # zeroing offdiagonals across the whole matrix as a side effect. The
            # author then discarded its result ("Re-find p_lo properly") with a
            # second loop whose test was an ABSOLUTE EPSILON_F64, inconsistent
            # with the RELATIVE threshold the deflation test above uses. On a
            # matrix whose entries span 0.04 .. 24.6 the two disagree about what
            # counts as negligible, so the block bounds and the deflation test
            # could contradict each other and the sweep stalled: measured
            # HSB_ERR_NO_CONVERGENCE at max_iter = 1,000,000 for a symmetric 4x4
            # of condition number only 240.
            #
            # One loop now, using the SAME relative threshold as the deflation
            # test, and deflating as it scans.
            var p_lo = p_hi;
            while (p_lo > 0) {
                if (_lp_negligible(load64(offdiag + p_lo * 8),
                    load64(diag + p_lo * 8), load64(diag + (p_lo - 1) * 8)) == 1) {
                    store64(offdiag + p_lo * 8, f64_from(0));
                    break;
                }
                p_lo = p_lo - 1;
            }

            # Wilkinson shift: eigenvalue of trailing 2x2 block closer to d[p_hi]
            var d1 = load64(diag + (p_hi - 1) * 8);
            var d2 = load64(diag + p_hi * 8);
            var e2 = load64(offdiag + p_hi * 8);

            var delta = f64_mul(F64_HALF, f64_sub(d1, d2));

            # mu = d2 - e2^2 / (delta + sign(delta) * sqrt(delta^2 + e2^2))
            #
            # ⛔ 2.17.0 — THIS FORMED `e2*e2` AND THAT IS WHERE THE SPECTRUM WENT.
            # `e2` is a degree-ONE tridiagonal entry, so for a sub-block below
            # 2^-537 the square flushed to exactly 0, `mu` collapsed to `d2`, and
            # the shifted QR step became an UNSHIFTED one. On a symmetric block
            # with equal diagonals that step is a FIXED POINT — the rotation
            # swaps two equal entries and flips a sign forever — so `eigen_qr`
            # burned its whole budget and returned HSB_ERR_NO_CONVERGENCE,
            # losing the LARGE block's eigenvalues along with the small one.
            # Measured on a 4x4 whose second block sits at ratio c: **463 of 998
            # ratios lost, first at c = 2^-538.**
            # ⚠ THE 2026-09-09 CENSUS CLASSIFIED THE `f64_sqrt` ON THIS LINE AS
            # SAFE_UNREACHABLE AND IT WAS RIGHT ABOUT THE SQRT — rescaling that
            # recovers nothing, because the value is gone one line earlier. What
            # it missed is that `mu = d2` is not a harmless fallback. The site
            # surfaced because repairing the Givens radius 60 lines below changed
            # NOTHING measurable: a repair that moves no number is pointing at a
            # second defect, which is the 2.12.0 lesson repeating.
            # ⭐ NEVER FORM e2². The denominator has magnitude at least |e2|, so
            # `e2/denom` is bounded by 1 and `e2 * (e2/denom)` is bounded by |e2|
            # — both survive wherever `e2` itself does, and the identity is exact.
            # ⭐ And the sign trick is now the textbook one: `denom` is
            # `sign(delta) * (|delta| + hypot(delta, e2))`, which cannot cancel.
            # The absolute `|delta| < EPSILON_F64` test that used to force the
            # sign to +1 is GONE — it was an epsilon-class guard on a degree-one
            # quantity, and `_lp_sign(0)` already returns +1, so the case it was
            # written for was covered without it.
            # [measured: 998-ratio block sweep on eigen_qr before and after]
            var denom_inner = ganita_f64_hypot(delta, e2);
            var sgn_delta = _lp_sign(delta);
            var denom = f64_add(delta, f64_mul(sgn_delta, denom_inner));
            var mu = d2;
            # The only input with no shift is an exactly zero denominator, which
            # needs delta == 0 and e2 == 0 — a block that has already deflated.
            if (f64_eq(denom, 0) == 0) {
                mu = f64_sub(d2, f64_mul(e2, f64_div(e2, denom)));
            }

            # Implicit QR step: chase bulge from p_lo to p_hi
            var x = f64_sub(load64(diag + p_lo * 8), mu);
            var z = load64(offdiag + (p_lo + 1) * 8);

            var k = p_lo;
            while (k < p_hi) {
                # Givens rotation to zero z
                # ⛔ 2.17.0 — the eigen side of the same defect. Measured on a
                # 4x4 whose second block sits at ratio c: `eigen_qr` loses the
                # small block's eigenvalues entirely for **463 of 998 ratios**,
                # first at c = 2^-538, returning HSB_ERR_NO_CONVERGENCE — so the
                # caller loses the LARGE block's eigenvalues too, which were
                # perfectly computable. ⚠ The `p_lo` scan here is RELATIVE, so a
                # small sub-block is reachable without any exotic input; a
                # uniform scale would be bit-exactly invariant and prove nothing.
                # [measured: 998-ratio block sweep before and after, 2026-09-10]
                var r_ss = f64_add(f64_mul(x, x), f64_mul(z, z));
                var r = f64_sqrt(r_ss);
                if (f64_lt(r_ss, F64_TINY) == 1) { r = ganita_f64_hypot(x, z); }
                if (f64_eq(r_ss, F64_POS_INF) == 1) { r = ganita_f64_hypot(x, z); }
                var cs = F64_ONE;
                var sn = f64_from(0);
                # ⭐ |x| <= r and |z| <= r, so the rotation is well defined for
                # every non-zero r. A DBL_MIN floor would still fabricate the
                # identity rotation over a band where the division succeeds.
                # ⚠ That sentence was FALSE in the flush band until the lines
                # above: `r` was 0 with `x` non-zero, so the guard fired on a
                # well-defined rotation. The comment is what the code does now.
                if (f64_gt(r, 0) == 1) {
                    cs = f64_div(x, r);
                    sn = f64_div(z, r);
                }

                # Apply similarity transform to tridiagonal
                if (k > p_lo) {
                    store64(offdiag + k * 8, r);
                }

                var dk = load64(diag + k * 8);
                var dk1 = load64(diag + (k + 1) * 8);
                var ek1 = load64(offdiag + (k + 1) * 8);

                # Similarity update T <- G T G^T, with G = [[cs, sn], [-sn, cs]].
                #
                # G is the rotation that ZEROES the bulge: G*[x; z] = [r; 0] for
                # cs = x/r, sn = z/r (set above). The matching similarity is
                # therefore G T G^T. Through 2.6.12 this block applied G^T T G
                # instead — the transpose — which is a valid similarity but not the
                # one that annihilates the bulge, so the off-diagonal never decayed
                # and eigen_qr returned HSB_ERR_NO_CONVERGENCE for every n >= 3
                # (measured: a plain symmetric 3x3 failed even at max_iter=100000).
                # Only the signs of the cross terms differ, which is why it looked
                # right. Expanding G T G^T on the 2x2 block [[dk, ek1], [ek1, dk1]]:
                #   d'_k     = cs^2*dk + sn^2*dk1 + 2*cs*sn*ek1
                #   d'_{k+1} = sn^2*dk + cs^2*dk1 - 2*cs*sn*ek1
                #   e'_{k+1} = cs*sn*(dk1 - dk) + (cs^2 - sn^2)*ek1
                # The Q accumulation below (Q <- Q*G^T) is the correct companion to
                # THIS update and needed no change; it was the pair that was
                # inconsistent, not Q alone.
                var cs2 = f64_mul(cs, cs);
                var sn2 = f64_mul(sn, sn);
                var cs_sn = f64_mul(cs, sn);

                store64(diag + k * 8,
                  f64_add(f64_add(f64_mul(cs2, dk), f64_mul(sn2, dk1)),
                    f64_mul(f64_from(2), f64_mul(cs_sn, ek1))));
                store64(diag + (k + 1) * 8,
                  f64_sub(f64_add(f64_mul(sn2, dk), f64_mul(cs2, dk1)),
                    f64_mul(f64_from(2), f64_mul(cs_sn, ek1))));
                store64(offdiag + (k + 1) * 8,
                  f64_add(f64_mul(cs_sn, f64_sub(dk1, dk)),
                    f64_mul(f64_sub(cs2, sn2), ek1)));

                # Prepare next bulge
                if (k + 1 < p_hi) {
                    var ek2 = load64(offdiag + (k + 2) * 8);
                    x = load64(offdiag + (k + 1) * 8);
                    z = f64_mul(sn, ek2);
                    store64(offdiag + (k + 2) * 8, f64_mul(cs, ek2));
                }

                # Accumulate Givens into Q (columns k, k+1)
                var j = 0;
                while (j < n) {
                    var qk  = ganita_mat_get(Q, j, k);
                    var qk1 = ganita_mat_get(Q, j, k + 1);
                    ganita_mat_set(Q, j, k,     f64_add(f64_mul(cs, qk), f64_mul(sn, qk1)));
                    ganita_mat_set(Q, j, k + 1, f64_add(f64_mul(f64_neg(sn), qk),
                        f64_mul(cs, qk1)));
                    j = j + 1;
                }

                k = k + 1;
            }

            iter = iter + 1;
        }
    }

    if (iter >= max_iter && p_hi > 0) {
        return Err(HSB_ERR_NO_CONVERGENCE);
    }
    return Ok(0);
}

# Public: QR iteration for symmetric eigendecomposition
# A:        stdlib matrix (n x n, must be symmetric -- SHAPE ENFORCED, see below).
# n:        matrix dimension.
# max_iter: maximum QR iterations.
# out_vals: flat f64 array of length n (caller allocates).
# out_vecs: stdlib matrix (n x n, caller allocates, eigenvectors as columns).
# Returns:  HSB_ERR_NONE on success, HSB_ERR_NO_CONVERGENCE if max_iter exceeded,
#           HSB_ERR_INVALID_INPUT on a null handle or a shape that does not match n.
#must_use
fn eigen_qr(A, n, max_iter, out_vals, out_vecs) {
    # Any of these may be the designed 0 that ganita_mat_new / mat_new_guarded returns
    # above its own element cap; ganita_mat_rows(0) is a null dereference, so guard
    # before reading dims. This is svd_golub_kahan's idiom (:753) applied to the
    # one routine in this file that still lacked it: through 2.8.4 a null A,
    # out_vals or out_vecs was stored through and SIGSEGV'd (exit 139, measured).
    if (A == 0 || out_vals == 0) { return Err(HSB_ERR_INVALID_INPUT); }
    if (out_vecs == 0) { return Err(HSB_ERR_INVALID_INPUT); }

    # n <= 0 was HALF-guarded: `n == 0` only, so n = -3 fell through to
    # _lp_vec_new(-3) -> alloc of a negative size and a wild store (exit 139).
    if (n <= 0) { return Err(HSB_ERR_INVALID_INPUT); }

    # THE n x n PRECONDITION IS NOW CHECKED, NOT JUST DOCUMENTED.
    #
    # `n` is a restatement of A's own extent, and every read below is
    # ganita_mat_get(A, i, j) for i, j < n -- so an n larger than A is an out-of-bounds
    # read, and an n SMALLER than A is a silently different problem: the routine
    # would return HSB_ERR_NONE carrying the spectrum of A's leading n x n block,
    # which is not the spectrum of A. The balancing above compounds it --
    # _lp_mat_max_abs(A) scans ganita_mat_rows(A) * ganita_mat_cols(A) entries, so the scale is
    # drawn from a matrix the decomposition never looks at. There is no reading of
    # "the eigendecomposition of a non-square A", so this is rejected rather than
    # handled. out_vecs takes ganita_mat_set(out_vecs, i, j) for i, j < n and is bounded
    # the same way.
    if (ganita_mat_rows(A) != n || ganita_mat_cols(A) != n) { return Err(HSB_ERR_INVALID_INPUT); }
    if (ganita_mat_rows(out_vecs) < n || ganita_mat_cols(out_vecs) < n) { return Err(HSB_ERR_INVALID_INPUT); }

    # ⛔ 2.22.0 — see `_lp_mat_all_finite`. Without this, [[+Inf,0],[0,1]] returned
    # HSB_ERR_NONE with BOTH eigenvalues NaN. Repaired together with the SVD's copy
    # rather than only where it was first measured: a guard applied to one of a
    # pair is how 2.18.0's U-replay defect was created.
    # [measured: +Inf / -Inf / NaN probes through eigen_qr, 2026-09-11]
    if (_lp_mat_all_finite(A, n, n) == 0) { return Err(HSB_ERR_INVALID_INPUT); }

    if (n == 1) {
        store64(out_vals, ganita_mat_get(A, 0, 0));
        ganita_mat_set(out_vecs, 0, 0, F64_ONE);
        return Ok(0);
    }

    # Step 1: Householder tridiagonalization
    var diag = _lp_vec_new(n);
    var offdiag = _lp_vec_new(n);

    # Balance first; see svd_golub_kahan. The Wilkinson shift squares the
    # offdiagonal (e2sq = e2*e2), so this overflowed at 1e200 exactly as the
    # Householder norm did.
    # ⭐ 2.22.1 — two-ended, matching the SVD. Repairing one of a pair is how
    # 2.18.0's U-replay defect was created; `_lp_balance_scale` carries the
    # reasoning and the figures.
    # [measured: see _lp_balance_scale, 3 fixtures x 52 scales, 2026-09-11]
    var sc = _lp_balance_scale(A, n, n);
    var As = _lp_mat_div_scalar(A, sc);
    if (As == 0) { return Err(HSB_ERR_ALLOC); }

    var err = _lp_tridiagonalize(As, n, diag, offdiag, out_vecs)?;

    # Step 2: Implicit QR iteration on tridiagonal
    var err_qr = _lp_tridiag_qr(diag, offdiag, n, out_vecs, max_iter)?;

    # Undo the balancing: eig(c*A) = c*eig(A), eigenvectors invariant.
    var ev_i = 0;
    while (ev_i < n) {
        store64(diag + ev_i * 8, f64_mul(sc, load64(diag + ev_i * 8)));
        ev_i = ev_i + 1;
    }

    # Step 3: Copy eigenvalues, sort by descending magnitude
    # First, copy raw eigenvalues
    _lp_vec_copy(out_vals, diag, n);

    # Selection sort by descending |eigenvalue|
    var i = 0;
    while (i < n) {
        var max_idx = i;
        var max_abs = f64_abs(load64(out_vals + i * 8));
        var j = i + 1;
        while (j < n) {
            var aj = f64_abs(load64(out_vals + j * 8));
            if (f64_gt(aj, max_abs) == 1) {
                max_abs = aj;
                max_idx = j;
            }
            j = j + 1;
        }
        if (max_idx != i) {
            # Swap eigenvalues
            var tmp = load64(out_vals + i * 8);
            store64(out_vals + i * 8, load64(out_vals + max_idx * 8));
            store64(out_vals + max_idx * 8, tmp);
            # Swap eigenvector columns in out_vecs
            var k = 0;
            while (k < n) {
                var tv = ganita_mat_get(out_vecs, k, i);
                ganita_mat_set(out_vecs, k, i, ganita_mat_get(out_vecs, k, max_idx));
                ganita_mat_set(out_vecs, k, max_idx, tv);
                k = k + 1;
            }
        }
        i = i + 1;
    }

    return Ok(0);
}

# ================================================================
# Section 3 -- Complex QR decomposition
# ================================================================
#
# cqr_decompose(A, out_Q, out_R) -> error code
#
# A:     complex matrix (cmat_new, m x n). ANY m, n -- see the shape note below.
# out_Q: complex matrix (m x m, caller allocates) -- SHAPE ENFORCED.
# out_R: complex matrix (m x n, caller allocates) -- SHAPE ENFORCED.
# Returns: HSB_ERR_NONE on success, HSB_ERR_INVALID_INPUT on a null handle or an
#          out_Q / out_R that is not sized exactly m x m / m x n.
#
# Uses Householder reflectors in complex space:
#   H = I - (2 / v^H v) * v * v^H
# where v = x + sign(x1)*||x||*e1, with sign chosen for numerical stability.

#must_use
fn cqr_decompose(A, out_Q, out_R) {
    # NULL HANDLES. cmat_rows(0) is load64(0). Each of the three may be the
    # designed 0 that cmat_new returns for a non-positive dimension or above
    # _CMAT_MAX_ELEMS, so cqr_decompose(cmat_new(100000, 100000), ...) -- a call
    # that looks like it allocated -- SIGSEGV'd through 2.8.4 (exit 139, measured).
    if (A == 0 || out_Q == 0) { return Err(HSB_ERR_INVALID_INPUT); }
    if (out_R == 0) { return Err(HSB_ERR_INVALID_INPUT); }

    var m = cmat_rows(A);
    var n = cmat_cols(A);
    if (m <= 0 || n <= 0) { return Err(HSB_ERR_INVALID_INPUT); }

    # THE OUTPUT SHAPES ARE NOW CHECKED, NOT JUST DOCUMENTED.
    #
    # This was the canary overwrite. The copy loop below walks i < m, j < n and
    # calls cmat_set(out_R, i, j), and cmat_set computes its offset from out_R's
    # OWN column count -- so when the caller sized out_R m x m for what it assumed
    # was a square decomposition, every j >= m stored past the end of out_R's data
    # buffer and the routine still returned HSB_ERR_NONE. Measured on a 2x3 A into
    # a 2x2 out_R: rc = HSB_ERR_NONE with 2 of 8 guard slots -- the 16 bytes
    # immediately after out_R's buffer -- overwritten; the square 2x2 control over
    # the same code path clobbered 0.
    #
    # The ALGORITHM is not the problem: Householder QR is general in m and n
    # (min_mn = min(m, n) reflectors), and with out_R correctly sized m x n it is
    # measurably right for both shapes -- Q*R == A, Q^H Q == I and R upper
    # trapezoidal to < 1e-8 on a wide 2x3 and a tall 4x2. So the rectangular case
    # is HANDLED, not rejected; what is rejected is the caller handing over
    # out-buffers that are not the documented size, because there is nowhere to
    # put an m x n R inside an m x m allocation.
    if (cmat_rows(out_Q) != m || cmat_cols(out_Q) != m) { return Err(HSB_ERR_INVALID_INPUT); }
    if (cmat_rows(out_R) != m || cmat_cols(out_R) != n) { return Err(HSB_ERR_INVALID_INPUT); }

    # Balance on the way into out_R; undo it on R at the end. Q is invariant under
    # a positive rescale of A. Unbalanced, ||v||^2 = Inf made cx_abs(x1) = Inf,
    # phase = cx_div(x1, Inf) = NaN and v^H v = NaN, so the f64_gt(vhv, EPSILON)
    # guard was false and EVERY reflector was skipped: at 1e200 this returned
    # HSB_ERR_NONE with Q = I and R = A -- R not even upper triangular.
    var sc = _lp_pow2_floor(_lp_cmat_max_abs(A));

    # Copy A into out_R
    var i = 0;
    while (i < m) {
        var j = 0;
        while (j < n) {
            var aij = cmat_get(A, i, j);
            cmat_set(out_R, i, j, cx_new(f64_div(HComplex_re(aij), sc),
                f64_div(HComplex_im(aij), sc)));
            j = j + 1;
        }
        i = i + 1;
    }

    # Initialize out_Q to m x m identity
    i = 0;
    while (i < m) {
        var j = 0;
        while (j < m) {
            if (i == j) {
                cmat_set(out_Q, i, j, cx_one());
            } else {
                cmat_set(out_Q, i, j, cx_zero());
            }
            j = j + 1;
        }
        i = i + 1;
    }

    var min_mn = m;
    if (n < min_mn) { min_mn = n; }

    # Reflector scratch, HOISTED out of the k loop (2026-08-04 audit, performance).
    # `len` is m - k, so the k = 0 pass needs the largest buffer and every later
    # pass fits inside it; only the leading `len` slots are ever read. The arena is
    # a bump allocator that never frees, so the per-iteration alloc cost
    # sum(m-k)*16 = 16*m*(m+1)/2 bytes per call -- 33,280 B on a 64x64, against
    # 1,024 B for this single allocation. Measured per cqr_decompose(64x64) call:
    # 32,942,104 B of arena before, 32,909,848 B after (-32,256 B). That is only
    # -0.098% of the call's total, because the bulk is cx_new's 16 B per complex
    # temporary inside the O(m^2 n) reflector application -- a separate problem
    # this hoist does not claim to solve.
    var vbuf = alloc(m * 16);
    if (vbuf == 0) { return Err(HSB_ERR_ALLOC); }

    var k = 0;
    while (k < min_mn) {
        var len = m - k;

        # Extract column k below diagonal as complex vector (flat: len * 16 bytes)
        var v = vbuf;
        i = 0;
        while (i < len) {
            var elem = cmat_get(out_R, k + i, k);
            store64(v + i * 16, HComplex_re(elem));
            store64(v + i * 16 + 8, HComplex_im(elem));
            i = i + 1;
        }

        # Compute ||v|| (real-valued 2-norm)
        # ⛔ 2.22.0 — THE COMPLEX THIRD OF THE SAME PAIR. `cqr_decompose` carries
        # its own inlined norm rather than calling `_lp_vec_norm`, so repairing
        # that helper does not reach here — this is the site a repair applied only
        # where it was MEASURED would have left behind, and this project's rule is
        # that a class is sized by the grep, not by the fixtures that happened to
        # fire. ⚠ Unlike :270/:341/:1119 this one is NOT measured end-to-end; it is
        # repaired on the SHAPE, and that is stated rather than implied.
        # ⭐ Scaled by the largest component first, for the same reason
        # `_lp_vec_norm` now is: `re*re + im*im` summed naively flushes to zero
        # below 2^-537 and overflows above 2^511, so the gate below would see a
        # zero norm for a perfectly good vector.
        # [measured: shape-only; :270/:341/:1119 measured end-to-end, 2026-09-11]
        var nrm_mx = f64_from(0);
        i = 0;
        while (i < len) {
            var mre = f64_abs(load64(v + i * 16));
            var mim = f64_abs(load64(v + i * 16 + 8));
            if (f64_gt(mre, nrm_mx) == 1) { nrm_mx = mre; }
            if (f64_gt(mim, nrm_mx) == 1) { nrm_mx = mim; }
            i = i + 1;
        }
        var norm = f64_from(0);
        if (f64_gt(nrm_mx, 0) == 1) {
            if (f64_eq(nrm_mx, F64_POS_INF) == 1) {
                norm = nrm_mx;
            } else {
                var norm_sq = f64_from(0);
                i = 0;
                while (i < len) {
                    # ⚠ Divide, never multiply by a reciprocal: 1/subnormal is +Inf
                    # and 0 * Inf is NaN.
                    var re = f64_div(load64(v + i * 16), nrm_mx);
                    var im = f64_div(load64(v + i * 16 + 8), nrm_mx);
                    norm_sq = f64_add(norm_sq, f64_add(f64_mul(re, re), f64_mul(im, im)));
                    i = i + 1;
                }
                norm = f64_mul(nrm_mx, f64_sqrt(norm_sq));
            }
        }

        # ⛔ 2.22.0 — was an absolute 1e-12 on a degree-ONE norm; same repair and
        # same reason as the three real reflector gates. See :270.
        if (f64_gt(norm, 0) == 1) {
            # Complex sign: sign(x1) = x1 / |x1| if x1 != 0, else 1
            var x1 = cx_new(load64(v), load64(v + 8));
            var phase = cx_one();
            # ⛔ 2.22.0 — an absolute 1e-12 decided whether a PHASE was computed at
            # all, and the fallback was phase = 1, so a small-but-perfectly-good x1
            # got the WRONG phase rather than no phase.
            # ⛔ 2.23.0 — AND THE REPAIR FOR THAT OPENED A SECOND DEFECT, WHICH IS
            # WHY THE SCALING BELOW EXISTS. `cx_div(x1, |x1|)` is only as good as
            # `cx_abs(x1)`, and for a SUBNORMAL x1 that modulus has been quantised
            # onto the subnormal grid — so the quotient is not a unit complex
            # number. The Householder identity needs |phase| EXACTLY 1 and degrades
            # in proportion to ||phase| - 1|: measured, |phase| - 1 reaches
            # **+0.414 at x1 = 2^-1074** (cx_div returns (1,1)), and the end-to-end
            # residual ‖QR - A‖/‖A‖ tracks it — 2.3e-11 at 2^-1040, 2.4e-05 at
            # 2^-1060, 4.7e-01 at the floor, all with rc = HSB_ERR_NONE.
            # ⚠ 2.21.0's phase = 1 fallback was ACCIDENTALLY EXACT in that band,
            # so 2.22.0 traded 1 row right for **38 rows wrong**. A repair measured
            # only where it was aimed is how that shipped.
            # ⭐ Scale x1 to O(1) by its own largest component before forming the
            # phase. The phase is scale-INVARIANT by definition, so this changes
            # nothing above the subnormal band and restores |phase| = 1 to 2.2e-16
            # inside it. Powers of two are not required — any exact division by a
            # component of x1 leaves the ratio intact.
            # ⚠ A fixture built from an exact Pythagorean triple CANNOT see this:
            # x1 = (3,4)*2^-e is clean at every e because |x1| = 5*2^-e is exactly
            # representable. The direction has to be one whose modulus is off the
            # grid — the acceptance test uses (1,1).
            # [measured: 1075-row phase sweep, 3 trees + an isolating revert, 2026-09-11]
            var px = f64_abs(HComplex_re(x1));
            var py = f64_abs(HComplex_im(x1));
            var pmx = px;
            if (f64_gt(py, pmx) == 1) { pmx = py; }
            if (f64_gt(pmx, 0) == 1) {
                var xs = cx_new(f64_div(HComplex_re(x1), pmx), f64_div(HComplex_im(x1), pmx));
                var abs_xs = cx_abs(xs);
                if (f64_gt(abs_xs, 0) == 1) {
                    phase = cx_div(xs, cx_real(abs_xs));
                }
            }
            var abs_x1 = cx_abs(x1);

            # v[0] += phase * ||v||
            var shift = cx_scale(phase, norm);
            var new_v0 = cx_add(x1, shift);
            store64(v, HComplex_re(new_v0));
            store64(v + 8, HComplex_im(new_v0));

            # ⛔ 2.23.0 — THE FOURTH REFLECTOR, AND 2.22.1 REPAIRED ONLY THREE.
            # That release normalised `v` in `_lp_bidiagonalize` (both sides) and
            # `_lp_tridiagonalize` so `vtv` is 1 by construction; this complex one
            # kept the naive sum and therefore kept the defect. For
            # `diag(1) (+) c*[[3,1],[4,2]]` the k=1 reflector's v is (8c, 4c), so
            # vhv = 80c², which falls below DBL_MIN at **c = 2^-515** — measured
            # boundary e=514 correct, e=515 wrong, and the coefficient predicts it:
            # 80*2^-1028 > DBL_MIN > 80*2^-1030. Blocks with vhv = 468c² and
            # 0.3125c² first fail at e=516 and e=511, exactly as their coefficients
            # dictate, which is causal isolation rather than correlation.
            # ⛔ THE FAILURE IS INVISIBLE TO THE TWO TESTS A CALLER WOULD RUN.
            # With the reflector skipped, R == A, so `max|QR - A|/max|A|` and
            # `max|Q^H Q - I|` are both **exactly 0** — Q is the identity and the
            # product is trivially A. The only visible symptom is that R is not
            # upper triangular, which is the one thing QR is FOR.
            # ⭐ Same repair as the other three: `H = I - 2vv^H/v^H v` is
            # identically `I - 2uu^H` for `u = v/||v||`, and `||v||` here is the
            # scaled norm 2.22.0 gave this routine, so nothing underflows.
            # [measured: 1075-binade sweep x 3 fixtures, 3 trees, 2026-09-11]
            var nv_c = f64_from(0);
            i = 0;
            while (i < len) {
                var cre = f64_abs(load64(v + i * 16));
                var cim = f64_abs(load64(v + i * 16 + 8));
                if (f64_gt(cre, nv_c) == 1) { nv_c = cre; }
                if (f64_gt(cim, nv_c) == 1) { nv_c = cim; }
                i = i + 1;
            }
            if (f64_gt(nv_c, 0) == 1) {
                if (f64_lt(nv_c, F64_POS_INF) == 1) {
                    i = 0;
                    while (i < len) {
                        store64(v + i * 16, f64_div(load64(v + i * 16), nv_c));
                        store64(v + i * 16 + 8, f64_div(load64(v + i * 16 + 8), nv_c));
                        i = i + 1;
                    }
                }
            }

            # Compute v^H * v (real, since it's a norm squared)
            var vhv = f64_from(0);
            i = 0;
            while (i < len) {
                var re = load64(v + i * 16);
                var im = load64(v + i * 16 + 8);
                vhv = f64_add(vhv, f64_add(f64_mul(re, re), f64_mul(im, im)));
                i = i + 1;
            }

            # ⛔ Same class in the complex QR: v^H v against an absolute 1e-12.
            if (f64_lt(vhv, F64_TINY) == 0) {
                var two_over_vhv = f64_div(F64_TWO, vhv);

                # Apply H to out_R: R[k:m, k:n] -= (2/vHv) * v * (v^H * R[k:m, k:n])
                var j = k;
                while (j < n) {
                    # dot = v^H * R[:, j] (complex dot product with conjugate of v)
                    var dot = cx_zero();
                    i = 0;
                    while (i < len) {
                        var vi_conj = cx_conj(cx_new(load64(v + i * 16),
                            load64(v + i * 16 + 8)));
                        var rij = cmat_get(out_R, k + i, j);
                        dot = cx_add(dot, cx_mul(vi_conj, rij));
                        i = i + 1;
                    }
                    var coeff = cx_scale(dot, two_over_vhv);
                    i = 0;
                    while (i < len) {
                        var vi = cx_new(load64(v + i * 16), load64(v + i * 16 + 8));
                        var rij = cmat_get(out_R, k + i, j);
                        cmat_set(out_R, k + i, j, cx_sub(rij, cx_mul(coeff, vi)));
                        i = i + 1;
                    }
                    j = j + 1;
                }

                # Apply H to out_Q: Q[k:m, :] -= (2/vHv) * v * (v^H * Q[k:m, :])
                # We accumulate Q^H, then transpose at the end.
                j = 0;
                while (j < m) {
                    var dot = cx_zero();
                    i = 0;
                    while (i < len) {
                        var vi_conj = cx_conj(cx_new(load64(v + i * 16),
                            load64(v + i * 16 + 8)));
                        var qij = cmat_get(out_Q, k + i, j);
                        dot = cx_add(dot, cx_mul(vi_conj, qij));
                        i = i + 1;
                    }
                    var coeff = cx_scale(dot, two_over_vhv);
                    i = 0;
                    while (i < len) {
                        var vi = cx_new(load64(v + i * 16), load64(v + i * 16 + 8));
                        var qij = cmat_get(out_Q, k + i, j);
                        cmat_set(out_Q, k + i, j, cx_sub(qij, cx_mul(coeff, vi)));
                        i = i + 1;
                    }
                    j = j + 1;
                }
            }
        }

        k = k + 1;
    }

    # Undo the balancing on R: A/sc = Q*R implies A = Q*(sc*R).
    i = 0;
    while (i < m) {
        var j = 0;
        while (j < n) {
            cmat_set(out_R, i, j, cx_scale(cmat_get(out_R, i, j), sc));
            j = j + 1;
        }
        i = i + 1;
    }

    # ⭐ 2.23.0 — R IS UPPER TRIANGULAR BY CONTRACT, NOT BY CANCELLATION. The
    # reflectors annihilate the sub-diagonal analytically, but they do it in
    # floating point, so what lands there is whatever the rounding leaves. Through
    # 2.22.1 that happened to cancel to a bit-exact 0 on the fixtures anyone had
    # run; normalising `v` (above) adds one rounding per component and it no longer
    # does — measured, |R[2][1]| becomes ~7e-16 RELATIVE TO THE BLOCK, i.e. one ulp,
    # on 5 of the 9 decades the existing sweep covers.
    # ⚠ That is a rounding change, NOT a correctness regression — but "R is upper
    # triangular" is the defining property of a QR decomposition and the thing
    # `cqr_decompose`'s own tests assert, so it should be TRUE rather than nearly
    # true. Zeroing the strictly-lower triangle makes it exact by construction and
    # costs one O(m*n) pass on an O(m*n^2) routine.
    # ⚠ It also removes a whole class of "is it exactly zero?" question from every
    # future fixture — and this release exists because the answer to that question
    # had been "yes, by luck" and nobody knew.
    # [measured: 9-decade decimal sweep, |R21|/c = 6.9e-16 .. 8.5e-16, 2026-09-11]
    i = 0;
    while (i < m) {
        var jz = 0;
        while (jz < n) {
            if (jz < i) { cmat_set(out_R, i, jz, cx_zero()); }
            jz = jz + 1;
        }
        i = i + 1;
    }

    # Q has accumulated H_k ... H_1. Take conjugate transpose to get Q where A = QR.
    var Qt = cmat_adjoint(out_Q);
    i = 0;
    while (i < m) {
        var j = 0;
        while (j < m) {
            cmat_set(out_Q, i, j, cmat_get(Qt, i, j));
            j = j + 1;
        }
        i = i + 1;
    }

    return Ok(0);
}
