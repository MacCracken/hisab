# linalg_precision.cyr -- precision linear algebra algorithms
# Usage: include "lib/linalg_precision.cyr"
# Requires: alloc.cyr, math.cyr, matrix.cyr, linalg.cyr, complex.cyr, error.cyr
#
# Higher-precision replacements for linalg.cyr's SVD and eigendecomposition:
#
#   svd_golub_kahan   -- Golub-Kahan bidiagonalization + implicit QR iteration
#                       (replaces A^T*A eigendecomposition which squares cond #)
#
#   eigen_qr          -- Householder tridiagonalization + implicit symmetric QR
#                       with Wilkinson shift, O(n^3) vs Jacobi's O(n^5)
#
#   cqr_decompose     -- Householder QR for complex matrices
#
# All functions use out-params and return error codes
# (HSB_ERR_NONE / HSB_ERR_NO_CONVERGENCE / HSB_ERR_ALLOC).

# ================================================================
# Internal helpers
# ================================================================

# Compute sign of an f64 value: +1.0 if x >= 0, -1.0 if x < 0
fn _lp_sign(x) {
    if (f64_lt(x, f64_from(0)) == 1) {
        return f64_neg(F64_ONE);
    }
    return F64_ONE;
}

# Compute the 2-norm of a segment of a flat f64 array
# arr: pointer to f64 array, start: starting index, len: number of elements
fn _lp_vec_norm(arr, start, len) {
    var sum = f64_from(0);
    var i = 0;
    while (i < len) {
        var v = load64(arr + (start + i) * 8);
        sum = f64_add(sum, f64_mul(v, v));
        i = i + 1;
    }
    return f64_sqrt(sum);
}

# Allocate a zero-filled flat f64 array of length n
# Balancing helpers (2.7.0). EVERY step of these decompositions squares matrix
# entries -- the Householder norms in _lp_bidiagonalize/_lp_tridiagonalize, and the
# Wilkinson shifts, which form entries of B^T*B explicitly. |x| > 1.34e154 squares
# to +Inf and |x| < 1.49e-154 squares to 0, so the usable band was only about
# 1 .. 1e23: measured across 440 random matrices, svd_golub_kahan failed 40/40 at
# scale 1e-10 on a relative reconstruction check. Balancing to unit max magnitude
# first also converts the ABSOLUTE EpsilonF64 deflation thresholds into relative
# ones, which is what fixes the small-magnitude half.
#
# NOTE: these _lp_* internals are NOT individually overflow-safe. They are only
# sound when reached through the balanced public entry points below.

# Largest |entry| of a stdlib matrix (0 for the zero matrix).
fn _lp_mat_max_abs(A) {
    var total = mat_rows(A) * mat_cols(A);
    var mx = f64_from(0);
    var i = 0;
    while (i < total) {
        var a = f64_abs(load64(A + 16 + i * 8));
        if (f64_gt(a, mx) == 1) { mx = a; }
        i = i + 1;
    }
    return mx;
}

# Round a positive scale DOWN to a power of two. Dividing and re-multiplying by
# 2^e is EXACT, so balancing costs zero rounding and unit-scale results stay
# bit-identical to what shipped before this change.
fn _lp_pow2_floor(s) {
    var e = s & 0x7FF0_0000_0000_0000;
    if (e == 0) { return F64_ONE; }
    return e;
}

# Fresh copy of A with every entry divided by s (s > 0). Divide, never multiply
# by 1/s: a subnormal s makes 1/s overflow to +Inf.
fn _lp_mat_div_scalar(A, s) {
    var B = mat_copy(A);
    if (B == 0) { return 0; }
    var total = mat_rows(A) * mat_cols(A);
    var i = 0;
    while (i < total) {
        store64(B + 16 + i * 8, f64_div(load64(B + 16 + i * 8), s));
        i = i + 1;
    }
    return B;
}

# Largest |re| or |im| over a complex matrix (0 for the zero matrix).
fn _lp_cmat_max_abs(A) {
    var rows = cmat_rows(A);
    var cols = cmat_cols(A);
    var mx = f64_from(0);
    var i = 0;
    while (i < rows) {
        var j = 0;
        while (j < cols) {
            var z = cmat_get(A, i, j);
            var a = f64_abs(HComplex_re(z));
            if (f64_gt(a, mx) == 1) { mx = a; }
            a = f64_abs(HComplex_im(z));
            if (f64_gt(a, mx) == 1) { mx = a; }
            j = j + 1;
        }
        i = i + 1;
    }
    return mx;
}

fn _lp_vec_new(n) {
    var v = alloc(n * 8);
    var i = 0;
    while (i < n) {
        store64(v + i * 8, f64_from(0));
        i = i + 1;
    }
    return v;
}

# Copy flat f64 array: dst[0..n) = src[0..n)
fn _lp_vec_copy(dst, src, n) {
    var i = 0;
    while (i < n) {
        store64(dst + i * 8, load64(src + i * 8));
        i = i + 1;
    }
    return 0;
}

# Copy matrix data: dst = src (same dimensions assumed)
fn _lp_mat_copy_into(dst, src) {
    var n = mat_rows(src) * mat_cols(src);
    var i = 0;
    while (i < n) {
        store64(dst + 16 + i * 8, load64(src + 16 + i * 8));
        i = i + 1;
    }
    return 0;
}

# ================================================================
# Section 1 -- Golub-Kahan SVD
# ================================================================
#
# svd_golub_kahan(A, out_U, out_S, out_Vt) -> error code
#
# A:      stdlib matrix (m x n, m >= n).
# out_U:  stdlib matrix (m x n, caller allocates).
# out_S:  flat f64 array of length n (caller allocates, receives singular values).
# out_Vt: stdlib matrix (n x n, caller allocates).
# Returns: HSB_ERR_NONE on success, HSB_ERR_NO_CONVERGENCE if QR iteration
#          fails, HSB_ERR_ALLOC if the balancing copy fails.
# A is balanced to unit max magnitude before decomposing and rescaled on the way
# out; the balance uses a power-of-two divisor, so it is exact..
#
# Algorithm:
#   Step 1: Householder bidiagonalization  A = U1 * B * V1^T
#   Step 2: Implicit QR iteration on bidiagonal B for singular values
#   Step 3: Accumulate singular vectors into U and Vt

# Step 1a: Householder bidiagonalization
# Reduces m x n matrix (m >= n) to upper bidiagonal form.
# On return:
#   - diag[0..n):   main diagonal of B
#   - superdiag[0..n-1): superdiagonal of B
#   - U_acc:  m x n orthogonal matrix (left Householder product)
#   - Vt_acc: n x n orthogonal matrix (right Householder product transposed)
fn _lp_bidiagonalize(A, m, n, diag, superdiag, U_acc, Vt_acc) {
    # Work on a copy of A
    var W = mat_copy(A);

    # Initialize U_acc to m x n slice of identity
    var i = 0;
    while (i < m * n) {
        store64(U_acc + 16 + i * 8, f64_from(0));
        i = i + 1;
    }
    i = 0;
    while (i < n) {
        mat_set(U_acc, i, i, F64_ONE);
        i = i + 1;
    }

    # Initialize Vt_acc to n x n identity
    i = 0;
    while (i < n * n) {
        store64(Vt_acc + 16 + i * 8, f64_from(0));
        i = i + 1;
    }
    i = 0;
    while (i < n) {
        mat_set(Vt_acc, i, i, F64_ONE);
        i = i + 1;
    }

    # Storage for the left Householder reflectors, so U can be accumulated in
    # REVERSE afterwards. A = H_0*H_1*...*H_{n-1} * B * (right reflectors), so
    # U = H_0*H_1*...*H_{n-1}. Applying them to the identity in FORWARD order —
    # which is what this loop did through 2.6.12 — builds H_{n-1}*...*H_0, the
    # transpose, so `A != U*S*Vt` while `A == U^T*B*Vt` held. (Vt_acc is
    # unaffected: V^T is literally G_{n-1}*...*G_0, so forward order is correct
    # there, which is why S and Vt were right and only U was wrong.)
    # v_k has length m-k and lives at lv_store[k*m ...]; lv_tv[k] == 0 means the
    # reflector was skipped for that k.
    var lv_store = _lp_vec_new(m * n);
    var lv_tv = _lp_vec_new(n);

    var k = 0;
    while (k < n) {
        # ---- Left Householder: zero out column k below diagonal ----
        var len_l = m - k;
        var v_l = _lp_vec_new(len_l);

        # Extract column k, rows k..m
        i = 0;
        while (i < len_l) {
            store64(v_l + i * 8, mat_get(W, k + i, k));
            i = i + 1;
        }

        var norm_l = _lp_vec_norm(v_l, 0, len_l);
        if (f64_gt(norm_l, EPSILON_F64) == 1) {
            var v0 = load64(v_l);
            var sgn = _lp_sign(v0);
            # v[0] += sign(v[0]) * ||v||
            store64(v_l, f64_add(v0, f64_mul(sgn, norm_l)));

            # Compute vTv for normalization
            var vtv = f64_from(0);
            i = 0;
            while (i < len_l) {
                var vi = load64(v_l + i * 8);
                vtv = f64_add(vtv, f64_mul(vi, vi));
                i = i + 1;
            }

            if (f64_gt(vtv, EPSILON_F64) == 1) {
                var two_over_vtv = f64_div(F64_TWO, vtv);

                # Apply H_l to W: W[k:m, k:n] -= (2/vTv) * v * (v^T * W[k:m, k:n])
                var j = k;
                while (j < n) {
                    # dot = v^T * W[k:m, j]
                    var dot = f64_from(0);
                    i = 0;
                    while (i < len_l) {
                        dot = f64_add(dot, f64_mul(load64(v_l + i * 8),
                            mat_get(W, k + i, j)));
                        i = i + 1;
                    }
                    var coeff = f64_mul(two_over_vtv, dot);
                    i = 0;
                    while (i < len_l) {
                        var wij = mat_get(W, k + i, j);
                        mat_set(W, k + i, j,
                          f64_sub(wij, f64_mul(coeff, load64(v_l + i * 8))));
                        i = i + 1;
                    }
                    j = j + 1;
                }

                # Save this reflector; U is accumulated in reverse after the loop.
                store64(lv_tv + k * 8, vtv);
                i = 0;
                while (i < len_l) {
                    store64(lv_store + (k * m + i) * 8, load64(v_l + i * 8));
                    i = i + 1;
                }
            }
        }

        # ---- Right Householder: zero out row k to the right of superdiagonal ----
        if (k < n - 2) {
            var len_r = n - k - 1;
            var v_r = _lp_vec_new(len_r);

            # Extract row k, cols (k+1)..n
            i = 0;
            while (i < len_r) {
                store64(v_r + i * 8, mat_get(W, k, k + 1 + i));
                i = i + 1;
            }

            var norm_r = _lp_vec_norm(v_r, 0, len_r);
            if (f64_gt(norm_r, EPSILON_F64) == 1) {
                var r0 = load64(v_r);
                var sgn_r = _lp_sign(r0);
                store64(v_r, f64_add(r0, f64_mul(sgn_r, norm_r)));

                var vtv_r = f64_from(0);
                i = 0;
                while (i < len_r) {
                    var vi = load64(v_r + i * 8);
                    vtv_r = f64_add(vtv_r, f64_mul(vi, vi));
                    i = i + 1;
                }

                if (f64_gt(vtv_r, EPSILON_F64) == 1) {
                    var two_over_vtv_r = f64_div(F64_TWO, vtv_r);

                    # Apply H_r to W: W[k:m, (k+1):n] -= (2/vTv) * (W * v) * v^T
                    # i.e., for each row i of W[k:m, :]: row -= (2/vTv) * (row . v) * v^T
                    var ri = k;
                    while (ri < m) {
                        var dot = f64_from(0);
                        i = 0;
                        while (i < len_r) {
                            dot = f64_add(dot, f64_mul(mat_get(W, ri, k + 1 + i),
                                load64(v_r + i * 8)));
                            i = i + 1;
                        }
                        var coeff = f64_mul(two_over_vtv_r, dot);
                        i = 0;
                        while (i < len_r) {
                            var wij = mat_get(W, ri, k + 1 + i);
                            mat_set(W, ri, k + 1 + i,
                              f64_sub(wij, f64_mul(coeff, load64(v_r + i * 8))));
                            i = i + 1;
                        }
                        ri = ri + 1;
                    }

                    # Accumulate into Vt_acc: Vt_acc[(k+1):n, :] -= (2/vTv) * v * (v^T * Vt_acc)
                    var j = 0;
                    while (j < n) {
                        var dot = f64_from(0);
                        i = 0;
                        while (i < len_r) {
                            dot = f64_add(dot, f64_mul(load64(v_r + i * 8),
                                mat_get(Vt_acc, k + 1 + i, j)));
                            i = i + 1;
                        }
                        var coeff = f64_mul(two_over_vtv_r, dot);
                        i = 0;
                        while (i < len_r) {
                            var vtij = mat_get(Vt_acc, k + 1 + i, j);
                            mat_set(Vt_acc, k + 1 + i, j,
                              f64_sub(vtij, f64_mul(coeff, load64(v_r + i * 8))));
                            i = i + 1;
                        }
                        j = j + 1;
                    }
                }
            }
        }

        k = k + 1;
    }

    # ---- Backward accumulation of U ----
    # U = H_0 * H_1 * ... * H_{n-1}, so left-applying to the identity must run
    # from the LAST reflector to the first. Running it forward (as through 2.6.12)
    # produces the transpose and silently breaks A = U*S*Vt.
    k = n - 1;
    while (k >= 0) {
        var bvtv = load64(lv_tv + k * 8);
        if (f64_gt(bvtv, EPSILON_F64) == 1) {
            var blen = m - k;
            var btwo = f64_div(F64_TWO, bvtv);
            var bj = 0;
            while (bj < n) {
                var bdot = f64_from(0);
                i = 0;
                while (i < blen) {
                    bdot = f64_add(bdot, f64_mul(load64(lv_store + (k * m + i) * 8),
                        mat_get(U_acc, k + i, bj)));
                    i = i + 1;
                }
                var bcoeff = f64_mul(btwo, bdot);
                i = 0;
                while (i < blen) {
                    var buij = mat_get(U_acc, k + i, bj);
                    mat_set(U_acc, k + i, bj,
                      f64_sub(buij, f64_mul(bcoeff, load64(lv_store + (k * m + i) * 8))));
                    i = i + 1;
                }
                bj = bj + 1;
            }
        }
        k = k - 1;
    }

    # Extract bidiagonal entries from W
    i = 0;
    while (i < n) {
        store64(diag + i * 8, mat_get(W, i, i));
        i = i + 1;
    }
    i = 0;
    while (i < n - 1) {
        store64(superdiag + i * 8, mat_get(W, i, i + 1));
        i = i + 1;
    }

    return HSB_ERR_NONE;
}

# Split the active bidiagonal block at a negligible DIAGONAL entry.
#
# The implicit-shift step in _lp_bidiag_qr builds its first rotation from the
# pair (d[p_lo]^2 - mu, d[p_lo]*f[p_lo]). When d[p_lo] is zero that pair is
# (-mu, 0), whose rotation is a bare sign flip: the sweep reproduces the block
# unchanged and spins until max_iter, so svd_golub_kahan returns
# HSB_ERR_NO_CONVERGENCE with out_S never written. This is TYPICAL of, but not
# universal to, rank-deficient input: bidiagonalization can instead leave an
# exactly-zero SUPERdiagonal, which lets the outer deflation loop split the block
# before any zero diagonal sits inside an active one. Measured on the pre-fix
# code: 104 of 240 random rank-deficient matrices failed, but 60 of 60 did once
# columns were forced dependent. The rank-1 [[1,2,3],[2,4,6],[3,6,9]] bidiagonalizes to
# d = (-3.7417, 0, 0), f = (13.4907, 0), and one sweep drives it to
# d = (~1e-16, 0, 0), f = (-14, 0), which then repeats forever.
#
# A negligible d[k] means row k (for k < p_hi) or column p_hi (for k == p_hi)
# of the block is empty apart from one superdiagonal entry, and a chase of exact
# Givens rotations removes that entry outright -- splitting the block and
# deflating a singular value of exactly 0. This is the zero-diagonal case of
# Golub & Van Loan Alg. 8.6.2, omitted from the original transcription.
#
# Returns 1 if a split was performed (caller must restart the sweep), else 0.
fn _lp_split_zero_diag(diag, superdiag, n, m, U_acc, Vt_acc, p_lo, p_hi) {
    # The zero test must be RELATIVE to the block: a bare EPSILON_F64 would call
    # every entry of a 1e-20-scaled block zero and no entry of a 1e+20 one.
    var scale = f64_from(0);
    var i = p_lo;
    while (i <= p_hi) {
        var dv = f64_abs(load64(diag + i * 8));
        if (f64_gt(dv, scale) == 1) { scale = dv; }
        if (i < p_hi) {
            var fv = f64_abs(load64(superdiag + i * 8));
            if (f64_gt(fv, scale) == 1) { scale = fv; }
        }
        i = i + 1;
    }
    # NOTE: EPSILON_F64 is 1e-12, not machine epsilon (2.22e-16), so this snaps
    # any singular value below 1e-12 * ||B_block||_inf to exactly 0 where LAPACK's
    # dbdsqr would keep it. Probed at 1e-9 / 1e-11 / 1e-13: no regression -- at
    # 1e-13 the PRE-FIX code already returned NO_CONVERGENCE with S all zero, so
    # the fix is strictly better. Consistent with the deflation threshold above.
    var tol = f64_mul(EPSILON_F64, scale);

    var hit = (0 - 1);
    i = p_lo;
    while (i <= p_hi) {
        if (f64_lt(f64_abs(load64(diag + i * 8)), tol) == 1) {
            hit = i;
            break;
        }
        i = i + 1;
    }
    if (hit < 0) { return 0; }

    # Snap it to a hard zero first: both chases assume row `hit` (resp. column
    # p_hi) is empty, and a residual 1e-16 left there would be rotated into the
    # sub-diagonal and destroy the bidiagonal form.
    store64(diag + hit * 8, f64_from(0));

    if (hit < p_hi) {
        # Row `hit` holds only f[hit], at column hit+1. Rotate it away against
        # d[hit+1] (rows hit, hit+1); that pulls f[hit+1] into column hit+2 of
        # row `hit`, so the entry is chased one column right per rotation until
        # it falls off the end of the block.
        var carry = load64(superdiag + hit * 8);
        store64(superdiag + hit * 8, f64_from(0));
        var j = hit + 1;
        while (j <= p_hi) {
            var dj = load64(diag + j * 8);
            var r = f64_sqrt(f64_add(f64_mul(dj, dj), f64_mul(carry, carry)));
            if (f64_lt(r, tol) == 1) { break; }
            var cs = f64_div(dj, r);
            var sn = f64_div(carry, r);
            store64(diag + j * 8, r);
            if (j < p_hi) {
                var fj = load64(superdiag + j * 8);
                store64(superdiag + j * 8, f64_mul(cs, fj));
                carry = f64_mul(f64_neg(sn), fj);
            } else {
                carry = f64_from(0);
            }
            # Left rotation on rows (hit, j) of B == columns (hit, j) of U --
            # same G = [[cs, -sn], [sn, cs]] convention as the bulge chase.
            var t = 0;
            while (t < m) {
                var u0 = mat_get(U_acc, t, hit);
                var u1 = mat_get(U_acc, t, j);
                mat_set(U_acc, t, hit, f64_sub(f64_mul(cs, u0), f64_mul(sn, u1)));
                mat_set(U_acc, t, j, f64_add(f64_mul(sn, u0), f64_mul(cs, u1)));
                t = t + 1;
            }
            j = j + 1;
        }
        return 1;
    }

    # hit == p_hi: column p_hi holds only f[p_hi-1], at row p_hi-1. Rotate it
    # away against d[p_hi-1] (columns p_hi-1, p_hi); that pulls f[p_hi-2] into
    # row p_hi-2 of column p_hi, chasing the entry one row up per rotation.
    var ccarry = load64(superdiag + (p_hi - 1) * 8);
    store64(superdiag + (p_hi - 1) * 8, f64_from(0));
    var c = p_hi - 1;
    while (c >= p_lo) {
        var dc = load64(diag + c * 8);
        var r2 = f64_sqrt(f64_add(f64_mul(dc, dc), f64_mul(ccarry, ccarry)));
        if (f64_lt(r2, tol) == 1) { break; }
        var cs2 = f64_div(dc, r2);
        var sn2 = f64_div(f64_neg(ccarry), r2);
        store64(diag + c * 8, r2);
        if (c > p_lo) {
            var fc = load64(superdiag + (c - 1) * 8);
            store64(superdiag + (c - 1) * 8, f64_mul(cs2, fc));
            ccarry = f64_mul(sn2, fc);
        } else {
            ccarry = f64_from(0);
        }
        # Right rotation on columns (c, p_hi) of B == rows (c, p_hi) of Vt.
        var t2 = 0;
        while (t2 < n) {
            var v0 = mat_get(Vt_acc, c, t2);
            var v1 = mat_get(Vt_acc, p_hi, t2);
            mat_set(Vt_acc, c, t2, f64_sub(f64_mul(cs2, v0), f64_mul(sn2, v1)));
            mat_set(Vt_acc, p_hi, t2, f64_add(f64_mul(sn2, v0), f64_mul(cs2, v1)));
            t2 = t2 + 1;
        }
        c = c - 1;
    }
    return 1;
}

# Step 2: Implicit QR iteration on bidiagonal matrix for SVD.
# Operates on diag[0..n) and superdiag[0..n-1) in place.
# Accumulates Givens rotations into U_acc (m x n) and Vt_acc (n x n).
# max_iter: maximum total QR sweeps.
fn _lp_bidiag_qr(diag, superdiag, n, m, U_acc, Vt_acc, max_iter) {
    var iter = 0;
    var p_hi = n - 1;  # active submatrix upper bound

    while (p_hi > 0 && iter < max_iter) {
        # Check for negligible superdiagonal entries -- deflation
        var i = 0;
        while (i < p_hi) {
            var threshold = f64_mul(EPSILON_F64,
              f64_add(f64_abs(load64(diag + i * 8)),
                f64_abs(load64(diag + (i + 1) * 8))));
            if (f64_lt(f64_abs(load64(superdiag + i * 8)), threshold) == 1) {
                store64(superdiag + i * 8, f64_from(0));
            }
            i = i + 1;
        }

        # Find the largest q such that B[p_hi-q+1:p_hi, p_hi-q+1:p_hi] is diagonal
        # (i.e., superdiag entries at bottom are zero)
        var q = 0;
        while (q < p_hi) {
            if (f64_gt(f64_abs(load64(superdiag + (p_hi - 1 - q) * 8)),
                EPSILON_F64) == 1) {
                # Non-zero superdiag -- stop
                q = q;  # break equivalent
                p_hi = p_hi;  # no-op to avoid empty block
                # We need a break here -- use a flag
                q = q + p_hi;  # force exit
            } else {
                q = q + 1;
            }
        }
        # Undo the forced exit trick
        if (q >= p_hi) {
            # Check if we exited naturally (all zero) or forced
            if (q > p_hi) {
                q = q - p_hi;
            }
            # else q == p_hi means all superdiag zero -- fully converged
        }

        # Recalculate: find the bottom block where superdiag is zero
        # Simpler approach: find p_lo and p_hi for the active unreduced block
        # p_hi: largest index where superdiag[p_hi-1] != 0
        while (p_hi > 0 &&
          f64_lt(f64_abs(load64(superdiag + (p_hi - 1) * 8)), EPSILON_F64) == 1) {
            p_hi = p_hi - 1;
        }
        if (p_hi == 0) {
            # Fully converged
            p_hi = 0;  # will exit while loop
        } else {
            # Find p_lo: smallest index in the unreduced block
            var p_lo = p_hi - 1;
            while (p_lo > 0 &&
              f64_gt(f64_abs(load64(superdiag + (p_lo - 1) * 8)), EPSILON_F64) == 1) {
                p_lo = p_lo - 1;
            }

            # A zero diagonal entry inside the block makes the shifted step below
            # a no-op (see _lp_split_zero_diag), which is what rank-deficient
            # input typically produces. Split there instead and restart.
            if (_lp_split_zero_diag(diag, superdiag, n, m, U_acc, Vt_acc,
                p_lo, p_hi) == 1) {
                iter = iter + 1;
                continue;
            }

            # Wilkinson shift: eigenvalue of trailing 2x2 of B^T*B closer to d[p_hi]^2
            var d_end = load64(diag + p_hi * 8);
            var d_prev = load64(diag + (p_hi - 1) * 8);
            var f_end = load64(superdiag + (p_hi - 1) * 8);

            var a11 = f64_add(f64_mul(d_prev, d_prev),
              # If p_hi-2 >= p_lo, add superdiag[p_hi-2]^2
              f64_from(0));
            if (p_hi - 1 > p_lo) {
                var f_prev = load64(superdiag + (p_hi - 2) * 8);
                a11 = f64_add(f64_mul(d_prev, d_prev), f64_mul(f_prev, f_prev));
            } else {
                a11 = f64_mul(d_prev, d_prev);
            }
            var a12 = f64_mul(d_prev, f_end);
            var a22 = f64_add(f64_mul(d_end, d_end), f64_mul(f_end, f_end));

            # Eigenvalues of [[a11, a12], [a12, a22]]
            var tr = f64_add(a11, a22);
            var det = f64_sub(f64_mul(a11, a22), f64_mul(a12, a12));
            var disc = f64_sub(f64_mul(tr, tr), f64_mul(f64_from(4), det));
            if (f64_lt(disc, f64_from(0)) == 1) { disc = f64_from(0); }
            var sqrt_disc = f64_sqrt(disc);

            var mu1 = f64_mul(F64_HALF, f64_add(tr, sqrt_disc));
            var mu2 = f64_mul(F64_HALF, f64_sub(tr, sqrt_disc));

            # Pick eigenvalue closer to a22 (= d[p_hi]^2 + f[p_hi-1]^2)
            var mu = mu1;
            if (f64_lt(f64_abs(f64_sub(mu2, a22)),
                f64_abs(f64_sub(mu1, a22))) == 1) {
                mu = mu2;
            }

            # Golub-Kahan implicit QR step (chase the bulge)
            # Initial: apply Givens to first column of B^T*B - mu*I
            var y = f64_sub(f64_mul(load64(diag + p_lo * 8),
                load64(diag + p_lo * 8)), mu);
            var z = f64_mul(load64(diag + p_lo * 8),
              load64(superdiag + p_lo * 8));

            var k = p_lo;
            while (k < p_hi) {
                # Right Givens rotation to zero z (acts on columns k, k+1)
                var r = f64_sqrt(f64_add(f64_mul(y, y), f64_mul(z, z)));
                var cs = f64_div(y, r);
                var sn = f64_div(f64_neg(z), r);
                if (f64_lt(r, EPSILON_F64) == 1) {
                    cs = F64_ONE;
                    sn = f64_from(0);
                }

                # Apply right rotation to B (affects columns k, k+1)
                # Rows k-1 (if exists), k, k+1 (if exists) of bidiagonal
                if (k > p_lo) {
                    store64(superdiag + (k - 1) * 8, r);
                }

                var dk = load64(diag + k * 8);
                var fk = load64(superdiag + k * 8);
                var dk1 = load64(diag + (k + 1) * 8);

                var new_dk  = f64_add(f64_mul(cs, dk), f64_mul(f64_neg(sn), fk));
                var new_fk  = f64_add(f64_mul(sn, dk), f64_mul(cs, fk));
                var bulge   = f64_mul(f64_neg(sn), dk1);
                var new_dk1 = f64_mul(cs, dk1);

                store64(diag + k * 8, new_dk);
                store64(superdiag + k * 8, new_fk);
                store64(diag + (k + 1) * 8, new_dk1);

                # Accumulate right rotation into Vt_acc (rows k, k+1)
                var j = 0;
                while (j < n) {
                    var vk  = mat_get(Vt_acc, k, j);
                    var vk1 = mat_get(Vt_acc, k + 1, j);
                    mat_set(Vt_acc, k, j,
                      f64_add(f64_mul(cs, vk), f64_mul(f64_neg(sn), vk1)));
                    mat_set(Vt_acc, k + 1, j,
                      f64_add(f64_mul(sn, vk), f64_mul(cs, vk1)));
                    j = j + 1;
                }

                # Left Givens rotation to zero the bulge (acts on rows k, k+1)
                y = load64(diag + k * 8);
                z = bulge;
                r = f64_sqrt(f64_add(f64_mul(y, y), f64_mul(z, z)));
                cs = f64_div(y, r);
                sn = f64_div(f64_neg(z), r);
                if (f64_lt(r, EPSILON_F64) == 1) {
                    cs = F64_ONE;
                    sn = f64_from(0);
                }

                store64(diag + k * 8, r);

                # Update superdiag[k] and diag[k+1]
                var old_fk = load64(superdiag + k * 8);
                var old_dk1 = load64(diag + (k + 1) * 8);
                store64(superdiag + k * 8,
                  f64_add(f64_mul(cs, old_fk), f64_mul(f64_neg(sn), old_dk1)));
                store64(diag + (k + 1) * 8,
                  f64_add(f64_mul(sn, old_fk), f64_mul(cs, old_dk1)));

                # If not last step, compute new bulge
                if (k + 1 < p_hi) {
                    var fk1 = load64(superdiag + (k + 1) * 8);
                    y = load64(superdiag + k * 8);
                    # Actually y and z for next iteration
                    y = load64(superdiag + k * 8);
                    z = f64_mul(f64_neg(sn), fk1);
                    store64(superdiag + (k + 1) * 8, f64_mul(cs, fk1));
                } else {
                    y = f64_from(0);
                    z = f64_from(0);
                }

                # Accumulate left rotation into U_acc (columns k, k+1)
                j = 0;
                while (j < m) {
                    var uk  = mat_get(U_acc, j, k);
                    var uk1 = mat_get(U_acc, j, k + 1);
                    mat_set(U_acc, j, k,
                      f64_add(f64_mul(cs, uk), f64_mul(f64_neg(sn), uk1)));
                    mat_set(U_acc, j, k + 1,
                      f64_add(f64_mul(sn, uk), f64_mul(cs, uk1)));
                    j = j + 1;
                }

                k = k + 1;
            }

            iter = iter + 1;
        }
    }

    if (iter >= max_iter && p_hi > 0) {
        return HSB_ERR_NO_CONVERGENCE;
    }

    return HSB_ERR_NONE;
}

# Public: Golub-Kahan SVD
# A:      stdlib matrix (m x n, m >= n -- ENFORCED, see below).
# out_U:  stdlib matrix (m x n, caller allocates).
# out_S:  flat f64 array of length n (caller allocates).
# out_Vt: stdlib matrix (n x n, caller allocates).
# Returns: HSB_ERR_NONE on success, HSB_ERR_NO_CONVERGENCE on failure,
#          HSB_ERR_INVALID_INPUT if m < n or either dimension is non-positive.
fn svd_golub_kahan(A, out_U, out_S, out_Vt) {
    # Any of these may be the designed 0 that mat_new returns above its own
    # element cap; mat_rows(0) is a null dereference, so guard before reading dims.
    if (A == 0 || out_U == 0) { return HSB_ERR_INVALID_INPUT; }
    if (out_S == 0 || out_Vt == 0) { return HSB_ERR_INVALID_INPUT; }
    var m = mat_rows(A);
    var n = mat_cols(A);

    # THE m >= n PRECONDITION IS NOW CHECKED, NOT JUST DOCUMENTED.
    #
    # It was stated in the line above and enforced nowhere, so a wide matrix ran
    # the whole decomposition and returned HSB_ERR_NONE with numbers that are not
    # its singular values. This is not a marginal-accuracy story -- it is
    # structurally impossible for the documented output SHAPE to hold an SVD when
    # m < n, because out_U is m x n and a rank-m matrix cannot carry n orthonormal
    # columns. Measured on 200 random wide matrices (m = 2..4, n = m+1..m+2)
    # against the exact identity sum(sigma_i^2) == ||A||_F^2, which needs no
    # reference implementation: 200 of 200 violated it, silently. The same sweep
    # on 200 tall matrices violated it 0 times. B = [[2,0,0],[0,1,0]] returned
    # (2, 2, 1) where the true spectrum is (2, 1).
    #
    # Rejecting is the honest contract: the caller's out_U/out_Vt are sized for
    # the tall case, so there is nowhere to put a wide-case answer. A caller that
    # wants the SVD of a wide A should decompose A^T and swap U with V.
    if (m <= 0 || n <= 0) { return HSB_ERR_INVALID_INPUT; }
    if (m < n) { return HSB_ERR_INVALID_INPUT; }

    var max_iter = 30 * n * n;

    # Step 1: Bidiagonalize
    var diag = _lp_vec_new(n);
    var superdiag = _lp_vec_new(n);  # n-1 used, extra slot harmless

    # Balance to unit max magnitude before decomposing; undo it on the singular
    # values below. sv(c*A) = c*sv(A) for c > 0 and U/Vt are invariant, and the
    # power-of-two divisor makes both the divide and the un-scale exact.
    var sc = _lp_pow2_floor(_lp_mat_max_abs(A));
    var As = _lp_mat_div_scalar(A, sc);
    if (As == 0) { return HSB_ERR_ALLOC; }

    var err = _lp_bidiagonalize(As, m, n, diag, superdiag, out_U, out_Vt);
    if (err != HSB_ERR_NONE) { return err; }

    # Step 2: QR iteration on bidiagonal
    err = _lp_bidiag_qr(diag, superdiag, n, m, out_U, out_Vt, max_iter);
    if (err != HSB_ERR_NONE) { return err; }

    # Step 3: Make singular values non-negative; flip U column signs as needed
    var i = 0;
    while (i < n) {
        var sv = load64(diag + i * 8);
        if (f64_lt(sv, f64_from(0)) == 1) {
            store64(diag + i * 8, f64_neg(sv));
            # Flip sign of corresponding U column
            var j = 0;
            while (j < m) {
                mat_set(out_U, j, i, f64_neg(mat_get(out_U, j, i)));
                j = j + 1;
            }
        }
        i = i + 1;
    }

    # Step 4: Sort singular values in descending order (selection sort)
    i = 0;
    while (i < n) {
        var max_idx = i;
        var max_sv = load64(diag + i * 8);
        var j = i + 1;
        while (j < n) {
            if (f64_gt(load64(diag + j * 8), max_sv) == 1) {
                max_sv = load64(diag + j * 8);
                max_idx = j;
            }
            j = j + 1;
        }
        if (max_idx != i) {
            # Swap singular values
            var tmp = load64(diag + i * 8);
            store64(diag + i * 8, load64(diag + max_idx * 8));
            store64(diag + max_idx * 8, tmp);
            # Swap U columns i and max_idx
            var k = 0;
            while (k < m) {
                var tu = mat_get(out_U, k, i);
                mat_set(out_U, k, i, mat_get(out_U, k, max_idx));
                mat_set(out_U, k, max_idx, tu);
                k = k + 1;
            }
            # Swap Vt rows i and max_idx
            k = 0;
            while (k < n) {
                var tv = mat_get(out_Vt, i, k);
                mat_set(out_Vt, i, k, mat_get(out_Vt, max_idx, k));
                mat_set(out_Vt, max_idx, k, tv);
                k = k + 1;
            }
        }
        i = i + 1;
    }

    # Undo the balancing: sv(c*A) = c*sv(A), U and Vt are invariant.
    var sv_i = 0;
    while (sv_i < n) {
        store64(diag + sv_i * 8, f64_mul(sc, load64(diag + sv_i * 8)));
        sv_i = sv_i + 1;
    }

    # Copy singular values to output
    _lp_vec_copy(out_S, diag, n);

    return HSB_ERR_NONE;
}

# ================================================================
# Section 2 -- QR iteration for symmetric eigendecomposition
# ================================================================
#
# eigen_qr(A, n, max_iter, out_vals, out_vecs) -> error code
#
# A:        stdlib matrix (n x n, must be symmetric).
# n:        matrix dimension.
# max_iter: maximum QR iterations.
# out_vals: flat f64 array of length n (caller allocates, receives eigenvalues,
#           SORTED BY DESCENDING |lambda| -- step 3 below).
# out_vecs: stdlib matrix (n x n, caller allocates, receives eigenvectors as
#           columns, permuted alongside out_vals).
# Returns:  HSB_ERR_NONE on success, HSB_ERR_NO_CONVERGENCE if max_iter exceeded.
#
# The descending-|lambda| order has always been implemented here (the selection
# sort at the end of eigen_qr) but was never stated; the 2026-08-04 audit's
# api-consistency row recorded that eigen_symmetric returned a different,
# undocumented order for the same contract. Both are now documented AND sorted the
# same way -- eigen_symmetric (src/linalg_ext.cyr) was given this routine's sort.
#
# Algorithm:
#   Step 1: Householder tridiagonalization  A = Q * T * Q^T
#   Step 2: Implicit symmetric QR with Wilkinson shift on T
#   Step 3: Eigenvalues from diagonal of T, eigenvectors from accumulated Q,
#           then sorted by descending |lambda| with the columns carried along

# Step 1: Householder tridiagonalization of symmetric matrix
# A: n x n symmetric matrix.
# diag: flat f64 array of length n (receives main diagonal of T).
# offdiag: flat f64 array of length n (receives sub/superdiagonal; offdiag[0] unused).
# Q: n x n matrix (caller allocates, receives orthogonal transform).
fn _lp_tridiagonalize(A, n, diag, offdiag, Q) {
    # Work on a copy
    var W = mat_copy(A);

    # Initialize Q to identity
    var i = 0;
    var total = n * n;
    while (i < total) { store64(Q + 16 + i * 8, f64_from(0)); i = i + 1; }
    i = 0;
    while (i < n) { mat_set(Q, i, i, F64_ONE); i = i + 1; }

    var k = 0;
    while (k < n - 2) {
        # Extract column k below the subdiagonal: W[k+1..n, k]
        var len = n - k - 1;
        var v = _lp_vec_new(len);
        i = 0;
        while (i < len) {
            store64(v + i * 8, mat_get(W, k + 1 + i, k));
            i = i + 1;
        }

        var norm = _lp_vec_norm(v, 0, len);
        if (f64_gt(norm, EPSILON_F64) == 1) {
            var v0 = load64(v);
            var sgn = _lp_sign(v0);
            store64(v, f64_add(v0, f64_mul(sgn, norm)));

            # Normalize: vtv
            var vtv = f64_from(0);
            i = 0;
            while (i < len) {
                var vi = load64(v + i * 8);
                vtv = f64_add(vtv, f64_mul(vi, vi));
                i = i + 1;
            }

            if (f64_gt(vtv, EPSILON_F64) == 1) {
                var two_over_vtv = f64_div(F64_TWO, vtv);

                # Compute p = (2/vtv) * W[k+1:n, k+1:n] * v
                var p = _lp_vec_new(len);
                i = 0;
                while (i < len) {
                    var sum = f64_from(0);
                    var j = 0;
                    while (j < len) {
                        sum = f64_add(sum, f64_mul(mat_get(W, k + 1 + i, k + 1 + j),
                            load64(v + j * 8)));
                        j = j + 1;
                    }
                    store64(p + i * 8, f64_mul(two_over_vtv, sum));
                    i = i + 1;
                }

                # Compute K = (v^T * p) / 2 * (2/vtv) -- but simpler: K = v^T * p / 2
                var vtp = f64_from(0);
                i = 0;
                while (i < len) {
                    vtp = f64_add(vtp, f64_mul(load64(v + i * 8), load64(p + i * 8)));
                    i = i + 1;
                }
                var K = f64_mul(F64_HALF, f64_mul(two_over_vtv, vtp));

                # q = p - K * v
                var q = _lp_vec_new(len);
                i = 0;
                while (i < len) {
                    store64(q + i * 8, f64_sub(load64(p + i * 8),
                        f64_mul(K, load64(v + i * 8))));
                    i = i + 1;
                }

                # W[k+1:n, k+1:n] -= v*q^T + q*v^T  (symmetric update)
                i = 0;
                while (i < len) {
                    var j = 0;
                    while (j < len) {
                        var wij = mat_get(W, k + 1 + i, k + 1 + j);
                        var update = f64_add(
                          f64_mul(load64(v + i * 8), load64(q + j * 8)),
                          f64_mul(load64(q + i * 8), load64(v + j * 8)));
                        mat_set(W, k + 1 + i, k + 1 + j, f64_sub(wij, update));
                        j = j + 1;
                    }
                    i = i + 1;
                }

                # Update the tridiagonal entries in column/row k
                mat_set(W, k, k + 1, f64_neg(f64_mul(sgn, norm)));
                mat_set(W, k + 1, k, f64_neg(f64_mul(sgn, norm)));
                i = 2;
                while (i < len + 1) {
                    mat_set(W, k, k + i, f64_from(0));
                    mat_set(W, k + i, k, f64_from(0));
                    i = i + 1;
                }

                # Accumulate Q: Q[:, k+1:n] -= (2/vtv) * (Q[:, k+1:n] * v) * v^T
                var j = 0;
                while (j < n) {
                    var dot = f64_from(0);
                    i = 0;
                    while (i < len) {
                        dot = f64_add(dot, f64_mul(mat_get(Q, j, k + 1 + i),
                            load64(v + i * 8)));
                        i = i + 1;
                    }
                    var coeff = f64_mul(two_over_vtv, dot);
                    i = 0;
                    while (i < len) {
                        var qij = mat_get(Q, j, k + 1 + i);
                        mat_set(Q, j, k + 1 + i,
                          f64_sub(qij, f64_mul(coeff, load64(v + i * 8))));
                        i = i + 1;
                    }
                    j = j + 1;
                }
            }
        }

        k = k + 1;
    }

    # Extract tridiagonal entries
    i = 0;
    while (i < n) {
        store64(diag + i * 8, mat_get(W, i, i));
        i = i + 1;
    }
    i = 0;
    while (i < n - 1) {
        store64(offdiag + (i + 1) * 8, mat_get(W, i + 1, i));
        i = i + 1;
    }
    store64(offdiag, f64_from(0));

    return HSB_ERR_NONE;
}

# Step 2: Implicit symmetric QR iteration with Wilkinson shift on tridiagonal T.
# diag[0..n): main diagonal (modified in place to eigenvalues).
# offdiag[0..n): sub/superdiagonal (offdiag[i] = T[i,i-1], offdiag[0] = 0).
# Q: n x n matrix (accumulates Givens rotations).
# max_iter: maximum iterations.
fn _lp_tridiag_qr(diag, offdiag, n, Q, max_iter) {
    var iter = 0;
    var p_hi = n - 1;

    while (p_hi > 0 && iter < max_iter) {
        # Deflation: check if offdiag[p_hi] is negligible
        var threshold = f64_mul(EPSILON_F64,
          f64_add(f64_abs(load64(diag + p_hi * 8)),
            f64_abs(load64(diag + (p_hi - 1) * 8))));
        if (f64_lt(f64_abs(load64(offdiag + p_hi * 8)), threshold) == 1) {
            store64(offdiag + p_hi * 8, f64_from(0));
            p_hi = p_hi - 1;
        } else {
            # Find p_lo: the start of the unreduced block containing p_hi.
            #
            # Through 2.7.0 this was two loops. The first had a FAKE break -- a
            # `var _break = 1;` and two no-op `p_lo = p_lo;` statements with a
            # `# break` comment -- so it never exited early and always ran to 0,
            # zeroing offdiagonals across the whole matrix as a side effect. The
            # author then discarded its result ("Re-find p_lo properly") with a
            # second loop whose test was an ABSOLUTE EPSILON_F64, inconsistent
            # with the RELATIVE threshold the deflation test above uses. On a
            # matrix whose entries span 0.04 .. 24.6 the two disagree about what
            # counts as negligible, so the block bounds and the deflation test
            # could contradict each other and the sweep stalled: measured
            # HSB_ERR_NO_CONVERGENCE at max_iter = 1,000,000 for a symmetric 4x4
            # of condition number only 240.
            #
            # One loop now, using the SAME relative threshold as the deflation
            # test, and deflating as it scans.
            var p_lo = p_hi;
            while (p_lo > 0) {
                var thr2 = f64_mul(EPSILON_F64,
                  f64_add(f64_abs(load64(diag + p_lo * 8)),
                    f64_abs(load64(diag + (p_lo - 1) * 8))));
                if (f64_lt(f64_abs(load64(offdiag + p_lo * 8)), thr2) == 1) {
                    store64(offdiag + p_lo * 8, f64_from(0));
                    break;
                }
                p_lo = p_lo - 1;
            }

            # Wilkinson shift: eigenvalue of trailing 2x2 block closer to d[p_hi]
            var d1 = load64(diag + (p_hi - 1) * 8);
            var d2 = load64(diag + p_hi * 8);
            var e2 = load64(offdiag + p_hi * 8);

            var delta = f64_mul(F64_HALF, f64_sub(d1, d2));
            var e2sq = f64_mul(e2, e2);

            # mu = d2 - e2^2 / (delta + sign(delta) * sqrt(delta^2 + e2^2))
            var denom_inner = f64_sqrt(f64_add(f64_mul(delta, delta), e2sq));
            var sgn_delta = _lp_sign(delta);
            # Handle delta == 0: use sign +1
            if (f64_lt(f64_abs(delta), EPSILON_F64) == 1) {
                sgn_delta = F64_ONE;
            }
            var denom = f64_add(delta, f64_mul(sgn_delta, denom_inner));
            var mu = d2;
            if (f64_gt(f64_abs(denom), EPSILON_F64) == 1) {
                mu = f64_sub(d2, f64_div(e2sq, denom));
            }

            # Implicit QR step: chase bulge from p_lo to p_hi
            var x = f64_sub(load64(diag + p_lo * 8), mu);
            var z = load64(offdiag + (p_lo + 1) * 8);

            var k = p_lo;
            while (k < p_hi) {
                # Givens rotation to zero z
                var r = f64_sqrt(f64_add(f64_mul(x, x), f64_mul(z, z)));
                var cs = F64_ONE;
                var sn = f64_from(0);
                if (f64_gt(r, EPSILON_F64) == 1) {
                    cs = f64_div(x, r);
                    sn = f64_div(z, r);
                }

                # Apply similarity transform to tridiagonal
                if (k > p_lo) {
                    store64(offdiag + k * 8, r);
                }

                var dk = load64(diag + k * 8);
                var dk1 = load64(diag + (k + 1) * 8);
                var ek1 = load64(offdiag + (k + 1) * 8);

                # Similarity update T <- G T G^T, with G = [[cs, sn], [-sn, cs]].
                #
                # G is the rotation that ZEROES the bulge: G*[x; z] = [r; 0] for
                # cs = x/r, sn = z/r (set above). The matching similarity is
                # therefore G T G^T. Through 2.6.12 this block applied G^T T G
                # instead — the transpose — which is a valid similarity but not the
                # one that annihilates the bulge, so the off-diagonal never decayed
                # and eigen_qr returned HSB_ERR_NO_CONVERGENCE for every n >= 3
                # (measured: a plain symmetric 3x3 failed even at max_iter=100000).
                # Only the signs of the cross terms differ, which is why it looked
                # right. Expanding G T G^T on the 2x2 block [[dk, ek1], [ek1, dk1]]:
                #   d'_k     = cs^2*dk + sn^2*dk1 + 2*cs*sn*ek1
                #   d'_{k+1} = sn^2*dk + cs^2*dk1 - 2*cs*sn*ek1
                #   e'_{k+1} = cs*sn*(dk1 - dk) + (cs^2 - sn^2)*ek1
                # The Q accumulation below (Q <- Q*G^T) is the correct companion to
                # THIS update and needed no change; it was the pair that was
                # inconsistent, not Q alone.
                var cs2 = f64_mul(cs, cs);
                var sn2 = f64_mul(sn, sn);
                var cs_sn = f64_mul(cs, sn);

                store64(diag + k * 8,
                  f64_add(f64_add(f64_mul(cs2, dk), f64_mul(sn2, dk1)),
                    f64_mul(f64_from(2), f64_mul(cs_sn, ek1))));
                store64(diag + (k + 1) * 8,
                  f64_sub(f64_add(f64_mul(sn2, dk), f64_mul(cs2, dk1)),
                    f64_mul(f64_from(2), f64_mul(cs_sn, ek1))));
                store64(offdiag + (k + 1) * 8,
                  f64_add(f64_mul(cs_sn, f64_sub(dk1, dk)),
                    f64_mul(f64_sub(cs2, sn2), ek1)));

                # Prepare next bulge
                if (k + 1 < p_hi) {
                    var ek2 = load64(offdiag + (k + 2) * 8);
                    x = load64(offdiag + (k + 1) * 8);
                    z = f64_mul(sn, ek2);
                    store64(offdiag + (k + 2) * 8, f64_mul(cs, ek2));
                }

                # Accumulate Givens into Q (columns k, k+1)
                var j = 0;
                while (j < n) {
                    var qk  = mat_get(Q, j, k);
                    var qk1 = mat_get(Q, j, k + 1);
                    mat_set(Q, j, k,     f64_add(f64_mul(cs, qk), f64_mul(sn, qk1)));
                    mat_set(Q, j, k + 1, f64_add(f64_mul(f64_neg(sn), qk),
                        f64_mul(cs, qk1)));
                    j = j + 1;
                }

                k = k + 1;
            }

            iter = iter + 1;
        }
    }

    if (iter >= max_iter && p_hi > 0) {
        return HSB_ERR_NO_CONVERGENCE;
    }
    return HSB_ERR_NONE;
}

# Public: QR iteration for symmetric eigendecomposition
# A:        stdlib matrix (n x n, must be symmetric -- SHAPE ENFORCED, see below).
# n:        matrix dimension.
# max_iter: maximum QR iterations.
# out_vals: flat f64 array of length n (caller allocates).
# out_vecs: stdlib matrix (n x n, caller allocates, eigenvectors as columns).
# Returns:  HSB_ERR_NONE on success, HSB_ERR_NO_CONVERGENCE if max_iter exceeded,
#           HSB_ERR_INVALID_INPUT on a null handle or a shape that does not match n.
fn eigen_qr(A, n, max_iter, out_vals, out_vecs) {
    # Any of these may be the designed 0 that mat_new / mat_new_guarded returns
    # above its own element cap; mat_rows(0) is a null dereference, so guard
    # before reading dims. This is svd_golub_kahan's idiom (:753) applied to the
    # one routine in this file that still lacked it: through 2.8.4 a null A,
    # out_vals or out_vecs was stored through and SIGSEGV'd (exit 139, measured).
    if (A == 0 || out_vals == 0) { return HSB_ERR_INVALID_INPUT; }
    if (out_vecs == 0) { return HSB_ERR_INVALID_INPUT; }

    # n <= 0 was HALF-guarded: `n == 0` only, so n = -3 fell through to
    # _lp_vec_new(-3) -> alloc of a negative size and a wild store (exit 139).
    if (n <= 0) { return HSB_ERR_INVALID_INPUT; }

    # THE n x n PRECONDITION IS NOW CHECKED, NOT JUST DOCUMENTED.
    #
    # `n` is a restatement of A's own extent, and every read below is
    # mat_get(A, i, j) for i, j < n -- so an n larger than A is an out-of-bounds
    # read, and an n SMALLER than A is a silently different problem: the routine
    # would return HSB_ERR_NONE carrying the spectrum of A's leading n x n block,
    # which is not the spectrum of A. The balancing above compounds it --
    # _lp_mat_max_abs(A) scans mat_rows(A) * mat_cols(A) entries, so the scale is
    # drawn from a matrix the decomposition never looks at. There is no reading of
    # "the eigendecomposition of a non-square A", so this is rejected rather than
    # handled. out_vecs takes mat_set(out_vecs, i, j) for i, j < n and is bounded
    # the same way.
    if (mat_rows(A) != n || mat_cols(A) != n) { return HSB_ERR_INVALID_INPUT; }
    if (mat_rows(out_vecs) < n || mat_cols(out_vecs) < n) { return HSB_ERR_INVALID_INPUT; }

    if (n == 1) {
        store64(out_vals, mat_get(A, 0, 0));
        mat_set(out_vecs, 0, 0, F64_ONE);
        return HSB_ERR_NONE;
    }

    # Step 1: Householder tridiagonalization
    var diag = _lp_vec_new(n);
    var offdiag = _lp_vec_new(n);

    # Balance first; see svd_golub_kahan. The Wilkinson shift squares the
    # offdiagonal (e2sq = e2*e2), so this overflowed at 1e200 exactly as the
    # Householder norm did.
    var sc = _lp_pow2_floor(_lp_mat_max_abs(A));
    var As = _lp_mat_div_scalar(A, sc);
    if (As == 0) { return HSB_ERR_ALLOC; }

    var err = _lp_tridiagonalize(As, n, diag, offdiag, out_vecs);
    if (err != HSB_ERR_NONE) { return err; }

    # Step 2: Implicit QR iteration on tridiagonal
    err = _lp_tridiag_qr(diag, offdiag, n, out_vecs, max_iter);
    if (err != HSB_ERR_NONE) { return err; }

    # Undo the balancing: eig(c*A) = c*eig(A), eigenvectors invariant.
    var ev_i = 0;
    while (ev_i < n) {
        store64(diag + ev_i * 8, f64_mul(sc, load64(diag + ev_i * 8)));
        ev_i = ev_i + 1;
    }

    # Step 3: Copy eigenvalues, sort by descending magnitude
    # First, copy raw eigenvalues
    _lp_vec_copy(out_vals, diag, n);

    # Selection sort by descending |eigenvalue|
    var i = 0;
    while (i < n) {
        var max_idx = i;
        var max_abs = f64_abs(load64(out_vals + i * 8));
        var j = i + 1;
        while (j < n) {
            var aj = f64_abs(load64(out_vals + j * 8));
            if (f64_gt(aj, max_abs) == 1) {
                max_abs = aj;
                max_idx = j;
            }
            j = j + 1;
        }
        if (max_idx != i) {
            # Swap eigenvalues
            var tmp = load64(out_vals + i * 8);
            store64(out_vals + i * 8, load64(out_vals + max_idx * 8));
            store64(out_vals + max_idx * 8, tmp);
            # Swap eigenvector columns in out_vecs
            var k = 0;
            while (k < n) {
                var tv = mat_get(out_vecs, k, i);
                mat_set(out_vecs, k, i, mat_get(out_vecs, k, max_idx));
                mat_set(out_vecs, k, max_idx, tv);
                k = k + 1;
            }
        }
        i = i + 1;
    }

    return HSB_ERR_NONE;
}

# ================================================================
# Section 3 -- Complex QR decomposition
# ================================================================
#
# cqr_decompose(A, out_Q, out_R) -> error code
#
# A:     complex matrix (cmat_new, m x n). ANY m, n -- see the shape note below.
# out_Q: complex matrix (m x m, caller allocates) -- SHAPE ENFORCED.
# out_R: complex matrix (m x n, caller allocates) -- SHAPE ENFORCED.
# Returns: HSB_ERR_NONE on success, HSB_ERR_INVALID_INPUT on a null handle or an
#          out_Q / out_R that is not sized exactly m x m / m x n.
#
# Uses Householder reflectors in complex space:
#   H = I - (2 / v^H v) * v * v^H
# where v = x + sign(x1)*||x||*e1, with sign chosen for numerical stability.

fn cqr_decompose(A, out_Q, out_R) {
    # NULL HANDLES. cmat_rows(0) is load64(0). Each of the three may be the
    # designed 0 that cmat_new returns for a non-positive dimension or above
    # _CMAT_MAX_ELEMS, so cqr_decompose(cmat_new(100000, 100000), ...) -- a call
    # that looks like it allocated -- SIGSEGV'd through 2.8.4 (exit 139, measured).
    if (A == 0 || out_Q == 0) { return HSB_ERR_INVALID_INPUT; }
    if (out_R == 0) { return HSB_ERR_INVALID_INPUT; }

    var m = cmat_rows(A);
    var n = cmat_cols(A);
    if (m <= 0 || n <= 0) { return HSB_ERR_INVALID_INPUT; }

    # THE OUTPUT SHAPES ARE NOW CHECKED, NOT JUST DOCUMENTED.
    #
    # This was the canary overwrite. The copy loop below walks i < m, j < n and
    # calls cmat_set(out_R, i, j), and cmat_set computes its offset from out_R's
    # OWN column count -- so when the caller sized out_R m x m for what it assumed
    # was a square decomposition, every j >= m stored past the end of out_R's data
    # buffer and the routine still returned HSB_ERR_NONE. Measured on a 2x3 A into
    # a 2x2 out_R: rc = HSB_ERR_NONE with 2 of 8 guard slots -- the 16 bytes
    # immediately after out_R's buffer -- overwritten; the square 2x2 control over
    # the same code path clobbered 0.
    #
    # The ALGORITHM is not the problem: Householder QR is general in m and n
    # (min_mn = min(m, n) reflectors), and with out_R correctly sized m x n it is
    # measurably right for both shapes -- Q*R == A, Q^H Q == I and R upper
    # trapezoidal to < 1e-8 on a wide 2x3 and a tall 4x2. So the rectangular case
    # is HANDLED, not rejected; what is rejected is the caller handing over
    # out-buffers that are not the documented size, because there is nowhere to
    # put an m x n R inside an m x m allocation.
    if (cmat_rows(out_Q) != m || cmat_cols(out_Q) != m) { return HSB_ERR_INVALID_INPUT; }
    if (cmat_rows(out_R) != m || cmat_cols(out_R) != n) { return HSB_ERR_INVALID_INPUT; }

    # Balance on the way into out_R; undo it on R at the end. Q is invariant under
    # a positive rescale of A. Unbalanced, ||v||^2 = Inf made cx_abs(x1) = Inf,
    # phase = cx_div(x1, Inf) = NaN and v^H v = NaN, so the f64_gt(vhv, EPSILON)
    # guard was false and EVERY reflector was skipped: at 1e200 this returned
    # HSB_ERR_NONE with Q = I and R = A -- R not even upper triangular.
    var sc = _lp_pow2_floor(_lp_cmat_max_abs(A));

    # Copy A into out_R
    var i = 0;
    while (i < m) {
        var j = 0;
        while (j < n) {
            var aij = cmat_get(A, i, j);
            cmat_set(out_R, i, j, cx_new(f64_div(HComplex_re(aij), sc),
                f64_div(HComplex_im(aij), sc)));
            j = j + 1;
        }
        i = i + 1;
    }

    # Initialize out_Q to m x m identity
    i = 0;
    while (i < m) {
        var j = 0;
        while (j < m) {
            if (i == j) {
                cmat_set(out_Q, i, j, cx_one());
            } else {
                cmat_set(out_Q, i, j, cx_zero());
            }
            j = j + 1;
        }
        i = i + 1;
    }

    var min_mn = m;
    if (n < min_mn) { min_mn = n; }

    # Reflector scratch, HOISTED out of the k loop (2026-08-04 audit, performance).
    # `len` is m - k, so the k = 0 pass needs the largest buffer and every later
    # pass fits inside it; only the leading `len` slots are ever read. The arena is
    # a bump allocator that never frees, so the per-iteration alloc cost
    # sum(m-k)*16 = 16*m*(m+1)/2 bytes per call -- 33,280 B on a 64x64, against
    # 1,024 B for this single allocation. Measured per cqr_decompose(64x64) call:
    # 32,942,104 B of arena before, 32,909,848 B after (-32,256 B). That is only
    # -0.098% of the call's total, because the bulk is cx_new's 16 B per complex
    # temporary inside the O(m^2 n) reflector application -- a separate problem
    # this hoist does not claim to solve.
    var vbuf = alloc(m * 16);
    if (vbuf == 0) { return HSB_ERR_ALLOC; }

    var k = 0;
    while (k < min_mn) {
        var len = m - k;

        # Extract column k below diagonal as complex vector (flat: len * 16 bytes)
        var v = vbuf;
        i = 0;
        while (i < len) {
            var elem = cmat_get(out_R, k + i, k);
            store64(v + i * 16, HComplex_re(elem));
            store64(v + i * 16 + 8, HComplex_im(elem));
            i = i + 1;
        }

        # Compute ||v|| (real-valued 2-norm)
        var norm_sq = f64_from(0);
        i = 0;
        while (i < len) {
            var re = load64(v + i * 16);
            var im = load64(v + i * 16 + 8);
            norm_sq = f64_add(norm_sq, f64_add(f64_mul(re, re), f64_mul(im, im)));
            i = i + 1;
        }
        var norm = f64_sqrt(norm_sq);

        if (f64_gt(norm, EPSILON_F64) == 1) {
            # Complex sign: sign(x1) = x1 / |x1| if x1 != 0, else 1
            var x1 = cx_new(load64(v), load64(v + 8));
            var abs_x1 = cx_abs(x1);
            var phase = cx_one();
            if (f64_gt(abs_x1, EPSILON_F64) == 1) {
                phase = cx_div(x1, cx_real(abs_x1));
            }

            # v[0] += phase * ||v||
            var shift = cx_scale(phase, norm);
            var new_v0 = cx_add(x1, shift);
            store64(v, HComplex_re(new_v0));
            store64(v + 8, HComplex_im(new_v0));

            # Compute v^H * v (real, since it's a norm squared)
            var vhv = f64_from(0);
            i = 0;
            while (i < len) {
                var re = load64(v + i * 16);
                var im = load64(v + i * 16 + 8);
                vhv = f64_add(vhv, f64_add(f64_mul(re, re), f64_mul(im, im)));
                i = i + 1;
            }

            if (f64_gt(vhv, EPSILON_F64) == 1) {
                var two_over_vhv = f64_div(F64_TWO, vhv);

                # Apply H to out_R: R[k:m, k:n] -= (2/vHv) * v * (v^H * R[k:m, k:n])
                var j = k;
                while (j < n) {
                    # dot = v^H * R[:, j] (complex dot product with conjugate of v)
                    var dot = cx_zero();
                    i = 0;
                    while (i < len) {
                        var vi_conj = cx_conj(cx_new(load64(v + i * 16),
                            load64(v + i * 16 + 8)));
                        var rij = cmat_get(out_R, k + i, j);
                        dot = cx_add(dot, cx_mul(vi_conj, rij));
                        i = i + 1;
                    }
                    var coeff = cx_scale(dot, two_over_vhv);
                    i = 0;
                    while (i < len) {
                        var vi = cx_new(load64(v + i * 16), load64(v + i * 16 + 8));
                        var rij = cmat_get(out_R, k + i, j);
                        cmat_set(out_R, k + i, j, cx_sub(rij, cx_mul(coeff, vi)));
                        i = i + 1;
                    }
                    j = j + 1;
                }

                # Apply H to out_Q: Q[k:m, :] -= (2/vHv) * v * (v^H * Q[k:m, :])
                # We accumulate Q^H, then transpose at the end.
                j = 0;
                while (j < m) {
                    var dot = cx_zero();
                    i = 0;
                    while (i < len) {
                        var vi_conj = cx_conj(cx_new(load64(v + i * 16),
                            load64(v + i * 16 + 8)));
                        var qij = cmat_get(out_Q, k + i, j);
                        dot = cx_add(dot, cx_mul(vi_conj, qij));
                        i = i + 1;
                    }
                    var coeff = cx_scale(dot, two_over_vhv);
                    i = 0;
                    while (i < len) {
                        var vi = cx_new(load64(v + i * 16), load64(v + i * 16 + 8));
                        var qij = cmat_get(out_Q, k + i, j);
                        cmat_set(out_Q, k + i, j, cx_sub(qij, cx_mul(coeff, vi)));
                        i = i + 1;
                    }
                    j = j + 1;
                }
            }
        }

        k = k + 1;
    }

    # Undo the balancing on R: A/sc = Q*R implies A = Q*(sc*R).
    i = 0;
    while (i < m) {
        var j = 0;
        while (j < n) {
            cmat_set(out_R, i, j, cx_scale(cmat_get(out_R, i, j), sc));
            j = j + 1;
        }
        i = i + 1;
    }

    # Q has accumulated H_k ... H_1. Take conjugate transpose to get Q where A = QR.
    var Qt = cmat_adjoint(out_Q);
    i = 0;
    while (i < m) {
        var j = 0;
        while (j < m) {
            cmat_set(out_Q, i, j, cmat_get(Qt, i, j));
            j = j + 1;
        }
        i = i + 1;
    }

    return HSB_ERR_NONE;
}
