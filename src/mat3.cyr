    if ((q4 & 0x7FFF_FFFF_FFFF_FFFF) < _M3_FLOOR && (x20 & 0x7FFF_FFFF_FFFF_FFFF) != 0
      && (x02 & 0x7FFF_FFFF_FFFF_FFFF) != 0) { return 2; }
    var ep4 = f64_add(f64_add(f64_add(f64_sub(f64_mul(h00, h22), p4), f64_mul(h00, l22)), f64_mul(l00, h22)),
      f64_mul(l00, l22));
    var eq4 = f64_add(f64_add(f64_add(f64_sub(f64_mul(h20, h02), q4), f64_mul(h20, l02)), f64_mul(l20, h02)),
      f64_mul(l20, l02));
    var s4 = f64_sub(p4, q4); var z4 = f64_sub(s4, p4); var w4 = f64_sub(ep4, eq4);
    var u4 = f64_add(f64_sub(f64_sub(p4, f64_sub(s4, z4)), f64_add(q4, z4)), w4);
    var c4 = f64_add(s4, u4);
    var d4 = f64_mul(f64_add(u4 & 0x7FFF_FFFF_FFFF_FFFF, w4 & 0x7FFF_FFFF_FFFF_FFFF), _M3_W51);
    if (f64_add(s4, f64_add(u4, d4)) != c4 || f64_add(s4, f64_sub(u4, d4)) != c4) { ok = 0; }
    store64(r + 32, c4);
    var p5 = f64_mul(x10, x02); var q5 = f64_mul(x00, x12);
    if ((p5 & 0x7FFF_FFFF_FFFF_FFFF) < _M3_FLOOR && (x10 & 0x7FFF_FFFF_FFFF_FFFF) != 0
      && (x02 & 0x7FFF_FFFF_FFFF_FFFF) != 0) { return 2; }
    if ((q5 & 0x7FFF_FFFF_FFFF_FFFF) < _M3_FLOOR && (x00 & 0x7FFF_FFFF_FFFF_FFFF) != 0
      && (x12 & 0x7FFF_FFFF_FFFF_FFFF) != 0) { return 2; }
    var ep5 = f64_add(f64_add(f64_add(f64_sub(f64_mul(h10, h02), p5), f64_mul(h10, l02)), f64_mul(l10, h02)),
      f64_mul(l10, l02));
    var eq5 = f64_add(f64_add(f64_add(f64_sub(f64_mul(h00, h12), q5), f64_mul(h00, l12)), f64_mul(l00, h12)),
      f64_mul(l00, l12));
    var s5 = f64_sub(p5, q5); var z5 = f64_sub(s5, p5); var w5 = f64_sub(ep5, eq5);
    var u5 = f64_add(f64_sub(f64_sub(p5, f64_sub(s5, z5)), f64_add(q5, z5)), w5);
    var c5 = f64_add(s5, u5);
    var d5 = f64_mul(f64_add(u5 & 0x7FFF_FFFF_FFFF_FFFF, w5 & 0x7FFF_FFFF_FFFF_FFFF), _M3_W51);
    if (f64_add(s5, f64_add(u5, d5)) != c5 || f64_add(s5, f64_sub(u5, d5)) != c5) { ok = 0; }
    store64(r + 56, c5);
    var p6 = f64_mul(x10, x21); var q6 = f64_mul(x20, x11);
    if ((p6 & 0x7FFF_FFFF_FFFF_FFFF) < _M3_FLOOR && (x10 & 0x7FFF_FFFF_FFFF_FFFF) != 0
      && (x21 & 0x7FFF_FFFF_FFFF_FFFF) != 0) { return 2; }
    if ((q6 & 0x7FFF_FFFF_FFFF_FFFF) < _M3_FLOOR && (x20 & 0x7FFF_FFFF_FFFF_FFFF) != 0
      && (x11 & 0x7FFF_FFFF_FFFF_FFFF) != 0) { return 2; }
    var ep6 = f64_add(f64_add(f64_add(f64_sub(f64_mul(h10, h21), p6), f64_mul(h10, l21)), f64_mul(l10, h21)),
      f64_mul(l10, l21));
    var eq6 = f64_add(f64_add(f64_add(f64_sub(f64_mul(h20, h11), q6), f64_mul(h20, l11)), f64_mul(l20, h11)),
      f64_mul(l20, l11));
    var s6 = f64_sub(p6, q6); var z6 = f64_sub(s6, p6); var w6 = f64_sub(ep6, eq6);
    var u6 = f64_add(f64_sub(f64_sub(p6, f64_sub(s6, z6)), f64_add(q6, z6)), w6);
    var c6 = f64_add(s6, u6);
    var d6 = f64_mul(f64_add(u6 & 0x7FFF_FFFF_FFFF_FFFF, w6 & 0x7FFF_FFFF_FFFF_FFFF), _M3_W51);
    if (f64_add(s6, f64_add(u6, d6)) != c6 || f64_add(s6, f64_sub(u6, d6)) != c6) { ok = 0; }
    store64(r + 16, c6);
    var p7 = f64_mul(x20, x01); var q7 = f64_mul(x00, x21);
    if ((p7 & 0x7FFF_FFFF_FFFF_FFFF) < _M3_FLOOR && (x20 & 0x7FFF_FFFF_FFFF_FFFF) != 0
      && (x01 & 0x7FFF_FFFF_FFFF_FFFF) != 0) { return 2; }
