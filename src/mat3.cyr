    var ep3 = f64_add(f64_add(f64_add(f64_sub(f64_mul(h20, h12), p3), f64_mul(h20, l12)), f64_mul(l20, h12)),
      f64_mul(l20, l12));
    var eq3 = f64_add(f64_add(f64_add(f64_sub(f64_mul(h10, h22), q3), f64_mul(h10, l22)), f64_mul(l10, h22)),
      f64_mul(l10, l22));
    var s3 = f64_sub(p3, q3); var z3 = f64_sub(s3, p3); var w3 = f64_sub(ep3, eq3);
    var u3 = f64_add(f64_sub(f64_sub(p3, f64_sub(s3, z3)), f64_add(q3, z3)), w3);
    var c3 = f64_add(s3, u3);
    var d3 = f64_mul(f64_add(u3 & 0x7FFF_FFFF_FFFF_FFFF, w3 & 0x7FFF_FFFF_FFFF_FFFF), _M3_W51);
    if (f64_add(s3, f64_add(u3, d3)) != c3 || f64_add(s3, f64_sub(u3, d3)) != c3) { ok = 0; }
    store64(r + 8, c3);
    var p4 = f64_mul(x00, x22); var q4 = f64_mul(x20, x02);
    if ((p4 & 0x7FFF_FFFF_FFFF_FFFF) < _M3_FLOOR && (x00 & 0x7FFF_FFFF_FFFF_FFFF) != 0
