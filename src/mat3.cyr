      && (x21 & 0x7FFF_FFFF_FFFF_FFFF) != 0) { return 2; }
    var ep7 = f64_add(f64_add(f64_add(f64_sub(f64_mul(h20, h01), p7), f64_mul(h20, l01)), f64_mul(l20, h01)),
      f64_mul(l20, l01));
    var eq7 = f64_add(f64_add(f64_add(f64_sub(f64_mul(h00, h21), q7), f64_mul(h00, l21)), f64_mul(l00, h21)),
      f64_mul(l00, l21));
    var s7 = f64_sub(p7, q7); var z7 = f64_sub(s7, p7); var w7 = f64_sub(ep7, eq7);
    var u7 = f64_add(f64_sub(f64_sub(p7, f64_sub(s7, z7)), f64_add(q7, z7)), w7);
    var c7 = f64_add(s7, u7);
    var d7 = f64_mul(f64_add(u7 & 0x7FFF_FFFF_FFFF_FFFF, w7 & 0x7FFF_FFFF_FFFF_FFFF), _M3_W51);
    if (f64_add(s7, f64_add(u7, d7)) != c7 || f64_add(s7, f64_sub(u7, d7)) != c7) { ok = 0; }
    store64(r + 40, c7);
    var p8 = f64_mul(x00, x11); var q8 = f64_mul(x10, x01);
    if ((p8 & 0x7FFF_FFFF_FFFF_FFFF) < _M3_FLOOR && (x00 & 0x7FFF_FFFF_FFFF_FFFF) != 0
      && (x11 & 0x7FFF_FFFF_FFFF_FFFF) != 0) { return 2; }
    if ((q8 & 0x7FFF_FFFF_FFFF_FFFF) < _M3_FLOOR && (x10 & 0x7FFF_FFFF_FFFF_FFFF) != 0
      && (x01 & 0x7FFF_FFFF_FFFF_FFFF) != 0) { return 2; }
    var ep8 = f64_add(f64_add(f64_add(f64_sub(f64_mul(h00, h11), p8), f64_mul(h00, l11)), f64_mul(l00, h11)),
      f64_mul(l00, l11));
    var eq8 = f64_add(f64_add(f64_add(f64_sub(f64_mul(h10, h01), q8), f64_mul(h10, l01)), f64_mul(l10, h01)),
      f64_mul(l10, l01));
    var s8 = f64_sub(p8, q8); var z8 = f64_sub(s8, p8); var w8 = f64_sub(ep8, eq8);
    var u8 = f64_add(f64_sub(f64_sub(p8, f64_sub(s8, z8)), f64_add(q8, z8)), w8);
    var c8 = f64_add(s8, u8);
    var d8 = f64_mul(f64_add(u8 & 0x7FFF_FFFF_FFFF_FFFF, w8 & 0x7FFF_FFFF_FFFF_FFFF), _M3_W51);
    if (f64_add(s8, f64_add(u8, d8)) != c8 || f64_add(s8, f64_sub(u8, d8)) != c8) { ok = 0; }
    store64(r + 64, c8);
    if (ok == 0) { return 0; }
    var k = load64(kv + 72);
    var i = 0;
    while (i < 9) {
        var v = load64(r + i * 8);
        var sh = load64(kv + i * 8) - k;
        var e = (v & 0x7FFF_FFFF_FFFF_FFFF) >> 52;
        if (e != 0 && e + sh >= 1) { v = v + (sh << 52); } else { v = _m3_wout(v, sh); }
        if (sg < 0) { v = v ^ 0x8000000000000000; }
        store64(r + i * 8, v);
        i = i + 1;
    }
    return 1;
}

# The columns' half of `_m3_cof_certified`, which the caller tries first (m's entries as
# loaded, column-major: c0 = (m00, m01, m02) and so on).
fn _m3_cof_colcert(m00, m01, m02, m10, m11, m12, m20, m21, m22, mx) {
    var c0 = m00 & 0x7FFF_FFFF_FFFF_FFFF;
    var t = m01 & 0x7FFF_FFFF_FFFF_FFFF; if (t > c0) { c0 = t; }
    t = m02 & 0x7FFF_FFFF_FFFF_FFFF; if (t > c0) { c0 = t; }
    var c1 = m10 & 0x7FFF_FFFF_FFFF_FFFF;
    t = m11 & 0x7FFF_FFFF_FFFF_FFFF; if (t > c1) { c1 = t; }
    t = m12 & 0x7FFF_FFFF_FFFF_FFFF; if (t > c1) { c1 = t; }
    var c2 = m20 & 0x7FFF_FFFF_FFFF_FFFF;
    t = m21 & 0x7FFF_FFFF_FFFF_FFFF; if (t > c2) { c2 = t; }
    t = m22 & 0x7FFF_FFFF_FFFF_FFFF; if (t > c2) { c2 = t; }
    if (f64_le(_m3_top2(c0, c1, c2), f64_mul(mx, _M3_NCERT)) == 1) { return 1; }
    return 0;
}

# sign(det) times m's cofactor matrix, each cofactor summed exactly (`_m3_xsum`) and rounded
# once, scaled by 2^-h where h is the exponent of the largest when that lies above 1023 or
# below -969 (the range `m3_normal_matrix_cof` keeps), otherwise unscaled. m finite and not
# all zero. `m3_normal_matrix_cof`'s answer where its certificate fails (3.4.1).
fn _m3_cof_exact(m, sg) {
    var dc: i64[38];
    if (_m3_xload(m, &dc) == 1) { return 0; }
    var tl: i64[6];
    var oc: i64[2];
    var ex: i64[27];
    var hi = 0 - 100000;
    var i = 0;
    while (i < 3) {
        var j = 0;
        while (j < 3) {
            _m3_minor_terms(&tl, 0, i, j, 2);
            var k = (j * 3 + i) * 24;
            var sc = _m3_xsum(&dc, &dc + 288, &tl, 2, 2, &oc);
            store64(&ex + k, sc);
            store64(&ex + k + 8, load64(&oc));
            store64(&ex + k + 16, load64(&oc + 8));
            if (sc != 0) {
                var e = load64(&oc + 8) + (load64(&oc) >> 52) - 1023;
                if (e > hi) { hi = e; }
            }
            j = j + 1;
        }
        i = i + 1;
    }
    var sh = 0;
    if (hi > 1023 || hi < 0 - 969) { sh = 0 - hi; }
    var r = alloc(MAT3_BYTES);
    if (r == 0) { return 0; }
    i = 0;
    while (i < 9) {
        var v = 0;
        var s3 = load64(&ex + i * 24);
        if (s3 != 0) { v = _m3_ldexp(load64(&ex + i * 24 + 8), load64(&ex + i * 24 + 16) + sh); }
        if (s3 < 0) { v = v ^ 0x8000000000000000; }
        if (sg < 0) { v = v ^ 0x8000000000000000; }
        store64(r + i * 8, v);
        i = i + 1;
    }
    return r;
}

# The normal matrix of m: sign(det m) * cof(m), the cofactor matrix with its orientation
# fixed, which is |det m| * m^-T wherever m is invertible. It carries a surface normal
# n = t1 x t2 to (m t1) x (m t2) times sign(det m): the normal of the image, pointing to the
# same side of it as n did (outward stays outward through a mirror). It exists for EVERY m:
# a singular m that flattens a surface onto a plane sends its normals to that plane's normal
# (with det m = 0 the sign is +1), and an m of rank 1 or 0 has the zero matrix, because its
# image has no normal. Callers renormalise. A NaN or infinite entry propagates.
# Where an entry overflows, or the largest falls below 2^-969 (products of two entries flushed
# to the subnormals), the result is a power of two times sign(det m) cof(m), the same
# directions: the cofactor matrix of m * 2^-e (e the exponent of m's largest entry) where that
# copy's minors are certified, otherwise the exact cofactors, scaled by a power of two only
# where the largest would leave [2^-969, DBL_MAX] (into [1, 2)). Accuracy (3.4.1): within 17u
# of the largest entry (u = 2^-53), normwise, where the plain or the compensated minors are
# certified, otherwise each entry the exact cofactor rounded once. Returns the designed 0 where
# an allocation is refused.
#
# ⛔ 3.4.0 — REPLACES `m3_normal_matrix`, which was `m3_transpose(m3_inverse(m))`: it
# inherited the inverse's IDENTITY for every singular m (diag(1, 1, 0) kept normals along x,
# where its image, the plane z = 0, has the normal z alone) and so for every m with an exactly
# singular minor structure, and m^-T itself overflows where m is merely small along one axis
# (diag(1, 1, 2^-1074) sends (0, 0, 1) to (0, 0, +Inf)). The magnitude changes from m^-T to
# |det m| m^-T, so the name is retired, not redefined.
# ⭐ The orientation is exact over the whole double range: a filter certifies sign(det~) where
# |det~| > 2^-49 P (|det - det~| <= 5u P) with P in [2^-960, 2^1000] and P >= 2^-990 max|row 0|,
# and the exact determinant (`_m3_det_sign_exact`, integers) decides everything else, singular
# included.
# ⛔ 3.4.0 — THROUGH THE FIRST 3.4.0 REVIEW THE FILTER HAD NO UNDERFLOW CLAUSE AND THE EXACT
# SIGN WAS NOT EXACT: with entries of 2^600 and about 2^-537, two subnormal products' errors
# times 2^600 outweighed 2^-49 P and the filter certified +1 where sign(det) is -1 (3 of 129
# such matrices), turning an outward normal inward; and the expansion behind it inherited the
# inverse's range defect (29 wrong signs in 4,000 wide-range matrices, -1 for some singular ones).
# [measured: REV-FB t27.py / t8.py / t8b.py, Fraction determinants, the first 3.4.0 review of lane FB, 2026-10-31]
# ⛔ 3.4.1 — THROUGH 3.4.0 THE ENTRIES WERE THE PLAIN FORMULA'S 2x2 MINORS WITH NO CERTIFICATE,
# each within 2u of its own permanent (|ad| + |bc|): where m is near rank 1 every minor cancels
# and the directions carried that error (the first 3.4.0 review found 1 of 40,000 transformed
# normals on the wrong side). On 3,000 matrices, a third near rank 1, the matrix was up to 0.535
# of its largest entry off (166 past 2^-10), and on 500 near-rank-1 ones scaled anywhere in
# 2^-1000 .. 2^900, 0.288 (385 past 2^-40).
# [measured: scratch nm_t.py / nm_t2.py, Fraction cofactors, 3.4.0 and this tree, 2026-10-31; cycc 6.7.18]
# ⭐ Now the plain minors are kept only where they are certified (`_m3_cof_certified`): the
# largest product G in any minor at most 8 times the largest computed entry, which puts the
# matrix within 17u of its largest entry (u = 2^-53), normwise. G is bounded first by the two
# largest column maxima of m (so R S, a rotation times any scale, passes on the bits), then by
# the two largest row maxima (S R), then formed. Past that the minors are recomputed with
# exact products and TwoSum (`_m3_cof_comp`), certified while G <= 2^54 times their largest:
# within 13u. Where those steps would overflow (an entry at or above 2^997 - 2^970, or a product
# of splits past DBL_MAX) the same minors are taken on m scaled by powers of two, row and column
# first and uniformly 2^-28 where that loses bits, and kept only where every entry is proved the
# exact cofactor's nearest (`_m3_cof_wide`). Each cofactor is summed exactly and rounded once
# (`_m3_cof_exact`) only beyond those: minors cancelling past 2^54 of G (every m of rank 1 among
# them, whose plain minors are exactly 0 and whose rescue reaches this; the zero matrix never
# does, it is returned first), a `_m3_cof_wide` m that neither scaling can hold (under both, a
# product of two non-zero entries in different rows and columns below 2^-969, or an entry the
# scaling would round) or whose rounding the bracket cannot pin, and a rescued copy whose largest
# plain entry falls under 2^-969 or whose own minors are not certified: within half an ulp, plus
# half a subnormal step below DBL_MIN. On
# the same 3,000 matrices the largest error is 7.45e-16 of
# the largest entry, and 7.68e-16 on the scaled 500; random, rotation-times-anisotropic-scale,
# exactly rank-1 and rank-2 and wide-range matrices keep their maxima. The plain certificate
# fails on none of 10,000 uniform random matrices.
# [measured: scratch nm_t.py / nm_t2.py and a certificate count, Fraction cofactors, this tree, 2026-10-31; cycc 6.7.18]
# ⛔ 3.4.1 REVIEW (M1) — THE FIRST 3.4.1 FORM HAD NO MIDDLE TIER, and an ordinary R1 S R2 (a
# rotation, a non-uniform scale, a rotation, as a scene graph composes them) whose two largest
# singular values differ by more than about 20 to 40 failed the plain certificate and paid the
# exact path: (9.07, 0.21, 0.12) took 2.4 us where 3.4.0 took 91 ns (26x), on answers 3.4.0 had
# within 12u to 40u. On 1,000 R1 diag(s) R2 per k, s_i = 10^U(-k, k), the plain tier certifies
# 993 / 796 / 631 / 482 / 353 / 295 for k = 1, 2, 3, 4, 6, 8, and 122 of 1,000 R1 diag(100, 1, 1)
# R2; every other one is now certified by the compensated tier and none reaches the exact path.
# Every compensated answer in that sweep and on the 3,000 matrices (3,328 and 997) is the
# exact cofactors' nearest, entry by entry; the largest error overall is 10.97u (a
# plain-certified matrix).
# [measured: scratch nmrun.py (seed 23), Fraction cofactors, a Python emulation of each tier, 2026-10-31; cycc 6.7.18]
# The range rescue holds a cofactor matrix spanning at most about 2^2098, the double range
# itself: past that its smallest entries flush under any power of two. Its scaled copy is
# certified the same way, plain or compensated; the exact path picks its own power of two
# (the largest entry in [1, 2) where it would leave [2^-969, DBL_MAX]).
# Cost: the underflow clause, 83 -> 89 ns against integ-snap7 on a random matrix; a singular
# matrix of tiny entries (the exact sign) 1.12 us -> 972 ns.
# [measured: scratch misc.bcyr, integ-snap7 and this tree interleaved x 3, 2026-10-31; cycc 6.7.9]
# 3.4.1 cost, against 3.4.0 (same boot, the binaries interleaved, 6 runs a side): a random matrix
# 91 -> 107 ns (the column certificate, +18%); the M1 R1 S R2 91 -> 418 ns (the compensated
# tier, 4.6x; the first 3.4.1 form's exact path took 2.31 us); a near-rank-1 m 0.77 -> 1.09 us
# (3.4.0 took the exact determinant sign there too, then answered from the plain minors); the
# exact path (minors cancelling past 2^54, rank 1 included) 0.55 -> 1.57 us for
# diag(2, 0, 0) and 0.75 -> 2.95 us for a near-rank-1 m whose minors cancel past 2^54.
# [measured: scratch nmb2.bcyr, 3.4.0, the first 3.4.1 form and this tree interleaved, 2026-10-31; cycc 6.7.18]
# ⛔ 3.4.1 ROUND-2 REVIEW (S1) — THE COMPENSATED TIER'S OWN SPLITS OVERFLOWED, for an entry at
# or above 2^997 - 2^970 and for a product within about 2^-25 of DBL_MAX: the minor came out
# non-finite and was declined, so ordinary non-degenerate m at the top of the range paid the
# exact path, 50 to 94 times 3.4.0's time, while this text said only degenerate ones did. The
# review's M1 with its row 0 at 2^998 now takes 558 to 603 ns against 3.4.0's 87 to 94 (6.4x;
# the first form 7.2 to 7.7 us), R1 S R2 lifted the same way 554 to 597 ns (6.4x; the first form
# 90x), the products-near-DBL_MAX fixture 603 to 651 ns against 85 to 95 (7.0x; 50x), with the
# same bits: on 167,287 matrices (the review's families and range constructions, and lifted,
# overflowing, strongly cancelling and lossy ones) not one answer changes, and every one of the
# 59,112 that `_m3_cof_wide` keeps is the exact cofactors' nearest (Fraction). The proof is 40
# to 45 ns of that (514 to 563 ns without it).
# [measured: scratch nm3.bcyr x 6 interleaved, sweeps, Fraction oracle, 2026-10-31; cycc 6.7.18]
# ⛔ 3.4.1 ROUND-3 REVIEW (S1) — THAT REPAIR LEFT PART OF ITS CLASS ON THE EXACT PATH: a product of
# two entries below 2^-913 or an entry m 2^-28 rounds, 92 to 109 times 3.4.0's time, on matrices
# 3.4.0 could answer right (0.516u on the fixture `lossy_baseok`). `_m3_cof_wide` now tries row and
# column powers of two after the uniform 2^-28, with no answer moved: of 99,270 matrices of the
# round-3 families and two adversarial ones (entries not explained by row and column factors)
# none changes a bit, 6,995 that took the exact path are now certified and equal it entry for
# entry (Fraction), and 2,452 of the wide tier's still decline. Same boot, 3.4.0 / the last form
# / this one interleaved, 3 runs x 3 rounds, medians: `lossy_baseok` 112 ns / 10.2 us / 962 ns,
# the product-lossy ones 95 and 113 ns / 10.2 and 10.6 us / 1.06 and 1.09 us (where 3.4.0 was
# 8e7 u and 375u off), an entry m 2^-28 rounds 1.93 / 13.2 / 2.78 us.
# The cost: a wide-tier answer through the uniform pass takes 603 -> 692 ns on row 0 at 2^998
# and 659 -> 743 on products near DBL_MAX (+13 to +15%, 3.4.0: 94), the exact scalings against a
# multiplication. What stays on the exact path pays 9.3 to 13.7 us, unchanged, 5 to 7 times 3.4.0:
# an entry the bracket cannot pin (nearly all of the 2,452; 2,449 in those families), or a product
# no power-of-two scaling can hold (3).
# [measured: scratch MAT4-work ab1.log, g1 / g2, py/cmpb.py, load 1.5-3.1, 2026-11-01; cycc 6.7.18]
#must_use
public fn m3_normal_matrix_cof(m) {
    var m00 = load64(m);      var m01 = load64(m + 8);  var m02 = load64(m + 16);
    var m10 = load64(m + 24); var m11 = load64(m + 32); var m12 = load64(m + 40);
    var m20 = load64(m + 48); var m21 = load64(m + 56); var m22 = load64(m + 64);
    var p0 = f64_mul(m11, m22); var p1 = f64_mul(m21, m12);
    var p2 = f64_mul(m01, m22); var p3 = f64_mul(m21, m02);
    var p4 = f64_mul(m01, m12); var p5 = f64_mul(m11, m02);
    var det = f64_add(f64_sub(f64_mul(m00, f64_sub(p0, p1)), f64_mul(m10, f64_sub(p2, p3))),
      f64_mul(m20, f64_sub(p4, p5)));
    var pm = f64_add(f64_add(f64_mul(f64_abs(m00), f64_add(f64_abs(p0), f64_abs(p1))),
        f64_mul(f64_abs(m10), f64_add(f64_abs(p2), f64_abs(p3)))),
      f64_mul(f64_abs(m20), f64_add(f64_abs(p4), f64_abs(p5))));
    # A product that flushes is off by at most 2^-1075 and reaches det multiplied by a row-0
    # entry: P >= 2^-990 max|row 0| keeps the six of them under 2^-82 P, far below the filter's
    # 2^-49 P (the first 3.4.0 review's clause; the inverse's screen of every entry cost 13 ns
    # here, and only the determinant's sign is at stake).
    # [measured: scratch misc.bcyr, integ-snap7 and this tree interleaved x 3, 2026-10-31; cycc 6.7.9]
    var mrow = f64_max(f64_max(f64_abs(m00), f64_abs(m10)), f64_abs(m20));
    var sg = 0;
    if (f64_ge(pm, _M3_PM_LO) == 1 && f64_le(pm, _M3_PM_HI) == 1 && f64_ge(pm, f64_mul(mrow, _M3_UFL)) == 1
      && f64_gt(f64_abs(det), f64_mul(pm, _M3_SIGN)) == 1) {
        sg = 1;
        if (f64_lt(det, 0) == 1) { sg = 0 - 1; }
    } else {
        sg = _m3_det_sign_exact(m);
    }
    var r = _m3_cof_signed(m, sg);
    if (r == 0) { return 0; }
    # Range: the entries are degree two in m. Every entry finite with the largest at or above
    # 2^-969 means no product that reaches the directions flushed (their sum's rounding is
    # relative); otherwise (all of them flushed to 0 included) rescale m, unless an entry of m
    # is not finite or every entry is zero. A rank-1 m keeps its zero cofactors through the
    # rescale.
    var mx = 0;
    var i = 0;
    while (i < 9) {
        var a = load64(r + i * 8) & 0x7FFF_FFFF_FFFF_FFFF;
        if (a > mx) { mx = a; }
        i = i + 1;
    }
    if (mx < 0x7FF0_0000_0000_0000 && mx >= _M3_FLOOR) {
        # Certified within 17u max|N~| (`_m3_cof_certified`), its column test first, written out
        # on the entries already loaded (`_m3_cof_colcert` as a call cost 3 to 6 ns more); or
        # the minors cancelled and are summed exactly (3.4.1).
        # [measured: scratch fnm.bcyr, the called and the written-out forms, 2026-10-31; cycc 6.7.18]
        var c0 = m00 & 0x7FFF_FFFF_FFFF_FFFF;
        var ct = m01 & 0x7FFF_FFFF_FFFF_FFFF; if (ct > c0) { c0 = ct; }
        ct = m02 & 0x7FFF_FFFF_FFFF_FFFF; if (ct > c0) { c0 = ct; }
        var c1 = m10 & 0x7FFF_FFFF_FFFF_FFFF;
        ct = m11 & 0x7FFF_FFFF_FFFF_FFFF; if (ct > c1) { c1 = ct; }
        ct = m12 & 0x7FFF_FFFF_FFFF_FFFF; if (ct > c1) { c1 = ct; }
        var c2 = m20 & 0x7FFF_FFFF_FFFF_FFFF;
        ct = m21 & 0x7FFF_FFFF_FFFF_FFFF; if (ct > c2) { c2 = ct; }
        ct = m22 & 0x7FFF_FFFF_FFFF_FFFF; if (ct > c2) { c2 = ct; }
        if (c0 < c1) { ct = c0; c0 = c1; c1 = ct; }
        if (c1 < c2) { c1 = c2; }
        if (f64_le(f64_mul(c0, c1), f64_mul(mx, _M3_NCERT)) == 1) { return r; }
        if (_m3_cof_certified(m, mx, sg, r) == 1) { return r; }
        return _m3_cof_exact(m, sg);
    }
    var me = 0;
    i = 0;
    while (i < 9) {
        var b = load64(m + i * 8) & 0x7FFF_FFFF_FFFF_FFFF;
        if (b >= 0x7FF0_0000_0000_0000) { return r; }
        if (b > me) { me = b; }
        i = i + 1;
    }
    if (me == 0) { return r; }
    var e = _m3_expo(me);
    var t = alloc(MAT3_BYTES);
    if (t == 0) { return 0; }
    i = 0;
    while (i < 9) { store64(t + i * 8, _m3_ldexp(load64(m + i * 8), 0 - e)); i = i + 1; }
    var rt = _m3_cof_signed(t, sg);
    if (rt == 0) { return 0; }
    var mt = 0;
    i = 0;
    while (i < 9) {
        var at = load64(rt + i * 8) & 0x7FFF_FFFF_FFFF_FFFF;
        if (at > mt) { mt = at; }
        i = i + 1;
    }
    if (mt >= _M3_FLOOR) {
        if (_m3_cof_colcert(load64(t), load64(t + 8), load64(t + 16), load64(t + 24), load64(t + 32),
            load64(t + 40), load64(t + 48), load64(t + 56), load64(t + 64), mt) == 1) { return rt; }
        if (_m3_cof_certified(t, mt, sg, rt) == 1) { return rt; }
    }
    return _m3_cof_exact(m, sg);
}

# Trace
#must_use
public fn m3_trace(m) {
    return f64_add(f64_add(m3_get(m, 0, 0), m3_get(m, 1, 1)), m3_get(m, 2, 2));
}

#must_use
fn _m3_frob_scaled(m) {
    var mx = f64_from(0);
    var i = 0;
    while (i < 9) {
        var a = f64_abs(load64(m + i * 8));
        if (f64_gt(a, mx) == 1) { mx = a; }
        i = i + 1;
    }
    # ⚠ 3.3.3 — NaN never reaches here; see `_hvec3_len_scaled`. Called directly, this
    # loop never lets a NaN raise `mx`, so a NaN in any slot with the rest zero returns
    # 0. `m3_frobenius` routes a NaN to its sqrt(NaN) fast path instead, and
    # tests/abuse.tcyr pins that for all nine slots.
    # [measured: scratch harness, not reproducible in-tree, 2026-10-01; cycc 6.6.12]
    if (f64_gt(mx, 0) == 0) { return mx; }
    # ⚠ Inf/Inf is NaN, so the infinity contract needs its own exit here.
    if (f64_eq(mx, F64_POS_INF) == 1) { return mx; }
    var sum = f64_from(0);
    i = 0;
    while (i < 9) {
        var s = f64_div(load64(m + i * 8), mx);
        sum = f64_add(sum, f64_mul(s, s));
        i = i + 1;
    }
    return f64_mul(mx, f64_sqrt(sum));
}

# Frobenius norm
# ⛔ 2.17.0 — THIS SQUARED BEFORE SUMMING and was wrong on **992 of 2041
# binades**: `|k·I|` came back as exactly 0 for k below 2^-538 and as +Inf for k
# at or above 2^512, where the answer `k·sqrt(3)` is perfectly representable.
# ⚠ ONE ASSERTION GUARDED THIS FUNCTION — `m3_frobenius(I) = sqrt(3)` — at a
# single scale of 1, so nearly half the input range was untested and the defect
# was invisible however many times the suite ran.
# ⭐ Fast path plus a scaled rescue, the same shape as `hvec3_length`; nine legs
# has no stdlib hypot to delegate to, so the max-scale loop is written out.
# [measured: 2041-binade two-sided sweep on k·I, 2026-09-10]
#must_use
public fn m3_frobenius(m) {
    var sum = 0;
    var i = 0;
    while (i < 9) {
        var v = load64(m + i * 8);
        sum = f64_add(sum, f64_mul(v, v));
        i = i + 1;
    }
    if (f64_lt(sum, F64_TINY) == 1) { return _m3_frob_scaled(m); }
    if (f64_eq(sum, F64_POS_INF) == 1) { return _m3_frob_scaled(m); }
    return f64_sqrt(sum);
}
