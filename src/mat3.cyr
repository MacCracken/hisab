      f64_mul(l11, l22));
    var eq0 = f64_add(f64_add(f64_add(f64_sub(f64_mul(h21, h12), q0), f64_mul(h21, l12)), f64_mul(l21, h12)),
      f64_mul(l21, l12));
    var s0 = f64_sub(p0, q0); var z0 = f64_sub(s0, p0); var w0 = f64_sub(ep0, eq0);
    var u0 = f64_add(f64_sub(f64_sub(p0, f64_sub(s0, z0)), f64_add(q0, z0)), w0);
    var c0 = f64_add(s0, u0);
    var d0 = f64_mul(f64_add(u0 & 0x7FFF_FFFF_FFFF_FFFF, w0 & 0x7FFF_FFFF_FFFF_FFFF), _M3_W51);
    if (f64_add(s0, f64_add(u0, d0)) != c0 || f64_add(s0, f64_sub(u0, d0)) != c0) { ok = 0; }
    store64(r + 0, c0);
    var p1 = f64_mul(x21, x02); var q1 = f64_mul(x01, x22);
    if ((p1 & 0x7FFF_FFFF_FFFF_FFFF) < _M3_FLOOR && (x21 & 0x7FFF_FFFF_FFFF_FFFF) != 0
