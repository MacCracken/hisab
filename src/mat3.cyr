      f64_mul(l21, l02));
    var eq1 = f64_add(f64_add(f64_add(f64_sub(f64_mul(h01, h22), q1), f64_mul(h01, l22)), f64_mul(l01, h22)),
      f64_mul(l01, l22));
    var s1 = f64_sub(p1, q1); var z1 = f64_sub(s1, p1); var w1 = f64_sub(ep1, eq1);
    var u1 = f64_add(f64_sub(f64_sub(p1, f64_sub(s1, z1)), f64_add(q1, z1)), w1);
    var c1 = f64_add(s1, u1);
    var d1 = f64_mul(f64_add(u1 & 0x7FFF_FFFF_FFFF_FFFF, w1 & 0x7FFF_FFFF_FFFF_FFFF), _M3_W51);
    if (f64_add(s1, f64_add(u1, d1)) != c1 || f64_add(s1, f64_sub(u1, d1)) != c1) { ok = 0; }
    store64(r + 24, c1);
    var p2 = f64_mul(x01, x12); var q2 = f64_mul(x11, x02);
    if ((p2 & 0x7FFF_FFFF_FFFF_FFFF) < _M3_FLOOR && (x01 & 0x7FFF_FFFF_FFFF_FFFF) != 0
      && (x12 & 0x7FFF_FFFF_FFFF_FFFF) != 0) { return 2; }
    if ((q2 & 0x7FFF_FFFF_FFFF_FFFF) < _M3_FLOOR && (x11 & 0x7FFF_FFFF_FFFF_FFFF) != 0
      && (x02 & 0x7FFF_FFFF_FFFF_FFFF) != 0) { return 2; }
    var ep2 = f64_add(f64_add(f64_add(f64_sub(f64_mul(h01, h12), p2), f64_mul(h01, l12)), f64_mul(l01, h12)),
      f64_mul(l01, l12));
    var eq2 = f64_add(f64_add(f64_add(f64_sub(f64_mul(h11, h02), q2), f64_mul(h11, l02)), f64_mul(l11, h02)),
      f64_mul(l11, l02));
    var s2 = f64_sub(p2, q2); var z2 = f64_sub(s2, p2); var w2 = f64_sub(ep2, eq2);
    var u2 = f64_add(f64_sub(f64_sub(p2, f64_sub(s2, z2)), f64_add(q2, z2)), w2);
    var c2 = f64_add(s2, u2);
    var d2 = f64_mul(f64_add(u2 & 0x7FFF_FFFF_FFFF_FFFF, w2 & 0x7FFF_FFFF_FFFF_FFFF), _M3_W51);
    if (f64_add(s2, f64_add(u2, d2)) != c2 || f64_add(s2, f64_sub(u2, d2)) != c2) { ok = 0; }
    store64(r + 48, c2);
    var p3 = f64_mul(x20, x12); var q3 = f64_mul(x10, x22);
    if ((p3 & 0x7FFF_FFFF_FFFF_FFFF) < _M3_FLOOR && (x20 & 0x7FFF_FFFF_FFFF_FFFF) != 0
