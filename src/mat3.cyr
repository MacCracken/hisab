# mat3.cyr -- 3x3 f64 matrix type
# Usage: shipped inside dist/hisab.cyr; in-tree, include "src/mat3.cyr" after what it requires
# Requires: src/error.cyr, src/quat.cyr, src/vec3.cyr (stdlib resolves via cyrius.cyml [deps])
#
# Column-major flat allocation: 9 f64 values = 72 bytes.
# Layout: col0[3], col1[3], col2[3]

# Byte size of the column-major 3x3 grid (9 f64). Ties alloc + copy-loop
# bounds to a single named constant instead of a repeated magic literal.
#
# 3.4.0 (the [3.3.8] allocation row): every function here that allocates returns the designed 0
# when the allocation is refused (an exhausted heap), and every Result returns Err(HSB_ERR_ALLOC);
# none stores through a 0 handle. A 0 handle passed IN is the caller's.
public enum Mat3Layout { MAT3_BYTES = 72 }

# A new 3x3 zero matrix (72 bytes from the heap, every entry +0), column-major. Returns the
# designed 0 where the allocation is refused (3.4.0); so does every function here that returns
# a matrix or vector.
#must_use
public fn m3_new() {
    var m = alloc(MAT3_BYTES);
    if (m == 0) { return 0; }
    var i = 0;
    while (i < 9) { store64(m + i * 8, 0); i = i + 1; }
    return m;
}

# The 3x3 identity.
#must_use
public fn m3_identity() {
    var m = m3_new();
    if (m == 0) { return 0; }
    store64(m, F64_ONE);       # [0][0]
    store64(m + 32, F64_ONE);  # [1][1]
    store64(m + 64, F64_ONE);  # [2][2]
    return m;
}

# The entry at (col, row), column-major. RAW ACCESSOR, PRECONDITION NOT GUARD: col and row must
# be in [0, 2]; anything else reads outside the matrix (undefined), and a 0 handle faults.
#must_use
public fn m3_get(m, col, row) { return load64(m + (col * 3 + row) * 8); }
# Stores val at (col, row) and returns 0: `m3_get`'s precondition, and outside [0, 2] it writes
# outside the matrix.
public fn m3_set(m, col, row, val) { store64(m + (col * 3 + row) * 8, val); return 0; }

# A new matrix with src's nine entries, bit for bit.
#must_use
public fn m3_copy(src) {
    var dst = alloc(MAT3_BYTES);
    if (dst == 0) { return 0; }
    var i = 0;
    while (i < MAT3_BYTES) { store64(dst + i, load64(src + i)); i = i + 8; }
    return dst;
}

# The matrix whose columns are the HVec3s c0, c1, c2 (bits copied).
#must_use
public fn m3_from_cols(c0, c1, c2) {
    var m = alloc(MAT3_BYTES);
    if (m == 0) { return 0; }
    store64(m,      HVec3_x(c0)); store64(m + 8,  HVec3_y(c0)); store64(m + 16, HVec3_z(c0));
    store64(m + 24, HVec3_x(c1)); store64(m + 32, HVec3_y(c1)); store64(m + 40, HVec3_z(c1));
    store64(m + 48, HVec3_x(c2)); store64(m + 56, HVec3_y(c2)); store64(m + 64, HVec3_z(c2));
    return m;
}

# Column c (0, 1 or 2; unchecked, `m3_get`'s precondition) as a new HVec3.
#must_use
public fn m3_col(m, c) {
    var off = c * 24;
    return hvec3_new(load64(m + off), load64(m + off + 8), load64(m + off + 16));
}

# ================================================================
# Arithmetic
# ================================================================

# SIMD (column-major): C_col = Σ_k B[k][col]·A_col_k. Columns are 3 f64
# (24 bytes), so the over-read-safe pattern is n=2 on the xy rows + a
# scalar 3rd-row (z) tail per column accumulation.
#must_use
public fn m3_mul(a, b) {
    var c = m3_new();
    if (c == 0) { return 0; }
    var tmp = alloc(24);
    if (tmp == 0) { return 0; }
    var col = 0;
    while (col < 3) {
        var cc = c + col * 24;          # dest column (3 f64)
        var bc = b + col * 24;          # B's column `col`
        var b0 = load64(bc); var b1 = load64(bc + 8); var b2 = load64(bc + 16);
        f64v_scale(cc, a, b0, 2);
        store64(cc + 16, f64_mul(load64(a + 16), b0));
        f64v_scale(tmp, a + 24, b1, 2); f64v_add(cc, cc, tmp, 2);
        store64(cc + 16, f64_add(load64(cc + 16), f64_mul(load64(a + 40), b1)));
        f64v_scale(tmp, a + 48, b2, 2); f64v_add(cc, cc, tmp, 2);
        store64(cc + 16, f64_add(load64(cc + 16), f64_mul(load64(a + 64), b2)));
        col = col + 1;
    }
    return c;
}

# SIMD: result = Σ_k v[k]·M_col_k (xy via n=2, z scalar tail).
#
# The z tail accumulates in a LOCAL and is stored through the derived setter
# ONCE, at the end. ⚠ THIS IS NO LONGER LOAD-BEARING ON THE PINNED TOOLCHAIN --
# FIXED UPSTREAM IN cycc 6.6.5, and hisab's pin crossed it in 3.2.1. The natural
# form -- `HVec3_set_z(r, f64_add(HVec3_z(r), ..))` between the f64v_* calls --
# was WRONG CODE on cycc 6.6.0 through 6.6.4: the register picker rewrote the
# third `f64v_scale`'s destination-slot store into a register move while the
# inline loop still read the frame slot, so the packed store went through
# garbage -- `(1, 4, 3)` for `(4, 5, 3)`, and inside this tree a SIGSEGV. Filed
# 2026-09-14 and repaired in 6.6.5 as a classifier hole in the picker's unsafe
# scan (`_ra_plain_slot_mov`), wider than filed: every batch intrinsic, any
# `#inline`/derived call nested in another inline call's argument, no `#derive`
# needed. Verified here as a PAIR, not read off the changelog: the natural form
# in this file gives foundation 427/429 (x = 1, y = 4) under 6.6.4 and 429/429
# under 6.6.6, modules 2251/2251; the standalone repro exits 1 on 6.6.4 and 0 on
# 6.6.5 and 6.6.6, each from a dir pinned to that version.
# [measured: docs/development/issues/archived/2026-09-14-cyrius-simd-dst-slot-regalloc-picker.md, 2026-09-21]
#
# THE HOISTED FORM IS KEPT, for two stated reasons -- neither of them "it might
# still be broken": (1) consumers compile `dist/hisab.cyr` under their OWN pins,
# and six direct consumers (svara, naad, ghurni, prani, garjan, nidhi) plus three
# that carry the bundle transitively (jalwa, shabda, shabdakosh) pin cycc 6.6.3,
# below the 6.6.5 fix, where the natural form is SILENT wrong code. None of the nine
# takes a 3.x bundle yet: they carry hisab 2.11.2 or 2.22.1, whose raw `store64` z
# tail gives the right answer under 6.6.3 (a natural-form control in the same probe
# does not), so the hoist protects the first that moves to 3.x without bumping cycc.
# [measured: scratch harness, not reproducible in-tree, 2026-09-30; cycc 6.6.3 and 6.6.12]
# Read from their manifests 2026-09-30: prakash (6.6.6, the one consumer on 3.x,
# at 3.2.1), dhvani (6.6.10) and ranga (6.6.9) are past the fix, and goonj and
# attn11 pin 6.6.2, which cannot compile a 3.x bundle at all (hisab >= 3.1.0
# needs cycc >= 6.6.3). `m4_mul_vec4` dropped its hoist in 3.3.4: its inline
# form is not this shape, re-probed on 6.6.3 and 6.6.4 (see there).
# (2) 3.2.0 measured it at -6.5% against the raw `store64`/`load64` z tail it
# replaced (2.517 -> 2.353 us per 64, 3 of 3 pairs) -- fewer memory round trips
# on z. ⚠ That is the raw tail, NOT the natural accessor form, which crashed then
# and was never timed. The accumulation order is the natural form's (m16*vx, then
# +m40*vy, then +m64*vz), so the value is bit-identical. **Do not leave a comment
# claiming a workaround is required after it stops being required** -- this one
# says why it stays.
# [measured: CHANGELOG 3.2.0 "mat3 -- m3_mul_vec3", scratch harness, not reproducible in-tree]
# ⭐ 3.3.7 — THE NATURAL FORM, TIMED (roadmap D141), and the hoist is the faster of the
# three: on cycc 6.6.20 the hoisted tail 39 ns, the natural accessor form 42 (+7.7%) and the
# raw store64 tail 41 (+5.1%); 2,257 / 2,432 / 2,378 ns per 64. All three give the same bits.
# [measured: scratch pfb/focus.bcyr m3_mul_vec3, 3 builds interleaved x 7, 2026-10-31; cycc 6.6.20]
#must_use
public fn m3_mul_vec3(m, v) {
    var r = alloc(sizeof(HVec3));
    if (r == 0) { return 0; }
    var tmp = alloc(24);
    if (tmp == 0) { return 0; }
    var vx = HVec3_x(v); var vy = HVec3_y(v); var vz = HVec3_z(v);
    f64v_scale(r, m, vx, 2);
    var rz = f64_mul(load64(m + 16), vx);
    f64v_scale(tmp, m + 24, vy, 2); f64v_add(r, r, tmp, 2);
    rz = f64_add(rz, f64_mul(load64(m + 40), vy));
    f64v_scale(tmp, m + 48, vz, 2); f64v_add(r, r, tmp, 2);
    rz = f64_add(rz, f64_mul(load64(m + 64), vz));
    HVec3_set_z(r, rz);
    return r;
}

# The transpose, a new matrix, exact.
#must_use
public fn m3_transpose(m) {
    var t = m3_new();
    if (t == 0) { return 0; }
    var c = 0;
    while (c < 3) {
        var r = 0;
        while (r < 3) { m3_set(t, r, c, m3_get(m, c, r)); r = r + 1; }
        c = c + 1;
    }
    return t;
}

# det m by the cofactor expansion along row 0 (the entries m(0, 0), m(1, 0), m(2, 0) as
# (col, row)), in plain double arithmetic: within 5u P of the exact determinant to first
# order (u = 2^-53, P the permanent of |m|, the sum of the six products' magnitudes), so it can
# be far off relative to det for a nearly singular m, and its sign need not be det's.
# Overflow, underflow and NaN follow IEEE. `m3_inverse_checked` decides singularity exactly
# instead; this is the plain value.
#must_use
public fn m3_determinant(m) {
    var m00 = m3_get(m, 0, 0); var m01 = m3_get(m, 0, 1); var m02 = m3_get(m, 0, 2);
    var m10 = m3_get(m, 1, 0); var m11 = m3_get(m, 1, 1); var m12 = m3_get(m, 1, 2);
    var m20 = m3_get(m, 2, 0); var m21 = m3_get(m, 2, 1); var m22 = m3_get(m, 2, 2);
    return f64_add(f64_sub(f64_mul(m00, f64_sub(f64_mul(m11, m22), f64_mul(m21, m12))),
        f64_mul(m10, f64_sub(f64_mul(m01, m22), f64_mul(m21, m02)))),
      f64_mul(m20, f64_sub(f64_mul(m01, m12), f64_mul(m11, m02))));
}

# ================================================================
# Inverse (3.4.0: a Result; `m3_inverse` is retired)
# ================================================================

enum _M3Exact {
    _M3_PM_LO = 0x03F0_0000_0000_0000;   # 2^-960
    _M3_PM_HI = 0x7E70_0000_0000_0000;   # 2^1000
    _M3_CERT  = 0x4090_0000_0000_0000;   # 2^10
    _M3_SIGN  = 0x3CE0_0000_0000_0000;   # 2^-49
    _M3_TWO64 = 0x43F0_0000_0000_0000;   # 2^64
    _M3_FLOOR = 0x0360_0000_0000_0000;   # 2^-969
    _M3_QN_LO = 0x3FD0_0000_0000_0000;   # 0.25
    _M3_QN_HI = 0x4030_0000_0000_0000;   # 16.0
    _M3_LIMB  = 0x7FF_FFFF;              # 2^27 - 1, an integer: `_m3_xsum`'s limb mask
    _M3_SMALL = 0x2000_0000_0000_0000;   # 2^-511
    _M3_SPLIT = 0x41A0_0000_0200_0000;   # 2^27 + 1
    _M3_CERT2 = 0x42A0_0000_0000_0000;   # 2^43
    _M3_DD_LO = 0x07B0_0000_0000_0000;   # 2^-900
    _M3_UFL   = 0x0210_0000_0000_0000;   # 2^-990
    _M3_NCERT = 0x4020_0000_0000_0000;   # 2^3
    _M3_DDCERT = 0x4350_0000_0000_0000;  # 2^54
    _M3_WENT  = 0x7E3F_FFFF_FC00_0000;   # 2^997 - 2^970
    _M3_WPRD  = 0x7FE0_0000_0000_0000;   # 2^1023
    _M3_W51   = 0x3CC0_0000_0000_0000;   # 2^-51
    _M3_WT    = 508;                     # an integer: `_m3_cof_wequil`'s target exponent
    # An integer, -100000: below every exponent, "no entry". Written in hex because an enum
    # expression needs cycc >= 6.7.2 and the bundle compiles from 6.6.3.
    _M3_WNONE = 0xFFFF_FFFF_FFFE_7960;   # an integer sentinel
    _M3_WBAD  = 0x7FFF_FFFF_FFFF_FFFF;   # a NaN's bits, never a result of `_m3_wscale`
}

# x * 2^k, rounded once, for any integer k. Upward every step is exact or overflows; downward
# the remainder goes first, so each step before the last is exact, or is subnormal and the
# steps after it end at a zero, as x * 2^k rounds to.
fn _m3_ldexp(x, k) {
    while (k > 1023) { x = f64_mul(x, (1023 + 1023) << 52); k = k - 1023; }
    if (k >= 0) { return f64_mul(x, (1023 + k) << 52); }
    var m = (0 - k) / 1022;
    x = f64_mul(x, (1023 - ((0 - k) - m * 1022)) << 52);
    while (m > 0) { x = f64_mul(x, 0x0010_0000_0000_0000); m = m - 1; }   # 2^-1022
    return x;
}

# floor(log2 |x|) for a finite non-zero x, subnormals included.
fn _m3_expo(x) {
    var b = x & 0x7FFF_FFFF_FFFF_FFFF;
    if ((b >> 52) != 0) { return (b >> 52) - 1023; }
    return ((f64_mul(b, _M3_TWO64) >> 52) - 1023) - 64;
}

# ----------------------------------------------------------------
# Exact arithmetic over the whole double range (3.4.0)
# ----------------------------------------------------------------
# Every finite double is +-n * 2^e, n an integer below 2^53 and e in [-1074, 971], so a product
# of k entries is an integer below 2^(53 k) times 2^(e_1 + .. + e_k): no rounding, no range
# limit. `_m3_xsum` adds such products, signed, in base-2^27 integer limbs placed from k times
# the entries' least exponent up, so it decides zero exactly and rounds the sum once, to
# nearest with a sticky bit, for every finite input from the subnormals to DBL_MAX. (Through 3.4.0's review this was a
# double-precision expansion on a copy of m scaled row by row and column by column: the scaling
# rounded entries more than 2^1021 below their row's largest, and Dekker's product is inexact
# below 2^-969, so it answered Ok for matrices with two identical rows and refused invertible
# ones.) The engine is the inverse's third tier and the normal matrix's exact sign; its costs
# are theirs (the 4x4 determinant's 24 products of four entries: 1.8 us of mat4.cyr's 2.8 us
# singular refusal).
# [measured: scratch xs.bcyr, this tree, 2026-10-31; cycc 6.7.9]

# x (finite) into d[0..4): its significand n as base-2^27 limbs (low, high; 0 for +-0), its
# exponent e (|x| = n * 2^e) and its sign bit.
fn _m3_xdec(x, d) {
    var b = x & 0x7FFF_FFFF_FFFF_FFFF;
    var n = b & 0x000F_FFFF_FFFF_FFFF;
    var e = 0 - 1074;
    if ((b >> 52) != 0) { n = n | 0x0010_0000_0000_0000; e = (b >> 52) - 1075; }
    store64(d, n & _M3_LIMB);
    store64(d + 8, n >> 27);
    store64(d + 16, e);
    store64(d + 24, x >> 63);
    return 0;
}

# The least and greatest exponent of the non-zero entries among dc[0..ne) into er[0], er[1]
# (er[1] < er[0] when every one is zero): the bounds `_m3_xsum` places its terms by.
fn _m3_xrange(dc, ne, er) {
    var lo = 4096;
    var hi = 0 - 4096;
    var i = 0;
    while (i < ne) {
        var d = dc + i * 32;
        if ((load64(d) | load64(d + 8)) != 0) {
            var e = load64(d + 16);
            if (e < lo) { lo = e; }
            if (e > hi) { hi = e; }
        }
        i = i + 1;
    }
    store64(er, lo);
    store64(er + 8, hi);
    return 0;
}

# The significand product of term base's k entries (k = 2, 3) as base-2^27 limbs into pr, its
# exponent into pr[8] and its sign into pr[9]; returns the limb count, or 0 for a zero term.
# Every limb product is below 2^54 and every column sum below 2^57.
fn _m3_xprod(dc, base, k, pr) {
    var da = dc + load64(base) * 32;
    var db = dc + load64(base + 8) * 32;
    var a0 = load64(da); var a1 = load64(da + 8);
    var b0 = load64(db); var b1 = load64(db + 8);
    if ((a0 | a1) == 0 || (b0 | b1) == 0) { return 0; }
    store64(pr + 64, load64(da + 16) + load64(db + 16));
    store64(pr + 72, load64(da + 24) ^ load64(db + 24) ^ load64(base + k * 8));
    var t0 = a0 * b0;
    var t1 = a0 * b1 + a1 * b0 + (t0 >> 27);
    var t2 = a1 * b1 + (t1 >> 27);
    var p0 = t0 & _M3_LIMB; var p1 = t1 & _M3_LIMB; var p2 = t2 & _M3_LIMB; var p3 = t2 >> 27;
    if (k == 2) {
        store64(pr, p0); store64(pr + 8, p1); store64(pr + 16, p2); store64(pr + 24, p3);
        return 4;
    }
    var dg = dc + load64(base + 16) * 32;
    var c0 = load64(dg); var c1 = load64(dg + 8);
    if ((c0 | c1) == 0) { return 0; }
    store64(pr + 64, load64(pr + 64) + load64(dg + 16));
    store64(pr + 72, load64(pr + 72) ^ load64(dg + 24));
    {
        var u0 = p0 * c0;
        var u1 = p1 * c0 + p0 * c1 + (u0 >> 27);
        var u2 = p2 * c0 + p1 * c1 + (u1 >> 27);
        var u3 = p3 * c0 + p2 * c1 + (u2 >> 27);
        var u4 = p3 * c1 + (u3 >> 27);
        store64(pr, u0 & _M3_LIMB); store64(pr + 8, u1 & _M3_LIMB); store64(pr + 16, u2 & _M3_LIMB);
        store64(pr + 24, u3 & _M3_LIMB); store64(pr + 32, u4 & _M3_LIMB); store64(pr + 40, u4 >> 27);
        return 6;
    }
}

# The exact sum of nt signed products of k entries each: term t is the product of the entries
# dc[tl[t (k+1) + j]], j < k (four slots each, `_m3_xdec`), negated when tl[t (k+1) + k] is 1;
# er holds the entries' exponent bounds (`_m3_xrange`).
# Returns the sum's sign (1, -1, or 0 exactly when it is zero) and, when it is not zero, its
# magnitude rounded once to nearest as out[0] * 2^out[1], out[0] in [1, 2^62]. At most 32
# terms of at most 4 entries.
fn _m3_xsum(dc, er, tl, nt, k, out) {
    var acc: i64[320];
    var pr: i64[10];
    if (load64(er + 8) < load64(er)) { return 0; }   # every entry zero
    # every term is k entries' product: below 2^(53 k) in units of 2^(its exponent), which lies
    # in [k emin, k emax] (er: the entries' least and greatest exponents); a sum of at most 32
    # such terms needs 5 bits more
    var lo = k * load64(er);
    var w = (k * (load64(er + 8) - load64(er)) + 53 * k + 5) / 27 + 2;
    var i = 0;
    while (i < w) { store64(&acc + i * 8, 0); i = i + 1; }
    var t = 0;
    while (t < nt) {
        var n = _m3_xprod(dc, tl + t * (k + 1) * 8, k, &pr);
        if (n != 0) {
            var o = load64(&pr + 64) - lo;
            var ql = o / 27;
            var sh = o - ql * 27;
            var a = &acc + ql * 8;
            var pp = &pr;
            var pe = &pr + n * 8;
            if (load64(&pr + 72) == 0) {
                while (pp < pe) { store64(a, load64(a) + (load64(pp) << sh)); a = a + 8; pp = pp + 8; }
            } else {
                while (pp < pe) { store64(a, load64(a) - (load64(pp) << sh)); a = a + 8; pp = pp + 8; }
            }
        }
        t = t + 1;
    }
    # carries (floor, `>>>`): the top carry is 0 or -1, the sum's sign
    var c = 0;
    i = 0;
    while (i < w) {
        var v2 = load64(&acc + i * 8) + c;
        store64(&acc + i * 8, v2 & _M3_LIMB);
        c = v2 >>> 27;
        i = i + 1;
    }
    var res = 1;
    if (c < 0) {
        res = 0 - 1;
        c = 0;
        i = 0;
        while (i < w) {
            var v3 = c - load64(&acc + i * 8);
            store64(&acc + i * 8, v3 & _M3_LIMB);
            c = v3 >>> 27;
            i = i + 1;
        }
    }
    var h = w - 1;
    while (h >= 0 && load64(&acc + h * 8) == 0) { h = h - 1; }
    if (h < 0) { return 0; }
    # the top 62 bits, the rest folded into bit 0 (sticky): one rounding, to nearest
    var x = load64(&acc + h * 8);
    var nb = 0;
    var tt = x;
    while (tt != 0) { tt = tt >> 1; nb = nb + 1; }
    var pos = h * 27;
    var jb = h - 1;
    while (jb >= 0 && nb + 27 <= 62) {
        x = (x << 27) | load64(&acc + jb * 8);
        nb = nb + 27;
        pos = pos - 27;
        jb = jb - 1;
    }
    if (jb >= 0) {
        var take = 62 - nb;
        var lw = load64(&acc + jb * 8);
        x = (x << take) | (lw >> (27 - take));
        pos = pos - take;
        var st = lw & ((1 << (27 - take)) - 1);
        jb = jb - 1;
        while (jb >= 0) { st = st | load64(&acc + jb * 8); jb = jb - 1; }
        if (st != 0) { x = x | 1; }
    }
    store64(out, f64_from(x));
    store64(out + 8, pos + lo);
    return res;
}

# The two terms of the cofactor (-1)^(r+c) minor(r, c) of a 3x3 (entry (i, j) is index 3j + i)
# from term nt of tl on, each prefixed with the entry (r, c) itself when k is 3 (the terms of
# det along row r). Returns nt + 2.
fn _m3_minor_terms(tl, nt, r, c, k) {
    var r0 = 0;
    if (r == 0) { r0 = 1; }
    var r1 = 2;
    if (r == 2) { r1 = 1; }
    var c0 = 0;
    if (c == 0) { c0 = 1; }
    var c1 = 2;
    if (c == 2) { c1 = 1; }
    var s = (r + c) & 1;
    var p = tl + nt * (k + 1) * 8;
    if (k == 3) { store64(p, c * 3 + r); p = p + 8; }
    store64(p, c0 * 3 + r0);
    store64(p + 8, c1 * 3 + r1);
    store64(p + 16, s);
    p = p + 24;
    if (k == 3) { store64(p, c * 3 + r); p = p + 8; }
    store64(p, c1 * 3 + r0);
    store64(p + 8, c0 * 3 + r1);
    store64(p + 16, 1 - s);
    return nt + 2;
}

# det m's six terms (row 0's cofactor expansion) into tl; returns tl.
fn _m3_det_terms(tl) {
    _m3_minor_terms(tl, 0, 0, 0, 3);
    _m3_minor_terms(tl, 2, 0, 1, 3);
    _m3_minor_terms(tl, 4, 0, 2, 3);
    return tl;
}

# m's nine entries into dc (`_m3_xdec`) and their exponent bounds after them (`_m3_xrange`); 1
# when one is NaN or infinite (dc is then partial).
fn _m3_xload(m, dc) {
    var i = 0;
    while (i < 9) {
        var x = load64(m + i * 8);
        if ((x & 0x7FFF_FFFF_FFFF_FFFF) >= 0x7FF0_0000_0000_0000) { return 1; }
        _m3_xdec(x, dc + i * 32);
        i = i + 1;
    }
    _m3_xrange(dc, 9, dc + 9 * 32);
    return 0;
}

# The sign of det m, exactly: 1, -1, or 0 for a singular m; 1 for a NaN or infinite entry
# (`m3_normal_matrix_cof`'s orientation where its filter cannot certify one).
fn _m3_det_sign_exact(m) {
    var dc: i64[38];
    if (_m3_xload(m, &dc) == 1) { return 1; }
    var tl: i64[24];
    var od: i64[2];
    return _m3_xsum(&dc, &dc + 288, _m3_det_terms(&tl), 6, 3, &od);
}

# 1 when a row or a column of the 3x3 m is zero (`_m3_inverse_exact`'s quick refusal: a zero scale
# is the common singular matrix, and its exact determinant need not be summed).
fn _m3_zero_line(m) {
    var i = 0;
    while (i < 3) {
        var zr = 1;
        var zc = 1;
        var j = 0;
        while (j < 3) {
            if ((load64(m + (j * 3 + i) * 8) & 0x7FFF_FFFF_FFFF_FFFF) != 0) { zr = 0; }
            if ((load64(m + (i * 3 + j) * 8) & 0x7FFF_FFFF_FFFF_FFFF) != 0) { zc = 0; }
            j = j + 1;
        }
        if (zr == 1 || zc == 1) { return 1; }
        i = i + 1;
    }
    return 0;
}

# `m3_inverse_checked` where its filter cannot certify the cofactor formula: decided and
# answered exactly. Singular exactly when det, summed exactly from its six products, is zero;
# otherwise each entry is C_ji / det, the cofactor and the determinant each summed exactly and
# rounded once, divided once and scaled by a power of two, rounded once more only where the
# entry is subnormal or overflows (to +-Inf, as IEEE rounds a value beyond DBL_MAX). So an
# entry X is within (3u + 3u^2)|X| of the exact one (u = 2^-53), under 3 ulp, plus half a
# subnormal step where it is subnormal; an exact zero entry is +0.
fn _m3_inverse_exact(m) {
    var dc: i64[38];
    if (_m3_xload(m, &dc) == 1) { return Err(HSB_ERR_INVALID_INPUT); }
    if (_m3_zero_line(m) == 1) { return Err(HSB_ERR_SINGULAR_MATRIX); }
    var tl: i64[24];
    var od: i64[2];
    var sd = _m3_xsum(&dc, &dc + 288, _m3_det_terms(&tl), 6, 3, &od);
    if (sd == 0) { return Err(HSB_ERR_SINGULAR_MATRIX); }
    var r = m3_new();
    if (r == 0) { return Err(HSB_ERR_ALLOC); }
    var oc: i64[2];
    var row = 0;
    while (row < 3) {
        var col = 0;
        while (col < 3) {
            _m3_minor_terms(&tl, 0, row, col, 2);
            var sc = _m3_xsum(&dc, &dc + 288, &tl, 2, 2, &oc);
            var v = 0;
            if (sc != 0) {
                v = _m3_ldexp(f64_div(load64(&oc), load64(&od)), load64(&oc + 8) - load64(&od + 8));
                if (sc != sd) { v = v ^ 0x8000000000000000; }   # the sign bit: f64_neg gave +0 for +0 below cycc 6.6.8
            }
            # X = adj(m) / det: X(col, row) = C(row, col) / det, at index 3 row + col
            store64(r + (row * 3 + col) * 8, v);
            col = col + 1;
        }
        row = row + 1;
    }
    return Ok(r);
}

# M^-1 as `Ok(matrix)`, or `Err(HSB_ERR_SINGULAR_MATRIX)` exactly when M -- its nine entries
# taken as the exact rationals they are -- has determinant zero, or `Err(HSB_ERR_INVALID_INPUT)`
# for a NaN or infinite entry: decided exactly over the whole double range, subnormal to
# DBL_MAX. An entry whose exact value lies beyond DBL_MAX comes back +-Inf, IEEE's rounding of
# it, not an error: the matrix has an inverse, the other entries are right, and an Err would
# discard them.
#
# ⛔ 3.4.0 — `m3_inverse` RETURNED THE IDENTITY for a singular or NaN matrix, a full-rank,
# unit-determinant answer with no error channel (audit D088), and the reciprocal test that
# chose it (2.15.0) also misfired on ranges: 2^-400 I got the identity, not 2^400 I, because
# det = 2^-1200 underflows; 2^400 I got the ZERO matrix (det overflows, 1/det = 0). It is
# retired, not redefined.
# ⭐ Singular is decided EXACTLY, never by a threshold on det: no tolerance, absolute or
# relative, separates a singular matrix from a non-singular one ([[1, 1], [1, 1 + 2^-52]] has
# an exactly representable inverse and det/permanent = 2^-53). Three tiers answer, each where
# it is certified, the cheapest first (u = 2^-53, P the permanent of |M|: the expansion's
# products in absolute value):
#  1. The cofactor formula, 3.3.7's arithmetic bit for bit, where its determinant is good to
#     2^-40.7: |det - det~| <= 5u P (first order), and P <= 2^10 |det~|. With it, P in
#     [2^-960, 2^1000] and every non-zero entry at least 2^-511 (no product of two entries
#     flushes), and an answer whose entries are all finite.
#  2. Where 2^10 |det~| < P <= 2^43 |dd|: the formula's cofactors over a double-double
#     determinant dd (Dekker's exact products, TwoSum), within 30 u^2 P of det, so within
#     2^-58 of it before its own rounding. P >= 2^-900 and P >= 2^-960 max|row 0| keep the
#     products' error terms exact.
#  3. Everything else -- |det| below 2^-43 P (singular included), a small entry, a range the
#     products cannot hold, a non-finite answer -- `_m3_inverse_exact`, in exact integers.
# 2^10 and 2^43 are not tolerances; they only choose which tier answers. (Through the first
# 3.4.0 review there was no tier 2, tier 3 was a double-precision expansion that was not exact
# outside a range the contract never stated, and a row-0 clause let diag(2^-600, 2^1000,
# 2^-600) answer diag(2^600, 0, 2^600).)
# Accuracy, derived to first order: in tiers 1 and 2 an entry X_ij = C_ji / det is within
# (2u pC_ji + (e + 2u) |C_ji|) / |det|, pC_ji the permanent of its cofactor's minor and e the
# determinant's relative error (2^-40.7 in tier 1, 2^-58 + u in tier 2): the cofactors carry
# the formula's error relative to their permanents, which only a cancelling cofactor makes
# large beside the entry. Add half a subnormal step (2^-1075) where X_ij is below DBL_MIN: 1/det
# is normal (|det| <= P <= 2^1000) and every product of two entries is at least 2^-1022, so
# only the last product, 1/det times C, rounds on the subnormal grid (3.4.1: this term was not
# stated). In tier 3 X is within (3u + 3u^2) |X| (under 3 ulp), plus half a subnormal step
# where it is subnormal.
# Measured, against exact rational inverses (maxima of the stated samples, not bounds), in ulp of
# the largest exact entry: 2,000 random uniform matrices 230; r2 = r0 + r1 + noise 2^-k (200
# each) 434 at k = 4, 387 at k = 10, 6.1 .. 1.7 for k = 20 .. 50; 3,000 matrices with entries
# anywhere from 2^-1074 to 2^1023 (tier 3), every entry within 2.45 ulp of its own exact value.
# [measured: scratch t_m3acc.py / t_exact.py, Fraction oracle, 3.4.0 lane FB review repairs, 2026-10-31]
# Cost, against integ-snap7 and 3.3.7 (focused rows, the three binaries interleaved x 3): tier 1
# 79 -> 82 ns (3.3.7: 173); rows r2 = r0 + r1 + 2^-30 (tier 2) 2.39 us -> 231 ns (3.3.7: 174,
# with no correct digit); an exactly singular matrix 1.91 us -> 799 ns (3.3.7: 176, the identity).
# [measured: scratch inv_new.bcyr / inv_old.bcyr, 3.3.7 + integ-snap7 + this tree x 3, 2026-10-31; cycc 6.7.9]
# Tier 3 is the slow one, and its cost grows with the range the entries span (its exact sums
# work in 27-bit limbs across it): 13.3-13.7 us medians (runs 12.8-14.1) on a 3x3 whose
# exponents are drawn from 2^-1074 to 2^1023, a fifth of them subnormal (3.4.1; the [3.4.1]
# roadmap row quoted 15.3 us from another session). mat4.cyr's `m4_inverse_checked` states the
# 4x4's.
# [measured: scratch MAT4-i7 bv_same*.bcyr, 3 x 4 runs, load 2.2-2.7, 2026-11-01; cycc 6.7.18]
#must_use
public fn m3_inverse_checked(m) {
    var m00 = load64(m);      var m01 = load64(m + 8);  var m02 = load64(m + 16);
    var m10 = load64(m + 24); var m11 = load64(m + 32); var m12 = load64(m + 40);
    var m20 = load64(m + 48); var m21 = load64(m + 56); var m22 = load64(m + 64);
    var p0 = f64_mul(m11, m22); var p1 = f64_mul(m21, m12);
    var p2 = f64_mul(m01, m22); var p3 = f64_mul(m21, m02);
    var p4 = f64_mul(m01, m12); var p5 = f64_mul(m11, m02);
    var a0 = f64_sub(p0, p1);
    var a2 = f64_sub(p4, p5);
    var det = f64_add(f64_sub(f64_mul(m00, a0), f64_mul(m10, f64_sub(p2, p3))), f64_mul(m20, a2));
    var pm = f64_add(f64_add(f64_mul(f64_abs(m00), f64_add(f64_abs(p0), f64_abs(p1))),
        f64_mul(f64_abs(m10), f64_add(f64_abs(p2), f64_abs(p3)))),
      f64_mul(f64_abs(m20), f64_add(f64_abs(p4), f64_abs(p5))));
    # Every non-zero |entry| at least 2^-511, so no product of two entries flushes; on the bits.
    var small = 0;
    var st = 0;
    st = m00 & 0x7FFF_FFFF_FFFF_FFFF;
    if (st < _M3_SMALL) { if (st != 0) { small = 1; } }
    st = m01 & 0x7FFF_FFFF_FFFF_FFFF;
    if (st < _M3_SMALL) { if (st != 0) { small = 1; } }
    st = m02 & 0x7FFF_FFFF_FFFF_FFFF;
    if (st < _M3_SMALL) { if (st != 0) { small = 1; } }
    st = m10 & 0x7FFF_FFFF_FFFF_FFFF;
    if (st < _M3_SMALL) { if (st != 0) { small = 1; } }
    st = m11 & 0x7FFF_FFFF_FFFF_FFFF;
    if (st < _M3_SMALL) { if (st != 0) { small = 1; } }
    st = m12 & 0x7FFF_FFFF_FFFF_FFFF;
    if (st < _M3_SMALL) { if (st != 0) { small = 1; } }
    st = m20 & 0x7FFF_FFFF_FFFF_FFFF;
    if (st < _M3_SMALL) { if (st != 0) { small = 1; } }
    st = m21 & 0x7FFF_FFFF_FFFF_FFFF;
    if (st < _M3_SMALL) { if (st != 0) { small = 1; } }
    st = m22 & 0x7FFF_FFFF_FFFF_FFFF;
    if (st < _M3_SMALL) { if (st != 0) { small = 1; } }
    var certified = 0;
    if (small == 0 && f64_ge(pm, _M3_PM_LO) == 1 && f64_le(pm, _M3_PM_HI) == 1) {
        if (f64_le(pm, f64_mul(f64_abs(det), _M3_CERT)) == 1) {
            certified = 1;
        }
        if (certified == 0 && f64_ge(pm, _M3_DD_LO) == 1
          && f64_ge(pm, f64_mul(f64_max(f64_max(f64_abs(m00), f64_abs(m10)), f64_abs(m20)), _M3_PM_LO)) == 1) {
            # Every entry split into halves of at most 26 significant bits (Dekker), x = xh + xl.
            var t00 = f64_mul(m00, _M3_SPLIT); var h00 = f64_sub(t00, f64_sub(t00, m00)); var l00 = f64_sub(m00, h00);
            var t01 = f64_mul(m01, _M3_SPLIT); var h01 = f64_sub(t01, f64_sub(t01, m01)); var l01 = f64_sub(m01, h01);
            var t02 = f64_mul(m02, _M3_SPLIT); var h02 = f64_sub(t02, f64_sub(t02, m02)); var l02 = f64_sub(m02, h02);
            var t10 = f64_mul(m10, _M3_SPLIT); var h10 = f64_sub(t10, f64_sub(t10, m10)); var l10 = f64_sub(m10, h10);
            var t11 = f64_mul(m11, _M3_SPLIT); var h11 = f64_sub(t11, f64_sub(t11, m11)); var l11 = f64_sub(m11, h11);
            var t12 = f64_mul(m12, _M3_SPLIT); var h12 = f64_sub(t12, f64_sub(t12, m12)); var l12 = f64_sub(m12, h12);
            var t20 = f64_mul(m20, _M3_SPLIT); var h20 = f64_sub(t20, f64_sub(t20, m20)); var l20 = f64_sub(m20, h20);
            var t21 = f64_mul(m21, _M3_SPLIT); var h21 = f64_sub(t21, f64_sub(t21, m21)); var l21 = f64_sub(m21, h21);
            var t22 = f64_mul(m22, _M3_SPLIT); var h22 = f64_sub(t22, f64_sub(t22, m22)); var l22 = f64_sub(m22, h22);
            # The six products' rounding errors, exactly: x y = p + e.
            var ep0 = f64_add(f64_add(f64_add(f64_sub(f64_mul(h11, h22), p0), f64_mul(h11, l22)),
                f64_mul(l11, h22)), f64_mul(l11, l22));
            var ep1 = f64_add(f64_add(f64_add(f64_sub(f64_mul(h21, h12), p1), f64_mul(h21, l12)),
                f64_mul(l21, h12)), f64_mul(l21, l12));
            var ep2 = f64_add(f64_add(f64_add(f64_sub(f64_mul(h01, h22), p2), f64_mul(h01, l22)),
                f64_mul(l01, h22)), f64_mul(l01, l22));
            var ep3 = f64_add(f64_add(f64_add(f64_sub(f64_mul(h21, h02), p3), f64_mul(h21, l02)),
                f64_mul(l21, h02)), f64_mul(l21, l02));
            var ep4 = f64_add(f64_add(f64_add(f64_sub(f64_mul(h01, h12), p4), f64_mul(h01, l12)),
                f64_mul(l01, h12)), f64_mul(l01, l12));
            var ep5 = f64_add(f64_add(f64_add(f64_sub(f64_mul(h11, h02), p5), f64_mul(h11, l02)),
                f64_mul(l11, h02)), f64_mul(l11, l02));
            # Each 2x2 minor as hi + lo: hi the rounded difference, lo its TwoSum error plus the
            # products' errors.
            var a1 = f64_sub(p2, p3);
            var za0 = f64_sub(a0, p0);
            var xa0 = f64_add(f64_sub(f64_sub(p0, f64_sub(a0, za0)), f64_add(p1, za0)), f64_sub(ep0, ep1));
            var za1 = f64_sub(a1, p2);
            var xa1 = f64_add(f64_sub(f64_sub(p2, f64_sub(a1, za1)), f64_add(p3, za1)), f64_sub(ep2, ep3));
            var za2 = f64_sub(a2, p4);
            var xa2 = f64_add(f64_sub(f64_sub(p4, f64_sub(a2, za2)), f64_add(p5, za2)), f64_sub(ep4, ep5));
            # The three products m a of the expansion, each as q + r: q rounded, r its exact error plus
            # m a.lo.
            var va0 = f64_mul(a0, _M3_SPLIT); var ya0 = f64_sub(va0, f64_sub(va0, a0)); var wa0 = f64_sub(a0, ya0);
            var qa0 = f64_mul(m00, a0);
            var ra0 = f64_add(f64_add(f64_add(f64_add(f64_sub(f64_mul(h00, ya0), qa0), f64_mul(h00, wa0)),
                  f64_mul(l00, ya0)), f64_mul(l00, wa0)), f64_mul(m00, xa0));
            var va1 = f64_mul(a1, _M3_SPLIT); var ya1 = f64_sub(va1, f64_sub(va1, a1)); var wa1 = f64_sub(a1, ya1);
            var qa1 = f64_mul(m10, a1);
            var ra1 = f64_add(f64_add(f64_add(f64_add(f64_sub(f64_mul(h10, ya1), qa1), f64_mul(h10, wa1)),
                  f64_mul(l10, ya1)), f64_mul(l10, wa1)), f64_mul(m10, xa1));
            var va2 = f64_mul(a2, _M3_SPLIT); var ya2 = f64_sub(va2, f64_sub(va2, a2)); var wa2 = f64_sub(a2, ya2);
            var qa2 = f64_mul(m20, a2);
            var ra2 = f64_add(f64_add(f64_add(f64_add(f64_sub(f64_mul(h20, ya2), qa2), f64_mul(h20, wa2)),
                  f64_mul(l20, ya2)), f64_mul(l20, wa2)), f64_mul(m20, xa2));
            # det = q0 - q1 + q2 (as det~ orders them): the q summed by TwoSum, their errors and the r
            # in plain arithmetic, then the two rounded together.
            var dh = qa0;
            var dl = ra0;
            var na1 = f64_sub(dh, qa1);
            var oa1 = f64_sub(na1, dh);
            dl = f64_sub(f64_add(dl, f64_sub(f64_sub(dh, f64_sub(na1, oa1)), f64_add(qa1, oa1))), ra1);
            dh = na1;
            var na2 = f64_add(dh, qa2);
            var oa2 = f64_sub(na2, dh);
            dl = f64_add(f64_add(dl, f64_add(f64_sub(dh, f64_sub(na2, oa2)), f64_sub(qa2, oa2))), ra2);
            dh = na2;
            var dd = f64_add(dh, dl);
            # |dd - det| <= 30 u^2 P (the derivation is in the comment above), so P <= 2^43 |dd| puts
            # dd within 2^-58 of det, relative, before its own rounding.
            if (f64_le(pm, f64_mul(f64_abs(dd), _M3_CERT2)) == 1) {
                det = dd;
                certified = 1;
            }
        }
    }
    if (certified == 1) {
        var inv_det = f64_div(F64_ONE, det);
        var r = alloc(MAT3_BYTES);
        if (r == 0) { return Err(HSB_ERR_ALLOC); }
        var r0 = f64_mul(inv_det, a0);
        var r1 = f64_mul(inv_det, f64_sub(p3, p2));
        var r2 = f64_mul(inv_det, a2);
        var r3 = f64_mul(inv_det, f64_sub(f64_mul(m20, m12), f64_mul(m10, m22)));
        var r4 = f64_mul(inv_det, f64_sub(f64_mul(m00, m22), f64_mul(m20, m02)));
        var r5 = f64_mul(inv_det, f64_sub(f64_mul(m10, m02), f64_mul(m00, m12)));
        var r6 = f64_mul(inv_det, f64_sub(f64_mul(m10, m21), f64_mul(m20, m11)));
        var r7 = f64_mul(inv_det, f64_sub(f64_mul(m20, m01), f64_mul(m00, m21)));
        var r8 = f64_mul(inv_det, f64_sub(f64_mul(m00, m11), f64_mul(m10, m01)));
        store64(r, r0); store64(r + 8, r1); store64(r + 16, r2);
        store64(r + 24, r3); store64(r + 32, r4); store64(r + 40, r5);
        store64(r + 48, r6); store64(r + 56, r7); store64(r + 64, r8);
        # One test on the sum, non-finite whenever an entry is (an overflowing finite sum only
        # sends a finite answer to the exact path, which gives it again).
        var sm = f64_add(f64_add(f64_add(r0, r1), f64_add(r2, r3)),
          f64_add(f64_add(r4, r5), f64_add(f64_add(r6, r7), r8)));
        if ((sm & 0x7FFF_FFFF_FFFF_FFFF) < 0x7FF0_0000_0000_0000) { return Ok(r); }
    }
    return _m3_inverse_exact(m);
}

# a + b, entrywise, each entry correctly rounded.
#must_use
public fn m3_add(a, b) {
    var r = m3_new();
    if (r == 0) { return 0; }
    var i = 0;
    while (i < 9) {
        store64(r + i * 8, f64_add(load64(a + i * 8), load64(b + i * 8)));
        i = i + 1;
    }
    return r;
}

# m times the scalar s, each entry correctly rounded.
#must_use
public fn m3_scale(m, s) {
    var r = m3_new();
    if (r == 0) { return 0; }
    var i = 0;
    while (i < 9) {
        store64(r + i * 8, f64_mul(load64(m + i * 8), s));
        i = i + 1;
    }
    return r;
}

# The rotation matrix of q: R(q / |q|), the rotation q represents (q v q^-1), for every finite
# non-zero q, as `hquat_rotate_vec3` rotates by it. With s = 2 / |q|^2 the entries are the unit
# formula's with s for its 2 (1 - s (y^2 + z^2), s (xy + wz), ...), the standard form for a
# non-unit q. |q|^2 is used directly in [1/4, 16]; any other finite non-zero q is first scaled
# by a power of two to put its largest component in [1, 2) (the same rotation), so neither
# |q|^2 nor s can overflow or flush because of |q|. Where |q|^2 = 1.0 exactly, s = 2 and the
# arithmetic is 3.3.7's, bit for bit. A zero or non-finite q represents no rotation: the matrix
# is NaN (s = 2 / 0 = Inf, times 0), as `hquat_rotate_vec3` gives NaN.
# ⛔ 3.4.0 — THROUGH THE FIRST 3.4.0 REVIEW THIS WAS THE UNIT FORMULA FOR EVERY q, after
# `hquat_rotate_vec3` had moved to q / |q|: q = (0.154, 3.32, 3.86, -15.2) took (1, 1, -1) to
# (167.26, -175.48, 144.16) here and in `m4_from_srt` (so `t3d_to_matrix`) where `t3d_apply`
# gave (1.647, 0.313, -0.435), and q = 0 gave the identity, a rotation by nothing.
#must_use
public fn m3_from_quat(q) {
    var qx = HQuat_x(q); var qy = HQuat_y(q); var qz = HQuat_z(q); var qw = HQuat_w(q);
    var n = f64_add(f64_add(f64_mul(qx, qx), f64_mul(qy, qy)), f64_add(f64_mul(qz, qz), f64_mul(qw, qw)));
    # n is +0, positive or NaN, so its bits order as it does (quat.cyr's range test)
    if (n < _M3_QN_LO || n > _M3_QN_HI) {
        var mq = qx & 0x7FFF_FFFF_FFFF_FFFF;
        if ((qy & 0x7FFF_FFFF_FFFF_FFFF) > mq) { mq = qy & 0x7FFF_FFFF_FFFF_FFFF; }
        if ((qz & 0x7FFF_FFFF_FFFF_FFFF) > mq) { mq = qz & 0x7FFF_FFFF_FFFF_FFFF; }
        if ((qw & 0x7FFF_FFFF_FFFF_FFFF) > mq) { mq = qw & 0x7FFF_FFFF_FFFF_FFFF; }
        # A non-finite component: no rotation, so every entry is NaN. Without this an infinite
        # q gave n = +Inf, 2 / n = 0, and the diagonal entry whose products held no infinity
        # came back 1.0 (q = (Inf, 0, 0, 1): entry (0, 0)).
        if (mq >= 0x7FF0_0000_0000_0000) { n = 0x7FF8_0000_0000_0000; }
        if (mq != 0 && mq < 0x7FF0_0000_0000_0000) {
            var e = _m3_expo(mq);
            qx = _m3_ldexp(qx, 0 - e); qy = _m3_ldexp(qy, 0 - e);
            qz = _m3_ldexp(qz, 0 - e); qw = _m3_ldexp(qw, 0 - e);
            n = f64_add(f64_add(f64_mul(qx, qx), f64_mul(qy, qy)), f64_add(f64_mul(qz, qz), f64_mul(qw, qw)));
        }
    }
    var tw = F64_TWO;
    if (n != 0x3FF0_0000_0000_0000) { tw = f64_div(F64_TWO, n); }
    var xx = f64_mul(qx, qx); var yy = f64_mul(qy, qy); var zz = f64_mul(qz, qz);
    var xy = f64_mul(qx, qy); var xz = f64_mul(qx, qz); var yz = f64_mul(qy, qz);
    var wx = f64_mul(qw, qx); var wy = f64_mul(qw, qy); var wz = f64_mul(qw, qz);
    var m = m3_new();
    if (m == 0) { return 0; }
    m3_set(m, 0, 0, f64_sub(F64_ONE, f64_mul(tw, f64_add(yy, zz))));
    m3_set(m, 0, 1, f64_mul(tw, f64_add(xy, wz)));
    m3_set(m, 0, 2, f64_mul(tw, f64_sub(xz, wy)));
    m3_set(m, 1, 0, f64_mul(tw, f64_sub(xy, wz)));
    m3_set(m, 1, 1, f64_sub(F64_ONE, f64_mul(tw, f64_add(xx, zz))));
    m3_set(m, 1, 2, f64_mul(tw, f64_add(yz, wx)));
    m3_set(m, 2, 0, f64_mul(tw, f64_add(xz, wy)));
    m3_set(m, 2, 1, f64_mul(tw, f64_sub(yz, wx)));
    m3_set(m, 2, 2, f64_sub(F64_ONE, f64_mul(tw, f64_add(xx, yy))));
    return m;
}

# The signed cofactor matrix of m (`m3_normal_matrix_cof`'s body without its range rescue),
# negated when sg < 0, into a new matrix; returns it.
fn _m3_cof_signed(m, sg) {
    var m00 = load64(m);      var m01 = load64(m + 8);  var m02 = load64(m + 16);
    var m10 = load64(m + 24); var m11 = load64(m + 32); var m12 = load64(m + 40);
    var m20 = load64(m + 48); var m21 = load64(m + 56); var m22 = load64(m + 64);
    var r = alloc(MAT3_BYTES);
    if (r == 0) { return 0; }
    # N[i][j] = C[i][j], the (i, j) cofactor; column-major, so N at (col j, row i).
    store64(r,      f64_sub(f64_mul(m11, m22), f64_mul(m21, m12)));
    store64(r + 24, f64_sub(f64_mul(m21, m02), f64_mul(m01, m22)));
    store64(r + 48, f64_sub(f64_mul(m01, m12), f64_mul(m11, m02)));
    store64(r + 8,  f64_sub(f64_mul(m20, m12), f64_mul(m10, m22)));
    store64(r + 32, f64_sub(f64_mul(m00, m22), f64_mul(m20, m02)));
    store64(r + 56, f64_sub(f64_mul(m10, m02), f64_mul(m00, m12)));
    store64(r + 16, f64_sub(f64_mul(m10, m21), f64_mul(m20, m11)));
    store64(r + 40, f64_sub(f64_mul(m20, m01), f64_mul(m00, m21)));
    store64(r + 64, f64_sub(f64_mul(m00, m11), f64_mul(m10, m01)));
    if (sg < 0) {
        var i = 0;
        while (i < 9) { store64(r + i * 8, load64(r + i * 8) ^ 0x8000000000000000); i = i + 1; }
    }
    return r;
}

# The larger of a b, a c and b c for a, b, c >= 0 (as bits): the product of the two largest.
fn _m3_top2(a, b, c) {
    if (a < b) { var t = a; a = b; b = t; }
    if (b < c) { b = c; }
    return f64_mul(a, b);
}

# 1 when m's cofactor matrix r (computed, its largest |entry| mx as bits) is certified within
# 17u max of the exact one (u = 2^-53), replacing r by compensated minors where the plain ones
# are not: each plain minor a d - b c is within u (|a d| + |b c|) + u |c_ij| <= 2u G + u |c_ij|
# of its own value, G the largest |product| in any minor, so G <= 8 mx suffices. Every product
# in a minor takes its two entries from two different columns and two different rows, so G is
# at most the product of the two largest column maxima, and of the two largest row maxima:
# `m3_normal_matrix_cof` tries the columns (a matrix times a scale, R S) before calling this;
# here the rows (S R), then `_m3_cof_comp` forms G itself and, past 8 mx, the compensated
# minors. With mx at or above 2^-969, a subnormal product's 2^-1075 is below 2^-105 mx.
fn _m3_cof_certified(m, mx, sg, r) {
    var lim = f64_mul(mx, _M3_NCERT);
    var r0 = 0; var r1 = 0; var r2 = 0;
    var j = 0;
    while (j < 3) {
        var x0 = load64(m + j * 24) & 0x7FFF_FFFF_FFFF_FFFF;
        var x1 = load64(m + j * 24 + 8) & 0x7FFF_FFFF_FFFF_FFFF;
        var x2 = load64(m + j * 24 + 16) & 0x7FFF_FFFF_FFFF_FFFF;
        if (x0 > r0) { r0 = x0; }
        if (x1 > r1) { r1 = x1; }
        if (x2 > r2) { r2 = x2; }
        j = j + 1;
    }
    if (f64_le(_m3_top2(r0, r1, r2), lim) == 1) { return 1; }
    if (r1 > r0) { r0 = r1; }
    if (r2 > r0) { r0 = r2; }
    return _m3_cof_comp(m, sg, r, mx, r0);
}

# The products' half of `_m3_cof_certified` and `m3_normal_matrix_cof`'s middle tier (3.4.1
# review M1). G, the largest |product| of the eighteen in the nine minors a d - b c (rounded,
# as bits), first decides the plain minors in r: certified when G <= 8 mx (mx the largest
# |plain entry|). Otherwise every minor is recomputed compensated, both products split exactly
# (Dekker: x y = p + e, no FMA) and the difference summed with TwoSum, c~ = s + ((p - (s - z))
# - (q + z) + (ep - eq)) with s = p - q rounded: within u |c~| + 6u^2 G of the exact minor
# (first order). So G <= 2^54 max|c~| puts the matrix within 13u max|c~| of the exact one,
# normwise (15u with the subnormal losses below), inside the 17u the plain tier promises; it is
# written into r with sg applied (as `_m3_cof_signed` does). Returns 1 when r is certified, 0
# when the caller must take the exact path. me is m's largest |entry| (as bits).
# Its own steps overflow exactly where an entry is at or above 2^997 - 2^970 (x (2^27 + 1) past
# DBL_MAX) or where a product of two splits, which round up by up to 2^-26 of the entry, passes
# DBL_MAX (only for a product at or above 2^1023, `_m3_cof_hhovf`): those m go to
# `_m3_cof_wide` (3.4.1 round-2 review S1; the first form made such minors non-finite and
# declined them, so the exact path answered, at 50 to 94 times 3.4.0's time). Everywhere else
# nothing here overflows: |s| < 2^1021 past G > 8 mx. An error term of a product below 2^-969
# can lose bits, at most 2^-1072 a minor; this tier runs only past G > 8 mx >= 2^-966 (the
# callers' floor on mx) and certifies only max|c~| >= 2^-54 G > 2^-1020, so those losses add
# under 2u. (A floor test on max|c~| moved no answer under mutation and was dropped.)
fn _m3_cof_comp(m, sg, r, mx, me) {
    var m00 = load64(m + 0);
    var m01 = load64(m + 8);
    var m02 = load64(m + 16);
    var m10 = load64(m + 24);
    var m11 = load64(m + 32);
    var m12 = load64(m + 40);
    var m20 = load64(m + 48);
    var m21 = load64(m + 56);
    var m22 = load64(m + 64);
    var p0 = f64_mul(m11, m22); var q0 = f64_mul(m21, m12);
    var p1 = f64_mul(m21, m02); var q1 = f64_mul(m01, m22);
    var p2 = f64_mul(m01, m12); var q2 = f64_mul(m11, m02);
    var p3 = f64_mul(m20, m12); var q3 = f64_mul(m10, m22);
    var p4 = f64_mul(m00, m22); var q4 = f64_mul(m20, m02);
    var p5 = f64_mul(m10, m02); var q5 = f64_mul(m00, m12);
    var p6 = f64_mul(m10, m21); var q6 = f64_mul(m20, m11);
    var p7 = f64_mul(m20, m01); var q7 = f64_mul(m00, m21);
    var p8 = f64_mul(m00, m11); var q8 = f64_mul(m10, m01);
    var g = p0 & 0x7FFF_FFFF_FFFF_FFFF;
    var gq0 = q0 & 0x7FFF_FFFF_FFFF_FFFF; if (gq0 > g) { g = gq0; }
    var gp1 = p1 & 0x7FFF_FFFF_FFFF_FFFF; if (gp1 > g) { g = gp1; }
    var gq1 = q1 & 0x7FFF_FFFF_FFFF_FFFF; if (gq1 > g) { g = gq1; }
    var gp2 = p2 & 0x7FFF_FFFF_FFFF_FFFF; if (gp2 > g) { g = gp2; }
    var gq2 = q2 & 0x7FFF_FFFF_FFFF_FFFF; if (gq2 > g) { g = gq2; }
    var gp3 = p3 & 0x7FFF_FFFF_FFFF_FFFF; if (gp3 > g) { g = gp3; }
    var gq3 = q3 & 0x7FFF_FFFF_FFFF_FFFF; if (gq3 > g) { g = gq3; }
    var gp4 = p4 & 0x7FFF_FFFF_FFFF_FFFF; if (gp4 > g) { g = gp4; }
    var gq4 = q4 & 0x7FFF_FFFF_FFFF_FFFF; if (gq4 > g) { g = gq4; }
    var gp5 = p5 & 0x7FFF_FFFF_FFFF_FFFF; if (gp5 > g) { g = gp5; }
    var gq5 = q5 & 0x7FFF_FFFF_FFFF_FFFF; if (gq5 > g) { g = gq5; }
    var gp6 = p6 & 0x7FFF_FFFF_FFFF_FFFF; if (gp6 > g) { g = gp6; }
    var gq6 = q6 & 0x7FFF_FFFF_FFFF_FFFF; if (gq6 > g) { g = gq6; }
    var gp7 = p7 & 0x7FFF_FFFF_FFFF_FFFF; if (gp7 > g) { g = gp7; }
    var gq7 = q7 & 0x7FFF_FFFF_FFFF_FFFF; if (gq7 > g) { g = gq7; }
    var gp8 = p8 & 0x7FFF_FFFF_FFFF_FFFF; if (gp8 > g) { g = gp8; }
    var gq8 = q8 & 0x7FFF_FFFF_FFFF_FFFF; if (gq8 > g) { g = gq8; }
    if (f64_le(g, f64_mul(mx, _M3_NCERT)) == 1) { return 1; }
    if (me >= _M3_WENT) { return _m3_cof_wide(m, sg, r); }
    if (g >= _M3_WPRD) {
        if (_m3_cof_hhovf(m) == 1) { return _m3_cof_wide(m, sg, r); }
    }
    var t00 = f64_mul(m00, _M3_SPLIT); var h00 = f64_sub(t00, f64_sub(t00, m00)); var l00 = f64_sub(m00, h00);
    var t01 = f64_mul(m01, _M3_SPLIT); var h01 = f64_sub(t01, f64_sub(t01, m01)); var l01 = f64_sub(m01, h01);
    var t02 = f64_mul(m02, _M3_SPLIT); var h02 = f64_sub(t02, f64_sub(t02, m02)); var l02 = f64_sub(m02, h02);
    var t10 = f64_mul(m10, _M3_SPLIT); var h10 = f64_sub(t10, f64_sub(t10, m10)); var l10 = f64_sub(m10, h10);
    var t11 = f64_mul(m11, _M3_SPLIT); var h11 = f64_sub(t11, f64_sub(t11, m11)); var l11 = f64_sub(m11, h11);
    var t12 = f64_mul(m12, _M3_SPLIT); var h12 = f64_sub(t12, f64_sub(t12, m12)); var l12 = f64_sub(m12, h12);
    var t20 = f64_mul(m20, _M3_SPLIT); var h20 = f64_sub(t20, f64_sub(t20, m20)); var l20 = f64_sub(m20, h20);
    var t21 = f64_mul(m21, _M3_SPLIT); var h21 = f64_sub(t21, f64_sub(t21, m21)); var l21 = f64_sub(m21, h21);
    var t22 = f64_mul(m22, _M3_SPLIT); var h22 = f64_sub(t22, f64_sub(t22, m22)); var l22 = f64_sub(m22, h22);
    var cm = 0;
    var ep0 = f64_add(f64_add(f64_add(f64_sub(f64_mul(h11, h22), p0), f64_mul(h11, l22)), f64_mul(l11, h22)),
      f64_mul(l11, l22));
    var eq0 = f64_add(f64_add(f64_add(f64_sub(f64_mul(h21, h12), q0), f64_mul(h21, l12)), f64_mul(l21, h12)),
      f64_mul(l21, l12));
    var s0 = f64_sub(p0, q0); var z0 = f64_sub(s0, p0);
    var c0 = f64_add(s0, f64_add(f64_sub(f64_sub(p0, f64_sub(s0, z0)), f64_add(q0, z0)), f64_sub(ep0, eq0)));
    if ((c0 & 0x7FFF_FFFF_FFFF_FFFF) > cm) { cm = c0 & 0x7FFF_FFFF_FFFF_FFFF; }
    store64(r + 0, c0);
    var ep1 = f64_add(f64_add(f64_add(f64_sub(f64_mul(h21, h02), p1), f64_mul(h21, l02)), f64_mul(l21, h02)),
      f64_mul(l21, l02));
    var eq1 = f64_add(f64_add(f64_add(f64_sub(f64_mul(h01, h22), q1), f64_mul(h01, l22)), f64_mul(l01, h22)),
      f64_mul(l01, l22));
    var s1 = f64_sub(p1, q1); var z1 = f64_sub(s1, p1);
    var c1 = f64_add(s1, f64_add(f64_sub(f64_sub(p1, f64_sub(s1, z1)), f64_add(q1, z1)), f64_sub(ep1, eq1)));
    if ((c1 & 0x7FFF_FFFF_FFFF_FFFF) > cm) { cm = c1 & 0x7FFF_FFFF_FFFF_FFFF; }
    store64(r + 24, c1);
    var ep2 = f64_add(f64_add(f64_add(f64_sub(f64_mul(h01, h12), p2), f64_mul(h01, l12)), f64_mul(l01, h12)),
      f64_mul(l01, l12));
    var eq2 = f64_add(f64_add(f64_add(f64_sub(f64_mul(h11, h02), q2), f64_mul(h11, l02)), f64_mul(l11, h02)),
      f64_mul(l11, l02));
    var s2 = f64_sub(p2, q2); var z2 = f64_sub(s2, p2);
    var c2 = f64_add(s2, f64_add(f64_sub(f64_sub(p2, f64_sub(s2, z2)), f64_add(q2, z2)), f64_sub(ep2, eq2)));
    if ((c2 & 0x7FFF_FFFF_FFFF_FFFF) > cm) { cm = c2 & 0x7FFF_FFFF_FFFF_FFFF; }
    store64(r + 48, c2);
    var ep3 = f64_add(f64_add(f64_add(f64_sub(f64_mul(h20, h12), p3), f64_mul(h20, l12)), f64_mul(l20, h12)),
      f64_mul(l20, l12));
    var eq3 = f64_add(f64_add(f64_add(f64_sub(f64_mul(h10, h22), q3), f64_mul(h10, l22)), f64_mul(l10, h22)),
      f64_mul(l10, l22));
    var s3 = f64_sub(p3, q3); var z3 = f64_sub(s3, p3);
    var c3 = f64_add(s3, f64_add(f64_sub(f64_sub(p3, f64_sub(s3, z3)), f64_add(q3, z3)), f64_sub(ep3, eq3)));
    if ((c3 & 0x7FFF_FFFF_FFFF_FFFF) > cm) { cm = c3 & 0x7FFF_FFFF_FFFF_FFFF; }
    store64(r + 8, c3);
    var ep4 = f64_add(f64_add(f64_add(f64_sub(f64_mul(h00, h22), p4), f64_mul(h00, l22)), f64_mul(l00, h22)),
      f64_mul(l00, l22));
    var eq4 = f64_add(f64_add(f64_add(f64_sub(f64_mul(h20, h02), q4), f64_mul(h20, l02)), f64_mul(l20, h02)),
      f64_mul(l20, l02));
    var s4 = f64_sub(p4, q4); var z4 = f64_sub(s4, p4);
    var c4 = f64_add(s4, f64_add(f64_sub(f64_sub(p4, f64_sub(s4, z4)), f64_add(q4, z4)), f64_sub(ep4, eq4)));
    if ((c4 & 0x7FFF_FFFF_FFFF_FFFF) > cm) { cm = c4 & 0x7FFF_FFFF_FFFF_FFFF; }
    store64(r + 32, c4);
    var ep5 = f64_add(f64_add(f64_add(f64_sub(f64_mul(h10, h02), p5), f64_mul(h10, l02)), f64_mul(l10, h02)),
      f64_mul(l10, l02));
    var eq5 = f64_add(f64_add(f64_add(f64_sub(f64_mul(h00, h12), q5), f64_mul(h00, l12)), f64_mul(l00, h12)),
      f64_mul(l00, l12));
    var s5 = f64_sub(p5, q5); var z5 = f64_sub(s5, p5);
    var c5 = f64_add(s5, f64_add(f64_sub(f64_sub(p5, f64_sub(s5, z5)), f64_add(q5, z5)), f64_sub(ep5, eq5)));
    if ((c5 & 0x7FFF_FFFF_FFFF_FFFF) > cm) { cm = c5 & 0x7FFF_FFFF_FFFF_FFFF; }
    store64(r + 56, c5);
    var ep6 = f64_add(f64_add(f64_add(f64_sub(f64_mul(h10, h21), p6), f64_mul(h10, l21)), f64_mul(l10, h21)),
      f64_mul(l10, l21));
    var eq6 = f64_add(f64_add(f64_add(f64_sub(f64_mul(h20, h11), q6), f64_mul(h20, l11)), f64_mul(l20, h11)),
      f64_mul(l20, l11));
    var s6 = f64_sub(p6, q6); var z6 = f64_sub(s6, p6);
    var c6 = f64_add(s6, f64_add(f64_sub(f64_sub(p6, f64_sub(s6, z6)), f64_add(q6, z6)), f64_sub(ep6, eq6)));
    if ((c6 & 0x7FFF_FFFF_FFFF_FFFF) > cm) { cm = c6 & 0x7FFF_FFFF_FFFF_FFFF; }
    store64(r + 16, c6);
    var ep7 = f64_add(f64_add(f64_add(f64_sub(f64_mul(h20, h01), p7), f64_mul(h20, l01)), f64_mul(l20, h01)),
      f64_mul(l20, l01));
    var eq7 = f64_add(f64_add(f64_add(f64_sub(f64_mul(h00, h21), q7), f64_mul(h00, l21)), f64_mul(l00, h21)),
      f64_mul(l00, l21));
    var s7 = f64_sub(p7, q7); var z7 = f64_sub(s7, p7);
    var c7 = f64_add(s7, f64_add(f64_sub(f64_sub(p7, f64_sub(s7, z7)), f64_add(q7, z7)), f64_sub(ep7, eq7)));
    if ((c7 & 0x7FFF_FFFF_FFFF_FFFF) > cm) { cm = c7 & 0x7FFF_FFFF_FFFF_FFFF; }
    store64(r + 40, c7);
    var ep8 = f64_add(f64_add(f64_add(f64_sub(f64_mul(h00, h11), p8), f64_mul(h00, l11)), f64_mul(l00, h11)),
      f64_mul(l00, l11));
    var eq8 = f64_add(f64_add(f64_add(f64_sub(f64_mul(h10, h01), q8), f64_mul(h10, l01)), f64_mul(l10, h01)),
      f64_mul(l10, l01));
    var s8 = f64_sub(p8, q8); var z8 = f64_sub(s8, p8);
    var c8 = f64_add(s8, f64_add(f64_sub(f64_sub(p8, f64_sub(s8, z8)), f64_add(q8, z8)), f64_sub(ep8, eq8)));
    if ((c8 & 0x7FFF_FFFF_FFFF_FFFF) > cm) { cm = c8 & 0x7FFF_FFFF_FFFF_FFFF; }
    store64(r + 64, c8);
    if (f64_le(g, f64_mul(cm, _M3_DDCERT)) == 0) { return 0; }
    if (sg < 0) {
        var i = 0;
        while (i < 9) { store64(r + i * 8, load64(r + i * 8) ^ 0x8000000000000000); i = i + 1; }
    }
    return 1;
}

# True where some product x y of two entries of m in the minors (different rows and columns),
# at or above 2^1023, has a product of `_m3_cof_comp`'s splits that overflows (the splits round up
# by up to 2^-26 of the entry). Every entry below 2^997 - 2^970 (the caller's test), so each
# split is finite.
fn _m3_cof_hhovf(m) {
    var r1 = 0;
    while (r1 < 2) {
        var r2 = r1 + 1;
        while (r2 < 3) {
            var c1 = 0;
            while (c1 < 3) {
                var x = load64(m + (r1 * 3 + c1) * 8);
                var c2 = 0;
                while (c2 < 3) {
                    if (c2 != c1) {
                        var y = load64(m + (r2 * 3 + c2) * 8);
                        if ((f64_mul(x, y) & 0x7FFF_FFFF_FFFF_FFFF) >= _M3_WPRD) {
                            var tx = f64_mul(x, _M3_SPLIT);
                            var ty = f64_mul(y, _M3_SPLIT);
                            var hh = f64_mul(f64_sub(tx, f64_sub(tx, x)), f64_sub(ty, f64_sub(ty, y)));
                            if ((hh & 0x7FFF_FFFF_FFFF_FFFF) >= 0x7FF0_0000_0000_0000) { return 1; }
                        }
                    }
                    c2 = c2 + 1;
                }
                c1 = c1 + 1;
            }
            r2 = r2 + 1;
        }
        r1 = r1 + 1;
    }
    return 0;
}

# `_m3_cof_comp`'s compensated tier where its own steps overflow (3.4.1 round-2 review S1): an
# entry at or above 2^997 - 2^970, whose split x (2^27 + 1) passes DBL_MAX, or a product within
# about 2^-25 of DBL_MAX whose splits' product does (`_m3_cof_hhovf`). The first 3.4.1 form made
# those minors non-finite and declined, so the exact path answered, at 50 to 94 times 3.4.0's
# time; an answer is therefore kept here only where every entry is PROVED the exact cofactor's
# nearest double, which is the exact path's answer bit for bit.
# Two scalings, each by exact powers of two (3.4.1 round-3 review S1): the uniform m 2^-28, and
# where that pass declines for range (returns 2) `_m3_cof_wequil`'s, which puts every group's and
# then every position's largest entry at exponent 508. The second is what lets m with a row at
# 2^1000 and another at 2^-430 through: under the uniform scaling alone a product of two entries
# fell below the error-term floor and the exact path answered, at 92 to 109 times 3.4.0's time.
# Where a pass declines any other way the other cannot help: the same arithmetic on the same
# numbers. Returns 1 when r holds the answer, 0 when the caller must take the exact path.
fn _m3_cof_wide(m, sg, r) {
    var kv: i64[10];
    var i = 0;
    while (i < 9) { store64(&kv + i * 8, 0 - 28); i = i + 1; }
    store64(&kv + 72, 0 - 84);
    var rc = _m3_cof_wpass(m, sg, r, &kv);
    if (rc != 2) { return rc; }
    _m3_cof_wequil(m, &kv);
    return _m3_cof_wpass(m, sg, r, &kv) & 1;
}

# kv[i] = g(i / 3) + h(i % 3), the exponents of m's equilibrating powers of two, and kv[9] their
# sum over the three groups and three positions: g(X) puts group X's largest entry at exponent
# `_M3_WT`, then h(Y) does the same for position Y of the scaled matrix (0 for an all-zero group
# or position). Every h is then at least 0 and every scaled entry below 2^(`_M3_WT` + 1).
fn _m3_cof_wequil(m, kv) {
    var e: i64[9];
    var g: i64[3];
    var k = 0;
    var i = 0;
    while (i < 3) {
        var top = _M3_WNONE;
        var j = 0;
        while (j < 3) {
            var b = load64(m + (i * 3 + j) * 8);
            var ex = _M3_WNONE;
            if ((b & 0x7FFF_FFFF_FFFF_FFFF) != 0) { ex = _m3_expo(b); }
            store64(&e + (i * 3 + j) * 8, ex);
            if (ex > top) { top = ex; }
            j = j + 1;
        }
        var gi = 0;
        if (top != _M3_WNONE) { gi = _M3_WT - top; }
        store64(&g + i * 8, gi);
        k = k + gi;
        i = i + 1;
    }
    var y = 0;
    while (y < 3) {
        var ty = _M3_WNONE;
        var x = 0;
        while (x < 3) {
            var v = load64(&e + (x * 3 + y) * 8);
            if (v != _M3_WNONE) {
                v = v + load64(&g + x * 8);
                if (v > ty) { ty = v; }
            }
            x = x + 1;
        }
        var hy = 0;
        if (ty != _M3_WNONE) { hy = _M3_WT - ty; }
        k = k + hy;
        x = 0;
        while (x < 3) {
            store64(kv + (x * 3 + y) * 8, load64(&g + x * 8) + hy);
            x = x + 1;
        }
        y = y + 1;
    }
    store64(kv + 72, k);
    return 0;
}

# x 2^k where a double holds it exactly, `_M3_WBAD` otherwise (x finite, k >= -515, so 2^(ne - 1)
# and 2^(1 - ne) below are normal). Never rounds: a result that lands below DBL_MIN is formed
# by one multiplication and read back.
fn _m3_wscale(x, k) {
    if ((x & 0x7FFF_FFFF_FFFF_FFFF) == 0) { return x; }
    var b = x;
    var e = (x & 0x7FFF_FFFF_FFFF_FFFF) >> 52;
    if (e == 0) {
        b = f64_mul(x, _M3_TWO64);
        e = (b & 0x7FFF_FFFF_FFFF_FFFF) >> 52;
        k = k - 64;
    }
    var ne = e + k;
    if (ne >= 1) { return b + (k << 52); }
    var c = b + ((1 - e) << 52);
    var t = f64_mul(c, (1022 + ne) << 52);
    if (f64_mul(t, (1024 - ne) << 52) != c) { return _M3_WBAD; }
    return t;
}

# c 2^s rounded once (c finite, the result at most DBL_MAX). Below DBL_MIN the multiplication by
# 2^(ne - 1) is that one rounding; past 2^-64 the factor stays 2^-64, whose product with a value
# below 2^-1021 already rounds to a zero of c's sign.
fn _m3_wout(c, s) {
    if ((c & 0x7FFF_FFFF_FFFF_FFFF) == 0) { return c; }
    var b = c;
    var e = (c & 0x7FFF_FFFF_FFFF_FFFF) >> 52;
    if (e == 0) {
        b = f64_mul(c, _M3_TWO64);
        e = (b & 0x7FFF_FFFF_FFFF_FFFF) >> 52;
        s = s - 64;
    }
    var ne = e + s;
    if (ne >= 1) { return b + (s << 52); }
    var sh = ne - 1;
    if (sh < 0 - 64) { sh = 0 - 64; }
    return f64_mul(b + ((1 - e) << 52), (1023 + sh) << 52);
}

# One pass of `_m3_cof_wide`: t, each entry of m scaled by its own kv[i] (i in memory order), so
# that t's cofactor at slot i is m's times 2^(kv[9] - kv[i]) (cof(D1 m D2) is cof(m) with each
# entry scaled by the other two groups' and positions' powers). kv[i] is g(X) + h(Y) with sum
# kv[9], and t's entries are below 2^509 (`_m3_cof_wequil`) or 2^996 (the uniform 2^-28): neither
# a split nor a product of splits can overflow. It returns 2 (the range declined it) where t is
# not m's scaling exactly, or where a product of two non-zero entries of t falls below 2^-969,
# whose error term can lose bits (Dekker's product is exact when the exponents sum to -970 or
# more); otherwise every error term is exact and the exact minor is c = s + es + ep - eq, a
# multiple of 2^-1074, so a c below 2^-1021 is exact in a double. With w = ep - eq and u = es + w
# rounded, c = s + u + e where e, the two roundings' error, is at most 2^-53 (|u| + |w|) (each is
# 0 where its result is below 2^-1021: such a sum is exact). With d = 2^-51 (|u| + |w|), rounded,
# u + d and u - d rounded still bracket u + e; so where s + (u + d) and s + (u - d) both round to
# c~ = s + u rounded, every value between them does (rounding is monotone), c included: c~ is c
# rounded to 53 bits. Then the answer is c~ 2^(kv[i] - kv[9]) rounded once (`_m3_wout`), with sg
# applied, and it is the exact path's bits in every entry: that path rounds each cofactor to 53
# bits and then once more into range. c~ is never -0 (its last sum is -0 only from two -0, and
# Dekker's error of a product never is: hh - p is +0 where both are zeros of one sign). The exact
# path's own scaling cannot apply. It scales where the largest cofactor passes 2^1023, but the
# caller is past G > 8 mx, so every plain minor is below 2^1021 and every c within 2^-52 G of its
# plain minor. And it scales where the largest is below 2^-969, but m holds a large entry (at
# or above 2^997 - 2^970, or the larger factor, at least 2^511, of a product at or above 2^1023),
# and each of the four minors holding it is a multiple of its grid (at least 2^459) times 2^-1074:
# 0 or at least 2^-615; and where all four are 0 the matrix has rank 1, every cofactor 0.
# It returns 0 where the bracket fails.
fn _m3_cof_wpass(m, sg, r, kv) {
    var x00 = _m3_wscale(load64(m + 0), load64(kv + 0));
    if (x00 == _M3_WBAD) { return 2; }
    var x01 = _m3_wscale(load64(m + 8), load64(kv + 8));
    if (x01 == _M3_WBAD) { return 2; }
    var x02 = _m3_wscale(load64(m + 16), load64(kv + 16));
    if (x02 == _M3_WBAD) { return 2; }
    var x10 = _m3_wscale(load64(m + 24), load64(kv + 24));
    if (x10 == _M3_WBAD) { return 2; }
    var x11 = _m3_wscale(load64(m + 32), load64(kv + 32));
    if (x11 == _M3_WBAD) { return 2; }
    var x12 = _m3_wscale(load64(m + 40), load64(kv + 40));
    if (x12 == _M3_WBAD) { return 2; }
    var x20 = _m3_wscale(load64(m + 48), load64(kv + 48));
    if (x20 == _M3_WBAD) { return 2; }
    var x21 = _m3_wscale(load64(m + 56), load64(kv + 56));
    if (x21 == _M3_WBAD) { return 2; }
    var x22 = _m3_wscale(load64(m + 64), load64(kv + 64));
    if (x22 == _M3_WBAD) { return 2; }
    var t00 = f64_mul(x00, _M3_SPLIT); var h00 = f64_sub(t00, f64_sub(t00, x00)); var l00 = f64_sub(x00, h00);
    var t01 = f64_mul(x01, _M3_SPLIT); var h01 = f64_sub(t01, f64_sub(t01, x01)); var l01 = f64_sub(x01, h01);
    var t02 = f64_mul(x02, _M3_SPLIT); var h02 = f64_sub(t02, f64_sub(t02, x02)); var l02 = f64_sub(x02, h02);
    var t10 = f64_mul(x10, _M3_SPLIT); var h10 = f64_sub(t10, f64_sub(t10, x10)); var l10 = f64_sub(x10, h10);
    var t11 = f64_mul(x11, _M3_SPLIT); var h11 = f64_sub(t11, f64_sub(t11, x11)); var l11 = f64_sub(x11, h11);
    var t12 = f64_mul(x12, _M3_SPLIT); var h12 = f64_sub(t12, f64_sub(t12, x12)); var l12 = f64_sub(x12, h12);
    var t20 = f64_mul(x20, _M3_SPLIT); var h20 = f64_sub(t20, f64_sub(t20, x20)); var l20 = f64_sub(x20, h20);
    var t21 = f64_mul(x21, _M3_SPLIT); var h21 = f64_sub(t21, f64_sub(t21, x21)); var l21 = f64_sub(x21, h21);
    var t22 = f64_mul(x22, _M3_SPLIT); var h22 = f64_sub(t22, f64_sub(t22, x22)); var l22 = f64_sub(x22, h22);
    var ok = 1;
    var p0 = f64_mul(x11, x22); var q0 = f64_mul(x21, x12);
    if ((p0 & 0x7FFF_FFFF_FFFF_FFFF) < _M3_FLOOR && (x11 & 0x7FFF_FFFF_FFFF_FFFF) != 0
