            var t01 = f64_mul(m01, _M4_SPLIT); var h01 = f64_sub(t01, f64_sub(t01, m01)); var l01 = f64_sub(m01, h01);
            var t02 = f64_mul(m02, _M4_SPLIT); var h02 = f64_sub(t02, f64_sub(t02, m02)); var l02 = f64_sub(m02, h02);
            var t03 = f64_mul(m03, _M4_SPLIT); var h03 = f64_sub(t03, f64_sub(t03, m03)); var l03 = f64_sub(m03, h03);
            var t10 = f64_mul(m10, _M4_SPLIT); var h10 = f64_sub(t10, f64_sub(t10, m10)); var l10 = f64_sub(m10, h10);
            var t11 = f64_mul(m11, _M4_SPLIT); var h11 = f64_sub(t11, f64_sub(t11, m11)); var l11 = f64_sub(m11, h11);
            var t12 = f64_mul(m12, _M4_SPLIT); var h12 = f64_sub(t12, f64_sub(t12, m12)); var l12 = f64_sub(m12, h12);
            var t13 = f64_mul(m13, _M4_SPLIT); var h13 = f64_sub(t13, f64_sub(t13, m13)); var l13 = f64_sub(m13, h13);
            var t20 = f64_mul(m20, _M4_SPLIT); var h20 = f64_sub(t20, f64_sub(t20, m20)); var l20 = f64_sub(m20, h20);
            var t21 = f64_mul(m21, _M4_SPLIT); var h21 = f64_sub(t21, f64_sub(t21, m21)); var l21 = f64_sub(m21, h21);
            var t22 = f64_mul(m22, _M4_SPLIT); var h22 = f64_sub(t22, f64_sub(t22, m22)); var l22 = f64_sub(m22, h22);
            var t23 = f64_mul(m23, _M4_SPLIT); var h23 = f64_sub(t23, f64_sub(t23, m23)); var l23 = f64_sub(m23, h23);
            var t30 = f64_mul(m30, _M4_SPLIT); var h30 = f64_sub(t30, f64_sub(t30, m30)); var l30 = f64_sub(m30, h30);
            var t31 = f64_mul(m31, _M4_SPLIT); var h31 = f64_sub(t31, f64_sub(t31, m31)); var l31 = f64_sub(m31, h31);
            var t32 = f64_mul(m32, _M4_SPLIT); var h32 = f64_sub(t32, f64_sub(t32, m32)); var l32 = f64_sub(m32, h32);
            var t33 = f64_mul(m33, _M4_SPLIT); var h33 = f64_sub(t33, f64_sub(t33, m33)); var l33 = f64_sub(m33, h33);
