            var eg2 = f64_add(f64_add(f64_add(f64_sub(f64_mul(h20, h33), g2), f64_mul(h20, l33)),
                f64_mul(l20, h33)), f64_mul(l20, l33));
            var eh2 = f64_add(f64_add(f64_add(f64_sub(f64_mul(h30, h23), h2), f64_mul(h30, l23)),
                f64_mul(l30, h23)), f64_mul(l30, l23));
            var eg1 = f64_add(f64_add(f64_add(f64_sub(f64_mul(h20, h32), g1), f64_mul(h20, l32)),
                f64_mul(l20, h32)), f64_mul(l20, l32));
            var eh1 = f64_add(f64_add(f64_add(f64_sub(f64_mul(h30, h22), h1), f64_mul(h30, l22)),
                f64_mul(l30, h22)), f64_mul(l30, l22));
            var eg0 = f64_add(f64_add(f64_add(f64_sub(f64_mul(h20, h31), g0), f64_mul(h20, l31)),
                f64_mul(l20, h31)), f64_mul(l20, l31));
            var eh0 = f64_add(f64_add(f64_add(f64_sub(f64_mul(h30, h21), h0), f64_mul(h30, l21)),
                f64_mul(l30, h21)), f64_mul(l30, l21));
            # Each 2x2 minor as hi + lo: hi the rounded difference, lo its TwoSum error plus the
            # products' errors (rounded twice, within 3u^2 of the minor's permanent).
