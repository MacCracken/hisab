# mat4.cyr -- 4x4 f64 matrix type
# Usage: shipped inside dist/hisab.cyr; in-tree, include "src/mat4.cyr" after what it requires
# Requires: src/error.cyr, src/quat.cyr, src/vec3.cyr, src/vec4.cyr
#           (stdlib resolves via cyrius.cyml [deps]; f64_util not since 3.3.4 retired its f64_tan)
#
# Column-major flat allocation: 16 f64 values = 128 bytes.
# Layout: col0[4], col1[4], col2[4], col3[4]
# Access: m4_get(m, col, row)

# The f64 and integer constants of the inverse's and transform_point's filters and exact paths.
enum _M4Exact {
    _M4_PM_LO = 0x03F0_0000_0000_0000;   # 2^-960
    _M4_PM_HI = 0x7E70_0000_0000_0000;   # 2^1000
    _M4_CERT  = 0x4090_0000_0000_0000;   # 2^10
    _M4_SPLIT = 0x41A0_0000_0200_0000;   # 2^27 + 1
    _M4_TWO64 = 0x43F0_0000_0000_0000;   # 2^64
    _M4_LIMB  = 0x7FF_FFFF;              # 2^27 - 1, an integer: `_m4_xsum`'s limb mask
    _M4_W_LO  = 0x03F0_0000_0000_0000;   # 2^-960
    _M4_W_CERT = 0x4130_0000_0000_0000;  # 2^20
    _M4_QN_LO = 0x3FD0_0000_0000_0000;   # 0.25
    _M4_QN_HI = 0x4030_0000_0000_0000;   # 16.0
    _M4_SMALL = 0x2AB0_0000_0000_0000;   # 2^-340
    _M4_CERT2 = 0x42A0_0000_0000_0000;   # 2^43
    _M4_DD_LO = 0x07B0_0000_0000_0000;   # 2^-900
}

# Byte size of the column-major 4x4 grid (16 f64). Ties alloc + copy-loop
# bounds to a single named constant instead of a repeated magic literal.
#
# 3.4.0 (the [3.3.8] allocation row): every function here that allocates returns the designed 0
# when the allocation is refused (an exhausted heap), and every Result returns Err(HSB_ERR_ALLOC);
# none stores through a 0 handle. A 0 handle passed IN is the caller's.
public enum Mat4Layout { MAT4_BYTES = 128 }

# Allocate zeroed 4x4 matrix
#must_use
public fn m4_new() {
    var m = alloc(MAT4_BYTES);
    if (m == 0) { return 0; }
    var i = 0;
    while (i < 16) {
        store64(m + i * 8, 0);
        i = i + 1;
    }
    return m;
}

#must_use
public fn m4_identity() {
    var m = m4_new();
    if (m == 0) { return 0; }
    store64(m,       F64_ONE);  # [0][0]
    store64(m + 40,  F64_ONE);  # [1][1]
    store64(m + 80,  F64_ONE);  # [2][2]
    store64(m + 120, F64_ONE);  # [3][3]
    return m;
}

# Contract: col and row must be in [0, 3]. Out-of-bounds is undefined behavior.
#must_use
public fn m4_get(m, col, row) {
    return load64(m + (col * 4 + row) * 8);
}

public fn m4_set(m, col, row, val) {
    store64(m + (col * 4 + row) * 8, val);
    return 0;
}

#must_use
public fn m4_copy(src) {
    var dst = alloc(MAT4_BYTES);
    if (dst == 0) { return 0; }
    var i = 0;
    while (i < MAT4_BYTES) {
        store64(dst + i, load64(src + i));
        i = i + 8;
    }
    return dst;
}

# ================================================================
# Column construction
# ================================================================

#must_use
public fn m4_from_cols(c0, c1, c2, c3) {
    var m = alloc(MAT4_BYTES);
    if (m == 0) { return 0; }
    store64(m,       HVec4_x(c0)); store64(m + 8,   HVec4_y(c0));
    store64(m + 16,  HVec4_z(c0)); store64(m + 24,  HVec4_w(c0));
    store64(m + 32,  HVec4_x(c1)); store64(m + 40,  HVec4_y(c1));
    store64(m + 48,  HVec4_z(c1)); store64(m + 56,  HVec4_w(c1));
    store64(m + 64,  HVec4_x(c2)); store64(m + 72,  HVec4_y(c2));
    store64(m + 80,  HVec4_z(c2)); store64(m + 88,  HVec4_w(c2));
    store64(m + 96,  HVec4_x(c3)); store64(m + 104, HVec4_y(c3));
    store64(m + 112, HVec4_z(c3)); store64(m + 120, HVec4_w(c3));
    return m;
}

#must_use
public fn m4_col(m, c) {
    var off = c * 32;
    return hvec4_new(load64(m + off), load64(m + off + 8),
      load64(m + off + 16), load64(m + off + 24));
}

# ================================================================
# Multiply: C = A * B
# ================================================================

# SIMD (column-major): each result column is a linear combination of A's
# columns weighted by B's column entries — C_col = Σ_k B[k][col]·A_col_k.
# A's and C's columns are contiguous 4-f64 spans (n=4, no over-read).
#must_use
public fn m4_mul(a, b) {
    var c = m4_new();
    if (c == 0) { return 0; }
    var tmp = alloc(32);
    if (tmp == 0) { return 0; }
    var col = 0;
    while (col < 4) {
        var cc = c + col * 32;          # dest column (contiguous)
        var bc = b + col * 32;          # B's column `col` (contiguous)
        f64v_scale(cc, a + 0, load64(bc + 0), 4);
        f64v_scale(tmp, a + 32, load64(bc + 8), 4); f64v_add(cc, cc, tmp, 4);
        f64v_scale(tmp, a + 64, load64(bc + 16), 4); f64v_add(cc, cc, tmp, 4);
        f64v_scale(tmp, a + 96, load64(bc + 24), 4); f64v_add(cc, cc, tmp, 4);
        col = col + 1;
    }
    return c;
}

# Mat4 * Vec4 — SIMD: result = Σ_k v[k]·M_col_k (M's columns contiguous).
#
# Each scalar goes straight into `f64v_scale` as `HVec4_x(v)`. From 2.11.3 until
# 3.3.4 vx..vw were hoisted into locals first, because on the 6.6.1 bump this form
# was WRONG CODE — the SIMD destination-slot miscompile in the history below,
# fixed upstream in cycc 6.6.2. 2.11.5 verified the inline form on 6.6.2 (hisab
# 416, foundation 351, abuse 741, rc=0 each) and kept the hoist only to match
# `m3_mul_vec3`. [measured: scratch harness, not reproducible in-tree, 2026-09-09; cycc 6.6.2]
#
# ⭐ The inline form is also clear of the LATER defect that keeps `m3_mul_vec3`
# hoisted (through 6.6.4: the register picker leaves an `f64v_*` operand slot
# unwritten; fixed in 6.6.5; see mat3.cyr). Re-probed on 6.6.3 through 6.6.14,
# every cycc that compiles a 3.x bundle, with the bundle in a consumer-shaped
# program: 70,000 calls on 10,000 full-mantissa draws of M and v, specials mixed
# in (direct, and through m4_transform_point/_dir, world_to_screen and
# screen_to_world_ray), are bit-identical to the hoisted form on every pin; this
# function's machine code is the same on every pin (address-normalised); and each
# of the 21 operand slots its seven kernels read is written. The same harness SEES
# the defect: m3's inline form gives (1, 4, 3) for (4, 5, 3), and 10,000 of 10,000
# mismatches, on 6.6.3 and 6.6.4, and none from 6.6.5. Here the getters are
# arguments of a batch intrinsic, not of another inline call, which is the trigger
# upstream diagnosed. `m3_mul_vec3` stays hoisted because six direct consumers pin
# 6.6.3, below the fix.
# [measured: scratch harness, not reproducible in-tree, 2026-10-03; cycc 6.6.3-6.6.14]
# Cost: the inline form is faster, 2.83-2.87 vs 2.94-2.99 us per 64 calls and 98 vs
# 101 ns through m4_transform_point, in a same-binary A/B (A B A B rows, 3 runs).
# [measured: scratch same-binary A/B harness, not reproducible in-tree, 2026-10-03; cycc 6.6.14]
#
# History, kept because the shape recurs: 2.11.3 hit this as a wrong-code bug on
# the 6.6.1 bump. The intrinsic read its destination pointer from a frame slot
# nothing ever wrote — `movupd %xmm0,(%rdx,%rsi,8)` with %rdx = 12, loaded from
# -0x50(%rbp), read once and stored to zero times, while the src and scalar slots
# WERE stored. hisab filed it as derive-specific and a 6.5.71 regression; ⭐ upstream
# established it was NEITHER. All 21 `f64v_*`/`f32v_*`/`f32v8_*`/`f64v256_*`/`iv_*`
# handlers took `var vbase = GFLC(S)` without raising GFLC until every argument was
# parsed, so any argument allocating a frame local bound it over the destination —
# reachable via `callptr` since 6.0.70 and `#inline` since 6.5.63. 6.5.71 only
# removed the incidental call that had been forcing the spill. **The bisect found
# the release that EXPOSED it, and I reported that as the release that caused it.**
# Fixed by one `_SIMD_RESERVE(S, base, n)` across all 21 handlers.
# See cyrius/docs/development/issues/archived/2026-09-09-hisab-derive-accessor-simd-dst-slot.md
#must_use
public fn m4_mul_vec4(m, v) {
    var r = alloc(sizeof(HVec4));
    if (r == 0) { return 0; }
    var tmp = alloc(32);
    if (tmp == 0) { return 0; }
    f64v_scale(r, m + 0, HVec4_x(v), 4);
    f64v_scale(tmp, m + 32, HVec4_y(v), 4); f64v_add(r, r, tmp, 4);
    f64v_scale(tmp, m + 64, HVec4_z(v), 4); f64v_add(r, r, tmp, 4);
    f64v_scale(tmp, m + 96, HVec4_w(v), 4); f64v_add(r, r, tmp, 4);
    return r;
}

# p * 2^s for `m4_transform_point_checked`'s finite w above 2^1022, whose 1/w is subnormal:
# the copy is halved or quartered, just enough for 1/w to be normal. x / 2 and x / 4 round only
# for a subnormal x, whose |x / w| < 2^-2042 rounds to zero whatever they are, so every
# component that can reach the answer is exact. A [1, 2) copy rounds every |x| < 2, and left
# 521 sweep components 1 ulp off where this leaves 470. (Through 3.4.0's review the band below,
# |w| <= 2^-1024, was a 2^1022 copy here; the certificate now sends every |w~| < 2^-960 to the
# exact path.)
# [measured: scratch harness and Fraction oracle, not reproducible in-tree, 2026-10-11; cycc 6.6.14]
fn _m4_w_scaled(p) {
    var s = (3067 - (f64_abs(HVec4_w(p)) >> 52)) << 52;                   # 1/2, 1/4
    var r = alloc(sizeof(HVec4));
    if (r == 0) { return 0; }
    f64v_scale(r, p, s, 4);
    return r;
}

# `m4_transform_point_checked` where its certificate cannot vouch for the rounded clip vector:
# decided and answered exactly. A NaN or infinite input is refused. Each coordinate of
# M (v, 1) is summed exactly from its four products (`_m4_xsum`); w = 0 exactly is a point at
# infinity, and otherwise each component is the quotient of its coordinate and w, each rounded
# once, divided once and scaled by a power of two: within (3u + 3u^2) of the exact quotient,
# relative, plus half a subnormal step where it is subnormal, and +-Inf where it overflows. An
# exactly zero coordinate gives the zero 0 / w gives, signed as w is.
fn _m4_point_exact(m, v) {
    var dc: i64[80];
    var i = 0;
    while (i < 16) {
        if ((load64(m + i * 8) & 0x7FFF_FFFF_FFFF_FFFF) >= 0x7FF0_0000_0000_0000) { return Err(HSB_ERR_INVALID_INPUT); }
        i = i + 1;
    }
    i = 0;
    while (i < 3) {
        if ((load64(v + i * 8) & 0x7FFF_FFFF_FFFF_FFFF) >= 0x7FF0_0000_0000_0000) { return Err(HSB_ERR_INVALID_INPUT); }
        i = i + 1;
    }
    # Row 3 zero: w = 0 for every point, refused without the sums.
    if (((load64(m + 24) | load64(m + 56) | load64(m + 88) | load64(m + 120)) & 0x7FFF_FFFF_FFFF_FFFF) == 0) {
        return Err(HSB_ERR_DIVISION_BY_ZERO);
    }
    i = 0;
    while (i < 16) { _m4_xdec(load64(m + i * 8), &dc + i * 32); i = i + 1; }
    i = 0;
    while (i < 3) { _m4_xdec(load64(v + i * 8), &dc + (16 + i) * 32); i = i + 1; }
    _m4_xdec(F64_ONE, &dc + 19 * 32);
    var er: i64[2];
    _m4_xrange(&dc, 20, &er);
    # row r of M (v, 1): the products m(r, c) v_c, entry (r, c) at index 4c + r, v_c at 16 + c
    var tl: i64[12];
    var od: i64[2];
    var sw = _m4_xsum(&dc, &er, _m4_row_terms(&tl, 3), 4, 2, &od);
    if (sw == 0) { return Err(HSB_ERR_DIVISION_BY_ZERO); }
    var q: i64[3];
    var oc: i64[2];
    var r = 0;
    while (r < 3) {
        var sc = _m4_xsum(&dc, &er, _m4_row_terms(&tl, r), 4, 2, &oc);
        var c = 0;
        if (sw < 0) { c = 0x8000_0000_0000_0000; }   # an exact 0 over w: IEEE's 0 / w
        if (sc != 0) {
            c = _m4_ldexp(f64_div(load64(&oc), load64(&od)), load64(&oc + 8) - load64(&od + 8));
            if (sc != sw) { c = c ^ 0x8000000000000000; }   # the sign bit: f64_neg gave +0 for +0 below cycc 6.6.8
        }
        store64(&q + r * 8, c);
        r = r + 1;
    }
    var res = hvec3_new(load64(&q), load64(&q + 8), load64(&q + 16));
    if (res == 0) { return Err(HSB_ERR_ALLOC); }
    return Ok(res);
}

# The four terms m(r, c) v_c of row r of M (v, 1) into tl (`_m4_point_exact`); returns tl.
fn _m4_row_terms(tl, r) {
    var c = 0;
    while (c < 4) {
        store64(tl + c * 24, c * 4 + r);
        store64(tl + c * 24 + 8, 16 + c);
        store64(tl + c * 24 + 16, 0);
        c = c + 1;
    }
    return tl;
}

# Mat4 * Vec3 as a point: M (v, 1) divided by its w, as `Ok(point)`, or
# `Err(HSB_ERR_DIVISION_BY_ZERO)` exactly where w = 0 -- the point maps to infinity and has no
# image in R^3 -- or `Err(HSB_ERR_INVALID_INPUT)` for a NaN or infinite entry of M or v. w is
# M's row 3 dotted with (v, 1), taken exactly: every non-zero w divides, however small, and a
# rounded w of 0 or of the wrong sign decides nothing.
#
# ⛔ 3.4.0 — REPLACES `m4_transform_point`, which returned the UNDIVIDED clip coordinates at
# w = +-0 and NaN (audit D088): a point at infinity came back as an ordinary finite point. And
# a clip vector that overflowed from finite inputs answered wrongly: w = +-Inf multiplied by
# 1/w = 0 (2^1000 I with (2^30, 3, 5) gave (0, 0, 0), not (2^30, 3, 5)), and an overflowing x
# beside a finite w gave +-Inf for a finite quotient. It is retired, not redefined.
# ⛔ 3.4.0 — AND THROUGH THE FIRST 3.4.0 REVIEW IT DECIDED w = 0 ON THE ROUNDED w: exact
# w = 3 RN(1/3) - 1 = -2^-54 rounds to 0 and was refused, exact w = 0 rounded to -2^-104 and
# answered (-2.03e31, -2.03e31, -1); on 3,000 points whose w nearly cancels, 1,777 were refused
# with an exact w != 0 and 933 of the rest were more than 2^-20 off the exact quotient.
# [measured: REV-FB t15.py, Fraction clip vectors, the first 3.4.0 review of lane FB, 2026-10-31]
# ⭐ The rounded w is used only where it is certified (below, in the body): S <= 2^20 |w~| and
# |w~| >= 2^-960 put w~ within 2^-30.9 of w with w's sign. Everything else goes to
# `_m4_point_exact`, which sums each coordinate exactly, refuses exactly w = 0, and divides the
# two rounded sums: within (3u + 3u^2) of the exact quotient, relative. Where the formula answers,
# each component is x~ / w~ with |x~ - x| <= 4u S_x + 2^-1073 (S_x the sum of |m(0, c) v_c|,
# and so for y and z) and w~ as above, two roundings more for the division: the 3.3.6 bands'
# arithmetic, unchanged for every w~ the certificate passes, and the same bits there. On the
# review's 3,000 near-cancelling points all are now answered, none past 2^-20 of the exact
# quotient; over 3,000 matrices and points with entries anywhere from 2^-1074 to 2^1023, every
# Err is an exact w = 0 and every Ok an exact w != 0.
# [measured: REV-FB t15.py and scratch t_point.py, Fraction clip vectors, 3.4.0 lane FB review repairs, 2026-10-31]
# Cost: the certificate is three products, four absolute values and four sums: 105 -> 106 ns on a
# focused row against integ-snap7, world_to_screen 111 -> 113 (tests/hisab.bcyr's rows move
# within their spread); a zero row 3 is refused before any sum, 328 -> 113 ns; the exact path
# is 1.10 us where w cancels (integ-snap7 refused that point, wrongly, in 365 ns).
# [measured: scratch pt.bcyr and tests/hisab.bcyr, integ-snap7 and this tree interleaved x 3, 2026-10-31; cycc 6.7.9]
#must_use
public fn m4_transform_point_checked(m, v) {
    var hv = hvec4_from_vec3(v, F64_ONE);
    if (hv == 0) { return Err(HSB_ERR_ALLOC); }
    var p = m4_mul_vec4(m, hv);
    if (p == 0) { return Err(HSB_ERR_ALLOC); }
    var pw = HVec4_w(p);
    # ⛔ `pw` is the homogeneous w of M·(v,1) and carries the matrix's own scale,
    # so an absolute 1e-12 skipped the perspective divide for whole classes of
    # legitimate projections — and silently returned the UNDIVIDED clip-space
    # coordinates as though they were the projected point, with no rc to say so.
    # ⭐ The divide fails exactly when its reciprocal is not finite, which is the
    # genuine w = 0 point-at-infinity case the fallback is for.
    # ⛔ 3.3.5 — EXCEPT THAT 1/w ALSO OVERFLOWS FOR EVERY SUBNORMAL |w| <= 2^-1024, so those
    # took the fallback too: m4_transform_point(2^-1074 I, (3, 5, 7)) returned the undivided
    # (3, 5, 7) * 2^-1074. And above 2^1022 1/w is subnormal, so x * (1/w) carried its
    # rounding. On a sweep of clip vectors with w at every binade, 7,292 of 7,411 answers below
    # 2^-1024 were wrong, and 34 of 2,367 above 2^1022 were 3 or 4 ulp off the exact quotient.
    # ⭐ Both bands now multiply a power-of-two copy by its normal 1/w (`_m4_w_scaled`), which is
    # x * RN(1/w) as an unbounded exponent range would give it: all 7,068 finite answers of the
    # sweep in those bands. (3.4.0: below the certificate's 2^-960 the exact path answers
    # instead, and the copy serves the band above 2^1022 alone.) Two roundings, so within 1.5
    # ulp of the exact quotient, as in the normal band: over 40,295 components of a broader
    # family (two seeds) in these bands the largest error is 1.38 ulp (621 past 1 ulp), and
    # 1.48 over 196,198 where 1/w is normal.
    # Where 1/w is normal nothing changed (58,567 of 58,567 sweep answers keep their bits).
    # [measured: scratch harness and Fraction oracle, not reproducible in-tree, 2026-10-11; cycc 6.6.14]
    # [measured: C336 m4 band sweep (C2's rotm4 family, seeds 301 and 302), this tree, 2026-10-11; cycc 6.6.14]
    # Certified, or decided exactly: |w~ - w| <= 4u S + 4 * 2^-1075 for S the sum of |m(3, c) v_c|
    # (four rounded products, three rounded sums; 2^-1075 per product that underflows), so
    # S <= 2^20 |w~| with |w~| >= 2^-960 makes w~ non-zero with w's sign and within 2^-30.9 of
    # w, relative. Anything else -- w~ = 0, |w~| within 2^20 of its rounding, a NaN -- goes to
    # `_m4_point_exact`, which decides on the exact w. An infinite S passes only beside an
    # infinite w~, which the tests below send there too.
    var vx = HVec3_x(v); var vy = HVec3_y(v); var vz = HVec3_z(v);
    var sw = f64_add(f64_add(f64_add(f64_abs(f64_mul(load64(m + 24), vx)), f64_abs(f64_mul(load64(m + 56), vy))),
        f64_abs(f64_mul(load64(m + 88), vz))), f64_abs(load64(m + 120)));
    var aw = f64_abs(pw);
    if (f64_ge(aw, _M4_W_LO) == 0 || f64_le(sw, f64_mul(aw, _M4_W_CERT)) == 0) {
        return _m4_point_exact(m, v);
    }
    var inv_w = f64_div(F64_ONE, pw);
    if (f64_lt(f64_abs(inv_w), F64_TINY) == 1) {
        if (f64_lt(aw, F64_POS_INF) == 0) { return _m4_point_exact(m, v); }
        p = _m4_w_scaled(p);
        if (p == 0) { return Err(HSB_ERR_ALLOC); }
        inv_w = f64_div(F64_ONE, HVec4_w(p));
    }
    var rx = f64_mul(HVec4_x(p), inv_w);
    var ry = f64_mul(HVec4_y(p), inv_w);
    var rz = f64_mul(HVec4_z(p), inv_w);
    if ((f64_add(f64_add(rx, ry), rz) & 0x7FFF_FFFF_FFFF_FFFF) >= 0x7FF0_0000_0000_0000) {
        return _m4_point_exact(m, v);
    }
    var res = hvec3_new(rx, ry, rz);
    if (res == 0) { return Err(HSB_ERR_ALLOC); }
    return Ok(res);
}

# Mat4 * Vec3 as direction (w=0)
#must_use
public fn m4_transform_dir(m, v) {
    var hv = hvec4_from_vec3(v, 0);
    if (hv == 0) { return 0; }
    var p = m4_mul_vec4(m, hv);
    if (p == 0) { return 0; }
    return hvec3_new(HVec4_x(p), HVec4_y(p), HVec4_z(p));
}

# ================================================================
# Transpose
# ================================================================

#must_use
public fn m4_transpose(m) {
    var t = m4_new();
    if (t == 0) { return 0; }
    var c = 0;
    while (c < 4) {
        var r = 0;
        while (r < 4) {
            m4_set(t, r, c, m4_get(m, c, r));
            r = r + 1;
        }
        c = c + 1;
    }
    return t;
}

# ================================================================
# Determinant
# ================================================================

#must_use
public fn m4_determinant(m) {
    # Same s0-s5/c0-c5 approach as m4_inverse for consistency
    var m00 = m4_get(m, 0, 0); var m01 = m4_get(m, 0, 1);
    var m02 = m4_get(m, 0, 2); var m03 = m4_get(m, 0, 3);
    var m10 = m4_get(m, 1, 0); var m11 = m4_get(m, 1, 1);
    var m12 = m4_get(m, 1, 2); var m13 = m4_get(m, 1, 3);
    var m20 = m4_get(m, 2, 0); var m21 = m4_get(m, 2, 1);
    var m22 = m4_get(m, 2, 2); var m23 = m4_get(m, 2, 3);
    var m30 = m4_get(m, 3, 0); var m31 = m4_get(m, 3, 1);
    var m32 = m4_get(m, 3, 2); var m33 = m4_get(m, 3, 3);

    var s0 = f64_sub(f64_mul(m00, m11), f64_mul(m10, m01));
    var s1 = f64_sub(f64_mul(m00, m12), f64_mul(m10, m02));
    var s2 = f64_sub(f64_mul(m00, m13), f64_mul(m10, m03));
    var s3 = f64_sub(f64_mul(m01, m12), f64_mul(m11, m02));
    var s4 = f64_sub(f64_mul(m01, m13), f64_mul(m11, m03));
    var s5 = f64_sub(f64_mul(m02, m13), f64_mul(m12, m03));

    var c5 = f64_sub(f64_mul(m22, m33), f64_mul(m32, m23));
    var c4 = f64_sub(f64_mul(m21, m33), f64_mul(m31, m23));
    var c3 = f64_sub(f64_mul(m21, m32), f64_mul(m31, m22));
    var c2 = f64_sub(f64_mul(m20, m33), f64_mul(m30, m23));
    var c1 = f64_sub(f64_mul(m20, m32), f64_mul(m30, m22));
    var c0 = f64_sub(f64_mul(m20, m31), f64_mul(m30, m21));

    return f64_add(f64_sub(f64_add(f64_mul(s0, c5), f64_mul(s2, c3)), f64_mul(s1, c4)),
      f64_sub(f64_add(f64_mul(s5, c0), f64_mul(s3, c2)), f64_mul(s4, c1)));
}

# ================================================================
# Inverse (3.4.0: a Result; `m4_inverse` is retired)
# ================================================================

# x * 2^k, rounded once, for any integer k (mat3.cyr's `_m3_ldexp`).
fn _m4_ldexp(x, k) {
    while (k > 1023) { x = f64_mul(x, (1023 + 1023) << 52); k = k - 1023; }
    if (k >= 0) { return f64_mul(x, (1023 + k) << 52); }
    var m = (0 - k) / 1022;
    x = f64_mul(x, (1023 - ((0 - k) - m * 1022)) << 52);
    while (m > 0) { x = f64_mul(x, 0x0010_0000_0000_0000); m = m - 1; }   # 2^-1022
    return x;
}

# ----------------------------------------------------------------
# Exact arithmetic over the whole double range (mat3.cyr's `_m3_xsum` block, which says why).
# ----------------------------------------------------------------

# x (finite) into d[0..4): its significand n as base-2^27 limbs (low, high; 0 for +-0), its
# exponent e (|x| = n * 2^e) and its sign bit.
fn _m4_xdec(x, d) {
    var b = x & 0x7FFF_FFFF_FFFF_FFFF;
    var n = b & 0x000F_FFFF_FFFF_FFFF;
    var e = 0 - 1074;
    if ((b >> 52) != 0) { n = n | 0x0010_0000_0000_0000; e = (b >> 52) - 1075; }
    store64(d, n & _M4_LIMB);
    store64(d + 8, n >> 27);
    store64(d + 16, e);
    store64(d + 24, x >> 63);
    return 0;
}

# The least and greatest exponent of the non-zero entries among dc[0..ne) into er[0], er[1]
# (er[1] < er[0] when every one is zero): the bounds `_m4_xsum` places its terms by.
fn _m4_xrange(dc, ne, er) {
    var lo = 4096;
    var hi = 0 - 4096;
    var i = 0;
    while (i < ne) {
        var d = dc + i * 32;
        if ((load64(d) | load64(d + 8)) != 0) {
            var e = load64(d + 16);
            if (e < lo) { lo = e; }
            if (e > hi) { hi = e; }
        }
        i = i + 1;
    }
    store64(er, lo);
    store64(er + 8, hi);
    return 0;
}

# The significand product of term base's k entries (k = 2, 3, 4) as base-2^27 limbs into pr, its
# exponent into pr[8] and its sign into pr[9]; returns the limb count, or 0 for a zero term.
# Every limb product is below 2^54 and every column sum below 2^57.
fn _m4_xprod(dc, base, k, pr) {
    var da = dc + load64(base) * 32;
    var db = dc + load64(base + 8) * 32;
    var a0 = load64(da); var a1 = load64(da + 8);
    var b0 = load64(db); var b1 = load64(db + 8);
    if ((a0 | a1) == 0 || (b0 | b1) == 0) { return 0; }
    store64(pr + 64, load64(da + 16) + load64(db + 16));
    store64(pr + 72, load64(da + 24) ^ load64(db + 24) ^ load64(base + k * 8));
    var t0 = a0 * b0;
    var t1 = a0 * b1 + a1 * b0 + (t0 >> 27);
    var t2 = a1 * b1 + (t1 >> 27);
    var p0 = t0 & _M4_LIMB; var p1 = t1 & _M4_LIMB; var p2 = t2 & _M4_LIMB; var p3 = t2 >> 27;
    if (k == 2) {
        store64(pr, p0); store64(pr + 8, p1); store64(pr + 16, p2); store64(pr + 24, p3);
        return 4;
    }
    var dg = dc + load64(base + 16) * 32;
    var c0 = load64(dg); var c1 = load64(dg + 8);
    if ((c0 | c1) == 0) { return 0; }
    store64(pr + 64, load64(pr + 64) + load64(dg + 16));
    store64(pr + 72, load64(pr + 72) ^ load64(dg + 24));
    if (k == 3) {
        var u0 = p0 * c0;
        var u1 = p1 * c0 + p0 * c1 + (u0 >> 27);
        var u2 = p2 * c0 + p1 * c1 + (u1 >> 27);
        var u3 = p3 * c0 + p2 * c1 + (u2 >> 27);
        var u4 = p3 * c1 + (u3 >> 27);
        store64(pr, u0 & _M4_LIMB); store64(pr + 8, u1 & _M4_LIMB); store64(pr + 16, u2 & _M4_LIMB);
        store64(pr + 24, u3 & _M4_LIMB); store64(pr + 32, u4 & _M4_LIMB); store64(pr + 40, u4 >> 27);
        return 6;
    }
    var dh = dc + load64(base + 24) * 32;
    var d0 = load64(dh); var d1 = load64(dh + 8);
    if ((d0 | d1) == 0) { return 0; }
    store64(pr + 64, load64(pr + 64) + load64(dh + 16));
    store64(pr + 72, load64(pr + 72) ^ load64(dh + 24));
    var s0 = c0 * d0;
    var s1 = c0 * d1 + c1 * d0 + (s0 >> 27);
    var s2 = c1 * d1 + (s1 >> 27);
    var q0 = s0 & _M4_LIMB; var q1 = s1 & _M4_LIMB; var q2 = s2 & _M4_LIMB; var q3 = s2 >> 27;
    var v0 = p0 * q0;
    var v1 = p0 * q1 + p1 * q0 + (v0 >> 27);
    var v2 = p0 * q2 + p1 * q1 + p2 * q0 + (v1 >> 27);
    var v3 = p0 * q3 + p1 * q2 + p2 * q1 + p3 * q0 + (v2 >> 27);
    var v4 = p1 * q3 + p2 * q2 + p3 * q1 + (v3 >> 27);
    var v5 = p2 * q3 + p3 * q2 + (v4 >> 27);
    var v6 = p3 * q3 + (v5 >> 27);
    store64(pr, v0 & _M4_LIMB); store64(pr + 8, v1 & _M4_LIMB);
    store64(pr + 16, v2 & _M4_LIMB); store64(pr + 24, v3 & _M4_LIMB);
    store64(pr + 32, v4 & _M4_LIMB); store64(pr + 40, v5 & _M4_LIMB);
    store64(pr + 48, v6 & _M4_LIMB); store64(pr + 56, v6 >> 27);
    return 8;
}

# The exact sum of nt signed products of k entries each (mat3.cyr's `_m3_xsum`): term t is the
# product of the entries dc[tl[t (k+1) + j]], j < k (four slots each, `_m4_xdec`), negated when
# tl[t (k+1) + k] is 1; er holds the entries' exponent bounds (`_m4_xrange`). Returns the sum's
# sign (1, -1, or 0 exactly when it is zero) and, when it is not zero, its magnitude rounded
# once to nearest as out[0] * 2^out[1], out[0] in [1, 2^62]. At most 32 terms of at most 4
# entries.
fn _m4_xsum(dc, er, tl, nt, k, out) {
    var acc: i64[320];
    var pr: i64[10];
    if (load64(er + 8) < load64(er)) { return 0; }   # every entry zero
    # every term is k entries' product: below 2^(53 k) in units of 2^(its exponent), which lies
    # in [k emin, k emax] (er: the entries' least and greatest exponents); a sum of at most 32
    # such terms needs 5 bits more
    var lo = k * load64(er);
    var w = (k * (load64(er + 8) - load64(er)) + 53 * k + 5) / 27 + 2;
    var i = 0;
    while (i < w) { store64(&acc + i * 8, 0); i = i + 1; }
    var t = 0;
    while (t < nt) {
        var n = _m4_xprod(dc, tl + t * (k + 1) * 8, k, &pr);
        if (n != 0) {
            var o = load64(&pr + 64) - lo;
            var ql = o / 27;
            var sh = o - ql * 27;
            var a = &acc + ql * 8;
            var pp = &pr;
            var pe = &pr + n * 8;
            if (load64(&pr + 72) == 0) {
                while (pp < pe) { store64(a, load64(a) + (load64(pp) << sh)); a = a + 8; pp = pp + 8; }
            } else {
                while (pp < pe) { store64(a, load64(a) - (load64(pp) << sh)); a = a + 8; pp = pp + 8; }
            }
        }
        t = t + 1;
    }
    # carries (floor, `>>>`): the top carry is 0 or -1, the sum's sign
    var c = 0;
    i = 0;
    while (i < w) {
        var v2 = load64(&acc + i * 8) + c;
        store64(&acc + i * 8, v2 & _M4_LIMB);
        c = v2 >>> 27;
        i = i + 1;
    }
    var res = 1;
    if (c < 0) {
        res = 0 - 1;
        c = 0;
        i = 0;
        while (i < w) {
            var v3 = c - load64(&acc + i * 8);
            store64(&acc + i * 8, v3 & _M4_LIMB);
            c = v3 >>> 27;
            i = i + 1;
        }
    }
    var h = w - 1;
    while (h >= 0 && load64(&acc + h * 8) == 0) { h = h - 1; }
    if (h < 0) { return 0; }
    # the top 62 bits, the rest folded into bit 0 (sticky): one rounding, to nearest
    var x = load64(&acc + h * 8);
    var nb = 0;
    var tt = x;
    while (tt != 0) { tt = tt >> 1; nb = nb + 1; }
    var pos = h * 27;
    var jb = h - 1;
    while (jb >= 0 && nb + 27 <= 62) {
        x = (x << 27) | load64(&acc + jb * 8);
        nb = nb + 27;
        pos = pos - 27;
        jb = jb - 1;
    }
    if (jb >= 0) {
        var take = 62 - nb;
        var lw = load64(&acc + jb * 8);
        x = (x << take) | (lw >> (27 - take));
        pos = pos - take;
        var st = lw & ((1 << (27 - take)) - 1);
        jb = jb - 1;
        while (jb >= 0) { st = st | load64(&acc + jb * 8); jb = jb - 1; }
        if (st != 0) { x = x | 1; }
    }
    store64(out, f64_from(x));
    store64(out + 8, pos + lo);
    return res;
}

# The six terms of the cofactor (-1)^(r+c) minor(r, c) of a 4x4 (entry (i, j) is index 4j + i)
# from term nt of tl on, each prefixed with the entry (r, c) itself when k is 4 (the terms of
# det along row r). Returns nt + 6.
fn _m4_minor_terms(tl, nt, r, c, k) {
    var ri: i64[3];
    var ci: i64[3];
    var n = 0;
    var i = 0;
    while (i < 4) { if (i != r) { store64(&ri + n * 8, i); n = n + 1; } i = i + 1; }
    n = 0;
    i = 0;
    while (i < 4) { if (i != c) { store64(&ci + n * 8, i * 4); n = n + 1; } i = i + 1; }
    var r0 = load64(&ri); var r1 = load64(&ri + 8); var r2 = load64(&ri + 16);
    var c0 = load64(&ci); var c1 = load64(&ci + 8); var c2 = load64(&ci + 16);
    var s = (r + c) & 1;
    var st = (k + 1) * 8;
    var p = tl + nt * st;
    var o = 0;
    if (k == 4) {
        o = 8;
        var j = 0;
        while (j < 6) { store64(p + j * st, c * 4 + r); j = j + 1; }
    }
    # the six permutations of (c0, c1, c2) over (r0, r1, r2), with their parities
    var q = p + o;
    store64(q, r0 + c0); store64(q + 8, r1 + c1); store64(q + 16, r2 + c2); store64(q + 24, s);
    q = q + st;
    store64(q, r0 + c0); store64(q + 8, r1 + c2); store64(q + 16, r2 + c1); store64(q + 24, 1 - s);
    q = q + st;
    store64(q, r0 + c1); store64(q + 8, r1 + c0); store64(q + 16, r2 + c2); store64(q + 24, 1 - s);
    q = q + st;
    store64(q, r0 + c1); store64(q + 8, r1 + c2); store64(q + 16, r2 + c0); store64(q + 24, s);
    q = q + st;
    store64(q, r0 + c2); store64(q + 8, r1 + c0); store64(q + 16, r2 + c1); store64(q + 24, s);
    q = q + st;
    store64(q, r0 + c2); store64(q + 8, r1 + c1); store64(q + 16, r2 + c0); store64(q + 24, 1 - s);
    return nt + 6;
}

# 1 when a row or a column of the 4x4 m is zero (`_m4_inverse_exact`'s quick refusal: a zero scale
# is the common singular matrix, and its exact determinant need not be summed).
fn _m4_zero_line(m) {
    var i = 0;
    while (i < 4) {
        var zr = 1;
        var zc = 1;
        var j = 0;
        while (j < 4) {
            if ((load64(m + (j * 4 + i) * 8) & 0x7FFF_FFFF_FFFF_FFFF) != 0) { zr = 0; }
            if ((load64(m + (i * 4 + j) * 8) & 0x7FFF_FFFF_FFFF_FFFF) != 0) { zc = 0; }
            j = j + 1;
        }
        if (zr == 1 || zc == 1) { return 1; }
        i = i + 1;
    }
    return 0;
}

# `m4_inverse_checked` where its filters cannot certify a faster answer: decided and answered
# exactly. Singular exactly when det, summed exactly from its 24 products, is zero (det comes
# first, so a singular matrix costs 24 products, not 120); otherwise each entry is C_ji / det,
# the cofactor and the determinant each summed exactly and rounded once, divided once and
# scaled by a power of two, rounded once more only where the entry is subnormal or overflows
# (to +-Inf, as IEEE rounds a value beyond DBL_MAX). So an entry X is within (3u + 3u^2)|X|
# of the exact one (u = 2^-53), below 3 ulp, plus half a subnormal step there; an exact zero
# entry is +0.
fn _m4_inverse_exact(m) {
    var i = 0;
    while (i < 16) {
        if ((load64(m + i * 8) & 0x7FFF_FFFF_FFFF_FFFF) >= 0x7FF0_0000_0000_0000) {
            return Err(HSB_ERR_INVALID_INPUT);
        }
        i = i + 1;
    }
    var dc: i64[64];
    i = 0;
    while (i < 16) { _m4_xdec(load64(m + i * 8), &dc + i * 32); i = i + 1; }
    if (_m4_zero_line(m) == 1) { return Err(HSB_ERR_SINGULAR_MATRIX); }
    var er: i64[2];
    _m4_xrange(&dc, 16, &er);
    var tl: i64[120];
    var nt = 0;
    i = 0;
    while (i < 4) { nt = _m4_minor_terms(&tl, nt, 0, i, 4); i = i + 1; }
    var od: i64[2];
    var sd = _m4_xsum(&dc, &er, &tl, 24, 4, &od);
    if (sd == 0) { return Err(HSB_ERR_SINGULAR_MATRIX); }
    var r = m4_new();
    if (r == 0) { return Err(HSB_ERR_ALLOC); }
    var oc: i64[2];
    var row = 0;
    while (row < 4) {
        var col = 0;
        while (col < 4) {
            _m4_minor_terms(&tl, 0, row, col, 3);
            var sc = _m4_xsum(&dc, &er, &tl, 6, 3, &oc);
            var v = 0;
            if (sc != 0) {
                v = _m4_ldexp(f64_div(load64(&oc), load64(&od)), load64(&oc + 8) - load64(&od + 8));
                if (sc != sd) { v = v ^ 0x8000000000000000; }   # the sign bit, as in mat3
            }
            # X = adj(M) / det: X(col, row) = C(row, col) / det, at index 4 row + col
            store64(r + (row * 4 + col) * 8, v);
            col = col + 1;
        }
        row = row + 1;
    }
    return Ok(r);
}

# M^-1 as `Ok(matrix)`, `Err(HSB_ERR_SINGULAR_MATRIX)` exactly when M (its entries taken as the
# exact rationals they are) has determinant zero, or `Err(HSB_ERR_INVALID_INPUT)` for a NaN or
# infinite entry, decided exactly over the whole double range; an entry whose exact value is
# beyond DBL_MAX is +-Inf. mat3.cyr's `m3_inverse_checked` has the reasons and the three tiers;
# here, with P the permanent of |M| (sum over the six 2x2 pairs of perm|top| * perm|bottom|):
#  1. the cofactor formula, 3.3.7's arithmetic bit for bit, where |det - det~| <= 8u P (first
#     order) and P <= 2^10 |det~|, P in [2^-960, 2^1000], every non-zero entry at least 2^-340
#     (no product of up to three entries flushes; through the first 3.4.0 review a
#     P >= 2^-1000 M^2 clause stood here, which bounded the determinant's flushes but not the
#     cofactors'), and every entry of the answer finite;
#  2. where 2^10 |det~| < P <= 2^43 |dd|, P >= 2^-900: the formula's cofactors over a double-double
#     determinant dd, the six pairs' minors and products formed with Dekker's exact products and
#     summed with TwoSum: |dd - det| <= 70 u^2 P (first order, before its rounding; the largest
#     |dd - det| / (u^2 P) measured is 2.41), so within 2^-56.9 of det;
#  3. everything else, `_m4_inverse_exact`, in exact integers.
# Accuracy, derived to first order: in tiers 1 and 2 an entry X_ij = C_ji / det is within
# (5u pC_ji + (e + 2u) |C_ji|) / |det|, pC_ji the permanent of its cofactor's 3x3 minor and e the
# determinant's relative error (8u 2^10 = 2^-40 in tier 1, 2^-56.9 + u in tier 2); in tier 3
# within (3u + 3u^2) |X|, under 3 ulp, plus half a subnormal step.
# [measured: scratch t_tier2.py, Fraction determinants of the dd emulation, 3.4.0 lane FB review repairs, 2026-10-31]
# Measured, against exact rational inverses (maxima of the stated samples, not bounds), in ulp of
# the largest exact entry: 400 random uniform matrices 154 (tier 1) and 2.5 (the 3 in tier 2);
# view-projections (60-degree fov, 16:9, far 1000; 60 per near / eye-distance pair) at near 1e-3
# and 1, eye 10, 1e3 and 1e5: 348 where tier 1 answers (near 1, eye 1e3) and at most 2.9 in
# tier 2, which takes every one with near 1e-3 or eye 1e5; rows r3 = r0 + r1 + noise 2^-k (80
# each): 553 at k = 4 (tier 1), 2.8 .. 11.9 in tier 2, 1.6 in tier 3; 1,000 matrices with entries
# anywhere from 2^-1074 to 2^1023 (tier 3): every entry within 2.10 ulp of its own exact value.
# [measured: scratch t_tier2.py / t_exact.py, Fraction oracle, 3.4.0 lane FB review repairs, 2026-10-31]
#
# ⛔ 3.4.0 — `m4_inverse` returned the identity for a singular or NaN M (audit D088), the
# identity for 2^-300 I (det underflows) and a signed-zero matrix for 2^300 I (det overflows).
# It is retired, not redefined. (`t3d_inverse_matrix` inherited all three; see transforms.cyr.)
# Cost, against integ-snap7 and 3.3.7 (focused rows, the three binaries interleaved x 3): tier 1
# 191 -> 190 ns (3.3.7: 257; the entry screen costs what the M^2 clause's scan did); view-
# projections whose P passes 2^10 |det| (eye 1e3 .. 1e5) and rows r3 = r0 + r1 + 2^-30, tier 2:
# 21.5 .. 23.1 us -> 565 ns, 2.2x 3.3.7's 256 ns (which was hundreds of ulp off on these);
# an exactly singular rank-3 matrix 7.2 -> 2.8 us (3.3.7: 136 ns, the identity). Tier 2 is
# Dekker's products without a fused multiply-add: 30 of them and their sums are 418 of 597 ns
# in a cut-off profile, the rest tier 1's arithmetic and the answer.
# [measured: scratch inv_new.bcyr / inv_old.bcyr / t2cut.bcyr, 3.3.7 + integ-snap7 + this tree x 3, 2026-10-31]
#must_use
public fn m4_inverse_checked(m) {
    var m00 = load64(m);       var m01 = load64(m + 8);
    var m02 = load64(m + 16);  var m03 = load64(m + 24);
    var m10 = load64(m + 32);  var m11 = load64(m + 40);
    var m12 = load64(m + 48);  var m13 = load64(m + 56);
    var m20 = load64(m + 64);  var m21 = load64(m + 72);
    var m22 = load64(m + 80);  var m23 = load64(m + 88);
    var m30 = load64(m + 96);  var m31 = load64(m + 104);
    var m32 = load64(m + 112); var m33 = load64(m + 120);

    var a0 = f64_mul(m00, m11); var b0 = f64_mul(m10, m01);
    var a1 = f64_mul(m00, m12); var b1 = f64_mul(m10, m02);
    var a2 = f64_mul(m00, m13); var b2 = f64_mul(m10, m03);
    var a3 = f64_mul(m01, m12); var b3 = f64_mul(m11, m02);
    var a4 = f64_mul(m01, m13); var b4 = f64_mul(m11, m03);
    var a5 = f64_mul(m02, m13); var b5 = f64_mul(m12, m03);
    var g5 = f64_mul(m22, m33); var h5 = f64_mul(m32, m23);
    var g4 = f64_mul(m21, m33); var h4 = f64_mul(m31, m23);
    var g3 = f64_mul(m21, m32); var h3 = f64_mul(m31, m22);
    var g2 = f64_mul(m20, m33); var h2 = f64_mul(m30, m23);
    var g1 = f64_mul(m20, m32); var h1 = f64_mul(m30, m22);
    var g0 = f64_mul(m20, m31); var h0 = f64_mul(m30, m21);
    var s0 = f64_sub(a0, b0); var s1 = f64_sub(a1, b1); var s2 = f64_sub(a2, b2);
    var s3 = f64_sub(a3, b3); var s4 = f64_sub(a4, b4); var s5 = f64_sub(a5, b5);
    var c5 = f64_sub(g5, h5); var c4 = f64_sub(g4, h4); var c3 = f64_sub(g3, h3);
    var c2 = f64_sub(g2, h2); var c1 = f64_sub(g1, h1); var c0 = f64_sub(g0, h0);

    var det = f64_add(f64_sub(f64_add(f64_mul(s0, c5), f64_mul(s2, c3)), f64_mul(s1, c4)),
      f64_sub(f64_add(f64_mul(s5, c0), f64_mul(s3, c2)), f64_mul(s4, c1)));
    var pm = f64_add(f64_add(
        f64_add(f64_mul(f64_add(f64_abs(a0), f64_abs(b0)), f64_add(f64_abs(g5), f64_abs(h5))),
          f64_mul(f64_add(f64_abs(a1), f64_abs(b1)), f64_add(f64_abs(g4), f64_abs(h4)))),
        f64_add(f64_mul(f64_add(f64_abs(a2), f64_abs(b2)), f64_add(f64_abs(g3), f64_abs(h3))),
          f64_mul(f64_add(f64_abs(a3), f64_abs(b3)), f64_add(f64_abs(g2), f64_abs(h2))))),
