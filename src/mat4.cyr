    # (16 nested tests cost 13 ns where a branch-free form cost 23).
    # [measured: scratch scr.bcyr, this tree, 2026-10-31; cycc 6.7.9]
    var small = 0;
    var st = 0;
    st = m00 & 0x7FFF_FFFF_FFFF_FFFF;
    if (st < _M4_SMALL) { if (st != 0) { small = 1; } }
    st = m01 & 0x7FFF_FFFF_FFFF_FFFF;
    if (st < _M4_SMALL) { if (st != 0) { small = 1; } }
    st = m02 & 0x7FFF_FFFF_FFFF_FFFF;
    if (st < _M4_SMALL) { if (st != 0) { small = 1; } }
    st = m03 & 0x7FFF_FFFF_FFFF_FFFF;
    if (st < _M4_SMALL) { if (st != 0) { small = 1; } }
    st = m10 & 0x7FFF_FFFF_FFFF_FFFF;
    if (st < _M4_SMALL) { if (st != 0) { small = 1; } }
    st = m11 & 0x7FFF_FFFF_FFFF_FFFF;
    if (st < _M4_SMALL) { if (st != 0) { small = 1; } }
    st = m12 & 0x7FFF_FFFF_FFFF_FFFF;
    if (st < _M4_SMALL) { if (st != 0) { small = 1; } }
    st = m13 & 0x7FFF_FFFF_FFFF_FFFF;
    if (st < _M4_SMALL) { if (st != 0) { small = 1; } }
    st = m20 & 0x7FFF_FFFF_FFFF_FFFF;
    if (st < _M4_SMALL) { if (st != 0) { small = 1; } }
    st = m21 & 0x7FFF_FFFF_FFFF_FFFF;
    if (st < _M4_SMALL) { if (st != 0) { small = 1; } }
    st = m22 & 0x7FFF_FFFF_FFFF_FFFF;
    if (st < _M4_SMALL) { if (st != 0) { small = 1; } }
    st = m23 & 0x7FFF_FFFF_FFFF_FFFF;
    if (st < _M4_SMALL) { if (st != 0) { small = 1; } }
    st = m30 & 0x7FFF_FFFF_FFFF_FFFF;
    if (st < _M4_SMALL) { if (st != 0) { small = 1; } }
    st = m31 & 0x7FFF_FFFF_FFFF_FFFF;
    if (st < _M4_SMALL) { if (st != 0) { small = 1; } }
    st = m32 & 0x7FFF_FFFF_FFFF_FFFF;
    if (st < _M4_SMALL) { if (st != 0) { small = 1; } }
    st = m33 & 0x7FFF_FFFF_FFFF_FFFF;
