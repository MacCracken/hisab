            var xs0 = f64_add(f64_sub(f64_sub(a0, f64_sub(s0, zs0)), f64_add(b0, zs0)), f64_sub(ea0, eb0));
            var zs1 = f64_sub(s1, a1);
            var xs1 = f64_add(f64_sub(f64_sub(a1, f64_sub(s1, zs1)), f64_add(b1, zs1)), f64_sub(ea1, eb1));
            var zs2 = f64_sub(s2, a2);
            var xs2 = f64_add(f64_sub(f64_sub(a2, f64_sub(s2, zs2)), f64_add(b2, zs2)), f64_sub(ea2, eb2));
