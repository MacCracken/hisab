            var vs0 = f64_mul(s0, _M4_SPLIT); var ys0 = f64_sub(vs0, f64_sub(vs0, s0)); var ws0 = f64_sub(s0, ys0);
            var vs1 = f64_mul(s1, _M4_SPLIT); var ys1 = f64_sub(vs1, f64_sub(vs1, s1)); var ws1 = f64_sub(s1, ys1);
            var vs2 = f64_mul(s2, _M4_SPLIT); var ys2 = f64_sub(vs2, f64_sub(vs2, s2)); var ws2 = f64_sub(s2, ys2);
            var vs3 = f64_mul(s3, _M4_SPLIT); var ys3 = f64_sub(vs3, f64_sub(vs3, s3)); var ws3 = f64_sub(s3, ys3);
            var vs4 = f64_mul(s4, _M4_SPLIT); var ys4 = f64_sub(vs4, f64_sub(vs4, s4)); var ws4 = f64_sub(s4, ys4);
            var vs5 = f64_mul(s5, _M4_SPLIT); var ys5 = f64_sub(vs5, f64_sub(vs5, s5)); var ws5 = f64_sub(s5, ys5);
            var vc0 = f64_mul(c0, _M4_SPLIT); var yc0 = f64_sub(vc0, f64_sub(vc0, c0)); var wc0 = f64_sub(c0, yc0);
            var vc1 = f64_mul(c1, _M4_SPLIT); var yc1 = f64_sub(vc1, f64_sub(vc1, c1)); var wc1 = f64_sub(c1, yc1);
            var vc2 = f64_mul(c2, _M4_SPLIT); var yc2 = f64_sub(vc2, f64_sub(vc2, c2)); var wc2 = f64_sub(c2, yc2);
            var vc3 = f64_mul(c3, _M4_SPLIT); var yc3 = f64_sub(vc3, f64_sub(vc3, c3)); var wc3 = f64_sub(c3, yc3);
            var vc4 = f64_mul(c4, _M4_SPLIT); var yc4 = f64_sub(vc4, f64_sub(vc4, c4)); var wc4 = f64_sub(c4, yc4);
            var vc5 = f64_mul(c5, _M4_SPLIT); var yc5 = f64_sub(vc5, f64_sub(vc5, c5)); var wc5 = f64_sub(c5, yc5);
            var qs0c5 = f64_mul(s0, c5);
            var rs0c5 = f64_add(f64_add(f64_add(f64_add(f64_sub(f64_mul(ys0, yc5), qs0c5), f64_mul(ys0, wc5)),
                  f64_mul(ws0, yc5)), f64_mul(ws0, wc5)), f64_add(f64_mul(s0, xc5), f64_mul(xs0, c5)));
            var qs2c3 = f64_mul(s2, c3);
            var rs2c3 = f64_add(f64_add(f64_add(f64_add(f64_sub(f64_mul(ys2, yc3), qs2c3), f64_mul(ys2, wc3)),
                  f64_mul(ws2, yc3)), f64_mul(ws2, wc3)), f64_add(f64_mul(s2, xc3), f64_mul(xs2, c3)));
            var qs1c4 = f64_mul(s1, c4);
            var rs1c4 = f64_add(f64_add(f64_add(f64_add(f64_sub(f64_mul(ys1, yc4), qs1c4), f64_mul(ys1, wc4)),
                  f64_mul(ws1, yc4)), f64_mul(ws1, wc4)), f64_add(f64_mul(s1, xc4), f64_mul(xs1, c4)));
            var qs5c0 = f64_mul(s5, c0);
            var rs5c0 = f64_add(f64_add(f64_add(f64_add(f64_sub(f64_mul(ys5, yc0), qs5c0), f64_mul(ys5, wc0)),
                  f64_mul(ws5, yc0)), f64_mul(ws5, wc0)), f64_add(f64_mul(s5, xc0), f64_mul(xs5, c0)));
            var qs3c2 = f64_mul(s3, c2);
            var rs3c2 = f64_add(f64_add(f64_add(f64_add(f64_sub(f64_mul(ys3, yc2), qs3c2), f64_mul(ys3, wc2)),
                  f64_mul(ws3, yc2)), f64_mul(ws3, wc2)), f64_add(f64_mul(s3, xc2), f64_mul(xs3, c2)));
            var qs4c1 = f64_mul(s4, c1);
            var rs4c1 = f64_add(f64_add(f64_add(f64_add(f64_sub(f64_mul(ys4, yc1), qs4c1), f64_mul(ys4, wc1)),
                  f64_mul(ws4, yc1)), f64_mul(ws4, wc1)), f64_add(f64_mul(s4, xc1), f64_mul(xs4, c1)));
