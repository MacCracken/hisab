    }
    if (certified == 1) {
        var inv_det = f64_div(F64_ONE, det);
        var r = alloc(MAT4_BYTES);
        if (r == 0) { return Err(HSB_ERR_ALLOC); }
        var e0 = f64_mul(inv_det, f64_add(f64_sub(f64_mul(m11, c5), f64_mul(m12, c4)), f64_mul(m13, c3)));
        var e1 = f64_mul(inv_det, f64_neg(f64_add(f64_sub(f64_mul(m01, c5), f64_mul(m02, c4)), f64_mul(m03, c3))));
        var e2 = f64_mul(inv_det, f64_add(f64_sub(f64_mul(m31, s5), f64_mul(m32, s4)), f64_mul(m33, s3)));
        var e3 = f64_mul(inv_det, f64_neg(f64_add(f64_sub(f64_mul(m21, s5), f64_mul(m22, s4)), f64_mul(m23, s3))));
        var e4 = f64_mul(inv_det, f64_neg(f64_add(f64_sub(f64_mul(m10, c5), f64_mul(m12, c2)), f64_mul(m13, c1))));
        var e5 = f64_mul(inv_det, f64_add(f64_sub(f64_mul(m00, c5), f64_mul(m02, c2)), f64_mul(m03, c1)));
        var e6 = f64_mul(inv_det, f64_neg(f64_add(f64_sub(f64_mul(m30, s5), f64_mul(m32, s2)), f64_mul(m33, s1))));
        var e7 = f64_mul(inv_det, f64_add(f64_sub(f64_mul(m20, s5), f64_mul(m22, s2)), f64_mul(m23, s1)));
        var e8 = f64_mul(inv_det, f64_add(f64_sub(f64_mul(m10, c4), f64_mul(m11, c2)), f64_mul(m13, c0)));
        var e9 = f64_mul(inv_det, f64_neg(f64_add(f64_sub(f64_mul(m00, c4), f64_mul(m01, c2)), f64_mul(m03, c0))));
        var e10 = f64_mul(inv_det, f64_add(f64_sub(f64_mul(m30, s4), f64_mul(m31, s2)), f64_mul(m33, s0)));
        var e11 = f64_mul(inv_det, f64_neg(f64_add(f64_sub(f64_mul(m20, s4), f64_mul(m21, s2)), f64_mul(m23, s0))));
        var e12 = f64_mul(inv_det, f64_neg(f64_add(f64_sub(f64_mul(m10, c3), f64_mul(m11, c1)), f64_mul(m12, c0))));
        var e13 = f64_mul(inv_det, f64_add(f64_sub(f64_mul(m00, c3), f64_mul(m01, c1)), f64_mul(m02, c0)));
        var e14 = f64_mul(inv_det, f64_neg(f64_add(f64_sub(f64_mul(m30, s3), f64_mul(m31, s1)), f64_mul(m32, s0))));
        var e15 = f64_mul(inv_det, f64_add(f64_sub(f64_mul(m20, s3), f64_mul(m21, s1)), f64_mul(m22, s0)));
        store64(r, e0);        store64(r + 8, e1);    store64(r + 16, e2);   store64(r + 24, e3);
        store64(r + 32, e4);   store64(r + 40, e5);   store64(r + 48, e6);   store64(r + 56, e7);
        store64(r + 64, e8);   store64(r + 72, e9);   store64(r + 80, e10);  store64(r + 88, e11);
        store64(r + 96, e12);  store64(r + 104, e13); store64(r + 112, e14); store64(r + 120, e15);
        # One test on the sum, non-finite whenever an entry is (mat3.cyr).
        var sm = f64_add(f64_add(f64_add(f64_add(e0, e1), f64_add(e2, e3)),
            f64_add(f64_add(e4, e5), f64_add(e6, e7))),
          f64_add(f64_add(f64_add(e8, e9), f64_add(e10, e11)),
            f64_add(f64_add(e12, e13), f64_add(e14, e15))));
        if ((sm & 0x7FFF_FFFF_FFFF_FFFF) < 0x7FF0_0000_0000_0000) { return Ok(r); }
    }
    return _m4_inverse_exact(m);
}

# ================================================================
# Construction helpers
# ================================================================

# From scale (Vec3), rotation (Quat), translation (Vec3): T R S with R the rotation q
# represents, R(q / |q|) for every finite non-zero q, as `m3_from_quat` (mat3.cyr says why) and
# `hquat_rotate_vec3` give it. Where |q|^2 = 1.0 exactly the arithmetic is 3.3.7's, bit for
# bit. A zero or non-finite q has no rotation: its 3x3 block is NaN (2 / 0 = Inf times 0).
#must_use
public fn m4_from_srt(scale, rotation, translation) {
    var qx = HQuat_x(rotation); var qy = HQuat_y(rotation);
    var qz = HQuat_z(rotation); var qw = HQuat_w(rotation);
    var n = f64_add(f64_add(f64_mul(qx, qx), f64_mul(qy, qy)), f64_add(f64_mul(qz, qz), f64_mul(qw, qw)));
    # n is +0, positive or NaN, so its bits order as it does (quat.cyr's range test)
    if (n < _M4_QN_LO || n > _M4_QN_HI) {
        var mq = qx & 0x7FFF_FFFF_FFFF_FFFF;
        if ((qy & 0x7FFF_FFFF_FFFF_FFFF) > mq) { mq = qy & 0x7FFF_FFFF_FFFF_FFFF; }
        if ((qz & 0x7FFF_FFFF_FFFF_FFFF) > mq) { mq = qz & 0x7FFF_FFFF_FFFF_FFFF; }
        if ((qw & 0x7FFF_FFFF_FFFF_FFFF) > mq) { mq = qw & 0x7FFF_FFFF_FFFF_FFFF; }
        # A non-finite component: no rotation, so every entry is NaN. Without this an infinite
        # q gave n = +Inf, 2 / n = 0, and the diagonal entry whose products held no infinity
        # came back 1.0 (q = (Inf, 0, 0, 1): entry (0, 0)).
        if (mq >= 0x7FF0_0000_0000_0000) { n = 0x7FF8_0000_0000_0000; }
        if (mq != 0 && mq < 0x7FF0_0000_0000_0000) {
            # q 2^-e, its largest component in [1, 2): the same rotation, n in [1, 16)
            var e = (mq >> 52) - 1023;
            if ((mq >> 52) == 0) { e = ((f64_mul(mq, _M4_TWO64) >> 52) - 1023) - 64; }
            qx = _m4_ldexp(qx, 0 - e); qy = _m4_ldexp(qy, 0 - e);
            qz = _m4_ldexp(qz, 0 - e); qw = _m4_ldexp(qw, 0 - e);
            n = f64_add(f64_add(f64_mul(qx, qx), f64_mul(qy, qy)), f64_add(f64_mul(qz, qz), f64_mul(qw, qw)));
        }
    }
    # 2 / n in place of the unit formula's 2; skipped at n = 1.0, where it is 2 exactly
    var tw = F64_TWO;
    if (n != 0x3FF0_0000_0000_0000) { tw = f64_div(F64_TWO, n); }
    var xx = f64_mul(qx, qx); var yy = f64_mul(qy, qy); var zz = f64_mul(qz, qz);
    var xy = f64_mul(qx, qy); var xz = f64_mul(qx, qz); var yz = f64_mul(qy, qz);
    var wx = f64_mul(qw, qx); var wy = f64_mul(qw, qy); var wz = f64_mul(qw, qz);
    var sx = HVec3_x(scale); var sy = HVec3_y(scale); var sz = HVec3_z(scale);

    var m = m4_new();
    if (m == 0) { return 0; }
    m4_set(m, 0, 0, f64_mul(f64_sub(F64_ONE, f64_mul(tw, f64_add(yy, zz))), sx));
    m4_set(m, 0, 1, f64_mul(f64_mul(tw, f64_add(xy, wz)), sx));
    m4_set(m, 0, 2, f64_mul(f64_mul(tw, f64_sub(xz, wy)), sx));
    m4_set(m, 1, 0, f64_mul(f64_mul(tw, f64_sub(xy, wz)), sy));
    m4_set(m, 1, 1, f64_mul(f64_sub(F64_ONE, f64_mul(tw, f64_add(xx, zz))), sy));
    m4_set(m, 1, 2, f64_mul(f64_mul(tw, f64_add(yz, wx)), sy));
    m4_set(m, 2, 0, f64_mul(f64_mul(tw, f64_add(xz, wy)), sz));
    m4_set(m, 2, 1, f64_mul(f64_mul(tw, f64_sub(yz, wx)), sz));
    m4_set(m, 2, 2, f64_mul(f64_sub(F64_ONE, f64_mul(tw, f64_add(xx, yy))), sz));
    m4_set(m, 3, 0, HVec3_x(translation));
    m4_set(m, 3, 1, HVec3_y(translation));
    m4_set(m, 3, 2, HVec3_z(translation));
    m4_set(m, 3, 3, F64_ONE);
    return m;
}

# Orthographic projection (right-handed, OpenGL)
#must_use
public fn m4_ortho_rh(left, right, bottom, top, near, far) {
    var m = m4_new();
    if (m == 0) { return 0; }
    var rl = f64_sub(right, left);
    var tb = f64_sub(top, bottom);
    var fn_ = f64_sub(far, near);
    m4_set(m, 0, 0, f64_div(F64_TWO, rl));
    m4_set(m, 1, 1, f64_div(F64_TWO, tb));
    m4_set(m, 2, 2, f64_neg(f64_div(F64_TWO, fn_)));
    m4_set(m, 3, 0, f64_neg(f64_div(f64_add(right, left), rl)));
    m4_set(m, 3, 1, f64_neg(f64_div(f64_add(top, bottom), tb)));
    m4_set(m, 3, 2, f64_neg(f64_div(f64_add(far, near), fn_)));
    m4_set(m, 3, 3, F64_ONE);
    return m;
}

# Perspective projection (right-handed, OpenGL)
# The tangent is the sin/cos quotient hisab's `f64_tan` computed until 3.3.4 (see
# f64_util.cyr for why that fn is gone and why this is not `ganita_f64_tan` yet).
#must_use
public fn m4_perspective_rh(fov_y, aspect, near, far) {
    var half_fov = f64_mul(fov_y, F64_HALF);
    var f = f64_div(F64_ONE, f64_div(f64_sin(half_fov), f64_cos(half_fov)));
    var nf = f64_sub(near, far);
    var m = m4_new();
    if (m == 0) { return 0; }
    m4_set(m, 0, 0, f64_div(f, aspect));
    m4_set(m, 1, 1, f);
    m4_set(m, 2, 2, f64_div(f64_add(far, near), nf));
    m4_set(m, 2, 3, f64_neg(F64_ONE));
    m4_set(m, 3, 2, f64_div(f64_mul(F64_TWO, f64_mul(far, near)), nf));
    return m;
}

# Reverse-Z infinite far-plane perspective
#must_use
public fn m4_perspective_reverse_z(fov_y, aspect, near) {
    var half_fov = f64_mul(fov_y, F64_HALF);
    var f = f64_div(F64_ONE, f64_div(f64_sin(half_fov), f64_cos(half_fov)));
    var m = m4_new();
    if (m == 0) { return 0; }
    m4_set(m, 0, 0, f64_div(f, aspect));
    m4_set(m, 1, 1, f);
    m4_set(m, 2, 3, f64_neg(F64_ONE));
    m4_set(m, 3, 2, near);
    return m;
}

# Look-at (right-handed)
#must_use
public fn m4_look_at_rh(eye, target, up) {
    var d = hvec3_sub(target, eye);
    if (d == 0) { return 0; }
    var f = hvec3_normalize(d);
    if (f == 0) { return 0; }
    var sc = hvec3_cross(f, up);
    if (sc == 0) { return 0; }
    var s = hvec3_normalize(sc);
    if (s == 0) { return 0; }
    var u = hvec3_cross(s, f);
    if (u == 0) { return 0; }
    var m = m4_new();
    if (m == 0) { return 0; }
    m4_set(m, 0, 0, HVec3_x(s)); m4_set(m, 1, 0, HVec3_y(s)); m4_set(m, 2, 0, HVec3_z(s));
    m4_set(m, 0, 1, HVec3_x(u)); m4_set(m, 1, 1, HVec3_y(u)); m4_set(m, 2, 1, HVec3_z(u));
    m4_set(m, 0, 2, f64_neg(HVec3_x(f))); m4_set(m, 1, 2, f64_neg(HVec3_y(f))); m4_set(m, 2, 2, f64_neg(HVec3_z(f)));
    m4_set(m, 3, 0, f64_neg(hvec3_dot(s, eye)));
    m4_set(m, 3, 1, f64_neg(hvec3_dot(u, eye)));
    m4_set(m, 3, 2, hvec3_dot(f, eye));
    m4_set(m, 3, 3, F64_ONE);
    return m;
}
