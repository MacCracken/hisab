            var dh = qs0c5;
            var dl = rs0c5;
            var ns2c3 = f64_add(dh, qs2c3);
            var os2c3 = f64_sub(ns2c3, dh);
            dl = f64_add(f64_add(dl, f64_add(f64_sub(dh, f64_sub(ns2c3, os2c3)), f64_sub(qs2c3, os2c3))), rs2c3);
            dh = ns2c3;
            var ns1c4 = f64_sub(dh, qs1c4);
            var os1c4 = f64_sub(ns1c4, dh);
            dl = f64_sub(f64_add(dl, f64_sub(f64_sub(dh, f64_sub(ns1c4, os1c4)), f64_add(qs1c4, os1c4))), rs1c4);
            dh = ns1c4;
            var ns5c0 = f64_add(dh, qs5c0);
            var os5c0 = f64_sub(ns5c0, dh);
            dl = f64_add(f64_add(dl, f64_add(f64_sub(dh, f64_sub(ns5c0, os5c0)), f64_sub(qs5c0, os5c0))), rs5c0);
            dh = ns5c0;
            var ns3c2 = f64_add(dh, qs3c2);
            var os3c2 = f64_sub(ns3c2, dh);
            dl = f64_add(f64_add(dl, f64_add(f64_sub(dh, f64_sub(ns3c2, os3c2)), f64_sub(qs3c2, os3c2))), rs3c2);
            dh = ns3c2;
            var ns4c1 = f64_sub(dh, qs4c1);
            var os4c1 = f64_sub(ns4c1, dh);
            dl = f64_sub(f64_add(dl, f64_sub(f64_sub(dh, f64_sub(ns4c1, os4c1)), f64_add(qs4c1, os4c1))), rs4c1);
            dh = ns4c1;
            var dd = f64_add(dh, dl);
