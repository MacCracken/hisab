            var ea5 = f64_add(f64_add(f64_add(f64_sub(f64_mul(h02, h13), a5), f64_mul(h02, l13)),
                f64_mul(l02, h13)), f64_mul(l02, l13));
            var eb5 = f64_add(f64_add(f64_add(f64_sub(f64_mul(h12, h03), b5), f64_mul(h12, l03)),
                f64_mul(l12, h03)), f64_mul(l12, l03));
            var eg5 = f64_add(f64_add(f64_add(f64_sub(f64_mul(h22, h33), g5), f64_mul(h22, l33)),
                f64_mul(l22, h33)), f64_mul(l22, l33));
            var eh5 = f64_add(f64_add(f64_add(f64_sub(f64_mul(h32, h23), h5), f64_mul(h32, l23)),
                f64_mul(l32, h23)), f64_mul(l32, l23));
            var eg4 = f64_add(f64_add(f64_add(f64_sub(f64_mul(h21, h33), g4), f64_mul(h21, l33)),
                f64_mul(l21, h33)), f64_mul(l21, l33));
            var eh4 = f64_add(f64_add(f64_add(f64_sub(f64_mul(h31, h23), h4), f64_mul(h31, l23)),
                f64_mul(l31, h23)), f64_mul(l31, l23));
            var eg3 = f64_add(f64_add(f64_add(f64_sub(f64_mul(h21, h32), g3), f64_mul(h21, l32)),
                f64_mul(l21, h32)), f64_mul(l21, l32));
            var eh3 = f64_add(f64_add(f64_add(f64_sub(f64_mul(h31, h22), h3), f64_mul(h31, l22)),
