            var zs5 = f64_sub(s5, a5);
            var xs5 = f64_add(f64_sub(f64_sub(a5, f64_sub(s5, zs5)), f64_add(b5, zs5)), f64_sub(ea5, eb5));
            var zc0 = f64_sub(c0, g0);
            var xc0 = f64_add(f64_sub(f64_sub(g0, f64_sub(c0, zc0)), f64_add(h0, zc0)), f64_sub(eg0, eh0));
            var zc1 = f64_sub(c1, g1);
            var xc1 = f64_add(f64_sub(f64_sub(g1, f64_sub(c1, zc1)), f64_add(h1, zc1)), f64_sub(eg1, eh1));
            var zc2 = f64_sub(c2, g2);
            var xc2 = f64_add(f64_sub(f64_sub(g2, f64_sub(c2, zc2)), f64_add(h2, zc2)), f64_sub(eg2, eh2));
            var zc3 = f64_sub(c3, g3);
            var xc3 = f64_add(f64_sub(f64_sub(g3, f64_sub(c3, zc3)), f64_add(h3, zc3)), f64_sub(eg3, eh3));
            var zc4 = f64_sub(c4, g4);
            var xc4 = f64_add(f64_sub(f64_sub(g4, f64_sub(c4, zc4)), f64_add(h4, zc4)), f64_sub(eg4, eh4));
            var zc5 = f64_sub(c5, g5);
            var xc5 = f64_add(f64_sub(f64_sub(g5, f64_sub(c5, zc5)), f64_add(h5, zc5)), f64_sub(eg5, eh5));
