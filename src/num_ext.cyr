# num_ext.cyr -- extended numerical methods for hisab
# Usage: shipped inside dist/hisab.cyr; in-tree, include "src/num_ext.cyr" after what it requires
# Requires: src/error.cyr, src/num.cyr (stdlib resolves via cyrius.cyml [deps])
#
# Provides:
#   Number theory:   num_extended_gcd, num_euler_totient, num_mobius,
#                    num_divisor_sigma, num_pollard_rho, num_factorize,
#                    num_crt, num_continued_fraction_rational, num_modinv
#   DST/DCT:         num_dst, num_idst, num_dct, num_idct
#   2D FFT:          num_fft_2d, num_ifft_2d
#   Quasi-random:    num_halton, num_halton_2d, num_sobol
#   Tridiagonal:     num_tridiag_solve
#
# All f64 values are bit patterns (IEEE 754). Integer arguments are raw i64.
# Fallible functions return Result<T, E>: Ok(0) on success, Err(HSB_ERR_*) on
# failure, and carry #must_use (3.0.0). Out-parameters are unchanged.
# Results are written through out-param pointers where noted.

# ================================================================
# Constants (f64 bit patterns)
# ================================================================
var _NUMX_F64_ZERO  = 0;                           # 0.0
var _NUMX_F64_ONE   = 0x3FF0000000000000;          # 1.0
var _NUMX_F64_TWO   = 0x4000000000000000;          # 2.0
var _NUMX_F64_NEG1  = 0xBFF0000000000000;          # -1.0
var _NUMX_F64_HALF  = 0x3FE0000000000000;          # 0.5
var _NUMX_F64_INV_2P32 = 0x3DF0000000000000;       # 2^-32
var _NUMX_F64_INV_2P64 = 0x3BF0000000000000;       # 2^-64

# ================================================================
# EXTENDED NUMBER THEORY
# ================================================================

# Extended Euclidean algorithm.
# Returns gcd(a, b) and writes x, y to out_x, out_y such that ax + by = gcd.
# a, b: integers (may be negative)
# out_x, out_y: pointers where x and y are stored
# Returns: gcd (non-negative) -- except that a gcd of 2^63 comes back as i64 min,
# which is 2^63 read unsigned, as num_gcd returns it. That is (i64 min, 0),
# (0, i64 min) and (i64 min, i64 min), the only pairs both of whose entries 2^63
# divides; they write x, y = (-1, 0), (0, -1) and (0, -1), for which a*x + b*y is
# 2^63 exactly (and i64 min modulo 2^64). `a / g, b / g` reduces them without a
# divide by zero. These are 3.3.2's results for those pairs.
# ⛔ 3.3.3 — AN EARLIER 3.3.3 DRAFT RETURNED 0 FOR THEM AND LEFT x, y UNWRITTEN, and
# that 0 made `a / g` divide by zero (SIGFPE) where 3.3.2's i64 min reduced correctly.
# [measured: tests/abuse.tcyr, group "3.3.3 R5num: gcd 2^63 as i64 min, and the reducing idiom"]
#
# ⛔ 3.3.3 — i64 min GAVE A NEGATIVE gcd OR WRONG COEFFICIENTS. `0 - old_r` wraps
# back to i64 min, so the loop ran on -2^63 as if it were a magnitude:
# egcd(i64 min, 6) returned -2 with x = -1, y = 1537228672809129301, for which
# a*x + b*y is -2 only modulo 2^64, and egcd(6, i64 min) returned -2. A non-negative
# gcd was no proof: egcd(i64 min, i64 min + 6) returned the right 2 with
# x = -1537228672809129300, sign wrong.
# [measured: tests/abuse.tcyr, group "3.3.3 R3b: num_extended_gcd at i64 min"]
#
# The bits of i64 min ARE 2^63 read unsigned, and the loop's multiplies and
# subtracts are exact modulo 2^64, so only the division with i64 min as dividend
# (`q` below) needs the unsigned reading; every remainder after it is below 2^63, and
# the x and y returned fit, so their values modulo 2^64 are the integers.
# egcd(i64 min, 6) is now 2 with x = -1, y = -1537228672809129301. Checked against
# python3 big ints (g = math.gcd, 2^63 as i64 min, and a*x + b*y = gcd exactly) on
# 61444 pairs (8455 with an i64 min entry, 895 with gcd 2^63): every pair is right,
# with no |x| or |y| above 2^62 - 1. 3.3.2 was wrong on 5899 of them, all with an
# i64 min entry, and those are the only lines that changed; num_gcd's are unchanged.
# [measured: scratch harness, not reproducible in-tree, 2026-10-01; python3 big-int oracle]
public fn num_extended_gcd(a, b, out_x, out_y) {
    # Iterative extended GCD to avoid stack overflow on deep recursion
    var old_r = a;
    var r = b;
    var old_s = 1;
    var s = 0;
    var old_t = 0;
    var t = 1;

    # Handle negative inputs
    var sign_a = 1;
    var sign_b = 1;
    if (old_r < 0) {
        old_r = 0 - old_r;
        sign_a = 0 - 1;
    }
    if (r < 0) {
        r = 0 - r;
        sign_b = 0 - 1;
    }

    while (r != 0) {
        # old_r == i64 min stands for 2^63 (set above from a or b == i64 min). For r in
        # [1, 2^63 - 1], signed division truncates toward zero, so i64 min / r is
        # -(2^63 div r) and its negation is the quotient. For r = 1 that quotient is
        # 2^63 and wraps back to i64 min, which the exact-modulo-2^64 steps below absorb.
        # r is i64 min too only for (i64 min, i64 min), on the first pass: q comes out
        # -1 where 2^63 div 2^63 is 1, but r = i64 min + i64 min is 0 modulo 2^64 just
        # as i64 min - i64 min is, so the loop ends there and returns the s and t from
        # before q touched them -- the same i64 min, 0, -1 that q = 1 would give.
        var q = old_r / r;
        if (old_r == 0x8000000000000000) { q = 0 - q; }

        var tmp = r;
        r = old_r - q * r;
        old_r = tmp;

        tmp = s;
        s = old_s - q * s;
        old_s = tmp;

        tmp = t;
        t = old_t - q * t;
        old_t = tmp;
    }

    # Adjust signs back
    store64(out_x, old_s * sign_a);
    store64(out_y, old_t * sign_b);
    return old_r;
}

# Modular inverse: returns a^(-1) mod m, or -1 if gcd(a, m) != 1.
# a, m: positive integers
# Returns: modular inverse, or -1 if not invertible
public fn num_modinv(a, m) {
    if (m <= 0) { return 0 - 1; }
    if (a < 0) { a = a % m + m; }

    var out_x = alloc(8);
    var out_y = alloc(8);
    var g = num_extended_gcd(a, m, out_x, out_y);
    if (g != 1) {
        return 0 - 1;
    }
    var x = load64(out_x);
    # Normalize to [0, m) without forming x + m. 3.3.0: this was `((x % m) + m) % m`,
    # and `x % m + m` wraps once m > 2^62 -- num_modinv(5, 2^63-1) returned a negative
    # non-inverse and num_modinv(1, 2^63-1) returned -1, "not invertible", which made
    # num_crt refuse every system whose only modulus is 2^63 - 1.
    # [measured: tests/modules.tcyr, group "3.3.0 number theory above 2^62"]
    var result = x % m;
    if (result < 0) { result = result + m; }
    return result;
}

# Euler's totient function phi(n): count of integers in [1, n] coprime to n.
# n: positive integer (n <= 0 returns the designed 0; phi(n) >= 1 for every n >= 1)
# Returns: phi(n)
# ⛔ 3.3.3 — A NEGATIVE n RETURNED n ITSELF. Only n == 0 was refused, and
# num_factorize returns an empty vec for every n <= 1, so for n < 0 the loop below
# never ran and `result = n` came back: phi(-5) = -5, phi(-12) = -12, phi(-1) = -1,
# phi(i64 min) = i64 min. phi is not defined below 1, and a negative count is not a
# count; n <= 0 now returns the designed 0, which no n >= 1 can produce.
# [measured: tests/abuse.tcyr, group "3.3.3 W5: totient, mobius and sobol below their domain"]
public fn num_euler_totient(n) {
    if (n <= 0) { return 0; }
    if (n == 1) { return 1; }

    var factors = num_factorize(n);
    var flen = vec_len(factors);
    var result = n;
    var prev = 0;
    var i = 0;
    while (i < flen) {
        var p = vec_get(factors, i);
        if (p != prev) {
            result = result - result / p;
            prev = p;
        }
        i = i + 1;
    }
    return result;
}

# Mobius function mu(n).
# Returns 1 if n is squarefree with even number of prime factors,
# -1 if squarefree with odd number of prime factors,
# 0 if n has a squared prime factor.
# n: positive integer (n <= 0 returns the designed 0, as n == 0 already did)
# ⛔ 3.3.3 — EVERY NEGATIVE n RETURNED 1. Only n == 0 was refused, and num_factorize
# returns an empty vec for every n <= 1, so for n < 0 the repeated-factor scan saw
# nothing and the empty count is even: mu(-6) = mu(-4) = mu(-1) = mu(-2) = 1, and
# mu(i64 min) = 1, though -4 and i64 min carry a squared factor and -2 an odd count.
# mu is not defined below 1; n <= 0 now returns the designed 0 that n == 0 returned.
# ⚠ 0 is also mu of every n >= 1 with a squared factor, so the refusal is not
# distinguishable from that answer -- the n == 0 contract this extends was already so.
# [measured: tests/abuse.tcyr, group "3.3.3 W5: totient, mobius and sobol below their domain"]
public fn num_mobius(n) {
    if (n <= 0) { return 0; }
    if (n == 1) { return 1; }

    var factors = num_factorize(n);
    var flen = vec_len(factors);

    # Check for repeated factors
    var i = 0;
    while (i < flen - 1) {
        if (vec_get(factors, i) == vec_get(factors, i + 1)) {
            return 0;
        }
        i = i + 1;
    }

    if ((flen % 2) == 0) {
        return 1;
    }
    return 0 - 1;
}

# Divisor sigma function sigma_k(n) = sum of d^k for all divisors d of n.
# k = 0: number of divisors. k = 1: sum of divisors.
# n: positive integer (n <= 0 returns 0), k: non-negative integer (k < 0 returns 0
# for n >= 2)
# Returns: sigma_k(n), or the designed 0 when sigma_k(n) does not fit in i64. 0 is
# never a value of sigma_k for n >= 1, which is at least 1.
# ⛔ 3.3.3 — EVERY PRODUCT AND SUM HERE WAS UNCHECKED, so sigma_k(n) wrapped for
# k >= 1: (3 * 2^61, 1) returned -4, (720720, 4) returned 5519468047519493040 and
# (2, 64) returned 1, where the truths are 2^64 - 4, about 2.9e23 and 2^64 + 1. Two
# of those three wraps are positive, so no sign check on the result could see them.
# Each step is now refused before it can wrap, against a bound derived from 2^63 - 1
# (a division for a product, the num_crt shape from 3.3.0, and a subtraction for the
# sum): p^k, each power p^(jk), the running sum and the product over primes.
# [measured: tests/modules.tcyr, group "3.3.3 G3: num_divisor_sigma refuses i64 overflow"]
#
# Every value formed on the way (each power, partial sum and partial product) is at
# most sigma_k(n), so a check fires exactly when sigma_k(n) exceeds 2^63 - 1, never
# for a sigma that fits. A sweep of 3311 (n, k) pairs, 2427 of them overflowing,
# matched a python3 big-int oracle in every case; 3.3.2 wrapped all 2427, 1389 of
# them to a positive number.
# [measured: scratch harness, not reproducible in-tree, 2026-10-01; python3 big-int oracle]
#
# The running-sum check fires for exactly two inputs, 5^27 and 13^17 with k = 1:
# only there does a power fit while the sum through it does not. A big-int search
# over every q = p^k <= 2^63 - 1 with p <= 2^21, and every exponent j with
# q^j <= 2^63 - 1, found no other. For a larger p, q^3 already overflows, and
# 1 + q + q^2 fits whenever q^2 does.
# [measured: scratch harness, not reproducible in-tree, 2026-10-01; python3 big-int search]
#
# ⚠ So deleting the sum check is an EQUIVALENT mutant, recorded rather than hidden.
# At both inputs the excess is below 2^63, so the wrapped sum is negative, and the
# product check refuses it because (2^63 - 1) / acc is then negative. The line states
# the bound; without it the product check is what fires, by way of a wrap.
# [measured: scratch mutant, sum check deleted: modules 2358/2358, abuse 985/985, 2026-10-01]
#
# A negative k returned sigma_0(n), because p^k came out as 1, and for n >= 2 that is
# always wrong: sigma_k(n) for k < 0 is sigma_|k|(n) / n^|k|, smaller than sigma_0(n)
# and in general a fraction an i64 cannot carry. So for n >= 2 a negative k returns
# the designed 0. n = 1 still returns 1, which is sigma_k(1) for every k.
# [measured: tests/abuse.tcyr, group "3.3.3 G3: num_divisor_sigma with k < 0"]
#
# ⛔ 3.3.0 — THIS WAS A TRIAL-DIVISION LOOP ON `d * d <= n`, AND d * d WRAPS NEGATIVE
# AT d = 3037000500, so for every n >= 3037000499^2 the test stayed true past
# sqrt(n): n = 2^63 - 1 never returned, and n = 9223372033000000000 returned 440
# divisors for 400. `d <= n / d` would have terminated, but only after ~3e9
# iterations (~5 s) -- longer than the whole modules suite. sigma_k is
# multiplicative, so it is computed from the factorization instead, the way
# num_euler_totient already is: the product over p^a of 1 + p^k + ... + p^(a*k).
# [measured: tests/modules.tcyr, group "3.3.0 number theory above 2^62"]
public fn num_divisor_sigma(n, k) {
    if (n <= 0) { return 0; }
    if (n == 1) { return 1; }
    if (k < 0) { return 0; }

    var factors = num_factorize(n);   # ascending, with multiplicity
    var flen = vec_len(factors);
    var result = 1;
    var i = 0;
    while (i < flen) {
        var p = vec_get(factors, i);
        var a = 0;
        while (i < flen && vec_get(factors, i) == p) {
            a = a + 1;
            i = i + 1;
        }
        var pk = _numx_int_pow(p, k);
        if (pk == 0) { return 0; }    # p^k does not fit (and MAX / pk below would divide by 0)
        var term = 1;
        var acc = 1;
        var j = 0;
        while (j < a) {
            if (term > 0x7FFF_FFFF_FFFF_FFFF / pk) { return 0; }
            term = term * pk;
            if (acc > 0x7FFF_FFFF_FFFF_FFFF - term) { return 0; }
            acc = acc + term;
            j = j + 1;
        }
        if (result > 0x7FFF_FFFF_FFFF_FFFF / acc) { return 0; }
        result = result * acc;
    }
    return result;
}

# Internal: ascending i64 comparator for `vec_sort_by` (<0 / 0 / >0). Written as
# two comparisons rather than `a - b`, which overflows for operands of opposite
# sign more than 2^63 apart.
fn _numx_cmp_i64(a, b) {
    if (a < b) { return 0 - 1; }
    if (a > b) { return 1; }
    return 0;
}

# Internal: base^exp for base >= 2 and exp >= 0, or 0 when the power does not fit
# in i64. (num_divisor_sigma, its only caller, passes a prime.) The loop is linear,
# not square-and-multiply, on purpose: squaring forms b^2 past the last bit it needs,
# and that square overflows on fitting powers -- 2^62 squares b up to 2^64 -- so a
# check on every product would refuse a power that fits. base >= 2 at least doubles
# the result every pass, so the loop ends within 63 passes whatever exp is.
fn _numx_int_pow(base, exp) {
    var result = 1;
    var j = 0;
    while (j < exp) {
        if (result > 0x7FFF_FFFF_FFFF_FFFF / base) { return 0; }
        result = result * base;
        j = j + 1;
    }
    return result;
}

# Pollard's rho algorithm: finds a non-trivial factor of n.
# Returns a factor of n, or n itself if n is prime.
# n: integer > 1
public fn num_pollard_rho(n) {
    if (n <= 1) { return n; }
    if (n % 2 == 0) { return 2; }
    if (num_is_prime(n) == 1) { return n; }

    # Floyd's cycle detection: x steps once, y twice. (This comment said "Brent's
    # improvement" through 3.2.x; Brent's variant batches the gcds, and this does not.)
    var c = 1;
    while (c < n) {
        var x = 2;
        var y = 2;
        var d = 1;

        while (d == 1) {
            # x = (x*x + c) % n, without forming either sum: both overflow once
            # n > 2^62. n > 1 here, so num_mulmod's Err arms cannot be taken.
            var xt, xx = num_mulmod(x, x, n);
            x = _numx_addmod(xx, c, n);
            # y = f(f(y))
            var yt, yy = num_mulmod(y, y, n);
            y = _numx_addmod(yy, c, n);
            var yt2, yy2 = num_mulmod(y, y, n);
            y = _numx_addmod(yy2, c, n);

            var diff = x - y;
            if (diff < 0) { diff = 0 - diff; }
            d = num_gcd(diff, n);
        }

        if (d != n) {
            return d;
        }
        c = c + 1;
    }

    # Fallback: return n (could not find factor)
    return n;
}

# Full integer factorization using Pollard's rho with trial division.
# Returns a vec of prime factors with multiplicity, sorted ascending.
# n: integer > 0
public fn num_factorize(n) {
    var factors = vec_new();
    if (n <= 1) { return factors; }

    # Trial division for small primes
    var small = 2;
    while (small <= 37) {
        while (n > 1 && n % small == 0) {
            vec_push(factors, small);
            n = n / small;
        }
        # Next candidate: 2 -> 3, then odd numbers
        if (small == 2) { small = 3; }
        elif (small == 3) { small = 5; }
        elif (small == 5) { small = 7; }
        elif (small == 7) { small = 11; }
        elif (small == 11) { small = 13; }
        elif (small == 13) { small = 17; }
        elif (small == 17) { small = 19; }
        elif (small == 19) { small = 23; }
        elif (small == 23) { small = 29; }
        elif (small == 29) { small = 31; }
        elif (small == 31) { small = 37; }
        else { small = 38; }   # exit
    }

    if (n <= 1) { return factors; }

    # Iterative rho decomposition: `work` holds the cofactors still to split and
    # `wi` the next one to take. (Through 3.3.1 an abandoned stack-based first
    # attempt sat here: it allocated a vec, pushed n and broke out of its loop on
    # the first pass, and nothing read it. 3.3.2 deleted it.)
    var work = vec_new();
    vec_push(work, n);
    var wi = 0;
    while (wi < vec_len(work)) {
        var m = vec_get(work, wi);
        wi = wi + 1;

        if (m <= 1) { continue; }
        if (num_is_prime(m) == 1) {
            vec_push(factors, m);
            continue;
        }

        var d = num_pollard_rho(m);
        if (d == m) {
            # Could not split further; use trial division fallback
            var td = 2;
            var mm = m;
            # `td <= mm / td`, not `td * td <= mm`: the product wraps for mm near 2^63
            # (num_divisor_sigma's 3.3.0 defect). Repaired on the shape -- this fallback
            # runs only if Pollard rho cannot split a composite.
            while (td <= mm / td) {
                while (mm % td == 0) {
                    vec_push(factors, td);
                    mm = mm / td;
                }
                td = td + 1;
            }
            if (mm > 1) {
                vec_push(factors, mm);
            }
        } else {
            vec_push(work, d);
            vec_push(work, m / d);
        }
    }

    # Sort factors ascending. This was a hand-rolled insertion sort; it is the
    # stdlib introsort now, and the swap is safe on RESULTS because the elements
    # are integer VALUES: equal factors (12 -> 2, 2, 3) are indistinguishable, so
    # every correct sort yields the same vec and tie order cannot be observed.
    # That is not true of hisab's other orderings (indices into a points vec,
    # eigenvector columns), which is why those stay hand-written -- see
    # `linalg_sort_desc` in src/linalg_ext.cyr and `_col_sort_indices_by_xy`
    # in src/collision_core.cyr.
    vec_sort_by(factors, &_numx_cmp_i64);

    return factors;
}

# (x + y) mod m for x, y in [0, m), without forming x + y (it wraps once m > 2^62).
fn _numx_addmod(x, y, m) {
    if (x >= m - y) { return x - (m - y); }
    return x + y;
}

# Chinese Remainder Theorem: solves x = r_i (mod m_i) for coprime moduli.
# remainders: vec of remainder values (any sign; each contributes its residue)
# moduli: vec of modulus values (pairwise coprime, each > 0, product <= 2^63 - 1)
# count: number of congruences
# out_x: pointer -- solution x in [0, M) written here
# out_m: pointer -- combined modulus M written here
# Returns: Ok(0) on success, Err(HSB_ERR_INVALID_INPUT) on failure -- including a
# non-positive modulus and a product of moduli that does not fit in i64.
# ⛔ 3.3.0 — THE PRODUCT WAS FORMED UNCHECKED: three moduli near 2^22 (product ~2^66)
# returned Ok with M = -826830265255265 and x = 0. And with M between 2^62 and 2^63
# the accumulation `(x + term) % M` wrapped: M = 3037000493 * 3037000453 returned Ok
# with a wrong x. An overflowing product is refused now, a non-positive modulus is
# refused up front, and every product and sum is formed without wrapping.
# [measured: tests/modules.tcyr, group "3.3.0 number theory above 2^62"]
#must_use
public fn num_crt(remainders, moduli, count, out_x, out_m) {
    if (count <= 0) { return Err(HSB_ERR_INVALID_INPUT); }

    # Compute product of all moduli, refusing one that would overflow.
    var big_m = 1;
    var i = 0;
    while (i < count) {
        var mi = vec_get(moduli, i);
        if (mi <= 0) { return Err(HSB_ERR_INVALID_INPUT); }
        if (big_m > 0x7FFF_FFFF_FFFF_FFFF / mi) { return Err(HSB_ERR_INVALID_INPUT); }
        big_m = big_m * mi;
        i = i + 1;
    }

    var x = 0;
    i = 0;
    while (i < count) {
        var ri = vec_get(remainders, i);
        var mi = vec_get(moduli, i);
        var Mi = big_m / mi;
        var Mi_mod_mi = Mi % mi;
        var yi = num_modinv(Mi_mod_mi, mi);
        if (yi == 0 - 1) { return Err(HSB_ERR_INVALID_INPUT); }

        # x = (x + ri * Mi * yi) % big_m, every product and sum without overflow.
        # big_m > 0 here, so num_mulmod's Err arms cannot be taken.
        var pt, pv = num_mulmod(Mi, yi, big_m);
        var tt, term = num_mulmod(ri, pv, big_m);
        x = _numx_addmod(x, term, big_m);
        i = i + 1;
    }

    store64(out_x, x);
    store64(out_m, big_m);
    return Ok(0);
}

# Continued fraction expansion of a rational number p/q.
# p, q: positive integers (q = 0 returns an empty vec; so do (i64 min, -1) and
# (-1, i64 min), below). Other negative arguments expand by truncating division:
# (-7, 3) gives [-2, -3], which evaluates to -7/3 but is not the regular expansion.
# Returns: vec of coefficients [a0, a1, a2, ...]
# ⛔ 3.3.3 — TWO NEGATIVE PAIRS KILLED THE PROCESS. i64 min / -1 does not fit, and
# x86 `idiv` traps on it (SIGFPE) rather than wrapping. (i64 min, -1) divides so on
# the first pass and (-1, i64 min) on the second, after 0 is pushed; 3.3.2 died on
# both, exit status 136. Those are the only pairs that reach it: the second pass
# divides q0 by p0 % q0, which is -1 with q0 = i64 min only for p0 = -1, and from the
# third pass on p is a remainder, below 2^63 in magnitude. The quotient they need is
# 2^63, which an i64 cannot carry, so they return the empty vec q = 0 returns.
# [measured: tests/abuse.tcyr, group "3.3.3 W5: totient, mobius and sobol below their domain"]
public fn num_continued_fraction_rational(p, q) {
    var cf = vec_new();
    while (q != 0) {
        if (q == 0 - 1 && p == 0x8000000000000000) { return vec_new(); }
        vec_push(cf, p / q);
        var r = p % q;
        p = q;
        q = r;
    }
    return cf;
}

# ================================================================
# Arbitrary-length complex DFT (Bluestein), the engine under DST/DCT
# ================================================================
#
# num_fft is radix-2 only. The DST/DCT reductions below need a DFT of a
# length the caller chose (n for the DCTs, 2*(n+1) for DST-I), which is a
# power of two only by luck, so 2.8.3 adds the length-agnostic entry point.
# Power-of-two lengths still go straight to num_fft; everything else goes
# through Bluestein's chirp-z, which turns a length-N DFT into a cyclic
# convolution of length m = next power of two >= 2N-1, i.e. three radix-2
# FFTs. Both paths are O(N log N).
#
# Bluestein rests on jk = (j^2 + k^2 - (k-j)^2) / 2, so with
# theta_j = PI * j^2 / N,
#   X[k] = e^{-i theta_k} * sum_j (x[j] e^{-i theta_j}) * e^{+i theta_{k-j}}
# and the sum is a convolution. The angle uses (j*j) MOD 2N rather than j*j:
# e^{i PI j^2 / N} has period 2N in j^2, so the reduction is exact, and it
# holds the argument handed to f64_sin/f64_cos inside [0, 2 PI) instead of
# letting it grow to PI*N -- whose own representation error grows with it.
# It is worth about a factor of 2 to 4, measured on idct(dct(x)) and
# idst(dst(x)) round-trip error with the reduction removed:
#   n =  512   7.71e-14 -> 1.45e-13
#   n = 1024   6.52e-14 -> 2.47e-13
#   n = 1000   7.84e-14 -> 3.35e-13   (Bluestein at both n=1000 and n=1002)
#   n = 4096   8.59e-13 -> 1.36e-12
# Both forms stay far inside the suite's tolerances at the sizes it covers,
# so this line is guarded by that measurement rather than by an assertion.

# Largest DFT length Bluestein will accept. m stays <= 2^21, so the three
# work buffers are <= 32 MB each, and j*j <= 1e12 cannot overflow i64.
var _NUMX_DFT_MAX = 0x100000;   # 1,048,576

fn _numx_next_pow2(n) {
    var m = 1;
    while (m < n) { m = m * 2; }
    return m;
}

# theta_j = PI * ((j*j) mod 2N) / N -- see the block comment on the mod.
fn _numx_chirp_angle(j, n) {
    var two_n = 2 * n;
    var jm = j % two_n;
    var sq = (jm * jm) % two_n;
    return f64_div(f64_mul(F64_PI, f64_from(sq)), f64_from(n));
}

# In-place forward DFT of `n` complex values, any n >= 1.
# data: pointer to n complex numbers ([re, im] pairs, 16 bytes each)
# Returns: Ok(0) on success, HSB_ERR_INVALID_INPUT if n <= 0 or n > _NUMX_DFT_MAX,
#          HSB_ERR_ALLOC if a work buffer could not be allocated.
#must_use
fn _numx_dft(data, n) {
    if (n <= 0) { return Err(HSB_ERR_INVALID_INPUT); }
    if (n == 1) { return Ok(0); }
    if (num_is_pow2(n) == 1) { return num_fft(data, n); }
    if (n > _NUMX_DFT_MAX) { return Err(HSB_ERR_INVALID_INPUT); }

    var m = _numx_next_pow2(2 * n - 1);
    var av = alloc(m * 16);
    if (av == 0) { return Err(HSB_ERR_ALLOC); }
    var bv = alloc(m * 16);
    if (bv == 0) { return Err(HSB_ERR_ALLOC); }

    var i = 0;
    while (i < m) {
        store64(av + i * 16, _NUMX_F64_ZERO);
        store64(av + i * 16 + 8, _NUMX_F64_ZERO);
        store64(bv + i * 16, _NUMX_F64_ZERO);
        store64(bv + i * 16 + 8, _NUMX_F64_ZERO);
        i = i + 1;
    }

    var j = 0;
    while (j < n) {
        var th = _numx_chirp_angle(j, n);
        var c = f64_cos(th);
        var s = f64_sin(th);
        var xr = load64(data + j * 16);
        var xi = load64(data + j * 16 + 8);
        # a[j] = x[j] * e^{-i theta_j}
        store64(av + j * 16, f64_add(f64_mul(xr, c), f64_mul(xi, s)));
        store64(av + j * 16 + 8, f64_sub(f64_mul(xi, c), f64_mul(xr, s)));
        # b[j] = e^{+i theta_j}, mirrored to m-j so the cyclic convolution
        # reproduces the two-sided kernel e^{+i theta_{k-j}}
        store64(bv + j * 16, c);
        store64(bv + j * 16 + 8, s);
        if (j > 0) {
            store64(bv + (m - j) * 16, c);
            store64(bv + (m - j) * 16 + 8, s);
        }
        j = j + 1;
    }

    var err = num_fft(av, m)?;
    # ⚠ 3.0.0 — a REASSIGNMENT, not a fresh `var`, which is why the first
    # mechanical pass missed it and then wrapped the forwarded code as a SUCCESS
    # (`return Ok(err)`). `?` needs a binding, so this takes a second one.
    var err2 = num_fft(bv, m)?;

    var k = 0;
    while (k < m) {
        var ar = load64(av + k * 16);
        var ai = load64(av + k * 16 + 8);
        var br = load64(bv + k * 16);
        var bi = load64(bv + k * 16 + 8);
        store64(av + k * 16, f64_sub(f64_mul(ar, br), f64_mul(ai, bi)));
        store64(av + k * 16 + 8, f64_add(f64_mul(ar, bi), f64_mul(ai, br)));
        k = k + 1;
    }

    var err3 = num_ifft(av, m)?;

    var q = 0;
    while (q < n) {
        var th2 = _numx_chirp_angle(q, n);
        var c2 = f64_cos(th2);
        var s2 = f64_sin(th2);
        var cr = load64(av + q * 16);
        var ci = load64(av + q * 16 + 8);
        # X[q] = e^{-i theta_q} * conv[q]
        store64(data + q * 16, f64_add(f64_mul(cr, c2), f64_mul(ci, s2)));
        store64(data + q * 16 + 8, f64_sub(f64_mul(ci, c2), f64_mul(cr, s2)));
        q = q + 1;
    }
    return Ok(0);
}

# In-place inverse DFT of `n` complex values, any n >= 1.
# Same conjugate-forward-conjugate identity num_ifft uses, so it inherits
# _numx_dft's guards; `data` is only touched after those guards pass.
#must_use
fn _numx_idft(data, n) {
    if (n <= 0) { return Err(HSB_ERR_INVALID_INPUT); }
    if (n == 1) { return Ok(0); }
    if (num_is_pow2(n) == 0) {
        if (n > _NUMX_DFT_MAX) { return Err(HSB_ERR_INVALID_INPUT); }
    }

    var i = 0;
    while (i < n) {
        store64(data + i * 16 + 8, f64_neg(load64(data + i * 16 + 8)));
        i = i + 1;
    }
    var err = _numx_dft(data, n)?;
    var scale = f64_div(_NUMX_F64_ONE, f64_from(n));
    var j = 0;
    while (j < n) {
        store64(data + j * 16, f64_mul(load64(data + j * 16), scale));
        store64(data + j * 16 + 8, f64_mul(f64_neg(load64(data + j * 16 + 8)), scale));
        j = j + 1;
    }
    return Ok(0);
}

# ================================================================
# DST / DCT
# ================================================================
#
# All four were direct O(n^2) double loops through 2.8.2, sitting beside an
# O(n log n) num_fft in the same library. Each now ALSO has the standard
# one-DFT reduction, verified coefficient-by-coefficient against a 90-digit
# Decimal reference for every n in {1..9, 12, 16, 17, 24, 32, 33, 48, 64,
# 100, 127, 128, 129} -- 3,100 coefficients, max relative error 1.2e-14:
#
#   DCT-II  X[k] = Re( e^{-i PI k/(2n)} * DFT(v)[k] ), where v is x with the
#           even-indexed samples in order followed by the odd-indexed ones
#           reversed -- v[j] = x[2j], v[n-1-j] = x[2j+1].
#   DCT-III the same permutation run backwards off an inverse DFT of
#           Z[k] = (X[k] - i X[n-k]) e^{+i PI k/(2n)}, X[n] taken as 0.
#   DST-I   the odd extension y of length 2(n+1) (y[0] = y[n+1] = 0,
#           y[j+1] = x[j], y[2n+1-j] = -x[j]); X[k] = -Im( DFT(y)[k+1] ) / 2.
#
# BOTH PATHS ARE KEPT, and _numx_use_fft picks between them, because the
# reduction is NOT unconditionally faster -- and keeping them also gives the
# repair a broad-n oracle: 538,608 coefficient comparisons over n = 1..200
# plus 250/256/300/511/512/513 and eight input classes (random, all-zero,
# delta, constant, alternating +-1, 1e150, 1e-150, ramp) agree to better than
# 1e-12 relative, worst deviation 1.34e-13 at n = 513, DST-I of a delta. On
# that worst case, against the exact closed form sin(PI*257*(k+1)/514), the
# REDUCTION is the more accurate of the two: 8.70e-14 against the direct
# kernel's 1.36e-13. Measured, ns per call:
#
#            direct    reduction            direct   reduction
#   dct n=2     195         320    dst n=2     189       7,100
#   dct n=15 10,449      16,749    dst n=16 11,836      69,277
#   dct n=16 11,676       3,138    dst n=32 47,870     151,268
#   dct n=64    189k         14k   dst n=64    191k        329k
#   dct n=128   766k         30k   dst n=128   768k        714k
#
# DST-I is the bad case: its DFT length is 2(n+1), which is a power of two
# only when n = 2^k - 1, so it otherwise pays Bluestein -- three FFTs of
# next_pow2(4n+3) -- and loses to a 16x16 double loop by 6x. Shipping the
# reduction unconditionally would have traded a quadratic tail for a
# small-n regression across the whole range consumers actually use.
#
# Above the crossover the win is what the finding asked for. n = 4096:
# dct 813.3 ms -> 1.40 ms (581x), dst 824.1 ms -> 32.7 ms (25x). Growth
# ratio per doubling over n = 256..4096: dct 3.95/4.02/3.96/4.01 (quadratic)
# -> 2.18/2.07/2.14/2.14, dst the same shape at 2.16/2.13/2.13/2.13.
# Non-power-of-two sizes go through Bluestein and win too: dct n=1000,
# 48.4 ms -> 1.75 ms. With the dispatch in place, no size from n=2 to
# n=4096 is slower than it was: the largest measured delta below the
# crossover is +2.6%, inside this machine's +-4% run-to-run spread.

# floor(log2(n)) for n >= 1.
fn _numx_log2(n) {
    var l = 0;
    while (n > 1) {
        n = n >> 1;
        l = l + 1;
    }
    return l;
}

# 1 if the DFT reduction should be used for an n-point transform whose DFT
# length is `len`, 0 if the direct double loop is cheaper. `post` is how many
# TRANSCENDENTAL post-processing passes over `len` the caller runs after the
# DFT -- see below, it is not the same for every caller.
#
# Cost units are calibrated against the table above on cycc 6.5.6: one direct
# kernel term (a sin/cos plus a multiply-add) measures ~46 ns and one radix-2
# butterfly ~22 ns, so a direct term is weighted 2 and a butterfly 1.
# Re-measured in 2.8.4 by forcing BOTH paths at every size from 2 to 40 and at
# 33 larger ones: 22.0-23.7 ns per unit on the direct path, so the ~46 ns
# kernel term was and is priced correctly. Two terms were not.
#
# `post` (2.8.4). The old model charged every caller `2*len` for the
# post-processing pass. That is right for DCT-II and its inverse, which walk
# the output computing a cos and a sin twiddle per bin, and wrong for DST-I,
# whose entire post-pass is a negate and a halve. Charging DST-I for
# transcendentals it never evaluates made the pow2 branch read 17.4-18.0
# ns/unit against the direct path's 22.0-23.7, so the reduction looked more
# expensive than it is and n = 7 was sent to the direct path when the FFT is
# 20.6% faster there (1738 ns vs 2189 ns, batch-timed).
#
# The small-m Bluestein surcharge (2.8.4). Measured cost per abstract unit on
# the chirp-z path is not flat: 26.2 ns/unit at m = 512 falling to 19.9 at
# m = 32768, because the setup -- two buffers zeroed, `len` chirp sin/cos, the
# pointwise product -- amortises. The flat model therefore UNDER-charges small
# m, which is exactly the band the mispicks sit in (m = 64 at n = 26/27, m = 128
# at n = 38/39). A 10% surcharge below m = 128 corrects it.
#
# Both corrections were enumerated over every n from 2 to 20000 for all three
# callers before landing: DST changes its pick at exactly n = 7, DCT at exactly
# {26, 38, 39}, and nothing else moves. The bounds are load-bearing -- widening
# the surcharge to m <= 256 drags n = 58/59/60 across a band that is currently
# picked correctly, and raising it to 1/8 flips n = 40, where the FFT is
# measurably faster (66486 ns vs 67340 ns). Residual on cycc 6.5.6: DCT n = 27
# was a 3% mispick. The model is a fit, not a derivation; it does not claim to be
# exact.
# [measured: 2.8.4 scratch harness, not reproducible in-tree, 2026-08-05; cycc 6.5.6]
#
# Re-timed on cycc 6.6.12 for 3.3.2, both DCT paths forced, per-call mean of 1000
# calls, minimum of 15 rounds, in two independent harness runs (four runs, then
# nine passes under load): n = 27's FFT pick and n = 39's direct pick (2.8.4
# moved n = 39 to direct, when direct was 2.6% faster on 6.5.6) are each within
# about 2% of the other path and usually the slower of the two, so both are
# mispicks of about 1%. n = 27 changed sign in one of the nine passes; n = 39 never
# did. The right picks at n = 26, 38 and 40 win by 3.1-10.9%.
# The cost units above were not refit.
# [measured: scratch harness, not reproducible in-tree, 2026-09-30 and 2026-10-01; cycc 6.6.12]
fn _numx_use_fft(n, len, post) {
    var direct = 2 * n * n;
    var est = 16;
    if (num_is_pow2(len) == 1) {
        est = est + len * _numx_log2(len) + post * len;
    } else {
        var m = _numx_next_pow2(2 * len - 1);
        var t = 3 * m * _numx_log2(m);
        if (m <= 128) { t = t + t / 10; }
        est = est + t + 4 * len;
    }
    if (est < direct) { return 1; }
    return 0;
}

# Discrete Sine Transform Type I (FFTW RODFT00), in-place.
# Kernel: X[k] = sum_i x[i] * sin(PI*(i+1)*(k+1)/(n+1)).
# Labelled "Type II" through 2.6.14; DST-II is sin(PI*(i+0.5)*(k+1)/n), which
# this is not. Only the documentation was wrong -- the transform is a correct
# DST-I and num_idst inverts it.
# data: pointer to n consecutive f64 values (each 8 bytes)
# n: number of values (must be > 0)
# Returns: Ok(0) on success, HSB_ERR_INVALID_INPUT if n <= 0, HSB_ERR_ALLOC if a
#          work buffer could not be allocated
#must_use
public fn num_dst(data, n) {
    if (n <= 0) { return Err(HSB_ERR_INVALID_INPUT); }
    if (n == 1) { return Ok(0); }   # sin(PI/2) == 1 exactly
    var big_n = 2 * (n + 1);
    # post = 0: DST-I's post-pass is a negate and a halve, not a twiddle.
    if (_numx_use_fft(n, big_n, 0) == 0) { return _numx_dst_direct(data, n); }
    if (big_n > _NUMX_DFT_MAX) { return _numx_dst_direct(data, n); }

    # Odd extension of length 2*(n+1): y[0] = y[n+1] = 0, y[j+1] = x[j],
    # y[2n+1-j] = -x[j]. Its DFT is purely imaginary and carries the DST-I
    # coefficients in bins 1..n.
    var y = alloc(big_n * 16);
    if (y == 0) { return Err(HSB_ERR_ALLOC); }
    var i = 0;
    while (i < big_n) {
        store64(y + i * 16, _NUMX_F64_ZERO);
        store64(y + i * 16 + 8, _NUMX_F64_ZERO);
        i = i + 1;
    }
    var j = 0;
    while (j < n) {
        var x = load64(data + j * 8);
        store64(y + (j + 1) * 16, x);
        store64(y + (big_n - 1 - j) * 16, f64_neg(x));
        j = j + 1;
    }

    var err = _numx_dft(y, big_n)?;

    var k = 0;
    while (k < n) {
        # X[k] = -Im(Y[k+1]) / 2
        store64(data + k * 8, f64_mul(f64_neg(load64(y + (k + 1) * 16 + 8)), _NUMX_F64_HALF));
        k = k + 1;
    }
    return Ok(0);
}

# Direct O(n^2) DST-I -- the pre-2.8.3 body, kept because it is the faster
# path below the crossover (see _numx_use_fft).
#must_use
fn _numx_dst_direct(data, n) {
    var out = alloc(n * 8);
    if (out == 0) { return Err(HSB_ERR_ALLOC); }
    var np1 = f64_from(n + 1);
    var k = 0;
    while (k < n) {
        var sum = _NUMX_F64_ZERO;
        var i = 0;
        while (i < n) {
            var x = load64(data + i * 8);
            # angle = PI * (i+1) * (k+1) / (n+1)
            var angle = f64_div(
              f64_mul(F64_PI, f64_mul(f64_from(i + 1), f64_from(k + 1))),
              np1);
            sum = f64_add(sum, f64_mul(x, f64_sin(angle)));
            i = i + 1;
        }
        store64(out + k * 8, sum);
        k = k + 1;
    }
    var j = 0;
    while (j < n) {
        store64(data + j * 8, load64(out + j * 8));
        j = j + 1;
    }
    return Ok(0);
}

# Inverse Discrete Sine Transform (DST-I inverse; DST-I is its own inverse up
# to the 2/(n+1) scale factor applied below).
# DST-I is its own inverse up to scale factor 2/(n+1).
# data: pointer to n consecutive f64 values
# n: number of values
# Returns: Ok(0) on success, HSB_ERR_INVALID_INPUT if n <= 0, HSB_ERR_ALLOC if a
#          work buffer could not be allocated (propagated from num_dst)
#must_use
public fn num_idst(data, n) {
    if (n <= 0) { return Err(HSB_ERR_INVALID_INPUT); }

    # Apply forward DST then scale by 2/(n+1)
    var err = num_dst(data, n)?;

    var scale = f64_div(_NUMX_F64_TWO, f64_from(n + 1));
    var i = 0;
    while (i < n) {
        var v = load64(data + i * 8);
        store64(data + i * 8, f64_mul(v, scale));
        i = i + 1;
    }
    return Ok(0);
}

# Discrete Cosine Transform Type II, in-place.
# X[k] = sum_{i=0}^{n-1} x[i] * cos(PI * (2i+1) * k / (2n))
# data: pointer to n consecutive f64 values
# n: number of values (must be > 0)
# Returns: Ok(0) on success, HSB_ERR_INVALID_INPUT if n <= 0, HSB_ERR_ALLOC if a
#          work buffer could not be allocated
#must_use
public fn num_dct(data, n) {
    if (n <= 0) { return Err(HSB_ERR_INVALID_INPUT); }
    if (n == 1) { return Ok(0); }   # X[0] = x[0] * cos(0)
    if (_numx_use_fft(n, n, 2) == 0) { return _numx_dct_direct(data, n); }
    if (n > _NUMX_DFT_MAX) { return _numx_dct_direct(data, n); }

    # v = even-indexed samples in order, then odd-indexed samples reversed.
    var v = alloc(n * 16);
    if (v == 0) { return Err(HSB_ERR_ALLOC); }
    var i = 0;
    while (2 * i < n) {
        store64(v + i * 16, load64(data + 2 * i * 8));
        store64(v + i * 16 + 8, _NUMX_F64_ZERO);
        i = i + 1;
    }
    var j = 0;
    while (2 * j + 1 < n) {
        store64(v + (n - 1 - j) * 16, load64(data + (2 * j + 1) * 8));
        store64(v + (n - 1 - j) * 16 + 8, _NUMX_F64_ZERO);
        j = j + 1;
    }

    var err = _numx_dft(v, n)?;

    var two_n = f64_from(2 * n);
    var k = 0;
    while (k < n) {
        # X[k] = Re( e^{-i PI k / (2n)} * V[k] )
        var angle = f64_div(f64_mul(F64_PI, f64_from(k)), two_n);
        var c = f64_cos(angle);
        var s = f64_sin(angle);
        var vr = load64(v + k * 16);
        var vi = load64(v + k * 16 + 8);
        store64(data + k * 8, f64_add(f64_mul(vr, c), f64_mul(vi, s)));
        k = k + 1;
    }
    return Ok(0);
}

# Direct O(n^2) DCT-II -- the pre-2.8.3 body, kept as the sub-crossover path.
#must_use
fn _numx_dct_direct(data, n) {
    var out = alloc(n * 8);
    if (out == 0) { return Err(HSB_ERR_ALLOC); }
    var two_n = f64_from(2 * n);
    var k = 0;
    while (k < n) {
        var sum = _NUMX_F64_ZERO;
        var i = 0;
        while (i < n) {
            var x = load64(data + i * 8);
            # angle = PI * (2*i + 1) * k / (2*n)
            var angle = f64_div(
              f64_mul(F64_PI, f64_mul(f64_from(2 * i + 1), f64_from(k))),
              two_n);
            sum = f64_add(sum, f64_mul(x, f64_cos(angle)));
            i = i + 1;
        }
        store64(out + k * 8, sum);
        k = k + 1;
    }
    var j = 0;
    while (j < n) {
        store64(data + j * 8, load64(out + j * 8));
        j = j + 1;
    }
    return Ok(0);
}

# Inverse Discrete Cosine Transform (DCT-III), in-place.
# x[i] = X[0]/n + (2/n) * sum_{k=1}^{n-1} X[k] * cos(PI * k * (2i+1) / (2n))
# data: pointer to n consecutive f64 values
# n: number of values
# Returns: Ok(0) on success, HSB_ERR_INVALID_INPUT if n <= 0, HSB_ERR_ALLOC if a
#          work buffer could not be allocated
#must_use
public fn num_idct(data, n) {
    if (n <= 0) { return Err(HSB_ERR_INVALID_INPUT); }
    if (n == 1) { return Ok(0); }   # x[0] = X[0] / 1
    if (_numx_use_fft(n, n, 2) == 0) { return _numx_idct_direct(data, n); }
    if (n > _NUMX_DFT_MAX) { return _numx_idct_direct(data, n); }

    # Z[k] = (X[k] - i X[n-k]) * e^{+i PI k / (2n)}, with X[n] taken as 0.
    # The 1/n of the (2/n) scale is supplied by the inverse DFT; the 2 is
    # supplied by dropping the 1/2 the textbook half-spectrum form carries.
    var z = alloc(n * 16);
    if (z == 0) { return Err(HSB_ERR_ALLOC); }
    var two_n = f64_from(2 * n);
    var k = 0;
    while (k < n) {
        var xk = load64(data + k * 8);
        var xnk = _NUMX_F64_ZERO;
        if (k > 0) { xnk = load64(data + (n - k) * 8); }
        var angle = f64_div(f64_mul(F64_PI, f64_from(k)), two_n);
        var c = f64_cos(angle);
        var s = f64_sin(angle);
        # (xk - i*xnk) * (c + i*s)
        store64(z + k * 16, f64_add(f64_mul(xk, c), f64_mul(xnk, s)));
        store64(z + k * 16 + 8, f64_sub(f64_mul(xk, s), f64_mul(xnk, c)));
        k = k + 1;
    }

    var err = _numx_idft(z, n)?;

    # Undo the DCT-II permutation: even outputs from the front of z, odd
    # outputs from the back.
    var i = 0;
    while (2 * i < n) {
        store64(data + 2 * i * 8, load64(z + i * 16));
        i = i + 1;
    }
    var j = 0;
    while (2 * j + 1 < n) {
        store64(data + (2 * j + 1) * 8, load64(z + (n - 1 - j) * 16));
        j = j + 1;
    }
    return Ok(0);
}

# Direct O(n^2) DCT-III -- the pre-2.8.3 body, kept as the sub-crossover path.
#must_use
fn _numx_idct_direct(data, n) {
    var out = alloc(n * 8);
    if (out == 0) { return Err(HSB_ERR_ALLOC); }
    var two_n = f64_from(2 * n);
    var inv_n = f64_div(_NUMX_F64_ONE, f64_from(n));
    var dc = f64_mul(load64(data), inv_n);      # X[0] / n
    var scale = f64_mul(_NUMX_F64_TWO, inv_n);  # 2/n

    var i = 0;
    while (i < n) {
        var sum = dc;
        var k = 1;
        while (k < n) {
            var xk = load64(data + k * 8);
            # angle = PI * k * (2*i + 1) / (2*n)
            var angle = f64_div(
              f64_mul(F64_PI, f64_mul(f64_from(k), f64_from(2 * i + 1))),
              two_n);
            sum = f64_add(sum, f64_mul(scale, f64_mul(xk, f64_cos(angle))));
            k = k + 1;
        }
        store64(out + i * 8, sum);
        i = i + 1;
    }
    var j = 0;
    while (j < n) {
        store64(data + j * 8, load64(out + j * 8));
        j = j + 1;
    }
    return Ok(0);
}

# ================================================================
# 2D FFT -- row-then-column approach
# ================================================================
# data: pointer to rows*cols complex numbers (2*rows*cols f64 values)
# Complex layout: [re0, im0, re1, im1, ...] -- 16 bytes per element

# In-place 2D FFT.
# data: pointer to rows*cols complex numbers
# rows: number of rows (must be power of 2)
# cols: number of columns (must be power of 2)
# Returns: Ok(0) on success, HSB_ERR_INVALID_INPUT if dimensions not power of 2
#must_use
public fn num_fft_2d(data, rows, cols) {
    if (num_is_pow2(rows) == 0) { return Err(HSB_ERR_INVALID_INPUT); }
    if (num_is_pow2(cols) == 0) { return Err(HSB_ERR_INVALID_INPUT); }

    # ⚠ CALLER-SIZED ALLOCATION, CHECKED. `rows` comes straight from the caller and
    # is only required to be a power of two, so alloc can legitimately return its
    # documented 0 -- measured, rows = 2^28 gives alloc(rows*16) = 4.3 GB against
    # an ALLOC_MAX of 2 GiB, and storing through the result SIGSEGVs (exit 139).
    # Same CWE-190 -> CWE-476 shape 2.6.14 repaired in the four optimize solvers.
    # [measured: docs/development/issues/archived/2026-08-11-caller-sized-allocs-in-num_ext.md]
    # ⭐ 3.3.1 — CHECKED BEFORE THE ROW PASS, NOT AFTER IT. Through 3.3.0 the check
    # sat after the row pass, so a rejected call had already transformed every row
    # of the caller's data in place, and reaching it in a test meant 2^28 row
    # transforms first — which is why it was never asserted. The bound is derived
    # and written as a division: rows = ALLOC_MAX / 16 is the largest the column
    # buffer can hold. ⚠ Deleting this one line is an EQUIVALENT mutant, recorded
    # rather than hidden: rows is a power of two, so every larger rows either asks
    # alloc for more than ALLOC_MAX or wraps `rows * 16` to <= 0 (from 2^59), and
    # alloc refuses both, so the null check alone returns the same Err. The line
    # states the bound; the null check is what fires.
    # [measured: scratch mutant, abuse 971/971 with the line deleted, 2026-09-30]
    if (rows > ALLOC_MAX / 16) { return Err(HSB_ERR_ALLOC); }
    var col_buf = alloc(rows * 16);
    if (col_buf == 0) { return Err(HSB_ERR_ALLOC); }

    # FFT each row
    var r = 0;
    while (r < rows) {
        var row_ptr = data + r * cols * 16;
        var err = num_fft(row_ptr, cols)?;
        r = r + 1;
    }

    # FFT each column: extract column into temp buffer, FFT, put back
    var c = 0;
    while (c < cols) {
        # Extract column c
        var ri = 0;
        while (ri < rows) {
            var src = data + (ri * cols + c) * 16;
            var dst = col_buf + ri * 16;
            store64(dst, load64(src));          # re
            store64(dst + 8, load64(src + 8));  # im
            ri = ri + 1;
        }

        # FFT the column buffer
        var err = num_fft(col_buf, rows)?;

        # Write back
        ri = 0;
        while (ri < rows) {
            var dst2 = data + (ri * cols + c) * 16;
            var src2 = col_buf + ri * 16;
            store64(dst2, load64(src2));
            store64(dst2 + 8, load64(src2 + 8));
            ri = ri + 1;
        }

        c = c + 1;
    }

    return Ok(0);
}

# In-place 2D inverse FFT.
# data: pointer to rows*cols complex numbers
# rows, cols: must be powers of 2
# Returns: Ok(0) on success
#must_use
public fn num_ifft_2d(data, rows, cols) {
    if (num_is_pow2(rows) == 0) { return Err(HSB_ERR_INVALID_INPUT); }
    if (num_is_pow2(cols) == 0) { return Err(HSB_ERR_INVALID_INPUT); }

    # ⚠ CALLER-SIZED ALLOCATION, CHECKED. `rows` comes straight from the caller and
    # is only required to be a power of two, so alloc can legitimately return its
    # documented 0 -- measured, rows = 2^28 gives alloc(rows*16) = 4.3 GB against
    # an ALLOC_MAX of 2 GiB, and storing through the result SIGSEGVs (exit 139).
    # Same CWE-190 -> CWE-476 shape 2.6.14 repaired in the four optimize solvers.
    # [measured: docs/development/issues/archived/2026-08-11-caller-sized-allocs-in-num_ext.md]
    # ⭐ 3.3.1 — CHECKED BEFORE THE ROW PASS, NOT AFTER IT. Through 3.3.0 the check
    # sat after the row pass, so a rejected call had already transformed every row
    # of the caller's data in place, and reaching it in a test meant 2^28 row
    # transforms first — which is why it was never asserted. The bound is derived
    # and written as a division: rows = ALLOC_MAX / 16 is the largest the column
    # buffer can hold. ⚠ Deleting this one line is an EQUIVALENT mutant, recorded
    # rather than hidden: rows is a power of two, so every larger rows either asks
    # alloc for more than ALLOC_MAX or wraps `rows * 16` to <= 0 (from 2^59), and
    # alloc refuses both, so the null check alone returns the same Err. The line
    # states the bound; the null check is what fires.
    # [measured: scratch mutant, abuse 971/971 with the line deleted, 2026-09-30]
    if (rows > ALLOC_MAX / 16) { return Err(HSB_ERR_ALLOC); }
    var col_buf = alloc(rows * 16);
    if (col_buf == 0) { return Err(HSB_ERR_ALLOC); }

    # IFFT each row
    var r = 0;
    while (r < rows) {
        var row_ptr = data + r * cols * 16;
        var err = num_ifft(row_ptr, cols)?;
        r = r + 1;
    }

    # IFFT each column
    var c = 0;
    while (c < cols) {
        var ri = 0;
        while (ri < rows) {
            var src = data + (ri * cols + c) * 16;
            var dst = col_buf + ri * 16;
            store64(dst, load64(src));
            store64(dst + 8, load64(src + 8));
            ri = ri + 1;
        }

        var err = num_ifft(col_buf, rows)?;

        ri = 0;
        while (ri < rows) {
            var dst2 = data + (ri * cols + c) * 16;
            var src2 = col_buf + ri * 16;
            store64(dst2, load64(src2));
            store64(dst2 + 8, load64(src2 + 8));
            ri = ri + 1;
        }

        c = c + 1;
    }

    return Ok(0);
}

# ================================================================
# QUASI-RANDOM SEQUENCES
# ================================================================

# Halton sequence value for a given index and base.
# Returns f64 bit pattern in [0, 1], or a quiet NaN for a negative index. The digits
# are summed in f64, each step rounded, and a long enough run of top digits rounds
# up to exactly 1.0: num_halton(2^54 - 1, 2) is 1.0, as it was in 3.3.2.
# [measured: tests/abuse.tcyr, group "3.3.3 R5num: num_halton's range and guard order"]
# index: non-negative integer (1-based for non-zero result; index 0 is 0.0)
# base: prime number >= 2 (2, 3, 5, 7, ...)
# A base below 2 has no radical-inverse expansion; 0.0 is returned for a
# non-negative index, which is inside the documented range and is already what
# index 0 yields.
#
# ⛔ 3.3.3 — A NEGATIVE INDEX RETURNED 0.0, WHICH IS A SAMPLE: the one at index 0.
# `while (i > 0)` never ran, so num_halton(-5, 2) was 0.0 and a caller could not
# tell it from num_halton(0, 2). The radical inverse has no negative index, so it
# now returns a quiet NaN, which no sample equals, whatever the base: the index is
# tested first, so num_halton(-5, 0) is NaN too, not the base refusal's 0.0.
# [measured: tests/abuse.tcyr, group "3.3.3 R4num: num_sobol and num_halton refuse an out-of-domain index"]
# Against 3.3.2 over 102748 (index, base) pairs, bases -3 to 13: the 101635 with a
# non-negative index return 3.3.2's bits, and the 1113 negative ones a quiet NaN
# (334 of them with a base below 2, where 3.3.2 and the first repair gave 0.0).
# [measured: scratch harness, not reproducible in-tree, 2026-10-01; 3.3.2 bundle differential]
public fn num_halton(index, base) {
    if (index < 0) { return 0x7FF8000000000000; }   # quiet NaN
    # The loop body is `i % base` and `i / base`. base == 0 is an integer divide
    # by zero -- SIGFPE, process dead, not a wrong answer. base == 1 makes
    # i / base == i, so `while (i > 0)` never advances and the function hangs
    # forever while `f` underflows to zero. base < 0 terminates but leaves the
    # documented range. Reject all three at the door.
    if (base < 2) { return _NUMX_F64_ZERO; }
    var result = _NUMX_F64_ZERO;
    var f = f64_div(_NUMX_F64_ONE, f64_from(base));
    var i = index;
    var f_base = f64_from(base);
    while (i > 0) {
        result = f64_add(result, f64_mul(f, f64_from(i % base)));
        i = i / base;
        f = f64_div(f, f_base);
    }
    return result;
}

# 2D Halton point at given index (bases 2 and 3).
# Writes two f64 values to out_x and out_y.
# index: non-negative integer (a negative one writes a quiet NaN to both, 3.3.3)
# out_x, out_y: pointers for the two coordinates
# Returns: Ok(0), always -- it cannot fail.
public fn num_halton_2d(index, out_x, out_y) {
    store64(out_x, num_halton(index, 2));
    store64(out_y, num_halton(index, 3));
    return Ok(0);
}

# Sobol sequence (dimension 0) -- Van der Corput in base 2.
# Uses Gray code then bit-reversal.
# index: non-negative integer (a negative one returns a quiet NaN)
# Returns: f64 bit pattern in [0, 1): the radical inverse of the Gray code, exact
# for index < 2^53. Above that the point can have up to 63 significant bits, and it
# is rounded toward zero to the f64 at or below it, so it stays below 1.0: rounded to
# nearest, the point at index 0x2AAAAAAAAAAAAA (1 - 2^-54) would be 1.0.
# ⛔ 3.3.3 — AN INDEX AT OR ABOVE 2^32, OR BELOW 0, RETURNED A WRONG SAMPLE. The bit
# reversal kept only the low 32 bits of the Gray code, so num_sobol(2^32) repeated
# the last sample, 2^-32, where its point is 3 * 2^-33; num_sobol(2^32 + 1) was
# 0.5 + 2^-32 where it is 0.5 + 3 * 2^-33; and num_sobol(2^63 - 1) was 0.0 where it is
# 2^-63. Every index in [2^32, 2^63 - 1] has its point, and the reversal now covers
# all 64 bits of the Gray code; indices below 2^32 return 3.3.2's bits. A negative
# index has no point (num_sobol(-5) was 0.375), so it returns a quiet NaN, which no
# point equals.
# [measured: tests/abuse.tcyr, group "3.3.3 R5num: num_sobol over 64 bits"]
# Against an exact python3 radical inverse rounded toward zero, on 600436 indices
# (every index below 200000, 200000 random 32-bit ones, 200000 random ones up to 63
# bits, both sides of every power of two, and Gray codes with long runs of ones that
# put the point next to 1.0): every result matches, the 506426 below 2^32 are 3.3.2's
# bits, and 3.3.2 was wrong on 93982 of the 94010 above.
# [measured: scratch harness, not reproducible in-tree, 2026-10-01; python3 Fraction oracle]
public fn num_sobol(index) {
    if (index < 0) { return 0x7FF8000000000000; }   # quiet NaN

    # Gray code: n ^= n >> 1 (index >= 0, so the shift brings in a 0 bit)
    var n = index ^ (index >> 1);

    # Bit-reverse all 64 bits. Each step masks after its right shift, so the
    # result does not depend on whether `>>` is logical (it is, in cycc) or not.
    n = ((n >> 1) & 0x5555555555555555) | ((n & 0x5555555555555555) << 1);
    n = ((n >> 2) & 0x3333333333333333) | ((n & 0x3333333333333333) << 2);
    n = ((n >> 4) & 0x0F0F0F0F0F0F0F0F) | ((n & 0x0F0F0F0F0F0F0F0F) << 4);
    n = ((n >> 8) & 0x00FF00FF00FF00FF) | ((n & 0x00FF00FF00FF00FF) << 8);
    n = ((n >> 16) & 0x0000FFFF0000FFFF) | ((n & 0x0000FFFF0000FFFF) << 16);
    n = ((n >> 32) & 0xFFFFFFFF) | (n << 32);

    # n / 2^64, read unsigned, as hi + lo: each part is exact (32 bits times a power
    # of two), and the add rounds once, to nearest. For index < 2^32, lo is 0 and the
    # result is hi, 3.3.2's n / 2^32 bit for bit.
    var hi = f64_mul(f64_from((n >> 32) & 0xFFFFFFFF), _NUMX_F64_INV_2P32);
    var lo = f64_mul(f64_from(n & 0xFFFFFFFF), _NUMX_F64_INV_2P64);
    var x = f64_add(hi, lo);
    # Toward zero: hi >= lo whenever hi != 0, so (x - hi) - lo is the add's rounding
    # error exactly (Fast2Sum). If x rounded up, the f64 below it is the one at or
    # below the point; x > 0 there, so that is the bit pattern minus one.
    if (f64_gt(f64_sub(f64_sub(x, hi), lo), _NUMX_F64_ZERO) == 1) { x = x - 1; }
    return x;
}

# ================================================================
# TRIDIAGONAL SOLVER -- Thomas algorithm
# ================================================================

# Solves a tridiagonal system Ax = d in O(n).
#   a: sub-diagonal coefficients (n-1 values, pointer to f64 array)
#   b: diagonal coefficients (n values, pointer to f64 array)
#   c: super-diagonal coefficients (n-1 values, pointer to f64 array)
#   d: right-hand side (n values, pointer to f64 array)
#   n: system size
#   out: pointer to n f64 values where solution is written
#
# Note: a, b, c, d are NOT modified. Temporary workspace is allocated.
# Returns: Ok(0) on success, HSB_ERR_DIVISION_BY_ZERO if pivot is zero,
#          HSB_ERR_INVALID_INPUT if n <= 0, HSB_ERR_ALLOC if a workspace allocation fails
#
# NOTE for anyone adding a fixture: a DIAGONAL system (a and c all zero) makes
# c'[i] == 0, collapses denom to b[i] and multiplies both the d' recurrence and
# the back-substitution by zero -- the only fixture until 2.8.3, and it left
# ~60 of these 70 lines uncertified. tests/modules.tcyr now solves a 1-D Poisson
# system and an asymmetric (sub != super) system whose right-hand sides were
# built as d = A x for a chosen integer x.
#must_use
public fn num_tridiag_solve(a, b, c, d, n, out) {
    if (n <= 0) { return Err(HSB_ERR_INVALID_INPUT); }

    if (n == 1) {
        var b0 = load64(b);
        # ⛔ A tridiagonal PIVOT, in the caller's matrix units, against an
        # absolute 1e-12 — so a well-conditioned system expressed in small units
        # was refused as singular. ⚠ Unlike most of this class it does not
        # fabricate: it returns HSB_ERR_DIVISION_BY_ZERO and leaves `out`
        # untouched, so the defect is a false REFUSAL of a solvable system.
        # [measured: docs/audit/2026-09-09-epsilon-open.json]
        if (f64_lt(f64_abs(b0), F64_TINY) == 1) {
            return Err(HSB_ERR_DIVISION_BY_ZERO);
        }
        store64(out, f64_div(load64(d), b0));
        return Ok(0);
    }

    # Allocate workspace for modified c' and d'
    # ⚠ CALLER-SIZED. Measured, n = 300,000,000 gives alloc(n*8) = 2.4 GB against an
    # ALLOC_MAX of 2 GiB, and until 2.11.1 added the null checks below, the forward
    # sweep's first store went through the null (exit 139).
    # [measured: docs/development/issues/archived/2026-08-11-caller-sized-allocs-in-num_ext.md]
    # ⛔ 3.3.2 — AND UNTIL 3.3.2 NOTHING BOUNDED n BEFORE `n * 8` WAS FORMED. n need not
    # be a power of two, so n = 2^61 + 1 (and 2^62 + 1) wrapped it to 8, alloc honoured
    # 8 bytes, and the forward sweep wrote past both workspaces: a fresh alloc(64)
    # after the call held 6-8 nonzero words (0 at n = 4), and with large caller arrays
    # the process died (exit 139). With small ones it returned
    # Err(HSB_ERR_DIVISION_BY_ZERO), only because a pivot read out of bounds fell below
    # F64_TINY. The bound is derived and written as a division, num_fft_2d's form:
    # ALLOC_MAX / 8 is the largest n whose `n * 8` alloc honours, so only the wrapping
    # windows change; every larger n already returned Err(HSB_ERR_ALLOC).
    # [measured: scratch harness, not reproducible in-tree, 2026-09-30; cycc 6.6.12]
    if (n > ALLOC_MAX / 8) { return Err(HSB_ERR_ALLOC); }
    var cp = alloc(n * 8);    # c' (n-1 used, but allocate n for simplicity)
    var dp = alloc(n * 8);    # d'
    if (cp == 0) { return Err(HSB_ERR_ALLOC); }
    if (dp == 0) { return Err(HSB_ERR_ALLOC); }

    # Forward sweep
    var b0 = load64(b);
    # ⛔ Same class, the forward sweep's leading pivot. See the n == 1 path above.
    if (f64_lt(f64_abs(b0), F64_TINY) == 1) {
        return Err(HSB_ERR_DIVISION_BY_ZERO);
    }

    # c'[0] = c[0] / b[0]
    store64(cp, f64_div(load64(c), b0));
    # d'[0] = d[0] / b[0]
    store64(dp, f64_div(load64(d), b0));

    var i = 1;
    while (i < n) {
        # a_i = a[i-1] (sub-diagonal)
        var ai = load64(a + (i - 1) * 8);
        var bi = load64(b + i * 8);
        var di = load64(d + i * 8);
        var cpm1 = load64(cp + (i - 1) * 8);

        # m = a_i / (b_i - a_i * c'[i-1])  ... wait, standard Thomas:
        # denom = b[i] - a[i] * c'[i-1]
        var denom = f64_sub(bi, f64_mul(ai, cpm1));
        # ⛔ The Thomas-eliminated pivot. Same class again, and this one is inside
        # the loop, so an absolute cut can refuse partway through a system it had
        # already begun solving.
        if (f64_lt(f64_abs(denom), F64_TINY) == 1) {
            return Err(HSB_ERR_DIVISION_BY_ZERO);
        }

        # c'[i] = c[i] / denom  (only for i < n-1)
        if (i < n - 1) {
            var ci = load64(c + i * 8);
            store64(cp + i * 8, f64_div(ci, denom));
        }

        # d'[i] = (d[i] - a[i] * d'[i-1]) / denom
        var dpm1 = load64(dp + (i - 1) * 8);
        store64(dp + i * 8, f64_div(f64_sub(di, f64_mul(ai, dpm1)), denom));

        i = i + 1;
    }

    # Back substitution
    # x[n-1] = d'[n-1]
    store64(out + (n - 1) * 8, load64(dp + (n - 1) * 8));

    var j = n - 2;
    while (j >= 0) {
        # x[j] = d'[j] - c'[j] * x[j+1]
        var dpj = load64(dp + j * 8);
        var cpj = load64(cp + j * 8);
        var xjp1 = load64(out + (j + 1) * 8);
        store64(out + j * 8, f64_sub(dpj, f64_mul(cpj, xjp1)));
        j = j - 1;
    }

    return Ok(0);
}
