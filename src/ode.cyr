# ode.cyr -- ODE solvers for hisab
# Usage: shipped inside dist/hisab.cyr; in-tree, include "src/ode.cyr" after what it requires
# Requires: src/error.cyr (stdlib resolves via cyrius.cyml [deps])
#
# Provides:
#   Adaptive:     ode_dopri45, ode_dopri45_trajectory
#   Implicit:     ode_backward_euler_checked
#   Stiff (BDF):  ode_bdf2_checked, ode_bdf_checked
#   Stochastic:   ode_euler_maruyama, ode_milstein
#   Symplectic:   ode_symplectic_euler, ode_verlet, ode_leapfrog, ode_yoshida4
#
# All f64 values are bit patterns (IEEE 754). Integer arguments are raw i64.
# Fallible functions return Result<T, E>: Ok(0) on success, Err(HSB_ERR_*) on
# failure, and carry #must_use (3.0.0). Out-parameters are unchanged.
# Results are written through out-param pointers.
# Function pointers: fncall1(fp, arg), fncall2(fp, arg1, arg2)

# ================================================================
# Constants (f64 bit patterns)
# ================================================================
var _ODE_F64_ZERO     = 0;                           # 0.0
var _ODE_F64_ONE      = 0x3FF0000000000000;          # 1.0
var _ODE_F64_TWO      = 0x4000000000000000;          # 2.0
var _ODE_F64_HALF     = 0x3FE0000000000000;          # 0.5
var _ODE_F64_SIX      = 0x4018000000000000;          # 6.0
var _ODE_F64_THREE    = 0x4008000000000000;          # 3.0
var _ODE_F64_FOUR     = 0x4010000000000000;          # 4.0
var _ODE_F64_FIVE     = 0x4014000000000000;          # 5.0
# The implicit steps' Newton slope (_ode_newton_gp): the difference step, relative to the
# state, and the margin below which the slope is not resolved from 0.
var _ODE_F64_2_POW_M26 = 0x3E50000000000000;         # 2^-26
var _ODE_F64_2_POW_M24 = 0x3E70000000000000;         # 2^-24

# Safety factor for adaptive step control: 0.9
var _ODE_SAFETY       = 0x3FECCCCCCCCCCCCD;          # 0.9
# Step growth clamp: 0.2
var _ODE_MIN_FACTOR   = 0x3FC999999999999A;          # 0.2
# Step growth clamp: 5.0
var _ODE_MAX_FACTOR   = 0x4014000000000000;          # 5.0
# Exponent for DOPRI error control: -0.2 = -1/5
var _ODE_EXP_NEG_0P2  = 0xBFC999999999999A;         # -0.2
# Max steps for trajectory integration
var _ODE_MAX_STEPS    = 100000;
# Newton updates per BDF step (_ode_bdf_newton): 50, as ode_bdf2 and ode_bdf always took.
enum _OdeBdf { _ODE_BDF_NEWTON = 50; }

# ================================================================
# Dormand-Prince RK4(5) Butcher tableau coefficients (f64 hex)
# ================================================================

# Time nodes: c2=1/5, c3=3/10, c4=4/5, c5=8/9, c6=1, c7=1
#
# These are STAGE TIMES: they are dead weight unless f actually reads t. Every
# ODE fixture in the suite was autonomous through 2.8.2, so the whole row could
# be zeroed with 1818 assertions still green. tests/hisab.tcyr now carries three
# non-autonomous fixtures against exact-rational references (the 5t^4 quadrature,
# one step of y' = t + y, and a fixed-step order-of-convergence check); zeroing
# or perturbing any one of c2..c7 fails at least two of them.
# [measured: CHANGELOG.md 2.8.1, "every ODE test integrand is autonomous"; 2.8.2, suite 1801 -> 1818]
var _DP_C2 = 0x3FC999999999999A;   # 0.2
var _DP_C3 = 0x3FD3333333333333;   # 0.3
var _DP_C4 = 0x3FE999999999999A;   # 0.8
var _DP_C5 = 0x3FEC71C71C71C71C;   # 8/9 = 0.888...

# Stage 2: a21 = 1/5
var _DP_A21 = 0x3FC999999999999A;  # 0.2

# Stage 3: a31 = 3/40, a32 = 9/40
var _DP_A31 = 0x3FB3333333333333;  # 0.075
var _DP_A32 = 0x3FCCCCCCCCCCCCCD;  # 0.225

# Stage 4: a41 = 44/45, a42 = -56/15, a43 = 32/9
var _DP_A41 = 0x3FEF49F49F49F49F;  # 44/45 = 0.97777...
var _DP_A42 = 0xC00DDDDDDDDDDDDE;  # -56/15 = -3.73333...
var _DP_A43 = 0x400C71C71C71C71C;  # 32/9 = 3.55555...

# Stage 5: a51..a54
var _DP_A51 = 0x40079EEC0FC37181;  # 19372/6561 = 2.95259...
var _DP_A52 = 0xC027310BD29520E4;  # -25360/2187 = -11.59579...
var _DP_A53 = 0x4023A552363C5290;  # 64448/6561 = 9.82289...
var _DP_A54 = 0xBFD29C9EBA1E3345;  # -212/729 = -0.29080...

# Stage 6: a61..a65
var _DP_A61 = 0x4006C52BF5A814B0;  # 9017/3168 = 2.84627...
var _DP_A62 = 0xC02583E0F83E0F84;  # -355/33 = -10.7575...
var _DP_A63 = 0x4021D016A3721E8B;  # 46732/5247 = 8.90642...
var _DP_A64 = 0x3FD1D1745D1745D1;  # 49/176 = 0.27840909...
var _DP_A65 = 0xBFD1818970D9CC2F;  # -5103/18656 = -0.27353...

# 5th-order weights b1..b7 (b2=0, b7=0)
var _DP_B1 = 0x3FB7555555555555;   # 35/384 = 0.09114583...
var _DP_B3 = 0x3FDCC0499A5605FB;   # 500/1113 = 0.44923...
var _DP_B4 = 0x3FE4D55555555555;   # 125/192 = 0.65104166...
var _DP_B5 = 0xBFD4A1CFB2B78C13;   # -2187/6784 = -0.32237...
var _DP_B6 = 0x3FC0C30C30C30C31;   # 11/84 = 0.13095...

# Error coefficients: e_i = b5_i - b4_i
var _DP_E1 = 0x3F54320FEDCBA987;   # 71/57600 = 0.0012326...
var _DP_E3 = 0xBF716B5A550ABFC4;   # -71/16695 = -0.004252...
var _DP_E4 = 0x3FA2EEEEEEEEEEEF;   # 71/1920 = 0.036979...
var _DP_E5 = 0xBFAA0AD1D2CA1858;   # -17253/339200 = -0.050863...
var _DP_E6 = 0x3FA5748A7BDAF0E2;   # 22/525 = 0.041904...
var _DP_E7 = 0xBF9999999999999A;   # -1/40 = -0.025

# ================================================================
# BDF coefficients
# ================================================================

# BDF-2: y_{n+1} = (4/3)*y_n - (1/3)*y_{n-1} + (2/3)*h*f(t_{n+1}, y_{n+1})
var _BDF2_A0 = 0x3FF5555555555555;  # 4/3
var _BDF2_A1 = 0xBFD5555555555555;  # -1/3
var _BDF2_BETA = 0x3FE5555555555555; # 2/3

# BDF-3: alpha = [18/11, -9/11, 2/11], beta = 6/11
var _BDF3_A0 = 0x3FFA2E8BA2E8BA2F;  # 18/11 = 1.636363...
var _BDF3_A1 = 0xBFEA2E8BA2E8BA2F;  # -9/11 = -0.818181...
var _BDF3_A2 = 0x3FC745D1745D1746;  # 2/11 = 0.181818...
var _BDF3_BETA = 0x3FE1745D1745D174; # 6/11 = 0.545454...

# BDF-4: alpha = [48/25, -36/25, 16/25, -3/25], beta = 12/25
var _BDF4_A0 = 0x3FFEB851EB851EB8;  # 48/25 = 1.92
var _BDF4_A1 = 0xBFF70A3D70A3D70A;  # -36/25 = -1.44
var _BDF4_A2 = 0x3FE47AE147AE147B;  # 16/25 = 0.64
var _BDF4_A3 = 0xBFBEB851EB851EB8;  # -3/25 = -0.12
var _BDF4_BETA = 0x3FDEB851EB851EB8; # 12/25 = 0.48

# BDF-5: alpha = [300/137, -300/137, 200/137, -75/137, 12/137], beta = 60/137
# BDF-5 coefficients recomputed exact (verified via IEEE 754 double precision)
var _BDF5_A0   = 0x400184ABE9939ED5;  # 300/137
var _BDF5_A1_C = 0xC00184ABE9939ED5;  # -300/137
var _BDF5_A2   = 0x3FF75B8FE21A291C;  # 200/137
var _BDF5_A3   = 0xBFE184ABE9939ED5;  # -75/137
var _BDF5_A4   = 0x3FB66C612AFA64E8;  # 12/137
var _BDF5_BETA = 0x3FDC077975B8FE22;  # 60/137

# ================================================================
# Yoshida 4th-order coefficients
# ================================================================
# cbrt(2) = 1.2599210498948732
# w1 = 1 / (2 - cbrt(2))
# w0 = -cbrt(2) / (2 - cbrt(2))
# c = [w1/2, (w0+w1)/2, (w0+w1)/2, w1/2]
# d = [w1, w0, w1]

# ⛔ 3.3.7 — THREE OF THE FOUR WERE NOT THE VALUES THEIR COMMENTS NAME. _Y4_W1 and _Y4_C0
# sat 1 ulp above the correctly rounded 1/(2 - 2^(1/3)) and its half, and _Y4_C1 2 ulp toward
# zero; the comments of the last two were truncated decimals, which the constant gate could not
# check, and the gate accepted _Y4_W1's comment within 4 ulp. All three now encode the
# correctly rounded exact values. Neither set makes 2 w1 + w0 sum to exactly 1 in doubles
# (+2^-52 before, -2^-52 now), so no consistency was traded; a free particle now moves
# 1 - 2^-53 per unit step (was 1 + 2^-52), and the SHO step pinned in tests/hisab.tcyr is
# bit-identical.
# [measured: 60-digit Decimal closed forms; free-particle and SHO steps replayed in doubles, 2026-10-31]
var _Y4_W1   = 0x3FF59E8B6EB96338;  # 1/(2 - 2^(1/3))
var _Y4_W0   = 0xBFFB3D16DD72C671;  # -2^(1/3)/(2 - 2^(1/3))

# c[0] = w1 * 0.5
var _Y4_C0   = 0x3FE59E8B6EB96338;  # 1/(2*(2 - 2^(1/3)))
# c[1] = (w0 + w1) * 0.5
var _Y4_C1   = 0xBFC67A2DBAE58CE2;  # (1 - 2^(1/3))/(2*(2 - 2^(1/3)))
# c[2] = c[1]
# c[3] = c[0]

# ================================================================
# DOPRI45 -- Dormand-Prince adaptive RK4(5)
# ================================================================

# Single DOPRI45 step (scalar ODE).
# f: function pointer, fncall2(f, t, y) -> dy/dt
# t: current time (f64)
# y: current state (f64)
# dt: time step (f64)
# out_y: pointer -- new y value written here
# out_err: pointer -- error estimate written here
# Returns: Ok(0). This routine has no failure path of its own, which is why
#   it carries no #must_use (2.19.0's rule: annotate only what can fail).
public fn ode_dopri45(f, t, y, dt, out_y, out_err) {
    # Stage 1
    var k1 = fncall2(f, t, y);

    # Stage 2
    var t2 = f64_add(t, f64_mul(dt, _DP_C2));
    var y2 = f64_add(y, f64_mul(dt, f64_mul(_DP_A21, k1)));
    var k2 = fncall2(f, t2, y2);

    # Stage 3
    var t3 = f64_add(t, f64_mul(dt, _DP_C3));
    var y3 = f64_add(y, f64_mul(dt, f64_add(
          f64_mul(_DP_A31, k1),
          f64_mul(_DP_A32, k2))));
    var k3 = fncall2(f, t3, y3);

    # Stage 4
    var t4 = f64_add(t, f64_mul(dt, _DP_C4));
    var y4 = f64_add(y, f64_mul(dt, f64_add(
          f64_mul(_DP_A41, k1),
          f64_add(f64_mul(_DP_A42, k2),
            f64_mul(_DP_A43, k3)))));
    var k4 = fncall2(f, t4, y4);

    # Stage 5
    var t5 = f64_add(t, f64_mul(dt, _DP_C5));
    var y5 = f64_add(y, f64_mul(dt, f64_add(
          f64_mul(_DP_A51, k1),
          f64_add(f64_mul(_DP_A52, k2),
            f64_add(f64_mul(_DP_A53, k3),
              f64_mul(_DP_A54, k4))))));
    var k5 = fncall2(f, t5, y5);

    # Stage 6
    var t6 = f64_add(t, dt);
    var y6 = f64_add(y, f64_mul(dt, f64_add(
          f64_mul(_DP_A61, k1),
          f64_add(f64_mul(_DP_A62, k2),
            f64_add(f64_mul(_DP_A63, k3),
              f64_add(f64_mul(_DP_A64, k4),
                f64_mul(_DP_A65, k5)))))));
    var k6 = fncall2(f, t6, y6);

    # 5th-order solution (b2=0, b7=0)
    var y_new = f64_add(y, f64_mul(dt, f64_add(
          f64_mul(_DP_B1, k1),
          f64_add(f64_mul(_DP_B3, k3),
            f64_add(f64_mul(_DP_B4, k4),
              f64_add(f64_mul(_DP_B5, k5),
                f64_mul(_DP_B6, k6)))))));

    # Stage 7 (FSAL -- for error estimate)
    var k7 = fncall2(f, f64_add(t, dt), y_new);

    # Error estimate: sum of e_i * k_i
    var err = f64_mul(dt, f64_add(
        f64_mul(_DP_E1, k1),
        f64_add(f64_mul(_DP_E3, k3),
          f64_add(f64_mul(_DP_E4, k4),
            f64_add(f64_mul(_DP_E5, k5),
              f64_add(f64_mul(_DP_E6, k6),
                f64_mul(_DP_E7, k7)))))));

    store64(out_y, y_new);
    store64(out_err, f64_abs(err));
    return Ok(0);
}

# Full DOPRI45 trajectory with adaptive stepping (scalar ODE).
# f: function pointer, fncall2(f, t, y) -> dy/dt
# t0: initial time (f64)
# y0: initial state (f64)
# tf: final time (f64)
# dt0: initial step size (f64)
# tol: error tolerance (f64)
# out_ts: vec -- time values pushed here
# out_ys: vec -- state values pushed here
# Returns: Ok(0) on success, Err(HSB_ERR_NO_CONVERGENCE) if max steps exceeded
#must_use
public fn ode_dopri45_trajectory(f, t0, y0, tf, dt0, tol, out_ts, out_ys) {
    var t = t0;
    var y = y0;
    var h = dt0;

    vec_push(out_ts, t);
    vec_push(out_ys, y);

    # ⛔ 3.4.0 — TWO UNCHECKED alloc(8)s, ONE PAIR PER CALL: a refused allocation made
    # ode_dopri45 store to address 0, and every call left 16 bytes on the bump heap. The
    # step's two outputs are locals now.
    var out_bufs: i64[2];
    var out_y_buf = &out_bufs;
    var out_err_buf = &out_bufs + 8;

    var steps = 0;
    while (steps < _ODE_MAX_STEPS) {
        # ⛔ `tf - t` is a span of the INDEPENDENT VARIABLE, in the caller's time
        # units, against an absolute 1e-12 — so an integration over a short total
        # span returned rc = 0 and a plausible SHORT trajectory, having silently
        # stopped early. Arrival is not a question of tolerance: it is whether any
        # span remains at all, and `<= 0` also subsumes the overshoot test below it.
        if (f64_le(f64_sub(tf, t), 0) == 1) {
            return Ok(0);
        }

        # Clamp step to not overshoot tf
        var remaining = f64_sub(tf, t);
        if (f64_gt(h, remaining) == 1) {
            h = remaining;
        }
        # ⭐ With arrival now testing `<= 0`, the loop needs the one thing the old
        # tolerance was accidentally providing: a NON-ADVANCEMENT check. If the
        # step is too small to move `t` at all, no threshold can say so — only the
        # addition can. Scale-free by construction, and no constant to choose.
        # ⚠ It returns HSB_ERR_NO_CONVERGENCE, which this function's own contract
        # already declares, NOT a silent success. Measured: the dt0 = 0 abuse case
        # now reports it at step 1 instead of after 100,001 wasted pushes.
        # [measured: docs/audit/2026-09-09-epsilon-open.json]
        if (f64_eq(f64_add(t, h), t) == 1) {
            return Err(HSB_ERR_NO_CONVERGENCE);
        }

        # Take a DOPRI45 step
        var _r1t, _r1v = ode_dopri45(f, t, y, h, out_y_buf, out_err_buf);
        var y_new = load64(out_y_buf);
        var err = load64(out_err_buf);

        # Compute scaled error: err / max(tol, tol * |y_new|)
        var scale = tol;
        var abs_y = f64_abs(y_new);
        var tol_scaled = f64_mul(tol, abs_y);
        if (f64_gt(tol_scaled, scale) == 1) {
            scale = tol_scaled;
        }
        var err_norm = f64_div(err, scale);

        if (f64_gt(err_norm, _ODE_F64_ONE) == 1) {
            # Reject step -- shrink h
            var factor = f64_mul(_ODE_SAFETY, ganita_f64_pow(err_norm, _ODE_EXP_NEG_0P2));
            if (f64_lt(factor, _ODE_MIN_FACTOR) == 1) {
                factor = _ODE_MIN_FACTOR;
            }
            h = f64_mul(h, factor);
        } else {
            # Accept step
            t = f64_add(t, h);
            y = y_new;
            vec_push(out_ts, t);
            vec_push(out_ys, y);

            # Grow h
            var factor = _ODE_MAX_FACTOR;
            if (f64_gt(err_norm, _ODE_F64_ZERO) == 1) {
                factor = f64_mul(_ODE_SAFETY, ganita_f64_pow(err_norm, _ODE_EXP_NEG_0P2));
                if (f64_gt(factor, _ODE_MAX_FACTOR) == 1) {
                    factor = _ODE_MAX_FACTOR;
                }
                if (f64_lt(factor, _ODE_MIN_FACTOR) == 1) {
                    factor = _ODE_MIN_FACTOR;
                }
            }
            h = f64_mul(h, factor);
        }

        steps = steps + 1;
    }

    return Err(HSB_ERR_NO_CONVERGENCE);
}

# ================================================================
# BACKWARD EULER -- implicit solver for stiff systems
# ================================================================

# Single backward Euler step (scalar ODE) with Newton iteration.
# f: function pointer, fncall2(f, t, y) -> dy/dt
# t: current time (f64) -- the step targets t+dt
# y: current state (f64)
# dt: time step (f64)
# tol: Newton convergence tolerance (f64), on the residual |g(z)|
# max_newton: max Newton updates (integer)
# out: pointer, y_new (f64) written here on success
# Returns: Ok(0) when an iterate's residual |g(z)| is below tol (the forward-Euler
# predictor is tested first); Err(HSB_ERR_NO_CONVERGENCE) when max_newton updates do
# not get there; Err(HSB_ERR_SINGULAR_MATRIX) when g'(z) is not resolved from 0
# (_ode_newton_gp: the step's equation is singular and no Newton step can be taken); `out`
# untouched on both; Err(HSB_ERR_INVALID_INPUT) for tol <= 0 or NaN (no residual meets it)
# or max_newton < 0, before f is called.
# ⭐ 3.4.0 — REPLACES ode_backward_euler, WHICH DID NOT REPORT NON-CONVERGENCE (audit
# D070). It returned the last Newton iterate z in both failures above, and never tested
# the residual of the iterate its last update made, so y' = -y with dt = 1 from y = 1,
# tol 1e-12, max_newton 0 returned the predictor 0, where the step's value is 0.5; it
# now reports NO_CONVERGENCE, and max_newton = 1 is Ok(0.5) (the one update lands on
# the linear equation's root, and its residual is tested). (Through 3.3.1 the doc said
# "or y on non-convergence".) Two more it returned as values: y' = y with dt = 1, whose
# step 1 / (1 - dt) does not exist, gave 0x4127901A8CFCEE13 (773,325, a diverged iterate),
# and y' = y + 1 - t from y = -1/2 at t = 0, dt = 1, where g'(z) = 0 exactly and the step's
# equation z = -1/2 + z has no root, gave the predictor 0; both are SINGULAR_MATRIX (3.4.0's
# first form: NO_CONVERGENCE, after 102 evaluations).
# [measured: scratch probes (NU1-work/p/p5.cyr, p8.cyr, p8b.cyr), base tree and this tree, 2026-10-31]
#
# Solves: y_new = y + dt * f(t + dt, y_new)
# Newton: g(z) = z - y - dt * f(t+dt, z) = 0
# Update: z -= g(z) / g'(z)
# g'(z) approx 1 - dt * df/dy, approximated via finite difference
#must_use
public fn ode_backward_euler_checked(f, t, y, dt, tol, max_newton, out) {
    if (f64_gt(tol, 0) == 0 || max_newton < 0) { return Err(HSB_ERR_INVALID_INPUT); }
    var t_next = f64_add(t, dt);
    # Initial guess: forward Euler
    var z = f64_add(y, f64_mul(dt, fncall2(f, t, y)));
    var iter = 0;
    while (1 == 1) {
        var fz = fncall2(f, t_next, z);
        var g = f64_sub(z, f64_add(y, f64_mul(dt, fz)));

        # Check convergence
        if (f64_lt(f64_abs(g), tol) == 1) {
            store64(out, z);
            return Ok(0);
        }
        if (iter >= max_newton) { return Err(HSB_ERR_NO_CONVERGENCE); }

        # g'(z) = 1 - dt df/dy, df/dy by a forward difference (_ode_newton_gp)
        var gp = _ode_newton_gp(f, t_next, z, fz, dt, g);
        if (f64_eq(gp, 0) == 1) { return Err(HSB_ERR_SINGULAR_MATRIX); }
        if (f64_eq(gp, gp) == 0) { return Err(HSB_ERR_NO_CONVERGENCE); }  # no finite slope

        z = f64_sub(z, f64_div(g, gp));
        iter = iter + 1;
    }
    return Err(HSB_ERR_NO_CONVERGENCE);
}

# ================================================================
# BDF-2 -- Backward Differentiation Formula, order 2
# ================================================================

# Single BDF-2 step (scalar ODE).
# f: function pointer, fncall2(f, t, y) -> dy/dt
# t: time at the NEW step (f64)
# y: current state y_n (f64)
# y_prev: previous state y_{n-1} (f64)
# dt: time step (f64)
# tol: Newton convergence tolerance (f64), on the residual |g(z)|
# out: pointer, y_{n+1} (f64) written here on success
# Returns: Ok(0) when an iterate's residual is below tol (the predictor is tested
# first); Err(HSB_ERR_NO_CONVERGENCE) after 50 Newton updates without that;
# Err(HSB_ERR_SINGULAR_MATRIX) when g'(z) is not resolved from 0 (_ode_newton_gp); `out`
# untouched on both; Err(HSB_ERR_INVALID_INPUT) for tol <= 0 or NaN, before f is called.
# ⭐ 3.4.0 — REPLACES ode_bdf2, which returned the last iterate z on both failures
# (audit D070) and never tested the residual of its 50th update.
#
# BDF-2: y_{n+1} = (4/3)*y_n - (1/3)*y_{n-1} + (2/3)*h*f(t_{n+1}, y_{n+1})
#must_use
public fn ode_bdf2_checked(f, t, y, y_prev, dt, tol, out) {
    if (f64_gt(tol, 0) == 0) { return Err(HSB_ERR_INVALID_INPUT); }
    # Predictor
    var pred = f64_add(f64_mul(_BDF2_A0, y), f64_mul(_BDF2_A1, y_prev));
    return _ode_bdf_newton(f, t, pred, _BDF2_BETA, dt, tol, out);
}

# Internal: the Newton slope g'(z) = 1 - c f_y(t, z) of an implicit step's equation
# z = s + c f(t, z) (c = dt for backward Euler, beta dt for BDF), fz = f(t, z), g its residual
# at z, with f_y the forward difference over the step 2^-26 |z| (2^-26 |g| at z = 0: a
# residual of 0 has already passed the caller's tol), taken as the difference of the two
# doubles it spans; a difference that is not finite is taken again over a step 2^-26, then
# 2^-52, times smaller.
# 0 when |g'| is at most 2^-24 (1 + |c f_y|): the difference resolves f_y to about 2^-26 of
# it, and a slope that small is not told apart from 0, so the step's equation is taken as
# singular. NaN when there is no finite slope (fz, or every difference, not finite).
#
# ⛔ 3.4.0 (review) — THE STEP WAS ABSOLUTE AND THE SINGULAR TEST RARELY FIRED. The step was
# EPSILON_F64 (1 + |z|), 1e-12 below |z| = 1, so a state below about 1e-12 was differenced
# over a step larger than itself: backward Euler on y' = -y^2 / s from y = s, dt = 1, tol
# s 1e-12 (the step's value s (sqrt 5 - 1) / 2) returned the same bits times s only by luck
# and, from s = 2^-50, NO_CONVERGENCE after 102 evaluations of f. And the test |g'| <
# EPSILON_F64 read a slope whose difference noise was about 2^-52 / 1e-12, 2e-4: y' = lambda y
# with dt = 1 / lambda, whose step equation is singular for every lambda, spent its 50
# updates (102 evaluations) at lambda = 2^-40 to 2^40 and reported NO_CONVERGENCE. The step
# now scales with z, and the singular test with the slope's resolution: every s from 1 to
# 2^-70 gives 0x3FE3C6EF372FECB2 times s, bit for bit (9.6e-14 relative from the exact value,
# within the residual tol), after 12 evaluations, and the singular equations report
# SINGULAR_MATRIX at the first update (backward Euler after 3 evaluations, BDF-2 after 2).
# [measured: scratch probe NU1-work/c/o1.cyr, integ-snap5 and this tree, 2026-10-31]
# ⛔ 3.4.0 (second review) — AT A ZERO STATE THE STEP WAS STILL ABSOLUTE, AND AN INFINITE SLOPE
# PASSED AS SINGULAR. From rest (BDF from y = y_prev = 0) z and s are 0 and the step was 2^-26:
# f = s (cos t - (y/s)^2) at dt = 1/2 was Ok at every s down to 2^-500 and SINGULAR_MATRIX from
# 2^-600, where 2^-26 is 2^574 in units of s. And |g'| <= 2^-24 (1 + |c f_y|) read Inf <= Inf as
# true: f = cos t - exp(1e12 y) from rest at dt = 1e-3 differenced over 2^-26, exp overflowed,
# and the step was SINGULAR_MATRIX after 2 evaluations, where 3.3.7 converged in 34. The
# residual sets the step at z = 0 (in place of the state, then 1), and a slope that is not
# finite is never singular:
# the first is s 0x3FD12F0F22AE92A8 at every s from 1 to 2^-1000 (9 evaluations), the second
# Ok in 9 evaluations, 2.4e-11 relative off the root (3.3.7: 1.0e-6); k = 1e10 is Ok in 7,
# 6.0e-9 off (the first form: NO_CONVERGENCE after 101; 3.3.7: 1.6e-8 off). k = 2.5e13 is
# still NO_CONVERGENCE (its first update takes a slope 5e11 times too steep, and the next
# iterate's step, 2^-26 of 9.3e-27, sees no change in f), as on 3.3.7. The reviewer's 1,600
# stiff steps and 2,290 scaled copies keep every status, bit and count.
# [measured: review R2B scratch probes z0/z1_lane/ode_lane and NU1 z2 (.cyr), mpmath roots, 2026-10-31]
fn _ode_newton_gp(f, t, z, fz, c, g) {
    if (f64_lt(f64_abs(fz), F64_POS_INF) == 0) { return 0x7FF8000000000000; }   # no slope at z
    var h = f64_abs(z);
    if (f64_eq(h, 0) == 1) { h = f64_abs(g); }
    h = f64_mul(h, _ODE_F64_2_POW_M26);
    var dfdy = 0x7FF8000000000000;
    var k = 0;
    while (k < 3) {
        var zh = f64_add(z, h);
        dfdy = f64_div(f64_sub(fncall2(f, t, zh), fz), f64_sub(zh, z));
        if (f64_lt(f64_abs(dfdy), F64_POS_INF) == 1) { k = 3; }
        h = f64_mul(h, _ODE_F64_2_POW_M26);
        k = k + 1;
    }
    var cd = f64_mul(c, dfdy);
    if (f64_lt(f64_abs(cd), F64_POS_INF) == 0) { return 0x7FF8000000000000; }
    var gp = f64_sub(_ODE_F64_ONE, cd);
    if (f64_le(f64_abs(gp), f64_mul(_ODE_F64_2_POW_M24, f64_add(_ODE_F64_ONE, f64_abs(cd)))) == 1) { return 0; }
    return gp;
}

# Internal: the Newton solve of a BDF step, z = pred + beta * dt * f(t, z), from z =
# pred, for ode_bdf2_checked and ode_bdf_checked: at most _ODE_BDF_NEWTON updates, the
# residual tested before each and after the last. Ok(0) with z in `out`, or
# Err(HSB_ERR_NO_CONVERGENCE) or Err(HSB_ERR_SINGULAR_MATRIX) with `out` untouched.
fn _ode_bdf_newton(f, t, pred, beta, dt, tol, out) {
    var z = pred;
    var iter = 0;
    while (1 == 1) {
        var fz = fncall2(f, t, z);
        # Residual: g = z - pred - beta * h * f(t, z)
        var g = f64_sub(z, f64_add(pred, f64_mul(beta, f64_mul(dt, fz))));
        if (f64_lt(f64_abs(g), tol) == 1) {
            store64(out, z);
            return Ok(0);
        }
        if (iter >= _ODE_BDF_NEWTON) { return Err(HSB_ERR_NO_CONVERGENCE); }

        var gp = _ode_newton_gp(f, t, z, fz, f64_mul(beta, dt), g);
        if (f64_eq(gp, 0) == 1) { return Err(HSB_ERR_SINGULAR_MATRIX); }
        if (f64_eq(gp, gp) == 0) { return Err(HSB_ERR_NO_CONVERGENCE); }  # no finite slope

        z = f64_sub(z, f64_div(g, gp));
        iter = iter + 1;
    }
    return Err(HSB_ERR_NO_CONVERGENCE);
}

# ================================================================
# BDF -- General BDF step, orders 2-5
# ================================================================

# General BDF step (scalar ODE).
# f: function pointer, fncall2(f, t, y) -> dy/dt
# t: time at the NEW step (f64)
# history: vec of previous y values (most recent last). Must have >= order entries.
# order: BDF order (2, 3, 4, or 5, integer)
# dt: time step (f64)
# tol: Newton convergence tolerance (f64)
# out: pointer, y_{n+1} (f64) written here on success
# Returns: Ok(0) when an iterate's residual is below tol; Err(HSB_ERR_NO_CONVERGENCE)
# after 50 Newton updates without that; Err(HSB_ERR_SINGULAR_MATRIX) when g'(z) is not
# resolved from 0 (_ode_newton_gp);
# Err(HSB_ERR_INVALID_INPUT) for an order outside 2..5, a history shorter than the
# order, or tol <= 0 or NaN, before f is called. `out` is untouched on every Err.
# ⭐ 3.4.0 — REPLACES ode_bdf (audit D069, D070). It returned 0, a legal y, for an
# invalid order or a short history, and the last iterate z on both Newton failures. No
# value is right for an order the method does not have or a history it cannot read.
#
# Through 2.8.2 the only call reaching this function was order 4 with f == 0 and
# a constant history. That pins sum(alpha) == 1 -- the invariant the 2.6.12
# mis-transcription violated -- and nothing else: with f == 0 the beta*dt*f term
# is zero, so beta was entirely unconstrained, and the order-2/3/5 branches were
# never entered at all. It is now driven by the property that DEFINES a BDF-k
# formula: it reproduces every polynomial of degree <= k exactly. Running each
# order k over the monomials t^0..t^k is the complete order-condition set, so
# the k alphas and beta are jointly determined -- no coefficient can be wrong
# and still pass. See tests/hisab.tcyr "ode_bdf: the full order-condition set".
#must_use
public fn ode_bdf_checked(f, t, history, order, dt, tol, out) {
    var hlen = vec_len(history);

    if (hlen < order) { return Err(HSB_ERR_INVALID_INPUT); }
    if (order < 2) { return Err(HSB_ERR_INVALID_INPUT); }
    if (order > 5) { return Err(HSB_ERR_INVALID_INPUT); }
    if (f64_gt(tol, 0) == 0) { return Err(HSB_ERR_INVALID_INPUT); }

    # Select coefficients based on order
    # alphas[k] multiplies y_{n-k}, beta multiplies h*f
    # We compute the predictor: sum(alpha_k * y_{n-k})
    var pred = _ODE_F64_ZERO;
    var beta = _ODE_F64_ZERO;

    if (order == 2) {
        var y_n = vec_get(history, hlen - 1);
        var y_nm1 = vec_get(history, hlen - 2);
        pred = f64_add(f64_mul(_BDF2_A0, y_n), f64_mul(_BDF2_A1, y_nm1));
        beta = _BDF2_BETA;
    }
    if (order == 3) {
        var y_n = vec_get(history, hlen - 1);
        var y_nm1 = vec_get(history, hlen - 2);
        var y_nm2 = vec_get(history, hlen - 3);
        pred = f64_add(f64_mul(_BDF3_A0, y_n),
          f64_add(f64_mul(_BDF3_A1, y_nm1),
            f64_mul(_BDF3_A2, y_nm2)));
        beta = _BDF3_BETA;
    }
    if (order == 4) {
        var y_n = vec_get(history, hlen - 1);
        var y_nm1 = vec_get(history, hlen - 2);
        var y_nm2 = vec_get(history, hlen - 3);
        var y_nm3 = vec_get(history, hlen - 4);
        pred = f64_add(f64_mul(_BDF4_A0, y_n),
          f64_add(f64_mul(_BDF4_A1, y_nm1),
            f64_add(f64_mul(_BDF4_A2, y_nm2),
              f64_mul(_BDF4_A3, y_nm3))));
        beta = _BDF4_BETA;
    }
    if (order == 5) {
        var y_n = vec_get(history, hlen - 1);
        var y_nm1 = vec_get(history, hlen - 2);
        var y_nm2 = vec_get(history, hlen - 3);
        var y_nm3 = vec_get(history, hlen - 4);
        var y_nm4 = vec_get(history, hlen - 5);
        pred = f64_add(f64_mul(_BDF5_A0, y_n),
          f64_add(f64_mul(_BDF5_A1_C, y_nm1),
            f64_add(f64_mul(_BDF5_A2, y_nm2),
              f64_add(f64_mul(_BDF5_A3, y_nm3),
                f64_mul(_BDF5_A4, y_nm4)))));
        beta = _BDF5_BETA;
    }

    # Newton iteration
    return _ode_bdf_newton(f, t, pred, beta, dt, tol, out);
}

# ================================================================
# STOCHASTIC: Euler-Maruyama
# ================================================================

# Single Euler-Maruyama step for SDE: dY = f(t,Y)*dt + g(t,Y)*dW
# f: drift function pointer, fncall2(f, t, y) -> drift value (f64)
# g: diffusion function pointer, fncall2(g, t, y) -> diffusion coefficient (f64)
# t: current time (f64)
# y: current state (f64)
# dt: time step (f64)
# dW: Wiener increment (f64), typically N(0, sqrt(dt))
# Returns: new y value (f64)
public fn ode_euler_maruyama(f, g, t, y, dt, dW) {
    var drift = fncall2(f, t, y);
    var diff = fncall2(g, t, y);
    return f64_add(y, f64_add(
        f64_mul(drift, dt),
        f64_mul(diff, dW)));
}

# ================================================================
# STOCHASTIC: Milstein
# ================================================================

# Single Milstein step for SDE: dY = f(t,Y)*dt + g(t,Y)*dW
# Higher-order than Euler-Maruyama (strong order 1.0 vs 0.5).
# f: drift function pointer, fncall2(f, t, y) -> drift value (f64)
# g: diffusion function pointer, fncall2(g, t, y) -> diffusion coefficient (f64)
# dg_dy: derivative of diffusion wrt y, fncall2(dg_dy, t, y) -> dg/dy (f64)
# t: current time (f64)
# y: current state (f64)
# dt: time step (f64)
# dW: Wiener increment (f64)
# Returns: new y value (f64)
public fn ode_milstein(f, g, dg_dy, t, y, dt, dW) {
    var drift = fncall2(f, t, y);
    var diff = fncall2(g, t, y);
    var diff_deriv = fncall2(dg_dy, t, y);

    # Milstein: y + f*dt + g*dW + 0.5*g*(dg/dy)*(dW^2 - dt)
    var dW2 = f64_mul(dW, dW);
    var correction = f64_mul(_ODE_F64_HALF,
      f64_mul(diff,
        f64_mul(diff_deriv,
          f64_sub(dW2, dt))));

    return f64_add(y, f64_add(
        f64_mul(drift, dt),
        f64_add(f64_mul(diff, dW),
          correction)));
}

# ================================================================
# SYMPLECTIC EULER
# ================================================================

# Single symplectic (semi-implicit) Euler step.
# Updates momentum (velocity) first, then position -- preserves phase-space volume.
# dq_dp: function pointer, fncall1(dq_dp, p) -> dq/dt (often just p/m, or identity)
# dp_dq: function pointer, fncall1(dp_dq, q) -> dp/dt (i.e. force = -dV/dq)
# q: current position (f64)
# p: current momentum (f64)
# dt: time step (f64)
# Returns: pointer to a 16-byte block [q_new, p_new] (load64(r), load64(r + 8)),
#   the same contract as ode_verlet / ode_leapfrog / ode_yoshida4 below: 0 when the
#   block cannot be allocated (3.4.0; through 3.3.7 the four stored through it unchecked).
#   ⚠ Until 3.1.0 this doc block was a design monologue stating four
#   contradictory conventions; the code has always returned the block.
public fn ode_symplectic_euler(dq_dp, dp_dq, q, p, dt) {
    # Kick: update p first using force at current q
    var force = fncall1(dp_dq, q);
    var p_new = f64_add(p, f64_mul(dt, force));

    # Drift: update q using new p
    var vel = fncall1(dq_dp, p_new);
    var q_new = f64_add(q, f64_mul(dt, vel));

    var result = alloc(16);
    if (result == 0) { return 0; }    # refused: the designed 0, not a store to 0 (3.4.0)
    store64(result, q_new);
    store64(result + 8, p_new);
    return result;
}

# ================================================================
# VELOCITY VERLET
# ================================================================

# Single velocity Verlet step.
# accel_fn: function pointer, fncall1(accel_fn, q) -> acceleration (f64)
# q: current position (f64)
# v: current velocity (f64)
# dt: time step (f64)
# Returns: pointer to 16-byte block [q_new, v_new], or 0 when it cannot be allocated
public fn ode_verlet(accel_fn, q, v, dt) {
    var half_dt = f64_mul(_ODE_F64_HALF, dt);
    var a = fncall1(accel_fn, q);

    # Position: q_new = q + v*dt + 0.5*a*dt^2
    var q_new = f64_add(q, f64_add(
        f64_mul(v, dt),
        f64_mul(half_dt, f64_mul(dt, a))));

    # Acceleration at new position
    var a_new = fncall1(accel_fn, q_new);

    # Velocity: v_new = v + 0.5*(a + a_new)*dt
    var v_new = f64_add(v, f64_mul(half_dt, f64_add(a, a_new)));

    var result = alloc(16);
    if (result == 0) { return 0; }    # refused: the designed 0, not a store to 0 (3.4.0)
    store64(result, q_new);
    store64(result + 8, v_new);
    return result;
}

# ================================================================
# LEAPFROG
# ================================================================

# Single leapfrog step.
# accel_fn: function pointer, fncall1(accel_fn, q) -> acceleration (f64)
# q: current position (f64)
# v: current velocity at half-step t - dt/2 (f64)
# dt: time step (f64)
# Returns: pointer to 16-byte block [q_new, v_half_new], or 0 when it cannot be allocated
#   q_new = position at t+dt
#   v_half_new = velocity at t+dt/2
public fn ode_leapfrog(accel_fn, q, v, dt) {
    var a = fncall1(accel_fn, q);

    # Kick: v(t+dt/2) = v(t-dt/2) + a(t)*dt
    var v_new = f64_add(v, f64_mul(dt, a));

    # Drift: q(t+dt) = q(t) + v(t+dt/2)*dt
    var q_new = f64_add(q, f64_mul(dt, v_new));

    var result = alloc(16);
    if (result == 0) { return 0; }    # refused: the designed 0, not a store to 0 (3.4.0)
    store64(result, q_new);
    store64(result + 8, v_new);
    return result;
}

# ================================================================
# YOSHIDA 4TH ORDER
# ================================================================

# Single Yoshida 4th-order symplectic step.
# Uses the triple-jump composition with Yoshida coefficients.
# accel_fn: function pointer, fncall1(accel_fn, q) -> acceleration (f64)
# q: current position (f64)
# v: current velocity (f64)
# dt: time step (f64)
# Returns: pointer to 16-byte block [q_new, v_new], or 0 when it cannot be allocated
public fn ode_yoshida4(accel_fn, q, v, dt) {
    # Yoshida coefficients
    # c = [c0, c1, c1, c0], d = [w1, w0, w1]
    var c0 = _Y4_C0;
    var c1 = _Y4_C1;
    var w1 = _Y4_W1;
    var w0 = _Y4_W0;

    # Step 1: drift by c0*dt
    var qi = f64_add(q, f64_mul(f64_mul(c0, dt), v));

    # Step 1: kick by d0*dt = w1*dt
    var a = fncall1(accel_fn, qi);
    var vi = f64_add(v, f64_mul(f64_mul(w1, dt), a));

    # Step 2: drift by c1*dt
    qi = f64_add(qi, f64_mul(f64_mul(c1, dt), vi));

    # Step 2: kick by d1*dt = w0*dt
    a = fncall1(accel_fn, qi);
    vi = f64_add(vi, f64_mul(f64_mul(w0, dt), a));

    # Step 3: drift by c2*dt = c1*dt
    qi = f64_add(qi, f64_mul(f64_mul(c1, dt), vi));

    # Step 3: kick by d2*dt = w1*dt
    a = fncall1(accel_fn, qi);
    vi = f64_add(vi, f64_mul(f64_mul(w1, dt), a));

    # Step 4: final drift by c3*dt = c0*dt
    qi = f64_add(qi, f64_mul(f64_mul(c0, dt), vi));

    var result = alloc(16);
    if (result == 0) { return 0; }    # refused: the designed 0, not a store to 0 (3.4.0)
    store64(result, qi);
    store64(result + 8, vi);
    return result;
}
