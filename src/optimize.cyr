# optimize.cyr -- optimization algorithms for hisab
# Usage: shipped inside dist/hisab.cyr; in-tree, include "src/optimize.cyr" after what it requires
# Requires: src/error.cyr (stdlib resolves via cyrius.cyml [deps])
#
# Provides:
#   opt_gradient_descent      -- steepest descent with fixed learning rate
#   opt_conjugate_gradient    -- Polak-Ribiere+ conjugate gradient, strong-Wolfe line search
#   opt_bfgs                  -- BFGS quasi-Newton with Armijo line search
#   opt_lbfgs                 -- limited-memory BFGS (two-loop recursion)
#   opt_levenberg_marquardt   -- nonlinear least squares (damped Gauss-Newton)
#
# All f64 values are bit patterns (IEEE 754). Integer arguments are raw i64.
# Fallible functions return Result<T, E>: Ok(0) on success, Err(HSB_ERR_*) on
# failure, and carry #must_use (3.0.0). Out-parameters are unchanged.
# Results are written through out-param pointers.
#
# Flat arrays: alloc(n * 8), load64(arr + i * 8), store64(arr + i * 8, val).
# Function pointers:
#   f:         fncall1(f, x_ptr)           -> f64 value
#   grad:      fncall2(grad, x_ptr, out)   -> writes n f64s to out
#   residuals: fncall1(fp, x_ptr)          -> pointer to residual vector
#   jacobian:  fncall2(fp, x_ptr, out_J)   -> writes m*n f64s to out_J
#
# `residuals` may return one buffer it reuses on every call, or a fresh one:
# opt_levenberg_marquardt copies each residual vector into storage it owns before
# it calls `residuals` again (3.3.4). It must not write into its input x_ptr.
#
# Coverage note (2.8.3): opt_bfgs, opt_lbfgs and opt_levenberg_marquardt were
# reached only through their `n <= 0` / `n > _OPT_MAX_DIM` guards until 2.8.3 --
# every one returned before its first alloc, leaving ~490 lines of solver body
# unexecuted by any suite. tests/hisab.tcyr now drives all three (and the shared
# Armijo backtrack) to closed-form minimisers on a quadratic bowl, Rosenbrock,
# x^4 + x^2 and an over-determined line fit.

# ================================================================
# Constants
# ================================================================

var _OPT_F64_ZERO  = 0;
var _OPT_F64_ONE   = 0x3FF0000000000000;          # 1.0
var _OPT_F64_HALF  = 0x3FE0000000000000;          # 0.5
var _OPT_F64_C1    = 0x3F1A36E2EB1C432D;          # 1e-4 (Armijo constant)
# _opt_wolfe_search: the backtracking step's lower hold.
var _OPT_LS_TENTH  = 0x3FB999999999999A;          # 0.1
var _OPT_MAX_LS    = 40;                           # max line search iterations

# Dimension cap for the solvers whose allocation is a product of caller-supplied
# sizes -- n*n for opt_bfgs' inverse Hessian, m*(2n+1) for opt_lbfgs' history
# ring, which caps both n and m -- because such a size expression can wrap before
# alloc sees it. (Through 3.3.1 this said "currently only opt_bfgs' inverse
# Hessian", though opt_lbfgs already used it.) opt_levenberg_marquardt does not
# use it: its nr*np Jacobian buffer is guarded by a round-trip of that multiply
# (3.3.1), and its two np x np matrices come from ganita_mat_new, which returns 0
# past GANITA_MAT_MAX_ELEMS elements, so its null check reports HSB_ERR_ALLOC.
# For BFGS, n*n*8 bytes must stay inside stdlib alloc's ALLOC_MAX, which puts a
# hard ceiling at n = 16384; 4096 is the policy cap, 128 MB of Hessian. Without
# it, a large n made `alloc(n*n*8)` return 0 and the identity-initialisation loop
# immediately stored through null.
# [measured: docs/development/issues/archived/2026-08-11-caller-sized-allocs-in-num_ext.md]
#
# ⚠ THE CEILING ABOVE WAS RESTATED IN 2.11.1 BECAUSE ITS SOURCE MOVED. This
# comment previously read "ALLOC_MAX (0x10000000 = 256 MB) ... hard ceiling at
# n = 5792". Both halves were stale: cyrius 6.4.51 raised ALLOC_MAX to
# 0x80000000 = 2 GiB (`ALLOC_MAX` in lib/alloc.cyr), which makes the ceiling 16384,
# and linalg_ext.cyr had already been updated to say 2 GiB while this file was
# not. The POLICY cap of 4096 is unaffected and remains the safe number — it sits
# below both the old ceiling and the new one, which is why the drift changed no
# behaviour and nothing failed.
# [measured: docs/development/issues/archived/2026-08-11-caller-sized-allocs-in-num_ext.md]
#
# The lesson is the one this tree keeps relearning: a constant DERIVED from a
# dependency is a measurement, and it goes stale silently when the dependency
# moves. Anything deriving a bound from ALLOC_MAX must re-derive it at each
# toolchain bump, or state the policy cap without the derivation.
# [measured: docs/development/issues/archived/2026-08-11-caller-sized-allocs-in-num_ext.md]
var _OPT_MAX_DIM   = 4096;

# ================================================================
# Internal helpers
# ================================================================

# Dot product of two flat f64 arrays of length n
fn _opt_dot(a, b, n) {
    var sum = _OPT_F64_ZERO;
    var i = 0;
    while (i < n) {
        var ai = load64(a + i * 8);
        var bi = load64(b + i * 8);
        sum = f64_add(sum, f64_mul(ai, bi));
        i = i + 1;
    }
    return sum;
}

# ⭐ n-LEG SCALED RESCUE. Same shape as `_hvec3_len_scaled`, generalised to a
# length-n array: divide through by the largest component before squaring.
# ⚠ NaN NEVER REACHES HERE, and it is worth saying why rather than guarding for
# it: a NaN component makes the caller's sum NaN, which satisfies neither
# `< F64_TINY` nor `== +Inf`, so the fast path returns `f64_sqrt(NaN)` and this
# helper is not called. ⛔ An earlier draft of this comment claimed the `mx == 0`
# exit propagated NaN because it returns `mx`. Measured, it does NOT: this max is
# an explicit `f64_gt` loop, and `f64_gt(NaN, mx)` is 0, so a NaN never raises
# `mx` and an all-NaN vector would return 0 here. Returning `mx` versus a literal
# zero is an EQUIVALENCE in this shape, mutation-confirmed.
# [measured: NaN probe on both scaled helpers, 2026-09-10]
# ⛔ 3.3.3 — THIS COMMENT ALSO SAID `_hvec3_len_scaled` "uses `f64_max` and does
# propagate". Called directly, it does only sometimes. Stdlib `f64_max(a, b)` returns
# `b` when `a` is NaN, so its max, f64_max(f64_max(|x|, |y|), |z|), keeps a NaN in z
# and drops one in x; a NaN in y survives the inner max and the outer one drops it,
# returning |z|. A dropped NaN still reaches the division when that max is finite and
# non-zero, so (NaN, 1, 0) and (0, NaN, 1) are NaN; but the exits return the max
# itself when it is 0 or +Inf, so (NaN, 0, 0) and (1, NaN, 0) give 0 and
# (NaN, +Inf, 0) gives +Inf.
# Both helpers rely on the routing above, not on their own exits; and the `f64_gt`
# exit below, TRUE for NaN, stays because no NaN can reach it.
# [measured: scratch harness, not reproducible in-tree, 2026-10-01; cycc 6.6.12]
# ⚠ The `+Inf` exit is REQUIRED: without it `Inf/Inf` is NaN and an infinite
# component would turn a well-defined +Inf norm into a NaN.
fn _opt_norm_scaled(v, n) {
    var mx = _OPT_F64_ZERO;
    var i = 0;
    while (i < n) {
        var a = f64_abs(load64(v + i * 8));
        if (f64_gt(a, mx) == 1) { mx = a; }
        i = i + 1;
    }
    if (f64_gt(mx, 0) == 0) { return mx; }
    if (f64_eq(mx, F64_POS_INF) == 1) { return mx; }
    var s = _OPT_F64_ZERO;
    i = 0;
    while (i < n) {
        var q = f64_div(load64(v + i * 8), mx);
        s = f64_add(s, f64_mul(q, q));
        i = i + 1;
    }
    return f64_mul(mx, f64_sqrt(s));
}

# ⛔ 2.17.0 — THE NORM SQUARED BEFORE SUMMING, and in an optimiser that does not
# produce a wrong number, it produces a CONFIDENT SUCCESS AT THE STARTING POINT.
# Every convergence test in this file is `norm < tol`, so a gradient whose largest
# component falls below 2^-538 has a norm of exactly 0, the test fires on the
# first iteration, and the solver returns `HSB_ERR_NONE` with `out_x` still equal
# to `x0`. Measured on `opt_conjugate_gradient` with the objective scaled by C
# (which leaves the argmin exactly where it was): **988 of 1001 scales give the
# wrong answer and 446 of those are SILENT** — rc = HSB_ERR_NONE, x unmoved.
# ⚠ THE FIXTURE HAS TO SCALE THE OBJECTIVE, NOT THE VARIABLES. Scaling the
# variables scales the gradient AND the distance to the minimum together, so the
# step falls below the ULP of x and the solver stalls for a reason that is not
# this defect — the trap 2.15.0's optimizer sweep already fell into.
# [measured: 1001-scale objective sweep on opt_conjugate_gradient, 2026-09-10]
#
# ⭐ SUM-AWARE, because two of the three call sites ALREADY HAVE the sum. `gg_old`
# in conjugate-gradient and `cost` in Levenberg-Marquardt are carried across
# iterations deliberately, and recomputing the dot product to get a norm would
# cost an O(n) pass per iteration for nothing. The rescue re-reads the vector, but
# only on the path where the naive sum has already announced that it failed.
fn _opt_norm_ss(v, n, ss) {
    if (f64_lt(ss, F64_TINY) == 1) { return _opt_norm_scaled(v, n); }
    if (f64_eq(ss, F64_POS_INF) == 1) { return _opt_norm_scaled(v, n); }
    return f64_sqrt(ss);
}

# Euclidean norm of a flat f64 array of length n
fn _opt_norm(v, n) {
    return _opt_norm_ss(v, n, _opt_dot(v, v, n));
}

# Copy n f64 values from src to dst
fn _opt_copy(dst, src, n) {
    var i = 0;
    while (i < n) {
        store64(dst + i * 8, load64(src + i * 8));
        i = i + 1;
    }
    return 0;
}

# dst = a + scale * b  (flat f64 arrays of length n)
fn _opt_axpy(dst, a, scale, b, n) {
    var i = 0;
    while (i < n) {
        var ai = load64(a + i * 8);
        var bi = load64(b + i * 8);
        store64(dst + i * 8, f64_add(ai, f64_mul(scale, bi)));
        i = i + 1;
    }
    return 0;
}

# The power of two 2^m that opt_bfgs and opt_lbfgs multiply a correction pair (s, y) by
# before its curvature test, given ns = ||s|| and ny = ||y||: m puts ns * ny in [1, 8)
# (a subnormal norm is read as 2^-1023, below).
# Returns 0 (leave the pair alone) when that product is already within [2^-511, 2^513),
# and when either norm is zero, infinite or NaN, which no power of two can mend.
#
# ⛔ 3.3.6 — THE PAIR WAS TESTED AND INVERTED AT ITS OWN SCALE. s.y and ||s|| ||y|| go as
# the square of the step, so near the minimum of a problem whose variables are below
# about 2^-496 both fall under DBL_MIN: EPSILON_F64 * ||s|| ||y|| underflowed below a
# still-positive s.y, the cosine test accepted the pair, and rho = 1 / s.y was +Inf.
# f = (x0 - k)^2 + 1e5 (x1 - 2k)^2 from (-k/2, 5k/2), tol k * 1e-8, 400 iterations:
# opt_bfgs returned Err(NO_CONVERGENCE) with NaN in out_x for every k = 2^-496 to
# 2^-600, opt_lbfgs from 2^-497. At the other end opt_bfgs at k = 2^495 formed y.Hy past
# DBL_MAX on its first update and returned NaN too. The BFGS update and the L-BFGS
# recursion are invariant when s and y are multiplied by the same constant c (rho goes
# as 1/c^2), so the pair is now taken at the scale where ||s|| ||y|| is about 1 when it
# is far from it. Multiplying by a power of two is exact where nothing underflows or
# overflows, so a pair this rescales gives the bits it gave unscaled wherever the
# unscaled arithmetic stayed normal, and a pair in the band is not touched at all. On
# that sweep both solvers now reach (k, 2k) for every k from 2^-1048 (below which the
# fixture's tol underflows) to 2^520 but 2^511 (f(x0) overflows from 2^505); of 3.3.5's
# right answers only those at k = 2^495 to 2^504 moved bits (still right), where its
# unscaled y.y, y.Hy or ||s|| ||y|| overflowed.
# [measured: scratch optimizer scale sweep, k = 2^-1074 to 2^520 x 3 solvers, 3.3.5 tree and this tree, 2026-10-11]
fn _opt_pair_scale(ns, ny) {
    if (f64_gt(ns, 0) == 0 || f64_gt(ny, 0) == 0) { return 0; }
    if (f64_lt(ns, F64_POS_INF) == 0 || f64_lt(ny, F64_POS_INF) == 0) { return 0; }
    # The exponent fields: a subnormal norm reads -1023, at most 51 short of its own
    # exponent, which leaves the rescaled product at least 2^-102: normal, all it needs.
    var e = ((ns >> 52) & 0x7FF) + ((ny >> 52) & 0x7FF) - 2046;
    if (e >= 0 - 511 && e <= 511) { return 0; }
    return 0 - (e - (e & 1)) / 2;              # -floor(e / 2): e + 2m is 0 or 1
}

# v *= 2^m, for |m| <= 1074, in two exact steps (each factor is a normal power of two).
fn _opt_scale_pow2(v, n, m) {
    var m1 = m / 2;
    var f1 = (1023 + m1) << 52;
    var f2 = (1023 + m - m1) << 52;
    var i = 0;
    while (i < n) {
        store64(v + i * 8, f64_mul(f64_mul(load64(v + i * 8), f1), f2));
        i = i + 1;
    }
    return 0;
}

# x * 2^m, for -2044 <= m <= 2046, in two steps (each factor a normal power of two): exact
# where the result is normal. At m = -2045 or -2046 a factor's exponent field would be 0.
# The callers stay inside: _opt_pair_scale's power is at most 1023 in magnitude, and
# _opt_armijo scales its decrease back by -2 times one that is negative, at most 2046.
fn _opt_pow2(x, m) {
    var m1 = m / 2;
    return f64_mul(f64_mul(x, (1023 + m1) << 52), (1023 + m - m1) << 52);
}

# Armijo backtracking line search.
# Finds alpha such that f(x + alpha*d) <= f(x) + c1*alpha*(grad . d).
# Writes x + alpha*d into x_trial.
# Returns the f64 step size alpha.
fn _opt_armijo(f, x, d, grad_ptr, n, f_old, x_trial) {
    var dg = _opt_dot(d, grad_ptr, n);
    # ⛔ 3.3.7 — d.g OVERFLOWED WHERE THE ARMIJO DECREASE DID NOT. d.g goes as the square of
    # the gradient's scale, so from |g| near 2^512 it was +-Inf while c1 * alpha * d.g is
    # 2^-13 of it: a descent direction's threshold was -Inf, no step passed, and after 40
    # halvings the fallback took alpha = 2^-40. opt_conjugate_gradient, whose direction
    # stays at the gradient's scale, made no progress on the BFGS scale fixture from
    # k = 2^496 (see there). An infinite d.g is now formed from d and g each rescaled by the
    # power of two _opt_pair_scale gives their norms, and the decrease is multiplied back
    # (dsc). A finite d.g takes the 3.3.6 operations, bit for bit.
    var dsc = 0;
    if (f64_eq(f64_abs(dg), F64_POS_INF) == 1) {
        var dm = _opt_pair_scale(_opt_norm(d, n), _opt_norm(grad_ptr, n));
        if (dm != 0) {
            var sdg = _OPT_F64_ZERO;
            var di = 0;
            while (di < n) {
                var dd = _opt_pow2(load64(d + di * 8), dm);
                sdg = f64_add(sdg, f64_mul(dd, _opt_pow2(load64(grad_ptr + di * 8), dm)));
                di = di + 1;
            }
            dg = sdg;
            dsc = 0 - 2 * dm;
        }
    }
    var alpha = _OPT_F64_ONE;

    var ls = 0;
    while (ls < _OPT_MAX_LS) {
        _opt_axpy(x_trial, x, alpha, d, n);
        var f_new = fncall1(f, x_trial);
        var dec = f64_mul(_OPT_F64_C1, f64_mul(alpha, dg));
        if (dsc != 0) { dec = _opt_pow2(dec, dsc); }
        var threshold = f64_add(f_old, dec);
        if (f64_lt(f_new, threshold) == 1) {
            return alpha;
        }
        # The second test is where NaN has to be handled, because every f64 comparison
        # involving NaN returns 0. The old `f64_lt(threshold, f_new) == 0` alone also
        # accepted a NaN objective, taking the step and poisoning x for BFGS, L-BFGS and
        # CG; requiring f_new to compare equal to itself rejects a NaN f_new. What it
        # accepts is a number f_new with f_new <= threshold (the tie, as the first test
        # took the rest) or beside a NaN `threshold`, where `f64_lt(NaN, f_new)` is 0.
        # ⚠ 3.3.3 — THAT NaN-`threshold` CASE IS KEPT. f(x) NaN at the iterate, or a
        # NaN in grad . d, makes the first step whose f_new is a number pass. No public
        # result is fabricated by it: CG, BFGS and L-BFGS return Ok only once the
        # gradient-norm test passes at a finite gradient, and every other exit is
        # NO_CONVERGENCE. With f = (x-3)^2 made NaN at x0 = 0 (n = 1, max_iter 200,
        # L-BFGS m = 5), all three return Ok at the minimiser: BFGS and L-BFGS at
        # exactly 3 for tol 1e-6, 1e-8 and 1e-12; CG 5.5e-12 off 3 for tol 1e-6 and
        # 1e-8, and exactly 3 for tol 1e-12. With a NaN gradient component f ignores
        # (n = 2), all three return NO_CONVERGENCE with the NaN in out_x. `f64_le(f_new,
        # threshold)` differs from this test only for a NaN threshold beside a number,
        # which it rejects: CG then lands on exactly 3 at all three tolerances, and the
        # NaN-gradient runs stay NO_CONVERGENCE.
        # [measured: NaN-threshold probe, 3.3.2 and 3.3.3 bundles and an f64_le build, 2026-10-01]
        # ⛔ 3.3.7 — AND A STEP TO f = +Inf PASSED A THRESHOLD THAT HAD OVERFLOWED. Along a
        # direction that is not a descent one, f_old + c1 * alpha * d.g can round to +Inf (a
        # d.g that overflowed to +Inf made it so in 3.3.6 too), and +Inf <= +Inf took the
        # step. With the d.g repair above and not this one, opt_conjugate_gradient at
        # k = 2^504 on the BFGS scale fixture took such a step at its second iteration and
        # returned NaN (3.3.6 there: a finite wrong point, both NO_CONVERGENCE). A step from a
        # finite f to +Inf is never a decrease, and is now refused; from an infinite or NaN
        # f_old it is taken as before.
        # [measured: scratch CG variant sweeps (pcgv2.cyr, pcgv5.cyr, pcgdbg.cyr), 2026-10-31]
        if (f64_eq(f_new, f_new) == 1 && f64_lt(threshold, f_new) == 0) {
            if (f64_eq(f_new, F64_POS_INF) == 0 || f64_lt(f64_abs(f_old), F64_POS_INF) == 0) {
                return alpha;
            }
        }
        alpha = f64_mul(alpha, _OPT_F64_HALF);
        ls = ls + 1;
    }
    # Fallback: use the last alpha
    _opt_axpy(x_trial, x, alpha, d, n);
    return alpha;
}

# The line search constants of opt_conjugate_gradient and opt_lbfgs (_opt_wolfe_search):
# the curvature constants of the strong Wolfe conditions, 0.1 for conjugate gradients and
# 0.9 for a quasi-Newton step (Nocedal & Wright's values), the relative allowance on f
# where the Armijo decrease cannot be measured (Hager & Zhang's approximate Wolfe
# conditions use 1e-6; 2^-20 here), and the trial cap.
# [measured: tests/edge_cases.tcyr, group "3.4.0: opt_conjugate_gradient, a line search on the slope"]
enum _OptCg {
    _OPT_CG_SIGMA = 0x3FB999999999999A;    # 0.1
    _OPT_QN_SIGMA = 0x3FECCCCCCCCCCCCD;    # 0.9
    _OPT_CG_EPS = 0x3EB0000000000000;      # 2^-20
    _OPT_CG_MAX_LS = 40;
}

# Internal: the slope d.g with d and g each multiplied by 2^m first (m = 0: the plain
# dot product). Every slope of one line search shares m, so their ratios, which are all
# the search reads, are those of the unscaled slopes wherever both forms are normal, and
# the search is unchanged when the problem is scaled by a power of two.
fn _opt_cg_slope(d, g, n, m) {
    if (m == 0) { return _opt_dot(d, g, n); }
    var s = _OPT_F64_ZERO;
    var i = 0;
    while (i < n) {
        s = f64_add(s, f64_mul(_opt_pow2(load64(d + i * 8), m), _opt_pow2(load64(g + i * 8), m)));
        i = i + 1;
    }
    return s;
}

# Internal: the first trial step of an iteration after the first, a_prev * s_prev / s,
# where s_prev and s are the slopes at alpha = 0 of the last search and this one, read
# at scales 2^(2 m_prev) and 2^(2 m). 1 where that is not a positive finite number.
fn _opt_cg_first(a_prev, s_prev, m_prev, s, m) {
    var k = 2 * (m - m_prev);
    if (k < 0 - 2000 || k > 2000) { return F64_ONE; }
    var a = f64_mul(a_prev, _opt_pow2(f64_div(s_prev, s), k));
    if (f64_gt(a, 0) == 0 || f64_lt(a, F64_POS_INF) == 0) { return F64_ONE; }
    return a;
}

# Internal: the line search of opt_conjugate_gradient (sigma 0.1) and opt_lbfgs (0.9).
# Finds alpha > 0 with
#   |phi'(alpha)| <= sigma |phi'(0)|                       (curvature, strong Wolfe)
#   phi(alpha) <= phi(0) + c1 alpha phi'(0)                 (Armijo, where measurable)
# for phi(alpha) = f(x + alpha d), phi'(alpha) = g(x + alpha d).d, from the trial a0.
# f0 = phi(0); dg0 = phi'(0) < 0 at scale 2^(2m) (_opt_cg_slope). A trial point
# that brackets the minimum along d -- its slope is not negative, or f rose past the
# allowance -- becomes the bracket's high end, one with a negative slope and an
# acceptable f its low end; the next trial is the secant root of phi' between them
# (exact for a quadratic), with the Illinois rule (an end kept twice in a row has its
# slope halved in the secant) so that a convex phi' cannot hold one end fixed and
# creep in from the other, the bisection where that is not inside the bracket, and,
# before a high end is found, the secant extrapolation of the last two slopes, held to
# [2, 16] times the step. Writes x + alpha d to x_trial, its gradient to g_new and f
# there to st, and returns alpha. When no trial in _OPT_CG_MAX_LS meets both conditions,
# or the bracket holds no double between its ends, it returns the bracket's low end (a
# step that descends, with an acceptable f, 0 when there is none) and sets st[2] to 1:
# x_trial, g_new and st[0] then hold the last trial's, and the caller re-evaluates.
#
# ⛔ 3.4.0 — THE ARMIJO BACKTRACK COULD NOT FIND A CONJUGATE GRADIENT STEP. CG's directions
# are conjugate only when each step reaches the minimum along its line, and halving from
# a unit step stops wherever f first decreases: on f = (x0 - 1)^2 + 1e5 (x1 - 2)^2 from
# (-0.5, 2.5), tol 1e-8, opt_conjugate_gradient took 300 iterations (301 gradients, 7,741
# values of f) to stop 5.1e-10 from x0 = 1, where opt_bfgs takes 7 gradients, and 2 is the
# exact count for a quadratic in two variables. And below 2^-495 in
# the variables f falls under DBL_MIN near the minimum, where phi(0) + c1 alpha phi'(0)
# rounds to phi(0) and no f-based test can measure a step (3.3.7's documented limit).
# The search now measures the slope, which goes as the scale and not its square; where
# the Armijo decrease is not representable at f0 (f0 zero or subnormal, or f0 + dec
# rounding back to f0), it asks f only not to rise by more than 2^-20 |f0| (the
# approximate Wolfe conditions of Hager & Zhang, ACM TOMS 32 (2006) 113). On that fixture CG
# now takes 2 iterations, 5 gradients and 5 values of f, and stops at (1 - 2^-52, 2), 2.2e-16
# from the minimiser; scaled by 2^e it gives that answer times 2^e, bit for bit, at every e
# from -1017 to 511 (3.3.7: e = -495 to 504 converged), and converges from -1022 to 520.
# On f = sum (i+1)(x_i - 1)^2 + x0 x1 from (3, -2, 5) at tol 1e-9 (the D102 audit's F-O1)
# it takes 7 gradients where 3.3.7 returned NO_CONVERGENCE after 30,000 iterations and
# 718,235 values of f; on Rosenbrock scaled by C from (-1, 2), tol C 1e-6, it converges at
# every C from 1 to 2^-1000 in 127 to 383 gradients (3.3.7: at C = 1 only, 1,767).
# [measured: scratch CG probes (NU1-work/p/pcg.cyr, pcg3.cyr, pcg2.cyr, pq3.cyr), base tree and this tree, 2026-10-31]
#
# ⛔ 3.4.0 (review) — THE QUASI-NEWTON SEARCH PAID A GRADIENT FOR EVERY TRIAL. A trial that
# fails Armijo puts the line's minimum behind it whatever its slope, and 3.3.7's backtrack
# never asked for one; the first form did, at every trial, and opt_lbfgs (m = 5) spent 178
# values of f and 178 gradients on Wood from (-3, -1, -3, -1), tol 1e-8, where 3.3.7 spent 95
# and 38. In the quasi-Newton search (sigma 0.9) such a trial, where f is measurable and
# finite, now costs f alone, and the next trial minimises the quadratic through phi(lo),
# phi'(lo) and phi(alpha), held to [0.1, 0.5] of the way from lo (_opt_ls_quad); the unit
# step is still tried first and taken when it meets both conditions. CG's search (sigma 0.1)
# keeps every trial's slope, which its accuracy needs, and with it its bit-for-bit
# invariance under power-of-two scaling.
# opt_lbfgs, f / gradients, this form against the first and 3.3.7:
#   Rosenbrock 2-D from (-1.2, 1)        60 / 47     85 / 85     1,375 / 674
#   extended Rosenbrock 10-D             117 / 101   184 / 184   198 / 88
#   Beale from (1, 1)                    21 / 19     32 / 32     34 / 15
#   Powell singular from (3, -1, 0, 1)   58 / 50     100 / 100   171 / 76
#   Wood from (-3, -1, -3, -1)           149 / 118   178 / 178   95 / 38
#   6-D quadratic, kappa 1e4             165 / 142   110 / 110   470 / 203
#   6-D quadratic, kappa 1e8             1,035 / 850 811 / 811   3,614 / 1,504
# Against 3.3.7 the gradient count rises on three rows, Wood 38 -> 118 (x3.1), extended
# Rosenbrock 88 -> 101 and Beale 15 -> 19, and falls on the other four. Wood's count is its
# path's: this form and the first pass through the stationary region near f = 7.877 and take
# about 100 iterations there; 3.3.7's first halved step (f = 9,241, above this form's 2,890)
# happened to leave it. On ill-conditioned quadratics the held
# quadratic step lands short of the line's minimum where the secant of the slopes reached
# it, and the counts rise; past the range of f (scale 2^500, 2^-600) the slopes decide as
# before, so opt_lbfgs's path is no longer the same at every power-of-two scale (the 1e5
# quadratic: 16 / 10 at scale 1, 9 / 9 at 2^500 and 2^-600). CG and BFGS are unchanged.
# [measured: the reviewer's optimizer set (NU1-work/o/opt.cyr), this tree, integ-snap5 and 3.3.7, 2026-10-31]
fn _opt_wolfe_search(f, grad, x, d, n, f0, dg0, m, a0, sigma, x_trial, g_new, st) {
    var fcap = f64_add(f0, f64_mul(_OPT_CG_EPS, f64_abs(f0)));    # f0 + 2^-20 |f0|
    var f0fin = f64_lt(f64_abs(f0), F64_POS_INF);
    var curv = f64_mul(sigma, f64_abs(dg0));
    var qn = f64_lt(_OPT_CG_SIGMA, sigma);                         # the quasi-Newton search
    var lo = 0;
    var dlo = dg0;
    var flo = f0;
    var plo = 0;
    var pdlo = dg0;
    var hi = 0;
    var dhi = 0;
    var fhi = 0;
    var have_hi = 0;
    var hi_sec = 0;
    var hi_f = 0;       # 1: the high end is known from f alone (an Armijo failure)
    var wlo = dg0;      # the slopes the secant uses (Illinois-weighted)
    var whi = 0;
    var last = 0;       # the end the last trial replaced: 1 low, 2 high
    var alpha = a0;
    var ls = 0;
    while (ls < _OPT_CG_MAX_LS) {
        _opt_axpy(x_trial, x, alpha, d, n);
        var fa = fncall1(f, x_trial);
        # fok: f is acceptable here. fbad: f says the line's minimum is behind alpha.
        var fok = 0;
        var fbad = 0;
        var meas = 0;
        if (f0fin == 0) {
            # phi(0) is +-Inf or NaN. f must not rise past it (+Inf to +Inf is f saying
            # nothing, as an underflowed f says nothing); after a NaN, any number will do.
            fok = f64_le(fa, f0);
            if (f64_eq(f0, f0) == 0) { fok = f64_eq(fa, fa); }
            fbad = 1 - fok;
        } else {
            if (f64_le(fa, fcap) == 0) { fbad = 1; }            # true for a NaN fa
            var dec = f64_mul(_OPT_F64_C1, f64_mul(alpha, dg0));
            if (m != 0) { dec = _opt_pow2(dec, 0 - 2 * m); }
            var thr = f64_add(f0, dec);
            if (f64_lt(f64_abs(f0), F64_TINY) == 0 && f64_lt(thr, f0) == 1) {
                meas = 1;
                fok = f64_le(fa, thr);                         # Armijo, measurable
            } else {
                fok = 1 - fbad;                                # approximate Wolfe
            }
        }
        var next = 0;
        if (qn == 1 && meas == 1 && fok == 0 && f64_lt(f64_abs(fa), F64_POS_INF) == 1) {
            # Armijo fails where it is measurable: f alone puts the minimum behind alpha, and
            # the gradient here is not needed. The next trial minimises the quadratic through
            # phi(lo), phi'(lo) and phi(alpha), held to [0.1, 0.5] of the way from lo.
            hi = alpha;
            fhi = fa;
            have_hi = 1;
            hi_sec = 0;
            hi_f = 1;
            last = 0;           # no secant end was kept: the Illinois rule starts afresh
            next = _opt_ls_quad(lo, flo, dlo, hi, fhi, m);
        } else {
            var g_rc = fncall2(grad, x_trial, g_new);
            var da = _opt_cg_slope(d, g_new, n, m);
            if (fok == 1 && f64_le(f64_abs(da), curv) == 1) {
                store64(st, fa);
                store64(st + 8, da);
                store64(st + 16, 0);
                return alpha;
            }
            if (fbad == 1 || fok == 0 || f64_lt(da, 0) == 0) {
                hi = alpha;
                dhi = da;
                fhi = fa;
                have_hi = 1;
                hi_f = 0;
                # The secant needs a slope that is a number and not negative at the high end
                # (an f that rose past the allowance or overflowed does not spoil the slope).
                hi_sec = 0;
                if (f64_le(0, da) == 1 && f64_lt(da, F64_POS_INF) == 1) { hi_sec = 1; }
                whi = da;
                if (last == 2) { wlo = f64_mul(wlo, F64_HALF); }
                last = 2;
            } else {
                plo = lo;
                pdlo = dlo;
                lo = alpha;
                dlo = da;
                flo = fa;
                wlo = da;
                if (last == 1) { whi = f64_mul(whi, F64_HALF); }
                last = 1;
            }
            if (have_hi == 0) {
                # Extrapolate: the secant of the last two slopes, in [2, 16] times the step.
                next = f64_mul(lo, 0x4030000000000000);                         # 16 lo
                if (f64_lt(pdlo, dlo) == 1) {
                    var ex = f64_sub(lo, f64_div(f64_mul(dlo, f64_sub(lo, plo)), f64_sub(dlo, pdlo)));
                    if (f64_lt(ex, next) == 1) { next = ex; }
                }
                var lo2 = f64_mul(lo, F64_TWO);
                if (f64_lt(next, lo2) == 1) { next = lo2; }
            } else {
                if (hi_f == 1) {
                    next = _opt_ls_quad(lo, flo, dlo, hi, fhi, m);
                } else {
                    next = f64_mul(f64_add(lo, hi), F64_HALF);
                    if (hi_sec == 1 && f64_lt(wlo, whi) == 1) {
                        var sec = f64_sub(lo, f64_div(f64_mul(wlo, f64_sub(hi, lo)), f64_sub(whi, wlo)));
                        if (f64_lt(lo, sec) == 1 && f64_lt(sec, hi) == 1) { next = sec; }
                    }
                }
            }
        }
        if (have_hi == 1) {
            if (f64_le(next, lo) == 1 || f64_le(hi, next) == 1) { ls = _OPT_CG_MAX_LS; }   # no double between
        }
        if (f64_lt(next, F64_POS_INF) == 0) { ls = _OPT_CG_MAX_LS; }
        alpha = next;
        ls = ls + 1;
    }
    store64(st + 16, 1);
    return lo;
}

# Internal: the next trial of _opt_wolfe_search after an Armijo failure at hi: the minimiser
# lo - phi'(lo) w^2 / (2 (phi(hi) - phi(lo) - phi'(lo) w)), w = hi - lo, of the quadratic
# through phi(lo), phi'(lo) (dlo, read at scale 2^(2m)) and phi(hi), held to [lo + w/10,
# lo + w/2]; the midpoint where that is not a number.
fn _opt_ls_quad(lo, flo, dlo, hi, fhi, m) {
    var w = f64_sub(hi, lo);
    var s = dlo;
    if (m != 0) { s = _opt_pow2(dlo, 0 - 2 * m); }
    var den = f64_mul(F64_TWO, f64_sub(f64_sub(fhi, flo), f64_mul(s, w)));
    var t = f64_div(f64_mul(f64_neg(s), f64_mul(w, w)), den);
    var tmin = f64_mul(w, _OPT_LS_TENTH);
    var tmax = f64_mul(w, F64_HALF);
    if (f64_eq(t, t) == 0) { t = tmax; }
    if (f64_lt(t, tmin) == 1) { t = tmin; }
    if (f64_lt(tmax, t) == 1) { t = tmax; }
    return f64_add(lo, t);
}

# ================================================================
# 1. GRADIENT DESCENT
# ================================================================

# Steepest descent minimization of f: R^n -> R.
# f:        function pointer, fncall1(f, x_ptr) -> f64 value
# grad:     function pointer, fncall2(grad, x_ptr, out_grad) -> writes gradient
# x0:       initial point (flat array of n f64s)
# n:        dimension (integer)
# lr:       learning rate (f64 bit pattern)
# tol:      convergence tolerance on gradient norm (f64)
# max_iter: maximum iterations (integer)
# out_x:    pointer where optimal x is written (n f64s, caller allocates)
# out_fmin: pointer where minimum f value is written (1 f64, caller allocates)
# Returns:  Ok(0) on success, Err(HSB_ERR_INVALID_INPUT) or Err(HSB_ERR_NO_CONVERGENCE)
#must_use
public fn opt_gradient_descent(f, grad, x0, n, lr, tol, max_iter, out_x, out_fmin) {
    if (n <= 0) { return Err(HSB_ERR_INVALID_INPUT); }
    # ⛔ CWE-190: `n * 8` WRAPS, AND THE WRAP DEFEATS THE NULL CHECK BELOW. For
    # n >= 2^61+1 the product is a small POSITIVE number — n = 2^61+1 gives
    # exactly **8** — so `alloc` SUCCEEDS, every handle is non-zero, and
    # `_opt_copy` then walks 2^61 slots through an 8-byte buffer. Measured: exit
    # 139 even with 1 GiB caller buffers, so the fault is this function's own
    # allocation, not a short `x0`. No caller can prevent it and no buffer of
    # 2^61 f64s can exist, so it is not a precondition anyone could satisfy.
    # [measured: scratch harness, not reproducible in-tree, 2026-09-09; cycc 6.6.2]
    #
    # ⭐ THE ROUND-TRIP IS THE GUARD, not a dimension cap. It tests the multiply
    # this function actually performs, so it needs no constant, cannot be wrong
    # for a different element size, and cannot go stale when ALLOC_MAX moves —
    # which is the failure this file already records at `_OPT_MAX_DIM` (an
    # ALLOC_MAX-derived 5792 that had to become 16384 when 6.4.51 moved it).
    # ⚠ A `n > _OPT_MAX_DIM` cap was measured and REJECTED: it removes a working
    # capability. `_OPT_MAX_DIM`'s own comment scopes it to solvers whose allocation
    # is a product of caller sizes; every allocation here is a single n*8, and a
    # CONFORMING caller at n = 1e7 returns normally today and would start being refused.
    # [measured: scratch harness, not reproducible in-tree, 2026-09-09; cycc 6.6.2]
    # Every larger-but-representable n is already handled by the `alloc == 0`
    # check further down.
    # Values: n = 2^61+1 exits 139 with 1 GiB caller buffers; n = 2^28 and n = 1e9
    # are unaffected; a conforming n = 1e7 still returns normally.
    # [measured: scratch harness, not reproducible in-tree, 2026-09-09; cycc 6.6.2]
    if (n != (n * 8) / 8) { return Err(HSB_ERR_INVALID_INPUT); }

    # Working copy of x
    var x = alloc(n * 8);
    # Gradient buffer
    var g = alloc(n * 8);
    if (x == 0 || g == 0) { return Err(HSB_ERR_ALLOC); }
    _opt_copy(x, x0, n);

    var iter = 0;
    while (iter < max_iter) {
        # Evaluate gradient
        # ⛔ BOUND, NOT A BARE STATEMENT -- and every gradient/Jacobian call in this
        # file is written the same way. Consumers compile this bundle under their
        # own cycc, and cycc 6.6.2-6.6.4 lowered a bare `fncall2(f, a, b);` without
        # closure awareness: a capturing closure passed as `grad` (the tape recipe
        # in autodiff.cyr) SIGSEGVed there, and binding the result fixed it. Six
        # direct consumers pin 6.6.3. Fixed upstream in cycc 6.6.5; this stays while
        # consumers sit below it. CI fails on any bare `fncall` statement in src/.
        # [measured: scratch harness, not reproducible in-tree, 2026-09-30]
        # (bare: exit 139 on 6.6.2, 6.6.3, 6.6.4; bound: 0 there; both 0 on 6.6.5, 6.6.12)
        var g_rc = fncall2(grad, x, g);

        # Check convergence: ||g|| < tol
        var gnorm = _opt_norm(g, n);
        if (f64_lt(gnorm, tol) == 1) {
            _opt_copy(out_x, x, n);
            store64(out_fmin, fncall1(f, x));
            return Ok(0);
        }

        # x = x - lr * g
        var i = 0;
        while (i < n) {
            var xi = load64(x + i * 8);
            var gi = load64(g + i * 8);
            store64(x + i * 8, f64_sub(xi, f64_mul(lr, gi)));
            i = i + 1;
        }

        iter = iter + 1;
    }

    # Return best estimate even on non-convergence
    _opt_copy(out_x, x, n);
    store64(out_fmin, fncall1(f, x));
    return Err(HSB_ERR_NO_CONVERGENCE);
}

# ================================================================
# 2. CONJUGATE GRADIENT (Polak-Ribiere+)
# ================================================================

# Polak-Ribiere+ conjugate gradient minimization of f: R^n -> R.
# (The beta update below is Polak-Ribiere with a max(0, beta) restart, NOT
# Fletcher-Reeves; both doc lines said Fletcher-Reeves through 2.6.14.) Each step is
# found by _opt_wolfe_search, a line search on the slope g(x + alpha d).d to the strong
# Wolfe conditions, and a direction that is not a descent one (d.g >= 0) is replaced
# by -g (3.4.0).
# f:        function pointer, fncall1(f, x_ptr) -> f64 value
# grad:     function pointer, fncall2(grad, x_ptr, out_grad) -> writes gradient
# x0:       initial point (flat array of n f64s)
# n:        dimension (integer)
# tol:      convergence tolerance on gradient norm (f64)
# max_iter: maximum iterations (integer)
# out_x:    pointer where optimal x is written (n f64s, caller allocates)
# out_fmin: pointer where minimum f value is written (1 f64, caller allocates)
# Returns:  Ok(0) on success, Err(HSB_ERR_INVALID_INPUT) or Err(HSB_ERR_NO_CONVERGENCE)
#must_use
public fn opt_conjugate_gradient(f, grad, x0, n, tol, max_iter, out_x, out_fmin) {
    if (n <= 0) { return Err(HSB_ERR_INVALID_INPUT); }
    # ⛔ CWE-190: `n * 8` WRAPS, AND THE WRAP DEFEATS THE NULL CHECK BELOW. For
    # n >= 2^61+1 the product is a small POSITIVE number — n = 2^61+1 gives
    # exactly **8** — so `alloc` SUCCEEDS, every handle is non-zero, and
    # `_opt_copy` then walks 2^61 slots through an 8-byte buffer. Measured: exit
    # 139 even with 1 GiB caller buffers, so the fault is this function's own
    # allocation, not a short `x0`. No caller can prevent it and no buffer of
    # 2^61 f64s can exist, so it is not a precondition anyone could satisfy.
    # [measured: scratch harness, not reproducible in-tree, 2026-09-09; cycc 6.6.2]
    #
    # ⭐ THE ROUND-TRIP IS THE GUARD, not a dimension cap. It tests the multiply
    # this function actually performs, so it needs no constant, cannot be wrong
    # for a different element size, and cannot go stale when ALLOC_MAX moves —
    # which is the failure this file already records at `_OPT_MAX_DIM` (an
    # ALLOC_MAX-derived 5792 that had to become 16384 when 6.4.51 moved it).
    # ⚠ A `n > _OPT_MAX_DIM` cap was measured and REJECTED: it removes a working
    # capability. `_OPT_MAX_DIM`'s own comment scopes it to solvers whose allocation
    # is a product of caller sizes; every allocation here is a single n*8, and a
    # CONFORMING caller at n = 1e7 returns normally today and would start being refused.
    # [measured: scratch harness, not reproducible in-tree, 2026-09-09; cycc 6.6.2]
    # Every larger-but-representable n is already handled by the `alloc == 0`
    # check further down.
    # Values: n = 2^61+1 exits 139 with 1 GiB caller buffers; n = 2^28 and n = 1e9
    # are unaffected; a conforming n = 1e7 still returns normally.
    # [measured: scratch harness, not reproducible in-tree, 2026-09-09; cycc 6.6.2]
    if (n != (n * 8) / 8) { return Err(HSB_ERR_INVALID_INPUT); }

    var x       = alloc(n * 8);
    var g       = alloc(n * 8);
    var d       = alloc(n * 8);
    var g_new   = alloc(n * 8);
    var x_trial = alloc(n * 8);
    var st      = alloc(24);    # _opt_wolfe_search's out: f, the scaled slope, the step

    if (x == 0 || g == 0 || d == 0 || g_new == 0 || x_trial == 0 || st == 0) {
        return Err(HSB_ERR_ALLOC);
    }

    _opt_copy(x, x0, n);

    # Initial gradient and search direction d = -g
    var g_rc = fncall2(grad, x, g);
    var i = 0;
    while (i < n) {
        store64(d + i * 8, f64_neg(load64(g + i * 8)));
        i = i + 1;
    }

    var gg_old = _opt_dot(g, g, n);
    var f_old = fncall1(f, x);
    var a_prev = 0;     # the last step, and its slope d.g at alpha = 0 at scale 2^2 m_prev
    var s_prev = 0;
    var m_prev = 0;

    var iter = 0;
    while (iter < max_iter) {
        # ⛔ 2.17.0 — this read `f64_sqrt(gg_old)`, and `gg_old` is a sum of
        # squares that has already lost the value by the time the sqrt sees it.
        # `g` and `gg_old` are updated together (line above the loop, then
        # `gg_old = gg_new` at the tail), so the sum-aware norm can rescue from
        # the vector itself without recomputing the dot product.
        var gnorm = _opt_norm_ss(g, n, gg_old);
        if (f64_lt(gnorm, tol) == 1) {
            _opt_copy(out_x, x, n);
            store64(out_fmin, f_old);
            return Ok(0);
        }

        # ⛔ 3.4.0 — A DIRECTION THAT DOES NOT DESCEND IS REPLACED BY -g. PR+ with an
        # inexact line search can make d.g >= 0 (the 3.3.7 scale fixture at k = 2^504 did,
        # at iteration 1), and a search along it has no step to find. The slope is taken
        # with d and g at the scale _opt_pair_scale gives their norms (see _opt_wolfe_search).
        var m = _opt_pair_scale(_opt_norm(d, n), gnorm);
        var dg = _opt_cg_slope(d, g, n, m);
        if (f64_lt(dg, 0) == 0) {
            i = 0;
            while (i < n) {
                store64(d + i * 8, f64_neg(load64(g + i * 8)));
                i = i + 1;
            }
            m = _opt_pair_scale(gnorm, gnorm);
            dg = _opt_cg_slope(d, g, n, m);
        }

        # The first trial step: 1 on the first iteration, then the previous step times
        # the ratio of the slopes at alpha = 0 (Nocedal & Wright, eq. 3.60), each slope
        # read at its own scale.
        var a0 = F64_ONE;
        if (iter > 0) { a0 = _opt_cg_first(a_prev, s_prev, m_prev, dg, m); }
        var alpha = _opt_wolfe_search(f, grad, x, d, n, f_old, dg, m, a0, _OPT_CG_SIGMA, x_trial, g_new, st);
        if (load64(st + 16) == 1) {
            # No step met both conditions: take the last one that descends with an
            # acceptable f, or stop, at x, unconverged, when there is none.
            if (f64_gt(alpha, 0) == 0) {
                _opt_copy(out_x, x, n);
                store64(out_fmin, f_old);
                return Err(HSB_ERR_NO_CONVERGENCE);
            }
            _opt_axpy(x_trial, x, alpha, d, n);
            store64(st, fncall1(f, x_trial));
            var gl_rc = fncall2(grad, x_trial, g_new);
        }
        var f_new = load64(st);
        a_prev = alpha;
        s_prev = dg;
        m_prev = m;
        var gg_new = _opt_dot(g_new, g_new, n);

        # Polak-Ribiere+ beta (strictly superior to Fletcher-Reeves)
        # beta = max(0, dot(g_new, g_new - g_old) / dot(g_old, g_old))
        var beta = _OPT_F64_ZERO;
        # ⛔ `gg_old` = ||g_old||² carries the objective's units squared over the
        # variables' squared, so an absolute 1e-12 silently zeroed beta — turning
        # Polak-Ribiere back into steepest descent — for any problem scaled small.
        # The only thing that fails is the division, at a zero denominator.
        # ⛔ 3.3.7 — BETA WAS FORMED AT THE GRADIENTS' OWN SCALE. Its numerator and
        # denominator go as the square of the gradient, so on the BFGS scale fixture
        # (opt_bfgs's 3.3.6 repair) gg_old fell below DBL_MIN near the minimum from
        # k = 2^-486 and beta was 0, a steepest-descent restart every step; from k = 2^496
        # gg_old overflowed to +Inf and beta was -0, the same restart. beta is a ratio,
        # invariant when g_old and g_new are multiplied by the same constant, so the pair
        # (g_old, g_new) is taken at the scale _opt_pair_scale gives their norms, as BFGS
        # takes (s, y); in the band it leaves alone, beta is 3.3.6's bits. Where f(x) is 0
        # the Armijo test ties at every trial and cannot measure a step, and a rescaled beta
        # there compounded the blind unit steps to overflow (out_x NaN from k = 2^-560 down,
        # where 3.3.6 left a finite point; both NO_CONVERGENCE), so a zero f(x) keeps the
        # unscaled beta.
        # [measured: scratch CG variant sweeps (pcgv0-5.cyr, pcgdbg0.cyr), k = 2^-1022..2^504, 2026-10-31]
        # ⭐ 3.4.0 — THE ZERO-f EXCEPTION IS GONE WITH THE STEPS IT GUARDED. _opt_wolfe_search
        # measures a step by the slope, which a zero f does not blind, so beta is formed at
        # the pair's scale whatever f(x) is.
        var pm = _opt_pair_scale(gnorm, _opt_norm_ss(g_new, n, gg_new));
        if (pm == 0) {
            if (f64_lt(F64_TINY, gg_old) == 1) {
                # Compute g_new - g_old dot g_new
                var pr_dot = _OPT_F64_ZERO;
                var bi = 0;
                while (bi < n) {
                    var diff = f64_sub(load64(g_new + bi * 8), load64(g + bi * 8));
                    pr_dot = f64_add(pr_dot, f64_mul(load64(g_new + bi * 8), diff));
                    bi = bi + 1;
                }
                beta = f64_div(pr_dot, gg_old);
                if (f64_lt(beta, _OPT_F64_ZERO) == 1) { beta = _OPT_F64_ZERO; }
            }
        } else {
            var pr_s = _OPT_F64_ZERO;
            var gg_s = _OPT_F64_ZERO;
            var bj = 0;
            while (bj < n) {
                var gn = _opt_pow2(load64(g_new + bj * 8), pm);
                var go = _opt_pow2(load64(g + bj * 8), pm);
                pr_s = f64_add(pr_s, f64_mul(gn, f64_sub(gn, go)));
                gg_s = f64_add(gg_s, f64_mul(go, go));
                bj = bj + 1;
            }
            if (f64_lt(_OPT_F64_ZERO, gg_s) == 1) {
                beta = f64_div(pr_s, gg_s);
                if (f64_lt(beta, _OPT_F64_ZERO) == 1) { beta = _OPT_F64_ZERO; }
            }
        }

        # Update search direction: d = -g_new + beta * d
        i = 0;
        while (i < n) {
            var gnew_i = load64(g_new + i * 8);
            var d_i    = load64(d + i * 8);
            store64(d + i * 8, f64_add(f64_neg(gnew_i), f64_mul(beta, d_i)));
            i = i + 1;
        }

        # Advance
        _opt_copy(x, x_trial, n);
        _opt_copy(g, g_new, n);
        gg_old = gg_new;
        f_old = f_new;

        iter = iter + 1;
    }

    _opt_copy(out_x, x, n);
    store64(out_fmin, f_old);
    return Err(HSB_ERR_NO_CONVERGENCE);
}

# ================================================================
# 3. BFGS (Broyden-Fletcher-Goldfarb-Shanno)
# ================================================================

# BFGS quasi-Newton minimization with Armijo backtracking line search.
# f:        function pointer, fncall1(f, x_ptr) -> f64 value
# grad:     function pointer, fncall2(grad, x_ptr, out_grad) -> writes gradient
# x0:       initial point (flat array of n f64s)
# n:        dimension (integer)
# tol:      convergence tolerance on gradient norm (f64)
# max_iter: maximum iterations (integer)
# out_x:    pointer where optimal x is written (n f64s, caller allocates)
# out_fmin: pointer where minimum f value is written (1 f64, caller allocates)
# Returns:  Ok(0) on success, Err(HSB_ERR_INVALID_INPUT) or Err(HSB_ERR_NO_CONVERGENCE)
#must_use
public fn opt_bfgs(f, grad, x0, n, tol, max_iter, out_x, out_fmin) {
    if (n <= 0) { return Err(HSB_ERR_INVALID_INPUT); }
    # CWE-190/CWE-476: the inverse Hessian is n*n, so an unbounded n both risks
    # wrapping the size expression and drives alloc past ALLOC_MAX. Reject up
    # front rather than storing through the resulting null.
    if (n > _OPT_MAX_DIM) { return Err(HSB_ERR_INVALID_INPUT); }

    var x       = alloc(n * 8);
    var g       = alloc(n * 8);
    var d       = alloc(n * 8);
    var x_new   = alloc(n * 8);
    var g_new   = alloc(n * 8);
    var s       = alloc(n * 8);
    var y       = alloc(n * 8);
    var hy      = alloc(n * 8);

    # Inverse Hessian approximation H_inv stored as flat n*n f64 array (row-major)
    var nn = n * n;
    var h_inv = alloc(nn * 8);

    if (x == 0 || g == 0 || d == 0 || x_new == 0 || g_new == 0 ||
      s == 0 || y == 0 || hy == 0 || h_inv == 0) {
        return Err(HSB_ERR_ALLOC);
    }

    # Initialize H_inv = I
    var idx = 0;
    while (idx < nn) {
        store64(h_inv + idx * 8, _OPT_F64_ZERO);
        idx = idx + 1;
    }
    idx = 0;
    while (idx < n) {
        store64(h_inv + (idx * n + idx) * 8, _OPT_F64_ONE);
        idx = idx + 1;
    }

    _opt_copy(x, x0, n);
    var g_rc = fncall2(grad, x, g);

    var iter = 0;
    while (iter < max_iter) {
        # Check convergence
        var gnorm = _opt_norm(g, n);
        if (f64_lt(gnorm, tol) == 1) {
            _opt_copy(out_x, x, n);
            store64(out_fmin, fncall1(f, x));
            return Ok(0);
        }

        # Search direction: d = -H_inv * g
        var i = 0;
        while (i < n) {
            var sum = _OPT_F64_ZERO;
            var j = 0;
            while (j < n) {
                var hij = load64(h_inv + (i * n + j) * 8);
                var gj  = load64(g + j * 8);
                sum = f64_add(sum, f64_mul(hij, gj));
                j = j + 1;
            }
            store64(d + i * 8, f64_neg(sum));
            i = i + 1;
        }

        # Armijo backtracking line search
        var f_old = fncall1(f, x);
        _opt_armijo(f, x, d, g, n, f_old, x_new);

        # Compute s = x_new - x, and new gradient
        var g_new_rc = fncall2(grad, x_new, g_new);
        i = 0;
        while (i < n) {
            store64(s + i * 8, f64_sub(load64(x_new + i * 8), load64(x + i * 8)));
            store64(y + i * 8, f64_sub(load64(g_new + i * 8), load64(g + i * 8)));
            i = i + 1;
        }

        var sy = _opt_dot(s, y, n);
        var ns = _opt_norm(s, n);
        var ny = _opt_norm(y, n);
        # A pair far from unit scale is rescaled first (_opt_pair_scale); the update below
        # is invariant under it.
        var pm = _opt_pair_scale(ns, ny);
        if (pm != 0) {
            _opt_scale_pow2(s, n, pm);
            _opt_scale_pow2(y, n, pm);
            sy = _opt_dot(s, y, n);
            ns = _opt_norm(s, n);
            ny = _opt_norm(y, n);
        }

        # BFGS update of H_inv (skip if curvature condition fails)
        # ⭐ THE CURVATURE TEST IS A COSINE, SO ASK IT AS ONE. `sy` = s·y has units
        # [f], so an absolute 1e-12 rejected or accepted the same geometry
        # depending on the objective's scale. ⚠ And the obvious repairs are BOTH
        # insufficient, which is measured rather than argued: a bare sign test and
        # a DBL_MIN test both accept a NEAR-ORTHOGONAL pair with sy = 1e-300 at
        # ||s|| = ||y|| = 1 — catastrophic cancellation in the dot product, not
        # smallness of scale — giving rho = 1e300 and a -inf that poisons q and
        # hence x. Only the RATIO sees it.
        # ⭐ sy/(||s||*||y||) is a normalised cosine, bounded in [-1,1] and
        # dimensionless, which is precisely the case error.cyr reserves
        # EPSILON_F64 for. The constant is unchanged; what changes is what it is
        # compared against. [measured: docs/audit/2026-09-09-epsilon-open.json]
        if (f64_lt(f64_mul(EPSILON_F64, f64_mul(ns, ny)), sy) == 1) {
            var rho = f64_div(_OPT_F64_ONE, sy);

            # hy = H_inv * y
            i = 0;
            while (i < n) {
                var sum = _OPT_F64_ZERO;
                var j = 0;
                while (j < n) {
                    var hij = load64(h_inv + (i * n + j) * 8);
                    var yj  = load64(y + j * 8);
                    sum = f64_add(sum, f64_mul(hij, yj));
                    j = j + 1;
                }
                store64(hy + i * 8, sum);
                i = i + 1;
            }

            var yhy = _opt_dot(y, hy, n);

            # H_inv += rho * ((1 + rho*yhy)*s*s^T - hy*s^T - s*hy^T)
            var factor = f64_add(_OPT_F64_ONE, f64_mul(rho, yhy));
            i = 0;
            while (i < n) {
                var si  = load64(s + i * 8);
                var hyi = load64(hy + i * 8);
                var j = 0;
                while (j < n) {
                    var sj  = load64(s + j * 8);
                    var hyj = load64(hy + j * 8);
                    var old = load64(h_inv + (i * n + j) * 8);
                    var upd = f64_mul(rho,
                      f64_sub(
                        f64_mul(factor, f64_mul(si, sj)),
                        f64_add(f64_mul(hyi, sj), f64_mul(si, hyj))
                        )
                      );
                    store64(h_inv + (i * n + j) * 8, f64_add(old, upd));
                    j = j + 1;
                }
                i = i + 1;
            }
        }

        # Advance
        _opt_copy(x, x_new, n);
        _opt_copy(g, g_new, n);

        iter = iter + 1;
    }

    _opt_copy(out_x, x, n);
    store64(out_fmin, fncall1(f, x));
    return Err(HSB_ERR_NO_CONVERGENCE);
}

# ================================================================
# 4. L-BFGS (Limited-memory BFGS)
# ================================================================

# L-BFGS minimization with two-loop recursion and Armijo line search.
# f:        function pointer, fncall1(f, x_ptr) -> f64 value
# grad:     function pointer, fncall2(grad, x_ptr, out_grad) -> writes gradient
# x0:       initial point (flat array of n f64s)
# n:        dimension (integer)
# m:        history size (integer, typically 5-20)
# tol:      convergence tolerance on gradient norm (f64)
# max_iter: maximum iterations (integer)
# out_x:    pointer where optimal x is written (n f64s, caller allocates)
# out_fmin: pointer where minimum f value is written (1 f64, caller allocates)
# Returns:  Ok(0) on success, Err(HSB_ERR_INVALID_INPUT) or Err(HSB_ERR_NO_CONVERGENCE)
#must_use
public fn opt_lbfgs(f, grad, x0, n, m, tol, max_iter, out_x, out_fmin) {
    if (n <= 0) { return Err(HSB_ERR_INVALID_INPUT); }
    if (m <= 0) { return Err(HSB_ERR_INVALID_INPUT); }
    # The history ring is m * (2n+1) f64s, so both dimensions need bounding
    # before the size expression is computed (CWE-190 -> CWE-476).
    if (n > _OPT_MAX_DIM) { return Err(HSB_ERR_INVALID_INPUT); }
    if (m > _OPT_MAX_DIM) { return Err(HSB_ERR_INVALID_INPUT); }

    var x       = alloc(n * 8);
    var g       = alloc(n * 8);
    var q       = alloc(n * 8);
    var x_new   = alloc(n * 8);

    # History ring buffer: m slots, each with s[n], y[n], rho
    # Layout per slot: n f64 (s) + n f64 (y) + 1 f64 (rho) = (2n+1)*8 bytes
    var slot_size = (2 * n + 1) * 8;
    var hist = alloc(m * slot_size);
    var alpha_buf = alloc(m * 8);

    # Loop-invariant scratch, hoisted. These three were allocated on EVERY
    # iteration through 2.6.14 and were dead by the end of it — g_new_buf is
    # copied into g, and s_k/y_k are copied into the history ring. Under the
    # never-freeing bump allocator that is 3*n*8 bytes leaked per iteration.
    var g_new_buf = alloc(n * 8);
    var s_k = alloc(n * 8);
    var y_k = alloc(n * 8);

    if (x == 0 || g == 0 || q == 0 || x_new == 0 || hist == 0 || alpha_buf == 0 ||
      g_new_buf == 0 || s_k == 0 || y_k == 0) {
        return Err(HSB_ERR_ALLOC);
    }

    # k = number of stored pairs (0..m), head = next write index
    var k    = 0;
    var head = 0;

    _opt_copy(x, x0, n);
    var g_rc = fncall2(grad, x, g);
    var f_old = fncall1(f, x);
    var st = alloc(24);    # _opt_wolfe_search's out
    if (st == 0) { return Err(HSB_ERR_ALLOC); }

    var iter = 0;
    while (iter < max_iter) {
        var gnorm = _opt_norm(g, n);
        if (f64_lt(gnorm, tol) == 1) {
            _opt_copy(out_x, x, n);
            store64(out_fmin, f_old);
            return Ok(0);
        }

        # --- Two-loop recursion ---
        # q = g (copy)
        _opt_copy(q, g, n);

        # First loop: newest to oldest
        var loop_i = k - 1;
        while (loop_i >= 0) {
            # Map loop_i to ring index: (head - 1 - loop_i + m) % m
            # But we stored oldest first. Let's use: ring index of i-th newest
            # newest is at (head - 1 + m) % m, second newest at (head - 2 + m) % m, etc.
            # i-th from newest (loop_i=0 is newest, loop_i=k-1 is oldest) would be wrong.
            # We want newest to oldest: j = k-1 downto 0 maps to ring[(head-1-j+m)%m]
            # But loop_i goes from k-1 downto 0, and we want newest first.
            # Reindex: newest first means idx = k - 1 - loop_i reversed.
            # Actually: loop_i = k-1 is first iteration. We want it to be newest.
            # ring index of newest = (head - 1 + m) % m
            # ring index of j-th newest (j=0 newest) = (head - 1 - j + m) % m
            # j-th newest where j = k - 1 - loop_i
            var j_newest = k - 1 - loop_i;
            var ring_idx = (head - 1 - j_newest + m * 2) % m;  # +m*2 ensures positive
            var slot_base = hist + ring_idx * slot_size;
            var s_ptr = slot_base;
            var y_ptr = slot_base + n * 8;
            var rho_i = load64(slot_base + 2 * n * 8);

            var sq = _opt_dot(s_ptr, q, n);
            var ai = f64_mul(rho_i, sq);
            store64(alpha_buf + j_newest * 8, ai);

            # q = q - ai * y
            var vi = 0;
            while (vi < n) {
                var qv = load64(q + vi * 8);
                var yv = load64(y_ptr + vi * 8);
                store64(q + vi * 8, f64_sub(qv, f64_mul(ai, yv)));
                vi = vi + 1;
            }

            loop_i = loop_i - 1;
        }

        # Scale q by gamma = s_k . y_k / (y_k . y_k) using most recent pair
        if (k > 0) {
            var newest_ring = (head - 1 + m * 2) % m;
            var newest_base = hist + newest_ring * slot_size;
            var s_newest = newest_base;
            var y_newest = newest_base + n * 8;
            var yy = _opt_dot(y_newest, y_newest, n);
            # ⛔ The guard tested `yy` while the DIVISION is by `rho_newest * yy`,
            # so it was guarding the wrong quantity as well as at the wrong scale.
            # Test what is actually divided.
            var rho_newest = load64(newest_base + 2 * n * 8);
            var gden = f64_mul(rho_newest, yy);
            if (f64_lt(F64_TINY, gden) == 1) {
                var gamma = f64_div(_OPT_F64_ONE, gden);
                var vi = 0;
                while (vi < n) {
                    var qv = load64(q + vi * 8);
                    store64(q + vi * 8, f64_mul(qv, gamma));
                    vi = vi + 1;
                }
            }
        }

        # Second loop: oldest to newest
        var loop_j = 0;
        while (loop_j < k) {
            # j_newest = loop_j means j-th from newest (0 = newest)
            # But this loop goes oldest to newest, so j_oldest = loop_j
            # oldest is j_newest = k-1, so j_newest = k - 1 - loop_j
            var j_new2 = k - 1 - loop_j;
            var ring_idx2 = (head - 1 - j_new2 + m * 2) % m;
            var slot_base2 = hist + ring_idx2 * slot_size;
            var y_ptr2 = slot_base2 + n * 8;
            var rho_j = load64(slot_base2 + 2 * n * 8);

            var yq = _opt_dot(y_ptr2, q, n);
            var beta_j = f64_mul(rho_j, yq);

            var aj = load64(alpha_buf + j_new2 * 8);
            var diff = f64_sub(aj, beta_j);
            var s_ptr2 = slot_base2;

            var vi = 0;
            while (vi < n) {
                var qv = load64(q + vi * 8);
                var sv = load64(s_ptr2 + vi * 8);
                store64(q + vi * 8, f64_add(qv, f64_mul(diff, sv)));
                vi = vi + 1;
            }

            loop_j = loop_j + 1;
        }

        # d = -q (search direction, stored back in q for reuse)
        var vi = 0;
        while (vi < n) {
            store64(q + vi * 8, f64_neg(load64(q + vi * 8)));
            vi = vi + 1;
        }

        # ⛔ 3.4.0 — THE ARMIJO BACKTRACK COULD NOT MEASURE A STEP NEAR THE MINIMUM (the D102
        # audit, F-O1). Where f(x) - f* is below ulp(f), the decrease c1 alpha g.d rounds away
        # and a step to a value one rounding above f(x) is refused: on f = sum (i+1)(x_i - 1)^2
        # + x0 x1 from (3, -2, 5), tol 1e-9 (minimiser (4/7, 6/7, 1)), x stopped moving after
        # 50 iterations at |g| = 1.6e-9, and 30,000 iterations spent 779,740 values of f to
        # return NO_CONVERGENCE. The step is now found by _opt_wolfe_search on the slope, with a
        # quasi-Newton step's curvature constant 0.9 and the unit step tried first, which also
        # computes the new gradient; a direction that does not descend (rounding in the
        # two-loop recursion) restarts from -g with the history cleared. It takes 11 gradients
        # and 12 values of f there; Rosenbrock from (-1.2, 1), m = 7, tol 1e-8 takes 46 and 56
        # (3.3.7: 674 gradients and 1,375 values of f), the 1e5-conditioned quadratic 10 and 16
        # (3.3.7: 6 and 28), and a saddle start (modules_c, D031) 41 and 55 (3.3.7: 32 and 68).
        # (3.4.0's first form, a gradient at every trial: 12, 77, 9 and 84 of each.)
        # [measured: scratch probes (NU1-work/p/pq3.cyr, plb.cyr), 3.3.7, integ-snap5 and this tree, 2026-10-31]
        var lm = _opt_pair_scale(_opt_norm(q, n), gnorm);
        var ldg = _opt_cg_slope(q, g, n, lm);
        if (f64_lt(ldg, 0) == 0) {
            vi = 0;
            while (vi < n) {
                store64(q + vi * 8, f64_neg(load64(g + vi * 8)));
                vi = vi + 1;
            }
            k = 0;
            head = 0;
            lm = _opt_pair_scale(gnorm, gnorm);
            ldg = _opt_cg_slope(q, g, n, lm);
        }
        var lalpha = _opt_wolfe_search(f, grad, x, q, n, f_old, ldg, lm, _OPT_F64_ONE, _OPT_QN_SIGMA, x_new, g_new_buf,
          st);
        if (load64(st + 16) == 1) {
            # No step met both conditions: take the last one that descends with an acceptable
            # f, or stop, at x, unconverged, when there is none.
            if (f64_gt(lalpha, 0) == 0) {
                _opt_copy(out_x, x, n);
                store64(out_fmin, f_old);
                return Err(HSB_ERR_NO_CONVERGENCE);
            }
            _opt_axpy(x_new, x, lalpha, q, n);
            store64(st, fncall1(f, x_new));
            var gl_rc = fncall2(grad, x_new, g_new_buf);
        }
        f_old = load64(st);

        # Store correction pair in ring buffer (s_k / y_k are hoisted)
        vi = 0;
        while (vi < n) {
            store64(s_k + vi * 8, f64_sub(load64(x_new + vi * 8), load64(x + vi * 8)));
            store64(y_k + vi * 8, f64_sub(load64(g_new_buf + vi * 8), load64(g + vi * 8)));
            vi = vi + 1;
        }

        var sy = _opt_dot(s_k, y_k, n);
        var ns = _opt_norm(s_k, n);
        var ny = _opt_norm(y_k, n);
        # A pair far from unit scale is stored rescaled (_opt_pair_scale); the two-loop
        # recursion is invariant under it, pair by pair.
        var pm = _opt_pair_scale(ns, ny);
        if (pm != 0) {
            _opt_scale_pow2(s_k, n, pm);
            _opt_scale_pow2(y_k, n, pm);
            sy = _opt_dot(s_k, y_k, n);
            ns = _opt_norm(s_k, n);
            ny = _opt_norm(y_k, n);
        }

        # ⭐ THE CURVATURE TEST IS A COSINE, SO ASK IT AS ONE. `sy` = s·y has units
        # [f], so an absolute 1e-12 rejected or accepted the same geometry
        # depending on the objective's scale. ⚠ And the obvious repairs are BOTH
        # insufficient, which is measured rather than argued: a bare sign test and
        # a DBL_MIN test both accept a NEAR-ORTHOGONAL pair with sy = 1e-300 at
        # ||s|| = ||y|| = 1 — catastrophic cancellation in the dot product, not
        # smallness of scale — giving rho = 1e300 and a -inf that poisons q and
        # hence x. Only the RATIO sees it.
        # ⭐ sy/(||s||*||y||) is a normalised cosine, bounded in [-1,1] and
        # dimensionless, which is precisely the case error.cyr reserves
        # EPSILON_F64 for. The constant is unchanged; what changes is what it is
        # compared against. [measured: docs/audit/2026-09-09-epsilon-open.json]
        if (f64_lt(f64_mul(EPSILON_F64, f64_mul(ns, ny)), sy) == 1) {
            var slot_wr = hist + head * slot_size;
            _opt_copy(slot_wr, s_k, n);
            _opt_copy(slot_wr + n * 8, y_k, n);
            store64(slot_wr + 2 * n * 8, f64_div(_OPT_F64_ONE, sy));
            head = (head + 1) % m;
            if (k < m) { k = k + 1; }
        }

        # Advance
        _opt_copy(x, x_new, n);
        _opt_copy(g, g_new_buf, n);

        iter = iter + 1;
    }

    _opt_copy(out_x, x, n);
    store64(out_fmin, f_old);
    return Err(HSB_ERR_NO_CONVERGENCE);
}

# ================================================================
# 5. LEVENBERG-MARQUARDT (nonlinear least squares)
# ================================================================

# Levenberg-Marquardt solver for minimizing sum(r_i(x)^2).
# residuals: fncall1(fp, x_ptr) -> pointer to flat array of n_residuals f64s. The
#            vector is copied before the next call, so the buffer may be reused.
# jacobian:  fncall2(fp, x_ptr, out_J) -> writes n_residuals*n_params f64s (row-major)
# x0:        initial parameters (flat array of n_params f64s)
# n_params:  number of parameters (integer)
# n_residuals: number of residuals (integer)
# tol:       convergence tolerance on residual norm (f64)
# max_iter:  maximum iterations (integer)
# out_x:     pointer where optimal parameters are written (n_params f64s, caller allocates)
# Returns:   Ok(0) on success, Err(HSB_ERR_INVALID_INPUT) or Err(HSB_ERR_NO_CONVERGENCE)
#must_use
public fn opt_levenberg_marquardt(residuals, jacobian, x0, n_params, n_residuals, tol, max_iter, out_x) {
    if (n_params <= 0) { return Err(HSB_ERR_INVALID_INPUT); }
    if (n_residuals <= 0) { return Err(HSB_ERR_INVALID_INPUT); }

    var np = n_params;
    var nr = n_residuals;

    # ⛔ CWE-190 -- the 2.12.0 opt_conjugate_gradient shape, missed here until 3.3.1.
    # `nr * np * 8` sizes j_buf and nothing round-tripped it. n_params = 2 with
    # n_residuals = 2^60+1 wraps it to 16, `alloc` honours 16 bytes, and the solver
    # proceeds as if it held nr*np f64s: exit 139.
    # [measured: scratch harness, not reproducible in-tree, 2026-09-30; cycc 6.6.12]
    # The round-trip tests the multiply this function performs. It reports
    # HSB_ERR_ALLOC, the code the NON-positive wrap (2^30 x 2^30) and a merely
    # too-large product already got from the null check below, so both directions
    # of the wrap read alike and no conforming caller is refused.
    var nrp = nr * np;
    if (nrp / np != nr || nrp != (nrp * 8) / 8) { return Err(HSB_ERR_ALLOC); }

    var x       = alloc(np * 8);
    var x_trial = alloc(np * 8);
    var jtr     = alloc(np * 8);
    var delta   = alloc(np * 8);
    var j_buf   = alloc(nr * np * 8);  # Jacobian buffer (row-major: nr rows x np cols)

    # Loop-invariant scratch, hoisted out of the iteration loop. These four were
    # allocated per iteration through 2.6.14 while `j_buf` above was already
    # hoisted — the audit measured 5.35 MB of unreclaimed bump scratch over 200
    # iterations. Every one is fully overwritten at the top of each iteration
    # (jtj by the JtJ fill, rhs by the negation loop, lu/piv by ganita_mat_lu), so
    # reusing them is safe; in particular the `+lambda` added to jtj's diagonal
    # cannot accumulate because the fill rewrites every element first.
    # [measured: docs/audit/2026-08-03.md, the src/optimize.cyr:628 Levenberg-Marquardt performance row]
    var jtj = ganita_mat_new(np, np);
    var lu  = ganita_mat_new(np, np);
    var rhs = alloc(np * 8);
    var piv = alloc(np * 8);

    # ⛔ 3.3.4 — `r_ptr` WAS THE CALLER'S BUFFER, KEPT ACROSS THE TRIAL EVALUATION. It is
    # read again at the top of the next iteration to build J^T r, so a `residuals` that
    # reused one output buffer handed back the residuals of the trial point, rejected or
    # not, where the accepted point's belonged. Nothing was reported: Rosenbrock as least
    # squares from (-1.2, 1), tol 1e-8, took 144 residual calls with a reused buffer and
    # 51 with fresh ones, and stopped at a different x. (3.3.3 removed the same contract
    # from GMRES and BiCGSTAB, D017.) Both residual vectors are now copied into these two,
    # allocated once per call, and an accepted step swaps them, so a reused buffer gives
    # the fresh-buffer run bit for bit. nr * 8 cannot wrap: nr * np * 8 round-tripped above.
    # [measured: krylov LM probe, 3.3.4 tree before and after, cycc 6.6.14, 2026-10-03]
    var r_ptr = alloc(nr * 8);
    var r_try = alloc(nr * 8);

    if (x == 0 || x_trial == 0 || jtr == 0 || delta == 0 || j_buf == 0 ||
      jtj == 0 || lu == 0 || rhs == 0 || piv == 0 || r_ptr == 0 || r_try == 0) {
        return Err(HSB_ERR_ALLOC);
    }

    _opt_copy(x, x0, np);

    # Evaluate initial residuals and cost
    _opt_copy(r_ptr, fncall1(residuals, x), nr);
    var cost = _opt_dot(r_ptr, r_ptr, nr);

    # Initial damping parameter
    var lambda = f64_div(f64_from(1), f64_from(1000));  # 1e-3
    var lambda_up   = f64_from(10);
    var lambda_down = f64_div(_OPT_F64_ONE, f64_from(10));  # 0.1

    var iter = 0;
    while (iter < max_iter) {
        # ⛔ 2.17.0 — same defect, and here it fires BEFORE the Jacobian is ever
        # evaluated: `cost` is the sum of squared residuals, so a residual set
        # whose largest member is below 2^-538 gives cost = 0 and this returns
        # success at the initial point. `r_ptr` and `cost` move together (both
        # are updated on step acceptance and neither on rejection), so the
        # sum-aware norm always sees a consistent pair.
        # Check convergence: ||r|| < tol
        if (f64_lt(_opt_norm_ss(r_ptr, nr, cost), tol) == 1) {
            _opt_copy(out_x, x, np);
            return Ok(0);
        }

        # Evaluate Jacobian
        var j_rc = fncall2(jacobian, x, j_buf);

        # Compute J^T * J (np x np) and J^T * r (np x 1) into the hoisted jtj.
        var pi = 0;
        while (pi < np) {
            # jtr[pi] = sum_k J[k][pi] * r[k]
            var sum_r = _OPT_F64_ZERO;
            var kk = 0;
            while (kk < nr) {
                var j_kpi = load64(j_buf + (kk * np + pi) * 8);
                var r_kk  = load64(r_ptr + kk * 8);
                sum_r = f64_add(sum_r, f64_mul(j_kpi, r_kk));
                kk = kk + 1;
            }
            store64(jtr + pi * 8, sum_r);

            # jtj[pi][pj] = sum_k J[k][pi] * J[k][pj].
            # J^T J is symmetric by construction, so only the upper triangle is
            # accumulated and the transpose is mirrored. Through 2.6.14 the loop
            # started at pj = 0 and recomputed every off-diagonal dot product
            # twice. The mirrored value is bit-identical, not merely equal: the
            # k-accumulation order is the same and f64_mul is commutative.
            var pj = pi;
            while (pj < np) {
                var sum_jj = _OPT_F64_ZERO;
                kk = 0;
                while (kk < nr) {
                    var j_kpi2 = load64(j_buf + (kk * np + pi) * 8);
                    var j_kpj  = load64(j_buf + (kk * np + pj) * 8);
                    sum_jj = f64_add(sum_jj, f64_mul(j_kpi2, j_kpj));
                    kk = kk + 1;
                }
                ganita_mat_set(jtj, pi, pj, sum_jj);
                if (pj != pi) { ganita_mat_set(jtj, pj, pi, sum_jj); }
                pj = pj + 1;
            }
            pi = pi + 1;
        }

        # Damped normal equations: (J^T J + lambda * I) delta = -J^T r
        # Add lambda to diagonal
        pi = 0;
        while (pi < np) {
            var diag = ganita_mat_get(jtj, pi, pi);
            ganita_mat_set(jtj, pi, pi, f64_add(diag, lambda));
            pi = pi + 1;
        }

        # Negate jtr for RHS: b = -J^T r  (rhs is hoisted)
        pi = 0;
        while (pi < np) {
            store64(rhs + pi * 8, f64_neg(load64(jtr + pi * 8)));
            pi = pi + 1;
        }

        # Solve via LU decomposition (lu / piv are hoisted)
        var sign = ganita_mat_lu(jtj, lu, piv);

        if (sign == 0) {
            # Singular -- increase damping and retry
            lambda = f64_mul(lambda, lambda_up);
            iter = iter + 1;
            continue;
        }

        ganita_mat_lu_solve(lu, piv, rhs, delta);

        # Trial step: x_trial = x + delta
        _opt_axpy(x_trial, x, _OPT_F64_ONE, delta, np);

        _opt_copy(r_try, fncall1(residuals, x_trial), nr);
        var cost_trial = _opt_dot(r_try, r_try, nr);

        if (f64_lt(cost_trial, cost) == 1) {
            # Accept step: r_try holds the accepted residuals, so the buffers swap.
            _opt_copy(x, x_trial, np);
            var r_sw = r_ptr;
            r_ptr = r_try;
            r_try = r_sw;
            cost = cost_trial;
            lambda = f64_mul(lambda, lambda_down);
        } else {
            # Reject step -- increase damping
            lambda = f64_mul(lambda, lambda_up);
        }

        iter = iter + 1;
    }

    _opt_copy(out_x, x, np);
    return Err(HSB_ERR_NO_CONVERGENCE);
}
