# quat.cyr -- quaternion type for 3D rotations
# Usage: shipped inside dist/hisab.cyr; in-tree, include "src/quat.cyr" after what it requires
# Requires: src/error.cyr, src/vec3.cyr (stdlib resolves via cyrius.cyml [deps])
#
# Heap-allocated: { x: f64, y: f64, z: f64, w: f64 } = 32 bytes
# Convention: w is the scalar part, (x, y, z) is the vector part.

# No module-local threshold. From 2.11.1 a `_QUAT_F64_TINY` (DBL_MIN: a literal through
# 2.13.0, an alias of error.cyr's F64_TINY from 2.14.0) stood here, and `hquat_normalize`
# (on |q|) and `hquat_inverse` (on |q|²) returned the identity below it; 2.17.0 removed
# it. From 2.17.0 to 3.3.3 `hquat_normalize` returned the identity wherever 1/|q|
# overflows (|q| = 0, or |q| <= 2^-1024); since 3.3.4 only at |q| = 0. `hquat_length`,
# `hquat_normalize` (since 3.3.5) and `hquat_inverse` use F64_TINY directly, to choose
# between their direct and rescaled paths (`hquat_inverse` still returns the identity at
# |q| = 0).

#derive(accessors)
public struct HQuat { x; y; z; w; }

#must_use
public fn hquat_new(x, y, z, w) {
    var q = alloc(sizeof(HQuat));
    HQuat_set_x(q, x);
    HQuat_set_y(q, y);
    HQuat_set_z(q, z);
    HQuat_set_w(q, w);
    return q;
}

#must_use
public fn hquat_identity() { return hquat_new(0, 0, 0, F64_ONE); }

#must_use
public fn hquat_from_axis_angle(axis, angle) {
    var half = f64_mul(angle, F64_HALF);
    var s = f64_sin(half);
    var c = f64_cos(half);
    return hquat_new(f64_mul(HVec3_x(axis), s),
      f64_mul(HVec3_y(axis), s),
      f64_mul(HVec3_z(axis), s), c);
}

#must_use
public fn hquat_from_rotation_x(angle) {
    var half = f64_mul(angle, F64_HALF);
    return hquat_new(f64_sin(half), 0, 0, f64_cos(half));
}

#must_use
public fn hquat_from_rotation_y(angle) {
    var half = f64_mul(angle, F64_HALF);
    return hquat_new(0, f64_sin(half), 0, f64_cos(half));
}

#must_use
public fn hquat_from_rotation_z(angle) {
    var half = f64_mul(angle, F64_HALF);
    return hquat_new(0, 0, f64_sin(half), f64_cos(half));
}

# ================================================================
# Arithmetic -- Hamilton product: q * r
# ================================================================

#must_use
public fn hquat_mul(q, r) {
    var qx = HQuat_x(q); var qy = HQuat_y(q); var qz = HQuat_z(q); var qw = HQuat_w(q);
    var rx = HQuat_x(r); var ry = HQuat_y(r); var rz = HQuat_z(r); var rw = HQuat_w(r);
    return hquat_new(
      f64_add(f64_add(f64_mul(qw, rx), f64_mul(qx, rw)),
        f64_sub(f64_mul(qy, rz), f64_mul(qz, ry))),
      f64_add(f64_add(f64_mul(qw, ry), f64_mul(qy, rw)),
        f64_sub(f64_mul(qz, rx), f64_mul(qx, rz))),
      f64_add(f64_add(f64_mul(qw, rz), f64_mul(qz, rw)),
        f64_sub(f64_mul(qx, ry), f64_mul(qy, rx))),
      f64_sub(f64_mul(qw, rw),
        f64_add(f64_add(f64_mul(qx, rx), f64_mul(qy, ry)), f64_mul(qz, rz)))
      );
}

#must_use
public fn hquat_conjugate(q) {
    return hquat_new(f64_neg(HQuat_x(q)), f64_neg(HQuat_y(q)),
      f64_neg(HQuat_z(q)), HQuat_w(q));
}

# SIMD: quat is 4 contiguous f64 (32 bytes), packed dot at n=4 (no over-read).
#must_use
public fn hquat_dot(a, b) {
    return f64v_dot(a, b, 4);
}

#must_use
public fn hquat_length_sq(q) { return hquat_dot(q, q); }
#must_use
fn _hquat_len_scaled(q) {
    var x = HQuat_x(q); var y = HQuat_y(q); var z = HQuat_z(q); var w = HQuat_w(q);
    var mx = f64_max(f64_max(f64_abs(x), f64_abs(y)), f64_max(f64_abs(z), f64_abs(w)));
    # ⚠ 3.3.3 — NaN never reaches here; see `_hvec3_len_scaled`. Called directly, this
    # max drops a NaN in x, y or z and the exit returns 0; `hquat_length` routes a NaN
    # to its sqrt(NaN) fast path instead, and tests/abuse.tcyr pins that per slot.
    # [measured: scratch harness, not reproducible in-tree, 2026-10-01; cycc 6.6.12]
    if (f64_gt(mx, 0) == 0) { return mx; }
    # ⚠ Inf/Inf is NaN, so the infinity contract needs its own exit here.
    if (f64_eq(mx, F64_POS_INF) == 1) { return mx; }
    var xs = f64_div(x, mx); var ys = f64_div(y, mx);
    var zs = f64_div(z, mx); var ws = f64_div(w, mx);
    var acc = f64_add(f64_mul(xs, xs), f64_mul(ys, ys));
    acc = f64_add(acc, f64_add(f64_mul(zs, zs), f64_mul(ws, ws)));
    return f64_mul(mx, f64_sqrt(acc));
}

# ⛔ 2.17.0 — same class as `hvec3_length`: squaring before summing loses 537
# binades below and 512 above, and is silently wrong in the subnormal band
# between. ⚠ This one matters beyond its own module: `hquat_normalize` and
# `hquat_inverse` are what 2.11.1 repaired for returning a fabricated IDENTITY —
# the guard was fixed then, the norm was not.
# ⛔ AND AN EARLIER DRAFT OF THIS VERY COMMENT SAID BOTH OF THEM "route through
# it", WHICH WAS FALSE FOR `hquat_inverse` — it reads `hquat_length_sq` directly
# and so kept the whole defect, 1018 of 2041 binades, 507 of them the fabricated
# identity this file has now claimed to have fixed twice. A comment asserting a
# call graph is a claim like any other and this one was never checked.
# [measured: 2041-binade two-sided sweep on q*q^-1, 2026-09-10]
public fn hquat_length(q) {
    var ls = hquat_length_sq(q);
    if (f64_lt(ls, F64_TINY) == 1) { return _hquat_len_scaled(q); }
    if (f64_eq(ls, F64_POS_INF) == 1) { return _hquat_len_scaled(q); }
    return f64_sqrt(ls);
}

# q * s normalised, for an exact power of two s: `hquat_normalize`'s two ends (3.3.4).
fn _hquat_scaled_unit(q, s) {
    var t = alloc(sizeof(HQuat));
    f64v_scale(t, q, s, 4);
    var r = alloc(sizeof(HQuat));
    f64v_scale(r, t, f64_div(F64_ONE, hquat_length(t)), 4);
    return r;
}

#must_use
# 2.11.1: threshold was EPSILON_F64 (1e-12), which fabricated the identity for
# any quaternion shorter than that even though the division is well-defined far
# below it. `len` is unsquared so the units were at least right -- unlike
# hquat_inverse below, which was out by the square.
# ⛔ 2.17.0 — AND THE THRESHOLD WAS STILL WRONG AFTER 2.11.1, in the direction
# `src/error.cyr` already names out loud: DBL_MIN is one binade too strict for a
# RECIPROCAL, because `1 / 2^-1023` is finite. That was harmless while the norm
# itself flushed at 2^-537 — the band was unreachable — and repairing
# `hquat_length` above made it reachable, so this guard began fabricating the
# identity for a quaternion that normalises perfectly well.
# ⚠ Measured: **48 of 48** subnormal magnitudes returned the identity here while
# the already-repaired `hvec3_normalize` returned the unit vector for the same
# input. ⭐ The vec family was moved onto the reciprocal-overflow test in 2.14.0;
# this one was not, and repairing the norm without repairing the guard is a NET
# REGRESSION over those 52 binades.
# ⚠ `f64_eq(|inv|, +Inf)` and not the tempting `f64_lt(|inv|, +Inf) == 0`: the
# latter is false for NaN too, and this API's contract is NaN in, NaN out.
# [measured: 48-binade subnormal sweep against the vec3 control, 2026-09-10]
# ⛔ 3.3.4 — AND THE TWO THEN AGREED ON THE WRONG ANSWER: both returned their fallback,
# here the IDENTITY, for 47 of those 48 magnitudes, every non-zero |q| <= 2^-1024. A
# finite quaternion whose norm passes DBL_MAX came back as the ZERO quaternion
# (inv = 1/Inf = 0), which is not a unit at all. Audit D087.
# [measured: scratch harness and Decimal oracle, not reproducible in-tree, 2026-10-03; cycc 6.6.14]
# ⭐ The `hvec3_normalize` repair: normalise an exactly scaled copy, by 2^1023 where
# 1/|q| overflows and by 2^-600 where it is 0, and return that copy's bits. `|q| = 0`
# keeps the documented identity (an error channel is [3.4.0] work); NaN runs the last lines.
# ⛔ 3.3.5 — and, as there, the two bands beside those ends still carried a subnormal
# rounding: |q| in (2^-1024, 2^-1022), where |q| itself is subnormal, and |q| in (2^1022,
# DBL_MAX], where 1/|q| is. Up to 4.65 and 5.23 ulp on 3,000 random quaternions per band,
# against 2.04 for the same directions at unit length. The copies now start at |q| < DBL_MIN
# and 1/|q| < DBL_MIN: the low band's sample maximum falls to 2.07 (a reviewer's
# independent sample found 2.51; neither is a bound), and the high band is the
# unit-length answer bit for bit (3,000 of 3,000). 139 and 222 inputs that were within 1 ulp
# now carry their direction's unit-length error instead.
# [measured: scratch harness and Decimal oracle, not reproducible in-tree, 2026-10-11; 2.51: the review's sample]
public fn hquat_normalize(q) {
    var len = hquat_length(q);
    if (f64_lt(len, F64_TINY) == 1) {
        if (f64_eq(len, 0) == 1) { return hquat_identity(); }
        return _hquat_scaled_unit(q, (1023 + 1023) << 52);   # 2^1023
    }
    var inv = f64_div(F64_ONE, len);
    if (f64_lt(inv, F64_TINY) == 1) { return _hquat_scaled_unit(q, (1023 - 600) << 52); }   # 2^-600
    var r = alloc(sizeof(HQuat));
    f64v_scale(r, q, inv, 4);
    return r;
}

#must_use
# 2.11.1: `len_sq` is a SQUARED magnitude and was compared against the UNSQUARED
# EPSILON_F64, so the effective threshold was |q| < 1e-6 -- six orders of
# magnitude coarser than intended, and the seventh instance of a class first
# recorded in complex.cyr in 2.6.14.
#
# It did not return a wrong number, it returned the IDENTITY: measured, q*q^-1
# stopped equalling the identity at |q| ~ 1e-7, where the error jumps from 0 to
# 1.0 because the "inverse" is the identity and q is nearly zero. A quaternion of
# magnitude 1.4e-7 has an inverse of magnitude 7e6 -- finite, representable, and
# silently replaced by a rotation of zero.
# [measured: tests/foundation.tcyr "2.11.1 quat: inverse and normalize are scale-covariant"]
# ⛔ 2.17.0 — THIS IS THE SITE THE RELEASE MISSED ON ITS FIRST PASS. It reads
# `hquat_length_sq` DIRECTLY, so repairing `hquat_length` above did nothing for
# it: measured, **1018 of 2041 binades wrong**, and **507 of them returned the
# fabricated IDENTITY** — the exact failure the 2.11.1 note below says it fixed.
# 2.11.1 moved the threshold from 1e-6 to DBL_MIN; the fabrication simply moved
# with it, to |q| ~ 1.5e-155. At the other end `|q|² = +Inf` made `inv` 0 and the
# inverse came back as the ZERO quaternion. ⚠ It surfaced from a regression sweep
# asking "what did the repair miss", not from the census — the census listed the
# module as done. [measured: 2041-binade two-sided sweep on q*q^-1, 2026-09-10]
#
# ⭐ FAST PATH, AND THE FAST PATH IS THE SHIPPED ARITHMETIC UNCHANGED. `1/|q|²` is
# ONE rounding; the rescue below divides twice and pays two. Measured against
# exact rational truth over 180 components of 45 ordinary quaternions: the direct
# form is mean 0.309 ulp / worst 1.101, the two-division form mean 0.655 / worst
# 2.115 — **2.12x the error**, and the two disagree on 97 of the 180. So the
# direct form is kept wherever it is exact and the rescue runs only where the
# direct form would otherwise fabricate.
# ⚠ Replacing the whole function with the two-division form would therefore be a
# precision REGRESSION on every ordinary quaternion, which is why this is a fast
# path and not a rewrite.
# [measured: scratch harness, exact Fraction truth vs both f64 pipelines, 2026-09-10]
# ⚠ The fast-path test needs BOTH ends: `ls` subnormal or +Inf means the sum of
# squares lost the value on the way in, and `1/ls` subnormal means the reciprocal
# lost it on the way back — a fixture that only goes down would have missed the
# second, which fails at 2^509 alone.
# ⚠ NaN satisfies neither test, so it takes the fast path and propagates, which
# is what `tests/abuse.tcyr` pins for this family.
#
# ⭐ THE RESCUE DIVIDES TWICE BY |q| AND NEVER ONCE BY |q|². A quaternion at
# 2^-600 has an inverse at 2^600 — perfectly representable — but |q|² is not, so
# the squared form cannot get there by any threshold. ⚠ And it must be `f64_div`,
# not a multiply by `1/|q|`: for a subnormal |q| the reciprocal is +Inf and the
# zero components would come back as `0 * Inf` = NaN, the rule
# `src/linalg_precision.cyr:78` states verbatim.
#
# ⛔ 3.3.5 — AND THAT RESCUE PAID FOR ITS ROUNDINGS. Two divisions by a rounded |q| (a
# subnormal one below 2^-1022) put full-mantissa quaternions up to 4.58 ulp off in the
# rescued bands and 48.8 ulp off for a subnormal |q|, where the fast path stays within
# 2.75; and past DBL_MAX |q| was +Inf, so the inverse came back as the zero quaternion.
# The 2041-binade sweep in tests/foundation.tcyr could not see any of it: its (3s, 4s,
# 0, 0) has |q| = 5s exactly, and both forms give the same bits there.
# [measured: scratch harness and Fraction oracle, not reproducible in-tree, 2026-10-11; cycc 6.6.14]
# ⭐ The rescue is now the fast path on an exact copy of the conjugate: t = (-x, -y, -z, w) *
# 2^p, with p from the largest component's exponent so that component is in [1, 2) (or
# [2^-51, 1) when subnormal), then t / |t|^2 * 2^p, both scalings as two normal powers of
# two. That is the fast path's answer for the same direction at unit scale, bit for bit
# wherever the result is normal, and the top band's zero quaternion becomes the inverse. On
# a 14,629-quaternion sample (8,392 random full-mantissa ones, 4 per binade from 2^-1074
# to 2^1023, plus the axis and (3s, 4s) shapes) the largest errors were 2.35 and 2.48 ulp in
# the rescued bands and 1.36 for a subnormal |q| — sample maxima, not bounds: a reviewer's
# independent sample found 2.67 for a subnormal |q|. A zero component stays zero (0 * 2^p
# is 0, never 0 * Inf), and an overflowing inverse still overflows honestly to +-Inf.
# ⚠ Not every rescued answer improved: of 7,472, 452 that were within 1 ulp now are not and
# 1,894 went the other way; each now carries the error the fast path makes on the same
# quaternion at unit scale. 32 of the 452 are single-component q, where the two divisions
# had been exact to half an ulp and the fast path rounds three times (now within 1.57).
# [measured: scratch harness and Fraction oracle, not reproducible in-tree, 2026-10-11; 2.67: the review's sample]
# ⚠ THE NEGATION GOES ON BEFORE THE SCALING. Below cycc 6.6.8 `f64_neg(+0)` is +0, and a
# component far below the largest flushes to zero in the copy; negated after it, that zero
# came back +0 where -x is -0. The first draft did that: on 30,562 random and tuple inputs
# it changed 10,451 result slots only in a zero's sign under cycc 6.6.3 and 6.6.6, none
# under 6.6.14. Negating first, the result differs from 3.3.4's on the same 8,127 slots under
# 6.6.3, 6.6.6 and 6.6.14 (none in a zero's sign), and on 6.6.14 it is the first draft's to the
# bit. An infinite component needs no branch of its own: Inf * 2^p is Inf, so |t|^2 is Inf,
# its reciprocal 0, and the answer NaN beside signed zeros, the bits the two divisions gave,
# under each of those three pins, on all 6,457 infinite-component inputs of that sample.
# |q| = 0 still returns the identity.
# [measured: scratch trees pinned to cycc 6.6.3, 6.6.6, 6.6.14, not reproducible in-tree, 2026-10-11]
public fn hquat_inverse(q) {
    var ls = hquat_length_sq(q);
    var inv = f64_div(F64_ONE, ls);
    if (f64_lt(ls, F64_TINY) == 0 && f64_lt(inv, F64_TINY) == 0) {
        return hquat_new(f64_mul(f64_neg(HQuat_x(q)), inv),
          f64_mul(f64_neg(HQuat_y(q)), inv),
          f64_mul(f64_neg(HQuat_z(q)), inv),
          f64_mul(HQuat_w(q), inv));
    }
    var mx = f64_max(f64_max(f64_abs(HQuat_x(q)), f64_abs(HQuat_y(q))),
      f64_max(f64_abs(HQuat_z(q)), f64_abs(HQuat_w(q))));
    if (f64_eq(mx, 0) == 1) { return hquat_identity(); }
    var p = 1023 - (mx >> 52);
    var h = p / 2;
    var f1 = (1023 + h) << 52;
    var f2 = (1023 + p - h) << 52;
    var t = hquat_new(f64_neg(HQuat_x(q)), f64_neg(HQuat_y(q)), f64_neg(HQuat_z(q)), HQuat_w(q));
    f64v_scale(t, t, f1, 4);
    f64v_scale(t, t, f2, 4);
    var r = alloc(sizeof(HQuat));
    f64v_scale(r, t, f64_div(F64_ONE, hquat_length_sq(t)), 4);
    f64v_scale(r, r, f1, 4);
    f64v_scale(r, r, f2, 4);
    return r;
}

# ================================================================
# Rotate a Vec3: q * v * q^-1 (optimized)
# ================================================================

#must_use
public fn hquat_rotate_vec3(q, v) {
    var qx = HQuat_x(q); var qy = HQuat_y(q); var qz = HQuat_z(q); var qw = HQuat_w(q);
    var vx = HVec3_x(v); var vy = HVec3_y(v); var vz = HVec3_z(v);
    # t = 2 * cross(q.xyz, v)
    var tx = f64_mul(F64_TWO, f64_sub(f64_mul(qy, vz), f64_mul(qz, vy)));
    var ty = f64_mul(F64_TWO, f64_sub(f64_mul(qz, vx), f64_mul(qx, vz)));
    var tz = f64_mul(F64_TWO, f64_sub(f64_mul(qx, vy), f64_mul(qy, vx)));
    # result = v + w*t + cross(q.xyz, t)
    return hvec3_new(
      f64_add(f64_add(vx, f64_mul(qw, tx)), f64_sub(f64_mul(qy, tz), f64_mul(qz, ty))),
      f64_add(f64_add(vy, f64_mul(qw, ty)), f64_sub(f64_mul(qz, tx), f64_mul(qx, tz))),
      f64_add(f64_add(vz, f64_mul(qw, tz)), f64_sub(f64_mul(qx, ty), f64_mul(qy, tx)))
      );
}

# ================================================================
# Spherical linear interpolation
# ================================================================

#must_use
public fn hquat_slerp(a, b, t) {
    var d = hquat_dot(a, b);
    var bx = HQuat_x(b); var by = HQuat_y(b); var bz = HQuat_z(b); var bw = HQuat_w(b);
    # Shortest path: negate b if dot < 0
    if (f64_lt(d, 0) == 1) {
        bx = f64_neg(bx); by = f64_neg(by);
        bz = f64_neg(bz); bw = f64_neg(bw);
        d = f64_neg(d);
    }
    # If very close, lerp
    var threshold = 0x3FEFFBE76C8B4396;  # 0.9995
    if (f64_gt(d, threshold) == 1) {
        var omt = f64_sub(F64_ONE, t);
        return hquat_normalize(hquat_new(
            f64_add(f64_mul(HQuat_x(a), omt), f64_mul(bx, t)),
            f64_add(f64_mul(HQuat_y(a), omt), f64_mul(by, t)),
            f64_add(f64_mul(HQuat_z(a), omt), f64_mul(bz, t)),
            f64_add(f64_mul(HQuat_w(a), omt), f64_mul(bw, t))
            ));
    }
    var theta = ganita_f64_acos(d);
    var sin_theta = f64_sin(theta);
    var inv_sin = f64_div(F64_ONE, sin_theta);
    var s0 = f64_mul(f64_sin(f64_mul(f64_sub(F64_ONE, t), theta)), inv_sin);
    var s1 = f64_mul(f64_sin(f64_mul(t, theta)), inv_sin);
    return hquat_new(
      f64_add(f64_mul(HQuat_x(a), s0), f64_mul(bx, s1)),
      f64_add(f64_mul(HQuat_y(a), s0), f64_mul(by, s1)),
      f64_add(f64_mul(HQuat_z(a), s0), f64_mul(bz, s1)),
      f64_add(f64_mul(HQuat_w(a), s0), f64_mul(bw, s1))
      );
}
