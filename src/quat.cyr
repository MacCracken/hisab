# quat.cyr -- quaternion type for 3D rotations
# Usage: shipped inside dist/hisab.cyr; in-tree, include "src/quat.cyr" after what it requires
# Requires: src/error.cyr, src/vec3.cyr (stdlib resolves via cyrius.cyml [deps])
#
# Heap-allocated: { x: f64, y: f64, z: f64, w: f64 } = 32 bytes
# Convention: w is the scalar part, (x, y, z) is the vector part.

# No module-local threshold. From 2.11.1 a `_QUAT_F64_TINY` (DBL_MIN: a literal through
# 2.13.0, an alias of error.cyr's F64_TINY from 2.14.0) stood here, and `hquat_normalize`
# (on |q|) and `hquat_inverse` (on |q|²) returned the identity below it; 2.17.0 removed
# it. From 2.17.0 to 3.3.3 `hquat_normalize` returned the identity wherever 1/|q|
# overflows (|q| = 0, or |q| <= 2^-1024); since 3.3.4 only at |q| = 0. `hquat_length`,
# `hquat_normalize` (since 3.3.5) and `hquat_inverse` use F64_TINY directly, to choose
# between their direct and rescaled paths. 3.4.0 retired both for `_checked` forms that
# return `Err` for the zero quaternion, which has no inverse and no direction (they returned
# the identity), and for a NaN or infinite component.

enum _QuatF64 {
    _QUAT_NAN  = 0x7FF8_0000_0000_0000;   # NaN: `hquat_slerp` where its interpolant has no direction
    _QUAT_N_LO = 0x3FD0_0000_0000_0000;   # 0.25
    _QUAT_N_HI = 0x4030_0000_0000_0000;   # 16.0
    _QUAT_D_HI = 0x3FEF_FBE7_6C8B_4396;   # 0.9995
}

#derive(accessors)
public struct HQuat { x; y; z; w; }

# 3.4.0 (the [3.3.8] allocation row): every function here that allocates returns the designed 0
# when the allocation is refused (an exhausted heap), and every Result returns Err(HSB_ERR_ALLOC);
# none stores through a 0 handle. A 0 handle passed IN is the caller's.

# A new HQuat (x, y, z, w), w the scalar part: 32 bytes from the heap, the components stored
# as given. Returns the designed 0 where the allocation is refused (3.4.0).
#must_use
public fn hquat_new(x, y, z, w) {
    var q = alloc(sizeof(HQuat));
    if (q == 0) { return 0; }
    HQuat_set_x(q, x);
    HQuat_set_y(q, y);
    HQuat_set_z(q, z);
    HQuat_set_w(q, w);
    return q;
}

# (0, 0, 0, 1), the rotation by nothing.
#must_use
public fn hquat_identity() { return hquat_new(0, 0, 0, F64_ONE); }

# The quaternion (axis sin(angle / 2), cos(angle / 2)) of the right-handed rotation by `angle`
# radians about `axis` (counterclockwise seen from the axis tip), angle / 2 exact (a halving)
# and its sine and cosine as `f64_sin` / `f64_cos` round them, each product rounded once.
# `axis` must be a unit vector for q to be the rotation by `angle`: otherwise q is not unit, and
# the rotation it represents (q / |q|, as `hquat_rotate_vec3` applies it) is about axis's
# direction by 2 atan2(|axis| sin(angle / 2), cos(angle / 2)), not by `angle`; a zero axis gives
# (0, 0, 0, cos(angle / 2)). Returns the designed 0 where the allocation is refused.
#must_use
public fn hquat_from_axis_angle(axis, angle) {
    var half = f64_mul(angle, F64_HALF);
    var s = f64_sin(half);
    var c = f64_cos(half);
    return hquat_new(f64_mul(HVec3_x(axis), s),
      f64_mul(HVec3_y(axis), s),
      f64_mul(HVec3_z(axis), s), c);
}

# The unit quaternion (sin(angle / 2), 0, 0, cos(angle / 2)) of the right-handed rotation by
# `angle` radians about X; `_y` and `_z` below likewise about Y and Z. angle / 2 is exact and its
# sine and cosine are `f64_sin` / `f64_cos`'s. Returns the designed 0 where the allocation is
# refused.
#must_use
public fn hquat_from_rotation_x(angle) {
    var half = f64_mul(angle, F64_HALF);
    return hquat_new(f64_sin(half), 0, 0, f64_cos(half));
}

# (0, sin(angle / 2), 0, cos(angle / 2)): the rotation by `angle` radians about Y.
#must_use
public fn hquat_from_rotation_y(angle) {
    var half = f64_mul(angle, F64_HALF);
    return hquat_new(0, f64_sin(half), 0, f64_cos(half));
}

# (0, 0, sin(angle / 2), cos(angle / 2)): the rotation by `angle` radians about Z.
#must_use
public fn hquat_from_rotation_z(angle) {
    var half = f64_mul(angle, F64_HALF);
    return hquat_new(0, 0, f64_sin(half), f64_cos(half));
}

# ================================================================
# Arithmetic -- Hamilton product: q * r
# ================================================================

# The Hamilton product q r (w the scalar part). As rotations q r applies r first, then q:
# rotating v by q r is rotating it by r and the result by q. Each component is a sum of four
# products, within 4u of the sum of their magnitudes to first order (u = 2^-53); |q r| = |q| |r|
# in exact arithmetic, so unit inputs give a product unit to a few u. Overflow and NaN follow
# IEEE. Returns the designed 0 where the allocation is refused.
#must_use
public fn hquat_mul(q, r) {
    var qx = HQuat_x(q); var qy = HQuat_y(q); var qz = HQuat_z(q); var qw = HQuat_w(q);
    var rx = HQuat_x(r); var ry = HQuat_y(r); var rz = HQuat_z(r); var rw = HQuat_w(r);
    return hquat_new(
      f64_add(f64_add(f64_mul(qw, rx), f64_mul(qx, rw)),
        f64_sub(f64_mul(qy, rz), f64_mul(qz, ry))),
      f64_add(f64_add(f64_mul(qw, ry), f64_mul(qy, rw)),
        f64_sub(f64_mul(qz, rx), f64_mul(qx, rz))),
      f64_add(f64_add(f64_mul(qw, rz), f64_mul(qz, rw)),
        f64_sub(f64_mul(qx, ry), f64_mul(qy, rx))),
      f64_sub(f64_mul(qw, rw),
        f64_add(f64_add(f64_mul(qx, rx), f64_mul(qy, ry)), f64_mul(qz, rz)))
      );
}

# The conjugate (-x, -y, -z, w), exact (`f64_neg`; below cycc 6.6.8 it gave +0 for +0): the
# inverse of a unit q, the reverse rotation. Returns the designed 0 where the allocation is
# refused.
#must_use
public fn hquat_conjugate(q) {
    return hquat_new(f64_neg(HQuat_x(q)), f64_neg(HQuat_y(q)),
      f64_neg(HQuat_z(q)), HQuat_w(q));
}

# SIMD: quat is 4 contiguous f64 (32 bytes), packed dot at n=4 (no over-read).
#
# The 4-vector dot product of a and b (x, y, z, w), summed as `hvec4_dot` sums it, with its
# accuracy and its zero convention (+0 wherever every product is a zero, -0 included; vec3.cyr's
# `hvec3_dot` says why that is documented rather than changed).
# ⚠ NOT BIT-IDENTICAL ACROSS TARGETS (vec4.cyr's `hvec4_dot` says why: aarch64 fuses each
# lane's second product), and through it `hquat_length_sq`, `hquat_length`,
# `hquat_normalize_checked`, `hquat_inverse_checked` and `hquat_slerp` may differ in their
# last bits between x86 and aarch64.
#must_use
public fn hquat_dot(a, b) {
    return f64v_dot(a, b, 4);
}

# |q|^2 (`hquat_dot(q, q)`, its summation order and its aarch64 caveat): +Inf once a square
# passes DBL_MAX (|component| >= 2^512), subnormal and losing bits once every component is
# below 2^-511; `hquat_length` holds the whole range.
#must_use
public fn hquat_length_sq(q) { return hquat_dot(q, q); }
#must_use
fn _hquat_len_scaled(q) {
    var x = HQuat_x(q); var y = HQuat_y(q); var z = HQuat_z(q); var w = HQuat_w(q);
    var mx = f64_max(f64_max(f64_abs(x), f64_abs(y)), f64_max(f64_abs(z), f64_abs(w)));
    # ⚠ 3.3.3 — NaN never reaches here; see `_hvec3_len_scaled`. Called directly, this
    # max drops a NaN in x, y or z and the exit returns 0; `hquat_length` routes a NaN
    # to its sqrt(NaN) fast path instead, and tests/abuse.tcyr pins that per slot.
    # [measured: scratch harness, not reproducible in-tree, 2026-10-01; cycc 6.6.12]
    if (f64_gt(mx, 0) == 0) { return mx; }
    # ⚠ Inf/Inf is NaN, so the infinity contract needs its own exit here.
    if (f64_eq(mx, F64_POS_INF) == 1) { return mx; }
    var xs = f64_div(x, mx); var ys = f64_div(y, mx);
    var zs = f64_div(z, mx); var ws = f64_div(w, mx);
    var acc = f64_add(f64_mul(xs, xs), f64_mul(ys, ys));
    acc = f64_add(acc, f64_add(f64_mul(zs, zs), f64_mul(ws, ws)));
    return f64_mul(mx, f64_sqrt(acc));
}

# ⛔ 2.17.0 — same class as `hvec3_length`: squaring before summing loses 537
# binades below and 512 above, and is silently wrong in the subnormal band
# between. ⚠ This one matters beyond its own module: `hquat_normalize` and
# `hquat_inverse` are what 2.11.1 repaired for returning a fabricated IDENTITY —
# the guard was fixed then, the norm was not.
# ⛔ AND AN EARLIER DRAFT OF THIS VERY COMMENT SAID BOTH OF THEM "route through
# it", WHICH WAS FALSE FOR `hquat_inverse` — it reads `hquat_length_sq` directly
# and so kept the whole defect, 1018 of 2041 binades, 507 of them the fabricated
# identity this file has now claimed to have fixed twice. A comment asserting a
# call graph is a claim like any other and this one was never checked.
# [measured: 2041-binade two-sided sweep on q*q^-1, 2026-09-10]
public fn hquat_length(q) {
    var ls = hquat_length_sq(q);
    if (f64_lt(ls, F64_TINY) == 1) { return _hquat_len_scaled(q); }
    if (f64_eq(ls, F64_POS_INF) == 1) { return _hquat_len_scaled(q); }
    return f64_sqrt(ls);
}

# q * s normalised, for an exact power of two s: `hquat_normalize`'s two ends (3.3.4).
fn _hquat_scaled_unit(q, s) {
    var t = alloc(sizeof(HQuat));
    if (t == 0) { return 0; }
    f64v_scale(t, q, s, 4);
    var r = alloc(sizeof(HQuat));
    if (r == 0) { return 0; }
    f64v_scale(r, t, f64_div(F64_ONE, hquat_length(t)), 4);
    return r;
}

#must_use
# 2.11.1: threshold was EPSILON_F64 (1e-12), which fabricated the identity for
# any quaternion shorter than that even though the division is well-defined far
# below it. `len` is unsquared so the units were at least right -- unlike
# hquat_inverse below, which was out by the square.
# ⛔ 2.17.0 — AND THE THRESHOLD WAS STILL WRONG AFTER 2.11.1, in the direction
# `src/error.cyr` already names out loud: DBL_MIN is one binade too strict for a
# RECIPROCAL, because `1 / 2^-1023` is finite. That was harmless while the norm
# itself flushed at 2^-537 — the band was unreachable — and repairing
# `hquat_length` above made it reachable, so this guard began fabricating the
# identity for a quaternion that normalises perfectly well.
# ⚠ Measured: **48 of 48** subnormal magnitudes returned the identity here while
# the already-repaired `hvec3_normalize` returned the unit vector for the same
# input. ⭐ The vec family was moved onto the reciprocal-overflow test in 2.14.0;
# this one was not, and repairing the norm without repairing the guard is a NET
# REGRESSION over those 52 binades.
# ⚠ `f64_eq(|inv|, +Inf)` and not the tempting `f64_lt(|inv|, +Inf) == 0`: the
# latter is false for NaN too, and this API's contract is NaN in, NaN out.
# [measured: 48-binade subnormal sweep against the vec3 control, 2026-09-10]
# ⛔ 3.3.4 — AND THE TWO THEN AGREED ON THE WRONG ANSWER: both returned their fallback,
# here the IDENTITY, for 47 of those 48 magnitudes, every non-zero |q| <= 2^-1024. A
# finite quaternion whose norm passes DBL_MAX came back as the ZERO quaternion
# (inv = 1/Inf = 0), which is not a unit at all. Audit D087.
# [measured: scratch harness and Decimal oracle, not reproducible in-tree, 2026-10-03; cycc 6.6.14]
# ⭐ The `hvec3_normalize` repair: normalise an exactly scaled copy, by 2^1023 where
# 1/|q| overflows and by 2^-600 where it is 0, and return that copy's bits. `|q| = 0`
# kept the documented identity until 3.4.0 (below); NaN ran the last lines.
# ⛔ 3.3.5 — and, as there, the two bands beside those ends still carried a subnormal
# rounding: |q| in (2^-1024, 2^-1022), where |q| itself is subnormal, and |q| in (2^1022,
# DBL_MAX], where 1/|q| is. Up to 4.65 and 5.23 ulp on 3,000 random quaternions per band,
# against 2.04 for the same directions at unit length. The copies now start at |q| < DBL_MIN
# and 1/|q| < DBL_MIN: the low band's sample maximum falls to 2.07 (a reviewer's
# independent sample found 2.51; neither is a bound), and the high band is the
# unit-length answer bit for bit (3,000 of 3,000). 139 and 222 inputs that were within 1 ulp
# now carry their direction's unit-length error instead.
# [measured: scratch harness and Decimal oracle, not reproducible in-tree, 2026-10-11; 2.51: the review's sample]
# ⛔ 3.4.0 — `hquat_normalize` RETURNED THE IDENTITY FOR q = 0 (audit D088): the zero
# quaternion has no direction, and the identity is a unit quaternion, a legal answer, with no
# error channel. `hquat_normalize_checked` returns `Err(HSB_ERR_DIVISION_BY_ZERO)` there and
# `Err(HSB_ERR_INVALID_INPUT)` for a NaN or infinite component (which gave a NaN quaternion);
# every other q gets the bits `hquat_normalize` gave it. The fast-path test is written
# positively, so a NaN length leaves it. `hquat_normalize` is retired, not redefined.
#must_use
public fn hquat_normalize_checked(q) {
    var len = hquat_length(q);
    var inv = f64_div(F64_ONE, len);
    if (f64_ge(len, F64_TINY) == 1 && f64_ge(inv, F64_TINY) == 1) {
        var r = alloc(sizeof(HQuat));
        if (r == 0) { return Err(HSB_ERR_ALLOC); }
        f64v_scale(r, q, inv, 4);
        return Ok(r);
    }
    if (_hquat_finite(q) == 0) { return Err(HSB_ERR_INVALID_INPUT); }
    var su = 0;
    if (f64_lt(len, F64_TINY) == 1) {
        if (f64_eq(len, 0) == 1) { return Err(HSB_ERR_DIVISION_BY_ZERO); }
        su = _hquat_scaled_unit(q, (1023 + 1023) << 52);   # 2^1023
    } else {
        su = _hquat_scaled_unit(q, (1023 - 600) << 52);    # 2^-600
    }
    if (su == 0) { return Err(HSB_ERR_ALLOC); }
    return Ok(su);
}

# 1 when every component of q is finite.
fn _hquat_finite(q) {
    var i = 0;
    while (i < 4) {
        if ((load64(q + i * 8) & 0x7FFF_FFFF_FFFF_FFFF) >= 0x7FF0_0000_0000_0000) { return 0; }
        i = i + 1;
    }
    return 1;
}

# 1 when every component of q is a zero of either sign.
fn _hquat_is_zero(q) {
    var o = HQuat_x(q) | HQuat_y(q) | HQuat_z(q) | HQuat_w(q);
    if ((o & 0x7FFF_FFFF_FFFF_FFFF) == 0) { return 1; }
    return 0;
}

#must_use
# 2.11.1: `len_sq` is a SQUARED magnitude and was compared against the UNSQUARED
# EPSILON_F64, so the effective threshold was |q| < 1e-6 -- six orders of
# magnitude coarser than intended, and the seventh instance of a class first
# recorded in complex.cyr in 2.6.14.
#
# It did not return a wrong number, it returned the IDENTITY: measured, q*q^-1
# stopped equalling the identity at |q| ~ 1e-7, where the error jumps from 0 to
# 1.0 because the "inverse" is the identity and q is nearly zero. A quaternion of
# magnitude 1.4e-7 has an inverse of magnitude 7e6 -- finite, representable, and
# silently replaced by a rotation of zero.
# [measured: tests/foundation.tcyr "2.11.1 quat: inverse and normalize are scale-covariant"]
# ⛔ 2.17.0 — THIS IS THE SITE THE RELEASE MISSED ON ITS FIRST PASS. It reads
# `hquat_length_sq` DIRECTLY, so repairing `hquat_length` above did nothing for
# it: measured, **1018 of 2041 binades wrong**, and **507 of them returned the
# fabricated IDENTITY** — the exact failure the 2.11.1 note below says it fixed.
# 2.11.1 moved the threshold from 1e-6 to DBL_MIN; the fabrication simply moved
# with it, to |q| ~ 1.5e-155. At the other end `|q|² = +Inf` made `inv` 0 and the
# inverse came back as the ZERO quaternion. ⚠ It surfaced from a regression sweep
# asking "what did the repair miss", not from the census — the census listed the
# module as done. [measured: 2041-binade two-sided sweep on q*q^-1, 2026-09-10]
#
# ⭐ FAST PATH, AND THE FAST PATH IS THE SHIPPED ARITHMETIC UNCHANGED. `1/|q|²` is
# ONE rounding; the rescue below divides twice and pays two. Measured against
# exact rational truth over 180 components of 45 ordinary quaternions: the direct
# form is mean 0.309 ulp / worst 1.101, the two-division form mean 0.655 / worst
# 2.115 — **2.12x the error**, and the two disagree on 97 of the 180. So the
# direct form is kept wherever it is exact and the rescue runs only where the
# direct form would otherwise fabricate.
# ⚠ Replacing the whole function with the two-division form would therefore be a
# precision REGRESSION on every ordinary quaternion, which is why this is a fast
# path and not a rewrite.
# [measured: scratch harness, exact Fraction truth vs both f64 pipelines, 2026-09-10]
# ⚠ The fast-path test needs BOTH ends: `ls` subnormal or +Inf means the sum of
# squares lost the value on the way in, and `1/ls` subnormal means the reciprocal
# lost it on the way back — a fixture that only goes down would have missed the
# second, which fails at 2^509 alone.
# ⚠ NaN satisfies neither test, so it takes the fast path and propagates, which
# is what `tests/abuse.tcyr` pins for this family.
#
# ⭐ THE RESCUE DIVIDES TWICE BY |q| AND NEVER ONCE BY |q|². A quaternion at
# 2^-600 has an inverse at 2^600 — perfectly representable — but |q|² is not, so
# the squared form cannot get there by any threshold. ⚠ And it must be `f64_div`,
# not a multiply by `1/|q|`: for a subnormal |q| the reciprocal is +Inf and the
# zero components would come back as `0 * Inf` = NaN, the rule
# `src/linalg_precision.cyr:78` states verbatim.
#
# ⛔ 3.3.5 — AND THAT RESCUE PAID FOR ITS ROUNDINGS. Two divisions by a rounded |q| (a
# subnormal one below 2^-1022) put full-mantissa quaternions up to 4.58 ulp off in the
# rescued bands and 48.8 ulp off for a subnormal |q|, where the fast path stays within
# 2.75; and past DBL_MAX |q| was +Inf, so the inverse came back as the zero quaternion.
# The 2041-binade sweep in tests/foundation.tcyr could not see any of it: its (3s, 4s,
# 0, 0) has |q| = 5s exactly, and both forms give the same bits there.
# [measured: scratch harness and Fraction oracle, not reproducible in-tree, 2026-10-11; cycc 6.6.14]
# ⭐ The rescue is now the fast path on an exact copy of the conjugate: t = (-x, -y, -z, w) *
# 2^p, with p from the largest component's exponent so that component is in [1, 2) (or
# [2^-51, 1) when subnormal), then t / |t|^2 * 2^p, both scalings as two normal powers of
# two. That is the fast path's answer for the same direction at unit scale, bit for bit
# wherever the result is normal, and the top band's zero quaternion becomes the inverse. On
# a 14,629-quaternion sample (8,392 random full-mantissa ones, 4 per binade from 2^-1074
# to 2^1023, plus the axis and (3s, 4s) shapes) the largest errors were 2.35 and 2.48 ulp in
# the rescued bands and 1.36 for a subnormal |q| — sample maxima, not bounds: a reviewer's
# independent sample found 2.67 for a subnormal |q|. A zero component stays zero (0 * 2^p
# is 0, never 0 * Inf), and an overflowing inverse still overflows honestly to +-Inf.
# ⚠ Not every rescued answer improved: of 7,472, 452 that were within 1 ulp now are not and
# 1,894 went the other way; each now carries the error the fast path makes on the same
# quaternion at unit scale. 32 of the 452 are single-component q, where the two divisions
# had been exact to half an ulp and the fast path rounds three times (now within 1.57).
# [measured: scratch harness and Fraction oracle, not reproducible in-tree, 2026-10-11; 2.67: the review's sample]
# ⚠ THE NEGATION GOES ON BEFORE THE SCALING. Below cycc 6.6.8 `f64_neg(+0)` is +0, and a
# component far below the largest flushes to zero in the copy; negated after it, that zero
# came back +0 where -x is -0. The first draft did that: on 30,562 random and tuple inputs
# it changed 10,451 result slots only in a zero's sign under cycc 6.6.3 and 6.6.6, none
# under 6.6.14. Negating first, the result differs from 3.3.4's on the same 8,127 slots under
# 6.6.3, 6.6.6 and 6.6.14 (none in a zero's sign), and on 6.6.14 it is the first draft's to the
# bit. An infinite component needs no branch of its own: Inf * 2^p is Inf, so |t|^2 is Inf,
# its reciprocal 0, and the answer NaN beside signed zeros, the bits the two divisions gave,
# under each of those three pins, on all 6,457 infinite-component inputs of that sample.
# [measured: scratch trees pinned to cycc 6.6.3, 6.6.6, 6.6.14, not reproducible in-tree, 2026-10-11]
# ⛔ 3.4.0 — AND |q| = 0 RETURNED THE IDENTITY (audit D088): zero has no inverse, and the
# identity is a legal one. `hquat_inverse_checked` returns `Err(HSB_ERR_DIVISION_BY_ZERO)` for
# it and `Err(HSB_ERR_INVALID_INPUT)` for a NaN or infinite component (which gave NaN beside
# signed zeros, above); every other q gets the bits `hquat_inverse` gave it. `hquat_inverse`
# is retired, not redefined.
#must_use
public fn hquat_inverse_checked(q) {
    var ls = hquat_length_sq(q);
    var inv = f64_div(F64_ONE, ls);
    if (f64_ge(ls, F64_TINY) == 1 && f64_ge(inv, F64_TINY) == 1) {
        var qi = hquat_new(f64_mul(f64_neg(HQuat_x(q)), inv),
          f64_mul(f64_neg(HQuat_y(q)), inv),
          f64_mul(f64_neg(HQuat_z(q)), inv),
          f64_mul(HQuat_w(q), inv));
        if (qi == 0) { return Err(HSB_ERR_ALLOC); }
        return Ok(qi);
    }
    if (_hquat_finite(q) == 0) { return Err(HSB_ERR_INVALID_INPUT); }
    var mx = f64_max(f64_max(f64_abs(HQuat_x(q)), f64_abs(HQuat_y(q))),
      f64_max(f64_abs(HQuat_z(q)), f64_abs(HQuat_w(q))));
    if (f64_eq(mx, 0) == 1) { return Err(HSB_ERR_DIVISION_BY_ZERO); }
    var p = 1023 - (mx >> 52);
    var h = p / 2;
    var f1 = (1023 + h) << 52;
    var f2 = (1023 + p - h) << 52;
    var t = hquat_new(f64_neg(HQuat_x(q)), f64_neg(HQuat_y(q)), f64_neg(HQuat_z(q)), HQuat_w(q));
    if (t == 0) { return Err(HSB_ERR_ALLOC); }
    f64v_scale(t, t, f1, 4);
    f64v_scale(t, t, f2, 4);
    var r = alloc(sizeof(HQuat));
    if (r == 0) { return Err(HSB_ERR_ALLOC); }
    f64v_scale(r, t, f64_div(F64_ONE, hquat_length_sq(t)), 4);
    f64v_scale(r, r, f1, 4);
    f64v_scale(r, r, f2, 4);
    return Ok(r);
}

# ================================================================
# Rotate a Vec3 by the rotation q represents: q v q^-1, the rotation by q / |q|, for every
# finite non-zero q, computed as v + w t' + u x t' with u = q.xyz and t' = 2 (u x v) / |q|^2.
# ================================================================

# x * 2^k, rounded once, for |k| <= 2096. Upward every step is exact or overflows. Downward
# the remainder goes first, so each step before the last is exact, or is subnormal and the
# steps after it end at a zero, as x * 2^k rounds to.
fn _hquat_ldexp(x, k) {
    while (k > 1023) { x = f64_mul(x, (1023 + 1023) << 52); k = k - 1023; }
    if (k >= 0) { return f64_mul(x, (1023 + k) << 52); }
    var m = (0 - k) / 1022;
    x = f64_mul(x, (1023 - ((0 - k) - m * 1022)) << 52);
    while (m > 0) { x = f64_mul(x, 0x0010000000000000); m = m - 1; }   # 2^-1022
    return x;
}

# `hquat_rotate_vec3` after an intermediate overflowed: rotate v * 2^-k, scale back by 2^k.
# NaN and Inf inputs return the fast path's answer, as through 3.3.5. With every |q_i| below
# Q = 2^(eq + 1) and every |v_i| below V, each intermediate of the formula is below
# V + 12 Q^2 V, at most 16 Q^2 V once Q >= 1/2, so V <= 2^(1017 - 2 eq) keeps all of them at
# or under 2^1023, a factor 2 below overflow; a q whose largest component is under 1/4 is
# bounded as eq = -2. An overflow means v broke that bound, so k >= 1 and the copy cannot
# overflow: the call below recurses exactly once.
# The copy is exact unless a component of v falls below 2^(k - 1022), where it loses its low
# bits or all of them: under a half turn about z (|q| = 1, k = 7) a subnormal v.z beside
# 2^1023 keeps its bits only with seven trailing zero bits (4 of the 11,338 sweep inputs that
# took this path, outside the formula's own error bound; 3.3.5: NaN for all 4), and with
# q's components spanning 2^256 or more, k passes 1022 plus the exponent of ordinary
# components, which vanish from the copy. Only the components the fast path made non-finite
# are taken from the copy, and only when what the copy lost cannot reach its answer (below).
# [measured: scratch harness and Fraction oracle, not reproducible in-tree, 2026-10-11; cycc 6.6.14]
# 3.4.0: the formula divides t by n = |q|^2, and `hquat_rotate_vec3` runs it for n in [1/4, 16].
# For n >= 1 that division only shrinks t, so the bounds below hold as written; a q with
# n < 1 is doubled first (2q is the same rotation, and n becomes 4n >= 1), so they hold for it
# too. A q with n = 1 runs exactly as through 3.3.7.
fn _hquat_rotate_wide(q, v, rx, ry, rz) {
    var qx = HQuat_x(q); var qy = HQuat_y(q); var qz = HQuat_z(q); var qw = HQuat_w(q);
    var vx = HVec3_x(v); var vy = HVec3_y(v); var vz = HVec3_z(v);
    if (f64_lt(f64_abs(qx), F64_POS_INF) == 0 || f64_lt(f64_abs(qy), F64_POS_INF) == 0
      || f64_lt(f64_abs(qz), F64_POS_INF) == 0 || f64_lt(f64_abs(qw), F64_POS_INF) == 0
      || f64_lt(f64_abs(vx), F64_POS_INF) == 0 || f64_lt(f64_abs(vy), F64_POS_INF) == 0
      || f64_lt(f64_abs(vz), F64_POS_INF) == 0) {
        return hvec3_new(rx, ry, rz);
    }
    var nn = f64_add(f64_add(f64_mul(qx, qx), f64_mul(qy, qy)), f64_add(f64_mul(qz, qz), f64_mul(qw, qw)));
    if (f64_lt(nn, F64_ONE) == 1) {
        qx = f64_mul(qx, F64_TWO); qy = f64_mul(qy, F64_TWO);
        qz = f64_mul(qz, F64_TWO); qw = f64_mul(qw, F64_TWO);
        q = hquat_new(qx, qy, qz, qw);
        if (q == 0) { return 0; }
    }
    var mv = f64_abs(vx);
    if (f64_abs(vy) > mv) { mv = f64_abs(vy); }
    if (f64_abs(vz) > mv) { mv = f64_abs(vz); }
    var mq = f64_abs(qx);
    if (f64_abs(qy) > mq) { mq = f64_abs(qy); }
    if (f64_abs(qz) > mq) { mq = f64_abs(qz); }
    if (f64_abs(qw) > mq) { mq = f64_abs(qw); }
    var eq = (mq >> 52) - 1023;
    if (eq < 0 - 2) { eq = 0 - 2; }
    var k = (mv >> 52) - 1023 - 1016 + 2 * eq;
    var wx = _hquat_ldexp(vx, 0 - k);
    var wy = _hquat_ldexp(vy, 0 - k);
    var wz = _hquat_ldexp(vz, 0 - k);
    var wv = hvec3_new(wx, wy, wz);
    if (wv == 0) { return 0; }
    var s = hquat_rotate_vec3(q, wv);
    if (s == 0) { return 0; }
    var cx = _hquat_ldexp(HVec3_x(s), k);
    var cy = _hquat_ldexp(HVec3_y(s), k);
    var cz = _hquat_ldexp(HVec3_z(s), k);
    # The copy is trusted only where what it lost cannot reach its answer: l = v - (v 2^-k) 2^k,
    # the bits of v the scaling dropped (exact), reaches at most 2^(e(max |l|) + 2 eq + 10)
    # through the formula, and the copy's own subnormal rounding 2^(k - 1074 + eq + 4); its
    # components are taken only when the larger of the two sits more than 56 binades below
    # the copy's largest component. Otherwise the fast path's +-Inf stands (a NaN from it is
    # replaced either way). Through round 2 of 3.3.6 the copy's components were taken
    # whenever the fast path's were not finite, and on q whose components span 2^256 or more
    # (largest nonzero over smallest nonzero) a component whose exact value overflows read
    # finite from a copy that had lost v's smaller components, or an infinity of the wrong
    # sign: q = (0, 1.59, -1.4e289, 0.377), v = (1.4e-226, 1, -0) has x near -2^1226, which
    # 3.3.5 gave as -Inf and round 2 as 1.1e296. (The test is the round-2 review's, checked
    # against its Python model on 360,000 inputs.)
    # [measured: review rotation family (rot_T4norm), C2 seeds 301/302, 3.3.5 vs this tree, 2026-10-11; cycc 6.6.14]
    var ml = f64_abs(f64_sub(vx, _hquat_ldexp(wx, k)));
    var l2 = f64_abs(f64_sub(vy, _hquat_ldexp(wy, k)));
    if (l2 > ml) { ml = l2; }
    var l3 = f64_abs(f64_sub(vz, _hquat_ldexp(wz, k)));
    if (l3 > ml) { ml = l3; }
    var lim = k - 1074 + eq + 4;
    if (ml != 0) {
        var ll = (ml >> 52) - 1023 + 2 * eq + 10;
        if (ll > lim) { lim = ll; }
    }
    var en = f64_abs(cx);
    if (f64_abs(cy) > en) { en = f64_abs(cy); }
    if (f64_abs(cz) > en) { en = f64_abs(cz); }
    var take = 0;
    if ((en >> 52) - 1023 - 56 > lim) { take = 1; }
    # A component the fast path formed finite is kept: only the non-finite ones are replaced.
    var sx = rx;
    var sy = ry;
    var sz = rz;
    if (f64_lt(f64_abs(rx), F64_POS_INF) == 0) { if (take == 1 || f64_eq(rx, rx) == 0) { sx = cx; } }
    if (f64_lt(f64_abs(ry), F64_POS_INF) == 0) { if (take == 1 || f64_eq(ry, ry) == 0) { sy = cy; } }
    if (f64_lt(f64_abs(rz), F64_POS_INF) == 0) { if (take == 1 || f64_eq(rz, rz) == 0) { sz = cz; } }
    return hvec3_new(sx, sy, sz);
}

# ⛔ 3.3.5 — t = 2 q x v AND THE SUMS AFTER IT OVERFLOWED FOR |v| NEAR DBL_MAX. t is about
# 2 |q| |v| and q x t about 2 |q|^2 |v|, so the formula needs headroom its answer does not: a
# half turn about z of (2^1023, 0, 0) came back (-Inf, NaN, NaN), not (-2^1023, 0, 0). On
# 131,405 sweep inputs (unit, axis, near-identity and non-unit q; v at every binade, the top
# ones densely) 3.3.5 put an Inf or NaN in 11,338 answers for finite input. 10,583 were wrong
# and are now right; 747 overflow honestly and keep their bits; 4 had an exact component of
# +-DBL_MAX that came back +-Inf (now 1 ulp inside); 4 are in `_hquat_rotate_wide`'s comment.
# ⭐ Only an overflow makes an Inf or NaN from finite input, and every t component reaches
# every answer component, so the test below sees any of them; only then does
# `_hquat_rotate_wide` rerun the formula on v * 2^-k, and only the components that came out
# non-finite are replaced. Every answer that was finite keeps the fast path and its bits
# (117,067 of 117,067), NaN and Inf inputs keep theirs (3,000 of 3,000), none of the sweep's
# inputs went from right to wrong, and a rerun gives 3.3.5's answer at v * 2^-8 times 2^8 on
# all 29,766 sweep inputs where that answer is finite (3,154 of them overflowed at v in 3.3.5).
# (Those counts are sub-lane A's sweep; an answer is right when each component is within 8 ulp
# of the exact formula's largest finite component.)
# [measured: scratch harness and Fraction oracle, not reproducible in-tree, 2026-10-11; cycc 6.6.14]
# ⚠ AND WHERE q's COMPONENTS SPAN 2^256 OR MORE (largest nonzero over smallest nonzero). On a
# broader family (150,000 inputs per seed: unit, axis, random and non-unit q, |q| from 2^-600
# to 2^500 times a unit one, v at every scale), with a component right when it is within 8
# ulp of the largest finite exact component, or is the +-Inf of its sign (+-DBL_MAX within
# 2^970) where its exact value overflows, round 2 of 3.3.6 took 1,874 answers from right to
# wrong, every one in that class: a component whose exact value overflows read finite, or an
# infinity of the wrong sign, from the copy that had lost v's smaller components. With the
# trust test in `_hquat_rotate_wide` none goes from right to wrong on seeds 301 and 302,
# against 22,591 and 22,247 wrong -> right.
# [measured: C2 review rotation family (rotm4, rotrw), seeds 301, 302; 3.3.5 vs this tree, 2026-10-11; cycc 6.6.14]
# ⛔ 3.4.0 — THROUGH 3.3.7 THIS WAS A ROTATION ONLY FOR A UNIT q. It computed v + w t + u x t
# with t = 2 u x v, which is q v q* for |q| = 1 and for any other q is neither q v q^-1 nor
# q v q* at any scale: q = (0.154, 3.32, 3.86, -15.2) took (1, 1, -1) to (166.8, -175.5,
# 144.2), where q v q^-1 = (1.65, 0.31, -0.43). A q one ulp off unit length carried that ulp
# into the answer, and q = 0 returned v unchanged, a rotation by nothing.
# ⭐ q v q^-1 = ((w^2 - |u|^2) v + 2 (u . v) u + 2 w u x v) / n, n = |q|^2, which is the 3.3.7
# formula with t divided by n: v + w (t/n) + u x (t/n). Dividing t, not the sum, keeps every
# operation the 3.3.7 one where n = 1.0 exactly, so a q whose |q|^2 rounds to 1 rotates
# bit for bit as before (t/1 is t). n is used directly in [1/4, 16]; any other finite non-zero
# q is first scaled by a power of two to put its largest component in [1, 2), the same
# rotation (`_hquat_rotate_qscaled`), so neither n nor t/n can overflow or flush because of
# |q|. q = 0 gives the formula's own answer, 0/0 = NaN: it represents no rotation.
# The error, derived to first order in u = 2^-53 (a = |q.xyz|, so 2 |w| a <= n and a^2 <= n):
# |n~ - n| <= 3u n; |t~ - t| <= 4 sqrt(2) u a |v| (two products and a difference per
# component, each bounded through Cauchy-Schwarz) and |t| <= 2 a |v|, so the computed t' is
# within (4 sqrt(2) + 8) u a |v| / n of t / n; the map t' -> w t' + u x t' has norm sqrt(n),
# which carries that to 13.7 u |v| in the answer; and the final products and sums add at most
# 8 u |v| per component (each term is at most 2 |v|). So every component is within 22 u |v| of
# the exact rotation (where the computed |q|^2 is 1.0 and t is not divided, the 3u of n moves
# to t's term, and the same 22 holds). The first 3.4.0 review found 8.43 u |v| over 180,000
# components, against the 5.2 u |v| this comment then claimed as a bound from a smaller sample:
# 5.80, 5.76, 6.35 and 6.44 u |v| for |q| <= 2, (2, 16], (16, 2^500] and v near 2^1000, p99
# about 3. Those are measured maxima, not bounds.
# For subnormal v the products' own rounding adds absolute error on the 2^-1074 grid (within
# 4.69 units of it on the review's family).
# [measured: REV-FB t11.py / t11b.py / t11c.py, exact Fraction rotation, the first 3.4.0 review of lane FB, 2026-10-31]
# ⚠ The bound is absolute, the same 22 u |v| for every component, and that is the contract: a
# component the rotation makes far smaller than |v| keeps no relative accuracy. With v the
# exact inverse image of (1, 0, 0) rounded to doubles, under 2,000 random unit q, 4,000 of the
# 6,000 answer components were more than 8 ulp from their own exact values (up to 5.9e20 ulp:
# 2^-54 for an exact 4.58e-22), while all 6,000 were within 7.39 u |v|. A componentwise answer
# would need every product and sum compensated (the arithmetic of `m3_normal_matrix_cof`'s
# compensated tier, whose cost mat3.cyr states); it is not done here.
# [measured: scratch rot.py / ord.in, exact Fraction rotation, lane MAT4, 2026-11-01; cycc 6.7.18]
# On 3,000 normalised q the p99 falls from 3.6 to 2.7 u|v|, and the 1,681 whose |q|^2 is 1.0
# keep 3.3.7's bits.
# [measured: scratch rot_acc.py, exact Fraction rotation, 3.3.7 and lane FB, 2026-10-31; cycc 6.7.9]
# t * (1 / n) instead of t / n is less accurate (p99 3.2) and was slower (60 against 57 ns).
# [measured: scratch rot_acc.py, exact Fraction rotation, 3.3.7 and lane FB, 2026-10-31; cycc 6.7.9]
# ⚠ Cost: |q|^2 and three divisions. A q with |q|^2 = 1.0 exactly skips the divisions (the
# same bits on 60,000 inputs, 18,542 of them such q): per call 43 -> 47 ns there, 43 -> 53 ns
# for the others (hisab.bcyr's q has |q|^2 = 1 - 2^-53), and 44 -> 51 ns over a set where half
# have |q|^2 = 1. It reaches every rotation through this function (t3d_compose, the OBB rays).
# [measured: scratch focus2.bcyr and rot_ident.py, merged tree vs 3.4.0 integration snapshot, 3 runs, 2026-10-31]
#must_use
public fn hquat_rotate_vec3(q, v) {
    var qx = HQuat_x(q); var qy = HQuat_y(q); var qz = HQuat_z(q); var qw = HQuat_w(q);
    var vx = HVec3_x(v); var vy = HVec3_y(v); var vz = HVec3_z(v);
    var n = f64_add(f64_add(f64_mul(qx, qx), f64_mul(qy, qy)), f64_add(f64_mul(qz, qz), f64_mul(qw, qw)));
    var wide = 1;
    # n is +0 or positive (or NaN), so its bits order as it does: an integer range test.
    if (n < _QUAT_N_LO || n > _QUAT_N_HI) {
        var mq = qx & 0x7FFF_FFFF_FFFF_FFFF;
        if ((qy & 0x7FFF_FFFF_FFFF_FFFF) > mq) { mq = qy & 0x7FFF_FFFF_FFFF_FFFF; }
        if ((qz & 0x7FFF_FFFF_FFFF_FFFF) > mq) { mq = qz & 0x7FFF_FFFF_FFFF_FFFF; }
        if ((qw & 0x7FFF_FFFF_FFFF_FFFF) > mq) { mq = qw & 0x7FFF_FFFF_FFFF_FFFF; }
        if (mq != 0 && mq < 0x7FF0_0000_0000_0000) { return _hquat_rotate_qscaled(q, v, mq); }
        wide = 0;   # q = 0 or not finite: the formula's IEEE answer, as it stands
    }
    # t' = 2 * cross(q.xyz, v) / n; for n = 1.0 exactly the division is skipped, which is the
    # same bits (t / 1 is t) and the 3.3.7 arithmetic.
    var tx = f64_mul(F64_TWO, f64_sub(f64_mul(qy, vz), f64_mul(qz, vy)));
    var ty = f64_mul(F64_TWO, f64_sub(f64_mul(qz, vx), f64_mul(qx, vz)));
    var tz = f64_mul(F64_TWO, f64_sub(f64_mul(qx, vy), f64_mul(qy, vx)));
    if (n != 0x3FF0_0000_0000_0000) { tx = f64_div(tx, n); ty = f64_div(ty, n); tz = f64_div(tz, n); }
    # result = v + w*t' + cross(q.xyz, t')
    var rx = f64_add(f64_add(vx, f64_mul(qw, tx)), f64_sub(f64_mul(qy, tz), f64_mul(qz, ty)));
    var ry = f64_add(f64_add(vy, f64_mul(qw, ty)), f64_sub(f64_mul(qz, tx), f64_mul(qx, tz)));
    var rz = f64_add(f64_add(vz, f64_mul(qw, tz)), f64_sub(f64_mul(qx, ty), f64_mul(qy, tx)));
    # One test on rx + ry + rz, non-finite whenever a component is (a finite sum that
    # overflows only sends the three finite components to _hquat_rotate_wide, which keeps
    # them), in place of a test per component on the fast path; an integer test of the bits
    # (+-Inf and NaN are the patterns from 0x7FF0... up, sign cleared).
    if ((f64_add(f64_add(rx, ry), rz) & 0x7FFF_FFFF_FFFF_FFFF) >= 0x7FF0_0000_0000_0000) {
        if (wide == 1) { return _hquat_rotate_wide(q, v, rx, ry, rz); }
    }
    return hvec3_new(rx, ry, rz);
}

# `hquat_rotate_vec3` for a finite non-zero q with |q|^2 outside [1/4, 16]: q * 2^-e, e the
# exponent of its largest component mq (bits), which is the same rotation with that component
# in [1, 2) and so |q|^2 in [1, 16). Exact unless a component lies more than 2^1021 below the
# largest, where it flushes: it moves the rotation by under 2^-1000 radians, so the answer by
# under 2^-1000 |v|, normwise. A component that the flushed one dominates is lost with it:
# q = (2^-1024, about 2^497, about -1.2, about -2^-803) and v about (2^1004, -2^-71, -2^-400)
# give z = -v.z, about 2^-400, where the exact z is 1.62e-89, almost all of it w's term
# (2^-1299 |v|; tests/modules_c.tcyr `_r3_qc` pins it as the normwise contract's answer).
# [measured: scratch rot.py, exact Fraction rotation q v q* / |q|^2, 3.4.1 lane MAT4, 2026-11-01; cycc 6.7.18]
fn _hquat_rotate_qscaled(q, v, mq) {
    var e = (mq >> 52) - 1023;
    if ((mq >> 52) == 0) { e = ((f64_mul(mq, 0x43F0_0000_0000_0000) >> 52) - 1023) - 64; }   # 2^64
    var s = hquat_new(_hquat_ldexp(HQuat_x(q), 0 - e), _hquat_ldexp(HQuat_y(q), 0 - e),
      _hquat_ldexp(HQuat_z(q), 0 - e), _hquat_ldexp(HQuat_w(q), 0 - e));
    if (s == 0) { return 0; }
    return hquat_rotate_vec3(s, v);
}

# ================================================================
# Spherical linear interpolation
# ================================================================

# Spherical linear interpolation from a (t = 0) to b (t = 1) along the shorter arc: with b' = b
# or -b, whichever has d = a . b' >= 0 (the same rotation), and theta the angle between a and
# b', the answer is (sin((1 - t) theta) a + sin(t theta) b') / sin(theta), for any real t
# (outside [0, 1] it extrapolates along the same great circle). theta is acos(d) for d <= 0.9995
# and 2 atan2(|a - b'|, |a + b'|) above, which keeps its relative accuracy at any small angle;
# where d >= 1 (theta below about 2^-26) or |a - b'| is 0 (or below 2^-537, where its squares
# flush) the answer is the normalised lerp of a and b', whose angle error, at most about
# theta^3 / 62 for t in [0, 1], is far below rounding there. a and b must be unit quaternions:
# for others the answer is the formula's, neither unit nor an interpolation of their rotations
# (a non-unit pair with d >= 1 takes the normalised lerp, as through 3.4.0). A zero quaternion,
# a or b, gives NaN (it represents no rotation, `_QUAT_NAN`), as does a NaN or infinite
# component; the designed 0 where an allocation is refused. ⚠ Through `hquat_dot` the last
# bits can differ on aarch64.
# [measured: theta^3 / 62, the 3.4.1 review (RV-MAT S2(d)), mpmath over t in [0, 1], 2026-10-31]
# Accuracy, the largest error MEASURED on random unit pairs, not a bound: normwise, in ulp of
# the largest component, against a binary128 slerp of the exact inputs (theta = 2 atan2(|a -
# b'|, |a + b'|); it agrees with a 60-digit mpmath one to 5e-7 ulp on 64,590 of the pairs),
# 1,000,000 pairs per band of theta (log-uniform over [1e-9, 1e-6), [1e-6, 1e-3), [1e-3,
# 0.0316), [0.025, 0.0316), [0.0316, 0.04), [0.0316, 0.1) and [0.1, pi/2], and over [1e-9,
# 0.0316) and [0.0316, pi/2] once more through `t3d_lerp`): for t in [0, 1], 3.73 ulp for theta
# below 0.0316 (the atan2 form) and 4.0 above (acos); for t in [-1.5, 2.5], 9.33 below and 18.13
# above, the acos form's own extrapolation error, unchanged since 3.4.0; for identical or
# antipodal pairs, 4 ulp of a for t in [0, 1], -1 and 2, and 8.5 at t = 10 and -9. The error
# grows with |t| outside [0, 1]. Those pairs were normalised by a division; pairs built as cos
# theta a + sin theta w with b not renormalised (|b|^2 - 1 up to 54 2^-53) reach 25.15 ulp in the
# acos band (theta = 0.396, t = -1.18) and 9.58 below the switch.
# [measured: scratch slgen.c / slorc.c (binary128) / mpval.py, 25,000,000 pairs, 2026-10-31; cycc 6.7.18]
# [measured: round-3 review sl/bands1.log, binary128 oracle, 300,000 pairs, 2026-10-31; cycc 6.7.18]
# ⛔ 3.4.1 — FOR d ABOVE 0.9995 THIS WAS THE NORMALISED LERP, whose angle error grows as theta^3
# (at most about theta^3 / 62 for t in [0, 1]): the audit's pair at d = 0.99975, t = 1/4, was
# 3.7e-7 off (1.7e9 ulp) against a 60-digit slerp, and on 4,000 pairs the band theta in
# [1e-5, 0.032) was up to 5.3e10 ulp off. The first 3.4.1 repair kept acos(d) up to d < 1, which
# put a spurious theta of about 2^-26 on a pair whose d rounding alone left a few ulp below 1:
# slerp(a, a, 10) came back 244 ulp off a (review S2). The atan2 form has neither defect; every
# pair with d <= 0.9995 keeps its 3.4.0 bits (50,057 of 50,057 random pairs, t extrapolating
# included). And 3.4.0 gave the zero quaternion with itself (0, 0, 0, 0) from the formula, where
# the lerp branch gives a zero interpolant NaN (REV-FB N4).
# [measured: scratch slerp_orc.py / sl3.py, Decimal slerp, 3.4.0, first repair, this tree, 2026-10-31; cycc 6.7.18]
# Cost: a pair above 0.9995 now pays the formula and the atan2, 79 -> 193 ns for the audit's
# pair (3.4.0's normalised lerp; acos's form read 174); the ordinary pair 175 -> 181 ns medians
# against the first repair, the same arithmetic behind one more branch.
# [measured: scratch fm4.bcyr, the first repair and this tree interleaved x 6, 2026-10-31; cycc 6.7.18]
#must_use
public fn hquat_slerp(a, b, t) {
    var d = hquat_dot(a, b);
    var bx = HQuat_x(b); var by = HQuat_y(b); var bz = HQuat_z(b); var bw = HQuat_w(b);
    # Shortest path: negate b if dot < 0
    if (f64_lt(d, 0) == 1) {
        bx = f64_neg(bx); by = f64_neg(by);
        bz = f64_neg(bz); bw = f64_neg(bw);
        d = f64_neg(d);
    }
    # A zero quaternion represents no rotation and has no direction to interpolate from or to:
    # NaN. Its dot with anything is a zero, so the test costs the ordinary path one compare.
    if ((d & 0x7FFF_FFFF_FFFF_FFFF) == 0) {
        if (_hquat_is_zero(a) == 1 || _hquat_is_zero(b) == 1) {
            return hquat_new(_QUAT_NAN, _QUAT_NAN, _QUAT_NAN, _QUAT_NAN);
        }
    }
    # Above d = 0.9995 theta is 2 atan2(|a - b'|, |a + b'|): each difference is one rounding, so
    # theta keeps its relative accuracy however small it is, where acos(d) reads a d that
    # rounding alone put a few ulp below 1 as an angle of about 2^-26 (3.4.1 review S2). d >= 1,
    # and |a - b'| = 0 (or below 2^-537), take the normalised lerp, as d >= 0.9995 did through
    # 3.4.0: no arc, or theta at most about 2^-26 where its error is under 2^-69 at |t| = 10.
    # d <= 0.9995 keeps the acos form, bit for bit.
    var theta = 0;
    if (f64_gt(d, _QUAT_D_HI) == 1) {
        var ux = f64_sub(HQuat_x(a), bx); var uy = f64_sub(HQuat_y(a), by);
        var uz = f64_sub(HQuat_z(a), bz); var uw = f64_sub(HQuat_w(a), bw);
        var nm = f64_sqrt(f64_add(f64_add(f64_mul(ux, ux), f64_mul(uy, uy)),
            f64_add(f64_mul(uz, uz), f64_mul(uw, uw))));
        if (f64_lt(d, F64_ONE) == 0 || f64_eq(nm, 0) == 1) {
            var omt = f64_sub(F64_ONE, t);
            # ⛔ 3.4.0 — `hquat_normalize` gave the IDENTITY for a zero interpolant. For unit a
            # and b it cannot be zero in exact arithmetic: |(1 - t) a + t b|^2 = 1 - 2 t (1 - t)
            # (1 - d) >= 1 - (1 - d) / 2 for every real t, and d >= 1 or a = b' here. A non-unit
            # pair can reach it (b = 2a at t = -1), and a NaN or infinite component cannot be
            # normalised: neither has a direction, and the answer is NaN, not a rotation. In
            # floating point an identical pair past |t| = 2^53 cancels too: t = 2^54 gives NaN
            # and t = 2^53 what the last bits left, where the answer is a.
            var lq = hquat_new(
              f64_add(f64_mul(HQuat_x(a), omt), f64_mul(bx, t)),
              f64_add(f64_mul(HQuat_y(a), omt), f64_mul(by, t)),
              f64_add(f64_mul(HQuat_z(a), omt), f64_mul(bz, t)),
              f64_add(f64_mul(HQuat_w(a), omt), f64_mul(bw, t))
              );
            if (lq == 0) { return 0; }
            var nt, nq = hquat_normalize_checked(lq);
            if (is_err_result(nt) == 1) {
                if (nq == HSB_ERR_ALLOC) { return 0; }
                return hquat_new(_QUAT_NAN, _QUAT_NAN, _QUAT_NAN, _QUAT_NAN);
            }
            return nq;
        }
        var vx = f64_add(HQuat_x(a), bx); var vy = f64_add(HQuat_y(a), by);
        var vz = f64_add(HQuat_z(a), bz); var vw = f64_add(HQuat_w(a), bw);
        var np = f64_sqrt(f64_add(f64_add(f64_mul(vx, vx), f64_mul(vy, vy)),
            f64_add(f64_mul(vz, vz), f64_mul(vw, vw))));
        theta = f64_mul(F64_TWO, ganita_f64_atan2(nm, np));
    } else {
        theta = ganita_f64_acos(d);
    }
    var sin_theta = f64_sin(theta);
    var inv_sin = f64_div(F64_ONE, sin_theta);
    var s0 = f64_mul(f64_sin(f64_mul(f64_sub(F64_ONE, t), theta)), inv_sin);
    var s1 = f64_mul(f64_sin(f64_mul(t, theta)), inv_sin);
    return hquat_new(
      f64_add(f64_mul(HQuat_x(a), s0), f64_mul(bx, s1)),
      f64_add(f64_mul(HQuat_y(a), s0), f64_mul(by, s1)),
      f64_add(f64_mul(HQuat_z(a), s0), f64_mul(bz, s1)),
      f64_add(f64_mul(HQuat_w(a), s0), f64_mul(bw, s1))
      );
}
