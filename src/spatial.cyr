# spatial.cyr -- spatial data structures: KdTree, Quadtree, Octree, SpatialHash
# Usage: include "lib/spatial.cyr"
# Requires: alloc.cyr, math.cyr, vec3.cyr, vec.cyr, geo.cyr, error.cyr
#
# Ported from hisab rust-old/src/geo/spatial.rs
#
# Conventions:
#   - All f64 values are IEEE 754 bit patterns (same as rest of hisab)
#   - Functions returning 1/0 indicate true/false
#   - Pointers to nodes are heap-allocated via alloc/store64/load64
#   - Results returned as vec (dynamic array from vec.cyr)

# ================================================================
# Local constants
# ================================================================

var _SP_F64_POS_INF = 0x7FF0_0000_0000_0000;  # +Infinity
var _SP_QUADTREE_MAX_PER_NODE = 8;             # items before split

# Hard ceiling on quadtree_new / octree_new's `max_depth`, and therefore on
# _qt_insert_rec / _ot_insert_rec's recursion depth. 2026-08-04 audit,
# memory-safety: the caller's max_depth was stored verbatim, and coincident points
# always route into the same child, so a split chain runs the FULL depth on every
# insert past the node capacity. Nothing bounded it. Measured on this machine
# (ulimit -s 8192, i.e. an 8 MiB stack), 64 coincident points into one tree:
#
#   quadtree  max_depth 23,750 -> exit 0     max_depth 23,906 -> SIGSEGV (139)
#   octree    max_depth 20,000 -> exit 0     max_depth 30,000 -> SIGSEGV (139)
#
# and the arena, which is a bump allocator that never frees, grows linearly with
# the depth reached: 1,216 B per level (quadtree) and 6,144 B per level (octree),
# measured via alloc_used() -- 24.3 MB and 123 MB respectively at max_depth 20,000.
#
# The cap is 1075 because that is where subdivision stops being able to do
# anything, not a round number picked for safety margin. A split separates two
# coordinates only while the cell is still wider than the gap between them, so the
# deepest USEFUL depth in a unit root box is set by f64's own resolution. Measured
# (max leaf depth reached, root box [0,1]^2):
#
#   two coordinates 1 ULP apart at 0.5   -> depth 53
#   0 vs the smallest positive denormal  -> depth 1074   <- the extreme
#   0 vs 1e-100                          -> depth 333
#   identical coordinates                -> runs to max_depth, forever
#
# So 1075 keeps every separation f64 can express and truncates only the case where
# no depth would ever have helped. At the cap the pathological chain costs a
# BOUNDED 1.31 MB (quadtree) / 6.61 MB (octree) of arena and roughly 378 KB of
# stack -- 22x under the 8 MiB limit, versus a SIGSEGV before this cap existed.
# Capping degrades nothing to incorrect: an over-full leaf is still queried by
# linear scan, so a truncated tree returns the same points, more slowly.
var _SP_MAX_TREE_DEPTH = 1075;

# ================================================================
# 1. KdTree -- k-d tree for 3D point queries
# ================================================================
#
# Node layout (40 bytes):
#   offset  0: point_idx  (i64) -- index into caller's point array (-1 for split)
#   offset  8: split_axis (i64) -- 0=x, 1=y, 2=z
#   offset 16: split_val  (f64) -- split plane value
#   offset 24: left       (ptr) -- left child (or 0 for leaf)
#   offset 32: right      (ptr) -- right child (or 0 for leaf)
#
# Leaf nodes: point_idx >= 0, left = 0, right = 0
# Split nodes: point_idx = -1, left/right point to children

fn _kd_node_alloc(point_idx, split_axis, split_val, left, right) {
    var n = alloc(40);
    store64(n, point_idx);
    store64(n + 8, split_axis);
    store64(n + 16, split_val);
    store64(n + 24, left);
    store64(n + 32, right);
    return n;
}

fn _kd_node_point_idx(n) { return load64(n); }
fn _kd_node_split_axis(n) { return load64(n + 8); }
fn _kd_node_split_val(n) { return load64(n + 16); }
fn _kd_node_left(n) { return load64(n + 24); }
fn _kd_node_right(n) { return load64(n + 32); }

# Get component of HVec3 by axis index (0=x, 1=y, 2=z)
fn _kd_axis_val(point, axis) {
    if (axis == 0) { return HVec3_x(point); }
    if (axis == 1) { return HVec3_y(point); }
    return HVec3_z(point);
}

# --- Median-of-three partitioning ---
# Partition items[start..end) around median on given axis.
# items_vec: vec of interleaved [point_ptr, index, point_ptr, index, ...]
# Returns the median position (pair index).
# Axis value of the item sitting at position i of the index vec.
fn _kd_item_val(items, points, i, axis) {
    return _kd_axis_val(load64(points + vec_get(items, i) * 8), axis);
}

fn _kd_swap(items, a, b) {
    var tmp = vec_get(items, a);
    vec_set(items, a, vec_get(items, b));
    vec_set(items, b, tmp);
}

# --- Exact median selection (quickselect / nth-element) ---
# Reorders items[start..end) so that items[target] holds the median BY AXIS VALUE,
# every element before it compares <= it and every element after compares >= it.
# That is exactly the invariant _kd_nearest_rec's plane test needs, and it is
# distribution-free: O(n) expected per level instead of O(n * halvings).
#
# The middle band of the three-way (Dutch-flag) partition is load-bearing: a
# two-way split would push every element EQUAL to the pivot onto one side and
# reproduce the 2.6.14 one-element-per-level degeneracy on coincident input.
fn _kd_select_median(items, points, start, end, axis) {
    var target = start + (end - start) / 2;
    var lo = start;
    var hi = end;

    while (hi - lo > 1) {
        # Median-of-three pivot, so sorted and reverse-sorted ranges are best
        # case rather than worst case.
        var mid = lo + (hi - lo) / 2;
        var a = _kd_item_val(items, points, lo, axis);
        var b = _kd_item_val(items, points, mid, axis);
        var c = _kd_item_val(items, points, hi - 1, axis);
        var pivot = b;
        if (f64_lt(a, b) == 1) {
            if (f64_lt(b, c) == 1) { pivot = b; }
            elif (f64_lt(a, c) == 1) { pivot = c; }
            else { pivot = a; }
        } else {
            if (f64_lt(a, c) == 1) { pivot = a; }
            elif (f64_lt(b, c) == 1) { pivot = c; }
            else { pivot = b; }
        }

        # [lo, lt) < pivot | [lt, gt) == pivot | [gt, hi) > pivot.
        # NaN compares false both ways and lands in the equal band, so a NaN
        # coordinate cannot spin this loop.
        var lt = lo;
        var eq = lo;
        var gt = hi;
        while (eq < gt) {
            var v = _kd_item_val(items, points, eq, axis);
            if (f64_lt(v, pivot) == 1) {
                _kd_swap(items, lt, eq);
                lt = lt + 1;
                eq = eq + 1;
            } elif (f64_gt(v, pivot) == 1) {
                gt = gt - 1;
                _kd_swap(items, eq, gt);
            } else {
                eq = eq + 1;
            }
        }

        # The equal band is never empty (the pivot is a real element), so both
        # branches strictly shrink [lo, hi) and the loop always terminates.
        if (target < lt) { hi = lt; }
        elif (target < gt) { lo = target; hi = target + 1; }
        else { lo = gt; }
    }

    return target;
}

# out_plane receives the axis value that SEPARATES the two partitions. The caller
# must store that as the node's split_val -- not the axis value of items[split].
#
# Through 2.7.0 the caller read items[split] instead, i.e. SOME right-side value
# rather than the plane. Every right-side point whose axis value is below that
# one then sits on the wrong side of the node's own pruning plane, so
# _kd_nearest_rec / _kd_radius_rec prune a subtree that still contains valid
# hits. Measured on a 1,500-point scatter with 400 radius-60 queries: 274 of 400
# returned the WRONG COUNT. The plane is the invariant; the value of any
# particular item is not.
fn _kd_partition(items, points, start, end, axis, out_plane) {
    # CHEAP PATH FIRST, exact median only when it degenerates.
    #
    # The value-midpoint split is O(n) with a tiny constant and splits uniform
    # data almost perfectly. Its weakness is distribution-sensitivity: on
    # geometrically-spaced coordinates each level halves the value RANGE rather
    # than the element COUNT, so depth becomes O(n * log(range / min_gap)).
    #
    # Quickselect is distribution-free but ~2x the constant -- measured
    # kdtree_build_4k 2.27 ms -> 4.85 ms when used unconditionally. Paying that on
    # every build to fix a case most inputs never hit is the wrong trade, so the
    # midpoint runs first and selection is the FALLBACK, taken only when the
    # midpoint produced a badly unbalanced split.
    var count = end - start;
    var lo = _SP_F64_POS_INF;
    var hi = f64_neg(_SP_F64_POS_INF);
    for (var pi = start; pi < end; pi = pi + 1) {
        var v = _kd_item_val(items, points, pi, axis);
        if (f64_lt(v, lo) == 1) { lo = v; }
        if (f64_gt(v, hi) == 1) { hi = v; }
    }

    # All points share this axis value: any split is sound and the plane is the
    # common value. This is the 2.6.14 coincident-point fix, preserved.
    if (f64_eq(lo, hi) == 1) {
        store64(out_plane, lo);
        return start + count / 2;
    }

    var mid_val = f64_mul(f64_add(lo, hi), F64_HALF);
    var split = start;
    for (var qi = start; qi < end; qi = qi + 1) {
        if (f64_lt(_kd_item_val(items, points, qi, axis), mid_val) == 1) {
            _kd_swap(items, split, qi);
            split = split + 1;
        }
    }

    # Balanced enough? Require each side to hold at least a quarter of the range.
    # That bounds depth at log_(4/3)(n) -- ~24 levels at n = 1e6 -- while letting
    # the overwhelmingly common near-even split through untouched.
    var quarter = count / 4;
    if (quarter < 1) { quarter = 1; }
    if (split - start >= quarter && end - split >= quarter) {
        store64(out_plane, mid_val);
        return split;
    }

    # Degenerate: fall back to the exact median. Its post-condition is the plane
    # invariant directly -- everything before target compares <= items[target],
    # everything after compares >= -- so the plane is items[target]'s own value.
    var msplit = _kd_select_median(items, points, start, end, axis);
    store64(out_plane, _kd_item_val(items, points, msplit, axis));
    return msplit;
}

# Build k-d tree recursively.
# items: vec of point indices, points: array of HVec3 pointers
# plane_out: an 8-byte scratch slot owned by kdtree_build, SHARED by every node
#            in the recursion. It was `var plane_out = alloc(8);` here -- one
#            8-byte allocation per internal node, in a bump allocator that never
#            frees (2026-08-04 audit, performance). Sharing one slot is safe
#            because the value is consumed on the very next line, before either
#            child call can overwrite it. Measured over kdtree_build on 4,096
#            random points: 425,832 B of arena before, 393,080 B after (-32,752 B
#            = 8 B x 4,094 internal nodes, -7.7%).
fn _kd_build_rec(items, points, start, end, depth, plane_out) {
    var count = end - start;
    if (count == 1) {
        var idx = vec_get(items, start);
        return _kd_node_alloc(idx, 0, 0, 0, 0);
    }

    var axis = depth % 3;
    var split = _kd_partition(items, points, start, end, axis, plane_out);

    # The PLANE, not the axis value of any particular item -- see _kd_partition.
    # Read BEFORE recursing: the children reuse this same slot.
    var split_val = load64(plane_out);

    var left = _kd_build_rec(items, points, start, split, depth + 1, plane_out);
    var right = _kd_build_rec(items, points, split, end, depth + 1, plane_out);

    return _kd_node_alloc(0 - 1, axis, split_val, left, right);
}

# Build a k-d tree from an array of HVec3 pointers.
# points: pointer to array of HVec3 ptrs (points[i] = load64(points + i*8))
# count: number of points (must be >= 0; a negative count is rejected)
# Returns: root node pointer, or 0 for an empty / rejected input. This routine
#          returns a HANDLE, not an error code, so 0 -- the documented empty
#          tree -- is the failure value; there is no negative HSB_ERR_* to
#          return through an i64 that is otherwise a pointer.
fn kdtree_build(points, count) {
    # `count == 0` was a HALF-GUARD. A negative count fell through to
    # _kd_build_rec(items, points, 0, -1), whose `count = end - start` is -1, so
    # it missed the `count == 1` leaf case and ran _kd_partition over an empty
    # vec -- _kd_select_median then vec_get'd an out-of-range slot and vec's own
    # bounds check aborted the process ("vec: index out of bounds", exit 1,
    # measured). points == 0 is the same story one level down: load64(0 + i * 8).
    if (count <= 0) { return 0; }
    if (points == 0) { return 0; }

    # Build index list
    var items = vec_new();
    for (var i = 0; i < count; i = i + 1) {
        vec_push(items, i);
    }

    # One shared split-plane slot for the whole recursion; see _kd_build_rec.
    var plane_out = alloc(8);
    if (plane_out == 0) { return 0; }

    return _kd_build_rec(items, points, 0, count, 0, plane_out);
}

# --- Nearest neighbor search ---
# best_out: pointer to 16-byte block { best_idx (i64), best_dist_sq (f64) }

fn _kd_nearest_rec(node, points, query, best_out) {
    if (node == 0) { return 0; }

    var pidx = _kd_node_point_idx(node);

    if (pidx >= 0) {
        # Leaf node
        var pt = load64(points + pidx * 8);
        var diff = hvec3_sub(pt, query);
        var dist_sq = hvec3_dot(diff, diff);
        if (f64_lt(dist_sq, load64(best_out + 8)) == 1) {
            store64(best_out, pidx);
            store64(best_out + 8, dist_sq);
        }
        return 0;
    }

    # Split node
    var axis = _kd_node_split_axis(node);
    var split_val = _kd_node_split_val(node);
    var query_val = _kd_axis_val(query, axis);
    var d = f64_sub(query_val, split_val);

    # Visit closer side first
    var near = 0;
    var far = 0;
    if (f64_lt(d, 0) == 1) {
        near = _kd_node_left(node);
        far = _kd_node_right(node);
    } else {
        near = _kd_node_right(node);
        far = _kd_node_left(node);
    }

    _kd_nearest_rec(near, points, query, best_out);

    # Only visit far side if splitting plane is closer than current best
    var d_sq = f64_mul(d, d);
    if (f64_lt(d_sq, load64(best_out + 8)) == 1) {
        _kd_nearest_rec(far, points, query, best_out);
    }

    return 0;
}

# Find nearest neighbor to query point.
# Returns index of nearest point, or -1 if tree is empty.
fn kdtree_nearest(root, points, query) {
    if (root == 0) { return 0 - 1; }

    var best_out = alloc(16);
    store64(best_out, 0 - 1);          # best_idx
    store64(best_out + 8, _SP_F64_POS_INF);  # best_dist_sq

    _kd_nearest_rec(root, points, query, best_out);

    return load64(best_out);
}

# --- Radius search ---

fn _kd_radius_rec(node, points, query, radius_sq, results) {
    if (node == 0) { return 0; }

    var pidx = _kd_node_point_idx(node);

    if (pidx >= 0) {
        # Leaf node
        var pt = load64(points + pidx * 8);
        var diff = hvec3_sub(pt, query);
        var dist_sq = hvec3_dot(diff, diff);
        if (f64_le(dist_sq, radius_sq) == 1) {
            vec_push(results, pidx);
        }
        return 0;
    }

    # Split node
    var axis = _kd_node_split_axis(node);
    var split_val = _kd_node_split_val(node);
    var query_val = _kd_axis_val(query, axis);
    var d = f64_sub(query_val, split_val);

    var near = 0;
    var far = 0;
    if (f64_lt(d, 0) == 1) {
        near = _kd_node_left(node);
        far = _kd_node_right(node);
    } else {
        near = _kd_node_right(node);
        far = _kd_node_left(node);
    }

    _kd_radius_rec(near, points, query, radius_sq, results);

    var d_sq = f64_mul(d, d);
    if (f64_le(d_sq, radius_sq) == 1) {
        _kd_radius_rec(far, points, query, radius_sq, results);
    }

    return 0;
}

# Find all points within radius of query.
# Returns vec of point indices.
fn kdtree_within_radius(root, points, query, radius) {
    var results = vec_new();
    if (root == 0) { return results; }

    var radius_sq = f64_mul(radius, radius);
    _kd_radius_rec(root, points, query, radius_sq, results);

    return results;
}

# ================================================================
# 2. Quadtree -- 2D spatial subdivision
# ================================================================
#
# Bounds layout (32 bytes):
#   offset  0: x_min (f64)
#   offset  8: y_min (f64)
#   offset 16: x_max (f64)
#   offset 24: y_max (f64)
#
# Node layout (56 bytes):
#   offset  0: bounds   (ptr) -- pointer to bounds
#   offset  8: points   (ptr) -- vec of interleaved [x, y, data, x, y, data, ...]
#   offset 16: child_0  (ptr) -- NW child (0 if not split)
#   offset 24: child_1  (ptr) -- NE child
#   offset 32: child_2  (ptr) -- SW child
#   offset 40: child_3  (ptr) -- SE child
#   offset 48: depth    (i64)

fn _qt_bounds_new(x_min, y_min, x_max, y_max) {
    var b = alloc(32);
    store64(b, x_min);
    store64(b + 8, y_min);
    store64(b + 16, x_max);
    store64(b + 24, y_max);
    return b;
}

fn _qt_bounds_xmin(b) { return load64(b); }
fn _qt_bounds_ymin(b) { return load64(b + 8); }
fn _qt_bounds_xmax(b) { return load64(b + 16); }
fn _qt_bounds_ymax(b) { return load64(b + 24); }

fn _qt_bounds_cx(b) { return f64_mul(f64_add(load64(b), load64(b + 16)), F64_HALF); }
fn _qt_bounds_cy(b) { return f64_mul(f64_add(load64(b + 8), load64(b + 24)), F64_HALF); }

fn _qt_bounds_contains(b, x, y) {
    if (f64_lt(x, load64(b)) == 1) { return 0; }
    if (f64_gt(x, load64(b + 16)) == 1) { return 0; }
    if (f64_lt(y, load64(b + 8)) == 1) { return 0; }
    if (f64_gt(y, load64(b + 24)) == 1) { return 0; }
    return 1;
}

fn _qt_bounds_overlaps(a, b) {
    if (f64_gt(load64(a), load64(b + 16)) == 1) { return 0; }       # a.xmin > b.xmax
    if (f64_gt(load64(b), load64(a + 16)) == 1) { return 0; }       # b.xmin > a.xmax
    if (f64_gt(load64(a + 8), load64(b + 24)) == 1) { return 0; }   # a.ymin > b.ymax
    if (f64_gt(load64(b + 8), load64(a + 24)) == 1) { return 0; }   # b.ymin > a.ymax
    return 1;
}

fn _qt_node_new(bounds, depth) {
    var n = alloc(56);
    store64(n, bounds);
    store64(n + 8, vec_new());   # points vec (interleaved x, y, data)
    store64(n + 16, 0);          # child_0 NW
    store64(n + 24, 0);          # child_1 NE
    store64(n + 32, 0);          # child_2 SW
    store64(n + 40, 0);          # child_3 SE
    store64(n + 48, depth);
    return n;
}

fn _qt_node_bounds(n) { return load64(n); }
fn _qt_node_points(n) { return load64(n + 8); }
fn _qt_node_child(n, i) { return load64(n + 16 + i * 8); }
fn _qt_node_depth(n) { return load64(n + 48); }
fn _qt_node_set_child(n, i, c) { store64(n + 16 + i * 8, c); return 0; }
fn _qt_node_is_split(n) { if (load64(n + 16) != 0) { return 1; } return 0; }

# Determine quadrant: NW=0, NE=1, SW=2, SE=3
fn _qt_quadrant(x, y, cx, cy) {
    var qx = 0;
    if (f64_ge(x, cx) == 1) { qx = 1; }
    var qy = 0;
    if (f64_lt(y, cy) == 1) { qy = 2; }
    return qx + qy;
}

# Get child bounds for a quadrant
fn _qt_child_bounds(parent_bounds, quadrant) {
    var xmin = _qt_bounds_xmin(parent_bounds);
    var ymin = _qt_bounds_ymin(parent_bounds);
    var xmax = _qt_bounds_xmax(parent_bounds);
    var ymax = _qt_bounds_ymax(parent_bounds);
    var cx = _qt_bounds_cx(parent_bounds);
    var cy = _qt_bounds_cy(parent_bounds);

    # NW=0: (xmin,cy) to (cx,ymax)
    if (quadrant == 0) { return _qt_bounds_new(xmin, cy, cx, ymax); }
    # NE=1: (cx,cy) to (xmax,ymax)
    if (quadrant == 1) { return _qt_bounds_new(cx, cy, xmax, ymax); }
    # SW=2: (xmin,ymin) to (cx,cy)
    if (quadrant == 2) { return _qt_bounds_new(xmin, ymin, cx, cy); }
    # SE=3: (cx,ymin) to (xmax,cy)
    return _qt_bounds_new(cx, ymin, xmax, cy);
}

# Split a leaf node into 4 children, redistributing existing points
fn _qt_split(node, max_depth) {
    var bounds = _qt_node_bounds(node);
    var pts = _qt_node_points(node);
    var depth = _qt_node_depth(node);

    # Create children
    for (var ci = 0; ci < 4; ci = ci + 1) {
        var cb = _qt_child_bounds(bounds, ci);
        _qt_node_set_child(node, ci, _qt_node_new(cb, depth + 1));
    }

    # Redistribute existing points
    var cx = _qt_bounds_cx(bounds);
    var cy = _qt_bounds_cy(bounds);
    var count = vec_len(pts) / 3;  # 3 entries per point: x, y, data
    for (var pi = 0; pi < count; pi = pi + 1) {
        var px = vec_get(pts, pi * 3);
        var py = vec_get(pts, pi * 3 + 1);
        var pd = vec_get(pts, pi * 3 + 2);
        var q = _qt_quadrant(px, py, cx, cy);
        var child = _qt_node_child(node, q);
        _qt_insert_rec(child, px, py, pd, max_depth);
    }

    # Clear the points vec (node is now a split node, points live in children)
    # We leave the vec allocated but reset its length
    store64(pts + 8, 0);

    return 0;
}

fn _qt_insert_rec(node, x, y, data, max_depth) {
    if (_qt_node_is_split(node) == 1) {
        # Route to correct child
        var bounds = _qt_node_bounds(node);
        var cx = _qt_bounds_cx(bounds);
        var cy = _qt_bounds_cy(bounds);
        var q = _qt_quadrant(x, y, cx, cy);
        var child = _qt_node_child(node, q);
        return _qt_insert_rec(child, x, y, data, max_depth);
    }

    # Leaf node: add point
    var pts = _qt_node_points(node);
    vec_push(pts, x);
    vec_push(pts, y);
    vec_push(pts, data);

    var count = vec_len(pts) / 3;
    var depth = _qt_node_depth(node);

    # Split if over capacity and below max depth
    if (count > _SP_QUADTREE_MAX_PER_NODE) {
        if (depth < max_depth) {
            _qt_split(node, max_depth);
        }
    }

    return 0;
}

# Create an empty quadtree.
# x_min, y_min, x_max, y_max: bounds (f64)
# max_depth: maximum subdivision depth (integer), CLAMPED to
#            [0, _SP_MAX_TREE_DEPTH]. See that constant for the measured reason.
# Returns: root node pointer
fn quadtree_new(x_min, y_min, x_max, y_max, max_depth) {
    # Clamp before storing: this value is the ONLY bound on _qt_insert_rec's
    # recursion, and a coincident-point insert runs the whole of it.
    # A negative max_depth already meant "never split" (`depth < max_depth` is
    # false at depth 0), so clamping it to 0 is the same behaviour written down.
    if (max_depth < 0) { max_depth = 0; }
    if (max_depth > _SP_MAX_TREE_DEPTH) { max_depth = _SP_MAX_TREE_DEPTH; }

    # Wrap in a handle: { root_node, max_depth, count }
    var qt = alloc(24);
    var bounds = _qt_bounds_new(x_min, y_min, x_max, y_max);
    store64(qt, _qt_node_new(bounds, 0));
    store64(qt + 8, max_depth);
    store64(qt + 16, 0);  # count
    return qt;
}

# Insert a point with associated data (i64) into the quadtree.
# Returns: HSB_ERR_NONE (0) when the point was stored,
#          HSB_ERR_OUT_OF_RANGE (-3) when it lies outside the root bounds and was
#          dropped. The point is NOT stored in that case and `count` does not move.
#
# BREAKING at 2.8.5. This returned 1 for "stored" and 0 for "dropped" -- inverted
# against the project's 0-is-success / negative-is-failure convention, and against
# its own sibling `spatial_hash_insert`, which has always returned 0 on success.
# Three sibling inserts, two conventions (2026-08-04 audit, api-consistency).
# `spatial_hash_insert` was the one that already matched the rest of the library,
# so quadtree_insert and octree_insert moved to it rather than the other way round.
# A caller written against the old convention must change `if (rc == 1)` to
# `if (rc == HSB_ERR_NONE)`; a caller that IGNORED the return is unaffected, which
# is every call site in src/ (there are none) and every one in tests/ that was not
# asserting on it.
fn quadtree_insert(qt, x, y, data) {
    var root = load64(qt);
    var max_depth = load64(qt + 8);
    var bounds = _qt_node_bounds(root);

    # Ignore out-of-bounds points
    if (_qt_bounds_contains(bounds, x, y) == 0) { return HSB_ERR_OUT_OF_RANGE; }

    _qt_insert_rec(root, x, y, data, max_depth);
    store64(qt + 16, load64(qt + 16) + 1);
    return HSB_ERR_NONE;
}

# --- Quadtree range query ---

fn _qt_query_rec(node, query_bounds, results) {
    if (node == 0) { return 0; }

    var bounds = _qt_node_bounds(node);
    if (_qt_bounds_overlaps(bounds, query_bounds) == 0) { return 0; }

    if (_qt_node_is_split(node) == 1) {
        for (var ci = 0; ci < 4; ci = ci + 1) {
            _qt_query_rec(_qt_node_child(node, ci), query_bounds, results);
        }
        return 0;
    }

    # Leaf node: check each point
    var pts = _qt_node_points(node);
    var count = vec_len(pts) / 3;
    for (var pi = 0; pi < count; pi = pi + 1) {
        var px = vec_get(pts, pi * 3);
        var py = vec_get(pts, pi * 3 + 1);
        var pd = vec_get(pts, pi * 3 + 2);
        if (_qt_bounds_contains(query_bounds, px, py) == 1) {
            vec_push(results, pd);
        }
    }
    return 0;
}

# Query all data values within the given rectangle.
# Returns vec of data (i64) values.
fn quadtree_query(qt, qx_min, qy_min, qx_max, qy_max) {
    var results = vec_new();
    var root = load64(qt);
    var query_bounds = _qt_bounds_new(qx_min, qy_min, qx_max, qy_max);
    _qt_query_rec(root, query_bounds, results);
    return results;
}

# ================================================================
# 3. Octree -- 3D spatial subdivision
# ================================================================
#
# Node layout (88 bytes):
#   offset  0: bounds   (ptr) -- GeoAabb pointer (min, max HVec3)
#   offset  8: points   (ptr) -- vec of interleaved [point_ptr, data, ...]
#   offset 16: child_0..child_7 (8 ptrs, 64 bytes)
#   offset 80: depth    (i64)
#
# Max items per leaf before split: 8 (same as quadtree)

var _OT_MAX_PER_NODE = 8;

fn _ot_node_new(bounds, depth) {
    var n = alloc(88);
    store64(n, bounds);
    store64(n + 8, vec_new());   # points vec (interleaved point_ptr, data)
    for (var ci = 0; ci < 8; ci = ci + 1) {
        store64(n + 16 + ci * 8, 0);
    }
    store64(n + 80, depth);
    return n;
}

fn _ot_node_bounds(n) { return load64(n); }
fn _ot_node_points(n) { return load64(n + 8); }
fn _ot_node_child(n, i) { return load64(n + 16 + i * 8); }
fn _ot_node_depth(n) { return load64(n + 80); }
fn _ot_node_set_child(n, i, c) { store64(n + 16 + i * 8, c); return 0; }
fn _ot_node_is_split(n) { if (load64(n + 16) != 0) { return 1; } return 0; }

# AABB contains point check
fn _ot_aabb_contains(aabb, point) {
    var mn = GeoAabb_min(aabb);
    var mx = GeoAabb_max(aabb);
    if (f64_lt(HVec3_x(point), HVec3_x(mn)) == 1) { return 0; }
    if (f64_gt(HVec3_x(point), HVec3_x(mx)) == 1) { return 0; }
    if (f64_lt(HVec3_y(point), HVec3_y(mn)) == 1) { return 0; }
    if (f64_gt(HVec3_y(point), HVec3_y(mx)) == 1) { return 0; }
    if (f64_lt(HVec3_z(point), HVec3_z(mn)) == 1) { return 0; }
    if (f64_gt(HVec3_z(point), HVec3_z(mx)) == 1) { return 0; }
    return 1;
}

# Determine octant: x bit=1, y bit=2, z bit=4
fn _ot_octant(point, center) {
    var ox = 0;
    if (f64_ge(HVec3_x(point), HVec3_x(center)) == 1) { ox = 1; }
    var oy = 0;
    if (f64_ge(HVec3_y(point), HVec3_y(center)) == 1) { oy = 2; }
    var oz = 0;
    if (f64_ge(HVec3_z(point), HVec3_z(center)) == 1) { oz = 4; }
    return ox + oy + oz;
}

# Get child bounds for an octant
fn _ot_child_bounds(parent_aabb, octant) {
    var mn = GeoAabb_min(parent_aabb);
    var mx = GeoAabb_max(parent_aabb);
    var center = geo_aabb_center(parent_aabb);

    var cx = HVec3_x(center);
    var cy = HVec3_y(center);
    var cz = HVec3_z(center);
    var mnx = HVec3_x(mn);
    var mny = HVec3_y(mn);
    var mnz = HVec3_z(mn);
    var mxx = HVec3_x(mx);
    var mxy = HVec3_y(mx);
    var mxz = HVec3_z(mx);

    # Select min/max for each axis based on octant bits
    var new_mnx = mnx;
    var new_mxx = cx;
    if ((octant & 1) != 0) { new_mnx = cx; new_mxx = mxx; }

    var new_mny = mny;
    var new_mxy = cy;
    if ((octant & 2) != 0) { new_mny = cy; new_mxy = mxy; }

    var new_mnz = mnz;
    var new_mxz = cz;
    if ((octant & 4) != 0) { new_mnz = cz; new_mxz = mxz; }

    return geo_aabb_new(hvec3_new(new_mnx, new_mny, new_mnz),
    hvec3_new(new_mxx, new_mxy, new_mxz));
}

# Split an octree leaf node into 8 children
fn _ot_split(node, max_depth) {
    var bounds = _ot_node_bounds(node);
    var pts = _ot_node_points(node);
    var depth = _ot_node_depth(node);
    var center = geo_aabb_center(bounds);

    # Create children
    for (var ci = 0; ci < 8; ci = ci + 1) {
        var cb = _ot_child_bounds(bounds, ci);
        _ot_node_set_child(node, ci, _ot_node_new(cb, depth + 1));
    }

    # Redistribute existing points (interleaved: point_ptr, data)
    var count = vec_len(pts) / 2;
    for (var pi = 0; pi < count; pi = pi + 1) {
        var pt = vec_get(pts, pi * 2);
        var pd = vec_get(pts, pi * 2 + 1);
        var oct = _ot_octant(pt, center);
        var child = _ot_node_child(node, oct);
        _ot_insert_rec(child, pt, pd, max_depth);
    }

    # Clear points (they now live in children)
    store64(pts + 8, 0);

    return 0;
}

fn _ot_insert_rec(node, point, data, max_depth) {
    if (_ot_node_is_split(node) == 1) {
        var bounds = _ot_node_bounds(node);
        var center = geo_aabb_center(bounds);
        var oct = _ot_octant(point, center);
        var child = _ot_node_child(node, oct);
        return _ot_insert_rec(child, point, data, max_depth);
    }

    # Leaf node: add point
    var pts = _ot_node_points(node);
    vec_push(pts, point);
    vec_push(pts, data);

    var count = vec_len(pts) / 2;
    var depth = _ot_node_depth(node);

    if (count > _OT_MAX_PER_NODE) {
        if (depth < max_depth) {
            _ot_split(node, max_depth);
        }
    }

    return 0;
}

# Create an empty octree.
# min_vec3, max_vec3: bounding box corners (HVec3 pointers)
# max_depth: maximum subdivision depth (integer), CLAMPED to
#            [0, _SP_MAX_TREE_DEPTH]. See that constant for the measured reason;
#            the octree is the worse of the two, at 6,144 B of never-freed arena
#            per level of a coincident-point split chain.
# Returns: octree handle pointer
fn octree_new(min_vec3, max_vec3, max_depth) {
    if (max_depth < 0) { max_depth = 0; }
    if (max_depth > _SP_MAX_TREE_DEPTH) { max_depth = _SP_MAX_TREE_DEPTH; }

    var ot = alloc(24);
    var bounds = geo_aabb_new(min_vec3, max_vec3);
    store64(ot, _ot_node_new(bounds, 0));
    store64(ot + 8, max_depth);
    store64(ot + 16, 0);  # count
    return ot;
}

# Insert a point with associated data (i64) into the octree.
# point: HVec3 pointer
# Returns: HSB_ERR_NONE (0) when the point was stored,
#          HSB_ERR_OUT_OF_RANGE (-3) when it lies outside the root bounds and was
#          dropped. BREAKING at 2.8.5 -- see quadtree_insert for the full note;
#          this returned 1 / 0 and now returns 0 / -3.
fn octree_insert(ot, point, data) {
    var root = load64(ot);
    var max_depth = load64(ot + 8);
    var bounds = _ot_node_bounds(root);

    if (_ot_aabb_contains(bounds, point) == 0) { return HSB_ERR_OUT_OF_RANGE; }

    _ot_insert_rec(root, point, data, max_depth);
    store64(ot + 16, load64(ot + 16) + 1);
    return HSB_ERR_NONE;
}

# --- Octree range query ---

fn _ot_query_rec(node, query_aabb, results) {
    if (node == 0) { return 0; }

    var bounds = _ot_node_bounds(node);
    if (geo_aabb_aabb(bounds, query_aabb) == 0) { return 0; }

    if (_ot_node_is_split(node) == 1) {
        for (var ci = 0; ci < 8; ci = ci + 1) {
            _ot_query_rec(_ot_node_child(node, ci), query_aabb, results);
        }
        return 0;
    }

    # Leaf node: check each point
    var pts = _ot_node_points(node);
    var count = vec_len(pts) / 2;
    for (var pi = 0; pi < count; pi = pi + 1) {
        var pt = vec_get(pts, pi * 2);
        var pd = vec_get(pts, pi * 2 + 1);
        if (_ot_aabb_contains(query_aabb, pt) == 1) {
            vec_push(results, pd);
        }
    }
    return 0;
}

# Query all data values within the given AABB.
# min_vec3, max_vec3: query box corners (HVec3 pointers)
# Returns vec of data (i64) values.
fn octree_query(ot, min_vec3, max_vec3) {
    var results = vec_new();
    var root = load64(ot);
    var query_aabb = geo_aabb_new(min_vec3, max_vec3);
    _ot_query_rec(root, query_aabb, results);
    return results;
}

# ================================================================
# 4. SpatialHash -- uniform grid for fast neighbor queries
# ================================================================
#
# Handle layout (48 bytes):
#   offset  0: cell_size     (f64)
#   offset  8: inv_cell_size (f64) -- 1.0 / cell_size
#   offset 16: buckets       (ptr) -- one i64 chain head per bucket, -1 = empty
#   offset 24: bucket_count  (i64) -- a power of two, and it GROWS
#   offset 32: entries       (vec) -- flat [ix, iy, iz, data, next] records
#   offset 40: occupied      (i64) -- number of non-empty buckets
#
# Hashing: cell coords (ix, iy, iz) are hashed and masked to a bucket index.
# Several cells can share a bucket, so every entry carries its own (ix, iy,
# iz) and the query filters on an exact cell match.
#
# GROWING BUCKET COUNT (2.8.3). Through 2.8.2 the bucket count was the
# literal 1024, masked by a hard-coded `& 1023`, and never grew. With n
# points the average chain is n/1024, so query_cell -- the O(1) primitive
# this structure exists to provide -- actually cost Theta(n/1024). Measured
# over 5,000 queries on uniform points at ~1 point per cell:
# 1.48 / 1.62 / 2.07 / 2.82 / 4.19 / 7.17 ms at n = 2k..64k, a growth ratio
# climbing to 1.71x per doubling and still rising. The table now doubles
# whenever the OCCUPIED bucket count passes 3/4 of the bucket count.
#
# Why *occupied* buckets and not entry count: every entry in one cell hashes
# to one bucket however large the table is, so an entry-count load factor
# would double the table forever on coincident input (1M coincident points
# -> a 32 MB bucket array that removes not one comparison). The occupied
# count for that input is 1, so the table correctly stays at its initial
# size and the chain walk stays exactly as long as it has to be.
#
# Storage is one flat entry vec plus a chain head per bucket, rather than a
# vec per bucket: an empty vec still costs 152 bytes, so a vec-per-bucket
# table cannot be grown at all (2^20 buckets = 159 MB of empty vecs,
# re-allocated on every rehash).
#
# Chains are built by PREPENDING, so the `next` link is known at push time
# and insert needs no write-back into an earlier entry. A chain therefore
# walks newest-first, and each query reverses its own run of matches before
# returning -- so results still come back in INSERTION ORDER, exactly as the
# vec-per-bucket version returned them.

var _SH_INIT_BUCKETS = 1024;
var _SH_ENTRY_SIZE = 5;   # ix, iy, iz, data, next
var _SH_MAX_BUCKETS = 0x400000;  # 4,194,304 buckets = 32 MB of chain heads

fn _sh_hash(ix, iy, iz) {
    # Teschner's prime-multiplier XOR combine...
    var h = ix * 73856093;
    h = h ^ (iy * 19349663);
    h = h ^ (iz * 83492791);
    # ...followed by the murmur3 64-bit finalizer, which the pre-2.8.3 hash
    # did not have. The bucket index is the LOW bits of h, and the combine
    # alone leaves those bits carrying almost no entropy for the grid-aligned
    # coordinates this structure is built for: a point set on a stride-4 grid
    # gives ix = 4g, so h = g * 4 * 73856093 has its bottom two bits always
    # zero and 30,000 distinct cells land in 256 buckets out of 1024. That is
    # already a 117-deep chain, and -- worse for the growth policy below --
    # the occupied count then never reaches 3/4 of the table, so the table
    # would never grow no matter how many cells were added. The finalizer
    # avalanches the high bits down; the same 30,000 cells then occupy 19,619
    # buckets of 32,768 and the longest chain in the table is 6.
    # `>>` is logical in Cyrius (verified: (0-1) >> 1 == 0x7fff_ffff_ffff_ffff),
    # which is what the finalizer requires. The caller masks with
    # (bucket_count - 1) >= 0, so a negative h needs no separate correction.
    h = h ^ (h >> 33);
    h = h * 0xFF51AFD7ED558CCD;
    h = h ^ (h >> 33);
    h = h * 0xC4CEB9FE1A85EC53;
    h = h ^ (h >> 33);
    return h;
}

fn _sh_cell_coord(val, inv_cell_size) {
    return f64_to(f64_floor(f64_mul(val, inv_cell_size)));
}

# Allocate a bucket array of `bc` chain heads, all empty (-1).
fn _sh_buckets_new(bc) {
    var b = alloc(bc * 8);
    for (var bi = 0; bi < bc; bi = bi + 1) {
        store64(b + bi * 8, 0 - 1);
    }
    return b;
}

# Create a new spatial hash grid.
# cell_size: size of each grid cell (f64)
# Returns: spatial hash handle pointer
fn spatial_hash_new(cell_size) {
    var sh = alloc(48);
    store64(sh, cell_size);
    store64(sh + 8, f64_div(F64_ONE, cell_size));
    store64(sh + 16, _sh_buckets_new(_SH_INIT_BUCKETS));
    store64(sh + 24, _SH_INIT_BUCKETS);
    store64(sh + 32, vec_new());
    store64(sh + 40, 0);
    return sh;
}

fn _sh_cell_size(sh) { return load64(sh); }
fn _sh_inv_cell_size(sh) { return load64(sh + 8); }
fn _sh_buckets(sh) { return load64(sh + 16); }
fn _sh_bucket_count(sh) { return load64(sh + 24); }
fn _sh_entries(sh) { return load64(sh + 32); }
fn _sh_occupied(sh) { return load64(sh + 40); }

fn _sh_bucket_of(sh, ix, iy, iz) {
    return _sh_hash(ix, iy, iz) & (load64(sh + 24) - 1);
}

# Index of the newest entry in the chain for (ix, iy, iz), or -1 if empty.
fn _sh_chain_head(sh, ix, iy, iz) {
    return load64(_sh_buckets(sh) + _sh_bucket_of(sh, ix, iy, iz) * 8);
}

# Point bucket b's head at entry `e`, returning `e`'s `next` link (the old
# head). The caller stores that link, so no earlier entry is ever rewritten.
fn _sh_chain_push(sh, b, e) {
    var slot = _sh_buckets(sh) + b * 8;
    var old = load64(slot);
    store64(slot, e);
    return old;
}

# Reverse results[from..len) in place -- one query's run of matches, walked
# newest-first off the chain, restored to insertion order.
#
# Raw load64/store64 on the vec's data pointer rather than vec_get/vec_set:
# `results` is a vec this file created moments ago, `from` is a length this
# file read off it, and the loop only ever touches [from, len), so both
# bounds are established here rather than trusted from a caller. Through the
# checked accessors the reversal costs four bounds tests per swap and shows
# up as a 38% regression on a query that returns thousands of matches from
# one cell -- the case the pre-2.8.3 full-bucket scan handled best.
fn _sh_reverse_from(results, from) {
    var data = load64(results);
    var hi = load64(results + 8) - 1;
    while (from < hi) {
        var lo_p = data + from * 8;
        var hi_p = data + hi * 8;
        var t = load64(lo_p);
        store64(lo_p, load64(hi_p));
        store64(hi_p, t);
        from = from + 1;
        hi = hi - 1;
    }
    return 0;
}

# Double the bucket array and re-chain every entry. Amortized O(1) per insert
# because the count doubles; the entries themselves never move. Re-chaining
# forward (e = 0..n-1) reproduces the newest-first order incremental inserts
# would have produced, so query order is unchanged by a growth.
fn _sh_grow(sh) {
    var bc = _sh_bucket_count(sh);
    if (bc >= _SH_MAX_BUCKETS) { return 0; }
    store64(sh + 16, _sh_buckets_new(bc * 2));
    store64(sh + 24, bc * 2);
    var entries = _sh_entries(sh);
    var n = vec_len(entries) / _SH_ENTRY_SIZE;
    var occ = 0;
    for (var e = 0; e < n; e = e + 1) {
        var base = e * _SH_ENTRY_SIZE;
        var b = _sh_bucket_of(sh, vec_get(entries, base),
        vec_get(entries, base + 1), vec_get(entries, base + 2));
        var old = _sh_chain_push(sh, b, e);
        vec_set(entries, base + 4, old);
        if (old < 0) { occ = occ + 1; }
    }
    store64(sh + 40, occ);
    return 0;
}

# Insert a point with associated data into the spatial hash.
# point: HVec3 pointer
# data: i64 value
# Returns: HSB_ERR_NONE (0), always. A spatial hash has no bounds to fall outside
#          of -- every coordinate maps to some cell, including NaN and +-Inf -- so
#          there is no rejection path and no failure to report. The return was
#          undocumented before 2.8.5; it is stated here because this routine is
#          the one whose convention its two siblings were moved onto, and a
#          contract nobody wrote down is what let them drift apart in the first
#          place (2026-08-04 audit, api-consistency).
fn spatial_hash_insert(sh, point, data) {
    var inv = _sh_inv_cell_size(sh);
    var ix = _sh_cell_coord(HVec3_x(point), inv);
    var iy = _sh_cell_coord(HVec3_y(point), inv);
    var iz = _sh_cell_coord(HVec3_z(point), inv);

    var entries = _sh_entries(sh);
    var e = vec_len(entries) / _SH_ENTRY_SIZE;
    var old = _sh_chain_push(sh, _sh_bucket_of(sh, ix, iy, iz), e);
    vec_push(entries, ix);
    vec_push(entries, iy);
    vec_push(entries, iz);
    vec_push(entries, data);
    vec_push(entries, old);

    var occ = _sh_occupied(sh);
    if (old < 0) {
        occ = occ + 1;
        store64(sh + 40, occ);
        # Load factor 3/4 on OCCUPIED buckets (see the block comment above).
        # Only a newly occupied bucket can cross it, so the test is skipped
        # on every insert into a cell that already exists.
        if (occ * 4 >= _sh_bucket_count(sh) * 3) { _sh_grow(sh); }
    }

    return 0;
}

# Query all data values in the same cell as the given point.
# Returns vec of data (i64) values, in insertion order.
fn spatial_hash_query_cell(sh, point) {
    var results = vec_new();
    var inv = _sh_inv_cell_size(sh);
    var ix = _sh_cell_coord(HVec3_x(point), inv);
    var iy = _sh_cell_coord(HVec3_y(point), inv);
    var iz = _sh_cell_coord(HVec3_z(point), inv);

    var entries = _sh_entries(sh);
    var e = _sh_chain_head(sh, ix, iy, iz);
    while (e >= 0) {
        var base = e * _SH_ENTRY_SIZE;
        # Only include entries from the exact cell (not hash collisions)
        if (vec_get(entries, base) == ix) {
            if (vec_get(entries, base + 1) == iy) {
                if (vec_get(entries, base + 2) == iz) {
                    vec_push(results, vec_get(entries, base + 3));
                }
            }
        }
        e = vec_get(entries, base + 4);
    }

    _sh_reverse_from(results, 0);
    return results;
}

# Largest radius/cell_size ratio for which ceil() still lands inside i64. Above
# it -- and for +Inf or NaN, which fail every f64_lt below -- the cell block
# covers the whole representable coordinate range, so the range test is dropped
# and every stored entry qualifies.
var _SH_MAX_SPAN_CELLS = 1000000000000000;   # 1e15

# |a - b| <= r, written as one subtraction so it carries exactly the overflow
# exposure the `tx = cx + dx` form it replaces already had.
fn _sh_within(e, c, r) {
    var d = e - c;
    if (d < 0) { d = 0 - d; }
    if (d <= r) { return 1; }
    return 0;
}

# Query all data values within radius of the given point.
# Checks all cells that could contain points within radius.
# Returns vec of candidate data (i64) values (broadphase -- caller should
# perform exact distance checks).
#
# COST IS BOUNDED BY THE GRID, NOT BY THE RADIUS. The cell-block walk below is
# (2*radius/cell_size + 1)^3 probes, which is unbounded in the caller's radius:
# radius 1e4 on a unit grid asks for 8e12 probes and radius 1e6 for 8e18, i.e.
# the call never returns. Once the block exceeds the bucket count there is a
# strictly cheaper plan that returns the IDENTICAL multiset -- walk each of the
# bucket once and apply the same per-entry cell-range test.
# The membership predicate is unchanged (an entry is emitted iff its cell lies in
# the block, and it can match at most one cell either way); only the visit ORDER
# differs, and only in a regime where the old code was effectively a hang.
fn spatial_hash_query_radius(sh, point, radius) {
    var results = vec_new();
    var inv = _sh_inv_cell_size(sh);
    var cx = _sh_cell_coord(HVec3_x(point), inv);
    var cy = _sh_cell_coord(HVec3_y(point), inv);
    var cz = _sh_cell_coord(HVec3_z(point), inv);

    # Number of cells to search in each direction
    var span = f64_mul(radius, inv);
    # A negative radius encloses nothing. Unchanged behaviour -- the old loop's
    # `dx = -cells_r; while (dx <= cells_r)` was already empty for cells_r < 0 --
    # but stated, because f64_to of a negative NaN-ish span is not a bound.
    if (f64_lt(span, 0) == 1) { return results; }
    var ranged = 1;
    var cells_r = 0;
    if (f64_lt(span, f64_from(_SH_MAX_SPAN_CELLS)) == 1) {
        cells_r = f64_to(f64_ceil(span));
    } else {
        ranged = 0;   # +Inf, NaN, or past i64: every cell is in range
    }

    # WHICH PLAN IS CHEAPER, measured against what each one actually costs. The
    # per-cell walk costs (2*cells_r + 1)^3 bucket probes; the flat scan below
    # costs one visit per STORED ENTRY. Through 2.8.2 the table was a fixed 1024
    # buckets and this was the constant `cells_r >= 5` (11^3 = 1331 > 1024); the
    # table now grows, and the entry count is the honest bound on the scan, so
    # the two are compared directly. Below cells_r = 1024 the cube stays under
    # 8.6e9 and cannot overflow i64; at or above it the walk is hopeless against
    # any population.
    var entries = _sh_entries(sh);
    var nentries = vec_len(entries) / _SH_ENTRY_SIZE;
    var full_scan = 0;
    if (ranged == 0) {
        full_scan = 1;
    } elif (cells_r >= 1024) {
        full_scan = 1;
    } else {
        var w = 2 * cells_r + 1;
        if (w * w * w > nentries) { full_scan = 1; }
    }

    # FLAT SCAN over the entry list. Every entry carries its own (ix, iy, iz), so
    # the cheap plan needs no bucket traversal at all. It must not walk the bucket
    # array either: since the 2.8.3 growing table those slots hold i64 chain HEADS
    # (-1 = empty), not a vec per bucket, so `vec_len` on one is a wild pointer.
    # Membership is the same predicate as the per-cell walk -- an entry is emitted
    # iff its cell lies in the block, and it matches at most one cell either way --
    # so this returns the identical multiset; only the visit ORDER differs.
    if (full_scan == 1) {
        var flen = vec_len(entries);
        var fei = 0;
        while (fei < flen) {
            var keep = 1;
            if (ranged == 1) {
                keep = _sh_within(vec_get(entries, fei), cx, cells_r);
                if (keep == 1) { keep = _sh_within(vec_get(entries, fei + 1), cy, cells_r); }
                if (keep == 1) { keep = _sh_within(vec_get(entries, fei + 2), cz, cells_r); }
            }
            if (keep == 1) { vec_push(results, vec_get(entries, fei + 3)); }
            fei = fei + _SH_ENTRY_SIZE;
        }
        return results;
    }

    var dx = 0 - cells_r;
    while (dx <= cells_r) {
        var dy = 0 - cells_r;
        while (dy <= cells_r) {
            var dz = 0 - cells_r;
            while (dz <= cells_r) {
                var tx = cx + dx;
                var ty = cy + dy;
                var tz = cz + dz;
                var run = vec_len(results);
                var e = _sh_chain_head(sh, tx, ty, tz);
                while (e >= 0) {
                    var base = e * _SH_ENTRY_SIZE;
                    # Only include entries from the exact target cell
                    if (vec_get(entries, base) == tx) {
                        if (vec_get(entries, base + 1) == ty) {
                            if (vec_get(entries, base + 2) == tz) {
                                vec_push(results, vec_get(entries, base + 3));
                            }
                        }
                    }
                    e = vec_get(entries, base + 4);
                }
                # This cell's run only -- cells stay in their scan order.
                _sh_reverse_from(results, run);
                dz = dz + 1;
            }
            dy = dy + 1;
        }
        dx = dx + 1;
    }

    return results;
}

# Remove all entries from the spatial hash.
fn spatial_hash_clear(sh) {
    var buckets = _sh_buckets(sh);
    var bc = _sh_bucket_count(sh);
    for (var bi = 0; bi < bc; bi = bi + 1) {
        store64(buckets + bi * 8, 0 - 1);
    }
    # Reset the entry vec's length to 0 (keeps its allocation) and the
    # occupied count with it, so the load factor is re-derived from scratch.
    store64(_sh_entries(sh) + 8, 0);
    store64(sh + 40, 0);
    return 0;
}
