# symbolic.cyr -- symbolic math expression tree
# Usage: shipped inside dist/hisab.cyr; in-tree, include "src/symbolic.cyr" after what it requires
# Requires: src/error.cyr (since 3.4.0: expr_eval_checked's Err codes; stdlib resolves via
#           cyrius.cyml [deps])
#
# Provides: expression tree (tagged union), evaluate, differentiate,
#           simplify, and to-string for symbolic math expressions.
#
# ⭐ 3.4.0 — 0 IS THE FAILURE HANDLE OF EVERY NODE-RETURNING FUNCTION HERE, as it already
# was of symbolic_ext's sym_integrate ("0 (null) if unsupported"). A constructor returns 0
# when its node cannot be allocated, and when a child it is handed is 0, so a failure
# anywhere in a tree built bottom-up reaches the root instead of leaving a null hole in it
# (through 3.3.7 a failed alloc was stored through, a SIGSEGV). expr_diff returns 0 for a
# tree it cannot read, expr_simplify passes 0 through, and expr_eval_checked refuses it.
# [measured: scratch oom probes, base tree, one process per call, exit 139, 2026-10-31]
# [measured: tests/hisab.tcyr, group "3.4.0: a refused allocation returns the designed failure"]
#
# Ported from rust-old/src/symbolic/ (Expr enum, evaluate, differentiate,
# simplify, to_str).
#
# Expression node layout (heap-allocated):
#   CONST:  { tag: i64, value: f64 }           = 16 bytes
#   VAR:    { tag: i64, name: Str }             = 16 bytes
#   Binary: { tag: i64, left: ptr, right: ptr } = 24 bytes
#   Unary:  { tag: i64, child: ptr }            = 16 bytes

# Buffer size for rendering a non-integral constant before str_from_buf copies it
# out: sym_const_to_str hands it to stdlib fmt_float_buf. (Through 3.2.x
# symbolic_ext's `_latex_fmt_const` allocated one too; since 3.3.0 it calls
# sym_const_to_str.)
#
# This must cover stdlib fmt_float_buf's SCRATCH use, not just its output length.
# fmt_int_buf renders digits backwards from `buf + 23` and then shifts them down,
# so it needs 24 bytes at whatever pointer it is handed. fmt_float_buf calls it
# twice: once at `buf + pos` with pos <= 1 (sign), then again for the fractional
# part at `buf + pos` where pos can reach 22 (sign + 20 whole digits + '.'),
# touching offset 45. The previous value of 32 was therefore 14 bytes short and a
# large-magnitude coefficient overran the allocation. 64 leaves margin.
# _INT_EXACT_BUF holds the widest exact integer an f64 can carry: DBL_MAX is
# 1.797...e308, so 309 digits, plus a sign and slack.
enum _RenderLayout { _FLOAT_RENDER_BUF = 64; _INT_EXACT_BUF = 352 }

# ================================================================
# Internal helpers
# ================================================================

# Tolerance for float comparison.
# ⛔ 3.3.0 — THESE BITS WERE 0x3CD0_0000_0000_0000, WHICH IS 2^-50 = 8.88e-16, NOT THE
# 1e-15 THIS COMMENT AND EVERY DOCUMENT STATE (11% off). The constant gate read
# "1e-15" as one significant digit (+/- 5e-16) and passed it; a comment of at most
# two significant digits now has to match to 4 ulp. Values in [8.88e-16, 1e-15) now
# fold as the documentation always said they did.
# [measured: tests/modules.tcyr, group "3.3.0 the promoted helpers, called as API"]
# The sign bit (3.4.1 SYM2): a negation here flips it with an XOR, IEEE 754's negate on every
# pin (f64_neg(+-0) returned +0 below cyrius 6.6.8), so -(x) at x = 0 evaluates to -0 there too.
enum _SymBits {
    _SYM_SIGN = 0x8000_0000_0000_0000;   # the sign-bit mask
}
var _SYM_EPS = 0x3CD2_03AF_9EE7_5616;   # 1e-15

# 2^63 = 9223372036854775808 -- the first magnitude `f64_to` cannot represent.
var _SYM_2_POW_63 = 0x43E0_0000_0000_0000;   # 9223372036854775808

# ⛔ 2.20.0 -- ABOVE 2^63 BOTH RENDERERS RETURNED THE SAME WRONG CONSTANT FOR
# EVERY INPUT. No i64 holds these values: below cyrius 6.6.8 x86's `f64_to` returned
# i64::MIN for any |val| >= 2^63 (and for NaN) -- from 6.6.8 it saturates by sign,
# i64::MAX / i64::MIN, and NaN gives 0; wrong either way -- so, measured on the
# toolchain of the day, `expr_to_str` and `sym_to_latex` returned
# **-9223372036854775808** for 1e19, 1e20, 2^100 alike, a NEGATIVE number for a
# positive input. ⚠ And in the LaTeX path the sign was written separately, so a
# negative input produced a DOUBLE MINUS: `sym_to_latex(-1e19)` was
# `{--9223372036854775808.000000}`. The earlier filing described this as "30
# diverging values"; it is the entire finite band above 2^63.
# ⭐ Every f64 at |val| >= 2^52 is an INTEGER, so there is no fractional
# information to render up here and no rounding to do -- only an exact decimal
# expansion of mantissa x 2^k, which is what this does: seed a little-endian
# decimal digit array with the 53-bit mantissa, then double it k times.
# ⚠ The doubling loop is the whole algorithm and it is exact by construction --
# no f64 arithmetic touches the result, so nothing can round.
# Checked against an independent exact oracle: the 961 binades 2^63..2^1023 plus
# 10,000 signed random mantissas, compared digit-for-digit with Python's
# arbitrary-precision `int(float)`. 10,961 renderings, 0 mismatches.
# [measured: exact-oracle sweep, 10961 renderings, 0 mismatches, 2026-09-10]
# Writes the digits to buf and returns their count; dig is the caller's scratch for the
# little-endian digit array, _INT_EXACT_BUF bytes. (3.4.0: it allocated dig itself, a
# second refusable allocation beside the caller's buf; one allocation now holds both.)
fn _sym_int_exact_buf(val, buf, dig) {
    # Defensive: inf/nan never reach here (their integrality test fails first),
    # but a renderer that can emit 309 digits should not be asked to guess.
    if (((val >> 52) & 0x7FF) == 0x7FF) { return fmt_float_buf(val, buf, 0); }
    var neg = 0;
    var mag = val;
    if (((val >> 63) & 1) == 1) { neg = 1; mag = f64_abs(val); }
    var ex = ((mag >> 52) & 0x7FF) - 1023;
    var m = (mag & 0x000F_FFFF_FFFF_FFFF) | 0x0010_0000_0000_0000;
    var sh = ex - 52;
    var nd = 0;
    var t = m;
    while (t > 0) {
        store8(dig + nd, t % 10);
        nd = nd + 1;
        t = t / 10;
    }
    if (nd == 0) { store8(dig, 0); nd = 1; }
    var k = 0;
    while (k < sh) {
        var carry = 0;
        var i = 0;
        while (i < nd) {
            var d = load8(dig + i) * 2 + carry;
            store8(dig + i, d % 10);
            carry = d / 10;
            i = i + 1;
        }
        while (carry > 0) {
            store8(dig + nd, carry % 10);
            nd = nd + 1;
            carry = carry / 10;
        }
        k = k + 1;
    }
    var pos = 0;
    if (neg == 1) { store8(buf, 45); pos = 1; }
    var j = nd - 1;
    while (j >= 0) {
        store8(buf + pos, 48 + load8(dig + j));
        pos = pos + 1;
        j = j - 1;
    }
    return pos;
}

fn _sym_is_zero(x) {
    if (f64_lt(f64_abs(x), _SYM_EPS) == 1) { return 1; }
    return 0;
}

# 1 when two constants are equal to within 1e-15 ABSOLUTE (|a - b| < 1e-15), the
# tolerance the simplifier and the pattern matcher fold constants with; else 0. It is
# an absolute tolerance, so it is meant for the O(1) coefficients symbolic algebra
# produces, not for comparing arbitrary magnitudes. (Was `_sym_is_zero(a - b)`,
# reached from symbolic_ext.cyr, through 3.2.x.)
#must_use
public fn sym_const_eq(a, b) {
    return _sym_is_zero(f64_sub(a, b));
}

fn _sym_is_one(x) {
    if (f64_lt(f64_abs(f64_sub(x, F64_ONE)), _SYM_EPS) == 1) { return 1; }
    return 0;
}

# ================================================================
# Expression tags
# ================================================================

# ⚠ 3.3.0 — KEEP A PUBLIC DECLARATION DIRECTLY AFTER THIS ENUM. cycc 6.6.2 and 6.6.3
# hand a `public enum`'s marker to the NEXT top-level declaration (fixed upstream in
# 6.6.4), and six consumers compile the bundle under 6.6.3. This enum used to sit
# above `var _SYM_EPS`, which 3.3.0 made private: under 6.6.3 a consumer of the
# private bundle could still read and write it. It now sits directly above
# `expr_tag`, and check-public-surface.sh claim 5 fails any bundle where a
# non-public declaration follows a `public enum`.
# [measured: dist/hisab.cyr from a dir pinned to cycc 6.6.3, 2026-09-30]
public enum ExprTag {
    EXPR_CONST = 0;
    EXPR_VAR   = 1;
    EXPR_ADD   = 2;
    EXPR_MUL   = 3;
    EXPR_POW   = 4;
    EXPR_NEG   = 5;
    EXPR_SIN   = 6;
    EXPR_COS   = 7;
    EXPR_EXP   = 8;
    EXPR_LN    = 9;
}

# Get the tag of an expression node
public fn expr_tag(e) {
    return load64(e);
}

# ================================================================
# Constructors
# ================================================================
# Each returns the new node, or 0 when the node cannot be allocated or a child it is
# handed (a variable's name, for expr_var) is 0 -- see the 3.4.0 note at the top.

# Create a constant expression node
public fn expr_const(val) {
    var e = alloc(16);
    if (e == 0) { return 0; }
    store64(e, EXPR_CONST);
    store64(e + 8, val);
    return e;
}

# Create a variable expression node (name is a Str)
public fn expr_var(name) {
    if (name == 0) { return 0; }
    var e = alloc(16);
    if (e == 0) { return 0; }
    store64(e, EXPR_VAR);
    store64(e + 8, name);
    return e;
}

# Create an addition node: left + right
public fn expr_add(a, b) {
    if (a == 0 || b == 0) { return 0; }
    var e = alloc(24);
    if (e == 0) { return 0; }
    store64(e, EXPR_ADD);
    store64(e + 8, a);
    store64(e + 16, b);
    return e;
}

# Create a multiplication node: left * right
public fn expr_mul(a, b) {
    if (a == 0 || b == 0) { return 0; }
    var e = alloc(24);
    if (e == 0) { return 0; }
    store64(e, EXPR_MUL);
    store64(e + 8, a);
    store64(e + 16, b);
    return e;
}

# Create a power node: base ^ exponent
public fn expr_pow(a, b) {
    if (a == 0 || b == 0) { return 0; }
    var e = alloc(24);
    if (e == 0) { return 0; }
    store64(e, EXPR_POW);
    store64(e + 8, a);
    store64(e + 16, b);
    return e;
}

# Create a negation node: -child
public fn expr_neg(a) {
    if (a == 0) { return 0; }
    var e = alloc(16);
    if (e == 0) { return 0; }
    store64(e, EXPR_NEG);
    store64(e + 8, a);
    return e;
}

# Create a sin node: sin(child)
public fn expr_sin(a) {
    if (a == 0) { return 0; }
    var e = alloc(16);
    if (e == 0) { return 0; }
    store64(e, EXPR_SIN);
    store64(e + 8, a);
    return e;
}

# Create a cos node: cos(child)
public fn expr_cos(a) {
    if (a == 0) { return 0; }
    var e = alloc(16);
    if (e == 0) { return 0; }
    store64(e, EXPR_COS);
    store64(e + 8, a);
    return e;
}

# Create an exp node: e^child
public fn expr_exp(a) {
    if (a == 0) { return 0; }
    var e = alloc(16);
    if (e == 0) { return 0; }
    store64(e, EXPR_EXP);
    store64(e + 8, a);
    return e;
}

# Create a ln node: ln(child)
public fn expr_ln(a) {
    if (a == 0) { return 0; }
    var e = alloc(16);
    if (e == 0) { return 0; }
    store64(e, EXPR_LN);
    store64(e + 8, a);
    return e;
}

# ================================================================
# Accessor helpers
# ================================================================

# Get the f64 value from a CONST node
public fn expr_const_val(e) {
    return load64(e + 8);
}

# Get the Str name from a VAR node
public fn expr_var_name(e) {
    return load64(e + 8);
}

# Get the left child from a binary node (ADD, MUL, POW)
public fn expr_left(e) {
    return load64(e + 8);
}

# Get the right child from a binary node (ADD, MUL, POW)
public fn expr_right(e) {
    return load64(e + 16);
}

# Get the child from a unary node (NEG, SIN, COS, EXP, LN)
public fn expr_child(e) {
    return load64(e + 8);
}

# ================================================================
# Walk stacks (3.4.1)
# ================================================================
# ⛔ 3.4.1 — EVERY WALKER RECURSED ONCE PER LEVEL OF THE TREE, so a deep tree overflowed
# the native stack and killed the process, SIGSEGV, exit 139: a left-folded sum of
# 100,000 terms through expr_eval under `ulimit -s 8192` (AU1 SYM-F3; the sub-auditor's
# depths: eval about 65,500 levels, simplify 40,000, diff, LaTeX and integrate 47,500,
# rewrite 87,000). The constructors build such a tree bottom-up without recursing, so it
# is an ordinary input, and it has an answer. Every walk here and in symbolic_ext.cyr now
# recurses at most _SYM_REC_DEPTH (256) levels, as through 3.4.0 for an ordinary tree,
# and hands a deeper subtree to an iterative form that keeps its own stack of pending
# work: 64 words of the native stack, then a heap block that doubles (expr_to_str is
# iterative throughout). A deep tree costs heap, not native stack, and a block that cannot
# grow is a refused allocation, answered through the walk's own failure channel
# (expr_eval_checked's Err, the 0 node, the 0 Str). A pending node is one word, the node's
# address with the walk's state for it in the low three bits: every node is a pointer
# from alloc, which is 8-byte aligned. symbolic_ext.cyr carries the same helpers under its
# own names (a module does not reach another's private names). The recursive forms read a
# node's fields directly (load64 at the offsets of "Expression node layout"): the
# accessors are calls, and they made the walks slower than 3.4.0's.
# The two forms of each walk give the same answer: with both depths set to 0, every walk
# iterative, 24,000 random trees render, evaluate, differentiate, simplify, integrate,
# match and rewrite byte for byte as with 256, and the suites pass.
# [measured: scratch differential harness (diffh, diffhf), lane SYM tree at depth 256 and at 0, 2026-10-31]
# ⚠ A DEEP TREE GETS ITS ANSWER, BUT A WALK'S TIME AND MEMORY SCALE WITH THE TREE IT WALKS
# COUNTED AS A TREE -- a shared subtree once per use -- not with the nodes allocated
# (RV-SYM N6). expr_diff shares subtrees (it builds a DAG), so the derivative of a deep chain
# is quadratic as a tree: expr_simplify(expr_diff(e)) on a 100,000-deep (x^1)^1... chain took
# 519 s and 536 MB, and on a 100,000-deep sin chain more than 11.7 GB (3.4.0 exited 139 on
# both). Expression sharing (hash-consing the walkers) is a [3.5.0] row.
# [measured: review RV-SYM N6 on the lane SYM tree, 2026-10-31; SYM2 tree at 2,000 to 16,000 levels the same day]
# [measured: tests/hisab.tcyr, group "3.4.1: the symbolic walkers on a 200,000-deep tree"]
enum _SymWalk { _SYM_STK = 64; _SYM_ST_MASK = 7; _SYM_REC_DEPTH = 256 }

# Start a walk stack: st is a 3-word block { buf, len, cap } the caller owns, buf its
# local i64[64].
fn _sym_stk_init(st, buf) {
    store64(st, buf);
    store64(st + 8, 0);
    store64(st + 16, _SYM_STK);
    return 0;
}

# A walk stack's block doubled: a new heap block of 2 * cap words holding buf's cap words,
# or 0 when it cannot be allocated (cap past ALLOC_MAX / 16, or alloc refuses). buf is the
# caller's local or a heap block nothing else holds; the bump heap does not reuse it.
fn _sym_stk_grow(buf, cap) {
    if (cap > ALLOC_MAX / 16) { return 0; }
    var nb = alloc(cap * 16);
    if (nb == 0) { return 0; }
    for (var i = 0; i < cap; i = i + 1) { store64(nb + i * 8, load64(buf + i * 8)); }
    return nb;
}

# Push v: 0, or -1 when the stack is full and cannot double (cap past ALLOC_MAX / 16, or
# alloc refuses). The doubling copies the words into the new block; the old block is the
# caller's local or a heap block nothing else holds.
fn _sym_stk_push(st, v) {
    var n = load64(st + 8);
    var cap = load64(st + 16);
    if (n == cap) {
        if (cap > ALLOC_MAX / 16) { return 0 - 1; }
        var nb = alloc(cap * 16);
        if (nb == 0) { return 0 - 1; }
        var ob = load64(st);
        for (var i = 0; i < cap; i = i + 1) { store64(nb + i * 8, load64(ob + i * 8)); }
        store64(st, nb);
        store64(st + 16, cap * 2);
    }
    store64(load64(st) + n * 8, v);
    store64(st + 8, n + 1);
    return 0;
}

# Pop the top word (a walk pops only what it pushed).
fn _sym_stk_pop(st) {
    var n = load64(st + 8) - 1;
    store64(st + 8, n);
    return load64(load64(st) + n * 8);
}

# The top word, and the top word replaced (the walk moving a pending node to its next state).
fn _sym_stk_top(st) { return load64(load64(st) + (load64(st + 8) - 1) * 8); }
fn _sym_stk_retop(st, v) {
    store64(load64(st) + (load64(st + 8) - 1) * 8, v);
    return 0;
}

# ================================================================
# Evaluate
# ================================================================

# Evaluate an expression tree given a vec of (Str, f64) variable bindings.
# vars is a vec where each element is a pointer to a 16-byte pair: { name: Str, value: f64 }
# (expr_bind makes one); a vars of 0 is read as no bindings, and a 0 pair is skipped.
# Returns: Ok(value), or Err(HSB_ERR_INVALID_INPUT) when the tree has no value: a variable
# with no binding in vars, a 0 node (the failure handle every constructor returns), or a
# tag no constructor writes. It writes nothing to any fd.
#
# ⛔ 3.4.0 — RETIRES `expr_eval`, WHICH RETURNED +0.0 AND WROTE TO fd 2 FOR AN UNDEFINED
# VARIABLE OR AN UNKNOWN TAG (roadmap [3.4.0] D074). +0.0 is a legal value, so a caller
# could not tell a miss from a result: x + 1 with x unbound evaluated to 1.0. And the
# warning was the only I/O in hisab's library code, written into a consumer's stderr. An
# unbound variable has no value, so the replacement returns a Result and the miss is an
# Err; no answer is fabricated and nothing is written. Every bound tree evaluates to the
# bits expr_eval returned: the same operations in the same order.
# [measured: tests/hisab.tcyr, group "3.4.0: expr_eval_checked refuses a tree with no value"]
#must_use
public fn expr_eval_checked(e, vars) {
    var bad: i64[1];
    store64(&bad, 0);
    var v = _sym_eval(e, vars, &bad, 0);
    if (load64(&bad) != 0) { return Err(HSB_ERR_INVALID_INPUT); }
    return Ok(v);
}

# Internal: the evaluation itself, recursive to _SYM_REC_DEPTH levels and iterative below
# them (3.4.1). It returns the value and sets *bad to 1 at a node with no value -- a 0
# node, a variable with no binding, a tag no constructor writes -- and then goes on: what
# it returns past that point is never read. The recursion is the 3.4.0 evaluator with a
# depth count; an operand at depth _SYM_REC_DEPTH is handed to _sym_eval_deep, which
# needs no native stack, so a deep tree never overflows it. Both evaluate the same
# operations in the same order, so a tree's value does not depend on which one ran.
# ⚠ COST. The iterative walk alone made tests/hisab.bcyr's expr_eval row +103% and,
# with its stack written out in place, still +17 to +20%; the depth count costs the
# recursion one compare per node.
# [measured: tests/hisab.bcyr expr_eval rows, lane SYM vs the 3.4.1 baseline, 2026-10-31]
fn _sym_eval(e, vars, bad, depth) {
    if (depth >= _SYM_REC_DEPTH) { return _sym_eval_deep(e, vars, bad); }
    if (e == 0) {
        store64(bad, 1);
        return 0;
    }
    var t = load64(e);
    var d = depth + 1;
    if (t == EXPR_CONST) { return load64(e + 8); }
    if (t == EXPR_VAR) {
        var pair = _sym_lookup(load64(e + 8), vars);
        if (pair == 0) {
            store64(bad, 1);
            return 0;
        }
        return load64(pair + 8);
    }
    if (t == EXPR_ADD) {
        return f64_add(_sym_eval(load64(e + 8), vars, bad, d), _sym_eval(load64(e + 16), vars, bad, d));
    }
    if (t == EXPR_MUL) {
        return f64_mul(_sym_eval(load64(e + 8), vars, bad, d), _sym_eval(load64(e + 16), vars, bad, d));
    }
    if (t == EXPR_POW) {
        return ganita_f64_pow(_sym_eval(load64(e + 8), vars, bad, d), _sym_eval(load64(e + 16), vars, bad, d));
    }
    if (t == EXPR_NEG) { return _sym_eval(load64(e + 8), vars, bad, d) ^ _SYM_SIGN; }
    if (t == EXPR_SIN) { return f64_sin(_sym_eval(load64(e + 8), vars, bad, d)); }
    if (t == EXPR_COS) { return f64_cos(_sym_eval(load64(e + 8), vars, bad, d)); }
    if (t == EXPR_EXP) { return f64_exp(_sym_eval(load64(e + 8), vars, bad, d)); }
    if (t == EXPR_LN) { return f64_ln(_sym_eval(load64(e + 8), vars, bad, d)); }
    # A tag no constructor writes.
    store64(bad, 1);
    return 0;
}

# Internal: _sym_eval's walk below _SYM_REC_DEPTH. It returns the value, or sets *bad to 1
# and returns 0 at the first node with no value or when its walk stack cannot grow.
# Iterative (see "Walk stacks"): a sum,
# product or power pushes itself to be combined, then its right operand, then its left, so
# the left is evaluated first, as the recursion did, and a bound tree's value is the same
# operations in the same order, bit for bit. The stack operations are written out in place
# (a call per push costs this walk most of its time).
# A flag rather than a Result per node: the pair and its test at every node cost 40 to 56
# ns over 3.3.7's expr_eval on tests/hisab.bcyr's expr_eval row (about 550 ns), the flag
# 10 to 25 ns.
# [measured: tests/hisab.bcyr expr_eval, both forms against the base tree, interleaved runs, 2026-10-31]
fn _sym_eval_deep(e, vars, bad) {
    var fl: i64[64];
    var vl: i64[64];
    var fb = &fl;
    var fc = 64;
    var fp = 1;
    var vb = &vl;
    var vc = 64;
    var vp = 0;
    var w = 0;
    var n = 0;
    var t = 0;
    var r = 0;
    var x = 0;
    store64(fb, e);
    while (fp > 0) {
        fp = fp - 1;
        w = load64(fb + fp * 8);
        n = w & (0 - 8);
        if (n == 0) {
            store64(bad, 1);
            return 0;
        }
        t = load64(n);
        if ((w & _SYM_ST_MASK) == 0 && t >= EXPR_ADD && t <= EXPR_LN) {
            # First visit of an operator: itself (to combine), then its operands, the
            # left one on top.
            if (fp + 3 > fc) {
                fb = _sym_stk_grow(fb, fc);
                if (fb == 0) {
                    store64(bad, 1);
                    return 0;
                }
                fc = fc * 2;
            }
            store64(fb + fp * 8, n | 1);
            fp = fp + 1;
            if (t <= EXPR_POW) {
                store64(fb + fp * 8, load64(n + 16));
                fp = fp + 1;
            }
            store64(fb + fp * 8, load64(n + 8));
            fp = fp + 1;
        } else {
            if (t == EXPR_CONST) {
                r = load64(n + 8);
            } elif (t == EXPR_VAR) {
                x = _sym_lookup(load64(n + 8), vars);
                if (x == 0) {
                    store64(bad, 1);
                    return 0;
                }
                r = load64(x + 8);
            } elif (t <= EXPR_POW && t >= EXPR_ADD) {
                vp = vp - 1;
                x = load64(vb + vp * 8);
                r = load64(vb + (vp - 1) * 8);
                vp = vp - 1;
                if (t == EXPR_ADD) { r = f64_add(r, x); }
                elif (t == EXPR_MUL) { r = f64_mul(r, x); }
                else { r = ganita_f64_pow(r, x); }
            } elif (t >= EXPR_NEG && t <= EXPR_LN) {
                vp = vp - 1;
                x = load64(vb + vp * 8);
                if (t == EXPR_NEG) { r = x ^ _SYM_SIGN; }
                elif (t == EXPR_SIN) { r = f64_sin(x); }
                elif (t == EXPR_COS) { r = f64_cos(x); }
                elif (t == EXPR_EXP) { r = f64_exp(x); }
                else { r = f64_ln(x); }
            } else {
                # A tag no constructor writes.
                store64(bad, 1);
                return 0;
            }
            if (vp == vc) {
                vb = _sym_stk_grow(vb, vc);
                if (vb == 0) {
                    store64(bad, 1);
                    return 0;
                }
                vc = vc * 2;
            }
            store64(vb + vp * 8, r);
            vp = vp + 1;
        }
    }
    return load64(vb);
}

# Internal: the pair in vars that binds `name`, or 0 when there is none (vars is 0, name is
# 0, or no pair names it). A 0 pair, or a pair whose name is 0 (expr_bind refuses one since
# 3.4.1, but vars is the caller's vec), binds nothing and is skipped.
fn _sym_lookup(name, vars) {
    if (vars == 0 || name == 0) { return 0; }
    var vi = 0;
    var vlen = vec_len(vars);
    var pair = 0;
    while (vi < vlen) {
        pair = vec_get(vars, vi);
        if (pair != 0) {
            if (load64(pair) != 0) {
                if (str_eq(name, load64(pair)) == 1) { return pair; }
            }
        }
        vi = vi + 1;
    }
    return 0;
}

# Helper: create a variable binding pair (for use with expr_eval_checked), or 0 when the
# pair cannot be allocated or name is 0 (expr_eval_checked skips a 0 pair). (3.4.1: a 0
# name made a pair that expr_eval_checked read through, in str_eq.)
public fn expr_bind(name, value) {
    if (name == 0) { return 0; }
    var pair = alloc(16);
    if (pair == 0) { return 0; }
    store64(pair, name);
    store64(pair + 8, value);
    return pair;
}

# ================================================================
# Differentiate
# ================================================================

# Symbolic differentiation of expr with respect to var_name (a Str).
# Returns a new expression tree representing the derivative, or 0 when there is none to
# build: e or var_name is 0, a node in e is 0 or carries a tag no constructor writes (or
# a variable's name is 0), or a node of the derivative or of the walk's stack cannot be
# allocated. Any depth since 3.4.1 (see "Walk stacks").
# A factor that does not depend on var_name differentiates to the constant 0, and a
# product or chain-rule term carrying that 0 is left out (3.4.1, below): d/dx(2 exp x) is
# 2 * (exp(x) * 1), not (0 * exp(x)) + (2 * (exp(x) * 1)). A power whose exponent does not
# depend on var_name takes the power rule, n * f^(n - 1) * f', the exponent as a
# constant node or as the expression; the exponent 0 differentiates to 0 (f^0 is 1). Only
# an exponent that depends on var_name takes the general rule, f^g (g' ln f + g f' / f),
# without its f' term when f does not depend on var_name.
# ⚠ AT A POINT WHERE A NON-CONSTANT EXPONENT EVALUATES TO 0 AND ITS BASE TO 0, n f^(n - 1)
# is 0 * Inf = NaN, where the derivative of f^0 is 0: the node set has no conditional
# that could say "0 when n is 0". A constant exponent 0 is exact.
# ⛔ 3.4.0 — A TAG IT COULD NOT READ DIFFERENTIATED TO THE CONSTANT 0 (roadmap [3.4.0]
# D074, the same fabricated answer as expr_eval's): d/dx of a node with tag 77 came back
# as expr_const(0), a legal derivative, and inside a sum it vanished into one, so
# x + <tag 77> differentiated to 1 + 0. It returns 0, symbolic_ext's sym_integrate's
# "unsupported", and the constructors carry that 0 to the root. Well-formed trees, which
# are all the constructors can build, differentiate exactly as before.
# [measured: tests/hisab.tcyr, group "3.4.0: expr_eval_checked refuses a tree with no value"]
# ⛔ 3.4.1 — THE POWER RULE NEEDED A CONST NODE (AU1 SYM-F1). An exponent with no x that
# was any other node (a variable y, 2 * 3) took the general rule, whose g' ln f term is
# 0 * ln f, NaN for f <= 0: d/dx x^y at x = BFFBB303EC100C7C, y = 3 evaluated to NaN for
# 3x^2 = 4021FB800DAD62C2, and at x = 0 to NaN for 0 (168 of 22,526 random trees). The
# power rule, which the CONST case already took, gives both.
# ⛔ 3.4.1 — AND THE UNSIMPLIFIED DERIVATIVE FORMED 0 * Inf (AU1 SYM-F6). Every rule
# multiplied by a factor's derivative even where it was the constant 0, so d/dx(2 exp x)
# at x = 710 evaluated (0 * exp(710)) + ... = 0 * Inf = NaN, where expr_simplify's tree
# gave +Inf, and d/dx(x^0) at x = 0 was (0 * x^-1) * 1 = NaN for 0. A derivative that is
# the constant 0 is exact, not a number to multiply by: its term is left out, as
# expr_simplify would fold it, so the simplified derivative of every tree is unchanged.
# [measured: tests/hisab.tcyr, group "3.4.1: expr_diff's power rule and its zero terms"]
public fn expr_diff(e, var_name) {
    if (e == 0 || var_name == 0) { return 0; }
    return _sym_diff_rec(e, var_name, 0);
}

# Internal: expr_diff to _SYM_REC_DEPTH levels by recursion, and from there by
# _sym_diff_deep, which needs no native stack (see "Walk stacks"); 0 for a 0 node, a 0
# name, a tag no constructor writes or a refused allocation.
fn _sym_diff_rec(e, var_name, depth) {
    if (depth >= _SYM_REC_DEPTH) { return _sym_diff_deep(e, var_name); }
    if (e == 0) { return 0; }
    var t = load64(e);
    if (t == EXPR_CONST) { return expr_const(0); }
    if (t == EXPR_VAR) {
        if (load64(e + 8) == 0) { return 0; }
        if (str_eq(load64(e + 8), var_name) == 1) { return expr_const(F64_ONE); }
        return expr_const(0);
    }
    if (t == EXPR_ADD || t == EXPR_MUL || t == EXPR_POW) {
        var dl = _sym_diff_rec(load64(e + 8), var_name, depth + 1);
        if (dl == 0) { return 0; }
        var dr = _sym_diff_rec(load64(e + 16), var_name, depth + 1);
        if (dr == 0) { return 0; }
        return _sym_diff_bin(e, dl, dr);
    }
    if (t >= EXPR_NEG && t <= EXPR_LN) {
        var dc = _sym_diff_rec(load64(e + 8), var_name, depth + 1);
        if (dc == 0) { return 0; }
        return _sym_diff_un(e, dc);
    }
    # A tag no constructor writes has no derivative: the failure handle, not a constant.
    return 0;
}

# Internal: expr_diff's walk below _SYM_REC_DEPTH: a node waits on its own stack until its
# children's derivatives are on a second one. 0 as expr_diff, and when a stack cannot grow.
fn _sym_diff_deep(e, var_name) {
    var fbuf: i64[64];
    var rbuf: i64[64];
    var fs: i64[3];
    var rs: i64[3];
    var w = 0;
    var n = 0;
    var st = 0;
    var t = 0;
    var d = 0;
    var c = 0;
    var k = 0;
    var dl = 0;
    var name = 0;
    _sym_stk_init(&fs, &fbuf);
    _sym_stk_init(&rs, &rbuf);
    if (_sym_stk_push(&fs, e) < 0) { return 0; }
    while (load64(&fs + 8) > 0) {
        w = _sym_stk_top(&fs);
        n = w & (0 - 8);
        st = w & _SYM_ST_MASK;
        k = 0;
        if (n == 0) { return 0; }
        t = expr_tag(n);
        if (t == EXPR_CONST) {
            # d/dx(c) = 0
            d = expr_const(0);
        } elif (t == EXPR_VAR) {
            # d/dx(x) = 1, d/dx(y) = 0
            name = expr_var_name(n);
            if (name == 0) { return 0; }
            if (str_eq(name, var_name) == 1) { d = expr_const(F64_ONE); } else { d = expr_const(0); }
        } elif (t == EXPR_ADD || t == EXPR_MUL || t == EXPR_POW) {
            if (st == 0) {
                c = expr_left(n);
                k = 1;
            } elif (st == 1) {
                c = expr_right(n);
                k = 1;
            } else {
                d = _sym_stk_pop(&rs);
                dl = _sym_stk_pop(&rs);
                d = _sym_diff_bin(n, dl, d);
            }
        } elif (t >= EXPR_NEG && t <= EXPR_LN) {
            if (st == 0) {
                c = expr_child(n);
                k = 1;
            } else {
                d = _sym_diff_un(n, _sym_stk_pop(&rs));
            }
        } else {
            # A tag no constructor writes has no derivative: the failure handle, not a constant.
            return 0;
        }
        if (k == 1) {
            _sym_stk_retop(&fs, n | (st + 1));
            if (_sym_stk_push(&fs, c) < 0) { return 0; }
        } else {
            if (d == 0) { return 0; }
            _sym_stk_pop(&fs);
            if (_sym_stk_push(&rs, d) < 0) { return 0; }
        }
    }
    return _sym_stk_pop(&rs);
}

# Internal: 1 when d, a derivative expr_diff built, is the constant 0 -- the derivative of
# a subtree that does not depend on the variable. expr_diff makes a CONST node only for a
# leaf's derivative (+0 or 1) and for this 0, so the test is exact.
fn _sym_dz(d) {
    if (load64(d) == EXPR_CONST) {
        if (load64(d + 8) == 0) { return 1; }
    }
    return 0;
}

# Internal: the derivative of the sum, product or power n from its children's
# derivatives dl (left) and dr (right), leaving out a term whose derivative factor is
# the constant 0 (expr_diff's notes). 0 when a node cannot be allocated.
fn _sym_diff_bin(n, dl, dr) {
    var t = load64(n);
    var a = load64(n + 8);
    var b = load64(n + 16);
    var za = _sym_dz(dl);
    var zb = _sym_dz(dr);
    var nv = 0;
    # d/dx(a + b) = a' + b'
    if (t == EXPR_ADD) {
        if (za == 1) { return dr; }
        if (zb == 1) { return dl; }
        return expr_add(dl, dr);
    }
    # d/dx(a * b) = a'*b + a*b'  (product rule)
    if (t == EXPR_MUL) {
        if (za == 1 && zb == 1) { return dl; }
        if (za == 1) { return expr_mul(a, dr); }
        if (zb == 1) { return expr_mul(dl, b); }
        return expr_add(expr_mul(dl, b), expr_mul(a, dr));
    }
    # d/dx(f ^ g), f = a, g = b
    if (zb == 1) {
        # g does not depend on x: d/dx(f^g) = g * f^(g-1) * f'
        if (za == 1) { return dl; }
        if (load64(b) == EXPR_CONST) {
            nv = load64(b + 8);
            # f^0 is 1 for every f: its derivative is the constant 0.
            if (f64_eq(nv, 0) == 1) { return expr_const(0); }
            return expr_mul(expr_mul(expr_const(nv), expr_pow(a, expr_const(f64_sub(nv, F64_ONE)))), dl);
        }
        return expr_mul(expr_mul(b, expr_pow(a, expr_add(b, expr_const(f64_neg(F64_ONE))))), dl);
    }
    # General case: d/dx(f^g) = f^g * (g'*ln(f) + g*f'/f), without g*f'/f when f' is 0.
    if (za == 1) { return expr_mul(expr_pow(a, b), expr_mul(dr, expr_ln(a))); }
    return expr_mul(expr_pow(a, b), expr_add(expr_mul(dr, expr_ln(a)),
        expr_mul(b, expr_mul(dl, expr_pow(a, expr_const(f64_neg(F64_ONE)))))));
}

# Internal: the derivative of the negation or function n from its child's derivative d;
# the constant 0 when d is (no term to keep). 0 when a node cannot be allocated.
fn _sym_diff_un(n, d) {
    if (_sym_dz(d) == 1) { return d; }
    var t = load64(n);
    var a = load64(n + 8);
    # d/dx(-f) = -f'
    if (t == EXPR_NEG) { return expr_neg(d); }
    # d/dx(sin(f)) = cos(f) * f'
    if (t == EXPR_SIN) { return expr_mul(expr_cos(a), d); }
    # d/dx(cos(f)) = -sin(f) * f'
    if (t == EXPR_COS) { return expr_neg(expr_mul(expr_sin(a), d)); }
    # d/dx(exp(f)) = exp(f) * f'
    if (t == EXPR_EXP) { return expr_mul(expr_exp(a), d); }
    # d/dx(ln(f)) = f' / f  (represented as f' * f^(-1))
    return expr_mul(d, expr_pow(a, expr_const(f64_neg(F64_ONE))));
}

# ================================================================
# Simplify
# ================================================================

# Simplify an expression using basic algebraic rules.
# Rules: 0+x=x, x+0=x, 0*x=0, 1*x=x, x*1=x, x^0=1, x^1=x,
#        const folding, double negation, neg(0)=0.
# Returns a new (simplified) expression tree, or 0 when e is 0, a node in it is 0, or a
# node of the result or of the walk's stack cannot be allocated (3.4.0: a 0 from a
# child's simplification passes up, where its tag was read through the null). A tag no
# constructor writes is returned as it is. Any depth since 3.4.1 (see "Walk stacks"),
# the same rules in the same order at every node.
public fn expr_simplify(e) {
    return _sym_simp_rec(e, 0);
}

# Internal: expr_simplify to _SYM_REC_DEPTH levels by recursion, and from there by
# _sym_simp_deep (see "Walk stacks").
fn _sym_simp_rec(e, depth) {
    if (depth >= _SYM_REC_DEPTH) { return _sym_simp_deep(e); }
    if (e == 0) { return 0; }
    var t = load64(e);
    if (t == EXPR_ADD || t == EXPR_MUL || t == EXPR_POW) {
        var a = _sym_simp_rec(load64(e + 8), depth + 1);
        if (a == 0) { return 0; }
        var b = _sym_simp_rec(load64(e + 16), depth + 1);
        if (b == 0) { return 0; }
        return _sym_simp_bin(t, a, b);
    }
    if (t >= EXPR_NEG && t <= EXPR_LN) {
        var c = _sym_simp_rec(load64(e + 8), depth + 1);
        if (c == 0) { return 0; }
        # --x = x: the simplified child is a negation, so this node's result is its
        # child simplified once more.
        if (t == EXPR_NEG && load64(c) == EXPR_NEG) { return _sym_simp_rec(load64(c + 8), depth + 1); }
        return _sym_simp_un(t, c);
    }
    # Leaves: constants and variables are already simplified; a tag no constructor writes
    # is returned as it is.
    return e;
}

# Internal: expr_simplify's walk below _SYM_REC_DEPTH: a node waits on its own stack until
# its children's simplifications are on a second one; 0 as expr_simplify, and when a stack
# cannot grow.
fn _sym_simp_deep(e) {
    if (e == 0) { return 0; }
    var fbuf: i64[64];
    var rbuf: i64[64];
    var fs: i64[3];
    var rs: i64[3];
    var w = 0;
    var n = 0;
    var st = 0;
    var t = 0;
    var r = 0;
    var c = 0;
    var k = 0;
    var a = 0;
    _sym_stk_init(&fs, &fbuf);
    _sym_stk_init(&rs, &rbuf);
    if (_sym_stk_push(&fs, e) < 0) { return 0; }
    while (load64(&fs + 8) > 0) {
        w = _sym_stk_top(&fs);
        n = w & (0 - 8);
        st = w & _SYM_ST_MASK;
        k = 0;
        if (n == 0) { return 0; }
        t = expr_tag(n);
        if (t == EXPR_ADD || t == EXPR_MUL || t == EXPR_POW) {
            if (st == 0) {
                c = expr_left(n);
                k = 1;
            } elif (st == 1) {
                c = expr_right(n);
                k = 1;
            } else {
                r = _sym_stk_pop(&rs);
                a = _sym_stk_pop(&rs);
                r = _sym_simp_bin(t, a, r);
            }
        } elif (t >= EXPR_NEG && t <= EXPR_LN) {
            if (st == 0) {
                c = expr_child(n);
                k = 1;
            } else {
                a = _sym_stk_pop(&rs);
                # --x = x: the simplified child is a negation, so this node's result is its
                # child simplified once more (the recursion's tail call): the pending
                # negation is replaced by that child.
                if (t == EXPR_NEG && expr_tag(a) == EXPR_NEG) {
                    _sym_stk_retop(&fs, expr_child(a));
                    k = 2;
                } else {
                    r = _sym_simp_un(t, a);
                }
            }
        } else {
            # Leaves: constants and variables are already simplified; a tag no
            # constructor writes is returned as it is.
            r = n;
        }
        if (k == 1) {
            _sym_stk_retop(&fs, n | (st + 1));
            if (_sym_stk_push(&fs, c) < 0) { return 0; }
        } elif (k == 0) {
            if (r == 0) { return 0; }
            _sym_stk_pop(&fs);
            if (_sym_stk_push(&rs, r) < 0) { return 0; }
        }
    }
    return _sym_stk_pop(&rs);
}

# Internal: the simplification of the sum, product or power with simplified children a
# and b (neither 0), or 0 when a node cannot be allocated.
fn _sym_simp_bin(t, a, b) {
    var ta = load64(a);
    var tb = load64(b);
    # ADD
    if (t == EXPR_ADD) {
        # 0 + b = b
        if (ta == EXPR_CONST) {
            if (_sym_is_zero(load64(a + 8)) == 1) { return b; }
        }
        # a + 0 = a
        if (tb == EXPR_CONST) {
            if (_sym_is_zero(load64(b + 8)) == 1) { return a; }
        }
        # const + const = const
        if (ta == EXPR_CONST) {
            if (tb == EXPR_CONST) {
                return expr_const(f64_add(load64(a + 8), load64(b + 8)));
            }
        }
        return expr_add(a, b);
    }
    # MUL
    if (t == EXPR_MUL) {
        # 0 * b = 0
        if (ta == EXPR_CONST) {
            if (_sym_is_zero(load64(a + 8)) == 1) { return expr_const(0); }
        }
        # a * 0 = 0
        if (tb == EXPR_CONST) {
            if (_sym_is_zero(load64(b + 8)) == 1) { return expr_const(0); }
        }
        # 1 * b = b
        if (ta == EXPR_CONST) {
            if (_sym_is_one(load64(a + 8)) == 1) { return b; }
        }
        # a * 1 = a
        if (tb == EXPR_CONST) {
            if (_sym_is_one(load64(b + 8)) == 1) { return a; }
        }
        # const * const = const
        if (ta == EXPR_CONST) {
            if (tb == EXPR_CONST) {
                return expr_const(f64_mul(load64(a + 8), load64(b + 8)));
            }
        }
        return expr_mul(a, b);
    }
    # POW: a is the base, b the exponent
    # x^0 = 1
    if (tb == EXPR_CONST) {
        if (_sym_is_zero(load64(b + 8)) == 1) { return expr_const(F64_ONE); }
    }
    # x^1 = x
    if (tb == EXPR_CONST) {
        if (_sym_is_one(load64(b + 8)) == 1) { return a; }
    }
    # const ^ const = const
    if (ta == EXPR_CONST) {
        if (tb == EXPR_CONST) {
            return expr_const(ganita_f64_pow(load64(a + 8), load64(b + 8)));
        }
    }
    return expr_pow(a, b);
}

# Internal: the simplification of the negation or function with simplified child a (not
# 0, and for a negation not itself a negation), or 0 when a node cannot be allocated.
fn _sym_simp_un(t, a) {
    var ta = load64(a);
    if (t == EXPR_NEG) {
        # -0 = 0
        if (ta == EXPR_CONST) {
            if (_sym_is_zero(load64(a + 8)) == 1) { return expr_const(0); }
        }
        # -c = const(-c)
        if (ta == EXPR_CONST) {
            return expr_const(load64(a + 8) ^ _SYM_SIGN);
        }
        return expr_neg(a);
    }
    # SIN, COS
    if (t == EXPR_SIN) { return expr_sin(a); }
    if (t == EXPR_COS) { return expr_cos(a); }
    # EXP -- fold exp(const)
    if (t == EXPR_EXP) {
        if (ta == EXPR_CONST) {
            return expr_const(f64_exp(load64(a + 8)));
        }
        return expr_exp(a);
    }
    # LN -- fold ln(const)
    if (ta == EXPR_CONST) {
        return expr_const(f64_ln(load64(a + 8)));
    }
    return expr_ln(a);
}

# ================================================================
# To string
# ================================================================

# A constant as text, exactly as expr_to_str and sym_to_latex render it: a value
# within _SYM_EPS (1e-15) of an integer, on EITHER side, as that integer's digits --
# exact at every magnitude, see _sym_int_exact_buf; zero has no sign, so -0 and
# -1e-300 are "0" -- any other finite value with exactly 6 decimal places, zero-padded
# (0.5 is "0.500000"; through 3.3.1 this said "up to 6", but `_sym_render_f64`
# zero-padded as fmt_float_buf does), and inf / NaN as "inf", "-inf", "nan", "-nan".
# Both renderers call this one function, so the 2.20.0 property "the two renderers
# agree at every magnitude" holds by construction. (Each renderer carried its own copy
# through 3.2.x.) Returns 0 when a buffer cannot be allocated (3.4.0; it stored through
# the null before).
#must_use
public fn sym_const_to_str(val) {
    # Integer test against the NEAREST integer (f64_round: round to nearest, ties to
    # even -- a tie is 0.5 away, never inside _SYM_EPS, so the tie rule cannot matter).
    # val - nearest is exact for every finite val; for inf it is inf - inf = NaN and
    # for NaN it is NaN, and f64_lt(NaN, _SYM_EPS) is 0, so both fall through to the
    # float path below as before.
    # ⛔ 3.3.3 — THE INTEGER TEST WAS ONE-SIDED. It measured |val - floor(val)|, which
    # is small just ABOVE an integer and close to 1 just BELOW one, so the integer
    # branch saw only one side: 6.000000000000001 rendered "6" but 5.999999999999999
    # "6.000000", and 1e-300 "0" but -1e-300 "-0.000000". Away from zero, 33 doubles
    # rendered with decimals that now render as integers, all in (-8, 8) (from 8 up the
    # f64 spacing exceeds _SYM_EPS): 21 just below a positive integer, 12 just below a
    # negative one. Near zero it was the whole negative band (-1e-15, 0): 3072 samples,
    # three per binade across all 1025 binades from 2^-1074 up, rendered "-0.000000",
    # and each positive mirror "0". "An integral value as its digits" has no side; a
    # tolerance that admits 6 + 8.9e-16 and refuses 6 - 8.9e-16 is not one. The
    # 2026-08-04 audit named the one-sidedness (its row for symbolic.cyr:536); 2.7.0
    # repaired that row's rounding carry and left the test as it was.
    # [measured: scratch sweep, 3.3.2 vs 3.3.3 bundle, 6488 f64s, exact oracle, 2026-10-01; cycc 6.6.12]
    var nearest = f64_round(val);
    var diff = f64_abs(f64_sub(val, nearest));
    if (f64_lt(diff, _SYM_EPS) == 1) {
        # `f64_to` is exact below 2^63 and SATURATES at or above it, so the
        # fast path is bounded by that and everything beyond renders exactly.
        # ⛔ 3.3.2 — RENDER THE INTEGER THAT WAS TESTED, NOT `val`. The test was
        # against floor(val) then, but this rendered f64_to(val), which truncates toward
        # ZERO: for a negative value within _SYM_EPS above an integer -n it printed
        # -(n-1). 21 doubles in (-8, 0) did, e.g. -0.9999999999999999 rendered "0"
        # and -5.999999999999999 "-5", through expr_to_str and sym_to_latex alike;
        # positives and every |val| >= 8 (f64 spacing > _SYM_EPS there) never could.
        # [measured: scratch sweep of every f64 within 1e-15 of each integer in [-12, 12], 2026-10-01]
        # f64_to(-0.0) is the integer 0, so a negative value that rounds to zero
        # renders "0", never "-0".
        if (f64_lt(f64_abs(val), _SYM_2_POW_63) == 1) {
            return str_from_int(f64_to(nearest));
        }
        # |val| >= 2^63 > 2^52: every such f64 is an integer, so nearest == val here.
        # The text and, past it, the digit scratch: one allocation, one refusal to check.
        var ibuf = alloc(2 * _INT_EXACT_BUF);
        if (ibuf == 0) { return 0; }
        var ilen = _sym_int_exact_buf(val, ibuf, ibuf + _INT_EXACT_BUF);
        return str_from_buf(ibuf, ilen);
    }
    # Render with 6 decimal places (inf / nan as the bare tokens). Only finite
    # non-integral |val| < 2^52 (every f64 at or above 2^52 is integral) and inf/nan
    # get here. stdlib fmt_float_buf carries a fraction that rounds up to 10^6 into
    # the integer part (since cyrius 6.5.30), so 0.9999999 renders "1.000000", not
    # "0.1000000". From 2.7.0 through 3.3.1 hisab carried its own copy with the carry,
    # `_sym_render_f64`, written while the stdlib still dropped it. Retired in 3.3.2:
    # over 3,538,970 inputs (3,203,636 of them reaching this branch) the old and new
    # sym_const_to_str rendered byte-identically, 0 mismatches, under each of the
    # eleven cycc releases 6.6.2 through 6.6.12. Control (6.6.12): with the old carry
    # mutated out, the same harness counted 45,540 mismatches.
    # [measured: scratch differential harness, not reproducible in-tree, 2026-10-01; cycc 6.6.2 to 6.6.12]
    var buf = alloc(_FLOAT_RENDER_BUF);
    if (buf == 0) { return 0; }
    var len = fmt_float_buf(val, buf, 6);
    return str_from_buf(buf, len);
}

# Internal: the fixed pieces of expr_to_str's text, by number (a pending piece is pushed
# on its walk stack as (id << 3) | 1, beside nodes, which are 8-byte aligned).
fn _sym_str_piece(id) {
    if (id == 1) { return "("; }
    if (id == 2) { return ")"; }
    if (id == 3) { return " + "; }
    if (id == 4) { return " * "; }
    if (id == 5) { return "^"; }
    if (id == 6) { return "sin("; }
    if (id == 7) { return "cos("; }
    if (id == 8) { return "exp("; }
    return "ln(";
}

# Convert an expression tree to a human-readable Str.
# Returns a Str (fat pointer), or 0 when e is 0, a node in it is 0 (or a variable's name
# is), or the text cannot be allocated (3.4.1: through 3.4.0 each of these was a read
# through the null, and str_builder_add ended the process on a refused grow). A tree that
# is one variable returns that variable's name, the same Str. A sum, product or power is
# written in parentheses,
# "(a + b)", "(a * b)", "(a^b)"; a negation as "-a"; a function as "sin(a)". A
# power's base and a negation's child are wrapped once more when their text starts
# with a minus sign: (-2)^x is "((-2)^x)" and neg(-3) is "-(-3)". A tag no constructor
# writes is "?".
# ⛔ 3.3.3 — A LEADING MINUS IN A POWER'S BASE OR A NEGATION'S CHILD WAS WRITTEN
# BARE. In a power's base the text read as another expression: (-2)^x rendered
# "(-2^x)" (minus 2^x), neg(x)^2 "(-x^2)" and (-3)^(-1) "(-3^-1)". In a negation's
# child it kept its value but not its form: neg(-3) and x + neg(-3) rendered "--3"
# and "(x + --3)", which conventional notation reads as -(-3) and C-like syntax as a
# decrement. sym_to_latex had the same defect in the same positions and 3.3.3
# repaired it there first (symbolic_ext.cyr, `_latex_write`); for a constant and a
# negation this is its rule, keyed on the text. A variable whose name starts with
# '-' is wrapped here too, where sym_to_latex, which decides on the node and not on
# a variable's name, writes it bare. A sum's or product's operand needs no wrap
# here: both are parenthesized whole, "(x * -3)".
# No other rendering changed. Over 590,610 trees -- every tree to operator depth 2 on
# ten leaves (x, theta, 2, 0.5, -3, -0.5, -1, -inf, -nan, -0) and eight operators,
# 390,610, plus 200,000 seeded random trees to depth 6 -- the repair changed exactly the
# 200,327 with a leading minus in a power's base or a negation's child and none of the
# other 390,283; a python3 renderer written from each rule matched the output before
# and after on all of them. Dropping the negation's wrap moved 44,226 outputs off the rule.
# [measured: scratch differential harness, not reproducible in-tree, 2026-10-01; cycc 6.6.12]
# ⛔ 3.4.1 — QUADRATIC MEMORY, AND RECURSION (AU1 SYM-F4, SYM-F3). Each node rendered its
# children to Strs of their own and copied them into a builder of its own, so every
# level copied the text below it again: a 20,000-node sum peaked at 2.3 GB, and a deep
# tree overflowed the native stack. The text is now written once, front to back, into one
# builder, by a walk with its own stack (see "Walk stacks"); the operand wrap reads the
# node (a negation; a constant whose text, or a variable whose name, starts with '-'),
# which is what the text starts with. Every tree renders to the same bytes.
# [measured: tests/hisab.tcyr, group "3.4.1: the symbolic walkers on a 200,000-deep tree"]
public fn expr_to_str(e) {
    if (e == 0) { return 0; }
    var t = expr_tag(e);
    if (t == EXPR_CONST) { return sym_const_to_str(expr_const_val(e)); }
    if (t == EXPR_VAR) { return expr_var_name(e); }
    if (t < EXPR_ADD || t > EXPR_LN) { return str_from("?"); }
    var al = default_alloc();
    var sb = str_builder_new_a(al);
    if (sb == 0) { return 0; }
    var sbuf: i64[64];
    var ss: i64[3];
    var w = 0;
    var n = 0;
    var opnd = 0;
    var s = 0;
    var wrap = 0;
    _sym_stk_init(&ss, &sbuf);
    if (_sym_stk_push(&ss, e) < 0) { return 0; }
    while (load64(&ss + 8) > 0) {
        w = _sym_stk_pop(&ss);
        if ((w & 1) == 1) {
            if (str_builder_add_cstr_a(al, sb, _sym_str_piece(w >> 3)) < 0) { return 0; }
        } else {
            n = w & (0 - 8);
            opnd = w & 2;
            if (n == 0) { return 0; }
            t = expr_tag(n);
            if (t == EXPR_CONST || t == EXPR_VAR) {
                if (t == EXPR_CONST) { s = sym_const_to_str(expr_const_val(n)); } else { s = expr_var_name(n); }
                if (s == 0) { return 0; }
                wrap = 0;
                if (opnd != 0 && str_len(s) > 0) {
                    if (load8(str_data(s)) == 45) { wrap = 1; }   # '-'
                }
                if (wrap == 1) {
                    if (str_builder_add_cstr_a(al, sb, "(") < 0) { return 0; }
                }
                if (str_builder_add_a(al, sb, s) < 0) { return 0; }
                if (wrap == 1) {
                    if (str_builder_add_cstr_a(al, sb, ")") < 0) { return 0; }
                }
            } elif (t == EXPR_ADD || t == EXPR_MUL || t == EXPR_POW) {
                # "(" left op right ")", the pieces pushed last first. A power's base is
                # an operand (2), wrapped when its text starts with '-'.
                if (str_builder_add_cstr_a(al, sb, "(") < 0) { return 0; }
                if (_sym_stk_push(&ss, (2 << 3) | 1) < 0) { return 0; }
                if (_sym_stk_push(&ss, expr_right(n)) < 0) { return 0; }
                if (t == EXPR_POW) {
                    if (_sym_stk_push(&ss, (5 << 3) | 1) < 0) { return 0; }
                    if (_sym_stk_push(&ss, expr_left(n) | 2) < 0) { return 0; }
                } else {
                    if (_sym_stk_push(&ss, ((t + 1) << 3) | 1) < 0) { return 0; }
                    if (_sym_stk_push(&ss, expr_left(n)) < 0) { return 0; }
                }
            } elif (t == EXPR_NEG) {
                # "-" and the child as an operand; as an operand itself, "(-...)".
                if (opnd != 0) {
                    if (str_builder_add_cstr_a(al, sb, "(-") < 0) { return 0; }
                    if (_sym_stk_push(&ss, (2 << 3) | 1) < 0) { return 0; }
                } else {
                    if (str_builder_add_cstr_a(al, sb, "-") < 0) { return 0; }
                }
                if (_sym_stk_push(&ss, expr_child(n) | 2) < 0) { return 0; }
            } elif (t >= EXPR_SIN && t <= EXPR_LN) {
                if (str_builder_add_cstr_a(al, sb, _sym_str_piece(t)) < 0) { return 0; }
                if (_sym_stk_push(&ss, (2 << 3) | 1) < 0) { return 0; }
                if (_sym_stk_push(&ss, expr_child(n)) < 0) { return 0; }
            } else {
                if (str_builder_add_cstr_a(al, sb, "?") < 0) { return 0; }
            }
        }
    }
    return str_builder_build_a(al, sb);
}
