# symbolic.cyr -- symbolic math expression tree
# Usage: shipped inside dist/hisab.cyr; in-tree, include "src/symbolic.cyr" after what it requires
# Requires: no other hisab module (stdlib resolves via cyrius.cyml [deps])
#
# Provides: expression tree (tagged union), evaluate, differentiate,
#           simplify, and to-string for symbolic math expressions.
#
# Ported from rust-old/src/symbolic/ (Expr enum, evaluate, differentiate,
# simplify, to_str).
#
# Expression node layout (heap-allocated):
#   CONST:  { tag: i64, value: f64 }           = 16 bytes
#   VAR:    { tag: i64, name: Str }             = 16 bytes
#   Binary: { tag: i64, left: ptr, right: ptr } = 24 bytes
#   Unary:  { tag: i64, child: ptr }            = 16 bytes

# Buffer size for rendering a non-integral constant before str_from_buf copies it
# out: sym_const_to_str hands it to stdlib fmt_float_buf. (Through 3.2.x
# symbolic_ext's `_latex_fmt_const` allocated one too; since 3.3.0 it calls
# sym_const_to_str.)
#
# This must cover stdlib fmt_float_buf's SCRATCH use, not just its output length.
# fmt_int_buf renders digits backwards from `buf + 23` and then shifts them down,
# so it needs 24 bytes at whatever pointer it is handed. fmt_float_buf calls it
# twice: once at `buf + pos` with pos <= 1 (sign), then again for the fractional
# part at `buf + pos` where pos can reach 22 (sign + 20 whole digits + '.'),
# touching offset 45. The previous value of 32 was therefore 14 bytes short and a
# large-magnitude coefficient overran the allocation. 64 leaves margin.
# _INT_EXACT_BUF holds the widest exact integer an f64 can carry: DBL_MAX is
# 1.797...e308, so 309 digits, plus a sign and slack.
enum _RenderLayout { _FLOAT_RENDER_BUF = 64; _INT_EXACT_BUF = 352 }

# ================================================================
# Internal helpers
# ================================================================

# Tolerance for float comparison.
# ⛔ 3.3.0 — THESE BITS WERE 0x3CD0_0000_0000_0000, WHICH IS 2^-50 = 8.88e-16, NOT THE
# 1e-15 THIS COMMENT AND EVERY DOCUMENT STATE (11% off). The constant gate read
# "1e-15" as one significant digit (+/- 5e-16) and passed it; a comment of at most
# two significant digits now has to match to 4 ulp. Values in [8.88e-16, 1e-15) now
# fold as the documentation always said they did.
# [measured: tests/modules.tcyr, group "3.3.0 the promoted helpers, called as API"]
var _SYM_EPS = 0x3CD2_03AF_9EE7_5616;   # 1e-15

# 2^63 = 9223372036854775808 -- the first magnitude `f64_to` cannot represent.
var _SYM_2_POW_63 = 0x43E0_0000_0000_0000;   # 9223372036854775808

# ⛔ 2.20.0 -- ABOVE 2^63 BOTH RENDERERS RETURNED THE SAME WRONG CONSTANT FOR
# EVERY INPUT. No i64 holds these values: below cyrius 6.6.8 x86's `f64_to` returned
# i64::MIN for any |val| >= 2^63 (and for NaN) -- from 6.6.8 it saturates by sign,
# i64::MAX / i64::MIN, and NaN gives 0; wrong either way -- so, measured on the
# toolchain of the day, `expr_to_str` and `sym_to_latex` returned
# **-9223372036854775808** for 1e19, 1e20, 2^100 alike, a NEGATIVE number for a
# positive input. ⚠ And in the LaTeX path the sign was written separately, so a
# negative input produced a DOUBLE MINUS: `sym_to_latex(-1e19)` was
# `{--9223372036854775808.000000}`. The earlier filing described this as "30
# diverging values"; it is the entire finite band above 2^63.
# ⭐ Every f64 at |val| >= 2^52 is an INTEGER, so there is no fractional
# information to render up here and no rounding to do -- only an exact decimal
# expansion of mantissa x 2^k, which is what this does: seed a little-endian
# decimal digit array with the 53-bit mantissa, then double it k times.
# ⚠ The doubling loop is the whole algorithm and it is exact by construction --
# no f64 arithmetic touches the result, so nothing can round.
# Checked against an independent exact oracle: the 961 binades 2^63..2^1023 plus
# 10,000 signed random mantissas, compared digit-for-digit with Python's
# arbitrary-precision `int(float)`. 10,961 renderings, 0 mismatches.
# [measured: exact-oracle sweep, 10961 renderings, 0 mismatches, 2026-09-10]
fn _sym_int_exact_buf(val, buf) {
    # Defensive: inf/nan never reach here (their integrality test fails first),
    # but a renderer that can emit 309 digits should not be asked to guess.
    if (((val >> 52) & 0x7FF) == 0x7FF) { return fmt_float_buf(val, buf, 0); }
    var neg = 0;
    var mag = val;
    if (((val >> 63) & 1) == 1) { neg = 1; mag = f64_abs(val); }
    var ex = ((mag >> 52) & 0x7FF) - 1023;
    var m = (mag & 0x000F_FFFF_FFFF_FFFF) | 0x0010_0000_0000_0000;
    var sh = ex - 52;
    var dig = alloc(_INT_EXACT_BUF);
    var nd = 0;
    var t = m;
    while (t > 0) {
        store8(dig + nd, t % 10);
        nd = nd + 1;
        t = t / 10;
    }
    if (nd == 0) { store8(dig, 0); nd = 1; }
    var k = 0;
    while (k < sh) {
        var carry = 0;
        var i = 0;
        while (i < nd) {
            var d = load8(dig + i) * 2 + carry;
            store8(dig + i, d % 10);
            carry = d / 10;
            i = i + 1;
        }
        while (carry > 0) {
            store8(dig + nd, carry % 10);
            nd = nd + 1;
            carry = carry / 10;
        }
        k = k + 1;
    }
    var pos = 0;
    if (neg == 1) { store8(buf, 45); pos = 1; }
    var j = nd - 1;
    while (j >= 0) {
        store8(buf + pos, 48 + load8(dig + j));
        pos = pos + 1;
        j = j - 1;
    }
    return pos;
}

fn _sym_is_zero(x) {
    if (f64_lt(f64_abs(x), _SYM_EPS) == 1) { return 1; }
    return 0;
}

# 1 when two constants are equal to within 1e-15 ABSOLUTE (|a - b| < 1e-15), the
# tolerance the simplifier and the pattern matcher fold constants with; else 0. It is
# an absolute tolerance, so it is meant for the O(1) coefficients symbolic algebra
# produces, not for comparing arbitrary magnitudes. (Was `_sym_is_zero(a - b)`,
# reached from symbolic_ext.cyr, through 3.2.x.)
#must_use
public fn sym_const_eq(a, b) {
    return _sym_is_zero(f64_sub(a, b));
}

fn _sym_is_one(x) {
    if (f64_lt(f64_abs(f64_sub(x, F64_ONE)), _SYM_EPS) == 1) { return 1; }
    return 0;
}

# ================================================================
# Expression tags
# ================================================================

# ⚠ 3.3.0 — KEEP A PUBLIC DECLARATION DIRECTLY AFTER THIS ENUM. cycc 6.6.2 and 6.6.3
# hand a `public enum`'s marker to the NEXT top-level declaration (fixed upstream in
# 6.6.4), and six consumers compile the bundle under 6.6.3. This enum used to sit
# above `var _SYM_EPS`, which 3.3.0 made private: under 6.6.3 a consumer of the
# private bundle could still read and write it. It now sits directly above
# `expr_tag`, and check-public-surface.sh claim 5 fails any bundle where a
# non-public declaration follows a `public enum`.
# [measured: dist/hisab.cyr from a dir pinned to cycc 6.6.3, 2026-09-30]
public enum ExprTag {
    EXPR_CONST = 0;
    EXPR_VAR   = 1;
    EXPR_ADD   = 2;
    EXPR_MUL   = 3;
    EXPR_POW   = 4;
    EXPR_NEG   = 5;
    EXPR_SIN   = 6;
    EXPR_COS   = 7;
    EXPR_EXP   = 8;
    EXPR_LN    = 9;
}

# Get the tag of an expression node
public fn expr_tag(e) {
    return load64(e);
}

# ================================================================
# Constructors
# ================================================================

# Create a constant expression node
public fn expr_const(val) {
    var e = alloc(16);
    store64(e, EXPR_CONST);
    store64(e + 8, val);
    return e;
}

# Create a variable expression node (name is a Str)
public fn expr_var(name) {
    var e = alloc(16);
    store64(e, EXPR_VAR);
    store64(e + 8, name);
    return e;
}

# Create an addition node: left + right
public fn expr_add(a, b) {
    var e = alloc(24);
    store64(e, EXPR_ADD);
    store64(e + 8, a);
    store64(e + 16, b);
    return e;
}

# Create a multiplication node: left * right
public fn expr_mul(a, b) {
    var e = alloc(24);
    store64(e, EXPR_MUL);
    store64(e + 8, a);
    store64(e + 16, b);
    return e;
}

# Create a power node: base ^ exponent
public fn expr_pow(a, b) {
    var e = alloc(24);
    store64(e, EXPR_POW);
    store64(e + 8, a);
    store64(e + 16, b);
    return e;
}

# Create a negation node: -child
public fn expr_neg(a) {
    var e = alloc(16);
    store64(e, EXPR_NEG);
    store64(e + 8, a);
    return e;
}

# Create a sin node: sin(child)
public fn expr_sin(a) {
    var e = alloc(16);
    store64(e, EXPR_SIN);
    store64(e + 8, a);
    return e;
}

# Create a cos node: cos(child)
public fn expr_cos(a) {
    var e = alloc(16);
    store64(e, EXPR_COS);
    store64(e + 8, a);
    return e;
}

# Create an exp node: e^child
public fn expr_exp(a) {
    var e = alloc(16);
    store64(e, EXPR_EXP);
    store64(e + 8, a);
    return e;
}

# Create a ln node: ln(child)
public fn expr_ln(a) {
    var e = alloc(16);
    store64(e, EXPR_LN);
    store64(e + 8, a);
    return e;
}

# ================================================================
# Accessor helpers
# ================================================================

# Get the f64 value from a CONST node
public fn expr_const_val(e) {
    return load64(e + 8);
}

# Get the Str name from a VAR node
public fn expr_var_name(e) {
    return load64(e + 8);
}

# Get the left child from a binary node (ADD, MUL, POW)
public fn expr_left(e) {
    return load64(e + 8);
}

# Get the right child from a binary node (ADD, MUL, POW)
public fn expr_right(e) {
    return load64(e + 16);
}

# Get the child from a unary node (NEG, SIN, COS, EXP, LN)
public fn expr_child(e) {
    return load64(e + 8);
}

# ================================================================
# Evaluate
# ================================================================

# Evaluate an expression tree given a vec of (Str, f64) variable bindings.
# vars is a vec where each element is a pointer to a 16-byte pair: { name: Str, value: f64 }.
# Returns an f64 value. If a variable is not found it writes a warning to fd 2
# and returns 0.0 -- it does NOT abort. (The doc said "Aborts" through 2.6.14,
# and a test was skipped on the strength of that false claim.)
public fn expr_eval(e, vars) {
    var t = expr_tag(e);

    if (t == EXPR_CONST) {
        return expr_const_val(e);
    }

    if (t == EXPR_VAR) {
        var name = expr_var_name(e);
        var vi = 0;
        var vlen = vec_len(vars);
        while (vi < vlen) {
            var pair = vec_get(vars, vi);
            var pname = load64(pair);
            if (str_eq(name, pname) == 1) {
                return load64(pair + 8);
            }
            vi = vi + 1;
        }
        # Variable not found -- return 0 and log a warning to stderr; do not abort.
        # 0 is also a legal value, so a caller cannot tell a miss from a result: the
        # fabricated-answer class. Through 3.3.1 this line said NaN "would be better but
        # no NaN constant". That was never the obstacle: a quiet NaN is one hex literal,
        # 0x7FF8000000000000, which lib/math.cyr already returns for the log of a
        # negative. The 0 and the fd-2 write are public behaviour (abuse.tcyr's group
        # "abuse: symbolic differentiation and simplification of degenerate trees" pins
        # both), so replacing them is roadmap [3.4.0], audit D074.
        # ⚠ 3.2.2: EVERY BYTE OF THE WARNING GOES TO fd 2. The name went out through
        # `str_print`, which writes fd 1, so a harness capturing the two streams
        # separately got the message with its variable name orphaned on stdout (the
        # split `lib/assert.cyr` repaired in its own FAIL line at 6.5.19). cyrius
        # 6.6.12's test runner interleaves the streams differently and exposed it.
        syscall(1, 2, "expr_eval: warning: undefined variable: ", 40);
        syscall(1, 2, str_data(name), str_len(name));
        syscall(1, 2, "\n", 1);
        return 0;
    }

    if (t == EXPR_ADD) {
        return f64_add(expr_eval(expr_left(e), vars),
          expr_eval(expr_right(e), vars));
    }

    if (t == EXPR_MUL) {
        return f64_mul(expr_eval(expr_left(e), vars),
          expr_eval(expr_right(e), vars));
    }

    if (t == EXPR_POW) {
        return ganita_f64_pow(expr_eval(expr_left(e), vars),
          expr_eval(expr_right(e), vars));
    }

    if (t == EXPR_NEG) {
        return f64_neg(expr_eval(expr_child(e), vars));
    }

    if (t == EXPR_SIN) {
        return f64_sin(expr_eval(expr_child(e), vars));
    }

    if (t == EXPR_COS) {
        return f64_cos(expr_eval(expr_child(e), vars));
    }

    if (t == EXPR_EXP) {
        return f64_exp(expr_eval(expr_child(e), vars));
    }

    if (t == EXPR_LN) {
        return f64_ln(expr_eval(expr_child(e), vars));
    }

    # Unknown tag -- return 0 with warning (the same roadmap [3.4.0] item, audit D074)
    syscall(1, 2, "expr_eval: warning: unknown tag\n", 32);
    return 0;
}

# Helper: create a variable binding pair (for use with expr_eval)
public fn expr_bind(name, value) {
    var pair = alloc(16);
    store64(pair, name);
    store64(pair + 8, value);
    return pair;
}

# ================================================================
# Differentiate
# ================================================================

# Symbolic differentiation of expr with respect to var_name (a Str).
# Returns a new expression tree representing the derivative.
public fn expr_diff(e, var_name) {
    var t = expr_tag(e);

    # d/dx(c) = 0
    if (t == EXPR_CONST) {
        return expr_const(0);
    }

    # d/dx(x) = 1, d/dx(y) = 0
    if (t == EXPR_VAR) {
        if (str_eq(expr_var_name(e), var_name) == 1) {
            return expr_const(F64_ONE);
        }
        return expr_const(0);
    }

    # d/dx(a + b) = a' + b'
    if (t == EXPR_ADD) {
        return expr_add(expr_diff(expr_left(e), var_name),
          expr_diff(expr_right(e), var_name));
    }

    # d/dx(a * b) = a'*b + a*b'  (product rule)
    if (t == EXPR_MUL) {
        var a = expr_left(e);
        var b = expr_right(e);
        return expr_add(
          expr_mul(expr_diff(a, var_name), b),
          expr_mul(a, expr_diff(b, var_name))
          );
    }

    # d/dx(base ^ exp)
    if (t == EXPR_POW) {
        var base = expr_left(e);
        var exp = expr_right(e);
        # If exponent is a constant: d/dx(f^n) = n * f^(n-1) * f'
        if (expr_tag(exp) == EXPR_CONST) {
            var n = expr_const_val(exp);
            return expr_mul(
              expr_mul(
                expr_const(n),
                expr_pow(base, expr_const(f64_sub(n, F64_ONE)))
                ),
              expr_diff(base, var_name)
              );
        }
        # General case: d/dx(f^g) = f^g * (g'*ln(f) + g*f'/f)
        var ln_f = expr_ln(base);
        var f_prime = expr_diff(base, var_name);
        var g_prime = expr_diff(exp, var_name);
        return expr_mul(
          expr_pow(base, exp),
          expr_add(
            expr_mul(g_prime, ln_f),
            expr_mul(
              exp,
              expr_mul(f_prime, expr_pow(base, expr_const(f64_neg(F64_ONE))))
              )
            )
          );
    }

    # d/dx(-f) = -f'
    if (t == EXPR_NEG) {
        return expr_neg(expr_diff(expr_child(e), var_name));
    }

    # d/dx(sin(f)) = cos(f) * f'
    if (t == EXPR_SIN) {
        var a = expr_child(e);
        return expr_mul(expr_cos(a), expr_diff(a, var_name));
    }

    # d/dx(cos(f)) = -sin(f) * f'
    if (t == EXPR_COS) {
        var a = expr_child(e);
        return expr_neg(expr_mul(expr_sin(a), expr_diff(a, var_name)));
    }

    # d/dx(exp(f)) = exp(f) * f'
    if (t == EXPR_EXP) {
        var a = expr_child(e);
        return expr_mul(expr_exp(a), expr_diff(a, var_name));
    }

    # d/dx(ln(f)) = f' / f  (represented as f' * f^(-1))
    if (t == EXPR_LN) {
        var a = expr_child(e);
        return expr_mul(
          expr_diff(a, var_name),
          expr_pow(a, expr_const(f64_neg(F64_ONE)))
          );
    }

    # Unknown tag -- return 0
    return expr_const(0);
}

# ================================================================
# Simplify
# ================================================================

# Simplify an expression using basic algebraic rules.
# Rules: 0+x=x, x+0=x, 0*x=0, 1*x=x, x*1=x, x^0=1, x^1=x,
#        const folding, double negation, neg(0)=0.
# Returns a new (simplified) expression tree.
public fn expr_simplify(e) {
    var t = expr_tag(e);

    # Leaves: constants and variables are already simplified
    if (t == EXPR_CONST) { return e; }
    if (t == EXPR_VAR) { return e; }

    # ADD
    if (t == EXPR_ADD) {
        var a = expr_simplify(expr_left(e));
        var b = expr_simplify(expr_right(e));
        var ta = expr_tag(a);
        var tb = expr_tag(b);
        # 0 + b = b
        if (ta == EXPR_CONST) {
            if (_sym_is_zero(expr_const_val(a)) == 1) { return b; }
        }
        # a + 0 = a
        if (tb == EXPR_CONST) {
            if (_sym_is_zero(expr_const_val(b)) == 1) { return a; }
        }
        # const + const = const
        if (ta == EXPR_CONST) {
            if (tb == EXPR_CONST) {
                return expr_const(f64_add(expr_const_val(a), expr_const_val(b)));
            }
        }
        return expr_add(a, b);
    }

    # MUL
    if (t == EXPR_MUL) {
        var a = expr_simplify(expr_left(e));
        var b = expr_simplify(expr_right(e));
        var ta = expr_tag(a);
        var tb = expr_tag(b);
        # 0 * b = 0
        if (ta == EXPR_CONST) {
            if (_sym_is_zero(expr_const_val(a)) == 1) { return expr_const(0); }
        }
        # a * 0 = 0
        if (tb == EXPR_CONST) {
            if (_sym_is_zero(expr_const_val(b)) == 1) { return expr_const(0); }
        }
        # 1 * b = b
        if (ta == EXPR_CONST) {
            if (_sym_is_one(expr_const_val(a)) == 1) { return b; }
        }
        # a * 1 = a
        if (tb == EXPR_CONST) {
            if (_sym_is_one(expr_const_val(b)) == 1) { return a; }
        }
        # const * const = const
        if (ta == EXPR_CONST) {
            if (tb == EXPR_CONST) {
                return expr_const(f64_mul(expr_const_val(a), expr_const_val(b)));
            }
        }
        return expr_mul(a, b);
    }

    # POW
    if (t == EXPR_POW) {
        var base = expr_simplify(expr_left(e));
        var exp = expr_simplify(expr_right(e));
        var tb = expr_tag(base);
        var te = expr_tag(exp);
        # x^0 = 1
        if (te == EXPR_CONST) {
            if (_sym_is_zero(expr_const_val(exp)) == 1) { return expr_const(F64_ONE); }
        }
        # x^1 = x
        if (te == EXPR_CONST) {
            if (_sym_is_one(expr_const_val(exp)) == 1) { return base; }
        }
        # const ^ const = const
        if (tb == EXPR_CONST) {
            if (te == EXPR_CONST) {
                return expr_const(ganita_f64_pow(expr_const_val(base), expr_const_val(exp)));
            }
        }
        return expr_pow(base, exp);
    }

    # NEG
    if (t == EXPR_NEG) {
        var a = expr_simplify(expr_child(e));
        var ta = expr_tag(a);
        # -0 = 0
        if (ta == EXPR_CONST) {
            if (_sym_is_zero(expr_const_val(a)) == 1) { return expr_const(0); }
        }
        # -c = const(-c)
        if (ta == EXPR_CONST) {
            return expr_const(f64_neg(expr_const_val(a)));
        }
        # --x = x
        if (ta == EXPR_NEG) {
            return expr_simplify(expr_child(a));
        }
        return expr_neg(a);
    }

    # SIN
    if (t == EXPR_SIN) {
        return expr_sin(expr_simplify(expr_child(e)));
    }

    # COS
    if (t == EXPR_COS) {
        return expr_cos(expr_simplify(expr_child(e)));
    }

    # EXP -- fold exp(const)
    if (t == EXPR_EXP) {
        var a = expr_simplify(expr_child(e));
        if (expr_tag(a) == EXPR_CONST) {
            return expr_const(f64_exp(expr_const_val(a)));
        }
        return expr_exp(a);
    }

    # LN -- fold ln(const)
    if (t == EXPR_LN) {
        var a = expr_simplify(expr_child(e));
        if (expr_tag(a) == EXPR_CONST) {
            return expr_const(f64_ln(expr_const_val(a)));
        }
        return expr_ln(a);
    }

    return e;
}

# ================================================================
# To string
# ================================================================

# A constant as text, exactly as expr_to_str and sym_to_latex render it: an integral
# value as its digits -- exact at every magnitude, see _sym_int_exact_buf -- any other
# finite value with exactly 6 decimal places, zero-padded (0.5 is "0.500000"; through
# 3.3.1 this said "up to 6", but `_sym_render_f64` zero-padded as fmt_float_buf does),
# and inf / NaN as "inf", "-inf", "nan", "-nan". Both renderers call this one function,
# so the 2.20.0 property "the two renderers agree at every magnitude" holds by
# construction. (Each renderer carried its own copy through 3.2.x.)
#must_use
public fn sym_const_to_str(val) {
    # Check if it is an integer value
    var floored = f64_floor(val);
    var diff = f64_abs(f64_sub(val, floored));
    if (f64_lt(diff, _SYM_EPS) == 1) {
        # `f64_to` is exact below 2^63 and SATURATES at or above it, so the
        # fast path is bounded by that and everything beyond renders exactly.
        # ⛔ 3.3.2 — RENDER THE INTEGER THAT WAS TESTED, NOT `val`. The test above is
        # against floor(val), but this rendered f64_to(val), which truncates toward
        # ZERO: for a negative value within _SYM_EPS above an integer -n it printed
        # -(n-1). 21 doubles in (-8, -1) did, e.g. -0.9999999999999999 rendered "0"
        # and -5.999999999999999 "-5", through expr_to_str and sym_to_latex alike;
        # positives and every |val| >= 8 (f64 spacing > _SYM_EPS there) never could.
        # [measured: scratch sweep of every f64 within 1e-15 of each integer in [-12, 12], 2026-10-01]
        if (f64_lt(f64_abs(val), _SYM_2_POW_63) == 1) {
            return str_from_int(f64_to(floored));
        }
        var ibuf = alloc(_INT_EXACT_BUF);
        var ilen = _sym_int_exact_buf(val, ibuf);
        return str_from_buf(ibuf, ilen);
    }
    # Render with 6 decimal places (inf / nan as the bare tokens). Only finite
    # non-integral |val| < 2^52 (every f64 at or above 2^52 is integral) and inf/nan
    # get here. stdlib fmt_float_buf carries a fraction that rounds up to 10^6 into
    # the integer part (since cyrius 6.5.30), so 0.9999999 renders "1.000000", not
    # "0.1000000". From 2.7.0 through 3.3.1 hisab carried its own copy with the carry,
    # `_sym_render_f64`, written while the stdlib still dropped it. Retired in 3.3.2:
    # over 3,538,970 inputs (3,203,636 of them reaching this branch) the old and new
    # sym_const_to_str rendered byte-identically, 0 mismatches, under each of the
    # eleven cycc releases 6.6.2 through 6.6.12. Control (6.6.12): with the old carry
    # mutated out, the same harness counted 45,540 mismatches.
    # [measured: scratch differential harness, not reproducible in-tree, 2026-10-01; cycc 6.6.2 to 6.6.12]
    var buf = alloc(_FLOAT_RENDER_BUF);
    var len = fmt_float_buf(val, buf, 6);
    return str_from_buf(buf, len);
}

# Convert an expression tree to a human-readable Str.
# Returns a Str (fat pointer).
public fn expr_to_str(e) {
    var t = expr_tag(e);

    if (t == EXPR_CONST) {
        return sym_const_to_str(expr_const_val(e));
    }

    if (t == EXPR_VAR) {
        return expr_var_name(e);
    }

    if (t == EXPR_ADD) {
        var sb = str_builder_new();
        str_builder_add_cstr(sb, "(");
        str_builder_add(sb, expr_to_str(expr_left(e)));
        str_builder_add_cstr(sb, " + ");
        str_builder_add(sb, expr_to_str(expr_right(e)));
        str_builder_add_cstr(sb, ")");
        return str_builder_build(sb);
    }

    if (t == EXPR_MUL) {
        var sb = str_builder_new();
        str_builder_add_cstr(sb, "(");
        str_builder_add(sb, expr_to_str(expr_left(e)));
        str_builder_add_cstr(sb, " * ");
        str_builder_add(sb, expr_to_str(expr_right(e)));
        str_builder_add_cstr(sb, ")");
        return str_builder_build(sb);
    }

    if (t == EXPR_POW) {
        var sb = str_builder_new();
        str_builder_add_cstr(sb, "(");
        str_builder_add(sb, expr_to_str(expr_left(e)));
        str_builder_add_cstr(sb, "^");
        str_builder_add(sb, expr_to_str(expr_right(e)));
        str_builder_add_cstr(sb, ")");
        return str_builder_build(sb);
    }

    if (t == EXPR_NEG) {
        var sb = str_builder_new();
        str_builder_add_cstr(sb, "-");
        str_builder_add(sb, expr_to_str(expr_child(e)));
        return str_builder_build(sb);
    }

    if (t == EXPR_SIN) {
        var sb = str_builder_new();
        str_builder_add_cstr(sb, "sin(");
        str_builder_add(sb, expr_to_str(expr_child(e)));
        str_builder_add_cstr(sb, ")");
        return str_builder_build(sb);
    }

    if (t == EXPR_COS) {
        var sb = str_builder_new();
        str_builder_add_cstr(sb, "cos(");
        str_builder_add(sb, expr_to_str(expr_child(e)));
        str_builder_add_cstr(sb, ")");
        return str_builder_build(sb);
    }

    if (t == EXPR_EXP) {
        var sb = str_builder_new();
        str_builder_add_cstr(sb, "exp(");
        str_builder_add(sb, expr_to_str(expr_child(e)));
        str_builder_add_cstr(sb, ")");
        return str_builder_build(sb);
    }

    if (t == EXPR_LN) {
        var sb = str_builder_new();
        str_builder_add_cstr(sb, "ln(");
        str_builder_add(sb, expr_to_str(expr_child(e)));
        str_builder_add_cstr(sb, ")");
        return str_builder_build(sb);
    }

    return str_from("?");
}
