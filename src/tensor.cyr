# tensor.cyr -- N-dimensional tensor algebra
# Usage: shipped inside dist/hisab.cyr; in-tree, include "src/tensor.cyr" after what it requires
# Requires: no other hisab module (stdlib resolves via cyrius.cyml [deps])
#
# Dense tensor: flat f64 array with shape metadata.
# Layout: { rank: i64, shape_ptr: i64, data_ptr: i64, total_size: i64 } = 32 bytes

#derive(accessors)
public struct HTensor { rank; shape; data; total; }

var _TENSOR_MAX_ELEMS = 1048576;  # 1M elements max (8MB)

# A zero-filled dense tensor of the given rank (0..8) and shape (rank i64 extents, each
# >= 1, read from `shape` and copied), row-major. Returns the handle, or the designed 0
# for a rank outside 0..8, an extent <= 0, more than _TENSOR_MAX_ELEMS (2^20) elements in
# all, or a refused allocation. A rank-0 tensor holds one element and has no shape array.
public fn tensor_new(rank, shape) {
    if (rank < 0 || rank > 8) { return 0; }  # Sanity cap
    var t = hisab_alloc(sizeof(HTensor));
    if (t == 0) { return 0; }
    HTensor_set_rank(t, rank);
    # Copy shape array
    var sp = hisab_alloc(rank * 8);
    # alloc(0) is 0 by design, so a rank-0 tensor's shape is 0 and never read.
    if (sp == 0) { if (rank > 0) { return 0; } }
    var total = 1;
    var i = 0;
    while (i < rank) {
        var dim = load64(shape + i * 8);
        if (dim <= 0) { return 0; }
        store64(sp + i * 8, dim);
        if (total > _TENSOR_MAX_ELEMS / dim) { return 0; }  # Overflow guard
        total = total * dim;
        i = i + 1;
    }
    HTensor_set_shape(t, sp);
    # Allocate zeroed data
    var dp = hisab_alloc(total * 8);
    if (dp == 0) { return 0; }
    i = 0;
    while (i < total) {
        store64(dp + i * 8, 0);
        i = i + 1;
    }
    HTensor_set_data(t, dp);
    HTensor_set_total(t, total);
    return t;
}

# Compute flat index from multi-index (row-major). Unchecked: the callers below either built the
# indices in range (`tensor_contract`) or checked them (`_tensor_flat_checked`).
fn _tensor_flat_idx(t, indices) {
    var rank = HTensor_rank(t);
    var shape = HTensor_shape(t);
    var idx = 0;
    var stride = 1;
    var i = rank - 1;
    while (i >= 0) {
        idx = idx + load64(indices + i * 8) * stride;
        stride = stride * load64(shape + i * 8);
        i = i - 1;
    }
    return idx;
}

# The flat index of the multi-index `indices` in t, or a negative HSB_ERR_* code:
# HSB_ERR_INVALID_INPUT for t = 0 (or indices = 0 at a rank above 0), HSB_ERR_OUT_OF_RANGE for an
# index outside [0, extent) on its axis.
fn _tensor_flat_checked(t, indices) {
    if (t == 0) { return HSB_ERR_INVALID_INPUT; }
    var rank = HTensor_rank(t);
    if (rank == 0) { return 0; }
    if (indices == 0) { return HSB_ERR_INVALID_INPUT; }
    var shape = HTensor_shape(t);
    var i = 0;
    while (i < rank) {
        var k = load64(indices + i * 8);
        if (k < 0 || k >= load64(shape + i * 8)) { return HSB_ERR_OUT_OF_RANGE; }
        i = i + 1;
    }
    return _tensor_flat_idx(t, indices);
}

# ⛔ 3.5.0 — tensor_get, tensor_set, tensor_get2 AND tensor_set2 NEVER RANGE-CHECKED THEIR
# INDICES (roadmap [3.5.0], AU3-F12 = AU2-G3-F11, rated high): on shape [2, 2], tensor_set(t, [2,
# 0], 999.0) overwrote the next tensor's rank, and [-1, 0] t's own shape[0]; the 2-D pair read
# the column count past a rank-1 shape array. An f64 has no failure value, so the readers could
# not refuse in place: the four are retired for the `_checked` forms below, which return a Result
# and touch nothing on a refusal. (Inside this file and einsum.cyr the multi-index is built in
# range, and read unchecked.)

# The element at the multi-index `indices` (rank i64s, row-major), as `Ok(bits)`;
# `Err(HSB_ERR_OUT_OF_RANGE)` for an index outside [0, extent) on its axis,
# `Err(HSB_ERR_INVALID_INPUT)` for t = 0 or indices = 0 (a rank-0 tensor reads its one element and
# no index). `indices` must hold rank values: its length cannot be checked.
#must_use
public fn tensor_get_checked(t, indices) {
    var flat = _tensor_flat_checked(t, indices);
    if (flat < 0) { return Err(flat); }
    return Ok(load64(HTensor_data(t) + flat * 8));
}

# Store the f64 bits `val` at the multi-index `indices`, `Ok(0)`, with `tensor_get_checked`'s
# Errs, before anything is written.
#must_use
public fn tensor_set_checked(t, indices, val) {
    var flat = _tensor_flat_checked(t, indices);
    if (flat < 0) { return Err(flat); }
    store64(HTensor_data(t) + flat * 8, val);
    return Ok(0);
}

# ================================================================
# 2D convenience (matrix-like access)
# ================================================================

# Cost: 18 -> 36 ns against 3.4.2's unchecked `tensor_get2` (the bound tests and the Result).
# [measured: scratch bench/ab.cyr, 3.4.2 and this tree interleaved x 6, taskset, 2026-11-14; noisy, 8 lanes]
# The element (i, j) of a rank-2 tensor (row i, column j), as `Ok(bits)`;
# `Err(HSB_ERR_OUT_OF_RANGE)` for i or j outside its extent, `Err(HSB_ERR_INVALID_INPUT)` for t = 0
# or a rank other than 2.
#must_use
public fn tensor_get2_checked(t, i, j) {
    if (t == 0) { return Err(HSB_ERR_INVALID_INPUT); }
    if (HTensor_rank(t) != 2) { return Err(HSB_ERR_INVALID_INPUT); }
    var rows = load64(HTensor_shape(t));
    var cols = load64(HTensor_shape(t) + 8);
    if (i < 0 || i >= rows || j < 0 || j >= cols) { return Err(HSB_ERR_OUT_OF_RANGE); }
    return Ok(load64(HTensor_data(t) + (i * cols + j) * 8));
}

# Store `val` at (i, j) of a rank-2 tensor, `Ok(0)`, with `tensor_get2_checked`'s Errs, before
# anything is written.
#must_use
public fn tensor_set2_checked(t, i, j, val) {
    if (t == 0) { return Err(HSB_ERR_INVALID_INPUT); }
    if (HTensor_rank(t) != 2) { return Err(HSB_ERR_INVALID_INPUT); }
    var rows = load64(HTensor_shape(t));
    var cols = load64(HTensor_shape(t) + 8);
    if (i < 0 || i >= rows || j < 0 || j >= cols) { return Err(HSB_ERR_OUT_OF_RANGE); }
    store64(HTensor_data(t) + (i * cols + j) * 8, val);
    return Ok(0);
}

# ================================================================
# Tensor operations
# ================================================================

# Elementwise sum of two tensors of IDENTICAL shape.
# Returns a fresh tensor, or 0 if either operand is null or the shapes differ.
public fn tensor_add(a, b) {
    # Either operand may be the designed 0 that tensor_new returns above its rank
    # or element cap, or that einsum returns on a malformed subscript string;
    # HTensor_total(0) is a null dereference, so guard before reading metadata.
    if (a == 0) { return 0; }
    if (b == 0) { return 0; }
    var total = HTensor_total(a);
    var rank = HTensor_rank(a);
    # SHAPE EQUALITY. The loop below walks total(a) elements of BOTH data buffers.
    # b's buffer is allocated at exactly total(b)*8 bytes, so a smaller b was read
    # out of bounds -- a 2x2 plus a 2x1 over-read 16 bytes of adjacent heap and
    # returned it as tensor entries. Rank alone is not enough: 2x6 and 3x4 have
    # the same total but are not addable, so every axis is compared.
    if (HTensor_rank(b) != rank) { return 0; }
    var si = 0;
    while (si < rank) {
        if (load64(HTensor_shape(b) + si * 8) != load64(HTensor_shape(a) + si * 8)) { return 0; }
        si = si + 1;
    }
    var r = tensor_new(rank, HTensor_shape(a));
    if (r == 0) { return 0; }
    var ad = HTensor_data(a);
    var bd = HTensor_data(b);
    var rd = HTensor_data(r);
    var i = 0;
    while (i < total) {
        store64(rd + i * 8, f64_add(load64(ad + i * 8), load64(bd + i * 8)));
        i = i + 1;
    }
    return r;
}

# Scale every entry of t by the f64 s.
# Returns a fresh tensor, or 0 if t is null.
public fn tensor_scale(t, s) {
    # t may be the designed 0 that tensor_new or einsum returns on failure;
    # HTensor_total(0) is a null dereference, so guard before reading metadata.
    if (t == 0) { return 0; }
    var total = HTensor_total(t);
    var rank = HTensor_rank(t);
    var r = tensor_new(rank, HTensor_shape(t));
    if (r == 0) { return 0; }
    var td = HTensor_data(t);
    var rd = HTensor_data(r);
    var i = 0;
    while (i < total) {
        store64(rd + i * 8, f64_mul(load64(td + i * 8), s));
        i = i + 1;
    }
    return r;
}

# Contract indices idx_i and idx_j of a rank-N tensor (trace over those two indices).
# The two indices must be distinct, in [0, rank), and have the same dimension.
# Returns a fresh rank-(N-2) tensor for N >= 3. A rank-2 input (a full trace) returns a
# rank-1 tensor of shape [1] holding the scalar, not a rank-0 tensor (3.4.1: this said
# rank N-2 for every N). Returns 0 if t is null or the indices are invalid.
public fn tensor_contract(t, idx_i, idx_j) {
    # t may be the designed 0 that tensor_new or einsum returns on failure;
    # HTensor_rank(0) is a null dereference, so guard before reading metadata.
    if (t == 0) { return 0; }
    var rank = HTensor_rank(t);
    var shape = HTensor_shape(t);
    # AXIS VALIDATION. Nothing checked these through 2.8.2, and every one of them
    # is a raw store64/load64 offset below: `load64(shape + idx_i * 8)` reads
    # outside the rank*8-byte shape array for idx_i >= rank and BEFORE it for a
    # negative index, and `store64(full_idx + ii * 8, k)` then writes there. A
    # trace needs two DISTINCT axes of a rank >= 2 tensor, and the contracted
    # extents must match or the k loop indexes one axis past its own extent.
    if (rank < 2) { return 0; }
    if (idx_i < 0 || idx_i >= rank) { return 0; }
    if (idx_j < 0 || idx_j >= rank) { return 0; }
    if (idx_i == idx_j) { return 0; }
    var dim = load64(shape + idx_i * 8);
    if (load64(shape + idx_j * 8) != dim) { return 0; }
    var new_rank = rank - 2;

    # Ensure idx_i < idx_j for consistency
    var ii = idx_i; var jj = idx_j;
    if (ii > jj) { var tmp = ii; ii = jj; jj = tmp; }

    # Build output shape (skip positions ii and jj)
    var ns = hisab_alloc((new_rank + 1) * 8);  # +1 to avoid alloc(0)
    if (ns == 0) { return 0; }
    var ni = 0;
    var oi = 0;
    while (oi < rank) {
        if (oi != ii && oi != jj) {
            store64(ns + ni * 8, load64(shape + oi * 8));
            ni = ni + 1;
        }
        oi = oi + 1;
    }

    # Handle scalar result (rank-0)
    if (new_rank == 0) {
        store64(ns, 1);
        var result = tensor_new(1, ns);
        if (result == 0) { return 0; }
        var sum = 0;
        # HOISTED out of the k loop (2026-08-04 audit, performance). This is a bump
        # allocator that never frees, so an alloc per iteration is arena growth
        # proportional to `dim` on every call. Only slots ii and jj change per
        # iteration and both are overwritten below, so one buffer zeroed once is
        # identical. Measured on a 200x200 full trace: 3,256 B of arena per call
        # before, 72 B after (-3,184 B, -97.8%). The other contraction path's
        # full_idx (below, before the out_idx loop) was ALREADY hoisted and is
        # unchanged -- measured 1,272 B per call on a 12^4 rank-4 contraction both
        # before and after this edit.
        # [measured: CHANGELOG.md 2.9.0, the tensor.cyr arena row (3,256 B -> 72 B) and the 1,272 B rank-4 figure]
        var full_idx = hisab_alloc(rank * 8);
        if (full_idx == 0) { return 0; }
        var fi = 0;
        while (fi < rank) { store64(full_idx + fi * 8, 0); fi = fi + 1; }
        var k = 0;
        while (k < dim) {
            # Build full index with ii=k, jj=k, all others=0
            store64(full_idx + ii * 8, k);
            store64(full_idx + jj * 8, k);
            sum = f64_add(sum, load64(HTensor_data(t) + _tensor_flat_idx(t, full_idx) * 8));
            k = k + 1;
        }
        store64(HTensor_data(result), sum);
        return result;
    }

    var result = tensor_new(new_rank, ns);
    if (result == 0) { return 0; }
    var out_total = HTensor_total(result);
    var rd = HTensor_data(result);

    # Compute strides for the output tensor (for multi-index expansion)
    var out_strides = hisab_alloc(new_rank * 8);
    if (out_strides == 0) { return 0; }
    var si = new_rank - 1;
    var stride = 1;
    while (si >= 0) {
        store64(out_strides + si * 8, stride);
        stride = stride * load64(ns + si * 8);
        si = si - 1;
    }

    # For each output flat index, expand to multi-index, insert contracted index, sum
    var full_idx = hisab_alloc(rank * 8);
    if (full_idx == 0) { return 0; }
    var out_idx = 0;
    while (out_idx < out_total) {
        # Expand out_idx to output multi-index
        var remaining = out_idx;
        var omi = 0;
        while (omi < new_rank) {
            var os = load64(out_strides + omi * 8);
            var idx_val = remaining / os;
            remaining = remaining - idx_val * os;
            # Map output index omi to input index (skip ii and jj)
            var input_pos = omi;
            if (input_pos >= ii) { input_pos = input_pos + 1; }
            if (input_pos >= jj) { input_pos = input_pos + 1; }
            store64(full_idx + input_pos * 8, idx_val);
            omi = omi + 1;
        }

        # Sum over contracted dimension
        var sum = 0;
        var k = 0;
        while (k < dim) {
            store64(full_idx + ii * 8, k);
            store64(full_idx + jj * 8, k);
            sum = f64_add(sum, load64(HTensor_data(t) + _tensor_flat_idx(t, full_idx) * 8));
            k = k + 1;
        }
        store64(rd + out_idx * 8, sum);
        out_idx = out_idx + 1;
    }
    return result;
}

# ================================================================
# Standard physics tensors
# ================================================================

# Kronecker delta delta_ij, as f64 bits (+1.0 / 0.0), for any integer indices.
public fn kronecker_delta(i, j) {
    if (i == j) { return F64_ONE; }
    return 0;
}

# Minkowski metric eta_munu = diag(+1, -1, -1, -1) [particle physics convention], as f64
# bits. For mu, nu in 0..3 it is that matrix. Any other integers get the same rule, not a
# refusal: 0 off the diagonal (mu != nu), +1.0 at (0, 0), -1.0 at every other diagonal
# index, negative ones included (minkowski(9, 9) = minkowski(-1, -1) = -1.0) -- the metric
# of R^{1,n} for indices 0..n, as kronecker_delta extends to any integers.
# [measured: tests/modules_c.tcyr "3.4.1 LIE2: tensor symbols", baseline 3.4.0]
public fn minkowski(i, j) {
    if (i != j) { return 0; }
    if (i == 0) { return F64_ONE; }
    return f64_neg(F64_ONE);
}

# Levi-Civita symbol eps_{ijk} (3D). Returns an f64 BIT PATTERN (+1.0 / 0.0 / -1.0),
# matching kronecker_delta and minkowski above -- every value in this section is a
# tensor COMPONENT and is consumed by f64_mul / f64_add.
#
# Through 2.6.15 these returned RAW i64. That is not a cosmetic type mismatch: the
# raw (0 - 1) is the bit pattern 0xFFFF_FFFF_FFFF_FFFF, a NEGATIVE NaN, so an eps
# contraction such as c_i = sum_jk eps_ijk a_j b_k poisoned every component --
# including the ones that are exactly zero, since NaN * 0.0 = NaN. Raw 1 is
# 2^-1074 (the smallest subnormal), not 1.0.
#
# The `return 0` branches are deliberately left alone: integer 0 and f64 +0.0 are
# the same 64-bit word, so they already satisfy the contract.
#
# For indices 0..2 it is the symbol. Any other integers get levi_civita_4's rule, the one
# rule for both symbols: 0 for a repeated index, else the sign of the permutation that
# sorts the three (levi_civita_3(0, 1, 3) = +1.0, levi_civita_3(9, 5, -1) = -1.0).
# ⛔ 3.4.0 AND EARLIER — any distinct triple other than the six permutations of 0..2 fell
# through to the odd-permutation return: levi_civita_3(0, 1, 3) was -1.0 (and (-1, 5, 9)
# too), the wrong sign -- the permutation that sorts it is the identity, which is even.
# [measured: tests/modules_c.tcyr "3.4.1 LIE2: tensor symbols", baseline 3.4.0]
public fn levi_civita_3(i, j, k) {
    if (i == j || j == k || i == k) { return 0; }
    # Inversions of (i, j, k): an even count is an even permutation of the sorted triple.
    var inv = 0;
    if (i > j) { inv = inv + 1; }
    if (i > k) { inv = inv + 1; }
    if (j > k) { inv = inv + 1; }
    if (inv % 2 == 0) { return F64_ONE; }
    return f64_neg(F64_ONE);
}

# 4D Levi-Civita. Same f64-bit-pattern contract as levi_civita_3, for indices 0..3. Any
# other integers are answered by the same rule as levi_civita_3, not refused: 0 for a
# repeated index, else the sign of the permutation that sorts the four
# (levi_civita_4(-1, 5, 9, 12) = +1.0).
public fn levi_civita_4(i, j, k, l) {
    # Check for repeated indices
    if (i == j || i == k || i == l || j == k || j == l || k == l) { return 0; }
    # Count inversions to determine sign
    var inv = 0;
    # A stack array (3.4.0): the answer is a component, with no value left for a refused
    # allocation; through 3.3.7 this stored through an unchecked 32-byte heap block.
    var arr_buf: i64[4];
    var arr = &arr_buf;
    store64(arr, i); store64(arr + 8, j); store64(arr + 16, k); store64(arr + 24, l);
    var a = 0;
    while (a < 4) {
        var b = a + 1;
        while (b < 4) {
            if (load64(arr + a * 8) > load64(arr + b * 8)) { inv = inv + 1; }
            b = b + 1;
        }
        a = a + 1;
    }
    if (inv % 2 == 0) { return F64_ONE; }
    return f64_neg(F64_ONE);
}
