# vec2.cyr -- 2D f64 vector type
# Usage: shipped inside dist/hisab.cyr; in-tree, include "src/vec2.cyr" after what it requires
# Requires: src/error.cyr (stdlib resolves via cyrius.cyml [deps])
#
# Heap-allocated: { x: f64, y: f64 } = 16 bytes

#derive(accessors)
public struct HVec2 { x; y; }

# A new HVec2 (x, y): 16 bytes from the heap, the components stored as given (any doubles).
# Returns the designed 0 where the allocation is refused (3.4.0); every constructor below too.
#must_use
public fn hvec2_new(x, y) {
    var v = alloc(sizeof(HVec2));
    if (v == 0) { return 0; }
    HVec2_set_x(v, x);
    HVec2_set_y(v, y);
    return v;
}

# A new zero vector (+0, +0), exact; the designed 0 where the allocation is refused.
#must_use
public fn hvec2_zero() { return hvec2_new(0, 0); }
# A new vector (1, 1), exact; the designed 0 where the allocation is refused.
#must_use
public fn hvec2_one() { return hvec2_new(F64_ONE, F64_ONE); }
# A new vector (s, s), s stored as given (any double, NaN and -0 kept bit for bit); the
# designed 0 where the allocation is refused.
#must_use
public fn hvec2_splat(s) { return hvec2_new(s, s); }

# ================================================================
# Arithmetic
# ================================================================

# a + b, componentwise: each component one IEEE addition, correctly rounded (overflow to
# +-Inf and NaN as IEEE gives them). Returns a new HVec2, or the designed 0 where the
# allocation is refused; so do `hvec2_sub`, `_mul`, `_scale` and `_neg`.
#must_use
public fn hvec2_add(a, b) {
    return hvec2_new(f64_add(HVec2_x(a), HVec2_x(b)), f64_add(HVec2_y(a), HVec2_y(b)));
}

# a - b, componentwise, each component correctly rounded.
#must_use
public fn hvec2_sub(a, b) {
    return hvec2_new(f64_sub(HVec2_x(a), HVec2_x(b)), f64_sub(HVec2_y(a), HVec2_y(b)));
}

# The componentwise (Hadamard) product (ax bx, ay by), each component correctly rounded.
#must_use
public fn hvec2_mul(a, b) {
    return hvec2_new(f64_mul(HVec2_x(a), HVec2_x(b)), f64_mul(HVec2_y(a), HVec2_y(b)));
}

# v times the scalar s, each component correctly rounded.
#must_use
public fn hvec2_scale(v, s) {
    return hvec2_new(f64_mul(HVec2_x(v), s), f64_mul(HVec2_y(v), s));
}

# -v, each component's sign flipped (`f64_neg`; below cycc 6.6.8 it gave +0 for +0).
#must_use
public fn hvec2_neg(v) {
    return hvec2_new(f64_neg(HVec2_x(v)), f64_neg(HVec2_y(v)));
}

# ================================================================
# Products and norms
# ================================================================

# a . b = ax bx + ay by: two products and one sum, within 2u (|ax bx| + |ay by|) of the exact
# value to first order (u = 2^-53); IEEE's zero sign (-0 exactly when both products are -0).
# Overflow and NaN follow IEEE (a product past DBL_MAX is +-Inf).
#must_use
public fn hvec2_dot(a, b) {
    return f64_add(f64_mul(HVec2_x(a), HVec2_x(b)), f64_mul(HVec2_y(a), HVec2_y(b)));
}

# |v|^2 = x^2 + y^2 (`hvec2_dot(v, v)`): +Inf once a square passes DBL_MAX (|x| >= 2^512), and
# subnormal, losing bits, once both |x| and |y| are below 2^-511 (0 below about 2^-537); use
# `hvec2_length` for the magnitude across the whole range.
#must_use
public fn hvec2_length_sq(v) { return hvec2_dot(v, v); }

# ⭐ TWO LEGS IS THE ONE ARITY THE STDLIB ALREADY COVERS. This was a hand-rolled
# scale-by-the-larger-leg loop until it was measured against `ganita_f64_hypot`
# and found **bit-identical on 6294 comparisons** — every binade from 2^-1074 to
# 2^1023, subnormals included, on equal legs, wildly asymmetric legs and negative
# legs, plus zero and ±Inf. Its one divergence, (Inf, NaN), is unreachable from
# `hvec2_length`: a NaN sum satisfies neither guard below and returns `sqrt(NaN)`
# without ever entering the rescue.
# ⚠ The 3- and 4-component helpers in vec3/vec4/quat/lie stay hand-rolled — there
# is no stdlib function of that arity to delegate to. Two legs is the exception,
# not the start of a pattern.
# [measured: scratch equivalence probe, 2026-09-10]
fn _hvec2_len_scaled(v) {
    return ganita_f64_hypot(HVec2_x(v), HVec2_y(v));
}

# ⛔ 2.17.0 — THIS SQUARED BEFORE SUMMING, AND LOST 537 BINADES AT THE BOTTOM AND
# 512 AT THE TOP. `x*x` underflows to zero for any component below 2^-537 and
# overflows to +Inf above 2^511, so a perfectly ordinary vector got a length of
# exactly 0 or exactly +Inf. ⚠ And it was materially wrong BEFORE it reached
# either: a SUBNORMAL sum has already lost most of its mantissa, so the answer is
# finite, plausible and wrong — measured 11.8% out at 2^-539, with nothing to
# signal it. That silent band is the dangerous third of the class.
# [measured: two-sided binade sweep, 2026-09-10]
#
# ⭐ FAST PATH, NOT UNCONDITIONAL SCALING. The naive sum announces its own failure:
# it is subnormal, zero or +Inf exactly when it cannot be trusted, and exact
# otherwise. So take it when it is NORMAL and rescale only when it is not.
# Measured: unconditional scaling costs **+119%** on this helper; the fast path
# costs **+12%** and is not distinguishable in any of the 72 tracked benchmarks
# (median delta -0.03%, the largest move being a row that never calls it).
# ⚠ The trigger is `< F64_TINY`, NOT `== 0` — measured, an `== 0` trigger leaves
# the subnormal band up to 11.8% wrong.
# ⚠ And the `+Inf` short-circuit inside the helper is REQUIRED: without it
# `Inf/Inf` is NaN and the documented infinity contract regresses.
# [measured: 1106-scale two-sided sweep; naive wrong at 60, guarded at 0]
#must_use
public fn hvec2_length(v) {
    var ls = hvec2_length_sq(v);
    if (f64_lt(ls, F64_TINY) == 1) { return _hvec2_len_scaled(v); }
    if (f64_eq(ls, F64_POS_INF) == 1) { return _hvec2_len_scaled(v); }
    return f64_sqrt(ls);
}

# v / |v|, the unit vector along v, for every finite non-zero v from the subnormals to DBL_MAX
# (the scaled copies below), within a few ulp per component (the comment below has the sample
# maxima). The zero vector gives the zero vector (it has no direction: a sentinel, |v| = 0, not
# a unit vector). A NaN component gives NaN components; an infinite one gives NaN in its own
# slot and zeros in the finite ones. Returns the designed 0 where an allocation is refused.
#must_use
public fn hvec2_normalize(v) {
    var len = hvec2_length(v);
    # ⛔ `len` is a LENGTH — degree one in the caller's units — and this tested it
    # against an absolute 1e-12, so a perfectly good short vector normalised to
    # the ZERO VECTOR: not an error value, just a wrong answer with no length.
    # ⭐ 2.14.0 tested what fails, `1 / len`, and for OVERFLOW ONLY: `f64_eq(|inv|, +Inf)`
    # caught len = 0 and any len too small to invert, and let a NaN fall through.
    # ⛔ The obvious `f64_lt(|inv|, F64_POS_INF) == 0` is wrong and `tests/abuse.tcyr`
    # says so out loud: it is false for NaN too, so it would silently zero a NaN vector,
    # and this API's documented contract is **NaN in, NaN out**.
    # ⚠ F64_TINY would have been one binade too strict for that zero exit: 1/2^-1023 is finite.
    # That guard is gone since 3.3.5 (last paragraph); its replacements, `len < DBL_MIN`,
    # `len == 0` and `1/len < DBL_MIN`, are all false for NaN, so NaN still runs the last line.
    # [measured: tests/foundation.tcyr normalize scale sweep, 2026-09-09]
    #
    # ⛔ 3.3.5 — AND THAT EXIT WAS STILL THE ZERO VECTOR FOR EVERY NON-ZERO LENGTH AT OR BELOW
    # 2^-1024, the class 3.3.4 repaired in `hvec3_normalize` only (audit D087): (2^-k, 0) for
    # k = 1023 .. 1074 normalised to the axis for 1 of 52, and (DBL_MAX, DBL_MAX) to (0, 0).
    # [measured: scratch harness, not reproducible in-tree, 2026-10-11; cycc 6.6.14]
    # ⭐ `hvec3_normalize`'s repair, which says why: len < DBL_MIN normalises v * 2^1023 and
    # 1/len < DBL_MIN normalises v * 2^-600, both exact copies. len = 0 still gives the zero
    # vector and NaN runs the last line. On a sample of 1,500 lengths at or below 2^-1024
    # the largest error falls from 9.0e15 ulp to 1.95, and on 3,000 per band the bands
    # (2^-1024, 2^-1022) and (2^1022, DBL_MAX] from 4.73 and 4.76 ulp to 2.09 and the
    # unit-length 2.14 (sample maxima, not bounds).
    # [measured: scratch harness and Decimal oracle, not reproducible in-tree, 2026-10-11; cycc 6.6.14]
    if (f64_lt(len, F64_TINY) == 1) {
        if (f64_eq(len, 0) == 1) { return hvec2_zero(); }
        var up = hvec2_scale(v, (1023 + 1023) << 52);   # 2^1023
        if (up == 0) { return 0; }
        return hvec2_scale(up, f64_div(F64_ONE, hvec2_length(up)));
    }
    var inv = f64_div(F64_ONE, len);
    if (f64_lt(inv, F64_TINY) == 1) {
        var dn = hvec2_scale(v, (1023 - 600) << 52);    # 2^-600
        if (dn == 0) { return 0; }
        return hvec2_scale(dn, f64_div(F64_ONE, hvec2_length(dn)));
    }
    return hvec2_scale(v, inv);
}

# |a - b|: `hvec2_length` of the difference, formed as `hvec2_sub` forms it (on the stack), so
# its error is the difference's rounding (u relative per component, u = 2^-53) and then the
# length's; +Inf where |a - b| rounds past DBL_MAX (IEEE's rounding: (DBL_MAX, 2^500) from 0 is
# DBL_MAX though its exact length exceeds it, and (DBL_MAX, DBL_MAX) from 0
# is +Inf with no component of the difference overflowing), and where a component overflows.
#must_use
public fn hvec2_distance(a, b) {
    # The difference is a stack HVec2 (3.4.0): this returns a length, with no value
    # left for a refused allocation, and hvec2_sub's heap copy was read unchecked.
    var d: i64[2];
    store64(&d, f64_sub(HVec2_x(a), HVec2_x(b)));
    store64(&d + 8, f64_sub(HVec2_y(a), HVec2_y(b)));
    return hvec2_length(&d);
}

# ================================================================
# Interpolation
# ================================================================

# a + (b - a) t per component, any real t (t outside [0, 1] extrapolates): three roundings,
# within u |a + (b - a) t| + 2u |(b - a) t| of the exact value to first order (u = 2^-53);
# t = 0 gives a (a -0 may come back +0), and t = 1 gives b only where b - a is exact.
# 3.4.1: where that form overflows for finite input (b - a past DBL_MAX, or its product with
# t), the component is computed at half scale (`_hvec2_lerp_wide`), so it is finite wherever
# the formula's value is: (-DBL_MAX, DBL_MAX) at 1/2 gave +Inf, exact 0. Every other component
# keeps the fast form's bits. Returns the designed 0 where the allocation is refused.
# 3.4.1 — SCALAR PER COMPONENT, the 3.4.0 packed form's operations in its order (sub, scale,
# add per lane), so the same bits; the result is then in hand and one exponent test per
# component sends a non-finite one to the helper. (cycc fuses no scalar f64_mul + f64_add on
# either target; `hvec3_lerp`'s z tail has always relied on that.) It replaced a first 3.4.1
# form that tested the inputs after the packed ops (3.4.1 review S1): identical bits on
# 30,002 random triples (huge, subnormal and ordinary components; t random, extrapolating,
# subnormal and powers of two), 3,375 special-value triples and 100,000 ordinary ones, at
# about half the overhead: against 3.4.0's packed form, vec2 19 -> 22 ns (+16%; the input test
# read 23 to 24, +23%), vec3 23 -> 26 ns (+13%; 28, +22%), 64 varying vec3 calls 1.44 ->
# 1.54 us (+7%; 1.69, +17%). Reading the packed result back costs a store-forwarding stall.
# [measured: scratch lerp sweep and fl2.bcyr, both trees, 3.4.0's form in each binary, 2026-10-31; cycc 6.7.18]
#must_use
public fn hvec2_lerp(a, b, t) {
    var r = alloc(sizeof(HVec2));
    if (r == 0) { return 0; }
    var ax = load64(a);                                              # x, at offset 0
    var ay = load64(a + 8);                                          # y, at offset 8
    var rx = f64_add(ax, f64_mul(f64_sub(load64(b), ax), t));
    var ry = f64_add(ay, f64_mul(f64_sub(load64(b + 8), ay), t));
    store64(r, rx);
    store64(r + 8, ry);
    if ((rx & 0x7FF0_0000_0000_0000) == 0x7FF0_0000_0000_0000) { return _hvec2_lerp_fix(r, a, b, t); }
    if ((ry & 0x7FF0_0000_0000_0000) == 0x7FF0_0000_0000_0000) { return _hvec2_lerp_fix(r, a, b, t); }
    return r;
}

# `hvec2_lerp`'s components through `_hvec2_lerp_wide` (each finite one kept); returns r.
fn _hvec2_lerp_fix(r, a, b, t) {
    HVec2_set_x(r, _hvec2_lerp_wide(HVec2_x(a), HVec2_x(b), t, HVec2_x(r)));
    HVec2_set_y(r, _hvec2_lerp_wide(HVec2_y(a), HVec2_y(b), t, HVec2_y(r)));
    return r;
}

# One component of a lerp whose fast form a + (b - a) t gave r. Where r is not finite while a,
# b and t are, b - a, its product with t or the sum overflowed, and the same formula on a / 2
# and b / 2, doubled, is that formula evaluated in an unbounded exponent range: the halves
# are exact wherever they can reach the answer (|a| and |b| are at least 2^970 when b - a
# overflows; a subnormal beside an overflowing (b - a) t is below half an ulp of the other
# operand), and every non-zero half-scale intermediate is at least 2^-51 in magnitude, so
# nothing rounds on the subnormal grid. The answer is finite wherever that evaluation is:
# (-DBL_MAX, DBL_MAX, 1/2) gives 0, where the fast form gave +Inf, and (DBL_MAX, 0, 3/2) gives
# -2^1023 + 2^971 (the exact -DBL_MAX / 2 is one ulp away: the product rounds), where it gave
# -Inf; it is +-Inf, IEEE's rounding, where the value is beyond DBL_MAX. A finite r is returned
# unchanged (a subnormal beside an overflowing component would not halve exactly), and so is
# the r of a NaN or infinite t (a subnormal halved to 0 times Inf is NaN, where the fast form's
# Inf is IEEE's answer). A NaN or infinite a or b needs no test: halving and doubling leave it
# as it is and a finite partner meets it only in a sum, so the half form gives the fast form's
# bits: on all 3,375 triples of 15 special values (zeros, subnormals, +-1, +-DBL_MAX, +-Inf,
# NaNs) the three functions give the bits that also testing a and b gave, while with no test
# at all 20 move, each with an infinite t.
# transforms.cyr's `hisab_lerp` and vec3.cyr's `_hvec3_lerp_wide` hold the same lines (a
# module cannot call another's `_` fn).
# [measured: scratch special-value sweep, guarded and unguarded builds, lane MAT, 2026-10-31; cycc 6.7.18]
fn _hvec2_lerp_wide(a, b, t, r) {
    if ((r & 0x7FF0_0000_0000_0000) != 0x7FF0_0000_0000_0000) { return r; }
    if ((t & 0x7FF0_0000_0000_0000) == 0x7FF0_0000_0000_0000) { return r; }
    var ha = f64_mul(a, F64_HALF);
    return f64_mul(f64_add(ha, f64_mul(f64_sub(f64_mul(b, F64_HALF), ha), t)), F64_TWO);
}
