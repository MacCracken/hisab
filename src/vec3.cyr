# vec3.cyr -- 3D f64 vector type
# Usage: shipped inside dist/hisab.cyr; in-tree, include "src/vec3.cyr" after what it requires
# Requires: src/error.cyr (stdlib resolves via cyrius.cyml [deps])
#
# Heap-allocated: { x: f64, y: f64, z: f64 } = 24 bytes
#
# SIMD: HVec3 is 24 bytes = 3 doubles, so a packed op with n=3 would
# over-read one f64 past the allocation (the f64v loop steps 2/iter).
# The over-read-safe pattern is n=2 on the xy pair + a scalar z tail —
# still measurably faster than full scalar (dot ~2.2x, add ~1.6x).
# Intrinsics are global; keep them wrapped in functions (stack align).

#derive(accessors)
public struct HVec3 { x; y; z; }

#must_use
public fn hvec3_new(x, y, z) {
    var v = alloc(sizeof(HVec3));
    HVec3_set_x(v, x);
    HVec3_set_y(v, y);
    HVec3_set_z(v, z);
    return v;
}

#must_use
public fn hvec3_zero() { return hvec3_new(0, 0, 0); }
#must_use
public fn hvec3_one() { return hvec3_new(F64_ONE, F64_ONE, F64_ONE); }
#must_use
public fn hvec3_splat(s) { return hvec3_new(s, s, s); }
#must_use
public fn hvec3_unit_x() { return hvec3_new(F64_ONE, 0, 0); }
#must_use
public fn hvec3_unit_y() { return hvec3_new(0, F64_ONE, 0); }
#must_use
public fn hvec3_unit_z() { return hvec3_new(0, 0, F64_ONE); }

# ================================================================
# Arithmetic
# ================================================================

# SIMD: xy pair via packed n=2, z scalar tail (over-read-safe).
#must_use
public fn hvec3_add(a, b) {
    var r = alloc(sizeof(HVec3));
    f64v_add(r, a, b, 2);
    HVec3_set_z(r, f64_add(HVec3_z(a), HVec3_z(b)));
    return r;
}

#must_use
public fn hvec3_sub(a, b) {
    var r = alloc(sizeof(HVec3));
    f64v_sub(r, a, b, 2);
    HVec3_set_z(r, f64_sub(HVec3_z(a), HVec3_z(b)));
    return r;
}

#must_use
public fn hvec3_mul(a, b) {
    var r = alloc(sizeof(HVec3));
    f64v_mul(r, a, b, 2);
    HVec3_set_z(r, f64_mul(HVec3_z(a), HVec3_z(b)));
    return r;
}

#must_use
public fn hvec3_scale(v, s) {
    var r = alloc(sizeof(HVec3));
    f64v_scale(r, v, s, 2);
    HVec3_set_z(r, f64_mul(HVec3_z(v), s));
    return r;
}

#must_use
public fn hvec3_neg(v) {
    return hvec3_new(f64_neg(HVec3_x(v)),
      f64_neg(HVec3_y(v)),
      f64_neg(HVec3_z(v)));
}

# ================================================================
# Products and norms
# ================================================================

# SIMD: dot of xy pair via packed n=2 + scalar z (over-read-safe).
#must_use
public fn hvec3_dot(a, b) {
    return f64_add(f64v_dot(a, b, 2), f64_mul(HVec3_z(a), HVec3_z(b)));
}

#must_use
public fn hvec3_cross(a, b) {
    return hvec3_new(
      f64_sub(f64_mul(HVec3_y(a), HVec3_z(b)), f64_mul(HVec3_z(a), HVec3_y(b))),
      f64_sub(f64_mul(HVec3_z(a), HVec3_x(b)), f64_mul(HVec3_x(a), HVec3_z(b))),
      f64_sub(f64_mul(HVec3_x(a), HVec3_y(b)), f64_mul(HVec3_y(a), HVec3_x(b)))
      );
}

#must_use
public fn hvec3_length_sq(v) { return hvec3_dot(v, v); }

fn _hvec3_len_scaled(v) {
    var x = HVec3_x(v);
    var y = HVec3_y(v);
    var z = HVec3_z(v);
    var mx = f64_max(f64_max(f64_abs(x), f64_abs(y)), f64_abs(z));
    # ⚠ 3.3.3 — NaN NEVER REACHES HERE, and this exit depends on that. `f64_max` drops a
    # NaN in x or y and `f64_gt(mx, 0) == 0` is TRUE for NaN, so called directly this
    # helper gives (NaN, 0, 0) a length of 0. It is not called: a NaN makes the caller's
    # sum NaN, which is neither `< F64_TINY` nor `+Inf`, so `hvec3_length` returns
    # sqrt(NaN). That routing IS the NaN guard; tests/abuse.tcyr pins it slot by slot.
    # [measured: scratch harness, not reproducible in-tree, 2026-10-01; cycc 6.6.12]
    if (f64_gt(mx, 0) == 0) { return mx; }
    # ⚠ Inf/Inf is NaN, so the infinity contract needs its own exit here.
    if (f64_eq(mx, F64_POS_INF) == 1) { return mx; }
    var xs = f64_div(x, mx);
    var ys = f64_div(y, mx);
    var zs = f64_div(z, mx);
    return f64_mul(mx, f64_sqrt(f64_add(f64_add(f64_mul(xs, xs), f64_mul(ys, ys)), f64_mul(zs, zs))));
}

# ⛔ 2.17.0 — THIS SQUARED BEFORE SUMMING, AND LOST 537 BINADES AT THE BOTTOM AND
# 512 AT THE TOP. `x*x` underflows to zero for any component below 2^-537 and
# overflows to +Inf above 2^511, so a perfectly ordinary vector got a length of
# exactly 0 or exactly +Inf. ⚠ And it was materially wrong BEFORE it reached
# either: a SUBNORMAL sum has already lost most of its mantissa, so the answer is
# finite, plausible and wrong — measured 11.8% out at 2^-539, with nothing to
# signal it. That silent band is the dangerous third of the class.
# [measured: two-sided binade sweep, 2026-09-10]
#
# ⭐ FAST PATH, NOT UNCONDITIONAL SCALING. The naive sum announces its own failure:
# it is subnormal, zero or +Inf exactly when it cannot be trusted, and exact
# otherwise. So take it when it is NORMAL and rescale only when it is not.
# Measured: unconditional scaling costs **+119%** on this helper; the fast path
# costs **+12%** and is not distinguishable in any of the 72 tracked benchmarks
# (median delta -0.03%, the largest move being a row that never calls it).
# ⚠ The trigger is `< F64_TINY`, NOT `== 0` — measured, an `== 0` trigger leaves
# the subnormal band up to 11.8% wrong.
# ⚠ And the `+Inf` short-circuit inside the helper is REQUIRED: without it
# `Inf/Inf` is NaN and the documented infinity contract regresses.
# [measured: 1106-scale two-sided sweep; naive wrong at 60, guarded at 0]
#must_use
public fn hvec3_length(v) {
    var ls = hvec3_length_sq(v);
    if (f64_lt(ls, F64_TINY) == 1) { return _hvec3_len_scaled(v); }
    if (f64_eq(ls, F64_POS_INF) == 1) { return _hvec3_len_scaled(v); }
    return f64_sqrt(ls);
}

#must_use
public fn hvec3_normalize(v) {
    var len = hvec3_length(v);
    # ⛔ `len` is a LENGTH — degree one in the caller's units — and this tested it
    # against an absolute 1e-12, so a perfectly good short vector normalised to
    # the ZERO VECTOR: not an error value, just a wrong answer with no length.
    # ⭐ What fails is `1 / len`, so test THAT — and test it for OVERFLOW ONLY.
    # ⛔ The obvious `f64_lt(|inv|, F64_POS_INF) == 0` is wrong here and
    # `tests/abuse.tcyr` says so out loud: it is false for NaN too, so it would
    # silently zero a NaN vector, and this API's documented contract is **NaN in,
    # NaN out**. `f64_eq(|inv|, +Inf)` catches len = 0 and any len too small to
    # invert, while a NaN falls through and propagates as the contract requires.
    # ⚠ F64_TINY would be one binade too strict here: 1/2^-1023 is finite.
    # [measured: tests/foundation.tcyr normalize scale sweep, 2026-09-09]
    #
    # ⛔ 3.3.4 — AND THAT TEST'S EXIT WAS THE ZERO VECTOR FOR EVERY NON-ZERO LENGTH AT OR
    # BELOW 2^-1024: (2^-k, 0, 0) normalised to (0, 0, 0) for 47 of the 48 subnormal k from
    # 1023 to 1070, and only 2^-1023 to the axis. tests/foundation.tcyr called that a
    # "documented tree-wide limit"; no document said so (audit D087). The top end had no
    # test at all: a finite vector whose length passes DBL_MAX got len = +Inf, inv = 0 and
    # the answer (0, 0, 0), for 1500 of 1500 random directions in a sweep.
    # [measured: scratch harness and Decimal oracle, not reproducible in-tree, 2026-10-03; cycc 6.6.14]
    # ⭐ Neither end needs a threshold, only an exact copy of v in range. Where 1/len
    # overflows, every component is subnormal, and v * 2^1023 is exact with its largest
    # component in [2^-51, 1/2]; where it is 0, v * 2^-600 is exact in every component
    # that can reach the result. The answer is the bits this function gives that copy, so
    # the same direction at an ordinary scale. Every other input, NaN included, runs the
    # last line unchanged, and so does len = 0. An infinite component still gives NaN
    # beside zeros: Inf * 2^-600 is Inf, and the copy's 1/len is 0 again.
    var inv = f64_div(F64_ONE, len);
    if (f64_eq(f64_abs(inv), F64_POS_INF) == 1) {
        if (f64_eq(len, 0) == 1) { return hvec3_zero(); }
        var up = hvec3_scale(v, (1023 + 1023) << 52);   # 2^1023
        return hvec3_scale(up, f64_div(F64_ONE, hvec3_length(up)));
    }
    if (f64_eq(inv, 0) == 1) {
        var dn = hvec3_scale(v, (1023 - 600) << 52);    # 2^-600
        return hvec3_scale(dn, f64_div(F64_ONE, hvec3_length(dn)));
    }
    return hvec3_scale(v, inv);
}

#must_use
public fn hvec3_distance(a, b) { return hvec3_length(hvec3_sub(a, b)); }

# ================================================================
# Interpolation
# ================================================================

# SIMD: xy pair via packed n=2, z scalar tail (over-read-safe), the same hybrid
# as hvec3_add above. The lane sequence is sub -> scale -> add, i.e. per lane
# exactly a + (b - a) * t in the scalar form's order, so the result is
# bit-identical to the scalar tail. NOT f64v_axpy / f64v_fmadd: those are
# mulpd + addpd on x86 but a FUSED fmla on aarch64, which rounds once where
# the scalar form rounds twice. The three passes alias `r` in place, which is
# safe because every f64v loop is load -> op -> store per pair.
#must_use
public fn hvec3_lerp(a, b, t) {
    var r = alloc(sizeof(HVec3));
    f64v_sub(r, b, a, 2);
    f64v_scale(r, r, t, 2);
    f64v_add(r, a, r, 2);
    HVec3_set_z(r, f64_add(HVec3_z(a), f64_mul(f64_sub(HVec3_z(b), HVec3_z(a)), t)));
    return r;
}

# ================================================================
# Component-wise utilities
# ================================================================

# ⛔ 3.3.3 — STDLIB `f64_min` / `f64_max` ANSWER FOR THE ARGUMENT ORDER, NOT THE
# VALUES. `f64_min(a, b)` is `a < b ? a : b`, so whenever that compare is false it
# returns b: a NaN in a is dropped and a NaN in b is kept, and of two zeros b's sign
# wins. Componentwise, hvec3_min((NaN,0,0), (1,0,0)).x was 1 but
# hvec3_min((1,0,0), (NaN,0,0)).x was NaN, hvec3_max the same, and
# hvec3_min((-0,..), (+0,..)).x was +0 but hvec3_min((+0,..), (-0,..)).x was -0.
# geo_aabb_new applies both to its two corners, so a corner with a NaN x gave the
# finite, degenerate slab [1, 1] in one argument order and NaN in the other.
# [measured: scratch probe on the 3.3.2 bundle, not reproducible in-tree, 2026-10-01; cycc 6.6.12]
#
# ⭐ These are IEEE 754-2019 minimum and maximum, which read the values alone: NaN
# when either operand is NaN (that operand, payload and all; `a` when both are),
# -0 below +0, otherwise the smaller or the larger. Two operands that compare equal
# have identical bits unless they are zeros of opposite sign, so OR-ing them gives -0
# exactly when either is -0 and AND-ing gives +0 exactly when either is +0. The
# second compare is only an early exit: the lines after it return b for that pair too.
#
# ⚠ NOT FREE: a pair whose answer is the second operand now costs a second compare,
# and equal operands a third. On 64 random pairs, 16 interleaved runs a side against
# the tree before this change: one hvec3_min plus one hvec3_max 69.7 -> 71.8 ns
# (+2.9%), one geo_aabb_new 83.0 -> 85.3 ns (+2.8%), its slowest old run faster than
# its fastest new one. No tests/hisab.bcyr row reaches either: bvh_build folds its
# bounds with stdlib f64_min / f64_max directly.
# [measured: scratch interleaved A/B, not reproducible in-tree, 2026-10-01; cycc 6.6.12]
fn _hvec3_min1(a, b) {
    if (f64_lt(a, b) == 1) { return a; }
    if (f64_lt(b, a) == 1) { return b; }
    if (f64_eq(a, b) == 1) { return a | b; }
    if (f64_eq(a, a) == 0) { return a; }
    return b;
}

fn _hvec3_max1(a, b) {
    if (f64_gt(a, b) == 1) { return a; }
    if (f64_gt(b, a) == 1) { return b; }
    if (f64_eq(a, b) == 1) { return a & b; }
    if (f64_eq(a, a) == 0) { return a; }
    return b;
}

#must_use
public fn hvec3_min(a, b) {
    return hvec3_new(_hvec3_min1(HVec3_x(a), HVec3_x(b)),
      _hvec3_min1(HVec3_y(a), HVec3_y(b)),
      _hvec3_min1(HVec3_z(a), HVec3_z(b)));
}

#must_use
public fn hvec3_max(a, b) {
    return hvec3_new(_hvec3_max1(HVec3_x(a), HVec3_x(b)),
      _hvec3_max1(HVec3_y(a), HVec3_y(b)),
      _hvec3_max1(HVec3_z(a), HVec3_z(b)));
}

#must_use
public fn hvec3_abs(v) {
    return hvec3_new(f64_abs(HVec3_x(v)), f64_abs(HVec3_y(v)), f64_abs(HVec3_z(v)));
}

# Reflect v about normal n (assumes n is normalized)
#must_use
public fn hvec3_reflect(v, n) {
    var d2 = f64_mul(F64_TWO, hvec3_dot(v, n));
    return hvec3_sub(v, hvec3_scale(n, d2));
}

# Project v onto direction d (assumes d is normalized)
#must_use
public fn hvec3_project(v, d) {
    return hvec3_scale(d, hvec3_dot(v, d));
}

# Reject v from direction d (component perpendicular to d)
#must_use
public fn hvec3_reject(v, d) {
    return hvec3_sub(v, hvec3_project(v, d));
}

# v times a power of two 2^p that puts its largest |component| in [1, 2), or in
# [2^-51, 1) when that component is subnormal: exact either way, so the direction is
# unchanged bit for bit. v must be finite and non-zero. `mx >> 52` is mx's biased
# exponent, 0 for a subnormal (p = 1023 then). 2^p goes on as two normal powers of two,
# because 2^-1023 is not one. (3.3.4, for `hvec3_angle`.)
fn _hvec3_pow2_unit(v) {
    var mx = f64_max(f64_max(f64_abs(HVec3_x(v)), f64_abs(HVec3_y(v))), f64_abs(HVec3_z(v)));
    var p = 1023 - (mx >> 52);
    var h = p / 2;
    return hvec3_scale(hvec3_scale(v, (1023 + h) << 52), (1023 + p - h) << 52);
}

# 1 when every component of v is finite: the house non-finite test, once per slot.
fn _hvec3_finite(v) {
    if (f64_lt(f64_abs(HVec3_x(v)), F64_POS_INF) == 0) { return 0; }
    if (f64_lt(f64_abs(HVec3_y(v)), F64_POS_INF) == 0) { return 0; }
    if (f64_lt(f64_abs(HVec3_z(v)), F64_POS_INF) == 0) { return 0; }
    return 1;
}

# Angle between two vectors in radians
#must_use
public fn hvec3_angle(a, b) {
    var d = hvec3_dot(a, b);
    var la = hvec3_length(a);
    var lb = hvec3_length(b);
    var denom = f64_mul(la, lb);
    # ⛔ THIS GUARD READ `denom < EPSILON_F64` AND CALLED PERPENDICULAR VECTORS
    # PARALLEL. `denom` is |a|·|b| — a length SQUARED, so it scales as the square
    # of the caller's units — and it was compared against an absolute 1e-12.
    # Measured: two EXACTLY perpendicular vectors return pi/2 at lengths 1, 1e-3
    # and 1e-6, and **0 rad at 1e-18**. Same geometry, different units, different
    # answer — and 0 is the value that means "parallel", so the function reports
    # the opposite of the truth rather than reporting failure.
    # [measured: probe over 4 scales on the 2.13.0 tree, 2026-09-09]
    #
    # ⭐ GUARD WHAT ACTUALLY FAILS. The only operation at risk is the division
    # `d / denom`, and by Cauchy-Schwarz |d| <= denom always, so the quotient is
    # in [-1, 1] and cannot overflow for ANY denom above zero. The division fails
    # only at a zero or subnormal denominator, which is exactly `F64_TINY`. There
    # is no scale to choose here, which is the point: a threshold that needs one
    # is the defect.
    # ⚠ The `return 0` stays — for a genuinely zero-length vector the angle is
    # undefined and this function has no error channel — but it is now
    # unreachable except for that genuinely degenerate input.
    # [measured: tests/foundation.tcyr scale-covariance sweep, 154 decades]
    #
    # ⛔ 3.3.4 — THE PARAGRAPH ABOVE WAS WRONG ABOUT WHAT FAILS. Below DBL_MIN the division
    # does not degenerate, its operands do: `d` and `denom` flush, and the `return 0` it
    # kept called EXACTLY PERPENDICULAR vectors parallel on 511 of the 1022 binades below
    # 1, and answered 0 for every pair below 2^-511 whatever the angle. tests/foundation.tcyr
    # pinned two of those zeros as "genuinely degenerate" (audit D089). A subnormal |a|
    # beside a normal |b| failed first: |a| is rounded onto the subnormal grid, so for
    # (2^-1074, 2^-1074, 0) against (2^1000, 0, 0) |a| = sqrt(2) * 2^-1074 became 2^-1074,
    # d/denom came out exactly 1, and the answer 0 for pi/4. Past DBL_MAX, (2^512, 0, 0) with itself was NaN, and
    # (2^1000, 0, 0) against (2^23, 2^24, 0), atan(2), was pi/2: a.b finite over denom +Inf.
    # [measured: scratch harness and Decimal oracle, not reproducible in-tree, 2026-10-03; cycc 6.6.14]
    # ⭐ Exactly those inputs, with every component finite and neither length zero, now
    # measure the angle on copies scaled by powers of two (exact, so the directions are the
    # caller's) as atan2(|a' x b'|, a'.b'). No product flushes or overflows there; a parallel
    # pair's cross product is exactly 0 and a perpendicular pair's dot product exactly 0, so
    # they give 0 and pi/2 bit-exact. A finite vector whose LENGTH overflows is one of them:
    # (DBL_MAX, DBL_MAX, DBL_MAX) with itself was NaN. Every other input runs the acos line
    # unchanged, bit for bit: a zero-length vector still returns 0, and a NaN or infinite
    # component still runs acos (the finite test is on the components, not the lengths).
    # On a 38,406-input sweep against an exact atan2 oracle, 12,649 answers moved and two
    # moved away from it: 0.47 to 0.53 ulp, and 0.05 to 1.05 ulp (that one an acos through
    # a subnormal |a| that happened to round well). None left 4 ulp of the oracle.
    # [measured: scratch harness and Decimal oracle, not reproducible in-tree, 2026-10-03; cycc 6.6.14]
    # ⚠ That sweep under-sampled one band: a length in [2^-1074, 2^-1022) beside a normal
    # one, with |a||b| normal. Near 2^-1022 the subnormal length keeps most of its bits and
    # the acos line is often within 1 ulp there, while the atan2 line carries its own mid-angle
    # error. Aimed at that band, 418 of 11,722 changed answers moved away from the oracle and
    # 74 went from within 1 ulp to at most 1.80 ulp; none passed 4 ulp.
    # [measured: verify-liever scratch harness and Decimal oracle, not reproducible in-tree, 2026-10-03; cycc 6.6.14]
    # ⚠ The acos line keeps its own limits, which no guard can reach: acos is
    # ill-conditioned near 0 and pi. (1, 1, 0) with itself is 2.1e-8 rad at every scale it
    # runs at, and 45 degrees comes back one ulp high. atan2 on every input fixes both, but
    # moved 188 of the 38,406 from within 1 ulp to within 2.55 ulp.
    # [measured: scratch harness and Decimal oracle, not reproducible in-tree, 2026-10-03; cycc 6.6.14]
    var rs = 0;
    if (f64_lt(denom, F64_TINY) == 1 || f64_lt(la, F64_TINY) == 1 || f64_lt(lb, F64_TINY) == 1) { rs = 1; }
    if (f64_eq(denom, F64_POS_INF) == 1 || f64_eq(f64_abs(d), F64_POS_INF) == 1) { rs = 1; }
    if (rs == 1) {
        if (_hvec3_finite(a) + _hvec3_finite(b) == 2) {
            if (f64_eq(la, 0) == 1 || f64_eq(lb, 0) == 1) { return 0; }
            var sa = _hvec3_pow2_unit(a);
            var sb = _hvec3_pow2_unit(b);
            return ganita_f64_atan2(hvec3_length(hvec3_cross(sa, sb)), hvec3_dot(sa, sb));
        }
    }
    return ganita_f64_acos(f64_clamp(f64_div(d, denom), f64_neg(F64_ONE), F64_ONE));
}
