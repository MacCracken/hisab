# vec3.cyr -- 3D f64 vector type
# Usage: shipped inside dist/hisab.cyr; in-tree, include "src/vec3.cyr" after what it requires
# Requires: src/error.cyr (stdlib resolves via cyrius.cyml [deps])
#
# Heap-allocated: { x: f64, y: f64, z: f64 } = 24 bytes
#
# SIMD: HVec3 is 24 bytes = 3 doubles, so a packed op with n=3 would
# over-read one f64 past the allocation (the f64v loop steps 2/iter).
# The over-read-safe pattern is n=2 on the xy pair + a scalar z tail —
# still measurably faster than full scalar (dot ~2.2x, add ~1.6x).
# Intrinsics are global; keep them wrapped in functions (stack align).

#derive(accessors)
public struct HVec3 { x; y; z; }

#must_use
public fn hvec3_new(x, y, z) {
    var v = alloc(sizeof(HVec3));
    HVec3_set_x(v, x);
    HVec3_set_y(v, y);
    HVec3_set_z(v, z);
    return v;
}

#must_use
public fn hvec3_zero() { return hvec3_new(0, 0, 0); }
#must_use
public fn hvec3_one() { return hvec3_new(F64_ONE, F64_ONE, F64_ONE); }
#must_use
public fn hvec3_splat(s) { return hvec3_new(s, s, s); }
#must_use
public fn hvec3_unit_x() { return hvec3_new(F64_ONE, 0, 0); }
#must_use
public fn hvec3_unit_y() { return hvec3_new(0, F64_ONE, 0); }
#must_use
public fn hvec3_unit_z() { return hvec3_new(0, 0, F64_ONE); }

# ================================================================
# Arithmetic
# ================================================================

# SIMD: xy pair via packed n=2, z scalar tail (over-read-safe).
#must_use
public fn hvec3_add(a, b) {
    var r = alloc(sizeof(HVec3));
    f64v_add(r, a, b, 2);
    HVec3_set_z(r, f64_add(HVec3_z(a), HVec3_z(b)));
    return r;
}

#must_use
public fn hvec3_sub(a, b) {
    var r = alloc(sizeof(HVec3));
    f64v_sub(r, a, b, 2);
    HVec3_set_z(r, f64_sub(HVec3_z(a), HVec3_z(b)));
    return r;
}

#must_use
public fn hvec3_mul(a, b) {
    var r = alloc(sizeof(HVec3));
    f64v_mul(r, a, b, 2);
    HVec3_set_z(r, f64_mul(HVec3_z(a), HVec3_z(b)));
    return r;
}

#must_use
public fn hvec3_scale(v, s) {
    var r = alloc(sizeof(HVec3));
    f64v_scale(r, v, s, 2);
    HVec3_set_z(r, f64_mul(HVec3_z(v), s));
    return r;
}

#must_use
public fn hvec3_neg(v) {
    return hvec3_new(f64_neg(HVec3_x(v)),
      f64_neg(HVec3_y(v)),
      f64_neg(HVec3_z(v)));
}

# ================================================================
# Products and norms
# ================================================================

# SIMD: dot of xy pair via packed n=2 + scalar z (over-read-safe).
#must_use
public fn hvec3_dot(a, b) {
    return f64_add(f64v_dot(a, b, 2), f64_mul(HVec3_z(a), HVec3_z(b)));
}

#must_use
public fn hvec3_cross(a, b) {
    return hvec3_new(
      f64_sub(f64_mul(HVec3_y(a), HVec3_z(b)), f64_mul(HVec3_z(a), HVec3_y(b))),
      f64_sub(f64_mul(HVec3_z(a), HVec3_x(b)), f64_mul(HVec3_x(a), HVec3_z(b))),
      f64_sub(f64_mul(HVec3_x(a), HVec3_y(b)), f64_mul(HVec3_y(a), HVec3_x(b)))
      );
}

#must_use
public fn hvec3_length_sq(v) { return hvec3_dot(v, v); }

fn _hvec3_len_scaled(v) {
    var x = HVec3_x(v);
    var y = HVec3_y(v);
    var z = HVec3_z(v);
    var mx = f64_max(f64_max(f64_abs(x), f64_abs(y)), f64_abs(z));
    # ⚠ 3.3.3 — NaN NEVER REACHES HERE, and this exit depends on that. `f64_max` drops a
    # NaN in x or y and `f64_gt(mx, 0) == 0` is TRUE for NaN, so called directly this
    # helper gives (NaN, 0, 0) a length of 0. It is not called: a NaN makes the caller's
    # sum NaN, which is neither `< F64_TINY` nor `+Inf`, so `hvec3_length` returns
    # sqrt(NaN). That routing IS the NaN guard; tests/abuse.tcyr pins it slot by slot.
    # [measured: scratch harness, not reproducible in-tree, 2026-10-01; cycc 6.6.12]
    if (f64_gt(mx, 0) == 0) { return mx; }
    # ⚠ Inf/Inf is NaN, so the infinity contract needs its own exit here.
    if (f64_eq(mx, F64_POS_INF) == 1) { return mx; }
    var xs = f64_div(x, mx);
    var ys = f64_div(y, mx);
    var zs = f64_div(z, mx);
    return f64_mul(mx, f64_sqrt(f64_add(f64_add(f64_mul(xs, xs), f64_mul(ys, ys)), f64_mul(zs, zs))));
}

# ⛔ 2.17.0 — THIS SQUARED BEFORE SUMMING, AND LOST 537 BINADES AT THE BOTTOM AND
# 512 AT THE TOP. `x*x` underflows to zero for any component below 2^-537 and
# overflows to +Inf above 2^511, so a perfectly ordinary vector got a length of
# exactly 0 or exactly +Inf. ⚠ And it was materially wrong BEFORE it reached
# either: a SUBNORMAL sum has already lost most of its mantissa, so the answer is
# finite, plausible and wrong — measured 11.8% out at 2^-539, with nothing to
# signal it. That silent band is the dangerous third of the class.
# [measured: two-sided binade sweep, 2026-09-10]
#
# ⭐ FAST PATH, NOT UNCONDITIONAL SCALING. The naive sum announces its own failure:
# it is subnormal, zero or +Inf exactly when it cannot be trusted, and exact
# otherwise. So take it when it is NORMAL and rescale only when it is not.
# Measured: unconditional scaling costs **+119%** on this helper; the fast path
# costs **+12%** and is not distinguishable in any of the 72 tracked benchmarks
# (median delta -0.03%, the largest move being a row that never calls it).
# ⚠ The trigger is `< F64_TINY`, NOT `== 0` — measured, an `== 0` trigger leaves
# the subnormal band up to 11.8% wrong.
# ⚠ And the `+Inf` short-circuit inside the helper is REQUIRED: without it
# `Inf/Inf` is NaN and the documented infinity contract regresses.
# [measured: 1106-scale two-sided sweep; naive wrong at 60, guarded at 0]
#must_use
public fn hvec3_length(v) {
    var ls = hvec3_length_sq(v);
    if (f64_lt(ls, F64_TINY) == 1) { return _hvec3_len_scaled(v); }
    if (f64_eq(ls, F64_POS_INF) == 1) { return _hvec3_len_scaled(v); }
    return f64_sqrt(ls);
}

#must_use
public fn hvec3_normalize(v) {
    var len = hvec3_length(v);
    # ⛔ `len` is a LENGTH — degree one in the caller's units — and this tested it
    # against an absolute 1e-12, so a perfectly good short vector normalised to
    # the ZERO VECTOR: not an error value, just a wrong answer with no length.
    # ⭐ 2.14.0 tested what fails, `1 / len`, and for OVERFLOW ONLY: `f64_eq(|inv|, +Inf)`
    # caught len = 0 and any len too small to invert, and let a NaN fall through.
    # ⛔ The obvious `f64_lt(|inv|, F64_POS_INF) == 0` is wrong and `tests/abuse.tcyr`
    # says so out loud: it is false for NaN too, so it would silently zero a NaN vector,
    # and this API's documented contract is **NaN in, NaN out**.
    # ⚠ F64_TINY would have been one binade too strict for that zero exit: 1/2^-1023 is finite.
    # That guard is gone since 3.3.5 (last paragraph); its replacements, `len < DBL_MIN`,
    # `len == 0` and `1/len < DBL_MIN`, are all false for NaN, so NaN still runs the last line.
    # [measured: tests/foundation.tcyr normalize scale sweep, 2026-09-09]
    #
    # ⛔ 3.3.4 — AND THAT TEST'S EXIT WAS THE ZERO VECTOR FOR EVERY NON-ZERO LENGTH AT OR
    # BELOW 2^-1024: (2^-k, 0, 0) normalised to (0, 0, 0) for 47 of the 48 subnormal k from
    # 1023 to 1070, and only 2^-1023 to the axis. tests/foundation.tcyr called that a
    # "documented tree-wide limit"; no document said so (audit D087). The top end had no
    # test at all: a finite vector whose length passes DBL_MAX got len = +Inf, inv = 0 and
    # the answer (0, 0, 0), for 1500 of 1500 random directions in a sweep.
    # [measured: scratch harness and Decimal oracle, not reproducible in-tree, 2026-10-03; cycc 6.6.14]
    # ⭐ Neither end needs a threshold, only an exact copy of v in range: v * 2^1023 where
    # 1/len overflowed (every component subnormal, so exact), v * 2^-600 where it was 0
    # (exact in every component that can reach the result). The answer is the bits this
    # function gives that copy, so the same direction at an ordinary scale.
    #
    # ⛔ 3.3.5 — BETWEEN THOSE ENDS AND THE ORDINARY RANGE TWO BANDS STILL LOST BITS. For a
    # length in (2^-1024, 2^-1022) 1/len is finite but len is rounded on the subnormal grid,
    # and for one in (2^1022, DBL_MAX] 1/len is subnormal; v * inv carried either rounding.
    # On 3,000 random directions per band: up to 4.84 and 5.43 ulp, where the same
    # directions at unit length reach 2.18.
    # [measured: scratch harness and Decimal oracle, not reproducible in-tree, 2026-10-11; cycc 6.6.14]
    # ⭐ So each copy now starts where its rounding starts: len < DBL_MIN takes the 2^1023
    # copy and 1/len < DBL_MIN (len > 2^1022, or +Inf) the 2^-600 copy. Above, the answer is
    # the unit-length answer for the same direction, bit for bit (3,000 of 3,000), so its
    # sample maximum is the unit-length 2.18; below, it falls to 2.13 (sample maxima, not
    # bounds). Inputs that were within 1 ulp and now are not (183 above, 138 below) carry
    # their direction's unit-length error.
    # Every other input, NaN included, runs the last line unchanged; len = 0 still gives the
    # zero vector, and an infinite component still gives NaN beside zeros: Inf * 2^-600 is
    # Inf, and the copy's 1/len is 0 again.
    # [measured: scratch harness and Decimal oracle, not reproducible in-tree, 2026-10-11; cycc 6.6.14]
    if (f64_lt(len, F64_TINY) == 1) {
        if (f64_eq(len, 0) == 1) { return hvec3_zero(); }
        var up = hvec3_scale(v, (1023 + 1023) << 52);   # 2^1023
        return hvec3_scale(up, f64_div(F64_ONE, hvec3_length(up)));
    }
    var inv = f64_div(F64_ONE, len);
    if (f64_lt(inv, F64_TINY) == 1) {
        var dn = hvec3_scale(v, (1023 - 600) << 52);    # 2^-600
        return hvec3_scale(dn, f64_div(F64_ONE, hvec3_length(dn)));
    }
    return hvec3_scale(v, inv);
}

#must_use
public fn hvec3_distance(a, b) { return hvec3_length(hvec3_sub(a, b)); }

# ================================================================
# Interpolation
# ================================================================

# SIMD: xy pair via packed n=2, z scalar tail (over-read-safe), the same hybrid
# as hvec3_add above. The lane sequence is sub -> scale -> add, i.e. per lane
# exactly a + (b - a) * t in the scalar form's order, so the result is
# bit-identical to the scalar tail. NOT f64v_axpy / f64v_fmadd: those are
# mulpd + addpd on x86 but a FUSED fmla on aarch64, which rounds once where
# the scalar form rounds twice. The three passes alias `r` in place, which is
# safe because every f64v loop is load -> op -> store per pair.
#must_use
public fn hvec3_lerp(a, b, t) {
    var r = alloc(sizeof(HVec3));
    f64v_sub(r, b, a, 2);
    f64v_scale(r, r, t, 2);
    f64v_add(r, a, r, 2);
    HVec3_set_z(r, f64_add(HVec3_z(a), f64_mul(f64_sub(HVec3_z(b), HVec3_z(a)), t)));
    return r;
}

# ================================================================
# Component-wise utilities
# ================================================================

# ⛔ 3.3.3 — STDLIB `f64_min` / `f64_max` ANSWER FOR THE ARGUMENT ORDER, NOT THE
# VALUES. `f64_min(a, b)` is `a < b ? a : b`, so whenever that compare is false it
# returns b: a NaN in a is dropped and a NaN in b is kept, and of two zeros b's sign
# wins. Componentwise, hvec3_min((NaN,0,0), (1,0,0)).x was 1 but
# hvec3_min((1,0,0), (NaN,0,0)).x was NaN, hvec3_max the same, and
# hvec3_min((-0,..), (+0,..)).x was +0 but hvec3_min((+0,..), (-0,..)).x was -0.
# geo_aabb_new applies both to its two corners, so a corner with a NaN x gave the
# finite, degenerate slab [1, 1] in one argument order and NaN in the other.
# [measured: scratch probe on the 3.3.2 bundle, not reproducible in-tree, 2026-10-01; cycc 6.6.12]
#
# ⭐ These are IEEE 754-2019 minimum and maximum, which read the values alone: NaN
# when either operand is NaN (that operand, payload and all; `a` when both are),
# -0 below +0, otherwise the smaller or the larger. Two operands that compare equal
# have identical bits unless they are zeros of opposite sign, so OR-ing them gives -0
# exactly when either is -0 and AND-ing gives +0 exactly when either is +0. The
# second compare is only an early exit: the lines after it return b for that pair too.
#
# ⚠ NOT FREE: a pair whose answer is the second operand now costs a second compare,
# and equal operands a third. On 64 random pairs, 16 interleaved runs a side against
# the tree before this change: one hvec3_min plus one hvec3_max 69.7 -> 71.8 ns
# (+2.9%), one geo_aabb_new 83.0 -> 85.3 ns (+2.8%), its slowest old run faster than
# its fastest new one. No tests/hisab.bcyr row reaches either: bvh_build folds its
# bounds with stdlib f64_min / f64_max directly.
# [measured: scratch interleaved A/B, not reproducible in-tree, 2026-10-01; cycc 6.6.12]
fn _hvec3_min1(a, b) {
    if (f64_lt(a, b) == 1) { return a; }
    if (f64_lt(b, a) == 1) { return b; }
    if (f64_eq(a, b) == 1) { return a | b; }
    if (f64_eq(a, a) == 0) { return a; }
    return b;
}

fn _hvec3_max1(a, b) {
    if (f64_gt(a, b) == 1) { return a; }
    if (f64_gt(b, a) == 1) { return b; }
    if (f64_eq(a, b) == 1) { return a & b; }
    if (f64_eq(a, a) == 0) { return a; }
    return b;
}

#must_use
public fn hvec3_min(a, b) {
    return hvec3_new(_hvec3_min1(HVec3_x(a), HVec3_x(b)),
      _hvec3_min1(HVec3_y(a), HVec3_y(b)),
      _hvec3_min1(HVec3_z(a), HVec3_z(b)));
}

#must_use
public fn hvec3_max(a, b) {
    return hvec3_new(_hvec3_max1(HVec3_x(a), HVec3_x(b)),
      _hvec3_max1(HVec3_y(a), HVec3_y(b)),
      _hvec3_max1(HVec3_z(a), HVec3_z(b)));
}

#must_use
public fn hvec3_abs(v) {
    return hvec3_new(f64_abs(HVec3_x(v)), f64_abs(HVec3_y(v)), f64_abs(HVec3_z(v)));
}

# Reflect v about normal n (assumes n is normalized)
#must_use
public fn hvec3_reflect(v, n) {
    var d2 = f64_mul(F64_TWO, hvec3_dot(v, n));
    return hvec3_sub(v, hvec3_scale(n, d2));
}

# Project v onto direction d (assumes d is normalized)
#must_use
public fn hvec3_project(v, d) {
    return hvec3_scale(d, hvec3_dot(v, d));
}

# Reject v from direction d (component perpendicular to d)
#must_use
public fn hvec3_reject(v, d) {
    return hvec3_sub(v, hvec3_project(v, d));
}

# v times a power of two 2^p that puts its largest |component| in [1, 2), or in
# [2^-51, 1) when that component is subnormal: exact either way, so the direction is
# unchanged bit for bit. Written to o[0..2]; returns max |component| (0 for the zero
# vector). v must be finite. `mx >> 52` is mx's biased exponent, 0 for a subnormal
# (p = 1023 then). 2^p goes on as two normal powers of two, because 2^-1023 is not one.
fn _hvec3_pow2_copy(v, o) {
    var mx = f64_max(f64_max(f64_abs(HVec3_x(v)), f64_abs(HVec3_y(v))), f64_abs(HVec3_z(v)));
    var p = 1023 - (mx >> 52);
    var h = p / 2;
    var f1 = (1023 + h) << 52;
    var f2 = (1023 + p - h) << 52;
    store64(o, f64_mul(f64_mul(HVec3_x(v), f1), f2));
    store64(o + 8, f64_mul(f64_mul(HVec3_y(v), f1), f2));
    store64(o + 16, f64_mul(f64_mul(HVec3_z(v), f1), f2));
    return mx;
}

var _HV3_SPLIT = 0x41A0000002000000;      # 2^27 + 1 = 134217729
var _HV3_PI_LO = 0x3CA1A62633145C07;      # 1.2246467991473532e-16 (the true value minus F64_PI)
var _HV3_PI_2_LO = 0x3C91A62633145C07;    # 6.123233995736766e-17 (the true value minus F64_PI_2)
var _HV3_TWO52 = 0x4330000000000000;      # 2^52

# The e with a * b = p + e exactly, for p = RN(a * b): Dekker's product, split at
# 2^27 + 1 (no FMA). Exact while nothing overflows or reaches the subnormals.
# `hvec3_angle`'s scaled copies (|component| < 2) rule out the overflow; a product below
# about 2^-969 has a subnormal error term that loses its low bits, which matters only for
# angles near DBL_MIN (see `hvec3_angle`).
fn _hvec3_mul_err(a, b, p) {
    var t = f64_mul(a, _HV3_SPLIT);
    var ah = f64_sub(t, f64_sub(t, a));
    var al = f64_sub(a, ah);
    var u = f64_mul(b, _HV3_SPLIT);
    var bh = f64_sub(u, f64_sub(u, b));
    var bl = f64_sub(b, bh);
    return f64_add(f64_add(f64_add(f64_sub(f64_mul(ah, bh), p), f64_mul(ah, bl)), f64_mul(al, bh)),
      f64_mul(al, bl));
}

# The e with a + b = s + e exactly, for s = RN(a + b) (Knuth's two-sum).
fn _hvec3_add_err(a, b, s) {
    var bb = f64_sub(s, a);
    return f64_add(f64_sub(a, f64_sub(s, bb)), f64_sub(b, bb));
}

# a*b - c*d as a double-double: hi to o, lo to o + 8.
fn _hvec3_dd_dp(a, b, c, d, o) {
    var p1 = f64_mul(a, b);
    var p2 = f64_mul(c, d);
    var s = f64_sub(p1, p2);
    var lo = f64_add(_hvec3_add_err(p1, f64_neg(p2), s), f64_sub(_hvec3_mul_err(a, b, p1), _hvec3_mul_err(c, d, p2)));
    var hi = f64_add(s, lo);
    store64(o, hi);
    store64(o + 8, f64_sub(lo, f64_sub(hi, s)));
    return 0;
}

# The dot product of w[0..2] and w[3..5] as a double-double: hi to o, lo to o + 8.
fn _hvec3_dd_dot(w, o) {
    var a0 = load64(w); var a1 = load64(w + 8); var a2 = load64(w + 16);
    var b0 = load64(w + 24); var b1 = load64(w + 32); var b2 = load64(w + 40);
    var p0 = f64_mul(a0, b0);
    var p1 = f64_mul(a1, b1);
    var p2 = f64_mul(a2, b2);
    var s1 = f64_add(p0, p1);
    var s2 = f64_add(s1, p2);
    var lo = f64_add(f64_add(_hvec3_add_err(p0, p1, s1), _hvec3_add_err(s1, p2, s2)),
      f64_add(f64_add(_hvec3_mul_err(a0, b0, p0), _hvec3_mul_err(a1, b1, p1)), _hvec3_mul_err(a2, b2, p2)));
    var hi = f64_add(s2, lo);
    store64(o, hi);
    store64(o + 8, f64_sub(lo, f64_sub(hi, s2)));
    return 0;
}

# The length of the double-double vector at c[0..5] (hi, lo per component) as a
# double-double at r. Scaled by a power of two first, so no square flushes however
# small the vector (a cross product of nearly parallel vectors is), then a square root
# with one Newton correction.
fn _hvec3_dd_norm(c, r) {
    var h0 = load64(c); var h1 = load64(c + 16); var h2 = load64(c + 32);
    var mx = f64_max(f64_max(f64_abs(h0), f64_abs(h1)), f64_abs(h2));
    if (f64_eq(mx, 0) == 1) {
        store64(r, 0);
        store64(r + 8, 0);
        return 0;
    }
    var p = 1023 - (mx >> 52);
    var h = p / 2;
    var f1 = (1023 + h) << 52;
    var f2 = (1023 + p - h) << 52;
    h0 = f64_mul(f64_mul(h0, f1), f2); var l0 = f64_mul(f64_mul(load64(c + 8), f1), f2);
    h1 = f64_mul(f64_mul(h1, f1), f2); var l1 = f64_mul(f64_mul(load64(c + 24), f1), f2);
    h2 = f64_mul(f64_mul(h2, f1), f2); var l2 = f64_mul(f64_mul(load64(c + 40), f1), f2);
    var q0 = f64_mul(h0, h0);
    var q1 = f64_mul(h1, h1);
    var q2 = f64_mul(h2, h2);
    var s1 = f64_add(q0, q1);
    var s2 = f64_add(s1, q2);
    var lo = f64_add(f64_add(_hvec3_add_err(q0, q1, s1), _hvec3_add_err(s1, q2, s2)),
      f64_add(f64_add(_hvec3_mul_err(h0, h0, q0), _hvec3_mul_err(h1, h1, q1)), _hvec3_mul_err(h2, h2, q2)));
    lo = f64_add(lo, f64_mul(F64_TWO, f64_add(f64_add(f64_mul(h0, l0), f64_mul(h1, l1)), f64_mul(h2, l2))));
    var sh = f64_add(s2, lo);
    var sl = f64_sub(lo, f64_sub(sh, s2));
    var yh = f64_sqrt(sh);
    var yy = f64_mul(yh, yh);
    var yl = f64_div(f64_add(f64_sub(f64_sub(sh, yy), _hvec3_mul_err(yh, yh, yy)), sl), f64_mul(F64_TWO, yh));
    var g1 = (1023 - h) << 52;
    var g2 = (1023 - p + h) << 52;
    store64(r, f64_mul(f64_mul(yh, g1), g2));
    store64(r + 8, f64_mul(f64_mul(yl, g1), g2));
    return 0;
}

# (nh + nl) / (dh + dl) as a renormalised double-double at o: o holds the double
# nearest the quotient, o + 8 the rest.
fn _hvec3_dd_div(nh, nl, dh, dl, o) {
    var th = f64_div(nh, dh);
    var pp = f64_mul(th, dh);
    var tl = f64_div(f64_sub(f64_add(f64_sub(f64_sub(nh, pp), _hvec3_mul_err(th, dh, pp)), nl), f64_mul(th, dl)), dh);
    var t = f64_add(th, tl);
    store64(o, t);
    store64(o + 8, f64_sub(tl, f64_sub(t, th)));
    return 0;
}

# atan of the double-double at o, as r + c with r = atan(o[0]) rounded and c the
# first-order correction for o[1]; the caller adds them. Writes c to o + 8.
fn _hvec3_dd_atan(o) {
    var t = load64(o);
    store64(o + 8, f64_div(load64(o + 8), f64_add(F64_ONE, f64_mul(t, t))));
    return f64_atan(t);
}

# (hi + lo) - (r + c), rounded once: hi - r with its two-sum error, then the small terms.
fn _hvec3_dd_sub(hi, lo, r, c) {
    var s = f64_sub(hi, r);
    return f64_add(s, f64_sub(f64_add(_hvec3_add_err(hi, f64_neg(r), s), lo), c));
}

# The angle between w[0..2] and w[3..5], finite and non-zero: atan2(|a x b|, a.b) with
# both operands (y, x) as double-doubles. w has room for 18 words. Which atan:
#   x > 0           atan(y/x), while y/x <= 2^52: atan's one rounding is then the answer's
#   x < 0, y <= |x| pi - atan(y/|x|)
#   otherwise       pi/2 - atan(x/y), whose atan is below pi/4 and so rounds finer than
#                   the answer (x = 0 gives pi/2 exactly)
# x > 0 tests the renormalised quotient, which it needs anyway: y's high word can sit an
# ulp above x's when y = x, and pi/2 - atan(1) is an ulp off at 45 degrees. x < 0 tests the
# high words: there the answer's ulp is at least twice atan's, and deciding on the quotient
# instead changed none of 193,721 answers, 20,000 of them within 3 ulps of 135 degrees.
# [measured: scratch mutant harness and Decimal oracle, not reproducible in-tree, 2026-10-11; cycc 6.6.14]
fn _hvec3_angle_dd(w) {
    var a0 = load64(w); var a1 = load64(w + 8); var a2 = load64(w + 16);
    var b0 = load64(w + 24); var b1 = load64(w + 32); var b2 = load64(w + 40);
    _hvec3_dd_dp(a1, b2, a2, b1, w + 48);
    _hvec3_dd_dp(a2, b0, a0, b2, w + 64);
    _hvec3_dd_dp(a0, b1, a1, b0, w + 80);
    _hvec3_dd_norm(w + 48, w + 96);
    _hvec3_dd_dot(w, w + 112);
    var yh = load64(w + 96); var yl = load64(w + 104);
    var xh = load64(w + 112); var xl = load64(w + 120);
    var q = w + 128;
    if (f64_eq(xh, 0) == 0) {
        if (f64_gt(xh, 0) == 1) {
            _hvec3_dd_div(yh, yl, xh, xl, q);
            if (f64_le(load64(q), _HV3_TWO52) == 1) {
                var r0 = _hvec3_dd_atan(q);
                return f64_add(r0, load64(q + 8));
            }
        } elif (f64_le(yh, f64_neg(xh)) == 1) {
            _hvec3_dd_div(yh, yl, f64_neg(xh), f64_neg(xl), q);
            var r1 = _hvec3_dd_atan(q);
            return _hvec3_dd_sub(F64_PI, _HV3_PI_LO, r1, load64(q + 8));
        }
    }
    _hvec3_dd_div(xh, xl, yh, yl, q);
    var r2 = _hvec3_dd_atan(q);
    return _hvec3_dd_sub(F64_PI_2, _HV3_PI_2_LO, r2, load64(q + 8));
}

# 1 when every component of v is finite: the house non-finite test, once per slot.
fn _hvec3_finite(v) {
    if (f64_lt(f64_abs(HVec3_x(v)), F64_POS_INF) == 0) { return 0; }
    if (f64_lt(f64_abs(HVec3_y(v)), F64_POS_INF) == 0) { return 0; }
    if (f64_lt(f64_abs(HVec3_z(v)), F64_POS_INF) == 0) { return 0; }
    return 1;
}

# Angle between two vectors in radians
#must_use
public fn hvec3_angle(a, b) {
    # ⛔ THIS GUARD READ `denom < EPSILON_F64` AND CALLED PERPENDICULAR VECTORS
    # PARALLEL. `denom` is |a|·|b| — a length SQUARED, so it scales as the square
    # of the caller's units — and it was compared against an absolute 1e-12.
    # Measured: two EXACTLY perpendicular vectors return pi/2 at lengths 1, 1e-3
    # and 1e-6, and **0 rad at 1e-18**. Same geometry, different units, different
    # answer — and 0 is the value that means "parallel", so the function reports
    # the opposite of the truth rather than reporting failure.
    # [measured: probe over 4 scales on the 2.13.0 tree, 2026-09-09]
    #
    # ⭐ GUARD WHAT ACTUALLY FAILS. The only operation at risk is the division
    # `d / denom`, and by Cauchy-Schwarz |d| <= denom always, so the quotient is
    # in [-1, 1] and cannot overflow for ANY denom above zero. The division fails
    # only at a zero or subnormal denominator, which is exactly `F64_TINY`. There
    # is no scale to choose here, which is the point: a threshold that needs one
    # is the defect.
    # ⚠ The `return 0` stays — for a genuinely zero-length vector the angle is
    # undefined and this function has no error channel — but it is now
    # unreachable except for that genuinely degenerate input.
    # [measured: tests/foundation.tcyr scale-covariance sweep, 154 decades]
    #
    # ⛔ 3.3.4 — THE PARAGRAPH ABOVE WAS WRONG ABOUT WHAT FAILS. Below DBL_MIN the division
    # does not degenerate, its operands do: `d` and `denom` flush, and the `return 0` it
    # kept called EXACTLY PERPENDICULAR vectors parallel on 511 of the 1022 binades below
    # 1, and answered 0 for every pair below 2^-511 whatever the angle. tests/foundation.tcyr
    # pinned two of those zeros as "genuinely degenerate" (audit D089). A subnormal |a|
    # beside a normal |b| failed first: |a| is rounded onto the subnormal grid, so for
    # (2^-1074, 2^-1074, 0) against (2^1000, 0, 0) |a| = sqrt(2) * 2^-1074 became 2^-1074,
    # d/denom came out exactly 1, and the answer 0 for pi/4. Past DBL_MAX, (2^512, 0, 0) with itself was NaN, and
    # (2^1000, 0, 0) against (2^23, 2^24, 0), atan(2), was pi/2: a.b finite over denom +Inf.
    # [measured: scratch harness and Decimal oracle, not reproducible in-tree, 2026-10-03; cycc 6.6.14]
    # 3.3.4 sent exactly those inputs to atan2(|a' x b'|, a'.b') on power-of-two copies and
    # kept the acos line for the rest.
    #
    # ⛔ 3.3.5 — AND THE ACOS LINE WAS THE LARGER ERROR. acos is ill-conditioned near 0 and
    # pi: (1, 1, 0) with itself came back 2.1e-8 rad at every scale, nearly parallel pairs
    # were up to 1.1e26 ulp off, nearly opposed ones up to 6.7e7 ulp, and (1, 1, 0)
    # against (1, 0, 0) was one ulp above pi/4 on 64,094 of a 90,000-pair grid of scales.
    # Of 173,721 inputs, 30,918 were more than 1 ulp from the oracle. The plain atan2 line on
    # every input is no cure (its cross product cancels near 0; 3.3.4 measured it moving 188
    # of 38,406 answers past 1 ulp), and neither is Kahan's 2 atan2(|lb a - la b|, |lb a +
    # la b|), which is accurate only absolutely: 1.4e18 ulp on nearly parallel pairs and
    # 1,711 of 10,000 exact 45-degree pairs past 1 ulp.
    # [measured: scratch harness and Decimal oracle, not reproducible in-tree, 2026-10-11; cycc 6.6.14]
    # ⭐ Every finite input now takes atan2(|a x b|, a.b) with both operands carried as
    # double-doubles (Dekker products, two-sums, a Newton-corrected square root) on copies
    # scaled by powers of two, so nothing overflows and the cross product keeps its last bits
    # for nearly parallel pairs. The atan is taken of a renormalised quotient, corrected to
    # first order, with pi and pi/2 as double-doubles (`_hvec3_angle_dd` says which quotient
    # where). What remains is atan's own rounding and one more: on the same 173,721 inputs
    # the largest error is 0.99 ulp, none is past 1 ulp, and 3,133 are not correctly rounded
    # where 113,188 were not. 816 that the acos line happened to round correctly are now
    # within 1 ulp instead, since one rounded atan cannot be correctly rounded everywhere.
    # Parallel, perpendicular and opposed stay 0, pi/2 and pi bit-exact at every scale: their
    # cross or dot product is exactly 0, double-double or not.
    # [measured: scratch harness and Decimal oracle, not reproducible in-tree, 2026-10-11; cycc 6.6.14]
    # ⚠ Not past 1 ulp for an angle near DBL_MIN. When the copies' components span more than
    # about 2^1000, an angle that small is made of products that are themselves subnormal,
    # and the Dekker error terms lose their low bits. On 40,002 pairs sharing all but one or
    # two tiny components, 172 results were past 1 ulp (up to 2.66), every one below 2^-1020;
    # the 33,993 results at or above 2^-1020 were all within 0.96. (3.3.4 answered every one
    # of those pairs 0, 1.5e-8 or 2.1e-8.)
    # [measured: scratch harness and Decimal oracle, not reproducible in-tree, 2026-10-11; cycc 6.6.14]
    # ⚠ COST: several times the acos line's arithmetic, not timed here; no tests/hisab.bcyr
    # row calls this function. A zero-length vector still returns 0, and a NaN or infinite
    # component still runs the acos line, unchanged (the finite test is on the components).
    if (_hvec3_finite(a) + _hvec3_finite(b) == 2) {
        var w[144];
        if (f64_eq(_hvec3_pow2_copy(a, &w), 0) == 1) { return 0; }
        if (f64_eq(_hvec3_pow2_copy(b, &w + 24), 0) == 1) { return 0; }
        return _hvec3_angle_dd(&w);
    }
    var d = hvec3_dot(a, b);
    var denom = f64_mul(hvec3_length(a), hvec3_length(b));
    return ganita_f64_acos(f64_clamp(f64_div(d, denom), f64_neg(F64_ONE), F64_ONE));
}
