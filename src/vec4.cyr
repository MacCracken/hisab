# vec4.cyr -- 4D f64 vector type
# Usage: shipped inside dist/hisab.cyr; in-tree, include "src/vec4.cyr" after what it requires
# Requires: src/error.cyr, src/vec3.cyr (stdlib resolves via cyrius.cyml [deps])
#
# Heap-allocated: { x: f64, y: f64, z: f64, w: f64 } = 32 bytes
#
# SIMD: HVec4 is exactly 4 contiguous f64 (32 bytes), so the packed
# `f64v_*` builtins operate on it directly with n=4 (even — no
# over-read past the allocation). Intrinsics are global (no include).
# They MUST stay wrapped in functions — and since cycc 6.6.2 the
# COMPILER enforces that rather than leaving it to a runtime crash.
# ⭐ The old reason recorded here was wrong: it blamed a misaligned
# stack. The real one is that these intrinsics stash their operands in
# FRAME slots and top-level code has no frame. 6.6.2 refuses with
# `SIMD intrinsics must be called inside a function`; before it the
# same source compiled clean and SIGSEGV'd at run time on every
# release checked. Verified both ways on 6.6.1 (OK, then exit 139)
# and 6.6.2 (compile error). [measured: scratch harness, 2026-09-09]

#derive(accessors)
public struct HVec4 { x; y; z; w; }

# A new HVec4 (x, y, z, w): 32 bytes from the heap, the components stored as given. Returns
# the designed 0 where the allocation is refused (3.4.0); so does every function in this file
# that returns an HVec4 or HVec3.
#must_use
public fn hvec4_new(x, y, z, w) {
    var v = alloc(sizeof(HVec4));
    if (v == 0) { return 0; }
    HVec4_set_x(v, x);
    HVec4_set_y(v, y);
    HVec4_set_z(v, z);
    HVec4_set_w(v, w);
    return v;
}

# A new HVec4 holding (+0, +0, +0, +0), each component the all-zero bit pattern. Exact, no
# input to refuse; the designed 0 where the allocation is refused, as hvec4_new.
#must_use
public fn hvec4_zero() { return hvec4_new(0, 0, 0, 0); }
# A new HVec4 holding (1.0, 1.0, 1.0, 1.0), exact, with no input to refuse; the designed 0 where
# the allocation is refused, as hvec4_new.
#must_use
public fn hvec4_one() { return hvec4_new(F64_ONE, F64_ONE, F64_ONE, F64_ONE); }
# A new HVec4 holding (s, s, s, s). Any 64-bit s: it is stored as given, with no arithmetic, so a
# NaN, an infinity or a -0 is copied bit for bit. The designed 0 where the allocation is refused,
# as hvec4_new.
#must_use
public fn hvec4_splat(s) { return hvec4_new(s, s, s, s); }

# (v.x, v.y, v.z, w): an HVec3 extended by w (w = 1 a point, w = 0 a direction), bits copied.
#must_use
public fn hvec4_from_vec3(v, w) {
    return hvec4_new(HVec3_x(v), HVec3_y(v), HVec3_z(v), w);
}

# (x, y, z) of v as a new HVec3, w dropped (no division by w), bits copied.
#must_use
public fn hvec4_xyz(v) {
    return hvec3_new(HVec4_x(v), HVec4_y(v), HVec4_z(v));
}

# ================================================================
# Arithmetic
# ================================================================

# SIMD: packed add/sub over all 4 lanes (n=4, no over-read).
# a + b, componentwise, each component one IEEE addition, correctly rounded, the same bits on
# x86 and aarch64.
#must_use
public fn hvec4_add(a, b) {
    var r = alloc(sizeof(HVec4));
    if (r == 0) { return 0; }
    f64v_add(r, a, b, 4);
    return r;
}

# a - b, componentwise, each component correctly rounded.
#must_use
public fn hvec4_sub(a, b) {
    var r = alloc(sizeof(HVec4));
    if (r == 0) { return 0; }
    f64v_sub(r, a, b, 4);
    return r;
}

# SIMD: packed scale by scalar s (f64 bit pattern) over 4 lanes.
# v times s, each component correctly rounded.
#must_use
public fn hvec4_scale(v, s) {
    var r = alloc(sizeof(HVec4));
    if (r == 0) { return 0; }
    f64v_scale(r, v, s, 4);
    return r;
}

# -v, each component's sign flipped (`f64_neg`; below cycc 6.6.8 it gave +0 for +0).
#must_use
public fn hvec4_neg(v) {
    return hvec4_new(f64_neg(HVec4_x(v)),
      f64_neg(HVec4_y(v)),
      f64_neg(HVec4_z(v)),
      f64_neg(HVec4_w(v)));
}

# ================================================================
# Products and norms
# ================================================================

# SIMD: packed dot over all 4 lanes (no alloc — the biggest win).
#
# a . b, summed as the packed dot sums it: on x86 (ax bx + az bz) + (ay by + aw bw), each
# product and each sum rounded (within 3u of the sum of |a_i b_i| to first order, u = 2^-53).
# ⚠ NOT BIT-IDENTICAL ACROSS TARGETS: on aarch64 `f64v_dot` accumulates with a fused `fmla`,
# so each lane's second product is fused into its sum, fma(az, bz, ax bx) rounded once where
# x86 rounds the product first; the same bound holds and the last bits can differ. (CLAUDE.md's
# Language rule names `f64v_axpy` / `f64v_fmadd`; this is the same mechanism in `f64v_dot`,
# from the 6.7.18 emitters, and no test here runs on aarch64.) `hvec4_length_sq` and
# `hvec4_length` inherit it.
# ⚠ A ZERO IS +0 WHEREVER EVERY PRODUCT IS A ZERO, -0 included: `f64v_dot`'s accumulator
# starts at +0 (BLAS ddot's convention), so (-0, -0, -0, -0) . (1, 1, 1, 1) is 0x0 where the
# IEEE sum of the products is -0. Documented, not changed (3.4.1): the fix cost 8 to 11% on the
# dot rows; vec3.cyr's `hvec3_dot` has the reasons.
# [measured: scratch flerp.bcyr and tests/hisab.bcyr, 3.4.0 and the fixed form, 2026-10-31; cycc 6.7.18]
#must_use
public fn hvec4_dot(a, b) {
    return f64v_dot(a, b, 4);
}

# |v|^2 (`hvec4_dot(v, v)`, its summation order and its aarch64 caveat): +Inf once a square
# passes DBL_MAX (|component| >= 2^512), subnormal and losing bits once every component is
# below 2^-511; use `hvec4_length` for the magnitude across the whole range.
#must_use
public fn hvec4_length_sq(v) { return hvec4_dot(v, v); }
fn _hvec4_len_scaled(v) {
    var x = HVec4_x(v);
    var y = HVec4_y(v);
    var z = HVec4_z(v);
    var w = HVec4_w(v);
    var mx = f64_max(f64_max(f64_max(f64_abs(x), f64_abs(y)), f64_abs(z)), f64_abs(w));
    # ⚠ 3.3.3 — NaN never reaches here; see `_hvec3_len_scaled`. Called directly, this
    # max drops a NaN in x, y or z and the exit returns 0; `hvec4_length` routes a NaN
    # to its sqrt(NaN) fast path instead, and tests/abuse.tcyr pins that per slot.
    # [measured: scratch harness, not reproducible in-tree, 2026-10-01; cycc 6.6.12]
    if (f64_gt(mx, 0) == 0) { return mx; }
    # ⚠ Inf/Inf is NaN, so the infinity contract needs its own exit here.
    if (f64_eq(mx, F64_POS_INF) == 1) { return mx; }
    var xs = f64_div(x, mx);
    var ys = f64_div(y, mx);
    var zs = f64_div(z, mx);
    var ws = f64_div(w, mx);
    var acc = f64_add(f64_mul(xs, xs), f64_mul(ys, ys));
    acc = f64_add(acc, f64_add(f64_mul(zs, zs), f64_mul(ws, ws)));
    return f64_mul(mx, f64_sqrt(acc));
}

# ⛔ 2.17.0 — THIS SQUARED BEFORE SUMMING, AND LOST 537 BINADES AT THE BOTTOM AND
# 512 AT THE TOP. `x*x` underflows to zero for any component below 2^-537 and
# overflows to +Inf above 2^511, so a perfectly ordinary vector got a length of
# exactly 0 or exactly +Inf. ⚠ And it was materially wrong BEFORE it reached
# either: a SUBNORMAL sum has already lost most of its mantissa, so the answer is
# finite, plausible and wrong — measured 11.8% out at 2^-539, with nothing to
# signal it. That silent band is the dangerous third of the class.
# [measured: two-sided binade sweep, 2026-09-10]
#
# ⭐ FAST PATH, NOT UNCONDITIONAL SCALING. The naive sum announces its own failure:
# it is subnormal, zero or +Inf exactly when it cannot be trusted, and exact
# otherwise. So take it when it is NORMAL and rescale only when it is not.
# Measured: unconditional scaling costs **+119%** on this helper; the fast path
# costs **+12%** and is not distinguishable in any of the 72 tracked benchmarks
# (median delta -0.03%, the largest move being a row that never calls it).
# ⚠ The trigger is `< F64_TINY`, NOT `== 0` — measured, an `== 0` trigger leaves
# the subnormal band up to 11.8% wrong.
# ⚠ And the `+Inf` short-circuit inside the helper is REQUIRED: without it
# `Inf/Inf` is NaN and the documented infinity contract regresses.
# [measured: 1106-scale two-sided sweep; naive wrong at 60, guarded at 0]
#must_use
public fn hvec4_length(v) {
    var ls = hvec4_length_sq(v);
    if (f64_lt(ls, F64_TINY) == 1) { return _hvec4_len_scaled(v); }
    if (f64_eq(ls, F64_POS_INF) == 1) { return _hvec4_len_scaled(v); }
    return f64_sqrt(ls);
}

# v / |v|, the unit vector along v, for every finite non-zero v from the subnormals to DBL_MAX
# (the scaled copies below; the comment has the sample maxima, about 2 ulp per component). The
# zero vector gives the zero vector, a sentinel with |v| = 0 (it has no direction). A NaN
# component gives NaN components; an infinite one gives NaN in its own slot and zeros in the
# finite ones. Returns the designed 0 where an allocation is refused.
#must_use
public fn hvec4_normalize(v) {
    var len = hvec4_length(v);
    # ⛔ `len` is a LENGTH — degree one in the caller's units — and this tested it
    # against an absolute 1e-12, so a perfectly good short vector normalised to
    # the ZERO VECTOR: not an error value, just a wrong answer with no length.
    # ⭐ 2.14.0 tested what fails, `1 / len`, and for OVERFLOW ONLY: `f64_eq(|inv|, +Inf)`
    # caught len = 0 and any len too small to invert, and let a NaN fall through.
    # ⛔ The obvious `f64_lt(|inv|, F64_POS_INF) == 0` is wrong and `tests/abuse.tcyr`
    # says so out loud: it is false for NaN too, so it would silently zero a NaN vector,
    # and this API's documented contract is **NaN in, NaN out**.
    # ⚠ F64_TINY would have been one binade too strict for that zero exit: 1/2^-1023 is finite.
    # That guard is gone since 3.3.5 (last paragraph); its replacements, `len < DBL_MIN`,
    # `len == 0` and `1/len < DBL_MIN`, are all false for NaN, so NaN still runs the last line.
    # [measured: tests/foundation.tcyr normalize scale sweep, 2026-09-09]
    #
    # ⛔ 3.3.5 — AND THAT EXIT WAS STILL THE ZERO VECTOR FOR EVERY NON-ZERO LENGTH AT OR BELOW
    # 2^-1024, the class 3.3.4 repaired in `hvec3_normalize` only (audit D087): (2^-k, 0, 0, 0)
    # for k = 1023 .. 1074 normalised to the axis for 1 of 52, and (DBL_MAX, DBL_MAX, 0, 0) to
    # the zero vector.
    # [measured: scratch harness, not reproducible in-tree, 2026-10-11; cycc 6.6.14]
    # ⭐ `hvec3_normalize`'s repair, which says why: len < DBL_MIN normalises v * 2^1023 and
    # 1/len < DBL_MIN normalises v * 2^-600, both exact copies. len = 0 still gives the zero
    # vector and NaN runs the last line. On a sample of 1,500 lengths at or below 2^-1024
    # the largest error falls from 9.0e15 ulp to 2.21, and on 3,000 per band the bands
    # (2^-1024, 2^-1022) and (2^1022, DBL_MAX] from 4.49 and 4.73 ulp to 2.06 and the
    # unit-length 1.98 (sample maxima, not bounds).
    # [measured: scratch harness and Decimal oracle, not reproducible in-tree, 2026-10-11; cycc 6.6.14]
    if (f64_lt(len, F64_TINY) == 1) {
        if (f64_eq(len, 0) == 1) { return hvec4_zero(); }
        var up = hvec4_scale(v, (1023 + 1023) << 52);   # 2^1023
        if (up == 0) { return 0; }
        return hvec4_scale(up, f64_div(F64_ONE, hvec4_length(up)));
    }
    var inv = f64_div(F64_ONE, len);
    if (f64_lt(inv, F64_TINY) == 1) {
        var dn = hvec4_scale(v, (1023 - 600) << 52);    # 2^-600
        if (dn == 0) { return 0; }
        return hvec4_scale(dn, f64_div(F64_ONE, hvec4_length(dn)));
    }
    return hvec4_scale(v, inv);
}
