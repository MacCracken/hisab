# abuse.tcyr -- hostile-input harness (2.9.0 exit criterion 2)
#
# "An abuse harness (negative indices, zero/huge dims, non-conformable operands,
#  the designed-0 return, degenerate geometry) runs clean: no exit 139, no canary
#  overwrite."
#
# This suite is NOT about numerical answers -- modules.tcyr / hisab.tcyr /
# foundation.tcyr own those. Every assertion here is about what the library does
# when it is handed something it was never meant to be handed:
#
#   * negative indices and negative counts wherever an index or count is taken
#   * zero, one, and overflow-prone dimensions
#   * non-conformable operands (shape mismatches, mismatched lengths)
#   * THE DESIGNED 0 -- every capped constructor in hisab returns 0 rather than
#     allocating, and every consumer of such a handle must reject it rather than
#     store through it
#   * degenerate geometry -- zero-extent boxes, zero-radius spheres, coincident
#     points, collinear triangles, NaN / +-Inf coordinates
#   * CANARY CHECKS -- a guard block is allocated immediately after an out-buffer
#     (the bump allocator hands out adjacent blocks), the routine is called with
#     abusive arguments, and the guard is asserted untouched. This is the only
#     way a write-past-the-end shows up as a test failure rather than as luck.
#
# The four crash signals this harness is built to detect:
#     exit 139  SIGSEGV       -- null / wild pointer store
#     exit 136  SIGFPE        -- integer divide by zero
#     exit 1    "vec: index"  -- vec_get's own bounds abort
#     nonzero clobber count   -- write past an out-buffer
#
# Cases that KILL the process cannot live in a suite that must exit 0. The ones
# found while building this file are recorded verbatim in the KNOWN DEFECT
# register at the bottom, each with its file, its function and its exact
# reproducer, so the case is documented rather than discarded. The register holds
# eleven entries. Ten are [FIXED] (2.9.0) and asserted in the body of this file;
# they cover ten public functions, because cqr_decompose has two entries and
# halfedge_adjacent_faces / halfedge_is_boundary share one. The eleventh,
# cmat_get / cmat_set, was re-measured, found not to reproduce as written, and
# reclassified as a documented precondition [BY DESIGN]. CHANGELOG 2.9.0 counts
# cqr_decompose's two entries as one, so its crash-tier and tests/abuse.tcyr
# entries say ten entries and nine repaired.
# [measured: tests/abuse.tcyr, the register's entry headers: grep -c '^# --- src/' = 11]

include "src/error.cyr"
include "src/f64_util.cyr"
include "src/vec2.cyr"
include "src/vec3.cyr"
include "src/vec4.cyr"
include "src/quat.cyr"
include "src/mat3.cyr"
include "src/mat4.cyr"
include "src/transforms.cyr"
include "src/color.cyr"
include "src/complex.cyr"
include "src/interval.cyr"
include "src/autodiff.cyr"
include "src/tensor.cyr"
include "src/geo.cyr"
include "src/geo_advanced.cyr"
include "src/geo_diff.cyr"
include "src/spatial.cyr"
include "src/collision_core.cyr"
include "src/collision_mesh.cyr"
include "src/calc.cyr"
include "src/calc_ext.cyr"
include "src/num.cyr"
include "src/num_ext.cyr"
include "src/ode.cyr"
include "src/optimize.cyr"
include "src/linalg_ext.cyr"
include "src/linalg_precision.cyr"
include "src/einsum.cyr"
include "src/noise_simplex.cyr"
include "src/lie.cyr"
include "src/lie_ext.cyr"
include "src/diffgeo.cyr"
include "src/symbolic.cyr"
include "src/symbolic_ext.cyr"

# ================================================================
# Helpers
# ================================================================

# Guard word. 0x5A5A... is the pattern the 2.8.3 svd canary in hisab.tcyr uses;
# it is not a plausible f64 bit pattern, not a plausible pointer, and not 0, so
# any of the three ways a routine can scribble on it is visible.
var _AB_CANARY = 0x5A5A5A5A5A5A5A5A;

var _AB_NAN  = 0x7FF8000000000000;
var _AB_PINF = 0x7FF0000000000000;
# ⭐ 2.13.0 — a NAMED tolerance. This suite had none: its only approximate
# compare spelled the bound as a raw hex literal at the call site
# (`0x3E45798EE2308C3A`), which is exactly how a tolerance drifts unnoticed
# between sites. Same value as `LOOSE_TOL_H`/`LOOSE_TOL_M` in the sibling suites.
var _AB_TOL = 0x3E45798EE2308C3A;   # ~1e-8

var _AB_NINF = 0xFFF0000000000000;

# 7.0. Held as a bit pattern rather than as f64_from(7) so the "did the routine
# write here?" tests below are integer comparisons on i64 words -- `load64(p) ==
# f64_from(7)` is a mixed f64/integer comparison and cycc warns on it. The
# pattern is checked against f64_from(7) at the top of the run, so a typo in the
# literal is a test failure and not a silently weaker harness.
var _AB_SEVEN = 0x401C000000000000;

# Allocate an n-slot guard block and stamp every slot.
#
# The bump allocator never reorders and never frees, so the block returned here
# starts at exactly (previous allocation + its rounded size): calling this
# IMMEDIATELY after allocating an out-buffer puts the guard in the bytes a
# one-past-the-end store would land on.
fn _ab_canary_new(n) {
    var c = alloc(n * 8);
    var i = 0;
    while (i < n) {
        store64(c + i * 8, _AB_CANARY);
        i = i + 1;
    }
    return c;
}

# Number of guard slots that no longer hold the stamp. 0 == clean.
fn _ab_clob(c, n) {
    var bad = 0;
    var i = 0;
    while (i < n) {
        if (load64(c + i * 8) != _AB_CANARY) { bad = bad + 1; }
        i = i + 1;
    }
    return bad;
}

# Fill an n-slot f64 buffer with a recognisable non-zero sentinel (7.0), so
# "the routine wrote nothing" is distinguishable from "the routine wrote 0".
fn _ab_fill7(p, n) {
    var i = 0;
    while (i < n) {
        store64(p + i * 8, _AB_SEVEN);
        i = i + 1;
    }
    return 0;
}

# How many of the n slots still hold 7.0.
fn _ab_count7(p, n) {
    var k = 0;
    var i = 0;
    while (i < n) {
        if (load64(p + i * 8) == _AB_SEVEN) { k = k + 1; }
        i = i + 1;
    }
    return k;
}

# Snapshot n i64 words into a fresh block.
fn _ab_snapshot(p, n) {
    var s = alloc(n * 8);
    var i = 0;
    while (i < n) {
        store64(s + i * 8, load64(p + i * 8));
        i = i + 1;
    }
    return s;
}

# Number of the n words in which a and b differ. 0 == bit-identical.
fn _ab_diff(a, b, n) {
    var d = 0;
    var i = 0;
    while (i < n) {
        if (load64(a + i * 8) != load64(b + i * 8)) { d = d + 1; }
        i = i + 1;
    }
    return d;
}

# 1 if x is NaN (unordered with itself), else 0. Bit equality is not enough:
# NaN has 2^52 payloads and the routines below may produce any of them.
fn _ab_is_nan(x) {
    if (f64_eq(x, x) == 1) { return 0; }
    return 1;
}

# 1 if x is finite -- not NaN and not either infinity. Tested on the EXPONENT
# BITS rather than by comparing against the two infinity patterns: an all-ones
# exponent is exactly "infinity or NaN", and a bitmask keeps this an integer
# operation on what is, at this level, an i64 bit pattern.
fn _ab_is_finite(x) {
    if ((x & 0x7FF0000000000000) == 0x7FF0000000000000) { return 0; }
    return 1;
}

# --- scalar callbacks for the calculus / ODE / optimiser abuse cases ---
fn _ab_f_x2(x)      { return f64_mul(x, x); }
fn _ab_dydt(t, y)   { return y; }
fn _ab_diffusion(t, y) { return F64_ONE; }
fn _ab_dg_dy(t, y)  { return 0; }
fn _ab_accel(q)     { return f64_neg(q); }

# --- vector callbacks: f(x) = x0^2 + x1^2 on a flat 2-slot f64 array ---
fn _ab_fvec(x) {
    return f64_add(f64_mul(load64(x), load64(x)),
      f64_mul(load64(x + 8), load64(x + 8)));
}

fn _ab_gvec(x) {
    var g = alloc(16);
    store64(g, f64_mul(F64_TWO, load64(x)));
    store64(g + 8, f64_mul(F64_TWO, load64(x + 8)));
    return g;
}

# --- least-squares callbacks for opt_levenberg_marquardt ---
fn _ab_residuals(x) {
    var r = alloc(8);
    store64(r, load64(x));
    return r;
}

fn _ab_jacobian(x) {
    var j = alloc(8);
    store64(j, F64_ONE);
    return j;
}

# --- matvec callback for the Krylov solvers: y = 2x on R^3 ---
fn _ab_matvec(x) {
    var y = alloc(3 * 8);
    var i = 0;
    while (i < 3) {
        store64(y + i * 8, f64_mul(F64_TWO, load64(x + i * 8)));
        i = i + 1;
    }
    return y;
}

# --- support functions for the narrowphase abuse cases ---
# shape = HVec4 [cx, cy, cz, radius]; a zero radius is a POINT, the degenerate
# case every support-mapping algorithm has to survive.
fn _ab_sup_sphere(shape, dir) {
    var c = hvec3_new(HVec4_x(shape), HVec4_y(shape), HVec4_z(shape));
    var dn = hvec3_normalize(dir);
    return hvec3_add(c, hvec3_scale(dn, HVec4_w(shape)));
}

alloc_init();

# ================================================================
# 1. CAPPED CONSTRUCTORS RETURN THE DESIGNED 0
# ================================================================
# Every one of these caps a dimension and returns 0 rather than allocating. The
# 0 is the CONTRACT, not a failure to check -- sections 2 and 3 then verify that
# the consumers honour it.
test_group("abuse: capped constructors return the designed 0");

# The hand-typed 7.0 pattern the write-detection helpers key on. A wrong literal
# here would make every "out untouched" assertion below vacuously true.
assert_eq(_AB_SEVEN, f64_from(7), "harness: the _AB_SEVEN sentinel really is 7.0");

var ab_shape = alloc(64);
store64(ab_shape, 2);
store64(ab_shape + 8, 3);
store64(ab_shape + 16, 4);
store64(ab_shape + 24, 5);

assert_eq(tensor_new((0 - 1), ab_shape), 0, "tensor_new: rank = -1 -> 0");
assert_eq(tensor_new(9, ab_shape), 0, "tensor_new: rank = 9 (over the rank-8 cap) -> 0");

var ab_sh_zero = alloc(16);
store64(ab_sh_zero, 0);
store64(ab_sh_zero + 8, 2);
assert_eq(tensor_new(2, ab_sh_zero), 0, "tensor_new: extent 0 -> 0");

store64(ab_sh_zero, (0 - 3));
assert_eq(tensor_new(2, ab_sh_zero), 0, "tensor_new: extent -3 -> 0");

# 1e6 x 1e6 = 1e12 elements = 8 TB. The guard is a DIVISION (total > MAX/dim),
# so it fires before the multiply that would wrap i64.
var ab_sh_huge = alloc(16);
store64(ab_sh_huge, 1000000);
store64(ab_sh_huge + 8, 1000000);
assert_eq(tensor_new(2, ab_sh_huge), 0, "tensor_new: 1e6 x 1e6 (8 TB) -> 0");

# rank 0 is legal: a scalar. Distinguish "capped" from "degenerate but valid".
assert_neq(tensor_new(0, ab_shape), 0, "tensor_new: rank 0 is a scalar, not an error");

assert_eq(cmat_new((0 - 1), 3), 0, "cmat_new: rows = -1 -> 0");
assert_eq(cmat_new(3, (0 - 1)), 0, "cmat_new: cols = -1 -> 0");
assert_eq(cmat_new(0, 0), 0, "cmat_new: 0 x 0 -> 0");
assert_eq(cmat_new(1, 0), 0, "cmat_new: 1 x 0 -> 0");
assert_eq(cmat_new(100000, 100000), 0, "cmat_new: 1e5 x 1e5 (over 64K elems) -> 0");
assert_neq(cmat_new(1, 1), 0, "cmat_new: 1 x 1 is the smallest legal matrix");

assert_eq(cmat_identity(0), 0, "cmat_identity: n = 0 -> 0");
assert_eq(cmat_identity((0 - 4)), 0, "cmat_identity: n = -4 -> 0");
assert_eq(cmat_identity(1000000), 0, "cmat_identity: n = 1e6 -> 0 (propagates cmat_new)");

assert_eq(mat_new_guarded((0 - 1), 3), 0, "mat_new_guarded: rows = -1 -> 0");
assert_eq(mat_new_guarded(3, (0 - 1)), 0, "mat_new_guarded: cols = -1 -> 0");
assert_eq(mat_new_guarded(0, 3), 0, "mat_new_guarded: rows = 0 -> 0");
assert_eq(mat_new_guarded(1000000, 1000000), 0, "mat_new_guarded: 1e6 x 1e6 -> 0");
assert_neq(mat_new_guarded(1, 1), 0, "mat_new_guarded: 1 x 1 allocates");

# The stdlib constructor is guarded too as of ganita 1.0.4 -- before that,
# mat_new(-5, 3) segfaulted outright.
# [measured: CHANGELOG.md 2.6.11, the vendored-ganita table (mat_new(-5, 3): SIGSEGV, exit 139 on 1.0.3)]
assert_eq(ganita_mat_new((0 - 5), 3), 0, "mat_new (stdlib): rows = -5 -> 0");
assert_eq(ganita_mat_new(1000000000, 1000000000), 0, "mat_new (stdlib): 1e9 x 1e9 -> 0");

# alloc() itself is the bottom of the designed-0 chain: nothing else in this
# file can be reasoned about if a non-positive size ever returns a pointer.
assert_eq(alloc(0), 0, "alloc: size 0 -> 0");
assert_eq(alloc((0 - 8)), 0, "alloc: negative size -> 0 (no backwards bump)");
assert_eq(alloc(0x100000000000), 0, "alloc: size over ALLOC_MAX -> 0");

# ================================================================
# 2. THE DESIGNED 0, PROPAGATED: complex matrices
# ================================================================
# cmat_new returns 0 above _CMAT_MAX_ELEMS. cmat_rows(0) is load64(0). Every
# entry point that takes a cmat handle therefore has to reject 0 BEFORE reading
# metadata, or the designed error signal becomes a null dereference.
test_group("abuse: designed-0 propagation through the cmat family");

var ab_c22 = cmat_new(2, 2);
cmat_set(ab_c22, 0, 0, cx_one());
cmat_set(ab_c22, 1, 1, cx_one());
var ab_c23 = cmat_new(2, 3);
var ab_c32 = cmat_new(3, 2);

assert_eq(cmat_mul(0, ab_c22), 0, "cmat_mul: a = 0 -> 0");
assert_eq(cmat_mul(ab_c22, 0), 0, "cmat_mul: b = 0 -> 0");
assert_eq(cmat_mul(0, 0), 0, "cmat_mul: both 0 -> 0");
assert_eq(cmat_add(0, ab_c22), 0, "cmat_add: a = 0 -> 0");
assert_eq(cmat_add(ab_c22, 0), 0, "cmat_add: b = 0 -> 0");
assert_eq(cmat_sub(0, ab_c22), 0, "cmat_sub: a = 0 -> 0");
assert_eq(cmat_sub(ab_c22, 0), 0, "cmat_sub: b = 0 -> 0");
assert_eq(cmat_scale(0, cx_one()), 0, "cmat_scale: m = 0 -> 0");
assert_eq(cmat_adjoint(0), 0, "cmat_adjoint: m = 0 -> 0");
assert_eq(cmat_trace(0), 0, "cmat_trace: m = 0 -> 0");
assert_eq(cmat_mul_vec(0, 0), 0, "cmat_mul_vec: m = 0 -> 0");
assert_eq(cmat_commutator(0, ab_c22), 0, "cmat_commutator: a = 0 -> 0");
assert_eq(cmat_commutator(ab_c22, 0), 0, "cmat_commutator: b = 0 -> 0");
assert_eq(cmat_anticommutator(0, ab_c22), 0, "cmat_anticommutator: a = 0 -> 0");
assert_eq(cmat_anticommutator(ab_c22, 0), 0, "cmat_anticommutator: b = 0 -> 0");
assert_eq(cmat_kronecker(0, ab_c22), 0, "cmat_kronecker: a = 0 -> 0");
assert_eq(cmat_kronecker(ab_c22, 0), 0, "cmat_kronecker: b = 0 -> 0");
assert_eq(cmat_exp(0), 0, "cmat_exp: m = 0 -> 0");
assert_eq(cmat_inverse(0), 0, "cmat_inverse: m = 0 -> 0");

# A capped constructor feeding a consumer directly -- the whole point of the
# contract. cmat_new(1e5, 1e5) is 0, and cmat_mul must survive being handed it.
assert_eq(cmat_mul(cmat_new(100000, 100000), ab_c22), 0,
  "cmat_mul: capped cmat_new result flows straight through");
assert_eq(cmat_inverse(cmat_new(100000, 100000)), 0,
  "cmat_inverse: capped cmat_new result flows straight through");
assert_eq(cmat_exp(cmat_identity(1000000)), 0,
  "cmat_exp: capped cmat_identity result flows straight through");

# --- cmat_get / cmat_set: RAW ACCESSORS, DELIBERATELY UNGUARDED ---
#
# The register at the bottom of this file listed these as an [OPEN] crash. They
# were re-measured and REVIEWED, and the decision is NO GUARD -- the reasoning
# now lives in full at src/complex.cyr above cmat_get. In short: the success
# value of cmat_get is a HANDLE from cx_new, so a rejection can only be 0 (which
# moves the SIGSEGV one frame out to the caller's HComplex_re(0)) or cx_zero()
# (which is bit-identical to a legitimate 0+0i element and would feed a
# real-looking zero into every consumer). They mirror stdlib ganita_mat_get /
# ganita_mat_set (lib/ganita.cyr), which are the same unchecked stride
# computation; and with the tests temporarily added to both, a 120x120 complex
# matmul went 276 ms -> 294 ms (+6.5%) for a check every caller has already
# done. The validated surface is the block of assertions ABOVE this comment --
# every public cmat_* entry point rejects the designed 0 before an accessor can
# see it. Every in-tree accessor call site (100) sits inside a routine that either
# validated its operands first (the cmat_* entry points, cmat_inverse,
# cqr_decompose) or built its own fixed-size matrix (pauli_*, gamma_*, gell_mann).
# [measured: whole-word count of cmat_get( / cmat_set( in src/, definitions excluded, 2026-10-01]
#
# THE REGISTER'S REPRODUCER DID NOT REPRODUCE. `cmat_get(cmat_new(2, 2), -1, 0)`
# was recorded as exit 139; re-measured in isolation it exits 0 and returns
# 0+0i, because -1 * 2 * 16 = -32 bytes lands inside the 24-byte header the bump
# allocator handed out just ahead of the data buffer. What does fault is a far
# index (r = -1e8 or +1e8, exit 139) or a null handle (exit 139) -- both
# precondition violations, neither assertable from a suite that must exit 0.
# [measured: CHANGELOG.md 2.9.0, cmat_get / cmat_set under Changed ("The register's reproducer did not reproduce")]
#
# What IS assertable, and what these pin, is the precondition's other half: an
# IN-BOUNDS access must stay inside the buffer at every corner, including the
# last element, because that is the only way the documented contract can be
# honoured by a caller who does bound its indices.
var ab_cg = cmat_new(2, 3);
var ab_cg_can = _ab_canary_new(8);
var ab_cgr = 0;
while (ab_cgr < 2) {
    var ab_cgc = 0;
    while (ab_cgc < 3) {
        cmat_set(ab_cg, ab_cgr, ab_cgc, cx_new(f64_from(ab_cgr * 3 + ab_cgc + 1), F64_TWO));
        ab_cgc = ab_cgc + 1;
    }
    ab_cgr = ab_cgr + 1;
}
assert_eq(_ab_clob(ab_cg_can, 8), 0,
  "cmat_set: filling every in-bounds slot of a 2x3 leaves the next block clean");
assert_eq(HComplex_re(cmat_get(ab_cg, 0, 0)), f64_from(1), "cmat_get: (0,0) round-trips");
assert_eq(HComplex_re(cmat_get(ab_cg, 1, 2)), f64_from(6),
  "cmat_get: the LAST element (1,2) round-trips -- stride is exact at the corner");
assert_eq(HComplex_im(cmat_get(ab_cg, 1, 2)), f64_from(2), "cmat_get: last element imag part");
assert_eq(HComplex_re(cmat_get(ab_cg, 1, 0)), f64_from(4), "cmat_get: (1,0) crosses one full row");
assert_eq(_ab_clob(ab_cg_can, 8), 0, "cmat_get: reading every slot touches nothing");

# ================================================================
# 3. NON-CONFORMABLE OPERANDS
# ================================================================
test_group("abuse: non-conformable complex-matrix operands");

# a is ar x ac, so b must be ac x bc. 2x3 * 2x2 does not conform: without the
# check the k loop walks 3 rows of a 2-row buffer.
assert_eq(cmat_mul(ab_c23, ab_c22), 0, "cmat_mul: 2x3 * 2x2 (inner dims differ) -> 0");
assert_neq(cmat_mul(ab_c23, ab_c32), 0, "cmat_mul: 2x3 * 3x2 DOES conform");
assert_eq(cmat_add(ab_c22, ab_c23), 0, "cmat_add: 2x2 + 2x3 -> 0");
assert_eq(cmat_add(ab_c23, ab_c32), 0, "cmat_add: 2x3 + 3x2 (same elem count) -> 0");
assert_eq(cmat_sub(ab_c22, ab_c23), 0, "cmat_sub: 2x2 - 2x3 -> 0");
assert_eq(cmat_commutator(ab_c22, ab_c23), 0, "cmat_commutator: 2x2 vs 2x3 -> 0");
assert_eq(cmat_anticommutator(ab_c22, ab_c23), 0, "cmat_anticommutator: 2x2 vs 2x3 -> 0");
assert_eq(cmat_exp(ab_c23), 0, "cmat_exp: non-square -> 0");
assert_eq(cmat_inverse(ab_c23), 0, "cmat_inverse: non-square -> 0");

# cqr_decompose: THE CANARY OVERWRITE, now an executable assertion (crash tier, 2.9.0).
#
# Through 2.8.4 this call could not appear in a suite that has to exit 0: with no
# check that out_R was the documented m x n, the copy loop walked i < m, j < n
# into an m x m out_R and cmat_set's offset -- computed from out_R's OWN column
# count -- ran off the end for every j >= m. It returned HSB_ERR_NONE on top of
# the overrun. Measured before the fix: rc = HSB_ERR_NONE (0) with 2 of 8 guard
# slots clobbered, the 16 bytes immediately after out_R's data buffer; the square
# 2x2 control over the same code path clobbered 0 of 8.
# [measured: CHANGELOG.md 2.9.0, the crash tier, cqr_decompose ("2 of 8 guard slots clobbered")]
#
# ab_c23 above is all zeros (it exists only for shape checks), and an all-zero A
# would make the reconstruction assertions at the end of this block vacuously
# true, so the decomposition fixture is a separate 2x3 filled 1..6 -- the exact
# matrix the register's reproducer used.
var ab_cqrA = cmat_new(2, 3);
var ab_cqrf = 1;
var ab_cqra = 0;
while (ab_cqra < 2) {
    var ab_cqrb = 0;
    while (ab_cqrb < 3) {
        cmat_set(ab_cqrA, ab_cqra, ab_cqrb, cx_new(f64_from(ab_cqrf), f64_from(0)));
        ab_cqrf = ab_cqrf + 1;
        ab_cqrb = ab_cqrb + 1;
    }
    ab_cqra = ab_cqra + 1;
}

# The guard block is allocated IMMEDIATELY after out_R so the bump allocator puts
# it exactly where a one-past-the-end store lands.
var ab_cqrR = cmat_new(2, 2);
var ab_cqr_can = _ab_canary_new(8);
var _rq1t, _rq1v = cqr_decompose(ab_cqrA, cmat_new(2, 2), ab_cqrR);
assert_eq(is_err_result(_rq1t), 1, "cqr_decompose: 2x3 A into a 2x2 out_R -> HSB_ERR_INVALID_INPUT (was HSB_ERR_NONE)");
assert_eq(_rq1v, HSB_ERR_INVALID_INPUT,
  "cqr_decompose: 2x3 A into a 2x2 out_R -> HSB_ERR_INVALID_INPUT (was HSB_ERR_NONE)");
assert_eq(_ab_clob(ab_cqr_can, 8), 0,
  "cqr_decompose: canary past out_R clean (was 2 of 8 slots clobbered)");

# out_Q is checked on the same footing: it is written as an m x m identity.
var _rq2t, _rq2v = cqr_decompose(ab_c22, cmat_new(2, 3), cmat_new(2, 2));
assert_eq(is_err_result(_rq2t), 1, "cqr_decompose: out_Q 2x3 for a 2x2 A -> HSB_ERR_INVALID_INPUT");
assert_eq(_rq2v, HSB_ERR_INVALID_INPUT, "cqr_decompose: out_Q 2x3 for a 2x2 A -> HSB_ERR_INVALID_INPUT");
var _rq3t, _rq3v = cqr_decompose(ab_cqrA, cmat_new(2, 2), cmat_new(3, 3));
assert_eq(is_err_result(_rq3t), 1, "cqr_decompose: out_R 3x3 for a 2x3 A -> HSB_ERR_INVALID_INPUT");
assert_eq(_rq3v, HSB_ERR_INVALID_INPUT, "cqr_decompose: out_R 3x3 for a 2x3 A -> HSB_ERR_INVALID_INPUT");

# THE SECOND REGISTER DEFECT: no null check on any of the three arguments.
# cmat_rows(0) is load64(0), and cmat_new returns the designed 0 above
# _CMAT_MAX_ELEMS -- so the capped-constructor call below LOOKS like it allocated.
var _rq4t, _rq4v = cqr_decompose(0, cmat_new(2, 2), cmat_new(2, 2));
assert_eq(is_err_result(_rq4t), 1, "cqr_decompose: A = 0 -> HSB_ERR_INVALID_INPUT (was exit 139)");
assert_eq(_rq4v, HSB_ERR_INVALID_INPUT, "cqr_decompose: A = 0 -> HSB_ERR_INVALID_INPUT (was exit 139)");
var _rq5t, _rq5v = cqr_decompose(ab_c22, 0, cmat_new(2, 2));
assert_eq(is_err_result(_rq5t), 1, "cqr_decompose: out_Q = 0 -> HSB_ERR_INVALID_INPUT");
assert_eq(_rq5v, HSB_ERR_INVALID_INPUT, "cqr_decompose: out_Q = 0 -> HSB_ERR_INVALID_INPUT");
var _rq6t, _rq6v = cqr_decompose(ab_c22, cmat_new(2, 2), 0);
assert_eq(is_err_result(_rq6t), 1, "cqr_decompose: out_R = 0 -> HSB_ERR_INVALID_INPUT");
assert_eq(_rq6v, HSB_ERR_INVALID_INPUT, "cqr_decompose: out_R = 0 -> HSB_ERR_INVALID_INPUT");
var _rq7t, _rq7v = cqr_decompose(cmat_new(100000, 100000), cmat_new(2, 2), cmat_new(2, 2));
assert_eq(is_err_result(_rq7t), 1, "cqr_decompose: capped cmat_new 0 flows through (was exit 139)");
assert_eq(_rq7v, HSB_ERR_INVALID_INPUT, "cqr_decompose: capped cmat_new 0 flows through (was exit 139)");

# The square path is exercised so the surrounding contract is still covered.
var _rq8t, _rq8v = cqr_decompose(ab_c22, cmat_new(2, 2), cmat_new(2, 2));
assert_eq(is_ok(_rq8t), 1, "cqr_decompose: a square 2x2 decomposes");

# AND THE RECTANGULAR CASE IS HANDLED, NOT REJECTED. The Householder algorithm is
# general in m and n; the defect was purely that the out-buffer size was never
# checked. With out_R sized to the documented m x n the 2x3 decomposition is
# correct, so the guard above rejects a caller error and not a legitimate shape.
var ab_cqrQ2 = cmat_new(2, 2);
var ab_cqrR2 = cmat_new(2, 3);
var _rq9t, _rq9v = cqr_decompose(ab_cqrA, ab_cqrQ2, ab_cqrR2);
assert_eq(is_ok(_rq9t), 1, "cqr_decompose: 2x3 A with a correctly sized 2x3 out_R decomposes");
# Q*R must reproduce A, and R must be upper trapezoidal (R[1][0] == 0).
var ab_cqrQR = cmat_mul(ab_cqrQ2, ab_cqrR2);
var ab_cqr_worst = f64_from(0);
var ab_cqri = 0;
while (ab_cqri < 2) {
    var ab_cqrj = 0;
    while (ab_cqrj < 3) {
        var ab_cqrd = cx_abs(cx_sub(cmat_get(ab_cqrQR, ab_cqri, ab_cqrj),
            cmat_get(ab_cqrA, ab_cqri, ab_cqrj)));
        if (f64_gt(ab_cqrd, ab_cqr_worst) == 1) { ab_cqr_worst = ab_cqrd; }
        ab_cqrj = ab_cqrj + 1;
    }
    ab_cqri = ab_cqri + 1;
}
assert(f64_lt(ab_cqr_worst, 0x3E45798EE2308C3A) == 1,
  "cqr_decompose: 2x3 Q*R reproduces A to < 1e-8");
assert(f64_lt(cx_abs(cmat_get(ab_cqrR2, 1, 0)), 0x3E45798EE2308C3A) == 1,
  "cqr_decompose: 2x3 R is upper trapezoidal (|R[1][0]| < 1e-8)");

# === 3.3.3 G1: cqr_decompose rejects non-finite input ===
# ⛔ 3.3.3 — A NaN ENTRY CAME BACK AS A FINITE, PLAUSIBLE R WITH rc = OK.
# cqr_decompose never got the non-finite check svd_golub_kahan and eigen_qr got in
# 2.22.0. A NaN makes its column's norm NaN, `f64_gt(norm, 0) == 1` is false for NaN
# so that reflector is skipped, and the strictly-lower triangle is then zeroed by
# contract, which erases the NaN. Measured on 3.3.2 with A = [[3,1],[NaN,2]]:
# rc = OK, R = [[3,1],[0,-2]], Q = diag(1,-1), all finite, and Q*R is not A; the
# same with the NaN in the IMAGINARY part. A NaN at A[0][0] stays in R00 but rc is
# still OK, and +/-Inf (three positions probed) gives rc = OK with R NaN above the
# diagonal.
# ⚠ Real and imaginary parts are asserted separately, NaN and both infinities,
# plus the finite control: a check written for one component passes the other.
# [measured: scratch probe on the 3.3.2 bundle, not reproducible in-tree, 2026-10-01; cycc 6.6.12]
fn _g1_cqnf(a00re, a00im, a10re, a10im) {
    var A = cmat_new(2, 2);
    cmat_set(A, 0, 0, cx_new(a00re, a00im));
    cmat_set(A, 0, 1, cx_new(F64_ONE, 0));
    cmat_set(A, 1, 0, cx_new(a10re, a10im));
    cmat_set(A, 1, 1, cx_new(F64_TWO, 0));
    var rt, rv = cqr_decompose(A, cmat_new(2, 2), cmat_new(2, 2));
    if (rt != 0) { return rv; }
    return HSB_ERR_NONE;
}
var _g1_nan = f64_div(f64_from(0), f64_from(0));
assert_eq(_g1_cqnf(f64_from(3), 0, _g1_nan, 0), HSB_ERR_INVALID_INPUT,
  "cqr_decompose: NaN below the diagonal rejected (3.3.2: OK with a finite R, NaN erased)");
assert_eq(_g1_cqnf(f64_from(3), 0, f64_from(4), _g1_nan), HSB_ERR_INVALID_INPUT,
  "cqr_decompose: NaN in an IMAGINARY part rejected (3.3.2: OK with a finite R)");
assert_eq(_g1_cqnf(_g1_nan, 0, f64_from(4), 0), HSB_ERR_INVALID_INPUT,
  "cqr_decompose: NaN on the diagonal rejected (3.3.2: OK)");
assert_eq(_g1_cqnf(F64_POS_INF, 0, f64_from(4), 0), HSB_ERR_INVALID_INPUT,
  "cqr_decompose: +Inf real part rejected (3.3.2: OK, R NaN above the diagonal)");
assert_eq(_g1_cqnf(f64_from(3), 0, f64_from(4), f64_neg(F64_POS_INF)), HSB_ERR_INVALID_INPUT,
  "cqr_decompose: -Inf imaginary part rejected (3.3.2: OK, R NaN above the diagonal)");
assert_eq(_g1_cqnf(f64_from(3), 0, f64_from(4), 0), HSB_ERR_NONE,
  "cqr_decompose: the same matrix, finite, is still accepted (control)");

# === 3.3.3 R4lp: cqr_decompose's non-finite scan covers every row and column ===
# The fixtures above are 2x2 with the bad value in column 0, so a scan that skipped
# the last column, or one handed (A, m, m), passed every suite and reopened the
# laundering: 3x2 [[0,5],[0,7],[0,NaN]] came back rc = OK with R = [[0,5],[0,7],[0,0]],
# as on 3.3.2, and a wide 2x3 with the NaN in its last column returned NaN in R with
# rc = OK. Each shape in each part, plus the finite control of each.
# [measured: scratch probes on this tree and the two short-scan mutants, not reproducible in-tree, 2026-10-01]
fn _r4lp_cqnf(m, n, part) {
    var A = cmat_new(m, n);
    for (var i = 0; i < m; i = i + 1) { for (var j = 0; j < n; j = j + 1) { cmat_set(A, i, j, cx_new(0, 0)); } }
    if (m == 3) {
        cmat_set(A, 0, 1, cx_new(f64_from(5), 0));
        cmat_set(A, 1, 1, cx_new(f64_from(7), 0));
    } else {
        cmat_set(A, 0, 0, cx_new(f64_from(3), 0));
        cmat_set(A, 0, 1, cx_new(F64_ONE, 0));
        cmat_set(A, 0, 2, cx_new(F64_TWO, 0));
        cmat_set(A, 1, 0, cx_new(f64_from(4), 0));
        cmat_set(A, 1, 1, cx_new(F64_TWO, 0));
    }
    var nan = f64_div(f64_from(0), f64_from(0));
    if (part == 0) { cmat_set(A, m - 1, n - 1, cx_new(nan, 0)); }
    if (part == 1) { cmat_set(A, m - 1, n - 1, cx_new(0, nan)); }
    var rt, rv = cqr_decompose(A, cmat_new(m, m), cmat_new(m, n));
    if (rt != 0) { return rv; }
    return HSB_ERR_NONE;
}
assert_eq(_r4lp_cqnf(3, 2, 0), HSB_ERR_INVALID_INPUT,
  "cqr_decompose 3x2: NaN real part at [2][1] rejected (3.3.2 and a last-column-short scan: OK, NaN erased)");
assert_eq(_r4lp_cqnf(3, 2, 1), HSB_ERR_INVALID_INPUT,
  "cqr_decompose 3x2: NaN imaginary part at [2][1] rejected (3.3.2: OK, NaN erased)");
assert_eq(_r4lp_cqnf(3, 2, 2), HSB_ERR_NONE, "cqr_decompose 3x2: the same matrix, finite, is accepted (control)");
assert_eq(_r4lp_cqnf(2, 3, 0), HSB_ERR_INVALID_INPUT,
  "cqr_decompose 2x3: NaN real part at [1][2] rejected (an m x m scan: OK, NaN in R)");
assert_eq(_r4lp_cqnf(2, 3, 1), HSB_ERR_INVALID_INPUT,
  "cqr_decompose 2x3: NaN imaginary part at [1][2] rejected (an m x m scan: OK, NaN in R)");
assert_eq(_r4lp_cqnf(2, 3, 2), HSB_ERR_NONE, "cqr_decompose 2x3: the same matrix, finite, is accepted (control)");

test_group("3.3.5 abuse: cqr_decompose, a hand-built zero-column header");
var _g2365_A = alloc(24);
store64(_g2365_A, 2);
store64(_g2365_A + 8, 0);
store64(_g2365_A + 16, alloc(64));
var _g2365_R = alloc(24);
store64(_g2365_R, 2);
store64(_g2365_R + 8, 0);
store64(_g2365_R + 16, alloc(64));
var _g2365_t, _g2365_v = cqr_decompose(_g2365_A, cmat_new(2, 2), _g2365_R);
assert_eq(is_ok(_g2365_t), 0, "cqr_decompose: a hand-built 2 x 0 A (and R) is refused, not answered Ok with Q = I");
assert_eq(_g2365_v, HSB_ERR_INVALID_INPUT, "cqr_decompose: n = 0 -> INVALID_INPUT");

test_group("abuse: non-conformable tensor operands");

var ab_sh22 = alloc(16);
store64(ab_sh22, 2);
store64(ab_sh22 + 8, 2);
var ab_sh23 = alloc(16);
store64(ab_sh23, 2);
store64(ab_sh23 + 8, 3);
var ab_sh26 = alloc(16);
store64(ab_sh26, 2);
store64(ab_sh26 + 8, 6);
var ab_sh34 = alloc(16);
store64(ab_sh34, 3);
store64(ab_sh34 + 8, 4);
var ab_sh4 = alloc(8);
store64(ab_sh4, 4);

var ab_t22 = tensor_new(2, ab_sh22);
var ab_t23 = tensor_new(2, ab_sh23);
var ab_t26 = tensor_new(2, ab_sh26);
var ab_t34 = tensor_new(2, ab_sh34);
var ab_t4  = tensor_new(1, ab_sh4);

assert_eq(tensor_add(0, ab_t22), 0, "tensor_add: a = 0 -> 0");
assert_eq(tensor_add(ab_t22, 0), 0, "tensor_add: b = 0 -> 0");
assert_eq(tensor_scale(0, F64_ONE), 0, "tensor_scale: t = 0 -> 0");
assert_eq(tensor_contract(0, 0, 1), 0, "tensor_contract: t = 0 -> 0");
assert_eq(tensor_add(ab_t22, ab_t23), 0, "tensor_add: 2x2 + 2x3 -> 0");
assert_eq(tensor_add(ab_t22, ab_t4), 0, "tensor_add: rank 2 + rank 1 -> 0");

# 2x6 and 3x4 both hold 12 elements. Rank equality and total equality are BOTH
# satisfied, so only a per-axis comparison rejects this.
assert_eq(tensor_add(ab_t26, ab_t34), 0, "tensor_add: 2x6 + 3x4 (equal totals) -> 0");

# ================================================================
# 4. NEGATIVE / OUT-OF-RANGE INDICES
# ================================================================
test_group("abuse: negative and out-of-range axis indices");

assert_eq(tensor_contract(ab_t22, (0 - 1), 1), 0, "tensor_contract: idx_i = -1 -> 0");
assert_eq(tensor_contract(ab_t22, 0, (0 - 1)), 0, "tensor_contract: idx_j = -1 -> 0");
assert_eq(tensor_contract(ab_t22, 0, 5), 0, "tensor_contract: idx_j = 5 (>= rank) -> 0");
assert_eq(tensor_contract(ab_t22, 2, 0), 0, "tensor_contract: idx_i = rank -> 0");
assert_eq(tensor_contract(ab_t22, 0, 0), 0, "tensor_contract: idx_i == idx_j -> 0");
assert_eq(tensor_contract(ab_t4, 0, 0), 0, "tensor_contract: rank 1 has no trace -> 0");
assert_eq(tensor_contract(ab_t23, 0, 1), 0, "tensor_contract: 2x3 extents differ -> 0");
assert_neq(tensor_contract(ab_t22, 0, 1), 0, "tensor_contract: 2x2 over (0,1) IS legal");

# THE TWO CASES ABOVE DO NOT ISOLATE THE RANGE GUARD, and this was measured, not
# assumed: deleting `idx_i < 0 || idx_i >= rank` (and its idx_j twin) from
# src/tensor.cyr leaves every assertion above green. The reason is that the
# EXTENT check one line further down -- `load64(shape + idx_j * 8) != dim` --
# happens to reject an out-of-range axis whenever the word it lands on differs
# from the contracted extent, which for the tensors above it always does.
# [measured: scratch mutant build of src/tensor.cyr, not reproducible in-tree, 2.9.0]
#
# The two cases below remove that accident by CONSTRUCTING tensors whose
# out-of-range shape word equals the extent, so only the explicit bound can
# reject them. Both are green with the guard and both go non-zero without it.

# (a) One past the end. tensor_new bumps header -> shape -> data, so the word at
# shape[rank] is data[0]; planting the extent there makes shape[2] == shape[0].
var ab_sh_probe = alloc(16);
store64(ab_sh_probe, 2);
store64(ab_sh_probe + 8, 2);
var ab_t_probe = tensor_new(2, ab_sh_probe);
store64(HTensor_shape(ab_t_probe) + 2 * 8, 2);
assert_eq(tensor_contract(ab_t_probe, 0, 2), 0,
  "tensor_contract: idx_j = rank rejected by the BOUND, not by the extent check");

# (b) One before the start. shape[-1] is the header's `total` field, so a 4x1
# tensor has total == 4 == shape[0] and the extent check cannot save it either.
var ab_sh_41 = alloc(16);
store64(ab_sh_41, 4);
store64(ab_sh_41 + 8, 1);
var ab_t41 = tensor_new(2, ab_sh_41);
assert_eq(HTensor_total(ab_t41), 4, "tensor_new: the 4x1 probe really does total 4");
assert_eq(tensor_contract(ab_t41, (0 - 1), 0), 0,
  "tensor_contract: idx_i = -1 rejected by the BOUND, not by the extent check");

# calc_partial_derivative subscripts the caller's x array with `index` and then
# WRITES x_plus[index] / x_minus[index]. A missing lower bound is two stores
# before two freshly bumped buffers, which is silent corruption, not a fault.
# 3.4.0: calc_partial_derivative_checked refuses these with HSB_ERR_INVALID_INPUT (its
# predecessor returned a 0); _ab_pd returns the error code, 0 for Ok.
var ab_x2 = alloc(2 * 8);
store64(ab_x2, F64_ONE);
store64(ab_x2 + 8, F64_TWO);
var ab_pd_out = alloc(8);
fn _ab_pd(f, x, n, index, h) {
    var t, v = calc_partial_derivative_checked(f, x, n, index, h, ab_pd_out);
    if (is_ok(t) == 1) { return 0; }
    return v;
}
assert_eq(_ab_pd(&_ab_fvec, ab_x2, 2, (0 - 1), F64_HALF), HSB_ERR_INVALID_INPUT,
  "calc_partial_derivative_checked: index = -1 -> HSB_ERR_INVALID_INPUT");
assert_eq(_ab_pd(&_ab_fvec, ab_x2, 2, 2, F64_HALF), HSB_ERR_INVALID_INPUT,
  "calc_partial_derivative_checked: index = n -> HSB_ERR_INVALID_INPUT");
assert_eq(_ab_pd(&_ab_fvec, ab_x2, 2, 99, F64_HALF), HSB_ERR_INVALID_INPUT,
  "calc_partial_derivative_checked: index = 99 -> HSB_ERR_INVALID_INPUT");
assert_eq(_ab_pd(&_ab_fvec, ab_x2, 0, 0, F64_HALF), HSB_ERR_INVALID_INPUT,
  "calc_partial_derivative_checked: n = 0 -> HSB_ERR_INVALID_INPUT");
assert_eq(_ab_pd(&_ab_fvec, ab_x2, (0 - 2), 0, F64_HALF), HSB_ERR_INVALID_INPUT,
  "calc_partial_derivative_checked: n = -2 -> HSB_ERR_INVALID_INPUT");

# gamma_spatial documents "invalid -> zero matrix", not "invalid -> null".
assert_neq(gamma_spatial((0 - 1)), 0, "gamma_spatial: idx = -1 -> zero matrix, not null");
assert_neq(gamma_spatial(7), 0, "gamma_spatial: idx = 7 -> zero matrix, not null");
assert_eq(HComplex_re(cmat_get(gamma_spatial((0 - 1)), 0, 0)), f64_from(0),
  "gamma_spatial: idx = -1 entry (0,0) is 0");
assert_neq(gell_mann((0 - 1)), 0, "gell_mann: idx = -1 -> allocated matrix, not null");
assert_neq(gell_mann(8), 0, "gell_mann: idx = 8 (one past lambda_8) -> allocated, not null");
assert_neq(gell_mann(99), 0, "gell_mann: idx = 99 -> allocated, not null");
assert_eq(su3_structure_constant((0 - 1), 2, 3), f64_from(0), "su3_structure_constant: a = -1 -> 0");
assert_eq(su3_structure_constant(99, 2, 3), f64_from(0), "su3_structure_constant: a = 99 -> 0");

# The tensor symbols are pure switch tables: out-of-range indices must return a
# well-formed f64 COMPONENT (they are consumed by f64_mul), never a raw i64.
assert_eq(levi_civita_3((0 - 1), 5, 9), f64_neg(F64_ONE), "levi_civita_3: wild indices -> -1.0 bits");
assert_eq(levi_civita_4((0 - 1), 5, 9, 12), F64_ONE, "levi_civita_4: wild indices -> +1.0 bits");
assert_eq(levi_civita_3(7, 7, 7), 0, "levi_civita_3: repeated index -> 0");
assert_eq(levi_civita_4(7, 7, 7, 7), 0, "levi_civita_4: repeated index -> 0");
assert_eq(kronecker_delta((0 - 3), (0 - 3)), F64_ONE, "kronecker_delta: -3, -3 -> 1.0 bits");
assert_eq(kronecker_delta((0 - 3), 3), 0, "kronecker_delta: -3, 3 -> 0");
assert_eq(minkowski(9, 9), f64_neg(F64_ONE), "minkowski: 9, 9 -> -1.0 bits");
assert_eq(minkowski((0 - 1), 4), 0, "minkowski: off-diagonal -> 0");

# svd_truncated's k is a rank, not an offset, but it sizes the copy loops.
var ab_A33 = ganita_mat_new(3, 3);
ganita_mat_set(ab_A33, 0, 0, F64_TWO);
ganita_mat_set(ab_A33, 1, 1, f64_from(3));
ganita_mat_set(ab_A33, 2, 2, f64_from(4));
var ab_S3 = alloc(3 * 8);
var _rq1t, _rq1v = svd_truncated(ab_A33, 0, ganita_mat_new(3, 3), ab_S3, ganita_mat_new(3, 3));
assert_eq(is_err_result(_rq1t), 1, "svd_truncated: k = 0 -> HSB_ERR_INVALID_INPUT");
assert_eq(_rq1v, HSB_ERR_INVALID_INPUT, "svd_truncated: k = 0 -> HSB_ERR_INVALID_INPUT");
var _rq2t, _rq2v = svd_truncated(ab_A33, (0 - 1), ganita_mat_new(3, 3), ab_S3, ganita_mat_new(3, 3));
assert_eq(is_err_result(_rq2t), 1, "svd_truncated: k = -1 -> HSB_ERR_INVALID_INPUT");
assert_eq(_rq2v, HSB_ERR_INVALID_INPUT, "svd_truncated: k = -1 -> HSB_ERR_INVALID_INPUT");
var _rq3t, _rq3v = svd_truncated(ab_A33, 99, ganita_mat_new(3, 3), ab_S3, ganita_mat_new(3, 3));
assert_eq(is_err_result(_rq3t), 1, "svd_truncated: k = 99 (> cols) -> HSB_ERR_INVALID_INPUT");
assert_eq(_rq3v, HSB_ERR_INVALID_INPUT, "svd_truncated: k = 99 (> cols) -> HSB_ERR_INVALID_INPUT");

# === 3.3.3 G2a: svd_truncated status, null and out-param contract ===
# ⛔ Through 3.3.2 ganita_mat_svd's status was a bare statement and nothing else
# was checked: a null A or out-param was exit 139, a wide A (ganita's -2) and a
# Jacobi failure (its -1) both came back Ok(0) with S copied out of temporaries
# the SVD never wrote, and an out_U / out_Vt smaller than the copy loops took the
# stores past its end. Every fixture below was run against the 3.3.2 tree.
# [measured: G2a probe on the 3.3.2 bundle, cycc 6.6.12, 2026-10-01]
var _g2a1t, _g2a1v = svd_truncated(0, 1, ganita_mat_new(3, 1), alloc(8), ganita_mat_new(1, 3));
assert_eq(is_err_result(_g2a1t), 1, "svd_truncated: A = 0 -> Err (was exit 139)");
assert_eq(_g2a1v, HSB_ERR_INVALID_INPUT, "svd_truncated: A = 0 -> HSB_ERR_INVALID_INPUT");
var _g2a2t, _g2a2v = svd_truncated(ab_A33, 2, 0, alloc(16), ganita_mat_new(2, 3));
assert_eq(is_err_result(_g2a2t), 1, "svd_truncated: out_U = 0 -> Err (was exit 139)");
assert_eq(_g2a2v, HSB_ERR_INVALID_INPUT, "svd_truncated: out_U = 0 -> HSB_ERR_INVALID_INPUT");
var _g2a3t, _g2a3v = svd_truncated(ab_A33, 2, ganita_mat_new(3, 2), 0, ganita_mat_new(2, 3));
assert_eq(is_err_result(_g2a3t), 1, "svd_truncated: out_S = 0 -> Err (was exit 139)");
assert_eq(_g2a3v, HSB_ERR_INVALID_INPUT, "svd_truncated: out_S = 0 -> HSB_ERR_INVALID_INPUT");
var _g2a4t, _g2a4v = svd_truncated(ab_A33, 2, ganita_mat_new(3, 2), alloc(16), 0);
assert_eq(is_err_result(_g2a4t), 1, "svd_truncated: out_Vt = 0 -> Err (was exit 139)");
assert_eq(_g2a4v, HSB_ERR_INVALID_INPUT, "svd_truncated: out_Vt = 0 -> HSB_ERR_INVALID_INPUT");

# A WIDE A. ganita's one-sided Jacobi needs m >= n and says so with -2, which
# 3.3.2 discarded: Ok(0), and S[0] overwritten with 0.
var g2a_W = ganita_mat_new(2, 3);
ganita_mat_set(g2a_W, 0, 0, F64_ONE);        ganita_mat_set(g2a_W, 0, 1, F64_TWO);
ganita_mat_set(g2a_W, 0, 2, f64_from(3));    ganita_mat_set(g2a_W, 1, 0, f64_from(4));
ganita_mat_set(g2a_W, 1, 1, f64_from(5));    ganita_mat_set(g2a_W, 1, 2, f64_from(6));
var g2a_S = alloc(3 * 8);
store64(g2a_S, _AB_SEVEN);
var _g2a5t, _g2a5v = svd_truncated(g2a_W, 1, ganita_mat_new(2, 1), g2a_S, ganita_mat_new(1, 3));
assert_eq(is_err_result(_g2a5t), 1, "svd_truncated: 2x3 (m < n) -> Err (was Ok(0))");
assert_eq(_g2a5v, HSB_ERR_INVALID_INPUT, "svd_truncated: 2x3 (m < n) -> HSB_ERR_INVALID_INPUT");
assert_eq(load64(g2a_S), _AB_SEVEN, "svd_truncated: 2x3 leaves out_S untouched (3.3.2 wrote 0)");
# svd_compute kept ganita's raw status through 3.3.7 (-2 for both of these); 3.4.0 retired it
# for svd_compute_checked, which returns the hisab code.
var _sc1t, _sc1v = svd_compute_checked(g2a_W, ganita_mat_new(2, 3), alloc(3 * 8), ganita_mat_new(3, 3));
assert_eq(_sc1v, HSB_ERR_INVALID_INPUT, "svd_compute_checked: a 2x3 A -> INVALID_INPUT (svd_compute: ganita's -2)");
var _sc2t, _sc2v = svd_compute_checked(0, ganita_mat_new(3, 3), alloc(3 * 8), ganita_mat_new(3, 3));
assert_eq(_sc2v, HSB_ERR_INVALID_INPUT, "svd_compute_checked: A = 0 -> INVALID_INPUT (svd_compute: -2)");
# ...and a null out-param. Since 3.3.7 ganita's sigmas go to svd_compute's own scratch, so
# its `out_S == 0` test is the only one between a null out_S and the final copy: without it,
# svd_compute(diag(2,3,4), U, 0, Vt) exits 139 (now svd_compute_checked, 3.4.0).
# [measured: review mutant N1 (out_S test dropped) through a probe, cyrius 6.6.20, 2026-10-31]
var _sc3t, _sc3v = svd_compute_checked(ab_A33, 0, alloc(3 * 8), ganita_mat_new(3, 3));
assert_eq(_sc3v, HSB_ERR_INVALID_INPUT, "svd_compute_checked: out_U = 0 -> INVALID_INPUT");
var _sc4t, _sc4v = svd_compute_checked(ab_A33, ganita_mat_new(3, 3), 0, ganita_mat_new(3, 3));
assert_eq(_sc4v, HSB_ERR_INVALID_INPUT, "svd_compute_checked: out_S = 0 -> INVALID_INPUT (not exit 139)");
var _sc5t, _sc5v = svd_compute_checked(ab_A33, ganita_mat_new(3, 3), alloc(3 * 8), 0);
assert_eq(_sc5v, HSB_ERR_INVALID_INPUT, "svd_compute_checked: out_Vt = 0 -> INVALID_INPUT");
# ...refused BEFORE the temporaries: full_vt is cols x cols, and 6000^2 is over
# ganita's 33,554,430-element cap, so 3.3.2 got a 0 back and read through it.
# [measured: G2a probe on the 3.3.2 bundle, cycc 6.6.12, 2026-10-01]
var g2a_wide = ganita_mat_new(1, 6000);
ganita_mat_set(g2a_wide, 0, 0, F64_ONE);
var _g2a6t, _g2a6v = svd_truncated(g2a_wide, 1, ganita_mat_new(1, 1), alloc(8), ganita_mat_new(1, 6000));
assert_eq(is_err_result(_g2a6t), 1, "svd_truncated: 1x6000 -> Err (was exit 139)");
assert_eq(_g2a6v, HSB_ERR_INVALID_INPUT, "svd_truncated: 1x6000 -> HSB_ERR_INVALID_INPUT");

# OUT-PARAMS TOO SMALL FOR THE COPY LOOPS, one dimension at a time, each with a
# guard block behind it. diag(2,3,4) with k = 2 writes 3x2 into out_U and 2x3
# into out_Vt through ganita_mat_set, which takes its stride from the out-param.
var g2a_u31 = ganita_mat_new(3, 1);
var g2a_c1 = _ab_canary_new(4);
var _g2a7t, _g2a7v = svd_truncated(ab_A33, 2, g2a_u31, alloc(16), ganita_mat_new(2, 3));
assert_eq(_g2a7v, HSB_ERR_INVALID_INPUT, "svd_truncated: out_U 3x1 for k = 2 -> HSB_ERR_INVALID_INPUT");
assert_eq(_ab_clob(g2a_c1, 4), 0, "svd_truncated: out_U 3x1 (one column short) -- guard intact");
var g2a_u22 = ganita_mat_new(2, 2);
var g2a_c2 = _ab_canary_new(4);
var _g2a8t, _g2a8v = svd_truncated(ab_A33, 2, g2a_u22, alloc(16), ganita_mat_new(2, 3));
assert_eq(_g2a8v, HSB_ERR_INVALID_INPUT, "svd_truncated: out_U 2x2 for m = 3 -> HSB_ERR_INVALID_INPUT");
assert_eq(_ab_clob(g2a_c2, 4), 0, "svd_truncated: out_U 2x2 (one row short) -- guard intact");
var g2a_v13 = ganita_mat_new(1, 3);
var g2a_c3 = _ab_canary_new(4);
var _g2a9t, _g2a9v = svd_truncated(ab_A33, 2, ganita_mat_new(3, 2), alloc(16), g2a_v13);
assert_eq(_g2a9v, HSB_ERR_INVALID_INPUT, "svd_truncated: out_Vt 1x3 for k = 2 -> HSB_ERR_INVALID_INPUT");
assert_eq(_ab_clob(g2a_c3, 4), 0, "svd_truncated: out_Vt 1x3 (one row short) -- guard intact");
var g2a_v22 = ganita_mat_new(2, 2);
var g2a_c4 = _ab_canary_new(4);
var _g2a10t, _g2a10v = svd_truncated(ab_A33, 2, ganita_mat_new(3, 2), alloc(16), g2a_v22);
assert_eq(_g2a10v, HSB_ERR_INVALID_INPUT, "svd_truncated: out_Vt 2x2 for n = 3 -> HSB_ERR_INVALID_INPUT");
assert_eq(_ab_clob(g2a_c4, 4), 0, "svd_truncated: out_Vt 2x2 (one column short) -- guard intact");
# ...and the EXACT sizes are still accepted: the guards are `<`, not `<=`.
var g2a_U = ganita_mat_new(3, 2);
var g2a_Vt = ganita_mat_new(2, 3);
var g2a_S2 = alloc(2 * 8);
var _g2a11t, _g2a11v = svd_truncated(ab_A33, 2, g2a_U, g2a_S2, g2a_Vt);
assert_eq(is_ok(_g2a11t), 1, "svd_truncated: out_U 3x2 / out_Vt 2x3 for k = 2 is exactly enough");
assert_eq(load64(g2a_S2), f64_from(4), "svd_truncated: diag(2,3,4) k = 2 -> s0 = 4");
assert_eq(load64(g2a_S2 + 8), f64_from(3), "svd_truncated: diag(2,3,4) k = 2 -> s1 = 3");
# A singular pair's sign is free, so the pins read |u| and the product u * v, each exactly
# +-1 or 1: ganita 1.2.11 (cyrius 6.6.14) gave U[2][0] = Vt[0][2] = +1 and 1.2.14 (6.6.20)
# gives -1 for both, the same factorisation.
# [measured: this block under cyrius 6.6.14 and 6.6.20, 2026-10-31]
assert_eq(f64_abs(ganita_mat_get(g2a_U, 2, 0)), F64_ONE, "svd_truncated: diag(2,3,4) |U[2][0]| = 1");
assert_eq(f64_mul(ganita_mat_get(g2a_U, 2, 0), ganita_mat_get(g2a_Vt, 0, 2)), F64_ONE,
  "svd_truncated: diag(2,3,4) U[2][0] * Vt[0][2] = 1 (sigma 4 at (2, 2))");
assert_eq(f64_abs(ganita_mat_get(g2a_Vt, 1, 1)), F64_ONE, "svd_truncated: diag(2,3,4) |Vt[1][1]| = 1");
assert_eq(f64_mul(ganita_mat_get(g2a_U, 1, 1), ganita_mat_get(g2a_Vt, 1, 1)), F64_ONE,
  "svd_truncated: diag(2,3,4) U[1][1] * Vt[1][1] = 1 (sigma 3 at (1, 1))");

# A NON-FINITE ENTRY. ganita's scale is an ordered max that drops NaN, so 3.3.2
# returned Ok(0) for these -- for an all-NaN A, with every singular value 0.
# [measured: G2a probe on the 3.3.2 bundle, cycc 6.6.12, 2026-10-01]
var g2a_nf = ganita_mat_new(3, 3);
ganita_mat_set(g2a_nf, 0, 0, F64_TWO);
ganita_mat_set(g2a_nf, 1, 1, _AB_NAN);
ganita_mat_set(g2a_nf, 2, 2, f64_from(4));
var g2a_Snf = alloc(3 * 8);
store64(g2a_Snf, _AB_SEVEN);
var _g2a12t, _g2a12v = svd_truncated(g2a_nf, 1, ganita_mat_new(3, 1), g2a_Snf, ganita_mat_new(1, 3));
assert_eq(is_err_result(_g2a12t), 1, "svd_truncated: NaN entry -> Err (was Ok(0))");
assert_eq(_g2a12v, HSB_ERR_INVALID_INPUT, "svd_truncated: NaN entry -> HSB_ERR_INVALID_INPUT");
assert_eq(load64(g2a_Snf), _AB_SEVEN, "svd_truncated: NaN entry leaves out_S untouched");
ganita_mat_set(g2a_nf, 1, 1, _AB_PINF);
var _g2a13t, _g2a13v = svd_truncated(g2a_nf, 1, ganita_mat_new(3, 1), g2a_Snf, ganita_mat_new(1, 3));
assert_eq(_g2a13v, HSB_ERR_INVALID_INPUT, "svd_truncated: +Inf entry -> HSB_ERR_INVALID_INPUT (was Ok(0))");
ganita_mat_set(g2a_nf, 1, 1, _AB_NINF);
var _g2a14t, _g2a14v = svd_truncated(g2a_nf, 1, ganita_mat_new(3, 1), g2a_Snf, ganita_mat_new(1, 3));
assert_eq(_g2a14v, HSB_ERR_INVALID_INPUT, "svd_truncated: -Inf entry -> HSB_ERR_INVALID_INPUT (was Ok(0))");
# The scan covers the whole matrix, last entry included.
ganita_mat_set(g2a_nf, 1, 1, f64_from(3));
ganita_mat_set(g2a_nf, 2, 2, _AB_NAN);
var _g2a15t, _g2a15v = svd_truncated(g2a_nf, 1, ganita_mat_new(3, 1), g2a_Snf, ganita_mat_new(1, 3));
assert_eq(_g2a15v, HSB_ERR_INVALID_INPUT, "svd_truncated: NaN in the LAST entry -> HSB_ERR_INVALID_INPUT");

# ganita's -1 at A = [[1,t],[t,t],[t,-t]]: its Jacobi parameter zeta is about
# -1/(2t), zeta^2 overflows for t <= 2^-513, the rotation degenerates to the
# identity and the sweep never ends. Of the scales t = 2^-1 .. 2^-1074, 562 fail --
# every one from 2^-513 down -- and 2^-512 is the last that decomposes.
# [measured: G2a scale scan of ganita_mat_svd on the 3.3.2 bundle, cycc 6.6.12, 2026-10-01]
# ⭐ 3.3.4 — both wrappers answer it, through the svd_golub_kahan fallback (see the
# 3.3.4 fallback group below); 3.3.3 returned -1 and Err(HSB_ERR_NO_CONVERGENCE). The
# exact sigmas are 1 and sqrt(2) t (1 + O(t^2)), correctly rounded 1 and 0x1FE6A09E667F3BCD.
# [measured: closed form of A^T A in 400-digit Decimal, 2026-10-03]
# ⭐ 3.3.7 — GANITA 1.2.12 REPAIRED THE OVERFLOW (cyrius 6.6.16 folds 1.2.13; hisab pins
# 6.6.20, ganita 1.2.14): it answers 0 with both sigmas correctly rounded, so the
# tripwire is retired and the wrappers pin ganita's answer. 3.3.6's fallback gave S1
# 1 ulp below. The fallback's own answers are pinned under a refused allocation in the
# 3.3.4 fallback group below; the filing is archived as
# docs/development/issues/archived/2026-10-03-ganita-mat-svd-no-convergence-on-tiny-columns.md
# [measured: this block under cyrius 6.6.20 against the closed form above, 2026-10-31]
var g2a_t513 = (1023 - 513) << 52;
var g2a_J = ganita_mat_new(3, 2);
ganita_mat_set(g2a_J, 0, 0, F64_ONE);   ganita_mat_set(g2a_J, 0, 1, g2a_t513);
ganita_mat_set(g2a_J, 1, 0, g2a_t513);  ganita_mat_set(g2a_J, 1, 1, g2a_t513);
ganita_mat_set(g2a_J, 2, 0, g2a_t513);  ganita_mat_set(g2a_J, 2, 1, f64_neg(g2a_t513));
assert_eq(ganita_mat_svd(g2a_J, ganita_mat_new(3, 2), alloc(16), ganita_mat_new(2, 2)), 0,
  "ganita_mat_svd: 0 at t = 2^-513 (ganita 1.2.11: -1, its zeta^2 overflow)");
var g2a_SJc = alloc(16);
var _sc6t, _sc6v = svd_compute_checked(g2a_J, ganita_mat_new(3, 2), g2a_SJc, ganita_mat_new(2, 2));
assert_eq(is_ok(_sc6t), 1, "svd_compute_checked: t = 2^-513 -> Ok (3.3.3: ganita's -1; 3.3.4-3.3.6: the fallback's)");
assert_eq(load64(g2a_SJc), F64_ONE, "svd_compute: t = 2^-513 -> S0 = 1, correctly rounded");
assert_eq(load64(g2a_SJc + 8), 0x1FE6A09E667F3BCD,
  "svd_compute: t = 2^-513 -> S1 = sqrt(2) t, correctly rounded (3.3.6's fallback: ...3BCC)");
var g2a_SJ = alloc(8);
store64(g2a_SJ, _AB_SEVEN);
var _g2a16t, _g2a16v = svd_truncated(g2a_J, 1, ganita_mat_new(3, 1), g2a_SJ, ganita_mat_new(1, 2));
assert_eq(is_ok(_g2a16t), 1, "svd_truncated: t = 2^-513 -> Ok (3.3.3: NO_CONVERGENCE)");
assert_eq(load64(g2a_SJ), F64_ONE, "svd_truncated: t = 2^-513 -> S0 = 1");
# One binade up the same matrix decomposes, through both wrappers.
var g2a_t512 = (1023 - 512) << 52;
ganita_mat_set(g2a_J, 0, 1, g2a_t512);  ganita_mat_set(g2a_J, 1, 0, g2a_t512);
ganita_mat_set(g2a_J, 1, 1, g2a_t512);  ganita_mat_set(g2a_J, 2, 0, g2a_t512);
ganita_mat_set(g2a_J, 2, 1, f64_neg(g2a_t512));
var _sc7t, _sc7v = svd_compute_checked(g2a_J, ganita_mat_new(3, 2), alloc(16), ganita_mat_new(2, 2));
assert_eq(is_ok(_sc7t), 1, "svd_compute_checked: the same matrix at t = 2^-512 decomposes");
var _g2a17t, _g2a17v = svd_truncated(g2a_J, 1, ganita_mat_new(3, 1), g2a_SJ, ganita_mat_new(1, 2));
assert_eq(is_ok(_g2a17t), 1, "svd_truncated: the same matrix at t = 2^-512 decomposes");

# === 3.3.3 W3: svd_compute refuses a non-finite A ===
# ⛔ 3.3.3 — ganita answers for a NaN or infinite entry and svd_compute passed the
# answer on as success: on 3.3.2 an all-NaN 2x2 returned 0 with S = (0, 0),
# [[3, NaN], [0, 2]] 0 with S = (3, NaN), [[-Inf, 0], [0, 2]] and [[+Inf, 0], [0, 2]]
# 0 with S = (NaN, NaN), and a 3x2 whose LAST entry is NaN 0 with S = (1, NaN). Each
# is now ganita's own -2, with out_S, out_U and out_Vt left exactly as they were.
# [measured: scratch probe on the 3.3.2 bundle, not reproducible in-tree, 2026-10-01; cycc 6.6.12]
var _w3_svd_kept = 0;
# svd_compute_checked on A (rows x cols) into out-params stamped with 7.0; returns its error
# code (0 on Ok) and sets _w3_svd_kept to 1 when every stamp survived.
fn _w3_svdc(A, rows, cols) {
    var U = ganita_mat_new(rows, cols);
    var Vt = ganita_mat_new(cols, cols);
    var S = alloc(cols * 8);
    _ab_fill7(S, cols);
    ganita_mat_set(U, 0, 0, _AB_SEVEN);
    ganita_mat_set(Vt, 0, 0, _AB_SEVEN);
    var rt, rv = svd_compute_checked(A, U, S, Vt);
    var rc = 0;
    if (is_err_result(rt) == 1) { rc = rv; }
    _w3_svd_kept = 0;
    if (_ab_count7(S, cols) == cols) {
        if (ganita_mat_get(U, 0, 0) == _AB_SEVEN && ganita_mat_get(Vt, 0, 0) == _AB_SEVEN) { _w3_svd_kept = 1; }
    }
    return rc;
}
fn _w3_m22(a, b, c, d) {
    var M = ganita_mat_new(2, 2);
    ganita_mat_set(M, 0, 0, a);  ganita_mat_set(M, 0, 1, b);
    ganita_mat_set(M, 1, 0, c);  ganita_mat_set(M, 1, 1, d);
    return M;
}
assert_eq(_w3_svdc(_w3_m22(_AB_NAN, _AB_NAN, _AB_NAN, _AB_NAN), 2, 2), HSB_ERR_INVALID_INPUT,
  "svd_compute: all-NaN 2x2 -> -2 (3.3.2: 0 with S = (0, 0))");
assert_eq(_w3_svd_kept, 1, "svd_compute: all-NaN 2x2 leaves out_S, out_U, out_Vt untouched");
assert_eq(_w3_svdc(_w3_m22(f64_from(3), _AB_NAN, 0, F64_TWO), 2, 2), HSB_ERR_INVALID_INPUT,
  "svd_compute: [[3, NaN], [0, 2]] -> -2 (3.3.2: 0 with S = (3, NaN))");
assert_eq(_w3_svd_kept, 1, "svd_compute: [[3, NaN], [0, 2]] leaves the out-params untouched");
assert_eq(_w3_svdc(_w3_m22(_AB_NINF, 0, 0, F64_TWO), 2, 2), HSB_ERR_INVALID_INPUT,
  "svd_compute: [[-Inf, 0], [0, 2]] -> -2 (3.3.2: 0 with S = (NaN, NaN))");
assert_eq(_w3_svd_kept, 1, "svd_compute: [[-Inf, 0], [0, 2]] leaves the out-params untouched");
assert_eq(_w3_svdc(_w3_m22(_AB_PINF, 0, 0, F64_TWO), 2, 2), HSB_ERR_INVALID_INPUT,
  "svd_compute: [[+Inf, 0], [0, 2]] -> -2 (3.3.2: 0 with S = (NaN, NaN))");
assert_eq(_w3_svd_kept, 1, "svd_compute: [[+Inf, 0], [0, 2]] leaves the out-params untouched");
# The scan reaches the last row AND the last column.
var _w3_T = ganita_mat_new(3, 2);
ganita_mat_set(_w3_T, 0, 0, F64_ONE);  ganita_mat_set(_w3_T, 1, 1, F64_TWO);
ganita_mat_set(_w3_T, 2, 1, _AB_NAN);
assert_eq(_w3_svdc(_w3_T, 3, 2), HSB_ERR_INVALID_INPUT,
  "svd_compute_checked: 3x2 with NaN at [2][1] -> INVALID_INPUT (3.3.2: 0, S = (1, NaN))");
assert_eq(_w3_svd_kept, 1, "svd_compute: 3x2 with NaN at [2][1] leaves the out-params untouched");
# a wide A is refused before anything is written (svd_compute: ganita's own -2).
assert_eq(_w3_svdc(g2a_W, 2, 3), HSB_ERR_INVALID_INPUT, "svd_compute_checked: finite 2x3 (wide) -> INVALID_INPUT");
assert_eq(_w3_svd_kept, 1, "svd_compute: finite 2x3 (wide) leaves the out-params untouched");
# The finite control: diag(3, 2) still decomposes, values bit-exact.
var _w3_Sc = alloc(16);
var _sc8t, _sc8v = svd_compute_checked(_w3_m22(f64_from(3), 0, 0, F64_TWO), ganita_mat_new(2, 2), _w3_Sc,
  ganita_mat_new(2, 2));
assert_eq(is_ok(_sc8t), 1, "svd_compute_checked: diag(3, 2) -> Ok (control)");
assert_eq(load64(_w3_Sc), f64_from(3), "svd_compute: diag(3, 2) -> S0 = 3");
assert_eq(load64(_w3_Sc + 8), F64_TWO, "svd_compute: diag(3, 2) -> S1 = 2");

# === 3.3.4: ganita's -1 falls back to svd_golub_kahan ===
# ⛔ Through 3.3.3 svd_compute returned -1 and svd_truncated Err(HSB_ERR_NO_CONVERGENCE)
# for ordinary rank-deficient square matrices, because ganita_mat_svd does: -1 for 2399
# of 2400 random n x n with a zero row and 2397 of 2400 with a duplicated row (n = 3..10).
# Both now answer through svd_golub_kahan (see svd_compute's comment for the oracle run).
# [measured: fallback probe, 300 rows per n and class, 2026-10-03; cycc 6.6.14]
# The closed forms: the duplicated-row witness has sigma^2 = (105 +- sqrt(10593)) / 2
# and 0; the zero-row one the two roots of its 2 x 2 row Gram matrix, and 0.
# [measured: closed forms in 60-digit Decimal against the bits below, 2026-10-03]
# ⭐ 3.3.7 — GANITA 1.2.12 ANSWERS BOTH WITNESSES ITSELF (hisab pins cyrius 6.6.20, ganita
# 1.2.14), so the tripwires are retired: the wrappers pass ganita's answer on, and the
# fallback is reached here through ganita's OTHER -1, a refused allocation. With
# ALLOC_MAX at 256 ganita's one 552-byte working block for a 3x3 is refused, while the
# fallback's largest request is 88 bytes; the fallback pins below are 3.3.4's, unchanged.
# Against the closed forms, re-derived in 120-digit Decimal:
#   duplicated row: ganita S0 ...3E7C (0.57 ulp above; correctly rounded ...7B) and S1
#     ...CE2C (correctly rounded); the fallback ...7D (1.57) and ...2F (3.14).
#   zero row: ganita S0 ...08C4 (correctly rounded) and S1 ...F104 (1.87 ulp above); the
#     fallback ...C6 (2.28) and ...F102 (correctly rounded).
# max |A - U S Vt|: ganita 0.46 and 0.55 eps S0, the fallback 2.35 and 0.82.
# [measured: ALLOC_MAX sweep 8..2048 through ganita_mat_svd and svd_golub_kahan, and this block, cyrius 6.6.20]
fn _fb_m33(a, b, c, d, e, f, g, h, k) {
    var M = ganita_mat_new(3, 3);
    ganita_mat_set(M, 0, 0, a);  ganita_mat_set(M, 0, 1, b);  ganita_mat_set(M, 0, 2, c);
    ganita_mat_set(M, 1, 0, d);  ganita_mat_set(M, 1, 1, e);  ganita_mat_set(M, 1, 2, f);
    ganita_mat_set(M, 2, 0, g);  ganita_mat_set(M, 2, 1, h);  ganita_mat_set(M, 2, 2, k);
    return M;
}
# max |A - U diag(S) Vt| over A's 3 x 3 entries using the first k triples, or +Inf
# when an entry of the difference is not finite (a NaN never compares below a bound).
fn _fb_resid(A, U, S, Vt, k) {
    var worst = 0;
    var i = 0;
    while (i < 3) {
        var j = 0;
        while (j < 3) {
            var acc = ganita_mat_get(A, i, j);
            var q = 0;
            while (q < k) {
                var us = f64_mul(ganita_mat_get(U, i, q), load64(S + q * 8));
                acc = f64_sub(acc, f64_mul(us, ganita_mat_get(Vt, q, j)));
                q = q + 1;
            }
            if (f64_lt(f64_abs(acc), _AB_PINF) == 0) { return _AB_PINF; }
            if (f64_gt(f64_abs(acc), worst) == 1) { worst = f64_abs(acc); }
            j = j + 1;
        }
        i = i + 1;
    }
    return worst;
}
# 4 eps S0: the bound for the residual pins below (the measured worst is 2.35 eps S0).
# [measured: this block's own arithmetic on the fallback's output, 2026-10-03 and 2026-10-31; cycc 6.6.20]
var _FB_4EPS = 0x3CD0000000000000;
# The ALLOC_MAX that refuses ganita's working block and admits the fallback's; ganita's
# own -1 under it is asserted first, so a ganita that needs less fails loudly, not quietly.
var _FB_CAP = 256;
var _fb_keep = ALLOC_MAX;
var _fb_dup = _fb_m33(F64_ONE, F64_TWO, f64_from(3), F64_ONE, F64_TWO, f64_from(3),
  f64_from(4), f64_from(5), f64_from(6));
assert_eq(ganita_mat_svd(_fb_dup, ganita_mat_new(3, 3), alloc(24), ganita_mat_new(3, 3)), 0,
  "ganita_mat_svd: [[1,2,3],[1,2,3],[4,5,6]] -> 0 (ganita 1.2.11: -1)");
var _fb_U = ganita_mat_new(3, 3);
var _fb_S = alloc(24);
var _fb_Vt = ganita_mat_new(3, 3);
_ab_fill7(_fb_S, 3);
var _sc9t, _sc9v = svd_compute_checked(_fb_dup, _fb_U, _fb_S, _fb_Vt);
assert_eq(is_ok(_sc9t), 1, "svd_compute_checked: [[1,2,3],[1,2,3],[4,5,6]] -> Ok (3.3.3: -1)");
assert_eq(load64(_fb_S), 0x4024646BB0023E7C,
  "svd_compute: duplicated row -> ganita's S0, 0.57 ulp above the closed form");
assert_eq(load64(_fb_S + 8), 0x3FF04ECE4EBDCE2C, "svd_compute: duplicated row -> ganita's S1, correctly rounded");
assert_eq(load64(_fb_S + 16), 0, "svd_compute: duplicated row -> S2 = +0, the exact singular value");
assert_eq(f64_lt(_fb_resid(_fb_dup, _fb_U, _fb_S, _fb_Vt, 3), f64_mul(load64(_fb_S), _FB_4EPS)), 1,
  "svd_compute: duplicated row -> max |A - U S Vt| < 4 eps S0 (Vt is V^T)");
var _fb_Ut = ganita_mat_new(3, 2);
var _fb_St = alloc(16);
var _fb_Vtt = ganita_mat_new(2, 3);
var _fb1t, _fb1v = svd_truncated(_fb_dup, 2, _fb_Ut, _fb_St, _fb_Vtt);
assert_eq(is_ok(_fb1t), 1, "svd_truncated: duplicated row, k = 2 -> Ok (3.3.3: NO_CONVERGENCE)");
assert_eq(load64(_fb_St), 0x4024646BB0023E7C, "svd_truncated: duplicated row, k = 2 -> S0 as svd_compute");
assert_eq(load64(_fb_St + 8), 0x3FF04ECE4EBDCE2C, "svd_truncated: duplicated row, k = 2 -> S1 as svd_compute");
assert_eq(f64_lt(_fb_resid(_fb_dup, _fb_Ut, _fb_St, _fb_Vtt, 2), f64_mul(load64(_fb_St), _FB_4EPS)), 1,
  "svd_truncated: duplicated row, rank 2 kept -> max |A - U S Vt| < 4 eps S0");
# The same calls with ganita's working block refused take the fallback.
ALLOC_MAX = _FB_CAP;
var _fb_grc = ganita_mat_svd(_fb_dup, ganita_mat_new(3, 3), alloc(24), ganita_mat_new(3, 3));
_ab_fill7(_fb_S, 3);
var _fb_crt, _fb_crc = svd_compute_checked(_fb_dup, _fb_U, _fb_S, _fb_Vt);
var _fb4t, _fb4v = svd_truncated(_fb_dup, 2, _fb_Ut, _fb_St, _fb_Vtt);
ALLOC_MAX = _fb_keep;
assert_eq(_fb_grc, (0 - 1), "ganita_mat_svd: ALLOC_MAX 256 refuses its 3x3 working block -> -1 (the precondition)");
assert_eq(is_ok(_fb_crt), 1, "svd_compute_checked: duplicated row, ganita's block refused -> Ok through the fallback");
assert_eq(load64(_fb_S), 0x4024646BB0023E7D, "svd_compute: duplicated row -> the fallback's S0, 1.57 ulp above");
assert_eq(load64(_fb_S + 8), 0x3FF04ECE4EBDCE2F, "svd_compute: duplicated row -> the fallback's S1, 3.14 ulp above");
assert_eq(load64(_fb_S + 16), 0, "svd_compute: duplicated row -> the fallback's S2 = +0");
assert_eq(f64_lt(_fb_resid(_fb_dup, _fb_U, _fb_S, _fb_Vt, 3), f64_mul(load64(_fb_S), _FB_4EPS)), 1,
  "svd_compute: duplicated row, the fallback -> max |A - U S Vt| < 4 eps S0");
assert_eq(is_ok(_fb4t), 1, "svd_truncated: duplicated row, ganita's block refused -> Ok through the fallback");
assert_eq(load64(_fb_St), 0x4024646BB0023E7D, "svd_truncated: duplicated row, the fallback -> S0 as svd_compute");
assert_eq(load64(_fb_St + 8), 0x3FF04ECE4EBDCE2F, "svd_truncated: duplicated row, the fallback -> S1 as svd_compute");

var _fb_zr = _fb_m33(0x3FF4CCCCCCCCCCCD, 0x400599999999999A, 0x3FD999999999999A, 0, 0, 0,
  0x3FECCCCCCCCCCCCD, 0x3FF199999999999A, 0x4002666666666666);
assert_eq(ganita_mat_svd(_fb_zr, ganita_mat_new(3, 3), alloc(24), ganita_mat_new(3, 3)), 0,
  "ganita_mat_svd: [[1.3,2.7,0.4],[0,0,0],[0.9,1.1,2.3]] -> 0 (ganita 1.2.11: -1)");
_ab_fill7(_fb_S, 3);
var _sc10t, _sc10v = svd_compute_checked(_fb_zr, _fb_U, _fb_S, _fb_Vt);
assert_eq(is_ok(_sc10t), 1, "svd_compute_checked: [[1.3,2.7,0.4],[0,0,0],[0.9,1.1,2.3]] -> Ok (3.3.3: -1)");
assert_eq(load64(_fb_S), 0x400D3FB1257408C4, "svd_compute: zero row -> ganita's S0, correctly rounded");
assert_eq(load64(_fb_S + 8), 0x3FFC17E03945F104,
  "svd_compute: zero row -> ganita's S1, 1.87 ulp above the closed form");
assert_eq(load64(_fb_S + 16), 0, "svd_compute: zero row -> S2 = +0, the exact singular value");
# ganita writes a zero U column for an exact zero singular value, the fallback a unit one.
assert_eq(ganita_mat_get(_fb_U, 1, 2), 0, "svd_compute: zero row -> ganita's U[1][2] = 0 (its zero null column)");
assert_eq(f64_lt(_fb_resid(_fb_zr, _fb_U, _fb_S, _fb_Vt, 3), f64_mul(load64(_fb_S), _FB_4EPS)), 1,
  "svd_compute: zero row -> max |A - U S Vt| < 4 eps S0");
var _fb2t, _fb2v = svd_truncated(_fb_zr, 2, _fb_Ut, _fb_St, _fb_Vtt);
assert_eq(is_ok(_fb2t), 1, "svd_truncated: zero row, k = 2 -> Ok (3.3.3: NO_CONVERGENCE)");
assert_eq(load64(_fb_St), 0x400D3FB1257408C4, "svd_truncated: zero row, k = 2 -> S0 as svd_compute");
assert_eq(load64(_fb_St + 8), 0x3FFC17E03945F104, "svd_truncated: zero row, k = 2 -> S1 as svd_compute");
assert_eq(f64_lt(_fb_resid(_fb_zr, _fb_Ut, _fb_St, _fb_Vtt, 2), f64_mul(load64(_fb_St), _FB_4EPS)), 1,
  "svd_truncated: zero row, rank 2 kept -> max |A - U S Vt| < 4 eps S0");
ALLOC_MAX = _FB_CAP;
_ab_fill7(_fb_S, 3);
var _fb_zrt, _fb_zrc = svd_compute_checked(_fb_zr, _fb_U, _fb_S, _fb_Vt);
var _fb5t, _fb5v = svd_truncated(_fb_zr, 2, _fb_Ut, _fb_St, _fb_Vtt);
ALLOC_MAX = _fb_keep;
assert_eq(is_ok(_fb_zrt), 1, "svd_compute_checked: zero row, ganita's block refused -> Ok through the fallback");
assert_eq(load64(_fb_S), 0x400D3FB1257408C6, "svd_compute: zero row -> the fallback's S0, 2.28 ulp above");
assert_eq(load64(_fb_S + 8), 0x3FFC17E03945F102, "svd_compute: zero row -> the fallback's S1, correctly rounded");
assert_eq(ganita_mat_get(_fb_U, 1, 2), F64_ONE,
  "svd_compute: zero row, the fallback -> U[1][2] = 1 (a unit null column)");
assert_eq(f64_lt(_fb_resid(_fb_zr, _fb_U, _fb_S, _fb_Vt, 3), f64_mul(load64(_fb_S), _FB_4EPS)), 1,
  "svd_compute: zero row, the fallback -> max |A - U S Vt| < 4 eps S0");
assert_eq(is_ok(_fb5t), 1, "svd_truncated: zero row, ganita's block refused -> Ok through the fallback");
assert_eq(load64(_fb_St + 8), 0x3FFC17E03945F102, "svd_truncated: zero row, the fallback -> S1 as svd_compute");

# WHEN THE FALLBACK FAILS TOO. The duplicated-row witness times 2^1021, whose largest
# singular value, 1.27 * 2^1024, is above DBL_MAX. Through ganita 1.2.11 ganita returned
# -1 and svd_golub_kahan NO_CONVERGENCE; svd_compute gave -1 and svd_truncated that Err,
# out_S untouched.
# [measured: fallback probe, 2026-10-03; cycc 6.6.14]
# ⛔ 3.3.7 — ganita 1.2.12 returns 0 with S0 = +Inf (its documented edge: a sigma_1 past
# DBL_MAX rounds to +Inf), and 3.3.6's wrappers passed that on: svd_compute 0 with
# S0 = +Inf, svd_truncated Ok with S0 = +Inf. A non-finite sigma now takes the fallback,
# whose refusal returns the 3.3.6 answers again.
# [measured: this block under cyrius 6.6.14 and 6.6.20, before and after the repair, 2026-10-31]
var _fb_big = _fb_m33(F64_ONE, F64_TWO, f64_from(3), F64_ONE, F64_TWO, f64_from(3),
  f64_from(4), f64_from(5), f64_from(6));
var _fb_bi = 0;
while (_fb_bi < 9) {
    store64(_fb_big + 16 + _fb_bi * 8, f64_mul(load64(_fb_big + 16 + _fb_bi * 8), (1023 + 1021) << 52));
    _fb_bi = _fb_bi + 1;
}
var _fb_Sg0 = alloc(24);
assert_eq(ganita_mat_svd(_fb_big, ganita_mat_new(3, 3), _fb_Sg0, ganita_mat_new(3, 3)), 0,
  "ganita_mat_svd: duplicated row * 2^1021 -> 0 (the precondition: ganita answers)");
assert_eq(load64(_fb_Sg0), _AB_PINF, "ganita_mat_svd: duplicated row * 2^1021 -> S0 = +Inf (the precondition)");
var _fb_Sb = alloc(24);
_ab_fill7(_fb_Sb, 3);
var _sc11t, _sc11v = svd_compute_checked(_fb_big, ganita_mat_new(3, 3), _fb_Sb, ganita_mat_new(3, 3));
assert_eq(_sc11v, HSB_ERR_NO_CONVERGENCE,
  "svd_compute_checked: duplicated row * 2^1021 (S0 above DBL_MAX) -> NO_CONVERGENCE (svd_compute: -1)");
assert_eq(_ab_count7(_fb_Sb, 3), 3, "svd_compute: duplicated row * 2^1021 -> out_S untouched");
var _fb_Sbt = alloc(8);
store64(_fb_Sbt, _AB_SEVEN);
var _fb3t, _fb3v = svd_truncated(_fb_big, 1, ganita_mat_new(3, 1), _fb_Sbt, ganita_mat_new(1, 3));
assert_eq(is_err_result(_fb3t), 1, "svd_truncated: duplicated row * 2^1021 -> Err (3.3.6 under 6.6.20: Ok, +Inf)");
assert_eq(_fb3v, HSB_ERR_NO_CONVERGENCE, "svd_truncated: duplicated row * 2^1021 -> the fallback's NO_CONVERGENCE");
assert_eq(load64(_fb_Sbt), _AB_SEVEN, "svd_truncated: duplicated row * 2^1021 -> out_S untouched");

# ⛔ 3.3.7 — AND A FINITE GANITA ANSWER PAST THE LINE IS REFUSED, as svd_golub_kahan refuses
# it. [[h, h], [h, h]], h = 2^1023, has sigma_1 = 2^1024, which rounds to +Inf; ganita 1.2.14
# returns 0 with S0 = DBL_MAX, and 3.3.6's wrappers passed that on (0, and Ok). Its own
# singular pair proves sigma_1 past the line, so svd_compute is -1 and svd_truncated
# NO_CONVERGENCE, out_S untouched, with no fallback. The 2x1 [a; b] below is past the line
# by 0.238 units of 2^971 (2^-55.07; a plain hypot in 100-digit Decimal), and ganita gives
# DBL_MAX for it too. h = 2^1022 (sigma_1 = 2^1023) is the control: ganita's answer,
# 0x7FDFFFFFFFFFFFFF, still passes through both wrappers bit for bit.
# [measured: wrapper fixtures under cyrius 6.6.20, 3.3.6 vs this tree, 2026-10-31]
fn _ln_sq(h) {
    var M = ganita_mat_new(2, 2);
    ganita_mat_set(M, 0, 0, h); ganita_mat_set(M, 0, 1, h);
    ganita_mat_set(M, 1, 0, h); ganita_mat_set(M, 1, 1, h);
    return M;
}
var _ln_A = _ln_sq(0x7FE0000000000000);
var _ln_Sg = alloc(16);
assert_eq(ganita_mat_svd(_ln_A, ganita_mat_new(2, 2), _ln_Sg, ganita_mat_new(2, 2)), 0,
  "ganita_mat_svd: [[h,h],[h,h]], h = 2^1023 -> 0 (the precondition: ganita answers)");
assert_eq(load64(_ln_Sg), 0x7FEFFFFFFFFFFFFF, "ganita_mat_svd: [[h,h],[h,h]] -> S0 = DBL_MAX (the precondition)");
var _ln_S = alloc(16);
_ab_fill7(_ln_S, 2);
var _sc12t, _sc12v = svd_compute_checked(_ln_A, ganita_mat_new(2, 2), _ln_S, ganita_mat_new(2, 2));
assert_eq(_sc12v, HSB_ERR_NO_CONVERGENCE,
  "svd_compute_checked: [[h,h],[h,h]], sigma_1 = 2^1024 -> NO_CONVERGENCE (svd_compute: -1; 3.3.6: 0, DBL_MAX)");
assert_eq(_ab_count7(_ln_S, 2), 2, "svd_compute: [[h,h],[h,h]] -> out_S untouched");
var _ln_St = alloc(8);
store64(_ln_St, _AB_SEVEN);
var _ln1t, _ln1v = svd_truncated(_ln_A, 1, ganita_mat_new(2, 1), _ln_St, ganita_mat_new(1, 2));
assert_eq(_ln1v, HSB_ERR_NO_CONVERGENCE, "svd_truncated: [[h,h],[h,h]] -> NO_CONVERGENCE (3.3.6: Ok, DBL_MAX)");
assert_eq(load64(_ln_St), _AB_SEVEN, "svd_truncated: [[h,h],[h,h]] -> out_S untouched");
var _ln_B = ganita_mat_new(2, 1);
ganita_mat_set(_ln_B, 0, 0, 0xFFE005514A3CA614); ganita_mat_set(_ln_B, 1, 0, 0x7FEBB368493377D4);
var _ln_Sb = alloc(8);
store64(_ln_Sb, _AB_SEVEN);
var _sc13t, _sc13v = svd_compute_checked(_ln_B, ganita_mat_new(2, 1), _ln_Sb, ganita_mat_new(1, 1));
assert_eq(_sc13v, HSB_ERR_NO_CONVERGENCE, "svd_compute_checked: 2x1 2^-55.07 past the line -> NO_CONVERGENCE");
assert_eq(load64(_ln_Sb), _AB_SEVEN, "svd_compute: 2x1 past the line -> out_S untouched");
var _ln2t, _ln2v = svd_truncated(_ln_B, 1, ganita_mat_new(2, 1), _ln_Sb, ganita_mat_new(1, 1));
assert_eq(_ln2v, HSB_ERR_NO_CONVERGENCE, "svd_truncated: 2x1 2^-55.07 past the line -> NO_CONVERGENCE");
var _ln_C = _ln_sq(0x7FD0000000000000);
var _ln_Sc = alloc(16);
var _sc14t, _sc14v = svd_compute_checked(_ln_C, ganita_mat_new(2, 2), _ln_Sc, ganita_mat_new(2, 2));
assert_eq(is_ok(_sc14t), 1, "svd_compute_checked: [[h/2,h/2],[h/2,h/2]], sigma_1 = 2^1023 (control) -> Ok");
assert_eq(load64(_ln_Sc), 0x7FDFFFFFFFFFFFFF, "svd_compute: control -> ganita's S0, 1 ulp below 2^1023");
var _ln_Sct = alloc(8);
var _ln3t, _ln3v = svd_truncated(_ln_C, 1, ganita_mat_new(2, 1), _ln_Sct, ganita_mat_new(1, 2));
assert_eq(is_ok(_ln3t), 1, "svd_truncated: control -> Ok");
assert_eq(load64(_ln_Sct), 0x7FDFFFFFFFFFFFFF, "svd_truncated: control -> ganita's S0");
# Two rows of the wrapper sweep whose verdicts need the copied certificate whole. The 3x2
# (rows 0 and 1 equal) is past the line by 2^-57.07; ganita gives DBL_MAX, and with the
# quotient's low parts dropped, the line taken as 2^1024, q not doubled, Vt read by column or
# m taken as n, a wrapper answers it. The 2x2 is inside by 2^-55.02 (oracle: DBL_MAX and
# 0x7FC12D62516773E8 correctly rounded); ganita answers 1 ulp low, and with u_i v_j or the
# denominator in plain doubles, the low part of q dropped or Vt's column read, it is refused.
# svd_golub_kahan refuses this one at its rescale, so a wrapper that sent every near-line
# value to the fallback would refuse it too.
# [measured: wrapper sweep rows 686 and 1260, certificate variants + 250-digit Decimal oracle, 2026-10-31]
var _ln_D = ganita_mat_new(3, 2);
ganita_mat_set(_ln_D, 0, 0, 0x7FDE692E10B77A04); ganita_mat_set(_ln_D, 0, 1, 0xFFDC33FC0C106E06);
ganita_mat_set(_ln_D, 1, 0, 0x7FDE692E10B77A04); ganita_mat_set(_ln_D, 1, 1, 0xFFDC33FC0C106E06);
ganita_mat_set(_ln_D, 2, 0, 0xFFD06C6B331F9171); ganita_mat_set(_ln_D, 2, 1, 0x7FD3E3C66417F0BC);
var _ln_Sd = alloc(16);
_ab_fill7(_ln_Sd, 2);
var _sc15t, _sc15v = svd_compute_checked(_ln_D, ganita_mat_new(3, 2), _ln_Sd, ganita_mat_new(2, 2));
assert_eq(_sc15v, HSB_ERR_NO_CONVERGENCE, "svd_compute_checked: 3x2 2^-57.07 past the line -> NO_CONVERGENCE");
assert_eq(_ab_count7(_ln_Sd, 2), 2, "svd_compute: 3x2 past the line -> out_S untouched");
var _ln4t, _ln4v = svd_truncated(_ln_D, 1, ganita_mat_new(3, 1), _ln_Sd, ganita_mat_new(1, 2));
assert_eq(_ln4v, HSB_ERR_NO_CONVERGENCE, "svd_truncated: 3x2 2^-57.07 past the line -> NO_CONVERGENCE");
var _ln_E = ganita_mat_new(2, 2);
ganita_mat_set(_ln_E, 0, 0, 0x7FC1785D17010D5B); ganita_mat_set(_ln_E, 0, 1, 0x7DB5EFF369AF770D);
ganita_mat_set(_ln_E, 1, 0, 0xFFC71F1D339EBA93); ganita_mat_set(_ln_E, 1, 1, 0xFFEF76A90EFF265E);
var _ln_Se = alloc(16);
var _sc16t, _sc16v = svd_compute_checked(_ln_E, ganita_mat_new(2, 2), _ln_Se, ganita_mat_new(2, 2));
assert_eq(is_ok(_sc16t), 1, "svd_compute_checked: 2x2 2^-55.02 inside the line -> Ok");
assert_eq(load64(_ln_Se), 0x7FEFFFFFFFFFFFFE, "svd_compute: 2^-55.02 inside the line -> ganita's S0, 1 ulp low");
var _ln_Set = alloc(8);
var _ln5t, _ln5v = svd_truncated(_ln_E, 1, ganita_mat_new(2, 1), _ln_Set, ganita_mat_new(1, 2));
assert_eq(is_ok(_ln5t), 1, "svd_truncated: 2x2 2^-55.02 inside the line -> Ok");
assert_eq(load64(_ln_Set), 0x7FEFFFFFFFFFFFFE, "svd_truncated: 2^-55.02 inside the line -> ganita's S0");

# === 3.3.7 linalg_precision: a refused allocation is ALLOC, not exit 139 ===
# ⛔ Through 3.3.6 `_lp_vec_new` stored through a failed allocation and none of its
# callers checked, so svd_golub_kahan and eigen_qr exited 139 whenever ALLOC_MAX sat below
# one of their requests (a 3x3 at ALLOC_MAX 16); with ganita 1.2.12's -1 meaning exactly
# that, svd_compute's fallback would have walked into it. Every cap from 8 to 1024 bytes
# now answers Ok or Err(HSB_ERR_ALLOC), out_S and out_vals untouched on the Err, and so
# does svd_compute (Ok or -1) with ganita and the fallback both refused.
# [measured: ALLOC_MAX sweep 8..2048 under cyrius 6.6.20, before and after the repair, 2026-10-31]
var _fb_sym = _fb_m33(F64_TWO, F64_ONE, 0, F64_ONE, F64_TWO, F64_ONE, 0, F64_ONE, F64_TWO);
var _fb_bad = 0;
var _fb_alloc_seen = 0;
var _fb_cap = 8;
while (_fb_cap <= 1024) {
    var cU = ganita_mat_new(3, 3);
    var cS = alloc(24);
    var cVt = ganita_mat_new(3, 3);
    var cE = alloc(24);
    var cV = ganita_mat_new(3, 3);
    var cS2 = alloc(24);
    _ab_fill7(cS, 3);
    _ab_fill7(cE, 3);
    _ab_fill7(cS2, 3);
    ALLOC_MAX = _fb_cap;
    var gt, gv = svd_golub_kahan(_fb_zr, cU, cS, cVt);
    var et, ev = eigen_qr(_fb_sym, 3, 200, cE, cV);
    var crt, crc = svd_compute_checked(_fb_zr, cU, cS2, cVt);
    ALLOC_MAX = _fb_keep;
    if (is_err_result(gt) == 1) {
        _fb_alloc_seen = _fb_alloc_seen + 1;
        if (gv != HSB_ERR_ALLOC || _ab_count7(cS, 3) != 3) { _fb_bad = _fb_bad + 1; }
    }
    if (is_err_result(et) == 1) {
        if (ev != HSB_ERR_ALLOC || _ab_count7(cE, 3) != 3) { _fb_bad = _fb_bad + 1; }
    }
    if (is_err_result(crt) == 1) {
        if (crc != HSB_ERR_ALLOC || _ab_count7(cS2, 3) != 3) { _fb_bad = _fb_bad + 1; }
    }
    _fb_cap = _fb_cap + 8;
}
assert_eq(_fb_bad, 0,
  "svd_golub_kahan / eigen_qr / svd_compute_checked: ALLOC_MAX 8..1024 -> Ok or ALLOC, outputs untouched");
assert_eq(_fb_alloc_seen, 10, "svd_golub_kahan: the 10 caps below 88 bytes are refused (the sweep reaches them)");

# WHAT GANITA ANSWERS PASSES THROUGH UNCHANGED. [[1,2,3],[4,5,6],[7,8,9]] (rank 2):
# ganita returns 0 with S2 = 6.2e-16, svd_golub_kahan would give S2 = 0 and other
# bits throughout, so a wrapper that always fell back fails these.
# [measured: fallback probe, 2026-10-03; cycc 6.6.14]
var _fb_r2 = _fb_m33(F64_ONE, F64_TWO, f64_from(3), f64_from(4), f64_from(5), f64_from(6),
  f64_from(7), f64_from(8), f64_from(9));
var _fb_Sg = alloc(24);
var _fb_Ug = ganita_mat_new(3, 3);
assert_eq(ganita_mat_svd(_fb_r2, _fb_Ug, _fb_Sg, ganita_mat_new(3, 3)), 0, "ganita_mat_svd: [[1..9]] -> 0");
var _sc17t, _sc17v = svd_compute_checked(_fb_r2, _fb_U, _fb_S, _fb_Vt);
assert_eq(is_ok(_sc17t), 1, "svd_compute_checked: [[1..9]] -> Ok");
assert_eq(load64(_fb_S), load64(_fb_Sg), "svd_compute: [[1..9]] -> S0 is ganita's, bit for bit");
assert_eq(load64(_fb_S + 16), load64(_fb_Sg + 16), "svd_compute: [[1..9]] -> S2 is ganita's 6.2e-16, bit for bit");
assert_eq(ganita_mat_get(_fb_U, 0, 0), ganita_mat_get(_fb_Ug, 0, 0), "svd_compute: [[1..9]] -> U[0][0] is ganita's");

# ode_bdf selects a coefficient row by `order`; a wild order is a table overrun.
var ab_hist = vec_new();
vec_push(ab_hist, F64_ONE);
vec_push(ab_hist, F64_ONE);
vec_push(ab_hist, F64_ONE);
# 3.4.0: ode_bdf_checked refuses each with HSB_ERR_INVALID_INPUT (ode_bdf returned 0).
var ab_bdf_out = alloc(8);
fn _ab_bdf(order) {
    var t, v = ode_bdf_checked(&_ab_dydt, 0, ab_hist, order, F64_HALF, F64_HALF, ab_bdf_out);
    if (is_ok(t) == 1) { return 0; }
    return v;
}
assert_eq(_ab_bdf(0 - 1), HSB_ERR_INVALID_INPUT, "ode_bdf_checked: order = -1 -> HSB_ERR_INVALID_INPUT");
assert_eq(_ab_bdf(0), HSB_ERR_INVALID_INPUT, "ode_bdf_checked: order = 0 -> HSB_ERR_INVALID_INPUT");
assert_eq(_ab_bdf(1), HSB_ERR_INVALID_INPUT, "ode_bdf_checked: order = 1 -> HSB_ERR_INVALID_INPUT");
assert_eq(_ab_bdf(9), HSB_ERR_INVALID_INPUT, "ode_bdf_checked: order = 9 -> HSB_ERR_INVALID_INPUT");
assert_eq(_ab_bdf(5), HSB_ERR_INVALID_INPUT,
  "ode_bdf_checked: order 5 with only 3 history entries -> HSB_ERR_INVALID_INPUT");

# ================================================================
# 5. ZERO / NEGATIVE / HUGE DIMENSIONS ON SOLVERS AND OPTIMISERS
# ================================================================
test_group("abuse: solver and optimiser dimension bounds");

var ab_x0 = alloc(2 * 8);
store64(ab_x0, F64_ONE);
store64(ab_x0 + 8, F64_ONE);
var ab_outx = alloc(8 * 8);
var ab_fmin = alloc(8);

var _rq10t, _rq10v = opt_gradient_descent(&_ab_fvec, &_ab_gvec, ab_x0, 0, F64_HALF, F64_HALF, 5,
  ab_outx, ab_fmin);
assert_eq(is_err_result(_rq10t), 1, "opt_gradient_descent: n = 0");
assert_eq(_rq10v, HSB_ERR_INVALID_INPUT, "opt_gradient_descent: n = 0");
var _rq11t, _rq11v = opt_gradient_descent(&_ab_fvec, &_ab_gvec, ab_x0, (0 - 2), F64_HALF, F64_HALF, 5,
  ab_outx, ab_fmin);
assert_eq(is_err_result(_rq11t), 1, "opt_gradient_descent: n = -2");
assert_eq(_rq11v, HSB_ERR_INVALID_INPUT, "opt_gradient_descent: n = -2");
var _rq12t, _rq12v = opt_conjugate_gradient(&_ab_fvec, &_ab_gvec, ab_x0, 0, F64_HALF, 5,
  ab_outx, ab_fmin);
assert_eq(is_err_result(_rq12t), 1, "opt_conjugate_gradient: n = 0");
assert_eq(_rq12v, HSB_ERR_INVALID_INPUT, "opt_conjugate_gradient: n = 0");
var _rq13t, _rq13v = opt_conjugate_gradient(&_ab_fvec, &_ab_gvec, ab_x0, (0 - 2), F64_HALF, 5,
  ab_outx, ab_fmin);
assert_eq(is_err_result(_rq13t), 1, "opt_conjugate_gradient: n = -2");
assert_eq(_rq13v, HSB_ERR_INVALID_INPUT, "opt_conjugate_gradient: n = -2");

# ⛔ 2.12.0 — `n * 8` WRAPS TO A SMALL POSITIVE SIZE, WHICH DEFEATS THE NULL CHECK.
# n = 2^61+1 makes the product exactly **8**, so `alloc(8)` SUCCEEDS, all five
# handles are non-zero, and `_opt_copy` walks 2^61 slots through an 8-byte buffer.
# Measured exit **139** even with 1 GiB caller buffers — the fault is the
# library's own allocation, not a short x0.
# ⚠ This is the OPPOSITE sign of the wrap already asserted for
# `opt_levenberg_marquardt` below, whose product wraps NON-POSITIVE and is
# therefore caught by `alloc`'s own `size <= 0` gate. The harness had reasoned
# about the wrap only in its negative form.
# [measured: scratch harness, not reproducible in-tree, 2026-09-09]
var _rq14t, _rq14v = opt_conjugate_gradient(&_ab_fvec, &_ab_gvec, ab_x0, 2305843009213693953, F64_HALF, 5,
  ab_outx, ab_fmin);
assert_eq(is_err_result(_rq14t), 1,
  "opt_conjugate_gradient: n = 2^61+1 wraps n*8 to 8 -- alloc succeeds, null check defeated");
assert_eq(_rq14v, HSB_ERR_INVALID_INPUT,
  "opt_conjugate_gradient: n = 2^61+1 wraps n*8 to 8 -- alloc succeeds, null check defeated");
var _rq15t, _rq15v = opt_gradient_descent(&_ab_fvec, &_ab_gvec, ab_x0, 2305843009213693953, F64_HALF, F64_HALF,
  5, ab_outx, ab_fmin);
assert_eq(is_err_result(_rq15t), 1, "opt_gradient_descent: same wrap, same guard");
assert_eq(_rq15v, HSB_ERR_INVALID_INPUT, "opt_gradient_descent: same wrap, same guard");
# ⭐ THE LOAD-BEARING CONTROL. This discriminates the round-trip guard from a
# blanket dimension cap: n = 1e9 does NOT wrap, so `alloc` rejects it and the
# EXISTING null check must still report HSB_ERR_ALLOC. A `n > _OPT_MAX_DIM` cap
# would return HSB_ERR_INVALID_INPUT here and fail this line — which is why the
# cap was measured and rejected: it also refuses a conforming caller at n = 1e7.
# [measured: scratch harness, not reproducible in-tree, 2026-09-09; cycc 6.6.2]
var _rq16t, _rq16v = opt_conjugate_gradient(&_ab_fvec, &_ab_gvec, ab_x0, 1000000000, F64_HALF, 5,
  ab_outx, ab_fmin);
assert_eq(is_err_result(_rq16t), 1, "opt_conjugate_gradient: n = 1e9 -> HSB_ERR_ALLOC (no wrap; guard must NOT fire)");
assert_eq(_rq16v, HSB_ERR_ALLOC, "opt_conjugate_gradient: n = 1e9 -> HSB_ERR_ALLOC (no wrap; guard must NOT fire)");

var _rq17t, _rq17v = opt_bfgs(&_ab_fvec, &_ab_gvec, ab_x0, 0, F64_HALF, 5, ab_outx, ab_fmin);
assert_eq(is_err_result(_rq17t), 1, "opt_bfgs: n = 0");
assert_eq(_rq17v, HSB_ERR_INVALID_INPUT, "opt_bfgs: n = 0");
var _rq18t, _rq18v = opt_bfgs(&_ab_fvec, &_ab_gvec, ab_x0, (0 - 2), F64_HALF, 5, ab_outx, ab_fmin);
assert_eq(is_err_result(_rq18t), 1, "opt_bfgs: n = -2");
assert_eq(_rq18v, HSB_ERR_INVALID_INPUT, "opt_bfgs: n = -2");

# The inverse Hessian is n*n. _OPT_MAX_DIM = 4096 is the cap that keeps
# 8*n*n under ALLOC_MAX; above it the request is rejected, not attempted.
var _rq19t, _rq19v = opt_bfgs(&_ab_fvec, &_ab_gvec, ab_x0, 100000, F64_HALF, 5, ab_outx, ab_fmin);
assert_eq(is_err_result(_rq19t), 1, "opt_bfgs: n = 1e5 (over _OPT_MAX_DIM) rejected before alloc");
assert_eq(_rq19v, HSB_ERR_INVALID_INPUT, "opt_bfgs: n = 1e5 (over _OPT_MAX_DIM) rejected before alloc");
var _rq20t, _rq20v = opt_lbfgs(&_ab_fvec, &_ab_gvec, ab_x0, 2, 0, F64_HALF, 5, ab_outx, ab_fmin);
assert_eq(is_err_result(_rq20t), 1, "opt_lbfgs: m = 0");
assert_eq(_rq20v, HSB_ERR_INVALID_INPUT, "opt_lbfgs: m = 0");
var _rq21t, _rq21v = opt_lbfgs(&_ab_fvec, &_ab_gvec, ab_x0, 2, (0 - 3), F64_HALF, 5, ab_outx, ab_fmin);
assert_eq(is_err_result(_rq21t), 1, "opt_lbfgs: m = -3");
assert_eq(_rq21v, HSB_ERR_INVALID_INPUT, "opt_lbfgs: m = -3");
var _rq22t, _rq22v = opt_lbfgs(&_ab_fvec, &_ab_gvec, ab_x0, 100000, 3, F64_HALF, 5, ab_outx, ab_fmin);
assert_eq(is_err_result(_rq22t), 1, "opt_lbfgs: n over _OPT_MAX_DIM");
assert_eq(_rq22v, HSB_ERR_INVALID_INPUT, "opt_lbfgs: n over _OPT_MAX_DIM");
var _rq23t, _rq23v = opt_lbfgs(&_ab_fvec, &_ab_gvec, ab_x0, 2, 100000, F64_HALF, 5, ab_outx, ab_fmin);
assert_eq(is_err_result(_rq23t), 1, "opt_lbfgs: m over _OPT_MAX_DIM");
assert_eq(_rq23v, HSB_ERR_INVALID_INPUT, "opt_lbfgs: m over _OPT_MAX_DIM");
var _rq24t, _rq24v = opt_levenberg_marquardt(&_ab_residuals, &_ab_jacobian, ab_x0, 0, 1, F64_HALF, 5,
  ab_outx);
assert_eq(is_err_result(_rq24t), 1, "opt_levenberg_marquardt: n_params = 0");
assert_eq(_rq24v, HSB_ERR_INVALID_INPUT, "opt_levenberg_marquardt: n_params = 0");
var _rq25t, _rq25v = opt_levenberg_marquardt(&_ab_residuals, &_ab_jacobian, ab_x0, (0 - 1), 1, F64_HALF, 5,
  ab_outx);
assert_eq(is_err_result(_rq25t), 1, "opt_levenberg_marquardt: n_params = -1");
assert_eq(_rq25v, HSB_ERR_INVALID_INPUT, "opt_levenberg_marquardt: n_params = -1");
var _rq26t, _rq26v = opt_levenberg_marquardt(&_ab_residuals, &_ab_jacobian, ab_x0, 1, 0, F64_HALF, 5,
  ab_outx);
assert_eq(is_err_result(_rq26t), 1, "opt_levenberg_marquardt: n_residuals = 0");
assert_eq(_rq26v, HSB_ERR_INVALID_INPUT, "opt_levenberg_marquardt: n_residuals = 0");
var _rq27t, _rq27v = opt_levenberg_marquardt(&_ab_residuals, &_ab_jacobian, ab_x0, 1, (0 - 1), F64_HALF, 5,
  ab_outx);
assert_eq(is_err_result(_rq27t), 1, "opt_levenberg_marquardt: n_residuals = -1");
assert_eq(_rq27v, HSB_ERR_INVALID_INPUT, "opt_levenberg_marquardt: n_residuals = -1");
# ⛔ 3.3.1 — the opt_conjugate_gradient wrap, missed in LM. n_params = 2 with
# n_residuals = 2^60+1 makes `nr * np * 8` exactly 16, `alloc` honours it, and
# the solver ran as if j_buf held nr*np f64s: exit 139.
# [measured: scratch harness, not reproducible in-tree, 2026-09-30; cycc 6.6.12]
var _rq99t, _rq99v = opt_levenberg_marquardt(&_ab_residuals, &_ab_jacobian, ab_x0, 2, 1152921504606846977,
  F64_HALF, 5, ab_outx);
assert_eq(is_err_result(_rq99t), 1, "opt_levenberg_marquardt: nr*np*8 wraps to 16 -> Err, not a SIGSEGV");
assert_eq(_rq99v, HSB_ERR_ALLOC, "opt_levenberg_marquardt: nr*np*8 wraps to 16 -> HSB_ERR_ALLOC");
# The control: 1e9 residuals do not wrap, so the round-trip lets them through and
# the null check reports the failed allocation. (The 2^30 x 2^30 case below wraps
# NON-positive and reports the same HSB_ERR_ALLOC.)
var _rq100t, _rq100v = opt_levenberg_marquardt(&_ab_residuals, &_ab_jacobian, ab_x0, 1, 1000000000,
  F64_HALF, 5, ab_outx);
assert_eq(_rq100v, HSB_ERR_ALLOC, "opt_levenberg_marquardt: 1e9 residuals do not wrap -> HSB_ERR_ALLOC");

# gradient_descent has no _OPT_MAX_DIM cap; it must instead REPORT the failed
# allocation rather than store through alloc's designed 0.
var _rq28t, _rq28v = opt_gradient_descent(&_ab_fvec, &_ab_gvec, ab_x0, 1000000000, F64_HALF, F64_HALF, 5,
  ab_outx, ab_fmin);
assert_eq(is_err_result(_rq28t), 1, "opt_gradient_descent: n = 1e9 -> HSB_ERR_ALLOC");
assert_eq(_rq28v, HSB_ERR_ALLOC, "opt_gradient_descent: n = 1e9 -> HSB_ERR_ALLOC");

# nr * np * 8 = 2^63 for these dims -- the multiply wraps to a non-positive
# size. Through 3.3.0 alloc returned 0 and the null check caught it; since 3.3.1
# the round-trip guard catches it first, with the same code.
var _rq29t, _rq29v = opt_levenberg_marquardt(&_ab_residuals, &_ab_jacobian, ab_x0, 1073741824, 1073741824,
  F64_HALF, 5, ab_outx);
assert_eq(is_err_result(_rq29t), 1, "opt_levenberg_marquardt: 2^30 x 2^30 Jacobian -> HSB_ERR_ALLOC");
assert_eq(_rq29v, HSB_ERR_ALLOC, "opt_levenberg_marquardt: 2^30 x 2^30 Jacobian -> HSB_ERR_ALLOC");

# A non-positive iteration budget must not be read as "unbounded".
var _rq30t, _rq30v = opt_gradient_descent(&_ab_fvec, &_ab_gvec, ab_x0, 2, F64_HALF, F64_HALF, (0 - 5),
  ab_outx, ab_fmin);
assert_eq(is_err_result(_rq30t), 1, "opt_gradient_descent: max_iter = -5 -> no-convergence, not a hang");
assert_eq(_rq30v, HSB_ERR_NO_CONVERGENCE, "opt_gradient_descent: max_iter = -5 -> no-convergence, not a hang");

test_group("3.3.5 abuse: opt_lbfgs with n <= 0");
var _g639_t, _g639_v = opt_lbfgs(0, 0, 0, 0, 5, F64_HALF, 10, 0, 0);
assert_eq(is_ok(_g639_t), 0, "opt_lbfgs: n = 0 is refused");
assert_eq(_g639_v, HSB_ERR_INVALID_INPUT, "opt_lbfgs: n = 0 -> INVALID_INPUT, not ALLOC");
var _g639_t2, _g639_v2 = opt_lbfgs(0, 0, 0, 0 - 2, 5, F64_HALF, 10, 0, 0);
assert_eq(is_ok(_g639_t2), 0, "opt_lbfgs: n = -2 is refused");
assert_eq(_g639_v2, HSB_ERR_INVALID_INPUT, "opt_lbfgs: n = -2 -> INVALID_INPUT, not ALLOC");

test_group("abuse: svd_golub_kahan / eigen_qr shape + null contract");

# svd_golub_kahan is the one routine in linalg_precision.cyr that validates its
# whole surface (2.8.3). These assertions pin that contract so it cannot regress.
# ⚠ Its out-params' shapes only since 3.4.0: through 3.3.7 an undersized out_U or out_Vt was
# written past before the Err came back (D102 audit, AU2-G3-F1; tests/modules_b.tcyr pins it).
var ab_A34 = ganita_mat_new(3, 4);
var ab_U34 = ganita_mat_new(3, 4);
var ab_Vt44 = ganita_mat_new(4, 4);
var _rq31t, _rq31v = svd_golub_kahan(ab_A34, ab_U34, alloc(32), ab_Vt44);
assert_eq(is_err_result(_rq31t), 1, "svd_golub_kahan: 3x4 (m < n) rejected");
assert_eq(_rq31v, HSB_ERR_INVALID_INPUT, "svd_golub_kahan: 3x4 (m < n) rejected");
var _rq32t, _rq32v = svd_golub_kahan(0, ab_U34, ab_S3, ab_Vt44);
assert_eq(is_err_result(_rq32t), 1, "svd_golub_kahan: A = 0 rejected");
assert_eq(_rq32v, HSB_ERR_INVALID_INPUT, "svd_golub_kahan: A = 0 rejected");
var _rq33t, _rq33v = svd_golub_kahan(ab_A33, 0, ab_S3, ab_Vt44);
assert_eq(is_err_result(_rq33t), 1, "svd_golub_kahan: out_U = 0 rejected");
assert_eq(_rq33v, HSB_ERR_INVALID_INPUT, "svd_golub_kahan: out_U = 0 rejected");
var _rq34t, _rq34v = svd_golub_kahan(ab_A33, ab_U34, 0, ab_Vt44);
assert_eq(is_err_result(_rq34t), 1, "svd_golub_kahan: out_S = 0 rejected");
assert_eq(_rq34v, HSB_ERR_INVALID_INPUT, "svd_golub_kahan: out_S = 0 rejected");
var _rq35t, _rq35v = svd_golub_kahan(ab_A33, ab_U34, ab_S3, 0);
assert_eq(is_err_result(_rq35t), 1, "svd_golub_kahan: out_Vt = 0 rejected");
assert_eq(_rq35v, HSB_ERR_INVALID_INPUT, "svd_golub_kahan: out_Vt = 0 rejected");

# ⛔ 2.22.0 — A NON-FINITE ENTRY RETURNED SUCCESS WITH A NaN PAYLOAD, FROM BOTH
# ENTRY POINTS. Measured on the 2.21.0 tree: svd_golub_kahan([[+Inf,0],[0,1]])
# returned HSB_ERR_NONE with BOTH singular values NaN, and eigen_qr on the same
# matrix returned HSB_ERR_NONE with both eigenvalues NaN. -Inf and NaN do the
# same. A caller checking the return code was told the decomposition worked.
# ⭐ The guard is a single "is not finite" test, because every f64 comparison
# involving NaN returns 0 — so `f64_lt(|x|, +Inf) == 0` catches Inf AND NaN, and
# splitting it into two tests is what invites someone to drop the NaN arm.
# ⚠ All three signs are asserted, not just +Inf: the first draft of the repair
# was measured on +Inf alone, and a guard written as `x == +Inf` would have
# passed that and let -Inf and NaN straight through.
# [measured: +Inf / -Inf / NaN probes through both entry points, 2026-09-11]
var ab_inf_A = ganita_mat_new(2, 2);
ganita_mat_set(ab_inf_A, 0, 1, 0);
ganita_mat_set(ab_inf_A, 1, 0, 0);
ganita_mat_set(ab_inf_A, 1, 1, F64_ONE);
var ab_inf_U = ganita_mat_new(2, 2);
var ab_inf_Vt = ganita_mat_new(2, 2);
var ab_inf_S = alloc(16);
var ab_inf_vecs = ganita_mat_new(2, 2);

ganita_mat_set(ab_inf_A, 0, 0, F64_POS_INF);
var _rq36t, _rq36v = svd_golub_kahan(ab_inf_A, ab_inf_U, ab_inf_S, ab_inf_Vt);
assert_eq(is_err_result(_rq36t), 1,
  "svd_golub_kahan: +Inf entry rejected (returned NONE with NaN values through 2.21.0)");
assert_eq(_rq36v, HSB_ERR_INVALID_INPUT,
  "svd_golub_kahan: +Inf entry rejected (returned NONE with NaN values through 2.21.0)");
var _rq37t, _rq37v = eigen_qr(ab_inf_A, 2, 500, ab_inf_S, ab_inf_vecs);
assert_eq(is_err_result(_rq37t), 1, "eigen_qr: +Inf entry rejected (returned NONE with NaN values through 2.21.0)");
assert_eq(_rq37v, HSB_ERR_INVALID_INPUT,
  "eigen_qr: +Inf entry rejected (returned NONE with NaN values through 2.21.0)");

ganita_mat_set(ab_inf_A, 0, 0, f64_neg(F64_POS_INF));
var _rq38t, _rq38v = svd_golub_kahan(ab_inf_A, ab_inf_U, ab_inf_S, ab_inf_Vt);
assert_eq(is_err_result(_rq38t), 1, "svd_golub_kahan: -Inf entry rejected");
assert_eq(_rq38v, HSB_ERR_INVALID_INPUT, "svd_golub_kahan: -Inf entry rejected");
var _rq39t, _rq39v = eigen_qr(ab_inf_A, 2, 500, ab_inf_S, ab_inf_vecs);
assert_eq(is_err_result(_rq39t), 1, "eigen_qr: -Inf entry rejected");
assert_eq(_rq39v, HSB_ERR_INVALID_INPUT, "eigen_qr: -Inf entry rejected");

ganita_mat_set(ab_inf_A, 0, 0, f64_div(f64_from(0), f64_from(0)));
var _rq40t, _rq40v = svd_golub_kahan(ab_inf_A, ab_inf_U, ab_inf_S, ab_inf_Vt);
assert_eq(is_err_result(_rq40t), 1, "svd_golub_kahan: NaN entry rejected");
assert_eq(_rq40v, HSB_ERR_INVALID_INPUT, "svd_golub_kahan: NaN entry rejected");
var _rq41t, _rq41v = eigen_qr(ab_inf_A, 2, 500, ab_inf_S, ab_inf_vecs);
assert_eq(is_err_result(_rq41t), 1, "eigen_qr: NaN entry rejected");
assert_eq(_rq41v, HSB_ERR_INVALID_INPUT, "eigen_qr: NaN entry rejected");

# ⚠ THE CONTROL. Without it these six could all pass on a routine that rejects
# every matrix, which is the shape a too-eager guard actually takes.
ganita_mat_set(ab_inf_A, 0, 0, f64_from(3));
var _rq42t, _rq42v = svd_golub_kahan(ab_inf_A, ab_inf_U, ab_inf_S, ab_inf_Vt);
assert_eq(is_ok(_rq42t), 1, "svd_golub_kahan: an ordinary finite matrix is still accepted (control)");
var _rq43t, _rq43v = eigen_qr(ab_inf_A, 2, 500, ab_inf_S, ab_inf_vecs);
assert_eq(is_ok(_rq43t), 1, "eigen_qr: an ordinary finite matrix is still accepted (control)");
var _rq44t, _rq44v = svd_golub_kahan(mat_new_guarded(1000000, 1000000), ab_U34, ab_S3, ab_Vt44);
assert_eq(is_err_result(_rq44t), 1, "svd_golub_kahan: capped mat_new_guarded 0 flows through");
assert_eq(_rq44v, HSB_ERR_INVALID_INPUT, "svd_golub_kahan: capped mat_new_guarded 0 flows through");

# === 3.3.3 W3: two finite matrices balanced to the overflow line ===
# An earlier 3.3.3 note used these two fixtures to argue that the NaN-true reflector
# gates keep an overflow loud: on 3.3.2 (whose balance lifts h = 1.5 * 2^1000 to
# 1.5 * 2^1023) both return NO_CONVERGENCE through a NaN reflector, and spelled
# NaN-false each gate returned Ok with a made-up answer. The argument did not
# generalise -- the R4lp block below holds six finite inputs that 3.3.2 answered
# rc = OK with NaN or invented values. In 3.3.3 a column or reflector norm that is
# not finite returned NO_CONVERGENCE before any gate read it, so both were refused.
# ⭐ 3.3.4 — BOTH ARE ANSWERED: the failed attempt is retried with one binade more
# headroom (`_lp_headroom_next`), and the second attempt fits. True values, from
# Decimal oracles (1400 digits for svd, 800 for eigen): S = (sqrt(2) h, u / sqrt(2)),
# which round to 0x7E80F876CCDF6CD9 and u; eigenvalues +-sqrt(2) h + u / 2, which round
# to +-0x7E80F876CCDF6CD9, and exactly 0. The svd's sigma_1 comes back 1 ulp high and
# the eigen pair correctly rounded; without u both matrices are answered on the first
# attempt, sigma_1 correctly rounded and the eigen pair 1 ulp high.
# [measured: scratch probes on 3.3.4 base and this tree + Decimal oracles, 2026-10-03; cycc 6.6.14]
var _w3_hh = 0x7E78000000000000;   # 1.5 * 2^1000
var _w3_hA = ganita_mat_new(2, 2);
ganita_mat_set(_w3_hA, 0, 0, _w3_hh);
ganita_mat_set(_w3_hA, 0, 1, 0);
ganita_mat_set(_w3_hA, 1, 0, _w3_hh);
ganita_mat_set(_w3_hA, 1, 1, 1);    # 2^-1074
var _w3_hS = alloc(16);
store64(_w3_hS, 0x7777);
store64(_w3_hS + 8, 0x7777);
var _w3_h1t, _w3_h1v = svd_golub_kahan(_w3_hA, ganita_mat_new(2, 2), _w3_hS, ganita_mat_new(2, 2));
assert_eq(is_ok(_w3_h1t), 1, "svd_golub_kahan [[h,0],[h,2^-1074]]: answered (3.3.2 and 3.3.3: NO_CONVERGENCE)");
assert_eq(load64(_w3_hS), 0x7E80F876CCDF6CDA, "svd_golub_kahan [[h,0],[h,2^-1074]]: sigma_1 = sqrt(2) h, 1 ulp high");
assert_eq(load64(_w3_hS + 8), 1, "svd_golub_kahan [[h,0],[h,2^-1074]]: sigma_2 = u / sqrt(2), rounded to u");
var _w3_hE = ganita_mat_new(3, 3);
for (var _w3_k = 0; _w3_k < 9; _w3_k = _w3_k + 1) { ganita_mat_set(_w3_hE, _w3_k / 3, _w3_k % 3, 0); }
ganita_mat_set(_w3_hE, 0, 0, 1);    # 2^-1074
ganita_mat_set(_w3_hE, 0, 1, _w3_hh);  ganita_mat_set(_w3_hE, 0, 2, _w3_hh);
ganita_mat_set(_w3_hE, 1, 0, _w3_hh);  ganita_mat_set(_w3_hE, 2, 0, _w3_hh);
var _w3_hev = alloc(24);
store64(_w3_hev, 0x7777);
var _w3_h2t, _w3_h2v = eigen_qr(_w3_hE, 3, 200, _w3_hev, ganita_mat_new(3, 3));
assert_eq(is_ok(_w3_h2t), 1, "eigen_qr [[2^-1074,h,h],[h,0,0],[h,0,0]]: answered (3.3.2 and 3.3.3: NO_CONVERGENCE)");
assert_eq(load64(_w3_hev), 0x7E80F876CCDF6CD9, "eigen_qr [[2^-1074,h,h],[h,0,0],[h,0,0]]: lambda_0, correctly rounded");
assert_eq(load64(_w3_hev + 8), 0xFE80F876CCDF6CD9,
  "eigen_qr [[2^-1074,h,h],[h,0,0],[h,0,0]]: lambda_1, correctly rounded");
assert_eq(load64(_w3_hev + 16), 0,
  "eigen_qr [[2^-1074,h,h],[h,0,0],[h,0,0]]: lambda_2 = +0 (the rank-2 matrix's exact 0)");

# === 3.3.3 R4lp: wide-span svd_golub_kahan / eigen_qr ===
# (1) THE REPROS. The svd / eigen balance (2.22.1's exit, growth 1, kept: see
# `_lp_balance_scale`) puts the largest entry anywhere in [2^1023, 2^1024), and on
# 3.3.2 these finite inputs returned rc = OK with NaN or invented values
# (h = 1.5 * 2^1000, u = 2^-1074): svd [h; h; u] -> NaN, [0; h; u] -> 0,
# [[0, u], [h, 0]] -> (u, 0), [[u, 0], [0, -h], [0, 0]] -> (u, NaN); eigen_qr
# [[u, h], [h, 0]] -> (0, 0), [[0, 0, h], [0, u, 0], [h, 0, 0]] -> (u, 0, 0). Their
# true values are sqrt(2) h; h; (h, u); (h, u); +-h; and +-h, u. In 3.3.3 each
# returned NO_CONVERGENCE with the out array untouched: the overflow is caught where
# it happens rather than answered through. (An earlier round of 3.3.3 answered them
# with balance headroom and lifted rotations; both were withdrawn because they moved
# results 3.3.2 got right -- see `_lp_balance_scale`.) With the reflector-norm check
# removed [0; h; u] and [[0, u], [h, 0]] came back rc = OK with 3.3.2's values, with
# the tridiagonal one removed [[0, 0, h], ...] did, and with the tridiagonal-QR
# radius check removed [[u, h], [h, 0]] did.
# [measured: scratch probes on 3.3.2, this tree and check-removed builds, not reproducible in-tree, 2026-10-01]
# ⭐ 3.3.4 — EACH IS ANSWERED, on the second attempt: the first is 3.3.3's and fails
# at the same check, and `_lp_headroom_next` gives the retry one binade of headroom.
# Against Decimal oracles (1400 / 800 digits) every value is correctly rounded except
# [h; h; u]'s sigma (1 ulp high) and the two eigen pairs (2 ulp low in magnitude).
# With u removed the same matrices are answered on the first attempt: [h; h]'s sigma
# correctly rounded, the eigen pairs 2 ulp high.
# [measured: scratch probes on 3.3.4 base and this tree + Decimal oracles, 2026-10-03; cycc 6.6.14]
var _r4lp_h = 0x7E78000000000000;    # 1.5 * 2^1000
fn _r4lp_m(r, c) {
    var A = ganita_mat_new(r, c);
    for (var i = 0; i < r * c; i = i + 1) { ganita_mat_set(A, i / c, i % c, 0); }
    return A;
}
# rc of svd_golub_kahan(A) into U, S, Vt (HSB_ERR_NONE on success)
fn _r4lp_svd(A, U, S, Vt) {
    var rt, rv = svd_golub_kahan(A, U, S, Vt);
    if (rt != 0) { return rv; }
    return HSB_ERR_NONE;
}
fn _r4lp_eig(A, n, E, V) {
    var rt, rv = eigen_qr(A, n, 30 * n * n + 100, E, V);
    if (rt != 0) { return rv; }
    return HSB_ERR_NONE;
}
# The out arrays are refilled with the 0x7777 sentinel before every call, so each
# "left untouched" assert reads only its own call (a refusal writes nothing).
fn _r4lp_reset(p, k) {
    for (var i = 0; i < k; i = i + 1) { store64(p + i * 8, 0x7777); }
    return 0;
}
# 1 when the first k words at p still hold the 0x7777 sentinel
fn _r4lp_kept(p, k) {
    for (var i = 0; i < k; i = i + 1) {
        if (load64(p + i * 8) != 0x7777) { return 0; }
    }
    return 1;
}
var _r4lp_S = alloc(8 * 8);
var _r4lp_A = _r4lp_m(3, 1);
ganita_mat_set(_r4lp_A, 0, 0, _r4lp_h); ganita_mat_set(_r4lp_A, 1, 0, _r4lp_h); ganita_mat_set(_r4lp_A, 2, 0, 1);
_r4lp_reset(_r4lp_S, 8);
assert_eq(_r4lp_svd(_r4lp_A, _r4lp_m(3, 1), _r4lp_S, _r4lp_m(1, 1)), HSB_ERR_NONE,
  "svd [h; h; u]: answered (3.3.2: rc = OK, S = NaN; 3.3.3: NO_CONVERGENCE)");
assert_eq(load64(_r4lp_S), 0x7E80F876CCDF6CDA, "svd [h; h; u]: sigma = sqrt(2) h, 1 ulp high");
_r4lp_A = _r4lp_m(3, 1);
ganita_mat_set(_r4lp_A, 1, 0, _r4lp_h); ganita_mat_set(_r4lp_A, 2, 0, 1);
_r4lp_reset(_r4lp_S, 8);
assert_eq(_r4lp_svd(_r4lp_A, _r4lp_m(3, 1), _r4lp_S, _r4lp_m(1, 1)), HSB_ERR_NONE,
  "svd [0; h; u]: answered (3.3.2: rc = OK, S = 0; 3.3.3: NO_CONVERGENCE)");
assert_eq(load64(_r4lp_S), _r4lp_h, "svd [0; h; u]: sigma = hypot(h, u), correctly rounded to h");
_r4lp_A = _r4lp_m(2, 2);
ganita_mat_set(_r4lp_A, 0, 1, 1); ganita_mat_set(_r4lp_A, 1, 0, _r4lp_h);
_r4lp_reset(_r4lp_S, 8);
assert_eq(_r4lp_svd(_r4lp_A, _r4lp_m(2, 2), _r4lp_S, _r4lp_m(2, 2)), HSB_ERR_NONE,
  "svd [[0,u],[h,0]]: answered (3.3.2: rc = OK, S = (u, 0); 3.3.3: NO_CONVERGENCE)");
assert_eq(load64(_r4lp_S), _r4lp_h, "svd [[0,u],[h,0]]: sigma_1 = h exactly");
assert_eq(load64(_r4lp_S + 8), 1, "svd [[0,u],[h,0]]: sigma_2 = u exactly");
_r4lp_A = _r4lp_m(3, 2);
ganita_mat_set(_r4lp_A, 0, 0, 1); ganita_mat_set(_r4lp_A, 1, 1, f64_neg(_r4lp_h));
_r4lp_reset(_r4lp_S, 8);
assert_eq(_r4lp_svd(_r4lp_A, _r4lp_m(3, 2), _r4lp_S, _r4lp_m(2, 2)), HSB_ERR_NONE,
  "svd [[u,0],[0,-h],[0,0]]: answered (3.3.2: rc = OK, S = (u, NaN); 3.3.3: NO_CONVERGENCE)");
assert_eq(load64(_r4lp_S), _r4lp_h, "svd [[u,0],[0,-h],[0,0]]: sigma_1 = h exactly");
assert_eq(load64(_r4lp_S + 8), 1, "svd [[u,0],[0,-h],[0,0]]: sigma_2 = u exactly");
_r4lp_A = _r4lp_m(2, 2);
ganita_mat_set(_r4lp_A, 0, 0, 1); ganita_mat_set(_r4lp_A, 0, 1, _r4lp_h); ganita_mat_set(_r4lp_A, 1, 0, _r4lp_h);
_r4lp_reset(_r4lp_S, 8);
assert_eq(_r4lp_eig(_r4lp_A, 2, _r4lp_S, _r4lp_m(2, 2)), HSB_ERR_NONE,
  "eigen_qr [[u,h],[h,0]]: answered (3.3.2: rc = OK, (0, 0); 3.3.3: NO_CONVERGENCE)");
assert_eq(load64(_r4lp_S), 0x7E77FFFFFFFFFFFE, "eigen_qr [[u,h],[h,0]]: lambda_0 = h + u / 2, 2 ulp low");
assert_eq(load64(_r4lp_S + 8), 0xFE77FFFFFFFFFFFE,
  "eigen_qr [[u,h],[h,0]]: lambda_1 = -h + u / 2, 2 ulp low in magnitude");
_r4lp_A = _r4lp_m(3, 3);
ganita_mat_set(_r4lp_A, 0, 2, _r4lp_h); ganita_mat_set(_r4lp_A, 1, 1, 1); ganita_mat_set(_r4lp_A, 2, 0, _r4lp_h);
_r4lp_reset(_r4lp_S, 8);
assert_eq(_r4lp_eig(_r4lp_A, 3, _r4lp_S, _r4lp_m(3, 3)), HSB_ERR_NONE,
  "eigen_qr [[0,0,h],[0,u,0],[h,0,0]]: answered (3.3.2: rc = OK, (u, 0, 0); 3.3.3: NO_CONVERGENCE)");
assert_eq(load64(_r4lp_S), 0x7E77FFFFFFFFFFFE, "eigen_qr [[0,0,h],[0,u,0],[h,0,0]]: lambda_0 = h, 2 ulp low");
assert_eq(load64(_r4lp_S + 8), 0xFE77FFFFFFFFFFFE, "eigen_qr [[0,0,h],[0,u,0],[h,0,0]]: lambda_1 = -h, 2 ulp low");
assert_eq(load64(_r4lp_S + 16), 1, "eigen_qr [[0,0,h],[0,u,0],[h,0,0]]: lambda_2 = u exactly");

# (2) A VALUE ABOVE DBL_MAX IS A FAILURE. With g = 1.48 * 2^1023, [g; g] has
# sigma = sqrt(2) g and [[g, g], [g, g]] has eigenvalues 2 g and 0, both above
# DBL_MAX; 3.3.2 returned rc = OK with +Inf for each. They return NO_CONVERGENCE
# now with the out-array untouched; the controls at g' = 1.2 * 2^1022 are finite
# (sqrt(2) g' correctly rounded; 2 g' less 1 ulp).
# [measured: scratch probes on 3.3.2 and this tree, not reproducible in-tree, 2026-10-01]
var _r4lp_g = 0x7FE7AE147AE147AE;
var _r4lp_g2 = 0x7FD3333333333333;
store64(_r4lp_S, 0x7777);
_r4lp_A = _r4lp_m(2, 1);
ganita_mat_set(_r4lp_A, 0, 0, _r4lp_g); ganita_mat_set(_r4lp_A, 1, 0, _r4lp_g);
assert_eq(_r4lp_svd(_r4lp_A, _r4lp_m(2, 1), _r4lp_S, _r4lp_m(1, 1)), HSB_ERR_NO_CONVERGENCE,
  "svd [g; g]: sigma above DBL_MAX -> NO_CONVERGENCE (3.3.2: OK, S = +Inf)");
assert_eq(load64(_r4lp_S), 0x7777, "svd [g; g]: out_S is left untouched");
ganita_mat_set(_r4lp_A, 0, 0, _r4lp_g2); ganita_mat_set(_r4lp_A, 1, 0, _r4lp_g2);
assert_eq(_r4lp_svd(_r4lp_A, _r4lp_m(2, 1), _r4lp_S, _r4lp_m(1, 1)), HSB_ERR_NONE, "svd [g'; g'] (control): success");
assert_eq(load64(_r4lp_S), 0x7FDB27247AFF148F, "svd [g'; g'] (control): S = sqrt(2) g', correctly rounded");
store64(_r4lp_S, 0x7777);
store64(_r4lp_S + 8, 0x7777);
_r4lp_A = _r4lp_m(2, 2);
ganita_mat_set(_r4lp_A, 0, 0, _r4lp_g); ganita_mat_set(_r4lp_A, 0, 1, _r4lp_g);
ganita_mat_set(_r4lp_A, 1, 0, _r4lp_g); ganita_mat_set(_r4lp_A, 1, 1, _r4lp_g);
assert_eq(_r4lp_eig(_r4lp_A, 2, _r4lp_S, _r4lp_m(2, 2)), HSB_ERR_NO_CONVERGENCE,
  "eigen_qr [[g,g],[g,g]]: eigenvalue 2 g above DBL_MAX -> NO_CONVERGENCE (3.3.2: OK, +Inf)");
assert_eq(load64(_r4lp_S), 0x7777, "eigen_qr [[g,g],[g,g]]: out_vals is left untouched");
ganita_mat_set(_r4lp_A, 0, 0, _r4lp_g2); ganita_mat_set(_r4lp_A, 0, 1, _r4lp_g2);
ganita_mat_set(_r4lp_A, 1, 0, _r4lp_g2); ganita_mat_set(_r4lp_A, 1, 1, _r4lp_g2);
assert_eq(_r4lp_eig(_r4lp_A, 2, _r4lp_S, _r4lp_m(2, 2)), HSB_ERR_NONE, "eigen_qr [[g',g'],[g',g']] (control): success");
assert_eq(load64(_r4lp_S), 0x7FE3333333333332, "eigen_qr [[g',g'],[g',g']] (control): lambda0 = 2 g' less 1 ulp");

# (3) THE GUARDS, AT THE INPUT WHERE EACH FIRES. Through the public entry a later
# check covers several of these (on three span probes, removing the column-norm,
# split-radius, split-propagation or bidiagonal-QR left-radius check alone moves no
# row), so each is called directly, with g = 1.48 * 2^1023 unbalanced. Without its
# check each of these returns Ok and a made-up result: [0; g] and the right
# reflector's [[0, 0, g], ...] skip their reflector (v / Inf = 0) and drop g; a NaN
# in the column or row being reflected fails the `> 0` gate and is dropped; each
# split arm rotates by cs = sn = 0 and reports a split, zeroing U or Vt; the
# bidiagonal QR without the split's -1 deflates d = (0, -g); its left rotation
# stores +Inf in diag and zeroes U; the tridiagonal QR's +Inf radius writes zeros;
# and the deflation sum |a| + |b| = +Inf calls every off-diagonal negligible.
# [measured: scratch builds with each check removed, not reproducible in-tree, 2026-10-01]
var _r4lp_nan = f64_div(f64_from(0), f64_from(0));
fn _r4lp_bid(A, m, n) {
    var rt, rv = _lp_bidiagonalize(A, m, n, _lp_vec_new(n), _lp_vec_new(n), ganita_mat_new(m, n), ganita_mat_new(n, n));
    if (rt != 0) { return rv; }
    return HSB_ERR_NONE;
}
fn _r4lp_tri(A, n) {
    var rt, rv = _lp_tridiagonalize(A, n, _lp_vec_new(n), _lp_vec_new(n), ganita_mat_new(n, n));
    if (rt != 0) { return rv; }
    return HSB_ERR_NONE;
}
fn _r4lp_eye(n) {
    var M = _r4lp_m(n, n);
    for (var i = 0; i < n; i = i + 1) { ganita_mat_set(M, i, i, F64_ONE); }
    return M;
}
_r4lp_A = _r4lp_m(2, 1);
ganita_mat_set(_r4lp_A, 1, 0, _r4lp_g);
assert_eq(_r4lp_bid(_r4lp_A, 2, 1), HSB_ERR_NO_CONVERGENCE, "_lp_bidiagonalize [0; g]: nv_l = +Inf -> NO_CONVERGENCE");
_r4lp_A = _r4lp_m(2, 1);
ganita_mat_set(_r4lp_A, 0, 0, F64_ONE); ganita_mat_set(_r4lp_A, 1, 0, _r4lp_nan);
assert_eq(_r4lp_bid(_r4lp_A, 2, 1), HSB_ERR_NO_CONVERGENCE,
  "_lp_bidiagonalize [1; NaN]: norm_l = NaN -> NO_CONVERGENCE");
_r4lp_A = _r4lp_m(3, 3);
ganita_mat_set(_r4lp_A, 0, 2, _r4lp_g); ganita_mat_set(_r4lp_A, 1, 1, F64_ONE); ganita_mat_set(_r4lp_A, 2, 2, F64_ONE);
assert_eq(_r4lp_bid(_r4lp_A, 3, 3), HSB_ERR_NO_CONVERGENCE,
  "_lp_bidiagonalize [[0,0,g],[0,1,0],[0,0,1]]: nv_r = +Inf -> NO_CONVERGENCE");
_r4lp_A = _r4lp_m(3, 3);
ganita_mat_set(_r4lp_A, 0, 1, F64_ONE); ganita_mat_set(_r4lp_A, 0, 2, _r4lp_nan);
ganita_mat_set(_r4lp_A, 1, 1, F64_ONE); ganita_mat_set(_r4lp_A, 2, 2, F64_ONE);
assert_eq(_r4lp_bid(_r4lp_A, 3, 3), HSB_ERR_NO_CONVERGENCE,
  "_lp_bidiagonalize [[0,1,NaN],[0,1,0],[0,0,1]]: norm_r = NaN -> NO_CONVERGENCE");
_r4lp_A = _r4lp_m(3, 3);
ganita_mat_set(_r4lp_A, 0, 2, _r4lp_g); ganita_mat_set(_r4lp_A, 2, 0, _r4lp_g);
assert_eq(_r4lp_tri(_r4lp_A, 3), HSB_ERR_NO_CONVERGENCE,
  "_lp_tridiagonalize [[0,0,g],[0,0,0],[g,0,0]]: nv_t = +Inf -> NO_CONVERGENCE");
_r4lp_A = _r4lp_m(3, 3);
ganita_mat_set(_r4lp_A, 0, 1, F64_ONE); ganita_mat_set(_r4lp_A, 0, 2, _r4lp_nan);
ganita_mat_set(_r4lp_A, 1, 0, F64_ONE); ganita_mat_set(_r4lp_A, 2, 0, _r4lp_nan);
assert_eq(_r4lp_tri(_r4lp_A, 3), HSB_ERR_NO_CONVERGENCE,
  "_lp_tridiagonalize [[0,1,NaN],[1,0,0],[NaN,0,0]]: norm = NaN -> NO_CONVERGENCE");
var _r4lp_d = _lp_vec_new(2);
var _r4lp_f = _lp_vec_new(2);
store64(_r4lp_d + 8, _r4lp_g); store64(_r4lp_f, _r4lp_g);
assert_eq(_lp_split_zero_diag(_r4lp_d, _r4lp_f, 2, 2, _r4lp_eye(2), _r4lp_eye(2), 0, 1, 0), 0 - 1,
  "_lp_split_zero_diag d = (0, g), f = g: radius +Inf -> -1 (unchecked: a split, U zeroed)");
_r4lp_d = _lp_vec_new(2);
_r4lp_f = _lp_vec_new(2);
store64(_r4lp_d, _r4lp_g); store64(_r4lp_f, _r4lp_g);
assert_eq(_lp_split_zero_diag(_r4lp_d, _r4lp_f, 2, 2, _r4lp_eye(2), _r4lp_eye(2), 0, 1, 0), 0 - 1,
  "_lp_split_zero_diag d = (g, 0), f = g: radius +Inf -> -1 (unchecked: a split, Vt zeroed)");
_r4lp_d = _lp_vec_new(2);
_r4lp_f = _lp_vec_new(2);
store64(_r4lp_d + 8, _r4lp_g); store64(_r4lp_f, _r4lp_g);
var _r4lp_q1t, _r4lp_q1v = _lp_bidiag_qr(_r4lp_d, _r4lp_f, 2, 2, _r4lp_eye(2), _r4lp_eye(2), 120, 0);
assert_eq(_r4lp_q1v, HSB_ERR_NO_CONVERGENCE, "_lp_bidiag_qr d = (0, g), f = g: the split's -1 -> NO_CONVERGENCE");
_r4lp_d = _lp_vec_new(3);
_r4lp_f = _lp_vec_new(3);
store64(_r4lp_d, 0x7FB849D7A22F547A); store64(_r4lp_d + 8, 0x7FEEB7D555532ECE);
store64(_r4lp_d + 16, 0xFFD37774F28E314F);
store64(_r4lp_f, 0x7FCBA2202BD6B111); store64(_r4lp_f + 8, 0xFFDC22299E523815);
var _r4lp_q2t, _r4lp_q2v = _lp_bidiag_qr(_r4lp_d, _r4lp_f, 3, 3, _r4lp_eye(3), _r4lp_eye(3), 270, 0);
assert_eq(_r4lp_q2v, HSB_ERR_NO_CONVERGENCE,
  "_lp_bidiag_qr near-DBL_MAX 3x3: the left rotation's +Inf radius -> NO_CONVERGENCE (unchecked: Ok, +Inf in diag)");
_r4lp_d = _lp_vec_new(2);
var _r4lp_e = _lp_vec_new(2);
store64(_r4lp_e + 8, _r4lp_g);
var _r4lp_q3t, _r4lp_q3v = _lp_tridiag_qr(_r4lp_d, _r4lp_e, 2, _r4lp_eye(2), 200, 0);
assert_eq(_r4lp_q3v, HSB_ERR_NO_CONVERGENCE,
  "_lp_tridiag_qr [[0,g],[g,0]]: radius sqrt(2) g = +Inf -> NO_CONVERGENCE (unchecked: Ok, all zero)");
assert_eq(_lp_negligible(0x7FD4A5E9F8C6A5E3, 0x7FE0E91D5A3C8F21, 0x7FE14593F0E7B2C9), 0,
  "_lp_negligible(5.8e307 between 9.5e307 and 9.7e307): not negligible (the overflowed sum said it was)");
assert_eq(_lp_negligible(0x7C94A5E9F8C6A5E3, 0x7FE0E91D5A3C8F21, 0x7FE14593F0E7B2C9), 1,
  "_lp_negligible(1.29e292 beside the same pair): negligible, through the halved arm (control)");

# === 3.3.4 svdspan: a Givens radius below DBL_MIN rotates U, Vt and V orthogonally ===
# Each Givens radius r in this file that falls below DBL_MIN is rounded to a multiple
# of 2^-1074, so cs = y / r and sn = z / r, each correctly rounded, have cs^2 + sn^2
# away from 1, and the factors they were accumulated into came back non-orthogonal
# with every value right. Since 3.3.4 the accumulated rotation comes from the pair
# lifted by a power of two (`_lp_rot_leg`), and on a first attempt (`lift` 0, which
# the direct calls here pass) the bidiagonal or tridiagonal keeps cs and sn, so no
# value moves. Each of the five sites is called directly at an input
# where it fires (u = 2^-1074): y = 2785085u and z = 1854249u have r = 3345883.7u,
# stored as 3345884u, and 3.3.3 rotated U and Vt by (0x3FEAA2F33F4F07EF,
# 0x3FE1BBE89F232F75), 6.5e8 and 4.3e8 ulp off; now they get the correctly rounded
# (0x3FEAA2F365D5B50B, 0x3FE1BBE8B8C98A66) from a 60-digit Decimal y / r and z / r.
# The 3x3 bidiagonal below came back from `_lp_bidiag_qr` with U and Vt off
# orthogonal by 2.5e-12 and 9.4e-12, and now by 8.2e-16 and 5.7e-16; the 2x2
# tridiagonal's Q by 2.7e-7, now 8.1e-17. The values are 3.3.3's bit for bit.
# [measured: white-box scratch probe, 3.3.4 base vs this tree + Decimal residuals, 2026-10-03; cycc 6.6.14]
fn _gr_eye(n) {
    var M = _r4lp_m(n, n);
    for (var i = 0; i < n; i = i + 1) { ganita_mat_set(M, i, i, F64_ONE); }
    return M;
}
# number of the k entries of M from row r0 on (row-major) that differ from the words at `want`
fn _gr_diff(M, cols, r0, want, k) {
    var bad = 0;
    for (var i = 0; i < k; i = i + 1) {
        if (ganita_mat_get(M, r0 + i / cols, i % cols) != load64(want + i * 8)) { bad = bad + 1; }
    }
    return bad;
}
var _gr_y = 0x00000000002A7F3D;
var _gr_z = 0x00000000001C4B29;
var _gr_w = alloc(9 * 8);
# The split chase, both arms, on d = (0, y, w), f = (z, v) and its mirror: two
# rotations each, both radii below DBL_MIN; v = 1.0e12u keeps B's side visible.
var _gr_d = _lp_vec_new(3);
var _gr_f = _lp_vec_new(3);
store64(_gr_d + 8, _gr_y); store64(_gr_d + 16, 0x00000000002801E1);
store64(_gr_f, _gr_z); store64(_gr_f + 8, 0x000000F3A9C1D2B7);
var _gr_U = _gr_eye(3);
var _gr_V = _gr_eye(3);
assert_eq(_lp_split_zero_diag(_gr_d, _gr_f, 3, 3, _gr_U, _gr_V, 0, 2, 0), 1,
  "_lp_split_zero_diag d = (0, y, w): splits");
assert_eq(load64(_gr_d + 8), 0x0000000000330DDC,
  "_lp_split_zero_diag d = (0, y, w): d[1] = r on the grid, as on 3.3.3");
assert_eq(load64(_gr_d + 16), 0x000000870902471B, "_lp_split_zero_diag d = (0, y, w): d[2], as on 3.3.3");
assert_eq(load64(_gr_f + 8), 0x000000CAD2B51397, "_lp_split_zero_diag d = (0, y, w): f[1] = cs v, as on 3.3.3");
store64(_gr_w, 0x3ECF911885CD8D2B); store64(_gr_w + 8, 0x3FE1BBE8B8C98A66); store64(_gr_w + 16, 0xBFEAA2F365D489C3);
store64(_gr_w + 24, 0xBEC50437BF5DCEF3); store64(_gr_w + 32, 0x3FEAA2F365D5B50B);
store64(_gr_w + 40, 0x3FE1BBE8B8C8C325); store64(_gr_w + 48, 0x3FEFFFFFFFFE9875); store64(_gr_w + 56, 0);
store64(_gr_w + 64, 0x3ED2F624D7422651);
assert_eq(_gr_diff(_gr_U, 3, 0, _gr_w, 9), 0,
  "_lp_split_zero_diag d = (0, y, w): U, bit for bit (U[1][1] = y / r rounded)");
assert_eq(ganita_mat_get(_gr_V, 1, 1), F64_ONE, "_lp_split_zero_diag d = (0, y, w): Vt untouched");
_gr_d = _lp_vec_new(3);
_gr_f = _lp_vec_new(3);
store64(_gr_d, 0x00000000002801E1); store64(_gr_d + 8, _gr_y);
store64(_gr_f, 0x000000F3A9C1D2B7); store64(_gr_f + 8, _gr_z);
_gr_U = _gr_eye(3);
_gr_V = _gr_eye(3);
assert_eq(_lp_split_zero_diag(_gr_d, _gr_f, 3, 3, _gr_U, _gr_V, 0, 2, 0), 1,
  "_lp_split_zero_diag d = (w, y, 0): splits");
assert_eq(load64(_gr_d), 0x000000870902471B, "_lp_split_zero_diag d = (w, y, 0): d[0], as on 3.3.3");
assert_eq(load64(_gr_d + 8), 0x0000000000330DDC,
  "_lp_split_zero_diag d = (w, y, 0): d[1] = r on the grid, as on 3.3.3");
assert_eq(load64(_gr_f), 0x000000CAD2B51397, "_lp_split_zero_diag d = (w, y, 0): f[0] = cs v, as on 3.3.3");
store64(_gr_w, 0x3ED2F624D7422651); store64(_gr_w + 8, 0x3FE1BBE8B8C8C325); store64(_gr_w + 16, 0xBFEAA2F365D489C3);
store64(_gr_w + 24, 0); store64(_gr_w + 32, 0x3FEAA2F365D5B50B); store64(_gr_w + 40, 0x3FE1BBE8B8C98A66);
store64(_gr_w + 48, 0x3FEFFFFFFFFE9875); store64(_gr_w + 56, 0xBEC50437BF5DCEF3);
store64(_gr_w + 64, 0x3ECF911885CD8D2B);
assert_eq(_gr_diff(_gr_V, 3, 0, _gr_w, 9), 0,
  "_lp_split_zero_diag d = (w, y, 0): Vt, bit for bit (Vt[1][1] = y / r rounded)");
assert_eq(ganita_mat_get(_gr_U, 1, 1), F64_ONE, "_lp_split_zero_diag d = (w, y, 0): U untouched");
# The bulge chase: a 3x3 bidiagonal on the grid, 40-bit random mantissas.
_gr_d = _lp_vec_new(3);
_gr_f = _lp_vec_new(3);
store64(_gr_d, 0x000000A2A31DB884); store64(_gr_d + 8, 0x000000F50363C2E2); store64(_gr_d + 16, 0x000000BC4EE5722C);
store64(_gr_f, 0x000000A4FC3B306A); store64(_gr_f + 8, 0x000000876A8BE009);
_gr_U = _gr_eye(3);
_gr_V = _gr_eye(3);
var _gr_qt, _gr_qv = _lp_bidiag_qr(_gr_d, _gr_f, 3, 3, _gr_U, _gr_V, 270, 0);
assert_eq(is_ok(_gr_qt), 1, "_lp_bidiag_qr 3x3 on the grid: converges");
assert_eq(load64(_gr_d), 0x0000015162BEE080, "_lp_bidiag_qr 3x3 on the grid: d[0], as on 3.3.3");
assert_eq(load64(_gr_d + 8), 0x0000006CB775B1F3, "_lp_bidiag_qr 3x3 on the grid: d[1], as on 3.3.3");
assert_eq(load64(_gr_d + 16), 0x000000CC9398D40E, "_lp_bidiag_qr 3x3 on the grid: d[2], as on 3.3.3");
store64(_gr_w, 0x3FE13AEF05F57AB1); store64(_gr_w + 8, 0x3FE1909688962D75); store64(_gr_w + 16, 0x3FE475AC6DA05F89);
store64(_gr_w + 24, 0x3FE9A4537C7F06B4); store64(_gr_w + 32, 0xBFE22F7229FC29A6);
store64(_gr_w + 40, 0xBFC7EDC2EEC8C3D2); store64(_gr_w + 48, 0x3FD0AFD69B9A203C);
store64(_gr_w + 56, 0x3FE39D97794194D7); store64(_gr_w + 64, 0xBFE7DDDAEC876BD8);
assert_eq(_gr_diff(_gr_U, 3, 0, _gr_w, 9), 0, "_lp_bidiag_qr 3x3 on the grid: U, bit for bit (orthogonal to 8.2e-16)");
store64(_gr_w, 0x3FD09C97586A2322); store64(_gr_w + 8, 0x3FEB0C149F310C9E); store64(_gr_w + 16, 0x3FDDE5B71EA77CCE);
store64(_gr_w + 24, 0x3FEA46C65E975D94); store64(_gr_w + 32, 0xBFDCA80B7F94A7D5);
store64(_gr_w + 40, 0x3FD6A64457E04D5F); store64(_gr_w + 48, 0x3FE043EB8CC623F6);
store64(_gr_w + 56, 0x3FD2ABC8B316B392); store64(_gr_w + 64, 0xBFE9EDB2F92608CC);
assert_eq(_gr_diff(_gr_V, 3, 0, _gr_w, 9), 0, "_lp_bidiag_qr 3x3 on the grid: Vt, bit for bit (orthogonal to 5.7e-16)");
_gr_d = _lp_vec_new(2);
var _gr_e = _lp_vec_new(2);
store64(_gr_d, _gr_y); store64(_gr_d + 8, _gr_z); store64(_gr_e + 8, 0x0000000000154C2B);
var _gr_Q = _gr_eye(2);
var _gr_tt, _gr_tv = _lp_tridiag_qr(_gr_d, _gr_e, 2, _gr_Q, 200, 0);
assert_eq(is_ok(_gr_tt), 1, "_lp_tridiag_qr 2x2 on the grid: converges");
assert_eq(load64(_gr_d), 0x000000000039D87F, "_lp_tridiag_qr 2x2 on the grid: lambda_0 = 3790975u, as on 3.3.3");
assert_eq(load64(_gr_d + 8), 0x00000000000CF1E8, "_lp_tridiag_qr 2x2 on the grid: lambda_1 = 848360u, as on 3.3.3");
assert_eq(ganita_mat_get(_gr_Q, 0, 0), 0x3FE9F5F42C76F66D, "_lp_tridiag_qr 2x2 on the grid: Q[0][0]");
assert_eq(ganita_mat_get(_gr_Q, 0, 1), 0xBFE2B596C3981FC7, "_lp_tridiag_qr 2x2 on the grid: Q[0][1]");
assert_eq(ganita_mat_get(_gr_Q, 1, 0), 0x3FE2B596C3981FC7, "_lp_tridiag_qr 2x2 on the grid: Q[1][0]");
assert_eq(ganita_mat_get(_gr_Q, 1, 1), 0x3FE9F5F42C76F66D, "_lp_tridiag_qr 2x2 on the grid: Q[1][1]");

# Through the public entries. The rank-1 4x4 A[i][j] = x_i (1 + j), x spanning 1233
# binades and its products rounded, came back with max |Vt Vt^T - I| = 0.099 on 3.3.3
# (rows 1 and 3 of Vt), 3.3e-16 now; eigen_qr's 3x3 with a -2^1008 corner over a
# [[33u, -55u], [-55u, 54u]] block came back with max |V^T V - I| = 2.4e-7, 2.2e-16 now.
# S and the eigenvalues are 3.3.3's bit for bit.
# [measured: rank-1 and span probe rows, 3.3.4 base vs this tree, float residual, 2026-10-03; cycc 6.6.14]
var _gr_A = _r4lp_m(4, 4);
var _gr_x = alloc(4 * 8);
store64(_gr_x, 0xD058B41C4FC5C6E4); store64(_gr_x + 8, 0xF3BD0E9D7AA84C6B);
store64(_gr_x + 16, 0xC9BC5608038CC7DE); store64(_gr_x + 24, 0xA6A57B627996D5B1);
for (var _gr_i = 0; _gr_i < 16; _gr_i = _gr_i + 1) {
    ganita_mat_set(_gr_A, _gr_i / 4, _gr_i % 4, f64_mul(load64(_gr_x + (_gr_i / 4) * 8), f64_from(1 + _gr_i % 4)));
}
var _gr_S = alloc(4 * 8);
_gr_V = _r4lp_m(4, 4);
assert_eq(_r4lp_svd(_gr_A, _r4lp_m(4, 4), _gr_S, _gr_V), HSB_ERR_NONE, "svd rank-1 4x4 x_i (1 + j): answered");
assert_eq(load64(_gr_S), 0x73E3E4DF241C9DE1, "svd rank-1 4x4: sigma_1, as on 3.3.3");
assert_eq(load64(_gr_S + 8), 0x2392000000000000, "svd rank-1 4x4: sigma_2, as on 3.3.3");
assert_eq(load64(_gr_S + 16), 0, "svd rank-1 4x4: sigma_3 = 0, as on 3.3.3");
assert_eq(load64(_gr_S + 24), 0, "svd rank-1 4x4: sigma_4 = 0, as on 3.3.3");
store64(_gr_w, 0x0000000000000000); store64(_gr_w + 8, 0xBFE183B628B356E6); store64(_gr_w + 16, 0x3FE8E1ED7A4D1D84);
store64(_gr_w + 24, 0xBFD3CF2E0EC0555C);
assert_eq(_gr_diff(_gr_V, 4, 1, _gr_w, 4), 0, "svd rank-1 4x4: Vt row 1, bit for bit (3.3.3: |row|^2 = 0.90)");
store64(_gr_w, 0x8000000000000000); store64(_gr_w + 8, 0x3FE800015355BCCC); store64(_gr_w + 16, 0x3FD2A9721BB9D623);
store64(_gr_w + 24, 0xBFE2FF8B74108EB4);
assert_eq(_gr_diff(_gr_V, 4, 3, _gr_w, 4), 0, "svd rank-1 4x4: Vt row 3, bit for bit (3.3.3: off orthogonal)");
_gr_A = _r4lp_m(3, 3);
ganita_mat_set(_gr_A, 0, 0, 0xFEF1529BC4645A38);
ganita_mat_set(_gr_A, 0, 2, 0x8000000000000008); ganita_mat_set(_gr_A, 2, 0, 0x8000000000000008);
ganita_mat_set(_gr_A, 1, 1, 33); ganita_mat_set(_gr_A, 2, 2, 54);
ganita_mat_set(_gr_A, 1, 2, 0x8000000000000037); ganita_mat_set(_gr_A, 2, 1, 0x8000000000000037);
_gr_V = _r4lp_m(3, 3);
assert_eq(_r4lp_eig(_gr_A, 3, _gr_S, _gr_V), HSB_ERR_NONE, "eigen_qr 3x3 corner over a block on the grid: answered");
assert_eq(load64(_gr_S), 0xFEF1529BC4645A38, "eigen_qr 3x3 corner: lambda_0 = A[0][0], as on 3.3.3");
assert_eq(load64(_gr_S + 8), 99, "eigen_qr 3x3 corner: lambda_1 = 99.49u rounded to 99u, as on 3.3.3");
assert_eq(load64(_gr_S + 16), 0x800000000000000C,
  "eigen_qr 3x3 corner: lambda_2 = -12.49u rounded to -12u, as on 3.3.3");
assert_eq(ganita_mat_get(_gr_V, 1, 1), 0xBFE46552B021473C, "eigen_qr 3x3 corner: V[1][1] (3.3.3: 0xBFE46552D91B1AAA)");
assert_eq(ganita_mat_get(_gr_V, 1, 2), 0x3FE8A86B99398207, "eigen_qr 3x3 corner: V[1][2] (3.3.3: 0x3FE8A86BCAC36339)");
assert_eq(ganita_mat_get(_gr_V, 2, 1), 0x3FE8A86B99398207, "eigen_qr 3x3 corner: V[2][1]");
assert_eq(ganita_mat_get(_gr_V, 2, 2), 0x3FE46552B021473C, "eigen_qr 3x3 corner: V[2][2]");

# ONLY BELOW DBL_MIN. Above it y / r is already accurate, and the lifted quotient can
# differ from it by an ulp, so lifting every rotation would move the factors of inputs
# 3.3.3 answered. Measured with the lift taken at every radius, one site at a time:
# 390, 1670, 1076, 2222 and 4011 of the 43,000 probe rows change their factors (sites
# in order: the two split arms, the right and left bulge rotations, the tridiagonal
# QR), values unchanged. This 5x5 spanning 1986 binades and this 2x2 meet no radius
# below DBL_MIN, so their factors are 3.3.3's bit for bit; each site's widened trigger
# moves at least one of the entries below by an ulp.
# [measured: span probe rows S1 3700 / S1 6001 + per-site lift-always builds, 2026-10-03; cycc 6.6.14]
_gr_A = _r4lp_m(5, 5);
ganita_mat_set(_gr_A, 0, 0, 0x03BCB45ED65E22A9); ganita_mat_set(_gr_A, 0, 1, 0x83DDA9AA850989F4);
ganita_mat_set(_gr_A, 0, 3, 0x7FAA2E205C076E9E); ganita_mat_set(_gr_A, 0, 4, 0x83DB7399619C4478);
ganita_mat_set(_gr_A, 1, 0, 0x03C346F1776FAC68); ganita_mat_set(_gr_A, 1, 1, 0x83A0D25833B7707C);
ganita_mat_set(_gr_A, 1, 3, 0x83D5260ED9980816);
ganita_mat_set(_gr_A, 2, 0, 0x83C83CEBEEF60960); ganita_mat_set(_gr_A, 2, 1, 0x83A0ECC4EC38132E);
ganita_mat_set(_gr_A, 2, 2, 0x7FC6A1427F56246E); ganita_mat_set(_gr_A, 2, 3, 0x03DC594961E28D1A);
ganita_mat_set(_gr_A, 2, 4, 0x7FB0C591C01FCBE7);
ganita_mat_set(_gr_A, 3, 0, 0x03C0A2B8710BB2B6); ganita_mat_set(_gr_A, 3, 1, 0xFFA5A19AEF879414);
ganita_mat_set(_gr_A, 3, 2, 0x03BFF7C30743373F); ganita_mat_set(_gr_A, 3, 3, 0x03CB26E20A37B430);
ganita_mat_set(_gr_A, 3, 4, 0x83B957CBD45D48A5);
ganita_mat_set(_gr_A, 4, 0, 0x7F9E2FE80C5A0D24); ganita_mat_set(_gr_A, 4, 2, 0x7FC7C5A6A0788504);
ganita_mat_set(_gr_A, 4, 3, 0xFF93E2D2CB8D298A); ganita_mat_set(_gr_A, 4, 4, 0x7FA796A1C5FDEB53);
var _gr_S5 = alloc(5 * 8);
var _gr_U5 = _r4lp_m(5, 5);
_gr_V = _r4lp_m(5, 5);
assert_eq(_r4lp_svd(_gr_A, _gr_U5, _gr_S5, _gr_V), HSB_ERR_NONE, "svd 5x5 across 1986 binades: answered");
assert_eq(load64(_gr_S5), 0x7FD13E10B5559685, "svd 5x5 across 1986 binades: sigma_1, as on 3.3.3");
assert_eq(ganita_mat_get(_gr_U5, 0, 0), 0x3F84E1B4C94A2DE4, "svd 5x5: U[0][0], as on 3.3.3 (left bulge rotation)");
assert_eq(ganita_mat_get(_gr_U5, 0, 2), 0xBCD706CA5B6ADA50, "svd 5x5: U[0][2], as on 3.3.3 (split arm 1)");
assert_eq(ganita_mat_get(_gr_V, 0, 0), 0xBFB41FF4CEE99D61, "svd 5x5: Vt[0][0], as on 3.3.3 (split arm 2)");
assert_eq(ganita_mat_get(_gr_V, 1, 0), 0xBFBEFCD905C005DC, "svd 5x5: Vt[1][0], as on 3.3.3");
assert_eq(ganita_mat_get(_gr_V, 1, 3), 0x3FEF90EA3115B754, "svd 5x5: Vt[1][3], as on 3.3.3 (right bulge rotation)");
_gr_A = _r4lp_m(2, 2);
ganita_mat_set(_gr_A, 0, 1, 0xFF865055C3748FD7); ganita_mat_set(_gr_A, 1, 0, 0xFF865055C3748FD7);
ganita_mat_set(_gr_A, 1, 1, 0x88D5E427A5436A78);
_gr_V = _r4lp_m(2, 2);
assert_eq(_r4lp_eig(_gr_A, 2, _gr_S, _gr_V), HSB_ERR_NONE, "eigen_qr 2x2 across 1904 binades: answered");
assert_eq(load64(_gr_S), 0x7F865055C3748FD6, "eigen_qr 2x2 across 1904 binades: lambda_0, as on 3.3.3");
assert_eq(ganita_mat_get(_gr_V, 0, 0), 0x3FE6A09E667F3BCC, "eigen_qr 2x2: V[0][0], as on 3.3.3 (tridiagonal QR)");
assert_eq(ganita_mat_get(_gr_V, 0, 1), 0x3FE6A09E667F3BCC, "eigen_qr 2x2: V[0][1], as on 3.3.3");

# AND FROM DBL_MIN DOWN. Every radius below DBL_MIN is lifted, including those in
# [DBL_MIN / 2, DBL_MIN), where r still carries 51 bits and the quotients by it are off
# by about an ulp. One direct call per site meets a radius in that band; with the
# trigger halved to DBL_MIN / 2 each entry pinned here moves by 1 or 2 ulp. The split
# chase on d = (0, a, w), f = (b, v) meets r = 0x0008D10C74EC1776, and U[1][1] is
# 0.19 ulp from an 80-digit Decimal a / hypot(a, b) (halved: 0.81 ulp); the 2x2
# tridiagonal's Q[0][0] is 0.76 ulp from its Decimal eigenvector (halved: 2.76 ulp).
# The bidiagonals are the 3x3 above times 2^11 (left rotation, U) and 2^12 (right
# rotation, Vt).
# [measured: white-box scratch probes, this tree vs per-site halved-trigger builds + Decimal, 2026-10-03; cycc 6.6.14]
_gr_d = _lp_vec_new(3);
_gr_f = _lp_vec_new(3);
store64(_gr_d + 8, 0x0005CADC9A9A80FD); store64(_gr_d + 16, 0x00000000002801E1);
store64(_gr_f, 0x0006A595A02F34A6); store64(_gr_f + 8, 0x000000F3A9C1D2B7);
_gr_U = _gr_eye(3);
_gr_V = _gr_eye(3);
assert_eq(_lp_split_zero_diag(_gr_d, _gr_f, 3, 3, _gr_U, _gr_V, 0, 2, 0), 1,
  "_lp_split_zero_diag, r in [DBL_MIN/2, DBL_MIN): splits");
assert_eq(load64(_gr_d + 8), 0x0008D10C74EC1776, "_lp_split_zero_diag, r in [DBL_MIN/2, DBL_MIN): d[1] = r");
assert_eq(ganita_mat_get(_gr_U, 1, 1), 0x3FE50612FDE07A6D,
  "_lp_split_zero_diag, r in [DBL_MIN/2, DBL_MIN): U[1][1] lifted (0.19 ulp; unlifted ...6C)");
_gr_d = _lp_vec_new(3);
_gr_f = _lp_vec_new(3);
store64(_gr_d, 0x00000000002801E1); store64(_gr_d + 8, 0x0005CADC9A9A80FD);
store64(_gr_f, 0x000000F3A9C1D2B7); store64(_gr_f + 8, 0x0006A595A02F34A6);
_gr_U = _gr_eye(3);
_gr_V = _gr_eye(3);
assert_eq(_lp_split_zero_diag(_gr_d, _gr_f, 3, 3, _gr_U, _gr_V, 0, 2, 0), 1,
  "_lp_split_zero_diag mirror, r in [DBL_MIN/2, DBL_MIN): splits");
assert_eq(ganita_mat_get(_gr_V, 1, 1), 0x3FE50612FDE07A6D,
  "_lp_split_zero_diag mirror, r in [DBL_MIN/2, DBL_MIN): Vt[1][1] lifted (unlifted ...6C)");
_gr_d = _lp_vec_new(3);
_gr_f = _lp_vec_new(3);
store64(_gr_d, 0x00051518EDC42000); store64(_gr_d + 8, 0x0007A81B1E171000); store64(_gr_d + 16, 0x0005E2772B916000);
store64(_gr_f, 0x000527E1D9835000); store64(_gr_f + 8, 0x00043B545F004800);
_gr_U = _gr_eye(3);
_gr_V = _gr_eye(3);
var _gb_lt, _gb_lv = _lp_bidiag_qr(_gr_d, _gr_f, 3, 3, _gr_U, _gr_V, 270, 0);
assert_eq(ganita_mat_get(_gr_U, 0, 0), 0x3FE13AEF05F53B7E,
  "_lp_bidiag_qr 3x3 times 2^11: U[0][0], left rotation lifted in [DBL_MIN/2, DBL_MIN) (unlifted ...7D)");
_gr_d = _lp_vec_new(3);
_gr_f = _lp_vec_new(3);
store64(_gr_d, 0x000A2A31DB884000); store64(_gr_d + 8, 0x000F50363C2E2000); store64(_gr_d + 16, 0x000BC4EE5722C000);
store64(_gr_f, 0x000A4FC3B306A000); store64(_gr_f + 8, 0x000876A8BE009000);
_gr_U = _gr_eye(3);
_gr_V = _gr_eye(3);
var _gb_rt, _gb_rv = _lp_bidiag_qr(_gr_d, _gr_f, 3, 3, _gr_U, _gr_V, 270, 0);
assert_eq(ganita_mat_get(_gr_V, 0, 0), 0x3FD09C975869B774,
  "_lp_bidiag_qr 3x3 times 2^12: Vt[0][0], right rotation lifted in [DBL_MIN/2, DBL_MIN) (unlifted ...72)");
_gr_d = _lp_vec_new(2);
_gr_e = _lp_vec_new(2);
store64(_gr_d, 0x8002C7FEC7446F29); store64(_gr_d + 8, 0x00038494824D346C); store64(_gr_e + 8, 0x00030817D359F66E);
_gr_Q = _gr_eye(2);
var _gb_tt, _gb_tv = _lp_tridiag_qr(_gr_d, _gr_e, 2, _gr_Q, 200, 0);
assert_eq(ganita_mat_get(_gr_Q, 0, 0), 0xBFEDADFB96A66215,
  "_lp_tridiag_qr 2x2, r in [DBL_MIN/2, DBL_MIN): Q[0][0] lifted (0.76 ulp; unlifted ...17, 2.76 ulp)");
assert_eq(ganita_mat_get(_gr_Q, 0, 1), 0xBFD7ED3375A4A4E3,
  "_lp_tridiag_qr 2x2, r in [DBL_MIN/2, DBL_MIN): Q[0][1] lifted (unlifted ...E5)");

# ON A RETRY (`lift` 1) THE BIDIAGONAL TAKES THE LIFTED ROTATION TOO. The split chase on
# d = (0, y, w) above, with lift 1: B's f[1] = cs v and d[2] = hypot(w, sn v) come back
# 0.34u and 0.54u from an 80-digit Decimal; with lift 0 the quotients by the rounded r
# leave them 75,099u and 49,999u off (r_true / r is 1 - 8.6e-8). The grid bidiagonal
# above times 2, with lift 1, takes the lifted rotation at both bulge rotations; its
# values are each within 1.1u of the Decimal singular values, and without the lift at
# either rotation one of them moves (eigen_qr's site is pinned by (6) of the headroom
# block below).
# [measured: white-box scratch probes, this tree vs no-retry-lift builds + Decimal, 2026-10-03; cycc 6.6.14]
_gr_d = _lp_vec_new(3);
_gr_f = _lp_vec_new(3);
store64(_gr_d + 8, _gr_y); store64(_gr_d + 16, 0x00000000002801E1);
store64(_gr_f, _gr_z); store64(_gr_f + 8, 0x000000F3A9C1D2B7);
_gr_U = _gr_eye(3);
_gr_V = _gr_eye(3);
assert_eq(_lp_split_zero_diag(_gr_d, _gr_f, 3, 3, _gr_U, _gr_V, 0, 2, 1), 1,
  "_lp_split_zero_diag d = (0, y, w), lift 1: splits");
assert_eq(load64(_gr_d + 16), 0x0000008709030A6B,
  "_lp_split_zero_diag d = (0, y, w), lift 1: d[2] (lift 0: ...02471B)");
assert_eq(load64(_gr_f + 8), 0x000000CAD2B638F2, "_lp_split_zero_diag d = (0, y, w), lift 1: f[1] (lift 0: ...B51397)");
_gr_d = _lp_vec_new(3);
_gr_f = _lp_vec_new(3);
store64(_gr_d, 0x00000000002801E1); store64(_gr_d + 8, _gr_y);
store64(_gr_f, 0x000000F3A9C1D2B7); store64(_gr_f + 8, _gr_z);
_gr_U = _gr_eye(3);
_gr_V = _gr_eye(3);
assert_eq(_lp_split_zero_diag(_gr_d, _gr_f, 3, 3, _gr_U, _gr_V, 0, 2, 1), 1,
  "_lp_split_zero_diag d = (w, y, 0), lift 1: splits");
assert_eq(load64(_gr_d), 0x0000008709030A6B, "_lp_split_zero_diag d = (w, y, 0), lift 1: d[0] (lift 0: ...02471B)");
assert_eq(load64(_gr_f), 0x000000CAD2B638F2, "_lp_split_zero_diag d = (w, y, 0), lift 1: f[0] (lift 0: ...B51397)");
_gr_d = _lp_vec_new(3);
_gr_f = _lp_vec_new(3);
store64(_gr_d, 0x00000145463B7108); store64(_gr_d + 8, 0x000001EA06C785C4); store64(_gr_d + 16, 0x000001789DCAE458);
store64(_gr_f, 0x00000149F87660D4); store64(_gr_f + 8, 0x0000010ED517C012);
_gr_U = _gr_eye(3);
_gr_V = _gr_eye(3);
var _gb_l1t, _gb_l1v = _lp_bidiag_qr(_gr_d, _gr_f, 3, 3, _gr_U, _gr_V, 270, 1);
assert_eq(is_ok(_gb_l1t), 1, "_lp_bidiag_qr 3x3 on the grid times 2, lift 1: converges");
assert_eq(load64(_gr_d), 0x000002A2C57DC0FD, "_lp_bidiag_qr 3x3 on the grid times 2, lift 1: d[0]");
assert_eq(load64(_gr_d + 8), 0x000000D96EEB63EB, "_lp_bidiag_qr 3x3 on the grid times 2, lift 1: d[1]");
assert_eq(load64(_gr_d + 16), 0x000001992731A825, "_lp_bidiag_qr 3x3 on the grid times 2, lift 1: d[2]");

# AND ONLY ABOVE ZERO. A radius of exactly 0 keeps 3.3.3's identity rotation (cs = 1,
# sn = 0); lifted, it would be 0 / 0 and write NaN into the factors with rc = OK. Over
# the probe rows that radius occurs 4, 3 and 51 times at the right and left bulge
# rotations and the tridiagonal QR; these two inputs reach it, the first at both bulge
# rotations, the second (in range, 1032 binades) in the tridiagonal QR.
# [measured: zero-radius counting scratch build over the probe rows, 2026-10-03; cycc 6.6.14]
_gr_A = _r4lp_m(4, 4);
ganita_mat_set(_gr_A, 0, 0, 0x7E5706C8A15FCED7); ganita_mat_set(_gr_A, 0, 3, 0x0000000000000AEA);
ganita_mat_set(_gr_A, 1, 0, 0x9528100D45E27078); ganita_mat_set(_gr_A, 2, 1, 0x80000000000007F0);
ganita_mat_set(_gr_A, 2, 2, 0x00000000000004B3); ganita_mat_set(_gr_A, 2, 3, 0x00000000000004DE);
ganita_mat_set(_gr_A, 3, 1, 0x000000000000182B); ganita_mat_set(_gr_A, 3, 2, 0x0000000000001367);
ganita_mat_set(_gr_A, 3, 3, 0x8000000000000B4A);
_gr_U = _r4lp_m(4, 4);
_gr_V = _r4lp_m(4, 4);
assert_eq(_r4lp_svd(_gr_A, _gr_U, _gr_S, _gr_V), HSB_ERR_NONE, "svd 4x4 with zero bulge radii: answered");
store64(_gr_w, 0); store64(_gr_w + 8, 0xBFDCCC754AB7FCE6); store64(_gr_w + 16, 0x3FEA7E6E48BE7C6C);
store64(_gr_w + 24, 0x3FD56C3C75F323EE);
assert_eq(_gr_diff(_gr_V, 4, 2, _gr_w, 4), 0, "svd 4x4 with zero bulge radii: Vt row 2, no NaN (answered on a retry)");
assert_eq(ganita_mat_get(_gr_U, 1, 2), 0xBD9FF94B28AAB5B4, "svd 4x4 with zero bulge radii: U[1][2], no NaN");
assert_eq(ganita_mat_get(_gr_U, 1, 3), F64_ONE, "svd 4x4 with zero bulge radii: U[1][3] = 1 (the identity rotation)");
_gr_A = _r4lp_m(4, 4);
ganita_mat_set(_gr_A, 0, 0, 0x2E35126D2A617FA6); ganita_mat_set(_gr_A, 0, 2, 0xA46267F00E3E4126);
ganita_mat_set(_gr_A, 0, 3, 0xD585C15CCEF69192); ganita_mat_set(_gr_A, 1, 1, 0x1EDD7E61AB361E72);
ganita_mat_set(_gr_A, 1, 2, 0x2E1B99587FB577BC); ganita_mat_set(_gr_A, 1, 3, 0x2A36E80A92728B5E);
ganita_mat_set(_gr_A, 2, 0, 0xA46267F00E3E4126); ganita_mat_set(_gr_A, 2, 1, 0x2E1B99587FB577BC);
ganita_mat_set(_gr_A, 2, 2, 0xA50CC31F12ABAEA0); ganita_mat_set(_gr_A, 2, 3, 0x1C2AA2F2773CF738);
ganita_mat_set(_gr_A, 3, 0, 0xD585C15CCEF69192); ganita_mat_set(_gr_A, 3, 1, 0x2A36E80A92728B5E);
ganita_mat_set(_gr_A, 3, 2, 0x1C2AA2F2773CF738);
_gr_V = _r4lp_m(4, 4);
assert_eq(_r4lp_eig(_gr_A, 4, _gr_S, _gr_V), HSB_ERR_NONE, "eigen_qr 4x4 with a zero QR radius: answered");
assert_eq(ganita_mat_get(_gr_V, 0, 2), 0x1497D31C330FA333, "eigen_qr 4x4 with a zero QR radius: V[0][2], as on 3.3.3");
assert_eq(ganita_mat_get(_gr_V, 1, 2), 0x3FE6A09E667F3BCC, "eigen_qr 4x4 with a zero QR radius: V[1][2], as on 3.3.3");
assert_eq(ganita_mat_get(_gr_V, 1, 3), 0xBFE6A09E667F3BCC, "eigen_qr 4x4 with a zero QR radius: V[1][3], as on 3.3.3");

# === 3.3.3 R5lp: wide-span overflows the repros above do not reach ===
# Two more finite inputs that 3.3.2 answered rc = OK and wrong, each reaching a check
# no repro above reaches on its own; 3.3.3 returned NO_CONVERGENCE, out untouched.
# eigen_qr on [[a, b], [b, c]] (a = 3.34e306, b = -3.79e306, c = 6.4e-313): true
# eigenvalues 5.809e306 and -2.466e306, and with the deflation test's halved arm
# removed (`_lp_negligible`) it comes back rc = OK with 3.3.2's 5.221e306 and
# -1.878e306. svd_golub_kahan on a 3x3 whose largest entries sit near 2^1018 over a
# 1.1e-314 entry: true S = (3.429e307, 1.874e307, 2.44e290), and with the right
# reflector's nv_r check removed it comes back rc = OK with 3.3.2's
# (3.080e307, 6.600e306, 0).
# [measured: probes on 3.3.2, this tree and check-removed builds + 720-digit oracle, not reproducible in-tree]
# ⭐ 3.3.4 — both are answered on the second attempt (see R4lp above). Against a
# Decimal oracle the eigenvalues are 1 and 2 ulp low (5.8091583794799795e306,
# -2.4658526882992109e306), sigma_1 and sigma_2 1 and 2 ulp low, and sigma_3 = 2.44e290
# comes back 0: it is 7e-18 of sigma_1, below the 1e-12 deflation (roadmap [3.6.0]),
# and the same matrix without its two subnormal entries, answered on the first
# attempt, gives 0 too, with sigma_1 and sigma_2 each 1 ulp low.
# [measured: scratch probes on 3.3.4 base and this tree + 800/1400-digit oracles, 2026-10-03; cycc 6.6.14]
var _r5lp_S = alloc(3 * 8);
var _r5lp_A = _r4lp_m(2, 2);
ganita_mat_set(_r5lp_A, 0, 0, 0x7f930b4a3a128c15); ganita_mat_set(_r5lp_A, 0, 1, 0xff958f0d785fa894);
ganita_mat_set(_r5lp_A, 1, 0, 0xff958f0d785fa894); ganita_mat_set(_r5lp_A, 1, 1, 0x0000001df7beef0c);
_r4lp_reset(_r5lp_S, 3);
assert_eq(_r4lp_eig(_r5lp_A, 2, _r5lp_S, _r4lp_m(2, 2)), HSB_ERR_NONE,
  "eigen_qr [[a,b],[b,c]] across 2056 binades: answered (3.3.2: 10% off; 3.3.3: NO_CONVERGENCE)");
assert_eq(load64(_r5lp_S), 0x7FA08B873BE36254, "eigen_qr [[a,b],[b,c]] across 2056 binades: lambda_0, 1 ulp low");
assert_eq(load64(_r5lp_S + 8), 0xFF8C17887B687128, "eigen_qr [[a,b],[b,c]] across 2056 binades: lambda_1, 2 ulp low");
_r5lp_A = _r4lp_m(3, 3);
ganita_mat_set(_r5lp_A, 0, 0, 0x7f9b3297b1f44f8c); ganita_mat_set(_r5lp_A, 0, 1, 0x7fab3297b1f44f8c);
ganita_mat_set(_r5lp_A, 0, 2, 0x7fb465f1c5773ba9);
ganita_mat_set(_r5lp_A, 1, 0, 0xffa13f3c873dd8f5); ganita_mat_set(_r5lp_A, 1, 1, 0xffb13f3c873dd8f5);
ganita_mat_set(_r5lp_A, 1, 2, 0xffb9dedacadcc56f);
ganita_mat_set(_r5lp_A, 2, 0, 0x000000008961872f); ganita_mat_set(_r5lp_A, 2, 1, 0x7fc2c45c3e75e23d);
ganita_mat_set(_r5lp_A, 2, 2, 0x80000003cd4535de);
_r4lp_reset(_r5lp_S, 3);
assert_eq(_r4lp_svd(_r5lp_A, _r4lp_m(3, 3), _r5lp_S, _r4lp_m(3, 3)), HSB_ERR_NONE,
  "svd 3x3 across 2064 binades: answered (3.3.2: S1 65% low; 3.3.3: NO_CONVERGENCE)");
assert_eq(load64(_r5lp_S), 0x7FC86AB2F28E1B22, "svd 3x3 across 2064 binades: sigma_1, 1 ulp low");
assert_eq(load64(_r5lp_S + 8), 0x7FBAB10E08504AE1, "svd 3x3 across 2064 binades: sigma_2, 2 ulp low");
assert_eq(load64(_r5lp_S + 16), 0, "svd 3x3 across 2064 binades: sigma_3 (7e-18 sigma_1) deflated to +0, as in range");

# === 3.3.4 svdspan: the headroom is applied only where the overflow occurs ===
# (1) AN INPUT THE FIRST ATTEMPT ANSWERS KEEPS ITS BITS. 3.3.3 tried headroom in the
# balance itself (growth 16 n) and withdrew it because this 5x5 lost bits on its small
# entries: A[0][4] = A[4][0] = 0x7FE0A4CA9A08CDEC, A[1][1] = 1889u, A[2][2] = 227u came
# back 1920u and 256u under it (figures from 3.3.3's note at `_lp_balance_scale`).
# 3.3.4 balances as 3.3.3 did and retries with headroom only after an attempt fails;
# this one never fails, so it keeps 3.3.3's 1890u and 227u (the oracle says 1889u and
# 227u exactly), and the large pair, 1 ulp low.
# [measured: scratch probes on 3.3.4 base and this tree + 800-digit oracle, 2026-10-03; cycc 6.6.14]
var _hr_S = alloc(5 * 8);
var _hr_A = _r4lp_m(5, 5);
ganita_mat_set(_hr_A, 0, 4, 0x7FE0A4CA9A08CDEC); ganita_mat_set(_hr_A, 4, 0, 0x7FE0A4CA9A08CDEC);
ganita_mat_set(_hr_A, 1, 1, 1889); ganita_mat_set(_hr_A, 2, 2, 227);
_r4lp_reset(_hr_S, 5);
assert_eq(_r4lp_eig(_hr_A, 5, _hr_S, _r4lp_m(5, 5)), HSB_ERR_NONE, "eigen_qr 5x5 corner + 1889u, 227u: answered");
assert_eq(load64(_hr_S), 0x7FE0A4CA9A08CDEB, "eigen_qr 5x5 corner: lambda_0 = A[0][4], 1 ulp low, as on 3.3.3");
assert_eq(load64(_hr_S + 8), 0xFFE0A4CA9A08CDEB, "eigen_qr 5x5 corner: lambda_1 = -A[0][4], 1 ulp low, as on 3.3.3");
assert_eq(load64(_hr_S + 16), 1890, "eigen_qr 5x5 corner: 1889u comes back 1890u, as on 3.3.3 (1920u under headroom)");
assert_eq(load64(_hr_S + 24), 227, "eigen_qr 5x5 corner: 227u exactly, as on 3.3.3 (256u under headroom)");
assert_eq(load64(_hr_S + 32), 0, "eigen_qr 5x5 corner: the exact 0, as +0");

# (2) ONE BINADE AT A TIME, AS MANY AS IT TAKES. [h1; h2; u] with full mantissas
# (|h1|, |h2| about 2^1012, |u| about 2^-1035) fails twice and is answered on the third
# attempt; the 4x4 below fails three times. Against Decimal oracles sigma is 1.8
# ulp low (correctly rounded 0x7F42E0541132DE62) and the eigenvalues 2, 3, 1 ulp off
# and the exact -0 as +0; the same matrices without their subnormal entries, answered
# on the first attempt, are within 1.2 ulp of the oracle.
# [measured: span probes S3/S1 rows, 3.3.4 base and this tree + 1400/800-digit oracles, 2026-10-03; cycc 6.6.14]
_hr_A = _r4lp_m(3, 1);
ganita_mat_set(_hr_A, 0, 0, 0xFF3A9CC3DFCEBBBB); ganita_mat_set(_hr_A, 1, 0, 0x7F3AC70EE0DA6586);
ganita_mat_set(_hr_A, 2, 0, 0x8000008AA340AAB2);
_r4lp_reset(_hr_S, 5);
assert_eq(_r4lp_svd(_hr_A, _r4lp_m(3, 1), _hr_S, _r4lp_m(1, 1)), HSB_ERR_NONE,
  "svd [h1; h2; u]: answered on the third attempt (3.3.3: NO_CONVERGENCE)");
assert_eq(load64(_hr_S), 0x7F42E0541132DE60, "svd [h1; h2; u]: sigma, 1.8 ulp below the correctly rounded DE62");
_hr_A = _r4lp_m(4, 4);
ganita_mat_set(_hr_A, 0, 2, 0x7FAF5D53D0812DE8); ganita_mat_set(_hr_A, 2, 0, 0x7FAF5D53D0812DE8);
ganita_mat_set(_hr_A, 0, 3, 0x80000000000001E0); ganita_mat_set(_hr_A, 3, 0, 0x80000000000001E0);
ganita_mat_set(_hr_A, 1, 1, 0x7F8E96085ED6ECAE); ganita_mat_set(_hr_A, 2, 2, 0x7F8EAF382EB35C95);
ganita_mat_set(_hr_A, 1, 2, 0x7FADB19C4B420C50); ganita_mat_set(_hr_A, 2, 1, 0x7FADB19C4B420C50);
ganita_mat_set(_hr_A, 1, 3, 0x00000000000001DB); ganita_mat_set(_hr_A, 3, 1, 0x00000000000001DB);
_r4lp_reset(_hr_S, 5);
assert_eq(_r4lp_eig(_hr_A, 4, _hr_S, _r4lp_m(4, 4)), HSB_ERR_NONE,
  "eigen_qr 4x4 across 2088 binades: answered on the fourth attempt (3.3.3: NO_CONVERGENCE)");
assert_eq(load64(_hr_S), 0x7FB8849575CF473B, "eigen_qr 4x4 across 2088 binades: lambda_0, 2 ulp low");
assert_eq(load64(_hr_S + 8), 0xFFB2E3AC8099CEAC, "eigen_qr 4x4 across 2088 binades: lambda_1, 3 ulp high in magnitude");
assert_eq(load64(_hr_S + 16), 0x7F803DF8E3DE84A4, "eigen_qr 4x4 across 2088 binades: lambda_2, 1 ulp high");
assert_eq(load64(_hr_S + 24), 0, "eigen_qr 4x4 across 2088 binades: lambda_3, the exact 0, as +0");

# (3) A VALUE ABOVE DBL_MAX STAYS AN ERROR AFTER THE RETRIES. [g; g; u] (g as in (2)
# of R4lp): the balance leaves g where it is, the column norm sqrt(2) g overflows, and
# the second attempt, at sc = 2, completes with sigma = sqrt(2) g / 2, which the
# rescale takes past DBL_MAX: NO_CONVERGENCE, out_S untouched, after 2 attempts.
# [measured: attempt-counting scratch build, 2026-10-03; cycc 6.6.14]
_hr_A = _r4lp_m(3, 1);
ganita_mat_set(_hr_A, 0, 0, _r4lp_g); ganita_mat_set(_hr_A, 1, 0, _r4lp_g); ganita_mat_set(_hr_A, 2, 0, 1);
_r4lp_reset(_hr_S, 5);
assert_eq(_r4lp_svd(_hr_A, _r4lp_m(3, 1), _hr_S, _r4lp_m(1, 1)), HSB_ERR_NO_CONVERGENCE,
  "svd [g; g; u]: sigma above DBL_MAX -> NO_CONVERGENCE after the retry");
assert_eq(_r4lp_kept(_hr_S, 1), 1, "svd [g; g; u]: out_S left untouched");

# (4) A FAILURE THAT IS NOT AN OVERFLOW: THE LAST ATTEMPT, AT THE SAME SCALE. This rank-1 4x4,
# A[i][j] = x_i (1 + j) with x spanning 1283 binades, never comes near the overflow
# line. Its first attempt fails because two of its singular values end in a 2x2 block on
# the 2^-1074 grid, [[u, -u], [0, -8u]] beside 6e78, whose deflation threshold
# 1e-12 (|a| + |b|) is 0, so only an exact zero would deflate it: 3.3.3 and 3.3.4
# returned NO_CONVERGENCE here.
# [measured: stalled-bidiagonal dump, debug scratch build, 2026-10-03; cycc 6.6.14]
# ⭐ 3.3.5 — the last attempt, at the same scale, zeroes that block under the normwise
# floor (`_lp_floor_of`) and answers. Against a 1400-digit Decimal Jacobi oracle sigma_1
# is correctly rounded and the other three are noise far below eps sigma_1 (the oracle's
# sigma_2 is 7.4e-162, 6e-381 of sigma_1, from the rounded column 3x; sigma_3 = sigma_4 = 0
# exactly, the columns x, 2x and 4x being exact multiples): right normwise to 0.11 eps
# sigma_1.
# [measured: fixture probe, 3.3.4 vs this tree + Decimal oracle, 2026-10-11; cycc 6.6.14]
_hr_A = _r4lp_m(4, 4);
store64(_gr_x, 0xED43D593E1BFDA40); store64(_gr_x + 8, 0xB703F8585151B32E);
store64(_gr_x + 16, 0xA1C7D1B98BA96007); store64(_gr_x + 24, 0x1D397DBD79B78A2A);
for (var _hr_i = 0; _hr_i < 16; _hr_i = _hr_i + 1) {
    ganita_mat_set(_hr_A, _hr_i / 4, _hr_i % 4, f64_mul(load64(_gr_x + (_hr_i / 4) * 8), f64_from(1 + _hr_i % 4)));
}
_r4lp_reset(_hr_S, 5);
assert_eq(_r4lp_svd(_hr_A, _r4lp_m(4, 4), _hr_S, _r4lp_m(4, 4)), HSB_ERR_NONE,
  "svd rank-1 4x4 across 1283 binades: answered on the last attempt (3.3.4: NO_CONVERGENCE)");
assert_eq(load64(_hr_S), 0x6D6B28C2727B183D, "svd rank-1 4x4 across 1283 binades: sigma_1 correctly rounded");
# sigma_2..4 are noise below the contract, so the contract is what is asserted: each in
# [0, 4 eps sigma_1] (the oracle's are 7.4e-162, 0, 0; this tree's 2^-606 to +0).
var _hr_nb = f64_mul(load64(_hr_S), 0x3CD0000000000000);   # 2^-50 sigma_1 = 4 eps sigma_1
for (var _hr_q = 1; _hr_q < 4; _hr_q = _hr_q + 1) {
    var _hr_sq = load64(_hr_S + _hr_q * 8);
    assert_eq(f64_ge(_hr_sq, 0) + f64_le(_hr_sq, _hr_nb), 2,
      "svd rank-1 4x4 across 1283 binades: sigma_2..4 in [0, 4 eps sigma_1] (normwise contract)");
}

# (5) THE RULE ITSELF, AT ITS BOUNDARY. `_lp_headroom_next` retries while
# (hi / sc) * growth overflows: hi = pred(2^1021) times 8 is DBL_MAX, which fits (0,
# stop); hi = 2^1021 times 8 is 2^1024 = +Inf (next scale, 2 sc).
var _hr_B = _r4lp_m(1, 1);
ganita_mat_set(_hr_B, 0, 0, 0x7FBFFFFFFFFFFFFF);
assert_eq(_lp_headroom_next(_hr_B, F64_ONE, f64_from(8)), 0,
  "_lp_headroom_next: hi * growth = DBL_MAX fits -> 0 (stop)");
ganita_mat_set(_hr_B, 0, 0, 0xFFC0000000000000);
assert_eq(_lp_headroom_next(_hr_B, F64_ONE, f64_from(8)), F64_TWO,
  "_lp_headroom_next: |hi| * growth = 2^1024 overflows -> 2 sc (one binade more)");
ganita_mat_set(_hr_B, 0, 0, 0x7FC0000000000000);
assert_eq(_lp_headroom_next(_hr_B, F64_TWO, f64_from(8)), 0, "_lp_headroom_next: the same hi at sc = 2 fits -> 0");

# (6) A RETRY LIFTS THE TRIDIAGONAL'S ROTATION TOO. This 4x4 tridiagonal, H = A[1][2]
# = -1.4918528e308 between -16u and 24u (u = 2^-1074), fails its first attempt, and
# the retry meets a Givens radius below DBL_MIN. With that rotation lifted on Q but
# not on T, the 3.3.4 retry answered rc = OK with +-1.5368e308, 3.0% high, where the
# eigenvalues are +-|H| to working precision (3.3.3: NO_CONVERGENCE). Lifted on both,
# they come back 1 and 3 ulp below |H|.
# [measured: scratch probes, base vs this tree vs no retry lift + Decimal, 2026-10-03; cycc 6.6.14 and 6.6.3]
_hr_A = _r4lp_m(4, 4);
ganita_mat_set(_hr_A, 0, 1, 0x8000000000000010); ganita_mat_set(_hr_A, 1, 0, 0x8000000000000010);
ganita_mat_set(_hr_A, 1, 2, 0xFFEA8E4CF2992EAF); ganita_mat_set(_hr_A, 2, 1, 0xFFEA8E4CF2992EAF);
ganita_mat_set(_hr_A, 2, 3, 0x0000000000000018); ganita_mat_set(_hr_A, 3, 2, 0x0000000000000018);
_r4lp_reset(_hr_S, 5);
assert_eq(_r4lp_eig(_hr_A, 4, _hr_S, _r4lp_m(4, 4)), HSB_ERR_NONE,
  "eigen_qr 4x4 tridiagonal -16u, H, 24u: answered on a retry (3.3.3: NO_CONVERGENCE)");
assert_eq(load64(_hr_S), 0x7FEA8E4CF2992EAE,
  "eigen_qr 4x4 tridiagonal -16u, H, 24u: lambda_0 = |H|, 1 ulp low (not 3.0% high)");
assert_eq(load64(_hr_S + 8), 0xFFEA8E4CF2992EAC,
  "eigen_qr 4x4 tridiagonal -16u, H, 24u: lambda_1 = -|H|, 3 ulp low in magnitude");

# (7) THE GROWTH CONSTANTS. eigen_qr retries while (max|A| / sc) * 8n overflows and
# svd_golub_kahan while (max|A| / sc) * 4m does; a smaller constant stops the retries
# sooner. [[0, 11u, 0], [11u, 0, H], [0, H, 0]] (H = -1.5651e308) fails at sc = 1 to 16
# and is answered at sc = 32, where 11u / sc rounds to 0, both values 2 ulp low; 4n and
# 2n stopped at sc = 16 and 8, where it is still 1u, and refused it. The 20x1 column,
# entries up to 2^1020 beside subnormals, is answered at 4m = 80 (1 ulp below the
# correctly rounded 0x7FD3EB599DFE2DE5) and was refused at 4n = 4, where its first
# failure was final. The second 3x3, -28u and H = 7.81e307, was refused at 8n: the
# retries stop at sc = 16, and an attempt converges only from sc = 64, where -28u / sc
# rounds to 0.
# [measured: attempt-by-attempt white-box probe + growth-variant builds + Decimal, 2026-10-03; cycc 6.6.14]
# ⭐ 3.3.5 — THE TRIPWIRE FLIPPED, AND THE CONSTANTS NEED OTHER FIXTURES. The last attempt
# (`_lp_floor_of`) answers the second 3x3 at sc = 16, +-H 2 ulp low and the exact 0, and
# under 4n and 2n it answers the first 3x3 at their last scale with the same bits, so the
# first input no longer tells the constants apart. A constant now decides only the last
# scale tried: on the regenerated probes no growth variant moves a refusal; the 4n, 2n and
# 64n eigen variants move the values or vectors of 1,886, 2,532 and 2,298 rows and the 4n
# svd variant of 15, each within 8.0 eps of the largest value on both sides, nearly all of
# it in values below the normwise contract. T3 and B2 below are last-attempt answers whose
# small values are such noise (T3's lambda_3: 25u exactly, 24u here, 25u at 4n and 2n, 32u
# at 64n; B2's sigma_2 and sigma_3: 71.3u and 23.5u, 42u and 40u here), so only the
# contract is asserted for those. The constants show in a meaningful value on two 4x4
# tridiagonals at the end: their eigenvalues +-lambda tie in magnitude, and which sign
# comes back 1 ulp high moves with the last scale (4n and 2n swap it on the first, 64n on
# the second); the 20x1 above still tells 4m from 4n by a refusal.
# [measured: growth-variant probe builds over the regenerated probes + Decimal oracle, 2026-10-11; cycc 6.6.14]
_hr_A = _r4lp_m(3, 3);
ganita_mat_set(_hr_A, 0, 1, 0x000000000000000B); ganita_mat_set(_hr_A, 1, 0, 0x000000000000000B);
ganita_mat_set(_hr_A, 1, 2, 0xFFEBDC3601815C7D); ganita_mat_set(_hr_A, 2, 1, 0xFFEBDC3601815C7D);
_r4lp_reset(_hr_S, 5);
assert_eq(_r4lp_eig(_hr_A, 3, _hr_S, _r4lp_m(3, 3)), HSB_ERR_NONE,
  "eigen_qr 3x3 11u, H: answered at sc = 32 (growth 8n; 4n and 2n refuse it)");
assert_eq(load64(_hr_S), 0x7FEBDC3601815C7B, "eigen_qr 3x3 11u, H: lambda_0 = |H|, 2 ulp low");
assert_eq(load64(_hr_S + 8), 0xFFEBDC3601815C7B, "eigen_qr 3x3 11u, H: lambda_1 = -|H|, 2 ulp low in magnitude");
_hr_A = _r4lp_m(20, 1);
var _hr_col = alloc(20 * 8);
store64(_hr_col, 0x7FBFB1B54327404D); store64(_hr_col + 8, 0x80000D4347B39347);
store64(_hr_col + 16, 0xFDB99719258FC7AD); store64(_hr_col + 24, 0x7FBB724EFF2E2C99);
store64(_hr_col + 32, 0xFF9B912C2FEBF4B9); store64(_hr_col + 40, 0x7FAF9912103ABCB7);
store64(_hr_col + 48, 0xFFBE1B35EF98EDC9); store64(_hr_col + 56, 0xFFBC0C28262AA2AB);
store64(_hr_col + 64, 0x80000153E468DB0B); store64(_hr_col + 72, 0x7FBFDCAC60F7581B);
store64(_hr_col + 80, 0x80000363C22F1A2B); store64(_hr_col + 88, 0x800001484CD79A91);
store64(_hr_col + 96, 0x00000A8F3CA4C3FD); store64(_hr_col + 104, 0);
store64(_hr_col + 112, 0x7FAB1ABD47B3B137); store64(_hr_col + 120, 0x00000678F5BEA8FD);
store64(_hr_col + 128, 0x7F9FEADD048926D9); store64(_hr_col + 136, 0xFFACD96903CCC1F3);
store64(_hr_col + 144, 0xFFBEDFA5DC5B9B4D); store64(_hr_col + 152, 0xFFAA965EA3710A6F);
for (var _hr_k = 0; _hr_k < 20; _hr_k = _hr_k + 1) { ganita_mat_set(_hr_A, _hr_k, 0, load64(_hr_col + _hr_k * 8)); }
_r4lp_reset(_hr_S, 5);
assert_eq(_r4lp_svd(_hr_A, _r4lp_m(20, 1), _hr_S, _r4lp_m(1, 1)), HSB_ERR_NONE,
  "svd 20x1 near 2^1020 beside subnormals: answered (growth 4m = 80; 4n = 4 refuses it)");
assert_eq(load64(_hr_S), 0x7FD3EB599DFE2DE4, "svd 20x1: sigma = 5.595e307, 1 ulp below the correctly rounded DE5");
_hr_A = _r4lp_m(3, 3);
ganita_mat_set(_hr_A, 0, 1, 0x800000000000001C); ganita_mat_set(_hr_A, 1, 0, 0x800000000000001C);
ganita_mat_set(_hr_A, 1, 2, 0x7FDBCF9A358E8C5D); ganita_mat_set(_hr_A, 2, 1, 0x7FDBCF9A358E8C5D);
_r4lp_reset(_hr_S, 5);
assert_eq(_r4lp_eig(_hr_A, 3, _hr_S, _r4lp_m(3, 3)), HSB_ERR_NONE,
  "eigen_qr 3x3 -28u, H: answered on the last attempt at sc = 16 (3.3.4: NO_CONVERGENCE)");
assert_eq(load64(_hr_S), 0x7FDBCF9A358E8C5B, "eigen_qr 3x3 -28u, H: lambda_0 = |H|, 2 ulp low");
assert_eq(load64(_hr_S + 8), 0xFFDBCF9A358E8C5B, "eigen_qr 3x3 -28u, H: lambda_1 = -|H|, 2 ulp low in magnitude");
assert_eq(load64(_hr_S + 16), 0, "eigen_qr 3x3 -28u, H: lambda_2, the exact 0 (det = 0), as +0");
_hr_A = _r4lp_m(3, 3);
ganita_mat_set(_hr_A, 0, 0, 0x19); ganita_mat_set(_hr_A, 0, 1, 0x20); ganita_mat_set(_hr_A, 1, 0, 0x20);
ganita_mat_set(_hr_A, 1, 1, 0x27); ganita_mat_set(_hr_A, 1, 2, 0x7FAF1ED8B9E079EF);
ganita_mat_set(_hr_A, 2, 1, 0x7FAF1ED8B9E079EF); ganita_mat_set(_hr_A, 2, 2, 0x27);
_r4lp_reset(_hr_S, 5);
assert_eq(_r4lp_eig(_hr_A, 3, _hr_S, _r4lp_m(3, 3)), HSB_ERR_NONE, "eigen_qr T3 (grid entries beside H): answered");
assert_eq(load64(_hr_S), 0x7FAF1ED8B9E079ED, "eigen_qr T3: lambda_0 = |H|, 2 ulp low");
assert_eq(load64(_hr_S + 8), 0xFFAF1ED8B9E079ED, "eigen_qr T3: lambda_1 = -|H|, 2 ulp low in magnitude");
_hr_nb = f64_mul(load64(_hr_S), 0x3CD0000000000000);   # 4 eps |lambda|_max
assert_eq(f64_le(f64_abs(load64(_hr_S + 16)), _hr_nb), 1,
  "eigen_qr T3: |lambda_2| <= 4 eps |lambda|_max (normwise contract; exactly 25u)");
_hr_A = _r4lp_m(4, 3);
ganita_mat_set(_hr_A, 0, 0, 0x8000000000000028); ganita_mat_set(_hr_A, 0, 1, 0x8000000000000020);
ganita_mat_set(_hr_A, 1, 0, 0x0E); ganita_mat_set(_hr_A, 1, 1, 0x35); ganita_mat_set(_hr_A, 2, 2, 0x7F7088709300C146);
_r4lp_reset(_hr_S, 5);
assert_eq(_r4lp_svd(_hr_A, _r4lp_m(4, 3), _hr_S, _r4lp_m(3, 3)), HSB_ERR_NONE,
  "svd B2 (2x2 grid block beside H): answered");
assert_eq(load64(_hr_S), 0x7F7088709300C146, "svd B2: sigma_1 = H exactly");
_hr_nb = f64_mul(load64(_hr_S), 0x3CD0000000000000);
assert_eq(f64_ge(load64(_hr_S + 8), 0) + f64_le(load64(_hr_S + 8), _hr_nb), 2,
  "svd B2: sigma_2 in [0, 4 eps sigma_1] (normwise contract; exactly 71.26u)");
assert_eq(f64_ge(load64(_hr_S + 16), 0) + f64_le(load64(_hr_S + 16), _hr_nb), 2,
  "svd B2: sigma_3 in [0, 4 eps sigma_1] (normwise contract; exactly 23.46u)");
# The two 4x4 tridiagonals of the note above: +-lambda tie in magnitude, and the one 1 ulp
# high (above the correctly rounded |lambda|, the other being it) is the last scale's.
_hr_A = _r4lp_m(4, 4);
ganita_mat_set(_hr_A, 0, 1, 0x800000000000000F); ganita_mat_set(_hr_A, 1, 0, 0x800000000000000F);
ganita_mat_set(_hr_A, 1, 2, 0x7FC1F2EB65C85960); ganita_mat_set(_hr_A, 2, 1, 0x7FC1F2EB65C85960);
ganita_mat_set(_hr_A, 2, 2, 0x800000000000002F); ganita_mat_set(_hr_A, 2, 3, 0xFFE490BA01521ECA);
ganita_mat_set(_hr_A, 3, 2, 0xFFE490BA01521ECA); ganita_mat_set(_hr_A, 3, 3, 0x000000000000000B);
_r4lp_reset(_hr_S, 5);
assert_eq(_r4lp_eig(_hr_A, 4, _hr_S, _r4lp_m(4, 4)), HSB_ERR_NONE, "eigen_qr 4x4 tie (growth 8n vs 4n, 2n): answered");
assert_eq(load64(_hr_S), 0x7FE50C979D096ACA, "eigen_qr 4x4 tie: +lambda 1 ulp high at 8n (4n, 2n: -lambda is)");
assert_eq(load64(_hr_S + 8), 0xFFE50C979D096AC9, "eigen_qr 4x4 tie: -lambda correctly rounded at 8n");
_hr_A = _r4lp_m(4, 4);
ganita_mat_set(_hr_A, 0, 0, 0x000000000000002B); ganita_mat_set(_hr_A, 0, 1, 0x800000000000003E);
ganita_mat_set(_hr_A, 1, 0, 0x800000000000003E); ganita_mat_set(_hr_A, 1, 1, 0x8000000000000013);
ganita_mat_set(_hr_A, 1, 2, 0xFFB774BF86FF4174); ganita_mat_set(_hr_A, 2, 1, 0xFFB774BF86FF4174);
ganita_mat_set(_hr_A, 2, 2, 0x800000000000000A); ganita_mat_set(_hr_A, 2, 3, 0x7F9E11381AB52479);
ganita_mat_set(_hr_A, 3, 2, 0x7F9E11381AB52479); ganita_mat_set(_hr_A, 3, 3, 0x000000000000001C);
_r4lp_reset(_hr_S, 5);
assert_eq(_r4lp_eig(_hr_A, 4, _hr_S, _r4lp_m(4, 4)), HSB_ERR_NONE, "eigen_qr 4x4 tie (growth 8n vs 64n): answered");
assert_eq(load64(_hr_S), 0x7FB8A18C91152F95, "eigen_qr 4x4 tie (64n): +lambda 1 ulp high at 8n (64n: -lambda is)");
assert_eq(load64(_hr_S + 8), 0xFFB8A18C91152F94, "eigen_qr 4x4 tie (64n): -lambda correctly rounded at 8n");

# === 3.3.5 L: the last attempt's normwise floor ===
# (1) A ROTATION THAT UNDERFLOWS. [[0, a, 0], [a, b, H], [0, H, 0]], a = 5.995e-281,
# b = 1.877e-282, H = 5.706e296, balanced by 2^86. The Wilkinson shift is about +-H, so
# the chase's first rotation is (H, a) and its sine a / H, about 2^-1916 in balanced units,
# rounds to 0: every sweep is the identity, and a is not negligible beside its neighbours
# 0 and b, so 3.3.4 returned NO_CONVERGENCE at every scale. a is below DBL_MIN times the
# largest entry, so the last attempt zeroes it. Oracle (800-digit Decimal Jacobi): ±H
# correctly rounded (0x7D8BEBA4E75F48BD) and 0 exactly (det = 0); this tree returns ±H
# 2 ulp high and +0. With DBL_MIN as an absolute floor this input stays refused.
# [measured: probe row S1/571 + floor-variant builds, 3.3.4 vs this tree + Decimal oracle, 2026-10-11; cycc 6.6.14]
_hr_A = _r4lp_m(3, 3);
ganita_mat_set(_hr_A, 0, 1, 0x05C1697E15FBB42E); ganita_mat_set(_hr_A, 1, 0, 0x05C1697E15FBB42E);
ganita_mat_set(_hr_A, 1, 1, 0x05717132E5EAEBB2);
ganita_mat_set(_hr_A, 1, 2, 0x7D8BEBA4E75F48BD); ganita_mat_set(_hr_A, 2, 1, 0x7D8BEBA4E75F48BD);
_r4lp_reset(_hr_S, 5);
assert_eq(_r4lp_eig(_hr_A, 3, _hr_S, _r4lp_m(3, 3)), HSB_ERR_NONE,
  "eigen_qr [[0,a,0],[a,b,H],[0,H,0]], a/H below 2^-1074: answered (3.3.4: NO_CONVERGENCE)");
assert_eq(load64(_hr_S), 0x7D8BEBA4E75F48BF, "eigen_qr [[0,a,0],[a,b,H],[0,H,0]]: lambda_0 = H, 2 ulp high");
assert_eq(load64(_hr_S + 8), 0xFD8BEBA4E75F48BF, "eigen_qr [[0,a,0],[a,b,H],[0,H,0]]: lambda_1 = -H, 2 ulp high");
assert_eq(load64(_hr_S + 16), 0, "eigen_qr [[0,a,0],[a,b,H],[0,H,0]]: lambda_2, the exact 0, as +0");
# (2) THE FLOOR ITSELF. `_lp_floor_of` is DBL_MIN times the largest |d_i| and |f_k| in
# range (here f_0 = -X, X = 0x5049F2C9E4E5C7A3, so X * 2^-1022 exactly, the exponent field
# less 1022); f_1 = 9X lies outside the range [0, 1) and is not read. `_lp_floor_zero`
# zeroes |x| < fl: fl itself stays (the boundary), pred(fl) and -pred(fl) go, -2 fl stays
# (by magnitude, not by sign), a NaN stays.
var _fl_d = alloc(2 * 8);
var _fl_f = alloc(2 * 8);
store64(_fl_d, f64_from(3)); store64(_fl_d + 8, 0x8000000000000005);
store64(_fl_f, 0xD049F2C9E4E5C7A3); store64(_fl_f + 8, f64_mul(f64_from(9), 0x5049F2C9E4E5C7A3));
var _fl = _lp_floor_of(_fl_d, 2, _fl_f, 0, 1);
assert_eq(_fl, 0x5049F2C9E4E5C7A3 - (1022 << 52), "_lp_floor_of: DBL_MIN * max |entry| in range, exactly");
var _fl_a = alloc(5 * 8);
store64(_fl_a, _fl); store64(_fl_a + 8, _fl - 1); store64(_fl_a + 16, (_fl - 1) | 0x8000000000000000);
store64(_fl_a + 24, f64_neg(f64_mul(F64_TWO, _fl))); store64(_fl_a + 32, _AB_NAN);
_lp_floor_zero(_fl_a, 0, 5, _fl);
assert_eq(load64(_fl_a), _fl, "_lp_floor_zero: an entry equal to the floor stays");
assert_eq(load64(_fl_a + 8), 0, "_lp_floor_zero: pred(floor) is zeroed");
assert_eq(load64(_fl_a + 16), 0, "_lp_floor_zero: -pred(floor) is zeroed");
assert_eq(load64(_fl_a + 24), f64_neg(f64_mul(F64_TWO, _fl)), "_lp_floor_zero: -2 floor stays (magnitude, not sign)");
assert_eq(load64(_fl_a + 32), _AB_NAN, "_lp_floor_zero: a NaN stays");

# eigen_qr validates the SAME four things svd_golub_kahan does (since 2.9.0); the
# register entries below this line are the ones that used to exit 139.
# [measured: CHANGELOG.md 2.9.0, the crash tier, eigen_qr (four reproducers "all exited 139")]
#
# ab_A33 is diag(2, 3, 4) -- a matrix that CONVERGES. That matters: the register's
# original reproducer for the null-out_vals case used mat_new(3, 3), an all-zero
# matrix, which returns early from the tridiagonal QR before it ever writes to
# out_vals and so exits 0 rather than 139. The register line has been corrected.
# [measured: CHANGELOG.md 2.9.0, the register discharge: two reproducers wrong as written (the eigen_qr one)]
var _rq45t, _rq45v = eigen_qr(ab_A33, 0, 50, ab_S3, ganita_mat_new(3, 3));
assert_eq(is_err_result(_rq45t), 1, "eigen_qr: n = 0 -> HSB_ERR_INVALID_INPUT");
assert_eq(_rq45v, HSB_ERR_INVALID_INPUT, "eigen_qr: n = 0 -> HSB_ERR_INVALID_INPUT");
var _rq46t, _rq46v = eigen_qr(ab_A33, (0 - 3), 50, ab_S3, ganita_mat_new(3, 3));
assert_eq(is_err_result(_rq46t), 1, "eigen_qr: n = -3 -> HSB_ERR_INVALID_INPUT (was exit 139)");
assert_eq(_rq46v, HSB_ERR_INVALID_INPUT, "eigen_qr: n = -3 -> HSB_ERR_INVALID_INPUT (was exit 139)");
var _rq47t, _rq47v = eigen_qr(0, 3, 50, ab_S3, ganita_mat_new(3, 3));
assert_eq(is_err_result(_rq47t), 1, "eigen_qr: A = 0 -> HSB_ERR_INVALID_INPUT (was exit 139)");
assert_eq(_rq47v, HSB_ERR_INVALID_INPUT, "eigen_qr: A = 0 -> HSB_ERR_INVALID_INPUT (was exit 139)");
var _rq48t, _rq48v = eigen_qr(ab_A33, 3, 50, 0, ganita_mat_new(3, 3));
assert_eq(is_err_result(_rq48t), 1, "eigen_qr: out_vals = 0 -> HSB_ERR_INVALID_INPUT (was exit 139 on a converging A)");
assert_eq(_rq48v, HSB_ERR_INVALID_INPUT,
  "eigen_qr: out_vals = 0 -> HSB_ERR_INVALID_INPUT (was exit 139 on a converging A)");
var _rq49t, _rq49v = eigen_qr(ab_A33, 3, 50, ab_S3, 0);
assert_eq(is_err_result(_rq49t), 1, "eigen_qr: out_vecs = 0 -> HSB_ERR_INVALID_INPUT (was exit 139)");
assert_eq(_rq49v, HSB_ERR_INVALID_INPUT, "eigen_qr: out_vecs = 0 -> HSB_ERR_INVALID_INPUT (was exit 139)");
var _rq50t, _rq50v = eigen_qr(mat_new_guarded(1000000, 1000000), 3, 50, ab_S3, ganita_mat_new(3, 3));
assert_eq(is_err_result(_rq50t), 1, "eigen_qr: capped mat_new_guarded 0 flows through");
assert_eq(_rq50v, HSB_ERR_INVALID_INPUT, "eigen_qr: capped mat_new_guarded 0 flows through");
var _rq51t, _rq51v = eigen_qr(ab_A33, 1000000000, 50, ab_S3, ganita_mat_new(3, 3));
assert_eq(is_err_result(_rq51t), 1, "eigen_qr: n = 1e9 against a 3x3 A -> HSB_ERR_INVALID_INPUT");
assert_eq(_rq51v, HSB_ERR_INVALID_INPUT, "eigen_qr: n = 1e9 against a 3x3 A -> HSB_ERR_INVALID_INPUT");
var _rq52t, _rq52v = eigen_qr(ab_A33, 3, 50, ab_S3, ganita_mat_new(2, 2));
assert_eq(is_err_result(_rq52t), 1, "eigen_qr: out_vecs 2x2 too small for n = 3 -> HSB_ERR_INVALID_INPUT");
assert_eq(_rq52v, HSB_ERR_INVALID_INPUT, "eigen_qr: out_vecs 2x2 too small for n = 3 -> HSB_ERR_INVALID_INPUT");

# TIGHTENED, NOT WEAKENED (2.9.0). This case previously asserted
# HSB_ERR_NO_CONVERGENCE with the note "not a wild read" -- true, since n = 3
# indexes inside a 3x4. eigen_qr now rejects any A whose extent is not exactly
# n x n, so the expected value moves from -8 to -10, a STRICTER outcome on an
# unchanged fixture.
#
# CORRECTION, and it matters more than the change it corrects. This comment
# previously justified the move by asserting that "at max_iter = 10000 the same
# call returns HSB_ERR_NONE carrying the spectrum of the leading 3x3 block."
# THAT MEASUREMENT IS FALSE and was removed on 2026-08-05 by the verifying pass
# that reproduced it. `ab_A34` is mat_new(3, 4) and is never written to, so its
# leading 3x3 block is the ZERO matrix; replayed byte-exactly against the
# pre-fix source it returns -8 at every budget tried -- 50, 1000, 10000,
# 100000, 1000000, 10000000. There was no silent-wrong-answer path, and the
# claim that there was is exactly the defect class this repo treats as
# cardinal: a stated measurement that does not reproduce.
# [measured: scratch replay against the pre-fix source, not reproducible in-tree, 2026-08-05]
#
# The change stands on the argument that survives: n is a restatement of A's
# extent, so a 3x4 given n = 3 is a shape eigen_qr cannot answer for, and
# rejecting it outright is a better contract than a convergence failure that
# happens to fall out. Not on a number nobody checked.
var _rq53t, _rq53v = eigen_qr(ab_A34, 3, 50, ab_S3, ganita_mat_new(3, 3));
assert_eq(is_err_result(_rq53t), 1,
  "eigen_qr: non-square 3x4 -> HSB_ERR_INVALID_INPUT (was NO_CONVERGENCE at max_iter 50)");
assert_eq(_rq53v, HSB_ERR_INVALID_INPUT,
  "eigen_qr: non-square 3x4 -> HSB_ERR_INVALID_INPUT (was NO_CONVERGENCE at max_iter 50)");
var _rq54t, _rq54v = eigen_qr(ab_A34, 3, 10000, ab_S3, ganita_mat_new(3, 3));
assert_eq(is_err_result(_rq54t), 1, "eigen_qr: non-square 3x4 stays rejected at max_iter 10000 (budget-independent)");
assert_eq(_rq54v, HSB_ERR_INVALID_INPUT,
  "eigen_qr: non-square 3x4 stays rejected at max_iter 10000 (budget-independent)");

var _rq55t, _rq55v = eigen_qr(ab_A33, 3, 0, ab_S3, ganita_mat_new(3, 3));
assert_eq(is_err_result(_rq55t), 1, "eigen_qr: max_iter = 0 -> no-convergence");
assert_eq(_rq55v, HSB_ERR_NO_CONVERGENCE, "eigen_qr: max_iter = 0 -> no-convergence");
var _rq56t, _rq56v = eigen_qr(ab_A33, 3, (0 - 5), ab_S3, ganita_mat_new(3, 3));
assert_eq(is_err_result(_rq56t), 1, "eigen_qr: max_iter = -5 -> no-convergence");
assert_eq(_rq56v, HSB_ERR_NO_CONVERGENCE, "eigen_qr: max_iter = -5 -> no-convergence");

# eigen_qr still WORKS on the shape it documents -- the guards reject callers,
# not the routine's own job. diag(2, 3, 4) has eigenvalues 4, 3, 2 in eigen_qr's
# descending-magnitude order.
var ab_eqv = alloc(3 * 8);
var _rq57t, _rq57v = eigen_qr(ab_A33, 3, 1000, ab_eqv, ganita_mat_new(3, 3));
assert_eq(is_ok(_rq57t), 1, "eigen_qr: diag(2,3,4) still decomposes after the guards");
assert_eq(load64(ab_eqv), f64_from(4), "eigen_qr: diag(2,3,4) lambda0 == 4");
assert_eq(load64(ab_eqv + 8), f64_from(3), "eigen_qr: diag(2,3,4) lambda1 == 3");
assert_eq(load64(ab_eqv + 16), F64_TWO, "eigen_qr: diag(2,3,4) lambda2 == 2");

test_group("3.3.6 abuse: eigen_qr at the overflow line");

# (1) AN OVERFLOWED DIAGONAL IS RETRIED. [[a, b, 0], [b, 0, 46u], [0, 46u, 0]]: the first
# attempt (balanced by 1/4) deflated with +Inf on the diagonal, and 3.3.5 refused it at the
# rescale. Retried with headroom it answers; oracle (800-digit Decimal Jacobi):
# 0x7FD04704C3F153EE and 0xFFAA8142BDBBFBCA correctly rounded, the third ~1e-952, +0.
# [measured: sparse-tridiagonal probe row T/2757, 3.3.5 vs this tree + Decimal oracle, 2026-10-11; cycc 6.6.14]
var _ol_S = alloc(4 * 8);
var _ol_A = _r4lp_m(3, 3);
ganita_mat_set(_ol_A, 0, 0, 0x7FC9EDB8D873A8E9); ganita_mat_set(_ol_A, 0, 1, 0xFFBD5FE19F6C5892);
ganita_mat_set(_ol_A, 1, 0, 0xFFBD5FE19F6C5892); ganita_mat_set(_ol_A, 1, 2, 0x2E); ganita_mat_set(_ol_A, 2, 1, 0x2E);
_r4lp_reset(_ol_S, 4);
assert_eq(_r4lp_eig(_ol_A, 3, _ol_S, _r4lp_m(3, 3)), HSB_ERR_NONE,
  "eigen_qr: an attempt with +Inf on the diagonal is retried and answers (3.3.5: NO_CONVERGENCE)");
assert_eq(load64(_ol_S), 0x7FD04704C3F153EE, "eigen_qr overflowed-diagonal retry: lambda_0 correctly rounded");
assert_eq(load64(_ol_S + 8), 0xFFAA8142BDBBFBC8, "eigen_qr overflowed-diagonal retry: lambda_1 2 ulp low in magnitude");
assert_eq(load64(_ol_S + 16), 0, "eigen_qr overflowed-diagonal retry: lambda_2 = +0");

# (2) AN EIGENVALUE FINITE ONLY BY ROUNDING IS REFUSED. h = 2^1023: [[h, h, 0], [h, h, 0],
# [0, 0, u]] and [[h, h], [h, h]] have the eigenvalue 2^1024, past the line 2^1024 - 2^970;
# 3.3.5 returned Ok 0x7FEFFFFFFFFFFFFE for both (and -h gave its negative).
var _ol_h = 0x7FE0000000000000;
_ol_A = _r4lp_m(3, 3);
ganita_mat_set(_ol_A, 0, 0, _ol_h); ganita_mat_set(_ol_A, 0, 1, _ol_h);
ganita_mat_set(_ol_A, 1, 0, _ol_h); ganita_mat_set(_ol_A, 1, 1, _ol_h); ganita_mat_set(_ol_A, 2, 2, 1);
_r4lp_reset(_ol_S, 4);
assert_eq(_r4lp_eig(_ol_A, 3, _ol_S, _r4lp_m(3, 3)), HSB_ERR_NO_CONVERGENCE,
  "eigen_qr [[h,h,0],[h,h,0],[0,0,u]]: lambda = 2^1024 -> NO_CONVERGENCE (3.3.5: Ok 0x7FEFFFFFFFFFFFFE)");
assert_eq(_r4lp_kept(_ol_S, 3), 1, "eigen_qr [[h,h,0],[h,h,0],[0,0,u]]: out_vals untouched");
_ol_A = _r4lp_m(2, 2);
ganita_mat_set(_ol_A, 0, 0, _ol_h); ganita_mat_set(_ol_A, 0, 1, _ol_h);
ganita_mat_set(_ol_A, 1, 0, _ol_h); ganita_mat_set(_ol_A, 1, 1, _ol_h);
assert_eq(_r4lp_eig(_ol_A, 2, _ol_S, _r4lp_m(2, 2)), HSB_ERR_NO_CONVERGENCE, "eigen_qr [[h,h],[h,h]]: NO_CONVERGENCE");
_ol_A = _r4lp_m(2, 2);
ganita_mat_set(_ol_A, 0, 0, f64_neg(_ol_h)); ganita_mat_set(_ol_A, 0, 1, f64_neg(_ol_h));
ganita_mat_set(_ol_A, 1, 0, f64_neg(_ol_h)); ganita_mat_set(_ol_A, 1, 1, f64_neg(_ol_h));
assert_eq(_r4lp_eig(_ol_A, 2, _ol_S, _r4lp_m(2, 2)), HSB_ERR_NO_CONVERGENCE,
  "eigen_qr [[-h,-h],[-h,-h]]: lambda = -2^1024 -> NO_CONVERGENCE");
# On the finite side of the line nothing changes: [[a, h], [h, a]], a = 2^1023 - 2^971, has
# the eigenvalue DBL_MAX exactly, and diag(DBL_MAX, -DBL_MAX, u) two of them; both are
# checked (within 2^-40 of the line) and both answer, as on 3.3.5.
_ol_A = _r4lp_m(2, 2);
ganita_mat_set(_ol_A, 0, 0, 0x7FDFFFFFFFFFFFFE); ganita_mat_set(_ol_A, 0, 1, _ol_h);
ganita_mat_set(_ol_A, 1, 0, _ol_h); ganita_mat_set(_ol_A, 1, 1, 0x7FDFFFFFFFFFFFFE);
_r4lp_reset(_ol_S, 4);
assert_eq(_r4lp_eig(_ol_A, 2, _ol_S, _r4lp_m(2, 2)), HSB_ERR_NONE, "eigen_qr: eigenvalue DBL_MAX exactly answers");
assert_eq(load64(_ol_S), 0x7FEFFFFFFFFFFFFD, "eigen_qr: eigenvalue DBL_MAX exactly: 2 ulp low, as on 3.3.5");
assert_eq(load64(_ol_S + 8), 0xFCA0000000000000, "eigen_qr: eigenvalue DBL_MAX exactly: the other, -2^971 exactly");
_ol_A = _r4lp_m(3, 3);
ganita_mat_set(_ol_A, 0, 0, 0x7FEFFFFFFFFFFFFF); ganita_mat_set(_ol_A, 1, 1, 0xFFEFFFFFFFFFFFFF);
ganita_mat_set(_ol_A, 2, 2, 1);
_r4lp_reset(_ol_S, 4);
assert_eq(_r4lp_eig(_ol_A, 3, _ol_S, _r4lp_m(3, 3)), HSB_ERR_NONE, "eigen_qr diag(DBL_MAX, -DBL_MAX, u): answers");
assert_eq(load64(_ol_S), 0x7FEFFFFFFFFFFFFF, "eigen_qr diag(DBL_MAX, -DBL_MAX, u): lambda_0 = DBL_MAX exactly");
assert_eq(load64(_ol_S + 8), 0xFFEFFFFFFFFFFFFF, "eigen_qr diag(DBL_MAX, -DBL_MAX, u): lambda_1 = -DBL_MAX exactly");
# Inside the line by 2^-55.7 relative: [[p, q], [q, r]] below has lambda_0 = -1.7976931348623157081e308
# (oracle; correctly rounded -DBL_MAX) and lambda_1 rounding to 0x7FE6E0C639878A0C. Its quotient has to
# be formed in double-double: with plain products the check refuses it (6 such of the 6,000 near-line
# matrices).
# [measured: near-line sweep row E/52, plain-product variant + 800-digit Decimal oracle, 2026-10-11; cycc 6.6.14]
_ol_A = _r4lp_m(2, 2);
ganita_mat_set(_ol_A, 0, 0, 0xFFE5F7DBCEAEC212); ganita_mat_set(_ol_A, 0, 1, 0x7FE535E827DA5ECF);
ganita_mat_set(_ol_A, 1, 0, 0x7FE535E827DA5ECF); ganita_mat_set(_ol_A, 1, 1, 0x7FD9B144106C983D);
_r4lp_reset(_ol_S, 4);
assert_eq(_r4lp_eig(_ol_A, 2, _ol_S, _r4lp_m(2, 2)), HSB_ERR_NONE,
  "eigen_qr: an eigenvalue 2^-55.7 inside the line answers");
assert_eq(load64(_ol_S), 0xFFEFFFFFFFFFFFFE, "eigen_qr: 2^-55.7 inside the line: lambda_0 1 ulp low in magnitude");
assert_eq(load64(_ol_S + 8), 0x7FE6E0C639878A0B, "eigen_qr: 2^-55.7 inside the line: lambda_1 1 ulp low");
# The eigenvector's own norm v_i * v_j has to be double-double too: [[p, q], [q, r]] below has
# lambda = -1.7976931348623157512e308, inside the line by 2^-54.8, and with the low part of
# v_i * v_j dropped the check refuses it (54 such on the review's near-line sets).
# [measured: lane B review (3.3.6), near-line sets with dropped-tl variant + Decimal oracle, 2026-10-11; cycc 6.6.14]
_ol_A = _r4lp_m(2, 2);
ganita_mat_set(_ol_A, 0, 0, 0xFFDFFFFFFFFE03E9); ganita_mat_set(_ol_A, 0, 1, 0x7FEBB67AE857AFD1);
ganita_mat_set(_ol_A, 1, 0, 0x7FEBB67AE857AFD1); ganita_mat_set(_ol_A, 1, 1, 0x7FDFFFFFFFF5CD12);
_r4lp_reset(_ol_S, 4);
assert_eq(_r4lp_eig(_ol_A, 2, _ol_S, _r4lp_m(2, 2)), HSB_ERR_NONE,
  "eigen_qr: an eigenvalue 2^-54.8 inside the line answers (v_i * v_j in double-double)");
assert_eq(load64(_ol_S), 0xFFEFFFFFFFFFFFFF, "eigen_qr: 2^-54.8 inside the line: lambda_0 = -DBL_MAX, as on 3.3.5");
# ⚠ ON THE LINE ITSELF THE CHECK CANNOT DECIDE. [[a', h], [h, a']], a' = 2^1023 - 2^970, has
# the eigenvalue 2^1024 - 2^970 exactly, which rounds to +Inf (ties to even); its Rayleigh
# quotient lands within the evaluation bound of the line, so 3.3.5's finite answer stands.
# A tripwire: it moves if the check learns to decide ties.
_ol_A = _r4lp_m(2, 2);
ganita_mat_set(_ol_A, 0, 0, 0x7FDFFFFFFFFFFFFF); ganita_mat_set(_ol_A, 0, 1, _ol_h);
ganita_mat_set(_ol_A, 1, 0, _ol_h); ganita_mat_set(_ol_A, 1, 1, 0x7FDFFFFFFFFFFFFF);
_r4lp_reset(_ol_S, 4);
assert_eq(_r4lp_eig(_ol_A, 2, _ol_S, _r4lp_m(2, 2)), HSB_ERR_NONE,
  "eigen_qr: eigenvalue exactly on the line (tripwire): Ok");
assert_eq(load64(_ol_S), 0x7FEFFFFFFFFFFFFE, "eigen_qr: eigenvalue exactly on the line (tripwire): 3.3.5's bits");

test_group("3.3.7 abuse: svd_golub_kahan at the overflow line, as eigen_qr");

# A SINGULAR VALUE FINITE ONLY BY ROUNDING IS REFUSED, as eigen_qr's eigenvalue above. With
# h = 2^1023, [[h, h], [h, h]] (and -h) and [[h, h, 0], [h, h, 0], [0, 0, 1]] have sigma_1 =
# 2^1024, past the line 2^1024 - 2^970; 3.3.6 returned Ok (DBL_MAX, 0) and (DBL_MAX, 1, 0).
var _sl_S = alloc(4 * 8);
var _sl_A = _r4lp_m(2, 2);
ganita_mat_set(_sl_A, 0, 0, _ol_h); ganita_mat_set(_sl_A, 0, 1, _ol_h);
ganita_mat_set(_sl_A, 1, 0, _ol_h); ganita_mat_set(_sl_A, 1, 1, _ol_h);
_r4lp_reset(_sl_S, 4);
assert_eq(_r4lp_svd(_sl_A, _r4lp_m(2, 2), _sl_S, _r4lp_m(2, 2)), HSB_ERR_NO_CONVERGENCE,
  "svd_golub_kahan [[h,h],[h,h]]: sigma = 2^1024 -> NO_CONVERGENCE (3.3.6: Ok DBL_MAX)");
assert_eq(_r4lp_kept(_sl_S, 2), 1, "svd_golub_kahan [[h,h],[h,h]]: out_S untouched");
_sl_A = _r4lp_m(2, 2);
ganita_mat_set(_sl_A, 0, 0, f64_neg(_ol_h)); ganita_mat_set(_sl_A, 0, 1, f64_neg(_ol_h));
ganita_mat_set(_sl_A, 1, 0, f64_neg(_ol_h)); ganita_mat_set(_sl_A, 1, 1, f64_neg(_ol_h));
assert_eq(_r4lp_svd(_sl_A, _r4lp_m(2, 2), _sl_S, _r4lp_m(2, 2)), HSB_ERR_NO_CONVERGENCE,
  "svd_golub_kahan [[-h,-h],[-h,-h]]: sigma = 2^1024 -> NO_CONVERGENCE");
_sl_A = _r4lp_m(3, 3);
_r4lp_reset(_sl_S, 4);
ganita_mat_set(_sl_A, 0, 0, _ol_h); ganita_mat_set(_sl_A, 0, 1, _ol_h);
ganita_mat_set(_sl_A, 1, 0, _ol_h); ganita_mat_set(_sl_A, 1, 1, _ol_h); ganita_mat_set(_sl_A, 2, 2, F64_ONE);
assert_eq(_r4lp_svd(_sl_A, _r4lp_m(3, 3), _sl_S, _r4lp_m(3, 3)), HSB_ERR_NO_CONVERGENCE,
  "svd_golub_kahan [[h,h,0],[h,h,0],[0,0,1]]: NO_CONVERGENCE (3.3.6: Ok (DBL_MAX, 1, 0))");
assert_eq(_r4lp_kept(_sl_S, 3), 1, "svd_golub_kahan [[h,h,0],[h,h,0],[0,0,1]]: out_S untouched");
# h = 2^1022 fits (sigma_1 = 2^1023) and answers as before, 1 ulp low; never examined.
# [measured: overflow-line probe, 3.3.6 base vs this tree, 2026-10-31; cycc 6.6.20]
_sl_A = _r4lp_m(2, 2);
ganita_mat_set(_sl_A, 0, 0, 0x7FD0000000000000); ganita_mat_set(_sl_A, 0, 1, 0x7FD0000000000000);
ganita_mat_set(_sl_A, 1, 0, 0x7FD0000000000000); ganita_mat_set(_sl_A, 1, 1, 0x7FD0000000000000);
assert_eq(_r4lp_svd(_sl_A, _r4lp_m(2, 2), _sl_S, _r4lp_m(2, 2)), HSB_ERR_NONE,
  "svd_golub_kahan [[h/2,h/2],[h/2,h/2]]: sigma = 2^1023 answers");
assert_eq(load64(_sl_S), 0x7FDFFFFFFFFFFFFF, "svd_golub_kahan [[h/2,h/2],[h/2,h/2]]: sigma_0 1 ulp low, as on 3.3.6");
assert_eq(load64(_sl_S + 8), 0, "svd_golub_kahan [[h/2,h/2],[h/2,h/2]]: sigma_1 = +0");
# On the finite side nothing changes. [[a, h], [h, a]], a = 2^1023 - 2^971, has sigma_1 =
# DBL_MAX exactly; it is examined (within 2^-40 of the line) and answers, 1 ulp low as on 3.3.6.
# [measured: overflow-line probe, 3.3.6 base vs this tree, 2026-10-31; cycc 6.6.20]
_sl_A = _r4lp_m(2, 2);
ganita_mat_set(_sl_A, 0, 0, 0x7FDFFFFFFFFFFFFE); ganita_mat_set(_sl_A, 0, 1, _ol_h);
ganita_mat_set(_sl_A, 1, 0, _ol_h); ganita_mat_set(_sl_A, 1, 1, 0x7FDFFFFFFFFFFFFE);
_r4lp_reset(_sl_S, 4);
assert_eq(_r4lp_svd(_sl_A, _r4lp_m(2, 2), _sl_S, _r4lp_m(2, 2)), HSB_ERR_NONE,
  "svd_golub_kahan: sigma_1 = DBL_MAX exactly answers");
assert_eq(load64(_sl_S), 0x7FEFFFFFFFFFFFFE, "svd_golub_kahan: sigma_1 = DBL_MAX exactly: 1 ulp low, as on 3.3.6");
# Two rows of the near-line sweep, whose verdicts need the quotient in double-double. The
# first has sigma_1 inside the line by 2^-56.5 relative (oracle: DBL_MAX and
# 0x7FC8ED373A61AE42 correctly rounded); with u_i v_j or the denominator in plain doubles,
# the quotient's low part dropped or the denominator's left out of it, the check refuses it.
# The second is past the line by 2^-54.95 (3.3.6: Ok 0x7FEFFFFFFFFFFFFE); with the numerator
# or the denominator in plain doubles, the quotient's low part dropped or the denominator's
# left out of it, or the line taken as 2^1024, the check answers it.
# [measured: near-line svd sweep rows 878 and 1229, check variants + 200-digit Decimal oracle, 2026-10-31; cycc 6.6.20]
_sl_A = _r4lp_m(2, 2);
ganita_mat_set(_sl_A, 0, 0, 0x7FDC147A7A709A03); ganita_mat_set(_sl_A, 0, 1, 0xFFD564497178D874);
ganita_mat_set(_sl_A, 1, 0, 0xFFDA0991387D9339); ganita_mat_set(_sl_A, 1, 1, 0x7FE81EFBE4690A74);
_r4lp_reset(_sl_S, 4);
assert_eq(_r4lp_svd(_sl_A, _r4lp_m(2, 2), _sl_S, _r4lp_m(2, 2)), HSB_ERR_NONE,
  "svd_golub_kahan: sigma_1 2^-56.5 inside the line answers");
assert_eq(load64(_sl_S), 0x7FEFFFFFFFFFFFFF, "svd_golub_kahan: 2^-56.5 inside the line: sigma_0 correctly rounded");
assert_eq(load64(_sl_S + 8), 0x7FC8ED373A61AE43, "svd_golub_kahan: 2^-56.5 inside the line: sigma_1 1 ulp high");
_sl_A = _r4lp_m(2, 2);
ganita_mat_set(_sl_A, 0, 0, 0xFFE6FDC61236A02F); ganita_mat_set(_sl_A, 0, 1, 0x7FDCBBF0AB9CBEFE);
ganita_mat_set(_sl_A, 1, 0, 0x7FDCD52C9840C37E); ganita_mat_set(_sl_A, 1, 1, 0xFFD2046EE28CA4D6);
_r4lp_reset(_sl_S, 4);
assert_eq(_r4lp_svd(_sl_A, _r4lp_m(2, 2), _sl_S, _r4lp_m(2, 2)), HSB_ERR_NO_CONVERGENCE,
  "svd_golub_kahan: sigma_1 2^-54.95 past the line -> NO_CONVERGENCE (3.3.6: Ok 0x7FEFFFFFFFFFFFFE)");
assert_eq(_r4lp_kept(_sl_S, 2), 1, "svd_golub_kahan: 2^-54.95 past the line: out_S untouched");
# A 3x3 past the line by 2^-60.1 (3.3.6: Ok): v'v has to come from the row of Vt, which for a
# 2x2 Vt holds the same magnitudes as its column, so only n >= 3 tells them apart.
# [measured: near-line svd sweep row 74, column-read variant + 250-digit Decimal oracle, 2026-10-31; cycc 6.6.20]
_sl_A = _r4lp_m(3, 3);
ganita_mat_set(_sl_A, 0, 0, 0xFFD9F1F9334B83B8); ganita_mat_set(_sl_A, 0, 1, 0xFFD0D1F48B0482C5);
ganita_mat_set(_sl_A, 0, 2, 0xFFD80CF08A297F0B); ganita_mat_set(_sl_A, 1, 0, 0xFFCF0E32725F6EA2);
ganita_mat_set(_sl_A, 1, 1, 0xFFDAB5E5DCB57403); ganita_mat_set(_sl_A, 1, 2, 0x7FDA14EE70EBC76A);
ganita_mat_set(_sl_A, 2, 0, 0x7FDB3A0CEC0CA803); ganita_mat_set(_sl_A, 2, 1, 0xFFE95469A20FEDA1);
ganita_mat_set(_sl_A, 2, 2, 0xFFD71C96F714C9E1);
_r4lp_reset(_sl_S, 4);
assert_eq(_r4lp_svd(_sl_A, _r4lp_m(3, 3), _sl_S, _r4lp_m(3, 3)), HSB_ERR_NO_CONVERGENCE,
  "svd_golub_kahan: a 3x3 2^-60.1 past the line -> NO_CONVERGENCE");
assert_eq(_r4lp_kept(_sl_S, 3), 1, "svd_golub_kahan: a 3x3 2^-60.1 past the line: out_S untouched");
# ⚠ ON THE LINE ITSELF THE CHECK CANNOT DECIDE, as eigen_qr's. [[a', h], [h, a']], a' =
# 2^1023 - 2^970, has sigma_1 = 2^1024 - 2^970 exactly, which rounds to +Inf (ties to even);
# the quotient of the computed pair does not pass the line, so the finite answer stands.
# A tripwire: it moves if the check learns to decide ties.
_sl_A = _r4lp_m(2, 2);
ganita_mat_set(_sl_A, 0, 0, 0x7FDFFFFFFFFFFFFF); ganita_mat_set(_sl_A, 0, 1, _ol_h);
ganita_mat_set(_sl_A, 1, 0, _ol_h); ganita_mat_set(_sl_A, 1, 1, 0x7FDFFFFFFFFFFFFF);
_r4lp_reset(_sl_S, 4);
assert_eq(_r4lp_svd(_sl_A, _r4lp_m(2, 2), _sl_S, _r4lp_m(2, 2)), HSB_ERR_NONE,
  "svd_golub_kahan: sigma_1 exactly on the line (tripwire): Ok");
assert_eq(load64(_sl_S), 0x7FEFFFFFFFFFFFFF, "svd_golub_kahan: sigma_1 exactly on the line (tripwire): 3.3.6's bits");

test_group("3.3.5 abuse: svd_golub_kahan, a hand-built zero-column header");
var _g1586_A = alloc(16);
store64(_g1586_A, 2);
store64(_g1586_A + 8, 0);
var _g1586_t, _g1586_v = svd_golub_kahan(_g1586_A, ganita_mat_new(2, 2), alloc(16), ganita_mat_new(2, 2));
assert_eq(is_ok(_g1586_t), 0, "svd_golub_kahan: a hand-built 2 x 0 header is refused");
assert_eq(_g1586_v, HSB_ERR_INVALID_INPUT,
  "svd_golub_kahan: n = 0 -> INVALID_INPUT (documented: either dimension non-positive)");

# --- eigen_power / lyapunov_max: n was not bounded AT ALL (register entries) ---
test_group("abuse: eigen_power / lyapunov_max dimension + null contract");

var ab_ep_val = alloc(8);
var ab_ep_vec = alloc(3 * 8);
var _rq4t, _rq4v = eigen_power(ab_A33, (0 - 3), 5, ab_ep_val, ab_ep_vec);
assert_eq(is_err_result(_rq4t), 1,
  "eigen_power: n = -3 -> HSB_ERR_INVALID_INPUT (was exit 139, alloc of a negative size)");
assert_eq(_rq4v, HSB_ERR_INVALID_INPUT,
  "eigen_power: n = -3 -> HSB_ERR_INVALID_INPUT (was exit 139, alloc of a negative size)");
var _rq5t, _rq5v = eigen_power(ab_A33, 0, 5, ab_ep_val, ab_ep_vec);
assert_eq(is_err_result(_rq5t), 1, "eigen_power: n = 0 -> HSB_ERR_INVALID_INPUT");
assert_eq(_rq5v, HSB_ERR_INVALID_INPUT, "eigen_power: n = 0 -> HSB_ERR_INVALID_INPUT");
var _rq6t, _rq6v = eigen_power(ab_A33, 1000000000, 5, ab_ep_val, ab_ep_vec);
assert_eq(is_err_result(_rq6t), 1,
  "eigen_power: n = 1e9 (8 GB, over ALLOC_MAX) -> HSB_ERR_INVALID_INPUT (was exit 139)");
assert_eq(_rq6v, HSB_ERR_INVALID_INPUT,
  "eigen_power: n = 1e9 (8 GB, over ALLOC_MAX) -> HSB_ERR_INVALID_INPUT (was exit 139)");
var _rq7t, _rq7v = eigen_power(0, 3, 5, ab_ep_val, ab_ep_vec);
assert_eq(is_err_result(_rq7t), 1, "eigen_power: A = 0 -> HSB_ERR_INVALID_INPUT");
assert_eq(_rq7v, HSB_ERR_INVALID_INPUT, "eigen_power: A = 0 -> HSB_ERR_INVALID_INPUT");
var _rq8t, _rq8v = eigen_power(ab_A33, 3, 5, 0, ab_ep_vec);
assert_eq(is_err_result(_rq8t), 1, "eigen_power: out_val = 0 -> HSB_ERR_INVALID_INPUT");
assert_eq(_rq8v, HSB_ERR_INVALID_INPUT, "eigen_power: out_val = 0 -> HSB_ERR_INVALID_INPUT");
var _rq9t, _rq9v = eigen_power(ab_A33, 3, 5, ab_ep_val, 0);
assert_eq(is_err_result(_rq9t), 1, "eigen_power: out_vec = 0 -> HSB_ERR_INVALID_INPUT");
assert_eq(_rq9v, HSB_ERR_INVALID_INPUT, "eigen_power: out_vec = 0 -> HSB_ERR_INVALID_INPUT");
var _rq10t, _rq10v = eigen_power(mat_new_guarded(1000000, 1000000), 3, 5, ab_ep_val, ab_ep_vec);
assert_eq(is_err_result(_rq10t), 1, "eigen_power: capped mat_new_guarded 0 flows through");
assert_eq(_rq10v, HSB_ERR_INVALID_INPUT, "eigen_power: capped mat_new_guarded 0 flows through");
var _rq11t, _rq11v = eigen_power(ab_A34, 3, 5, ab_ep_val, ab_ep_vec);
assert_eq(is_err_result(_rq11t), 1,
  "eigen_power: 3x4 A with n = 3 -> HSB_ERR_INVALID_INPUT (leading-block answer refused)");
assert_eq(_rq11v, HSB_ERR_INVALID_INPUT,
  "eigen_power: 3x4 A with n = 3 -> HSB_ERR_INVALID_INPUT (leading-block answer refused)");
# Still works on the documented shape.
#
# ⛔ 3.3.3 — THIS PINNED 2, A DEFECT, AS "THE ALGORITHM". Through 3.3.2
# eigen_power seeded v = e_0, an exact eigenvector of every diagonal matrix, so
# the iteration sat at A[0][0] from its first step and returned 2 for
# diag(2, 3, 4). The dominant eigenvalue of a diagonal matrix is its largest
# entry, 4 -- and eigen_qr on this same ab_A33 above says 4 too. With the seed no
# longer an axis vector, the iterate leads at index 2, where v_2 is exactly 1 and
# w_2 = 4 * v_2 is exact, so the value is pinned bit for bit.
var _rq12t, _rq12v = eigen_power(ab_A33, 3, 1000, ab_ep_val, ab_ep_vec);
assert_eq(is_ok(_rq12t), 1, "eigen_power: diag(2,3,4) still runs after the guards");
assert_eq(load64(ab_ep_val), f64_from(4),
  "eigen_power: diag(2,3,4) returns the dominant 4 (3.3.2's e_0 seed returned A[0][0] = 2)");

# A matrix e_0 is NOT an eigenvector of, so the iteration actually iterates:
# [[2,1],[1,3]] has dominant eigenvalue (5 + sqrt 5) / 2 = 3.618033988749895.
var ab_ep2 = ganita_mat_new(2, 2);
ganita_mat_set(ab_ep2, 0, 0, F64_TWO);   ganita_mat_set(ab_ep2, 0, 1, F64_ONE);
ganita_mat_set(ab_ep2, 1, 0, F64_ONE);   ganita_mat_set(ab_ep2, 1, 1, f64_from(3));
var ab_ep2_vec = alloc(2 * 8);
var _rq13t, _rq13v = eigen_power(ab_ep2, 2, 1000, ab_ep_val, ab_ep2_vec);
assert_eq(is_ok(_rq13t), 1, "eigen_power: [[2,1],[1,3]] converges after the guards");
assert(f64_approx_eq(load64(ab_ep_val), 0x400CF1BBCDCBFA54, _AB_TOL) == 1,
  "eigen_power: [[2,1],[1,3]] dominant lambda == 3.618033988749895");

# === 3.3.3 G2a: eigen_power seed and convergence test ===
# Every expected value here is settled without eigen_power: the dominant eigenvalue
# of a diagonal or triangular matrix is its largest diagonal entry, the rest are
# closed forms, and eigen_qr agrees on diag(2,3,4) above. Tolerance comparisons go
# through f64_lt(|err|, tol) == 1, which a NaN fails. 1e-11 sits above every error
# this tree measures on these fixtures (largest: 4.0e-12, the upper-triangular
# lambda) and far below what each mutant gives.
# [measured: G2a probe on this tree, cycc 6.6.12, 2026-10-01]
var g2a_tol = 0x3DA5FD7FE1796495;   # 1e-11
var g2a_ev = alloc(8);
var g2a_evec = alloc(4 * 8);
fn _g2a_m3(a00, a01, a02, a10, a11, a12, a20, a21, a22) {
    var m = ganita_mat_new(3, 3);
    ganita_mat_set(m, 0, 0, a00); ganita_mat_set(m, 0, 1, a01); ganita_mat_set(m, 0, 2, a02);
    ganita_mat_set(m, 1, 0, a10); ganita_mat_set(m, 1, 1, a11); ganita_mat_set(m, 1, 2, a12);
    ganita_mat_set(m, 2, 0, a20); ganita_mat_set(m, 2, 1, a21); ganita_mat_set(m, 2, 2, a22);
    return m;
}
var g2a_z = f64_from(0);
# THE SEED, read back through the identity: every vector is an eigenvector of I,
# so the iterate stops where it started -- the seed scaled to largest component 1.
# Expected bits: SplitMix64 from state 0 (first output 0xE220A8397B1DCDAF, the
# published stream), top 52 bits as mantissas of [0.5, 1) doubles, divided by the
# largest, 0.9416554041068212 -- computed outside Cyrius.
# ⚠ 3.4.0 review: I3 itself is now read off its diagonal (`_lext_power_exact`: 1 with e_2), so
# the seed is read back through I3 with 2^-60 couplings, which the iteration answers with the
# seed's bits (its eigenvectors move the components by about 2^-60, under their last bit), and
# through the wide run on I3 below.
# [measured: LA2 probe q2, cycc 6.7.9, 2026-10-31]
var _g2a_e60 = 0x3C30000000000000;   # 2^-60
var _g2a20t, _g2a20v = eigen_power(_g2a_m3(F64_ONE, _g2a_e60, g2a_z, _g2a_e60, F64_ONE, _g2a_e60, g2a_z, _g2a_e60,
    F64_ONE), 3, 1000, g2a_ev, g2a_evec);
assert_eq(is_ok(_g2a20t), 1, "eigen_power: I3 converges");
assert_eq(load64(g2a_ev), F64_ONE, "eigen_power: I3 lambda == 1");
assert_eq(load64(g2a_evec), F64_ONE, "eigen_power: I3 v0 == 1 (the seed's largest component)");
assert_eq(load64(g2a_evec + 8), 0x3FE852D75989DB24,
  "eigen_power: I3 v1 == 0.715763998524255 / 0.9416554041068212 (the SplitMix64 seed)");
assert_eq(load64(g2a_evec + 16), 0x3FE170C48EA50329,
  "eigen_power: I3 v2 == 0.5132168857962989 / 0.9416554041068212 (the SplitMix64 seed)");
var _g2a20w = alloc(3 * 8);
assert_eq(_lext_power_wide(_g2a_m3(F64_ONE, g2a_z, g2a_z, g2a_z, F64_ONE, g2a_z, g2a_z, g2a_z, F64_ONE), 3, 1000,
    g2a_ev, _g2a20w), 0, "_lext_power_wide: I3 converges");
assert_eq(load64(_g2a20w + 8), 0x3FE852D75989DB24, "_lext_power_wide: I3 v1, the same seed");
assert_eq(load64(_g2a20w + 16), 0x3FE170C48EA50329, "_lext_power_wide: I3 v2, the same seed");

# diag(2,3,4): the dominant pair is (4, e_2). The lambda pin above holds for the
# eigenvalue-only stopping test too; the VECTOR is what that test got wrong
# (v = (0.115, 0.441, 1), measured with this seed).
# [measured: G2a seed-variant probes, cycc 6.6.12, 2026-10-01]
var _g2a21t, _g2a21v = eigen_power(ab_A33, 3, 1000, g2a_ev, g2a_evec);
assert_eq(is_ok(_g2a21t), 1, "eigen_power: diag(2,3,4) ok");
assert_eq(load64(g2a_ev), f64_from(4), "eigen_power: diag(2,3,4) lambda == 4");
assert_eq(load64(g2a_evec + 16), F64_ONE, "eigen_power: diag(2,3,4) v2 == 1");
assert_eq(f64_lt(f64_abs(load64(g2a_evec + 8)), g2a_tol), 1,
  "eigen_power: diag(2,3,4) |v1| < 1e-11 (an eigenvalue-only test stopped at 0.441)");
assert_eq(f64_lt(f64_abs(load64(g2a_evec)), g2a_tol), 1, "eigen_power: diag(2,3,4) |v0| < 1e-11");

# diag(4,3,2): e_0 answered this one exactly; the new seed must too, to 1e-11.
var g2a_d432 = _g2a_m3(f64_from(4), g2a_z, g2a_z, g2a_z, f64_from(3), g2a_z, g2a_z, g2a_z, F64_TWO);
var _g2a22t, _g2a22v = eigen_power(g2a_d432, 3, 1000, g2a_ev, g2a_evec);
assert_eq(is_ok(_g2a22t), 1, "eigen_power: diag(4,3,2) ok");
assert_eq(load64(g2a_ev), f64_from(4), "eigen_power: diag(4,3,2) lambda == 4");
assert_eq(load64(g2a_evec), F64_ONE, "eigen_power: diag(4,3,2) v0 == 1");
assert_eq(f64_lt(f64_abs(load64(g2a_evec + 8)), g2a_tol), 1,
  "eigen_power: diag(4,3,2) |v1| < 1e-11 (an eigenvalue-only test stopped at 0.321)");

# [[2,0,0],[0,3,1],[0,1,3]]: eigenvalues 2, 2, 4; the dominant vector is (0, 1, 1).
# Its first column is 2 e_0, so 3.3.2 returned 2.
var g2a_blk = _g2a_m3(F64_TWO, g2a_z, g2a_z, g2a_z, f64_from(3), F64_ONE, g2a_z, F64_ONE, f64_from(3));
var _g2a23t, _g2a23v = eigen_power(g2a_blk, 3, 1000, g2a_ev, g2a_evec);
assert_eq(is_ok(_g2a23t), 1, "eigen_power: [[2,0,0],[0,3,1],[0,1,3]] ok");
assert_eq(f64_lt(f64_abs(f64_sub(load64(g2a_ev), f64_from(4))), f64_mul(f64_from(4), g2a_tol)), 1,
  "eigen_power: [[2,0,0],[0,3,1],[0,1,3]] lambda == 4 to 1e-11 relative (3.3.2: 2)");
assert_eq(f64_lt(f64_abs(f64_sub(load64(g2a_evec + 16), F64_ONE)), g2a_tol), 1,
  "eigen_power: [[2,0,0],[0,3,1],[0,1,3]] v2 == 1 to 1e-11");
assert_eq(f64_lt(f64_abs(load64(g2a_evec)), g2a_tol), 1, "eigen_power: [[2,0,0],[0,3,1],[0,1,3]] |v0| < 1e-11");

# Upper-triangular [[2,1,0],[0,3,1],[0,0,4]]: eigenvalues 2, 3, 4. For 4,
# (A - 4I) v = 0 gives v = (1/2, 1, 1). 3.3.2 returned 2.
var g2a_up = _g2a_m3(F64_TWO, F64_ONE, g2a_z, g2a_z, f64_from(3), F64_ONE, g2a_z, g2a_z, f64_from(4));
var _g2a24t, _g2a24v = eigen_power(g2a_up, 3, 1000, g2a_ev, g2a_evec);
assert_eq(is_ok(_g2a24t), 1, "eigen_power: upper-triangular ok");
assert_eq(f64_lt(f64_abs(f64_sub(load64(g2a_ev), f64_from(4))), f64_mul(f64_from(4), g2a_tol)), 1,
  "eigen_power: upper-triangular lambda == 4 to 1e-11 relative (3.3.2: 2)");
assert_eq(f64_lt(f64_abs(f64_sub(load64(g2a_evec), 0x3FE0000000000000)), g2a_tol), 1,
  "eigen_power: upper-triangular v0 == 1/2 to 1e-11");

# tridiag(-1, 2, -1) 4x4: eigenvalues 2 - 2cos(k pi/5), so the dominant is
# 2 + 2cos(pi/5) = 2 + phi = (5 + sqrt 5)/2, and its eigenvector (sin(4 j pi/5))
# sums to zero -- the ALL-ONES seed is orthogonal to it and returned 2.618.
# [measured: G2a seed-variant probes, cycc 6.6.12, 2026-10-01]
var g2a_T4 = ganita_mat_new(4, 4);
for (var g2a_ti = 0; g2a_ti < 4; g2a_ti = g2a_ti + 1) {
    ganita_mat_set(g2a_T4, g2a_ti, g2a_ti, F64_TWO);
    if (g2a_ti > 0) {
        ganita_mat_set(g2a_T4, g2a_ti, g2a_ti - 1, f64_neg(F64_ONE));
        ganita_mat_set(g2a_T4, g2a_ti - 1, g2a_ti, f64_neg(F64_ONE));
    }
}
var _g2a25t, _g2a25v = eigen_power(g2a_T4, 4, 1000, g2a_ev, g2a_evec);
assert_eq(is_ok(_g2a25t), 1, "eigen_power: tridiag(-1,2,-1) 4x4 ok");
assert_eq(f64_lt(f64_abs(f64_sub(load64(g2a_ev), 0x400CF1BBCDCBFA54)), f64_mul(f64_from(4), g2a_tol)), 1,
  "eigen_power: tridiag(-1,2,-1) 4x4 lambda == 2 + 2cos(pi/5) = 3.618 (an all-ones seed gives 2.618)");

# [[2,0,0],[0,9,-6],[0,-6,4]]: eigenvalues 2, 0 and 13, the last with vector
# (0, 1, -2/3). From e_0 3.3.2 returned 2. 13 is reached exactly here.
var g2a_r13 = _g2a_m3(F64_TWO, g2a_z, g2a_z, g2a_z, f64_from(9), f64_from(0 - 6), g2a_z, f64_from(0 - 6), f64_from(4));
var _g2a26t, _g2a26v = eigen_power(g2a_r13, 3, 1000, g2a_ev, g2a_evec);
assert_eq(is_ok(_g2a26t), 1, "eigen_power: [[2,0,0],[0,9,-6],[0,-6,4]] ok");
assert_eq(load64(g2a_ev), f64_from(13), "eigen_power: [[2,0,0],[0,9,-6],[0,-6,4]] lambda == 13 (3.3.2: 2)");

# NO DOMINANT EIGENVALUE: [[0,1],[1,0]] has +1 and -1, tied in magnitude, so the
# iterate alternates for ever. The eigenvalue-only test called it converged --
# Ok(0), lambda = 1 and a v that is not an eigenvector (residual 1 from e_0 on
# 3.3.2, 0.240 from this seed) -- because max|A v| is 1 on every pass.
# [measured: G2a probe on the 3.3.2 bundle and seed-variant probes, cycc 6.6.12, 2026-10-01]
var g2a_sw = ganita_mat_new(2, 2);
ganita_mat_set(g2a_sw, 0, 1, F64_ONE);
ganita_mat_set(g2a_sw, 1, 0, F64_ONE);
store64(g2a_ev, _AB_SEVEN);
var _g2a27t, _g2a27v = eigen_power(g2a_sw, 2, 1000, g2a_ev, g2a_evec);
assert_eq(is_err_result(_g2a27t), 1, "eigen_power: [[0,1],[1,0]] (lambda = +-1) -> Err (3.3.2: Ok(0))");
assert_eq(_g2a27v, HSB_ERR_NO_CONVERGENCE, "eigen_power: [[0,1],[1,0]] -> HSB_ERR_NO_CONVERGENCE");
assert_eq(load64(g2a_ev), _AB_SEVEN, "eigen_power: [[0,1],[1,0]] leaves out_val untouched");

# A NON-FINITE ENTRY is NO_CONVERGENCE, never an answer: its row of A*v is NaN or
# Inf at once and every row is NaN one pass later (0 * NaN is NaN). This was true on
# 3.3.2 as well; it pins the NaN-true `max_val` guard as audited, not repaired.
# [measured: G2a probe on the 3.3.2 bundle, cycc 6.6.12, 2026-10-01]
var g2a_nan2 = ganita_mat_new(2, 2);
ganita_mat_set(g2a_nan2, 0, 0, F64_TWO);   ganita_mat_set(g2a_nan2, 0, 1, F64_ONE);
ganita_mat_set(g2a_nan2, 1, 0, _AB_NAN);   ganita_mat_set(g2a_nan2, 1, 1, f64_from(3));
var _g2a28t, _g2a28v = eigen_power(g2a_nan2, 2, 1000, g2a_ev, g2a_evec);
assert_eq(_g2a28v, HSB_ERR_NO_CONVERGENCE, "eigen_power: NaN at A[1][0] -> HSB_ERR_NO_CONVERGENCE");
var _g2a29t, _g2a29v = eigen_power(_g2a_m3(F64_TWO, g2a_z, g2a_z, g2a_z, f64_from(3), g2a_z, g2a_z, g2a_z, _AB_PINF),
  3, 1000, g2a_ev, g2a_evec);
assert_eq(_g2a29v, HSB_ERR_NO_CONVERGENCE, "eigen_power: +Inf on the diagonal -> HSB_ERR_NO_CONVERGENCE");
assert_eq(load64(g2a_ev), _AB_SEVEN, "eigen_power: non-finite A leaves out_val untouched");

# === 3.3.3 R4le: eigen_power opposite-sign ties and the first-pass overflow ===
# Expected values are closed forms: [[a,b],[b,a]] has eigenvalues a + b and a - b,
# with eigenvectors (1, 1) and (1, -1), and a triangular matrix's eigenvalues are its
# diagonal. Tolerance comparisons go through f64_lt(|err|, tol) == 1, which a NaN
# fails; g2a_tol (1e-11) sits above every error this tree measures on them (largest:
# 2.4e-13 relative, the -1 components within 4.2e-13).
# [measured: R4le probe on this tree, cycc 6.6.12, 2026-10-01]
fn _r4le_s2(a, b) {
    var m = ganita_mat_new(2, 2);
    ganita_mat_set(m, 0, 0, f64_from(a));  ganita_mat_set(m, 0, 1, f64_from(b));
    ganita_mat_set(m, 1, 0, f64_from(b));  ganita_mat_set(m, 1, 1, f64_from(a));
    return m;
}
# 1 when (v0, v1) is (1, -1) or (-1, 1): one component exactly 1, the other -1 to 1e-11.
fn _r4le_opp(v) {
    var v0 = load64(v);
    var v1 = load64(v + 8);
    if (v0 != F64_ONE && v1 != F64_ONE) { return 0; }
    return f64_lt(f64_abs(f64_add(v0, v1)), g2a_tol);
}
# NaN into out_val and out_vec before each call that must converge, so a value left
# over from an earlier call cannot pass for this one's. (The 7.0 stamp used for the
# refusals equals [[2,-5],[-5,2]]'s eigenvalue: with the repair mutated out, its
# lambda check passed on the stale stamp.)
# [measured: R4le mutant run, this tree, cycc 6.6.12, 2026-10-01]
fn _r4le_stamp() {
    store64(g2a_ev, _AB_NAN);
    for (var i = 0; i < 4; i = i + 1) { store64(g2a_evec + i * 8, _AB_NAN); }
    return 0;
}
# THE DOMINANT EIGENVECTOR (1, -1) TIES ITS TWO COMPONENTS WITH OPPOSITE SIGNS, and
# lambda_2 / lambda_1 < 0, so the lead swaps on every pass and v = w / max_val flips
# sign: the vector test never cleared. 3.3.2 (eigenvalue test alone) returned the
# wrong sign; before this repair, NO_CONVERGENCE at max_iter 1000 and 100000 alike.
# [measured: R4le probe, 3.3.2 bundle and this tree before the repair, cycc 6.6.12, 2026-10-01]
_r4le_stamp();
var _r4le1t, _r4le1v = eigen_power(_r4le_s2(1, 0 - 3), 2, 1000, g2a_ev, g2a_evec);
assert_eq(is_ok(_r4le1t), 1, "eigen_power: [[1,-3],[-3,1]] (4, -2) converges (was NO_CONVERGENCE; 3.3.2: Ok, -4)");
assert_eq(f64_lt(f64_abs(f64_sub(load64(g2a_ev), f64_from(4))), f64_mul(f64_from(4), g2a_tol)), 1,
  "eigen_power: [[1,-3],[-3,1]] lambda == +4 to 1e-11 relative (3.3.2: -4)");
assert_eq(_r4le_opp(g2a_evec), 1, "eigen_power: [[1,-3],[-3,1]] v == (1, -1) up to sign, the lead exactly 1");
_r4le_stamp();
var _r4le2t, _r4le2v = eigen_power(_r4le_s2(2, 0 - 5), 2, 1000, g2a_ev, g2a_evec);
assert_eq(is_ok(_r4le2t), 1, "eigen_power: [[2,-5],[-5,2]] (7, -3) converges (3.3.2: Ok, -7)");
assert_eq(f64_lt(f64_abs(f64_sub(load64(g2a_ev), f64_from(7))), f64_mul(f64_from(7), g2a_tol)), 1,
  "eigen_power: [[2,-5],[-5,2]] lambda == +7 to 1e-11 relative (3.3.2: -7)");
assert_eq(_r4le_opp(g2a_evec), 1, "eigen_power: [[2,-5],[-5,2]] v == (1, -1) up to sign");
# A NEGATIVE dominant eigenvalue in the same class: the estimate's sign is the matrix's.
_r4le_stamp();
var _r4le3t, _r4le3v = eigen_power(_r4le_s2(0 - 1, 3), 2, 1000, g2a_ev, g2a_evec);
assert_eq(is_ok(_r4le3t), 1, "eigen_power: [[-1,3],[3,-1]] (-4, 2) converges (3.3.2: Ok, +4)");
assert_eq(f64_lt(f64_abs(f64_add(load64(g2a_ev), f64_from(4))), f64_mul(f64_from(4), g2a_tol)), 1,
  "eigen_power: [[-1,3],[3,-1]] lambda == -4 to 1e-11 relative (3.3.2: +4)");
assert_eq(_r4le_opp(g2a_evec), 1, "eigen_power: [[-1,3],[3,-1]] v == (1, -1) up to sign");
# The one 3.3.3 answered before the repair, by the rounding of its ties: still 3.
_r4le_stamp();
var _r4le4t, _r4le4v = eigen_power(_r4le_s2(1, 0 - 2), 2, 1000, g2a_ev, g2a_evec);
assert_eq(is_ok(_r4le4t), 1, "eigen_power: [[1,-2],[-2,1]] (3, -1) converges");
assert_eq(f64_lt(f64_abs(f64_sub(load64(g2a_ev), f64_from(3))), f64_mul(f64_from(3), g2a_tol)), 1,
  "eigen_power: [[1,-2],[-2,1]] lambda == 3 to 1e-11 relative (3.3.2: -3)");
assert_eq(_r4le_opp(g2a_evec), 1, "eigen_power: [[1,-2],[-2,1]] v == (1, -1) up to sign");
# 3x3: the tie sits in a block, and the third component converges to 0.
var _r4le_b3 = _g2a_m3(F64_ONE, f64_from(0 - 3), g2a_z, f64_from(0 - 3), F64_ONE, g2a_z, g2a_z, g2a_z, F64_ONE);
_r4le_stamp();
var _r4le5t, _r4le5v = eigen_power(_r4le_b3, 3, 1000, g2a_ev, g2a_evec);
assert_eq(is_ok(_r4le5t), 1, "eigen_power: [[1,-3,0],[-3,1,0],[0,0,1]] (4, -2, 1) converges (3.3.2: Ok, -4)");
assert_eq(f64_lt(f64_abs(f64_sub(load64(g2a_ev), f64_from(4))), f64_mul(f64_from(4), g2a_tol)), 1,
  "eigen_power: [[1,-3,0],[-3,1,0],[0,0,1]] lambda == +4 to 1e-11 relative");
assert_eq(_r4le_opp(g2a_evec), 1, "eigen_power: [[1,-3,0],[-3,1,0],[0,0,1]] (v0, v1) == (1, -1) up to sign");
assert_eq(f64_lt(f64_abs(load64(g2a_evec + 16)), g2a_tol), 1,
  "eigen_power: [[1,-3,0],[-3,1,0],[0,0,1]] |v2| < 1e-11");
# The up-to-sign test must not make a tie converge: [[0,-1],[-1,0]] (+1, -1) never settles.
store64(g2a_ev, _AB_SEVEN);
var _r4le6t, _r4le6v = eigen_power(_r4le_s2(0, 0 - 1), 2, 1000, g2a_ev, g2a_evec);
assert_eq(_r4le6v, HSB_ERR_NO_CONVERGENCE, "eigen_power: [[0,-1],[-1,0]] (+-1) is still NO_CONVERGENCE");
assert_eq(load64(g2a_ev), _AB_SEVEN, "eigen_power: [[0,-1],[-1,0]] leaves out_val untouched");

# THE SEED'S FIRST MATVEC OVERFLOWED: 1e308 * 0.94 + 1.5e308 * 0.72 is past DBL_MAX,
# while the eigenvector e_0 gives A v = (1e308, 0). Before this repair NO_CONVERGENCE;
# 3.3.2, seeded with e_0, returned 1e308. The first pass with a non-finite component
# now switches the iteration to an iterate scaled by 2^-s, 2^s > 2n -- for good since
# R5le, because a LATER pass can overflow as well (see the block after this one).
# Oracle: both matrices' dominant eigenvalue rounds to 1e308 exactly -- the first is
# triangular, and the second's is 1e308 + 1.5 + O(1e-308), 1.5 being far under half
# an ulp of 1e308 -- and its eigenvector is (1, 1/(lambda - 1)), whose second
# component rounds to the subnormal 1e-308.
# [measured: R4le probe, 3.3.2 bundle and this tree before the repair, cycc 6.6.12, 2026-10-01]
var _r4le_e308 = 0x7FE1CCF385EBC8A0;    # 1e308
var _r4le_e308h = 0x7FEAB36D48E1ACF0;   # 1.5e308
fn _r4le_m2(a, b, c, d) {
    var m = ganita_mat_new(2, 2);
    ganita_mat_set(m, 0, 0, a);  ganita_mat_set(m, 0, 1, b);
    ganita_mat_set(m, 1, 0, c);  ganita_mat_set(m, 1, 1, d);
    return m;
}
_r4le_stamp();
var _r4le7t, _r4le7v = eigen_power(_r4le_m2(_r4le_e308, _r4le_e308h, g2a_z, F64_ONE), 2, 1000, g2a_ev, g2a_evec);
assert_eq(is_ok(_r4le7t), 1, "eigen_power: [[1e308,1.5e308],[0,1]] converges (was NO_CONVERGENCE: seed overflow)");
assert_eq(load64(g2a_ev), _r4le_e308, "eigen_power: [[1e308,1.5e308],[0,1]] lambda == 1e308 exactly");
assert_eq(load64(g2a_evec), F64_ONE, "eigen_power: [[1e308,1.5e308],[0,1]] v0 == 1");
assert_eq(load64(g2a_evec + 8), 0, "eigen_power: [[1e308,1.5e308],[0,1]] v1 == +0 (v = e_0)");
_r4le_stamp();
var _r4le8t, _r4le8v = eigen_power(_r4le_m2(_r4le_e308, _r4le_e308h, F64_ONE, F64_ONE), 2, 1000, g2a_ev, g2a_evec);
assert_eq(is_ok(_r4le8t), 1, "eigen_power: [[1e308,1.5e308],[1,1]] converges (was NO_CONVERGENCE)");
assert_eq(load64(g2a_ev), _r4le_e308, "eigen_power: [[1e308,1.5e308],[1,1]] lambda == 1e308 exactly");
assert_eq(load64(g2a_evec), F64_ONE, "eigen_power: [[1e308,1.5e308],[1,1]] v0 == 1");
assert_eq(load64(g2a_evec + 8), 0x000730D67819E8D2,
  "eigen_power: [[1e308,1.5e308],[1,1]] v1 == 1/(lambda - 1), the subnormal 1e-308 correctly rounded");
# The scale must grow with n: a row of DBL_MAX against the 3-component seed sums to
# 2.17 DBL_MAX, still 1.09 DBL_MAX at 2^-1, and 0.27 DBL_MAX at 2^-3 (2^3 > 2n = 6).
# Upper-triangular, so lambda = DBL_MAX exactly, with eigenvector e_0 (3.3.2's seed:
# Ok, DBL_MAX). It is reached on the third pass: the seed pass's estimate is that row
# sum, and the second pass's still differs from it.
# [measured: R4le probe, 3.3.2 bundle and this tree, cycc 6.6.12, 2026-10-01]
# [measured: R5le min-max_iter probe, this tree, cycc 6.6.12, 2026-10-01]
var _r4le_dmax = 0x7FEFFFFFFFFFFFFF;
var _r4le_b3m = _g2a_m3(_r4le_dmax, _r4le_dmax, _r4le_dmax, g2a_z, F64_ONE, g2a_z, g2a_z, g2a_z, F64_ONE);
_r4le_stamp();
var _r4le12t, _r4le12v = eigen_power(_r4le_b3m, 3, 1000, g2a_ev, g2a_evec);
assert_eq(is_ok(_r4le12t), 1, "eigen_power: [[DMAX,DMAX,DMAX],[0,1,0],[0,0,1]] converges (was NO_CONVERGENCE)");
assert_eq(load64(g2a_ev), _r4le_dmax, "eigen_power: [[DMAX,DMAX,DMAX],[0,1,0],[0,0,1]] lambda == DBL_MAX exactly");
assert_eq(load64(g2a_evec), F64_ONE, "eigen_power: [[DMAX,DMAX,DMAX],[0,1,0],[0,0,1]] v0 == 1");
assert_eq(load64(g2a_evec + 8), 0, "eigen_power: [[DMAX,DMAX,DMAX],[0,1,0],[0,0,1]] v1 == +0");
assert_eq(load64(g2a_evec + 16), 0, "eigen_power: [[DMAX,DMAX,DMAX],[0,1,0],[0,0,1]] v2 == +0");
# The switch answers nothing that has no answer. lambda = +-1e308 tie in magnitude
# (3.3.2, from e_0, returned 1e308); [[1e308,1e308],[1e308,1e308]] has lambda = 2e308,
# past DBL_MAX: its scaled estimate converges to 2.5e307, which times 2^3 is +Inf and
# is refused, where a switch that returned the estimate in its 2^-s units would report
# 2.5e307. (A NaN or infinite entry already takes the switch in the G2a tests above --
# their first pass is non-finite -- and stays NO_CONVERGENCE.)
# [measured: R4le probe and mutant run, this tree, cycc 6.6.12, 2026-10-01]
store64(g2a_ev, _AB_SEVEN);
var _r4le9t, _r4le9v = eigen_power(_r4le_m2(_r4le_e308, _r4le_e308h, g2a_z, f64_neg(_r4le_e308)), 2, 1000,
  g2a_ev, g2a_evec);
assert_eq(_r4le9v, HSB_ERR_NO_CONVERGENCE, "eigen_power: [[1e308,1.5e308],[0,-1e308]] (+-1e308) -> NO_CONVERGENCE");
var _r4le10t, _r4le10v = eigen_power(_r4le_m2(_r4le_e308, _r4le_e308, _r4le_e308, _r4le_e308), 2, 1000,
  g2a_ev, g2a_evec);
assert_eq(_r4le10v, HSB_ERR_NO_CONVERGENCE, "eigen_power: lambda = 2e308 (past DBL_MAX) -> NO_CONVERGENCE");
assert_eq(load64(g2a_ev), _AB_SEVEN, "eigen_power: the two refusals leave out_val untouched");

# === 3.3.3 R5le: eigen_power, an overflow on a later pass ===
# A pass after the first can overflow too, whenever some |a_ij| > DBL_MAX / n, at a
# lambda far below DBL_MAX: round 4's redo of the FIRST pass never reached these. The
# first overflowing pass now switches the iteration to u = v * 2^-s for good. Oracle:
# the same matrix times 2^-64, which never overflows, run through the in-range
# iteration; scaling by a power of two is exact, so its lambda times 2^64 and its v
# must come back bit for bit. The closed form is the diagonal (both are triangular).
# [measured: R5le repro probe, 3.3.2 bundle, the tree before this repair and this tree, cycc 6.6.12, 2026-10-01]
fn _r5le_ep(a, b, c, d, sc) {
    return _r4le_m2(f64_mul(a, sc), f64_mul(b, sc), f64_mul(c, sc), f64_mul(d, sc));
}
var _r5le_one = 0x3FF0000000000000;
var _r5le_m64 = 0x3BF0000000000000;    # 2^-64
var _r5le_p64 = 0x43F0000000000000;    # 2^64
var _r5le_t12 = 0x3D719799812DEA11;    # 1e-12
var _r5le_t10 = 0x3DDB7CDFD9D7BDBB;    # 1e-10
var _r5le_ev2 = alloc(8);
var _r5le_vec2 = alloc(2 * 8);
# [[-3e307, 1.6e308], [0, 2e307]], lambda = -3e307 = 0.167 DBL_MAX. Its first pass is
# finite; a later one meets v = (1, -0.948), and -3e307 + 1.6e308 * -0.948 is -Inf.
# 3.3.2: Ok, -3e307 exactly. Before this repair: NO_CONVERGENCE, at max_iter 1000 and
# 100000 alike. Now 74 passes, as the 2^-64 copy takes; 4.0e-13 relative.
var _r5le_a = 0xFFC55C576D815726;    # -3e307
var _r5le_b = 0x7FEC7B1F3CAC7433;    # 1.6e308
var _r5le_d = 0x7FBC7B1F3CAC7433;    # 2e307
store64(_r5le_ev2, _AB_NAN);
var _r5le1t, _r5le1v = eigen_power(_r5le_ep(_r5le_a, _r5le_b, g2a_z, _r5le_d, _r5le_m64), 2, 1000,
  _r5le_ev2, _r5le_vec2);
assert_eq(is_ok(_r5le1t), 1, "eigen_power: [[-3e307,1.6e308],[0,2e307]] times 2^-64 converges (the oracle)");
_r4le_stamp();
var _r5le2t, _r5le2v = eigen_power(_r5le_ep(_r5le_a, _r5le_b, g2a_z, _r5le_d, _r5le_one), 2, 1000, g2a_ev, g2a_evec);
assert_eq(is_ok(_r5le2t), 1,
  "eigen_power: [[-3e307,1.6e308],[0,2e307]] converges (before: NO_CONVERGENCE, a later pass overflowed)");
assert_eq(load64(g2a_ev), f64_mul(load64(_r5le_ev2), _r5le_p64),
  "eigen_power: [[-3e307,1.6e308],[0,2e307]] lambda == 2^64 times the 2^-64 copy's, bit for bit");
assert_eq(f64_lt(f64_abs(f64_sub(load64(g2a_ev), _r5le_a)), f64_mul(f64_abs(_r5le_a), _r5le_t12)), 1,
  "eigen_power: [[-3e307,1.6e308],[0,2e307]] lambda == -3e307 to 1e-12 relative");
assert_eq(load64(g2a_evec), F64_ONE, "eigen_power: [[-3e307,1.6e308],[0,2e307]] v0 == 1");
assert_eq(load64(g2a_evec + 8), load64(_r5le_vec2 + 8),
  "eigen_power: [[-3e307,1.6e308],[0,2e307]] v1 == the 2^-64 copy's, bit for bit");
assert_eq(f64_lt(f64_abs(load64(g2a_evec + 8)), g2a_tol), 1,
  "eigen_power: [[-3e307,1.6e308],[0,2e307]] |v1| < 1e-11 (the eigenvector is e_0)");
# [[1.4e308, 1.2e308], [0, 1.3e308]], lambda = 1.4e308. 3.3.2: Ok, 1.4e308 exactly.
# Before this repair: NO_CONVERGENCE. |lambda_2 / lambda_1| = 0.93 makes it slow (304
# passes) and leaves 1.1e-11 relative; 1e-10 is the bound here.
var _r5le_a2 = 0x7FE8EBBB5516E5AD;    # 1.4e308
var _r5le_b2 = 0x7FE55C576D815726;    # 1.2e308
var _r5le_d2 = 0x7FE72409614C1E6A;    # 1.3e308
store64(_r5le_ev2, _AB_NAN);
var _r5le3t, _r5le3v = eigen_power(_r5le_ep(_r5le_a2, _r5le_b2, g2a_z, _r5le_d2, _r5le_m64), 2, 1000,
  _r5le_ev2, _r5le_vec2);
assert_eq(is_ok(_r5le3t), 1, "eigen_power: [[1.4e308,1.2e308],[0,1.3e308]] times 2^-64 converges (the oracle)");
_r4le_stamp();
var _r5le4t, _r5le4v = eigen_power(_r5le_ep(_r5le_a2, _r5le_b2, g2a_z, _r5le_d2, _r5le_one), 2, 1000,
  g2a_ev, g2a_evec);
assert_eq(is_ok(_r5le4t), 1, "eigen_power: [[1.4e308,1.2e308],[0,1.3e308]] converges (before: NO_CONVERGENCE)");
assert_eq(load64(g2a_ev), f64_mul(load64(_r5le_ev2), _r5le_p64),
  "eigen_power: [[1.4e308,1.2e308],[0,1.3e308]] lambda == 2^64 times the 2^-64 copy's, bit for bit");
assert_eq(f64_lt(f64_abs(f64_sub(load64(g2a_ev), _r5le_a2)), f64_mul(_r5le_a2, _r5le_t10)), 1,
  "eigen_power: [[1.4e308,1.2e308],[0,1.3e308]] lambda == 1.4e308 to 1e-10 relative");
assert_eq(load64(g2a_evec), F64_ONE, "eigen_power: [[1.4e308,1.2e308],[0,1.3e308]] v0 == 1");
assert_eq(load64(g2a_evec + 8), load64(_r5le_vec2 + 8),
  "eigen_power: [[1.4e308,1.2e308],[0,1.3e308]] v1 == the 2^-64 copy's, bit for bit");

# === 3.3.4 krylov: eigen_power, components below DBL_MIN ===
# When the dominant eigenvector, scaled to largest component 1, has a component below
# the f64 range, the iterate's copy of it flushes, and the iteration can settle on a
# smaller eigenpair that the flushed arithmetic cannot tell apart. A converged iterate
# whose sub-DBL_MIN components can move a row by tol is now run again with every
# component held as m * 2^e. Oracle: the exact characteristic polynomial (Fractions),
# its roots by Graeffe squaring and Newton in 120-digit Decimal; for a triangular
# matrix that is the diagonal. The 3.3.3 results quoted are the tree before the repair.
# [measured: krylov eigen_power sweeps and fixture probe, 3.3.4 tree before and after, cycc 6.6.14, 2026-10-03]
var _k4e_t12 = 0x3D719799812DEA11;    # 1e-12
var _k4e_t2 = 0x3D819799812DEA11;     # 2e-12
# (1) [[a, b], [0, d]], a = -4.70e-303, b = 1.37e306, d = -8.90e-303 (|lambda_2/lambda_1| =
# 0.528): the dominant eigenvector is (1, (d - a) / b) = (1, -3e-609). 3.3.3: Ok(0) and a,
# from the flushed (1, -0). Now d to 1.0e-12 relative, within tol / (1 - 0.528), and the
# eigenvector rounds to (1, -0) correctly.
# [measured: krylov eigen_power fixture probe, 3.3.4 tree before and after, cycc 6.6.14, 2026-10-03]
var _k4e_a = 0x8129C64C2C526C2B;
var _k4e_d = 0x81386A9B50C3EF5D;
_r4le_stamp();
var _k4e1t, _k4e1v = eigen_power(_r4le_m2(_k4e_a, 0x7F7F299FD5586D60, g2a_z, _k4e_d), 2, 1000, g2a_ev, g2a_evec);
assert_eq(is_ok(_k4e1t), 1, "eigen_power: [[-4.70e-303,1.37e306],[0,-8.90e-303]] converges");
assert_eq(load64(g2a_ev), _k4e_d,
  "eigen_power: [[-4.70e-303,1.37e306],[0,-8.90e-303]] lambda == d exactly (3.4.0; 3.3.4-3.3.7: 1.0e-12 off)");
assert_eq(f64_lt(f64_abs(f64_sub(load64(g2a_ev), _k4e_d)), f64_mul(f64_abs(_k4e_d), _k4e_t2)), 1,
  "eigen_power: [[-4.70e-303,1.37e306],[0,-8.90e-303]] lambda == d, the dominant eigenvalue, to 2e-12");
assert_eq(load64(g2a_evec), F64_ONE, "eigen_power: [[-4.70e-303,1.37e306],[0,-8.90e-303]] v0 == 1");
assert_eq(load64(g2a_evec + 8), 0x8000000000000000,
  "eigen_power: [[-4.70e-303,1.37e306],[0,-8.90e-303]] v1 == -3e-609 rounded, -0");
# ⭐ 3.4.0 — this matrix is triangular, so its spectrum is its diagonal and eigen_power answers
# it exactly without iterating (`_lext_power_exact`); the eigenvector is the exact one, rounded
# (Fraction oracle). The wide run it used to reach is pinned directly, with 3.3.4's bits.
# [measured: LA probe p4 + exact_ev.py Fraction oracle, 3.3.7 base vs this tree, cycc 6.7.9, 2026-10-31]
var _k4w = alloc(8);
var _k4wv = alloc(3 * 8);
assert_eq(_lext_power_wide(_r4le_m2(_k4e_a, 0x7F7F299FD5586D60, g2a_z, _k4e_d), 2, 1000, _k4w, _k4wv), 0,
  "_lext_power_wide: [[-4.70e-303,1.37e306],[0,-8.90e-303]] converges");
assert_eq(load64(_k4w), 0x81386A9B50C40B5E, "_lext_power_wide: [[-4.70e-303,...]] lambda is 3.3.4's bits");
# (2) A subnormal component in a graded chain. The eigenvector's last component is
# 2.048 * 2^-1074; held on the subnormal grid it is 2 * 2^-1074, and the -8.8e160 and
# -9.4e160 entries carry that rounding up to lambda. 3.3.3: Ok(0) and 1.16798. The dominant
# eigenvalue is 1.1688951086948685 (0x3FF2B3CB5B84C7FD); now to 4.3e-13 relative.
# [measured: krylov eigen_power fixture probe, 3.3.4 tree before and after, cycc 6.6.14, 2026-10-03]
var _k4e2t, _k4e2v = eigen_power(_g2a_m3(0x3FEA8E43D21BDD22, 0xE15AD1E5DF1EF8EA, 0x7F952C3CAD913658,
    0x9E746FBE2257D824, 0xBFE50EEE4ADAC636, 0xE15918BD7ED2C3C0, g2a_z, 0x9E58525DBB6E0920, 0x3FE2305F5C787BE0),
  3, 1000, g2a_ev, g2a_evec);
assert_eq(is_ok(_k4e2t), 1, "eigen_power: graded 3x3 with a subnormal eigenvector component converges");
assert_eq(load64(g2a_ev), 0x3FF2B3CB5B84D0EE, "eigen_power: graded 3x3 lambda bits (3.3.3: 1.16798, 7.8e-4 off)");
assert_eq(f64_lt(f64_abs(f64_sub(load64(g2a_ev), 0x3FF2B3CB5B84C7FD)), f64_mul(0x3FF2B3CB5B84C7FD, _k4e_t12)), 1,
  "eigen_power: graded 3x3 lambda == 1.1688951086948685 to 1e-12 relative");
# (3) A complex pair dominates: [[-4.0e-303, 1.6e306, 0], [-2.8e-303, -9.5e-303, 0],
# [-4.9e306, 2.5e306, 3.3e-303]] has eigenvalues 3.3e-303 and a pair of modulus 66.
# 3.3.3: Ok(0) and 3.3e-303 from the iterate (0, 0, 1). Now NO_CONVERGENCE, out_val untouched.
# [measured: krylov eigen_power fixture probe, 3.3.4 tree before and after, cycc 6.6.14, 2026-10-03]
_r4le_stamp();
var _k4e3t, _k4e3v = eigen_power(_g2a_m3(0x8126133F39CBDD38, 0x7F81BB84EF2F024D, g2a_z,
    0x811F14488783A003, 0x813A2AEB6C11A93C, g2a_z, 0xFF9BE187FB0FB263, 0x7F8D0248437E9CD9, 0x012220EA83726C64),
  3, 1000, g2a_ev, g2a_evec);
assert_eq(_k4e3v, HSB_ERR_NO_CONVERGENCE,
  "eigen_power: a complex pair of modulus 66 dominates -> NO_CONVERGENCE (3.3.3: Ok, 3.3e-303)");
assert_eq(load64(g2a_ev), _AB_NAN, "eigen_power: complex-pair dominant -> out_val untouched");
# (4) THE PLAIN ANSWER STANDS WHEN IT IS THE LARGER. [[a00, 1.48e81, 0], [0, 1.06e-105, 0],
# [0, -2.08e145, -9.04e-153]], a00 = -1.308e-89: the plain run's (1, -0, 3.76e-142) is the
# eigenvector of a00, the dominant eigenvalue, to within tol (the exact one is (1, 0, 0),
# and 3.76e-142 a decayed residue), and its -0 trips the check. The wide run settles on
# 1.06e-105 while the a00 direction is still growing from 1e-32; taking it would return a
# wrong answer for a right one. lambda must be a00 exactly, as on 3.3.3.
# [measured: krylov eigen_power fixture probe, 3.3.4 tree before and after, cycc 6.6.14, 2026-10-03]
_r4le_stamp();
var _k4e4t, _k4e4v = eigen_power(_g2a_m3(0xAD7AA5E3DC7AA2EA, 0x50C90783DE1B108A, g2a_z,
    g2a_z, 0x2A237457AB9C2C00, g2a_z, g2a_z, 0xDE1AAF7E584E6032, 0xA05E5143F7466F88), 3, 1000, g2a_ev, g2a_evec);
assert_eq(is_ok(_k4e4t), 1, "eigen_power: plain dominant pair kept over a smaller wide one: converges");
assert_eq(load64(g2a_ev), 0xAD7AA5E3DC7AA2EA,
  "eigen_power: plain dominant pair kept: lambda == a00 exactly (wide: 1.06e-105)");
# 3.4.0: triangular, answered exactly; the eigenvector of a00 is (1, 0, 0) exactly, where the
# iteration's (1, -0, 3.76e-142) kept a decayed residue
# [measured: LA probe p4 + exact_ev.py Fraction oracle, 3.3.7 base vs this tree, cycc 6.7.9, 2026-10-31]
assert_eq(load64(g2a_evec + 8), 0, "eigen_power: plain dominant pair kept: v1 == +0 (exact)");
assert_eq(load64(g2a_evec + 16), 0, "eigen_power: plain dominant pair kept: v2 == +0 (exact; 3.3.3-3.3.7: 3.76e-142)");
# (5) AGREEMENT KEEPS THE EXACT PAIR. [[-9.10e-303, 2.37e303], [0, -3.39e-303]]
# (|lambda_2/lambda_1| = 0.373): (1, -0) is the exact eigenvector of a00, the dominant
# eigenvalue, and trips the check; the wide run ends 2.4e-13 above |a00|, inside the 2^-26
# margin, so a00 comes back exactly, as on 3.3.3.
# [measured: krylov eigen_power fixture probe, 3.3.4 tree before and after, cycc 6.6.14, 2026-10-03]
_r4le_stamp();
var _k4e5t, _k4e5v = eigen_power(_r4le_m2(0x8138F8A36F2D729C, 0x7EEBAC3A1E8A274E, g2a_z, 0x81229F0274F84BD7),
  2, 1000, g2a_ev, g2a_evec);
assert_eq(is_ok(_k4e5t), 1, "eigen_power: [[-9.10e-303,2.37e303],[0,-3.39e-303]] converges");
assert_eq(load64(g2a_ev), 0x8138F8A36F2D729C,
  "eigen_power: [[-9.10e-303,2.37e303],[0,-3.39e-303]] lambda == a00 exactly");
# 3.4.0: the exact eigenvector (1, 0), its zero structural and written +0 (the iteration's -0)
assert_eq(load64(g2a_evec + 8), 0, "eigen_power: [[-9.10e-303,2.37e303],[0,-3.39e-303]] v1 == +0 (exact)");
# (6) A ROW WHOSE TERMS SPAN MORE THAN THE f64 RANGE. [[4.38e-269, 0], [1.26e293, 6.37e-294]]:
# the dominant eigenvector is (1, 2.9e561), scaled (3.5e-562, 1); on the seed's pass row 1
# adds 1.26e293 * 0.94 to 6.37e-294 * 0.72, 1950 binades apart, so the wide run must scale
# each row by its LARGEST term. 3.3.3: Ok(0) and a11 = 6.37e-294. Now a00 + 1 ulp.
# [measured: krylov eigen_power fixture probe, 3.3.4 tree before and after, cycc 6.6.14, 2026-10-03]
_r4le_stamp();
var _k4e6t, _k4e6v = eigen_power(_r4le_m2(0x083726184CE0256A, g2a_z, 0x7CC93F62FCA5A696, 0x031043046B8B9570),
  2, 1000, g2a_ev, g2a_evec);
assert_eq(is_ok(_k4e6t), 1, "eigen_power: [[4.38e-269,0],[1.26e293,6.37e-294]] converges");
assert_eq(load64(g2a_ev), 0x083726184CE0256A,
  "eigen_power: [[4.38e-269,0],[1.26e293,6.37e-294]] lambda == a00 exactly (3.4.0; 3.3.4-3.3.7: + 1 ulp)");
assert_eq(load64(g2a_evec), 0, "eigen_power: [[4.38e-269,0],[1.26e293,6.37e-294]] v0 == 3.5e-562 rounded, +0");
assert_eq(load64(g2a_evec + 8), F64_ONE, "eigen_power: [[4.38e-269,0],[1.26e293,6.37e-294]] v1 == 1");
# its wide run, pinned directly (3.4.0: eigen_power answers this lower-triangular A exactly)
assert_eq(_lext_power_wide(_r4le_m2(0x083726184CE0256A, g2a_z, 0x7CC93F62FCA5A696, 0x031043046B8B9570), 2, 1000,
    _k4w, _k4wv), 0, "_lext_power_wide: [[4.38e-269,0],[1.26e293,6.37e-294]] converges");
assert_eq(load64(_k4w), 0x083726184CE0256B,
  "_lext_power_wide: [[4.38e-269,0],[1.26e293,6.37e-294]] lambda == a00 + 1 ulp, 3.3.4's bits");
# (7) THE DOMINANT EIGENVALUE ON A POWER OF TWO. [[a, b], [0, 2^-1000]], a = -0.618 * 2^-1000,
# b = 1.37e306: lambda_2 / lambda_1 < 0, so the estimates alternate about 2^-1000 and their
# exponents differ by one from pass to pass; the wide run compares them across that step.
# 3.3.3: Ok(0) and a. Now 2^-1000 to 2.9e-13 relative.
# [measured: krylov eigen_power fixture probe, 3.3.4 tree before and after, cycc 6.6.14, 2026-10-03]
_r4le_stamp();
var _k4e7t, _k4e7v = eigen_power(_r4le_m2(0x8163C6EF372FE950, 0x7F7F299FD5586D60, g2a_z, 0x0170000000000000),
  2, 1000, g2a_ev, g2a_evec);
assert_eq(is_ok(_k4e7t), 1, "eigen_power: [[-0.618 * 2^-1000,1.37e306],[0,2^-1000]] converges");
assert_eq(load64(g2a_ev), 0x0170000000000000,
  "eigen_power: [[-0.618 * 2^-1000,1.37e306],[0,2^-1000]] lambda == 2^-1000 exactly (3.4.0; 3.3.4-3.3.7: 2.9e-13 off)");
assert_eq(_lext_power_wide(_r4le_m2(0x8163C6EF372FE950, 0x7F7F299FD5586D60, g2a_z, 0x0170000000000000), 2, 1000,
    _k4w, _k4wv), 0, "_lext_power_wide: [[-0.618 * 2^-1000,1.37e306],[0,2^-1000]] converges");
assert_eq(load64(_k4w), 0x016FFFFFFFFFF5D6,
  "_lext_power_wide: [[-0.618 * 2^-1000,1.37e306],[0,2^-1000]] lambda is 3.3.4's bits (across the exponent step)");
assert_eq(f64_lt(f64_abs(f64_sub(load64(g2a_ev), 0x0170000000000000)), f64_mul(0x0170000000000000, _k4e_t12)), 1,
  "eigen_power: [[-0.618 * 2^-1000,1.37e306],[0,2^-1000]] lambda == 2^-1000 to 1e-12");
# (8) AN OPPOSITE-SIGN TIE ON THE WIDE PATH. [[1.1s, -3.3s, 1e300], [-3.3s, 1.1s, 0],
# [0, 0, 1.7e-310]], s = 1e-300: lambda = 4.4s, eigenvector (1, -1, 0), whose two largest
# components swap the lead each pass (see R4le above). Its third component is -0 beside the
# 1e300, so the check trips; the wide run must compare up to sign to converge, and agrees.
# [measured: krylov eigen_power fixture probe, 3.3.4 tree before and after, cycc 6.6.14, 2026-10-03]
_r4le_stamp();
var _k4e8t, _k4e8v = eigen_power(_g2a_m3(0x01A792BC89AB7216, 0x81C1AE0D67409590, 0x7E37E43C8800759C,
    0x81C1AE0D67409590, 0x01A792BC89AB7216, g2a_z, g2a_z, g2a_z, 0x00001F4B537320E3), 3, 1000, g2a_ev, g2a_evec);
