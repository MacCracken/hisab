# A split that cannot get its children leaves the leaf whole. Eight points fill a
# quadtree leaf (its point vec has grown to 32 slots, so a 9th needs no growth); the
# 9th is inserted with every 128-byte vec refused, so no child gets its point vec.
var _al_qs = quadtree_new(0, 0, f64_from(10), f64_from(10), 4);
for (var i = 0; i < 8; i = i + 1) {
    var _al_qst, _al_qsv = quadtree_insert(_al_qs, f64_from(i + 1), f64_from(i + 1), i);
}
ALLOC_MAX = 127;
var _al_q9t, _al_q9v = quadtree_insert(_al_qs, F64_HALF, F64_HALF, 8);
ALLOC_MAX = _al_keep;
assert_eq(is_err_result(_al_q9t), 0, "quadtree_insert: the 9th point is stored though its split was refused");
assert_eq(_qt_node_is_split(load64(_al_qs)), 0, "quadtree: a refused split leaves the root a leaf");
assert_eq(vec_len(quadtree_query(_al_qs, 0, 0, f64_from(10), f64_from(10))), 9,
  "quadtree: every one of the 9 points is still found");
var _al_os = octree_new(_al_mn, _al_mx, 4);
# An octree leaf holds 2 slots per point, so its 9th point would grow the vec (a 256-byte
# request) before the split is reached; the root's vec is grown to 32 slots first.
var _al_orv = _ot_node_points(load64(_al_os));
for (var i = 0; i < 18; i = i + 1) { vec_push(_al_orv, 0); }
vec_truncate(_al_orv, 0);
for (var i = 0; i < 8; i = i + 1) {
    var _al_ost, _al_osv = octree_insert(_al_os, hvec3_new(f64_from(i + 1), f64_from(i + 1), f64_from(i + 1)), i);
}
var _al_o9p = hvec3_new(F64_HALF, F64_HALF, F64_HALF);
ALLOC_MAX = 127;
var _al_o9t, _al_o9v = octree_insert(_al_os, _al_o9p, 8);
ALLOC_MAX = _al_keep;
assert_eq(is_err_result(_al_o9t), 0, "octree_insert: the 9th point is stored though its split was refused");
assert_eq(_ot_node_is_split(load64(_al_os)), 0, "octree: a refused split leaves the root a leaf");
assert_eq(vec_len(octree_query(_al_os, _al_mn, _al_mx)), 9, "octree: every one of the 9 points is still found");

# A spatial hash whose doubled bucket array is refused keeps the table it has. Points go
# into cells (n, 0, 0) until 767 of the 1,024 buckets are occupied; the next point is
# placed in a cell whose bucket is empty, so its insert takes the count to 768 (3/4) and
# asks for 2,048 heads (16 KiB). Its five entry slots must already exist, so the entry
# vec needs no growth on that insert (asserted).
# [measured: src/spatial.cyr, _SH_INIT_BUCKETS and spatial_hash_insert's 3/4 load factor]
var _al_hs = spatial_hash_new(F64_ONE);
var _al_hn = 0;
while (_sh_occupied(_al_hs) < 767) {
    spatial_hash_insert(_al_hs, hvec3_new(f64_from(_al_hn), 0, 0), _al_hn);
    _al_hn = _al_hn + 1;
}
while (_sh_chain_head(_al_hs, _al_hn, 0, 0) >= 0) { _al_hn = _al_hn + 1; }
var _al_hp = hvec3_new(f64_from(_al_hn), 0, 0);
var _al_hev = _sh_entries(_al_hs);
assert_eq(vec_cap(_al_hev) - vec_len(_al_hev) >= 5, 1,
  "spatial_hash fixture: the growing insert needs no entry growth");
ALLOC_MAX = 16383;
spatial_hash_insert(_al_hs, _al_hp, _al_hn);
ALLOC_MAX = _al_keep;
assert_eq(_sh_bucket_count(_al_hs), 1024, "spatial_hash: a refused growth keeps the 1,024-bucket table");
assert_eq(_sh_occupied(_al_hs), 768, "spatial_hash: the insert that asked for growth is stored");
var _al_hq = spatial_hash_query_cell(_al_hs, _al_hp);
assert_eq(vec_len(_al_hq), 1, "spatial_hash: the point whose insert asked for growth is found");
assert_eq(vec_get(_al_hq, 0), _al_hn, "spatial_hash: ... with its own data");
var _al_hq0 = spatial_hash_query_cell(_al_hs, hvec3_new(0, 0, 0));
assert_eq(vec_get(_al_hq0, 0), 0, "spatial_hash: the first point is found in the ungrown table");

# halfedge_from_triangles: the twin table's bound is ALLOC_MAX / 8 slots, checked before
# anything is built. The 2-triangle mesh needs 16 slots (128 bytes); with ALLOC_MAX at 127
# the bound refuses it and the call allocates nothing at all. Without the bound the
# three working vecs would be asked first and the alloc counter would move.
ALLOC_MAX = 127;
var _al_hu0 = alloc_used();
var _al_hb = halfedge_from_triangles(_al_tri, 2, 4);
var _al_hu1 = alloc_used();
ALLOC_MAX = _al_keep;
assert_eq(_al_hb, 0, "halfedge_from_triangles: a twin table past ALLOC_MAX / 8 slots -> 0");
assert_eq(_al_hu1 - _al_hu0, 0, "halfedge_from_triangles: refused before any allocation");
assert_neq(_al_he, 0, "halfedge_from_triangles: the same mesh with the heap open builds");

# === 3.4.0: the functions with no channel for a refused allocation no longer allocate ===
test_group("3.4.0 abuse: value-returning functions answer with every allocation refused");

# Each returns a value, not a handle, so a refused allocation had nothing to answer with;
# each stored through one unchecked through 3.3.7 (exit 139 with ALLOC_MAX below its
# request). Their scratch is on the stack now, so with ALLOC_MAX at 0 -- every request
# refused -- they answer exactly what they answer with the heap open.
# [measured: scratch exhaustion probes (nc_*.tcyr) on the 3.4.0 base and this tree, 2026-10-31; cycc 6.7.9]
var _al_coef = alloc(72);
for (var i = 0; i < 9; i = i + 1) { store64(_al_coef + i * 8, f64_from(i + 1)); }
var _al_shv = sh_evaluate_l2(_al_coef, _al_a3);
var _al_lcv = levi_civita_4(2, 0, 3, 1);
var _al_lv = lorentz_is_valid(_al_lor);
var _al_sx = simplex_3d(F64_HALF, f64_from(3), f64_div(F64_ONE, f64_from(3)));
_GRAD3_READY = 0;    # the gradient table is filled again, under the refusing heap
# simplex_3d also reads calc.cyr's noise_perm table, which is still allocated on first use
# (512 bytes, unchecked): it must exist before the heap is refused.
var _al_np = noise_perm(0);
ALLOC_MAX = 0;
var _al_shv0 = sh_evaluate_l2(_al_coef, _al_a3);
var _al_lcv0 = levi_civita_4(2, 0, 3, 1);
var _al_lv0 = lorentz_is_valid(_al_lor);
var _al_sx0 = simplex_3d(F64_HALF, f64_from(3), f64_div(F64_ONE, f64_from(3)));
ALLOC_MAX = _al_keep;
assert_eq(_al_shv0, _al_shv, "sh_evaluate_l2: the same bits with every allocation refused");
assert_eq(_al_lcv0, f64_neg(F64_ONE), "levi_civita_4(2,0,3,1): -1 (three inversions) with every allocation refused");
assert_eq(_al_lcv, f64_neg(F64_ONE), "levi_civita_4(2,0,3,1): -1 with the heap open");
assert_eq(_al_lv0, 1, "lorentz_is_valid: a boost is valid with every allocation refused");
assert_eq(_al_lv, 1, "lorentz_is_valid: a boost is valid with the heap open");
# kdtree_nearest's best slot and its leaves' distance vectors are on the stack (the
# vectors since the review repairs), so a query allocates nothing (3.3.7: 16 + 24 bytes
# for a one-point tree).
var _al_k1p = alloc(8);
store64(_al_k1p, _al_a3);
var _al_k1t = kdtree_build(_al_k1p, 1);
var _al_ku0 = alloc_used();
var _al_kn = kdtree_nearest(_al_k1t, _al_k1p, _al_b3);
var _al_ku1 = alloc_used();
assert_eq(_al_kn, 0, "kdtree_nearest on a one-point tree: index 0");
assert_eq(_al_ku1 - _al_ku0, 0, "kdtree_nearest: no heap best slot and no heap difference vector");
assert_eq(_al_sx0, _al_sx, "simplex_3d: the same bits when its table is filled under a refusing heap");
assert_eq(_GRAD3_READY, 1, "simplex_3d: the table was filled again");

# === 3.4.0: a heap exhausted for real reaches the checks ALLOC_MAX cannot ===
test_group("3.4.0 abuse: the null checks behind a derived bound, under an exhausted heap");

# ALLOC_MAX refuses only a request LARGER than it, so it cannot reach a null check that
# sits behind a bound derived from ALLOC_MAX (that bound is alloc's own refusal line), nor
# one after a larger request in the same call. _al_exhaust_after(k) leaves exactly k bytes
# in the bump allocator's current chunk and makes every new chunk refused, which is the
# heap of a machine whose mmap refuses: requests succeed while they fit in k and the first
# that does not answers 0. Each k below is the sum of the requests the call makes before
# the one it refuses (vec_new = 24 + 128).
# ⚠ It sets lib/alloc.cyr's Linux internals (_heap_ptr, _heap_end, _linux_grain,
# _LINUX_CHUNK_SMALL): a stdlib that renames them fails this suite at compile time.
var _al_grain_keep = 0;
var _al_small_keep = 0;
var _al_sink = 0;
fn _al_exhaust_after(k) {
    _al_grain_keep = _linux_grain;
    _al_small_keep = _LINUX_CHUNK_SMALL;
    if (_heap_end - _heap_ptr < k + 8) {
        # Open a fresh 64 KiB chunk so that k bytes can be left in it (a sweep opens one per
        # point, so the chunk is kept small). 64 KiB is the grain chosen here, not measured.
        # [measured: lib/alloc.cyr, _linux_new_chunk rounds a request up to the grain]
        _linux_grain = 0x10000;
        _al_sink = alloc(_heap_end - _heap_ptr + 8);
    }
    var room = _heap_end - _heap_ptr;
    if (room > k) { _al_sink = alloc(room - k); }
    # A grain of 2^62 bytes is past every address space, so the new-chunk mmap fails;
    # with the small grain equal to it, alloc takes no retry and answers 0.
    _linux_grain = 0x4000_0000_0000_0000;
    _LINUX_CHUNK_SMALL = 0x4000_0000_0000_0000;
    return _heap_end - _heap_ptr;
}
fn _al_exhaust_end() {
    _linux_grain = _al_grain_keep;
    _LINUX_CHUNK_SMALL = _al_small_keep;
    return 0;
}
# The instrument first: 64 bytes left means a 64-byte request succeeds and the next
# 8-byte one is refused, and the heap opens again afterwards.
var _al_room = _al_exhaust_after(64);
var _al_pc1 = alloc(64);
var _al_pc2 = alloc(8);
_al_exhaust_end();
var _al_pc3 = alloc(8);
assert_eq(_al_room, 64, "exhaust instrument: exactly 64 bytes left in the chunk");
assert_neq(_al_pc1, 0, "exhaust instrument: a request that fits succeeds");
assert_eq(_al_pc2, 0, "exhaust instrument: the first request past it is refused");
assert_neq(_al_pc3, 0, "exhaust instrument: the heap opens again afterwards");

# detect_islands(0, 0, 4): result 152, then union-find 16 + 32 + 32, the component map 32,
# then one 152-byte vec per island.
var _al_dk: i64[5];
store64(&_al_dk, 152); store64(&_al_dk + 8, 168); store64(&_al_dk + 16, 200);
store64(&_al_dk + 24, 232); store64(&_al_dk + 32, 264);
for (var i = 0; i < 5; i = i + 1) {
    _al_exhaust_after(load64(&_al_dk + i * 8));
    var _al_di = detect_islands(0, 0, 4);
    _al_exhaust_end();
    assert_neq(_al_di, 0, "detect_islands, heap exhausted mid-call: the result vec itself");
    assert_eq(vec_len(_al_di), 0, "detect_islands, heap exhausted mid-call: the empty result, no store through 0");
}
assert_eq(vec_len(detect_islands(0, 0, 4)), 4, "detect_islands(0, 0, 4) with the heap open: 4 islands");

# halfedge_from_triangles(2 triangles, 4 vertices): three vecs (152 each), six half-edges
# (32 each), the three twin arrays (128 each), the mesh handle (24).
var _al_hk: i64[9];
store64(&_al_hk, 0); store64(&_al_hk + 8, 152); store64(&_al_hk + 16, 304);
store64(&_al_hk + 24, 456); store64(&_al_hk + 32, 648); store64(&_al_hk + 40, 776);
store64(&_al_hk + 48, 904); store64(&_al_hk + 56, 1032); store64(&_al_hk + 64, 520);
for (var i = 0; i < 9; i = i + 1) {
    _al_exhaust_after(load64(&_al_hk + i * 8));
    var _al_hi = halfedge_from_triangles(_al_tri, 2, 4);
    _al_exhaust_end();
    assert_eq(_al_hi, 0, "halfedge_from_triangles, heap exhausted mid-build -> 0");
}

# delaunay_2d on 4 in-band sites: result, then eleven 152-byte working vecs; the
# empty result for each. Out of band (2^300) the scaled copy comes first: its vec, then
# one 16-byte site per point.
var _al_dl = 0;
for (var i = 1; i < 12; i = i + 1) {
    _al_exhaust_after(i * 152);
    _al_dl = delaunay_2d(_alw_pts, 4);
    _al_exhaust_end();
    assert_neq(_al_dl, 0, "delaunay_2d, heap exhausted before the build: the result vec");
    assert_eq(vec_len(_al_dl), 0, "delaunay_2d, heap exhausted before the build: the empty result");
}
var _al_big = vec_new();
var _al_p300 = (1023 + 300) << 52;
vec_push(_al_big, hvec2_new(_al_p300, 0));
vec_push(_al_big, hvec2_new(0, _al_p300));
vec_push(_al_big, hvec2_new(_al_p300, _al_p300));
assert_eq(vec_len(delaunay_2d(_al_big, 3)), 3, "delaunay_2d at 2^300 with the heap open: one triangle");
_al_exhaust_after(192);   # the copy's 24-byte header fits, its 128-byte data does not, a site would
var _al_db0 = delaunay_2d(_al_big, 3);
_al_exhaust_end();
_al_exhaust_after(304);
var _al_db1 = delaunay_2d(_al_big, 3);
_al_exhaust_end();
assert_eq(vec_len(_al_db0), 0, "delaunay_2d at 2^300: a refused scaled copy -> the empty result");
assert_eq(vec_len(_al_db1), 0, "delaunay_2d at 2^300: a refused scaled site -> the empty result");

# convex_hull_2d and triangulate_polygon: their second and third working vecs.
_al_exhaust_after(152);
var _al_ch0 = convex_hull_2d(_alw_pts, 4);
_al_exhaust_end();
_al_exhaust_after(304);
var _al_ch1 = convex_hull_2d(_alw_pts, 4);
_al_exhaust_end();
_al_exhaust_after(152);
var _al_tp0 = triangulate_polygon(_alw_pts, 4);
_al_exhaust_end();
assert_eq(vec_len(_al_ch0), 0, "convex_hull_2d: a refused sort vec -> the empty result");
assert_eq(vec_len(_al_ch1), 0, "convex_hull_2d: a refused hull vec -> the empty result");
assert_eq(vec_len(_al_tp0), 0, "triangulate_polygon: a refused index vec -> the empty (partial) result");

# kdtree_build on 2 points: the index vec (152), the plane slot (8), then three nodes of
# 40: the left leaf, the right leaf, the split. A split holding a 0 child would drop that
# half of the points from every query, so each refusal is the whole tree's 0.
var _al_kk: i64[4];
store64(&_al_kk, 160); store64(&_al_kk + 8, 200); store64(&_al_kk + 16, 240); store64(&_al_kk + 24, 152);
for (var i = 0; i < 4; i = i + 1) {
    _al_exhaust_after(load64(&_al_kk + i * 8));
    var _al_ki = kdtree_build(_al_kp, 2);
    _al_exhaust_end();
    assert_eq(_al_ki, 0, "kdtree_build, heap exhausted mid-build -> 0, never a tree missing a subtree");
}

# tensor_contract: the scalar branch's index buffer (after 8 + 32 + 8 + 8) and the strides
# of a rank-2 result (after 24 + 32 + 16 + 32).
var _al_t33 = tensor_new(2, _al_sh33);
_al_exhaust_after(56);
var _al_tc0 = tensor_contract(_al_t33, 0, 1);
_al_exhaust_end();
_al_exhaust_after(104);
var _al_tc1 = tensor_contract(_al_t4, 0, 1);
_al_exhaust_end();
assert_eq(_al_tc0, 0, "tensor_contract, a full trace: a refused index buffer -> 0");
assert_eq(_al_tc1, 0, "tensor_contract: refused output strides -> 0");

# The geodesic integrators' stage arrays, 16 bytes each at dim 2: geodesic_rk4 asks x, u,
# then ten; parallel_transport v, then five.
for (var i = 1; i < 12; i = i + 1) {
    _al_exhaust_after(i * 16);
    var _al_gi = geodesic_rk4(_al_st, _al_chr, 2, F64_HALF, 1);
    _al_exhaust_end();
    assert_eq(_al_gi, 0, "geodesic_rk4, heap exhausted at a working array -> 0");
}
for (var i = 1; i < 6; i = i + 1) {
    _al_exhaust_after(i * 16);
    var _al_pi = parallel_transport(_al_vel, _al_vel, _al_chr, 2, F64_HALF, 1);
    _al_exhaust_end();
    assert_eq(_al_pi, 0, "parallel_transport, heap exhausted at a stage array -> 0");
}

# The containers' later requests: quadtree_query's query bounds (after its result vec),
# spatial_hash_new's entry vec (after 48 + 8,192), and quadtree_new's bounds.
# [measured: src/spatial.cyr, the requests of quadtree_query and spatial_hash_new]
_al_exhaust_after(152);
var _al_qq = quadtree_query(_al_qt, 0, 0, f64_from(10), f64_from(10));
_al_exhaust_end();
_al_exhaust_after(8240);
var _al_hh = spatial_hash_new(F64_ONE);
_al_exhaust_end();
assert_eq(_al_qq, 0, "quadtree_query: refused query bounds -> 0");
assert_eq(_al_hh, 0, "spatial_hash_new: a refused entry vec -> 0");

# === 3.4.0: every exhaustion point, and the review repairs ===
test_group("3.4.0 abuse: every exhaustion point answers the designed failure or the answer");

# The review of lane AL ran each composite at every 8-byte exhaustion point and found
# crashes and null-membered results after the first refusal: a check on a function's own
# allocation is not enough when the next line reads a temporary another constructor
# returned. Each function below is now swept the same way in this suite: _al_exhaust_after(k)
# for k = 0, 8, 16, ... until the call answers; every earlier point must be the designed
# failure (0, or the empty result where that is the documented one), never a crash and never
# an object with a 0 inside. Functions that also allocate in mat3 / mat4 / quat / geo are
# swept outside the suite until those files check their own allocations.
# [measured: scratch sweep of every 8-byte point, AL2 and AL2 with the FB / RT files, 2026-10-31; cycc 6.7.9]
var _x2_a3 = hvec3_new(F64_ONE, F64_TWO, f64_from(3));
var _x2_b3 = hvec3_new(f64_from(4), f64_from(5), f64_from(7));
var _x2_a2 = hvec2_new(F64_ONE, F64_TWO);
var _x2_b2 = hvec2_new(f64_from(4), f64_from(7));
var _x2_s3 = hvec3_new(0x0000_0000_0000_0003, 0x0000_0000_0000_0005, 0);
var _x2_s2 = hvec2_new(0x0000_0000_0000_0003, 0x0000_0000_0000_0005);
var _x2_s4 = hvec4_new(0x0000_0000_0000_0003, 0x0000_0000_0000_0005, 0, 0);
var _x2_g3 = hvec3_new(0x7FEF_FFFF_FFFF_FFFF, 0x7FEF_FFFF_FFFF_FFFF, 0);
var _x2_g2 = hvec2_new(0x7FEF_FFFF_FFFF_FFFF, 0x7FEF_FFFF_FFFF_FFFF);
var _x2_g4 = hvec4_new(0x7FEF_FFFF_FFFF_FFFF, 0x7FEF_FFFF_FFFF_FFFF, 0, 0);
var _x2_cm = cmat_new(2, 2);
var _x2_cn = cmat_new(2, 2);
for (var i = 0; i < 2; i = i + 1) {
    for (var j = 0; j < 2; j = j + 1) {
        cmat_set(_x2_cm, i, j, cx_new(f64_from(i + 2 * j + 1), f64_from(j - i)));
        cmat_set(_x2_cn, i, j, cx_new(f64_div(F64_ONE, f64_from(i + j + 2)), f64_from(i * j)));
    }
}
var _x2_cv = alloc(32);
for (var i = 0; i < 4; i = i + 1) { store64(_x2_cv + i * 8, f64_from(i + 1)); }
var _x2_su = su2_from_axis_angle(hvec3_new(F64_ONE, F64_TWO, F64_ONE), F64_HALF);
var _x2_su2 = su2_from_axis_angle(hvec3_new(0, F64_ONE, F64_TWO), F64_ONE);
var _x2_se = se3_new(_x2_su, _x2_a3);
var _x2_se2 = se3_new(_x2_su2, _x2_b3);
var _x2_tw = se3_twist_new(hvec3_new(F64_HALF, f64_div(F64_ONE, f64_from(3)), f64_div(F64_ONE, f64_from(5))), _x2_b3);
var _x2_lor = lorentz_boost_x(F64_HALF);
var _x2_v4 = alloc(32);
for (var i = 0; i < 4; i = i + 1) { store64(_x2_v4 + i * 8, f64_from(i + 1)); }
var _x2_vx = str_from("x");
var _x2_x = expr_var(_x2_vx);
var _x2_ex = expr_add(expr_pow(expr_sin(_x2_x), expr_const(F64_TWO)), expr_pow(expr_cos(_x2_x), expr_const(F64_TWO)));
_x2_ex = expr_add(_x2_ex, expr_mul(expr_const(f64_from(3)), expr_pow(_x2_x, expr_const(F64_TWO))));
var _x2_poly = expr_add(expr_mul(expr_const(f64_from(3)), expr_pow(_x2_x, expr_const(F64_TWO))), expr_neg(_x2_x));
var _x2_rules = sym_default_rules();
var _x2_rw = sym_rewrite(_x2_ex, _x2_rules);
var _x2_int = sym_integrate(_x2_poly, _x2_vx);
assert_eq(_sym_expr_equal(_x2_rw, _x2_ex), 0, "sweep fixture: sym_rewrite rewrites sin^2 + cos^2 (heap open)");
assert_neq(_x2_int, 0, "sweep fixture: sym_integrate integrates 3x^2 - x (heap open)");
var _x2_pw = pat_add(pat_wildcard(str_from("a")), pat_wildcard(str_from("b")));
var _x2_kp = alloc(40);
for (var i = 0; i < 5; i = i + 1) {
    store64(_x2_kp + i * 8, hvec3_new(f64_from(i), f64_from(5 - i), f64_from(i * i)));
}
var _x2_kd = kdtree_build(_x2_kp, 5);
var _x2_qt = quadtree_new(0, 0, f64_from(10), f64_from(10), 4);
for (var i = 0; i < 12; i = i + 1) {
    var _x2_qtt, _x2_qtv = quadtree_insert(_x2_qt, f64_from(i % 10), f64_from((i * 3) % 10), i);
}
var _x2_sh = spatial_hash_new(F64_ONE);
for (var i = 0; i < 12; i = i + 1) { spatial_hash_insert(_x2_sh, hvec3_new(f64_from(i % 3), 0, 0), i); }
var _x2_m3 = so3_from_axis_angle(hvec3_new(F64_ONE, F64_ONE, 0), F64_HALF);
var _x2_ray = geo_ray_new(hvec3_new(f64_div(F64_ONE, f64_from(4)), f64_div(f64_from(3), f64_from(8)), f64_from(0 - 5)),
  hvec3_new(0, 0, F64_ONE));
var _x2_miss = geo_ray_new(hvec3_new(f64_from(5), f64_from(5), f64_from(0 - 5)), hvec3_new(0, 0, F64_ONE));
var _x2_sph = geo_sphere_new(hvec3_new(0, 0, 0), F64_ONE);
var _x2_pln = geo_plane_from_point_normal(hvec3_new(0, 0, 0), hvec3_new(0, 0, F64_ONE));
var _x2_box = geo_aabb_new(hvec3_new(f64_neg(F64_ONE), f64_neg(F64_ONE), f64_neg(F64_ONE)),
  hvec3_new(F64_ONE, F64_ONE, F64_ONE));
var _x2_js = geo_jet_sphere(_x2_ray, _x2_sph);
var _x2_cxb = cx_new(0x7FE0_0000_0000_0000, 0x7FD0_0000_0000_0000);
var _x2_cxs = cx_new(0x0000_0000_0000_0007, 0x0000_0000_0000_0003);
var _x2_d3 = hvec3_distance(_x2_a3, _x2_b3);
var _x2_d2 = hvec2_distance(_x2_a2, _x2_b2);
assert_eq(_x2_d3, f64_sqrt(f64_from(9 + 9 + 16)), "hvec3_distance (1,2,3)-(4,5,7): sqrt(34), with the heap open");
assert_eq(_x2_d2, f64_sqrt(f64_from(9 + 25)), "hvec2_distance (1,2)-(4,7): sqrt(34), with the heap open");

# 0 = the designed failure, 1 = the answer, 2 = an object with a 0 inside or a wrong value.
fn _x2_h(r) {
    if (r == 0) { return 0; }
    return 1;
}
fn _x2_se3(se) {
    if (se == 0) { return 0; }
    if (load64(se) == 0 || load64(se + 8) == 0) { return 2; }
    return 1;
}
fn _x2_jet(j) {
    if (j == 0) { return 0; }
    if (geo_jet_dorigin(j) == 0 || geo_jet_ddirection(j) == 0 || _GeoJet_sv(j) == 0) { return 2; }
    var kd = geo_jet_kind(j);
    if (kd == GEO_JET_SPHERE || kd == GEO_JET_PLANE) { return 1; }
    if (_GeoJet_sv1(j) == 0 || _GeoJet_sv2(j) == 0) { return 2; }
    return 1;
}
fn _x2_run(c) {
    if (c == 1) { return _x2_h(gamma_spatial(1)); }
    if (c == 2) { return _x2_h(gamma_spatial(0)); }
    if (c == 3) { return _x2_h(gamma_spatial(2)); }
    if (c == 4) { return _x2_h(pauli_x()); }
    if (c == 5) { return _x2_h(pauli_y()); }
    if (c == 6) { return _x2_h(pauli_z()); }
    if (c == 7) { return _x2_h(gamma_0()); }
    if (c == 8) { return _x2_h(gamma_5()); }
    if (c == 9) { return _x2_h(gell_mann(7)); }
    if (c == 10) { return _x2_h(gell_mann(1)); }
    if (c == 11) { return _x2_h(cmat_mul(_x2_cm, _x2_cn)); }
    if (c == 12) { return _x2_h(cmat_mul_vec(_x2_cm, _x2_cv)); }
    if (c == 13) { return _x2_h(cmat_adjoint(_x2_cm)); }
    if (c == 14) { return _x2_h(cmat_trace(_x2_cm)); }
    if (c == 15) { return _x2_h(cmat_scale(_x2_cm, cx_i())); }
    if (c == 16) { return _x2_h(cmat_add(_x2_cm, _x2_cn)); }
    if (c == 17) { return _x2_h(cmat_sub(_x2_cm, _x2_cn)); }
    if (c == 18) { return _x2_h(cmat_kronecker(_x2_cm, _x2_cn)); }
    if (c == 19) { return _x2_h(cmat_exp(_x2_cn)); }
    if (c == 20) { return _x2_h(cmat_identity(3)); }
    if (c == 21) { return _x2_h(cmat_commutator(_x2_cm, _x2_cn)); }
    if (c == 22) { return _x2_h(bch_2nd_order(_x2_cm, _x2_cn)); }
    if (c == 23) { return _x2_h(bch_3rd_order(_x2_cm, _x2_cn)); }
    if (c == 24) { return _x2_h(cx_sqrt(_x2_cxb)); }
    if (c == 25) { return _x2_h(cx_sqrt(_x2_cxs)); }
    if (c == 26) { return _x2_h(su2_adjoint(_x2_su, _x2_a3)); }
    if (c == 27) { return _x2_se3(se3_compose(_x2_se, _x2_se2)); }
    if (c == 28) { return _x2_se3(se3_inverse(_x2_se)); }
    if (c == 29) { return _x2_h(se3_transform_point(_x2_se, _x2_b3)); }
    if (c == 30) { return _x2_se3(se3_identity()); }
    if (c == 31) { return _x2_h(se3_adjoint(_x2_se, _x2_tw)); }
    if (c == 32) { return _x2_h(lerp_srgb_vec3(_x2_a3, _x2_b3, F64_HALF)); }
    if (c == 33) { return _x2_h(hvec3_normalize(_x2_s3)); }
    if (c == 34) { return _x2_h(hvec3_normalize(_x2_g3)); }
    if (c == 35) { return _x2_h(hvec2_normalize(_x2_s2)); }
    if (c == 36) { return _x2_h(hvec2_normalize(_x2_g2)); }
    if (c == 37) { return _x2_h(hvec4_normalize(_x2_s4)); }
    if (c == 38) { return _x2_h(hvec4_normalize(_x2_g4)); }
    if (c == 39) { return _x2_h(hvec3_reflect(_x2_a3, _x2_b3)); }
    if (c == 40) { return _x2_h(hvec3_reject(_x2_a3, _x2_b3)); }
    if (c == 41) {
        if (hvec3_distance(_x2_a3, _x2_b3) == _x2_d3) { return 1; }
        return 2;
    }
    if (c == 42) {
        if (hvec2_distance(_x2_a2, _x2_b2) == _x2_d2) { return 1; }
        return 2;
    }
    if (c == 43) {
        var rs = sym_default_rules();
        if (rs == 0) { return 0; }
        for (var i = 0; i < vec_len(rs); i = i + 1) {
            if (vec_get(rs, i) == 0) { return 2; }
        }
        return 1;
    }
    if (c == 44) {
        # by value: a refusal read as "no match" would answer an unrewritten tree
        var rw = sym_rewrite(_x2_ex, _x2_rules);
        if (rw == 0) { return 0; }
        if (_sym_expr_equal(rw, _x2_rw) == 1) { return 1; }
        return 2;
    }
    if (c == 45) {
        var ig = sym_integrate(_x2_poly, _x2_vx);
        if (ig == 0) { return 0; }
        if (_sym_expr_equal(ig, _x2_int) == 1) { return 1; }
        return 2;
    }
    if (c == 46) { return sym_match(_x2_pw, _x2_ex); }
    if (c == 47) { return _x2_h(sym_match_bindings(_x2_pw, _x2_ex)); }
    if (c == 48) { return _x2_h(kdtree_within_radius(_x2_kd, _x2_kp, _x2_a3, f64_from(4))); }
    if (c == 49) {
        if (kdtree_nearest(_x2_kd, _x2_kp, _x2_a3) >= 0) { return 1; }
        return 2;
    }
    if (c == 50) { return _x2_h(quadtree_query(_x2_qt, 0, 0, f64_from(10), f64_from(10))); }
    if (c == 51) { return _x2_h(spatial_hash_query_radius(_x2_sh, _x2_a3, F64_TWO)); }
    if (c == 52) { return _x2_h(lorentz_transform_4vec(_x2_lor, _x2_v4)); }
    if (c == 53) { return _x2_h(so3_log(_x2_m3)); }
    if (c == 54) { return _x2_jet(geo_jet_sphere(_x2_ray, _x2_sph)); }
    if (c == 55) { return _x2_jet(geo_jet_sphere(_x2_miss, _x2_sph)); }
    if (c == 56) { return _x2_jet(geo_jet_plane(_x2_ray, _x2_pln)); }
    if (c == 57) { return _x2_jet(geo_jet_aabb(_x2_ray, _x2_box)); }
    if (c == 58) { return _x2_h(geo_jet_dpoint(_x2_js, _x2_ray, _x2_a3, _x2_b3)); }
    if (c == 59) { return _x2_h(geo_jet_dt_dd_unit(_x2_a3, _x2_b3)); }
    return 2;
}
# Sweep case c: the number of bad points, and -1 if the call never answered.
var _x2_k_answer = 0;
fn _x2_sweep(c) {
    var bad = 0;
    var k = 0;
    while (k <= 16384) {
        _al_exhaust_after(k);
        var v = _x2_run(c);
        _al_exhaust_end();
        if (v == 2) { bad = bad + 1; }
        if (v == 1) {
            _x2_k_answer = k;
            return bad;
        }
        k = k + 8;
    }
    return 0 - 1;
}
var _x2_points = 0;
for (var c = 1; c <= 59; c = c + 1) {
    var _x2_b = _x2_sweep(c);
    assert_eq(_x2_b, 0, "3.4.0 exhaustion sweep: no bad result, and an answer in the end (case = the loop's c)");
    _x2_points = _x2_points + _x2_k_answer / 8 + 1;
}
assert_eq(_x2_points > 3000, 1, "3.4.0 exhaustion sweep: the 59 cases reached over 3,000 exhaustion points");
# The answers, with the heap open, are the answers: the sweep's last point is checked
# by value where the call returns one.
assert_eq(hvec3_distance(_x2_a3, _x2_b3), _x2_d3, "hvec3_distance: no heap needed, the same bits");

# SF2 of the review: detect_islands' union-find check, live with a contact to read it.
var _al_dc = vec_new();
vec_push(_al_dc, contact_new_fric(0, 1, _al_a3, F64_ONE, F64_HALF, F64_HALF, F64_ONE, F64_ONE, 0));
_al_exhaust_after(152);    # the result vec fits; the union-find's 16-byte header does not
var _al_dci = detect_islands(_al_dc, 1, 4);
_al_exhaust_end();
assert_neq(_al_dci, 0, "detect_islands, union-find refused: the result vec");
assert_eq(vec_len(_al_dci), 0, "detect_islands, union-find refused: the empty result, no read through 0");

# halfedge_from_triangles' triangle count, as a division: n_tris = 0x5555555555555556 makes
# n_tris * 3 wrap to 2, so a 3-entry vec passed the old guard and the index scan read past it
# ("vec: index out of bounds", exit 1).
# [measured: lane AL review (N8) on the 3.4.0 base and this tree's mutant of the guard, 2026-10-31; cycc 6.7.9]
var _al_ht = vec_new();
vec_push(_al_ht, 0); vec_push(_al_ht, 1); vec_push(_al_ht, 2);
assert_eq(halfedge_from_triangles(_al_ht, 0x5555555555555556, 3), 0,
  "halfedge_from_triangles: n_tris whose * 3 wraps to 2 -> 0 (was exit 1)");
assert_eq(halfedge_from_triangles(_al_ht, 2, 3), 0, "halfedge_from_triangles: 2 triangles from 3 entries -> 0");
assert_neq(halfedge_from_triangles(_al_ht, 1, 3), 0, "halfedge_from_triangles: 1 triangle from 3 entries builds");

# The octree routes a point without allocating: a split node's centre is formed on the
# stack (3.4.0; it was geo_aabb_center, two heap vectors, read unchecked). An octree split
# by 9 points takes a 10th, into an empty octant, with every allocation refused.
var _x2_ot = octree_new(hvec3_new(0, 0, 0), hvec3_new(f64_from(10), f64_from(10), f64_from(10)), 4);
for (var i = 0; i < 9; i = i + 1) {
    var _x2_ott, _x2_otv = octree_insert(_x2_ot, hvec3_new(f64_from(i), f64_from(i), f64_from(i)), i);
}
var _x2_op = hvec3_new(f64_from(9), F64_HALF, F64_HALF);
assert_eq(_ot_node_is_split(load64(_x2_ot)), 1, "octree fixture: 9 points split the root");
_al_exhaust_after(0);
var _x2_o10t, _x2_o10v = octree_insert(_x2_ot, _x2_op, 9);
_al_exhaust_end();
assert_eq(is_err_result(_x2_o10t), 0, "octree_insert into a split root with every allocation refused: Ok");
var _x2_oq = octree_query(_x2_ot, hvec3_new(0, 0, 0), hvec3_new(f64_from(10), f64_from(10), f64_from(10)));
assert_eq(vec_len(_x2_oq), 10, "octree: the 10th point, routed with no heap, is found with the other 9");

# ⛔ 3.4.0 (review R2C) — bvh_build ended the process at 115 of 232 exhaustion points (an
# unchecked vec_new, and vec_push's exit on a refused growth), and bvh_query_ray and
# bvh_query_aabb at all 19 before their first success. ⭐ Every k below each one's first
# success is now its designed 0, and the tree or list at that success is the heap-open one.
# [measured: review-R2C gprobe.tcyr cases 3 to 5 with AL2-xsweep.py, merged tree and lane CO4; 2026-10-31]
var _co4_bx = alloc(64);
for (var i = 0; i < 8; i = i + 1) {
    store64(_co4_bx + i * 8, geo_aabb_new(hvec3_new(f64_from(i), f64_from(i), f64_from(i)),
        hvec3_new(f64_from(i + 1), f64_from(i + 2), f64_from(i + 3))));
}
var _co4_rq = geo_ray_new(hvec3_new(f64_neg(F64_ONE), f64_neg(F64_ONE), f64_neg(F64_ONE)), hvec3_one());
var _co4_bv = bvh_build(_co4_bx, 8);
var _co4_nr = vec_len(bvh_query_ray(_co4_bv, _co4_rq));
var _co4_na = vec_len(bvh_query_aabb(_co4_bv, load64(_co4_bx)));
assert_eq(_co4_nr > 0 && _co4_na > 0, 1, "bvh exhaustion fixture: the heap-open tree answers both queries");
# For each call, the first k (in steps of 8) at which it answers, the count of 0 answers
# before it, and whether that answer is the heap-open one.
var _co4_xk: i64[3];
var _co4_xf: i64[3];
var _co4_xs: i64[3];
for (var c = 0; c < 3; c = c + 1) {
    _co4_xk[c] = 0 - 1;
    _co4_xf[c] = 0;
    _co4_xs[c] = 0;
    for (var k = 0; k <= 8000 && _co4_xk[c] < 0; k = k + 8) {
        _al_exhaust_after(k);
        var xr = 0;
        if (c == 0) { xr = bvh_build(_co4_bx, 8); }
        if (c == 1) { xr = bvh_query_ray(_co4_bv, _co4_rq); }
        if (c == 2) { xr = bvh_query_aabb(_co4_bv, load64(_co4_bx)); }
        _al_exhaust_end();
        if (xr == 0) {
            _co4_xf[c] = _co4_xf[c] + 1;
        } else {
            _co4_xk[c] = k;
            if (c == 0) { _co4_xs[c] = vec_len(bvh_query_ray(xr, _co4_rq)) == _co4_nr; }
            if (c == 1) { _co4_xs[c] = vec_len(xr) == _co4_nr; }
            if (c == 2) { _co4_xs[c] = vec_len(xr) == _co4_na; }
        }
    }
}
assert_eq(_co4_xk[0] > 0 && _co4_xf[0] == _co4_xk[0] / 8, 1,
  "bvh_build: every exhaustion point before its first success answers 0 (was exit 1 / SIGSEGV)");
assert_eq(_co4_xs[0], 1, "bvh_build: ... and the tree it then builds answers the ray as the heap-open one");
assert_eq(_co4_xk[1] > 0 && _co4_xf[1] == _co4_xk[1] / 8, 1,
  "bvh_query_ray: every exhaustion point before its first success answers 0 (was SIGSEGV)");
assert_eq(_co4_xs[1], 1, "bvh_query_ray: ... and the list it then answers is the heap-open one");
assert_eq(_co4_xk[2] > 0 && _co4_xf[2] == _co4_xk[2] / 8, 1,
  "bvh_query_aabb: every exhaustion point before its first success answers 0 (was SIGSEGV)");
assert_eq(_co4_xs[2], 1, "bvh_query_aabb: ... and the list it then answers is the heap-open one");
# And 20 boxes on the ray and in the query box, so that the result vec grows (from 16 slots)
# while it is filled: a refused growth is the query's 0 there too.
var _co4_b20 = alloc(160);
for (var i = 0; i < 20; i = i + 1) {
    store64(_co4_b20 + i * 8, geo_aabb_new(hvec3_new(f64_from(i), f64_from(i), f64_from(i)),
        hvec3_new(f64_from(i + 1), f64_from(i + 1), f64_from(i + 1))));
}
var _co4_v20 = bvh_build(_co4_b20, 20);
var _co4_q20 = geo_aabb_new(hvec3_new(f64_neg(F64_ONE), f64_neg(F64_ONE), f64_neg(F64_ONE)),
  hvec3_new(f64_from(30), f64_from(30), f64_from(30)));
assert_eq(vec_len(bvh_query_ray(_co4_v20, _co4_rq)) == 20 && vec_len(bvh_query_aabb(_co4_v20, _co4_q20)) == 20, 1,
  "bvh 20-box fixture: the ray and the box each meet all 20");
var _co4_g0 = 0;
var _co4_gs = 0;
for (var k = 0; k <= 4000 && _co4_gs < 2; k = k + 8) {
    _al_exhaust_after(k);
    var gr = bvh_query_ray(_co4_v20, _co4_rq);
    var ga = bvh_query_aabb(_co4_v20, _co4_q20);
    _al_exhaust_end();
    _co4_gs = 0;
    if (gr != 0) { _co4_gs = _co4_gs + 1; if (vec_len(gr) != 20) { _co4_g0 = _co4_g0 + 1; } }
    if (ga != 0) { _co4_gs = _co4_gs + 1; if (vec_len(ga) != 20) { _co4_g0 = _co4_g0 + 1; } }
}
assert_eq(_co4_gs == 2 && _co4_g0 == 0, 1,
  "bvh queries meeting 20 boxes: every exhaustion point a 0 or the full list (a refused growth ended the process)");
assert_eq(bvh_build(_co4_bx, VEC_CAP_MAX / 5 + 1), 0,
  "bvh_build: a count whose items would pass VEC_CAP_MAX -> 0 (vec_push_a would end the process)");

var r = assert_summary();
# Clamp before exiting: assert_summary() returns the raw failure COUNT, and a
# wait status is only 8 bits -- an unclamped 256 / 512 / 768 failures would wrap
# to status 0 and score PASS. Any failure at all becomes status 1.
if (r > 0) { r = 1; }
sys_exit_group(r);
