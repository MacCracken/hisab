# einsum's scratch arena (8,208 bytes with its header) is created once; dropped here so
# the next call has to ask for it.
# [measured: lib/alloc.cyr, arena_new: alloc(56) and alloc(capacity + 16)]
var _al_es = alloc(8);
store64(_al_es, _al_t4);
_einsum_arena = 0;
