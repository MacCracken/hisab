# ================================================================
# Num — GCD edge cases
# ================================================================
test_group("edge: num gcd boundary");

assert_eq(num_gcd(0, 5), 5, "gcd(0,5)=5");
assert_eq(num_gcd(5, 0), 5, "gcd(5,0)=5");
assert_eq(num_gcd(0, 0), 0, "gcd(0,0)=0");
assert_eq(num_gcd(1, 1), 1, "gcd(1,1)=1");
assert_eq(num_gcd(1, 100), 1, "gcd(1,100)=1");

# ================================================================
# Num — Modpow edge cases
# ================================================================
test_group("edge: num modpow boundary");

var _rq66t, _rq66v = num_modpow(7, 0, 13);
assert_eq(is_ok(_rq66t), 1, "modpow exp=0 → 1");
assert_eq(_rq66v, 1, "modpow exp=0 → 1");
var _rq67t, _rq67v = num_modpow(7, 1, 13);
assert_eq(is_ok(_rq67t), 1, "modpow exp=1 → base");
assert_eq(_rq67v, 7, "modpow exp=1 → base");
var _rq68t, _rq68v = num_modpow(999, 0, 5);
assert_eq(is_ok(_rq68t), 1, "modpow large^0 → 1");
assert_eq(_rq68v, 1, "modpow large^0 → 1");
var _rq69t, _rq69v = num_modpow(5, 3, 1);
assert_eq(is_ok(_rq69t), 1, "modpow mod=1 → 0");
assert_eq(_rq69v, 0, "modpow mod=1 → 0");

# ================================================================
# Num — is_prime(0) = 0, is_prime(1) = 0
# ================================================================
test_group("edge: num primality boundary");

assert_eq(num_is_prime(0), 0, "is_prime(0)=0");
assert_eq(num_is_prime(1), 0, "is_prime(1)=0");
assert_eq(num_is_prime(2), 1, "is_prime(2)=1");
assert_eq(num_is_prime(4), 0, "is_prime(4)=0");

# The i64-overflow band. Miller-Rabin's squaring step used a raw `(x * x) % n`
# through 2.6.11; x ranges over [0, n-1], so once n > 3037000499 (~sqrt(2^63))
# the product wraps negative and the residue is garbage, failing every witness
# and reporting real primes as COMPOSITE. Every test above is below the band,
# which is why it shipped. These straddle it. (Ground truth cross-checked
# against an independent Miller-Rabin implementation.)
assert_eq(num_is_prime(3037000493), 1, "is_prime: 3037000493 prime (just below overflow band)");
assert_eq(num_is_prime(3037218841), 1, "is_prime: 3037218841 prime (ABOVE overflow band)");
assert_eq(num_is_prime(4294967357), 1, "is_prime: 4294967357 prime (above 2^32)");
assert_eq(num_is_prime(1000000000039), 1, "is_prime: 1000000000039 prime (1e12)");
assert_eq(num_is_prime(3037218843), 0, "is_prime: 3037218843 composite (above band)");
assert_eq(num_is_prime(1000000000037), 0, "is_prime: 1000000000037 composite (1e12)");

# ================================================================
# Num — Sieve(0) and Sieve(1) → empty vec
# ================================================================
test_group("edge: num sieve boundary");

var en_s0 = num_sieve(0);
assert_eq(vec_len(en_s0), 0, "sieve(0) empty");

var en_s1 = num_sieve(1);
assert_eq(vec_len(en_s1), 0, "sieve(1) empty");

var en_s2 = num_sieve(2);
assert_eq(vec_len(en_s2), 1, "sieve(2) has 1 prime");
assert_eq(vec_get(en_s2, 0), 2, "sieve(2) first=2");

# ================================================================
# Num — Kahan sum edge cases
# ================================================================
test_group("edge: num kahan empty/single");

# Empty sum → 0
var en_kdata = alloc(8);
store64(en_kdata, f64_from(42));
var en_k0 = num_kahan_sum(en_kdata, 0);
assert_eq(en_k0, f64_from(0), "kahan empty=0");

# Single element
var en_k1 = num_kahan_sum(en_kdata, 1);
assert_eq(en_k1, f64_from(42), "kahan single=42");

# Neumaier empty
var en_n0 = num_neumaier_sum(en_kdata, 0);
assert_eq(en_n0, f64_from(0), "neumaier empty=0");

# === 3.3.3 R4num: compensated sums with an infinite term ===
test_group("3.3.3 R4num: compensated sums with an infinite term");
# Once a term is infinite the running sum is too, and the compensation formed
# Inf - Inf, so through 3.3.2 a single infinite term made either sum NaN where the
# IEEE sum is that infinity. A non-finite result is now reclassified from the terms:
# infinities of one sign give that infinity, and a NaN term or infinities of both
# signs keep the NaN. Finite terms that overflow give NaN (3.3.3 R5num: the rule, not
# a limit; its block below pins the cases 3.3.2 answered ±Inf). Every "3.3.2:" value
# is a probe of the shipped bundle. NaN results are tested with f64_eq(x, x) == 0: the
# NaN is the one the loop formed, whose sign the hardware picks.
# [measured: scratch probe against dist/hisab.cyr 3.3.2, cycc 6.6.12, 2026-10-01]
var r4s_d = alloc(32);
var r4s_pinf = 0x7FF0000000000000;
var r4s_ninf = 0xFFF0000000000000;
var r4s_max = 0x7FEFFFFFFFFFFFFF;
var r4s_one = 0x3FF0000000000000;
fn _r4s_set(a, b, c, d) {
    store64(r4s_d, a);
    store64(r4s_d + 8, b);
    store64(r4s_d + 16, c);
    store64(r4s_d + 24, d);
    return 0;
}
fn _r4s_isnan(x) { return 1 - f64_eq(x, x); }
_r4s_set(r4s_one, r4s_pinf, r4s_one, 0);
assert_eq(num_kahan_sum(r4s_d, 3), r4s_pinf, "kahan [1, +Inf, 1] = +Inf (3.3.2: NaN)");
assert_eq(num_neumaier_sum(r4s_d, 3), r4s_pinf, "neumaier [1, +Inf, 1] = +Inf (3.3.2: NaN)");
_r4s_set(r4s_pinf, r4s_one, r4s_one, 0);
assert_eq(num_kahan_sum(r4s_d, 3), r4s_pinf, "kahan [+Inf, 1, 1] = +Inf: the infinity is the first term (3.3.2: NaN)");
assert_eq(num_neumaier_sum(r4s_d, 3), r4s_pinf, "neumaier [+Inf, 1, 1] = +Inf (3.3.2: NaN)");
_r4s_set(r4s_one, r4s_ninf, r4s_one, 0);
assert_eq(num_kahan_sum(r4s_d, 3), r4s_ninf, "kahan [1, -Inf, 1] = -Inf (3.3.2: NaN)");
assert_eq(num_neumaier_sum(r4s_d, 3), r4s_ninf, "neumaier [1, -Inf, 1] = -Inf (3.3.2: NaN)");
# The infinity as the LAST term: Kahan never forms the NaN (control), Neumaier did.
_r4s_set(r4s_one, r4s_one, r4s_ninf, 0);
assert_eq(num_kahan_sum(r4s_d, 3), r4s_ninf, "kahan [1, 1, -Inf] = -Inf (control, as in 3.3.2)");
assert_eq(num_neumaier_sum(r4s_d, 3), r4s_ninf, "neumaier [1, 1, -Inf] = -Inf: the last term (3.3.2: NaN)");
# Finite terms overflowing before an infinite one: the TERM decides, so -Inf + Inf in
# the running sum does not.
_r4s_set(f64_neg(r4s_max), f64_neg(r4s_max), r4s_pinf, 0);
assert_eq(num_kahan_sum(r4s_d, 3), r4s_pinf, "kahan [-DBL_MAX, -DBL_MAX, +Inf] = +Inf (3.3.2: NaN)");
assert_eq(num_neumaier_sum(r4s_d, 3), r4s_pinf, "neumaier [-DBL_MAX, -DBL_MAX, +Inf] = +Inf (3.3.2: NaN)");
# A true NaN stays NaN: infinities of both signs, and a NaN term beside an infinity.
_r4s_set(r4s_pinf, r4s_ninf, 0, 0);
assert_eq(_r4s_isnan(num_kahan_sum(r4s_d, 2)), 1, "kahan [+Inf, -Inf] is NaN (as in 3.3.2)");
assert_eq(_r4s_isnan(num_neumaier_sum(r4s_d, 2)), 1, "neumaier [+Inf, -Inf] is NaN (as in 3.3.2)");
_r4s_set(r4s_pinf, 0x7FF8000000000000, 0, 0);
assert_eq(_r4s_isnan(num_kahan_sum(r4s_d, 2)), 1, "kahan [+Inf, NaN] is NaN (as in 3.3.2)");
assert_eq(_r4s_isnan(num_neumaier_sum(r4s_d, 2)), 1, "neumaier [+Inf, NaN] is NaN (as in 3.3.2)");
_r4s_set(0x7FF8000000000000, r4s_ninf, 0, 0);
assert_eq(_r4s_isnan(num_kahan_sum(r4s_d, 2)), 1, "kahan [NaN, -Inf] is NaN (as in 3.3.2)");
assert_eq(_r4s_isnan(num_neumaier_sum(r4s_d, 2)), 1, "neumaier [NaN, -Inf] is NaN (as in 3.3.2)");
# Finite terms whose running sum overflows give NaN, as 3.3.2 did here:
# [DBL_MAX, DBL_MAX, -DBL_MAX] sums to DBL_MAX, and an infinity would be wrong.
_r4s_set(r4s_max, r4s_max, f64_neg(r4s_max), 0);
assert_eq(_r4s_isnan(num_kahan_sum(r4s_d, 3)), 1,
  "kahan [DBL_MAX, DBL_MAX, -DBL_MAX] is NaN: finite terms overflowed (as in 3.3.2)");
assert_eq(_r4s_isnan(num_neumaier_sum(r4s_d, 3)), 1,
  "neumaier [DBL_MAX, DBL_MAX, -DBL_MAX] is NaN: finite terms overflowed (as in 3.3.2)");
# [DBL_MAX, DBL_MAX] rounds to +Inf, and both now say NaN: every term is finite.
# ⛔ 3.3.3 R5num — FLIPPED: the Kahan line pinned 3.3.2's +Inf as a control. Kahan
# returns ±Inf when the last term overflows, and that infinity can be wrong (the R5num
# block below: a finite sum returned as -Inf), so an overflow from finite terms is a
# quiet NaN in both sums. Here it costs a right +Inf; the cost is stated in src/num.cyr.
assert_eq(num_kahan_sum(r4s_d, 2), 0x7FF8000000000000,
  "kahan [DBL_MAX, DBL_MAX] -> quiet NaN: finite terms overflowed (3.3.2: +Inf)");
assert_eq(_r4s_isnan(num_neumaier_sum(r4s_d, 2)), 1, "neumaier [DBL_MAX, DBL_MAX] is NaN (as in 3.3.2)");
# The compensation still runs where every term is finite (control): Neumaier keeps
# both 1s that 1e100 swamps, and Kahan, which does not, returns 0.
_r4s_set(r4s_one, 0x54B249AD2594C37D, r4s_one, 0xD4B249AD2594C37D);
assert_eq(num_neumaier_sum(r4s_d, 4), 0x4000000000000000, "neumaier [1, 1e100, 1, -1e100] = 2 (control)");
assert_eq(num_kahan_sum(r4s_d, 4), 0, "kahan [1, 1e100, 1, -1e100] = 0 (control, as in 3.3.2)");

# === 3.3.3 R5num: compensated sums whose terms are all finite ===
test_group("3.3.3 R5num: compensated sums whose terms are all finite");
# One rule for both sums: a non-finite TERM gives the IEEE sum of the terms (the
# R4num block above), and when every term is finite a non-finite result is NaN.
# 3.3.2 already returned NaN for most such sums, but Kahan returned ±Inf when the
# last term overflowed and Neumaier when only its compensation carried the result
# over, and that infinity can be wrong in sign or where the sum is finite. Those now
# return the quiet NaN 0x7FF8000000000000, pinned on the bits. The true sums are
# python3 Fractions of the terms.
# [measured: scratch probe against dist/hisab.cyr 3.3.2, cycc 6.6.12, 2026-10-01]
# [-(2^1022 + 3 * 2^970), DBL_MAX, -1]: the sum is 1.348e308, but Kahan's compensation
# term (t - sum) is exactly the overflow threshold 2^1024 - 2^970, which rounds to
# +Inf, so c is +Inf and the -1 then makes the sum -Inf. Neumaier returns a finite
# answer, unchanged (control).
_r4s_set(0xFFD0000000000003, r4s_max, 0xBFF0000000000000, 0);
assert_eq(num_kahan_sum(r4s_d, 3), 0x7FF8000000000000,
  "kahan [-(2^1022 + 3 * 2^970), DBL_MAX, -1] -> quiet NaN (3.3.2: -Inf, sum +1.348e308)");
assert_eq(num_neumaier_sum(r4s_d, 3), 0x7FE7FFFFFFFFFFFE,
  "neumaier [-(2^1022 + 3 * 2^970), DBL_MAX, -1] finite (control, as in 3.3.2)");
assert_eq(num_kahan_sum(r4s_d, 2), 0x7FE7FFFFFFFFFFFE,
  "kahan [-(2^1022 + 3 * 2^970), DBL_MAX] finite, its c already +Inf (control, as in 3.3.2)");
# [2^1023, -0.5, 2^1023 - 2^970]: the sum, 2^1024 - 2^970 - 0.5, is below the overflow
# threshold and rounds to DBL_MAX; Kahan's last step overflowed.
_r4s_set(0x7FE0000000000000, 0xBFE0000000000000, 0x7FDFFFFFFFFFFFFF, 0);
assert_eq(num_kahan_sum(r4s_d, 3), 0x7FF8000000000000,
  "kahan [2^1023, -0.5, 2^1023 - 2^970] -> quiet NaN (3.3.2: +Inf, sum rounds to DBL_MAX)");
assert_eq(_r4s_isnan(num_neumaier_sum(r4s_d, 3)), 1, "neumaier [2^1023, -0.5, 2^1023 - 2^970] is NaN (as in 3.3.2)");
# [DBL_MAX, 2^969, 2^969]: Neumaier's running sum stays DBL_MAX and its compensation
# 2^970 carries the result to the threshold, +Inf. That +Inf was the rounding of the
# sum, so this NaN is the stated cost of the rule.
_r4s_set(r4s_max, 0x7C80000000000000, 0x7C80000000000000, 0);
assert_eq(num_neumaier_sum(r4s_d, 3), 0x7FF8000000000000,
  "neumaier [DBL_MAX, 2^969, 2^969] -> quiet NaN (3.3.2: +Inf, the rounded sum)");
assert_eq(num_kahan_sum(r4s_d, 3), 0x7FF8000000000000, "kahan [DBL_MAX, 2^969, 2^969] -> quiet NaN (3.3.2: +Inf)");
assert_eq(num_neumaier_sum(r4s_d, 2), r4s_max, "neumaier [DBL_MAX, 2^969] = DBL_MAX, finite (control)");
# A NaN the loop formed comes back as formed, 3.3.2's bits: the hardware's default NaN
# from Inf - Inf (0xFFF8000000000000 on x86-64), computed here rather than assumed.
_r4s_set(r4s_max, r4s_max, f64_neg(r4s_max), 0);
var r5s_hwnan = f64_sub(r4s_pinf, r4s_pinf);
assert_eq(num_kahan_sum(r4s_d, 3), r5s_hwnan,
  "kahan [DBL_MAX, DBL_MAX, -DBL_MAX] = the loop's NaN, as formed (as in 3.3.2)");
# ⛔ num_neumaier_sum read data[0] for n < 0 and returned it. n <= 0 is the empty sum.
_r4s_set(0x7FF8000000000000, r4s_one, 0, 0);
assert_eq(num_neumaier_sum(r4s_d, 0 - 1), 0, "neumaier n = -1 -> +0.0, data[0] not read (3.3.2: data[0], NaN)");
assert_eq(num_neumaier_sum(r4s_d, 0 - 3), 0, "neumaier n = -3 -> +0.0 (3.3.2: data[0], NaN)");
_r4s_set(0x3FF8000000000000, r4s_one, 0, 0);
assert_eq(num_neumaier_sum(r4s_d, 0 - 1), 0, "neumaier n = -1 -> +0.0 (3.3.2: data[0], 1.5)");
assert_eq(num_neumaier_sum(r4s_d, 1), 0x3FF8000000000000, "neumaier n = 1 = data[0] = 1.5 (control)");
assert_eq(num_kahan_sum(r4s_d, 0 - 1), 0, "kahan n = -1 -> +0.0 (control, as in 3.3.2)");

# ================================================================
# Complex — Division by an exact zero → the documented pole sentinel, 0 + 0i
# ================================================================
test_group("edge: complex div by zero");

# ⛔ Through 3.3.0 this group said division by zero "produces very large values"
# and checked only `ec_div0 != 0` -- a pointer test that passes for ANY return,
# so the group could not fail. cx_div returns cx_zero() for an exactly-zero
# divisor (complex.cyr: "the documented pole"), which the group "invariants:
# complex zero-divisor tolerance" below also pins through cx_abs. Asserted
# bit-exactly here, both components, the sign of zero included.
var ec_a = cx_new(f64_from(3), f64_from(4));
var ec_zero = cx_zero();
var ec_div0 = cx_div(ec_a, ec_zero);
assert_eq(HComplex_re(ec_div0), 0, "cx_div((3+4i), 0).re is the pole sentinel +0, bit-exact");
assert_eq(HComplex_im(ec_div0), 0, "cx_div((3+4i), 0).im is the pole sentinel +0, bit-exact");

# ================================================================
# Complex — cx_abs(0) = 0
# ================================================================
test_group("edge: complex abs/conj boundary");

assert_eq(cx_abs(cx_zero()), f64_from(0), "cx_abs(0+0i)=0");
assert_eq(cx_abs(cx_one()), f64_from(1), "cx_abs(1+0i)=1");
assert_eq(cx_abs(cx_i()), f64_from(1), "cx_abs(0+i)=1");

# cx_conj of purely real → the same real part, and the imaginary zero NEGATED.
# ⭐ 3.2.2: conj(7 + 0i) is 7 - 0i (C99 G.6: conj flips the sign of the imaginary
# part, a zero's included). Through cyrius 6.6.7 this read +0 because x86's `f64_neg`
# computed 0.0 - x; 6.6.8 made it an IEEE sign flip. Here the sign IS the contract --
# it is what puts conj(z) on the other side of a branch cut -- so it is asserted as
# bits, not as a value.
var ec_real = cx_real(f64_from(7));
var ec_rc = cx_conj(ec_real);
assert_eq(HComplex_re(ec_rc), f64_from(7), "conj real.re=7");
assert_eq(HComplex_im(ec_rc), 0x8000000000000000, "conj real.im = -0.0 (IEEE: conj negates the zero)");
# ⭐ 3.3.4 — THE -0 ABOVE NOW REACHES THE BRANCH CUT. Through ganita 1.2.10 (cyrius
# 6.6.12 ships 1.2.9) ganita_f64_atan2 picked its quadrant with IEEE compares, which
# cannot see a zero's sign: cx_arg(conj(-1 + 0i)) = atan2(-0, -1) was +pi where
# carg(conj z) = -carg(z) gives -pi, atan2(+-0, -0) was +0, a NaN y at x = +-0 fell
# through to -pi/2, and atan2(+-Inf, +-Inf) was Inf/Inf = NaN. ganita 1.2.11 (cyrius
# 6.6.13) decides zeros on their sign bits, returns a NaN operand before any quadrant
# test, and answers the whole C99 F.10.1.4 table. Through 3.3.3 the first two rows
# below were KNOWN DEFECT tripwires pinned to the old answers. Each assertion here pins
# the C99 answer bit-exact (for the NaN bits, ganita's choice of NaN), and each cx_arg
# and cx_ln one FAILS when built against cyrius 6.6.12. The cx_sqrt and cx_powf rows
# no longer read the angle at all since 3.3.4 (see below), so they hold on 6.6.12 too.
# A consumer compiles hisab against ITS OWN stdlib, so below cyrius 6.6.13 it still
# gets the old answers. hisab's record is docs/development/issues/archived/2026-09-30-
# ganita-atan2-signed-zero-and-nan.md.
# [measured: docs/development/issues/archived/2026-09-30-ganita-atan2-signed-zero-and-nan.md]
var ec_m1 = cx_new(f64_neg(F64_ONE), 0);
assert_eq(cx_arg(cx_conj(ec_m1)), 0xC00921FB54442D18, "arg(conj(-1+0i)) = atan2(-0, -1) = -pi, C99 (6.6.12: +pi)");
# NaN in, NaN out. C99 asks only for a NaN; ganita returns the NaN operand itself, so
# the bits fed in come back.
var ec_arg_nan = cx_arg(cx_new(0, 0x7FF8000000000000));
assert_eq(f64_eq(ec_arg_nan, ec_arg_nan), 0, "arg(0 + NaN i) = atan2(NaN, +0) is NaN, C99 (6.6.12: -pi/2)");
assert_eq(ec_arg_nan, 0x7FF8000000000000, "arg(0 + NaN i) is the input's own NaN, bits kept (6.6.12: -pi/2)");
# The same cut through cx_arg's callers (roadmap D132). cx_ln's real part is ln|z| = +0,
# exact, and its imaginary part takes the angle's sign. ⭐ 3.3.4: cx_sqrt and cx_powf
# do not reach atan2 on this row any more. cx_sqrt is Kahan's algorithm and takes the
# sign from y's sign BIT; cx_powf returns the exact axis point when z is on an axis and
# n a whole number of quarter turns. So both real parts are C99's exact +0 now -- they
# were r*cos(fl(pi)/2), cx_from_polar's rounding: 0x3CA1A62633145C07 from cyrius 6.6.9
# on, 0x3CA1A60000000000 on 6.6.3 and 6.6.6 -- and these rows pin hisab's repairs, not
# ganita's. Built pinned to 6.6.12, this file fails the eight cx_arg rows and the cx_ln
# row and passes every cx_sqrt and cx_powf one.
# [measured: scratch csqrt probe, bundle and edge_cases.tcyr pinned to cycc 6.6.3..6.6.14, 2026-10-03]
var ec_m4c = cx_conj(cx_new(f64_from(0 - 4), 0));
var ec_sq_m4c = cx_sqrt(ec_m4c);
assert_eq(HComplex_re(ec_sq_m4c), 0, "sqrt(conj(-4+0i)).re = +0, C99 csqrt (3.3.3: 0x3CA1A62633145C07)");
assert_eq(HComplex_im(ec_sq_m4c), 0xC000000000000000, "sqrt(conj(-4+0i)).im = -2, C99 csqrt (3.3.3 on 6.6.12: +2)");
assert_eq(HComplex_im(cx_ln(cx_conj(ec_m1))), 0xC00921FB54442D18, "ln(conj(-1+0i)).im = -pi, C99 clog (6.6.12: +pi)");
var ec_pw_m4c = cx_powf(ec_m4c, F64_HALF);
assert_eq(HComplex_re(ec_pw_m4c), 0, "powf(conj(-4+0i), 0.5).re = +0, the axis point (3.3.3: 0x3CA1A62633145C07)");
assert_eq(HComplex_im(ec_pw_m4c), 0xC000000000000000, "powf(conj(-4+0i), 0.5).im = -2 (3.3.3 on 6.6.12: +2)");
# Both parts zero: the signs alone decide. atan2(+-0, -0) = +-pi, atan2(-0, +0) = -0.
var ec_nz = 0x8000000000000000;
assert_eq(cx_arg(cx_new(ec_nz, 0)), 0x400921FB54442D18, "arg(-0 + 0i) = atan2(+0, -0) = +pi, C99 (6.6.12: +0)");
assert_eq(cx_arg(cx_new(ec_nz, ec_nz)), 0xC00921FB54442D18, "arg(-0 - 0i) = atan2(-0, -0) = -pi, C99 (6.6.12: +0)");
assert_eq(cx_arg(cx_new(0, ec_nz)), ec_nz, "arg(+0 - 0i) = atan2(-0, +0) = -0, C99 (6.6.12: +0)");
var ec_sq_nz = cx_sqrt(cx_new(0, ec_nz));
assert_eq(HComplex_re(ec_sq_nz), 0, "sqrt(+0 - 0i).re = +0, C99 csqrt");
assert_eq(HComplex_im(ec_sq_nz), ec_nz, "sqrt(+0 - 0i).im = -0, C99 csqrt (3.3.3 on 6.6.12: +0)");
# Both parts infinite: atan2(+-Inf, +Inf) = +-pi/4 and atan2(+-Inf, -Inf) = +-3pi/4.
# Since 3.3.4 cx_sqrt answers csqrt(x + i Inf) = +Inf + i Inf from C99's special-value
# table, for every x, without the angle; through 3.3.3 it went through atan2 and needed
# ganita 1.2.11 for it.
var ec_pinf = 0x7FF0000000000000;
var ec_ninf = 0xFFF0000000000000;
assert_eq(cx_arg(cx_new(ec_pinf, ec_pinf)), 0x3FE921FB54442D18, "arg(+Inf + Inf i) = pi/4, C99 (6.6.12: NaN)");
assert_eq(cx_arg(cx_new(ec_ninf, ec_ninf)), 0xC002D97C7F3321D2, "arg(-Inf - Inf i) = -3pi/4, C99 (6.6.12: NaN)");
var ec_sq_inf = cx_sqrt(cx_new(ec_ninf, ec_pinf));
assert_eq(HComplex_re(ec_sq_inf), ec_pinf, "sqrt(-Inf + Inf i).re = +Inf, C99 csqrt (3.3.3 on 6.6.12: NaN)");
assert_eq(HComplex_im(ec_sq_inf), ec_pinf, "sqrt(-Inf + Inf i).im = +Inf, C99 csqrt (3.3.3 on 6.6.12: NaN)");

# ================================================================
# Complex — csqrt: the C99 special values, the axes, the scaling edges
# ================================================================
test_group("edge: cx_sqrt C99 table and scaling");

# ⛔ 3.3.4 — cx_sqrt WAS THE POLAR FORM r*(cos, sin)(arg/2), which fails three ways
# that these rows pin bit-exact: it cannot land on an axis (sqrt(-4 + 0i).re was
# 0x3CA1A62633145C07, not +0), Inf * sin 0 made a NaN out of +Inf + i y, and |z| = +Inf
# near DBL_MAX made the whole root +Inf. Every finite row below is the correctly
# rounded root by a Decimal oracle, except DBL_MAX + DBL_MAX i: 0.57 and 0.70 ulp
# out, hisab's own rounding, pinned so that a change to it is seen.
# [measured: scratch csqrt probe (Decimal oracle, prec 110), not reproducible in-tree, 2026-10-03; cycc 6.6.14]
var ecs_nan = 0x7FF8000000000123;   # a NaN with a payload, to see whose NaN comes back
var ecs_nnan = 0xFFF8000000000123;  # the same NaN with its sign bit set
var ecs_xnan = 0x7FF8000000000456;  # a second payload, for NaN + i NaN
var ecs_z = cx_sqrt(cx_new(F64_TWO, ec_ninf));
# x + i Inf -> +Inf + i Inf for every x, a NaN x included, the infinity keeping its sign.
assert_eq(HComplex_re(ecs_z), ec_pinf, "sqrt(2 - Inf i).re = +Inf, C99");
assert_eq(HComplex_im(ecs_z), ec_ninf, "sqrt(2 - Inf i).im = -Inf, C99");
ecs_z = cx_sqrt(cx_new(ecs_nan, ec_pinf));
assert_eq(HComplex_re(ecs_z), ec_pinf, "sqrt(NaN + Inf i).re = +Inf: the infinity outranks the NaN (3.3.3: NaN)");
assert_eq(HComplex_im(ecs_z), ec_pinf, "sqrt(NaN + Inf i).im = +Inf, C99 (3.3.3: NaN)");
# -Inf + i y -> +0 + i Inf, the infinity taking y's sign BIT, a -0's included.
ecs_z = cx_sqrt(cx_new(ec_ninf, F64_TWO));
assert_eq(HComplex_re(ecs_z), 0, "sqrt(-Inf + 2i).re = +0, C99 (3.3.3: +Inf)");
assert_eq(HComplex_im(ecs_z), ec_pinf, "sqrt(-Inf + 2i).im = +Inf, C99");
ecs_z = cx_sqrt(cx_new(ec_ninf, ec_nz));
assert_eq(HComplex_re(ecs_z), 0, "sqrt(-Inf - 0i).re = +0, C99 (3.3.3: +Inf)");
assert_eq(HComplex_im(ecs_z), ec_ninf, "sqrt(-Inf - 0i).im = -Inf: y's sign BIT, not y < 0");
# +Inf + i y -> +Inf + i 0, the zero taking y's sign.
ecs_z = cx_sqrt(cx_new(ec_pinf, f64_neg(F64_TWO)));
assert_eq(HComplex_re(ecs_z), ec_pinf, "sqrt(+Inf - 2i).re = +Inf, C99");
assert_eq(HComplex_im(ecs_z), ec_nz, "sqrt(+Inf - 2i).im = -0, C99 (3.3.3: NaN, Inf * sin 0)");
ecs_z = cx_sqrt(cx_new(ec_pinf, ec_nz));
assert_eq(HComplex_im(ecs_z), ec_nz, "sqrt(+Inf - 0i).im = -0: y's sign BIT, not y < 0 (3.3.3: NaN)");
# A NaN part. C99 asks only for "a NaN"; hisab returns the NaN operand, quieted (the
# real part's when both are NaN), and for -Inf + i NaN the infinity takes the NaN's sign
# bit, so csqrt(conj z) = conj(csqrt z) holds on that row too.
ecs_z = cx_sqrt(cx_new(ec_ninf, ecs_nan));
assert_eq(HComplex_re(ecs_z), ecs_nan, "sqrt(-Inf + NaN i).re is the NaN operand");
assert_eq(HComplex_im(ecs_z), ec_pinf, "sqrt(-Inf + NaN i).im = +Inf, C99 NaN +- i Inf (3.3.3: NaN)");
ecs_z = cx_sqrt(cx_new(ec_ninf, ecs_nnan));
assert_eq(HComplex_re(ecs_z), ecs_nnan, "sqrt(-Inf - NaN i).re is the NaN operand");
assert_eq(HComplex_im(ecs_z), ec_ninf, "sqrt(-Inf - NaN i).im = -Inf, the NaN's sign bit");
ecs_z = cx_sqrt(cx_new(ec_pinf, ecs_nan));
assert_eq(HComplex_re(ecs_z), ec_pinf, "sqrt(+Inf + NaN i).re = +Inf, C99 (3.3.3: NaN)");
assert_eq(HComplex_im(ecs_z), ecs_nan, "sqrt(+Inf + NaN i).im is the NaN operand");
ecs_z = cx_sqrt(cx_new(ecs_nan, F64_TWO));
assert_eq(HComplex_re(ecs_z), ecs_nan, "sqrt(NaN + 2i).re is the NaN operand, C99 NaN + i NaN");
assert_eq(HComplex_im(ecs_z), ecs_nan, "sqrt(NaN + 2i).im is the NaN operand");
ecs_z = cx_sqrt(cx_new(F64_TWO, ecs_nan));
assert_eq(HComplex_re(ecs_z), ecs_nan, "sqrt(2 + NaN i).re is the NaN operand, C99 NaN + i NaN");
assert_eq(HComplex_im(ecs_z), ecs_nan, "sqrt(2 + NaN i).im is the NaN operand");
ecs_z = cx_sqrt(cx_new(ecs_xnan, ecs_nan));
assert_eq(HComplex_re(ecs_z), ecs_xnan, "sqrt(NaN + NaN i).re is the real part's NaN");
assert_eq(HComplex_im(ecs_z), ecs_xnan, "sqrt(NaN + NaN i).im is the real part's NaN");
# A SIGNALING NaN comes back quieted -- the quiet bit set, payload and sign kept --
# as the polar form's arithmetic returned it, and never as a signaling NaN.
# [measured: scratch csqrt probe (special-value table), 2026-10-03; cycc 6.6.14]
ecs_z = cx_sqrt(cx_new(0x7FF0000000000001, F64_TWO));
assert_eq(HComplex_re(ecs_z), 0x7FF8000000000001, "sqrt(sNaN + 2i).re is the sNaN quieted, payload kept");
assert_eq(HComplex_im(ecs_z), 0x7FF8000000000001, "sqrt(sNaN + 2i).im is the sNaN quieted");
ecs_z = cx_sqrt(cx_new(F64_TWO, 0xFFF4000000000000));
assert_eq(HComplex_re(ecs_z), 0xFFFC000000000000, "sqrt(2 + sNaN i).re is the sNaN quieted, sign kept");
ecs_z = cx_sqrt(cx_new(ec_ninf, 0x7FF4000000000000));
assert_eq(HComplex_re(ecs_z), 0x7FFC000000000000, "sqrt(-Inf + sNaN i).re is the sNaN quieted");
ecs_z = cx_sqrt(cx_new(ec_pinf, 0x7FF4000000000000));
assert_eq(HComplex_im(ecs_z), 0x7FFC000000000000, "sqrt(+Inf + sNaN i).im is the sNaN quieted");
# Zeros: csqrt(+-0 + i 0) = +0 + i 0, the imaginary zero's sign kept.
ecs_z = cx_sqrt(cx_new(ec_nz, ec_nz));
assert_eq(HComplex_re(ecs_z), 0, "sqrt(-0 - 0i).re = +0, C99");
assert_eq(HComplex_im(ecs_z), ec_nz, "sqrt(-0 - 0i).im = -0, C99");
# The negative real axis: an exact +0 real part.
ecs_z = cx_sqrt(cx_new(f64_from(0 - 4), 0));
assert_eq(HComplex_re(ecs_z), 0, "sqrt(-4 + 0i).re = +0, C99 (3.3.3: 0x3CA1A62633145C07)");
assert_eq(HComplex_im(ecs_z), 0x4000000000000000, "sqrt(-4 + 0i).im = 2");
# The imaginary axis: both parts are sqrt(|y|/2), the same bits. y/(2t) is one ulp
# above t here, and so was the polar form's real part.
# [measured: scratch csqrt probe (Decimal oracle + mutation run), 2026-10-03; cycc 6.6.14]
var ecs_y = 0x401F0CE505C6AF07;
ecs_z = cx_sqrt(cx_new(0, ecs_y));
assert_eq(HComplex_re(ecs_z), 0x3FFF8588291FBA97, "sqrt(0 + yi).re = sqrt(y/2), correctly rounded (3.3.3: ...98)");
assert_eq(HComplex_im(ecs_z), 0x3FFF8588291FBA97, "sqrt(0 + yi).im = the same bits as the real part");
ecs_z = cx_sqrt(cx_new(ec_nz, f64_neg(ecs_y)));
assert_eq(HComplex_re(ecs_z), 0x3FFF8588291FBA97, "sqrt(-0 - yi).re = sqrt(y/2)");
assert_eq(HComplex_im(ecs_z), 0xBFFF8588291FBA97, "sqrt(-0 - yi).im = -sqrt(y/2)");
# Just off the negative real axis, where the polar form's real part was 451805 ulp out.
# [measured: scratch csqrt probe (Decimal oracle + mutation run), 2026-10-03; cycc 6.6.14]
ecs_z = cx_sqrt(cx_new(f64_neg(F64_ONE), 0x3E10000123456789));
assert_eq(HComplex_re(ecs_z), 0x3E00000123456789, "sqrt(-1 + ei).re = e/2 (3.3.3: 0x3E000001234C4C66)");
assert_eq(HComplex_im(ecs_z), 0x3FF0000000000000, "sqrt(-1 + ei).im = 1");
# Near DBL_MAX, scaled by 1/4: x + |z| would overflow. Through 3.3.3 |z| itself
# overflowed on the two rows whose old answer was +-Inf.
# [measured: scratch csqrt probe (Decimal oracle + mutation run), 2026-10-03; cycc 6.6.14]
ecs_z = cx_sqrt(cx_new(0xFFEFFFFFFFFFFFFF, 0));
assert_eq(HComplex_re(ecs_z), 0, "sqrt(-DBL_MAX + 0i).re = +0 (3.3.3: 0x5C91A62633145C06)");
assert_eq(HComplex_im(ecs_z), 0x5FEFFFFFFFFFFFFF, "sqrt(-DBL_MAX + 0i).im = sqrt(DBL_MAX)");
ecs_z = cx_sqrt(cx_new(0x7FEFFFFFFFFFFFFF, 0x7FEFFFFFFFFFFFFF));
assert_eq(HComplex_re(ecs_z), 0x5FF19435CAFFA9F9, "sqrt(DBL_MAX + DBL_MAX i).re, finite (3.3.3: +Inf)");
assert_eq(HComplex_im(ecs_z), 0x5FDD203138F6C827, "sqrt(DBL_MAX + DBL_MAX i).im, finite (3.3.3: +Inf)");
ecs_z = cx_sqrt(cx_new(0xFFEF4DE29AEA6429, 0xFFDEFE09CEFE2A1F));
assert_eq(HComplex_re(ecs_z), 0x5FCE7716B907A86D, "sqrt(-big - big i).re, correctly rounded (3.3.3: +Inf)");
assert_eq(HComplex_im(ecs_z), 0xDFF046DFC4D0BE8E, "sqrt(-big - big i).im, correctly rounded (3.3.3: -Inf)");
ecs_z = cx_sqrt(cx_new(0x7FEFA7F04C4F9B07, 0x7FA5DE0084B5A819));
assert_eq(HComplex_re(ecs_z), 0x5FEFD5BF664D8D0C, "sqrt(big + big i).re, correctly rounded (3.3.3: ...0D)");
assert_eq(HComplex_im(ecs_z), 0x5F95FB065CAED09D, "sqrt(big + big i).im, correctly rounded (3.3.3: ...9E)");
# The band the 2^1021 bound exists for: max(|x|, |y|) between DBL_MAX/(1 + sqrt 2) and
# 2^1023, where x + |z| overflows unscaled. A bound at 2^1023 returns +Inf + 0i here.
# [measured: scratch csqrt check (Decimal oracle, prec 130, + mutation run), 2026-10-03; cycc 6.6.14]
ecs_z = cx_sqrt(cx_new(0x7FDCC1F4BE238FB9, 0x7FDBA5FE39A5CA55));
assert_eq(HComplex_re(ecs_z), 0x5FE76F625096ED2D, "sqrt(x + y i), x and y in [DBL_MAX/(1+sqrt 2), 2^1023): .re");
assert_eq(HComplex_im(ecs_z), 0x5FD2E067F1605926, "sqrt(x + y i), x and y in [DBL_MAX/(1+sqrt 2), 2^1023): .im");
ecs_z = cx_sqrt(cx_new(0xFFDBE955DC35EA49, 0x7FDEB19880A8ABEC));
assert_eq(HComplex_re(ecs_z), 0x5FD4D7AFD6349B4F, "sqrt(-x + y i) in the same band: .re");
assert_eq(HComplex_im(ecs_z), 0x5FE78FF8BFF463D2, "sqrt(-x + y i) in the same band: .im");
# The down-scaled branch with a SUBNORMAL quotient part: it divides by the scaled 2t,
# so the subnormal is rounded once. Rounding y/(2t) first and doubling it after rounds
# twice and lands one subnormal step off on these two rows.
# [measured: scratch csqrt probe (Decimal oracle + mutation run), 2026-10-03; cycc 6.6.14]
ecs_z = cx_sqrt(cx_new(0x7FD2B0535AFFB229, 0x9EC37DC70F17A301));
assert_eq(HComplex_re(ecs_z), 0x5FE14ACDF0CC0C4C, "sqrt(big - tiny i).re, correctly rounded");
assert_eq(HComplex_im(ecs_z), 0x8000000090473A59, "sqrt(big - tiny i).im, a subnormal (3.3.3: -0)");
ecs_z = cx_sqrt(cx_new(0xFFC3F63ABD0561E7, 0x9E6DF158EAB477D3));
assert_eq(HComplex_re(ecs_z), 0x0000000004BD27EB, "sqrt(-big - tiny i).re, a subnormal (3.3.3: 0x5C7BE10068883E41)");
assert_eq(HComplex_im(ecs_z), 0xDFD9462989A73042, "sqrt(-big - tiny i).im, correctly rounded");
# Both parts SUBNORMAL, scaled by 2^54: (x + |z|)/2 would drop bits.
ecs_z = cx_sqrt(cx_new(0x00094E3B1A61DBE2, 0x00018F135F557203));
assert_eq(HComplex_re(ecs_z), 0x1FF87D29D2F3AEFE, "sqrt(subnormal + subnormal i).re, correctly rounded");
assert_eq(HComplex_im(ecs_z), 0x1FC04BD20254F2F3, "sqrt(subnormal + subnormal i).im, correctly rounded");
ecs_z = cx_sqrt(cx_new(0x800506BFC6F87718, 0x800EC66A95E761D1));
assert_eq(HComplex_re(ecs_z), 0x1FF2667578831215, "sqrt(-sub - sub i).re, correctly rounded (3.3.3: ...16)");
assert_eq(HComplex_im(ecs_z), 0x9FF9B2087E727ED6, "sqrt(-sub - sub i).im, correctly rounded (3.3.3: ...D7)");
# Just above DBL_MIN, where the bound sits: up-scaling only from 2^-1022 down lets the
# halving drop a bit here, and both parts come out an ulp off.
# [measured: scratch csqrt probe (Decimal oracle + mutation run), 2026-10-03; cycc 6.6.14]
ecs_z = cx_sqrt(cx_new(0x00002D6E65BD9ACB, 0x0010D650E90794DF));
assert_eq(HComplex_re(ecs_z), 0x1FF755A104AFD30F, "sqrt(sub + ~DBL_MIN i).re, correctly rounded (3.3.3: ...0E)");
assert_eq(HComplex_im(ecs_z), 0x1FF716FF7EFEABC5, "sqrt(sub + ~DBL_MIN i).im, correctly rounded (3.3.3: ...C6)");

# ================================================================
# Complex — cx_powf: a zero angle, and z on an axis
# ================================================================
test_group("edge: cx_powf zero angle and axes");

# ⛔ 3.3.4 — r * sin(0) is Inf * 0 = NaN once r is +Inf. A zero angle now returns
# (r, theta) directly; for a finite r that is the polar form's own answer bit for bit.
# [measured: scratch csqrt probe (cx_powf differential), not reproducible in-tree, 2026-10-03; cycc 6.6.14]
var ecp_z = cx_powf(cx_new(ec_pinf, 0), F64_TWO);
assert_eq(HComplex_re(ecp_z), ec_pinf, "powf(+Inf + 0i, 2).re = +Inf");
assert_eq(HComplex_im(ecp_z), 0, "powf(+Inf + 0i, 2).im = +0 (3.3.3: NaN)");
ecp_z = cx_powf(cx_new(F64_TWO, ec_nz), 0x7E37E43C8800759C);
assert_eq(HComplex_re(ecp_z), ec_pinf, "powf(2 - 0i, 1e300).re = +Inf, overflowed");
assert_eq(HComplex_im(ecp_z), ec_nz, "powf(2 - 0i, 1e300).im = -0, the angle's sign (3.3.3: NaN)");
# ⭐ z EXACTLY on the negative real or imaginary axis and n a whole number of quarter
# turns: the exact axis point, its zero signed as IEEE repeated multiplication signs it.
# The polar form's fl(pi/2) put a stray 1e-16 on the zero axis, and at n = 2^60 a
# point nowhere near 1.
# [measured: scratch csqrt probe (cx_powf differential), not reproducible in-tree, 2026-10-03; cycc 6.6.14]
ecp_z = cx_powf(cx_i(), F64_ONE);
assert_eq(HComplex_re(ecp_z), 0, "powf(i, 1).re = +0 (3.3.3: 0x3C91A62633145C07)");
assert_eq(HComplex_im(ecp_z), F64_ONE, "powf(i, 1).im = 1");
ecp_z = cx_powf(cx_i(), F64_TWO);
assert_eq(HComplex_re(ecp_z), 0xBFF0000000000000, "powf(i, 2).re = -1");
assert_eq(HComplex_im(ecp_z), 0, "powf(i, 2).im = +0, as (0 + i)(0 + i) (3.3.3: 0x3CA1A62633145C07)");
ecp_z = cx_powf(cx_new(ec_nz, F64_ONE), F64_TWO);
assert_eq(HComplex_re(ecp_z), 0xBFF0000000000000, "powf(-0 + i, 2).re = -1");
assert_eq(HComplex_im(ecp_z), ec_nz, "powf(-0 + i, 2).im = -0: x's sign bit, as (-0 + i)(-0 + i)");
ecp_z = cx_powf(cx_i(), f64_from(3));
assert_eq(HComplex_re(ecp_z), ec_nz, "powf(i, 3).re = -0, as i*i*i");
assert_eq(HComplex_im(ecp_z), 0xBFF0000000000000, "powf(i, 3).im = -1");
ecp_z = cx_powf(cx_i(), f64_neg(F64_ONE));
assert_eq(HComplex_re(ecp_z), 0, "powf(i, -1).re = +0, as cx_inv(i): a negative n turns the other way");
assert_eq(HComplex_im(ecp_z), 0xBFF0000000000000, "powf(i, -1).im = -1");
ecp_z = cx_powf(cx_new(f64_neg(F64_ONE), 0), F64_TWO);
assert_eq(HComplex_re(ecp_z), F64_ONE, "powf(-1 + 0i, 2).re = 1");
assert_eq(HComplex_im(ecp_z), ec_nz, "powf(-1 + 0i, 2).im = -0, as (-1 + 0i)^2 (3.3.3: 0xBCB1A62633145C07)");
ecp_z = cx_powf(cx_new(f64_neg(F64_ONE), ec_nz), F64_TWO);
assert_eq(HComplex_im(ecp_z), 0, "powf(-1 - 0i, 2).im = +0: y's sign bit");
ecp_z = cx_powf(cx_i(), 0x43B0000000000000);
assert_eq(HComplex_re(ecp_z), F64_ONE, "powf(i, 2^60).re = 1 (3.3.3: 0x3FB6F22BC9948F49)");
assert_eq(HComplex_im(ecp_z), ec_nz, "powf(i, 2^60).im = -0 (3.3.3: 0xBFEFDF06B916C886)");
ecp_z = cx_powf(cx_i(), 0x4340000000000001);
assert_eq(HComplex_re(ecp_z), 0xBFF0000000000000, "powf(i, 2^53 + 2).re = -1: below 2^54, n is not always 4k");
ecp_z = cx_powf(cx_new(0, 0x6974E718D7D7625A), F64_TWO);
assert_eq(HComplex_re(ecp_z), ec_ninf, "powf(1e200 i, 2).re = -Inf, overflowed");
assert_eq(HComplex_im(ecp_z), 0, "powf(1e200 i, 2).im = +0 (3.3.3: +Inf)");
# Not a whole number of quarter turns, or no axis: the polar form, bit for bit.
var ecp_p = cx_from_polar(F64_ONE, f64_mul(cx_arg(cx_i()), F64_HALF));
ecp_z = cx_powf(cx_i(), F64_HALF);
assert_eq(HComplex_re(ecp_z), HComplex_re(ecp_p), "powf(i, 0.5).re is the polar form's");
assert_eq(HComplex_im(ecp_z), HComplex_im(ecp_p), "powf(i, 0.5).im is the polar form's");
ecp_z = cx_powf(cx_i(), ec_pinf);
assert_eq(f64_eq(HComplex_re(ecp_z), HComplex_re(ecp_z)), 0, "powf(i, +Inf).re is NaN: an infinite n has no axis");
ecp_z = cx_powf(cx_new(0, ecs_nan), F64_TWO);
assert_eq(f64_eq(HComplex_im(ecp_z), HComplex_im(ecp_z)), 0, "powf(0 + NaN i, 2).im is NaN: a NaN part is no axis");

# ================================================================
# Complex — Pauli anticommutator {σi, σi} = 2I
# ================================================================
test_group("edge: pauli anticommutator");

var ep_sx = pauli_x();
var ep_anti_xx = cmat_anticommutator(ep_sx, ep_sx);
# {σx, σx} = 2I → trace = 4 (2*2), and [0,0] = 2+0i
var ep_axx00 = cmat_get(ep_anti_xx, 0, 0);
assert_eq(HComplex_re(ep_axx00), f64_from(2), "{sx,sx}_00.re=2");
assert_eq(HComplex_im(ep_axx00), f64_from(0), "{sx,sx}_00.im=0");
var ep_axx01 = cmat_get(ep_anti_xx, 0, 1);
assert_eq(HComplex_re(ep_axx01), f64_from(0), "{sx,sx}_01.re=0");
var ep_axx_tr = cmat_trace(ep_anti_xx);
assert_eq(HComplex_re(ep_axx_tr), f64_from(4), "{sx,sx} trace=4");

# {σy, σy} = 2I
var ep_sy = pauli_y();
var ep_anti_yy = cmat_anticommutator(ep_sy, ep_sy);
var ep_ayy_tr = cmat_trace(ep_anti_yy);
assert_eq(HComplex_re(ep_ayy_tr), f64_from(4), "{sy,sy} trace=4");

# {σz, σz} = 2I
var ep_sz = pauli_z();
var ep_anti_zz = cmat_anticommutator(ep_sz, ep_sz);
var ep_azz_tr = cmat_trace(ep_anti_zz);
assert_eq(HComplex_re(ep_azz_tr), f64_from(4), "{sz,sz} trace=4");

# {σx, σy} = 0 (different Paulis anticommute to zero)
var ep_anti_xy = cmat_anticommutator(ep_sx, ep_sy);
var ep_axy_tr = cmat_trace(ep_anti_xy);
assert_eq(HComplex_re(ep_axy_tr), f64_from(0), "{sx,sy} trace=0");

# ================================================================
# Autodiff — Dual constant derivative = 0
# ================================================================
test_group("edge: autodiff constant");

var ea_c = dual_const(f64_from(42));
assert_eq(Dual_val(ea_c), f64_from(42), "dual const val=42");
assert_eq(Dual_deriv(ea_c), f64_from(0), "dual const deriv=0");

# Operations on constants: c + c → val, deriv=0
var ea_cc = dual_add(dual_const(f64_from(3)), dual_const(f64_from(4)));
assert_eq(Dual_val(ea_cc), f64_from(7), "const+const val=7");
assert_eq(Dual_deriv(ea_cc), f64_from(0), "const+const deriv=0");

# Const * const
var ea_cm = dual_mul(dual_const(f64_from(3)), dual_const(f64_from(4)));
assert_eq(Dual_val(ea_cm), f64_from(12), "const*const val=12");
assert_eq(Dual_deriv(ea_cm), f64_from(0), "const*const deriv=0");

# ================================================================
# Autodiff — Chain rule: sin(x^2) at x=0
# ================================================================
test_group("edge: autodiff chain rule");

# f(x) = sin(x^2) at x=0: val = sin(0) = 0, deriv = cos(0)*2*0 = 0
var ea_x0 = dual_var(0);
var ea_x0sq = dual_mul(ea_x0, ea_x0);
var ea_sinx2 = dual_sin(ea_x0sq);
assert_eq(Dual_val(ea_sinx2), f64_from(0), "sin(x^2) at 0 val=0");
assert_eq(Dual_deriv(ea_sinx2), f64_from(0), "sin(x^2) at 0 deriv=0");

# f(x) = sin(x^2) at x=1: val = sin(1), deriv = cos(1)*2*1
var ea_x1 = dual_var(F64_ONE);
var ea_x1sq = dual_mul(ea_x1, ea_x1);
var ea_sinx2_1 = dual_sin(ea_x1sq);
# sin(1) ~ 0.841
var ea_sv = f64_to(f64_round(f64_mul(Dual_val(ea_sinx2_1), f64_from(1000))));
assert_eq(ea_sv, 841, "sin(1) * 1000 ~ 841");
# deriv = 2*cos(1) ~ 2*0.5403 ~ 1.0806
var ea_sd = f64_to(f64_round(f64_mul(Dual_deriv(ea_sinx2_1), f64_from(1000))));
assert_eq(ea_sd, 1081, "2cos(1) * 1000 ~ 1081");

# ================================================================
# Interval — Point interval width = 0
# ================================================================
test_group("edge: interval point/degenerate");

var ei_pt = ivl_point(f64_from(7));
assert_eq(ivl_width(ei_pt), f64_from(0), "point ivl width=0");
assert_eq(ivl_midpoint(ei_pt), f64_from(7), "point ivl mid=7");
assert_eq(ivl_contains(ei_pt, f64_from(7)), 1, "point ivl contains self");
assert_eq(ivl_contains(ei_pt, f64_from(8)), 0, "point ivl not contain other");

# Degenerate interval (lo = hi)
var ei_degen = ivl_new(f64_from(5), f64_from(5));
assert_eq(ivl_width(ei_degen), f64_from(0), "degenerate width=0");
assert_eq(ivl_midpoint(ei_degen), f64_from(5), "degenerate mid=5");

# ================================================================
# Interval — Abs of interval containing zero
# ================================================================
test_group("edge: interval abs with zero");

# [-3, 2]: abs should be [0, 3] since it spans zero
var ei_neg = ivl_new(f64_neg(f64_from(3)), F64_TWO);
var ei_abs = ivl_abs(ei_neg);
assert_eq(Interval_lo(ei_abs), f64_from(0), "abs[-3,2] lo=0");
assert_eq(Interval_hi(ei_abs), f64_from(3), "abs[-3,2] hi=3");

# Fully negative: [-5, -2]: abs = [2, 5]
var ei_neg2 = ivl_new(f64_neg(f64_from(5)), f64_neg(F64_TWO));
var ei_abs2 = ivl_abs(ei_neg2);
assert_eq(Interval_lo(ei_abs2), f64_from(2), "abs[-5,-2] lo=2");
assert_eq(Interval_hi(ei_abs2), f64_from(5), "abs[-5,-2] hi=5");

# Fully positive: [2, 5]: abs = [2, 5]
var ei_pos = ivl_new(F64_TWO, f64_from(5));
var ei_abs3 = ivl_abs(ei_pos);
assert_eq(Interval_lo(ei_abs3), f64_from(2), "abs[2,5] lo=2");
assert_eq(Interval_hi(ei_abs3), f64_from(5), "abs[2,5] hi=5");

# ================================================================
# Symbolic — Differentiate constant → const(0)
# ================================================================
test_group("edge: symbolic diff const");

var es_c = expr_const(f64_from(99));
var es_dc = expr_diff(es_c, str_from("x"));
assert_eq(expr_tag(es_dc), EXPR_CONST, "diff const → const");
var es_empty = vec_new();
assert_eq(expr_eval(es_dc, es_empty), f64_from(0), "diff const eval=0");

# ================================================================
# Symbolic — Simplify nested: 0 + (1 * x) → x
# ================================================================
test_group("edge: symbolic simplify nested");

var es_x = expr_var(str_from("x"));
var es_one_x = expr_mul(expr_const(F64_ONE), es_x);
var es_zero_plus = expr_add(expr_const(0), es_one_x);
var es_simp = expr_simplify(es_zero_plus);
# After simplification: 0+(1*x) → should simplify to x (EXPR_VAR)
assert_eq(expr_tag(es_simp), EXPR_VAR, "0+(1*x) → var");

# Nested: (0 * x) + x → x
var es_zero_x = expr_mul(expr_const(0), es_x);
var es_plus_x = expr_add(es_zero_x, es_x);
var es_simp2 = expr_simplify(es_plus_x);
assert_eq(expr_tag(es_simp2), EXPR_VAR, "(0*x)+x → var");

# ================================================================
# Symbolic — Evaluate with missing variable (error resilience)
# ================================================================
# No assertion here, on purpose. This case used to read "SKIPPED -- expr_eval
# aborts on undefined variables (by design, not a fallback)". The code never
# aborted: the claim came from expr_eval's doc, which said "Aborts" through
# 2.6.14 while the function warned and returned 0, and 2.6.15 corrected the doc.
# The behaviour is pinned in tests/abuse.tcyr's group "abuse: symbolic
# differentiation and simplification of degenerate trees": an unbound variable
# evaluates to 0, and the whole warning goes to stderr.

# ================================================================
# Mat4 — Transpose of identity = identity
# ================================================================
test_group("edge: mat4 transpose identity");

var em_ti = m4_transpose(m4_identity());
assert_eq(m4_get(em_ti, 0, 0), f64_from(1), "transpose I [0,0]=1");
assert_eq(m4_get(em_ti, 0, 1), f64_from(0), "transpose I [0,1]=0");
assert_eq(m4_get(em_ti, 3, 3), f64_from(1), "transpose I [3,3]=1");

# ================================================================
# Mat4 — I * I = I
# ================================================================
test_group("edge: mat4 mul identity");

var em_ii = m4_mul(m4_identity(), m4_identity());
assert_eq(m4_get(em_ii, 0, 0), f64_from(1), "I*I [0,0]=1");
assert_eq(m4_get(em_ii, 1, 1), f64_from(1), "I*I [1,1]=1");
assert_eq(m4_get(em_ii, 0, 1), f64_from(0), "I*I [0,1]=0");
assert_eq(m4_get(em_ii, 3, 0), f64_from(0), "I*I [3,0]=0");

# ================================================================
# Autodiff — neg and sub
# ================================================================
test_group("edge: autodiff neg/sub");

# neg(x) at x=5: val=-5, deriv=-1
var ea_n = dual_neg(dual_var(f64_from(5)));
assert_eq(Dual_val(ea_n), f64_neg(f64_from(5)), "neg(x) val=-5");
assert_eq(Dual_deriv(ea_n), f64_neg(f64_from(1)), "neg(x) deriv=-1");

# sub(x, 3) at x=5: val=2, deriv=1
var ea_sub = dual_sub(dual_var(f64_from(5)), dual_const(f64_from(3)));
assert_eq(Dual_val(ea_sub), f64_from(2), "x-3 val=2");
assert_eq(Dual_deriv(ea_sub), f64_from(1), "x-3 deriv=1");

# ================================================================
# Easing — Midpoint values
# ================================================================
test_group("edge: easing midpoints");

# ease_in(0.5) = 0.25
var ee_in = f64_to(f64_round(f64_mul(ease_in(F64_HALF), f64_from(100))));
assert_eq(ee_in, 25, "ease_in(0.5)*100=25");

# ease_out(0.5) = 0.75
var ee_out = f64_to(f64_round(f64_mul(ease_out(F64_HALF), f64_from(100))));
assert_eq(ee_out, 75, "ease_out(0.5)*100=75");

# ease_in_out(0.5) = 0.5
var ee_io = f64_to(f64_round(f64_mul(ease_in_out(F64_HALF), f64_from(100))));
assert_eq(ee_io, 50, "ease_in_out(0.5)*100=50");

# ================================================================
# Num — RK4 basic test
# ================================================================
# ================================================================
# Num — RK4: 4th-order accuracy and observed order of convergence
# ================================================================
# Every reference value below is derived independently of src/num.cyr:
#   * y' = y  is integrated by ANY explicit RK method as y1 = y0*R(z),
#     R(z) = sum b_i over the tableau; for classical RK4 (and only for it)
#     R(z) = 1 + z + z^2/2 + z^3/6 + z^4/24  (textbook stability function).
#   * y' = 4t^3 makes RK4 collapse to Simpson's rule, exact for cubics.
#   * y' = t*y has the closed-form solution y(t) = y0*exp(t^2/2).
# Multi-step reference values were computed in exact rational arithmetic
# (python3 fractions) and every hex literal via python3 struct.pack('>d').
test_group("edge: num rk4 accuracy");

var RK4_T13   = 0x3D3C25C268497682;  # 1e-13
var RK4_T14   = 0x3D06849B86A12B9B;  # 1e-14
var RK4_T15   = 0x3CD203AF9EE75616;  # 1e-15
var RK4_2EM6  = 0x3EC0C6F7A0B5ED8D;  # 2e-6
var RK4_E     = 0x4005BF0A8B145769;  # e       = 2.718281828459045
var RK4_SQRTE = 0x3FFA61298E1E069C;  # sqrt(e) = 1.6487212707001282

# --- 1. y' = 1, y(0)=0, dt=1 -> y(1)=1 exactly (was the only rk4 assertion;
#        it is exact for Euler too, so it is kept only as a sanity check).
var erx = num_rk4(&_ec_dydt_const, 0, 0, F64_ONE);
assert(f64_approx_eq(erx, F64_ONE, RK4_T15), "rk4 const dy/dt=1 -> y=1 (1e-15)");

# --- 2. y' = y, y(0)=1, one step dt=1: R(1) = 65/24 = 2.7083333333333333.
#        Euler gives 2.0, midpoint/RK2 2.5, RK3 8/3 = 2.6666667 -- all fail 1e-13.
var erk_r1 = num_rk4(&_ec_dydt_y, 0, F64_ONE, F64_ONE);
assert(f64_approx_eq(erk_r1, 0x4005AAAAAAAAAAAB, RK4_T13), "rk4 R(1)=65/24 (1e-13)");

# --- 3. Same map at dt=1/2: R(1/2) = 211/128 = 1.6484375 exactly.
#        RK3 gives 1.6458333 (2.6e-3 off) -- a second point pins the polynomial.
var erk_rh = num_rk4(&_ec_dydt_y, 0, F64_ONE, F64_HALF);
assert(f64_approx_eq(erk_rh, 0x3FFA600000000000, RK4_T14), "rk4 R(1/2)=211/128 (1e-14)");

# --- 4. y' = 4t^3, y(0)=0, one step dt=1 -> Simpson: (1/6)(0 + 4*0.5 + 4) = 1,
#        which is also the exact solution t^4 at t=1. Euler gives 0, midpoint 0.5,
#        and evaluating k2/k3 at t instead of t+dt/2 gives 2/3 -- all fail 1e-15.
var erk_q = num_rk4(&_ec_dydt_4t3, 0, 0, F64_ONE);
assert(f64_approx_eq(erk_q, F64_ONE, RK4_T15), "rk4 cubic quadrature = 1 (1e-15)");

# --- 5. y' = y on [0,1] with n = 8/16/32 fixed steps, y(0)=1.
#        Exact-rational RK4 references: 2.7182768444167342, 2.7182815003405851,
#        2.7182818074111932 (errors vs e: 4.984e-6, 3.281e-7, 2.105e-8).
var erk_h8  = f64_div(F64_ONE, f64_from(8));
var erk_h16 = f64_div(F64_ONE, f64_from(16));
var erk_h32 = f64_div(F64_ONE, f64_from(32));
var erk_y8  = _ec_rk4_run(&_ec_dydt_y, 0, F64_ONE, erk_h8, 8);
var erk_y16 = _ec_rk4_run(&_ec_dydt_y, 0, F64_ONE, erk_h16, 16);
var erk_y32 = _ec_rk4_run(&_ec_dydt_y, 0, F64_ONE, erk_h32, 32);
assert(f64_approx_eq(erk_y8, 0x4005BF07EE21F39E, RK4_T13), "rk4 exp n=8 (1e-13)");
assert(f64_approx_eq(erk_y16, 0x4005BF0A5F0A46EA, RK4_T13), "rk4 exp n=16 (1e-13)");
assert(f64_approx_eq(erk_y32, 0x4005BF0A8841248C, RK4_T13), "rk4 exp n=32 (1e-13)");

# --- 6. Observed order: err(h)/err(h/2) must be ~2^4 = 16.
#        Measured 15.190 and 15.589; RK3 gives 7.61, RK2 3.82, Euler 1.90.
var erk_e8  = f64_abs(f64_sub(erk_y8, RK4_E));
var erk_e16 = f64_abs(f64_sub(erk_y16, RK4_E));
var erk_e32 = f64_abs(f64_sub(erk_y32, RK4_E));
var erk_ra = f64_div(erk_e8, erk_e16);
var erk_rb = f64_div(erk_e16, erk_e32);
assert(f64_gt(erk_ra, f64_from(14)) == 1, "rk4 order ratio 8->16 > 14");
assert(f64_lt(erk_ra, f64_from(17)) == 1, "rk4 order ratio 8->16 < 17");
assert(f64_gt(erk_rb, f64_from(14)) == 1, "rk4 order ratio 16->32 > 14");
assert(f64_lt(erk_rb, f64_from(17)) == 1, "rk4 order ratio 16->32 < 17");

# --- 7. Non-autonomous, non-polynomial: y' = t*y, y(0)=1 -> y(1) = sqrt(e).
#        n=8 exact-rational RK4 reference 1.6487206103294634 (err 6.604e-7);
#        n=16 reference 1.6487212322380775 (err 3.846e-8).
#        RK3 errs 9.40e-5, RK2 3.95e-3, Euler 1.25e-1 -- all fail the 2e-6 bound.
var erk_t8  = _ec_rk4_run(&_ec_dydt_ty, 0, F64_ONE, erk_h8, 8);
var erk_t16 = _ec_rk4_run(&_ec_dydt_ty, 0, F64_ONE, erk_h16, 16);
assert(f64_approx_eq(erk_t8, 0x3FFA6128DCD9B304, RK4_T13), "rk4 t*y n=8 (1e-13)");
assert(f64_approx_eq(erk_t16, 0x3FFA612983CAEF0F, RK4_T13), "rk4 t*y n=16 (1e-13)");
assert(f64_approx_eq(erk_t8, RK4_SQRTE, RK4_2EM6), "rk4 t*y n=8 vs sqrt(e) < 2e-6");
assert(f64_approx_eq(erk_t16, RK4_SQRTE, RK4_2EM6), "rk4 t*y n=16 vs sqrt(e) < 2e-6");

# --- 8. Backward integration (dt < 0). Nothing above ever uses a negative or
#        zero step, so a sign defect in dt/half_dt is invisible to 1-7.
#        y' = y, one step dt=-1: R(-1) = 1 - 1 + 1/2 - 1/6 + 1/24 = 3/8 exactly.
#        y' = 4t^3 from (t=1, y=1) with dt=-1 lands on the exact solution t^4
#        at t=0, i.e. 0 (Simpson again, and it pins t_half = t + dt/2 < t).
var erk_rn = num_rk4(&_ec_dydt_y, 0, F64_ONE, f64_neg(F64_ONE));
assert(f64_approx_eq(erk_rn, 0x3FD8000000000000, RK4_T13), "rk4 R(-1)=3/8 (1e-13)");
var erk_qb = num_rk4(&_ec_dydt_4t3, F64_ONE, F64_ONE, f64_neg(F64_ONE));
assert(f64_approx_eq(erk_qb, 0, RK4_T15), "rk4 backward cubic t=1->0 gives 0 (1e-15)");

# ================================================================
# Complex — cx_mul with zero = zero
# ================================================================
test_group("edge: complex zero mul");

var ec_z = cx_mul(cx_new(f64_from(5), f64_from(3)), cx_zero());
assert_eq(HComplex_re(ec_z), f64_from(0), "cx mul zero re=0");
assert_eq(HComplex_im(ec_z), f64_from(0), "cx mul zero im=0");

# cx_add with zero = self
var ec_az = cx_add(cx_new(f64_from(7), f64_from(2)), cx_zero());
assert_eq(HComplex_re(ec_az), f64_from(7), "cx add zero re=7");
assert_eq(HComplex_im(ec_az), f64_from(2), "cx add zero im=2");

# ================================================================
# Interval — Mul with negative intervals
# ================================================================
test_group("edge: interval negative mul");

# [-2, -1] * [3, 4] = [-8, -3]
var ei_na = ivl_new(f64_neg(F64_TWO), f64_neg(F64_ONE));
var ei_nb = ivl_new(f64_from(3), f64_from(4));
var ei_nm = ivl_mul(ei_na, ei_nb);
assert_eq(Interval_lo(ei_nm), f64_neg(f64_from(8)), "neg*pos ivl lo=-8");
assert_eq(Interval_hi(ei_nm), f64_neg(f64_from(3)), "neg*pos ivl hi=-3");

# ================================================================
# Complex — capped-constructor null propagation (CWE-476)
# ================================================================
# cmat_new caps at _CMAT_MAX_ELEMS (65536) and correctly returns 0 above it.
# Through 2.6.13 the constructors that build on it stored through that 0, turning
# a designed error signal into SIGSEGV. Each of these crashed the process before.
test_group("invariants: cmat capped-constructor null propagation");

assert_eq(cmat_new(300, 300), 0, "cmat_new(300,300) = 90000 elems > cap -> 0");
assert_eq(cmat_identity(300), 0, "cmat_identity(300) propagates null");
# Both operands fit, the product does not: 1000x1 times 1x1000 asks for 1e6.
var ec_ca = cmat_new(1000, 1);
var ec_cb = cmat_new(1, 1000);
assert_neq(ec_ca, 0, "cmat_new(1000,1) is under the cap");
assert_neq(ec_cb, 0, "cmat_new(1,1000) is under the cap");
assert_eq(cmat_mul(ec_ca, ec_cb), 0, "cmat_mul: product over cap -> 0");
# Kronecker multiplies both dimensions. 16x16 (x) 16x16 is exactly 65536 — AT the
# cap and legitimately allowed; 17x17 (x) 17x17 is 83521 and must be refused.
assert_neq(cmat_kronecker(cmat_new(16, 16), cmat_new(16, 16)), 0,
  "cmat_kronecker exactly at the cap is allowed");
assert_eq(cmat_kronecker(cmat_new(17, 17), cmat_new(17, 17)), 0,
  "cmat_kronecker over cap -> 0");

# ================================================================
# Complex — small divisors are not flushed to zero; of finite ones, only an exact zero is guarded
# ================================================================
# Through 2.6.13 cx_div/cx_inv/cx_powf compared a SQUARED modulus against the
# unsquared EPSILON_F64, so the effective cutoff was |z| < 1e-6 and legitimate
# small divisors were silently flushed to zero. 2.6.14 squared the tolerance
# too, making the cutoff 1e-12 -- still a scale -- and this banner read
# "tolerance is 1e-12, not 1e-6" through 3.3.1. There is no tolerance now:
# cx_div and cx_inv are Smith's algorithm since 2.15.0, and cx_powf guards its
# modulus since 2.17.0, so for a finite input all three return cx_zero() only
# at an exact zero.
#
# ⚠ Through 3.3.1 also for one non-finite input: cx_div and cx_inv returned
# cx_zero() for a NaN real part over a zero imaginary part (NaN+0i), because the
# NaN failed the |imag| < |real| test that picks Smith's first branch and the
# guard reached next read only the imaginary part. 3.3.2 reads both parts.
# cx_powf always propagated the NaN, through its modulus. The record and the
# assertions are in tests/abuse.tcyr's group "abuse: complex and dual-number
# singular points".
# [measured: scratch probe on the 3.3.1 tree, not reproducible in-tree, 2026-09-30; cycc 6.6.12]
#
# ⛔ 2.17.0 — AND THE LINE THAT USED TO STAND HERE, *"cx_is_zero always squared
# correctly"*, WAS WRONG. It squared both sides, which is dimensionally consistent
# and is all that sentence ever checked; numerically both squares flush, so
# `cx_is_zero(2^-700 + 0i, 2^-600)` answered 0 for a value a hundred binades below
# its own tolerance. A dimensional argument is not a numerical one, and calling
# this function correct in a comment is what kept it off three repair passes.
# The pinning assertions are in tests/modules.tcyr under "complex 2.17.0".
test_group("invariants: complex zero-divisor tolerance");

var ec_small = cx_new(f64_div(F64_ONE, f64_from(1000000000)), 0);   # 1e-9
assert_eq(f64_gt(cx_abs(cx_div(cx_one(), ec_small)), f64_from(1000000)), 1,
  "cx_div by 1e-9 is not flushed to zero");
assert_eq(f64_gt(cx_abs(cx_inv(ec_small)), f64_from(1000000)), 1,
  "cx_inv of 1e-9 is not flushed to zero");
assert_eq(f64_gt(cx_abs(cx_powf(ec_small, F64_ONE)), 0), 1,
  "cx_powf of 1e-9 is not flushed to zero");
# An exact zero divisor must still be guarded.
assert_eq(cx_abs(cx_div(cx_one(), cx_zero())), f64_from(0), "cx_div by exact zero -> zero");
assert_eq(cx_abs(cx_inv(cx_zero())), f64_from(0), "cx_inv of exact zero -> zero");

# ================================================================
# Interval — ENCLOSURE SOUNDNESS
# ================================================================
# The one contract an interval type must never break: the result must CONTAIN the
# true range. Three separate violations shipped through 2.6.12, all fixed in
# 2.6.13. These assertions are the guard.
test_group("invariants: interval enclosure soundness");

# ivl_sin returned only [min(sin a, sin b), max(sin a, sin b)] for width <= PI, so
# an interval straddling an extremum without an endpoint at it UNDER-approximated.
var ei_s1 = ivl_sin(ivl_new(f64_div(f64_from(14), f64_from(10)),
    f64_div(f64_from(18), f64_from(10))));
assert_eq(ivl_contains(ei_s1, F64_ONE), 1, "ivl_sin[1.4,1.8] contains the max 1.0 (straddles PI/2)");
var ei_s2 = ivl_sin(ivl_new(f64_div(f64_from(46), f64_from(10)),
    f64_div(f64_from(48), f64_from(10))));
assert_eq(ivl_contains(ei_s2, f64_neg(F64_ONE)), 1, "ivl_sin[4.6,4.8] contains the min -1.0");
# ...and must stay TIGHT where no extremum is enclosed (the old width>PI shortcut
# widened to [-1,1] unconditionally).
var ei_s3 = ivl_sin(ivl_new(0, F64_ONE));
assert_eq(ivl_contains(ei_s3, F64_ONE), 0, "ivl_sin[0,1] excludes 1.0 (tightness)");
var ei_s4 = ivl_sin(ivl_new(f64_div(F64_ONE, f64_from(10)), f64_div(f64_from(33), f64_from(10))));
assert_eq(ivl_contains(ei_s4, F64_ONE), 1, "ivl_sin[0.1,3.3] contains the max");
assert_eq(ivl_contains(ei_s4, f64_neg(F64_ONE)), 0, "ivl_sin[0.1,3.3] excludes -1 (no min inside)");
var ei_s5 = ivl_sin(ivl_new(0, F64_TAU));
assert_eq(ivl_contains(ei_s5, F64_ONE), 1, "ivl_sin[0,tau] contains +1");
assert_eq(ivl_contains(ei_s5, f64_neg(F64_ONE)), 1, "ivl_sin[0,tau] contains -1");

# ivl_sqrt clamped only the lower bound, so a wholly-negative interval produced
# [0, NaN] — and ivl_new cannot order around NaN, so ivl_contains then reported it
# as containing everything, silently poisoning downstream bounds.
var ei_q = ivl_sqrt(ivl_new(f64_neg(f64_from(4)), f64_neg(F64_ONE)));
assert_eq(ivl_contains(ei_q, f64_from(12345)), 0, "ivl_sqrt[-4,-1] is not a NaN catch-all");
var ei_q2 = ivl_sqrt(ivl_new(f64_neg(f64_from(4)), f64_from(9)));
assert_eq(Interval_lo(ei_q2), f64_from(0), "ivl_sqrt[-4,9] lo=0");
assert_eq(Interval_hi(ei_q2), f64_from(3), "ivl_sqrt[-4,9] hi=3");

# ivl_div tested for zero with a raw integer `== 0`, which matches only +0.0;
# -0.0 (0x8000000000000000) slipped through and divided by zero. -0.0 is written as
# the literal bit pattern because that is the same on every toolchain: `f64_neg(0)`
# yielded +0.0 on x86 below cyrius 6.6.8 (it computed 0.0 - x) and -0.0 from 6.6.8 on
# (an IEEE sign flip), so a test built on it would pass for the wrong reason on one.
var ei_nz = 0x8000000000000000;
assert_eq(ei_nz == 0, 0, "sanity: -0.0 is not integer-zero (this was the bug)");
assert_eq(f64_mul(0, f64_neg(F64_ONE)) == ei_nz, 1, "sanity: 0.0 * -1.0 produces -0.0");
var ei_dz = ivl_div(ivl_new(F64_ONE, F64_ONE), ivl_new(ei_nz, F64_ONE));
# [1,1] / [-0.0, 1] -- as a REAL interval the divisor is [0,1], so the true range
# is {1/y : 0 < y <= 1} = [1, +inf). Three different answers are distinguished
# here: the unguarded path yields [-inf, 1] (the -0.0 bug), the 2.6.12..2.8.2
# guard yielded the finite [-1e9, 1e9] (which EXCLUDES 1/1e-12 = 1e12 and is
# therefore not an enclosure at all), and the correct hull is [1, +inf).
assert_eq(Interval_lo(ei_dz), f64_from(1), "ivl_div by [-0.0,1] lo = 1 (exact hull)");
assert_eq(Interval_hi(ei_dz), 0x7FF0000000000000, "ivl_div by [-0.0,1] hi = +Infinity");
assert_eq(ivl_contains(ei_dz, f64_from(1000000000000)), 1,
  "ivl_div by [-0.0,1] encloses 1e12 (the 1e9 guard did not)");

# ================================================================
# Vec3 — Distance symmetry
# ================================================================
test_group("edge: vec3 distance symmetry");

var ed_a = hvec3_new(F64_ONE, F64_TWO, f64_from(3));
var ed_b = hvec3_new(f64_from(4), f64_from(5), f64_from(6));
assert_f64_eq(hvec3_distance(ed_a, ed_b), hvec3_distance(ed_b, ed_a), "distance symmetric");

# ================================================================
# Safety invariants (2.3.3 audit) — pin the load-bearing assumptions
# the integer/bit-math code relies on so a future toolchain change
# can't silently break them.
# ================================================================
test_group("invariants: bit-math / overflow / determinism");

# `>>` is LOGICAL (zero-fill), not arithmetic. The PCG RNG and the
# bit-reversal/byte-swap code in num*.cyr depend on this.
assert_eq(0x8000000000000000 >> 1, 0x4000000000000000, "shift: >> is logical (high bit zero-filled)");
assert_eq(0x4000000000000000 >> 62, 1, "shift: logical >> reaches bit 0");

# _num_mulmod (Russian-peasant) stays overflow-safe where a naive a*b
# would overflow i64. Fermat: 2^(p-1) == 1 (mod p) for prime p~1e11,
# whose intermediate squares (~1e22) far exceed i64.
var _rq70t, _rq70v = num_modpow(2, 99999999976, 99999999977);
assert_eq(is_ok(_rq70t), 1, "modpow: Fermat at p~1e11 (mulmod overflow-safe)");
assert_eq(_rq70v, 1, "modpow: Fermat at p~1e11 (mulmod overflow-safe)");

# PCG32 is deterministic and reproducible for a fixed seed.
var inv_rng = pcg32_new(42);
assert_eq(pcg32_next(inv_rng), 1307692281, "pcg32(42) #1 deterministic");
assert_eq(pcg32_next(inv_rng), 3850602322, "pcg32(42) #2 deterministic");
var inv_rng2 = pcg32_new(42);
assert_eq(pcg32_next(inv_rng2), 1307692281, "pcg32(42) reseed reproduces #1");

# var buf[N] is process-static in Cyrius, but str_from_buf COPIES, so
# float rendering is independent across repeated calls.
var inv_s1 = expr_to_str(expr_const(f64_from(3)));
var inv_s2 = expr_to_str(expr_const(f64_from(7)));
assert_eq(str_eq(inv_s1, str_from("3")), 1, "render buf: first result intact after second call");
assert_eq(str_eq(inv_s2, str_from("7")), 1, "render buf: second result correct");

# ----------------------------------------------------------------
# Allocation-overflow guards (2.4.6 hardening audit) — pin the
# CWE-190 mitigations so removing a guard fails the build. A null (0)
# return on overflow-prone / invalid dimensions is the contract.
# ----------------------------------------------------------------
test_group("invariants: allocation overflow guards");

# cmat_new: rows*cols*16 must not overflow → reject huge / non-positive dims.
assert_eq(cmat_new(100000, 100000), 0, "cmat_new: huge dims rejected (overflow guard)");
assert_eq(cmat_new(0, 5), 0, "cmat_new: non-positive rows rejected");
assert_neq(cmat_new(4, 4), 0, "cmat_new: valid dims allocate");

# tensor_new: rank capped at 8, and total*8 must not overflow.
var inv_ts_rank = alloc(8);
store64(inv_ts_rank, 2);
assert_eq(tensor_new(9, inv_ts_rank), 0, "tensor_new: rank > 8 rejected");
var inv_ts_big = alloc(16);
store64(inv_ts_big, 100000);
store64(inv_ts_big + 8, 100000);
assert_eq(tensor_new(2, inv_ts_big), 0, "tensor_new: overflow-prone shape rejected");
var inv_ts_ok = alloc(16);
store64(inv_ts_ok, 2);
store64(inv_ts_ok + 8, 3);
assert_neq(tensor_new(2, inv_ts_ok), 0, "tensor_new: valid shape allocates");

# mat_new (stdlib ganita): the UPSTREAM CWE-190 guard, landed in ganita 1.0.4
# and vendored at the cyrius 6.5.6 pin (hisab 2.6.11). Pinned here deliberately:
# hisab built against a STALE vendored ganita 1.0.3 for the whole 2.6.10 cycle,
# where `mat_new(0 - 5, 3)` did not return null — it SEGFAULTED. That drift was
# invisible because nothing asserted the upstream contract, only hisab's own
# `mat_new_guarded` wrapper. These four assertions make a vendoring regression
# fail the suite instead of shipping.
assert_eq(ganita_mat_new(0 - 5, 3), 0, "mat_new (stdlib): negative rows rejected");
assert_eq(ganita_mat_new(0, 5), 0, "mat_new (stdlib): zero rows rejected");
assert_eq(ganita_mat_new(1000000000, 1000000000), 0, "mat_new (stdlib): overflow-prone dims rejected");
assert_neq(ganita_mat_new(3, 3), 0, "mat_new (stdlib): valid dims allocate");

# ================================================================
test_group("ivl_div: extended division must ENCLOSE, and enclose tightly");

# The whole contract of an interval type is that the returned interval CONTAINS
# the true range. Through 2.8.2 a divisor straddling zero returned the finite
# [-1e9, +1e9], which contains nothing in particular: the true range is unbounded
# whenever 0 is in the divisor and the numerator is not {0}. The answers below
# are the EXACT interval hulls of {x/y : x in A, y in B, y != 0}, cross-checked
# against a python3 Fraction reference over all 4356 ordered pairs of an 11-point
# rational endpoint grid (0 mismatches; the same reference reports 2706
# mismatches against the 2.8.2 source).
var xd_pinf = 0x7FF0000000000000;
var xd_ninf = 0xFFF0000000000000;

# [1,2] / [0,1] -> [1, +inf)
var xd_a = ivl_div(ivl_new(F64_ONE, F64_TWO), ivl_new(0, F64_ONE));
assert_eq(Interval_lo(xd_a), f64_from(1), "[1,2]/[0,1] lo = 1");
assert_eq(Interval_hi(xd_a), xd_pinf, "[1,2]/[0,1] hi = +inf");

# [1,2] / [-1,0] -> (-inf, -1]
var xd_b = ivl_div(ivl_new(F64_ONE, F64_TWO), ivl_new(f64_neg(F64_ONE), 0));
assert_eq(Interval_lo(xd_b), xd_ninf, "[1,2]/[-1,0] lo = -inf");
assert_eq(Interval_hi(xd_b), f64_neg(f64_from(1)), "[1,2]/[-1,0] hi = -1");

# [1,2] / [-1,1] -> the true set is (-inf,-1] u [1,+inf); its hull is entire.
var xd_c = ivl_div(ivl_new(F64_ONE, F64_TWO), ivl_new(f64_neg(F64_ONE), F64_ONE));
assert_eq(Interval_lo(xd_c), xd_ninf, "[1,2]/[-1,1] lo = -inf");
assert_eq(Interval_hi(xd_c), xd_pinf, "[1,2]/[-1,1] hi = +inf");

# [-4,-2] / [0,2] -> (-inf, -1]
var xd_d = ivl_div(ivl_new(f64_neg(f64_from(4)), f64_neg(F64_TWO)), ivl_new(0, F64_TWO));
assert_eq(Interval_lo(xd_d), xd_ninf, "[-4,-2]/[0,2] lo = -inf");
assert_eq(Interval_hi(xd_d), f64_neg(f64_from(1)), "[-4,-2]/[0,2] hi = -1");

# [0,0] / [-1,1] -> exactly [0,0]: 0/y is 0 for every admissible y. The old
# guard returned [-1e9, 1e9] here, which is sound but 2e9 wide for an answer
# that is a single point.
var xd_e = ivl_div(ivl_point(0), ivl_new(f64_neg(F64_ONE), F64_ONE));
assert_eq(Interval_lo(xd_e), f64_from(0), "[0,0]/[-1,1] lo = 0");
assert_eq(Interval_hi(xd_e), f64_from(0), "[0,0]/[-1,1] hi = 0");

# Soundness spot-check with a value the 1e9 box excluded: 1 / 1e-12 = 1e12.
assert_eq(ivl_contains(xd_a, f64_from(1000000000000)), 1, "[1,2]/[0,1] encloses 1e12");
assert_eq(ivl_contains(xd_a, F64_HALF), 0, "[1,2]/[0,1] does NOT enclose 0.5 (still tight)");

# The divisor-free-of-zero path is untouched: [1,3]/[2,4] = [0.25, 1.5].
var xd_f = ivl_div(ivl_new(F64_ONE, f64_from(3)), ivl_new(F64_TWO, f64_from(4)));
assert_eq(f64_to(f64_round(f64_mul(Interval_lo(xd_f), f64_from(100)))), 25,
  "[1,3]/[2,4] lo = 0.25 (unchanged)");
assert_eq(f64_to(f64_round(f64_mul(Interval_hi(xd_f), f64_from(100)))), 150,
  "[1,3]/[2,4] hi = 1.5 (unchanged)");

# An unbounded interval must survive multiplication by [0,0] as [0,0], not NaN:
# an infinite ENDPOINT means the set is unbounded, not that it holds an infinity,
# so the products contributed by x = 0 are all 0. IEEE 754 gives NaN, and a NaN
# endpoint makes ivl_contains report the interval as containing everything.
var xd_z = ivl_mul(ivl_point(0), xd_a);
assert_eq(Interval_lo(xd_z), f64_from(0), "[0,0] * [1,+inf) lo = 0, not NaN");
assert_eq(Interval_hi(xd_z), f64_from(0), "[0,0] * [1,+inf) hi = 0, not NaN");
assert_eq(ivl_contains(xd_z, f64_from(7)), 0, "[0,0] * [1,+inf) is not a NaN catch-all");

# === 3.3.3 G3: an overflowed inner endpoint ===
test_group("3.3.3 G3: an overflowed inner endpoint");
# Round-to-nearest takes an endpoint beyond the largest finite double (DBL_MAX) to
# Infinity, and through 3.3.2 that included the INNER endpoint: every overflowing op
# below returned the degenerate [+Inf, +Inf] or [-Inf, -Inf], which encloses no real
# number. Adding it to its mirror formed Inf - Inf = [NaN, NaN]. ivl_new now stores
# DBL_MAX for an overflowed lower bound and -DBL_MAX for an overflowed upper bound,
# which is what outward rounding gives. For add, sub, mul and div by D the true lower
# bound exceeds DBL_MAX, checked exactly with python3 Fractions, and for exp because
# 710.12 > ln(DBL_MAX) = 709.78; the bits of the finite expected endpoints are
# python3's IEEE products. The 3.3.2 values, from a probe against the shipped bundle,
# are in each message.
# [measured: scratch probe against dist/hisab.cyr 3.3.2, cycc 6.6.12, 2026-10-01]
var g3_max = 0x7FEFFFFFFFFFFFFF;    # DBL_MAX
var g3_nmax = 0xFFEFFFFFFFFFFFFF;   # -DBL_MAX
var g3_pinf = 0x7FF0000000000000;
var g3_ninf = 0xFFF0000000000000;
var g3_A = ivl_new(0x7FE5F9DD9EDB185D, 0x7FE92C80954C51F5);    # [1.2345678901234567e308, 1.4142135623730951e308]
var g3_B = ivl_new(0x7FE194B14E928D80, 0x7FE3C33B72569C63);    # [9.876543210987654e307, 1.1102230246251564e308]
var g3_add = ivl_add(g3_A, g3_B);
assert_eq(Interval_lo(g3_add), g3_max, "ivl_add overflow: lo = DBL_MAX (3.3.2: +Inf, a degenerate [+Inf, +Inf])");
assert_eq(Interval_hi(g3_add), g3_pinf, "ivl_add overflow: hi = +Inf");
var g3_addn = ivl_add(ivl_neg(g3_A), ivl_neg(g3_B));
assert_eq(Interval_lo(g3_addn), g3_ninf, "ivl_add overflow below: lo = -Inf");
assert_eq(Interval_hi(g3_addn), g3_nmax, "ivl_add overflow below: hi = -DBL_MAX (3.3.2: -Inf)");
var g3_sub = ivl_sub(g3_A, ivl_neg(g3_B));
assert_eq(Interval_lo(g3_sub), g3_max, "ivl_sub overflow: lo = DBL_MAX (3.3.2: +Inf)");
var g3_subn = ivl_sub(ivl_neg(g3_A), g3_B);
assert_eq(Interval_hi(g3_subn), g3_nmax, "ivl_sub overflow below: hi = -DBL_MAX (3.3.2: -Inf)");
var g3_M1 = ivl_new(0x6979CE4AE6F82488, 0x697B78319A39563C);   # [1.2345678901234567e200, 1.3141592653589793e200]
var g3_M2 = ivl_new(0x5F15B4E5998400A9, 0x5F18DDC3A6AEE319);   # [1.1102230246251565e150, 1.2718281828459044e150]
assert_eq(Interval_lo(ivl_mul(g3_M1, g3_M2)), g3_max, "ivl_mul overflow: lo = DBL_MAX (3.3.2: +Inf)");
assert_eq(Interval_hi(ivl_mul(ivl_neg(g3_M1), g3_M2)), g3_nmax, "ivl_mul overflow below: hi = -DBL_MAX (3.3.2: -Inf)");
var g3_D = ivl_new(0x20CD12D41AFCA3C2, 0x20D0A71B64472D97);    # [1.1102230246251564e-150, 1.2718281828459046e-150]
assert_eq(Interval_lo(ivl_div(g3_M1, g3_D)), g3_max, "ivl_div overflow: lo = DBL_MAX (3.3.2: +Inf)");
assert_eq(Interval_lo(ivl_exp(ivl_new(0x408630FCD6E9BA37, 0x40863A8365EED39D))), g3_max,
  "ivl_exp([710.12, 711.31]) lo = DBL_MAX: e^710.12 overflows (3.3.2: +Inf)");
# A subnormal divisor: its reciprocal overflows, so the INTERMEDIATE interval
# [1/bh, 1/bl] was [+Inf, +Inf] too. T / S has the finite true range [1.234e20,
# 2.634e21], and 3.3.2 returned [+Inf, +Inf], which excluded all of it. Clamping only
# the final result would return [DBL_MAX, +Inf] and still exclude it; 3.3.3's clamp in
# ivl_new reached the reciprocal, so its lower bound was lo(T) * DBL_MAX = 2.2e8.
# 3.3.4 divides the endpoints directly, so the quotients do not overflow at all, and
# the bounds are the exact range rounded outward. Expected bits: python3 Fractions.
# [measured: scratch harness, not reproducible in-tree, 2026-10-01; python3 Fraction oracle]
var g3_T = ivl_new(0x01AA74FE1C1E8908, 0x01AC29A409E3EB3F);    # [1.2345678901234568e-300, 1.3141592653589793e-300]
var g3_S = ivl_new(0x0000000000000065, 0x00000000000007E9);    # [101, 2025] * 2^-1074
var g3_ts = ivl_div(g3_T, g3_S);
assert_eq(Interval_lo(g3_ts), 0x441AC1EBA18F0434,
  "ivl_div by a subnormal: lo = RD(lo(T) / hi(S)) = 1.234e20 (3.3.3: lo(T) * DBL_MAX, 0x41AA74FE1C1E8907)");
assert_eq(Interval_hi(g3_ts), 0x4461D87C38F5CF5E,
  "ivl_div by a subnormal: hi = RU(hi(T) / lo(S)) = 2.634e21 (3.3.3: +Inf)");
# The two probes are the smallest double at or above the exact lower end and the
# largest at or below the exact upper end, so both lie inside the true range.
assert_eq(ivl_contains(g3_ts, 0x441AC1EBA18F0435), 1, "ivl_div by a subnormal encloses 1.234e20, the true lower end");
assert_eq(ivl_contains(g3_ts, 0x4461D87C38F5CF5D), 1, "ivl_div by a subnormal encloses 2.634e21, the true upper end");
# The zero-straddling path formed the half-line bounds 1/bh and 1/bl itself, not
# through ivl_new, so 3.3.3 clamped them there; 3.3.4 forms x / bh and x / bl
# instead. T / [0, s] is [1.234e20, +inf).
# [measured: scratch harness, not reproducible in-tree, 2026-10-01; python3 Fraction oracle]
var g3_tp = ivl_div(g3_T, ivl_new(0, 0x00000000000007E9));
assert_eq(Interval_lo(g3_tp), 0x441AC1EBA18F0434,
  "ivl_div by [0, 2025 * 2^-1074]: lo = RD(lo(T) / s) = 1.234e20 (3.3.3: lo(T) * DBL_MAX; 3.3.2: +Inf)");
assert_eq(Interval_hi(g3_tp), g3_pinf, "ivl_div by [0, 2025 * 2^-1074]: hi = +Inf");
var g3_tn = ivl_div(g3_T, ivl_new(0x80000000000007E9, 0));
assert_eq(Interval_lo(g3_tn), g3_ninf, "ivl_div by [-2025 * 2^-1074, 0]: lo = -Inf");
assert_eq(Interval_hi(g3_tn), 0xC41AC1EBA18F0434,
  "ivl_div by [-2025 * 2^-1074, 0]: hi = RU(lo(T) / -s) = -1.234e20 (3.3.3: -lo(T) * DBL_MAX; 3.3.2: -Inf)");
assert_eq(ivl_contains(g3_tn, 0xC41AC1EBA18F0435), 1, "ivl_div by [-s, 0] encloses -1.234e20, the true upper end");
# The constructor itself, at the input where the clamp fires.
var g3_k = ivl_new(g3_pinf, g3_pinf);
assert_eq(Interval_lo(g3_k), g3_max, "ivl_new(+Inf, +Inf): lo = DBL_MAX (3.3.2: +Inf)");
assert_eq(Interval_hi(g3_k), g3_pinf, "ivl_new(+Inf, +Inf): hi = +Inf");
var g3_kn = ivl_point(g3_ninf);
assert_eq(Interval_lo(g3_kn), g3_ninf, "ivl_point(-Inf): lo = -Inf");
assert_eq(Interval_hi(g3_kn), g3_nmax, "ivl_point(-Inf): hi = -DBL_MAX (3.3.2: -Inf)");
# The poisoning the roadmap row describes: adding the two overflowed sums, and
# subtracting one from itself, formed Inf - Inf. Both now give the entire line,
# which encloses the true answer (a finite interval around 0).
var g3_p1 = ivl_add(g3_add, g3_addn);
assert_eq(Interval_lo(g3_p1), g3_ninf, "overflowed A+B plus its mirror: lo = -Inf (3.3.2: NaN)");
assert_eq(Interval_hi(g3_p1), g3_pinf, "overflowed A+B plus its mirror: hi = +Inf (3.3.2: NaN)");
var g3_p2 = ivl_sub(g3_add, g3_add);
assert_eq(Interval_lo(g3_p2), g3_ninf, "overflowed A+B minus itself: lo = -Inf (3.3.2: NaN)");
assert_eq(Interval_hi(g3_p2), g3_pinf, "overflowed A+B minus itself: hi = +Inf (3.3.2: NaN)");
assert_eq(ivl_contains(g3_p2, f64_from(12345)), 1, "overflowed A+B minus itself encloses 12345");
# Control: a NaN endpoint is not rewritten (f64_eq is false for it).
var g3_nan_lo = Interval_lo(ivl_new(0x7FF8000000000000, g3_pinf));
assert_eq(f64_eq(g3_nan_lo, g3_nan_lo), 0, "ivl_new(NaN, +Inf): lo stays NaN, it is not clamped to a number");

# === 3.3.3 R4num: ivl_new's guard order and an unbounded sum ===
test_group("3.3.3 R4num: ivl_new's guard order and an unbounded sum");
# ivl_new orders its arguments first and clamps second. Clamping first would read a
# reversed call's infinity as an overflowed INNER bound: ivl_new(+Inf, 5) would be
# [5, DBL_MAX] and ivl_new(5, -Inf) [-DBL_MAX, 5], bounded sets standing for
# unbounded ones. The fixtures above pass the same infinity twice, where the order
# makes no difference.
# [measured: scratch mutant, both clamps moved ahead of the swap, cycc 6.6.12, 2026-10-01]
var r4i_r = ivl_new(g3_pinf, 0x4014000000000000);
assert_eq(Interval_lo(r4i_r), 0x4014000000000000, "ivl_new(+Inf, 5): lo = 5, the arguments swapped");
assert_eq(Interval_hi(r4i_r), g3_pinf, "ivl_new(+Inf, 5): hi = +Inf, not clamped (clamping before the swap: DBL_MAX)");
var r4i_l = ivl_new(0x4014000000000000, g3_ninf);
assert_eq(Interval_lo(r4i_l), g3_ninf, "ivl_new(5, -Inf): lo = -Inf, not clamped (clamping before the swap: -DBL_MAX)");
assert_eq(Interval_hi(r4i_l), 0x4014000000000000, "ivl_new(5, -Inf): hi = 5, the arguments swapped");
# The [NaN, NaN] that 3.3.2 did form from two unbounded quotients: T / [0, s] and
# T / [-s, 0] were [+Inf, +Inf] and [-Inf, -Inf], and their sum formed Inf - Inf.
# Their inner bounds are pinned above; the sum is now the entire line. (Either clamp,
# ivl_div's or ivl_new's, is enough for this sum on its own.)
# [measured: scratch probe against dist/hisab.cyr 3.3.2, cycc 6.6.12, 2026-10-01]
var r4i_s = ivl_add(g3_tp, g3_tn);
assert_eq(Interval_lo(r4i_s), g3_ninf, "T / [0, s] + T / [-s, 0]: lo = -Inf (3.3.2: NaN)");
assert_eq(Interval_hi(r4i_s), g3_pinf, "T / [0, s] + T / [-s, 0]: hi = +Inf (3.3.2: NaN)");

# === 3.3.3 G3: ivl_midpoint near the top of the range ===
test_group("3.3.3 G3: ivl_midpoint near the top of the range");
# (lo + hi) / 2 overflowed for a FINITE interval, so the midpoint of [1.23e308,
# 1.41e308] came back +Inf, outside it, and its mirror's came back -Inf. The expected
# bits are the correctly rounded exact midpoints, from python3 Fractions.
# [measured: scratch probe against dist/hisab.cyr 3.3.2, cycc 6.6.12, 2026-10-01]
assert_eq(ivl_midpoint(g3_A), 0x7FE7932F1A13B529, "ivl_midpoint([1.23e308, 1.41e308]) = 1.3244e308 (3.3.2: +Inf)");
assert_eq(ivl_contains(g3_A, ivl_midpoint(g3_A)), 1, "ivl_midpoint of [1.23e308, 1.41e308] lies inside it");
assert_eq(ivl_midpoint(ivl_neg(g3_A)), 0xFFE7932F1A13B529,
  "ivl_midpoint([-1.41e308, -1.23e308]) = -1.3244e308 (3.3.2: -Inf)");
# Control on the other side of the fallback: halving each endpoint first loses the
# subnormal 2^-1074 (half of it rounds to 0), so the sum form must still serve every
# finite sum. The midpoint of the point 2^-1074 is 2^-1074.
assert_eq(ivl_midpoint(ivl_point(0x0000000000000001)), 0x0000000000000001,
  "ivl_midpoint([2^-1074, 2^-1074]) = 2^-1074 (the halves form would give 0)");

# === 3.3.3 R4num: ivl_midpoint's fallback rounds once ===
test_group("3.3.3 R4num: ivl_midpoint's fallback rounds once");
# g3_A's endpoints are within a factor of 2 of each other, so hi - lo is exact
# (Sterbenz) and every midpoint formula agrees on it. For [2^970, DBL_MAX] the exact
# midpoint 2^1023 - 2^969 is a tie: the halves form rounds once, to the even 2^1023,
# while lo + (hi - lo) / 2 rounds hi - lo first and lands one ulp below, on
# 2^1023 - 2^970. Expected bits: python3 Fractions, rounded to nearest-even.
# [measured: scratch python3 Fraction oracle and scratch mutant (the textbook form), 2026-10-01]
assert_eq(ivl_midpoint(ivl_new(0x7C90000000000000, 0x7FEFFFFFFFFFFFFF)), 0x7FE0000000000000,
  "ivl_midpoint([2^970, DBL_MAX]) = 2^1023, the tie rounded to even (lo + (hi - lo) / 2: 0x7FDFFFFFFFFFFFFF)");

# === 3.3.4 outward rounding ===
# Through 3.3.3 every endpoint was rounded to nearest, so a bound could sit inside
# the exact one and exclude part of the exact image. Each endpoint is now rounded
# outward: the lower one to the largest double at or below the exact bound, the upper
# one to the smallest double at or above it. The expected bits are python3 Fractions'
# RD and RU of the exact bound; a message gives the 3.3.3 value, from a probe of the
# pre-patch bodies, where it differs. The sign-pattern and corner fixtures have full
# mantissas, picked so that the rounding to nearest goes INWARD at the endpoint the
# assertion pins. 3.3.3 divided through the reciprocal, which rounds twice, so three
# of its quotient bounds landed outward by chance; those messages say so.
# [measured: scratch python3 Fraction oracle and probe of the pre-patch bodies, cycc 6.6.14, 2026-10-03]
test_group("3.3.4 outward rounding: ivl_add, ivl_sub");
var ob_p = ivl_add(ivl_point(0x3FB999999999999A), ivl_point(0x3FC999999999999A));
assert_eq(Interval_lo(ob_p), 0x3FD3333333333333,
  "[0.1] + [0.2]: lo = RD(0.1 + 0.2) (3.3.3: 0x3FD3333333333334, above the exact sum)");
assert_eq(Interval_hi(ob_p), 0x3FD3333333333334, "[0.1] + [0.2]: hi = RU(0.1 + 0.2)");
var ob_a = ivl_add(ivl_new(0x3FD4B7F307DC8DAB, 0x3FECCFD588571832), ivl_new(0x3FE18F20E91364C4, 0x3FEB22581D939B7B));
assert_eq(Interval_lo(ob_a), 0x3FEBEB1A6D01AB99, "ivl_add: lo rounded down (3.3.3: 0x3FEBEB1A6D01AB9A)");
assert_eq(Interval_hi(ob_a), 0x3FFBF916D2F559D7, "ivl_add: hi rounded up (3.3.3: 0x3FFBF916D2F559D6)");
var ob_s = ivl_sub(ivl_new(0x3FCC0D7AE26D1412, 0x3FED89A72D1C03A0), ivl_new(0x3FC6CAF1BD77A34F, 0x3FE909D68FED0E31));
assert_eq(Interval_lo(ob_s), 0xBFE20677D751C92D, "ivl_sub: lo rounded down (3.3.3: 0xBFE20677D751C92C)");
assert_eq(Interval_hi(ob_s), 0x3FE7D6EABDBE1ACD, "ivl_sub: hi rounded up (3.3.3: 0x3FE7D6EABDBE1ACC)");
# Fast2Sum's error term is exact only with the larger operand first. With the smaller
# first it reads 0 on these two sums, and the endpoint would not move.
assert_eq(Interval_lo(ivl_add(ivl_point(0x3FBC54E768B70F5C), ivl_point(0x3FF0A125AC631922))), 0x3FF2667422EE8A17,
  "ivl_add, smaller operand first: lo = RD (unordered Fast2Sum: 0x3FF2667422EE8A18)");
assert_eq(Interval_hi(ivl_add(ivl_point(0x3FBA0C567810D525), ivl_point(0x4003A40D814961ED))), 0x400474703509E897,
  "ivl_add, smaller operand first: hi = RU (unordered Fast2Sum: 0x400474703509E896)");

test_group("3.3.4 outward rounding: ivl_mul");
# One fixture per sign pattern, so each of the four endpoint products is the one that
# sets lo, and each the one that sets hi, with its rounding inward.
var om_1 = ivl_mul(ivl_new(0x3FF849B3A4F6132C, 0x3FFA4A8D71A862B4), ivl_new(0x400BE4E280EC0C82, 0x400E42690813B0F7));
assert_eq(Interval_lo(om_1), 0x40152BE89D85AE1E, "ivl_mul pos * pos: lo = RD(al * bl) (3.3.3: 0x40152BE89D85AE1F)");
assert_eq(Interval_hi(om_1), 0x4018DC74A98B35CB, "ivl_mul pos * pos: hi = RU(ah * bh) (3.3.3: 0x4018DC74A98B35CA)");
var om_2 = ivl_mul(ivl_new(0xC00DD0195BE03611, 0xBFFE696B6E0B139C), ivl_new(0x4005BC9F231D5E57, 0x400D2CF505EF6EF0));
assert_eq(Interval_lo(om_2), 0xC02B2E7964EB4246, "ivl_mul neg * pos: lo = RD(al * bh) (3.3.3: 0xC02B2E7964EB4245)");
assert_eq(Interval_hi(om_2), 0xC014A871148AC76A, "ivl_mul neg * pos: hi = RU(ah * bl) (3.3.3: 0xC014A871148AC76B)");
var om_3 = ivl_mul(ivl_new(0x40034F4C911A465C, 0x4004D4B75FF1A99B), ivl_new(0xC00FEF480A05764E, 0xC0003A6DD46F687F));
assert_eq(Interval_lo(om_3), 0xC024C9D543A950A7, "ivl_mul pos * neg: lo = RD(ah * bl) (3.3.3: 0xC024C9D543A950A6)");
assert_eq(Interval_hi(om_3), 0xC01395D093430CE0, "ivl_mul pos * neg: hi = RU(al * bh) (3.3.3: 0xC01395D093430CE1)");
var om_4 = ivl_mul(ivl_new(0xC001E835DABD97AA, 0xBFF9633504660CAB), ivl_new(0xC0072F17F952CE00, 0xBFF9BA6AA1CF63AB));
assert_eq(Interval_lo(om_4), 0x40046966A8989530, "ivl_mul neg * neg: lo = RD(ah * bh) (3.3.3: 0x40046966A8989531)");
assert_eq(Interval_hi(om_4), 0x4019F2825D7AF421, "ivl_mul neg * neg: hi = RU(al * bl) (3.3.3: 0x4019F2825D7AF420)");
# A subnormal operand and a subnormal product: the exactness test splits each operand
# into mantissa and exponent, so neither the subnormal nor the product's scale loses a bit.
var om_5 = ivl_mul(ivl_point(0x0003CB9E7F1A2B3C), ivl_point(0x3FF3C0CA428C59FB));
assert_eq(Interval_lo(om_5), 0x0004AF879F5E8AD7, "ivl_mul, subnormal product: lo = RD (3.3.3: 0x0004AF879F5E8AD8)");
assert_eq(Interval_hi(om_5), 0x0004AF879F5E8AD8, "ivl_mul, subnormal product: hi = RU");
# The exact 0.951 * 2^-1074 rounds UP into the next binade, to 2^-1074, so the
# exactness test is decided by the exponents alone.
var om_8 = ivl_mul(ivl_point(0x1F2A94C5006D2CC7), ivl_point(0x1D9253299FCDB9E1));
assert_eq(Interval_lo(om_8), 0, "ivl_mul, 0.951 * 2^-1074 rounded up a binade: lo = 0 (3.3.3: 2^-1074)");
assert_eq(Interval_hi(om_8), 0x0000000000000001, "ivl_mul, 0.951 * 2^-1074 rounded up a binade: hi = 2^-1074");
# A product that underflows to 0 is positive (or negative) all the same: the outer
# bound steps to 2^-1074 (or -2^-1074), where 3.3.3 returned the degenerate [0, 0].
var om_u = ivl_new(0x16687E92154EF7AC, 0x16787E92154EF7AC);    # [1e-200, 2e-200]
var om_6 = ivl_mul(om_u, om_u);
assert_eq(Interval_lo(om_6), 0, "[1e-200, 2e-200]^2: lo = +0, the exact product rounded down");
assert_eq(Interval_hi(om_6), 0x0000000000000001, "[1e-200, 2e-200]^2: hi = 2^-1074 (3.3.3: 0, excluding 1e-400)");
var om_7 = ivl_mul(ivl_neg(om_u), om_u);
assert_eq(Interval_lo(om_7), 0x8000000000000001, "-[1e-200, 2e-200] * [1e-200, 2e-200]: lo = -2^-1074 (3.3.3: -0)");
assert_eq(Interval_hi(om_7), 0x8000000000000000, "-[1e-200, 2e-200] * [1e-200, 2e-200]: hi = -0");

test_group("3.3.4 outward rounding: ivl_div");
var od_1 = ivl_div(ivl_new(0x3FFAFC5901AA3519, 0x400A5D2824BF2144), ivl_new(0x3FFB6561D6BB9D86, 0x4006C536F4961791));
assert_eq(Interval_lo(od_1), 0x3FE2F6459181B3ED, "ivl_div pos / pos: lo = RD(al / bh) (3.3.3: 0x3FE2F6459181B3EE)");
assert_eq(Interval_hi(od_1), 0x3FFECB5EEF674A41, "ivl_div pos / pos: hi = RU(ah / bl) (3.3.3: 0x3FFECB5EEF674A40)");
var od_2 = ivl_div(ivl_new(0xC00EE9E865DB682D, 0xC00D80948CE4B771), ivl_new(0x3FF0DF7D01EFD629, 0x400F096D2DFB3AD5));
assert_eq(Interval_lo(od_2), 0xC00D507226D5E296, "ivl_div neg / pos: lo = RD(al / bl) (3.3.3: 0xC00D507226D5E295)");
assert_eq(Interval_hi(od_2), 0xBFEE6AF662A18D0F, "ivl_div neg / pos: hi = RU(ah / bh) (3.3.3: 0xBFEE6AF662A18D11)");
var od_3 = ivl_div(ivl_new(0x3FF9FAE1D4AE8481, 0x40022CC3A7BFE518), ivl_new(0xBFF2D92A005F8DA6, 0xBFF2A72A5A6C37F0));
assert_eq(Interval_lo(od_3), 0xBFFF2E03FD35F591,
  "ivl_div pos / neg: lo = RD(ah / bh) (to nearest: 0xBFFF2E03FD35F590; 3.3.3: the same as now)");
assert_eq(Interval_hi(od_3), 0xBFF60DD23620CAFB, "ivl_div pos / neg: hi = RU(al / bl) (3.3.3: 0xBFF60DD23620CAFC)");
var od_4 = ivl_div(ivl_new(0xC003775E979AF622, 0xC001DADD5479CF13), ivl_new(0xC0021BFB49549C10, 0xBFF1C50C6D507A7C));
assert_eq(Interval_lo(od_4), 0x3FEF8CEF64D8F730,
  "ivl_div neg / neg: lo = RD(ah / bl) (to nearest: 0x3FEF8CEF64D8F731; 3.3.3: the same as now)");
assert_eq(Interval_hi(od_4), 0x40018710EB82241C, "ivl_div neg / neg: hi = RU(al / bh) (3.3.3: 0x40018710EB82241B)");
var od_5 = ivl_div(ivl_point(F64_ONE), ivl_point(0x4008000000000000));
assert_eq(Interval_lo(od_5), 0x3FD5555555555555, "[1] / [3]: lo = RD(1/3)");
assert_eq(Interval_hi(od_5), 0x3FD5555555555556, "[1] / [3]: hi = RU(1/3) (3.3.3: the point 0x3FD5555555555555)");
# A divisor above 2^1022 has a subnormal reciprocal, which carries fewer bits; 3.3.3
# multiplied by it and returned the point 0x021E42EB06F25FD9, 3.6 ulp below the exact
# quotient 3.12e10 / 1.73e308. The quotient is now formed directly.
# [measured: scratch probe of the pre-patch bodies, cycc 6.6.14, 2026-10-03; python3 Fraction oracle]
var od_6 = ivl_div(ivl_point(0x421D0BDA51A75F88), ivl_point(0x7FEEB7102C030F84));
assert_eq(Interval_lo(od_6), 0x021E42EB06F25FDC, "3.12e10 / 1.73e308: lo = RD (3.3.3: 0x021E42EB06F25FD9)");
assert_eq(Interval_hi(od_6), 0x021E42EB06F25FDD, "3.12e10 / 1.73e308: hi = RU (3.3.3: 0x021E42EB06F25FD9)");
# The reciprocal of -5.14e-309 overflowed on the OUTER side, and 3.3.3 returned the
# entire line for a quotient whose exact range is [-1.045, 3.852].
# [measured: scratch probe of the pre-patch bodies, cycc 6.6.14, 2026-10-03; python3 Fraction oracle]
var od_7 = ivl_div(ivl_new(0x800E3CDBD952054E, 0x0003DC87A661E1A2), ivl_new(0xFCC8736B2ACF6197, 0x8003B230CC1169D9));
assert_eq(Interval_lo(od_7), 0xBFF0B748B748B747, "[-1.98e-308, 5.37e-309] / [-1.22e293, -5.14e-309]: lo (3.3.3: -Inf)");
assert_eq(Interval_hi(od_7), 0x400ED12ED12ED12B, "[-1.98e-308, 5.37e-309] / [-1.22e293, -5.14e-309]: hi (3.3.3: +Inf)");
# Subnormal quotients that cross a binade when rounded: 0.653 * 2^-1074 rounds up to
# 2^-1074 and 1.384 * 2^-1074 down to it, so q * y lands a binade above or below x.
var od_8 = ivl_div(ivl_point(0x0318575002FBCD4F), ivl_point(0x4642A30325E0BC86));
assert_eq(Interval_lo(od_8), 0, "ivl_div, 0.653 * 2^-1074 rounded up a binade: lo = 0 (3.3.3: 2^-1074)");
assert_eq(Interval_hi(od_8), 0x0000000000000001, "ivl_div, 0.653 * 2^-1074 rounded up a binade: hi = 2^-1074");
var od_9 = ivl_div(ivl_point(0x03A43689646C2D64), ivl_point(0x46BD334F60D2184A));
assert_eq(Interval_lo(od_9), 0x0000000000000001, "ivl_div, 1.384 * 2^-1074 rounded down a binade: lo = 2^-1074");
assert_eq(Interval_hi(od_9), 0x0000000000000002,
  "ivl_div, 1.384 * 2^-1074 rounded down a binade: hi = 2 * 2^-1074 (3.3.3: 2^-1074)");
# At the corner where both are unbounded, Inf / Inf is 0, a point of the closure, so
# [1, +inf) / [2, +inf) is [0, +inf), as 3.3.3's reciprocal form gave. IEEE's NaN
# there would make the interval a catch-all.
var od_10 = ivl_div(ivl_new(F64_ONE, 0x7FF0000000000000), ivl_new(F64_TWO, 0x7FF0000000000000));
assert_eq(Interval_lo(od_10), 0, "[1, +inf) / [2, +inf): lo = 0, not NaN");
assert_eq(Interval_hi(od_10), 0x7FF0000000000000, "[1, +inf) / [2, +inf): hi = +inf, not NaN");
# A divisor with 0 at one end: the finite bound is one corner quotient, rounded outward.
assert_eq(Interval_lo(ivl_div(ivl_new(0x4000F5A0E5CD28C3, 0x40031CB79AD6F305), ivl_new(0, 0x3FF6A65F4F1DEB2C))),
  0x3FF7F5E5BB5F89E6, "pos / [0, b]: lo = RD(al / b) (3.3.3: 0x3FF7F5E5BB5F89E7)");
assert_eq(Interval_hi(ivl_div(ivl_new(0xC00D8F2489D068A0, 0xBFF3E10CE6010F94), ivl_new(0, 0x40054D7010CF24F3))),
  0xBFDDDCA0A9F11057, "neg / [0, b]: hi = RU(ah / b) (3.3.3: 0xBFDDDCA0A9F11058)");
assert_eq(Interval_lo(ivl_div(ivl_new(0xBFFB6CB1A64ED95C, 0xBFF55352BECB67DA), ivl_new(0xC00426845D9D7C30, 0))),
  0x3FE0EED91E0E43E9, "neg / [b, 0]: lo = RD(ah / b) (3.3.3: 0x3FE0EED91E0E43EA)");
assert_eq(Interval_hi(ivl_div(ivl_new(0x40062B97AA30A2B5, 0x400E2C029CF9134C), ivl_new(0xC00A94BE3310B8F5, 0))),
  0xBFEAB0A76323688B, "pos / [b, 0]: hi = RU(al / b) (to nearest: 0xBFEAB0A76323688C; 3.3.3: the same as now)");
# A NaN endpoint makes two of the four corners NaN, and f64_min/f64_max keep or drop a
# NaN by its position: [1, 2] / [NaN, 1] came back [1, 2] and [1] * [NaN, 1] [1, 1],
# finite answers from an operand with no value. The NaN now reaches both endpoints.
# NaN-ness is asserted, not bits: the payload is the target's.
var od_n = ivl_div(ivl_new(F64_ONE, F64_TWO), ivl_new(0x7FF8000000000000, F64_ONE));
assert_eq(f64_eq(Interval_lo(od_n), Interval_lo(od_n)), 0, "[1, 2] / [NaN, 1]: lo is NaN (3.3.3: NaN too)");
assert_eq(f64_eq(Interval_hi(od_n), Interval_hi(od_n)), 0, "[1, 2] / [NaN, 1]: hi is NaN (3.3.3: NaN too)");
var om_n = ivl_mul(ivl_point(F64_ONE), ivl_new(0x7FF8000000000000, F64_ONE));
assert_eq(f64_eq(Interval_lo(om_n), Interval_lo(om_n)), 0, "[1] * [NaN, 1]: lo is NaN (3.3.3: 1)");
assert_eq(f64_eq(Interval_hi(om_n), Interval_hi(om_n)), 0, "[1] * [NaN, 1]: hi is NaN (3.3.3: 1)");
# A NaN at each endpoint position in turn, through both operations: the guard is four
# lines, one per corner, and each position makes a different pair of corners NaN.
var ivn_run = 0;
var ivn_bad = 0;
for (var ivn_k = 0; ivn_k < 4; ivn_k = ivn_k + 1) {
    var ivn_a = ivl_new(F64_ONE, F64_TWO);
    var ivn_b = ivl_new(F64_ONE, 0x4008000000000000);
    if (ivn_k == 0) { Interval_set_lo(ivn_a, 0x7FF8000000000000); }
    if (ivn_k == 1) { Interval_set_hi(ivn_a, 0x7FF8000000000000); }
    if (ivn_k == 2) { Interval_set_lo(ivn_b, 0x7FF8000000000000); }
    if (ivn_k == 3) { Interval_set_hi(ivn_b, 0x7FF8000000000000); }
    var ivn_d = ivl_div(ivn_a, ivn_b);
    var ivn_m = ivl_mul(ivn_a, ivn_b);
    ivn_run = ivn_run + 1;
    if (f64_eq(Interval_lo(ivn_d), Interval_lo(ivn_d)) == 1) { ivn_bad = ivn_bad + 1; }
    if (f64_eq(Interval_hi(ivn_d), Interval_hi(ivn_d)) == 1) { ivn_bad = ivn_bad + 1; }
    if (f64_eq(Interval_lo(ivn_m), Interval_lo(ivn_m)) == 1) { ivn_bad = ivn_bad + 1; }
    if (f64_eq(Interval_hi(ivn_m), Interval_hi(ivn_m)) == 1) { ivn_bad = ivn_bad + 1; }
}
assert_eq(ivn_run, 4, "the NaN-endpoint sweep actually ran 4 positions");
assert_eq(ivn_bad, 0, "[1, 2] and [1, 3] with a NaN at any endpoint: div and mul are NaN at both ends");

test_group("3.3.4 outward rounding: ivl_sqrt, ivl_exp, ivl_sin");
var oq_1 = ivl_sqrt(ivl_point(F64_TWO));
assert_eq(Interval_lo(oq_1), 0x3FF6A09E667F3BCC, "ivl_sqrt([2]): lo = RD(sqrt 2) (3.3.3: 0x3FF6A09E667F3BCD)");
assert_eq(Interval_hi(oq_1), 0x3FF6A09E667F3BCD, "ivl_sqrt([2]): hi = RU(sqrt 2)");
var oq_2 = ivl_sqrt(ivl_point(0x0000000000000003));
assert_eq(Interval_lo(oq_2), 0x1E6BB67AE8584CAA, "ivl_sqrt([3 * 2^-1074]): lo = RD");
assert_eq(Interval_hi(oq_2), 0x1E6BB67AE8584CAB, "ivl_sqrt([3 * 2^-1074]): hi = RU (3.3.3: 0x1E6BB67AE8584CAA)");
# exp and sin are widened by two doubles, the stdlib's error bound, except at an exact
# value. The relative pins below read the bits f64_exp and f64_sin return on this target
# into a var first: `f64_exp(x) - 2` would be compiled as f64 arithmetic.
var oe_1 = ivl_exp(ivl_new(0xC08F400000000000, 0xC08C200000000000));    # [-1000, -900]
assert_eq(Interval_lo(oe_1), 0, "ivl_exp([-1000, -900]): lo = 0, the widened 0 raised to exp's floor");
assert_eq(Interval_hi(oe_1), 0x0000000000000002, "ivl_exp([-1000, -900]): hi = 2 * 2^-1074 (3.3.3: 0)");
var oe_2 = ivl_exp(ivl_point(0));
assert_eq(Interval_lo(oe_2), F64_ONE, "ivl_exp([0]): lo = 1, exact, not widened");
assert_eq(Interval_hi(oe_2), F64_ONE, "ivl_exp([0]): hi = 1, exact, not widened");
var oe_3 = ivl_exp(ivl_point(F64_ONE));
var oe_e = f64_exp(F64_ONE);
assert_eq(Interval_lo(oe_3), oe_e - 2, "ivl_exp([1]): lo = f64_exp(1) two doubles down");
assert_eq(Interval_hi(oe_3), oe_e + 2, "ivl_exp([1]): hi = f64_exp(1) two doubles up");
assert_eq(f64_le(Interval_lo(oe_3), 0x4005BF0A8B145769), 1, "ivl_exp([1]): lo <= RD(e)");
assert_eq(f64_ge(Interval_hi(oe_3), 0x4005BF0A8B14576A), 1, "ivl_exp([1]): hi >= RU(e)");
var os_1 = ivl_sin(ivl_point(F64_ONE));
var os_s = f64_sin(F64_ONE);
assert_eq(Interval_lo(os_1), os_s - 2, "ivl_sin([1]): lo = f64_sin(1) two doubles down");
assert_eq(Interval_hi(os_1), os_s + 2, "ivl_sin([1]): hi = f64_sin(1) two doubles up");
assert_eq(f64_le(Interval_lo(os_1), 0x3FEAED548F090CEE), 1, "ivl_sin([1]): lo <= RD(sin 1)");
assert_eq(f64_ge(Interval_hi(os_1), 0x3FEAED548F090CEF), 1, "ivl_sin([1]): hi >= RU(sin 1)");
var os_2 = ivl_sin(ivl_point(0));
assert_eq(Interval_lo(os_2), 0, "ivl_sin([0]): lo = 0, exact, not widened");
assert_eq(Interval_hi(os_2), 0, "ivl_sin([0]): hi = 0, exact, not widened");
# 2e-9 past PI/2 sin rounds to 1.0 with no extremum in the interval, so only the clamp
# to [-1, 1] keeps the widened bound from passing 1.
assert_eq(Interval_hi(ivl_sin(ivl_point(0x3FF921FB54CD9D77))), F64_ONE,
  "ivl_sin([PI/2 + 2e-9]): hi = 1, clamped (unclamped: 1 + 2^-51)");
assert_eq(Interval_lo(ivl_sin(ivl_point(0xBFF921FB54CD9D77))), 0xBFF0000000000000,
  "ivl_sin([-PI/2 - 2e-9]): lo = -1, clamped (unclamped: -1 - 2^-51)");
# Pairs of adjacent doubles with an extremum between them, where the rounded k-range
# test misses it without its margin: one fixture for each of its four bounds (the
# extremum's k falls just past the lower or the upper k-bound, for a maximum and for a
# minimum). Without the margin each bound below would stop short of +/-1.
# [measured: scratch Decimal search with the k-test in IEEE doubles, and mutants, cycc 6.6.14, 2026-10-03]
assert_eq(Interval_lo(ivl_sin(ivl_new(0x41C703362B11580C, 0x41C703362B11580D))), 0xBFF0000000000000,
  "ivl_sin around a minimum near 7.7e8 (upper k-bound): lo = -1 (no margin: 0xBFEFFFFFFFFFFFFF)");
assert_eq(Interval_lo(ivl_sin(ivl_new(0x42308F0594640560, 0x42308F0594640561))), 0xBFF0000000000000,
  "ivl_sin around a minimum near 7.1e10 (lower k-bound): lo = -1");
assert_eq(Interval_hi(ivl_sin(ivl_new(0x42201DDAE35EF191, 0x42201DDAE35EF192))), F64_ONE,
  "ivl_sin around a maximum near 3.5e10 (lower k-bound): hi = 1");
assert_eq(Interval_hi(ivl_sin(ivl_new(0xC2000AD1DFD12665, 0xC2000AD1DFD12664))), F64_ONE,
  "ivl_sin around a maximum near -8.6e9 (upper k-bound): hi = 1");
# [+Inf, +Inf] and [-Inf, -Inf] set by hand: ivl_new would clamp them to half-lines.
# The span Inf - Inf is NaN, so without its own guard each came back [NaN, NaN]; sin
# covers [-1, 1] there, as 3.3.3 returned. [+Inf, NaN] is not a point and stays NaN.
var os_pi = ivl_point(0);
Interval_set_lo(os_pi, 0x7FF0000000000000);
Interval_set_hi(os_pi, 0x7FF0000000000000);
assert_eq(Interval_lo(ivl_sin(os_pi)), 0xBFF0000000000000, "ivl_sin([+Inf, +Inf]) set by hand: lo = -1");
assert_eq(Interval_hi(ivl_sin(os_pi)), F64_ONE, "ivl_sin([+Inf, +Inf]) set by hand: hi = 1");
var os_ni = ivl_point(0);
Interval_set_lo(os_ni, 0xFFF0000000000000);
Interval_set_hi(os_ni, 0xFFF0000000000000);
assert_eq(Interval_lo(ivl_sin(os_ni)), 0xBFF0000000000000, "ivl_sin([-Inf, -Inf]) set by hand: lo = -1");
assert_eq(Interval_hi(ivl_sin(os_ni)), F64_ONE, "ivl_sin([-Inf, -Inf]) set by hand: hi = 1");
var os_pn = ivl_point(0);
Interval_set_lo(os_pn, 0x7FF0000000000000);
Interval_set_hi(os_pn, 0x7FF8000000000000);
var os_pn_lo = Interval_lo(ivl_sin(os_pn));
assert_eq(f64_eq(os_pn_lo, os_pn_lo), 0, "ivl_sin([+Inf, NaN]) set by hand: lo is NaN, not -1");

# ================================================================
# Autodiff -- ad_ln's domain guard, asked directly (3.2.0)
# ================================================================
# The tape twin of dual_ln shipped in 2.11.0 with the same `f64_gt(v, 0) != 1`
# guard and, until 3.2.0, no test reached it at all. The contract, from
# autodiff.cyr: outside v > 0 the op pushes the miss sentinel (value 0, local
# partial 0) -- never a NaN value beside a confident finite derivative, which is
# what the pre-2.11.0 `f64_abs(v)` guard produced for dual_ln(-5). The reverse
# sweep over a sentinel node must therefore hand the input an adjoint of exactly
# 0. Each case is compared bit for bit against the forward-mode twin, which is
# the module's stated oracle.
test_group("edge: ad_ln domain guard (tape mode)");

var eal_t = ad_tape_new(16);
# ln(-5): outside the domain.
var eal_n5 = ad_var(eal_t, f64_neg(f64_from(5)));
var eal_ln_n5 = ad_ln(eal_t, eal_n5);
assert_eq(ad_ok(eal_t, eal_ln_n5), 1, "ad_ln(-5) still pushes a node (it is a sentinel, not AD_FULL)");
assert_eq(ad_val(eal_t, eal_ln_n5), f64_from(0), "ad_ln(-5): value is the sentinel 0, not NaN");
var _eal1t, _eal1v = ad_grad(eal_t, eal_ln_n5);
assert_eq(is_ok(_eal1t), 1, "ad_ln(-5): the sweep over a sentinel node succeeds");
assert_eq(ad_grad_of(eal_t, eal_n5), f64_from(0), "ad_ln(-5): adjoint of x is 0, not a confident -0.2");
assert_eq(ad_val(eal_t, eal_ln_n5), Dual_val(dual_ln(dual_var(f64_neg(f64_from(5))))),
  "ad_ln(-5) value agrees with dual_ln bit for bit");
assert_eq(ad_grad_of(eal_t, eal_n5), Dual_deriv(dual_ln(dual_var(f64_neg(f64_from(5))))),
  "ad_ln(-5) derivative agrees with dual_ln bit for bit");
# ln(0): the boundary is OUTSIDE the domain (ln 0 = -inf, derivative unbounded).
var eal_z = ad_var(eal_t, 0);
var eal_ln_z = ad_ln(eal_t, eal_z);
assert_eq(ad_val(eal_t, eal_ln_z), f64_from(0), "ad_ln(0): value is the sentinel 0, not -inf");
var _eal2t, _eal2v = ad_grad(eal_t, eal_ln_z);
assert_eq(is_ok(_eal2t), 1, "ad_ln(0): sweep succeeds");
assert_eq(ad_grad_of(eal_t, eal_z), f64_from(0), "ad_ln(0): adjoint is 0, not +inf");
# ln(NaN): every comparison with NaN is false, so `f64_gt(v, 0) != 1` rejects it.
var eal_nan = f64_div(0, 0);
var eal_xn = ad_var(eal_t, eal_nan);
var eal_ln_nan = ad_ln(eal_t, eal_xn);
assert_eq(ad_val(eal_t, eal_ln_nan), f64_from(0), "ad_ln(NaN): value is the sentinel 0, not NaN");
var _eal3t, _eal3v = ad_grad(eal_t, eal_ln_nan);
assert_eq(is_ok(_eal3t), 1, "ad_ln(NaN): sweep succeeds");
assert_eq(ad_grad_of(eal_t, eal_xn), f64_from(0), "ad_ln(NaN): adjoint is 0, not NaN");
assert_eq(ad_val(eal_t, eal_ln_nan), Dual_val(dual_ln(dual_var(eal_nan))),
  "ad_ln(NaN) agrees with dual_ln bit for bit");
# ⚠ THE CONTROL: the guard must stop EXACTLY at 0. DBL_MIN is inside the domain
# and ln is finite there (ln(DBL_MIN) = -708.4, derivative 1/DBL_MIN = 4.49e307,
# both finite), so a guard that fired one binade early -- any threshold chosen
# for it rather than derived from the domain -- shows up here as the sentinel.
var eal_tiny = ad_var(eal_t, F64_TINY);
var eal_ln_tiny = ad_ln(eal_t, eal_tiny);
assert(f64_lt(ad_val(eal_t, eal_ln_tiny), f64_neg(f64_from(708))) == 1,
  "ad_ln(DBL_MIN): value is below -708, not the sentinel");
var _eal4t, _eal4v = ad_grad(eal_t, eal_ln_tiny);
assert_eq(is_ok(_eal4t), 1, "ad_ln(DBL_MIN): sweep succeeds");
assert(f64_gt(ad_grad_of(eal_t, eal_tiny), f64_from(0)) == 1, "ad_ln(DBL_MIN): adjoint is positive");
assert(f64_lt(ad_grad_of(eal_t, eal_tiny), F64_POS_INF) == 1, "ad_ln(DBL_MIN): adjoint is finite");
assert_eq(ad_grad_of(eal_t, eal_tiny), Dual_deriv(dual_ln(dual_var(F64_TINY))),
  "ad_ln(DBL_MIN) derivative agrees with dual_ln bit for bit");
# And 1e-13, the value 2.11.0 measured the old guard fabricating (0, 0) for.
# [measured: docs/development/issues/archived/2026-08-11-forward-mode-dual-guards.md]
var eal_e13 = F64_ONE;
for (var eal_i = 0; eal_i < 13; eal_i = eal_i + 1) { eal_e13 = f64_div(eal_e13, f64_from(10)); }
var eal_x13 = ad_var(eal_t, eal_e13);
var eal_ln_13 = ad_ln(eal_t, eal_x13);
assert_eq(ad_val(eal_t, eal_ln_13), f64_ln(eal_e13), "ad_ln(1e-13) is ln(1e-13) = -29.93, not a fabricated 0");
var _eal5t, _eal5v = ad_grad(eal_t, eal_ln_13);
assert_eq(is_ok(_eal5t), 1, "ad_ln(1e-13): sweep succeeds");
assert_eq(ad_grad_of(eal_t, eal_x13), f64_div(F64_ONE, eal_e13), "ad_ln(1e-13): adjoint is exactly 1/1e-13");

test_group("3.3.0 noise_perm builds its table on first use");
# This suite makes no other noise call, so this is the first touch of the table in
# the process -- the case the public lookup exists for. Through 3.2.x the lookup was
# `_perm(idx)`, reached from three files, which read `0 + idx` unless some earlier
# call had run `_perm_init()`. Ken Perlin's reference table, doubled: P[0] = 151,
# P[255] = 180, and index i reads P[i & 511].
assert_eq(noise_perm(0), 151, "noise_perm(0) = 151 on the first touch of the table");
assert_eq(noise_perm(255), 180, "noise_perm(255) = 180");
assert_eq(noise_perm(256), 151, "noise_perm(256) = 151: the table is doubled");
assert_eq(noise_perm(767), 180, "noise_perm(767) = 180: the index wraps at 512");

# ================================================================
var r = assert_summary();
# Clamp before exiting: assert_summary() returns the raw failure COUNT, and a wait
# status is only 8 bits — an unclamped 256 / 512 / 768 failures would exit 0 and
# score PASS. Any failure at all is exit 1.
if (r > 0) { r = 1; }
sys_exit_group(r);
