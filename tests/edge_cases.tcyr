# ================================================================
# Calc — Simpson with 0 steps → error
# ================================================================
test_group("edge: calc simpson 0 steps");

var ec_out = alloc(8);
var ec_t0, ec_v0 = calc_integral_simpson(&_ec_x2, 0, F64_ONE, 0, ec_out);
assert_eq(is_err_result(ec_t0), 1, "simpson 0 steps → Err");
assert_eq(ec_v0, HSB_ERR_ZERO_STEPS, "simpson 0 steps → the code is in the PAYLOAD");

# Simpson with 1 step (odd → rounds to 2)
var ec_t1, ec_v1 = calc_integral_simpson(&_ec_const5, 0, F64_ONE, 1, ec_out);
assert_eq(is_ok(ec_t1), 1, "simpson 1 step ok");
assert_eq(load64(ec_out), f64_from(5), "simpson 1 step const=5");

# === 3.3.3 G4: zero-width quadrature ===
# ⛔ The three fixed rules formed (b - a) * (sum of samples), so b == a with an
# infinite f(a) was 0 * Inf = NaN — stored as Ok by trapez and simpson — and a
# negative integrand gave -0. The integral over a point is exactly 0: each now
# returns +0 without calling f. The test is the WIDTH, so equal infinite endpoints
# (width NaN) are not caught by it and still give NaN.
# ⚠ The +0 is asserted by BITS on purpose: -0 was the 3.3.2 answer for f = -1.
# [measured: zero-width probe on the 3.3.2 bundle, 2026-10-01]
var _g4_ec_calls = 0;
fn _g4_ec_inf(x) { _g4_ec_calls = _g4_ec_calls + 1; return F64_POS_INF; }
fn _g4_ec_neg(x) { _g4_ec_calls = _g4_ec_calls + 1; return f64_neg(F64_ONE); }

store64(ec_out, F64_TWO);
var _g4_ec_t1, _g4_ec_v1 = calc_integral_trapez(&_g4_ec_inf, F64_ONE, F64_ONE, 4, ec_out);
assert_eq(is_ok(_g4_ec_t1), 1, "trapez zero width -> Ok");
assert_eq(load64(ec_out), 0, "trapez zero width, f = +Inf -> +0 (was NaN)");
store64(ec_out, F64_TWO);
var _g4_ec_t2, _g4_ec_v2 = calc_integral_simpson(&_g4_ec_inf, F64_ONE, F64_ONE, 4, ec_out);
assert_eq(is_ok(_g4_ec_t2), 1, "simpson zero width -> Ok");
assert_eq(load64(ec_out), 0, "simpson zero width, f = +Inf -> +0 (was NaN)");
assert_eq(calc_integral_gauss5(&_g4_ec_inf, F64_ONE, F64_ONE), 0,
  "gauss5 zero width, f = +Inf -> +0 (was NaN)");
assert_eq(_g4_ec_calls, 0, "zero-width quadrature never calls f");

store64(ec_out, F64_TWO);
var _g4_ec_t3, _g4_ec_v3 = calc_integral_trapez(&_g4_ec_neg, F64_ONE, F64_ONE, 4, ec_out);
assert_eq(load64(ec_out), 0, "trapez zero width, f = -1 -> +0 (was -0)");
store64(ec_out, F64_TWO);
var _g4_ec_t4, _g4_ec_v4 = calc_integral_simpson(&_g4_ec_neg, F64_ONE, F64_ONE, 4, ec_out);
assert_eq(load64(ec_out), 0, "simpson zero width, f = -1 -> +0 (was -0)");
assert_eq(calc_integral_gauss5(&_g4_ec_neg, F64_ONE, F64_ONE), 0, "gauss5 zero width, f = -1 -> +0 (was -0)");
# -0 and +0 are the same point: b - a is -0 here, and it is still a zero width.
store64(ec_out, F64_TWO);
var _g4_ec_t5, _g4_ec_v5 = calc_integral_trapez(&_g4_ec_neg, 0, 0x8000000000000000, 4, ec_out);
assert_eq(load64(ec_out), 0, "trapez over [+0, -0] -> +0");
store64(ec_out, F64_TWO);
var _g4_ec_t8, _g4_ec_v8 = calc_integral_simpson(&_g4_ec_neg, 0, 0x8000000000000000, 4, ec_out);
assert_eq(load64(ec_out), 0, "simpson over [+0, -0] -> +0");
assert_eq(calc_integral_gauss5(&_g4_ec_neg, 0, 0x8000000000000000), 0, "gauss5 over [+0, -0] -> +0");
assert_eq(_g4_ec_calls, 0, "zero-width quadrature never calls f (negative integrand)");

# The step count is checked BEFORE the width: an invalid count is refused over a
# point too, and `out` is left alone.
store64(ec_out, F64_TWO);
var _g4_ec_t9, _g4_ec_v9 = calc_integral_trapez(&_g4_ec_neg, F64_ONE, F64_ONE, 0, ec_out);
assert_eq(_g4_ec_v9, HSB_ERR_ZERO_STEPS, "trapez zero width, steps = 0 -> HSB_ERR_ZERO_STEPS");
var _g4_ec_t10, _g4_ec_v10 = calc_integral_trapez(&_g4_ec_neg, F64_ONE, F64_ONE, 0 - 1, ec_out);
assert_eq(_g4_ec_v10, HSB_ERR_INVALID_INPUT, "trapez zero width, steps = -1 -> HSB_ERR_INVALID_INPUT");
var _g4_ec_t11, _g4_ec_v11 = calc_integral_simpson(&_g4_ec_neg, F64_ONE, F64_ONE, 0, ec_out);
assert_eq(_g4_ec_v11, HSB_ERR_ZERO_STEPS, "simpson zero width, steps = 0 -> HSB_ERR_ZERO_STEPS");
var _g4_ec_t12, _g4_ec_v12 = calc_integral_simpson(&_g4_ec_neg, F64_ONE, F64_ONE, 0 - 1, ec_out);
assert_eq(_g4_ec_v12, HSB_ERR_INVALID_INPUT, "simpson zero width, steps = -1 -> HSB_ERR_INVALID_INPUT");
assert_eq(load64(ec_out), F64_TWO, "zero width with a refused step count: out untouched");

# The width test, not an equality test: [+Inf, +Inf] has width NaN and is left to
# the arithmetic, which gives NaN — an `a == b` test would have returned 0 here.
assert_eq(f64_eq(calc_integral_gauss5(&_g4_ec_neg, F64_POS_INF, F64_POS_INF),
    calc_integral_gauss5(&_g4_ec_neg, F64_POS_INF, F64_POS_INF)), 0,
  "gauss5 over [+Inf, +Inf] -> NaN, not 0");
store64(ec_out, F64_TWO);
var _g4_ec_t6, _g4_ec_v6 = calc_integral_trapez(&_g4_ec_neg, F64_POS_INF, F64_POS_INF, 4, ec_out);
assert_eq(f64_eq(load64(ec_out), load64(ec_out)), 0, "trapez over [+Inf, +Inf] -> NaN, not 0");
store64(ec_out, F64_TWO);
var _g4_ec_t7, _g4_ec_v7 = calc_integral_simpson(&_g4_ec_neg, F64_POS_INF, F64_POS_INF, 4, ec_out);
assert_eq(f64_eq(load64(ec_out), load64(ec_out)), 0, "simpson over [+Inf, +Inf] -> NaN, not 0");

# === 3.3.3 R3b: simpson with a non-finite sample ===
test_group("3.3.3 R3b: simpson with a non-finite sample");
# ⛔ calc_integral_simpson's Neumaier correction formed Inf - Inf once a term was
# infinite, so a single infinite sample stored NaN as Ok where calc_integral_trapez
# stores ±Inf. An infinite or NaN sample now stores the class of the true sum: ±Inf
# for infinite samples of one sign, NaN for both signs or a NaN sample.
# Each fixture sets f at the five nodes of [0, 1] with 4 steps (x = 0, 1/4, 1/2,
# 3/4, 1). "3.3.2:" is what the 3.3.2 bundle stored; NaN is tested as NaN-ness, the
# payload not being part of the claim.
# [measured: fixture probe on the 3.3.2 bundle, cycc 6.6.12, 2026-10-01]
var _r3b_ec_v = alloc(40);
fn _r3b_ec_f(x) {
    if (x == 0) { return load64(_r3b_ec_v); }
    if (x == 0x3FD0000000000000) { return load64(_r3b_ec_v + 8); }
    if (x == 0x3FE0000000000000) { return load64(_r3b_ec_v + 16); }
    if (x == 0x3FE8000000000000) { return load64(_r3b_ec_v + 24); }
    if (x == F64_ONE) { return load64(_r3b_ec_v + 32); }
    return 0x7FF8000000000BAD;
}
fn _r3b_ec_set(f0, f1, f2, f3, f4) {
    store64(_r3b_ec_v, f0);
    store64(_r3b_ec_v + 8, f1);
    store64(_r3b_ec_v + 16, f2);
    store64(_r3b_ec_v + 24, f3);
    store64(_r3b_ec_v + 32, f4);
    return 0;
}
var _r3b_ec_ninf = 0xFFF0000000000000;
var _r3b_ec_nan = 0x7FF8000000000000;

_r3b_ec_set(F64_ONE, F64_ONE, F64_POS_INF, F64_ONE, F64_ONE);
store64(ec_out, F64_TWO);
var _r3b_ec_t1, _r3b_ec_r1 = calc_integral_simpson(&_r3b_ec_f, 0, F64_ONE, 4, ec_out);
assert_eq(is_ok(_r3b_ec_t1), 1, "simpson, f(1/2) = +Inf: Ok");
assert_eq(load64(ec_out), F64_POS_INF, "simpson, f(1/2) = +Inf -> +Inf (3.3.2: NaN)");
var _r3b_ec_t2, _r3b_ec_r2 = calc_integral_trapez(&_r3b_ec_f, 0, F64_ONE, 4, ec_out);
assert_eq(load64(ec_out), F64_POS_INF, "trapez, f(1/2) = +Inf -> +Inf, the answer simpson now gives (control)");

_r3b_ec_set(F64_ONE, F64_ONE, _r3b_ec_ninf, F64_ONE, F64_ONE);
var _r3b_ec_t3, _r3b_ec_r3 = calc_integral_simpson(&_r3b_ec_f, 0, F64_ONE, 4, ec_out);
assert_eq(load64(ec_out), _r3b_ec_ninf, "simpson, f(1/2) = -Inf -> -Inf (3.3.2: NaN)");
_r3b_ec_set(F64_ONE, F64_POS_INF, F64_ONE, F64_ONE, F64_ONE);
var _r3b_ec_t4, _r3b_ec_r4 = calc_integral_simpson(&_r3b_ec_f, 0, F64_ONE, 4, ec_out);
assert_eq(load64(ec_out), F64_POS_INF, "simpson, f(1/4) = +Inf (weight 4) -> +Inf (3.3.2: NaN)");
# An endpoint enters the sum before the loop: the sum is infinite from the start.
_r3b_ec_set(F64_POS_INF, F64_ONE, F64_ONE, F64_ONE, F64_ONE);
var _r3b_ec_t5, _r3b_ec_r5 = calc_integral_simpson(&_r3b_ec_f, 0, F64_ONE, 4, ec_out);
assert_eq(load64(ec_out), F64_POS_INF, "simpson, f(0) = +Inf -> +Inf (3.3.2: NaN)");
_r3b_ec_set(F64_ONE, F64_ONE, F64_ONE, F64_ONE, _r3b_ec_ninf);
var _r3b_ec_t6, _r3b_ec_r6 = calc_integral_simpson(&_r3b_ec_f, 0, F64_ONE, 4, ec_out);
assert_eq(load64(ec_out), _r3b_ec_ninf, "simpson, f(1) = -Inf -> -Inf (3.3.2: NaN)");

# NaN only where the sum of the terms is NaN: infinities of both signs, or a NaN.
_r3b_ec_set(F64_ONE, F64_POS_INF, F64_ONE, _r3b_ec_ninf, F64_ONE);
var _r3b_ec_t7, _r3b_ec_r7 = calc_integral_simpson(&_r3b_ec_f, 0, F64_ONE, 4, ec_out);
assert_eq(f64_eq(load64(ec_out), load64(ec_out)), 0, "simpson, f(1/4) = +Inf and f(3/4) = -Inf -> NaN");
_r3b_ec_set(F64_ONE, F64_ONE, _r3b_ec_nan, F64_ONE, F64_ONE);
var _r3b_ec_t8, _r3b_ec_r8 = calc_integral_simpson(&_r3b_ec_f, 0, F64_ONE, 4, ec_out);
assert_eq(f64_eq(load64(ec_out), load64(ec_out)), 0, "simpson, f(1/2) = NaN -> NaN");
_r3b_ec_set(F64_ONE, F64_POS_INF, _r3b_ec_nan, F64_ONE, F64_ONE);
var _r3b_ec_t9, _r3b_ec_r9 = calc_integral_simpson(&_r3b_ec_f, 0, F64_ONE, 4, ec_out);
assert_eq(f64_eq(load64(ec_out), load64(ec_out)), 0, "simpson, f(1/4) = +Inf and f(1/2) = NaN -> NaN, not +Inf");

# A finite sum keeps its correction. 2 + 4 * 2^53 + 2 + 4 is 2^55 + 8 exactly; the
# plain sum rounds every small term away and stores 2^53 / 3 (0x4325555555555555).
_r3b_ec_set(F64_ONE, 0x4340000000000000, F64_ONE, F64_ONE, F64_ONE);
var _r3b_ec_t10, _r3b_ec_r10 = calc_integral_simpson(&_r3b_ec_f, 0, F64_ONE, 4, ec_out);
assert_eq(load64(ec_out), 0x4325555555555557, "simpson, f(1/4) = 2^53: the correction still applies, (2^53 + 2) / 3");

# ⛔ 3.3.4 — AN OVERFLOW OF FINITE SAMPLES IS REPAIRED (it stored 3.3.2's NaN through
# 3.3.3): 4 f(1/4) + 2 f(1/2) with f = 1.5 * 2^1021 passes DBL_MAX, where h / 3 times the
# exact sum, (6 + 9 * 2^1021) / 12, rounds to 1.5 * 2^1020 (0x7FB8000000000000; exact
# rational value). A later -Inf SAMPLE still makes the true sum -Inf whatever the finite
# samples sum to, and that is the answer.
_r3b_ec_set(F64_ONE, 0x7FC8000000000000, 0x7FC8000000000000, F64_ONE, F64_ONE);
var _r3b_ec_t11, _r3b_ec_r11 = calc_integral_simpson(&_r3b_ec_f, 0, F64_ONE, 4, ec_out);
assert_eq(load64(ec_out), 0x7FB8000000000000,
  "simpson, a weighted sum past DBL_MAX -> 1.5 * 2^1020, the rule's value (3.3.3: NaN)");
_r3b_ec_set(F64_ONE, 0x7FC8000000000000, 0x7FC8000000000000, _r3b_ec_ninf, F64_ONE);
var _r3b_ec_t12, _r3b_ec_r12 = calc_integral_simpson(&_r3b_ec_f, 0, F64_ONE, 4, ec_out);
assert_eq(load64(ec_out), _r3b_ec_ninf, "simpson, an overflowed sum then a -Inf sample -> -Inf, the true sum");

# === 3.3.3 R5calc: simpson, finite samples whose sum overflows ===
test_group("3.3.3 R5calc: simpson, finite samples whose sum overflows");
# ⛔ The plain running sum, which the repair above first returned for every sum that was
# not finite, gave an infinity OF THE WRONG SIGN as Ok when finite samples overflowed:
# f = [0, 0x7FCFFFFFFFFFFFFF, 0xFFE3333333333333, 0x7FCFFFFFFFFFFFFF, 0] at the five
# nodes integrates to about +1.2e307 (h/3 (2 DBL_MAX - 1.2 DBL_MAX)), but 2 f(1/2) =
# -1.2 DBL_MAX overflows alone and the sum ended at -Inf. Only infinite SAMPLES decide an
# infinite answer; the NaN of both signs, or of a NaN sample, is 3.3.2's. NaN is tested
# as NaN-ness.
# [measured: fixture probe on the 3.3.2 bundle, the tree before this block and this tree, cycc 6.6.12, 2026-10-01]
# ⛔ 3.3.4 — and finite samples whose sum overflows now store the rule's value instead of
# 3.3.3's NaN: the sum is halved as it overflows (see calc_integral_trapez), and this
# fixture's exact value, (8 * 0x7FCFFFFFFFFFFFFF + 2 * 0xFFE3333333333333) / 12, is the
# double 0x7FB1111111111110 itself (exact rational value), positive, as the sign above says.
_r3b_ec_set(0, 0x7FCFFFFFFFFFFFFF, 0xFFE3333333333333, 0x7FCFFFFFFFFFFFFF, 0);
store64(ec_out, F64_TWO);
var _r5c_ec_t1, _r5c_ec_r1 = calc_integral_simpson(&_r3b_ec_f, 0, F64_ONE, 4, ec_out);
assert_eq(is_ok(_r5c_ec_t1), 1, "simpson, an overflow of opposite sign to the integral: Ok");
assert_eq(load64(ec_out), 0x7FB1111111111110,
  "simpson, an overflow of opposite sign to the integral -> its exact value (3.3.3: NaN)");
# A negative overflow and then a +Inf sample: +Inf, the true sum (the running sum is NaN).
_r3b_ec_set(F64_ONE, 0xFFC8000000000000, 0xFFC8000000000000, F64_POS_INF, F64_ONE);
var _r5c_ec_t2, _r5c_ec_r2 = calc_integral_simpson(&_r3b_ec_f, 0, F64_ONE, 4, ec_out);
assert_eq(load64(ec_out), F64_POS_INF, "simpson, an overflow to -Inf then a +Inf sample -> +Inf");
# Both endpoints infinite, of opposite signs: NaN, classified before the loop.
_r3b_ec_set(_r3b_ec_ninf, F64_ONE, F64_ONE, F64_ONE, F64_POS_INF);
var _r5c_ec_t3, _r5c_ec_r3 = calc_integral_simpson(&_r3b_ec_f, 0, F64_ONE, 4, ec_out);
assert_eq(f64_eq(load64(ec_out), load64(ec_out)), 0, "simpson, f(0) = -Inf and f(1) = +Inf -> NaN");
# A NaN endpoint beside a +Inf sample: NaN.
_r3b_ec_set(F64_ONE, F64_POS_INF, F64_ONE, F64_ONE, _r3b_ec_nan);
var _r5c_ec_t4, _r5c_ec_r4 = calc_integral_simpson(&_r3b_ec_f, 0, F64_ONE, 4, ec_out);
assert_eq(f64_eq(load64(ec_out), load64(ec_out)), 0, "simpson, f(1/4) = +Inf and f(1) = NaN -> NaN, not +Inf");
# The orientation multiplies through: [1, 0] reverses h, and +Inf samples give -Inf.
_r3b_ec_set(F64_ONE, F64_ONE, F64_POS_INF, F64_ONE, F64_ONE);
var _r5c_ec_t5, _r5c_ec_r5 = calc_integral_simpson(&_r3b_ec_f, F64_ONE, 0, 4, ec_out);
assert_eq(load64(ec_out), _r3b_ec_ninf, "simpson over [1, 0], f(1/2) = +Inf -> -Inf");

# === 3.3.4: quadrature, overflow before scaling and simpson's closing step ===
test_group("3.3.4: quadrature overflow before scaling, simpson's compensated close");
# ⛔ calc_integral_trapez formed its weighted sum before h scaled it, so finite samples
# whose sum passes DBL_MAX stored +Inf where the rule's value is finite: f(1/4) = f(1/2) =
# 1.5 * 2^1023 on [0, 1] with 4 steps stored +Inf, where it is 0x7FD8000000000000.
# calc_integral_simpson stored NaN there (the block above). Both now halve the running sum
# as it overflows and scale back at the end. simpson's correction also missed the first
# add, f(a) + f(b), and was rounded away in fl(sum + comp) before the closing * h / 3:
# f(0) = 2^53, f(1) = 1, else 0, stored 0x4305555555555555, one ulp below the rule's
# (2^53 + 1) / 12. Expected values are the rule's exact value (an exact rational oracle on
# the samples and the f64 h), rounded once. The full-mantissa tables are the sweep cases
# each repair's mutants first get wrong.
# [measured: repros and a 22,000-table quadrature sweep, base tree and this tree, exact oracle; 2026-10-03]
# The integrand returns a table in CALL order: f(a), f(b), then the interior nodes.
var _q4_tab = alloc(8 * 8);
var _q4_k = 0;
fn _q4_f(x) {
    var v = load64(_q4_tab + _q4_k * 8);
    _q4_k = _q4_k + 1;
    return v;
}
# Nodes x0, x1, x2 of a 2-step rule, as the integrand will be asked for them.
fn _q4_t3(s0, s1, s2) {
    store64(_q4_tab, s0);
    store64(_q4_tab + 8, s2);
    store64(_q4_tab + 16, s1);
    _q4_k = 0;
    return 0;
}
fn _q4_t5(s0, s1, s2, s3, s4) {
    store64(_q4_tab, s0);
    store64(_q4_tab + 8, s4);
    store64(_q4_tab + 16, s1);
    store64(_q4_tab + 24, s2);
    store64(_q4_tab + 32, s3);
    _q4_k = 0;
    return 0;
}
fn _q4_trap(a, b, n) {
    _q4_k = 0;
    var t, v = calc_integral_trapez(&_q4_f, a, b, n, ec_out);
    return load64(ec_out);
}
fn _q4_simp(a, b, n) {
    _q4_k = 0;
    var t, v = calc_integral_simpson(&_q4_f, a, b, n, ec_out);
    return load64(ec_out);
}
var _q4_dmax = 0x7FEFFFFFFFFFFFFF;
var _q4_big = 0x7FE8000000000000;   # 1.5 * 2^1023

# trapez: the repro, the endpoint pair, every sample DBL_MAX (two halvings), a true overflow.
_q4_t5(0, _q4_big, _q4_big, 0, 0);
assert_eq(_q4_trap(0, F64_ONE, 4), 0x7FD8000000000000,
  "trapez: f(1/4) = f(1/2) = 1.5 * 2^1023 -> 1.5 * 2^1022 (3.3.3: +Inf)");
_q4_t5(_q4_big, 0, 0, 0, _q4_big);
assert_eq(_q4_trap(0, F64_ONE, 4), 0x7FC8000000000000, "trapez: two endpoints whose sum overflows -> 1.5 * 2^1021");
_q4_t5(_q4_dmax, _q4_dmax, _q4_dmax, _q4_dmax, _q4_dmax);
assert_eq(_q4_trap(0, F64_ONE, 4), _q4_dmax, "trapez: every sample DBL_MAX on [0, 1] -> DBL_MAX, exact");
_q4_t3(_q4_dmax, _q4_dmax, _q4_dmax);
assert_eq(_q4_trap(0, f64_from(4), 2), F64_POS_INF, "trapez: DBL_MAX over [0, 4] -> +Inf, a true overflow");
_q4_t3(0x7FD521D0658B923B, 0x7F623D94FC478537, 0x7FE9ED37EAE59B02);
assert_eq(_q4_trap(0, F64_ONE, 2), 0x7FD2514DA3D1F995, "trapez: full mantissa, endpoint pair past DBL_MAX, exact");
_q4_t3(0x7FABFD462310DAEC, 0x7FEFBB36795E7FB7, 0x7F9746A797372050);
assert_eq(_q4_trap(0, F64_ONE, 2), 0x7FE07C1DA469F188, "trapez: full mantissa, a sample past the sum's room, exact");
_q4_t5(0x7FECAD5D6AB4955F, 0x7FBEECEF224ADA65, 0x7FEDCAF1311197D0, 0x7FB2C68F87B4EE4E, 0x7F945A1060CA2279);
assert_eq(_q4_trap(0, F64_ONE, 4), 0x7FD954BBFE978210,
  "trapez: full mantissa, samples after a halving are halved, exact");

# simpson: the first add, both orders; the endpoint pair; every sample DBL_MAX (4f overflows
# alone); a true overflow; the close's own overflow (sum + comp past DBL_MAX).
_q4_t5(0x4340000000000000, 0, 0, 0, F64_ONE);
assert_eq(_q4_simp(0, F64_ONE, 4), 0x4305555555555556,
  "simpson: f(0) = 2^53, f(1) = 1 -> (2^53 + 1) / 12 (3.3.3: an ulp low)");
_q4_t5(F64_ONE, 0, 0, 0, 0x4340000000000000);
assert_eq(_q4_simp(0, F64_ONE, 4), 0x4305555555555556, "simpson: f(0) = 1, f(1) = 2^53 -> (2^53 + 1) / 12");
_q4_t5(_q4_big, 0, 0, 0, _q4_big);
assert_eq(_q4_simp(0, F64_ONE, 4), 0x7FC0000000000000,
  "simpson: two endpoints whose sum overflows -> 2^1021 (3.3.3: NaN)");
_q4_t5(_q4_dmax, _q4_dmax, _q4_dmax, _q4_dmax, _q4_dmax);
assert_eq(_q4_simp(0, F64_ONE, 4), _q4_dmax, "simpson: every sample DBL_MAX on [0, 1] -> DBL_MAX, exact (3.3.3: NaN)");
_q4_t3(_q4_dmax, _q4_dmax, _q4_dmax);
assert_eq(_q4_simp(0, f64_from(4), 2), F64_POS_INF, "simpson: DBL_MAX over [0, 4] -> +Inf, a true overflow");
_q4_t5(_q4_dmax, 0x7C60000000000000, 0x7C70000000000000, 0x7C60000000000000, 0x7C80000000000000);
assert_eq(_q4_simp(0, F64_ONE, 4), 0x7FB5555555555555,
  "simpson: sum + correction is 2^1024 exactly -> 2^1022 / 3 (3.3.3: +Inf)");
_q4_t3(0xA3027651DB356EBE, 0x231EF67DAA7791E9, 0xA31706E9B79B0CDC);
assert_eq(_q4_simp(0, F64_ONE, 2), 0x230E87F6AC382BCE, "simpson: full mantissa, the first add's error, exact");
_q4_t3(0x40292C84F140E12C, 0x3FBB8A8B88335689, 0x40742BFC9A487163);
assert_eq(_q4_simp(0, F64_ONE, 2), 0x404BFB0486460703, "simpson: full mantissa, |f(b)| > |f(a)|, exact");
_q4_t3(0x7FD521D0658B923B, 0x7F623D94FC478537, 0x7FE9ED37EAE59B02);
assert_eq(_q4_simp(0, F64_ONE, 2), 0x7FC884B9A1130178, "simpson: full mantissa, endpoint pair past DBL_MAX, exact");
_q4_t3(0x7FCF0B06E6D5C495, 0x7FD8389EC7EF133C, 0);
assert_eq(_q4_simp(0, F64_ONE, 2), 0x7FD2BBFFC331328A, "simpson: full mantissa, 4f past DBL_MAX, exact");
_q4_t3(0x7FD3BB04199DCBD6, 0x7FCB2AB93C380CC1, 0x7FBAAFFB15A43B41);
assert_eq(_q4_simp(0, F64_ONE, 2), 0x7FCAE97C727CFC0D,
  "simpson: full mantissa, the correction halves with the sum, exact");
_q4_t5(0x7FB3B261337822C5, 0x7FCEF2EF24746921, 0x7FA0795D58A67872, 0x7FBB7DAAC16D624B, 0);
assert_eq(_q4_simp(0, F64_ONE, 4), 0x7FC067BEC78FA48F,
  "simpson: full mantissa, samples after a halving are halved, exact");
# The close: hi + lo through * h (Dekker) and / 3 (exact remainder), rounded once.
_q4_t3(0xC3AE38F76F9DE89D, 0x43A67CA439B6CF26, 0x4398AE362AD1FEA7);
assert_eq(_q4_simp(0, F64_ONE, 2), 0x439805918437711A, "simpson: full mantissa, the pair's low part, exact");
_q4_t3(0xE74DFF9FD37422A4, 0x19FA15F3097C496F, 0x9732A79E74098451);
assert_eq(_q4_simp(0xC1083D7AC5F936C9, 0xC1074A8D813D1294, 2), 0xE7F2FA4C87334F4E,
  "simpson: full mantissa, an inexact h, the product's error, exact");
_q4_t3(0xC33AA800690BEED5, 0xC321DAD105A61D6A, 0x43350EEC959969C0);
assert_eq(_q4_simp(0xBEF70EC10316A229, 0x4078C6C52EEFBF98, 2), 0xC3A5526962321EF0,
  "simpson: full mantissa, the product error's low-by-low term, exact");
_q4_t3(0x3FB868819E52246D, 0xC02A5069C5AAAD5F, 0x3FE9154105A28CC5);
assert_eq(_q4_simp(0, F64_ONE, 2), 0xC0213FEB00835166, "simpson: full mantissa, the division's remainder, exact");
# Subnormal results round the exact pair once, on the 2^-1074 grid. h = 2^-1074: 7.5 / 3
# and 10.5 / 3 sit exactly on midpoints (to even: 2 and 4 units); a sample of +-2^-60
# moves the exact value off the midpoint (3 units both), which fl(sum + comp) cannot see.
_q4_t3(0x401E000000000000, 0, 0);
assert_eq(_q4_simp(0, 2, 2), 2, "simpson: exactly 2.5 * 2^-1074 -> 2 units, to even (3.3.3: 3)");
_q4_t3(0x4025000000000000, 0, 0);
assert_eq(_q4_simp(0, 2, 2), 4, "simpson: exactly 3.5 * 2^-1074 -> 4 units, to even");
_q4_t3(0x401E000000000000, 0, 0x3C30000000000000);
assert_eq(_q4_simp(0, 2, 2), 3, "simpson: just above 2.5 * 2^-1074 -> 3 units");
_q4_t3(0x4025000000000000, 0, 0xBC30000000000000);
assert_eq(_q4_simp(0, 2, 2), 3, "simpson: just below 3.5 * 2^-1074 -> 3 units");
# A result in [0.5, 1) units, the largest shift not flushed to 0 (sh = 53): 2.75 / 3 -> 1 unit.
_q4_t3(0xBFF4000000000000, F64_ONE, 0);
assert_eq(_q4_simp(0, 2, 2), 1, "simpson: 2.75 / 3 * 2^-1074 -> 1 unit, not 0");
_q4_t5(0x8000000000000170, 0x8000000000000044, 0x800000000636EDCA, 0x8000000034B24FCC, 0x800006E630A443A6);
assert_eq(_q4_simp(0, F64_ONE, 4), 0x8000009341524814, "simpson: subnormal, full mantissa, an exact tie, exact");
_q4_t3(0x003FBAE7CE33C55C, 0x8000000000032596, 0x804AD02E59EBE7B5);
assert_eq(_q4_simp(0, F64_ONE, 2), 0x800E98F8991A1FC3,
  "simpson: subnormal, full mantissa, the low part past a tie, exact");
_q4_t3(0x800000AD6472D908, 0x00000000532C428D, 0x00000000000C1139);
assert_eq(_q4_simp(0, F64_ONE, 2), 0x8000001CAE9E4A44, "simpson: subnormal, full mantissa, below the midpoint, exact");
# h that underflows to 0 at a non-zero width: the rule's value is 0 (3.3.3: NaN from +Inf * 0).
_q4_t5(0x7FE0000000000000, 0x7FE0000000000000, 0x7FE0000000000000, 0x7FE0000000000000, 0x7FE0000000000000);
assert_eq(_q4_simp(0, 2, 4), 0, "simpson: 2^1023 samples, h = 0 -> +0 (3.3.3: NaN)");
_q4_t5(0x7FE0000000000000, 0x7FE0000000000000, 0x7FE0000000000000, 0x7FE0000000000000, 0x7FE0000000000000);
assert_eq(_q4_trap(0, 2, 4), 0, "trapez: 2^1023 samples, h = 0 -> +0 (3.3.3: NaN)");
# Below an overflow the pair's exponent alone would put the closing step on the subnormal
# grid with a zero mantissa read as 1.0: h = 0 is the degenerate branch, not the pair's.
_q4_t5(0x7F90000000000000, 0x7F90000000000000, 0x7F90000000000000, 0x7F90000000000000, 0x7F90000000000000);
assert_eq(_q4_simp(0, 2, 4), 0, "simpson: 2^1018 samples, h = 0 -> +0, not a subnormal");

# An infinite sample is never halved: after it the sum stays infinite, and 1,100 more steps
# (past 1,023 halvings) still store +Inf, not the NaN a growing scale would make.
# [measured: the two assertions below; a rescale-on-any-overflow mutant fails them]
var _q4_inf_calls = 0;
fn _q4_inf_once(x) {
    _q4_inf_calls = _q4_inf_calls + 1;
    if (_q4_inf_calls == 3) { return F64_POS_INF; }
    return F64_ONE;
}
_q4_inf_calls = 0;
var _q4_it, _q4_iv = calc_integral_trapez(&_q4_inf_once, 0, f64_from(1100), 1100, ec_out);
assert_eq(load64(ec_out), F64_POS_INF, "trapez: one +Inf sample then 1,098 finite ones -> +Inf");
_q4_inf_calls = 0;
var _q4_st, _q4_sv = calc_integral_simpson(&_q4_inf_once, 0, f64_from(1100), 1100, ec_out);
assert_eq(load64(ec_out), F64_POS_INF, "simpson: one +Inf sample then 1,098 finite ones -> +Inf");

# ================================================================
# Calc — Derivative of constant = 0
# ================================================================
test_group("edge: calc derivative constant");

var ec_dc = calc_derivative(&_ec_const5, F64_ONE, F64_ONE);
assert_eq(ec_dc, f64_from(0), "deriv const = 0");

# Derivative of identity at x=0 with h=1: (1 - (-1))/2 = 1
var ec_did = calc_derivative(&_ec_identity, 0, F64_ONE);
assert_eq(ec_did, f64_from(1), "deriv identity = 1");

# ================================================================
# Calc — Bezier endpoints
# ================================================================
test_group("edge: calc bezier endpoints");

# Cubic bezier at t=0 and t=1
var ec_bz0 = hvec2_new(f64_from(0), f64_from(0));
var ec_bz1 = hvec2_new(f64_from(1), f64_from(5));
var ec_bz2 = hvec2_new(f64_from(4), f64_from(5));
var ec_bz3 = hvec2_new(f64_from(5), f64_from(0));

var ec_c0 = calc_bezier_cubic_2d(ec_bz0, ec_bz1, ec_bz2, ec_bz3, 0);
assert_eq(HVec2_x(ec_c0), f64_from(0), "cubic bezier t=0 x");
assert_eq(HVec2_y(ec_c0), f64_from(0), "cubic bezier t=0 y");

var ec_c1 = calc_bezier_cubic_2d(ec_bz0, ec_bz1, ec_bz2, ec_bz3, F64_ONE);
assert_eq(HVec2_x(ec_c1), f64_from(5), "cubic bezier t=1 x");
assert_eq(HVec2_y(ec_c1), f64_from(0), "cubic bezier t=1 y");

# 3D cubic bezier endpoints
var ec_b3_0 = hvec3_new(0, 0, 0);
var ec_b3_1 = hvec3_new(F64_ONE, f64_from(3), 0);
var ec_b3_2 = hvec3_new(F64_TWO, f64_from(3), 0);
var ec_b3_3 = hvec3_new(f64_from(3), 0, 0);

var ec_bc0 = calc_bezier_cubic_3d(ec_b3_0, ec_b3_1, ec_b3_2, ec_b3_3, 0);
assert_eq(HVec3_x(ec_bc0), f64_from(0), "3d bezier t=0 x");
var ec_bc1 = calc_bezier_cubic_3d(ec_b3_0, ec_b3_1, ec_b3_2, ec_b3_3, F64_ONE);
assert_eq(HVec3_x(ec_bc1), f64_from(3), "3d bezier t=1 x");
assert_eq(HVec3_y(ec_bc1), f64_from(0), "3d bezier t=1 y");

