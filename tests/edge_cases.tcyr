# ================================================================
# Calc — Simpson with 0 steps → error
# ================================================================
test_group("edge: calc simpson 0 steps");

var ec_out = alloc(8);
var ec_t0, ec_v0 = calc_integral_simpson(&_ec_x2, 0, F64_ONE, 0, ec_out);
assert_eq(is_err_result(ec_t0), 1, "simpson 0 steps → Err");
assert_eq(ec_v0, HSB_ERR_ZERO_STEPS, "simpson 0 steps → the code is in the PAYLOAD");

# Simpson with 1 step (odd → rounds to 2)
var ec_t1, ec_v1 = calc_integral_simpson(&_ec_const5, 0, F64_ONE, 1, ec_out);
assert_eq(is_ok(ec_t1), 1, "simpson 1 step ok");
assert_eq(load64(ec_out), f64_from(5), "simpson 1 step const=5");

# === 3.3.3 G4: zero-width quadrature ===
# ⛔ The three fixed rules formed (b - a) * (sum of samples), so b == a with an
# infinite f(a) was 0 * Inf = NaN — stored as Ok by trapez and simpson — and a
# negative integrand gave -0. The integral over a point is exactly 0: each now
# returns +0 without calling f. The test is the WIDTH, so equal infinite endpoints
# (width NaN) are not caught by it and still give NaN.
# ⚠ The +0 is asserted by BITS on purpose: -0 was the 3.3.2 answer for f = -1.
# [measured: zero-width probe on the 3.3.2 bundle, 2026-10-01]
var _g4_ec_calls = 0;
fn _g4_ec_inf(x) { _g4_ec_calls = _g4_ec_calls + 1; return F64_POS_INF; }
fn _g4_ec_neg(x) { _g4_ec_calls = _g4_ec_calls + 1; return f64_neg(F64_ONE); }

store64(ec_out, F64_TWO);
var _g4_ec_t1, _g4_ec_v1 = calc_integral_trapez(&_g4_ec_inf, F64_ONE, F64_ONE, 4, ec_out);
assert_eq(is_ok(_g4_ec_t1), 1, "trapez zero width -> Ok");
assert_eq(load64(ec_out), 0, "trapez zero width, f = +Inf -> +0 (was NaN)");
store64(ec_out, F64_TWO);
var _g4_ec_t2, _g4_ec_v2 = calc_integral_simpson(&_g4_ec_inf, F64_ONE, F64_ONE, 4, ec_out);
assert_eq(is_ok(_g4_ec_t2), 1, "simpson zero width -> Ok");
assert_eq(load64(ec_out), 0, "simpson zero width, f = +Inf -> +0 (was NaN)");
assert_eq(calc_integral_gauss5(&_g4_ec_inf, F64_ONE, F64_ONE), 0,
  "gauss5 zero width, f = +Inf -> +0 (was NaN)");
assert_eq(_g4_ec_calls, 0, "zero-width quadrature never calls f");

store64(ec_out, F64_TWO);
var _g4_ec_t3, _g4_ec_v3 = calc_integral_trapez(&_g4_ec_neg, F64_ONE, F64_ONE, 4, ec_out);
assert_eq(load64(ec_out), 0, "trapez zero width, f = -1 -> +0 (was -0)");
store64(ec_out, F64_TWO);
var _g4_ec_t4, _g4_ec_v4 = calc_integral_simpson(&_g4_ec_neg, F64_ONE, F64_ONE, 4, ec_out);
assert_eq(load64(ec_out), 0, "simpson zero width, f = -1 -> +0 (was -0)");
assert_eq(calc_integral_gauss5(&_g4_ec_neg, F64_ONE, F64_ONE), 0, "gauss5 zero width, f = -1 -> +0 (was -0)");
# -0 and +0 are the same point: b - a is -0 here, and it is still a zero width.
store64(ec_out, F64_TWO);
var _g4_ec_t5, _g4_ec_v5 = calc_integral_trapez(&_g4_ec_neg, 0, 0x8000000000000000, 4, ec_out);
assert_eq(load64(ec_out), 0, "trapez over [+0, -0] -> +0");
store64(ec_out, F64_TWO);
var _g4_ec_t8, _g4_ec_v8 = calc_integral_simpson(&_g4_ec_neg, 0, 0x8000000000000000, 4, ec_out);
assert_eq(load64(ec_out), 0, "simpson over [+0, -0] -> +0");
assert_eq(calc_integral_gauss5(&_g4_ec_neg, 0, 0x8000000000000000), 0, "gauss5 over [+0, -0] -> +0");
assert_eq(_g4_ec_calls, 0, "zero-width quadrature never calls f (negative integrand)");

# The step count is checked BEFORE the width: an invalid count is refused over a
# point too, and `out` is left alone.
store64(ec_out, F64_TWO);
var _g4_ec_t9, _g4_ec_v9 = calc_integral_trapez(&_g4_ec_neg, F64_ONE, F64_ONE, 0, ec_out);
assert_eq(_g4_ec_v9, HSB_ERR_ZERO_STEPS, "trapez zero width, steps = 0 -> HSB_ERR_ZERO_STEPS");
var _g4_ec_t10, _g4_ec_v10 = calc_integral_trapez(&_g4_ec_neg, F64_ONE, F64_ONE, 0 - 1, ec_out);
assert_eq(_g4_ec_v10, HSB_ERR_INVALID_INPUT, "trapez zero width, steps = -1 -> HSB_ERR_INVALID_INPUT");
var _g4_ec_t11, _g4_ec_v11 = calc_integral_simpson(&_g4_ec_neg, F64_ONE, F64_ONE, 0, ec_out);
assert_eq(_g4_ec_v11, HSB_ERR_ZERO_STEPS, "simpson zero width, steps = 0 -> HSB_ERR_ZERO_STEPS");
var _g4_ec_t12, _g4_ec_v12 = calc_integral_simpson(&_g4_ec_neg, F64_ONE, F64_ONE, 0 - 1, ec_out);
assert_eq(_g4_ec_v12, HSB_ERR_INVALID_INPUT, "simpson zero width, steps = -1 -> HSB_ERR_INVALID_INPUT");
assert_eq(load64(ec_out), F64_TWO, "zero width with a refused step count: out untouched");

# The width test, not an equality test: [+Inf, +Inf] has width NaN and is left to
# the arithmetic, which gives NaN — an `a == b` test would have returned 0 here.
assert_eq(f64_eq(calc_integral_gauss5(&_g4_ec_neg, F64_POS_INF, F64_POS_INF),
    calc_integral_gauss5(&_g4_ec_neg, F64_POS_INF, F64_POS_INF)), 0,
  "gauss5 over [+Inf, +Inf] -> NaN, not 0");
store64(ec_out, F64_TWO);
var _g4_ec_t6, _g4_ec_v6 = calc_integral_trapez(&_g4_ec_neg, F64_POS_INF, F64_POS_INF, 4, ec_out);
assert_eq(f64_eq(load64(ec_out), load64(ec_out)), 0, "trapez over [+Inf, +Inf] -> NaN, not 0");
store64(ec_out, F64_TWO);
var _g4_ec_t7, _g4_ec_v7 = calc_integral_simpson(&_g4_ec_neg, F64_POS_INF, F64_POS_INF, 4, ec_out);
assert_eq(f64_eq(load64(ec_out), load64(ec_out)), 0, "simpson over [+Inf, +Inf] -> NaN, not 0");

# === 3.3.3 R3b: simpson with a non-finite sample ===
test_group("3.3.3 R3b: simpson with a non-finite sample");
# ⛔ calc_integral_simpson's Neumaier correction formed Inf - Inf once a term was
# infinite, so a single infinite sample stored NaN as Ok where calc_integral_trapez
# stores ±Inf. An infinite or NaN sample now stores the class of the true sum: ±Inf
# for infinite samples of one sign, NaN for both signs or a NaN sample.
# Each fixture sets f at the five nodes of [0, 1] with 4 steps (x = 0, 1/4, 1/2,
# 3/4, 1). "3.3.2:" is what the 3.3.2 bundle stored; NaN is tested as NaN-ness, the
# payload not being part of the claim.
# [measured: fixture probe on the 3.3.2 bundle, cycc 6.6.12, 2026-10-01]
var _r3b_ec_v = alloc(40);
fn _r3b_ec_f(x) {
    if (x == 0) { return load64(_r3b_ec_v); }
    if (x == 0x3FD0000000000000) { return load64(_r3b_ec_v + 8); }
    if (x == 0x3FE0000000000000) { return load64(_r3b_ec_v + 16); }
    if (x == 0x3FE8000000000000) { return load64(_r3b_ec_v + 24); }
    if (x == F64_ONE) { return load64(_r3b_ec_v + 32); }
    return 0x7FF8000000000BAD;
}
fn _r3b_ec_set(f0, f1, f2, f3, f4) {
    store64(_r3b_ec_v, f0);
    store64(_r3b_ec_v + 8, f1);
    store64(_r3b_ec_v + 16, f2);
    store64(_r3b_ec_v + 24, f3);
    store64(_r3b_ec_v + 32, f4);
    return 0;
}
var _r3b_ec_ninf = 0xFFF0000000000000;
var _r3b_ec_nan = 0x7FF8000000000000;

_r3b_ec_set(F64_ONE, F64_ONE, F64_POS_INF, F64_ONE, F64_ONE);
store64(ec_out, F64_TWO);
var _r3b_ec_t1, _r3b_ec_r1 = calc_integral_simpson(&_r3b_ec_f, 0, F64_ONE, 4, ec_out);
assert_eq(is_ok(_r3b_ec_t1), 1, "simpson, f(1/2) = +Inf: Ok");
assert_eq(load64(ec_out), F64_POS_INF, "simpson, f(1/2) = +Inf -> +Inf (3.3.2: NaN)");
var _r3b_ec_t2, _r3b_ec_r2 = calc_integral_trapez(&_r3b_ec_f, 0, F64_ONE, 4, ec_out);
assert_eq(load64(ec_out), F64_POS_INF, "trapez, f(1/2) = +Inf -> +Inf, the answer simpson now gives (control)");

_r3b_ec_set(F64_ONE, F64_ONE, _r3b_ec_ninf, F64_ONE, F64_ONE);
var _r3b_ec_t3, _r3b_ec_r3 = calc_integral_simpson(&_r3b_ec_f, 0, F64_ONE, 4, ec_out);
assert_eq(load64(ec_out), _r3b_ec_ninf, "simpson, f(1/2) = -Inf -> -Inf (3.3.2: NaN)");
_r3b_ec_set(F64_ONE, F64_POS_INF, F64_ONE, F64_ONE, F64_ONE);
var _r3b_ec_t4, _r3b_ec_r4 = calc_integral_simpson(&_r3b_ec_f, 0, F64_ONE, 4, ec_out);
assert_eq(load64(ec_out), F64_POS_INF, "simpson, f(1/4) = +Inf (weight 4) -> +Inf (3.3.2: NaN)");
# An endpoint enters the sum before the loop: the sum is infinite from the start.
_r3b_ec_set(F64_POS_INF, F64_ONE, F64_ONE, F64_ONE, F64_ONE);
var _r3b_ec_t5, _r3b_ec_r5 = calc_integral_simpson(&_r3b_ec_f, 0, F64_ONE, 4, ec_out);
assert_eq(load64(ec_out), F64_POS_INF, "simpson, f(0) = +Inf -> +Inf (3.3.2: NaN)");
_r3b_ec_set(F64_ONE, F64_ONE, F64_ONE, F64_ONE, _r3b_ec_ninf);
var _r3b_ec_t6, _r3b_ec_r6 = calc_integral_simpson(&_r3b_ec_f, 0, F64_ONE, 4, ec_out);
assert_eq(load64(ec_out), _r3b_ec_ninf, "simpson, f(1) = -Inf -> -Inf (3.3.2: NaN)");

# NaN only where the sum of the terms is NaN: infinities of both signs, or a NaN.
_r3b_ec_set(F64_ONE, F64_POS_INF, F64_ONE, _r3b_ec_ninf, F64_ONE);
var _r3b_ec_t7, _r3b_ec_r7 = calc_integral_simpson(&_r3b_ec_f, 0, F64_ONE, 4, ec_out);
assert_eq(f64_eq(load64(ec_out), load64(ec_out)), 0, "simpson, f(1/4) = +Inf and f(3/4) = -Inf -> NaN");
_r3b_ec_set(F64_ONE, F64_ONE, _r3b_ec_nan, F64_ONE, F64_ONE);
var _r3b_ec_t8, _r3b_ec_r8 = calc_integral_simpson(&_r3b_ec_f, 0, F64_ONE, 4, ec_out);
assert_eq(f64_eq(load64(ec_out), load64(ec_out)), 0, "simpson, f(1/2) = NaN -> NaN");
_r3b_ec_set(F64_ONE, F64_POS_INF, _r3b_ec_nan, F64_ONE, F64_ONE);
var _r3b_ec_t9, _r3b_ec_r9 = calc_integral_simpson(&_r3b_ec_f, 0, F64_ONE, 4, ec_out);
assert_eq(f64_eq(load64(ec_out), load64(ec_out)), 0, "simpson, f(1/4) = +Inf and f(1/2) = NaN -> NaN, not +Inf");

# A finite sum keeps its correction. 2 + 4 * 2^53 + 2 + 4 is 2^55 + 8 exactly; the
# plain sum rounds every small term away and stores 2^53 / 3 (0x4325555555555555).
_r3b_ec_set(F64_ONE, 0x4340000000000000, F64_ONE, F64_ONE, F64_ONE);
var _r3b_ec_t10, _r3b_ec_r10 = calc_integral_simpson(&_r3b_ec_f, 0, F64_ONE, 4, ec_out);
assert_eq(load64(ec_out), 0x4325555555555557, "simpson, f(1/4) = 2^53: the correction still applies, (2^53 + 2) / 3");

# ⚠ An overflow of FINITE samples is not repaired: 4 f(1/4) + 2 f(1/2) with f = 1.5 *
# 2^1021 passes DBL_MAX, where h / 3 times the exact sum is about 1.5 * 2^1020, and the
# result is 3.3.2's NaN (the R5calc block below). A later -Inf SAMPLE makes the true
# sum -Inf whatever the finite samples sum to, and that is the answer.
_r3b_ec_set(F64_ONE, 0x7FC8000000000000, 0x7FC8000000000000, F64_ONE, F64_ONE);
var _r3b_ec_t11, _r3b_ec_r11 = calc_integral_simpson(&_r3b_ec_f, 0, F64_ONE, 4, ec_out);
assert_eq(f64_eq(load64(ec_out), load64(ec_out)), 0, "simpson, a weighted sum past DBL_MAX -> NaN, as on 3.3.2");
_r3b_ec_set(F64_ONE, 0x7FC8000000000000, 0x7FC8000000000000, _r3b_ec_ninf, F64_ONE);
var _r3b_ec_t12, _r3b_ec_r12 = calc_integral_simpson(&_r3b_ec_f, 0, F64_ONE, 4, ec_out);
assert_eq(load64(ec_out), _r3b_ec_ninf, "simpson, an overflowed sum then a -Inf sample -> -Inf, the true sum");

# === 3.3.3 R5calc: simpson, finite samples whose sum overflows ===
test_group("3.3.3 R5calc: simpson, finite samples whose sum overflows");
# ⛔ The plain running sum, which the repair above first returned for every sum that was
# not finite, gave an infinity OF THE WRONG SIGN as Ok when finite samples overflowed:
# f = [0, 0x7FCFFFFFFFFFFFFF, 0xFFE3333333333333, 0x7FCFFFFFFFFFFFFF, 0] at the five
# nodes integrates to about +1.2e307 (h/3 (2 DBL_MAX - 1.2 DBL_MAX)), but 2 f(1/2) =
# -1.2 DBL_MAX overflows alone and the sum ended at -Inf. Only infinite SAMPLES decide an
# infinite answer now, and finite samples whose sum overflows store 3.3.2's NaN (Ok); the
# NaN of both signs, or of a NaN sample, is 3.3.2's too. NaN is tested as NaN-ness.
# [measured: fixture probe on the 3.3.2 bundle, the tree before this block and this tree, cycc 6.6.12, 2026-10-01]
_r3b_ec_set(0, 0x7FCFFFFFFFFFFFFF, 0xFFE3333333333333, 0x7FCFFFFFFFFFFFFF, 0);
store64(ec_out, F64_TWO);
var _r5c_ec_t1, _r5c_ec_r1 = calc_integral_simpson(&_r3b_ec_f, 0, F64_ONE, 4, ec_out);
assert_eq(is_ok(_r5c_ec_t1), 1, "simpson, an overflow of opposite sign to the integral: Ok");
assert_eq(f64_eq(load64(ec_out), load64(ec_out)), 0,
  "simpson, an overflow of opposite sign to the integral -> NaN, not -Inf");
# A negative overflow and then a +Inf sample: +Inf, the true sum (the running sum is NaN).
_r3b_ec_set(F64_ONE, 0xFFC8000000000000, 0xFFC8000000000000, F64_POS_INF, F64_ONE);
var _r5c_ec_t2, _r5c_ec_r2 = calc_integral_simpson(&_r3b_ec_f, 0, F64_ONE, 4, ec_out);
assert_eq(load64(ec_out), F64_POS_INF, "simpson, an overflow to -Inf then a +Inf sample -> +Inf");
# Both endpoints infinite, of opposite signs: NaN, classified before the loop.
_r3b_ec_set(_r3b_ec_ninf, F64_ONE, F64_ONE, F64_ONE, F64_POS_INF);
var _r5c_ec_t3, _r5c_ec_r3 = calc_integral_simpson(&_r3b_ec_f, 0, F64_ONE, 4, ec_out);
assert_eq(f64_eq(load64(ec_out), load64(ec_out)), 0, "simpson, f(0) = -Inf and f(1) = +Inf -> NaN");
# A NaN endpoint beside a +Inf sample: NaN.
_r3b_ec_set(F64_ONE, F64_POS_INF, F64_ONE, F64_ONE, _r3b_ec_nan);
var _r5c_ec_t4, _r5c_ec_r4 = calc_integral_simpson(&_r3b_ec_f, 0, F64_ONE, 4, ec_out);
assert_eq(f64_eq(load64(ec_out), load64(ec_out)), 0, "simpson, f(1/4) = +Inf and f(1) = NaN -> NaN, not +Inf");
# The orientation multiplies through: [1, 0] reverses h, and +Inf samples give -Inf.
_r3b_ec_set(F64_ONE, F64_ONE, F64_POS_INF, F64_ONE, F64_ONE);
var _r5c_ec_t5, _r5c_ec_r5 = calc_integral_simpson(&_r3b_ec_f, F64_ONE, 0, 4, ec_out);
assert_eq(load64(ec_out), _r3b_ec_ninf, "simpson over [1, 0], f(1/2) = +Inf -> -Inf");

