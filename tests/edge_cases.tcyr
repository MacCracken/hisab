_N3O_N = 0;
var _n3o_p1t, _n3o_p1v = ode_backward_euler_checked(&_n3o_vdp, f64_sub(0x3FF59CC2D52E3700, 0x3F773255DA4A870A),
  0x3FBFB632B2761280, 0x3F773255DA4A870A, 0x3DDB7CDFD9D7BDBB, 1, &_n3o_o);
assert_eq(_n3o_o, 0x3FC1CE9C3DE75160, "backward Euler: max_newton 1 -> the continuation's 0x3FC1CE9C3DE75160");
assert_eq(_N3O_N, 75, "backward Euler: max_newton 1 -> 75 evaluations (3.4.0: NO_CONVERGENCE after 4)");
# The fold test: y' = y at dt = 1, whose g' = 1 - sigma reaches 0 at sigma = 1. With 1,000
# increments the continuation stops where g' at an accepted point is no longer resolved from 0
# (sigma > 1 - 2^-23): SINGULAR_MATRIX, Newton's code, after 161 evaluations (the same from
# max_newton 64 up; with 50 the increments run out first: the group "3.4.0 (review): the implicit
# steps' Newton slope").
# [measured: this group's own assertions, roots from a 60-digit continuation oracle, NUM3 tree, 2026-10-31]
fn _n3o_lin(t, y) {
    _N3O_N = _N3O_N + 1;
    return y;
}
_N3O_N = 0;
var _n3o_lt, _n3o_lv = ode_backward_euler_checked(&_n3o_lin, 0, F64_ONE, F64_ONE, 0x3D719799812DEA11, 1000, &_n3o_o);
assert_eq(_n3o_lv, HSB_ERR_SINGULAR_MATRIX, "backward Euler: y' = y at dt = 1, max_newton 1000 -> SINGULAR_MATRIX");
assert_eq(_N3O_N, 161, "backward Euler: y' = y at dt = 1 -> the fold test stops it after 161 evaluations");
# The increment's underflow: f finite at y = 0 only. No increment above 2^-1074 keeps f finite, the
# one at 2^-1074 fails too, and its half rounds to 0: NO_CONVERGENCE after 19 evaluations (Newton
# 2, f(s) 1, the first increment's 12 tests, the slope's 3, the predictor 1), not after the
# budget's 5 increments.
# [measured: this group's own assertions, roots from a 60-digit continuation oracle, NUM3 tree, 2026-10-31]
fn _n3o_pt0(t, y) {
    _N3O_N = _N3O_N + 1;
    if (y == 0) { return F64_ONE; }
    return 0x7FF8000000000000;
}
_N3O_N = 0;
var _n3o_ut, _n3o_uv = ode_backward_euler_checked(&_n3o_pt0, 0, 0, F64_ONE, 0x3D719799812DEA11, 5, &_n3o_o);
assert_eq(_n3o_uv, HSB_ERR_NO_CONVERGENCE, "backward Euler: f finite at 0 only -> NO_CONVERGENCE");
assert_eq(_N3O_N, 19, "backward Euler: f finite at 0 only -> the increment underflows after 19 evaluations");

# === 3.4.1 NUM3: fBm whose amp-scaled sum alone leaves the range ===
test_group("3.4.1 NUM3: fBm whose amp-scaled sum alone leaves the range");
# simplex_fbm_2d_checked / _3d_checked form the mean again without amp where the amp-scaled sum
# is not finite even when the weight sum is: amp = DBL_MAX, persistence -1, three octaves, weights
# (DBL_MAX, -DBL_MAX, DBL_MAX) summing to DBL_MAX, at a point where |n_0 - n_1 + n_2| > 1, so that
# DBL_MAX (n_0 - n_1 + n_2) overflows. The mean is n_0 - n_1 + n_2 itself (weights 1, -1, 1 sum
# to 1), read here from simplex_2d / simplex_3d directly. Without the sum's own test the call
# returned the overflowed sum over DBL_MAX: -Inf and +Inf. (3.4.1 reads that test off the
# exponent fields; the answers are the 3.4.0 ones.)
# [measured: scratch fBm differential (NUM3-work/cost dfbm.cyr, srch.cyr), 2026-11-01]
var _n3k_o = alloc(8);
var _n3k_x = 0x3FD8AF8AF8AF8AF8;
var _n3k_y = 0x3FCF6B0DF6B0DF6A;
var _n3k_q = 0x4010000000000000;                                        # 4
var _n3k_m2 = f64_sub(simplex_2d(_n3k_x, _n3k_y), simplex_2d(f64_mul(_n3k_x, F64_TWO), f64_mul(_n3k_y, F64_TWO)));
_n3k_m2 = f64_add(_n3k_m2, simplex_2d(f64_mul(_n3k_x, _n3k_q), f64_mul(_n3k_y, _n3k_q)));
assert_eq(_n3k_m2, 0xBFF0FEE32ED0E071, "simplex_2d: n_0 - n_1 + n_2 at the fixture is -1.0622 (|.| > 1)");
store64(_n3k_o, 0x7FF4000000000001);
var _n3k_t2, _n3k_v2 = simplex_fbm_2d_checked(_n3k_x, _n3k_y, 3, F64_ONE, 0x7FEFFFFFFFFFFFFF, 0xBFF0000000000000,
  _n3k_o);
assert_eq(is_ok(_n3k_t2), 1, "simplex_fbm_2d_checked: amp DBL_MAX, persistence -1, 3 octaves -> Ok");
assert_eq(load64(_n3k_o), _n3k_m2,
  "simplex_fbm_2d_checked: ... the mean n_0 - n_1 + n_2 (the sum alone overflowed: -Inf)");
var _n3k_z = 0x3FFBD0BD0BD0BD0C;
_n3k_x = 0x3FE57C57C57C57C5;
_n3k_y = 0x3FE94F2094F2094E;
var _n3k_m3 = f64_sub(simplex_3d(_n3k_x, _n3k_y, _n3k_z),
  simplex_3d(f64_mul(_n3k_x, F64_TWO), f64_mul(_n3k_y, F64_TWO), f64_mul(_n3k_z, F64_TWO)));
_n3k_m3 = f64_add(_n3k_m3, simplex_3d(f64_mul(_n3k_x, _n3k_q), f64_mul(_n3k_y, _n3k_q), f64_mul(_n3k_z, _n3k_q)));
assert_eq(_n3k_m3, 0x3FF619F056A05931, "simplex_3d: n_0 - n_1 + n_2 at the fixture is 1.3813 (|.| > 1)");
store64(_n3k_o, 0x7FF4000000000001);
var _n3k_t3, _n3k_v3 = simplex_fbm_3d_checked(_n3k_x, _n3k_y, _n3k_z, 3, F64_ONE, 0x7FEFFFFFFFFFFFFF,
  0xBFF0000000000000, _n3k_o);
assert_eq(is_ok(_n3k_t3), 1, "simplex_fbm_3d_checked: amp DBL_MAX, persistence -1, 3 octaves -> Ok");
assert_eq(load64(_n3k_o), _n3k_m3,
  "simplex_fbm_3d_checked: ... the mean n_0 - n_1 + n_2 (the sum alone overflowed: +Inf)");

# === 3.4.1 NUM4: a first trial too long recovers ===
test_group("3.4.1 NUM4: a first trial too long recovers");
# The third review's M1: the second review's first trial, max(|x|, 4 |f| / |g|), and a search that
# ended at 40 trials returned NO_CONVERGENCE at x0, at iteration 0, on convex problems 3.4.0 and 3.3.7
# solve. Each row is G(z) + OFF, z = x - T. Now the shorter length is tried, and a trial still too long
# (the last three rows: both lengths are long) backs off until it is taken.
# [measured: scratch harness (NUM4-work k/opt4.cyr, py/rep.py), s22, 3.4.0, 3.3.7 and this tree, 2026-11-01]
var _N4Q_P = 0;
var _N4Q_T = 0;
var _N4Q_O = 0;
var _N4Q_NF = 0;
var _N4Q_NG = 0;
var _n4q_x0 = alloc(80);
var _n4q_ox = alloc(80);
var _n4q_of = alloc(8);
fn _n4q_gv(z) {
    if (_N4Q_P == 0) { return f64_cosh(z); }
    if (_N4Q_P == 1) { return f64_sub(f64_exp(z), z); }
    if (_N4Q_P == 2) { return f64_sub(z, f64_ln(z)); }
    if (_N4Q_P == 3) { return f64_sub(F64_ONE, f64_exp(f64_neg(f64_mul(z, z)))); }
    if (_N4Q_P == 4) {
        var u = f64_sub(f64_mul(z, z), F64_ONE);
        return f64_mul(u, u);
    }
    var v = f64_sub(z, F64_ONE);
    return f64_mul(v, v);
}
fn _n4q_gd(z) {
    if (_N4Q_P == 0) { return f64_sinh(z); }
    if (_N4Q_P == 1) { return f64_sub(f64_exp(z), F64_ONE); }
    if (_N4Q_P == 2) { return f64_sub(F64_ONE, f64_div(F64_ONE, z)); }
    if (_N4Q_P == 3) { return f64_mul(f64_mul(F64_TWO, z), f64_exp(f64_neg(f64_mul(z, z)))); }
    if (_N4Q_P == 4) { return f64_mul(f64_mul(0x4010000000000000, z), f64_sub(f64_mul(z, z), F64_ONE)); }
    return f64_mul(F64_TWO, f64_sub(z, F64_ONE));
}
fn _n4q_f(x) {
    _N4Q_NF = _N4Q_NF + 1;
    return f64_add(_N4Q_O, _n4q_gv(f64_sub(load64(x), _N4Q_T)));
}
fn _n4q_g(x, g) {
    _N4Q_NG = _N4Q_NG + 1;
    store64(g, _n4q_gd(f64_sub(load64(x), _N4Q_T)));
    return 0;
}
fn _n4q_run(solver, p, t, off, x0, tol) {
    _N4Q_P = p;
    _N4Q_T = t;
    _N4Q_O = off;
    _N4Q_NF = 0;
    _N4Q_NG = 0;
    store64(_n4q_x0, x0);
    if (solver == 0) {
        var tb, vb = opt_bfgs(&_n4q_f, &_n4q_g, _n4q_x0, 1, tol, 1000, _n4q_ox, _n4q_of);
        return tb;
    }
    var tl, vl = opt_lbfgs(&_n4q_f, &_n4q_g, _n4q_x0, 1, 5, tol, 1000, _n4q_ox, _n4q_of);
    return tl;
}
# 1 when both solvers solve the row: Ok, within 1e-5 of the minimiser T + zs, at most `cap` values of f.
fn _n4q_row(p, t, off, x0, tol, zs, cap) {
    var ok = 1;
    for (var sl = 0; sl <= 1; sl = sl + 1) {
        var tg = _n4q_run(sl, p, t, off, x0, tol);
        if (is_ok(tg) != 1) { ok = 0; }
        var dz = f64_abs(f64_sub(f64_sub(load64(_n4q_ox), t), zs));
        if (f64_lt(dz, 0x3EE4F8B588E368F1) == 0) { ok = 0; }
        if (_N4Q_NF > cap) { ok = 0; }
    }
    return ok;
}
var _n4q_1e6 = 0x3EB0C6F7A0B5ED8D;
var _n4q_1em15 = 0x3CD203AF9EE75616;
var _n4q_t46 = (1023 + 46) << 52;
var _n4q_t41 = (1023 + 41) << 52;
var _n4q_1e12 = 0x426D1A94A2000000;
var _n4q_1e13 = 0x42A2309CE5400000;
var _n4q_1e14 = 0x42D6BCC41E900000;
assert_eq(_n4q_row(0, 0, 0, 0x3D3C25C268497682, _n4q_1em15, 0, 4), 1,
  "qn: cosh(x) from 1e-13, tol 1e-15 (s22: Err at x0)");
assert_eq(_n4q_row(1, 0, 0, 0xBD3C25C268497682, _n4q_1em15, 0, 4), 1,
  "qn: exp(x) - x from -1e-13, tol 1e-15 (s22: Err)");
assert_eq(_n4q_row(0, 0, _n4q_1e14, F64_ONE, _n4q_1e6, 0, 8), 1, "qn: 1e14 + cosh(x) from 1 (s22: Err)");
assert_eq(_n4q_row(1, 0, _n4q_1e13, 0xBFF0000000000000, _n4q_1e6, 0, 10), 1,
  "qn: 1e13 + exp(x) - x from -1 (s22: Err)");
assert_eq(_n4q_row(2, 0, _n4q_1e12, 0x4008000000000000, _n4q_1e6, F64_ONE, 11), 1,
  "qn: 1e12 + x - ln x from 3 (s22: Err)");
assert_eq(_n4q_row(3, 0, _n4q_1e12, 0x3FF8000000000000, _n4q_1e6, 0, 12), 1,
  "qn: 1e12 + 1 - exp(-x^2) from 1.5 (s22: Err)");
assert_eq(_n4q_row(0, _n4q_t46, 0, f64_add(_n4q_t46, F64_ONE), _n4q_1e6, 0, 8), 1,
  "qn: cosh(x - 2^46) from 2^46 + 1 (s22: Err)");
assert_eq(_n4q_row(1, _n4q_t46, 0, f64_sub(_n4q_t46, F64_ONE), _n4q_1e6, 0, 9), 1,
  "qn: exp(x - 2^46) - (x - 2^46) from 2^46 - 1 (s22: Err)");
assert_eq(_n4q_row(2, _n4q_t41, 0, f64_add(_n4q_t41, 0x4008000000000000), _n4q_1e6, F64_ONE, 16), 1,
  "qn: the barrier x - ln x about 2^41, from 3 past it (s22: Err)");
assert_eq(_n4q_row(0, _n4q_t46, _n4q_1e14, f64_add(_n4q_t46, F64_ONE), _n4q_1e6, 0, 30), 1,
  "qn: 1e14 + cosh(x - 2^46): both lengths long, the back-off reaches it (40 trials did not)");
assert_eq(_n4q_row(2, _n4q_t41, _n4q_1e13, f64_add(_n4q_t41, 0x4008000000000000), _n4q_1e6, F64_ONE, 36), 1,
  "qn: 1e13 + the barrier about 2^41: f NaN past it for 2^41 of the first trial's length");
assert_eq(_n4q_row(3, _n4q_t41, _n4q_1e12, f64_add(_n4q_t41, 0x3FF8000000000000), _n4q_1e6, 0, 30), 1,
  "qn: 1e12 + 1 - exp(-(x - 2^41)^2): a plateau, halving alone needs 41");
# Past the first non-finite f a trial costs f alone: 13 gradients on this row, where 27 trials with
# 13 past the range of f paid for 27.
var _n4q_tg0 = _n4q_run(0, 0, _n4q_t46, _n4q_1e14, f64_add(_n4q_t46, F64_ONE), _n4q_1e6);
assert_lte(_N4Q_NG, 14, "opt_bfgs: 1e14 + cosh(x - 2^46) -> no gradient at the second non-finite f on (one each: 27)");
# A start far inside the shorter length's reach: (x - 1)^2 from 1e-30 tries 1.25e-30, whose slope has
# not moved, and goes to the longer length 2 (the trial past the minimum that the quadratic through it
# ends exactly on), not by 16 per gradient: 4 values of f, x = 1 exactly.
# [measured: scratch probe (NUM4-work py/near.py), s22 and this tree, 2026-11-01]
var _n4q_tg2 = _n4q_run(0, 5, 0, 0, 0x39B4484BFEEBC2A0, _n4q_1e6);
assert_eq(is_ok(_n4q_tg2), 1, "opt_bfgs: (x - 1)^2 from 1e-30 -> Ok");
assert_eq(load64(_n4q_ox), F64_ONE, "opt_bfgs: (x - 1)^2 from 1e-30 -> x = 1 exactly");
assert_eq(_N4Q_NF, 4, "opt_bfgs: ... in 4 values of f: the first extrapolation goes to the longer length (by 16s: 28)");
# A slope the first trial has moved keeps the secant: (x - 1)^2 + 10 from 0.1 tries 0.125, 7.2 short of
# the line minimum, and the secant is exact (the longer length, 24, would be refused first).
var _n4q_tg3 = _n4q_run(0, 5, 0, 0x4024000000000000, 0x3FB999999999999A, _n4q_1e6);
assert_eq(is_ok(_n4q_tg3), 1, "opt_bfgs: (x - 1)^2 + 10 from 0.1 -> Ok");
assert_eq(_N4Q_NF, 3, "opt_bfgs: ... in 3 values of f: the secant, not the longer length");
# The two lengths stand alone where the other is 0: x = 0 leaves 4 |f| / |g|, f = 0 leaves 1.25 |x|.
var _n4q_tg4 = _n4q_run(0, 1, F64_ONE, 0, 0, _n4q_1e6);
assert_eq(is_ok(_n4q_tg4), 1, "opt_bfgs: exp(x - 1) - (x - 1) from x = 0 -> Ok");
assert_eq(_N4Q_NF, 7, "opt_bfgs: ... x = 0: 4 |f| / |g| alone, 7 values of f (the unit trial: more)");
var _n4q_tg5 = _n4q_run(0, 0, 0x4020000000000000, f64_neg(f64_cosh(F64_ONE)), 0x4022000000000000, _n4q_1e6);
assert_eq(is_ok(_n4q_tg5), 1, "opt_bfgs: cosh(x - 8) - cosh(1) from 9 -> Ok");
assert_eq(_N4Q_NF, 14, "opt_bfgs: ... f = 0: 1.25 |x| alone, 14 values of f (the unit trial: fewer)");
# Past the 40 trials. f = 2 + w u^2 with u = x0 / w, |u| < 1, w = 2^-900, and NaN outside, x1 = 1 fixed (g1 =
# 0): both lengths are about 1, 2^900 times the right step, and f and g are NaN outside, so no secant
# helps. The cut
# reaches it past the 40th trial. A gradient of the wrong sign, 2-D, from the origin: no trial is ever
# taken, and the search stops where its trial underflows, in at most 76 trials and not 1,100.
# [measured: tests/edge_cases.tcyr, this group, on the tree and on the nocut / nobudget mutants, 2026-11-01]
var _N4Q_BN = 0;
var _n4q_bw = (1023 - 900) << 52;
fn _n4q_bf(x) {
    _N4Q_BN = _N4Q_BN + 1;
    var u = f64_div(load64(x), _n4q_bw);
    if (f64_lt(f64_abs(u), F64_ONE) == 0) { return 0x7FF8000000000000; }
    return f64_add(F64_TWO, f64_mul(_n4q_bw, f64_mul(u, u)));
}
fn _n4q_bg(x, g) {
    var u = f64_div(load64(x), _n4q_bw);
    store64(g, f64_mul(F64_TWO, u));
    if (f64_lt(f64_abs(u), F64_ONE) == 0) { store64(g, 0x7FF8000000000000); }
    store64(g + 8, 0);
    return 0;
}
store64(_n4q_x0, f64_mul(_n4q_bw, F64_HALF));
store64(_n4q_x0 + 8, F64_ONE);
var _n4q_bt, _n4q_bv = opt_bfgs(&_n4q_bf, &_n4q_bg, _n4q_x0, 2, 0x3F50000000000000, 200, _n4q_ox, _n4q_of);
assert_eq(is_ok(_n4q_bt), 1, "opt_bfgs: a first trial 2^900 too long, NaN past the step -> Ok (40 trials: Err at x0)");
assert(f64_lt(f64_abs(load64(_n4q_ox)), f64_mul(_n4q_bw, 0x3F50000000000000)), "opt_bfgs: ... x0 within 2^-10 w of 0");
assert(_N4Q_BN > 40, "opt_bfgs: ... after more than the 40 trials a search had");
assert_eq(load64(_n4q_ox + 8), F64_ONE, "opt_bfgs: ... x1 unmoved");
var _N4Q_UN = 0;
fn _n4q_uf(x) {
    _N4Q_UN = _N4Q_UN + 1;
    return f64_add(load64(x), load64(x + 8));
}
fn _n4q_ug(x, g) {
    store64(g, f64_neg(F64_ONE));
    store64(g + 8, f64_neg(F64_ONE));
    return 0;
}
store64(_n4q_x0, 0);
store64(_n4q_x0 + 8, 0);
var _n4q_ut, _n4q_uv = opt_lbfgs(&_n4q_uf, &_n4q_ug, _n4q_x0, 2, 5, _n4q_1e6, 200, _n4q_ox, _n4q_of);
assert_eq(_n4q_uv, HSB_ERR_NO_CONVERGENCE, "opt_lbfgs: a gradient of the wrong sign -> NO_CONVERGENCE");
assert_eq(load64(_n4q_ox), 0, "opt_lbfgs: ... at x0");
assert_lte(_N4Q_UN, 76, "opt_lbfgs: ... in at most 76 values of f, the trial underflowed (uncut: over 1,000)");
# The natural trigger: a Poisson regression restarted from its own answer. Solved from 0 at tol 1e-9,
# then from that answer at 1e-12 (s22: Err at x0, 41 values of f; 3.4.0: 25).
var _N4Q_PN = 24;
var _N4Q_PF = 0;
var _n4q_py = alloc(192);
store64(_n4q_py, 2); store64(_n4q_py + 8, 3);
store64(_n4q_py + 16, 2);
store64(_n4q_py + 24, 4);
store64(_n4q_py + 32, 3);
store64(_n4q_py + 40, 5);
store64(_n4q_py + 48, 4);
store64(_n4q_py + 56, 7);
store64(_n4q_py + 64, 6);
store64(_n4q_py + 72, 9);
store64(_n4q_py + 80, 8);
store64(_n4q_py + 88, 11);
store64(_n4q_py + 96, 12);
store64(_n4q_py + 104, 10);
store64(_n4q_py + 112, 15);
store64(_n4q_py + 120, 14);
store64(_n4q_py + 128, 19);
store64(_n4q_py + 136, 21);
store64(_n4q_py + 144, 18);
store64(_n4q_py + 152, 25);
store64(_n4q_py + 160, 27);
store64(_n4q_py + 168, 30);
store64(_n4q_py + 176, 29);
store64(_n4q_py + 184, 36);
fn _n4q_pe(x, i) {
    return f64_add(load64(x), f64_mul(load64(x + 8), f64_div(f64_from(i), f64_from(4))));
}
fn _n4q_pf(x) {
    _N4Q_PF = _N4Q_PF + 1;
    var s = 0;
    var i = 0;
    while (i < _N4Q_PN) {
        var e = _n4q_pe(x, i);
        s = f64_add(s, f64_sub(f64_exp(e), f64_mul(f64_from(load64(_n4q_py + i * 8)), e)));
        i = i + 1;
    }
    return s;
}
fn _n4q_pg(x, g) {
    var g0 = 0;
    var g1 = 0;
    var i = 0;
    while (i < _N4Q_PN) {
        var r = f64_sub(f64_exp(_n4q_pe(x, i)), f64_from(load64(_n4q_py + i * 8)));
        g0 = f64_add(g0, r);
        g1 = f64_add(g1, f64_mul(r, f64_div(f64_from(i), f64_from(4))));
        i = i + 1;
    }
    store64(g, g0);
    store64(g + 8, g1);
    return 0;
}
store64(_n4q_x0, 0);
store64(_n4q_x0 + 8, 0);
var _n4q_p1, _n4q_pv1 = opt_bfgs(&_n4q_pf, &_n4q_pg, _n4q_x0, 2, 0x3E112E0BE826D695, 2000, _n4q_ox, _n4q_of);
assert_eq(is_ok(_n4q_p1), 1, "opt_bfgs: Poisson regression at tol 1e-9 -> Ok");
_opt_copy(_n4q_x0, _n4q_ox, 2);
_N4Q_PF = 0;
var _n4q_p2, _n4q_pv2 = opt_bfgs(&_n4q_pf, &_n4q_pg, _n4q_x0, 2, 0x3D719799812DEA11, 2000, _n4q_ox, _n4q_of);
assert_eq(is_ok(_n4q_p2), 1, "opt_bfgs: restarted from its answer at tol 1e-12 -> Ok (s22: Err at x0)");
assert_lte(_N4Q_PF, 30, "opt_bfgs: ... at most 30 values of f (s22: 41 to no answer; 3.4.0: 25)");

# === 3.4.1 NUM4: Ok is refused where the line's slope reads a maximum ===
test_group("3.4.1 NUM4: Ok is refused where the line's slope reads a maximum");
# The third review's M2: where -g is parallel to x a first trial of length |x| lands on the origin, an
# even objective has g = 0 there, and both solvers returned Ok at the maximum. 1.25 |x| does not land
# there. A trial that still does (the last rows, built so that 4 |f| / |g| = |x|) is refused by
# _opt_ls_peak, whose slope test says the line curves down.
var _N4W_C = 0;
var _N4W_K = 0;
fn _n4w_f(x) {
    var a = load64(x);
    var b = load64(x + 8);
    var c = load64(x + 16);
    if (_N4W_K == 3) {
        var r2 = f64_add(f64_add(f64_mul(a, a), f64_mul(b, b)), f64_mul(c, c));
        return f64_mul(f64_sub(r2, F64_ONE), f64_sub(r2, F64_ONE));
    }
    var u = f64_sub(f64_mul(a, a), F64_ONE);
    if (_N4W_K == 2) {
        var v = f64_sub(f64_mul(b, b), F64_ONE);
        return f64_add(f64_mul(u, u), f64_mul(v, v));
    }
    return f64_add(f64_mul(u, u), f64_mul(b, b));
}
fn _n4w_g(x, g) {
    var a = load64(x);
    var b = load64(x + 8);
    var c = load64(x + 16);
    if (_N4W_K == 3) {
        var r2 = f64_add(f64_add(f64_mul(a, a), f64_mul(b, b)), f64_mul(c, c));
        var k = f64_mul(0x4010000000000000, f64_sub(r2, F64_ONE));
        store64(g, f64_mul(k, a));
        store64(g + 8, f64_mul(k, b));
        store64(g + 16, f64_mul(k, c));
        return 0;
    }
    store64(g, f64_mul(f64_mul(0x4010000000000000, a), f64_sub(f64_mul(a, a), F64_ONE)));
    if (_N4W_K == 2) {
        store64(g + 8, f64_mul(f64_mul(0x4010000000000000, b), f64_sub(f64_mul(b, b), F64_ONE)));
    } else {
        store64(g + 8, f64_mul(F64_TWO, b));
    }
    return 0;
}
fn _n4w_near(a, b) { return f64_lt(f64_abs(f64_sub(a, b)), 0x3F1A36E2EB1C432D); }
store64(_n4q_x0, 0x3FFB333333333333);
store64(_n4q_x0 + 8, 0x3FECCCCCCCCCCCCD);
store64(_n4q_x0 + 16, 0xBFF199999999999A);
_N4W_K = 3;
var _n4w_t1, _n4w_v1 = opt_bfgs(&_n4w_f, &_n4w_g, _n4q_x0, 3, 0x3E45798EE2308C3A, 1000, _n4q_ox, _n4q_of);
assert_eq(is_ok(_n4w_t1), 1, "opt_bfgs: (|x|^2 - 1)^2 in 3-D -> Ok");
assert(f64_lt(load64(_n4q_of), 0x3D719799812DEA11), "opt_bfgs: ... at f < 1e-12, not the maximum f = 1 (s22)");
var _n4w_t2, _n4w_v2 = opt_lbfgs(&_n4w_f, &_n4w_g, _n4q_x0, 3, 5, 0x3E45798EE2308C3A, 1000, _n4q_ox, _n4q_of);
assert_eq(is_ok(_n4w_t2), 1, "opt_lbfgs: (|x|^2 - 1)^2 in 3-D -> Ok");
assert(f64_lt(load64(_n4q_of), 0x3D719799812DEA11), "opt_lbfgs: ... at f < 1e-12, not the maximum f = 1 (s22)");
store64(_n4q_x0, F64_TWO);
store64(_n4q_x0 + 8, F64_TWO);
_N4W_K = 2;
var _n4w_t3, _n4w_v3 = opt_bfgs(&_n4w_f, &_n4w_g, _n4q_x0, 2, 0x3E45798EE2308C3A, 1000, _n4q_ox, _n4q_of);
assert_eq(is_ok(_n4w_t3), 1, "opt_bfgs: (x^2 - 1)^2 + (y^2 - 1)^2 from (2, 2) -> Ok");
assert_eq(_n4w_near(load64(_n4q_ox), F64_ONE) & _n4w_near(load64(_n4q_ox + 8), F64_ONE), 1,
  "opt_bfgs: ... (1, 1), not the maximum (0, 0) (s22)");
store64(_n4q_x0 + 8, 0);
_N4W_K = 1;
var _n4w_t4, _n4w_v4 = opt_lbfgs(&_n4w_f, &_n4w_g, _n4q_x0, 2, 5, 0x3E45798EE2308C3A, 1000, _n4q_ox, _n4q_of);
assert_eq(is_ok(_n4w_t4), 1, "opt_lbfgs: (x^2 - 1)^2 + y^2 from (2, 0) -> Ok");
assert_eq(_n4w_near(load64(_n4q_ox), F64_ONE), 1, "opt_lbfgs: ... (1, 0), not the saddle (0, 0) (s22)");
# A landing by construction: f = (x^2 - 1)^2 + 3 from 2 has f = 12, g = 24, so 4 |f| / |g| = 2 = |x|, the
# shorter length: the first trial is x = 0 exactly, f = 4 < 12, slope 0. Both Wolfe conditions hold and
# |g| < tol. The slope just before says the line curves down, and the trial is a high end.
for (var _n4w_s = 0; _n4w_s <= 1; _n4w_s = _n4w_s + 1) {
    var _n4w_tg = _n4q_run(_n4w_s, 4, 0, 0x4008000000000000, F64_TWO, 0x3E45798EE2308C3A);
    assert_eq(is_ok(_n4w_tg), 1, "qn: (x^2 - 1)^2 + 3 from 2, a first trial on the maximum -> Ok");
    assert_eq(_n4w_near(load64(_n4q_ox), F64_ONE), 1, "qn: ... x = 1 and not the maximum x = 0");
}
# The same trial where the origin IS the minimum: x^4 + 3 ... does not land; (x - 1)^2 style objectives
# have no maximum. A landing the slope clears: f = x^4 + x^2 / 2 from 1 is the origin's own minimum at the
# end of the run, and stands.
# A flat tail above the start: f = 1e12 + 1 - exp(-(x - 2^20)^2) from 2^20 + 3.04: a long step lands
# where g = 0 and f is the plateau, higher than the start by less than the approximate Wolfe allowance,
# in 12 values of f and 2 gradients, with Ok at 157 from the minimiser (the test off) or at f's
# rounding. The landing is refused and the run reaches the minimiser.
var _n4w_t20 = (1023 + 20) << 52;
assert_eq(_n4q_row(3, _n4w_t20, _n4q_1e12, 0x413000030B4B4BAF, _n4q_1e6, 0, 40), 1,
  "qn: 1e12 + 1 - exp(-(x - 2^20)^2): a landing on the flat tail is refused (test off: 157 from the minimiser)");
assert_eq(_n4q_row(3, _n4w_t20, _n4q_1e12, 0x412FFFFA5800CCBF, _n4q_1e6, 0, 40), 1,
  "qn: ... and from the other side");
# From 2^20 + 3.67 f(x0) and the tail are one double: f did not fall and the slope all but vanished, and
# the two slopes are equal, so the trial is a flat end (no test: Ok, 156 away).
assert_eq(_n4q_row(3, _n4w_t20, _n4q_1e12, 0x41300003AB3575B6, _n4q_1e6, 0, 40), 1,
  "qn: 1e12 + 1 - exp(-(x - 2^20)^2) from 3.67: a landing f cannot refuse");

# === 3.4.1 NUM4: a BFGS stall resets H ===
test_group("3.4.1 NUM4: a BFGS stall resets H");
# Dixon-Price from a near start at tol 1e-15, under g's resolution: both forms end NO_CONVERGENCE at the
# same point, so the path tells them apart: a step that rounds back to x discards H (46 gradients);
# one that only clears nupd keeps searching along H's direction (50).
# [measured: scratch sweep (NUM4-work py/diffm.py, k/opt4.cyr, problem 14), this tree and the mutant, 2026-11-01]
var _N4S_NG = 0;
fn _n4s_f(x) {
    var a = f64_sub(load64(x), F64_ONE);
    var s = f64_mul(a, a);
    var i = 1;
    while (i < 4) {
        var t = f64_sub(f64_mul(F64_TWO, f64_mul(load64(x + i * 8), load64(x + i * 8))), load64(x + (i - 1) * 8));
        s = f64_add(s, f64_mul(f64_from(i + 1), f64_mul(t, t)));
        i = i + 1;
    }
    return s;
}
fn _n4s_g(x, g) {
    _N4S_NG = _N4S_NG + 1;
    var i = 0;
    while (i < 4) {
        store64(g + i * 8, 0);
        i = i + 1;
    }
    store64(g, f64_mul(F64_TWO, f64_sub(load64(x), F64_ONE)));
    i = 1;
    while (i < 4) {
        var t = f64_sub(f64_mul(F64_TWO, f64_mul(load64(x + i * 8), load64(x + i * 8))), load64(x + (i - 1) * 8));
        var k = f64_mul(f64_mul(F64_TWO, f64_from(i + 1)), t);
        store64(g + i * 8, f64_add(load64(g + i * 8), f64_mul(k, f64_mul(0x4010000000000000, load64(x + i * 8)))));
        store64(g + (i - 1) * 8, f64_sub(load64(g + (i - 1) * 8), k));
        i = i + 1;
    }
    return 0;
}
store64(_n4q_x0, 0x3FF2A554CEF3A0B4);
store64(_n4q_x0 + 8, 0x3FEA83C56BA209AF);
store64(_n4q_x0 + 16, 0x3FF2F7CA38483547);
store64(_n4q_x0 + 24, 0x3FF4B28BF78322CB);
var _n4s_t, _n4s_v = opt_bfgs(&_n4s_f, &_n4s_g, _n4q_x0, 4, _n4q_1em15, 3000, _n4q_ox, _n4q_of);
assert_eq(_n4s_v, HSB_ERR_NO_CONVERGENCE,
  "opt_bfgs: Dixon-Price at tol 1e-15 -> NO_CONVERGENCE (under g's resolution)");
assert_eq(_N4S_NG, 46, "opt_bfgs: ... in 46 gradients: a stall resets H (keeping it: 50)");

# === 3.4.1 NUM4: a continuation answer carries a certificate ===
test_group("3.4.1 NUM4: a continuation answer carries a certificate");
# The third review's M3: `_ode_continue` returned Ok on another root of the step equation (79 of 15,960
# new Oks on its 60-digit set) or on a root past a fold of the branch. sigma(z) = (z - s) / (c f(t, z))
# is the branch itself: it must rise from 0 at s and stay below 1, at 63 points between s and the
# answer. The first row is the review's BDF-2 repro (Ok z = 137.50, 13 real roots, branch root 16.375),
# the second its backward Euler repro (Ok z = -2.4007, branch root -0.63813). Both Err now, `out`
# untouched, as 3.4.0. The third is a fold with one real root: the branch ends before sigma = 1, the
# far root is the step equation's only solution, and the step still refuses. A finite sample of f
# cannot show that a root is the only one (11 of the 121 folds the review found are not), the step's
# value jumps there as dt grows, and a smaller dt follows the branch. So Err, as 3.4.0, with the
# certificate's reason.
# [measured: scratch harness (NUM4-work k/odeh3.cyr, py/oo.py, py/ana_ode3.py), four seeds, 2026-11-01]
var _N4O_A = 0;
var _N4O_B = 0;
var _N4O_D = 0;
var _N4O_Y = 0;
fn _n4o_sin(t, y) { return f64_add(f64_mul(_N4O_A, f64_sin(f64_mul(_N4O_B, y))), _N4O_D); }
fn _n4o_gau(t, y) {
    var u = f64_mul(_N4O_B, f64_sub(y, _N4O_Y));
    return f64_add(f64_mul(_N4O_A, f64_exp(f64_neg(f64_mul(u, u)))), _N4O_D);
}
var _n4o_o = 0x7FF8000000000001;
_N4O_A = 0xBFD9196FF3304D2B;
_N4O_B = 0x3FD29C587DB7E60B;
_N4O_D = 0xBFDD176E6ABEF78A;
var _n4o_t1, _n4o_v1 = ode_bdf2_checked(&_n4o_sin, 0, 0x4015375B76B1A256, 0x4015375B76B1A256, 0xC070833E3A4C6BE1,
  0x3DA8ADAB290BF055, &_n4o_o);
assert_eq(_n4o_v1, HSB_ERR_NO_CONVERGENCE,
  "bdf2: another root of 13 is not an answer (s22: Ok 137.50; the branch: 16.375)");
assert_eq(_n4o_o, 0x7FF8000000000001, "bdf2: ... out untouched");
_N4O_A = 0xBFE2E137FF71222A;
_N4O_B = 0x400AA9820C2FB513;
_N4O_D = 0x3FD94D0622D00F36;
_N4O_Y = 0xBFEC10B386B7D051;
var _n4o_t2, _n4o_v2 = ode_backward_euler_checked(&_n4o_gau, f64_neg(0xC016872033A8E4BB), 0xBFC64FBA75012E28,
  0xC016872033A8E4BB, 0x3D6F0BB82F09C47E, 1, &_n4o_o);
assert_eq(_n4o_v2, HSB_ERR_NO_CONVERGENCE,
  "backward Euler: another root is not an answer (s22: Ok -2.4007; the branch: -0.63813)");
assert_eq(_n4o_o, 0x7FF8000000000001, "backward Euler: ... out untouched");
fn _n4o_lor(t, y) {
    var u = f64_mul(_N4O_B, f64_sub(y, _N4O_Y));
    return f64_add(f64_div(_N4O_A, f64_add(F64_ONE, f64_mul(u, u))), _N4O_D);
}
_N4O_A = 0x4014846440B6470D;
_N4O_B = 0x3FE24F42780B60B2;
_N4O_D = 0x4016F2D2DAAF785F;
_N4O_Y = 0x401492A3AD5F39F5;
var _n4o_t3, _n4o_v3 = ode_backward_euler_checked(&_n4o_lor, f64_neg(0x3FEB7DEB3EF8F03B), 0xBFF550D0E31B540C,
  0x3FEB7DEB3EF8F03B, 0x3D3BC6DDEA1ABF70, 8, &_n4o_o);
assert_eq(_n4o_v3, HSB_ERR_NO_CONVERGENCE,
  "backward Euler: a fold with one real root -> NO_CONVERGENCE (s22: Ok 6.4395)");
assert_eq(_n4o_o, 0x7FF8000000000001, "backward Euler: ... out untouched");
# sigma >= 1 before the answer stops the certificate at once: 32 evaluations of f on this step, 33 if
# only a fall in sigma did.
var _N4O_N = 0;
fn _n4o_lc(t, y) {
    _N4O_N = _N4O_N + 1;
    return _n4o_lor(t, y);
}
_N4O_A = 0x3F9761B7C6380E1E;
_N4O_B = 0x40744B2585790F59;
_N4O_D = 0xBF9D8A74FF531FF6;
_N4O_Y = 0x3F795DD8BBA2BF95;
var _n4o_t4, _n4o_v4 = ode_backward_euler_checked(&_n4o_lc, f64_neg(0x3FFA9DB82B3EDAED), 0x3F9194B49CF8CEF8,
  0x3FFA9DB82B3EDAED, 0x3CCD110E65497CCE, 2, &_n4o_o);
assert_eq(_n4o_v4, HSB_ERR_NO_CONVERGENCE, "backward Euler: sigma passes 1 before the answer -> NO_CONVERGENCE");
assert_eq(_N4O_N, 32, "backward Euler: ... found at the first such point, 32 evaluations");
# A move under the tol: C - exp(1e11 y) from rest, a move of 1.3e-17 at tol 1e-10. Samples read sigma >= 1,
# and each meets |g| < tol, so its Ok stands (without that second test the step fails).
# [measured: scratch harness (NUM4-work k/odeh.cyr), R2's row 1, this tree and the mutant, 2026-11-01]
fn _n4o_exp(t, y) { return f64_sub(0x3FEFFFFEF390876C, f64_exp(f64_mul(0x42374876E8000000, y))); }
var _n4o_t5, _n4o_v5 = ode_backward_euler_checked(&_n4o_exp, 0, 0, 0x3F50624DD2F1A9FC, 0x3DDB7CDFD9D7BDBB, 50, &_n4o_o);
assert_eq(is_ok(_n4o_t5), 1, "backward Euler: a move under tol keeps its Ok (no |g| < tol test: NO_CONVERGENCE)");
assert_eq(_n4o_o, 0xBC591BF27813B172, "backward Euler: ... at the continuation's 0xBC591BF27813B172");

# === 3.4.1 NUM4: cubic_bezier_ease past the double range, and its y ===
test_group("3.4.1 NUM4: cubic_bezier_ease past the double range, and its y");
# S1: py x / px where py / px overflows or flushes and the product does not. Exact values from Fractions;
# each within 2 rounding errors. S2: the y2 term past t^2's underflow: exact from a 170-digit solve.
# [measured: scratch oracles (NUM4-work py/s1.py, py/s2.py, py/cbx.py, 20,000 extreme inputs), 2026-11-01]
fn _n4b_ud(a, b) {
    var ka = a;
    if (ka < 0) { ka = 0 - (ka & 0x7FFFFFFFFFFFFFFF); }
    var kb = b;
    if (kb < 0) { kb = 0 - (kb & 0x7FFFFFFFFFFFFFFF); }
    if (ka < kb) { return kb - ka; }
    return ka - kb;
}
var _n4b_d = cubic_bezier_ease(0x01A56E1FC2F8F359, 0x7FE1CCF385EBC8A0, F64_HALF, F64_ONE, 0x809C16C5C5253575);
assert_eq(_n4b_d, 0xFED754E31CD072DA, "cubic_bezier_ease: (1e-300, 1e308, .5, 1) at -1e-305 -> -1e303 (s22: -Inf)");
assert_eq(cubic_bezier_ease(0x01A56E1FC2F8F359, 0x7FE1CCF385EBC8A0, F64_HALF, F64_ONE, 0x81A56E1FC2F8F359),
  0xFFE1CCF385EBC8A0, "cubic_bezier_ease: ... at -1e-300 -> -1e308 (s22: -Inf)");
assert_eq(cubic_bezier_ease(1, 0x7E37E43C8800759C, F64_ONE, F64_ONE, 0x8000000000000001), 0xFE37E43C8800759C,
  "cubic_bezier_ease: (2^-1074, 1e300, 1, 1) at -2^-1074 -> -1e300 (s22: -Inf)");
assert_eq(cubic_bezier_ease(0, 0, 0x01A56E1FC2F8F359, 0x7FE1CCF385EBC8A0, 0x809C16C5C5253575), 0xFED754E31CD072DA,
  "cubic_bezier_ease: the second control point's tangent, (0, 0, 1e-300, 1e308) at -1e-305 -> -1e303");
assert_eq(cubic_bezier_ease(0x7E37E43C8800759C, 0x01A56E1FC2F8F359, F64_HALF, F64_ONE, 0xFE37E43C8800759C),
  0x81A56E1FC2F8F359, "cubic_bezier_ease: a slope that flushes: (1e300, 1e-300, .5, 1) at -1e300 -> -1e-300 (s22: 0)");
assert_eq(cubic_bezier_ease(0x7E37E43C8800759C, 0x01A56E1FC2F8F359, F64_HALF, F64_ONE, 0xFFF0000000000000),
  0xFFF0000000000000, "cubic_bezier_ease: ... at -Inf -> -Inf, a slope too small to hold is still a slope");
assert_eq(cubic_bezier_ease(0x7E37E43C8800759C, 0x81A56E1FC2F8F359, F64_HALF, F64_ONE, 0xFFF0000000000000),
  0x7FF0000000000000, "cubic_bezier_ease: ... and its sign: y1 = -1e-300 at -Inf -> +Inf");
assert_lte(_n4b_ud(cubic_bezier_ease(0x00000000000007E8, 0x7E37E43C8800759C, F64_HALF, F64_ONE,
      0x80000000000000CA), 0xFE031351B879CA2C), 1,
  "cubic_bezier_ease: subnormal x1 and x: (1e-320, 1e300, .5, 1) at -1e-321 (s22: -Inf)");
assert_eq(cubic_bezier_ease(0x3FE0000000000000, 0, 0x3FEFFFFFFFFFFFFF, 0x7FE1CCF385EBC8A0, 0x3FF0000000000001),
  0xFFF0000000000000, "cubic_bezier_ease: past 1, an exact value past DBL_MAX stays -Inf");
assert_lte(_n4b_ud(cubic_bezier_ease(0x3FD0A71DE69AD42C, F64_ONE, 0x3FC25E353F7CED91, 0x7E37E43C8800759C,
      0x154E3E43352C0D43), 0x291A4441EB8CF985), 2,
  "cubic_bezier_ease: y2 = 1e300 at 4.71e-206 -> 1.09e-110 (s22: 1.81e-205)");
assert_lte(_n4b_ud(cubic_bezier_ease(0x3E112E0BE826D695, 0xBFE428F5C28F5C29, 0, 0x7E37E43C8800759C,
      0x04CF989C52366143), 0x0B9AEFE78A8C2D41), 2,
  "cubic_bezier_ease: y2 = 1e300 at 1.66e-285 -> 9.2e-253 (s22: -1.05e-276)");
assert_lte(_n4b_ud(cubic_bezier_ease(0x3FDAE147AE147AE1, 0, F64_ONE, 0x412E848000000000, 0x1F55F7A46A0C89DD),
    0x000D9687883281F6), 2, "cubic_bezier_ease: (0.42, 0, 1, 1e6) at 1e-157 (s22: 446,409 units off)");
assert_lte(_n4b_ud(cubic_bezier_ease(0x3FDAE147AE147AE1, 0, F64_ONE, 0x408F400000000000, 0x1F55F7A46A0C89DD),
    0x0000037A80E77979), 1, "cubic_bezier_ease: (0.42, 0, 1, 1e3) at 1e-157 (s22: 997 units off)");
assert_lte(_n4b_ud(cubic_bezier_ease(0x3FE84F765FD8ADAC, 0, 0x3FEEAF4F0D844D01, 0xC049628F5C28F5C3,
      0x1F2D862CD84200F8), 0x8000000063D7B163), 2,
  "cubic_bezier_ease: (0.7597, 0, 0.9589, -50.77) at 1.68e-158 (s22: 61 units off)");
# S4: pins the reviewers' mutants survived. The double-double y needs its range guard: at 2^1000 its
# split overflows, and 2^1000 - 2^1000 at t = 1/2 is 1/8 by the Bernstein form. Inside 2^990 it runs:
# the 2^800 row is the exact value rounded (170-digit solve) where the Bernstein form, s22's past 2^500,
# is one ulp off.
assert_eq(cubic_bezier_ease(F64_HALF, (1023 + 1000) << 52, F64_HALF, 0xFE70000000000000, F64_HALF),
  0x3FC0000000000000, "cubic_bezier_ease: y1 = 2^1000, y2 = -2^1000 at 1/2 -> 1/8 (the split past its range: NaN)");
assert_eq(cubic_bezier_ease(F64_HALF, 0xF1F0000000000000, 0x3FD999999999999A, (1023 + 800) << 52, 0x3FD3333333333333),
  0xF1D1616297537812, "cubic_bezier_ease: y = -+2^800, cancelling -> double-double, exact (s22: 1 ulp off)");
# The bisection's key of a negative lo (a curve with x1, x2 outside [0, 1]: B_x turns back and the bracket
# starts below 0). On such curves y carries the coefficients' rounding, 9 ulps here and more elsewhere, so
# an unconverted key is not worse everywhere (of 500 rows where it differs, 242 worse, 258 better), but it
# can leave the bracket: 358 ulps on this row. Exact root's y by a 60-digit solve.
# [measured: scratch sweep (NUM4-work py/ks.py, py/ky.py), this tree and the mutant, 2026-11-01]
assert_lte(_n4b_ud(cubic_bezier_ease(0x404BB5D467E02131, 0x3FFF63D82AC8E5D0, 0xC02A0EF897D47806, 0xC0022A4DD5C82561,
      0x3FE5DB3051F31A41), 0x3F98A9D93FF4C327), 16, "cubic_bezier_ease: x1 = 55.4, x2 = -13: the key of a negative lo");
# fBm: amp = DBL_MAX, 2 octaves, persistence 1: the sum is finite and max_amp is +Inf, which the range test
# must catch (dropping the 0x7FF term of its exponent test gives 0 on 344 of 400 points).
# [measured: scratch probe (NUM4-work k/fbm.cyr), this tree and the mutant, 2026-11-01]
var _n4b_o = alloc(8);
var _n4b_ft, _n4b_fv = simplex_fbm_2d_checked(0x3FD3333333333333, 0x3FD999999999999A, 2, 0x3FF8000000000000,
  0x7FEFFFFFFFFFFFFF, F64_ONE, _n4b_o);
var _n4b_big = load64(_n4b_o);
var _n4b_gt, _n4b_gv = simplex_fbm_2d_checked(0x3FD3333333333333, 0x3FD999999999999A, 2, 0x3FF8000000000000, F64_ONE,
  F64_ONE, _n4b_o);
assert_eq(is_ok(_n4b_ft), 1, "simplex_fbm_2d_checked: amp DBL_MAX, 2 octaves, persistence 1 -> Ok");
assert(load64(_n4b_o) != 0, "simplex_fbm_2d_checked: control: the amp = 1 mean is not 0 here");
assert_lte(_n4b_ud(_n4b_big, load64(_n4b_o)), 8,
  "simplex_fbm_2d_checked: ... the amp = 1 mean, within 8 ulps (a lost +Inf: 0)");

# === 3.4.1 SYM4: a moving miss stays moving ===
# Round-2 review M1. A domain miss answered the tangent +0 whatever moved, and +0 is the
# constant mark, so the zero rule read a moving miss as a constant zero. Every truth below is the
# REAL function's, by hand: a limit, a one-sided slope, or no value at all, and none of them is
# a finite number the two modes could have answered, except where an assertion names one.
# [measured: tests/edge_cases.tcyr, this group; scratch oracle judge.py at 4,000 bits, 2026-11-01]
test_group("3.4.1 SYM4: a moving miss stays moving");
var _s4m_half = F64_HALF;
var _s4m_third = 0x3FD5555555555555;   # the double nearest 1/3
var _s4m_mhalf = 0xBFE0000000000000;
var _s4m_mone = 0xBFF0000000000000;
# The tape's derivative of program p (1 to 10) at x. Forward is written beside each.
fn _s4m_tape(p, x) {
    var t = ad_tape_new(32);
    var v = ad_var(t, x);
    var r = 0;
    if (p == 1) { r = ad_mul(t, ad_sqrt(t, v), ad_pow(t, v, F64_HALF)); }
    if (p == 2) { r = ad_mul(t, ad_pow(t, v, F64_HALF), ad_sqrt(t, v)); }
    if (p == 3) {
        var u = ad_sub(t, v, ad_const(t, F64_ONE));
        r = ad_mul(t, ad_sqrt(t, u), ad_pow(t, u, F64_HALF));
    }
    if (p == 4) {
        var w = ad_neg(t, v);
        r = ad_mul(t, ad_sqrt(t, w), ad_pow(t, w, F64_HALF));
    }
    if (p == 5) { r = ad_div(t, ad_sqrt(t, v), ad_pow(t, v, 0xBFE0000000000000)); }
    if (p == 6) { r = ad_mul(t, ad_ln(t, v), ad_pow(t, v, F64_HALF)); }
    if (p == 7) { r = ad_mul(t, ad_sqrt(t, v), ad_pow(t, v, 0x3FD5555555555555)); }
    if (p == 8) { r = ad_mul(t, ad_div(t, ad_const(t, F64_ONE), v), ad_pow(t, v, F64_HALF)); }
    if (p == 9) { r = ad_pow(t, ad_sqrt(t, v), F64_HALF); }
    if (p == 10) { r = ad_mul(t, ad_sqrt(t, v), v); }
    var gt, gv = ad_grad(t, r);
    return ad_grad_of(t, v);
}
# The eight rows of the review, and sqrt(x)^0.5 = x^0.25.
var _s4m_x0 = dual_var(0);
var _s4m_rows = vec_new();
vec_push(_s4m_rows, dual_mul(dual_sqrt(_s4m_x0), dual_pow(_s4m_x0, _s4m_half)));
vec_push(_s4m_rows, dual_mul(dual_pow(_s4m_x0, _s4m_half), dual_sqrt(_s4m_x0)));
var _s4m_u1 = dual_sub(dual_var(F64_ONE), dual_const(F64_ONE));
vec_push(_s4m_rows, dual_mul(dual_sqrt(_s4m_u1), dual_pow(_s4m_u1, _s4m_half)));
var _s4m_nx = dual_neg(_s4m_x0);
vec_push(_s4m_rows, dual_mul(dual_sqrt(_s4m_nx), dual_pow(_s4m_nx, _s4m_half)));
vec_push(_s4m_rows, dual_div(dual_sqrt(_s4m_x0), dual_pow(_s4m_x0, _s4m_mhalf)));
vec_push(_s4m_rows, dual_mul(dual_ln(_s4m_x0), dual_pow(_s4m_x0, _s4m_half)));
vec_push(_s4m_rows, dual_mul(dual_sqrt(_s4m_x0), dual_pow(_s4m_x0, _s4m_third)));
vec_push(_s4m_rows, dual_mul(dual_div(dual_const(F64_ONE), _s4m_x0), dual_pow(_s4m_x0, _s4m_half)));
vec_push(_s4m_rows, dual_pow(dual_sqrt(_s4m_x0), _s4m_half));
for (var i = 0; i < 9; i = i + 1) {
    var _s4m_at = 0;
    if (i == 2) { _s4m_at = F64_ONE; }
    var _s4m_f = Dual_deriv(vec_get(_s4m_rows, i));
    var _s4m_r = _s4m_tape(i + 1, _s4m_at);
    assert_eq(f64_eq(_s4m_f, _s4m_f), 0, "forward: a product or power through a moving miss is NaN, not 0 (row 1-9)");
    assert_eq(f64_eq(_s4m_r, _s4m_r), 0, "reverse: the same program is NaN, not 0 (row 1-9)");
}
# A moving miss alone, both signs of the domain, exact bits.
assert_eq(Dual_val(dual_sqrt(dual_var(_s4m_mone))), 0, "dual_sqrt(x) at -1: the miss's value 0");
assert_eq(Dual_deriv(dual_sqrt(dual_var(_s4m_mone))), _AD_NAN, "dual_sqrt(x) at -1: no real value, a NaN tangent");
assert_eq(Dual_deriv(dual_ln(dual_var(_s4m_mone))), _AD_NAN, "dual_ln(x) at -1: no real value, a NaN tangent");
assert_eq(Dual_deriv(dual_div(dual_const(F64_ONE), dual_var(0))), _AD_NAN,
  "dual_div(1, x) at 0: a pole, a NaN tangent");
assert_eq(Dual_deriv(dual_div(dual_var(F64_ONE), dual_const(0))), _AD_NAN,
  "dual_div(x, 0): a moving dividend, a NaN tangent");
assert_eq(Dual_deriv(dual_div(dual_var(F64_ONE), dual_var(0))), _AD_NAN,
  "dual_div(x, y) at y = 0: both move, a NaN tangent");
var _s4m_tk = ad_tape_new(8);
var _s4m_kx = ad_var(_s4m_tk, F64_ONE);
var _s4m_kq = ad_div(_s4m_tk, _s4m_kx, ad_const(_s4m_tk, 0));
var _s4m_kgt, _s4m_kgv = ad_grad(_s4m_tk, _s4m_kq);
assert_eq(ad_grad_of(_s4m_tk, _s4m_kx), _AD_NAN, "ad_div(x, const 0): a moving dividend, the NaN partial");
var _s4m_mz = dual_mul(dual_var(0), dual_var(0));
assert_eq(Dual_deriv(_s4m_mz), 0x8000000000000000, "the fixture: x x at 0 is a moving zero, -0");
assert_eq(Dual_deriv(dual_sqrt(_s4m_mz)), _AD_NAN,
  "dual_sqrt(x x) at 0 = |x|: no derivative, a NaN tangent (a moving zero is moving)");
assert_eq(Dual_deriv(dual_ln(_s4m_mz)), _AD_NAN, "dual_ln(x x) at 0: a pole, a NaN tangent");
# On constants the miss is unchanged: (0, +0), the documented sentinel, in both modes.
assert_eq(Dual_val(dual_sqrt(dual_const(_s4m_mone))) | Dual_deriv(dual_sqrt(dual_const(_s4m_mone))), 0,
  "dual_sqrt(const -1): (0, +0)");
assert_eq(Dual_deriv(dual_ln(dual_const(0))), 0, "dual_ln(const 0): tangent +0");
assert_eq(Dual_deriv(dual_div(dual_const(F64_ONE), dual_const(0))), 0, "dual_div(const, const 0): tangent +0");
var _s4m_tc = ad_tape_new(16);
var _s4m_cx = ad_var(_s4m_tc, F64_TWO);
var _s4m_cm = ad_sqrt(_s4m_tc, ad_const(_s4m_tc, _s4m_mone));
assert_eq(_ad_isk(_ad_node(_s4m_tc, _s4m_cm)), 1, "ad_sqrt(const -1) records a constant");
assert_eq(_ad_isk(_ad_node(_s4m_tc, ad_ln(_s4m_tc, ad_const(_s4m_tc, 0)))), 1, "ad_ln(const 0) records a constant");
assert_eq(_ad_isk(_ad_node(_s4m_tc, ad_div(_s4m_tc, ad_const(_s4m_tc, F64_ONE), ad_const(_s4m_tc, 0)))), 1,
  "ad_div(const, const 0) records a constant");
var _s4m_cr = ad_mul(_s4m_tc, _s4m_cm, _s4m_cx);
var _s4m_cgt, _s4m_cgv = ad_grad(_s4m_tc, _s4m_cr);
assert_eq(ad_grad_of(_s4m_tc, _s4m_cx), 0, "the constant miss times x: the constant zero annihilates, exactly +0");
# The NaN survives every op below a moving miss, with its mark, in both modes.
var _s4m_ms = dual_sqrt(dual_var(_s4m_mone));
assert_eq(_ad_missed(Dual_deriv(dual_sin(_s4m_ms))), 1, "forward: sin keeps the mark");
assert_eq(_ad_missed(Dual_deriv(dual_cos(_s4m_ms))), 1, "forward: cos keeps the mark");
assert_eq(_ad_missed(Dual_deriv(dual_exp(_s4m_ms))), 1, "forward: exp keeps the mark");
assert_eq(_ad_missed(Dual_deriv(dual_neg(_s4m_ms))), 1, "forward: neg keeps the mark (its sign flips)");
assert_eq(_ad_missed(Dual_deriv(dual_abs(_s4m_ms))), 1, "forward: abs keeps the mark");
assert_eq(_ad_missed(Dual_deriv(dual_pow(_s4m_ms, F64_TWO))), 1, "forward: pow keeps the mark");
assert_eq(_ad_missed(Dual_deriv(dual_add(_s4m_ms, dual_var(F64_ONE)))), 1, "forward: a sum keeps the mark");
assert_eq(_ad_missed(Dual_deriv(dual_mul(dual_const(F64_TWO), _s4m_ms))), 1, "forward: 2 * keeps the mark");
assert_eq(_ad_missed(Dual_deriv(dual_div(_s4m_ms, dual_const(F64_TWO)))), 1, "forward: / 2 keeps the mark");
assert_eq(_ad_missed(0xFFF8000000000000), 0, "_ad_missed: an ordinary NaN is not the mark");
assert_eq(_ad_missed(F64_ONE), 0, "_ad_missed: a number is not the mark");
# A constant zero and x^0 cut a derivative off, but never a moving miss: 0 * sqrt(x) at -1 has no
# real value. Beside a g that has one the zero still annihilates, a NaN tangent included.
fn _s4m_cut(p, x) {
    var t = ad_tape_new(32);
    var v = ad_var(t, x);
    var r = 0;
    var z = ad_const(t, 0);
    var s = ad_sqrt(t, v);
    if (p == 1) { r = ad_mul(t, z, s); }
    if (p == 2) { r = ad_mul(t, s, z); }
    if (p == 3) { r = ad_mul(t, z, ad_sin(t, s)); }
    if (p == 4) { r = ad_mul(t, ad_add(t, s, ad_const(t, F64_ONE)), z); }
    if (p == 5) { r = ad_div(t, z, ad_add(t, s, ad_const(t, F64_ONE))); }
    if (p == 6) { r = ad_pow(t, s, 0); }
    if (p == 7) { r = ad_sub(t, s, s); }
    if (p == 8) { r = ad_add(t, ad_mul(t, z, s), ad_const(t, F64_ONE)); }
    if (p == 9) {
        var s1 = ad_add(t, s, ad_const(t, F64_ONE));
        r = ad_div(t, s1, s1);
    }
    var gt, gv = ad_grad(t, r);
    return ad_grad_of(t, v);
}
var _s4m_g = dual_sqrt(dual_var(_s4m_mone));
var _s4m_g1 = dual_add(_s4m_g, dual_const(F64_ONE));
assert_eq(Dual_deriv(dual_mul(dual_const(0), _s4m_g)), _AD_NAN, "forward: 0 * sqrt(x) at -1 keeps the NaN");
assert_eq(_s4m_cut(1, _s4m_mone), _AD_NAN, "reverse: the same");
assert_eq(Dual_deriv(dual_mul(_s4m_g, dual_const(0))), _AD_NAN, "forward: sqrt(x) * 0 at -1 keeps the NaN");
assert_eq(_s4m_cut(2, _s4m_mone), _AD_NAN, "reverse: the same");
assert_eq(_ad_missed(Dual_deriv(dual_mul(dual_const(0), dual_sin(_s4m_g)))), 1,
  "forward: 0 * sin(sqrt(x)) keeps it, one op down");
assert_eq(_s4m_cut(3, _s4m_mone), _AD_NAN, "reverse: the same, the mark handed on through sin");
assert_eq(_ad_missed(Dual_deriv(dual_mul(_s4m_g1, dual_const(0)))), 1, "forward: (sqrt(x) + 1) * 0 keeps it");
assert_eq(_s4m_cut(4, _s4m_mone), _AD_NAN, "reverse: the same, through the second slot of a sum");
assert_eq(_ad_missed(Dual_deriv(dual_div(dual_const(0), _s4m_g1))), 1, "forward: 0 / (sqrt(x) + 1) keeps it");
assert_eq(_s4m_cut(5, _s4m_mone), _AD_NAN, "reverse: the same");
var _s4m_p0 = dual_pow(_s4m_g, 0);
assert_eq(Dual_val(_s4m_p0), F64_ONE, "forward: sqrt(x)^0 at -1: the value is pow(v, 0) = 1");
assert_eq(Dual_deriv(_s4m_p0), _AD_NAN, "forward: ... and the NaN stays");
assert_eq(_s4m_cut(6, _s4m_mone), _AD_NAN, "reverse: the same");
assert_eq(Dual_deriv(dual_sub(_s4m_g, _s4m_g)), _AD_NAN, "forward: sqrt(x) - sqrt(x), one handle, at -1 keeps the NaN");
assert_eq(_s4m_cut(7, _s4m_mone), _AD_NAN, "reverse: the same");
assert_eq(_ad_missed(Dual_deriv(dual_div(_s4m_g1, _s4m_g1))), 1,
  "forward: (sqrt(x) + 1) / itself at -1 keeps the mark");
assert_eq(_s4m_cut(9, _s4m_mone), _AD_NAN, "reverse: the same");
assert_eq(_s4m_cut(8, _s4m_mone), _AD_NAN, "reverse: downstream of the kept edge it stays moving");
assert_eq(Dual_deriv(dual_mul(dual_const(0), dual_new(F64_TWO, 0x7FF8000000000000))), 0,
  "forward: 0 * (2, NaN'): a g with a value, annihilated (an ordinary NaN is not the mark)");
# sqrt(x) x at 0 is x^1.5, right derivative 0: NaN, as x x^0.5 has been since SYM2: the cost.
var _s4m_c1 = _s4m_tape(10, 0);
assert_eq(f64_eq(_s4m_c1, _s4m_c1), 0, "reverse: sqrt(x) x at 0 is NaN (true 0): the stated cost of the rule");
assert_eq(_ad_missed(Dual_deriv(dual_mul(dual_sqrt(dual_var(0)), dual_var(0)))), 1, "forward: the same");
# A tape with two moving inputs: the miss's NaN goes to its own input only. An op on a marked
# operand in the SECOND slot moves the mark to the first and keeps the other partial.
var _s4m_t2 = ad_tape_new(16);
var _s4m_y = ad_var(_s4m_t2, F64_TWO);
var _s4m_x2 = ad_var(_s4m_t2, _s4m_mone);
var _s4m_sq = ad_sqrt(_s4m_t2, _s4m_x2);
var _s4m_ra = ad_mul(_s4m_t2, _s4m_y, _s4m_sq);
var _s4m_ga, _s4m_gb = ad_grad(_s4m_t2, _s4m_ra);
assert_eq(ad_grad_of(_s4m_t2, _s4m_x2), _AD_NAN, "reverse: d(y sqrt(x))/dx at x = -1 is NaN");
assert_eq(ad_grad_of(_s4m_t2, _s4m_y), 0, "reverse: d/dy is the miss's value 0 times 1, exact");
assert_eq(_ad_tainted(_ad_node(_s4m_t2, _s4m_ra)), 1, "the product is marked");
var _s4m_rb = ad_add(_s4m_t2, _s4m_y, _s4m_sq);
var _s4m_gc, _s4m_gd = ad_grad(_s4m_t2, _s4m_rb);
assert_eq(ad_grad_of(_s4m_t2, _s4m_y), F64_ONE, "reverse: d(y + sqrt(x))/dy is 1: the mark moved, the partial stayed");
assert_eq(ad_grad_of(_s4m_t2, _s4m_x2), _AD_NAN, "reverse: d(y + sqrt(x))/dx is NaN");
assert_eq(_ad_tainted(_ad_node(_s4m_t2, _s4m_y)), 0, "an input is not marked");
# Forward mode reads an input seeded with +0 as a constant, so along x alone sqrt(y) is the
# constant 0 at y = -1, and annihilates: item (3) of the block above dual_div.
assert_eq(Dual_deriv(dual_mul(dual_sqrt(dual_const(_s4m_mone)), dual_pow(dual_var(0), _s4m_half))), 0,
  "forward: a constant miss times x^0.5 at 0: the constant zero annihilates");

# === 3.4.1 SYM4: an operand minus itself, or over itself, is a constant ===
# The review's scratch fix, and the rule above before this one, turn x - x under a miss into NaN
# for an exact derivative of 0. One operand is one thing the two modes can both see, and a - a
# is 0 at every finite a, a / a is 1 wherever a is not a miss: exact, whatever the seed.
test_group("3.4.1 SYM4: an operand minus itself, or over itself, is a constant");
fn _s4s_tape(p, x) {
    var t = ad_tape_new(32);
    var v = ad_var(t, x);
    var d = ad_sub(t, v, v);
    var r = d;
    if (p == 1) { r = ad_sqrt(t, d); }
    if (p == 2) { r = ad_mul(t, d, ad_pow(t, v, F64_HALF)); }
    if (p == 3) { r = ad_div(t, v, v); }
    if (p == 4) { r = ad_ln(t, ad_div(t, v, v)); }
    var gt, gv = ad_grad(t, r);
    return ad_grad_of(t, v);
}
var _s4s_x = dual_var(0x3FF8000000000000);
assert_eq(Dual_val(dual_sub(_s4s_x, _s4s_x)), 0, "forward: x - x, value +0");
assert_eq(Dual_deriv(dual_sub(_s4s_x, _s4s_x)), 0, "forward: x - x, one handle: the constant 0, tangent +0");
assert_eq(_s4s_tape(0, 0x3FF8000000000000), 0, "reverse: x - x, one node: 0");
assert_eq(Dual_deriv(dual_sqrt(dual_sub(_s4s_x, _s4s_x))), 0,
  "forward: sqrt(x - x) is sqrt(0), the constant 0: exactly 0, not NaN");
assert_eq(_s4s_tape(1, 0x3FF8000000000000), 0, "reverse: the same");
var _s4s_x0 = dual_var(0);
assert_eq(Dual_deriv(dual_mul(dual_sub(_s4s_x0, _s4s_x0), dual_pow(_s4s_x0, F64_HALF))), 0,
  "forward: (x - x) x^0.5 at 0 is 0 for all x >= 0: exactly 0, not 0 * Inf");
assert_eq(_s4s_tape(2, 0), 0, "reverse: the same");
assert_eq(Dual_deriv(dual_div(_s4s_x, _s4s_x)), 0, "forward: x / x, one handle: the constant 1, tangent +0");
assert_eq(Dual_val(dual_div(_s4s_x, _s4s_x)), F64_ONE, "forward: x / x is 1");
assert_eq(_s4s_tape(3, 0x3FF8000000000000), 0, "reverse: x / x, one node: 0");
assert_eq(Dual_deriv(dual_ln(dual_div(_s4s_x, _s4s_x))), 0, "forward: ln(x / x) is ln(1), the constant 0");
assert_eq(_s4s_tape(4, 0x3FF8000000000000), 0, "reverse: the same");
# x / x - 1 is the constant 0, so a miss on it is a constant miss in both modes.
assert_eq(Dual_deriv(dual_sqrt(dual_sub(dual_div(_s4s_x, _s4s_x), dual_const(F64_ONE)))), 0,
  "forward: sqrt(x / x - 1), a constant miss: exactly 0");
var _s4s_t1 = ad_tape_new(16);
var _s4s_v1 = ad_var(_s4s_t1, 0x3FF8000000000000);
var _s4s_r1 = ad_sqrt(_s4s_t1, ad_sub(_s4s_t1, ad_div(_s4s_t1, _s4s_v1, _s4s_v1), ad_const(_s4s_t1, F64_ONE)));
var _s4s_g1t, _s4s_g1v = ad_grad(_s4s_t1, _s4s_r1);
assert_eq(ad_grad_of(_s4s_t1, _s4s_v1), 0, "reverse: the same, x / x records the constant 1");
# x / x at 0 has no value, and an infinite or NaN operand is no finite a: the rule does not apply.
var _s4s_fz = dual_var(0);
assert_eq(Dual_deriv(dual_div(_s4s_fz, _s4s_fz)), _AD_NAN, "forward: x / x at 0: a moving miss, not a constant");
var _s4s_c = _s4s_tape(3, 0);
assert_eq(_s4s_c, _AD_NAN, "reverse: the same");
var _s4s_fi = dual_var(F64_POS_INF);
var _s4s_di = dual_sub(_s4s_fi, _s4s_fi);
assert_eq(f64_eq(Dual_val(_s4s_di), Dual_val(_s4s_di)), 0, "forward: x - x at +Inf has a NaN value");
assert_eq(Dual_deriv(_s4s_di) != 0, 1, "forward: ... and is not the constant");
var _s4s_ti = ad_tape_new(16);
var _s4s_vi = ad_var(_s4s_ti, F64_POS_INF);
assert_eq(_ad_isk(_ad_node(_s4s_ti, ad_sub(_s4s_ti, _s4s_vi, _s4s_vi))), 0,
  "reverse: x - x at +Inf records no constant");
var _s4s_n = dual_new(0x7FF8000000000000, F64_ONE);
assert_eq(f64_eq(Dual_val(dual_div(_s4s_n, _s4s_n)), Dual_val(dual_div(_s4s_n, _s4s_n))), 0,
  "forward: x / x at NaN is NaN");
# Two handles are two operands: the moving zero stays one, in both modes.
assert_eq(Dual_deriv(dual_sub(_s4s_x, dual_var(0x3FF8000000000000))), 0x8000000000000000,
  "forward: x - x', two handles to equal values: a moving zero, -0");
var _s4s_t = ad_tape_new(16);
var _s4s_v = ad_var(_s4s_t, 0x3FF8000000000000);
var _s4s_d2 = ad_add(_s4s_t, _s4s_v, ad_neg(_s4s_t, _s4s_v));
assert_eq(_ad_isk(_ad_node(_s4s_t, _s4s_d2)), 0, "reverse: x + (-x) is no constant node");

# === 3.4.1 SYM4: dual_div where q leaves the doubles ===
# Round-2 review S1, S2. Each expected value is the exact (a' b - a b') / b^2 of the doubles shown,
# correctly rounded with Python's Fraction, unless the message gives its ulps.
# [measured: scratch exact-rational sweep divtr3.py, 200,000 quotients, 3.4.1 SYM4 tree, 2026-11-01]
test_group("3.4.1 SYM4: dual_div where q leaves the doubles");
# Both move: q subnormal (the 88-orders row, here at the shown literals).
assert_eq(Dual_deriv(dual_div(dual_new(0x00000000000015F6, 0x947F16600DFFB97A),
      dual_new(0x47BCE3922C2AF443, 0xF0F8379B0E8C53F0))), 0x1F04645F2CD5DD7D,
  "dual_div: a subnormal, q subnormal, both move: the exact quotient rule (s19: -1.5e-247)");
# A constant a: q underflows to zero, overflows, is subnormal.
assert_eq(Dual_deriv(dual_div(dual_const(0x895D6C5309E4A680), dual_new(0x4EBD1F811DED024A, 0x6CE2E9D7B38371F7))),
  0x18B4FEF6CDB011A9, "dual_div: constant a, q underflows to 0 (s19: -0): 1 ulp above the exact ...A8");
assert_eq(Dual_deriv(dual_div(dual_const(0xF64D1075A2933AB9), dual_new(0xB2B77C116F721183, 0x1F6AB0B9AEEDF44E))),
  0x7036811B330FC715, "dual_div: constant a, q overflows (s19: +Inf)");
assert_eq(Dual_deriv(dual_div(dual_const(0x800000FC97A73A9F), dual_new(0x410DE84000000000, 0x5ACCBCD65D6613D5))),
  0x17F03B2C5CF939A8, "dual_div: constant a, q subnormal (s19: 0.3% off): 1 ulp below the exact ...A9");
# a' - q b' overflows with q b' finite.
assert_eq(Dual_deriv(dual_div(dual_new(F64_ONE, 0x7FEAB36D48E1ACF0),
      dual_new(0x4010000000000000, 0xFFEE42D130773B76))),
  0x7FD12210CA7FBDE7, "dual_div: a' - q b' overflows, the derivative does not: 4.8125e307 (3.4.0 to s23: +Inf)");
# The review's program: 5e-324 / ln(x) at x = 1e-300.
var _s4d_ln = dual_ln(dual_var(0x01A56E1FC2F8F359));
var _s4d_q = dual_div(dual_const(1), _s4d_ln);
assert_eq(Dual_val(_s4d_q), 0x8000000000000000, "dual_div: 5e-324 / ln(1e-300): the value underflows to -0");
assert_eq(Dual_deriv(_s4d_q), 0xB9EA402BAB8ADFB3,
  "dual_div: ... the derivative is -1.0354062210806e-29, not -0: 1 ulp past the exact ...B2");
# The result's own range is kept: a derivative past DBL_MAX is an infinity, below 2^-1074 a zero.
assert_eq(Dual_deriv(dual_div(dual_const(0x7FE0000000000000), dual_new(0x2000000000000000, 0xFFE0000000000000))),
  F64_POS_INF, "dual_div: -a b' / b^2 past DBL_MAX, with q overflowed: +Inf, not a wrong finite");
var _s4d_small = Dual_deriv(dual_div(dual_const(0x0010000000000000), dual_new(0x7FE0000000000000, 0x0010000000000000)));
assert_eq(_s4d_small, 0x8000000000000000, "dual_div: -a b' / b^2 below 2^-1074: the moving zero, -0");
# In the subnormals: -a b' / b^2 = -2^-1022 2^1 / 2^4 = -2^-1025, exact and subnormal.
assert_eq(Dual_deriv(dual_div(dual_const(0x0010000000000000), dual_new(0x4010000000000000, F64_TWO))),
  0x8002000000000000, "dual_div: an exact subnormal derivative, q subnormal");
# A zero a or b' takes no extended path: the ordinary form stands. A moving zero a is an exact q:
assert_eq(Dual_deriv(dual_div(dual_new(0, F64_ONE), dual_new(F64_TWO, 0x7FEFFFFFFFFFFFFF))), F64_HALF,
  "dual_div: a = 0 moving, b' = DBL_MAX: a' / b = 0.5 (q b' is 0 exactly)");
# A moving zero b' may be an underflow, so q * 0 stays NaN where q overflowed: no finite answer is
# known. 1 / (1 / x) at 1e300 is the program: b' = -1e-600 = -0 for the derivative 1.
var _s4d_mz = Dual_deriv(dual_div(dual_new(0x7FE0000000000000, F64_ONE), dual_new(F64_HALF, 0x8000000000000000)));
assert_eq(f64_eq(_s4d_mz, _s4d_mz), 0, "dual_div: b' a moving zero, q overflowed: NaN, as IEEE, not a' / b");
var _s4d_ix = dual_var(0x7E37E43C8800759C);
var _s4d_ii = dual_div(dual_const(F64_ONE), dual_div(dual_const(F64_ONE), _s4d_ix));
assert_eq(f64_eq(Dual_deriv(_s4d_ii), Dual_deriv(_s4d_ii)), 0,
  "dual_div: 1 / (1 / x) at 1e300 is NaN, not a fabricated 0 (true: 1)");
# (1000 x) / (1000 x') at 1e-300, two handles: the cancellation stays exact.
var _s4d_a = dual_mul(dual_const(0x408F400000000000), dual_var(0x01A56E1FC2F8F359));
var _s4d_b = dual_mul(dual_const(0x408F400000000000), dual_var(0x01A56E1FC2F8F359));
assert_eq(Dual_deriv(dual_div(_s4d_a, _s4d_b)), 0x8000000000000000,
  "dual_div: an exact cancellation is a moving zero, not a rounding");
# A non-finite tangent keeps its term's sign where q underflowed: a' = 0 const, a > 0, b' = +Inf.
assert_eq(Dual_deriv(dual_div(dual_const(F64_ONE), dual_new(0x7FE0000000000000, F64_POS_INF))), 0xFFF0000000000000,
  "dual_div: b' = +Inf with -q / b underflowed: -Inf, not 0 * Inf = NaN");
assert_eq(Dual_deriv(dual_div(dual_new(0x0010000000000000, 0x3FF0000000000000),
      dual_new(0x7FE0000000000000, F64_POS_INF))),
  0xFFF0000000000000, "dual_div: the same, both move");
assert_eq(Dual_deriv(dual_div(dual_new(0x7FE0000000000000, F64_POS_INF),
      dual_new(0x0010000000000000, 0x7FE0000000000000))),
  F64_POS_INF, "dual_div: a' = +Inf, q overflowed: a' / b, not Inf - Inf");
# Extreme operands stay IEEE: an infinite a over a moving b is +Inf with the split form's sign.
var _s4d_ia = dual_div(dual_new(F64_POS_INF, F64_ONE), dual_new(F64_TWO, F64_ONE));
assert_eq(Dual_val(_s4d_ia), F64_POS_INF, "dual_div: an infinite a: the value +Inf");
assert_eq(Dual_deriv(_s4d_ia), 0xFFF0000000000000, "dual_div: ... a' / b - (q / b) b' is -Inf");
# Each test of the far path, on its own. q b' subnormal with q and a' - q b' in range:
assert_eq(Dual_deriv(dual_div(dual_new(0x0034CCCCCCCCCCCD, 1), dual_new(0x03F199999999999A, 0x017B333333333333))),
  0xB9BD38E58DC08766, "dual_div: q b' subnormal: the exact quotient rule (the plain form keeps 14 bits)");
# q subnormal with q b' and a' - q b' in range, both move:
assert_eq(Dual_deriv(dual_div(dual_new(0x0174CCCCCCCCCCCD, 0x1CF0000000000000),
      dual_new(0x43B199999999999A, 0x5F3B333333333333))),
  0x992D5AF9A723F787, "dual_div: q subnormal, both move: 1 ulp from the exact ...788");
# -q / b underflows to 0 with q normal; overflows with q normal; q subnormal with -q / b normal:
assert_eq(Dual_deriv(dual_div(dual_const(F64_ONE), dual_new(0x7E70000000000000, 0x7E70000000000000))),
  0x8170000000000000, "dual_div: constant a, -q / b underflows to 0: -2^-1000");
assert_eq(Dual_deriv(dual_div(dual_const(0x7830000000000000), dual_new(0x39B0000000000000, 0x20B0000000000000))),
  0xE570000000000000, "dual_div: constant a, -q / b overflows: -2^600");
assert_eq(Dual_deriv(dual_div(dual_const(5), dual_new(0x3D7199999999999A, 0x3EBB333333333333))),
  0x80BC19637021D9EA, "dual_div: constant a, q subnormal, -q / b normal: 1 ulp from the exact ...9E9");
# A term far below a': the alignment must not lift it. a / b is 1.5e-323, b' = 1:
assert_eq(Dual_deriv(dual_div(dual_new(3, F64_ONE), dual_new(0x3FF199999999999A, F64_ONE))), 0x3FED1745D1745D17,
  "dual_div: q subnormal, a' dominates: 1 / 1.1");
# A derivative in the top binade, through the far path:
assert_eq(Dual_deriv(dual_div(dual_new(F64_ONE, 0x7FEAB36D48E1ACF0), dual_new(0x3FF8000000000000, 0xFFEE42D130773B76))),
  0x7FEF3FFB29AEFF7F, "dual_div: a' - q b' overflows, the derivative is 1.7556e308");
# An exact cancellation at far exponents: a = 2^1000, b = 2^-100, b' = 2^-200, a' = 2^900 = q b'.
assert_eq(Dual_deriv(dual_div(dual_new(0x7E70000000000000, 0x7830000000000000),
      dual_new(0x39B0000000000000, 0x3370000000000000))),
  0x8000000000000000, "dual_div: q overflowed, a' - q b' cancels exactly: the moving zero, not a stray exponent");
# No exponent of a zero may reach the extended sum, at far exponents.
assert_eq(Dual_deriv(dual_div(dual_new(0, F64_ONE), dual_new(0x0170000000000000, 0x7FE0000000000000))),
  0x7E70000000000000, "dual_div: a a moving zero, b = 2^-1000, b' = 2^1023: a' / b = 2^1000");
var _s4d_zi = Dual_deriv(dual_div(dual_new(0, F64_ONE), dual_new(F64_TWO, F64_POS_INF)));
assert_eq(f64_eq(_s4d_zi, _s4d_zi), 0, "dual_div: a a moving zero, b' = +Inf: 0 * Inf, IEEE's NaN");
# Forward differs from the tape exactly where the tape's partial cannot hold the value.
var _s4d_t = ad_tape_new(16);
var _s4d_v = ad_var(_s4d_t, 0x4EBD1F811DED024A);
var _s4d_r = ad_div(_s4d_t, ad_const(_s4d_t, 0x895D6C5309E4A680), _s4d_v);
assert_eq(load64(_ad_node(_s4d_t, _s4d_r) + 8), 0x0000000000000000,
  "ad_div: the tape's partial -q / b is 0 there: the documented limit");
# Helpers, directly: the exponent and significand of a subnormal, and the placing of a result.
assert_eq(_ad_xe(1), 0 - 1074, "_ad_xe: 2^-1074");
assert_eq(_ad_xm(1), F64_ONE, "_ad_xm: its significand is 1");
assert_eq(_ad_xe(0x8000000000000003), 0 - 1073, "_ad_xe: -3 * 2^-1074");
assert_eq(_ad_xm(0x8000000000000003), 0xBFF8000000000000, "_ad_xm: -1.5");
assert_eq(_ad_xe(F64_TWO), 1, "_ad_xe: a normal");
assert_eq(_ad_off(0) < 0, 1, "_ad_off: a zero");
assert_eq(_ad_off(1) < 0, 1, "_ad_off: a subnormal");
assert_eq(_ad_off(F64_POS_INF) < 0, 1, "_ad_off: an infinity");
assert_eq(_ad_off(0x7FF8000000000000) < 0, 1, "_ad_off: a NaN");
assert_eq(_ad_off(0x0010000000000000) < 0, 0, "_ad_off: DBL_MIN is in range");
assert_eq(_ad_off(0x7FEFFFFFFFFFFFFF) < 0, 0, "_ad_off: DBL_MAX is in range");
assert_eq(_ad_off(0x8010000000000000) < 0, 0, "_ad_off: the sign does not matter");

# === 3.4.1 SYM4: ad_div's partial where q leaves the doubles ===
# Finding 1 of the pass. d/db = -q / b kept q's lost bits where q is subnormal: seven of 200,000
# quotients went from within 1 ulp on 3.4.0 to more than 4. Each expected partial is the exact
# -a / b^2 of the doubles shown, correctly rounded with Python's Fraction, unless it says so.
# [measured: scratch exact-rational sweep tapefar.py, 200,000 quotients, 3.4.1 SYM4 tree, 2026-11-01]
test_group("3.4.1 SYM4: ad_div's partial where q leaves the doubles");
fn _s4b_pb(a, b) {
    var t = ad_tape_new(8);
    var v = ad_var(t, b);
    var r = ad_div(t, ad_const(t, a), v);
    var gt, gv = ad_grad(t, r);
    return ad_grad_of(t, v);
}
fn _s4b_both(a, b) {
    var t = ad_tape_new(8);
    var u = ad_var(t, a);
    var v = ad_var(t, b);
    var r = ad_div(t, u, v);
    var gt, gv = ad_grad(t, r);
    return ad_grad_of(t, v);
}
assert_eq(_s4b_pb(0x8000000000000001, 0x3E4160BB9538ED14), 0x002B20708B16C8D5,
  "ad_div: a = -5e-324, q subnormal: d/db is -a / b^2 (s23: 8.3e-9 relative off)");
assert_eq(_s4b_pb(0x8000000000060A0E, 0xBE76FAFD787D6B13), 0x00E76BAE42A41FA7,
  "ad_div: a subnormal, q subnormal: d/db is -a / b^2, 1 ulp from the exact ...FA6");
assert_eq(_s4b_both(0x0000000000011649, 0x3ED3AA7E480492D8), 0x800B834273E13E2F,
  "ad_div: both move, q subnormal: d/db is -a / b^2");
# q out of range with a partial out of range, and q in range: the plain form is the exact one.
assert_eq(_s4b_pb(1, 0x7E70000000000000), 0x8000000000000000, "ad_div: 5e-324 / 2^1000: -a / b^2 underflows: -0");
assert_eq(_s4b_pb(0x7FE0000000000000, 0x2000000000000000), 0xFFF0000000000000,
  "ad_div: 2^1023 / 2^-511: q overflows, and so does -a / b^2 = -2^2045: -Inf");
assert_eq(_s4b_pb(0x7FE0000000000000, 0x7E70000000000000), 0x82E0000000000000, "ad_div: q = 2^23 in range: -2^-977");
# An infinite or zero operand takes the plain form: a zero a is an exact q.
assert_eq(_s4b_both(0, F64_TWO), 0x8000000000000000, "ad_div: a moving zero a over 2: d/db = -0 / 2");
assert_eq(_s4b_both(0, 0x0170000000000000), 0x8000000000000000,
  "ad_div: a moving zero a over 2^-1000: -0, and no exponent of a zero reaches the far form");
assert_eq(_ad_div_db(0, F64_TWO, 0x8000000000000000), 0x8000000000000000, "_ad_div_db: a zero a keeps the plain form");
assert_eq(_ad_div_db(F64_POS_INF, F64_TWO, F64_ONE), F64_ONE, "_ad_div_db: an infinite a keeps the plain form");
assert_eq(_ad_div_db(F64_ONE, F64_POS_INF, F64_ONE), F64_ONE, "_ad_div_db: an infinite b keeps the plain form");

# === 3.4.1 SYM4: cx_div's slow path and exact zeros ===
# Round-2 review S3. A zero numerator has lost bits only where its plain term is itself zero or
# subnormal and the other part is not, so 0 / b, z / z and a real quotient keep Smith's fast
# path: the bits were the same, the cost x6.7 to x9.5 of 3.4.0. _cx_lost is tested directly: its
# wrong answer in the cheap direction is only a slowdown, which no quotient can show.
test_group("3.4.1 SYM4: cx_div's slow path and exact zeros");
assert_eq(_cx_lost(F64_ONE, 0, F64_ONE), 0, "_cx_lost: a normal numerator has lost nothing");
assert_eq(_cx_lost(0, F64_ONE, F64_ONE), 0, "_cx_lost: a zero beside a normal plain term is an exact cancellation");
assert_eq(_cx_lost(0, 0, 0), 0, "_cx_lost: 0 / b has nothing to lose");
assert_eq(_cx_lost(0x8000000000000000, 0x8000000000000000, 0), 0, "_cx_lost: the same on -0");
assert_eq(_cx_lost(0, 0, F64_ONE), 1,
  "_cx_lost: a zero with plain term 0 and m != 0: the product may have underflowed");
assert_eq(_cx_lost(0, 1, F64_ONE), 1, "_cx_lost: a zero with a subnormal plain term and m != 0");
assert_eq(_cx_lost(1, F64_ONE, F64_ONE), 1, "_cx_lost: a subnormal numerator");
assert_eq(_cx_lost(0x8000000000000001, F64_ONE, F64_ONE), 1, "_cx_lost: a negative subnormal numerator");
# The repro of SYM3 that needs a zero numerator to go slow: ar = 0, ai * rb underflowed.
var _s4c_q = cx_div(cx_new(0, 0x7E70000000000000), cx_new(0x4630000000000000, 0x0170000000000000));
assert_eq(HComplex_re(_s4c_q), 0x3370000000000000,
  "cx_div: 0 + 2^1000 i over 2^100 + 2^-1000 i: 2^-200, still the slow path");
# Exact-zero families keep their bits: 0 / b, z / z, 2 z / z, i z / z, in both Smith's branches.
var _s4c_b1 = cx_new(0x4008000000000000, 0x4000000000000000);
var _s4c_b2 = cx_new(0x4000000000000000, 0x4008000000000000);
assert_eq(HComplex_re(cx_div(cx_new(0, 0), _s4c_b1)) | HComplex_im(cx_div(cx_new(0, 0), _s4c_b1)), 0,
  "cx_div: 0 / (3 + 2i) = 0 + 0i");
assert_eq(HComplex_re(cx_div(_s4c_b1, _s4c_b1)), F64_ONE, "cx_div: z / z = 1, |br| > |bi|");
assert_eq(HComplex_im(cx_div(_s4c_b1, _s4c_b1)), 0, "cx_div: ... + 0i");
assert_eq(HComplex_re(cx_div(_s4c_b2, _s4c_b2)), F64_ONE, "cx_div: z / z = 1, |bi| > |br|");
assert_eq(HComplex_im(cx_div(_s4c_b2, _s4c_b2)), 0, "cx_div: ... + 0i");
assert_eq(HComplex_re(cx_div(cx_new(0x4018000000000000, 0x4010000000000000), _s4c_b1)), F64_TWO, "cx_div: 2z / z = 2");
assert_eq(HComplex_re(cx_div(cx_new(0xC000000000000000, 0x4008000000000000), _s4c_b1)), 0,
  "cx_div: i z / z, real part +0");
assert_eq(HComplex_im(cx_div(cx_new(0xC000000000000000, 0x4008000000000000), _s4c_b1)), F64_ONE, "cx_div: i z / z = i");
# A zero numerator beside a subnormal plain term, both branches: Smith's m * ratio underflowed.
# 2^-600 i over 2^-500 + 2^-1000 i: ai * rb = 2^-1100 underflows beside ar = 0, and the numerator
# is 0 with a normal ratio and denominator, so only _cx_lost sends it slow. The exact parts,
# correctly rounded: real 2^-600, imaginary 2^-100; the mirror in the other Smith branch.
var _s4c_q2 = cx_div(cx_new(0, 0x1A70000000000000), cx_new(0x20B0000000000000, 0x0170000000000000));
assert_eq(HComplex_re(_s4c_q2), 0x1A70000000000000,
  "cx_div: |br| > |bi|: a zero numerator that lost its bits: real part 2^-600 (fast path: 0)");
assert_eq(HComplex_im(_s4c_q2), 0x39B0000000000000, "cx_div: ... imaginary part 2^-100");
var _s4c_q3 = cx_div(cx_new(0x1A70000000000000, 0), cx_new(0x0170000000000000, 0x20B0000000000000));
assert_eq(HComplex_re(_s4c_q3), 0x1A70000000000000, "cx_div: |bi| > |br|: the same: real part 2^-600 (fast path: 0)");
assert_eq(HComplex_im(_s4c_q3), 0xB9B0000000000000, "cx_div: ... imaginary part -2^-100");

# === 3.4.1 SYM4: the sweep's TwoSum at DBL_MAX ===
# Round-2 review S4. f(x) = DBL_MAX x - 3 * 2^970 x is linear: its derivative is the two partials'
# sum, 7FEFFFFFFFFFFFFE. TwoSum's u - s overflowed for the contribution DBL_MAX and the term was
# NaN, though u is finite. The term is dropped there, so the adjoint is the plain sum.
test_group("3.4.1 SYM4: the sweep's TwoSum at DBL_MAX");
fn _s4t_lin(k, s) {
    var t = ad_tape_new(16);
    var x = ad_var(t, F64_ONE);
    var r = ad_add(t, ad_mul(t, ad_const(t, k), x), ad_mul(t, ad_const(t, s), x));
    var gt, gv = ad_grad(t, r);
    return ad_grad_of(t, x);
}
assert_eq(_s4t_lin(0x7FEFFFFFFFFFFFFF, 0xFCA8000000000000), 0x7FEFFFFFFFFFFFFE, "tape: DBL_MAX - 3 * 2^970 (s19: NaN)");
assert_eq(_s4t_lin(0xFFEFFFFFFFFFFFFF, 0x7CA8000000000000), 0xFFEFFFFFFFFFFFFE, "tape: the mirror");
assert_eq(_s4t_lin(0xFCA8000000000000, 0x7FEFFFFFFFFFFFFF), 0x7FEFFFFFFFFFFFFE,
  "tape: the other order, u - s finite: the same sum");
assert_eq(_s4t_lin(0x7FEFFFFFFFFFFFFE, 0xFCA8000000000000), 0x7FEFFFFFFFFFFFFC, "tape: one ulp below DBL_MAX");
assert_eq(Dual_deriv(dual_add(dual_mul(dual_const(0x7FEFFFFFFFFFFFFF), dual_var(F64_ONE)),
      dual_mul(dual_const(0xFCA8000000000000), dual_var(F64_ONE)))), 0x7FEFFFFFFFFFFFFE,
  "forward: the same sum, the oracle for the row");

# === 3.4.1 SYM4: sym_rewrite counts what it stores ===
# Round-2 review S6. The bound guards what makes the call fail: a walk stores nothing, so a no-op
# answers whatever its size as a tree; what a pass stores is metered; and a sharing template,
# the one rule that multiplies the tree without storing it, is bounded by what it adds to the input.
# [measured: scratch rewrite probes r2rw.cyr at the default ALLOC_MAX, 3.4.1 SYM4 tree, 2026-11-01]
test_group("3.4.1 SYM4: sym_rewrite counts what it stores");
var _s4r_keep = ALLOC_MAX;
var _s4r_x = expr_var(str_from("x"));
var _s4r_y = expr_var(str_from("y"));
var _s4r_a = pat_wildcard(str_from("a"));
var _s4r_sq = vec_new();
vec_push(_s4r_sq, sym_rule(pat_mul(_s4r_a, _s4r_a), pat_pow(_s4r_a, pat_const(F64_TWO))));
# y doubled 20 times by sharing: 41 nodes, 40 x 2^20 - 24 = 41,943,016 bytes as a tree.
# [measured: hand count, checked by the assertions below, 3.4.1 SYM4 tree, 2026-11-01]
var _s4r_d = _s4r_y;
for (var i = 0; i < 20; i = i + 1) { _s4r_d = expr_add(_s4r_d, _s4r_d); }
var _s4r_u0 = alloc_used();
ALLOC_MAX = 1024;
var _s4r_r0 = sym_rewrite(_s4r_d, _s4r_sq);
ALLOC_MAX = _s4r_keep;
assert_eq(_s4r_r0, _s4r_d, "sym_rewrite: a no-op on a 41.9 MB tree at ALLOC_MAX = 1,024 -> the input (s19: 0)");
assert_eq(alloc_used() - _s4r_u0, 152, "... allocating 152 bytes, the bindings vec");
# The derivative of a sin chain is deep and shared: a no-op needs its walk stacks, and those are
# stored (1,859,096 bytes here), so it answers below its size as a tree (2,908,816), not below them.
# [measured: scratch probe r2rw.cyr mode 5 and the boundary pair below, 3.4.1 SYM4 tree, 2026-11-01]
var _s4r_c = _s4r_x;
for (var i = 0; i < 600; i = i + 1) { _s4r_c = expr_sin(_s4r_c); }
var _s4r_dc = expr_diff(_s4r_c, str_from("x"));
ALLOC_MAX = 0x1C5D80;
var _s4r_r1 = sym_rewrite(_s4r_dc, _s4r_sq);
ALLOC_MAX = 0x1C5D7F;
var _s4r_r1b = sym_rewrite(_s4r_dc, _s4r_sq);
ALLOC_MAX = _s4r_keep;
assert_eq(_s4r_r1, _s4r_dc,
  "sym_rewrite: a no-op on the derivative of sin^600(x) at its stacks' 1,859,096 - 152 bytes -> the input");
assert_eq(_s4r_r1b, 0, "sym_rewrite: ... one byte below -> 0: the stacks are stored, the visits are not");
# The doubling rules of the review, at 1 MiB: refused, each by what bounds it.
# [measured: the assertions below, 3.4.1 SYM4 tree, 2026-11-01]
var _s4r_rd = vec_new();
vec_push(_s4r_rd, sym_rule(pat_sin(_s4r_a), pat_sin(pat_add(_s4r_a, _s4r_a))));
var _s4r_u1 = alloc_used();
ALLOC_MAX = 0x100000;
var _s4r_r2 = sym_rewrite(expr_sin(_s4r_x), _s4r_rd);
ALLOC_MAX = _s4r_keep;
assert_eq(_s4r_r2, 0, "sym_rewrite({sin(a) -> sin(a + a)}, sin(x)) at 1 MiB: 2^k as a tree for 2 nodes a pass -> 0");
assert_eq(alloc_used() - _s4r_u1 < 4096, 1, "... having stored under 4 KB: the sharing bound, not the meter");
var _s4r_rx = vec_new();
vec_push(_s4r_rx, sym_rule(pat_var(str_from("x")), pat_add(pat_var(str_from("x")), pat_var(str_from("x")))));
var _s4r_u2 = alloc_used();
ALLOC_MAX = 0x100000;
var _s4r_r3 = sym_rewrite(_s4r_x, _s4r_rx);
ALLOC_MAX = _s4r_keep;
assert_eq(_s4r_r3, 0, "sym_rewrite({x -> x + x}, x) at 1 MiB -> 0");
assert_eq(alloc_used() - _s4r_u2 <= 0x100000 + 152, 1, "... within ALLOC_MAX + 152 bytes");
# A sharing rule is held to what it adds, not to the input's size. {sin(a) -> cos(a + a)} on
# sin(D) with D = y doubled 10 times, 40,936 bytes as a tree: the input is 40,952, the result
# 40 + 2 x 40,936 = 81,912, so the rule adds 40,960: 0 at 40,959, answered at 40,960.
# [measured: hand count, checked by the boundary pair below, 3.4.1 SYM4 tree, 2026-11-01]
var _s4r_e = _s4r_y;
for (var i = 0; i < 10; i = i + 1) { _s4r_e = expr_add(_s4r_e, _s4r_e); }
var _s4r_rc = vec_new();
