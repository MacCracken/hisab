_N3O_P1 = 0x4024000000000000;
_N3O_P2 = 0x3FC0C30A66CF5D58;
_N3O_N = 0;
var _n3o_pt, _n3o_pv = ode_backward_euler_checked(&_n3o_vdp, f64_sub(0x3FF59CC2D52E3700, 0x3F773255DA4A870A),
  0x3FBFB632B2761280, 0x3F773255DA4A870A, 0x3DDB7CDFD9D7BDBB, 50, &_n3o_o);
assert_eq(_n3o_o, 0x3FC1CE9C3DE75D42, "backward Euler: Newton's step -> 3.4.0's bits");
