ALLOC_MAX = 40959;
var _s4r_r4 = sym_rewrite(expr_sin(_s4r_e), _s4r_rc);
ALLOC_MAX = 40960;
var _s4r_r5 = sym_rewrite(expr_sin(_s4r_e), _s4r_rc);
