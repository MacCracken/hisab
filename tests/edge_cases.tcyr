assert_eq(_s4r_r5 != 0, 1, "sym_rewrite: ... at ALLOC_MAX = 40,960 -> answered");
# Fired once on a large input it adds 24 bytes, so a limit far below the input answers: on
# D + sin(x), {sin(a) -> a + a}, D of 2^20 as above (s19: 0, the input is 41.9 MB as a tree).
# [measured: the assertions below, 3.4.1 SYM4 tree, 2026-11-01]
var _s4r_rt = vec_new();
vec_push(_s4r_rt, sym_rule(pat_sin(_s4r_a), pat_add(_s4r_a, _s4r_a)));
var _s4r_in = expr_add(_s4r_d, expr_sin(_s4r_x));
ALLOC_MAX = 1024;
var _s4r_r6 = sym_rewrite(_s4r_in, _s4r_rt);
ALLOC_MAX = _s4r_keep;
var _s4r_lf = 0;
var _s4r_rg = 0;
if (_s4r_r6 != 0) {
    _s4r_lf = expr_left(_s4r_r6);
    _s4r_rg = str_eq(expr_to_str(expr_right(_s4r_r6)), str_from("(x + x)"));
}
assert_eq(_s4r_lf, _s4r_d,
  "sym_rewrite: a sharing rule fired once on a 41.9 MB input at ALLOC_MAX = 1,024 -> answered, D kept");
assert_eq(_s4r_rg, 1, "sym_rewrite: ... and sin(x) -> x + x");
# All 50 passes over a large shared side: no last-pass measure refuses what the call stored.
# [measured: the assertion below, 3.4.1 SYM4 tree, 2026-11-01]
var _s4r_rs = vec_new();
vec_push(_s4r_rs, sym_rule(pat_var(str_from("x")), pat_sin(pat_var(str_from("x")))));
ALLOC_MAX = 22400;
var _s4r_r7 = sym_rewrite(expr_add(_s4r_d, _s4r_x), _s4r_rs);
ALLOC_MAX = _s4r_keep;
var _s4r_lf2 = 0;
if (_s4r_r7 != 0) { _s4r_lf2 = expr_left(_s4r_r7); }
assert_eq(_s4r_lf2, _s4r_d, "sym_rewrite: 50 passes beside a 41.9 MB tree at ALLOC_MAX = 22,400 -> answered");
# === 3.4.1 SYM4: sym_rewrite on a shared input ===
# A shared subtree walked once per parent made a walk's time the tree's: x doubled 60 times is 60
# nodes and 2^61 visits. Every case runs in a child process that the suite kills within seconds,
# so a regression fails its assertion here and does not hang the suite. The answer is checked by
# hand-derived shape, node by node, never by printing a tree of 2^60 leaves.
# [measured: scratch probes r2rw.cyr at the default ALLOC_MAX, 3.4.0, s23 and the SYM4 tree, 2026-11-01]
test_group("3.4.1 SYM4: sym_rewrite on a shared input");
fn _s4w_dbl(leaf, k) {
    var d = leaf;
    for (var i = 0; i < k; i = i + 1) { d = expr_add(d, d); }
    return d;
}
# Two nodes a level, each built from both of the level below: the walk needs its table to grow
# past the frame's 256 entries.
fn _s4w_ladder(leaf, k) {
    var l = leaf;
    var r = expr_sin(leaf);
    for (var i = 0; i < k; i = i + 1) {
        var a = expr_add(l, r);
        var b = expr_mul(r, l);
        l = a;
        r = b;
    }
    return expr_add(l, r);
}
fn _s4w_rule1(p, t) {
    var v = vec_new();
    vec_push(v, sym_rule(p, t));
    return v;
}
# 0 when e's leftmost, rightmost and alternating paths are k add nodes down to the variable name.
fn _s4w_chain(e, k, name) {
    var w = str_from(name);
    for (var side = 0; side < 3; side = side + 1) {
        var n = e;
        for (var i = 0; i < k; i = i + 1) {
            if (n == 0 || expr_tag(n) != EXPR_ADD) { return 1; }
            if (side == 0 || (side == 2 && (i & 1) == 0)) { n = expr_left(n); }
            else { n = expr_right(n); }
        }
        if (n == 0 || expr_tag(n) != EXPR_VAR) { return 2; }
        if (str_eq(expr_var_name(n), w) != 1) { return 3; }
    }
    return 0;
}
# The memo by itself, in a call block of its own: 0, or the step that failed.
fn _s4w_table() {
    var b: i64[13];
    var f: i64[768];
    _sx_call_open(&b, &f, 0x100000);
    store64(&b + _SX_B_ROOM, 0x100000);
    _sx_memo_open(&b);
    if (load64(&b + _SX_B_TAB) != &f) { return 1; }
    if (load64(&b + _SX_B_CAP) != 256) { return 2; }
    for (var i = 1; i <= 192; i = i + 1) {
        if (_sx_memo_put(&b, i * 4096, 16, i) != 0) { return 3; }
    }
    if (load64(&b) != 0x100000 || load64(&b + _SX_B_TAB) != &f) { return 4; }
    if (_sx_memo_put(&b, 193 * 4096, 16, 193) != 0) { return 5; }
    if (load64(&b + _SX_B_ROOM) != 0x100000 - 12288 || load64(&b) != 0x100000) { return 6; }
    if (load64(&b + _SX_B_CAP) != 512 || load64(&b + _SX_B_USED) != 193) { return 7; }
    for (var i = 1; i <= 193; i = i + 1) {
        var e = _sx_memo_get(&b, i * 4096, 16);
        if (e == 0) { return 8; }
        if (load64(e + 16) != i) { return 9; }
    }
    if (_sx_memo_get(&b, 4096, 24) != 0) { return 10; }
    if (_sx_memo_put(&b, 4096, 16, 77) != 0) { return 11; }
    if (load64(&b + _SX_B_USED) != 193) { return 12; }
    if (load64(_sx_memo_get(&b, 4096, 16) + 16) != 77) { return 13; }
    # one k1 under two k2's is two keys, also where the two start on one slot: about 1 in 256 k2's
    # does, and none may be read as the entry already there
    # [measured: mutant M3 of the 3.4.1 SYM4 pass, killed here, 2026-11-01]
    _sx_memo_set(&b, &f, 256);
    var s0 = _sx_memo_slot(&b, 0x7000, 8);
    store64(s0, 0x7000);
    store64(s0 + 8, 8);
    for (var j = 2; j < 5000; j = j + 1) {
        if (_sx_memo_slot(&b, 0x7000, j * 8) == s0) { return 18; }
    }
    _sx_memo_set(&b, load64(&b + _SX_B_TAB), load64(&b + _SX_B_CAP));
    for (var i = 1; i <= 193; i = i + 1) {
        if (_sx_memo_put(&b, i * 4096, 16, i) != 0) { return 19; }
    }
    # a table that cannot grow never refuses: it fills to 15/16 of its 512 and a new key then
    # takes its home slot, so the last key kept is there to read and the table never fills
    # [measured: the assertions below, 3.4.1 SYM5 tree, 2026-11-01]
    store64(&b + _SX_B_ROOM, 1000);
    var r = 0;
    var back = 0;
    for (var i = 194; i <= 2000 && r == 0; i = i + 1) {
        r = _sx_memo_put(&b, i * 4096, 16, i);
        if (load64(&b + _SX_B_USED) >= 480 && load64(&b + _SX_B_LOST) > 0) {
            var last = _sx_memo_get(&b, i * 4096, 16);
            if (last != 0) {
                if (load64(last + 16) != i) { return 21; }
                back = back + 1;
            }
        }
    }
    if (r != 0) { return 14; }
    if (back < 1000) { return 27; }
    if (load64(&b + _SX_B_ROOM) != 1000 || load64(&b + _SX_B_CAP) != 512) { return 15; }
    if (load64(&b + _SX_B_USED) != 480 || load64(&b + _SX_B_LOST) < 1000) { return 22; }
    # a slot is empty, so a probe for a key not there ends
    if (_sx_memo_get(&b, 0x7777000, 8) != 0) { return 23; }
    # a key the table holds is rewritten where it is, and costs no overwrite
    var o1 = _sx_memo_get(&b, 2000 * 4096, 16);
    var l0 = load64(&b + _SX_B_LOST);
    if (o1 != 0) {
        if (_sx_memo_put(&b, 2000 * 4096, 16, 5) != 0) { return 24; }
        if (load64(&b + _SX_B_LOST) != l0 || load64(o1 + 16) != 5) { return 25; }
    }
    # past _SX_MEMO_LOST overwrites the call is refused: a walk that has lost its memo still ends
    store64(&b + _SX_B_LOST, _SX_MEMO_LOST);
    if (_sx_memo_put(&b, 0x7777000, 8, 1) != 0 - 1) { return 26; }
    store64(&b + _SX_B_LOST, 0);
    # a growth past ALLOC_MAX: refused ahead of the room, which it leaves alone
    var keep = ALLOC_MAX;
    store64(&b + _SX_B_ROOM, 0x10000000);
    ALLOC_MAX = 1000;
    r = _sx_memo_grow(&b);
    ALLOC_MAX = keep;
    if (r != 0 - 1) { return 16; }
    if (load64(&b + _SX_B_ROOM) != 0x10000000) { return 17; }
    return 0;
}
fn _s4w_case(p) {
    var x = expr_var(str_from("x"));
    var y = expr_var(str_from("y"));
    var a = pat_wildcard(str_from("a"));
    var d = _s4w_dbl(y, 60);
    var r = 0;
    var u0 = 0;
    var n = 0;
    if (p == 1) {
        # a no-op, the review's rule: the input itself, and nothing stored but the bindings vec
        u0 = alloc_used();
        r = sym_rewrite(d, _s4w_rule1(pat_mul(a, a), pat_pow(a, pat_const(F64_TWO))));
        if (r != d) { return 1; }
        if (alloc_used() - u0 > 512) { return 2; }
        return 0;
    }
    if (p == 2) {
        # a rule firing at every use of one shared leaf: the first attempt stores what its 2^20
        # visits built, 40 MB at most, and the memo's walk the 61 nodes of the answer
        # [measured: this check, 3.4.1 SYM4 tree, 2026-11-01]
        u0 = alloc_used();
        r = sym_rewrite(d, _s4w_rule1(pat_var(str_from("y")), pat_var(str_from("z"))));
        if (alloc_used() - u0 > 0x2800000) { return 7; }
        return _s4w_chain(r, 60, "z");
    }
    if (p == 3) {
        # a rule that rebuilds an equal tree: the pass compares equal, so the input comes back
        r = sym_rewrite(d, _s4w_rule1(pat_var(str_from("y")), pat_var(str_from("y"))));
        if (r != d) { return 1; }
        return 0;
    }
    if (p == 4) {
        # a wildcard bound twice on a shared node at every level: a + a -> 2 a sixty times
        r = sym_rewrite(d, _s4w_rule1(pat_add(a, a), pat_mul(pat_const(F64_TWO), a)));
        for (var i = 0; i < 60; i = i + 1) {
            if (r == 0 || expr_tag(r) != EXPR_MUL) { return 1; }
            r = expr_right(r);
        }
        if (r != y && (r == 0 || expr_tag(r) != EXPR_VAR)) { return 2; }
        return 0;
    }
    if (p == 5) {
        # a sharing template fired once beside it: the input's tree is added up, not walked
        # [measured: this case, 3.4.1 SYM4 tree, 2026-11-01]
        r = sym_rewrite(expr_add(d, expr_sin(x)), _s4w_rule1(pat_sin(a), pat_add(a, a)));
        if (r == 0 || expr_left(r) != d) { return 1; }
        if (str_eq(expr_to_str(expr_right(r)), str_from("(x + x)")) != 1) { return 2; }
        return 0;
    }
    if (p == 6) {
        # the doubling-by-sharing rule: refused by its tree, having stored almost nothing
        u0 = alloc_used();
        r = sym_rewrite(expr_sin(x), _s4w_rule1(pat_sin(a), pat_sin(pat_add(a, a))));
        if (r != 0) { return 1; }
        if (alloc_used() - u0 > 8192) { return 2; }
        return 0;
    }
    if (p == 7) {
        # 1,000 shared levels, past the recursion's 256 and the frame's table
        # [measured: this case, 3.4.1 SYM4 tree, 2026-11-01]
        var l7 = _s4w_ladder(y, 1000);
        r = sym_rewrite(l7, _s4w_rule1(pat_ln(a), a));
        if (r != l7) { return 1; }
        return 0;
    }
    if (p == 8) {
        # sin(D) + sin(D') with D and D' built apart: a comparison of 2^60 pairs, equal
        var d2 = _s4w_dbl(expr_var(str_from("y")), 60);
        r = sym_rewrite(expr_add(expr_sin(d), expr_sin(d2)),
          _s4w_rule1(pat_add(pat_sin(a), pat_sin(a)), pat_cos(a)));
        if (r == 0 || expr_tag(r) != EXPR_COS) { return 1; }
        if (expr_child(r) != d) { return 2; }
        return 0;
    }
    if (p == 9) {
        # the same with one leaf different, reached last: not equal, so the rule does not fire
        var dz = expr_add(_s4w_dbl(expr_var(str_from("y")), 59), _s4w_dbl(expr_var(str_from("z")), 59));
        var d3 = expr_add(_s4w_dbl(expr_var(str_from("y")), 59), _s4w_dbl(expr_var(str_from("y")), 59));
        var e9 = expr_add(expr_sin(d3), expr_sin(dz));
        r = sym_rewrite(e9, _s4w_rule1(pat_add(pat_sin(a), pat_sin(a)), pat_cos(a)));
        if (r != e9) { return 1; }
        return 0;
    }
    if (p == 10) {
        # one pair compared twice in a walk, under two parents built apart: the second looks again
        var dq = expr_add(_s4w_dbl(expr_var(str_from("y")), 59), _s4w_dbl(expr_var(str_from("z")), 59));
        var dw = expr_add(_s4w_dbl(expr_var(str_from("y")), 59), _s4w_dbl(expr_var(str_from("y")), 59));
        var e10 = expr_mul(expr_add(expr_sin(dw), expr_sin(dq)), expr_add(expr_sin(dw), expr_sin(dq)));
        r = sym_rewrite(e10, _s4w_rule1(pat_add(pat_sin(a), pat_sin(a)), pat_cos(a)));
        if (r != e10) { return 1; }
        return 0;
    }
    if (p == 11) {
        # two rules on one memo: y -> v, then z -> w: an answer kept for one is not the other's
        var dy = _s4w_dbl(expr_var(str_from("y")), 60);
        var dz2 = _s4w_dbl(expr_var(str_from("z")), 60);
        var rs2 = vec_new();
        vec_push(rs2, sym_rule(pat_var(str_from("y")), pat_var(str_from("v"))));
        vec_push(rs2, sym_rule(pat_var(str_from("z")), pat_var(str_from("w"))));
        r = sym_rewrite(expr_add(dy, dz2), rs2);
        if (r == 0) { return 1; }
        if (_s4w_chain(expr_left(r), 60, "v") != 0) { return 2; }
        if (_s4w_chain(expr_right(r), 60, "w") != 0) { return 3; }
        return 0;
    }
    if (p == 12) {
        # squaring: y y, (y^2)(y^2), ... under {a a -> a^2}: y^2^2...^2, sixty times
        var m = y;
        for (var i = 0; i < 60; i = i + 1) { m = expr_mul(m, m); }
        r = sym_rewrite(m, _s4w_rule1(pat_mul(a, a), pat_pow(a, pat_const(F64_TWO))));
        for (var i = 0; i < 60; i = i + 1) {
            if (r == 0 || expr_tag(r) != EXPR_POW) { return 1; }
            r = expr_left(r);
        }
        if (r == 0 || expr_tag(r) != EXPR_VAR) { return 2; }
        return 0;
    }
    if (p == 13) {
        # a comparison that goes deep: two ladders 300 levels high, built apart, compared as a
        # bound wildcard: past the recursion, into the iterative form's count
        var l1 = _s4w_ladder(expr_var(str_from("y")), 300);
        var l2 = _s4w_ladder(expr_var(str_from("y")), 300);
        r = sym_rewrite(expr_add(expr_sin(l1), expr_sin(l2)),
          _s4w_rule1(pat_add(pat_sin(a), pat_sin(a)), pat_cos(a)));
        if (r == 0 || expr_tag(r) != EXPR_COS) { return 1; }
        return 0;
    }
    if (p == 14) {
        # a heap of garbage under the memo's blocks: a dirty heap, as after a caller's reset,
        # and two calls with a reset between them: nothing of the first is kept
        var b = alloc(0x400000);
        for (var i = 0; i < 0x400000; i = i + 8) { store64(b + i, 0xA5A5A5A5A5A5A5A5); }
        for (var j = 0; j < 2; j = j + 1) {
            alloc_reset();
            var yy = expr_var(str_from("y"));
            var l14 = _s4w_ladder(yy, 1000);
            r = sym_rewrite(l14, _s4w_rule1(pat_ln(pat_wildcard(str_from("a"))), pat_wildcard(str_from("a"))));
            if (r != l14) { return 1 + j; }
        }
        return 0;
    }
    if (p == 15) {
        # the table cannot grow to what the ladder would use: it answers all the same, in the
        # table it has (3.4.1 SYM5; SYM4 refused the call)
        var keep = ALLOC_MAX;
        var l15 = _s4w_ladder(y, 1000);
        ALLOC_MAX = 65536;
        r = sym_rewrite(l15, _s4w_rule1(pat_ln(a), a));
        ALLOC_MAX = keep;
        if (r != l15) { return 1; }
        return 0;
    }
    if (p == 16) { return _s4w_table(); }
    if (p == 17) {
        # every node rebuilt each pass, past the first attempt: 50 passes stay within this limit
        # [measured: scratch probe p17.cyr, the 3.4.1 SYM4 tree, 2026-11-01]
        var l17 = _s4w_ladder(x, 1000);
        var r17 = _s4w_rule1(pat_var(str_from("x")), pat_sin(pat_var(str_from("x"))));
        u0 = alloc_used();
        r = sym_rewrite(l17, r17);
        if (r == 0) { return 1; }
        if (alloc_used() - u0 > 55000000) { return 2; }
        return 0;
    }
    return 9;
}
# The child's exit status, or 200 once ten million polls find it still running, some seconds: it
# is killed, and the assertion fails. A poll and no sleep, because every pin has sys_waitpid.
fn _s4w_watch(p) {
    var pid = sys_fork();
    if (pid == 0) { sys_exit_group(_s4w_case(p)); }
    var st: i64[1];
    for (var t = 0; t < 10000000; t = t + 1) {
        if (sys_waitpid(pid, &st, 1) == pid) {
            if ((load64(&st) & 0x7F) != 0) { return 100 + (load64(&st) & 0x7F); }
            return (load64(&st) >> 8) & 0xFF;
        }
    }
    sys_kill(pid, 9);
    sys_waitpid(pid, &st, 0);
    return 200;
}
assert_eq(_s4w_watch(1), 0,
  "sym_rewrite: a no-op on x doubled 60 times: the input, 152 bytes (3.4.0: 0, the heap exhausted)");
assert_eq(_s4w_watch(2), 0, "sym_rewrite: {y -> z} on it: z doubled 60 times, each node stored once");
assert_eq(_s4w_watch(3), 0, "sym_rewrite: {y -> y} on it: a pass that compares equal: the input");
assert_eq(_s4w_watch(4), 0, "sym_rewrite: {a + a -> 2 a} on it: sixty 2's over y");
assert_eq(_s4w_watch(5), 0, "sym_rewrite: {sin(a) -> a + a} beside it: answered, the shared side kept");
assert_eq(_s4w_watch(6), 0, "sym_rewrite: {sin(a) -> sin(a + a)} on sin(x): refused by its tree, within 8 KB");
assert_eq(_s4w_watch(7), 0, "sym_rewrite: a no-op on a 1,000-level shared ladder: the input");
assert_eq(_s4w_watch(8), 0, "sym_rewrite: sin(D) + sin(D'), D' built apart, 2^60 pairs equal: the rule fires");
assert_eq(_s4w_watch(9), 0, "sym_rewrite: the same with one leaf different: the rule does not fire");
assert_eq(_s4w_watch(10), 0, "sym_rewrite: two rules, one pattern: the second comparison looks again");
assert_eq(_s4w_watch(11), 0, "sym_rewrite: two rules on one memo: each rule's own answers");
assert_eq(_s4w_watch(12), 0, "sym_rewrite: {a a -> a^2} on sixty squarings: y^2 sixty times");
assert_eq(_s4w_watch(13), 0, "sym_rewrite: two 300-level ladders compared: past the recursion, equal");
assert_eq(_s4w_watch(14), 0,
  "sym_rewrite: over a dirty heap, twice with alloc_reset between: nothing kept across calls");
assert_eq(_s4w_watch(15), 0, "sym_rewrite: a table that cannot grow: the input, in the table it has");
assert_eq(_s4w_watch(16), 0, "the memo alone: frame, growth, carried entries, keys, a refused growth");
assert_eq(_s4w_watch(17), 0, "sym_rewrite: 50 passes over a rebuilt ladder: within 55 MB");

# 3.4.1 SYM4: the marks' contract, as dual_new's comment states it. A caller's k * t launders a
# moving zero, dual_mul does not: (-x^2)^(1/3) at 0.
test_group("3.4.1 SYM4: dual_new's +0 is the constant mark");
var _s4n_u = dual_mul(dual_var(0), dual_var(0));
var _s4n_k = 0xBFF0000000000000;
var _s4n_l = dual_new(f64_mul(_s4n_k, Dual_val(_s4n_u)), f64_mul(_s4n_k, Dual_deriv(_s4n_u)));
assert_eq(Dual_deriv(_s4n_l), 0, "dual_new(k v, k t) with k < 0, t = -0 stores +0: a constant, as documented");
assert_eq(Dual_deriv(dual_pow(_s4n_l, 0x3FD5555555555555)), 0, "... so (-x^2)^(1/3) reads as a constant: +0");
var _s4n_m = dual_mul(_s4n_u, dual_const(_s4n_k));
assert_eq(Dual_deriv(_s4n_m), 0x8000000000000000, "dual_mul keeps the moving zero");
assert_eq(f64_eq(Dual_deriv(dual_pow(_s4n_m, 0x3FD5555555555555)), Dual_deriv(dual_pow(_s4n_m, 0x3FD5555555555555))), 0,
  "... and its derivative's NaN");

# === 3.4.1 NUM5: every continuation answer is certified ===
test_group("3.4.1 NUM5: every continuation answer is certified");
# The fourth review's M1. _ode_continue ran _ode_on_branch only where 8 times the last update was below 1/64
# of the move, and the last update says nothing of the point's accuracy. The five rows are the review's: each
# Ok, no certificate, past a root or a fold, where 3.4.0 refuses. tri(x) = |w - 2| - 1, w = x mod 4.
# [measured: scratch harness (NUM5-work p/od.cyr, p/rep.in, p/branch.py), s24, 3.4.0 and this tree, 2026-11-01]
var _N5O_A = 0;
var _N5O_B = 0;
var _N5O_D = 0;
var _N5O_N = 0;
fn _n5o_sin(t, y) {
    _N5O_N = _N5O_N + 1;
    return f64_add(f64_mul(_N5O_A, f64_sin(f64_mul(_N5O_B, y))), _N5O_D);
}
fn _n5o_tri(t, y) {
    _N5O_N = _N5O_N + 1;
    var x = f64_mul(_N5O_B, y);
    var w = f64_sub(x, f64_mul(f64_floor(f64_mul(x, 0x3FD0000000000000)), 0x4010000000000000));
    var v = f64_sub(f64_abs(f64_sub(w, F64_TWO)), F64_ONE);
    return f64_add(f64_mul(_N5O_A, v), _N5O_D);
}
var _n5o_o = 0x7FF8000000000001;
# Runs BDF-2 (kind 1) or backward Euler (kind 0, 8 updates) on family 0 (sin) or 4 (tri); returns the code.
fn _n5o_run(kind, fam, a, b, d, y, yp, dt, tol) {
    _N5O_A = a;
    _N5O_B = b;
    _N5O_D = d;
    _N5O_N = 0;
    var fp = &_n5o_sin;
    if (fam == 4) { fp = &_n5o_tri; }
    if (kind == 1) {
        var bt, bv = ode_bdf2_checked(fp, 0, y, yp, dt, tol, &_n5o_o);
        return bv;
    }
    var et, ev = ode_backward_euler_checked(fp, 0, y, dt, tol, 8, &_n5o_o);
    return ev;
}
assert_eq(_n5o_run(1, 4, 0xC011E591928D9E43, 0x400DED65CCAD5AEC, 0xC01FE09D4E92EA7E, 0x402CA83E742D1C8C,
    0x402C26767A627483, 0x3FD78B654F49D3E4, 0x3E45798EE2308C3A), HSB_ERR_NO_CONVERGENCE,
  "bdf2: tri, 1e-8: no Ok past the branch root 13.40 (s24: Ok 12.54, no certificate; 3.4.0: Err)");
assert_eq(_n5o_run(1, 4, 0xC0095BEC6478D7A6, 0x4023F04D5484D50A, 0xC0162BC2D0616D20, 0xC0203E52AC7F1DAC,
    0xC021F4F9DD00B56B, 0x3FCA316D79A0335D, 0x3E45798EE2308C3A), HSB_ERR_NO_CONVERGENCE,
  "bdf2: tri, 1e-8: no Ok past the branch root -8.21 (s24: Ok -8.54)");
assert_eq(_n5o_run(1, 4, 0x3FF12407E1ED12E3, 0x3FF202EA7850A1F3, 0xBFF689A26650F528, 0xC01CAA0BB073F248,
    0xC018F2718D4C7E9C, 0x401BE738C97A33ED, 0x3E45798EE2308C3A), HSB_ERR_NO_CONVERGENCE,
  "bdf2: tri, 1e-8: no Ok past the branch root -10.42 (s24: Ok -13.43)");
assert_eq(_n5o_run(0, 0, 0xC0137936DFC55D01, 0x40037FFFAFFB50C5, 0x3FCFD31CE2A923C0, 0x4031646152B0D7B4, 0,
    0x4020EE04D605E98B, 0x3FB999999999999A), HSB_ERR_NO_CONVERGENCE,
  "backward Euler: sin, tol 0.1: no Ok past the branch root 18.06 (s24: Ok 23.16)");
assert_eq(_n5o_run(0, 0, 0xBFF21B5855B95A54, 0x3FDF5FF8D473F085, 0xC00C23C23A9420E8, 0x40073DE546252648, 0,
    0x401E423E79B15C9E, 0x3F50624DD2F1A9FC), HSB_ERR_NO_CONVERGENCE,
  "backward Euler: sin, tol 1e-3: no Ok past a fold at sigma 0.376 (s24: Ok -25.26)");
assert_eq(_n5o_o, 0x7FF8000000000001, "... out untouched by all five");
# The band of the second test is tol: an answer with samples at 8 tol is past a fold of a 3-root equation
# (8 tol: Ok), and a right answer has samples above tol / 2 (tol / 2: NO_CONVERGENCE).
assert_eq(_n5o_run(1, 0, 0xBFFE992386AE1BC1, 0x4032CE6EFE068AEE, 0xC00E2C8D019C45FC, 0xC033E98D12CE45B8,
    0xC0347306E7154744, 0x3FC9746884F80C05, 0x3FB999999999999A), HSB_ERR_NO_CONVERGENCE,
  "bdf2: sin, tol 0.1: samples outside tol past a fold (band 8 tol: Ok on one of 3 real roots)");
assert_eq(_n5o_o, 0x7FF8000000000001, "... out untouched");
_n5o_o = 0x7FF8000000000001;
assert_eq(_n5o_run(0, 0, 0x401F962F7806B1C8, 0x40024247E24B77BE, 0x400598D7F7A55F64, 0x40327AD881CCC9DC, 0,
    0x3FCF60C8D274193B, 0x3FB999999999999A), 0, "backward Euler: sin, tol 0.1, samples between tol / 2 and tol -> Ok");
assert_eq(_n5o_o, 0x40321DDAFD2F66AA, "backward Euler: ... 0x40321DDAFD2F66AA, the only real root to tol");
assert_eq(_N5O_N, 101, "backward Euler: ... in 101 evaluations, 38 and the 63 samples");
_n5o_o = 0x7FF8000000000001;
# Past the root, and back: tol 0.1 on a triangle wave, 3 real roots. Every sample meets |g| < tol or the first
# test, but one with sigma >= 1 is followed by one back below 1, so the root was crossed twice.
assert_eq(_n5o_run(1, 4, 0xC004AF60847EACE8, 0x40206FF841DE7F92, 0xC011FAD124B80254, 0xC021713199D72D4E,
    0xC02168236384AA0E, 0x3FC81EA898F5964D, 0x3FB999999999999A), HSB_ERR_NO_CONVERGENCE,
  "bdf2: tri, tol 0.1: no Ok on the far side of a root crossed twice (no such test: Ok -9.06)");
assert_eq(_n5o_o, 0x7FF8000000000001, "... out untouched");
# Evenly spaced samples alias. Row one is the review's Ok at -84.70, 64.2 periods of sin from s, among 377
# real roots, which passed the certificate. Row two is built for it: s on a crest of the triangle wave
# and c f(s) about 64 periods, so that a first increment lands 64 periods on. Each sample's offset from its
# cell's edge is what refuses them. [measured: scratch harness (NUM5-work py/ga.py, py/cls.py), 2026-11-01]
assert_eq(_n5o_run(1, 0, 0xC02BAB62A56582DD, 0x40113178CFA0DD60, 0xC0132860871F0362, 0x4021AE8558E15964,
    0x401FD0CEEA4B8FDE, 0x402DE5FF36939680, 0x3F50624DD2F1A9FC), HSB_ERR_NO_CONVERGENCE,
  "bdf2: sin, a move of 64.2 periods: no Ok on the far root (even samples: Ok -84.70)");
assert_eq(_n5o_run(0, 4, 0x403B70C6C6F998ED, 0x40200D160F88998B, 0x40195E35C2E80D20, 0x403171BB87FC5AAF, 0,
    0x3FFDF9F8DE8C2A5A, 0x3F50624DD2F1A9FC), HSB_ERR_NO_CONVERGENCE,
  "backward Euler: tri, a landing whole periods on: no Ok on the far root (even samples: Ok 18.59)");
assert_eq(_n5o_o, 0x7FF8000000000001, "... out untouched by both");
# Right answers the first test alone refuses. tol 0.1: the root is passed by less than tol, so samples read
# sigma >= 1, and each meets |g| < tol as the answer does. One real root. With the gate these took 112
# evaluations; every Ok now pays exactly the 63 samples.
# [measured: scratch harness (NUM5-work p/odv.cyr, py/cls.py), row 1826 of the review's loose-tol set, 2026-11-01]
assert_eq(_n5o_run(1, 0, 0x4018503A4AA1E6AF, 0x4021FB5A1B2CEE78, 0x401FB7121E864C54, 0xC0141F82881637BA,
    0xC01711229073ACCF, 0x3FB567654CBE4F40, 0x3FB999999999999A), 0,
  "bdf2: sin, tol 0.1, an answer just past its root -> Ok (first test alone: NO_CONVERGENCE)");
assert_eq(_n5o_o, 0xC011E854AD7A6285, "bdf2: ... 0xC011E854AD7A6285, the only real root to tol");
assert_eq(_N5O_N, 175, "bdf2: ... in 175 evaluations, 112 and the 63 samples (s24, no certificate: 112)");
# A step with nothing to read: f(t + dt, y) = 0 and Newton's predictor leaves the domain, so the continuation's
# answer is y itself. Every sample is y, sigma is 0 / 0, and |g| = 0 meets tol: Ok, not a refusal.
fn _n5o_rest(t, y) {
    if (f64_eq(t, 0) == 1) { return F64_ONE; }
    if (f64_eq(y, 0) == 1) { return 0; }
    return 0x7FF8000000000000;
}
var _n5o_o2 = 0x7FF8000000000001;
var _n5o_t2, _n5o_v2 = ode_backward_euler_checked(&_n5o_rest, 0, 0, F64_ONE, 0x3E45798EE2308C3A, 3, &_n5o_o2);
assert_eq(is_ok(_n5o_t2), 1, "backward Euler: an answer at y, Newton out of the domain -> Ok (first test alone: Err)");
assert_eq(_n5o_o2, 0, "backward Euler: ... y exactly");
# Newton's answers are not read: its value and its 7 evaluations, as 3.4.0.
assert_eq(_n5o_run(1, 0, 0x401CCD119C1DA5E3, 0x3FDF750BC1AE4E07, 0xC001311B06ACE67C, 0xC031AE174C73942C,
    0xC031AA48AEA5D68F, 0x3FAFEC0EC755E990, 0x3D719799812DEA11), 0, "bdf2: a step Newton solves -> Ok");
assert_eq(_n5o_o, 0xC031F1C92712B6B2, "bdf2: ... 3.4.0's 0xC031F1C92712B6B2");
assert_eq(_N5O_N, 7, "bdf2: ... in 3.4.0's 7 evaluations");

# === 3.4.1 NUM5: the slope test on every landing ===
test_group("3.4.1 NUM5: the slope test on every landing");
# The fourth review's M3: f = A cos(w (x - m)) + b (x - m)^2 falls fast from x0 and rises to a stationary
# maximum at m, the first trial lands on it, and a screen on the step's two ends never asked the slope. Each
# run now reaches a point f'' > 0 says is a minimum; f'' is the closed form.
# Every landing with |g| < tol pays one gradient. What a 0 from the test cannot show is pinned after.
# [measured: scratch harness (NUM5-work p/op.cyr, py/gop.py, py/aop.py), s24, 3.4.0 and this tree, 2026-11-01]
var _N5P_A = 0;
var _N5P_W = 0;
var _N5P_B = 0;
var _N5P_M = 0;
var _N5P_NF = 0;
var _N5P_NG = 0;
fn _n5p_f(x) {
    _N5P_NF = _N5P_NF + 1;
    var u = f64_sub(load64(x), _N5P_M);
    return f64_add(f64_mul(_N5P_A, f64_cos(f64_mul(_N5P_W, u))), f64_mul(_N5P_B, f64_mul(u, u)));
}
fn _n5p_g(x, g) {
    _N5P_NG = _N5P_NG + 1;
    var u = f64_sub(load64(x), _N5P_M);
    var s = f64_neg(f64_mul(f64_mul(_N5P_A, _N5P_W), f64_sin(f64_mul(_N5P_W, u))));
    store64(g, f64_add(s, f64_mul(f64_mul(F64_TWO, _N5P_B), u)));
    return 0;
}
var _n5p_x0 = alloc(8);
var _n5p_ox = alloc(8);
var _n5p_of = alloc(8);
# Returns the code; the answer in _n5p_ox, the counts in _N5P_NF, _N5P_NG.
fn _n5p_run(solver, x0, tol) {
    store64(_n5p_x0, x0);
    _N5P_NF = 0;
    _N5P_NG = 0;
    if (solver == 0) {
        var bt, bv = opt_bfgs(&_n5p_f, &_n5p_g, _n5p_x0, 1, tol, 1000, _n5p_ox, _n5p_of);
        return bv;
    }
    var lt, lv = opt_lbfgs(&_n5p_f, &_n5p_g, _n5p_x0, 1, 5, tol, 1000, _n5p_ox, _n5p_of);
    return lv;
}
# 1 when f'' at the answer is positive: A w^2 cos(w u) < 2 b.
fn _n5p_min() {
    var u = f64_sub(load64(_n5p_ox), _N5P_M);
    var c = f64_mul(f64_mul(_N5P_A, f64_mul(_N5P_W, _N5P_W)), f64_cos(f64_mul(_N5P_W, u)));
    return f64_lt(c, f64_mul(F64_TWO, _N5P_B));
}
var _n5p_s = 0;
var _n5p_w483 = 0x401351EB851EB852;       # 4.83
for (_n5p_s = 0; _n5p_s <= 1; _n5p_s = _n5p_s + 1) {
    _N5P_A = F64_ONE;
    _N5P_W = _n5p_w483;
    _N5P_B = 0x3FF3333333333333;          # 1.2
    _N5P_M = 0xBFD0000000000000;          # -0.25
    assert_eq(_n5p_run(_n5p_s, F64_ONE, 0x3E45798EE2308C3A), 0, "qn: review row 1 -> Ok");
    assert_eq(_n5p_min(), 1, "qn: ... at a minimum (s24: x = -0.25, f'' = -20.9)");
    assert_eq(load64(_n5p_ox), 0x3FD5B144E69B824E, "qn: ... x = 0.33894");
    assert_eq(_N5P_NG, 9, "qn: ... 9 gradients, two of them the slope test's");
    _N5P_B = F64_TWO;
    assert_eq(_n5p_run(_n5p_s, F64_ONE, 0x3E45798EE2308C3A), 0, "qn: review row 2 -> Ok");
    assert_eq(_n5p_min(), 1, "qn: ... at a minimum (s24: x = -0.25, f'' = -19.3)");
    _N5P_A = F64_TWO;
    _N5P_B = 0x4008000000000000;          # 3
    _N5P_M = 0xBFE0000000000000;          # -0.5
    assert_eq(_n5p_run(_n5p_s, F64_TWO, 0x3E45798EE2308C3A), 0, "qn: review row 3 -> Ok");
    assert_eq(_n5p_min(), 1, "qn: ... at a minimum (s24: x = -0.5, f'' = -40.7)");
    assert_eq(load64(_n5p_ox), 0xBFF1328E3804CA59, "qn: ... x = -1.0748");
    _N5P_A = F64_ONE;
    _N5P_W = 0x4014000000000000;          # 5
    _N5P_B = 0x3FF8000000000000;          # 1.5
    _N5P_M = 0xBFD0000000000000;          # -0.25
    assert_eq(_n5p_run(_n5p_s, F64_ONE, 0x3E45798EE2308C3A), 0, "qn: review row 4 -> Ok");
    assert_eq(_n5p_min(), 1, "qn: ... at a minimum (s24: x = -0.25, f'' = -22)");
}
# A landing 1,500 ulps of x long, near 2^40: the shorter rungs round to alpha's point. The run then ends
# NO_CONVERGENCE, as on 3.4.0, tol being below g's rounding there, and not Ok on the maximum.
# [measured: scratch harness (NUM5-work py/gm.py row 2436), s24, 3.4.0 and this tree, 2026-11-01]
_N5P_A = 0x4012362C580BFD25;
_N5P_W = 0x4020EC6F6D0A469C;
_N5P_B = 0x4050924ECE1894B8;
_N5P_M = 0x4270239C2578FC58;
for (_n5p_s = 0; _n5p_s <= 1; _n5p_s = _n5p_s + 1) {
    var _n5p_rc = _n5p_run(_n5p_s, 0x4270239C2578F65B, 0x3DDB7CDFD9D7BDBB);
    assert_eq(_n5p_rc, HSB_ERR_NO_CONVERGENCE, "qn: a short landing on a maximum near 2^40: no Ok (short rungs: Ok)");
}
# And a step of 140 ulps of x: only 2^-5 of it moves x.
_N5P_A = 0x3FFC78925B6E3BBD;
_N5P_W = 0x4027C866E7C2E384;
_N5P_B = 0x4049C9EAF68B86B9;
_N5P_M = 0x42A07212D2A40D53;
for (_n5p_s = 0; _n5p_s <= 1; _n5p_s = _n5p_s + 1) {
    var _n5p_rc2 = _n5p_run(_n5p_s, 0x42A07212D2A40CC7, 0x3E45798EE2308C3A);
    assert_eq(_n5p_rc2, HSB_ERR_NO_CONVERGENCE, "qn: a landing of 140 ulps on a maximum: no Ok (top rung 2^-8: Ok)");
}
# A landing on a floor below the start stands: (|x| - 1)^2 outside [-1, 1] and 0 inside, from 3, a first trial on
# -0.75. Slope 0 at both points, but f fell, so the trial is no flat end.
fn _n5c_f(x) {
    var u = f64_sub(f64_abs(load64(x)), F64_ONE);
    if (f64_lt(u, 0) == 1) { return 0; }
    return f64_mul(u, u);
}
fn _n5c_g(x, g) {
    var a = load64(x);
    var u = f64_sub(f64_abs(a), F64_ONE);
    if (f64_lt(u, 0) == 1) {
        store64(g, 0);
        return 0;
    }
    var v = f64_mul(F64_TWO, u);
    if (f64_lt(a, 0) == 1) { v = f64_neg(v); }
    store64(g, v);
    return 0;
}
store64(_n5p_x0, 0x4008000000000000);
var _n5c_t1, _n5c_v1 = opt_bfgs(&_n5c_f, &_n5c_g, _n5p_x0, 1, 0x3E45798EE2308C3A, 1000, _n5p_ox, _n5p_of);
assert_eq(is_ok(_n5c_t1), 1, "opt_bfgs: a floor below the start -> Ok");
assert_eq(load64(_n5p_ox), 0xBFE8000000000000, "opt_bfgs: ... at the first trial, -0.75 (flat, no f clause: moved)");
var _n5c_t2, _n5c_v2 = opt_lbfgs(&_n5c_f, &_n5c_g, _n5p_x0, 1, 5, 0x3E45798EE2308C3A, 1000, _n5p_ox, _n5p_of);
assert_eq(is_ok(_n5c_t2), 1, "opt_lbfgs: a floor below the start -> Ok");
assert_eq(load64(_n5p_ox), 0xBFE8000000000000, "opt_lbfgs: ... at the first trial, -0.75");
# The first rung: a slope difference over too short a step on Wood reads as a maximum at the end of an
# ordinary run and takes 49 gradients. 43 here, 42 for the path and 1 for the test.
var _N5W_G = 0;
fn _n5w_f(x) {
    var a = load64(x);
    var b = load64(x + 8);
    var c = load64(x + 16);
    var d = load64(x + 24);
    var u1 = f64_sub(b, f64_mul(a, a));
    var u2 = f64_sub(F64_ONE, a);
    var u3 = f64_sub(d, f64_mul(c, c));
    var u4 = f64_sub(F64_ONE, c);
    var u5 = f64_sub(b, F64_ONE);
    var u6 = f64_sub(d, F64_ONE);
    var s = f64_add(f64_mul(0x4059000000000000, f64_mul(u1, u1)), f64_mul(u2, u2));
    s = f64_add(s, f64_add(f64_mul(0x4056800000000000, f64_mul(u3, u3)), f64_mul(u4, u4)));
    s = f64_add(s, f64_mul(0x4024333333333333, f64_add(f64_mul(u5, u5), f64_mul(u6, u6))));
    return f64_add(s, f64_mul(0x4033CCCCCCCCCCCD, f64_mul(u5, u6)));
}
fn _n5w_g(x, g) {
    _N5W_G = _N5W_G + 1;
    var a = load64(x);
    var b = load64(x + 8);
    var c = load64(x + 16);
    var d = load64(x + 24);
    var u1 = f64_sub(b, f64_mul(a, a));
    var u3 = f64_sub(d, f64_mul(c, c));
    var u5 = f64_sub(b, F64_ONE);
    var u6 = f64_sub(d, F64_ONE);
    store64(g, f64_sub(f64_mul(0xC079000000000000, f64_mul(a, u1)), f64_mul(F64_TWO, f64_sub(F64_ONE, a))));
    store64(g + 8, f64_add(f64_add(f64_mul(0x4069000000000000, u1), f64_mul(0x4034333333333333, u5)),
        f64_mul(0x4033CCCCCCCCCCCD, u6)));
    store64(g + 16, f64_sub(f64_mul(0xC076800000000000, f64_mul(c, u3)), f64_mul(F64_TWO, f64_sub(F64_ONE, c))));
    store64(g + 24, f64_add(f64_add(f64_mul(0x4066800000000000, u3), f64_mul(0x4034333333333333, u6)),
        f64_mul(0x4033CCCCCCCCCCCD, u5)));
    return 0;
}
var _n5w_x0 = alloc(32);
var _n5w_ox = alloc(32);
store64(_n5w_x0, 0xC008000000000000);
store64(_n5w_x0 + 8, 0xBFF0000000000000);
store64(_n5w_x0 + 16, 0xC008000000000000);
store64(_n5w_x0 + 24, 0xBFF0000000000000);
var _n5w_t, _n5w_v = opt_bfgs(&_n5w_f, &_n5w_g, _n5w_x0, 4, 0x3E45798EE2308C3A, 1000, _n5w_ox, _n5p_of);
assert_eq(is_ok(_n5w_t), 1, "opt_bfgs: Wood from (-3, -1, -3, -1) -> Ok");
assert_eq(_N5W_G, 43, "opt_bfgs: ... in 43 gradients (first rung 2^-26: 49)");
# The top rung: 2^-2 of a short last step reads rounding, and L-BFGS on Wood at tol 1e-14 is refused at its minimum.
store64(_n5w_x0, 0xC00AF62BEF330E35);
store64(_n5w_x0 + 8, 0xBFE98ADE52CFBD82);
store64(_n5w_x0 + 16, 0xC006E5F36558E366);
store64(_n5w_x0 + 24, 0xBFE9C82B70A02786);
var _n5w_t2, _n5w_v2 = opt_lbfgs(&_n5w_f, &_n5w_g, _n5w_x0, 4, 5, 0x3D06849B86A12B9B, 3000, _n5w_ox, _n5p_of);
assert_eq(is_ok(_n5w_t2), 1, "opt_lbfgs: Wood from a perturbed start, tol 1e-14 -> Ok (top rung 2^-2: NO_CONVERGENCE)");
# Rosenbrock from a perturbed start, tol 1e-15: a true minimum the test leaves standing.
# [measured: scratch harness (NUM5-work py4/tight.py), 2026-11-01]
fn _n5r_f(x) {
    var a = f64_sub(F64_ONE, load64(x));
    var b = f64_sub(load64(x + 8), f64_mul(load64(x), load64(x)));
    return f64_add(f64_mul(a, a), f64_mul(0x4059000000000000, f64_mul(b, b)));
}
fn _n5r_g(x, g) {
    var a = load64(x);
    var b = f64_sub(load64(x + 8), f64_mul(a, a));
    store64(g, f64_sub(f64_mul(0xC079000000000000, f64_mul(a, b)), f64_mul(F64_TWO, f64_sub(F64_ONE, a))));
    store64(g + 8, f64_mul(0x4069000000000000, b));
    return 0;
}
var _n5r_x0 = alloc(16);
var _n5r_ox = alloc(16);
store64(_n5r_x0, 0xBFF3D7947743B176);
store64(_n5r_x0 + 8, 0x3FF43FEC485D79DB);
var _n5r_t1, _n5r_v1 = opt_bfgs(&_n5r_f, &_n5r_g, _n5r_x0, 2, 0x3CD203AF9EE75616, 3000, _n5r_ox, _n5p_of);
assert_eq(is_ok(_n5r_t1), 1, "opt_bfgs: Rosenbrock at tol 1e-15 -> Ok");
# What the test cannot show, each pinned because the doc says so. x^3 - 1/4 from 1: f = 3/4, g = 3, so 4 |f| /
# |g| = 1 and the first trial is x = 0, a stationary inflection reached from above. The slope behind it is
# below 0, as a minimum's would be, so the trial stands, though f falls on past it.
fn _n5i_f(x) { return f64_sub(f64_mul(load64(x), f64_mul(load64(x), load64(x))), 0x3FD0000000000000); }
fn _n5i_g(x, g) {
    store64(g, f64_mul(0x4008000000000000, f64_mul(load64(x), load64(x))));
    return 0;
}
store64(_n5p_x0, F64_ONE);
var _n5i_t1, _n5i_v1 = opt_bfgs(&_n5i_f, &_n5i_g, _n5p_x0, 1, 0x3E45798EE2308C3A, 1000, _n5p_ox, _n5p_of);
assert_eq(is_ok(_n5i_t1), 1, "opt_bfgs: x^3 - 1/4 from 1 -> Ok: first-order information cannot prove a minimum");
assert_eq(load64(_n5p_ox), 0, "opt_bfgs: ... at the inflection x = 0, which is no minimum");
# x^2 - y^2 from (1, 0): one line is all the test reads, and along y = 0 the saddle is a minimum.
fn _n5s_f(x) {
    return f64_sub(f64_mul(load64(x), load64(x)), f64_mul(load64(x + 8), load64(x + 8)));
}
fn _n5s_g(x, g) {
    store64(g, f64_mul(F64_TWO, load64(x)));
    store64(g + 8, f64_neg(f64_mul(F64_TWO, load64(x + 8))));
    return 0;
}
store64(_n5r_x0, F64_ONE);
store64(_n5r_x0 + 8, 0);
var _n5s_t1, _n5s_v1 = opt_bfgs(&_n5s_f, &_n5s_g, _n5r_x0, 2, 0x3E45798EE2308C3A, 1000, _n5r_ox, _n5p_of);
assert_eq(is_ok(_n5s_t1), 1, "opt_bfgs: x^2 - y^2 from (1, 0) -> Ok: the test reads one line");
assert(f64_lt(f64_abs(load64(_n5r_ox)), 0x3E45798EE2308C3A), "opt_bfgs: ... at the saddle's x = 0 to tol");
assert_eq(load64(_n5r_ox + 8), 0, "opt_bfgs: ... and y = 0, the saddle, no minimum");

# === 3.4.1 SYM5: a miss reaches its own inputs and no others ===
# Through SYM4 the tape's mark was a NaN partial on every node above a moving miss, which reached
# every input joined to the miss: sin(x + sqrt(y)) at (1, 0) had df/dx = NaN. The mark is a word the
# sweep ignores now (_ad_tainted), the NaN stays on the miss's own edges, and an annihilator
# still reads the mark. Each row is judged per input, the other held: a closed form of the real
# function, and forward mode seeded on that input as the second code path.
# [measured: scratch three-input oracle judge3.py, 20,000 programs, 3.4.0, s23, s24 and the SYM5 tree, 2026-11-01]
test_group("3.4.1 SYM5: a miss reaches its own inputs and no others");
var _s5a_s = 0x3FE14A280FB5068C;    # cos(1)
fn _s5a_op(p, t, x, y) {
    if (p == 1) { return ad_sin(t, ad_add(t, x, ad_sqrt(t, y))); }
    if (p == 2) { return ad_add(t, ad_add(t, x, ad_sqrt(t, y)), ad_const(t, F64_ONE)); }
    if (p == 3) { return ad_mul(t, ad_mul(t, x, x), ad_exp(t, ad_sqrt(t, y))); }
    if (p == 4) { return ad_mul(t, ad_const(t, 0), ad_add(t, x, ad_sqrt(t, y))); }
    if (p == 5) { return ad_pow(t, ad_add(t, x, ad_sqrt(t, y)), 0); }
    if (p == 6) {
        var z6 = ad_add(t, x, ad_sqrt(t, y));
        return ad_sub(t, z6, z6);
    }
    if (p == 7) {
        var z7 = ad_add(t, x, ad_sqrt(t, y));
        return ad_div(t, z7, z7);
    }
    if (p == 8) { return ad_div(t, ad_const(t, 0), ad_add(t, x, ad_sqrt(t, y))); }
    if (p == 9) { return ad_pow(t, ad_mul(t, ad_sqrt(t, y), x), 0x3FD0000000000000); }
    if (p == 10) { return ad_pow(t, ad_mul(t, x, ad_sqrt(t, y)), 0x3FD0000000000000); }
    if (p == 11) { return ad_pow(t, ad_div(t, ad_sqrt(t, y), x), 0x3FD0000000000000); }
    return ad_mul(t, x, ad_cos(t, ad_sqrt(t, y)));
}
fn _s5a_fw(p, x, y) {
    if (p == 1) { return dual_sin(dual_add(x, dual_sqrt(y))); }
    if (p == 2) { return dual_add(dual_add(x, dual_sqrt(y)), dual_const(F64_ONE)); }
    if (p == 3) { return dual_mul(dual_mul(x, x), dual_exp(dual_sqrt(y))); }
    if (p == 4) { return dual_mul(dual_const(0), dual_add(x, dual_sqrt(y))); }
    if (p == 5) { return dual_pow(dual_add(x, dual_sqrt(y)), 0); }
    if (p == 6) {
        var z6 = dual_add(x, dual_sqrt(y));
        return dual_sub(z6, z6);
    }
    if (p == 7) {
        var z7 = dual_add(x, dual_sqrt(y));
        return dual_div(z7, z7);
    }
    if (p == 8) { return dual_div(dual_const(0), dual_add(x, dual_sqrt(y))); }
    if (p == 9) { return dual_pow(dual_mul(dual_sqrt(y), x), 0x3FD0000000000000); }
    if (p == 10) { return dual_pow(dual_mul(x, dual_sqrt(y)), 0x3FD0000000000000); }
    if (p == 11) { return dual_pow(dual_div(dual_sqrt(y), x), 0x3FD0000000000000); }
    return dual_mul(x, dual_cos(dual_sqrt(y)));
}
# 1 when the tape's df/dx at (x0, 0) and forward's, seed x, are dx bit for bit and df/dy is the
# mark, on a sweep from below the compensated sweep's buffer and from above it.
fn _s5a_row(p, x0, dx) {
    for (var pad = 0; pad < 2; pad = pad + 1) {
        var t = ad_tape_new(8192);
        var w = 0;
        if (pad == 1) {
            w = ad_var(t, F64_ONE);
            for (var i = 0; i < 5000; i = i + 1) { w = ad_neg(t, w); }
        }
        var x = ad_var(t, x0);
        var y = ad_var(t, 0);
        var r = _s5a_op(p, t, x, y);
        var gt, gv = ad_grad(t, r);
        if ((ad_grad_of(t, x) << 1) != (dx << 1)) { return 0; }
        if (ad_grad_of(t, y) != _AD_NAN) { return 0; }
        if (Dual_deriv(_s5a_fw(p, dual_new(x0, F64_ONE), dual_new(0, 0))) << 1 != dx << 1) { return 0; }
        if (_ad_missed(Dual_deriv(_s5a_fw(p, dual_new(x0, 0), dual_new(0, F64_ONE)))) != 1) { return 0; }
    }
    return 1;
}
assert_eq(_s5a_row(1, F64_ONE, _s5a_s), 1, "sin(x + sqrt(y)) at (1, 0): df/dx = cos(1), df/dy NaN (SYM4: df/dx NaN)");
assert_eq(_s5a_row(2, F64_ONE, F64_ONE), 1, "x + sqrt(y) + 1: df/dx = 1, df/dy NaN (SYM4: df/dx NaN)");
assert_eq(_s5a_row(3, F64_ONE, F64_TWO), 1, "x^2 exp(sqrt(y)): df/dx = 2, df/dy NaN");
assert_eq(_s5a_row(12, F64_ONE, F64_ONE), 1, "x cos(sqrt(y)): df/dx = 1, df/dy NaN");
# An annihilator above the join still reads the mark, and cuts x's path only: this is what the
# mark is for, and what SYM4's hand-on bought, in a word that no adjoint reads.
assert_eq(_s5a_row(4, F64_ONE, 0), 1, "0 (x + sqrt(y)): df/dx = 0, df/dy NaN");
assert_eq(_s5a_row(5, F64_ONE, 0), 1, "(x + sqrt(y))^0: df/dx = 0, df/dy NaN");
assert_eq(_s5a_row(6, F64_ONE, 0), 1, "z - z, z = x + sqrt(y): df/dx = 0, df/dy NaN");
assert_eq(_s5a_row(7, F64_ONE, 0), 1, "z / z: df/dx = 0, df/dy NaN");
assert_eq(_s5a_row(8, F64_ONE, 0), 1, "0 / (x + sqrt(y)): df/dx = 0, df/dy NaN");
# A miss's zero times an input it does not depend on is a constant zero along that input: f is 0
# along x whatever the fourth root's slope, which is +Inf at 0. Through SYM4 x kept an edge of
# partial 0, and the slope met it: Inf * 0 = NaN.
assert_eq(_s5a_row(9, 0x401C000000000000, 0), 1, "(sqrt(y) x)^(1/4) at (7, 0): df/dx = 0, df/dy NaN");
assert_eq(_s5a_row(10, 0x401C000000000000, 0), 1, "(x sqrt(y))^(1/4): the operands' other order");
assert_eq(_s5a_row(11, 0x401C000000000000, 0), 1, "(sqrt(y) / x)^(1/4): df/dx = 0, df/dy NaN");
# Beside a marked zero a MARKED operand keeps its edge, or its own miss would lose its NaN: forward
# seeded on z has sqrt(y) a constant zero and (1 + ln z) the mark, and the mark is not cut.
var _s5a_v = ad_tape_new(32);
var _s5a_vy = ad_var(_s5a_v, 0);
var _s5a_vz = ad_var(_s5a_v, 0);
var _s5a_vs = ad_sqrt(_s5a_v, _s5a_vy);
var _s5a_vb = ad_add(_s5a_v, ad_const(_s5a_v, F64_ONE), ad_ln(_s5a_v, _s5a_vz));
var _s5a_v1 = ad_mul(_s5a_v, _s5a_vs, _s5a_vb);
var _s5a_v2 = ad_mul(_s5a_v, _s5a_vb, _s5a_vs);
var _s5a_v3 = ad_div(_s5a_v, _s5a_vs, _s5a_vb);
var _s5a_vg, _s5a_vh = ad_grad(_s5a_v, _s5a_v1);
assert_eq(ad_grad_of(_s5a_v, _s5a_vz), _AD_NAN, "sqrt(y) (1 + ln z) at (0, 0): df/dz NaN, its own miss");
assert_eq(ad_grad_of(_s5a_v, _s5a_vy), _AD_NAN, "... and df/dy NaN");
var _s5a_vi, _s5a_vj = ad_grad(_s5a_v, _s5a_v2);
assert_eq(ad_grad_of(_s5a_v, _s5a_vz), _AD_NAN, "(1 + ln z) sqrt(y): the operands' other order");
var _s5a_vk, _s5a_vl = ad_grad(_s5a_v, _s5a_v3);
assert_eq(ad_grad_of(_s5a_v, _s5a_vz), _AD_NAN, "sqrt(y) / (1 + ln z): df/dz NaN");
assert_eq(_ad_missed(Dual_deriv(dual_mul(dual_sqrt(dual_new(0, 0)), dual_add(dual_const(F64_ONE),
          dual_ln(dual_var(0)))))), 1, "forward, seed z: the same NaN");
# The record: the tape holds one node per op whatever the path, so a tape sized for its program
# fits at a boundary too; a node above a miss is marked, and one beside it is not.
var _s5a_t = ad_tape_new(5);
var _s5a_x = ad_var(_s5a_t, F64_ONE);
var _s5a_y = ad_var(_s5a_t, 0);
var _s5a_m = ad_sqrt(_s5a_t, _s5a_y);
var _s5a_j = ad_add(_s5a_t, _s5a_x, _s5a_m);
var _s5a_k = ad_sin(_s5a_t, _s5a_j);
assert_eq(_s5a_k, 4, "x + sqrt(y) and its sine fit a tape of exactly 5 nodes");
assert_eq(_ad_tainted(_ad_node(_s5a_t, _s5a_x)), 0, "x is not marked");
assert_eq(_ad_tainted(_ad_node(_s5a_t, _s5a_m)), 1, "the miss is");
assert_eq(_ad_tainted(_ad_node(_s5a_t, _s5a_j)), 1, "a node with the miss in input 2 is");
assert_eq(_ad_tainted(_ad_node(_s5a_t, _s5a_k)), 1, "and one above that");
assert_eq(load64(_ad_node(_s5a_t, _s5a_j) + 8), F64_ONE, "its partials are the chain rule's: 1");
assert_eq(load64(_ad_node(_s5a_t, _s5a_j) + 16), F64_ONE, "... and 1");
# Input 2 alone marks a node, the miss on the left of a binary op marks it, and each kind of miss.
var _s5a_u = ad_tape_new(32);
var _s5a_ux = ad_var(_s5a_u, F64_TWO);
var _s5a_uy = ad_var(_s5a_u, 0);
assert_eq(_ad_tainted(_ad_node(_s5a_u, ad_add(_s5a_u, ad_ln(_s5a_u, _s5a_uy), _s5a_ux))), 1, "ln's miss, on the left");
assert_eq(_ad_tainted(_ad_node(_s5a_u, ad_div(_s5a_u, _s5a_ux, _s5a_uy))), 1, "x / y at y = 0");
assert_eq(_ad_tainted(_ad_node(_s5a_u, ad_div(_s5a_u, ad_const(_s5a_u, F64_ONE), _s5a_uy))), 1, "1 / y at y = 0");
assert_eq(_ad_tainted(_ad_node(_s5a_u, ad_div(_s5a_u, _s5a_uy, ad_const(_s5a_u, 0)))), 1, "y / 0");
assert_eq(_ad_tainted(_ad_node(_s5a_u, ad_mul(_s5a_u, _s5a_ux, _s5a_ux))), 0, "x x, with no miss, is not");
# The first node of a tape is index 0, which the mark writes as -2.
var _s5a_z = ad_tape_new(8);
var _s5a_z0 = ad_var(_s5a_z, 0);
var _s5a_zm = ad_sqrt(_s5a_z, _s5a_z0);
assert_eq(_ad_tainted(_ad_node(_s5a_z, _s5a_zm)), 1, "a miss on node 0 is marked");
var _s5a_zs = ad_sin(_s5a_z, _s5a_zm);
assert_eq(_ad_tainted(_ad_node(_s5a_z, _s5a_zs)), 1, "and the node above it");
var _s5a_zr = ad_mul(_s5a_z, ad_const(_s5a_z, 0), _s5a_zs);
var _s5a_zg, _s5a_zh = ad_grad(_s5a_z, _s5a_zr);
assert_eq(ad_grad_of(_s5a_z, _s5a_z0), _AD_NAN, "0 sin(sqrt(x)) at 0: not cut, the sweep reaches node 0");
# x / y at y = 0 has no value along either input, so the NaN goes on both edges.
var _s5a_d = ad_div(_s5a_u, _s5a_ux, _s5a_uy);
var _s5a_g1, _s5a_g2 = ad_grad(_s5a_u, ad_sin(_s5a_u, _s5a_d));
assert_eq(ad_grad_of(_s5a_u, _s5a_ux), _AD_NAN, "sin(x / y) at (2, 0): df/dx NaN, a pole in x's own path");
assert_eq(ad_grad_of(_s5a_u, _s5a_uy), _AD_NAN, "... and df/dy NaN");

# === 3.4.1 SYM5: the mark survives an ordinary NaN ===
# Two NaNs keep the first operand's bits on the hardware, so an ordinary NaN first dropped the mark
# of a miss second. o = x^0.5 - x^(1/3) at 0 is Inf - Inf, m = ln(x) at 0 is a miss. Each row is
# proved by its operand order: the other order passed on SYM4.
# [measured: tests/edge_cases.tcyr, this group; scratch probe p_ad.cyr, s24 and the SYM5 tree, 2026-11-01]
test_group("3.4.1 SYM5: the mark survives an ordinary NaN");
var _s5m_ord = 0xFFF8000000000000;
var _s5m_inf = 0x7FF0000000000000;
fn _s5m_on(d) { return _ad_missed(Dual_deriv(d)); }
var _s5m_x = dual_var(0);
var _s5m_o = dual_sub(dual_pow(_s5m_x, 0x3FE0000000000000), dual_pow(_s5m_x, 0x3FD5555555555555));
var _s5m_m = dual_ln(_s5m_x);
assert_eq(Dual_deriv(_s5m_o), _s5m_ord, "fixture: Inf - Inf, the machine's own NaN: unmarked");
assert_eq(_s5m_on(_s5m_m), 1, "fixture: the miss is marked");
assert_eq(_s5m_on(dual_add(_s5m_o, _s5m_m)), 1, "o + m carries the mark");
assert_eq(_s5m_on(dual_add(_s5m_m, _s5m_o)), 1, "m + o carries the mark");
assert_eq(_s5m_on(dual_sub(_s5m_o, _s5m_m)), 1, "o - m carries the mark");
assert_eq(_s5m_on(dual_sub(_s5m_m, _s5m_o)), 1, "m - o carries the mark");
assert_eq(_s5m_on(dual_mul(_s5m_o, _s5m_m)), 1, "o m carries the mark");
assert_eq(_s5m_on(dual_mul(_s5m_m, _s5m_o)), 1, "m o carries the mark");
assert_eq(_s5m_on(dual_mul(dual_add(_s5m_o, _s5m_m), dual_const(0))), 1, "0 (o + m): not cut (SYM4: +0)");
assert_eq(_s5m_on(dual_mul(dual_const(0), dual_add(_s5m_o, _s5m_m))), 1, "(o + m) 0: not cut");
assert_eq(_s5m_on(dual_pow(dual_add(_s5m_o, _s5m_m), 0)), 1, "(o + m)^0: not cut (SYM4: +0)");
var _s5m_s = dual_add(_s5m_o, _s5m_m);
assert_eq(_s5m_on(dual_sub(_s5m_s, _s5m_s)), 1, "(o + m) - (o + m): not cut");
assert_eq(_s5m_on(dual_div(_s5m_s, _s5m_s)), 1, "(o + m) / (o + m): a pole, marked");
# dual_mul and dual_div where the VALUE is NaN, which has its own return.
var _s5m_big = dual_new(_s5m_inf, F64_ONE);
assert_eq(_s5m_on(dual_mul(_s5m_m, _s5m_big)), 1, "m Inf: value NaN, the mark kept");
assert_eq(_s5m_on(dual_mul(_s5m_big, _s5m_m)), 1, "Inf m: value NaN, the mark kept");
assert_eq(_s5m_on(dual_pow(dual_mul(_s5m_m, _s5m_big), 0)), 1, "(m Inf)^0: not cut");
var _s5m_a = dual_new(F64_ONE, _s5m_ord);
var _s5m_b = dual_new(F64_TWO, _AD_NAN);
assert_eq(_s5m_on(dual_div(_s5m_a, _s5m_b)), 1, "(1, o) / (2, m): a' - q b' keeps the first NaN, the mark is second");
assert_eq(_s5m_on(dual_div(_s5m_b, _s5m_a)), 1, "(2, m) / (1, o): the other order");
var _s5m_nv = dual_new(_s5m_ord, _s5m_ord);
assert_eq(_s5m_on(dual_div(_s5m_nv, _s5m_b)), 1, "NaN value over (2, m): q NaN, the mark kept");
assert_eq(_s5m_on(dual_div(_s5m_b, _s5m_nv)), 1, "(2, m) over a NaN value");
# dual_div's far path: q underflows, and the tangent goes through _ad_div_far.
var _s5m_ta = dual_new(0x01A56E1FC2F8F359, _s5m_ord);
var _s5m_tb = dual_new(0x7E37E43C8800759C, _AD_NAN);
assert_eq(_s5m_on(dual_div(_s5m_ta, _s5m_tb)), 1, "a tiny over a huge: the far path keeps the mark");
var _s5m_tc = dual_new(_s5m_inf, _s5m_ord);
assert_eq(_s5m_on(dual_div(_s5m_tc, _s5m_tb)), 1, "an infinite a over a huge b: the far path's split form");
var _s5m_td = dual_new(F64_TWO, 0);
assert_eq(_s5m_on(dual_div(dual_new(_s5m_inf, _s5m_ord), dual_new(_s5m_inf, _AD_NAN))), 1, "Inf / Inf: value NaN");
assert_eq(_s5m_on(dual_div(_s5m_td, dual_new(_s5m_inf, _AD_NAN))), 1, "2 / Inf, b' the mark: a constant over a mark");
# Beside a NaN VALUE a unary op's partial is NaN too: its t, the first operand, is what stays.
var _s5m_v = dual_new(_s5m_ord, _AD_NAN);
assert_eq(_s5m_on(dual_sin(_s5m_v)), 1, "sin of a NaN value keeps the mark");
assert_eq(_s5m_on(dual_cos(_s5m_v)), 1, "cos");
assert_eq(_s5m_on(dual_exp(_s5m_v)), 1, "exp");
assert_eq(_s5m_on(dual_ln(_s5m_v)), 1, "ln");
assert_eq(_s5m_on(dual_sqrt(_s5m_v)), 1, "sqrt");
assert_eq(_s5m_on(dual_abs(_s5m_v)), 1, "abs");
assert_eq(_s5m_on(dual_neg(_s5m_v)), 1, "neg");
assert_eq(_s5m_on(dual_pow(_s5m_v, 0x3FE0000000000000)), 1, "pow");
# The keeper changes nothing else: an ordinary NaN stays the machine's, and a sum of numbers a sum.
assert_eq(Dual_deriv(dual_add(_s5m_o, _s5m_o)), _s5m_ord, "o + o: the ordinary NaN, as it was");
assert_eq(_s5m_on(dual_add(_s5m_o, dual_var(F64_ONE))), 0, "o + a number: no mark from nowhere");
assert_eq(_ad_keep_mark(_s5m_ord, _s5m_ord, _s5m_ord), _s5m_ord, "_ad_keep_mark: no mark, t");
assert_eq(_ad_keep_mark(_s5m_ord, _s5m_ord, _AD_NAN ^ 0x8000000000000000), _AD_NAN ^ 0x8000000000000000,
  "_ad_keep_mark: a negated mark is a mark");

# === 3.4.1 SYM5: a tree measure saturates, and ends ===
# Every case here runs in a child the suite can kill, as in the group above. Through SYM4 two saturated
# counts added to 2^63 and wrapped: x doubled 58 times measured -2^63 + 24, doubled 60 times 168,
# and a count that wrapped to -24 kept its value through every doubling and was never kept, so
# each level was walked twice.
# [measured: scratch probes p_ovf.cyr and p_hang.cyr of the R4 review, s24 and the SYM5 tree, 2026-11-01]
test_group("3.4.1 SYM5: a tree measure saturates, and ends");
fn _s5b_bytes(e) {
    var b: i64[13];
    var f: i64[768];
    _sx_call_open(&b, &f, ALLOC_MAX);
    return _sym_tree_bytes(e, 0x7FFF_FFFF_FFFF_FFFF - ALLOC_MAX, &b);
}
var _s5b_memT: i64[512];
var _s5b_memN: i64[512];
var _s5b_memC = 0;
# A DAG whose tree bytes are exactly T, T a multiple of 8, T >= 56 or T in {16, 32}.
fn _s5b_sized(T, leaf) {
    for (var i = 0; i < _s5b_memC; i = i + 1) {
        if (load64(&_s5b_memT + i * 8) == T) { return load64(&_s5b_memN + i * 8); }
    }
    var n = 0;
    if (T == 16) { n = leaf; }
    elif (T == 56) { n = expr_add(leaf, leaf); }
    elif (T < 2048) { n = expr_sin(_s5b_sized(T - 16, leaf)); }
    else {
        var rest = T - 24;
        var L = (rest / 16) * 8;
        var R = rest - L;
        n = expr_add(_s5b_sized(L, leaf), _s5b_sized(R, leaf));
    }
    store64(&_s5b_memT + _s5b_memC * 8, T);
    store64(&_s5b_memN + _s5b_memC * 8, n);
    _s5b_memC = _s5b_memC + 1;
    return n;
}
# 40 2^d - 24, the closed form of x doubled d times, up to the ceiling.
fn _s5b_form(d) {
    if (d >= 57) { return 0x4000000000000000; }
    return 40 * (1 << d) - 24;
}
# The R4 review's input: bytes A = 2^62 (x doubled 57 times), C = 3 A, E = 2^62 - 96, D = C + E wraps to
# -24 where the sum is formed first, and -24 doubles to -24 for ever.
fn _s5b_wrap(x, n) {
    var A = _s4w_dbl(x, 57);
    var C = expr_add(expr_add(A, A), A);
    var D = expr_add(C, _s5b_sized(0x3FFFFFFFFFFFFFA0, x));
    return _s4w_dbl(D, n);
}
fn _s5b_case(p) {
    var x = expr_var(str_from("x"));
    var y = expr_var(str_from("y"));
    var a = pat_wildcard(str_from("a"));
    var r = 0;
    if (p == 1) {
        var ds: i64[12];
        store64(&ds, 2);
        store64(&ds + 8, 21);
        store64(&ds + 16, 30);
        store64(&ds + 24, 50);
        store64(&ds + 32, 55);
        store64(&ds + 40, 56);
        store64(&ds + 48, 57);
        store64(&ds + 56, 58);
        store64(&ds + 64, 59);
        store64(&ds + 72, 60);
        store64(&ds + 80, 70);
        store64(&ds + 88, 200);
        for (var i = 0; i < 12; i = i + 1) {
            var d = load64(&ds + i * 8);
            if (_s5b_bytes(_s4w_dbl(x, d)) != _s5b_form(d)) { return 1 + i; }
        }
        return 0;
    }
    if (p == 2) {
        # the review's wrapped input, measured: no level walked twice, and the ceiling
        # [measured: the assertions below, 3.4.1 SYM5 tree, 2026-11-01]
        if (_s5b_bytes(_s5b_wrap(x, 0)) != 0x4000000000000000) { return 1; }
        if (_s5b_bytes(_s5b_wrap(x, 26)) != 0x4000000000000000) { return 2; }
        if (_s5b_bytes(_s5b_wrap(x, 60)) != 0x4000000000000000) { return 3; }
        return 0;
    }
    if (p == 3) {
        # the rule that made the measure run: answered, the shared side kept, at every depth
        # around the wrap (SYM4: 0 at d = 58 alone)
        for (var d3 = 56; d3 <= 62; d3 = d3 + 1) {
            var dd = _s4w_dbl(x, d3);
            r = sym_rewrite(expr_add(dd, expr_sin(y)), _s4w_rule1(pat_sin(a), pat_add(a, a)));
            if (r == 0) { return d3 - 50; }
            if (expr_left(r) != dd) { return 20; }
            if (str_eq(expr_to_str(expr_right(r)), str_from("(y + y)")) != 1) { return 21; }
        }
        return 0;
    }
    if (p == 4) {
        # and on the wrapped input, 411 nodes and 60 more (SYM4: running at 60 s; 3.4.0: 0 in 5.7 s)
        # [measured: the assertions below, 3.4.1 SYM5 tree, 2026-11-01]
        var w = _s5b_wrap(x, 60);
        r = sym_rewrite(expr_add(w, expr_sin(y)), _s4w_rule1(pat_sin(a), pat_add(a, a)));
        if (r == 0) { return 1; }
        if (str_eq(expr_to_str(expr_right(r)), str_from("(y + y)")) != 1) { return 2; }
        return 0;
    }
    if (p == 5) {
        # the measure against its cap: at, one below and one above, in the saturated range
        var b: i64[13];
        var f: i64[768];
        _sx_call_open(&b, &f, ALLOC_MAX);
        var d5 = _s4w_dbl(x, 40);
        var v5 = 40 * (1 << 40) - 24;
        if (_sym_tree_bytes(d5, v5, &b) != v5) { return 1; }
        if (_sym_tree_bytes(d5, v5 - 8, &b) != v5 - 7) { return 2; }
        if (_sym_tree_bytes(d5, v5 + 8, &b) != v5) { return 3; }
        var d6 = _s4w_dbl(x, 70);
        if (_sym_tree_bytes(d6, 1000, &b) != 1001) { return 4; }
        # a unary chain over the ceiling stays there: bytes + 16 is tested first too
        var u6 = d6;
        for (var i6 = 0; i6 < 100; i6 = i6 + 1) { u6 = expr_sin(u6); }
        if (_s5b_bytes(u6) != 0x4000000000000000) { return 5; }
        # a unary chain under a count just below it: one step short, and at it
        var u7 = _s5b_sized(0x3FFFFFFFFFFFFFE0, x);
        if (_s5b_bytes(u7) != 0x3FFFFFFFFFFFFFE0) { return 6; }
        if (_s5b_bytes(expr_sin(u7)) != 0x3FFFFFFFFFFFFFF0) { return 7; }
        if (_s5b_bytes(expr_sin(expr_sin(u7))) != 0x4000000000000000) { return 8; }
        if (_s5b_bytes(expr_sin(expr_sin(expr_sin(u7)))) != 0x4000000000000000) { return 9; }
        # and a sum: two counts that land on the ceiling less 8, on it, and past it by 8
        var h8 = _s5b_sized(0x2000000000000000, x);
        var h9 = _s5b_sized(0x1FFFFFFFFFFFFFD0, x);
        var h10 = _s5b_sized(0x1FFFFFFFFFFFFFD8, x);
        var h11 = _s5b_sized(0x1FFFFFFFFFFFFFE0, x);
        if (_s5b_bytes(expr_add(h8, h9)) != 0x3FFFFFFFFFFFFFE8) { return 10; }
        if (_s5b_bytes(expr_add(h8, h10)) != 0x3FFFFFFFFFFFFFF0) { return 11; }
        if (_s5b_bytes(expr_add(h8, h11)) != 0x3FFFFFFFFFFFFFF8) { return 12; }
        var h12 = _s5b_sized(0x1FFFFFFFFFFFFFE8, x);
        if (_s5b_bytes(expr_add(h8, h12)) != 0x4000000000000000) { return 13; }
        var h13 = _s5b_sized(0x1FFFFFFFFFFFFFF0, x);
        if (_s5b_bytes(expr_add(h8, h13)) != 0x4000000000000000) { return 14; }
        # and a step of a unary node from 8 below the ceiling, which would pass it by 8
        var u8 = _s5b_sized(0x3FFFFFFFFFFFFFF8, x);
        if (_s5b_bytes(u8) != 0x3FFFFFFFFFFFFFF8) { return 15; }
        if (_s5b_bytes(expr_sin(u8)) != 0x4000000000000000) { return 16; }
        return 0;
    }
    return 99;
}
# The child's exit status, or 200 once ten million polls find it still running: it is killed.
fn _s5b_watch(p) {
    var pid = sys_fork();
    if (pid == 0) { sys_exit_group(_s5b_case(p)); }
    var st: i64[1];
    for (var t = 0; t < 10000000; t = t + 1) {
        if (sys_waitpid(pid, &st, 1) == pid) {
            if ((load64(&st) & 0x7F) != 0) { return 100 + (load64(&st) & 0x7F); }
            return (load64(&st) >> 8) & 0xFF;
        }
    }
    sys_kill(pid, 9);
    sys_waitpid(pid, &st, 0);
    return 200;
}
assert_eq(_s5b_watch(1), 0, "_sym_tree_bytes of x doubled d times: 40 2^d - 24 to d = 56, 2^62 from 57 to 200");
assert_eq(_s5b_watch(2), 0, "_sym_tree_bytes of the input that wrapped to -24: 2^62, doubled 0, 26 and 60 times");
assert_eq(_s5b_watch(3), 0, "sym_rewrite: {sin(a) -> a + a} beside x doubled d = 56..62 times: answered at 58");
assert_eq(_s5b_watch(4), 0, "sym_rewrite: the same on the wrapped input doubled 60 times: answered, no hang");
assert_eq(_s5b_watch(5), 0, "_sym_tree_bytes: the cap, and unary steps at the ceiling");

# === 3.4.1 SYM5: a memo never refuses an answer ===
# The table's bytes came from the meter, so a rewrite that stores nothing was refused for what its own
# speed-up cost. 26M nodes of {sin a -> a} and 13M of {y -> y}, at the default 2 GiB, answer on 3.4.0,
# s23 and here, and came back 0 on SYM4. These rows are the same arithmetic at a smaller ALLOC_MAX,
# small enough for a suite: on SYM4 each is 0. The measured rows are in the CHANGELOG's source.
# [measured: scratch probes p_comb.cyr and p_work.cyr of the R4 review, 3.4.0, s23, s24 and the SYM5 tree, 2026-11-01]
test_group("3.4.1 SYM5: a memo never refuses an answer");
fn _s5c_chain(L, y, x) {
    var e = x;
    for (var i = 0; i < L; i = i + 1) { e = expr_add(e, y); }
    return e;
}
fn _s5c_comb(n, L, y, x) {
    if (n == 1) { return _s5c_chain(L, y, x); }
    var h = n / 2;
    var l = _s5c_comb(h, L, y, x);
    return expr_add(l, _s5c_comb(n - h, L, y, x));
}
fn _s5c_full(h, x) {
    if (h == 0) { return x; }
    var l = _s5c_full(h - 1, x);
    return expr_add(l, _s5c_full(h - 1, x));
}
fn _s5c_case(p) {
    var x = expr_var(str_from("x"));
    var y = expr_var(str_from("y"));
    var a = pat_wildcard(str_from("a"));
    var r = 0;
    var keep = ALLOC_MAX;
    var e = 0;
    if (p == 1 || p == 2) {
        # a comb of 200 chains of 10,000 adds: 2 million nodes held
        # [measured: the assertions below, 3.4.1 SYM5 tree, 2026-11-01]
        e = _s5c_comb(200, 10000, y, x);
        var ru = _s4w_rule1(pat_sin(a), a);
        if (p == 2) { ru = _s4w_rule1(pat_var(str_from("y")), pat_var(str_from("y"))); }
        # {y -> y} stores about 100 MB of nodes, which the meter must cover; {sin a -> a} nothing
        # [measured: the assertions below, 3.4.1 SYM5 tree, 2026-11-01]
        var lim = 33554432;
        if (p == 2) { lim = 134217728; }
        ALLOC_MAX = lim;
        var u0 = alloc_used();
        r = sym_rewrite(e, ru);
        var du = alloc_used() - u0;
        ALLOC_MAX = keep;
        if (r != e) { return 1; }
        # what it may allocate: the meter's bytes, and the table's room, ALLOC_MAX of its own
        if (du > 2 * lim + 152) { return 2; }
        return 0;
    }
    if (p == 3) {
        # 6 products of 2^20-node trees, each pair compared to its last leaf: stale pairs piled up
        var tv: i64[8];
        var n = 4;
        for (var i = 0; i < n; i = i + 1) {
            store64(&tv + i * 8, expr_add(_s5c_full(20, x), expr_const(f64_from(i + 1))));
        }
        e = expr_const(0);
        for (var i = 0; i < n; i = i + 1) {
            for (var j = i + 1; j < n; j = j + 1) {
                e = expr_add(e, expr_mul(load64(&tv + i * 8), load64(&tv + j * 8)));
            }
        }
        ALLOC_MAX = 67108864;
        r = sym_rewrite(e, _s4w_rule1(pat_mul(a, a), pat_pow(a, pat_const(F64_TWO))));
        ALLOC_MAX = keep;
        if (r != e) { return 1; }
        return 0;
    }
    if (p == 4) {
        # a plain chain keeps one node per 64 visits, two to a level here, and x doubled its levels
        var b: i64[13];
        var f: i64[768];
        var bind = _bind_new();
        var rule = sym_rule(pat_sin(a), a);
        _sx_call_open(&b, &f, ALLOC_MAX);
        _sx_memo_open(&b);
        e = _s5c_chain(64000, y, x);
        if (_sym_rw_memo(rule, e, &b, bind) != e) { return 1; }
        var kept = load64(&b + _SX_B_USED);
        if (kept < 1900 || kept > 2100) { return 2; }
        _sx_memo_set(&b, load64(&b + _SX_B_TAB), load64(&b + _SX_B_CAP));
        e = _s4w_dbl(x, 300);
        if (_sym_rw_memo(rule, e, &b, bind) != e) { return 3; }
        kept = load64(&b + _SX_B_USED);
        if (kept < 290 || kept > 300) { return 4; }
        # each walk of a call starts with an empty table: the second tree's entries alone
        store64(&b + _SX_B_DEEP, 1);
        if (_sym_rewrite_single(rule, _s5c_chain(64000, x, y), &b, bind) == 0) { return 5; }
        kept = load64(&b + _SX_B_USED);
        if (kept < 1900 || kept > 2100) { return 6; }
        return 0;
    }
    if (p == 6) {
        # a tree measure past 2^20 moves the walks to the memo as a walk does: {a -> a + a} on
        # sin(cos(x)) doubles every pass by sharing, and a plain walk of it stored 55 MB
        # [measured: the assertions below, 3.4.1 SYM5 tree, 2026-11-01]
        var r6 = _s4w_rule1(a, pat_add(a, a));
        var u6 = alloc_used();
        r = sym_rewrite(expr_sin(expr_cos(x)), r6);
        if (r != 0) { return 1; }
        if (alloc_used() - u6 > 0x400000) { return 2; }
        return 0;
    }
    if (p == 5) {
        # a kept node counts one, and a hit what it saved: over a walk's worth of levels the two
        # reduce a shared ladder to the nodes it holds
        var l5 = _s4w_ladder(y, 20000);
        r = sym_rewrite(l5, _s4w_rule1(pat_ln(a), a));
        if (r != l5) { return 1; }
        return 0;
    }
    return 99;
}
fn _s5c_watch(p) {
    var pid = sys_fork();
    if (pid == 0) { sys_exit_group(_s5c_case(p)); }
    var st: i64[1];
    for (var t = 0; t < 60000000; t = t + 1) {
        if (sys_waitpid(pid, &st, 1) == pid) {
            if ((load64(&st) & 0x7F) != 0) { return 100 + (load64(&st) & 0x7F); }
            return (load64(&st) >> 8) & 0xFF;
        }
    }
    sys_kill(pid, 9);
    sys_waitpid(pid, &st, 0);
    return 200;
}
assert_eq(_s5c_watch(1), 0, "{sin a -> a} on 2 million plain nodes at ALLOC_MAX 32 MiB: the input (SYM4: 0)");
assert_eq(_s5c_watch(2), 0, "{y -> y} on them at 128 MiB, every node rebuilt: the input (SYM4: 0)");
assert_eq(_s5c_watch(3), 0, "{a a -> a^2} on 6 products of 2^20-node trees at 64 MiB: the input (SYM4: 0)");
assert_eq(_s5c_watch(4), 0, "a chain keeps 1 node in 64, a doubling keeps its levels");
assert_eq(_s5c_watch(5), 0, "a no-op on a 20,000-level ladder: the input");
assert_eq(_s5c_watch(6), 0, "{a -> a + a}, refused by its tree, within 4 MB: a measure moves the walks too");

# === 3.4.1 SYM5: a shared pattern ends, with the plain answer ===
# The matcher walked the pattern as a tree. A pair an attempt has matched can be skipped when it is met
# again, but for one thing: a name bound under it is compared with itself the second time, and
# a tree holding a NaN or an infinity is not equal to itself. Each row says which side of that it
# stands on, and the plain walk (m = 0) is the second code path wherever it can finish.
# [measured: scratch probe p_pat.cyr of the R4 review and p_diff5.cyr, s24 and the SYM5 tree, 2026-11-01]
test_group("3.4.1 SYM5: a shared pattern ends, with the plain answer");
# sym_rewrite reads a pattern's root tag ahead of the matcher: each kind of root, either way.
var _s5p_rk = vec_new();
vec_push(_s5p_rk, sym_rule(pat_any_const(str_from("k")), pat_var(str_from("z"))));
assert_eq(expr_tag(sym_rewrite(expr_const(F64_TWO), _s5p_rk)), EXPR_VAR, "a root any-const matches a constant");
var _s5p_ry = expr_var(str_from("y"));
assert_eq(sym_rewrite(_s5p_ry, _s5p_rk), _s5p_ry, "... and not a variable");
var _s5p_rc = vec_new();
vec_push(_s5p_rc, sym_rule(pat_const(F64_TWO), pat_var(str_from("z"))));
assert_eq(expr_tag(sym_rewrite(expr_const(F64_TWO), _s5p_rc)), EXPR_VAR, "a root constant matches its value");
assert_eq(sym_rewrite(_s5p_ry, _s5p_rc), _s5p_ry, "... and not a variable");
var _s5p_rw = vec_new();
vec_push(_s5p_rw, sym_rule(pat_var(str_from("y")), pat_var(str_from("z"))));
assert_eq(expr_tag(sym_rewrite(_s5p_ry, _s5p_rw)), EXPR_VAR, "a root variable matches itself");
var _s5p_rf = expr_const(F64_ONE);
assert_eq(sym_rewrite(_s5p_rf, _s5p_rw), _s5p_rf, "... and not a constant");
fn _s5p_dbl(p, n) {
    var q = p;
    for (var i = 0; i < n; i = i + 1) { q = pat_add(q, q); }
    return q;
}
# k adds of the variable x down the right, over the pattern leaf: a pattern of 2 k + 1 nodes that
# holds its leaf once, and past _SX_MEMO_MIN visits, so that a pair of it is kept.
fn _s5p_comb(k, leaf) {
    var q = leaf;
    for (var i = 0; i < k; i = i + 1) { q = pat_add(pat_var(str_from("x")), q); }
    return q;
}
fn _s5p_ecomb(k, leaf) {
    var e = leaf;
    for (var i = 0; i < k; i = i + 1) { e = expr_add(expr_var(str_from("x")), e); }
    return e;
}
fn _s5p_case(p) {
    var x = expr_var(str_from("x"));
    var y = expr_var(str_from("y"));
    var a = pat_wildcard(str_from("a"));
    var px = pat_var(str_from("x"));
    var e40 = _s4w_dbl(x, 40);
    var p40 = _s5p_dbl(px, 40);
    var r = 0;
    if (p == 1) {
        # the review's row: the rule fires at the root
        r = sym_rewrite(e40, _s4w_rule1(p40, pat_const(0)));
        if (r == 0 || expr_tag(r) != EXPR_CONST) { return 1; }
        return 0;
    }
    if (p == 2) {
        # the same with the last leaf of the expression off: it does not fire
        var e2 = _s4w_dbl(x, 39);
        e2 = expr_add(e2, _s4w_dbl(y, 39));
        r = sym_rewrite(e2, _s4w_rule1(p40, pat_const(0)));
        if (r != e2) { return 1; }
        return 0;
    }
    if (p == 3) {
        # sym_match and sym_match_bindings take the same road
        if (sym_match(p40, e40) != 1) { return 1; }
        if (sym_match(p40, _s4w_dbl(x, 39)) != 0) { return 2; }
        var pa = _s5p_dbl(a, 40);
        var ba = sym_match_bindings(pa, e40);
        return 0;
    }
    if (p == 4) {
        # a wildcard under a shared pattern, the value bound finite: every use compares equal
        var pa4 = _s5p_dbl(a, 40);
        if (sym_match(pa4, _s4w_dbl(y, 40)) != 1) { return 1; }
        var b4 = sym_match_bindings(pa4, _s4w_dbl(y, 40));
        if (b4 == 0 || vec_len(b4) != 1) { return 2; }
        return 0;
    }
    if (p == 5 || p == 6) {
        # past the first attempt, a kept pair whose subtree BOUND a name, met again. With a finite leaf
        # the plain walk's comparison passes; with +Inf it does not, the pair is bad, and the
        # answer is 0. pat = P + (S + S), P taking the attempt past 2^20 pairs, S a comb of 70.
        var leaf = expr_const(F64_ONE);
        if (p == 6) { leaf = expr_const(0x7FF0000000000000); }
        var ps5 = _s5p_comb(70, a);
        var pat5 = pat_add(_s5p_dbl(px, 22), pat_add(ps5, ps5));
        var t5 = _s5p_ecomb(70, leaf);
        var e5 = expr_add(_s4w_dbl(x, 22), expr_add(t5, t5));
        var want = 1;
        if (p == 6) { want = 0; }
        if (sym_match(pat5, e5) != want) { return 1; }
        var b5 = _bind_new();
        if (_pat_match(pat5, e5, b5, 0) != want) { return 2; }
        return 0;
    }
    if (p == 7) {
        # a name bound BEFORE the pair is no bad pair: its comparison is pure, and a non-finite
        # tree bound first fails at the first comparison, on both walks
        var ps7 = _s5p_comb(70, a);
        var pat7 = pat_add(_s5p_dbl(px, 22), pat_add(a, pat_add(ps7, ps7)));
        var e7a = expr_const(F64_ONE);
        var t7 = _s5p_ecomb(70, e7a);
        var e7 = expr_add(_s4w_dbl(x, 22), expr_add(expr_const(F64_ONE), expr_add(t7, t7)));
        if (sym_match(pat7, e7) != 1) { return 1; }
        var v7 = expr_const(0x7FF0000000000000);
        var t7b = _s5p_ecomb(70, v7);
        var e7b = expr_add(_s4w_dbl(x, 22), expr_add(v7, expr_add(t7b, t7b)));
        if (sym_match(pat7, e7b) != 0) { return 2; }
        return 0;
    }
    if (p == 8) {
        # a kept pair is one attempt's: the same pair under another binding looks again.
        # R = P + (a + (S + S)), S's leaf naming a. The first node binds a to 1 and S's leaf is 1, a
        # match; the second binds a to 2, and the pair (S, T), kept by the first, must not answer.
        var ps8 = _s5p_comb(70, a);
        var pat8 = pat_add(_s5p_dbl(px, 22), pat_add(a, pat_add(ps8, ps8)));
        var t8 = _s5p_ecomb(70, expr_const(F64_ONE));
        var d8 = _s4w_dbl(x, 22);
        var e8a = expr_add(d8, expr_add(expr_const(F64_ONE), expr_add(t8, t8)));
        var e8b = expr_add(d8, expr_add(expr_const(F64_TWO), expr_add(t8, t8)));
        var ru8 = _s4w_rule1(pat8, pat_var(str_from("z")));
        var in8 = expr_mul(e8a, e8b);
        r = sym_rewrite(in8, ru8);
        if (r == 0 || expr_tag(r) != EXPR_MUL) { return 1; }
        if (expr_tag(expr_left(r)) != EXPR_VAR) { return 2; }
        if (expr_right(r) != e8b) { return 3; }
        return 0;
    }
    if (p == 9) {
        # the second attempt on after the first passed the threshold starts short, and a shared
        # rule at every node of a chain costs an attempt each, not 2^20 pairs each
        var e9 = e40;
        for (var i = 0; i < 2000; i = i + 1) { e9 = expr_add(e9, e40); }
        var pat9 = pat_add(p40, _s5p_dbl(px, 39));
        r = sym_rewrite(e9, _s4w_rule1(pat9, pat_const(0)));
        if (r == 0) { return 1; }
        return 0;
    }
    if (p == 11) {
        # the deep walk counts too: past the recursion's 256 levels, the doubling
        var q11 = p40;
        var e11 = e40;
        for (var i = 0; i < 300; i = i + 1) {
            q11 = pat_sin(q11);
            e11 = expr_sin(e11);
        }
        if (sym_match(q11, e11) != 1) { return 1; }
        return 0;
    }
    if (p == 12) {
        # every leaf of a pattern, past the first attempt: P + X on D + Y
        var q = _s5p_dbl(px, 22);
        var d = _s4w_dbl(x, 22);
        var k = pat_any_const(str_from("k"));
        var c2 = expr_const(F64_TWO);
        var z = expr_var(str_from("z"));
        if (sym_match(pat_add(q, pat_const(F64_TWO)), expr_add(d, c2)) != 1) { return 1; }
        if (sym_match(pat_add(q, pat_const(F64_TWO)), expr_add(d, expr_const(F64_ONE))) != 0) { return 2; }
        if (sym_match(pat_add(q, pat_const(F64_TWO)), expr_add(d, y)) != 0) { return 3; }
        if (sym_match(pat_add(q, k), expr_add(d, c2)) != 1) { return 4; }
        if (sym_match(pat_add(q, k), expr_add(d, y)) != 0) { return 5; }
        if (sym_match(pat_add(q, pat_var(str_from("y"))), expr_add(d, y)) != 1) { return 6; }
        if (sym_match(pat_add(q, pat_var(str_from("y"))), expr_add(d, z)) != 0) { return 7; }
        if (sym_match(pat_add(q, pat_var(str_from("y"))), expr_add(d, c2)) != 0) { return 8; }
        if (sym_match(pat_add(q, pat_sin(px)), expr_add(d, expr_cos(x))) != 0) { return 9; }
        if (sym_match(pat_add(q, pat_sin(px)), expr_add(d, expr_sin(x))) != 1) { return 10; }
        if (sym_match(pat_add(q, pat_add(a, a)), expr_add(d, expr_add(y, y))) != 1) { return 11; }
        if (sym_match(pat_add(q, pat_add(a, a)), expr_add(d, expr_add(y, z))) != 0) { return 12; }
        if (sym_match(pat_add(q, pat_mul(a, y)), expr_add(d, expr_mul(y, z))) != 0) { return 13; }
        # an unknown pattern tag answers 0, a 0 expression refuses
        var bad = alloc(16);
        store64(bad, 90);
        if (sym_match(pat_add(q, bad), expr_add(d, y)) != 0) { return 14; }
        return 0;
    }
    if (p == 13) {
        # a name the plain walk bound before it gave up starts again: bound once, to a tree that
        # is not equal to itself, it is never compared, and the match stands
        var inf13 = expr_const(0x7FF0000000000000);
        var pat13 = pat_add(a, _s5p_dbl(px, 22));
        var e13 = expr_add(inf13, _s4w_dbl(x, 22));
        if (sym_match(pat13, e13) != 1) { return 1; }
        var b13 = _bind_new();
        if (_pat_match(pat13, e13, b13, 0) != 1) { return 2; }
        return 0;
    }
    if (p == 14) {
        # 2,000 attempts, each past 2^20 pairs before it fails at its last leaf: only the first
        # may take them. The rule matches nothing, and the answer is the input.
        # [measured: the assertions below, 3.4.1 SYM5 tree, 2026-11-01]
        var d14 = _s4w_dbl(x, 21);
        var e14 = expr_const(0);
        for (var i = 0; i < 2000; i = i + 1) { e14 = expr_add(e14, expr_add(d14, expr_const(f64_from(i + 1)))); }
        var pat14 = pat_add(_s5p_dbl(px, 21), pat_const(0));
        r = sym_rewrite(e14, _s4w_rule1(pat14, pat_var(str_from("z"))));
        if (r != e14) { return 1; }
        return 0;
    }
    if (p == 10) {
        # unary pattern nodes, kept and skipped as binary ones
        var q10 = pat_sin(px);
        var ex10 = expr_sin(x);
        for (var i = 0; i < 26; i = i + 1) {
            q10 = pat_add(pat_cos(q10), pat_cos(q10));
            ex10 = expr_add(expr_cos(ex10), expr_cos(ex10));
        }
        if (sym_match(q10, ex10) != 1) { return 1; }
        var ex11 = expr_sin(y);
        for (var j = 0; j < 26; j = j + 1) { ex11 = expr_add(expr_cos(ex11), expr_cos(ex11)); }
        if (sym_match(q10, ex11) != 0) { return 2; }
        return 0;
    }
    return 99;
}
fn _s5p_watch(p) {
    var pid = sys_fork();
    if (pid == 0) { sys_exit_group(_s5p_case(p)); }
    var st: i64[1];
    for (var t = 0; t < 10000000; t = t + 1) {
        if (sys_waitpid(pid, &st, 1) == pid) {
            if ((load64(&st) & 0x7F) != 0) { return 100 + (load64(&st) & 0x7F); }
            return (load64(&st) >> 8) & 0xFF;
        }
    }
    sys_kill(pid, 9);
    sys_waitpid(pid, &st, 0);
    return 200;
}
assert_eq(_s5p_watch(1), 0, "sym_rewrite: x + x doubled 40 times, on x doubled 40: fires, in ms (SYM4: hang)");
assert_eq(_s5p_watch(2), 0, "... with one side off: the input");
assert_eq(_s5p_watch(3), 0, "sym_match on a shared pattern: 1, and 0 on a shape one level short");
assert_eq(_s5p_watch(4), 0, "a wildcard under the sharing, finite: matched, one binding");
assert_eq(_s5p_watch(5), 0, "a kept pair that bound a finite name, met again: matched, as the plain walk");
assert_eq(_s5p_watch(6), 0, "a kept pair that bound +Inf, met again: 0, as the plain walk, Inf is not itself");
assert_eq(_s5p_watch(7), 0, "a name bound before the pair: a pure comparison, not a bad pair");
assert_eq(_s5p_watch(8), 0, "a pair kept by one attempt does not answer for another under a new binding");
assert_eq(_s5p_watch(9), 0, "every later attempt starts short");
assert_eq(_s5p_watch(10), 0, "unary pattern nodes in a shared pattern");
assert_eq(_s5p_watch(11), 0, "a shared pattern 300 levels down: the deep walk counts");
assert_eq(_s5p_watch(12), 0, "every kind of pattern leaf, past the first attempt");
assert_eq(_s5p_watch(13), 0, "a name bound before the give-up starts again: bound once, never compared");
assert_eq(_s5p_watch(14), 0, "2,000 attempts past 2^20 pairs each: the count is the call's");

# === 3.4.1 SYM5: a comparison's work is its pairs ===
# Every comparison made its own 2^20-pair first attempt, and a shared unary chain was walked once per
# parent. K = 500 products sharing a depth-30 doubled node took 524,320,503 pair visits on 3,030 nodes
# held; two chains of P adds carrying a chain of P sines 101,068,580 at P = 10,000. They run in a
# bounded child: at these sizes SYM4 took 40 s and 68 s.
# [measured: scratch probe p_work.cyr of the R4 review, s24 and the SYM5 tree, 2026-11-01]
test_group("3.4.1 SYM5: a comparison's work is its pairs");
fn _s5q_case(p) {
    var x = expr_var(str_from("x"));
    var a = pat_wildcard(str_from("a"));
    var r = 0;
    if (p == 1 || p == 2) {
        # K products of (d + c1)(d + c2), d doubled 30 times: unequal at the last leaf, or equal
        var d = _s4w_dbl(x, 30);
        var e = expr_const(0);
        for (var i = 0; i < 2000; i = i + 1) {
            var c1 = expr_const(f64_from(i + 1));
            var c2 = expr_const(f64_from(i + 1));
            if (p == 1) { c2 = expr_const(f64_from(i + 5000)); }
            e = expr_add(e, expr_mul(expr_add(d, c1), expr_add(d, c2)));
        }
        r = sym_rewrite(e, _s4w_rule1(pat_mul(a, a), pat_pow(a, pat_const(F64_TWO))));
        if (p == 1) {
            if (r != e) { return 1; }
            return 0;
        }
        if (r == 0) { return 2; }
        for (var j = 0; j < 2000; j = j + 1) {
            if (expr_tag(expr_right(r)) != EXPR_POW) { return 3; }
            r = expr_left(r);
        }
        return 0;
    }
    if (p == 3) {
        # two chains of P adds, each add carrying a shared chain of P sines
        var u1 = x;
        var u2 = x;
        for (var i = 0; i < 40000; i = i + 1) {
            u1 = expr_sin(u1);
            u2 = expr_sin(u2);
        }
        var c1 = x;
        var c2 = x;
        for (var j = 0; j < 40000; j = j + 1) {
            c1 = expr_add(c1, u1);
            c2 = expr_add(c2, u2);
        }
        r = sym_rewrite(expr_mul(c1, c2), _s4w_rule1(pat_mul(a, a), pat_pow(a, pat_const(F64_TWO))));
        if (r == 0 || expr_tag(r) != EXPR_POW) { return 1; }
        return 0;
    }
    if (p == 5) {
        # the same class under the threshold: 2,000 comparisons of 2^19 pairs each pass it together
        # [measured: the assertions below, 3.4.1 SYM5 tree, 2026-11-01]
        var d5 = _s4w_dbl(x, 18);
        var e5 = expr_const(0);
        for (var i = 0; i < 2000; i = i + 1) {
            e5 = expr_add(e5, expr_mul(expr_add(d5, expr_const(f64_from(i + 1))), expr_add(d5, expr_const(0))));
        }
        r = sym_rewrite(e5, _s4w_rule1(pat_mul(a, a), pat_pow(a, pat_const(F64_TWO))));
        if (r != e5) { return 1; }
        return 0;
    }
    if (p == 6) {
        # 40,000 comparisons each walking down 40,000 equal pairs to one difference: the pairs
        # above a difference are kept too, and the difference is read within 32 levels
        # [measured: the assertions below, 3.4.1 SYM5 tree, 2026-11-01]
        var u6 = x;
        var v6 = expr_var(str_from("y"));
        for (var i = 0; i < 40000; i = i + 1) {
            u6 = expr_sin(u6);
            v6 = expr_sin(v6);
        }
        var e6 = expr_const(0);
        for (var i = 0; i < 40000; i = i + 1) {
            e6 = expr_add(e6, expr_mul(expr_cos(u6), expr_cos(v6)));
        }
        r = sym_rewrite(e6, _s4w_rule1(pat_mul(a, a), pat_pow(a, pat_const(F64_TWO))));
        if (r != e6) { return 1; }
        return 0;
    }
    if (p == 4) {
        # the keeping comparison alone, on trees built apart, where it answers 1, 0, and with same
        var b: i64[13];
        var f: i64[768];
        _sx_call_open(&b, &f, ALLOC_MAX);
        _sx_memo_open(&b);
        var l1 = _s4w_ladder(x, 400);
        var l2 = _s4w_ladder(expr_var(str_from("x")), 400);
        var l3 = _s4w_ladder(expr_var(str_from("y")), 400);
        var inf = expr_const(0x7FF0000000000000);
        var l4 = _s4w_ladder(inf, 200);
        if (_sym_teq_memo(l1, l2, 0, &b) != 1) { return 1; }
        if (_sym_teq_memo(l1, l3, 0, &b) != 0) { return 2; }
        if (_sym_teq_memo(l1, l1, 1, &b) != 1) { return 3; }
        if (_sym_teq_memo(l4, l4, 1, &b) != 1) { return 4; }
        if (_sym_teq_memo(l4, l4, 0, &b) != 0) { return 5; }
        # a pair known equal under same = 1 says nothing under same = 0: two copies of +Inf
        var l5 = _s4w_ladder(expr_const(0x7FF0000000000000), 200);
        if (_sym_teq_memo(l4, l5, 1, &b) != 1) { return 6; }
        if (_sym_teq_memo(l4, l5, 0, &b) != 0) { return 7; }
        # with same = 1 two finite constants still differ
        var c6 = _s4w_ladder(expr_const(F64_ONE), 100);
        var c7 = _s4w_ladder(expr_const(F64_TWO), 100);
        if (_sym_teq_memo(c6, c7, 1, &b) != 0) { return 14; }
        # a difference kept: asked again it is still one, from the top and from part way down
        var s1 = expr_sin(l3);
        var s2 = expr_sin(l1);
        if (_sym_teq_memo(s1, s2, 0, &b) != 0) { return 8; }
        if (_sym_teq_memo(s1, s2, 0, &b) != 0) { return 9; }
        if (_sym_teq_memo(l3, l1, 0, &b) != 0) { return 10; }
        # and under the other same it is a fact of its own: a +Inf ladder differs from itself
        # with same = 0, is equal with same = 1
        if (_sym_teq_memo(l4, l4, 1, &b) != 1) { return 11; }
        var c1 = expr_sin(expr_add(l4, l4));
        if (_sym_teq_memo(c1, c1, 0, &b) != 0) { return 12; }
        if (_sym_teq_memo(c1, c1, 1, &b) != 1) { return 13; }
        return 0;
    }
    return 99;
}
fn _s5q_watch(p) {
    var pid = sys_fork();
    if (pid == 0) { sys_exit_group(_s5q_case(p)); }
    var st: i64[1];
    for (var t = 0; t < 10000000; t = t + 1) {
        if (sys_waitpid(pid, &st, 1) == pid) {
            if ((load64(&st) & 0x7F) != 0) { return 100 + (load64(&st) & 0x7F); }
            return (load64(&st) >> 8) & 0xFF;
        }
    }
    sys_kill(pid, 9);
    sys_waitpid(pid, &st, 0);
    return 200;
}
assert_eq(_s5q_watch(1), 0, "2,000 comparisons of d + c1 and d + c2, unequal at the end: the input, no 2^20 each");
assert_eq(_s5q_watch(2), 0, "the same equal: 2,000 squares");
assert_eq(_s5q_watch(3), 0, "two 40,000-add chains over shared chains of 40,000 sines: compared, equal");
assert_eq(_s5q_watch(4), 0, "the keeping comparison: 1, 0, and same = 0 and same = 1 kept apart");
assert_eq(_s5q_watch(5), 0, "2,000 comparisons of 2^19 pairs: the count is the call's, not each one's");
assert_eq(_s5q_watch(6), 0, "40,000 comparisons of one difference 40,000 levels down: read within 32 levels");

# === 3.4.1 SYM5: sym_rule walks a shared rule once ===
# _sym_rule_bound and _sym_tmpl_shares walked the template as a tree, and a pattern too, so x doubled
# 40 times as a template never came back from sym_rule; on 3.4.0 it took 2 ms.
# [measured: scratch probe p_work.cyr mode 3 of the R4 review, 3.4.0, s24 and the SYM5 tree, 2026-11-01]
test_group("3.4.1 SYM5: sym_rule walks a shared rule once");
fn _s5r_shares(r) {
    if (r == 0) { return 0 - 1; }
    return _rule_shares(r);
}
fn _s5r_bal(h, leaf) {
    if (h == 0) { return leaf; }
    var l = _s5r_bal(h - 1, leaf);
    return pat_add(l, _s5r_bal(h - 1, leaf));
}
fn _s5r_case(p) {
    var a = pat_wildcard(str_from("a"));
    var a2 = pat_wildcard(str_from("a"));
    var b = pat_wildcard(str_from("b"));
    var k = pat_any_const(str_from("k"));
    var px = pat_var(str_from("x"));
    var d = _s5p_dbl(px, 40);
    var top = pat_sin(a);
    if (p == 1) {
        # past the plain walks, each answer by the plain one's meaning
        if (_s5r_shares(sym_rule(top, d)) != 0) { return 1; }
        if (_s5r_shares(sym_rule(top, _s5p_dbl(a, 40))) != 1) { return 2; }
        if (_s5r_shares(sym_rule(top, _s5p_dbl(b, 40))) != 0 - 1) { return 3; }
        if (_s5r_shares(sym_rule(top, pat_add(d, a))) != 0) { return 4; }
        if (_s5r_shares(sym_rule(top, pat_add(a, d))) != 0) { return 5; }
        if (_s5r_shares(sym_rule(top, pat_add(pat_add(d, a), pat_add(d, a2)))) != 1) { return 6; }
        if (_s5r_shares(sym_rule(top, pat_add(d, pat_neg(pat_add(d, pat_sin(a)))))) != 0) { return 7; }
        # a shared node that holds the name once: named twice as a tree, by a node met again
        var s8 = pat_sin(a);
        if (_s5r_shares(sym_rule(top, pat_add(d, pat_add(s8, s8)))) != 1) { return 8; }
        var s9 = pat_add(pat_var(str_from("y")), pat_cos(a));
        if (_s5r_shares(sym_rule(top, pat_add(d, pat_mul(s9, pat_neg(s9))))) != 1) { return 9; }
        # the same shape holding no name
        var s10 = pat_sin(pat_var(str_from("y")));
        if (_s5r_shares(sym_rule(top, pat_add(d, pat_add(pat_add(s10, s10), a)))) != 0) { return 10; }
        # names under unary nodes are found
        if (_s5r_shares(sym_rule(top, pat_add(d, pat_neg(b)))) != 0 - 1) { return 11; }
        if (_s5r_shares(sym_rule(top, pat_add(d, pat_add(pat_sin(a), pat_cos(a2))))) != 1) { return 12; }
        return 0;
    }
    if (p == 2) {
        # the pattern side: a name it binds under sharing, and one it does not
        var pd = pat_add(_s5p_dbl(px, 40), a);
        if (_s5r_shares(sym_rule(pd, a)) != 0) { return 1; }
        if (_s5r_shares(sym_rule(pd, b)) != 0 - 1) { return 2; }
        if (_s5r_shares(sym_rule(_s5p_dbl(a, 40), pat_add(a, a2))) != 1) { return 3; }
        if (_s5r_shares(sym_rule(pd, pat_add(px, a))) != 0) { return 4; }
        return 0;
    }
    if (p == 3) {
        # an any-constant is a name like a wildcard, and pattern nodes in every tag
        var pk = pat_add(_s5p_dbl(px, 30), pat_mul(k, pat_cos(pat_exp(pat_ln(pat_neg(a))))));
        var tk = pat_pow(pat_add(d, k), pat_add(d, a));
        if (_s5r_shares(sym_rule(pk, tk)) != 0) { return 1; }
        if (_s5r_shares(sym_rule(pk, pat_add(pat_add(d, k), pat_add(d, k)))) != 1) { return 2; }
        return 0;
    }
    if (p == 4) {
        # names that share a hash: each kept under its own key
        var f: i64[768];
        var bk: i64[13];
        _sx_call_open(&bk, &f, ALLOC_MAX);
        _sx_memo_open(&bk);
        var n1 = str_from("alpha");
        var n2 = str_from("beta");
        var n3 = str_from("alpha");
        var h = _sx_name_hash(n1);
        if ((h & 7) != 0 || h == 0) { return 1; }
        if (_sx_name_hash(n3) != h) { return 2; }
        if (_sx_name_hash(n2) == h) { return 3; }
        # plant n2 at n1's key, as a collision would
        _sx_memo_put(&bk, h, _SX_KEY_NAME, n2);
        if (_sx_name_has(&bk, n1, _SX_KEY_NAME) != 0) { return 4; }
        if (_sx_name_add(&bk, n1, _SX_KEY_NAME) != 1) { return 5; }
        if (_sx_name_has(&bk, n1, _SX_KEY_NAME) != 1) { return 6; }
        if (_sx_name_add(&bk, n3, _SX_KEY_NAME) != 0) { return 7; }
        if (_sx_name_add(&bk, n1, _SX_KEY_TNAME) != 1) { return 8; }
        return 0;
    }
    if (p == 5) {
        # ordinary rules stay on the plain walks, and the boundary between the two agrees: the
        # same rule answered by the scan directly
        var q = pat_add(pat_mul(a, b), pat_sin(a));
        var t = pat_add(a, pat_mul(a, b));
        var r = sym_rule(q, t);
        if (_s5r_shares(r) != _sym_rule_scan(q, t)) { return 1; }
        if (_s5r_shares(r) != 1) { return 2; }
        var t2 = pat_mul(pat_var(str_from("z")), pat_add(a, b));
        if (_s5r_shares(sym_rule(q, t2)) != _sym_rule_scan(q, t2)) { return 3; }
        if (_sym_rule_scan(q, pat_add(a, k)) != 0 - 1) { return 4; }
        # a chain of adds past _SX_RULE_WALK visits, nothing shared, is not refused
        var w = a;
        for (var i = 0; i < 5000; i = i + 1) { w = pat_add(px, w); }
        if (_s5r_shares(sym_rule(top, w)) != 0) { return 5; }
        var w2 = pat_add(w, a2);
        if (_s5r_shares(sym_rule(top, w2)) != 1) { return 6; }
        # here the table is the answer: at a limit it cannot grow under, the rule is refused. A
        # balanced template, so that the stack fits and the table is what fails.
        var bal = _s5r_bal(13, px);
        var keep = ALLOC_MAX;
        ALLOC_MAX = 2048;
        var r0 = sym_rule(top, pat_add(a, bal));
        ALLOC_MAX = keep;
        if (r0 != 0) { return 7; }
        if (_s5r_shares(sym_rule(top, pat_add(a, bal))) != 0) { return 8; }
        return 0;
    }
    return 99;
}
fn _s5r_watch(p) {
    var pid = sys_fork();
    if (pid == 0) { sys_exit_group(_s5r_case(p)); }
    var st: i64[1];
    for (var t = 0; t < 10000000; t = t + 1) {
        if (sys_waitpid(pid, &st, 1) == pid) {
            if ((load64(&st) & 0x7F) != 0) { return 100 + (load64(&st) & 0x7F); }
            return (load64(&st) >> 8) & 0xFF;
        }
    }
    sys_kill(pid, 9);
    sys_waitpid(pid, &st, 0);
    return 200;
}
assert_eq(_s5r_watch(1), 0, "sym_rule: a template doubled 40 times: shares, unbound and bound, each answered");
assert_eq(_s5r_watch(2), 0, "sym_rule: a pattern doubled 40 times: a name bound under the sharing");
assert_eq(_s5r_watch(3), 0, "sym_rule: an any-constant, and every pattern tag");
assert_eq(_s5r_watch(4), 0, "the scan's names: hash, a collision, each kind apart");
assert_eq(_s5r_watch(5), 0, "the scan and the plain walks agree; 5,000 adds past the walk are not refused");

var r = assert_summary();
# Clamp before exiting: assert_summary() returns the raw failure COUNT, and a wait
# status is only 8 bits — an unclamped 256 / 512 / 768 failures would wrap to status 0 and
# score PASS. Any failure at all becomes status 1.
if (r > 0) { r = 1; }
sys_exit_group(r);
