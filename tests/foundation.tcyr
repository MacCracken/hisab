test_group("vec4 from_vec3/xyz");

var v3src = hvec3_new(f64_from(7), f64_from(8), f64_from(9));
var v4from = hvec4_from_vec3(v3src, F64_ONE);
assert_eq(HVec4_x(v4from), f64_from(7), "v4 from_vec3.x");
assert_eq(HVec4_y(v4from), f64_from(8), "v4 from_vec3.y");
assert_eq(HVec4_z(v4from), f64_from(9), "v4 from_vec3.z");
assert_eq(HVec4_w(v4from), f64_from(1), "v4 from_vec3.w");

# roundtrip: xyz(from_vec3(v, w)) = v
var v3back = hvec4_xyz(v4from);
assert_eq(HVec3_x(v3back), f64_from(7), "v4 xyz roundtrip.x");
assert_eq(HVec3_y(v3back), f64_from(8), "v4 xyz roundtrip.y");
