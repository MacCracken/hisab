# foundation.tcyr — exhaustive tests for foundation types (vec2, vec3, vec4, quat, mat4)
# Ported from the Rust test suite (~100 tests)

include "src/f64_util.cyr"
include "src/error.cyr"
include "src/vec2.cyr"
include "src/vec3.cyr"
include "src/vec4.cyr"
include "src/quat.cyr"
include "src/mat4.cyr"
include "src/mat3.cyr"
include "src/transforms.cyr"
include "src/complex.cyr"
include "src/lie.cyr"
include "src/calc.cyr"
include "src/color.cyr"

alloc_init();

# Tolerance for floating point comparisons
# We use f64_approx_eq from f64_util.cyr with a reasonable epsilon
var LOOSE_TOL = 0x3E45798EE2308C3A;  # ~1e-8
var TIGHT_TOL = EPSILON_F64;

# Helper: assert two f64 values are approximately equal
fn assert_f64_eq(a, b, msg) {
    assert(f64_approx_eq(a, b, LOOSE_TOL), msg);
    return 0;
}

# ================================================================
# Vec2 — Construction
# ================================================================
test_group("vec2 construction");

# zero
var v2z = hvec2_zero();
assert_eq(HVec2_x(v2z), f64_from(0), "v2 zero.x");
assert_eq(HVec2_y(v2z), f64_from(0), "v2 zero.y");

# one
var v2o = hvec2_one();
assert_eq(HVec2_x(v2o), f64_from(1), "v2 one.x");
assert_eq(HVec2_y(v2o), f64_from(1), "v2 one.y");

# new
var v2a = hvec2_new(f64_from(3), f64_from(4));
assert_eq(HVec2_x(v2a), f64_from(3), "v2 new.x");
assert_eq(HVec2_y(v2a), f64_from(4), "v2 new.y");

# splat
var v2s = hvec2_splat(f64_from(7));
assert_eq(HVec2_x(v2s), f64_from(7), "v2 splat.x");
assert_eq(HVec2_y(v2s), f64_from(7), "v2 splat.y");

# ================================================================
# Vec2 — Arithmetic
# ================================================================
test_group("vec2 arithmetic");

var v2b = hvec2_new(f64_from(1), f64_from(2));

# add
var v2add = hvec2_add(v2a, v2b);
assert_eq(HVec2_x(v2add), f64_from(4), "v2 add.x");
assert_eq(HVec2_y(v2add), f64_from(6), "v2 add.y");

# sub
var v2sub = hvec2_sub(v2a, v2b);
assert_eq(HVec2_x(v2sub), f64_from(2), "v2 sub.x");
assert_eq(HVec2_y(v2sub), f64_from(2), "v2 sub.y");

# mul (component-wise)
var v2mul = hvec2_mul(v2a, v2b);
assert_eq(HVec2_x(v2mul), f64_from(3), "v2 mul.x");
assert_eq(HVec2_y(v2mul), f64_from(8), "v2 mul.y");

# scale
var v2sc = hvec2_scale(v2a, f64_from(2));
assert_eq(HVec2_x(v2sc), f64_from(6), "v2 scale.x");
assert_eq(HVec2_y(v2sc), f64_from(8), "v2 scale.y");

# neg
var v2neg = hvec2_neg(v2a);
assert_eq(HVec2_x(v2neg), f64_neg(f64_from(3)), "v2 neg.x");
assert_eq(HVec2_y(v2neg), f64_neg(f64_from(4)), "v2 neg.y");

# ================================================================
# 3.3.5 — hvec2_add at the magnitude where one ulp shows (audit D105)
# ================================================================
# ⛔ The sums above are 4 and 6, where an ulp is 2^-50: an add returning a + b + 2^-52 (one
# ulp of 1) rounds back onto the same double and every assertion still passes. Sums in
# [0.5, 2) put that error at one or two ulps. These are full mantissas, rounded sums,
# one in each binade and one negative; each expected value is the correctly rounded
# sum (Fraction oracle).
# [measured: scratch harness and Fraction oracle, not reproducible in-tree, 2026-10-11; cycc 6.6.14]
test_group("3.3.5 vec2 add: sums in [0.5, 2), where one ulp shows");
var _va_s1 = hvec2_add(hvec2_new(0x3FE3C0CA428C59FB, 0x3FF1B6E192EBBE44),
  hvec2_new(0x3FD225E01776813F, 0x3FC84FE5B44E3825));
assert_eq(HVec2_x(_va_s1), 0x3FECD3BA4E479A9A, "hvec2_add: x, a sum in [0.5, 1), correctly rounded");
assert_eq(HVec2_y(_va_s1), 0x3FF4C0DE49758549, "hvec2_add: y, a sum in [1, 2), correctly rounded");
var _va_s2 = hvec2_add(hvec2_new(0xBFF5A6EBFBB10B83, 0x3FE8DE3202FB9FF7),
  hvec2_new(0xBFC3FD78BAFB5FC1, 0x3FDCB2AE4F7A5D69));
assert_eq(HVec2_x(_va_s2), 0xBFF8269B1310777B, "hvec2_add: x, a negative sum in (-2, -1], correctly rounded");
assert_eq(HVec2_y(_va_s2), 0x3FF39BC4955C6756, "hvec2_add: y, a carry into [1, 2), correctly rounded");

# ================================================================
# Vec2 — Products and Norms
# ================================================================
test_group("vec2 products/norms");

# dot: (3,4).(1,2) = 3+8 = 11
var v2dot = hvec2_dot(v2a, v2b);
assert_eq(v2dot, f64_from(11), "v2 dot");

# dot with self: (3,4).(3,4) = 9+16 = 25
assert_eq(hvec2_dot(v2a, v2a), f64_from(25), "v2 dot self");

# length_sq: (3,4) = 25
assert_eq(hvec2_length_sq(v2a), f64_from(25), "v2 length_sq");

# length: (3,4) = 5 (3-4-5 triangle)
assert_eq(hvec2_length(v2a), f64_from(5), "v2 length 3-4-5");

# length of (0,0)
assert_eq(hvec2_length(hvec2_zero()), f64_from(0), "v2 length zero");

# length of (1,0)
assert_eq(hvec2_length(hvec2_new(F64_ONE, 0)), f64_from(1), "v2 length unit");

# normalize: (3,4)/5 = (0.6, 0.8), length should be 1
var v2norm = hvec2_normalize(v2a);
var v2norm_len = hvec2_length(v2norm);
assert_f64_eq(v2norm_len, F64_ONE, "v2 normalize length=1");

# normalize components: 3/5=0.6, 4/5=0.8. ⭐ 3.3.5 — these compared round(10 * x) with 6
# and 8, which accepts anything in [0.55, 0.65). len = sqrt(25) = 5 is exact, and the
# reciprocal and the product each round once (relative 2^-53), so a component in
# [0.5, 1) lands within 2 ulp of the true quotient's double. Measured: x is
# 0x3FE3333333333334, 1 ulp above fl(0.6) (3 * fl(1/5) is a tie, rounded to even), and y
# is fl(0.8).
# [measured: scratch probe and Decimal oracle, not reproducible in-tree, 2026-10-11; cycc 6.6.14]
# Distance in ulps between two finite f64s of one sign: their bit patterns are
# monotonic in value. An opposite sign (+0 against -0 included) returns the largest
# gap; without that test a = -b makes a - b exactly -2^63, which stays negative.
fn _fd_ulp_gap(a, b) {
    if ((a ^ b) < 0) { return 0x7FFFFFFFFFFFFFFF; }
    var d = a - b;
    if (d < 0) { d = 0 - d; }
    return d;
}
assert(_fd_ulp_gap(HVec2_x(v2norm), 0x3FE3333333333333) <= 2, "v2 normalize.x = 3/5 within 2 ulp");
assert(_fd_ulp_gap(HVec2_y(v2norm), 0x3FE999999999999A) <= 2, "v2 normalize.y = 4/5 within 2 ulp");

# normalize zero vector returns zero
var v2norm_z = hvec2_normalize(hvec2_zero());
assert_eq(HVec2_x(v2norm_z), f64_from(0), "v2 normalize zero.x");
assert_eq(HVec2_y(v2norm_z), f64_from(0), "v2 normalize zero.y");

# distance: dist((3,4),(1,2)) = length((2,2)) = sqrt(8). The squared sum 8 is exact and
# IEEE sqrt rounds correctly, so this is fl(2 sqrt 2) to the bit (round(1000 d) = 2828
# accepted anything within 5e-4).
var v2dist = hvec2_distance(v2a, v2b);
assert_eq(v2dist, 0x4006A09E667F3BCD, "v2 distance = fl(sqrt 8), correctly rounded");

# distance to self = 0
assert_eq(hvec2_distance(v2a, v2a), f64_from(0), "v2 distance self=0");

# ================================================================
# Vec2 — Interpolation
# ================================================================
test_group("vec2 lerp");

var v2la = hvec2_new(f64_from(0), f64_from(0));
var v2lb = hvec2_new(f64_from(10), f64_from(20));

# lerp t=0 returns a
var v2l0 = hvec2_lerp(v2la, v2lb, 0);
assert_eq(HVec2_x(v2l0), f64_from(0), "v2 lerp t=0 .x");
assert_eq(HVec2_y(v2l0), f64_from(0), "v2 lerp t=0 .y");

# lerp t=1 returns b
var v2l1 = hvec2_lerp(v2la, v2lb, F64_ONE);
assert_eq(HVec2_x(v2l1), f64_from(10), "v2 lerp t=1 .x");
assert_eq(HVec2_y(v2l1), f64_from(20), "v2 lerp t=1 .y");

# lerp t=0.5 returns midpoint
var v2lh = hvec2_lerp(v2la, v2lb, F64_HALF);
assert_eq(HVec2_x(v2lh), f64_from(5), "v2 lerp t=0.5 .x");
assert_eq(HVec2_y(v2lh), f64_from(10), "v2 lerp t=0.5 .y");

# ================================================================
# Vec3 — Construction
# ================================================================
test_group("vec3 construction");

var v3z = hvec3_zero();
assert_eq(HVec3_x(v3z), f64_from(0), "v3 zero.x");
assert_eq(HVec3_y(v3z), f64_from(0), "v3 zero.y");
assert_eq(HVec3_z(v3z), f64_from(0), "v3 zero.z");

var v3o = hvec3_one();
assert_eq(HVec3_x(v3o), f64_from(1), "v3 one.x");
assert_eq(HVec3_y(v3o), f64_from(1), "v3 one.y");
assert_eq(HVec3_z(v3o), f64_from(1), "v3 one.z");

# unit vectors
assert_eq(HVec3_x(hvec3_unit_x()), f64_from(1), "v3 unit_x.x");
assert_eq(HVec3_y(hvec3_unit_x()), f64_from(0), "v3 unit_x.y");
assert_eq(HVec3_z(hvec3_unit_x()), f64_from(0), "v3 unit_x.z");

assert_eq(HVec3_x(hvec3_unit_y()), f64_from(0), "v3 unit_y.x");
assert_eq(HVec3_y(hvec3_unit_y()), f64_from(1), "v3 unit_y.y");
assert_eq(HVec3_z(hvec3_unit_y()), f64_from(0), "v3 unit_y.z");

assert_eq(HVec3_x(hvec3_unit_z()), f64_from(0), "v3 unit_z.x");
assert_eq(HVec3_y(hvec3_unit_z()), f64_from(0), "v3 unit_z.y");
assert_eq(HVec3_z(hvec3_unit_z()), f64_from(1), "v3 unit_z.z");

# splat
var v3sp = hvec3_splat(f64_from(5));
assert_eq(HVec3_x(v3sp), f64_from(5), "v3 splat.x");
assert_eq(HVec3_y(v3sp), f64_from(5), "v3 splat.y");
assert_eq(HVec3_z(v3sp), f64_from(5), "v3 splat.z");

# ================================================================
# Vec3 — Arithmetic
# ================================================================
test_group("vec3 arithmetic");

var v3a = hvec3_new(f64_from(1), f64_from(2), f64_from(3));
var v3b = hvec3_new(f64_from(4), f64_from(5), f64_from(6));

# add
var v3add = hvec3_add(v3a, v3b);
assert_eq(HVec3_x(v3add), f64_from(5), "v3 add.x");
assert_eq(HVec3_y(v3add), f64_from(7), "v3 add.y");
assert_eq(HVec3_z(v3add), f64_from(9), "v3 add.z");

# sub
var v3sub = hvec3_sub(v3a, v3b);
assert_eq(HVec3_x(v3sub), f64_neg(f64_from(3)), "v3 sub.x");
assert_eq(HVec3_y(v3sub), f64_neg(f64_from(3)), "v3 sub.y");
assert_eq(HVec3_z(v3sub), f64_neg(f64_from(3)), "v3 sub.z");

# mul (component-wise)
var v3mul = hvec3_mul(v3a, v3b);
assert_eq(HVec3_x(v3mul), f64_from(4), "v3 mul.x");
assert_eq(HVec3_y(v3mul), f64_from(10), "v3 mul.y");
assert_eq(HVec3_z(v3mul), f64_from(18), "v3 mul.z");

# scale
var v3sc = hvec3_scale(v3a, f64_from(3));
assert_eq(HVec3_x(v3sc), f64_from(3), "v3 scale.x");
assert_eq(HVec3_y(v3sc), f64_from(6), "v3 scale.y");
assert_eq(HVec3_z(v3sc), f64_from(9), "v3 scale.z");

# neg
var v3neg = hvec3_neg(v3a);
assert_eq(HVec3_x(v3neg), f64_neg(f64_from(1)), "v3 neg.x");
assert_eq(HVec3_y(v3neg), f64_neg(f64_from(2)), "v3 neg.y");
assert_eq(HVec3_z(v3neg), f64_neg(f64_from(3)), "v3 neg.z");

# ================================================================
# Vec3 — Dot, Cross, Length
# ================================================================
test_group("vec3 products/norms");

# dot: (1,2,3).(4,5,6) = 4+10+18 = 32
assert_eq(hvec3_dot(v3a, v3b), f64_from(32), "v3 dot");

# dot with self: (1,2,3).(1,2,3) = 1+4+9 = 14
assert_eq(hvec3_dot(v3a, v3a), f64_from(14), "v3 dot self");

# dot orthogonal: unit_x . unit_y = 0
assert_eq(hvec3_dot(hvec3_unit_x(), hvec3_unit_y()), f64_from(0), "v3 dot orthogonal");

# length_sq
assert_eq(hvec3_length_sq(v3a), f64_from(14), "v3 length_sq");

# length of (3,4,0) = 5
var v3_345 = hvec3_new(f64_from(3), f64_from(4), 0);
assert_eq(hvec3_length(v3_345), f64_from(5), "v3 length 3-4-0");

# cross products: x cross y = z
var cr_xy = hvec3_cross(hvec3_unit_x(), hvec3_unit_y());
assert_eq(HVec3_x(cr_xy), f64_from(0), "v3 x cross y .x");
assert_eq(HVec3_y(cr_xy), f64_from(0), "v3 x cross y .y");
assert_eq(HVec3_z(cr_xy), f64_from(1), "v3 x cross y .z");

# y cross z = x
var cr_yz = hvec3_cross(hvec3_unit_y(), hvec3_unit_z());
assert_eq(HVec3_x(cr_yz), f64_from(1), "v3 y cross z .x");
assert_eq(HVec3_y(cr_yz), f64_from(0), "v3 y cross z .y");
assert_eq(HVec3_z(cr_yz), f64_from(0), "v3 y cross z .z");

# z cross x = y
var cr_zx = hvec3_cross(hvec3_unit_z(), hvec3_unit_x());
assert_eq(HVec3_x(cr_zx), f64_from(0), "v3 z cross x .x");
assert_eq(HVec3_y(cr_zx), f64_from(1), "v3 z cross x .y");
assert_eq(HVec3_z(cr_zx), f64_from(0), "v3 z cross x .z");

# cross anti-commutativity: a x b = -(b x a)
var cr_ab = hvec3_cross(v3a, v3b);
var cr_ba = hvec3_cross(v3b, v3a);
assert_f64_eq(HVec3_x(cr_ab), f64_neg(HVec3_x(cr_ba)), "v3 cross anti-commute.x");
assert_f64_eq(HVec3_y(cr_ab), f64_neg(HVec3_y(cr_ba)), "v3 cross anti-commute.y");
assert_f64_eq(HVec3_z(cr_ab), f64_neg(HVec3_z(cr_ba)), "v3 cross anti-commute.z");

# cross self = zero
var cr_aa = hvec3_cross(v3a, v3a);
assert_eq(HVec3_x(cr_aa), f64_from(0), "v3 cross self.x");
assert_eq(HVec3_y(cr_aa), f64_from(0), "v3 cross self.y");
assert_eq(HVec3_z(cr_aa), f64_from(0), "v3 cross self.z");

# normalize
var v3norm = hvec3_normalize(v3a);
assert_f64_eq(hvec3_length(v3norm), F64_ONE, "v3 normalize length=1");

# normalize zero returns zero
var v3norm_z = hvec3_normalize(hvec3_zero());
assert_eq(HVec3_x(v3norm_z), f64_from(0), "v3 normalize zero.x");

# distance
var v3dist = hvec3_distance(v3a, v3b);
# dist = length((3,3,3)) = sqrt(27) = 3*sqrt(3). The squared sum 27 is exact and IEEE sqrt
# rounds correctly, so this is fl(sqrt 27) to the bit.
assert_eq(v3dist, 0x4014C8DC2E423980, "v3 distance = fl(sqrt 27), correctly rounded");

# distance to self = 0
assert_eq(hvec3_distance(v3a, v3a), f64_from(0), "v3 distance self=0");

# ================================================================
# Vec3 — Lerp
# ================================================================
test_group("vec3 lerp");

var v3la = hvec3_new(0, 0, 0);
var v3lb = hvec3_new(f64_from(10), f64_from(20), f64_from(30));

# lerp t=0
var v3l0 = hvec3_lerp(v3la, v3lb, 0);
assert_eq(HVec3_x(v3l0), f64_from(0), "v3 lerp t=0 .x");
assert_eq(HVec3_y(v3l0), f64_from(0), "v3 lerp t=0 .y");
assert_eq(HVec3_z(v3l0), f64_from(0), "v3 lerp t=0 .z");

# lerp t=1
var v3l1 = hvec3_lerp(v3la, v3lb, F64_ONE);
assert_eq(HVec3_x(v3l1), f64_from(10), "v3 lerp t=1 .x");
assert_eq(HVec3_y(v3l1), f64_from(20), "v3 lerp t=1 .y");
assert_eq(HVec3_z(v3l1), f64_from(30), "v3 lerp t=1 .z");

# lerp t=0.5
var v3lh = hvec3_lerp(v3la, v3lb, F64_HALF);
assert_eq(HVec3_x(v3lh), f64_from(5), "v3 lerp t=0.5 .x");
assert_eq(HVec3_y(v3lh), f64_from(10), "v3 lerp t=0.5 .y");
assert_eq(HVec3_z(v3lh), f64_from(15), "v3 lerp t=0.5 .z");

# ================================================================
# Vec2 / Vec3 — Lerp is bit-identical to the scalar form (3.2.0 SIMD hybrid)
# ================================================================
test_group("3.2.0 vec2/vec3 lerp: f64v hybrid is bit-identical to a + (b - a) * t");

# ⭐ 3.2.0 moved hvec3_lerp onto the n=2 pair + scalar-z hybrid and hvec2_lerp
# onto packed n=2. The CONTRACT is that the packed lanes compute a + (b - a) * t
# in exactly the scalar form's operation order — sub, then mul, then add, each
# rounded once — so every lane is bit-identical to the scalar expression, NaN
# payloads and signed zeros included. The three fixtures above cannot see that:
# 0, 10 and 20 at t in {0, 1/2, 1} are exact under ANY association, so a fused
# multiply-add, an (a*(1-t) + b*t) rewrite, or a lane left unscaled at t = 1
# all pass them. This sweep compares 200 (a, b, t) triples lane by lane on the
# RAW WORD, against the scalar expression computed inline here, and counts the
# classes it reached so a fixture that silently degenerates is named.
# ⚠ The compare is on the raw word (`==`), never f64_eq: NaN != NaN through
# f64_eq, and a NaN lane whose PAYLOAD changed is exactly the kind of drift a
# fused or reordered sequence produces.
var _LP_RUN = 0;
var _LP_BAD = 0;
var _LP_NAN = 0;      # lanes whose expected result is NaN (passthrough reached)
var _LP_INF = 0;      # lanes whose expected result is +-Inf
var _LP_SUB = 0;      # lanes with a subnormal operand or a subnormal result
var _LP_SEED = 0x9E3779B97F4A7C15;

# xorshift64* -- deterministic, so a failing triple is reproducible by index.
fn _lp_rnd() {
    var x = _LP_SEED;
    x = x ^ (x >> 12);
    x = x ^ (x << 25);
    x = x ^ (x >> 27);
    _LP_SEED = x;
    return x * 0x2545F4914F6CDD1D;
}

# An "ordinary" f64 in about [-8, 8) with a full mantissa: 2^e * (1 + m).
fn _lp_ordinary() {
    var w = _lp_rnd();
    var e = 1020 + (w & 7);                          # 2^-3 .. 2^4
    var m = (_lp_rnd() >> 12) & 0xFFFFFFFFFFFFF;     # 52 mantissa bits
    return ((w >> 3) & 1) << 63 | e << 52 | m;
}

# A lane value drawn by class: i % 5 selects ordinary / raw bits (any exponent)
# / subnormal / huge / NaN with a random sign and PAYLOAD. ⚠ The class schedule
# never puts two DIFFERENT NaN payloads on the same packed lane (ax is NaN at
# i%5==4, bx at i%5==1, and t = NaN only at i%5==2, beside the scalar z tail),
# so this sweep cannot observe the operand-order rule on its own: a t-first
# packed multiply and a swapped final add both survived it (421/421) and are
# killed only by the directed `_lp_pair` block after the sweep.
# [measured: scratch harness, not reproducible in-tree]
fn _lp_lane(i) {
    var c = i % 5;
    if (c == 1) { return _lp_rnd(); }
    if (c == 2) { return _lp_rnd() & 0x800FFFFFFFFFFFFF; }            # exponent 0
    if (c == 3) { return (_lp_rnd() & 0x800FFFFFFFFFFFFF) | (2040 << 52); } # ~2^1017
    if (c == 4) { return (_lp_rnd() & 0x800FFFFFFFFFFFFF) | 0x7FF0000000000000; }
    return _lp_ordinary();
}

fn _lp_is_nan(w) { return f64_eq(w, w) == 0; }
fn _lp_is_inf(w) { return f64_eq(f64_abs(w), F64_POS_INF); }
fn _lp_is_sub(w) {
    if ((w & 0x7FF0000000000000) != 0) { return 0; }
    return (w & 0xFFFFFFFFFFFFF) != 0;
}

# One lane: the scalar expression, computed here, is the oracle.
fn _lp_check(got, a, b, t) {
    var want = f64_add(a, f64_mul(f64_sub(b, a), t));
    _LP_RUN = _LP_RUN + 1;
    if (got != want) { _LP_BAD = _LP_BAD + 1; }
    if (_lp_is_nan(want) == 1) { _LP_NAN = _LP_NAN + 1; }
    if (_lp_is_inf(want) == 1) { _LP_INF = _LP_INF + 1; }
    if (_lp_is_sub(a) == 1 || _lp_is_sub(b) == 1 || _lp_is_sub(want) == 1) { _LP_SUB = _LP_SUB + 1; }
    return 0;
}

fn _lp_sweep() {
    for (var i = 0; i < 200; i = i + 1) {
        # t cycles through the named cases first, then random ordinary values.
        var t = _lp_ordinary();
        var k = i % 10;
        if (k == 0) { t = 0; }
        if (k == 1) { t = F64_ONE; }
        if (k == 2) { t = F64_HALF; }
        if (k == 3) { t = f64_neg(F64_ONE); }                    # extrapolate below a
        if (k == 4) { t = F64_TWO; }                             # extrapolate past b
        if (k == 5) { t = 1; }                                   # smallest subnormal
        if (k == 6) { t = 0x7FE0000000000000; }                  # 2^1023
        if (k == 7) { t = 0x7FF8000000000000; }                  # NaN
        if (k == 8) { t = F64_POS_INF; }
        var ax = _lp_lane(i); var ay = _lp_lane(i + 1); var az = _lp_lane(i + 2);
        var bx = _lp_lane(i + 3); var by = _lp_lane(i + 4); var bz = _lp_lane(i + 1);
        var r3 = hvec3_lerp(hvec3_new(ax, ay, az), hvec3_new(bx, by, bz), t);
        _lp_check(HVec3_x(r3), ax, bx, t);
        _lp_check(HVec3_y(r3), ay, by, t);
        _lp_check(HVec3_z(r3), az, bz, t);
        var r2 = hvec2_lerp(hvec2_new(ax, ay), hvec2_new(bx, by), t);
        _lp_check(HVec2_x(r2), ax, bx, t);
        _lp_check(HVec2_y(r2), ay, by, t);
    }
    return 0;
}

_lp_sweep();
assert_eq(_LP_RUN, 1000, "the lerp sweep ran 200 triples x (3 vec3 + 2 vec2) lanes");
assert_eq(_LP_BAD, 0,
  "hvec3_lerp / hvec2_lerp are bit-identical to a + (b - a) * t on every lane of 200 triples");
# The class counters, pinned EXACTLY because the generator is deterministic: a
# sweep that silently stopped reaching a class would still pass the bit-exact
# assertion above (there is nothing to get wrong on a lane it never drew).
# ⚠ The first draft asserted "> 100 NaN lanes" from a count guessed before the
# sweep ran; the measured figure was exactly 100 -- every one of them from
# t = NaN, none from the operand classes -- which is why the NaN-payload lane
# class exists at all. [measured: counts printed from this sweep, 2026-09-14]
assert_eq(_LP_NAN, 480, "the lerp sweep reached NaN passthrough on 480 lanes (t = NaN and NaN operands)");
assert_eq(_LP_INF, 84, "the lerp sweep reached +-Inf results on 84 lanes");
assert_eq(_LP_SUB, 400, "the lerp sweep reached subnormal operands or results on 400 lanes");

# ⛔ OPERAND ORDER, PINNED DIRECTLY. Two distinct NaN payloads meeting in ONE
# packed operation is the only input on which `a + (b - a) * t` and a
# reordered sequence differ (x86 returns the first NaN source operand,
# quieted). The sweep above never builds that lane; these four do, on the
# packed x lane of both functions, against the same scalar oracle. Under a
# t-first packed multiply case A returns payload 0x01 for 0xFF; under a
# swapped final add case B returns 0x22 for 0x11.
# [measured: scratch harness, not reproducible in-tree]
fn _lp_pair(a, b, t, label) {
    var want = f64_add(a, f64_mul(f64_sub(b, a), t));
    var r3 = hvec3_lerp(hvec3_new(a, 0, 0), hvec3_new(b, 0, 0), t);
    var r2 = hvec2_lerp(hvec2_new(a, 0), hvec2_new(b, 0), t);
    assert_eq(HVec3_x(r3), want, label);
    assert_eq(HVec2_x(r2), want, label);
    return 0;
}
_lp_pair(F64_ONE, 0x7FF80000000000FF, 0x7FF8000000000001,
  "lerp packed lane: NaN(b) vs NaN(t) keeps the (b - a) payload, not t's");
_lp_pair(0x7FF8000000000011, 0x7FF8000000000022, F64_HALF,
  "lerp packed lane: NaN(a) vs NaN(b) keeps a's payload through the final add");
_lp_pair(0xFFF8000000000033, 0x7FF8000000000044, F64_ONE,
  "lerp packed lane: negative NaN(a) vs NaN(b) at t = 1 keeps a's payload");
_lp_pair(0x7FF8000000000055, F64_TWO, 0x7FF8000000000066,
  "lerp packed lane: NaN(a) vs NaN(t) keeps a's payload through the scale");

# ================================================================
# Vec3 — Min, Max, Abs, Reflect
# ================================================================
test_group("vec3 min/max/abs/reflect");

var v3c = hvec3_new(f64_from(5), f64_neg(f64_from(3)), f64_from(1));
var v3d = hvec3_new(f64_from(2), f64_from(7), f64_neg(f64_from(4)));

# min
var v3min = hvec3_min(v3c, v3d);
assert_eq(HVec3_x(v3min), f64_from(2), "v3 min.x");
assert_eq(HVec3_y(v3min), f64_neg(f64_from(3)), "v3 min.y");
assert_eq(HVec3_z(v3min), f64_neg(f64_from(4)), "v3 min.z");

# max
var v3max = hvec3_max(v3c, v3d);
assert_eq(HVec3_x(v3max), f64_from(5), "v3 max.x");
assert_eq(HVec3_y(v3max), f64_from(7), "v3 max.y");
assert_eq(HVec3_z(v3max), f64_from(1), "v3 max.z");

# === 3.3.3 W3: hvec3_min / hvec3_max propagate NaN in either argument order ===
# ⛔ 3.3.3 — through 3.3.2 these were stdlib f64_min / f64_max per component, which
# return the SECOND operand whenever the compare is false: min((NaN,..), (1,..)).x was
# 1 but min((1,..), (NaN,..)).x was NaN, max the same, and of two zeros the second
# one's sign came back. Every case below runs in BOTH argument orders and is compared
# bit for bit, the sign of zero included.
# [measured: scratch probe on the 3.3.2 bundle, not reproducible in-tree, 2026-10-01; cycc 6.6.12]
var _w3_nan = 0x7FF8000000000000;
var _w3_nan2 = 0xFFF8000000000001;   # a second NaN: negative, with a payload
var _w3_nz = 0x8000000000000000;     # -0
# x: NaN in the first argument; y: NaN in the second; z: -0 against +0.
var _w3_va = hvec3_new(_w3_nan, F64_TWO, _w3_nz);
var _w3_vb = hvec3_new(F64_ONE, _w3_nan, 0);
var _w3_mn_ab = hvec3_min(_w3_va, _w3_vb);
var _w3_mn_ba = hvec3_min(_w3_vb, _w3_va);
var _w3_mx_ab = hvec3_max(_w3_va, _w3_vb);
var _w3_mx_ba = hvec3_max(_w3_vb, _w3_va);
assert_eq(HVec3_x(_w3_mn_ab), _w3_nan, "v3 min((NaN,..), (1,..)).x is NaN (3.3.2: 1)");
assert_eq(HVec3_x(_w3_mn_ba), _w3_nan, "v3 min((1,..), (NaN,..)).x is NaN");
assert_eq(HVec3_x(_w3_mx_ab), _w3_nan, "v3 max((NaN,..), (1,..)).x is NaN (3.3.2: 1)");
assert_eq(HVec3_x(_w3_mx_ba), _w3_nan, "v3 max((1,..), (NaN,..)).x is NaN");
assert_eq(HVec3_y(_w3_mn_ab), _w3_nan, "v3 min((.,2,.), (.,NaN,.)).y is NaN");
assert_eq(HVec3_y(_w3_mn_ba), _w3_nan, "v3 min((.,NaN,.), (.,2,.)).y is NaN (3.3.2: 2)");
assert_eq(HVec3_y(_w3_mx_ab), _w3_nan, "v3 max((.,2,.), (.,NaN,.)).y is NaN");
assert_eq(HVec3_y(_w3_mx_ba), _w3_nan, "v3 max((.,NaN,.), (.,2,.)).y is NaN (3.3.2: 2)");
assert_eq(HVec3_z(_w3_mn_ab), _w3_nz, "v3 min(-0, +0) is -0 (3.3.2: +0)");
assert_eq(HVec3_z(_w3_mn_ba), _w3_nz, "v3 min(+0, -0) is -0");
assert_eq(HVec3_z(_w3_mx_ab), 0, "v3 max(-0, +0) is +0");
assert_eq(HVec3_z(_w3_mx_ba), 0, "v3 max(+0, -0) is +0 (3.3.2: -0)");
# Two NaNs: the first argument's, bits and all.
var _w3_vn1 = hvec3_new(_w3_nan, _w3_nan2, 0);
var _w3_vn2 = hvec3_new(_w3_nan2, _w3_nan, 0);
assert_eq(HVec3_x(hvec3_min(_w3_vn1, _w3_vn2)), _w3_nan, "v3 min(NaN, NaN') is the first NaN");
assert_eq(HVec3_y(hvec3_min(_w3_vn1, _w3_vn2)), _w3_nan2, "v3 min(NaN', NaN) is the first NaN");
assert_eq(HVec3_x(hvec3_max(_w3_vn1, _w3_vn2)), _w3_nan, "v3 max(NaN, NaN') is the first NaN");
assert_eq(HVec3_y(hvec3_max(_w3_vn1, _w3_vn2)), _w3_nan2, "v3 max(NaN', NaN) is the first NaN");
# Infinities, equal operands and like-signed zeros keep their values in both orders.
var _w3_vi = hvec3_new(F64_POS_INF, f64_from(5), _w3_nz);
var _w3_vj = hvec3_new(f64_neg(F64_POS_INF), f64_from(5), _w3_nz);
assert_eq(HVec3_x(hvec3_min(_w3_vi, _w3_vj)), f64_neg(F64_POS_INF), "v3 min(+Inf, -Inf) is -Inf");
assert_eq(HVec3_x(hvec3_min(_w3_vj, _w3_vi)), f64_neg(F64_POS_INF), "v3 min(-Inf, +Inf) is -Inf");
assert_eq(HVec3_x(hvec3_max(_w3_vi, _w3_vj)), F64_POS_INF, "v3 max(+Inf, -Inf) is +Inf");
assert_eq(HVec3_x(hvec3_max(_w3_vj, _w3_vi)), F64_POS_INF, "v3 max(-Inf, +Inf) is +Inf");
assert_eq(HVec3_y(hvec3_min(_w3_vi, _w3_vj)), f64_from(5), "v3 min(5, 5) is 5");
assert_eq(HVec3_y(hvec3_max(_w3_vi, _w3_vj)), f64_from(5), "v3 max(5, 5) is 5");
assert_eq(HVec3_z(hvec3_min(_w3_vi, _w3_vj)), _w3_nz, "v3 min(-0, -0) is -0");
assert_eq(HVec3_z(hvec3_max(_w3_vi, _w3_vj)), _w3_nz, "v3 max(-0, -0) is -0");

# abs
var v3abs = hvec3_abs(hvec3_new(f64_neg(f64_from(3)), f64_from(4), f64_neg(f64_from(5))));
assert_eq(HVec3_x(v3abs), f64_from(3), "v3 abs.x");
assert_eq(HVec3_y(v3abs), f64_from(4), "v3 abs.y");
assert_eq(HVec3_z(v3abs), f64_from(5), "v3 abs.z");

# reflect: v=(1,-1,0) about n=(0,1,0) should give (1,1,0)
var v3refl_v = hvec3_new(F64_ONE, f64_neg(F64_ONE), 0);
var v3refl_n = hvec3_unit_y();
var v3refl = hvec3_reflect(v3refl_v, v3refl_n);
assert_eq(HVec3_x(v3refl), f64_from(1), "v3 reflect.x");
assert_eq(HVec3_y(v3refl), f64_from(1), "v3 reflect.y");
assert_eq(HVec3_z(v3refl), f64_from(0), "v3 reflect.z");

# reflect: perpendicular to normal unchanged, parallel component negated
# v=(0,1,0) about n=(0,1,0) -> (0,-1,0)
var v3refl2 = hvec3_reflect(hvec3_unit_y(), hvec3_unit_y());
assert_eq(HVec3_y(v3refl2), f64_neg(f64_from(1)), "v3 reflect parallel");

