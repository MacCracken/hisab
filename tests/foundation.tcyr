test_group("vec4 construction");

var v4z = hvec4_zero();
assert_eq(HVec4_x(v4z), f64_from(0), "v4 zero.x");
assert_eq(HVec4_y(v4z), f64_from(0), "v4 zero.y");
assert_eq(HVec4_z(v4z), f64_from(0), "v4 zero.z");
assert_eq(HVec4_w(v4z), f64_from(0), "v4 zero.w");

var v4o = hvec4_one();
assert_eq(HVec4_x(v4o), f64_from(1), "v4 one.x");
assert_eq(HVec4_y(v4o), f64_from(1), "v4 one.y");
assert_eq(HVec4_z(v4o), f64_from(1), "v4 one.z");
assert_eq(HVec4_w(v4o), f64_from(1), "v4 one.w");

# new
var v4a = hvec4_new(f64_from(1), f64_from(2), f64_from(3), f64_from(4));
assert_eq(HVec4_x(v4a), f64_from(1), "v4 new.x");
assert_eq(HVec4_y(v4a), f64_from(2), "v4 new.y");
