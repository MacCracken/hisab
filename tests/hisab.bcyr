# Worst-case BVH input: every AABB coincident, so every center equals the split
# midpoint and the median fallback is the only thing keeping the build linear.
# Pre-2.7.0 this degenerated to a 1-vs-(n-1) split -- O(n) depth, O(n^2) work.
# ---- 2.7.0-L: permanent benchmarks for the hot public paths that had none.
# Every function repaired in 2.7.0-I/J/K, and every target of a withheld
# performance patch, was previously invisible to bench-history.csv -- so a
# regression in any of them could not be seen. Sizes are chosen to run in tens
# of ms and to stay well inside the bump arena (it never frees).

# Narrowphase fixtures (2.9.0)
var _b_np_box_a = 0;
var _b_np_box_b = 0;
var _b_np_sph_a = 0;
var _b_np_sph_b = 0;
var _b_np_n = 0;
var _b_np_d = 0;
var _b_gi_box_far = 0;
var _b_gi_sph_far = 0;
var _b_gi_box_tan = 0;

fn _b_box_axis(c, h, d) {
    if (f64_lt(d, 0) == 1) { return f64_sub(c, h); }
    return f64_add(c, h);
}

fn _b_sup_box(shape, dir) {
    return hvec3_new(_b_box_axis(load64(shape), load64(shape + 24), HVec3_x(dir)),
    _b_box_axis(load64(shape + 8), load64(shape + 32), HVec3_y(dir)),
    _b_box_axis(load64(shape + 16), load64(shape + 40), HVec3_z(dir)));
}

fn _b_sup_sph(shape, dir) {
    var c = hvec3_new(load64(shape), load64(shape + 8), load64(shape + 16));
    var l = hvec3_length(dir);
    if (f64_gt(l, 0) == 0) { return c; }
    return hvec3_add(c, hvec3_scale(dir, f64_div(load64(shape + 24), l)));
}

fn _b_np_mkbox(cx, cy, cz, hx, hy, hz) {
    var s = alloc(48);
    store64(s, cx);
    store64(s + 8, cy);
    store64(s + 16, cz);
    store64(s + 24, hx);
    store64(s + 32, hy);
    store64(s + 40, hz);
    return s;
}

