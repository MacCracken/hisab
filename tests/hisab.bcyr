# ================================================================
# 3.4.0 lane NU2
# ================================================================
# The paths lane NU2's repairs changed that no row timed: the dual ln / sqrt / abs guards
# (a NaN now propagates past the domain test), num_bisection's exit at a tol below the
# spacing of the doubles (53 bisections to adjacent ends, then 147 that move nothing, and
# the adjacency acceptance), num_bisection on [-DBL_MAX, DBL_MAX] (the wide midpoint, then
# 1075 bisections in all to the exact root), and expr_eval_checked refusing an unbound leaf. Registered
# last, after the 3.3.7 rows, for the heap-shift reason documented above the jac_rev pair;
# _bnu2_setup checks each row's path once before any of them is timed.
var _BNU2_FAIL = 0;

fn _bnu2_check(ok, name) {
    if (ok == 1) { return 0; }
    syscall(1, 1, "FATAL: 3.4.0 lane NU2 row ", 26);
    syscall(1, 1, name, strlen(name));
    println(" does not take the path its name says");
    _BNU2_FAIL = _BNU2_FAIL + 1;
    return 1;
}

var _bnu2_unb = 0;
fn bench_dual_ln() { return dual_ln(_b6_dx); }
fn bench_dual_sqrt() { return dual_sqrt(_b6_dx); }
fn bench_dual_abs() { return dual_abs(_b6_dx); }
fn bench_num_bisection_stall() {
    var t, v = num_bisection(&_b7_x2m2, 0, F64_TWO, 1, 200, _b7_out);   # tol 2^-1074
    return t;
}
fn _bnu2_xmc(x) { return f64_sub(x, 0x3FF3C0CA428C59FB); }
fn bench_num_bisection_wide() {
    var t, v = num_bisection(&_bnu2_xmc, 0xFFEFFFFFFFFFFFFF, 0x7FEFFFFFFFFFFFFF, 1, 1100, _b7_out);
    return t;
}
fn bench_expr_eval_unbound() {
    var t, v = expr_eval_checked(_bnu2_unb, _b6_vars);
    return v;
}

fn _bnu2_setup() {
    _bnu2_check(Dual_val(bench_dual_ln()) == f64_ln(Dual_val(_b6_dx)), "dual_ln");
    _bnu2_check(Dual_val(bench_dual_sqrt()) == f64_sqrt(Dual_val(_b6_dx)), "dual_sqrt");
    _bnu2_check(Dual_deriv(bench_dual_abs()) == Dual_deriv(_b6_dx), "dual_abs");
    _bnu2_check(bench_num_bisection_stall() == 0 && load64(_b7_out) == 0x3FF6A09E667F3BCC, "num_bisection_stall");
    _bnu2_check(bench_num_bisection_wide() == 0 && load64(_b7_out) == 0x3FF3C0CA428C59FB, "num_bisection_wide");
    # The whole bound tree, then one unbound leaf: the Err comes back from the last leaf.
    _bnu2_unb = expr_add(_b6_e, expr_var(str_from("u")));
    _bnu2_check(bench_expr_eval_unbound() == HSB_ERR_INVALID_INPUT, "expr_eval_unbound");
    return _BNU2_FAIL;
}

fn _bnu2_rows() {
    bench("dual_ln",                        &bench_dual_ln,                   100000);
    bench("dual_sqrt",                      &bench_dual_sqrt,                 100000);
    bench("dual_abs",                       &bench_dual_abs,                  100000);
    bench("num_bisection_stall",            &bench_num_bisection_stall,        20000);
    bench("expr_eval_unbound",              &bench_expr_eval_unbound,         100000);
    bench("num_bisection_wide",             &bench_num_bisection_wide,          2000);
    return 0;
}

# 3.4.0 lane LA -- eigen_power's diagonal spectrum and scaled frame, lyapunov_max's scaled QR,
# svd_compute_checked. Fixtures are allocated in _bla_setup and checked there; the rows are
# REGISTERED LAST, after the 3.3.7 block, for the heap-shift reason documented above.
var _BLA_FAIL = 0;
var _bla_tri = 0;
var _bla_tiny = 0;
var _bla_ly = 0;
var _bla_sv = 0;
var _bla_U = 0;
var _bla_S = 0;
var _bla_Vt = 0;
