fn _b6_fill(p, n, seed) {
    for (var k = 0; k < n; k = k + 1) {
        store64(p + k * 8, _b6_q(((k * seed + 13) % 97) - 48, 113));
    }
    return p;
}

fn _b6_scaled_box(s, k) {
    var r = alloc(48);
    for (var i = 0; i < 6; i = i + 1) { store64(r + i * 8, f64_mul(load64(s + i * 8), k)); }
    return r;
}

# The 3.3.5 Delaunay A/B harness's generator (SplitMix64, seed 11), copied so the
# mixed-magnitude set is the one that harness timed.
var _b6_sm = 0;
fn _b6_sm_next() {
    _b6_sm = _b6_sm + 0x9E37_79B9_7F4A_7C15;
    var z = _b6_sm;
    z = (z ^ (z >> 30)) * 0xBF58_476D_1CE4_E5B9;
    z = (z ^ (z >> 27)) * 0x94D0_49BB_1331_11EB;
    return z ^ (z >> 31);
}
fn _b6_sm_unit() { return f64_mul(f64_from(_b6_sm_next() >> 11), 0x3CA0_0000_0000_0000); }

fn _b6_setup() {
    _b6_k037 = _b6_q(37, 100);
    _b6_k37 = _b6_q(37, 10);
    _b6_k001 = _b6_q(1, 100);
    _b6_k073 = _b6_q(73, 100);
    _b6_k03 = _b6_q(3, 10);
    _b6_k01 = _b6_q(1, 10);
    _b6_k11 = _b6_q(11, 10);
    _b6_k099 = _b6_q(99, 100);
    _b6_k4 = f64_from(4);
    _b6_k10 = f64_from(10);
    # mat3 / vec
    _b6_m3a = m3_from_cols(hvec3_new(_b6_q(11, 10), _b6_q(3, 10), _b6_q(0 - 7, 10)),
      hvec3_new(_b6_q(2, 10), _b6_q(19, 10), _b6_q(4, 10)),
      hvec3_new(_b6_q(0 - 5, 10), _b6_q(6, 10), _b6_q(23, 10)));
    _b6_m3b = m3_from_quat(_bq2);
    _b6_v3 = hvec3_new(_b6_q(13, 10), _b6_q(0 - 27, 10), _b6_q(6, 10));
    # interval: mixed signs for mul; sin and width on the 3.3.5 numerics harness's
    _b6_iva = ivl_new(_b6_q(0 - 13, 10), _b6_q(27, 10));
    _b6_ivb = ivl_new(_b6_q(0 - 6, 10), _b6_q(9, 10));
    _b6_ivs = ivl_new(_b6_q(1, 10), F64_HALF);
    _b6_ivw = ivl_new(0xBFEECB1B1DA1541F, 0x3FE77330BD8D4A70);
    # cubic B-spline / NURBS, 8 control points, clamped uniform knots
    _b6_bs_pts = alloc(8 * 8);
    _b6_bs_w = alloc(8 * 8);
    for (var bi = 0; bi < 8; bi = bi + 1) {
        store64(_b6_bs_pts + bi * 8, hvec3_new(f64_from(bi), _b6_q((bi * 37) % 11, 7), _b6_q((bi * 53) % 13, 9)));
        store64(_b6_bs_w + bi * 8, _b6_q(10 + (bi * 7) % 5, 10));
    }
    _b6_bs_knots = alloc(12 * 8);
    for (var ki = 0; ki < 12; ki = ki + 1) {
        var kv = ki - 3;
        if (kv < 0) { kv = 0; }
        if (kv > 5) { kv = 5; }
        store64(_b6_bs_knots + ki * 8, _b6_q(kv, 5));
    }
    _b6_hx = alloc(32);
    store64(_b6_hx, _b6_q(7, 10));
    store64(_b6_hx + 8, _b6_q(0 - 13, 10));
    store64(_b6_hx + 16, _b6_q(4, 10));
    store64(_b6_hx + 24, _b6_q(3, 10));
    _b6_hout = alloc(16 * 8);
    # diffgeo, dim 4: generic non-flat data (finite, full mantissas)
    _b6_dg_ginv = _b6_fill(alloc(16 * 8), 16, 31);
    for (var gi = 0; gi < 4; gi = gi + 1) {
        store64(_b6_dg_ginv + (gi * 4 + gi) * 8, f64_add(F64_ONE, load64(_b6_dg_ginv + (gi * 4 + gi) * 8)));
    }
    _b6_dg_dg = _b6_fill(alloc(64 * 8), 64, 17);
    _b6_dg_chr = christoffel_symbols(_b6_dg_ginv, _b6_dg_dg, 4);
    _b6_dg_chd = _b6_fill(alloc(256 * 8), 256, 23);
    var gpos = _b6_fill(alloc(32), 4, 7);
    var gvel = _b6_fill(alloc(32), 4, 11);
    _b6_dg_state = geodesic_state_new(gpos, gvel, 4);
    # Lie groups
    _b6_w3 = hvec3_new(_b6_q(37, 100), _b6_q(0 - 121, 100), _b6_q(58, 100));
    _b6_lin3 = hvec3_new(_b6_q(9, 10), _b6_q(0 - 4, 10), _b6_q(17, 10));
    _b6_su2 = su2_exp(_b6_w3);
    _b6_so3 = so3_exp(_b6_w3);
    _b6_tw = se3_twist_new(_b6_w3, _b6_lin3);
    _b6_se3 = se3_exp(_b6_tw);
    _b6_bdir = hvec3_new(_b6_q(3, 10), _b6_q(0 - 5, 10), _b6_q(81, 100));
    # ode / optimize
    _b6_oy = alloc(8);
    _b6_oerr = alloc(8);
    _b6_rx0 = alloc(16);
    store64(_b6_rx0, _b6_q(0 - 12, 10));
    store64(_b6_rx0 + 8, F64_ONE);
    _b6_rx = alloc(16);
    _b6_rf = alloc(8);
    _b6_lm_t = alloc(32 * 8);
    _b6_lm_y = alloc(32 * 8);
    _b6_lm_r = alloc(32 * 8);
    for (var li = 0; li < 32; li = li + 1) {
        var lt = _b6_q(li, 8);
        store64(_b6_lm_t + li * 8, lt);
        store64(_b6_lm_y + li * 8, f64_mul(_b6_q(5, 2), f64_exp(f64_mul(_b6_q(0 - 13, 10), lt))));
    }
    _b6_lm_x0 = alloc(16);
    store64(_b6_lm_x0, F64_ONE);
    store64(_b6_lm_x0 + 8, f64_neg(F64_HALF));
    _b6_lm_x = alloc(16);
    # symbolic: x^3 y + sin(x) exp(x) - ln(x); an integrable sum; sin^2 + cos^2 + x x
    _b6_xname = str_from("x");
    var sx = expr_var(_b6_xname);
    var sy = expr_var(str_from("y"));
    var c2 = expr_const(F64_TWO);
    var c3 = expr_const(f64_from(3));
    _b6_e = expr_add(expr_add(expr_mul(expr_pow(sx, c3), sy), expr_mul(expr_sin(sx), expr_exp(sx))),
      expr_neg(expr_ln(sx)));
    _b6_vars = vec_new();
    vec_push(_b6_vars, expr_bind(_b6_xname, _b6_q(13, 10)));
    vec_push(_b6_vars, expr_bind(str_from("y"), _b6_q(7, 10)));
    _b6_ie = expr_add(expr_add(expr_mul(c3, expr_pow(sx, c2)), expr_sin(sx)),
      expr_add(expr_cos(sx), expr_exp(sx)));
    _b6_re = expr_add(expr_add(expr_pow(expr_sin(sx), c2), expr_pow(expr_cos(sx), c2)), expr_mul(sx, sx));
    _b6_rules = sym_default_rules();
    # linalg_ext: a 256 x 256 tridiagonal CSR; the Krylov system and its RHS
    var cd = ganita_mat_new(256, 256);
    for (var ci = 0; ci < 256; ci = ci + 1) {
        for (var cj = 0; cj < 256; cj = cj + 1) {
            var cv = 0;
            if (ci == cj) { cv = f64_from(4); }
            if (ci == cj + 1) { cv = f64_neg(F64_ONE); }
            if (cj == ci + 1) { cv = f64_neg(F64_HALF); }
            ganita_mat_set(cd, ci, cj, cv);
        }
    }
    _b6_csr = csr_from_dense(cd);
    _b6_csr_x = _b6_fill(alloc(256 * 8), 256, 29);
    _b6_mv_out = alloc(64 * 8);
    _b6_kb = _b6_fill(alloc(64 * 8), 64, 41);
    _b6_kx0 = alloc(64 * 8);
    for (var xi = 0; xi < 64; xi = xi + 1) { store64(_b6_kx0 + xi * 8, 0); }
    # eigen: the 12x12 symmetric fixture above; the 3.3.5 eigen_power A/B harness's 3x3,
    # and its 2x2 that takes the wide re-run
    _b6_es_A = ganita_mat_new(12, 12);
    _b6_ep12 = ganita_mat_new(12, 12);
    for (var ei = 0; ei < 12; ei = ei + 1) {
        for (var ej = 0; ej < 12; ej = ej + 1) {
            var ev = f64_from(((ei * 7 + ej * 13) % 17) + ((ej * 7 + ei * 13) % 17) + 2);
            ganita_mat_set(_b6_es_A, ei, ej, ev);
            ganita_mat_set(_b6_ep12, ei, ej, ev);
        }
    }
    _b6_es_vals = alloc(12 * 8);
    _b6_es_vecs = ganita_mat_new(12, 12);
    _b6_ep3 = ganita_mat_new(3, 3);
    for (var pk = 0; pk < 9; pk = pk + 1) { ganita_mat_set(_b6_ep3, pk / 3, pk % 3, 0); }
    ganita_mat_set(_b6_ep3, 0, 0, F64_TWO);
    ganita_mat_set(_b6_ep3, 0, 1, F64_ONE);
    ganita_mat_set(_b6_ep3, 1, 0, F64_ONE);
    ganita_mat_set(_b6_ep3, 1, 1, f64_from(3));
    ganita_mat_set(_b6_ep3, 1, 2, F64_ONE);
    ganita_mat_set(_b6_ep3, 2, 1, F64_ONE);
    ganita_mat_set(_b6_ep3, 2, 2, f64_from(4));
    # ⚠ 3.4.0 review: the 3.3.6 fixture, [[-4.698e-303, 1.368e306], [0, -8.901e-303]], is
    # triangular, and since 3.4.0 eigen_power reads it off the diagonal without iterating, so this
    # row stopped timing the wide run its name says. An IRREDUCIBLE 2 x 2 now: a10 = 12 2^-1074
    # beside a01 = 1.24e308, so the dominant eigenvector (1, 2.8e-314) lives on the subnormal
    # grid, check (b) trips and the wide run follows the plain one (confirmed by a counter in a
    # scratch copy of _lext_power_wide). lambda = 3.4686e-6 to 5.2e-15 (the 2 x 2
    # characteristic polynomial in 60-digit Decimal); |lambda_2 / lambda_1| = 0.05.
    # [measured: LA2 probes w4 (instrumented copy) and w4an.py, cycc 6.7.9, 2026-10-31]
    _b6_epw = ganita_mat_new(2, 2);
    ganita_mat_set(_b6_epw, 0, 0, 0x3ECD18A66812D09C);   # 3.4685479595956936e-06
    ganita_mat_set(_b6_epw, 0, 1, 0x7FE6139D502E2AFA);   # 1.2402183344722128e308
    ganita_mat_set(_b6_epw, 1, 0, 12);                   # 12 * 2^-1074
    ganita_mat_set(_b6_epw, 1, 1, 0xBE87031A9E90D396);   # -1.714536914957281e-07
    _b6_ep_val = alloc(8);
    _b6_ep_vec = alloc(12 * 8);
    # number theory above 2^62: M = 3037000493 * 3037000453
    _b6_crt_r = vec_new();
    vec_push(_b6_crt_r, 12345);
    vec_push(_b6_crt_r, 67890);
    _b6_crt_m = vec_new();
    vec_push(_b6_crt_m, 3037000493);
    vec_push(_b6_crt_m, 3037000453);
    _b6_crt_x = alloc(8);
    _b6_crt_mm = alloc(8);
    _b6_dx = dual_var(_b6_q(137, 100));
    _b6_ang_a = hvec3_new(_b6_q(11, 10), _b6_q(0 - 3, 10), _b6_q(22, 10));
    _b6_ang_b = hvec3_new(_b6_q(4, 10), _b6_q(17, 10), _b6_q(0 - 9, 10));
    # 100 sites, half near 1 and half near 2^100
    _b6_sm = 11;
    _b6_dlm_pts = vec_new();
    for (var mi = 0; mi < 100; mi = mi + 1) {
        var mx = _b6_sm_unit();
        var my = _b6_sm_unit();
        if (mi % 2 == 1) {
            mx = f64_mul(mx, 0x4630_0000_0000_0000);   # 2^100
            my = f64_mul(my, 0x4630_0000_0000_0000);
        }
        vec_push(_b6_dlm_pts, hvec2_new(mx, my));
    }
    # 200 oblique rays through the bvh_query_ray_200x4k scene: no direction
    # component is 0, so every slab divides (that row's rays run along z).
    _b6_obl_rays = alloc(200 * 8);
    for (var ri = 0; ri < 200; ri = ri + 1) {
        var rox = f64_add(f64_from((ri % 16) * 4), F64_HALF);
        var roy = f64_add(f64_from(((ri / 16) % 16) * 4), F64_HALF);
        var rdx = _b6_q(2 * ((ri * 37) % 17) - 17, 97);
        var rdy = _b6_q(2 * ((ri * 53) % 19) - 19, 89);
        store64(_b6_obl_rays + ri * 8,
          geo_ray_new(hvec3_new(rox, roy, f64_from(0 - 20)), hvec3_new(rdx, rdy, F64_ONE)));
    }
    # CGA: an ordinary sphere blade, and the same coefficients times 2^-600 (the
    # power-of-two-copy path 3.3.5 added)
    _b6_cga_s = cga_sphere(_b6_q(13, 10), _b6_q(0 - 27, 10), _b6_q(6, 10), _b6_q(19, 10));
    _b6_cga_t = cga_mv_zero();
    for (var gk = 0; gk < 32; gk = gk + 1) {
        cga_mv_set(_b6_cga_t, gk, f64_mul(cga_mv_get(_b6_cga_s, gk), (1023 - 600) << 52));
    }
    # collision: a sphere pair overlapping by 1e-12 of their radius sum along a
    # generic direction; the box fixtures times 2^600; a closing and an opening motion
    var ndir = hvec3_normalize(hvec3_new(_b6_q(37, 100), _b6_q(0 - 81, 100), _b6_q(452, 1000)));
    var nd = f64_mul(f64_from(4), f64_sub(F64_ONE, 0x3D719799812DEA11));   # 4 (1 - 1e-12)
    _b6_sph_nt = _b_np_mkbox(f64_mul(HVec3_x(ndir), nd), f64_mul(HVec3_y(ndir), nd),
      f64_mul(HVec3_z(ndir), nd), F64_TWO, 0, 0);
    _b6_box_a6 = _b6_scaled_box(_b_np_box_a, 0x6570000000000000);   # 2^600
    _b6_box_b6 = _b6_scaled_box(_b_np_box_b, 0x6570000000000000);
    _b6_box_f6 = _b6_scaled_box(_b_gi_box_far, 0x6570000000000000);
    _b6_v0 = hvec3_zero();
    _b6_vel = hvec3_new(f64_neg(F64_ONE), _b6_q(1, 10), 0);
    _b6_vx = hvec3_new(F64_ONE, 0, 0);
    _b6_toi_t = alloc(8);
    _b6_toi_n = alloc(8);
    _b6_np_n = alloc(8);
    _b6_np_d = alloc(8);

    # Each row's path, checked once (see the block comment above).
    _b6_check(bench_m3_inverse() != 0, "m3_inverse");
    _b6_check(f64_lt(f64_abs(bench_calc_adaptive_simpson()), F64_POS_INF), "calc_adaptive_simpson");
    _b6_check(bench_calc_bspline() != 0, "calc_bspline_cubic_8");
    _b6_check(bench_calc_nurbs() != 0, "calc_nurbs_cubic_8");
    _b6_check(bench_calc_hessian() == 0, "calc_hessian_4");
    _b6_check(_b6_dg_chr != 0, "christoffel_symbols_4d (fixture)");
    _b6_check(bench_christoffel_4d() != 0, "christoffel_symbols_4d");
    _b6_check(bench_riemann_4d() != 0, "riemann_tensor_4d");
    _b6_check(bench_geodesic_rk4_4d() != 0, "geodesic_rk4_4d_100");
    _b6_check(bench_ode_dopri45() == 0, "ode_dopri45_step");
    _b6_check(bench_ode_dopri45_traj() == 0, "ode_dopri45_trajectory");
    _b6_check(bench_opt_lbfgs() == 0, "opt_lbfgs_rosenbrock");
    _b6_check(bench_opt_bfgs() == 0, "opt_bfgs_rosenbrock");
    _b6_check(bench_opt_lm() == 0, "opt_lm_expfit_32");
    _b6_check(bench_sym_integrate() != 0, "sym_integrate");
    _b6_check(bench_sym_rewrite() != _b6_re, "sym_rewrite_default");
    _b6_check(bench_solve_gmres() != 0, "solve_gmres_64");
    _b6_check(bench_solve_bicgstab() != 0, "solve_bicgstab_64");
    _b6_check(bench_eigen_symmetric() == 0, "eigen_symmetric_12");
    _b6_check(bench_num_is_prime_2e63() == 1, "num_is_prime_2e63");
    var pf = bench_num_pollard_rho_2e63();
    _b6_check(pf == 3037000453 || pf == 3037000493, "num_pollard_rho_2e63");
    _b6_check(bench_num_crt_2e63() == 0 && load64(_b6_crt_x) == 8070454606131767350, "num_crt_2e63");
    _b6_check(bench_num_modinv_2e63() == 3689348814741910323, "num_modinv_2e63");
    _b6_check(bench_num_divisor_sigma() == 3249792, "num_divisor_sigma_720720");
    _b6_check(bench_num_divisor_sigma0_2e63() == 96, "num_divisor_sigma0_2e63");
    _b6_check(bench_perlin_2d_2e63() == perlin_2d(0, _b6_q(3, 10)), "perlin_2d_2e63");
    _b6_check(bench_delaunay_2d_mixed() > 0, "delaunay_2d_mixed_100");
    _b6_check(bench_bvh_query_ray_oblique() > 0, "bvh_query_ray_oblique_200x4k");
    _b6_check(cga_mv_get(bench_cga_blade_inverse_tiny(), 1) != 0, "cga_blade_inverse_tiny");
    _b6_check(cga_mv_get(bench_cga_blade_inverse(), 1) != 0, "cga_blade_inverse_sphere");
    _b6_check(bench_eigen_power_3() == 0, "eigen_power_3x3");
    _b6_check(bench_eigen_power_12() == 0, "eigen_power_12x12");
    # 3.4.1: an irreducible 2 x 2 is answered from its characteristic polynomial (`_lext_power_2x2`), so
    # this row now times that path, and its answer is the correctly rounded root (mpmath), where the wide
    # run stopped at 0x3ECD1CFC5377CC71 (42 ulps low); eigen_power_wide3 times the wide run
    # [measured: LA probe w2 (mpmath 80-digit root), 3.4.0 base and this tree, 2026-10-31]
    _b6_check(bench_eigen_power_wide() == 0 && load64(_b6_ep_val) == 0x3ECD1CFC5377CC9B, "eigen_power_2x2_wide");
    _b6_check(bench_mpr_intersect_near_tangent() == 1, "mpr_intersect_near_tangent");
    _b6_check(bench_gjk_intersect_box_miss_2e600() == 0, "gjk_intersect_box_miss_2e600");
    _b6_check(bench_gjk_intersect_box_hit_2e600() == 1, "gjk_intersect_box_hit_2e600");
    _b6_check(bench_gjk_epa_boxes_separated() == 0, "gjk_epa_boxes_separated");
    _b6_check(bench_gjk_epa_spheres_separated() == 0, "gjk_epa_spheres_separated");
    _b6_check(bench_mpr_penetration_boxes_separated() == 0, "mpr_penetration_boxes_separated");
    _b6_check(bench_toi_sph_hit() == 1, "time_of_impact_sph_hit");
    _b6_check(bench_toi_box_miss() == 0, "time_of_impact_box_miss");
    return _B6_FAIL;
}

