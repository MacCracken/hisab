# Amplified (batch) SIMD benchmarks: N ops per timed call. Written for 2.3.1, when
# bench() paid a clock pair per call and a single op sat under it, so the f64v SIMD
# wins could not show. Since cyrius 6.5.19 the floor is calibrated per run, printed on
# the `[timer floor ...]` line and subtracted, and bench_run sizes its own chunks, so
# these rows stay for their bench-history.csv record, not to escape the floor. No
# single floor figure holds across hosts or boots (see bench_batch above).
fn bench_vec3_dot_x64() {
    var i = 0; var acc = 0;
    while (i < 64) { acc = acc + f64_to(hvec3_dot(_bv3a, _bv3b)); i = i + 1; }
    return acc;
}
fn bench_vec4_dot_x64() {
    var i = 0; var acc = 0;
    while (i < 64) { acc = acc + f64_to(hvec4_dot(_bv4a, _bv4b)); i = i + 1; }
    return acc;
}
