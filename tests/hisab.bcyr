# ---- 2.8.3: EPA narrowphase. gjk_epa_3d had no benchmark at all, which is how
# an O(k^2) polytope rebuild (8,576 face-plane evaluations and 1.47 MB of
# never-freed arena for ONE call) stayed invisible. This fixture is the
# cylinder-vs-rotated-box pair the audit filed: curved support against a
# rotated box, so EPA runs its full 64-iteration budget every call and the
# quadratic term is fully expressed.
# [measured: scratch harness, not reproducible in-tree; CHANGELOG.md 2.8.2 records 1.23 MB for this call]
var _b_epa_cyl = 0;
var _b_epa_box = 0;
var _b_epa_n = 0;
var _b_epa_d = 0;

fn _b_epa_sup_cyl(shape, dir) {
    var dx = HVec3_x(dir);
    var dy = HVec3_y(dir);
    var rho = f64_sqrt(f64_add(f64_mul(dx, dx), f64_mul(dy, dy)));
    var px = 0;
    var py = 0;
    if (f64_gt(rho, 0) == 1) {
        px = f64_mul(load64(shape + 24), f64_div(dx, rho));
        py = f64_mul(load64(shape + 24), f64_div(dy, rho));
    }
    var pz = load64(shape + 32);
    if (f64_lt(HVec3_z(dir), 0) == 1) { pz = f64_neg(pz); }
    return hvec3_new(f64_add(load64(shape), px), f64_add(load64(shape + 8), py),
      f64_add(load64(shape + 16), pz));
}

fn _b_epa_sup_obb(shape, dir) {
    var q = hquat_new(load64(shape + 48), load64(shape + 56), load64(shape + 64), load64(shape + 72));
    var ld = hquat_rotate_vec3(hquat_conjugate(q), dir);
    var lx = load64(shape + 24);
    var ly = load64(shape + 32);
    var lz = load64(shape + 40);
    if (f64_lt(HVec3_x(ld), 0) == 1) { lx = f64_neg(lx); }
    if (f64_lt(HVec3_y(ld), 0) == 1) { ly = f64_neg(ly); }
    if (f64_lt(HVec3_z(ld), 0) == 1) { lz = f64_neg(lz); }
    var wp = hquat_rotate_vec3(q, hvec3_new(lx, ly, lz));
    return hvec3_new(f64_add(load64(shape), HVec3_x(wp)),
      f64_add(load64(shape + 8), HVec3_y(wp)),
      f64_add(load64(shape + 16), HVec3_z(wp)));
}

fn bench_gjk_epa_3d() {
    var h = gjk_epa_3d(&_b_epa_sup_cyl, _b_epa_cyl, &_b_epa_sup_obb, _b_epa_box,
      _b_epa_n, _b_epa_d);
}
# 200 ray queries over a four-thousand-box scene. Added 2.8.3 with the t = 0 prune fix:
# the walker no longer discards a node the ray enters exactly at t = 0, so it
# visits strictly MORE nodes than before and the cost of that has to be on the
# record rather than assumed. Half the ray origins sit on a box face, which is
# the case that used to prune an entire subtree for free.
