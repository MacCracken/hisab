# ---- callbacks
fn _b6_x4(x) { var y = f64_mul(x, x); return f64_mul(y, y); }
fn _b6_hess_f(xp) {
    var x0 = load64(xp);
    var x1 = load64(xp + 8);
    var x2 = load64(xp + 16);
    var x3 = load64(xp + 24);
    return f64_add(f64_mul(x0, f64_mul(x1, x1)), f64_mul(f64_sin(x2), f64_exp(x3)));
}
fn _b6_ode_f(t, y) { return f64_sub(f64_sin(t), y); }
fn _b6_ode_stiff(t, y) { return f64_mul(f64_from(0 - 50), f64_sub(y, f64_cos(t))); }
fn _b6_accel(q) { return f64_neg(q); }
# Rosenbrock, the same function, start and tolerance as tests/hisab.tcyr's optimizer
# group, so the row times the run that group asserts converges.
fn _b6_ros_f(xp) {
    var a = load64(xp);
    var t1 = f64_sub(load64(xp + 8), f64_mul(a, a));
    var t2 = f64_sub(F64_ONE, a);
    return f64_add(f64_mul(f64_from(100), f64_mul(t1, t1)), f64_mul(t2, t2));
}
fn _b6_ros_g(xp, out) {
    var a = load64(xp);
    var t1 = f64_sub(load64(xp + 8), f64_mul(a, a));
    store64(out, f64_sub(f64_neg(f64_mul(f64_from(400), f64_mul(a, t1))),
        f64_mul(F64_TWO, f64_sub(F64_ONE, a))));
    store64(out + 8, f64_mul(f64_from(200), t1));
    return 0;
}
# y = a exp(b t) through 32 samples of a = 2.5, b = -1.3: two parameters, 32
# residuals, one reused residual buffer (the solver copies it).
fn _b6_lm_res(xp) {
    var a = load64(xp);
    var b = load64(xp + 8);
    for (var i = 0; i < 32; i = i + 1) {
        var ti = load64(_b6_lm_t + i * 8);
        store64(_b6_lm_r + i * 8, f64_sub(f64_mul(a, f64_exp(f64_mul(b, ti))), load64(_b6_lm_y + i * 8)));
    }
    return _b6_lm_r;
}
fn _b6_lm_jac(xp, out) {
    var a = load64(xp);
    var b = load64(xp + 8);
    for (var i = 0; i < 32; i = i + 1) {
        var ti = load64(_b6_lm_t + i * 8);
        var ex = f64_exp(f64_mul(b, ti));
        store64(out + i * 16, ex);
        store64(out + i * 16 + 8, f64_mul(a, f64_mul(ti, ex)));
    }
    return 0;
}
# Tridiagonal (-1, 4, -1/2), non-symmetric and diagonally dominant, n = 64; one
# reused output buffer, which solve_gmres / solve_bicgstab document as allowed.
fn _b6_mv(xp) {
    for (var i = 0; i < 64; i = i + 1) {
        var s = f64_mul(f64_from(4), load64(xp + i * 8));
        if (i > 0) { s = f64_sub(s, load64(xp + (i - 1) * 8)); }
        if (i < 63) { s = f64_sub(s, f64_mul(F64_HALF, load64(xp + (i + 1) * 8))); }
        store64(_b6_mv_out + i * 8, s);
    }
    return _b6_mv_out;
}

