# THE SIBLING SIZES, so the parity cliff is visible in the suite's own output
# instead of being inferred from a bare ratio. A DCT-II of n points takes a
# length-n DFT and a DST-I of n points takes a length-2(n+1) one, so the two are
# fast at OPPOSITE sizes: at n = 1024 the DCT gets a power-of-two FFT and the DST
# falls to Bluestein, and at n = 1023 they swap. Reading num_dct_1024 next to
# num_dst_1024 alone compares each transform's best case against the other's
# worst. Measured 2.8.4: 297us / 6.9ms at 1024 and 1.64ms / 469us at 1023.
# [measured: scratch run at 2.8.4, not reproducible in-tree; nearby runs: CHANGELOG.md 2.8.4's table, bench-history.csv]
fn bench_num_dct_1023() {
    var e_t, e_v = num_dct(_b_dct_buf, 1023);
    return 0;
}

fn bench_num_dst_1023() {
    var e_t, e_v = num_dst(_b_dct_buf, 1023);
    return 0;
}

# Build a W x W grid mesh: (W-1)^2 quads, each split into 2 triangles.
fn _b_build_grid_mesh(w) {
    var tris = vec_new();
    var gy = 0;
    while (gy < w - 1) {
        var gx = 0;
        while (gx < w - 1) {
            var v00 = gy * w + gx;
            var v10 = v00 + 1;
            var v01 = v00 + w;
            var v11 = v01 + 1;
            vec_push(tris, v00);
            vec_push(tris, v10);
            vec_push(tris, v11);
            vec_push(tris, v00);
            vec_push(tris, v11);
            vec_push(tris, v01);
            gx = gx + 1;
        }
        gy = gy + 1;
    }
    return tris;
}

