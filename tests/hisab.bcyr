# `ray_obb` had NO benchmark before 2.10.1 -- the only ray primitive without one,
# and the most expensive of the six (geo_obb_axes rotates three unit vectors and
# allocates per call). Nothing would have measured a regression in it.
# [measured: bench-history.csv ray_obb]
# 2.11.0: the one number that justifies reverse mode. Both rows compute the FULL
# gradient of the same 16-input scalar; forward mode needs one pass per input and
# reverse mode needs one sweep, so the ratio is the feature.
#
# ⚠ The forward row must do the SAME work -- all 16 partials, not one. Timing a
# single dual pass against a full reverse sweep would flatter reverse mode by 16x
# for free, which is the fixture fault this repo keeps catching.
# [measured: bench-history.csv grad_rev_16]
#
# Measured: 66.46 us against 5.92 us, **11.2x**, not the theoretical 16x --
# reverse mode pays to RECORD the tape before it can sweep it. ⚠ Part of the gap
# is allocation, not arithmetic: every dual_* op heap-allocates a 16-byte Dual
# under an allocator that never frees, while the reverse row calls
# ad_tape_reset and writes into memory it already owns. That is a real and
# permanent cost of the dual design rather than an artefact of the fixture -- it
# is the same objection geo_diff.cyr's header raises -- but the ratio is a
# property of the two IMPLEMENTATIONS, not of forward versus reverse in the
# abstract, and it is stated that way.
# [measured: bench-history.csv grad_rev_16]
fn _b_ad_body_fwd(which) {
    var acc = dual_const(0);
    for (var i = 0; i < _AD_N; i = i + 1) {
        var xi = dual_const(load64(_b_adx + i * 8));
        if (i == which) { xi = dual_var(load64(_b_adx + i * 8)); }
        acc = dual_add(acc, dual_mul(dual_sin(xi), dual_exp(xi)));
    }
    return Dual_deriv(acc);
}

enum JacBench { _B_JAC_N = 8; _B_JAC_M = 256 }
var _b_jac_ids = alloc(_B_JAC_N * 8);
var _b_jac_roots = alloc(_B_JAC_M * 8);
var _b_jac_out = alloc(_B_JAC_N * 8);
# ⛔ 3.1.0: THE THREE REVERSE-MODE ROWS DISCARDED A `Result`. `ad_grad` and
# `ad_grad_into` are fallible (AD_FULL on a tape that is too small — the
# exact defect 2.20.0's pre-tag audit found in THESE rows), and every site
# either dropped the return or bound it and never read the tag. A row that
# swallows an Err measures the failed operation and reports success. Found
# when `ad_grad_into` gained the `#must_use` it always should have had.
# Each site now counts failures here; main() refuses to exit 0 while it is
# non-zero, the same shape as the cold-row guard below. Mutation-proven: with
# the shared tape shrunk back to the 2.20.0 size the row reads 333 us against
# 1,114 us and the harness exits 1.
# [measured: undersized-tape mutant on this harness, 2026-09-13]
var _B_AD_FAIL = 0;

fn bench_grad_fwd_16() {
    for (var w = 0; w < _AD_N; w = w + 1) { var g = _b_ad_body_fwd(w); }
    return 0;
}

fn bench_grad_rev_16() {
    ad_tape_reset(_b_tape);
    var acc = ad_const(_b_tape, 0);
    for (var i = 0; i < _AD_N; i = i + 1) {
        var xi = ad_var(_b_tape, load64(_b_adx + i * 8));
        acc = ad_add(_b_tape, acc, ad_mul(_b_tape, ad_sin(_b_tape, xi), ad_exp(_b_tape, xi)));
    }
    var rc_t, rc_v = ad_grad(_b_tape, acc);
    if (rc_t != 0) { _B_AD_FAIL = _B_AD_FAIL + 1; }
    return 0;
}

# ⛔ 2.20.0: THE JACOBIAN TRAP, AS A PAIR OF ROWS. Reverse mode's intended pairing
# is `opt_levenberg_marquardt`'s `jacobian` callback -- m residuals, n params --
# and the obvious driver (build all m on ONE shared tape, sweep per residual) is
# **O(m^2)**, because `ad_grad` clears and scans the WHOLE tape every call. The
# per-residual reset is O(m) and uses only shipped API.
# ⚠ These two rows exist so the gap is TRACKED rather than rediscovered. They must
# be read as a PAIR and never as a constant speedup: the ratio is m-dependent --
# measured 5x at m = 256 and 47x at m = 2048 on correctly sized tapes, growing
# without bound, because one side is quadratic and the other linear. This note
# said 2x and 12x through 3.3.1: those came from the first probe, whose tape was
# truncated (CHANGELOG 2.20.0, autodiff, corrected the figures; the table is
# above ad_grad in src/autodiff.cyr).
# [measured: shared vs per-tape drivers, n=8, m=64..2048, correctly-sized tapes]
fn _b_jac_shared() {
    # ⛔ SIZED FROM THE NODES ACTUALLY PUSHED, NOT A GUESS. The first version of
    # this row read `_B_JAC_N + 4 * _B_JAC_M + 8` = 1040 while the loop pushes
    # N inputs + M*(N-1 adds + 1 mul) = 2056, so `_ad_push` returned AD_FULL for
    # half the residuals and the benchmark timed HALF THE WORK while reporting
    # success — a benchmark on its own truncated case.
    var t = ad_tape_new(_B_JAC_N + _B_JAC_M * _B_JAC_N + 8);
    if (t == 0) { return 0; }
    var ids = _b_jac_ids;
    for (var i = 0; i < _B_JAC_N; i = i + 1) {
        store64(ids + i * 8, ad_var(t, f64_from(i + 1)));
    }
    var roots = _b_jac_roots;
    for (var j = 0; j < _B_JAC_M; j = j + 1) {
        var acc = load64(ids);
        for (var k = 1; k < _B_JAC_N; k = k + 1) {
            acc = ad_add(t, acc, load64(ids + k * 8));
        }
        store64(roots + j * 8, ad_mul(t, acc, load64(ids)));
    }
    for (var j2 = 0; j2 < _B_JAC_M; j2 = j2 + 1) {
        var gt, gv = ad_grad_into(t, load64(roots + j2 * 8), ids, _B_JAC_N, _b_jac_out);
        if (gt != 0) { _B_AD_FAIL = _B_AD_FAIL + 1; }
    }
    return 0;
}

fn _b_jac_pertape() {
    var t = ad_tape_new(_B_JAC_N + 8);
    if (t == 0) { return 0; }
    var ids = _b_jac_ids;
    for (var j = 0; j < _B_JAC_M; j = j + 1) {
        ad_tape_reset(t);
        for (var i = 0; i < _B_JAC_N; i = i + 1) {
            store64(ids + i * 8, ad_var(t, f64_from(i + 1)));
        }
        var acc = load64(ids);
        for (var k = 1; k < _B_JAC_N; k = k + 1) {
            acc = ad_add(t, acc, load64(ids + k * 8));
        }
        var pt, pv = ad_grad_into(t, ad_mul(t, acc, load64(ids)), ids, _B_JAC_N, _b_jac_out);
        if (pt != 0) { _B_AD_FAIL = _B_AD_FAIL + 1; }
    }
    return 0;
}

fn bench_jac_rev_shared_256() { return _b_jac_shared(); }
fn bench_jac_rev_pertape_256() { return _b_jac_pertape(); }

