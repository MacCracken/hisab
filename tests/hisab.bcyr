    bench("delaunay_2d_mixed_100",     &bench_delaunay_2d_mixed,          20);
    bench("bvh_query_ray_oblique_200x4k", &bench_bvh_query_ray_oblique,  20);
    bench("cga_blade_inverse_sphere",  &bench_cga_blade_inverse,       20000);
    bench("cga_blade_inverse_tiny",    &bench_cga_blade_inverse_tiny,  20000);
    bench("eigen_power_3x3",           &bench_eigen_power_3,             200);
