# 3.4.0: the solvers are solve_*_checked, whose tol is relative to ||b||. These rows pass
# 1e-10 / ||b||, so the stopping threshold is 3.3.7's absolute 1e-10 to the rounding of one
# divide and one multiply, and the rows keep timing the same solve.
var _B6_KTOL = 0;
fn _b6_ktol() {
    if (_B6_KTOL == 0) { _B6_KTOL = f64_div(0x3DDB7CDFD9D7BDBB, _lext_norm(_b6_kb, 64)); }
    return _B6_KTOL;
}
