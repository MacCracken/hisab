}
fn _bco6_rows() {
    bench("co6_gjk_epa_cyl_rim",       &bench_co6_epa_cyl_rim,       2000);
    bench("co6_sequential_impulse_top", &bench_co6_si_top,         100000);
    bench("co6_cga_norm_tier",         &bench_co6_cga_norm_tier,   100000);
    bench("co6_sdf_capsule_exact",     &bench_co6_sdf_capsule_exact, 50000);
    return 0;
}

# ================================================================
# 3.4.1 lane LA3 -- the review-repair pass's paths: the exact singularity test on rank-(n-1)
# integer matrices (true bit lengths, the per-row update), on a weighted-cycle Laplacian, and on a
# matrix unlucky at all four tabled primes (Dixon at the fifth); eigen_power's 2 x 2 through the
# float filter (ordinary and full-range entries) and through the exact path (a midpoint tie), its
# block solve with the exact determinant, and the deflated certificate on a 60 x 60 (squarings by
# f64v_scale and f64v_add); inertia_sphere / inertia_box ordinary and past the normal range. Each row's path is
# checked in _b41la3_setup.
# ================================================================
var _B41LA3_FAIL = 0;
var _b41la3_gram = 0;
var _b41la3_lap = 0;
var _b41la3_unl = 0;
var _b41la3_o2 = 0;
var _b41la3_f2 = 0;
var _b41la3_t2 = 0;
var _b41la3_n1 = 0;
var _b41la3_tri = 0;
var _b41la3_val = 0;
var _b41la3_vec = 0;
var _b41la3_rw = 0;
fn _b41la3_check(ok, name) {
    if (ok == 1) { return 0; }
    syscall(1, 1, "FATAL: 3.4.1 row ", 17);
    syscall(1, 1, name, strlen(name));
    println(" does not take the path its name says");
    _B41LA3_FAIL = _B41LA3_FAIL + 1;
    return 1;
}
var _b41la3_s = 777;
fn _b41la3_u() {
    _b41la3_s = _b41la3_s * 6364136223846793005 + 1442695040888963407;
    return f64_sub(f64_div(f64_from((_b41la3_s >> 11) & 0xFFFFFFFFFFFF), f64_from(0x800000000000)), F64_ONE);
}
fn _b41la3_m(n, vals) {
    var M = ganita_mat_new(n, n);
    for (var k = 0; k < n * n; k = k + 1) { ganita_mat_set(M, k / n, k % n, f64_from(load64(vals + k * 8))); }
    return M;
}
fn bench_cond_singular_gram30() { return matrix_condition_number(_b41la3_gram); }
fn bench_cond_singular_lap10() { return matrix_condition_number(_b41la3_lap); }
fn bench_cond_singular_unlucky6() { return matrix_condition_number(_b41la3_unl); }
fn bench_eigen_power_2x2_ordinary() {
    var t, v = eigen_power(_b41la3_o2, 2, 1000, _b41la3_val, _b41la3_vec);
    return t;
}
fn bench_eigen_power_2x2_fullrange() {
    var t, v = eigen_power(_b41la3_f2, 2, 1000, _b41la3_val, _b41la3_vec);
    return t;
}
fn bench_eigen_power_2x2_tie() {
    var t, v = eigen_power(_b41la3_t2, 2, 1000, _b41la3_val, _b41la3_vec);
    return t;
}
fn bench_eigen_power_n1_block() {
    var t, v = eigen_power(_b41la3_n1, 3, 1000, _b41la3_val, _b41la3_vec);
    return t;
}
fn bench_eigen_power_tri60_cert() {
    var t, v = eigen_power(_b41la3_tri, 60, 1000, _b41la3_val, _b41la3_vec);
    return t;
}
fn bench_inertia_sphere_unit() { return ganita_mat_get(inertia_sphere(f64_from(10), F64_ONE), 0, 0); }
fn bench_inertia_sphere_wide() { return ganita_mat_get(inertia_sphere(0x2B2BFF2EE48E0530, 0x6146F5D8E8B0BB15), 0, 0); }
fn bench_inertia_box_unit() { return ganita_mat_get(inertia_box(f64_from(12), F64_ONE, F64_TWO, f64_from(3)), 0, 0); }
fn bench_inertia_box_wide() {
    return ganita_mat_get(inertia_box(0x07B8000000000000, F64_ONE, 0x6BB199999999999A, 0x6BA4CCCCCCCCCCCD), 0, 0);
}
fn _b41la3_setup() {
    _b41la3_val = alloc(8);
    _b41la3_vec = alloc(60 * 8);
    _b41la3_rw = alloc(24);
    # Gram X^T X, X 29 x 30 with integer entries -9..9: rank 29, no integer dependency
    var X = alloc(29 * 30 * 8);
    for (var q = 0; q < 29 * 30; q = q + 1) {
        _b41la3_s = _b41la3_s * 6364136223846793005 + 1442695040888963407;
        store64(X + q * 8, ((_b41la3_s >> 33) % 19) - 9);
    }
    var G = alloc(900 * 8);
    for (var i = 0; i < 30; i = i + 1) {
        for (var j = 0; j < 30; j = j + 1) {
            var s = 0;
            for (var l = 0; l < 29; l = l + 1) { s = s + load64(X + (l * 30 + i) * 8) * load64(X + (l * 30 + j) * 8); }
            store64(G + (i * 30 + j) * 8, s);
        }
    }
    _b41la3_gram = _b41la3_m(30, G);
    # R2-LA's weighted 10-cycle (weights 385, 12, 101, 265, 257, 283, 928, 350, 564, 554)
    var w = alloc(10 * 8);
    store64(w, 385); store64(w + 8, 12); store64(w + 16, 101); store64(w + 24, 265); store64(w + 32, 257);
    store64(w + 40, 283); store64(w + 48, 928); store64(w + 56, 350); store64(w + 64, 564); store64(w + 72, 554);
    var L = alloc(100 * 8);
    for (var k = 0; k < 100; k = k + 1) { store64(L + k * 8, 0); }
    for (var c = 0; c < 10; c = c + 1) {
        var c1 = (c + 1) % 10;
        var wc = load64(w + c * 8);
        store64(L + (c * 10 + c1) * 8, load64(L + (c * 10 + c1) * 8) - wc);
        store64(L + (c1 * 10 + c) * 8, load64(L + (c1 * 10 + c) * 8) - wc);
        store64(L + (c * 10 + c) * 8, load64(L + (c * 10 + c) * 8) + wc);
        store64(L + (c1 * 10 + c1) * 8, load64(L + (c1 * 10 + c1) * 8) + wc);
    }
    _b41la3_lap = _b41la3_m(10, L);
    # U diag(p1, p2, p3, p4, 1, 0) V (tests/modules_b.tcyr's, U and V unimodular 0/1): rank 4 modulo
    # each tabled prime, decided at the fifth
    var Uv = alloc(36 * 8);
    store64(Uv + 0, 67108837); store64(Uv + 8, 67108837); store64(Uv + 16, 0);
    store64(Uv + 24, 67108837); store64(Uv + 32, 0); store64(Uv + 40, 67108837);
    store64(Uv + 48, 67108837); store64(Uv + 56, 134217614); store64(Uv + 64, 67108777);
    store64(Uv + 72, 67108837); store64(Uv + 80, 67108777); store64(Uv + 88, 67108837);
    store64(Uv + 96, 0); store64(Uv + 104, 67108777); store64(Uv + 112, 134217534);
    store64(Uv + 120, 67108757); store64(Uv + 128, 67108777); store64(Uv + 136, 67108757);
    store64(Uv + 144, 67108837); store64(Uv + 152, 67108837); store64(Uv + 160, 67108757);
    store64(Uv + 168, 201326347); store64(Uv + 176, 67108753); store64(Uv + 184, 134217594);
    store64(Uv + 192, 0); store64(Uv + 200, 67108777); store64(Uv + 208, 67108777);
    store64(Uv + 216, 67108753); store64(Uv + 224, 134217531); store64(Uv + 232, 1);
    store64(Uv + 240, 67108837); store64(Uv + 248, 67108837); store64(Uv + 256, 67108757);
    store64(Uv + 264, 134217594); store64(Uv + 272, 1); store64(Uv + 280, 134217595);
    _b41la3_unl = _b41la3_m(6, Uv);
    _b41la3_o2 = ganita_mat_new(2, 2);
    ganita_mat_set(_b41la3_o2, 0, 0, F64_TWO);
    ganita_mat_set(_b41la3_o2, 0, 1, F64_ONE);
    ganita_mat_set(_b41la3_o2, 1, 0, F64_HALF);
    ganita_mat_set(_b41la3_o2, 1, 1, f64_from(3));
    _b41la3_f2 = ganita_mat_new(2, 2);
    ganita_mat_set(_b41la3_f2, 0, 0, 0x7FE5EB851EB851EC);
    ganita_mat_set(_b41la3_f2, 0, 1, 0x0171C28F5C28F5C3);
    ganita_mat_set(_b41la3_f2, 1, 0, 0xFE7E666666666666);
    ganita_mat_set(_b41la3_f2, 1, 1, 0x0000000000012345);
    _b41la3_t2 = ganita_mat_new(2, 2);
    ganita_mat_set(_b41la3_t2, 0, 0, 0x4340000000000000);
    ganita_mat_set(_b41la3_t2, 0, 1, 0x4074100000000000);
    ganita_mat_set(_b41la3_t2, 1, 0, 0x42B9852F0D8EC100);
    ganita_mat_set(_b41la3_t2, 1, 1, 0);
    _b41la3_n1 = ganita_mat_new(3, 3);
    ganita_mat_set(_b41la3_n1, 0, 0, 0xBFE9BA8FB982DF6C);
    ganita_mat_set(_b41la3_n1, 0, 1, 0x41301D7564A0AD3D);
    ganita_mat_set(_b41la3_n1, 0, 2, 0xC01279EC7EAFF3F6);
    ganita_mat_set(_b41la3_n1, 1, 0, 0x43C21DCF31A3D669);
    ganita_mat_set(_b41la3_n1, 1, 1, 0x3FF0701C23EC0B37);
    ganita_mat_set(_b41la3_n1, 1, 2, 0x3FEB12CD4C3DFEDB);
    ganita_mat_set(_b41la3_n1, 2, 2, 0x427829F767C45000);
    # 60 x 60 triangular-dominant (lane LA's tri30 family): a_77 = 2, upper 3 u / sqrt(60), lower 0.01 u
    _b41la3_tri = ganita_mat_new(60, 60);
    for (var i2 = 0; i2 < 60; i2 = i2 + 1) {
        for (var j2 = 0; j2 < 60; j2 = j2 + 1) {
            var x = _b41la3_u();
            if (i2 == j2) { ganita_mat_set(_b41la3_tri, i2, j2, x); }
            if (j2 > i2) { ganita_mat_set(_b41la3_tri, i2, j2, f64_mul(x, 0x3FD8C9C9DC9DD7B1)); }   # 3 / sqrt(60)
            if (j2 < i2) { ganita_mat_set(_b41la3_tri, i2, j2, f64_mul(x, 0x3F847AE147AE147B)); }   # 0.01
        }
    }
    ganita_mat_set(_b41la3_tri, 7, 7, F64_TWO);
    var neg1 = f64_neg(F64_ONE);
    _b41la3_check(bench_cond_singular_gram30() == neg1, "cond_singular_gram30");
    _b41la3_check(bench_cond_singular_lap10() == neg1 && load64(&_lext_dz_stat + 8) == 4, "cond_singular_lap10");
    _b41la3_check(bench_cond_singular_unlucky6() == neg1 && load64(&_lext_dz_stat) == 5, "cond_singular_unlucky6");
    _b41la3_check(_lext_p2_fast(F64_TWO, F64_ONE, F64_HALF, f64_from(3), _b41la3_rw) == 0x400AED9EBA16132B
      && is_ok(bench_eigen_power_2x2_ordinary()) == 1, "eigen_power_2x2_ordinary");
    _b41la3_check(_lext_p2_fast(0x7FE5EB851EB851EC, 0x0171C28F5C28F5C3, 0xFE7E666666666666, 0x12345, _b41la3_rw)
      == 0x7FE5EB851EB851EC && is_ok(bench_eigen_power_2x2_fullrange()) == 1, "eigen_power_2x2_fullrange");
    _b41la3_check(_lext_p2_fast(0x4340000000000000, 0x4074100000000000, 0x42B9852F0D8EC100, 0, _b41la3_rw) == 0
      && is_ok(bench_eigen_power_2x2_tie()) == 1 && load64(_b41la3_val) == 0x4340000000000000, "eigen_power_2x2_tie");
    _b41la3_check(is_ok(bench_eigen_power_n1_block()) == 1 && load64(_b41la3_vec + 16) == 0xBC9B20C21994E674,
      "eigen_power_n1_block");
    _b41la3_check(is_ok(bench_eigen_power_tri60_cert()) == 1, "eigen_power_tri60_cert");
    _b41la3_check(bench_inertia_sphere_unit() == f64_from(4), "inertia_sphere_unit");
    _b41la3_check(bench_inertia_sphere_wide() == 0x6DC70FB664EDE14B, "inertia_sphere_wide");
    _b41la3_check(bench_inertia_box_unit() == f64_from(52), "inertia_box_unit");
    _b41la3_check(bench_inertia_box_wide() == 0x5F2A1EB851EB8520, "inertia_box_wide");
    return _B41LA3_FAIL;
}
fn _b41la3_rows() {
    bench("cond_singular_gram30",           &bench_cond_singular_gram30,          200);
    bench("cond_singular_lap10",            &bench_cond_singular_lap10,          2000);
    bench("cond_singular_unlucky6",         &bench_cond_singular_unlucky6,       2000);
    bench("eigen_power_2x2_ordinary",       &bench_eigen_power_2x2_ordinary,    20000);
    bench("eigen_power_2x2_fullrange",      &bench_eigen_power_2x2_fullrange,   20000);
    bench("eigen_power_2x2_tie",            &bench_eigen_power_2x2_tie,         20000);
    bench("eigen_power_n1_block",           &bench_eigen_power_n1_block,        20000);
    bench("eigen_power_tri60_cert",         &bench_eigen_power_tri60_cert,         10);
    bench("inertia_sphere_unit",            &bench_inertia_sphere_unit,        200000);
    bench("inertia_sphere_wide",            &bench_inertia_sphere_wide,        200000);
    bench("inertia_box_unit",               &bench_inertia_box_unit,           200000);
    bench("inertia_box_wide",               &bench_inertia_box_wide,           200000);
    return 0;
}

# ================================================================
# 3.4.1 lane GEO6
# ================================================================
# The rays the second review's repairs send to their new paths, each checked before it is timed: a ray
# 2^-20 off a long capsule's axis from by its end (capc.py nv 1-88: d_perp formed fine, _geo_dperp_fine; s22
# off by 3e6 ulp on its neighbours); a ray tangent to within 2 ulps of a barrel 2^17 radii away, whose discriminant
# _geo_disc_dd cannot certify (bt 1-5: the exact solve; s22 2.9e5 ulp off); a sphere ray carrying 33.87 u^2 of k
# rounding (kfx.py: _geo_sph_comp declines, the exact solve answers; s22 the miss).
# [measured: GEO6 3.4.1 capc.py / capb.py / kfx.py fixtures, exact Fraction oracle, 2026-11-01]
var _bg6_fail = 0;
var _bg6_nr = 0;
var _bg6_nc = 0;
var _bg6_tr = 0;
var _bg6_tc = 0;
var _bg6_sr = 0;
var _bg6_sp = 0;
var _bg6_br = 0;
fn _bg6_check(ok, name) {
    if (ok == 0) {
        println(name);
        _bg6_fail = 1;
    }
    return 0;
}
fn bench_ray_capsule_near_parallel() { return geo_ray_capsule(_bg6_nr, _bg6_nc); }
fn bench_ray_capsule_dd_refused() { return geo_ray_capsule(_bg6_tr, _bg6_tc); }
fn bench_ray_sphere_k_bound() { return geo_ray_sphere(_bg6_sr, _bg6_sp); }
fn _bg6_setup() {
    _bg6_br = alloc(16);
    _bg6_nr = _b8rt_ray(0xBFEBC17F488EB786, 0x3FC95EE9A4CAE2C2, 0x3FE2FDE359F77A46, 0x3F969C37243F5149,
      0xBFEFC18973A17E0F, 0x3FBF0AECCA4522C6);
    _bg6_nc = geo_capsule_new(hvec3_new(0xBFD514FF11C744CC, 0x3FDF7FC481A05330, 0xBFCC96A75E475368),
      hvec3_new(0x40F6BDB212315078, 0xC14FF0704EA60B38, 0x411F38A6C39500C8), 0x3FF9EE928667A539);
    _bg6_check(geo_ray_capsule_branch(_bg6_nr, _bg6_nc, _bg6_br) == 0x41174F34A9EAF722, "ray_capsule_near_parallel");
    _bg6_check(load64(_bg6_br) == GEO_CAP_CYLINDER, "ray_capsule_near_parallel: on the barrel");
    _bg6_tr = _b8rt_ray(0xC0490683F460E424, 0xC03508A4F2D1FEF7, 0x403BC8E7C4B80236, 0x3FE9D34BE474F6D6,
      0x3FD9E8E194684691, 0xBFDB82F77A86C5FB);
    _bg6_tc = geo_capsule_new(hvec3_new(0x3FF9901C00E52BC8, 0x40137E1101D63B28, 0x3FD153D702D5DB78),
      hvec3_new(0x3FF9B45EA22370FB, 0x401387173BEE0E28, 0x3FD1EDA0D1CEA549), 0x3F3FFFFFFFFF9B9B);
    _bg6_check(bench_ray_capsule_dd_refused() == 0x404FFFFFFFFFF995, "ray_capsule_dd_refused");
    _bg6_check(_geo_cap_xsolve(_bg6_tr, _bg6_tc, _bg6_br) == 0x404FFFFFFFFFF995,
      "ray_capsule_dd_refused: the exact solve's answer");
    _bg6_sr = _b8rt_ray(0xC1C1AB210D393844, 0xC18C4D7DD16BCA87, 0xC18CB7F77A863770, 0x3FE047B2BF9CEC6B,
      0x3FAA1422A1F6FD91, 0x3FAA763E5DBD7AC1);
    _bg6_sp = geo_sphere_new(hvec3_new(0xBFE7D7FADE765CA0, 0xBFE009DEFEEE9218, 0xBFDF73F88BD522FC), 0x3E2F8AB50963863C);
    _bg6_check(bench_ray_sphere_k_bound() == 0x41D15D50F776B39F, "ray_sphere_k_bound");
    return _bg6_fail;
}

# 3.4.1 lane NUM4 -- a first trial both of whose lengths are long, recovered by the back-off (f overflows
# for 13 trials), and the bezier extension past the double range of the slope.
var _B341N4_FAIL = 0;
var _B341N4_NF = 0;
var _b341n4_x0 = 0;
var _b341n4_ox = 0;
var _b341n4_of = 0;
fn _b341n4_check(ok, name) {
    if (ok == 1) { return 0; }
    syscall(1, 1, "FATAL: 3.4.1 lane NUM4 row ", 27);
    println(name);
    _B341N4_FAIL = 1;
    return 0;
}
fn _b341n4_f(x) {
    _B341N4_NF = _B341N4_NF + 1;
    return f64_add(0x42D6BCC41E900000, f64_cosh(f64_sub(load64(x), (1023 + 46) << 52)));
}
fn _b341n4_g(x, g) {
    store64(g, f64_sinh(f64_sub(load64(x), (1023 + 46) << 52)));
    return 0;
}
#must_use
fn bench_n4_bfgs_backoff() {
    var t, v = opt_bfgs(&_b341n4_f, &_b341n4_g, _b341n4_x0, 1, 0x3EB0C6F7A0B5ED8D, 200, _b341n4_ox, _b341n4_of);
    return t;
}
fn bench_n4_bezier_ext() {
    return cubic_bezier_ease(0x01A56E1FC2F8F359, 0x7FE1CCF385EBC8A0, F64_HALF, F64_ONE, 0x809C16C5C5253575);
}
fn _b341n4_setup() {
    _b341n4_x0 = alloc(8);
    _b341n4_ox = alloc(8);
    _b341n4_of = alloc(8);
    store64(_b341n4_x0, f64_add((1023 + 46) << 52, F64_ONE));
    var t = bench_n4_bfgs_backoff();
    _b341n4_check(is_ok(t) == 1 && load64(_b341n4_ox) == (1023 + 46) << 52 && _B341N4_NF == 27,
      "opt_bfgs_backoff_2^46");
    _b341n4_check(bench_n4_bezier_ext() == 0xFED754E31CD072DA, "cubic_bezier_ease_ext_slope_overflow");
    return _B341N4_FAIL;
}
fn _b341n4_rows() {
    bench("opt_bfgs_backoff_2^46",                 &bench_n4_bfgs_backoff,  20000);
    bench("cubic_bezier_ease_ext_slope_overflow",  &bench_n4_bezier_ext,   200000);
    return 0;
}

# ================================================================
# 3.4.1 lane CO7
# ================================================================
# Rows for review pass CO7's paths: a ball on a side of a cylinder off every coordinate axis (the
# crease read in its own frame), a ball on a cap 4e-11 of R from the rim (the wider rings), and an
# unclamped -v_t / M at the top of the range (decided on the exact mass sum). Fixtures as
# tests/modules_c.tcyr's "3.4.1 CO7" groups, the first the review's M1 repro.
# [measured: lane CO7 tests/modules_c.tcyr "3.4.1 CO7" groups, the same fixtures; cycc 6.7.18]
var _BCO7_FAIL = 0;
fn _bco7_check(ok, name) {
    if (ok == 1) { return 0; }
    syscall(1, 1, "FATAL: 3.4.1 lane CO7 row ", 26);
    syscall(1, 1, name, strlen(name));
    println(" does not take the path its name says");
    _BCO7_FAIL = _BCO7_FAIL + 1;
    return 1;
}
fn _bco7_cyl(s, d) {
    var c = hvec3_new(load64(s), load64(s + 8), load64(s + 16));
    var u = hvec3_new(load64(s + 24), load64(s + 32), load64(s + 40));
    var hz = load64(s + 56);
    var du = hvec3_dot(d, u);
    var p = hvec3_sub(d, hvec3_scale(u, du));
    p = hvec3_sub(p, hvec3_scale(u, hvec3_dot(p, u)));
    var pl = hvec3_length(p);
    if (f64_gt(pl, f64_mul(hvec3_length(d), 0x3CF0000000000000)) == 1) {
        c = hvec3_add(c, hvec3_scale(p, f64_div(load64(s + 48), pl)));
    }
    if (f64_lt(du, 0) == 1) { hz = f64_neg(hz); }
    return hvec3_add(c, hvec3_scale(u, hz));
}
var _bco7_ct = 0;
var _bco7_bt = 0;
var _bco7_cr = 0;
var _bco7_br = 0;
var _bco7_c = 0;
var _bco7_out = 0;
fn bench_co7_epa_cyl_tilted() {
    gjk_epa_3d(&_bco7_cyl, _bco7_ct, &_b7_sup_sph, _bco7_bt, _b8_n, _b8_d);
    return load64(_b8_d);
}
fn bench_co7_epa_cyl_rim_1e11() {
    gjk_epa_3d(&_bco7_cyl, _bco7_cr, &_b7_sup_sph, _bco7_br, _b8_n, _b8_d);
    return load64(_b8_d);
}
fn bench_co7_si_top_fv() {
    var tg, vv = sequential_impulse(_bco7_c, 1, 1, _bco7_out);
    return load64(_bco7_out + 8);
}
fn _bco7_mk(c0, c1, c2, u0, u1, u2, r, hz) {
    var s = alloc(64);
    store64(s, c0);
    store64(s + 8, c1);
    store64(s + 16, c2);
    store64(s + 24, u0);
    store64(s + 32, u1);
    store64(s + 40, u2);
    store64(s + 48, r);
    store64(s + 56, hz);
    return s;
}
fn _bco7_setup() {
    _bco7_ct = _bco7_mk(0, 0, 0, 0x3FEFA58372CA9CD3, 0x3FC2EB95DE971B3A,
      0xBF867692323D724F, 0x3FD777786FAE75C5, 0x3FF7AA3120CCC240);
    _bco7_bt = hvec4_new(0x3FD2A75B7EFA45CF, 0xBFC86801F7A16A8A, 0xBFE47D5FEBE0E567, 0x3FD3F0470CBA11A2);
    _bco7_cr = _bco7_mk(0x8000000000000000, 0x8000000000000000, 0x8000000000000000, 0x3FF0000000000000, 0,
      0, 0x3FEB48DC69BFF99C, 0x3FF53D76125D8496);
    _bco7_br = hvec4_new(0x3FF54660C84E5B15, 0x3FC4DC070A4B75DA, 0x3FEAC81856CBF428, 0x3F964AC6DA183D79);
    _bco7_c = vec_new();
    vec_push(_bco7_c, contact_new_fric(0, 1, hvec3_unit_y(), 0x43B0000000000000, 0x7E70000000000000, 0,
        0x3FE0D97EDE28CA10, 0x3C87178DD38DA17F, 0xFFE0D97EDE28CA10));
    _bco7_out = alloc(16);
    _bco7_check(bench_co7_epa_cyl_tilted() == 0x3EA37F6E5A140000, "co7_gjk_epa_cyl_tilted");
    _bco7_check(bench_co7_epa_cyl_rim_1e11() == 0x3F9410195DE29DC0, "co7_gjk_epa_cyl_rim_1e11");
    _bco7_check(bench_co7_si_top_fv() == 0x7FEFFFFFFFFFFFFF, "co7_sequential_impulse_fv");
    return _BCO7_FAIL;
}
fn _bco7_rows() {
    bench("co7_gjk_epa_cyl_tilted",    &bench_co7_epa_cyl_tilted,    2000);
    bench("co7_gjk_epa_cyl_rim_1e11",  &bench_co7_epa_cyl_rim_1e11,  2000);
    bench("co7_sequential_impulse_fv", &bench_co7_si_top_fv,       100000);
    return 0;
}

# ================================================================
# 3.4.1 lane LA4 -- the exact singularity test's bound on entries that spread widely: [[B, C], [0, D]]
# with C at 2^980 (the sweep) and a chain of five 6 x 6 blocks under 2^980 (the augmenting paths).
# Each row's path is checked in _b41la4_setup: the digits lifted are the bound's, not the raw one's
# (12 digits on the block and 10 on the chain; through LA3, 574 and 911).
# [measured: LA4 probe bfx.py, these fixtures, 3.4.1-dev and this tree, 2026-11-01]
# ================================================================
var _b41la4_block = 0;
var _b41la4_chain = 0;
var _b41la4_s = 4321;
fn _b41la4_r(k) {
    _b41la4_s = _b41la4_s * 6364136223846793005 + 1442695040888963407;
    return (_b41la4_s >> 33) % k;
}
fn bench_cond_singular_block30() { return matrix_condition_number(_b41la4_block); }
fn bench_cond_singular_chain30() { return matrix_condition_number(_b41la4_chain); }
# U V of rank r at (o, o) of M, each entry of U and V in -3..3
fn _b41la4_uv(M, o, m, r) {
    var U = alloc(m * m * 8);
    var V = alloc(m * m * 8);
    for (var q = 0; q < m * m; q = q + 1) {
        store64(U + q * 8, _b41la4_r(7) - 3);
        store64(V + q * 8, _b41la4_r(7) - 3);
    }
    for (var i = 0; i < m; i = i + 1) {
        for (var j = 0; j < m; j = j + 1) {
            var s = 0;
            for (var t = 0; t < r; t = t + 1) { s = s + load64(U + (i * m + t) * 8) * load64(V + (t * m + j) * 8); }
            ganita_mat_set(M, o + i, o + j, f64_from(s));
        }
    }
    return 0;
}
# an m x m block at (r0, c0) of M, odd 20-bit entries at 2^960
fn _b41la4_wide(M, r0, c0, m) {
    for (var i = 0; i < m; i = i + 1) {
        for (var j = 0; j < m; j = j + 1) {
            ganita_mat_set(M, r0 + i, c0 + j, f64_mul(f64_from(_b41la4_r(1 << 20) | 1), (1023 + 960) << 52));
        }
    }
    return 0;
}
fn _b41la4_setup() {
    var fail = 0;
    var neg1 = f64_neg(F64_ONE);
    _b41la4_block = ganita_mat_new(30, 30);
    _b41la4_uv(_b41la4_block, 0, 15, 14);
    _b41la4_wide(_b41la4_block, 0, 15, 15);
    _b41la4_uv(_b41la4_block, 15, 15, 15);
    _b41la4_chain = ganita_mat_new(30, 30);
    for (var g = 0; g < 5; g = g + 1) {
        var rk = 6;
        if (g == 2) { rk = 5; }
        _b41la4_uv(_b41la4_chain, g * 6, 6, rk);
        if (g < 4) { _b41la4_wide(_b41la4_chain, g * 6, g * 6 + 6, 6); }
    }
    if (bench_cond_singular_block30() != neg1 || load64(&_lext_dz_stat + 8) > 30) {
        println("FATAL: 3.4.1 row cond_singular_block30 does not take the path its name says");
        fail = 1;
    }
    if (bench_cond_singular_chain30() != neg1 || load64(&_lext_dz_stat + 8) > 30) {
        println("FATAL: 3.4.1 row cond_singular_chain30 does not take the path its name says");
        fail = 1;
    }
    return fail;
}

# ================================================================
# 3.4.1 lane SYM4
# ================================================================
# The paths the round-2 review repairs changed, each checked to take that path before it is
# timed, and REGISTERED LAST, after every existing row, for the heap-shift reason documented
# above the jac_rev pair:
#   - cx_div_zero_num / cx_div_self / cx_div_real_quot: 0 / b, z / z and 2 z / z, whose numerators
#     are exact zeros: they pay cx_div's second test and return Smith's own bits, and took the
#     extended-exponent path until this lane (checked: _cx_lost says nothing was lost);
#   - dual_div_far: a constant a with q underflowed, through _ad_div_x;
#   - sym_rewrite_noop_dag16: a no-op on y doubled 16 times by sharing: a walk that stores nothing
#     (the same node comes back), 2.6 MB as a tree;
#   - sym_rewrite_noop_dag60: the same on y doubled 60 times, past the plain walk's 2^20 nodes, so
#     one first attempt and the memo's walk.
# [measured: the setup checks below; 40 x 2^16 - 24 bytes by hand, 3.4.1 SYM4 tree, 2026-11-01]
var _bsym4_z = 0;
var _bsym4_b = 0;
var _bsym4_s = 0;
var _bsym4_r = 0;
var _bsym4_fa = 0;
var _bsym4_fb = 0;
var _bsym4_dag = 0;
var _bsym4_dag60 = 0;
var _bsym4_rules = 0;
var _bsym4_fail = 0;
fn bench_cx_div_zero_num() { return cx_div(_bsym4_z, _bsym4_b); }
fn bench_cx_div_self() { return cx_div(_bsym4_s, _bsym4_s); }
fn bench_cx_div_real_quot() { return cx_div(_bsym4_r, _bsym4_b); }
fn bench_dual_div_far() { return dual_div(_bsym4_fa, _bsym4_fb); }
fn bench_sym_rewrite_noop_dag16() { return sym_rewrite(_bsym4_dag, _bsym4_rules); }
fn bench_sym_rewrite_noop_dag60() { return sym_rewrite(_bsym4_dag60, _bsym4_rules); }
fn _bsym4_check(ok, name) {
    if (ok == 0) {
        println(name);
        _bsym4_fail = 1;
    }
    return 0;
}
fn _bsym4_setup() {
    _bsym4_z = cx_new(0, 0);
    _bsym4_b = cx_new(0x400C000000000000, 0x3FF4000000000000);
    _bsym4_s = cx_new(0x4008000000000000, 0x4010000000000000);
    _bsym4_r = cx_new(0x401C000000000000, 0x4004000000000000);
    _bsym4_fa = dual_const(0x895D6C5309E4A680);
    _bsym4_fb = dual_new(0x4EBD1F811DED024A, 0x6CE2E9D7B38371F7);
    var yn = str_from("y");
    _bsym4_dag = expr_var(yn);
    for (var i = 0; i < 16; i = i + 1) { _bsym4_dag = expr_add(_bsym4_dag, _bsym4_dag); }
    _bsym4_dag60 = _bsym4_dag;
    for (var i = 0; i < 44; i = i + 1) { _bsym4_dag60 = expr_add(_bsym4_dag60, _bsym4_dag60); }
    var a = pat_wildcard(str_from("a"));
    _bsym4_rules = vec_new();
    vec_push(_bsym4_rules, sym_rule(pat_mul(a, a), pat_pow(a, pat_const(F64_TWO))));
    _bsym4_check(HComplex_re(bench_cx_div_zero_num()) == 0 && _cx_lost(0, 0, 0) == 0, "cx_div_zero_num");
    _bsym4_check(HComplex_re(bench_cx_div_self()) == F64_ONE, "cx_div_self");
    _bsym4_check(HComplex_re(bench_cx_div_real_quot()) == F64_TWO, "cx_div_real_quot");
    _bsym4_check(Dual_deriv(bench_dual_div_far()) == 0x18B4FEF6CDB011A9, "dual_div_far");
    _bsym4_check(bench_sym_rewrite_noop_dag16() == _bsym4_dag, "sym_rewrite_noop_dag16");
    _bsym4_check(bench_sym_rewrite_noop_dag60() == _bsym4_dag60, "sym_rewrite_noop_dag60");
    return _bsym4_fail;
}

# ================================================================
# 3.4.1 lane CO8 -- a ball's centre by a cylinder's rim: inside it, 1.31e-5 from the side and
# 9.13e-5 from the cap (the section), and past it (the tangent step). _bco7_cyl, _bco7_mk and
# _b7_sup_sph as lane CO7's rows; each depth is checked within 4e-12 of the closed form.
# [measured: review pass CO8 ep3 seed 2 scenes 3324 and 4908, mpmath 50 digits; 2026-11-01]
# ================================================================
var _bco8_ci = 0;
var _bco8_bi = 0;
var _bco8_cp = 0;
var _bco8_bp = 0;
var _BCO8_FAIL = 0;
fn bench_co8_ball_in_rim() {
    gjk_epa_3d(&_bco7_cyl, _bco8_ci, &_b7_sup_sph, _bco8_bi, _b8_n, _b8_d);
    return load64(_b8_d);
}
fn bench_co8_ball_past_rim() {
    gjk_epa_3d(&_bco7_cyl, _bco8_cp, &_b7_sup_sph, _bco8_bp, _b8_n, _b8_d);
    return load64(_b8_d);
}
fn _bco8_check(v, exact, name) {
    if (f64_lt(f64_abs(f64_sub(v, exact)), 0x3D919799812DEA11) == 1) { return 0; }  # 4e-12
    println(name);
    _BCO8_FAIL = 1;
    return 0;
}
fn _bco8_setup() {
    _bco8_ci = _bco7_mk(0xC088BF0207BB1404, 0xBFE24E34D92C20A0, 0x3FD535778CCC41D0, 0x3FE279A74590331D,
      0x3FE279A74590331D, 0x3FE279A74590331D, 0x3FC883764EA2CE88, 0x3FA3B0B16F05D503);
    _bco8_bi = hvec4_new(0xC088BDE35976D90D, 0xBFE0A233CA29FB4D, 0x3FCA5187DE4F3851, 0x3FFE222F2F41DDC9);
    _bco8_cp = _bco7_mk(0xC077E9F5790A31C4, 0xBF89C701652C5D80, 0x405128D432FB63FD, 0x3ED0066162585BAA,
      0x3DDA09B80AC96015, 0x3FEFFFFFFFFEFF34, 0x3FFC9D25E553CF2C, 0x3FD2D0EBE30DA2ED);
    _bco8_bp = hvec4_new(0xC077FAF52BC0B27C, 0xBFFDEB275DB9E414, 0x4050D222E3181E21, 0x3FFFA76602C794B2);
    _bco8_check(bench_co8_ball_in_rim(), 0x3FFE223CEFF3A78E, "co8_gjk_epa_ball_in_rim");
    _bco8_check(bench_co8_ball_past_rim(), 0x3FEB8E37189143DA, "co8_gjk_epa_ball_past_rim");
    return _BCO8_FAIL;
}
