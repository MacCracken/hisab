}
fn _b341n3q_setup() {
    _b341n3q_x0 = alloc(80);
    _b341n3q_ox = alloc(80);
    _b341n3q_of = alloc(8);
    _b341n3q_lam = alloc(48);
    store64(_b341n3q_lam, 0x40C3880000000000);
    store64(_b341n3q_lam + 8, 0x4049000000000000);
    store64(_b341n3q_lam + 16, 0x40A3880000000000);
    store64(_b341n3q_lam + 24, 0x40FE848000000000);
    store64(_b341n3q_lam + 32, 0x4156E36000000000);
    store64(_b341n3q_lam + 40, 0x4197D78400000000);
