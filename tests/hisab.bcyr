# ================================================================
# Convenience: bench(name, fn_ptr, iterations)
# ================================================================

fn bench(name, fp, n) {
    var b = bench_new(name);
    bench_run(b, fp, n);
    bench_report(b);
    return 0;
}

# Sub-microsecond ops: bench_run wraps a clock_gettime PAIR around every call,
# which the bench module documents at ~240 ns of overhead per op. On a 500 ns
# operation that is half the signal, so the gjk_intersect_3d numbers below are
# taken with ONE clock pair per round of `batch` calls instead.
fn bench_batch(name, fp, batch, rounds) {
    var b = bench_new(name);
    bench_run_batch(b, fp, batch, rounds);
    bench_report(b);
    return 0;
}

