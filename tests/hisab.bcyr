# Amplified (batch) SIMD benchmarks. The single-op benches above sit below
# the harness's ~488ns per-iteration timer floor, so they cannot show the
# 2.3.1 f64v SIMD wins. These loop N ops per timed call to clear the floor
# and make the win regression-trackable in bench-history.csv.
fn bench_vec3_dot_x64() {
    var i = 0; var acc = 0;
    while (i < 64) { acc = acc + f64_to(hvec3_dot(_bv3a, _bv3b)); i = i + 1; }
    return acc;
}
fn bench_vec4_dot_x64() {
    var i = 0; var acc = 0;
    while (i < 64) { acc = acc + f64_to(hvec4_dot(_bv4a, _bv4b)); i = i + 1; }
    return acc;
}
