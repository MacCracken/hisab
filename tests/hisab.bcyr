# ================================================================
# 3.4.0 lane RT -- the [3.3.8] ray rows' paths and the [3.4.0] contracts
# ================================================================
# A barrel ray from 1e4 along the axis (the compensated o_perp, 3.3.7's +57% focused row, now
# registered); an origin 3% of r outside a barrel (o_perp's rounding carried into c, the roadmap's
# repro); a thin barrel 2^168 radii away (the exact coefficients, the roadmap's miss); the
# half-infinite capsule's barrel; and geo_barycentric_coords on an exactly colinear triangle and
# on one 2^-30 from colinear (the thin path's exact cross products). REGISTERED LAST, after the
# 3.3.7 rows, for the heap-shift reason documented above the jac_rev pair; _b8rt_setup checks each
# row's path once before any of them is timed.
# [measured: rt340 fixtures (fixtures.py, fix2.py, fix3.py), exact Fraction oracle, 2026-10-31]
var _B8RT_FAIL = 0;
fn _b8rt_check(ok, name) {
    if (ok == 1) { return 0; }
    syscall(1, 1, "FATAL: 3.4.0 RT row ", 20);
    syscall(1, 1, name, strlen(name));
    println(" does not take the path its name says");
    _B8RT_FAIL = _B8RT_FAIL + 1;
    return 1;
}
fn _b8rt_ray(ox, oy, oz, dx, dy, dz) {
    var r = alloc(sizeof(GeoRay));
    GeoRay_set_origin(r, hvec3_new(ox, oy, oz));
    GeoRay_set_direction(r, hvec3_new(dx, dy, dz));
    return r;
}
var _b8rt_far = 0;
var _b8rt_nb_ray = 0;
var _b8rt_nb_cap = 0;
var _b8rt_th_ray = 0;
var _b8rt_th_cap = 0;
var _b8rt_hi_ray = 0;
var _b8rt_hi_cap = 0;
var _b8rt_col = 0;
var _b8rt_colp = 0;
var _b8rt_thin = 0;
var _b8rt_thinp = 0;
fn bench_ray_capsule_far_axis() { return geo_ray_capsule(_b8rt_far, _b_capsule); }
fn bench_ray_capsule_near_barrel() { return geo_ray_capsule(_b8rt_nb_ray, _b8rt_nb_cap); }
fn bench_ray_capsule_thin_2e168() { return geo_ray_capsule(_b8rt_th_ray, _b8rt_th_cap); }
fn bench_ray_capsule_half_infinite() { return geo_ray_capsule(_b8rt_hi_ray, _b8rt_hi_cap); }
fn bench_barycentric_colinear() { return HVec3_x(geo_barycentric_coords(_b8rt_col, _b8rt_colp)); }
fn bench_barycentric_thin() { return HVec3_x(geo_barycentric_coords(_b8rt_thin, _b8rt_thinp)); }

fn _b8rt_setup() {
    _b8rt_far = geo_ray_new(hvec3_new(_b6_q(3, 10), _b6_q(2, 10), f64_neg(f64_from(10000))),
      hvec3_new(F64_HALF, _b6_q(1, 3), f64_from(10000)));
    _b8rt_nb_ray = _b8rt_ray(0x925EA7EEFAD6162C, 0x925E8890FC4203E4, 0x124D7E0369DB754C, 0xAD2689EC800B377A,
      0x3FC85814D48BDA5F, 0xAD25E2A03313AF87);
    _b8rt_nb_cap = geo_capsule_new(hvec3_new(0x9268000000000000, 0x1260000000000000, 0),
      hvec3_new(0x927161BED61BED62, 0, 0x922745D1745D1746), 0x126967B9F957588B);
    _b8rt_th_ray = _b8rt_ray(0x35857EAD7683670C, 0xB57C831B1D037CCA, 0x3FFE9CAF93B0BFF3, 0, 0, 0xBFD3333333333333);
    _b8rt_th_cap = geo_capsule_new(hvec3_new(0xBFD0D5F4A1BF108C, 0xBFDC22E7A91CD28A, 0xBFDCE33C8E195248),
      hvec3_new(0x3FD0D5F4A1BF108C, 0x3FDC22E7A91CD28A, 0x3FDCE33C8E195248), 0x357B598E926EB69D);
    _b8rt_hi_ray = _b8rt_ray(f64_from(5), 0, f64_from(3), f64_neg(F64_ONE), 0, 0);
    _b8rt_hi_cap = geo_capsule_new(hvec3_new(0, 0, 0), hvec3_new(F64_ONE, F64_TWO, 0x7FF0000000000000), F64_ONE);
    _b8rt_col = geo_triangle_new(hvec3_new(F64_ONE, F64_ONE, F64_ONE), hvec3_new(F64_TWO, f64_from(3), f64_from(4)),
      hvec3_new(f64_from(4), f64_from(7), f64_from(10)));
    _b8rt_colp = hvec3_new(f64_from(3), f64_from(5), f64_from(7));
    _b8rt_thin = geo_triangle_new(hvec3_new(0xBFF8E63C56F0CADE, 0x3F99AD93BE52CB00, 0x3FFB2006F7ED88CC),
      hvec3_new(0xBFF601721EAFF1ED, 0x3FE25A127B748390, 0x3FF767027716145F),
      hvec3_new(0xBFF4EE7AB81583D0, 0x3FE8DDA73CB5198F, 0x3FF60544BFDD572D));
    _b8rt_thinp = hvec3_new(0xBFF42FD5F624E10A, 0x3FED61D816F65022, 0x3FF51001FF7D25CA);
    _b8rt_check(f64_gt(bench_ray_capsule_far_axis(), 0) == 1, "ray_capsule_far_axis");
    _b8rt_check(bench_ray_capsule_near_barrel() == 0x124F5DF0E31E9F98, "ray_capsule_near_barrel");
    _b8rt_check(bench_ray_capsule_thin_2e168() == 0, "ray_capsule_thin_2e168");
    _b8rt_check(bench_ray_capsule_half_infinite() == f64_from(4), "ray_capsule_half_infinite");
    _b8rt_check(bench_barycentric_colinear() == 0x3FC2492492492492, "barycentric_colinear");
    _b8rt_check(bench_barycentric_thin() == 0xBFE41CEEC070C25C, "barycentric_thin");
    return _B8RT_FAIL;
}

fn _b8rt_rows() {
    bench("ray_capsule_far_axis",      &bench_ray_capsule_far_axis,      400000);
    bench("ray_capsule_near_barrel",   &bench_ray_capsule_near_barrel,   200000);
    bench("ray_capsule_thin_2e168",    &bench_ray_capsule_thin_2e168,     20000);
    bench("ray_capsule_half_infinite", &bench_ray_capsule_half_infinite, 200000);
    bench("barycentric_colinear",      &bench_barycentric_colinear,      200000);
    bench("barycentric_thin",          &bench_barycentric_thin,          100000);
    return 0;
}

# ================================================================
# 3.4.0 lane FB -- the error channels of mat3 / mat4 / quat / transforms (roadmap D088, D069)
# and the rotation contract for a non-unit q. The rows above time each function's ordinary
# path; these time the paths that are new: the inverses' double-double tier (a matrix past 2^10
# of its rounding bound: the near-singular rows, and a view-projection with the eye 1e5 away)
# and their exact tier (one exactly singular with no zero row or column, one invertible with
# P / |det| = 2^67), transform_point's exact w, the refusals, a q far from unit length, and the
# _checked forms that had no row.
# Registered LAST, fixtures allocated in _bfb_setup, each path checked there once.
# ================================================================
var _BFB_FAIL = 0;
var _bfb_m3n = 0;
var _bfb_m4s = 0;
var _bfb_m4n = 0;
var _bfb_m4w0 = 0;
var _bfb_q1000 = 0;
var _bfb_mvp = 0;
var _bfb_ka = 0;
var _bfb_kb = 0;
var _bfb_kv = 0;
var _bfb_m4vp = 0;
var _bfb_m4x = 0;
var _bfb_m4pw = 0;
var _bfb_vpw = 0;

fn _bfb_check(ok, name) {
    if (ok == 1) { return 0; }
    syscall(1, 1, "FATAL: 3.4.0 row ", 17);
    syscall(1, 1, name, strlen(name));
    println(" does not take the path its name says");
    _BFB_FAIL = _BFB_FAIL + 1;
    return 1;
}

fn bench_m3_normal_matrix_cof() {
    var r = m3_normal_matrix_cof(_b6_m3a);
    return m3_get(r, 0, 0);
}
fn bench_m3_inverse_near_singular() {
    var t, r = m3_inverse_checked(_bfb_m3n);
    if (is_err_result(t) == 1) { return 0; }
    return m3_get(r, 0, 0);
}
fn bench_m4_inverse_singular_rank3() {
    var t, r = m4_inverse_checked(_bfb_m4s);
    return r;
}
fn bench_m4_inverse_near_singular() {
    var t, r = m4_inverse_checked(_bfb_m4n);
    if (is_err_result(t) == 1) { return 0; }
    return m4_get(r, 0, 0);
}
fn bench_m4_transform_point_w0() {
    var t, r = m4_transform_point_checked(_bfb_m4w0, _bv3a);
    return r;
}
fn bench_quat_rotate_vec3_q1000() {
    var r = hquat_rotate_vec3(_bfb_q1000, _bv3a);
    return HVec3_x(r);
}
fn bench_quat_inverse_checked() {
    var t, r = hquat_inverse_checked(_bq1);
    return 0;
}
fn bench_quat_normalize_checked() {
    var t, r = hquat_normalize_checked(_bq2);
    return 0;
}
fn bench_inverse_lerp_checked() {
    var t, r = hisab_inverse_lerp_checked(_bfb_ka, _bfb_kb, _bfb_kv);
    return r;
}
fn bench_world_to_screen_checked() {
    var t, r = world_to_screen_checked(_bv3a, _bfb_mvp, f64_from(800), f64_from(600));
    return 0;
}
fn bench_m4_inverse_view_projection() {
    var t, r = m4_inverse_checked(_bfb_m4vp);
    if (is_err_result(t) == 1) { return 0; }
    return load64(r + 96);
}
fn bench_m4_inverse_exact() {
    var t, r = m4_inverse_checked(_bfb_m4x);
    if (is_err_result(t) == 1) { return 0; }
    return load64(r + 8);
}
fn bench_m4_transform_point_exact_w() {
    var t, r = m4_transform_point_checked(_bfb_m4pw, _bfb_vpw);
    if (is_err_result(t) == 1) { return 0; }
    return HVec3_x(r);
}

fn _bfb_setup() {
    # [[1, 1, 0], [1, 1 + 2^-20, 0], [0, 0, 1]]: det 2^-20 against a permanent of 2 + 2^-20, so
    # the formula's tier (permanent <= 2^10 |det|) refuses it and the double-double tier answers;
    # its inverse is exact, 1 + 2^20 first.
    _bfb_m3n = m3_from_cols(hvec3_new(F64_ONE, F64_ONE, 0),
      hvec3_new(F64_ONE, 0x3FF0000100000000, 0), hvec3_new(0, 0, F64_ONE));
    _bfb_check(bench_m3_inverse_near_singular() == 0x4130000100000000, "m3_inverse_near_singular");
    # Rows (1, 2, 3, 4), (2, 3, 4, 5), their sum, (1, 0, 0, 1): rank 3, no zero row or column.
    _bfb_m4s = m4_from_cols(hvec4_new(F64_ONE, F64_TWO, f64_from(3), F64_ONE),
      hvec4_new(F64_TWO, f64_from(3), f64_from(5), 0), hvec4_new(f64_from(3), f64_from(4), f64_from(7), 0),
      hvec4_new(f64_from(4), f64_from(5), f64_from(9), F64_ONE));
    _bfb_check(bench_m4_inverse_singular_rank3() == HSB_ERR_SINGULAR_MATRIX, "m4_inverse_singular_rank3");
    # diag(1, 1, 1, 1) with [0][1] = [1][0] = 1 and [1][1] = 1 + 2^-20: det 2^-20, inverse exact
    # (the double-double tier).
    _bfb_m4n = m4_identity();
    m4_set(_bfb_m4n, 0, 1, F64_ONE); m4_set(_bfb_m4n, 1, 0, F64_ONE); m4_set(_bfb_m4n, 1, 1, 0x3FF0000100000000);
    _bfb_check(bench_m4_inverse_near_singular() == 0x4130000100000000, "m4_inverse_near_singular");
    # Row 3 zero: w = 0 for every point.
    _bfb_m4w0 = m4_identity();
    m4_set(_bfb_m4w0, 3, 3, 0);
    _bfb_check(bench_m4_transform_point_w0() == HSB_ERR_DIVISION_BY_ZERO, "m4_transform_point_w0");
    # 1000 * a unit quaternion: |q|^2 = 10^6, past 16, so it is scaled first.
    _bfb_q1000 = hquat_new(0, f64_mul(HQuat_y(_bq1), f64_from(1000)), 0, f64_mul(HQuat_w(_bq1), f64_from(1000)));
    var r1 = hquat_rotate_vec3(_bq1, _bv3a);
    _bfb_check(f64_eq(bench_quat_rotate_vec3_q1000(), HVec3_x(r1)), "quat_rotate_vec3_q1000");
    _bfb_mvp = m4_mul(m4_perspective_rh(F64_ONE, f64_div(f64_from(4), f64_from(3)), _b6_q(1, 10), f64_from(100)),
      m4_look_at_rh(hvec3_new(f64_from(4), f64_from(3), f64_from(10)), hvec3_zero(), hvec3_unit_y()));
    _bfb_ka = _b6_q(3, 2);
    _bfb_kb = _b6_q(45, 4);
    _bfb_kv = _b6_q(47, 10);
    _bfb_check(f64_gt(bench_inverse_lerp_checked(), 0) == 1, "inverse_lerp_checked");
    # A view-projection (60-degree fov, 16:9, near 1e-3, far 1000) seen from 1e5 away: P / |det|
    # ~ 2^24, the double-double tier; and P / |det| = 2^67.2 (row 3 = r0 + r1 + 2^-60 in one
    # entry), the exact tier: tests/foundation.tcyr's fixtures, their entries checked there.
    _bfb_m4vp = _bfb_m4_words(0xBFE28FD306CD8B9E, 0xBFEA91ABBFB17EFC, 0x3FE4A211C6AE6047, 0x3FE4A20F1259B6AB,
      0xBFDA1B15D457F2ED, 0x3FF81C8A1F9225C8, 0x3FD0A7F0A2727C2D, 0x3FD0A7EE73908B48);
    _bfb_m4_words2(_bfb_m4vp, 0x3FE5612394F45676, 0x3FC97F57A1AB1481, 0x3FE6FF940EE4782D, 0x3FE6FF910B3251CC,
      0x40CD4D0BD07C7949, 0x40EEC8873BC39E5F, 0xC0F66D2FBB6C414F, 0xC0F66D2CC2B90C22);
    _bfb_check(bench_m4_inverse_view_projection() == 0x4184778D271FC1B7, "m4_inverse_view_projection");
    _bfb_m4x = _bfb_m4_words(0xBFD1FE1800000000, 0x3FD1FE1800000000, 0xBFE45EB600000000, 0x3C30000000000000,
      0x3FCA7AE000000000, 0x3FD686A800000000, 0x3FE522C800000000, 0x3FE1E20C00000000);
    _bfb_m4_words2(_bfb_m4x, 0xBFED953400000000, 0xBFE38FB000000000, 0xBFE71FA000000000, 0xBFF8927200000000,
      0x3FD5323C00000000, 0x3FE1DFEC00000000, 0x3FEF611A00000000, 0x3FEC790A00000000);
    _bfb_check(bench_m4_inverse_exact() == 0xC400FD32AC27E2D7, "m4_inverse_exact");
    # w = 3 RN(1/3) - 1 = -2^-54 exactly, rounded to 0: the exact path answers x = -2^54 / 3.
    _bfb_m4pw = m4_identity();
    m4_set(_bfb_m4pw, 0, 3, 0x4008000000000000); m4_set(_bfb_m4pw, 3, 3, 0xBFF0000000000000);
    _bfb_vpw = hvec3_new(0x3FD5555555555555, F64_ONE, F64_ONE);
    _bfb_check(bench_m4_transform_point_exact_w() == 0xC335555555555555, "m4_transform_point_exact_w");
    return _BFB_FAIL;
}
# A 4x4 from its first eight words (column-major), the rest zero; `_bfb_m4_words2` the last eight.
fn _bfb_m4_words(a, b, c, d, e, f, g, h) {
    var m = m4_new();
    store64(m, a); store64(m + 8, b); store64(m + 16, c); store64(m + 24, d);
    store64(m + 32, e); store64(m + 40, f); store64(m + 48, g); store64(m + 56, h);
    return m;
}
fn _bfb_m4_words2(m, a, b, c, d, e, f, g, h) {
    store64(m + 64, a); store64(m + 72, b); store64(m + 80, c); store64(m + 88, d);
    store64(m + 96, e); store64(m + 104, f); store64(m + 112, g); store64(m + 120, h);
    return m;
}

fn _bfb_rows() {
    bench_batch("m3_normal_matrix_cof",         &bench_m3_normal_matrix_cof,       10000, 40);
    bench("m3_inverse_near_singular",           &bench_m3_inverse_near_singular,   100000);
    bench("m4_inverse_singular_rank3",          &bench_m4_inverse_singular_rank3,  20000);
    bench("m4_inverse_near_singular",           &bench_m4_inverse_near_singular,   20000);
    bench_batch("m4_transform_point_w0",        &bench_m4_transform_point_w0,      2000, 40);
    bench_batch("quat_rotate_vec3_q1000",       &bench_quat_rotate_vec3_q1000,     10000, 40);
    bench_batch("quat_inverse_checked",         &bench_quat_inverse_checked,       20000, 20);
    bench_batch("quat_normalize_checked",       &bench_quat_normalize_checked,     20000, 20);
    bench_batch("inverse_lerp_checked",         &bench_inverse_lerp_checked,       40000, 20);
    bench_batch("world_to_screen_checked",      &bench_world_to_screen_checked,    10000, 40);
    bench("m4_inverse_view_projection",         &bench_m4_inverse_view_projection, 20000);
    bench("m4_inverse_exact",                   &bench_m4_inverse_exact,           2000);
    bench_batch("m4_transform_point_exact_w",   &bench_m4_transform_point_exact_w, 2000, 20);
    return 0;
}

# ================================================================
# 3.4.0 lane RT, review repairs -- the paths the review's repairs added
# ================================================================
# A unit tilted capsule of radius 1e-16 missed by about 5 (S1: the float distance filter answers it
# before any expansion; the review measured 21 us a call there); a thin barrel 2^600 radii from the
# origin (S2: the exact solve, now past 2^400); a sphere whose c has cancelled by between one bit
# and two (formed exactly since the review; the near root 4.18 ulp before); and a ray grazing a thin
# barrel at its end plane, where the root's side of the plane is taken exactly. REGISTERED LAST,
# after lane FB's rows, for the heap-shift reason documented above the jac_rev pair.
# [measured: rt340 review families (REV-RT-py, sweep.py), exact Fraction oracle, 2026-10-31]
var _B8RV_FAIL = 0;
fn _b8rv_check(ok, name) {
    if (ok == 1) { return 0; }
    syscall(1, 1, "FATAL: 3.4.0 RT review row ", 27);
    syscall(1, 1, name, strlen(name));
    println(" does not take the path its name says");
    _B8RV_FAIL = _B8RV_FAIL + 1;
    return 1;
}
var _b8rv_far_ray = 0;
var _b8rv_far_cap = 0;
var _b8rv_t6_ray = 0;
var _b8rv_t6_cap = 0;
var _b8rv_sp_ray = 0;
var _b8rv_sp = 0;
var _b8rv_sm_ray = 0;
var _b8rv_sm_cap = 0;
fn bench_ray_capsule_thin_far_miss() { return geo_ray_capsule(_b8rv_far_ray, _b8rv_far_cap); }
fn bench_ray_capsule_thin_2e600() { return geo_ray_capsule(_b8rv_t6_ray, _b8rv_t6_cap); }
fn bench_ray_sphere_c_one_bit() { return geo_ray_sphere(_b8rv_sp_ray, _b8rv_sp); }
fn bench_ray_capsule_seam_graze() { return geo_ray_capsule(_b8rv_sm_ray, _b8rv_sm_cap); }

fn _b8rv_setup() {
    _b8rv_far_ray = _b8rt_ray(0x3FD3333333333333, 0x4014000000000000, 0x3FE6666666666666, 0x3FB999999999999A,
      0xBFECCCCCCCCCCCCD, 0x3FD3333333333333);
    _b8rv_far_cap = geo_capsule_new(hvec3_new(0x3FB999999999999A, 0x3FC999999999999A, 0x3FD3333333333333),
      hvec3_new(0x3FF199999999999A, 0x3FE6666666666666, 0x3FD999999999999A), 0x3C9CD2B297D889BC);
    _b8rv_t6_ray = _b8rt_ray(0x1A6B0D91A7FB79C6, 0x1A48D573B7547680, 0x1A65BACB8FDB2C12, 0x3FD2D91A443B5D25,
      0xBFD3C0913861956D, 0xBFECF13327E75A0D);
    _b8rv_t6_cap = geo_capsule_new(hvec3_new(0xBFEEB6D99235FABA, 0xBFEEAD0A270863F4, 0x3FE5A1FB0DAC96CE),
      hvec3_new(0x3FEEB6D99235FABA, 0x3FEEAD0A270863F4, 0xBFE5A1FB0DAC96CE), 0x1A6B75105E731AD9);
    _b8rv_sp_ray = _b8rt_ray(0xBFFD20AF8D0254FA, 0xBFF8F6FA52581B30, 0xBFD8C4E49E388030, 0x40030142575EB5DE,
      0x3FE66BBA027670F5, 0x3FD25E05AFB33D37);
    _b8rv_sp = geo_sphere_new(hvec3_new(0x3F75EF2E04775A00, 0xBFE43E5B837013B8, 0xBFC6FBE141110778),
      0x3FF9FB58E049E160);
    _b8rv_sm_ray = _b8rt_ray(0xBFE3333333333333, 0x3B5E392010175EE5, 0xB1AB9B6364F30305, 0x3062D0F36EFC9720,
      0xBFC999999999999A, 0x37364CFDA3281E39);
    _b8rv_sm_cap = geo_capsule_new(hvec3_new(0x31D66E40C2057274, 0x3FF4CCCCCCCCCCCD, 0x3FD3333333333333),
      hvec3_new(0xBFE3333333333333, 0x2D745ECFE5BF520B, 0x3371FF69AAAC0DE7), 0x37A16C262777579C);
    _b8rv_check(bench_ray_capsule_thin_far_miss() == 0, "ray_capsule_thin_far_miss");
    _b8rv_check(bench_ray_capsule_thin_2e600() == 0x1A5F50F18012CFEA, "ray_capsule_thin_2e600");
    _b8rv_check(bench_ray_sphere_c_one_bit() == 0x3FC6CB4636EE8640, "ray_sphere_c_one_bit");
    _b8rv_check(bench_ray_capsule_seam_graze() == 0x3B82E3B40A0E9B4F, "ray_capsule_seam_graze");
    return _B8RV_FAIL;
}

fn _b8rv_rows() {
    bench("ray_capsule_thin_far_miss", &bench_ray_capsule_thin_far_miss, 200000);
    bench("ray_capsule_thin_2e600",    &bench_ray_capsule_thin_2e600,     20000);
    bench("ray_sphere_c_one_bit",      &bench_ray_sphere_c_one_bit,      400000);
    bench("ray_capsule_seam_graze",    &bench_ray_capsule_seam_graze,     20000);
    return 0;
}

# ================================================================
# 3.4.0 lane RT, the capsule jet's infinite-end contract (src/geo_diff.cyr)
# ================================================================
# The lane's Finding 3 repro: start (0,0,0), end (1, 2, +Inf), r = 1, from (5, 0, 3) along -x, the
# barrel at t = 4, now a capsule jet (integ-snap7: the miss jet). REGISTERED LAST, after lane FB's
# rows, for the heap-shift reason documented above the jac_rev pair.
# [measured: rt340 RT3 jet oracle (jor.py), exact Fractions, 2026-10-31]
var _b8rj_ray = 0;
var _b8rj_cap = 0;
fn bench_jet_capsule_half_infinite() { return geo_jet_t(geo_jet_capsule(_b8rj_ray, _b8rj_cap)); }
fn _b8rj_setup() {
    _b8rj_ray = _b8rt_ray(f64_from(5), 0, f64_from(3), f64_neg(F64_ONE), 0, 0);
    _b8rj_cap = geo_capsule_new(hvec3_new(0, 0, 0), hvec3_new(F64_ONE, F64_TWO, 0x7FF0000000000000), F64_ONE);
    if (geo_jet_kind(geo_jet_capsule(_b8rj_ray, _b8rj_cap)) != GEO_JET_CAPSULE) {
        println("FATAL: 3.4.0 RT row jet_capsule_half_infinite does not take the path its name says");
        return 1;
    }
    return 0;
}

# ================================================================
# 3.4.0 lane RT, second review (S-a)
# ================================================================
# The second review's S-a sphere ray (grazing from 1.35 r, hb^2 and a c cancelled by 3.5 bits: the
# discriminant certified in double-double, 4 us a call with the expansions alone). REGISTERED LAST,
# after the jet row, for the heap-shift reason documented above the jac_rev pair.
# [measured: R2E S-a repro, exact Fractions; rt4 tim/t.bcyr, integ-snap12 vs this tree, 2026-10-31]
var _b8r4_sp_ray = 0;
var _b8r4_sp = 0;
fn bench_ray_sphere_graze_close() { return geo_ray_sphere(_b8r4_sp_ray, _b8r4_sp); }
fn _b8r4_setup() {
    _b8r4_sp_ray = _b8rt_ray(0x400AA55C6F69AEC4, 0xBFF51820D07B7D00, 0x3FF1B425D326A5A4, 0xBFE578BB9C02AACA,
      0xBF92EDA03B1D2D7F, 0x3FE7B83874E2BF9A);
    _b8r4_sp = geo_sphere_new(hvec3_new(0x3FC016190CFA8F00, 0x400524CD1CFDEA1C, 0x400DC3B1D860066A),
      0x4011F2673ED30028);
    _b8rv_check(bench_ray_sphere_graze_close() == 0x40014147047D93AB, "ray_sphere_graze_close");
    return _B8RV_FAIL;
}

fn main() {
    alloc_init();

    # Set up test data
    _bv3a = hvec3_new(F64_ONE, F64_TWO, f64_from(3));
    _bv3b = hvec3_new(f64_from(4), f64_from(5), f64_from(6));
    _bv4a = hvec4_new(F64_ONE, F64_TWO, f64_from(3), f64_from(4));
    _bv4b = hvec4_new(f64_from(5), f64_from(6), f64_from(7), f64_from(8));

    _bq1 = hquat_from_rotation_y(F64_HALF);
    _bq2 = hquat_from_rotation_x(f64_from(1));

    _bm4a = m4_from_srt(hvec3_one(), _bq1, hvec3_new(F64_ONE, F64_TWO, f64_from(3)));
    _bm4b = m4_from_srt(hvec3_splat(F64_TWO), _bq2, hvec3_new(f64_from(4), f64_from(5), f64_from(6)));

    _bt3a = t3d_new(hvec3_new(F64_ONE, F64_TWO, f64_from(3)), _bq1, hvec3_one());
    _bt3b = t3d_new(hvec3_new(f64_from(4), f64_from(5), f64_from(6)), _bq2, hvec3_splat(F64_TWO));

    # Ray pointing along +Z from (0, 0, -10)
    var ray_origin = hvec3_new(0, 0, f64_neg(f64_from(10)));
    var ray_dir = hvec3_unit_z();
    _bray = geo_ray_new(ray_origin, ray_dir);

    # Sphere at origin, radius 1
    _bsphere = geo_sphere_new(hvec3_zero(), F64_ONE);

    # AABB from (-1,-1,-1) to (1,1,1)
    var aabb_min = hvec3_new(f64_neg(F64_ONE), f64_neg(F64_ONE), f64_neg(F64_ONE));
    var aabb_max = hvec3_new(F64_ONE, F64_ONE, F64_ONE);
    _baabb = geo_aabb_new(aabb_min, aabb_max);

    # Triangle in front of ray
    var tv0 = hvec3_new(f64_neg(F64_ONE), f64_neg(F64_ONE), 0);
    var tv1 = hvec3_new(F64_ONE, f64_neg(F64_ONE), 0);
    var tv2 = hvec3_new(0, F64_ONE, 0);
    _btri = geo_triangle_new(tv0, tv1, tv2);

    # Complex numbers
    _bcx_a = cx_new(f64_from(3), f64_from(4));
    _bcx_b = cx_new(F64_ONE, F64_TWO);

    # Color test values
    _b_srgb_val = F64_HALF;                        # 0.5
    _b_tone_r = F64_TWO;
    _b_tone_g = F64_ONE_HALF;                       # 1.5
    _b_tone_b = F64_HALF;

    # Easing / noise
    _b_ease_t = F64_HALF;
    _b_perlin_x = F64_ONE_HALF;                     # 1.5
    _b_perlin_y = 0x4002666666666666;               # 2.3

    # Derivative test values
    _b_deriv_x = F64_ONE;
    _b_deriv_h = 0x3F1A36E2EB1C432D;               # 1e-4

    println("=== hisab benchmarks ===");

    # Vec3 (1M iterations each)
    # Collision benchmark data
    _b_hull_n = 2000;
    _b_hull_pts = vec_new();
    var hi = 0;
    while (hi < _b_hull_n) {
        # deterministic pseudo-scatter (PCG-ish mix), no RNG dependency
        var hx = (hi * 2654435761) % 10007;
        var hy = (hi * 40503) % 10009;
        vec_push(_b_hull_pts, hvec2_new(f64_from(hx), f64_from(hy)));
        hi = hi + 1;
    }
    # 33x33 grid -> 2048 triangles, 1089 vertices
    _b_mesh_nverts = 33 * 33;
    _b_mesh_tris = _b_build_grid_mesh(33);
    _b_mesh_ntris = vec_len(_b_mesh_tris) / 3;

    # 4,000 identical AABBs -- the degenerate BVH partition. Sized to the bump
    # arena: this benchmark never frees, and 3 x 20,000 exhausted it.
    # [measured: scratch sizing run at 2.7.0, not reproducible in-tree]
    _b_bvh_n = 4000;
    _b_bvh_boxes = alloc(_b_bvh_n * 8);
    var bvbox = geo_aabb_new(hvec3_new(F64_ONE, F64_ONE, F64_ONE),
      hvec3_new(F64_TWO, F64_TWO, F64_TWO));
    var bvi = 0;
    while (bvi < _b_bvh_n) {
        store64(_b_bvh_boxes + bvi * 8, bvbox);
        bvi = bvi + 1;
    }

    # Spread scene + 200 rays for the ray-walker benchmark (2.8.3). Boxes are
    # unit cubes on a 16 x 16 x 16 lattice; every second ray starts exactly on a
    # box corner, which is the t = 0 case.
    var bqn = 4000;
    var bqboxes = alloc(bqn * 8);
    var bqi = 0;
    while (bqi < bqn) {
        var bqx = f64_from((bqi % 16) * 4);
        var bqy = f64_from(((bqi / 16) % 16) * 4);
        var bqz = f64_from(((bqi / 256) % 16) * 4);
        store64(bqboxes + bqi * 8,
          geo_aabb_new(hvec3_new(bqx, bqy, bqz),
            hvec3_new(f64_add(bqx, F64_ONE), f64_add(bqy, F64_ONE), f64_add(bqz, F64_ONE))));
        bqi = bqi + 1;
    }
    _b_bvhq_tree = bvh_build(bqboxes, bqn);
    _b_bvhq_rays = alloc(200 * 8);
    var bqr = 0;
    while (bqr < 200) {
        var bqox = f64_from((bqr % 16) * 4);
        var bqoy = f64_from(((bqr / 16) % 16) * 4);
        var bqoz = f64_from(0 - 20);
        if (bqr % 2 == 1) { bqox = f64_add(bqox, F64_HALF); }
        store64(_b_bvhq_rays + bqr * 8,
          geo_ray_new(hvec3_new(bqox, bqoy, bqoz), hvec3_new(0, 0, F64_ONE)));
        bqr = bqr + 1;
    }
    # 2.8.3 fixtures.
    # Scattered AABBs -- the ordinary BVH build, not the degenerate one.
    _b_bvs_n = 4000;
    _b_bvs_boxes = alloc(_b_bvs_n * 8);
    var bsi = 0;
    while (bsi < _b_bvs_n) {
        var bsx = f64_from((bsi * 2654435761) % 10007);
        var bsy = f64_from((bsi * 40503) % 10009);
        var bsz = f64_from((bsi * 69069) % 10039);
        store64(_b_bvs_boxes + bsi * 8, geo_aabb_new(hvec3_new(bsx, bsy, bsz),
            hvec3_new(f64_add(bsx, F64_ONE), f64_add(bsy, F64_ONE), f64_add(bsz, F64_ONE))));
        bsi = bsi + 1;
    }

    # Thirty-two thousand points at ~1 per cell (a 32x32x32 lattice, so the cell index is
    # a true 3-D spread and not a 1-D curve through the grid), plus two thousand
    # pre-built query points so the timed loop is the query and nothing else.
    _b_sh = spatial_hash_new(F64_ONE);
    var shi = 0;
    while (shi < 32000) {
        spatial_hash_insert(_b_sh, hvec3_new(f64_from(shi % 32),
            f64_from((shi / 32) % 32), f64_from((shi / 1024) % 32)), shi);
        shi = shi + 1;
    }
    _b_sh_q = alloc(2000 * 8);
    var shq = 0;
    while (shq < 2000) {
        var shs = (shq * 2654435761) % 32768;
        store64(_b_sh_q + shq * 8, hvec3_new(f64_from(shs % 32),
            f64_from((shs / 32) % 32), f64_from((shs / 1024) % 32)));
        shq = shq + 1;
    }

    # 1024 samples: above the direct/FFT crossover for both DCT-II and DST-I.
    _b_dct_buf = alloc(1024 * 8);
    var dbf = 0;
    while (dbf < 1024) {
        store64(_b_dct_buf + dbf * 8, f64_from((dbf * 7) % 5 + 1));
        dbf = dbf + 1;
    }

    # 2.7.0-L fixtures.
    _b_kd_n = 4000;
    _b_kd_pts = alloc(_b_kd_n * 8);
    var kbi = 0;
    while (kbi < _b_kd_n) {
        store64(_b_kd_pts + kbi * 8, hvec3_new(f64_from((kbi * 2654435761) % 1009),
            f64_from((kbi * 40503) % 1013), f64_from((kbi * 69069) % 1019)));
        kbi = kbi + 1;
    }
    _b_kd_q = kdtree_build(_b_kd_pts, _b_kd_n);

    _b_dl_n = 400;
    _b_dl_pts = vec_new();
    var dbi = 0;
    while (dbi < _b_dl_n) {
        vec_push(_b_dl_pts, hvec2_new(f64_from((dbi * 2654435761) % 10007),
            f64_from((dbi * 40503) % 10009)));
        dbi = dbi + 1;
    }

    # Fully cocircular: every triple of points shares one circumcircle, so the
    # in-circle determinant sits on an exact tie and round-off decides it. The
    # degenerate class that the scattered fixture above cannot expose.
    _b_dc_n = 150;
    _b_dc_pts = vec_new();
    var dci = 0;
    while (dci < _b_dc_n) {
        var dcang = f64_div(f64_mul(f64_mul(F64_TWO, F64_PI), f64_from(dci)), f64_from(_b_dc_n));
        vec_push(_b_dc_pts, hvec2_new(f64_mul(f64_from(100), f64_cos(dcang)),
            f64_mul(f64_from(100), f64_sin(dcang))));
        dci = dci + 1;
    }

    # Convex polygon (points on a circle) -- the complete-triangulation path.
    _b_tp_n = 600;
    _b_tp_poly = vec_new();
    var tbi = 0;
    while (tbi < _b_tp_n) {
        var ang = f64_div(f64_mul(f64_mul(F64_TWO, F64_PI), f64_from(tbi)), f64_from(_b_tp_n));
        vec_push(_b_tp_poly, hvec2_new(f64_mul(f64_from(100), f64_cos(ang)),
            f64_mul(f64_from(100), f64_sin(ang))));
        tbi = tbi + 1;
    }

    # einsum operands: two 2x2 tensors, the shape the module's own doc examples
    # use. The notation Strs are built once -- str_from allocates, and the
    # benchmark is meant to measure einsum, not str_from.
    var esh = alloc(16);
    store64(esh, 2);
    store64(esh + 8, 2);
    var es_a = tensor_new(2, esh);
    var es_b = tensor_new(2, esh);
    var eda = HTensor_data(es_a);
    var edb = HTensor_data(es_b);
    var eqi = 0;
    while (eqi < 4) {
        store64(eda + eqi * 8, f64_from(eqi + 1));
        store64(edb + eqi * 8, f64_from(eqi + 5));
        eqi = eqi + 1;
    }
    _b_es_ct = alloc(16);
    store64(_b_es_ct, es_a);
    store64(_b_es_ct + 8, es_b);
    _b_es_mm = str_from("ij,jk->ik");
    _b_es_tr = str_from("ii->");

    _b_jsph = geo_sphere_new(hvec3_new(0, 0, 0), f64_div(f64_from(3), F64_TWO));
    _b_jpln = geo_plane_from_point_normal(hvec3_new(0, 0, 0), hvec3_new(F64_ONE, 0, 0));

    _b_jtri = geo_triangle_new(hvec3_new(f64_neg(F64_TWO), f64_neg(F64_ONE), 0),
      hvec3_new(f64_from(3), f64_neg(F64_TWO), f64_div(F64_ONE, F64_TWO)),
      hvec3_new(0, f64_from(4), f64_neg(F64_ONE)));

    _b_capsule = geo_capsule_new(hvec3_new(0, 0, f64_neg(F64_ONE)),
      hvec3_new(0, 0, F64_ONE), F64_ONE);

    # 2.10.1: a DIAGONAL ray, so all three slabs of the box primitives run. The
    # jets are benchmarked on this one -- a jet whose fixture skipped two slabs
    # would report a cost the caller never sees.
    # [measured: bench-history.csv ray_aabb_diag]
    _bray_d = geo_ray_new(hvec3_new(f64_neg(f64_from(4)), f64_neg(f64_from(8)),
        f64_neg(f64_from(12))), hvec3_new(F64_ONE, F64_TWO, f64_from(3)));
    # 2.11.0 autodiff fixtures. Capacity is generous: 16 vars + 16*3 ops + 1.
    _b_tape = ad_tape_new(256);
    _b_adx = alloc(_AD_N * 8);
    var adv = f64_div(F64_ONE, f64_from(4));
    for (var ai = 0; ai < _AD_N; ai = ai + 1) {
        store64(_b_adx + ai * 8, adv);
        adv = f64_add(adv, f64_div(F64_ONE, f64_from(16)));
    }

    _b_obb = geo_obb_new(hvec3_new(0, 0, 0), hvec3_new(F64_ONE, F64_ONE, F64_ONE),
      hquat_identity());

    # Octave-spaced k-d input: every coordinate halves, so the value-midpoint
    # split degenerates and the balance guard is what keeps depth logarithmic.
    _b_kdo_n = 512;
    _b_kdo_pts = alloc(_b_kdo_n * 8);
    var kov = F64_ONE;
    var koi = 0;
    while (koi < _b_kdo_n) {
        kov = f64_mul(kov, F64_HALF);
        store64(_b_kdo_pts + koi * 8, hvec3_new(kov, kov, kov));
        koi = koi + 1;
    }

    # Comb: alternating spike/notch, so half the vertices are REFLEX. This is the
    # ear prune's worst case and the class the 600-gon above cannot reach.
    _b_tpc_n = 600;
    _b_tpc_poly = vec_new();
    var tci = 0;
    while (tci < _b_tpc_n) {
        var cang = f64_div(f64_mul(f64_mul(F64_TWO, F64_PI), f64_from(tci)), f64_from(_b_tpc_n));
        var crad = f64_from(100);
        if (tci % 2 == 1) { crad = f64_from(70); }
        vec_push(_b_tpc_poly, hvec2_new(f64_mul(crad, f64_cos(cang)),
            f64_mul(crad, f64_sin(cang))));
        tci = tci + 1;
    }

    # Small-n convex polygon. 2.9.3 called n = 6 "the size class every shipped call
    # site uses", but there is no shipped call site: nothing in src/, examples/ or
    # any consumer's source calls triangulate_polygon. The basis for n = 6 was
    # hisab's own tests, whose triangulate_polygon fixtures are this small, and an
    # assumption in the archived filing 2026-08-04-perf-triangulate_polygon.md
    # about typical polygons in impetus, kiran, joshua and aethersafha, none of
    # which is a consumer.
    _b_tps_n = 6;
    _b_tps_poly = vec_new();
    var tsi = 0;
    while (tsi < _b_tps_n) {
        var sang = f64_div(f64_mul(f64_mul(F64_TWO, F64_PI), f64_from(tsi)), f64_from(_b_tps_n));
        vec_push(_b_tps_poly, hvec2_new(f64_mul(f64_from(100), f64_cos(sang)),
            f64_mul(f64_from(100), f64_sin(sang))));
        tsi = tsi + 1;
    }

    # 12x12 symmetric-ish matrix for the decompositions.
    _b_sv_A = ganita_mat_new(12, 12);
    _b_eg_A = ganita_mat_new(12, 12);
    var mi = 0;
    while (mi < 12) {
        var mj = 0;
        while (mj < 12) {
            var mv = f64_from(((mi * 7 + mj * 13) % 17) + 1);
            ganita_mat_set(_b_sv_A, mi, mj, mv);
            var sym = f64_from(((mi * 7 + mj * 13) % 17) + ((mj * 7 + mi * 13) % 17) + 2);
            ganita_mat_set(_b_eg_A, mi, mj, sym);
            mj = mj + 1;
        }
        mi = mi + 1;
    }
    _b_sv_U = ganita_mat_new(12, 12);
    _b_sv_Vt = ganita_mat_new(12, 12);
    _b_sv_S = alloc(12 * 8);
    _b_eg_vals = alloc(12 * 8);
    _b_eg_vecs = ganita_mat_new(12, 12);

    # EPA narrowphase fixture (2.8.3): cylinder r=1.8793535667752475,
    # half-height 1.2791168772746317 at the origin, versus a box of half
    # extents (1.911097261472028, 1.6801436342328875, 1.20512296966709) at
    # (2.681243082965721, -2.8647910545143507, -1.9584281656667457) rotated by
    # the unit quaternion (-0.15450336118478533, -0.009688474997439071,
    # -0.11292756753110424, 0.9814694133422273). True penetration depth
    # 0.19769663486454536 (asserted in tests/modules.tcyr).
    _b_epa_cyl = alloc(40);
    store64(_b_epa_cyl, 0);
    store64(_b_epa_cyl + 8, 0);
    store64(_b_epa_cyl + 16, 0);
    store64(_b_epa_cyl + 24, 0x3FFE11D50BAEBAF1);
    store64(_b_epa_cyl + 32, 0x3FF47743423A7FC0);
    _b_epa_box = alloc(80);
    store64(_b_epa_box,      0x4005732F92CFB63E);
    store64(_b_epa_box + 8,  0xC006EB1792881994);
    store64(_b_epa_box + 16, 0xBFFF55B8C5B1A9C0);
    store64(_b_epa_box + 24, 0x3FFE93DAB8D7F5D9);
    store64(_b_epa_box + 32, 0x3FFAE1DE4A99CE2F);
    store64(_b_epa_box + 40, 0x3FF3482F05E60E8C);
    store64(_b_epa_box + 48, 0xBFC3C6C421B492C3);
    store64(_b_epa_box + 56, 0xBF83D78D1A18CF7C);
    store64(_b_epa_box + 64, 0xBFBCE8D2315CE899);
    store64(_b_epa_box + 72, 0x3FEF68328B0A8894);
    _b_epa_n = alloc(8);
    _b_epa_d = alloc(8);

    bench_batch("vec3_add",             &bench_vec3_add, 70000, 20);
    bench_batch("vec3_cross",           &bench_vec3_cross, 35000, 20);
    bench_batch("vec3_normalize",       &bench_vec3_normalize, 26000, 20);

    # Amplified SIMD batches (per-call = N ops; clears the timer floor)
    bench("vec3_dot_x64",         &bench_vec3_dot_x64,         200000);
    bench_batch("vec4_dot_x64",         &bench_vec4_dot_x64, 2000, 200);
    bench("m4_mul_x16",           &bench_m4_mul_x16,           200000);
    bench("m4_transform_x64",     &bench_m4_transform_x64,     200000);

    # Quaternion
    bench("quat_mul",             &bench_quat_mul,             1000000);
    bench_batch("quat_slerp",           &bench_quat_slerp, 2000, 200);
    bench_batch("quat_rotate_vec3",     &bench_quat_rotate_vec3, 20000, 20);

    # Mat4
    bench_batch("m4_mul",               &bench_m4_mul, 2000, 200);
    bench_batch("m4_inverse",           &bench_m4_inverse, 2000, 200);
    bench_batch("m4_transform_point",   &bench_m4_transform_point, 10000, 40);

    # Transform3D
    bench_batch("t3d_compose",          &bench_t3d_compose, 2000, 200);

    # Ray intersections
    bench_batch("jet_sphere",      &bench_jet_sphere,    2000, 200);
    bench_batch("jet_plane",       &bench_jet_plane,     10000, 40);
    bench_batch("jet_triangle",    &bench_jet_triangle,  2000, 200);
    bench_batch("jet_aabb",        &bench_jet_aabb,      2000, 200);
    bench_batch("jet_obb",         &bench_jet_obb,       2000, 200);
    bench_batch("jet_capsule",     &bench_jet_capsule,   2000, 200);
    bench_batch("grad_fwd_16",     &bench_grad_fwd_16,   200, 200);
    bench_batch("grad_rev_16",     &bench_grad_rev_16,   200, 200);
    bench_batch("ray_obb",         &bench_ray_obb,       2000, 200);
    bench_batch("ray_aabb_diag",   &bench_ray_aabb_diag, 13000, 31);
    bench_batch("ray_capsule_diag", &bench_ray_capsule_diag, 2000, 200);
    bench_batch("ray_capsule",     &bench_ray_capsule,   2000, 200);
    bench_batch("ray_sphere",           &bench_ray_sphere, 16000, 25);
    bench_batch("ray_aabb",             &bench_ray_aabb, 17000, 24);
    bench_batch("ray_triangle",         &bench_ray_triangle, 2000, 200);

    # Color
    bench_batch("srgb_to_linear",       &bench_srgb_to_linear, 2000, 200);
    bench_batch("tonemap_reinhard",     &bench_tonemap_reinhard, 42000, 20);

    # Calculus
    bench_batch("calc_derivative",      &bench_calc_derivative, 10000, 40);
    bench("calc_integral_simpson", &bench_calc_integral_simpson, 100000);

    # Number theory
    bench_batch("num_gcd",              &bench_num_gcd, 37000, 20);
    bench("num_is_prime",         &bench_num_is_prime,         500000);

    # Complex
    bench("cx_mul",               &bench_cx_mul,               1000000);

    # Easing / noise
    bench("ease_in_out",          &bench_ease_in_out,          1000000);
    bench("perlin_2d",            &bench_perlin_2d,            200000);

    # Collision hot paths. Iteration counts are low because each call is
    # milliseconds, not nanoseconds; sizes are chosen to expose the O(n^2)
    # behaviour the 2026-08-03 audit found without making CI crawl.
    bench("convex_hull_2d_2k",    &bench_convex_hull_2d,       20);
    bench("halfedge_2k_tris",     &bench_halfedge_from_triangles, 20);
    # 3 iterations, not 20: pre-2.7.0 a single build was seconds, not micros.
    bench("bvh_degenerate_4k",    &bench_bvh_degenerate,          3);
    bench("bvh_query_ray_200x4k", &bench_bvh_query_ray,           5);
    # 2.7.0-L: previously unbenchmarked hot paths.
    bench("kdtree_build_4k",      &bench_kdtree_build,            5);
    bench("kdtree_build_octave_512", &bench_kdtree_build_octave, 20);
    bench("einsum_matmul_2x2",   &bench_einsum_matmul,        20000);
    bench("einsum_trace_2x2",    &bench_einsum_trace,        20000);
    bench("kdtree_radius_4k",     &bench_kdtree_radius,         200);
    bench("delaunay_2d_400",      &bench_delaunay_2d,             3);
    # Cocircular guard. The scattered fixture above cannot see it: a rejected
    # 2.7.1 sweep optimisation was -64% on scatter and 2.6x SLOWER on points
    # sampled from a circle, which is an ordinary input for a physics or mesh
    # consumer. Both classes have to be in the CSV history.
    # [measured: CHANGELOG.md 2.7.1, the rejected delaunay_2d x-sweep table (scatter n=400, cocircular n=150)]
    bench("delaunay_2d_circle_150", &bench_delaunay_2d_circle,      3);
    bench("triangulate_600gon",   &bench_triangulate_polygon,     3);
    bench("triangulate_comb_600", &bench_triangulate_comb,        3);
    bench("triangulate_hex_6",    &bench_triangulate_small,   20000);
    bench("svd_golub_kahan_12",   &bench_svd_golub_kahan,        20);
    bench("eigen_qr_12",          &bench_eigen_qr,               20);
    # 2.8.3: 100 iterations. At the pre-repair 1.47 MB of arena per call this
    # is 147 MB, which is why the count is not higher -- the bump arena never
    # frees, and the point of the benchmark is to keep that number honest.
    # [measured: scratch harness, not reproducible in-tree; CHANGELOG.md 2.8.2 records 1.23 MB for this call]
    bench("gjk_epa_3d_cyl_box",   &bench_gjk_epa_3d,            100);

    # Narrowphase fixtures (2.9.0): rotated-ish offsets so no axis is special.
    _b_np_box_a = _b_np_mkbox(0, 0, 0, F64_ONE, F64_ONE, F64_ONE);
    _b_np_box_b = _b_np_mkbox(f64_div(f64_from(3), f64_from(10)),
      f64_div(F64_ONE, f64_from(7)), f64_neg(f64_div(f64_from(39), f64_from(100))),
      F64_ONE, F64_ONE, F64_ONE);
    _b_np_sph_a = _b_np_mkbox(0, 0, 0, F64_TWO, 0, 0);
    _b_np_sph_b = _b_np_mkbox(f64_div(f64_from(12), f64_from(10)),
      f64_div(f64_from(9), f64_from(10)), f64_div(F64_ONE, f64_from(3)), F64_TWO, 0, 0);
    _b_np_n = alloc(8);
    _b_np_d = alloc(8);
    # 2.9.0 overlap-test fixtures: obviously apart (the broadphase-common case)
    # and exactly tangent (x = 2 against a unit half-extent box at the origin).
    _b_gi_box_far = _b_np_mkbox(f64_from(9), 0, 0, F64_ONE, F64_ONE, F64_ONE);
    _b_gi_sph_far = _b_np_mkbox(f64_from(9), 0, 0, F64_TWO, 0, 0);
    _b_gi_box_tan = _b_np_mkbox(F64_TWO, 0, 0, F64_ONE, F64_ONE, F64_ONE);

    bench("mpr_penetration_boxes", &bench_mpr_penetration_boxes,  200);
    bench("gjk_epa_boxes",         &bench_gjk_epa_boxes,          200);
    bench("gjk_epa_spheres",       &bench_gjk_epa_spheres,        200);
    bench("gjk_epa_sphere_box",    &bench_gjk_epa_sphere_box,     200);
    # Batch-timed (see bench_batch): a clock pair per call costs more than one of
    # these calls, so per-call timing would mostly measure the clock.
    # [measured: lib/bench.cyr calibrates one clock read at 1.3-1.7 us; bench-history.csv gjk_intersect_box_miss]
    bench_batch("gjk_intersect_box_miss", &bench_gjk_intersect_box_miss, 2000, 20);
    bench_batch("gjk_intersect_sph_miss", &bench_gjk_intersect_sph_miss, 2000, 20);
    bench_batch("gjk_intersect_box_hit",  &bench_gjk_intersect_box_hit,   500, 20);
    bench_batch("gjk_intersect_tangent",  &bench_gjk_intersect_tangent,   500, 20);
    bench_batch("mpr_intersect_box_miss", &bench_mpr_intersect_box_miss, 2000, 20);
    bench_batch("mpr_intersect_box_hit",  &bench_mpr_intersect_box_hit,   500, 20);
    bench_batch("mpr_intersect_tangent",  &bench_mpr_intersect_tangent,   500, 20);
    # 2.8.3 performance tier. bvh_scatter_4k is the ordinary build (the
    # degenerate one above never exercised the centroid recompute at depth);
    # spatial_hash_query_2k is two thousand queries against thirty-two thousand points, which was
    # Theta(n/1024) each; num_dct/num_dst_1024 sit above the FFT crossover.
    bench("bvh_scatter_4k",       &bench_bvh_scatter,             5);
    bench("spatial_hash_query_2k", &bench_spatial_hash_query,     5);
    bench("num_dct_1024",         &bench_num_dct_1024,           10);
    bench("num_dst_1024",         &bench_num_dst_1024,           10);
    bench("num_dct_1023",         &bench_num_dct_1023,           10);
    bench("num_dst_1023",         &bench_num_dst_1023,           10);

    # ⛔ THESE TWO REGISTER LAST, AND THAT POSITION IS LOAD-BEARING. They build
    # tapes under a bump allocator that NEVER FREES, so wherever they sit they
    # shift the heap for every row registered after them. `bench-history.csv` has
    # the record: with them registered 19th/20th the two runs at d740afc read
    # **480 ns and 396 ns**; with them last, **668 ns**; and the previous release
    # read 706 ns. So adding a benchmark moved an untouched module's row by
    # **-32% to -44%**, and moving them last restores it to within 5% of baseline.
    # ⚠ Quote the CSV, not a bench run: an earlier draft cited 484/696/709 ns from
    # ad-hoc `cyrius bench` invocations, none of which appear in the record.
    # ⚠ Registering last cannot remove the effect, only confine it to rows that do
    # not exist. Anything added after this line inherits the perturbation.
    # [measured: with/without these two rows on one binary, 2026-09-10]
    bench_batch("jac_rev_shared_256",  &bench_jac_rev_shared_256,   5, 5);
    bench_batch("jac_rev_pertape_256", &bench_jac_rev_pertape_256,  5, 5);
    if (_B_AD_FAIL != 0) {
        println("FATAL: a reverse-mode row returned Err -- the tape is too small and the row measured a failed sweep");
        return 1;
    }

    # ⚠ REGISTERED LAST, AFTER the jac_rev pair, for the reason documented above
    # it: rows added earlier shift the heap for everything after them under a bump
    # allocator that never frees. Anything added below this line inherits that.
    _b_cga_p = cga_point(f64_from(3), f64_from(4), f64_from(5));
    _b_cga_q = cga_point(f64_from(1), f64_from(2), f64_from(6));
    _b_cga_k5 = cga_point(f64_from(2), f64_from(7), f64_from(3));
    _b_cga_k32 = cga_mv_zero();
    for (var _bk = 0; _bk < 32; _bk = _bk + 1) {
        cga_mv_set(_b_cga_k32, _bk, f64_from(_bk + 1));
    }

    # ⚠ THE COLD ROW MUST COME FIRST AND MUST BE n = 1. If the table is already
    # built this measures the warm path and silently reads ~400x better.
    # [measured: cold 203.9 us vs warm 1.2 us, 2026-09-11]
    if (_CGA_NULL_TBL != 0) {
        println("FATAL: CGA table already built -- the cold row is not cold");
        return 1;
    }
    bench("cga_first_product_cold", &bench_cga_first_product_cold, 1);

    bench("cga_point_product",      &bench_cga_point_product,      2000);
    bench("cga_norm_sq_k5",         &bench_cga_norm_sq_k5,         2000);
    bench("cga_norm_sq_k32",        &bench_cga_norm_sq_k32,        200);

    # 3.2.0 — REGISTERED LAST, after the CGA rows, for the heap-shift reason
    # documented above the jac_rev pair; the vec2 fixture is also allocated here
    # rather than beside the vec3 one so no earlier row's heap moves.
    _bv2a = hvec2_new(F64_ONE, F64_TWO);
    _bv2b = hvec2_new(f64_from(4), f64_from(5));
    bench_batch("vec3_lerp",            &bench_vec3_lerp, 42000, 20);
    bench_batch("vec2_lerp",            &bench_vec2_lerp, 52000, 20);

    # 3.3.6 -- REGISTERED LAST, after the lerp rows, and their fixtures are allocated
    # here for the same heap-shift reason. Their paths are checked before any of them
    # runs (see the 3.3.6 block above main).
    if (_b6_setup() != 0) {
        println("FATAL: a 3.3.6 row would measure a different path than its name -- see above");
        return 1;
    }
    _b6_rows();

    # 3.3.7 -- REGISTERED LAST, after the 3.3.6 rows, their fixtures allocated in
    # _b7_setup for the same heap-shift reason, and checked there before any is timed.
    if (_b7_setup() != 0) {
        println("FATAL: a 3.3.7 row would measure a different path than its name -- see above");
        return 1;
    }
    _b7_rows();

    # 3.4.0 lane AL -- REGISTERED LAST, after the 3.3.7 rows, fixtures allocated in
    # _b8al_setup for the same heap-shift reason.
    _b8al_setup();
    bench("kdtree_nearest_4k",              &bench_kdtree_nearest_4k,          100000);
    bench("sh_evaluate_l2",                 &bench_sh_evaluate_l2,             400000);
    bench("lorentz_is_valid",               &bench_lorentz_is_valid,           100000);
    bench("levi_civita_4",                  &bench_levi_civita_4,              400000);

    # 3.4.0 lane NU2 -- REGISTERED LAST, after the 3.3.7 rows, and checked in _bnu2_setup
    # before any is timed, as the 3.3.6 and 3.3.7 blocks are.
    if (_bnu2_setup() != 0) {
        println("FATAL: a 3.4.0 lane NU2 row would measure a different path than its name -- see above");
        return 1;
    }
    _bnu2_rows();

    # 3.4.0 lane LA -- REGISTERED LAST, after the 3.3.7 rows (see _bla_setup).
    if (_bla_setup() != 0) {
        println("FATAL: a 3.4.0 lane LA row would measure a different path than its name -- see above");
        return 1;
    }
    _bla_rows();

    # 3.4.0 lane NU1 -- REGISTERED LAST, after the 3.3.7 rows (see _b34nu1_rows).
    if (_b34nu1_setup() != 0) {
        println("FATAL: a 3.4.0 lane NU1 row would measure a refusal -- see _b34nu1_setup");
        return 1;
    }
    _b34nu1_rows();

    # 3.4.0 lane CO -- REGISTERED LAST, after the 3.3.7 rows, for the same heap-shift reason.
    if (_b8_setup() != 0) {
        println("FATAL: a 3.4.0 lane CO row would measure a different path than its name -- see above");
        return 1;
    }
    _b8_rows();

    # 3.4.0 lane RT -- REGISTERED LAST, after the 3.3.7 rows, their fixtures allocated in
    # _b8rt_setup for the same heap-shift reason, and checked there before any is timed.
    if (_b8rt_setup() != 0) {
        println("FATAL: a 3.4.0 RT row would measure a different path than its name -- see above");
        return 1;
    }
    _b8rt_rows();

    # 3.4.0 lane FB -- REGISTERED LAST, after the 3.3.7 rows, fixtures allocated in
    # _bfb_setup for the same heap-shift reason, and checked there before any is timed.
    if (_bfb_setup() != 0) {
        println("FATAL: a 3.4.0 lane FB row would measure a different path than its name -- see above");
        return 1;
    }
    _bfb_rows();

    # 3.4.0 lane RT, review repairs -- REGISTERED LAST, after lane FB's rows, fixtures allocated
    # in _b8rv_setup and checked there before any is timed.
    if (_b8rv_setup() != 0) {
        println("FATAL: a 3.4.0 RT review row would measure a different path than its name -- see above");
        return 1;
    }
    _b8rv_rows();

    # 3.4.0 lane RT, the capsule jet's infinite end -- REGISTERED LAST, after lane FB's rows.
    if (_b8rj_setup() != 0) { return 1; }
    bench("jet_capsule_half_infinite", &bench_jet_capsule_half_infinite, 200000);

    # 3.4.0 lane RT, second review -- REGISTERED LAST, after the jet row.
    if (_b8r4_setup() != 0) {
        println("FATAL: a 3.4.0 RT second-review row would measure a different path than its name -- see above");
        return 1;
    }
    bench("ray_sphere_graze_close", &bench_ray_sphere_graze_close, 200000);

    println("=== done ===");
    return 0;
}

var r = main();
sys_exit_group(r);
