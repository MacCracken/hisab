}
fn bench_n3q_lbfgs_quad6_x2m27() {
    for (var i = 0; i < 6; i = i + 1) { store64(_b341n3q_x0 + i * 8, 0); }
    var t, v = opt_lbfgs(&_b341n3q_qf, &_b341n3q_qg, _b341n3q_x0, 6, 5, 0x3FFE5EB8A5CD53EC, 5000, _b341n3q_ox,
