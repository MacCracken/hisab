    _b341n3q_nf = 0;
    var t2 = bench_n3q_bfgs_extros_f2m35();
    _b341n3q_check(is_ok(t1) == 1 && is_ok(t2) == 1 && _b341n3q_nf == n1, "opt_bfgs_extros10_f2^-35");
    var t3 = bench_n3q_lbfgs_quad6_x2m27();
    var d6 = f64_abs(f64_sub(f64_div(load64(_b341n3q_ox + 40), _b341n3q_k), F64_ONE));
    _b341n3q_check(is_ok(t3) == 1 && f64_lt(d6, 0x3EB0C6F7A0B5ED8D) == 1, "opt_lbfgs_quad6_x2^-27.5");
    return _B341N3Q_FAIL;
}
fn _b341n3q_rows() {
    bench("opt_bfgs_extros10_f2^-35",   &bench_n3q_bfgs_extros_f2m35,   2000);
    bench("opt_lbfgs_quad6_x2^-27.5",   &bench_n3q_lbfgs_quad6_x2m27,   200);
    return 0;
}

# ================================================================
# 3.4.1 lane GEO5 -- geo_barycentric_coords' certified paths and geo_ray_plane's certified small sums
# ================================================================
# An ordinary triangle with the point in its plane (the near-plane stage) and with it 1.2 edge lengths
# off (the second stage), each a triangle whose 3.4.0 Gram answer was beyond 64 ulps of the largest
# weight; a triangle just above the thin switch that the bound declines (it pays _geo_bary_thin); and a
# small-path ray whose two sums both take the certified double path with three products each. The
# setup also checks the paths of the rows this lane moved or relies on: GEO2's triangle_unit_normal
# (the fast path) and triangle_unit_normal_flush (the exact sum), ray_plane_subnormal (both sums
# certified), ray_plane_small_cancel (n . d declined), and the thin and colinear barycentric rows
# (the thin path, their bits unchanged).
# [measured: GEO5 3.4.1 pick5.py and psw5.py fixtures, Fraction oracle, 2026-11-01]
var _bg5_fail = 0;
var _bg5_t1 = 0;
var _bg5_p1 = 0;
var _bg5_t2 = 0;
var _bg5_p2 = 0;
var _bg5_t3 = 0;
var _bg5_p3 = 0;
var _bg5_rp = 0;
var _bg5_pl = 0;
fn _bg5_check(ok, name) {
    if (ok == 0) {
        println(name);
        _bg5_fail = 1;
    }
    return 0;
}
fn _bg5_tri(ax, ay, az, bx, by, bz, cx, cy, cz) {
    return geo_triangle_new(hvec3_new(ax, ay, az), hvec3_new(bx, by, bz), hvec3_new(cx, cy, cz));
}
fn _bg5_code(tri, p) {
    var w: i64[3];
    return _geo_bary_cert(GeoTriangle_v0(tri), GeoTriangle_v1(tri), GeoTriangle_v2(tri), p, &w);
}
fn _bg5_unf(tri) {
    var w: i64[3];
    return _geo_unit_normal_fast(GeoTriangle_v0(tri), GeoTriangle_v1(tri), GeoTriangle_v2(tri), &w);
}
fn _bg5_dots(ray, plane) {
    # _geo_plane_dot_fast's codes for n . d and d0 - n . o, as 3 (d) * 4 + 3 (o) offsets (2 = declined)
    var o: i64[2];
    var cd = _geo_plane_dot_fast(GeoPlane_normal(plane), GeoRay_direction(ray), 0, 0, &o);
    var cn = _geo_plane_dot_fast(GeoPlane_normal(plane), GeoRay_origin(ray), GeoPlane_distance(plane), 1, &o);
    return (cd + 3) * 4 + cn + 3;
}
fn bench_barycentric_ordinary() { return HVec3_x(geo_barycentric_coords(_bg5_t1, _bg5_p1)); }
fn bench_barycentric_offplane() { return HVec3_x(geo_barycentric_coords(_bg5_t2, _bg5_p2)); }
fn bench_barycentric_declined() { return HVec3_x(geo_barycentric_coords(_bg5_t3, _bg5_p3)); }
fn bench_ray_plane_small_fast() { return geo_ray_plane(_bg5_rp, _bg5_pl); }
fn _bg5_setup() {
    _bg5_t1 = _bg5_tri(0x3FF94D60D36C4360, 0x3FFAE0A9B5D3E068, 0xBFD0045AA7D88888, 0xBFFEC2E952460DC8,
      0xBFC4916399912FC0, 0xC002DC3FCD98E716, 0xC001D588BDD93A8C, 0xBFDAA6652E76CBF0, 0xC0039907652FB1E2);
    _bg5_p1 = hvec3_new(0xBFFD001ACED8188C, 0xBFC36BD96E3D94A0, 0xC001F32609F55E97);
    _bg5_check(bench_barycentric_ordinary() == 0x3FB39BB3F7BC0080, "barycentric_ordinary");
    _bg5_check(_bg5_code(_bg5_t1, _bg5_p1) == 1, "barycentric_ordinary: certified");
    _bg5_t2 = _bg5_tri(0xC0051698F315D070, 0xBFF632A3F85473CE, 0x3FF0831C5D31B8F8, 0x3FF273248E9CC118,
      0x3FF0DE30FDE0185C, 0xBFF413E9437E593A, 0x3FB9661976D30920, 0xBFCB2390D34619C0, 0xBFC9D9FDD65A0940);
    _bg5_p2 = hvec3_new(0xBFFCDF3B34428914, 0x4006F3358483DF44, 0x4004F0B17ED6719C);
    _bg5_check(bench_barycentric_offplane() == 0x3FFC214179EBB6EA, "barycentric_offplane");
    _bg5_check(_bg5_code(_bg5_t2, _bg5_p2) == 1, "barycentric_offplane: certified");
    _bg5_t3 = _bg5_tri(0x3FF88CF9FBF0D438, 0x3FEE44FF71EFE8BC, 0x3FE79FADA9C90EB0, 0x400266095DAE28D8,
      0xC001014705ABC43A, 0x40013207E9BB95C6, 0x3FF8B0CC6BF113FC, 0x3FED22FC411FF1FF, 0x3FE826A1A3837BE4);
    _bg5_p3 = hvec3_new(0x4004F8C867DA7BCF, 0xC00B556A3CE37F81, 0x4005F143B1595A25);
    _bg5_check(bench_barycentric_declined() == 0xBFF60ED7A3603B92, "barycentric_declined");
    _bg5_check(_bg5_code(_bg5_t3, _bg5_p3) == 0, "barycentric_declined: the thin path");
    _bg5_rp = _b8rt_ray(0xBFA778AAE8DA56CA, 0xBC435C823B33AD12, 0x3DCA24E3CD66ED6A, 0x209ED48D09588B4F,
      0x9880FDBA2044D6AA, 0x9D9C3C4B8A31847E);
    _bg5_pl = alloc(sizeof(GeoPlane));
    GeoPlane_set_normal(_bg5_pl, hvec3_new(0x9CCC3123F91A74B0, 0x1DB3087BBE5E7B8A, 0x1EF2C2869BAE3091));
    GeoPlane_set_distance(_bg5_pl, 0x8292E67A84D0DF96);
    _bg5_check(bench_ray_plane_small_fast() == 0x5F42D12F23764E0B, "ray_plane_small_fast");
    _bg5_check(_bg5_dots(_bg5_rp, _bg5_pl) == 2 * 4 + 2, "ray_plane_small_fast: both sums certified");
    # The rows this lane moved or relies on.
    _bg5_check(_bg5_dots(_bg41_rp, _bg41_pl) == 4 * 4 + 4, "ray_plane_subnormal: both sums certified");
    _bg5_check(_bg5_dots(_bg3_rp, _bg3_pl) == 1 * 4 + 4, "ray_plane_small_cancel: n . d declined");
    _bg5_check(_bg5_unf(_bg2_tn) == 1, "triangle_unit_normal: the fast path");
    _bg5_check(_bg5_unf(_bg2_tf) == 0 - 1, "triangle_unit_normal_flush: the exact sum");
    _bg5_check(_bg5_code(_b8rt_thin, _b8rt_thinp) == 0, "barycentric_thin: the thin path");
    _bg5_check(_bg5_code(_b8rt_col, _b8rt_colp) == 0, "barycentric_colinear: the thin path");
    _bg5_check(_bg5_code(_bg3_tcol, _bg3_pcol) == 0, "barycentric_colinear_far: the thin path");
    _bg5_check(_bg5_code(_bg3_tsl, _bg3_psl) == 0, "barycentric_sliver: the thin path");
    return _bg5_fail;
}

# ================================================================
# 3.4.1 lane MAT4 (reach) -- the SIMD functions 3.3.7's bench reached with no row
# ================================================================
# hvec3_mul, hvec4_add / _sub / _scale and hquat_dot, named by the roadmap's bench-reach row.
# hquat_normalize, hquat_inverse and world_to_screen, the other three it names, were retired in
# 3.4.0 for their `_checked` forms, which already have rows
# (quat_normalize_checked, quat_inverse_checked, world_to_screen_checked). Each row's answer is
# checked, every component, before anything is timed; the fixtures are main's _bv3a / _bv3b /
# _bv4a / _bv4b, (1, 2, 3), (4, 5, 6), (1, 2, 3, 4), (5, 6, 7, 8), whose answers are exact, and
# main's _bq1 / _bq2, rotations about y and x, whose dot is the one product w1 w2.
var _brch_fail = 0;
fn _brch_check(ok, name) {
    if (ok == 0) {
        println(name);
        _brch_fail = 1;
    }
    return 0;
}
fn bench_brch_vec3_mul() { return HVec3_z(hvec3_mul(_bv3a, _bv3b)); }
fn bench_brch_vec4_add() { return HVec4_w(hvec4_add(_bv4a, _bv4b)); }
fn bench_brch_vec4_sub() { return HVec4_w(hvec4_sub(_bv4a, _bv4b)); }
fn bench_brch_vec4_scale() { return HVec4_w(hvec4_scale(_bv4a, F64_HALF)); }
fn bench_brch_quat_dot() { return hquat_dot(_bq1, _bq2); }
fn _brch_v3(v, x, y, z) {
    if (v == 0) { return 0; }
    return HVec3_x(v) == x && HVec3_y(v) == y && HVec3_z(v) == z;
}
fn _brch_v4(v, x, y, z, w) {
    if (v == 0) { return 0; }
    return HVec4_x(v) == x && HVec4_y(v) == y && HVec4_z(v) == z && HVec4_w(v) == w;
}
fn _brch_setup() {
    _brch_fail = 0;
    _brch_check(_brch_v3(hvec3_mul(_bv3a, _bv3b), f64_from(4), f64_from(10), f64_from(18)) == 1
      && bench_brch_vec3_mul() == f64_from(18), "vec3_mul: (4, 10, 18)");
    _brch_check(_brch_v4(hvec4_add(_bv4a, _bv4b), f64_from(6), f64_from(8), f64_from(10), f64_from(12)) == 1
      && bench_brch_vec4_add() == f64_from(12), "vec4_add: (6, 8, 10, 12)");
    _brch_check(_brch_v4(hvec4_sub(_bv4a, _bv4b), f64_from(0 - 4), f64_from(0 - 4), f64_from(0 - 4),
        f64_from(0 - 4)) == 1 && bench_brch_vec4_sub() == f64_from(0 - 4), "vec4_sub: (-4, -4, -4, -4)");
    _brch_check(_brch_v4(hvec4_scale(_bv4a, F64_HALF), F64_HALF, F64_ONE, 0x3FF8000000000000, F64_TWO) == 1
      && bench_brch_vec4_scale() == F64_TWO, "vec4_scale: (0.5, 1, 1.5, 2)");
    _brch_check(HQuat_x(_bq1) == 0 && HQuat_y(_bq2) == 0 && HQuat_z(_bq1) == 0 && HQuat_z(_bq2) == 0
      && bench_brch_quat_dot() == f64_mul(HQuat_w(_bq1), HQuat_w(_bq2)), "quat_dot: w1 w2");
    return _brch_fail;
}

# ================================================================
# 3.4.1 lane MAT4 -- the wide tier's equilibrated pass
# ================================================================
# Round-3 review's lossy_baseok: a row near 2^1000 with rows near 2^-430, a product of two entries
