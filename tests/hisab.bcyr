# 5 x 5 upper triangular, couplings from _b6_fill, diagonal 1..5 scaled: answered off the
# diagonal since 3.4.0 (3.3.7 iterated it). 2 x 2 at 2^-1040: the scaled frame. 4 x 4 dense
# for lyapunov_max at 50 steps; 3 x 3 for the SVD wrapper.
fn bench_eigen_power_tri5() {
    var t, v = eigen_power(_bla_tri, 5, 1000, _bla_val, _bla_vec);
    return t;
}
fn bench_eigen_power_tiny2() {
    var t, v = eigen_power(_bla_tiny, 2, 1000, _bla_val, _bla_vec);
    return t;
}
# The 3.3.4 graded 3x3 whose converged iterate has a subnormal component: one component, so the
# plain run and then the m * 2^e wide run (eigen_power_2x2_wide is the 2 x 2 form since the 3.4.0
# review; its 3.3.6 fixture is triangular and is read off its diagonal).
var _bla_wide = 0;
fn bench_eigen_power_wide3() {
    var t, v = eigen_power(_bla_wide, 3, 1000, _bla_val, _bla_vec);
    return t;
}
fn bench_lyapunov_4x4_k50() {
    var t, v = lyapunov_max(_bla_ly, 4, 50, _bla_out);
    return t;
}
fn bench_svd_compute_checked_3x3() {
    var t, v = svd_compute_checked(_bla_sv, _bla_U, _bla_S, _bla_Vt);
    return t;
}
fn _bla_setup() {
    _bla_val = alloc(8);
    _bla_vec = alloc(5 * 8);
    _bla_out = alloc(8);
    var c = _b6_fill(alloc(25 * 8), 25, 29);
    _bla_tri = ganita_mat_new(5, 5);
    for (var i = 0; i < 5; i = i + 1) {
        for (var j = i; j < 5; j = j + 1) {
            if (i == j) { ganita_mat_set(_bla_tri, i, j, f64_from(i + 1)); }
            if (i != j) { ganita_mat_set(_bla_tri, i, j, load64(c + (i * 5 + j) * 8)); }
        }
    }
    _bla_wide = ganita_mat_new(3, 3);
    ganita_mat_set(_bla_wide, 0, 0, 0x3FEA8E43D21BDD22);
    ganita_mat_set(_bla_wide, 0, 1, 0xE15AD1E5DF1EF8EA);
    ganita_mat_set(_bla_wide, 0, 2, 0x7F952C3CAD913658);
    ganita_mat_set(_bla_wide, 1, 0, 0x9E746FBE2257D824);
    ganita_mat_set(_bla_wide, 1, 1, 0xBFE50EEE4ADAC636);
    ganita_mat_set(_bla_wide, 1, 2, 0xE15918BD7ED2C3C0);
    ganita_mat_set(_bla_wide, 2, 1, 0x9E58525DBB6E0920);
    ganita_mat_set(_bla_wide, 2, 2, 0x3FE2305F5C787BE0);
    _bla_tiny = ganita_mat_new(2, 2);
    ganita_mat_set(_bla_tiny, 0, 0, 0x00000002D8000000);
    ganita_mat_set(_bla_tiny, 0, 1, 0x0000000130000000);
    ganita_mat_set(_bla_tiny, 1, 0, 0x00000000D8000000);
    ganita_mat_set(_bla_tiny, 1, 1, 0x000000039C000000);
    var d = _b6_fill(alloc(16 * 8), 16, 31);
    _bla_ly = ganita_mat_new(4, 4);
    for (var k = 0; k < 16; k = k + 1) { ganita_mat_set(_bla_ly, k / 4, k % 4, load64(d + k * 8)); }
    var e = _b6_fill(alloc(9 * 8), 9, 37);
    _bla_sv = ganita_mat_new(3, 3);
    for (var q = 0; q < 9; q = q + 1) { ganita_mat_set(_bla_sv, q / 3, q % 3, load64(e + q * 8)); }
    _bla_U = ganita_mat_new(3, 3);
    _bla_S = alloc(3 * 8);
    _bla_Vt = ganita_mat_new(3, 3);
    _bla_check(is_ok(bench_eigen_power_tri5()) == 1 && load64(_bla_val) == 0x4014000000000000, "eigen_power_tri5");
    _bla_check(is_ok(bench_eigen_power_tiny2()) == 1, "eigen_power_tiny2");
    # the wide run's answer (tests/abuse.tcyr, 3.3.4 krylov fixture (2))
    _bla_check(is_ok(bench_eigen_power_wide3()) == 1 && load64(_bla_val) == 0x3FF2B3CB5B84D0EE, "eigen_power_wide3");
    _bla_check(is_ok(bench_lyapunov_4x4_k50()) == 1, "lyapunov_4x4_k50");
    _bla_check(is_ok(bench_svd_compute_checked_3x3()) == 1, "svd_compute_checked_3x3");
    return _BLA_FAIL;
}
fn _bla_rows() {
    bench("eigen_power_tri5",               &bench_eigen_power_tri5,             2000);
    bench("eigen_power_tiny2",              &bench_eigen_power_tiny2,             200);
    bench("eigen_power_wide3",              &bench_eigen_power_wide3,             200);
    bench("lyapunov_4x4_k50",               &bench_lyapunov_4x4_k50,              200);
    bench("svd_compute_checked_3x3",        &bench_svd_compute_checked_3x3,     20000);
    return 0;
}

# ---- 3.4.0 lane CO: the paths the collision repairs added, each checked before it is timed.
# A sphere 1e-9 into a rotated box's face (the face snap answers its depth); a sphere 1e-12
# from a box edge (GJK's uncertain tetrahedron, refuted where 3.3.7 took it as a contact); an
# end cap 1.28e-12 into a sphere at 1e3, below the proof margin (the band); and a sphere swept
# onto a box edge (time_of_impact's snap). The fixtures are lane CO's (tests/modules_c.tcyr,
# "3.4.0 collision").
# [measured: lane-CO r1.py, r23.py, pick.py and pick2.py, 3.3.7 base and this tree, 2026-10-31; cycc 6.7.9]
var _B8_FAIL = 0;
fn _b8_check(ok, name) {
    if (ok == 1) { return 0; }
    syscall(1, 1, "FATAL: 3.4.0 row ", 17);
    syscall(1, 1, name, strlen(name));
    println(" does not take the path its name says");
    _B8_FAIL = _B8_FAIL + 1;
    return 1;
}
fn _b8_sup_obb(shape, dir) {
    var acc = hvec3_new(load64(shape), load64(shape + 8), load64(shape + 16));
    for (var oi = 0; oi < 3; oi = oi + 1) {
        var u = hvec3_new(load64(shape + 48 + oi * 24), load64(shape + 56 + oi * 24), load64(shape + 64 + oi * 24));
        var hh = load64(shape + 24 + oi * 8);
        if (f64_lt(hvec3_dot(dir, u), 0) == 1) { hh = f64_neg(hh); }
        acc = hvec3_add(acc, hvec3_scale(u, hh));
    }
    return acc;
}
fn _b8_fill(p, a0, a1, a2, a3, a4, a5, a6, a7, a8, a9, a10, a11, a12, a13, a14) {
    store64(p, a0); store64(p + 8, a1); store64(p + 16, a2); store64(p + 24, a3); store64(p + 32, a4);
    store64(p + 40, a5); store64(p + 48, a6); store64(p + 56, a7); store64(p + 64, a8); store64(p + 72, a9);
    store64(p + 80, a10); store64(p + 88, a11); store64(p + 96, a12); store64(p + 104, a13); store64(p + 112, a14);
    return p;
}
var _b8_fb = 0;
var _b8_fs = 0;
var _b8_eb = 0;
var _b8_es = 0;
var _b8_cc = 0;
var _b8_cs = 0;
