# ~1e-8 — for iterative / decomposition results where exact bit equality is not
# achievable but 8 significant digits is.
var LOOSE_TOL_H = 0x3E45798EE2308C3A;
# ~1e-15 -- a few ulp of 1.0. For quantities whose closed form is exactly 0 or 1
# (unit-vector rotations, M*M^-1 diagonals, group-inverse round-trips, Euler's
# identity). Every one of them lands within 1 ulp on 6.5.6, so this is ~4.5x the
# measured floor. It replaces a literal f64_from(1): a tolerance of 1.0 around an
# expected 1.0 admits everything in [0, 2] and can never fail.
# [measured: CHANGELOG.md 2.7.0, the literal-1.0 tolerance repair ("Measured residuals ... every one within 1 ulp")]
var ULP_TOL_H = 0x3CD203AF9EE75616;
var TOL_1EM14 = 0x3D06849B86A12B9B;  # 1e-14
var TOL_1EM12 = 0x3D719799812DEA11;  # 1e-12 (== EPSILON_F64)  # 1e-15

# ================================================================
# Tolerance helper — added 2.13.0
# ================================================================
# ⭐ WHY THIS EXISTS. Before 2.13.0 this suite compared floats through
# `f64_to(x)`, which TRUNCATES: `assert_eq(f64_to(v), 3)` accepts every v in
# [3, 4), i.e. an absolute error of up to 1.0. Measured on the pre-conversion
# tree: `hvec2_add` could return `a + b + 0.9` and **all 3572 assertions still
# passed**. 2.13.0 converted the exact cases to bit-exact compares; this helper
# is for the cases that are genuinely approximate, so "approximate" is a named
# decision at the call site instead of a side effect of truncation.
# ⚠ Use `assert_eq(a, b, msg)` when the value IS exact — most are. Reach for
# this only when a transcendental or an iteration makes exactness untrue.
# [measured: scratch harness, not reproducible in-tree, 2026-09-09]
fn assert_f64_eq(a, b, msg) {
    assert(f64_approx_eq(a, b, LOOSE_TOL_H), msg);
    return 0;
}

# Counts how many times solve_gmres actually invokes the caller's callback, so
# the documented "maximum total matrix-vector products" budget can be asserted
# rather than assumed. 3x3 SPD tridiagonal.
var _gmb_calls = 0;
fn _gmb_A(x) {
    _gmb_calls = _gmb_calls + 1;
    var out = alloc(3 * 8);
    store64(out, f64_add(f64_mul(f64_from(4), load64(x)), load64(x + 8)));
    store64(out + 8, f64_add(f64_add(load64(x), f64_mul(f64_from(4), load64(x + 8))), load64(x + 16)));
    store64(out + 16, f64_add(load64(x + 8), f64_mul(f64_from(4), load64(x + 16))));
    return out;
}

alloc_init();

# ================================================================
# Vec2
# ================================================================
test_group("hvec2");

var a2 = hvec2_new(f64_from(3), f64_from(4));
assert_eq(HVec2_x(a2), f64_from(3), "new.x");
assert_eq(HVec2_y(a2), f64_from(4), "new.y");

var b2 = hvec2_new(f64_from(1), f64_from(2));
var c2 = hvec2_add(a2, b2);
assert_eq(HVec2_x(c2), f64_from(4), "add.x");
assert_eq(HVec2_y(c2), f64_from(6), "add.y");

var dot2 = hvec2_dot(a2, b2);
assert_eq(dot2, f64_from(11), "dot");
assert_eq(hvec2_length(a2), f64_from(5), "length");

# ================================================================
# Vec3
# ================================================================
test_group("hvec3");

var a3 = hvec3_new(f64_from(1), f64_from(2), f64_from(3));
var b3 = hvec3_new(f64_from(4), f64_from(5), f64_from(6));
var c3 = hvec3_add(a3, b3);
assert_eq(HVec3_x(c3), f64_from(5), "add.x");
assert_eq(HVec3_y(c3), f64_from(7), "add.y");
assert_eq(HVec3_z(c3), f64_from(9), "add.z");
assert_eq(hvec3_dot(a3, b3), f64_from(32), "dot");

var cr = hvec3_cross(hvec3_unit_x(), hvec3_unit_y());
assert_eq(HVec3_z(cr), f64_from(1), "cross.z");

# ================================================================
# Vec4
# ================================================================
test_group("hvec4");

var a4 = hvec4_new(f64_from(1), f64_from(2), f64_from(3), f64_from(4));
var b4 = hvec4_new(f64_from(5), f64_from(6), f64_from(7), f64_from(8));
assert_eq(hvec4_dot(a4, b4), f64_from(70), "dot");
assert_eq(HVec3_z(hvec4_xyz(a4)), f64_from(3), "xyz.z");

# ================================================================
# Quaternion
# ================================================================
test_group("hquat");

var qi = hquat_identity();
assert_eq(HQuat_w(qi), f64_from(1), "identity.w");

# q * identity = q
var qr = hquat_from_rotation_z(F64_PI_2);
var qri = hquat_mul(qr, qi);
assert(f64_lt(f64_abs(f64_sub(HQuat_w(qr), HQuat_w(qri))), EPSILON_F64) == 1, "mul identity");

# Rotate (1,0,0) by 90deg around Z → approx (0,1,0)
var rotated = hquat_rotate_vec3(qr, hvec3_unit_x());
# Closed form: exactly (0, 1, 0). Measured on 6.5.6: x = 2.220446e-16 (1 ulp of
# 1.0), y - 1 = 0, z = 0. The old bound of 1.0 was met by EVERY nonzero rotation
# angle -- |x| = |cos t| < 1 and |y - 1| = |1 - sin t| < 1 for all t in (0, pi).
# [measured: CHANGELOG.md 2.7.0 records rot90.x 2.22e-16 (a scratch run); the asserts below bound it at 1e-15]
assert(f64_lt(f64_abs(HVec3_x(rotated)), ULP_TOL_H) == 1, "rot90.x == 0 (1e-15)");
assert(f64_lt(f64_abs(f64_sub(HVec3_y(rotated), F64_ONE)), ULP_TOL_H) == 1, "rot90.y == 1 (1e-15)");
assert(f64_lt(f64_abs(HVec3_z(rotated)), ULP_TOL_H) == 1, "rot90.z == 0 (1e-15)");
# |x| <= 1 holds for every rotation of a unit vector, so the bound above only
# bites next to a case that pins the ANGLE. 45 deg about Z sends (1,0,0) to
# (sqrt(2)/2, sqrt(2)/2, 0) = (0.7071067811865476, 0.7071067811865476, 0).
var _sqrt2_2 = 0x3FE6A09E667F3BCD;  # 0.7071067811865476
var rot45 = hquat_rotate_vec3(hquat_from_rotation_z(F64_PI_4), hvec3_unit_x());
assert(f64_lt(f64_abs(f64_sub(HVec3_x(rot45), _sqrt2_2)), ULP_TOL_H) == 1, "rot45.x == sqrt(2)/2");
assert(f64_lt(f64_abs(f64_sub(HVec3_y(rot45), _sqrt2_2)), ULP_TOL_H) == 1, "rot45.y == sqrt(2)/2");

# ================================================================
# Mat4
# ================================================================
test_group("mat4");

var mi = m4_identity();
var tv = hvec4_new(f64_from(1), f64_from(2), f64_from(3), f64_from(1));
var mr = m4_mul_vec4(mi, tv);
assert_eq(HVec4_x(mr), f64_from(1), "I*v.x");
assert_eq(HVec4_y(mr), f64_from(2), "I*v.y");

var mii = m4_mul(mi, mi);
assert_eq(m4_get(mii, 0, 0), f64_from(1), "I*I[0,0]");
assert_eq(m4_get(mii, 0, 1), f64_from(0), "I*I[0,1]");

# SRT translate
var srt = m4_from_srt(hvec3_one(), hquat_identity(), hvec3_new(f64_from(2), f64_from(3), f64_from(4)));
var tp_t, tp = m4_transform_point_checked(srt, hvec3_zero());
assert_eq(HVec3_x(tp), f64_from(2), "srt.x");
assert_eq(HVec3_y(tp), f64_from(3), "srt.y");
assert_eq(HVec3_z(tp), f64_from(4), "srt.z");

# Inverse: M * M^-1 ≈ I
var inv_t, inv = m4_inverse_checked(srt);
var prod = m4_mul(srt, inv);
# srt is a pure translation, so M * M^-1 is I exactly -- measured residual 0 on
# every entry. The old bound of 1.0 accepted any [0][0] in [0, 2]; and a single
# diagonal entry is not an inverse test anyway (m4_inverse returning I unchanged
# leaves [0][0] == 1). Check all 16 entries.
# [measured: scratch run at 2.7.0, not reproducible in-tree; "M * M^-1 == I in all 16 entries (1e-15)" bounds it]
assert(f64_lt(f64_abs(f64_sub(m4_get(prod, 0, 0), F64_ONE)), ULP_TOL_H) == 1, "inv diag [0][0] == 1");
var _mi_bad = 0;
var _mi_r = 0;
while (_mi_r < 4) {
    var _mi_c = 0;
    while (_mi_c < 4) {
        var _mi_want = 0;
        if (_mi_r == _mi_c) { _mi_want = F64_ONE; }
        if (f64_lt(f64_abs(f64_sub(m4_get(prod, _mi_c, _mi_r), _mi_want)), ULP_TOL_H) == 0) {
            _mi_bad = _mi_bad + 1;
        }
        _mi_c = _mi_c + 1;
    }
    _mi_r = _mi_r + 1;
}
assert_eq(_mi_bad, 0, "M * M^-1 == I in all 16 entries (1e-15)");
# The sweep's input is a pure translation, whose 3x3 block is I -- transposing it
# is a no-op, so a row/column-major slip in m4_inverse still passes (verified;
# only foundation.tcyr catches it). Repeat with a non-symmetric rotation block.
var _rq = hquat_from_rotation_z(F64_PI_4);
var _rm = m4_from_srt(hvec3_one(), _rq, hvec3_new(F64_TWO, f64_from(3), f64_from(4)));
var _rm_it, _rm_inv = m4_inverse_checked(_rm);
var _rp = m4_mul(_rm, _rm_inv);
var _rbad = 0;
var _rr = 0;
while (_rr < 4) {
    var _rc = 0;
    while (_rc < 4) {
        var _rwant = 0;
        if (_rr == _rc) { _rwant = F64_ONE; }
        if (f64_lt(f64_abs(f64_sub(m4_get(_rp, _rc, _rr), _rwant)), TOL_1EM14) == 0) {
            _rbad = _rbad + 1;
        }
        _rc = _rc + 1;
    }
    _rr = _rr + 1;
}
assert_eq(_rbad, 0, "rot+trans M * M^-1 == I in all 16 entries (1e-14)");
# where: var TOL_1EM14 = 0x3D06849B86A12B9B;  # 1e-14

# ================================================================
# Transform3D
# ================================================================
test_group("transform3d");

var t = t3d_new(hvec3_new(f64_from(1), f64_from(2), f64_from(3)), hquat_identity(), hvec3_one());
var applied = t3d_apply(t, hvec3_zero());
assert_eq(HVec3_x(applied), f64_from(1), "t3d apply.x");
assert_eq(HVec3_y(applied), f64_from(2), "t3d apply.y");

# Compose: translate (1,0,0) then translate (0,2,0) = (1,2,0)
var ta = t3d_new(hvec3_new(F64_ONE, 0, 0), hquat_identity(), hvec3_one());
var tb = t3d_new(hvec3_new(0, F64_TWO, 0), hquat_identity(), hvec3_one());
var tc = t3d_compose(ta, tb);
var tcp = t3d_apply(tc, hvec3_zero());
assert_eq(HVec3_x(tcp), f64_from(1), "compose.x");
assert_eq(HVec3_y(tcp), f64_from(2), "compose.y");

# ================================================================
# Color
# ================================================================
test_group("color");

# sRGB round-trip: linear_to_srgb(srgb_to_linear(0.5)) ≈ 0.5
var half = F64_HALF;
var lin = srgb_to_linear(half);
var back = linear_to_srgb(lin);
# Measured round-trip residual on 6.5.6: 1.665e-16. The old bound of 1.0 was met
# by anything in (-0.5, 1.5) -- i.e. by every value linear_to_srgb can return.
# [measured: CHANGELOG.md 2.7.0 records the srgb round-trip at 1.67e-16; the assert below bounds it at 1e-15]
assert(f64_lt(f64_abs(f64_sub(back, half)), ULP_TOL_H) == 1, "srgb roundtrip == 0.5 (1e-15)");

# A round-trip is BLIND to a wrong transfer curve — the same wrong breakpoint is
# applied in both directions and the error cancels. Both sRGB piecewise breakpoints
# were mis-transcribed through 2.6.11 (0.03275 shipped for the spec's 0.04045) and
# the round-trip above stayed green. Pin the absolute value instead:
# srgb_to_linear(0.5) = ((0.5 + 0.055) / 1.055)^2.4 = 0.21404114048223255
var _srgb_half_lin = 0x3FCB65B3392F5354;  # 0.21404114048223255
# ⚠ 1e-15, not bits and not the 1e-8 this was. 0x3FCB65B3392F5354 is the correctly
# rounded power of the rounded base fl(fl(0.5 + fl(0.055)) / fl(1.055)); the exact
# sRGB value, with 0.055 and 1.055 as decimals, rounds to 0x3FCB65B3392F5350, 4 ulp
# below. A bound of 1e-15 holds both and still rejects a wrong exponent or breakpoint.
# [measured: scratch Decimal oracle (80 digits), not reproducible in-tree, 2026-10-11]
assert(f64_lt(f64_abs(f64_sub(lin, _srgb_half_lin)), ULP_TOL_H) == 1,
  "srgb_to_linear(0.5) == 0.21404114048223255 to 1e-15 (absolute, not round-trip)");
# Just above the breakpoint the power segment must be in use, just below the linear
# one — this is what actually pins the 0.04045 threshold itself.
assert(f64_lt(srgb_to_linear(f64_div(F64_ONE, f64_from(100))),
    f64_div(F64_ONE, f64_from(100))) == 1, "srgb: linear segment below breakpoint");
# Only the forward leg was pinned absolutely; a compensating pair of wrong
# exponents still round-trips green. Pin the inverse leg too:
# linear_to_srgb(0.2) = 1.055 * 0.2^(1/2.4) - 0.055 = 0.48452920448170694
var _srgb_lin_02 = 0x3FC999999999999A;   # 0.2
var _srgb_enc_02 = 0x3FDF0286C7CD2C49;   # 0.48452920448170694
# Bit-exact: this is the correctly rounded value of the exact formula as well as
# what the rounded one computes.
# [measured: scratch Decimal oracle (80 digits), not reproducible in-tree, 2026-10-11]
assert_eq(linear_to_srgb(_srgb_lin_02), _srgb_enc_02,
  "linear_to_srgb(0.2) == 0.48452920448170694 bit-exact (absolute, not round-trip)");
# The 0.2 pin is in the POWER segment, so it does not pin the encode-side
# breakpoint. Using 0.04045 (the decode threshold) here instead of 0.0031308
# passes every existing colour assertion -- verified against all four suites.
# linear_to_srgb(0.004) = 1.055*0.004^(1/2.4) - 0.055 = 0.05070871397734796,
# vs 12.92*0.004 = 0.05168 if the linear branch is wrongly taken.
# [measured: CHANGELOG.md 2.7.0 lists linear_to_srgb "using the decode-side breakpoint" among its seven survivors]
var _lts_in_hi = 0x3F70624DD2F1A9FC;   # 0.004
var _lts_hi = 0x3FA9F67E184F52AB;      # 0.05070871397734796
assert(f64_lt(f64_abs(f64_sub(linear_to_srgb(_lts_in_hi), _lts_hi)), ULP_TOL_H) == 1,
  "linear_to_srgb(0.004) uses the power segment");
var _lts_in_lo = 0x3F60624DD2F1A9FC;   # 0.002
var _lts_lo = 0x3F9A75CD0BB6ED68;      # 0.025840000000000002 = 12.92 * 0.002
# One rounded product, and the correctly rounded 12.92 * 0.002 as well: bit-exact.
assert_eq(linear_to_srgb(_lts_in_lo), _lts_lo,
  "linear_to_srgb(0.002) uses the linear segment, bit-exact");

# Reinhard: 1.0 → 0.5
var tr = tonemap_reinhard(F64_ONE, F64_ONE, F64_ONE);
var trx = f64_to(f64_mul(HVec3_x(tr), f64_from(10)));
assert_eq(trx, 5, "reinhard(1)=0.5");

# Src-over with opaque src → src
var so = composite_src_over(F64_ONE, 0, 0, F64_ONE, 0, F64_ONE, 0, F64_ONE);
assert_eq(HVec4_x(so), f64_from(1), "src_over.r");
assert_eq(HVec4_y(so), f64_from(0), "src_over.g");

# ================================================================
# Interpolation
# ================================================================
test_group("interpolation");

var l = hisab_lerp(f64_from(0), f64_from(10), F64_HALF);
assert_eq(l, f64_from(5), "lerp 0.5");

var il_t, il = hisab_inverse_lerp_checked(f64_from(0), f64_from(10), f64_from(5));
assert_f64_eq(il, f64_div(f64_from(5), f64_from(10)), "inv_lerp");

# ================================================================
# Geo — primitives and intersections
# ================================================================
test_group("geo primitives");

var ray = geo_ray_new(hvec3_zero(), hvec3_unit_z());
var sphere = geo_sphere_new(hvec3_new(0, 0, f64_from(5)), f64_from(1));
var t_hit = geo_ray_sphere(ray, sphere);
# Hit at t=4 (sphere center at z=5, radius=1, so near hit at z=4)
assert_eq(t_hit, f64_from(4), "ray-sphere t");

var aabb = geo_aabb_new(hvec3_new(f64_neg(F64_ONE), f64_neg(F64_ONE), f64_neg(F64_ONE)),
  hvec3_new(F64_ONE, F64_ONE, F64_ONE));
var t_aabb = geo_ray_aabb(geo_ray_new(hvec3_new(0, 0, f64_neg(f64_from(5))), hvec3_unit_z()), aabb);
assert_eq(t_aabb, f64_from(4), "ray-aabb t");

# AABB-AABB overlap
var aabb2 = geo_aabb_new(hvec3_zero(), hvec3_new(F64_TWO, F64_TWO, F64_TWO));
assert_eq(geo_aabb_aabb(aabb, aabb2), 1, "aabb overlap");

# Sphere-sphere
var s1 = geo_sphere_new(hvec3_zero(), F64_ONE);
var s2 = geo_sphere_new(hvec3_new(F64_ONE, 0, 0), F64_ONE);
assert_eq(geo_sphere_sphere(s1, s2), 1, "sphere overlap");

# Closest point on AABB
var cp = geo_closest_point_on_aabb(aabb, hvec3_new(f64_from(5), 0, 0));
assert_eq(HVec3_x(cp), f64_from(1), "closest aabb.x");

# ================================================================
# Advanced geo
# ================================================================
test_group("geo advanced");

# SDF sphere: point at (3,0,0), sphere at origin r=1 → distance = 2
var sdf_p = hvec3_new(f64_from(3), 0, 0);
var sdf_c = hvec3_zero();
var sdf_d = sdf_sphere(sdf_p, sdf_c, F64_ONE);
assert_eq(sdf_d, f64_from(2), "sdf sphere");

# SDF union: min of two distances
var d1 = f64_from(3);
var d2 = f64_from(5);
assert_eq(sdf_union(d1, d2), f64_from(3), "sdf union");
assert_eq(sdf_intersection(d1, d2), f64_from(5), "sdf intersection");

# Swept AABB: box at (-1,-1,-1)-(1,1,1), vel=(2,0,0), dt=1 → max.x = 3
var saabb = geo_aabb_new(hvec3_new(f64_neg(F64_ONE), f64_neg(F64_ONE), f64_neg(F64_ONE)),
  hvec3_new(F64_ONE, F64_ONE, F64_ONE));
var svel = hvec3_new(F64_TWO, 0, 0);
var swept = swept_aabb(saabb, svel, F64_ONE);
assert_eq(HVec3_x(GeoAabb_max(swept)), f64_from(3), "swept max.x");

# CGA: conformal point embedding.
#   P = x e1 + y e2 + z e3 + a n0 + b ninf,   a = 1,  b = p^2/2
# Through 2.6.15 this only asserted cga_p != 0, which cannot fail unless alloc
# returns null -- every component was unchecked. The two coefficients are FORCED
# by the two defining properties of the embedding (n0^2 = ninf^2 = 0,
# n0.ninf = -1), so they are derivable without reading the source:
#   P.P    = p^2 + 2ab(n0.ninf) = p^2 - 2ab = 0   (P must be a null vector)
#   P.ninf = a(n0.ninf)         = -a     = -1     (P must be normalized)
# Solving: a = 1, b = p^2/2. For p=(1,2,3): p^2=14, a=1, b=7.
# ⭐ 2.21.0 — THE BASIS MOVED AND SO DID THIS DERIVATION. Slots 4 and 5 were ep
# and em, holding (p^2-1)/2 and (p^2+1)/2 under the metric ep^2=+1, em^2=-1;
# they are now n0 and ninf, holding 1 and p^2/2. **That is the repair**: p^2
# lives in ONE coefficient instead of being split across two nearly-equal ones,
# so the norm recovers it by subtraction rather than from a cancellation, and the
# relative nullity error stops depending on |p| — median |P.P|/q goes from 1.0
# at both tails to ~4.5e-17, flat.
# ⚠ NOT "null at every magnitude": that overclaim was caught before the tag. See
# `_cga_scalar_of_geo` — bit-exact nullity is reachable only by dropping the
# Neumaier compensation, which fabricates zeros elsewhere and was reverted.
# Both values here stay dyadic, so bit equality is still the right assertion.
# [measured: 2000 pts/binade residual sweep vs the shipped 2.20.0 tree, 2026-09-11]
var cga_p = cga_point(F64_ONE, F64_TWO, f64_from(3));
assert(cga_p != 0, "cga point alloc");
assert_eq(cga_mv_get(cga_p, 1), F64_ONE, "cga point e1 = 1");
assert_eq(cga_mv_get(cga_p, 2), F64_TWO, "cga point e2 = 2");
assert_eq(cga_mv_get(cga_p, 3), f64_from(3), "cga point e3 = 3");
assert_eq(cga_mv_get(cga_p, 4), F64_ONE, "cga point n0 = 1");
assert_eq(cga_mv_get(cga_p, 5), 0x401C000000000000, "cga point ninf = 14/2 = 7");
assert_eq(cga_mv_get(cga_p, 0), 0, "cga point scalar part = 0");
var cga_p_nz = 0;
var cga_pi = 6;
while (cga_pi < 32) {
    if (cga_mv_get(cga_p, cga_pi) != 0) { cga_p_nz = cga_p_nz + 1; }
    cga_pi = cga_pi + 1;
}
assert_eq(cga_p_nz, 0, "cga point writes only blades 1..5");
# The two derived invariants, recomputed from the returned components.
# P.P = p^2 - 2ab, recomputed from the returned components.
assert_eq(f64_sub(f64_from(14), f64_mul(f64_from(2),
      f64_mul(cga_mv_get(cga_p, 4), cga_mv_get(cga_p, 5)))), 0, "cga point is null: P.P = 0");
assert_eq(f64_neg(cga_mv_get(cga_p, 4)), f64_neg(F64_ONE), "cga point normalized: P.ninf = -1");
# ⭐ And the property the whole basis change exists for, asserted through the
# PUBLIC norm rather than by hand.
# ⚠ EXACTLY zero here because p = (1,2,3) gives q = 14, which is exactly
# representable, so the norm's q and the constructor's q are the same bits. That
# is NOT the general case: 2.21.0's claim is a sub-ulp RESIDUAL (median
# |P.P| / q ~ 4.5e-17, flat), not a hard zero — bit-exact nullity everywhere
# needs the Neumaier compensation dropped, which fabricates zeros elsewhere.
# See `_cga_scalar_of_geo` and the witness block in tests/modules.tcyr.
assert_eq(cga_norm_sq(cga_p), 0, "cga_norm_sq(point) is EXACTLY zero at an exact q");
# Fractional + negative coordinates: p = (0.5, -1.5, 2) -> p^2 = 6.5, a = 2.75, b = 3.75.
var cga_q = cga_point(F64_HALF, 0xBFF8000000000000, F64_TWO);
assert_eq(cga_mv_get(cga_q, 1), F64_HALF, "cga point q e1 = 0.5");
assert_eq(cga_mv_get(cga_q, 2), 0xBFF8000000000000, "cga point q e2 = -1.5");
assert_eq(cga_mv_get(cga_q, 3), F64_TWO, "cga point q e3 = 2");
assert_eq(cga_mv_get(cga_q, 4), F64_ONE, "cga point q n0 = 1");
assert_eq(cga_mv_get(cga_q, 5), 0x400A000000000000, "cga point q ninf = 6.5/2 = 3.25");
# ⭐ 3.3.7 — A CGA PRODUCT ALLOCATES ITS RESULT AND NOTHING ELSE. _cga_geo_blades wrote each
# term pair into a fresh 32-byte block (D051); it now writes the caller's stack buffer. And
# the scalar part reads the 32 blade pairs that reach blade 0 from a list built once (D050),
# where it asked for every pair of non-zero coefficients. Both bounds are exact here (the
# null table and the pair list are built by the products above).
# [measured: scratch pfb/cgaprobe.cyr and cgq.cyr (alloc_used), three trees, 2026-10-31; cycc 6.6.20]
var cga_ar0 = alloc_used();
var cga_pq = cga_geometric_product(cga_p, cga_q);
assert_eq(alloc_used() - cga_ar0, 256,
  "cga product: allocates its 256 B result only (3.3.6: 1,056 B for point x point)");
assert_eq(cga_mv_get(cga_pq, 0), 0xC01B000000000000,
  "cga product: point x point scalar part = -(1/2)|p - q|^2 = -(1/2)(0.25 + 12.25 + 1) = -6.75");
var cga_ar1 = alloc_used();
assert_eq(cga_norm_sq(cga_q), 0, "cga_norm_sq(q) is exactly zero at an exact q = 6.5");
assert_eq(alloc_used() - cga_ar1, 256, "cga_norm_sq: allocates the 256 B reverse only (3.3.6: 1,056 B)");
assert_eq(_cga_scalar_pairs(), 32, "cga: 32 of the 1,024 blade pairs have a scalar term");

# CGA contraction operators (2.5.0) — interior products. Left (a |_ b) lowers
# grade(b) by grade(a); right (a _| b) lowers grade(a) by grade(b). Verified
# against GA identities. Blade indices: scalar=0, e1=1, e2=2, e12=6, e23=10.
var cga_e1 = cga_mv_zero();
cga_mv_set(cga_e1, 1, F64_ONE);
var cga_e12 = cga_mv_zero();
cga_mv_set(cga_e12, 6, F64_ONE);

# e1 |_ e12 = e2 (grade 2-1=1); the e1 component is dropped.
var cga_lc = cga_left_contraction(cga_e1, cga_e12);
assert_eq(cga_mv_get(cga_lc, 2), f64_from(1), "cga left_contract(e1,e12) = e2");
assert_eq(cga_mv_get(cga_lc, 1), f64_from(0), "cga left_contract(e1,e12) has no e1 part");

# e1 |_ e1 = 1 (vector self-contraction -> scalar, e1^2 = +1).
assert_eq(cga_mv_get(cga_left_contraction(cga_e1, cga_e1), 0), f64_from(1), "cga left_contract(e1,e1) = 1");

# Orthogonal: e1 |_ e23 = 0 (e1 not contained in e23).
var cga_e23 = cga_mv_zero();
cga_mv_set(cga_e23, 10, F64_ONE);
var cga_orth = cga_left_contraction(cga_e1, cga_e23);
assert_f64_eq(cga_norm(cga_orth), f64_from(0), "cga left_contract(e1,e23) = 0");

# Vector norm^2 via contraction: (2e1+3e2) |_ self = 4+9 = 13 (scalar).
var cga_v = cga_mv_zero();
cga_mv_set(cga_v, 1, F64_TWO);
cga_mv_set(cga_v, 2, f64_from(3));
assert_eq(cga_mv_get(cga_left_contraction(cga_v, cga_v), 0), f64_from(13), "cga (2e1+3e2)|_self = 13");

# Right contraction: e12 _| e1 = -e2 (grade 2-1=1; opposite handedness -> sign).
var cga_rc = cga_right_contraction(cga_e12, cga_e1);
assert_eq(cga_mv_get(cga_rc, 2), f64_neg(f64_from(1)), "cga right_contract(e12,e1) = -e2");
assert_eq(cga_mv_get(cga_rc, 6), f64_from(0), "cga right_contract(e12,e1) drops grade-2 part");
# A term of sign +1: e1 _| e1 = e1 e1 = +1 (seed-336 mutant m0093 dropped every +1 term; the
# one above is -1).
assert_eq(cga_mv_get(cga_right_contraction(cga_e1, cga_e1), 0), F64_ONE, "cga right_contract(e1,e1) = 1");

# Scalar contraction acts as scaling: 2 |_ (5*e12) = 10*e12.
var cga_s = cga_mv_zero();
cga_mv_set(cga_s, 0, F64_TWO);
var cga_5e12 = cga_mv_zero();
cga_mv_set(cga_5e12, 6, f64_from(5));
assert_eq(cga_mv_get(cga_left_contraction(cga_s, cga_5e12), 6), f64_from(10), "cga 2|_(5e12) = 10e12");

# CGA dual + pseudoscalar (2.5.1). I = grade-5 blade [31]; in this metric (em^2=-1)
# I^2 = -1 so I_inv = -I. dual(x) = x * I_inv flips grade k -> 5-k; involution
# dual(dual(x)) = -x. Blade indices: scalar=0, e1=1, e23pm=30, pseudoscalar=31.
var cga_ii = cga_geometric_product(cga_pseudoscalar(), cga_pseudoscalar_inv());
assert_eq(cga_scalar_part(cga_ii), f64_from(1), "cga I * I_inv = 1");

# dual(scalar 1) = I_inv = -I (grade 0 -> 5).
var cga_one = cga_mv_zero();
cga_mv_set(cga_one, 0, F64_ONE);
assert_eq(cga_mv_get(cga_dual(cga_one), 31), f64_neg(f64_from(1)), "cga dual(1) = -I (grade 0->5)");

# dual(I) = 1 (grade 5 -> 0).
assert_eq(cga_mv_get(cga_dual(cga_pseudoscalar()), 0), f64_from(1), "cga dual(I) = 1 (grade 5->0)");

# dual(e1) = -e23pm (grade 1 -> 4); no e1 part remains.
var cga_de1 = cga_dual(cga_e1);
assert_eq(cga_mv_get(cga_de1, 30), f64_neg(f64_from(1)), "cga dual(e1) = -e23pm (grade 1->4)");
assert_eq(cga_mv_get(cga_de1, 1), f64_from(0), "cga dual(e1) leaves no e1 part");

# Involution: dual(dual(e1)) = -e1 in this metric.
assert_eq(cga_mv_get(cga_dual(cga_de1), 1), f64_neg(f64_from(1)), "cga dual(dual(e1)) = -e1");

# CGA blade projection / rejection (2.5.2). project(X,B) = (X |_ B) |_ B^-1
# (preserves grade(X)); reject(X,B) = X - project. Blade-inverse guards null blades.
# project(e1, e12) = e1 (e1 lies in the e1-e2 plane); no e2 leaks in.
var cga_pr = cga_project(cga_e1, cga_e12);
assert_eq(cga_mv_get(cga_pr, 1), f64_from(1), "cga project(e1,e12) = e1");
assert_eq(cga_mv_get(cga_pr, 2), f64_from(0), "cga project(e1,e12) has no e2 part");

# Projection onto self is identity.
assert_eq(cga_mv_get(cga_project(cga_e12, cga_e12), 6), f64_from(1), "cga project(e12,e12) = e12");

# Orthogonal: e3 has no e1-e2-plane component -> project = 0, reject = e3.
var cga_e3 = cga_mv_zero();
cga_mv_set(cga_e3, 3, F64_ONE);
var cga_pr3 = cga_project(cga_e3, cga_e12);
assert_f64_eq(cga_norm(cga_pr3), f64_from(0), "cga project(e3,e12) = 0");
assert_eq(cga_mv_get(cga_reject(cga_e3, cga_e12), 3), f64_from(1), "cga reject(e3,e12) = e3");

# In-plane vector rejects to zero.
var cga_rj1 = cga_reject(cga_e1, cga_e12);
assert_f64_eq(cga_norm(cga_rj1), f64_from(0), "cga reject(e1,e12) = 0");

# Idempotence: projecting twice == projecting once.
var cga_pp = cga_project(cga_project(cga_e1, cga_e12), cga_e12);
assert_eq(cga_mv_get(cga_pp, 1), f64_from(1), "cga project idempotent");

# project + reject = X. X = e1 + e3 splits into in-plane e1 and orthogonal e3.
var cga_x = cga_mv_zero();
cga_mv_set(cga_x, 1, F64_ONE);
cga_mv_set(cga_x, 3, F64_ONE);
var cga_sum = cga_mv_add(cga_project(cga_x, cga_e12), cga_reject(cga_x, cga_e12));
assert_eq(cga_mv_get(cga_sum, 1), f64_from(1), "cga project+reject = X (e1 part)");
assert_eq(cga_mv_get(cga_sum, 3), f64_from(1), "cga project+reject = X (e3 part)");

# Null-blade guard: the zero blade has no inverse, so there is no projection onto
# it. Through 3.4.0 this asserted the answer was the zero multivector, which is the
# projection of a vector ORTHOGONAL to a blade; since 3.4.1 every coefficient is NaN
# (AU2-G1-F1), and no trap.
var cga_pnull = cga_project(cga_e1, cga_mv_zero());
var cga_pnull_nan = 0;
for (var cga_pni = 0; cga_pni < 32; cga_pni = cga_pni + 1) {
    var cga_pnv = cga_mv_get(cga_pnull, cga_pni);
    if (f64_eq(cga_pnv, cga_pnv) == 0) { cga_pnull_nan = cga_pnull_nan + 1; }
}
assert_eq(cga_pnull_nan, 32, "cga project onto the zero blade: NaN in all 32 slots (3.4.0: 0)");

# ================================================================
# Calc — integration, easing
# ================================================================
test_group("calc");

# Integrate x^2 from 0 to 1 = 1/3. TOLERANCE, not rounding: the assertion here
# through 2.7.x compared f64_to(f64_round(3*I)) against 1, which accepts any I in
# [1/6, 1/2) -- a +-1/6 band around 1/3. Simpson is exact for degree <= 3.
fn _test_x2(x) { return f64_mul(x, x); }
var int_out = alloc(8);
var rc_t, rc_v = calc_integral_simpson(&_test_x2, 0, F64_ONE, 100, int_out);
assert_eq(is_ok(rc_t), 1, "simpson ok");
var int_err = f64_abs(f64_sub(load64(int_out), 0x3FD5555555555555));   # fl(1/3)
assert(f64_lt(int_err, 0x3C9CD2B297D889BC) == 1, "int x^2 = 1/3 within 1e-16 (< 2 ulp)");

# And exact on a dyadic grid: n = 64 over [0,2] gives h = 2^-5, so every node,
# node value, weighted term and partial sum is an exact dyadic and the only
# rounding is the closing divide by 3. int(x^3, 0, 2) = 4 must come back bit-exact.
fn _test_x3(x) { return f64_mul(x, f64_mul(x, x)); }
var x3_t, x3_v = calc_integral_simpson(&_test_x3, 0, F64_TWO, 64, int_out);
assert_eq(load64(int_out), 0x4010000000000000, "simpson cubic: int(x^3,0,2) is 4.0 bit-exact");

# Derivative of x^2 at x=3 should be 6
var dv = calc_derivative(&_test_x2, f64_from(3), f64_from(1));
# Use a large h=1 for simplicity — central diff gives (16-4)/2 = 6
assert_eq(dv, f64_from(6), "deriv x^2 at 3");

# Easing
assert_eq(ease_in(0), f64_from(0), "ease_in(0)");
assert_eq(ease_in(F64_ONE), f64_from(1), "ease_in(1)");

# Gauss-Legendre on x^2 from 0 to 1. ⭐ 3.3.5 — round(3 I) = 1 accepted I in [1/6, 1/2).
# 5-point Gauss is exact for degree <= 9, so the error is rounding only. The first-order
# bound over the node 1/2 + n/2, its square, the weighted product and the four additions,
# with the correctly rounded nodes and weights, is 4.0 ulp of 1/3, so the result is within 4
# ulp of fl(1/3). Measured 0x3FD5555555555554, 1 ulp below.
# [measured: scratch bound script, probe and Decimal oracle, not reproducible in-tree, 2026-10-11; cycc 6.6.14]
# Distance in ulps between two finite f64s of one sign: their bit patterns are
# monotonic in value. An opposite sign (+0 against -0 included) returns the largest
# gap; without that test a = -b makes a - b exactly -2^63, which stays negative.
fn _hs_ulp_gap(a, b) {
    if ((a ^ b) < 0) { return 0x7FFFFFFFFFFFFFFF; }
    var d = a - b;
    if (d < 0) { d = 0 - d; }
    return d;
}
var gl = calc_integral_gauss5(&_test_x2, 0, F64_ONE);
assert(_hs_ulp_gap(gl, 0x3FD5555555555555) <= 4, "gauss5 x^2 on [0,1] = 1/3 within 4 ulp");

# ================================================================
# Num — root finding, number theory, RNG
# ================================================================
test_group("num");

# GCD
assert_eq(num_gcd(12, 8), 4, "gcd(12,8)");
assert_eq(num_gcd(7, 13), 1, "gcd(7,13)");

# Modpow: 2^10 mod 1000 = 1024 mod 1000 = 24
var _rq71t, _rq71v = num_modpow(2, 10, 1000);
assert_eq(is_ok(_rq71t), 1, "modpow");
assert_eq(_rq71v, 24, "modpow");

# Primality
assert_eq(num_is_prime(2), 1, "2 prime");
assert_eq(num_is_prime(17), 1, "17 prime");
assert_eq(num_is_prime(15), 0, "15 not prime");
assert_eq(num_is_prime(1), 0, "1 not prime");

# Sieve
var primes = num_sieve(20);
assert_eq(vec_len(primes), 8, "primes<=20 count");
assert_eq(vec_get(primes, 0), 2, "first prime");
assert_eq(vec_get(primes, 7), 19, "8th prime");

# PCG32 RNG — deterministic
var rng = pcg32_new(42);
var r1 = pcg32_next(rng);
var r2 = pcg32_next(rng);
assert(r1 != r2, "rng produces different values");

# Kahan sum
var kdata = alloc(24);
store64(kdata, f64_from(1));
store64(kdata + 8, f64_from(2));
store64(kdata + 16, f64_from(3));
var ks = num_kahan_sum(kdata, 3);
assert_eq(ks, f64_from(6), "kahan sum");

# Newton-Raphson: find sqrt(2) by solving x^2 - 2 = 0
fn _nr_f(x) { return f64_sub(f64_mul(x, x), F64_TWO); }
fn _nr_df(x) { return f64_mul(F64_TWO, x); }
var nr_out = alloc(8);
var nr_rc_t, nr_rc_v = num_newton(&_nr_f, &_nr_df, F64_ONE, EPSILON_F64, 100, nr_out);
assert_eq(is_ok(nr_rc_t), 1, "newton ok");
var nr_val = load64(nr_out);
# sqrt(2), within the contract rather than round(1000 x) = 1414 (5e-4): num_newton returns
# an x with |x^2 - 2| < tol, and x + sqrt 2 > 2, so |x - sqrt 2| < tol / 2. Against
# fl(sqrt 2), which is 1e-16 from sqrt 2. Measured: x is fl(sqrt 2).
# [measured: scratch probe, not reproducible in-tree, 2026-10-11; cycc 6.6.14]
assert(f64_lt(f64_abs(f64_sub(nr_val, 0x3FF6A09E667F3BCD)), f64_mul(EPSILON_F64, F64_HALF)) == 1,
  "newton sqrt2: |x - sqrt 2| < tol/2");

# ================================================================
# ODE solvers
# ================================================================
test_group("ode");

# DOPRI45: exponential growth dy/dt = y, y(0) = 1
# Use small dt=0.1 for single step accuracy
fn _ode_exp(t, y) { return y; }
var dp_y = alloc(8);
var dp_err = alloc(8);
var _dp_dt = f64_div(F64_ONE, f64_from(10));  # 0.1
var _r8t, _r8v = ode_dopri45(&_ode_exp, 0, F64_ONE, _dp_dt, dp_y, dp_err);
var dp_val = load64(dp_y);
# VALUE assertion, not a bounds check. Through 2.6.11 the only assertions here
# were `1 < y < 2`, which a *non-consistent* integrator passes: 23 of the 30
# Dormand-Prince tableau constants were mis-transcribed (sum(b) = 0.636, not 1)
# and this test stayed green for six releases. One step of dt=0.1 on y'=y from
# y(0)=1 has the exact value e^0.1; a 5th-order method must hit it to ~1e-9.
# [measured: CHANGELOG.md 2.6.12, the DOPRI45 entry (23 of 30 constants wrong) and its table (sum b = 0.6356)]
assert(f64_gt(dp_val, F64_ONE) == 1, "dopri45 exp grows");
assert(f64_lt(dp_val, F64_TWO) == 1, "dopri45 exp bounded");
var _dp_exact = 0x3FF1AEC7B35A00D4;                       # e^0.1 = 1.1051709180756477
var _dp_err = f64_abs(f64_sub(dp_val, _dp_exact));
assert(f64_lt(_dp_err, f64_div(F64_ONE, f64_from(1000000000))) == 1,
  "dopri45: one step of y'=y equals e^0.1 to 1e-9");
# The embedded 4th/5th-order error estimate must be small, not garbage.
assert(f64_lt(f64_abs(load64(dp_err)), f64_div(F64_ONE, f64_from(1000000))) == 1,
  "dopri45: embedded error estimate < 1e-6");

# ----------------------------------------------------------------
# DOPRI45 abscissa row c2..c7 -- NON-AUTONOMOUS coverage (2.8.3)
#
# Every integrand that reached ode_dopri45 through 2.8.2 was AUTONOMOUS:
# _ode_exp(t, y) returns y, _ode_zero returns 0, and every symplectic fixture
# takes q or p alone. An f(t, y) that ignores t makes the stage TIMES dead
# inputs -- ode_dopri45 (src/ode.cyr) computes t2..t5 from _DP_C2.._DP_C5 and
# stages 6/7 use t+dt, and the whole row could be replaced by `t` with the
# assertions above still green. That is the same shape of hole that let 23
# mis-transcribed tableau constants ship for six releases (2.6.12).
#
# The three blocks below are the first fixtures in the suite that read t.
# References are EXACT: the tableau is rational, so for a rational f the whole
# step is exact in Q. Both pinned values were computed with python3
# fractions.Fraction from the LITERATURE tableau (Dormand & Prince 1980 /
# Hairer-Norsett-Wanner Table 5.2), not from src/ode.cyr.

# (a) PURE QUADRATURE, f(t, y) = 5t^4. dy/dt depends on t only, so one step is
# the 5th-order quadrature rule sum b_i * f(t + c_i*h) and the order conditions
# sum b_i c_i^(k-1) == 1/k (k = 1..5, all verified exact in Q) make
# int_0^1 5t^4 dt = 1 EXACT -- not "accurate to 1e-9", exact but for rounding.
# Measured deviation on 6.5.6: 8.88e-16 (4 ulp). Zeroing c3/c4/c5 moves it to
# 0.0182 / 1.3333 / 1.0063. c2 is invisible here because b2 == 0 -- that is
# what block (b) is for.
# [measured: scratch runs at 2.8.3, not reproducible in-tree; the assert below bounds the deviation at 1e-13]
fn _ode_5t4(t, y) {
    var _q5 = f64_mul(t, t);
    return f64_mul(f64_from(5), f64_mul(_q5, _q5));
}
var _dpq_y = alloc(8);
var _dpq_e = alloc(8);
var _r9t, _r9v = ode_dopri45(&_ode_5t4, 0, 0, F64_ONE, _dpq_y, _dpq_e);
var _dpq_tol = 0x3D3C25C268497682;                        # 1e-13
assert(f64_lt(f64_abs(f64_sub(load64(_dpq_y), F64_ONE)), _dpq_tol) == 1,
  "dopri45: int_0^1 5t^4 dt == 1 exactly (quadrature order conditions on c3..c6)");
# The embedded 4(5) pair applied to the same quadrature has an exact value too:
# h * sum (b5_i - b4_i) f(c_i h) = 71/54000. Zeroing c3/c4/c5 moves it by
# 1.7e-4 / 7.6e-2 / 1.6e-1; measured deviation is 5.1e-17.
# [measured: scratch runs at 2.8.3, not reproducible in-tree; the assert below bounds the deviation at 1e-14]
var _dpq_eref = 0x3F558ABBA850B4D5;                       # 71/54000 = 0.00131481481481481
var _dpq_etol = 0x3D06849B86A12B9B;                       # 1e-14
assert(f64_lt(f64_abs(f64_sub(load64(_dpq_e), _dpq_eref)), _dpq_etol) == 1,
  "dopri45: quadrature error estimate == 71/54000 exactly (c row + e row)");

# (b) NON-AUTONOMOUS AND y-DEPENDENT, f(t, y) = t + y from (t, y) = (0, 1),
# h = 1/10. Every stage value is rational, so the exact one-step result of the
# published tableau is 333102551/300000000 and the exact |error estimate| is
# 621/40000000000. This is the only block that can see c2: c2 enters solely
# through t2 (b2 == 0 kills its weight), so it needs an f that reads t AND a
# later stage that reads k2. Setting c2 := 0 moves y_new by 2.6e-8 and the
# error estimate by 6.7e-7; measured deviation is 0.0 ulp on both.
# [measured: tests/hisab.tcyr "(certifies c2)" bit-exact assert pins y; the c2 shifts and estimate are 2.8.3 scratch]
fn _ode_t_plus_y(t, y) { return f64_add(t, y); }
var _dpn_y = alloc(8);
var _dpn_e = alloc(8);
var _r10t, _r10v = ode_dopri45(&_ode_t_plus_y, 0, F64_ONE, _dp_dt, _dpn_y, _dpn_e);
var _dpn_yref = 0x3FF1C3F5CD3DD290;                       # 333102551/300000000
var _dpn_eref = 0x3E50AB7AC0DC15CF;                       # 621/4e10 = 1.5525 x 10^-8
# Bit-exact: 0x3FF1C3F5CD3DD290 is 333102551/300000000 correctly rounded (python3
# Fraction), and the step lands on it.
assert_eq(load64(_dpn_y), _dpn_yref,
  "dopri45: y' = t + y one step equals the exact rational step, bit-exact (certifies c2)");
assert(f64_lt(f64_abs(f64_sub(load64(_dpn_e), _dpn_eref)), _dpq_etol) == 1,
  "dopri45: y' = t + y error estimate == 621/4e10 exactly (certifies c7 = 1)");

# (c) ORDER OF CONVERGENCE -- an invariant no wrong abscissa row can satisfy,
# and the one that catches a SMALL perturbation rather than a zeroed row. Fixed
# steps over [0, 1] on the same y' = t + y, whose closed form is y = 2e^t - t - 1,
# so y(1) = 2e - 2. Halving h must divide the global error by ~2^5 = 32; the
# measured ratio for the shipped tableau is 28.6 (8 -> 16 steps, pre-asymptotic).
# Any single mis-set abscissa demotes the method: c2 += 0.01 gives 6.47, c2 := 0
# gives 15.2, and c3/c4/c5 wrong (either way) collapse it to ~2.0. Note that a
# plain error BOUND would not do -- c2 += 0.01 happens to make the 8-step error
# SMALLER (1.4e-8 vs 3.7e-8) while destroying the order.
# [measured: scratch mutants at 2.8.3, not reproducible in-tree; "divides the global error by > 20" bounds the 28.6]
var _dpo_yb = alloc(8);
var _dpo_eb = alloc(8);
fn _ode_fixed_run(nsteps) {
    var _fr_h = f64_div(F64_ONE, f64_from(nsteps));
    var _fr_t = 0;
    var _fr_y = F64_ONE;
    var _fr_i = 0;
    while (_fr_i < nsteps) {
        var _r11t, _r11v = ode_dopri45(&_ode_t_plus_y, _fr_t, _fr_y, _fr_h, _dpo_yb, _dpo_eb);
        _fr_y = load64(_dpo_yb);
        _fr_t = f64_add(_fr_t, _fr_h);
        _fr_i = _fr_i + 1;
    }
    return _fr_y;
}
var _dpo_exact = 0x400B7E151628AED3;                      # 2e - 2 = 3.4365636569180905
var _dpo_e8 = f64_abs(f64_sub(_ode_fixed_run(8), _dpo_exact));
var _dpo_e16 = f64_abs(f64_sub(_ode_fixed_run(16), _dpo_exact));
assert(f64_gt(_dpo_e8, 0) == 1, "dopri45: 8-step global error is nonzero (order test is live)");
assert(f64_gt(f64_div(_dpo_e8, _dpo_e16), f64_from(20)) == 1,
  "dopri45: halving h divides the global error by > 20 (5th order needs the c row)");

# BDF-4 and Yoshida-4 had NO numeric assertions at all through 2.6.11, which is
# why their mis-transcribed coefficient tables shipped. Both are pinned here by
# the consistency invariant the wrong constants violated, not by a bounds check.

# BDF-4 on the constant solution y' = 0, y == 1. The alpha row must sum to 1, so
# a constant history must reproduce itself exactly. Pre-fix, sum(alpha) = 1.01
# and this drifted by 1% per step.
# [measured: CHANGELOG.md 2.6.12, "BDF-4 drifted 1% per step on a constant solution" (its table: sum alpha 1.01)]
fn _ode_zero(t, y) { return 0; }
var _bdf_hist = vec_new();
vec_push(_bdf_hist, F64_ONE);
vec_push(_bdf_hist, F64_ONE);
vec_push(_bdf_hist, F64_ONE);
vec_push(_bdf_hist, F64_ONE);
# 3.4.0: ode_bdf is retired; _bdf_at reads ode_bdf_checked, and returns a signalling NaN
# no Ok value has when it refuses, so no value assertion below can pass on a refusal.
var _BDF_OUT = alloc(8);
fn _bdf_at(f, t, hist, order, dt, tol) {
    store64(_BDF_OUT, 0x7FF4000000000001);
    var bt, bv = ode_bdf_checked(f, t, hist, order, dt, tol, _BDF_OUT);
    return load64(_BDF_OUT);
}
fn _bdf_err(f, t, hist, order, dt, tol) {
    var bt, bv = ode_bdf_checked(f, t, hist, order, dt, tol, _BDF_OUT);
    if (is_ok(bt) == 1) { return 0; }
    return bv;
}
var _bdf4 = _bdf_at(&_ode_zero, 0, _bdf_hist, 4, f64_div(F64_ONE, f64_from(10)),
  f64_div(F64_ONE, f64_from(1000000000000)));
assert_eq(_bdf4, F64_ONE, "bdf4: constant solution is reproduced exactly, bit-exact (sum(alpha) == 1)");

# ----------------------------------------------------------------
# ode_bdf: the full order-condition set
#
# The assertion above was, through 2.8.2, the ONLY call reaching ode_bdf. It
# pins sum(alpha) == 1 -- the invariant the 2.6.12 mis-transcription violated --
# and nothing else. With f == 0 the beta*dt*f term vanishes, so beta was
# completely unconstrained; and the call is order 4, so the order-2, order-3 and
# order-5 branches were never entered at all.
#
# What pins the whole table is the property that DEFINES a BDF-k formula: it
# reproduces every polynomial of degree <= k exactly (it is derived by
# interpolating y_{n+1}..y_{n+1-k} and matching the derivative at t_{n+1}).
# Running order k over the monomials t^0 .. t^k is the complete order-condition
# set -- k+1 independent linear conditions on the k alphas plus beta, which
# determine them uniquely. No coefficient can be wrong and still pass.
#
# Verified in exact rational arithmetic (python3 fractions) against the values
# the constants' own comments state, on this exact grid: all 18 conditions hold
# exactly, and each one FAILS at degree k+1 (BDF-2 on t^3 gives 85/24, not
# 27/8), which is what shows the fixture sits at the method's order rather than
# comfortably inside it.
#
# The integrand depends only on t, so df/dy == 0, gp == 1 and Newton lands on
# the root in a single step: the assertions are on the FORMULA, not on the
# nonlinear solver.
var _bdf_deg = 0;

fn _bdf_pow(t, m) {
    var r = F64_ONE;
    for (var i = 0; i < m; i = i + 1) { r = f64_mul(r, t); }
    return r;
}

# y(t) = t^m  =>  y'(t) = m t^(m-1), independent of y.
fn _bdf_dpdt(t, y) {
    if (_bdf_deg == 0) { return 0; }
    return f64_mul(f64_from(_bdf_deg), _bdf_pow(t, _bdf_deg - 1));
}

# How many monomial degrees 0..k does BDF-k fail to reproduce at t_{n+1}?
# Grid t0 = 1/2, dt = 1/2 -- every abscissa and every y value is an exact dyadic
# rational, so the only error in play is the rounding of the alpha row itself.
# The history vec is allocated ONCE and truncated: alloc() never frees.
fn _bdf_order_fails(k) {
    var fails = 0;
    var dt = F64_HALF;
    var t0 = F64_HALF;
    var hist = vec_new();
    var tn1 = f64_add(t0, f64_mul(f64_from(k), dt));
    for (var m = 0; m < k + 1; m = m + 1) {
        _bdf_deg = m;
        vec_truncate(hist, 0);
        # History is most-recent-LAST, so push in increasing t.
        for (var j = 0; j < k; j = j + 1) {
            vec_push(hist, _bdf_pow(f64_add(t0, f64_mul(f64_from(j), dt)), m));
        }
        var got = _bdf_at(&_bdf_dpdt, tn1, hist, k, dt, EPSILON_F64);
        var want = _bdf_pow(tn1, m);
        # Relative: BDF-5 differences terms of magnitude ~214 to land on 243.
        var tolk = f64_mul(f64_div(F64_ONE, f64_from(1000000000000)),
          f64_add(F64_ONE, f64_abs(want)));
        if (f64_lt(f64_abs(f64_sub(got, want)), tolk) == 0) { fails = fails + 1; }
    }
    return fails;
}

assert_eq(_bdf_order_fails(2), 0, "bdf2 is exact on t^0..t^2 (pins both alphas AND beta)");
assert_eq(_bdf_order_fails(3), 0, "bdf3 is exact on t^0..t^3 (order-3 branch, previously dead)");
assert_eq(_bdf_order_fails(4), 0, "bdf4 is exact on t^0..t^4");
assert_eq(_bdf_order_fails(5), 0, "bdf5 is exact on t^0..t^5 (order-5 branch, previously dead)");

# Sharpness. One degree PAST its order the method must be wrong -- otherwise the
# fixture above would also be satisfied by a higher-order formula and would not
# pin these coefficients at all. BDF-2 on t^3 over t = {1/2, 1} -> 3/2 returns
# (4/3)(1) - (1/3)(1/8) + (2/3)(1/2)(3)(9/4) = 85/24, against a true 27/8.
_bdf_deg = 3;
var _bdf_h3 = vec_new();
vec_push(_bdf_h3, _bdf_pow(F64_HALF, 3));
vec_push(_bdf_h3, _bdf_pow(F64_ONE, 3));
var _bdf_p3 = _bdf_at(&_bdf_dpdt, f64_div(f64_from(3), F64_TWO), _bdf_h3, 2,
  F64_HALF, EPSILON_F64);
# 85/24 correctly rounded is f64_div(85, 24) (python3 Fraction): bit-exact.
assert_eq(_bdf_p3, f64_div(f64_from(85), f64_from(24)),
  "bdf2 on t^3 returns 85/24 bit-exact -- one degree past its order, exactly as it must");

# Input validation: HSB_ERR_INVALID_INPUT (3.3.7's ode_bdf documented "0 on invalid input").
assert_eq(_bdf_err(&_bdf_dpdt, F64_ONE, _bdf_h3, 1, F64_HALF, EPSILON_F64), HSB_ERR_INVALID_INPUT,
  "ode_bdf_checked rejects order 1");
assert_eq(_bdf_err(&_bdf_dpdt, F64_ONE, _bdf_h3, 6, F64_HALF, EPSILON_F64), HSB_ERR_INVALID_INPUT,
  "ode_bdf_checked rejects order 6");
assert_eq(_bdf_err(&_bdf_dpdt, F64_ONE, _bdf_h3, 3, F64_HALF, EPSILON_F64), HSB_ERR_INVALID_INPUT,
  "ode_bdf_checked rejects a history shorter than the order");

# Yoshida-4 on a free particle (accel == 0): the drift coefficients must sum to 1,
# so q advances by exactly v*dt. Pre-fix they summed to 0.859 and it moved 85.9%
# of the correct distance.
# [measured: CHANGELOG.md 2.6.12, "Yoshida-4 advanced a free particle only 85.9% of the correct distance"]
fn _ode_free(q) { return 0; }
var _y4 = ode_yoshida4(&_ode_free, 0, F64_ONE, F64_ONE);   # q=0, v=1, dt=1 -> q=1
assert(_y4 != 0, "yoshida4 returns result");
assert(f64_lt(f64_abs(f64_sub(load64(_y4), F64_ONE)), f64_div(F64_ONE, f64_from(100000000))) == 1,
  "yoshida4: free particle advances exactly v*dt (sum(c) == 1)");
# ⛔ 3.3.7 — and bit-exact: c0 + c1 + c1 + c0 in doubles, with every coefficient correctly
# rounded, is 1 - 2^-53. 3.3.6's _Y4_C0 (1 ulp high) and _Y4_C1 (2 ulp toward zero) gave
# 1 + 2^-52.
# [measured: the four drifts replayed in Python doubles with each set of constants, 2026-10-31]
assert_eq(load64(_y4), 0x3FEFFFFFFFFFFFFF,
  "yoshida4: free particle q = 1 - 2^-53, the correctly rounded c's (3.3.6: 1 + 2^-52)");

# ----------------------------------------------------------------
# Symplectic integrators on the SHO  q'' = -q,  start (q, v) = (1, 0).
#
# Through 2.6.15 ode_verlet and ode_symplectic_euler were asserted ONLY with
# != 0 on the returned 16-byte block. alloc() never returns 0 on success, so
# neither assertion could fail for any input: two integrators, zero numeric
# coverage. Replaced below with the closed form of each map plus the property
# that makes a symplectic method worth having -- bounded energy error forever.
#
# Both maps are LINEAR on the SHO, so both have an exact closed form. Derived
# from the textbook definitions, independently of src/ode.cyr:
#   velocity Verlet  : q1 = q + v*h + (h^2/2)a(q),   v1 = v + (h/2)(a(q) + a(q1))
#                      M_V = [[1-h^2/2, h], [-h(1-h^2/4), 1-h^2/2]],  det = 1
#   symplectic Euler : p1 = p + h*F(q),              q1 = q + h*p1
#                      M_S = [[1-h^2,   h], [-h,           1     ]],  det = 1
# Both have trace 2 - h^2, so with theta = 2*asin(h/2)  (i.e. cos theta = 1-h^2/2)
# and M^n = cos(n th) I + (sin(n th)/sin th) (M - cos(th) I):
#   Verlet           q_n = cos(n th)                        v_n = -cos(th/2) sin(n th)
#   symplectic Euler q_n = cos(n th) - tan(th/2) sin(n th)  p_n = -sin(n th)/cos(th/2)
# Each conserves a quadratic shadow Hamiltonian EXACTLY (the S with M^T S M = S):
#   Verlet           E_V = (1 - h^2/4) q^2/2 + v^2/2
#   symplectic Euler H~  = (q^2 + p^2 - h*q*p)/2
# Since E = (q^2+v^2)/2 = E_V + (h^2/8) q^2 and |q_n| <= 1, the TRUE energy obeys
#   Verlet           |E_n - 1/2| <= h^2/8            for all n, forever
#   symplectic Euler |E_n - 1/2| <= h/(2(2-h))       for all n, forever
# That is the property under test. A non-symplectic method of the same order
# fails it outright: explicit Euler on this problem multiplies E by (1+h^2)^n,
# which is (1 + 2^-10)^4000 = 49.62x over the 4000 steps below.
# [measured: closed form, exp(4000 ln(1 + 2^-10)) = 49.62]
fn _ode_sho_accel(q) { return f64_neg(q); }
fn _ode_dp_dq(q) { return f64_neg(q); }
fn _ode_dq_dp(p) { return p; }

# (1) One step at dt = 1/2. Every intermediate is a dyadic rational, so the
# results are bit-exact and asserted as such:
#   Verlet           q1 = 1 - h^2/2 = 7/8,   v1 = -h + h^3/4 = -15/32
#   symplectic Euler q1 = 1 - h^2   = 3/4,   p1 = -h         = -1/2
var _SY_7_8    = 0x3FEC000000000000;   #   0.875     = 7/8
var _SY_N15_32 = 0xBFDE000000000000;   #  -0.46875   = -15/32
var _SY_3_4    = 0x3FE8000000000000;   #   0.75      = 3/4
var _SY_NHALF  = 0xBFE0000000000000;   #  -0.5
var vr = ode_verlet(&_ode_sho_accel, F64_ONE, 0, F64_HALF);
assert_eq(load64(vr), _SY_7_8, "verlet SHO dt=1/2: q1 == 7/8 exactly");
assert_eq(load64(vr + 8), _SY_N15_32, "verlet SHO dt=1/2: v1 == -15/32 exactly");
var se = ode_symplectic_euler(&_ode_dq_dp, &_ode_dp_dq, F64_ONE, 0, F64_HALF);
assert_eq(load64(se), _SY_3_4, "sympeuler SHO dt=1/2: q1 == 3/4 exactly");
assert_eq(load64(se + 8), _SY_NHALF, "sympeuler SHO dt=1/2: p1 == -1/2 exactly");

# (2) 4000 steps at h = 1/32 -> t = 125.0, 19.89 periods. Reference values below
# are M^4000 applied to (1, 0) in exact rational arithmetic, rounded to f64;
# the observed error of the run is ~2e-15, so 1e-13 leaves ~50x headroom while
# still pinning the DISCRETE map (comparing against cos(t) instead would only
# support ~5e-3, since the h^2/24 frequency error is 5.1e-3 rad over t = 125).
# [measured: scratch run at 2.7.0, not reproducible in-tree; the 1e-13 asserts below bound the ~2e-15]
var _SY_TOL13 = 0x3D3C25C268497682;    # 1e-13
var _SY_TOL12 = 0x3D719799812DEA11;    # 1e-12
var _SY_0P9999 = 0x3FEFFF2E48E8A71E;   # 0.9999
var _SY_0P99   = 0x3FEFAE147AE147AE;   # 0.99
var _sy_h = f64_div(F64_ONE, f64_from(32));                     # 1/32, exact
var _sy_h28 = f64_div(f64_mul(_sy_h, _sy_h), f64_from(8));      # h^2/8 = 2^-13
var _sy_i = 0;
var _sy_st = 0;
var _sy_en = 0;
var _sy_dev = 0;

var _vlt_q = F64_ONE;
var _vlt_v = 0;
var _vlt_dmax = 0;
_sy_i = 0;
while (_sy_i < 4000) {
    _sy_st = ode_verlet(&_ode_sho_accel, _vlt_q, _vlt_v, _sy_h);
    _vlt_q = load64(_sy_st);
    _vlt_v = load64(_sy_st + 8);
    _sy_en = f64_mul(F64_HALF, f64_add(f64_mul(_vlt_q, _vlt_q), f64_mul(_vlt_v, _vlt_v)));
    _sy_dev = f64_abs(f64_sub(_sy_en, F64_HALF));
    if (f64_gt(_sy_dev, _vlt_dmax) == 1) { _vlt_dmax = _sy_dev; }
    _sy_i = _sy_i + 1;
}
# q_4000 = cos(4000*th) = 0.790837995393526746698654537268764  -> 0x3FE94E8B7BD4C7DA
# v_4000 = -cos(th/2) sin(4000*th) = 0.611950828092119903368758 -> 0x3FE39519E72D4E03
var _VLT_QREF = 0x3FE94E8B7BD4C7DA;
var _VLT_VREF = 0x3FE39519E72D4E03;
assert(f64_lt(f64_abs(f64_sub(_vlt_q, _VLT_QREF)), _SY_TOL13) == 1,
  "verlet: q after 4000 steps == cos(n*theta) to 1e-13");
assert(f64_lt(f64_abs(f64_sub(_vlt_v, _VLT_VREF)), _SY_TOL13) == 1,
  "verlet: v after 4000 steps == -cos(theta/2)sin(n*theta) to 1e-13");
# Shadow Hamiltonian E_V = (1-h^2/4)q^2/2 + v^2/2 -- conserved exactly, so it
# still equals its t=0 value (1-h^2/4)/2 = 0.4998779296875 after 4000 steps.
var _VLT_EVREF = 0x3FDFFE0000000000;   # 0.4998779296875 = (1 - (1/32)^2/4)/2
var _vlt_ev = f64_mul(F64_HALF, f64_add(
    f64_mul(f64_sub(F64_ONE, f64_div(f64_mul(_sy_h, _sy_h), f64_from(4))), f64_mul(_vlt_q, _vlt_q)),
    f64_mul(_vlt_v, _vlt_v)));
assert(f64_lt(f64_abs(f64_sub(_vlt_ev, _VLT_EVREF)), _SY_TOL12) == 1,
  "verlet: shadow Hamiltonian (1-h^2/4)q^2/2+v^2/2 held to 1e-12 over 4000 steps");
# Bounded energy error, both sides. Upper bound h^2/8 = 1.220703125e-4 is the
# symplecticity statement; measured max deviation is 1.2207030914740e-4. The
# LOWER bound is what rejects a frozen / no-op integrator, which would sit at
# E == 1/2 exactly and sail through the upper bound alone.
# [measured: scratch run at 2.7.0, not reproducible in-tree; the asserts below bound it between 0.9999 h^2/8 and h^2/8]
assert(f64_lt(_vlt_dmax, _sy_h28) == 1,
  "verlet: |E - 1/2| <= h^2/8 for all 4000 steps (energy bounded, not drifting)");
assert(f64_gt(_vlt_dmax, f64_mul(_sy_h28, _SY_0P9999)) == 1,
  "verlet: the h^2/8 energy bound is actually attained (orbit is traversed)");

var _seu_q = F64_ONE;
var _seu_p = 0;
var _seu_dmax = 0;
_sy_i = 0;
while (_sy_i < 4000) {
    _sy_st = ode_symplectic_euler(&_ode_dq_dp, &_ode_dp_dq, _seu_q, _seu_p, _sy_h);
    _seu_q = load64(_sy_st);
    _seu_p = load64(_sy_st + 8);
    _sy_en = f64_mul(F64_HALF, f64_add(f64_mul(_seu_q, _seu_q), f64_mul(_seu_p, _seu_p)));
    _sy_dev = f64_abs(f64_sub(_sy_en, F64_HALF));
    if (f64_gt(_sy_dev, _seu_dmax) == 1) { _seu_dmax = _sy_dev; }
    _sy_i = _sy_i + 1;
}
# q_4000 = cos(n th) - tan(th/2) sin(n th) = 0.800402062059679536397214 -> 0x3FE99CE4C906502B
# p_4000 = -sin(n th)/cos(th/2)            = 0.612100266633778540707798 -> 0x3FE396534C621425
var _SEU_QREF = 0x3FE99CE4C906502B;
var _SEU_PREF = 0x3FE396534C621425;
assert(f64_lt(f64_abs(f64_sub(_seu_q, _SEU_QREF)), _SY_TOL13) == 1,
  "sympeuler: q after 4000 steps == cos(n th) - tan(th/2)sin(n th) to 1e-13");
assert(f64_lt(f64_abs(f64_sub(_seu_p, _SEU_PREF)), _SY_TOL13) == 1,
  "sympeuler: p after 4000 steps == -sin(n th)/cos(th/2) to 1e-13");
# H~ = (q^2 + p^2 - h*q*p)/2 is conserved exactly; it started at 1/2.
var _seu_h = f64_mul(F64_HALF, f64_sub(
    f64_add(f64_mul(_seu_q, _seu_q), f64_mul(_seu_p, _seu_p)),
    f64_mul(_sy_h, f64_mul(_seu_q, _seu_p))));
assert(f64_lt(f64_abs(f64_sub(_seu_h, F64_HALF)), _SY_TOL12) == 1,
  "sympeuler: shadow Hamiltonian (q^2+p^2-h*q*p)/2 == 1/2 to 1e-12 over 4000 steps");
# |E - 1/2| <= h/(2(2-h)) = 7.936507936507936e-3; measured max 7.936507535744e-3.
# Explicit Euler would reach 24.4 here, i.e. this bound is ~3000x violated by the
# obvious non-symplectic alternative.
# [measured: scratch run at 2.7.0, not reproducible in-tree; the asserts below bound it between 0.99x and 1x the bound]
var _seu_bnd = f64_div(_sy_h, f64_mul(F64_TWO, f64_sub(F64_TWO, _sy_h)));
assert(f64_lt(_seu_dmax, _seu_bnd) == 1,
  "sympeuler: |E - 1/2| <= h/(2(2-h)) for all 4000 steps (energy bounded, not drifting)");
assert(f64_gt(_seu_dmax, f64_mul(_seu_bnd, _SY_0P99)) == 1,
  "sympeuler: the h/(2(2-h)) energy bound is actually attained (orbit is traversed)");

# (3) Three holes a single-force, read-immediately test still leaves open:
#   * neither integrator is ever handed a force OTHER than a(q) = -q, so an
#     implementation that ignores accel_fn / dp_dq / dq_dp and hardcodes the
#     SHO passes every assertion above;
#   * the 16-byte result is always consumed before the next call, so a shared
#     static scratch buffer instead of a fresh alloc is invisible;
#   * alloc(8) instead of alloc(16) overruns the block by 8 bytes, invisible too
#     (the guard alloc below lands exactly on the overrun under a bump heap).
# Constant acceleration is integrated EXACTLY by both methods, so all of this is
# dyadic and asserted bit-exact.
fn _ode_grav2(q) { return f64_neg(F64_TWO); }     # a(q) = -2,  ignores q
fn _ode_grav1(q) { return f64_neg(F64_ONE); }     # F(q) = -1,  ignores q
fn _ode_vel2(p) { return f64_mul(F64_TWO, p); }   # dq/dp = 2p  (mass 1/2)
var _SY_1_4 = 0x3FD0000000000000;                 # 0.25
# Verlet, a = -2 constant, (q, v) = (0, 1), h = 1/2:
#   q1 = 0 + 1*(1/2) + (1/4)(1/2)(-2) = 1/4       v1 = 1 + (1/4)(-2 + -2) = 0
var _gv = ode_verlet(&_ode_grav2, 0, F64_ONE, F64_HALF);
var _gv_guard = alloc(8);
store64(_gv_guard, F64_ONE);
assert_eq(load64(_gv), _SY_1_4, "verlet a=-2: q1 == 1/4 exactly (accel_fn is really called)");
assert_eq(load64(_gv + 8), 0, "verlet a=-2: v1 == 0 exactly (result block is a full 16 bytes)");
# Symplectic Euler, F = -1 constant, dq/dp = 2p, (q, p) = (0, 1), h = 1/2:
#   p1 = 1 + (1/2)(-1) = 1/2                      q1 = 0 + (1/2)(2*(1/2)) = 1/2
var _gs = ode_symplectic_euler(&_ode_vel2, &_ode_grav1, 0, F64_ONE, F64_HALF);
var _gs_guard = alloc(8);
store64(_gs_guard, F64_ONE);
assert_eq(load64(_gs), F64_HALF, "sympeuler F=-1,dq/dp=2p: q1 == 1/2 exactly (both fn ptrs used)");
assert_eq(load64(_gs + 8), F64_HALF, "sympeuler F=-1,dq/dp=2p: p1 == 1/2 exactly (16-byte block)");
# A shared static scratch buffer inside either integrator would have been
# overwritten by the 4000-step loops above; a fresh alloc per call survives.
assert_eq(load64(vr), _SY_7_8, "verlet: first result still intact after 4001 later calls");
assert_eq(load64(se + 8), _SY_NHALF, "sympeuler: first result still intact after later calls");

# ================================================================
# Optimization
# ================================================================
test_group("optimize");

# Gradient descent: minimize f(x) = x^2, starting at x=5
# Gradient: 2x
# Gradient descent on an ANISOTROPIC quadratic with a non-zero minimizer:
#   f(x,y) = (x-3)^2 + 5(y+2)^2,   grad = (2(x-3), 10(y+2)),   x0 = (5, 3)
# Through 2.6.15 the test minimized x^2 from x0=5 with lr=0.5. That step size
# lands on the exact minimum in ONE update (x <- 5 - 0.5*10 = 0), and the only
# value assertion was |x| < 1 -- a window so wide that halving the step, or
# ignoring lr entirely, still passes; out_fmin was never read at all.
#
# Closed form. With lr, each coordinate contracts geometrically and independently:
#   x_k - 3 = (1 - 2*lr)^k * 2,   y_k + 2 = (1 - 10*lr)^k * 5
# At lr = 1/20 the factors are exactly 0.9 and 0.5.
fn _opt_f(x_ptr) {
    var dx = f64_sub(load64(x_ptr), f64_from(3));
    var dy = f64_add(load64(x_ptr + 8), F64_TWO);
    return f64_add(f64_mul(dx, dx), f64_mul(f64_from(5), f64_mul(dy, dy)));
}
fn _opt_grad(x_ptr, out) {
    var dx = f64_sub(load64(x_ptr), f64_from(3));
    var dy = f64_add(load64(x_ptr + 8), F64_TWO);
    store64(out, f64_mul(F64_TWO, dx));
    store64(out + 8, f64_mul(f64_from(10), dy));
    return 0;
}
var opt_lr = f64_div(F64_ONE, f64_from(20));          # 0.05
var opt_x0 = alloc(16);
store64(opt_x0, f64_from(5));
store64(opt_x0 + 8, f64_from(3));
var opt_out_x = alloc(16);
var opt_out_f = alloc(8);

# (a) Exactly 10 steps, tol unreachable -> pins the whole trajectory.
#   x = 3 + 2*0.9^10  = 3.6973568802
#   y = -2 + 5*0.5^10 = -1.9951171875   (exact: -2 + 5/1024)
#   f = (2*0.9^10)^2 + 5*(5/1024)^2 = 0.4864258276518282
var opt_rc_t, opt_rc_v = opt_gradient_descent(&_opt_f, &_opt_grad, opt_x0, 2, opt_lr, EPSILON_F64, 10,
  opt_out_x, opt_out_f);
assert_eq(opt_rc_v, HSB_ERR_NO_CONVERGENCE, "gd 10 steps: no convergence yet");
assert(f64_approx_eq(load64(opt_out_x), 0x400D942FD810CBF6, EPSILON_F64),
  "gd x_10 = 3 + 2*0.9^10 = 3.6973568802");
assert(f64_approx_eq(load64(opt_out_x + 8), 0xBFFFEC0000000000, EPSILON_F64),
  "gd y_10 = -2 + 5/1024 = -1.9951171875");
assert(f64_approx_eq(load64(opt_out_f), 0x3FDF2199CB6C6FF8, EPSILON_F64),
  "gd f_10 = 0.4864258276518282");
assert_eq(load64(opt_x0), f64_from(5), "gd does not clobber x0");
assert_eq(load64(opt_x0 + 8), f64_from(3), "gd does not clobber x0[1]");

# (b) Run to convergence with tol = 1e-6 on ||grad||. The stopping index is
#   determined in closed form: sqrt(4*(2*0.9^k)^2 + 100*(5*0.5^k)^2) < 1e-6
#   first holds at k = 145, giving x = 3 + 2*0.9^145 = 3.0000004636538438.
var opt_tol6 = 0x3EB0C6F7A0B5ED8D;                    # 1e-6
var opt_out_x2 = alloc(16);
var opt_out_f2 = alloc(8);
var opt_rc2_t, opt_rc2_v = opt_gradient_descent(&_opt_f, &_opt_grad, opt_x0, 2, opt_lr, opt_tol6, 1000,
  opt_out_x2, opt_out_f2);
assert_eq(is_ok(opt_rc2_t), 1, "gd converged");
assert(f64_approx_eq(load64(opt_out_x2), 0x400800003E3B0657, EPSILON_F64),
  "gd x* = 3 + 2*0.9^145 = 3.0000004636538438");
assert_eq(load64(opt_out_x2 + 8), 0xC000000000000000, "gd y* = -2 exactly");
assert(f64_lt(load64(opt_out_f2), 0x3DA5FD7FE1796495) == 1, "gd f* < 1e-11");
assert_eq(load64(opt_out_f2), _opt_f(opt_out_x2), "gd out_fmin == f(out_x)");
# Documented postcondition: the returned point satisfies ||grad|| < tol.
var opt_g = alloc(16);
_opt_grad(opt_out_x2, opt_g);
assert(f64_lt(f64_sqrt(f64_add(f64_mul(load64(opt_g), load64(opt_g)),
        f64_mul(load64(opt_g + 8), load64(opt_g + 8)))), opt_tol6) == 1, "gd ||grad(x*)|| < tol");
# GAP: in (b) the y-coordinate contracts by 0.5 per step while x contracts by 0.9,
# so at the stopping index |g_y| ~ 1e-42 and |g_x| ~ 9e-7 -- the two are 35 orders
# apart and ||g||_1 == ||g||_2 bit-for-bit. The FORM of _opt_norm is therefore
# unconstrained by (a) or (b). Add a third coordinate that contracts at the SAME
# rate as x, so the two norms differ by ~sqrt(2) at the stop and the iteration
# index moves: f(x,y,z) = (x-3)^2 + 5(y+2)^2 + (z-1)^2, x0 = (5,3,4), lr = 1/20.
#   L2 stops at k = 150 -> x = 3 + 2*0.9^150 = 3.000000273782958
#   L1 would stop at k = 153 -> x = 3.0000001995877765  (7.4e-8 apart)
fn _opt_f3(x_ptr) {
    var ax = f64_sub(load64(x_ptr), f64_from(3));
    var ay = f64_add(load64(x_ptr + 8), F64_TWO);
    var az = f64_sub(load64(x_ptr + 16), F64_ONE);
    return f64_add(f64_add(f64_mul(ax, ax), f64_mul(f64_from(5), f64_mul(ay, ay))),
      f64_mul(az, az));
}
fn _opt_grad3(x_ptr, out) {
    store64(out, f64_mul(F64_TWO, f64_sub(load64(x_ptr), f64_from(3))));
    store64(out + 8, f64_mul(f64_from(10), f64_add(load64(x_ptr + 8), F64_TWO)));
    store64(out + 16, f64_mul(F64_TWO, f64_sub(load64(x_ptr + 16), F64_ONE)));
    return 0;
}
var opt3_x0 = alloc(24);
store64(opt3_x0, f64_from(5));
store64(opt3_x0 + 8, f64_from(3));
store64(opt3_x0 + 16, f64_from(4));
var opt3_x = alloc(24);
var opt3_f = alloc(8);
var _rq59t, _rq59v = opt_gradient_descent(&_opt_f3, &_opt_grad3, opt3_x0, 3, opt_lr, opt_tol6, 1000,
  opt3_x, opt3_f);
assert_eq(is_ok(_rq59t), 1, "gd 3d converged");
assert(f64_approx_eq(load64(opt3_x), 0x4008000024BF1C5E, EPSILON_F64),
  "gd 3d x* = 3 + 2*0.9^150 (L2 stop at k=150, an L1 norm would stop at 153)");
assert(f64_approx_eq(load64(opt3_x + 16), 0x3FF000006E3D551B, EPSILON_F64),
  "gd 3d z* = 1 + 3*0.9^150");
assert_eq(load64(opt3_x + 8), 0xC000000000000000, "gd 3d y* = -2 exactly");

# ----------------------------------------------------------------
# opt_bfgs / opt_lbfgs / opt_levenberg_marquardt -- SOLVER BODIES (2.8.3)
#
# Through 2.8.2 these three were reached only through their input-validation
# guards (n <= 0, n > _OPT_MAX_DIM). Every one of them returned before the first
# `alloc`, so roughly 490 lines -- the inverse-Hessian rank-2 update, the L-BFGS
# two-loop recursion and its history ring, the Armijo backtrack, the LM normal
# equations, the LU solve and the whole lambda accept/reject ladder -- were never
# executed by any suite. opt_gradient_descent (above) was the only optimizer with
# a live body.
#
# Every target below is a CLOSED FORM, not a recorded output: the quadratic bowl
# and Rosenbrock have textbook minimisers, and the over-determined line fit is
# solved exactly by the normal equations (re-derived with python3
# fractions.Fraction).  max_iter is set to ~3x the iteration count each solver needs so
# that a solver whose update is degraded to plain steepest descent runs out of
# budget and returns HSB_ERR_NO_CONVERGENCE rather than quietly limping to the
# answer -- the return code is part of what is being asserted.

# (a) Quadratic bowl f(x) = (x0-1)^2 + 2(x1-2)^2 + 3(x2-3)^2 from the origin.
# Minimiser (1, 2, 3), f* = 0, Hessian diag(2, 4, 6) so kappa = 3. BFGS reaches
# ||g|| < 1e-8 in 8 iterations, L-BFGS(m=5) in 14.
fn _ob_f(x_ptr) {
    var oa = f64_sub(load64(x_ptr), F64_ONE);
    var ob = f64_sub(load64(x_ptr + 8), F64_TWO);
    var oc = f64_sub(load64(x_ptr + 16), f64_from(3));
    return f64_add(f64_mul(oa, oa),
      f64_add(f64_mul(F64_TWO, f64_mul(ob, ob)), f64_mul(f64_from(3), f64_mul(oc, oc))));
}
fn _ob_g(x_ptr, out) {
    store64(out, f64_mul(F64_TWO, f64_sub(load64(x_ptr), F64_ONE)));
    store64(out + 8, f64_mul(f64_from(4), f64_sub(load64(x_ptr + 8), F64_TWO)));
    store64(out + 16, f64_mul(f64_from(6), f64_sub(load64(x_ptr + 16), f64_from(3))));
    return 0;
}
# Rosenbrock f(x) = 100(x1 - x0^2)^2 + (1 - x0)^2, the standard non-convex
# curved-valley test. Minimiser (1, 1), f* = 0. Started at the canonical
# (-1.2, 1), which is on the far side of the valley.
fn _or_f(x_ptr) {
    var rx0 = load64(x_ptr);
    var rx1 = load64(x_ptr + 8);
    var rt1 = f64_sub(rx1, f64_mul(rx0, rx0));
    var rt2 = f64_sub(F64_ONE, rx0);
    return f64_add(f64_mul(f64_from(100), f64_mul(rt1, rt1)), f64_mul(rt2, rt2));
}
fn _or_g(x_ptr, out) {
    var rx0 = load64(x_ptr);
    var rx1 = load64(x_ptr + 8);
    var rt1 = f64_sub(rx1, f64_mul(rx0, rx0));
    store64(out, f64_sub(f64_neg(f64_mul(f64_from(400), f64_mul(rx0, rt1))),
        f64_mul(F64_TWO, f64_sub(F64_ONE, rx0))));
    store64(out + 8, f64_mul(f64_from(200), rt1));
    return 0;
}
var _ob_tol8 = 0x3E45798EE2308C3A;                    # 1e-8, on ||grad||
var _ob_x0 = alloc(24);
store64(_ob_x0, 0);
store64(_ob_x0 + 8, 0);
store64(_ob_x0 + 16, 0);
var _ob_x = alloc(24);
var _ob_fm = alloc(8);
var _rq60t, _rq60v = opt_bfgs(&_ob_f, &_ob_g, _ob_x0, 3, _ob_tol8, 40, _ob_x, _ob_fm);
assert_eq(is_ok(_rq60t), 1, "opt_bfgs: quadratic bowl converges inside 40 iterations (needs 8)");
assert(f64_lt(f64_abs(f64_sub(load64(_ob_x), F64_ONE)), opt_tol6) == 1, "opt_bfgs bowl x0 -> 1");
assert(f64_lt(f64_abs(f64_sub(load64(_ob_x + 8), F64_TWO)), opt_tol6) == 1, "opt_bfgs bowl x1 -> 2");
assert(f64_lt(f64_abs(f64_sub(load64(_ob_x + 16), f64_from(3))), opt_tol6) == 1,
  "opt_bfgs bowl x2 -> 3");
assert(f64_lt(load64(_ob_fm), TOL_1EM12) == 1, "opt_bfgs bowl f* < 1e-12 (true minimum is 0)");
assert_eq(load64(_ob_fm), _ob_f(_ob_x), "opt_bfgs: out_fmin == f(out_x)");
assert_eq(load64(_ob_x0), 0, "opt_bfgs does not clobber x0");

var _ol_x = alloc(24);
var _ol_fm = alloc(8);
var _rq61t, _rq61v = opt_lbfgs(&_ob_f, &_ob_g, _ob_x0, 3, 5, _ob_tol8, 60, _ol_x, _ol_fm);
assert_eq(is_ok(_rq61t), 1, "opt_lbfgs: quadratic bowl converges inside 60 iterations (needs 14)");
assert(f64_lt(f64_abs(f64_sub(load64(_ol_x), F64_ONE)), opt_tol6) == 1, "opt_lbfgs bowl x0 -> 1");
assert(f64_lt(f64_abs(f64_sub(load64(_ol_x + 8), F64_TWO)), opt_tol6) == 1,
  "opt_lbfgs bowl x1 -> 2");
assert(f64_lt(f64_abs(f64_sub(load64(_ol_x + 16), f64_from(3))), opt_tol6) == 1,
  "opt_lbfgs bowl x2 -> 3");
assert(f64_lt(load64(_ol_fm), TOL_1EM12) == 1, "opt_lbfgs bowl f* < 1e-12");
assert_eq(load64(_ol_fm), _ob_f(_ol_x), "opt_lbfgs: out_fmin == f(out_x)");

# (b) Rosenbrock. This is what separates a real quasi-Newton update from
# steepest descent: with the H_inv rank-2 update removed, BFGS does not reach
# ||g|| < 1e-8 on this problem in thousands of iterations, so the budget below
# turns a degraded update into a NO_CONVERGENCE return.
# Measured: BFGS 36 iterations, L-BFGS(m=7) 674 -- the Armijo-only line search
# (no curvature/Wolfe condition) costs L-BFGS an order of magnitude here, which
# is why its budget is the looser of the two.
# [measured: scratch run at 2.8.3, not reproducible in-tree; the asserts below record it and bound it at 150 / 2000]
var _or_x0 = alloc(16);
store64(_or_x0, 0xBFF3333333333333);                  # -1.2
store64(_or_x0 + 8, F64_ONE);
var _or_x = alloc(16);
var _or_fm = alloc(8);
var _rq62t, _rq62v = opt_bfgs(&_or_f, &_or_g, _or_x0, 2, _ob_tol8, 150, _or_x, _or_fm);
assert_eq(is_ok(_rq62t), 1, "opt_bfgs: Rosenbrock converges inside 150 iterations (needs 36)");
assert(f64_lt(f64_abs(f64_sub(load64(_or_x), F64_ONE)), opt_tol6) == 1, "opt_bfgs rosenbrock x -> 1");
assert(f64_lt(f64_abs(f64_sub(load64(_or_x + 8), F64_ONE)), opt_tol6) == 1,
  "opt_bfgs rosenbrock y -> 1");
assert(f64_lt(load64(_or_fm), TOL_1EM12) == 1, "opt_bfgs rosenbrock f* < 1e-12");

var _orl_x = alloc(16);
var _orl_fm = alloc(8);
var _rq63t, _rq63v = opt_lbfgs(&_or_f, &_or_g, _or_x0, 2, 7, _ob_tol8, 2000, _orl_x, _orl_fm);
assert_eq(is_ok(_rq63t), 1, "opt_lbfgs: Rosenbrock converges inside 2000 iterations (needs 674)");
assert(f64_lt(f64_abs(f64_sub(load64(_orl_x), F64_ONE)), opt_tol6) == 1,
  "opt_lbfgs rosenbrock x -> 1");
assert(f64_lt(f64_abs(f64_sub(load64(_orl_x + 8), F64_ONE)), opt_tol6) == 1,
  "opt_lbfgs rosenbrock y -> 1");
assert(f64_lt(load64(_orl_fm), TOL_1EM12) == 1, "opt_lbfgs rosenbrock f* < 1e-12");

# (c) opt_levenberg_marquardt, ZERO-residual case: Rosenbrock written as least
# squares, r = (10(x1 - x0^2), 1 - x0), J = [[-20 x0, 10], [-1, 0]]. cost -> 0 at
# (1, 1), so the sqrt(cost) < tol branch is the one that fires and the function
# returns HSB_ERR_NONE. 51 iterations measured.
# [measured: scratch run at 2.8.3, not reproducible in-tree; "fresh buffers: 51 residual calls" pins the call count]
#
# Each residual call returns a FRESH buffer. Through 3.3.3 that was required:
# opt_levenberg_marquardt kept `r_ptr` alive across the trial evaluation and read it
# again at the top of the next iteration to build J^T r, so a callback that handed
# back one reused static buffer fed it the residuals of the trial point. Since 3.3.4
# the solver copies each vector, and (c2) below runs this fixture with a reused
# buffer. 16 B (`alloc(16)` below) per call, over the 51 calls this fixture makes
# (one up front, then one per trial step), is 816 B of bump arena.
# [measured: scratch harness counting _lmr_res calls, not reproducible in-tree, 2026-10-01; cycc 6.6.12]
fn _lmr_res(x_ptr) {
    var lr_out = alloc(16);
    var lrx0 = load64(x_ptr);
    var lrx1 = load64(x_ptr + 8);
    store64(lr_out, f64_mul(f64_from(10), f64_sub(lrx1, f64_mul(lrx0, lrx0))));
    store64(lr_out + 8, f64_sub(F64_ONE, lrx0));
    return lr_out;
}
fn _lmr_jac(x_ptr, out) {
    store64(out, f64_neg(f64_mul(f64_from(20), load64(x_ptr))));
    store64(out + 8, f64_from(10));
    store64(out + 16, f64_neg(F64_ONE));
    store64(out + 24, 0);
    return 0;
}
var _lmr_x = alloc(16);
var _rq64t, _rq64v = opt_levenberg_marquardt(&_lmr_res, &_lmr_jac, _or_x0, 2, 2, _ob_tol8, 200, _lmr_x);
assert_eq(is_ok(_rq64t), 1, "opt_levenberg_marquardt: Rosenbrock LS converges in 200 iterations (needs 36)");
assert(f64_lt(f64_abs(f64_sub(load64(_lmr_x), F64_ONE)), opt_tol6) == 1, "opt_lm rosenbrock x -> 1");
assert(f64_lt(f64_abs(f64_sub(load64(_lmr_x + 8), F64_ONE)), opt_tol6) == 1,
  "opt_lm rosenbrock y -> 1");

# (c2) 3.3.4 -- `residuals` MAY REUSE ONE OUTPUT BUFFER. Through 3.3.3 the solver kept the
# pointer `residuals` returned across the trial evaluation, so with one reused buffer the
# J^T r of the next iteration read the trial point's residuals, rejected or not: this
# fixture took 144 residual calls instead of 51 and stopped at a different x (x0 =
# 0x3FEFFFFFFFFFEEFA), Ok either way. It now copies each vector into two buffers of its
# own, so the reusing callback must give the fresh-buffer run bit for bit: the same calls,
# the same Ok, the same x. Oracle: the fresh-buffer run of (c), on this tree and on the
# tree before the repair, whose bits are the same.
# [measured: krylov LM probe, 3.3.4 tree before and after, cycc 6.6.14, 2026-10-03]
var _LMR_CALLS = 0;
var _LMR_BUF = alloc(16);
fn _lmr_count(x_ptr) {
    _LMR_CALLS = _LMR_CALLS + 1;
    return _lmr_res(x_ptr);
}
fn _lmr_reuse(x_ptr) {
    _LMR_CALLS = _LMR_CALLS + 1;
    var o = _lmr_res(x_ptr);
    store64(_LMR_BUF, load64(o));
    store64(_LMR_BUF + 8, load64(o + 8));
    return _LMR_BUF;
}
var _lmr_xf = alloc(16);
_LMR_CALLS = 0;
var _rq64ft, _rq64fv = opt_levenberg_marquardt(&_lmr_count, &_lmr_jac, _or_x0, 2, 2, _ob_tol8, 200, _lmr_xf);
var _lmr_fresh_calls = _LMR_CALLS;
# 3.4.1: the damping is relative (mu max diag J^T J, see src/optimize.cyr), and the path moved:
# 36 residual calls (3.4.0: 51), stopping at 1 - 1.6e-10 and 1 - 3.2e-10 (3.4.0: 1 - 8.5e-9 and
# 1 - 1.7e-8), both met by ||r|| < 1e-8.
assert_eq(_lmr_fresh_calls, 36, "opt_lm Rosenbrock, fresh buffers: 36 residual calls (3.4.0: 51)");
assert_eq(load64(_lmr_xf), 0x3FEFFFFFFFEA425E, "opt_lm Rosenbrock, fresh buffers: x0 bits");
assert_eq(load64(_lmr_xf + 8), 0x3FEFFFFFFFD45A69, "opt_lm Rosenbrock, fresh buffers: x1 bits");
var _lmr_xr = alloc(16);
_LMR_CALLS = 0;
var _rq64rt, _rq64rv = opt_levenberg_marquardt(&_lmr_reuse, &_lmr_jac, _or_x0, 2, 2, _ob_tol8, 200, _lmr_xr);
assert_eq(is_ok(_rq64rt), 1, "opt_lm Rosenbrock, one reused residual buffer: Ok");
assert_eq(_LMR_CALLS, _lmr_fresh_calls, "opt_lm, one reused residual buffer: the fresh run's calls (3.3.3: 144)");
assert_eq(load64(_lmr_xr), load64(_lmr_xf), "opt_lm, one reused residual buffer: x0 is the fresh run's, bit for bit");
assert_eq(load64(_lmr_xr + 8), load64(_lmr_xf + 8),
  "opt_lm, one reused residual buffer: x1 is the fresh run's, bit for bit");

# (d) opt_levenberg_marquardt, NONZERO-residual case: fit y = a + b*t to the four
# non-collinear points t = (0,1,2,3), y = (1,3,2,6). J is constant, so the exact
# minimiser is the normal-equation solution
#   b = (n*S_ty - S_t*S_y) / (n*S_tt - S_t^2) = (4*25 - 6*12)/(4*14 - 36) = 7/5
#   a = (S_y - b*S_t)/n                       = (12 - 6*1.4)/4       = 9/10
# with min cost 4.2 > 0. sqrt(cost) never drops below tol, so this is also the
# fixture for the documented "HSB_ERR_NO_CONVERGENCE after max_iter, out_x still
# written" contract -- the parameters must be right even though the code path
# taken is the failure return. Measured error vs the exact rational: 1.2e-13.
# [measured: scratch run at 2.8.3, not reproducible in-tree; the asserts below bound it at 1e-9]
var _lmf_t = alloc(32);
var _lmf_y = alloc(32);
store64(_lmf_t, 0);
store64(_lmf_t + 8, F64_ONE);
store64(_lmf_t + 16, F64_TWO);
store64(_lmf_t + 24, f64_from(3));
store64(_lmf_y, F64_ONE);
store64(_lmf_y + 8, f64_from(3));
store64(_lmf_y + 16, F64_TWO);
store64(_lmf_y + 24, f64_from(6));
fn _lmf_res(x_ptr) {
    var lf_out = alloc(32);
    var lfa = load64(x_ptr);
    var lfb = load64(x_ptr + 8);
    var lfi = 0;
    while (lfi < 4) {
        var lfp = f64_add(lfa, f64_mul(lfb, load64(_lmf_t + lfi * 8)));
        store64(lf_out + lfi * 8, f64_sub(lfp, load64(_lmf_y + lfi * 8)));
        lfi = lfi + 1;
    }
    return lf_out;
}
fn _lmf_jac(x_ptr, out) {
    var lji = 0;
    while (lji < 4) {
        store64(out + (lji * 2) * 8, F64_ONE);
        store64(out + (lji * 2 + 1) * 8, load64(_lmf_t + lji * 8));
        lji = lji + 1;
    }
    return 0;
}
var _lmf_x0 = alloc(16);
store64(_lmf_x0, 0);
store64(_lmf_x0 + 8, 0);
var _lmf_x = alloc(16);
var _rq65t, _rq65v = opt_levenberg_marquardt(&_lmf_res, &_lmf_jac, _lmf_x0, 2, 4, _ob_tol8, 200, _lmf_x);
assert_eq(is_err_result(_rq65t), 1, "opt_lm: an over-determined fit with min cost 4.2 cannot reach tol");
assert_eq(_rq65v, HSB_ERR_NO_CONVERGENCE, "opt_lm: an over-determined fit with min cost 4.2 cannot reach tol");
var _lmf_tol9 = 0x3E112E0BE826D695;                   # 1e-9
assert(f64_lt(f64_abs(f64_sub(load64(_lmf_x), 0x3FECCCCCCCCCCCCD)), _lmf_tol9) == 1,
  "opt_lm line fit: intercept a == 9/10 (exact normal-equation solution)");
assert(f64_lt(f64_abs(f64_sub(load64(_lmf_x + 8), 0x3FF6666666666666)), _lmf_tol9) == 1,
  "opt_lm line fit: slope b == 7/5 (exact normal-equation solution)");
# ⛔ 3.3.7 — EVERY opt_levenberg_marquardt CALL IN THE SUITES HAS n_params = 2, and at
# np = 2 a J^T r loop that runs one residual too far (`kk <= nr`, seed-336 mutant m0180)
# adds the word past j_buf times the word past r_ptr: the next block's header (np = 2 as
# raw bits, a denormal), so the sum does not move. From np = 3 that word is a J^T J
# entry, and the gradient's third component is wrong whenever the stale residual past
# r_ptr is not 0. The fixture fits y = a + b t + c t^2 to t = 0..4, y = (1, 3, 2, 6, 5):
# J is constant, so the minimiser is the normal-equation solution a = 37/35, b = 97/70,
# c = -1/14 with min cost 176/35 > 0, which (like the line fit above) can never reach tol,
# so the parameters are read from the documented NO_CONVERGENCE return, bounded at 1e-9.
# [measured: scratch python3 fractions oracle (3.3.7), exact 3x3 normal equations]
var _mt180_t = alloc(40);
var _mt180_y = alloc(40);
for (var _mt180_i = 0; _mt180_i < 5; _mt180_i = _mt180_i + 1) {
    store64(_mt180_t + _mt180_i * 8, f64_from(_mt180_i));
}
store64(_mt180_y, F64_ONE);
store64(_mt180_y + 8, f64_from(3));
store64(_mt180_y + 16, F64_TWO);
store64(_mt180_y + 24, f64_from(6));
store64(_mt180_y + 32, f64_from(5));
fn _mt180_res(x_ptr) {
    var out = alloc(40);
    var i = 0;
    while (i < 5) {
        var t = load64(_mt180_t + i * 8);
        var p = f64_add(load64(x_ptr), f64_mul(t, f64_add(load64(x_ptr + 8), f64_mul(t, load64(x_ptr + 16)))));
        store64(out + i * 8, f64_sub(p, load64(_mt180_y + i * 8)));
        i = i + 1;
    }
    return out;
}
fn _mt180_jac(x_ptr, out) {
    var i = 0;
    while (i < 5) {
        var t = load64(_mt180_t + i * 8);
        store64(out + (i * 3) * 8, F64_ONE);
        store64(out + (i * 3 + 1) * 8, t);
        store64(out + (i * 3 + 2) * 8, f64_mul(t, t));
        i = i + 1;
    }
    return 0;
}
var _mt180_x0 = alloc(24);
var _mt180_x = alloc(24);
var _mt180_rt, _mt180_rv = opt_levenberg_marquardt(&_mt180_res, &_mt180_jac, _mt180_x0, 3, 5, _ob_tol8, 200, _mt180_x);
assert_eq(_mt180_rv, HSB_ERR_NO_CONVERGENCE, "opt_lm quadratic fit: min cost 176/35 cannot reach tol");
assert(f64_lt(f64_abs(f64_sub(load64(_mt180_x), 0x3FF0EA0EA0EA0EA1)), _lmf_tol9) == 1,
  "opt_lm quadratic fit: a == 37/35 (exact normal-equation solution)");
assert(f64_lt(f64_abs(f64_sub(load64(_mt180_x + 8), 0x3FF62BE2BE2BE2BE)), _lmf_tol9) == 1,
  "opt_lm quadratic fit: b == 97/70 (exact normal-equation solution)");
assert(f64_lt(f64_abs(f64_sub(load64(_mt180_x + 16), 0xBFB2492492492492)), _lmf_tol9) == 1,
  "opt_lm quadratic fit: c == -1/14 (exact normal-equation solution)");

# (e) the LINE SEARCH's step control (2.8.3: _opt_armijo's backtrack, shared by BFGS, L-BFGS
# and CG; since 3.4.1 all three take _opt_wolfe_search, and _opt_armijo is gone). The two
# problems above do not need it: disabling the halving (alpha pinned at 1) left
# all 27 assertions green, because a unit step happens to be survivable on both.
# f(x) = x^4 + x^2 is not survivable. From x0 = 3 the gradient is 4*27 + 6 = 114,
# so the first unit step lands at x = -111 where f = 1.5e8 against f(3) = 90,
# and the next gradient is -5.5e6: without backtracking the iterate diverges to
# overflow. The minimiser is exactly 0 with f'' (0) = 2 (nondegenerate, so the
# 1e-8 gradient tolerance is reachable); all three solvers need 9-12 iterations.
fn _oa_f(x_ptr) {
    var av = load64(x_ptr);
    var av2 = f64_mul(av, av);
    return f64_add(f64_mul(av2, av2), av2);
}
fn _oa_g(x_ptr, out) {
    var av = load64(x_ptr);
    store64(out, f64_add(f64_mul(f64_from(4), f64_mul(f64_mul(av, av), av)),
        f64_mul(F64_TWO, av)));
    return 0;
}
var _oa_x0 = alloc(8);
store64(_oa_x0, f64_from(3));
var _oa_x = alloc(8);
var _oa_fm = alloc(8);
var _rq66t, _rq66v = opt_bfgs(&_oa_f, &_oa_g, _oa_x0, 1, _ob_tol8, 40, _oa_x, _oa_fm);
assert_eq(is_ok(_rq66t), 1, "opt_bfgs: x^4 + x^2 from x=3 converges (a unit step would overshoot to -111)");
assert(f64_lt(f64_abs(load64(_oa_x)), opt_tol6) == 1, "opt_bfgs x^4+x^2: x* == 0");
assert(f64_lt(load64(_oa_fm), TOL_1EM12) == 1, "opt_bfgs x^4+x^2: f* < 1e-12");
var _rq67t, _rq67v = opt_lbfgs(&_oa_f, &_oa_g, _oa_x0, 1, 5, _ob_tol8, 40, _oa_x, _oa_fm);
assert_eq(is_ok(_rq67t), 1, "opt_lbfgs: x^4 + x^2 from x=3 converges (needs the Armijo backtrack)");
assert(f64_lt(f64_abs(load64(_oa_x)), opt_tol6) == 1, "opt_lbfgs x^4+x^2: x* == 0");
var _rq68t, _rq68v = opt_conjugate_gradient(&_oa_f, &_oa_g, _oa_x0, 1, _ob_tol8, 40, _oa_x, _oa_fm);
assert_eq(is_ok(_rq68t), 1, "opt_conjugate_gradient: x^4 + x^2 from x=3 converges");
assert(f64_lt(f64_abs(load64(_oa_x)), opt_tol6) == 1, "opt_cg x^4+x^2: x* == 0");

test_group("3.3.7 opt_conjugate_gradient / _opt_armijo: the BFGS scale fixture");
# f = (x0 - k)^2 + 1e5 (x1 - 2k)^2 from (-k/2, 5k/2), tol k * 1e-8, 400 iterations: the
# fixture 3.3.6 repaired opt_bfgs on. CG returned NO_CONVERGENCE from k = 2^-486 down and
# from 2^496 up: beta's g.g fell below DBL_MIN near the minimum (beta 0, a restart every
# step) or overflowed (beta -0, the same restart), and _opt_armijo's d.g overflowed from
# |g| near 2^512 (a -Inf threshold, 40 halvings, the 2^-40 fallback). beta now comes from
# the pair rescaled as BFGS's is, an infinite d.g from rescaled d and g, and a step from a
# finite f to +Inf is refused. From 2^-490 to 2^504 the answer is the k = 1 answer times k, bit for bit (3.3.6:
# 2^-484 to 2^495), and every k from 2^-495 converges. Below that f itself falls under
# DBL_MIN near the minimum and Armijo cannot measure a step: the documented limit.
# [measured: scratch optimizer sweeps (pcg.cyr, pbf.cyr, plbf.cyr), k = 2^-1022..2^504, base and this tree, 2026-10-31]
var _CG7_K = F64_ONE;
var _CG7_NF = 0;
fn _cg7_f(x) {
    _CG7_NF = _CG7_NF + 1;
    var a = f64_sub(load64(x), _CG7_K);
    var b = f64_sub(load64(x + 8), f64_mul(F64_TWO, _CG7_K));
    return f64_add(f64_mul(a, a), f64_mul(0x40F86A0000000000, f64_mul(b, b)));       # 1e5
}
fn _cg7_g(x, out) {
    store64(out, f64_mul(F64_TWO, f64_sub(load64(x), _CG7_K)));
    store64(out + 8, f64_mul(0x41086A0000000000, f64_sub(load64(x + 8), f64_mul(F64_TWO, _CG7_K))));   # 2e5
    return 0;
}
var _cg7_x0 = alloc(16);
var _cg7_ox = alloc(16);
var _cg7_of = alloc(8);
# solver 0 CG, 1 BFGS, 2 L-BFGS on the fixture scaled by 2^e: its solution goes to _cg7_ox, its
# evaluations of f to _CG7_NF.
fn _cg7_run(e, solver) {
    _CG7_K = (1023 + e) << 52;
    store64(_cg7_x0, f64_neg(f64_mul(_CG7_K, F64_HALF)));
    store64(_cg7_x0 + 8, f64_mul(_CG7_K, f64_div(f64_from(5), F64_TWO)));
    var tol = f64_mul(_CG7_K, f64_div(F64_ONE, f64_from(100000000)));
    _CG7_NF = 0;
    var ok = 0;
    if (solver == 0) {
        var t0, v0 = opt_conjugate_gradient(&_cg7_f, &_cg7_g, _cg7_x0, 2, tol, 400, _cg7_ox, _cg7_of);
        ok = is_ok(t0);
    }
    if (solver == 1) {
        var t1, v1 = opt_bfgs(&_cg7_f, &_cg7_g, _cg7_x0, 2, tol, 400, _cg7_ox, _cg7_of);
        ok = is_ok(t1);
    }
    if (solver == 2) {
        var t2, v2 = opt_lbfgs(&_cg7_f, &_cg7_g, _cg7_x0, 2, 5, tol, 400, _cg7_ox, _cg7_of);
        ok = is_ok(t2);
    }
    return ok;
}
# 1 when the answer at 2^e is the k = 1 answer (u0, u1) times 2^e exactly.
fn _cg7_scaled(e, u0, u1) {
    if (load64(_cg7_ox) != f64_mul(u0, (1023 + e) << 52)) { return 0; }
    if (load64(_cg7_ox + 8) != f64_mul(u1, (1023 + e) << 52)) { return 0; }
    return 1;
}
assert_eq(_cg7_run(0, 0), 1, "opt_conjugate_gradient: the scale fixture at k = 1 converges");
var _cg7_u0 = load64(_cg7_ox);
var _cg7_u1 = load64(_cg7_ox + 8);
assert_eq(_cg7_run(0 - 486, 0), 1, "opt_conjugate_gradient: k = 2^-486 converges (3.3.6: NO_CONVERGENCE)");
assert_eq(_cg7_scaled(0 - 486, _cg7_u0, _cg7_u1), 1,
  "opt_conjugate_gradient: k = 2^-486 -> 2^-486 times the k = 1 answer");
assert_eq(_cg7_run(0 - 490, 0), 1, "opt_conjugate_gradient: k = 2^-490 converges (3.3.6: NO_CONVERGENCE)");
assert_eq(_cg7_scaled(0 - 490, _cg7_u0, _cg7_u1), 1,
  "opt_conjugate_gradient: k = 2^-490 -> 2^-490 times the k = 1 answer");
assert_eq(_cg7_run(496, 0), 1, "opt_conjugate_gradient: k = 2^496 converges (3.3.6: NO_CONVERGENCE)");
assert_eq(_cg7_scaled(496, _cg7_u0, _cg7_u1), 1, "opt_conjugate_gradient: k = 2^496 -> 2^496 times the k = 1 answer");
assert_eq(_cg7_run(504, 0), 1, "opt_conjugate_gradient: k = 2^504 converges (3.3.6: NO_CONVERGENCE)");
assert_eq(_cg7_scaled(504, _cg7_u0, _cg7_u1), 1,
  "opt_conjugate_gradient: k = 2^504 -> 2^504 times the k = 1 answer (a step to f = +Inf is refused)");
var _CG7_BAD = 0;
for (var _cg7_e = 0 - 495; _cg7_e <= 504; _cg7_e = _cg7_e + 1) {
    if (_cg7_e == 0 - 484) { _cg7_e = 496; }
    if (_cg7_run(_cg7_e, 0) != 1) { _CG7_BAD = _CG7_BAD + 1; }
    if (f64_approx_eq(f64_div(load64(_cg7_ox), _CG7_K), F64_ONE, LOOSE_TOL_H) != 1) { _CG7_BAD = _CG7_BAD + 1; }
    if (f64_approx_eq(f64_div(load64(_cg7_ox + 8), _CG7_K), F64_TWO, LOOSE_TOL_H) != 1) { _CG7_BAD = _CG7_BAD + 1; }
}
assert_eq(_CG7_BAD, 0,
  "opt_conjugate_gradient: (k, 2k) for k = 2^-495 to 2^-485 and 2^496 to 2^504 (3.3.6: none but 2^-485)");
# 3.4.0: below 2^-495, where f falls under DBL_MIN near the minimum and the Armijo test
# could not measure a step (3.3.7: NO_CONVERGENCE, documented), the slope-measuring line
# search (_opt_wolfe_search) reaches the k = 1 answer times k as well; at k = 2^-600, where
# f(x0) itself is 0, too (3.3.7 left a finite wrong point there).
# [measured: scratch CG probes (NU1-work/p/pcg.cyr, pcg3.cyr), base tree and this tree, 2026-10-31]
assert_eq(_cg7_run(0 - 496, 0), 1,
  "opt_conjugate_gradient: k = 2^-496 converges (3.3.7: NO_CONVERGENCE, f under DBL_MIN near the minimum)");
assert_eq(_cg7_scaled(0 - 496, _cg7_u0, _cg7_u1), 1,
  "opt_conjugate_gradient: k = 2^-496 -> 2^-496 times the k = 1 answer");
assert_eq(_cg7_run(0 - 600, 0), 1, "opt_conjugate_gradient: k = 2^-600 converges (3.3.7: NO_CONVERGENCE)");
assert_eq(_cg7_scaled(0 - 600, _cg7_u0, _cg7_u1), 1,
  "opt_conjugate_gradient: k = 2^-600 -> 2^-600 times the k = 1 answer");
# BFGS and L-BFGS reached (k, 2k) at 2^500 in 3.3.6 too, after the 40 halvings on their first
# step: 52 and 50 evaluations of f. 3.3.7 took the k = 1 path: 30 and 28.
assert_eq(_cg7_run(500, 1), 1, "opt_bfgs: k = 2^500 converges");
assert_eq(load64(_cg7_ox), 0x5F30000000000000, "opt_bfgs: k = 2^500 -> x0 = k exactly");
assert_eq(_cg7_run(500, 2), 1, "opt_lbfgs: k = 2^500 converges");
assert_eq(load64(_cg7_ox + 8), (1023 + 501) << 52, "opt_lbfgs: k = 2^500 -> x1 = 2k exactly");
# 3.4.1 (second review): the power-of-two path invariance 3.3.7 had is back, and exact, for both.
# Their first trial (_opt_qn_first) is a length read from x, f and g that a power of two scales
# exactly, and H's first scale (eq. 6.20 / 7.20) is a ratio of the pair's, so the run at 2^e is
# the k = 1 run times 2^e, bit for bit and evaluation for evaluation, at every e from -514 to
# 495: 9 values of f and 8 gradients, x = (1, 2) k exactly. Outside that, trials past the minimum
# overflow f (2^496 up: 11 values of f at 2^500, x0 = k exactly) or f(x0), which the first trial
# reads, is subnormal (from 2^-515), and the path moves. (3.4.0: 30 at both 2^500 and 1 for BFGS;
# L-BFGS 9 at 2^500 and 16 at 1; the first 3.4.1 forms: 9 and 5, 9 and 16, invariant at no scale.)
# [measured: scratch scale probe (NUM3-work cg7inv.cyr), e = -1074..1023, this tree, 2026-11-01]
assert_eq(_cg7_run(0, 1), 1, "opt_bfgs: k = 1 converges");
assert_eq(load64(_cg7_ox), F64_ONE, "opt_bfgs: k = 1 -> x0 = 1 exactly");
assert_eq(load64(_cg7_ox + 8), F64_TWO, "opt_bfgs: k = 1 -> x1 = 2 exactly");
assert_eq(_CG7_NF, 9, "opt_bfgs: k = 1 evaluates f 9 times (3.4.0: 30)");
assert_eq(_cg7_run(0, 2), 1, "opt_lbfgs: k = 1 converges");
assert_eq(load64(_cg7_ox), F64_ONE, "opt_lbfgs: k = 1 -> x0 = 1 exactly");
assert_eq(_CG7_NF, 9, "opt_lbfgs: k = 1 evaluates f 9 times (3.4.0: 16; 3.3.7: 28)");
var _CG7_INV = 0;
for (var _cg7_s = 1; _cg7_s <= 2; _cg7_s = _cg7_s + 1) {
    for (var _cg7_ie = 0 - 514; _cg7_ie <= 495; _cg7_ie = _cg7_ie + 1) {
        if (_cg7_run(_cg7_ie, _cg7_s) != 1) { _CG7_INV = _CG7_INV + 1; }
        if (_CG7_NF != 9) { _CG7_INV = _CG7_INV + 1; }
        if (_cg7_scaled(_cg7_ie, F64_ONE, F64_TWO) != 1) { _CG7_INV = _CG7_INV + 1; }
    }
}
assert_eq(_CG7_INV, 0,
  "opt_bfgs / opt_lbfgs: k = 2^-514 .. 2^495 -> (k, 2k) exactly in the k = 1 run's 9 values of f (3.4.0: not at one)");
assert_eq(_cg7_run(500, 1), 1, "opt_bfgs: k = 2^500 converges (again, for the count)");
assert_eq(_CG7_NF, 11, "opt_bfgs: k = 2^500 evaluates f 11 times, where trials past the minimum overflow f");
# 3.4.1: _opt_armijo is gone (opt_bfgs was its last caller; see src/optimize.cyr), and with it
# the six assertions that asked it directly, about its 3.3.7 d.g and +Inf repairs; the same
# fixtures through opt_bfgs are in tests/edge_cases.tcyr, group "3.4.1: opt_bfgs on the
# strong-Wolfe search".
_CG7_K = F64_ONE;

# ================================================================
# Sparse / SVD / Eigen
# ================================================================
test_group("linalg_ext");

# BiCGSTAB on A x = b with A = [[4,1,0],[1,3,1],[0,1,2]], b = (6,10,8), x = (1,2,3).
# solve_bicgstab had NO test through 2.6.11 and was a complete no-op: its breakdown
# tolerance was written `f64_from(0x3C32725DD1D243AC)`, and f64_from CONVERTS an
# integer rather than reinterpreting bits, so the tolerance was 4.34 x 10^18 instead of
# 1e-18 and the first `|rho| < tol` check always fired — the solver returned the
# initial guess verbatim. These assert the SOLUTION, so a no-op cannot pass.
fn _bicg_matvec(xp) {
    var o = alloc(24);
    var bx0 = load64(xp);
    var bx1 = load64(xp + 8);
    var bx2 = load64(xp + 16);
    store64(o, f64_add(f64_mul(f64_from(4), bx0), bx1));
    store64(o + 8, f64_add(f64_add(bx0, f64_mul(f64_from(3), bx1)), bx2));
    store64(o + 16, f64_add(bx1, f64_mul(f64_from(2), bx2)));
    return o;
}
var _bicg_b = alloc(24);
store64(_bicg_b, f64_from(6));
store64(_bicg_b + 8, f64_from(10));
store64(_bicg_b + 16, f64_from(8));
var _bicg_x0 = alloc(24);
store64(_bicg_x0, 0);
store64(_bicg_x0 + 8, 0);
store64(_bicg_x0 + 16, 0);
var _bicg_xt, _bicg_x = solve_bicgstab_checked(&_bicg_matvec, _bicg_b, _bicg_x0, 3,
  f64_div(F64_ONE, f64_from(1000000000)), 100);
assert_eq(is_ok(_bicg_xt), 1, "bicgstab returns a solution");
var _bicg_eps = f64_div(F64_ONE, f64_from(1000000));
assert(f64_lt(f64_abs(f64_sub(load64(_bicg_x), F64_ONE)), _bicg_eps) == 1, "bicgstab x[0] == 1");
assert(f64_lt(f64_abs(f64_sub(load64(_bicg_x + 8), F64_TWO)), _bicg_eps) == 1, "bicgstab x[1] == 2");
assert(f64_lt(f64_abs(f64_sub(load64(_bicg_x + 16), f64_from(3))), _bicg_eps) == 1,
  "bicgstab x[2] == 3");

# === 3.3.3 G2b: solve_bicgstab breakdown guards ===
# ⛔ The three breakdown tests compared r_hat . r, r_hat . A p and t . t against an
# absolute 1e-18: degree two to four in the caller's units. Each guard is now an
# exact-zero test, and each is interrogated here at the input where it fires; the
# sweep at the end covers the scale range. The 3.3.2 outcomes quoted in the messages
# come from the scratch harness that measured them against the shipped bundle.
# [measured: scratch harness, not reproducible in-tree, 2026-10-01; cycc 6.6.12]
test_group("3.3.3 solve_bicgstab: breakdown guards are exact-zero");

# (0) WHERE 3.3.2 WAS RIGHT, NOTHING MOVES. r_hat is now divided by a power of two, which
# is exact, so the solve above must still return 3.3.2's bits. Oracle: the shipped 3.3.2
# bundle, run on this fixture. Pins (1) as well: it compares against these.
# [measured: scratch harness, not reproducible in-tree, 2026-10-01; cycc 6.6.12]
assert_eq(load64(_bicg_x), 0x3FEFFFFFFFFFFFFF, "bicgstab unit scale: x[0] is 3.3.2's 1 - 2^-53, bit for bit");
assert_eq(load64(_bicg_x + 8), 0x4000000000000000, "bicgstab unit scale: x[1] is 3.3.2's 2, bit for bit");
assert_eq(load64(_bicg_x + 16), 0x4007FFFFFFFFFFFF, "bicgstab unit scale: x[2] is 3.3.2's 3 - 2^-51, bit for bit");

# (1) UNIT SCALE, TIGHT TOL. With tol <= 1e-17, 3.3.2's t . t test fired on the third
# iteration and returned the iterate BEFORE the converging half step: x = (0.98986,
# 1.99766, 2.95940) where the answer is (1, 2, 3). Oracle: the tol = 1e-9 solve above,
# bit for bit. At tol = 0 the loop ends only on an exact zero, and still must not drift.
# [measured: scratch harness, not reproducible in-tree, 2026-10-01; cycc 6.6.12]
# ⭐ 3.4.0 review — Ok is confirmed with the true residual b' - A' x. At 1e-17 the recurrence's
# residual met tol while the true one did not, so the run restarted from it and ended on
# (1, 2 - 2^-52, 3), within an ulp of (1, 2, 3) (3.3.3-3.4.0: the 1e-9 solve's bits); at tol = 0
# no x reaches an exactly zero true residual, so it is NO_CONVERGENCE (it was Ok on the
# recurrence's exact zero).
# [measured: LA2 probe k2, this tree, cycc 6.7.9, 2026-10-31]
var _g2b_x17t, _g2b_x17 = solve_bicgstab_checked(&_bicg_matvec, _bicg_b, _bicg_x0, 3, 0x3C670EF54646D497, 100);  # 1e-17
var _g2b_xt0t, _g2b_xt0 = solve_bicgstab_checked(&_bicg_matvec, _bicg_b, _bicg_x0, 3, 0, 100);
assert_eq(is_ok(_g2b_x17t), 1, "bicgstab tol = 1e-17: Ok (3.3.2: x[2] 1.35% off)");
assert_eq(load64(_g2b_x17), F64_ONE, "bicgstab tol = 1e-17: x[0] = 1 exactly, confirmed on the true residual");
assert_eq(load64(_g2b_x17 + 8), 0x3FFFFFFFFFFFFFFF, "bicgstab tol = 1e-17: x[1] = 2 - 2^-52");
assert_eq(load64(_g2b_x17 + 16), f64_from(3), "bicgstab tol = 1e-17: x[2] = 3 exactly");
assert_eq(_g2b_xt0, HSB_ERR_NO_CONVERGENCE, "bicgstab tol = 0: no exactly zero true residual -> NO_CONVERGENCE");

# (1b) r = 0 AT THE START: x0 already solves the system exactly. r_hat is then the zero
# vector (there is no power of two to scale it by), r_hat . r = 0, and x0 comes back
# after the single matvec that formed r.
var _g2b_xe = alloc(24);
store64(_g2b_xe, F64_ONE);
store64(_g2b_xe + 8, F64_TWO);
store64(_g2b_xe + 16, f64_from(3));
var _G2B_EX_CALLS = 0;
fn _g2b_count_bicg(xp) {
    _G2B_EX_CALLS = _G2B_EX_CALLS + 1;
    return _bicg_matvec(xp);
}
var _g2b_xext, _g2b_xex = solve_bicgstab_checked(&_g2b_count_bicg, _bicg_b, _g2b_xe, 3, 0, 50);
# (3.4.0 review: plus the scaled frame's probe, A b')
assert_eq(_G2B_EX_CALLS, 2, "bicgstab, x0 exact: stops after the probe and the one matvec that formed r = 0");
assert_eq(load64(_g2b_xex), F64_ONE, "bicgstab, x0 exact: x0 returned, x[0] = 1");
assert_eq(load64(_g2b_xex + 8), F64_TWO, "bicgstab, x0 exact: x[1] = 2");
assert_eq(load64(_g2b_xex + 16), f64_from(3), "bicgstab, x0 exact: x[2] = 3");

# (2) t = A s EXACTLY ZERO. A = 2I, tol = 0: alpha = 1/2 exactly, s = 0, so t = 0 and
# omega cannot be formed. The half step x0 + alpha p = b/2 is already exact; 3.3.2's
# t . t test returned x0 = 0 without it.
fn _g2b_2I(xp) {
    var o = alloc(24);
    store64(o, f64_mul(F64_TWO, load64(xp)));
    store64(o + 8, f64_mul(F64_TWO, load64(xp + 8)));
    store64(o + 16, f64_mul(F64_TWO, load64(xp + 16)));
    return o;
}
var _g2b_x2t, _g2b_x2 = solve_bicgstab_checked(&_g2b_2I, _bicg_b, _bicg_x0, 3, 0, 50);
assert_eq(load64(_g2b_x2), f64_from(3), "bicgstab 2I, tol 0: t = 0 keeps the half step, x[0] = 3 (3.3.2: 0)");
assert_eq(load64(_g2b_x2 + 8), f64_from(5), "bicgstab 2I, tol 0: x[1] = 5 (3.3.2: 0)");
assert_eq(load64(_g2b_x2 + 16), f64_from(4), "bicgstab 2I, tol 0: x[2] = 4 (3.3.2: 0)");

# (2b) A SUBNORMAL RESIDUAL. b = (6,10,8) * 2^-1070 is subnormal, so the unscaled
# r_hat . r squares it to exactly 0, and 3.3.2 returned x0. r_hat is divided by the
# power of two at or below max|b_i|, here 2^-1067, which for a subnormal is its own
# leading bit; dividing by 2^-1022 instead leaves r_hat at 2^-45 and rho still flushes.
# A = 2I, tol 0: alpha = 1/2, s = 0, x = b/2, exact (every b_i is an even multiple of
# 2^-1074). The bit patterns ARE the multiples of 2^-1074.
var _g2b_bsub = alloc(24);
store64(_g2b_bsub, 96);          # 6 * 2^-1070
store64(_g2b_bsub + 8, 160);     # 10 * 2^-1070
store64(_g2b_bsub + 16, 128);    # 8 * 2^-1070
var _g2b_xsubt, _g2b_xsub = solve_bicgstab_checked(&_g2b_2I, _g2b_bsub, _bicg_x0, 3, 0, 50);
assert_eq(load64(_g2b_xsub), 48, "bicgstab, subnormal b: x[0] = 3 * 2^-1070 exactly (3.3.2: 0)");
assert_eq(load64(_g2b_xsub + 8), 80, "bicgstab, subnormal b: x[1] = 5 * 2^-1070 exactly (3.3.2: 0)");
assert_eq(load64(_g2b_xsub + 16), 64, "bicgstab, subnormal b: x[2] = 4 * 2^-1070 exactly (3.3.2: 0)");

# (3) omega = 0 WITH r_hat . r NOT EXACTLY ZERO. An A_fn whose first t (its third call)
# is the zero vector leaves omega = 0, r = s, and r_hat . s zero only up to rounding;
# without the omega test the next beta is +-Inf and the whole budget burns to NaN
# (measured on the tree with only that test removed: 101 matvecs, every component NaN).
# Oracle: tol = +Inf returns at the first half step, x0 + alpha p, by the s-norm path.
# [measured: scratch harness, not reproducible in-tree, 2026-10-01; cycc 6.6.12]
var _G2B_CALLS = 0;
var _G2B_ZERO_AT = 0 - 1;
fn _g2b_zt(xp) {
    _G2B_CALLS = _G2B_CALLS + 1;
    if (_G2B_CALLS == _G2B_ZERO_AT) {
        var z = alloc(24);
        store64(z, 0);
        store64(z + 8, 0);
        store64(z + 16, 0);
        return z;
    }
    return _bicg_matvec(xp);
}
# 3.4.0: the zero-t stop is a breakdown and is reported (3.3.3-3.3.7 returned the half step
# x0 + alpha p, unreported). tol = +Inf is refused before any matvec (3.4.0 review; through the
# first 3.4.0 tree it accepted x0, an infinite residual included).
_G2B_CALLS = 0;
var _g2b_xht, _g2b_xh = solve_bicgstab_checked(&_g2b_zt, _bicg_b, _bicg_x0, 3, F64_POS_INF, 50);
assert_eq(_G2B_CALLS, 0, "bicgstab tol = +Inf: no matvec (3.3.7: the half step, 2)");
assert_eq(_g2b_xh, HSB_ERR_INVALID_INPUT, "bicgstab tol = +Inf -> INVALID_INPUT");
_G2B_CALLS = 0;
_G2B_ZERO_AT = 3;
var _g2b_xzt, _g2b_xz = solve_bicgstab_checked(&_g2b_zt, _bicg_b, _bicg_x0, 3, 0x3DDB7CDFD9D7BDBB, 50);  # 1e-10
_G2B_ZERO_AT = 0 - 1;
assert_eq(_G2B_CALLS, 3, "bicgstab, first t = 0: stops after 3 matvecs (without the omega test: 101)");
assert_eq(_g2b_xz, HSB_ERR_NO_CONVERGENCE,
  "bicgstab, first t = 0: omega = 0 -> NO_CONVERGENCE (3.3.3-3.3.7: the half step, unreported; 3.3.2: x0)");

# (4) r_hat . A p EXACTLY ZERO. A rotates (x0, x1) by 90 degrees, so with b = e0 the
# first r_hat . A p is 0 and alpha cannot be formed: the guard returns x0 untouched.
fn _g2b_skew(xp) {
    var o = alloc(24);
    store64(o, f64_neg(load64(xp + 8)));
    store64(o + 8, load64(xp));
    store64(o + 16, load64(xp + 16));
    return o;
}
var _g2b_be0 = alloc(24);
store64(_g2b_be0, F64_ONE);
store64(_g2b_be0 + 8, 0);
store64(_g2b_be0 + 16, 0);
var _g2b_xst, _g2b_xs = solve_bicgstab_checked(&_g2b_skew, _g2b_be0, _bicg_x0, 3, 0x3DDB7CDFD9D7BDBB, 50);
assert_eq(is_err_result(_g2b_xst), 1, "bicgstab, r_hat . A p = 0: a breakdown -> Err (3.3.3-3.3.7: x0, unreported)");
assert_eq(_g2b_xs, HSB_ERR_NO_CONVERGENCE, "bicgstab, r_hat . A p = 0: NO_CONVERGENCE (not Inf or NaN)");

# (5) r_hat . r EXACTLY ZERO WITH r != 0 (a lucky breakdown). A = [[1,2,0],[2,1,2],
# [1,-2,1]], b = (0,-1,0): every intermediate is a small dyadic, so the float run is
# exact. After one iteration alpha = 1, omega = 1, x = (2,-1,-2), r = (0,0,-2), and
# r_hat = (0,-1,0) is orthogonal to r. Oracle: the same recurrence in exact rational
# arithmetic. ⚠ (2,-1,-2) is NOT the solution, (0.4,-0.2,-0.8): through 3.3.7 the breakdown
# returned it as the answer, unreported; since 3.4.0 it is Err(HSB_ERR_NO_CONVERGENCE).
# Without the test the stored rho becomes 0, the next beta divides by it, and x is NaN.
fn _g2b_lucky(xp) {
    var o = alloc(24);
    var a0 = load64(xp);
    var a1 = load64(xp + 8);
    var a2 = load64(xp + 16);
    store64(o, f64_add(a0, f64_mul(F64_TWO, a1)));
    store64(o + 8, f64_add(f64_add(f64_mul(F64_TWO, a0), a1), f64_mul(F64_TWO, a2)));
    store64(o + 16, f64_add(f64_sub(a0, f64_mul(F64_TWO, a1)), a2));
    return o;
}
var _g2b_bl = alloc(24);
store64(_g2b_bl, 0);
store64(_g2b_bl + 8, f64_neg(F64_ONE));
store64(_g2b_bl + 16, 0);
var _g2b_xlt, _g2b_xl = solve_bicgstab_checked(&_g2b_lucky, _g2b_bl, _bicg_x0, 3, 0x3DDB7CDFD9D7BDBB, 50);
assert_eq(is_err_result(_g2b_xlt), 1, "bicgstab lucky breakdown: Err (3.3.7: the iterate (2,-1,-2), unreported)");
assert_eq(_g2b_xl, HSB_ERR_NO_CONVERGENCE, "bicgstab lucky breakdown: NO_CONVERGENCE");

# (6) THE SCALE SWEEP. A = 2^ea * N, N = [[4,1,0],[-1,3,1],[0,-2,2]], b = 2^eb * c with
# c = (1, 2.1, 2.9), so x = 2^(eb-ea) * x1 for the unit-scale x1. ea, eb run over
# [-1000, 1000] in steps of 25, kept where x and the caller's own A p (order 2^(ea+eb))
# are representable: 3281 cells. 3.3.2 got 483 within 1e-12 relative of the exact x,
# the exact-zero tests alone 1491; dropping the r_hat scaling 2081, taking omega's fast
# path unconditionally 1631, dropping any one fast-path bound 2981 to 3257. Worst error
# against x1 with all of them, measured on this exact sequence: 6.6e-16 relative, so
# 1e-14 is 15x headroom. NaN fails the comparison.
# [measured: scratch harness, not reproducible in-tree, 2026-10-01; cycc 6.6.12]
var _G2B_KA = F64_ONE;
fn _g2b_nmul(xp, o) {
    var a0 = load64(xp);
    var a1 = load64(xp + 8);
    var a2 = load64(xp + 16);
    store64(o, f64_add(f64_mul(f64_from(4), a0), a1));
    store64(o + 8, f64_add(f64_sub(f64_mul(f64_from(3), a1), a0), a2));
    store64(o + 16, f64_sub(f64_mul(F64_TWO, a2), f64_mul(F64_TWO, a1)));
    return o;
}
fn _g2b_kN(xp) {
    var o = _g2b_nmul(xp, alloc(24));
    store64(o, f64_mul(_G2B_KA, load64(o)));
    store64(o + 8, f64_mul(_G2B_KA, load64(o + 8)));
    store64(o + 16, f64_mul(_G2B_KA, load64(o + 16)));
    return o;
}
fn _g2b_solve_scaled(ea, eb) {
    _G2B_KA = (1023 + ea) << 52;
    var kb = (1023 + eb) << 52;
    var bb = alloc(24);
    store64(bb, f64_mul(kb, F64_ONE));
    store64(bb + 8, f64_mul(kb, 0x4000CCCCCCCCCCCD));        # 2.1
    store64(bb + 16, f64_mul(kb, 0x4007333333333333));       # 2.9
    var x0 = alloc(24);
    store64(x0, 0);
    store64(x0 + 8, 0);
    store64(x0 + 16, 0);
    var xt, xs = solve_bicgstab_checked(&_g2b_kN, bb, x0, 3, 0x3DDB7CDFD9D7BDBB, 200);  # 1e-10, relative
    _G2B_KA = F64_ONE;
    if (is_err_result(xt) == 1) { return 0; }
    return xs;
}
var _g2b_x1 = _g2b_solve_scaled(0, 0);
# x1 is 3.3.2's own unit-scale answer, bit for bit: r_hat is divided by a power of two.
# Dividing by max|r0_i| itself (2.9 here) instead moves x1[0] and x1[1] by an ulp, and
# the 1e-14 sweep below cannot see that. Oracle: the shipped 3.3.2 bundle.
# [measured: scratch harness, not reproducible in-tree, 2026-10-01; cycc 6.6.12]
assert_eq(load64(_g2b_x1), 0x3FC9393939393938, "bicgstab, N x = c: x1[0] is 3.3.2's, bit for bit");
assert_eq(load64(_g2b_x1 + 8), 0x3FCB1B1B1B1B1B17, "bicgstab, N x = c: x1[1] is 3.3.2's, bit for bit");
assert_eq(load64(_g2b_x1 + 16), 0x3FFA969696969696, "bicgstab, N x = c: x1[2] is 3.3.2's, bit for bit");
var _G2B_CELLS = 0;
var _G2B_BAD = 0;
for (var _g2b_ea = 0 - 1000; _g2b_ea <= 1000; _g2b_ea = _g2b_ea + 25) {
    for (var _g2b_eb = 0 - 1000; _g2b_eb <= 1000; _g2b_eb = _g2b_eb + 25) {
        var _g2b_dx = _g2b_eb - _g2b_ea;
        var _g2b_sm = _g2b_eb + _g2b_ea;
        if (_g2b_dx < 0) { _g2b_dx = 0 - _g2b_dx; }
        if (_g2b_sm < 0) { _g2b_sm = 0 - _g2b_sm; }
        if (_g2b_dx <= 1000 && _g2b_sm <= 1000) {
            _G2B_CELLS = _G2B_CELLS + 1;
            var _g2b_xc = _g2b_solve_scaled(_g2b_ea, _g2b_eb);
            if (_g2b_xc == 0) { _G2B_BAD = _G2B_BAD + 3; }
            for (var _g2b_k = 0; _g2b_k < 3 && _g2b_xc != 0; _g2b_k = _g2b_k + 1) {
                # x * 2^ea * 2^-eb, in two exact steps so neither factor leaves the range
                var _g2b_back = f64_mul(f64_mul(load64(_g2b_xc + _g2b_k * 8), (1023 + _g2b_ea) << 52),
                  (1023 - _g2b_eb) << 52);
                var _g2b_ref = load64(_g2b_x1 + _g2b_k * 8);
                if (f64_lt(f64_abs(f64_sub(_g2b_back, _g2b_ref)), f64_mul(f64_abs(_g2b_ref), TOL_1EM14)) != 1) {
                    _G2B_BAD = _G2B_BAD + 1;
                }
            }
        }
    }
}
assert_eq(_G2B_CELLS, 3281, "the bicgstab 2D scale sweep ran all 3281 in-range cells");
assert_eq(_G2B_BAD, 0, "bicgstab: (2^ea N) x = 2^eb c solved to 1e-14 in every cell (3.3.2: 483 of 3281)");

# === 3.3.3 R5le: solve_bicgstab, a t numerically orthogonal to s ===
# When t = A s is orthogonal to s, the minimiser of |s - omega t| is 0 and the
# stabilising step cannot move. 3.3.2 formed omega = 0 exactly and returned NaN after
# its whole budget; before this repair the rescue re-formed t . s as a sum that no
# longer cancelled exactly, and x came back finite and wrong. Now a rescue numerator
# within its rounding of zero (some term >= DBL_MIN) returns x all NaN at once,
# unless |s| <= 2^-52 |r0|, when the half step is returned. The fixture is G2b's:
# [[4,1,0],[1,3,1],[0,1,2]], with an A_fn that answers call _R5LE_AT with
# (-s1, s0, 0), exactly orthogonal to s. The 3.3.2 and pre-repair outcomes quoted in
# the messages were measured on the shipped bundle and on this tree before the repair.
# [measured: R5le probe, 3.3.2 bundle, the tree before this repair and this tree, cycc 6.6.12, 2026-10-01]
test_group("3.3.3 solve_bicgstab: an orthogonal t is reported as NaN");
var _R5LE_CALLS = 0;
var _R5LE_AT = 0 - 1;
fn _r5le_orth(xp) {
    _R5LE_CALLS = _R5LE_CALLS + 1;
    if (_R5LE_CALLS == _R5LE_AT) {
        var o = alloc(24);
        store64(o, f64_neg(load64(xp + 8)));
        store64(o + 8, load64(xp));
        store64(o + 16, 0);
        return o;
    }
    return _bicg_matvec(xp);
}
fn _r5le_solve(b, tol, at) {
    _R5LE_CALLS = 0;
    _R5LE_AT = at;
    var xt, x = solve_bicgstab_checked(&_r5le_orth, b, _bicg_x0, 3, tol, 50);
    _R5LE_AT = 0 - 1;
    if (is_err_result(xt) == 1) { return x; }   # the Err code (negative), never a pointer
    return x;
}
var _R5LE_QNAN = 0x7FF8000000000000;
# (1) THE NUMERATOR CANCELS TO EXACTLY 0. b = (6, 10, 8), tol 1e-10, the orthogonal t
# on the third call: before the repair omega came out 0, the omega stop returned the
# half step (1.41, 2.35, 1.88) for (1, 2, 3), 41% off, unreported; 3.3.2 returned NaN after
# 101 matvecs.
# [measured: R5le probe, 3.3.2 bundle, the tree before this repair and this tree, cycc 6.6.12, 2026-10-01]
var _r5le_x1 = _r5le_solve(_bicg_b, 0x3DDB7CDFD9D7BDBB, 3);   # 1e-10
assert_eq(_R5LE_CALLS, 3, "bicgstab, orthogonal t (sum exactly 0): stops at the 3rd matvec");
assert_eq(_r5le_x1, HSB_ERR_NO_CONVERGENCE,
  "bicgstab, orthogonal t (sum exactly 0): NO_CONVERGENCE (3.3.3-3.3.7: x NaN; before: the half step, 41% off)");
# (2) THE NUMERATOR IS A ROUNDING RESIDUE. x* = (-5.584, 9.195, 4.456), b = N x*,
# the same t: the rescue's sum is 1.1e-16 against a bound of 1.1e-15, so omega was
# 2.3e-17; the loop went on, r_hat . r came out exactly 0, and that breakdown returned
# (-4.25, 8.56, 5.86), 32% off; 3.3.2 returned NaN after 101 matvecs. A test for an
# exactly-zero sum alone lets this one through.
# [measured: R5le probe, 3.3.2 bundle, the tree before this repair and this tree, cycc 6.6.12, 2026-10-01]
var _r5le_xs = alloc(24);
store64(_r5le_xs, 0xC0165604189374BC);        # -5.584
store64(_r5le_xs + 8, 0x402263D70A3D70A4);    # 9.195
store64(_r5le_xs + 16, 0x4011D2F1A9FBE76D);   # 4.456
var _r5le_b2 = _bicg_matvec(_r5le_xs);
var _r5le_x2 = _r5le_solve(_r5le_b2, 0x3DDB7CDFD9D7BDBB, 3);   # 1e-10
assert_eq(_r5le_x2, HSB_ERR_NO_CONVERGENCE,
  "bicgstab, orthogonal t (rounding residue): NO_CONVERGENCE (3.3.3-3.3.7: NaN; before: an iterate 32% off)");
# (3) THE ITERATE HAS ALREADY CONVERGED, BUT NOT TO tol = 0. The orthogonal t on the 7th
# call, where |s| is 4.0e-17 against |r0| = 14.1: 3.3.3-3.3.7 returned the half step as as
# converged as r0's rounding allows. tol = 0 asks for a zero residual, which |s| is not, so
# since 3.4.0 this stop is reported; any tol the half step meets accepts it (tol 1e-17 below).
var _r5le_x3 = _r5le_solve(_bicg_b, 0, 7);
assert_eq(_R5LE_CALLS, 7, "bicgstab, orthogonal t after convergence: stops at the 7th matvec");
assert_eq(_r5le_x3, HSB_ERR_NO_CONVERGENCE, "bicgstab, orthogonal t after convergence, tol 0: NO_CONVERGENCE");
# (4) EVERY TERM IS ZERO: STRUCTURE, NOT CANCELLATION. [[0,1],[3,0]] x = (5,1), tol 0:
# the second t has a zero term against every non-zero s_i, so the numerator is exactly
# 0 with no term to cancel. That is the omega stop's half step, (1/3, 5) to 5 ulps,
# as on the tree before the repair (bits from there); judging it as a cancellation
# returns NaN. 3.3.2 returned (4.32, 12.18) from its t . t test.
var _R5LE_SW_CALLS = 0;
fn _r5le_swap(xp) {
    _R5LE_SW_CALLS = _R5LE_SW_CALLS + 1;
    var o = alloc(16);
    store64(o, load64(xp + 8));
    store64(o + 8, f64_mul(f64_from(3), load64(xp)));
    return o;
}
var _r5le_bs = alloc(16);
store64(_r5le_bs, f64_from(5));
store64(_r5le_bs + 8, F64_ONE);
var _r5le_x0s = alloc(16);
store64(_r5le_x0s, 0);
store64(_r5le_x0s + 8, 0);
var _r5le_x4t, _r5le_x4 = solve_bicgstab_checked(&_r5le_swap, _r5le_bs, _r5le_x0s, 2, 0, 50);
assert_eq(_R5LE_SW_CALLS, 5, "bicgstab [[0,1],[3,0]], tol 0: the omega stop at the 5th matvec");
assert_eq(_r5le_x4, HSB_ERR_NO_CONVERGENCE,
  "bicgstab [[0,1],[3,0]], tol 0: the omega stop is reported, not NaN (3.3.3-3.3.7: (1/3, 5) to 5 ulps)");
# (5) and (6) pinned the two constants from the side the in-tree fixtures above do not
# reach, on systems from the R5le differential (A stored, A_fn = the plain row sums), through
# 3.3.7. ⚠ 3.4.0 review: neither does now. (5) recovers (below), and (6) ends in the same Err
# with or without the n (REV-LA S1: at the 115th matvec; in the scaled frame, the 101st). The
# n is pinned in modules_b.tcyr's "3.4.0 review: the Krylov frame" group, and the DBL_MIN
# condition is recorded there as verdict-equivalent, with its reason.
# (5) THE |s| GATE IS 2^-52, NOT LOOSER. G2b's matrix times 2^-984, b from 7e-22 to
# 2.8e-20 (x near 1e276), tol 1.7e-31, the orthogonal t on the 7th call: |s| / |r0| at
# the cancellation is 9e-9, between 2^-52 and 2^-26, and the half step is not the
# solution, so x is NaN; a gate of 2^-26 returns that half step. 3.3.2 returned x0;
# before the repair, NaN.
# (6) THE NOISE BOUND CARRIES THE FACTOR n. A singular system, entries near 1e110 and
# its last row zero, b near 1e-208 and inconsistent, tol 9.7e-226, 200 iterations: the
# numerator at the 115th matvec is 1.4 x 2^-52 of the term sum, inside n 2^-52, so x
# is NaN; without the n, the next pass stops at an exactly-zero r_hat . r and returns
# a finite x for a system with no solution. 3.3.2 returned x0; the tree before the
# repair, a finite x after 115 matvecs.
# [measured: R5le BiCGSTAB differential and variant runs, 3.3.2 bundle and this tree, cycc 6.6.12, 2026-10-01]
var _R5LE_M = alloc(72);
fn _r5le_m3(xp) {
    _R5LE_CALLS = _R5LE_CALLS + 1;
    var o = alloc(24);
    if (_R5LE_CALLS == _R5LE_AT) {
        store64(o, f64_neg(load64(xp + 8)));
        store64(o + 8, load64(xp));
        store64(o + 16, 0);
        return o;
    }
    for (var i = 0; i < 3; i = i + 1) {
        var acc = 0;
        for (var j = 0; j < 3; j = j + 1) {
            acc = f64_add(acc, f64_mul(load64(_R5LE_M + (i * 3 + j) * 8), load64(xp + j * 8)));
        }
        store64(o + i * 8, acc);
    }
    return o;
}
fn _r5le_v3(a, b, c) {
    var v = alloc(24);
    store64(v, a);
    store64(v + 8, b);
    store64(v + 16, c);
    return v;
}
fn _r5le_setm(a00, a01, a02, a10, a11, a12, a20, a21, a22) {
    store64(_R5LE_M, a00); store64(_R5LE_M + 8, a01); store64(_R5LE_M + 16, a02);
    store64(_R5LE_M + 24, a10); store64(_R5LE_M + 32, a11); store64(_R5LE_M + 40, a12);
    store64(_R5LE_M + 48, a20); store64(_R5LE_M + 56, a21); store64(_R5LE_M + 64, a22);
    return 0;
}
_r5le_setm(0x0290000000000000, 0x0270000000000000, 0, 0x0270000000000000, 0x0288000000000000,
  0x0270000000000000, 0, 0x0270000000000000, 0x0280000000000000);
var _r5le_b5 = _r5le_v3(0x3B89FBE76C8B4398, 0x3BAFC6A7EF9DB228, 0x3BE06E978D4FDF3B);
_R5LE_CALLS = 0;
_R5LE_AT = 7;
var _r5le_x5t, _r5le_x5 = solve_bicgstab_checked(&_r5le_m3, _r5le_b5, _bicg_x0, 3, 0x398B7CDFD9D7BDBB, 50);
_R5LE_AT = 0 - 1;
# 3.4.0 review: the |s| gate this fixture pinned is gone (3.4.0). The 7th call is still a
# t = A s (the probe takes the place of 3.3.7's A x0, which x0 = 0 no longer spends), and the
# orthogonal t there is a breakdown, reported. 3.3.3-3.3.7: NaN; a 2^-26 gate, a wrong half step.
assert_eq(_R5LE_CALLS, 7, "bicgstab, an orthogonal t at call 7: stops there");
assert_eq(_r5le_x5, HSB_ERR_NO_CONVERGENCE, "bicgstab, an orthogonal t at call 7: NO_CONVERGENCE (3.3.3-3.3.7: NaN)");
# The same vector injected at call 6, an A p: nothing breaks down, but BiCGSTAB's recurrence
# residual drifts from b - A x. The true-residual confirmation refuses it and restarts, and the
# run returns the exact solution, correctly rounded (Fractions), after 41 matvecs (19 without
# the injection).
# [measured: LA2 probes k3 and r5 + exact Fractions solve, cycc 6.7.9, 2026-10-31]
_R5LE_CALLS = 0;
_R5LE_AT = 6;
var _r5le_x5bt, _r5le_x5b = solve_bicgstab_checked(&_r5le_m3, _r5le_b5, _bicg_x0, 3, 0x398B7CDFD9D7BDBB, 50);
_R5LE_AT = 0 - 1;
assert_eq(_R5LE_CALLS, 41, "bicgstab, an orthogonal vector injected as A p at call 6: recovers, 41 matvecs");
assert_eq(is_ok(_r5le_x5bt), 1, "bicgstab, injected A p: Ok on the true residual");
assert_eq(load64(_r5le_x5b), 0x7919C28F5C28F5C3, "bicgstab, injected A p: x[0] is the exact solution, rounded");
assert_eq(load64(_r5le_x5b + 8), 0xF93683126E978D50, "bicgstab, injected A p: x[1] is the exact solution, rounded");
assert_eq(load64(_r5le_x5b + 16), 0x79533EF9DB22D0E5, "bicgstab, injected A p: x[2] is the exact solution, rounded");
_r5le_setm(0xD6F0AD1B81E399D0, 0xD6B805C41C80A300, 0xD67B50E876FE1000, 0x56E9F8846C8735A0, 0x571034912B0EC4FC,
  0xD71E002BD6D772B0, 0, 0, 0);
_R5LE_CALLS = 0;
var _r5le_x6t, _r5le_x6 = solve_bicgstab_checked(&_r5le_m3, _r5le_v3(0x94BDF299C4BFD975, 0x14B3662EDF63CBA7,
    0x94BC83D06697750C),
  _bicg_x0, 3, 0x11370EF54646D497, 200);
assert_eq(_r5le_x6, HSB_ERR_NO_CONVERGENCE,
  "bicgstab, singular, cancellation within n 2^-52: NO_CONVERGENCE (3.3.3-3.3.7: NaN; 3.3.7 without n, a finite x)");
assert_eq(_R5LE_CALLS, 101, "bicgstab, singular, cancellation within n 2^-52: the 101st matvec");

# === 3.3.4 krylov: solve_bicgstab, a t whose norm overflows ===
# When some |t_i| is near DBL_MAX, |t| = sqrt(sum t_i^2) passes it although every t_i is
# finite. The rescue divided by that +Inf, every term (t_i / |t|) s_i was 0, omega was 0,
# and the loop stopped at the omega test with the half step, |r| = |r0|, unreported. The
# rescue now divides by the power of two at or below max|t_i| when |t| is +Inf, and goes
# on. Systems from the krylov differential, A_fn the plain row sums; oracle: the exact
# solution in Fractions. Measured on 53000 runs (43000 at scales 2^-1000..2^1000, 10000
# with A b near 2^1005..2^1030), 149 change, each finite and wrong on 3.3.3 and NaN on
# 3.3.2: 9 are right, 135 NaN, 5 still wrong. 3.3.3's x is the tree before the repair.
# [measured: krylov BiCGSTAB differentials, 3.3.4 tree before and after, cycc 6.6.14, 2026-10-03]
_r5le_setm(0xD94A87A57F197462, 0x58F967921DE73A80, 0xD9377A2A4E1476FC, 0x58EDE3C824AE8B00, 0xD93BE13D4519E5F8,
  0x59418CD8F0581632, 0x59342A712F5F4964, 0xD9107662B81096A0, 0xD923919DAAEC0A98);
_R5LE_CALLS = 0;
# 3.4.0: tol is relative; the 3.3.4 absolute 0x64B12E0BE826D695 over ||b||
var _k4b_b1 = _r5le_v3(0xE64FC6E4FAA12CE0, 0x6656E94779C370E0, 0xE6838333B5CE8A96);
var _k4b_x1t, _k4b_x1 = solve_bicgstab_checked(&_r5le_m3, _k4b_b1,
  _bicg_x0, 3, f64_div(0x64B12E0BE826D695, _lext_norm(_k4b_b1, 3)), 200);
assert_eq(is_ok(_k4b_x1t), 1, "bicgstab, |t| past DBL_MAX: Ok");
# (3.4.0 review: one matvec more, the true residual that confirms it; the run is in the scaled
# frame, and the bits are 0 / 2 / 3 ulp from the exact solution below, where 3.4.0's first tree
# gave 1 / 1 / 2)
# [measured: these bits against the Cramer solve in python3 fractions, LA2, cycc 6.7.9, 2026-10-31]
assert_eq(_R5LE_CALLS, 7, "bicgstab, |t| past DBL_MAX: converges after 7 matvecs (3.3.3: stopped at 3)");
assert_eq(load64(_k4b_x1), 0xCD24F893EBFA321D, "bicgstab, |t| past DBL_MAX: x0 bits (3.3.3: +1.7e63, the half step)");
assert_eq(load64(_k4b_x1 + 8), 0x4D402E1E14AECD33, "bicgstab, |t| past DBL_MAX: x1 bits");
assert_eq(load64(_k4b_x1 + 16), 0x4D3C97E8EBFC2C9E, "bicgstab, |t| past DBL_MAX: x2 bits");
var _k4b_xs = _r5le_v3(0xCD24F893EBFA321D, 0x4D402E1E14AECD31, 0x4D3C97E8EBFC2C9B);   # exact x, rounded
for (var _k4b_i = 0; _k4b_i < 3; _k4b_i = _k4b_i + 1) {
    var _k4b_ref = load64(_k4b_xs + _k4b_i * 8);
    var _k4b_err = f64_abs(f64_sub(load64(_k4b_x1 + _k4b_i * 8), _k4b_ref));
    assert_eq(f64_lt(_k4b_err, f64_mul(f64_abs(_k4b_ref), TOL_1EM14)), 1,
      "bicgstab, |t| past DBL_MAX: x == the exact solution to 1e-14 relative");
}
# G2b's matrix times 2^662, b near 2^357, tol 0: 3.3.3 stopped at the third matvec with
# x = (0, 0, 0); the iteration now goes on, A p overflows, and x comes back NaN, the loud
# answer 3.3.2 gave. The system is well-conditioned and solvable, x* = (-8.62e-92,
# 5.27e-91, 2.66e-91), all normal (exact Fractions solve, rounded), but reaching it needs
# A p out of range. NaN is therefore not pinned as the answer: x must be NaN or x* to
# 1e-9 relative, never finite and wrong.
# [measured: exact Fractions solve of the scaled system and the 3.3.4 tree, cycc 6.6.14, 2026-10-03]
_r5le_setm(0x6950000000000000, 0x6930000000000000, 0, 0x6930000000000000, 0x6948000000000000,
  0x6930000000000000, 0, 0x6930000000000000, 0x6940000000000000);
_R5LE_CALLS = 0;
var _k4b_x2t, _k4b_x2 = solve_bicgstab_checked(&_r5le_m3, _r5le_v3(0x5657C0A31F92F5DC, 0x568CB0D38BD064D6,
    0x56813F4CBB5C171A),
  _bicg_x0, 3, 0, 200);
var _k4b_xs2 = _r5le_v3(0xAD067AA05CEB6B79, 0x2D312D78F65A7334, 0x2D215120805DBB00);   # x*, rounded
# 3.4.0: an Err (3.3.4-3.3.7: x NaN), or Ok with x* to 1e-9; never Ok and wrong
var _k4b_okc = 0;
if (is_err_result(_k4b_x2t) == 1) { _k4b_okc = 3; }
for (var _k4b_j = 0; _k4b_j < 3 && is_ok(_k4b_x2t) == 1; _k4b_j = _k4b_j + 1) {
    var _k4b_xj = load64(_k4b_x2 + _k4b_j * 8);
    var _k4b_rj = load64(_k4b_xs2 + _k4b_j * 8);
    if (f64_lt(f64_abs(f64_sub(_k4b_xj, _k4b_rj)), f64_mul(f64_abs(_k4b_rj), 0x3E112E0BE826D695)) == 1) {
        _k4b_okc = _k4b_okc + 1;
    }
}
assert_eq(_k4b_okc, 3,
  "bicgstab, |t| past DBL_MAX, A p then out of range: Err, or x* to 1e-9, never Ok and wrong (3.3.3: 0)");

# ================================================================
# linalg_precision — first coverage (module shipped untested through 2.6.12)
# ================================================================
# Both headline routines were broken and neither had a single assertion:
#   svd_golub_kahan composed the left Householder reflectors in FORWARD order,
#     yielding U transposed, so A != U*S*Vt (S and Vt were correct).
#   eigen_qr applied the similarity G^T T G instead of G T G^T — the transpose of
#     the rotation that zeroes the bulge — so it NEVER converged for n >= 3
#     (measured: HSB_ERR_NO_CONVERGENCE on a plain symmetric 3x3 at 100k iters)
#     and paired the wrong eigenvector with each eigenvalue at n = 2.
# These assert the defining identities, so neither failure mode can return.
# [measured: CHANGELOG.md 2.6.13, the eigen_qr non-convergence entry (a symmetric 3x3 even at max_iter = 100000)]

fn _lp_check_svd(A, m, n, U, S, Vt, label) {
    var bad = 0;
    var i = 0;
    while (i < m) {
        var j = 0;
        while (j < n) {
            var acc = f64_from(0);
            var k = 0;
            while (k < n) {
                acc = f64_add(acc, f64_mul(f64_mul(ganita_mat_get(U, i, k), load64(S + k * 8)),
                    ganita_mat_get(Vt, k, j)));
                k = k + 1;
            }
            if (f64_approx_eq(acc, ganita_mat_get(A, i, j), LOOSE_TOL_H) == 0) { bad = bad + 1; }
            j = j + 1;
        }
        i = i + 1;
    }
    assert_eq(bad, 0, label);
    return 0;
}

fn _lp_check_eig(A, n, vals, V, label) {
    var bad = 0;
    var c = 0;
    while (c < n) {
        var lam = load64(vals + c * 8);
        var i = 0;
        while (i < n) {
            var av = f64_from(0);
            var k = 0;
            while (k < n) {
                av = f64_add(av, f64_mul(ganita_mat_get(A, i, k), ganita_mat_get(V, k, c)));
                k = k + 1;
            }
            if (f64_approx_eq(av, f64_mul(lam, ganita_mat_get(V, i, c)), LOOSE_TOL_H) == 0) {
                bad = bad + 1;
            }
            i = i + 1;
        }
        c = c + 1;
    }
    assert_eq(bad, 0, label);
    return 0;
}

test_group("optimize / linalg_ext: allocation and dimension guards");
# opt_bfgs allocates an n x n inverse Hessian; opt_lbfgs an m*(2n+1) history ring.
# Neither bounded its dimensions through 2.6.13, so a large n made alloc return 0
# and the initialisation loop stored through null (CWE-190 -> CWE-476).
var _rq69t, _rq69v = opt_bfgs(0, 0, 0, 100000, 0, 10, 0, 0);
assert_eq(is_err_result(_rq69t), 1, "opt_bfgs: n over _OPT_MAX_DIM -> INVALID_INPUT (no null store)");
assert_eq(_rq69v, HSB_ERR_INVALID_INPUT, "opt_bfgs: n over _OPT_MAX_DIM -> INVALID_INPUT (no null store)");
var _rq70t, _rq70v = opt_lbfgs(0, 0, 0, 100000, 5, 0, 10, 0, 0);
assert_eq(is_err_result(_rq70t), 1, "opt_lbfgs: n over _OPT_MAX_DIM -> INVALID_INPUT");
assert_eq(_rq70v, HSB_ERR_INVALID_INPUT, "opt_lbfgs: n over _OPT_MAX_DIM -> INVALID_INPUT");
var _rq71t, _rq71v = opt_bfgs(0, 0, 0, 0, 0, 10, 0, 0);
assert_eq(is_err_result(_rq71t), 1, "opt_bfgs: n=0 -> INVALID_INPUT");
assert_eq(_rq71v, HSB_ERR_INVALID_INPUT, "opt_bfgs: n=0 -> INVALID_INPUT");
# cmat_inverse builds an augmented [M | I], doubling the width, so an input under
# the cap can push the augmented matrix over it — cmat_new returns 0 and that was
# stored through.
var _ci = cmat_new(250, 250);
assert_neq(_ci, 0, "cmat_new(250,250) = 62500 is under the cap");
assert_eq(cmat_inverse(_ci), 0, "cmat_inverse: augmented 250x500 over cap -> 0 (no segv)");

test_group("linalg_precision: svd_golub_kahan A == U*S*Vt");
var lps_A = ganita_mat_new(3, 3);
ganita_mat_set(lps_A, 0, 0, F64_ONE); ganita_mat_set(lps_A, 0, 1, F64_TWO); ganita_mat_set(lps_A, 0, 2, f64_from(3));
ganita_mat_set(lps_A, 1, 0, f64_from(4)); ganita_mat_set(lps_A, 1, 1, f64_from(5));
ganita_mat_set(lps_A, 1, 2, f64_from(6));
ganita_mat_set(lps_A, 2, 0, f64_from(7)); ganita_mat_set(lps_A, 2, 1, f64_from(8));
ganita_mat_set(lps_A, 2, 2, f64_from(10));
var lps_U = ganita_mat_new(3, 3);
var lps_Vt = ganita_mat_new(3, 3);
var lps_S = alloc(24);
var _rq72t, _rq72v = svd_golub_kahan(lps_A, lps_U, lps_S, lps_Vt);
assert_eq(is_ok(_rq72t), 1, "svd returns HSB_ERR_NONE");
_lp_check_svd(lps_A, 3, 3, lps_U, lps_S, lps_Vt, "svd: A == U*S*Vt (non-symmetric 3x3)");
assert(f64_ge(load64(lps_S), load64(lps_S + 8)) == 1, "svd: S sorted descending (0>=1)");
assert(f64_ge(load64(lps_S + 8), load64(lps_S + 16)) == 1, "svd: S sorted descending (1>=2)");
assert(f64_ge(load64(lps_S + 16), 0) == 1, "svd: singular values non-negative");

test_group("linalg_precision: eigen_qr A*v == lambda*v");
var lpe_A2 = ganita_mat_new(2, 2);
ganita_mat_set(lpe_A2, 0, 0, F64_TWO); ganita_mat_set(lpe_A2, 0, 1, F64_ONE);
ganita_mat_set(lpe_A2, 1, 0, F64_ONE); ganita_mat_set(lpe_A2, 1, 1, F64_TWO);
var lpe_v2 = alloc(16);
var lpe_V2 = ganita_mat_new(2, 2);
var _rq73t, _rq73v = eigen_qr(lpe_A2, 2, 1000, lpe_v2, lpe_V2);
assert_eq(is_ok(_rq73t), 1, "eigen_qr 2x2 converges");
assert(f64_approx_eq(load64(lpe_v2), f64_from(3), LOOSE_TOL_H) == 1, "eigen_qr 2x2 lambda0=3");
assert(f64_approx_eq(load64(lpe_v2 + 8), F64_ONE, LOOSE_TOL_H) == 1, "eigen_qr 2x2 lambda1=1");
_lp_check_eig(lpe_A2, 2, lpe_v2, lpe_V2, "eigen_qr 2x2: A*v == lambda*v (pairing)");

var lpe_A3 = ganita_mat_new(3, 3);
ganita_mat_set(lpe_A3, 0, 0, f64_from(4)); ganita_mat_set(lpe_A3, 0, 1, F64_ONE);     ganita_mat_set(lpe_A3, 0, 2, 0);
ganita_mat_set(lpe_A3, 1, 0, F64_ONE); ganita_mat_set(lpe_A3, 1, 1, f64_from(3)); ganita_mat_set(lpe_A3, 1, 2, F64_ONE);
ganita_mat_set(lpe_A3, 2, 0, 0); ganita_mat_set(lpe_A3, 2, 1, F64_ONE); ganita_mat_set(lpe_A3, 2, 2, F64_TWO);
var lpe_v3 = alloc(24);
var lpe_V3 = ganita_mat_new(3, 3);
var _rq74t, _rq74v = eigen_qr(lpe_A3, 3, 10000, lpe_v3, lpe_V3);
assert_eq(is_ok(_rq74t), 1, "eigen_qr 3x3 CONVERGES (was NO_CONVERGENCE at any iteration count)");
# 2 + 2*cos(pi/4) = 4.732050807568877, 3, 2 - 2*cos(pi/4) = 1.2679491924311228
assert(f64_approx_eq(load64(lpe_v3), 0x4012ED9EBA16132A, LOOSE_TOL_H) == 1,
  "eigen_qr 3x3 lambda0 = 4.732050807568877");
assert(f64_approx_eq(load64(lpe_v3 + 8), f64_from(3), LOOSE_TOL_H) == 1, "eigen_qr 3x3 lambda1 = 3");
assert(f64_approx_eq(load64(lpe_v3 + 16), 0x3FF4498517A7B356, LOOSE_TOL_H) == 1,
  "eigen_qr 3x3 lambda2 = 1.2679491924311228");
_lp_check_eig(lpe_A3, 3, lpe_v3, lpe_V3, "eigen_qr 3x3: A*v == lambda*v");

# Inertia sphere: I = (2/5)*m*r^2 on diagonal
var isph = inertia_sphere(f64_from(10), F64_ONE);
# I = (2/5)*10*1 = 4
assert_eq(ganita_mat_get(isph, 0, 0), f64_from(4), "inertia sphere diag");
assert_eq(ganita_mat_get(isph, 0, 1), f64_from(0), "inertia sphere off-diag");

# Eigen power: dominant eigenvalue of [[2,0],[0,1]] = 2
var epm = ganita_mat_new(2, 2);
ganita_mat_set(epm, 0, 0, f64_from(2));
ganita_mat_set(epm, 1, 1, F64_ONE);
var ep_val = alloc(8);
var ep_vec = alloc(16);
# Through 2.6.15: A = diag(2,1) with round(val) == 2, i.e. anything in [1.5,2.5)
# passed -- and e_0 is ALREADY the exact eigenvector of diag(2,1), so the iteration
# never had to do anything. The eigenvector output was never read.
#
# A = [[2,1],[1,3]]. char poly lambda^2 - 5 lambda + 5 = 0  =>  lambda = (5 +- sqrt5)/2.
#   lambda_1 = (5 + sqrt5)/2 = 3.618033988749895   (= phi + 2)
# From (2 - lambda_1) x + y = 0, y = (lambda_1 - 2) x = phi x, so the eigenvector
# scaled to max-|component| = 1 (this routine's normalization) is
#   v = (1/phi, 1) = (0.6180339887498949, 1).
# Convergence ratio |lambda_2/lambda_1| = 0.381966, so 1000 iterations is ample.
var epm = ganita_mat_new(2, 2);
ganita_mat_set(epm, 0, 0, F64_TWO);   ganita_mat_set(epm, 0, 1, F64_ONE);
ganita_mat_set(epm, 1, 0, F64_ONE);   ganita_mat_set(epm, 1, 1, f64_from(3));
var ep_val = alloc(8);
var ep_vec = alloc(16);
var ep_rc_t, ep_rc_v = eigen_power(epm, 2, 1000, ep_val, ep_vec);
assert_eq(is_ok(ep_rc_t), 1, "eigen_power ok");
var EP_TOL = 0x3DA5FD7FE1796495;   # 1e-11
# ⛔ 3.3.3 — THIS SAID "measured error is 2.5e-13", AND NO RUN GIVES THAT. Against the
# closed forms, this fixture's lambda is off by 1.05e-12 and v[0] by 4.0e-13 (3.3.2:
# 1.69e-12 and 6.5e-13), and the worst of the four eigen_power fixtures that use EP_TOL
# is the 3x3's lambda, 1.65e-12 (3.3.2: 5.46e-12), so EP_TOL is 6x that. eigen_power
# stops when lambda moves less than EPSILON_F64 relative and every v_i less than
# EPSILON_F64, which is a step size, not a distance from the answer.
# [measured: scratch eigen_power probe vs exact closed forms, not reproducible in-tree, 2026-10-01; cycc 6.6.12]
# ⚠ 1/phi below is 0x3FE3C6EF372FE950, (sqrt5 - 1)/2 correctly rounded (a 50-digit
# decimal oracle); through 3.3.2 these two asserts read ...94F, one ulp low, while
# their messages quoted ...950's value. Inside EP_TOL either passes.
assert(f64_approx_eq(load64(ep_val), 0x400CF1BBCDCBFA54, EP_TOL),
  "eigen_power lambda = (5+sqrt5)/2 = 3.618033988749895");
assert(f64_approx_eq(load64(ep_vec), 0x3FE3C6EF372FE950, EP_TOL),
  "eigen_power v[0] = 1/phi = 0.6180339887498949");
assert_eq(load64(ep_vec + 8), F64_ONE, "eigen_power v[1] = 1 (max component, exact)");

# ================================================================
# 2.15.0 — linalg_ext: twelve guards, and sparsity is not a tolerance
# ================================================================
# ⛔ `csr_from_dense` decided which entries EXIST by `|A_ij| > 1e-12`, so the
# sparsity PATTERN of a matrix depended on the caller's units — the same matrix in
# millimetres and in metres became different matrices.
# ⛔ AND THE TWO PASSES DISAGREEING IS A MEMORY-SAFETY BUG, NOT A NUMERICAL ONE.
# The counting pass sizes the arrays and the emitting pass fills them, so changing
# ONE of them is not a wrong answer — it is a buffer overrun. Measured: reverting
# only the counting pass to the old test kills the suite with SIGSEGV. The two are
# now byte-identical by construction, and that mutant is the proof.
# [measured: 14-mutant run over linalg_ext.cyr, 2026-09-10]
# ⭐ The rest of the module splits the same three ways as linalg_precision:
# unbounded reciprocals get DBL_MIN (Arnoldi, back-substitution), bounded
# quotients get an exact-zero test (Givens, power iteration, PGS diagonal), and
# the two CONVERGENCE tests — which divide nothing — become relative.
# ⚠ `eigen_power` needed a paired change: lowering its threshold alone is useless
# while the loop multiplies by 1/max_val, which overflows for a subnormal max_val
# even though w_i/max_val cannot. Guard and normalisation moved together.

test_group("linalg_ext 2.15.0: sparsity, solvers and power iteration");

# --- SPARSITY IS STRUCTURAL. A = [[1,0,2],[0,3,0],[4,0,5]] has 5 stored entries
# at every scale; scaling it cannot create or destroy structure.
var LX_RUN = 0;
var LX_BAD = 0;
for (var lx_e = 0; lx_e < 400; lx_e = lx_e + 1) {
    var lx_k = (1023 - lx_e) << 52;
    var lx_d = ganita_mat_new(3, 3);
    ganita_mat_set(lx_d, 0, 0, lx_k);
    ganita_mat_set(lx_d, 0, 2, f64_mul(F64_TWO, lx_k));
    ganita_mat_set(lx_d, 1, 1, f64_mul(f64_from(3), lx_k));
    ganita_mat_set(lx_d, 2, 0, f64_mul(f64_from(4), lx_k));
    ganita_mat_set(lx_d, 2, 2, f64_mul(f64_from(5), lx_k));
    LX_RUN = LX_RUN + 1;
    if (csr_nnz(csr_from_dense(lx_d)) != 5) { LX_BAD = LX_BAD + 1; }
}
assert_eq(LX_RUN, 400, "the CSR sparsity sweep actually ran 400 scales");
assert_eq(LX_BAD, 0,
  "csr_from_dense: 5 stored entries at every scale from 2^0 down to 2^-399");
# ⭐ ANTI-DELETION: a structural zero must still not be stored.
var lx_z = ganita_mat_new(2, 2);
ganita_mat_set(lx_z, 0, 0, F64_ONE);
ganita_mat_set(lx_z, 0, 1, f64_from(0));
ganita_mat_set(lx_z, 1, 0, f64_from(0));
ganita_mat_set(lx_z, 1, 1, F64_TWO);
assert_eq(csr_nnz(csr_from_dense(lx_z)), 2,
  "csr_from_dense: exact zeros are still structurally absent");

# --- eigen_power. lambda(kA) = k*lambda(A), and the eigenVECTOR does not move at
# all. The shipped guard reported NO_CONVERGENCE for any matrix scaled below 1e-12.
var LX_EP_RUN = 0;
var LX_EP_BAD = 0;
for (var lx_p = 0; lx_p < 400; lx_p = lx_p + 1) {
    var lx_pk = (1023 - lx_p) << 52;
    var lx_pm = ganita_mat_new(2, 2);
    ganita_mat_set(lx_pm, 0, 0, f64_mul(F64_TWO, lx_pk));
    ganita_mat_set(lx_pm, 0, 1, lx_pk);
    ganita_mat_set(lx_pm, 1, 0, lx_pk);
    ganita_mat_set(lx_pm, 1, 1, f64_mul(f64_from(3), lx_pk));
    var lx_pv = alloc(8);
    var lx_pvec = alloc(16);
    LX_EP_RUN = LX_EP_RUN + 1;
    var _ri1t, _ri1v = eigen_power(lx_pm, 2, 1000, lx_pv, lx_pvec);
    if (is_err_result(_ri1t) == 1) {
        LX_EP_BAD = LX_EP_BAD + 1;
    } else {
        # (5 + sqrt 5)/2 = 3.618033988749895, scaled by k.
        if (f64_approx_eq(f64_div(load64(lx_pv), lx_pk), 0x400CF1BBCDCBFA54,
            EP_TOL) != 1) {
            LX_EP_BAD = LX_EP_BAD + 1;
        }
        # the eigenvector is scale-INVARIANT and its max component is exactly 1.
        if (load64(lx_pvec + 8) != F64_ONE) { LX_EP_BAD = LX_EP_BAD + 1; }
    }
}
assert_eq(LX_EP_RUN, 400, "the eigen_power scale sweep actually ran 400 scales");
assert_eq(LX_EP_BAD, 0,
  "eigen_power: lambda/k and the eigenvector are invariant to 2^-399");
# ⭐ ANTI-DELETION: an exactly zero matrix. Through 3.4.0's review this was NO_CONVERGENCE (no
# dominant direction the iteration could find); its spectrum is its diagonal, every eigenvalue
# 0, and every vector an eigenvector, so it is now answered exactly: 0, with e_1 (the last vertex
# in Tarjan's completion order).
var lx_z2 = ganita_mat_new(2, 2);
ganita_mat_set(lx_z2, 0, 0, f64_from(0)); ganita_mat_set(lx_z2, 0, 1, f64_from(0));
ganita_mat_set(lx_z2, 1, 0, f64_from(0)); ganita_mat_set(lx_z2, 1, 1, f64_from(0));
var lx_z2v = alloc(8);
var lx_z2e = alloc(16);
var _rq72t, _rq72v = eigen_power(lx_z2, 2, 100, lx_z2v, lx_z2e);
assert_eq(is_ok(_rq72t), 1, "eigen_power: an exactly zero matrix -> Ok, its eigenvalue 0 (3.3.7: NO_CONVERGENCE)");
assert_eq(load64(lx_z2v), 0, "eigen_power: an exactly zero matrix -> 0");
assert_eq(load64(lx_z2e + 8), F64_ONE, "eigen_power: an exactly zero matrix -> v = e_1");

# --- solve_pgs_checked. A x = b and (kA) x = (kb) have the SAME x, so the solution of
# [[4,1],[1,3]]x = [1,2] is [1/11, 7/11] at every k. Two guards are exercised: the
# diagonal test and the convergence test, the latter now relative to |x|.
var LX_PG_RUN = 0;
var LX_PG_BAD = 0;
var lx_pg_lo = alloc(16);
var lx_pg_hi = alloc(16);
store64(lx_pg_lo, f64_neg(f64_from(1000000)));
store64(lx_pg_lo + 8, f64_neg(f64_from(1000000)));
store64(lx_pg_hi, f64_from(1000000));
store64(lx_pg_hi + 8, f64_from(1000000));
for (var lx_g = 0; lx_g < 400; lx_g = lx_g + 1) {
    var lx_gk = (1023 - lx_g) << 52;
    var lx_gA = ganita_mat_new(2, 2);
    ganita_mat_set(lx_gA, 0, 0, f64_mul(f64_from(4), lx_gk));
    ganita_mat_set(lx_gA, 0, 1, lx_gk);
    ganita_mat_set(lx_gA, 1, 0, lx_gk);
    ganita_mat_set(lx_gA, 1, 1, f64_mul(f64_from(3), lx_gk));
    var lx_gb = alloc(16);
    store64(lx_gb, lx_gk);
    store64(lx_gb + 8, f64_mul(F64_TWO, lx_gk));
    var lx_gx = alloc(16);
    store64(lx_gx, 0);
    store64(lx_gx + 8, 0);
    var lx_gt, lx_gv = solve_pgs_checked(lx_gA, lx_gb, lx_gx, 2, lx_pg_lo, lx_pg_hi, 200);
    LX_PG_RUN = LX_PG_RUN + 1;
    if (is_ok(lx_gt) != 1) { LX_PG_BAD = LX_PG_BAD + 1; }
    if (f64_approx_eq(load64(lx_gx), f64_div(F64_ONE, f64_from(11)), EP_TOL) != 1) {
        LX_PG_BAD = LX_PG_BAD + 1;
    }
    if (f64_approx_eq(load64(lx_gx + 8), f64_div(f64_from(7), f64_from(11)),
        EP_TOL) != 1) {
        LX_PG_BAD = LX_PG_BAD + 1;
    }
}
assert_eq(LX_PG_RUN, 400, "the solve_pgs_checked scale sweep actually ran 400 scales");
assert_eq(LX_PG_BAD, 0,
  "solve_pgs_checked: Ok, x = [1/11, 7/11] for system scales from 2^0 down to 2^-399");

# --- cmat_inverse. inv(kM) = (1/k)*inv(M). M = [[1,0],[0,2]] gives inv = diag(1, 1/2).
var LX_CI_RUN = 0;
var LX_CI_BAD = 0;
for (var lx_ci = 0; lx_ci < 400; lx_ci = lx_ci + 1) {
    var lx_ck = (1023 - lx_ci) << 52;
    var lx_cm = cmat_new(2, 2);
    cmat_set(lx_cm, 0, 0, cx_new(lx_ck, f64_from(0)));
    cmat_set(lx_cm, 0, 1, cx_new(f64_from(0), f64_from(0)));
    cmat_set(lx_cm, 1, 0, cx_new(f64_from(0), f64_from(0)));
    cmat_set(lx_cm, 1, 1, cx_new(f64_mul(F64_TWO, lx_ck), f64_from(0)));
    var lx_cinv = cmat_inverse(lx_cm);
    LX_CI_RUN = LX_CI_RUN + 1;
    if (lx_cinv == 0) {
        LX_CI_BAD = LX_CI_BAD + 1;
    } else {
        # inv[0][0] = 1/k and inv[1][1] = 1/(2k), both exact for power-of-two k.
        if (HComplex_re(cmat_get(lx_cinv, 0, 0)) != (1023 + lx_ci) << 52) {
            LX_CI_BAD = LX_CI_BAD + 1;
        }
        if (HComplex_re(cmat_get(lx_cinv, 1, 1)) != (1023 + lx_ci - 1) << 52) {
            LX_CI_BAD = LX_CI_BAD + 1;
        }
    }
}
assert_eq(LX_CI_RUN, 400, "the cmat_inverse scale sweep actually ran 400 scales");
assert_eq(LX_CI_BAD, 0,
  "cmat_inverse: inv(kM) = (1/k)inv(M) bit-exact from 2^0 down to 2^-399");
# ⭐ ANTI-DELETION, and it is the case the DBL_MIN floor exists for: with a bare
# relative pivot test an all-zero matrix has scale 0, the threshold is 0, `0 < 0`
# is false, the guard never fires and the routine returns a zero MATRIX instead of
# the documented 0. Measured as a live behaviour, not a hypothetical.
# [measured: docs/audit/2026-09-09-epsilon-open.json]
var lx_cz = cmat_new(2, 2);
cmat_set(lx_cz, 0, 0, cx_new(f64_from(0), f64_from(0)));
cmat_set(lx_cz, 0, 1, cx_new(f64_from(0), f64_from(0)));
cmat_set(lx_cz, 1, 0, cx_new(f64_from(0), f64_from(0)));
cmat_set(lx_cz, 1, 1, cx_new(f64_from(0), f64_from(0)));
assert_eq(cmat_inverse(lx_cz), 0,
  "cmat_inverse: an all-zero matrix is still singular, not a zero matrix");

# --- csr_add: the SUM's magnitude decided whether the entry exists, so adding two
# small matrices produced a sparser matrix than adding two large ones.
var LX_CA_RUN = 0;
var LX_CA_BAD = 0;
for (var lx_a = 0; lx_a < 400; lx_a = lx_a + 1) {
    var lx_ak = (1023 - lx_a) << 52;
    var lx_m1 = ganita_mat_new(2, 2);
    var lx_m2 = ganita_mat_new(2, 2);
    ganita_mat_set(lx_m1, 0, 0, lx_ak);
    ganita_mat_set(lx_m1, 0, 1, f64_from(0));
    ganita_mat_set(lx_m1, 1, 0, f64_from(0));
    ganita_mat_set(lx_m1, 1, 1, lx_ak);
    ganita_mat_set(lx_m2, 0, 0, lx_ak);
    ganita_mat_set(lx_m2, 0, 1, f64_from(0));
    ganita_mat_set(lx_m2, 1, 0, f64_from(0));
    ganita_mat_set(lx_m2, 1, 1, lx_ak);
    LX_CA_RUN = LX_CA_RUN + 1;
    if (csr_nnz(csr_add(csr_from_dense(lx_m1), csr_from_dense(lx_m2))) != 2) {
        LX_CA_BAD = LX_CA_BAD + 1;
    }
}
assert_eq(LX_CA_RUN, 400, "the csr_add scale sweep actually ran 400 scales");
assert_eq(LX_CA_BAD, 0,
  "csr_add: the sum keeps its 2 stored entries at every scale to 2^-399");

# --- solve_pgs_checked CONVERGENCE, which the sweep above cannot reach. There A and b
# both scale, so x stays O(1) and `max_change` never gets near 1e-12. Scaling ONLY
# b makes the SOLUTION small, and an absolute convergence test then declares
# victory after one sweep and returns a wrong answer.
var LX_PC_RUN = 0;
var LX_PC_BAD = 0;
for (var lx_pc = 0; lx_pc < 200; lx_pc = lx_pc + 1) {
    var lx_pck = (1023 - lx_pc) << 52;
    var lx_pcA = ganita_mat_new(2, 2);
    ganita_mat_set(lx_pcA, 0, 0, f64_from(4));
    ganita_mat_set(lx_pcA, 0, 1, F64_ONE);
    ganita_mat_set(lx_pcA, 1, 0, F64_ONE);
    ganita_mat_set(lx_pcA, 1, 1, f64_from(3));
    var lx_pcb = alloc(16);
    store64(lx_pcb, lx_pck);
    store64(lx_pcb + 8, f64_mul(F64_TWO, lx_pck));
    var lx_pcx = alloc(16);
    store64(lx_pcx, 0);
    store64(lx_pcx + 8, 0);
    var lx_pct, lx_pcv = solve_pgs_checked(lx_pcA, lx_pcb, lx_pcx, 2, lx_pg_lo, lx_pg_hi, 200);
    LX_PC_RUN = LX_PC_RUN + 1;
    if (is_ok(lx_pct) != 1) { LX_PC_BAD = LX_PC_BAD + 1; }
    # x = k * [1/11, 7/11]; compare the RATIO, since x itself spans 200 decades.
    if (f64_approx_eq(f64_div(load64(lx_pcx), lx_pck),
        f64_div(F64_ONE, f64_from(11)), EP_TOL) != 1) {
        LX_PC_BAD = LX_PC_BAD + 1;
    }
    if (f64_approx_eq(f64_div(load64(lx_pcx + 8), lx_pck),
        f64_div(f64_from(7), f64_from(11)), EP_TOL) != 1) {
        LX_PC_BAD = LX_PC_BAD + 1;
    }
}
assert_eq(LX_PC_RUN, 200, "the solve_pgs_checked solution-scale sweep actually ran 200");
assert_eq(LX_PC_BAD, 0,
  "solve_pgs_checked: Ok, k*[1/11, 7/11] for solution scales down to 2^-199");

# --- eigen_power at a SUBNORMAL dominant value, which is the only place the
# reciprocal and the direct divide disagree. At k = 2^-1024 the eigenvalue is
# 3.618*k and 1/lambda OVERFLOWS to +Inf, so the old multiply-by-reciprocal
# poisoned the whole eigenvector while w_i/lambda would have been fine.
# ⚠ 2^-1035, NOT 2^-1024: at 2^-1024 the eigenvalue is 2.01e-308 and 1/lambda is
# 4.97e307 — still FINITE, so the reciprocal and the direct divide agree and the
# mutant survives. Overflow needs lambda < 1/DBL_MAX; measured, 2^-1035 gives
# lambda = 9.83e-312 and 1/lambda = +Inf.
# [measured: reciprocal overflow scan over subnormal scales, 2026-09-10]
var lx_sk = 0x0000008000000000;                  # 2^-1035, deeply subnormal
var lx_sm = ganita_mat_new(2, 2);
ganita_mat_set(lx_sm, 0, 0, f64_mul(F64_TWO, lx_sk));
ganita_mat_set(lx_sm, 0, 1, lx_sk);
ganita_mat_set(lx_sm, 1, 0, lx_sk);
ganita_mat_set(lx_sm, 1, 1, f64_mul(f64_from(3), lx_sk));
var lx_sv = alloc(8);
var lx_svec = alloc(16);
var _rq73t, _rq73v = eigen_power(lx_sm, 2, 1000, lx_sv, lx_svec);
assert_eq(is_ok(_rq73t), 1, "eigen_power: a subnormal dominant eigenvalue still converges");
assert_eq(load64(lx_svec + 8), F64_ONE,
  "eigen_power: and its eigenvector is finite, not poisoned by an infinite 1/lambda");

# --- solve_gmres. A x = b and (kA) x = (kb) have the same x, so the three guards
# inside — the Arnoldi norm, the Givens radius and the back-substitution pivot —
# must not notice the scale. ⚠ The back-substitution one is the worst of the
# three: when it skipped the divide it stored the UNDIVIDED numerator as the
# solution component, which is not an approximation of anything.
var LX_GM_K = F64_ONE;
fn _lx_amul(x) {
    # A = k * [[4,1],[1,3]]
    var out = alloc(16);
    store64(out, f64_mul(LX_GM_K,
        f64_add(f64_mul(f64_from(4), load64(x)), load64(x + 8))));
    store64(out + 8, f64_mul(LX_GM_K,
        f64_add(load64(x), f64_mul(f64_from(3), load64(x + 8)))));
    return out;
}
var LX_GM_RUN = 0;
var LX_GM_BAD = 0;
for (var lx_gm = 0; lx_gm < 300; lx_gm = lx_gm + 1) {
    LX_GM_K = (1023 - lx_gm) << 52;
    var lx_gmb = alloc(16);
    store64(lx_gmb, LX_GM_K);
    store64(lx_gmb + 8, f64_mul(F64_TWO, LX_GM_K));
    var lx_gm0 = alloc(16);
    store64(lx_gm0, 0);
    store64(lx_gm0 + 8, 0);
    # 3.4.0: tol is RELATIVE to ||b||, so the same tol serves every scale.
    var lx_gmt, lx_gmx = solve_gmres_checked(&_lx_amul, lx_gmb, lx_gm0, 2, EP_TOL, 50, 2);
    LX_GM_RUN = LX_GM_RUN + 1;
    if (is_err_result(lx_gmt) == 1) {
        LX_GM_BAD = LX_GM_BAD + 1;
    } else {
        if (f64_approx_eq(load64(lx_gmx), f64_div(F64_ONE, f64_from(11)),
            EP_TOL) != 1) { LX_GM_BAD = LX_GM_BAD + 1; }
        if (f64_approx_eq(load64(lx_gmx + 8), f64_div(f64_from(7), f64_from(11)),
            EP_TOL) != 1) { LX_GM_BAD = LX_GM_BAD + 1; }
    }
}
LX_GM_K = F64_ONE;
assert_eq(LX_GM_RUN, 300, "the solve_gmres scale sweep actually ran 300 scales");
assert_eq(LX_GM_BAD, 0,
  "solve_gmres: x = [1/11, 7/11] for system scales from 2^0 down to 2^-299");

# --- lyapunov_max. For A = k*R with R a rotation, every step grows the dominant
# direction by exactly k, so the exponent is ln(k) — and the samples must all be
# COUNTED. The absolute 1e-12 silently dropped every contraction step below that,
# biasing the average toward whatever survived.
var LX_LY_RUN = 0;
var LX_LY_BAD = 0;
for (var lx_ly = 0; lx_ly < 200; lx_ly = lx_ly + 1) {
    var lx_lyk = (1023 - lx_ly) << 52;
    var lx_lyA = ganita_mat_new(2, 2);
    ganita_mat_set(lx_lyA, 0, 0, f64_from(0));
    ganita_mat_set(lx_lyA, 0, 1, f64_neg(lx_lyk));
    ganita_mat_set(lx_lyA, 1, 0, lx_lyk);
    ganita_mat_set(lx_lyA, 1, 1, f64_from(0));
    var lx_lyo = alloc(8);
    LX_LY_RUN = LX_LY_RUN + 1;
    var _ri2t, _ri2v = lyapunov_max(lx_lyA, 2, 20, lx_lyo);
    if (is_err_result(_ri2t) == 1) {
        LX_LY_BAD = LX_LY_BAD + 1;
    } else {
        # ln(2^-e) = -e*ln2, exactly the growth of a scaled rotation.
        if (f64_approx_eq(load64(lx_lyo),
            f64_mul(f64_neg(f64_from(lx_ly)), f64_ln(F64_TWO)), EP_TOL) != 1) {
            LX_LY_BAD = LX_LY_BAD + 1;
        }
    }
}
assert_eq(LX_LY_RUN, 200, "the lyapunov_max scale sweep actually ran 200 scales");
assert_eq(LX_LY_BAD, 0,
  "lyapunov_max: the exponent of a scaled rotation is ln(k) down to 2^-199");
# Residual ||A v - lambda v||_inf, recomputed from the two outputs.
assert(f64_lt(f64_abs(f64_sub(f64_add(f64_mul(F64_TWO, load64(ep_vec)), load64(ep_vec + 8)),
        f64_mul(load64(ep_val), load64(ep_vec)))), EP_TOL) == 1, "eigen_power residual row 0");
assert(f64_lt(f64_abs(f64_sub(f64_add(load64(ep_vec), f64_mul(f64_from(3), load64(ep_vec + 8))),
        f64_mul(load64(ep_val), load64(ep_vec + 8)))), EP_TOL) == 1, "eigen_power residual row 1");

# 3x3 with a degenerate trailing spectrum: A = 3I + J (J = all ones).
# J has eigenvalues (3,0,0), so A has (6,3,3): lambda_1 = 6, v = (1,1,1).
var ep3 = ganita_mat_new(3, 3);
for (var ep3i = 0; ep3i < 3; ep3i = ep3i + 1) {
    for (var ep3j = 0; ep3j < 3; ep3j = ep3j + 1) {
        if (ep3i == ep3j) { ganita_mat_set(ep3, ep3i, ep3j, f64_from(4)); }
        else { ganita_mat_set(ep3, ep3i, ep3j, F64_ONE); }
    }
}
var ep3_val = alloc(8);
var ep3_vec = alloc(24);
var _rq74t, _rq74v = eigen_power(ep3, 3, 1000, ep3_val, ep3_vec);
assert_eq(is_ok(_rq74t), 1, "eigen_power 3x3 ok");
assert(f64_approx_eq(load64(ep3_val), f64_from(6), EP_TOL), "eigen_power 3x3 lambda = 6");
assert(f64_approx_eq(load64(ep3_vec), F64_ONE, EP_TOL), "eigen_power 3x3 v[0] = 1");
assert(f64_approx_eq(load64(ep3_vec + 8), F64_ONE, EP_TOL), "eigen_power 3x3 v[1] = 1");
assert(f64_approx_eq(load64(ep3_vec + 16), F64_ONE, EP_TOL), "eigen_power 3x3 v[2] = 1");
# GAP 1: both matrices above are SYMMETRIC, so ganita_mat_get(A,i,j) -> ganita_mat_get(A,j,i)
# (power iteration on A^T, i.e. the LEFT eigenvector) is invisible to them.
# A = [[1,2],[3,4]]: lambda_1 = (5+sqrt33)/2 = 5.372281323269014.
#   right dominant eigenvector (max-component normalized) = (0.4574271077563381, 1)
#   LEFT  dominant eigenvector (what a transposed matvec yields) = (0.6861406616345072, 1)
var epn = ganita_mat_new(2, 2);
ganita_mat_set(epn, 0, 0, F64_ONE);       ganita_mat_set(epn, 0, 1, F64_TWO);
ganita_mat_set(epn, 1, 0, f64_from(3));   ganita_mat_set(epn, 1, 1, f64_from(4));
var epn_val = alloc(8);
var epn_vec = alloc(16);
var _rq75t, _rq75v = eigen_power(epn, 2, 1000, epn_val, epn_vec);
assert_eq(is_ok(_rq75t), 1, "eigen_power nonsym ok");
assert(f64_approx_eq(load64(epn_val), 0x40157D3750B16878, EP_TOL),
  "eigen_power nonsym lambda = (5+sqrt33)/2 = 5.372281323269014");
assert(f64_approx_eq(load64(epn_vec), 0x3FDD467C59078280, EP_TOL),
  "eigen_power nonsym v[0] = 0.4574271077563381 (NOT the left eigenvector 0.6861406616)");
assert(f64_approx_eq(load64(epn_vec + 8), F64_ONE, EP_TOL), "eigen_power nonsym v[1] = 1");

# GAP 2: both matrices above have a POSITIVE dominant eigenvalue and a positive
# eigenvector, so max_val = wi -> max_val = f64_abs(wi) is invisible.
# B = [[-3,1],[1,-2]]: lambda_1 = -(5+sqrt5)/2 = -3.618033988749895, v = (1, -1/phi).
var epb = ganita_mat_new(2, 2);
ganita_mat_set(epb, 0, 0, f64_neg(f64_from(3)));   ganita_mat_set(epb, 0, 1, F64_ONE);
ganita_mat_set(epb, 1, 0, F64_ONE);                ganita_mat_set(epb, 1, 1, f64_neg(F64_TWO));
var epb_val = alloc(8);
var epb_vec = alloc(16);
var _rq76t, _rq76v = eigen_power(epb, 2, 1000, epb_val, epb_vec);
assert_eq(is_ok(_rq76t), 1, "eigen_power negdom ok");
assert(f64_approx_eq(load64(epb_val), 0xC00CF1BBCDCBFA54, EP_TOL),
  "eigen_power negdom lambda = -3.618033988749895 (sign must survive)");
assert(f64_approx_eq(load64(epb_vec), F64_ONE, EP_TOL), "eigen_power negdom v[0] = 1");
assert(f64_approx_eq(load64(epb_vec + 8), 0xBFE3C6EF372FE950, EP_TOL),
  "eigen_power negdom v[1] = -1/phi (correctly rounded; was ...94F through 3.3.2)");

# PGS: solve [[4,1],[1,3]]*x = [1,2] with no bounds
var pgs_A = ganita_mat_new(2, 2);
ganita_mat_set(pgs_A, 0, 0, f64_from(4)); ganita_mat_set(pgs_A, 0, 1, F64_ONE);
ganita_mat_set(pgs_A, 1, 0, F64_ONE); ganita_mat_set(pgs_A, 1, 1, f64_from(3));
var pgs_b = alloc(16);
store64(pgs_b, F64_ONE); store64(pgs_b + 8, F64_TWO);
var pgs_x = alloc(16);
store64(pgs_x, 0); store64(pgs_x + 8, 0);
var big = f64_from(1000000);
var pgs_lo = alloc(16); store64(pgs_lo, f64_neg(big)); store64(pgs_lo + 8, f64_neg(big));
var pgs_hi = alloc(16); store64(pgs_hi, big); store64(pgs_hi + 8, big);
var _pgs1t, _pgs1v = solve_pgs_checked(pgs_A, pgs_b, pgs_x, 2, pgs_lo, pgs_hi, 100);
assert_eq(is_ok(_pgs1t), 1, "solve_pgs_checked: [[4,1],[1,3]] x = [1,2] -> Ok");
# Exact solution of [[4,1],[1,3]]x=[1,2]: x = [1/11, 7/11] ≈ [0.0909, 0.6364].
# ⭐ 2.13.0 — ASSERT THE EXACT SOLUTION THE COMMENT ABOVE ALREADY NAMES. These
# read `f64_to(f64_mul(x, f64_from(1000))) == 90` and `== 636`, i.e. they checked
# x0 against **0.090** and x1 against **0.636** with a ±0.001 truncation window —
# while the line above and their own messages both say the answer is 1/11 and
# 7/11, which are 0.090909… and 0.636363…. The assertion was a tenth of a percent
# away from the value it claimed to be testing, and the truncation absorbed it.
# Now compared against the exact rationals, so the solver is pinned to the answer
# rather than to a rounded transcription of it.
assert_f64_eq(load64(pgs_x), f64_div(F64_ONE, f64_from(11)), "pgs x0 = 1/11");
assert_f64_eq(load64(pgs_x + 8), f64_div(f64_from(7), f64_from(11)), "pgs x1 = 7/11");

# Bounds-active LCP: diag(1,1)·x = [5,5] clamped to hi=[2,2] → x = [2,2].
var pgs2_A = ganita_mat_new(2, 2);
ganita_mat_set(pgs2_A, 0, 0, F64_ONE);
ganita_mat_set(pgs2_A, 1, 1, F64_ONE);
var pgs2_b = alloc(16);
store64(pgs2_b, f64_from(5));
store64(pgs2_b + 8, f64_from(5));
var pgs2_x = alloc(16);
store64(pgs2_x, 0);
store64(pgs2_x + 8, 0);
var pgs2_lo = alloc(16);
store64(pgs2_lo, 0);
store64(pgs2_lo + 8, 0);
var pgs2_hi = alloc(16);
store64(pgs2_hi, F64_TWO);
store64(pgs2_hi + 8, F64_TWO);
var _pgs2t, _pgs2v = solve_pgs_checked(pgs2_A, pgs2_b, pgs2_x, 2, pgs2_lo, pgs2_hi, 100);
assert_eq(is_ok(_pgs2t), 1, "solve_pgs_checked: the bounds-active LCP -> Ok");
assert_eq(load64(pgs2_x), f64_from(2), "pgs bounded x0 clamped to hi=2");
assert_eq(load64(pgs2_x + 8), f64_from(2), "pgs bounded x1 clamped to hi=2");

# mat_new_guarded (2.5.3) — CWE-190 overflow guard for the real-matrix constructor.
# Stdlib mat_new gained its own guard upstream in ganita 1.0.4 (cyrius 6.5.6 pin,
# hisab 2.6.11) at a 33554430-element ceiling; this wrapper is retained because it
# enforces the tighter 16M cap, which is what the over-cap assertion below pins —
# mat_new_guarded(5000, 5000) is 25M elements: rejected here, accepted upstream.
# The upstream contract itself is pinned in tests/edge_cases.tcyr.
assert_eq(mat_new_guarded(100000, 100000), 0, "mat_new_guarded: huge dims rejected (overflow)");
assert_eq(mat_new_guarded(0, 5), 0, "mat_new_guarded: non-positive rows rejected");
assert_eq(mat_new_guarded(5000, 5000), 0, "mat_new_guarded: over-cap (25M elems) rejected");
assert_neq(mat_new_guarded(3, 3), 0, "mat_new_guarded: valid dims allocate");

# ================================================================
# Complex
# ================================================================
test_group("complex");

var ca = cx_new(f64_from(3), f64_from(4));
assert_eq(cx_abs(ca), f64_from(5), "abs(3+4i)");

var cb = cx_new(f64_from(1), f64_from(2));
var cc = cx_mul(ca, cb);
# (3+4i)(1+2i) = 3+6i+4i+8i² = 3+10i-8 = -5+10i
assert_eq(HComplex_re(cc), f64_neg(f64_from(5)), "mul.re");
assert_eq(HComplex_im(cc), f64_from(10), "mul.im");

var cconj = cx_conj(ca);
assert_eq(HComplex_im(cconj), f64_neg(f64_from(4)), "conj.im");

# e^(iπ) + 1 ≈ 0
var eipi = cx_exp(cx_new(0, F64_PI));
var euler = cx_add(eipi, cx_one());
# e^(i*pi_d) = cos(pi_d) + i sin(pi_d) with pi_d the double nearest pi:
# cos(pi_d) rounds to exactly -1.0 and sin(pi_d) = 1.2246467991473532e-16, so the
# closed-form modulus is 1.2246e-16 (measured: identical). The old bound of 1.0
# passed for any argument within about +-60 deg of pi.
# Bit-exact at that closed form: 0x3CA1A62633145C07 is sin(pi_d) correctly rounded.
# [measured: scratch Decimal oracle (80 digits), not reproducible in-tree, 2026-10-11]
assert_eq(cx_abs(euler), 0x3CA1A62633145C07, "euler |e^(i*pi)+1| == sin(pi_d) = 1.2246467991473532e-16, bit-exact");
# e^(i*pi)+1 == 0 is BLIND to conjugation: pi is a fixed point of z -> conj(z), so
# negating the imaginary output of cx_exp leaves this bit-identical (verified: such
# a mutant passes all four suites). Pin a point where the two differ.
# e^(i*pi/2) = 6.123233995736766e-17 + 1i
# Both parts bit-exact: 0x3C91A62633145C07 is cos(fl(pi/2)) correctly rounded, and
# sin(fl(pi/2)) rounds to 1. The 1e-15 test this replaced read the real part as 0.
# [measured: scratch Decimal oracle (80 digits), not reproducible in-tree, 2026-10-11]
var _e_ih = cx_exp(cx_new(0, F64_PI_2));
assert_eq(HComplex_re(_e_ih), 0x3C91A62633145C07, "cx_exp(i*pi/2).re == cos(fl(pi/2)), bit-exact");
assert_eq(HComplex_im(_e_ih), F64_ONE, "cx_exp(i*pi/2).im == +1 (not -1), bit-exact");

# Pauli: σx² = I
var sx = pauli_x();
var sx2 = cmat_mul(sx, sx);
var tr_sx2 = cmat_trace(sx2);
assert_eq(HComplex_re(tr_sx2), f64_from(2), "pauli_x^2 trace");

# Commutator [σx, σy] = 2iσz
var sy = pauli_y();
var comm = cmat_commutator(sx, sy);
# [σx,σy](0,0) should be 2i
var c00 = cmat_get(comm, 0, 0);
assert_eq(HComplex_im(c00), f64_from(2), "[sx,sy]_00.im");

# ================================================================
# Lie groups
# ================================================================
test_group("lie groups");

# U(1): compose = add phases
var u_a = u1_new(F64_PI_4);
var u_b = u1_new(F64_PI_4);
var u_c = u1_compose(u_a, u_b);
# pi/4 + pi/4 = pi/2: the sum of two equal doubles is an exact doubling, and F64_PI_2 is
# exactly 2 * F64_PI_4, so bit-exact (round(1000 x) accepted 5e-4).
assert_eq(load64(u_c), F64_PI_2, "u1 compose: fl(pi/4) + fl(pi/4) = fl(pi/2) exactly");

# U(1) inverse: phase + (-phase) = 0
var u_inv = u1_inv(u_a);
var u_id = u1_compose(u_a, u_inv);
# u1_compose(a, u1_inv(a)) is literally f64_add(theta, f64_neg(theta)); IEEE-754
# round-to-nearest makes x + (-x) exactly +0.0 for every finite x. So this is an
# exact assertion, not an approximate one. Measured bit pattern: 0x0.
# (The old bound of 1.0 passed for any residual phase up to +-57 deg.)
# [measured: tests/hisab.tcyr "u1 inv phase is exactly +0.0" (the bit-exact assert below)]
assert_eq(load64(u_id), 0, "u1 inv phase is exactly +0.0");

# SU(2): identity to quat → w=1
var su2_id = su2_identity();
var su2_q = su2_to_quat(su2_id);
assert_eq(HQuat_w(su2_q), f64_from(1), "su2 id.w");

# Lorentz: identity transforms (t,0,0,0) → (t,0,0,0)
var lor_id = lorentz_identity();
var tv4 = alloc(32);
store64(tv4, F64_ONE); store64(tv4 + 8, 0); store64(tv4 + 16, 0); store64(tv4 + 24, 0);
var tv4_out = lorentz_transform_4vec(lor_id, tv4);
assert_eq(load64(tv4_out), f64_from(1), "lorentz id t");

# Minkowski interval for timelike vector (1,0,0,0) = +1
var mink = minkowski_interval(tv4);
assert_eq(mink, f64_from(1), "minkowski timelike");

# Gell-Mann: λ₁ trace = 0 (traceless generators)
var gm1 = gell_mann(0);
var gm1_tr = cmat_trace(gm1);
assert_eq(HComplex_re(gm1_tr), f64_from(0), "gm1 traceless");

# ================================================================
# Differential geometry
# ================================================================

# Helpers for the curvature tests: identity metric, constant-curvature space-form
# Riemann (g=I, K0=1: R^ρ_{σμν} = δ^ρ_μ δ_{σν} − δ^ρ_ν δ_{σμ}), max |component|,
# and the g^{ρμ}-trace of a Weyl tensor (g=I → Σ_ρ C_{ρσρν}).
fn _dg_e4(k) {
    var v = alloc(32);
    var i = 0;
    while (i < 4) { store64(v + i * 8, 0); i = i + 1; }
    store64(v + k * 8, F64_ONE);
    return v;
}
fn _dg_id(dim) {
    var g = alloc(dim * dim * 8);
    var i = 0;
    while (i < dim) {
        var j = 0;
        while (j < dim) {
            var v = 0;
            if (i == j) { v = F64_ONE; }
            store64(g + _dg_idx2(i, j, dim), v);
            j = j + 1;
        }
        i = i + 1;
    }
    return g;
}
fn _dg_spaceform(dim) {
    var n4 = dim * dim * dim * dim;
    var r = alloc(n4 * 8);
    var rho = 0;
    while (rho < dim) {
        var s = 0;
        while (s < dim) {
            var m = 0;
            while (m < dim) {
                var n = 0;
                while (n < dim) {
                    var t1 = 0;
                    if (rho == m) { if (s == n) { t1 = 1; } }
                    var t2 = 0;
                    if (rho == n) { if (s == m) { t2 = 1; } }
                    store64(r + _dg_idx4(rho, s, m, n, dim), f64_from(t1 - t2));
                    n = n + 1;
                }
                m = m + 1;
            }
            s = s + 1;
        }
        rho = rho + 1;
    }
    return r;
}
fn _dg_maxabs(w, dim) {
    var mx = 0;
    var n4 = dim * dim * dim * dim;
    var i = 0;
    while (i < n4) {
        var a = f64_abs(load64(w + i * 8));
        if (f64_lt(mx, a) == 1) { mx = a; }
        i = i + 1;
    }
    return mx;
}
fn _dg_weyl_trace(w, dim) {
    var mx = 0;
    var s = 0;
    while (s < dim) {
        var n = 0;
        while (n < dim) {
            var t = 0;
            var rho = 0;
            while (rho < dim) {
                t = f64_add(t, weyl_get(w, dim, rho, s, rho, n));
                rho = rho + 1;
            }
            var a = f64_abs(t);
            if (f64_lt(mx, a) == 1) { mx = a; }
            n = n + 1;
        }
        s = s + 1;
    }
    return mx;
}

test_group("diffgeo");

# Flat 2D Euclidean: metric = diag(1,1), all Christoffels = 0
var flat_metric_inv = alloc(32);
store64(flat_metric_inv, F64_ONE); store64(flat_metric_inv + 8, 0);
store64(flat_metric_inv + 16, 0); store64(flat_metric_inv + 24, F64_ONE);
# All metric derivatives = 0
var flat_deriv = alloc(64);
var _di = 0;
while (_di < 8) { store64(flat_deriv + _di * 8, 0); _di = _di + 1; }
var flat_chris = christoffel_symbols(flat_metric_inv, flat_deriv, 2);
assert_eq(christoffel_get(flat_chris, 2, 0, 0, 0), f64_from(0), "flat Gamma=0");
assert_eq(christoffel_get(flat_chris, 2, 1, 0, 1), f64_from(0), "flat Gamma=0 b");

# Wedge: α∧β where α=(1,0), β=(0,1) in 2D → 1-component 2-form = 1
var alpha = alloc(16);
store64(alpha, F64_ONE); store64(alpha + 8, 0);
var beta = alloc(16);
store64(beta, 0); store64(beta + 8, F64_ONE);
var w11 = wedge_1_1(alpha, beta, 2);
assert_eq(load64(w11), f64_from(1), "wedge e1^e2");

# Sectional curvature (2.6.0). K(u,v) from the (1,3) Riemann + metric; positive
# for a sphere (verified vs hisab's Riemann convention). Constant-curvature
# 2-space (any plane gives K0); (1,3) components: R^0_101=1, R^0_110=-1,
# R^1_010=1, R^1_001=-1.
var sc_rie = alloc(128);
var _sci = 0;
while (_sci < 16) { store64(sc_rie + _sci * 8, 0); _sci = _sci + 1; }
store64(sc_rie + _dg_idx4(0, 1, 0, 1, 2), F64_ONE);
store64(sc_rie + _dg_idx4(0, 1, 1, 0, 2), f64_neg(F64_ONE));
store64(sc_rie + _dg_idx4(1, 0, 1, 0, 2), F64_ONE);
store64(sc_rie + _dg_idx4(1, 0, 0, 1, 2), f64_neg(F64_ONE));
var sc_id = alloc(32);
store64(sc_id, F64_ONE); store64(sc_id + 8, 0); store64(sc_id + 16, 0); store64(sc_id + 24, F64_ONE);
var sc_e0 = alloc(16); store64(sc_e0, F64_ONE); store64(sc_e0 + 8, 0);
var sc_e1 = alloc(16); store64(sc_e1, 0); store64(sc_e1 + 8, F64_ONE);

# Unit-curvature space form → K = 1 for any plane (axis-aligned and skew).
assert_eq(sectional_curvature(sc_rie, sc_id, sc_e0, sc_e1, 2), f64_from(1), "sectional: unit space form = 1");
var sc_us = alloc(16); store64(sc_us, F64_ONE); store64(sc_us + 8, F64_ONE);
var sc_vs = alloc(16); store64(sc_vs, F64_ONE); store64(sc_vs + 8, f64_neg(F64_ONE));
assert_eq(sectional_curvature(sc_rie, sc_id, sc_us, sc_vs, 2), f64_from(1), "sectional: plane-independent (skew) = 1");

# ================================================================
# 2.15.0 — sectional_curvature: the plane is a DIRECTION, not a size
# ================================================================
# ⛔ `denom` = |u∧v|² is degree FOUR in the vectors, and it was tested against an
# absolute 1e-12 — so scaling the SAME plane's spanning vectors down made the
# curvature of that plane change. And the fallback returned exactly 0.0, which is
# the value meaning FLAT SPACE, through a bare f64 with no error channel.
# ⭐ K(u,v) depends only on the PLANE, so it is invariant under u -> k*u, v -> k*v.
# The shipped guard breaks at k^4 < 1e-12, i.e. k < 1e-3 — three decades in.
var _SK_RUN = 0;
var _SK_BAD = 0;
for (var _sk_e = 0; _sk_e < 250; _sk_e = _sk_e + 1) {
    var _sk_k = (1023 - _sk_e) << 52;                 # 2^-e
    var _sk_u = alloc(16); store64(_sk_u, _sk_k); store64(_sk_u + 8, 0);
    var _sk_v = alloc(16); store64(_sk_v, 0); store64(_sk_v + 8, _sk_k);
    _SK_RUN = _SK_RUN + 1;
    if (sectional_curvature(sc_rie, sc_id, _sk_u, _sk_v, 2) != 0x3FF0000000000000) {
        _SK_BAD = _SK_BAD + 1;
    }
}
# ⚠ 250 here. Through 3.4.0 this said that past ~2^-255 denom = k^4 goes subnormal and
# "the limitation becomes f64's" -- it was this function's: dividing u and v by their
# largest components is exact, and since 3.4.1 sectional_curvature does, so K = 1 at
# every pair of scales 2^-1074 .. 2^1023 (tests/abuse.tcyr "3.4.1: sectional_curvature").
assert_eq(_SK_RUN, 250, "the sectional_curvature scale sweep actually ran 250 scales");
assert_eq(_SK_BAD, 0,
  "sectional_curvature: K = 1 for the same plane at every spanning-vector scale");

# ⭐ THE LORENTZIAN BACKSTOP, and it is load-bearing rather than belt-and-braces.
# The degeneracy test is now RELATIVE — denom/(uu*vv) is sin^2(angle) — but in a
# metric of signature (-,+) a NULL vector gives uu = vv = uv = 0, so denom = 0 AND
# uu*vv = 0: the relative test asks `0 < 0`, which is false, and the division
# would be 0/0. This is a signature case, not a rounding case.
var _sk_g = alloc(32);
store64(_sk_g, f64_neg(F64_ONE)); store64(_sk_g + 8, 0);
store64(_sk_g + 16, 0); store64(_sk_g + 24, F64_ONE);
var _sk_n = alloc(16); store64(_sk_n, F64_ONE); store64(_sk_n + 8, F64_ONE);
assert_eq(sectional_curvature(sc_rie, _sk_g, _sk_n, _sk_n, 2), 0,
  "sectional_curvature: a null vector in Lorentzian signature returns 0, not NaN");

# Radius-2 sphere: same (1,3) Riemann, metric = diag(r²) = diag(4,4) → K = 1/r² = 1/4.
var sc_g4 = alloc(32);
store64(sc_g4, f64_from(4)); store64(sc_g4 + 8, 0); store64(sc_g4 + 16, 0); store64(sc_g4 + 24, f64_from(4));
var sc_k4 = sectional_curvature(sc_rie, sc_g4, sc_e0, sc_e1, 2);
assert_f64_eq(sc_k4, f64_div(f64_from(25), f64_from(100)), "sectional: radius-2 sphere = 1/4");

# Flat space (zero Riemann) → K = 0.
var sc_flat = alloc(128);
var _scf = 0;
while (_scf < 16) { store64(sc_flat + _scf * 8, 0); _scf = _scf + 1; }
assert_eq(sectional_curvature(sc_flat, sc_id, sc_e0, sc_e1, 2), f64_from(0), "sectional: flat = 0");

# Degenerate plane (u ∥ v) → 0 (denominator guard, no div-by-zero).
var sc_par = alloc(16); store64(sc_par, F64_TWO); store64(sc_par + 8, 0);
assert_eq(sectional_curvature(sc_rie, sc_id, sc_e0, sc_par, 2), f64_from(0), "sectional: degenerate plane = 0");

# Weyl conformal-curvature tensor (2.6.1). Trace-free part of Riemann; vanishes
# for n ≤ 3 and for conformally-flat metrics (constant-curvature space forms),
# even where Riemann ≠ 0. Build space forms, compute Ricci/scalar from them.

# 3D space form → Weyl ≡ 0 (Riemann and Ricci are nonzero, but C vanishes).
var wl3_r = _dg_spaceform(3);
var wl3_g = _dg_id(3);
var wl3_ric = ricci_tensor(wl3_r, 3);
var wl3_sc = ricci_scalar(wl3_ric, wl3_g, 3);
var wl3_c = weyl_tensor(wl3_r, wl3_ric, wl3_sc, wl3_g, 3);
assert_f64_eq(_dg_maxabs(wl3_c, 3), f64_from(0), "weyl: 3D space form = 0");

# 4D space form (conformally flat) → Weyl ≡ 0 with Riemann ≠ 0 — the key oracle.
var wl4_r = _dg_spaceform(4);
var wl4_g = _dg_id(4);
var wl4_ric = ricci_tensor(wl4_r, 4);
var wl4_sc = ricci_scalar(wl4_ric, wl4_g, 4);
assert_neq(f64_to(f64_mul(_dg_maxabs(wl4_r, 4), f64_from(1000))), 0, "weyl: 4D space form has nonzero Riemann");
var wl4_c = weyl_tensor(wl4_r, wl4_ric, wl4_sc, wl4_g, 4);
assert_f64_eq(_dg_maxabs(wl4_c, 4), f64_from(0), "weyl: 4D space form = 0 (conformally flat)");

# Non-space-form 4D (only the e0-e1 plane curved): Weyl ≠ 0 and trace-free.
var wl_nr = alloc(2048);
var _wli = 0;
while (_wli < 256) { store64(wl_nr + _wli * 8, 0); _wli = _wli + 1; }
store64(wl_nr + _dg_idx4(0, 1, 0, 1, 4), F64_ONE);
store64(wl_nr + _dg_idx4(0, 1, 1, 0, 4), f64_neg(F64_ONE));
store64(wl_nr + _dg_idx4(1, 0, 1, 0, 4), F64_ONE);
store64(wl_nr + _dg_idx4(1, 0, 0, 1, 4), f64_neg(F64_ONE));
var wl_ng = _dg_id(4);
var wl_nric = ricci_tensor(wl_nr, 4);
var wl_nsc = ricci_scalar(wl_nric, wl_ng, 4);
var wl_nc = weyl_tensor(wl_nr, wl_nric, wl_nsc, wl_ng, 4);
assert_neq(f64_to(f64_mul(_dg_maxabs(wl_nc, 4), f64_from(1000))), 0, "weyl: non-space-form is nonzero");
assert_f64_eq(_dg_weyl_trace(wl_nc, 4), f64_from(0), "weyl: trace-free (g^pm C = 0)");

# Parallel transport (2.6.2). dV^a/dt = −Γ^a_{μν} V^μ ẋ^ν along a curve (RK4).
# Flat space (Γ=0): transport leaves the vector unchanged.
var pt_ch0 = alloc(64);
var _pti = 0;
while (_pti < 8) { store64(pt_ch0 + _pti * 8, 0); _pti = _pti + 1; }
var pt_v = alloc(16); store64(pt_v, F64_ONE); store64(pt_v + 8, F64_TWO);
var pt_cv = alloc(16); store64(pt_cv, F64_ONE); store64(pt_cv + 8, F64_ONE);
var pt_flat = parallel_transport(pt_v, pt_cv, pt_ch0, 2, F64_HALF, 10);
assert_eq(load64(pt_flat), f64_from(1), "transport: flat leaves V^0 = 1");
assert_eq(load64(pt_flat + 8), f64_from(2), "transport: flat leaves V^1 = 2");

# Unit-sphere latitude circle at θ=π/4: Γ^θ_φφ=−1/2, Γ^φ_θφ=Γ^φ_φθ=1, metric
# diag(1, sin²θ)=diag(1,1/2). Transport V=(1,0) along φ. Metric-compatible →
# ⟨V,V⟩ preserved (=1) and the vector genuinely rotates (V^θ moves off 1).
var pt_sch = alloc(64);
_pti = 0;
while (_pti < 8) { store64(pt_sch + _pti * 8, 0); _pti = _pti + 1; }
store64(pt_sch + _dg_idx3(0, 1, 1, 2), f64_neg(F64_HALF));
store64(pt_sch + _dg_idx3(1, 0, 1, 2), F64_ONE);
store64(pt_sch + _dg_idx3(1, 1, 0, 2), F64_ONE);
var pt_sv = alloc(16); store64(pt_sv, F64_ONE); store64(pt_sv + 8, 0);
var pt_scv = alloc(16); store64(pt_scv, 0); store64(pt_scv + 8, F64_ONE);
var pt_dt = f64_div(F64_ONE, f64_from(100));
var pt_st = parallel_transport(pt_sv, pt_scv, pt_sch, 2, pt_dt, 100);
var pt_g = alloc(32);
store64(pt_g, F64_ONE); store64(pt_g + 8, 0); store64(pt_g + 16, 0); store64(pt_g + 24, F64_HALF);
var pt_len2 = _dg_inner(pt_g, pt_st, pt_st, 2);
var pt_tol = f64_div(F64_ONE, f64_from(100));
assert(f64_lt(f64_abs(f64_sub(pt_len2, F64_ONE)), pt_tol) == 1, "transport: sphere preserves length");
assert(f64_lt(f64_abs(f64_sub(load64(pt_st), F64_ONE)), pt_tol) == 0, "transport: sphere rotates the vector");

# Geodesic deviation / Jacobi (2.6.3). D²J/dτ² = −R^ρ_{σμν} u^σ J^μ u^ν. Reuses
# the unit-sphere space form sc_rie + tangents from the sectional block.
# Separation ⊥ tangent → J'' = −J (geodesics converge); ∥ tangent → 0.
# ⚠ The zero components are NEGATIVE zero: the function returns −(contraction), and
# `f64_neg(+0)` is −0 since cyrius 6.6.8 (an IEEE sign flip; it was `0.0 − x`, which
# gives +0). The sign of these zeros is incidental, so they are compared as values —
# still exact zero, still failing for NaN or any non-zero residue.
var gd_perp = geodesic_deviation(sc_rie, sc_e0, sc_e1, 2);
assert_eq(load64(gd_perp + 8), f64_neg(f64_from(1)), "deviation: J perp u gives J'' = -J (sphere)");
assert_eq(f64_eq(load64(gd_perp), 0), 1, "deviation: J perp u has no parallel part (it is -0.0)");

# Separation parallel to the tangent (sc_par = (2,0) ∥ e0) → no tidal force.
var gd_par = geodesic_deviation(sc_rie, sc_e0, sc_par, 2);
assert_eq(f64_eq(load64(gd_par), 0), 1, "deviation: J parallel u gives 0 (A^0, it is -0.0)");
assert_eq(f64_eq(load64(gd_par + 8), 0), 1, "deviation: J parallel u gives 0 (A^1, it is -0.0)");

# Flat space → no tidal acceleration.
var gd_flat = geodesic_deviation(sc_flat, sc_e0, sc_e1, 2);
assert_eq(f64_eq(load64(gd_flat + 8), 0), 1, "deviation: flat -> 0 (it is -0.0)");

# Linear in J: doubling the separation doubles the tidal acceleration.
var gd_2j = alloc(16);
store64(gd_2j, 0);
store64(gd_2j + 8, F64_TWO);
assert_eq(load64(geodesic_deviation(sc_rie, sc_e0, gd_2j, 2) + 8), f64_neg(f64_from(2)), "deviation: linear in J");

# Higher-order differential forms (2.6.4). Chain wedge_1_1 → wedge_2_1 → wedge_3_1
# to build the basis k-forms in 4D (reduced strictly-increasing basis).
# e0∧e1∧e2∧e3 = the unit 4-form.
var wf_2 = wedge_1_1(_dg_e4(0), _dg_e4(1), 4);
var wf_3 = wedge_2_1(wf_2, _dg_e4(2));
assert_eq(load64(wf_3), f64_from(1), "forms: e0^e1^e2 = (012) basis 3-form");
var wf_4 = wedge_3_1(wf_3, _dg_e4(3));
assert_eq(load64(wf_4), f64_from(1), "forms: e0^e1^e2^e3 = unit 4-form");

# Antisymmetry of the 1∧1 wedge and the nilpotence α∧α = 0.
assert_eq(load64(wedge_1_1(_dg_e4(1), _dg_e4(0), 4)), f64_neg(f64_from(1)), "forms: e1^e0 = -(e0^e1)");
assert_eq(load64(wedge_1_1(_dg_e4(0), _dg_e4(0), 4)), f64_from(0), "forms: e0^e0 = 0");

# Permutation sign: swapping two factors flips the form — e0∧e2∧e1 = −(e0∧e1∧e2).
var wf_021 = wedge_2_1(wedge_1_1(_dg_e4(0), _dg_e4(2), 4), _dg_e4(1));
assert_eq(load64(wf_021), f64_neg(f64_from(1)), "forms: e0^e2^e1 = -(012)");

# Repeated factor → 0 (e0∧e1∧e0 has no independent 3-form component).
var wf_rep = wedge_2_1(wedge_1_1(_dg_e4(0), _dg_e4(1), 4), _dg_e4(0));
assert_eq(load64(wf_rep), f64_from(0), "forms: e0^e1^e0 = 0 (012 part)");
assert_eq(load64(wf_rep + 24), f64_from(0), "forms: e0^e1^e0 = 0 (123 part)");

# 4-form sign: e1∧e2∧e3∧e0 is an odd permutation of (0123) → −1.
var wf_1230 = wedge_3_1(wedge_2_1(wedge_1_1(_dg_e4(1), _dg_e4(2), 4), _dg_e4(3)), _dg_e4(0));
assert_eq(load64(wf_1230), f64_neg(f64_from(1)), "forms: e1^e2^e3^e0 = -(0123)");

# ================================================================
# Symbolic
# ================================================================
test_group("symbolic");

# Build x^2 + 3 and evaluate at x=2 → 7
var symx = expr_var(str_from("x"));
var symx2 = expr_mul(symx, symx);
var s3 = expr_const(f64_from(3));
var sexpr = expr_add(symx2, s3);
var bindings = vec_new();
vec_push(bindings, expr_bind(str_from("x"), f64_from(2)));
var svalt, sval = expr_eval_checked(sexpr, bindings);
assert_eq(sval, f64_from(7), "eval x^2+3 at 2");

# Differentiate x^2 w.r.t x → should simplify to 2*x
var sd = expr_diff(sexpr, str_from("x"));
var sd_simple = expr_simplify(sd);
# Evaluate derivative at x=2 → should be 4
var dvalt, dval = expr_eval_checked(sd_simple, bindings);
assert_eq(dval, f64_from(4), "diff x^2+3 at 2");

# Simplify: 0 + x = x, 1 * x = x
var s_zero_plus = expr_add(expr_const(0), symx);
var s_simp = expr_simplify(s_zero_plus);
assert_eq(expr_tag(s_simp), EXPR_VAR, "0+x simplifies to var");

# To string for constant
var s_str = expr_to_str(expr_const(f64_from(42)));
assert(str_eq(s_str, str_from("42")) == 1, "to_str const");

# ================================================================
# Autodiff
# ================================================================
test_group("autodiff");

# f(x) = x^2, f'(x) = 2x at x=3: f(3)=9, f'(3)=6
var dx = dual_var(f64_from(3));
var dx2 = dual_mul(dx, dx);
assert_eq(Dual_val(dx2), f64_from(9), "x^2 val");
assert_eq(Dual_deriv(dx2), f64_from(6), "x^2 deriv");

# f(x) = sin(x), f'(x) = cos(x) at x=0: f(0)=0, f'(0)=1
var d0 = dual_var(0);
var ds = dual_sin(d0);
assert_eq(Dual_val(ds), f64_from(0), "sin(0)");
assert_eq(Dual_deriv(ds), f64_from(1), "cos(0)");

# f(x) = exp(x) at x=0: f(0)=1, f'(0)=1
var de = dual_exp(dual_var(0));
assert_eq(Dual_val(de), f64_from(1), "exp(0)");
assert_eq(Dual_deriv(de), f64_from(1), "exp'(0)");

# ================================================================
# Interval
# ================================================================
test_group("interval");

var ia = ivl_new(f64_from(1), f64_from(3));
var ib = ivl_new(f64_from(2), f64_from(4));
var ic = ivl_add(ia, ib);
assert_eq(Interval_lo(ic), f64_from(3), "add.lo");
assert_eq(Interval_hi(ic), f64_from(7), "add.hi");

assert_eq(ivl_contains(ia, f64_from(2)), 1, "contains 2");
assert_eq(ivl_contains(ia, f64_from(4)), 0, "not contains 4");
assert_eq(ivl_width(ia), f64_from(2), "width");

# ================================================================
# Tensor
# ================================================================
test_group("tensor");

# 2x3 tensor
var shape = alloc(16);
store64(shape, 2); store64(shape + 8, 3);
var tn = tensor_new(2, shape);
tensor_set2(tn, 0, 1, f64_from(42));
assert_eq(tensor_get2(tn, 0, 1), f64_from(42), "set/get");
assert_eq(tensor_get2(tn, 0, 0), f64_from(0), "zero init");

# Kronecker delta
assert_eq(kronecker_delta(1, 1), f64_from(1), "delta ii");
assert_eq(kronecker_delta(0, 1), f64_from(0), "delta ij");

# Minkowski metric
assert_eq(minkowski(0, 0), f64_from(1), "eta 00");
assert_eq(minkowski(1, 1), f64_neg(f64_from(1)), "eta 11");

# Levi-Civita 3D
assert_eq(levi_civita_3(0, 1, 2), f64_from(1), "eps 012");
assert_eq(levi_civita_3(1, 0, 2), f64_neg(f64_from(1)), "eps 102");
assert_eq(levi_civita_3(0, 0, 1), 0, "eps repeated");

# ================================================================
# 2.7.0-D -- unscaled Householder / unbalanced decompositions.
#
# Helper and constants use a `lp_test_` / `LP_T_` prefix deliberately: Cyrius has
# ONE flat namespace with last-definition-wins and this file includes src first,
# so a test symbol named `_lp_*` would silently shadow a future module internal.
# ================================================================

test_group("linalg_precision: decompositions must be scale-invariant");

# Relative closeness helper -- LOOSE_TOL_H is an ABSOLUTE 1e-8 and is useless at
# 1e200 scale, so these need a relative comparison.
var LP_T_RELTOL = 0x3DDB7CDFD9D7BDBB;   # 1e-10
var LP_T_DBLMAX = 0x7FEFFFFFFFFFFFFF;
fn lp_test_relclose(a, b) {
    if (f64_eq(a, a) == 0) { return 0; }                          # NaN
    if (f64_gt(f64_abs(a), LP_T_DBLMAX) == 1) { return 0; }        # +/-Inf
    if (f64_lt(f64_abs(f64_sub(a, b)), f64_mul(LP_T_RELTOL, f64_abs(b))) == 1) { return 1; }
    return 0;
}

# ================================================================
# 2.15.0 — linalg_precision: nine guards, four different correct forms
# ================================================================
# ⛔ SVD and the symmetric/complex QR are HOMOGENEOUS: scale A by k and every
# singular value, every eigenvalue and R scale by k while U, V and Q do not move
# at all. Nine guards compared a matrix entry, a Householder v.v or a Givens
# radius against an absolute 1e-12, so all of that stopped being true below a
# scale the caller never chose.
#
# ⭐ THE NINE DO NOT TAKE THE SAME REPAIR, AND THE DIFFERENCE IS THE NUMERATOR.
#   * `2/vtv` and `e2sq/denom` have an UNBOUNDED numerator, so a subnormal
#     denominator overflows: those get DBL_MIN (4 Householder sites + the
#     Wilkinson shift).
#   * `y/r` and `x/r` are bounded by 1 because r is the norm of (y,z): those
#     cannot overflow at any non-zero r, so the test is an exact zero (3 Givens
#     radii). A DBL_MIN floor there still fabricates an identity rotation.
#   * The bidiagonal deflation bound is not a division guard at all — it asks
#     whether an off-diagonal is negligible RELATIVE to its neighbours — so it
#     takes the relative form its own sibling loop twenty lines up already uses.
# [measured: docs/audit/2026-09-09-epsilon-open.json]

var LP_SV_RUN = 0;
var LP_SV_BAD = 0;
for (var lp_e = 0; lp_e < 400; lp_e = lp_e + 1) {
    var lp_k = (1023 - lp_e) << 52;                   # 2^-e
    var lp_A = ganita_mat_new(3, 3);
    ganita_mat_set(lp_A, 0, 0, lp_k);
    ganita_mat_set(lp_A, 0, 1, f64_mul(F64_TWO, lp_k));
    ganita_mat_set(lp_A, 0, 2, f64_mul(f64_from(3), lp_k));
    ganita_mat_set(lp_A, 1, 0, f64_mul(f64_from(4), lp_k));
    ganita_mat_set(lp_A, 1, 1, f64_mul(f64_from(5), lp_k));
    ganita_mat_set(lp_A, 1, 2, f64_mul(f64_from(6), lp_k));
    ganita_mat_set(lp_A, 2, 0, f64_mul(f64_from(7), lp_k));
    ganita_mat_set(lp_A, 2, 1, f64_mul(f64_from(8), lp_k));
    ganita_mat_set(lp_A, 2, 2, f64_mul(f64_from(10), lp_k));
    var lp_U = ganita_mat_new(3, 3);
    var lp_Vt = ganita_mat_new(3, 3);
    var lp_S = alloc(24);
    LP_SV_RUN = LP_SV_RUN + 1;
    var _rj1t, _rj1v = svd_golub_kahan(lp_A, lp_U, lp_S, lp_Vt);
    if (is_err_result(_rj1t) == 1) {
        LP_SV_BAD = LP_SV_BAD + 1;
    }
    # sigma_0(kA) = k * sigma_0(A) = k * 17.412505166808593, exactly homogeneous.
    # ⚠ Both constants are COMPUTED from M^T M, not guessed — the first draft
    # of this fixture carried a hand-written sigma_0 that was wrong in the
    # fourth digit and failed 800 of 1200 checks against correct output.
    # [measured: singular values recomputed from M^T M, 2026-09-10]
    if (lp_test_relclose(f64_div(load64(lp_S), lp_k), 0x40316999F048DFBA) == 0) {
        LP_SV_BAD = LP_SV_BAD + 1;
    }
    # and the SMALLEST singular value too, which is where deflation bites.
    if (lp_test_relclose(f64_div(load64(lp_S + 16), lp_k), 0x3FC932EC12F0360B) == 0) {
        LP_SV_BAD = LP_SV_BAD + 1;
    }
}
# ⚠ AND THIS SWEEP ALONE PROVES NOTHING — it is kept because it pins homogeneity
# cheaply, but every one of the nine mutants SURVIVES it. `svd_golub_kahan`
# BALANCES its input by a power of two (`_lp_balance_scale` in
# src/linalg_precision.cyr, built on `_lp_pow2_floor`), so a uniform
# units change is bit-exactly invariant on the DEFECTIVE tree too. The
# discriminating variable is the RATIO BETWEEN SUB-BLOCKS, not the units — a
# matrix the balancing cannot normalise in one go. That sweep is below.
# [measured: 8-mutant run; all 8 survived the uniform sweep, 2026-09-10]
assert_eq(LP_SV_RUN, 400, "the SVD scale sweep actually ran 400 scales");
assert_eq(LP_SV_BAD, 0,
  "svd_golub_kahan: sigma/k is invariant for matrix scales 2^0 down to 2^-399");

# ⭐ THE BLOCK-RATIO SWEEP — the one that actually interrogates these guards.
# A = diag(1) (+) c*[[1,1],[0,1]]: a UNIT block beside a c-scaled block, so the
# balancing pins the overall scale at 1 and cannot hide the sub-block. The
# singular values are exactly {1, phi*c, c/phi} with phi the golden ratio, because
# [[1,1],[0,1]] has M^T M = [[1,1],[1,2]] with eigenvalues (3 +/- sqrt 5)/2.
#
# ⭐ THE PROPERTY ASSERTED IS "NO CONFIDENT LIE": either the routine reports a
# failure, or its answer is right. That is what interrogates a fabricating guard,
# and it is weaker than demanding success on purpose — a correct implementation
# still legitimately gives up somewhere, and demanding otherwise would make the
# test unpassable rather than discriminating.
# ⚠ THE FLOOR IS MEASURED, AND IT IS AN ARITHMETIC ONE. The Wilkinson shift forms
# a11*a22 - a12^2, degree FOUR in the block scale, so c^4 approaches subnormal near
# 1e-80 and no threshold repair can reach past it — a deeper sweep would report a
# fully correct implementation as failing. Measured on this tree, S[1]/c against
# phi: bit-stable through 1e-78, 3.3e-9 out at 1e-79, and 1.618021672 at 1e-80.
# ⭐ That last figure reproduces the census's own measurement to every digit,
# which cross-validates the fixture rather than just the code.
# [measured: 8-mutant run over linalg_precision.cyr, 2026-09-10]
# ⭐ 3.3.5 — THAT FLOOR IS GONE (2.18.0 scaled the shift's operands), AND THIS SWEEP AND
# THE TWO BELOW NOW RUN AS DEEP AS THEIR OWN CRITERION ALLOWS (audit D005, D006). Every
# decade is answered and passes through c = 1e-314; at 1e-315 the scaled block's c/phi
# is a subnormal whose 2^-1074 grid alone puts its ratio more than 1e-9 off phi's, so
# the depth is set by the output grid, not by the routine. The 4x4 passes through
# 1e-314 the same way and the eigen sweep through 1e-323, the last decade before c
# rounds to 0 (its entries 2c and c and its eigenvalues 3c and c are exact multiples of
# 2^-1074 there).
# [measured: the three sweeps run to 330 decades on this tree, 2026-10-11; cycc 6.6.14]
fn lp_absclose(a, b) {
    if (f64_eq(a, a) == 0) { return 0; }                          # NaN
    if (f64_gt(f64_abs(a), LP_T_DBLMAX) == 1) { return 0; }        # +/-Inf
    if (f64_lt(f64_abs(f64_sub(a, b)), f64_div(F64_ONE, f64_from(1000000000))) == 1) {
        return 1;
    }
    return 0;
}

var LP_BR_RUN = 0;
var LP_BR_BAD = 0;
var LP_BR_REF = 0;
var lp_c = F64_ONE;
for (var lp_d = 0; lp_d < 314; lp_d = lp_d + 1) {
    lp_c = f64_div(lp_c, f64_from(10));
    var lp_B = ganita_mat_new(3, 3);
    ganita_mat_set(lp_B, 0, 0, F64_ONE);
    ganita_mat_set(lp_B, 0, 1, f64_from(0));
    ganita_mat_set(lp_B, 0, 2, f64_from(0));
    ganita_mat_set(lp_B, 1, 0, f64_from(0));
    ganita_mat_set(lp_B, 1, 1, lp_c);
    ganita_mat_set(lp_B, 1, 2, lp_c);
    ganita_mat_set(lp_B, 2, 0, f64_from(0));
    ganita_mat_set(lp_B, 2, 1, f64_from(0));
    ganita_mat_set(lp_B, 2, 2, lp_c);
    var lp_bU = ganita_mat_new(3, 3);
    var lp_bVt = ganita_mat_new(3, 3);
    var lp_bS = alloc(24);
    LP_BR_RUN = LP_BR_RUN + 1;
    var _rj2t, _rj2v = svd_golub_kahan(lp_B, lp_bU, lp_bS, lp_bVt);
    if (is_ok(_rj2t) == 1) {
        # S[0] is the unit block; S[1] and S[2] are the scaled block.
        # ⚠ ABSOLUTE 1e-9 on the RATIO, not `lp_test_relclose`'s 1e-10 relative.
        # This is an iterative SVD driven 79 decades out of balance; demanding
        # 1e-10 relative makes the assertion fail on CORRECT output (measured, 2 of
        # 237 checks) and would have been read as a defect. 1e-9 is the criterion
        # the census itself measured the repair against.
        # [measured: block-ratio sweep re-run under both criteria, 2026-09-10]
        if (lp_absclose(load64(lp_bS), F64_ONE) == 0) { LP_BR_BAD = LP_BR_BAD + 1; }
        if (lp_absclose(f64_div(load64(lp_bS + 8), lp_c), 0x3FF9E3779B97F4A8) == 0) {
            LP_BR_BAD = LP_BR_BAD + 1;
        }
        if (lp_absclose(f64_div(load64(lp_bS + 16), lp_c), 0x3FE3C6EF372FE950) == 0) {
            LP_BR_BAD = LP_BR_BAD + 1;
        }
    } else {
        LP_BR_REF = LP_BR_REF + 1;
    }
}
assert_eq(LP_BR_RUN, 314, "the block-ratio sweep actually ran 314 decades");
assert_eq(LP_BR_BAD, 0,
  "svd_golub_kahan: never returns a CONFIDENT WRONG answer for block ratios to 1e-314");
assert_eq(LP_BR_REF, 0, "svd_golub_kahan: and refuses none of the 314 block ratios");

# ⭐ AND A SECOND BLOCK FIXTURE THAT DEMANDS SUCCESS, NOT MERELY HONESTY. The
# no-confident-lie sweep above is satisfied by an honest HSB_ERR_NO_CONVERGENCE,
# so it discriminates the DEFLATION bound and nothing else — measured, 7 of 8
# mutants survive it. The Householder, Givens and Wilkinson guards only show up
# when the routine is required to SUCCEED on a problem it can solve.
# [[measured: 8-mutant run over linalg_precision.cyr, 2026-09-10]]
#
# A = diag(1) (+) c*[[1,2,3],[4,5,6],[7,8,10]], 4x4. sigma = {1, c*17.4125...,
# c*0.87516..., c*0.196866...} once c is small. ⚠ The RECONSTRUCTION clause is not
# decoration: ||A - U S Vt||_F / ||A||_F is what catches a half-repair that fixes
# only the left reflector — it reads 4.2e-7 there while every singular value still
# looks right.
# [measured: 8-mutant run over linalg_precision.cyr, 2026-09-10]
# ⚠ NINE DECADES, AND THE FLOOR IS MEASURED. The singular-value ratios are BIT
# EXACT at block ratios 1e-2 through 1e-10 and drift 3.1e-9 at 1e-11, which is
# past the 1e-9 criterion — so a deeper sweep would report correct output as
# failing. The census specified this fixture as a SINGLE decade (1e-7); running it
# as a sweep is stronger, but only out to where it is actually exact.
# [measured: sigma-ratio probe over block ratios 1e-2..1e-12]
# (That drift was 2.15.0's; since 2.18.0 the ratios pass to 1e-314: see the 3.3.5
# note above `lp_absclose`.)
var LP_RC_RUN = 0;
var LP_RC_BAD = 0;
# ⚠ STARTS AT 1e-2, NOT 1e-1, AND THAT IS ARITHMETIC. The singular values of the
# two blocks INTERLEAVE when c*17.4125 > 1, i.e. for c > 0.057 — at c = 0.1 the
# scaled block's largest value sorts ABOVE the unit block and S[1] is 1.0, not
# c*sigma_0. The first draft swept from 1e-1 and "failed" on correct output.
var lp_rc_c = f64_div(F64_ONE, f64_from(10));
for (var lp_r = 0; lp_r < 313; lp_r = lp_r + 1) {
    lp_rc_c = f64_div(lp_rc_c, f64_from(10));
    var lp_rA = ganita_mat_new(4, 4);
    for (var lp_i = 0; lp_i < 4; lp_i = lp_i + 1) {
        for (var lp_j = 0; lp_j < 4; lp_j = lp_j + 1) {
            ganita_mat_set(lp_rA, lp_i, lp_j, f64_from(0));
        }
    }
    ganita_mat_set(lp_rA, 0, 0, F64_ONE);
    ganita_mat_set(lp_rA, 1, 1, lp_rc_c);
    ganita_mat_set(lp_rA, 1, 2, f64_mul(F64_TWO, lp_rc_c));
    ganita_mat_set(lp_rA, 1, 3, f64_mul(f64_from(3), lp_rc_c));
    ganita_mat_set(lp_rA, 2, 1, f64_mul(f64_from(4), lp_rc_c));
    ganita_mat_set(lp_rA, 2, 2, f64_mul(f64_from(5), lp_rc_c));
    ganita_mat_set(lp_rA, 2, 3, f64_mul(f64_from(6), lp_rc_c));
    ganita_mat_set(lp_rA, 3, 1, f64_mul(f64_from(7), lp_rc_c));
    ganita_mat_set(lp_rA, 3, 2, f64_mul(f64_from(8), lp_rc_c));
    ganita_mat_set(lp_rA, 3, 3, f64_mul(f64_from(10), lp_rc_c));
    var lp_rU = ganita_mat_new(4, 4);
    var lp_rVt = ganita_mat_new(4, 4);
    var lp_rS = alloc(32);
    LP_RC_RUN = LP_RC_RUN + 1;
    # ⚠ SUCCESS IS REQUIRED HERE. This problem is well within reach at every c in
    # the sweep, so a refusal is a defect, not honesty.
    var _rj3t, _rj3v = svd_golub_kahan(lp_rA, lp_rU, lp_rS, lp_rVt);
    if (is_err_result(_rj3t) == 1) {
        LP_RC_BAD = LP_RC_BAD + 1;
    } else {
        if (lp_absclose(f64_div(load64(lp_rS + 8), lp_rc_c),
            0x40316999F048DFBA) == 0) { LP_RC_BAD = LP_RC_BAD + 1; }
        if (lp_absclose(f64_div(load64(lp_rS + 24), lp_rc_c),
            0x3FC932EC12F0360B) == 0) { LP_RC_BAD = LP_RC_BAD + 1; }
        # ||A - U diag(S) Vt||_F, compared against ||A||_F which is ~1 here.
        var lp_err = f64_from(0);
        for (var lp_a = 0; lp_a < 4; lp_a = lp_a + 1) {
            for (var lp_b = 0; lp_b < 4; lp_b = lp_b + 1) {
                var lp_acc = f64_from(0);
                for (var lp_k = 0; lp_k < 4; lp_k = lp_k + 1) {
                    lp_acc = f64_add(lp_acc,
                      f64_mul(f64_mul(ganita_mat_get(lp_rU, lp_a, lp_k),
                          load64(lp_rS + lp_k * 8)),
                        ganita_mat_get(lp_rVt, lp_k, lp_b)));
                }
                var lp_dv = f64_sub(ganita_mat_get(lp_rA, lp_a, lp_b), lp_acc);
                lp_err = f64_add(lp_err, f64_mul(lp_dv, lp_dv));
            }
        }
        # ⛔ RECONSTRUCTION IS ASSERTED ONLY THROUGH 1e-5, AND THE REASON WAS A
        # SEPARATE FINDING, MEASURED HERE RATHER THAN PAPERED OVER (2.15.0).
        # ||A - U S Vt||_F on that tree: EXACTLY 0 at block ratios 1e-2..1e-5,
        # then 4.17e-7 at 1e-6, 2.88e-7 at 1e-7, 2.66e-7 at 1e-8, and thereafter
        # proportional to c (2.66e-8, 2.66e-9, ...). The singular values stay
        # correct throughout, so it is U and Vt that stop reconstructing the small
        # block — the factors, not the spectrum. The nine threshold repairs of
        # 2.15.0 did not close it; 2.18.0 did (the U-replay guard pair in
        # `_lp_bidiagonalize`).
        # ⚠ 4.17e-7 reproduces the census's own "4.2e-7" figure for a half-repaired
        # bidiagonalisation, so this is the same phenomenon it saw, not a new one.
        # [measured: reconstruction probe over block ratios 1e-2..1e-12]
        # ⭐ 3.3.5 — THE GATE COVERS THE WHOLE SWEEP NOW (audit D005); it read only the
        # first four decades, exactly where the defect left the error at 0. On this tree
        # ||A - U S Vt||_F is at most 9.8e-17 over all 313 decades. Rebuilt in a scratch
        # tree, the 2.18.0 configuration (replay guard at EPSILON_F64 and 2.22.1's
        # normalised reflector taken back out, so vtv is degree two again) gives the
        # 2.15.0 figures to three digits, 4.17e-7, 2.88e-7, 2.66e-7, 2.66e-8 and 2.66e-9
        # at 1e-6..1e-10: this gate fails it at those five decades, the r < 4 gate at
        # none. The guard alone set back to EPSILON_F64 is an equivalent mutant since
        # 2.22.1: vtv is 1 to a few ulps, so both guards always agree.
        # [measured: sweep probe on this tree and two mutant builds, 2026-10-11; cycc 6.6.14]
        if (f64_gt(f64_sqrt(lp_err), f64_div(F64_ONE, f64_from(1000000000))) == 1) {
            LP_RC_BAD = LP_RC_BAD + 1;
        }
    }
}
assert_eq(LP_RC_RUN, 313, "the reconstruction sweep actually ran 313 decades");
assert_eq(LP_RC_BAD, 0,
  "svd_golub_kahan: succeeds AND reconstructs A for block ratios 1e-2 to 1e-314");

# --- eigen_qr on a symmetric matrix: lambda(kA) = k*lambda(A). This is the path
# through _lp_tridiagonalize, the Wilkinson shift and the tridiagonal Givens
# rotations, i.e. four of the nine sites.
var LP_EV_RUN = 0;
var LP_EV_BAD = 0;
for (var lp_g = 0; lp_g < 400; lp_g = lp_g + 1) {
    var lp_gk = (1023 - lp_g) << 52;
    var lp_E = ganita_mat_new(3, 3);
    ganita_mat_set(lp_E, 0, 0, f64_mul(f64_from(4), lp_gk));
    ganita_mat_set(lp_E, 0, 1, lp_gk);
    ganita_mat_set(lp_E, 0, 2, f64_from(0));
    ganita_mat_set(lp_E, 1, 0, lp_gk);
    ganita_mat_set(lp_E, 1, 1, f64_mul(f64_from(3), lp_gk));
    ganita_mat_set(lp_E, 1, 2, lp_gk);
    ganita_mat_set(lp_E, 2, 0, f64_from(0));
    ganita_mat_set(lp_E, 2, 1, lp_gk);
    ganita_mat_set(lp_E, 2, 2, f64_mul(F64_TWO, lp_gk));
    var lp_ev = alloc(24);
    var lp_evec = ganita_mat_new(3, 3);
    LP_EV_RUN = LP_EV_RUN + 1;
    var _rj4t, _rj4v = eigen_qr(lp_E, 3, 10000, lp_ev, lp_evec);
    if (is_err_result(_rj4t) == 1) {
        LP_EV_BAD = LP_EV_BAD + 1;
    }
    # 4.732050807568875 and 1.2679491924311228, both scaled by k.
    if (lp_test_relclose(f64_div(load64(lp_ev), lp_gk), 0x4012ED9EBA161328) == 0) {
        LP_EV_BAD = LP_EV_BAD + 1;
    }
    if (lp_test_relclose(f64_div(load64(lp_ev + 16), lp_gk), 0x3FF4498517A7B356) == 0) {
        LP_EV_BAD = LP_EV_BAD + 1;
    }
}
assert_eq(LP_EV_RUN, 400, "the eigen_qr scale sweep actually ran 400 scales");
assert_eq(LP_EV_BAD, 0,
  "eigen_qr: lambda/k is invariant for matrix scales 2^0 down to 2^-399");

# ⭐ AND THE BLOCK-RATIO VERSION, for the same reason as the SVD: a uniform units
# change is absorbed by the balancing and leaves the tridiagonal Givens rotations
# and the Wilkinson shift untouched — measured, both survive the sweep above.
# A = diag(1) (+) c*[[2,1],[1,2]] is symmetric with eigenvalues exactly {1, 3c, c}.
# [[measured: 8-mutant run over linalg_precision.cyr, 2026-09-10]]
var LP_EB_RUN = 0;
var LP_EB_BAD = 0;
var lp_eb_c = f64_div(F64_ONE, f64_from(10));
for (var lp_eb = 0; lp_eb < 322; lp_eb = lp_eb + 1) {
    lp_eb_c = f64_div(lp_eb_c, f64_from(10));
    var lp_ebA = ganita_mat_new(3, 3);
    ganita_mat_set(lp_ebA, 0, 0, F64_ONE);
    ganita_mat_set(lp_ebA, 0, 1, f64_from(0));
    ganita_mat_set(lp_ebA, 0, 2, f64_from(0));
    ganita_mat_set(lp_ebA, 1, 0, f64_from(0));
    ganita_mat_set(lp_ebA, 1, 1, f64_mul(F64_TWO, lp_eb_c));
    ganita_mat_set(lp_ebA, 1, 2, lp_eb_c);
    ganita_mat_set(lp_ebA, 2, 0, f64_from(0));
    ganita_mat_set(lp_ebA, 2, 1, lp_eb_c);
    ganita_mat_set(lp_ebA, 2, 2, f64_mul(F64_TWO, lp_eb_c));
    var lp_ebv = alloc(24);
    var lp_ebV = ganita_mat_new(3, 3);
    LP_EB_RUN = LP_EB_RUN + 1;
    var _rj5t, _rj5v = eigen_qr(lp_ebA, 3, 10000, lp_ebv, lp_ebV);
    if (is_err_result(_rj5t) == 1) {
        LP_EB_BAD = LP_EB_BAD + 1;
    } else {
        if (lp_absclose(load64(lp_ebv), F64_ONE) == 0) { LP_EB_BAD = LP_EB_BAD + 1; }
        if (lp_absclose(f64_div(load64(lp_ebv + 8), lp_eb_c), f64_from(3)) == 0) {
            LP_EB_BAD = LP_EB_BAD + 1;
        }
        if (lp_absclose(f64_div(load64(lp_ebv + 16), lp_eb_c), F64_ONE) == 0) {
            LP_EB_BAD = LP_EB_BAD + 1;
        }
    }
}
assert_eq(LP_EB_RUN, 322, "the eigen block-ratio sweep actually ran 322 decades");
assert_eq(LP_EB_BAD, 0,
  "eigen_qr: eigenvalues {1, 3c, c} exact for block ratios 1e-2 to 1e-323");

# ⚠ 2.15.0 RECORDED THREE LINALG_PRECISION SURVIVORS HERE; ONE IS STILL ALIVE.
# In `_lp_tridiag_qr`: restoring `EPSILON_F64` at the TRIDIAGONAL Givens radius
# guard (`f64_gt(r, 0)`) or at the Wilkinson shift denominator guard (now
# `f64_eq(denom, 0)`; in 2.15.0 `f64_lt(|denom|, F64_TINY) == 0`), or putting an
# `F64_TINY` floor on that radius, passed every assertion in 2.15.0, whose
# explanation was that `eigen_qr` balances its input and the tridiagonal
# reduction absorbs the block ratios that survive.
# Later fixtures reach the first two: restoring `EPSILON_F64` at the radius now
# fails 9 assertions and at the denominator 2, through the 998-ratio eigen sweep
# (2.17.0) and the `eigen_qr 2^-42` / `2^-200` fixtures (2.22.0) further down this
# file.
# [measured: 3-mutant re-run, five suites; scratch harness, not reproducible in-tree, 2026-09-30; cycc 6.6.12]
#
# The `F64_TINY` floor on the radius still passes all five suites.
# ⭐ The census reached the same wall from the other side and said so: for that
# radius it could not construct a REACHABLE subnormal radius either — the block
# invariant would need |diag[p_lo]| + |diag[p_lo+1]| <= 2.2e-296 — and recorded
# that `r > 0` is nonetheless what the division requires and costs nothing. The
# repair is kept on that ground, not on the strength of these assertions.
# ⚠ The five sites 2.15.0's run DID discriminate — both bidiagonal Householders,
# the complex one, the bidiagonal Givens radius and the deflation bound — were
# killed then.
# [measured: 8-mutant run over linalg_precision.cyr in 2.15.0, 5 killed / 3 survivors then]

# --- cqr_decompose: R(kA) = k*R(A) and Q does not move at all. This is the
# complex Householder site.
var LP_QR_RUN = 0;
var LP_QR_BAD = 0;
for (var lp_q = 0; lp_q < 400; lp_q = lp_q + 1) {
    var lp_qk = (1023 - lp_q) << 52;
    var lp_cA = cmat_new(2, 2);
    cmat_set(lp_cA, 0, 0, cx_new(f64_mul(f64_from(3), lp_qk), f64_from(0)));
    cmat_set(lp_cA, 0, 1, cx_new(lp_qk, f64_from(0)));
    cmat_set(lp_cA, 1, 0, cx_new(f64_mul(f64_from(4), lp_qk), f64_from(0)));
    cmat_set(lp_cA, 1, 1, cx_new(f64_mul(F64_TWO, lp_qk), f64_from(0)));
    var lp_cQ = cmat_new(2, 2);
    var lp_cR = cmat_new(2, 2);
    LP_QR_RUN = LP_QR_RUN + 1;
    var _rj6t, _rj6v = cqr_decompose(lp_cA, lp_cQ, lp_cR);
    if (is_err_result(_rj6t) == 1) { LP_QR_BAD = LP_QR_BAD + 1; }
    # |R[0][0]| = ||first column|| = 5, scaled by k.
    if (lp_test_relclose(f64_div(f64_abs(HComplex_re(cmat_get(lp_cR, 0, 0))), lp_qk),
        f64_from(5)) == 0) {
        LP_QR_BAD = LP_QR_BAD + 1;
    }
    # ⭐ R must be UPPER TRIANGULAR — the 2.11.1 audit found this exact routine
    # returning an R that was not, with rc = 0. R[1][0] is exactly zero.
    if (HComplex_re(cmat_get(lp_cR, 1, 0)) != 0) { LP_QR_BAD = LP_QR_BAD + 1; }
}
assert_eq(LP_QR_RUN, 400, "the cqr_decompose scale sweep actually ran 400 scales");
assert_eq(LP_QR_BAD, 0,
  "cqr_decompose: |R|/k is invariant and R stays upper triangular to 2^-399");

# ⭐ And the complex Householder needs a block ratio too, for the same reason.
# A = diag(1) (+) c*[[3,1],[4,2]]: |R[0][0]| = 1 and |R[1][1]| = 5c, because the
# first column of the scaled block has norm 5c.
var LP_CB_RUN = 0;
var LP_CB_BAD = 0;
var lp_cb_c = f64_div(F64_ONE, f64_from(10));
for (var lp_cb = 0; lp_cb < 9; lp_cb = lp_cb + 1) {
    lp_cb_c = f64_div(lp_cb_c, f64_from(10));
    var lp_cbA = cmat_new(3, 3);
    for (var lp_ci = 0; lp_ci < 3; lp_ci = lp_ci + 1) {
        for (var lp_cj = 0; lp_cj < 3; lp_cj = lp_cj + 1) {
            cmat_set(lp_cbA, lp_ci, lp_cj, cx_new(f64_from(0), f64_from(0)));
        }
    }
    cmat_set(lp_cbA, 0, 0, cx_new(F64_ONE, f64_from(0)));
    cmat_set(lp_cbA, 1, 1, cx_new(f64_mul(f64_from(3), lp_cb_c), f64_from(0)));
    cmat_set(lp_cbA, 1, 2, cx_new(lp_cb_c, f64_from(0)));
    cmat_set(lp_cbA, 2, 1, cx_new(f64_mul(f64_from(4), lp_cb_c), f64_from(0)));
    cmat_set(lp_cbA, 2, 2, cx_new(f64_mul(F64_TWO, lp_cb_c), f64_from(0)));
    var lp_cbQ = cmat_new(3, 3);
    var lp_cbR = cmat_new(3, 3);
    LP_CB_RUN = LP_CB_RUN + 1;
    var _rj7t, _rj7v = cqr_decompose(lp_cbA, lp_cbQ, lp_cbR);
    if (is_err_result(_rj7t) == 1) {
        LP_CB_BAD = LP_CB_BAD + 1;
    } else {
        if (lp_absclose(f64_abs(HComplex_re(cmat_get(lp_cbR, 0, 0))), F64_ONE) == 0) {
            LP_CB_BAD = LP_CB_BAD + 1;
        }
        if (lp_absclose(f64_div(f64_abs(HComplex_re(cmat_get(lp_cbR, 1, 1))), lp_cb_c),
            f64_from(5)) == 0) {
            LP_CB_BAD = LP_CB_BAD + 1;
        }
        # R must stay upper triangular whatever the block ratio.
        if (HComplex_re(cmat_get(lp_cbR, 2, 1)) != 0) { LP_CB_BAD = LP_CB_BAD + 1; }
    }
}
assert_eq(LP_CB_RUN, 9, "the cqr block-ratio sweep actually ran 9 decades");
assert_eq(LP_CB_BAD, 0,
  "cqr_decompose: |R| = {1, 5c} and R stays triangular for block ratios to 1e-10");

# ================================================================
# 2.23.0 -- THE FOURTH REFLECTOR, AND THE DEPTH THE SWEEP ABOVE NEVER REACHED
# ================================================================
# ⛔ The sweep above stops at a block ratio of 1e-10. `cqr_decompose`'s reflector
# gate fired below 1e-12 and its `vhv` underflows below 2^-515 -- so that sweep
# sat three decades above one defect and ~145 above the other, and passed
# throughout. **Bracketing the thresholds is not reaching the floor**, which this
# project last learned in 2.17.0 and had to learn again here.
# ⛔ `vhv` is a naive sum of `re*re + im*im`. 2.22.1 normalised `v` in the three
# REAL reflectors so `vtv` is 1 by construction; this complex one was left, so it
# kept the defect -- the fourth of four. For this fixture the k=1 reflector's v is
# (8c, 4c), giving vhv = 80c^2, which drops below DBL_MIN at c = 2^-515: measured,
# e=514 correct and e=515 wrong, and 80*2^-1028 > DBL_MIN > 80*2^-1030 predicts
# exactly that. Blocks with vhv = 468c^2 and 0.3125c^2 first fail at e=516 and
# e=511, as their coefficients dictate -- causal isolation, not correlation.
# ⛔ THE FAILURE IS INVISIBLE TO BOTH RESIDUAL TESTS A CALLER WOULD RUN. With the
# reflector skipped, R == A and Q == I, so `max|QR - A|` and `max|Q^H Q - I|` are
# **exactly 0** on the wrong answer. The only visible symptom is that R is not
# upper triangular -- the one thing a QR decomposition is FOR.
# [measured: 1075-binade sweep x 3 fixtures on 4 trees, 2026-09-11]
fn _cq_run(e, R) {
    var c = (1023 - e) << 52;                   # 2^-e, NORMAL form
    var A = cmat_new(3, 3);
    for (var i = 0; i < 3; i = i + 1) {
        for (var j = 0; j < 3; j = j + 1) { cmat_set(A, i, j, cx_new(0, 0)); }
    }
    cmat_set(A, 0, 0, cx_new(F64_ONE, 0));
    cmat_set(A, 1, 1, cx_new(f64_mul(f64_from(3), c), 0));
    cmat_set(A, 1, 2, cx_new(c, 0));
    cmat_set(A, 2, 1, cx_new(f64_mul(f64_from(4), c), 0));
    cmat_set(A, 2, 2, cx_new(f64_mul(F64_TWO, c), 0));
    var Q = cmat_new(3, 3);
    return cqr_decompose(A, Q, R);
}

var _cq_R = cmat_new(3, 3);
# The first scale the shipped tree got wrong. |R11| must be 5c EXACTLY: the first
# column of the scaled block is (3c, 4c), norm 5c, and c is a power of two.
assert_eq(is_ok(_cq_run(515, _cq_R)), 1, "cqr 2^-515: reports success");
assert_eq(cx_abs(cmat_get(_cq_R, 1, 1)), f64_mul(f64_from(5), (1023 - 515) << 52),
  "cqr 2^-515: |R11| is EXACTLY 5c (2.22.1 returned 3c -- the reflector was skipped)");
assert_eq(HComplex_re(cmat_get(_cq_R, 2, 1)), 0,
  "cqr 2^-515: R is upper triangular (2.22.1 left R21 = 4c, i.e. R == A)");
# ⚠ And far deeper, so this cannot pass by a threshold moved one binade.
assert_eq(is_ok(_cq_run(1000, _cq_R)), 1, "cqr 2^-1000: reports success");
assert_eq(cx_abs(cmat_get(_cq_R, 1, 1)), f64_mul(f64_from(5), (1023 - 1000) << 52),
  "cqr 2^-1000: |R11| still exactly 5c, 485 binades below the old cliff");
assert_eq(HComplex_re(cmat_get(_cq_R, 2, 1)), 0, "cqr 2^-1000: still upper triangular");
# ⚠ CONTROL above the boundary, so the four above cannot pass on a routine that
# has merely become uniformly different.
assert_eq(is_ok(_cq_run(100, _cq_R)), 1, "cqr 2^-100 (control): reports success");
assert_eq(cx_abs(cmat_get(_cq_R, 1, 1)), f64_mul(f64_from(5), (1023 - 100) << 52),
  "cqr 2^-100 (control): exactly 5c, as it already was");

# ⛔ 2.23.0 -- AND A DEFECT 2.22.0 INTRODUCED, FOUND ONLY BECAUSE THIS RELEASE
# WENT LOOKING AT A SITE NO FIXTURE REACHED. 2.22.0 replaced an absolute gate on
# the PHASE with `cx_div(x1, |x1|)`, which is only as good as `cx_abs(x1)` -- and
# for a SUBNORMAL x1 that modulus is quantised onto the subnormal grid, so the
# quotient is not a unit complex number. The Householder needs |phase| EXACTLY 1
# and degrades in proportion to ||phase| - 1|, which reaches **+0.414** at the
# floor. 2.21.0's phase = 1 fallback was ACCIDENTALLY EXACT in that band, so
# 2.22.0 traded 1 row right for 38 wrong. Repaired by scaling x1 to O(1) first --
# the phase is scale-invariant, so nothing above the subnormal band moves.
# ⚠ THE DIRECTION IS LOAD-BEARING AND A PYTHAGOREAN TRIPLE CANNOT SEE THIS:
# x1 = (3,4)*t is clean at every t because |x1| = 5t is exactly representable.
# (1,1) has modulus t*sqrt(2), which is off the grid. A fixture built the obvious
# way would have passed on the defective tree.
# [measured: 1075-row phase sweep with an isolating revert, 2026-09-11]
fn _cq_ph(sub, R) {
    var A = cmat_new(3, 3);
    for (var i = 0; i < 3; i = i + 1) {
        for (var j = 0; j < 3; j = j + 1) { cmat_set(A, i, j, cx_new(0, 0)); }
    }
    # ⚠ 3.3.3 — this line read "max|A| = 1 pins the balance to the identity, so this
    # isolates the phase". Since 3.3.3 cqr_decompose balances from both ends, which
    # lifts this block into the normal range, so x1 is normal here and these rows no
    # longer reach the phase scaling; the R4lp block below has a fixture that does.
    cmat_set(A, 0, 0, cx_new(F64_ONE, 0));
    cmat_set(A, 1, 1, cx_new(sub, sub));
    cmat_set(A, 1, 2, cx_new(sub, 0));
    cmat_set(A, 2, 1, cx_new(sub, 0));
    cmat_set(A, 2, 2, cx_new(f64_mul(F64_TWO, sub), 0));
    var Q = cmat_new(3, 3);
    return cqr_decompose(A, Q, R);
}

# ⚠ `1 << k` is the SUBNORMAL form and is only that for k <= 51; above it the bit
# pattern exceeds 2^52 and is an ordinary NORMAL double. 40 gives 2^-1034.
assert_eq(is_ok(_cq_ph(1 << 40, _cq_R)), 1, "cqr [1] (+) 2^-1034 block: reports success");
assert_eq(HComplex_re(cmat_get(_cq_R, 2, 1)), 0,
  "cqr [1] (+) 2^-1034 block: R21 is 0 (zeroed by contract since 2.23.0; 2.22.0 left A[2][1])");
assert_eq(is_ok(_cq_ph(1 << 4, _cq_R)), 1, "cqr [1] (+) 2^-1070 block: reports success");
assert_eq(HComplex_re(cmat_get(_cq_R, 2, 1)), 0,
  "cqr [1] (+) 2^-1070 block: R21 is 0 (zeroed by contract; the balance lifts x1, no phase test)");

# === 3.3.3 R4lp: cqr phase with x1 still subnormal after the balance ===
# The 2.23.0 phase scaling (`xs = x1 / max(|re x1|, |im x1|)` before `cx_abs`) is
# only reached when x1 is SUBNORMAL after the balance, and since 3.3.3 the balance
# lifts every block that can be lifted. So the lead here BLOCKS the lift: with
# m = 3 the headroom is 48, 1.64 * 2^1017 * 48 is finite and twice it is not, so the
# scale stays 1 and x1 = (u, u) stays at the very bottom (u = 2^-1074), while the
# column below it is normal (s = 1.54 * 2^-990, full mantissa). The column's norm
# is s to 1e-300, so R11 = -phase * s with phase = (1 + i) / sqrt(2): each part is
# s / sqrt(2), 0x02116c51021f68ec correctly rounded; the routine returns ...ed, one
# ulp off through two roundings (the unit phase, then phase * norm). Without the
# scaling `cx_abs((u, u))` rounds sqrt(2) u to u, the phase is (1, 1), the
# reflector no longer maps x onto e1, and R11 comes back 0x02106d3a06d3a06c, 0.4%
# short, with rc = OK. (3.3.2 returned R11 = 0 here: its one-ended balance divided
# the whole block by 2^1017, to zero.)
# [measured: scratch probes on this tree, 3.3.2 and the `var xs = x1;` mutant, not reproducible in-tree, 2026-10-01]
fn _r4lp_cq_ph(R) {
    var A = cmat_new(3, 3);
    for (var i = 0; i < 3; i = i + 1) {
        for (var j = 0; j < 3; j = j + 1) { cmat_set(A, i, j, cx_new(0, 0)); }
    }
    cmat_set(A, 0, 0, cx_new(0x7F8A3D70A3D70A3D, 0));    # 1.64 * 2^1017
    cmat_set(A, 1, 1, cx_new(1, 1));                      # (u, u)
    cmat_set(A, 2, 1, cx_new(0x0218A3D70A3D70A3, 0));     # s
    cmat_set(A, 2, 2, cx_new(0x0218A3D70A3D70A3, 0));
    var rt, rv = cqr_decompose(A, cmat_new(3, 3), R);
    if (rt != 0) { return rv; }
    return HSB_ERR_NONE;
}
var _r4lp_phR = cmat_new(3, 3);
assert_eq(_r4lp_cq_ph(_r4lp_phR), HSB_ERR_NONE, "cqr subnormal x1 under a normal column: reports success");
assert_eq(HComplex_re(cmat_get(_r4lp_phR, 1, 1)), 0x82116c51021f68ed,
  "cqr subnormal x1: Re R11 = -s / sqrt(2) to 1 ulp (phase from the unscaled x1: 0.4% short)");
assert_eq(HComplex_im(cmat_get(_r4lp_phR, 1, 1)), 0x82116c51021f68ed,
  "cqr subnormal x1: Im R11 = -s / sqrt(2) to 1 ulp (phase from the unscaled x1: 0.4% short)");

# === 3.3.3 G1: cqr_decompose two-ended balance (D010) ===
# ⛔ 3.3.3 — `cqr_decompose` STILL BALANCED ONE-ENDED, `pow2_floor(max|A|)`: the
# form 2.22.1 proved lossy and replaced in svd_golub_kahan and eigen_qr only. The
# cqr fixtures above all have a leading 1 or a uniform scale, so none could see it.
# A = diag(lead) (+) k * [[3,1],[4,2]]. The block's |R| is exactly k * {5, 11/5, 2/5}
# (|col 1|, col1.col2 / |col 1|, |det| / |col 1|) at every lead; with k = 6u
# (u = 2^-1074) that is {30, 13.2, 2.4} units, correctly rounded 30, 13 and 2, and
# with k = 2^14 u it is 0x14000, 0x8ccd and 0x199a -- settled independently by a
# 400-digit Cholesky of the exact Gram matrix. 3.3.2 returned 32, 16, 0 at lead 9
# and 0, 0, 0 at lead 1000, with rc = OK.
# ⚠ 3.3.3 — AND THIS BALANCE LIFTS THE `_cq_ph` BLOCK ABOVE INTO THE NORMAL RANGE, so
# its premise ("max|A| = 1 pins the balance to the identity") no longer holds: x1 is
# normal on those two rows and the phase scaling has nothing to correct there. They
# did not pin it on 3.3.2 either: R21 is zeroed by contract, and the phase mutant
# (`var xs = x1;`) passed all five suites on both trees until the R4lp block after
# them, whose lead blocks the lift.
# [measured: scratch probes + mutant runs vs a 400-digit oracle, not reproducible in-tree, 2026-10-01; cycc 6.6.12]
fn _g1_cq_lead(lead, k, imag, R) {
    var A = cmat_new(3, 3);
    for (var i = 0; i < 3; i = i + 1) {
        for (var j = 0; j < 3; j = j + 1) { cmat_set(A, i, j, cx_new(0, 0)); }
    }
    cmat_set(A, 0, 0, cx_new(lead, 0));
    if (imag == 0) {
        cmat_set(A, 1, 1, cx_new(3 * k, 0));
        cmat_set(A, 1, 2, cx_new(k, 0));
        cmat_set(A, 2, 1, cx_new(4 * k, 0));
        cmat_set(A, 2, 2, cx_new(2 * k, 0));
    } else {
        # The same block times i: the Gram matrix, hence |R|, is unchanged.
        cmat_set(A, 1, 1, cx_new(0, 3 * k));
        cmat_set(A, 1, 2, cx_new(0, k));
        cmat_set(A, 2, 1, cx_new(0, 4 * k));
        cmat_set(A, 2, 2, cx_new(0, 2 * k));
    }
    var Q = cmat_new(3, 3);
    var rt, rv = cqr_decompose(A, Q, R);
    if (rt != 0) { return rv; }
    return HSB_ERR_NONE;
}
# |re| of R[i][j] (imag == 0) or |im| (imag == 1), as raw bits.
fn _g1_cq_mag(R, i, j, imag) {
    if (imag == 0) { return f64_abs(HComplex_re(cmat_get(R, i, j))); }
    return f64_abs(HComplex_im(cmat_get(R, i, j)));
}

var _g1_cqR = cmat_new(3, 3);
assert_eq(_g1_cq_lead(f64_from(9), 6, 0, _g1_cqR), HSB_ERR_NONE, "cqr lead 9: reports success");
assert_eq(_g1_cq_mag(_g1_cqR, 0, 0, 0), f64_from(9), "cqr lead 9: |R00| is the lead, exactly");
assert_eq(_g1_cq_mag(_g1_cqR, 1, 1, 0), 30, "cqr lead 9: |R11| is 30 units (3.3.2: 32)");
assert_eq(_g1_cq_mag(_g1_cqR, 1, 2, 0), 13, "cqr lead 9: |R12| is 13 units, 13.2 rounded (3.3.2: 16)");
assert_eq(_g1_cq_mag(_g1_cqR, 2, 2, 0), 2, "cqr lead 9: |R22| is 2 units, 2.4 rounded (3.3.2: 0)");
assert_eq(_g1_cq_lead(f64_from(1000), 6, 0, _g1_cqR), HSB_ERR_NONE, "cqr lead 1000: reports success");
assert_eq(_g1_cq_mag(_g1_cqR, 1, 1, 0), 30, "cqr lead 1000: |R11| is 30 units (3.3.2: 0, block wiped)");
assert_eq(_g1_cq_mag(_g1_cqR, 1, 2, 0), 13, "cqr lead 1000: |R12| is 13 units (3.3.2: 0)");
assert_eq(_g1_cq_mag(_g1_cqR, 2, 2, 0), 2, "cqr lead 1000: |R22| is 2 units (3.3.2: 0)");
# ⚠ A wider block 2^14 units up, where 3.3.2 was off in the low bits rather than wiped.
assert_eq(_g1_cq_lead(f64_from(9), 1 << 14, 0, _g1_cqR), HSB_ERR_NONE, "cqr lead 9, 2^14u block: success");
assert_eq(_g1_cq_mag(_g1_cqR, 1, 1, 0), 0x14000, "cqr lead 9, 2^14u block: |R11| = 0x14000, exactly 5k");
assert_eq(_g1_cq_mag(_g1_cqR, 1, 2, 0), 0x8ccd, "cqr lead 9, 2^14u block: |R12| = 0x8ccd (3.3.2: 0x8cd0)");
assert_eq(_g1_cq_mag(_g1_cqR, 2, 2, 0), 0x199a, "cqr lead 9, 2^14u block: |R22| = 0x199a (3.3.2: 0x1998)");
# ⚠ The tiny entries in the IMAGINARY parts: the balance divides re and im
# separately, so the smallest-entry scan must read both. R is i times the real
# block's R, so Re R22 is zero (its sign is incidental).
assert_eq(_g1_cq_lead(f64_from(9), 6, 1, _g1_cqR), HSB_ERR_NONE, "cqr lead 9, imaginary block: success");
assert_eq(_g1_cq_mag(_g1_cqR, 1, 1, 1), 30, "cqr lead 9, imaginary block: |Im R11| is 30 units (3.3.2: 32)");
assert_eq(_g1_cq_mag(_g1_cqR, 1, 2, 1), 13, "cqr lead 9, imaginary block: |Im R12| is 13 units (3.3.2: 16)");
assert_eq(_g1_cq_mag(_g1_cqR, 2, 2, 1), 2, "cqr lead 9, imaginary block: |Im R22| is 2 units (3.3.2: 0)");
assert_eq(f64_eq(HComplex_re(cmat_get(_g1_cqR, 2, 2)), 0), 1,
  "cqr lead 9, imaginary block: Re R22 is zero (sign incidental)");
# ⚠ CONTROL: lead 1 pins the old scale to the identity, so 3.3.2 was right here too.
assert_eq(_g1_cq_lead(F64_ONE, 6, 0, _g1_cqR), HSB_ERR_NONE, "cqr lead 1 (control): success");
assert_eq(_g1_cq_mag(_g1_cqR, 1, 1, 0), 30, "cqr lead 1 (control): |R11| is 30 units, as it already was");
assert_eq(_g1_cq_mag(_g1_cqR, 2, 2, 0), 2, "cqr lead 1 (control): |R22| is 2 units, as it already was");

# ⚠ AND THE HEADROOM. The svd / eigen exit stops only when max / sc itself would
# overflow; reused here unchanged it puts the balanced max at 2^1023, the first
# reflector overflows, and with no convergence loop to fail cqr returns rc = OK and
# NaN in R. A = [[3H,H,0],[4H,2H,0],[0,0,u]], H = 2^1000: block-diagonal, so
# |R00| = |(3H, 4H)| = 5H exactly and |R22| = u exactly. 3.3.2 returned R22 = 0;
# growth 1 returns every upper entry NaN.
# [measured: scratch probes on the 3.3.2 bundle and a growth-1 build, 2026-10-01; cycc 6.6.12]
fn _g1_cq_span(R) {
    var H = (1023 + 1000) << 52;
    var A = cmat_new(3, 3);
    for (var i = 0; i < 3; i = i + 1) {
        for (var j = 0; j < 3; j = j + 1) { cmat_set(A, i, j, cx_new(0, 0)); }
    }
    cmat_set(A, 0, 0, cx_new(f64_mul(f64_from(3), H), 0));
    cmat_set(A, 0, 1, cx_new(H, 0));
    cmat_set(A, 1, 0, cx_new(f64_mul(f64_from(4), H), 0));
    cmat_set(A, 1, 1, cx_new(f64_mul(F64_TWO, H), 0));
    cmat_set(A, 2, 2, cx_new(1, 0));
    var Q = cmat_new(3, 3);
    var rt, rv = cqr_decompose(A, Q, R);
    if (rt != 0) { return rv; }
    return HSB_ERR_NONE;
}
var _g1_cqS = cmat_new(3, 3);
assert_eq(_g1_cq_span(_g1_cqS), HSB_ERR_NONE, "cqr 2^1000 / 2^-1074 span: reports success");
assert_eq(_g1_cq_mag(_g1_cqS, 0, 0, 0), f64_mul(f64_from(5), (1023 + 1000) << 52),
  "cqr span: |R00| is 5H exactly (growth 1: NaN)");
assert_eq(_g1_cq_mag(_g1_cqS, 2, 2, 0), 1, "cqr span: |R22| is the 2^-1074 entry exactly (3.3.2: 0)");
var _g1_cq_nf = 0;
for (var _g1_i = 0; _g1_i < 3; _g1_i = _g1_i + 1) {
    for (var _g1_j = 0; _g1_j < 3; _g1_j = _g1_j + 1) {
        var _g1_z = cmat_get(_g1_cqS, _g1_i, _g1_j);
        if (f64_lt(f64_abs(HComplex_re(_g1_z)), F64_POS_INF) == 0) { _g1_cq_nf = _g1_cq_nf + 1; }
        if (f64_lt(f64_abs(HComplex_im(_g1_z)), F64_POS_INF) == 0) { _g1_cq_nf = _g1_cq_nf + 1; }
    }
}
assert_eq(_g1_cq_nf, 0, "cqr span: all 18 components of R are finite");

# ⚠ THE HEADROOM IS 16 m, PINNED ON ITS BOUNDARY FROM ABOVE. With max|A| = 2^1018
# and m = 3, 2^1018 * 48 = 1.5 * 2^1023 keeps sc = 1 and the odd 3u entry exact; one
# binade more growth (16 (m + n) = 96) forces sc = 2, 3u / 2 rounds to 2u, and R22
# comes back 4u. The wide 2x4 separates m from n the same way at 2^1018: 16 m = 32
# keeps 3u, 16 n = 64 returns 4u. |R| is the entries' moduli, the matrices being
# diagonal up to a zero column. 3.3.2 returned 0 for both; growth 1, NaN.
# ⚠ A SMALLER growth is not caught here (4 and 8 left no row non-finite in the
# 6086-row sweep). The two blocks after this one pin growth 2, 4, 8 and m from
# below; 2 m and 4 m still pass every fixture, though both are under the derived
# 5.5 m bound.
# [measured: scratch probes on 3.3.2, this tree and growth 1 / 16 n / 16 (m + n) builds, 2026-10-01; cycc 6.6.12]
var _g1_gbA = cmat_new(3, 3);
for (var _g1_k = 0; _g1_k < 9; _g1_k = _g1_k + 1) { cmat_set(_g1_gbA, _g1_k / 3, _g1_k % 3, cx_new(0, 0)); }
cmat_set(_g1_gbA, 0, 0, cx_new((1023 + 1018) << 52, 0));
cmat_set(_g1_gbA, 1, 1, cx_new((1023 + 1018) << 52, 0));
cmat_set(_g1_gbA, 2, 2, cx_new(3, 0));
var _g1_gbR = cmat_new(3, 3);
var _g1_gbt, _g1_gbv = cqr_decompose(_g1_gbA, cmat_new(3, 3), _g1_gbR);
assert_eq(is_ok(_g1_gbt), 1, "cqr growth boundary 3x3: reports success");
assert_eq(_g1_cq_mag(_g1_gbR, 0, 0, 0), (1023 + 1018) << 52, "cqr growth boundary 3x3: |R00| is 2^1018 exactly");
assert_eq(_g1_cq_mag(_g1_gbR, 2, 2, 0), 3, "cqr growth boundary 3x3: |R22| is 3u exactly (16 (m + n): 4u)");
var _g1_gwA = cmat_new(2, 4);
for (var _g1_kw = 0; _g1_kw < 8; _g1_kw = _g1_kw + 1) { cmat_set(_g1_gwA, _g1_kw / 4, _g1_kw % 4, cx_new(0, 0)); }
cmat_set(_g1_gwA, 0, 0, cx_new((1023 + 1018) << 52, 0));
cmat_set(_g1_gwA, 1, 3, cx_new(3, 0));
var _g1_gwR = cmat_new(2, 4);
var _g1_gwt, _g1_gwv = cqr_decompose(_g1_gwA, cmat_new(2, 2), _g1_gwR);
assert_eq(is_ok(_g1_gwt), 1, "cqr growth boundary 2x4: reports success");
assert_eq(_g1_cq_mag(_g1_gwR, 1, 3, 0), 3, "cqr growth boundary 2x4: |R13| is 3u exactly (16 n: 4u)");

# === 3.3.3 R4lp: cqr headroom, the lower side ===
# The block above pins 16 m from above. Nothing pinned it from below, and growth 2
# and 4 passed every suite while returning rc = OK with an infinite R; these two
# columns catch the small constants (growth 2, 4 and 8), not every growth under the
# 5.5 m bound -- see the R5lp block after this one. A column of m equal entries
# (H, H), H = 1.9 * 2^1000, beside a 2^-1074 entry (which forces the
# lift up to the headroom): |R00| = sqrt(2 m) H, each part -sqrt(m) H. Growth 4
# returns R00 = -Inf - Inf i at m = 5, growth 8 at m = 24, growth 2 NaN at both;
# 8 m and 16 m return the values below, which the 60-digit oracle puts 1 ulp and
# 7 ulp from -sqrt(m) H (0x...f539 and 0x...45ec). R11 is the 2^-1074 entry, exact.
# [measured: growth 2 / 4 / 8 / 8 m / 16 m builds + a 60-digit oracle, not reproducible in-tree, 2026-10-01]
fn _r4lp_cq_col(m, R) {
    var A = cmat_new(m, 2);
    for (var i = 0; i < m; i = i + 1) {
        cmat_set(A, i, 0, cx_new(0x7E7E666666666666, 0x7E7E666666666666));
        cmat_set(A, i, 1, cx_new(0, 0));
    }
    cmat_set(A, 0, 1, cx_new(1, 0));
    var rt, rv = cqr_decompose(A, cmat_new(m, m), R);
    if (rt != 0) { return rv; }
    return HSB_ERR_NONE;
}
var _r4lp_c5 = cmat_new(5, 2);
assert_eq(_r4lp_cq_col(5, _r4lp_c5), HSB_ERR_NONE, "cqr 5x2 (H, H) column: reports success");
assert_eq(HComplex_re(cmat_get(_r4lp_c5, 0, 0)), 0xfe90fe7e6d69f53a,
  "cqr 5x2 (H, H) column: Re R00 = -sqrt(5) H to 1 ulp (growth 4: -Inf)");
assert_eq(HComplex_im(cmat_get(_r4lp_c5, 0, 0)), 0xfe90fe7e6d69f53a,
  "cqr 5x2 (H, H) column: Im R00 = -sqrt(5) H to 1 ulp (growth 4: -Inf)");
assert_eq(HComplex_re(cmat_get(_r4lp_c5, 1, 1)), 1, "cqr 5x2 (H, H) column: R11 is the 2^-1074 entry");
var _r4lp_c24 = cmat_new(24, 2);
assert_eq(_r4lp_cq_col(24, _r4lp_c24), HSB_ERR_NONE, "cqr 24x2 (H, H) column: reports success");
assert_eq(HComplex_re(cmat_get(_r4lp_c24, 0, 0)), 0xfea29dba2ca245f3,
  "cqr 24x2 (H, H) column: Re R00 = -sqrt(24) H to 7 ulp (growth 8: -Inf)");
assert_eq(HComplex_im(cmat_get(_r4lp_c24, 0, 0)), 0xfea29dba2ca245f3,
  "cqr 24x2 (H, H) column: Im R00 = -sqrt(24) H to 7 ulp (growth 8: -Inf)");

# === 3.3.3 R5lp: cqr headroom, a growth that scales with m ===
# The two columns above leave a growth of m (the dimension, not 16 times it) passing
# every suite, and growth m returns rc = OK with a non-finite R on the smallest
# shapes. With h = 1.5 * 2^1000 and u = 2^-1074: for [[(h, h), (u, 0)]] the routine's
# R00 = -phase * |x| is -x itself, so Q = -1 and R = -A exactly, R00 = (-h, -h) and
# R01 = (-u, 0); growth m returns every part of R NaN. The column [[(h, h), 0],
# [(h, h), u]] has |R00| = 2h, each part -sqrt(2) h, whose correctly rounded value
# is 0xfe80f876ccdf6cd9; the routine returns ...cda, 1 ulp above it in magnitude
# (0.58 ulp of error), and growth m returns -Inf for both parts. ⚠ Growth 2 m, 4 m
# and 8 m return these same bits and pass every suite: under the 5.5 m bound, 2 m
# and 4 m are still unpinned.
# [measured: growth m / 2 m / 4 m / 8 m / 16 m builds + an 80-digit Decimal check, not reproducible in-tree, 2026-10-01]
fn _r5lp_cq_hh(m, R) {
    var A = cmat_new(m, 2);
    for (var i = 0; i < m; i = i + 1) {
        cmat_set(A, i, 0, cx_new(0x7E78000000000000, 0x7E78000000000000));
        cmat_set(A, i, 1, cx_new(0, 0));
    }
    cmat_set(A, m - 1, 1, cx_new(1, 0));
    var rt, rv = cqr_decompose(A, cmat_new(m, m), R);
    if (rt != 0) { return rv; }
    return HSB_ERR_NONE;
}
var _r5lp_c1 = cmat_new(1, 2);
assert_eq(_r5lp_cq_hh(1, _r5lp_c1), HSB_ERR_NONE, "cqr [[(h, h), (u, 0)]]: reports success");
assert_eq(HComplex_re(cmat_get(_r5lp_c1, 0, 0)), 0xFE78000000000000,
  "cqr [[(h, h), (u, 0)]]: Re R00 = -h exactly (growth m: NaN)");
assert_eq(HComplex_im(cmat_get(_r5lp_c1, 0, 0)), 0xFE78000000000000,
  "cqr [[(h, h), (u, 0)]]: Im R00 = -h exactly (growth m: NaN)");
assert_eq(HComplex_re(cmat_get(_r5lp_c1, 0, 1)), 0x8000000000000001,
  "cqr [[(h, h), (u, 0)]]: Re R01 = -u exactly (growth m: NaN)");
assert_eq(f64_eq(HComplex_im(cmat_get(_r5lp_c1, 0, 1)), 0), 1,
  "cqr [[(h, h), (u, 0)]]: Im R01 = 0, sign incidental (growth m: NaN)");
var _r5lp_c2 = cmat_new(2, 2);
assert_eq(_r5lp_cq_hh(2, _r5lp_c2), HSB_ERR_NONE, "cqr [[(h, h), 0], [(h, h), u]]: reports success");
assert_eq(HComplex_re(cmat_get(_r5lp_c2, 0, 0)), 0xFE80F876CCDF6CDA,
  "cqr [[(h, h), 0], [(h, h), u]]: Re R00 = -sqrt(2) h, 1 ulp above the correctly rounded (growth m: -Inf)");
assert_eq(HComplex_im(cmat_get(_r5lp_c2, 0, 0)), 0xFE80F876CCDF6CDA,
  "cqr [[(h, h), 0], [(h, h), u]]: Im R00 = -sqrt(2) h, 1 ulp above the correctly rounded (growth m: -Inf)");

# ================================================================
# 2.23.0 -- THE RIGHT HOUSEHOLDER REFLECTOR, PINNED AT LAST
# ================================================================
# ⛔ `_lp_bidiagonalize` applies a LEFT reflector per column and a RIGHT one per
# row. Every fixture this suite has ever had reaches the LEFT one. 2.22.0 and
# 2.22.1 repaired the right one **on the SHAPE** -- because repairing one side of
# a pair is how 2.18.0's U-replay defect was created -- and the roadmap carried
# that as unproven in both directions. It is proven now, and BOTH repairs are
# load-bearing.
# ⭐ A = diag(c,c,c,1) with A[0][2] = t puts a small off-diagonal where only the
# right reflector can see it. The trailing block is [[c,t],[0,c]], whose singular
# values are c*(sqrt(1 + (t/2c)^2) +- t/2c) -- so the spectrum has a RELATIVE
# SPREAD of exactly t/c, in closed form, needing no reference implementation.
# With c and t exact powers of two the whole fixture is exact.
# ⛔ 2.21.0 returns all three small singular values IDENTICAL -- the entire spread
# erased, relative error 2.384e-07 against the closed form. Repaired: 5.06e-17,
# i.e. sub-ulp, with the spread reproduced to seven digits.
# ⚠ DO NOT ACCEPT THIS WITH `prod(S) == |det A|`. That identity is ANALYTICALLY
# BLIND here: the defect replaces {c(1+d), c, c(1-d)} with {c, c, c}, and
# (1+d)(1-d) = 1 - d^2 differs from 1 only at second order -- measured 1.24e-15
# while a singular value is 2.4e-7 wrong. The discriminator is the SPREAD.
# [measured: 128-fixture sweep across 4 trees + an isolating gate revert, 2026-09-11]
fn _rr_run(which, S) {
    var c = (1023 - 20) << 52;               # 2^-20
    var t = (1023 - 41) << 52;               # 2^-41, so the spread is t/c = 2^-21
    # ⚠ The third case is NOT a deeper version of the first: it is sized so the
    # right reflector's NORM is normal while its `vtv_r` is SUBNORMAL, which is
    # the band the 2.22.0 gate repair cannot reach and only the 2.22.1
    # normalisation fixes. c = 2^-500, t = 2^-515 gives vtv_r ~ 2^-1028.
    if (which == 2) {
        c = (1023 - 500) << 52;
        t = (1023 - 515) << 52;
    }
    var A = ganita_mat_new(4, 4);
    for (var i = 0; i < 4; i = i + 1) {
        for (var j = 0; j < 4; j = j + 1) { ganita_mat_set(A, i, j, 0); }
    }
    if (which == 1) {
        # The cyclic-shift conjugate: this reaches the k=1 call site, not k=0.
        ganita_mat_set(A, 0, 0, F64_ONE);
        ganita_mat_set(A, 1, 1, c);
        ganita_mat_set(A, 2, 2, c);
        ganita_mat_set(A, 3, 3, c);
        ganita_mat_set(A, 1, 3, t);
    } else {
        ganita_mat_set(A, 0, 0, c);
        ganita_mat_set(A, 1, 1, c);
        ganita_mat_set(A, 2, 2, c);
        ganita_mat_set(A, 3, 3, F64_ONE);
        ganita_mat_set(A, 0, 2, t);
    }
    var U = ganita_mat_new(4, 4);
    var Vt = ganita_mat_new(4, 4);
    for (var k = 0; k < 4; k = k + 1) { store64(S + k * 8, 0); }
    return svd_golub_kahan(A, U, S, Vt);
}

var _rr_S = alloc(32);
# --- k = 0 call site
assert_eq(is_ok(_rr_run(0, _rr_S)), 1, "svd right-reflector k=0: reports success");
assert_eq(f64_gt(load64(_rr_S + 8), load64(_rr_S + 16)), 1,
  "svd right-reflector k=0: S1 > S2 (2.21.0 returned all three EQUAL)");
assert_eq(f64_gt(load64(_rr_S + 16), load64(_rr_S + 24)), 1,
  "svd right-reflector k=0: S2 > S3 -- the spread exists at all");
# The spread is t/c = 2^-21 in closed form. 2.21.0 gives exactly 0.
assert_eq(f64_approx_eq(f64_div(f64_div(f64_sub(load64(_rr_S + 8), load64(_rr_S + 24)),
        load64(_rr_S + 16)), (1023 - 21) << 52), F64_ONE, LP_T_RELTOL), 1,
  "svd right-reflector k=0: the relative spread is t/c = 2^-21, as the closed form says");

# --- k = 1 call site, which a k=0 fixture does not reach
assert_eq(is_ok(_rr_run(1, _rr_S)), 1, "svd right-reflector k=1: reports success");
assert_eq(f64_gt(load64(_rr_S + 8), load64(_rr_S + 24)), 1,
  "svd right-reflector k=1: the spread survives at the OTHER call site too");

# --- vtv_r subnormal: the band the gate repair alone cannot reach
assert_eq(is_ok(_rr_run(2, _rr_S)), 1, "svd right-reflector, vtv_r subnormal: success");
assert_eq(f64_gt(load64(_rr_S + 8), load64(_rr_S + 24)), 1,
  "svd right-reflector: spread survives where vtv_r is SUBNORMAL (2.22.0 lost it too)");

var LP_T_BIG = 0x6974E718D7D7625A;   # 1e200
var lpo_A = ganita_mat_new(3, 3);
ganita_mat_set(lpo_A, 0, 0, f64_mul(F64_ONE, LP_T_BIG));
ganita_mat_set(lpo_A, 0, 1, f64_mul(F64_TWO, LP_T_BIG));
ganita_mat_set(lpo_A, 0, 2, f64_mul(f64_from(3), LP_T_BIG));
ganita_mat_set(lpo_A, 1, 0, f64_mul(f64_from(4), LP_T_BIG));
ganita_mat_set(lpo_A, 1, 1, f64_mul(f64_from(5), LP_T_BIG));
ganita_mat_set(lpo_A, 1, 2, f64_mul(f64_from(6), LP_T_BIG));
ganita_mat_set(lpo_A, 2, 0, f64_mul(f64_from(7), LP_T_BIG));
ganita_mat_set(lpo_A, 2, 1, f64_mul(f64_from(8), LP_T_BIG));
ganita_mat_set(lpo_A, 2, 2, f64_mul(f64_from(10), LP_T_BIG));
var lpo_U = ganita_mat_new(3, 3);
var lpo_Vt = ganita_mat_new(3, 3);
var lpo_S = alloc(24);
var _rq75t, _rq75v = svd_golub_kahan(lpo_A, lpo_U, lpo_S, lpo_Vt);
assert_eq(is_ok(_rq75t), 1, "svd @1e200: converges (was HSB_ERR_NO_CONVERGENCE, U all NaN)");
# 17.412505166808593 * 1e200
assert(lp_test_relclose(load64(lpo_S), 0x69B6BF80142486CE) == 1,
  "svd @1e200: S[0] == 1.7412505166808593e201");

var LP_T_TINY = 0x16687E92154EF7AC;   # 1e-200
var lpu_A = ganita_mat_new(3, 3);
ganita_mat_set(lpu_A, 0, 0, f64_mul(F64_ONE, LP_T_TINY));
ganita_mat_set(lpu_A, 0, 1, f64_mul(F64_TWO, LP_T_TINY));
ganita_mat_set(lpu_A, 0, 2, f64_mul(f64_from(3), LP_T_TINY));
ganita_mat_set(lpu_A, 1, 0, f64_mul(f64_from(4), LP_T_TINY));
ganita_mat_set(lpu_A, 1, 1, f64_mul(f64_from(5), LP_T_TINY));
ganita_mat_set(lpu_A, 1, 2, f64_mul(f64_from(6), LP_T_TINY));
ganita_mat_set(lpu_A, 2, 0, f64_mul(f64_from(7), LP_T_TINY));
ganita_mat_set(lpu_A, 2, 1, f64_mul(f64_from(8), LP_T_TINY));
ganita_mat_set(lpu_A, 2, 2, f64_mul(f64_from(10), LP_T_TINY));
var lpu_U = ganita_mat_new(3, 3);
var lpu_Vt = ganita_mat_new(3, 3);
var lpu_S = alloc(24);
var _rq76t, _rq76v = svd_golub_kahan(lpu_A, lpu_U, lpu_S, lpu_Vt);
assert_eq(is_ok(_rq76t), 1, "svd @1e-200: returns ERR_NONE");
# 17.412505166808593 * 1e-200; the underflowed path returned 1e-199 (= raw A[2][2])
# [measured: tests/hisab.tcyr "svd @1e-200" relclose assert below, whose message records the 1e-199; CHANGELOG.md 2.7.0]
assert(lp_test_relclose(load64(lpu_S), 0x16AAA8257F7EC875) == 1,
  "svd @1e-200: S[0] == 1.7412505166808593e-199 (was 1e-199, the raw A[2][2])");

var lpo_E = ganita_mat_new(3, 3);
ganita_mat_set(lpo_E, 0, 0, f64_mul(f64_from(4), LP_T_BIG));
ganita_mat_set(lpo_E, 0, 1, f64_mul(F64_ONE, LP_T_BIG));
ganita_mat_set(lpo_E, 0, 2, f64_from(0));
ganita_mat_set(lpo_E, 1, 0, f64_mul(F64_ONE, LP_T_BIG));
ganita_mat_set(lpo_E, 1, 1, f64_mul(f64_from(3), LP_T_BIG));
ganita_mat_set(lpo_E, 1, 2, f64_mul(F64_ONE, LP_T_BIG));
ganita_mat_set(lpo_E, 2, 0, f64_from(0));
ganita_mat_set(lpo_E, 2, 1, f64_mul(F64_ONE, LP_T_BIG));
ganita_mat_set(lpo_E, 2, 2, f64_mul(F64_TWO, LP_T_BIG));
var lpo_ev = alloc(24);
var lpo_EV = ganita_mat_new(3, 3);
var _rq77t, _rq77v = eigen_qr(lpo_E, 3, 10000, lpo_ev, lpo_EV);
assert_eq(is_ok(_rq77t), 1, "eigen_qr @1e200: converges (was HSB_ERR_NO_CONVERGENCE)");
# 4.732050807568877 * 1e200
assert(lp_test_relclose(load64(lpo_ev), 0x6998BA6A7000200E) == 1,
  "eigen_qr @1e200: lambda0 == 4.732050807568877e200");

var lpc_A = cmat_new(2, 2);
cmat_set(lpc_A, 0, 0, cx_new(f64_mul(f64_from(3), LP_T_BIG), f64_from(0)));
cmat_set(lpc_A, 0, 1, cx_new(f64_mul(F64_ONE, LP_T_BIG), f64_from(0)));
cmat_set(lpc_A, 1, 0, cx_new(f64_mul(f64_from(4), LP_T_BIG), f64_from(0)));
cmat_set(lpc_A, 1, 1, cx_new(f64_mul(F64_TWO, LP_T_BIG), f64_from(0)));
var lpc_Q = cmat_new(2, 2);
var lpc_R = cmat_new(2, 2);
var _rq78t, _rq78v = cqr_decompose(lpc_A, lpc_Q, lpc_R);
assert_eq(is_ok(_rq78t), 1, "cqr @1e200: returns ERR_NONE");
# |R[0,0]| must be ||col0|| = 5e200
assert(lp_test_relclose(f64_abs(HComplex_re(cmat_get(lpc_R, 0, 0))), 0x699A20DF0DCD3AF1) == 1,
  "cqr @1e200: |R[0,0]| == 5e200 (was 3e200 -- reflectors skipped, R == A)");
# R must be upper triangular
assert(f64_lt(f64_abs(HComplex_re(cmat_get(lpc_R, 1, 0))), 0x6761F48EAF234AD4) == 1,
  "cqr @1e200: |R[1,0]| < 1e190 (was 4e200 -- R not upper triangular)");

# The band that actually matters. 1e+/-200 are the dramatic endpoints, but the
# measured failure region reaches ordinary magnitudes: across 440 random matrices
# the unbalanced code was correct only in roughly 1 .. 1e23, failing 40/40 at
# scale 1e-10 on a relative reconstruction check. That is SI metres -- a physics
# consumer got silently wrong singular values, with no error code.
# [measured: CHANGELOG.md 2.7.0, 2.7.0-D: "Measured across 440 random matrices ... failed 40/40 at scale 1e-10"]
var LP_T_SI = 0x3DDB7CDFD9D7BDBB;   # 1e-10
var lps_A = ganita_mat_new(3, 3);
ganita_mat_set(lps_A, 0, 0, f64_mul(F64_ONE, LP_T_SI));
ganita_mat_set(lps_A, 0, 1, f64_mul(F64_TWO, LP_T_SI));
ganita_mat_set(lps_A, 0, 2, f64_mul(f64_from(3), LP_T_SI));
ganita_mat_set(lps_A, 1, 0, f64_mul(f64_from(4), LP_T_SI));
ganita_mat_set(lps_A, 1, 1, f64_mul(f64_from(5), LP_T_SI));
ganita_mat_set(lps_A, 1, 2, f64_mul(f64_from(6), LP_T_SI));
ganita_mat_set(lps_A, 2, 0, f64_mul(f64_from(7), LP_T_SI));
ganita_mat_set(lps_A, 2, 1, f64_mul(f64_from(8), LP_T_SI));
ganita_mat_set(lps_A, 2, 2, f64_mul(f64_from(10), LP_T_SI));
var lps_U = ganita_mat_new(3, 3);
var lps_Vt = ganita_mat_new(3, 3);
var lps_S = alloc(24);
var _rq79t, _rq79v = svd_golub_kahan(lps_A, lps_U, lps_S, lps_Vt);
assert_eq(is_ok(_rq79t), 1, "svd @1e-10: returns ERR_NONE");
# 17.412505166808593e-10. Measured pre-fix on THIS matrix: HSB_ERR_NO_CONVERGENCE
# (-8), so here the failure is at least loud. The 40/40 figure above came from a
# relative reconstruction check over random matrices, where the mode varies
# between non-convergence and a silently wrong S -- both are covered, by this
# pair and by the 1e-200 pair above.
# [measured: scratch run on the pre-2.7.0 source, not reproducible in-tree; the 40/40 is CHANGELOG.md 2.7.0's]
assert(lp_test_relclose(load64(lps_S), 0x3E1DEA19CB65B491) == 1,
  "svd @1e-10 (SI metres): S[0] == 1.7412505166808593e-9");

# ================================================================
# 2.7.0-E -- rank-deficient SVD.
#
# A zero DIAGONAL entry inside the active block makes the implicit-shift step a
# no-op: the rotation built from (d^2 - mu, d*f) is a bare sign flip when d == 0,
# so the sweep reproduces the block and spins to max_iter. Every rank-deficient
# input typically reaches that state. This is the zero-diagonal case of
# Golub & Van Loan Alg. 8.6.2, omitted from the original transcription.
#
# CAVEAT on the "s == 0" assertions below: they are NOT standalone. Pre-fix,
# svd_golub_kahan bails before writing out_S at all, so the caller's zero-filled
# alloc satisfies them trivially. They are meaningful only bundled with the
# return-code and reconstruction assertions in the same group.
# ================================================================

test_group("svd_golub_kahan: rank-deficient input has a well-defined SVD");

var A1 = ganita_mat_new(3, 3);
ganita_mat_set(A1, 0, 0, f64_from(1)); ganita_mat_set(A1, 0, 1, f64_from(2)); ganita_mat_set(A1, 0, 2, f64_from(3));
ganita_mat_set(A1, 1, 0, f64_from(2)); ganita_mat_set(A1, 1, 1, f64_from(4)); ganita_mat_set(A1, 1, 2, f64_from(6));
ganita_mat_set(A1, 2, 0, f64_from(3)); ganita_mat_set(A1, 2, 1, f64_from(6)); ganita_mat_set(A1, 2, 2, f64_from(9));
var U1 = ganita_mat_new(3, 3);
var V1 = ganita_mat_new(3, 3);
var S1 = alloc(24);
var _rq80t, _rq80v = svd_golub_kahan(A1, U1, S1, V1);
assert_eq(is_ok(_rq80t), 1, "svd rank-1 3x3: converges");
assert(f64_approx_eq(load64(S1), f64_from(14), LOOSE_TOL_H) == 1, "svd rank-1 3x3: s0 == 14");

# _lp_check_svd is the reconstruction helper defined earlier in this file
_lp_check_svd(A1, 3, 3, U1, S1, V1, "svd rank-1 3x3: A == U*S*Vt");
assert(f64_lt(f64_abs(load64(S1 + 8)), EPSILON_F64) == 1, "svd rank-1 3x3: s1 == 0");
assert(f64_lt(f64_abs(load64(S1 + 16)), EPSILON_F64) == 1, "svd rank-1 3x3: s2 == 0");

# rectangular, rank-2: column 3 = 3 * column 1
var A5 = ganita_mat_new(4, 3);
ganita_mat_set(A5, 0, 0, f64_from(1)); ganita_mat_set(A5, 0, 1, f64_from(2)); ganita_mat_set(A5, 0, 2, f64_from(3));
ganita_mat_set(A5, 1, 0, f64_from(2)); ganita_mat_set(A5, 1, 1, f64_from(4)); ganita_mat_set(A5, 1, 2, f64_from(6));
ganita_mat_set(A5, 2, 0, f64_from(0)); ganita_mat_set(A5, 2, 1, f64_from(1)); ganita_mat_set(A5, 2, 2, f64_from(0));
ganita_mat_set(A5, 3, 0, f64_from(0)); ganita_mat_set(A5, 3, 1, f64_from(2)); ganita_mat_set(A5, 3, 2, f64_from(0));
var U5 = ganita_mat_new(4, 3);
var V5 = ganita_mat_new(3, 3);
var S5 = alloc(24);
var _rq81t, _rq81v = svd_golub_kahan(A5, U5, S5, V5);
assert_eq(is_ok(_rq81t), 1, "svd 4x3 rank-2: converges");
_lp_check_svd(A5, 4, 3, U5, S5, V5, "svd 4x3 rank-2: A == U*S*Vt");

# 5x4 rank-3 (col 3 = 2 * col 1) -- exercises an interior zero diagonal, and
# checks that the fix keeps U and Vt orthogonal rather than merely reconstructing.
var A7 = ganita_mat_new(5, 4);
ganita_mat_set(A7, 0, 0, f64_from(1)); ganita_mat_set(A7, 0, 1, f64_from(5));
ganita_mat_set(A7, 0, 2, f64_from(2)); ganita_mat_set(A7, 0, 3, f64_from(2));
ganita_mat_set(A7, 1, 0, f64_from(3)); ganita_mat_set(A7, 1, 1, f64_from(1));
ganita_mat_set(A7, 1, 2, f64_from(6)); ganita_mat_set(A7, 1, 3, f64_from(6));
ganita_mat_set(A7, 2, 0, f64_from(7)); ganita_mat_set(A7, 2, 1, f64_from(2));
ganita_mat_set(A7, 2, 2, f64_from(14)); ganita_mat_set(A7, 2, 3, f64_from(4));
ganita_mat_set(A7, 3, 0, f64_from(0)); ganita_mat_set(A7, 3, 1, f64_from(4));
ganita_mat_set(A7, 3, 2, f64_from(0)); ganita_mat_set(A7, 3, 3, f64_from(9));
ganita_mat_set(A7, 4, 0, f64_from(2)); ganita_mat_set(A7, 4, 1, f64_from(2));
ganita_mat_set(A7, 4, 2, f64_from(4)); ganita_mat_set(A7, 4, 3, f64_from(1));
var U7 = ganita_mat_new(5, 4);
var V7 = ganita_mat_new(4, 4);
var S7 = alloc(32);
var _rq82t, _rq82v = svd_golub_kahan(A7, U7, S7, V7);
assert_eq(is_ok(_rq82t), 1, "svd 5x4 rank-3: converges");
assert(f64_lt(f64_abs(load64(S7 + 24)), EPSILON_F64) == 1, "svd 5x4 rank-3: s3 == 0");
_lp_check_svd(A7, 5, 4, U7, S7, V7, "svd 5x4 rank-3: A == U*S*Vt");

test_group("3.3.5 svd_golub_kahan / eigen_qr: the zero matrix");
# Equivalent for _lp_balance_scale's lo = +Inf guard, as above: the zero matrix's
# decompositions are what this pins.
var _g362_A = ganita_mat_new(2, 2);
var _g362_U = ganita_mat_new(2, 2);
var _g362_S = alloc(16);
var _g362_Vt = ganita_mat_new(2, 2);
store64(_g362_S, F64_TWO);
store64(_g362_S + 8, F64_TWO);
var _g362_t, _g362_v = svd_golub_kahan(_g362_A, _g362_U, _g362_S, _g362_Vt);
assert_eq(is_ok(_g362_t), 1, "svd_golub_kahan: the zero matrix decomposes");
assert_eq(load64(_g362_S), 0, "svd_golub_kahan: zero A -> sigma_0 = +0");
assert_eq(load64(_g362_S + 8), 0, "svd_golub_kahan: zero A -> sigma_1 = +0");
var _g362_V = ganita_mat_new(2, 2);
var _g362_ev = alloc(16);
store64(_g362_ev, F64_TWO);
store64(_g362_ev + 8, F64_TWO);
var _g362_et, _g362_evv = eigen_qr(_g362_A, 2, 100, _g362_ev, _g362_V);
assert_eq(is_ok(_g362_et), 1, "eigen_qr: the zero matrix decomposes");
assert_eq(load64(_g362_ev), 0, "eigen_qr: zero A -> lambda_0 = +0");
assert_eq(load64(_g362_ev + 8), 0, "eigen_qr: zero A -> lambda_1 = +0");
var _g362_bad = 0;
for (var _g362_i = 0; _g362_i < 2; _g362_i = _g362_i + 1) {
    for (var _g362_j = 0; _g362_j < 2; _g362_j = _g362_j + 1) {
        var _g362_w = 0;
        if (_g362_i == _g362_j) { _g362_w = F64_ONE; }
        if (ganita_mat_get(_g362_U, _g362_i, _g362_j) != _g362_w) { _g362_bad = _g362_bad + 1; }
        if (ganita_mat_get(_g362_Vt, _g362_i, _g362_j) != _g362_w) { _g362_bad = _g362_bad + 1; }
        if (ganita_mat_get(_g362_V, _g362_i, _g362_j) != _g362_w) { _g362_bad = _g362_bad + 1; }
    }
}
assert_eq(_g362_bad, 0, "svd_golub_kahan / eigen_qr: zero A -> U = Vt = V = I exactly");
assert_eq(_lp_balance_scale(_g362_A, 2, 2), F64_ONE,
  "_lp_balance_scale: the zero matrix (lo = +Inf) -> scale 1");

# ================================================================
# 2.8.3 -- the m >= n precondition is CHECKED, not just documented.
#
# A wide matrix ran the whole decomposition and returned HSB_ERR_NONE with
# numbers that are not its singular values. Not a marginal-accuracy story: it is
# structurally impossible for the documented output SHAPE to hold an SVD when
# m < n, because out_U is m x n and a rank-m matrix cannot carry n orthonormal
# columns. Scored on 200 random wide matrices against the exact identity
# sum(sigma_i^2) == ||A||_F^2 -- which needs no reference implementation --
# 200 of 200 violated it; the same sweep on 200 tall matrices violated it 0
# times. B below returned (2, 2, 1) where the true spectrum is (2, 1).
# [measured: CHANGELOG.md 2.8.3, svd_golub_kahan entry (200 of 200 wide, 0 of 200 tall); B's (2, 2, 1) is scratch]
# ================================================================

test_group("svd_golub_kahan: m < n is rejected, not silently mis-solved");

var Aw = ganita_mat_new(2, 3);
ganita_mat_set(Aw, 0, 0, F64_TWO); ganita_mat_set(Aw, 0, 1, 0);       ganita_mat_set(Aw, 0, 2, 0);
ganita_mat_set(Aw, 1, 0, 0);       ganita_mat_set(Aw, 1, 1, F64_ONE); ganita_mat_set(Aw, 1, 2, 0);
var Uw = ganita_mat_new(2, 3);
var Vw = ganita_mat_new(3, 3);
var Sw = alloc(24);
var _rq83t, _rq83v = svd_golub_kahan(Aw, Uw, Sw, Vw);
assert_eq(is_err_result(_rq83t), 1, "svd 2x3 wide: rejected with HSB_ERR_INVALID_INPUT (was ERR_NONE + wrong S)");
assert_eq(_rq83v, HSB_ERR_INVALID_INPUT, "svd 2x3 wide: rejected with HSB_ERR_INVALID_INPUT (was ERR_NONE + wrong S)");
assert_eq(load64(Sw), 0, "svd 2x3 wide: out_S left untouched (s0)");
assert_eq(load64(Sw + 8), 0, "svd 2x3 wide: out_S left untouched (s1)");
assert_eq(load64(Sw + 16), 0, "svd 2x3 wide: out_S left untouched (s2)");

# The exact-Frobenius identity is the discriminator, so assert it directly on a
# case whose spectrum is exact: A = [[3,4,0],[0,0,5]] has A A^T = 25 I, hence
# singular values exactly 5 and 5 and ||A||_F^2 = 50. The pre-2.8.3 code got
# this one right, which is why "it sometimes works" was never a defence.
var Aw2 = ganita_mat_new(2, 3);
ganita_mat_set(Aw2, 0, 0, f64_from(3)); ganita_mat_set(Aw2, 0, 1, f64_from(4)); ganita_mat_set(Aw2, 0, 2, 0);
ganita_mat_set(Aw2, 1, 0, 0);           ganita_mat_set(Aw2, 1, 1, 0);           ganita_mat_set(Aw2, 1, 2, f64_from(5));
var Uw2 = ganita_mat_new(2, 3);
var Vw2 = ganita_mat_new(3, 3);
var Sw2 = alloc(24);
var _rq84t, _rq84v = svd_golub_kahan(Aw2, Uw2, Sw2, Vw2);
assert_eq(is_err_result(_rq84t), 1, "svd 2x3 wide (A A^T = 25I): rejected too -- the contract, not the luck");
assert_eq(_rq84v, HSB_ERR_INVALID_INPUT, "svd 2x3 wide (A A^T = 25I): rejected too -- the contract, not the luck");

# Square and tall stay accepted: the guard must not be a blanket refusal.
var An = ganita_mat_new(3, 3);
ganita_mat_set(An, 0, 0, F64_ONE); ganita_mat_set(An, 0, 1, 0);       ganita_mat_set(An, 0, 2, 0);
ganita_mat_set(An, 1, 0, 0);       ganita_mat_set(An, 1, 1, F64_TWO); ganita_mat_set(An, 1, 2, 0);
ganita_mat_set(An, 2, 0, 0);       ganita_mat_set(An, 2, 1, 0);       ganita_mat_set(An, 2, 2, f64_from(3));
var Un = ganita_mat_new(3, 3);
var Vn = ganita_mat_new(3, 3);
var Sn = alloc(24);
var _rq85t, _rq85v = svd_golub_kahan(An, Un, Sn, Vn);
assert_eq(is_ok(_rq85t), 1, "svd 3x3 square: still accepted");
assert(f64_approx_eq(load64(Sn), f64_from(3), LOOSE_TOL_H) == 1,
  "svd 3x3 square: s0 == 3 (exact spectrum 3, 2, 1)");
assert(f64_approx_eq(load64(Sn + 16), F64_ONE, LOOSE_TOL_H) == 1,
  "svd 3x3 square: s2 == 1");

# ================================================================
# 2.7.0-F -- eigen_qr non-convergence on a moderately-conditioned
# symmetric 4x4. Found by sweeping 150 random symmetric 4x4s (1 failed);
# cond is only 240, which LAPACK's dsyev handles trivially.
#
# Root cause was the block-boundary logic, not the sweep: a dead loop with a
# FAKE break (`var _break = 1;` plus two no-op `p_lo = p_lo;` statements) that
# always ran to 0, followed by a re-find whose test was an ABSOLUTE EPSILON_F64
# while the deflation test beside it was RELATIVE. On entries spanning
# 0.04 .. 24.6 the two disagreed about "negligible" and the sweep stalled.
# ================================================================

test_group("eigen_qr: converges on a moderately-conditioned symmetric 4x4");

var eqA = ganita_mat_new(4, 4);
ganita_mat_set(eqA, 0, 0, 0x40389DF1BD110222); ganita_mat_set(eqA, 0, 1, 0x3FEE5D20F4B120C8);
ganita_mat_set(eqA, 0, 2, 0x40120E8FDA90FA03); ganita_mat_set(eqA, 0, 3, 0x40204BE315F598A5);
ganita_mat_set(eqA, 1, 0, 0x3FEE5D20F4B120C8); ganita_mat_set(eqA, 1, 1, 0x3FD1056459266190);
ganita_mat_set(eqA, 1, 2, 0x3FD3E631F1B3FC40); ganita_mat_set(eqA, 1, 3, 0x3FA4745F80EE7C17);
ganita_mat_set(eqA, 2, 0, 0x40120E8FDA90FA03); ganita_mat_set(eqA, 2, 1, 0x3FD3E631F1B3FC40);
ganita_mat_set(eqA, 2, 2, 0x3FB6AF52BAD29C05); ganita_mat_set(eqA, 2, 3, 0x3FA4220EB3E9F39D);
ganita_mat_set(eqA, 3, 0, 0x40204BE315F598A5); ganita_mat_set(eqA, 3, 1, 0x3FA4745F80EE7C17);
ganita_mat_set(eqA, 3, 2, 0x3FA4220EB3E9F39D); ganita_mat_set(eqA, 3, 3, 0x3FBFD313FB35F280);
var eqV = ganita_mat_new(4, 4);
var eqL = alloc(32);
var _rq86t, _rq86v = eigen_qr(eqA, 4, 1000, eqL, eqV);
assert_eq(is_ok(_rq86t), 1, "eigen_qr 4x4 cond 240: converges (was NO_CONVERGENCE at max_iter 1e6)");

# Values, not just the return code -- eigenvalues from numpy eigvalsh, sorted by
# descending magnitude to match eigen_qr's own ordering.
assert(f64_approx_eq(load64(eqL),      0x403BCB05D28B68A6, LOOSE_TOL_H) == 1, "eigen_qr l0 == 27.793057593379352");
assert(f64_approx_eq(load64(eqL + 8),  0xC007FD0502FCF8BC, LOOSE_TOL_H) == 1, "eigen_qr l1 == -2.9985447152567684");
assert(f64_approx_eq(load64(eqL + 16), 0x3FDAB3E64483E4F2, LOOSE_TOL_H) == 1, "eigen_qr l2 == 0.41723019305170717");
assert(f64_approx_eq(load64(eqL + 24), 0xBFBDAB161234EC74, LOOSE_TOL_H) == 1, "eigen_qr l3 == -0.11589181847095792");

# And the eigenvector relation A*v = lambda*v, which the values alone do not pin.
_lp_check_eig(eqA, 4, eqL, eqV, "eigen_qr 4x4 cond 240: A*v == lambda*v");

# ================================================================
# 2026-08-04 audit, api-consistency (low): eigen_symmetric and eigen_qr carry the
# same documented contract but returned eigenvalues in DIFFERENT, undocumented
# orders. Measured on the 2.8.4 tree (scratch harness, cyrius test, hex dumps):
#     A = [[2,0,0],[0,3,1],[0,1,3]]   sym -> 2, 4, 2      qr -> 4, 2, 2
#     diag(1,5,3)                     sym -> 1, 5, 3      qr -> 5, 3, 1
#     dense C below                   sym -> 2, 3.697, 7.303   qr -> 7.303, 3.697, 2
# eigen_qr already sorted by descending |lambda| and already had assertions
# pinning it, so eigen_symmetric was given the SAME sort (src/linalg_ext.cyr).
# These assertions pin the agreement itself, so the two cannot diverge again --
# and the routine-to-routine comparison, not just a fixed expected list, is what
# makes that true.
# [measured: docs/audit/2026-08-04-v2.8.0-full.md, eigen-order row (first two matrices); dense C is scratch]
# ================================================================

test_group("eigen_symmetric / eigen_qr: one documented eigenvalue order");

fn _eso_zero3(M) {
    for (var i = 0; i < 3; i = i + 1) {
        for (var j = 0; j < 3; j = j + 1) { ganita_mat_set(M, i, j, f64_from(0)); }
    }
    return 0;
}

# Runs both routines on the same symmetric M and asserts (a) both converge,
# (b) both come back sorted by DESCENDING |lambda|, (c) they agree elementwise,
# and (d) eigen_symmetric's eigenvector columns are still paired with its values
# after the permutation. `label` is only used to keep the failures readable.
fn _eso_agree(M, label) {
    var sv = alloc(24);
    var sV = ganita_mat_new(3, 3);
    var qv = alloc(24);
    var qV = ganita_mat_new(3, 3);
    var _rq77t, _rq77v = eigen_symmetric(M, 3, sv, sV);
    assert_eq(is_ok(_rq77t), 1, label);
    var _rq87t, _rq87v = eigen_qr(M, 3, 1000, qv, qV);
    assert_eq(is_ok(_rq87t), 1, label);
    var bad_order = 0;
    var bad_match = 0;
    for (var i = 0; i < 3; i = i + 1) {
        if (f64_approx_eq(load64(sv + i * 8), load64(qv + i * 8), LOOSE_TOL_H) == 0) {
            bad_match = bad_match + 1;
        }
        if (i > 0) {
            if (f64_gt(f64_abs(load64(sv + i * 8)), f64_abs(load64(sv + (i - 1) * 8))) == 1) {
                bad_order = bad_order + 1;
            }
            if (f64_gt(f64_abs(load64(qv + i * 8)), f64_abs(load64(qv + (i - 1) * 8))) == 1) {
                bad_order = bad_order + 1;
            }
        }
    }
    assert_eq(bad_order, 0, label);
    assert_eq(bad_match, 0, label);
    _lp_check_eig(M, 3, sv, sV, label);
    _lp_check_eig(M, 3, qv, qV, label);
    return 0;
}

# A = [[2,0,0],[0,3,1],[0,1,3]], spectrum {4, 2, 2}. This is the matrix the two
# routines disagreed on: sym gave 2, 4, 2 and qr gave 4, 2, 2.
var eso_A = ganita_mat_new(3, 3);
_eso_zero3(eso_A);
ganita_mat_set(eso_A, 0, 0, F64_TWO);
ganita_mat_set(eso_A, 1, 1, f64_from(3)); ganita_mat_set(eso_A, 1, 2, F64_ONE);
ganita_mat_set(eso_A, 2, 1, F64_ONE);     ganita_mat_set(eso_A, 2, 2, f64_from(3));
_eso_agree(eso_A, "eigen_symmetric/eigen_qr agree: [[2,0,0],[0,3,1],[0,1,3]]");
var _rq78t, _rq78v = eigen_symmetric(eso_A, 3, alloc(24), ganita_mat_new(3, 3));
assert_eq(is_ok(_rq78t), 1, "eigen_symmetric returns HSB_ERR_NONE, and takes NO max_iter -- the doc named one");

# The exact post-sort values for that matrix, so a regression that reorders
# WITHOUT reordering the sibling is still caught by this file alone.
var eso_v = alloc(24);
var eso_V = ganita_mat_new(3, 3);
var _r8t, _r8v = eigen_symmetric(eso_A, 3, eso_v, eso_V);
assert_eq(load64(eso_v), f64_from(4), "eigen_symmetric: lambda0 == 4 (was 2 -- unsorted)");
assert_eq(load64(eso_v + 8), F64_TWO, "eigen_symmetric: lambda1 == 2");
assert_eq(load64(eso_v + 16), F64_TWO, "eigen_symmetric: lambda2 == 2");

# diag(1,5,3): Jacobi has nothing to rotate, so this is the input order verbatim
# unless the sort runs. sym returned 1, 5, 3 before the fix.
var eso_B = ganita_mat_new(3, 3);
_eso_zero3(eso_B);
ganita_mat_set(eso_B, 0, 0, F64_ONE); ganita_mat_set(eso_B, 1, 1, f64_from(5));
ganita_mat_set(eso_B, 2, 2, f64_from(3));
_eso_agree(eso_B, "eigen_symmetric/eigen_qr agree: diag(1,5,3)");
var eso_bv = alloc(24);
var eso_bV = ganita_mat_new(3, 3);
var _r9t, _r9v = eigen_symmetric(eso_B, 3, eso_bv, eso_bV);
assert_eq(load64(eso_bv), f64_from(5), "eigen_symmetric diag(1,5,3): lambda0 == 5 (was 1)");
assert_eq(load64(eso_bv + 8), f64_from(3), "eigen_symmetric diag(1,5,3): lambda1 == 3 (was 5)");
assert_eq(load64(eso_bv + 16), F64_ONE, "eigen_symmetric diag(1,5,3): lambda2 == 1 (was 3)");

# Dense, no zero structure to lean on.
var eso_C = ganita_mat_new(3, 3);
ganita_mat_set(eso_C, 0, 0, f64_from(4)); ganita_mat_set(eso_C, 0, 1, F64_ONE); ganita_mat_set(eso_C, 0, 2, F64_TWO);
ganita_mat_set(eso_C, 1, 0, F64_ONE);     ganita_mat_set(eso_C, 1, 1, f64_from(3)); ganita_mat_set(eso_C, 1, 2, 0);
ganita_mat_set(eso_C, 2, 0, F64_TWO); ganita_mat_set(eso_C, 2, 1, 0); ganita_mat_set(eso_C, 2, 2, f64_from(6));
_eso_agree(eso_C, "eigen_symmetric/eigen_qr agree: dense [[4,1,2],[1,3,0],[2,0,6]]");

# diag(-5,1,3) separates "descending |lambda|" from "descending lambda": -5 leads.
# If either routine ever sorts by signed value this fails, and the doc says |.|.
var eso_D = ganita_mat_new(3, 3);
_eso_zero3(eso_D);
ganita_mat_set(eso_D, 0, 0, f64_neg(f64_from(5)));
ganita_mat_set(eso_D, 1, 1, F64_ONE);
ganita_mat_set(eso_D, 2, 2, f64_from(3));
_eso_agree(eso_D, "eigen_symmetric/eigen_qr agree: diag(-5,1,3)");
var eso_dv = alloc(24);
var eso_dV = ganita_mat_new(3, 3);
var _r10t, _r10v = eigen_symmetric(eso_D, 3, eso_dv, eso_dV);
assert_eq(load64(eso_dv), f64_neg(f64_from(5)),
  "eigen_symmetric: the order is descending |lambda|, so -5 leads 3 and 1");

# diag(1,-5,3): the same spectrum with the negative NOT already in slot 0.
# ⚠ Added 3.2.0 because a mutant SURVIVED diag(-5,1,3): with |.| applied to the
# running max but not to the scanned candidate, -5 in slot 0 is never
# displaced (nothing beats |-5| = 5) and the output is right by accident --
# 573 of 573 passed with that mutant installed. Here the same mutant returns
# 3, -5, 1, because -5 must be FOUND by the scan rather than inherited.
# [measured: mutation run on the 3.2.0 tree, cycc 6.6.4, 2026-09-14]
var eso_E = ganita_mat_new(3, 3);
_eso_zero3(eso_E);
ganita_mat_set(eso_E, 0, 0, F64_ONE);
ganita_mat_set(eso_E, 1, 1, f64_neg(f64_from(5)));
ganita_mat_set(eso_E, 2, 2, f64_from(3));
_eso_agree(eso_E, "eigen_symmetric/eigen_qr agree: diag(1,-5,3)");
var eso_ev = alloc(24);
var eso_eV = ganita_mat_new(3, 3);
var _r11t, _r11v = eigen_symmetric(eso_E, 3, eso_ev, eso_eV);
assert_eq(load64(eso_ev), f64_neg(f64_from(5)),
  "eigen_symmetric diag(1,-5,3): lambda0 == -5 (found by |.|, not inherited)");
assert_eq(load64(eso_ev + 8), f64_from(3), "eigen_symmetric diag(1,-5,3): lambda1 == 3");
assert_eq(load64(eso_ev + 16), F64_ONE, "eigen_symmetric diag(1,-5,3): lambda2 == 1");
var eso_eqv = alloc(24);
var eso_eqV = ganita_mat_new(3, 3);
var _r12t, _r12v = eigen_qr(eso_E, 3, 1000, eso_eqv, eso_eqV);
assert_eq(load64(eso_eqv), f64_neg(f64_from(5)), "eigen_qr diag(1,-5,3): lambda0 == -5 (found by |.|, not inherited)");
assert_eq(load64(eso_eqv + 8), f64_from(3), "eigen_qr diag(1,-5,3): lambda1 == 3");
assert_eq(load64(eso_eqv + 16), F64_ONE, "eigen_qr diag(1,-5,3): lambda2 == 1");

# ================================================================
# 3.2.0 -- tie order. The three descending sorts (eigen_symmetric, eigen_qr,
# svd_golub_kahan) are ONE body now, `linalg_sort_desc` in src/linalg_ext.cyr,
# and the order it gives EQUAL values is part of the contract, because equal
# eigenvalues / singular values carry DISTINCT vectors. diag(2, 2, 4) is the
# discriminating fixture: every routine leaves the vectors as the identity
# (nothing to rotate, nothing to reflect), so the column order after the sort
# is the sort's own signature. The selection sort takes the FIRST max (strict
# f64_gt) and swaps i <-> max_idx, so the columns come out (e3, e2, e1); a
# stable sort -- or a `>=` in the max scan, which lets a later equal value
# displace an earlier one -- gives (e3, e1, e2). Column 1 == e2 is the pin.
# The values are exact (a diagonal matrix converges in zero steps and the
# power-of-two balance is bit-exact), so the compares are bit compares.
# ================================================================

test_group("3.2.0 tie order: equal eigenvalues / singular values keep the selection-sort column order");

var tie_A = ganita_mat_new(3, 3);
_eso_zero3(tie_A);
ganita_mat_set(tie_A, 0, 0, F64_TWO);
ganita_mat_set(tie_A, 1, 1, F64_TWO);
ganita_mat_set(tie_A, 2, 2, f64_from(4));

var tie_qv = alloc(24);
var tie_qV = ganita_mat_new(3, 3);
var _rt1t, _rt1v = eigen_qr(tie_A, 3, 1000, tie_qv, tie_qV);
assert_eq(is_ok(_rt1t), 1, "tie order: eigen_qr diag(2,2,4) converges");
assert_eq(load64(tie_qv), f64_from(4), "tie order: eigen_qr lambda0 == 4");
assert_eq(load64(tie_qv + 8), F64_TWO, "tie order: eigen_qr lambda1 == 2");
assert_eq(load64(tie_qv + 16), F64_TWO, "tie order: eigen_qr lambda2 == 2");
assert_eq(ganita_mat_get(tie_qV, 2, 0), F64_ONE, "tie order: eigen_qr column 0 == e3 (the max moved to the front)");
assert_eq(ganita_mat_get(tie_qV, 1, 1), F64_ONE,
  "tie order: eigen_qr column 1 == e2 -- first-max selection; a stable sort or a >= scan gives e1 here");
assert_eq(ganita_mat_get(tie_qV, 0, 2), F64_ONE, "tie order: eigen_qr column 2 == e1 (swapped out by the max)");

var tie_sv = alloc(24);
var tie_sV = ganita_mat_new(3, 3);
var _rt2t, _rt2v = eigen_symmetric(tie_A, 3, tie_sv, tie_sV);
assert_eq(is_ok(_rt2t), 1, "tie order: eigen_symmetric diag(2,2,4) converges");
assert_eq(load64(tie_sv), f64_from(4), "tie order: eigen_symmetric lambda0 == 4");
assert_eq(load64(tie_sv + 8), F64_TWO, "tie order: eigen_symmetric lambda1 == 2");
assert_eq(ganita_mat_get(tie_sV, 2, 0), F64_ONE, "tie order: eigen_symmetric column 0 == e3");
assert_eq(ganita_mat_get(tie_sV, 1, 1), F64_ONE, "tie order: eigen_symmetric column 1 == e2 (same body as eigen_qr)");
assert_eq(ganita_mat_get(tie_sV, 0, 2), F64_ONE, "tie order: eigen_symmetric column 2 == e1");

var tie_U = ganita_mat_new(3, 3);
var tie_Vt = ganita_mat_new(3, 3);
var tie_S = alloc(24);
var _rt3t, _rt3v = svd_golub_kahan(tie_A, tie_U, tie_S, tie_Vt);
assert_eq(is_ok(_rt3t), 1, "tie order: svd diag(2,2,4) returns Ok");
assert_eq(load64(tie_S), f64_from(4), "tie order: svd sigma0 == 4");
assert_eq(load64(tie_S + 8), F64_TWO, "tie order: svd sigma1 == 2");
assert_eq(load64(tie_S + 16), F64_TWO, "tie order: svd sigma2 == 2");
assert_eq(ganita_mat_get(tie_U, 2, 0), F64_ONE, "tie order: svd U column 0 == e3");
assert_eq(ganita_mat_get(tie_U, 1, 1), F64_ONE, "tie order: svd U column 1 == e2 (first-max selection)");
assert_eq(ganita_mat_get(tie_U, 0, 2), F64_ONE, "tie order: svd U column 2 == e1");
# Vt is permuted by ROWS, the other arm of the helper; pinned separately so a
# repair that carries U and forgets Vt cannot pass.
assert_eq(ganita_mat_get(tie_Vt, 0, 2), F64_ONE, "tie order: svd Vt row 0 == e3");
assert_eq(ganita_mat_get(tie_Vt, 1, 1), F64_ONE, "tie order: svd Vt row 1 == e2");
assert_eq(ganita_mat_get(tie_Vt, 2, 0), F64_ONE, "tie order: svd Vt row 2 == e1");

test_group("3.3.6 eigen_symmetric: n, shape and finiteness checked before ganita writes");

# ⛔ Through 3.3.5 eigen_symmetric passed A straight to ganita_mat_eigen_sym, which takes n
# from A: diag(1, 2) with n = 1 wrote BOTH eigenvalues into an 8-byte out_vals, the 2.0
# landing on the word after it, and returned Ok. NaN came back Ok with the NaN erased, and
# every refusal was NO_CONVERGENCE (a 2 x 3 A gave -8; eigen_qr gives -10).
# [measured: scratch repro on the 3.3.5 tree, not reproducible in-tree, 2026-10-11; cycc 6.6.14]
var es6_A = ganita_mat_new(2, 2);
ganita_mat_set(es6_A, 0, 0, F64_ONE);
ganita_mat_set(es6_A, 0, 1, 0);
ganita_mat_set(es6_A, 1, 0, 0);
ganita_mat_set(es6_A, 1, 1, F64_TWO);
var es6_v = alloc(8);
var es6_can = alloc(8);
store64(es6_v, 0x401C000000000000);
store64(es6_can, 0x5A5A5A5A5A5A5A5A);
var es6_r1t, es6_r1v = eigen_symmetric(es6_A, 1, es6_v, ganita_mat_new(2, 2));
assert_eq(es6_r1v, HSB_ERR_INVALID_INPUT, "eigen_symmetric: n = 1 for a 2 x 2 A -> INVALID_INPUT (3.3.5: Ok)");
assert_eq(load64(es6_can), 0x5A5A5A5A5A5A5A5A,
  "eigen_symmetric: n = 1 for a 2 x 2 A leaves the word after out_vals alone (3.3.5: 2.0 there)");
assert_eq(load64(es6_v), 0x401C000000000000, "eigen_symmetric: n = 1 for a 2 x 2 A writes nothing to out_vals");
var es6_r2t, es6_r2v = eigen_symmetric(es6_A, 3, alloc(24), ganita_mat_new(3, 3));
assert_eq(es6_r2v, HSB_ERR_INVALID_INPUT, "eigen_symmetric: n = 3 for a 2 x 2 A -> INVALID_INPUT");
var es6_W = ganita_mat_new(2, 3);
for (var es6_i = 0; es6_i < 6; es6_i = es6_i + 1) { ganita_mat_set(es6_W, es6_i / 3, es6_i % 3, 0); }
ganita_mat_set(es6_W, 0, 0, F64_ONE);
ganita_mat_set(es6_W, 1, 1, F64_TWO);
var es6_r3t, es6_r3v = eigen_symmetric(es6_W, 2, alloc(16), ganita_mat_new(2, 2));
assert_eq(es6_r3v, HSB_ERR_INVALID_INPUT, "eigen_symmetric: a 2 x 3 A -> INVALID_INPUT, as eigen_qr (3.3.5: -8)");
var es6_r4t, es6_r4v = eigen_symmetric(es6_A, 2, alloc(16), ganita_mat_new(3, 3));
assert_eq(es6_r4v, HSB_ERR_INVALID_INPUT, "eigen_symmetric: a 3 x 3 out_vecs for n = 2 -> INVALID_INPUT (3.3.5: -8)");
var es6_r5t, es6_r5v = eigen_symmetric(es6_A, 2, 0, ganita_mat_new(2, 2));
assert_eq(es6_r5v, HSB_ERR_INVALID_INPUT, "eigen_symmetric: a null out_vals -> INVALID_INPUT (3.3.5: -8)");
# a hand-built 0 x 0 header: ganita_mat_new refuses one, so only n <= 0 tells it from an
# allocation failure (ganita's alloc(0) for its row maxima)
var es6_Z = alloc(16);
store64(es6_Z, 0);
store64(es6_Z + 8, 0);
var es6_r6t, es6_r6v = eigen_symmetric(es6_Z, 0, alloc(8), es6_Z);
assert_eq(es6_r6v, HSB_ERR_INVALID_INPUT, "eigen_symmetric: a 0 x 0 A with n = 0 -> INVALID_INPUT");

# NaN and infinite entries: refused before ganita runs, so out_vals is untouched (3.3.5
# returned Ok (2, 1) for the NaN pair, ganita 1.2.12+ a -2 that read as NO_CONVERGENCE).
var es6_N = ganita_mat_new(2, 2);
ganita_mat_set(es6_N, 0, 0, F64_ONE);
ganita_mat_set(es6_N, 0, 1, 0x7FF8000000000000);
ganita_mat_set(es6_N, 1, 0, 0x7FF8000000000000);
ganita_mat_set(es6_N, 1, 1, F64_TWO);
var es6_nv = alloc(16);
store64(es6_nv, 0x401C000000000000);
store64(es6_nv + 8, 0x401C000000000000);
var es6_r7t, es6_r7v = eigen_symmetric(es6_N, 2, es6_nv, ganita_mat_new(2, 2));
assert_eq(es6_r7v, HSB_ERR_INVALID_INPUT, "eigen_symmetric [[1, NaN], [NaN, 2]] -> INVALID_INPUT (3.3.5: Ok (2, 1))");
assert_eq(load64(es6_nv), 0x401C000000000000, "eigen_symmetric [[1, NaN], [NaN, 2]]: out_vals untouched");
ganita_mat_set(es6_N, 0, 1, 0);
ganita_mat_set(es6_N, 1, 0, 0);
ganita_mat_set(es6_N, 1, 1, 0xFFF0000000000000);
var es6_r8t, es6_r8v = eigen_symmetric(es6_N, 2, es6_nv, ganita_mat_new(2, 2));
assert_eq(es6_r8v, HSB_ERR_INVALID_INPUT, "eigen_symmetric diag(1, -Inf) -> INVALID_INPUT");

# The working copy's allocation failure is ALLOC. Through 3.4.0 that copy was ganita's (48 bytes
# for a 2 x 2, refused at ALLOC_MAX 47: -2 from ganita through 1.2.11, -1 from 1.2.12); since
# 3.4.1 the Jacobi is hisab's own and its copies are n^2 words, 32 bytes here: ALLOC_MAX 31 refuses
# them (through the derived bound n > (ALLOC_MAX / 8) / n, ahead of alloc) and 32 admits them.
var es6_av = alloc(16);
var es6_aV = ganita_mat_new(2, 2);
var es6_keep = ALLOC_MAX;
ALLOC_MAX = 31;
var es6_r9t, es6_r9v = eigen_symmetric(es6_A, 2, es6_av, es6_aV);
ALLOC_MAX = es6_keep;
assert_eq(es6_r9v, HSB_ERR_ALLOC, "eigen_symmetric: the working copy refused -> ALLOC (3.3.5: NO_CONVERGENCE)");
ALLOC_MAX = 32;
var es6_r9bt, es6_r9bv = eigen_symmetric(es6_A, 2, es6_av, es6_aV);
ALLOC_MAX = es6_keep;
assert_eq(is_ok(es6_r9bt), 1, "eigen_symmetric: ALLOC_MAX 32 admits the 32-byte copies -> Ok");

# Control: the same diag(1, 2) at its own n answers, sorted.
var es6_cv = alloc(16);
var es6_r10t, es6_r10v = eigen_symmetric(es6_A, 2, es6_cv, ganita_mat_new(2, 2));
assert_eq(is_ok(es6_r10t), 1, "eigen_symmetric diag(1, 2) at n = 2 (control): Ok");
assert_eq(load64(es6_cv), F64_TWO, "eigen_symmetric diag(1, 2) (control): lambda0 = 2");
assert_eq(load64(es6_cv + 8), F64_ONE, "eigen_symmetric diag(1, 2) (control): lambda1 = 1");

test_group("cqr_decompose: the hoisted reflector scratch is reused, not corrupted");

# 2026-08-04 audit, performance: `var v = alloc(len * 16);` sat inside
# cqr_decompose's k loop, so a call spent sum(m-k)*16 = 16*m*(m+1)/2 bytes of a
# bump allocator that never frees -- 33,280 B on a 64x64. It is now ONE alloc(m*16)
# before the loop, reused by every reflector (only the leading `len` slots are
# read). Measured per cqr_decompose(64x64) call: 32,942,104 B of arena before,
# 32,909,848 B after (-32,256 B, exactly the triangular sum minus the one buffer).
# [measured: CHANGELOG.md 2.9.0, "cqr_decompose on a 64x64: 32,942,104 B -> 32,909,848 B (-32,256 B, -0.098%)"]
#
# The real hazard of buffer reuse is not the byte count, it is a reflector reading
# a stale tail from the previous iteration. min_mn = 4 here, so the buffer is
# rewritten three times after its first use; these assertions would fail on any
# staleness because Q*R would stop reproducing A.
var cqh_A = cmat_new(4, 4);
for (var cqhi = 0; cqhi < 4; cqhi = cqhi + 1) {
    for (var cqhj = 0; cqhj < 4; cqhj = cqhj + 1) {
        cmat_set(cqh_A, cqhi, cqhj,
          cx_new(f64_from((cqhi * 7 + cqhj * 3) % 11), f64_from((cqhi + cqhj * 5) % 7)));
    }
}
var cqh_Q = cmat_new(4, 4);
var cqh_R = cmat_new(4, 4);
var _rq88t, _rq88v = cqr_decompose(cqh_A, cqh_Q, cqh_R);
assert_eq(is_ok(_rq88t), 1, "cqr 4x4: decomposes");

# Q*R == A, entrywise.
var cqh_QR = cmat_mul(cqh_Q, cqh_R);
var cqh_bad = 0;
for (var cqri = 0; cqri < 4; cqri = cqri + 1) {
    for (var cqrj = 0; cqrj < 4; cqrj = cqrj + 1) {
        var cqh_d = cx_sub(cmat_get(cqh_QR, cqri, cqrj), cmat_get(cqh_A, cqri, cqrj));
        if (f64_gt(cx_abs(cqh_d), LOOSE_TOL_H) == 1) { cqh_bad = cqh_bad + 1; }
    }
}
assert_eq(cqh_bad, 0, "cqr 4x4: Q*R == A after the shared-buffer hoist");

# Q^H Q == I: a stale tail in the reflector breaks orthogonality first.
var cqh_QhQ = cmat_mul(cmat_adjoint(cqh_Q), cqh_Q);
var cqh_obad = 0;
for (var cqoi = 0; cqoi < 4; cqoi = cqoi + 1) {
    for (var cqoj = 0; cqoj < 4; cqoj = cqoj + 1) {
        var cqh_w = cx_zero();
        if (cqoi == cqoj) { cqh_w = cx_one(); }
        var cqh_e = cx_sub(cmat_get(cqh_QhQ, cqoi, cqoj), cqh_w);
        if (f64_gt(cx_abs(cqh_e), LOOSE_TOL_H) == 1) { cqh_obad = cqh_obad + 1; }
    }
}
assert_eq(cqh_obad, 0, "cqr 4x4: Q^H Q == I after the shared-buffer hoist");

# R upper triangular -- the third thing a corrupted reflector would break.
var cqh_lbad = 0;
for (var cqli = 1; cqli < 4; cqli = cqli + 1) {
    for (var cqlj = 0; cqlj < cqli; cqlj = cqlj + 1) {
        if (f64_gt(cx_abs(cmat_get(cqh_R, cqli, cqlj)), LOOSE_TOL_H) == 1) {
            cqh_lbad = cqh_lbad + 1;
        }
    }
}
assert_eq(cqh_lbad, 0, "cqr 4x4: R is upper triangular after the shared-buffer hoist");

# An arena ceiling, and an HONEST one: it is coarse and cannot be otherwise.
# The hoist removes 8*m^2 - 8*m bytes, which is 32,256 B of a 32,942,104 B call at
# 64x64 (-0.098%) and 96 B of 14,072 B here. The rest is cx_new's 16 B per complex
# temporary in the O(m^2 n) reflector application, so a ceiling tight enough to
# fail on the reflector scratch ALONE would be a 0.7% window that any unrelated
# change to complex.cyr would break. It is not written that way on purpose --
# a test that has to be re-tuned by whoever touches a different file is worse than
# no test. The buffer-reuse hazard is guarded by the three correctness assertions
# above instead; this one catches a gross allocation regression.
# [measured: CHANGELOG.md 2.9.0 (the 64x64 pair); the 14,072 B is the assert message below, which bounds it at 16 KB]
var cqh_Q2 = cmat_new(4, 4);
var cqh_R2 = cmat_new(4, 4);
var cqh_a0 = alloc_used();
var _r5t, _r5v = cqr_decompose(cqh_A, cqh_Q2, cqh_R2);
assert_lt(alloc_used() - cqh_a0, 16384,
  "cqr 4x4: under 16 KB of arena per call (measured 14,072 B on this exact matrix)");

test_group("3.3.5 cqr_decompose: the zero matrix");
# Equivalent for _lp_balance_pick's lo = +Inf guard (the loop after it is already false):
# this pins the decomposition where it fires.
var _g305_A = cmat_new(2, 2);
var _g305_Q = cmat_new(2, 2);
var _g305_R = cmat_new(2, 2);
var _g305_t, _g305_v = cqr_decompose(_g305_A, _g305_Q, _g305_R);
assert_eq(is_ok(_g305_t), 1, "cqr_decompose: the zero matrix decomposes (no non-zero entry to balance by)");
var _g305_bad = 0;
for (var _g305_i = 0; _g305_i < 2; _g305_i = _g305_i + 1) {
    for (var _g305_j = 0; _g305_j < 2; _g305_j = _g305_j + 1) {
        var _g305_r = cmat_get(_g305_R, _g305_i, _g305_j);
        if (HComplex_re(_g305_r) != 0 || HComplex_im(_g305_r) != 0) { _g305_bad = _g305_bad + 1; }
        var _g305_q = cmat_get(_g305_Q, _g305_i, _g305_j);
        var _g305_want = 0;
        if (_g305_i == _g305_j) { _g305_want = F64_ONE; }
        if (HComplex_re(_g305_q) != _g305_want) { _g305_bad = _g305_bad + 1; }
        # sign incidental: cmat_adjoint conjugates the +0 imaginary parts to -0
        if (f64_eq(HComplex_im(_g305_q), 0) == 0) { _g305_bad = _g305_bad + 1; }
    }
}
assert_eq(_g305_bad, 0,
  "cqr_decompose: zero A -> R = +0 exactly and Q = I (Im Q compared by value: its zero's sign is incidental)");
assert_eq(_lp_balance_pick(0, F64_POS_INF, f64_from(32)), F64_ONE,
  "_lp_balance_pick: no non-zero entry (lo = +Inf) -> the pow2_floor(0) scale, 1");

test_group("solve_gmres: max_iter is a COUNTED matvec budget, not an estimate");

# `max_iter` is documented as "maximum total matrix-vector products". Through
# 2.7.0 it was converted into an OUTER-CYCLE count -- outer_limit =
# trunc(max_iter/m) + 1 -- while each cycle spends 1 + m products, so the true
# cost was (trunc(max_iter/m)+1)*(m+1). That is not a bounded multiple of the
# budget: the overshoot grows without limit as `restart` rises relative to
# `max_iter`. A_fn is a callback precisely because it may be expensive, so the
# budget is a resource limit, not a hint.
var gmb_b = alloc(24);
store64(gmb_b, F64_ONE); store64(gmb_b + 8, F64_ONE); store64(gmb_b + 16, F64_ONE);
var gmb_x = alloc(24);
store64(gmb_x, 0); store64(gmb_x + 8, 0); store64(gmb_x + 16, 0);
var gmb_tol = 0x3C32725DD1D243AC;   # 1e-18 -- force the budget to bind

# The headline case: budget 1, restart 100. Pre-fix this spent 4 products.
_gmb_calls = 0;
var _gmb1t, _gmb1v = solve_gmres_checked(&_gmb_A, gmb_b, gmb_x, 3, gmb_tol, 1, 100);
assert(_gmb_calls <= 1, "gmres budget=1 restart=100 spends at most 1 matvec");
assert(_gmb_calls > 0, "gmres budget=1 still does useful work");

# Restart smaller than the budget. Pre-fix: 6 products for a budget of 3.
_gmb_calls = 0;
var _gmb2t, _gmb2v = solve_gmres_checked(&_gmb_A, gmb_b, gmb_x, 3, gmb_tol, 3, 2);
assert(_gmb_calls <= 3, "gmres budget=3 restart=2 spends at most 3 matvecs");

# And a generous budget must still be respected exactly.
_gmb_calls = 0;
var _gmb3t, _gmb3v = solve_gmres_checked(&_gmb_A, gmb_b, gmb_x, 3, gmb_tol, 10, 10);
assert(_gmb_calls <= 10, "gmres budget=10 restart=10 spends at most 10 matvecs");

# === 3.3.3 G2b: A_fn buffer ownership (solve_gmres, solve_bicgstab) ===
# ⛔ Both solvers relied on an unwritten "A_fn returns a fresh buffer" contract (audit
# M6, 2026-04-15). GMRES orthogonalised the returned vector IN PLACE and kept it as a
# basis vector; BiCGSTAB kept `v = A p` across the next call. Give them an A_fn that
# reuses one output buffer and, on 3.3.2, this fixture's GMRES spent 60 matvecs (the
# whole budget) where fresh buffers take 4, writing the caller's buffer 44 times, and
# BiCGSTAB returned after 65 where fresh buffers take 6, its true residual 1.7e-9 for a
# tol of 1e-10. Each is now held to the fresh-buffer run: the same matvec count and the
# same x, bit for bit. The fresh-buffer counts are 3.3.2's own, unchanged.
# [measured: scratch harness, not reproducible in-tree, 2026-10-01; cycc 6.6.12]
test_group("3.3.3 solve_gmres / solve_bicgstab: A_fn may reuse its output buffer");

var _G2B_MV = 0;
fn _g2b_fresh(xp) {
    _G2B_MV = _G2B_MV + 1;
    return _g2b_nmul(xp, alloc(24));
}
# Writes every product into ONE buffer, straight from its input (not safe for in == out,
# like most real matvecs). _g2b_sh holds what it last wrote, so a mismatch on entry means
# the solver wrote into storage it does not own.
var _g2b_rb = alloc(24);
var _g2b_sh = alloc(24);
var _G2B_WRITES = 0;
fn _g2b_reset_reuse() {
    for (var i = 0; i < 3; i = i + 1) {
        store64(_g2b_rb + i * 8, 0);
        store64(_g2b_sh + i * 8, 0);
    }
    _G2B_WRITES = 0;
    _G2B_MV = 0;
    return 0;
}
fn _g2b_reuse(xp) {
    _G2B_MV = _G2B_MV + 1;
    var dirty = 0;
    for (var i = 0; i < 3; i = i + 1) {
        if (load64(_g2b_rb + i * 8) != load64(_g2b_sh + i * 8)) { dirty = 1; }
    }
    _G2B_WRITES = _G2B_WRITES + dirty;
    _g2b_nmul(xp, _g2b_rb);
    for (var j = 0; j < 3; j = j + 1) { store64(_g2b_sh + j * 8, load64(_g2b_rb + j * 8)); }
    return _g2b_rb;
}
var _g2b_ob = alloc(24);
store64(_g2b_ob, 0x3FF199999999999A);        # 1.1
store64(_g2b_ob + 8, 0x4000CCCCCCCCCCCD);    # 2.1
store64(_g2b_ob + 16, 0x4007333333333333);   # 2.9
var _g2b_o0 = alloc(24);
store64(_g2b_o0, 0);
store64(_g2b_o0 + 8, 0);
store64(_g2b_o0 + 16, 0);
var _g2b_otol = 0x3DDB7CDFD9D7BDBB;         # 1e-10

# GMRES, restart 3 (one cycle) and restart 2 (cycles reuse the basis slots).
_G2B_MV = 0;
var _g2b_gft, _g2b_gf = solve_gmres_checked(&_g2b_fresh, _g2b_ob, _g2b_o0, 3, _g2b_otol, 60, 3);
var _g2b_gf_mv = _G2B_MV;
_g2b_reset_reuse();
var _g2b_grt, _g2b_gr = solve_gmres_checked(&_g2b_reuse, _g2b_ob, _g2b_o0, 3, _g2b_otol, 60, 3);
# 3.4.0: one matvec more than 3.3.2-3.3.7's 4, the true residual that confirms the Givens
# estimate (solve_gmres_checked); and tol is relative now, 1e-10 ||b|| = 3.77e-10.
# [measured: this group's own counts, 3.3.7 base vs this tree, cycc 6.7.9, 2026-10-31]
assert_eq(_g2b_gf_mv, 5, "gmres(3), fresh A_fn: 5 matvecs (3.3.7: 4, without the confirming residual)");
assert_eq(_G2B_MV, _g2b_gf_mv, "gmres(3), reusing A_fn: the same 5 matvecs (3.3.2: 60, the whole budget)");
assert_eq(_G2B_WRITES, 0, "gmres(3): never writes into the buffer A_fn returned (3.3.2: 44 times)");
_G2B_MV = 0;
var _g2b_gf2t, _g2b_gf2 = solve_gmres_checked(&_g2b_fresh, _g2b_ob, _g2b_o0, 3, _g2b_otol, 60, 2);
var _g2b_gf2_mv = _G2B_MV;
_g2b_reset_reuse();
var _g2b_gr2t, _g2b_gr2 = solve_gmres_checked(&_g2b_reuse, _g2b_ob, _g2b_o0, 3, _g2b_otol, 60, 2);
assert_eq(_g2b_gf2_mv, 36, "gmres(2), fresh A_fn: 36 matvecs (3.3.7: 38 at an absolute tol 3.77x tighter)");
assert_eq(_G2B_MV, _g2b_gf2_mv, "gmres(2), reusing A_fn: the same 36 matvecs across restarts (3.3.2: 60)");
assert_eq(_G2B_WRITES, 0, "gmres(2): never writes into the buffer A_fn returned");

# BiCGSTAB.
_G2B_MV = 0;
var _g2b_bft, _g2b_bf = solve_bicgstab_checked(&_g2b_fresh, _g2b_ob, _g2b_o0, 3, _g2b_otol, 60);
var _g2b_bf_mv = _G2B_MV;
_g2b_reset_reuse();
var _g2b_brt, _g2b_br = solve_bicgstab_checked(&_g2b_reuse, _g2b_ob, _g2b_o0, 3, _g2b_otol, 60);
# (3.4.0 review: 7, the true residual that confirms the answer included)
assert_eq(_g2b_bf_mv, 7, "bicgstab, fresh A_fn: 7 matvecs");
assert_eq(_G2B_MV, _g2b_bf_mv, "bicgstab, reusing A_fn: the same 7 matvecs (3.3.2: 65)");
assert_eq(_G2B_WRITES, 0, "bicgstab: never writes into the buffer A_fn returned");

for (var _g2b_m = 0; _g2b_m < 3; _g2b_m = _g2b_m + 1) {
    assert_eq(load64(_g2b_gr + _g2b_m * 8), load64(_g2b_gf + _g2b_m * 8),
      "gmres(3): reusing A_fn gives the fresh-buffer x bit for bit (3.3.2: 1.2e-4 off)");
    assert_eq(load64(_g2b_gr2 + _g2b_m * 8), load64(_g2b_gf2 + _g2b_m * 8),
      "gmres(2): reusing A_fn gives the fresh-buffer x bit for bit");
    assert_eq(load64(_g2b_br + _g2b_m * 8), load64(_g2b_bf + _g2b_m * 8),
      "bicgstab: reusing A_fn gives the fresh-buffer x bit for bit (3.3.2: 1.8e-9 off)");
}

# An A_fn that returns its own input pointer: the identity, written the cheapest way.
# 3.3.2's GMRES orthogonalised that pointer in place, i.e. zeroed basis vector 0, and
# returned x0. A = I: the answer is b, and here it comes back exactly.
fn _g2b_ident(xp) { return xp; }
var _g2b_git, _g2b_gi = solve_gmres_checked(&_g2b_ident, _g2b_ob, _g2b_o0, 3, _g2b_otol, 60, 3);
for (var _g2b_n = 0; _g2b_n < 3; _g2b_n = _g2b_n + 1) {
    assert_eq(load64(_g2b_gi + _g2b_n * 8), load64(_g2b_ob + _g2b_n * 8),
      "gmres, A_fn returns its input (A = I): x = b exactly (3.3.2: x0)");
}

# GMRES's copy slots are allocated LAZILY and ONCE PER CALL, and both show in the arena:
# a reusing A_fn allocates nothing, so every byte below is the solver's own. Each bound
# sits between the repair and the mutant named in its message, all measured on this tree.
# [measured: scratch harness, not reproducible in-tree, 2026-10-01; cycc 6.6.12]
var _g2b_rb64 = alloc(512);
var _G2B_DIAG = 0;
fn _g2b_reuse64(xp) {
    for (var i = 0; i < 64; i = i + 1) {
        var di = F64_TWO;
        if (_G2B_DIAG == 1) { di = f64_from(i + 1); }
        store64(_g2b_rb64 + i * 8, f64_mul(di, load64(xp + i * 8)));
    }
    return _g2b_rb64;
}
var _g2b_b64 = alloc(512);
var _g2b_x64 = alloc(512);
for (var _g2b_q = 0; _g2b_q < 64; _g2b_q = _g2b_q + 1) {
    store64(_g2b_b64 + _g2b_q * 8, f64_add(F64_ONE, f64_div(f64_from(_g2b_q), f64_from(7))));
    store64(_g2b_x64 + _g2b_q * 8, 0);
}
_G2B_DIAG = 1;
var _g2b_ar0 = alloc_used();
var _g2b_r64t, _g2b_r64v = solve_gmres_checked(&_g2b_reuse64, _g2b_b64, _g2b_x64, 64, _g2b_otol, 60, 2);
# ⭐ 3.3.7 — and the restart cycle's own buffers (r, the basis pointers, H, g, the Givens
# pairs, y) are allocated once per call too (D016): 14,672 B -> 2,208 B on this run of 20
# cycles, so the bound moves from 20 KB to 4 KB.
# [measured: scratch gm.cyr (alloc_used around the call), 3.3.7 integrated tree and this tree, 2026-10-31; cycc 6.6.20]
assert_lt(alloc_used() - _g2b_ar0, 4096,
  "gmres(2), A = diag(1..64), 60 matvecs: arena under 4 KB (2,208 B; per-cycle buffers as through 3.3.6: 14,672)");
_G2B_DIAG = 0;
var _g2b_ar1 = alloc_used();
var _g2b_r64bt, _g2b_r64bv = solve_gmres_checked(&_g2b_reuse64, _g2b_b64, _g2b_x64, 64, _g2b_otol, 200, 64);
assert_lt(alloc_used() - _g2b_ar1, 49152,
  "gmres(64), A = 2I, 2 matvecs: arena under 48 KB (37,400 B; all 64 slots up front: 69,656)");

# === 3.3.3 R4le: solve_bicgstab A_fn may return its input ===
# The BiCGSTAB header now promises what the GMRES one does: A_fn may return its own
# input pointer, because hisab copies A p, reads every other result before the next
# call, and writes into no buffer of A_fn's own. A = I written that way: the answer
# is b, reached at the first half step (alpha = 1, s = 0) after 2 matvecs. 3.3.2
# passes this too -- the allowance is newly written down, not new behaviour. What it
# guards is the promise: a solver that formed r = b - A x0 in place, in the buffer
# A_fn returned, would overwrite x0's copy here and return 2b.
# [measured: R4le probe, 3.3.2 bundle and this tree, cycc 6.6.12, 2026-10-01]
var _R4LE_MV = 0;
fn _r4le_ident(xp) {
    _R4LE_MV = _R4LE_MV + 1;
    return xp;
}
var _r4le_bit, _r4le_bi = solve_bicgstab_checked(&_r4le_ident, _g2b_ob, _g2b_o0, 3, _g2b_otol, 60);
assert_eq(_R4LE_MV, 3, "bicgstab, A_fn returns its input (A = I): 3 matvecs (3.4.0 review: the confirming one too)");
for (var _r4le_n = 0; _r4le_n < 3; _r4le_n = _r4le_n + 1) {
    assert_eq(load64(_r4le_bi + _r4le_n * 8), load64(_g2b_ob + _r4le_n * 8),
      "bicgstab, A_fn returns its input (A = I): x = b exactly");
}

# ================================================================
# 2.8.3 -- svd_golub_kahan must ENFORCE its own "m >= n" contract
# ================================================================
#
# _lp_bidiagonalize seeds out_U with the m x n slice of the identity via
# ganita_mat_set(U_acc, i, i) for i < n. On an m x n matrix that store lands at flat
# slot i*n + i, so with m < n every i >= m writes past the m*n slots the caller
# allocated. The QR sweep afterwards also produces wrong singular values,
# because rows m..n-1 of B are never formed.
# ================================================================

test_group("svd_golub_kahan: rows < cols must be rejected, not written past");

# out_U is 2 x 16 = 32 data slots. The block that follows it in the bump
# allocator is a 64-slot canary; anything stored past out_U lands in it.
var wA = ganita_mat_new(2, 16);
var wj = 0;
while (wj < 16) {
    ganita_mat_set(wA, 0, wj, f64_from(wj + 1));
    ganita_mat_set(wA, 1, wj, f64_from(2 * wj + 3));
    wj = wj + 1;
}
var wU = ganita_mat_new(2, 16);
var wCan = alloc(64 * 8);
var wi = 0;
while (wi < 64) { store64(wCan + wi * 8, 0x5A5A5A5A5A5A5A5A); wi = wi + 1; }
var wVt = ganita_mat_new(16, 16);
var wS = alloc(16 * 8);
var _rq89t, _rq89v = svd_golub_kahan(wA, wU, wS, wVt);
assert_eq(is_err_result(_rq89t), 1, "svd 2x16 (m < n): HSB_ERR_INVALID_INPUT");
assert_eq(_rq89v, HSB_ERR_INVALID_INPUT, "svd 2x16 (m < n): HSB_ERR_INVALID_INPUT");
var wClob = 0;
wi = 0;
while (wi < 64) {
    if (load64(wCan + wi * 8) != 0x5A5A5A5A5A5A5A5A) { wClob = wClob + 1; }
    wi = wi + 1;
}
assert_eq(wClob, 0, "svd 2x16: canary past out_U untouched (was 4 slots clobbered)");
var _rq90t, _rq90v = svd_golub_kahan(ganita_mat_new(3, 4), ganita_mat_new(3, 4), alloc(32), ganita_mat_new(4, 4));
assert_eq(is_err_result(_rq90t), 1, "svd 3x4 (m < n): HSB_ERR_INVALID_INPUT");
assert_eq(_rq90v, HSB_ERR_INVALID_INPUT, "svd 3x4 (m < n): HSB_ERR_INVALID_INPUT");
# A null handle is the designed 0 that ganita_mat_new returns above its own cap.
var _rq91t, _rq91v = svd_golub_kahan(0, wU, wS, wVt);
assert_eq(is_err_result(_rq91t), 1, "svd: A = 0 rejected");
assert_eq(_rq91v, HSB_ERR_INVALID_INPUT, "svd: A = 0 rejected");
var _rq92t, _rq92v = svd_golub_kahan(wA, 0, wS, wVt);
assert_eq(is_err_result(_rq92t), 1, "svd: out_U = 0 rejected");
assert_eq(_rq92v, HSB_ERR_INVALID_INPUT, "svd: out_U = 0 rejected");
var _rq93t, _rq93v = svd_golub_kahan(wA, wU, 0, wVt);
assert_eq(is_err_result(_rq93t), 1, "svd: out_S = 0 rejected");
assert_eq(_rq93v, HSB_ERR_INVALID_INPUT, "svd: out_S = 0 rejected");
var _rq94t, _rq94v = svd_golub_kahan(wA, wU, wS, 0);
assert_eq(is_err_result(_rq94t), 1, "svd: out_Vt = 0 rejected");
assert_eq(_rq94v, HSB_ERR_INVALID_INPUT, "svd: out_Vt = 0 rejected");

# ...and m >= n is untouched. Singular values below are numpy/LAPACK's, and the
# sum of their squares must equal trace(A^T A), an exact integer over Z.
test_group("svd_golub_kahan: m >= n singular values vs numpy/LAPACK");

var tA = ganita_mat_new(4, 3);
ganita_mat_set(tA, 0, 0, F64_ONE); ganita_mat_set(tA, 0, 1, 0);           ganita_mat_set(tA, 0, 2, F64_TWO);
ganita_mat_set(tA, 1, 0, 0);       ganita_mat_set(tA, 1, 1, f64_from(3)); ganita_mat_set(tA, 1, 2, F64_ONE);
ganita_mat_set(tA, 2, 0, F64_TWO); ganita_mat_set(tA, 2, 1, F64_ONE);     ganita_mat_set(tA, 2, 2, 0);
ganita_mat_set(tA, 3, 0, F64_ONE); ganita_mat_set(tA, 3, 1, F64_ONE);     ganita_mat_set(tA, 3, 2, F64_ONE);
var tU = ganita_mat_new(4, 3);
var tVt = ganita_mat_new(3, 3);
var tS = alloc(24);
var _rq95t, _rq95v = svd_golub_kahan(tA, tU, tS, tVt);
assert_eq(is_ok(_rq95t), 1, "svd 4x3: HSB_ERR_NONE");
assert(f64_approx_eq(load64(tS), 0x400F0F919D925D83, LOOSE_TOL_H), "svd 4x3 s0 = 3.882601958302702");
assert(f64_approx_eq(load64(tS + 8), 0x4001F8D8382CCA2D, LOOSE_TOL_H), "svd 4x3 s1 = 2.246506155840754");
assert(f64_approx_eq(load64(tS + 16), 0x3FFB2577A8C0E9CA, LOOSE_TOL_H),
  "svd 4x3 s2 = 1.6966473190246796");
var tSum = 0;
wi = 0;
while (wi < 3) { tSum = f64_add(tSum, f64_mul(load64(tS + wi * 8), load64(tS + wi * 8))); wi = wi + 1; }
assert(f64_approx_eq(tSum, f64_from(23), LOOSE_TOL_H), "svd 4x3 sum s^2 = trace(A^T A) = 23");
_lp_check_svd(tA, 4, 3, tU, tS, tVt, "svd 4x3: A == U*S*Vt");

test_group("2.17.0 linalg_precision: the QR sweeps are block-ratio-free");

# ⚠ A UNIFORM SCALE PROVES NOTHING HERE AND THE CENSUS SAID SO BEFORE THE FIRST
# LINE WAS WRITTEN. `svd_golub_kahan` and `eigen_qr` balance by an EXACT power of
# two, so `c*A` is bit-identically invariant on the defective tree. The
# discriminating variable is the RATIO BETWEEN SUB-BLOCKS, and both fixtures below
# are block-diagonal with the second block scaled by `c`.
# ⭐ Neither fixture carries a hand-computed singular value or eigenvalue. The SVD
# one asserts `s3/s1 == c` — the second block IS `c` times the first, so its
# singular values are exactly `c` times the first's — and the eigen one asserts
# `7c`. A fixture built from the structure cannot be wrong in the fourth digit,
# which is how 2.15.0 lost 800 of 1200 checks.
# [measured: docs/audit/2026-09-09-epsilon-census.md]

# ⛔ `svd_golub_kahan` LOST THE SMALL BLOCK ENTIRELY FOR 472 OF 999 RATIOS, AND
# ALL 472 WERE SILENT — `rc = HSB_ERR_NONE`, wrong singular values, no signal.
# The Givens radii in `_lp_split_zero_diag` (both arms of its chase) and in the
# bidiagonal bulge chase (both rotations) squared before summing.
# [measured: 999-ratio sweep before and after, 2026-09-10]
# [measured: 11-mutant run over linalg_precision.cyr, 2026-09-10]
var _SB_RUN = 0;
var _SB_BAD = 0;
var _SB_SILENT = 0;
var _SB_OK = 0;
for (var _sb_e = 2; _sb_e < 1001; _sb_e = _sb_e + 1) {
    var _sb_c = (1023 - _sb_e) << 52;
    var _sb_A = ganita_mat_new(4, 4);
    for (var _sb_i = 0; _sb_i < 4; _sb_i = _sb_i + 1) {
        for (var _sb_j = 0; _sb_j < 4; _sb_j = _sb_j + 1) {
            ganita_mat_set(_sb_A, _sb_i, _sb_j, 0);
        }
    }
    ganita_mat_set(_sb_A, 0, 0, f64_from(3));
    ganita_mat_set(_sb_A, 0, 1, f64_from(4));
    ganita_mat_set(_sb_A, 1, 1, f64_from(3));
    ganita_mat_set(_sb_A, 2, 2, f64_mul(f64_from(3), _sb_c));
    ganita_mat_set(_sb_A, 2, 3, f64_mul(f64_from(4), _sb_c));
    ganita_mat_set(_sb_A, 3, 3, f64_mul(f64_from(3), _sb_c));
    var _sb_U = ganita_mat_new(4, 4);
    var _sb_Vt = ganita_mat_new(4, 4);
    var _sb_S = alloc(32);
    for (var _sb_k = 0; _sb_k < 4; _sb_k = _sb_k + 1) { store64(_sb_S + _sb_k * 8, 0); }
    var _sb_rc_t, _sb_rc_v = svd_golub_kahan(_sb_A, _sb_U, _sb_S, _sb_Vt);
    _SB_RUN = _SB_RUN + 1;
    # The singular values come back descending, so for c below s2/s1 the order is
    # (s1, s2, c*s1, c*s2) and s3/s1 is exactly c.
    var _sb_r = f64_div(load64(_sb_S + 16), load64(_sb_S));
    # ⚠ RELATIVE, not bit-exact: the QR sweep is iterative and 3 of 999 ratios
    # differ in the last places on CORRECT code. 4 ulp is as tight as this can go.
    # [measured: bit-exact variant of this sweep run against the repaired tree]
    # ⛔ AND THE NaN TEST IS LOAD-BEARING, NOT BELT-AND-BRACES. Below the floor
    # this routine returns S = (0,0,0,0), so the ratio is 0/0 = NaN — and EVERY
    # f64 comparison involving NaN returns 0, so the relative test alone SILENTLY
    # PASSES it. The first version of this block had no NaN arm and therefore
    # reported 0 failures across a band where 731 of 999 ratios return no answer
    # at all. It is the same hole the NaN arm of `_opt_wolfe_search` closes in src/optimize.cyr
    # (a NaN f is never an acceptable step; `_opt_armijo` documented it until 3.4.1).
    # [measured: 999-ratio classification with the NaN arm added, 2026-09-10]
    var _sb_good = 0;
    if (f64_eq(_sb_r, _sb_r) == 1) {
        if (f64_gt(f64_abs(f64_div(f64_sub(_sb_r, _sb_c), _sb_c)), 0x3CD0000000000000) == 0) {
            _sb_good = 1;
        }
    }
    if (_sb_good == 0) {
        _SB_BAD = _SB_BAD + 1;
        if (is_ok(_sb_rc_t) == 1) { _SB_SILENT = _SB_SILENT + 1; }
    }
    if (_sb_good == 1 && is_ok(_sb_rc_t) == 1) { _SB_OK = _SB_OK + 1; }
}
assert_eq(_SB_RUN, 999, "the SVD block-ratio sweep actually ran 999 ratios");
# ⭐ THE THREE-STAGE RECORD, because each stage answers a different question and
# the middle one was reported wrongly at the time.
#   2.16.0   256 correct (to 2^-257) | 269 loud | **474 SILENT WRONG** (from 2^-258)
#   2.17.0   268 correct (to 2^-269) | 731 loud | 0 silent
#   2.18.0   **999 correct, 0 loud, 0 silent**
# ⛔ 2.17.0 reported that middle row as "472 of 999 lost -> 0", which reads as
# *the routine now answers correctly*. It did not — it had converted a silent
# wrong answer into a loud one, which is a real and valuable change but not that
# one. The figure came from a probe that shared this block's own NaN hole.
# ⭐ 2.18.0 closes it properly: the Wilkinson shift no longer forms degree-FOUR
# quantities and is computed on power-of-two-scaled operands, so the floor at
# 2^-268.5 (the fourth root of the subnormal floor) is gone entirely.
# [measured: 999-ratio classification on all three trees, 2026-09-10]
assert_eq(_SB_SILENT, 0,
  "svd_golub_kahan: NO ratio returns HSB_ERR_NONE with wrong singular values (474 of 999 did)");
assert_eq(_SB_OK, 999,
  "svd_golub_kahan: every one of 999 block ratios is answered correctly, to 2^-1000");

# ⛔ AND THE FACTORS, WHICH ARE A SEPARATE QUESTION FROM THE VALUES — the roadmap
# carried this as *"open-ended: a known defect with no known fix"* since 2.15.0.
# `S` can be exactly right, `U` and `Vt` each perfectly orthogonal, and
# `U*S*Vt` still not be `A`. Measured: the small block came back with the WRONG
# SIGN — residual exactly twice the block — for **19 ratios, 2^-21 through
# 2^-39**, worst 9.5e-7, and for **288 of 999** on the 2.16.0 tree.
# ⭐ The cause was a pair of guards that disagreed: `_lp_bidiagonalize` applies a
# left reflector and records it when `vtv >= F64_TINY`, and replayed it into `U`
# only when `vtv > EPSILON_F64`, so every reflector in between went into `B` and
# not into `U`. **2.15.0 created that band** by repairing one of the pair.
# ⚠ This sweep is the one that would have caught it, and no existing assertion
# could: the suite checked reconstruction only at unit scale, where both guards
# agree.
# [measured: 999-ratio reconstruction scan on all three trees, 2026-09-10]
var _SR_RUN = 0;
var _SR_BAD = 0;
for (var _sr_e = 2; _sr_e < 1001; _sr_e = _sr_e + 1) {
    var _sr_c = (1023 - _sr_e) << 52;
    var _sr_A = ganita_mat_new(4, 4);
    for (var _sr_i = 0; _sr_i < 4; _sr_i = _sr_i + 1) {
        for (var _sr_j = 0; _sr_j < 4; _sr_j = _sr_j + 1) {
            ganita_mat_set(_sr_A, _sr_i, _sr_j, 0);
        }
    }
    ganita_mat_set(_sr_A, 0, 0, f64_from(3));
    ganita_mat_set(_sr_A, 0, 1, f64_from(4));
    ganita_mat_set(_sr_A, 1, 1, f64_from(3));
    ganita_mat_set(_sr_A, 2, 2, f64_mul(f64_from(3), _sr_c));
    ganita_mat_set(_sr_A, 2, 3, f64_mul(f64_from(4), _sr_c));
    ganita_mat_set(_sr_A, 3, 3, f64_mul(f64_from(3), _sr_c));
    var _sr_U = ganita_mat_new(4, 4);
    var _sr_Vt = ganita_mat_new(4, 4);
    var _sr_S = alloc(32);
    for (var _sr_k = 0; _sr_k < 4; _sr_k = _sr_k + 1) { store64(_sr_S + _sr_k * 8, 0); }
    var _r6t, _r6v = svd_golub_kahan(_sr_A, _sr_U, _sr_S, _sr_Vt);
    var _sr_num = f64_from(0);
    var _sr_den = f64_from(0);
    for (var _sr_i2 = 0; _sr_i2 < 4; _sr_i2 = _sr_i2 + 1) {
        for (var _sr_j2 = 0; _sr_j2 < 4; _sr_j2 = _sr_j2 + 1) {
            var _sr_acc = f64_from(0);
            for (var _sr_k2 = 0; _sr_k2 < 4; _sr_k2 = _sr_k2 + 1) {
                _sr_acc = f64_add(_sr_acc, f64_mul(f64_mul(
                      ganita_mat_get(_sr_U, _sr_i2, _sr_k2), load64(_sr_S + _sr_k2 * 8)),
                    ganita_mat_get(_sr_Vt, _sr_k2, _sr_j2)));
            }
            var _sr_a = ganita_mat_get(_sr_A, _sr_i2, _sr_j2);
            var _sr_d = f64_sub(_sr_acc, _sr_a);
            _sr_num = f64_add(_sr_num, f64_mul(_sr_d, _sr_d));
            _sr_den = f64_add(_sr_den, f64_mul(_sr_a, _sr_a));
        }
    }
    var _sr_rel = f64_div(f64_sqrt(_sr_num), f64_sqrt(_sr_den));
    _SR_RUN = _SR_RUN + 1;
    # ⚠ NaN arm first, for the same reason as the block above: a NaN relative
    # error passes every comparison silently.
    var _sr_ok = 0;
    if (f64_eq(_sr_rel, _sr_rel) == 1) {
        if (f64_gt(_sr_rel, 0x3D06849B86A12B9B) == 0) { _sr_ok = 1; }
    }
    if (_sr_ok == 0) { _SR_BAD = _SR_BAD + 1; }
}
assert_eq(_SR_RUN, 999, "the SVD reconstruction sweep actually ran 999 ratios");
assert_eq(_SR_BAD, 0,
  "svd_golub_kahan: ||A - U*S*Vt||_F / ||A||_F stays at machine epsilon for every block ratio");

# ⚠ TWO MUTANTS SURVIVE THIS BLOCK, both on the Wilkinson shift's scaling, and
# each has its own reason.
# ⭐ (a) SCALING BY THE MAX ENTRY INSTEAD OF ITS POWER-OF-TWO FLOOR is a genuine
# correctness EQUIVALENCE, not a gap: the scale only ever divides the operands of
# ONE Givens rotation, and a rotation depends on the RATIO y:z, so an inexact
# scale produces the identical `cs`/`sn`. The power of two is kept because it is
# free, not because it is load-bearing — the contrast is `cga_norm`, where the
# same choice protects an exact cancellation and its mutant dies.
# ⚠ (b) WIDENING THE SHIFT'S `denom == 0` TEST TO F64_TINY survives because the
# regime where the two differ needs a `denom` small enough to be subnormal, and
# `denom = sign(delta)*(|delta| + hypot(delta, a12))` is at least `|a12|` — so
# reaching it needs an `a12` the deflation test has already zeroed.
# ⛔ A THIRD SURVIVOR WAS KILLED BY MEASURING RATHER THAN REASONING. Multiplying
# by `1/s` instead of dividing looked unreachable for the same reason, and is
# not: it dies on the all-subnormal SVD fixture above.
# [measured: 9-mutant run over linalg_precision.cyr, 7 killed, 2026-09-10]

# ⛔ AND A RANK-DEFICIENT SMALL BLOCK REACHES `_lp_split_zero_diag`, WHICH NO
# FULL-RANK FIXTURE CAN. That routine only runs for a ZERO DIAGONAL entry inside
# an active block, and both arms of its chase had the same defect. Measured on
# the 2.16.0 tree: the small block's singular value came back as `c` where the
# truth is `c*sqrt(2)` — **29.3% low, with rc = HSB_ERR_NONE** — from c = 2^-539
# down. ⚠ The sweep above ran 999 full-rank ratios and could not see it: the two
# `_lp_split_zero_diag` mutants SURVIVED it, and this block is what kills them.
# ⭐ Both arms are exercised: `kind = 0` puts the zero diagonal LAST in the block
# (the upward chase) and `kind = 1` puts it FIRST (the rightward chase).
# [measured: 999-ratio x 2-arm sweep before and after; 11-mutant run, 2026-09-10]
var _SZ_RUN = 0;
var _SZ_BAD = 0;
var _SZ_SILENT = 0;
for (var _sz_k = 0; _sz_k < 2; _sz_k = _sz_k + 1) {
    for (var _sz_e = 2; _sz_e < 1001; _sz_e = _sz_e + 1) {
        var _sz_c = (1023 - _sz_e) << 52;
        var _sz_A = ganita_mat_new(4, 4);
        for (var _sz_i = 0; _sz_i < 4; _sz_i = _sz_i + 1) {
            for (var _sz_j = 0; _sz_j < 4; _sz_j = _sz_j + 1) {
                ganita_mat_set(_sz_A, _sz_i, _sz_j, 0);
            }
        }
        ganita_mat_set(_sz_A, 0, 0, F64_ONE);
        ganita_mat_set(_sz_A, 1, 1, F64_ONE);
        if (_sz_k == 0) {
            ganita_mat_set(_sz_A, 2, 2, _sz_c);
            ganita_mat_set(_sz_A, 2, 3, _sz_c);
        } else {
            ganita_mat_set(_sz_A, 2, 3, _sz_c);
            ganita_mat_set(_sz_A, 3, 3, _sz_c);
        }
        var _sz_U = ganita_mat_new(4, 4);
        var _sz_Vt = ganita_mat_new(4, 4);
        var _sz_S = alloc(32);
        for (var _sz_q = 0; _sz_q < 4; _sz_q = _sz_q + 1) { store64(_sz_S + _sz_q * 8, 0); }
        var _sz_rc_t, _sz_rc_v = svd_golub_kahan(_sz_A, _sz_U, _sz_S, _sz_Vt);
        _SZ_RUN = _SZ_RUN + 1;
        # the rank-1 block has singular values (c*sqrt(2), 0); with two unit
        # singular values above it, that lands third.
        if (load64(_sz_S + 16) != f64_mul(_sz_c, 0x3FF6A09E667F3BCD)) {
            _SZ_BAD = _SZ_BAD + 1;
            if (is_ok(_sz_rc_t) == 1) { _SZ_SILENT = _SZ_SILENT + 1; }
        }
    }
}
assert_eq(_SZ_RUN, 1998, "the zero-diagonal split sweep ran 2 arms x 999 ratios");
assert_eq(_SZ_BAD, 0,
  "svd_golub_kahan: a rank-deficient block at ratio c has singular value c*sqrt(2), bit-exact");
assert_eq(_SZ_SILENT, 0,
  "svd_golub_kahan: and none of them is a SILENT 29.3%-low answer");

# ⛔ `eigen_qr` LOST THE SMALL BLOCK FOR 463 OF 998 RATIOS — and with it the LARGE
# block, because the whole call returned HSB_ERR_NO_CONVERGENCE.
# ⭐ THE SITE THAT MATTERED WAS NOT ON THE CENSUS LIST. Repairing the Givens
# radius in the bulge chase changed NOTHING measurable; the loss was the
# Wilkinson shift forming `e2*e2`, which flushes, collapsing `mu` to `d2` — and
# an unshifted step on a symmetric block with equal diagonals is a FIXED POINT,
# so the iteration burns its whole budget making a rotation that swaps two equal
# entries. **A repair that moves no number is pointing at a second defect.**
# [measured: 998-ratio sweep before and after, 2026-09-10]
var _EB_RUN = 0;
var _EB_BAD = 0;
for (var _eb_e = 3; _eb_e < 1001; _eb_e = _eb_e + 1) {
    var _eb_c = (1023 - _eb_e) << 52;
    var _eb_A = ganita_mat_new(4, 4);
    for (var _eb_i = 0; _eb_i < 4; _eb_i = _eb_i + 1) {
        for (var _eb_j = 0; _eb_j < 4; _eb_j = _eb_j + 1) {
            ganita_mat_set(_eb_A, _eb_i, _eb_j, 0);
        }
    }
    ganita_mat_set(_eb_A, 0, 0, f64_from(3));
    ganita_mat_set(_eb_A, 0, 1, f64_from(4));
    ganita_mat_set(_eb_A, 1, 0, f64_from(4));
    ganita_mat_set(_eb_A, 1, 1, f64_from(3));
    ganita_mat_set(_eb_A, 2, 2, f64_mul(f64_from(3), _eb_c));
    ganita_mat_set(_eb_A, 2, 3, f64_mul(f64_from(4), _eb_c));
    ganita_mat_set(_eb_A, 3, 2, f64_mul(f64_from(4), _eb_c));
    ganita_mat_set(_eb_A, 3, 3, f64_mul(f64_from(3), _eb_c));
    var _eb_vals = alloc(32);
    for (var _eb_k = 0; _eb_k < 4; _eb_k = _eb_k + 1) { store64(_eb_vals + _eb_k * 8, 0); }
    var _eb_vecs = ganita_mat_new(4, 4);
    _EB_RUN = _EB_RUN + 1;
    var _rj8t, _rj8v = eigen_qr(_eb_A, 4, 400, _eb_vals, _eb_vecs);
    if (is_err_result(_rj8t) == 1) {
        _EB_BAD = _EB_BAD + 1;
    }
    # eigenvalues are {7, -1, 7c, -c}; the largest |lambda| below 1 is 7c, and the
    # sweep starts at c = 2^-3 so that 7c < 1 holds throughout.
    var _eb_best = 0;
    for (var _eb_i2 = 0; _eb_i2 < 4; _eb_i2 = _eb_i2 + 1) {
        var _eb_a = f64_abs(load64(_eb_vals + _eb_i2 * 8));
        if (f64_lt(_eb_a, F64_ONE) == 1 && f64_gt(_eb_a, _eb_best) == 1) { _eb_best = _eb_a; }
    }
    var _eb_w = f64_mul(f64_from(7), _eb_c);
    if (f64_gt(f64_abs(f64_sub(_eb_best, _eb_w)), f64_mul(_eb_w, EPSILON_F64)) == 1) {
        _EB_BAD = _EB_BAD + 1;
    }
}
assert_eq(_EB_RUN, 998, "the eigen block-ratio sweep actually ran 998 ratios");
assert_eq(_EB_BAD, 0,
  "eigen_qr: the small block's dominant eigenvalue is 7c, for c = 2^-3 .. 2^-1000");

# ⚠ AND THE HONEST RESIDUE, RECORDED RATHER THAN HIDDEN (2.17.0). An ALL-SUBNORMAL
# matrix was never balanced at all: `_lp_pow2_floor(s)` read the exponent field,
# which is 0 for every subnormal, and returned 1.0. So the whole routine ran
# unbalanced on entries already below the flush floor. The 2.17.0 repair moved the
# first failing magnitude from 2^-1025 to 2^-1039 — 14 binades — and 22 of 1061
# remained. That was `_lp_pow2_floor`, not a norm site, and 2.17.0 left it for a
# later release; 2.18.0 repaired it (the mantissa arm, next block). This assertion
# pins the boundary the 2.17.0 repair reached.
# [measured: 1061-magnitude uniform sweep before and after, 2026-09-10]
var _ES_A = ganita_mat_new(2, 2);
ganita_mat_set(_ES_A, 0, 0, f64_mul(f64_from(3), 1 << 36));      # 3 * 2^-1038
ganita_mat_set(_ES_A, 0, 1, f64_mul(f64_from(4), 1 << 36));
ganita_mat_set(_ES_A, 1, 0, f64_mul(f64_from(4), 1 << 36));
ganita_mat_set(_ES_A, 1, 1, f64_mul(f64_from(3), 1 << 36));
var _ES_vals = alloc(16);
store64(_ES_vals, 0);
store64(_ES_vals + 8, 0);
var _ES_vecs = ganita_mat_new(2, 2);
var _rq96t, _rq96v = eigen_qr(_ES_A, 2, 200, _ES_vals, _ES_vecs);
assert_eq(is_ok(_rq96t), 1, "eigen_qr: an all-subnormal symmetric matrix at 2^-1038 converges (it stopped at 2^-1025)");

# ⛔ 2.18.0 — AND THE RESIDUE WAS `_lp_pow2_floor`, EXACTLY AS 2.17.0 PREDICTED.
# It masked the exponent field and returned 1.0 when that was zero — which is
# every subnormal — so a matrix whose largest entry is below DBL_MIN ran the
# whole decomposition UNBALANCED, the one input that needs balancing most.
# With the mantissa arm added, `eigen_qr` is exact all the way to **2^-1070**,
# four binades off the smallest subnormal there is.
# ⚠ THE 2^-1038 ASSERTION ABOVE CANNOT SEE THIS and the mutation run says so:
# 2.17.0's norm repairs alone already reached 2^-1039, so the fixture that pinned
# the old boundary sits one binade INSIDE the repaired range and a mutant that
# reverts `_lp_pow2_floor` survives it. The depth has to follow the repair.
# [measured: 1061-magnitude sweep, 22 of 1061 failing -> 0, 2026-09-10]
var _EP_A = ganita_mat_new(2, 2);
ganita_mat_set(_EP_A, 0, 0, f64_mul(f64_from(3), 1 << 4));     # 3 * 2^-1070
ganita_mat_set(_EP_A, 0, 1, f64_mul(f64_from(4), 1 << 4));
ganita_mat_set(_EP_A, 1, 0, f64_mul(f64_from(4), 1 << 4));
ganita_mat_set(_EP_A, 1, 1, f64_mul(f64_from(3), 1 << 4));
var _EP_vals = alloc(16);
store64(_EP_vals, 0);
store64(_EP_vals + 8, 0);
var _EP_vecs = ganita_mat_new(2, 2);
var _rq97t, _rq97v = eigen_qr(_EP_A, 2, 200, _EP_vals, _EP_vecs);
assert_eq(is_ok(_rq97t), 1, "eigen_qr: an all-subnormal matrix at 2^-1070 converges — _lp_pow2_floor balances it");
# eigenvalues of k*[[3,4],[4,3]] are 7k and -k, exact at every k.
var _EP_hi = f64_abs(load64(_EP_vals));
var _EP_lo = f64_abs(load64(_EP_vals + 8));
if (f64_gt(_EP_lo, _EP_hi) == 1) {
    var _EP_t = _EP_hi;
    _EP_hi = _EP_lo;
    _EP_lo = _EP_t;
}
assert_eq(_EP_hi, f64_mul(f64_from(7), 1 << 4),
  "eigen_qr: and its dominant eigenvalue is exactly 7k at 2^-1070");
assert_eq(_EP_lo, 1 << 4,
  "eigen_qr: and the other is exactly k");

# ⚠ THAT PAIR STOPPED DISCRIMINATING `_lp_pow2_floor` THE MOMENT THE DEFLATION
# TESTS WERE REPAIRED, and the mutation run said so rather than my noticing.
# Once `_lp_negligible` gained its exact-zero arm (2.18.0; this line said "divides
# instead of multiplying" through 3.3.1, which it never did), `eigen_qr` converges
# on an unbalanced subnormal matrix anyway — the two repairs overlap on that path —
# so a mutant reverting the balancing survives it. The SVD path did NOT overlap in
# 2.18.0: `_lp_bidiagonalize` guarded its Householder reflector with an ABSOLUTE
# `norm_l > EPSILON_F64` (2.22.0 made it `norm_l > 0`), so for an unbalanced
# subnormal matrix every reflector was skipped and the factorisation collapsed.
# Measured then with the balancing reverted: rc = HSB_ERR_NO_CONVERGENCE and
# S = (0, 0) at all four depths.
# ⭐ A = k*[[3,4],[0,3]] has singular values 5.606k and 1.606k; at k = 16 units of
# 2^-1074 those are 90 and 26 units, both exactly representable.
# [measured: all-subnormal SVD probe with and without the balancing, 2026-09-10]
#
# ⚠ THIS FIXTURE NO LONGER DISCRIMINATES `_lp_pow2_floor` EITHER. Since 2.22.1,
# `_lp_balance_scale` halves the scale until the smallest non-zero entry is
# normal, which lifts an all-subnormal matrix whatever `_lp_pow2_floor` returns.
# Measured on the 3.3.2 working tree: dropping `_lp_pow2_floor`'s mantissa arm
# passes all five suites (585/429/2323/267/971); dropping it AND the halving loop
# fails 13 assertions here, the three below among them. So 3.3.2 pins the helper
# directly: the five lines that follow, which fail when the mantissa arm is dropped.
# [measured: 2-mutant run, five suites; scratch harness, not reproducible in-tree, 2026-10-01; cycc 6.6.12]
assert_eq(_lp_pow2_floor(0x30), 0x20, "_lp_pow2_floor: 48 x 2^-1074 floors to 32 x 2^-1074 (the mantissa arm)");
assert_eq(_lp_pow2_floor(0x000FFFFFFFFFFFFF), 0x0008000000000000,
  "_lp_pow2_floor: the largest subnormal floors to 2^-1023");
assert_eq(_lp_pow2_floor(1), 1, "_lp_pow2_floor: the smallest subnormal is its own power of two");
assert_eq(_lp_pow2_floor(0x4008000000000000), 0x4000000000000000,
  "_lp_pow2_floor: 3.0 floors to 2.0 (the exponent arm)");
assert_eq(_lp_pow2_floor(0), F64_ONE, "_lp_pow2_floor: zero returns 1.0, the only input that does");
var _PS_A = ganita_mat_new(2, 2);
ganita_mat_set(_PS_A, 0, 0, f64_mul(f64_from(3), 1 << 4));     # 3 * 2^-1070
ganita_mat_set(_PS_A, 0, 1, f64_mul(f64_from(4), 1 << 4));
ganita_mat_set(_PS_A, 1, 0, 0);
ganita_mat_set(_PS_A, 1, 1, f64_mul(f64_from(3), 1 << 4));
var _PS_U = ganita_mat_new(2, 2);
var _PS_Vt = ganita_mat_new(2, 2);
var _PS_S = alloc(16);
store64(_PS_S, 0);
store64(_PS_S + 8, 0);
var _rq98t, _rq98v = svd_golub_kahan(_PS_A, _PS_U, _PS_S, _PS_Vt);
assert_eq(is_ok(_rq98t), 1, "svd_golub_kahan: an all-subnormal matrix decomposes — _lp_pow2_floor balances it");
assert_eq(load64(_PS_S), 90,
  "svd_golub_kahan: and its dominant singular value is 90 units of 2^-1074");
assert_eq(load64(_PS_S + 8), 26,
  "svd_golub_kahan: and the other is 26 units");

# === 3.3.3 G1: the balance-scale helpers, pinned directly ===
# 3.3.3 split the scale CHOICE (`_lp_balance_pick`) from the scans for
# cqr_decompose and gave it a `growth` factor that only cqr passes; svd_golub_kahan
# and eigen_qr keep 3.3.2's loop in `_lp_balance_scale`. Each exit is asserted on
# its boundary. The lo exit: lo = 6u is normal over sc only once sc <= 6 * 2^-52, so
# 2^-50 is the first power of two that works (6u / 2^-49 is 0.75 * DBL_MIN). The
# growth exit: (2^1002 / 2^-16) * 48 = 1.5 * 2^1023 is finite and one more halving
# is not; with growth 1 the same pair stops at 2^-21, the 2.22.1 exit, and
# `_lp_balance_scale` must still pick 2^-21 for the real matrix with that max and
# min, which is what keeps svd_golub_kahan and eigen_qr where they were (3.3.3
# returns NO_CONVERGENCE where they then overflow; tests/abuse.tcyr).
assert_eq(_lp_balance_pick(f64_from(9), f64_from(6), F64_ONE), f64_from(8),
  "_lp_balance_pick: every entry normal -> the loop does not run, pow2_floor(hi) = 8");
assert_eq(_lp_balance_pick(f64_from(9), 6, F64_ONE), (1023 - 50) << 52,
  "_lp_balance_pick: lo = 6u lifts to exactly 2^-50, the first scale where lo / sc is normal");
assert_eq(_lp_balance_pick((1023 + 1002) << 52, 1, f64_from(48)), (1023 - 16) << 52,
  "_lp_balance_pick: growth 48 stops at 2^-16, where (hi / sc) * 48 is still finite");
assert_eq(_lp_balance_pick((1023 + 1002) << 52, 1, F64_ONE), (1023 - 21) << 52,
  "_lp_balance_pick: growth 1 stops at 2^-21, the 2.22.1 exit");
var _g1_bsA = ganita_mat_new(3, 3);
for (var _g1_bk = 0; _g1_bk < 9; _g1_bk = _g1_bk + 1) { ganita_mat_set(_g1_bsA, _g1_bk / 3, _g1_bk % 3, 0); }
ganita_mat_set(_g1_bsA, 0, 0, f64_mul(f64_from(3), (1023 + 1000) << 52));
ganita_mat_set(_g1_bsA, 0, 1, (1023 + 1000) << 52);
ganita_mat_set(_g1_bsA, 1, 0, f64_mul(f64_from(4), (1023 + 1000) << 52));
ganita_mat_set(_g1_bsA, 1, 1, f64_mul(F64_TWO, (1023 + 1000) << 52));
ganita_mat_set(_g1_bsA, 2, 2, 1);
assert_eq(_lp_balance_scale(_g1_bsA, 3, 3), (1023 - 21) << 52,
  "_lp_balance_scale: the svd / eigen path keeps growth 1 (2^-21, where cqr's 48 stops at 2^-16)");
# The complex scan reads BOTH components and skips zeros: [[0, 5],[3i, 7 + 0.5i]].
var _g1_bsC = cmat_new(2, 2);
cmat_set(_g1_bsC, 0, 0, cx_new(0, 0));
cmat_set(_g1_bsC, 0, 1, cx_new(f64_from(5), 0));
cmat_set(_g1_bsC, 1, 0, cx_new(0, f64_from(3)));
cmat_set(_g1_bsC, 1, 1, cx_new(f64_from(7), F64_HALF));
assert_eq(_lp_cmat_min_abs(_g1_bsC), F64_HALF,
  "_lp_cmat_min_abs: the smallest non-zero component is an imaginary part, 0.5 (a real-only scan: 5)");
cmat_set(_g1_bsC, 0, 1, cx_new(f64_div(F64_ONE, f64_from(4)), 0));
assert_eq(_lp_cmat_min_abs(_g1_bsC), f64_div(F64_ONE, f64_from(4)),
  "_lp_cmat_min_abs: and a real part, 0.25, when that is smaller (an imaginary-only scan: 0.5)");
var _g1_bsZ = cmat_new(2, 2);
for (var _g1_bz = 0; _g1_bz < 4; _g1_bz = _g1_bz + 1) { cmat_set(_g1_bsZ, _g1_bz / 2, _g1_bz % 2, cx_new(0, 0)); }
assert_eq(_lp_cmat_min_abs(_g1_bsZ), F64_POS_INF, "_lp_cmat_min_abs: an all-zero matrix has none -> +Inf");
# ⚠ WHY NO NaN REACHES `_lp_vec_norm_scaled`'s NaN-TRUE `mx > 0` EXIT: called
# directly it returns 0 for [NaN, 0], but its one caller routes a NaN sum around it
# and returns the NaN. Pinned here so a rewrite of that routing cannot reopen it.
var _g1_nv = alloc(16);
store64(_g1_nv, f64_div(f64_from(0), f64_from(0)));
store64(_g1_nv + 8, 0);
assert_eq(f64_eq(_lp_vec_norm(_g1_nv, 0, 2), _lp_vec_norm(_g1_nv, 0, 2)), 0,
  "_lp_vec_norm: [NaN, 0] -> NaN, never routed into the scaled path that would return 0");

# === 3.3.3 R4lp: the balance loop tests the exact quotient ===
# `_lp_balance_pick` looped while the ROUNDED quotient lo / sc was below DBL_MIN. For
# lo = 0x001FFFFFFFFFFFFF (just under 2^-1021) and sc = pow2_floor(3) = 2, the exact
# quotient is half a subnormal unit below DBL_MIN and rounds UP to it, so the loop
# stopped at sc = 2 and the divide lost the entry's last bit: cqr_decompose returned
# 0x0020000000000000 for it. It now asks `lo < DBL_MIN * sc`, exact, and lifts once
# more to sc = 1. The 0.5 control has pow2_floor = 0.5, where the quotient is normal
# either way.
# ⚠ ONLY IN cqr_decompose. svd_golub_kahan and eigen_qr keep 3.3.2's rounded test
# (`_lp_balance_scale`), so they still return 0x0020000000000000 for this entry: the
# exact test moved 583 of 6000 matrices built on its boundary, every one inside 1e-11
# of the oracle on both sides, and 3.3.3 keeps those svd / eigen results byte-identical
# to 3.3.2. The `_lp_balance_scale` assert pins that choice at the scan.
# [measured: scratch probes on 3.3.2, this tree and the exact-test variant + 720-digit oracle, not reproducible in-tree]
assert_eq(_lp_balance_pick(f64_from(3), 0x001FFFFFFFFFFFFF, F64_ONE), F64_ONE,
  "_lp_balance_pick: lo / 2 rounds up to DBL_MIN but is below it -> one more halving, sc = 1 (rounded test: 2)");
var _r4lp_bxA = ganita_mat_new(2, 2);
ganita_mat_set(_r4lp_bxA, 0, 0, f64_from(3));
ganita_mat_set(_r4lp_bxA, 0, 1, 0);
ganita_mat_set(_r4lp_bxA, 1, 0, 0);
ganita_mat_set(_r4lp_bxA, 1, 1, 0x001FFFFFFFFFFFFF);
assert_eq(_lp_balance_scale(_r4lp_bxA, 2, 2), F64_TWO,
  "_lp_balance_scale: the svd / eigen scan keeps 3.3.2's rounded test on diag(3, 0x001F..F), sc = 2 (exact: 1)");
var _r4lp_bxS = alloc(16);
var _r4lp_bxC = cmat_new(2, 2);
cmat_set(_r4lp_bxC, 0, 0, cx_new(f64_from(3), 0));
cmat_set(_r4lp_bxC, 0, 1, cx_new(0, 0));
cmat_set(_r4lp_bxC, 1, 0, cx_new(0, 0));
cmat_set(_r4lp_bxC, 1, 1, cx_new(0x001FFFFFFFFFFFFF, 0));
var _r4lp_bxR = cmat_new(2, 2);
var _r4lp_bx3t, _r4lp_bx3v = cqr_decompose(_r4lp_bxC, cmat_new(2, 2), _r4lp_bxR);
assert_eq(is_ok(_r4lp_bx3t), 1, "cqr diag(3, 0x001F..F): reports success");
assert_eq(f64_abs(HComplex_re(cmat_get(_r4lp_bxR, 1, 1))), 0x001FFFFFFFFFFFFF,
  "cqr diag(3, 0x001F..F): |Re R11| is the entry exactly (3.3.2: 1 ulp high)");
ganita_mat_set(_r4lp_bxA, 0, 0, F64_HALF);
var _r4lp_bx4t, _r4lp_bx4v = svd_golub_kahan(_r4lp_bxA, ganita_mat_new(2, 2), _r4lp_bxS, ganita_mat_new(2, 2));
assert_eq(load64(_r4lp_bxS + 8), 0x001FFFFFFFFFFFFF, "svd diag(0.5, 0x001F..F) (control): S1 exact, as it was");

# ⛔ 2.18.0 — AND THE DEFLATION TESTS THEMSELVES FORMED A PRODUCT THAT FLUSHED.
# `f64_lt(|off|, EPSILON_F64 * (|a| + |b|))` asks a RATIO question and answered it
# by building `1e-12 * (|a| + |b|)` first — which for diagonals at 2^-1050 is
# below the smallest subnormal, i.e. exactly 0. The test became `|off| < 0`, never
# fired, and the block never deflated. The five sites that formed such a product
# all go through `_lp_negligible_rel` now, whose exact-zero arm is the repair; the
# product form stays (see that helper's comment). Through 3.3.1 this said "all
# now dividing", which none is. Measured across the 72 subnormal block ratios:
# **37 failing -> 28**.
# ⛔ 2.20.0 — THE PARAGRAPH THAT USED TO SIT HERE WAS FALSE IN BOTH HALVES, AND IT
# HAD BEEN ASSERTING SOMETHING REASSURING FOR TWO RELEASES. It read: "the
# remaining 28 are the GRID, NOT A DEFECT ... the routine reports
# HSB_ERR_NO_CONVERGENCE, which is the honest answer to an unanswerable question."
# ⛔ (1) IT IS A DEFECT. Scaling the active block into the normal range before the
# QR sweep answers ratios the shipped tree gets wrong, so the subnormal grid was
# never the binding constraint — the binding constraint is that the sweep does its
# arithmetic ON that grid, where every rounding is +-0.5 unit of 2^-1074.
# ⛔ (2) IT MOSTLY DOES NOT REPORT NO_CONVERGENCE. Measured over 8 fixtures x 52
# subnormal scales = 416 rows, against singular values computed from the ACTUAL
# rounded f64 entries at 120 decimal digits: **270 rows return HSB_ERR_NONE and
# only 57 of those are right**. 213 are rc = NONE with singular values wrong by
# more than 2 ulp — worst **9.78x** — i.e. a confident wrong answer, the class this
# project has spent six releases removing. 146 fail loudly.
# ⛔ (3) THE OLD SWEEP COULD NOT HAVE SEEN IT: all its fixtures are
# UPPER-TRIANGULAR 2x2 blocks. Split by family, upper is 56 correct / 60 loud /
# 92 silent, while a GENERAL 2x2 (non-zero lower-left) is **1 correct / 86 loud /
# 121 silent** — the routine is essentially never right there.
# ⚠ 2.20.0 pinned the counts below as a CHARACTERISATION of a tracked defect, so
# its repair would have an acceptance test and any movement would announce itself.
# The repair it named — scale the active block inside `_lp_bidiag_qr`, step,
# unscale — was refuted: 2.22.0 measured it (CHANGELOG [2.22.0]) converting 84
# loud rows into silent wrong answers. 2.22.1 closed the defect another way
# (`_lp_balance_scale` plus normalised reflectors), and the pins below were
# inverted to assert the truth.
# [measured: 8 fixtures x 52 subnormal scales vs a 120-digit oracle, 2026-09-10]
var _DF_A = ganita_mat_new(4, 4);
for (var _df_i = 0; _df_i < 4; _df_i = _df_i + 1) {
    for (var _df_j = 0; _df_j < 4; _df_j = _df_j + 1) { ganita_mat_set(_DF_A, _df_i, _df_j, 0); }
}
var _DF_c = 1 << 9;                               # 2^-1065, subnormal
ganita_mat_set(_DF_A, 0, 0, f64_from(3));
ganita_mat_set(_DF_A, 0, 1, f64_from(4));
ganita_mat_set(_DF_A, 1, 1, f64_from(3));
ganita_mat_set(_DF_A, 2, 2, f64_mul(f64_from(3), _DF_c));
ganita_mat_set(_DF_A, 2, 3, f64_mul(f64_from(4), _DF_c));
ganita_mat_set(_DF_A, 3, 3, f64_mul(f64_from(3), _DF_c));
var _DF_U = ganita_mat_new(4, 4);
var _DF_Vt = ganita_mat_new(4, 4);
var _DF_S = alloc(32);
for (var _df_k = 0; _df_k < 4; _df_k = _df_k + 1) { store64(_DF_S + _df_k * 8, 0); }
var _rq99t, _rq99v = svd_golub_kahan(_DF_A, _DF_U, _DF_S, _DF_Vt);
assert_eq(is_ok(_rq99t), 1,
  "svd_golub_kahan: a SUBNORMAL sub-block at 2^-1065 deflates (the product used to flush to 0)");
assert_eq(f64_div(load64(_DF_S + 16), load64(_DF_S)), _DF_c,
  "svd_golub_kahan: and its singular values are still c times the large block's");

# --- 2.20.0: the widened family, and what it shows.
# Build a 4x4 block-diagonal [B, c*B] and sweep c over subnormal powers of two.
# Truth for such a matrix is {s1(B), s2(B), c*s1(B), c*s2(B)}.
# ⚠ FIXTURE 2 HAS A NON-ZERO LOWER-LEFT ENTRY. The old sweep used only
# upper-triangular blocks, which is the family this defect is mildest in.
fn _sq_blk(idx, which) {
    if (idx == 0) {
        if (which == 0) { return 3; }
        if (which == 1) { return 4; }
        if (which == 2) { return 0; }
        return 3;
    }
    if (idx == 1) {
        if (which == 0) { return 9; }
        if (which == 1) { return 1; }
        if (which == 2) { return 0; }
        return 2;
    }
    if (which == 0) { return 3; }
    if (which == 1) { return 4; }
    if (which == 2) { return 2; }
    return 3;
}
fn _sq_run(idx, cscale, out_S) {
    var A = ganita_mat_new(4, 4);
    for (var i = 0; i < 4; i = i + 1) {
        for (var j = 0; j < 4; j = j + 1) { ganita_mat_set(A, i, j, 0); }
    }
    ganita_mat_set(A, 0, 0, f64_from(_sq_blk(idx, 0)));
    ganita_mat_set(A, 0, 1, f64_from(_sq_blk(idx, 1)));
    ganita_mat_set(A, 1, 0, f64_from(_sq_blk(idx, 2)));
    ganita_mat_set(A, 1, 1, f64_from(_sq_blk(idx, 3)));
    ganita_mat_set(A, 2, 2, f64_mul(f64_from(_sq_blk(idx, 0)), cscale));
    ganita_mat_set(A, 2, 3, f64_mul(f64_from(_sq_blk(idx, 1)), cscale));
    ganita_mat_set(A, 3, 2, f64_mul(f64_from(_sq_blk(idx, 2)), cscale));
    ganita_mat_set(A, 3, 3, f64_mul(f64_from(_sq_blk(idx, 3)), cscale));
    var U = ganita_mat_new(4, 4);
    var Vt = ganita_mat_new(4, 4);
    for (var k = 0; k < 4; k = k + 1) { store64(out_S + k * 8, 0); }
    return svd_golub_kahan(A, U, out_S, Vt);
}

var _sq_S = alloc(32);

# ⛔ 2.20.0 — THE SMALLEST SINGULAR VALUE WAS RETURNED AS EXACTLY ZERO, WITH
# rc = NONE. Fixture [[9,1],[0,2]] at c = 2^-1073. Truth from a 120-digit oracle
# over the ACTUAL rounded entries: the two subnormal singular values are 18 and 4
# units of 2^-1074. The routine returned 16 and **0** and called it success.
assert_eq(is_ok(_sq_run(1, 1 << 1, _sq_S)), 1,
  "svd subnormal: upper-triangular block reports SUCCESS at c=2^-1073");
# ⭐ 2.22.1 — INVERTED. This asserted the fabricated ZERO as a tracked defect;
# the value is now the truth, 4 units of 2^-1074, from a 200-digit oracle over
# the actual rounded entries. **A pinned defect is a tripwire for its own fix.**
assert_eq(load64(_sq_S + 24), 4,
  "svd subnormal: ...and its smallest singular value is 4 units (was a fabricated ZERO)");
assert_eq(load64(_sq_S + 16), 18,
  "svd subnormal: ...and its largest is 18 units (was 16, an 11% loss in the balance divide)");

# ⛔ 2.20.0 — A GENERAL 2x2 WAS WORSE: the smallest singular value came back 10.8x
# TOO LARGE. Fixture [[3,4],[2,3]] at c = 2^-1070; the exact singular values are
# 98.5964 and 2.5964 units of 2^-1074, and it returned 88 and 28.
# ⚠ An earlier draft said "truth is 3 ... 9.3x": it ROUNDED the truth to an
# integer and then divided by the rounded value. 28 / 2.5964 = 10.78.
# [measured: the 2.20.0 subnormal sweep vs a 120-digit oracle, 2026-09-10]
assert_eq(is_ok(_sq_run(2, 1 << 4, _sq_S)), 1,
  "svd subnormal: general 2x2 reports SUCCESS at c=2^-1070");
# ⭐ 2.22.1 — INVERTED. Was 28 units where the truth is 2.5964 (10.8x too large,
# silent). Now 3, which is 2.5964 rounded to the grid.
# [measured: 200-digit Decimal oracle over the actual rounded entries, 2026-09-11]
assert_eq(load64(_sq_S + 24), 3,
  "svd subnormal: ...smallest singular value is 3 units, the truth (was 28, 10.8x)");
assert_eq(load64(_sq_S + 16), 99,
  "svd subnormal: ...and its largest is 99 units, the truth");

# ⭐ 2.22.1 — INVERTED, AND THIS ONE IS THE SUBTLEST OF THE FOUR. The same
# fixture at c = 2^-1074 used to report NO_CONVERGENCE; it now succeeds, and
# succeeding is CORRECT. At that scale the true singular values are
# 6.1623 and 0.16238 UNITS of 2^-1074 — and 0.16238 of a unit is below the
# smallest representable number, so the correctly-rounded answer for the smaller
# one **is exactly zero**. Returning (6, 0) is right; failing was not.
# ⚠ Asserted with its truth beside it precisely because "returns 0" is also what
# the fabricated-zero class produces. The discriminator is that the LARGER value
# is simultaneously correct at 6 units — a fabricating routine gets neither.
assert_eq(is_ok(_sq_run(2, 1 << 0, _sq_S)), 1,
  "svd subnormal: general 2x2 at c=2^-1074 now SUCCEEDS (it used to fail loudly)");
assert_eq(load64(_sq_S + 16), 6,
  "svd subnormal: ...largest is 6 units, the truth");
assert_eq(load64(_sq_S + 24), 0,
  "svd subnormal: ...and smallest is 0 because 0.16238 of a unit rounds to zero");

# ⚠ A COUNTER over the widened sweep, asserted with its sample count so a loop
# that ran zero times cannot read as success.
var _sq_ok = 0;
var _sq_n = 0;
for (var _sq_f = 0; _sq_f < 3; _sq_f = _sq_f + 1) {
    for (var _sq_e = 0; _sq_e < 52; _sq_e = _sq_e + 1) {
        _sq_n = _sq_n + 1;
        if (is_ok(_sq_run(_sq_f, 1 << _sq_e, _sq_S)) == 1) { _sq_ok = _sq_ok + 1; }
    }
}
assert_eq(_sq_n, 156, "svd subnormal sweep: all 156 (fixture, scale) pairs ran");
# ⛔ 2.20.0 — 94 of 156 reported SUCCESS. Across the full 8-fixture measurement it
# was 270 of 416, of which only 57 were right — so most of those were confident
# wrong answers, not successes. Pinned then as a tracked defect so the repair had
# an acceptance test.
# ⭐ 2.22.1 — 94 of 156 -> 156 of 156, AND THE COUNT ALONE IS NOT THE POINT.
# Classified against a 200-digit oracle, the sweep goes
#   2.22.0:  CORRECT 23, LOUD 62, SILENT 71
#   2.22.1:  CORRECT 151, LOUD 0, SILENT 5
# with **zero CORRECT -> anything regressions and zero LOUD -> SILENT** — the
# trade the 2.19.0 refutation named and the reason the balance repair could not
# ship on its own (alone it converted 30 loud rows into silent wrong answers).
# ⚠ The 5 that remain are all at the normal/subnormal boundary (c ~ 2^-1023),
# where the small block straddles the two grids; they were silent before too, so
# nothing regressed. Recorded rather than tidied away.
# [measured: 3 fixtures x 52 scales vs a 200-digit oracle, both trees, 2026-09-11]
assert_eq(_sq_ok, 156, "svd subnormal sweep: 156 of 156 report SUCCESS, 151 of them correct");

# ================================================================
# 2.22.0 -- THE HOUSEHOLDER GATE, AND WHY THIS WAS NEVER A SUBNORMAL DEFECT
# ================================================================
# ⛔ The roadmap filed this as "subnormal SVD". It is not. `_lp_bidiagonalize`
# gated its left and right Householder reflectors on `norm > EPSILON_F64` -- an
# ABSOLUTE 1e-12 on a degree-ONE length -- and when the gate fired the reflector
# was skipped while the extraction below it still read only the bidiagonal band,
# so the entries that reflector would have zeroed were SILENTLY DROPPED and the
# routine returned the factorisation of a DIFFERENT matrix with rc = HSB_ERR_NONE.
# ⭐ The boundary is a BLOCK RATIO of ~2^-40, i.e. a condition number of ~1e12 --
# an ordinary ill-conditioned matrix, ~982 binades above where the roadmap placed
# it. Measured on the shipped 2.21.0 tree over a 60-scale normal-range sweep:
# 25 of 60 silently wrong; repaired, 0.
# ⚠ Oracle-free by construction: A = blockdiag(B, c*B) has singular values
# {s(B)} u {c*s(B)} EXACTLY, and c is a power of two, so `c * S[k]` is exact and
# bit equality is the right assertion -- no reference implementation is involved.
# [measured: 60 normal + 52 subnormal block ratios, both trees, 2026-09-11]
fn _hh_blk(i, j) {
    if (i == 0) {
        if (j == 0) { return 3; }
        return 4;
    }
    if (j == 0) { return 2; }
    return 3;
}
fn _hh_run(e, out_S) {
    var c = (1023 - e) << 52;
    var A = ganita_mat_new(4, 4);
    for (var i = 0; i < 4; i = i + 1) {
        for (var j = 0; j < 4; j = j + 1) { ganita_mat_set(A, i, j, 0); }
    }
    for (var p = 0; p < 2; p = p + 1) {
        for (var q = 0; q < 2; q = q + 1) {
            ganita_mat_set(A, p, q, f64_from(_hh_blk(p, q)));
            ganita_mat_set(A, 2 + p, 2 + q, f64_mul(f64_from(_hh_blk(p, q)), c));
        }
    }
    var U = ganita_mat_new(4, 4);
    var Vt = ganita_mat_new(4, 4);
    for (var k = 0; k < 4; k = k + 1) { store64(out_S + k * 8, 0); }
    return svd_golub_kahan(A, U, out_S, Vt);
}

var _hh_S = alloc(32);
# 2^-40 is the first scale the shipped tree got wrong. Multiplying a normal f64 by
# 2^-40 subtracts 40 from its exponent field, so the expected bits are exactly
# `S[k] - (40 << 52)` -- an exact identity, not a tolerance.
assert_eq(is_ok(_hh_run(40, _hh_S)), 1, "svd 2^-40 block ratio: reports success");
assert_eq(load64(_hh_S + 16), load64(_hh_S) - (40 << 52),
  "svd 2^-40: the small block's largest singular value is EXACTLY c times the large block's");
assert_eq(load64(_hh_S + 24), load64(_hh_S + 8) - (40 << 52),
  "svd 2^-40: and its smallest is too (shipped 2.21.0 returned it 9.89x too large)");
# ⚠ A DEEPER scale, to prove the repair is not a threshold moved one binade.
assert_eq(is_ok(_hh_run(200, _hh_S)), 1, "svd 2^-200 block ratio: reports success");
assert_eq(load64(_hh_S + 16), load64(_hh_S) - (200 << 52),
  "svd 2^-200: still exactly c times, 160 binades below the old cliff");
# ⚠ And a CONTROL above the old boundary, so the assertions above cannot pass by
# the routine having become scale-free in a way that broke the easy case.
assert_eq(is_ok(_hh_run(10, _hh_S)), 1, "svd 2^-10 block ratio (control): reports success");
assert_eq(load64(_hh_S + 16), load64(_hh_S) - (10 << 52),
  "svd 2^-10 (control): exact, as it always was");

# ⛔ THE SYMMETRIC TWIN, AND IT IS WHY THIS RELEASE COVERS TWO PUBLIC ENTRY
# POINTS. `_lp_tridiagonalize` carries the identical gate, so `eigen_qr` returned
# the spectrum of a DIFFERENT matrix. A = [1] (+) c*B3 with
# B3 = [[1,1,2],[1,4,1],[2,1,1]], whose exact eigenvalues are -1, 2, 5; the
# leading 1 pins max|A| = 1 so balancing is the IDENTITY and nothing here is
# subnormal or scaled.
# ⛔ Shipped 2.21.0 from c = 2^-42 down returned lambda/c = {4.5615528, 1,
# 0.4384472} -- and those are exactly the eigenvalues of
# tridiag(diag = (c,4c,c), offdiag = (c,c)), the matrix you get by DROPPING
# W[3,1] = 2c. The mechanism is pinned by the values themselves.
# ⭐ THE SMALLEST EIGENVALUE CAME BACK WITH THE WRONG SIGN (+0.438 for -1), which
# is the most discriminating thing to assert: a tolerance-based check would have
# passed a repair that only shrank the error.
# [measured: 1074-scale sweep, first wrong scale 2^-42, 2026-09-11]
fn _hh_b3(i, j) {
    if (i == 0) {
        if (j == 0) { return 1; }
        if (j == 1) { return 1; }
        return 2;
    }
    if (i == 1) {
        if (j == 0) { return 1; }
        if (j == 1) { return 4; }
        return 1;
    }
    if (j == 0) { return 2; }
    if (j == 1) { return 1; }
    return 1;
}
fn _hh_eig(e, vals) {
    var c = (1023 - e) << 52;
    var A = ganita_mat_new(4, 4);
    for (var i = 0; i < 4; i = i + 1) {
        for (var j = 0; j < 4; j = j + 1) { ganita_mat_set(A, i, j, 0); }
    }
    ganita_mat_set(A, 0, 0, F64_ONE);
    for (var p = 0; p < 3; p = p + 1) {
        for (var q = 0; q < 3; q = q + 1) {
            ganita_mat_set(A, 1 + p, 1 + q, f64_mul(f64_from(_hh_b3(p, q)), c));
        }
    }
    var vecs = ganita_mat_new(4, 4);
    for (var k = 0; k < 4; k = k + 1) { store64(vals + k * 8, 0); }
    return eigen_qr(A, 4, 2000, vals, vecs);
}

var _hh_V = alloc(32);
assert_eq(is_ok(_hh_eig(42, _hh_V)), 1, "eigen_qr 2^-42: reports success");
# The three small eigenvalues are c * {5, 2, -1}. Exact, since c is a power of two
# and 5, 2, -1 are exactly representable.
# ⚠ DIVIDED BY c, WHICH IS EXACT (a power of two), AND COMPARED AT A FEW ULP
# RATHER THAN BIT-EXACTLY. The first draft of these four asserted bit equality and
# all four failed BY EXACTLY ONE ULP -- the QR iteration converges to within
# rounding, it is not scale-equivariant the way the SVD's power-of-two block is
# (those assertions above ARE bit-exact and hold). The fixture was wrong, not the
# code. `ULP_TOL_H` is ~1e-15, a few ulp of 1.0, and it is still enormously
# discriminating here: the shipped tree is 8.8%, 50% and 144% out on these three.
# [measured: these assertions run against the 2.21.0 tree, 9 of 9 fail, 2026-09-11]
assert_eq(f64_approx_eq(f64_div(load64(_hh_V + 8), (1023 - 42) << 52),
    f64_from(5), ULP_TOL_H), 1,
  "eigen_qr 2^-42: largest small eigenvalue is 5c (shipped gave 4.5615528c)");
assert_eq(f64_approx_eq(f64_div(load64(_hh_V + 16), (1023 - 42) << 52),
    f64_from(2), ULP_TOL_H), 1,
  "eigen_qr 2^-42: middle is 2c (shipped gave 1c)");
assert_eq(f64_approx_eq(f64_div(load64(_hh_V + 24), (1023 - 42) << 52),
    f64_neg(F64_ONE), ULP_TOL_H), 1,
  "eigen_qr 2^-42: smallest is -c (shipped gave +0.4384472c)");
# ⭐ THE SIGN, ASSERTED SEPARATELY AND BIT-EXACTLY. This is the discriminating
# half: a repair that merely shrank the error would still pass a tolerance, and
# the shipped tree returns this eigenvalue POSITIVE where the answer is negative.
assert_eq(f64_lt(load64(_hh_V + 24), 0), 1,
  "eigen_qr 2^-42: and its SIGN is negative, which the shipped tree got wrong");
assert_eq(is_ok(_hh_eig(200, _hh_V)), 1, "eigen_qr 2^-200: reports success");
assert_eq(f64_approx_eq(f64_div(load64(_hh_V + 24), (1023 - 200) << 52),
    f64_neg(F64_ONE), ULP_TOL_H), 1,
  "eigen_qr 2^-200: still -c, 158 binades below the old cliff");
assert_eq(f64_lt(load64(_hh_V + 24), 0), 1,
  "eigen_qr 2^-200: and still negative");

# ⭐ AND THE NaN CONTRACT, WHICH IS WHAT DECIDES THE SHAPE OF THAT ZERO ARM. The
# test must be `f64_eq(|off|, 0)`, not the tempting `f64_gt(|off|, 0) == 0` —
# the latter is TRUE for NaN as well, so a NaN off-diagonal would be declared
# negligible and ZEROED. Measured with that form installed: a 2x2 whose entire
# off-diagonal is NaN comes back `rc = HSB_ERR_NONE` with **fabricated
# eigenvalues (3, 3)**, and a 3x3 with one NaN entry comes back `rc = 0` with a
# NaN sitting in the singular values. With `f64_eq` both report
# HSB_ERR_NO_CONVERGENCE, which is the honest answer.
# ⚠ This is the same trap the NaN arm of `_opt_wolfe_search` closes in src/optimize.cyr
# (`_opt_armijo` documented it until 3.4.1) and the
# same one that made 2.17.0's SVD figure wrong: **every f64 comparison involving
# NaN returns 0**, so the direction a guard is written in decides whether NaN
# falls through or is swallowed.
# [measured: NaN-input probe with both zero-arm forms, 2026-09-10]
var _NN_A = ganita_mat_new(2, 2);
ganita_mat_set(_NN_A, 0, 0, f64_from(3));
ganita_mat_set(_NN_A, 0, 1, 0x7FF8000000000000);
ganita_mat_set(_NN_A, 1, 0, 0x7FF8000000000000);
ganita_mat_set(_NN_A, 1, 1, f64_from(3));
var _NN_vals = alloc(16);
store64(_NN_vals, 0);
store64(_NN_vals + 8, 0);
var _NN_vecs = ganita_mat_new(2, 2);
var _nn_t, _nn_v = eigen_qr(_NN_A, 2, 200, _NN_vals, _NN_vecs);
assert_eq(is_ok(_nn_t), 0,
  "eigen_qr: an all-NaN off-diagonal is NOT deflated away and reported as success");

# ⚠ FOUR MUTANTS SURVIVE THIS BLOCK. Recorded with their reasons rather than
# tidied away, because a survivor is either an equivalence or a gap and the
# difference matters. [measured: 11-mutant run over linalg_precision.cyr]
# (On this tree the three of (a) and (b) are killed, each by the fixtures after (c) among
# others; (c) survives.)
#
# (a) NARROWING EITHER BULGE-CHASE TRIGGER from `< F64_TINY` to `== 0` survives,
#     and this one is a GENUINE GAP, not an equivalence. The subnormal band IS
#     reachable — a block at ratio c in [2^-537, 2^-511) puts the Givens sum
#     there — but the QR sweep is SELF-CORRECTING: a single rotation up to 13%
#     off is absorbed by later iterations and the eigenvalue still lands within
#     4 ulp, which is as tight as these assertions can go (bit-exactness fails on
#     3 of 999 ratios on CORRECT code, because the iteration is not bit-
#     reproducible across scales). Discriminating it would need the rotation
#     itself observed, and these are inline expressions, not helpers.
#     [measured: 11-mutant run over linalg_precision.cyr, 2026-09-10]
#     ⭐ 3.3.5 — BOTH ARE KILLED NOW, AND "SELF-CORRECTING" HELD ONLY FOR A 2x2 BLOCK.
#     3.3.4 killed the left trigger; the right one (audit D007) is killed by the 6x6
#     below: a unit 3x3 beside a 3x3 at ratio about 2^-536. A 2x2 small block has
#     one right rotation per sweep, the first, which is formed in the shift's scaled
#     space and never meets the band; a 3x3 block has a second, in balanced units,
#     whose sum of squares is subnormal. With the right trigger narrowed to `== 0`
#     its radius is the square root of a subnormal with a few bits, and the small
#     block's singular values come back 11%, 29% and 43% high with rc = OK; with it
#     they are 2, 1 and 3 ulp from a 1400-digit Decimal Jacobi oracle. Over 1,800 such
#     6x6 matrices (ratios 2^-500 to 2^-544) the narrowed trigger moves the values of
#     1,168, by up to 6.8e15 ulp; the 105,000 regenerated svd / eigen probe rows never
#     reach it.
#     [measured: block-ratio family + per-trigger variant builds + Decimal oracle, 2026-10-11; cycc 6.6.14]
#
# (b) REMOVING THE `+Inf` ARM survives. 2.17.0 called it an equivalence:
#     post-balancing every bidiagonal entry is bounded by ||A_bal||_F, so the sum
#     cannot overflow. It kept the arm anyway, for one compare, because
#     `_lp_pow2_floor` then SKIPPED balancing for an all-subnormal matrix.
#     ⚠ BOTH HALVES ARE STALE, AND THE ARM IS NOW LOAD-BEARING. 2.18.0 gave
#     `_lp_pow2_floor` its mantissa arm, so it no longer skips; and since 2.22.1
#     `_lp_balance_scale` scales a wide-span matrix UP until its smallest
#     non-zero entry is normal, so the largest entry can sit far above 1. With
#     the arm removed from both bulge-chase rotations in `_lp_bidiag_qr`, the 3x3
#     blockdiag(2^k*[[3,4],[2,3]], 5*2^-1074) is still right at k = 460 and from
#     k = 470 (sampled to 960) returns rc = OK with S[0] = +Inf — and that mutant
#     passes all five suites. So this survivor is a COVERAGE GAP, not an
#     equivalence; the fixture is roadmap [3.3.5], audit D004.
#     [measured: scratch harness, not reproducible in-tree, 2026-09-30; cycc 6.6.12]
#     ⭐ 3.3.5 — THE FIXTURE IS THE 4x4 BELOW, AND IT KILLS EACH ARM ALONE. On this
#     tree (3.3.3's non-finite checks, 3.3.4's retries) the overflow no longer comes
#     back as S[0] = +Inf: removing the arms makes that 3x3 family NO_CONVERGENCE from
#     k = 465, and only the LEFT arm matters there, because a 2x2 block's one right
#     rotation is formed in the shift's scaled space. A 3x3 block at 2^480,
#     blockdiag(2^480 M, 5u), full-mantissa M, has right rotations in balanced units
#     too: removing either arm alone turns it from answered into NO_CONVERGENCE (20 of
#     20 random M). The family 2^k [[3,4,1],[2,3,5],[1,2,7]] (+) 5u loses the right arm
#     from k = 461 and the left from k = 459, about 1535 binades of span. (Each arm's
#     removal also fails tests/abuse.tcyr's 3.3.4 "svd 5x5 across 1986 binades", so the
#     survivor had stopped surviving in 3.3.4; this note had not been told.)
#     [measured: per-arm variant builds (k = 300..1021, 20 random M) + mutant runs, 2026-10-11; cycc 6.6.14]
#
# (c) RESTORING THE `|delta| < EPSILON_F64` SIGN FORCING in the Wilkinson shift
#     survives, because the regime where the two signs differ materially needs an
#     `e2` so small that the deflation test — which is RELATIVE — has already
#     zeroed it. It is removed anyway, and the reason is a coupling worth stating:
#     the `denom == 0` guard is only sufficient because `|e2/denom| <= 1`, and
#     that holds only for the TRUE sign, where `denom = sign(delta)*(|delta| + h)`
#     cannot cancel. With the sign forced, `denom` can be far smaller than `e2`,
#     `e2/denom` can overflow, and the two-step product stops being bounded. The
#     guard and the sign are one change, not two.

test_group("3.3.5 linalg_precision: the bulge-chase triggers (D007) and +Inf arms (D004)");
# (a)'s right trigger: blockdiag(M, c N), M and N full-mantissa 3x3, c about 2^-536.
# Expected: this tree's bits; the oracle's are 0x40069B4AB61679B3, 0x3FF7BC9DD682B4A0,
# 0x3FE08191D5615F3E, 0x1E9054F419744283, 0x1E884A65F752DA8E, 0x1E45FDD6B142AA2A.
# [measured: block-ratio family row 792 + Decimal oracle, 2026-10-11; cycc 6.6.14]
var _d7_A = ganita_mat_new(6, 6);
for (var _d7_i = 0; _d7_i < 36; _d7_i = _d7_i + 1) { ganita_mat_set(_d7_A, _d7_i / 6, _d7_i % 6, 0); }
ganita_mat_set(_d7_A, 0, 0, 0x3FE4730E567F8388); ganita_mat_set(_d7_A, 0, 1, 0x3FD1CFB3E5D2A0A0);
ganita_mat_set(_d7_A, 0, 2, 0x3FC0EFD1C4EAD900); ganita_mat_set(_d7_A, 1, 0, 0xBFDC43900F8797D8);
ganita_mat_set(_d7_A, 1, 1, 0x3FFFFE261BFB1314); ganita_mat_set(_d7_A, 1, 2, 0x3FE235BF8369580C);
ganita_mat_set(_d7_A, 2, 0, 0x3FE9C29531E9ECA4); ganita_mat_set(_d7_A, 2, 1, 0x3FF0C057E329BA1A);
ganita_mat_set(_d7_A, 2, 2, 0x3FFEB9BD9C996C10);
ganita_mat_set(_d7_A, 3, 3, 0x9E8539696F6EC7CB); ganita_mat_set(_d7_A, 3, 4, 0x1E6487DA4603A24E);
ganita_mat_set(_d7_A, 3, 5, 0x1E753E155A515B1C); ganita_mat_set(_d7_A, 4, 3, 0x9E75A63175E020F9);
ganita_mat_set(_d7_A, 4, 4, 0x9E6183C0A1EF52ED); ganita_mat_set(_d7_A, 4, 5, 0x9E83FEBAB3E887A6);
ganita_mat_set(_d7_A, 5, 3, 0x9E7B179DA5E2A0A7); ganita_mat_set(_d7_A, 5, 4, 0x9E661E6FC8359239);
ganita_mat_set(_d7_A, 5, 5, 0x9E81DC440D54BD1C);
var _d7_S = alloc(6 * 8);
var _d7t, _d7v = svd_golub_kahan(_d7_A, ganita_mat_new(6, 6), _d7_S, ganita_mat_new(6, 6));
assert_eq(is_ok(_d7t), 1, "svd 6x6 unit 3x3 (+) 2^-536 3x3: answered");
assert_eq(load64(_d7_S), 0x40069B4AB61679B0, "svd 6x6 block ratio 2^-536: sigma_1 (3 ulp low)");
assert_eq(load64(_d7_S + 8), 0x3FF7BC9DD682B4A1, "svd 6x6 block ratio 2^-536: sigma_2 (1 ulp high)");
assert_eq(load64(_d7_S + 16), 0x3FE08191D5615F3C, "svd 6x6 block ratio 2^-536: sigma_3 (2 ulp low)");
# The small block's three, 1e-161 of sigma_1, sit below the normwise contract, so what is
# asserted is their relative accuracy, the property the trigger decides: each within 8 eps of
# the oracle's (this tree: 2, 1 and 3 ulp; the narrowed trigger: 11%, 29% and 43% high).
# [measured: block-ratio family row 792 + per-trigger variant builds + Decimal oracle, 2026-10-11; cycc 6.6.14]
var _d7_o = alloc(3 * 8);
store64(_d7_o, 0x1E9054F419744283); store64(_d7_o + 8, 0x1E884A65F752DA8E); store64(_d7_o + 16, 0x1E45FDD6B142AA2A);
for (var _d7_k = 0; _d7_k < 3; _d7_k = _d7_k + 1) {
    var _d7_ok = load64(_d7_o + _d7_k * 8);
    assert_eq(f64_le(f64_abs(f64_sub(load64(_d7_S + 24 + _d7_k * 8), _d7_ok)), f64_mul(_d7_ok, 0x3CE0000000000000)), 1,
      "svd 6x6 block ratio 2^-536: sigma_4..6 within 8 eps of the oracle (narrowed right trigger: 11-43% high)");
}
# (b)'s +Inf arms: blockdiag(2^480 M, 5u), M full-mantissa 3x3. Answered to 1.7 eps
# sigma_max (sigma 1.7, 0.9 and 7.0 ulp from the oracle's 0x5E2D952E32261F17,
# 0x5E07AB5B2D545DAF, 0x5DE07D0473E16839; 5u exactly); either arm removed: NO_CONVERGENCE.
# [measured: per-arm variant builds + Decimal oracle, 2026-10-11; cycc 6.6.14]
var _d4_A = ganita_mat_new(4, 4);
for (var _d4_i = 0; _d4_i < 16; _d4_i = _d4_i + 1) { ganita_mat_set(_d4_A, _d4_i / 4, _d4_i % 4, 0); }
ganita_mat_set(_d4_A, 0, 0, 0xDE10E4968D92D832); ganita_mat_set(_d4_A, 0, 1, 0xDE1965BA4A3AF2A2);
ganita_mat_set(_d4_A, 0, 2, 0xDDFA9BED50AD0738); ganita_mat_set(_d4_A, 1, 0, 0xDE1614EF2F477986);
ganita_mat_set(_d4_A, 1, 1, 0xDE1BBE3777D76A18); ganita_mat_set(_d4_A, 1, 2, 0xDDF93154CE6B4CD8);
ganita_mat_set(_d4_A, 2, 0, 0x5E1ABFC68250A43A); ganita_mat_set(_d4_A, 2, 1, 0x5E133A9C7FEB9222);
ganita_mat_set(_d4_A, 2, 2, 0x5E10F86C907884CE); ganita_mat_set(_d4_A, 3, 3, 5);
var _d4_S = alloc(4 * 8);
var _d4t, _d4v = svd_golub_kahan(_d4_A, ganita_mat_new(4, 4), _d4_S, ganita_mat_new(4, 4));
assert_eq(is_ok(_d4t), 1, "svd blockdiag(2^480 M, 5u): answered (either +Inf arm removed: NO_CONVERGENCE)");
assert_eq(load64(_d4_S), 0x5E2D952E32261F1A, "svd blockdiag(2^480 M, 5u): sigma_1");
assert_eq(load64(_d4_S + 8), 0x5E07AB5B2D545DB0, "svd blockdiag(2^480 M, 5u): sigma_2");
assert_eq(load64(_d4_S + 16), 0x5DE07D0473E16840, "svd blockdiag(2^480 M, 5u): sigma_3");
assert_eq(load64(_d4_S + 24), 5, "svd blockdiag(2^480 M, 5u): sigma_4 = 5u exactly");

# ================================================================
# 2.19.0 -- THE ERROR CODES' IDENTITY AND DISTINCTNESS
# ================================================================
# ⛔ WRITTEN BECAUSE TWO MUTANTS WOULD NOT DIE. 2.19.0 converted the twelve
# `HSB_ERR_*` codes from `var` globals to an enum, which meant re-typing twelve
# values by hand -- and a mutation sweep over the new block found the suite
# could not see a wrong one. `HSB_ERR_SINGULAR_MATRIX = -2 -> -22` SURVIVED all
# 3940 assertions, and so did `HSB_ERR_ALLOC = -11 -> -1`, which makes ALLOC
# **collide with HSB_ERR_INVALID_TRANSFORM** -- two distinct failures reported
# under one code, indistinguishable to any caller.
# ⭐ The reason is structural, not an oversight in any one test: every existing
# assertion compares a return against a code BY NAME, so both sides of the
# comparison move together and the value cancels out. A test that pins the value
# has to name the NUMBER, and distinctness has to be checked pairwise.
# [measured: 4-mutant sweep on src/error.cyr, 2 killed / 2 survived, 2026-09-10]

assert_eq(HSB_ERR_NONE, 0, "HSB_ERR_NONE is 0");
assert_eq(HSB_ERR_INVALID_TRANSFORM, 0 - 1, "HSB_ERR_INVALID_TRANSFORM is -1");
assert_eq(HSB_ERR_SINGULAR_MATRIX, 0 - 2, "HSB_ERR_SINGULAR_MATRIX is -2");
assert_eq(HSB_ERR_OUT_OF_RANGE, 0 - 3, "HSB_ERR_OUT_OF_RANGE is -3");
assert_eq(HSB_ERR_DIVISION_BY_ZERO, 0 - 4, "HSB_ERR_DIVISION_BY_ZERO is -4");
assert_eq(HSB_ERR_DEGENERATE, 0 - 5, "HSB_ERR_DEGENERATE is -5");
assert_eq(HSB_ERR_INVALID_INTERVAL, 0 - 6, "HSB_ERR_INVALID_INTERVAL is -6");
assert_eq(HSB_ERR_ZERO_STEPS, 0 - 7, "HSB_ERR_ZERO_STEPS is -7");
assert_eq(HSB_ERR_NO_CONVERGENCE, 0 - 8, "HSB_ERR_NO_CONVERGENCE is -8");
assert_eq(HSB_ERR_SINGULAR_PIVOT, 0 - 9, "HSB_ERR_SINGULAR_PIVOT is -9");
assert_eq(HSB_ERR_INVALID_INPUT, 0 - 10, "HSB_ERR_INVALID_INPUT is -10");
assert_eq(HSB_ERR_ALLOC, 0 - 11, "HSB_ERR_ALLOC is -11");

# Pairwise distinctness -- 66 pairs. ⚠ The identity block above already implies
# this, but it is asserted SEPARATELY and by a different mechanism: the identity
# assertions are twelve independent literals, so a future code added to the enum
# is covered by this loop the moment it is appended to the array, whether or not
# anyone remembers to write its literal.
var _ec_n = 12;
var _ec = alloc(_ec_n * 8);
store64(_ec + 0, HSB_ERR_NONE);
store64(_ec + 8, HSB_ERR_INVALID_TRANSFORM);
store64(_ec + 16, HSB_ERR_SINGULAR_MATRIX);
store64(_ec + 24, HSB_ERR_OUT_OF_RANGE);
store64(_ec + 32, HSB_ERR_DIVISION_BY_ZERO);
store64(_ec + 40, HSB_ERR_DEGENERATE);
store64(_ec + 48, HSB_ERR_INVALID_INTERVAL);
store64(_ec + 56, HSB_ERR_ZERO_STEPS);
store64(_ec + 64, HSB_ERR_NO_CONVERGENCE);
store64(_ec + 72, HSB_ERR_SINGULAR_PIVOT);
store64(_ec + 80, HSB_ERR_INVALID_INPUT);
store64(_ec + 88, HSB_ERR_ALLOC);

var _ec_dup = 0;
var _ec_pairs = 0;
var _ec_nonneg = 0;
for (var _eci = 0; _eci < _ec_n; _eci = _eci + 1) {
    var _ecvi = load64(_ec + _eci * 8);
    # Every failure code is NEGATIVE and success is the only non-negative value:
    # callers test `rc != HSB_ERR_NONE`, but several test `rc < 0`, so the sign
    # is load-bearing beyond the name.
    if (_eci > 0) {
        if (_ecvi >= 0) { _ec_nonneg = _ec_nonneg + 1; }
    }
    for (var _ecj = _eci + 1; _ecj < _ec_n; _ecj = _ecj + 1) {
        _ec_pairs = _ec_pairs + 1;
        if (_ecvi == load64(_ec + _ecj * 8)) { _ec_dup = _ec_dup + 1; }
    }
}
# ⚠ The pair COUNT is asserted too. A loop that silently ran zero times would
# report zero duplicates, which reads exactly like success.
assert_eq(_ec_pairs, 66, "error-code distinctness: all 66 pairs compared");
assert_eq(_ec_dup, 0, "error codes are pairwise distinct (no two share a value)");
assert_eq(_ec_nonneg, 0, "every failure code is negative; only HSB_ERR_NONE is not");

# === 3.4.0: num_bisection reports max_iter exhaustion ===
# Roadmap [3.4.0] D070. Through 3.3.7 the loop exit stored the midpoint and returned Ok
# whatever the bracket was: x^2 - 2 on [0, 2] at max_iter 5 returned Ok(1.40625) from a
# bracket 2^-4 wide, and max_iter 0 returned Ok(1.0) with no test at all. The exit now
# accepts the final bracket only if it is narrower than tol (the loop's own width test,
# which the last halving is not followed by) or its ends are adjacent doubles; otherwise
# Err(HSB_ERR_NO_CONVERGENCE) with `out` untouched. The boundary fixtures sit ON the width
# test: the bracket after 5 bisections is exactly 2^-4 wide, and |f| at the five midpoints
# (1, 1.5, 1.25, 1.375, 1.4375) never falls below 0.0664, so only the exit can accept.
# [measured: scratch probe2, this tree and the base tree, 2026-10-31; cycc 6.7.9]
test_group("3.4.0: num_bisection reports max_iter exhaustion");
fn _n4_x2m2(x) { return f64_sub(f64_mul(x, x), F64_TWO); }
fn _n4_2mx2(x) { return f64_sub(F64_TWO, f64_mul(x, x)); }
var _n4_out = alloc(8);
store64(_n4_out, 0x1234);
var _n4b1t, _n4b1v = num_bisection(&_n4_x2m2, 0, F64_TWO, 0x3FB0000000000000, 5, _n4_out);
assert_eq(is_err_result(_n4b1t), 1,
  "num_bisection: a 2^-4 bracket after max_iter 5 at tol 2^-4 is not converged (3.3.7: Ok)");
assert_eq(_n4b1v, HSB_ERR_NO_CONVERGENCE, "num_bisection: max_iter exhausted -> HSB_ERR_NO_CONVERGENCE");
assert_eq(load64(_n4_out), 0x1234, "num_bisection: an unconverged stop leaves out untouched (3.3.7: 1.40625)");
var _n4b2t, _n4b2v = num_bisection(&_n4_x2m2, 0, F64_TWO, 0x3FB0000000000001, 5, _n4_out);
assert_eq(is_ok(_n4b2t), 1, "num_bisection: the same bracket at tol 2^-4 + 1 ulp meets the width test at the exit");
assert_eq(load64(_n4_out), 0x3FF6800000000000, "num_bisection: ... and answers its midpoint, 1.40625");
store64(_n4_out, 0x1234);
var _n4b3t, _n4b3v = num_bisection(&_n4_x2m2, 0, F64_TWO, EPSILON_F64, 0, _n4_out);
assert_eq(_n4b3v, HSB_ERR_NO_CONVERGENCE,
  "num_bisection: max_iter 0 on a 2-wide bracket at tol 1e-12 -> Err (3.3.7: Ok(1.0))");
assert_eq(load64(_n4_out), 0x1234, "num_bisection: max_iter 0 leaves out untouched");
var _n4b4t, _n4b4v = num_bisection(&_n4_x2m2, 0, F64_TWO, 0x4010000000000000, 0, _n4_out);
assert_eq(load64(_n4_out), F64_ONE, "num_bisection: max_iter 0 at tol 4 accepts the 2-wide bracket's midpoint, 1");
# A tol below the spacing of the doubles at the root: the bracket stops at the two
# doubles either side of sqrt(2), 0x3FF6A09E667F3BCC and ...BCD, after 53 bisections,
# and no tol can ask for more. x^2 - 2 keeps lo = ...BCC below the root and the tie at
# the midpoint rounds to it; 2 - x^2 swaps the ends, so the same tie rounds to hi. One
# fixture for each half of the adjacency test.
store64(_n4_out, 0x1234);
var _n4b5t, _n4b5v = num_bisection(&_n4_x2m2, 0, F64_TWO, 1, 200, _n4_out);
assert_eq(is_ok(_n4b5t), 1, "num_bisection: tol 2^-1074 converges once the bracket's ends are adjacent doubles");
assert_eq(load64(_n4_out), 0x3FF6A09E667F3BCC,
  "num_bisection: x^2 - 2 at tol 2^-1074 -> 0x3FF6A09E667F3BCC (lo), as 3.3.7");
store64(_n4_out, 0x1234);
var _n4b6t, _n4b6v = num_bisection(&_n4_2mx2, 0, F64_TWO, 1, 200, _n4_out);
assert_eq(is_ok(_n4b6t), 1,
  "num_bisection: 2 - x^2 at tol 2^-1074 converges by adjacency, the midpoint rounding to hi");
assert_eq(load64(_n4_out), 0x3FF6A09E667F3BCC, "num_bisection: 2 - x^2 at tol 2^-1074 -> 0x3FF6A09E667F3BCC (hi)");
store64(_n4_out, 0x1234);
var _n4b7t, _n4b7v = num_bisection(&_n4_x2m2, 0, F64_TWO, 1, 52, _n4_out);
assert_eq(_n4b7v, HSB_ERR_NO_CONVERGENCE, "num_bisection: tol 2^-1074 and max_iter 52, one short of adjacency -> Err");
assert_eq(load64(_n4_out), 0x1234, "num_bisection: ... out untouched");
var _n4b8t, _n4b8v = num_bisection(&_n4_x2m2, 0, F64_TWO, 1, 53, _n4_out);
assert_eq(load64(_n4_out), 0x3FF6A09E667F3BCC,
  "num_bisection: tol 2^-1074 and max_iter 53, the first to reach adjacency");
# Brackets wider than DBL_MAX. 3.3.7 formed every midpoint as lo + (hi - lo) / 2, and hi - lo
# overflows: x - c on [-DBL_MAX, DBL_MAX] walked hi to +Inf and returned Ok(+Inf), a point
# outside [a, b], and an infinite end made the midpoint NaN (Err). Past DBL_MAX the midpoint
# is now the sum of the halves, an infinite end read as ±DBL_MAX. Every root below is exact
# (x - c is exactly 0 at c and nowhere else), and the narrow brackets above keep their bits.
# [measured: scratch bisection differential, 19,999 narrow brackets, bits as before, 2026-10-31]
# [measured: scratch bisection oracle, 4,000 wide and 544 infinite-end brackets, 2026-10-31]
fn _n4_xmc(x) { return f64_sub(x, 0x3FF3C0CA428C59FB); }
fn _n4_cmx(x) { return f64_sub(0x3FF3C0CA428C59FB, x); }
fn _n4_xmbig(x) { return f64_sub(x, 0xFFD5555555555555); }
fn _n4_xmsub(x) { return f64_sub(x, 0x000000000ABCDEF1); }
fn _n4_xmhuge(x) { return f64_sub(x, 0x7FE8F5C28F5C28F6); }
fn _n4_x2s(x) { return f64_sub(f64_mul(x, f64_abs(x)), F64_TWO); }
var _n4_nmax = 0xFFEFFFFFFFFFFFFF;
var _n4_pmax = 0x7FEFFFFFFFFFFFFF;
var _n4_c = 0x3FF3C0CA428C59FB;
store64(_n4_out, 0x1234);
var _n4w1t, _n4w1v = num_bisection(&_n4_xmc, _n4_nmax, _n4_pmax, 1, 1075, _n4_out);
assert_eq(is_ok(_n4w1t), 1, "num_bisection: x - c on [-DBL_MAX, DBL_MAX] converges (3.3.7: Ok(+Inf))");
assert_eq(load64(_n4_out), _n4_c, "num_bisection: x - c on [-DBL_MAX, DBL_MAX] -> c exactly, in 1075 bisections");
store64(_n4_out, 0x1234);
var _n4w2t, _n4w2v = num_bisection(&_n4_xmc, _n4_nmax, _n4_pmax, 1, 1074, _n4_out);
assert_eq(_n4w2v, HSB_ERR_NO_CONVERGENCE, "num_bisection: ... and 1074 are one too few -> Err");
assert_eq(load64(_n4_out), 0x1234, "num_bisection: ... out untouched");
var _n4w3t, _n4w3v = num_bisection(&_n4_cmx, _n4_nmax, _n4_pmax, 1, 1100, _n4_out);
assert_eq(load64(_n4_out), _n4_c, "num_bisection: c - x, the ends swapped and hi - lo = -Inf -> c (3.3.7: -Inf)");
var _n4w4t, _n4w4v = num_bisection(&_n4_xmc, _n4_pmax, _n4_nmax, 1, 1100, _n4_out);
assert_eq(load64(_n4_out), _n4_c, "num_bisection: x - c on [DBL_MAX, -DBL_MAX], a > b -> c (3.3.7: +Inf)");
var _n4w5t, _n4w5v = num_bisection(&_n4_xmbig, 0xFFE8000000000000, 0x7FE3333333333333, 1, 1100, _n4_out);
assert_eq(load64(_n4_out), 0xFFD5555555555555,
  "num_bisection: a mixed-sign wide bracket, root -2^1022 * 4/3 -> exact (3.3.7: +Inf)");
var _n4w6t, _n4w6v = num_bisection(&_n4_xmsub, _n4_nmax, _n4_pmax, 1, 2200, _n4_out);
assert_eq(load64(_n4_out), 0x000000000ABCDEF1, "num_bisection: a subnormal root from [-DBL_MAX, DBL_MAX] -> exact");
var _n4w7t, _n4w7v = num_bisection(&_n4_x2s, _n4_nmax, _n4_pmax, 1, 1100, _n4_out);
assert_eq(load64(_n4_out), 0x3FF6A09E667F3BCC,
  "num_bisection: x|x| - 2 on [-DBL_MAX, DBL_MAX] stops at the doubles beside sqrt(2), as [0, 2] does");
var _n4w8t, _n4w8v = num_bisection(&_n4_xmhuge, 0x7FE0000000000000, _n4_pmax, 1, 100, _n4_out);
assert_eq(load64(_n4_out), 0x7FE8F5C28F5C28F6,
  "num_bisection: [2^1023, DBL_MAX], where a + b overflows and b - a does not -> exact, as 3.3.7");
# Infinite ends: read as ±DBL_MAX for the midpoint (3.3.7: a NaN midpoint, refused).
store64(_n4_out, 0x1234);
var _n4w9t, _n4w9v = num_bisection(&_n4_xmc, 0xFFF0000000000000, 0x7FF0000000000000, 1, 1100, _n4_out);
assert_eq(is_ok(_n4w9t), 1, "num_bisection: x - c on [-Inf, +Inf] converges (3.3.7: Err)");
assert_eq(load64(_n4_out), _n4_c, "num_bisection: x - c on [-Inf, +Inf] -> c exactly");
var _n4w10t, _n4w10v = num_bisection(&_n4_xmc, 0xFFF0000000000000, 0x4010000000000000, 1, 1100, _n4_out);
assert_eq(load64(_n4_out), _n4_c, "num_bisection: x - c on [-Inf, 4] -> c exactly (3.3.7: Err)");
var _n4w13t, _n4w13v = num_bisection(&_n4_cmx, 0xFFF0000000000000, 0x7FF0000000000000, 1, 1100, _n4_out);
assert_eq(load64(_n4_out), _n4_c, "num_bisection: c - x on [-Inf, +Inf], lo = +Inf and hi = -Inf -> c (3.3.7: Err)");
# A sign change between -DBL_MAX and -Inf: the halves of -DBL_MAX and its neighbour round onto
# the neighbour, so the one double between the ends, -DBL_MAX, has to be offered itself;
# then [-Inf, -DBL_MAX] are adjacent and -DBL_MAX is the answer (3.3.7: NaN). Mirrored at +Inf.
fn _n4_stepn(x) {
    if (f64_lt(x, 0xFFEFFFFFFFFFFFFF) == 1) { return f64_neg(F64_ONE); }
    return F64_ONE;
}
fn _n4_stepp(x) {
    if (f64_lt(x, 0x7FF0000000000000) == 1) { return f64_neg(F64_ONE); }
    return F64_ONE;
}
var _n4w11t, _n4w11v = num_bisection(&_n4_stepn, 0xFFF0000000000000, 0, 1, 100, _n4_out);
assert_eq(load64(_n4_out), _n4_nmax, "num_bisection: a step between -Inf and -DBL_MAX -> -DBL_MAX (3.3.7: NaN)");
var _n4w12t, _n4w12v = num_bisection(&_n4_stepp, 0, 0x7FF0000000000000, 1, 100, _n4_out);
assert_eq(load64(_n4_out), _n4_pmax, "num_bisection: a step between DBL_MAX and +Inf -> DBL_MAX (3.3.7: +Inf)");
# Adjacency is read with f64_eq, so a -0 end is the double +0: [-0, 2^-1074] around a sign
# step at 0 holds no double strictly inside, and the midpoint computes as +0. Bit equality
# would read it as split by nothing and refuse it.
fn _n4_step(x) {
    if (f64_gt(x, 0) == 1) { return F64_ONE; }
    return f64_neg(F64_ONE);
}
store64(_n4_out, 0x1234);
var _n4b10t, _n4b10v = num_bisection(&_n4_step, 0x8000000000000000, 1, 0, 0, _n4_out);
assert_eq(is_ok(_n4b10t), 1, "num_bisection: [-0, 2^-1074] at max_iter 0 is adjacent, -0 read as 0");
assert_eq(load64(_n4_out), 0, "num_bisection: ... its midpoint, +0");
# A NaN end is no bracket, whatever f returns there. This step answers +1 at NaN (the
# comparison is false), so the refusal of a NaN f(a) or f(b) never fired: [NaN, 0] returned
# Ok(NaN) at tol 2, where |f(NaN)| = 1 < tol, and kept bisecting at tol 1e-12. Both ends,
# both tol regimes, and a negative NaN with a payload: Err(INVALID_INPUT), out untouched.
fn _n4_stepc(x) {
    if (f64_lt(x, 0x3FF3C0CA428C59FB) == 1) { return f64_neg(F64_ONE); }
    return F64_ONE;
}
store64(_n4_out, 0x1234);
var _n4n1t, _n4n1v = num_bisection(&_n4_stepc, 0x7FF8000000000000, 0, F64_TWO, 200, _n4_out);
assert_eq(_n4n1v, HSB_ERR_INVALID_INPUT, "num_bisection: a = NaN, tol 2 -> INVALID_INPUT (3.3.7: Ok(NaN))");
var _n4n2t, _n4n2v = num_bisection(&_n4_stepc, 0x7FF8000000000000, 0, EPSILON_F64, 200, _n4_out);
assert_eq(_n4n2v, HSB_ERR_INVALID_INPUT, "num_bisection: a = NaN, tol 1e-12 -> INVALID_INPUT (3.3.7: Ok(NaN))");
var _n4n3t, _n4n3v = num_bisection(&_n4_stepc, 0, 0x7FF8000000000000, F64_TWO, 200, _n4_out);
assert_eq(_n4n3v, HSB_ERR_INVALID_INPUT, "num_bisection: b = NaN, tol 2 -> INVALID_INPUT (3.3.7: Ok(NaN))");
var _n4n4t, _n4n4v = num_bisection(&_n4_stepc, 0, 0x7FF8000000000000, EPSILON_F64, 200, _n4_out);
assert_eq(_n4n4v, HSB_ERR_INVALID_INPUT, "num_bisection: b = NaN, tol 1e-12 -> INVALID_INPUT (3.3.7: Ok(NaN))");
var _n4n5t, _n4n5v = num_bisection(&_n4_stepc, 0xFFF8000000000123, 0x4010000000000000, F64_TWO, 0, _n4_out);
assert_eq(_n4n5v, HSB_ERR_INVALID_INPUT, "num_bisection: a = -NaN with a payload, max_iter 0 -> INVALID_INPUT");
assert_eq(load64(_n4_out), 0x1234, "num_bisection: every NaN-end refusal leaves out untouched");
# An exact zero f(mid) = 0 is the root at every tol, tol <= 0 and NaN included (R2A note 6).
# 3.3.7 and the first 3.4.0 drafts read it only through |f| < tol, which is false for 0 at
# tol 0, -1 or NaN: x - 1 on [0, 2] at max_iter 1 evaluated f(1) = 0 and returned
# Err(NO_CONVERGENCE); x - c on [-Inf, +Inf] at tol 0 evaluated f(c) = 0 and returned
# Ok(c - 1 ulp) after 3002 calls. -(x - 1) gives f(1) = -0, the same zero.
# [measured: scratch bisz probe, integ-snap9 and this tree, 2026-10-31]
fn _n4_xm1(x) { return f64_sub(x, F64_ONE); }
fn _n4_nxm1(x) { return f64_mul(f64_sub(x, F64_ONE), f64_neg(F64_ONE)); }
store64(_n4_out, 0x1234);
var _n4z1t, _n4z1v = num_bisection(&_n4_xm1, 0, F64_TWO, 0, 1, _n4_out);
assert_eq(is_ok(_n4z1t), 1, "num_bisection: f(1) = 0 at tol 0, max_iter 1 is the root (before: Err)");
assert_eq(load64(_n4_out), F64_ONE, "num_bisection: ... exactly 1");
store64(_n4_out, 0x1234);
var _n4z2t, _n4z2v = num_bisection(&_n4_nxm1, 0, F64_TWO, 0, 1, _n4_out);
assert_eq(load64(_n4_out), F64_ONE, "num_bisection: f(1) = -0 at tol 0 is the same root, 1");
store64(_n4_out, 0x1234);
var _n4z3t, _n4z3v = num_bisection(&_n4_xm1, 0, F64_TWO, 0x7FF8000000000000, 1, _n4_out);
assert_eq(load64(_n4_out), F64_ONE, "num_bisection: f(1) = 0 at tol NaN is the root, 1 (before: Err)");
store64(_n4_out, 0x1234);
var _n4z4t, _n4z4v = num_bisection(&_n4_xm1, 0, F64_TWO, f64_neg(F64_ONE), 1, _n4_out);
assert_eq(load64(_n4_out), F64_ONE, "num_bisection: f(1) = 0 at tol -1 is the root, 1 (before: Err)");
var _n4z5t, _n4z5v = num_bisection(&_n4_xmc, 0xFFF0000000000000, 0x7FF0000000000000, 0, 3000, _n4_out);
assert_eq(load64(_n4_out), _n4_c, "num_bisection: x - c on [-Inf, +Inf] at tol 0 -> c exactly (before: c - 1 ulp)");
# Only an exact zero: f(1) = 2^-1074, the smallest non-zero, is no root at tol 0.
fn _n4_tiny1(x) {
    if (f64_lt(x, F64_ONE) == 1) { return f64_neg(F64_ONE); }
    if (f64_eq(x, F64_ONE) == 1) { return 1; }
    return F64_ONE;
}
store64(_n4_out, 0x1234);
var _n4z6t, _n4z6v = num_bisection(&_n4_tiny1, 0, F64_TWO, 0, 1, _n4_out);
assert_eq(_n4z6v, HSB_ERR_NO_CONVERGENCE, "num_bisection: f(1) = 2^-1074 at tol 0 is not accepted -> Err");
assert_eq(load64(_n4_out), 0x1234, "num_bisection: ... out untouched");

# === 3.4.0: num_pollard_rho_checked refuses n <= 1 ===
# Roadmap [3.4.0] D069. num_pollard_rho returned n for every n <= 1, and n is the answer
# that means "prime": 1, 0, -15 and i64 min came back as their own prime factor. The
# replacement refuses them with Err(HSB_ERR_INVALID_INPUT). On n > 1 its answers are the
# retired function's: a scratch oracle (python3, deterministic Miller-Rabin and trial
# division) checked 204,814 n up to 2^63 - 1 against both trees.
# [measured: scratch rho oracle, 204,814 n, base tree and this tree, 2026-10-31]
test_group("3.4.0: num_pollard_rho_checked refuses n <= 1");
var _n4r1t, _n4r1v = num_pollard_rho_checked(1);
assert_eq(is_err_result(_n4r1t), 1, "num_pollard_rho_checked(1) is an Err: 1 has no prime factor (3.3.7: 1)");
assert_eq(_n4r1v, HSB_ERR_INVALID_INPUT, "num_pollard_rho_checked(1) -> HSB_ERR_INVALID_INPUT");
var _n4r2t, _n4r2v = num_pollard_rho_checked(0x8000000000000000);
assert_eq(_n4r2v, HSB_ERR_INVALID_INPUT, "num_pollard_rho_checked(i64 min) -> INVALID_INPUT (3.3.7: i64 min)");
var _n4r3t, _n4r3v = num_pollard_rho_checked(0 - 15);
assert_eq(_n4r3v, HSB_ERR_INVALID_INPUT, "num_pollard_rho_checked(-15) -> INVALID_INPUT (3.3.7: -15)");
var _n4r4t, _n4r4v = num_pollard_rho_checked(2);
assert_eq(is_ok(_n4r4t), 1, "num_pollard_rho_checked(2) is Ok");
assert_eq(_n4r4v, 2, "num_pollard_rho_checked(2) = 2, the smallest prime and the domain's first n");
var _n4r5t, _n4r5v = num_pollard_rho_checked(3);
assert_eq(_n4r5v, 3, "num_pollard_rho_checked(3) = 3, the smallest odd prime");
var _n4r6t, _n4r6v = num_pollard_rho_checked(9);
assert_eq(_n4r6v, 3, "num_pollard_rho_checked(9) = 3, the smallest odd prime square");
var _n4r7t, _n4r7v = num_pollard_rho_checked(0x7FFFFFFFFFFFFFE7);
assert_eq(_n4r7v, 0x7FFFFFFFFFFFFFE7, "num_pollard_rho_checked(2^63 - 25) = itself, the largest prime below 2^63");
var _n4r8t, _n4r8v = num_pollard_rho_checked(1099505336329);
assert_eq(_n4r8v, 1048573, "num_pollard_rho_checked(1048573^2) = 1048573, a prime square");
var _n4r9t, _n4r9v = num_pollard_rho_checked(0x7FFFFFFFFFFFFFFF);
assert_eq(_n4r9v, 7, "num_pollard_rho_checked(2^63 - 1) = 7 (2^63 - 1 = 7^2 * 73 * 127 * 337 * 92737 * 649657)");
var _n4r10t, _n4r10v = num_pollard_rho_checked(3825123056546413051);
assert_eq(_n4r10v, 149491, "num_pollard_rho_checked: a Carmichael number near 2^62 -> 149491, a proper factor");

# === 3.4.0: f64_fmod(x, ±0) is NaN, the rest stays exact ===
# Roadmap [3.4.0] D069. Through 3.3.7 a zero divisor returned +0 for every x, NaN and
# ±Inf included; C99 and IEEE 754 make it an invalid operation. Expected bits are glibc
# 2.44's fmod: x's NaN quieted when x is one, else the default NaN 0xFFF8000000000000.
# The smallest subnormal divisor stays an ordinary one (an exact multiple, and a non-zero
# remainder), so `hy == 0` reads only a zero. The scratch differential (18,400 pairs, an
# exact rational oracle and glibc) found every other result unchanged.
# [measured: scratch differential, python3 Fraction oracle and glibc 2.44, 18,400 pairs, 2026-10-31]
test_group("3.4.0: f64_fmod(x, ±0) is NaN, the rest stays exact");
assert_eq(f64_fmod(0x401C000000000000, 0), 0xFFF8000000000000, "fmod(7, +0) = the default NaN (3.3.7: +0)");
assert_eq(f64_fmod(0xC01C000000000000, 0x8000000000000000), 0xFFF8000000000000, "fmod(-7, -0) = the default NaN");
assert_eq(f64_fmod(0, 0), 0xFFF8000000000000, "fmod(+0, +0) = the default NaN (3.3.7: +0)");
assert_eq(f64_fmod(0x8000000000000000, 0x8000000000000000), 0xFFF8000000000000, "fmod(-0, -0) = the default NaN");
assert_eq(f64_fmod(1, 0), 0xFFF8000000000000, "fmod(2^-1074, +0) = the default NaN");
assert_eq(f64_fmod(0x7FEFFFFFFFFFFFFF, 0x8000000000000000), 0xFFF8000000000000, "fmod(DBL_MAX, -0) = the default NaN");
assert_eq(f64_fmod(0xFFF0000000000000, 0), 0xFFF8000000000000, "fmod(-Inf, +0) = the default NaN (3.3.7: +0)");
assert_eq(f64_fmod(0x7FF0000000000000, 0x8000000000000000), 0xFFF8000000000000,
  "fmod(+Inf, -0) = the default NaN, not +Inf's bits quieted (3.3.7: +0)");
assert_eq(f64_fmod(0x7FF8000000000005, 0x8000000000000000), 0x7FF8000000000005, "fmod(qNaN, -0) = x's NaN (3.3.7: +0)");
assert_eq(f64_fmod(0xFFF4000000000123, 0), 0xFFFC000000000123,
  "fmod(-sNaN, +0) = x's NaN, quieted, sign and payload kept");
assert_eq(f64_fmod(0x7FEFFFFFFFFFFFFF, 1), 0,
  "fmod(DBL_MAX, 2^-1074) = +0: the smallest subnormal is an ordinary divisor");
assert_eq(f64_fmod(0x8000000000000003, 2), 0x8000000000000001,
  "fmod(-3 * 2^-1074, 2 * 2^-1074) = -2^-1074, x's sign");

# === 3.4.0: expr_eval_checked refuses a tree with no value ===
# Roadmap [3.4.0] D074. expr_eval returned +0.0 and wrote a warning to fd 2 for an
# unbound variable or an unknown tag: x + 1 with x unbound evaluated to 1.0. Its
# replacement returns Err(HSB_ERR_INVALID_INPUT) and writes nothing (abuse.tcyr pins the
# silence on both fds). expr_diff differentiated a tag it could not read to the constant
# 0, so x + <tag 77> came back as (1 + 0); it returns 0, the failure handle, and the
# constructors carry a 0 child to the root.
# [measured: scratch symbase probe, base tree, 2026-10-31: 0x3FF0000000000000 and "(1 + 0)"]
test_group("3.4.0: expr_eval_checked refuses a tree with no value");
var _n4_x = expr_var(str_from("x"));
var _n4_y = expr_var(str_from("y"));
var _n4_none = vec_new();
var _n4e1t, _n4e1v = expr_eval_checked(expr_add(_n4_x, expr_const(F64_ONE)), _n4_none);
assert_eq(is_err_result(_n4e1t), 1, "expr_eval_checked: x + 1 with x unbound is an Err (3.3.7 expr_eval: 1.0)");
assert_eq(_n4e1v, HSB_ERR_INVALID_INPUT, "expr_eval_checked: an unbound variable -> HSB_ERR_INVALID_INPUT");
var _n4e2t, _n4e2v = expr_eval_checked(_n4_x, 0);
assert_eq(_n4e2v, HSB_ERR_INVALID_INPUT,
  "expr_eval_checked: a variable with vars = 0 -> INVALID_INPUT (3.3.7: a read through 0)");
var _n4_bad = alloc(16);
store64(_n4_bad, 77);
var _n4e3t, _n4e3v = expr_eval_checked(_n4_bad, _n4_none);
assert_eq(_n4e3v, HSB_ERR_INVALID_INPUT, "expr_eval_checked: a tag no constructor writes -> INVALID_INPUT (3.3.7: 0)");
var _n4e4t, _n4e4v = expr_eval_checked(0, _n4_none);
assert_eq(_n4e4v, HSB_ERR_INVALID_INPUT, "expr_eval_checked: a 0 node, the failure handle -> INVALID_INPUT");
# A bound tree: sin(x) * exp(y) + x^y at full-mantissa x, y, against the same operations
# composed by hand (a second code path).
var _n4_xv = 0x3FF3C0CA428C59FB;
var _n4_yv = 0x3FE5D1D8A3B2C6F1;
var _n4_binds = vec_new();
vec_push(_n4_binds, 0);
vec_push(_n4_binds, expr_bind(str_from("y"), _n4_yv));
vec_push(_n4_binds, expr_bind(str_from("x"), _n4_xv));
var _n4_tree = expr_add(expr_mul(expr_sin(_n4_x), expr_exp(_n4_y)), expr_pow(_n4_x, _n4_y));
var _n4e5t, _n4e5v = expr_eval_checked(_n4_tree, _n4_binds);
assert_eq(is_ok(_n4e5t), 1, "expr_eval_checked: a bound tree is Ok, past a 0 pair in vars");
assert_eq(_n4e5v, f64_add(f64_mul(f64_sin(_n4_xv), f64_exp(_n4_yv)), ganita_f64_pow(_n4_xv, _n4_yv)),
  "expr_eval_checked: sin(x) exp(y) + x^y = the same operations composed by hand, bit for bit");
var _n4e6t, _n4e6v = expr_eval_checked(expr_neg(expr_ln(expr_cos(_n4_y))), _n4_binds);
assert_eq(_n4e6v, f64_neg(f64_ln(f64_cos(_n4_yv))), "expr_eval_checked: -ln(cos(y)), bit for bit");
var _n4e7t, _n4e7v = expr_eval_checked(expr_mul(_n4_tree, expr_var(str_from("z"))), _n4_binds);
assert_eq(_n4e7v, HSB_ERR_INVALID_INPUT, "expr_eval_checked: one unbound leaf deep in a tree refuses the whole tree");
# expr_diff: a tag it cannot read has no derivative.
assert_eq(expr_diff(_n4_bad, str_from("x")), 0, "expr_diff: a tag no constructor writes -> 0 (3.3.7: the constant 0)");
assert_eq(expr_diff(expr_add(_n4_x, _n4_bad), str_from("x")), 0, "expr_diff: x + <tag 77> -> 0 (3.3.7: (1 + 0))");
assert_eq(expr_diff(0, str_from("x")), 0, "expr_diff: a 0 node -> 0");
assert_eq(expr_simplify(0), 0, "expr_simplify: a 0 node -> 0");
# The constructors carry a 0 child up, from either side.
assert_eq(expr_add(0, _n4_x), 0, "expr_add: a 0 left child -> 0");
assert_eq(expr_add(_n4_x, 0), 0, "expr_add: a 0 right child -> 0");
assert_eq(expr_mul(0, _n4_x), 0, "expr_mul: a 0 left child -> 0");
assert_eq(expr_mul(_n4_x, 0), 0, "expr_mul: a 0 right child -> 0");
assert_eq(expr_pow(0, _n4_x), 0, "expr_pow: a 0 base -> 0");
assert_eq(expr_pow(_n4_x, 0), 0, "expr_pow: a 0 exponent -> 0");
assert_eq(expr_neg(0), 0, "expr_neg: a 0 child -> 0");
assert_eq(expr_sin(0), 0, "expr_sin: a 0 child -> 0");
assert_eq(expr_cos(0), 0, "expr_cos: a 0 child -> 0");
assert_eq(expr_exp(0), 0, "expr_exp: a 0 child -> 0");
assert_eq(expr_ln(0), 0, "expr_ln: a 0 child -> 0");
assert_eq(expr_var(0), 0, "expr_var: a 0 name -> 0");

# === 3.4.0: dual and tape ln / sqrt / abs propagate a NaN ===
# Roadmap [3.4.0] D069. A NaN input to dual_ln, dual_sqrt, ad_ln and ad_sqrt returned
# the (0, 0) domain-miss sentinel, a finite value and derivative from no number at all;
# dual_abs and ad_abs gave a NaN the derivative +1, as if it were positive. A NaN now
# propagates through all six: value and derivative NaN, the input's payload kept (0x...5
# below) and a signalling NaN quieted. The domain misses (v <= 0, -0 and -Inf included)
# keep the documented sentinel, and forward and reverse mode still agree bit for bit.
# [measured: scratch probe1 (base tree) and probe2 (this tree), 2026-10-31]
test_group("3.4.0: dual and tape ln / sqrt / abs propagate a NaN");
var _n4_qn = 0x7FF8000000000005;
var _n4d1 = dual_ln(dual_new(_n4_qn, F64_ONE));
assert_eq(Dual_val(_n4d1), _n4_qn, "dual_ln(NaN): the value is the NaN (3.3.7: 0)");
assert_eq(Dual_deriv(_n4d1), _n4_qn, "dual_ln(NaN): the derivative is the NaN (3.3.7: 0)");
var _n4d2 = dual_sqrt(dual_new(_n4_qn, F64_ONE));
assert_eq(Dual_val(_n4d2), _n4_qn, "dual_sqrt(NaN): the value is the NaN (3.3.7: 0)");
assert_eq(Dual_deriv(_n4d2), _n4_qn, "dual_sqrt(NaN): the derivative is the NaN (3.3.7: 0)");
var _n4d3 = dual_ln(dual_new(0x7FF0000000000001, F64_ONE));
assert_eq(Dual_val(_n4d3), 0x7FF8000000000001, "dual_ln(sNaN): the value is the NaN, quieted");
assert_eq(Dual_deriv(_n4d3), 0x7FF8000000000001, "dual_ln(sNaN): the derivative is the NaN, quieted");
# |x| clears the sign bit (IEEE 754 abs, and f64_abs): |-NaN| is the NaN with the sign
# cleared, payload kept, and |-0| is +0. Through 3.3.7 both kept the input's sign.
var _n4d4 = dual_abs(dual_new(0xFFF8000000000005, F64_ONE));
assert_eq(Dual_val(_n4d4), 0x7FF8000000000005,
  "dual_abs(-NaN): the value is |NaN|, sign cleared (3.3.7: the input's bits)");
assert_eq(Dual_deriv(_n4d4), 0xFFF8000000000005, "dual_abs(-NaN): the derivative is the NaN (3.3.7: +1)");
var _n4d5 = dual_abs(dual_new(0x7FF8000000000005, 0xC000000000000000));
assert_eq(Dual_deriv(_n4d5), _n4_qn, "dual_abs(NaN, -2): the derivative is the NaN (3.3.7: -2)");
# The documented domain misses keep the sentinel value; a moving one has the NaN tangent (3.4.1
# SYM4): ln(-0) is a pole, sqrt(-Inf) has no value and sqrt at +0 an unbounded right slope.
var _n4d6 = dual_ln(dual_new(0x8000000000000000, F64_ONE));
assert_eq(Dual_val(_n4d6), 0, "dual_ln(-0): the miss's value 0, unchanged");
assert_eq(Dual_deriv(_n4d6), _AD_NAN, "dual_ln(-0): a moving miss, a NaN tangent");
var _n4d7 = dual_sqrt(dual_new(0xFFF0000000000000, F64_ONE));
assert_eq(Dual_val(_n4d7), 0, "dual_sqrt(-Inf): the miss's value 0, unchanged");
assert_eq(Dual_deriv(_n4d7), _AD_NAN, "dual_sqrt(-Inf): a moving miss, a NaN tangent");
var _n4d8 = dual_sqrt(dual_new(0, F64_ONE));
assert_eq(Dual_val(_n4d8), 0, "dual_sqrt(+0): the miss's value 0, unchanged");
assert_eq(Dual_deriv(_n4d8), _AD_NAN, "dual_sqrt(+0): a moving miss, a NaN tangent");
# Reverse mode, one tape: the same NaN through ad_ln, ad_sqrt and ad_abs.
var _n4_tp = ad_tape_new(16);
var _n4_xa = ad_var(_n4_tp, _n4_qn);
var _n4_la = ad_ln(_n4_tp, _n4_xa);
assert_eq(ad_val(_n4_tp, _n4_la), _n4_qn, "ad_ln(NaN): the value is the NaN (3.3.7: 0)");
var _n4g1t, _n4g1v = ad_grad(_n4_tp, _n4_la);
assert_eq(ad_grad_of(_n4_tp, _n4_xa), _n4_qn, "ad_ln(NaN): the adjoint is the NaN (3.3.7: 0)");
var _n4_sa = ad_sqrt(_n4_tp, _n4_xa);
assert_eq(ad_val(_n4_tp, _n4_sa), _n4_qn, "ad_sqrt(NaN): the value is the NaN (3.3.7: 0)");
var _n4g2t, _n4g2v = ad_grad(_n4_tp, _n4_sa);
assert_eq(ad_grad_of(_n4_tp, _n4_xa), _n4_qn, "ad_sqrt(NaN): the adjoint is the NaN (3.3.7: 0)");
var _n4_xb = ad_var(_n4_tp, 0xFFF8000000000005);
var _n4_aa = ad_abs(_n4_tp, _n4_xb);
assert_eq(ad_val(_n4_tp, _n4_aa), 0x7FF8000000000005,
  "ad_abs(-NaN): the value is |NaN|, sign cleared (3.3.7: the input's bits)");
var _n4g3t, _n4g3v = ad_grad(_n4_tp, _n4_aa);
assert_eq(ad_grad_of(_n4_tp, _n4_xb), 0xFFF8000000000005, "ad_abs(-NaN): the adjoint is the NaN (3.3.7: +1)");
assert_eq(ad_grad_of(_n4_tp, _n4_xb), Dual_deriv(_n4d4), "ad_abs and dual_abs agree on a NaN, bit for bit");
assert_eq(ad_val(_n4_tp, _n4_aa), Dual_val(_n4d4), "ad_abs and dual_abs agree on |NaN|, bit for bit");
var _n4d9 = dual_abs(dual_new(0x8000000000000000, F64_ONE));
assert_eq(Dual_val(_n4d9), 0, "dual_abs(-0): the value is +0 (3.3.7: -0)");
assert_eq(Dual_deriv(_n4d9), F64_ONE, "dual_abs(-0): the derivative is the documented right-hand +a'");
var _n4_tq = ad_tape_new(32);
var _n4_xz = ad_var(_n4_tq, 0x8000000000000000);
var _n4_az = ad_abs(_n4_tq, _n4_xz);
var _n4g6t, _n4g6v = ad_grad(_n4_tq, _n4_az);
assert_eq(ad_val(_n4_tq, _n4_az), 0, "ad_abs(-0): the value is +0 (3.3.7: -0)");
assert_eq(ad_grad_of(_n4_tq, _n4_xz), F64_ONE, "ad_abs(-0): the right-hand partial +1");
# One rule in both modes (autodiff.cyr, above dual_div). A domain miss with a NUMERIC
# value is the constant 0, whose derivative is exactly 0 whatever tangent arrives, a NaN
# one included: (0, 0) forward, partials 0 on the tape. A NaN VALUE is not a miss: NaN
# value and NaN derivative in both modes, quieted (quiet bit set, sign and payload kept).
# 3.3.7 answered a NaN numerator over |b| < DBL_MIN with the miss (0, 0).
var _n4v1 = dual_div(dual_new(_n4_qn, F64_ONE), dual_const(0));
assert_eq(Dual_val(_n4v1), _n4_qn, "dual_div(NaN, 0): the value is the NaN (3.3.7: 0)");
assert_eq(Dual_deriv(_n4v1), _n4_qn, "dual_div(NaN, 0): the derivative is the NaN (3.3.7: 0)");
var _n4v2 = dual_div(dual_new(0x7FF0000000000001, F64_ONE), dual_const(0));
assert_eq(Dual_val(_n4v2), 0x7FF8000000000001, "dual_div(sNaN, 0): the value is the NaN, quieted, payload kept");
assert_eq(Dual_deriv(_n4v2), 0x7FF8000000000001, "dual_div(sNaN, 0): the derivative is the same quieted NaN");
var _n4v3 = dual_div(dual_var(F64_TWO), dual_new(0, _n4_qn));
assert_eq(Dual_val(_n4v3), 0, "dual_div(2, (0, NaN')): a miss, the value 0");
assert_eq(Dual_deriv(_n4v3), _AD_NAN,
  "dual_div(2, (0, NaN')): 2/b at b = 0 is a pole, a moving miss's NaN (3.4.1 SYM4)");
var _n4v4 = dual_div(dual_new(F64_TWO, 0x7FF0000000000003), dual_new(1, F64_ONE));
assert_eq(Dual_deriv(_n4v4), _AD_NAN, "dual_div((2, sNaN'), 2^-1074): a moving miss, the NaN tangent (3.4.1 SYM4)");
var _n4v5 = dual_div(dual_var(F64_TWO), dual_new(0, 0x7FF0000000000007));
assert_eq(Dual_deriv(_n4v5), _AD_NAN, "dual_div(2, (0, sNaN')): a moving miss, the NaN tangent (3.4.1 SYM4)");
var _n4v6 = dual_div(dual_var(F64_TWO), dual_const(0));
assert_eq(Dual_val(_n4v6), 0, "dual_div(x, const 0): the miss's value 0, unchanged");
assert_eq(Dual_deriv(_n4v6), _AD_NAN, "dual_div(x, const 0): x / 0 has no value, a moving miss's NaN (3.4.1 SYM4)");
assert_eq(Dual_deriv(dual_div(dual_const(F64_TWO), dual_const(0))), 0,
  "dual_div(const 2, const 0): a miss on constants is still (0, +0)");
var _n4v7 = dual_ln(dual_new(0xBFF0000000000000, _n4_qn));
assert_eq(Dual_val(_n4v7), 0, "dual_ln((-1, NaN')): the miss value 0");
assert_eq(Dual_deriv(_n4v7), _AD_NAN, "dual_ln((-1, NaN')): a moving miss, the NaN tangent (3.4.1 SYM4)");
var _n4v8 = dual_sqrt(dual_new(0, _n4_qn));
assert_eq(Dual_deriv(_n4v8), _AD_NAN, "dual_sqrt((0, NaN')): a moving miss, the NaN tangent (3.4.1 SYM4)");
var _n4_ya = ad_var(_n4_tq, _n4_qn);
var _n4_yb = ad_var(_n4_tq, 0);
var _n4_yq = ad_div(_n4_tq, _n4_ya, _n4_yb);
var _n4g7t, _n4g7v = ad_grad(_n4_tq, _n4_yq);
assert_eq(ad_val(_n4_tq, _n4_yq), _n4_qn, "ad_div(NaN, 0): the value is the NaN (3.3.7: 0)");
assert_eq(ad_grad_of(_n4_tq, _n4_ya), _n4_qn, "ad_div(NaN, 0): d/da is the NaN (3.3.7: 0)");
assert_eq(ad_grad_of(_n4_tq, _n4_yb), _n4_qn, "ad_div(NaN, 0): d/db is the NaN (3.3.7: 0)");
assert_eq(ad_grad_of(_n4_tq, _n4_ya), Dual_deriv(_n4v1), "ad_div and dual_div agree on a NaN numerator, bit for bit");
var _n4_ys = ad_var(_n4_tq, 0x7FF0000000000001);
var _n4_ysq = ad_div(_n4_tq, _n4_ys, _n4_yb);
assert_eq(ad_val(_n4_tq, _n4_ysq), 0x7FF8000000000001, "ad_div(sNaN, 0): the value is the NaN, quieted");
var _n4_yc = ad_var(_n4_tq, F64_TWO);
var _n4_ycq = ad_div(_n4_tq, _n4_yc, _n4_yb);
var _n4g8t, _n4g8v = ad_grad(_n4_tq, _n4_ycq);
assert_eq(ad_val(_n4_tq, _n4_ycq), 0, "ad_div(2, 0): the miss's value 0, unchanged");
assert_eq(ad_grad_of(_n4_tq, _n4_yc), _AD_NAN,
  "ad_div(y, 0) with y moving: d/dy is NaN, y / 0 has no value (3.4.1 SYM4)");
assert_eq(ad_grad_of(_n4_tq, _n4_yb), _AD_NAN, "ad_div(y, b) at b = 0 with b moving: d/db is NaN, a pole (3.4.1 SYM4)");
# A NaN operand VALUE in ad_mul / ad_div: every partial is the NaN, as forward mode's a b'
# term (NaN * 0) makes its derivative. 3.3.7's tape answered the constant: x * 2 at x = NaN
# had gradient 2, x / 2 had 0.5, where dual_mul and dual_div answer NaN.
var _n4_tr = ad_tape_new(64);
var _n4_rx = ad_var(_n4_tr, _n4_qn);
var _n4_rm = ad_mul(_n4_tr, _n4_rx, ad_const(_n4_tr, F64_TWO));
var _n4g9t, _n4g9v = ad_grad(_n4_tr, _n4_rm);
assert_eq(ad_grad_of(_n4_tr, _n4_rx), _n4_qn, "ad_mul(NaN x, 2): d/dx is the NaN (3.3.7: 2)");
assert_eq(ad_grad_of(_n4_tr, _n4_rx), Dual_deriv(dual_mul(dual_new(_n4_qn, F64_ONE), dual_const(F64_TWO))),
  "ad_mul and dual_mul agree on a NaN operand value, bit for bit");
var _n4_rm2 = ad_mul(_n4_tr, ad_const(_n4_tr, F64_TWO), _n4_rx);
var _n4g10t, _n4g10v = ad_grad(_n4_tr, _n4_rm2);
assert_eq(ad_grad_of(_n4_tr, _n4_rx), _n4_qn, "ad_mul(2, NaN x): d/dx is the NaN, the second operand (3.3.7: 2)");
var _n4_rd = ad_div(_n4_tr, _n4_rx, ad_const(_n4_tr, F64_TWO));
var _n4g11t, _n4g11v = ad_grad(_n4_tr, _n4_rd);
assert_eq(ad_grad_of(_n4_tr, _n4_rx), _n4_qn, "ad_div(NaN x, 2): d/dx is the NaN (3.3.7: 0.5)");
assert_eq(ad_grad_of(_n4_tr, _n4_rx), Dual_deriv(dual_div(dual_new(_n4_qn, F64_ONE), dual_const(F64_TWO))),
  "ad_div and dual_div agree on a NaN numerator over 2, bit for bit");
# A NaN tangent reaching a miss, built the same way in both modes: v + (x^0.5 - x^0.5) at
# x = 0 has value v and derivative Inf - Inf = NaN (0.5 * 0^-0.5 = +Inf on each side). At
# v = -1.5, ln and sqrt are misses: forward (0, 0), and the tape records the miss as a
# constant, so x has no path to the root, 0. 3.4.0's first draft gave forward (0, NaN)
# here, disagreeing with the tape.
# (3.4.1: this fixture was v + (x^0 - 1), whose NaN tangent was x^0's own defect, 0 * 0^-1;
# x^0 is the constant 1 now, so the NaN comes from x^0.5 instead.)
var _n4_kf = dual_add(dual_const(0xBFF8000000000000),
  dual_sub(dual_pow(dual_var(0), F64_HALF), dual_pow(dual_var(0), F64_HALF)));
assert_eq(f64_eq(Dual_deriv(_n4_kf), Dual_deriv(_n4_kf)), 0, "the fixture's forward tangent is NaN");
var _n4_kl = dual_ln(_n4_kf);
assert_eq(Dual_val(_n4_kl), 0, "dual_ln at -1.5 with a NaN tangent: the miss's value 0");
assert_eq(Dual_deriv(_n4_kl), _AD_NAN, "dual_ln at -1.5 with a NaN tangent: a moving miss's NaN (3.4.1 SYM4)");
var _n4_ks = dual_sqrt(_n4_kf);
assert_eq(Dual_val(_n4_ks), 0, "dual_sqrt at -1.5 with a NaN tangent: the miss's value 0");
assert_eq(Dual_deriv(_n4_ks), _AD_NAN, "dual_sqrt at -1.5 with a NaN tangent: a moving miss's NaN (3.4.1 SYM4)");
var _n4_kd = dual_div(dual_const(F64_TWO), dual_add(_n4_kf, dual_const(0x3FF8000000000000)));
assert_eq(Dual_val(_n4_kd), 0, "dual_div(2, 0 with a NaN tangent): the miss's value 0");
assert_eq(Dual_deriv(_n4_kd), _AD_NAN, "dual_div(2, 0 with a NaN tangent): a moving miss's NaN (3.4.1 SYM4)");
var _n4_kx = ad_var(_n4_tr, 0);
var _n4_kp = ad_sub(_n4_tr, ad_pow(_n4_tr, _n4_kx, F64_HALF), ad_pow(_n4_tr, _n4_kx, F64_HALF));
var _n4_kin = ad_add(_n4_tr, ad_const(_n4_tr, 0xBFF8000000000000), _n4_kp);
var _n4_kr = ad_ln(_n4_tr, _n4_kin);
var _n4g12t, _n4g12v = ad_grad(_n4_tr, _n4_kr);
assert_eq(ad_val(_n4_tr, _n4_kr), 0, "ad_ln at -1.5 with a NaN partial upstream: the miss's value 0");
assert_eq(ad_grad_of(_n4_tr, _n4_kx), _AD_NAN,
  "ad_ln at -1.5 with a NaN partial upstream: a moving miss's NaN (3.4.1 SYM4)");
assert_eq(ad_grad_of(_n4_tr, _n4_kx), Dual_deriv(_n4_kl), "ad_ln and dual_ln agree at a miss with a NaN tangent");
var _n4_xc = ad_var(_n4_tp, 0);
var _n4_lc = ad_ln(_n4_tp, _n4_xc);
var _n4g4t, _n4g4v = ad_grad(_n4_tp, _n4_lc);
assert_eq(ad_val(_n4_tp, _n4_lc), 0, "ad_ln(+0): the miss's value 0, unchanged");
assert_eq(ad_grad_of(_n4_tp, _n4_xc), _AD_NAN, "ad_ln(+0): a pole, a moving miss's NaN (3.4.1 SYM4)");
var _n4_sc = ad_sqrt(_n4_tp, _n4_xc);
var _n4g5t, _n4g5v = ad_grad(_n4_tp, _n4_sc);
assert_eq(ad_val(_n4_tp, _n4_sc), 0, "ad_sqrt(+0): the miss's value 0, unchanged");
assert_eq(ad_grad_of(_n4_tp, _n4_xc), _AD_NAN, "ad_sqrt(+0): an unbounded slope, a moving miss's NaN (3.4.1 SYM4)");

# === 3.4.0: a refused allocation returns the designed failure ===
# Every allocation in num, num_ext, symbolic and autodiff that was stored through
# unchecked now returns its function's failure handle, 0. ALLOC_MAX is lib/alloc.cyr's
# public size cap: at 0 every alloc() refuses, which is how an exhausted heap answers, so
# each call below takes its refusal path. On the base tree each of these calls exits 139
# (a store through the null). num_modinv now keeps its Bezout pair on the stack and
# answers without allocating. ALLOC_MAX is restored before any assertion runs.
# [measured: scratch oom probes, base tree, one process per call, all exit 139, 2026-10-31]
test_group("3.4.0: a refused allocation returns the designed failure");
# Every operand and name is made before the cap drops, so each call meets the refusal
# in its own allocation, not in an argument's.
var _n4_amax = ALLOC_MAX;
var _n4_dv = dual_var(F64_TWO);
var _n4_wn = str_from("w");
var _n4_xn = str_from("x");
var _n4_sx = expr_sin(_n4_x);
var _n4_s1 = expr_add(_n4_sx, _n4_y);
var _n4_s2 = expr_mul(_n4_sx, _n4_y);
var _n4_s3 = expr_pow(_n4_sx, _n4_y);
var _n4_s4 = expr_neg(_n4_sx);
var _n4_s5 = expr_exp(_n4_sx);
var _n4_s6 = expr_ln(_n4_sx);
ALLOC_MAX = 0;
# expr_simplify rebuilds sin(x), and that refused node meets each operator's 0 test.
var _n4z1 = expr_simplify(_n4_s1);
var _n4z2 = expr_simplify(_n4_s2);
var _n4z3 = expr_simplify(_n4_s3);
var _n4z4 = expr_simplify(_n4_s4);
var _n4z5 = expr_simplify(_n4_s5);
var _n4z6 = expr_simplify(_n4_s6);
# Each constructor's own allocation, with children it accepts.
var _n4c1 = expr_mul(_n4_x, _n4_y);
var _n4c2 = expr_pow(_n4_x, _n4_y);
var _n4c3 = expr_neg(_n4_x);
var _n4c4 = expr_cos(_n4_x);
var _n4c5 = expr_exp(_n4_x);
var _n4c6 = expr_ln(_n4_x);
var _n4a1 = dual_new(F64_ONE, F64_ONE);
var _n4a2 = dual_ln(_n4_dv);
var _n4a3 = expr_const(F64_ONE);
var _n4a4 = expr_var(_n4_wn);
var _n4a5 = expr_add(_n4_x, _n4_y);
var _n4a6 = expr_sin(_n4_x);
var _n4a7 = expr_bind(_n4_wn, F64_ONE);
var _n4a8 = sym_const_to_str(0x3FE0000000000000);
var _n4a9 = sym_const_to_str(0x43F0000000000000);
var _n4a10 = pcg32_new(7);
var _n4a11 = num_sieve(100);
var _n4a12 = num_factorize(12);
var _n4a13 = num_continued_fraction_rational(7, 3);
var _n4a14 = num_modinv(3, 7);
var _n4a15 = expr_diff(_n4_tree, _n4_xn);
ALLOC_MAX = 1000;
var _n4a16 = num_sieve(1000);
# 120 bytes: vec_new's 128-byte slot array is refused, the 101-byte sieve is not.
ALLOC_MAX = 120;
var _n4a17 = num_sieve(100);
ALLOC_MAX = _n4_amax;
assert_eq(_n4a1, 0, "dual_new: a refused allocation -> 0 (3.3.7: exit 139)");
assert_eq(_n4a2, 0, "dual_ln: its result's refused allocation -> 0");
assert_eq(_n4a3, 0, "expr_const: a refused allocation -> 0 (3.3.7: exit 139)");
assert_eq(_n4a4, 0, "expr_var: a refused allocation -> 0");
assert_eq(_n4a5, 0, "expr_add: a refused allocation -> 0");
assert_eq(_n4a6, 0, "expr_sin: a refused allocation -> 0");
assert_eq(_n4a7, 0, "expr_bind: a refused allocation -> 0 (3.3.7: exit 139)");
assert_eq(_n4a8, 0, "sym_const_to_str(0.5): a refused buffer -> 0 (3.3.7: exit 139)");
assert_eq(_n4a9, 0, "sym_const_to_str(2^64): a refused exact-integer buffer -> 0");
assert_eq(_n4a10, 0, "pcg32_new: a refused allocation -> 0 (3.3.7: exit 139)");
assert_eq(_n4a11, 0, "num_sieve: a refused vec -> 0 (3.3.7: exit 139)");
assert_eq(_n4a12, 0, "num_factorize: a refused vec -> 0 (3.3.7: exit 139)");
assert_eq(_n4a13, 0, "num_continued_fraction_rational: a refused vec -> 0 (3.3.7: exit 139)");
assert_eq(_n4a14, 5, "num_modinv(3, 7) = 5 with every allocation refused: it no longer allocates (3.3.7: exit 139)");
assert_eq(_n4a15, 0, "expr_diff: a refused node anywhere in the derivative -> 0 at its root");
assert_eq(_n4a16, 0, "num_sieve(1000): its vec allocated, the 1001-byte sieve refused -> 0");
assert_eq(_n4a17, 0, "num_sieve(100): its vec refused, the 101-byte sieve granted -> 0, not a push through 0");
assert_eq(_n4z1, 0, "expr_simplify: a refused rebuild under + -> 0 (3.3.7: the tag read through 0)");
assert_eq(_n4z2, 0, "expr_simplify: a refused rebuild under * -> 0");
assert_eq(_n4z3, 0, "expr_simplify: a refused rebuild under ^ -> 0");
assert_eq(_n4z4, 0, "expr_simplify: a refused rebuild under neg -> 0");
assert_eq(_n4z5, 0, "expr_simplify: a refused rebuild under exp -> 0");
assert_eq(_n4z6, 0, "expr_simplify: a refused rebuild under ln -> 0");
assert_eq(_n4c1 | _n4c2 | _n4c3 | _n4c4 | _n4c5 | _n4c6, 0,
  "expr_mul / pow / neg / cos / exp / ln: a refused allocation -> 0 (3.3.7: exit 139)");
assert_eq(ALLOC_MAX, _n4_amax, "ALLOC_MAX restored");

# === 3.4.1: cmat_trace refuses a non-square matrix ===
# Roadmap [3.4.1] (AU2-G6-F1). The loop ran to rows(m) and read m[i][i]: on cmat_new(3, 1)
# holding 1, 2, 3 it returned 6 + 0i, the 2.0 past the end being the next heap object, and
# a 65536 x 1 at a heap-chunk edge exited 139. A trace exists for square matrices only.
# [measured: scratch probe p1 on the 3.4.1 baseline, 2026-10-31: re 0x4018000000000000]
test_group("3.4.1: cmat_trace refuses a non-square matrix");
var _s1_tall = cmat_new(3, 1);
cmat_set(_s1_tall, 0, 0, cx_real(F64_ONE));
cmat_set(_s1_tall, 1, 0, cx_real(F64_TWO));
cmat_set(_s1_tall, 2, 0, cx_real(f64_from(3)));
assert_eq(cmat_trace(_s1_tall), 0, "cmat_trace(3 x 1): 0, no trace (3.4.0: 6 + 0i, read past the buffer)");
assert_eq(cmat_trace(cmat_new(1, 3)), 0, "cmat_trace(1 x 3): 0");
assert_eq(cmat_trace(cmat_new(256, 255)), 0, "cmat_trace(256 x 255): 0 (3.4.0: one entry past the end)");
var _s1_sq = cmat_new(2, 2);
cmat_set(_s1_sq, 0, 0, cx_new(0x3FF3C0CA428C59FB, 0xBFE5D1D8A3B2C6F1));
cmat_set(_s1_sq, 1, 1, cx_new(0x400921FB54442D18, 0x3FD5555555555555));
cmat_set(_s1_sq, 0, 1, cx_new(0x4059000000000000, 0x4059000000000000));
var _s1_tr = cmat_trace(_s1_sq);
assert_eq(HComplex_re(_s1_tr), f64_add(0x3FF3C0CA428C59FB, 0x400921FB54442D18),
  "cmat_trace(2 x 2).re: the diagonal's sum, off-diagonal untouched");
assert_eq(HComplex_im(_s1_tr), f64_add(0xBFE5D1D8A3B2C6F1, 0x3FD5555555555555), "cmat_trace(2 x 2).im");

# === 3.4.1: cx_div / cx_inv near DBL_MAX and over an infinite divisor ===
# Roadmap [3.4.1] (AU2-X1, AU2-G6-F16). Smith's denominator and numerators reach twice
# max|b| and max|a|, so from about DBL_MAX / 2 they overflowed: the quotient came back 0
# (x / Inf), +-Inf or NaN (Inf / Inf) for an ordinary number. Oracles: the exact rational
# quotient (Fraction), correctly rounded; Smith's is correctly rounded on all but the
# numerator-overflow row, where it is 1 ulp off in each part (as it is unscaled).
# [measured: scratch probes p1, p3, p9 on the 3.4.1 baseline and lane, Fraction oracle, 2026-10-31]
test_group("3.4.1: cx_div / cx_inv near DBL_MAX and over an infinite divisor");
var _s2_m = 0x7FEFFFFFFFFFFFFF;
var _s2_q1 = cx_div(cx_new(0x7FE0000000000000, 0), cx_new(0x7FE8F0A3D70A3D71, 0x7FE724C3FA1D5B7A));
assert_eq(HComplex_re(_s2_q1), 0x3FD60FA1D1941C63, "cx_div(2^1023, big b).re = 0.3447, correctly rounded (3.4.0: 0)");
assert_eq(HComplex_im(_s2_q1), 0xBFD478D7D0D8BC3C, "cx_div(2^1023, big b).im = -0.3199 (3.4.0: -0)");
var _s2_q2 = cx_div(cx_new(0x7FE0000000000000, 0), cx_new(0x7FE724C3FA1D5B7A, 0x7FE8F0A3D70A3D71));
assert_eq(HComplex_re(_s2_q2), 0x3FD478D7D0D8BC3C, "cx_div, Smith's second branch (|bi| >= |br|): re (3.4.0: 0)");
assert_eq(HComplex_im(_s2_q2), 0xBFD60FA1D1941C63, "cx_div, Smith's second branch: im");
var _s2_q3 = cx_div(cx_new(0x7E70000000000000, 0x7E70000000000000), cx_new(_s2_m, _s2_m));
assert_eq(HComplex_re(_s2_q3), 0x3E70000000000001, "cx_div(2^1000(1 + i), DBL_MAX(1 + i)).re (3.4.0: 0)");
assert_eq(HComplex_im(_s2_q3), 0, "cx_div(2^1000(1 + i), DBL_MAX(1 + i)).im = +0");
var _s2_q4 = cx_div(cx_new(_s2_m, _s2_m), cx_new(F64_TWO, 0x3FFE666666666666));
assert_eq(HComplex_re(_s2_q4), 0x7FE06643F3E3BE11,
  "cx_div(DBL_MAX(1 + i), 2 + 1.9i).re: a numerator overflow, now finite (3.4.0: +Inf; exact ...BE10)");
assert_eq(HComplex_im(_s2_q4), 0x7F8AE9761382DC09, "cx_div(DBL_MAX(1 + i), 2 + 1.9i).im (exact ...DC08)");
var _s2_i1 = cx_inv(cx_new(_s2_m, _s2_m));
assert_eq(HComplex_re(_s2_i1), 0x0002000000000000, "cx_inv(DBL_MAX(1 + i)).re = 2^-1025 (3.4.0: 0)");
assert_eq(HComplex_im(_s2_i1), 0x8002000000000000, "cx_inv(DBL_MAX(1 + i)).im = -2^-1025 (3.4.0: -0)");
var _s2_i2 = cx_inv(cx_new(_s2_m, 0x7FECCCCCCCCCCCCB));
assert_eq(HComplex_re(_s2_i2), 0x000235BEF0712630, "cx_inv(DBL_MAX + 0.9 DBL_MAX i).re, the first branch (3.4.0: 0)");
assert_eq(HComplex_im(_s2_i2), 0x8001FD2BD865D592, "cx_inv(DBL_MAX + 0.9 DBL_MAX i).im");
# C99 G.5.1: a finite a over an infinite b is 0, where Smith's ratio was Inf / Inf.
var _s2_z1 = cx_div(cx_new(F64_ONE, F64_ONE), cx_new(F64_POS_INF, F64_POS_INF));
assert_eq(HComplex_re(_s2_z1) | HComplex_im(_s2_z1), 0, "cx_div(1 + i, Inf + Inf i) = 0 + 0i (3.4.0: NaN + NaN i)");
var _s2_z2 = cx_div(cx_new(F64_ONE, F64_ONE), cx_new(0x7FF8000000000000, F64_POS_INF));
assert_eq(HComplex_re(_s2_z2), 0, "cx_div(1 + i, NaN + Inf i).re = +0: an infinity with a NaN part (3.4.0: NaN)");
assert_eq(HComplex_im(_s2_z2), 0x8000000000000000,
  "cx_div(1 + i, NaN + Inf i).im = 0 * (1 * 0 - 1 * 1) = -0, _Cdivd's");
var _s2_z3 = cx_div(cx_new(0xBFF0000000000000, F64_TWO), cx_new(0xFFF0000000000000, 0xFFF0000000000000));
assert_eq(HComplex_re(_s2_z3), 0x8000000000000000, "cx_div(-1 + 2i, -Inf - Inf i).re = 0 * (1 - 2) = -0");
assert_eq(HComplex_im(_s2_z3), 0x8000000000000000, "cx_div(-1 + 2i, -Inf - Inf i).im = 0 * (-2 - 1) = -0");
var _s2_z4 = cx_inv(cx_new(F64_POS_INF, F64_POS_INF));
assert_eq(HComplex_re(_s2_z4), 0, "cx_inv(Inf + Inf i).re = +0 (3.4.0: NaN)");
assert_eq(HComplex_im(_s2_z4), 0x8000000000000000, "cx_inv(Inf + Inf i).im = -0");
# Unchanged: Smith's own zeros over one infinite part, NaN and infinite dividends, the pole,
# and an ordinary quotient (the formula composed by hand, a second code path).
var _s2_k1 = cx_div(cx_new(F64_ONE, F64_ONE), cx_new(F64_POS_INF, F64_ONE));
assert_eq(HComplex_re(_s2_k1) | HComplex_im(_s2_k1), 0, "cx_div(1 + i, Inf + 1i) = 0 + 0i, as before");
var _s2_k2 = cx_inv(cx_new(F64_POS_INF, F64_ONE));
assert_eq(HComplex_im(_s2_k2), 0x8000000000000000, "cx_inv(Inf + 1i).im = -0, Smith's sign kept");
var _s2_k3 = cx_div(cx_new(0x7FF8000000000000, 0), cx_new(F64_POS_INF, F64_POS_INF));
assert_eq(f64_eq(HComplex_re(_s2_k3), HComplex_re(_s2_k3)), 0, "cx_div(NaN, Inf + Inf i): NaN stays NaN");
var _s2_k7 = cx_div(cx_new(F64_POS_INF, 0), cx_new(0x7FE0000000000000, 0x7FE0000000000000));
assert_eq(HComplex_re(_s2_k7), F64_POS_INF,
  "cx_div(Inf, 2^1023 (1 + i)).re = +Inf: scaled, not Inf / Inf (3.4.0: NaN)");
assert_eq(HComplex_im(_s2_k7), 0xFFF0000000000000, "cx_div(Inf, 2^1023 (1 + i)).im = -Inf (3.4.0: NaN)");
var _s2_k4 = cx_div(cx_new(F64_POS_INF, 0), cx_new(F64_POS_INF, F64_POS_INF));
assert_eq(f64_eq(HComplex_re(_s2_k4), HComplex_re(_s2_k4)), 0, "cx_div(Inf, Inf + Inf i): NaN, not a zero");
var _s2_k5 = cx_div(cx_new(F64_ONE, F64_TWO), cx_zero());
assert_eq(HComplex_re(_s2_k5) | HComplex_im(_s2_k5), 0, "cx_div(a, 0): the documented pole sentinel, unchanged");
var _s2_k6 = cx_div(cx_new(F64_ONE, F64_TWO), cx_new(f64_from(3), f64_from(4)));
var _s2_ri = f64_div(f64_from(3), f64_from(4));
var _s2_di = f64_add(f64_mul(f64_from(3), _s2_ri), f64_from(4));
assert_eq(HComplex_re(_s2_k6), f64_div(f64_add(f64_mul(F64_ONE, _s2_ri), F64_TWO), _s2_di),
  "cx_div((1 + 2i) / (3 + 4i)).re: Smith's second branch, bit for bit");
assert_eq(HComplex_im(_s2_k6), f64_div(f64_sub(f64_mul(F64_TWO, _s2_ri), F64_ONE), _s2_di), "... .im");

# === 3.4.1: dual_pow / ad_pow at n = 0 are the constant 1 ===
# Roadmap [3.4.1] (AU2-G6-F8). n * v^(n-1) = 0 * Inf at a zero or subnormal base made the
# derivative NaN, a constant's included: dual_pow(dual_const(0), 0) was (1, NaN). v^0 = 1
# for every v, so its derivative is 0.
# [measured: scratch probe p1 on the 3.4.1 baseline, 2026-10-31: 0xFFF8000000000000]
test_group("3.4.1: dual_pow / ad_pow at n = 0 are the constant 1");
var _s3_d1 = dual_pow(dual_const(0), 0);
assert_eq(Dual_val(_s3_d1), F64_ONE, "dual_pow(const 0, 0): value 1");
assert_eq(Dual_deriv(_s3_d1), 0, "dual_pow(const 0, 0): derivative +0 (3.4.0: NaN)");
var _s3_d2 = dual_pow(dual_var(0), 0);
assert_eq(Dual_deriv(_s3_d2), 0, "dual_pow(var 0, 0): derivative +0 (3.4.0: NaN)");
var _s3_d3 = dual_pow(dual_var(1), 0x8000000000000000);
assert_eq(Dual_val(_s3_d3), F64_ONE, "dual_pow(var 2^-1074, -0): value 1");
assert_eq(Dual_deriv(_s3_d3), 0, "dual_pow(var 2^-1074, -0): derivative +0 (3.4.0: NaN)");
var _s3_d4 = dual_pow(dual_var(f64_from(3)), F64_TWO);
assert_eq(Dual_deriv(_s3_d4), f64_from(6), "dual_pow(var 3, 2): derivative 6, unchanged");
var _s3_t = ad_tape_new(16);
var _s3_x = ad_var(_s3_t, 0);
var _s3_p = ad_pow(_s3_t, _s3_x, 0);
var _s3_r = ad_mul(_s3_t, _s3_p, ad_const(_s3_t, 0x7FF8000000000000));
var _s3g1t, _s3g1v = ad_grad(_s3_t, _s3_p);
assert_eq(ad_val(_s3_t, _s3_p), F64_ONE, "ad_pow(0, 0): value 1");
assert_eq(ad_grad_of(_s3_t, _s3_x), 0, "ad_pow(0, 0): d/dx +0 (3.4.0: NaN)");
var _s3g2t, _s3g2v = ad_grad(_s3_t, _s3_r);
assert_eq(ad_grad_of(_s3_t, _s3_x), 0,
  "ad_pow(x, 0) is a constant: a NaN adjoint above it does not reach x (1 * NaN stops at the node)");

# === 3.4.1: dual_div / ad_div without b^2, ad_div's value ===
# Roadmap [3.4.1] (AU2-G6-F7, F13). The quotient rule's b^2 overflowed past |b| = 2^512 and
# underflowed below 2^-537, and ad_div's value was a * (1/b), two roundings. Oracle: the
# exact rational 1/b, a/b and -a/b^2, correctly rounded; every row below is that rounding.
# [measured: scratch probe p1 on the 3.4.1 baseline and lane, Fraction oracle, 2026-10-31]
test_group("3.4.1: dual_div / ad_div without b^2, ad_div's value");
var _s4_d1 = dual_div(dual_var(0x6974E718D7D7625A), dual_const(0x6974E718D7D7625A));
assert_eq(Dual_val(_s4_d1), F64_ONE, "dual_div(var 1e200, const 1e200): value 1");
assert_eq(Dual_deriv(_s4_d1), 0x16687E92154EF7AC, "dual_div(var 1e200, const 1e200): derivative 1e-200 (3.4.0: 0)");
var _s4_d2 = dual_div(dual_var(0x1EF6E0C2B9F0C1D5), dual_const(0x1EF6E0C2B9F0C1D5));
assert_eq(Dual_deriv(_s4_d2), 0x60E6612DE7F41BF4, "dual_div at b = 1EF6E0C2B9F0C1D5: 1/b (3.4.0: 2.4e9 ulp off)");
var _s4_d3 = dual_div(dual_var(0x1675DD6DD21D2E61), dual_const(0x1675DD6DD21D2E61));
assert_eq(Dual_deriv(_s4_d3), 0x69676A9D73587A41, "dual_div at b = 1.785e-200: 1/b (3.4.0: +Inf)");
var _s4_d4 = dual_div(dual_const(f64_from(3)), dual_var(0x6070000000000000));
assert_eq(Dual_deriv(_s4_d4), 0x8000000C00000000,
  "dual_div(const 3, var 2^520): -3 * 2^-1040, a subnormal (3.4.0: -0, b^2 overflowed)");
var _s4_d5 = dual_div(dual_const(0x01A56E1FC2F8F359), dual_var(0x1675DD6DD21D2E61));
assert_eq(Dual_val(_s4_d5), 0x2B1F5D1A1DC73DFD, "dual_div value a/b, correctly rounded");
assert_eq(Dual_deriv(_s4_d5), 0xD496F3697DBF485A, "dual_div d/db = -a/b^2, correctly rounded (3.4.0: -Inf)");
var _s4_t = ad_tape_new(16);
var _s4_a = ad_var(_s4_t, 0x01A56E1FC2F8F359);
var _s4_b = ad_var(_s4_t, 0x1675DD6DD21D2E61);
var _s4_q = ad_div(_s4_t, _s4_a, _s4_b);
var _s4gt, _s4gv = ad_grad(_s4_t, _s4_q);
assert_eq(ad_val(_s4_t, _s4_q), 0x2B1F5D1A1DC73DFD, "ad_div value a/b, correctly rounded (3.4.0: ...DFE, a * (1/b))");
assert_eq(ad_grad_of(_s4_t, _s4_a), 0x69676A9D73587A41, "ad_div d/da = 1/b");
assert_eq(ad_grad_of(_s4_t, _s4_b), 0xD496F3697DBF485A, "ad_div d/db = -q/b = -a/b^2 rounded (3.4.0: -Inf)");
assert_eq(ad_grad_of(_s4_t, _s4_b), Dual_deriv(_s4_d5), "ad_div and dual_div agree on d/db, bit for bit");

# === 3.4.1: forward and reverse agree on special values ===
# Roadmap [3.4.1] (R2A SF2). Through 3.4.0 the modes disagreed on 124 of R2A's 1,440
# single-op cases: a NaN tangent through a zero partial (forward 0 * NaN, the sweep
# skipped a +0 adjoint), an infinite value times a constant's zero tangent (forward
# Inf * 0 = NaN), and the sign of a zero (adjoints summed from +0). The rule above
# dual_div: a STRUCTURAL zero is exact (3.4.1 SYM2 narrowed the first draft's "a zero tangent
# is exact" to a constant's tangent and a constant zero operand), and every other product is
# IEEE in both modes. The NaN tangent here is x^0.5 - x^0.5 at x = 0, Inf - Inf in both modes.
# On the 3.4.1 baseline 448 of 2,880 cases (R2A's 1,440, the same ops on a constant input, and
# this NaN tangent) disagree; on this tree none, apart from 18 in the sign of a zero derivative
# (3.4.1 SYM2: forward mode stores a moving zero as -0, the tape keeps IEEE's sign).
# [measured: scratch forward/reverse sweep (R2A's ad1.py, extended), 2026-10-31; SYM2 rerun the same day]
test_group("3.4.1: forward and reverse agree on special values");
var _s5_t = ad_tape_new(64);
# A NaN tangent times a CONSTANT zero: in * 0, in = 2 + (x^0.5 - x^0.5) at x = 0. (3.4.1 SYM2:
# 0 * g(x) is the constant 0 wherever g(x) is finite, so its derivative is exactly 0 in both
# modes; the first 3.4.1 draft gave NaN, 0 * NaN. A ZERO THAT MOVES times a NaN is NaN: see
# tests/edge_cases.tcyr, group "3.4.1 SYM2: structural zeros, in both modes".)
var _s5_fin = dual_add(dual_const(F64_TWO), dual_sub(dual_pow(dual_var(0), F64_HALF), dual_pow(dual_var(0), F64_HALF)));
var _s5_f1 = dual_mul(_s5_fin, dual_const(0));
assert_eq(Dual_deriv(_s5_f1), 0, "forward: (2, NaN') * const 0 is the constant 0, derivative +0 (3.4.1 SYM2)");
var _s5_x = ad_var(_s5_t, 0);
var _s5_in = ad_add(_s5_t, ad_const(_s5_t, F64_TWO),
  ad_sub(_s5_t, ad_pow(_s5_t, _s5_x, F64_HALF), ad_pow(_s5_t, _s5_x, F64_HALF)));
var _s5_r1 = ad_mul(_s5_t, _s5_in, ad_const(_s5_t, 0));
var _s5g1t, _s5g1v = ad_grad(_s5_t, _s5_r1);
var _s5_g1 = ad_grad_of(_s5_t, _s5_x);
assert_eq(_s5_g1, 0, "reverse: the same, +0: the constant 0 is recorded, x is not reached (3.4.1 SYM2)");
# An infinite value times a constant's zero tangent.
var _s5_f2 = dual_mul(dual_var(F64_POS_INF), dual_const(F64_TWO));
assert_eq(Dual_deriv(_s5_f2), F64_TWO, "forward: x * 2 at x = +Inf has derivative 2 (3.4.0: NaN, Inf * 0)");
ad_tape_reset(_s5_t);
var _s5_x2 = ad_var(_s5_t, F64_POS_INF);
var _s5_r2 = ad_mul(_s5_t, _s5_x2, ad_const(_s5_t, F64_TWO));
var _s5g2t, _s5g2v = ad_grad(_s5_t, _s5_r2);
assert_eq(ad_grad_of(_s5_t, _s5_x2), F64_TWO, "reverse: x * 2 at x = +Inf, 2");
var _s5_f3 = dual_div(dual_var(0), dual_const(F64_POS_INF));
assert_eq(Dual_deriv(_s5_f3), 0x8000000000000000,
  "forward: x / Inf at x = 0 has derivative 1/Inf = 0, a moving zero, stored -0 (3.4.0: NaN, Inf / Inf)");
var _s5_f4 = dual_add(dual_var(F64_ONE), dual_exp(dual_const(f64_from(1000))));
assert_eq(Dual_deriv(_s5_f4), F64_ONE, "forward: x + exp(const 1000) has derivative 1 (3.4.0: NaN, 0 * Inf)");
assert_eq(Dual_deriv(dual_exp(dual_const(f64_from(1000)))), 0, "forward: exp(const 1000) is a constant, derivative +0");
# A NaN value from mul has a NaN derivative in both modes.
var _s5_f5 = dual_mul(dual_var(F64_POS_INF), dual_const(0));
assert_eq(f64_eq(Dual_deriv(_s5_f5), Dual_deriv(_s5_f5)), 0, "forward: x * 0 at x = +Inf, value NaN, derivative NaN");
ad_tape_reset(_s5_t);
var _s5_x5 = ad_var(_s5_t, F64_POS_INF);
var _s5_r5 = ad_mul(_s5_t, _s5_x5, ad_const(_s5_t, 0));
var _s5g5t, _s5g5v = ad_grad(_s5_t, _s5_r5);
var _s5_g5 = ad_grad_of(_s5_t, _s5_x5);
assert_eq(f64_eq(_s5_g5, _s5_g5), 0, "reverse: x * 0 at x = +Inf, d/dx NaN (3.4.0: 0)");
# The sign of a zero: d cos x / dx at +0 is -sin(+0) = -0 in both modes.
ad_tape_reset(_s5_t);
var _s5_x6 = ad_var(_s5_t, 0);
var _s5_r6 = ad_cos(_s5_t, _s5_x6);
var _s5g6t, _s5g6v = ad_grad(_s5_t, _s5_r6);
assert_eq(ad_grad_of(_s5_t, _s5_x6), 0x8000000000000000,
  "reverse: d cos x / dx at +0 = -0 (3.4.0: +0, summed from +0)");
assert_eq(Dual_deriv(dual_cos(dual_var(0))), 0x8000000000000000, "forward: the same -0");
ad_tape_reset(_s5_t);
var _s5_x7 = ad_var(_s5_t, 0x3FF8000000000000);
var _s5_r7 = ad_mul(_s5_t, _s5_x7, ad_const(_s5_t, 0x8000000000000000));
var _s5_u7 = ad_var(_s5_t, F64_ONE);
var _s5g7t, _s5g7v = ad_grad(_s5_t, _s5_r7);
assert_eq(ad_grad_of(_s5_t, _s5_x7), 0,
  "reverse: d (x * const -0) / dx at 1.5 = +0, the constant zero annihilates (3.4.1 SYM2; the first draft: -0)");
assert_eq(ad_grad_of(_s5_t, _s5_u7), 0, "reverse: a node above the root reads +0");
assert_eq(Dual_deriv(dual_mul(dual_var(0x3FF8000000000000), dual_const(0x8000000000000000))), 0,
  "forward: the same +0, x * const -0 is the constant -0 (3.4.1 SYM2; the first draft: -0)");
# The same through the second operand: d (-0 * x) / dx at 1.5 = +0 (3.4.1 SYM2).
ad_tape_reset(_s5_t);
var _s5_x9 = ad_var(_s5_t, 0x3FF8000000000000);
var _s5_r9 = ad_mul(_s5_t, ad_const(_s5_t, 0x8000000000000000), _s5_x9);
var _s5g9t, _s5g9v = ad_grad(_s5_t, _s5_r9);
assert_eq(ad_grad_of(_s5_t, _s5_x9), 0, "reverse: d (const -0 * x) / dx at 1.5 = +0 (3.4.1 SYM2; the first draft: -0)");
assert_eq(Dual_deriv(dual_mul(dual_const(0x8000000000000000), dual_var(0x3FF8000000000000))), 0,
  "forward: the same +0 (3.4.1 SYM2)");
# A NaN value from div (Inf / Inf) has a NaN derivative in both modes.
var _s5_fa = Dual_deriv(dual_div(dual_var(F64_POS_INF), dual_const(F64_POS_INF)));
assert_eq(f64_eq(_s5_fa, _s5_fa), 0, "forward: x / Inf at x = +Inf, derivative NaN");
ad_tape_reset(_s5_t);
var _s5_xa = ad_var(_s5_t, F64_POS_INF);
var _s5_ra = ad_div(_s5_t, _s5_xa, ad_const(_s5_t, F64_POS_INF));
var _s5gat, _s5gav = ad_grad(_s5_t, _s5_ra);
var _s5_ga = ad_grad_of(_s5_t, _s5_xa);
assert_eq(f64_eq(_s5_ga, _s5_ga), 0, "reverse: x / Inf at x = +Inf, d/dx NaN (3.4.0: 1/Inf = 0)");
# A constant has the tangent +0, whatever its value: no op forms 0 * Inf, 0 * NaN or a
# zero's sign from a constant's tangent.
assert_eq(Dual_deriv(dual_cos(dual_const(0x3FF8000000000000))), 0, "forward: cos(const 1.5): +0 (3.4.0: -0)");
assert_eq(Dual_deriv(dual_neg(dual_const(F64_TWO))), 0, "forward: -(const 2): +0 (3.4.0: -0)");
assert_eq(Dual_deriv(dual_sin(dual_const(F64_POS_INF))), 0, "forward: sin(const +Inf): +0 (3.4.0: 0 * NaN = NaN)");
assert_eq(Dual_deriv(dual_ln(dual_const(0x7FF8000000000000))), 0, "forward: ln(const NaN): +0 (3.4.0: 0 / NaN = NaN)");
assert_eq(Dual_deriv(dual_sqrt(dual_const(0x7FF8000000000000))), 0, "forward: sqrt(const NaN): +0 (3.4.0: NaN)");
assert_eq(Dual_deriv(dual_abs(dual_const(f64_from(0 - 3)))), 0, "forward: |const -3|: +0 (3.4.0: -0)");
assert_eq(Dual_deriv(dual_pow(dual_const(0), F64_HALF)), 0, "forward: (const 0)^0.5: +0 (3.4.0: 0 * Inf = NaN)");
assert_eq(Dual_deriv(dual_mul(dual_const(F64_POS_INF), dual_const(0))), 0,
  "forward: const Inf * const 0: +0, a constant with a NaN value (3.4.0: NaN)");
assert_eq(Dual_deriv(dual_div(dual_const(F64_POS_INF), dual_const(F64_POS_INF))), 0,
  "forward: const Inf / const Inf: +0 (3.4.0: NaN)");
assert_eq(Dual_deriv(dual_mul(dual_const(F64_TWO), dual_var(F64_POS_INF))), F64_TWO,
  "forward: 2 * x at x = +Inf: 2, the first operand's constant term dropped (3.4.0: NaN)");
# A miss is the constant 0 on the tape too: a NaN partial upstream does not cross it.
ad_tape_reset(_s5_t);
var _s5_kx = ad_var(_s5_t, 0);
var _s5_kin = ad_add(_s5_t, ad_const(_s5_t, 0xBFF8000000000000),
  ad_sub(_s5_t, ad_pow(_s5_t, _s5_kx, F64_HALF), ad_pow(_s5_t, _s5_kx, F64_HALF)));
var _s5_ks = ad_sqrt(_s5_t, _s5_kin);
var _s5gst, _s5gsv = ad_grad(_s5_t, _s5_ks);
assert_eq(ad_grad_of(_s5_t, _s5_kx), _AD_NAN,
  "ad_sqrt at -1.5 with a NaN partial upstream: a moving miss's NaN, as dual_sqrt's");
var _s5_kd = ad_div(_s5_t, ad_const(_s5_t, F64_TWO), ad_add(_s5_t, _s5_kin, ad_const(_s5_t, 0x3FF8000000000000)));
var _s5gdt, _s5gdv = ad_grad(_s5_t, _s5_kd);
assert_eq(ad_val(_s5_t, _s5_kd), 0, "ad_div(2, 0 with a NaN partial upstream): the miss's value 0");
assert_eq(ad_grad_of(_s5_t, _s5_kx), _AD_NAN,
  "ad_div(2, 0 with a NaN partial upstream): a moving miss's NaN, as dual_div's");
# A chain of ops still agrees bit for bit: sin(exp(x)) at a full-mantissa x.
var _s5_xv = 0x3FD3C0CA428C59FB;
var _s5_f8 = dual_sin(dual_exp(dual_var(_s5_xv)));
ad_tape_reset(_s5_t);
var _s5_x8 = ad_var(_s5_t, _s5_xv);
var _s5_r8 = ad_sin(_s5_t, ad_exp(_s5_t, _s5_x8));
var _s5g8t, _s5g8v = ad_grad(_s5_t, _s5_r8);
assert_eq(ad_grad_of(_s5_t, _s5_x8), Dual_deriv(_s5_f8), "sin(exp(x)): forward and reverse, bit for bit");
assert_eq(Dual_deriv(_s5_f8), f64_mul(f64_exp(_s5_xv), f64_cos(f64_exp(_s5_xv))), "... = exp(x) cos(exp(x)) by hand");

# === 3.4.1: expr_diff's power rule and its zero terms ===
# Roadmap [3.4.1] (AU1 SYM-F1, SYM-F6). An exponent with no x that was not a CONST node took
# the general rule f^g (g' ln f + g f'/f), whose 0 * ln f is NaN for f <= 0; and every rule
# multiplied by a factor's derivative even where it was the constant 0, so the unsimplified
# tree formed 0 * Inf. Oracles: the power rule's 3x^2 and the simplified tree.
# [measured: scratch probe p2 on the 3.4.1 baseline, 2026-10-31: NaN at each row marked 3.4.0]
test_group("3.4.1: expr_diff's power rule and its zero terms");
var _s6_xn = str_from("x");
var _s6_x = expr_var(_s6_xn);
var _s6_y = expr_var(str_from("y"));
var _s6_v = vec_new();
vec_push(_s6_v, expr_bind(_s6_xn, 0xBFFBB303EC100C7C));
vec_push(_s6_v, expr_bind(str_from("y"), f64_from(3)));
var _s6_d1 = expr_diff(expr_pow(_s6_x, _s6_y), _s6_xn);
var _s6e1t, _s6e1v = expr_eval_checked(_s6_d1, _s6_v);
assert_eq(_s6e1v, 0x4021FB800DAD62C2, "d/dx x^y at x = BFFBB303EC100C7C, y = 3: 3x^2 (3.4.0: NaN)");
assert_eq(_s6e1v, f64_mul(f64_mul(f64_from(3), ganita_f64_pow(0xBFFBB303EC100C7C, F64_TWO)), F64_ONE),
  "... = 3 * x^2 * 1, the power rule composed by hand");
var _s6_v0 = vec_new();
vec_push(_s6_v0, expr_bind(_s6_xn, 0));
vec_push(_s6_v0, expr_bind(str_from("y"), f64_from(3)));
var _s6e2t, _s6e2v = expr_eval_checked(_s6_d1, _s6_v0);
assert_eq(_s6e2v, 0, "d/dx x^y at x = 0, y = 3: 0 (3.4.0: NaN, 0 * ln 0)");
assert_eq(_s6e2t == 0, 1, "... Ok");
var _s6_d2 = expr_diff(expr_pow(_s6_x, expr_neg(expr_const(0xC008000000000000))), _s6_xn);
var _s6_vm = vec_new();
vec_push(_s6_vm, expr_bind(_s6_xn, 0xC000000000000000));
var _s6e3t, _s6e3v = expr_eval_checked(_s6_d2, _s6_vm);
assert_eq(_s6e3v, f64_from(12), "d/dx x^(-(-3)) at x = -2: 12, a NEG exponent takes the power rule (3.4.0: NaN)");
var _s6_d3 = expr_diff(expr_pow(_s6_x, expr_const(0)), _s6_xn);
assert_eq(expr_tag(_s6_d3), EXPR_CONST, "d/dx x^0 is the constant node 0");
assert_eq(expr_const_val(_s6_d3), 0, "d/dx x^0 = +0 (3.4.0: (0 * x^-1) * 1, NaN at x = 0)");
var _s6_d4 = expr_diff(expr_mul(expr_const(F64_TWO), expr_exp(_s6_x)), _s6_xn);
assert_eq(str_eq(expr_to_str(_s6_d4), str_from("(2 * (exp(x) * 1))")), 1,
  "d/dx 2 exp(x) = (2 * (exp(x) * 1)), no 0 * exp(x) term");
var _s6_v7 = vec_new();
vec_push(_s6_v7, expr_bind(_s6_xn, f64_from(710)));
var _s6e4t, _s6e4v = expr_eval_checked(_s6_d4, _s6_v7);
assert_eq(_s6e4v, F64_POS_INF, "d/dx 2 exp(x) at 710: +Inf, as the simplified tree (3.4.0: NaN, 0 * Inf)");
var _s6_d5 = expr_diff(expr_pow(expr_const(F64_TWO), _s6_x), _s6_xn);
var _s6_v3 = vec_new();
vec_push(_s6_v3, expr_bind(_s6_xn, f64_from(3)));
var _s6e5t, _s6e5v = expr_eval_checked(_s6_d5, _s6_v3);
assert_eq(_s6e5v, f64_mul(ganita_f64_pow(F64_TWO, f64_from(3)), f64_mul(F64_ONE, f64_ln(F64_TWO))),
  "d/dx 2^x at 3: 2^x (1 ln 2), the general rule without its f' term, by hand");
var _s6_d6 = expr_diff(expr_pow(_s6_x, _s6_x), _s6_xn);
var _s6_v2 = vec_new();
vec_push(_s6_v2, expr_bind(_s6_xn, F64_TWO));
var _s6e6t, _s6e6v = expr_eval_checked(_s6_d6, _s6_v2);
assert_eq(_s6e6v, f64_mul(ganita_f64_pow(F64_TWO, F64_TWO), f64_add(f64_mul(F64_ONE, f64_ln(F64_TWO)),
      f64_mul(F64_TWO, f64_mul(F64_ONE, ganita_f64_pow(F64_TWO, 0xBFF0000000000000))))),
  "d/dx x^x at 2: the general rule, unchanged, by hand");
var _s6_d7 = expr_diff(expr_mul(_s6_x, expr_exp(expr_const(f64_from(1000)))), _s6_xn);
var _s6e7t, _s6e7v = expr_eval_checked(_s6_d7, _s6_v3);
assert_eq(_s6e7v, F64_POS_INF,
  "d/dx x exp(1000): +Inf, exp(1000)'s derivative the constant 0 (3.4.0: Inf + x (Inf * 0) = NaN)");
var _s6_vi = vec_new();
vec_push(_s6_vi, expr_bind(_s6_xn, F64_POS_INF));
var _s6e9t, _s6e9v = expr_eval_checked(expr_diff(expr_mul(_s6_x, expr_const(F64_TWO)), _s6_xn), _s6_vi);
assert_eq(_s6e9v, F64_TWO, "d/dx (x * 2) at x = +Inf: 2, the 2's 0 term left out (3.4.0: 1 * 2 + Inf * 0 = NaN)");
var _s6_d8 = expr_diff(expr_pow(expr_const(1), _s6_x), _s6_xn);
var _s6_vh = vec_new();
vec_push(_s6_vh, expr_bind(_s6_xn, F64_HALF));
var _s6e8t, _s6e8v = expr_eval_checked(_s6_d8, _s6_vh);
assert_eq(_s6e8v, f64_mul(ganita_f64_pow(1, F64_HALF), f64_mul(F64_ONE, f64_ln(1))),
  "d/dx (2^-1074)^x at 0.5: 2^-537 ln(2^-1074), finite (3.4.0: its g f'/f term was 0 * (2^-1074)^-1 = 0 * Inf, NaN)");
assert_eq(str_eq(expr_to_str(expr_diff(expr_add(expr_const(F64_TWO), _s6_x), _s6_xn)), str_from("1")), 1,
  "d/dx (2 + x) = 1 (3.4.0: (0 + 1))");
var _s6_c3 = expr_const(f64_from(3));
assert_eq(str_eq(expr_to_str(expr_diff(expr_mul(expr_const(F64_TWO), _s6_c3), _s6_xn)), str_from("0")), 1,
  "d/dx (2 * 3) = 0 (3.4.0: ((0 * 3) + (2 * 0)))");
assert_eq(str_eq(expr_to_str(expr_diff(expr_pow(expr_const(F64_TWO), _s6_c3), _s6_xn)), str_from("0")), 1,
  "d/dx 2^3 = 0 (3.4.0: ((3 * (2^2)) * 0))");
assert_eq(expr_diff(expr_add(_s6_x, _s6_y), 0), 0, "expr_diff with a 0 variable name -> 0");

# === 3.4.1: the symbolic walkers on a 200,000-deep tree ===
# Roadmap [3.4.1] (AU1 SYM-F3). Every walker recursed once per level, so a deep tree
# overflowed the native stack: on the 3.4.1 baseline a 100,000-term left-folded sum exits
# 139 under `ulimit -s 8192` in expr_eval_checked, expr_simplify, expr_diff, expr_to_str,
# sym_to_latex, sym_integrate and sym_rewrite. Each now walks with its own heap stack.
# Oracles: exact sums (every partial sum below is an integer or a multiple of 1/8 under
# 2^53), the text's length, and a 200,000-deep chain of sin evaluated by hand.
# [measured: scratch deep-tree probe p4 on the 3.4.1 baseline and lane, 2026-10-31: base exit 139 x 7, lane exit 0 x 8]
test_group("3.4.1: the symbolic walkers on a 200,000-deep tree");
var _s7_n = 200000;
var _s7_xn = str_from("x");
var _s7_x = expr_var(_s7_xn);
var _s7_one = expr_const(F64_ONE);
var _s7_e = _s7_x;
for (var i = 1; i < _s7_n; i = i + 1) { _s7_e = expr_add(_s7_e, _s7_one); }
var _s7_v = vec_new();
vec_push(_s7_v, expr_bind(_s7_xn, F64_HALF));
var _s7e1t, _s7e1v = expr_eval_checked(_s7_e, _s7_v);
assert_eq(_s7e1v, f64_add(F64_HALF, f64_from(_s7_n - 1)), "eval: x + 1 + ... + 1 at x = 0.5 = 199999.5, exact");
var _s7_s = expr_simplify(_s7_e);
var _s7e2t, _s7e2v = expr_eval_checked(_s7_s, _s7_v);
assert_eq(_s7e2v, _s7e1v, "simplify: a tree with the same value");
var _s7_d = expr_diff(_s7_e, _s7_xn);
assert_eq(expr_tag(_s7_d), EXPR_CONST, "diff: the sum's derivative is the constant node (its 0 terms left out)");
assert_eq(expr_const_val(_s7_d), F64_ONE, "diff: d/dx = 1");
var _s7_str = expr_to_str(_s7_e);
assert_eq(str_len(_s7_str), 6 * (_s7_n - 1) + 1, "to_str: \"((x + 1) + 1)...\" is 6(n - 1) + 1 bytes");
assert_eq(load8(str_data(_s7_str) + _s7_n - 1), 120, "to_str: n - 1 open parens, then x");
var _s7_tex = sym_to_latex(_s7_e);
assert_eq(str_len(_s7_tex), 4 * (_s7_n - 1) + 1, "sym_to_latex: \"x + 1 + 1...\" is 4(n - 1) + 1 bytes");
var _s7_i = sym_integrate(_s7_e, _s7_xn);
var _s7e3t, _s7e3v = expr_eval_checked(_s7_i, _s7_v);
assert_eq(_s7e3v, f64_add(0x3FC0000000000000, f64_mul(F64_HALF, f64_from(_s7_n - 1))),
  "integrate: 0.5 x^2 + x + ... + x at 0.5 = 0.125 + 0.5 (n - 1), exact");
var _s7_rw = sym_rewrite(_s7_e, sym_default_rules());
assert_eq(_s7_rw, _s7_e, "sym_rewrite: no rule fires, so the same tree comes back, node for node");
assert_eq(sym_match(pat_add(pat_wildcard(str_from("a")), pat_wildcard(str_from("a"))), _s7_e), 0,
  "sym_match: a + a does not match");
assert_eq(sym_match(pat_add(pat_wildcard(str_from("a")), pat_const(F64_ONE)), _s7_e), 1,
  "sym_match: a + 1 matches, a bound to the 199,999-deep left operand");
# A chain of n sines: its value by hand, and its derivative's shape. (The derivative
# shares each sin^k(x) with the chain, so as a tree it holds n^2 / 2 sines: its value is
# checked by hand on a much shorter chain instead.)
var _s7_c = _s7_x;
var _s7_c1 = 0;
for (var i = 0; i < _s7_n; i = i + 1) {
    _s7_c1 = _s7_c;
    _s7_c = expr_sin(_s7_c);
}
var _s7_hv = F64_HALF;
for (var i = 0; i < _s7_n; i = i + 1) { _s7_hv = f64_sin(_s7_hv); }
var _s7e4t, _s7e4v = expr_eval_checked(_s7_c, _s7_v);
assert_eq(_s7e4v, _s7_hv, "eval: sin applied 200,000 times to 0.5, bit for bit");
var _s7_cd = expr_diff(_s7_c, _s7_xn);
assert_eq(expr_tag(_s7_cd), EXPR_MUL, "diff of the 200,000-deep chain: cos(sin^(n-1) x) * (...)");
assert_eq(expr_tag(expr_left(_s7_cd)), EXPR_COS, "... whose first factor is a cos");
assert_eq(expr_child(expr_left(_s7_cd)), _s7_c1, "... of the chain's own sin^(n-1) x, shared");
var _s7_c2 = _s7_x;
var _s7_hv2 = F64_HALF;
var _s7_hd2 = F64_ONE;
for (var i = 0; i < 2000; i = i + 1) {
    _s7_c2 = expr_sin(_s7_c2);
    _s7_hd2 = f64_mul(f64_cos(_s7_hv2), _s7_hd2);
    _s7_hv2 = f64_sin(_s7_hv2);
}
var _s7e5t, _s7e5v = expr_eval_checked(expr_diff(_s7_c2, _s7_xn), _s7_v);
assert_eq(_s7e5v, _s7_hd2, "diff of a 2,000-deep chain: the chain rule's product of 2,000 cosines, bit for bit");

# === 3.4.1: a 0 node and a 0 name are refused, not read ===
# Roadmap [3.4.1] (AU1 SYM-F8, NU2 F4, REV-NU2 N1). 0 is the failure handle of every node
# constructor, so a failure value reaches these; through 3.4.0 each read through it (exit
# 139). Two hand-built shapes the constructors cannot make are refused the same way.
# [measured: scratch probes on the 3.4.1 baseline, 2026-10-31: exit 139 each]
test_group("3.4.1: a 0 node and a 0 name are refused, not read");
var _s8_x = expr_var(str_from("x"));
assert_eq(expr_to_str(0), 0, "expr_to_str(0) -> 0");
assert_eq(sym_to_latex(0), 0, "sym_to_latex(0) -> 0");
assert_eq(sym_integrate(0, str_from("x")), 0, "sym_integrate(0, x) -> 0");
assert_eq(sym_integrate(_s8_x, 0), 0, "sym_integrate(x, 0) -> 0");
var _s8_hole = alloc(24);
store64(_s8_hole, EXPR_ADD);
store64(_s8_hole + 8, _s8_x);
store64(_s8_hole + 16, 0);
assert_eq(expr_to_str(expr_neg(_s8_hole)), 0, "expr_to_str of a sum with a 0 operand -> 0");
assert_eq(sym_to_latex(expr_neg(_s8_hole)), 0, "sym_to_latex of a sum with a 0 operand -> 0");
assert_eq(sym_integrate(expr_neg(_s8_hole), str_from("x")), 0, "sym_integrate of a sum with a 0 operand -> 0");
assert_eq(expr_simplify(expr_neg(_s8_hole)), 0, "expr_simplify of a sum with a 0 operand -> 0");
var _s8_pw = alloc(24);
store64(_s8_pw, EXPR_POW);
store64(_s8_pw + 8, _s8_x);
store64(_s8_pw + 16, 0);
assert_eq(expr_diff(_s8_pw, str_from("x")), 0, "expr_diff of x^<0> -> 0 (3.4.0: read through the 0 exponent)");
assert_eq(sym_rewrite(0, sym_default_rules()), 0, "sym_rewrite(0, rules) -> 0");
assert_eq(sym_rewrite(_s8_x, 0), 0, "sym_rewrite(x, 0) -> 0");
assert_eq(sym_match(0, _s8_x), 0, "sym_match(0, x) -> 0");
assert_eq(sym_match(pat_wildcard(str_from("a")), 0), 0, "sym_match(a, 0) -> 0");
assert_eq(expr_bind(0, F64_ONE), 0, "expr_bind(0, v) -> 0 (3.4.0: a pair with no name)");
var _s8_vars = vec_new();
var _s8_pair = alloc(16);
store64(_s8_pair, 0);
store64(_s8_pair + 8, F64_TWO);
vec_push(_s8_vars, _s8_pair);
var _s8e1t, _s8e1v = expr_eval_checked(_s8_x, _s8_vars);
assert_eq(_s8e1v, HSB_ERR_INVALID_INPUT,
  "expr_eval_checked: a pair with a 0 name binds nothing (3.4.0: read in str_eq)");
vec_push(_s8_vars, expr_bind(str_from("x"), f64_from(3)));
var _s8e2t, _s8e2v = expr_eval_checked(_s8_x, _s8_vars);
assert_eq(_s8e2v, f64_from(3), "... and the next pair still binds x");

# === 3.4.1: sym_rewrite's rules, work bound and fixpoint ===
# Roadmap [3.4.1] (AU2-G6-F14, F15, AU1 SYM-F5). max_iter bounded passes, not work: a
# self-embedding rule doubled the tree every pass until the recursion overflowed (exit 139);
# a template naming an unbound wildcard made a rule that silently never fired; and a +Inf
# constant read as a change on every pass, so the fixpoint was never reached.
# [measured: scratch probes p2 and p6 on the 3.4.1 baseline and lane, 2026-10-31]
test_group("3.4.1: sym_rewrite's rules, work bound and fixpoint");
var _s9_x = expr_var(str_from("x"));
var _s9_wa = pat_wildcard(str_from("a"));
assert_eq(sym_rule(pat_var(str_from("x")), pat_wildcard(str_from("b"))), 0,
  "sym_rule(var x -> wildcard b): b is unbound, no rule (3.4.0: a rule that never fired)");
assert_eq(sym_rule(pat_sin(_s9_wa), pat_any_const(str_from("c"))), 0,
  "sym_rule: an unbound any-constant name, no rule");
var _s9_cc = pat_any_const(str_from("c"));
assert_eq(sym_rule(pat_add(_s9_wa, _s9_cc), pat_mul(_s9_cc, _s9_wa)) != 0, 1,
  "sym_rule: every template name bound by the pattern, a rule");
var _s9_r0 = vec_new();
vec_push(_s9_r0, sym_rule(pat_var(str_from("x")), pat_wildcard(str_from("b"))));
assert_eq(sym_rewrite(expr_add(_s9_x, _s9_x), _s9_r0), 0,
  "sym_rewrite with a refused rule (a 0 in rules) -> 0 (3.4.0: x + x)");
var _s9_e5 = expr_add(expr_add(_s9_x, expr_neg(_s9_x)), expr_const(F64_POS_INF));
assert_eq(str_eq(expr_to_str(sym_rewrite(_s9_e5, sym_default_rules())), str_from("(0 + inf)")), 1,
  "sym_rewrite((x + -x) + inf) = (0 + inf) (3.4.0: unchanged, 50 passes on the first rule)");
var _s9_e6 = expr_add(expr_add(_s9_x, expr_neg(_s9_x)), expr_const(0x7FF8000000000000));
assert_eq(str_eq(expr_to_str(sym_rewrite(_s9_e6, sym_default_rules())), str_from("(0 + nan)")), 1,
  "sym_rewrite((x + -x) + nan) = (0 + nan)");
# A rule that rebuilds the same tree with a fresh +Inf node is no change either.
var _s9_ri = vec_new();
vec_push(_s9_ri, sym_rule(pat_add(_s9_wa, pat_any_const(str_from("c"))), pat_add(_s9_wa, pat_const(F64_POS_INF))));
var _s9_rdf = sym_default_rules();
for (var i = 0; i < vec_len(_s9_rdf); i = i + 1) { vec_push(_s9_ri, vec_get(_s9_rdf, i)); }
assert_eq(str_eq(expr_to_str(sym_rewrite(_s9_e5, _s9_ri)), str_from("(0 + inf)")), 1,
  "sym_rewrite: {a + c -> a + inf} then the defaults: a fresh +Inf with the same bits is no change, (0 + inf)");
var _s9_ci = expr_const(F64_POS_INF);
var _s9_cn = sym_rewrite(expr_add(_s9_ci, expr_neg(_s9_ci)), sym_default_rules());
assert_eq(str_eq(expr_to_str(_s9_cn), str_from("(inf + -inf)")), 1,
  "sym_rewrite(inf + -inf): unchanged, a + neg(a) does not match a non-finite constant (Inf - Inf is NaN, not 0)");
# 3.4.1 SYM2: the bound is ALLOC_MAX's now (tests/edge_cases.tcyr, group "3.4.1 SYM2: sym_rewrite's
# size bound is ALLOC_MAX"); at the default 2 GiB the doubling rule is refused only after 9 to 10 s,
# so these two run at ALLOC_MAX = 16 MiB.
# [measured: scratch rewrite probe at the default ALLOC_MAX, SYM4 tree, 2026-11-01; cycc 6.7.18]
var _s9_amk = ALLOC_MAX;
var _s9_rd = vec_new();
vec_push(_s9_rd, sym_rule(pat_sin(_s9_wa), pat_sin(pat_sin(_s9_wa))));
var _s9_u0 = alloc_used();
ALLOC_MAX = 0x1000000;
var _s9_rdr = sym_rewrite(expr_sin(_s9_x), _s9_rd);
ALLOC_MAX = _s9_amk;
assert_eq(_s9_rdr, 0,
  "sym_rewrite({sin(a) -> sin(sin(a))}, sin(x)): doubles each pass, refused past ALLOC_MAX = 16 MiB (3.4.0: exit 139)");
assert_eq(alloc_used() - _s9_u0 < 200000000, 1, "... within 200 MB of heap");
var _s9_rw2 = vec_new();
vec_push(_s9_rw2, sym_rule(_s9_wa, pat_add(_s9_wa, _s9_wa)));
var _s9_u2 = alloc_used();
ALLOC_MAX = 0x1000000;
var _s9_rw2r = sym_rewrite(expr_sin(expr_cos(_s9_x)), _s9_rw2);
ALLOC_MAX = _s9_amk;
assert_eq(_s9_rw2r, 0,
  "sym_rewrite({a -> a + a}, sin(cos(x))): a shallow tree tripling each pass, refused past ALLOC_MAX = 16 MiB");
assert_eq(alloc_used() - _s9_u2 < 200000000, 1, "... within 200 MB of heap");
var _s9_rl = vec_new();
vec_push(_s9_rl, sym_rule(pat_var(str_from("x")), pat_sin(pat_var(str_from("x")))));
var _s9_lin = sym_rewrite(_s9_x, _s9_rl);
var _s9_dep = 0;
var _s9_w = _s9_lin;
while (_s9_w != 0 && expr_tag(_s9_w) == EXPR_SIN) { _s9_dep = _s9_dep + 1; _s9_w = expr_child(_s9_w); }
assert_eq(_s9_dep, 50, "sym_rewrite({x -> sin(x)}, x): linear growth stops after max_iter, sin applied 50 times");
assert_eq(str_eq(expr_to_str(_s9_w), str_from("x")), 1, "... over x");
var _s9_ex = expr_add(expr_add(expr_pow(expr_sin(_s9_x), expr_const(F64_TWO)),
    expr_pow(expr_cos(_s9_x), expr_const(F64_TWO))),
  expr_mul(_s9_x, _s9_x));
assert_eq(str_eq(expr_to_str(sym_rewrite(_s9_ex, sym_default_rules())), str_from("(1 + (x^2))")), 1,
  "sym_rewrite(sin^2 x + cos^2 x + x x) = (1 + (x^2)), as before");
var _s9_e1 = expr_add(_s9_x, expr_const(F64_ONE));
assert_eq(sym_rewrite(_s9_e1, sym_default_rules()), _s9_e1, "sym_rewrite: a tree no rule changes comes back itself");
# A pass that changes nothing rebuilds nothing: b + sin(b) nine times over x + 1, a tree
# that no default rule matches (each step doubles its size as a tree and adds two nodes).
var _s9_b = expr_add(_s9_x, expr_const(F64_ONE));
for (var i = 0; i < 9; i = i + 1) { _s9_b = expr_add(_s9_b, expr_sin(_s9_b)); }
var _s9_rules = sym_default_rules();
var _s9_u1 = alloc_used();
var _s9_rb = sym_rewrite(_s9_b, _s9_rules);
assert_eq(alloc_used() - _s9_u1 < 65536, 1,
  "sym_rewrite: a pass over 2,558 nodes that rewrites none allocates no node (3.4.0: every node rebuilt per rule)");
assert_eq(_s9_rb, _s9_b, "... and returns the tree itself");

# === 3.4.1: expr_to_str and sym_to_latex in linear memory ===
# Roadmap [3.4.1] (AU1 SYM-F4). expr_to_str rendered every subtree to a Str of its own and
# copied it into its parent's builder: a 20,000-node sum took 2,404,118,712 bytes of heap
# (2.35 GB peak RSS); one builder now takes 2,229,672. At n = 5,000, the size below, the
# quadratic form needs about 150 MB.
# [measured: scratch memory probe p5 on the 3.4.1 baseline and lane, alloc_used deltas and VmHWM, 2026-10-31]
test_group("3.4.1: expr_to_str and sym_to_latex in linear memory");
var _s10_e = expr_var(str_from("x"));
for (var i = 1; i < 5000; i = i + 1) { _s10_e = expr_add(_s10_e, expr_const(F64_ONE)); }
var _s10_u0 = alloc_used();
var _s10_s = expr_to_str(_s10_e);
var _s10_u1 = alloc_used();
assert_eq(str_len(_s10_s), 6 * 4999 + 1, "expr_to_str(5,000-node sum): the whole text");
assert_eq(_s10_u1 - _s10_u0 < 1048576, 1,
  "expr_to_str(5,000-node sum): under 1 MB of heap (3.4.0's form: about 150 MB)");
var _s10_t = sym_to_latex(_s10_e);
assert_eq(str_len(_s10_t), 4 * 4999 + 1, "sym_to_latex(5,000-node sum): the whole text");
assert_eq(alloc_used() - _s10_u1 < 1048576, 1, "sym_to_latex(5,000-node sum): under 1 MB of heap");

# === 3.4.1: a refused grow is the designed 0, not the stdlib's exit ===
# Roadmap [3.4.1] (the stdlib's abort-on-refusal, NU2 F3). str_builder_add and
# str_builder_putc print to fd 2 and exit(1) when the builder cannot grow; the renderers
# now use the _a forms and answer 0. ALLOC_MAX is lowered so the 88-byte builder is
# granted and its first growth past 64 bytes of text is refused, the call made, ALLOC_MAX
# restored, and only then asserted.
# [measured: scratch probe on the 3.4.1 baseline, 2026-10-31: "str_builder: alloc failed", exit 1]
test_group("3.4.1: a refused grow is the designed 0, not the stdlib's exit");
var _s11_name = str_from("a_variable_name_long_enough_that_its_text_passes_the_builders_first_64_bytes");
var _s11_e = expr_add(expr_var(_s11_name), expr_const(F64_ONE));
var _s11_keep = ALLOC_MAX;
ALLOC_MAX = 127;
var _s11_r1 = expr_to_str(_s11_e);
var _s11_r2 = sym_to_latex(_s11_e);
ALLOC_MAX = _s11_keep;
assert_eq(_s11_r1, 0, "expr_to_str: a refused grow -> 0 (3.4.0: exit 1 inside str_builder_add)");
assert_eq(_s11_r2, 0, "sym_to_latex: a refused grow -> 0 (3.4.0: exit 1 inside str_builder_putc)");
assert_eq(str_len(expr_to_str(_s11_e)), str_len(_s11_name) + 6, "expr_to_str: with the heap open, the whole text");
# The refusal on the text's last byte: "\mathrm{<52 letters>} + " fills the 64-byte buffer, and
# the final x needs the grow.
var _s11_n52 = str_from("abcdefghijklmnopqrstuvwxyzabcdefghijklmnopqrstuvwxyz");
var _s11_e2 = expr_add(expr_var(_s11_n52), expr_var(str_from("x")));
ALLOC_MAX = 127;
var _s11_r3 = sym_to_latex(_s11_e2);
ALLOC_MAX = _s11_keep;
assert_eq(_s11_r3, 0, "sym_to_latex: a refused grow on the last byte -> 0, not the text cut short");
assert_eq(str_len(sym_to_latex(_s11_e2)), 65, "sym_to_latex: with the heap open, the whole 65-byte text");

# === 3.4.0: _numx_dft writes nothing outside its work buffers (m0157) ===
# KEEP THIS GROUP LAST (see the last paragraph).
# 3.3.7's mutation sample left m0157 unpinned: the zero-fill writing `bv + i*16 - 8` for
# `bv + i*16 + 8` stores one word below bv. The code itself writes nothing below either
# buffer (read in 3.4.0: the zero-fill and the chirp's mirror stay in [0, m) slots of each).
# No in-band canary can see the mutant: _numx_dft allocates av and then bv back to back,
# so the word below bv is av's last, a zero the fill writes anyway, and nothing a caller
# allocates can sit between them. It shows only when bv opens a fresh mapping and the word
# below is unmapped, so this group builds that layout. WHAT IT DEPENDS ON:
#   - lib/alloc.cyr's chunk grain, copied here as G = 256 MB (its private `_LINUX_CHUNK`;
#     after a refused mapping the grain is 16 MB, and the sequence still works), and its
#     bump policy: a request the current chunk cannot hold opens a fresh grain-sized chunk,
#     and consecutive allocations are contiguous. So alloc(G - K) opens a chunk with
#     exactly K free;
#   - _numx_dft(data, 3) allocating exactly av and then bv, K = m * 16 = 128 bytes each,
#     and nothing after them (num_fft / num_ifft allocate nothing): av closes that chunk and
#     bv opens the next, and the alloc(8) after the call lands right after bv;
#   - the kernel leaving the word below a fresh anonymous mapping unmapped.
# Each is checked, not assumed: write(2) of a word into a pipe returns -14 (EFAULT) for an
# unmapped one and 8 for a mapped one, so the word below bv must give -14 and the last
# word of the chunk alloc(G - K) opened must give 8. A broken assumption fails these
# assertions; it cannot pass silently. ADDRESS SPACE: two 256 MB chunks (512 MB; 272 MB
# once the grain has fallen to 16 MB) are reserved and never touched. Under
# vm.overcommit_memory 0 or 1 they are MAP_NORESERVE and cost no commit; under 2 they count
# against CommitLimit in full. Under `ulimit -v` the whole suite passes at 560,000 KB and
# fails at 540,000 KB, in this group only (its first draft, with a dry run, failed at
# 1,258,291 KB). KEPT LAST because a refused mapping lowers the process's grain to 16 MB
# for everything that runs after it.
# [measured: scratch mutant m0157 on this tree, hisab.tcyr exit 139 with this group, 2026-10-31]
# [measured: scratch ulimit -v runs of the hisab.tcyr binary, this tree and integ-snap2, 2026-10-31]
# A refused reservation is a loud failure, never a silent pass: at 540,000 KB this group
# fails 8 assertions (the "granted" check, the DFT's Ok and its six values) and the suite
# exits 1. Strict overcommit (mode 2) refuses through the same failed mmap; it was not run
# (setting it needs root), and CI's vm.overcommit_memory is not checked by anything here.
# [measured: scratch ulimit -v 540000 run of the hisab.tcyr binary, lane INS 3.4.1 tree, 2026-10-31; cycc 6.7.18]
test_group("3.4.0: _numx_dft writes nothing outside its work buffers (m0157)");
var _n4_G = 0x10000000;
var _n4_K = 8 * 16;
var _n4_pipe: i64[1];
var _n4_prc = sys_pipe(&_n4_pipe);
var _n4_pw = load32(&_n4_pipe + 4);
var _n4_d = alloc(3 * 16);
store64(_n4_d, 0x3FF3C0CA428C59FB);
store64(_n4_d + 8, 0xBFE5D1D8A3B2C6F1);
store64(_n4_d + 16, 0x400921FB54442D18);
store64(_n4_d + 24, 0x3FD5555555555555);
store64(_n4_d + 32, 0xC00ADF85458A2BB4);
store64(_n4_d + 40, 0x3FB999999999999A);
var _n4_q1 = alloc(_n4_G - _n4_K);
var _n4ft, _n4fv = _numx_dft(_n4_d, 3);
var _n4_w = alloc(8);
assert_eq(_n4_prc, 0, "m0157: the probe pipe opened");
assert_eq(_n4_q1 != 0 && _n4_w != 0, 1, "m0157: the G - K block and the block after the call were granted");
assert_eq(sys_write(_n4_pw, _n4_q1 + _n4_G - 8, 8), 8,
  "m0157: control, the last word of the chunk alloc(G - K) opened (av's last) is mapped");
assert_eq(sys_write(_n4_pw, _n4_w - _n4_K - 8, 8), 0 - 14,
  "m0157: during the call bv began a fresh chunk with nothing mapped below it (EFAULT)");
assert_eq(is_ok(_n4ft), 1, "m0157: the Bluestein DFT of 3 points is Ok");
assert_eq(load64(_n4_d), 0x3FF045B660005CC0, "m0157: X[0].re (60-digit DFT: within 1e-15 relative)");
assert_eq(load64(_n4_d + 8), 0xBFCFCFEB1753A438, "m0157: X[0].im");
assert_eq(load64(_n4_d + 16), 0x3FF8BA04ACCB94C9, "m0157: X[1].re");
assert_eq(load64(_n4_d + 24), 0xC01A1D035896FEBA, "m0157: X[1].im");
assert_eq(load64(_n4_d + 32), 0x3FF242A3BAD91C63, "m0157: X[2].re");
assert_eq(load64(_n4_d + 40), 0x4012ECD173EE9145, "m0157: X[2].im");
sys_close(_n4_pw);
sys_close(load32(&_n4_pipe));

# === 3.4.1 CO3: shapes for the collision groups below ===
# Support functions as the review's harnesses write them (and the counter of their calls):
# a sphere [cx cy cz r], an oriented box [cx cy cz hx hy hz, u0, u1, u2], a z-cylinder
# [cx cy cz r hz].
var _co3_calls = 0;
fn _co3_sph(shape, dir) {
    _co3_calls = _co3_calls + 1;
    var c = hvec3_new(load64(shape), load64(shape + 8), load64(shape + 16));
    return hvec3_add(c, hvec3_scale(hvec3_normalize(dir), load64(shape + 24)));
}
fn _co3_obb(shape, dir) {
    _co3_calls = _co3_calls + 1;
    var acc = hvec3_new(load64(shape), load64(shape + 8), load64(shape + 16));
    for (var oi = 0; oi < 3; oi = oi + 1) {
        var u = hvec3_new(load64(shape + 48 + oi * 24), load64(shape + 56 + oi * 24), load64(shape + 64 + oi * 24));
        var hh = load64(shape + 24 + oi * 8);
        if (f64_lt(hvec3_dot(dir, u), 0) == 1) { hh = f64_neg(hh); }
        acc = hvec3_add(acc, hvec3_scale(u, hh));
    }
    return acc;
}
fn _co3_cyl(shape, dir) {
    _co3_calls = _co3_calls + 1;
    var x = load64(shape);
    var y = load64(shape + 8);
    var dx = HVec3_x(dir);
    var dy = HVec3_y(dir);
    var pl = f64_sqrt(f64_add(f64_mul(dx, dx), f64_mul(dy, dy)));
    if (f64_gt(pl, 0) == 1) {
        var sc = f64_div(load64(shape + 24), pl);
        x = f64_add(x, f64_mul(dx, sc));
        y = f64_add(y, f64_mul(dy, sc));
    }
    var hz = load64(shape + 32);
    if (f64_lt(HVec3_z(dir), 0) == 1) { hz = f64_neg(hz); }
    return hvec3_new(x, y, f64_add(load64(shape + 16), hz));
}
fn _co3_s4(a, b, c, d) {
    var s = alloc(32);
    store64(s, a); store64(s + 8, b); store64(s + 16, c); store64(s + 24, d);
    return s;
}
fn _co3_s5(a, b, c, d, e) {
    var s = alloc(40);
    store64(s, a); store64(s + 8, b); store64(s + 16, c); store64(s + 24, d); store64(s + 32, e);
    return s;
}
fn _co3_s15(p) {
    var s = alloc(120);
    for (var i = 0; i < 15; i = i + 1) { store64(s + i * 8, load64(p + i * 8)); }
    return s;
}
var _co3_n = alloc(8);
var _co3_d = alloc(8);
var _co3_n2 = alloc(8);
var _co3_d2 = alloc(8);
var _co3_t = alloc(8);
# 1 where the two normals are each other's exact negation (every coordinate's bits).
fn _co3_mirror(n1, n2) {
    if (HVec3_x(n1) != (HVec3_x(n2) ^ 0x8000000000000000)) { return 0; }
    if (HVec3_y(n1) != (HVec3_y(n2) ^ 0x8000000000000000)) { return 0; }
    if (HVec3_z(n1) != (HVec3_z(n2) ^ 0x8000000000000000)) { return 0; }
    return 1;
}
fn _co3_cap(shape, dir) {
    _co3_calls = _co3_calls + 1;
    var c = hvec3_new(load64(shape), load64(shape + 8), load64(shape + 16));
    var a = hvec3_new(load64(shape + 24), load64(shape + 32), load64(shape + 40));
    var p = hvec3_add(c, a);
    if (f64_lt(hvec3_dot(dir, a), 0) == 1) { p = hvec3_sub(c, a); }
    return hvec3_add(p, hvec3_scale(hvec3_normalize(dir), load64(shape + 48)));
}

# === 3.4.1 CO3: cga_norm -- a null blade answers on the fast path, as 3.4.0 did ===
# Every non-zero coefficient in [2^-480, 2^508]: each formed term is normal, so the direct form
# is the answer (the term analysis would choose it too). A conformal point is answered there
# again, at 3.4.0's cost; a coefficient below 2^-480 still takes the analysis: 1.5 2^-540 e1,
# whose square is subnormal, is its own norm exactly (a fast path widened to 2^-600: 1 ulp off).
# [measured: lane CO3 cganorm.py and cgnull.py (seeds 1, 2; 9,000 + 20,000 blades), bit for bit 3.4.1-dev; 2026-10-31]
var _co3_k = cga_mv_zero();
cga_mv_set(_co3_k, 1, 0x1E38000000000000);
assert_eq(cga_norm(_co3_k), 0x1E38000000000000, "cga_norm(1.5 2^-540 e1) = 1.5 2^-540 exactly (below the fast path)");
assert_eq(cga_norm(cga_point(F64_ONE, F64_TWO, f64_from(3))), 0, "cga_norm: the exactly null point (1, 2, 3) is 0");
# n0 + 1.5 2^-540 e1: n0 in the window, its partner 0 (no term), the norm² the subnormal
# 2.25 2^-1080: the small coefficient sends it to the analysis, which answers 1.5 2^-540 exactly.
var _co3_k1 = cga_mv_zero();
cga_mv_set(_co3_k1, 4, F64_ONE);
cga_mv_set(_co3_k1, 1, 0x1E38000000000000);
assert_eq(cga_norm(_co3_k1), 0x1E38000000000000, "cga_norm(n0 + 1.5 2^-540 e1) = 1.5 2^-540 (not the fast path)");
var _co3_k2 = cga_mv_zero();
cga_mv_set(_co3_k2, 1, 0x2000000000000000);
assert_eq(cga_norm(_co3_k2), 0x2000000000000000, "cga_norm(2^-511 e1) = 2^-511 (the fast window's other edge)");

# === 3.4.1 CO3: cga_blade_inverse -- B has an inverse exactly where B B~ is not 0 ===
# The exact norm² of the stored coefficients (an integer sum of the pairs' products) decides
# existence, and its correctly rounded value divides. A unit sphere at 19998112 (B B~ = 1
# exactly) is its own inverse; 3.4.0 called it null (its resolution bound) and lane CO's first
# round projected onto it as NaN. Its exact projection of x = cga_point(1, 2, 3) (Fraction,
# review RV-CO S3): e1, n0, ninf = C46B18EDA5209F17, C2E6BBAAA6558CD0, C5E0265755D4A12F.
# [measured: lane CO3 cgainv.py (seeds 1 to 3, 9,000 blades, Fraction inverse) and cgafix.py; 2026-10-31]
var _co3_sb = cga_sphere(0x4173125A00000000, 0, 0, F64_ONE);
var _co3_si = cga_blade_inverse(_co3_sb);
assert_eq(cga_mv_get(_co3_si, 1), 0x4173125A00000000,
  "cga_blade_inverse: the unit sphere at 19998112 is its own inverse (e1)");
assert_eq(cga_mv_get(_co3_si, 5), 0x42E6BBAACC7A3FF0, "cga_blade_inverse: ... (ninf)");
var _co3_px = cga_point(F64_ONE, F64_TWO, f64_from(3));
var _co3_pj = cga_project(_co3_px, _co3_sb);
assert_eq(cga_mv_get(_co3_pj, 1), 0xC46B18EDA5209F17, "cga_project onto it: the exact projection, e1 (3.4.0: 0)");
assert_eq(cga_mv_get(_co3_pj, 4), 0xC2E6BBAAA6558CD0, "cga_project: ... n0");
assert_eq(cga_mv_get(_co3_pj, 5), 0xC5E0265755D4A12F, "cga_project: ... ninf");
# A conformal point with full-mantissa coordinates rounds its q/2: as stored its exact norm²
# is 1.92e-16, and it inverts (the inverse of the stored vector, 0.34 ulp at worst).
# [measured: lane CO3 cgafix.py, Fraction inverse of the stored point; 2026-10-31]
var _co3_fp = cga_blade_inverse(cga_point(0x3FF3A5C91E2B7D41, 0xBFE5E0F1A2B3C4D5, 0x3FE3C2B1A0F9E8D7));
assert_eq(cga_mv_get(_co3_fp, 1), 0x4336BA24C26F6A68, "cga_blade_inverse: a rounded point inverts as stored (e1)");
assert_eq(cga_mv_get(_co3_fp, 4), 0x433281FF96784559, "cga_blade_inverse: ... (n0)");
# A negative norm²: n0 + ninf has B B~ = -2, its inverse -(n0 + ninf) / 2.
var _co3_ng = cga_mv_zero();
cga_mv_set(_co3_ng, 4, F64_ONE);
cga_mv_set(_co3_ng, 5, F64_ONE);
var _co3_ngi = cga_blade_inverse(_co3_ng);
assert_eq(cga_mv_get(_co3_ngi, 4), 0xBFE0000000000000, "cga_blade_inverse(n0 + ninf): norm² -2, n0 = -1/2");
assert_eq(cga_mv_get(_co3_ngi, 5), 0xBFE0000000000000, "cga_blade_inverse(n0 + ninf): ... ninf = -1/2");
# Rounding: e1 + n0 - 2^-54 ninf + 2^-40 e2 has the exact norm² 1 + 2^-53 + 2^-80, which rounds
# up to 1 + 2^-52 (above the tie): e1 of the inverse 1 / (1 + 2^-52). Without the 2^-80 term
# the norm² 1 + 2^-53 is the tie itself, rounded to the even 1: e1 = 1.
var _co3_rt = cga_mv_zero();
cga_mv_set(_co3_rt, 1, F64_ONE);
cga_mv_set(_co3_rt, 2, 0x3D70000000000000);
cga_mv_set(_co3_rt, 4, F64_ONE);
cga_mv_set(_co3_rt, 5, 0xBC90000000000000);
assert_eq(cga_mv_get(cga_blade_inverse(_co3_rt), 1), 0x3FEFFFFFFFFFFFFE,
  "cga_blade_inverse: norm² 1 + 2^-53 + 2^-80 rounds up (e1 = 1 / (1 + 2^-52))");
cga_mv_set(_co3_rt, 2, 0);
assert_eq(cga_mv_get(cga_blade_inverse(_co3_rt), 1), F64_ONE,
  "cga_blade_inverse: norm² 1 + 2^-53, the tie, rounds to even (e1 = 1)");
# A one-step coefficient: 2^-1074 e1 has the exact norm² 2^-2148, and its inverse 2^1074 is +Inf
# (3.4.0 called it null on its rounding).
var _co3_ss = cga_mv_zero();
cga_mv_set(_co3_ss, 1, 1);
assert_eq(cga_mv_get(cga_blade_inverse(_co3_ss), 1), F64_POS_INF,
  "cga_blade_inverse(2^-1074 e1): +Inf (3.4.0: the zero multivector)");
# A subnormal inverse coefficient, rounded once: 2^520 e1 + (3 + 2^-51) e2 has the norm²
# 2^1040 (+ 9.000..., below its ulp), and e2 of the inverse is (3 + 2^-51) 2^-1040, on the
# subnormal grid 3 2^-1040 = 0x0000000C00000000 (one rounding, of the 2^-51).
var _co3_sub = cga_mv_zero();
cga_mv_set(_co3_sub, 1, 0x6070000000000000);
cga_mv_set(_co3_sub, 2, 0x4008000000000001);
var _co3_subi = cga_blade_inverse(_co3_sub);
assert_eq(cga_mv_get(_co3_subi, 2), 0x0000000C00000000,
  "cga_blade_inverse: a subnormal coefficient, 3 2^-1040, rounded once");
assert_eq(cga_mv_get(_co3_subi, 1), 0x1F70000000000000, "cga_blade_inverse: ... and e1 = 2^-520");

# === 3.4.1 CO3: a sphere on a cylinder's side -- the round fit ===
# EPA's answer stood at its certificate on the cylinder's curved side: 2,272 eps deep here
# (3.4.1-dev: 3.81935337e-4, exact 3.8193524044131987e-4 from the centre distance, Decimal). The
# crease is projected off and the sinusoid fitted along the rim (_epa_round_fit): 0.002 eps,
# and the normal at the crease (z within 1e-16). Both orders and both depth entries agree.
# [measured: lane CO3 fixgen.py (cylang seed 1, the worst 3.4.1-dev side pair), exact oracle; 2026-10-31]
var _co3_cy = _co3_s5(0, 0x8000000000000000, 0, 0x3FF19A9788414CA5, 0x3FF49AA5013E4503);
var _co3_cs = _co3_s4(0x3FEE2F87070430F4, 0x3FF834EC4031D56F, 0xBFDDFE6B351D226F, 0x3FE5DB7EB8D0905B);
assert_eq(gjk_epa_3d(&_co3_cyl, _co3_cy, &_co3_sph, _co3_cs, _co3_n, _co3_d), 1,
  "gjk_epa_3d: a sphere into a cylinder's side");
assert_eq(load64(_co3_d), 0x3F3907CF5DEC397E,
  "gjk_epa_3d: ... depth 3.8193524044e-4, 0.002 eps from the exact (3.4.1-dev: 2,272 eps)");
assert_eq(HVec3_x(load64(_co3_n)), 0x3FE0EE3C7CDEE3D3, "gjk_epa_3d: ... normal x (the rim's closed form)");
assert_eq(f64_lt(f64_abs(HVec3_z(load64(_co3_n))), 0x3CB0000000000000), 1,
  "gjk_epa_3d: ... normal z below 2^-52 (the crease)");
assert_eq(gjk_epa_3d(&_co3_sph, _co3_cs, &_co3_cyl, _co3_cy, _co3_n2, _co3_d2), 1, "gjk_epa_3d: ... sphere first");
assert_eq(load64(_co3_d2) == load64(_co3_d) && _co3_mirror(load64(_co3_n), load64(_co3_n2)) == 1, 1,
  "gjk_epa_3d: ... sphere first, the same depth and the normal mirrored");
assert_eq(mpr_penetration(&_co3_sph, _co3_cs, &_co3_cyl, _co3_cy, _co3_n2, _co3_d2), 1,
  "mpr_penetration: ... sphere first");
assert_eq(load64(_co3_d2), 0x3F3907CF5DEC2DDC,
  "mpr_penetration: ... depth 0.0017 eps from the exact (3.4.1-dev: 2,525 eps worst)");

# At 1e3 the fitted normal is lower than EPA's by less than the supports' rounding: the fit's
# closed form is taken at that tie (its h no higher but for the rounding), as the snap's is.
# EPA's normal was 1.6e-7 rad off there, the closed form's is within the 1e-8 the check reads.
# [measured: lane CO3 cylang.py seed 1 (offset 1e3 side pairs), the tie-rule mutant; 2026-10-31]
var _co3_cy3 = _co3_s5(0x408F400000000000, 0xC09F400000000000, 0x407F400000000000, 0x3FE3CF80EEADEB54,
  0x3FF742F0EB9AC36B);
var _co3_cs3 = _co3_s4(0x408F4815FAADFB5E, 0xC09F3C9127D5D546, 0x407F46E4F440F62B, 0x3FE69ED2F7AEAA80);
assert_eq(gjk_epa_3d(&_co3_cyl, _co3_cy3, &_co3_sph, _co3_cs3, _co3_n, _co3_d), 1,
  "gjk_epa_3d: a cylinder side at 1e3");
assert_eq(HVec3_x(load64(_co3_n)), 0x3FE86479DE4645C3, "gjk_epa_3d: ... normal x, the fit's at the tie");
assert_eq(HVec3_y(load64(_co3_n)), 0x3FE4B664E1DB473E, "gjk_epa_3d: ... normal y");

# === 3.4.1 CO3: a tiny ball deep in a box corner -- EPA on the core ===
# CO's F1: a sphere of radius 9.9e-5 whose centre is ~1e-9 inside a box near a corner. The
# corner's cone is flat to the face distances and every box face normal is a local minimum:
# 3.4.0 and lane CO stopped on the second-nearest face, 9.909386929e-5 (81,360 eps). EPA on the
# core (the box, the centre a point, _epa_core_retry): the nearest face, 9.90892445037e-5
# (exact 9.9089244503825614e-5, the face-plane distance in Fractions).
# [measured: lane CO3 f1.py, exact parallelepiped faces; deepc.py seeds 11 to 14 (2,400 answers each); 2026-10-31]
var _co3_f1b = alloc(120);
store64(_co3_f1b, 0); store64(_co3_f1b + 8, 0x8000000000000000); store64(_co3_f1b + 16, 0);
store64(_co3_f1b + 24, 0x3FF02E63E70ED9FC); store64(_co3_f1b + 32, 0x3FF37149707A0324);
store64(_co3_f1b + 40, 0x3FE36A71C237C4FC);
store64(_co3_f1b + 48, 0xBFA98E8F0B92BB00); store64(_co3_f1b + 56, 0xBF855FAC416D90C0);
store64(_co3_f1b + 64, 0xBFEFF55766C5E826);
store64(_co3_f1b + 72, 0x3FEA27270F7DAAAD); store64(_co3_f1b + 80, 0xBFE267EFD5237FFC);
store64(_co3_f1b + 88, 0xBFA1D63AD44FE4C0);
store64(_co3_f1b + 96, 0xBFE25ED3E5BBED54); store64(_co3_f1b + 104, 0xBFEA2CAFDCD7CBBE);
store64(_co3_f1b + 112, 0x3FA3112B87684930);
var _co3_f1s = _co3_s4(0x3FF6454F4A22E606, 0xBFC896BD247BC8EA, 0x3FEE3E1B2D47A7B1, 0x3F19F7367095E2EE);
assert_eq(gjk_epa_3d(&_co3_obb, _co3_f1b, &_co3_sph, _co3_f1s, _co3_n, _co3_d), 1,
  "gjk_epa_3d: CO's F1 pair is a contact");
assert_eq(load64(_co3_d), 0x3F19F9C44213C820,
  "gjk_epa_3d: ... the nearest face, 0.004 eps from the exact (3.4.0: 9.909386929e-5)");
assert_eq(gjk_epa_3d(&_co3_sph, _co3_f1s, &_co3_obb, _co3_f1b, _co3_n2, _co3_d2), 1, "gjk_epa_3d: ... ball first");
assert_eq(load64(_co3_d2) == load64(_co3_d) && _co3_mirror(load64(_co3_n), load64(_co3_n2)) == 1, 1,
  "gjk_epa_3d: ... ball first, the same depth and the normal mirrored");
assert_eq(mpr_penetration(&_co3_sph, _co3_f1s, &_co3_obb, _co3_f1b, _co3_n2, _co3_d2), 1,
  "mpr_penetration: ... ball first");
assert_eq(load64(_co3_d2), 0x3F19F9C44213E000, "mpr_penetration: ... the nearest face, 0.002 eps from the exact");

# A second corner (deepc.py seed 14), its faces 1.7e-11 apart in the centre's distances:
