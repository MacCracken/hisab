var _co3_f2b = alloc(120);
store64(_co3_f2b, 0); store64(_co3_f2b + 8, 0x8000000000000000); store64(_co3_f2b + 16, 0);
store64(_co3_f2b + 24, 0x3FF50BC5A04D23CC); store64(_co3_f2b + 32, 0x3FE5263C09D16532);
store64(_co3_f2b + 40, 0x3FF51259181D1BEC); store64(_co3_f2b + 48, 0xBFD793B8A5690E78);
store64(_co3_f2b + 56, 0xBFC0EE6406B16EF1); store64(_co3_f2b + 64, 0xBFED7261B0F0A53E);
store64(_co3_f2b + 72, 0x3FACF3CE809415B7); store64(_co3_f2b + 80, 0x3FEF83866243ED64);
store64(_co3_f2b + 88, 0xBFC5046EC7B61B73); store64(_co3_f2b + 96, 0x3FEDB1C32D9BDAAC);
store64(_co3_f2b + 104, 0xBFBCCE6D4E399946); store64(_co3_f2b + 112, 0xBFD6BD75E69DC320);
var _co3_f2s = _co3_s4(0x3FFBE792430B9112, 0x3FE5A74E90A67B94, 0x3FE44969F7910EE9, 0x3E9739D5EB48124A);
assert_eq(gjk_epa_3d(&_co3_obb, _co3_f2b, &_co3_sph, _co3_f2s, _co3_n, _co3_d), 1, "gjk_epa_3d: a second deep corner");
