# ~1e-8 — for iterative / decomposition results where exact bit equality is not
# achievable but 8 significant digits is.
var LOOSE_TOL_H = 0x3E45798EE2308C3A;

alloc_init();

# ================================================================
# Vec2
# ================================================================
test_group("hvec2");

var a2 = hvec2_new(f64_from(3), f64_from(4));
assert_eq(f64_to(HVec2_x(a2)), 3, "new.x");
assert_eq(f64_to(HVec2_y(a2)), 4, "new.y");

var b2 = hvec2_new(f64_from(1), f64_from(2));
var c2 = hvec2_add(a2, b2);
assert_eq(f64_to(HVec2_x(c2)), 4, "add.x");
assert_eq(f64_to(HVec2_y(c2)), 6, "add.y");

var dot2 = hvec2_dot(a2, b2);
assert_eq(f64_to(dot2), 11, "dot");
assert_eq(f64_to(hvec2_length(a2)), 5, "length");

# ================================================================
# Vec3
# ================================================================
test_group("hvec3");

var a3 = hvec3_new(f64_from(1), f64_from(2), f64_from(3));
var b3 = hvec3_new(f64_from(4), f64_from(5), f64_from(6));
var c3 = hvec3_add(a3, b3);
assert_eq(f64_to(HVec3_x(c3)), 5, "add.x");
assert_eq(f64_to(HVec3_y(c3)), 7, "add.y");
assert_eq(f64_to(HVec3_z(c3)), 9, "add.z");
assert_eq(f64_to(hvec3_dot(a3, b3)), 32, "dot");

var cr = hvec3_cross(hvec3_unit_x(), hvec3_unit_y());
assert_eq(f64_to(HVec3_z(cr)), 1, "cross.z");

# ================================================================
# Vec4
# ================================================================
test_group("hvec4");

var a4 = hvec4_new(f64_from(1), f64_from(2), f64_from(3), f64_from(4));
var b4 = hvec4_new(f64_from(5), f64_from(6), f64_from(7), f64_from(8));
assert_eq(f64_to(hvec4_dot(a4, b4)), 70, "dot");
assert_eq(f64_to(HVec3_z(hvec4_xyz(a4))), 3, "xyz.z");

# ================================================================
# Quaternion
# ================================================================
test_group("hquat");

var qi = hquat_identity();
assert_eq(f64_to(HQuat_w(qi)), 1, "identity.w");

# q * identity = q
var qr = hquat_from_rotation_z(F64_PI_2);
var qri = hquat_mul(qr, qi);
assert(f64_lt(f64_abs(f64_sub(HQuat_w(qr), HQuat_w(qri))), EPSILON_F64) == 1, "mul identity");

# Rotate (1,0,0) by 90deg around Z → approx (0,1,0)
var rotated = hquat_rotate_vec3(qr, hvec3_unit_x());
assert(f64_lt(f64_abs(HVec3_x(rotated)), f64_from(1)) == 1, "rot90.x near 0");
assert(f64_lt(f64_abs(f64_sub(HVec3_y(rotated), F64_ONE)), f64_from(1)) == 1, "rot90.y near 1");

# ================================================================
# Mat4
# ================================================================
test_group("mat4");

var mi = m4_identity();
var tv = hvec4_new(f64_from(1), f64_from(2), f64_from(3), f64_from(1));
var mr = m4_mul_vec4(mi, tv);
assert_eq(f64_to(HVec4_x(mr)), 1, "I*v.x");
assert_eq(f64_to(HVec4_y(mr)), 2, "I*v.y");

var mii = m4_mul(mi, mi);
assert_eq(f64_to(m4_get(mii, 0, 0)), 1, "I*I[0,0]");
assert_eq(f64_to(m4_get(mii, 0, 1)), 0, "I*I[0,1]");

# SRT translate
var srt = m4_from_srt(hvec3_one(), hquat_identity(), hvec3_new(f64_from(2), f64_from(3), f64_from(4)));
var tp = m4_transform_point(srt, hvec3_zero());
assert_eq(f64_to(HVec3_x(tp)), 2, "srt.x");
assert_eq(f64_to(HVec3_y(tp)), 3, "srt.y");
assert_eq(f64_to(HVec3_z(tp)), 4, "srt.z");

# Inverse: M * M^-1 ≈ I
var inv = m4_inverse(srt);
var prod = m4_mul(srt, inv);
assert(f64_lt(f64_abs(f64_sub(m4_get(prod, 0, 0), F64_ONE)), f64_from(1)) == 1, "inv diag");

# ================================================================
# Transform3D
# ================================================================
test_group("transform3d");

var t = t3d_new(hvec3_new(f64_from(1), f64_from(2), f64_from(3)), hquat_identity(), hvec3_one());
var applied = t3d_apply(t, hvec3_zero());
assert_eq(f64_to(HVec3_x(applied)), 1, "t3d apply.x");
assert_eq(f64_to(HVec3_y(applied)), 2, "t3d apply.y");

# Compose: translate (1,0,0) then translate (0,2,0) = (1,2,0)
var ta = t3d_new(hvec3_new(F64_ONE, 0, 0), hquat_identity(), hvec3_one());
var tb = t3d_new(hvec3_new(0, F64_TWO, 0), hquat_identity(), hvec3_one());
var tc = t3d_compose(ta, tb);
var tcp = t3d_apply(tc, hvec3_zero());
assert_eq(f64_to(HVec3_x(tcp)), 1, "compose.x");
assert_eq(f64_to(HVec3_y(tcp)), 2, "compose.y");

# ================================================================
# Color
# ================================================================
test_group("color");

# sRGB round-trip: linear_to_srgb(srgb_to_linear(0.5)) ≈ 0.5
var half = F64_HALF;
var lin = srgb_to_linear(half);
var back = linear_to_srgb(lin);
assert(f64_lt(f64_abs(f64_sub(back, half)), f64_from(1)) == 1, "srgb roundtrip");

# A round-trip is BLIND to a wrong transfer curve — the same wrong breakpoint is
# applied in both directions and the error cancels. Both sRGB piecewise breakpoints
# were mis-transcribed through 2.6.11 (0.03275 shipped for the spec's 0.04045) and
# the round-trip above stayed green. Pin the absolute value instead:
# srgb_to_linear(0.5) = ((0.5 + 0.055) / 1.055)^2.4 = 0.21404114048223255
var _srgb_half_lin = 0x3FCB65B3392F5354;  # 0.21404114048223255
assert(f64_lt(f64_abs(f64_sub(lin, _srgb_half_lin)), f64_div(F64_ONE, f64_from(100000000))) == 1,
"srgb_to_linear(0.5) == 0.2140411404822 (absolute, not round-trip)");
# Just above the breakpoint the power segment must be in use, just below the linear
# one — this is what actually pins the 0.04045 threshold itself.
assert(f64_lt(srgb_to_linear(f64_div(F64_ONE, f64_from(100))),
f64_div(F64_ONE, f64_from(100))) == 1, "srgb: linear segment below breakpoint");

# Reinhard: 1.0 → 0.5
var tr = tonemap_reinhard(F64_ONE, F64_ONE, F64_ONE);
var trx = f64_to(f64_mul(HVec3_x(tr), f64_from(10)));
assert_eq(trx, 5, "reinhard(1)=0.5");

# Src-over with opaque src → src
var so = composite_src_over(F64_ONE, 0, 0, F64_ONE, 0, F64_ONE, 0, F64_ONE);
assert_eq(f64_to(HVec4_x(so)), 1, "src_over.r");
assert_eq(f64_to(HVec4_y(so)), 0, "src_over.g");

# ================================================================
# Interpolation
# ================================================================
test_group("interpolation");

var l = hisab_lerp(f64_from(0), f64_from(10), F64_HALF);
assert_eq(f64_to(l), 5, "lerp 0.5");

var il = hisab_inverse_lerp(f64_from(0), f64_from(10), f64_from(5));
assert_eq(f64_to(f64_mul(il, f64_from(10))), 5, "inv_lerp");

# ================================================================
# Geo — primitives and intersections
# ================================================================
test_group("geo primitives");

var ray = geo_ray_new(hvec3_zero(), hvec3_unit_z());
var sphere = geo_sphere_new(hvec3_new(0, 0, f64_from(5)), f64_from(1));
var t_hit = geo_ray_sphere(ray, sphere);
# Hit at t=4 (sphere center at z=5, radius=1, so near hit at z=4)
assert_eq(f64_to(t_hit), 4, "ray-sphere t");

var aabb = geo_aabb_new(hvec3_new(f64_neg(F64_ONE), f64_neg(F64_ONE), f64_neg(F64_ONE)),
hvec3_new(F64_ONE, F64_ONE, F64_ONE));
var t_aabb = geo_ray_aabb(geo_ray_new(hvec3_new(0, 0, f64_neg(f64_from(5))), hvec3_unit_z()), aabb);
assert_eq(f64_to(t_aabb), 4, "ray-aabb t");

# AABB-AABB overlap
var aabb2 = geo_aabb_new(hvec3_zero(), hvec3_new(F64_TWO, F64_TWO, F64_TWO));
assert_eq(geo_aabb_aabb(aabb, aabb2), 1, "aabb overlap");

# Sphere-sphere
var s1 = geo_sphere_new(hvec3_zero(), F64_ONE);
var s2 = geo_sphere_new(hvec3_new(F64_ONE, 0, 0), F64_ONE);
assert_eq(geo_sphere_sphere(s1, s2), 1, "sphere overlap");

# Closest point on AABB
var cp = geo_closest_point_on_aabb(aabb, hvec3_new(f64_from(5), 0, 0));
assert_eq(f64_to(HVec3_x(cp)), 1, "closest aabb.x");

# ================================================================
# Advanced geo
# ================================================================
test_group("geo advanced");

# SDF sphere: point at (3,0,0), sphere at origin r=1 → distance = 2
var sdf_p = hvec3_new(f64_from(3), 0, 0);
var sdf_c = hvec3_zero();
var sdf_d = sdf_sphere(sdf_p, sdf_c, F64_ONE);
assert_eq(f64_to(sdf_d), 2, "sdf sphere");

# SDF union: min of two distances
var d1 = f64_from(3);
var d2 = f64_from(5);
assert_eq(f64_to(sdf_union(d1, d2)), 3, "sdf union");
assert_eq(f64_to(sdf_intersection(d1, d2)), 5, "sdf intersection");

# Swept AABB: box at (-1,-1,-1)-(1,1,1), vel=(2,0,0), dt=1 → max.x = 3
var saabb = geo_aabb_new(hvec3_new(f64_neg(F64_ONE), f64_neg(F64_ONE), f64_neg(F64_ONE)),
hvec3_new(F64_ONE, F64_ONE, F64_ONE));
var svel = hvec3_new(F64_TWO, 0, 0);
var swept = swept_aabb(saabb, svel, F64_ONE);
assert_eq(f64_to(HVec3_x(GeoAabb_max(swept))), 3, "swept max.x");

# CGA: point embedding round-trip
var cga_p = cga_point(F64_ONE, F64_TWO, f64_from(3));
# Just check it's non-null (32 components allocated)
assert(cga_p != 0, "cga point alloc");

# CGA contraction operators (2.5.0) — interior products. Left (a |_ b) lowers
# grade(b) by grade(a); right (a _| b) lowers grade(a) by grade(b). Verified
# against GA identities. Blade indices: scalar=0, e1=1, e2=2, e12=6, e23=10.
var cga_e1 = cga_mv_zero();
cga_mv_set(cga_e1, 1, F64_ONE);
var cga_e12 = cga_mv_zero();
cga_mv_set(cga_e12, 6, F64_ONE);

# e1 |_ e12 = e2 (grade 2-1=1); the e1 component is dropped.
var cga_lc = cga_left_contraction(cga_e1, cga_e12);
assert_eq(f64_to(cga_mv_get(cga_lc, 2)), 1, "cga left_contract(e1,e12) = e2");
assert_eq(f64_to(cga_mv_get(cga_lc, 1)), 0, "cga left_contract(e1,e12) has no e1 part");

# e1 |_ e1 = 1 (vector self-contraction -> scalar, e1^2 = +1).
assert_eq(f64_to(cga_mv_get(cga_left_contraction(cga_e1, cga_e1), 0)), 1, "cga left_contract(e1,e1) = 1");

# Orthogonal: e1 |_ e23 = 0 (e1 not contained in e23).
var cga_e23 = cga_mv_zero();
cga_mv_set(cga_e23, 10, F64_ONE);
var cga_orth = cga_left_contraction(cga_e1, cga_e23);
assert_eq(f64_to(f64_mul(cga_norm(cga_orth), f64_from(1000))), 0, "cga left_contract(e1,e23) = 0");

# Vector norm^2 via contraction: (2e1+3e2) |_ self = 4+9 = 13 (scalar).
var cga_v = cga_mv_zero();
cga_mv_set(cga_v, 1, F64_TWO);
cga_mv_set(cga_v, 2, f64_from(3));
assert_eq(f64_to(cga_mv_get(cga_left_contraction(cga_v, cga_v), 0)), 13, "cga (2e1+3e2)|_self = 13");

# Right contraction: e12 _| e1 = -e2 (grade 2-1=1; opposite handedness -> sign).
var cga_rc = cga_right_contraction(cga_e12, cga_e1);
assert_eq(f64_to(cga_mv_get(cga_rc, 2)), (0 - 1), "cga right_contract(e12,e1) = -e2");
assert_eq(f64_to(cga_mv_get(cga_rc, 6)), 0, "cga right_contract(e12,e1) drops grade-2 part");

# Scalar contraction acts as scaling: 2 |_ (5*e12) = 10*e12.
var cga_s = cga_mv_zero();
cga_mv_set(cga_s, 0, F64_TWO);
var cga_5e12 = cga_mv_zero();
cga_mv_set(cga_5e12, 6, f64_from(5));
assert_eq(f64_to(cga_mv_get(cga_left_contraction(cga_s, cga_5e12), 6)), 10, "cga 2|_(5e12) = 10e12");

# CGA dual + pseudoscalar (2.5.1). I = grade-5 blade [31]; in this metric (em^2=-1)
# I^2 = -1 so I_inv = -I. dual(x) = x * I_inv flips grade k -> 5-k; involution
# dual(dual(x)) = -x. Blade indices: scalar=0, e1=1, e23pm=30, pseudoscalar=31.
var cga_ii = cga_geometric_product(cga_pseudoscalar(), cga_pseudoscalar_inv());
assert_eq(f64_to(cga_scalar_part(cga_ii)), 1, "cga I * I_inv = 1");

# dual(scalar 1) = I_inv = -I (grade 0 -> 5).
var cga_one = cga_mv_zero();
cga_mv_set(cga_one, 0, F64_ONE);
assert_eq(f64_to(cga_mv_get(cga_dual(cga_one), 31)), (0 - 1), "cga dual(1) = -I (grade 0->5)");

# dual(I) = 1 (grade 5 -> 0).
assert_eq(f64_to(cga_mv_get(cga_dual(cga_pseudoscalar()), 0)), 1, "cga dual(I) = 1 (grade 5->0)");

# dual(e1) = -e23pm (grade 1 -> 4); no e1 part remains.
var cga_de1 = cga_dual(cga_e1);
assert_eq(f64_to(cga_mv_get(cga_de1, 30)), (0 - 1), "cga dual(e1) = -e23pm (grade 1->4)");
assert_eq(f64_to(cga_mv_get(cga_de1, 1)), 0, "cga dual(e1) leaves no e1 part");

# Involution: dual(dual(e1)) = -e1 in this metric.
assert_eq(f64_to(cga_mv_get(cga_dual(cga_de1), 1)), (0 - 1), "cga dual(dual(e1)) = -e1");

# CGA blade projection / rejection (2.5.2). project(X,B) = (X |_ B) |_ B^-1
# (preserves grade(X)); reject(X,B) = X - project. Blade-inverse guards null blades.
# project(e1, e12) = e1 (e1 lies in the e1-e2 plane); no e2 leaks in.
var cga_pr = cga_project(cga_e1, cga_e12);
assert_eq(f64_to(cga_mv_get(cga_pr, 1)), 1, "cga project(e1,e12) = e1");
assert_eq(f64_to(cga_mv_get(cga_pr, 2)), 0, "cga project(e1,e12) has no e2 part");

# Projection onto self is identity.
assert_eq(f64_to(cga_mv_get(cga_project(cga_e12, cga_e12), 6)), 1, "cga project(e12,e12) = e12");

# Orthogonal: e3 has no e1-e2-plane component -> project = 0, reject = e3.
var cga_e3 = cga_mv_zero();
cga_mv_set(cga_e3, 3, F64_ONE);
var cga_pr3 = cga_project(cga_e3, cga_e12);
assert_eq(f64_to(f64_mul(cga_norm(cga_pr3), f64_from(1000))), 0, "cga project(e3,e12) = 0");
assert_eq(f64_to(cga_mv_get(cga_reject(cga_e3, cga_e12), 3)), 1, "cga reject(e3,e12) = e3");

# In-plane vector rejects to zero.
var cga_rj1 = cga_reject(cga_e1, cga_e12);
assert_eq(f64_to(f64_mul(cga_norm(cga_rj1), f64_from(1000))), 0, "cga reject(e1,e12) = 0");

# Idempotence: projecting twice == projecting once.
var cga_pp = cga_project(cga_project(cga_e1, cga_e12), cga_e12);
assert_eq(f64_to(cga_mv_get(cga_pp, 1)), 1, "cga project idempotent");

# project + reject = X. X = e1 + e3 splits into in-plane e1 and orthogonal e3.
var cga_x = cga_mv_zero();
cga_mv_set(cga_x, 1, F64_ONE);
cga_mv_set(cga_x, 3, F64_ONE);
var cga_sum = cga_mv_add(cga_project(cga_x, cga_e12), cga_reject(cga_x, cga_e12));
assert_eq(f64_to(cga_mv_get(cga_sum, 1)), 1, "cga project+reject = X (e1 part)");
assert_eq(f64_to(cga_mv_get(cga_sum, 3)), 1, "cga project+reject = X (e3 part)");

# Null-blade guard: projecting onto a degenerate (zero) blade returns 0, no trap.
var cga_pnull = cga_project(cga_e1, cga_mv_zero());
assert_eq(f64_to(f64_mul(cga_norm(cga_pnull), f64_from(1000))), 0, "cga project onto null blade = 0");

# ================================================================
# Calc — integration, easing
# ================================================================
test_group("calc");

# Integrate x^2 from 0 to 1 = 1/3
fn _test_x2(x) { return f64_mul(x, x); }
var int_out = alloc(8);
var rc = calc_integral_simpson(&_test_x2, 0, F64_ONE, 100, int_out);
assert_eq(rc, 0, "simpson ok");
# Result should be ~0.333... — multiply by 3 should give ~1
var int_val = load64(int_out);
var int_x3 = f64_to(f64_round(f64_mul(int_val, f64_from(3))));
assert_eq(int_x3, 1, "int x^2 = 1/3");

# Derivative of x^2 at x=3 should be 6
var dv = calc_derivative(&_test_x2, f64_from(3), f64_from(1));
# Use a large h=1 for simplicity — central diff gives (16-4)/2 = 6
assert_eq(f64_to(dv), 6, "deriv x^2 at 3");

# Easing
assert_eq(f64_to(ease_in(0)), 0, "ease_in(0)");
assert_eq(f64_to(ease_in(F64_ONE)), 1, "ease_in(1)");

# Gauss-Legendre on x^2 from 0 to 1
var gl = calc_integral_gauss5(&_test_x2, 0, F64_ONE);
var gl_x3 = f64_to(f64_round(f64_mul(gl, f64_from(3))));
assert_eq(gl_x3, 1, "gauss5 x^2");

# ================================================================
# Num — root finding, number theory, RNG
# ================================================================
test_group("num");

# GCD
assert_eq(num_gcd(12, 8), 4, "gcd(12,8)");
assert_eq(num_gcd(7, 13), 1, "gcd(7,13)");

# Modpow: 2^10 mod 1000 = 1024 mod 1000 = 24
assert_eq(num_modpow(2, 10, 1000), 24, "modpow");

# Primality
assert_eq(num_is_prime(2), 1, "2 prime");
assert_eq(num_is_prime(17), 1, "17 prime");
assert_eq(num_is_prime(15), 0, "15 not prime");
assert_eq(num_is_prime(1), 0, "1 not prime");

# Sieve
var primes = num_sieve(20);
assert_eq(vec_len(primes), 8, "primes<=20 count");
assert_eq(vec_get(primes, 0), 2, "first prime");
assert_eq(vec_get(primes, 7), 19, "8th prime");

# PCG32 RNG — deterministic
var rng = pcg32_new(42);
var r1 = pcg32_next(rng);
var r2 = pcg32_next(rng);
assert(r1 != r2, "rng produces different values");

# Kahan sum
var kdata = alloc(24);
store64(kdata, f64_from(1));
store64(kdata + 8, f64_from(2));
store64(kdata + 16, f64_from(3));
var ks = num_kahan_sum(kdata, 3);
assert_eq(f64_to(ks), 6, "kahan sum");

# Newton-Raphson: find sqrt(2) by solving x^2 - 2 = 0
fn _nr_f(x) { return f64_sub(f64_mul(x, x), F64_TWO); }
fn _nr_df(x) { return f64_mul(F64_TWO, x); }
var nr_out = alloc(8);
var nr_rc = num_newton(&_nr_f, &_nr_df, F64_ONE, EPSILON_F64, 100, nr_out);
assert_eq(nr_rc, 0, "newton ok");
var nr_val = load64(nr_out);
# sqrt(2) ≈ 1.414... — multiply by 1000 and round
var nr_1000 = f64_to(f64_round(f64_mul(nr_val, f64_from(1000))));
assert_eq(nr_1000, 1414, "newton sqrt2");

# ================================================================
# ODE solvers
# ================================================================
test_group("ode");

# DOPRI45: exponential growth dy/dt = y, y(0) = 1
# Use small dt=0.1 for single step accuracy
fn _ode_exp(t, y) { return y; }
var dp_y = alloc(8);
var dp_err = alloc(8);
var _dp_dt = f64_div(F64_ONE, f64_from(10));  # 0.1
ode_dopri45(&_ode_exp, 0, F64_ONE, _dp_dt, dp_y, dp_err);
var dp_val = load64(dp_y);
# VALUE assertion, not a bounds check. Through 2.6.11 the only assertions here
# were `1 < y < 2`, which a *non-consistent* integrator passes: 23 of the 30
# Dormand-Prince tableau constants were mis-transcribed (sum(b) = 0.636, not 1)
# and this test stayed green for six releases. One step of dt=0.1 on y'=y from
# y(0)=1 has the exact value e^0.1; a 5th-order method must hit it to ~1e-9.
assert(f64_gt(dp_val, F64_ONE) == 1, "dopri45 exp grows");
assert(f64_lt(dp_val, F64_TWO) == 1, "dopri45 exp bounded");
var _dp_exact = 0x3FF1AEC7B35A00D4;                       # e^0.1 = 1.1051709180756477
var _dp_err = f64_abs(f64_sub(dp_val, _dp_exact));
assert(f64_lt(_dp_err, f64_div(F64_ONE, f64_from(1000000000))) == 1,
"dopri45: one step of y'=y equals e^0.1 to 1e-9");
# The embedded 4th/5th-order error estimate must be small, not garbage.
assert(f64_lt(f64_abs(load64(dp_err)), f64_div(F64_ONE, f64_from(1000000))) == 1,
"dopri45: embedded error estimate < 1e-6");

# BDF-4 and Yoshida-4 had NO numeric assertions at all through 2.6.11, which is
# why their mis-transcribed coefficient tables shipped. Both are pinned here by
# the consistency invariant the wrong constants violated, not by a bounds check.

# BDF-4 on the constant solution y' = 0, y == 1. The alpha row must sum to 1, so
# a constant history must reproduce itself exactly. Pre-fix, sum(alpha) = 1.01
# and this drifted by 1% per step.
fn _ode_zero(t, y) { return 0; }
var _bdf_hist = vec_new();
vec_push(_bdf_hist, F64_ONE);
vec_push(_bdf_hist, F64_ONE);
vec_push(_bdf_hist, F64_ONE);
vec_push(_bdf_hist, F64_ONE);
var _bdf4 = ode_bdf(&_ode_zero, 0, _bdf_hist, 4, f64_div(F64_ONE, f64_from(10)),
f64_div(F64_ONE, f64_from(1000000000000)));
assert(f64_lt(f64_abs(f64_sub(_bdf4, F64_ONE)), f64_div(F64_ONE, f64_from(100000000))) == 1,
"bdf4: constant solution is reproduced exactly (sum(alpha) == 1)");

# Yoshida-4 on a free particle (accel == 0): the drift coefficients must sum to 1,
# so q advances by exactly v*dt. Pre-fix they summed to 0.859 and it moved 85.9%
# of the correct distance.
fn _ode_free(q) { return 0; }
var _y4 = ode_yoshida4(&_ode_free, 0, F64_ONE, F64_ONE);   # q=0, v=1, dt=1 -> q=1
assert(_y4 != 0, "yoshida4 returns result");
assert(f64_lt(f64_abs(f64_sub(load64(_y4), F64_ONE)), f64_div(F64_ONE, f64_from(100000000))) == 1,
"yoshida4: free particle advances exactly v*dt (sum(c) == 1)");

# Verlet: simple harmonic oscillator q''=-q, start q=1,v=0
# After dt=pi, q should be ≈ -1
fn _ode_sho_accel(q) { return f64_neg(q); }
var vr = ode_verlet(&_ode_sho_accel, F64_ONE, 0, F64_HALF);
# Just check it returned a valid pointer (16 bytes: q, v)
assert(vr != 0, "verlet returns result");

# Symplectic Euler: same SHO
fn _ode_dp_dq(q) { return f64_neg(q); }
fn _ode_dq_dp(p) { return p; }
var se = ode_symplectic_euler(&_ode_dq_dp, &_ode_dp_dq, F64_ONE, 0, F64_HALF);
assert(se != 0, "symplectic euler ok");

# ================================================================
# Optimization
# ================================================================
test_group("optimize");

# Gradient descent: minimize f(x) = x^2, starting at x=5
# Gradient: 2x
fn _opt_f(x_ptr) { var x = load64(x_ptr); return f64_mul(x, x); }
fn _opt_grad(x_ptr, out) { var x = load64(x_ptr); store64(out, f64_mul(F64_TWO, x)); return 0; }
var opt_x0 = alloc(8);
store64(opt_x0, f64_from(5));
var opt_out_x = alloc(8);
var opt_out_f = alloc(8);
var opt_rc = opt_gradient_descent(&_opt_f, &_opt_grad, opt_x0, 1, F64_HALF, EPSILON_F64, 1000, opt_out_x, opt_out_f);
assert_eq(opt_rc, 0, "gd converged");
# Result should be near 0
var opt_result = f64_abs(load64(opt_out_x));
assert(f64_lt(opt_result, F64_ONE) == 1, "gd x near 0");

# ================================================================
# Sparse / SVD / Eigen
# ================================================================
test_group("linalg_ext");

# BiCGSTAB on A x = b with A = [[4,1,0],[1,3,1],[0,1,2]], b = (6,10,8), x = (1,2,3).
# solve_bicgstab had NO test through 2.6.11 and was a complete no-op: its breakdown
# tolerance was written `f64_from(0x3C32725DD1D243AC)`, and f64_from CONVERTS an
# integer rather than reinterpreting bits, so the tolerance was 4.34e18 instead of
# 1e-18 and the first `|rho| < tol` check always fired — the solver returned the
# initial guess verbatim. These assert the SOLUTION, so a no-op cannot pass.
fn _bicg_matvec(xp) {
    var o = alloc(24);
    var bx0 = load64(xp);
    var bx1 = load64(xp + 8);
    var bx2 = load64(xp + 16);
    store64(o, f64_add(f64_mul(f64_from(4), bx0), bx1));
    store64(o + 8, f64_add(f64_add(bx0, f64_mul(f64_from(3), bx1)), bx2));
    store64(o + 16, f64_add(bx1, f64_mul(f64_from(2), bx2)));
    return o;
}
var _bicg_b = alloc(24);
store64(_bicg_b, f64_from(6));
store64(_bicg_b + 8, f64_from(10));
store64(_bicg_b + 16, f64_from(8));
var _bicg_x0 = alloc(24);
store64(_bicg_x0, 0);
store64(_bicg_x0 + 8, 0);
store64(_bicg_x0 + 16, 0);
var _bicg_x = solve_bicgstab(&_bicg_matvec, _bicg_b, _bicg_x0, 3,
f64_div(F64_ONE, f64_from(1000000000)), 100);
assert(_bicg_x != 0, "bicgstab returns a solution");
var _bicg_eps = f64_div(F64_ONE, f64_from(1000000));
assert(f64_lt(f64_abs(f64_sub(load64(_bicg_x), F64_ONE)), _bicg_eps) == 1, "bicgstab x[0] == 1");
assert(f64_lt(f64_abs(f64_sub(load64(_bicg_x + 8), F64_TWO)), _bicg_eps) == 1, "bicgstab x[1] == 2");
assert(f64_lt(f64_abs(f64_sub(load64(_bicg_x + 16), f64_from(3))), _bicg_eps) == 1,
"bicgstab x[2] == 3");

# ================================================================
# linalg_precision — first coverage (module shipped untested through 2.6.12)
# ================================================================
# Both headline routines were broken and neither had a single assertion:
#   svd_golub_kahan composed the left Householder reflectors in FORWARD order,
#     yielding U transposed, so A != U*S*Vt (S and Vt were correct).
#   eigen_qr applied the similarity G^T T G instead of G T G^T — the transpose of
#     the rotation that zeroes the bulge — so it NEVER converged for n >= 3
#     (measured: HSB_ERR_NO_CONVERGENCE on a plain symmetric 3x3 at 100k iters)
#     and paired the wrong eigenvector with each eigenvalue at n = 2.
# These assert the defining identities, so neither failure mode can return.

fn _lp_check_svd(A, m, n, U, S, Vt, label) {
    var bad = 0;
    var i = 0;
    while (i < m) {
        var j = 0;
        while (j < n) {
            var acc = f64_from(0);
            var k = 0;
            while (k < n) {
                acc = f64_add(acc, f64_mul(f64_mul(mat_get(U, i, k), load64(S + k * 8)),
                mat_get(Vt, k, j)));
                k = k + 1;
            }
            if (f64_approx_eq(acc, mat_get(A, i, j), LOOSE_TOL_H) == 0) { bad = bad + 1; }
            j = j + 1;
        }
        i = i + 1;
    }
    assert_eq(bad, 0, label);
    return 0;
}

fn _lp_check_eig(A, n, vals, V, label) {
    var bad = 0;
    var c = 0;
    while (c < n) {
        var lam = load64(vals + c * 8);
        var i = 0;
        while (i < n) {
            var av = f64_from(0);
            var k = 0;
            while (k < n) {
                av = f64_add(av, f64_mul(mat_get(A, i, k), mat_get(V, k, c)));
                k = k + 1;
            }
            if (f64_approx_eq(av, f64_mul(lam, mat_get(V, i, c)), LOOSE_TOL_H) == 0) {
                bad = bad + 1;
            }
            i = i + 1;
        }
        c = c + 1;
    }
    assert_eq(bad, 0, label);
    return 0;
}

test_group("optimize / linalg_ext: allocation and dimension guards");
# opt_bfgs allocates an n x n inverse Hessian; opt_lbfgs an m*(2n+1) history ring.
# Neither bounded its dimensions through 2.6.13, so a large n made alloc return 0
# and the initialisation loop stored through null (CWE-190 -> CWE-476).
assert_eq(opt_bfgs(0, 0, 0, 100000, 0, 10, 0, 0), HSB_ERR_INVALID_INPUT,
"opt_bfgs: n over _OPT_MAX_DIM -> INVALID_INPUT (no null store)");
assert_eq(opt_lbfgs(0, 0, 0, 100000, 5, 0, 10, 0, 0), HSB_ERR_INVALID_INPUT,
"opt_lbfgs: n over _OPT_MAX_DIM -> INVALID_INPUT");
assert_eq(opt_bfgs(0, 0, 0, 0, 0, 10, 0, 0), HSB_ERR_INVALID_INPUT, "opt_bfgs: n=0 -> INVALID_INPUT");
# cmat_inverse builds an augmented [M | I], doubling the width, so an input under
# the cap can push the augmented matrix over it — cmat_new returns 0 and that was
# stored through.
var _ci = cmat_new(250, 250);
assert_neq(_ci, 0, "cmat_new(250,250) = 62500 is under the cap");
assert_eq(cmat_inverse(_ci), 0, "cmat_inverse: augmented 250x500 over cap -> 0 (no segv)");

test_group("linalg_precision: svd_golub_kahan A == U*S*Vt");
var lps_A = mat_new(3, 3);
mat_set(lps_A, 0, 0, F64_ONE);      mat_set(lps_A, 0, 1, F64_TWO);      mat_set(lps_A, 0, 2, f64_from(3));
mat_set(lps_A, 1, 0, f64_from(4));  mat_set(lps_A, 1, 1, f64_from(5));  mat_set(lps_A, 1, 2, f64_from(6));
mat_set(lps_A, 2, 0, f64_from(7));  mat_set(lps_A, 2, 1, f64_from(8));  mat_set(lps_A, 2, 2, f64_from(10));
var lps_U = mat_new(3, 3);
var lps_Vt = mat_new(3, 3);
var lps_S = alloc(24);
assert_eq(svd_golub_kahan(lps_A, lps_U, lps_S, lps_Vt), HSB_ERR_NONE, "svd returns HSB_ERR_NONE");
_lp_check_svd(lps_A, 3, 3, lps_U, lps_S, lps_Vt, "svd: A == U*S*Vt (non-symmetric 3x3)");
assert(f64_ge(load64(lps_S), load64(lps_S + 8)) == 1, "svd: S sorted descending (0>=1)");
assert(f64_ge(load64(lps_S + 8), load64(lps_S + 16)) == 1, "svd: S sorted descending (1>=2)");
assert(f64_ge(load64(lps_S + 16), 0) == 1, "svd: singular values non-negative");

test_group("linalg_precision: eigen_qr A*v == lambda*v");
var lpe_A2 = mat_new(2, 2);
mat_set(lpe_A2, 0, 0, F64_TWO); mat_set(lpe_A2, 0, 1, F64_ONE);
mat_set(lpe_A2, 1, 0, F64_ONE); mat_set(lpe_A2, 1, 1, F64_TWO);
var lpe_v2 = alloc(16);
var lpe_V2 = mat_new(2, 2);
assert_eq(eigen_qr(lpe_A2, 2, 1000, lpe_v2, lpe_V2), HSB_ERR_NONE, "eigen_qr 2x2 converges");
assert(f64_approx_eq(load64(lpe_v2), f64_from(3), LOOSE_TOL_H) == 1, "eigen_qr 2x2 lambda0=3");
assert(f64_approx_eq(load64(lpe_v2 + 8), F64_ONE, LOOSE_TOL_H) == 1, "eigen_qr 2x2 lambda1=1");
_lp_check_eig(lpe_A2, 2, lpe_v2, lpe_V2, "eigen_qr 2x2: A*v == lambda*v (pairing)");

var lpe_A3 = mat_new(3, 3);
mat_set(lpe_A3, 0, 0, f64_from(4)); mat_set(lpe_A3, 0, 1, F64_ONE);     mat_set(lpe_A3, 0, 2, 0);
mat_set(lpe_A3, 1, 0, F64_ONE);     mat_set(lpe_A3, 1, 1, f64_from(3)); mat_set(lpe_A3, 1, 2, F64_ONE);
mat_set(lpe_A3, 2, 0, 0);           mat_set(lpe_A3, 2, 1, F64_ONE);     mat_set(lpe_A3, 2, 2, F64_TWO);
var lpe_v3 = alloc(24);
var lpe_V3 = mat_new(3, 3);
assert_eq(eigen_qr(lpe_A3, 3, 10000, lpe_v3, lpe_V3), HSB_ERR_NONE,
"eigen_qr 3x3 CONVERGES (was NO_CONVERGENCE at any iteration count)");
# 2 + 2*cos(pi/4) = 4.732050807568877, 3, 2 - 2*cos(pi/4) = 1.2679491924311228
assert(f64_approx_eq(load64(lpe_v3), 0x4012ED9EBA16132A, LOOSE_TOL_H) == 1,
"eigen_qr 3x3 lambda0 = 4.732050807568877");
assert(f64_approx_eq(load64(lpe_v3 + 8), f64_from(3), LOOSE_TOL_H) == 1, "eigen_qr 3x3 lambda1 = 3");
assert(f64_approx_eq(load64(lpe_v3 + 16), 0x3FF4498517A7B356, LOOSE_TOL_H) == 1,
"eigen_qr 3x3 lambda2 = 1.2679491924311228");
_lp_check_eig(lpe_A3, 3, lpe_v3, lpe_V3, "eigen_qr 3x3: A*v == lambda*v");

# Inertia sphere: I = (2/5)*m*r^2 on diagonal
var isph = inertia_sphere(f64_from(10), F64_ONE);
# I = (2/5)*10*1 = 4
assert_eq(f64_to(mat_get(isph, 0, 0)), 4, "inertia sphere diag");
assert_eq(f64_to(mat_get(isph, 0, 1)), 0, "inertia sphere off-diag");

# Eigen power: dominant eigenvalue of [[2,0],[0,1]] = 2
var epm = mat_new(2, 2);
mat_set(epm, 0, 0, f64_from(2));
mat_set(epm, 1, 1, F64_ONE);
var ep_val = alloc(8);
var ep_vec = alloc(16);
var ep_rc = eigen_power(epm, 2, 1000, ep_val, ep_vec);
assert_eq(ep_rc, 0, "eigen_power ok");
assert_eq(f64_to(f64_round(load64(ep_val))), 2, "eigen_power val=2");

# PGS: solve [[4,1],[1,3]]*x = [1,2] with no bounds
var pgs_A = mat_new(2, 2);
mat_set(pgs_A, 0, 0, f64_from(4)); mat_set(pgs_A, 0, 1, F64_ONE);
mat_set(pgs_A, 1, 0, F64_ONE); mat_set(pgs_A, 1, 1, f64_from(3));
var pgs_b = alloc(16);
store64(pgs_b, F64_ONE); store64(pgs_b + 8, F64_TWO);
var pgs_x = alloc(16);
store64(pgs_x, 0); store64(pgs_x + 8, 0);
var big = f64_from(1000000);
var pgs_lo = alloc(16); store64(pgs_lo, f64_neg(big)); store64(pgs_lo + 8, f64_neg(big));
var pgs_hi = alloc(16); store64(pgs_hi, big); store64(pgs_hi + 8, big);
solve_pgs(pgs_A, pgs_b, pgs_x, 2, pgs_lo, pgs_hi, 100);
# Exact solution of [[4,1],[1,3]]x=[1,2]: x = [1/11, 7/11] ≈ [0.0909, 0.6364].
assert_eq(f64_to(f64_mul(load64(pgs_x), f64_from(1000))), 90, "pgs x0 ≈ 0.0909 (1/11)");
assert_eq(f64_to(f64_mul(load64(pgs_x + 8), f64_from(1000))), 636, "pgs x1 ≈ 0.6364 (7/11)");

# Bounds-active LCP: diag(1,1)·x = [5,5] clamped to hi=[2,2] → x = [2,2].
var pgs2_A = mat_new(2, 2);
mat_set(pgs2_A, 0, 0, F64_ONE);
mat_set(pgs2_A, 1, 1, F64_ONE);
var pgs2_b = alloc(16);
store64(pgs2_b, f64_from(5));
store64(pgs2_b + 8, f64_from(5));
var pgs2_x = alloc(16);
store64(pgs2_x, 0);
store64(pgs2_x + 8, 0);
var pgs2_lo = alloc(16);
store64(pgs2_lo, 0);
store64(pgs2_lo + 8, 0);
var pgs2_hi = alloc(16);
store64(pgs2_hi, F64_TWO);
store64(pgs2_hi + 8, F64_TWO);
solve_pgs(pgs2_A, pgs2_b, pgs2_x, 2, pgs2_lo, pgs2_hi, 100);
assert_eq(f64_to(load64(pgs2_x)), 2, "pgs bounded x0 clamped to hi=2");
assert_eq(f64_to(load64(pgs2_x + 8)), 2, "pgs bounded x1 clamped to hi=2");

# mat_new_guarded (2.5.3) — CWE-190 overflow guard for the real-matrix constructor.
# Stdlib mat_new gained its own guard upstream in ganita 1.0.4 (cyrius 6.5.6 pin,
# hisab 2.6.11) at a 33,554,430-element ceiling; this wrapper is retained because it
# enforces the tighter 16M cap, which is what the over-cap assertion below pins —
# mat_new_guarded(5000, 5000) is 25M elements: rejected here, accepted upstream.
# The upstream contract itself is pinned in tests/edge_cases.tcyr.
assert_eq(mat_new_guarded(100000, 100000), 0, "mat_new_guarded: huge dims rejected (overflow)");
assert_eq(mat_new_guarded(0, 5), 0, "mat_new_guarded: non-positive rows rejected");
assert_eq(mat_new_guarded(5000, 5000), 0, "mat_new_guarded: over-cap (25M elems) rejected");
assert_neq(mat_new_guarded(3, 3), 0, "mat_new_guarded: valid dims allocate");

# ================================================================
# Complex
# ================================================================
test_group("complex");

var ca = cx_new(f64_from(3), f64_from(4));
assert_eq(f64_to(cx_abs(ca)), 5, "abs(3+4i)");

var cb = cx_new(f64_from(1), f64_from(2));
var cc = cx_mul(ca, cb);
# (3+4i)(1+2i) = 3+6i+4i+8i² = 3+10i-8 = -5+10i
assert_eq(f64_to(HComplex_re(cc)), (0 - 5), "mul.re");
assert_eq(f64_to(HComplex_im(cc)), 10, "mul.im");

var cconj = cx_conj(ca);
assert_eq(f64_to(HComplex_im(cconj)), (0 - 4), "conj.im");

# e^(iπ) + 1 ≈ 0
var eipi = cx_exp(cx_new(0, F64_PI));
var euler = cx_add(eipi, cx_one());
assert(f64_lt(cx_abs(euler), f64_from(1)) == 1, "euler identity");

# Pauli: σx² = I
var sx = pauli_x();
var sx2 = cmat_mul(sx, sx);
var tr_sx2 = cmat_trace(sx2);
assert_eq(f64_to(HComplex_re(tr_sx2)), 2, "pauli_x^2 trace");

# Commutator [σx, σy] = 2iσz
var sy = pauli_y();
var comm = cmat_commutator(sx, sy);
# [σx,σy](0,0) should be 2i
var c00 = cmat_get(comm, 0, 0);
assert_eq(f64_to(HComplex_im(c00)), 2, "[sx,sy]_00.im");

# ================================================================
# Lie groups
# ================================================================
test_group("lie groups");

# U(1): compose = add phases
var u_a = u1_new(F64_PI_4);
var u_b = u1_new(F64_PI_4);
var u_c = u1_compose(u_a, u_b);
# pi/4 + pi/4 = pi/2
var u_phase = f64_to(f64_round(f64_mul(load64(u_c), f64_from(1000))));
var pi2_1000 = f64_to(f64_round(f64_mul(F64_PI_2, f64_from(1000))));
assert_eq(u_phase, pi2_1000, "u1 compose");

# U(1) inverse: phase + (-phase) = 0
var u_inv = u1_inv(u_a);
var u_id = u1_compose(u_a, u_inv);
assert(f64_lt(f64_abs(load64(u_id)), f64_from(1)) == 1, "u1 inv");

# SU(2): identity to quat → w=1
var su2_id = su2_identity();
var su2_q = su2_to_quat(su2_id);
assert_eq(f64_to(HQuat_w(su2_q)), 1, "su2 id.w");

# Lorentz: identity transforms (t,0,0,0) → (t,0,0,0)
var lor_id = lorentz_identity();
var tv4 = alloc(32);
store64(tv4, F64_ONE); store64(tv4 + 8, 0); store64(tv4 + 16, 0); store64(tv4 + 24, 0);
var tv4_out = lorentz_transform_4vec(lor_id, tv4);
assert_eq(f64_to(load64(tv4_out)), 1, "lorentz id t");

# Minkowski interval for timelike vector (1,0,0,0) = +1
var mink = minkowski_interval(tv4);
assert_eq(f64_to(mink), 1, "minkowski timelike");

# Gell-Mann: λ₁ trace = 0 (traceless generators)
var gm1 = gell_mann(0);
var gm1_tr = cmat_trace(gm1);
assert_eq(f64_to(HComplex_re(gm1_tr)), 0, "gm1 traceless");

# ================================================================
# Differential geometry
# ================================================================

# Helpers for the curvature tests: identity metric, constant-curvature space-form
# Riemann (g=I, K0=1: R^ρ_{σμν} = δ^ρ_μ δ_{σν} − δ^ρ_ν δ_{σμ}), max |component|,
# and the g^{ρμ}-trace of a Weyl tensor (g=I → Σ_ρ C_{ρσρν}).
fn _dg_e4(k) {
    var v = alloc(32);
    var i = 0;
    while (i < 4) { store64(v + i * 8, 0); i = i + 1; }
    store64(v + k * 8, F64_ONE);
    return v;
}
fn _dg_id(dim) {
    var g = alloc(dim * dim * 8);
    var i = 0;
    while (i < dim) {
        var j = 0;
        while (j < dim) {
            var v = 0;
            if (i == j) { v = F64_ONE; }
            store64(g + _dg_idx2(i, j, dim), v);
            j = j + 1;
        }
        i = i + 1;
    }
    return g;
}
fn _dg_spaceform(dim) {
    var n4 = dim * dim * dim * dim;
    var r = alloc(n4 * 8);
    var rho = 0;
    while (rho < dim) {
        var s = 0;
        while (s < dim) {
            var m = 0;
            while (m < dim) {
                var n = 0;
                while (n < dim) {
                    var t1 = 0;
                    if (rho == m) { if (s == n) { t1 = 1; } }
                    var t2 = 0;
                    if (rho == n) { if (s == m) { t2 = 1; } }
                    store64(r + _dg_idx4(rho, s, m, n, dim), f64_from(t1 - t2));
                    n = n + 1;
                }
                m = m + 1;
            }
            s = s + 1;
        }
        rho = rho + 1;
    }
    return r;
}
fn _dg_maxabs(w, dim) {
    var mx = 0;
    var n4 = dim * dim * dim * dim;
    var i = 0;
    while (i < n4) {
        var a = f64_abs(load64(w + i * 8));
        if (f64_lt(mx, a) == 1) { mx = a; }
        i = i + 1;
    }
    return mx;
}
fn _dg_weyl_trace(w, dim) {
    var mx = 0;
    var s = 0;
    while (s < dim) {
        var n = 0;
        while (n < dim) {
            var t = 0;
            var rho = 0;
            while (rho < dim) {
                t = f64_add(t, weyl_get(w, dim, rho, s, rho, n));
                rho = rho + 1;
            }
            var a = f64_abs(t);
            if (f64_lt(mx, a) == 1) { mx = a; }
            n = n + 1;
        }
        s = s + 1;
    }
    return mx;
}

test_group("diffgeo");

# Flat 2D Euclidean: metric = diag(1,1), all Christoffels = 0
var flat_metric_inv = alloc(32);
store64(flat_metric_inv, F64_ONE); store64(flat_metric_inv + 8, 0);
store64(flat_metric_inv + 16, 0); store64(flat_metric_inv + 24, F64_ONE);
# All metric derivatives = 0
var flat_deriv = alloc(64);
var _di = 0;
while (_di < 8) { store64(flat_deriv + _di * 8, 0); _di = _di + 1; }
var flat_chris = christoffel_symbols(flat_metric_inv, flat_deriv, 2);
assert_eq(f64_to(christoffel_get(flat_chris, 2, 0, 0, 0)), 0, "flat Gamma=0");
assert_eq(f64_to(christoffel_get(flat_chris, 2, 1, 0, 1)), 0, "flat Gamma=0 b");

# Wedge: α∧β where α=(1,0), β=(0,1) in 2D → 1-component 2-form = 1
var alpha = alloc(16);
store64(alpha, F64_ONE); store64(alpha + 8, 0);
var beta = alloc(16);
store64(beta, 0); store64(beta + 8, F64_ONE);
var w11 = wedge_1_1(alpha, beta, 2);
assert_eq(f64_to(load64(w11)), 1, "wedge e1^e2");

# Sectional curvature (2.6.0). K(u,v) from the (1,3) Riemann + metric; positive
# for a sphere (verified vs hisab's Riemann convention). Constant-curvature
# 2-space (any plane gives K0); (1,3) components: R^0_101=1, R^0_110=-1,
# R^1_010=1, R^1_001=-1.
var sc_rie = alloc(128);
var _sci = 0;
while (_sci < 16) { store64(sc_rie + _sci * 8, 0); _sci = _sci + 1; }
store64(sc_rie + _dg_idx4(0, 1, 0, 1, 2), F64_ONE);
store64(sc_rie + _dg_idx4(0, 1, 1, 0, 2), f64_neg(F64_ONE));
store64(sc_rie + _dg_idx4(1, 0, 1, 0, 2), F64_ONE);
store64(sc_rie + _dg_idx4(1, 0, 0, 1, 2), f64_neg(F64_ONE));
var sc_id = alloc(32);
store64(sc_id, F64_ONE); store64(sc_id + 8, 0); store64(sc_id + 16, 0); store64(sc_id + 24, F64_ONE);
var sc_e0 = alloc(16); store64(sc_e0, F64_ONE); store64(sc_e0 + 8, 0);
var sc_e1 = alloc(16); store64(sc_e1, 0); store64(sc_e1 + 8, F64_ONE);

# Unit-curvature space form → K = 1 for any plane (axis-aligned and skew).
assert_eq(f64_to(sectional_curvature(sc_rie, sc_id, sc_e0, sc_e1, 2)), 1, "sectional: unit space form = 1");
var sc_us = alloc(16); store64(sc_us, F64_ONE); store64(sc_us + 8, F64_ONE);
var sc_vs = alloc(16); store64(sc_vs, F64_ONE); store64(sc_vs + 8, f64_neg(F64_ONE));
assert_eq(f64_to(sectional_curvature(sc_rie, sc_id, sc_us, sc_vs, 2)), 1, "sectional: plane-independent (skew) = 1");

# Radius-2 sphere: same (1,3) Riemann, metric = diag(r²) = diag(4,4) → K = 1/r² = 1/4.
var sc_g4 = alloc(32);
store64(sc_g4, f64_from(4)); store64(sc_g4 + 8, 0); store64(sc_g4 + 16, 0); store64(sc_g4 + 24, f64_from(4));
var sc_k4 = sectional_curvature(sc_rie, sc_g4, sc_e0, sc_e1, 2);
assert_eq(f64_to(f64_mul(sc_k4, f64_from(100))), 25, "sectional: radius-2 sphere = 1/4");

# Flat space (zero Riemann) → K = 0.
var sc_flat = alloc(128);
var _scf = 0;
while (_scf < 16) { store64(sc_flat + _scf * 8, 0); _scf = _scf + 1; }
assert_eq(f64_to(sectional_curvature(sc_flat, sc_id, sc_e0, sc_e1, 2)), 0, "sectional: flat = 0");

# Degenerate plane (u ∥ v) → 0 (denominator guard, no div-by-zero).
var sc_par = alloc(16); store64(sc_par, F64_TWO); store64(sc_par + 8, 0);
assert_eq(f64_to(sectional_curvature(sc_rie, sc_id, sc_e0, sc_par, 2)), 0, "sectional: degenerate plane = 0");

# Weyl conformal-curvature tensor (2.6.1). Trace-free part of Riemann; vanishes
# for n ≤ 3 and for conformally-flat metrics (constant-curvature space forms),
# even where Riemann ≠ 0. Build space forms, compute Ricci/scalar from them.

# 3D space form → Weyl ≡ 0 (Riemann and Ricci are nonzero, but C vanishes).
var wl3_r = _dg_spaceform(3);
var wl3_g = _dg_id(3);
var wl3_ric = ricci_tensor(wl3_r, 3);
var wl3_sc = ricci_scalar(wl3_ric, wl3_g, 3);
var wl3_c = weyl_tensor(wl3_r, wl3_ric, wl3_sc, wl3_g, 3);
assert_eq(f64_to(f64_mul(_dg_maxabs(wl3_c, 3), f64_from(1000000))), 0, "weyl: 3D space form = 0");

# 4D space form (conformally flat) → Weyl ≡ 0 with Riemann ≠ 0 — the key oracle.
var wl4_r = _dg_spaceform(4);
var wl4_g = _dg_id(4);
var wl4_ric = ricci_tensor(wl4_r, 4);
var wl4_sc = ricci_scalar(wl4_ric, wl4_g, 4);
assert_neq(f64_to(f64_mul(_dg_maxabs(wl4_r, 4), f64_from(1000))), 0, "weyl: 4D space form has nonzero Riemann");
var wl4_c = weyl_tensor(wl4_r, wl4_ric, wl4_sc, wl4_g, 4);
assert_eq(f64_to(f64_mul(_dg_maxabs(wl4_c, 4), f64_from(1000000))), 0, "weyl: 4D space form = 0 (conformally flat)");

# Non-space-form 4D (only the e0-e1 plane curved): Weyl ≠ 0 and trace-free.
var wl_nr = alloc(2048);
var _wli = 0;
while (_wli < 256) { store64(wl_nr + _wli * 8, 0); _wli = _wli + 1; }
store64(wl_nr + _dg_idx4(0, 1, 0, 1, 4), F64_ONE);
store64(wl_nr + _dg_idx4(0, 1, 1, 0, 4), f64_neg(F64_ONE));
store64(wl_nr + _dg_idx4(1, 0, 1, 0, 4), F64_ONE);
store64(wl_nr + _dg_idx4(1, 0, 0, 1, 4), f64_neg(F64_ONE));
var wl_ng = _dg_id(4);
var wl_nric = ricci_tensor(wl_nr, 4);
var wl_nsc = ricci_scalar(wl_nric, wl_ng, 4);
var wl_nc = weyl_tensor(wl_nr, wl_nric, wl_nsc, wl_ng, 4);
assert_neq(f64_to(f64_mul(_dg_maxabs(wl_nc, 4), f64_from(1000))), 0, "weyl: non-space-form is nonzero");
assert_eq(f64_to(f64_mul(_dg_weyl_trace(wl_nc, 4), f64_from(1000000))), 0, "weyl: trace-free (g^pm C = 0)");

# Parallel transport (2.6.2). dV^a/dt = −Γ^a_{μν} V^μ ẋ^ν along a curve (RK4).
# Flat space (Γ=0): transport leaves the vector unchanged.
var pt_ch0 = alloc(64);
var _pti = 0;
while (_pti < 8) { store64(pt_ch0 + _pti * 8, 0); _pti = _pti + 1; }
var pt_v = alloc(16); store64(pt_v, F64_ONE); store64(pt_v + 8, F64_TWO);
var pt_cv = alloc(16); store64(pt_cv, F64_ONE); store64(pt_cv + 8, F64_ONE);
var pt_flat = parallel_transport(pt_v, pt_cv, pt_ch0, 2, F64_HALF, 10);
assert_eq(f64_to(load64(pt_flat)), 1, "transport: flat leaves V^0 = 1");
assert_eq(f64_to(load64(pt_flat + 8)), 2, "transport: flat leaves V^1 = 2");

# Unit-sphere latitude circle at θ=π/4: Γ^θ_φφ=−1/2, Γ^φ_θφ=Γ^φ_φθ=1, metric
# diag(1, sin²θ)=diag(1,1/2). Transport V=(1,0) along φ. Metric-compatible →
# ⟨V,V⟩ preserved (=1) and the vector genuinely rotates (V^θ moves off 1).
var pt_sch = alloc(64);
_pti = 0;
while (_pti < 8) { store64(pt_sch + _pti * 8, 0); _pti = _pti + 1; }
store64(pt_sch + _dg_idx3(0, 1, 1, 2), f64_neg(F64_HALF));
store64(pt_sch + _dg_idx3(1, 0, 1, 2), F64_ONE);
store64(pt_sch + _dg_idx3(1, 1, 0, 2), F64_ONE);
var pt_sv = alloc(16); store64(pt_sv, F64_ONE); store64(pt_sv + 8, 0);
var pt_scv = alloc(16); store64(pt_scv, 0); store64(pt_scv + 8, F64_ONE);
var pt_dt = f64_div(F64_ONE, f64_from(100));
var pt_st = parallel_transport(pt_sv, pt_scv, pt_sch, 2, pt_dt, 100);
var pt_g = alloc(32);
store64(pt_g, F64_ONE); store64(pt_g + 8, 0); store64(pt_g + 16, 0); store64(pt_g + 24, F64_HALF);
var pt_len2 = _dg_inner(pt_g, pt_st, pt_st, 2);
var pt_tol = f64_div(F64_ONE, f64_from(100));
assert(f64_lt(f64_abs(f64_sub(pt_len2, F64_ONE)), pt_tol) == 1, "transport: sphere preserves length");
assert(f64_lt(f64_abs(f64_sub(load64(pt_st), F64_ONE)), pt_tol) == 0, "transport: sphere rotates the vector");

# Geodesic deviation / Jacobi (2.6.3). D²J/dτ² = −R^ρ_{σμν} u^σ J^μ u^ν. Reuses
# the unit-sphere space form sc_rie + tangents from the sectional block.
# Separation ⊥ tangent → J'' = −J (geodesics converge); ∥ tangent → 0.
var gd_perp = geodesic_deviation(sc_rie, sc_e0, sc_e1, 2);
assert_eq(f64_to(load64(gd_perp + 8)), (0 - 1), "deviation: J perp u gives J'' = -J (sphere)");
assert_eq(f64_to(load64(gd_perp)), 0, "deviation: J perp u has no parallel part");

# Separation parallel to the tangent (sc_par = (2,0) ∥ e0) → no tidal force.
var gd_par = geodesic_deviation(sc_rie, sc_e0, sc_par, 2);
assert_eq(f64_to(load64(gd_par)), 0, "deviation: J parallel u gives 0 (A^0)");
assert_eq(f64_to(load64(gd_par + 8)), 0, "deviation: J parallel u gives 0 (A^1)");

# Flat space → no tidal acceleration.
var gd_flat = geodesic_deviation(sc_flat, sc_e0, sc_e1, 2);
assert_eq(f64_to(load64(gd_flat + 8)), 0, "deviation: flat -> 0");

# Linear in J: doubling the separation doubles the tidal acceleration.
var gd_2j = alloc(16);
store64(gd_2j, 0);
store64(gd_2j + 8, F64_TWO);
assert_eq(f64_to(load64(geodesic_deviation(sc_rie, sc_e0, gd_2j, 2) + 8)), (0 - 2), "deviation: linear in J");

# Higher-order differential forms (2.6.4). Chain wedge_1_1 → wedge_2_1 → wedge_3_1
# to build the basis k-forms in 4D (reduced strictly-increasing basis).
# e0∧e1∧e2∧e3 = the unit 4-form.
var wf_2 = wedge_1_1(_dg_e4(0), _dg_e4(1), 4);
var wf_3 = wedge_2_1(wf_2, _dg_e4(2));
assert_eq(f64_to(load64(wf_3)), 1, "forms: e0^e1^e2 = (012) basis 3-form");
var wf_4 = wedge_3_1(wf_3, _dg_e4(3));
assert_eq(f64_to(load64(wf_4)), 1, "forms: e0^e1^e2^e3 = unit 4-form");

# Antisymmetry of the 1∧1 wedge and the nilpotence α∧α = 0.
assert_eq(f64_to(load64(wedge_1_1(_dg_e4(1), _dg_e4(0), 4))), (0 - 1), "forms: e1^e0 = -(e0^e1)");
assert_eq(f64_to(load64(wedge_1_1(_dg_e4(0), _dg_e4(0), 4))), 0, "forms: e0^e0 = 0");

# Permutation sign: swapping two factors flips the form — e0∧e2∧e1 = −(e0∧e1∧e2).
var wf_021 = wedge_2_1(wedge_1_1(_dg_e4(0), _dg_e4(2), 4), _dg_e4(1));
assert_eq(f64_to(load64(wf_021)), (0 - 1), "forms: e0^e2^e1 = -(012)");

# Repeated factor → 0 (e0∧e1∧e0 has no independent 3-form component).
var wf_rep = wedge_2_1(wedge_1_1(_dg_e4(0), _dg_e4(1), 4), _dg_e4(0));
assert_eq(f64_to(load64(wf_rep)), 0, "forms: e0^e1^e0 = 0 (012 part)");
assert_eq(f64_to(load64(wf_rep + 24)), 0, "forms: e0^e1^e0 = 0 (123 part)");

# 4-form sign: e1∧e2∧e3∧e0 is an odd permutation of (0123) → −1.
var wf_1230 = wedge_3_1(wedge_2_1(wedge_1_1(_dg_e4(1), _dg_e4(2), 4), _dg_e4(3)), _dg_e4(0));
assert_eq(f64_to(load64(wf_1230)), (0 - 1), "forms: e1^e2^e3^e0 = -(0123)");

# ================================================================
# Symbolic
# ================================================================
test_group("symbolic");

# Build x^2 + 3 and evaluate at x=2 → 7
var symx = expr_var(str_from("x"));
var symx2 = expr_mul(symx, symx);
var s3 = expr_const(f64_from(3));
var sexpr = expr_add(symx2, s3);
var bindings = vec_new();
vec_push(bindings, expr_bind(str_from("x"), f64_from(2)));
var sval = expr_eval(sexpr, bindings);
assert_eq(f64_to(sval), 7, "eval x^2+3 at 2");

# Differentiate x^2 w.r.t x → should simplify to 2*x
var sd = expr_diff(sexpr, str_from("x"));
var sd_simple = expr_simplify(sd);
# Evaluate derivative at x=2 → should be 4
var dval = expr_eval(sd_simple, bindings);
assert_eq(f64_to(dval), 4, "diff x^2+3 at 2");

# Simplify: 0 + x = x, 1 * x = x
var s_zero_plus = expr_add(expr_const(0), symx);
var s_simp = expr_simplify(s_zero_plus);
assert_eq(expr_tag(s_simp), EXPR_VAR, "0+x simplifies to var");

# To string for constant
var s_str = expr_to_str(expr_const(f64_from(42)));
assert(str_eq(s_str, str_from("42")) == 1, "to_str const");

# ================================================================
# Autodiff
# ================================================================
test_group("autodiff");

# f(x) = x^2, f'(x) = 2x at x=3: f(3)=9, f'(3)=6
var dx = dual_var(f64_from(3));
var dx2 = dual_mul(dx, dx);
assert_eq(f64_to(Dual_val(dx2)), 9, "x^2 val");
assert_eq(f64_to(Dual_deriv(dx2)), 6, "x^2 deriv");

# f(x) = sin(x), f'(x) = cos(x) at x=0: f(0)=0, f'(0)=1
var d0 = dual_var(0);
var ds = dual_sin(d0);
assert_eq(f64_to(Dual_val(ds)), 0, "sin(0)");
assert_eq(f64_to(Dual_deriv(ds)), 1, "cos(0)");

# f(x) = exp(x) at x=0: f(0)=1, f'(0)=1
var de = dual_exp(dual_var(0));
assert_eq(f64_to(Dual_val(de)), 1, "exp(0)");
assert_eq(f64_to(Dual_deriv(de)), 1, "exp'(0)");

# ================================================================
# Interval
# ================================================================
test_group("interval");

var ia = ivl_new(f64_from(1), f64_from(3));
var ib = ivl_new(f64_from(2), f64_from(4));
var ic = ivl_add(ia, ib);
assert_eq(f64_to(Interval_lo(ic)), 3, "add.lo");
assert_eq(f64_to(Interval_hi(ic)), 7, "add.hi");

assert_eq(ivl_contains(ia, f64_from(2)), 1, "contains 2");
assert_eq(ivl_contains(ia, f64_from(4)), 0, "not contains 4");
assert_eq(f64_to(ivl_width(ia)), 2, "width");

# ================================================================
# Tensor
# ================================================================
test_group("tensor");

# 2x3 tensor
var shape = alloc(16);
store64(shape, 2); store64(shape + 8, 3);
var tn = tensor_new(2, shape);
tensor_set2(tn, 0, 1, f64_from(42));
assert_eq(f64_to(tensor_get2(tn, 0, 1)), 42, "set/get");
assert_eq(f64_to(tensor_get2(tn, 0, 0)), 0, "zero init");

# Kronecker delta
assert_eq(f64_to(kronecker_delta(1, 1)), 1, "delta ii");
assert_eq(f64_to(kronecker_delta(0, 1)), 0, "delta ij");

# Minkowski metric
assert_eq(f64_to(minkowski(0, 0)), 1, "eta 00");
assert_eq(f64_to(minkowski(1, 1)), (0 - 1), "eta 11");

# Levi-Civita 3D
assert_eq(f64_to(levi_civita_3(0, 1, 2)), 1, "eps 012");
assert_eq(f64_to(levi_civita_3(1, 0, 2)), (0 - 1), "eps 102");
assert_eq(levi_civita_3(0, 0, 1), 0, "eps repeated");

# ================================================================
# 2.7.0-D -- unscaled Householder / unbalanced decompositions.
#
# Helper and constants use a `lp_test_` / `LP_T_` prefix deliberately: Cyrius has
# ONE flat namespace with last-definition-wins and this file includes src first,
# so a test symbol named `_lp_*` would silently shadow a future module internal.
# ================================================================

test_group("linalg_precision: decompositions must be scale-invariant");

# Relative closeness helper -- LOOSE_TOL_H is an ABSOLUTE 1e-8 and is useless at
# 1e200 scale, so these need a relative comparison.
var LP_T_RELTOL = 0x3DDB7CDFD9D7BDBB;   # 1e-10
var LP_T_DBLMAX = 0x7FEFFFFFFFFFFFFF;
fn lp_test_relclose(a, b) {
    if (f64_eq(a, a) == 0) { return 0; }                          # NaN
    if (f64_gt(f64_abs(a), LP_T_DBLMAX) == 1) { return 0; }        # +/-Inf
    if (f64_lt(f64_abs(f64_sub(a, b)), f64_mul(LP_T_RELTOL, f64_abs(b))) == 1) { return 1; }
    return 0;
}

var LP_T_BIG = 0x6974E718D7D7625A;   # 1e200
var lpo_A = mat_new(3, 3);
mat_set(lpo_A, 0, 0, f64_mul(F64_ONE, LP_T_BIG));
mat_set(lpo_A, 0, 1, f64_mul(F64_TWO, LP_T_BIG));
mat_set(lpo_A, 0, 2, f64_mul(f64_from(3), LP_T_BIG));
mat_set(lpo_A, 1, 0, f64_mul(f64_from(4), LP_T_BIG));
mat_set(lpo_A, 1, 1, f64_mul(f64_from(5), LP_T_BIG));
mat_set(lpo_A, 1, 2, f64_mul(f64_from(6), LP_T_BIG));
mat_set(lpo_A, 2, 0, f64_mul(f64_from(7), LP_T_BIG));
mat_set(lpo_A, 2, 1, f64_mul(f64_from(8), LP_T_BIG));
mat_set(lpo_A, 2, 2, f64_mul(f64_from(10), LP_T_BIG));
var lpo_U = mat_new(3, 3);
var lpo_Vt = mat_new(3, 3);
var lpo_S = alloc(24);
assert_eq(svd_golub_kahan(lpo_A, lpo_U, lpo_S, lpo_Vt), HSB_ERR_NONE,
"svd @1e200: converges (was HSB_ERR_NO_CONVERGENCE, U all NaN)");
# 17.412505166808593 * 1e200
assert(lp_test_relclose(load64(lpo_S), 0x69B6BF80142486CE) == 1,
"svd @1e200: S[0] == 1.7412505166808593e201");

var LP_T_TINY = 0x16687E92154EF7AC;   # 1e-200
var lpu_A = mat_new(3, 3);
mat_set(lpu_A, 0, 0, f64_mul(F64_ONE, LP_T_TINY));
mat_set(lpu_A, 0, 1, f64_mul(F64_TWO, LP_T_TINY));
mat_set(lpu_A, 0, 2, f64_mul(f64_from(3), LP_T_TINY));
mat_set(lpu_A, 1, 0, f64_mul(f64_from(4), LP_T_TINY));
mat_set(lpu_A, 1, 1, f64_mul(f64_from(5), LP_T_TINY));
mat_set(lpu_A, 1, 2, f64_mul(f64_from(6), LP_T_TINY));
mat_set(lpu_A, 2, 0, f64_mul(f64_from(7), LP_T_TINY));
mat_set(lpu_A, 2, 1, f64_mul(f64_from(8), LP_T_TINY));
mat_set(lpu_A, 2, 2, f64_mul(f64_from(10), LP_T_TINY));
var lpu_U = mat_new(3, 3);
var lpu_Vt = mat_new(3, 3);
var lpu_S = alloc(24);
assert_eq(svd_golub_kahan(lpu_A, lpu_U, lpu_S, lpu_Vt), HSB_ERR_NONE, "svd @1e-200: returns ERR_NONE");
# 17.412505166808593 * 1e-200; the underflowed path returned 1e-199 (= raw A[2][2])
assert(lp_test_relclose(load64(lpu_S), 0x16AAA8257F7EC875) == 1,
"svd @1e-200: S[0] == 1.7412505166808593e-199 (was 1e-199, the raw A[2][2])");

var lpo_E = mat_new(3, 3);
mat_set(lpo_E, 0, 0, f64_mul(f64_from(4), LP_T_BIG));
mat_set(lpo_E, 0, 1, f64_mul(F64_ONE, LP_T_BIG));
mat_set(lpo_E, 0, 2, f64_from(0));
mat_set(lpo_E, 1, 0, f64_mul(F64_ONE, LP_T_BIG));
mat_set(lpo_E, 1, 1, f64_mul(f64_from(3), LP_T_BIG));
mat_set(lpo_E, 1, 2, f64_mul(F64_ONE, LP_T_BIG));
mat_set(lpo_E, 2, 0, f64_from(0));
mat_set(lpo_E, 2, 1, f64_mul(F64_ONE, LP_T_BIG));
mat_set(lpo_E, 2, 2, f64_mul(F64_TWO, LP_T_BIG));
var lpo_ev = alloc(24);
var lpo_EV = mat_new(3, 3);
assert_eq(eigen_qr(lpo_E, 3, 10000, lpo_ev, lpo_EV), HSB_ERR_NONE,
"eigen_qr @1e200: converges (was HSB_ERR_NO_CONVERGENCE)");
# 4.732050807568877 * 1e200
assert(lp_test_relclose(load64(lpo_ev), 0x6998BA6A7000200E) == 1,
"eigen_qr @1e200: lambda0 == 4.732050807568877e200");

var lpc_A = cmat_new(2, 2);
cmat_set(lpc_A, 0, 0, cx_new(f64_mul(f64_from(3), LP_T_BIG), f64_from(0)));
cmat_set(lpc_A, 0, 1, cx_new(f64_mul(F64_ONE, LP_T_BIG), f64_from(0)));
cmat_set(lpc_A, 1, 0, cx_new(f64_mul(f64_from(4), LP_T_BIG), f64_from(0)));
cmat_set(lpc_A, 1, 1, cx_new(f64_mul(F64_TWO, LP_T_BIG), f64_from(0)));
var lpc_Q = cmat_new(2, 2);
var lpc_R = cmat_new(2, 2);
assert_eq(cqr_decompose(lpc_A, lpc_Q, lpc_R), HSB_ERR_NONE, "cqr @1e200: returns ERR_NONE");
# |R[0,0]| must be ||col0|| = 5e200
assert(lp_test_relclose(f64_abs(HComplex_re(cmat_get(lpc_R, 0, 0))), 0x699A20DF0DCD3AF1) == 1,
"cqr @1e200: |R[0,0]| == 5e200 (was 3e200 -- reflectors skipped, R == A)");
# R must be upper triangular
assert(f64_lt(f64_abs(HComplex_re(cmat_get(lpc_R, 1, 0))), 0x6761F48EAF234AD4) == 1,
"cqr @1e200: |R[1,0]| < 1e190 (was 4e200 -- R not upper triangular)");

# The band that actually matters. 1e+/-200 are the dramatic endpoints, but the
# measured failure region reaches ordinary magnitudes: across 440 random matrices
# the unbalanced code was correct only in roughly 1 .. 1e23, failing 40/40 at
# scale 1e-10 on a relative reconstruction check. That is SI metres -- a physics
# consumer got silently wrong singular values, with no error code.
var LP_T_SI = 0x3DDB7CDFD9D7BDBB;   # 1e-10
var lps_A = mat_new(3, 3);
mat_set(lps_A, 0, 0, f64_mul(F64_ONE, LP_T_SI));
mat_set(lps_A, 0, 1, f64_mul(F64_TWO, LP_T_SI));
mat_set(lps_A, 0, 2, f64_mul(f64_from(3), LP_T_SI));
mat_set(lps_A, 1, 0, f64_mul(f64_from(4), LP_T_SI));
mat_set(lps_A, 1, 1, f64_mul(f64_from(5), LP_T_SI));
mat_set(lps_A, 1, 2, f64_mul(f64_from(6), LP_T_SI));
mat_set(lps_A, 2, 0, f64_mul(f64_from(7), LP_T_SI));
mat_set(lps_A, 2, 1, f64_mul(f64_from(8), LP_T_SI));
mat_set(lps_A, 2, 2, f64_mul(f64_from(10), LP_T_SI));
var lps_U = mat_new(3, 3);
var lps_Vt = mat_new(3, 3);
var lps_S = alloc(24);
assert_eq(svd_golub_kahan(lps_A, lps_U, lps_S, lps_Vt), HSB_ERR_NONE, "svd @1e-10: returns ERR_NONE");
# 17.412505166808593e-10. Measured pre-fix on THIS matrix: HSB_ERR_NO_CONVERGENCE
# (-8), so here the failure is at least loud. The 40/40 figure above came from a
# relative reconstruction check over random matrices, where the mode varies
# between non-convergence and a silently wrong S -- both are covered, by this
# pair and by the 1e-200 pair above.
assert(lp_test_relclose(load64(lps_S), 0x3E1DEA19CB65B491) == 1,
"svd @1e-10 (SI metres): S[0] == 1.7412505166808593e-9");

# ================================================================
# 2.7.0-E -- rank-deficient SVD.
#
# A zero DIAGONAL entry inside the active block makes the implicit-shift step a
# no-op: the rotation built from (d^2 - mu, d*f) is a bare sign flip when d == 0,
# so the sweep reproduces the block and spins to max_iter. Every rank-deficient
# input typically reaches that state. This is the zero-diagonal case of
# Golub & Van Loan Alg. 8.6.2, omitted from the original transcription.
#
# CAVEAT on the "s == 0" assertions below: they are NOT standalone. Pre-fix,
# svd_golub_kahan bails before writing out_S at all, so the caller's zero-filled
# alloc satisfies them trivially. They are meaningful only bundled with the
# return-code and reconstruction assertions in the same group.
# ================================================================

test_group("svd_golub_kahan: rank-deficient input has a well-defined SVD");

var A1 = mat_new(3, 3);
mat_set(A1, 0, 0, f64_from(1)); mat_set(A1, 0, 1, f64_from(2)); mat_set(A1, 0, 2, f64_from(3));
mat_set(A1, 1, 0, f64_from(2)); mat_set(A1, 1, 1, f64_from(4)); mat_set(A1, 1, 2, f64_from(6));
mat_set(A1, 2, 0, f64_from(3)); mat_set(A1, 2, 1, f64_from(6)); mat_set(A1, 2, 2, f64_from(9));
var U1 = mat_new(3, 3);
var V1 = mat_new(3, 3);
var S1 = alloc(24);
assert_eq(svd_golub_kahan(A1, U1, S1, V1), HSB_ERR_NONE, "svd rank-1 3x3: converges");
assert(f64_approx_eq(load64(S1), f64_from(14), LOOSE_TOL_H) == 1, "svd rank-1 3x3: s0 == 14");

# _lp_check_svd is the reconstruction helper already defined at tests/hisab.tcyr:558
_lp_check_svd(A1, 3, 3, U1, S1, V1, "svd rank-1 3x3: A == U*S*Vt");
assert(f64_lt(f64_abs(load64(S1 + 8)), EPSILON_F64) == 1, "svd rank-1 3x3: s1 == 0");
assert(f64_lt(f64_abs(load64(S1 + 16)), EPSILON_F64) == 1, "svd rank-1 3x3: s2 == 0");

# rectangular, rank-2: column 3 = 3 * column 1
var A5 = mat_new(4, 3);
mat_set(A5, 0, 0, f64_from(1)); mat_set(A5, 0, 1, f64_from(2)); mat_set(A5, 0, 2, f64_from(3));
mat_set(A5, 1, 0, f64_from(2)); mat_set(A5, 1, 1, f64_from(4)); mat_set(A5, 1, 2, f64_from(6));
mat_set(A5, 2, 0, f64_from(0)); mat_set(A5, 2, 1, f64_from(1)); mat_set(A5, 2, 2, f64_from(0));
mat_set(A5, 3, 0, f64_from(0)); mat_set(A5, 3, 1, f64_from(2)); mat_set(A5, 3, 2, f64_from(0));
var U5 = mat_new(4, 3);
var V5 = mat_new(3, 3);
var S5 = alloc(24);
assert_eq(svd_golub_kahan(A5, U5, S5, V5), HSB_ERR_NONE, "svd 4x3 rank-2: converges");
_lp_check_svd(A5, 4, 3, U5, S5, V5, "svd 4x3 rank-2: A == U*S*Vt");

# 5x4 rank-3 (col 3 = 2 * col 1) -- exercises an interior zero diagonal, and
# checks that the fix keeps U and Vt orthogonal rather than merely reconstructing.
var A7 = mat_new(5, 4);
mat_set(A7, 0, 0, f64_from(1)); mat_set(A7, 0, 1, f64_from(5));
mat_set(A7, 0, 2, f64_from(2)); mat_set(A7, 0, 3, f64_from(2));
mat_set(A7, 1, 0, f64_from(3)); mat_set(A7, 1, 1, f64_from(1));
mat_set(A7, 1, 2, f64_from(6)); mat_set(A7, 1, 3, f64_from(6));
mat_set(A7, 2, 0, f64_from(7)); mat_set(A7, 2, 1, f64_from(2));
mat_set(A7, 2, 2, f64_from(14)); mat_set(A7, 2, 3, f64_from(4));
mat_set(A7, 3, 0, f64_from(0)); mat_set(A7, 3, 1, f64_from(4));
mat_set(A7, 3, 2, f64_from(0)); mat_set(A7, 3, 3, f64_from(9));
mat_set(A7, 4, 0, f64_from(2)); mat_set(A7, 4, 1, f64_from(2));
mat_set(A7, 4, 2, f64_from(4)); mat_set(A7, 4, 3, f64_from(1));
var U7 = mat_new(5, 4);
var V7 = mat_new(4, 4);
var S7 = alloc(32);
assert_eq(svd_golub_kahan(A7, U7, S7, V7), HSB_ERR_NONE, "svd 5x4 rank-3: converges");
assert(f64_lt(f64_abs(load64(S7 + 24)), EPSILON_F64) == 1, "svd 5x4 rank-3: s3 == 0");
_lp_check_svd(A7, 5, 4, U7, S7, V7, "svd 5x4 rank-3: A == U*S*Vt");

# ================================================================
# 2.7.0-F -- eigen_qr non-convergence on a moderately-conditioned
# symmetric 4x4. Found by sweeping 150 random symmetric 4x4s (1 failed);
# cond is only 240, which LAPACK's dsyev handles trivially.
#
# Root cause was the block-boundary logic, not the sweep: a dead loop with a
# FAKE break (`var _break = 1;` plus two no-op `p_lo = p_lo;` statements) that
# always ran to 0, followed by a re-find whose test was an ABSOLUTE EPSILON_F64
# while the deflation test beside it was RELATIVE. On entries spanning
# 0.04 .. 24.6 the two disagreed about "negligible" and the sweep stalled.
# ================================================================

test_group("eigen_qr: converges on a moderately-conditioned symmetric 4x4");

var eqA = mat_new(4, 4);
mat_set(eqA, 0, 0, 0x40389DF1BD110222); mat_set(eqA, 0, 1, 0x3FEE5D20F4B120C8);
mat_set(eqA, 0, 2, 0x40120E8FDA90FA03); mat_set(eqA, 0, 3, 0x40204BE315F598A5);
mat_set(eqA, 1, 0, 0x3FEE5D20F4B120C8); mat_set(eqA, 1, 1, 0x3FD1056459266190);
mat_set(eqA, 1, 2, 0x3FD3E631F1B3FC40); mat_set(eqA, 1, 3, 0x3FA4745F80EE7C17);
mat_set(eqA, 2, 0, 0x40120E8FDA90FA03); mat_set(eqA, 2, 1, 0x3FD3E631F1B3FC40);
mat_set(eqA, 2, 2, 0x3FB6AF52BAD29C05); mat_set(eqA, 2, 3, 0x3FA4220EB3E9F39D);
mat_set(eqA, 3, 0, 0x40204BE315F598A5); mat_set(eqA, 3, 1, 0x3FA4745F80EE7C17);
mat_set(eqA, 3, 2, 0x3FA4220EB3E9F39D); mat_set(eqA, 3, 3, 0x3FBFD313FB35F280);
var eqV = mat_new(4, 4);
var eqL = alloc(32);
assert_eq(eigen_qr(eqA, 4, 1000, eqL, eqV), HSB_ERR_NONE,
"eigen_qr 4x4 cond 240: converges (was NO_CONVERGENCE at max_iter 1e6)");

# Values, not just the return code -- eigenvalues from numpy eigvalsh, sorted by
# descending magnitude to match eigen_qr's own ordering.
assert(f64_approx_eq(load64(eqL),      0x403BCB05D28B68A6, LOOSE_TOL_H) == 1, "eigen_qr l0 == 27.793057593379352");
assert(f64_approx_eq(load64(eqL + 8),  0xC007FD0502FCF8BC, LOOSE_TOL_H) == 1, "eigen_qr l1 == -2.9985447152567684");
assert(f64_approx_eq(load64(eqL + 16), 0x3FDAB3E64483E4F2, LOOSE_TOL_H) == 1, "eigen_qr l2 == 0.41723019305170717");
assert(f64_approx_eq(load64(eqL + 24), 0xBFBDAB161234EC74, LOOSE_TOL_H) == 1, "eigen_qr l3 == -0.11589181847095792");

# And the eigenvector relation A*v = lambda*v, which the values alone do not pin.
_lp_check_eig(eqA, 4, eqL, eqV, "eigen_qr 4x4 cond 240: A*v == lambda*v");

var r = assert_summary();
# Clamp before exiting: assert_summary() returns the raw failure COUNT, and a wait
# status is only 8 bits — an unclamped 256 / 512 / 768 failures would exit 0 and
# score PASS. Any failure at all is exit 1. (cyrius 6.5.6 fixed the same hole in
# its own scaffold template; verified here — 256 failures scored PASS before this.)
if (r > 0) { r = 1; }
sys_exit_group(r);
