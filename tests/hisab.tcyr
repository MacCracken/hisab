  "gjk_epa_3d: ... depth 3.4629193e-7, 0.011 eps from the nearest face (3.4.0: 3.4630921e-7)");

# === 3.4.1 CO3: one answer per pair, whichever order it is asked in ===
# A ball 0.0024 eps from a capsule's side at 1e3 (in the band): 3.4.1-dev gave a miss capsule
# first and a contact sphere first, from all five entry points. Since review pass CO3 the pair
# runs in its canonical order and the band takes a contact from either order: a contact both
# ways, the depth equal and the normal mirrored bit for bit, time_of_impact at rest included.
# [measured: lane CO3 fixgen2.py (sweepo.py seed 21 pair 1644), 3.4.1-dev and this tree; 2026-10-31]
var _co3_oc = alloc(56);
store64(_co3_oc, 0x408F400000000000); store64(_co3_oc + 8, 0xC09F400000000000);
store64(_co3_oc + 16, 0x407F400000000000);
store64(_co3_oc + 24, 0xBFC46C415DB3FA8E); store64(_co3_oc + 32, 0x3F685EB6FAADFF83);
store64(_co3_oc + 40, 0x3FE0B95461CA4C1B);
store64(_co3_oc + 48, 0x3FE20AA1D0E6819C);
var _co3_os = _co3_s4(0x408F47B944A1B9BA, 0xC09F41CC92BF02BC, 0x407F431A391218B3, 0x3FE074EC0F516504);
assert_eq(gjk_intersect_3d(&_co3_cap, _co3_oc, &_co3_sph, _co3_os), 1,
  "gjk_intersect_3d: the pair, capsule first: a contact (3.4.1-dev: a miss)");
assert_eq(gjk_intersect_3d(&_co3_sph, _co3_os, &_co3_cap, _co3_oc), 1, "gjk_intersect_3d: ... sphere first: a contact");
assert_eq(mpr_intersect(&_co3_cap, _co3_oc, &_co3_sph, _co3_os), 1, "mpr_intersect: ... capsule first");
assert_eq(gjk_epa_3d(&_co3_cap, _co3_oc, &_co3_sph, _co3_os, _co3_n, _co3_d), 1, "gjk_epa_3d: ... capsule first");
assert_eq(gjk_epa_3d(&_co3_sph, _co3_os, &_co3_cap, _co3_oc, _co3_n2, _co3_d2), 1, "gjk_epa_3d: ... sphere first");
assert_eq(load64(_co3_d) == load64(_co3_d2) && _co3_mirror(load64(_co3_n), load64(_co3_n2)) == 1, 1,
  "gjk_epa_3d: ... the same depth both ways, the normal mirrored");
assert_eq(HVec3_x(load64(_co3_n)), 0x3FEBCCE38FBAC3B9, "gjk_epa_3d: ... normal x, capsule first");
assert_eq(time_of_impact(&_co3_cap, _co3_oc, hvec3_zero(), &_co3_sph, _co3_os, hvec3_zero(), F64_ONE, _co3_t,
    _co3_n2), 1,
  "time_of_impact at rest: ... a contact at t = 0, as gjk_intersect_3d");
assert_eq(HVec3_x(load64(_co3_n2)), 0x3FEBCCE38FBAC3B9, "time_of_impact: ... gjk_epa_3d's normal");
# Outside the band every verdict agreed, but the depth's last bits came from the order: a ball
# 7.3 eps into a box face, 0x3D55E8... box first and 0x3D55E6... ball first in 3.4.1-dev.
var _co3_ab = alloc(120);
store64(_co3_ab, 0); store64(_co3_ab + 8, 0x8000000000000000); store64(_co3_ab + 16, 0);
store64(_co3_ab + 24, 0x3FF48427ADBC08D5); store64(_co3_ab + 32, 0x3FEA17FB01EA5DD3);
store64(_co3_ab + 40, 0x3FE625A0ACFA8A74);
store64(_co3_ab + 48, 0x3FDAA795ECD5E0B0); store64(_co3_ab + 56, 0xBFD8919280E4DA8D);
store64(_co3_ab + 64, 0x3FEA5F36170D5846);
store64(_co3_ab + 72, 0xBFD288B16AECC213); store64(_co3_ab + 80, 0x3FE9B432B4B0A749);
store64(_co3_ab + 88, 0x3FE0A80400D5E0EF);
store64(_co3_ab + 96, 0xBFEB93C7E6289418); store64(_co3_ab + 104, 0xBFDD25F368C662D5);
store64(_co3_ab + 112, 0x3FCC9736C2FFDDB0);
var _co3_as = _co3_s4(0x3FE48D0DEDA2756A, 0xBFEFF691A40292A0, 0x3FF68CCC5CA08D16, 0x3FE0F6F53BC9509E);
assert_eq(gjk_epa_3d(&_co3_obb, _co3_ab, &_co3_sph, _co3_as, _co3_n, _co3_d), 1,
  "gjk_epa_3d: a ball 7.3 eps into a box face");
assert_eq(load64(_co3_d), 0x3D55E60000000000,
  "gjk_epa_3d: ... box first, the canonical order's depth (3.4.1-dev: 0x3D55E8...)");
assert_eq(gjk_epa_3d(&_co3_sph, _co3_as, &_co3_obb, _co3_ab, _co3_n2, _co3_d2), 1, "gjk_epa_3d: ... ball first");
assert_eq(load64(_co3_d2), 0x3D55E60000000000, "gjk_epa_3d: ... ball first, the same depth");
assert_eq(_co3_mirror(load64(_co3_n), load64(_co3_n2)), 1, "gjk_epa_3d: ... and the normal mirrored");
# In the band two contacts' depths: the shallower is taken (each is h along its own normal, an
# upper bound on the least h). A sphere off the side of a box 2^176 long at 2^-300, 8.39e-92
# deep: 1.41e-91 ball first (the canonical order), 8.39e-92 box first; both calls 8.39e-92.
# [measured: lane CO3 p92.py, review G2 aspect fixture (tests/modules_b.tcyr); 2026-10-31]
var _co3_lb = alloc(120);
for (var _co3_i = 0; _co3_i < 15; _co3_i = _co3_i + 1) { store64(_co3_lb + _co3_i * 8, 0); }
store64(_co3_lb + 24, 0x3838C1131FDC4CB2); store64(_co3_lb + 32, 0x2D2936DE75E9160D);
store64(_co3_lb + 40, 0x2D225A752B56ED5D);
store64(_co3_lb + 48, F64_ONE); store64(_co3_lb + 80, F64_ONE); store64(_co3_lb + 112, F64_ONE);
var _co3_ls = _co3_s4(0xB81C12562856308A, 0x2D3BEEC4A2A1BD31, 0x2D1AB92EF85E2F54, 0x2D320F62BE11E67E);
assert_eq(gjk_epa_3d(&_co3_sph, _co3_ls, &_co3_obb, _co3_lb, _co3_n, _co3_d), 1,
  "gjk_epa_3d: the 2^176-long box, ball first");
assert_eq(load64(_co3_d), 0x2D05E06AB325ABB7,
  "gjk_epa_3d: ... 8.390188e-92, the shallower order's (exact 8.390188444980945e-92)");

# === 3.4.1 CO3: time_of_impact -- a small ball's corner normal read again with a wider tilt ===
# A ball of radius 1e-6 swept onto a box corner: the vertex form carried the snap's rho reading
# (rounding over a 2^-10 tilt) times the reading's own offset, 1.05e-7 rad from the
# closest-approach direction at the reported t (3.4.1-dev). Read again from the first answer with
# a tilt of 2^-4: 4.0e-10 rad (the ulp(|s|) / r floor). t is unchanged.
# [measured: lane CO3 toin.py (seed 4, 40 corner sweeps at r = 1e-6), Decimal closest-approach oracle; 2026-10-31]
var _co3_tb = alloc(120);
store64(_co3_tb, 0); store64(_co3_tb + 8, 0); store64(_co3_tb + 16, 0);
store64(_co3_tb + 24, 0x3FECFEDD5B862EEE); store64(_co3_tb + 32, 0x3FF195A4CE7990E8);
store64(_co3_tb + 40, 0x3FF659993CFACBC0);
store64(_co3_tb + 48, 0xBFC8A8BB0BF6C110); store64(_co3_tb + 56, 0xBFDE0050C040CD1C);
store64(_co3_tb + 64, 0xBFEB95F7CF972CAD);
store64(_co3_tb + 72, 0x3FECD15F9F818CC4); store64(_co3_tb + 80, 0xBFDBBC5CA485A218);
store64(_co3_tb + 88, 0x3FA19D9750AB37C8);
store64(_co3_tb + 96, 0xBFD8F128A8FE641A); store64(_co3_tb + 104, 0xBFE8A16A6FA6F73C);
store64(_co3_tb + 112, 0x3FE02E39BF298CF0);
var _co3_ts = _co3_s4(0x3FE780E7E58D5755, 0xC00C579F4903CA94, 0x400A66415A039301, 0x3EB0C6F7A0B5ED8D);
var _co3_tv = hvec3_new(0xBFB21276D118EF10, 0x3FF7D1CFADB1CB82, 0xBFF17F071A2C83C3);
assert_eq(time_of_impact(&_co3_obb, _co3_tb, hvec3_zero(), &_co3_sph, _co3_ts, _co3_tv, f64_from(10), _co3_t,
    _co3_n), 1,
  "time_of_impact: a ball of radius 1e-6 swept onto a box corner hits");
assert_eq(load64(_co3_t), 0x3FF9F774C1D050DA, "time_of_impact: ... at the same t as 3.4.1-dev");
assert_eq(HVec3_x(load64(_co3_n)), 0x3FA38D91B556C3DD,
  "time_of_impact: ... normal x, 4.0e-10 rad off (3.4.1-dev: ...769C0A03, 1.05e-7)");
assert_eq(HVec3_y(load64(_co3_n)), 0xBFE9C57B84A2D050, "time_of_impact: ... normal y");
assert_eq(HVec3_z(load64(_co3_n)), 0x3FE2EE0D2D16CA5A, "time_of_impact: ... normal z");

# === 3.4.1 CO4: delaunay_2d -- a refused allocation is 0, never the empty vec ===
# The empty vec is delaunay_2d's answer for n < 3, a collinear set and a rejected site, so
# through lane CO2 a refused allocation, which answered it too, read as "nothing to mesh". Each
# set below is swept from k = 0, every 8 bytes, to its first answer, with the heap exhausted
# after k bytes (tests/abuse.tcyr's instrument, lane AL, copied here so the group stands alone):
# every point before the answer must be 0, and the answer must be the heap-open one -- no empty
# vec and no partial mesh. On the CO2 tree each set answered 0 only at its first 19 points (the
# result vec's own two requests) and the empty vec at every later refusal -- 401, 433, 2,705,
# 2,737, 298 and 752 points for the six sets with triangles -- and the collinear set stopped at
# its 19th; here they answer 0 at 420, 452, 2,724, 2,756, 317, 771 and 420 points, and nothing else.
# [measured: lane CO4 3.4.1 dlsw probe of this group's sweep, the CO2 tree (s6) and this one; cycc 6.7.18]
var _co41_gk = 0;
var _co41_sk = 0;
var _co41_hp = 0;
var _co41_he = 0;
fn _co41_exh(k) {
    var blk = 0;
    if (k > 0) { blk = alloc(k); }
    _co41_gk = _linux_grain;
    _co41_sk = _LINUX_CHUNK_SMALL;
    _co41_hp = _heap_ptr;
    _co41_he = _heap_end;
    if (blk != 0) {
        _heap_ptr = blk;
        _heap_end = blk + k;
    } else {
        _heap_end = _heap_ptr;
    }
    _linux_grain = 0x4000_0000_0000_0000;
    _LINUX_CHUNK_SMALL = 0x4000_0000_0000_0000;
    return _heap_end - _heap_ptr;
}
fn _co41_exh_end() {
    var left = _heap_end - _heap_ptr;
    _heap_ptr = _co41_hp;
    _heap_end = _co41_he;
    _linux_grain = _co41_gk;
    _LINUX_CHUNK_SMALL = _co41_sk;
    return left;
}
test_group("3.4.1 CO4: delaunay_2d -- a refused allocation is 0, never the empty vec");
var _co41_gr0 = _linux_grain;
var _co41_sm0 = _LINUX_CHUNK_SMALL;
var _co41_room = _co41_exh(64);
var _co41_e1 = alloc(64);
var _co41_e2 = alloc(8);
_co41_exh_end();
_co41_exh(64);
var _co41_e4 = alloc(24);
var _co41_el = _co41_exh_end();
var _co41_rs = (_heap_ptr == _co41_hp && _heap_end == _co41_he && _linux_grain == _co41_gr0
  && _LINUX_CHUNK_SMALL == _co41_sm0 && _co41_el == 40);
var _co41_e3 = alloc(8);
assert_eq(_co41_room == 64 && _co41_e1 != 0 && _co41_e2 == 0 && _co41_e4 != 0 && _co41_rs == 1
  && _co41_e3 == _co41_hp, 1,
  "exhaust instrument: 64 bytes left, a 64-byte request fits, the next is refused, the heap resumes where it left off");
fn _co41_pt(v, x, y) {
    vec_push(v, hvec2_new(x, y));
    return 0;
}
# 1 when a and b are vecs (neither 0) holding the same indices.
fn _co41_same(a, b) {
    if (a == 0 || b == 0) { return 0; }
    if (vec_len(a) != vec_len(b)) { return 0; }
    for (var i = 0; i < vec_len(a); i = i + 1) {
        if (vec_get(a, i) != vec_get(b, i)) { return 0; }
    }
    return 1;
}
# Sweep delaunay_2d(pts, n) to its first non-0 answer. Slot 0: the points that answered 0;
# slot 1: the non-0 answers that were not the heap-open one (an empty vec, a partial mesh);
# slot 2: 1 once the heap-open answer came back.
fn _co41_sweep(pts, n, st) {
    var full = delaunay_2d(pts, n);
    store64(st, 0);
    store64(st + 8, 0);
    store64(st + 16, 0);
    var k = 0;
    while (k <= 600000 && load64(st + 16) == 0) {
        _co41_exh(k);
        var r = delaunay_2d(pts, n);
        _co41_exh_end();
        if (r == 0) {
            store64(st, load64(st) + 1);
        } else {
            if (_co41_same(r, full) == 1) {
                store64(st + 16, 1);
            } else {
                store64(st + 8, load64(st + 8) + 1);
            }
        }
        k = k + 8;
    }
    return vec_len(full);
}
var _co41_st: i64[3];
# The square; the square with an interior site; 20 scattered sites (every working vec grows
# past its first 16 slots); 20 sites on a circle with the centre inserted last (a cavity of
# 20 triangles, so the cavity buffers grow too); 3 and 6 sites at 2^300 and 2^-700 (the
# scaled copy); 4 collinear sites (the answer itself is the empty vec).
var _co41_d1 = vec_new();
_co41_pt(_co41_d1, 0, 0);
_co41_pt(_co41_d1, f64_from(4), 0);
_co41_pt(_co41_d1, f64_from(4), f64_from(4));
_co41_pt(_co41_d1, 0, f64_from(4));
var _co41_d2 = vec_new();
for (var i = 0; i < 4; i = i + 1) { vec_push(_co41_d2, vec_get(_co41_d1, i)); }
_co41_pt(_co41_d2, F64_ONE, F64_TWO);
var _co41_d3 = vec_new();
for (var i = 0; i < 20; i = i + 1) { _co41_pt(_co41_d3, f64_from(i * i % 17), f64_from(i * 7 % 13)); }
var _co41_d4 = vec_new();
for (var i = 0; i < 20; i = i + 1) {
    var a = f64_div(f64_mul(f64_from(i), 0x401921FB54442D18), f64_from(20));
    _co41_pt(_co41_d4, f64_cos(a), f64_sin(a));
}
_co41_pt(_co41_d4, 0, 0);
var _co41_p300 = (1023 + 300) << 52;
var _co41_d5 = vec_new();
_co41_pt(_co41_d5, _co41_p300, 0);
_co41_pt(_co41_d5, 0, _co41_p300);
_co41_pt(_co41_d5, _co41_p300, _co41_p300);
var _co41_m700 = (1023 - 700) << 52;
var _co41_d6 = vec_new();
_co41_pt(_co41_d6, _co41_m700, 0);
_co41_pt(_co41_d6, f64_mul(_co41_m700, f64_from(3)), _co41_m700);
_co41_pt(_co41_d6, f64_mul(_co41_m700, F64_TWO), f64_mul(_co41_m700, f64_from(4)));
_co41_pt(_co41_d6, 0, f64_mul(_co41_m700, f64_from(3)));
_co41_pt(_co41_d6, _co41_m700, _co41_m700);
_co41_pt(_co41_d6, f64_mul(_co41_m700, F64_TWO), f64_mul(_co41_m700, F64_TWO));
var _co41_d7 = vec_new();
for (var i = 0; i < 4; i = i + 1) { _co41_pt(_co41_d7, f64_from(i), f64_from(2 * i)); }
var _co41_dsets: i64[7];
store64(&_co41_dsets, _co41_d1); store64(&_co41_dsets + 8, _co41_d2); store64(&_co41_dsets + 16, _co41_d3);
store64(&_co41_dsets + 24, _co41_d4); store64(&_co41_dsets + 32, _co41_d5); store64(&_co41_dsets + 40, _co41_d6);
store64(&_co41_dsets + 48, _co41_d7);
# The answers' lengths (3 per triangle; -1: not pinned), and the fewest points each sweep must
# spend on refusals: every set here asks for the result vec and eleven working vecs before its
# answer can be built, 12 vec_new footprints (an alloc_used() delta), one point per 8 bytes.
var _co41_dlen: i64[7];
store64(&_co41_dlen, 6); store64(&_co41_dlen + 8, 12); store64(&_co41_dlen + 16, 0 - 1);
store64(&_co41_dlen + 24, 60); store64(&_co41_dlen + 32, 3); store64(&_co41_dlen + 40, 0 - 1);
store64(&_co41_dlen + 48, 0);
var _co41_u0 = alloc_used();
var _co41_v0 = vec_new();
var _co41_vfloor = 12 * (alloc_used() - _co41_u0) / 8;
var _co41_zall = 0;
for (var i = 0; i < 7; i = i + 1) {
    var d = load64(&_co41_dsets + i * 8);
    var len = _co41_sweep(d, vec_len(d), &_co41_st);
    var want = load64(&_co41_dlen + i * 8);
    assert_eq(want < 0 || len == want, 1, "delaunay_2d: the heap-open answer has the expected length");
    assert_eq(load64(&_co41_st + 16), 1, "delaunay_2d: the sweep reached the heap-open answer, no exit on the way");
    assert_eq(load64(&_co41_st + 8), 0, "delaunay_2d: no point answered an empty vec or a partial mesh");
    assert_eq(load64(&_co41_st) >= _co41_vfloor, 1,
      "delaunay_2d: every point up to 12 vecs' worth of heap answered 0 (CO2: the empty vec from the 20th)");
    _co41_zall = _co41_zall + load64(&_co41_st);
}
assert_eq(_co41_zall > 4000, 1, "delaunay_2d: over 4,000 refusal points in all, every one 0");
# Controls: the heap-open answers themselves.
assert_eq(vec_len(delaunay_2d(_co41_d3, 20)) > 0 && vec_len(delaunay_2d(_co41_d6, 6)) > 0, 1,
  "delaunay_2d: control, the scattered and the 2^-700 sets have meshes");
assert_eq(_co41_same(delaunay_2d(_co41_d7, 4), vec_new()), 1,
  "delaunay_2d: control, the collinear set's answer is the empty vec");

# === 3.4.1 CO4: sequential_impulse -- the friction cone of a subnormal or underflowed impulse ===
# The cone is friction times the EXACT normal impulse. Through lane CO2 it was friction times
# the impulse rounded onto the subnormal grid, up to 2^-1075 off, so the friction came back up
# to friction/2 units of 2^-1074 off, and a cone whose impulse underflowed to 0 was lost. Every
# expected value is the exact closed form (Fractions) rounded once:
#   n = max(0, (1 + e) pen / M),  f = clamp(-v_t / M, +-mu n),  M = ima + imb.
# [measured: lane CO4 3.4.1 si4.py seeds 1-7, 248,279 contacts in 18 families, the CO2 tree and this one; cycc 6.7.18]
test_group("3.4.1 CO4: sequential_impulse -- the friction cone of a subnormal or underflowed impulse");
var _co41_out = alloc(16 * 8);
# One contact, `it` sweeps, into _co41_out; 1 when the call is Ok.
fn _co41_si(pen, ima, imb, mu, e, vt, it) {
    var cs = vec_new();
    vec_push(cs, contact_new_fric(0, 1, hvec3_unit_y(), pen, mu, e, ima, imb, vt));
    var t, v = sequential_impulse(cs, 1, it, _co41_out);
    return is_ok(t);
}
# pen 7 2^-900 over 5 2^174, friction 2^100, v_t = M: n = 1.4 2^-1074 rounds to 2^-1074, and
# the cone is 1.4 2^-974 (CO2: friction times the rounded n, -2^-974), at 1, 2, 4
# sweeps. |f| is then above friction times the n returned, as the exact answer is.
for (var it = 1; it <= 4; it = it * 2) {
    assert_eq(_co41_si(0x07DC000000000000, 0x4AF4000000000000, 0, 0x4630000000000000, 0, 0x4AF4000000000000, it), 1,
      "sequential_impulse: a subnormal impulse under friction 2^100 is Ok");
    assert_eq(load64(_co41_out), 1, "sequential_impulse: ... n = 1.4 2^-1074 rounds to 2^-1074");
    assert_eq(load64(_co41_out + 8), 0x8316666666666666, "sequential_impulse: ... f = -1.4 2^-974 (CO2: -2^-974)");
}
# pen 2^-900 over 2^200 (n = 2^-1100, below half of 2^-1074) with friction 2^300: n rounds to 0,
# the cone is 2^-800 (CO2: 0, so f was -0).
assert_eq(_co41_si(0x07B0000000000000, 0x4C70000000000000, 0, 0x52B0000000000000, 0, 0x4C70000000000000, 1), 1,
  "sequential_impulse: an underflowing impulse under friction 2^300 is Ok");
assert_eq(load64(_co41_out), 0, "sequential_impulse: ... n = 2^-1100 rounds to +0");
assert_eq(load64(_co41_out + 8), 0x8DF0000000000000, "sequential_impulse: ... f = -2^-800 (CO2: -0)");
assert_eq(_co41_si(0x07B0000000000000, 0x4C70000000000000, 0, 0x52B0000000000000, 0, 0x4C70000000000000, 3), 1,
  "sequential_impulse: ... and at 3 sweeps");
assert_eq(load64(_co41_out + 8), 0x8DF0000000000000, "sequential_impulse: ... f = -2^-800 at 3 sweeps");
# n = 0.6 2^-1074 rounds UP to 2^-1074, so the rounded cone (2^-974) let -v_t / M = -0.8 2^-974
# through unclamped; the exact cone, 0.6 2^-974, clamps it.
assert_eq(_co41_si(0x07C8000000000000, 0x4AF4000000000000, 0, 0x4630000000000000, 0, 0x0E10000000000000, 2), 1,
  "sequential_impulse: an impulse rounded up onto 2^-1074 is Ok");
assert_eq(load64(_co41_out), 1, "sequential_impulse: ... n = 0.6 2^-1074 rounds to 2^-1074");
assert_eq(load64(_co41_out + 8), 0x8303333333333333,
  "sequential_impulse: ... f = -0.6 2^-974, clamped (CO2: -0.8 2^-974, outside the cone)");
# Restitution 1/2 and two masses, v_t negative: n = 1.385 2^-1074, f = +mu n.
assert_eq(_co41_si(0x07C8000000000000, 0x4AD8000000000000, 0x4ADC000000000000, 0x4C70000000000000, F64_HALF,
    0xD8F0000000000000, 4), 1, "sequential_impulse: restitution, two masses, a subnormal impulse is Ok");
assert_eq(load64(_co41_out), 1, "sequential_impulse: ... n rounds to 2^-1074");
assert_eq(load64(_co41_out + 8), 0x0956276276276276, "sequential_impulse: ... f = +mu n exact (CO2: +2^-1074 mu)");
# A pen below 2^-969 goes to the closed form at the gate: n = 9.6 2^-1074 (rounded to 10), the
# cone 0.6 2^-1010.
assert_eq(_co41_si(0x0188000000000000, 0x4474000000000000, 0, 0x43B0000000000000, 0, 0x4630000000000000, 1), 1,
  "sequential_impulse: a pen below 2^-969 under friction 2^60 is Ok");
assert_eq(load64(_co41_out), 10, "sequential_impulse: ... n = 9.6 2^-1074 rounds to 10 2^-1074");
assert_eq(load64(_co41_out + 8), 0x80C3333333333333, "sequential_impulse: ... f = -0.6 2^-1010 (CO2: -0.625 2^-1010)");
# Controls the routing must not move. Friction off: n as before, f +0.
assert_eq(_co41_si(0x07DC000000000000, 0x4AF4000000000000, 0, 0, 0, 0x4AF4000000000000, 2), 1,
  "sequential_impulse: control, friction 0 with a subnormal impulse is Ok");
assert_eq(load64(_co41_out) * 10 + (load64(_co41_out + 8) == 0), 11,
  "sequential_impulse: control, friction 0: n = 2^-1074 and f = +0");
# A tiny negative pen (closed form at the gate), a zero pen and a negative pen (the sweep): n = +0
# and the cone is 0, so f is a signed zero.
assert_eq(_co41_si(0x8188000000000000, F64_ONE, 0, F64_HALF, 0, F64_ONE, 1), 1,
  "sequential_impulse: control, pen -3 2^-1000 is Ok");
assert_eq(load64(_co41_out) == 0 && load64(_co41_out + 8) == 0x8000000000000000, 1,
  "sequential_impulse: control, pen -3 2^-1000: n = +0, f = -0");
assert_eq(_co41_si(0, F64_TWO, 0, F64_HALF, 0, F64_ONE, 2), 1, "sequential_impulse: control, pen 0 is Ok");
assert_eq(load64(_co41_out) == 0 && load64(_co41_out + 8) == 0x8000000000000000, 1,
  "sequential_impulse: control, pen 0: n = +0, f = -0");
assert_eq(_co41_si(0xBFD0000000000000, F64_TWO, 0, F64_HALF, 0, 0xBFF0000000000000, 2), 1,
  "sequential_impulse: control, pen -1/4 is Ok");
assert_eq(load64(_co41_out) == 0 && load64(_co41_out + 8) == 0, 1,
  "sequential_impulse: control, pen -1/4: n = +0, f = +0");
# Controls for the paths the routing sorts the impulse into, each as the CO2 tree answers it.
# pen -2^100 with e 2^1000: e pen overflows, so the sweep's impulse is -Inf where the exact one
# is negative (n = +0, and the cone 0 gives f = -0), at 1 and 2 sweeps; it must reach the
# closed form, not be clamped as a finite negative nor stored.
assert_eq(_co41_si(0xC630000000000000, F64_ONE, 0, F64_HALF, 0x7E70000000000000, F64_ONE, 1), 1,
  "sequential_impulse: control, -Inf from pen -2^100 and e 2^1000 is Ok");
assert_eq(load64(_co41_out) == 0 && load64(_co41_out + 8) == 0x8000000000000000, 1,
  "sequential_impulse: control, -Inf from e pen: n = +0, f = -0");
assert_eq(_co41_si(0xC630000000000000, F64_ONE, 0, F64_HALF, 0x7E70000000000000, F64_ONE, 2), 1,
  "sequential_impulse: control, ... at 2 sweeps is Ok");
assert_eq(load64(_co41_out) == 0 && load64(_co41_out + 8) == 0x8000000000000000, 1,
  "sequential_impulse: control, ... at 2 sweeps: n = +0, f = -0");
# A negative NaN inverse mass: its bits are negative, so the integer inverse-mass test takes it
# with the static bodies; it must still give NaN (f64_le is false for it), not the +0 of a skip.
assert_eq(_co41_si(0x3FD0000000000000, 0xFFF8000000000000, F64_ONE, F64_HALF, 0, F64_ONE, 2), 1,
  "sequential_impulse: control, a -NaN inverse mass is Ok");
assert_eq(f64_eq(load64(_co41_out), load64(_co41_out)) + f64_eq(load64(_co41_out + 8), load64(_co41_out + 8)), 0,
  "sequential_impulse: control, a -NaN inverse mass gives NaN in both slots (not a skip's +0)");
# A frame: the routed contacts and ordinary ones side by side, each with its own answer (the
# contacts do not couple), at 1 and 3 sweeps. The ordinary contact: pen 1/4, e 1/2, M 2, mu 1/2,
# v_t 1: n = 3/16, f = -3/32.
var _co41_fr = vec_new();
vec_push(_co41_fr, contact_new_fric(0, 1, hvec3_unit_y(), 0x3FD0000000000000, F64_HALF, F64_HALF, F64_ONE, F64_ONE,
    F64_ONE));
vec_push(_co41_fr, contact_new_fric(0, 1, hvec3_unit_y(), 0x07DC000000000000, 0x4630000000000000, 0, 0x4AF4000000000000,
    0, 0x4AF4000000000000));
vec_push(_co41_fr, contact_new_fric(0, 1, hvec3_unit_y(), 0, F64_HALF, 0, F64_TWO, 0, F64_ONE));
vec_push(_co41_fr, contact_new_fric(0, 1, hvec3_unit_y(), 0x07B0000000000000, 0x52B0000000000000, 0, 0x4C70000000000000,
    0, 0x4C70000000000000));
vec_push(_co41_fr, contact_new_fric(0, 1, hvec3_unit_y(), 0x3FD0000000000000, F64_HALF, F64_HALF, F64_ONE, F64_ONE,
    F64_ONE));
for (var it = 1; it <= 3; it = it + 2) {
    var _co41_ft, _co41_fv = sequential_impulse(_co41_fr, 5, it, _co41_out);
    assert_eq(is_ok(_co41_ft), 1, "sequential_impulse: the mixed frame is Ok");
    assert_eq(load64(_co41_out) == 0x3FC8000000000000 && load64(_co41_out + 8) == 0xBFB8000000000000, 1,
      "sequential_impulse: frame, the ordinary contact: n = 3/16, f = -3/32");
    assert_eq(load64(_co41_out + 16) == 1 && load64(_co41_out + 24) == 0x8316666666666666, 1,
      "sequential_impulse: frame, the subnormal impulse's exact cone after an ordinary contact");
    assert_eq(load64(_co41_out + 32) == 0 && load64(_co41_out + 40) == 0x8000000000000000, 1,
      "sequential_impulse: frame, the pen-0 contact after a routed one: n = +0, f = -0");
    assert_eq(load64(_co41_out + 48) == 0 && load64(_co41_out + 56) == 0x8DF0000000000000, 1,
      "sequential_impulse: frame, the underflowed impulse's cone");
    assert_eq(load64(_co41_out + 64) == 0x3FC8000000000000 && load64(_co41_out + 72) == 0xBFB8000000000000, 1,
      "sequential_impulse: frame, the ordinary contact after a routed one keeps its friction");
}

# === 3.4.1 GEO7: _geo_sph_graze past DBL_MAX ===
# R4 M2. sq e <= 12 delta q read Inf <= Inf once both sides overflowed, and a +Inf from |f|^2 |oc|^2 alone refused
# rays the bound passes. Each argument list is judged against the inequality in exact rationals (gz.py): the bound
# E = 4.25 sqrt(ff ococ) + 5 ff + rr + |delta| + 2^-46 ococ, the test sq E <= 12 delta (|hb| + sq).
# [measured: GEO7 3.4.1 gz.py / gzfix.py, exact Fraction oracle, s24 / this tree, 2026-11-01]
test_group("3.4.1 GEO7: _geo_sph_graze past DBL_MAX");
assert_eq(_geo_sph_graze(0x5B7C81B115ECBFB3, 0x5B4548DE63A99E6A, 0x7C8D94C8D17301F7, 0x7CCE4B8010CEF815,
    0x7CFE200D21A3616E, 0x7CD012664EF3141A), 0,
  "both sides past DBL_MAX, sq E = 2.11 times 12 delta q: refused (s24 Inf <= Inf certified it)");
assert_eq(_geo_sph_graze(0x52E412B549C7A42D, 0x518715ABD86F0736, 0x6DB6F2AC59EBB50B, 0x6DC5DD9903926F0E,
    0x707A31A49CB8AEA6, 0x6DD0AB77984424CA), 1,
  "both sides past DBL_MAX, sq E = 0.60 times 12 delta q, sq / q 2.7e-7: certified, not refused for its range");
assert_eq(_geo_sph_graze(0x4FC2586A117A245D, 0x4F0EDF2357B9EC32, 0x60219E14680FE8F9, 0x602B33B40D5CB011,
    0x619D38CFF52A2192, 0x603668E43AB64C85), 1,
  "|f|^2 |oc|^2 past DBL_MAX, both sides in range, sq E = 0.67 times 12 delta q: certified (s24 refused: e = +Inf)");
assert_eq(_geo_sph_graze(0, 0, 0xEBA0000000000000, 0x6BB8000000000000, 0x6BB0000000000000, 0x6BB0000000000000), 1,
  "a miss, |f|^2 |oc|^2 past DBL_MAX, 2^-52 E well under |delta|: certified (s24 refused: e = +Inf)");
assert_eq(_geo_sph_graze(0x5FB6A09E667F3BCD, 0x5FD6A09E667F3BCD, 0x7FC0000000000000, 0x7FE4000000000000,
    0x7FE8000000000000, 0x7FE8000000000000), 0,
  "the bound E itself past DBL_MAX, e = +Inf, sq E = 3.69 times 12 delta q: refused, not Inf <= Inf");
# On the boundary. hb 0, so sq / q = 1, and ff and ococ 0, so e = rr + delta: rr = 11 delta is sq E = 12 delta q
# exactly, past DBL_MAX, and the next rr is over.
assert_eq(_geo_sph_graze(0, 0x58F0000000000000, 0x6BB0000000000000, 0, 0, 0x6BE6000000000000), 1,
  "sq E = 12 delta q exactly, both past DBL_MAX: certified, the test is <=");
assert_eq(_geo_sph_graze(0, 0x58F0000000000000, 0x6BB0000000000000, 0, 0, 0x6BE6000000000001), 0,
  "one ulp of rr over: refused");
assert_eq(_geo_sph_graze(0x4000000000000000, 0x7FF0000000000000, 0x4000000000000000, 0x3FF0000000000000,
    0x4000000000000000, 0x4008000000000000), 0,
  "a +Inf sq never certifies");

# === 3.4.1 GEO7: geo_ray_sphere with the certificate past DBL_MAX ===
# R4 M2's scale map: rays within 4 ulps of tangency, r near 2^360 and 2^400, unit-size d (gs3.py rows). t exact
# by Fractions: each expected t below is within 0.06 ulp of it, s24's is 4e6 and 677 ulp off. The misses are b^2 < a c.
# And the second overflow of the same shape, _geo_sph_comp's: with |d| near 2^483 the better delta takes a delta past
# DBL_MAX, sq and q read +Inf, and the hit read the miss. Each t there within 1.3 ulp of the Fraction root.
# [measured: GEO7 3.4.1 gs3.py rows 360, 400, d 480, d 500, exact Fraction oracle, s24 / this tree, 2026-11-01]
test_group("3.4.1 GEO7: geo_ray_sphere with the certificate past DBL_MAX");
fn _g7_ray(ox, oy, oz, dx, dy, dz) {
    var ray = alloc(sizeof(GeoRay));
    GeoRay_set_origin(ray, hvec3_new(ox, oy, oz));
    GeoRay_set_direction(ray, hvec3_new(dx, dy, dz));
    return ray;
}
fn _g7_sp(ox, oy, oz, dx, dy, dz, cx, cy, cz, r) {
    return geo_ray_sphere(_g7_ray(ox, oy, oz, dx, dy, dz), geo_sphere_new(hvec3_new(cx, cy, cz), r));
}
assert_eq(_g7_sp(0xD97D3B7092CAD8CF, 0xD957C281AB68BDB7, 0x596D77364B304698, 0x400327685466274E, 0x3FDE9CB930DDC270,
    0xBFF33055B063B5AC, 0x58E048512BB32D2A, 0x58DD183A829BB409, 0x58E3528B03AAF322, 0x58FF2AD591EBA14F), 0,
  "exact miss, r 5.03e120 (s24 and 3.4.0: 0x596879107B9FE84A)");
assert_eq(_g7_sp(0xD6A414DD92EED0DA, 0x56BF83E56C311652, 0xD6C47B834E7C4151, 0x400235D2EF04F7BC, 0xC01942C045AD3C27,
    0x401999A23A5C71A4, 0x5680E08044F4899C, 0xD67BA3C16EF5D172, 0xD69248B2206D131A, 0x567ECB8D814467F1), 0,
  "exact miss, r near 2^361 (s24: 0x5695E0DF1B3068DC)");
assert_eq(_g7_sp(0x599C6FE6CE2A8D9F, 0x599751D13F928A66, 0x59A2CBADB43E51AB, 0xBFF73673AE27E78D, 0xBFEC122B95DE3DCE,
    0xC0113EDF32A94B0E, 0x58EA28DE03C1840A, 0x58FBA9C3D5E12960, 0x58ECE4F9DA8D13F2, 0x5994C4D1D3BCAC90),
  0x5984D80822D0A01B, "a hit, r near 2^410 (s24: 0x5984D808228CDB59)");
assert_eq(_g7_sp(0x5ADA13B77C7A3FBE, 0xDB0D2004411D8397, 0xDAFB8663A4F8E5E3, 0xBFE03C7FB8B9822A, 0x401222563252D7E5,
    0x4001234A6294C531, 0xD918E26BF52F6DA6, 0x591A9F4DB9B5AE60, 0xD8FFC09344DB59E2, 0x58FA52BE3A6B7861),
  0x5AE9B28CCC11A8E1, "a hit, r near 2^401 (s24: 0x5AE9B28CCC11A609)");
assert_eq(_g7_sp(0x437C39E99E02912B, 0xC382AC324535AE10, 0xC38743E7E47AA40E, 0xDE14E390720E021A, 0x5DECBE91D99D535F,
    0x5DE197B0A380A6C2, 0xBFFF2E89EA924D24, 0xBFD73B6AEBE141A2, 0x3FD8BA066F3002CE, 0x438AB58F6D0FBB32),
  0x255D1BC5FBBA84B7, "_geo_sph_comp: a delta past DBL_MAX, r 2^58, |d| 2^483 (s24: the miss)");
assert_eq(_g7_sp(0xC3966E27284ED4BC, 0xC3BC0497973AEF82, 0xC3B357ACAB79772E, 0xDE072DC18A0075A2, 0x5DE8F0375FDA0A03,
    0x5E0CC7D4ACCA9DE6, 0x3FF9DB8ADFAE251E, 0xBFEDF1667EEA41B4, 0x3FDCCC5D35DFB30F, 0x43BE8BCAA24628F3),
  0x258B67B8AAED713F, "_geo_sph_comp: a delta past DBL_MAX, r 2^61, |d| 2^483 (s24: the miss)");
assert_eq(_g7_sp(0x42A8D229B5741EEC, 0xC2A63F83A9BAA5DE, 0xC2A01D00417A7337, 0x5F18C3252EEEDA26, 0x5F5D50DF19BECEC0,
    0x5F452E31E53E1089, 0x3FD008FA3B967CCF, 0xBFE1A14447A365BB, 0x3FE8118CFD8CC514, 0x42AB2EB2E2CA5DE7),
  0x2339C5FA9FC41860, "_geo_sph_comp: a delta past DBL_MAX, r 2^44, |d| 2^503 (s24: the miss)");

# === 3.4.1 GEO7: geo_ray_capsule_branch with the caps' certificate past DBL_MAX ===
# R4 M2's capsule set: rays within 3 ulps of barrel tangency, coordinates near 2^300, raw d near 2^200 or 2^10 (gt.py
# capsule). Exact verdict and piece by Fractions; each t within 0.73 ulp of the Fraction root.
# [measured: GEO7 3.4.1 gc3.py set (scales 2^280), R4 repro, exact Fraction oracle, s24 / this tree, 2026-11-01]
test_group("3.4.1 GEO7: geo_ray_capsule_branch with the caps' certificate past DBL_MAX");
var _g7_out: i64[2];
fn _g7_cap(ray, sx, sy, sz, ex, ey, ez, r) {
    return geo_ray_capsule_branch(ray, geo_capsule_new(hvec3_new(sx, sy, sz), hvec3_new(ex, ey, ez), r), &_g7_out);
}
assert_eq(_g7_cap(_g7_ray(0x52827B3DBAB09148, 0xD249393A67D930B4, 0x5276A4EDA7AAA128, 0xCC618115DFBEB843,
      0x4C27E3D066D700C3, 0xBFD5726D28A20FDB), 0xD2800FE923262459, 0x5245415A7A7734A0, 0x5276A4D9AC54D27E,
    0xD2800FE923261AAB, 0x5245415A7A7727D1, 0x5276A4D9AC54C4DA, 0x51F53FC1BFBC2924), 0,
  "exact miss (R4's row; s24 and 3.4.0: 0x461F92622F492C0F on the start cap)");
assert_eq(load64(&_g7_out), GEO_FACE_NONE, "... and no piece");
assert_eq(_g7_cap(_g7_ray(0x54325E5A27F8A361, 0x5393E2E1CB25B928, 0x5430ED24B4095B1D, 0xBFE7761E6056C0F8,
      0x4C33D7FA53F130E4, 0xCC659E8B2B36921B), 0x54325B1B13334300, 0x5411372F3C571084, 0xD4336D01241AC743,
    0x54325B1B133335B2, 0x5411372F3C57040A, 0xD4336D01241AB92F, 0x53BD171C0CA0CBB5), 0,
  "exact miss (s24: 0x47CAE9B95D2AC20E)");
assert_eq(load64(&_g7_out), GEO_FACE_NONE, "... and no piece");
assert_eq(_g7_cap(_g7_ray(0x53DD88E1A9F87015, 0xD42184108DA266DD, 0x5440963685AC3534, 0x4C6F5010BB77132F,
      0x4067C5242073EB70, 0xBF46825CC0407D9A), 0x543609DB49D18FD0, 0xD41063A8A8751816, 0x5440DEA728FCF31B,
    0x543609DB49D1AE8C, 0xD41063A8A8752EF0, 0x5440DEA728FD0AA1, 0x5412C786F8694204), 0x47B60CF373E68294,
  "the start cap (s24: 0x47B60CF373DA17A1)");
assert_eq(_g7_cap(_g7_ray(0xD41BE1E0FE8C17F9, 0x5412D5D3FE8CA3E8, 0x53D3FC7DB54517BE, 0x40700E8C548076FF,
      0xBFC5B19209A32DE9, 0xCC0704F3492FCCEA), 0xD41EBEF4550F8A10, 0x540135F9C4073E4F, 0xD3D7534DE3D83658,
    0xD41EBEF4550F6A4F, 0x540135F9C4072C88, 0xD3D7534DE3D81E41, 0x54053F042201C581), 0x47CE1AC4BB6800F6,
  "the end cap (s24: 0x47CE1AC4BB3FFF25)");
assert_eq(_g7_cap(_g7_ray(0x532833EBF3C559E0, 0x532EF9AA009E7FC6, 0x53A190D4B1B4BF4D, 0x4C51D5D9243DC4CC,
      0xBF6D37A222063BF2, 0xBFE0919F7FF13B5D), 0x538ED91E69DEAE14, 0xD36374ABA6CFD63B, 0x53A17902E59AAA5F,
    0x538ED91E698DE680, 0xD36374ABA69CE3BB, 0x53A17902E56CE93D, 0x536571851B0569BE), 0x472B559E1773AD9B,
  "the barrel, a cap's false root gone (s24: 0x472B559E16E98AA6)");
assert_eq(load64(&_g7_out), GEO_CAP_CYLINDER, "... its piece");

# === 3.4.1 GEO7 F1: _geo_sphere_roots_full's hb gate where its squares flush ===
# An origin near the tangent point of a sphere near 2^-449, |d| near 2^-278: hb^2 and |oc|^2 a / 16 both flush, the
# gate read 0 < 0, and the hb that cancels stayed plain. Fraction root 0x33D1B43CE5093F63; 3.4.0 and this
# 0x33D1B43CE5093F62, s24 7.4e4 ulp off.
# [measured: GEO7 3.4.1 samp.py near-surface family, exact Fraction oracle, 3.4.0 / s24 / this tree, 2026-11-01]
test_group("3.4.1 GEO7 F1: _geo_sphere_roots_full's hb gate where its squares flush");
assert_eq(_g7_sp(0xA5A94E1C1779A631, 0xA5ADDD88B53A8162, 0xA59BE3211B9BE763, 0xAE5B10CD3B214AB8, 0x2E992CE7558A70A2,
    0xAE7B86D2BB6E5CC6, 0xA5A94E1C182BB9B2, 0xA5ADDD88B50D797F, 0xA59BE32119FAE1DA, 0x23E15E086FB8058F),
  0x33D1B43CE5093F62, "the near root, within 1 ulp (s24: 0x33D1B43CE50A5ED0)");

var r = assert_summary();
# Clamp before exiting: assert_summary() returns the raw failure COUNT, and a wait
# status is only 8 bits — an unclamped 256 / 512 / 768 failures would exit 0 and
# score PASS. Any failure at all is exit 1. (cyrius 6.5.6 fixed the same hole in
# its own scaffold template; verified here — 256 failures scored PASS before this.)
# [measured: CHANGELOG.md 2.6.11, "Test suites could report PASS with 256 failing assertions" (its epilogue table)]
if (r > 0) { r = 1; }
sys_exit_group(r);
