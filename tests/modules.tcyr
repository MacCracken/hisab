    GeoRay_set_origin(_s5_nr, hvec3_new(0, 0, 0));
    GeoRay_set_direction(_s5_nr, _s5_perm(_s5_k, F64_ONE, 1, 1));
    var _s5_nx = alloc(sizeof(GeoAabb));
    GeoAabb_set_min(_s5_nx, _s5_perm(_s5_k, 0x7FF8000000000000, 0x4008000000000000, 0xBFF0000000000000));
    GeoAabb_set_max(_s5_nx, _s5_perm(_s5_k, F64_ONE, 0x4010000000000000, F64_ONE));
    if (_bvh_ray_hits_aabb(_s5_nr, _s5_nx) != 0) { _S5_NBAD = _S5_NBAD + 1; }
}
assert_eq(_S5_NBAD, 0, "_bvh_ray_hits_aabb: a NaN slab on x, y or z, the other two missing past DBL_MAX -> 0");

test_group("3.3.6 geo: slab crossings that overflow or underflow are ordered exactly");
# geo_ray_aabb_face and geo_ray_obb_face send a box whose b - o (or e -+ he) overflowed,
# or whose deciding t is zero or subnormal, to the exact order (_geo_slabs_exact); the BVH
# predicate sends a zero or subnormal t_min or t_max to _bvh_far_meets. Expected values
# are from an exact rational oracle; each loop runs the overflowed or underflowed slab on
# x, y and z in turn.
# [measured: C336 fixture probe and exact Fraction oracle, 3.3.5 vs this tree, 2026-10-11; cycc 6.6.14]
var _s6_fo = alloc(GEO_FACE_OUT_BYTES);
fn _s6_ray(k, ox, oy, oz, dx, dy, dz) {
    var r = alloc(sizeof(GeoRay));
    GeoRay_set_origin(r, _s5_perm(k, ox, oy, oz));
    GeoRay_set_direction(r, _s5_perm(k, dx, dy, dz));
    return r;
}
fn _s6_box(k, x0, y0, z0, x1, y1, z1) {
    var b = alloc(sizeof(GeoAabb));
    GeoAabb_set_min(b, _s5_perm(k, x0, y0, z0));
    GeoAabb_set_max(b, _s5_perm(k, x1, y1, z1));
    return b;
}
# The roadmap's false hit: from -2^1023 along d = (4, 1, 0) the slab [-DBL_MAX, 2^1023] is
# left at 2^1022 (b - o = 2^1024 read +Inf), before [1.5 * 2^1022, DBL_MAX] is entered:
# the miss, NONE and the miss jet; mirrored (o = 2^1023, d = -4) too.
var _S6_ABAD = 0;
for (var _s6_k = 0; _s6_k < 6; _s6_k = _s6_k + 1) {
    var _s6_oa = 0xFFE0000000000000;
    var _s6_da = 0x4010000000000000;
    var _s6_lo = 0xFFEFFFFFFFFFFFFF;
    var _s6_hi = 0x7FE0000000000000;
    if (_s6_k >= 3) {
        _s6_oa = 0x7FE0000000000000;
        _s6_da = 0xC010000000000000;
        _s6_lo = 0xFFE0000000000000;
        _s6_hi = 0x7FEFFFFFFFFFFFFF;
    }
    var _s6_ar = _s6_ray(_s6_k % 3, _s6_oa, 0, 0, _s6_da, F64_ONE, 0);
    var _s6_ab = _s6_box(_s6_k % 3, _s6_lo, 0x7FD8000000000000, 0xBFF0000000000000, _s6_hi, 0x7FEFFFFFFFFFFFFF,
      F64_ONE);
    if (geo_ray_aabb_face(_s6_ar, _s6_ab, _s6_fo) != 0) { _S6_ABAD = _S6_ABAD + 1; }
    if (load64(_s6_fo) != GEO_FACE_NONE) { _S6_ABAD = _S6_ABAD + 1; }
    if (geo_jet_hit(geo_jet_aabb(_s6_ar, _s6_ab)) != 0) { _S6_ABAD = _S6_ABAD + 1; }
}
assert_eq(_S6_ABAD, 0,
  "geo_ray_aabb_face: exit read +Inf (b - o overflowed) before an entry -> 0, NONE, miss jet (3.3.5: 1.5*2^1022)");
assert_eq(geo_ray_aabb(_s6_ray(0, 0xFFE0000000000000, 0, 0, 0x4010000000000000, F64_ONE, 0),
    _s6_box(0, 0xFFEFFFFFFFFFFFFF, 0x7FD8000000000000, 0xBFF0000000000000, 0x7FE0000000000000, 0x7FEFFFFFFFFFFFFF,
      F64_ONE)), 0, "geo_ray_aabb: the same pair is the miss 0");
# The false miss the other way: [2^1023, DBL_MAX] entered at t = 2^1022 (b - o read
# +Inf), [-1, 2^1023] on the next axis left at 2^1023 -> the hit at 2^1022 on the entry's
# min face; through the y and z slabs' early miss tests (3.3.5: the miss 0).
var _S6_EBAD = 0;
for (var _s6_k = 0; _s6_k < 3; _s6_k = _s6_k + 1) {
    var _s6_er = _s6_ray(_s6_k, 0xFFE0000000000000, 0, 0, 0x4010000000000000, F64_ONE, 0);
    var _s6_eb = _s6_box(_s6_k, 0x7FE0000000000000, 0xBFF0000000000000, 0xBFF0000000000000, 0x7FEFFFFFFFFFFFFF,
      0x7FE0000000000000, F64_ONE);
    if (geo_ray_aabb_face(_s6_er, _s6_eb, _s6_fo) != 0x7FD0000000000000) { _S6_EBAD = _S6_EBAD + 1; }
    if (load64(_s6_fo) != 2 * _s6_k) { _S6_EBAD = _S6_EBAD + 1; }
}
assert_eq(_S6_EBAD, 0, "geo_ray_aabb_face: entry 2^1022 read +Inf before a finite exit -> t = 2^1022, face 2k, xyz");
# Both crossings of the only crossed slab overflow (t_min = t_max = +Inf at the tail):
# [2^1023, DBL_MAX] from -2^1023 along d_k = 4 is entered at 2^1022 (3.3.5: the miss 0).
var _S6_TBAD = 0;
for (var _s6_k = 0; _s6_k < 3; _s6_k = _s6_k + 1) {
    var _s6_tr = _s6_ray(_s6_k, 0xFFE0000000000000, 0, 0, 0x4010000000000000, 0, 0);
    var _s6_tb = _s6_box(_s6_k, 0x7FE0000000000000, 0xBFF0000000000000, 0xBFF0000000000000, 0x7FEFFFFFFFFFFFFF,
      F64_ONE, F64_ONE);
    if (geo_ray_aabb_face(_s6_tr, _s6_tb, _s6_fo) != 0x7FD0000000000000) { _S6_TBAD = _S6_TBAD + 1; }
}
assert_eq(_S6_TBAD, 0, "geo_ray_aabb_face: both crossings read +Inf -> the entry 2^1022, xyz (3.3.5: 0)");
# The exact order is reached from the y slab's miss test before z was read: z is parallel
# with the origin outside it (z = 5, the slab [-1, 1]), so the answer is the miss.
assert_eq(geo_ray_aabb_face(_s5_ray(0xFFE0000000000000, 0, 0x4014000000000000, 0x4010000000000000, F64_ONE, 0),
    _s5_box(0x7FE0000000000000, 0xBFF0000000000000, 0xBFF0000000000000, 0x7FEFFFFFFFFFFFFF, 0x7FE0000000000000,
      F64_ONE), _s6_fo), 0, "geo_ray_aabb_face: ... with a later parallel slab missed -> the miss 0");
# The roadmap's -0 exit: from 0 along (2^1000, 1, 0) the slab [-1, -2^-1074] is left at
# t = -2^-2074, which reads -0: the miss for the face routine, the plain t, the jet, the
# BVH predicate and the one-box query (3.3.5: t = -0 on face 1, and a hit for the rest).
var _S6_ZBAD = 0;
for (var _s6_k = 0; _s6_k < 3; _s6_k = _s6_k + 1) {
    var _s6_zr = _s6_ray(_s6_k, 0, 0, 0, 0x7E70000000000000, F64_ONE, 0);
    var _s6_zb = _s6_box(_s6_k, 0xBFF0000000000000, 0xBFF0000000000000, 0xBFF0000000000000, 0x8000000000000001,
      F64_ONE, F64_ONE);
    if (geo_ray_aabb_face(_s6_zr, _s6_zb, _s6_fo) != 0) { _S6_ZBAD = _S6_ZBAD + 1; }
    if (load64(_s6_fo) != GEO_FACE_NONE) { _S6_ZBAD = _S6_ZBAD + 1; }
    if (geo_jet_hit(geo_jet_aabb(_s6_zr, _s6_zb)) != 0) { _S6_ZBAD = _S6_ZBAD + 1; }
    if (_bvh_ray_hits_aabb(_s6_zr, _s6_zb) != 0) { _S6_ZBAD = _S6_ZBAD + 1; }
    store64(_s5_arr, _s6_zb);
    if (vec_len(bvh_query_ray(bvh_build(_s5_arr, 1), _s6_zr)) != 0) { _S6_ZBAD = _S6_ZBAD + 1; }
}
assert_eq(_S6_ZBAD, 0, "exit -2^-2074 read -0: face routine, jet, BVH predicate and query all miss, xyz");
assert_eq(geo_ray_aabb(_s6_ray(0, 0, 0, 0, 0x7E70000000000000, F64_ONE, 0),
    _s6_box(0, 0xBFF0000000000000, 0xBFF0000000000000, 0xBFF0000000000000, 0x8000000000000001, F64_ONE, F64_ONE)), 0,
  "geo_ray_aabb: ... the plain t is +0, the miss (3.3.5: -0)");
# The same -0 exit on z from an origin OFF the plane z = 0, where max.z + o.z is not max.z - o.z
# (seed-336 mutant m0049 formed the former and saw no underflow): from (0, 0, 1) along
# 1.5 * 2^1022 z the slab [-1, 1 - 2^-53] is entered at -2 / (1.5 * 2^1022), a normal t, and
# left at -2^-53 / (1.5 * 2^1022), under 2^-1075 in magnitude, which reads -0. The box is
# behind the origin: the miss 0, with no face.
var _mt49_r = _s5_ray(0, 0, F64_ONE, 0, 0, 0x7FD8000000000000);
var _mt49_b = _s5_box(0xBFF0000000000000, 0xBFF0000000000000, 0xBFF0000000000000, F64_ONE, F64_ONE,
  0x3FEFFFFFFFFFFFFF);
assert_eq(geo_ray_aabb_face(_mt49_r, _mt49_b, _s6_fo), 0,
  "geo_ray_aabb_face: z exit -2^-53 / (1.5 * 2^1022) read -0 from o.z = 1 -> the miss 0");
assert_eq(load64(_s6_fo), GEO_FACE_NONE, "geo_ray_aabb_face: ... with GEO_FACE_NONE");
# An entry that underflowed to -0 with the origin inside: from x = 2^-1074 along
# (2^60, 1, 0), [0, 1] is entered at -2^-1134 (reads -0) and left at 2^-60, which is the
# answer, on face 1 (3.3.5: t = -0 on face 0, the entry read as the origin's own plane).
assert_eq(geo_ray_aabb_face(_s6_ray(0, 1, 0, 0, 0x43B0000000000000, F64_ONE, 0),
    _s6_box(0, 0, 0xBFF0000000000000, 0xBFF0000000000000, F64_ONE, F64_ONE, F64_ONE), _s6_fo), 0x3C30000000000000,
  "geo_ray_aabb_face: entry -2^-1134 read -0, origin inside -> the exit 2^-60 (3.3.5: -0)");
assert_eq(load64(_s6_fo), 1, "geo_ray_aabb_face: ... on face 1, the plane at max.x");
# An entry at +2^-2074 (reads +0) against an exit at exactly 0 (the origin on y's max
# plane, moving out): the entry is after the exit, the miss (3.3.5: the BVH a hit, and
# the face routine t = +0 on face 0 with a tie).
var _s6_ur = _s6_ray(0, 0x8000000000000001, F64_ONE, 0, 0x7E70000000000000, F64_ONE, 0);
var _s6_ub = _s6_box(0, 0, 0xBFF0000000000000, 0xBFF0000000000000, F64_ONE, F64_ONE, F64_ONE);
assert_eq(_bvh_ray_hits_aabb(_s6_ur, _s6_ub), 0, "_bvh_ray_hits_aabb: entry +2^-2074 after the exit 0 -> 0 (3.3.5: 1)");
assert_eq(geo_ray_aabb_face(_s6_ur, _s6_ub, _s6_fo), 0, "geo_ray_aabb_face: ... the miss 0");
assert_eq(load64(_s6_fo), GEO_FACE_NONE, "geo_ray_aabb_face: ... with GEO_FACE_NONE (3.3.5: face 0)");
# geo_ray_obb_face: the AABB's 3.3.5 slab shape (row 3). OBB centre (1.5, 0, 0),
# half-extents (0.5, 2^1008, 0.5), identity; from x = 1 - 2^-40 along (2^-1030, 1, 0) it
# enters the x slab at t = 2^990 exactly (3.3.5: the miss 0, f_x read as parallel), on
# each axis, and mirrored (from x = 2 + 2^-39 along -2^-1030) through the max face.
var _S6_OBAD = 0;
for (var _s6_k = 0; _s6_k < 6; _s6_k = _s6_k + 1) {
    var _s6_ox = 0x3FEFFFFFFFFFE000;
    var _s6_dx = 0x0000100000000000;
    var _s6_face = 2 * (_s6_k % 3);
    if (_s6_k >= 3) {
        _s6_ox = 0x4000000000001000;   # 2 + 2^-39
        _s6_dx = 0x8000200000000000;   # -2^-1029
        _s6_face = _s6_face + 1;
    }
    var _s6_obb = geo_obb_new(_s5_perm(_s6_k % 3, 0x3FF8000000000000, 0, 0),
      _s5_perm(_s6_k % 3, F64_HALF, 0x7EF0000000000000, F64_HALF), hquat_identity());
    var _s6_orr = _s6_ray(_s6_k % 3, _s6_ox, 0, 0, _s6_dx, F64_ONE, 0);
    if (geo_ray_obb_face(_s6_orr, _s6_obb, _s6_fo) != 0x7DD0000000000000) { _S6_OBAD = _S6_OBAD + 1; }
    if (load64(_s6_fo) != _s6_face) { _S6_OBAD = _S6_OBAD + 1; }
}
assert_eq(_S6_OBAD, 0, "geo_ray_obb_face: subnormal f_k divides, entry t = 2^990, xyz, +-d (3.3.5: the miss 0)");
# The OBB's exit underflowing to -0: centre (-3, 0, 0) * 2^-1074, half-extent 2 * 2^-1074,
# from 0 along (2^1000, 1, 0): both x crossings are behind the origin by under 2^-1075
# (3.3.5: t = -0 on face 0). And e + he = 2^1023 + 2^1023 overflowing: centre
# (2^1022, 1.5 * 2^1022, 0), half-extents (2^1023, 2^1020, 1), from x = -2^1022 along
# (4, 1, 0), x left at 2^1022 before y entered at 1.25 * 2^1022 (3.3.5: 1.25 * 2^1022, face 2).
assert_eq(geo_ray_obb_face(_s5_ray(0, 0, 0, 0x7E70000000000000, F64_ONE, 0), geo_obb_new(
      hvec3_new(0x8000000000000003, 0, 0), hvec3_new(2, F64_ONE, F64_ONE), hquat_identity()), _s6_fo), 0,
  "geo_ray_obb_face: both x crossings read -0 behind the origin -> the miss 0 (3.3.5: -0)");
assert_eq(load64(_s6_fo), GEO_FACE_NONE, "geo_ray_obb_face: ... with GEO_FACE_NONE");
# The OBB's axis-1 exit underflowing to -0 behind a normal entry, axes 0 and 2 parallel with
# the origin inside them (seed-336 mutant m0053 tested e - he twice and never the exit's
# e + he): centre (0, -1, 0), he.y = 1 - 2^-53, from 0 along 1.5 * 2^1022 y. The entry
# (e - he) / f, about -2 / (1.5 * 2^1022), is normal; the exit -2^-53 / (1.5 * 2^1022) reads
# -0, and the box is behind the origin: the miss.
var _mt53_b = geo_obb_new(hvec3_new(0, 0xBFF0000000000000, 0), hvec3_new(F64_ONE, 0x3FEFFFFFFFFFFFFF, F64_ONE),
  hquat_identity());
assert_eq(geo_ray_obb_face(_s5_ray(0, 0, 0, 0, 0x7FD8000000000000, 0), _mt53_b, _s6_fo), 0,
  "geo_ray_obb_face: axis-1 exit read -0 behind a normal entry -> the miss 0");
assert_eq(load64(_s6_fo), GEO_FACE_NONE, "geo_ray_obb_face: ... with GEO_FACE_NONE");
assert_eq(geo_ray_obb_face(_s5_ray(0xFFD0000000000000, 0, 0, 0x4010000000000000, F64_ONE, 0), geo_obb_new(
      hvec3_new(0x7FD0000000000000, 0x7FD8000000000000, 0), hvec3_new(0x7FE0000000000000, 0x7FB0000000000000,
        F64_ONE), hquat_identity()), _s6_fo), 0,
  "geo_ray_obb_face: exit e + he = 2^1024 read +Inf before the y entry -> the miss 0 (3.3.5: 1.25 * 2^1022)");
# The exact order's own steps, each where it decides the answer: a parallel slab with the
# origin below it (z = -5); an exit whose b - o = DBL_MAX + 2^1023 rounds to 1.5 * 2^1024
# (crossing 1.5 * 2^1022, formed halved) against an entry at 1.25 * 2^1022, between it and
# the 2^1022 that an unhalved or a not re-doubled difference would read; a subnormal
# b - o, 2^-1074 / 4, against an entry at 2^-1060; two entries tied at 2^-1060; an entry
# equal to the exit; and an exit exactly at the origin (t = +0 on its face).
assert_eq(geo_ray_aabb_face(_s5_ray(0xFFE0000000000000, 0, 0xC014000000000000, 0x4010000000000000, F64_ONE, 0),
    _s5_box(0x7FE0000000000000, 0xBFF0000000000000, 0xBFF0000000000000, 0x7FEFFFFFFFFFFFFF, 0x7FE0000000000000,
      F64_ONE), _s6_fo), 0, "geo_ray_aabb_face: ... a later parallel slab missed from below -> the miss 0");
var _S6_XBAD = 0;
for (var _s6_k = 0; _s6_k < 3; _s6_k = _s6_k + 1) {
    var _s6_xr = _s6_ray(_s6_k, 0xFFE0000000000000, 0, 0, 0x4010000000000000, F64_ONE, 0);
    var _s6_xb = _s6_box(_s6_k, 0xFFEFFFFFFFFFFFFF, 0x7FD4000000000000, 0xBFF0000000000000, 0x7FEFFFFFFFFFFFFF,
      0x7FEFFFFFFFFFFFFF, F64_ONE);
    if (geo_ray_aabb_face(_s6_xr, _s6_xb, _s6_fo) != 0x7FD4000000000000) { _S6_XBAD = _S6_XBAD + 1; }
    if (load64(_s6_fo) != 2 * ((_s6_k + 1) % 3)) { _S6_XBAD = _S6_XBAD + 1; }
}
assert_eq(_S6_XBAD, 0, "geo_ray_aabb_face: exit 1.5 * 2^1022 (b - o overflowed) after entry 1.25 * 2^1022 -> hit, xyz");
assert_eq(geo_ray_aabb_face(_s5_ray(0, 0, 0, 0x4010000000000000, 0x43B0000000000000, F64_ONE),
    _s5_box(1, 0x0170000000000000, 0xBFF0000000000000, F64_ONE, F64_ONE, F64_ONE), _s6_fo), 0x4000,
  "geo_ray_aabb_face: entry 2^-1060 after a subnormal b - o's 2^-1076 -> t = 2^-1060");
assert_eq(load64(_s6_fo), 2, "geo_ray_aabb_face: ... on face 2");
assert_eq(geo_ray_aabb_face(_s5_ray(0, 0, 0, 0x43B0000000000000, 0x43B0000000000000, F64_ONE),
    _s5_box(0x0170000000000000, 0x0170000000000000, 0xBFF0000000000000, F64_ONE, F64_ONE, F64_ONE), _s6_fo), 0x4000,
  "geo_ray_aabb_face: entries tied at 2^-1060 -> t = 2^-1060");
assert_eq(load64(_s6_fo + 8), 1, "geo_ray_aabb_face: ... with the tie flag");
assert_eq(geo_ray_aabb_face(_s5_ray(0, 0, 0, 0x43B0000000000000, 0x43B0000000000000, F64_ONE),
    _s5_box(0x0170000000000000, 0xBFF0000000000000, 0xBFF0000000000000, F64_ONE, 0x0170000000000000, F64_ONE),
    _s6_fo), 0x4000, "geo_ray_aabb_face: entry = exit = 2^-1060 -> t = 2^-1060");
assert_eq(load64(_s6_fo + 8), 1, "geo_ray_aabb_face: ... with the tie flag");
assert_eq(geo_ray_aabb_face(_s5_ray(F64_ONE, F64_HALF, F64_HALF, F64_ONE, 0x3FD0000000000000, 0x3FD0000000000000),
    _s5_box(0, 0, 0, F64_ONE, F64_ONE, F64_ONE), _s6_fo), 0,
  "geo_ray_aabb_face: origin ON the max-x face moving out: +0");
assert_eq(load64(_s6_fo), 1, "geo_ray_aabb_face: ... the contact on face 1");
# A non-finite input never reaches the exact order (_geo_ray_aabb_finite), which reads an
# infinity as a finite value of exponent 1025. Each of these reaches a trigger and keeps
# its 3.3.5 answer: an origin at -Inf on x, a direction +Inf on x, min.x = -Inf, max.x =
# +Inf (the exact order would answer 2^925, +0 on face 1, the miss, the miss).
assert_eq(geo_ray_aabb_face(_s5_ray(0xFFF0000000000000, 0, 0, 0x4630000000000000, F64_ONE, 0),
    _s5_box(0xBFF0000000000000, 0x79C0000000000000, 0xBFF0000000000000, F64_ONE, 0x7FEFFFFFFFFFFFFF, F64_ONE),
    _s6_fo), 0, "geo_ray_aabb_face: origin -Inf on x -> the miss 0, as in 3.3.5");
assert_eq(geo_ray_aabb_face(_s5_ray(0, 0, 0, 0x7FF0000000000000, F64_ONE, F64_ONE), _s5_box(0xBFF0000000000000,
      0xBFF0000000000000, 0xBFF0000000000000, F64_ONE, F64_ONE, F64_ONE), _s6_fo), 0x8000000000000000,
  "geo_ray_aabb_face: direction +Inf on x -> -0 on face 0, as in 3.3.5");
assert_eq(load64(_s6_fo), 0, "geo_ray_aabb_face: ... face 0");
assert_eq(geo_ray_aabb_face(_s5_ray(0, 0, 0, 0xC630000000000000, F64_ONE, 0), _s5_box(0xFFF0000000000000,
      0x7E70000000000000, 0xBFF0000000000000, F64_ONE, 0x7FEFFFFFFFFFFFFF, F64_ONE), _s6_fo), 0x7E70000000000000,
  "geo_ray_aabb_face: min.x = -Inf, entry 2^1000 on y -> 2^1000, as in 3.3.5");
assert_eq(geo_ray_aabb_face(_s5_ray(0, 0, 0, 0x4630000000000000, F64_ONE, 0), _s5_box(0xBFF0000000000000,
      0x7E70000000000000, 0xBFF0000000000000, 0x7FF0000000000000, 0x7FEFFFFFFFFFFFFF, F64_ONE), _s6_fo),
  0x7E70000000000000, "geo_ray_aabb_face: max.x = +Inf, entry 2^1000 on y -> 2^1000, as in 3.3.5");
# geo_ray_obb_face on each axis: the exit e + he = 2^1024 read +Inf (the miss); an exit
# (e + he) / f = -2^-53 / 2^1023 read -0 with the origin outside behind it (the miss;
# 3.3.5: -0 on face 2k + 1); and t = 5 / 3, one quotient, on the entry and on the exit
# face (3.3.5: 5 * RN(1/3), 1 ulp under).
var _S6_OFBAD = 0;
var _S6_OZBAD = 0;
var _S6_ODBAD = 0;
for (var _s6_k = 0; _s6_k < 3; _s6_k = _s6_k + 1) {
    var _s6_fr = _s6_ray(_s6_k, 0xFFD0000000000000, 0, 0, 0x4010000000000000, F64_ONE, 0);
    var _s6_fb = geo_obb_new(_s5_perm(_s6_k, 0x7FD0000000000000, 0x7FD8000000000000, 0),
      _s5_perm(_s6_k, 0x7FE0000000000000, 0x7FB0000000000000, F64_ONE), hquat_identity());
    if (geo_ray_obb_face(_s6_fr, _s6_fb, _s6_fo) != 0) { _S6_OFBAD = _S6_OFBAD + 1; }
    if (load64(_s6_fo) != GEO_FACE_NONE) { _S6_OFBAD = _S6_OFBAD + 1; }
    var _s6_zr = _s6_ray(_s6_k, 0, 0, 0, 0x7FE0000000000000, F64_ONE, 0);
    var _s6_zb = geo_obb_new(_s5_perm(_s6_k, 0xBFE0000000000001, 0, 0), _s5_perm(_s6_k, F64_HALF, F64_ONE, F64_ONE),
      hquat_identity());
    if (geo_ray_obb_face(_s6_zr, _s6_zb, _s6_fo) != 0) { _S6_OZBAD = _S6_OZBAD + 1; }
    if (load64(_s6_fo) != GEO_FACE_NONE) { _S6_OZBAD = _S6_OZBAD + 1; }
    var _s6_er = _s6_ray(_s6_k, 0xC018000000000000, 0, 0, 0x4008000000000000, F64_ONE, F64_ONE);
    var _s6_eb = geo_obb_new(hvec3_zero(), _s5_perm(_s6_k, F64_ONE, 0x4010000000000000, 0x4010000000000000),
      hquat_identity());
    if (geo_ray_obb_face(_s6_er, _s6_eb, _s6_fo) != 0x3FFAAAAAAAAAAAAB) { _S6_ODBAD = _S6_ODBAD + 1; }
    if (load64(_s6_fo) != 2 * _s6_k) { _S6_ODBAD = _S6_ODBAD + 1; }
    var _s6_xr = _s6_ray(_s6_k, 0, 0, 0, 0x4008000000000000, F64_ONE, F64_ONE);
    var _s6_xb = geo_obb_new(hvec3_zero(), _s5_perm(_s6_k, 0x4014000000000000, 0x4024000000000000, 0x4024000000000000),
      hquat_identity());
    if (geo_ray_obb_face(_s6_xr, _s6_xb, _s6_fo) != 0x3FFAAAAAAAAAAAAB) { _S6_ODBAD = _S6_ODBAD + 1; }
    if (load64(_s6_fo) != 2 * _s6_k + 1) { _S6_ODBAD = _S6_ODBAD + 1; }
}
assert_eq(_S6_OFBAD, 0, "geo_ray_obb_face: exit e + he read +Inf before the next axis's entry -> the miss, xyz");
assert_eq(_S6_OZBAD, 0, "geo_ray_obb_face: exit -2^-1076 read -0, origin outside -> the miss, xyz (3.3.5: -0)");
assert_eq(_S6_ODBAD, 0, "geo_ray_obb_face: t = RN(5/3) on the entry and the exit face, xyz (3.3.5: 1 ulp under)");
# A non-finite e, f or he keeps the slab arithmetic: e = +Inf against a subnormal f on
# axis 0 or 1, and e = NaN (0 * Inf) against one on axis 2, stay parallel (the crossing
# would give NaN); f = +Inf on every axis of a rotated box keeps -0 on face 0 (the exact
# order: +0 on face 1); he = +Inf on axis k keeps the next axis's entry 2^1000 (the
# exact order would read the exit as 2^925, the miss).
# q = (1, 2, 3, 9) / sqrt(95), each component rounded once
var _s6_q = hquat_new(0x3FBA43DA0ADC6899, 0x3FCA43DA0ADC6899, 0x3FD3B2E388254E73, 0x3FED8C554C37F5AD);
var _S6_ONBAD = 0;
for (var _s6_k = 0; _s6_k < 2; _s6_k = _s6_k + 1) {
    if (geo_ray_obb_face(_s6_ray(_s6_k, 0xFFF0000000000000, 0, 0, 1, F64_ONE, F64_ONE), geo_obb_new(hvec3_zero(),
          hvec3_one(), hquat_identity()), _s6_fo) != 0) { _S6_ONBAD = _S6_ONBAD + 1; }
}
if (geo_ray_obb_face(_s5_ray(0, 0, 0, 0xBFF0000000000000, 0, 1), geo_obb_new(hvec3_new(0x7FF0000000000000, 0, 0),
      hvec3_one(), hquat_identity()), _s6_fo) != 0) { _S6_ONBAD = _S6_ONBAD + 1; }
assert_eq(_S6_ONBAD, 0, "geo_ray_obb_face: e = +-Inf or NaN against a subnormal f stays parallel: the miss 0");
assert_eq(geo_ray_obb_face(_s5_ray(0, 0, 0, 0x7FF0000000000000, 0, 0), geo_obb_new(hvec3_zero(), hvec3_one(), _s6_q),
    _s6_fo), 0x8000000000000000, "geo_ray_obb_face: d = (+Inf, 0, 0), a rotated box: -0, as in 3.3.5");
assert_eq(load64(_s6_fo), 0, "geo_ray_obb_face: ... on face 0");
var _S6_OHBAD = 0;
for (var _s6_k = 0; _s6_k < 3; _s6_k = _s6_k + 1) {
    var _s6_hb = geo_obb_new(_s5_perm(_s6_k, 0, 0x7E78000000000000, 0),
      _s5_perm(_s6_k, 0x7FF0000000000000, 0x7E60000000000000, F64_ONE), hquat_identity());
    var _s6_hr = _s6_ray(_s6_k, 0, 0, 0, 0x4630000000000000, F64_ONE, 0);
    if (geo_ray_obb_face(_s6_hr, _s6_hb, _s6_fo) != 0x7E70000000000000) { _S6_OHBAD = _S6_OHBAD + 1; }
}
assert_eq(_S6_OHBAD, 0, "geo_ray_obb_face: he = +Inf on axis k, entry 2^1000 on the next -> 2^1000, xyz");
# The exact order's triggers and steps where only they decide (the C1 review's fixtures,
# from 0 along (4, 4, 0) unless stated): the entries 3 * 2^-1074 / 4 and 5 * 2^-1074 / 4
# round to the same 2^-1074, but the y one is later (t_min subnormal); the exits likewise
# (t_max subnormal); an entry 5 * 2^-1074 / 4 after the exit 3 * 2^-1074 / 4 (the BVH
# predicate's t_max subnormal); along (2, 2^53, 0) a crossing whose numerator is subnormal
# (_geo_frexp's 2^64 renormalisation); along (1.75, 1, 0) a mantissa quotient below 1
# (_geo_xcross's renormalisation); and the OBB's t_min subnormal. Exact orders; 3.3.5 had a
# tie, face 0 or a hit for each.
# [measured: C336 probe of the C1 review fixtures, exact orders, 3.3.5 vs this tree, 2026-10-11; cycc 6.6.14]
var _s6_d44 = 0x4010000000000000;
assert_eq(geo_ray_aabb_face(_s5_ray(0, 0, 0, _s6_d44, _s6_d44, 0), _s5_box(3, 5, 0xBFF0000000000000, F64_ONE,
      F64_ONE, F64_ONE), _s6_fo), 1, "geo_ray_aabb_face: entries 3/4 and 5/4 of 2^-1074 both read 2^-1074: t");
assert_eq(load64(_s6_fo), 2, "geo_ray_aabb_face: ... on y's face 2, the later one (3.3.5: face 0)");
assert_eq(load64(_s6_fo + 8), 0, "geo_ray_aabb_face: ... no tie (3.3.5: a tie)");
var _s6_jb = _s5_box(3, 5, 0xBFF0000000000000, F64_ONE, F64_ONE, F64_ONE);
assert_eq(geo_jet_hit(geo_jet_aabb(_s5_ray(0, 0, 0, _s6_d44, _s6_d44, 0), _s6_jb)), 1,
  "geo_jet_aabb: ... a hit jet (3.3.5: the tie's miss jet)");
assert_eq(geo_ray_aabb_face(_s5_ray(0, 0, 0, _s6_d44, _s6_d44, 0), _s5_box(0xBFF0000000000000, 0xBFF0000000000000,
      0xBFF0000000000000, 3, 5, F64_ONE), _s6_fo), 1, "geo_ray_aabb_face: exits 3/4 and 5/4 of 2^-1074: t");
assert_eq(load64(_s6_fo), 1, "geo_ray_aabb_face: ... on x's face 1, the earlier one");
assert_eq(load64(_s6_fo + 8), 0, "geo_ray_aabb_face: ... no tie (3.3.5: a tie)");
var _s6_bx3 = _s5_box(5, 0xBFF0000000000000, 0xBFF0000000000000, F64_ONE, 3, F64_ONE);
assert_eq(geo_ray_aabb_face(_s5_ray(0, 0, 0, _s6_d44, _s6_d44, 0), _s6_bx3, _s6_fo), 0,
  "geo_ray_aabb_face: entry 5/4 of 2^-1074 after the exit 3/4: the miss (3.3.5: a hit)");
assert_eq(_bvh_ray_hits_aabb(_s5_ray(0, 0, 0, _s6_d44, _s6_d44, 0), _s6_bx3), 0,
  "_bvh_ray_hits_aabb: ... the miss 0 (3.3.5: 1)");
assert_eq(geo_ray_aabb_face(_s5_ray(0, 0, 0, F64_TWO, 0x4340000000000000, 0), _s5_box(3, 0x0034000000000000,
      0xBFF0000000000000, F64_ONE, F64_ONE, F64_ONE), _s6_fo), 2,
  "geo_ray_aabb_face: x entry 3/2 of 2^-1074 against y's 1.25 * 2^-1073: t = 2 * 2^-1074");
assert_eq(load64(_s6_fo), 2, "geo_ray_aabb_face: ... on face 2 (3.3.5: face 0)");
assert_eq(geo_ray_aabb_face(_s5_ray(0, 0, 0, 0x3FFC000000000000, F64_ONE, 0), _s5_box(24, 15, 0xBFF0000000000000,
      F64_ONE, F64_ONE, F64_ONE), _s6_fo), 0xF,
  "geo_ray_aabb_face: entries 24/1.75 and 15 of 2^-1074: t = 15 * 2^-1074");
assert_eq(load64(_s6_fo), 2, "geo_ray_aabb_face: ... on face 2, the later");
assert_eq(geo_ray_obb_face(_s5_ray(0, 0, 0, _s6_d44, _s6_d44, 0), geo_obb_new(hvec3_new(0x0000010000000003,
        0x0000010000000005, 0), hvec3_new(0x0000010000000000, 0x0000010000000000, F64_ONE), hquat_identity()), _s6_fo),
  1, "geo_ray_obb_face: entries 3/4 and 5/4 of 2^-1074 (centre (2^40 + 3, 2^40 + 5) 2^-1074): t");
assert_eq(load64(_s6_fo), 2, "geo_ray_obb_face: ... on face 2 (3.3.5: face 0 with a tie)");
assert_eq(load64(_s6_fo + 8), 0, "geo_ray_obb_face: ... no tie");
# Tied zero entries keep the later slab's zero, as f64_max does: from (0, 1, 1/2) along
# (1, -1, 0), x is entered at +0 and y at -0 on its max face, and t is -0 (as in 3.3.5).
assert_eq(geo_ray_aabb_face(_s5_ray(0, F64_ONE, F64_HALF, F64_ONE, 0xBFF0000000000000, 0), _s5_box(0, 0, 0, F64_ONE,
      F64_ONE, F64_ONE), _s6_fo), 0x8000000000000000, "geo_ray_aabb_face: entries +0 and -0 tied: the later -0");
# A world box with +-DBL_MAX bounds and a unit oblique ray: the x and z crossings
# overflow in the quotient alone, which needs no exact order: y's entry t = 1/0.64 = 1.5625
# on face 3. (The exact order gives the same answer here: keeping this box off it is a cost
# the timing harness sees, not an answer a test can pin.)
assert_eq(geo_ray_aabb_face(_s5_ray(0, F64_ONE, 0, 0x3FE3333333333333, 0xBFE47AE147AE147B, 0x3FDEB851EB851EB8),
    _s5_box(0xFFEFFFFFFFFFFFFF, 0xBFF0000000000000, 0xFFEFFFFFFFFFFFFF, 0x7FEFFFFFFFFFFFFF, 0, 0x7FEFFFFFFFFFFFFF),
    _s6_fo), 0x3FF9000000000000, "geo_ray_aabb_face: a world box with +-DBL_MAX bounds: t = 1.5625");
assert_eq(load64(_s6_fo), 3, "geo_ray_aabb_face: ... on face 3");

test_group("2.10.1 geo_ray_*: a degenerate direction returns the miss sentinel");
_degen_sweep();
assert_eq(_DD_RUN, 12, "degenerate-direction sweep ran 6 primitives x 2 origin positions");
assert_eq(_DD_BAD, 0,
  "every geo_ray_* returns 0 for a zero-length direction (aabb+obb returned +Inf pre-2.10.1)");

# Pre-fix this reported 4 bad of 18, MEASURED by reverting each guard in turn:
# the sphere alone gives 2 and the capsule alone gives 2 (each at k = 1e-7 and
# 1e-9; at 1e-5 neither threshold is crossed), and both reverted gives 4. The
# two are independent defects with the same root cause, not one propagating --
# this fixture's ray hits the capsule's cylinder BODY, so it never reaches the
# cap branches that call the sphere.
# [measured: docs/development/issues/archived/2026-08-10-squared-epsilon-guards-in-geo-ray.md]
test_group("2.10.1 geo_ray_*: homogeneity holds at SMALL direction scales too");
_homog_small_sweep();
assert_eq(_HS_RUN, 18, "small-scale homogeneity sweep ran 6 primitives x 3 tiny scales");
assert_eq(_HS_BAD, 0,
  "t(k*d) == t(d)/k down to k = 1e-9 (sphere+capsule returned a MISS below 1e-6 pre-2.10.1)");

test_group("geo: ray_at");

var g_ray = geo_ray_new(hvec3_new(F64_ONE, F64_TWO, f64_from(3)),
  hvec3_unit_x());
var g_pt = geo_ray_at(g_ray, f64_from(5));
assert_eq(HVec3_x(g_pt), f64_from(6), "ray_at x");
assert_eq(HVec3_y(g_pt), f64_from(2), "ray_at y");
assert_eq(HVec3_z(g_pt), f64_from(3), "ray_at z");

