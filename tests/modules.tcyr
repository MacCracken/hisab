test_group("num: kahan and neumaier");

var n_kdata = alloc(24);
store64(n_kdata, f64_from(1));
store64(n_kdata + 8, f64_from(2));
store64(n_kdata + 16, f64_from(3));
var n_ks = num_kahan_sum(n_kdata, 3);
assert_eq(f64_to(n_ks), 6, "kahan sum");

var n_ns = num_neumaier_sum(n_kdata, 3);
assert_eq(f64_to(n_ns), 6, "neumaier sum");

# Empty sum (n=0)
var n_ns0 = num_neumaier_sum(n_kdata, 0);
assert_eq(f64_to(n_ns0), 0, "neumaier n=0");

# ----------------------------------------------------------------
test_group("num: fft roundtrip");

# DC signal: 4 complex elements, all = (1.0, 0.0)
var n_fft_data = alloc(64);  # 4 * 16 bytes
var _fi = 0;
while (_fi < 4) {
    store64(n_fft_data + _fi * 16, F64_ONE);
    store64(n_fft_data + _fi * 16 + 8, 0);
    _fi = _fi + 1;
}
var n_fft_rc = num_fft(n_fft_data, 4);
assert_eq(n_fft_rc, 0, "fft ok");
# DC component (index 0) should be 4+0i
assert_eq(f64_to(load64(n_fft_data)), 4, "fft DC re=4");
assert_eq(f64_to(load64(n_fft_data + 8)), 0, "fft DC im=0");

# Roundtrip: ifft should recover original
num_ifft(n_fft_data, 4);
# All elements should be (1.0, 0.0) again
assert_eq(f64_to(f64_round(load64(n_fft_data))), 1, "ifft[0].re=1");
assert_eq(f64_to(f64_round(load64(n_fft_data + 16))), 1, "ifft[1].re=1");
assert_eq(f64_to(f64_round(load64(n_fft_data + 8))), 0, "ifft[0].im=0");

# ================================================================
# COMPLEX — arithmetic, abs, conj, arg, euler, pauli, matrix (~20)
# ================================================================
test_group("complex: arithmetic");

var c_a = cx_new(f64_from(3), f64_from(4));
var c_b = cx_new(F64_ONE, F64_TWO);

# Add
var c_add = cx_add(c_a, c_b);
assert_eq(f64_to(HComplex_re(c_add)), 4, "cx add re");
assert_eq(f64_to(HComplex_im(c_add)), 6, "cx add im");

# Sub
var c_sub = cx_sub(c_a, c_b);
assert_eq(f64_to(HComplex_re(c_sub)), 2, "cx sub re");
assert_eq(f64_to(HComplex_im(c_sub)), 2, "cx sub im");

# Mul: (3+4i)(1+2i) = -5+10i
var c_mul = cx_mul(c_a, c_b);
assert_eq(f64_to(HComplex_re(c_mul)), (0 - 5), "cx mul re");
assert_eq(f64_to(HComplex_im(c_mul)), 10, "cx mul im");

# Div: (3+4i)/(1+2i) = (3+4i)(1-2i)/5 = (11-2i)/5 = 2.2-0.4i
var c_div = cx_div(c_a, c_b);
var c_div_re10 = f64_to(f64_round(f64_mul(HComplex_re(c_div), f64_from(10))));
assert_eq(c_div_re10, 22, "cx div re*10");

# ----------------------------------------------------------------
test_group("complex: abs, conj, arg");

assert_eq(f64_to(cx_abs(c_a)), 5, "abs(3+4i)=5");

var c_conj = cx_conj(c_a);
assert_eq(f64_to(HComplex_im(c_conj)), (0 - 4), "conj im");
assert_eq(f64_to(HComplex_re(c_conj)), 3, "conj re unchanged");

# arg(1+i) = pi/4
var c_1i = cx_new(F64_ONE, F64_ONE);
var c_arg = cx_arg(c_1i);
var c_arg_1000 = f64_to(f64_round(f64_mul(c_arg, f64_from(1000))));
var c_pi4_1000 = f64_to(f64_round(f64_mul(F64_PI_4, f64_from(1000))));
assert_eq(c_arg_1000, c_pi4_1000, "arg(1+i)=pi/4");

# ----------------------------------------------------------------
test_group("complex: euler identity");

# e^(i*pi) + 1 ~ 0
var c_eipi = cx_exp(cx_new(0, F64_PI));
var c_euler = cx_add(c_eipi, cx_one());
# cos(pi_d) rounds to exactly -1.0 and sin(pi_d) = 1.2246467991473532e-16, so the
# closed-form modulus is 1.2246e-16 (measured: identical). The old bound of 1.0
# passed for any argument within about +-60 deg of pi.
assert(f64_lt(cx_abs(c_euler), ULP_TOL_M) == 1, "euler e^(ipi)+1 == 0 (1e-15)");
# e^(i*pi)+1 == 0 is BLIND to conjugation: pi is a fixed point of z -> conj(z), so
# negating the imaginary output of cx_exp leaves this bit-identical (verified: such
# a mutant passes all four suites). Pin a point where the two differ.
# e^(i*pi/2) = 6.123233995736766e-17 + 1i
var _e_ih = cx_exp(cx_new(0, F64_PI_2));
assert(f64_lt(f64_abs(HComplex_re(_e_ih)), ULP_TOL_M) == 1, "cx_exp(i*pi/2).re == 0");
assert(f64_lt(f64_abs(f64_sub(HComplex_im(_e_ih), F64_ONE)), ULP_TOL_M) == 1,
"cx_exp(i*pi/2).im == +1 (not -1)");

# ----------------------------------------------------------------
test_group("complex: pauli matrices");

# sigma_x^2 = I
var c_sx = pauli_x();
var c_sx2 = cmat_mul(c_sx, c_sx);
var c_tr_sx2 = cmat_trace(c_sx2);
assert_eq(f64_to(HComplex_re(c_tr_sx2)), 2, "sx^2 trace=2");

# sigma_y^2 = I
var c_sy = pauli_y();
var c_sy2 = cmat_mul(c_sy, c_sy);
var c_tr_sy2 = cmat_trace(c_sy2);
assert_eq(f64_to(HComplex_re(c_tr_sy2)), 2, "sy^2 trace=2");

# sigma_z^2 = I
var c_sz = pauli_z();
var c_sz2 = cmat_mul(c_sz, c_sz);
var c_tr_sz2 = cmat_trace(c_sz2);
assert_eq(f64_to(HComplex_re(c_tr_sz2)), 2, "sz^2 trace=2");

# Traceless: tr(sigma_x) = 0
var c_tr_sx = cmat_trace(c_sx);
assert_eq(f64_to(HComplex_re(c_tr_sx)), 0, "sx traceless");
var c_tr_sy = cmat_trace(c_sy);
assert_eq(f64_to(HComplex_re(c_tr_sy)), 0, "sy traceless");
var c_tr_sz = cmat_trace(c_sz);
assert_eq(f64_to(HComplex_re(c_tr_sz)), 0, "sz traceless");

# Commutation: [sx, sy] = 2i*sz
var c_comm = cmat_commutator(c_sx, c_sy);
var c_c00 = cmat_get(c_comm, 0, 0);
assert_eq(f64_to(HComplex_im(c_c00)), 2, "[sx,sy]_00 im=2");

# ----------------------------------------------------------------
test_group("complex: matrix");

# Identity trace
var c_id = cmat_identity(3);
var c_id_tr = cmat_trace(c_id);
assert_eq(f64_to(HComplex_re(c_id_tr)), 3, "identity(3) trace=3");

# Adjoint of identity = identity
var c_id_adj = cmat_adjoint(c_id);
var c_id_adj_tr = cmat_trace(c_id_adj);
assert_eq(f64_to(HComplex_re(c_id_adj_tr)), 3, "adj(I) trace=3");
# If cmat_adjoint were a plain copy, the 8-generator hermitian sweep is A == A
# again -- verified: such a stub passes all four suites, because 'adj(I) trace==3'
# is satisfied by the identity function. Pin adjoint on a NON-hermitian matrix.
var _adj_m = cmat_new(2, 2);
cmat_set(_adj_m, 0, 1, cx_new(F64_TWO, f64_from(3)));
var _adj_r = cmat_adjoint(_adj_m);
assert_eq(f64_to(HComplex_re(cmat_get(_adj_r, 1, 0))), 2, "adj[1][0].re == 2 (transposed)");
assert_eq(f64_to(HComplex_im(cmat_get(_adj_r, 1, 0))), (0 - 3), "adj[1][0].im == -3 (conjugated)");
assert_eq(f64_to(HComplex_re(cmat_get(_adj_r, 0, 1))), 0, "adj[0][1] == 0 (not a copy)");

# ================================================================
# LIE GROUPS (~15)
# ================================================================
test_group("lie: U(1)");

# Compose = add phases
var l_u_a = u1_new(F64_PI_4);
var l_u_b = u1_new(F64_PI_4);
var l_u_c = u1_compose(l_u_a, l_u_b);
var l_u_phase = f64_to(f64_round(f64_mul(load64(l_u_c), f64_from(1000))));
var l_pi2_1000 = f64_to(f64_round(f64_mul(F64_PI_2, f64_from(1000))));
assert_eq(l_u_phase, l_pi2_1000, "u1 compose pi/4+pi/4=pi/2");

# Inverse: phase + (-phase) ~ 0
var l_u_inv = u1_inv(l_u_a);
var l_u_id = u1_compose(l_u_a, l_u_inv);
# f64_add(theta, f64_neg(theta)) is exactly +0.0 in IEEE-754 round-to-nearest for
# every finite theta, so this is exact. Measured bit pattern: 0x0.
assert_eq(load64(l_u_id), 0, "u1 inv phase is exactly +0.0");

# Exp/log roundtrip
var l_u_exp = u1_exp(F64_PI_4);
var l_u_log = u1_log(l_u_exp);
var l_u_rt = f64_to(f64_round(f64_mul(l_u_log, f64_from(1000))));
var l_pi4_1000 = f64_to(f64_round(f64_mul(F64_PI_4, f64_from(1000))));
assert_eq(l_u_rt, l_pi4_1000, "u1 exp/log roundtrip");

# ----------------------------------------------------------------
test_group("lie: SU(2)");

# Identity to_quat -> w=1
var l_su2_id = su2_identity();
var l_su2_q = su2_to_quat(l_su2_id);
assert_eq(f64_to(HQuat_w(l_su2_q)), 1, "su2 identity w=1");

# Compose inverse = identity
var l_su2_r = su2_from_axis_angle(hvec3_unit_z(), F64_PI_4);
var l_su2_ri = su2_inv(l_su2_r);
var l_su2_p = su2_compose(l_su2_r, l_su2_ri);
# Half-angle convention: su2_from_axis_angle(z_hat, pi/4) = cos(pi/8) + sin(pi/8) k.
# Pin those first -- w = 1 after compose-with-inverse and dw = 0 after a to_quat
# round-trip are both TRUE under a full-angle build, so neither check below can
# see the half-vs-full-angle split that shipped through 2.6.12.
#   cos(pi/8) = 0.9238795325112867   (a full-angle build would put 0.7071067811865476 here)
#   sin(pi/8) = 0.3826834323650898
var _cos_pi8 = 0x3FED906BCF328D46;  # 0.9238795325112867
var _sin_pi8 = 0x3FD87DE2A6AEA963;  # 0.3826834323650898
assert(f64_lt(f64_abs(f64_sub(_su2_w(l_su2_r), _cos_pi8)), ULP_TOL_M) == 1, "su2 axis-angle w == cos(pi/8)");
assert(f64_lt(f64_abs(f64_sub(_su2_z(l_su2_r), _sin_pi8)), ULP_TOL_M) == 1, "su2 axis-angle z == sin(pi/8)");
# w of q*q^-1 is w^2+x^2+y^2+z^2 = 1 exactly for a unit quaternion (measured
# residual 0). The old bound of 1.0 merely asserted w > 0.
assert(f64_lt(f64_abs(f64_sub(_su2_w(l_su2_p), F64_ONE)), ULP_TOL_M) == 1, "su2 compose inv w == 1 (1e-15)");
# w of q*q^-1 is an inner product, so EVERY su2 assertion in the repo (w == 1, the
# to_quat dw, the axis-angle pins) survives a sign flip in su2_compose's x/y/z
# cross terms -- verified. Pin all four components of a product of two
# non-parallel rotations.
var _c07 = 0x3FE6666666666666;  # 0.7
var _c11 = 0x3FF199999999999A;  # 1.1
var _sa = su2_from_axis_angle(hvec3_new(F64_ONE, F64_TWO, f64_from(3)), _c07);
var _sb = su2_from_axis_angle(hvec3_new(f64_neg(F64_TWO), F64_ONE, F64_HALF), _c11);
var _sp = su2_compose(_sa, _sb);
var _sp_w = 0x3FE89F9435EE839F;   # 0.7694798520425258
var _sp_x = 0xBFD91ACF6D1B1AAA;   # -0.392261368321139
var _sp_y = 0x3FCE094E17426F47;   # 0.23465896735876354
var _sp_z = 0x3FDC8C331EC15140;   # 0.44605710986549596  (a z-sign flip gives 0.2788)
assert(f64_lt(f64_abs(f64_sub(_su2_w(_sp), _sp_w)), TOL_1EM12) == 1, "su2_compose generic w");
assert(f64_lt(f64_abs(f64_sub(_su2_x(_sp), _sp_x)), TOL_1EM12) == 1, "su2_compose generic x");
assert(f64_lt(f64_abs(f64_sub(_su2_y(_sp), _sp_y)), TOL_1EM12) == 1, "su2_compose generic y");
assert(f64_lt(f64_abs(f64_sub(_su2_z(_sp), _sp_z)), TOL_1EM12) == 1, "su2_compose generic z");
# where: var TOL_1EM12 = 0x3D719799812DEA11;  # 1e-12 (== EPSILON_F64)

# to_quat roundtrip
var l_su2_q2 = su2_to_quat(l_su2_r);
var l_su2_back = su2_from_quat(l_su2_q2);
# Both w's live in [-1, 1], so |dw| < 1.0 was near-unfalsifiable. The round trip
# renormalizes by a norm of exactly 1.0 here: measured dw = 0.
assert(f64_lt(f64_abs(f64_sub(_su2_w(l_su2_back), _su2_w(l_su2_r))), ULP_TOL_M) == 1,
"su2 to_quat roundtrip dw == 0 (1e-15)");

# ----------------------------------------------------------------
test_group("lie: Gell-Mann");

# The three properties that CHARACTERISE the SU(3) Gell-Mann basis:
#   (1) lambda_a = lambda_a^H          (Hermitian, checked elementwise)
#   (2) tr lambda_a = 0                (traceless)
#   (3) tr(lambda_a lambda_b) = 2 delta_ab   (orthogonal, normalised to 2)
# Every expected value below is closed form. The ONLY floating-point residual
# anywhere in this block is tr(l8 l8): l8's entries are fl(1/fl(sqrt 3)), so the
# trace is 6*fl(x*x) = 2.0000000000000004 — exactly one ulp at 2.0
# (4.4408920985006262e-16) above the exact 2. Everything else is bit-exact:
# the other seven generators have entries in {0, +-1, +-i}, and l8's trace
# cancels exactly because fl(2/s) == 2*fl(1/s) for s = fl(sqrt 3).
var GM_TR_TOL = 0x3CD203AF9EE75616;   # 1e-15  = 2.25 ulp at 2.0
var GM_L8_TOL = 0x3CBCD2B297D889BC;   # 4e-16  = 3.6 ulp at 0.577, 1.8 ulp at 1.155
# Correctly-rounded doubles of 1/sqrt(3) and 2/sqrt(3), derived independently at
# 60 decimal digits (NOT read off the library, which rounds twice and lands
# 1 ulp high at 0x3FE279A74590331D — inside GM_L8_TOL).
var GM_L8_A  = 0x3FE279A74590331C;    #  1/sqrt(3) =  0.5773502691896257645091
var GM_L8_B2 = 0xBFF279A74590331C;    # -2/sqrt(3) = -1.1547005383792515290183

# --- (0) the checker must be able to FAIL --------------------------------
# The assertion this replaces compared Re(A[0][0]) against Re(adjoint(A)[0][0]),
# which is bit-identical for every complex matrix. These three controls prove
# _gm_is_herm actually discriminates.
var l_gm_nh1 = cmat_new(3, 3);
cmat_set(l_gm_nh1, 0, 1, cx_one());                 # 1 at (0,1), 0 at (1,0)
assert_eq(_gm_is_herm(l_gm_nh1), 0, "gm herm control: rejects non-symmetric real part");
var l_gm_nh2 = cmat_new(3, 3);
cmat_set(l_gm_nh2, 0, 0, cx_i());                   # imaginary entry on the diagonal
assert_eq(_gm_is_herm(l_gm_nh2), 0, "gm herm control: rejects imaginary diagonal");
var l_gm_nh3 = cmat_new(3, 3);                      # lambda_2 with the conjugation dropped
cmat_set(l_gm_nh3, 0, 1, cx_i());
cmat_set(l_gm_nh3, 1, 0, cx_i());
assert_eq(_gm_is_herm(l_gm_nh3), 0, "gm herm control: rejects unconjugated off-diagonal");

# --- (1) Hermiticity + (2) tracelessness, all 8 generators ---------------
var _gm_a = 0;
while (_gm_a < 8) {
    var l_gma = gell_mann(_gm_a);
    assert_eq(_gm_is_herm(l_gma), 1, "gell-mann hermitian (all 9 entries, re and im)");
    # Hermitian + traceless is invariant under PERMUTING the generators: swapping the
    # lambda_4 and lambda_5 bodies passes all four suites. Pin each one's identity.
    assert_eq(f64_to(HComplex_re(cmat_get(gell_mann(3), 0, 2))), 1, "lambda_4[0][2] == +1 (real)");
    assert_eq(f64_to(HComplex_im(cmat_get(gell_mann(3), 0, 2))), 0, "lambda_4[0][2] has no i");
    assert_eq(f64_to(HComplex_im(cmat_get(gell_mann(4), 0, 2))), (0 - 1), "lambda_5[0][2] == -i");
    assert_eq(f64_to(HComplex_re(cmat_get(gell_mann(4), 0, 2))), 0, "lambda_5[0][2] is pure imaginary");
    assert_eq(f64_to(HComplex_re(cmat_get(gell_mann(5), 1, 2))), 1, "lambda_6[1][2] == +1 (real)");
    assert_eq(f64_to(HComplex_im(cmat_get(gell_mann(6), 1, 2))), (0 - 1), "lambda_7[1][2] == -i");
    assert_eq(f64_to(HComplex_re(cmat_get(gell_mann(2), 0, 0))), 1, "lambda_3[0][0] == +1");
    assert_eq(f64_to(HComplex_re(cmat_get(gell_mann(2), 1, 1))), (0 - 1), "lambda_3[1][1] == -1");
    # cmat_adjoint must reproduce the matrix exactly — all 9 entries, both
    # components. Off-diagonal entries make this a real transpose+conjugate test.
    var l_gma_h = cmat_adjoint(l_gma);
    var l_gm_adj_bad = 0;
    var _gm_i = 0;
    while (_gm_i < 3) {
        var _gm_j = 0;
        while (_gm_j < 3) {
            var l_gm_u = cmat_get(l_gma, _gm_i, _gm_j);
            var l_gm_v = cmat_get(l_gma_h, _gm_i, _gm_j);
            if (f64_eq(HComplex_re(l_gm_u), HComplex_re(l_gm_v)) == 0) {
                l_gm_adj_bad = l_gm_adj_bad + 1;
            }
            if (f64_eq(HComplex_im(l_gm_u), HComplex_im(l_gm_v)) == 0) {
                l_gm_adj_bad = l_gm_adj_bad + 1;
            }
            _gm_j = _gm_j + 1;
        }
        _gm_i = _gm_i + 1;
    }
    assert_eq(l_gm_adj_bad, 0, "gell-mann adjoint == self, entrywise");
    # Traceless: exactly 0, both components (not "within 1.0").
    var l_gm_tr = cmat_trace(l_gma);
    assert_eq(f64_eq(HComplex_re(l_gm_tr), 0), 1, "gell-mann traceless (re exactly 0)");
    assert_eq(f64_eq(HComplex_im(l_gm_tr), 0), 1, "gell-mann traceless (im exactly 0)");
    _gm_a = _gm_a + 1;
}

# --- (3) orthogonality: tr(l_a l_b) = 2 delta_ab over all 64 pairs -------
var _gm_p = 0;
var l_gm_off_bad = 0;
var l_gm_diag_bad = 0;
var l_gm_im_bad = 0;
while (_gm_p < 8) {
    var l_gm_pa = gell_mann(_gm_p);
    var _gm_q = 0;
    while (_gm_q < 8) {
        var l_gm_t = cmat_trace(cmat_mul(l_gm_pa, gell_mann(_gm_q)));
        if (f64_eq(HComplex_im(l_gm_t), 0) == 0) { l_gm_im_bad = l_gm_im_bad + 1; }
        if (_gm_p == _gm_q) {
            if (f64_lt(f64_abs(f64_sub(HComplex_re(l_gm_t), F64_TWO)), GM_TR_TOL) == 0) {
                l_gm_diag_bad = l_gm_diag_bad + 1;
            }
        } else {
            if (f64_eq(HComplex_re(l_gm_t), 0) == 0) { l_gm_off_bad = l_gm_off_bad + 1; }
        }
        _gm_q = _gm_q + 1;
    }
    _gm_p = _gm_p + 1;
}
assert_eq(l_gm_off_bad, 0, "gell-mann tr(la lb) exactly 0 for a != b (56 pairs)");
assert_eq(l_gm_diag_bad, 0, "gell-mann tr(la la) = 2 within 1e-15 (8 pairs)");
assert_eq(l_gm_im_bad, 0, "gell-mann tr(la lb) exactly real (64 pairs)");

# Controls proving the Gram sweep measures normalisation, not a constant 2:
# tr((2 l1)^2) = 4 * tr(l1^2) = 8, and tr((l1+l4)^2) = 2 + 2*tr(l1 l4) + 2 = 4.
var l_gm_2l1 = cmat_scale(gell_mann(0), cx_real(F64_TWO));
var l_gm_ct1 = cmat_trace(cmat_mul(l_gm_2l1, l_gm_2l1));
assert_eq(f64_eq(HComplex_re(l_gm_ct1), f64_from(8)), 1, "gm gram control: tr((2 l1)^2) = 8");
var l_gm_s14 = cmat_add(gell_mann(0), gell_mann(3));
var l_gm_ct2 = cmat_trace(cmat_mul(l_gm_s14, l_gm_s14));
assert_eq(f64_eq(HComplex_re(l_gm_ct2), f64_from(4)), 1, "gm gram control: tr((l1+l4)^2) = 4");

# --- convention pin ------------------------------------------------------
# Hermiticity + tracelessness + tr(la lb) = 2 delta_ab are invariant under any
# unitary change of basis, so they do not by themselves pin the Gell-Mann
# convention. These do:
#   lambda_1 = [[0,1,0],[1,0,0],[0,0,0]]
#   lambda_3 = diag(1, -1, 0)
#   lambda_8 = diag(1, 1, -2)/sqrt(3)
#   [lambda_1, lambda_2] = 2i lambda_3   (structure constant f_123 = +1)
var l_gm_l1 = gell_mann(0);
assert_eq(f64_eq(HComplex_re(cmat_get(l_gm_l1, 0, 1)), F64_ONE), 1, "l1(0,1) = 1");
assert_eq(f64_eq(HComplex_re(cmat_get(l_gm_l1, 0, 0)), 0), 1, "l1(0,0) = 0");
var l_gm_l3 = gell_mann(2);
assert_eq(f64_eq(HComplex_re(cmat_get(l_gm_l3, 0, 0)), F64_ONE), 1, "l3(0,0) = +1");
assert_eq(f64_eq(HComplex_re(cmat_get(l_gm_l3, 1, 1)), f64_neg(F64_ONE)), 1, "l3(1,1) = -1");
assert_eq(f64_eq(HComplex_re(cmat_get(l_gm_l3, 2, 2)), 0), 1, "l3(2,2) = 0");
var l_gm_l8 = gell_mann(7);
var l_gm_e00 = HComplex_re(cmat_get(l_gm_l8, 0, 0));
var l_gm_e11 = HComplex_re(cmat_get(l_gm_l8, 1, 1));
var l_gm_e22 = HComplex_re(cmat_get(l_gm_l8, 2, 2));
assert_eq(f64_lt(f64_abs(f64_sub(l_gm_e00, GM_L8_A)), GM_L8_TOL), 1, "l8(0,0) = 1/sqrt(3)");
assert_eq(f64_eq(l_gm_e11, l_gm_e00), 1, "l8(1,1) == l8(0,0)");
assert_eq(f64_lt(f64_abs(f64_sub(l_gm_e22, GM_L8_B2)), GM_L8_TOL), 1, "l8(2,2) = -2/sqrt(3)");
assert_eq(f64_eq(HComplex_re(cmat_get(l_gm_l8, 0, 1)), 0), 1, "l8(0,1) = 0");
var l_gm_c12 = cmat_commutator(gell_mann(0), gell_mann(1));
var l_gm_k00 = cmat_get(l_gm_c12, 0, 0);
var l_gm_k11 = cmat_get(l_gm_c12, 1, 1);
assert_eq(f64_eq(HComplex_re(l_gm_k00), 0), 1, "[l1,l2](0,0) is pure imaginary");
assert_eq(f64_eq(HComplex_im(l_gm_k00), F64_TWO), 1, "[l1,l2] = 2i l3: (0,0) im = +2");
assert_eq(f64_eq(HComplex_im(l_gm_k11), f64_neg(F64_TWO)), 1, "[l1,l2] = 2i l3: (1,1) im = -2");
assert_eq(f64_eq(HComplex_im(cmat_get(l_gm_c12, 2, 2)), 0), 1, "[l1,l2] = 2i l3: (2,2) im = 0");
assert_eq(f64_eq(HComplex_im(cmat_get(l_gm_c12, 0, 1)), 0), 1, "[l1,l2] = 2i l3: (0,1) im = 0");
# --- (4) convention pin for lambda_4..lambda_7 ---------------------------
# Properties (1)-(3) are invariant under ANY real orthogonal mixing of
# lambda_4..lambda_7 (the 4-dim subspace orthogonal to l1,l2,l3,l8), and the
# pins above touch only l1, l2, l3, l8 -- so a sign flip on l5 or l7, a swap of
# l4 and l6, or a 45-degree rotation of (l4,l6) passes everything above.
# Each pin below plus Hermiticity plus tr(la la) = 2 determines the generator
# uniquely: two off-diagonal entries of modulus 1 already exhaust the norm.
assert_eq(f64_eq(HComplex_re(cmat_get(gell_mann(3), 0, 2)), F64_ONE), 1, "l4(0,2) = +1");
assert_eq(f64_eq(HComplex_im(cmat_get(gell_mann(3), 0, 2)), 0), 1, "l4(0,2) im = 0");
assert_eq(f64_eq(HComplex_re(cmat_get(gell_mann(3), 1, 2)), 0), 1, "l4(1,2) = 0");
assert_eq(f64_eq(HComplex_im(cmat_get(gell_mann(4), 0, 2)), f64_neg(F64_ONE)), 1, "l5(0,2) = -i");
assert_eq(f64_eq(HComplex_re(cmat_get(gell_mann(4), 0, 2)), 0), 1, "l5(0,2) re = 0");
assert_eq(f64_eq(HComplex_re(cmat_get(gell_mann(5), 1, 2)), F64_ONE), 1, "l6(1,2) = +1");
assert_eq(f64_eq(HComplex_re(cmat_get(gell_mann(5), 0, 2)), 0), 1, "l6(0,2) = 0");
assert_eq(f64_eq(HComplex_im(cmat_get(gell_mann(6), 1, 2)), f64_neg(F64_ONE)), 1, "l7(1,2) = -i");
assert_eq(f64_eq(HComplex_re(cmat_get(gell_mann(6), 1, 2)), 0), 1, "l7(1,2) re = 0");

# --- (5) algebra closure: [l_a, l_b] = 2i sum_c f_abc l_c ----------------
# The identity that actually ties the matrices to the algebra, over all 64
# pairs and all 9 entries. Also the first coverage su3_structure_constant
# (src/lie.cyr:310) has ever had -- grep -rn "su3_" tests/ returns nothing
# today, so the table and the matrices have never been checked against each
# other. Exact in double: 2 * (sqrt3/2) * (1/sqrt3) == 1.0 and
# 2 * (sqrt3/2) * (-2/sqrt3) == -2.0 bit for bit, so the tolerance is slack.
var l_gm_sc_bad = 0;
var _gm_u = 0;
while (_gm_u < 8) {
    var _gm_v = 0;
    while (_gm_v < 8) {
        var l_gm_lhs = cmat_commutator(gell_mann(_gm_u), gell_mann(_gm_v));
        var l_gm_rhs = cmat_new(3, 3);
        var _gm_c = 0;
        while (_gm_c < 8) {
            var l_gm_f = su3_structure_constant(_gm_u + 1, _gm_v + 1, _gm_c + 1);
            if (f64_eq(l_gm_f, 0) == 0) {
                var l_gm_w = cx_new(0, f64_mul(F64_TWO, l_gm_f));
                l_gm_rhs = cmat_add(l_gm_rhs, cmat_scale(gell_mann(_gm_c), l_gm_w));
            }
            _gm_c = _gm_c + 1;
        }
        var _gm_r = 0;
        while (_gm_r < 3) {
            var _gm_s = 0;
            while (_gm_s < 3) {
                var l_gm_lv = cmat_get(l_gm_lhs, _gm_r, _gm_s);
                var l_gm_rv = cmat_get(l_gm_rhs, _gm_r, _gm_s);
                var l_gm_dr = f64_abs(f64_sub(HComplex_re(l_gm_lv), HComplex_re(l_gm_rv)));
                var l_gm_di = f64_abs(f64_sub(HComplex_im(l_gm_lv), HComplex_im(l_gm_rv)));
                if (f64_lt(l_gm_dr, GM_TR_TOL) == 0) { l_gm_sc_bad = l_gm_sc_bad + 1; }
                if (f64_lt(l_gm_di, GM_TR_TOL) == 0) { l_gm_sc_bad = l_gm_sc_bad + 1; }
                _gm_s = _gm_s + 1;
            }
            _gm_r = _gm_r + 1;
        }
        _gm_v = _gm_v + 1;
    }
    _gm_u = _gm_u + 1;
}
assert_eq(l_gm_sc_bad, 0, "gell-mann [la,lb] = 2i f_abc lc (64 pairs, 9 entries, re+im)");

# ----------------------------------------------------------------
test_group("lie: Lorentz");

# Identity transforms (t,0,0,0) -> (t,0,0,0)
var l_lor_id = lorentz_identity();
var l_tv4 = alloc(32);
store64(l_tv4, F64_ONE); store64(l_tv4 + 8, 0); store64(l_tv4 + 16, 0); store64(l_tv4 + 24, 0);
var l_tv4_out = lorentz_transform_4vec(l_lor_id, l_tv4);
assert_eq(f64_to(load64(l_tv4_out)), 1, "lorentz id t");
assert_eq(f64_to(load64(l_tv4_out + 8)), 0, "lorentz id x");

# Boost validity: a boost should satisfy Lambda^T eta Lambda = eta
var l_boost = lorentz_boost_x(F64_HALF);
assert_eq(lorentz_is_valid(l_boost), 1, "boost is valid");
# lorentz_boost_x takes RAPIDITY, not velocity: Lambda^0_0 = cosh(0.5) and
# Lambda^1_0 = sinh(0.5). If it ever silently reverts to reading the argument as
# beta, those become gamma = 1.1547005383792517 and gamma*beta = 0.5773502691896258
# -- 0.027 and 0.056 away, both far outside 1e-15. The compose-inverse and
# interval-preservation checks below hold under EITHER reading, so they cannot
# see that regression; these two can.
var _cosh_half = 0x3FF20AC1862AE8D0;  # cosh(0.5) = 1.1276259652063807
var _sinh_half = 0x3FE0ACD00FE63B97;  # sinh(0.5) = 0.5210953054937474
assert(f64_lt(f64_abs(f64_sub(m4_get(l_boost, 0, 0), _cosh_half)), ULP_TOL_M) == 1,
"boost_x(0.5)[0][0] == cosh(0.5)");
assert(f64_lt(f64_abs(f64_sub(m4_get(l_boost, 1, 0), _sinh_half)), ULP_TOL_M) == 1,
"boost_x(0.5)[1][0] == sinh(0.5)");

# Compose inverse = identity (approx)
var l_boost_inv = lorentz_inv(l_boost);
var l_comp = lorentz_compose(l_boost, l_boost_inv);
# Diagonal should be ~1, off-diagonal ~0
# cosh^2 - sinh^2 = 1 in closed form; measured residual 2.22e-16 (1 ulp). The old
# bound of 1.0 accepted any [0][0] in [0, 2]. Check an off-diagonal too, or a
# lorentz_inv that returned the identity would leave [0][0] = cosh(0.5) = 1.128
# and still pass.
assert(f64_lt(f64_abs(f64_sub(m4_get(l_comp, 0, 0), F64_ONE)), ULP_TOL_M) == 1,
"lorentz compose inv [0][0] == 1 (1e-15)");
assert(f64_lt(f64_abs(f64_sub(m4_get(l_comp, 1, 1), F64_ONE)), ULP_TOL_M) == 1,
"lorentz compose inv [1][1] == 1 (1e-15)");
assert(f64_lt(f64_abs(m4_get(l_comp, 0, 1)), ULP_TOL_M) == 1, "lorentz compose inv [0][1] == 0");

# Preserves Minkowski interval
var l_tv4b = alloc(32);
store64(l_tv4b, f64_from(5)); store64(l_tv4b + 8, f64_from(3));
store64(l_tv4b + 16, 0); store64(l_tv4b + 24, 0);
var l_intv_before = minkowski_interval(l_tv4b);
var l_tv4b_out = lorentz_transform_4vec(l_boost, l_tv4b);
var l_intv_after = minkowski_interval(l_tv4b_out);
var l_intv_diff = f64_abs(f64_sub(l_intv_before, l_intv_after));
# Pin the interval itself: 5^2 - 3^2 = 16 exactly. A (-,+,+,+) signature would
# give -16 and the before/after DIFFERENCE would still be 0, so the preservation
# check alone is blind to a global sign flip.
assert_eq(f64_to(l_intv_before), 16, "minkowski interval of (5,3,0,0) == +16");
# Boosted by rapidity 0.5: t' = 5cosh+3sinh = 7.201415742513145,
# x' = 5sinh+3cosh = 5.988354423087879, t'^2 - x'^2 = 15.999999999999993.
# Measured drift 7.105e-15 = 4 ulp of 16. The old bound of 1.0 was a 6.25%
# relative tolerance on a quantity of magnitude 16.
assert(f64_lt(l_intv_diff, IVL_TOL_M) == 1, "lorentz preserves interval (1e-13)");
# (5,3,0,0) leaves y and z at zero, so dropping either spatial term is invisible
# to both the +16 pin and the 1e-13 drift bound -- verified across all four suites.
var _mv = alloc(32);
store64(_mv, f64_from(5)); store64(_mv + 8, f64_from(3));
store64(_mv + 16, f64_from(4)); store64(_mv + 24, F64_TWO);
# 25 - 9 - 16 - 4 = -4
assert_eq(f64_to(minkowski_interval(_mv)), (0 - 4), "interval(5,3,4,2) == -4");
var _mo = lorentz_transform_4vec(l_boost, _mv);
assert(f64_lt(f64_abs(f64_sub(minkowski_interval(_mo), minkowski_interval(_mv))), TOL_1EM12) == 1,
"boost preserves interval(5,3,4,2)");

# ================================================================
# DIFFERENTIAL GEOMETRY (~10)
# ================================================================
test_group("diffgeo: flat metric");

# Flat 2D Euclidean: g_inv = diag(1,1), all metric derivs = 0
var dg_metric_inv = alloc(32);
store64(dg_metric_inv, F64_ONE); store64(dg_metric_inv + 8, 0);
store64(dg_metric_inv + 16, 0); store64(dg_metric_inv + 24, F64_ONE);

var dg_deriv = alloc(64);
var _dg_i = 0;
while (_dg_i < 8) { store64(dg_deriv + _dg_i * 8, 0); _dg_i = _dg_i + 1; }

var dg_chris = christoffel_symbols(dg_metric_inv, dg_deriv, 2);
assert_eq(f64_to(christoffel_get(dg_chris, 2, 0, 0, 0)), 0, "flat Gamma^0_00=0");
assert_eq(f64_to(christoffel_get(dg_chris, 2, 1, 0, 1)), 0, "flat Gamma^1_01=0");
assert_eq(f64_to(christoffel_get(dg_chris, 2, 0, 1, 0)), 0, "flat Gamma^0_10=0");
assert_eq(f64_to(christoffel_get(dg_chris, 2, 1, 1, 1)), 0, "flat Gamma^1_11=0");

# ----------------------------------------------------------------
# christoffel_symbols with a metric that actually CURVES (2.8.3)
#
# Both call sites in the suite (here and tests/hisab.tcyr) passed an all-zero
# metric_deriv array. With d_k g_ij == 0 the bracket d1 + d2 - d3 is 0 for every
# index and the whole formula at src/diffgeo.cyr:64-104 -- the lambda contraction,
# the three derivative permutations, the sign on d3, the factor 1/2 -- collapses
# to "return zeros". Replacing the body with `store64(out + off, 0)` kept the
# suite green. The flat-metric assertions above are still worth keeping (a
# Christoffel symbol that is nonzero in flat space is a real defect) but they
# certify only that.

test_group("diffgeo: curved metric");

# (a) UNIT 2-SPHERE, g = diag(1, sin^2 th), coordinates (th, phi), at th = pi/3.
# The only nonvanishing derivative is d_th g_phiphi = 2 sin th cos th = sin(2 th),
# which at th = pi/3 is sqrt(3)/2 exactly (2 cos(pi/3) == 1). Closed forms from
# any textbook, independent of this implementation:
#     Gamma^th_phiphi = -sin th cos th = -sqrt(3)/4
#     Gamma^phi_thphi =  cot th        =  1/sqrt(3)
# and every other component is zero. This exercises g^{a lambda} with a != 0,
# the -d3 term (Gamma^th_phiphi comes from d3 alone) and the +d1 term
# (Gamma^phi_thphi comes from d1 alone).
var _s2_ginv = alloc(32);
store64(_s2_ginv, F64_ONE);                          # g^{th th} = 1
store64(_s2_ginv + 8, 0);
store64(_s2_ginv + 16, 0);
store64(_s2_ginv + 24, 0x3FF5555555555555);          # g^{phi phi} = 1/sin^2(pi/3) = 4/3
var _s2_dg = alloc(64);
var _s2_i = 0;
while (_s2_i < 8) { store64(_s2_dg + _s2_i * 8, 0); _s2_i = _s2_i + 1; }
# metric_deriv[(i*dim + j)*dim + k] = d_k g_ij -> (i,j,k) = (1,1,0) is index 6
store64(_s2_dg + 6 * 8, 0x3FEBB67AE8584CAA);         # d_th g_phiphi = sqrt(3)/2
var _s2_ch = christoffel_symbols(_s2_ginv, _s2_dg, 2);
assert_neq(_s2_ch, 0, "2-sphere: christoffel_symbols allocates");
var _s2_gam011 = 0xBFDBB67AE8584CAA;                 # -sqrt(3)/4 = -0.4330127018922193
var _s2_gam101 = 0x3FE279A74590331D;                 # 1/sqrt(3) =  0.5773502691896258
assert_eq(christoffel_get(_s2_ch, 2, 0, 1, 1), _s2_gam011,
"2-sphere: Gamma^th_phiphi == -sqrt(3)/4 bit-exact");
assert_eq(f64_lt(f64_abs(f64_sub(christoffel_get(_s2_ch, 2, 1, 0, 1), _s2_gam101)),
ULP_TOL_M), 1, "2-sphere: Gamma^phi_thphi == cot(pi/3) == 1/sqrt(3)");
assert_eq(f64_lt(f64_abs(f64_sub(christoffel_get(_s2_ch, 2, 1, 1, 0), _s2_gam101)),
ULP_TOL_M), 1, "2-sphere: Gamma^phi_phith == Gamma^phi_thphi (symmetric in mu,nu)");
assert_eq(christoffel_get(_s2_ch, 2, 0, 0, 0), 0, "2-sphere: Gamma^th_thth == 0");
assert_eq(christoffel_get(_s2_ch, 2, 0, 0, 1), 0, "2-sphere: Gamma^th_thphi == 0");
assert_eq(christoffel_get(_s2_ch, 2, 1, 0, 0), 0, "2-sphere: Gamma^phi_thth == 0");
assert_eq(christoffel_get(_s2_ch, 2, 1, 1, 1), 0, "2-sphere: Gamma^phi_phiphi == 0");

# (b) GENERIC 2-METRIC, every input nonzero and every input DYADIC, so the whole
# contraction stays inside binary floating point and the answer is bit-exact --
# no tolerance, no rounding argument. g^{ij} = [[2, 1/2], [1/2, 3]] (off-diagonal
# nonzero, so the lambda sum is live); d_k g_ij runs over 1/2, 1/4, 3/4, 1/8,
# 5/8, 7/8 with the (i,j) symmetry a metric derivative must have. The eight
# expected values were computed by an independent exact-rational evaluation of
# the published formula (python3 fractions.Fraction), not by this code:
#   Gamma^0 = [[13/16, 13/32], [13/32, -5/32]]   Gamma^1 = [[2, 1], [1, 39/32]]
# Sign-flipping d3, dropping d3, permuting d3's indices or dropping the 1/2 each
# change all EIGHT entries.  (Swapping d1 and d2 is a genuine no-op: the bracket
# is symmetric under mu <-> nu, which is why Gamma is too.)
var _gm_ginv = alloc(32);
store64(_gm_ginv, F64_TWO);                                  # g^{00} = 2
store64(_gm_ginv + 8, F64_HALF);                             # g^{01} = 1/2
store64(_gm_ginv + 16, F64_HALF);                            # g^{10} = 1/2
store64(_gm_ginv + 24, f64_from(3));                         # g^{11} = 3
var _gm_dg = alloc(64);
store64(_gm_dg + 0 * 8, F64_HALF);                           # d_0 g_00 = 1/2
store64(_gm_dg + 1 * 8, 0x3FD0000000000000);                 # d_1 g_00 = 1/4
store64(_gm_dg + 2 * 8, 0x3FE8000000000000);                 # d_0 g_01 = 3/4
store64(_gm_dg + 3 * 8, 0x3FC0000000000000);                 # d_1 g_01 = 1/8
store64(_gm_dg + 4 * 8, 0x3FE8000000000000);                 # d_0 g_10 = 3/4
store64(_gm_dg + 5 * 8, 0x3FC0000000000000);                 # d_1 g_10 = 1/8
store64(_gm_dg + 6 * 8, 0x3FE4000000000000);                 # d_0 g_11 = 5/8
store64(_gm_dg + 7 * 8, 0x3FEC000000000000);                 # d_1 g_11 = 7/8
var _gm_ch = christoffel_symbols(_gm_ginv, _gm_dg, 2);
assert_neq(_gm_ch, 0, "generic metric: christoffel_symbols allocates");
assert_eq(christoffel_get(_gm_ch, 2, 0, 0, 0), 0x3FEA000000000000, "generic: Gamma^0_00 == 13/16");
assert_eq(christoffel_get(_gm_ch, 2, 0, 0, 1), 0x3FDA000000000000, "generic: Gamma^0_01 == 13/32");
assert_eq(christoffel_get(_gm_ch, 2, 0, 1, 0), 0x3FDA000000000000, "generic: Gamma^0_10 == 13/32");
assert_eq(christoffel_get(_gm_ch, 2, 0, 1, 1), 0xBFC4000000000000, "generic: Gamma^0_11 == -5/32");
assert_eq(christoffel_get(_gm_ch, 2, 1, 0, 0), 0x4000000000000000, "generic: Gamma^1_00 == 2");
assert_eq(christoffel_get(_gm_ch, 2, 1, 0, 1), 0x3FF0000000000000, "generic: Gamma^1_01 == 1");
assert_eq(christoffel_get(_gm_ch, 2, 1, 1, 0), 0x3FF0000000000000, "generic: Gamma^1_10 == 1");
assert_eq(christoffel_get(_gm_ch, 2, 1, 1, 1), 0x3FF3800000000000, "generic: Gamma^1_11 == 39/32");

test_group("diffgeo: flat metric (continued)");

# Riemann from flat (all zero christoffel derivs -> all zero riemann)
var dg_chris_deriv = alloc(128);
var _dg_j = 0;
while (_dg_j < 16) { store64(dg_chris_deriv + _dg_j * 8, 0); _dg_j = _dg_j + 1; }
var dg_riemann = riemann_tensor(dg_chris, dg_chris_deriv, 2);
assert_eq(f64_to(riemann_get(dg_riemann, 2, 0, 0, 0, 1)), 0, "flat Riemann=0");
assert_eq(f64_to(riemann_get(dg_riemann, 2, 1, 0, 0, 1)), 0, "flat Riemann b=0");

# Ricci tensor (all zero)
var dg_ricci = ricci_tensor(dg_riemann, 2);
assert_eq(f64_to(ricci_get(dg_ricci, 2, 0, 0)), 0, "flat Ricci=0");

# Ricci scalar = 0
var dg_scalar = ricci_scalar(dg_ricci, dg_metric_inv, 2);
assert_eq(f64_to(dg_scalar), 0, "flat scalar=0");

# Einstein tensor (R_mn - 1/2 R g_mn, but R=0 and all R_mn=0 -> 0)
var dg_metric = alloc(32);
store64(dg_metric, F64_ONE); store64(dg_metric + 8, 0);
store64(dg_metric + 16, 0); store64(dg_metric + 24, F64_ONE);
var dg_einstein = einstein_tensor(dg_ricci, dg_metric, dg_metric_inv, 2);
assert_eq(f64_to(load64(dg_einstein)), 0, "flat Einstein=0");

# ----------------------------------------------------------------
test_group("diffgeo: wedge product");

# alpha=(1,0), beta=(0,1) -> wedge = 1
var dg_alpha = alloc(16);
store64(dg_alpha, F64_ONE); store64(dg_alpha + 8, 0);
var dg_beta = alloc(16);
store64(dg_beta, 0); store64(dg_beta + 8, F64_ONE);
var dg_w = wedge_1_1(dg_alpha, dg_beta, 2);
assert_eq(f64_to(load64(dg_w)), 1, "wedge e1^e2=1");

# Antisymmetry: alpha ^ alpha = 0
var dg_w2 = wedge_1_1(dg_alpha, dg_alpha, 2);
assert_eq(f64_to(load64(dg_w2)), 0, "wedge alpha^alpha=0");

# ================================================================
# SYMBOLIC (~15)
# ================================================================
test_group("symbolic: evaluate");

# Evaluate constant
var s_c = expr_const(f64_from(42));
var s_empty = vec_new();
assert_eq(f64_to(expr_eval(s_c, s_empty)), 42, "eval const");

# Evaluate variable
var s_x = expr_var(str_from("x"));
var s_binds = vec_new();
vec_push(s_binds, expr_bind(str_from("x"), f64_from(7)));
assert_eq(f64_to(expr_eval(s_x, s_binds)), 7, "eval var");

# Evaluate x^2 + 3 at x=2 -> 7
var s_x2 = expr_mul(s_x, s_x);
var s_e = expr_add(s_x2, expr_const(f64_from(3)));
var s_binds2 = vec_new();
vec_push(s_binds2, expr_bind(str_from("x"), f64_from(2)));
assert_eq(f64_to(expr_eval(s_e, s_binds2)), 7, "eval x^2+3 at 2");

# Evaluate sin(0) = 0
var s_sin0 = expr_sin(expr_const(0));
assert_eq(f64_to(expr_eval(s_sin0, s_empty)), 0, "eval sin(0)");

# Evaluate exp(0) = 1
var s_exp0 = expr_exp(expr_const(0));
assert_eq(f64_to(expr_eval(s_exp0, s_empty)), 1, "eval exp(0)");

# ----------------------------------------------------------------
test_group("symbolic: differentiate");

# d/dx(const) = 0
var s_dc = expr_diff(expr_const(f64_from(5)), str_from("x"));
assert_eq(f64_to(expr_eval(s_dc, s_empty)), 0, "diff const=0");

# d/dx(x) = 1
var s_dx = expr_diff(expr_var(str_from("x")), str_from("x"));
assert_eq(f64_to(expr_eval(s_dx, s_binds2)), 1, "diff x=1");

# d/dx(x^2) at x=2 -> 4
var s_dx2 = expr_simplify(expr_diff(s_x2, str_from("x")));
assert_eq(f64_to(expr_eval(s_dx2, s_binds2)), 4, "diff x^2 at 2 = 4");

# d/dx(sin(x)) at x=0 -> cos(0) = 1
var s_sin_x = expr_sin(expr_var(str_from("x")));
var s_dsin = expr_simplify(expr_diff(s_sin_x, str_from("x")));
var s_binds0 = vec_new();
vec_push(s_binds0, expr_bind(str_from("x"), 0));
assert_eq(f64_to(expr_eval(s_dsin, s_binds0)), 1, "diff sin at 0 = cos(0)=1");

# d/dx(exp(x)) at x=0 -> exp(0) = 1
var s_exp_x = expr_exp(expr_var(str_from("x")));
var s_dexp = expr_simplify(expr_diff(s_exp_x, str_from("x")));
assert_eq(f64_to(expr_eval(s_dexp, s_binds0)), 1, "diff exp at 0 = 1");

# ----------------------------------------------------------------
test_group("symbolic: simplify");

# 0 + x = x
var s_xv = expr_var(str_from("x"));
var s_zero_plus = expr_add(expr_const(0), s_xv);
var s_sp = expr_simplify(s_zero_plus);
assert_eq(expr_tag(s_sp), EXPR_VAR, "0+x -> var");

# 1 * x = x
var s_one_mul = expr_mul(expr_const(F64_ONE), s_xv);
var s_sp2 = expr_simplify(s_one_mul);
assert_eq(expr_tag(s_sp2), EXPR_VAR, "1*x -> var");

# 0 * x = 0
var s_zero_mul = expr_mul(expr_const(0), s_xv);
var s_sp3 = expr_simplify(s_zero_mul);
assert_eq(expr_tag(s_sp3), EXPR_CONST, "0*x -> const");

# x^0 = 1
var s_pow0 = expr_pow(s_xv, expr_const(0));
var s_sp4 = expr_simplify(s_pow0);
assert_eq(expr_tag(s_sp4), EXPR_CONST, "x^0 -> const");
assert_eq(f64_to(expr_eval(s_sp4, s_empty)), 1, "x^0 = 1");

# x^1 = x
var s_pow1 = expr_pow(s_xv, expr_const(F64_ONE));
var s_sp5 = expr_simplify(s_pow1);
assert_eq(expr_tag(s_sp5), EXPR_VAR, "x^1 -> var");

# --x = x (double negation)
var s_dblneg = expr_neg(expr_neg(s_xv));
var s_sp6 = expr_simplify(s_dblneg);
assert_eq(expr_tag(s_sp6), EXPR_VAR, "--x -> var");

# ----------------------------------------------------------------
test_group("symbolic: to_str");

var s_str_c = expr_to_str(expr_const(f64_from(42)));
assert(str_eq(s_str_c, str_from("42")) == 1, "to_str const 42");

var s_str_v = expr_to_str(expr_var(str_from("y")));
assert(str_eq(s_str_v, str_from("y")) == 1, "to_str var y");

# ================================================================
# AUTODIFF (~10)
# ================================================================
test_group("autodiff: x^2");

# f(x) = x^2 at x=3: val=9, deriv=6
var ad_x3 = dual_var(f64_from(3));
var ad_x3_sq = dual_mul(ad_x3, ad_x3);
assert_eq(f64_to(Dual_val(ad_x3_sq)), 9, "x^2 at 3 val=9");
assert_eq(f64_to(Dual_deriv(ad_x3_sq)), 6, "x^2 at 3 deriv=6");

# f(x) = x^2 at x=0: val=0, deriv=0
var ad_x0 = dual_var(0);
var ad_x0_sq = dual_mul(ad_x0, ad_x0);
assert_eq(f64_to(Dual_val(ad_x0_sq)), 0, "x^2 at 0 val=0");
assert_eq(f64_to(Dual_deriv(ad_x0_sq)), 0, "x^2 at 0 deriv=0");

# ----------------------------------------------------------------
test_group("autodiff: sin/cos/exp/ln/sqrt");

# sin(0)=0, deriv=cos(0)=1
var ad_sin0 = dual_sin(dual_var(0));
assert_eq(f64_to(Dual_val(ad_sin0)), 0, "sin(0) val");
assert_eq(f64_to(Dual_deriv(ad_sin0)), 1, "sin(0) deriv=cos(0)=1");

# cos(0)=1, deriv=-sin(0)=0
var ad_cos0 = dual_cos(dual_var(0));
assert_eq(f64_to(Dual_val(ad_cos0)), 1, "cos(0) val");
assert_eq(f64_to(Dual_deriv(ad_cos0)), 0, "cos(0) deriv=-sin(0)=0");

# exp(0)=1, deriv=exp(0)=1
var ad_exp0 = dual_exp(dual_var(0));
assert_eq(f64_to(Dual_val(ad_exp0)), 1, "exp(0) val");
assert_eq(f64_to(Dual_deriv(ad_exp0)), 1, "exp(0) deriv");

# ln(1)=0, deriv=1/1=1
var ad_ln1 = dual_ln(dual_var(F64_ONE));
assert_eq(f64_to(Dual_val(ad_ln1)), 0, "ln(1) val");
assert_eq(f64_to(Dual_deriv(ad_ln1)), 1, "ln(1) deriv");

# sqrt(4)=2, deriv=1/(2*2)=0.25
var ad_sqrt4 = dual_sqrt(dual_var(f64_from(4)));
assert_eq(f64_to(Dual_val(ad_sqrt4)), 2, "sqrt(4) val");
var ad_sqrt4_d = f64_to(f64_round(f64_mul(Dual_deriv(ad_sqrt4), f64_from(100))));
assert_eq(ad_sqrt4_d, 25, "sqrt(4) deriv*100=25");

# ----------------------------------------------------------------
test_group("autodiff: composition");

# f(x) = x^2 + 2x at x=3: val = 9+6 = 15, deriv = 2x+2 = 8
var ad_x = dual_var(f64_from(3));
var ad_x_sq = dual_mul(ad_x, ad_x);
var ad_2x = dual_mul(dual_const(F64_TWO), ad_x);
var ad_comp = dual_add(ad_x_sq, ad_2x);
assert_eq(f64_to(Dual_val(ad_comp)), 15, "x^2+2x at 3 val=15");
assert_eq(f64_to(Dual_deriv(ad_comp)), 8, "x^2+2x at 3 deriv=8");

# ================================================================
# INTERVAL (~10)
# ================================================================
test_group("interval: arithmetic");

# NOTE: the interval result vars are named iv_sum/iv_diff/iv_prod, NOT
# iv_add/iv_sub/iv_mul. Those three names are RESERVED SIMD intrinsics in cyrius
# (packed integer-vector add/sub/mul) and cannot be used as identifiers, at file
# scope or inside a fn. iv_div/iv_neg are fine (there is no integer-vector
# divide, so iv_div was never reserved). Do NOT rename these back — doing so
# takes this whole suite down at compile time.
#
# The DIAGNOSTIC changed in cyrius 6.5.9 and this note used to quote the old one.
# Re-verified on 6.5.16 (2026-08-09), the message is now:
#   expected identifier, got reserved keyword 'iv_add' (cannot be used as an
#   identifier; rename the variable/field/fn)
# It was `expected identifier, got unknown`, which named nothing. If you are
# reading this after trying the original names and seeing a message that does not
# match, the reservation still stands — check the wording, not the rule.
# See docs/development/issues/archived/2026-07-17-cyrius-interval-ident-lex.md.
var iv_a = ivl_new(f64_from(1), f64_from(3));
var iv_b = ivl_new(f64_from(2), f64_from(4));

# Add: [1,3]+[2,4] = [3,7]
var iv_sum = ivl_add(iv_a, iv_b);
assert_eq(f64_to(Interval_lo(iv_sum)), 3, "ivl add lo");
assert_eq(f64_to(Interval_hi(iv_sum)), 7, "ivl add hi");

# Sub: [1,3]-[2,4] = [1-4, 3-2] = [-3, 1]
var iv_diff = ivl_sub(iv_a, iv_b);
assert_eq(f64_to(Interval_lo(iv_diff)), (0 - 3), "ivl sub lo");
assert_eq(f64_to(Interval_hi(iv_diff)), 1, "ivl sub hi");

# Mul: [1,3]*[2,4] = [2,12]
var iv_prod = ivl_mul(iv_a, iv_b);
assert_eq(f64_to(Interval_lo(iv_prod)), 2, "ivl mul lo");
assert_eq(f64_to(Interval_hi(iv_prod)), 12, "ivl mul hi");

# Div: [1,3]/[2,4] = [1/4, 3/2] = [0.25, 1.5]
var iv_div = ivl_div(iv_a, iv_b);
var iv_div_lo100 = f64_to(f64_round(f64_mul(Interval_lo(iv_div), f64_from(100))));
assert_eq(iv_div_lo100, 25, "ivl div lo*100=25");

# ----------------------------------------------------------------
test_group("interval: queries");

assert_eq(ivl_contains(iv_a, f64_from(2)), 1, "ivl contains 2");
assert_eq(ivl_contains(iv_a, f64_from(4)), 0, "ivl not contains 4");
assert_eq(ivl_overlaps(iv_a, iv_b), 1, "ivl overlaps");
assert_eq(f64_to(ivl_width(iv_a)), 2, "ivl width=2");
assert_eq(f64_to(ivl_midpoint(iv_a)), 2, "ivl midpoint=2");

# ----------------------------------------------------------------
test_group("interval: neg, abs, sqrt, point");

# Neg: -[1,3] = [-3,-1]
var iv_neg = ivl_neg(iv_a);
assert_eq(f64_to(Interval_lo(iv_neg)), (0 - 3), "ivl neg lo");
assert_eq(f64_to(Interval_hi(iv_neg)), (0 - 1), "ivl neg hi");

# Abs: |[-3,1]| = [0,3] (contains 0)
var iv_neg3_1 = ivl_new(f64_neg(f64_from(3)), F64_ONE);
var iv_abs = ivl_abs(iv_neg3_1);
assert_eq(f64_to(Interval_lo(iv_abs)), 0, "ivl abs lo=0");
assert_eq(f64_to(Interval_hi(iv_abs)), 3, "ivl abs hi=3");

# Sqrt: sqrt([4,9]) = [2,3]
var iv_49 = ivl_new(f64_from(4), f64_from(9));
var iv_sqrt = ivl_sqrt(iv_49);
assert_eq(f64_to(Interval_lo(iv_sqrt)), 2, "ivl sqrt lo=2");
assert_eq(f64_to(Interval_hi(iv_sqrt)), 3, "ivl sqrt hi=3");

# Point interval
var iv_pt = ivl_point(f64_from(5));
assert_eq(f64_to(ivl_width(iv_pt)), 0, "point width=0");
assert_eq(f64_to(ivl_midpoint(iv_pt)), 5, "point mid=5");

