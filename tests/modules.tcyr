    0x3E9A33C44F40B30E, 0), 0x3E9794FD7AC1BCB6,
  "gjk_epa_3d: a fit gone far lands by the cap: the closed forms from there");

# === 3.4.1 CO8: the order, and two curved shapes with no ball ===
test_group("gjk_epa_3d: the order, and what no ball costs (review pass CO8)");
# One answer per pair: the section's depth comes back from the other order, bit for bit.
_co8_cyl(0xC088BF0207BB1404, 0xBFE24E34D92C20A0, 0x3FD535778CCC41D0, 0x3FE279A74590331D, 0x3FE279A74590331D,
  0x3FE279A74590331D, 0x3FC883764EA2CE88, 0x3FA3B0B16F05D503);
var _co8_r0 = _co8_q(0xC088BDE35976D90D, 0xBFE0A233CA29FB4D, 0x3FCA5187DE4F3851, 0x3FFE222F2F41DDC9, 0);
assert_eq(gjk_epa_3d(&_co8_sup_cyl, _co8_c, &_co8_sup_ball, _co8_b, _co8_n, _co8_d), 1,
  "gjk_epa_3d: the other order is a contact");
assert_eq(load64(_co8_d), _co8_r0, "gjk_epa_3d: ... at the same bits");
# No ball to read. A box's corner on a cylinder's cap: a rate of 0 stops the reading, and the section
# (234 calls more) is not asked. [measured: review pass CO8 cmp_pairs.py seed 1, pair 917; 2026-11-01]
fn _co8_sup_obb(s, d) {
    _co8_calls = _co8_calls + 1;
    return _mpr_sup_obb(s, d);
}
_co8_cyl(0x8000000000000000, 0x8000000000000000, 0x8000000000000000, 0, 0, F64_ONE, 0x3FF6EE49DAF1E1C4,
  0x3FDAF6D5EA745770);
var _co8_o = _mpr_mkobb(0x3F53F09AAEA252F2, 0xBF8A167E91FDE8E0, 0xC000589CD1C291A5,
  0x3FD220721AAECA9B, 0x3FF03A178769E782, 0x3FF581C2B1063439);
_mpr_obb_axis(_co8_o, 0, 0xBFE58B861275C56A, 0xBFE4F0D3F0D29595, 0xBFD606EE662A0692);
_mpr_obb_axis(_co8_o, 1, 0x3FCD678477F8F830, 0xBFE4153215F42656, 0x3FE7CDE3F787379F);
_mpr_obb_axis(_co8_o, 2, 0xBFE67D4A54502AB7, 0x3FDAFE6CF65D120E, 0x3FE254F88F65D71E);
_co8_calls = 0;
assert_eq(gjk_epa_3d(&_co8_sup_cyl, _co8_c, &_co8_sup_obb, _co8_o, _co8_n, _co8_d), 1,
  "gjk_epa_3d: a box's corner on a cap is a contact");
assert_eq(_co8_calls, 65, "gjk_epa_3d: ... with no ball read, no section");
# A polytope's edge on a cylinder's side: the crease reads a rate of 0, and neither cap is asked (88 more).
# [measured: review pass CO8 cmp_pairs.py seed 1, pair 2463; 2026-11-01]
fn _co8_sup_pol(s, d) {
    _co8_calls = _co8_calls + 1;
    var b = 0;
    var bd = _GA_F64_NEG_INF;
    for (var i = 0; i < 8; i = i + 1) {
        var v = hvec3_new(load64(s + i * 24), load64(s + i * 24 + 8), load64(s + i * 24 + 16));
        var dt = hvec3_dot(v, d);
        if (f64_gt(dt, bd) == 1) {
            bd = dt;
            b = v;
        }
    }
    return b;
}
var _co8_p = alloc(192);
store64(_co8_p + 0, 0x3FE2309240567ABA);
store64(_co8_p + 8, 0xBFD607BDA092479B);
store64(_co8_p + 16, 0xBFE1E0F994F3E966);
store64(_co8_p + 24, 0x3FDFC962BBCE7458);
store64(_co8_p + 32, 0xBFDA81CCF6F310F5);
store64(_co8_p + 40, 0xBFE3C2E7611A70D2);
store64(_co8_p + 48, 0x3FEA312A4A1C453C);
store64(_co8_p + 56, 0xBFEA778B8BF8EBFB);
store64(_co8_p + 64, 0x3F91BFD1CA93182E);
store64(_co8_p + 72, 0x3FD47405B3CD89EC);
store64(_co8_p + 80, 0xBFE9F06CB52F3B93);
store64(_co8_p + 88, 0x3F9EFE612F00BBBC);
store64(_co8_p + 96, 0x3FE7263AD94AB1D1);
store64(_co8_p + 104, 0xBFDCCB17C483E74B);
store64(_co8_p + 112, 0x3FB1AE958AD29532);
store64(_co8_p + 120, 0x3F9AA387205A088B);
store64(_co8_p + 128, 0x3FEAF9E9E04BD7ED);
store64(_co8_p + 136, 0xBFE1E3A49F223815);
store64(_co8_p + 144, 0xBFE56FCADC61AEC2);
store64(_co8_p + 152, 0xBFA576BCFE841FA7);
store64(_co8_p + 160, 0xBFE1C83F83701522);
store64(_co8_p + 168, 0x3F8D4EE56DE1876A);
store64(_co8_p + 176, 0x3FE80B53811383F8);
store64(_co8_p + 184, 0x3FE1C862F71ABA2F);
_co8_cyl(0xBFC9510C86AABD8C, 0x3FF2B591815F5D0F, 0xBFEBA9B4F5BA31F3, F64_ONE, 0, 0, 0x3FDDC64D2984FE84,
  0x3FD113F200040BDE);
_co8_calls = 0;
assert_eq(gjk_epa_3d(&_co8_sup_pol, _co8_p, &_co8_sup_cyl, _co8_c, _co8_n, _co8_d), 1,
  "gjk_epa_3d: a polytope on a cylinder's side is a contact");
assert_eq(_co8_calls, 99, "gjk_epa_3d: ... with no ball read on the crease, no cap asked");
# A ball by a cone's rim: where the core's run moved the answer, the crease the fit read before it is
# gone, and the reading goes by the curvature (12,429 eps without). The first edge's chord can be a
# diagonal of the section, a triangle's, and the loop replaces it (m_iter1 in the report).
# [measured: review pass CO8 gep4.py seed 1 row 2731, mpmath oracle cmpc.py, this tree; 2026-11-01]
fn _co8_sup_cone(sh, d) {
    var ux = load64(sh + 24);
    var uy = load64(sh + 32);
    var uz = load64(sh + 40);
    var r = load64(sh + 48);
    var hh = load64(sh + 56);
    var dx = HVec3_x(d);
    var dy = HVec3_y(d);
    var dz = HVec3_z(d);
    var du = f64_add(f64_add(f64_mul(dx, ux), f64_mul(dy, uy)), f64_mul(dz, uz));
    var px = f64_sub(dx, f64_mul(du, ux));
    var py = f64_sub(dy, f64_mul(du, uy));
    var pz = f64_sub(dz, f64_mul(du, uz));
    var dp = f64_add(f64_add(f64_mul(px, ux), f64_mul(py, uy)), f64_mul(pz, uz));
    px = f64_sub(px, f64_mul(dp, ux));
    py = f64_sub(py, f64_mul(dp, uy));
    pz = f64_sub(pz, f64_mul(dp, uz));
    var pl = f64_sqrt(f64_add(f64_add(f64_mul(px, px), f64_mul(py, py)), f64_mul(pz, pz)));
    var cx = load64(sh);
    var cy = load64(sh + 8);
    var cz = load64(sh + 16);
    if (f64_gt(f64_mul(du, hh), f64_mul(pl, r)) == 1) {
        return hvec3_new(f64_add(cx, f64_mul(ux, hh)), f64_add(cy, f64_mul(uy, hh)), f64_add(cz, f64_mul(uz, hh)));
    }
    var k = 0;
    if (f64_gt(pl, f64_mul(f64_sqrt(hvec3_dot(d, d)), 0x3CF0000000000000)) == 1) { k = f64_div(r, pl); }
    return hvec3_new(f64_add(cx, f64_mul(px, k)), f64_add(cy, f64_mul(py, k)), f64_add(cz, f64_mul(pz, k)));
}
_co8_cyl(0xBFD4FB9F857F20A8, 0x4055583BE2F8CDFB, 0x405528EA3F8560C8,
  0xBFECDCC0EA135059, 0xBFCD88559C5EB239, 0xBFD75CE4779E1459,
  0x3FCB3959ED962DCF, 0x3FD15AA0541E7E7E);
store64(_co8_b, 0xBFD1CC5CF1793ED1);
store64(_co8_b + 8, 0x4055534BCC128C71);
store64(_co8_b + 16, 0x4055200DC8C0AAA7);
store64(_co8_b + 24, 0x3FF5B80EADB853A0);
assert_eq(mpr_penetration(&_co8_sup_ball, _co8_b, &_co8_sup_cone, _co8_c, _co8_n, _co8_d), 1,
  "mpr_penetration: a ball by a cone's rim is a contact");
assert_eq(load64(_co8_d), 0x3FF61829CA8868B8, "mpr_penetration: ... at the depth the core's run left (CO8)");

var r = assert_summary();
# Clamp before exiting: assert_summary() returns the raw failure COUNT, and a wait
# status is only 8 bits — an unclamped 256 / 512 / 768 failures would wrap to status 0 and
# score PASS. Any failure at all becomes status 1.
if (r > 0) { r = 1; }
sys_exit_group(r);

