test_group("calc: easing");

# ease_in: t^2
assert_eq(ease_in(0), f64_from(0), "ease_in(0)");
assert_eq(ease_in(F64_ONE), f64_from(1), "ease_in(1)");

# ease_out: t*(2-t)
assert_eq(ease_out(0), f64_from(0), "ease_out(0)");
assert_eq(ease_out(F64_ONE), f64_from(1), "ease_out(1)");

# ease_in_out: t^2*(3-2t)
assert_eq(ease_in_out(0), f64_from(0), "ease_in_out(0)");
assert_eq(ease_in_out(F64_ONE), f64_from(1), "ease_in_out(1)");

# ease_in_cubic: t^3
assert_eq(ease_in_cubic(0), f64_from(0), "ease_in_cubic(0)");
assert_eq(ease_in_cubic(F64_ONE), f64_from(1), "ease_in_cubic(1)");

# ease_out_cubic: 1-(1-t)^3
assert_eq(ease_out_cubic(0), f64_from(0), "ease_out_cubic(0)");
assert_eq(ease_out_cubic(F64_ONE), f64_from(1), "ease_out_cubic(1)");

# ease_in_out_smooth (smootherstep)
assert_eq(ease_in_out_smooth(0), f64_from(0), "smootherstep(0)");
assert_eq(ease_in_out_smooth(F64_ONE), f64_from(1), "smootherstep(1)");

# ================================================================
# NUM — root finding, number theory, RNG, summation, FFT (~30)
# ================================================================
test_group("num: newton");

var n_out = alloc(8);
var n_rc_t, n_rc_v = num_newton(&_tn_f, &_tn_df, F64_ONE, EPSILON_F64, 100, n_out);
assert_eq(is_ok(n_rc_t), 1, "newton ok");
var n_val = load64(n_out);
# ⭐ 3.3.5 — the three roots below were compared through f64_round (+/-5e-4 here, +/-0.5
# on the next two). num_newton's contract is |f(x)| < tol, so: x^2 - 2 gives
# |x - sqrt 2| = |f| / (x + sqrt 2) < tol / 2 (against fl(sqrt 2), 1e-16 away); x^3 - 8
# gives |x - 2| = |f| / (x^2 + 2x + 4) < tol / 7 for any x > 1; and x - 5 is solved
# exactly by its first step, 0 - (0 - 5) / 1. Measured: fl(sqrt 2), 2 + 51 ulp, 5.
# [measured: scratch probe, not reproducible in-tree, 2026-10-11; cycc 6.6.14]
assert(f64_lt(f64_abs(f64_sub(n_val, 0x3FF6A09E667F3BCD)), f64_mul(EPSILON_F64, F64_HALF)) == 1,
  "newton sqrt2: |x - sqrt 2| < tol/2");

# Newton cube root of 8: x^3 - 8 = 0, root = 2

var n_cube_out = alloc(8);
var _r11t, _r11v = num_newton(&_tn_cube_f, &_tn_cube_df, f64_from(3), EPSILON_F64, 100, n_cube_out);
assert(f64_lt(f64_abs(f64_sub(load64(n_cube_out), F64_TWO)), f64_div(EPSILON_F64, f64_from(7))) == 1,
  "newton cube root 8: |x - 2| < tol/7");

# Newton linear: x - 5 = 0, root = 5

var n_lin_out = alloc(8);
var _r12t, _r12v = num_newton(&_tn_lin_f, &_tn_lin_df, 0, EPSILON_F64, 100, n_lin_out);
assert_eq(load64(n_lin_out), 0x4014000000000000, "newton linear root = 5 exactly");

# Newton sin root at 0

var n_sin_out = alloc(8);
var n_sin_rc_t, n_sin_rc_v = num_newton(&_tn_sin_f, &_tn_sin_df, F64_HALF, EPSILON_F64, 100, n_sin_out);
assert_eq(is_ok(n_sin_rc_t), 1, "newton sin converged");
# num_newton returns the first iterate with |sin(x)| < tol = EPSILON_F64 = 1e-12.
# Near 0, |sin x| >= |x| - |x|^3/6, so the root is bounded by 1.0000000000002e-12
# -- and that bound also excludes the other roots (+-pi, ...). Measured: 1.21e-14.
# The old bound of 1.0 was satisfied by every point in (-1, 1), including x0=0.5.
# [measured: tests/modules.tcyr "newton sin root == 0 (1e-12)" bounds it; 1.21e-14 is a 2.7.0 print, python agrees]
assert(f64_lt(f64_abs(load64(n_sin_out)), EPSILON_F64) == 1, "newton sin root == 0 (1e-12)");

# ----------------------------------------------------------------
test_group("num: bisection");

var n_bis_out = alloc(8);
var n_bis_rc_t, n_bis_rc_v = num_bisection(&_tn_f, F64_ONE, F64_TWO, EPSILON_F64, 100, n_bis_out);
assert_eq(is_ok(n_bis_rc_t), 1, "bisection ok");
# Either exit bounds the root within tol / 2: |f(mid)| < tol does as for newton above, and
# a bracket narrower than tol holds the root within half its width of the midpoint.
# Measured 0x3FF6A09E667F4000, 2.4e-13 above sqrt 2 (round(1000 x) = 1414 accepted 5e-4).
# [measured: scratch probe, not reproducible in-tree, 2026-10-11; cycc 6.6.14]
assert(f64_lt(f64_abs(f64_sub(load64(n_bis_out), 0x3FF6A09E667F3BCD)), f64_mul(EPSILON_F64, F64_HALF)) == 1,
  "bisection sqrt2: |x - sqrt 2| < tol/2");

# Bisection same-sign error
var n_bis_err_t, n_bis_err_v = num_bisection(&_tn_f, f64_from(2), f64_from(3), EPSILON_F64, 100, n_bis_out);
assert_eq(is_err_result(n_bis_err_t), 1, "bisection same sign -> Err");

