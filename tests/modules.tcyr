  hvec3_new(0xBFE5F5EAA9E317B3, 0xBFE6A07555925350, 0x3FC5D2302276FE31),
  hvec3_new(0x3FB1D90BCB6481D1, 0x3FC5AD656A6F0B89, 0x3FEF7571487E248B));
