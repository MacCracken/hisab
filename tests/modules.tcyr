assert_eq(_co8_q(0xBFD9685BA0C26508, 0x3FA01C49ABB0828C, 0x3FF50A5E67E9CAA0,
    0x3FCB75846BF70862, 0), 0x3FCB7582CC048A72,
  "gjk_epa_3d: the same, the axis along +z");
# past the cap, by the rim: the polish's path asks the section whatever the depth; g5[310], +0.0353.
# [measured: review pass CO8 mktests.py, mpmath 50 digits, this tree; 2026-11-01]
_co8_cyl(0xC08D2FB89C668CD2, 0x408CF57DF24ADD9A, 0x408C0EE1E0E1426A,
  0x3FAB119AA7FFF0ED, 0x3FEAC3D0EA232585, 0xBFE17537AB3A1B8A,
  0x3FF6CB10A3137A0F, 0x3FE7689728752EFC);
assert_eq(_co8_q(0xC08D3A2681444819, 0x408CFCEE30B10405, 0x408C0E88D78CD968,
    0x3FF76BBEDE44661D, 0), 0x3FF767C47CD60E49,
  "gjk_epa_3d: past the cap, by the rim: the polish's path asks the section whatever the depth");
# a fit gone far lands by the cap: the closed forms from there; g5[1594], +0.000107.
