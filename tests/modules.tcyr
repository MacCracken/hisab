test_group("geo: aabb center and size");

var g_aabb_cs = geo_aabb_new(hvec3_new(f64_from(2), f64_from(4), f64_from(6)),
  hvec3_new(f64_from(4), f64_from(8), f64_from(10)));
var g_center = geo_aabb_center(g_aabb_cs);
assert_eq(HVec3_x(g_center), f64_from(3), "aabb center.x");
assert_eq(HVec3_y(g_center), f64_from(6), "aabb center.y");
var g_size = geo_aabb_size(g_aabb_cs);
assert_eq(HVec3_x(g_size), f64_from(2), "aabb size.x");
assert_eq(HVec3_z(g_size), f64_from(4), "aabb size.z");

# === 3.3.3 W3: geo_aabb_new with a NaN corner, in both argument orders ===
# ⛔ 3.3.3 — geo_aabb_new sorts its corners with hvec3_min / hvec3_max, which through
# 3.3.2 dropped a NaN in their FIRST argument: with corner a = (NaN, 2, 3) and
# b = (1, 5, 6), geo_aabb_new(a, b) had x-slab [1, 1], finite and degenerate, while
# geo_aabb_new(b, a) had [NaN, NaN]. The box now depends on the corners, not their order.
# [measured: scratch probe on the 3.3.2 bundle, not reproducible in-tree, 2026-10-01; cycc 6.6.12]
var _w3_gnan = 0x7FF8000000000000;
var _w3_gca = hvec3_new(_w3_gnan, F64_TWO, f64_from(3));
var _w3_gcb = hvec3_new(F64_ONE, f64_from(5), f64_from(6));
var _w3_gab = geo_aabb_new(_w3_gca, _w3_gcb);
var _w3_gba = geo_aabb_new(_w3_gcb, _w3_gca);
assert_eq(HVec3_x(GeoAabb_min(_w3_gab)), _w3_gnan, "aabb_new(NaN corner, b): min.x is NaN (3.3.2: 1)");
assert_eq(HVec3_x(GeoAabb_max(_w3_gab)), _w3_gnan, "aabb_new(NaN corner, b): max.x is NaN (3.3.2: 1)");
assert_eq(HVec3_x(GeoAabb_min(_w3_gba)), _w3_gnan, "aabb_new(b, NaN corner): min.x is NaN");
assert_eq(HVec3_x(GeoAabb_max(_w3_gba)), _w3_gnan, "aabb_new(b, NaN corner): max.x is NaN");
assert_eq(HVec3_y(GeoAabb_min(_w3_gab)), F64_TWO, "aabb_new(NaN corner, b): the finite y-slab is [2, 5]");
assert_eq(HVec3_y(GeoAabb_max(_w3_gba)), f64_from(5), "aabb_new(b, NaN corner): the finite y-slab is [2, 5]");
# Zero corners of opposite sign: min -0 and max +0 in either order (3.3.2 gave
# [+0, +0] one way round and [-0, -0] the other).
var _w3_gz = 0x8000000000000000;
var _w3_gzab = geo_aabb_new(hvec3_new(_w3_gz, 0, 0), hvec3_new(0, F64_ONE, F64_ONE));
var _w3_gzba = geo_aabb_new(hvec3_new(0, F64_ONE, F64_ONE), hvec3_new(_w3_gz, 0, 0));
assert_eq(HVec3_x(GeoAabb_min(_w3_gzab)), _w3_gz, "aabb_new((-0,..), (+0,..)): min.x is -0 (3.3.2: +0)");
assert_eq(HVec3_x(GeoAabb_max(_w3_gzab)), 0, "aabb_new((-0,..), (+0,..)): max.x is +0");
assert_eq(HVec3_x(GeoAabb_min(_w3_gzba)), _w3_gz, "aabb_new((+0,..), (-0,..)): min.x is -0");
assert_eq(HVec3_x(GeoAabb_max(_w3_gzba)), 0, "aabb_new((+0,..), (-0,..)): max.x is +0 (3.3.2: -0)");

# ----------------------------------------------------------------
test_group("geo: ray-plane");

var g_rp_ray = geo_ray_new(hvec3_new(0, f64_from(5), 0), hvec3_new(0, f64_neg(F64_ONE), 0));
var g_rp_t = geo_ray_plane(g_rp_ray, g_plane);
assert_eq(g_rp_t, f64_from(5), "ray-plane hit");

# Parallel ray (miss)
var g_rp_par = geo_ray_new(hvec3_new(0, f64_from(5), 0), hvec3_unit_x());
# 0, not the old -1. -1 as an f64 bit pattern is a NEGATIVE NaN, which the
# module header never promised and which poisons any arithmetic done on it.
assert_eq(geo_ray_plane(g_rp_par, g_plane), 0, "ray-plane parallel miss");

# Behind origin (negative t)
var g_rp_behind = geo_ray_new(hvec3_new(0, f64_neg(F64_ONE), 0), hvec3_new(0, f64_neg(F64_ONE), 0));
assert_eq(geo_ray_plane(g_rp_behind, g_plane), 0, "ray-plane behind");

# --- 2026-08-04 audit, api-consistency (low): geo_ray_plane's doc block stated
# the OPPOSITE convention to the code ("-1 on miss, negative sentinel, not 0, to
# distinguish t = 0 hits") on the line directly above the 2.7.0 note that says 0.
# The CODE was right -- src/geo.cyr's module header and its "Ray intersection
# tests" section header both promise 0 on a miss, and every sibling ray_* returns
# 0 -- so the doc line was replaced. These pin the convention
# the doc now states, so the two cannot drift apart again.
#
# 1. A miss is EXACTLY the integer 0, never the -1 that the stale line named.
#    -1 as an f64 bit pattern is 0xFFFFFFFFFFFFFFFF, a negative NaN.
assert_eq(geo_ray_plane(g_rp_par, g_plane), 0,
  "geo_ray_plane: the doc's return convention, pinned -- a miss is 0, not -1");
assert(geo_ray_plane(g_rp_par, g_plane) != (0 - 1),
  "geo_ray_plane: a miss is not the pre-2.7.0 -1 sentinel");
# 2. The miss value is arithmetically usable, which the -1 sentinel was not:
#    f64 zero compares equal to zero and adding 1 gives 1. A NaN fails both.
var g_rp_miss = geo_ray_plane(g_rp_par, g_plane);
assert_eq(f64_eq(g_rp_miss, 0), 1, "geo_ray_plane: the miss value is f64 zero, not NaN");
assert_eq(f64_add(g_rp_miss, F64_ONE), F64_ONE,
  "geo_ray_plane: arithmetic on the miss value does not poison (0 + 1 == 1)");
# 3. A hit is strictly positive t, and geo_ray_at reproduces the plane point.
assert(f64_gt(g_rp_t, 0) == 1, "geo_ray_plane: a hit is a strictly positive t");
assert_eq(HVec3_y(geo_ray_at(g_rp_ray, g_rp_t)), 0,
  "geo_ray_plane: ray_at(t) lands exactly on the plane");
# 4. The documented collision, MEASURED rather than assumed: an origin lying ON
#    the plane is a t = 0 hit and carries no information a miss does not. Which
#    ZERO comes back depends on the sign of `denom`, because t is computed as
#    0 / denom:
#      direction -y (denom = -1) -> -0.0, bit pattern 0x8000000000000000
#      direction +y (denom = +1) -> +0.0, bit pattern 0, byte-identical to a miss
#    Both are f64-equal to zero, so f64_eq / f64_lt / f64_gt cannot separate a
#    grazing hit from a miss either way. Pinned so neither the doc nor the code
#    can drift from this without a failing assertion.
#    [measured: tests/modules.tcyr "geo_ray_plane: origin ON the plane, denom < 0 -> negative zero" and its +0.0 twin]
var g_rp_on_neg = geo_ray_new(hvec3_zero(), hvec3_new(0, f64_neg(F64_ONE), 0));
assert_eq(geo_ray_plane(g_rp_on_neg, g_plane), 0x8000000000000000,
  "geo_ray_plane: origin ON the plane, denom < 0 -> negative zero");
var g_rp_on_pos = geo_ray_new(hvec3_zero(), hvec3_unit_y());
assert_eq(geo_ray_plane(g_rp_on_pos, g_plane), 0,
  "geo_ray_plane: origin ON the plane, denom > 0 -> +0.0, byte-identical to a miss");
assert_eq(f64_eq(geo_ray_plane(g_rp_on_neg, g_plane), 0), 1,
  "geo_ray_plane: the -0.0 grazing hit is f64-equal to the miss value");
assert_eq(f64_gt(geo_ray_plane(g_rp_on_neg, g_plane), 0), 0,
  "geo_ray_plane: a grazing hit fails the `t > 0` hit test, both signs of zero");

# ----------------------------------------------------------------
test_group("geo: ray-sphere");

# Hit
var g_rs_ray = geo_ray_new(hvec3_zero(), hvec3_unit_z());
var g_rs_sph = geo_sphere_new(hvec3_new(0, 0, f64_from(5)), F64_ONE);
var g_rs_t = geo_ray_sphere(g_rs_ray, g_rs_sph);
assert_eq(g_rs_t, f64_from(4), "ray-sphere hit t=4");

# Miss (perpendicular)
var g_rs_miss = geo_ray_new(hvec3_new(0, f64_from(10), 0), hvec3_unit_z());
assert_eq(geo_ray_sphere(g_rs_miss, g_rs_sph), 0, "ray-sphere miss");

# Inside sphere: origin inside, should get positive t for exit
var g_rs_inside = geo_ray_new(hvec3_new(0, 0, f64_from(5)), hvec3_unit_z());
var g_rs_t2 = geo_ray_sphere(g_rs_inside, g_rs_sph);
assert(g_rs_t2 != 0, "ray-sphere inside hit");
assert_eq(g_rs_t2, f64_from(1), "ray-sphere inside t=1");

# Tangent: origin at distance exactly radius from center along perpendicular approach
# Ray from (1,0,0) going +z toward sphere at (0,0,5) r=1 should miss
var g_rs_tang = geo_ray_new(hvec3_new(F64_ONE, 0, 0), hvec3_unit_z());
# distance from (1,0,5) to (0,0,5) is 1 = radius, so tangent
var g_rs_tt = geo_ray_sphere(g_rs_tang, g_rs_sph);
# tangent at exactly r should still count as a hit (discriminant = 0)
assert(g_rs_tt != 0, "ray-sphere tangent");

# ----------------------------------------------------------------
test_group("geo: ray-triangle");

var g_tri = geo_triangle_new(
  hvec3_new(f64_neg(F64_ONE), f64_neg(F64_ONE), f64_from(5)),
  hvec3_new(F64_ONE, f64_neg(F64_ONE), f64_from(5)),
  hvec3_new(0, F64_ONE, f64_from(5))
  );
var g_rt_ray = geo_ray_new(hvec3_zero(), hvec3_unit_z());
var g_rt_t = geo_ray_triangle(g_rt_ray, g_tri);
assert_eq(g_rt_t, f64_from(5), "ray-tri hit t=5");

# Miss: ray offset to the side
var g_rt_miss = geo_ray_new(hvec3_new(f64_from(10), 0, 0), hvec3_unit_z());
assert_eq(geo_ray_triangle(g_rt_miss, g_tri), 0, "ray-tri miss");

# Parallel to triangle plane
var g_rt_par = geo_ray_new(hvec3_zero(), hvec3_unit_x());
assert_eq(geo_ray_triangle(g_rt_par, g_tri), 0, "ray-tri parallel");

# Behind: ray pointing away from triangle
var g_rt_behind = geo_ray_new(hvec3_zero(), hvec3_new(0, 0, f64_neg(F64_ONE)));
assert_eq(geo_ray_triangle(g_rt_behind, g_tri), 0, "ray-tri behind");

# ----------------------------------------------------------------
test_group("geo: aabb-aabb overlap");

var g_aabb1 = geo_aabb_new(hvec3_new(f64_neg(F64_ONE), f64_neg(F64_ONE), f64_neg(F64_ONE)),
  hvec3_new(F64_ONE, F64_ONE, F64_ONE));
var g_aabb2 = geo_aabb_new(hvec3_zero(), hvec3_new(F64_TWO, F64_TWO, F64_TWO));
assert_eq(geo_aabb_aabb(g_aabb1, g_aabb2), 1, "aabb overlap");

# No overlap
var g_aabb3 = geo_aabb_new(hvec3_new(f64_from(5), f64_from(5), f64_from(5)),
  hvec3_new(f64_from(6), f64_from(6), f64_from(6)));
assert_eq(geo_aabb_aabb(g_aabb1, g_aabb3), 0, "aabb no overlap");

# Touching (edge contact)
var g_aabb4 = geo_aabb_new(hvec3_new(F64_ONE, 0, 0), hvec3_new(F64_TWO, F64_ONE, F64_ONE));
assert_eq(geo_aabb_aabb(g_aabb1, g_aabb4), 1, "aabb touching");

# Contained
var g_aabb5 = geo_aabb_new(hvec3_new(f64_neg(F64_HALF), f64_neg(F64_HALF), f64_neg(F64_HALF)),
  hvec3_new(F64_HALF, F64_HALF, F64_HALF));
assert_eq(geo_aabb_aabb(g_aabb1, g_aabb5), 1, "aabb contained");

# === 3.3.4: a NaN bound is no overlap ===
# ⛔ 3.3.4 — each test answered 0 only for an axis provably separated, and one that
# reads a NaN is false, so geo_aabb_new((NaN,0,0), (1,1,1)) overlapped
# [100,101] x [0,1] x [0,1]. A NaN shape is never a contact (geo_sphere_sphere below).
# Then each of the six tests alone: [0,1]^3 with ONE bound set NaN, `slot` counting
# min.x, min.y, min.z, max.x, max.y, max.z, against [0.5,1.5]^3, which every other
# test passes, so only the test reading the NaN can answer 0.
# [measured: spatial lane probe, 3.3.4-base bundle, not in-tree, 2026-10-03; cycc 6.6.14]
var _sp4_anan = 0x7FF8000000000000;
var _sp4_afar = geo_aabb_new(hvec3_new(f64_from(100), 0, 0), hvec3_new(f64_from(101), F64_ONE, F64_ONE));
var _sp4_anb = geo_aabb_new(hvec3_new(_sp4_anan, 0, 0), hvec3_one());
assert_eq(geo_aabb_aabb(_sp4_anb, _sp4_afar), 0,
  "geo_aabb_aabb: NaN x-slab box vs [100,101] x [0,1]^2 -> 0 (3.3.3: 1)");
assert_eq(geo_aabb_aabb(_sp4_afar, _sp4_anb), 0, "geo_aabb_aabb: ... in the other argument order too");
fn _sp4_aabb_slot(slot) {
    var mn = hvec3_zero();
    var mx = hvec3_one();
    if (slot == 0) { HVec3_set_x(mn, _sp4_anan); }
    if (slot == 1) { HVec3_set_y(mn, _sp4_anan); }
    if (slot == 2) { HVec3_set_z(mn, _sp4_anan); }
    if (slot == 3) { HVec3_set_x(mx, _sp4_anan); }
    if (slot == 4) { HVec3_set_y(mx, _sp4_anan); }
    if (slot == 5) { HVec3_set_z(mx, _sp4_anan); }
    var a = alloc(sizeof(GeoAabb));
    GeoAabb_set_min(a, mn);
    GeoAabb_set_max(a, mx);
    return geo_aabb_aabb(a, geo_aabb_new(hvec3_splat(F64_HALF), hvec3_splat(0x3FF8000000000000)));
}
assert_eq(_sp4_aabb_slot(0 - 1), 1, "control: geo_aabb_aabb [0,1]^3 vs [0.5,1.5]^3 -> 1");
assert_eq(_sp4_aabb_slot(0), 0, "geo_aabb_aabb: min.x NaN -> 0 (3.3.3: 1)");
assert_eq(_sp4_aabb_slot(1), 0, "geo_aabb_aabb: min.y NaN -> 0 (3.3.3: 1)");
assert_eq(_sp4_aabb_slot(2), 0, "geo_aabb_aabb: min.z NaN -> 0 (3.3.3: 1)");
assert_eq(_sp4_aabb_slot(3), 0, "geo_aabb_aabb: max.x NaN -> 0 (3.3.3: 1)");
assert_eq(_sp4_aabb_slot(4), 0, "geo_aabb_aabb: max.y NaN -> 0 (3.3.3: 1)");
assert_eq(_sp4_aabb_slot(5), 0, "geo_aabb_aabb: max.z NaN -> 0 (3.3.3: 1)");
# === 3.3.4: an inverted box (min above max, the setters only) is read sorted ===
# ⛔ 3.3.4 — the six tests read the x-slab [5, 1] against [0, 10], [3, 4] and [0, 2] as
# 1, 0, 0: neither empty nor [1, 5], which is how a ray crossing x reads it. Box a is
# stored as [alo, ahi] on `axis` and b as [blo, bhi], [0, 1] on the other axes, and
# `side` 1 passes them in the other order. Each of the six tests alone fails first: a
# stored [5, 1] against [2, 3] fails a.min <= b.max on `axis`; [2, 3] against b
# stored [4, 2.5] fails b.min <= a.max there, after every a.min test passed. Both
# overlap sorted.
fn _sp4_invov(axis, side, alo, ahi, blo, bhi) {
    var amn = hvec3_zero();
    var amx = hvec3_one();
    var bmn = hvec3_zero();
    var bmx = hvec3_one();
    if (axis == 0) { HVec3_set_x(amn, alo); HVec3_set_x(amx, ahi); HVec3_set_x(bmn, blo); HVec3_set_x(bmx, bhi); }
    if (axis == 1) { HVec3_set_y(amn, alo); HVec3_set_y(amx, ahi); HVec3_set_y(bmn, blo); HVec3_set_y(bmx, bhi); }
    if (axis == 2) { HVec3_set_z(amn, alo); HVec3_set_z(amx, ahi); HVec3_set_z(bmn, blo); HVec3_set_z(bmx, bhi); }
    var a = alloc(sizeof(GeoAabb));
    GeoAabb_set_min(a, amn);
    GeoAabb_set_max(a, amx);
    var b = alloc(sizeof(GeoAabb));
    GeoAabb_set_min(b, bmn);
    GeoAabb_set_max(b, bmx);
    if (side == 1) { return geo_aabb_aabb(b, a); }
    return geo_aabb_aabb(a, b);
}
var _sp4_f5 = f64_from(5);
var _sp4_f25 = 0x4004000000000000;   # 2.5
assert_eq(_sp4_invov(0, 0, _sp4_f5, F64_ONE, F64_TWO, f64_from(3)), 1,
  "geo_aabb_aabb: a.x stored [5, 1] vs [2, 3] -> 1, as [1, 5] (3.3.3: 0)");
assert_eq(_sp4_invov(1, 0, _sp4_f5, F64_ONE, F64_TWO, f64_from(3)), 1,
  "geo_aabb_aabb: a.y stored [5, 1] vs [2, 3] -> 1");
assert_eq(_sp4_invov(2, 0, _sp4_f5, F64_ONE, F64_TWO, f64_from(3)), 1,
  "geo_aabb_aabb: a.z stored [5, 1] vs [2, 3] -> 1");
assert_eq(_sp4_invov(0, 0, F64_TWO, f64_from(3), f64_from(4), _sp4_f25), 1,
  "geo_aabb_aabb: [2, 3] vs b.x stored [4, 2.5] -> 1, as [2.5, 4] (3.3.3: 0)");
assert_eq(_sp4_invov(1, 0, F64_TWO, f64_from(3), f64_from(4), _sp4_f25), 1,
  "geo_aabb_aabb: [2, 3] vs b.y stored [4, 2.5] -> 1");
assert_eq(_sp4_invov(2, 0, F64_TWO, f64_from(3), f64_from(4), _sp4_f25), 1,
  "geo_aabb_aabb: [2, 3] vs b.z stored [4, 2.5] -> 1");
# and sorted is still a box: [5, 4] is [4, 5], clear of [0, 1] below and [7, 8] above
assert_eq(_sp4_invov(0, 0, _sp4_f5, f64_from(4), 0, F64_ONE), 0, "geo_aabb_aabb: x stored [5, 4] vs [0, 1] -> 0");
assert_eq(_sp4_invov(0, 0, _sp4_f5, f64_from(4), f64_from(7), f64_from(8)), 0,
  "geo_aabb_aabb: x stored [5, 4] vs [7, 8] -> 0");
assert_eq(_sp4_invov(0, 1, _sp4_f5, F64_ONE, F64_TWO, f64_from(3)), 1,
  "geo_aabb_aabb: ... in the other argument order -> 1");

# ----------------------------------------------------------------
test_group("geo: sphere-sphere");

var g_s1 = geo_sphere_new(hvec3_zero(), F64_ONE);
var g_s2 = geo_sphere_new(hvec3_new(F64_ONE, 0, 0), F64_ONE);
assert_eq(geo_sphere_sphere(g_s1, g_s2), 1, "sphere overlap");

# No overlap
var g_s3 = geo_sphere_new(hvec3_new(f64_from(5), 0, 0), F64_ONE);
assert_eq(geo_sphere_sphere(g_s1, g_s3), 0, "sphere no overlap");

# Touching (distance = r1 + r2)
var g_s4 = geo_sphere_new(hvec3_new(F64_TWO, 0, 0), F64_ONE);
assert_eq(geo_sphere_sphere(g_s1, g_s4), 1, "sphere touching");

# === 3.3.3 R4geo: a NaN sphere is not a contact ===
# ⛔ 3.3.3 — the test read "dist_sq > (r1 + r2)^2 is a miss, anything else a hit", TRUE
# for NaN, so a NaN centre or radius overlapped everything. It is now "dist_sq <=
# (r1 + r2)^2 is a hit", NaN-false: a NaN shape is a miss, as "a NaN shape is never a
# contact" pins for the collision entry points. Every "3.3.2:" below is that bundle's
# answer. "sphere touching" above pins the `==` half (dist_sq exactly (r1 + r2)^2).
# [measured: R4geo probe on the 3.3.2 and 3.3.3-base bundles, not reproducible in-tree, 2026-10-01; cycc 6.6.12]
var _r4g_nan = 0x7FF8000000000000;
var _r4g_far = geo_sphere_new(hvec3_new(f64_from(100), 0, 0), F64_ONE);
assert_eq(geo_sphere_sphere(geo_sphere_new(hvec3_new(_r4g_nan, 0, 0), F64_ONE), _r4g_far), 0,
  "sphere_sphere: centre (NaN,0,0) against a sphere 100 away is a miss (3.3.2: 1)");
assert_eq(geo_sphere_sphere(_r4g_far, geo_sphere_new(hvec3_new(0, 0, _r4g_nan), F64_ONE)), 0,
  "sphere_sphere: ... and with the NaN centre in the second slot, in z (3.3.2: 1)");
assert_eq(geo_sphere_sphere(geo_sphere_new(hvec3_zero(), _r4g_nan), _r4g_far), 0,
  "sphere_sphere: radius NaN at the origin is a miss (3.3.2: 1)");
assert_eq(geo_sphere_sphere(geo_sphere_new(hvec3_new(F64_POS_INF, 0, 0), F64_ONE),
    geo_sphere_new(hvec3_new(F64_POS_INF, 0, 0), F64_ONE)), 0,
  "sphere_sphere: two centres at x = +Inf meet at Inf - Inf = NaN, a miss (3.3.2: 1)");
# Controls: an infinite radius is still containment, and an infinite distance a miss.
assert_eq(geo_sphere_sphere(geo_sphere_new(hvec3_zero(), F64_POS_INF), _r4g_far), 1,
  "control: radius +Inf at the origin contains the sphere 100 away");
assert_eq(geo_sphere_sphere(geo_sphere_new(hvec3_new(F64_POS_INF, 0, 0), F64_ONE), g_s1), 0,
  "control: a centre at x = +Inf is infinitely far from the unit sphere, a miss");

# ----------------------------------------------------------------
test_group("geo: closest point");

# Closest on plane
var g_cp_plane = geo_closest_point_on_plane(g_plane, hvec3_new(f64_from(3), f64_from(7), F64_ONE));
assert_eq(HVec3_x(g_cp_plane), f64_from(3), "closest plane.x");
assert_eq(HVec3_y(g_cp_plane), f64_from(0), "closest plane.y");

# Closest on sphere (outside)
var g_cp_sph = geo_closest_point_on_sphere(g_s1, hvec3_new(f64_from(5), 0, 0));
assert_eq(HVec3_x(g_cp_sph), f64_from(1), "closest sphere outside.x");

# Closest on sphere (at center — returns center + (r,0,0))
var g_cp_sph_c = geo_closest_point_on_sphere(g_s1, hvec3_zero());
assert_eq(HVec3_x(g_cp_sph_c), f64_from(1), "closest sphere at center.x");
# 3.3.7: point - centre that overflows (both finite) is formed from the halved inputs. The
# point (DBL_MAX, 0, 0) against the centre (-DBL_MAX, 0, 0), radius 1: exactly -DBL_MAX + 1,
# which rounds to -DBL_MAX (3.3.6: (NaN, 0, 0)); (DBL_MAX, DBL_MAX, 0): y = 1 / sqrt(5)
# correctly rounded, x -DBL_MAX (3.3.6: (NaN, 0, 0)).
# [measured: rt337 overflow sweep (row7.py, seed 701), exact Decimal points, 3.3.6 vs this tree, 2026-10-31]
var g_cp_ov = geo_closest_point_on_sphere(geo_sphere_new(hvec3_new(0xFFEFFFFFFFFFFFFF, 0, 0), F64_ONE),
  hvec3_new(0x7FEFFFFFFFFFFFFF, 0, 0));
assert_eq(HVec3_x(g_cp_ov), 0xFFEFFFFFFFFFFFFF,
  "closest sphere, point - centre overflowing: x = -DBL_MAX (3.3.6: NaN)");
var g_cp_ov2 = geo_closest_point_on_sphere(geo_sphere_new(hvec3_new(0xFFEFFFFFFFFFFFFF, 0, 0), F64_ONE),
  hvec3_new(0x7FEFFFFFFFFFFFFF, 0x7FEFFFFFFFFFFFFF, 0));
assert_eq(HVec3_x(g_cp_ov2), 0xFFEFFFFFFFFFFFFF,
  "closest sphere, ... (DBL_MAX, DBL_MAX, 0): x = -DBL_MAX (3.3.6: NaN)");
assert_eq(HVec3_y(g_cp_ov2), 0x3FDC9F25C5BFEDD9, "closest sphere, ... y = 1 / sqrt(5) rounded");
# An infinite radius keeps its arithmetic (the non-finite contract): x NaN, as in 3.3.6.
var g_cp_ovi = geo_closest_point_on_sphere(geo_sphere_new(hvec3_new(0xFFEFFFFFFFFFFFFF, 0, 0), F64_POS_INF),
  hvec3_new(0x7FEFFFFFFFFFFFFF, 0, 0));
assert(f64_eq(HVec3_x(g_cp_ovi), HVec3_x(g_cp_ovi)) == 0, "closest sphere, ... radius +Inf: x NaN, as before");

# Closest on AABB (outside)
var g_cp_aabb = geo_closest_point_on_aabb(g_aabb1, hvec3_new(f64_from(5), 0, 0));
assert_eq(HVec3_x(g_cp_aabb), f64_from(1), "closest aabb outside.x");

# Closest on AABB (inside, should clamp to self)
var g_cp_aabb_in = geo_closest_point_on_aabb(g_aabb1, hvec3_new(F64_HALF, 0, 0));
assert_f64_eq(HVec3_x(g_cp_aabb_in), f64_div(f64_from(5), f64_from(10)), "closest aabb inside.x");

# === 3.3.3 R4geo: geo_closest_point_on_aabb at a NaN bound ===
# ⛔ 3.3.3 — f64_clamp(x, lo, hi) tests x < lo and x > hi, both false against a NaN, so an
# axis with a NaN bound returned the query's own coordinate: geo_aabb_new((NaN,0,0),
# (1,1,1)) and (-5, 0.5, 0.5) gave (-5, 0.5, 0.5) (3.3.2: (1, 0.5, 0.5), from the slab
# [1, 1] its hvec3_min/hvec3_max built by dropping the NaN corner). A NaN bound is now
# NaN in its own component; the other two are their own clamps, bit-exact.
# THE TRUE VALUE: a box's closest point separates by axis — each component is that
# coordinate clamped to that axis's slab alone — so a NaN slab leaves only its own
# component unknown, as a NaN query coordinate always has.
# ONE-SIDED NaN bounds (built with the setters) put each of the six bound tests at the
# input where it alone decides: the query sits beyond the FINITE bound of that axis, so
# without the NaN test the clamp returns that finite bound — each "was" below, which is
# the 3.3.2 answer.
# [measured: R4geo probe on the 3.3.2 and 3.3.3-base bundles, not reproducible in-tree, 2026-10-01; cycc 6.6.12]
var _r4g_cnan = 0x7FF8000000000000;
var _r4g_cp = geo_closest_point_on_aabb(geo_aabb_new(hvec3_new(_r4g_cnan, 0, 0), hvec3_one()),
  hvec3_new(f64_from(0 - 5), F64_HALF, F64_HALF));
assert_eq(f64_eq(HVec3_x(_r4g_cp), HVec3_x(_r4g_cp)), 0,
  "closest_point_on_aabb: NaN x-slab -> x is NaN (3.3.2: 1, off the dropped corner; the bare clamp: -5)");
assert_eq(HVec3_y(_r4g_cp), F64_HALF, "closest_point_on_aabb: ... y is its own clamp, 0.5 (bits)");
assert_eq(HVec3_z(_r4g_cp), F64_HALF, "closest_point_on_aabb: ... z is its own clamp, 0.5 (bits)");
# Box [0,1]^3 with one bound set NaN, `slot` counting from zero through min.x, max.x,
# min.y, max.y, min.z, max.z; the query is 5 past the other bound of that axis, and 0.5
# on the other axes.
# Returns the NaN-component count of the answer times 10, plus the count of the other
# components that are exactly 0.5.
fn _r4g_onesided(slot) {
    var mn = hvec3_zero();
    var mx = hvec3_one();
    var q = hvec3_splat(F64_HALF);
    var off = f64_from(5);
    if (slot % 2 == 1) { off = f64_from(0 - 5); }
    if (slot == 0) { HVec3_set_x(mn, _r4g_cnan); HVec3_set_x(q, off); }
    if (slot == 1) { HVec3_set_x(mx, _r4g_cnan); HVec3_set_x(q, off); }
    if (slot == 2) { HVec3_set_y(mn, _r4g_cnan); HVec3_set_y(q, off); }
    if (slot == 3) { HVec3_set_y(mx, _r4g_cnan); HVec3_set_y(q, off); }
    if (slot == 4) { HVec3_set_z(mn, _r4g_cnan); HVec3_set_z(q, off); }
    if (slot == 5) { HVec3_set_z(mx, _r4g_cnan); HVec3_set_z(q, off); }
    var box = alloc(sizeof(GeoAabb));
    GeoAabb_set_min(box, mn);
    GeoAabb_set_max(box, mx);
    var r = geo_closest_point_on_aabb(box, q);
    var nans = (f64_eq(HVec3_x(r), HVec3_x(r)) == 0) + (f64_eq(HVec3_y(r), HVec3_y(r)) == 0)
    + (f64_eq(HVec3_z(r), HVec3_z(r)) == 0);
    var halves = (HVec3_x(r) == F64_HALF) + (HVec3_y(r) == F64_HALF) + (HVec3_z(r) == F64_HALF);
    return nans * 10 + halves;
}
assert_eq(_r4g_onesided(0), 12, "closest_point_on_aabb: min.x NaN, query x = 5 -> x NaN (was max.x, 1)");
assert_eq(_r4g_onesided(1), 12, "closest_point_on_aabb: max.x NaN, query x = -5 -> x NaN (was min.x, 0)");
assert_eq(_r4g_onesided(2), 12, "closest_point_on_aabb: min.y NaN, query y = 5 -> y NaN (was max.y, 1)");
assert_eq(_r4g_onesided(3), 12, "closest_point_on_aabb: max.y NaN, query y = -5 -> y NaN (was min.y, 0)");
assert_eq(_r4g_onesided(4), 12, "closest_point_on_aabb: min.z NaN, query z = 5 -> z NaN (was max.z, 1)");
assert_eq(_r4g_onesided(5), 12, "closest_point_on_aabb: max.z NaN, query z = -5 -> z NaN (was min.z, 0)");
# Control: infinite bounds are bounds, not NaN — the query inside [-Inf, +Inf]^3 is itself.
var _r4g_cpi = geo_closest_point_on_aabb(geo_aabb_new(hvec3_splat(f64_neg(F64_POS_INF)), hvec3_splat(F64_POS_INF)),
  hvec3_new(f64_from(0 - 5), 0x3FD0000000000000, f64_from(7)));
assert_eq(HVec3_x(_r4g_cpi), f64_from(0 - 5), "control: closest_point_on_aabb in the infinite box keeps x = -5");
assert_eq(HVec3_y(_r4g_cpi), 0x3FD0000000000000, "control: ... y = 0.25");
assert_eq(HVec3_z(_r4g_cpi), f64_from(7), "control: ... z = 7");

# ----------------------------------------------------------------
test_group("geo: triangle properties");

var g_tri2 = geo_triangle_new(
  hvec3_zero(),
  hvec3_new(F64_TWO, 0, 0),
  hvec3_new(0, F64_TWO, 0)
  );

# Area = 0.5 * |base| * |height| = 0.5 * 2 * 2 = 2
var g_area = geo_triangle_area(g_tri2);
assert_eq(g_area, f64_from(2), "triangle area");

# Centroid = (2/3, 2/3, 0). The vertex sum (2, 2, 0) is exact and 2 * fl(1/3) is an exact
# doubling equal to fl(2/3), so both coordinates are fl(2/3) to the bit (round(3 x) = 2
# accepted x in [0.5, 0.83)).
var g_centroid = geo_triangle_centroid(g_tri2);
assert_eq(HVec3_x(g_centroid), 0x3FE5555555555555, "triangle centroid.x = fl(2/3)");
assert_eq(HVec3_y(g_centroid), 0x3FE5555555555555, "triangle centroid.y = fl(2/3)");

# Normal: cross of (2,0,0)x(0,2,0) = (0,0,4) — z-component = 4
var g_normal = geo_triangle_normal(g_tri2);
assert_eq(HVec3_z(g_normal), f64_from(4), "triangle normal.z");

# ----------------------------------------------------------------
test_group("geo: SDF");

# SDF sphere: (3,0,0), center=origin, r=1 -> d = 2
var g_sdf_s = sdf_sphere(hvec3_new(f64_from(3), 0, 0), hvec3_zero(), F64_ONE);
assert_eq(g_sdf_s, f64_from(2), "sdf sphere outside");

# SDF sphere inside: (0,0,0), center=origin, r=2 -> d = -2
var g_sdf_si = sdf_sphere(hvec3_zero(), hvec3_zero(), F64_TWO);
assert_eq(g_sdf_si, f64_neg(f64_from(2)), "sdf sphere inside");

# SDF box: point at (3,0,0), center=origin, half=(1,1,1) -> d = 2
var g_sdf_b = sdf_box(hvec3_new(f64_from(3), 0, 0), hvec3_zero(),
  hvec3_new(F64_ONE, F64_ONE, F64_ONE));
assert_eq(g_sdf_b, f64_from(2), "sdf box outside");

# CSG union
assert_eq(sdf_union(f64_from(3), f64_from(5)), f64_from(3), "sdf union");
# CSG intersection
assert_eq(sdf_intersection(f64_from(3), f64_from(5)), f64_from(5), "sdf intersection");
# CSG subtraction: max(3, -5) = 3
assert_eq(sdf_subtraction(f64_from(3), f64_from(5)), f64_from(3), "sdf subtraction");

# ================================================================
# CALC — derivatives, integration, bezier, catmull-rom, easing (~25)
# ================================================================
test_group("calc: derivative");

# d/dx(x^2) at x=3, h=1 central diff: (16-4)/2 = 6
var c_deriv_x2 = calc_derivative(&_tc_x2, f64_from(3), F64_ONE);
assert_eq(c_deriv_x2, f64_from(6), "deriv x^2 at 3");

# d/dx(sin) at 0 with small h: should be ~cos(0)=1
var c_deriv_sin = calc_derivative(&_tc_sin, 0, f64_from(1));
# central diff (sin(1) - sin(-1))/2, which is sin(1) exactly in real arithmetic. Each
# f64_sin is within 1 ulp of the correctly rounded value; the sum rounds by at most half an
# ulp of the result and the halving is exact, so the result is within 1 ulp of fl(sin 1)
# (round(1000 d) = 841 accepted 5e-4). Measured: fl(sin 1) itself.
# [measured: scratch probe and Decimal oracle, not reproducible in-tree, 2026-10-11; cycc 6.6.14]
assert(_tc_ulp_gap(c_deriv_sin, 0x3FEAED548F090CEE) <= 1, "deriv sin at 0, h = 1: fl(sin 1) within 1 ulp");

# d/dx(const) = 0
var c_deriv_c = calc_derivative(&_tc_const, F64_ONE, F64_ONE);
assert_eq(c_deriv_c, f64_from(0), "deriv const = 0");

# ----------------------------------------------------------------
test_group("calc: simpson integration");

# EXACT WHERE THE RULE IS EXACT, TIGHT WHERE IT IS NOT.
# The assertions here through 2.7.x quantised the result through f64_to/f64_round
# and so certified almost nothing: round(3I) == 1 accepts I in [1/6, 1/2), i.e.
# a relative error of -1/2 to +1/2 on 1/3; trunc(I) == 7 accepts [7, 8) (+1/7); round(I) == 2 accepts
# [1.5, 2.5) (+/-1/4). No tolerance-based Simpson assertion existed anywhere.
#
# Simpson's rule is EXACT for every polynomial of degree <= 3, and 4th-order
# otherwise: int - S = -(b-a) h^4 f''''(xi) / 180. Each case below runs on a
# dyadic grid -- n = 64 gives h = 2^-6 on [0,1] and h = 2^-5 on [0,2] -- so every
# node i*h, every f(x_i), every weighted term (the weights 4 and 2 are powers of
# two) and every partial sum is an exactly representable dyadic well inside 2^53.
# The ONLY rounding in the whole computation is the closing divide by 3, which is
# correctly rounded. The polynomial answers are therefore bit-exact and are
# asserted as bit patterns; every constant below is the closed-form value, not a
# recorded output.
var c_int_out = alloc(8);

# degree 0: int(7, 0, 1) = 7. T = 7*(2 + 4*32 + 2*31) = 1344, T*h = 21, 21/3 = 7.
var c_rc_t, c_rc_v = calc_integral_simpson(&_tc_const, 0, F64_ONE, 64, c_int_out);
assert_eq(is_ok(c_rc_t), 1, "simpson ok");
assert_eq(load64(c_int_out), 0x401C000000000000, "simpson deg-0: int(7,0,1) is 7.0 bit-exact");

# degree 1: int(x, 0, 2) = 2. T = 192, T*h = 6, 6/3 = 2.
var _cs_t1, _cs_v1 = calc_integral_simpson(&_tc_linear, 0, F64_TWO, 64, c_int_out);
assert_eq(load64(c_int_out), 0x4000000000000000, "simpson deg-1: int(x,0,2) is 2.0 bit-exact");

# degree 2: int(x^2, 0, 1) = 1/3. T = 64 exactly, T*h = 1.0, and 1.0/3.0 is the
# correctly rounded fl(1/3) = 0x3FD5555555555555.
var _cs_t2, _cs_v2 = calc_integral_simpson(&_tc_x2, 0, F64_ONE, 64, c_int_out);
assert_eq(load64(c_int_out), 0x3FD5555555555555, "simpson deg-2: int(x^2,0,1) is fl(1/3) bit-exact");

# degree 3 -- the defining property. int(x^3 - 2x^2 + 3x - 4, 0, 2)
#           = 4 - 16/3 + 6 - 8 = -10/3. T = -320, T*h = -10, fl(-10/3).
var _cs_t3, _cs_v3 = calc_integral_simpson(&_tc_cubic, 0, F64_TWO, 64, c_int_out);
assert_eq(load64(c_int_out), 0xC00AAAAAAAAAAAAB, "simpson deg-3: int(cubic,0,2) is fl(-10/3) bit-exact");

# degree 4 -- where the rule stops being exact, and by exactly how much. f'''' is
# constant for a quartic, so Euler-Maclaurin is an identity, not an estimate:
#   S_n = int + (b-a) h^4 f''''/180 = 1/5 + 24 h^4/180 = 1/5 + 2 h^4/15.
# h = 2^-6 gives 2/(15*2^24) = 7.947285970052083e-09, so the rule must return
# 0.20000000794728598 = 0x3FC99999AAAAAAAB -- provably NOT 0.2.
var _cs_t4, _cs_v4 = calc_integral_simpson(&_tc_x4, 0, F64_ONE, 64, c_int_out);
assert_eq(load64(c_int_out), 0x3FC99999AAAAAAAB, "simpson deg-4: int(x^4,0,1) is fl(1/5 + 2h^4/15)");
var c_q_dev = f64_sub(load64(c_int_out), 0x3FC999999999999A);   # minus fl(0.2)
assert(f64_gt(c_q_dev, 0x3E410D0FA854A07E) == 1, "simpson deg-4 error term > 7.94e-9");
assert(f64_lt(c_q_dev, 0x3E41128F084CFED7) == 1, "simpson deg-4 error term < 7.95e-9");

# The n=100 shape the old assertions used. h = fl(1/100) is not dyadic, so the
# nodes and node values round -- yet x^2 still lands under one ulp of 1/3.
var _cs_t5, _cs_v5 = calc_integral_simpson(&_tc_x2, 0, F64_ONE, 100, c_int_out);
var c_int_err = f64_abs(f64_sub(load64(c_int_out), 0x3FD5555555555555));
assert(f64_lt(c_int_err, 0x3C9CD2B297D889BC) == 1, "simpson x^2 n=100 within 1e-16 of 1/3 (< 2 ulp)");

# 1000 subintervals. The Neumaier compensation in the accumulator is what holds
# these two to zero error: deleting it costs 2 ulp at n=100 and 3 ulp here, so
# this pair is also the only regression test the compensated sum has.
var _cs_t6, _cs_v6 = calc_integral_simpson(&_tc_x2, 0, F64_ONE, 1000, c_int_out);
var c_int_err_k = f64_abs(f64_sub(load64(c_int_out), 0x3FD5555555555555));
assert(f64_lt(c_int_err_k, 0x3C9CD2B297D889BC) == 1, "simpson x^2 n=1000 within 1e-16 of 1/3");

# NON-POLYNOMIAL, so the rule is genuinely inexact: int(1/(1+x), 0, 1) = ln 2.
# 1/(1+x) on a dyadic grid is one correctly rounded IEEE divide, so the rule's
# value is computable in exact rational arithmetic independently of this library:
# S_64 = 0.6931471824214548 (0x3FE62E42FFFA11FA), S_32 = 0.693147210289823.
var c_ln2_64 = alloc(8);
var _cs_t7, _cs_v7 = calc_integral_simpson(&_tc_inv1p, 0, F64_ONE, 64, c_ln2_64);
var c_s64_err = f64_abs(f64_sub(load64(c_ln2_64), 0x3FE62E42FFFA11FA));
assert(f64_lt(c_s64_err, 0x3CD203AF9EE75616) == 1, "simpson 1/(1+x) n=64 hits exact rule value to 1e-15");

# 4th-order convergence: halving h must cut the error by 16. The exact-rational
# prediction is e(32)/e(64) = 15.9708437; the trapezoid rule would give ~4, and a
# mis-weighted Simpson gives O(1). e(64) itself is pinned to the h^4 term,
# (h^4/180)*(f'''(1) - f'''(0)) = 0.03125*h^4 = 2^-29 = 1.862645149230957e-09.
var c_ln2_32 = alloc(8);
var _cs_t8, _cs_v8 = calc_integral_simpson(&_tc_inv1p, 0, F64_ONE, 32, c_ln2_32);
var c_e64 = f64_abs(f64_sub(load64(c_ln2_64), 0x3FE62E42FEFA39EF));   # fl(ln 2)
var c_e32 = f64_abs(f64_sub(load64(c_ln2_32), 0x3FE62E42FEFA39EF));
assert(f64_gt(c_e64, 0x3E1EEC7BD512B572) == 1, "simpson n=64 error > 1.8e-9 (h^4 term is real)");
assert(f64_lt(c_e64, 0x3E20C01868BF779E) == 1, "simpson n=64 error < 1.95e-9");
var c_ratio = f64_div(c_e32, c_e64);
assert(f64_gt(c_ratio, 0x402FCCCCCCCCCCCD) == 1, "simpson 4th order: e(32)/e(64) > 15.9");
assert(f64_lt(c_ratio, 0x40300CCCCCCCCCCD) == 1, "simpson 4th order: e(32)/e(64) < 16.05");

# a != 0 -- THE GAP ADVERSARIAL REVIEW FOUND. Every case above starts at a = 0,
# so two independent a-drop mutants survived the whole block:
#   h  = (b - a)/n  ->  b/n          (step size ignores the lower limit)
#   xi = a + i*h    ->  i*h          (nodes ignore the lower limit)
# Both are silent when a == 0. On [1,3] with n = 64 the step is 2^-5, still
# dyadic, so these stay bit-exact: int(x^2,1,3) = 26/3 and int(x^3,1,3) = 20.
# Under the xi a-drop the first becomes int(x^2,0,2) = 8/3 -- off by 3x.
var _cs_t9, _cs_v9 = calc_integral_simpson(&_tc_x2, F64_ONE, f64_from(3), 64, c_int_out);
assert_eq(load64(c_int_out), 0x4021555555555555, "simpson a!=0 deg-2: int(x^2,1,3) is fl(26/3)");
var _cs_t10, _cs_v10 = calc_integral_simpson(&_tc_cubic_pure, F64_ONE, f64_from(3), 64, c_int_out);
assert_eq(load64(c_int_out), 0x4034000000000000, "simpson a!=0 deg-3: int(x^3,1,3) is 20.0 bit-exact");

# ----------------------------------------------------------------
test_group("calc: gauss-legendre");

# Gauss5 on x^2 from 0 to 1 = 1/3, and on const 7 = 7. ⭐ 3.3.5 — these compared
# round(3 I) with 1 and round(I) with 7. Gauss5 is exact for degree <= 9, so only rounding
# separates them from the truth: the first-order bound over the nodes, f, the weighted
# products and the four additions is 4.0 ulp of 1/3 and 3.4 ulp of 7 (the five weights sum
# to exactly 2). Measured: 1 ulp below fl(1/3), and 0x401BFFFFFFFFFFFF, 1 ulp below 7.
# [measured: scratch bound script, probe and Decimal oracle, not reproducible in-tree, 2026-10-11; cycc 6.6.14]
var c_gl = calc_integral_gauss5(&_tc_x2, 0, F64_ONE);
assert(_tc_ulp_gap(c_gl, 0x3FD5555555555555) <= 4, "gauss5 x^2 = 1/3 within 4 ulp");

var c_gl_c = calc_integral_gauss5(&_tc_const, 0, F64_ONE);
assert(_tc_ulp_gap(c_gl_c, 0x401C000000000000) <= 3, "gauss5 const = 7 within 3 ulp");

# TOLERANCE, not rounding. Before 3.3.5 the two assertions above compared f64_round(...) to
# an integer, which permits +/-0.5 absolute -- 7.1% relative on the const-7 case. All
# nine Gauss-Legendre node/weight constants were mis-transcribed through 2.6.11
# (weights summed to 2.000492 instead of 2) and both assertions stayed green.
# 5-point Gauss-Legendre is EXACT for polynomials of degree <= 9, so demand it.
# [measured: CHANGELOG.md 2.6.12 for the constants; the band is the old round's half-unit over 7]
var c_gl_err = f64_abs(f64_sub(c_gl, f64_div(F64_ONE, f64_from(3))));
assert(f64_lt(c_gl_err, f64_div(F64_ONE, f64_from(100000000000))) == 1,
  "gauss5: x^2 exact to 1e-11 (degree 2 << 9)");
var c_gl_c_err = f64_abs(f64_sub(c_gl_c, f64_from(7)));
assert(f64_lt(c_gl_c_err, f64_div(F64_ONE, f64_from(100000000000))) == 1,
  "gauss5: const 7 exact to 1e-11");
# The weights must sum to 2 (integral of 1 over [-1,1]); on [0,1] that is 1.
var c_gl_one = calc_integral_gauss5(&_tc_one, 0, F64_ONE);
assert_eq(c_gl_one, F64_ONE, "gauss5: weights sum correctly (integral of 1 over [0,1] = 1, bit-exact)");

# ----------------------------------------------------------------
test_group("calc: bezier");

# Quadratic bezier endpoints: B(0)=p0, B(1)=p2
var c_bz_p0 = hvec2_new(0, 0);
var c_bz_p1 = hvec2_new(F64_ONE, F64_TWO);
var c_bz_p2 = hvec2_new(F64_TWO, 0);

var c_bz0 = calc_bezier_quad_2d(c_bz_p0, c_bz_p1, c_bz_p2, 0);
assert_eq(HVec2_x(c_bz0), f64_from(0), "bezier t=0 x");
assert_eq(HVec2_y(c_bz0), f64_from(0), "bezier t=0 y");

var c_bz1 = calc_bezier_quad_2d(c_bz_p0, c_bz_p1, c_bz_p2, F64_ONE);
assert_eq(HVec2_x(c_bz1), f64_from(2), "bezier t=1 x");
assert_eq(HVec2_y(c_bz1), f64_from(0), "bezier t=1 y");

# Straight line bezier: all points on x-axis
var c_bz_s0 = hvec2_new(0, 0);
var c_bz_s1 = hvec2_new(F64_ONE, 0);
var c_bz_s2 = hvec2_new(F64_TWO, 0);
var c_bz_mid = calc_bezier_quad_2d(c_bz_s0, c_bz_s1, c_bz_s2, F64_HALF);
assert_eq(HVec2_x(c_bz_mid), f64_from(1), "bezier straight mid x");
assert_eq(HVec2_y(c_bz_mid), f64_from(0), "bezier straight mid y");

# ----------------------------------------------------------------
test_group("calc: catmull-rom");

# Catmull-Rom passes through p1 at t=0 and p2 at t=1
var c_cr_p0 = hvec3_new(0, 0, 0);
var c_cr_p1 = hvec3_new(F64_ONE, F64_ONE, 0);
var c_cr_p2 = hvec3_new(F64_TWO, F64_TWO, 0);
var c_cr_p3 = hvec3_new(f64_from(3), f64_from(3), 0);

var c_cr_0 = calc_catmull_rom(c_cr_p0, c_cr_p1, c_cr_p2, c_cr_p3, 0);
assert_eq(HVec3_x(c_cr_0), f64_from(1), "catmull t=0 x");
assert_eq(HVec3_y(c_cr_0), f64_from(1), "catmull t=0 y");

var c_cr_1 = calc_catmull_rom(c_cr_p0, c_cr_p1, c_cr_p2, c_cr_p3, F64_ONE);
assert_eq(HVec3_x(c_cr_1), f64_from(2), "catmull t=1 x");
assert_eq(HVec3_y(c_cr_1), f64_from(2), "catmull t=1 y");

# The four assertions above were the WHOLE of this function's coverage through
# 2.8.2, and they are the weakest fixture available for it: at t = 0 the t, t^2
# and t^3 terms all vanish; at t = 1 the four coefficients telescope to 2*p2;
# and on collinear EQUALLY-SPACED points coeff2 = 2a - 5b + 4c - d and
# coeff3 = -a + 3b - 3c + d are both identically zero. Deleting term2 and term3
# from _cmr_comp kept the suite green.
#
# Non-collinear, non-uniform control points, evaluated where the cubic terms
# carry real weight. The reference is the closed form, NOT the implementation:
#   q(1/2) = (-p0 + 9 p1 + 9 p2 - p3) / 16        (Catmull-Rom midpoint identity)
#   q(1/4) = (-9 p0 + 111 p1 + 29 p2 - 3 p3) / 128
# Both come out exact dyadic rationals for these coordinates, and replaying
# _cmr_comp's own operation order in IEEE-754 reproduces them bit-for-bit
# (python3: 7/4, 87/64, 11/8, 59/32, -1/8, -3/32), so these are EXACT equalities
# rather than tolerance bands.
var c_cr_q0 = hvec3_new(0, 0, F64_ONE);
var c_cr_q1 = hvec3_new(F64_ONE, F64_TWO, 0);
var c_cr_q2 = hvec3_new(f64_from(3), F64_ONE, 0);
var c_cr_q3 = hvec3_new(f64_from(8), f64_from(5), F64_ONE);

var c_cr_h = calc_catmull_rom(c_cr_q0, c_cr_q1, c_cr_q2, c_cr_q3, F64_HALF);
assert_eq(HVec3_x(c_cr_h), f64_div(f64_from(7), f64_from(4)),
  "catmull t=1/2 x = 7/4 exactly");
assert_eq(HVec3_y(c_cr_h), f64_div(f64_from(11), f64_from(8)),
  "catmull t=1/2 y = 11/8 exactly");
assert_eq(HVec3_z(c_cr_h), f64_neg(f64_div(F64_ONE, f64_from(8))),
  "catmull t=1/2 z = -1/8 exactly");

var c_cr_q = calc_catmull_rom(c_cr_q0, c_cr_q1, c_cr_q2, c_cr_q3,
  f64_div(F64_ONE, f64_from(4)));
assert_eq(HVec3_x(c_cr_q), f64_div(f64_from(87), f64_from(64)),
  "catmull t=1/4 x = 87/64 exactly");
assert_eq(HVec3_y(c_cr_q), f64_div(f64_from(59), f64_from(32)),
  "catmull t=1/4 y = 59/32 exactly");
assert_eq(HVec3_z(c_cr_q), f64_neg(f64_div(f64_from(3), f64_from(32))),
  "catmull t=1/4 z = -3/32 exactly");

# Endpoint interpolation on the non-collinear fixture too -- that is the
# property which makes this a Catmull-Rom spline rather than a Bezier.
assert_eq(HVec3_y(calc_catmull_rom(c_cr_q0, c_cr_q1, c_cr_q2, c_cr_q3, 0)), F64_TWO,
  "catmull t=0 interpolates p1 exactly (non-collinear)");
assert_eq(HVec3_x(calc_catmull_rom(c_cr_q0, c_cr_q1, c_cr_q2, c_cr_q3, F64_ONE)),
  f64_from(3), "catmull t=1 interpolates p2 exactly (non-collinear)");

