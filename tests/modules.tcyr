    0xBFE42AC23E8664E4, 0x3FFCE3224AEC4438, 0xBFD543F8C1B93750, 0x4004E87D58CE0D94, 0x40022F837631702E,
    0xC003527B3FC8E0CE, 0xC0017936F307DBEE, 0xFFF0000000000000), 2,
  "... the Gram answer");
# A thin triangle (the bench's, 2^-30 from colinear) keeps the thin path's bits.
assert_eq(_gg5_code(0xBFF8E63C56F0CADE, 0x3F99AD93BE52CB00, 0x3FFB2006F7ED88CC, 0xBFF601721EAFF1ED,
    0x3FE25A127B748390, 0x3FF767027716145F, 0xBFF4EE7AB81583D0, 0x3FE8DDA73CB5198F, 0x3FF60544BFDD572D,
    0xBFF42FD5F624E10A, 0x3FED61D816F65022, 0x3FF51001FF7D25CA), 0,
  "a thin triangle: the thin path");
assert_eq(HVec3_x(_gg3_bc(0xBFF8E63C56F0CADE, 0x3F99AD93BE52CB00, 0x3FFB2006F7ED88CC, 0xBFF601721EAFF1ED,
      0x3FE25A127B748390, 0x3FF767027716145F, 0xBFF4EE7AB81583D0, 0x3FE8DDA73CB5198F, 0x3FF60544BFDD572D,
      0xBFF42FD5F624E10A, 0x3FED61D816F65022, 0x3FF51001FF7D25CA)), 0xBFE41CEEC070C25C,
  "... its u, unchanged");

# === 3.4.1 GEO5: geo_ray_plane's small path sums in doubles where a bound certifies them (GF3-3) ===
test_group("3.4.1 GEO5: geo_ray_plane's small path, the certified double sums give the integer sums' bits");
# Each expected t is the first 3.4.1 tree's (the integer sums', bit for bit) and the exact t's rounding
# (Fraction oracle). _gg5_pair checks _geo_plane_dot_fast against the integer sum it replaces: the sign
# when both give the same rounded pair, -2 when the fast path declines, -3 / -4 when they differ.
# [measured: GEO5 3.4.1 psw5.py fixtures, the first 3.4.1 tree's bits, Fraction oracle, 2026-11-01]
fn _gg5_pair(a, b, c0, neg) {
    var f: i64[2];
    var x: i64[2];
    var sf = _geo_plane_dot_fast(a, b, c0, neg, &f);
    if (sf == 0 - 2) { return 0 - 2; }
    var rr: i64[33];
    var acc: i64[208];
    _geo_xi_vec(a, &rr);
    _geo_xi_vec(b, &rr + 72);
    _geo_xi_init(&acc);
    if (c0 != 0) {
        store64(&rr + 144, 0x0010_0000_0000_0000);
        store64(&rr + 152, 0 - 52);
        store64(&rr + 160, 0);
        var e = (c0 >> 52) & 0x7FF;
        var m = c0 & 0x000F_FFFF_FFFF_FFFF;
        if (e == 0) { e = 1; } else { m = m | 0x0010_0000_0000_0000; }
        store64(&rr + 168, m);
        store64(&rr + 176, e - 1075);
        store64(&rr + 184, c0 >> 63);
        _geo_xi_add2(&acc, &rr + 168, &rr + 144, 0);
    }
    for (var i = 0; i < 3; i = i + 1) { _geo_xi_add2(&acc, &rr + i * 24, &rr + 72 + i * 24, neg); }
    var sx = _geo_xi_val(&acc, 0, &x);
    if (sx != sf) { return 0 - 3; }
    if (load64(&f) != load64(&x) || load64(&f + 8) != load64(&x + 8)) { return 0 - 4; }
    return sf;
}
fn _gg5_rp(ox, oy, oz, dx, dy, dz, nx, ny, nz, d0) {
    var r = alloc(sizeof(GeoRay));
    GeoRay_set_origin(r, hvec3_new(ox, oy, oz));
    GeoRay_set_direction(r, hvec3_new(dx, dy, dz));
    var pl = alloc(sizeof(GeoPlane));
    GeoPlane_set_normal(pl, hvec3_new(nx, ny, nz));
    GeoPlane_set_distance(pl, d0);
    return geo_ray_plane(r, pl);
}
# One tiny product beside two pairs with a zero factor (the bench row): both sums certified.
assert_eq(_gg5_rp(0, 0, 0x8173C0CA428C59FB, F64_ONE, 0, 0x00001E06522C8B91, 0, 0, F64_ONE, 0), 0x41C50D793FFAFE38,
  "one tiny product: t");
assert_eq(_gg5_pair(hvec3_new(0, 0, F64_ONE), hvec3_new(F64_ONE, 0, 0x00001E06522C8B91), 0, 0), 1,
  "... n . d certified, the integer sum's pair");
assert_eq(_gg5_pair(hvec3_new(0, 0, F64_ONE), hvec3_new(0, 0, 0x8173C0CA428C59FB), 0, 1), 1,
  "... d0 - n . o certified, the integer sum's pair");
# n and d at 2^-400..2^-650, no cancellation, d0 tiny: three products and d0 in both sums.
assert_eq(_gg5_rp(0xBFA778AAE8DA56CA, 0xBC435C823B33AD12, 0x3DCA24E3CD66ED6A, 0x209ED48D09588B4F, 0x9880FDBA2044D6AA,
    0x9D9C3C4B8A31847E, 0x9CCC3123F91A74B0, 0x1DB3087BBE5E7B8A, 0x1EF2C2869BAE3091, 0x8292E67A84D0DF96),
  0x5F42D12F23764E0B, "three tiny products: t");
assert_eq(_gg5_pair(hvec3_new(0x9CCC3123F91A74B0, 0x1DB3087BBE5E7B8A, 0x1EF2C2869BAE3091),
    hvec3_new(0x209ED48D09588B4F, 0x9880FDBA2044D6AA, 0x9D9C3C4B8A31847E), 0, 0), 0 - 1,
  "... n . d certified (negative), the integer sum's pair");
assert_eq(_gg5_pair(hvec3_new(0x9CCC3123F91A74B0, 0x1DB3087BBE5E7B8A, 0x1EF2C2869BAE3091),
    hvec3_new(0xBFA778AAE8DA56CA, 0xBC435C823B33AD12, 0x3DCA24E3CD66ED6A), 0x8292E67A84D0DF96, 1), 0 - 1,
  "... d0 - n . o certified (negative), the integer sum's pair");
# n . d = 2^-1200 from products 1 and -1 that cancel exactly (GEO3's row): the integer sum.
assert_eq(_gg5_rp(0, 0, 0x9A70000000000000, F64_ONE, 0xBFF0000000000000, 0x1A70000000000000, F64_ONE, F64_ONE,
    0x1A70000000000000, 0), F64_ONE, "cancelling products: t = 1");
assert_eq(_gg5_pair(hvec3_new(F64_ONE, F64_ONE, 0x1A70000000000000), hvec3_new(F64_ONE, 0xBFF0000000000000,
      0x1A70000000000000), 0, 0), 0 - 2, "... n . d declined");
# The origin at 0: d0 - n . o is d0 itself.
assert_eq(_gg5_rp(0, 0, 0, F64_ONE, 0, 0x00001E06522C8B91, 0, 0, F64_ONE, 0x0178000000000000), 0x41C99435E4CC6C59,
  "origin at 0: t = d0 / (n . d)");
assert_eq(_gg5_pair(hvec3_new(0, 0, F64_ONE), hvec3_new(0, 0, 0), 0x0178000000000000, 1), 1,
  "... d0 - n . o = d0, the integer sum's pair");
assert_eq(_gg5_pair(hvec3_new(0, 0, F64_ONE), hvec3_new(0, 0, 0), 0, 1), 0, "... with d0 = 0: exactly 0");
# A subnormal d0 beside a product: the integer sum.
assert_eq(_gg5_rp(0, 0, 0x81A56E1FC2F8F359, F64_ONE, 0, 0x00001E06522C8B91, 0, 0, F64_ONE, 0x0000000000012345),
  0x41F6D70DA3C881C8, "subnormal d0: t");
assert_eq(_gg5_pair(hvec3_new(0, 0, F64_ONE), hvec3_new(0, 0, 0x81A56E1FC2F8F359), 0x0000000000012345, 1), 0 - 2,
  "... d0 - n . o declined");
# d0 2^1800 above the scaled products: the integer sum (t past DBL_MAX: +Inf).
assert_eq(_gg5_rp(0, 0, 0x07B8000000000000, F64_ONE, 0, 0x00001E06522C8B91, 0, 0, F64_ONE, 0x7834000000000000),
  0x7FF0000000000000, "d0 far above: t = +Inf");
assert_eq(_gg5_pair(hvec3_new(0, 0, F64_ONE), hvec3_new(0, 0, 0x07B8000000000000), 0x7834000000000000, 1), 0 - 2,
  "... d0 - n . o declined");
# The leading products cancel and leave a third 2^-1015 of the scale: below the certified range.
assert_eq(_gg5_rp(0x4000000000000000, 0, 0, F64_ONE, 0xBFF0000000000000, 0x1FC0000000000000, 0x39B0000000000000,
    0x39B0000000000000, 0x1A70000000000000, 0x39C4000000000000), 0x7F50000000000000, "a sum 2^-1015 of its scale: t");
assert_eq(_gg5_pair(hvec3_new(0x39B0000000000000, 0x39B0000000000000, 0x1A70000000000000), hvec3_new(F64_ONE,
      0xBFF0000000000000, 0x1FC0000000000000), 0, 0), 0 - 2, "... n . d declined");
# n . d = 2^-1120 (1 + 2^-53 + 0.875 2^-106): just above a midpoint, which the double sum loses (it
# would round to 2^-1120 and t to 0x4778000000000000); the certificate declines.
assert_eq(_gg5_rp(0, 0, 0, 0x1CF0000000000000, 0x199FFFFFFA000002, 0, 0x1CF0000000000000, 0x1CF0000003000000, 0,
    0x0178000000000000), 0x4777FFFFFFFFFFFF, "a sum just above a midpoint: t");
assert_eq(_gg5_pair(hvec3_new(0x1CF0000000000000, 0x1CF0000003000000, 0), hvec3_new(0x1CF0000000000000,
      0x199FFFFFFA000002, 0), 0, 0), 0 - 2, "... n . d declined by the certificate");

# === 3.4.1 GEO5: geo_barycentric_coords, one triangle per part of the certificate (found by mutation) ===
test_group("3.4.1 GEO5: geo_barycentric_coords, one triangle per part of the certificate");
# Each triangle was found by removing one part of _geo_bary_cert (its mutant answers it differently, and
# for the residual's parts beyond the stated 3.01 / 9.01 2^-53 of the largest weight); the expected
# values are this tree's, within that bound of the exact weights (Fraction oracle).
# [measured: GEO5 3.4.1 mfix.py over fams.py with the mutant drivers, Fraction oracle, 2026-11-01]
# top binade, a subnormal's half rounds: the halved copy is another triangle, so the thin path.
var _gg5_m0 = _gg3_bc(0xBFCBC726ED3A0B68, 0x7FE593E3856ACBF8, 0xFFEC3A3BE278A6C1, 0x3FE8BEDC42FB2404,
  0x7E6069F4C1650C90, 0xFFEC3A3BE278A6C1, 0x8000000000000001, 0xFFEA8D006287D560,
  0xBFFB06014D92E4D5, 0x7FC8A353A8F09EB0, 0xBFF341F60A4BA157, 0xFFEC3A3BE278A6C1);
assert_eq(HVec3_x(_gg5_m0), 0xBE68578E80000000, "B1b fixture: u");
assert_eq(HVec3_y(_gg5_m0), 0x3FF000000C2BC740, "... v");
assert_eq(HVec3_z(_gg5_m0), 0x8001F88E1BD7D172, "... w");
assert_eq(_gg5_code(0xBFCBC726ED3A0B68, 0x7FE593E3856ACBF8, 0xFFEC3A3BE278A6C1, 0x3FE8BEDC42FB2404,
    0x7E6069F4C1650C90, 0xFFEC3A3BE278A6C1, 0x8000000000000001, 0xFFEA8D006287D560,
    0xBFFB06014D92E4D5, 0x7FC8A353A8F09EB0, 0xBFF341F60A4BA157, 0xFFEC3A3BE278A6C1), 0,
  "... path thin");
# just under the thin switch (2^-16 of d00 d11): the thin path, its bits.
var _gg5_m1 = _gg3_bc(0xBFD5D145C7FEB0E0, 0x3FF018EF4EF69C6C, 0x3FF406ACDA7FB1F4, 0x3FFBD5703B420A40,
  0xBFDFA25B17DBEC78, 0x40037D801671E4F8, 0x3FD065D924D0649E, 0x3FE26537BB9B99AB,
  0x3FF96BC1BB9BE700, 0x3FEEA8556C9D646C, 0x3FB1B4B3960A463C, 0x3FFFD8D34665FA63);
assert_eq(HVec3_x(_gg5_m1), 0x3FC5920CADE6578C, "B3 fixture: u");
assert_eq(HVec3_y(_gg5_m1), 0x3FE14F8D944C22C6, "... v");
assert_eq(HVec3_z(_gg5_m1), 0x3FD297DE80748EAE, "... w");
assert_eq(_gg5_code(0xBFD5D145C7FEB0E0, 0x3FF018EF4EF69C6C, 0x3FF406ACDA7FB1F4, 0x3FFBD5703B420A40,
    0xBFDFA25B17DBEC78, 0x40037D801671E4F8, 0x3FD065D924D0649E, 0x3FE26537BB9B99AB,
    0x3FF96BC1BB9BE700, 0x3FEEA8556C9D646C, 0x3FB1B4B3960A463C, 0x3FFFD8D34665FA63), 0,
  "... path thin");
# the halved copy near the plane: the near-plane stage's bits.
var _gg5_m2 = _gg3_bc(0xFFECA2A9799249C6, 0xFFECA2A9799249C6, 0xFFECA2A9799249C6, 0xFFEE5DDC2F4C8A80,
  0xFFECA2A9799249C6, 0xFFECA2A9799249C6, 0, 0xFFD7B8F683D77509,
