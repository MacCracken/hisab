assert_eq(load64(_c37_d), 0x3E112E0BE0000000,
  "gjk_epa_3d: ... at 9.9999997e-10, exact 1.00000006e-9 (lane CO3: 1.00000019e-9; 3.3.6: 1.0016e-9)");
