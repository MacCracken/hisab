  0xBF6B6593AFE581C3, "unit normal, coordinates 2^-760..2^950: x, the exact value's rounding (sticky)");
# geo_jet_sphere at r < 2^-968 with normal coordinates: the scaled copy gives 3.4.0's bits, 1 ulp
# from the exact dt/do.z BFBB68E4443262D4; a translated copy gave ...62C6.
var _gg2_js = geo_jet_sphere(_r40_ray(0x82824496675F1007, 0x824F028F67B43D11, 0x82647C690CA76AD2, 0x4012866FB34E6B1C,
    0x3FE6DCA89E48496F, 0x400243C5E5D3724A), geo_sphere_new(hvec3_new(0x8247D29C0AA9B980, 0x823BDA9738EE5FC0,
      0x02591B97F47BEA6E), 0x024A722B172B3418));
assert_eq(HVec3_z(geo_jet_dorigin(_gg2_js)), 0xBFBB68E4443262D5,
  "geo_jet_sphere: a 2^-990 sphere: dt/do.z (3.4.0's bits)");

# === 3.4.1 GEO3: the thin and colinear barycentric paths and the small plane path sum exactly (G2-F1) ===
test_group("3.4.1 GEO3: geo_barycentric_coords' thin and colinear paths, geo_ray_plane's small path: exact sums");
# Each expected value is this tree's, within 64 * 2^-53 of the largest exact weight (Fraction oracle), and
# +-Inf where the exact weight is past DBL_MAX; "(s7: ...)" is the first 3.4.1 passes' answer, which
# 3.4.0 gave too: their sums took every product to the largest one's power of two and lost the rest.
# [measured: GEO3 3.4.1 gentests.py, fix1.py, fix2.py and the mutant corpora, Fraction oracle, 2026-10-31]
fn _gg3_bc(ax, ay, az, bx, by, bz, cx, cy, cz, px, py, pz) {
    return geo_barycentric_coords(geo_triangle_new(hvec3_new(ax, ay, az), hvec3_new(bx, by, bz), hvec3_new(cx, cy, cz)),
      hvec3_new(px, py, pz));
}
fn _gg3_bt(ax, ay, az, bx, by, bz, cx, cy, cz, px, py, pz) {
    return _geo_bary_thin(hvec3_new(ax, ay, az), hvec3_new(bx, by, bz), hvec3_new(cx, cy, cz), hvec3_new(px, py, pz));
}
# Exactly colinear along y at x = 2^500, extents 2^-500: |g|^2's products cancel at 2^1000 (exact weights
# -0.738, 0.690, 1.048; the third is the exact value's rounding less 1 ulp).
var _gg3_b1 = _gg3_bc(0x5F30000000000000, 0x20B0000000000000, 0, 0x5F30000000000000, 0x20C8000000000000, 0,
  0x5F30000000000000, 0x20CC000000000000, 0, 0x5F30000000000000, 0x20D4000000000000, 0);
assert_eq(HVec3_x(_gg3_b1), 0xBFE79E79E79E79E8, "colinear at x = 2^500: u (s7: NaN)");
assert_eq(HVec3_y(_gg3_b1), 0x3FE6186186186186, "... v");
assert_eq(HVec3_z(_gg3_b1), 0x3FF0C30C30C30C30, "... w");
# The same at x = 1e6 with y extents 1e-300, the point 7 off the line.
var _gg3_b2 = _gg3_bc(0x412E848000000000, 0x01A56E1FC2F8F359, 0, 0x412E848000000000, 0x01C01297D23AB683, 0,
  0x412E848000000000, 0x01B56E1FC2F8F359, 0, 0x412E848000000000, 0x01BAC9A7B3B7302F, 0x401C000000000000);
assert_eq(HVec3_x(_gg3_b2), 0x3FB555555555555E, "colinear at x = 1e6, extents 1e-300: u (s7: NaN)");
assert_eq(HVec3_y(_gg3_b2), 0x3FE2AAAAAAAAAAAA, "... v");
# A sliver: (0, 2^1000, 2^1000) and two vertices 2^-540 apart along the same diagonal, so the cross
# product's 2^463 products cancel and leave 2^-1079; the point t1 + 2 (t2 - t1) has weights (0, -1, 2).
var _gg3_b3 = _gg3_bc(0, 0x7E70000000000000, 0x7E70000000000000, 0, 0x1E48000000000000, 0x1E30000000000000, 0,
  0x1E50000000000000, 0x1E40000000000000, 0, 0x1E54000000000000, 0x1E48000000000000);
assert_eq(HVec3_y(_gg3_b3), 0xBFF0000000000000,
  "sliver, point on the line t1 t2: v = -1 (s7: 0x3FE0000000000000, the colinear answer)");
assert_eq(HVec3_z(_gg3_b3), 0x4000000000000000, "... w = 2");
# Its point (0, 2^999, 2^999): v and w past DBL_MAX with opposite signs, u = 1 from its own cross product.
var _gg3_b4 = _gg3_bc(0, 0x7E70000000000000, 0x7E70000000000000, 0, 0x1E48000000000000, 0x1E30000000000000, 0,
  0x1E50000000000000, 0x1E40000000000000, 0, 0x7E60000000000000, 0x7E60000000000000);
assert_eq(HVec3_x(_gg3_b4), F64_ONE, "sliver, v and w past DBL_MAX: u = 1, not +Inf - Inf (s7: 0x3FDFFFFFFFFFFFFE)");
assert_eq(HVec3_y(_gg3_b4), 0x7FF0000000000000, "... v = +Inf");
assert_eq(HVec3_z(_gg3_b4), 0xFFF0000000000000, "... w = -Inf");
# Weights of 2^1600 and +-2^3300: the quotients' powers of two pass 3069, where _geo_ldexp's exponent ran
# into the sign bit (v read -Inf).
var _gg3_b5 = _gg3_bc(0xFA98000000000000, 0xFA80000000000000, 0xFA98000000000000, 0x905366B74CDD2800,
  0x904D17A544EBC000, 0x903FC56BE9D22000, 0x9065B35BA66E9400, 0x90568BD2A275E000, 0x905FF15AFA748800,
  0x74684A1C658422F8, 0xA93C2B9DE1C4285C, 0x6E153DD8A434C8EA);
assert_eq(HVec3_x(_gg3_b5), 0x7FF0000000000000, "weights 2^1600, +-2^3300: u = +Inf (s7: 0xBC90000000000000)");
assert_eq(HVec3_y(_gg3_b5), 0x7FF0000000000000, "... v = +Inf (not -Inf)");
assert_eq(HVec3_z(_gg3_b5), 0xFFF0000000000000, "... w = -Inf");
# Colinear, vertices 2^-600 either side of t0 and the point 2^1100 edges along: c_0 = 0 keeps 1/3.
var _gg3_b6 = _gg3_bc(0x7830000000000000, 0, 0, 0x7830000000000000, 0x1A70000000000000, 0, 0x7830000000000000,
  0x9A70000000000000, 0, 0x7830000000000000, 0x5F30000000000000, 0);
assert_eq(HVec3_x(_gg3_b6), 0x3FD5555555555555, "colinear, point 2^1100 edges along: u = 1/3 (not Inf * 0)");
assert_eq(HVec3_y(_gg3_b6), 0x7FF0000000000000, "... v = +Inf");
assert_eq(HVec3_z(_gg3_b6), 0xFFF0000000000000, "... w = -Inf");
# Colinear along x (2^-629) at y, z = (-2^-629, -2^-99), the point on t0: P = 0 is not "far along".
var _gg3_b7 = _gg3_bc(0x18A33F2E47C00000, 0x98A009D363000000, 0xB9C08CD5936483D4, 0x98C330346E100000,
  0x98A009D363000000, 0xB9C08CD5936483D4, 0x98D5981A37080000, 0x98A009D363000000, 0xB9C08CD5936483D4,
  0x18A33F2E47C00000, 0x98A009D363000000, 0xB9C08CD5936483D4);
assert_eq(HVec3_x(_gg3_b7), 0x3FEAAAAAAAAAAAAA, "colinear, point on t0: u = 2/3 (s7: 0x7FF0000000000000)");
assert_eq(HVec3_z(_gg3_b7), 0xBFC5555555555556, "... w = -1/6");
# A cross product of 2^-2061 (dot products near 2^-4120): the records' bias keeps every limb in the buffer.
var _gg3_b8 = _gg3_bt(0, 0, 0, 0x0170000000000000, 0, 0, 0x0168000000000000, 0x0000000000004000, 0,
  0x0150000000000000, 0x0000000000001000, 0x4014000000000000);
assert_eq(HVec3_x(_gg3_b8), 0x3FE6000000000000, "_geo_bary_thin, n = 2^-2061: u = 0.6875");
assert_eq(HVec3_y(_gg3_b8), 0x3FB0000000000000, "... v = 0.0625");
# A sliver from the sweep: t0 at 5e234, t1 and t2 near 1e-96, the point at 1e151: u = -2.4e247,
# v and w past DBL_MAX.
var _gg3_b9 = _gg3_bc(0x70A8000000000000, 0xF090000000000000, 0x7090000000000000, 0x2BF2C6842D506000,
  0x2BC1D5CADF96C000, 0xABC3CD55BB640000, 0x2C05634216A83000, 0xABD7151A9034A000, 0x2BD61955224E0000,
  0x454AE62748CB78F8, 0x35513C7CAAE2F338, 0xDF4C8797CDC83AFE);
assert_eq(HVec3_x(_gg3_b9), 0xF34AF631B5CC9015, "sliver at 5e234 / 1e-96: u = -2.4e247 (s7: 0xBC90000000000000)");
# A thin triangle near 1e-232 whose four points share x = -1.4e-244: (1.741, -0.741, 2.7e-14).
var _gg3_b10 = _gg3_bc(0x8D4E46B74A954BF3, 0x0FB0BCF509BE12DE, 0x8FB7D1A8CA445DB2, 0x8D4E46B74A954BF3,
  0x8FBA1D101AB05188, 0x8FBC43401C8FBF10, 0x8D4E46B74A954BF3, 0x0FD40EAE9C6EA6A5, 0x8FB12EBA11A741FE,
  0x8D4E46B74A954BF3, 0x0FC840B41C0C476D, 0x8FB486530326D7A3);
assert_eq(HVec3_x(_gg3_b10), 0x3FFBDC812425F39F, "thin near 1e-232: u");
assert_eq(HVec3_z(_gg3_b10), 0x3D1E22336B5B594C, "... w = 2.7e-14");
# Colinear at x = 4.8e-166, extents 1e-98, the point 1e188 along: weights near 1e285, P/B at the
# threshold of the route at P's own power of two.
var _gg3_b11 = _gg3_bc(0x1D9C43926AC27066, 0xAB7264D1EA000000, 0x2B7854AAFB000000, 0x1D9C43926AC27066,
  0xAB9C99347A800000, 0x2B9E152ABEC00000, 0x1D9C43926AC27066, 0xAB43268F50000000, 0x2B60A955F6000000,
  0x547333186A30A2C8, 0xE6EECC097F3695C8, 0xDC3CDB4B4B3A4CD8);
assert_eq(HVec3_x(_gg3_b11), 0xFB1CA5FCED685BB4, "colinear, the point 1e188 along: u = -1.07e285");
assert_eq(HVec3_z(_gg3_b11), 0xFB26EB30BDED162A, "... w");
# Colinear at x = 2.5e198, extents 1e-279, the point 1e142 along: u = 1/3 exactly, v and w past DBL_MAX.
var _gg3_b12 = _gg3_bc(0x6920F0B1629DCB88, 0x85D839BA5F000000, 0x85D354B18F800000, 0x6920F0B1629DCB88,
  0x85FE0E6E97C00000, 0x05FF2AD39C200000, 0x6920F0B1629DCB88, 0x05F1F19168400000, 0x86046A9631F00000,
  0x0EA010D2BA7AA86D, 0x2BD4BAA8FD55FC30, 0xDD798C2CF8E143B0);
assert_eq(HVec3_x(_gg3_b12), 0x3FD5555555555555, "colinear, the point 1e142 along: u = 1/3");
assert_eq(HVec3_y(_gg3_b12), 0xFFF0000000000000, "... v = -Inf");
# Colinear in y at x = -2.6e-266, z = -1.3e-279, the point on t0: P = 0.
var _gg3_b13 = _gg3_bc(0x88CAF0BE45800000, 0x88C5B48D5E400000, 0x860825FEB10A1F98, 0x88CAF0BE45800000,
  0x08E292DCA8700000, 0x860825FEB10A1F98, 0x88CAF0BE45800000, 0x88D2DA46AF200000, 0x860825FEB10A1F98,
  0x88CAF0BE45800000, 0x88C5B48D5E400000, 0x860825FEB10A1F98);
assert_eq(HVec3_x(_gg3_b13), 0x3FDB88EE23B88EE2, "colinear at 1e-266, the point on t0: u");
assert_eq(HVec3_y(_gg3_b13), 0x3FB4D653594D6534, "... v");
# A sliver at 1e-181 below a vertex at 7.7e294: all three weights past DBL_MAX.
var _gg3_b14 = _gg3_bc(0x7D28000000000000, 0x7D10000000000000, 0, 0x1A6ED1D2D9480000, 0x1A6B83EAF4861000,
  0x9A7A9F8AE6FB6000, 0x1A83B474B6520000, 0x1A75C1F57A430800, 0x9A7A9F8AE6FB6000, 0x3E84B038DA1B5929,
  0xC3595BA38E2E4E4B, 0x7A3D2137EF95FB73);
assert_eq(HVec3_x(_gg3_b14), 0x7FF0000000000000, "sliver at 1e-181 / 7.7e294: u = +Inf (s7: 0xBCA0000000000000)");
assert_eq(HVec3_y(_gg3_b14), 0x7FF0000000000000, "... v = +Inf");
# geo_ray_plane below DBL_MIN: n = (1, 1, 2^-600), d = (1, -1, 2^-600), so n . d's products 1 and -1 cancel
# and leave 2^-1200, the whole of it.
assert_eq(geo_ray_plane(_r40_ray(0, 0, 0x9A70000000000000, F64_ONE, 0xBFF0000000000000, 0x1A70000000000000),
    _g41_pl(F64_ONE, F64_ONE, 0x1A70000000000000, 0)), F64_ONE,
  "n . d = 2^-1200 from cancelling products: t = 1 (s7: 0)");
assert_eq(geo_ray_plane(_r40_ray(0x4014000000000000, 0xC014000000000000, 0x9A88000000000000, F64_ONE,
      0xBFF0000000000000, 0x1A70000000000000),
    _g41_pl(F64_ONE, F64_ONE, 0x1A70000000000000, 0)), 0x4008000000000000,
  "... n . o cancelling too: t = 3");
assert_eq(geo_ray_plane(_r40_ray(0x4014000000000000, 0xC014000000000000, 0, F64_ONE, 0xBFF0000000000000,
      0x1A70000000000000),
    _g41_pl(F64_ONE, F64_ONE, 0x1A70000000000000, 0x0000000000000007)), 0x47FC000000000000,
  "... d0 = 7 2^-1074 the whole numerator: t = 7 2^126");
assert_eq(geo_ray_plane(_r40_ray(0x4014000000000000, 0xC014000000000000, 0x9A70000000000000, F64_ONE,
      0xBFF0000000000000, 0x1A70000000000000),
    _g41_pl(F64_ONE, F64_ONE, 0x1A70000000000000, 0x8000000000000001)), 0,
  "... d0 = -2^-1074 below n . o: the miss");
# A subnormal origin, d ~ 2^-150 and the plane's normal 2^-1000 off unit: every product kept.
assert_eq(geo_ray_plane(_r40_ray(0x0862663224CD913C, 0x9BDE2EF7978E82B8, 0x3496774425BFD360, 0xD0483D183E9DBDA0,
      0xD08FE160819095D2, 0x83D91C88AA39994A),
    _g41_pl(0x243FE160819095D2, 0xA3F83D183E9DBDA0, 0xB6C74C43754BB98A, 0xA99CD301FA1150C0)), 0x70ACA0F1FC44C8F3,
  "small plane path, mixed scales: t (s7: 0x70ACA0F1FC44C8F3)");

# === 3.4.1 GEO3: geo_triangle_unit_normal's certified fast path gives the exact path's bits (G2-F3) ===
test_group("3.4.1 GEO3: geo_triangle_unit_normal, the certified double path and the exact one agree bit for bit");
# Each expected value is the exact path's (the first 3.4.1 passes', bit for bit) and within 8 * 2^-53 of
# the exact edges' unit normal (Fraction oracle). Each triangle was built or found to make one part of the
# fast path's certificate decide: without that part the fast path answers it, wrongly.
# [measured: GEO3 3.4.1 gentests.py, f23build.py and the mutant corpora, Fraction oracle, 2026-10-31]
fn _gg3_un(ax, ay, az, bx, by, bz, cx, cy, cz) {
    return geo_triangle_unit_normal(geo_triangle_new(hvec3_new(ax, ay, az), hvec3_new(bx, by, bz),
        hvec3_new(cx, cy, cz)));
}
fn _gg3_fast(ax, ay, az, bx, by, bz, cx, cy, cz) {
    var w: i64[3];
    return _geo_unit_normal_fast(hvec3_new(ax, ay, az), hvec3_new(bx, by, bz), hvec3_new(cx, cy, cz), &w);
}
# x = (A + a) B: A B even near 2^53 and a B = 1 + 2^-79 (a = RN(1/B), the y edge's rounding error), so
# s + T~ is exactly the midpoint A B + 1 and the true x lies 2^-79 above it: only the z + Eb side of the
# certificate sees that it rounds up.
var _gg3_n15 = _gg3_un(0, 0xBE4FFFFFF8000002, 0, 0, 0x41A0000008000000, 0x419800001C000000, F64_ONE,
  0xBE4FFFFFF8000002, 0x4190000004000000);
assert_eq(HVec3_x(_gg3_n15), 0x3FEFFFFFFFFFFFFE, "x on a midpoint, the true value above: x (exact path)");
assert_eq(HVec3_y(_gg3_n15), 0x3E48000009FFFFF3, "... y");
assert_eq(_gg3_fast(0, 0xBE4FFFFFF8000002, 0, 0, 0x41A0000008000000, 0x419800001C000000, F64_ONE, 0xBE4FFFFFF8000002,
    0x4190000004000000), 0 - 1,
  "... the fast path: declined");
# The mirror: the true x below the midpoint, which rounds to the even value above it; the z - Eb side.
var _gg3_n16 = _gg3_un(0, 0xBE4FFFF7F8020401, 0, 0, 0x41A0000004000000, 0x419800001C000000, F64_ONE,
  0xBE4FFFF7F8020401, 0x4190000404000000);
assert_eq(HVec3_x(_gg3_n16), 0x3FEFFFFFFFFFFFFE, "x on a midpoint, the true value below: x (exact path)");
assert_eq(HVec3_y(_gg3_n16), 0x3E47FFFA10017D75, "... y");
assert_eq(_gg3_fast(0, 0xBE4FFFF7F8020401, 0, 0, 0x41A0000004000000, 0x419800001C000000, F64_ONE, 0xBE4FFFF7F8020401,
    0x4190000404000000), 0 - 1,
  "... the fast path: declined");
# An edge component of 2^-700 (below the fast range): x's product 2^-1100 underflows to 0 in doubles, so
# the fast path must not see it; the exact z is -2^-1100, whose share of the unit normal is -0.
var _gg3_n17 = _gg3_un(0, 0, 0, F64_ONE, 0x1430000000000000, 0, 0x26F0000000000000, 0, F64_ONE);
assert_eq(HVec3_z(_gg3_n17), 0x8000000000000000, "an edge component of 2^-700: z = -0 (exact path)");
assert_eq(HVec3_x(_gg3_n17), 0x1430000000000000, "... x");
assert_eq(_gg3_fast(0, 0, 0, F64_ONE, 0x1430000000000000, 0, 0x26F0000000000000, 0, F64_ONE), 0 - 1,
  "... the fast path: declined");
# In the plane x = 0, nearly colinear: x = 2^-60 comes only from the y edge's rounding error 2^-60 (both
# products are 1, nothing else rounded): every rounded part must keep the fast path from claiming x = 0.
var _gg3_n18 = _gg3_un(0, 0x3C30000000000000, 0, 0, 0x3F70000000000001, F64_ONE, 0, F64_ONE, 0x4070000000000000);
assert_eq(HVec3_x(_gg3_n18), F64_ONE, "x from an edge's rounding error alone: (1, 0, 0)");
assert_eq(HVec3_y(_gg3_n18), 0, "... y = 0");
assert_eq(_gg3_fast(0, 0x3C30000000000000, 0, 0, 0x3F70000000000001, F64_ONE, 0, F64_ONE, 0x4070000000000000), 0 - 1,
  "... the fast path: declined");
# x = B D is 2^-1040 of z = A C: subnormal after the largest is taken into [1, 2), so the fast path's
# power of two must be the exact path's.
var _gg3_n19 = _gg3_un(0, 0, 0, 0x58F9F767C482C9B0, 0x39BCB91CE3618240, 0, 0, 0x58EBDE5C08B791F7, 0x373F1446BFAEDA86);
assert_eq(HVec3_x(_gg3_n19), 0x00000009DE690C7F, "x 2^-1040 of z: x (subnormal, exact path)");
assert_eq(HVec3_y(_gg3_n19), 0x9E41D7E1A25A2B5A, "... y");
assert_eq(_gg3_fast(0, 0, 0, 0x58F9F767C482C9B0, 0x39BCB91CE3618240, 0, 0, 0x58EBDE5C08B791F7, 0x373F1446BFAEDA86), 1,
  "... the fast path: certified");
# Coordinates 2^-260..2^326: a rounding error of T~ near 2^-112 max(|P|, |Q|), inside the 2^-99 bound.
var _gg3_n20 = _gg3_un(0xC3B98DBCB0028CE8, 0x4D63B42A424AB0C4, 0xBD4EABC574C809DC, 0x4B627A2B4A287EF8,
  0x2FFFB6ABD5735E90, 0x39F81964DDF1A546, 0xD452D560113E1D08, 0, 0xAFB54BF488D90B98);
assert_eq(HVec3_x(_gg3_n20), 0x25947935A254120A, "mixed scales, T~ off by 2^-112 max: x (exact path)");
assert_eq(_gg3_fast(0xC3B98DBCB0028CE8, 0x4D63B42A424AB0C4, 0xBD4EABC574C809DC, 0x4B627A2B4A287EF8,
    0x2FFFB6ABD5735E90, 0x39F81964DDF1A546, 0xD452D560113E1D08, 0, 0xAFB54BF488D90B98), 0 - 1,
  "... the fast path: declined");
# Near-colinear at 1e46: each product's Dekker error and an edge's rounding error count.
var _gg3_n21 = _gg3_un(0xC9AA7CA31833BA2A, 0x49AA0C40B529E9F4, 0x49A5D9C447349936, 0xC9A2FBDB65B601D6,
  0xC993AD77F2D2F4EC, 0x498D28CE909FEA80, 0xC9A3581A0A844E98, 0xC9903B10D2F098FD, 0x498FF4DDC0ECD1C9);
assert_eq(HVec3_x(_gg3_n21), 0x3FE7BDEB7F5DDE6D, "near-colinear at 1e46: x");
assert_eq(HVec3_z(_gg3_n21), 0xBFE1B07B32CD08CB, "... z");
assert_eq(_gg3_fast(0xC9AA7CA31833BA2A, 0x49AA0C40B529E9F4, 0x49A5D9C447349936, 0xC9A2FBDB65B601D6,
    0xC993AD77F2D2F4EC, 0x498D28CE909FEA80, 0xC9A3581A0A844E98, 0xC9903B10D2F098FD, 0x498FF4DDC0ECD1C9), 0 - 1,
  "... the fast path: declined");
# Coordinates 1e-91..1e103 with zeros: the difference's own rounding (Fast2Sum, |Q| > |P|).
var _gg3_n22 = _gg3_un(0xC36A42792B293240, 0xAD95CD714E1B4732, 0xD348779FFA029662, 0xC8DEFF20E607B7E0, 0,
  0x2D2886F883AEAF9C, 0x51C25CD75487B18C, 0, 0x557D4C79A9B94818);
assert_eq(HVec3_x(_gg3_n22), 0x1DF6BFA1A0AA19C3, "mixed scales, |Q| > |P|: x");
assert_eq(HVec3_z(_gg3_n22), 0x9A3C83CB84D819B1, "... z");
assert_eq(_gg3_fast(0xC36A42792B293240, 0xAD95CD714E1B4732, 0xD348779FFA029662, 0xC8DEFF20E607B7E0, 0,
    0x2D2886F883AEAF9C, 0x51C25CD75487B18C, 0, 0x557D4C79A9B94818), 1,
  "... the fast path: certified");
# Coordinates 1e-100..1e105: Fast2Sum with |P| >= |Q|, and an edge's rounding error.
var _gg3_n23 = _gg3_un(0x4A602829A162CEB0, 0x4B49833C5C6CF248, 0xD42B7A1494568E62, 0xB32A0D7BB00859A8,
  0xCAA8A1E919CFA3E8, 0xD5C463990C6B1E0E, 0x2FCB60990C130F42, 0x2B305A38874E002C, 0);
assert_eq(HVec3_y(_gg3_n23), 0x3F0443E8342496F0, "mixed scales, |P| >= |Q|: y");
assert_eq(HVec3_z(_gg3_n23), 0xB3E87B9FCB9182AD, "... z");
assert_eq(_gg3_fast(0x4A602829A162CEB0, 0x4B49833C5C6CF248, 0xD42B7A1494568E62, 0xB32A0D7BB00859A8,
    0xCAA8A1E919CFA3E8, 0xD5C463990C6B1E0E, 0x2FCB60990C130F42, 0x2B305A38874E002C, 0), 1,
  "... the fast path: certified");
# Three vertices a few ulps apart at 1e-31: x's and z's products all zero, y = -1.
var _gg3_n24 = _gg3_un(0x39AE9450C0F7CB8A, 0xB99DC6E986DA3E6C, 0xB9613CB0FCCE2161, 0x39AE9450C0F7CB8A,
  0xB99DC6E986DA3E6C, 0xB9613CB0FCCE215C, 0x39AE9450C0F7CB89, 0xB99DC6E986DA3E6C, 0xB9613CB0FCCE2166);
assert_eq(HVec3_x(_gg3_n24), 0, "vertices ulps apart: x = 0");
assert_eq(HVec3_y(_gg3_n24), 0xBFF0000000000000, "... y = -1");
assert_eq(HVec3_z(_gg3_n24), 0, "... z = 0");
assert_eq(_gg3_fast(0x39AE9450C0F7CB8A, 0xB99DC6E986DA3E6C, 0xB9613CB0FCCE2161, 0x39AE9450C0F7CB8A,
    0xB99DC6E986DA3E6C, 0xB9613CB0FCCE215C, 0x39AE9450C0F7CB89, 0xB99DC6E986DA3E6C, 0xB9613CB0FCCE2166), 1,
  "... the fast path: certified");
# An edge component near 2^1000: its products overflow, which the fast range keeps out (NaN would pass
# the certificate's equality test).
var _gg3_n25 = _gg3_un(0, 0, 0, 0, 0x7E73CEB3FF2F6EA1, 0x4018B529B442C6C6, 0x4005EB561BD4F6B8, 0x4049A9A80EF2B725,
  0x41DA02F34B296572);
assert_eq(HVec3_x(_gg3_n25), F64_ONE, "an edge near 2^1000: x = 1 (exact path)");
assert_eq(HVec3_y(_gg3_n25), 0x0000868C085869B6, "... y");
assert_eq(_gg3_fast(0, 0, 0, 0, 0x7E73CEB3FF2F6EA1, 0x4018B529B442C6C6, 0x4005EB561BD4F6B8, 0x4049A9A80EF2B725,
    0x41DA02F34B296572), 0 - 1,
  "... the fast path: declined");
# (1, 2, 3), (2, 4, 6), (3, 6, 9): nothing rounds, so the zero cross product is certified exactly.
var _gg3_n26 = _gg3_un(F64_ONE, 0x4000000000000000, 0x4008000000000000, 0x4000000000000000, 0x4010000000000000,
  0x4018000000000000, 0x4008000000000000, 0x4018000000000000, 0x4022000000000000);
assert_eq(HVec3_y(_gg3_n26), F64_ONE, "exactly colinear integers: (0, 1, 0)");
assert_eq(_gg3_fast(F64_ONE, 0x4000000000000000, 0x4008000000000000, 0x4000000000000000, 0x4010000000000000,
    0x4018000000000000, 0x4008000000000000, 0x4018000000000000, 0x4022000000000000), 0,
  "... the fast path: an exactly zero cross product");

# === 3.4.1 GEO5: geo_barycentric_coords is certified above the thin switch (GF3-1, RT F4) ===
test_group("3.4.1 GEO5: geo_barycentric_coords, the Gram answer refined with an exact residual and certified");
# Each expected value is this tree's and the exact weights' rounding unless a message says otherwise
# (Fraction oracle); "(3.4.0: ...)" is the Gram solve's answer, which the first 3.4.1 tree gave too, more
# than 64 ulps of the largest weight off. The path code is _geo_bary_cert's: 1 certified, 0 the thin
# path (_geo_bary_thin), 2 a non-finite input's Gram answer.
# [measured: GEO5 3.4.1 pick5.py, the debug driver's stage codes, Fraction oracle, 2026-11-01]
fn _gg5_code(ax, ay, az, bx, by, bz, cx, cy, cz, px, py, pz) {
    var w: i64[3];
    return _geo_bary_cert(hvec3_new(ax, ay, az), hvec3_new(bx, by, bz), hvec3_new(cx, cy, cz), hvec3_new(px, py, pz),
      &w);
}
# An ordinary triangle, the point in its plane: the near-plane stage.
var _gg5_b1 = _gg3_bc(0x3FF94D60D36C4360, 0x3FFAE0A9B5D3E068, 0xBFD0045AA7D88888, 0xBFFEC2E952460DC8,
  0xBFC4916399912FC0, 0xC002DC3FCD98E716, 0xC001D588BDD93A8C, 0xBFDAA6652E76CBF0, 0xC0039907652FB1E2,
  0xBFFD001ACED8188C, 0xBFC36BD96E3D94A0, 0xC001F32609F55E97);
assert_eq(HVec3_x(_gg5_b1), 0x3FB39BB3F7BC0080, "ordinary, point in the plane: u, 4 ulps of u (3.4.0: ...0B08)");
assert_eq(HVec3_y(_gg5_b1), 0x3FDA0EB40674A0CF, "... v (3.4.0: 0x3FDA0EB40674AF56)");
assert_eq(HVec3_z(_gg5_b1), 0x3FE0852F7DCE2F88, "... w (3.4.0: 0x3FE0852F7DCE26F4)");
assert_eq(_gg5_code(0x3FF94D60D36C4360, 0x3FFAE0A9B5D3E068, 0xBFD0045AA7D88888, 0xBFFEC2E952460DC8,
    0xBFC4916399912FC0, 0xC002DC3FCD98E716, 0xC001D588BDD93A8C, 0xBFDAA6652E76CBF0, 0xC0039907652FB1E2,
    0xBFFD001ACED8188C, 0xBFC36BD96E3D94A0, 0xC001F32609F55E97), 1,
  "... certified");
# The point off the plane, 1.2 edge lengths: the second stage (the residual as two words).
var _gg5_b2 = _gg3_bc(0xC0051698F315D070, 0xBFF632A3F85473CE, 0x3FF0831C5D31B8F8, 0x3FF273248E9CC118,
  0x3FF0DE30FDE0185C, 0xBFF413E9437E593A, 0x3FB9661976D30920, 0xBFCB2390D34619C0, 0xBFC9D9FDD65A0940,
  0xBFFCDF3B34428914, 0x4006F3358483DF44, 0x4004F0B17ED6719C);
assert_eq(HVec3_x(_gg5_b2), 0x3FFC214179EBB6EA, "ordinary, point off the plane: u (3.4.0: ...B6B0)");
assert_eq(HVec3_y(_gg5_b2), 0x40029D775DC29806, "... v (3.4.0: 0x40029D775DC297D9)");
assert_eq(HVec3_z(_gg5_b2), 0xC008AE181AB8737B, "... w (3.4.0: 0xC008AE181AB87331)");
assert_eq(_gg5_code(0xC0051698F315D070, 0xBFF632A3F85473CE, 0x3FF0831C5D31B8F8, 0x3FF273248E9CC118,
    0x3FF0DE30FDE0185C, 0xBFF413E9437E593A, 0x3FB9661976D30920, 0xBFCB2390D34619C0, 0xBFC9D9FDD65A0940,
    0xBFFCDF3B34428914, 0x4006F3358483DF44, 0x4004F0B17ED6719C), 1,
  "... certified");
# 2^-6 .. 2^-12 from colinear, off the plane: the second stage's row-by-row bound.
var _gg5_b3 = _gg3_bc(0x3F8E8BF7C9D55500, 0x40008F59A8A54644, 0xC006B974BEFBA79E, 0xBFFEA5C3009F6492,
  0xBFF86EC6565549C0, 0xBFD9579F86DD0C70, 0x3FB0250A2D84FF3B, 0x40014E1F7A3768CA, 0xC0073E02E8482ADE,
  0xBFDDE5635CC41D26, 0x3FF2CE1948BE1DC6, 0xC001DF364104574E);
assert_eq(HVec3_x(_gg5_b3), 0xBFD3D6D85162D894, "near-colinear, off the plane: u (3.4.0: ...63DF2C)");
assert_eq(HVec3_y(_gg5_b3), 0x3FD1A20B8C5E65D1, "... v (3.4.0: 0x3FD1A20B8C5E6F5D)");
assert_eq(HVec3_z(_gg5_b3), 0x3FF08D3331411CB1, "... w (3.4.0: 0x3FF08D3331415BF4)");
assert_eq(_gg5_code(0x3F8E8BF7C9D55500, 0x40008F59A8A54644, 0xC006B974BEFBA79E, 0xBFFEA5C3009F6492,
    0xBFF86EC6565549C0, 0xBFD9579F86DD0C70, 0x3FB0250A2D84FF3B, 0x40014E1F7A3768CA, 0xC0073E02E8482ADE,
    0xBFDDE5635CC41D26, 0x3FF2CE1948BE1DC6, 0xC001DF364104574E), 1,
  "... certified");
# Edges 2^-12..2^-20 apart in length, the point in the plane: the shared bound's C passes 2^-20 for the
# near-plane stage, and the row-by-row one certifies.
var _gg5_b4 = _gg3_bc(0xBFD3D61297ED4B78, 0xBFFDCCF677EC7F71, 0xBFFD444066C6B479, 0xC002272F606B5E49,
  0x3FE4BF1125B0D96E, 0x3FE28D965326B186, 0xBFD3D32425D39A7D, 0xBFFDCCE28A6011F1, 0xBFFD44EBE10C33D3,
