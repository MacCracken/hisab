var _c37_f5 = _c37_mkbox(hvec3_new(0x3FE91E4FD2BEDD3E, 0xBFEA3254F6521324, 0xBFE75DFAB70E8624),
  hvec3_new(0x3FF978716C7667CD, 0x3FE2934B9B683FD2, 0x3FECCE2B8AB000D3),
