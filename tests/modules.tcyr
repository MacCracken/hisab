# ----------------------------------------------------------------
test_group("num: kahan and neumaier");

var n_kdata = alloc(24);
store64(n_kdata, f64_from(1));
store64(n_kdata + 8, f64_from(2));
store64(n_kdata + 16, f64_from(3));
var n_ks = num_kahan_sum(n_kdata, 3);
assert_eq(n_ks, f64_from(6), "kahan sum");

var n_ns = num_neumaier_sum(n_kdata, 3);
assert_eq(n_ns, f64_from(6), "neumaier sum");

# Empty sum (n=0)
var n_ns0 = num_neumaier_sum(n_kdata, 0);
assert_eq(n_ns0, f64_from(0), "neumaier n=0");

# ----------------------------------------------------------------
test_group("num: fft roundtrip");

# DC signal: 4 complex elements, all = (1.0, 0.0)
var n_fft_data = alloc(64);  # 4 * 16 bytes
var _fi = 0;
while (_fi < 4) {
    store64(n_fft_data + _fi * 16, F64_ONE);
    store64(n_fft_data + _fi * 16 + 8, 0);
    _fi = _fi + 1;
}
var n_fft_rc_t, n_fft_rc_v = num_fft(n_fft_data, 4);
assert_eq(is_ok(n_fft_rc_t), 1, "fft ok");
# DC component (index 0) should be 4+0i
assert_eq(load64(n_fft_data), f64_from(4), "fft DC re=4");
assert_eq(load64(n_fft_data + 8), f64_from(0), "fft DC im=0");

# Roundtrip: ifft should recover original
var _r13t, _r13v = num_ifft(n_fft_data, 4);
# All elements should be (1.0, 0.0) again -- exactly: at n = 4 the spectrum (4, 0, 0, 0)
# and the 1/4 scaling are exact. 3.3.5: these were three f64_round compares (+/-0.5 on
# 1.0), and two elements went unread. The imaginary zeros come back -0 in three slots,
# a sign this round trip does not fix, so they are compared numerically.
# [measured: scratch probe, not reproducible in-tree, 2026-10-11; cycc 6.6.14]
assert_eq(load64(n_fft_data), F64_ONE, "ifft[0].re = 1 exactly");
assert_eq(load64(n_fft_data + 16), F64_ONE, "ifft[1].re = 1 exactly");
assert_eq(load64(n_fft_data + 32), F64_ONE, "ifft[2].re = 1 exactly");
assert_eq(load64(n_fft_data + 48), F64_ONE, "ifft[3].re = 1 exactly");
assert_eq(f64_eq(load64(n_fft_data + 8), 0), 1, "ifft[0].im = 0 (sign incidental)");
assert_eq(f64_eq(load64(n_fft_data + 24), 0), 1, "ifft[1].im = 0 (sign incidental)");
assert_eq(f64_eq(load64(n_fft_data + 40), 0), 1, "ifft[2].im = 0 (sign incidental)");
assert_eq(f64_eq(load64(n_fft_data + 56), 0), 1, "ifft[3].im = 0 (sign incidental)");

test_group("3.3.7 num_fft: every 64th twiddle of a stage from sin / cos");
# An impulse at index 1 reads the last stage's twiddles out exactly: the odd half's
# sub-transform is all ones and the even half's all zeros, so X[k] = w_k and
# X[k + n/2] = -w_k. Through 3.3.6 w_k was k steps of w <- w * wn, and at n = 512 X[64]
# was (0x3FE6A09E667F3BBB, 0xBFE6A09E667F3BBD), 18 and 15 ulps from cos and sin of
# fl(2 pi) / 8; it is now their correctly rounded values (60-digit Decimal), the k = 64
# twiddle taken from sin / cos. n = 128 never reseeds (a stage needs half > 64), so its
# X[63], the 63rd recurrence step, keeps 3.3.6's bits. At n = 4096 every X[k] is within
# 2^-48 of the stdlib's (cos, sin)(angle k), where 3.3.6 was 6.7e-14 off at k = 2041.
# [measured: scratch impulse probe (pimp.cyr) and Decimal oracle, base tree and this tree, 2026-10-31; cycc 6.6.20]
fn _ft7_imp(n) {
    var d = alloc(n * 16);
    for (var i = 0; i < 2 * n; i = i + 1) { store64(d + i * 8, 0); }
    store64(d + 16, F64_ONE);
    var t, v = num_fft(d, n);
    return d;
}
var _ft7_a = _ft7_imp(512);
assert_eq(load64(_ft7_a + 64 * 16), 0x3FE6A09E667F3BCD,
  "num_fft impulse n = 512: X[64].re = RN(cos(fl(2 pi) / 8)) (3.3.6: ...3BBB)");
assert_eq(load64(_ft7_a + 64 * 16 + 8), 0xBFE6A09E667F3BCC,
  "num_fft impulse n = 512: X[64].im = -RN(sin(fl(2 pi) / 8)) (3.3.6: ...3BBD)");
assert_eq(load64(_ft7_a + 320 * 16), 0xBFE6A09E667F3BCD, "num_fft impulse n = 512: X[320] = -X[64], re");
assert_eq(load64(_ft7_a + 320 * 16 + 8), 0x3FE6A09E667F3BCC, "num_fft impulse n = 512: X[320] = -X[64], im");
var _ft7_b = _ft7_imp(128);
assert_eq(load64(_ft7_b + 63 * 16), 0xBFEFF621E3796D86, "num_fft impulse n = 128: X[63].re, 3.3.6's bits");
assert_eq(load64(_ft7_b + 63 * 16 + 8), 0xBFA91F65F10DD81A, "num_fft impulse n = 128: X[63].im, 3.3.6's bits");
var _ft7_n = 4096;
var _ft7_c = _ft7_imp(_ft7_n);
var _ft7_ang = f64_div(0xC01921FB54442D18, f64_from(_ft7_n));          # -2 pi / n
var _ft7_far = 0;                 # deviations not below 2^-48, a NaN among them
for (var _ft7_k = 0; _ft7_k < _ft7_n / 2; _ft7_k = _ft7_k + 1) {
    var _ft7_ak = f64_mul(_ft7_ang, f64_from(_ft7_k));
    var _ft7_dr = f64_abs(f64_sub(load64(_ft7_c + _ft7_k * 16), f64_cos(_ft7_ak)));
    var _ft7_di = f64_abs(f64_sub(load64(_ft7_c + _ft7_k * 16 + 8), f64_sin(_ft7_ak)));
    if (f64_lt(_ft7_dr, 0x3CF0000000000000) == 0 || f64_lt(_ft7_di, 0x3CF0000000000000) == 0) {
        _ft7_far = _ft7_far + 1;
    }
}
assert_eq(_ft7_far, 0, "num_fft impulse n = 4096: every twiddle within 2^-48 of sin / cos (3.3.6: 6.7e-14 off)");

# ================================================================
# COMPLEX — arithmetic, abs, conj, arg, euler, pauli, matrix (~20)
# ================================================================
test_group("complex: arithmetic");

var c_a = cx_new(f64_from(3), f64_from(4));
var c_b = cx_new(F64_ONE, F64_TWO);

# Add
var c_add = cx_add(c_a, c_b);
assert_eq(HComplex_re(c_add), f64_from(4), "cx add re");
assert_eq(HComplex_im(c_add), f64_from(6), "cx add im");

# Sub
var c_sub = cx_sub(c_a, c_b);
assert_eq(HComplex_re(c_sub), f64_from(2), "cx sub re");
assert_eq(HComplex_im(c_sub), f64_from(2), "cx sub im");

# Mul: (3+4i)(1+2i) = -5+10i
var c_mul = cx_mul(c_a, c_b);
assert_eq(HComplex_re(c_mul), f64_neg(f64_from(5)), "cx mul re");
assert_eq(HComplex_im(c_mul), f64_from(10), "cx mul im");

# Div: (3+4i)/(1+2i) = (3+4i)(1-2i)/5 = (11-2i)/5 = 2.2-0.4i. Smith's ratio 1/2 and its
# denominator 5/2 are exact, as are the numerators 11/2 and -1, so each part is one
# correctly rounded division: fl(11/5) and fl(-2/5) to the bit (round(10 re) = 22 accepted
# 0.05, and nothing read im).
var c_div = cx_div(c_a, c_b);
assert_eq(HComplex_re(c_div), 0x400199999999999A, "cx div re = fl(2.2)");
assert_eq(HComplex_im(c_div), 0xBFD999999999999A, "cx div im = fl(-0.4)");

# ----------------------------------------------------------------
test_group("complex: abs, conj, arg");

assert_eq(cx_abs(c_a), f64_from(5), "abs(3+4i)=5");

var c_conj = cx_conj(c_a);
assert_eq(HComplex_im(c_conj), f64_neg(f64_from(4)), "conj im");
assert_eq(HComplex_re(c_conj), f64_from(3), "conj re unchanged");

# arg(1+i) = pi/4
var c_1i = cx_new(F64_ONE, F64_ONE);
# atan2(1, 1) is f64_atan(1/1): x87 fpatan on x86_64 (under 1 ulp), so within 1 ulp of
# fl(pi/4) (round(1000 a) accepted 5e-4). Measured: fl(pi/4) itself.
# [measured: scratch probe and Decimal oracle, not reproducible in-tree, 2026-10-11; cycc 6.6.14]
var c_arg = cx_arg(c_1i);
assert(_tc_ulp_gap(c_arg, F64_PI_4) <= 1, "arg(1+i) = pi/4 within 1 ulp");

# ----------------------------------------------------------------
test_group("complex: euler identity");

# e^(i*pi) + 1 ~ 0
var c_eipi = cx_exp(cx_new(0, F64_PI));
var c_euler = cx_add(c_eipi, cx_one());
# cos(pi_d) rounds to exactly -1.0 and sin(pi_d) = 1.2246467991473532e-16, so the
# closed-form modulus is 1.2246e-16 (measured: identical). The old bound of 1.0
# passed for any argument within about +-60 deg of pi.
# Bit-exact at that closed form: 0x3CA1A62633145C07 is sin(pi_d) correctly rounded.
# [measured: scratch Decimal oracle (80 digits), not reproducible in-tree, 2026-10-11]
assert_eq(cx_abs(c_euler), 0x3CA1A62633145C07, "euler |e^(ipi)+1| == sin(pi_d), bit-exact");
# e^(i*pi)+1 == 0 is BLIND to conjugation: pi is a fixed point of z -> conj(z), so
# negating the imaginary output of cx_exp leaves this bit-identical (verified: such
# a mutant passes all four suites). Pin a point where the two differ.
# e^(i*pi/2) = 6.123233995736766e-17 + 1i
var _e_ih = cx_exp(cx_new(0, F64_PI_2));
# Both parts bit-exact: 0x3C91A62633145C07 is cos(fl(pi/2)) correctly rounded, and
# sin(fl(pi/2)) rounds to 1. The 1e-15 test this replaced read the real part as 0.
# [measured: scratch Decimal oracle (80 digits), not reproducible in-tree, 2026-10-11]
assert_eq(HComplex_re(_e_ih), 0x3C91A62633145C07, "cx_exp(i*pi/2).re == cos(fl(pi/2)), bit-exact");
assert_eq(HComplex_im(_e_ih), F64_ONE, "cx_exp(i*pi/2).im == +1 (not -1), bit-exact");

# ----------------------------------------------------------------
test_group("complex: pauli matrices");

# sigma_x^2 = I
var c_sx = pauli_x();
var c_sx2 = cmat_mul(c_sx, c_sx);
var c_tr_sx2 = cmat_trace(c_sx2);
assert_eq(HComplex_re(c_tr_sx2), f64_from(2), "sx^2 trace=2");

# sigma_y^2 = I
var c_sy = pauli_y();
var c_sy2 = cmat_mul(c_sy, c_sy);
var c_tr_sy2 = cmat_trace(c_sy2);
assert_eq(HComplex_re(c_tr_sy2), f64_from(2), "sy^2 trace=2");

# sigma_z^2 = I
var c_sz = pauli_z();
var c_sz2 = cmat_mul(c_sz, c_sz);
var c_tr_sz2 = cmat_trace(c_sz2);
assert_eq(HComplex_re(c_tr_sz2), f64_from(2), "sz^2 trace=2");

# Traceless: tr(sigma_x) = 0
var c_tr_sx = cmat_trace(c_sx);
assert_eq(HComplex_re(c_tr_sx), f64_from(0), "sx traceless");
var c_tr_sy = cmat_trace(c_sy);
assert_eq(HComplex_re(c_tr_sy), f64_from(0), "sy traceless");
var c_tr_sz = cmat_trace(c_sz);
assert_eq(HComplex_re(c_tr_sz), f64_from(0), "sz traceless");

# Commutation: [sx, sy] = 2i*sz
var c_comm = cmat_commutator(c_sx, c_sy);
var c_c00 = cmat_get(c_comm, 0, 0);
assert_eq(HComplex_im(c_c00), f64_from(2), "[sx,sy]_00 im=2");

# ----------------------------------------------------------------
test_group("complex: matrix");

# Identity trace
var c_id = cmat_identity(3);
var c_id_tr = cmat_trace(c_id);
assert_eq(HComplex_re(c_id_tr), f64_from(3), "identity(3) trace=3");

# Adjoint of identity = identity
var c_id_adj = cmat_adjoint(c_id);
var c_id_adj_tr = cmat_trace(c_id_adj);
assert_eq(HComplex_re(c_id_adj_tr), f64_from(3), "adj(I) trace=3");
# If cmat_adjoint were a plain copy, the 8-generator hermitian sweep is A == A
# again -- verified: such a stub passes all four suites, because 'adj(I) trace==3'
# is satisfied by the identity function. Pin adjoint on a NON-hermitian matrix.
var _adj_m = cmat_new(2, 2);
cmat_set(_adj_m, 0, 1, cx_new(F64_TWO, f64_from(3)));
var _adj_r = cmat_adjoint(_adj_m);
assert_eq(HComplex_re(cmat_get(_adj_r, 1, 0)), f64_from(2), "adj[1][0].re == 2 (transposed)");
assert_eq(HComplex_im(cmat_get(_adj_r, 1, 0)), f64_neg(f64_from(3)), "adj[1][0].im == -3 (conjugated)");
assert_eq(HComplex_re(cmat_get(_adj_r, 0, 1)), f64_from(0), "adj[0][1] == 0 (not a copy)");

# ================================================================
# LIE GROUPS (~15)
# ================================================================
test_group("lie: U(1)");

# Compose = add phases
var l_u_a = u1_new(F64_PI_4);
var l_u_b = u1_new(F64_PI_4);
var l_u_c = u1_compose(l_u_a, l_u_b);
# An exact doubling, and F64_PI_2 is exactly 2 * F64_PI_4: bit-exact.
assert_eq(load64(l_u_c), F64_PI_2, "u1 compose pi/4+pi/4 = pi/2 exactly");

# Inverse: phase + (-phase) ~ 0
var l_u_inv = u1_inv(l_u_a);
var l_u_id = u1_compose(l_u_a, l_u_inv);
# f64_add(theta, f64_neg(theta)) is exactly +0.0 in IEEE-754 round-to-nearest for
# every finite theta, so this is exact. Measured bit pattern: 0x0.
# [measured: tests/modules.tcyr "u1 inv phase is exactly +0.0"]
assert_eq(load64(l_u_id), 0, "u1 inv phase is exactly +0.0");

# Exp/log roundtrip
var l_u_exp = u1_exp(F64_PI_4);
var l_u_log = u1_log(l_u_exp);
# U(1) stores the phase itself, so exp then log is the identity on its bits.
assert_eq(l_u_log, F64_PI_4, "u1 exp/log roundtrip is exact");

# ----------------------------------------------------------------
test_group("lie: SU(2)");

# Identity to_quat -> w=1
var l_su2_id = su2_identity();
var l_su2_q = su2_to_quat(l_su2_id);
assert_eq(HQuat_w(l_su2_q), f64_from(1), "su2 identity w=1");

# Compose inverse = identity
var l_su2_r = su2_from_axis_angle(hvec3_unit_z(), F64_PI_4);
var l_su2_ri = su2_inv(l_su2_r);
var l_su2_p = su2_compose(l_su2_r, l_su2_ri);
# Half-angle convention: su2_from_axis_angle(z_hat, pi/4) = cos(pi/8) + sin(pi/8) k.
# Pin those first -- w = 1 after compose-with-inverse and dw = 0 after a to_quat
# round-trip are both TRUE under a full-angle build, so neither check below can
# see the half-vs-full-angle split that shipped through 2.6.12.
#   cos(pi/8) = 0.9238795325112867   (a full-angle build would put 0.7071067811865476 here)
#   sin(pi/8) = 0.3826834323650898
var _cos_pi8 = 0x3FED906BCF328D46;  # 0.9238795325112867
var _sin_pi8 = 0x3FD87DE2A6AEA963;  # 0.3826834323650898
# Both are the correctly rounded cos and sin of fl(pi/4)/2 (and of pi/8): bit-exact.
# [measured: scratch Decimal oracle (80 digits), not reproducible in-tree, 2026-10-11]
assert_eq(_su2_w(l_su2_r), _cos_pi8, "su2 axis-angle w == cos(pi/8), bit-exact");
assert_eq(_su2_z(l_su2_r), _sin_pi8, "su2 axis-angle z == sin(pi/8), bit-exact");
# w of q*q^-1 is w^2+x^2+y^2+z^2 = 1 exactly for a unit quaternion (measured
# residual 0). The old bound of 1.0 merely asserted w > 0.
# [measured: tests/modules.tcyr "su2 compose inv w == 1, bit-exact"]
assert_eq(_su2_w(l_su2_p), F64_ONE, "su2 compose inv w == 1, bit-exact");
# w of q*q^-1 is an inner product, so EVERY su2 assertion in the repo (w == 1, the
# to_quat dw, the axis-angle pins) survives a sign flip in su2_compose's x/y/z
# cross terms -- verified. Pin all four components of a product of two
# non-parallel rotations.
var _c07 = 0x3FE6666666666666;  # 0.7
var _c11 = 0x3FF199999999999A;  # 1.1
var _sa = su2_from_axis_angle(hvec3_new(F64_ONE, F64_TWO, f64_from(3)), _c07);
var _sb = su2_from_axis_angle(hvec3_new(f64_neg(F64_TWO), F64_ONE, F64_HALF), _c11);
var _sp = su2_compose(_sa, _sb);
var _sp_w = 0x3FE89F9435EE839F;   # 0.7694798520425258
var _sp_x = 0xBFD91ACF6D1B1AAA;   # -0.392261368321139
var _sp_y = 0x3FCE094E17426F47;   # 0.23465896735876354
var _sp_z = 0x3FDC8C331EC15140;   # 0.44605710986549596  (a z-sign flip gives 0.2788)
assert(f64_lt(f64_abs(f64_sub(_su2_w(_sp), _sp_w)), TOL_1EM12) == 1, "su2_compose generic w");
assert(f64_lt(f64_abs(f64_sub(_su2_x(_sp), _sp_x)), TOL_1EM12) == 1, "su2_compose generic x");
assert(f64_lt(f64_abs(f64_sub(_su2_y(_sp), _sp_y)), TOL_1EM12) == 1, "su2_compose generic y");
assert(f64_lt(f64_abs(f64_sub(_su2_z(_sp), _sp_z)), TOL_1EM12) == 1, "su2_compose generic z");
# where: var TOL_1EM12 = 0x3D719799812DEA11;  # 1e-12 (== EPSILON_F64)

# to_quat roundtrip
var l_su2_q2 = su2_to_quat(l_su2_r);
var l_su2_back = su2_from_quat(l_su2_q2);
# Both w's live in [-1, 1], so |dw| < 1.0 was near-unfalsifiable. The round trip
# renormalizes by a norm of exactly 1.0 here: measured dw = 0.
# [measured: tests/modules.tcyr "su2 to_quat roundtrip dw == 0: w comes back bit for bit"]
assert_eq(_su2_w(l_su2_back), _su2_w(l_su2_r), "su2 to_quat roundtrip dw == 0: w comes back bit for bit");

# ----------------------------------------------------------------
test_group("lie: Gell-Mann");

# The three properties that CHARACTERISE the SU(3) Gell-Mann basis:
#   (1) lambda_a = lambda_a^H          (Hermitian, checked elementwise)
#   (2) tr lambda_a = 0                (traceless)
#   (3) tr(lambda_a lambda_b) = 2 delta_ab   (orthogonal, normalised to 2)
# Every expected value below is closed form. The ONLY floating-point residual
# anywhere in this block is tr(l8 l8): l8's entries are fl(1/fl(sqrt 3)), so the
# trace is 6*fl(x*x) = 2.0000000000000004 — exactly one ulp at 2.0
# (4.4408920985006262e-16) above the exact 2. Everything else is bit-exact:
# the other seven generators have entries in {0, +-1, +-i}, and l8's trace
# cancels exactly because fl(2/s) == 2*fl(1/s) for s = fl(sqrt 3).
var GM_TR_TOL = 0x3CD203AF9EE75616;   # 1e-15  = 2.25 ulp at 2.0
var GM_L8_TOL = 0x3CBCD2B297D889BC;   # 4e-16  = 3.6 ulp at 0.577, 1.8 ulp at 1.155
# Correctly-rounded doubles of 1/sqrt(3) and 2/sqrt(3), derived independently at
# 60 decimal digits (NOT read off the library, which rounds twice and lands
# one ulp high at 0x3FE279A74590331D — inside GM_L8_TOL).
var GM_L8_A  = 0x3FE279A74590331C;    #  1/sqrt(3) =  0.5773502691896257645091
var GM_L8_B2 = 0xBFF279A74590331C;    # -2/sqrt(3) = -1.1547005383792515290183

# --- (0) the checker must be able to FAIL --------------------------------
# The assertion this replaces compared Re(A[0][0]) against Re(adjoint(A)[0][0]),
# which is bit-identical for every complex matrix. These three controls prove
# _gm_is_herm actually discriminates.
var l_gm_nh1 = cmat_new(3, 3);
cmat_set(l_gm_nh1, 0, 1, cx_one());                 # 1 at (0,1), 0 at (1,0)
assert_eq(_gm_is_herm(l_gm_nh1), 0, "gm herm control: rejects non-symmetric real part");
var l_gm_nh2 = cmat_new(3, 3);
cmat_set(l_gm_nh2, 0, 0, cx_i());                   # imaginary entry on the diagonal
assert_eq(_gm_is_herm(l_gm_nh2), 0, "gm herm control: rejects imaginary diagonal");
var l_gm_nh3 = cmat_new(3, 3);                      # lambda_2 with the conjugation dropped
cmat_set(l_gm_nh3, 0, 1, cx_i());
cmat_set(l_gm_nh3, 1, 0, cx_i());
assert_eq(_gm_is_herm(l_gm_nh3), 0, "gm herm control: rejects unconjugated off-diagonal");

# --- (1) Hermiticity + (2) tracelessness, all 8 generators ---------------
var _gm_a = 0;
while (_gm_a < 8) {
    var l_gma = gell_mann(_gm_a);
    assert_eq(_gm_is_herm(l_gma), 1, "gell-mann hermitian (all 9 entries, re and im)");
    # Hermitian + traceless is invariant under PERMUTING the generators: swapping the
    # lambda_4 and lambda_5 bodies passes all four suites. Pin each one's identity.
    assert_eq(HComplex_re(cmat_get(gell_mann(3), 0, 2)), f64_from(1), "lambda_4[0][2] == +1 (real)");
    assert_eq(HComplex_im(cmat_get(gell_mann(3), 0, 2)), f64_from(0), "lambda_4[0][2] has no i");
    assert_eq(HComplex_im(cmat_get(gell_mann(4), 0, 2)), f64_neg(f64_from(1)), "lambda_5[0][2] == -i");
    assert_eq(HComplex_re(cmat_get(gell_mann(4), 0, 2)), f64_from(0), "lambda_5[0][2] is pure imaginary");
    assert_eq(HComplex_re(cmat_get(gell_mann(5), 1, 2)), f64_from(1), "lambda_6[1][2] == +1 (real)");
    assert_eq(HComplex_im(cmat_get(gell_mann(6), 1, 2)), f64_neg(f64_from(1)), "lambda_7[1][2] == -i");
    assert_eq(HComplex_re(cmat_get(gell_mann(2), 0, 0)), f64_from(1), "lambda_3[0][0] == +1");
    assert_eq(HComplex_re(cmat_get(gell_mann(2), 1, 1)), f64_neg(f64_from(1)), "lambda_3[1][1] == -1");
    # cmat_adjoint must reproduce the matrix exactly — all 9 entries, both
    # components. Off-diagonal entries make this a real transpose+conjugate test.
    var l_gma_h = cmat_adjoint(l_gma);
    var l_gm_adj_bad = 0;
    var _gm_i = 0;
    while (_gm_i < 3) {
        var _gm_j = 0;
        while (_gm_j < 3) {
            var l_gm_u = cmat_get(l_gma, _gm_i, _gm_j);
            var l_gm_v = cmat_get(l_gma_h, _gm_i, _gm_j);
            if (f64_eq(HComplex_re(l_gm_u), HComplex_re(l_gm_v)) == 0) {
                l_gm_adj_bad = l_gm_adj_bad + 1;
            }
            if (f64_eq(HComplex_im(l_gm_u), HComplex_im(l_gm_v)) == 0) {
                l_gm_adj_bad = l_gm_adj_bad + 1;
            }
            _gm_j = _gm_j + 1;
        }
        _gm_i = _gm_i + 1;
    }
    assert_eq(l_gm_adj_bad, 0, "gell-mann adjoint == self, entrywise");
    # Traceless: exactly 0, both components (not "within 1.0").
    var l_gm_tr = cmat_trace(l_gma);
    assert_eq(f64_eq(HComplex_re(l_gm_tr), 0), 1, "gell-mann traceless (re exactly 0)");
    assert_eq(f64_eq(HComplex_im(l_gm_tr), 0), 1, "gell-mann traceless (im exactly 0)");
    _gm_a = _gm_a + 1;
}

# --- (3) orthogonality: tr(l_a l_b) = 2 delta_ab over all 64 pairs -------
var _gm_p = 0;
var l_gm_off_bad = 0;
var l_gm_diag_bad = 0;
var l_gm_im_bad = 0;
while (_gm_p < 8) {
    var l_gm_pa = gell_mann(_gm_p);
    var _gm_q = 0;
    while (_gm_q < 8) {
        var l_gm_t = cmat_trace(cmat_mul(l_gm_pa, gell_mann(_gm_q)));
        if (f64_eq(HComplex_im(l_gm_t), 0) == 0) { l_gm_im_bad = l_gm_im_bad + 1; }
        if (_gm_p == _gm_q) {
            if (f64_lt(f64_abs(f64_sub(HComplex_re(l_gm_t), F64_TWO)), GM_TR_TOL) == 0) {
                l_gm_diag_bad = l_gm_diag_bad + 1;
            }
        } else {
            if (f64_eq(HComplex_re(l_gm_t), 0) == 0) { l_gm_off_bad = l_gm_off_bad + 1; }
        }
        _gm_q = _gm_q + 1;
    }
    _gm_p = _gm_p + 1;
}
assert_eq(l_gm_off_bad, 0, "gell-mann tr(la lb) exactly 0 for a != b (56 pairs)");
assert_eq(l_gm_diag_bad, 0, "gell-mann tr(la la) = 2 within 1e-15 (8 pairs)");
assert_eq(l_gm_im_bad, 0, "gell-mann tr(la lb) exactly real (64 pairs)");

# Controls proving the Gram sweep measures normalisation, not a constant 2:
# tr((2 l1)^2) = 4 * tr(l1^2) = 8, and tr((l1+l4)^2) = 2 + 2*tr(l1 l4) + 2 = 4.
var l_gm_2l1 = cmat_scale(gell_mann(0), cx_real(F64_TWO));
var l_gm_ct1 = cmat_trace(cmat_mul(l_gm_2l1, l_gm_2l1));
assert_eq(f64_eq(HComplex_re(l_gm_ct1), f64_from(8)), 1, "gm gram control: tr((2 l1)^2) = 8");
var l_gm_s14 = cmat_add(gell_mann(0), gell_mann(3));
var l_gm_ct2 = cmat_trace(cmat_mul(l_gm_s14, l_gm_s14));
assert_eq(f64_eq(HComplex_re(l_gm_ct2), f64_from(4)), 1, "gm gram control: tr((l1+l4)^2) = 4");

# --- convention pin ------------------------------------------------------
# Hermiticity + tracelessness + tr(la lb) = 2 delta_ab are invariant under any
# unitary change of basis, so they do not by themselves pin the Gell-Mann
# convention. These do:
#   lambda_1 = [[0,1,0],[1,0,0],[0,0,0]]
#   lambda_3 = diag(1, -1, 0)
#   lambda_8 = diag(1, 1, -2)/sqrt(3)
#   [lambda_1, lambda_2] = 2i lambda_3   (structure constant f_123 = +1)
var l_gm_l1 = gell_mann(0);
assert_eq(f64_eq(HComplex_re(cmat_get(l_gm_l1, 0, 1)), F64_ONE), 1, "l1(0,1) = 1");
assert_eq(f64_eq(HComplex_re(cmat_get(l_gm_l1, 0, 0)), 0), 1, "l1(0,0) = 0");
var l_gm_l3 = gell_mann(2);
assert_eq(f64_eq(HComplex_re(cmat_get(l_gm_l3, 0, 0)), F64_ONE), 1, "l3(0,0) = +1");
assert_eq(f64_eq(HComplex_re(cmat_get(l_gm_l3, 1, 1)), f64_neg(F64_ONE)), 1, "l3(1,1) = -1");
assert_eq(f64_eq(HComplex_re(cmat_get(l_gm_l3, 2, 2)), 0), 1, "l3(2,2) = 0");
var l_gm_l8 = gell_mann(7);
var l_gm_e00 = HComplex_re(cmat_get(l_gm_l8, 0, 0));
var l_gm_e11 = HComplex_re(cmat_get(l_gm_l8, 1, 1));
var l_gm_e22 = HComplex_re(cmat_get(l_gm_l8, 2, 2));
assert_eq(f64_lt(f64_abs(f64_sub(l_gm_e00, GM_L8_A)), GM_L8_TOL), 1, "l8(0,0) = 1/sqrt(3)");
assert_eq(f64_eq(l_gm_e11, l_gm_e00), 1, "l8(1,1) == l8(0,0)");
assert_eq(f64_lt(f64_abs(f64_sub(l_gm_e22, GM_L8_B2)), GM_L8_TOL), 1, "l8(2,2) = -2/sqrt(3)");
assert_eq(f64_eq(HComplex_re(cmat_get(l_gm_l8, 0, 1)), 0), 1, "l8(0,1) = 0");
var l_gm_c12 = cmat_commutator(gell_mann(0), gell_mann(1));
var l_gm_k00 = cmat_get(l_gm_c12, 0, 0);
var l_gm_k11 = cmat_get(l_gm_c12, 1, 1);
assert_eq(f64_eq(HComplex_re(l_gm_k00), 0), 1, "[l1,l2](0,0) is pure imaginary");
assert_eq(f64_eq(HComplex_im(l_gm_k00), F64_TWO), 1, "[l1,l2] = 2i l3: (0,0) im = +2");
assert_eq(f64_eq(HComplex_im(l_gm_k11), f64_neg(F64_TWO)), 1, "[l1,l2] = 2i l3: (1,1) im = -2");
assert_eq(f64_eq(HComplex_im(cmat_get(l_gm_c12, 2, 2)), 0), 1, "[l1,l2] = 2i l3: (2,2) im = 0");
assert_eq(f64_eq(HComplex_im(cmat_get(l_gm_c12, 0, 1)), 0), 1, "[l1,l2] = 2i l3: (0,1) im = 0");
# --- (4) convention pin for lambda_4..lambda_7 ---------------------------
# Properties (1)-(3) are invariant under ANY real orthogonal mixing of
# lambda_4..lambda_7 (the 4-dim subspace orthogonal to l1,l2,l3,l8), and the
# pins above touch only l1, l2, l3, l8 -- so a sign flip on l5 or l7, a swap of
# l4 and l6, or a 45-degree rotation of (l4,l6) passes everything above.
# Each pin below plus Hermiticity plus tr(la la) = 2 determines the generator
# uniquely: two off-diagonal entries of modulus 1 already exhaust the norm.
assert_eq(f64_eq(HComplex_re(cmat_get(gell_mann(3), 0, 2)), F64_ONE), 1, "l4(0,2) = +1");
assert_eq(f64_eq(HComplex_im(cmat_get(gell_mann(3), 0, 2)), 0), 1, "l4(0,2) im = 0");
assert_eq(f64_eq(HComplex_re(cmat_get(gell_mann(3), 1, 2)), 0), 1, "l4(1,2) = 0");
assert_eq(f64_eq(HComplex_im(cmat_get(gell_mann(4), 0, 2)), f64_neg(F64_ONE)), 1, "l5(0,2) = -i");
assert_eq(f64_eq(HComplex_re(cmat_get(gell_mann(4), 0, 2)), 0), 1, "l5(0,2) re = 0");
assert_eq(f64_eq(HComplex_re(cmat_get(gell_mann(5), 1, 2)), F64_ONE), 1, "l6(1,2) = +1");
assert_eq(f64_eq(HComplex_re(cmat_get(gell_mann(5), 0, 2)), 0), 1, "l6(0,2) = 0");
assert_eq(f64_eq(HComplex_im(cmat_get(gell_mann(6), 1, 2)), f64_neg(F64_ONE)), 1, "l7(1,2) = -i");
assert_eq(f64_eq(HComplex_re(cmat_get(gell_mann(6), 1, 2)), 0), 1, "l7(1,2) re = 0");

# --- (5) algebra closure: [l_a, l_b] = 2i sum_c f_abc l_c ----------------
# The identity that actually ties the matrices to the algebra, over all 64
# pairs and all 9 entries. Also the first coverage su3_structure_constant
# (src/lie.cyr) had: when this landed in 2.7.0 no suite called it, so the table
# and the matrices had never been checked against each other. (tests/abuse.tcyr
# has called it with out-of-range indices since 2.9.0.) Exact in double:
# 2 * (sqrt3/2) * (1/sqrt3) == 1.0 and 2 * (sqrt3/2) * (-2/sqrt3) == -2.0 bit for
# bit, so the tolerance is slack.
var l_gm_sc_bad = 0;
var _gm_u = 0;
while (_gm_u < 8) {
    var _gm_v = 0;
    while (_gm_v < 8) {
        var l_gm_lhs = cmat_commutator(gell_mann(_gm_u), gell_mann(_gm_v));
        var l_gm_rhs = cmat_new(3, 3);
        var _gm_c = 0;
        while (_gm_c < 8) {
            var l_gm_f = su3_structure_constant(_gm_u + 1, _gm_v + 1, _gm_c + 1);
            if (f64_eq(l_gm_f, 0) == 0) {
                var l_gm_w = cx_new(0, f64_mul(F64_TWO, l_gm_f));
                l_gm_rhs = cmat_add(l_gm_rhs, cmat_scale(gell_mann(_gm_c), l_gm_w));
            }
            _gm_c = _gm_c + 1;
        }
        var _gm_r = 0;
        while (_gm_r < 3) {
            var _gm_s = 0;
            while (_gm_s < 3) {
                var l_gm_lv = cmat_get(l_gm_lhs, _gm_r, _gm_s);
                var l_gm_rv = cmat_get(l_gm_rhs, _gm_r, _gm_s);
                var l_gm_dr = f64_abs(f64_sub(HComplex_re(l_gm_lv), HComplex_re(l_gm_rv)));
                var l_gm_di = f64_abs(f64_sub(HComplex_im(l_gm_lv), HComplex_im(l_gm_rv)));
                if (f64_lt(l_gm_dr, GM_TR_TOL) == 0) { l_gm_sc_bad = l_gm_sc_bad + 1; }
                if (f64_lt(l_gm_di, GM_TR_TOL) == 0) { l_gm_sc_bad = l_gm_sc_bad + 1; }
                _gm_s = _gm_s + 1;
            }
            _gm_r = _gm_r + 1;
        }
        _gm_v = _gm_v + 1;
    }
    _gm_u = _gm_u + 1;
}
assert_eq(l_gm_sc_bad, 0, "gell-mann [la,lb] = 2i f_abc lc (64 pairs, 9 entries, re+im)");

# ----------------------------------------------------------------
test_group("lie: Lorentz");

# Identity transforms (t,0,0,0) -> (t,0,0,0)
var l_lor_id = lorentz_identity();
var l_tv4 = alloc(32);
store64(l_tv4, F64_ONE); store64(l_tv4 + 8, 0); store64(l_tv4 + 16, 0); store64(l_tv4 + 24, 0);
var l_tv4_out = lorentz_transform_4vec(l_lor_id, l_tv4);
assert_eq(load64(l_tv4_out), f64_from(1), "lorentz id t");
assert_eq(load64(l_tv4_out + 8), f64_from(0), "lorentz id x");

# Boost validity: a boost should satisfy Lambda^T eta Lambda = eta
var l_boost = lorentz_boost_x(F64_HALF);
assert_eq(lorentz_is_valid(l_boost), 1, "boost is valid");
# lorentz_boost_x takes RAPIDITY, not velocity: Lambda^0_0 = cosh(0.5) and
# Lambda^1_0 = sinh(0.5). If it ever silently reverts to reading the argument as
# beta, those become gamma = 1.1547005383792517 and gamma*beta = 0.5773502691896258
# -- 0.027 and 0.056 away, both far outside 1e-15. The compose-inverse and
# interval-preservation checks below hold under EITHER reading, so they cannot
# see that regression; these two can.
var _cosh_half = 0x3FF20AC1862AE8D0;  # cosh(0.5) = 1.1276259652063807
var _sinh_half = 0x3FE0ACD00FE63B97;  # sinh(0.5) = 0.5210953054937474
# Both constants are the correctly rounded cosh(0.5) and sinh(0.5): bit-exact.
# [measured: scratch Decimal oracle (80 digits), not reproducible in-tree, 2026-10-11]
assert_eq(m4_get(l_boost, 0, 0), _cosh_half, "boost_x(0.5)[0][0] == cosh(0.5), bit-exact");
assert_eq(m4_get(l_boost, 1, 0), _sinh_half, "boost_x(0.5)[1][0] == sinh(0.5), bit-exact");

# Compose inverse = identity (approx)
var l_boost_inv = lorentz_inv(l_boost);
var l_comp = lorentz_compose(l_boost, l_boost_inv);
# Diagonal should be ~1, off-diagonal ~0
# cosh^2 - sinh^2 = 1 in closed form; measured residual 2.22e-16 (1 ulp). The old
# bound of 1.0 accepted any [0][0] in [0, 2]. Check an off-diagonal too, or a
# lorentz_inv that returned the identity would leave [0][0] = cosh(0.5) = 1.128
# and still pass.
# [measured: scratch python re-derivation from the pinned cosh/sinh(0.5) bits, 2026-10-11; the asserts below bound it]
assert(f64_lt(f64_abs(f64_sub(m4_get(l_comp, 0, 0), F64_ONE)), ULP_TOL_M) == 1,
  "lorentz compose inv [0][0] == 1 (1e-15)");
assert(f64_lt(f64_abs(f64_sub(m4_get(l_comp, 1, 1), F64_ONE)), ULP_TOL_M) == 1,
  "lorentz compose inv [1][1] == 1 (1e-15)");
assert(f64_lt(f64_abs(m4_get(l_comp, 0, 1)), ULP_TOL_M) == 1, "lorentz compose inv [0][1] == 0");

# Preserves Minkowski interval
var l_tv4b = alloc(32);
store64(l_tv4b, f64_from(5)); store64(l_tv4b + 8, f64_from(3));
store64(l_tv4b + 16, 0); store64(l_tv4b + 24, 0);
var l_intv_before = minkowski_interval(l_tv4b);
var l_tv4b_out = lorentz_transform_4vec(l_boost, l_tv4b);
var l_intv_after = minkowski_interval(l_tv4b_out);
var l_intv_diff = f64_abs(f64_sub(l_intv_before, l_intv_after));
# Pin the interval itself: 5^2 - 3^2 = 16 exactly. A (-,+,+,+) signature would
# give -16 and the before/after DIFFERENCE would still be 0, so the preservation
# check alone is blind to a global sign flip.
assert_eq(l_intv_before, f64_from(16), "minkowski interval of (5,3,0,0) == +16");
# Boosted by rapidity 0.5: t' = 5cosh+3sinh = 7.201415742513145,
# x' = 5sinh+3cosh = 5.988354423087879, t'^2 - x'^2 = 15.999999999999993.
# Measured drift 7.105e-15 = 4 ulp of 16. The old bound of 1.0 was a 6.25%
# relative tolerance on a quantity of magnitude 16.
# [measured: scratch python re-derivation from the pinned cosh/sinh(0.5) bits, 2026-10-11; the assert below bounds it]
assert(f64_lt(l_intv_diff, IVL_TOL_M) == 1, "lorentz preserves interval (1e-13)");
# (5,3,0,0) leaves y and z at zero, so dropping either spatial term is invisible
# to both the +16 pin and the 1e-13 drift bound -- verified across all four suites.
var _mv = alloc(32);
store64(_mv, f64_from(5)); store64(_mv + 8, f64_from(3));
store64(_mv + 16, f64_from(4)); store64(_mv + 24, F64_TWO);
# 25 - 9 - 16 - 4 = -4
assert_eq(minkowski_interval(_mv), f64_neg(f64_from(4)), "interval(5,3,4,2) == -4");
var _mo = lorentz_transform_4vec(l_boost, _mv);
assert(f64_lt(f64_abs(f64_sub(minkowski_interval(_mo), minkowski_interval(_mv))), TOL_1EM12) == 1,
  "boost preserves interval(5,3,4,2)");

# ⭐ 3.3.4 — THE BOOST ENTRIES BIT FOR BIT. ganita 1.2.11 (cyrius 6.6.13) re-derived
# sinh and cosh, and no assertion saw it: the boost_x(0.5) checks above compare
# through a tolerance, and built against 6.6.12 the five suites failed only the atan2
# pins in edge_cases.tcyr. sinh is now computed on |x| and re-signed: below 22 it is
# fdlibm's expm1 form, which removes the cancellation in (e^x - e^-x)/2 (6.6.12 was
# 285 ulp off at 1e-3); from 22 up it is e^|x|/2, which past 709 takes a power of 2
# out of the exponential instead of rounding |x| - ln 2 (6.6.12 was 453 ulp off one
# ulp above 709, 459 at 710.4). cosh is computed on |x| as well, so it is even bit
# for bit, and shares the form past 709. Each pin below is the CORRECTLY ROUNDED
# value by an 80-digit Decimal oracle (two exp routes, cross-checked), and each one
# FAILS when built against cyrius 6.6.12 (ganita 1.2.9), whose value is in the
# message. A value the new code does not round correctly is never pinned -- a later
# ganita improvement would fail it -- so the parity checks at the end assert the
# identity, not the bits. cosh, and both entries from 22 up, go through
# f64_exp, which is x87 on x86_64 and a polyfill on aarch64: these were measured on
# x86_64.
# [measured: scratch harness and Decimal oracle, not reproducible in-tree, 2026-10-03; cycc 6.6.12 and 6.6.14]
# Below 1, the expm1 branch. At -1e-3, 6.6.12 also missed cosh's mirror by an ulp.
var l_hy_s = lorentz_boost_x(0x3F50624DD2F1A9FC);   # fl(1e-3)
assert_eq(m4_get(l_hy_s, 1, 0), 0x3F50624E00C1C9E3,
  "boost_x(1e-3) sinh entry, correctly rounded (6.6.12: ...CB00)");
var l_hy_sn = lorentz_boost_x(0xBF50624DD2F1A9FC);  # fl(-1e-3)
assert_eq(m4_get(l_hy_sn, 1, 0), 0xBF50624E00C1C9E3,
  "boost_x(-1e-3) sinh entry, correctly rounded (6.6.12: ...CA00)");
assert_eq(m4_get(l_hy_sn, 0, 0), 0x3FF000008637BDC1,
  "boost_x(-1e-3) cosh entry, correctly rounded (6.6.12: ...BDC2)");
# From 1 to 22, the other expm1 branch: a positive rapidity, and a negative one whose
# cosh 6.6.12 built from the rounded 1/exp(x).
assert_eq(m4_get(lorentz_boost_x(0x3FF6666666666666), 1, 0), 0x3FFE7804D9E7541C,
  "boost_x(1.4) sinh entry, correctly rounded (6.6.12: ...541D)");
var l_hy_m = lorentz_boost_x(0xC00A666666666666);   # fl(-3.3)
assert_eq(m4_get(l_hy_m, 0, 0), 0x402B2647145E3E5A,
  "boost_x(-3.3) cosh entry, correctly rounded (6.6.12: ...3E59)");
assert_eq(m4_get(l_hy_m, 1, 0), 0xC02B1364BAA2B89C,
  "boost_x(-3.3) sinh entry, correctly rounded (6.6.12: ...B89B)");
# lorentz_boost_y and lorentz_boost_z make the same two calls; without these four
# pins either could revert to the old formula and every suite would still pass.
# [measured: scratch mutants of lorentz_boost_y/z, not reproducible in-tree, 2026-10-03; cycc 6.6.14]
var l_hy_my = lorentz_boost_y(0xC00A666666666666);
assert_eq(m4_get(l_hy_my, 0, 0), 0x402B2647145E3E5A, "boost_y(-3.3) cosh entry, correctly rounded (6.6.12: ...3E59)");
assert_eq(m4_get(l_hy_my, 2, 0), 0xC02B1364BAA2B89C, "boost_y(-3.3) sinh entry, correctly rounded (6.6.12: ...B89B)");
var l_hy_mz = lorentz_boost_z(0xC00A666666666666);
assert_eq(m4_get(l_hy_mz, 0, 0), 0x402B2647145E3E5A, "boost_z(-3.3) cosh entry, correctly rounded (6.6.12: ...3E59)");
assert_eq(m4_get(l_hy_mz, 3, 0), 0xC02B1364BAA2B89C, "boost_z(-3.3) sinh entry, correctly rounded (6.6.12: ...B89B)");
# From 22 to 709 only a negative rapidity moved; through the general lorentz_boost,
# whose unit x direction multiplies sinh by exactly 1.
var l_hy_g = lorentz_boost(hvec3_unit_x(), 0xC058F33333333333);   # fl(-99.8)
assert_eq(m4_get(l_hy_g, 0, 0), 0x48DF949FE9B1C7E5,
  "lorentz_boost(x, -99.8) cosh entry, correctly rounded (6.6.12: ...C7E6)");
assert_eq(m4_get(l_hy_g, 1, 0), 0xC8DF949FE9B1C7E5,
  "lorentz_boost(x, -99.8) sinh entry, correctly rounded (6.6.12: ...C7E6)");
# Near overflow: one ulp above 709, where e^|x|/2 is 0.5 exp(|x|), and 710.4, past
# exp's own overflow at ~709.78, where it is exp(|x| - 2043 ln 2) 2^2042.
var l_hy_o = lorentz_boost_x(0x4086280000000001);
assert_eq(m4_get(l_hy_o, 0, 1), 0x7FCD422D2BE5E043,
  "boost_x(709 + 1 ulp) sinh entry, correctly rounded (6.6.12: ...E208)");
assert_eq(m4_get(l_hy_o, 0, 0), 0x7FCD422D2BE5E043,
  "boost_x(709 + 1 ulp) cosh entry, correctly rounded (6.6.12: ...E208)");
assert_eq(m4_get(lorentz_boost_x(0x4086333333333333), 0, 0), 0x7FEDA98A7371610B,
  "boost_x(710.4) cosh entry, correctly rounded (6.6.12: ...62D6)");
# PARITY, as the identity: boost_x(-eta) is the inverse boost, so its cosh entry must
# equal boost_x(eta)'s and its sinh entry must be the exact negative. 6.6.12 computed
# both on the signed eta and broke both here by an ulp. Not pinned: the cosh at this
# eta is 0.75 ulp from the truth on 6.6.14 (it was 0.25 on 6.6.12's negative side).
# [measured: scratch harness and Decimal oracle, not reproducible in-tree, 2026-10-03; cycc 6.6.12 and 6.6.14]
var l_hy_e = 0x3FF07289649A1BE6;   # 1.0279630594029583
var l_hy_ep = lorentz_boost_x(l_hy_e);
var l_hy_em = lorentz_boost_x(f64_neg(l_hy_e));
assert_eq(m4_get(l_hy_em, 0, 0), m4_get(l_hy_ep, 0, 0),
  "boost_x(-eta) cosh entry == boost_x(eta)'s, bit for bit (6.6.12: 1 ulp apart)");
assert_eq(m4_get(l_hy_em, 1, 0), f64_neg(m4_get(l_hy_ep, 1, 0)),
  "boost_x(-eta) sinh entry == -boost_x(eta)'s, bit for bit (6.6.12: 1 ulp apart)");
# The same identity over 251 rapidities, fl(3e-8) times fl(1.1) per step up to 668.8:
# 182 below 1, 33 in 1..22, 36 in 22..709. Past 709 both pins work on |x| already.
# The expected count is the population, so an emptied loop fails too. 6.6.12 keeps
# cosh even at 205 of them and sinh odd at 152.
# [measured: scratch harness, not reproducible in-tree, 2026-10-03; cycc 6.6.12 and 6.6.14]
var l_hy_x = 0x3E601B2B29A4692B;   # fl(3e-8)
var l_hy_ce = 0;
var l_hy_so = 0;
var l_hy_p = 0;
var l_hy_q = 0;
while (f64_lt(l_hy_x, 0x4086333333333333) == 1) {   # 710.4
    l_hy_p = lorentz_boost_x(l_hy_x);
    l_hy_q = lorentz_boost_x(f64_neg(l_hy_x));
    if (m4_get(l_hy_q, 0, 0) == m4_get(l_hy_p, 0, 0)) { l_hy_ce = l_hy_ce + 1; }
    if (m4_get(l_hy_q, 1, 0) == f64_neg(m4_get(l_hy_p, 1, 0))) { l_hy_so = l_hy_so + 1; }
    l_hy_x = f64_mul(l_hy_x, 0x3FF199999999999A);   # fl(1.1)
}
assert_eq(l_hy_ce, 251, "cosh entry even bit for bit at all 251 sweep rapidities (6.6.12: 205)");
assert_eq(l_hy_so, 251, "sinh entry odd bit for bit at all 251 sweep rapidities (6.6.12: 152)");

# ================================================================
# DIFFERENTIAL GEOMETRY (~10)
# ================================================================
test_group("diffgeo: flat metric");

# Flat 2D Euclidean: g_inv = diag(1,1), all metric derivs = 0
var dg_metric_inv = alloc(32);
store64(dg_metric_inv, F64_ONE); store64(dg_metric_inv + 8, 0);
store64(dg_metric_inv + 16, 0); store64(dg_metric_inv + 24, F64_ONE);

var dg_deriv = alloc(64);
var _dg_i = 0;
while (_dg_i < 8) { store64(dg_deriv + _dg_i * 8, 0); _dg_i = _dg_i + 1; }

var dg_chris = christoffel_symbols(dg_metric_inv, dg_deriv, 2);
assert_eq(christoffel_get(dg_chris, 2, 0, 0, 0), f64_from(0), "flat Gamma^0_00=0");
assert_eq(christoffel_get(dg_chris, 2, 1, 0, 1), f64_from(0), "flat Gamma^1_01=0");
assert_eq(christoffel_get(dg_chris, 2, 0, 1, 0), f64_from(0), "flat Gamma^0_10=0");
assert_eq(christoffel_get(dg_chris, 2, 1, 1, 1), f64_from(0), "flat Gamma^1_11=0");

# ----------------------------------------------------------------
# christoffel_symbols with a metric that actually CURVES (2.8.3)
#
# Both call sites in the suite (here and tests/hisab.tcyr) passed an all-zero
# metric_deriv array. With d_k g_ij == 0 the bracket d1 + d2 - d3 is 0 for every
# index and the whole formula in christoffel_symbols (src/diffgeo.cyr) -- the
# lambda contraction, the three derivative permutations, the sign on d3, the
# factor 1/2 -- collapses to "return zeros". Replacing the body with
# `store64(out + off, 0)` kept the suite green. The flat-metric assertions above
# are still worth keeping (a Christoffel symbol that is nonzero in flat space is
# a real defect) but they certify only that.

test_group("diffgeo: curved metric");

# (a) UNIT 2-SPHERE, g = diag(1, sin^2 th), coordinates (th, phi), at th = pi/3.
# The only nonvanishing derivative is d_th g_phiphi = 2 sin th cos th = sin(2 th),
# which at th = pi/3 is sqrt(3)/2 exactly (2 cos(pi/3) == 1). Closed forms from
# any textbook, independent of this implementation:
#     Gamma^th_phiphi = -sin th cos th = -sqrt(3)/4
#     Gamma^phi_thphi =  cot th        =  1/sqrt(3)
# and every other component is zero. This exercises g^{a lambda} with a != 0,
# the -d3 term (Gamma^th_phiphi comes from d3 alone) and the +d1 term
# (Gamma^phi_thphi comes from d1 alone).
var _s2_ginv = alloc(32);
store64(_s2_ginv, F64_ONE);                          # g^{th th} = 1
store64(_s2_ginv + 8, 0);
store64(_s2_ginv + 16, 0);
store64(_s2_ginv + 24, 0x3FF5555555555555);          # g^{phi phi} = 1/sin^2(pi/3) = 4/3
var _s2_dg = alloc(64);
var _s2_i = 0;
while (_s2_i < 8) { store64(_s2_dg + _s2_i * 8, 0); _s2_i = _s2_i + 1; }
# metric_deriv[(i*dim + j)*dim + k] = d_k g_ij -> (i,j,k) = (1,1,0) is index 6
store64(_s2_dg + 6 * 8, 0x3FEBB67AE8584CAA);         # d_th g_phiphi = sqrt(3)/2
var _s2_ch = christoffel_symbols(_s2_ginv, _s2_dg, 2);
assert_neq(_s2_ch, 0, "2-sphere: christoffel_symbols allocates");
var _s2_gam011 = 0xBFDBB67AE8584CAA;                 # -sqrt(3)/4 = -0.4330127018922193
var _s2_gam101 = 0x3FE279A74590331D;                 # 1/sqrt(3) =  0.5773502691896258
assert_eq(christoffel_get(_s2_ch, 2, 0, 1, 1), _s2_gam011,
  "2-sphere: Gamma^th_phiphi == -sqrt(3)/4 bit-exact");
assert_eq(f64_lt(f64_abs(f64_sub(christoffel_get(_s2_ch, 2, 1, 0, 1), _s2_gam101)),
    ULP_TOL_M), 1, "2-sphere: Gamma^phi_thphi == cot(pi/3) == 1/sqrt(3)");
assert_eq(f64_lt(f64_abs(f64_sub(christoffel_get(_s2_ch, 2, 1, 1, 0), _s2_gam101)),
    ULP_TOL_M), 1, "2-sphere: Gamma^phi_phith == Gamma^phi_thphi (symmetric in mu,nu)");
assert_eq(christoffel_get(_s2_ch, 2, 0, 0, 0), 0, "2-sphere: Gamma^th_thth == 0");
assert_eq(christoffel_get(_s2_ch, 2, 0, 0, 1), 0, "2-sphere: Gamma^th_thphi == 0");
assert_eq(christoffel_get(_s2_ch, 2, 1, 0, 0), 0, "2-sphere: Gamma^phi_thth == 0");
assert_eq(christoffel_get(_s2_ch, 2, 1, 1, 1), 0, "2-sphere: Gamma^phi_phiphi == 0");

# (b) GENERIC 2-METRIC, every input nonzero and every input DYADIC, so the whole
# contraction stays inside binary floating point and the answer is bit-exact --
# no tolerance, no rounding argument. g^{ij} = [[2, 1/2], [1/2, 3]] (off-diagonal
# nonzero, so the lambda sum is live); d_k g_ij runs over 1/2, 1/4, 3/4, 1/8,
# 5/8, 7/8 with the (i,j) symmetry a metric derivative must have. The eight
# expected values were computed by an independent exact-rational evaluation of
# the published formula (python3 fractions.Fraction), not by this code:
#   Gamma^0 = [[13/16, 13/32], [13/32, -5/32]]   Gamma^1 = [[2, 1], [1, 39/32]]
# Sign-flipping d3, dropping d3, permuting d3's indices or dropping the 1/2 each
# change all EIGHT entries.  (Swapping d1 and d2 is a genuine no-op: the bracket
# is symmetric under mu <-> nu, which is why Gamma is too.)
var _gm_ginv = alloc(32);
store64(_gm_ginv, F64_TWO);                                  # g^{00} = 2
store64(_gm_ginv + 8, F64_HALF);                             # g^{01} = 1/2
store64(_gm_ginv + 16, F64_HALF);                            # g^{10} = 1/2
store64(_gm_ginv + 24, f64_from(3));                         # g^{11} = 3
var _gm_dg = alloc(64);
store64(_gm_dg + 0 * 8, F64_HALF);                           # d_0 g_00 = 1/2
store64(_gm_dg + 1 * 8, 0x3FD0000000000000);                 # d_1 g_00 = 1/4
store64(_gm_dg + 2 * 8, 0x3FE8000000000000);                 # d_0 g_01 = 3/4
store64(_gm_dg + 3 * 8, 0x3FC0000000000000);                 # d_1 g_01 = 1/8
store64(_gm_dg + 4 * 8, 0x3FE8000000000000);                 # d_0 g_10 = 3/4
store64(_gm_dg + 5 * 8, 0x3FC0000000000000);                 # d_1 g_10 = 1/8
store64(_gm_dg + 6 * 8, 0x3FE4000000000000);                 # d_0 g_11 = 5/8
store64(_gm_dg + 7 * 8, 0x3FEC000000000000);                 # d_1 g_11 = 7/8
var _gm_ch = christoffel_symbols(_gm_ginv, _gm_dg, 2);
assert_neq(_gm_ch, 0, "generic metric: christoffel_symbols allocates");
assert_eq(christoffel_get(_gm_ch, 2, 0, 0, 0), 0x3FEA000000000000, "generic: Gamma^0_00 == 13/16");
assert_eq(christoffel_get(_gm_ch, 2, 0, 0, 1), 0x3FDA000000000000, "generic: Gamma^0_01 == 13/32");
assert_eq(christoffel_get(_gm_ch, 2, 0, 1, 0), 0x3FDA000000000000, "generic: Gamma^0_10 == 13/32");
assert_eq(christoffel_get(_gm_ch, 2, 0, 1, 1), 0xBFC4000000000000, "generic: Gamma^0_11 == -5/32");
assert_eq(christoffel_get(_gm_ch, 2, 1, 0, 0), 0x4000000000000000, "generic: Gamma^1_00 == 2");
assert_eq(christoffel_get(_gm_ch, 2, 1, 0, 1), 0x3FF0000000000000, "generic: Gamma^1_01 == 1");
assert_eq(christoffel_get(_gm_ch, 2, 1, 1, 0), 0x3FF0000000000000, "generic: Gamma^1_10 == 1");
assert_eq(christoffel_get(_gm_ch, 2, 1, 1, 1), 0x3FF3800000000000, "generic: Gamma^1_11 == 39/32");

test_group("diffgeo: flat metric (continued)");

# Riemann from flat (all zero christoffel derivs -> all zero riemann)
var dg_chris_deriv = alloc(128);
var _dg_j = 0;
while (_dg_j < 16) { store64(dg_chris_deriv + _dg_j * 8, 0); _dg_j = _dg_j + 1; }
var dg_riemann = riemann_tensor(dg_chris, dg_chris_deriv, 2);
assert_eq(riemann_get(dg_riemann, 2, 0, 0, 0, 1), f64_from(0), "flat Riemann=0");
assert_eq(riemann_get(dg_riemann, 2, 1, 0, 0, 1), f64_from(0), "flat Riemann b=0");

# Ricci tensor (all zero)
var dg_ricci = ricci_tensor(dg_riemann, 2);
assert_eq(ricci_get(dg_ricci, 2, 0, 0), f64_from(0), "flat Ricci=0");

# Ricci scalar = 0
var dg_scalar = ricci_scalar(dg_ricci, dg_metric_inv, 2);
assert_eq(dg_scalar, f64_from(0), "flat scalar=0");

# Einstein tensor (R_mn - 1/2 R g_mn, but R=0 and all R_mn=0 -> 0)
var dg_metric = alloc(32);
store64(dg_metric, F64_ONE); store64(dg_metric + 8, 0);
store64(dg_metric + 16, 0); store64(dg_metric + 24, F64_ONE);
var dg_einstein = einstein_tensor(dg_ricci, dg_metric, dg_metric_inv, 2);
assert_eq(load64(dg_einstein), f64_from(0), "flat Einstein=0");

# ----------------------------------------------------------------
test_group("diffgeo: wedge product");

# alpha=(1,0), beta=(0,1) -> wedge = 1
var dg_alpha = alloc(16);
store64(dg_alpha, F64_ONE); store64(dg_alpha + 8, 0);
var dg_beta = alloc(16);
store64(dg_beta, 0); store64(dg_beta + 8, F64_ONE);
var dg_w = wedge_1_1(dg_alpha, dg_beta, 2);
assert_eq(load64(dg_w), f64_from(1), "wedge e1^e2=1");

# Antisymmetry: alpha ^ alpha = 0
var dg_w2 = wedge_1_1(dg_alpha, dg_alpha, 2);
assert_eq(load64(dg_w2), f64_from(0), "wedge alpha^alpha=0");

# ================================================================
# SYMBOLIC (~15)
# ================================================================
test_group("symbolic: evaluate");

# Evaluate constant
var s_c = expr_const(f64_from(42));
var s_empty = vec_new();
var _eev1t, _eev1v = expr_eval_checked(s_c, s_empty);
assert_eq(_eev1v, f64_from(42), "eval const");

# Evaluate variable
var s_x = expr_var(str_from("x"));
var s_binds = vec_new();
vec_push(s_binds, expr_bind(str_from("x"), f64_from(7)));
var _eev2t, _eev2v = expr_eval_checked(s_x, s_binds);
assert_eq(_eev2v, f64_from(7), "eval var");

# Evaluate x^2 + 3 at x=2 -> 7
var s_x2 = expr_mul(s_x, s_x);
var s_e = expr_add(s_x2, expr_const(f64_from(3)));
var s_binds2 = vec_new();
vec_push(s_binds2, expr_bind(str_from("x"), f64_from(2)));
var _eev3t, _eev3v = expr_eval_checked(s_e, s_binds2);
assert_eq(_eev3v, f64_from(7), "eval x^2+3 at 2");

# Evaluate sin(0) = 0
var s_sin0 = expr_sin(expr_const(0));
var _eev4t, _eev4v = expr_eval_checked(s_sin0, s_empty);
assert_eq(_eev4v, f64_from(0), "eval sin(0)");

# Evaluate exp(0) = 1
var s_exp0 = expr_exp(expr_const(0));
var _eev5t, _eev5v = expr_eval_checked(s_exp0, s_empty);
assert_eq(_eev5v, f64_from(1), "eval exp(0)");

# ----------------------------------------------------------------
test_group("symbolic: differentiate");

# d/dx(const) = 0
var s_dc = expr_diff(expr_const(f64_from(5)), str_from("x"));
var _eev6t, _eev6v = expr_eval_checked(s_dc, s_empty);
assert_eq(_eev6v, f64_from(0), "diff const=0");

# d/dx(x) = 1
var s_dx = expr_diff(expr_var(str_from("x")), str_from("x"));
var _eev7t, _eev7v = expr_eval_checked(s_dx, s_binds2);
assert_eq(_eev7v, f64_from(1), "diff x=1");

# d/dx(x^2) at x=2 -> 4
var s_dx2 = expr_simplify(expr_diff(s_x2, str_from("x")));
var _eev8t, _eev8v = expr_eval_checked(s_dx2, s_binds2);
assert_eq(_eev8v, f64_from(4), "diff x^2 at 2 = 4");

# d/dx(sin(x)) at x=0 -> cos(0) = 1
var s_sin_x = expr_sin(expr_var(str_from("x")));
var s_dsin = expr_simplify(expr_diff(s_sin_x, str_from("x")));
var s_binds0 = vec_new();
vec_push(s_binds0, expr_bind(str_from("x"), 0));
var _eev9t, _eev9v = expr_eval_checked(s_dsin, s_binds0);
assert_eq(_eev9v, f64_from(1), "diff sin at 0 = cos(0)=1");

# d/dx(exp(x)) at x=0 -> exp(0) = 1
var s_exp_x = expr_exp(expr_var(str_from("x")));
var s_dexp = expr_simplify(expr_diff(s_exp_x, str_from("x")));
var _eev10t, _eev10v = expr_eval_checked(s_dexp, s_binds0);
assert_eq(_eev10v, f64_from(1), "diff exp at 0 = 1");

# ----------------------------------------------------------------
test_group("symbolic: simplify");

# 0 + x = x
var s_xv = expr_var(str_from("x"));
var s_zero_plus = expr_add(expr_const(0), s_xv);
var s_sp = expr_simplify(s_zero_plus);
assert_eq(expr_tag(s_sp), EXPR_VAR, "0+x -> var");
# ⛔ 3.3.7 — THE RIGHT-HAND ZERO RULE AND ADD's CONSTANT FOLD WERE UNTESTED: only 0 + x was
# simplified, so `_sym_is_zero(b) == 1` -> `!= 1` survived (seed-336 mutant m0192), which
# keeps x + 0 as an ADD node and returns the LEFT operand of any c1 + c2, dropping c2.
var _mt192_xz = expr_simplify(expr_add(s_xv, expr_const(0)));
assert_eq(expr_tag(_mt192_xz), EXPR_VAR, "x+0 -> var");
var _mt192_cc = expr_simplify(expr_add(expr_const(F64_TWO), expr_const(f64_from(3))));
assert_eq(expr_const_val(_mt192_cc), f64_from(5), "2+3 folds to the constant 5");

# 1 * x = x
var s_one_mul = expr_mul(expr_const(F64_ONE), s_xv);
var s_sp2 = expr_simplify(s_one_mul);
assert_eq(expr_tag(s_sp2), EXPR_VAR, "1*x -> var");

# 0 * x = 0
var s_zero_mul = expr_mul(expr_const(0), s_xv);
var s_sp3 = expr_simplify(s_zero_mul);
assert_eq(expr_tag(s_sp3), EXPR_CONST, "0*x -> const");

# x^0 = 1
var s_pow0 = expr_pow(s_xv, expr_const(0));
var s_sp4 = expr_simplify(s_pow0);
assert_eq(expr_tag(s_sp4), EXPR_CONST, "x^0 -> const");
var _eev11t, _eev11v = expr_eval_checked(s_sp4, s_empty);
assert_eq(_eev11v, f64_from(1), "x^0 = 1");

# x^1 = x
var s_pow1 = expr_pow(s_xv, expr_const(F64_ONE));
var s_sp5 = expr_simplify(s_pow1);
assert_eq(expr_tag(s_sp5), EXPR_VAR, "x^1 -> var");

# --x = x (double negation)
var s_dblneg = expr_neg(expr_neg(s_xv));
var s_sp6 = expr_simplify(s_dblneg);
assert_eq(expr_tag(s_sp6), EXPR_VAR, "--x -> var");

# ----------------------------------------------------------------
test_group("symbolic: to_str");

var s_str_c = expr_to_str(expr_const(f64_from(42)));
assert(str_eq(s_str_c, str_from("42")) == 1, "to_str const 42");

var s_str_v = expr_to_str(expr_var(str_from("y")));
assert(str_eq(s_str_v, str_from("y")) == 1, "to_str var y");

# === 3.3.3 R3c: expr_to_str wraps a leading minus in a power's base and a negation's child ===
test_group("3.3.3 R3c: expr_to_str wraps a leading minus in a power's base and a negation's child");
# Through 3.3.2 a power's base or a negation's child whose text starts with '-' was
# written bare. A base then read as another expression, (-2)^x as "(-2^x)" (minus
# 2^x); a child kept its value but not its form, neg(-3) as "--3", a decrement in
# C-like syntax. sym_to_latex wraps the same positions (3.3.3 W5); for a constant
# and a negation this is its rule in expr_to_str's notation, keyed on the TEXT (a
# variable named "-a" is wrapped here and not there). The 3.3.2 rendering is in
# each message.
# [measured: scratch probe against dist/hisab.cyr 3.3.2, cycc 6.6.12, 2026-10-01]
var r3c_x = expr_var(str_from("x"));
var r3c_y = expr_var(str_from("y"));
var r3c_m3 = expr_const(f64_neg(f64_from(3)));
var r3c_two = expr_const(F64_TWO);
# A power's base, from a constant and from a negation:
assert_eq(str_eq_cstr(expr_to_str(expr_pow(expr_const(f64_neg(F64_TWO)), r3c_x)), "((-2)^x)"), 1,
  "R3c expr_to_str: (-2)^x (3.3.2: (-2^x))");
assert_eq(str_eq_cstr(expr_to_str(expr_pow(expr_neg(r3c_x), r3c_two)), "((-x)^2)"), 1,
  "R3c expr_to_str: neg(x)^2 (3.3.2: (-x^2))");
assert_eq(str_eq_cstr(expr_to_str(expr_pow(r3c_m3, expr_const(f64_neg(F64_ONE)))), "((-3)^-1)"), 1,
  "R3c expr_to_str: (-3)^(-1), the exponent unwrapped (3.3.2: (-3^-1))");
assert_eq(str_eq_cstr(expr_to_str(expr_pow(expr_neg(expr_pow(r3c_x, r3c_two)), r3c_two)), "((-(x^2))^2)"), 1,
  "R3c expr_to_str: neg(x^2)^2, not -(x^2)^2 (3.3.2: (-(x^2)^2))");
assert_eq(str_eq_cstr(expr_to_str(expr_pow(expr_const(0xBFE0000000000000), r3c_x)), "((-0.500000)^x)"), 1,
  "R3c expr_to_str: (-0.5)^x (3.3.2: (-0.500000^x))");
# A negation's child:
assert_eq(str_eq_cstr(expr_to_str(expr_neg(r3c_m3)), "-(-3)"), 1, "R3c expr_to_str: neg(-3) (3.3.2: --3)");
assert_eq(str_eq_cstr(expr_to_str(expr_add(r3c_x, expr_neg(r3c_m3))), "(x + -(-3))"), 1,
  "R3c expr_to_str: x + neg(-3) (3.3.2: (x + --3))");
assert_eq(str_eq_cstr(expr_to_str(expr_neg(expr_neg(r3c_y))), "-(-y)"), 1,
  "R3c expr_to_str: neg(neg(y)) (3.3.2: --y)");
assert_eq(str_eq_cstr(expr_to_str(expr_neg(expr_neg(expr_neg(r3c_x)))), "-(-(-x))"), 1,
  "R3c expr_to_str: neg(neg(neg(x))), every level (3.3.2: ---x)");
assert_eq(str_eq_cstr(expr_to_str(expr_neg(expr_const(0xFFF0000000000000))), "-(-inf)"), 1,
  "R3c expr_to_str: neg(-inf) (3.3.2: --inf)");
assert_eq(str_eq_cstr(expr_to_str(expr_neg(expr_const(0xFFF8000000000000))), "-(-nan)"), 1,
  "R3c expr_to_str: neg(-nan), a sign-bit NaN's text (3.3.2: --nan)");
# The test is the text's first byte: a variable named "-a" is wrapped, -0 ("0") is not,
# and a zero-length name is never read, even when the byte its view points at is '-'.
var r3c_ma = str_from("-a");
assert_eq(str_eq_cstr(expr_to_str(expr_pow(expr_var(r3c_ma), r3c_two)), "((-a)^2)"), 1,
  "R3c expr_to_str: a variable named -a as a base is wrapped (3.3.2: (-a^2))");
assert_eq(str_eq_cstr(expr_to_str(expr_pow(expr_var(str_sub(r3c_ma, 0, 0)), r3c_two)), "(^2)"), 1,
  "R3c expr_to_str: a zero-length base text is not wrapped (unchanged)");
assert_eq(str_eq_cstr(expr_to_str(expr_neg(expr_var(str_sub(r3c_ma, 0, 0)))), "-"), 1,
  "R3c expr_to_str: a zero-length child text is not wrapped (unchanged)");
assert_eq(str_eq_cstr(expr_to_str(expr_pow(expr_const(1 << 63), r3c_x)), "(0^x)"), 1,
  "R3c expr_to_str: (-0)^x, the text 0 has no minus (unchanged)");
assert_eq(str_eq_cstr(expr_to_str(expr_neg(expr_const(1 << 63))), "-0"), 1,
  "R3c expr_to_str: neg(-0) (unchanged)");
# Unchanged: an exponent, a product's or sum's operand, a base or child that starts
# with '(' or a letter.
assert_eq(str_eq_cstr(expr_to_str(expr_pow(r3c_x, r3c_m3)), "(x^-3)"), 1, "R3c expr_to_str: x^(-3) (unchanged)");
assert_eq(str_eq_cstr(expr_to_str(expr_mul(r3c_x, r3c_m3)), "(x * -3)"), 1, "R3c expr_to_str: x * -3 (unchanged)");
assert_eq(str_eq_cstr(expr_to_str(expr_add(r3c_x, r3c_m3)), "(x + -3)"), 1, "R3c expr_to_str: x + -3 (unchanged)");
assert_eq(str_eq_cstr(expr_to_str(expr_neg(expr_add(r3c_x, r3c_y))), "-(x + y)"), 1,
  "R3c expr_to_str: neg(x + y) (unchanged)");
assert_eq(str_eq_cstr(expr_to_str(expr_neg(r3c_x)), "-x"), 1, "R3c expr_to_str: neg(x) (unchanged)");
assert_eq(str_eq_cstr(expr_to_str(expr_pow(expr_pow(r3c_x, r3c_two), r3c_y)), "((x^2)^y)"), 1,
  "R3c expr_to_str: (x^2)^y (unchanged)");
assert_eq(str_eq_cstr(expr_to_str(expr_pow(expr_sin(r3c_m3), r3c_two)), "(sin(-3)^2)"), 1,
  "R3c expr_to_str: sin(-3)^2 (unchanged)");

# ================================================================
# AUTODIFF (~10)
# ================================================================
# --- 2.11.0: every dual_* derivative against central differences ------------
#
# THE CHECK RUN BEFORE ANY REVERSE-MODE CODE WAS WRITTEN, and the fourth release
# running in which that move found defects in shipped code. Reverse mode is
# validated against forward mode, so a wrong dual_* would have been inherited
# wholesale and then "confirmed" by agreement.
#
# ⚠ THE FD SWEEP ALONE FOUND NOTHING, and that is the point worth recording. At
# every input where a guard fires, the perturbed SCALAR is NaN too, so the sample
# is skipped and the guard is never asked. Five defects sat behind guards that no
# amount of finite differencing could reach; they need direct interrogation,
# which is what the block below the sweep does.
var _AD_BAD = 0;
var _AD_RUN = 0;

fn _ad_fd_cmp(analytic, lo, hi, h) {
    if (f64_eq(lo, lo) == 0) { return 0; }         # scalar undefined here
    if (f64_eq(hi, hi) == 0) { return 0; }
    _AD_RUN = _AD_RUN + 1;
    var fd = f64_div(f64_sub(hi, lo), f64_mul(F64_TWO, h));
    var scale = f64_max(F64_ONE, f64_max(f64_abs(analytic), f64_abs(fd)));
    if (f64_lt(f64_abs(f64_sub(analytic, fd)), f64_mul(scale, LOOSE_TOL_M)) == 1) { return 0; }
    return 1;
}

fn _ad_fd_sweep() {
    # ⚠ h is SCALE-RELATIVE. An absolute 1e-6 straddles the kink of abs and the
    # pole of 1/x at small x, which produced two "mismatches" in the first draft
    # that were the fixture's fault, not the code's.
    var pts = alloc(24);
    store64(pts,     F64_TWO);
    store64(pts + 8, f64_div(F64_ONE, F64_TWO));
    store64(pts + 16, f64_div(f64_from(7), f64_from(3)));
    var k = f64_div(f64_from(7), F64_TWO);
    for (var pi = 0; pi < 3; pi = pi + 1) {
        var x = load64(pts + pi * 8);
        var h = f64_mul(f64_abs(x), _JT_H);
        var xl = f64_sub(x, h);
        var xh = f64_add(x, h);
        var v = dual_var(x);
        var c = dual_const(k);
        _AD_BAD = _AD_BAD + _ad_fd_cmp(Dual_deriv(dual_add(v, c)),
          f64_add(xl, k), f64_add(xh, k), h);
        _AD_BAD = _AD_BAD + _ad_fd_cmp(Dual_deriv(dual_sub(v, c)),
          f64_sub(xl, k), f64_sub(xh, k), h);
        _AD_BAD = _AD_BAD + _ad_fd_cmp(Dual_deriv(dual_mul(v, c)),
          f64_mul(xl, k), f64_mul(xh, k), h);
        _AD_BAD = _AD_BAD + _ad_fd_cmp(Dual_deriv(dual_div(v, c)),
          f64_div(xl, k), f64_div(xh, k), h);
        _AD_BAD = _AD_BAD + _ad_fd_cmp(Dual_deriv(dual_div(c, v)),
          f64_div(k, xl), f64_div(k, xh), h);
        _AD_BAD = _AD_BAD + _ad_fd_cmp(Dual_deriv(dual_neg(v)),
          f64_neg(xl), f64_neg(xh), h);
        _AD_BAD = _AD_BAD + _ad_fd_cmp(Dual_deriv(dual_sin(v)), f64_sin(xl), f64_sin(xh), h);
        _AD_BAD = _AD_BAD + _ad_fd_cmp(Dual_deriv(dual_cos(v)), f64_cos(xl), f64_cos(xh), h);
        _AD_BAD = _AD_BAD + _ad_fd_cmp(Dual_deriv(dual_exp(v)), f64_exp(xl), f64_exp(xh), h);
        _AD_BAD = _AD_BAD + _ad_fd_cmp(Dual_deriv(dual_ln(v)), f64_ln(xl), f64_ln(xh), h);
        _AD_BAD = _AD_BAD + _ad_fd_cmp(Dual_deriv(dual_sqrt(v)), f64_sqrt(xl), f64_sqrt(xh), h);
        _AD_BAD = _AD_BAD + _ad_fd_cmp(Dual_deriv(dual_pow(v, k)),
          ganita_f64_pow(xl, k), ganita_f64_pow(xh, k), h);
        _AD_BAD = _AD_BAD + _ad_fd_cmp(Dual_deriv(dual_abs(v)), f64_abs(xl), f64_abs(xh), h);
    }
    return 0;
}

test_group("2.11.0 autodiff: every dual_* derivative matches central differences");
_ad_fd_sweep();
assert_eq(_AD_RUN, 39, "the dual FD sweep ran 13 ops x 3 points and skipped none of them");
assert_eq(_AD_BAD, 0, "every dual_* derivative agrees with a central difference of its own scalar");

# --- 2.11.0: reverse mode against BOTH oracles -------------------------------
#
# f(x0..x3) = x0*x1 + sin(x2)*exp(x3/x0) - sqrt(|x1|) + x2^3
#
# Four inputs, ten ops, and x0 and x1 each feed MORE THAN ONE consumer -- which
# is the part that matters. A chain where every node has one consumer never
# exercises the reverse ACCUMULATION (adjoints summing), and that is the only
# thing the reverse sweep does that forward mode does not.
#
# ⚠ AGREEMENT WITH FORWARD MODE IS NOT SUFFICIENT ON ITS OWN. The two share the
# domain guards, so agreement is partly tautological. Central differences of the
# plain scalar are the independent oracle and are checked alongside.
fn _rv_scalar(x0, x1, x2, x3) {
    var a = f64_mul(x0, x1);
    var b = f64_mul(f64_sin(x2), f64_exp(f64_div(x3, x0)));
    var c = f64_sqrt(f64_abs(x1));
    var d = f64_mul(f64_mul(x2, x2), x2);
    return f64_add(f64_sub(f64_add(a, b), c), d);
}

fn _rv_fwd(x0, x1, x2, x3, which) {
    var d0 = dual_const(x0); var d1 = dual_const(x1);
    var d2 = dual_const(x2); var d3 = dual_const(x3);
    if (which == 0) { d0 = dual_var(x0); }
    if (which == 1) { d1 = dual_var(x1); }
    if (which == 2) { d2 = dual_var(x2); }
    if (which == 3) { d3 = dual_var(x3); }
    var a = dual_mul(d0, d1);
    var b = dual_mul(dual_sin(d2), dual_exp(dual_div(d3, d0)));
    var c = dual_sqrt(dual_abs(d1));
    var d = dual_pow(d2, f64_from(3));
    return Dual_deriv(dual_add(dual_sub(dual_add(a, b), c), d));
}

var _RV_BAD = 0;
var _RV_RUN = 0;

fn _rv_sweep() {
    var xs = alloc(32);
    store64(xs,      f64_div(f64_from(3), F64_TWO));
    store64(xs + 8,  f64_div(f64_from(7), f64_from(4)));
    store64(xs + 16, f64_div(F64_ONE, f64_from(3)));
    store64(xs + 24, f64_div(f64_from(5), f64_from(6)));
    var t = ad_tape_new(64);
    var ids = alloc(32);
    for (var i = 0; i < 4; i = i + 1) { store64(ids + i * 8, ad_var(t, load64(xs + i * 8))); }
    var i0 = load64(ids); var i1 = load64(ids + 8);
    var i2 = load64(ids + 16); var i3 = load64(ids + 24);
    var a = ad_mul(t, i0, i1);
    var b = ad_mul(t, ad_sin(t, i2), ad_exp(t, ad_div(t, i3, i0)));
    var c = ad_sqrt(t, ad_abs(t, i1));
    var d = ad_pow(t, i2, f64_from(3));
    var root = ad_add(t, ad_sub(t, ad_add(t, a, b), c), d);
    var _rv_t, _rv_v = ad_grad(t, root);
    if (is_err_result(_rv_t) == 1) { _RV_BAD = _RV_BAD + 100; return 0; }
    for (var i = 0; i < 4; i = i + 1) {
        _RV_RUN = _RV_RUN + 2;
        var rev = ad_grad_of(t, load64(ids + i * 8));
        var fwd = _rv_fwd(load64(xs), load64(xs + 8), load64(xs + 16), load64(xs + 24), i);
        if (f64_approx_eq(rev, fwd, LOOSE_TOL_M) == 0) { _RV_BAD = _RV_BAD + 1; }
        var h = f64_mul(f64_abs(load64(xs + i * 8)), _JT_H);
        var lo = alloc(32);
        var hi = alloc(32);
        for (var k = 0; k < 4; k = k + 1) {
            store64(lo + k * 8, load64(xs + k * 8));
            store64(hi + k * 8, load64(xs + k * 8));
        }
        store64(lo + i * 8, f64_sub(load64(xs + i * 8), h));
        store64(hi + i * 8, f64_add(load64(xs + i * 8), h));
        var fd = f64_div(f64_sub(
            _rv_scalar(load64(hi), load64(hi + 8), load64(hi + 16), load64(hi + 24)),
            _rv_scalar(load64(lo), load64(lo + 8), load64(lo + 16), load64(lo + 24))),
          f64_mul(F64_TWO, h));
        if (f64_approx_eq(rev, fd, LOOSE_TOL_M) == 0) { _RV_BAD = _RV_BAD + 1; }
    }
    # The VALUE too: a tape that computes the wrong function would still agree
    # with a forward pass over the same wrong function.
    _RV_RUN = _RV_RUN + 1;
    if (f64_approx_eq(ad_val(t, root),
        _rv_scalar(load64(xs), load64(xs + 8), load64(xs + 16), load64(xs + 24)),
        LOOSE_TOL_M) == 0) { _RV_BAD = _RV_BAD + 1; }
    return 0;
}

# --- 2.11.0: the pairing with optimize.cyr, end to end ----------------------
#
# The reason the roadmap gave for reverse mode before 2.11.0: the solvers require a
# caller-supplied gradient, and an n-input objective means writing one by hand or
# running n forward passes. A capturing closure holding a tape matches the
# existing `fncall2(grad, x, out)` signature exactly -- no API change.
#
# ⚠ CHECKED BEFORE ANY OF THIS WAS WRITTEN, and this time it found nothing: all
# four solvers return HSB_ERR_NONE only from `if (f64_lt(gnorm, tol) == 1)`, so a
# 0 return asserts ||grad|| < tol at out_x, and 16 runs across two objectives and
# both gradient sources honoured it. Recorded because a clean result from that
# check is worth as much as a dirty one -- it is the fifth release it has been
# run and the first to come back empty.
#
# ⚠ AND THE POINT OF DRIVING THE SOLVERS WITH BOTH GRADIENTS: checking a solver
# with the same `grad` it was handed cannot see a WRONG grad -- it would converge
# confidently to the wrong point and pass. The hand-written and tape-backed runs
# reaching the same minimiser is what makes the check independent.
var _OPT_TAPE = 0;

fn _ot_f_bowl(x) {
    var a = f64_sub(load64(x), F64_ONE);
    var b = f64_sub(load64(x + 8), F64_TWO);
    return f64_add(f64_mul(a, a), f64_mul(b, b));
}

fn _ot_g_hand(x, out) {
    store64(out, f64_mul(F64_TWO, f64_sub(load64(x), F64_ONE)));
    store64(out + 8, f64_mul(F64_TWO, f64_sub(load64(x + 8), F64_TWO)));
    return 0;
}

# The tape-backed gradient, written as a plain fn here rather than a closure so
# the assertion does not depend on closure support; the closure form is in the
# module header and is what a consumer writes. Both compile to the same call.
fn _ot_g_tape(x, out) {
    ad_tape_reset(_OPT_TAPE);
    var ids = alloc(16);
    var i0 = ad_var(_OPT_TAPE, load64(x));
    var i1 = ad_var(_OPT_TAPE, load64(x + 8));
    store64(ids, i0);
    store64(ids + 8, i1);
    var a = ad_sub(_OPT_TAPE, i0, ad_const(_OPT_TAPE, F64_ONE));
    var b = ad_sub(_OPT_TAPE, i1, ad_const(_OPT_TAPE, F64_TWO));
    var root = ad_add(_OPT_TAPE, ad_mul(_OPT_TAPE, a, a), ad_mul(_OPT_TAPE, b, b));
    # 3.4.1: binds both halves and returns 0, as the module header's recipe does. Through
    # 3.4.0 it returned ad_grad_into's Result, so `&_ot_g_tape` handed the solvers a Result
    # fn as a plain callback, which read only its tag (scripts/check-result-migration.sh).
    var gt, gv = ad_grad_into(_OPT_TAPE, root, ids, 2, out);
    return 0;
}

var _OT_BAD = 0;
var _OT_RUN = 0;

fn _ot_drive(solver, gp, tol) {
    var x0 = alloc(16);
    store64(x0, f64_neg(f64_div(F64_ONE, F64_TWO)));
    store64(x0 + 8, f64_div(f64_from(5), F64_TWO));
    var ox = alloc(16);
    var of = alloc(8);
    # ⚠ 3.0.0 — a dispatch that ASSIGNED each solver's rc into one variable cannot
    # survive the migration as written: `rc = f(...)` drops the payload. Each arm
    # binds both halves and records success in a plain flag, which keeps the
    # sentinel property the `0 - 99` initialiser was there for — an unmatched
    # `solver` still counts as a failure rather than silently passing.
    var ok = 0;
    if (solver == 0) {
        var t0, v0 = opt_gradient_descent(&_ot_f_bowl, gp, x0, 2,
          f64_div(F64_ONE, f64_from(1000)), tol, 200000, ox, of);
        ok = is_ok(t0);
    }
    if (solver == 1) {
        var t1, v1 = opt_conjugate_gradient(&_ot_f_bowl, gp, x0, 2, tol, 200000, ox, of);
        ok = is_ok(t1);
    }
    if (solver == 2) {
        var t2, v2 = opt_bfgs(&_ot_f_bowl, gp, x0, 2, tol, 200000, ox, of);
        ok = is_ok(t2);
    }
    if (solver == 3) {
        var t3, v3 = opt_lbfgs(&_ot_f_bowl, gp, x0, 2, 5, tol, 200000, ox, of);
        ok = is_ok(t3);
    }
    _OT_RUN = _OT_RUN + 1;
    if (ok != 1) { _OT_BAD = _OT_BAD + 1; return 0; }
    # THE SOLVER'S OWN CONTRACT: a 0 return claims ||grad|| < tol at out_x.
    # Bound, not bare: `gp` may be a capturing closure (see the 3.3.1 block below).
    var g = alloc(16);
    var g_rc = fncall2(gp, ox, g);
    var gn = f64_sqrt(f64_add(f64_mul(load64(g), load64(g)),
        f64_mul(load64(g + 8), load64(g + 8))));
    if (f64_lt(gn, tol) != 1) { _OT_BAD = _OT_BAD + 1; return 0; }
    # AND it landed on the known minimiser (1, 2), which the contract alone does
    # not guarantee -- a wrong gradient satisfies its own norm test happily.
    #
    # ⚠ THE TOLERANCE IS DERIVED FROM THE CONTRACT, not picked. For this bowl
    # grad = 2(x - x*), so ||g|| < tol means ||x - x*|| < tol/2. The first draft
    # asserted LOOSE_TOL_M (1e-8) and failed on gradient descent, which stops at
    # ||g|| < 1e-6 and therefore lands 5e-7 away -- exactly as promised. The
    # ASSERTION was wrong, not the solver: it demanded more than the contract
    # offers, and the other three solvers hid that by converging far tighter.
    var want = f64_mul(tol, F64_HALF);
    if (f64_approx_eq(load64(ox), F64_ONE, want) == 0) { _OT_BAD = _OT_BAD + 1; }
    if (f64_approx_eq(load64(ox + 8), F64_TWO, want) == 0) { _OT_BAD = _OT_BAD + 1; }
    return 0;
}

test_group("2.11.0 autodiff x optimize: a tape-backed gradient drives all four solvers");
_OPT_TAPE = ad_tape_new(64);
var ot_tol = F64_ONE;
for (var i = 0; i < 6; i = i + 1) { ot_tol = f64_div(ot_tol, f64_from(10)); }
for (var sv = 0; sv < 4; sv = sv + 1) { _ot_drive(sv, &_ot_g_hand, ot_tol); }
for (var sv = 0; sv < 4; sv = sv + 1) { _ot_drive(sv, &_ot_g_tape, ot_tol); }
assert_eq(_OT_RUN, 8, "four solvers x two gradient sources");
assert_eq(_OT_BAD, 0,
  "every solver converges to (1,2) with a REVERSE-MODE gradient, and honours ||g|| < tol there");

# --- 3.3.1: the header's closure recipe, compiled as written -----------------
#
# The recipe in autodiff.cyr's header is a CAPTURING CLOSURE, and through 3.3.0 no
# test compiled one: `_ot_g_tape` above is a plain fn "so the assertion does not
# depend on closure support". That premise hid two defects. The recipe's
# `return ad_grad_into(...)` would not compile once a helper fn built it and another
# fn bound the helper's result, on any pin 6.6.3-6.6.14. And on cycc 6.6.2-6.6.4 the
# solvers' bare `fncall2(grad, ...);` statements SIGSEGVed with it (exit 139 under 6.6.3).
# [measured: docs/development/issues/archived/2026-10-03-cyrius-closure-stack-return-blamed-on-enclosing-fn.md]
# This builds the closure inside a helper fn, the form that failed to compile,
# exactly as the header now writes it, and drives all four solvers with it. The
# 6.6.2-6.6.4 half cannot be seen from this suite's pin (6.6.20 since 3.3.7); CI's
# bare-`fncall` step is what guards it.
fn _ot_make_closure_grad(tape) {
    var grad = |x, out| {
        ad_tape_reset(tape);
        var ids = alloc(16);
        var i0 = ad_var(tape, load64(x));
        var i1 = ad_var(tape, load64(x + 8));
        store64(ids, i0);
        store64(ids + 8, i1);
        var a = ad_sub(tape, i0, ad_const(tape, F64_ONE));
        var b = ad_sub(tape, i1, ad_const(tape, F64_TWO));
        var root = ad_add(tape, ad_mul(tape, a, a), ad_mul(tape, b, b));
        var gt, gv = ad_grad_into(tape, root, ids, 2, out);
        return 0;
    };
    return grad;
}

# ⚠ The closure is built and bound INSIDE a fn, the way a consumer's main() does.
# That placement is what makes this test able to fail: with the old recipe's
# `return ad_grad_into(...)`, cycc reports `var g = _ot_make_closure_grad(...)`
# inside a fn as an ERROR ("bind both"), but the same bind at top level only as a
# WARNING, which no suite fails on. The first draft bound it at top level and the
# reverted recipe passed all 2323 assertions.
# [measured: CHANGELOG.md 3.3.1 records the reverted recipe passing; 2323 is that release's modules count]
fn _ot_drive_closure_recipe(tol) {
    var grad = _ot_make_closure_grad(ad_tape_new(64));
    for (var sv = 0; sv < 4; sv = sv + 1) { _ot_drive(sv, grad, tol); }
    return 0;
}

test_group("3.3.1 autodiff x optimize: the header's closure recipe, as written");
_OT_RUN = 0;
_OT_BAD = 0;
_ot_drive_closure_recipe(ot_tol);
assert_eq(_OT_RUN, 4, "four solvers driven by the header's closure recipe");
assert_eq(_OT_BAD, 0, "the closure recipe converges to (1,2) in every solver and honours ||g|| < tol there");

# ad_grad_write is the piece that removes a per-variable store64 from every call
# site; it is reached here through ad_grad_into's tail call. Checked against the
# closed-form adjoints of x*y at (3, 5): d/dx = 5 and d/dy = 3.
var ow_t = ad_tape_new(16);
var ow_ids = alloc(16);
var ow_a = ad_var(ow_t, f64_from(3));
var ow_b = ad_var(ow_t, f64_from(5));
store64(ow_ids, ow_a);
store64(ow_ids + 8, ow_b);
var ow_root = ad_mul(ow_t, ow_a, ow_b);
var ow_out = alloc(16);
# ⚠ 3.3.1 — these three sites read only the TAG (Ok = 0, Err = 1) because
# check-result-migration.sh could not see that ad_grad_into returns a Result: it
# has no `return Ok(` of its own, only `?` and a tail call. Both halves now.
var _owt, _owv = ad_grad_into(ow_t, ow_root, ow_ids, 2, ow_out);
assert_eq(is_ok(_owt), 1, "ad_grad_into succeeds");
assert_eq(_owv, 0, "ad_grad_into's Ok payload is 0");
assert(f64_approx_eq(load64(ow_out), f64_from(5), LOOSE_TOL_M),
  "ad_grad_into wrote d(xy)/dx = y = 5 into slot 0");
assert(f64_approx_eq(load64(ow_out + 8), f64_from(3), LOOSE_TOL_M),
  "and d(xy)/dy = x = 3 into slot 1 -- slot ORDER follows the caller's ids, not the tape");

# ⚠ THE FIXTURE ABOVE CANNOT SEE AN `ids` INDIRECTION BUG, and a mutant proved
# it: replacing `ad_grad_of(t, load64(ids + k * 8))` with `ad_grad_of(t, k)`
# survives, because there the variables happen to BE nodes 0 and 1. The whole
# purpose of `ids` is that they need not be. This fixture puts two constants
# first and reverses the order, so ids = {3, 2} and no index coincides with its
# slot.
var oz_t = ad_tape_new(16);
var oz_c1 = ad_const(oz_t, f64_from(9));
var oz_c2 = ad_const(oz_t, f64_from(9));
var oz_y = ad_var(oz_t, f64_from(5));          # node 2
var oz_x = ad_var(oz_t, f64_from(3));          # node 3
assert_eq(oz_x, 3, "the fixture really does put a variable at node 3");
var oz_ids = alloc(16);
store64(oz_ids, oz_x);                          # slot 0 <- node 3
store64(oz_ids + 8, oz_y);                      # slot 1 <- node 2
var oz_out = alloc(16);
var _ozt, _ozv = ad_grad_into(oz_t, ad_mul(oz_t, oz_x, oz_y), oz_ids, 2, oz_out);
assert_eq(is_ok(_ozt), 1, "ad_grad_into on a tape whose variables are not the first nodes");
assert(f64_approx_eq(load64(oz_out), f64_from(5), LOOSE_TOL_M),
  "slot 0 holds d/dx = 5, read through ids -- NOT the adjoint of node 0");
assert(f64_approx_eq(load64(oz_out + 8), f64_from(3), LOOSE_TOL_M),
  "slot 1 holds d/dy = 3, with ids REVERSED relative to tape order");

# ⚠ And ad_grad_into must PROPAGATE the sweep's error rather than writing
# whatever adjoints happen to be lying around. Another surviving mutant: dropping
# the error check on the sweep (an `if (rc != 0) { return rc; }` then, the `?` on
# `ad_grad(...)` since 3.0.0) changed nothing, because nothing called it with a
# bad root.
var oz_bad = alloc(16);
store64(oz_bad, f64_from(77));
store64(oz_bad + 8, f64_from(77));
var _obt, _obv = ad_grad_into(oz_t, AD_FULL, oz_ids, 2, oz_bad);
assert_eq(is_err_result(_obt), 1, "ad_grad_into on a bad root returns the sweep's error");
assert_eq(_obv, HSB_ERR_INVALID_INPUT, "and the payload is ad_grad's own HSB_ERR_INVALID_INPUT, forwarded intact");
assert_eq(load64(oz_bad), f64_from(77),
  "and it wrote NOTHING -- the caller's buffer still holds its own sentinel");

test_group("3.3.5 autodiff: ad_grad_write's n < 0 guard (D081)");
# The guard refuses a negative count. Without it n = -1 skips the loop and returns
# Ok(0) with nothing written, a success for a call that names no variables. n = 0 is a
# valid empty write. Called directly: ad_grad_into reaches it only after a sweep.
var _gwt, _gwv = ad_grad_write(oz_t, oz_ids, 0 - 1, oz_bad);
assert_eq(is_err_result(_gwt), 1, "ad_grad_write: n = -1 is refused");
assert_eq(_gwv, HSB_ERR_INVALID_INPUT, "ad_grad_write: n = -1 -> HSB_ERR_INVALID_INPUT");
assert_eq(load64(oz_bad), f64_from(77), "ad_grad_write: n = -1 writes nothing");
var _g0t, _g0v = ad_grad_write(oz_t, oz_ids, 0, oz_bad);
assert_eq(is_ok(_g0t), 1, "ad_grad_write: n = 0 is an empty write, Ok");
assert_eq(load64(oz_bad), f64_from(77), "ad_grad_write: n = 0 writes nothing");
var _g2t, _g2v = ad_grad_write(oz_t, oz_ids, 2, oz_bad);
assert_eq(is_ok(_g2t), 1, "ad_grad_write: n = 2, called directly");
assert_eq(load64(oz_bad), f64_from(5), "ad_grad_write: slot 0 <- d(xy)/dx = 5, exactly");
assert_eq(load64(oz_bad + 8), f64_from(3), "ad_grad_write: slot 1 <- d(xy)/dy = 3, exactly");

test_group("2.11.0 autodiff reverse mode: gradient matches forward mode AND finite differences");
_rv_sweep();
assert_eq(_RV_RUN, 9, "the reverse sweep compared 4 inputs x 2 oracles, plus the value");
assert_eq(_RV_BAD, 0,
  "one reverse sweep reproduces all four partials, against duals and against central differences");

# A FULL tape must report, not silently drop an operation -- the shape of defect
# this library keeps finding. The error propagates: an op CONSUMING a bad index
# is itself bad, so a caller that checks only the final index is still safe.
var rv_small = ad_tape_new(3);
var rv_a = ad_var(rv_small, F64_ONE);
var rv_b = ad_var(rv_small, F64_TWO);
var rv_c = ad_add(rv_small, rv_a, rv_b);
assert_eq(rv_c, 2, "the third node fits in a tape of capacity 3");
var rv_d = ad_add(rv_small, rv_c, rv_a);
assert_eq(rv_d, AD_FULL, "the fourth returns AD_FULL, not a silently dropped node");
assert_eq(ad_ok(rv_small, rv_d), 0, "and ad_ok rejects it");
assert_eq(ad_mul(rv_small, rv_d, rv_a), AD_FULL, "an op consuming a bad index is itself AD_FULL");
assert_eq(ad_tape_len(rv_small), 3, "and the tape did not grow past its capacity");

# ⚠ ad_grad must clear the WHOLE adjoint array, not just up to `root`. A second
# gradient from a SHORTER root would otherwise read the previous sweep's values
# on every node above it. Asserted because the optimisation is tempting.
var rv_t2 = ad_tape_new(16);
var rv_x = ad_var(rv_t2, f64_from(3));
var rv_y = ad_var(rv_t2, f64_from(5));
var rv_big = ad_mul(rv_t2, rv_x, rv_y);
var rv_top = ad_mul(rv_t2, rv_big, rv_x);          # x^2 * y, d/dx = 2xy = 30
var _rq83t, _rq83v = ad_grad(rv_t2, rv_top);
assert_eq(is_ok(_rq83t), 1, "gradient of the tall root");
assert(f64_approx_eq(ad_grad_of(rv_t2, rv_x), f64_from(30), LOOSE_TOL_M),
  "d/dx of x^2*y at (3,5) is 30");
var _rq84t, _rq84v = ad_grad(rv_t2, rv_big);
assert_eq(is_ok(_rq84t), 1, "now a gradient from a SHORTER root");
assert(f64_approx_eq(ad_grad_of(rv_t2, rv_x), f64_from(5), LOOSE_TOL_M),
  "d/dx of x*y is 5 -- not 30 left over from the previous sweep");
assert_eq(ad_grad_of(rv_t2, rv_top), f64_from(0),
  "and the node ABOVE the new root has adjoint 0, not its stale 1");

# ad_tape_reset lets a caller run many gradients on one tape. The bump allocator
# never frees, so allocating a tape per iteration is a leak, not a style choice.
ad_tape_reset(rv_t2);
assert_eq(ad_tape_len(rv_t2), 0, "ad_tape_reset empties the tape without reallocating");

test_group("2.11.0 autodiff: the guards, asked DIRECTLY (the FD sweep cannot reach them)");
# dual_div: 1/1e-13 = 1e13 is exactly representable. The old guard fired at
# |b| < EPSILON_F64 and fabricated BOTH a value and a derivative.
var ad_e13 = F64_ONE;
for (var i = 0; i < 13; i = i + 1) { ad_e13 = f64_div(ad_e13, f64_from(10)); }
var ad_q = dual_div(dual_const(F64_ONE), dual_var(ad_e13));
assert(f64_approx_eq(f64_div(Dual_val(ad_q), f64_from(10000000000)), f64_from(1000), LOOSE_TOL_M),
  "dual_div: 1/1e-13 is 1e13, not a fabricated 0");
# ln's domain is v > 0. The old guard tested f64_abs(v), so a NEGATIVE passed it
# and dual_ln(-5) came back (NaN, -0.2) -- a NaN value with a CONFIDENT finite
# derivative, which is worse than either alone.
var ad_ln5 = dual_ln(dual_var(f64_neg(f64_from(5))));
assert_eq(Dual_val(ad_ln5), f64_from(0), "dual_ln(-5): value is the miss sentinel, not NaN");
assert_eq(Dual_deriv(ad_ln5), _AD_NAN,
  "dual_ln(-5): ln has no value there, so a NaN derivative, neither -0.2 nor a fabricated 0 (3.4.1 SYM4)");
var ad_ln13 = dual_ln(dual_var(ad_e13));
assert(f64_approx_eq(Dual_val(ad_ln13), f64_neg(f64_div(f64_from(299336), f64_from(10000))),
    f64_div(F64_ONE, f64_from(1000))), "dual_ln(1e-13) is -29.9336, not a fabricated 0");
# sqrt computed s BEFORE its guard, so a negative was already NaN.
var ad_sq = dual_sqrt(dual_var(f64_neg(f64_from(4))));
assert_eq(Dual_val(ad_sq), f64_from(0), "dual_sqrt(-4): value is the miss sentinel, not NaN");
assert_eq(Dual_deriv(ad_sq), _AD_NAN, "dual_sqrt(-4): derivative likewise (3.4.1 SYM4)");
# pow: under ganita 1.0.4 f64_pow was exp(n*ln(base)) and therefore NaN for every
# non-positive base. x^3 is a polynomial and differentiable everywhere.
#
# ⚠ THE PARENTHETICALS THESE TWO ASSERTIONS USED TO CARRY ARE NOW FALSE. They read
# "(f64_pow(0,0) is NaN)" and "(f64_pow rejects negative bases)"; ganita 1.1.4
# (cyrius 6.5.33) fixed both upstream, so an assertion message was asserting
# something about the stdlib that the stdlib had stopped doing. The assertions
# themselves are unchanged and still correct -- since 3.2.2 dual_pow takes ganita's
# pow directly outside three exact IEEE cases (see src/autodiff.cyr).
assert_eq(Dual_deriv(dual_pow(dual_var(0), F64_ONE)), f64_from(1),
  "dual_pow: d/dx x^1 at 0 is 1");
assert_eq(Dual_deriv(dual_pow(dual_var(f64_neg(F64_TWO)), f64_from(3))), f64_from(12),
  "dual_pow: d/dx x^3 at -2 is 12");
assert_eq(Dual_val(dual_pow(dual_var(f64_neg(F64_TWO)), f64_from(4))), f64_from(16),
  "dual_pow: (-2)^4 is 16 by repeated multiplication");
# ⚠ AND THE CONTROL: a case where NaN is the RIGHT answer must still be NaN, or
# the repair has simply replaced one fabrication with another.
assert_eq(f64_eq(Dual_val(dual_pow(dual_var(f64_neg(F64_TWO)), F64_HALF)),
    Dual_val(dual_pow(dual_var(f64_neg(F64_TWO)), F64_HALF))), 0,
  "dual_pow: (-2)^0.5 is still NaN -- the repair did not widen the domain, it fixed the integers");

test_group("2.11.2 stdlib: the f64_pow domain moved under us (ganita 1.0.4 -> 1.1.4)");

# ⚠ THE UPGRADE TO cyrius 6.5.33 CHANGED BEHAVIOUR NO HISAB COMMIT TOUCHED. ganita
# 1.1.4 fixed `f64_pow` upstream -- zero base, zero exponent, and negative base with
# an integral exponent are now special-cased instead of falling into
# `exp(n*ln(base))` and coming back NaN. They are here so the new domain is a
# checked contract: hisab has public entry points sitting directly on it, and a
# silent revert upstream would otherwise reintroduce a NaN nobody was watching for.
#
# ⚠ DISCRIMINATION MEASURED, NOT ASSERTED. The whole group was re-run against a
# checkout still holding ganita 1.0.4: 10 of these 12 assertions FAIL there. The
# two that passed on both sides were the two CONTROLS -- (-2)^0.5 still NaN, and
# the then-loop's (-2)^4 still exactly 16 -- which is what a control is for. A group
# where every line flipped would mean the controls were not controls.
# [measured: 2026-08-21, ganita 1.0.4 vs 1.1.4, same test file]
assert_eq(f64_eq(ganita_f64_pow(f64_neg(F64_TWO), f64_from(3)),
    ganita_f64_pow(f64_neg(F64_TWO), f64_from(3))), 1,
  "ganita_f64_pow(-2,3) is a number, not NaN (was NaN under ganita 1.0.4)");
assert_eq(ganita_f64_pow(f64_neg(F64_TWO), f64_from(3)), 0xC020000000000000,
  "ganita_f64_pow(-2,3) is -8 exactly");
assert_eq(ganita_f64_pow(f64_from(0), f64_from(0)), f64_from(1),
  "ganita_f64_pow(0,0) is 1, the conventional value (was NaN)");
assert_eq(ganita_f64_pow(f64_neg(F64_TWO), f64_from(0)), f64_from(1),
  "ganita_f64_pow(-2,0) is 1 -- x^0 wins over the negative-base case");
# ⚠ AND THE CONTROL, same shape as the one above it: the domain must have widened
# EXACTLY as far as the integers. A non-integral exponent on a negative base has no
# real value and must still be NaN, or upstream replaced one fabrication with another.
assert_eq(f64_eq(ganita_f64_pow(f64_neg(F64_TWO), F64_HALF),
    ganita_f64_pow(f64_neg(F64_TWO), F64_HALF)), 0,
  "ganita_f64_pow(-2,0.5) is still NaN -- the domain widened to the integers, not past them");

# ⭐ ganita's pow is EXACT on a representable integer power -- since 1.2.8 (cyrius
# 6.6.10) through fdlibm's e_pow core, which replaced 1.2.4's binary exponentiation.
# Under ganita 1.1.4 these read 15 and -7 through a truncating `f64_to`; that history
# is in the CHANGELOG (2.11.2, 2.11.3).
# [measured: tests/modules.tcyr, the ganita_f64_pow(-2,4) bit-exact assertion directly below]
assert_eq(ganita_f64_pow(f64_neg(F64_TWO), f64_from(4)), f64_from(16),
  "ganita_f64_pow(-2,4) is BIT-EXACT 16.0");
assert_eq(ganita_f64_pow(F64_TWO, f64_from(10)), f64_from(1024), "ganita_f64_pow(2,10) bit-exact 1024");
assert_eq(ganita_f64_pow(f64_neg(F64_TWO), f64_from(3)), f64_neg(f64_from(8)),
  "ganita_f64_pow(-2,3) bit-exact -8 (was -7 through the exp/ln path)");
assert_eq(ganita_f64_pow(f64_neg(F64_TWO), f64_from(5)), f64_neg(f64_from(32)),
  "ganita_f64_pow(-2,5) bit-exact -32");

test_group("3.2.2 autodiff: dual_pow / ad_pow take ganita's pow, and stop fabricating zeros");

# ⛔ `_ad_pow`'s REPEATED-MULTIPLICATION LOOP IS RETIRED (src/autodiff.cyr says why).
# ganita 1.2.8's pow is within 1 ulp of truth on all 2088 (base, n) pairs of the 3.2.2
# sweep, where the loop was worse on 1110 -- and the loop fabricated zeros. Every
# assertion below goes through a PUBLIC entry point. Reinstating the 3.2.1 loop fails
# the four value assertions in (1) and (2); the tape comparison shares _ad_pow and
# cannot see it, and (3)-(5) hold under either implementation by design -- they pin
# the fast path and the special values, which the loop also got right.
# [measured: scratch mutant, 2026-09-30 -- 2250/2254 with the 3.2.1 loop installed]
#
# (1) Accuracy where the loop was weakest. 0.9^1024 against a 60-digit reference: the
# loop landed 7 ulp out, ganita 1.2.4's binary exponentiation 137, ganita 1.2.8 is
# correctly rounded. Asserted to ganita's documented bound, 1 ulp.
# [measured: CHANGELOG.md 3.2.2 for the 7 and 137 ulp; the assertion below bounds ganita 1.2.8 at 1 ulp]
var apw_b = f64_div(f64_from(9), f64_from(10));
var apw_truth = 0x36346060685B7366;   # 0.9^1024 = 1.394214727062403e-47
assert(_tc_ulp_gap(Dual_val(dual_pow(dual_var(apw_b), f64_from(1024))), apw_truth) <= 1,
  "dual_pow(0.9,1024) is within 1 ulp of truth (the retired loop was 7 out)");

# (2) THE FABRICATED ZERO. For a negative n the loop formed base^|n| and returned its
# reciprocal, so where base^|n| OVERFLOWS but base^n is a representable subnormal it
# returned 0: 201 of 36,864 (base, n) pairs, e.g. 10^-309 .. 10^-323 and 2^-1024.
# [measured: scratch harness, not reproducible in-tree, 2026-09-30]
var apw_ten = f64_from(10);
var apw_sub = 0x000012688B70E62B;     # 10^-310, correctly rounded (a subnormal)
var apw_d310 = dual_pow(dual_var(apw_ten), f64_from(0 - 310));
assert(_tc_ulp_gap(Dual_val(apw_d310), apw_sub) <= 1,
  "dual_pow(10,-310) is 1e-310, not a fabricated 0 (10^310 overflows; 10^-310 does not)");
assert_eq(f64_lt(Dual_deriv(apw_d310), 0), 1,
  "dual_pow(10,-310) derivative is -310 * 10^-311 < 0, not a fabricated -0");
assert_eq(Dual_val(dual_pow(dual_var(F64_TWO), f64_from(0 - 1024))), 0x0004000000000000,
  "dual_pow(2,-1024) is exactly 2^-1024 (a subnormal), not a fabricated 0");
# The tape shares _ad_pow, so the reverse mode agrees with the forward mode bit for bit.
var apw_tp = ad_tape_new(8);
var apw_tx = ad_var(apw_tp, apw_ten);
assert_eq(ad_val(apw_tp, ad_pow(apw_tp, apw_tx, f64_from(0 - 310))), Dual_val(apw_d310),
  "ad_pow(10,-310) matches dual_pow bit for bit");

# (3) The fast path is exact where it is taken: x^2, x^1 and x^-1 are ONE IEEE
# operation, the C99 pow value including the special cases.
# (A mutant returning 1 for x^1 survived the first draft of this block: nothing read
# x^1 or d/dx x^2, which is 2 * x^1. Both are asserted now, and x^-1 on a NEGATIVE
# base, since 1/|x| passed the positive one.)
var apw_x = f64_div(f64_from(7), f64_from(3));
assert_eq(Dual_val(dual_pow(dual_var(apw_x), F64_TWO)), f64_mul(apw_x, apw_x), "dual_pow(x,2) is x*x");
assert_eq(Dual_deriv(dual_pow(dual_var(apw_x), F64_TWO)), f64_mul(F64_TWO, apw_x), "d/dx x^2 is 2x");
assert_eq(Dual_val(dual_pow(dual_var(apw_x), F64_ONE)), apw_x, "dual_pow(x,1) is x");
assert_eq(Dual_val(dual_pow(dual_var(f64_neg(apw_x)), f64_neg(F64_ONE))), f64_div(F64_ONE, f64_neg(apw_x)),
  "dual_pow(-x,-1) is 1/(-x)");
assert_eq(Dual_val(dual_pow(dual_var(0x8000000000000000), f64_neg(F64_ONE))), 0xFFF0000000000000,
  "dual_pow(-0,-1) is -Inf (C99: the sign of the zero survives an odd exponent)");

# (4) THE GUARD THAT FABRICATED 1.0 (2.11.4). The loop truncated n with `f64_to`, and
# below cyrius 6.6.8 x86 returned i64::MIN for 1e300; negating i64::MIN gives it back,
# so a bound checked after the truncation read false, the loop never ran and (-2)^1e300
# came back 1.0 where the answer is +Inf. No loop remains, but the values stay pinned:
# they are the cases a reintroduced integer path would get wrong first.
var apw_huge = 0x7E37E43C8800759C;    # 1e300
assert_eq(Dual_val(dual_pow(dual_var(f64_neg(F64_TWO)), apw_huge)), 0x7FF0000000000000,
  "dual_pow(-2, 1e300) is +Inf, not a fabricated 1.0");
assert_eq(Dual_val(dual_pow(dual_var(f64_neg(F64_TWO)), f64_neg(apw_huge))), 0,
  "dual_pow(-2, -1e300) is +0, not a fabricated 1.0");
assert_eq(Dual_val(dual_pow(dual_var(F64_HALF), apw_huge)), 0,
  "dual_pow(0.5, 1e300) is +0");
assert_eq(Dual_val(dual_pow(dual_var(f64_neg(F64_TWO)), f64_from(4))), f64_from(16),
  "dual_pow(-2,4) is exactly 16");

# (5) pow(0, -1) = +Inf is the IEEE-754 answer (NaN under ganita 1.0.4), and the
# derivative -1 * 0^-2 = -Inf falls, so its sign is not incidental.
assert_eq(Dual_val(dual_pow(dual_var(f64_from(0)), f64_from(0 - 1))), 0x7FF0000000000000,
  "dual_pow(0,-1) is +Inf");
assert_eq(f64_lt(Dual_deriv(dual_pow(dual_var(f64_from(0)), f64_from(0 - 1))), f64_from(0)), 1,
  "dual_pow(0,-1) derivative is -Inf -- d/dx x^-1 falls, so the sign is not incidental");

# ⭐ AND THE PUBLIC SURFACE THAT MOVED WITH IT. symbolic.cyr's expr_eval (expr_eval_checked
# since 3.4.0) calls
# f64_pow directly (src/symbolic.cyr, EXPR_POW branch), so evaluating a negative
# base at an integer power returned NaN for hisab's whole history and returns a
# number now. No test covered it, which is why all 3514 assertions passed on both
# sides of the bump.
# [measured: CHANGELOG.md 2.11.2, "all 3514 assertions passed either side"]
var s_negpow = expr_pow(expr_const(f64_neg(F64_TWO)), expr_const(f64_from(3)));
var s_nobind = 0;
var _snpt, _snpv = expr_eval_checked(s_negpow, s_nobind);
assert_eq(f64_eq(_snpv, _snpv), 1,
  "expr_eval_checked((-2)^3) is a number, not NaN -- hisab public API, changed by the bump");
assert_eq(_snpv, 0xC020000000000000, "expr_eval_checked((-2)^3) is -8 exactly");

test_group("autodiff: x^2");

# f(x) = x^2 at x=3: val=9, deriv=6
var ad_x3 = dual_var(f64_from(3));
var ad_x3_sq = dual_mul(ad_x3, ad_x3);
assert_eq(Dual_val(ad_x3_sq), f64_from(9), "x^2 at 3 val=9");
assert_eq(Dual_deriv(ad_x3_sq), f64_from(6), "x^2 at 3 deriv=6");

# f(x) = x^2 at x=0: val=0, deriv=0
var ad_x0 = dual_var(0);
var ad_x0_sq = dual_mul(ad_x0, ad_x0);
assert_eq(Dual_val(ad_x0_sq), f64_from(0), "x^2 at 0 val=0");
assert_eq(Dual_deriv(ad_x0_sq), 0x8000000000000000,
  "x^2 at 0 deriv=0, a moving zero, stored -0 (3.4.1 SYM2: +0 marks a constant)");

# ----------------------------------------------------------------
test_group("autodiff: sin/cos/exp/ln/sqrt");

# sin(0)=0, deriv=cos(0)=1
var ad_sin0 = dual_sin(dual_var(0));
assert_eq(Dual_val(ad_sin0), f64_from(0), "sin(0) val");
assert_eq(Dual_deriv(ad_sin0), f64_from(1), "sin(0) deriv=cos(0)=1");

# cos(0)=1, deriv=-sin(0)=0 -- NEGATIVE zero since cyrius 6.6.8, whose `f64_neg` is an
# IEEE sign flip (`f64_neg(+0)` was +0 when it computed 0.0 - x); compared as a value.
var ad_cos0 = dual_cos(dual_var(0));
assert_eq(Dual_val(ad_cos0), f64_from(1), "cos(0) val");
assert_eq(f64_eq(Dual_deriv(ad_cos0), 0), 1, "cos(0) deriv=-sin(0)=0 (it is -0.0)");

# exp(0)=1, deriv=exp(0)=1
var ad_exp0 = dual_exp(dual_var(0));
assert_eq(Dual_val(ad_exp0), f64_from(1), "exp(0) val");
assert_eq(Dual_deriv(ad_exp0), f64_from(1), "exp(0) deriv");

# ln(1)=0, deriv=1/1=1
var ad_ln1 = dual_ln(dual_var(F64_ONE));
assert_eq(Dual_val(ad_ln1), f64_from(0), "ln(1) val");
assert_eq(Dual_deriv(ad_ln1), f64_from(1), "ln(1) deriv");

# sqrt(4)=2, deriv=1/(2*2)=0.25
var ad_sqrt4 = dual_sqrt(dual_var(f64_from(4)));
assert_eq(Dual_val(ad_sqrt4), f64_from(2), "sqrt(4) val");
assert_eq(Dual_deriv(ad_sqrt4), 0x3FD0000000000000, "sqrt(4) deriv = 1/(2*2) = 0.25 exactly");

# ----------------------------------------------------------------
test_group("autodiff: composition");

# f(x) = x^2 + 2x at x=3: val = 9+6 = 15, deriv = 2x+2 = 8
var ad_x = dual_var(f64_from(3));
var ad_x_sq = dual_mul(ad_x, ad_x);
var ad_2x = dual_mul(dual_const(F64_TWO), ad_x);
var ad_comp = dual_add(ad_x_sq, ad_2x);
assert_eq(Dual_val(ad_comp), f64_from(15), "x^2+2x at 3 val=15");
assert_eq(Dual_deriv(ad_comp), f64_from(8), "x^2+2x at 3 deriv=8");

# ================================================================
# INTERVAL (~10)
# ================================================================
test_group("interval: arithmetic");

# NOTE: the interval result vars are named iv_sum/iv_diff/iv_prod, NOT
# iv_add/iv_sub/iv_mul. Those three names are RESERVED SIMD intrinsics in cyrius
# (packed integer-vector add/sub/mul) and cannot be used as identifiers, at file
# scope or inside a fn. iv_div/iv_neg are fine (there is no integer-vector
# divide, so iv_div was never reserved). Do NOT rename these back — doing so
# takes this whole suite down at compile time.
#
# The DIAGNOSTIC changed in cyrius 6.5.9 and this note used to quote the old one.
# Re-verified on 6.5.16 (2026-08-09), the message is now:
#   expected identifier, got reserved keyword 'iv_add' (cannot be used as an
#   identifier; rename the variable/field/fn)
# It was `expected identifier, got unknown`, which named nothing. If you are
# reading this after trying the original names and seeing a message that does not
# match, the reservation still stands — check the wording, not the rule.
# See docs/development/issues/archived/2026-07-17-cyrius-interval-ident-lex.md.
var iv_a = ivl_new(f64_from(1), f64_from(3));
var iv_b = ivl_new(f64_from(2), f64_from(4));

# Add: [1,3]+[2,4] = [3,7]
var iv_sum = ivl_add(iv_a, iv_b);
assert_eq(Interval_lo(iv_sum), f64_from(3), "ivl add lo");
assert_eq(Interval_hi(iv_sum), f64_from(7), "ivl add hi");

# Sub: [1,3]-[2,4] = [1-4, 3-2] = [-3, 1]
var iv_diff = ivl_sub(iv_a, iv_b);
assert_eq(Interval_lo(iv_diff), f64_neg(f64_from(3)), "ivl sub lo");
assert_eq(Interval_hi(iv_diff), f64_from(1), "ivl sub hi");

# Mul: [1,3]*[2,4] = [2,12]
var iv_prod = ivl_mul(iv_a, iv_b);
assert_eq(Interval_lo(iv_prod), f64_from(2), "ivl mul lo");
assert_eq(Interval_hi(iv_prod), f64_from(12), "ivl mul hi");

# Div: [1,3]/[2,4] = [1/4, 3/2] = [0.25, 1.5]
var iv_div = ivl_div(iv_a, iv_b);
assert_eq(Interval_lo(iv_div), 0x3FD0000000000000, "ivl div lo = 0.25 exactly");
assert_eq(Interval_hi(iv_div), 0x3FF8000000000000, "ivl div hi = 1.5 exactly");

# ----------------------------------------------------------------
test_group("interval: queries");

assert_eq(ivl_contains(iv_a, f64_from(2)), 1, "ivl contains 2");
assert_eq(ivl_contains(iv_a, f64_from(4)), 0, "ivl not contains 4");
assert_eq(ivl_overlaps(iv_a, iv_b), 1, "ivl overlaps");
assert_eq(ivl_width(iv_a), f64_from(2), "ivl width=2");
assert_eq(ivl_midpoint(iv_a), f64_from(2), "ivl midpoint=2");

# ----------------------------------------------------------------
test_group("interval: neg, abs, sqrt, point");

# Neg: -[1,3] = [-3,-1]
var iv_neg = ivl_neg(iv_a);
assert_eq(Interval_lo(iv_neg), f64_neg(f64_from(3)), "ivl neg lo");
assert_eq(Interval_hi(iv_neg), f64_neg(f64_from(1)), "ivl neg hi");

# Abs: |[-3,1]| = [0,3] (contains 0)
var iv_neg3_1 = ivl_new(f64_neg(f64_from(3)), F64_ONE);
var iv_abs = ivl_abs(iv_neg3_1);
assert_eq(Interval_lo(iv_abs), f64_from(0), "ivl abs lo=0");
assert_eq(Interval_hi(iv_abs), f64_from(3), "ivl abs hi=3");

# Sqrt: sqrt([4,9]) = [2,3]
var iv_49 = ivl_new(f64_from(4), f64_from(9));
var iv_sqrt = ivl_sqrt(iv_49);
assert_eq(Interval_lo(iv_sqrt), f64_from(2), "ivl sqrt lo=2");
assert_eq(Interval_hi(iv_sqrt), f64_from(3), "ivl sqrt hi=3");

# Point interval
var iv_pt = ivl_point(f64_from(5));
assert_eq(ivl_width(iv_pt), f64_from(0), "point width=0");
assert_eq(ivl_midpoint(iv_pt), f64_from(5), "point mid=5");

