# One 1e-6 deep whose gap is 2.1e-4 of the depth, under 2^-10: no polish (38 calls at 2^-13).
# [measured: co2 fixt.py / fixt2.py, exact oracle, 3.3.6, 3.3.7, this tree and the named mutant, 2026-10-31]
var _c37_f2 = _c37_mkbox(hvec3_new(0xBFDFFC2CF7099950, 0x3FE4FE03A9CED6F2, 0x3FD97C401113A338),
  hvec3_new(0x3FFD68248D5834CD, 0x3FE9A6F816E2BAAA, 0x3FFC16F643445B6E),
  hvec3_new(0x3FEF494787DE33FE, 0xBFC85AF04C5986E8, 0xBFB6C3AD5D01BF55),
  hvec3_new(0xBFC44252BE3A7E6A, 0xBFD8E818F1C68CAC, 0xBFED09FB60D84FE7),
  hvec3_new(0x3FC1AC0B106FC142, 0x3FECD7770B1B7F89, 0xBFDA474B66FC0E98));
var _c37_g2 = hvec4_new(0xBFF13DAC42D1C66A, 0x3FEC97EC21096B5E, 0x3FFBC3D65EC1C6C8, 0x3FDA6A570CE18CF6);
_ga_sup_calls = 0;
assert_eq(gjk_epa_3d(&_c37_sup_box, _c37_f2, &_ga_sup_sphere, _c37_g2, _c37_n, _c37_d), 1,
