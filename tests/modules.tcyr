# ----------------------------------------------------------------
test_group("tensor: tensor_add");

var t_shape2 = alloc(16);
store64(t_shape2, 2); store64(t_shape2 + 8, 2);
var t_a = tensor_new(2, t_shape2);
tensor_set2(t_a, 0, 0, f64_from(1));
tensor_set2(t_a, 0, 1, f64_from(2));
tensor_set2(t_a, 1, 0, f64_from(3));
tensor_set2(t_a, 1, 1, f64_from(4));

var t_b = tensor_new(2, t_shape2);
tensor_set2(t_b, 0, 0, f64_from(10));
tensor_set2(t_b, 0, 1, f64_from(20));
tensor_set2(t_b, 1, 0, f64_from(30));
tensor_set2(t_b, 1, 1, f64_from(40));

var t_sum = tensor_add(t_a, t_b);
assert_eq(f64_to(tensor_get2(t_sum, 0, 0)), 11, "tensor_add [0,0]");
assert_eq(f64_to(tensor_get2(t_sum, 0, 1)), 22, "tensor_add [0,1]");
assert_eq(f64_to(tensor_get2(t_sum, 1, 0)), 33, "tensor_add [1,0]");
assert_eq(f64_to(tensor_get2(t_sum, 1, 1)), 44, "tensor_add [1,1]");

# ================================================================
# COLLISION_CORE — contacts, sequential impulse smoke
# ================================================================
# 2.4.x collision-correctness arc COMPLETE — every algorithm audited + covered:
# convex_hull_2d (2.4.0), triangulate_polygon (2.4.1), delaunay_2d (2.4.2),
# half-edge mesh (2.4.3), MPR narrowphase (2.4.4), and sequential_impulse (2.4.5,
# below); solve_pgs is covered in hisab.tcyr. Real bugs were found + fixed in the
# hull sort (2.4.0), MPR (2.4.4), and the impulse solver (2.4.5).
test_group("collision_core: contact_new + accessors");

var c_norm = hvec3_new(0, F64_ONE, 0);
var contact = contact_new(0, 1, c_norm, F64_HALF, F64_HALF, F64_HALF, F64_ONE, F64_ONE);
assert_eq(ColContact_body_a(contact), 0, "ColContact body_a");
assert_eq(ColContact_body_b(contact), 1, "ColContact body_b");
assert_eq(f64_to(ColContact_penetration(contact)), 0, "ColContact penetration (0.5 → f64_to → 0 truncated)");

# MPR narrowphase (2.4.4) — fixed a false-positive: separated shapes used to
# report a hit (missing origin-containment early-out → degenerate colinear
# branch returned 1). Now intersect/penetration are correct for spheres + boxes.
test_group("collision_core: MPR narrowphase");

var mpr_a = hvec4_new(0, 0, 0, F64_TWO);            # sphere r=2 @ origin
var mpr_b_ov = hvec4_new(f64_from(3), 0, 0, F64_TWO);   # dist 3 < 4 → overlap
var mpr_b_sep = hvec4_new(f64_from(5), 0, 0, F64_ONE);  # dist 5 > 3 → separated
var mpr_b_off = hvec4_new(f64_from(5), f64_from(5), 0, F64_ONE);  # off-axis sep

var mpr_ov = mpr_intersect(&_mpr_sup_sphere, mpr_a, &_mpr_sup_sphere, mpr_b_ov);
assert_eq(mpr_ov, 1, "mpr_intersect: spheres overlap");
var mpr_sep = mpr_intersect(&_mpr_sup_sphere, mpr_a, &_mpr_sup_sphere, mpr_b_sep);
assert_eq(mpr_sep, 0, "mpr_intersect: spheres separated (was false +ve)");
var mpr_off = mpr_intersect(&_mpr_sup_sphere, mpr_a, &_mpr_sup_sphere, mpr_b_off);
assert_eq(mpr_off, 0, "mpr_intersect: spheres separated off-axis");

# Penetration: depth = sum_radii − dist. Normal along ±x. Scale by 100 for f64_to.
var mpr_n = alloc(8);
var mpr_d = alloc(8);
var mpr_hit = mpr_penetration(&_mpr_sup_sphere, mpr_a, &_mpr_sup_sphere, mpr_b_ov, mpr_n, mpr_d);
assert_eq(mpr_hit, 1, "mpr_penetration: overlap returns hit");
assert_eq(f64_to(f64_mul(load64(mpr_d), f64_from(100))), 100, "mpr_penetration: depth ~1.0 (4-3)");
# 2.9.0: was assert_eq(f64_to(|nx| * 100), 100). f64_to TRUNCATES, so that read
# "0.99 <= |nx| <= 1.00" -- and it FAILS the moment the normal is right to only
# 15 digits instead of exact, because 0.9999999999 * 100 truncates to 99. The
# depth is now refined to the true MTV, so the normal is a converged direction
# rather than an exact axis; the check below is 1e-9 ABSOLUTE, i.e. seven orders
# of magnitude tighter than the truncation it replaces.
var mpr_nx = f64_abs(HVec3_x(load64(mpr_n)));
assert(f64_approx_eq(mpr_nx, F64_ONE, 0x3E112E0BE826D695),
"mpr_penetration: normal ~±x within 1e-9");

var mpr_b_deep = hvec4_new(F64_ONE, 0, 0, F64_TWO);     # dist 1 → depth 4-1 = 3
var mpr_n2 = alloc(8);
var mpr_d2 = alloc(8);
mpr_penetration(&_mpr_sup_sphere, mpr_a, &_mpr_sup_sphere, mpr_b_deep, mpr_n2, mpr_d2);
assert_eq(f64_to(f64_mul(load64(mpr_d2), f64_from(100))), 300, "mpr_penetration: deep depth ~3.0 (4-1)");

var mpr_n3 = alloc(8);
var mpr_d3 = alloc(8);
var mpr_miss = mpr_penetration(&_mpr_sup_sphere, mpr_a, &_mpr_sup_sphere, mpr_b_sep, mpr_n3, mpr_d3);
assert_eq(mpr_miss, 0, "mpr_penetration: separated returns miss");

# Boxes (axis-aligned): overlap + separated.
var mpr_box_a = _mpr_mkbox(0, 0, 0, F64_ONE, F64_ONE, F64_ONE);
var mpr_box_ov = _mpr_mkbox(F64_ONE, 0, 0, F64_ONE, F64_ONE, F64_ONE);
var mpr_boxov = mpr_intersect(&_mpr_sup_box, mpr_box_a, &_mpr_sup_box, mpr_box_ov);
assert_eq(mpr_boxov, 1, "mpr_intersect: boxes overlap");
var mpr_box_sep = _mpr_mkbox(f64_from(5), 0, 0, F64_ONE, F64_ONE, F64_ONE);
var mpr_boxsep = mpr_intersect(&_mpr_sup_box, mpr_box_a, &_mpr_sup_box, mpr_box_sep);
assert_eq(mpr_boxsep, 0, "mpr_intersect: boxes separated");

# ================================================================
# 2.9.0 -- narrowphase depth against an EXACT reference
# ================================================================
# Every expected value below is a closed form or an exact-rational computation,
# never a previous hisab output:
#   box/box     -- 15-axis OBB SAT evaluated in python3 Fractions
#   sphere/box  -- r - sdBox(centre in box frame, half-extents)
#   sphere/sph  -- r0 + r1 - |c1 - c0|
#   cylinder/box-- independent Nelder-Mead minimisation of the support function
#                  h_M over the unit sphere (no closed form exists)
#
# What each assertion catches, measured against the pre-2.9.0 source:
#   off-axis box/box      mpr 0.0        -> 1.61          (portal plane through
#                                                          the INTERIOR point)
#   MPR-is-not-MTV box    mpr 1.0-ish    -> 0.5           (textbook MPR picks the
#                                                          wrong axis; the error
#                                                          ratio is unbounded)
#   separated pair        mpr hit @ 4.6  -> miss
#   box vs sphere         gjk 2.2e-16    -> 0.8           (degenerate GJK simplex
#                                                          reported "no contact")
#   concentric spheres    gjk 1.8875     -> 2.0           (expansion stalled)
#   scale 1e3             gjk 999.98922  -> 1000.0        (absolute epsilon)
#   near tangency         gjk 4.4114e-5  -> 1e-6
#   cylinder vs OBB       mpr 3.2801     -> 0.19769663
var NP9_TOL = 0x3E112E0BE826D695;   # 1e-9 -- absolute, values here are O(1)

# Oriented box: 15 slots [cx,cy,cz, hx,hy,hz, u0(3), u1(3), u2(3)].
fn _mpr_sup_obb(shape, dir) {
    var acc = hvec3_new(load64(shape), load64(shape + 8), load64(shape + 16));
    for (var oi = 0; oi < 3; oi = oi + 1) {
        var u = hvec3_new(load64(shape + 48 + oi * 24), load64(shape + 56 + oi * 24),
        load64(shape + 64 + oi * 24));
        var hh = load64(shape + 24 + oi * 8);
        if (f64_lt(hvec3_dot(dir, u), 0) == 1) { hh = f64_neg(hh); }
        acc = hvec3_add(acc, hvec3_scale(u, hh));
    }
    return acc;
}

# z-axis cylinder: 5 slots [cx,cy,cz, radius, half_height].
fn _mpr_sup_cyl(shape, dir) {
    var acc = hvec3_new(load64(shape), load64(shape + 8), load64(shape + 16));
    var pl = f64_sqrt(f64_add(f64_mul(HVec3_x(dir), HVec3_x(dir)),
    f64_mul(HVec3_y(dir), HVec3_y(dir))));
    if (f64_gt(pl, 0) == 1) {
        var sc = f64_div(load64(shape + 24), pl);
        acc = hvec3_add(acc, hvec3_new(f64_mul(HVec3_x(dir), sc),
        f64_mul(HVec3_y(dir), sc), 0));
    }
    var hz = load64(shape + 32);
    if (f64_lt(HVec3_z(dir), 0) == 1) { hz = f64_neg(hz); }
    return hvec3_add(acc, hvec3_new(0, 0, hz));
}

fn _mpr_mkobb(cx, cy, cz, hx, hy, hz) {
    var s = alloc(120);
    store64(s, cx);
    store64(s + 8, cy);
    store64(s + 16, cz);
    store64(s + 24, hx);
    store64(s + 32, hy);
    store64(s + 40, hz);
    for (var oi = 0; oi < 9; oi = oi + 1) { store64(s + 48 + oi * 8, 0); }
    store64(s + 48, F64_ONE);
    store64(s + 80, F64_ONE);
    store64(s + 112, F64_ONE);
    return s;
}

fn _mpr_obb_axis(s, i, x, y, z) {
    store64(s + 48 + i * 24, x);
    store64(s + 56 + i * 24, y);
    store64(s + 64 + i * 24, z);
    return 0;
}

# Depth of one narrowphase call; mode 0 = gjk_epa_3d, 1 = mpr_penetration.
# Returns -inf on a reported miss so a miss can never pass an approx-equality.
fn _np9_depth(fa, sa, fb, sb, mode) {
    var nn = alloc(8);
    var dd = alloc(8);
    store64(dd, 0);
    var r = gjk_epa_3d(fa, sa, fb, sb, nn, dd);
    if (mode == 1) { r = mpr_penetration(fa, sa, fb, sb, nn, dd); }
    if (r != 1) { return _COL_F64_NEG_INF; }
    return load64(dd);
}

test_group("collision_core: narrowphase depth == exact MTV (2.9.0)");

var np9_pn_n = alloc(8);
var np9_pn_d = alloc(8);
var np9_pn_n2 = alloc(8);
var np9_pn_d2 = alloc(8);

# --- off-axis box/box. Unit boxes, offset (0.3, 0, -0.39).
# Minkowski difference = box centred (-0.3, 0, 0.39) with half-extents 2, so the
# MTV is min(2-0.3, 2-0, 2-0.39) = 1.61 on the z axis. The shipped code reported
# 0.0: it measured the plane through v0, the INTERIOR point.
var np9_bb_a = _mpr_mkbox(0, 0, 0, F64_ONE, F64_ONE, F64_ONE);
var np9_bb_b = _mpr_mkbox(f64_div(f64_from(3), f64_from(10)), 0,
f64_neg(f64_div(f64_from(39), f64_from(100))), F64_ONE, F64_ONE, F64_ONE);
var np9_bb_exp = f64_div(f64_from(161), f64_from(100));   # 1.61 exactly
assert_eq(mpr_penetration(&_mpr_sup_box, np9_bb_a, &_mpr_sup_box, np9_bb_b, np9_pn_n, np9_pn_d), 1,
"mpr_penetration: off-axis boxes report a hit");
assert(f64_approx_eq(load64(np9_pn_d), np9_bb_exp, NP9_TOL),
"mpr_penetration: off-axis box/box depth == 1.61 exact SAT (was 0.0)");
assert(f64_approx_eq(f64_abs(HVec3_z(load64(np9_pn_n))), F64_ONE, NP9_TOL),
"mpr_penetration: off-axis box/box normal is the z axis");
assert_eq(gjk_epa_3d(&_mpr_sup_box, np9_bb_a, &_mpr_sup_box, np9_bb_b, np9_pn_n2, np9_pn_d2), 1,
"gjk_epa_3d: off-axis boxes report a hit");
assert(f64_approx_eq(load64(np9_pn_d2), np9_bb_exp, NP9_TOL),
"gjk_epa_3d: off-axis box/box depth == 1.61 exact SAT");

# The unit normal really is a unit vector (the old code stored a portal normal
# built from a cross product it never renormalised on the fallback path).
assert(f64_approx_eq(hvec3_length(load64(np9_pn_n)), F64_ONE, NP9_TOL),
"mpr_penetration: normal is unit length");

# --- MPR's OWN answer is not the MTV, and this fixture pins the difference.
# A and B are 0.5 x 5 x 5 boxes, B offset (0.5, 9, 0). The difference is a box
# centred (-0.5, -9, 0) with half-extents (1, 10, 10): textbook MPR leaves
# through the axis maximising |c_i|/h_i (y: 0.9) and reports 10-9 = 1.0, while
# the MTV is on the axis minimising h_i-|c_i| (x) and equals 0.5. Stretching the
# y extent makes that ratio arbitrarily large, which is why the depth is refined
# rather than read off the portal.
var np9_mv_h = f64_div(F64_ONE, F64_TWO);
var np9_mv_a = _mpr_mkbox(0, 0, 0, np9_mv_h, f64_from(5), f64_from(5));
var np9_mv_b = _mpr_mkbox(np9_mv_h, f64_from(9), 0, np9_mv_h, f64_from(5), f64_from(5));
assert_eq(mpr_penetration(&_mpr_sup_box, np9_mv_a, &_mpr_sup_box, np9_mv_b, np9_pn_n, np9_pn_d), 1,
"mpr_penetration: anisotropic boxes report a hit");
assert(f64_approx_eq(load64(np9_pn_d), np9_mv_h, NP9_TOL),
"mpr_penetration: depth is the MTV 0.5, not MPR's own portal answer 1.0");
assert(f64_approx_eq(f64_abs(HVec3_x(load64(np9_pn_n))), F64_ONE, NP9_TOL),
"mpr_penetration: anisotropic MTV normal is the x axis, not y");
gjk_epa_3d(&_mpr_sup_box, np9_mv_a, &_mpr_sup_box, np9_mv_b, np9_pn_n2, np9_pn_d2);
assert(f64_approx_eq(load64(np9_pn_d2), np9_mv_h, NP9_TOL),
"gjk_epa_3d: anisotropic box/box depth == MTV 0.5");

# --- SEPARATED must be a miss. Half-extents (1,10,10) at the origin against a
# 1e-9 box at (1.4, 0.5, 0.1): the x gap is 0.4. The shipped code returned 1
# with depth 4.6063.
var np9_sep_a = _mpr_mkbox(0, 0, 0, F64_ONE, f64_from(10), f64_from(10));
var np9_sep_tiny = f64_div(F64_ONE, f64_from(1000000000));
var np9_sep_b = _mpr_mkbox(f64_div(f64_from(14), f64_from(10)), f64_div(F64_ONE, F64_TWO),
f64_div(F64_ONE, f64_from(10)), np9_sep_tiny, np9_sep_tiny, np9_sep_tiny);
assert_eq(mpr_penetration(&_mpr_sup_box, np9_sep_a, &_mpr_sup_box, np9_sep_b, np9_pn_n, np9_pn_d), 0,
"mpr_penetration: separated anisotropic pair is a miss (was hit @ 4.6063)");
assert_eq(gjk_epa_3d(&_mpr_sup_box, np9_sep_a, &_mpr_sup_box, np9_sep_b, np9_pn_n2, np9_pn_d2), 0,
"gjk_epa_3d: separated anisotropic pair is a miss");

# --- box vs sphere, BOX FIRST. r - sdBox((1.2,0,0.7), (1,1,1)) = 1 - 0.2 = 0.8.
# Order matters to GJK's direction sequence: this ordering produced a degenerate
# simplex, which the shipped code answered with 2.2e-16.
var np9_bs_box = _mpr_mkbox(0, 0, 0, F64_ONE, F64_ONE, F64_ONE);
var np9_bs_sph = hvec4_new(f64_div(f64_from(12), f64_from(10)), 0,
f64_div(f64_from(7), f64_from(10)), F64_ONE);
var np9_bs_exp = f64_div(f64_from(8), f64_from(10));
assert_eq(gjk_epa_3d(&_mpr_sup_box, np9_bs_box, &_mpr_sup_sphere, np9_bs_sph, np9_pn_n2, np9_pn_d2), 1,
"gjk_epa_3d: box-then-sphere reports a hit");
assert(f64_approx_eq(load64(np9_pn_d2), np9_bs_exp, NP9_TOL),
"gjk_epa_3d: box vs sphere depth == 0.8 = r - sdBox (was 2.2e-16)");
mpr_penetration(&_mpr_sup_box, np9_bs_box, &_mpr_sup_sphere, np9_bs_sph, np9_pn_n, np9_pn_d);
assert(f64_approx_eq(load64(np9_pn_d), np9_bs_exp, NP9_TOL),
"mpr_penetration: box vs sphere depth == 0.8 (was -1.3964)");

# --- concentric unit spheres. Depth = r0 + r1 = 2 exactly. This is the case the
# expansion could not converge on (1.8875 at 64 iterations, 1.9794 at 400) and
# the case where the MPR portal degenerates onto its own v0-v1 edge (0.0).
var np9_cc_a = hvec4_new(0, 0, 0, F64_ONE);
var np9_cc_b = hvec4_new(0, 0, 0, F64_ONE);
assert(f64_approx_eq(_np9_depth(&_mpr_sup_sphere, np9_cc_a, &_mpr_sup_sphere, np9_cc_b, 0),
F64_TWO, NP9_TOL), "gjk_epa_3d: concentric unit spheres depth == 2.0 (was 1.8875)");
assert(f64_approx_eq(_np9_depth(&_mpr_sup_sphere, np9_cc_a, &_mpr_sup_sphere, np9_cc_b, 1),
F64_TWO, NP9_TOL), "mpr_penetration: concentric unit spheres depth == 2.0 (was 0.0)");

# --- SCALE INVARIANCE. r=2 spheres 3 apart -> depth 1, the identical geometry at
# 1e-3 / 1e3 / 1e6 -> depth 1e-3 / 1e3 / 1e6. The convergence test used to be an
# ABSOLUTE 1e-12, so the same shape at a different scale gave a different answer
# (1.078e-5 relative at every scale away from 1).
for (var sk = 0; sk < 3; sk = sk + 1) {
    var kf = F64_ONE;
    if (sk == 0) { kf = f64_div(F64_ONE, f64_from(1000)); }
    if (sk == 2) { kf = f64_from(1000000); }
    if (sk == 1) { kf = f64_from(1000); }
    var sc_a = hvec4_new(0, 0, 0, f64_mul(F64_TWO, kf));
    var sc_b = hvec4_new(f64_mul(f64_from(3), kf), 0, 0, f64_mul(F64_TWO, kf));
    var sc_got = _np9_depth(&_mpr_sup_sphere, sc_a, &_mpr_sup_sphere, sc_b, 0);
    assert(f64_approx_eq(f64_div(sc_got, kf), F64_ONE, f64_div(F64_ONE, f64_from(1000000))),
    "gjk_epa_3d: sphere depth is scale-invariant (relative, not absolute, tolerance)");
    var sc_got2 = _np9_depth(&_mpr_sup_sphere, sc_a, &_mpr_sup_sphere, sc_b, 1);
    assert(f64_approx_eq(f64_div(sc_got2, kf), F64_ONE, f64_div(F64_ONE, f64_from(1000000))),
    "mpr_penetration: sphere depth is scale-invariant");
}

# --- SCALE INVARIANCE, CARRIED DOWN TO k = 1e-9. The loop above stops at 1e-3,
# which is ABOVE the scale at which gjk_epa_3d's two scale-sensitive mechanisms
# start to matter, so both of them were live and unpinned. Measured on the 2.9.0
# tree by mutating each one and re-running THIS geometry:
#   * _epa_seed_gjk's "2" return -- "the origin is enclosed but the simplex is
#     not a usable seed, fall back to the portal". Returning 0 instead routes the
#     call into _epa_touch_probe, which certifies a depth-0 TOUCH: at k = 1e-7,
#     1e-8 and 1e-9 gjk_epa_3d then reports a hit whose depth is 0 instead of k
#     and whose normal is +z instead of the line of centres. mpr_penetration is
#     untouched by that mutation -- it seeds itself -- so the sweep runs both
#     siblings and it is the gjk_epa_3d half that pins the fallback.
#   * the RELATIVE convergence tolerance. An ABSOLUTE one (EPSILON_F64) stops
#     early down here: depth/k comes back 1.0000725 at k = 1e-8 and 1.000668 at
#     k = 1e-9 (7.3e-5 and 6.7e-4 relative), with the normal 6.8e-3 and 2.1e-2
#     off the x axis. The shipped code holds depth/k to 1e-12 and the normal to
#     1e-11 at every one of these scales, so 1e-6 is ~700x clear of the noise.
# The NORMAL is the load-bearing half: at k = 1e-7 the absolute tolerance still
# gets the depth right and only the direction gives it away.
var ns9_n = alloc(8);
var ns9_d = alloc(8);
var NS9_TOL = f64_div(F64_ONE, f64_from(1000000));   # 1e-6, relative
for (var ns_k = 7; ns_k < 10; ns_k = ns_k + 1) {
    var ns_kf = F64_ONE;
    for (var ns_e = 0; ns_e < ns_k; ns_e = ns_e + 1) { ns_kf = f64_div(ns_kf, f64_from(10)); }
    var ns_a = hvec4_new(0, 0, 0, f64_mul(F64_TWO, ns_kf));
    var ns_b = hvec4_new(f64_mul(f64_from(3), ns_kf), 0, 0, f64_mul(F64_TWO, ns_kf));
    for (var ns_m = 0; ns_m < 2; ns_m = ns_m + 1) {
        store64(ns9_d, 0);
        store64(ns9_n, hvec3_zero());
        var ns_r = gjk_epa_3d(&_mpr_sup_sphere, ns_a, &_mpr_sup_sphere, ns_b, ns9_n, ns9_d);
        if (ns_m == 1) {
            ns_r = mpr_penetration(&_mpr_sup_sphere, ns_a, &_mpr_sup_sphere, ns_b, ns9_n, ns9_d);
        }
        assert_eq(ns_r, 1, "narrowphase: r=2k spheres 3k apart report a hit down to k = 1e-9");
        assert(f64_approx_eq(f64_div(load64(ns9_d), ns_kf), F64_ONE, NS9_TOL),
        "narrowphase: depth == k down to k = 1e-9 (a seed fallback that bails answers 0)");
        assert(f64_lt(hvec3_length(hvec3_cross(load64(ns9_n), hvec3_unit_x())), NS9_TOL) == 1,
        "narrowphase: micro-scale normal is the line of centres (an absolute tolerance loses it)");
    }
}

# --- NEAR TANGENCY. r=2 spheres 3.999999 apart -> depth 1e-6. The shipped code
# answered 4.4114e-5, a 43x over-report, because it stopped refining direction
# long before the depth mattered.
var np9_tg_a = hvec4_new(0, 0, 0, F64_TWO);
var np9_tg_b = hvec4_new(f64_sub(f64_from(4), f64_div(F64_ONE, f64_from(1000000))), 0, 0, F64_TWO);
var np9_tg_exp = f64_div(F64_ONE, f64_from(1000000));
var np9_tg_tol = f64_div(F64_ONE, f64_from(1000000000000));
assert(f64_approx_eq(_np9_depth(&_mpr_sup_sphere, np9_tg_a, &_mpr_sup_sphere, np9_tg_b, 0),
np9_tg_exp, np9_tg_tol), "gjk_epa_3d: near-tangent spheres depth == 1e-6 (was 4.4114e-5)");
assert(f64_approx_eq(_np9_depth(&_mpr_sup_sphere, np9_tg_a, &_mpr_sup_sphere, np9_tg_b, 1),
np9_tg_exp, np9_tg_tol), "mpr_penetration: near-tangent spheres depth == 1e-6");

# --- THE MANDATORY CYLINDER vs ROTATED-BOX FIXTURE (roadmap 2.8.2).
# A z-axis cylinder r=1.8793535667752475, half-height=1.2791168772746317 at the
# origin against an OBB. The roadmap records this reproducer's exact depth as
# 0.19783922047988; that number is WRONG -- it came from a coarse spherical grid
# search. An independent Nelder-Mead minimisation of h_M over the unit sphere,
# multi-started from a 200k-point Fibonacci lattice, converges to
# 0.19769663486454, and hisab's own answer 0.19769663487882 is a CERTIFIED upper
# bound on the MTV (it is h_M evaluated at a real direction), so the true value
# cannot exceed it. Both agree to 7.2e-11 relative. The shipped mpr_penetration
# returned 3.2801295 here.
var np9_cy_s = alloc(40);
store64(np9_cy_s, 0);
store64(np9_cy_s + 8, 0);
store64(np9_cy_s + 16, 0);
store64(np9_cy_s + 24, 0x3FFE11D50BAEBAF1);   # radius      1.8793535667752475
store64(np9_cy_s + 32, 0x3FF47743423A7FC0);   # half-height 1.2791168772746317
var np9_cy_b = _mpr_mkobb(0x4005732F92CFB63E, 0xC006EB1792881994, 0xBFFF55B8C5B1A9C0,
0x3FFE93DAB8D7F5D9, 0x3FFAE1DE4A99CE2F, 0x3FF3482F05E60E8C);
_mpr_obb_axis(np9_cy_b, 0, 0x3FEF2D85DD7338A3, 0xBFCBFD941B69FBE9, 0x3FAB9A84DBCB55FA);
_mpr_obb_axis(np9_cy_b, 1, 0x3FCCC1C7CD456741, 0x3FEDA7F420E83330, 0xBFD34519497EDB0B);
_mpr_obb_axis(np9_cy_b, 2, 0x3F90423091D65D37, 0x3FD38CCD2BAACD4D, 0x3FEE775ADA949BF9);
var np9_cy_exp = 0x3FC94E1F92A2E068;          # 0.1976966348645448
var np9_cy_tol = f64_div(F64_ONE, f64_from(100000000));   # 1e-8 absolute
assert_eq(mpr_penetration(&_mpr_sup_cyl, np9_cy_s, &_mpr_sup_obb, np9_cy_b, np9_pn_n, np9_pn_d), 1,
"mpr_penetration: cylinder vs rotated OBB reports a hit");
assert(f64_approx_eq(load64(np9_pn_d), np9_cy_exp, np9_cy_tol),
"mpr_penetration: cylinder vs rotated OBB depth == 0.19769663 (was 3.2801295)");
assert_eq(gjk_epa_3d(&_mpr_sup_cyl, np9_cy_s, &_mpr_sup_obb, np9_cy_b, np9_pn_n2, np9_pn_d2), 1,
"gjk_epa_3d: cylinder vs rotated OBB reports a hit");
assert(f64_approx_eq(load64(np9_pn_d2), np9_cy_exp, np9_cy_tol),
"gjk_epa_3d: cylinder vs rotated OBB depth == 0.19769663");
# The two siblings carry the same documented contract, so they must agree.
assert(f64_approx_eq(load64(np9_pn_d), load64(np9_pn_d2), np9_cy_tol),
"mpr_penetration and gjk_epa_3d agree on the cylinder fixture");

# --- THE INVARIANT A WRONG ANSWER CANNOT SATISFY: translating B by
# depth * normal must SEPARATE the pair. This does not compare against any
# reference value at all -- it re-runs the overlap test on the corrected pose.
var np9_iv_box_a = _mpr_mkbox(0, 0, 0, F64_ONE, F64_ONE, F64_ONE);
var np9_iv_box_b = _mpr_mkbox(f64_div(f64_from(3), f64_from(10)), 0,
f64_neg(f64_div(f64_from(39), f64_from(100))), F64_ONE, F64_ONE, F64_ONE);
mpr_penetration(&_mpr_sup_box, np9_iv_box_a, &_mpr_sup_box, np9_iv_box_b, np9_pn_n, np9_pn_d);
var np9_iv_push = f64_mul(load64(np9_pn_d), f64_div(f64_from(1000001), f64_from(1000000)));
var np9_iv_nrm = load64(np9_pn_n);
var np9_iv_moved = _mpr_mkbox(f64_add(load64(np9_iv_box_b), f64_mul(HVec3_x(np9_iv_nrm), np9_iv_push)),
f64_add(load64(np9_iv_box_b + 8), f64_mul(HVec3_y(np9_iv_nrm), np9_iv_push)),
f64_add(load64(np9_iv_box_b + 16), f64_mul(HVec3_z(np9_iv_nrm), np9_iv_push)),
F64_ONE, F64_ONE, F64_ONE);
assert_eq(mpr_intersect(&_mpr_sup_box, np9_iv_box_a, &_mpr_sup_box, np9_iv_moved), 0,
"mpr_penetration: translating B by depth*normal separates the pair");
# ... and translating by 1% LESS must NOT separate it, so the depth is tight and
# not merely large enough.
var np9_iv_short = f64_mul(load64(np9_pn_d), f64_div(f64_from(99), f64_from(100)));
var np9_iv_near = _mpr_mkbox(f64_add(load64(np9_iv_box_b), f64_mul(HVec3_x(np9_iv_nrm), np9_iv_short)),
f64_add(load64(np9_iv_box_b + 8), f64_mul(HVec3_y(np9_iv_nrm), np9_iv_short)),
f64_add(load64(np9_iv_box_b + 16), f64_mul(HVec3_z(np9_iv_nrm), np9_iv_short)),
F64_ONE, F64_ONE, F64_ONE);
assert_eq(mpr_intersect(&_mpr_sup_box, np9_iv_box_a, &_mpr_sup_box, np9_iv_near), 1,
"mpr_penetration: 99% of the depth does NOT separate -- the depth is tight");

# --- ARENA BOUND. A narrowphase call must not scale its allocation with the
# iteration count: the pre-2.9.0 expansion allocated a fresh 16-byte record for
# every face on every pass and rebuilt two vecs per pass.
#
# 2.9.0: both bounds were 256 KB against true values of 51 KB and 22 KB — 5x
# and 11.5x headroom, which is far above the defect scale. Re-adding an
# alloc(80) per face per iteration (the SHAPE of the pre-2.9.0 per-face record)
# passed both. Measured on this tree, and IDENTICAL on five consecutive runs —
# alloc_used() over a fixed code path has no run-to-run variation, so the
# margins below are chosen against future legitimate change, not against noise:
#   gjk_epa_3d  52,272 B -> bound 65,536 (25.4% headroom); injection reads
#               108,272, i.e. 65% over the bound.
#   mpr_penetration 22,776 B -> bound 25,600 (12.4% headroom); injection reads
#               25,656 -- it clears the bound by only 56 B. This fixture runs
#               few enough iterations that the leak is worth only +12.6% here,
#               so 25,600 is the LOOSEST bound that still sees it at all; that
#               is why this margin is thinner than the others.
#
# 2.9.1: THE THIN BOUND IS NOT REPAIRED BY A TIGHTER NUMBER. 0.22% of detection
# margin is a coin flip against any differently-shaped partial regression, and
# tightening 25,600 only trades that for false alarms on legitimate change. The
# fix is a fixture with MORE ITERATIONS -- see the mpr_penetration sphere-pair
# budget added beside the gjk_epa_3d one further down this file, where the same
# injection overshoots its bound by 123% instead of 0.22%. This absolute bound is
# KEPT as-is: it still guards the polytope regime, which the sphere pair does
# not exercise, and it is the row that carries the historical 22 KB figure.
# The baseline moved 22,752 -> 22,776 in 2.9.1: mpr_penetration now writes a
# placeholder normal on every path, and hvec3_unit_x() allocates one HVec3.
var np9_ar_before = alloc_used();
gjk_epa_3d(&_mpr_sup_cyl, np9_cy_s, &_mpr_sup_obb, np9_cy_b, np9_pn_n2, np9_pn_d2);
var np9_ar_used = alloc_used() - np9_ar_before;
assert_lt(np9_ar_used, 65536, "gjk_epa_3d: arena per call stays under 64 KB (52,272 B)");
var np9_ar_before2 = alloc_used();
mpr_penetration(&_mpr_sup_box, np9_bb_a, &_mpr_sup_box, np9_bb_b, np9_pn_n, np9_pn_d);
assert_lt(alloc_used() - np9_ar_before2, 25600,
"mpr_penetration: arena per call stays under 25 KB (22,776 B)");

# sequential_impulse (2.4.5) — fixed: the normal impulse was computed with the
# wrong sign and without folding the accumulated impulse into the effective
# velocity, so it clamped to 0 every iteration (the solver did nothing). Now it
# converges to λ = (1+e)·pen / inv_mass and is iteration-independent.
test_group("collision_core: sequential_impulse");

# Resting contact, e=0, two dynamic bodies (inv_mass 1+1=2), pen=0.5 → λ=0.25.
var si_c = contact_new(0, 1, hvec3_unit_y(), F64_HALF, 0, 0, F64_ONE, F64_ONE);
var si_cs = vec_new();
vec_push(si_cs, si_c);
var si_out = alloc(16);
sequential_impulse(si_cs, 1, 10, si_out);
assert_eq(f64_to(f64_mul(load64(si_out), f64_from(100))), 25, "sequential_impulse: resting λ=0.25 (was 0)");

# Idempotent: e=0 converges in a single iteration to the same impulse.
var si_out1 = alloc(16);
sequential_impulse(si_cs, 1, 1, si_out1);
assert_eq(f64_to(f64_mul(load64(si_out1), f64_from(100))), 25, "sequential_impulse: converges in 1 iter");

# Dynamic vs static (inv_mass 1+0=1), pen=1.0 → λ=1.0.
var si_c2 = contact_new(0, 1, hvec3_unit_y(), F64_ONE, 0, 0, F64_ONE, 0);
var si_cs2 = vec_new();
vec_push(si_cs2, si_c2);
var si_out2 = alloc(16);
sequential_impulse(si_cs2, 1, 20, si_out2);
assert_eq(f64_to(f64_mul(load64(si_out2), f64_from(100))), 100, "sequential_impulse: dynamic+static λ=1.0");

# Both static (inv_mass 0) → contact skipped, impulse stays 0.
var si_c3 = contact_new(0, 1, hvec3_unit_y(), F64_HALF, 0, 0, 0, 0);
var si_cs3 = vec_new();
vec_push(si_cs3, si_c3);
var si_out3 = alloc(16);
sequential_impulse(si_cs3, 1, 5, si_out3);
assert_eq(f64_to(load64(si_out3)), 0, "sequential_impulse: both-static skipped (λ=0)");

# 2.8.3 — RESTITUTION. Every assertion above uses e = 0, where the pre-2.8.3
# (1+e)-on-the-effective-velocity form happens to be right. For e > 0 that form
# is the affine map λ_{k+1} = -e·λ_k + (1+e)·pen/inv_mass, which only settles
# for |e| < 1: at e = 1 it is a period-2 orbit alternating 0 and 2·pen/inv_mass,
# so an EVEN iteration count returned 0 — no impulse at all — and an odd one
# returned twice the right answer. The solver's result depended on the PARITY of
# a convergence parameter. Restitution is now a one-off bias on the target
# velocity, so λ = (1+e)·pen/inv_mass after a single sweep for every e >= 0.
# pen = 0.5, inv_mass = 2 → 0.375 / 0.5 / 0.75, all exact in binary.
var sr_i = 0;
while (sr_i < 3) {
    var sr_e = F64_HALF;
    var sr_want = 375;
    if (sr_i == 1) { sr_e = F64_ONE; sr_want = 500; }
    if (sr_i == 2) { sr_e = F64_TWO; sr_want = 750; }

    var sr_c = contact_new(0, 1, hvec3_unit_y(), F64_HALF, 0, sr_e, F64_ONE, F64_ONE);
    var sr_cs = vec_new();
    vec_push(sr_cs, sr_c);
    var sr_o1 = alloc(16);
    var sr_o8 = alloc(16);
    var sr_o9 = alloc(16);
    sequential_impulse(sr_cs, 1, 1, sr_o1);
    sequential_impulse(sr_cs, 1, 8, sr_o8);
    sequential_impulse(sr_cs, 1, 9, sr_o9);

    assert_eq(f64_to(f64_mul(load64(sr_o1), f64_from(1000))), sr_want,
    "sequential_impulse: 1 sweep reaches (1+e)·pen/inv_mass");
    assert_eq(load64(sr_o8), load64(sr_o1),
    "sequential_impulse: 8 sweeps == 1 sweep (no period-2 orbit)");
    assert_eq(load64(sr_o9), load64(sr_o8),
    "sequential_impulse: 9 sweeps == 8 sweeps (parity-independent)");
    sr_i = sr_i + 1;
}

# Restitution must MOVE the answer at an even sweep count, where the old form
# collapsed it to exactly zero.
var sr_a = contact_new(0, 1, hvec3_unit_y(), F64_HALF, 0, 0, F64_ONE, F64_ONE);
var sr_b = contact_new(0, 1, hvec3_unit_y(), F64_HALF, 0, F64_ONE, F64_ONE, F64_ONE);
var sr_va = vec_new();
var sr_vb = vec_new();
vec_push(sr_va, sr_a);
vec_push(sr_vb, sr_b);
var sr_oa = alloc(16);
var sr_ob = alloc(16);
sequential_impulse(sr_va, 1, 4, sr_oa);
sequential_impulse(sr_vb, 1, 4, sr_ob);
assert_eq(load64(sr_ob), f64_mul(F64_TWO, load64(sr_oa)),
"sequential_impulse: e=1 doubles the e=0 impulse at an even sweep count");

# 2.8.4 — FRICTION, the other half of the same audit row. Through 2.8.4 the
# friction block loaded the output slot it had itself zeroed, clamped that zero
# against mu*lambda_n and stored it back, with no update in between: |0| > cone
# is never true, so the friction impulse was identically 0 for every contact, at
# every mu, at every iteration count (measured: 0 of 320 sampled configs
# nonzero). `friction` was a silently ignored parameter. Nothing in tests/ so
# much as mentioned friction and every fixture above uses mu = 0, so the branch
# was never entered — which is why it survived.
#
# `sequential_impulse` now solves the tangential constraint against the relative
# sliding speed carried in the new ColContact.tangent_vel field, giving the
# closed form
#   lambda_t = clamp(-v_t / inv_mass, -mu*lambda_n, +mu*lambda_n)
# with lambda_n = (1+e)*pen/inv_mass from the restitution block above. Every
# expected value below is that closed form evaluated by hand, not a transcript of
# what the solver printed. The fixtures use inv_mass = 1+1 = 2, pen = 0.5 and
# e = 0, so lambda_n = 0.25 and the cone half-width at mu = 0.5 is 0.125 — all
# exact in binary, so these are bit-equality assertions, not tolerance bands.
test_group("collision_core: sequential_impulse friction (Coulomb cone)");

# One contact, pen = 0.5, two unit-inverse-mass bodies (inv_mass = 2).
fn _fr_solve(mu, vt, e, iters, out) {
    var fc = contact_new_fric(0, 1, hvec3_unit_y(), F64_HALF, mu, e, F64_ONE, F64_ONE, vt);
    var fv = vec_new();
    vec_push(fv, fc);
    sequential_impulse(fv, 1, iters, out);
    return 0;
}

var fr_8th = f64_div(F64_ONE, f64_from(8));      # 0.125
var fr_16th = f64_div(F64_ONE, f64_from(16));    # 0.0625
var fr_4th = f64_div(F64_ONE, f64_from(4));      # 0.25
var fr_mu = F64_HALF;

# STICKING: |v_t/inv_mass| = 0.0625 is inside the 0.125 cone, so the constraint
# is met exactly — lambda_t = -v_t/inv_mass and the tangential velocity that
# survives, v_t + lambda_t*inv_mass, is exactly zero.
var fr_oa = alloc(16);
_fr_solve(fr_mu, fr_8th, 0, 6, fr_oa);
assert_eq(load64(fr_oa), fr_4th, "friction: normal impulse still (1+e)·pen/inv_mass = 0.25");
assert_eq(load64(fr_oa + 8), f64_neg(fr_16th),
"friction: sticking λ_t = -v_t/inv_mass = -0.0625");
assert_eq(f64_add(fr_8th, f64_mul(load64(fr_oa + 8), F64_TWO)), 0,
"friction: sticking drives tangential velocity to exactly 0");

# SLIDING: v_t = 1 wants lambda_t = -0.5, four times the cone, so the Coulomb
# clamp binds at exactly -mu*lambda_n. The tangential velocity is only REDUCED
# (1.0 -> 0.75), never reversed.
var fr_ob = alloc(16);
_fr_solve(fr_mu, F64_ONE, 0, 6, fr_ob);
assert_eq(load64(fr_ob + 8), f64_neg(fr_8th),
"friction: sliding saturates at -mu·λ_n = -0.125");
assert_eq(f64_abs(load64(fr_ob + 8)), f64_mul(fr_mu, load64(fr_ob)),
"friction: clamp binds at |λ_t| = mu·λ_n");
var fr_vb = f64_add(F64_ONE, f64_mul(load64(fr_ob + 8), F64_TWO));
assert_eq(fr_vb, f64_div(f64_from(3), f64_from(4)),
"friction: sliding reduces v_t 1.0 → 0.75 (same sign, not reversed)");
assert_eq(f64_lt(fr_vb, F64_ONE), 1, "friction: |v_t| strictly decreased");
assert_eq(f64_gt(fr_vb, 0), 1, "friction: v_t not driven past zero");

# SIGN: the impulse opposes the motion on both sides.
var fr_oc = alloc(16);
_fr_solve(fr_mu, f64_neg(F64_ONE), 0, 6, fr_oc);
assert_eq(load64(fr_oc + 8), fr_8th, "friction: v_t < 0 → λ_t > 0 (opposes motion)");
assert_eq(load64(fr_oc + 8), f64_neg(load64(fr_ob + 8)),
"friction: reversing v_t reverses λ_t exactly");

# mu = 0 REGRESSION GUARD: every solver assertion above this block uses mu = 0
# and must not move by a single bit. mu = 0 skips the friction branch entirely,
# so the slot keeps the +0 written at entry and the normal impulse is unchanged.
var fr_od = alloc(16);
_fr_solve(0, F64_ONE, 0, 6, fr_od);
assert_eq(load64(fr_od + 8), 0, "friction: mu = 0 leaves the friction slot at +0");
assert_eq(load64(fr_od), load64(fr_ob),
"friction: mu = 0 normal impulse bit-identical to mu = 0.5");

# ITERATION INDEPENDENCE: accumulate-then-clamp bounds the TOTAL impulse, so a
# saturated contact stays saturated instead of gaining another mu·λ_n per sweep.
var fr_o1 = alloc(16);
var fr_o8 = alloc(16);
var fr_o9 = alloc(16);
_fr_solve(fr_mu, fr_8th, 0, 1, fr_o1);
_fr_solve(fr_mu, fr_8th, 0, 8, fr_o8);
_fr_solve(fr_mu, fr_8th, 0, 9, fr_o9);
assert_eq(load64(fr_o1 + 8), load64(fr_o8 + 8), "friction: sticking 1 sweep == 8 sweeps");
assert_eq(load64(fr_o8 + 8), load64(fr_o9 + 8), "friction: sticking 8 sweeps == 9 sweeps");
var fr_s1 = alloc(16);
var fr_s8 = alloc(16);
_fr_solve(fr_mu, F64_ONE, 0, 1, fr_s1);
_fr_solve(fr_mu, F64_ONE, 0, 8, fr_s8);
assert_eq(load64(fr_s1 + 8), load64(fr_s8 + 8),
"friction: sliding 1 sweep == 8 sweeps (cone does not re-charge)");

# The cone tracks lambda_n: e = 1 doubles the normal impulse to 0.5, so the same
# v_t = 1 now saturates at -0.25 instead of -0.125.
var fr_og = alloc(16);
_fr_solve(fr_mu, F64_ONE, F64_ONE, 6, fr_og);
assert_eq(load64(fr_og), F64_HALF, "friction: e = 1 → λ_n = 0.5");
assert_eq(load64(fr_og + 8), f64_neg(fr_4th), "friction: cone tracks λ_n → -0.25");

# NO NORMAL LOAD, NO FRICTION. pen = 0 gives lambda_n = 0, so the cone collapses
# to a point and the clamp must return exactly +0 (not -0: f64_neg(+0) is +0).
var fr_ch = contact_new_fric(0, 1, hvec3_unit_y(), 0, fr_mu, 0, F64_ONE, F64_ONE, F64_ONE);
var fr_vh = vec_new();
vec_push(fr_vh, fr_ch);
var fr_oh = alloc(16);
sequential_impulse(fr_vh, 1, 6, fr_oh);
assert_eq(load64(fr_oh), 0, "friction: pen = 0 → λ_n = 0");
assert_eq(load64(fr_oh + 8), 0, "friction: zero-width cone → friction exactly +0");

# Separating contact: lambda_n clamps to 0, so friction goes with it.
var fr_ci = contact_new_fric(0, 1, hvec3_unit_y(), f64_neg(F64_HALF), fr_mu, 0,
F64_ONE, F64_ONE, F64_ONE);
var fr_vi = vec_new();
vec_push(fr_vi, fr_ci);
var fr_oi = alloc(16);
sequential_impulse(fr_vi, 1, 6, fr_oi);
assert_eq(load64(fr_oi), 0, "friction: separating contact → λ_n = 0");
assert_eq(load64(fr_oi + 8), 0, "friction: separating contact → λ_t = 0");

# Both bodies static: the contact is skipped before friction is reached.
var fr_cj = contact_new_fric(0, 1, hvec3_unit_y(), F64_HALF, fr_mu, 0, 0, 0, F64_ONE);
var fr_vj = vec_new();
vec_push(fr_vj, fr_cj);
var fr_oj = alloc(16);
sequential_impulse(fr_vj, 1, 6, fr_oj);
assert_eq(load64(fr_oj + 8), 0, "friction: both-static contact → λ_t = 0");

# A cone wide enough never to bind reproduces the unclamped solution.
var fr_ok = alloc(16);
_fr_solve(f64_from(4), F64_ONE, 0, 6, fr_ok);
assert_eq(load64(fr_ok + 8), f64_neg(F64_HALF),
"friction: mu = 4 leaves λ_t interior at -v_t/inv_mass");
assert_eq(f64_add(F64_ONE, f64_mul(load64(fr_ok + 8), F64_TWO)), 0,
"friction: interior solution zeroes v_t exactly");

# The 8-argument contact_new is exactly contact_new_fric with tangent_vel = 0:
# no tangential motion means no friction impulse even at mu > 0, which is why
# every pre-2.8.4 fixture (and every consumer) is bit-for-bit unaffected.
var fr_cl1 = contact_new(0, 1, hvec3_unit_y(), F64_HALF, fr_mu, 0, F64_ONE, F64_ONE);
var fr_cl2 = contact_new_fric(0, 1, hvec3_unit_y(), F64_HALF, fr_mu, 0, F64_ONE, F64_ONE, 0);
var fr_vl1 = vec_new();
var fr_vl2 = vec_new();
vec_push(fr_vl1, fr_cl1);
vec_push(fr_vl2, fr_cl2);
var fr_ol1 = alloc(16);
var fr_ol2 = alloc(16);
sequential_impulse(fr_vl1, 1, 6, fr_ol1);
sequential_impulse(fr_vl2, 1, 6, fr_ol2);
assert_eq(load64(fr_ol1), load64(fr_ol2),
"friction: contact_new λ_n == contact_new_fric(tangent_vel = 0) λ_n");
assert_eq(load64(fr_ol1 + 8), load64(fr_ol2 + 8),
"friction: contact_new λ_t == contact_new_fric(tangent_vel = 0) λ_t");
assert_eq(load64(fr_ol1 + 8), 0, "friction: no tangential motion → λ_t = 0 even at mu > 0");
assert_eq(ColContact_tangent_vel(fr_cl1), 0, "friction: contact_new defaults tangent_vel to 0");
assert_eq(ColContact_tangent_vel(fr_ci), F64_ONE, "friction: contact_new_fric stores tangent_vel");

# Two contacts in one batch keep independent friction slots (16 bytes apart).
var fr_m1 = contact_new_fric(0, 1, hvec3_unit_y(), F64_HALF, fr_mu, 0, F64_ONE, F64_ONE,
F64_ONE);
var fr_m2 = contact_new_fric(1, 2, hvec3_unit_y(), F64_HALF, fr_mu, 0, F64_ONE, F64_ONE,
f64_neg(F64_ONE));
var fr_vm = vec_new();
vec_push(fr_vm, fr_m1);
vec_push(fr_vm, fr_m2);
var fr_om = alloc(32);
sequential_impulse(fr_vm, 2, 6, fr_om);
assert_eq(load64(fr_om + 8), f64_neg(fr_8th), "friction: batch slot 0 saturates negative");
assert_eq(load64(fr_om + 24), fr_8th, "friction: batch slot 1 saturates positive");

# convex_hull_2d (2.4.0) — Andrew's monotone chain. Square (side 2) plus an
# interior point: the hull is the 4 corners in CCW order; the interior point
# is dropped. Shoelace 2×area = +8 pins both the geometry and the orientation.
test_group("collision_core: convex_hull_2d");

var ch_pts = vec_new();
vec_push(ch_pts, hvec2_new(0, 0));               # idx 0
vec_push(ch_pts, hvec2_new(F64_TWO, 0));         # idx 1
vec_push(ch_pts, hvec2_new(F64_TWO, F64_TWO));   # idx 2
vec_push(ch_pts, hvec2_new(0, F64_TWO));         # idx 3
vec_push(ch_pts, hvec2_new(F64_ONE, F64_ONE));   # idx 4 (interior)
var ch_hull = convex_hull_2d(ch_pts, 5);
assert_eq(vec_len(ch_hull), 4, "convex_hull_2d: square+interior → 4 hull vertices");

assert_neq(vec_get(ch_hull, 0), 4, "convex_hull_2d: interior excluded [0]");
assert_neq(vec_get(ch_hull, 1), 4, "convex_hull_2d: interior excluded [1]");
assert_neq(vec_get(ch_hull, 2), 4, "convex_hull_2d: interior excluded [2]");
assert_neq(vec_get(ch_hull, 3), 4, "convex_hull_2d: interior excluded [3]");

var ch_h0 = vec_get(ch_pts, vec_get(ch_hull, 0));
var ch_h1 = vec_get(ch_pts, vec_get(ch_hull, 1));
var ch_h2 = vec_get(ch_pts, vec_get(ch_hull, 2));
var ch_h3 = vec_get(ch_pts, vec_get(ch_hull, 3));
var ch_a = f64_sub(f64_mul(HVec2_x(ch_h0), HVec2_y(ch_h1)), f64_mul(HVec2_x(ch_h1), HVec2_y(ch_h0)));
ch_a = f64_add(ch_a, f64_sub(f64_mul(HVec2_x(ch_h1), HVec2_y(ch_h2)), f64_mul(HVec2_x(ch_h2), HVec2_y(ch_h1))));
ch_a = f64_add(ch_a, f64_sub(f64_mul(HVec2_x(ch_h2), HVec2_y(ch_h3)), f64_mul(HVec2_x(ch_h3), HVec2_y(ch_h2))));
ch_a = f64_add(ch_a, f64_sub(f64_mul(HVec2_x(ch_h3), HVec2_y(ch_h0)), f64_mul(HVec2_x(ch_h0), HVec2_y(ch_h3))));
assert_eq(f64_to(ch_a), 8, "convex_hull_2d: shoelace 2xarea = +8 (CCW, exact square)");

# Degeneracies (2.4.0) — each must return a defined hull, never trap.

# Empty / single point → trivial passthrough.
var ch_empty = vec_new();
assert_eq(vec_len(convex_hull_2d(ch_empty, 0)), 0, "convex_hull_2d: empty -> 0 vertices");
var ch_one = vec_new();
vec_push(ch_one, hvec2_new(F64_ONE, F64_ONE));
assert_eq(vec_len(convex_hull_2d(ch_one, 1)), 1, "convex_hull_2d: single point -> 1 vertex");

# Triangle → all 3 vertices; shoelace 2×area = +4 (CCW).
var ch_t = vec_new();
vec_push(ch_t, hvec2_new(0, 0));
vec_push(ch_t, hvec2_new(F64_TWO, 0));
vec_push(ch_t, hvec2_new(F64_ONE, F64_TWO));
var ch_th = convex_hull_2d(ch_t, 3);
assert_eq(vec_len(ch_th), 3, "convex_hull_2d: triangle -> 3 vertices");
var ch_t0 = vec_get(ch_t, vec_get(ch_th, 0));
var ch_t1 = vec_get(ch_t, vec_get(ch_th, 1));
var ch_t2 = vec_get(ch_t, vec_get(ch_th, 2));
var ch_ta = f64_sub(f64_mul(HVec2_x(ch_t0), HVec2_y(ch_t1)), f64_mul(HVec2_x(ch_t1), HVec2_y(ch_t0)));
ch_ta = f64_add(ch_ta, f64_sub(f64_mul(HVec2_x(ch_t1), HVec2_y(ch_t2)), f64_mul(HVec2_x(ch_t2), HVec2_y(ch_t1))));
ch_ta = f64_add(ch_ta, f64_sub(f64_mul(HVec2_x(ch_t2), HVec2_y(ch_t0)), f64_mul(HVec2_x(ch_t0), HVec2_y(ch_t2))));
assert_eq(f64_to(ch_ta), 4, "convex_hull_2d: triangle shoelace 2xarea = +4 (CCW)");

# Collinear → only the 2 extreme endpoints (interior point dropped).
var ch_c = vec_new();
vec_push(ch_c, hvec2_new(0, 0));
vec_push(ch_c, hvec2_new(F64_ONE, 0));
vec_push(ch_c, hvec2_new(F64_TWO, 0));
var ch_ch = convex_hull_2d(ch_c, 3);
assert_eq(vec_len(ch_ch), 2, "convex_hull_2d: collinear -> 2 endpoints");
var ch_c0 = vec_get(ch_c, vec_get(ch_ch, 0));
var ch_c1 = vec_get(ch_c, vec_get(ch_ch, 1));
var ch_cspan = f64_to(f64_abs(f64_sub(HVec2_x(ch_c0), HVec2_x(ch_c1))));
assert_eq(ch_cspan, 2, "convex_hull_2d: collinear endpoints span x=0..2");

# Duplicate corner → still the 4-vertex square (no spurious vertex, no trap).
var ch_d = vec_new();
vec_push(ch_d, hvec2_new(0, 0));
vec_push(ch_d, hvec2_new(0, 0));
vec_push(ch_d, hvec2_new(F64_TWO, 0));
vec_push(ch_d, hvec2_new(F64_TWO, F64_TWO));
vec_push(ch_d, hvec2_new(0, F64_TWO));
assert_eq(vec_len(convex_hull_2d(ch_d, 5)), 4, "convex_hull_2d: duplicate corner -> 4 vertices");

# triangulate_polygon (2.4.1) — ear clipping. Audited; no bug found. Each case
# checks the count (3*(n-2) flat indices) and that the triangles tile the
# polygon: |Σ 2×area| == polygon |2×area| (abs makes it winding-agnostic).
test_group("collision_core: triangulate_polygon");

# Convex quad (side-2 square) → 2 triangles, 2×area = 8.
var tp_q = vec_new();
vec_push(tp_q, hvec2_new(0, 0));
vec_push(tp_q, hvec2_new(F64_TWO, 0));
vec_push(tp_q, hvec2_new(F64_TWO, F64_TWO));
vec_push(tp_q, hvec2_new(0, F64_TWO));
var tp_qt = triangulate_polygon(tp_q, 4);
assert_eq(vec_len(tp_qt), 6, "triangulate_polygon: convex quad -> 2 triangles");
assert_eq(f64_to(f64_abs(_tp_area2x(tp_q, tp_qt))), 8, "triangulate_polygon: quad tiles (2xarea=8)");

# Concave 5-gon (reflex at (1,1)) → 3 triangles, 2×area = 6.
var tp_c = vec_new();
vec_push(tp_c, hvec2_new(0, 0));
vec_push(tp_c, hvec2_new(F64_TWO, 0));
vec_push(tp_c, hvec2_new(F64_TWO, F64_TWO));
vec_push(tp_c, hvec2_new(F64_ONE, F64_ONE));
vec_push(tp_c, hvec2_new(0, F64_TWO));
var tp_ct = triangulate_polygon(tp_c, 5);
assert_eq(vec_len(tp_ct), 9, "triangulate_polygon: concave 5-gon -> 3 triangles");
assert_eq(f64_to(f64_abs(_tp_area2x(tp_c, tp_ct))), 6, "triangulate_polygon: concave tiles (2xarea=6)");

# Convex hexagon → 4 triangles, 2×area = 24.
var tp_h = vec_new();
vec_push(tp_h, hvec2_new(0, 0));
vec_push(tp_h, hvec2_new(F64_TWO, 0));
vec_push(tp_h, hvec2_new(f64_from(3), F64_TWO));
vec_push(tp_h, hvec2_new(F64_TWO, f64_from(4)));
vec_push(tp_h, hvec2_new(0, f64_from(4)));
vec_push(tp_h, hvec2_new(f64_neg(F64_ONE), F64_TWO));
var tp_ht = triangulate_polygon(tp_h, 6);
assert_eq(vec_len(tp_ht), 12, "triangulate_polygon: hexagon -> 4 triangles");
assert_eq(f64_to(f64_abs(_tp_area2x(tp_h, tp_ht))), 24, "triangulate_polygon: hexagon tiles (2xarea=24)");

# U-shape (8 verts, 2 reflex) → 6 triangles, 2×area = 14.
var tp_u = vec_new();
vec_push(tp_u, hvec2_new(0, 0));
vec_push(tp_u, hvec2_new(f64_from(3), 0));
vec_push(tp_u, hvec2_new(f64_from(3), f64_from(3)));
vec_push(tp_u, hvec2_new(F64_TWO, f64_from(3)));
vec_push(tp_u, hvec2_new(F64_TWO, F64_ONE));
vec_push(tp_u, hvec2_new(F64_ONE, F64_ONE));
vec_push(tp_u, hvec2_new(F64_ONE, f64_from(3)));
vec_push(tp_u, hvec2_new(0, f64_from(3)));
var tp_ut = triangulate_polygon(tp_u, 8);
assert_eq(vec_len(tp_ut), 18, "triangulate_polygon: U-shape (2 reflex) -> 6 triangles");
assert_eq(f64_to(f64_abs(_tp_area2x(tp_u, tp_ut))), 14, "triangulate_polygon: U-shape tiles (2xarea=14)");

# CW winding (reversed square) → still 2 triangles tiling area 4.
var tp_w = vec_new();
vec_push(tp_w, hvec2_new(0, 0));
vec_push(tp_w, hvec2_new(0, F64_TWO));
vec_push(tp_w, hvec2_new(F64_TWO, F64_TWO));
vec_push(tp_w, hvec2_new(F64_TWO, 0));
var tp_wt = triangulate_polygon(tp_w, 4);
assert_eq(vec_len(tp_wt), 6, "triangulate_polygon: CW quad -> 2 triangles");
assert_eq(f64_to(f64_abs(_tp_area2x(tp_w, tp_wt))), 8, "triangulate_polygon: CW quad tiles (2xarea=8)");

# Collinear edge vertex (1,0) on the bottom edge → 3 triangles, 2×area = 8.
var tp_l = vec_new();
vec_push(tp_l, hvec2_new(0, 0));
vec_push(tp_l, hvec2_new(F64_ONE, 0));
vec_push(tp_l, hvec2_new(F64_TWO, 0));
vec_push(tp_l, hvec2_new(F64_TWO, F64_TWO));
vec_push(tp_l, hvec2_new(0, F64_TWO));
var tp_lt = triangulate_polygon(tp_l, 5);
assert_eq(vec_len(tp_lt), 9, "triangulate_polygon: collinear edge vertex -> 3 triangles");
assert_eq(f64_to(f64_abs(_tp_area2x(tp_l, tp_lt))), 8, "triangulate_polygon: collinear tiles (2xarea=8)");

# < 3 vertices → empty.
var tp_deg = vec_new();
vec_push(tp_deg, hvec2_new(0, 0));
vec_push(tp_deg, hvec2_new(F64_ONE, 0));
assert_eq(vec_len(triangulate_polygon(tp_deg, 2)), 0, "triangulate_polygon: n<3 -> empty");

# ================================================================
# COLLISION_MESH — Delaunay, half-edge, island detection
# ================================================================

# delaunay_2d (2.4.2) — Bowyer-Watson. Audited; no bug found, numerically robust
# (incl. the cocircular grid). Each fixture checks the empty-circumcircle
# (Delaunay) property holds — no point strictly inside any triangle's
# circumcircle — plus the triangle count (3 indices per triangle).
test_group("collision_mesh: delaunay_2d");

# Square (side 4) + interior point → 4 triangles, Delaunay-valid.
var dl_sq = vec_new();
vec_push(dl_sq, hvec2_new(0, 0));
vec_push(dl_sq, hvec2_new(f64_from(4), 0));
vec_push(dl_sq, hvec2_new(f64_from(4), f64_from(4)));
vec_push(dl_sq, hvec2_new(0, f64_from(4)));
vec_push(dl_sq, hvec2_new(F64_ONE, F64_ONE));
var dl_sqt = delaunay_2d(dl_sq, 5);
assert_eq(vec_len(dl_sqt), 12, "delaunay_2d: square+interior -> 4 triangles");
assert_eq(_dl_violations(dl_sq, 5, dl_sqt), 0, "delaunay_2d: square+interior empty-circumcircle");

# 3x3 grid — heavy cocircularity, the numerical-stability stress case.
var dl_g = vec_new();
vec_push(dl_g, hvec2_new(0, 0));
vec_push(dl_g, hvec2_new(F64_ONE, 0));
vec_push(dl_g, hvec2_new(F64_TWO, 0));
vec_push(dl_g, hvec2_new(0, F64_ONE));
vec_push(dl_g, hvec2_new(F64_ONE, F64_ONE));
vec_push(dl_g, hvec2_new(F64_TWO, F64_ONE));
vec_push(dl_g, hvec2_new(0, F64_TWO));
vec_push(dl_g, hvec2_new(F64_ONE, F64_TWO));
vec_push(dl_g, hvec2_new(F64_TWO, F64_TWO));
var dl_gt = delaunay_2d(dl_g, 9);
assert_eq(vec_len(dl_gt), 24, "delaunay_2d: 3x3 grid -> 8 triangles");
assert_eq(_dl_violations(dl_g, 9, dl_gt), 0, "delaunay_2d: 3x3 grid empty-circumcircle (cocircular)");

# Irregular 6-point set.
var dl_i = vec_new();
vec_push(dl_i, hvec2_new(0, 0));
vec_push(dl_i, hvec2_new(f64_from(5), F64_ONE));
vec_push(dl_i, hvec2_new(f64_from(3), f64_from(4)));
vec_push(dl_i, hvec2_new(F64_ONE, f64_from(5)));
vec_push(dl_i, hvec2_new(f64_from(6), f64_from(5)));
vec_push(dl_i, hvec2_new(F64_TWO, F64_TWO));
var dl_it = delaunay_2d(dl_i, 6);
assert_eq(_dl_violations(dl_i, 6, dl_it), 0, "delaunay_2d: irregular-6 empty-circumcircle");

# Single triangle (n=3).
var dl_t = vec_new();
vec_push(dl_t, hvec2_new(0, 0));
vec_push(dl_t, hvec2_new(f64_from(4), 0));
vec_push(dl_t, hvec2_new(F64_TWO, f64_from(3)));
assert_eq(vec_len(delaunay_2d(dl_t, 3)), 3, "delaunay_2d: n=3 -> 1 triangle");

# Degenerate: n<3 and all-collinear → empty, never a trap.
var dl_two = vec_new();
vec_push(dl_two, hvec2_new(0, 0));
vec_push(dl_two, hvec2_new(F64_ONE, 0));
assert_eq(vec_len(delaunay_2d(dl_two, 2)), 0, "delaunay_2d: n<3 -> empty");
var dl_col = vec_new();
vec_push(dl_col, hvec2_new(0, 0));
vec_push(dl_col, hvec2_new(F64_ONE, 0));
vec_push(dl_col, hvec2_new(F64_TWO, 0));
vec_push(dl_col, hvec2_new(f64_from(3), 0));
assert_eq(vec_len(delaunay_2d(dl_col, 4)), 0, "delaunay_2d: all-collinear -> empty (no trap)");

# halfedge mesh (2.4.3) — halfedge_from_triangles + adjacency / boundary queries.
# Audited; no bug found. Twin wiring (reverse-edge match), the one-ring boundary
# walk, and adjacent-faces-via-twins are correct on closed + open meshes.
test_group("collision_mesh: half-edge mesh");

# Tetrahedron (closed manifold): every edge shared → no boundary vertices,
# each face has 3 neighbours.
var he_tet = vec_new();
_he_tri(he_tet, 0, 1, 2);
_he_tri(he_tet, 0, 2, 3);
_he_tri(he_tet, 0, 3, 1);
_he_tri(he_tet, 1, 3, 2);
var he_tm = halfedge_from_triangles(he_tet, 4, 4);
assert_eq(_he_boundary_sum(he_tm, 4), 0, "half-edge: tetrahedron has no boundary vertices");
assert_eq(vec_len(halfedge_adjacent_faces(he_tm, 0)), 3, "half-edge: tetrahedron face has 3 neighbours");

# Single triangle (open): all 3 verts boundary, no neighbours.
var he_one = vec_new();
_he_tri(he_one, 0, 1, 2);
var he_om = halfedge_from_triangles(he_one, 1, 3);
assert_eq(_he_boundary_sum(he_om, 3), 3, "half-edge: single triangle all-boundary");
assert_eq(vec_len(halfedge_adjacent_faces(he_om, 0)), 0, "half-edge: single triangle has no neighbours");

# Two triangles sharing diagonal 0-2: all 4 corners boundary, face 0 has 1 neighbour.
var he_q = vec_new();
_he_tri(he_q, 0, 1, 2);
_he_tri(he_q, 0, 2, 3);
var he_qm = halfedge_from_triangles(he_q, 2, 4);
assert_eq(_he_boundary_sum(he_qm, 4), 4, "half-edge: quad corners all boundary");
assert_eq(vec_len(halfedge_adjacent_faces(he_qm, 0)), 1, "half-edge: quad face shares 1 edge");

# Hexagon fan: center (0) interior, rim (1..6) boundary → one-ring walk closes.
var he_f = vec_new();
_he_tri(he_f, 0, 1, 2);
_he_tri(he_f, 0, 2, 3);
_he_tri(he_f, 0, 3, 4);
_he_tri(he_f, 0, 4, 5);
_he_tri(he_f, 0, 5, 6);
_he_tri(he_f, 0, 6, 1);
var he_fm = halfedge_from_triangles(he_f, 6, 7);
assert_eq(halfedge_is_boundary(he_fm, 0), 0, "half-edge: fan center is interior");
assert_eq(halfedge_is_boundary(he_fm, 1), 1, "half-edge: fan rim vertex is boundary");
assert_eq(_he_boundary_sum(he_fm, 7), 6, "half-edge: fan has 6 boundary (rim) vertices");
assert_eq(vec_len(halfedge_adjacent_faces(he_fm, 0)), 2, "half-edge: fan face0 shares 2 edges");

# Error path: empty triangle list → null mesh.
var he_empty = vec_new();
assert_eq(halfedge_from_triangles(he_empty, 0, 0), 0, "half-edge: empty -> null mesh");

test_group("collision_mesh: detect_islands");

# Two contact-connected components: bodies {0,1} and {2,3}
var ic1 = contact_new(0, 1, hvec3_unit_y(), F64_HALF, F64_HALF, F64_HALF, F64_ONE, F64_ONE);
var ic2 = contact_new(2, 3, hvec3_unit_y(), F64_HALF, F64_HALF, F64_HALF, F64_ONE, F64_ONE);
var ic_vec = vec_new();
vec_push(ic_vec, ic1);
vec_push(ic_vec, ic2);
var islands = detect_islands(ic_vec, 2, 4);
assert_eq(vec_len(islands), 2, "detect_islands: 2 disjoint contact pairs → 2 islands");

# ================================================================
# einsum — first coverage (the module shipped untested through 2.6.12)
# ================================================================
# `_einsum_is_label` accepted only 'a'..'h', so every example in einsum.cyr's OWN
# header ("ij,jk->ik", "ii->", "ij->ji", "i,j->ij") used labels the parser
# rejected — and it SKIPPED them silently rather than erroring, so matmul returned
# the trace (5, not 19) and then SEGFAULTED. Alphabet widened to a-z and every
# malformed spec is now an explicit 0-return.
test_group("einsum: documented notations");

fn _es_mk2(r2, c2, v0, v1, v2, v3) {
    var sh = alloc(16);
    store64(sh, r2);
    store64(sh + 8, c2);
    var t = tensor_new(2, sh);
    var d = HTensor_data(t);
    store64(d, v0);
    store64(d + 8, v1);
    store64(d + 16, v2);
    store64(d + 24, v3);
    return t;
}

# A = [[1,2],[3,4]], B = [[5,6],[7,8]] -> A*B = [[19,22],[43,50]]
var es_A = _es_mk2(2, 2, f64_from(1), f64_from(2), f64_from(3), f64_from(4));
var es_B = _es_mk2(2, 2, f64_from(5), f64_from(6), f64_from(7), f64_from(8));
var es_two = alloc(16);
store64(es_two, es_A);
store64(es_two + 8, es_B);
var es_one = alloc(8);
store64(es_one, es_A);

var es_mm = einsum(str_from("ij,jk->ik"), es_two, 2);
assert_neq(es_mm, 0, "einsum: matmul returns a tensor");
assert_eq(f64_to(tensor_get2(es_mm, 0, 0)), 19, "einsum matmul [0][0]=19");
assert_eq(f64_to(tensor_get2(es_mm, 0, 1)), 22, "einsum matmul [0][1]=22");
assert_eq(f64_to(tensor_get2(es_mm, 1, 0)), 43, "einsum matmul [1][0]=43");
assert_eq(f64_to(tensor_get2(es_mm, 1, 1)), 50, "einsum matmul [1][1]=50");

var es_tr = einsum(str_from("ii->"), es_one, 1);
assert_neq(es_tr, 0, "einsum: trace returns a tensor");
assert_eq(f64_to(load64(HTensor_data(es_tr))), 5, "einsum trace(A)=5");

var es_tp = einsum(str_from("ij->ji"), es_one, 1);
assert_neq(es_tp, 0, "einsum: transpose returns a tensor");
assert_eq(f64_to(tensor_get2(es_tp, 0, 1)), 3, "einsum transpose [0][1]=3");
assert_eq(f64_to(tensor_get2(es_tp, 1, 0)), 2, "einsum transpose [1][0]=2");

test_group("mat3 — first coverage (module shipped untested through 2.6.12)");
var m3i = m3_identity();
assert_eq(f64_to(m3_determinant(m3i)), 1, "m3_determinant(I)=1");
assert_eq(f64_to(m3_trace(m3i)), 3, "m3_trace(I)=3");
var m3p = m3_mul(m3i, m3i);
assert_eq(f64_to(m3_get(m3p, 0, 0)), 1, "m3_mul(I,I)[0][0]=1");
assert_eq(f64_to(m3_get(m3p, 1, 0)), 0, "m3_mul(I,I)[1][0]=0");
# M * M^-1 = I for a non-symmetric invertible matrix
var m3a = m3_new();
m3_set(m3a, 0, 0, f64_from(2)); m3_set(m3a, 0, 1, F64_ONE);   m3_set(m3a, 0, 2, 0);
m3_set(m3a, 1, 0, F64_ONE);     m3_set(m3a, 1, 1, f64_from(3)); m3_set(m3a, 1, 2, F64_ONE);
m3_set(m3a, 2, 0, 0);           m3_set(m3a, 2, 1, F64_ONE);   m3_set(m3a, 2, 2, F64_TWO);
var m3inv = m3_inverse(m3a);
assert_neq(m3inv, 0, "m3_inverse returns non-null");
var m3ii = m3_mul(m3a, m3inv);
assert(f64_approx_eq(m3_get(m3ii, 0, 0), F64_ONE, LOOSE_TOL_M), "m3 inv round-trip [0][0]=1");
assert(f64_approx_eq(m3_get(m3ii, 1, 1), F64_ONE, LOOSE_TOL_M), "m3 inv round-trip [1][1]=1");
assert(f64_approx_eq(m3_get(m3ii, 0, 1), 0, LOOSE_TOL_M), "m3 inv round-trip [0][1]=0");
# transpose is an involution; det(M^T) == det(M)
assert(f64_approx_eq(m3_determinant(m3_transpose(m3a)), m3_determinant(m3a), LOOSE_TOL_M),
"m3 det(M^T)==det(M)");
# from_quat(identity) is the identity rotation
assert(f64_approx_eq(m3_trace(m3_from_quat(hquat_identity())), f64_from(3), LOOSE_TOL_M),
"m3_from_quat(identity) trace=3");

test_group("Lie: SU(2)->SO(3) double cover (half-angle convention)");
# su2_exp used a FULL-angle convention through 2.6.12 while so3_exp,
# su2_from_axis_angle and su2_to_rotation_matrix all use half-angle, so these two
# rotations differed by a factor of 2 — and se3_exp built R and t from angles a
# factor of 2 apart, producing a pair that was not the exponential of any twist.
var lw = hvec3_new(f64_div(F64_ONE, f64_from(3)), f64_div(F64_ONE, F64_TWO),
f64_div(F64_ONE, f64_from(5)));
var lR_su2 = su2_to_rotation_matrix(su2_exp(lw));
var lR_so3 = so3_exp(lw);
var lei = 0;
while (lei < 9) {
    assert(f64_approx_eq(load64(lR_su2 + lei * 8), load64(lR_so3 + lei * 8), LOOSE_TOL_M),
    "su2_to_rotation_matrix(su2_exp(w)) == so3_exp(w)");
    lei = lei + 1;
}
# exp must agree with the axis-angle constructor
var lax = hvec3_new(0, 0, F64_ONE);
assert(f64_approx_eq(_su2_w(su2_exp(hvec3_scale(lax, F64_PI_2))),
_su2_w(su2_from_axis_angle(lax, F64_PI_2)), LOOSE_TOL_M),
"su2_exp == su2_from_axis_angle (w)");
# log inverts exp
var llg = su2_log(su2_exp(lw));
assert(f64_approx_eq(HVec3_x(llg), HVec3_x(lw), LOOSE_TOL_M), "su2_log(su2_exp(w)).x == w.x");
assert(f64_approx_eq(HVec3_y(llg), HVec3_y(lw), LOOSE_TOL_M), "su2_log(su2_exp(w)).y == w.y");
assert(f64_approx_eq(HVec3_z(llg), HVec3_z(lw), LOOSE_TOL_M), "su2_log(su2_exp(w)).z == w.z");

test_group("lie_ext: SE(3) — first coverage (module shipped untested through 2.6.12)");
var ltw = alloc(48);
store64(ltw, HVec3_x(lw));
store64(ltw + 8, HVec3_y(lw));
store64(ltw + 16, HVec3_z(lw));
store64(ltw + 24, F64_ONE);
store64(ltw + 32, F64_TWO);
store64(ltw + 40, f64_from(3));
var lse = se3_exp(ltw);
assert_neq(lse, 0, "se3_exp returns non-null");
# se3_log must invert se3_exp on all six twist components
var ltw2 = se3_log(lse);
lei = 0;
while (lei < 6) {
    assert(f64_approx_eq(load64(ltw2 + lei * 8), load64(ltw + lei * 8), LOOSE_TOL_M),
    "se3_log(se3_exp(twist)) round-trips");
    lei = lei + 1;
}
# and its rotation block must be the SAME rotation so3_exp gives for that omega
var lR_se3 = su2_to_rotation_matrix(_se3_rot(lse));
lei = 0;
while (lei < 9) {
    assert(f64_approx_eq(load64(lR_se3 + lei * 8), load64(lR_so3 + lei * 8), LOOSE_TOL_M),
    "se3_exp rotation block == so3_exp(omega)");
    lei = lei + 1;
}

# ================================================================
# calc_ext + noise_simplex — first coverage (untested through 2.6.13)
# ================================================================
# ================================================================
# Collision hot paths — O(n log n) rewrites (2.6.15)
# ================================================================
# Both were O(n^2). The assertions here pin the CONTRACT, not the timing:
# a correct sort is a zero-inversion permutation, and a correct half-edge mesh
# satisfies twin(twin(i)) == i with a known boundary count. Timings live in
# bench-history.csv (convex_hull_2d_2k, halfedge_2k_tris).
# ================================================================
# num_ext + symbolic_ext — final two never-tested modules (2.6.15)
# ================================================================
# With these, all 34 shipped modules are included by at least one suite.
test_group("num_ext: transforms and number theory");

# num_dst is DST-I (its label said Type II through 2.6.14). DST-I is its own
# inverse up to the 2/(n+1) scale, so idst(dst(x)) must round-trip.
var ne_n = 8;
var ne_x = alloc(ne_n * 8);
var ne_orig = alloc(ne_n * 8);
var ne_i = 0;
while (ne_i < ne_n) {
    var ne_v = f64_from((ne_i * 7) % 5 + 1);
    store64(ne_x + ne_i * 8, ne_v);
    store64(ne_orig + ne_i * 8, ne_v);
    ne_i = ne_i + 1;
}
assert_eq(num_dst(ne_x, ne_n), HSB_ERR_NONE, "num_dst returns HSB_ERR_NONE");
assert_eq(num_idst(ne_x, ne_n), HSB_ERR_NONE, "num_idst returns HSB_ERR_NONE");
var ne_bad = 0;
ne_i = 0;
while (ne_i < ne_n) {
    if (f64_approx_eq(load64(ne_x + ne_i * 8), load64(ne_orig + ne_i * 8), LOOSE_TOL_M) == 0) {
        ne_bad = ne_bad + 1;
    }
    ne_i = ne_i + 1;
}
assert_eq(ne_bad, 0, "num_idst(num_dst(x)) round-trips");
# The round-trip above is necessary but NOT sufficient: DST-I is symmetric with
# S^2 = ((n+1)/2) I, and so is -S, and so is every other symmetric involution
# (DCT-I included). A global sign flip, or the wrong kernel entirely, round-trips
# perfectly. Pin the kernel itself with delta inputs, which read off one column:
#   x = e_j  =>  X[k] = sin(PI (j+1)(k+1) / (n+1))
# With n = 7 the angles are exact multiples of PI/8, so the column is a closed
# form: sin(PI/8)=0.3826834323650898, sin(PI/4)=0.7071067811865476,
#       sin(3PI/8)=0.9238795325112867, sin(PI/2)=1.
var nd = alloc(7 * 8);
var ndi = 0;
while (ndi < 7) { store64(nd + ndi * 8, 0); ndi = ndi + 1; }
store64(nd, F64_ONE);                      # x = e_0
assert_eq(num_dst(nd, 7), HSB_ERR_NONE, "num_dst(e_0) ok");
assert(f64_approx_eq(load64(nd + 0), 0x3FD87DE2A6AEA963, EPSILON_F64), "DST-I e0 k0 sin(PI/8)");
assert(f64_approx_eq(load64(nd + 8), 0x3FE6A09E667F3BCC, EPSILON_F64), "DST-I e0 k1 sin(PI/4)");
assert(f64_approx_eq(load64(nd + 16), 0x3FED906BCF328D46, EPSILON_F64), "DST-I e0 k2 sin(3PI/8)");
assert(f64_approx_eq(load64(nd + 24), F64_ONE, EPSILON_F64), "DST-I e0 k3 sin(PI/2)=1");
assert(f64_approx_eq(load64(nd + 32), 0x3FED906BCF328D46, EPSILON_F64), "DST-I e0 k4 sin(5PI/8)");
assert(f64_approx_eq(load64(nd + 40), 0x3FE6A09E667F3BCC, EPSILON_F64), "DST-I e0 k5 sin(3PI/4)");
assert(f64_approx_eq(load64(nd + 48), 0x3FD87DE2A6AEA963, EPSILON_F64), "DST-I e0 k6 sin(7PI/8)");
# x = e_1 -> X[k] = sin(PI (k+1)/4): the signed, zero-crossing column. This is
# what catches a sign flip or a cosine kernel; column 0 above is palindromic.
var nd2 = alloc(7 * 8);
ndi = 0;
while (ndi < 7) { store64(nd2 + ndi * 8, 0); ndi = ndi + 1; }
store64(nd2 + 8, F64_ONE);
assert_eq(num_dst(nd2, 7), HSB_ERR_NONE, "num_dst(e_1) ok");
assert(f64_approx_eq(load64(nd2 + 0), 0x3FE6A09E667F3BCC, EPSILON_F64), "DST-I e1 k0 = +sqrt2/2");
assert(f64_approx_eq(load64(nd2 + 8), F64_ONE, EPSILON_F64), "DST-I e1 k1 = +1");
assert(f64_approx_eq(load64(nd2 + 16), 0x3FE6A09E667F3BCC, EPSILON_F64), "DST-I e1 k2 = +sqrt2/2");
assert(f64_approx_eq(load64(nd2 + 24), 0, EPSILON_F64), "DST-I e1 k3 = sin(PI) = 0");
assert(f64_approx_eq(load64(nd2 + 32), 0xBFE6A09E667F3BCC, EPSILON_F64), "DST-I e1 k4 = -sqrt2/2");
assert(f64_approx_eq(load64(nd2 + 40), f64_neg(F64_ONE), EPSILON_F64), "DST-I e1 k5 = -1");
assert(f64_approx_eq(load64(nd2 + 48), 0xBFE6A09E667F3BCC, EPSILON_F64), "DST-I e1 k6 = -sqrt2/2");
assert_eq(num_dst(ne_x, 0), HSB_ERR_INVALID_INPUT, "num_dst(n=0) -> INVALID_INPUT");
# DCT-II: X[0] of a constant signal c is n*c.
var ne_c = alloc(4 * 8);
ne_i = 0;
while (ne_i < 4) {
    store64(ne_c + ne_i * 8, F64_TWO);
    ne_i = ne_i + 1;
}
assert_eq(num_dct(ne_c, 4), HSB_ERR_NONE, "num_dct returns HSB_ERR_NONE");
assert(f64_approx_eq(load64(ne_c), f64_from(8), LOOSE_TOL_M), "DCT-II X[0] of const 2 over n=4 is 8");

# Mobius: mu(1)=1, mu(2)=-1, mu(4)=0 (square factor), mu(6)=1 (two primes)
assert_eq(num_mobius(1), 1, "mobius(1)=1");
assert_eq(num_mobius(2), 0 - 1, "mobius(2)=-1");
assert_eq(num_mobius(4), 0, "mobius(4)=0 (square factor)");
assert_eq(num_mobius(6), 1, "mobius(6)=1");

# Tridiagonal solve: identity system returns the RHS unchanged.
var ne_a = alloc(3 * 8);
var ne_b = alloc(3 * 8);
var ne_cc = alloc(3 * 8);
var ne_d = alloc(3 * 8);
var ne_out = alloc(3 * 8);
ne_i = 0;
while (ne_i < 3) {
    store64(ne_a + ne_i * 8, 0);
    store64(ne_b + ne_i * 8, F64_ONE);
    store64(ne_cc + ne_i * 8, 0);
    store64(ne_d + ne_i * 8, f64_from(ne_i + 1));
    ne_i = ne_i + 1;
}
assert_eq(num_tridiag_solve(ne_a, ne_b, ne_cc, ne_d, 3, ne_out), HSB_ERR_NONE,
"num_tridiag_solve returns HSB_ERR_NONE");
assert_eq(f64_to(load64(ne_out)), 1, "tridiag identity x[0]=1");
assert_eq(f64_to(load64(ne_out + 16)), 3, "tridiag identity x[2]=3");

# ----------------------------------------------------------------
# num_tridiag_solve on systems with LIVE off-diagonals (2.8.3)
#
# The fixture above is DIAGONAL: a and c are all zero, so c'[i] = 0 for every
# i, the elimination denominator collapses to b[i], the d' recurrence loses its
# a*d'[i-1] term and the back-substitution at src/num_ext.cyr:769 subtracts
# c'[j] * x[j+1] == 0. The entire Thomas algorithm -- 60 of the function's 70
# lines -- is multiplied by zero and the test still passes. The two systems
# below have nonzero sub- AND super-diagonals so every one of those terms is
# load-bearing.
#
# Both right-hand sides were formed as d = A x for a CHOSEN integer x (exact in
# f64, no rounding in the input), and the solutions were re-derived independently
# by exact-rational Gaussian elimination with partial pivoting (python3
# fractions.Fraction), NOT by running this solver.

# (a) 1-D Poisson, n = 5: sub = super = -1, diag = 2, x = (1,2,3,4,5),
# so d = (0,0,0,0,6). Four of the five right-hand sides are ZERO -- the answer
# is produced entirely by the elimination and the back-substitution sweep.
var _tds_n = 5;
var _tds_a = alloc(_tds_n * 8);
var _tds_b = alloc(_tds_n * 8);
var _tds_c = alloc(_tds_n * 8);
var _tds_d = alloc(_tds_n * 8);
var _tds_x = alloc(_tds_n * 8);
var _tds_i = 0;
var _tds_m1 = f64_neg(F64_ONE);
while (_tds_i < _tds_n) {
    store64(_tds_a + _tds_i * 8, _tds_m1);
    store64(_tds_b + _tds_i * 8, F64_TWO);
    store64(_tds_c + _tds_i * 8, _tds_m1);
    store64(_tds_d + _tds_i * 8, 0);
    _tds_i = _tds_i + 1;
}
store64(_tds_d + 4 * 8, f64_from(6));
assert_eq(num_tridiag_solve(_tds_a, _tds_b, _tds_c, _tds_d, _tds_n, _tds_x), HSB_ERR_NONE,
"tridiag poisson: solve succeeds");
var _tds_bad = 0;
_tds_i = 0;
while (_tds_i < _tds_n) {
    var _tds_want = f64_from(_tds_i + 1);
    if (f64_lt(f64_abs(f64_sub(load64(_tds_x + _tds_i * 8), _tds_want)), TOL_1EM12) == 0) {
        _tds_bad = _tds_bad + 1;
    }
    _tds_i = _tds_i + 1;
}
assert_eq(_tds_bad, 0, "tridiag poisson n=5: x == (1,2,3,4,5) (Thomas sweep + back-substitution)");

# (b) ASYMMETRIC system, n = 4: sub = (1,2,3), diag = 9, super = (3,2,1),
# x = (1,2,3,4) -> d = (15,25,35,45). Diagonally dominant, so Thomas without
# pivoting is stable here. sub != super is the point: swapping the a and c
# arguments yields (1.4583, 1.875, 1.875, 4.7917) instead, which the symmetric
# Poisson system in (a) could never distinguish.
var _tda_n = 4;
var _tda_a = alloc(_tda_n * 8);
var _tda_b = alloc(_tda_n * 8);
var _tda_c = alloc(_tda_n * 8);
var _tda_d = alloc(_tda_n * 8);
var _tda_x = alloc(_tda_n * 8);
store64(_tda_a, F64_ONE); store64(_tda_a + 8, F64_TWO); store64(_tda_a + 16, f64_from(3));
store64(_tda_c, f64_from(3)); store64(_tda_c + 8, F64_TWO); store64(_tda_c + 16, F64_ONE);
var _tda_i = 0;
while (_tda_i < _tda_n) {
    store64(_tda_b + _tda_i * 8, f64_from(9));
    store64(_tda_d + _tda_i * 8, f64_from(15 + 10 * _tda_i));
    _tda_i = _tda_i + 1;
}
assert_eq(num_tridiag_solve(_tda_a, _tda_b, _tda_c, _tda_d, _tda_n, _tda_x), HSB_ERR_NONE,
"tridiag asymmetric: solve succeeds");
var _tda_bad = 0;
_tda_i = 0;
while (_tda_i < _tda_n) {
    var _tda_want = f64_from(_tda_i + 1);
    if (f64_lt(f64_abs(f64_sub(load64(_tda_x + _tda_i * 8), _tda_want)), TOL_1EM12) == 0) {
        _tda_bad = _tda_bad + 1;
    }
    _tda_i = _tda_i + 1;
}
assert_eq(_tda_bad, 0, "tridiag asymmetric n=4: x == (1,2,3,4) (sub != super)");

# Residual check: A * x_computed must reproduce d. This is the invariant form of
# the same statement -- it holds for no wrong x, and it needs no reference at all.
var _tdr_max = 0;
_tda_i = 0;
while (_tda_i < _tda_n) {
    var _tdr_row = f64_mul(load64(_tda_b + _tda_i * 8), load64(_tda_x + _tda_i * 8));
    if (_tda_i > 0) {
        _tdr_row = f64_add(_tdr_row, f64_mul(load64(_tda_a + (_tda_i - 1) * 8),
        load64(_tda_x + (_tda_i - 1) * 8)));
    }
    if (_tda_i < _tda_n - 1) {
        _tdr_row = f64_add(_tdr_row, f64_mul(load64(_tda_c + _tda_i * 8),
        load64(_tda_x + (_tda_i + 1) * 8)));
    }
    var _tdr_r = f64_abs(f64_sub(_tdr_row, load64(_tda_d + _tda_i * 8)));
    if (f64_gt(_tdr_r, _tdr_max) == 1) { _tdr_max = _tdr_r; }
    _tda_i = _tda_i + 1;
}
assert_eq(f64_lt(_tdr_max, TOL_1EM12), 1, "tridiag asymmetric: residual |A x - d| < 1e-12");

test_group("symbolic_ext: integration, LaTeX, pattern matching");
# d/dx of the integral must recover the integrand (up to simplification):
# integral of x is x^2/2, whose derivative evaluated at x=3 is 3.
var se_x = expr_var(str_from("x"));
var se_int = sym_integrate(se_x, str_from("x"));
assert_neq(se_int, 0, "sym_integrate(x, x) returns an expression");
var se_d = expr_simplify(expr_diff(se_int, str_from("x")));
var se_binds = vec_new();
vec_push(se_binds, expr_bind(str_from("x"), f64_from(3)));
assert(f64_approx_eq(expr_eval(se_d, se_binds), f64_from(3), LOOSE_TOL_M),
"d/dx(integral of x) evaluates to x at x=3");
# integral of a constant c is c*x -> at x=4 with c=5 gives 20
var se_ic = sym_integrate(expr_const(f64_from(5)), str_from("x"));
var se_b2 = vec_new();
vec_push(se_b2, expr_bind(str_from("x"), f64_from(4)));
assert(f64_approx_eq(expr_eval(se_ic, se_b2), f64_from(20), LOOSE_TOL_M),
"integral of const 5 evaluates to 5x = 20 at x=4");
# LaTeX rendering. != 0 plus len > 0 passes for ANY non-empty output --
# including one that drops every \\left(...\\right) group. Pin the strings.
# Integral-valued constants render as bare integers (_latex_fmt_const), a
# convention already pinned by the carry test at the end of this file.
var se_tex = sym_to_latex(expr_add(se_x, expr_const(F64_ONE)));
assert_neq(se_tex, 0, "sym_to_latex returns a Str");
assert(str_len(se_tex) > 0, "sym_to_latex output is non-empty");
assert_eq(str_eq_cstr(se_tex, "x + 1"), 1, "latex: x + 1");
assert_eq(str_eq_cstr(sym_to_latex(expr_add(se_x, expr_neg(expr_const(F64_TWO)))), "x - 2"), 1,
"latex: a + neg(b) folds to a - b");
assert_eq(str_eq_cstr(sym_to_latex(expr_mul(expr_const(F64_TWO), expr_const(f64_from(3)))),
"2 \\cdot 3"), 1, "latex: number*number needs \\cdot");
assert_eq(str_eq_cstr(sym_to_latex(expr_mul(expr_const(F64_TWO),
expr_add(se_x, expr_const(F64_ONE)))), "2 \\left(x + 1\\right)"), 1,
"latex: juxtaposition + parenthesized sum");
assert_eq(str_eq_cstr(sym_to_latex(expr_pow(se_x, expr_const(f64_neg(F64_ONE)))),
"\\frac{1}{x}"), 1, "latex: x^(-1) -> \\frac{1}{x}");
assert_eq(str_eq_cstr(sym_to_latex(expr_pow(se_x, expr_const(F64_HALF))), "\\sqrt{x}"), 1,
"latex: x^(1/2) -> \\sqrt{x}");
assert_eq(str_eq_cstr(sym_to_latex(expr_const(f64_neg(F64_TWO))), "{-2}"), 1,
"latex: bare negative constant is braced");
assert_eq(str_eq_cstr(sym_to_latex(expr_var(str_from("theta"))), "\\mathrm{theta}"), 1,
"latex: multi-char identifier gets \\mathrm");
assert_eq(str_eq_cstr(sym_to_latex(expr_add(expr_mul(expr_const(f64_from(3)),
expr_pow(se_x, expr_const(F64_TWO))), expr_neg(expr_sin(se_x)))),
"3 x^{2} - \\sin\\left(x\\right)"), 1, "latex: 3x^2 - sin(x)");
# GAP: every assertion above renders MUL and NEG only in paren==0 position, so
# the MUL \left(...\right) guard and the whole EXPR_NEG branch are unreached.
# if (paren == 1) -> if (paren == 9) in the MUL arm, "-" -> "+" in the NEG
# arm, and dropping the paren=1 argument on either child all survive otherwise.
var se_y = expr_var(str_from("y"));
var se_z = expr_var(str_from("z"));
assert_eq(str_eq_cstr(sym_to_latex(expr_mul(se_x, expr_mul(se_y, se_z))),
"x \\left(y z\\right)"), 1, "latex: a MUL operand of a MUL is parenthesized");
assert_eq(str_eq_cstr(sym_to_latex(expr_mul(expr_neg(se_x), se_y)), "-x y"), 1,
"latex: the EXPR_NEG arm itself emits a minus");
assert_eq(str_eq_cstr(sym_to_latex(expr_mul(expr_neg(expr_add(se_x, se_y)), se_z)),
"-\\left(x + y\\right) z"), 1, "latex: NEG of a sum keeps its parens");
assert_eq(str_eq_cstr(sym_to_latex(expr_add(se_x, expr_neg(expr_add(se_y, se_z)))),
"x - \\left(y + z\\right)"), 1, "latex: a - (b + c), not the wrong a - b + c");
# Pattern matching. sym_match takes a PATTERN (PAT_* tag space, built with
# pat_*), not an Expr — passing an Expr silently returns 0, which is why the
# first version of this test failed.
assert_eq(sym_match(pat_wildcard(str_from("a")), expr_const(F64_TWO)), 1,
"sym_match: wildcard matches a constant");
assert_eq(sym_match(pat_wildcard(str_from("a")), expr_var(str_from("x"))), 1,
"sym_match: wildcard matches a variable");
assert_eq(sym_match(pat_any_const(str_from("c")), expr_const(F64_TWO)), 1,
"sym_match: any_const matches a constant");
assert_eq(sym_match(pat_any_const(str_from("c")), expr_var(str_from("x"))), 0,
"sym_match: any_const does NOT match a variable");
# Structural: pattern a + b against x + 1
assert_eq(sym_match(pat_add(pat_wildcard(str_from("a")), pat_wildcard(str_from("b"))),
expr_add(se_x, expr_const(F64_ONE))), 1,
"sym_match: (a + b) matches (x + 1)");
assert_eq(sym_match(pat_mul(pat_wildcard(str_from("a")), pat_wildcard(str_from("b"))),
expr_add(se_x, expr_const(F64_ONE))), 0,
"sym_match: (a * b) does NOT match (x + 1)");
# Bindings are returned on a successful match
assert_neq(sym_match_bindings(pat_wildcard(str_from("a")), expr_const(F64_TWO)), 0,
"sym_match_bindings returns bindings on match");

test_group("collision_core: hull pre-sort is a correct O(n log n) sort");

var hs_n = 2000;
var hs_pts = vec_new();
var hs_i = 0;
while (hs_i < hs_n) {
    vec_push(hs_pts, hvec2_new(f64_from((hs_i * 2654435761) % 10007),
    f64_from((hs_i * 40503) % 10009)));
    hs_i = hs_i + 1;
}
var hs_idx = vec_new();
hs_i = 0;
while (hs_i < hs_n) {
    vec_push(hs_idx, hs_i);
    hs_i = hs_i + 1;
}
_col_sort_indices_by_xy(hs_idx, hs_pts, hs_n);
# Zero inversions under the module's own order predicate.
var hs_inv = 0;
hs_i = 1;
while (hs_i < hs_n) {
    if (_col_xy_greater(hs_pts, vec_get(hs_idx, hs_i - 1), vec_get(hs_idx, hs_i)) == 1) {
        hs_inv = hs_inv + 1;
    }
    hs_i = hs_i + 1;
}
assert_eq(hs_inv, 0, "hull pre-sort: zero inversions over 2000 points");
# ...and a permutation: heapsort must not invent or drop elements.
var hs_seen = alloc(hs_n * 8);
hs_i = 0;
while (hs_i < hs_n) {
    store64(hs_seen + hs_i * 8, 0);
    hs_i = hs_i + 1;
}
hs_i = 0;
while (hs_i < hs_n) {
    var hv = vec_get(hs_idx, hs_i);
    store64(hs_seen + hv * 8, load64(hs_seen + hv * 8) + 1);
    hs_i = hs_i + 1;
}
var hs_bad = 0;
hs_i = 0;
while (hs_i < hs_n) {
    if (load64(hs_seen + hs_i * 8) != 1) { hs_bad = hs_bad + 1; }
    hs_i = hs_i + 1;
}
assert_eq(hs_bad, 0, "hull pre-sort: result is a permutation (multiset preserved)");
# The hull itself is unchanged by the rewrite (fingerprint pinned against the
# pre-2.6.15 insertion sort, which produced byte-identical output).
var hs_hull = convex_hull_2d(hs_pts, hs_n);
assert_eq(vec_len(hs_hull), 17, "convex_hull_2d(2000 scattered) has 17 vertices");

test_group("collision_mesh: half-edge twin pairing invariants");
# 33x33 grid -> 2048 triangles, 6144 half-edges, 4*(33-1) = 128 boundary edges.
var hm_w = 33;
var hm_tris = vec_new();
var hm_gy = 0;
while (hm_gy < hm_w - 1) {
    var hm_gx = 0;
    while (hm_gx < hm_w - 1) {
        var hm_v = hm_gy * hm_w + hm_gx;
        vec_push(hm_tris, hm_v);
        vec_push(hm_tris, hm_v + 1);
        vec_push(hm_tris, hm_v + hm_w + 1);
        vec_push(hm_tris, hm_v);
        vec_push(hm_tris, hm_v + hm_w + 1);
        vec_push(hm_tris, hm_v + hm_w);
        hm_gx = hm_gx + 1;
    }
    hm_gy = hm_gy + 1;
}
var hm_ntris = vec_len(hm_tris) / 3;
var hm_mesh = halfedge_from_triangles(hm_tris, hm_ntris, hm_w * hm_w);
assert_neq(hm_mesh, 0, "halfedge_from_triangles(2048 tris) returns a mesh");
var hm_hes = HalfEdgeMesh_half_edges(hm_mesh);
assert_eq(vec_len(hm_hes), hm_ntris * 3, "half-edge count == 3 * n_tris");
var hm_paired = 0;
var hm_boundary = 0;
var hm_bad = 0;
var hm_i = 0;
while (hm_i < vec_len(hm_hes)) {
    var hm_tw = HalfEdge_twin(vec_get(hm_hes, hm_i));
    if (hm_tw == _COL_SENTINEL) {
        hm_boundary = hm_boundary + 1;
    } else {
        hm_paired = hm_paired + 1;
        if (hm_tw < 0 || hm_tw >= vec_len(hm_hes)) { hm_bad = hm_bad + 1; }
        else {
            if (HalfEdge_twin(vec_get(hm_hes, hm_tw)) != hm_i) { hm_bad = hm_bad + 1; }
        }
    }
    hm_i = hm_i + 1;
}
assert_eq(hm_bad, 0, "twin(twin(i)) == i for every paired half-edge");
assert_eq(hm_boundary, 4 * (hm_w - 1), "boundary half-edge count == 4*(W-1) = 128");
assert_eq(hm_paired + hm_boundary, vec_len(hm_hes), "every half-edge is paired or boundary");
assert_eq(hm_paired % 2, 0, "paired half-edges come in pairs");

test_group("calc_ext: B-spline / NURBS reject ill-formed degree");
# A degree-d B-spline needs at least d+1 control points. Only `n_pts != 0` and the
# knot-count relation were checked through 2.6.13, so degree >= n_pts fell through
# to de Boor with a NEGATIVE control-point index — an out-of-bounds read that
# dereferenced a wild pointer instead of returning the documented 0.
var ce_cps = alloc(3 * 24);
var ce_kn = alloc(7 * 8);
var ce_i = 0;
while (ce_i < 7) {
    store64(ce_kn + ce_i * 8, f64_from(ce_i));
    ce_i = ce_i + 1;
}
assert_eq(calc_bspline(3, ce_cps, 3, ce_kn, 7, f64_from(3)), 0,
"calc_bspline: n_pts <= degree -> 0 (no wild deref)");
assert_eq(calc_nurbs(3, ce_cps, ce_cps, 3, ce_kn, 7, f64_from(3)), 0,
"calc_nurbs: n_pts <= degree -> 0");
assert_eq(calc_bspline(0 - 1, ce_cps, 3, ce_kn, 3, F64_ONE), 0,
"calc_bspline: negative degree -> 0");

# ------------------------------------------------------------------
test_group("calc_ext: calc_monotone_cubic is actually monotone (2.8.3)");
# The function had NO assertions of any kind before 2.8.3, and it was not
# monotone: Fritsch-Carlson has TWO parts and only the alpha^2 + beta^2 <= 9
# circle was implemented. The circle test squares its arguments, so it is blind
# to a tangent that points against its own secant — precisely what the averaged
# tangent does at a local extremum, where it inherits the sign of the larger
# neighbouring secant. Measured against exact-rational extrema of the Hermite
# cubic on 60,000 random data sets containing an extremum: 58.6% left their own
# [y_k, y_k+1] box, by up to 57.6.
#
# xs = 0,1,2,3   ys = 0,10,1,0 — one interior maximum. Secants +10, -9, -1;
# averaged tangent at x=1 is +0.5 while the secant of [1,2] is -9, giving
# alpha = -0.056 and alpha^2 + beta^2 = 0.31, comfortably inside the circle.
# The resulting cubic on [1,2] is 13.5t^3 - 23t^2 + 0.5t + 10, which climbs
# above the peak it is supposed to interpolate. With the sign condition the
# tangent is clamped to 0 and the cubic is 13t^3 - 22t^2 + 10, monotone.
var mc_x = _f64arr_alloc(4);
var mc_y = _f64arr_alloc(4);
_f64arr_set(mc_x, 0, 0);
_f64arr_set(mc_x, 1, F64_ONE);
_f64arr_set(mc_x, 2, F64_TWO);
_f64arr_set(mc_x, 3, f64_from(3));
_f64arr_set(mc_y, 0, 0);
_f64arr_set(mc_y, 1, f64_from(10));
_f64arr_set(mc_y, 2, F64_ONE);
_f64arr_set(mc_y, 3, 0);
assert_eq(f64_gt(calc_monotone_cubic(mc_x, mc_y, 4,
f64_add(F64_ONE, f64_div(F64_ONE, f64_from(64)))), f64_from(10)), 0,
"monotone_cubic: the sample just past the peak does not exceed the peak");
assert_eq(f64_gt(_mc_box_violation(mc_x, mc_y, 4, 256), TOL_1EM12), 0,
"monotone_cubic: no interval leaves its own [y_k, y_k+1] box");
assert_eq(f64_gt(_mc_backstep(mc_x, mc_y, 4, 1, 256), TOL_1EM12), 0,
"monotone_cubic: the descending interval never turns back upwards");

# The mirror case: a local MINIMUM must not undershoot the trough.
var mc_nx = _f64arr_alloc(4);
var mc_ny = _f64arr_alloc(4);
_f64arr_set(mc_nx, 0, 0);
_f64arr_set(mc_nx, 1, F64_ONE);
_f64arr_set(mc_nx, 2, F64_TWO);
_f64arr_set(mc_nx, 3, f64_from(3));
_f64arr_set(mc_ny, 0, f64_from(10));
_f64arr_set(mc_ny, 1, 0);
_f64arr_set(mc_ny, 2, f64_from(9));
_f64arr_set(mc_ny, 3, f64_from(10));
assert_eq(f64_gt(_mc_box_violation(mc_nx, mc_ny, 4, 256), TOL_1EM12), 0,
"monotone_cubic: local minimum -- no undershoot below the trough");

# NO REGRESSION on strictly monotone data, which is the class the function was
# already right about: all secants share a sign there, so alpha and beta are
# positive and the sign condition is a no-op. Verified bit-identical tangents on
# 60,000 strictly monotone sets; these two values are the pre-2.8.3 output.
var mc_sx = _f64arr_alloc(4);
var mc_sy = _f64arr_alloc(4);
_f64arr_set(mc_sx, 0, 0);
_f64arr_set(mc_sx, 1, F64_ONE);
_f64arr_set(mc_sx, 2, f64_from(3));
_f64arr_set(mc_sx, 3, f64_from(6));
_f64arr_set(mc_sy, 0, 0);
_f64arr_set(mc_sy, 1, F64_ONE);
_f64arr_set(mc_sy, 2, f64_from(5));
_f64arr_set(mc_sy, 3, f64_from(6));
assert_eq(calc_monotone_cubic(mc_sx, mc_sy, 4, F64_HALF), 0x3FDC000000000000,
"monotone_cubic: strictly monotone f(0.5) bit-identical to 2.8.2");
assert_eq(calc_monotone_cubic(mc_sx, mc_sy, 4, F64_TWO), 0x400913B322151FAB,
"monotone_cubic: strictly monotone f(2.0) bit-identical to 2.8.2");
assert_eq(f64_gt(_mc_box_violation(mc_sx, mc_sy, 4, 256), TOL_1EM12), 0,
"monotone_cubic: strictly monotone stays inside every box");
assert_eq(calc_monotone_cubic(mc_sx, mc_sy, 4, f64_from(7)), 0,
"monotone_cubic: query past the last knot -> 0");
assert_eq(calc_monotone_cubic(mc_sx, mc_sy, 1, 0), 0,
"monotone_cubic: n < 2 -> 0");

test_group("calc_ext / calc / noise_simplex: fBm normalisation is guarded");
# All four fBm entry points divided by an amplitude accumulator that is still
# exactly 0 when octaves <= 0, returning NaN from a function documenting a
# roughly [-1, 1] range — and NaN then propagated through every downstream sample.
var fb2 = fbm_2d(F64_ONE, F64_ONE, 0, F64_ONE, F64_ONE, F64_HALF);
assert_eq(f64_eq(fb2, fb2), 1, "fbm_2d(octaves=0) is not NaN");
assert_eq(f64_to(fb2), 0, "fbm_2d(octaves=0) == 0");
var fb3 = fbm_3d(F64_ONE, F64_ONE, F64_ONE, 0, F64_ONE, F64_ONE, F64_HALF);
assert_eq(f64_eq(fb3, fb3), 1, "fbm_3d(octaves=0) is not NaN");
var sf2 = simplex_fbm_2d(F64_ONE, F64_ONE, 0, F64_ONE, F64_ONE, F64_HALF);
assert_eq(f64_eq(sf2, sf2), 1, "simplex_fbm_2d(octaves=0) is not NaN");
var sf3 = simplex_fbm_3d(F64_ONE, F64_ONE, F64_ONE, 0, F64_ONE, F64_ONE, F64_HALF);
assert_eq(f64_eq(sf3, sf3), 1, "simplex_fbm_3d(octaves=0) is not NaN");
# and a real call is still finite and in range
var fb_ok = fbm_2d(F64_ONE, F64_TWO, 4, F64_ONE, F64_ONE, F64_HALF);
assert_eq(f64_eq(fb_ok, fb_ok), 1, "fbm_2d(octaves=4) is finite");
assert_eq(f64_le(f64_abs(fb_ok), F64_TWO), 1, "fbm_2d(octaves=4) is in a sane range");

test_group("spatial: kdtree_build survives coincident points");
# _kd_partition splits on the axis VALUE midpoint. That separates properly
# whenever lo < hi, so it can only degenerate when every point shares the axis
# value — where the old "one item per side" clamp peeled ONE element per level,
# giving O(n) recursion depth. Measured on the pre-fix code: fine at 40k,
# **SIGSEGV at 60k**. 60000 is the proven threshold and costs ~24 ms.
var kd_n = 60000;
var kd_pts = alloc(kd_n * 8);
var kd_i = 0;
while (kd_i < kd_n) {
    store64(kd_pts + kd_i * 8, hvec3_new(F64_ONE, F64_TWO, f64_from(3)));
    kd_i = kd_i + 1;
}
assert_neq(kdtree_build(kd_pts, kd_n), 0,
"kdtree_build(60000 coincident points) returns a tree (no stack overflow)");
# Pruning must still be correct once the positional fallback fires: build a tree
# that is half coincident, half spread, and demand an exact nearest-neighbour hit.
var kd_m = 4000;
var kd_p2 = alloc(kd_m * 8);
kd_i = 0;
while (kd_i < kd_m) {
    if (kd_i < kd_m / 2) { store64(kd_p2 + kd_i * 8, hvec3_new(0, 0, 0)); }
    else { store64(kd_p2 + kd_i * 8, hvec3_new(f64_from(kd_i), f64_from(kd_i), f64_from(kd_i))); }
    kd_i = kd_i + 1;
}
var kd_t2 = kdtree_build(kd_p2, kd_m);
assert_neq(kd_t2, 0, "kdtree_build(half-coincident) returns a tree");
var kd_tv = f64_from(kd_m - 1);
assert_eq(kdtree_nearest(kd_t2, kd_p2, hvec3_new(kd_tv, kd_tv, kd_tv)), kd_m - 1,
"kdtree_nearest still finds the exact point (pruning correct)");

test_group("einsum: malformed notation must error, not mis-compute");
assert_eq(einsum(str_from("i9,jk->ik"), es_two, 2), 0, "einsum: digit in spec -> 0");
assert_eq(einsum(str_from("IJ,JK->IK"), es_two, 2), 0, "einsum: uppercase -> 0");
assert_eq(einsum(str_from("ijklm,jk->ik"), es_two, 2), 0, "einsum: rank > MAX_RANK -> 0");
assert_eq(einsum(str_from("ijk,jk->ik"), es_two, 2), 0, "einsum: rank != tensor rank -> 0");
assert_eq(einsum(str_from("ij,jk"), es_two, 2), 0, "einsum: missing -> separator -> 0");

# ================================================================
# 2.7.0-A -- the six 2026-08-03 findings that the 2.6.12-2.6.15 arc
# missed. Every assertion below FAILS against the pre-2.7.0 source.
# ================================================================

test_group("f64_fmod: truncated, not floored (sign of the DIVIDEND)");

# The whole point of the fix. floor() gives the sign of the divisor, trunc()
# gives the sign of the dividend, and only the latter is fmod.
assert_eq(f64_to(f64_fmod(f64_neg(f64_from(7)), f64_from(3))), (0 - 1),
"fmod(-7, 3) = -1 (floor form gave +2)");
assert_eq(f64_to(f64_fmod(f64_from(7), f64_neg(f64_from(3)))), 1,
"fmod(7, -3) = +1 (floor form gave -2)");
assert_eq(f64_to(f64_fmod(f64_from(7), f64_from(3))), 1, "fmod(7, 3) = 1");
assert_eq(f64_to(f64_fmod(f64_neg(f64_from(7)), f64_neg(f64_from(3)))), (0 - 1),
"fmod(-7, -3) = -1");

# Non-integer quotient: -5.5 mod 2 is -1.5 truncated, +0.5 floored.
var fm_a = f64_neg(f64_div(f64_from(11), f64_from(2)));
var fm_r = f64_fmod(fm_a, f64_from(2));
assert_eq(fm_r, f64_neg(f64_div(f64_from(3), f64_from(2))), "fmod(-5.5, 2) = -1.5");

# Contract: y == 0 returns 0.
assert_eq(f64_fmod(f64_from(7), 0), 0, "fmod(x, 0) = 0");

test_group("f64_copysign: the SIGN BIT of y, not an ordered comparison");

var cs_neg_zero = 0x8000_0000_0000_0000;

# -0.0 is EQUAL to +0.0, so the old `f64_lt(y, 0)` test could not see it.
assert_eq(f64_copysign(f64_from(3), cs_neg_zero), f64_neg(f64_from(3)),
"copysign(3, -0.0) = -3 (ordered form gave +3)");
# ... and the old form could never PRODUCE -0.0 either.
assert_eq(f64_copysign(0, f64_neg(F64_ONE)), cs_neg_zero,
"copysign(0, -1) = -0.0 (ordered form gave +0.0)");
assert_eq(f64_copysign(f64_from(3), f64_from(2)), f64_from(3), "copysign(3, 2) = 3");
assert_eq(f64_copysign(f64_neg(f64_from(5)), f64_from(2)), f64_from(5), "copysign(-5, 2) = 5");
assert_eq(f64_copysign(f64_neg(f64_from(5)), f64_neg(F64_ONE)), f64_neg(f64_from(5)),
"copysign(-5, -1) = -5");
assert_eq(f64_copysign(f64_from(3), 0), f64_from(3), "copysign(3, +0.0) = +3");

test_group("geo_ray_capsule: ray parallel to the capsule axis");

# a == dot(d_perp, d_perp) is exactly 0 here, so disc is exactly +0.0 -- which
# is NOT < 0, so the pre-2.7.0 code took the quadratic branch and evaluated
# 0.5/0 = +Inf, returning NaN.
var rc_cap = geo_capsule_new(hvec3_zero(), hvec3_new(0, 0, f64_from(4)), F64_ONE);
var rc_par = geo_ray_new(hvec3_new(0, 0, f64_neg(f64_from(10))), hvec3_unit_z());
var rc_t = geo_ray_capsule(rc_par, rc_cap);
assert_eq(f64_to(rc_t), 9, "parallel ray hits the start cap at t = 9");
# A NaN return would satisfy neither of these (both comparisons are unordered).
assert_eq(f64_gt(rc_t, 0), 1, "parallel-ray hit is a real ordered number (not NaN)");

# Parallel and 5 units off a radius-1 axis: a genuine miss, contract says 0.
var rc_miss = geo_ray_new(hvec3_new(f64_from(5), 0, f64_neg(f64_from(10))), hvec3_unit_z());
assert_eq(geo_ray_capsule(rc_miss, rc_cap), 0, "parallel ray outside the radius misses -> 0");

# Parallel, aimed the other way: the capsule is entirely behind the ray.
var rc_away = geo_ray_new(hvec3_new(0, 0, f64_neg(f64_from(10))),
hvec3_new(0, 0, f64_neg(F64_ONE)));
assert_eq(geo_ray_capsule(rc_away, rc_cap), 0, "parallel ray pointing away misses -> 0");

test_group("lorentz_is_valid: tolerance relative to the matrix, not absolute");

# lorentz_boost_x takes RAPIDITY. cosh(10) is 11013, so the entries of
# Lambda^T eta Lambda are O(1.2e8) and one ulp there is 1.5e-8 -- ten thousand
# times the fixed 1e-12 the pre-2.7.0 code demanded. A perfectly valid boost
# was rejected.
assert_eq(lorentz_is_valid(lorentz_boost_x(f64_from(10))), 1, "boost rapidity 10 is valid");
assert_eq(lorentz_is_valid(lorentz_boost_y(f64_from(10))), 1, "boost_y rapidity 10 is valid");
assert_eq(lorentz_is_valid(lorentz_boost_z(f64_from(8))), 1, "boost_z rapidity 8 is valid");
assert_eq(lorentz_is_valid(lorentz_identity()), 1, "identity is valid");
assert_eq(lorentz_is_valid(lorentz_boost_x(F64_ONE)), 1, "boost rapidity 1 is valid");

# The relaxation must not make the predicate vacuous: a non-Lorentzian matrix
# is still rejected, because its defect is O(scale^2), not O(1e-12).
var lv_bad = m4_identity();
m4_set(lv_bad, 0, 0, f64_from(2));
assert_eq(lorentz_is_valid(lv_bad), 0, "diag(2,1,1,1) is NOT a Lorentz transform");
var lv_bad2 = lorentz_boost_x(f64_from(10));
m4_set(lv_bad2, 2, 2, f64_from(3));
assert_eq(lorentz_is_valid(lv_bad2), 0, "perturbed boost is still rejected");

test_group("cmat_exp: the scaling loop terminates on a non-finite norm");

# Halving never brings +Inf below 1, so the pre-2.7.0 loop spun forever. That
# this suite reaches the next line at all is the assertion.
var ce_inf = cmat_new(2, 2);
cmat_set(ce_inf, 0, 0, cx_real(_GEO_F64_POS_INF));
cmat_set(ce_inf, 1, 1, cx_one());
assert_neq(cmat_exp(ce_inf), 0, "cmat_exp(+Inf entry) returns instead of hanging");

# And the ordinary path still works: exp(0) = I.
var ce_zero = cmat_new(2, 2);
var ce_i = cmat_exp(ce_zero);
assert_eq(f64_to(HComplex_re(cmat_get(ce_i, 0, 0))), 1, "exp(0 matrix) diagonal = 1");
assert_eq(f64_to(HComplex_re(cmat_get(ce_i, 0, 1))), 0, "exp(0 matrix) off-diagonal = 0");
assert_eq(f64_to(HComplex_re(cmat_get(ce_i, 1, 1))), 1, "exp(0 matrix) diagonal = 1 (1,1)");

# ================================================================
# 2.7.0-B -- the three high findings from the 2026-08-04 re-audit.
# geo_advanced.cyr is the largest module (1,261 lines) and had ZERO
# coverage on GJK / EPA / BVH / TOI before this block.
# ================================================================

test_group("cmat_mul: conformability, not an out-of-bounds read");

# 2x3 times 2x2 is undefined. The inner loop ran k over cols(a) = 3 while b's
# buffer holds only rows(b)*cols(b) = 4 elements, so k = 2 read past it.
var cm_2x3 = cmat_new(2, 3);
var cm_2x2 = cmat_new(2, 2);
var cm_3x2 = cmat_new(3, 2);
assert_eq(cmat_mul(cm_2x3, cm_2x2), 0, "2x3 * 2x2 is non-conformable -> 0");
assert_neq(cmat_mul(cm_2x3, cm_3x2), 0, "2x3 * 3x2 IS conformable -> matrix");
assert_eq(cmat_rows(cmat_mul(cm_2x3, cm_3x2)), 2, "conformable product has 2 rows");
assert_eq(cmat_cols(cmat_mul(cm_2x3, cm_3x2)), 2, "conformable product has 2 cols");
assert_eq(cmat_mul(0, cm_2x2), 0, "cmat_mul(null, m) -> 0, not a null deref");
assert_eq(cmat_mul(cm_2x2, 0), 0, "cmat_mul(m, null) -> 0, not a null deref");

# The designed 0 must survive being fed onward instead of being dereferenced.
assert_eq(cmat_add(0, cm_2x2), 0, "cmat_add(null, m) -> 0");
assert_eq(cmat_sub(cm_2x2, 0), 0, "cmat_sub(m, null) -> 0");
assert_eq(cmat_add(cm_2x3, cm_2x2), 0, "cmat_add on mismatched shapes -> 0");
assert_eq(cmat_scale(0, cx_one()), 0, "cmat_scale(null) -> 0");
assert_eq(cmat_adjoint(0), 0, "cmat_adjoint(null) -> 0");
assert_eq(cmat_trace(0), 0, "cmat_trace(null) -> 0");
# cmat_commutator feeds cmat_mul's result straight into cmat_sub.
assert_eq(cmat_commutator(cm_2x3, cm_2x2), 0, "commutator of non-conformable -> 0");
assert_neq(cmat_commutator(cm_2x2, cm_2x2), 0, "commutator of conformable -> matrix");

test_group("bvh_build: coincident AABBs must not recurse O(n) deep");

# Every center is identical, so every center IS the split midpoint and
# `cv < mid_val` is false for all of them -- the partition never advances. The
# pre-2.7.0 clamp then forced a 1-vs-(n-1) split, giving recursion depth n and a
# quadratic build. These assertions cover the RESULT; the cost regression is
# guarded by the `bvh_degenerate_20k` benchmark, since 130x slower is a timing
# fact, not something an assert_eq can state.
var bv_n = 20000;
var bv_arr = alloc(bv_n * 8);
var bv_pt = hvec3_new(F64_ONE, F64_ONE, F64_ONE);
var bv_box = geo_aabb_new(bv_pt, hvec3_new(F64_TWO, F64_TWO, F64_TWO));
var bv_i = 0;
while (bv_i < bv_n) {
    store64(bv_arr + bv_i * 8, bv_box);
    bv_i = bv_i + 1;
}
var bv_tree = bvh_build(bv_arr, bv_n);
assert_neq(bv_tree, 0, "bvh_build(20k coincident AABBs) returns a tree");

# Depth is not the only thing that has to survive: the tree must still answer.
var bv_hits = bvh_query_aabb(bv_tree, bv_box);
assert_eq(vec_len(bv_hits), bv_n, "every coincident box is still reported");
var bv_none = geo_aabb_new(hvec3_new(f64_from(100), f64_from(100), f64_from(100)),
hvec3_new(f64_from(101), f64_from(101), f64_from(101)));
assert_eq(vec_len(bvh_query_aabb(bv_tree, bv_none)), 0, "disjoint query returns nothing");

# A well-separated set must keep working -- the median fallback only fires on the
# degenerate branch and must not disturb the normal partition.
var bv_m = 64;
var bv_sep = alloc(bv_m * 8);
var bv_j = 0;
while (bv_j < bv_m) {
    var bv_x = f64_from(bv_j * 10);
    store64(bv_sep + bv_j * 8,
    geo_aabb_new(hvec3_new(bv_x, 0, 0),
    hvec3_new(f64_add(bv_x, F64_ONE), F64_ONE, F64_ONE)));
    bv_j = bv_j + 1;
}
var bv_tree2 = bvh_build(bv_sep, bv_m);
assert_neq(bv_tree2, 0, "bvh_build(separated) returns a tree");
var bv_q = geo_aabb_new(hvec3_new(f64_from(30), 0, 0),
hvec3_new(f64_from(31), F64_ONE, F64_ONE));
assert_eq(vec_len(bvh_query_aabb(bv_tree2, bv_q)), 1, "separated query finds exactly its box");

test_group("time_of_impact: the horizon is max_t, not 0.64 units");

# A needs B to travel 3 units before they touch (centres 5 apart, radii 1+1).
# The pre-2.7.0 loop advanced GJK_MAX_ITER * 0.01 = 0.64 units total and then
# returned 0 -- a false negative from a collision query, with max_t ignored.
var toi_a = hvec4_new(0, 0, 0, F64_ONE);
var toi_b = hvec4_new(f64_from(5), 0, 0, F64_ONE);
var toi_still = hvec3_zero();
var toi_left = hvec3_new(f64_neg(F64_ONE), 0, 0);
var toi_t = alloc(8);
var toi_n = alloc(8);

var toi_hit = time_of_impact(&_mpr_sup_sphere, toi_a, toi_still,
&_mpr_sup_sphere, toi_b, toi_left, f64_from(10), toi_t, toi_n);
assert_eq(toi_hit, 1, "collision 3 units out IS found within max_t = 10");
assert_eq(f64_gt(load64(toi_t), F64_TWO), 1, "impact time is past t = 2");
assert_eq(f64_lt(load64(toi_t), f64_from(4)), 1, "impact time is before t = 4");

# max_t must still be honoured as a genuine bound in the other direction.
assert_eq(time_of_impact(&_mpr_sup_sphere, toi_a, toi_still,
&_mpr_sup_sphere, toi_b, toi_left, F64_ONE, toi_t, toi_n), 0,
"same approach with max_t = 1 is out of range -> 0");

# Receding: never collides no matter how long the horizon.
var toi_right = hvec3_new(F64_ONE, 0, 0);
assert_eq(time_of_impact(&_mpr_sup_sphere, toi_a, toi_still,
&_mpr_sup_sphere, toi_b, toi_right, f64_from(100), toi_t, toi_n), 0,
"receding spheres never collide");

# Zero relative velocity and already apart -> no collision.
assert_eq(time_of_impact(&_mpr_sup_sphere, toi_a, toi_still,
&_mpr_sup_sphere, toi_b, toi_still, f64_from(10), toi_t, toi_n), 0,
"stationary and disjoint -> 0");

# Already overlapping at t = 0 -> immediate hit.
var toi_over = hvec4_new(F64_ONE, 0, 0, F64_ONE);
assert_eq(time_of_impact(&_mpr_sup_sphere, toi_a, toi_still,
&_mpr_sup_sphere, toi_over, toi_left, f64_from(10), toi_t, toi_n), 1,
"already overlapping -> hit");
assert_eq(load64(toi_t), 0, "overlap at t = 0 reports t = 0");
assert_neq(load64(toi_n), 0, "overlap at t = 0 writes a non-null contact normal");

# ------------------------------------------------------------------
# 2.8.3 — TOI vs the EXACT swept-sphere root, in the regimes a sampler
# cannot survive.
#
# Through 2.8.2 the loop walked t from 0 to max_t in _GA_TOI_MAX_STEPS equal
# steps and asked a BOOLEAN overlap test at each. A boolean says nothing about
# how far apart the shapes are, so the step could only come from the horizon,
# never from the geometry — and the overlap window in t is ~2R/|v_rel| wide.
# Small shapes, fast shapes or a long horizon all shrink the window below the
# step and the collision is tunnelled through in silence. Measured against the
# exact quadratic root, on the reverted source with the seeds below: 120/120
# missed in the tiny+fast regime, 40/40 at a 1e6-unit horizon, 37/40 on 1e-6
# geometry, 22/120 grazing — and in the uniform regime, where it does find the
# hit, 95/101 impact times were quantised LATE by up to a whole step.
#
# Conservative advancement measures the DISTANCE and steps by distance / closing
# speed, which provably cannot reach contact, so it never steps over the window.
# The references below are closed forms; none of them reads geo_advanced.cyr.
test_group("time_of_impact: exact swept-sphere root, four regimes");

var TOI_TOL6 = 0x3EB0C6F7A0B5ED8D;  # 1e-6
var TOI_TOL3 = 0x3F50624DD2F1A9FC;  # 1e-3

# (a) uniform — radii 0.2..2, |v| 0.5..4, horizon 10.
_DLR_STATE = 0x2026_0805_0000_0001;
var toiu = _toi_tally();
for (var tu = 0; tu < 101; tu = tu + 1) {
    var tu_cb = hvec3_new(_toi_frac(0 - 80, 80, 10), _toi_frac(0 - 80, 80, 10),
    _toi_frac(0 - 80, 80, 10));
    var tu_d = hvec3_length(tu_cb);
    var tu_v = hvec3_zero();
    if (f64_gt(tu_d, F64_ONE) == 1) {
        tu_v = hvec3_scale(tu_cb, f64_neg(f64_div(_toi_frac(5, 40, 10), tu_d)));
    }
    _toi_score(toiu, _toi_frac(2, 20, 10), tu_cb, _toi_frac(2, 20, 10), tu_v,
    f64_from(10), TOI_TOL6);
}
assert_eq(load64(toiu), 101, "toi/uniform: 101 pairs scored");
assert_gt(load64(toiu + 8), 40, "toi/uniform: a real share of them collide");
assert_eq(load64(toiu + 16), 0, "toi/uniform: zero false negatives");
assert_eq(load64(toiu + 24), 0, "toi/uniform: zero false positives");
assert_eq(load64(toiu + 32), 0, "toi/uniform: no impact time reported LATE (was 95/101)");
assert_eq(load64(toiu + 40), 0, "toi/uniform: none early, no null normal");

# (b) tiny + fast — radii 0.01..0.05, |v| 20..200, horizon 100. The overlap
# window is ~1e-3 in t; the old step was 100/256 = 0.39.
_DLR_STATE = 0x2026_0805_0000_0002;
var toif = _toi_tally();
for (var tf = 0; tf < 120; tf = tf + 1) {
    var tf_cb = hvec3_new(_toi_frac(0 - 500, 500, 10), _toi_frac(0 - 500, 500, 10),
    _toi_frac(0 - 500, 500, 10));
    var tf_d = hvec3_length(tf_cb);
    var tf_v = hvec3_zero();
    if (f64_gt(tf_d, F64_ONE) == 1) {
        tf_v = hvec3_scale(tf_cb, f64_neg(f64_div(_toi_frac(200, 2000, 10), tf_d)));
    }
    _toi_score(toif, _toi_frac(1, 5, 100), tf_cb, _toi_frac(1, 5, 100), tf_v,
    f64_from(100), TOI_TOL6);
}
assert_eq(load64(toif), 120, "toi/tiny+fast: 120 pairs scored");
assert_gt(load64(toif + 8), 60, "toi/tiny+fast: most of them collide");
assert_eq(load64(toif + 16), 0, "toi/tiny+fast: zero false negatives (was 120/120)");
assert_eq(load64(toif + 24), 0, "toi/tiny+fast: zero false positives");
assert_eq(load64(toif + 32), 0, "toi/tiny+fast: no impact time LATE");

# (c) grazing — impact parameter swept through ra + rb = 2, so half just touch
# and half just miss: the class a sampler is least likely to land inside.
_DLR_STATE = 0x2026_0805_0000_0003;
var toig = _toi_tally();
for (var tg = 0; tg < 120; tg = tg + 1) {
    _toi_score(toig, F64_ONE,
    hvec3_new(f64_from(0 - 20), _toi_frac(1900, 2100, 1000), 0), F64_ONE,
    hvec3_new(_toi_frac(10, 50, 10), 0, 0), f64_from(100), TOI_TOL3);
}
assert_eq(load64(toig), 120, "toi/grazing: 120 pairs scored");
assert_gt(load64(toig + 8), 30, "toi/grazing: some genuinely collide");
assert_eq(load64(toig + 16), 0, "toi/grazing: zero false negatives (was 22/120)");
assert_eq(load64(toig + 32), 0, "toi/grazing: no impact time LATE");

# (d) scale — 1e6 units away with a 1e7 horizon, and 1e-6 geometry. The old
# step was 1e7/256 = 39,000 world units in the first and 0.039 in the second;
# both are astronomically larger than the contact window.
_DLR_STATE = 0x2026_0805_0000_0004;
var toib = _toi_tally();
for (var tb = 0; tb < 40; tb = tb + 1) {
    _toi_score(toib, F64_ONE, hvec3_new(_toi_frac(10000, 1000000, 1), 0, 0), F64_ONE,
    hvec3_new(f64_neg(_toi_frac(10, 100, 10)), 0, 0), f64_from(10000000), TOI_TOL3);
}
var toim = _toi_tally();
var toi_mu = f64_div(F64_ONE, f64_from(1000000));
for (var tm = 0; tm < 40; tm = tm + 1) {
    var tm_cb = hvec3_new(f64_mul(_toi_frac(0 - 80, 80, 10), toi_mu),
    f64_mul(_toi_frac(0 - 80, 80, 10), toi_mu),
    f64_mul(_toi_frac(0 - 80, 80, 10), toi_mu));
    var tm_d = hvec3_length(tm_cb);
    var tm_v = hvec3_zero();
    if (f64_gt(tm_d, f64_mul(toi_mu, F64_HALF)) == 1) {
        tm_v = hvec3_scale(tm_cb,
        f64_neg(f64_div(f64_mul(_toi_frac(5, 40, 10), toi_mu), tm_d)));
    }
    _toi_score(toim, toi_mu, tm_cb, toi_mu, tm_v, f64_from(10), LOOSE_TOL_M);
}
assert_gt(load64(toib + 8), 30, "toi/1e6-horizon: the cases really collide");
assert_eq(load64(toib + 16), 0, "toi/1e6-horizon: zero false negatives (was 40/40)");
assert_eq(load64(toib + 24), 0, "toi/1e6-horizon: zero false positives");
assert_gt(load64(toim + 8), 30, "toi/1e-6-geometry: the cases really collide");
assert_eq(load64(toim + 16), 0, "toi/1e-6-geometry: zero false negatives (was 37/40)");
assert_eq(load64(toim + 24), 0, "toi/1e-6-geometry: zero false positives");

# (e) receding pairs must be CERTIFIED misses, not "no sample found one": the
# closing speed along the direction of closest approach is <= 0, which is a
# proof for all t, and the branch the old sampler had no way to express.
_DLR_STATE = 0x2026_0805_0000_0005;
var toir = _toi_tally();
for (var tr = 0; tr < 60; tr = tr + 1) {
    var tr_cb = hvec3_new(_toi_frac(0 - 80, 80, 10), _toi_frac(0 - 80, 80, 10),
    _toi_frac(0 - 80, 80, 10));
    var tr_d = hvec3_length(tr_cb);
    var tr_v = hvec3_zero();
    if (f64_gt(tr_d, F64_ONE) == 1) {
        tr_v = hvec3_scale(tr_cb, f64_div(_toi_frac(5, 40, 10), tr_d));
    }
    _toi_score(toir, F64_ONE, tr_cb, F64_ONE, tr_v, f64_from(1000), TOI_TOL6);
}
assert_eq(load64(toir + 24), 0, "toi/receding: zero false positives");
assert_eq(load64(toir + 16), 0, "toi/receding: zero false negatives");

# ================================================================
# 2.7.0-C -- medium correctness & safety findings.
# Every fix below was independently verified AND adversarially
# challenged against the real source before it was applied.
# ================================================================

test_group("detect_islands: negative body indices must be rejected, not subscripted");

# Only the UPPER bound was checked through 2.6.15, so a negative index sailed
# through and _col_uf_find subscripted parent[] BEFORE the array.
var isl_a_c = contact_new(0 - 3, 1, hvec3_unit_y(), F64_HALF, F64_HALF, F64_HALF, F64_ONE, F64_ONE);
var isl_a_v = vec_new();
vec_push(isl_a_v, isl_a_c);
var isl_a = detect_islands(isl_a_v, 1, 4);
assert_eq(vec_len(isl_a), 4, "detect_islands: neg body_a is skipped -> 4 singletons");
# Pins the CORRUPTION, not just the count: pre-fix, island 0 was [0, 1] -- two
# unrelated bodies fused because the OOB read of parent[-3] returned root 0.
assert_eq(vec_len(vec_get(isl_a, 0)), 1, "detect_islands: neg body_a must not merge body 0");

# Second operand independently -- a fix guarding only `ba` would still fail this.
var isl_b_c = contact_new(1, 0 - 3, hvec3_unit_y(), F64_HALF, F64_HALF, F64_HALF, F64_ONE, F64_ONE);
var isl_b_v = vec_new();
vec_push(isl_b_v, isl_b_c);
assert_eq(vec_len(detect_islands(isl_b_v, 1, 4)), 4, "detect_islands: neg body_b is skipped -> 4 singletons");

# The memory-safety half. Pre-fix this SIGSEGVs (exit 139) and the suite prints
# nothing past the group header -- the count assertions above cannot reach it,
# because small-magnitude aliasing happens to stay inside the heap.
var isl_c_c = contact_new(0 - 1000000, 1, hvec3_unit_y(), F64_HALF, F64_HALF, F64_HALF, F64_ONE, F64_ONE);
var isl_c_v = vec_new();
vec_push(isl_c_v, isl_c_c);
assert_eq(vec_len(detect_islands(isl_c_v, 1, 4)), 4, "detect_islands: large neg index must not fault");

test_group("num_ifft: an error return must not leave the caller's buffer conjugated");

# n = 3 is not a power of 2. Through 2.6.15 the conjugate pass ran FIRST, so the
# rejection came back with every imaginary part already negated.
var ift_d = alloc(48);
store64(ift_d + 0,  f64_from(1));  store64(ift_d + 8,  f64_from(2));
store64(ift_d + 16, f64_from(3));  store64(ift_d + 24, f64_from(4));
store64(ift_d + 32, f64_from(5));  store64(ift_d + 40, f64_from(6));
assert_eq(num_ifft(ift_d, 3), HSB_ERR_INVALID_INPUT, "n=3 rejected (rc is -10 either way)");
assert_eq(f64_to(load64(ift_d + 8)),  2, "ifft error leaves im[0] intact");
assert_eq(f64_to(load64(ift_d + 24)), 4, "ifft error leaves im[1] intact");
assert_eq(f64_to(load64(ift_d + 40)), 6, "ifft error leaves im[2] intact");
# Deliberate control: passes BOTH ways. It proves the corruption was confined to
# the imaginary lane -- i.e. silent, not obviously garbage.
assert_eq(f64_to(load64(ift_d + 0)), 1, "re[0] intact (control -- passes both ways)");
# One aggregate that flips sign: +12 correct, -12 corrupted.
var ift_s = f64_add(f64_add(load64(ift_d + 8), load64(ift_d + 24)), load64(ift_d + 40));
assert_eq(f64_to(ift_s), 12, "sum(im) still +12 after a failed ifft");

# The success path must be untouched: n = 4 round-trips.
var ift_r = alloc(64);
store64(ift_r + 0,  f64_from(1));  store64(ift_r + 8,  0);
store64(ift_r + 16, f64_from(2));  store64(ift_r + 24, 0);
store64(ift_r + 32, f64_from(3));  store64(ift_r + 40, 0);
store64(ift_r + 48, f64_from(4));  store64(ift_r + 56, 0);
assert_eq(num_fft(ift_r, 4), HSB_ERR_NONE, "fft n=4 ok");
assert_eq(num_ifft(ift_r, 4), HSB_ERR_NONE, "ifft n=4 ok");
assert_eq(f64_to(load64(ift_r + 0)), 1, "round-trip re[0] = 1");
assert_eq(f64_to(load64(ift_r + 48)), 4, "round-trip re[3] = 4");

test_group("levi_civita: f64 bit patterns, not raw i64");

# Raw (0 - 1) is 0xFFFF_FFFF_FFFF_FFFF -- a NEGATIVE NaN. These four catch the
# ENCODING (pre-fix, f64_to of the raw 1 subnormal truncates to 0)...
assert_eq(f64_to(levi_civita_3(0, 1, 2)), 1, "eps 012 = +1.0 as f64");
assert_eq(f64_to(levi_civita_4(0, 1, 2, 3)), 1, "eps4 0123 = +1.0 as f64");
# ...and these two catch the SIGN. They are not redundant: a mutant with the
# correct f64 encoding but f64_neg dropped passes every encoding assertion above.
assert_eq(f64_to(levi_civita_3(1, 0, 2)), (0 - 1), "eps 102 = -1.0 (pins the sign)");
assert_eq(f64_to(levi_civita_4(1, 0, 2, 3)), (0 - 1), "eps4 1023 = -1.0 (pins the sign)");

# NaN is unordered, so it fails BOTH directions of an ordered comparison -- the
# cleanest statement that the odd branch is a real number at all.
assert_eq(f64_lt(levi_civita_3(1, 0, 2), 0), 1, "eps 102 is an ordered negative, not NaN");
assert_eq(f64_gt(levi_civita_3(0, 1, 2), 0), 1, "eps 012 is an ordered positive");

# The downstream consequence: NaN * 0.0 is NaN, so a raw -1 poisoned even the
# components a contraction should leave at exactly zero.
var lc_prod = f64_mul(levi_civita_3(1, 0, 2), 0);
assert_eq(f64_eq(lc_prod, 0), 1, "eps 102 * 0.0 == 0.0 (was NaN)");
assert_eq(f64_to(levi_civita_3(0, 0, 1)), 0, "eps repeated = 0.0");

test_group("diffgeo: the documented 0 must not be dereferenced, and dims are capped");

# christoffel_symbols and riemann_tensor have capped at 16 and returned 0 since
# they were written. The downstream contractions did neither -- they dereferenced
# that 0 AND sized their own alloc from an unbounded dim (CWE-190 -> CWE-476).
var dg_ch_big = christoffel_symbols(0, 0, 100);
assert_eq(dg_ch_big, 0, "christoffel_symbols over the cap still returns 0");
assert_eq(ricci_tensor(dg_ch_big, 100), 0, "ricci_tensor(0, over-cap) -> 0, not a null store");
assert_eq(ricci_tensor(0, 4), 0, "ricci_tensor(null riemann) -> 0");
assert_eq(einstein_tensor(0, 0, 0, 4), 0, "einstein_tensor(null) -> 0");
assert_eq(weyl_tensor(0, 0, 0, 0, 4), 0, "weyl_tensor(null) -> 0");
assert_eq(geodesic_state_new(0, 0, 4), 0, "geodesic_state_new(null) -> 0");
assert_eq(geodesic_rk4(0, 0, 4, F64_HALF, 1), 0, "geodesic_rk4(null) -> 0");
assert_eq(parallel_transport(0, 0, 0, 4, F64_HALF, 1), 0, "parallel_transport(null) -> 0");
assert_eq(killing_residual(0, 0, 0, 4), 0, "killing_residual(null) -> 0");

# The dimension cap itself, on each entry point that previously had none.
assert_eq(ricci_tensor(0, 100000), 0, "ricci_tensor over the dim cap -> 0");
assert_eq(geodesic_state_new(0, 0, 100000), 0, "geodesic_state_new over the dim cap -> 0");

# wedge_1_1 was NOT in the original finding. dim = 100000 asks for 40 GB, so
# alloc returns 0 and the store wrote to address 0 -- measured exit 139.
var dg_a = alloc(32);
var dg_b = alloc(32);
assert_eq(wedge_1_1(dg_a, dg_b, 100000), 0, "wedge_1_1 over the dim cap -> 0, not a null store");
assert_eq(wedge_1_1(0, dg_b, 4), 0, "wedge_1_1(null alpha) -> 0");

# The valid path must be untouched: a real 2-sphere still contracts correctly.
assert_neq(wedge_1_1(dg_a, dg_b, 4), 0, "wedge_1_1 at dim 4 still returns a form");

test_group("symbolic render: the rounding carry must reach the integer part");

# stdlib fmt_float_buf zero-pads only when pad > 0. A fraction that rounds UP to
# exactly 10^decimals needs decimals+1 digits, so pad goes negative, the pad
# branch is skipped, and the overflowed digit lands AFTER the '.' with nothing
# carrying into the whole part.
var fc_a = f64_div(f64_from(9999999), f64_from(10000000));   # 0.9999999
var fc_sa = expr_to_str(expr_const(fc_a));
assert_eq(str_eq_cstr(fc_sa, "1.000000"), 1, "carry: 0.9999999 renders 1.000000, not 0.1000000");
assert_eq(str_len(fc_sa), 8, "carry: rounded-up render is 6 fraction digits, not 7");

var fc_b = f64_div(f64_from(29999999), f64_from(10000000));   # 2.9999999
assert_eq(str_eq_cstr(expr_to_str(expr_const(fc_b)), "3.000000"), 1,
"carry: 2.9999999 renders 3.000000, not 2.1000000");

var fc_c = f64_neg(f64_div(f64_from(9999999), f64_from(10000000)));   # -0.9999999
assert_eq(str_eq_cstr(expr_to_str(expr_const(fc_c)), "-1.000000"), 1,
"carry: negative values carry through the sign byte");

# The LaTeX path shares the helper -- this is the audit's exact value.
var fc_d = f64_div(f64_from(999999995), f64_from(1000000000));   # 0.999999995
assert_eq(str_eq_cstr(sym_to_latex(expr_const(fc_d)), "1.000000"), 1,
"carry: _latex_fmt_const shares the fix (audit's exact value)");

# Control: the fix must not perturb a value that does not carry.
var fc_e = f64_div(f64_from(1), f64_from(3));
assert_eq(str_eq_cstr(expr_to_str(expr_const(fc_e)), "0.333333"), 1,
"carry fix does not perturb non-carrying values");

test_group("kdtree: the split plane must actually separate the subtrees");

# `split_val` used to be read from items[split] -- SOME right-side value, not the
# partition plane. Every right-side point below that value then sat on the wrong
# side of its own node's pruning plane, so the query pruned subtrees that still
# held valid hits. Measured before the fix: 274 of 400 radius queries returned
# the WRONG COUNT. The suites at the time did not notice.
var KDV_N = 1500;
var kdv_pts = alloc(KDV_N * 8);
var kdv_i = 0;
while (kdv_i < KDV_N) {
    store64(kdv_pts + kdv_i * 8, hvec3_new(f64_from((kdv_i * 2654435761) % 1009),
    f64_from((kdv_i * 40503) % 1013), f64_from((kdv_i * 69069) % 1019)));
    kdv_i = kdv_i + 1;
}
var kdv_tree = kdtree_build(kdv_pts, KDV_N);
assert_neq(kdv_tree, 0, "kdtree_build(1500 scattered) returns a tree");

# The structural invariant, checked directly on every node.
assert_eq(_kdv_invariant_bad(kdv_tree, kdv_pts), 0,
"kdtree: no point sits on the wrong side of its ancestor's split plane");

# And the behaviour that invariant exists to protect, against brute force.
var kdv_bad = 0;
var kdv_q = 0;
while (kdv_q < 200) {
    var kdv_qp = hvec3_new(f64_from((kdv_q * 7919) % 1009), f64_from((kdv_q * 104729) % 1013),
    f64_from((kdv_q * 1299709) % 1019));
    if (vec_len(kdtree_within_radius(kdv_tree, kdv_pts, kdv_qp, f64_from(60)))
    != _kdv_brute(kdv_pts, KDV_N, kdv_qp, f64_from(60))) { kdv_bad = kdv_bad + 1; }
    kdv_q = kdv_q + 1;
}
assert_eq(kdv_bad, 0, "kdtree_within_radius matches brute force on 200 queries");

test_group("triangulate_polygon: partial returns are a documented contract");

# A convex quad triangulates completely: 3*(4-2) = 6 indices.
var tpc = vec_new();
vec_push(tpc, hvec2_new(0, 0));
vec_push(tpc, hvec2_new(F64_TWO, 0));
vec_push(tpc, hvec2_new(F64_TWO, F64_TWO));
vec_push(tpc, hvec2_new(0, F64_TWO));
assert_eq(vec_len(triangulate_polygon(tpc, 4)), 6, "convex quad -> complete, 3*(n-2) = 6");

# A self-intersecting polygon has no ear decomposition. The header claimed
# length = 3*(n-2) unconditionally through 2.7.0; it is actually SHORTER, and
# that is the signal a caller must test for.
var tpd = vec_new();
vec_push(tpd, hvec2_new(0, 0));
vec_push(tpd, hvec2_new(0, F64_TWO));
vec_push(tpd, hvec2_new(F64_ONE, F64_ONE));
vec_push(tpd, hvec2_new(0, F64_TWO));
vec_push(tpd, hvec2_new(F64_TWO, F64_ONE));
var tpd_len = vec_len(triangulate_polygon(tpd, 5));
# The CONTRACT is "at most 3*(n-2), a whole number of triples" -- complete OR
# partial are both valid. An earlier version of this assertion pinned `< 9`,
# i.e. it asserted that THIS input bails; the 2.7.0-O reflex-only pruning then
# triangulates it completely, which is strictly better and broke the assertion.
# Pinning which inputs happen to bail is pinning an implementation detail.
assert(tpd_len <= 9, "self-intersecting pentagon returns AT MOST 3*(n-2) = 9");
# The returned prefix is still whole triples -- a partial triangulation, not a
# truncated array.
assert_eq(tpd_len % 3, 0, "partial return is still a whole number of triples");

test_group("spatial: quadtree / octree / spatial hash had ZERO coverage");

# Three whole data structures, 11 public functions, untested through 2.7.0 --
# the same shape as the k-d tree defect that hid for three releases. Each is
# checked against brute force, not just for non-null.

# --- quadtree: 20x20 grid of points over [0,100]^2 ---
var qt = quadtree_new(0, 0, f64_from(100), f64_from(100), 6);
assert_neq(qt, 0, "quadtree_new returns a root");
var qgx = 0;
var qt_in = 0;
while (qgx < 20) {
    var qgy = 0;
    while (qgy < 20) {
        quadtree_insert(qt, f64_from(qgx * 5), f64_from(qgy * 5), qgx * 100 + qgy);
        qgy = qgy + 1;
    }
    qgx = qgx + 1;
}
# Box [10,30]x[10,30] inclusive covers grid coords 2..6 on each axis = 5*5 = 25.
var qres = quadtree_query(qt, f64_from(10), f64_from(10), f64_from(30), f64_from(30));
assert_eq(vec_len(qres), 25, "quadtree_query [10,30]^2 finds exactly 25 of 400");
# Whole-domain query must return everything.
assert_eq(vec_len(quadtree_query(qt, 0, 0, f64_from(100), f64_from(100))), 400,
"quadtree_query over the whole domain finds all 400");
# Disjoint box finds nothing.
assert_eq(vec_len(quadtree_query(qt, f64_from(200), f64_from(200), f64_from(300), f64_from(300))), 0,
"quadtree_query outside the domain finds nothing");

# --- octree: 8x8x8 grid over [0,80]^3 ---
var ot = octree_new(hvec3_zero(), hvec3_new(f64_from(80), f64_from(80), f64_from(80)), 5);
assert_neq(ot, 0, "octree_new returns a handle");
var oi = 0;
while (oi < 8) {
    var oj = 0;
    while (oj < 8) {
        var ok = 0;
        while (ok < 8) {
            octree_insert(ot, hvec3_new(f64_from(oi * 10), f64_from(oj * 10), f64_from(ok * 10)),
            oi * 64 + oj * 8 + ok);
            ok = ok + 1;
        }
        oj = oj + 1;
    }
    oi = oi + 1;
}
# [0,20]^3 inclusive covers grid 0..2 per axis = 27.
assert_eq(vec_len(octree_query(ot, hvec3_zero(), hvec3_new(f64_from(20), f64_from(20), f64_from(20)))),
27, "octree_query [0,20]^3 finds exactly 27 of 512");
assert_eq(vec_len(octree_query(ot, hvec3_zero(),
hvec3_new(f64_from(80), f64_from(80), f64_from(80)))), 512, "octree_query whole domain finds all 512");

# --- spatial hash: broadphase, so it may over-report but must never MISS ---
var sh = spatial_hash_new(f64_from(10));
assert_neq(sh, 0, "spatial_hash_new returns a handle");
var si = 0;
while (si < 100) {
    spatial_hash_insert(sh, hvec3_new(f64_from(si), f64_from(si), 0), si);
    si = si + 1;
}
# Same-cell query at the origin: points 0..9 share cell (0,0,0) with cell_size 10.
assert_eq(vec_len(spatial_hash_query_cell(sh, hvec3_zero())), 10,
"spatial_hash_query_cell finds the 10 points sharing cell (0,0,0)");
# Radius query is a broadphase: it must be a SUPERSET of the true answer.
var sh_r = spatial_hash_query_radius(sh, hvec3_zero(), f64_from(15));
var sh_true = 0;
si = 0;
while (si < 100) {
    var sd = f64_mul(f64_from(si), f64_sqrt(F64_TWO));
    if (f64_gt(sd, f64_from(15)) == 0) { sh_true = sh_true + 1; }
    si = si + 1;
}
assert(vec_len(sh_r) >= sh_true, "spatial_hash_query_radius never misses a true hit");
assert(sh_true > 0, "the radius test is non-vacuous -- there ARE true hits");
# clear() must actually empty it.
spatial_hash_clear(sh);
assert_eq(vec_len(spatial_hash_query_cell(sh, hvec3_zero())), 0,
"spatial_hash_clear empties every cell");

test_group("arena: the alloc-inside-loop sites are hoisted (bump alloc never frees)");

# 2026-08-04 audit, performance. Three allocation sites sat inside loops (or, for
# _kd_build_rec, inside a recursion) of an allocator that never returns memory, so
# the cost was proportional to the iteration count on EVERY call. Before/after
# measured with alloc_used() around a single call, scratch binaries under
# /tmp/.../tail29 and re-measured in-suite here.

# --- src/spatial.cyr: `var plane_out = alloc(8);` per _kd_build_rec call, now one
#     8-byte slot owned by kdtree_build and threaded through the recursion.
#     4,096 random points: 425,832 B before -> 393,080 B after (-32,752 B = 8 B x
#     4,094 internal nodes, -7.7%).
var kdh_n = 4096;
var kdh_pts = alloc(kdh_n * 8);
var kdh_seed = 12345;
for (var kdhi = 0; kdhi < kdh_n; kdhi = kdhi + 1) {
    kdh_seed = (kdh_seed * 1103515245 + 12345) & 0x7FFFFFFF;
    var kdh_x = f64_div(f64_from(kdh_seed % 100000), f64_from(1000));
    kdh_seed = (kdh_seed * 1103515245 + 12345) & 0x7FFFFFFF;
    var kdh_y = f64_div(f64_from(kdh_seed % 100000), f64_from(1000));
    kdh_seed = (kdh_seed * 1103515245 + 12345) & 0x7FFFFFFF;
    var kdh_z = f64_div(f64_from(kdh_seed % 100000), f64_from(1000));
    store64(kdh_pts + kdhi * 8, hvec3_new(kdh_x, kdh_y, kdh_z));
}
var kdh_a0 = alloc_used();
var kdh_root = kdtree_build(kdh_pts, kdh_n);
var kdh_bytes = alloc_used() - kdh_a0;
assert_neq(kdh_root, 0, "kdtree_build: 4096 points build");
assert_lt(kdh_bytes, kdh_n * 100,
"kdtree_build: under 100 B per point (was 103.96, now 95.96 -- the per-node plane slot is gone)");
# The tree must still be a tree: every point findable, and the split planes still
# correct. Sharing one slot is only safe because split_val is read before the two
# child calls overwrite it, so a nearest-neighbour query is the direct check.
var kdh_probe = load64(kdh_pts + 777 * 8);
assert_eq(kdtree_nearest(kdh_root, kdh_pts, kdh_probe), 777,
"kdtree_nearest: the shared plane slot did not corrupt a split (point 777 finds itself)");
# And every point in the set, not just one -- a corrupted split plane sends the
# descent down the wrong subtree and the query silently returns a different point.
var kdh_miss = 0;
for (var kdhq = 0; kdhq < kdh_n; kdhq = kdhq + 4) {
    var kdh_qp = load64(kdh_pts + kdhq * 8);
    var kdh_got = kdtree_nearest(kdh_root, kdh_pts, kdh_qp);
    if (f64_gt(hvec3_length(hvec3_sub(load64(kdh_pts + kdh_got * 8), kdh_qp)), 0) == 1) {
        kdh_miss = kdh_miss + 1;
    }
}
assert_eq(kdh_miss, 0,
"kdtree_nearest: 1024 sampled points each find a coincident nearest -- no split is stale");

# --- src/tensor.cyr: `var full_idx = alloc(rank * 8);` inside the trace loop.
#     200x200 full trace: 3,256 B before -> 72 B after (-97.8%).
var tnh_shape = alloc(16);
store64(tnh_shape, 200);
store64(tnh_shape + 8, 200);
var tnh_t = tensor_new(2, tnh_shape);
assert_neq(tnh_t, 0, "tensor_new 200x200");
for (var tnhi = 0; tnhi < 200; tnhi = tnhi + 1) {
    var tnh_ix = alloc(16);
    store64(tnh_ix, tnhi);
    store64(tnh_ix + 8, tnhi);
    tensor_set(tnh_t, tnh_ix, F64_ONE);
}
var tnh_a0 = alloc_used();
var tnh_tr = tensor_contract(tnh_t, 0, 1);
var tnh_bytes = alloc_used() - tnh_a0;
assert_neq(tnh_tr, 0, "tensor_contract: the 200x200 trace returns a scalar tensor");
assert_lt(tnh_bytes, 256,
"tensor_contract: the trace costs under 256 B of arena (was 3,256 -- one alloc per k)");
# The hoisted buffer is zeroed ONCE and only slots ii/jj are rewritten, so a
# wrong answer here is exactly the staleness bug the hoist could have introduced.
# All 200 diagonal entries are 1, so the trace is 200 exactly.
assert_eq(load64(HTensor_data(tnh_tr)), f64_from(200),
"tensor_contract: trace of I_200 == 200 exactly (the shared full_idx stays clean)");

# --- The OTHER full_idx, before the out_idx loop, was ALREADY hoisted; the audit
#     row listed it as a second site and that half is REFUTED by measurement.
#     A 12^4 rank-4 contraction cost 1,272 B per call both before and after this
#     cycle's edit, i.e. no per-iteration allocation was present to remove.
var tnh_s4 = alloc(32);
store64(tnh_s4, 12); store64(tnh_s4 + 8, 12);
store64(tnh_s4 + 16, 12); store64(tnh_s4 + 24, 12);
var tnh_t4 = tensor_new(4, tnh_s4);
var tnh_b0 = alloc_used();
var tnh_c4 = tensor_contract(tnh_t4, 0, 1);
assert_neq(tnh_c4, 0, "tensor_contract: 12^4 rank-4 contraction returns a tensor");
assert_lt(alloc_used() - tnh_b0, 2048,
"tensor_contract: the rank-4 path was already hoisted -- 1,272 B per call, unchanged");

test_group("spatial: max_depth is CAPPED, so a coincident-point chain terminates");

# 2026-08-04 audit, memory-safety. quadtree_new / octree_new stored the caller's
# max_depth verbatim and it was the ONLY bound on _qt_insert_rec / _ot_insert_rec.
# Coincident points always route into the same child, so past the node capacity
# every insert drives a split chain the full depth. Measured on the pre-fix tree
# (8 MiB stack, 64 coincident points, scratch binaries, exit codes recorded):
#   quadtree  max_depth 23,750 -> exit 0     23,906 -> SIGSEGV (139)
#   octree    max_depth 20,000 -> exit 0     30,000 -> SIGSEGV (139)
# and the arena (a bump allocator that never frees) grew 1,216 B per quadtree
# level and 6,144 B per octree level: 24.3 MB / 123 MB at max_depth 20,000.
# The suite never saw it because its only fixtures use max_depth 6 and 5.

fn _qtd_max(node) {
    if (node == 0) { return (0 - 1); }
    if (_qt_node_is_split(node) == 0) { return _qt_node_depth(node); }
    var best = _qt_node_depth(node);
    for (var c = 0; c < 4; c = c + 1) {
        var d = _qtd_max(_qt_node_child(node, c));
        if (d > best) { best = d; }
    }
    return best;
}

fn _otd_max(node) {
    if (node == 0) { return (0 - 1); }
    if (_ot_node_is_split(node) == 0) { return _ot_node_depth(node); }
    var best = _ot_node_depth(node);
    for (var c = 0; c < 8; c = c + 1) {
        var d = _otd_max(_ot_node_child(node, c));
        if (d > best) { best = d; }
    }
    return best;
}

# max_depth = 1e6: the pre-fix code SIGSEGV'd on this. Reaching the assertion at
# all is half the test; the other half is that the depth and the arena are bounded
# by the cap and not by the request.
var qcap_a0 = alloc_used();
var qcap = quadtree_new(0, 0, f64_from(1000), f64_from(1000), 1000000);
for (var qcapi = 0; qcapi < 64; qcapi = qcapi + 1) {
    assert_eq(quadtree_insert(qcap, F64_ONE, F64_ONE, qcapi), HSB_ERR_NONE,
    "quadtree_insert: 64 coincident points at max_depth 1e6 all land");
}
var qcap_bytes = alloc_used() - qcap_a0;
assert_eq(_qtd_max(load64(qcap)), _SP_MAX_TREE_DEPTH,
"quadtree: the split chain stops at _SP_MAX_TREE_DEPTH, not at the requested 1e6");
assert_lt(qcap_bytes, 2097152,
"quadtree: a coincident-point chain costs under 2 MB of arena (measured 1,311,304 B)");
assert_eq(vec_len(quadtree_query(qcap, 0, 0, f64_from(1000), f64_from(1000))), 64,
"quadtree: capping loses no points -- all 64 are still queryable");

# i64 max as max_depth must be indistinguishable from the cap itself: same depth,
# same arena. If the clamp were ever removed this diverges immediately.
var qcap2_a0 = alloc_used();
var qcap2 = quadtree_new(0, 0, f64_from(1000), f64_from(1000), _SP_MAX_TREE_DEPTH);
for (var qcap2i = 0; qcap2i < 64; qcap2i = qcap2i + 1) {
    quadtree_insert(qcap2, F64_ONE, F64_ONE, qcap2i);
}
assert_eq(alloc_used() - qcap2_a0, qcap_bytes,
"quadtree: max_depth 1e6 and max_depth _SP_MAX_TREE_DEPTH allocate identically");
assert_eq(_qtd_max(load64(qcap2)), _SP_MAX_TREE_DEPTH, "quadtree: the cap is reachable, not off by one");

# Octree: 8 children per level, so 5x the quadtree's per-level cost.
var ocap_a0 = alloc_used();
var ocap = octree_new(hvec3_zero(), hvec3_splat(f64_from(1000)), 1000000);
for (var ocapi = 0; ocapi < 64; ocapi = ocapi + 1) {
    assert_eq(octree_insert(ocap, hvec3_one(), ocapi), HSB_ERR_NONE,
    "octree_insert: 64 coincident points at max_depth 1e6 all land");
}
var ocap_bytes = alloc_used() - ocap_a0;
assert_eq(_otd_max(load64(ocap)), _SP_MAX_TREE_DEPTH,
"octree: the split chain stops at _SP_MAX_TREE_DEPTH, not at the requested 1e6");
assert_lt(ocap_bytes, 8388608,
"octree: a coincident-point chain costs under 8 MB of arena (measured 6,606,992 B)");
assert_eq(vec_len(octree_query(ocap, hvec3_zero(), hvec3_splat(f64_from(1000)))), 64,
"octree: capping loses no points -- all 64 are still queryable");

# The cap must not touch a sane tree. A 20x20 grid at max_depth 6 splits to 3
# levels; the depth-6 fixture above is unchanged, and this pins that directly.
var qsane = quadtree_new(0, 0, f64_from(100), f64_from(100), 6);
for (var qsx = 0; qsx < 20; qsx = qsx + 1) {
    for (var qsy = 0; qsy < 20; qsy = qsy + 1) {
        quadtree_insert(qsane, f64_from(qsx * 5), f64_from(qsy * 5), qsx * 100 + qsy);
    }
}
assert_lte(_qtd_max(load64(qsane)), 6, "quadtree: a max_depth 6 tree still stops at 6");
assert(_qtd_max(load64(qsane)) > 0, "quadtree: the max_depth 6 tree really did split");
assert_eq(vec_len(quadtree_query(qsane, 0, 0, f64_from(100), f64_from(100))), 400,
"quadtree: the capped build is byte-for-byte the old behaviour below the cap");

# A negative max_depth already meant "never split"; the clamp to 0 writes that
# down rather than changing it.
var qneg = quadtree_new(0, 0, f64_from(10), f64_from(10), (0 - 5));
for (var qni = 0; qni < 32; qni = qni + 1) { quadtree_insert(qneg, F64_ONE, F64_ONE, qni); }
assert_eq(_qtd_max(load64(qneg)), 0, "quadtree: max_depth -5 clamps to 0 -- everything in the root");
assert_eq(vec_len(quadtree_query(qneg, 0, 0, f64_from(10), f64_from(10))), 32,
"quadtree: max_depth -5 still stores all 32 points");

test_group("color: alpha compositing, tonemap, depth, EV -- 21 untested functions");

# premultiply / unpremultiply round-trip. a = 0.5 is dyadic so this is exact.
var cpm = premultiply_alpha(F64_ONE, F64_HALF, 0, F64_HALF);
assert_eq(HVec4_x(cpm), F64_HALF, "premultiply r = 1*0.5 = 0.5 exactly");
assert_eq(HVec4_y(cpm), 0x3FD0000000000000, "premultiply g = 0.5*0.5 = 0.25 exactly");
assert_eq(HVec4_w(cpm), F64_HALF, "premultiply keeps alpha");
var cup = unpremultiply_alpha(HVec4_x(cpm), HVec4_y(cpm), HVec4_z(cpm), HVec4_w(cpm));
assert_eq(HVec4_x(cup), F64_ONE, "unpremultiply round-trips r to 1");
assert_eq(HVec4_y(cup), F64_HALF, "unpremultiply round-trips g to 0.5");
# a == 0 is the documented guard.
assert_eq(HVec4_x(unpremultiply_alpha(F64_ONE, F64_ONE, F64_ONE, 0)), 0,
"unpremultiply with a = 0 returns zero, not Inf");

# Porter-Duff. Opaque dst under opaque src: dst_over keeps DST.
var cdo = composite_dst_over(F64_ONE, 0, 0, F64_ONE, 0, F64_ONE, 0, F64_ONE);
assert_eq(HVec4_y(cdo), F64_ONE, "dst_over over opaque dst keeps dst green");
assert_eq(HVec4_x(cdo), 0, "dst_over over opaque dst drops src red");
# src_in with opaque dst is src; with transparent dst it is nothing.
assert_eq(HVec4_x(composite_src_in(F64_ONE, 0, 0, F64_ONE, 0, 0, 0, F64_ONE)), F64_ONE,
"src_in with opaque dst keeps src");
assert_eq(HVec4_x(composite_src_in(F64_ONE, 0, 0, F64_ONE, 0, 0, 0, 0)), 0,
"src_in with transparent dst is empty");
assert_eq(HVec4_x(composite_dst_in(0, 0, 0, F64_ONE, F64_ONE, 0, 0, F64_ONE)), F64_ONE,
"dst_in with opaque src keeps dst");
assert_eq(HVec4_x(composite_src_out(F64_ONE, 0, 0, F64_ONE, 0, 0, 0, 0)), F64_ONE,
"src_out against transparent dst keeps src");
assert_eq(HVec4_x(composite_dst_out(0, 0, 0, 0, F64_ONE, 0, 0, F64_ONE)), F64_ONE,
"dst_out against transparent src keeps dst");
assert_eq(HVec4_w(composite_xor(F64_ONE, 0, 0, F64_ONE, 0, 0, 0, F64_ONE)), 0,
"xor of two opaque layers has zero alpha");
# plus saturates at 1.
var cpl = composite_plus(F64_ONE, F64_HALF, 0, F64_ONE, F64_ONE, F64_HALF, 0, F64_ONE);
assert_eq(HVec4_x(cpl), F64_ONE, "plus saturates red at 1");
assert_eq(HVec4_y(cpl), F64_ONE, "plus 0.5 + 0.5 = 1");

# Depth linearisation. ndc = 0 with near/far = 1/100 gives near*far/far = 1.
assert_eq(linearize_depth(0, F64_ONE, f64_from(100)), F64_ONE,
"linearize_depth at ndc = 0 returns near");
# Reverse-Z: ndc = 0 is the far plane and is guarded.
assert_eq(linearize_depth_reverse_z(0, F64_ONE), 0, "reverse-Z at ndc = 0 is guarded");
assert_eq(linearize_depth_reverse_z(F64_HALF, F64_ONE), F64_TWO,
"reverse-Z near/ndc = 1/0.5 = 2");

# EV100 round-trip: luminance_to_ev100(ev100_to_luminance(x)) == x.
var cev = f64_from(10);
var cev_rt = luminance_to_ev100(ev100_to_luminance(cev));
assert(f64_lt(f64_abs(f64_sub(cev_rt, cev)), LOOSE_TOL_M) == 1, "EV100 round-trips at 10");
assert(f64_gt(ev100_to_luminance(cev), ev100_to_luminance(F64_ONE)) == 1,
"higher EV means higher luminance");
assert(f64_gt(ev100_to_exposure(F64_ONE), ev100_to_exposure(cev)) == 1,
"higher EV means LOWER exposure");

# Vec3 sRGB wrappers must agree with the scalar path they wrap.
var csv = srgb_to_linear_vec3(hvec3_new(F64_HALF, F64_HALF, F64_HALF));
assert_eq(HVec3_x(csv), srgb_to_linear(F64_HALF), "srgb_to_linear_vec3 matches the scalar");
var cls = linear_to_srgb_vec3(csv);
assert(f64_lt(f64_abs(f64_sub(HVec3_x(cls), F64_HALF)), LOOSE_TOL_M) == 1,
"linear_to_srgb_vec3 round-trips 0.5");
# lerp at the endpoints is exact.
var cla = hvec3_new(F64_ONE, 0, 0);
var clb = hvec3_new(0, F64_ONE, 0);
# Not bit-exact: lerp_srgb converts to linear, interpolates, and converts back,
# so the endpoints come back 1 ulp low. Tolerance, not equality.
assert(f64_lt(f64_abs(f64_sub(HVec3_x(lerp_srgb_vec3(cla, clb, 0)), F64_ONE)), LOOSE_TOL_M) == 1,
"lerp_srgb t = 0 is a");
assert(f64_lt(f64_abs(f64_sub(HVec3_y(lerp_srgb_vec3(cla, clb, F64_ONE)), F64_ONE)), LOOSE_TOL_M) == 1,
"lerp_srgb t = 1 is b");

# Tonemaps: monotone, and black maps to black.
assert_eq(HVec3_x(tonemap_aces(0, 0, 0)), 0, "ACES maps black to black");
assert(f64_gt(HVec3_x(tonemap_aces(F64_ONE, 0, 0)), 0) == 1, "ACES of 1 is positive");
assert(f64_lt(HVec3_x(tonemap_reinhard_extended(F64_ONE, 0, 0, f64_from(4))), F64_ONE) == 1,
"Reinhard-extended of 1 stays below 1");

# Spherical harmonics L2: 9 coefficients, and the DC term is constant.
var csh = sh_eval_l2(hvec3_unit_z());
assert_neq(csh, 0, "sh_eval_l2 returns coefficients");
assert(f64_gt(load64(csh), 0) == 1, "sh_eval_l2 DC term is positive");
var csh2 = sh_eval_l2(hvec3_unit_x());
assert_eq(load64(csh), load64(csh2), "sh_eval_l2 DC term is direction-independent");

test_group("linalg_ext CSR + ode implicit integrators -- previously untested");

# --- CSR sparse. A = [[1,0,2],[0,3,0],[4,0,5]] ---
var cs_d = mat_new(3, 3);
mat_set(cs_d, 0, 0, F64_ONE);       mat_set(cs_d, 0, 2, F64_TWO);
mat_set(cs_d, 1, 1, f64_from(3));
mat_set(cs_d, 2, 0, f64_from(4));   mat_set(cs_d, 2, 2, f64_from(5));
var cs = csr_from_dense(cs_d);
assert_neq(cs, 0, "csr_from_dense returns a matrix");
assert_eq(csr_nrows(cs), 3, "csr_nrows = 3");
assert_eq(csr_ncols(cs), 3, "csr_ncols = 3");
assert_eq(csr_nnz(cs), 5, "csr_nnz counts exactly the 5 stored entries, not 9");
assert_neq(csr_row_ptr(cs), 0, "csr_row_ptr is populated");
assert_neq(csr_col_idx(cs), 0, "csr_col_idx is populated");
assert_neq(csr_values(cs), 0, "csr_values is populated");

# A * (1,1,1) = (3, 3, 9)
var cs_x = alloc(24);
store64(cs_x, F64_ONE); store64(cs_x + 8, F64_ONE); store64(cs_x + 16, F64_ONE);
var cs_y = csr_spmv(cs, cs_x);
assert_eq(f64_to(load64(cs_y)), 3, "csr_spmv row0 = 1+2 = 3");
assert_eq(f64_to(load64(cs_y + 8)), 3, "csr_spmv row1 = 3");
assert_eq(f64_to(load64(cs_y + 16)), 9, "csr_spmv row2 = 4+5 = 9");

# A + A = 2A, so spmv doubles.
var cs_sum = csr_add(cs, cs);
assert_neq(cs_sum, 0, "csr_add returns a matrix");
var cs_y2 = csr_spmv(cs_sum, cs_x);
assert_eq(f64_to(load64(cs_y2 + 16)), 18, "csr_add: (A+A)*x doubles row2 to 18");

# A^T = [[1,0,4],[0,3,0],[2,0,5]]; A^T*(1,1,1) = (5, 3, 7).
var cs_t = csr_transpose(cs);
assert_eq(csr_nnz(cs_t), 5, "csr_transpose preserves nnz");
var cs_y3 = csr_spmv(cs_t, cs_x);
assert_eq(f64_to(load64(cs_y3)), 5, "csr_transpose row0 = 1+4 = 5");
assert_eq(f64_to(load64(cs_y3 + 16)), 7, "csr_transpose row2 = 2+5 = 7");

# --- inertia_box: solid box I_xx = m(hy^2 + hz^2)/3 for HALF-extents.
# m = 12, h = (1,1,1) -> 12*(1+1)/3 = 8 on every axis.
var ib = inertia_box(f64_from(12), F64_ONE, F64_ONE, F64_ONE);
assert_neq(ib, 0, "inertia_box returns a tensor");
# Returns a Mat3, not a vector. Formula uses FULL extents: w = 2*hx, so for
# m = 12 and half-extents (1,1,1) the box is 2x2x2 and I_xx = (m/12)(h^2+d^2) = 8.
assert_eq(f64_to(mat_get(ib, 0, 0)), 8, "inertia_box 2x2x2 cube I_xx = (m/12)(h^2+d^2) = 8");
assert_eq(f64_to(mat_get(ib, 2, 2)), 8, "inertia_box cube is isotropic");
assert_eq(f64_to(mat_get(ib, 0, 1)), 0, "inertia_box is diagonal for an axis-aligned box");

# --- matrix_condition_number: identity is perfectly conditioned.
var mc_i = mat_identity(3);
var mc = matrix_condition_number(mc_i);
# This uses the FROBENIUS norm, not the 2-norm, so cond(I_3) = sqrt(3)*sqrt(3) = 3,
# not 1. The doc says ||A|| * ||A^-1|| without naming the norm, so it is
# self-consistent -- but it is NOT the spectral condition number a caller may expect.
assert(f64_lt(f64_abs(f64_sub(mc, f64_from(3))), LOOSE_TOL_M) == 1,
"cond_F(I_3) = ||I||_F * ||I^-1||_F = 3");
# A badly-scaled matrix must score worse than the identity.
var mc_b = mat_new(2, 2);
mat_set(mc_b, 0, 0, f64_from(1000)); mat_set(mc_b, 1, 1, f64_div(F64_ONE, f64_from(1000)));
assert(f64_gt(matrix_condition_number(mc_b), mc) == 1,
"cond(diag(1000, 0.001)) is far worse than cond(I)");

# --- eigen_symmetric on diag(3,1): eigenvalues 3 and 1.
var es_A = mat_new(2, 2);
mat_set(es_A, 0, 0, f64_from(3)); mat_set(es_A, 1, 1, F64_ONE);
var es_vals = alloc(16);
var es_vecs = mat_new(2, 2);
assert_eq(eigen_symmetric(es_A, 2, es_vals, es_vecs), HSB_ERR_NONE, "eigen_symmetric converges");
assert_eq(f64_to(load64(es_vals)), 3, "eigen_symmetric dominant eigenvalue = 3");

# --- implicit ODE integrators on y' = y, y(0) = 1, dt = 1/4.
# Backward Euler: y1 = y/(1-dt) = 1/0.75 = 4/3.
var oi_dt = f64_div(F64_ONE, f64_from(4));
var oi_be = ode_backward_euler(&_cv_dydt_y, 0, F64_ONE, oi_dt, EPSILON_F64, 50);
var oi_be_want = f64_div(f64_from(4), f64_from(3));
assert(f64_lt(f64_abs(f64_sub(oi_be, oi_be_want)), LOOSE_TOL_M) == 1,
"backward Euler y1 = 1/(1-dt) = 4/3");
# It must be ABOVE the exact e^dt -- backward Euler over-shoots on a growing solution.
assert(f64_gt(oi_be, f64_exp(oi_dt)) == 1, "backward Euler overshoots exp(dt), as it must");

# BDF2 with a consistent history is at least as accurate as backward Euler here.
var oi_bdf = ode_bdf2(&_cv_dydt_y, 0, F64_ONE, f64_div(F64_ONE, f64_exp(oi_dt)), oi_dt, EPSILON_F64);
assert(f64_gt(oi_bdf, F64_ONE) == 1, "bdf2 advances a growing solution");

# Leapfrog on the SHO from (q,v) = (1,0): one step must reduce q and drive v negative.
var oi_lf = ode_leapfrog(&_cv_accel, F64_ONE, 0, F64_HALF);
assert(f64_lt(load64(oi_lf), F64_ONE) == 1, "leapfrog q decreases from the turning point");
assert(f64_lt(load64(oi_lf + 8), 0) == 1, "leapfrog v goes negative from the turning point");

# Balance guard: the hybrid partition must keep every child at >= 1/4 of its
# parent, so depth is bounded at log_(4/3)(n) regardless of coordinate
# distribution. Geometric spacing is the case the value-midpoint split handles
# badly; this builds and queries correctly either way.
var kdb_n = 8000;
var kdb_p = alloc(kdb_n * 8);
var kdb_i = 0;
var kdb_v = F64_ONE;
while (kdb_i < kdb_n) {
    kdb_v = f64_mul(kdb_v, 0x3FEFFF0000000000);
    store64(kdb_p + kdb_i * 8, hvec3_new(kdb_v, f64_from(kdb_i % 97), f64_from(kdb_i % 89)));
    kdb_i = kdb_i + 1;
}
var kdb_t = kdtree_build(kdb_p, kdb_n);
assert_neq(kdb_t, 0, "kdtree_build handles geometrically-spaced coordinates");
assert_eq(_kdv_invariant_bad(kdb_t, kdb_p), 0,
"geometric spacing: split-plane invariant still holds on every node");

# 2.9.3: the guard's OWN property, which nothing asserted until now.
assert_lt(_kdv_depth(kdb_t), 64,
"geometric spacing: depth stays log-bounded");

# ...and the fixture that makes that assertion MEAN something. The one above
# does not: its ratio is 0.99998, so over 8000 points the axis range is only
# [0.85, 1] and the value-midpoint lands near the count-median anyway -- the
# guard never fires, and deleting it changes nothing -- the whole suite stays
# green with the guard replaced by `if (1 == 1)`. That is the shape of a
# regression test that guards nothing, which is the defect this block is fixing,
# so it must not be repeated one line down.
# [measured: scratch mutation run, not reproducible in-tree]
# To re-run it: replace the `split - start >= quarter && ...` condition at
# src/spatial.cyr:220 with `1 == 1` and run this suite; only the OCTAVE
# assertion below goes red.
#
# What degenerates the value-midpoint split is a range spanning many orders of
# magnitude: with v = 2^-i the axis range is [2^-n, 1], the midpoint is ~0.5, and
# exactly ONE point sits above it -- so the split peels off a single point per
# level and depth goes linear. All three coordinates decay here, because the axis
# cycles 0,1,2 and a single degenerate axis is diluted by two healthy ones.
# log_(4/3)(512) is about 22; unguarded this builds a ~512-deep spine.
var kds_n = 512;
var kds_p = alloc(kds_n * 8);
var kds_i = 0;
var kds_v = F64_ONE;
while (kds_i < kds_n) {
    kds_v = f64_mul(kds_v, F64_HALF);
    store64(kds_p + kds_i * 8, hvec3_new(kds_v, kds_v, kds_v));
    kds_i = kds_i + 1;
}
var kds_t = kdtree_build(kds_p, kds_n);
assert_neq(kds_t, 0, "kdtree_build handles an octave-spaced axis");
assert_eq(_kdv_invariant_bad(kds_t, kds_p), 0,
"octave spacing: split-plane invariant holds on every node");
assert_lt(_kdv_depth(kds_t), 64,
"octave spacing: depth stays log-bounded -- THIS is the balance guard's assertion");

test_group("complex / geo / symbolic: closing the remaining coverage holes");

# --- complex scalar ops with closed-form answers ---
var cz = cx_new(f64_from(3), f64_from(4));
assert_eq(f64_to(HComplex_re(cx_neg(cz))), (0 - 3), "cx_neg re");
assert_eq(f64_to(HComplex_im(cx_neg(cz))), (0 - 4), "cx_neg im");
assert_eq(f64_to(HComplex_re(cx_scale(cz, F64_TWO))), 6, "cx_scale re");
assert_eq(f64_to(cx_norm_sq(cz)), 25, "cx_norm_sq(3+4i) = 25");
# polar: r=2, theta=0 -> 2 + 0i
var cp = cx_from_polar(F64_TWO, 0);
assert_eq(f64_to(HComplex_re(cp)), 2, "cx_from_polar(2, 0) re = 2");
assert(f64_lt(f64_abs(HComplex_im(cp)), LOOSE_TOL_M) == 1, "cx_from_polar(2, 0) im = 0");
# ln(1) = 0
var cl = cx_ln(cx_one());
assert(f64_lt(f64_abs(HComplex_re(cl)), LOOSE_TOL_M) == 1, "cx_ln(1) re = 0");
# sqrt(-1) = i
var cq = cx_sqrt(cx_new(f64_neg(F64_ONE), 0));
assert(f64_lt(f64_abs(HComplex_re(cq)), LOOSE_TOL_M) == 1, "cx_sqrt(-1) re = 0");
assert(f64_lt(f64_abs(f64_sub(HComplex_im(cq), F64_ONE)), LOOSE_TOL_M) == 1, "cx_sqrt(-1) im = 1");
# sin(0) = 0, cos(0) = 1
assert(f64_lt(f64_abs(HComplex_re(cx_sin(cx_zero()))), LOOSE_TOL_M) == 1, "cx_sin(0) = 0");
assert(f64_lt(f64_abs(f64_sub(HComplex_re(cx_cos(cx_zero())), F64_ONE)), LOOSE_TOL_M) == 1,
"cx_cos(0) = 1");
# pauli_0 is the 2x2 identity.
assert_eq(f64_to(HComplex_re(cmat_get(pauli_0(), 0, 0))), 1, "pauli_0 is the identity");
assert_eq(f64_to(HComplex_re(cmat_get(pauli_0(), 0, 1))), 0, "pauli_0 off-diagonal = 0");
# Dirac gammas: gamma_0^2 = I, and gamma_5 is traceless.
assert_neq(gamma_0(), 0, "gamma_0 exists");
assert_neq(gamma_spatial(1), 0, "gamma_spatial(1) exists");
var cg5 = gamma_5();
assert(f64_lt(f64_abs(HComplex_re(cmat_trace(cg5))), LOOSE_TOL_M) == 1, "gamma_5 is traceless");
# cmat_mul_vec: I * v = v
var cmv = alloc(32);
store64(cmv, F64_ONE); store64(cmv + 8, 0); store64(cmv + 16, F64_TWO); store64(cmv + 24, 0);
var cmr = cmat_mul_vec(cmat_identity(2), cmv);
assert_eq(f64_to(load64(cmr)), 1, "cmat_mul_vec I*v keeps v0");
assert_eq(f64_to(load64(cmr + 16)), 2, "cmat_mul_vec I*v keeps v1");

# --- geo ---
var gl = geo_line_new(hvec3_zero(), hvec3_unit_x());
assert_neq(gl, 0, "geo_line_new returns a line");
# Closest point on the x-axis to (5, 3, 0) is (5, 0, 0).
var glc = geo_line_closest_point(gl, hvec3_new(f64_from(5), f64_from(3), 0));
assert_eq(f64_to(HVec3_x(glc)), 5, "line closest point x = 5");
assert(f64_lt(f64_abs(HVec3_y(glc)), LOOSE_TOL_M) == 1, "line closest point y = 0");
# Segment from origin to (4,0,0): midpoint (2,0,0), distance to (2,3,0) is 3.
var gs = geo_segment_new(hvec3_zero(), hvec3_new(f64_from(4), 0, 0));
assert_eq(f64_to(HVec3_x(geo_segment_midpoint(gs))), 2, "segment midpoint x = 2");
assert_eq(f64_to(geo_segment_distance_to_point(gs, hvec3_new(F64_TWO, f64_from(3), 0))), 3,
"segment distance to (2,3,0) = 3");
# Unit normal of the xy triangle is +z.
# These take a Triangle, not three loose vertices.
var gtri = geo_triangle_new(hvec3_zero(), hvec3_unit_x(), hvec3_unit_y());
var gn = geo_triangle_unit_normal(gtri);
assert_eq(f64_to(HVec3_z(gn)), 1, "triangle unit normal is +z");
var gb = geo_barycentric_coords(gtri, hvec3_zero());
assert_eq(f64_to(HVec3_x(gb)), 1, "barycentric of vertex a is (1,0,0)");
var gcp = geo_closest_point_on_triangle(gtri, hvec3_new(f64_div(F64_ONE, f64_from(4)),
f64_div(F64_ONE, f64_from(4)), F64_ONE));
assert(f64_lt(f64_abs(HVec3_z(gcp)), LOOSE_TOL_M) == 1, "closest point on triangle lies in its plane");
# OBB
var gob = geo_obb_new(hvec3_zero(), hvec3_one(), hquat_identity());
assert_neq(gob, 0, "geo_obb_new returns an OBB");
assert_neq(geo_obb_axes(gob), 0, "geo_obb_axes returns axes");
assert_eq(geo_ray_obb(geo_ray_new(hvec3_new(f64_from(10), 0, 0), hvec3_new(f64_neg(F64_ONE), 0, 0)),
gob) != 0, 1, "geo_ray_obb hits a unit OBB head-on");

# --- symbolic accessors ---
var sxv = expr_var(str_from("x"));
assert_eq(str_eq_cstr(expr_var_name(sxv), "x"), 1, "expr_var_name round-trips");
assert_eq(f64_to(expr_const_val(expr_const(f64_from(7)))), 7, "expr_const_val = 7");
var sadd = expr_add(sxv, expr_const(F64_ONE));
assert_eq(expr_tag(expr_left(sadd)), expr_tag(sxv), "expr_left of a+b is a");
assert_eq(f64_to(expr_const_val(expr_right(sadd))), 1, "expr_right of x+1 is 1");
assert_neq(expr_cos(sxv), 0, "expr_cos builds a node");
assert_neq(expr_ln(sxv), 0, "expr_ln builds a node");
assert_eq(expr_tag(expr_child(expr_cos(sxv))), expr_tag(sxv), "expr_child of cos(x) is x");

test_group("lie_ext SO(3)/SE(3) + num_ext number theory -- closing to 80%");

# --- SO(3): group identities are exact, so they pin the ops without tolerances.
var l3_ax = hvec3_unit_z();
var l3_R = so3_from_axis_angle(l3_ax, F64_PI_2);
assert_neq(l3_R, 0, "so3_from_axis_angle builds a rotation");
# R * R^-1 = I on every entry.
var l3_I = so3_compose(l3_R, so3_inverse(l3_R));
var l3_bad = 0;
var l3_i = 0;
while (l3_i < 3) {
    var l3_j = 0;
    while (l3_j < 3) {
        var want = 0;
        if (l3_i == l3_j) { want = F64_ONE; }
        if (f64_lt(f64_abs(f64_sub(m3_get(l3_I, l3_i, l3_j), want)), LOOSE_TOL_M) == 0) {
            l3_bad = l3_bad + 1;
        }
        l3_j = l3_j + 1;
    }
    l3_i = l3_i + 1;
}
assert_eq(l3_bad, 0, "so3: R * R^-1 == I on all 9 entries");
# log(R) recovers the axis-angle vector: |log| == the rotation angle.
var l3_log = so3_log(l3_R);
assert(f64_lt(f64_abs(f64_sub(hvec3_length(l3_log), F64_PI_2)), LOOSE_TOL_M) == 1,
"so3_log magnitude equals the rotation angle");
# from_quat and from_mat3 must agree with from_axis_angle.
# so3_from_quat takes an SU(2) element (it calls su2_to_quat internally), NOT an
# HQuat. Passing an HQuat silently reinterprets it and yields a double-angle
# rotation -- cos(180) where cos(90) is meant.
var l3_q = so3_from_quat(su2_from_axis_angle(l3_ax, F64_PI_2));
assert(f64_lt(f64_abs(f64_sub(m3_get(l3_q, 0, 0), m3_get(l3_R, 0, 0))), LOOSE_TOL_M) == 1,
"so3_from_quat agrees with so3_from_axis_angle");
# so3_from_mat3's doc block claimed "checks determinant ~ +1 and orthogonality"
# and the body did NEITHER -- it was a bare m3_copy, and `!= 0` is the one
# assertion m3_copy cannot fail for any input whatsoever. Both checks are
# implemented as of 2.8.x; the rejections below are the real coverage, and the
# acceptances are the regression guard on the tolerance.
var l3_ok = so3_from_mat3(l3_R);
assert_neq(l3_ok, 0, "so3_from_mat3 accepts a rotation matrix");
assert_eq(m3_get(l3_ok, 0, 1), m3_get(l3_R, 0, 1), "so3_from_mat3 copies the matrix through");
# A reflection is ORTHOGONAL with det = -1. This is the case the determinant
# test exists for: so3_inverse is a bare transpose, which is a true inverse for
# a reflection too, so nothing downstream would ever notice.
var l3_ref = m3_identity();
m3_set(l3_ref, 2, 2, f64_neg(F64_ONE));
assert_eq(so3_from_mat3(l3_ref), 0, "so3_from_mat3 rejects a reflection (det = -1)");
# A shear has det = +1 EXACTLY and is not orthogonal, so only the R^T R test
# can see it -- the determinant check alone would pass it.
var l3_sh = m3_identity();
m3_set(l3_sh, 1, 0, F64_ONE);
assert_eq(so3_from_mat3(l3_sh), 0, "so3_from_mat3 rejects a unit-determinant shear");
# A uniformly scaled rotation fails both tests (R^T R = 4I, det = 8).
assert_eq(so3_from_mat3(m3_scale(l3_R, F64_TWO)), 0, "so3_from_mat3 rejects 2R");
assert_eq(so3_from_mat3(0), 0, "so3_from_mat3 rejects null");
# The tolerance must not be tighter than the arithmetic: a rotation that has
# been through a long compose chain is still a rotation.
var l3_chain = l3_R;
for (var l3_k = 0; l3_k < 64; l3_k = l3_k + 1) { l3_chain = so3_compose(l3_chain, l3_R); }
assert_neq(so3_from_mat3(l3_chain), 0, "so3_from_mat3 accepts a 65-fold composed rotation");

# --- SE(3): identity, compose, inverse, and the point action.
var se_id = se3_identity();
assert_neq(se_id, 0, "se3_identity exists");
var se_t = hvec3_new(F64_ONE, F64_TWO, f64_from(3));
# se3_new takes an SU(2) rotation, not a Mat3 -- see its header.
var se_g = se3_new(su2_from_axis_angle(l3_ax, F64_PI_2), se_t);
assert_neq(se_g, 0, "se3_new builds a transform");
# g * g^-1 applied to a point is the identity on that point.
var se_gi = se3_compose(se_g, se3_inverse(se_g));
var se_p = hvec3_new(f64_from(5), f64_from(7), f64_from(11));
var se_r = se3_transform_point(se_gi, se_p);
assert(f64_lt(f64_abs(f64_sub(HVec3_x(se_r), HVec3_x(se_p))), LOOSE_TOL_M) == 1,
"se3: (g * g^-1) fixes a point, x");
assert(f64_lt(f64_abs(f64_sub(HVec3_z(se_r), HVec3_z(se_p))), LOOSE_TOL_M) == 1,
"se3: (g * g^-1) fixes a point, z");
# Identity transform moves nothing.
assert(f64_lt(f64_abs(f64_sub(HVec3_y(se3_transform_point(se_id, se_p)), HVec3_y(se_p))),
LOOSE_TOL_M) == 1, "se3_identity fixes every point");
assert_neq(se3_to_mat4(se_g), 0, "se3_to_mat4 produces a Mat4");
assert_neq(se3_from_mat4(se3_to_mat4(se_g)), 0, "se3_from_mat4 round-trips");
# Both adjoints act ON something -- Ad_g(xi), not Ad(g).
#
# This assertion used to read `se3_adjoint(se_g, hvec3_unit_x()) != 0`. An
# HVec3 is 24 bytes and a twist is 48, so _twist_v read offsets 24/32/40 past
# the end of the allocation -- and a non-null check cannot see that, because
# alloc() never returns 0 on success. Build the twist with se3_twist_new, added
# in 2.8.x precisely because there was no exported way to build one at all.
#
# Closed form, from the textbook Ad_{(R,t)} = [[R, 0], [[t]_x R, R]]:
# g = (rotation of pi/2 about z, t = (1,2,3)) and xi = [omega = e_x, v = e_y]
# give R omega = e_y, R v = -e_x, t x (R omega) = (-3, 0, 1), hence
# Ad_g(xi) = [ (0, 1, 0), (-4, 0, 1) ].
var se_xi = se3_twist_new(hvec3_unit_x(), hvec3_unit_y());
var se_ad = se3_adjoint(se_g, se_xi);
assert_neq(se_ad, 0, "se3_adjoint acts on a twist");
var se_ad_w = se3_twist_omega(se_ad);
var se_ad_v = se3_twist_v(se_ad);
assert(f64_lt(f64_abs(HVec3_x(se_ad_w)), LOOSE_TOL_M) == 1, "se3_adjoint: Ad omega_x = 0");
assert(f64_lt(f64_abs(f64_sub(HVec3_y(se_ad_w), F64_ONE)), LOOSE_TOL_M) == 1,
"se3_adjoint: Ad omega_y = 1");
assert(f64_lt(f64_abs(HVec3_z(se_ad_w)), LOOSE_TOL_M) == 1, "se3_adjoint: Ad omega_z = 0");
assert(f64_lt(f64_abs(f64_add(HVec3_x(se_ad_v), f64_from(4))), LOOSE_TOL_M) == 1,
"se3_adjoint: Ad v_x = -4 (the [t]_x R omega term)");
assert(f64_lt(f64_abs(HVec3_y(se_ad_v)), LOOSE_TOL_M) == 1, "se3_adjoint: Ad v_y = 0");
assert(f64_lt(f64_abs(f64_sub(HVec3_z(se_ad_v), F64_ONE)), LOOSE_TOL_M) == 1,
"se3_adjoint: Ad v_z = 1");

# The DEFINING identity: exp(Ad_g xi) == g exp(xi) g^-1. It couples the adjoint
# to se3_exp / se3_compose / se3_inverse, so an internally tidy but wrong
# adjoint -- R^T where R belongs, or the [t]_x term attached to the angular
# half -- cannot satisfy it. Compared by the action on four points.
var se_lhs = se3_exp(se_ad);
var se_rhs = se3_compose(se3_compose(se_g, se3_exp(se_xi)), se3_inverse(se_g));
assert_eq(_se_same(se_lhs, se_rhs), 1, "se3: exp(Ad_g xi) == g exp(xi) g^-1");

# Ad is linear in the twist: Ad_g(2 xi) == 2 Ad_g(xi) on all six components.
var se_xi2 = se3_twist_new(hvec3_scale(hvec3_unit_x(), F64_TWO),
hvec3_scale(hvec3_unit_y(), F64_TWO));
var se_ad2 = se3_adjoint(se_g, se_xi2);
var se_lin = 0;
for (var se_i = 0; se_i < 6; se_i = se_i + 1) {
    if (f64_lt(f64_abs(f64_sub(_vec6_get(se_ad2, se_i),
    f64_mul(F64_TWO, _vec6_get(se_ad, se_i)))), LOOSE_TOL_M) == 0) {
        se_lin = se_lin + 1;
    }
}
assert_eq(se_lin, 0, "se3_adjoint is linear in the twist (all 6 components)");

# Null guards. A pointer carries no length in Cyrius, so these are the only
# validations se3_adjoint can perform -- the 48-vs-24 byte mistake is closed by
# se3_twist_new being the way you build a twist, not by a check in here.
assert_eq(se3_adjoint(0, se_xi), 0, "se3_adjoint rejects a null group element");
assert_eq(se3_adjoint(se_g, 0), 0, "se3_adjoint rejects a null twist");
assert_eq(se3_twist_new(0, hvec3_unit_x()), 0, "se3_twist_new rejects a null omega");
assert_eq(se3_twist_new(hvec3_unit_x(), 0), 0, "se3_twist_new rejects a null v");
assert_eq(se3_twist_omega(0), 0, "se3_twist_omega rejects null");
assert_eq(se3_twist_v(0), 0, "se3_twist_v rejects null");

assert_neq(su2_adjoint(su2_identity(), hvec3_unit_x()), 0, "su2_adjoint acts on a vector");

# --- BCH: for commuting arguments it is just the sum.
var bch_a = hvec3_new(F64_HALF, 0, 0);
var bch_b = hvec3_new(F64_ONE, 0, 0);
var bch_s = bch_so3_2nd_order(bch_a, bch_b);
assert(f64_lt(f64_abs(f64_sub(HVec3_x(bch_s), f64_add(F64_HALF, F64_ONE))), LOOSE_TOL_M) == 1,
"bch_so3_2nd_order of parallel vectors is their sum");
assert_neq(bch_so3_3rd_order(bch_a, bch_b), 0, "bch_so3_3rd_order exists");

# --- num_ext: exact integer answers.
var ng_x = alloc(8);
var ng_y = alloc(8);
assert_eq(num_extended_gcd(240, 46, ng_x, ng_y), 2, "extended_gcd(240, 46) = 2");
# Bezout: 240x + 46y must equal the gcd.
assert_eq(240 * load64(ng_x) + 46 * load64(ng_y), 2, "extended_gcd satisfies Bezout");
assert_eq(num_modinv(3, 11), 4, "modinv(3, 11) = 4 since 3*4 = 12 = 1 mod 11");
assert_eq(num_euler_totient(36), 12, "phi(36) = 12");
assert_eq(num_euler_totient(13), 12, "phi(prime 13) = 12");
# sigma_0(28) = number of divisors = 6; sigma_1(28) = 56 (28 is perfect).
assert_eq(num_divisor_sigma(28, 0), 6, "sigma_0(28) = 6 divisors");
assert_eq(num_divisor_sigma(28, 1), 56, "sigma_1(28) = 56 (28 is perfect)");
# CRT: x = 2 mod 3, 3 mod 5, 2 mod 7 -> 23 mod 105.
# VECS, not raw buffers -- num_crt reads them with vec_get. Passing alloc()
# blocks here SIGSEGVs, which is how this assertion was first written.
var nc_r = vec_new();
vec_push(nc_r, 2); vec_push(nc_r, 3); vec_push(nc_r, 2);
var nc_m = vec_new();
vec_push(nc_m, 3); vec_push(nc_m, 5); vec_push(nc_m, 7);
var nc_x = alloc(8);
var nc_mod = alloc(8);
assert_eq(num_crt(nc_r, nc_m, 3, nc_x, nc_mod), HSB_ERR_NONE, "num_crt succeeds");
assert_eq(load64(nc_x), 23, "CRT solution is 23");
assert_eq(load64(nc_mod), 105, "CRT modulus is 105");
# Factorisation of 84 = 2^2 * 3 * 7 -> 4 prime factors with multiplicity.
var nf = num_factorize(84);
assert_neq(nf, 0, "num_factorize returns factors");
assert_eq(vec_len(nf), 4, "84 = 2*2*3*7 is 4 factors with multiplicity");
# Pollard rho must return a non-trivial divisor of a composite.
var npr = num_pollard_rho(8051);
assert(npr > 1, "pollard_rho(8051) returns a factor > 1");
assert_eq(8051 % npr, 0, "pollard_rho returns a real divisor");
# Halton is deterministic and lies in [0,1).
var nh = num_halton(1, 2);
assert_eq(nh, F64_HALF, "halton(1, base 2) = 1/2 exactly");
assert(f64_lt(num_halton(5, 3), F64_ONE) == 1, "halton stays below 1");
var nhx = alloc(8);
var nhy = alloc(8);
num_halton_2d(3, nhx, nhy);
assert(f64_lt(load64(nhx), F64_ONE) == 1, "halton_2d x in [0,1)");
assert_neq(load64(nhx), load64(nhy), "halton_2d uses different bases per axis");

test_group("2.7.3 coverage: autodiff, tensor, interval, calc_ext, cga, patterns");

# --- autodiff duals: value and derivative are both exact here.
var d9 = dual_new(f64_from(3), F64_ONE);
assert_eq(f64_to(Dual_val(d9)), 3, "dual_new value");
assert_eq(f64_to(Dual_deriv(d9)), 1, "dual_new derivative");
# d/dx (x/2) at x=4 is 1/2.
var dq = dual_div(dual_var(f64_from(4)), dual_const(F64_TWO));
assert_eq(f64_to(Dual_val(dq)), 2, "dual_div value 4/2 = 2");
assert_eq(Dual_deriv(dq), F64_HALF, "dual_div derivative = 1/2");
# d/dx x^3 at x=2 is 12.
# n is a plain f64, not an integer -- a raw 3 is a subnormal ~1.5e-323.
var dp = dual_pow(dual_var(F64_TWO), f64_from(3));
# f64_pow goes through exp/ln, so 2^3 is 7.999... -- tolerance, not equality.
assert(f64_lt(f64_abs(f64_sub(Dual_val(dp), f64_from(8))), LOOSE_TOL_M) == 1,
"dual_pow value 2^3 = 8");
assert(f64_lt(f64_abs(f64_sub(Dual_deriv(dp), f64_from(12))), LOOSE_TOL_M) == 1,
"dual_pow derivative 3x^2 = 12");
# |x| at x=-5 is 5 with derivative -1.
var da = dual_abs(dual_var(f64_neg(f64_from(5))));
assert_eq(f64_to(Dual_val(da)), 5, "dual_abs value = 5");
assert_eq(f64_to(Dual_deriv(da)), (0 - 1), "dual_abs derivative = -1");

# --- tensor: get/set/scale/contract with exact integers.
var t9_shape = alloc(16);
store64(t9_shape, 2); store64(t9_shape + 8, 2);
var t9 = tensor_new(2, t9_shape);
var t9_i = alloc(16);
store64(t9_i, 0); store64(t9_i + 8, 1);
tensor_set(t9, t9_i, f64_from(7));
assert_eq(f64_to(tensor_get(t9, t9_i)), 7, "tensor_set/get round-trips");
var t9s = tensor_scale(t9, f64_from(3));
assert_eq(f64_to(tensor_get(t9s, t9_i)), 21, "tensor_scale multiplies entries");
# Trace of diag(2,5) is 7.
tensor_set2(t9, 0, 0, F64_TWO);
tensor_set2(t9, 0, 1, 0);
tensor_set2(t9, 1, 1, f64_from(5));
assert_eq(f64_to(tensor_get2(t9, 1, 1)), 5, "tensor_set2/get2 round-trips");
var t9c = tensor_contract(t9, 0, 1);
assert_neq(t9c, 0, "tensor_contract returns a tensor");

# --- interval: exp is monotone, so the enclosure is [e^lo, e^hi].
var iv9 = ivl_exp(ivl_new(0, F64_ONE));
assert(f64_lt(f64_abs(f64_sub(Interval_lo(iv9), F64_ONE)), LOOSE_TOL_M) == 1, "ivl_exp lower = e^0 = 1");
assert(f64_gt(Interval_hi(iv9), F64_TWO) == 1, "ivl_exp upper = e^1 > 2");
assert(f64_lt(Interval_lo(iv9), Interval_hi(iv9)) == 1, "ivl_exp enclosure is ordered");

# --- calc_ext derivatives of f(x,y) = x^2 + y^2 at (3,4): grad = (6,8).
var c9_x = alloc(16);
store64(c9_x, f64_from(3)); store64(c9_x + 8, f64_from(4));
var c9_h = f64_div(F64_ONE, f64_from(1000));
var c9_pd = calc_partial_derivative(&_c9_f, c9_x, 2, 0, c9_h);
assert(f64_lt(f64_abs(f64_sub(c9_pd, f64_from(6))), LOOSE_TOL_M) == 1, "partial d/dx = 6");
var c9_gr = alloc(16);
calc_gradient(&_c9_f, c9_x, 2, c9_h, c9_gr);
assert(f64_lt(f64_abs(f64_sub(load64(c9_gr + 8), f64_from(8))), LOOSE_TOL_M) == 1, "gradient y = 8");
# Hessian of x^2+y^2 is 2I.
var c9_he = alloc(32);
calc_hessian(&_c9_f, c9_x, 2, c9_h, c9_he);
assert(f64_lt(f64_abs(f64_sub(load64(c9_he), F64_TWO)), f64_div(F64_ONE, f64_from(1000))) == 1,
"hessian [0][0] = 2");
# Jacobian of the gradient map is the same 2I.
var c9_ja = alloc(32);
calc_jacobian(&_c9_g, c9_x, 2, 2, c9_h, c9_ja);
assert(f64_lt(f64_abs(f64_sub(load64(c9_ja), F64_TWO)), f64_div(F64_ONE, f64_from(1000))) == 1,
"jacobian [0][0] = 2");

# --- calc_hessian: the mixed-partial block (2.8.x) -------------------------
# The Hessian assertion above pins ONE diagonal entry of 2I on a separable
# integrand. The off-diagonal 4-point cross stencil in calc_ext.cyr was covered
# by nothing at all: for x^2 + y^2 the true mixed partial is zero, so every
# sign arrangement of the four terms -- and deleting the block entirely --
# reproduces it.
#
# f(x, y) = x^2*y + y^3 at (3, 4). Exact derivatives fxx = 2y = 8,
# fyy = 6y = 24, fxy = 2x = 6. The integrand is a cubic and both stencils are
# exact through total degree 3, so the computed values are the true ones
# bit-for-bit -- verified in exact rationals (python3 fractions) AND by
# replaying the implementation's own operation order in IEEE-754, which returns
# 8.0 / 24.0 / 6.0 with zero error. These are equalities, not tolerances.
#
# Asserted at TWO step sizes because h = 1/2 makes 4h^2 exactly 1, which would
# hide any mutation of the inv_4h2 divisor; at h = 1 the divisor is 4.
var hx_x = alloc(16);
store64(hx_x, f64_from(3)); store64(hx_x + 8, f64_from(4));
var hx_he = alloc(32);
assert_eq(calc_hessian(&_hx_f, hx_x, 2, F64_HALF, hx_he), HSB_ERR_NONE,
"calc_hessian returns HSB_ERR_NONE");
assert_eq(load64(hx_he), f64_from(8), "hessian x^2y+y^3 h=1/2: H[0][0] = 2y = 8 exactly");
assert_eq(load64(hx_he + 24), f64_from(24), "hessian x^2y+y^3 h=1/2: H[1][1] = 6y = 24 exactly");
assert_eq(load64(hx_he + 8), f64_from(6), "hessian x^2y+y^3 h=1/2: H[0][1] = 2x = 6 exactly");
assert_eq(load64(hx_he + 16), load64(hx_he + 8), "hessian: H[1][0] == H[0][1] (stored symmetric)");

var hx_he1 = alloc(32);
calc_hessian(&_hx_f, hx_x, 2, F64_ONE, hx_he1);
assert_eq(load64(hx_he1), f64_from(8), "hessian x^2y+y^3 h=1: H[0][0] = 8 exactly");
assert_eq(load64(hx_he1 + 24), f64_from(24), "hessian x^2y+y^3 h=1: H[1][1] = 24 exactly");
assert_eq(load64(hx_he1 + 8), f64_from(6), "hessian x^2y+y^3 h=1: H[0][1] = 6 exactly (4h^2 = 4)");

# --- calc_adaptive_simpson: the refinement machinery (2.8.x) ---------------
# x^2 is retained but it is NOT coverage. Simpson integrates any cubic exactly,
# so `refined - whole` is zero at the FIRST tolerance test and
# _adaptive_simpson_rec accepts without ever recursing. The evaluation counter
# says so out loud: 5 calls -- the three initial panel points plus the two
# sub-midpoints of the single accepted bisection, and no descent below it.
_as_calls = 0;
var c9_as = calc_adaptive_simpson(&_as_x2, 0, F64_ONE, EPSILON_F64);
assert(f64_lt(f64_abs(f64_sub(c9_as, 0x3FD5555555555555)), LOOSE_TOL_M) == 1,
"adaptive Simpson of x^2 over [0,1] = 1/3");
assert_eq(_as_calls, 5, "adaptive Simpson never recurses on x^2 (5 evaluations, no descent)");

# x^4 over [0,1] = 1/5. The single panel gives 5/24 = 0.208333..., off by
# 8.3e-3, so landing within 1e-14 is only reachable by actually refining.
_as_calls = 0;
var as_x4 = calc_adaptive_simpson(&_as_x4, 0, F64_ONE, EPSILON_F64);
assert(f64_lt(f64_abs(f64_sub(as_x4, f64_div(F64_ONE, f64_from(5)))), TOL_1EM14) == 1,
"adaptive Simpson of x^4 over [0,1] = 1/5 (one panel is 8.3e-3 wrong)");
assert(_as_calls > 100, "adaptive Simpson does refine on x^4 (>100 evaluations)");

# Additivity. A refinement that loses or double-counts a sub-panel can still
# land near the right total; it cannot also stay consistent across a split.
var as_lo = calc_adaptive_simpson(&_as_x4, 0, F64_HALF, EPSILON_F64);
var as_hi = calc_adaptive_simpson(&_as_x4, F64_HALF, F64_ONE, EPSILON_F64);
assert(f64_lt(f64_abs(f64_sub(as_x4, f64_add(as_lo, as_hi))), TOL_1EM14) == 1,
"adaptive Simpson is additive across a split interval");

# sqrt over [0,1] = 2/3. The derivative blows up at 0, so the error is
# concentrated in one corner: composite Simpson on a UNIFORM grid of the ~1000
# points used here is still ~6e-5 off. Reaching 1e-11 requires the subdivision
# to be non-uniform, which is the entire point of the algorithm and was
# unexercised until 2.8.x.
_as_calls = 0;
var as_sq = calc_adaptive_simpson(&_as_sqrt, 0, F64_ONE, f64_div(F64_ONE, f64_from(10000000000)));
assert(f64_lt(f64_abs(f64_sub(as_sq, f64_div(F64_TWO, f64_from(3)))),
f64_div(F64_ONE, f64_from(100000000000))) == 1,
"adaptive Simpson of sqrt over [0,1] = 2/3 (needs non-uniform refinement)");
assert(_as_calls < 4000, "adaptive Simpson reaches 1e-11 on sqrt in under 4000 evaluations");

# 1/(1+x) over [0,1] = ln 2. Not a polynomial anywhere, so no panel at any level
# is ever exact and every recursion level contributes to the answer.
var as_ln = calc_adaptive_simpson(&_as_recip, 0, F64_ONE, EPSILON_F64);
assert(f64_lt(f64_abs(f64_sub(as_ln, f64_ln(F64_TWO))), TOL_1EM14) == 1,
"adaptive Simpson of 1/(1+x) over [0,1] = ln 2");

# A Lorentzian with 99% of its mass in 10% of the domain. One panel returns
# 0.6702 against a true 0.1471 -- 355% error -- and only adaptivity recovers it.
var as_pk = calc_adaptive_simpson(&_as_peak, 0, F64_ONE,
f64_div(F64_ONE, f64_from(100000000000)));
var as_pk_want = f64_mul(f64_div(F64_ONE, f64_from(10)), f64_atan2(f64_from(10), F64_ONE));
assert(f64_lt(f64_abs(f64_sub(as_pk, as_pk_want)), f64_div(F64_ONE, f64_from(100000000000))) == 1,
"adaptive Simpson resolves a narrow peak: (1/10) atan(10)");

# 3D noise is bounded and deterministic.
var c9_p = perlin_3d(F64_HALF, F64_HALF, F64_HALF);
assert(f64_lt(f64_abs(c9_p), F64_ONE) == 1, "perlin_3d stays inside [-1,1]");
assert_eq(c9_p, perlin_3d(F64_HALF, F64_HALF, F64_HALF), "perlin_3d is deterministic");
assert(f64_lt(f64_abs(simplex_2d(F64_HALF, F64_HALF)), F64_ONE) == 1, "simplex_2d bounded");
assert(f64_lt(f64_abs(simplex_3d(F64_HALF, F64_HALF, F64_HALF)), F64_ONE) == 1, "simplex_3d bounded");

# --- SDF
var s9 = sdf_capsule(hvec3_new(0, F64_TWO, 0), hvec3_zero(), hvec3_unit_x(), F64_ONE);
assert_eq(f64_to(s9), 1, "sdf_capsule at distance 2 from a radius-1 capsule = 1");
# Smooth union is never worse than the plain min.
# Smooth union is a blend, so it sits between the two distances (it need not dip
# below min for every k -- that depends on the smoothing width).
var s9u = sdf_smooth_union(F64_ONE, F64_TWO, F64_HALF);
assert(f64_gt(s9u, 0) == 1, "sdf_smooth_union of two positive distances is positive");
assert(f64_lt(s9u, F64_TWO) == 1, "sdf_smooth_union stays at or below max(d1, d2)");

# --- CGA: the algebra identities.
var g9a = cga_point(F64_ONE, 0, 0);
var g9b = cga_mv_clone(g9a);
assert_eq(cga_mv_get(g9b, 1), cga_mv_get(g9a, 1), "cga_mv_clone copies blades");
var g9z = cga_mv_sub(g9a, g9b);
assert_eq(cga_norm_sq(g9z), 0, "cga_mv_sub of identical multivectors is zero");
var g9s = cga_mv_scale(g9a, F64_TWO);
assert_eq(cga_mv_get(g9s, 1), f64_mul(F64_TWO, cga_mv_get(g9a, 1)), "cga_mv_scale scales blades");
assert_neq(cga_mv_reverse(g9a), 0, "cga_mv_reverse exists");
# x ^ x = 0 for any vector.
assert_eq(cga_norm_sq(cga_outer_product(g9a, g9a)), 0, "cga outer product x^x = 0");
# A translator sandwiched on a point must move it.
var g9t = cga_translator(F64_ONE, 0, 0);
var g9m = cga_sandwich(cga_point(0, 0, 0), g9t);
assert_neq(g9m, 0, "cga_sandwich applies a versor");
assert_neq(cga_rotor(0, 0, F64_ONE, F64_PI_2), 0, "cga_rotor builds a rotor");
assert_neq(cga_sphere(0, 0, 0, F64_ONE), 0, "cga_sphere builds a sphere");
assert_neq(cga_plane(0, 0, F64_ONE, 0), 0, "cga_plane builds a plane");
assert_neq(cga_blade_inverse(cga_point(F64_ONE, F64_TWO, 0)), 0, "cga_blade_inverse exists");

# --- symbolic_ext pattern constructors and accessors.
var p9c = pat_const(f64_from(5));
assert_eq(f64_to(pat_val(p9c)), 5, "pat_const stores its value");
var p9v = pat_var(str_from("x"));
assert_eq(str_eq_cstr(pat_name(p9v), "x"), 1, "pat_var stores its name");
var p9p = pat_pow(p9v, p9c);
assert_eq(pat_tag(pat_left(p9p)), pat_tag(p9v), "pat_left of pow is the base");
assert_eq(f64_to(pat_val(pat_right(p9p))), 5, "pat_right of pow is the exponent");
assert_eq(pat_tag(pat_child(pat_neg(p9v))), pat_tag(p9v), "pat_child of neg is the operand");
assert_neq(pat_sin(p9v), 0, "pat_sin builds a pattern");
assert_neq(pat_cos(p9v), 0, "pat_cos builds a pattern");
assert_neq(pat_exp(p9v), 0, "pat_exp builds a pattern");
assert_neq(pat_ln(p9v), 0, "pat_ln builds a pattern");
# Rewriting: the default rule set must simplify x + 0 back to x.
var p9rules = sym_default_rules();
assert_neq(p9rules, 0, "sym_default_rules returns rules");
var p9e = expr_add(expr_var(str_from("x")), expr_const(0));
assert_neq(sym_rewrite(p9e, p9rules), 0, "sym_rewrite returns an expression");
assert_neq(sym_rule(pat_var(str_from("x")), expr_var(str_from("x"))), 0, "sym_rule builds a rule");

test_group("2.8.0 coverage: calc, num, optimize, lie_ext, linalg_ext tails");

# Trapezoid on x^2 over [0,1] is 1/3 + h^2/6; at n=1000 that is ~1.67e-7 above.
var c80_o = alloc(8);
assert_eq(calc_integral_trapez(&_c80_sq, 0, F64_ONE, 1000, c80_o), HSB_ERR_NONE, "trapez ok");
assert(f64_lt(f64_abs(f64_sub(load64(c80_o), 0x3FD5555555555555)), f64_div(F64_ONE, f64_from(1000000))) == 1,
"trapez of x^2 over [0,1] is within 1e-6 of 1/3");
# lerp endpoints are exact.
assert_eq(calc_lerp(F64_TWO, f64_from(6), 0), F64_TWO, "calc_lerp t=0 is a");
assert_eq(calc_lerp(F64_TWO, f64_from(6), F64_ONE), f64_from(6), "calc_lerp t=1 is b");
assert_eq(f64_to(calc_lerp(0, f64_from(10), F64_HALF)), 5, "calc_lerp midpoint = 5");
# Bezier ease is pinned at both ends by construction.
assert(f64_lt(f64_abs(cubic_bezier_ease(f64_div(F64_ONE, f64_from(4)), 0,
f64_div(f64_from(3), f64_from(4)), F64_ONE, 0)), LOOSE_TOL_M) == 1, "cubic_bezier_ease(0) = 0");
# A critically-damped spring already at its target must not move.
var c80_p = alloc(8);
var c80_v = alloc(8);
spring_step(F64_ONE, F64_ONE, 0, f64_from(100), f64_from(20), f64_div(F64_ONE, f64_from(60)),
c80_p, c80_v);
assert(f64_lt(f64_abs(f64_sub(load64(c80_p), F64_ONE)), LOOSE_TOL_M) == 1,
"spring_step at rest on target does not move");
assert(f64_lt(f64_abs(load64(c80_v)), LOOSE_TOL_M) == 1, "spring_step at rest keeps zero velocity");
assert(f64_lt(f64_abs(perlin_2d(F64_HALF, F64_HALF)), F64_ONE) == 1, "perlin_2d bounded");

# PCG32 float output is in [0,1) and advances.
var c80_r = pcg32_new(42);
var c80_a = pcg32_next_f64(c80_r);
assert(f64_lt(c80_a, F64_ONE) == 1, "pcg32_next_f64 < 1");
assert(f64_lt(f64_neg(EPSILON_F64), c80_a) == 1, "pcg32_next_f64 >= 0");
assert_neq(c80_a, pcg32_next_f64(c80_r), "pcg32_next_f64 advances the stream");

# Continued fraction of 415/93 is [4;2,6,7].
var c80_cf = num_continued_fraction_rational(415, 93);
assert_neq(c80_cf, 0, "continued fraction returns terms");
assert_eq(vec_get(c80_cf, 0), 4, "415/93 first term is 4");
assert_eq(vec_len(c80_cf), 4, "415/93 = [4;2,6,7] is 4 terms");
# Sobol stays in [0,1).
assert(f64_lt(num_sobol(7), F64_ONE) == 1, "num_sobol < 1");
# DCT/IDCT round-trip.
var c80_d = alloc(32);
store64(c80_d, F64_ONE); store64(c80_d + 8, F64_TWO);
store64(c80_d + 16, f64_from(3)); store64(c80_d + 24, f64_from(4));
assert_eq(num_dct(c80_d, 4), HSB_ERR_NONE, "num_dct ok");
assert_eq(num_idct(c80_d, 4), HSB_ERR_NONE, "num_idct ok");
assert(f64_lt(f64_abs(f64_sub(load64(c80_d), F64_ONE)), LOOSE_TOL_M) == 1,
"dct/idct round-trips element 0");

# Conjugate gradient on f(x) = x^2 must reach 0.
var c80_x0 = alloc(8);
store64(c80_x0, f64_from(5));
var c80_ox = alloc(8);
var c80_of = alloc(8);
assert_eq(opt_conjugate_gradient(&_c80_f, &_c80_g, c80_x0, 1, EPSILON_F64, 200, c80_ox, c80_of),
HSB_ERR_NONE, "conjugate gradient converges");
assert(f64_lt(f64_abs(load64(c80_ox)), f64_div(F64_ONE, f64_from(1000))) == 1,
"conjugate gradient finds x* = 0");

# Lyapunov exponent of the identity map is 0 (no expansion).
var c80_I = mat_identity(2);
var c80_ly = alloc(8);
assert_eq(lyapunov_max(c80_I, 2, 50, c80_ly), HSB_ERR_NONE, "lyapunov_max runs");
assert(f64_lt(f64_abs(load64(c80_ly)), LOOSE_TOL_M) == 1, "lyapunov of the identity is 0");

# svd_compute on a diagonal matrix gives its diagonal as the singular values.
var c80_A = mat_new(2, 2);
mat_set(c80_A, 0, 0, f64_from(3)); mat_set(c80_A, 1, 1, F64_TWO);
var c80_U = mat_new(2, 2);
var c80_V = mat_new(2, 2);
var c80_S = alloc(16);
assert_eq(svd_compute(c80_A, c80_U, c80_S, c80_V), HSB_ERR_NONE, "svd_compute succeeds");
assert(f64_lt(f64_abs(f64_sub(load64(c80_S), f64_from(3))), LOOSE_TOL_M) == 1,
"svd_compute s0 = 3 for diag(3,2)");

# Euler-Maruyama with zero drift and zero noise increment is a no-op.
assert_eq(ode_euler_maruyama(&_c80_sde_f, &_c80_sde_g, 0, F64_ONE, F64_HALF, 0), F64_ONE,
"euler_maruyama with dW = 0 and zero drift leaves y unchanged");

# bch_2nd_order takes COMPLEX MATRICES (cmat), not HVec3 -- bch_so3_2nd_order is
# the vector one. For commuting X, Y the commutator vanishes and Z = X + Y.
var c80_bx = cmat_identity(2);
var c80_by = cmat_scale(cmat_identity(2), cx_real(F64_TWO));
var c80_bz = bch_2nd_order(c80_bx, c80_by);
assert_neq(c80_bz, 0, "bch_2nd_order returns a matrix");
assert(f64_lt(f64_abs(f64_sub(HComplex_re(cmat_get(c80_bz, 0, 0)), f64_from(3))), LOOSE_TOL_M) == 1,
"bch_2nd_order of commuting I and 2I is 3I");
# Ad_L(X) takes a Mat4 GENERATOR X, not a 4-vector. Ad_I(X) = I*X*I^-1 = X.
var c80_X = m4_identity();
var c80_ad = lorentz_adjoint(lorentz_identity(), c80_X);
assert_neq(c80_ad, 0, "lorentz_adjoint returns a Mat4");
assert(f64_lt(f64_abs(f64_sub(m4_get(c80_ad, 0, 0), F64_ONE)), LOOSE_TOL_M) == 1,
"Ad_I(I) = I on the diagonal");
assert(f64_lt(f64_abs(m4_get(c80_ad, 0, 1)), LOOSE_TOL_M) == 1, "Ad_I(I) is off-diagonal zero");

test_group("delaunay_2d: cocircular input must be a real triangulation");

# The shipped implementation did NOT triangulate points on a circle. At n=150 it
# returned 1651 triangles where 148 is correct, with 206 edges shared by 3+
# triangles, 9 input points dropped, and a total area 244x the convex hull -- an
# overlapping soup, not a mesh. Nothing asserted that, so it survived. These pin
# the class: a convex polygon of n points triangulates to exactly n-2 triangles.
var dcc_n = 60;
var dcc = vec_new();
var dcc_i = 0;
while (dcc_i < dcc_n) {
    var dcc_a = f64_div(f64_mul(f64_mul(F64_TWO, F64_PI), f64_from(dcc_i)), f64_from(dcc_n));
    vec_push(dcc, hvec2_new(f64_mul(f64_from(100), f64_cos(dcc_a)),
    f64_mul(f64_from(100), f64_sin(dcc_a))));
    dcc_i = dcc_i + 1;
}
var dcc_t = delaunay_2d(dcc, dcc_n);
assert_eq(vec_len(dcc_t) / 3, dcc_n - 2, "circle-60 gives exactly n-2 = 58 triangles");

# Every input point must appear. The shipped code dropped 9 of 150 on this class.
var dcc_used = alloc(dcc_n * 8);
dcc_i = 0;
while (dcc_i < dcc_n) { store64(dcc_used + dcc_i * 8, 0); dcc_i = dcc_i + 1; }
dcc_i = 0;
while (dcc_i < vec_len(dcc_t)) {
    store64(dcc_used + vec_get(dcc_t, dcc_i) * 8, 1);
    dcc_i = dcc_i + 1;
}
var dcc_missing = 0;
dcc_i = 0;
while (dcc_i < dcc_n) {
    if (load64(dcc_used + dcc_i * 8) == 0) { dcc_missing = dcc_missing + 1; }
    dcc_i = dcc_i + 1;
}
assert_eq(dcc_missing, 0, "circle-60 uses every input point (shipped dropped 9 of 150)");

# No edge may be shared by more than two triangles -- the manifoldness check that
# would have caught the 206 over-shared edges directly.
var dcc_over = 0;
var dcc_e = 0;
while (dcc_e < vec_len(dcc_t)) {
    var dcc_ta = vec_get(dcc_t, dcc_e);
    var dcc_tb = vec_get(dcc_t, dcc_e + 1);
    var dcc_cnt = 0;
    var dcc_f = 0;
    while (dcc_f < vec_len(dcc_t)) {
        var x0 = vec_get(dcc_t, dcc_f);
        var x1 = vec_get(dcc_t, dcc_f + 1);
        var x2 = vec_get(dcc_t, dcc_f + 2);
        var hit = 0;
        if (x0 == dcc_ta || x1 == dcc_ta || x2 == dcc_ta) {
            if (x0 == dcc_tb || x1 == dcc_tb || x2 == dcc_tb) { hit = 1; }
        }
        dcc_cnt = dcc_cnt + hit;
        dcc_f = dcc_f + 3;
    }
    if (dcc_cnt > 2) { dcc_over = dcc_over + 1; }
    dcc_e = dcc_e + 3;
}
assert_eq(dcc_over, 0, "circle-60 is manifold: no edge shared by 3+ triangles");

# A smaller circle, and a circle with an interior point, for the same invariant.
var dcc2 = vec_new();
dcc_i = 0;
while (dcc_i < 12) {
    var a2 = f64_div(f64_mul(f64_mul(F64_TWO, F64_PI), f64_from(dcc_i)), f64_from(12));
    vec_push(dcc2, hvec2_new(f64_mul(f64_from(50), f64_cos(a2)),
    f64_mul(f64_from(50), f64_sin(a2))));
    dcc_i = dcc_i + 1;
}
assert_eq(vec_len(delaunay_2d(dcc2, 12)) / 3, 10, "circle-12 gives exactly 10 triangles");
vec_push(dcc2, hvec2_new(0, 0));
assert_eq(vec_len(delaunay_2d(dcc2, 13)) / 3, 12, "circle-12 + centre gives 12 triangles");

test_group("delaunay_2d: symbolic ghost vertices — completeness (2.8.2)");

# Until 2.8.2 the enclosing triangle was placed at 10x the bounding box. That is
# not far enough for Bowyer-Watson to reduce to the true Delaunay triangulation:
# a super-vertex lands inside a real circumcircle, the real triangle is never
# created, and compaction then drops the super-vertex triangle that was covering
# the gap — so the mesh comes back with a HOLE and no error signal. Every number
# asserted below was computed independently in exact rational arithmetic
# (python3 fractions) from these same points; the "was" figures are what the 10x
# build actually returned.
#
# Twenty uniform points. Correct answer 32 triangles; the 10x build returned 31,
# missing exactly (3, 7, 17) and leaving a hole of 1.5e-4 of the hull.
var dlu_p = vec_new();
vec_push(dlu_p, hvec2_new(0x3FD8C0CEC328E270, 0x3FE812E629B272E6));
vec_push(dlu_p, hvec2_new(0x3FCDC969F80835E0, 0x3FB96E4EC2DA05B8));
vec_push(dlu_p, hvec2_new(0x3FC80F13C7D500AC, 0x3FD85BE58C2C01D0));
vec_push(dlu_p, hvec2_new(0x3FEF89BC83E37983, 0x3FE05AF18260D33D));
vec_push(dlu_p, hvec2_new(0x3FDB4AFA8EA7BA7A, 0x3FE34F6290EC133A));
vec_push(dlu_p, hvec2_new(0x3FDCD4957A495F30, 0x3FC17F76452A82D0));
vec_push(dlu_p, hvec2_new(0x3FEBF9DC63B08AF1, 0x3FDCF927BD572532));
vec_push(dlu_p, hvec2_new(0x3FEE8CBA8769242D, 0x3FEE0C15B7632E23));
vec_push(dlu_p, hvec2_new(0x3FEA98636076B666, 0x3FDD81DBD1A9532A));
vec_push(dlu_p, hvec2_new(0x3FC422E52A6C09C8, 0x3FDD22851977B7FC));
vec_push(dlu_p, hvec2_new(0x3FBD67C34F6A2A30, 0x3FEF99504BDA8630));
vec_push(dlu_p, hvec2_new(0x3FC70CE1A98856CC, 0x3FEC05582B4C6EE6));
vec_push(dlu_p, hvec2_new(0x3FC3F8F2F2A3F09C, 0x3FE6CDCE8132D3F1));
vec_push(dlu_p, hvec2_new(0x3FEDF6B8FF30665C, 0x3FBF3E8962E9DA60));
vec_push(dlu_p, hvec2_new(0x3FDD591B04B156E8, 0x3FEB0438AD2BC08A));
vec_push(dlu_p, hvec2_new(0x3FD1676710F19B32, 0x3FC8E45942145290));
vec_push(dlu_p, hvec2_new(0x3FEF472D623A46FD, 0x3FD908955BC97386));
vec_push(dlu_p, hvec2_new(0x3FEF1066CD5B4598, 0x3FE6ADE2DE457104));
vec_push(dlu_p, hvec2_new(0x3FD7DAE09D47AB16, 0x3FDCAA334C08CCB8));
vec_push(dlu_p, hvec2_new(0x3FBF6F4281D4A0C0, 0x3F5B894417A4F800));
var dlu_t = delaunay_2d(dlu_p, 20);
assert_eq(vec_len(dlu_t) / 3, 32, "uniform-20: 32 triangles (10x super-triangle gave 31)");
assert_eq(_dl_tiles_hull(dlu_p, 20, dlu_t), 1, "uniform-20: mesh tiles the hull, no hole");
assert_eq(_dl_used(20, dlu_t), 20, "uniform-20: every input point used");
assert_eq(_dl_max_edge_share(dlu_t), 2, "uniform-20: manifold");
assert_eq(_dl_violations(dlu_p, 20, dlu_t), 0, "uniform-20: empty-circumcircle");

# 160 uniform points — the class the audit measured at 15-37% incomplete, and
# 29 of 40 seeds short at this size. Correct 305; the 10x build returned 304.
var dlb_p = _dlr_points(160, 2, F64_ONE, F64_ONE);
var dlb_t = delaunay_2d(dlb_p, 160);
assert_eq(vec_len(dlb_t) / 3, 305, "uniform-160: 305 triangles (10x gave 304)");
assert_eq(_dl_tiles_hull(dlb_p, 160, dlb_t), 1, "uniform-160: mesh tiles the hull");
assert_eq(_dl_used(160, dlb_t), 160, "uniform-160: every input point used");

# A cluster of span 1e-20. The old `dx = max(span, 1.0)` floor gave this a
# super-triangle 1e20 times the data, so the in-circle determinant differenced
# quantities 40 orders apart and lost the sign entirely: 61 triangles instead of
# 70, five points dropped, and a total area 1.69x the convex hull — overlapping,
# not merely incomplete. Ghost vertices have no scale, so there is nothing left
# to mis-scale.
var dlc_p = _dlr_points(40, 1, 0x3BC79CA10C924223, F64_ONE);   # span 1e-20
var dlc_t = delaunay_2d(dlc_p, 40);
assert_eq(vec_len(dlc_t) / 3, 70, "cluster-1e-20: 70 triangles (10x gave 61)");
assert_eq(_dl_tiles_hull(dlc_p, 40, dlc_t), 1,
"cluster-1e-20: mesh tiles the hull (10x covered 1.69x it)");
assert_eq(_dl_used(40, dlc_t), 40, "cluster-1e-20: every input point used (10x dropped 5)");
assert_eq(_dl_max_edge_share(dlc_t), 2, "cluster-1e-20: manifold");
assert_eq(_dl_violations(dlc_p, 40, dlc_t), 0, "cluster-1e-20: empty-circumcircle");

# Aspect ratio 1e6 (a 1 x 1e-6 strip). The 10x build returned ONE triangle of
# the 70 required and dropped 37 of the 40 points, covering 0.07% of the hull —
# the "extreme-aspect" failure carried on the roadmap since 2.7.0.
var dls_p = _dlr_points(40, 1, F64_ONE, 0x3EB0C6F7A0B5ED8D);   # flat 1e-6
var dls_t = delaunay_2d(dls_p, 40);
assert_eq(vec_len(dls_t) / 3, 70, "thin-strip-1e6: 70 triangles (10x gave 1)");
assert_eq(_dl_used(40, dls_t), 40, "thin-strip-1e6: every input point used (10x dropped 37)");
assert_eq(_dl_max_edge_share(dls_t), 2, "thin-strip-1e6: manifold");
assert_eq(_dl_violations(dls_p, 40, dls_t), 0, "thin-strip-1e6: empty-circumcircle");

test_group("delaunay_2d: emitted winding is counter-clockwise");

# delaunay_2d normalises every emitted triangle to CCW at compaction time and
# nothing verified it. Every other assertion in this file is orientation-blind:
# _dl_area2_abs takes |signed area| specifically so a folded triangle cannot
# cancel, _dl_tiles_hull is built on it, and edge-share count, point usage and
# the empty-circumcircle test are all invariant under a vertex swap. Deleting
# or inverting the swap therefore changed nothing the suite could see -- and
# consumers (halfedge_from_triangles, and anything computing a face normal from
# the vertex order) depend on it.
#
# Strictly positive signed area, over every delaunay fixture in this file: the
# regular grid, the cocircular circle-60, the two irregular hand fixtures, and
# all four ghost-vertex classes including the 1e-20 cluster and the 1e6 strip.
# Strict, not >= 0 -- a zero-area triangle has no winding and would be a defect
# in its own right.
assert_eq(_dl_non_ccw(dl_sq, dl_sqt), 0, "winding: square+interior all CCW");
assert_eq(_dl_non_ccw(dl_g, dl_gt), 0, "winding: 3x3 grid all CCW (cocircular)");
assert_eq(_dl_non_ccw(dl_i, dl_it), 0, "winding: irregular-6 all CCW");
assert_eq(_dl_non_ccw(dcc, dcc_t), 0, "winding: cocircular circle-60 all CCW");
assert_eq(_dl_non_ccw(dlu_p, dlu_t), 0, "winding: uniform-20 all CCW");
assert_eq(_dl_non_ccw(dlb_p, dlb_t), 0, "winding: uniform-160 all CCW");
assert_eq(_dl_non_ccw(dlc_p, dlc_t), 0, "winding: cluster-1e-20 all CCW");
assert_eq(_dl_non_ccw(dls_p, dls_t), 0, "winding: thin-strip-1e6 all CCW");

# The eight assertions above pin the CONTRACT, but on all eight of those inputs
# the swap never fires: the ghost-vertex Bowyer-Watson orients its cavity
# boundaries counter-clockwise by construction, exactly as the comment in
# collision_mesh.cyr claims, so the emitted triangles are already CCW and
# deleting the swap changes nothing they can see.
#
# It is NOT dead code, though. Sweeping 432 point sets -- six generators
# (uniform, clustered, thin-strip, lattice-snapped, cocircular, duplicated) x
# four spans (1, 1e-20, 1e16, 1e-4) x three aspect ratios (1, 1e-6, 5.7e6) --
# with the swap disabled, 430 still came back all-CCW and exactly two did not,
# both in the lattice-snapped extreme-aspect class. That class is reproduced
# here: 16 points on a 6x6 lattice, x = i/6, y = (j/6) * 1e-6, with (1,1)
# duplicated, so the input is simultaneously degenerate (repeated point,
# collinear rows) and aspect-1e6. This is the fixture that makes the
# normalisation load-bearing rather than decorative.
var dlw_ij = alloc(128);
store64(dlw_ij, 101); store64(dlw_ij + 8, 303);
store64(dlw_ij + 16, 305); store64(dlw_ij + 24, 505);
store64(dlw_ij + 32, 0); store64(dlw_ij + 40, 404);
store64(dlw_ij + 48, 504); store64(dlw_ij + 56, 300);
store64(dlw_ij + 64, 1); store64(dlw_ij + 72, 101);
store64(dlw_ij + 80, 302); store64(dlw_ij + 88, 202);
store64(dlw_ij + 96, 3); store64(dlw_ij + 104, 104);
store64(dlw_ij + 112, 403); store64(dlw_ij + 120, 304);
var dlw_p = vec_new();
for (var dlw_i = 0; dlw_i < 16; dlw_i = dlw_i + 1) {
    var dlw_c = load64(dlw_ij + dlw_i * 8);
    vec_push(dlw_p, hvec2_new(f64_div(f64_from(dlw_c / 100), f64_from(6)),
    f64_mul(0x3EB0C6F7A0B5ED8D, f64_div(f64_from(dlw_c % 100), f64_from(6)))));
}
var dlw_t = delaunay_2d(dlw_p, 16);
assert(vec_len(dlw_t) > 0, "winding: the lattice-strip fixture produces triangles at all");
assert_eq(_dl_non_ccw(dlw_p, dlw_t), 0,
"winding: lattice-snapped 1e6 strip all CCW (the class that REACHES the swap)");

# The harness itself must be able to fail, or the assertions above are just
# ways of counting an empty set. Feed it the same triangles with two vertices
# of each transposed: every one must now read as non-CCW.
var dlw_flip = vec_new();
for (var dlw_k = 0; dlw_k < vec_len(dlu_t); dlw_k = dlw_k + 3) {
    vec_push(dlw_flip, vec_get(dlu_t, dlw_k + 1));
    vec_push(dlw_flip, vec_get(dlu_t, dlw_k));
    vec_push(dlw_flip, vec_get(dlu_t, dlw_k + 2));
}
assert_eq(_dl_non_ccw(dlu_p, dlw_flip), vec_len(dlu_t) / 3,
"winding: the CCW harness flags all 32 triangles when they are transposed");

test_group("delaunay_2d: ghost directions — the equal-|u_k|² property (2.9.0)");

# The eight fixtures above exercise the ghost MACHINERY but not the six numbers
# it runs on: swapping all of them for the documented failing set
# (-1,-1), (1,-1), (0,1) leaves modules, abuse and hisab green. What follows
# asserts the two properties collision_mesh.cyr:89-92 and :115-119 say the set
# must have, and then the consequence the tie rule is derived from. See the
# harness comment beside _dlg_l for why these are properties and not literals.

# 1. EQUAL SQUARED NORMS — the load-bearing one, exact, no tolerance.
var dlg_l0 = _dlg_l(0);
var dlg_l1 = _dlg_l(1);
var dlg_l2 = _dlg_l(2);
assert_eq(f64_gt(dlg_l0, 0), 1, "ghost dirs: u0 is not the zero vector");
assert_eq(f64_eq(dlg_l0, dlg_l1), 1, "ghost dirs: |u0|² == |u1|² exactly");
assert_eq(f64_eq(dlg_l1, dlg_l2), 1, "ghost dirs: |u1|² == |u2|² exactly");

# 2. ORIENTATION AND SPANNING. All three cyclic crosses positive says exactly
# that the ghost triangle is counter-clockwise AND the origin lies strictly
# inside it, i.e. the directions positively span the plane, i.e. for large
# enough M the ghost triangle contains any bounded input. The anti-cyclic three
# being the negatives says no two directions are parallel. This is the property
# the failing set ALSO has, which is why it cannot be the only thing asserted.
assert_eq(_col_ghost_cross(0, 1), 1, "ghost dirs: u0 x u1 > 0 (cyclic, CCW)");
assert_eq(_col_ghost_cross(1, 2), 1, "ghost dirs: u1 x u2 > 0 (cyclic, CCW)");
assert_eq(_col_ghost_cross(2, 0), 1, "ghost dirs: u2 x u0 > 0 (cyclic, CCW)");
assert_eq(_col_ghost_cross(1, 0), 0 - 1, "ghost dirs: u1 x u0 < 0 (no two parallel)");
assert_eq(_col_ghost_cross(2, 1), 0 - 1, "ghost dirs: u2 x u1 < 0 (no two parallel)");
assert_eq(_col_ghost_cross(0, 2), 0 - 1, "ghost dirs: u0 x u2 < 0 (no two parallel)");

# 3. THE CONSEQUENCE the predicates are written against: with the norms equal,
# the leading coefficients of the two-ghost in-circle determinant lose their
# dependence on the individual ghosts and collapse to the two cheap forms
# _col_dl_ic_g2 evaluates.
assert_eq(_dlg_c3_bad(), 0,
"ghost dirs: M³ coefficient collapses to |u|² * (r x (u_j - u_k)) for every r");

_dlg_run(0);
assert_eq(_DLG_PROBES, 450, "ghost dirs: probe grid ran (3 cyclic pairs x 3 apexes x 5 R x 10 p)");
assert_gt(_DLG_DECIDED, 400, "ghost dirs: the grid decides at this order (not a skipped set)");
assert_gt(_DLG_TIE, 200, "ghost dirs: the M² TIE branch is REACHED — no other fixture reaches it");
assert_gt(_DLG_INSIDE, 0, "ghost dirs: the oracle answers inside somewhere");
assert_lt(_DLG_INSIDE, _DLG_DECIDED, "ghost dirs: the oracle answers outside somewhere");
assert_eq(_DLG_TAIL, 0,
"ghost dirs: M² coefficient == (u_j x u_k)(|R-A|² - |A-p|²), no query-dependent tail");
assert_eq(_DLG_MISMATCH, 0,
"ghost dirs: _col_dl_ic_g2 agrees with the general-expansion oracle on every probe");
assert_eq(_DLG_PERM, 0,
"ghost dirs: two-ghost in-circle is INDEPENDENT of vertex order (cyclic entry, all 6)");

# 4. THE ANTI-CYCLIC HALF (2.9.1). Everything above -- and every delaunay_2d
# fixture in every suite -- feeds _col_dl_ic_g2 only the three CYCLIC pairs,
# because _col_dl_incircle rotates a CCW-stored triangle and rotation is even.
# The same grid over the three ANTI-CYCLIC pairs is the other half of the
# predicate's input space, and through 2.9.0 the M² tie branch answered it
# backwards: it multiplied by the winding a SECOND time, and the M² coefficient
# already carries one factor of it. _dlg_truth reads the sign of the leading
# nonzero coefficient against the winding once, which is the rule both branches
# owe, so it is the same oracle in both directions.
_dlg_run(1);
assert_eq(_DLG_PROBES, 450, "anti-cyclic: probe grid ran (3 anti-cyclic pairs x 3 A x 5 R x 10 p)");
assert_gt(_DLG_DECIDED, 400, "anti-cyclic: the grid decides at this order (not a skipped set)");
assert_gt(_DLG_TIE, 200, "anti-cyclic: the M² TIE branch is REACHED on the anti-cyclic half too");
assert_gt(_DLG_INSIDE, 0, "anti-cyclic: the oracle answers inside somewhere");
assert_lt(_DLG_INSIDE, _DLG_DECIDED, "anti-cyclic: the oracle answers outside somewhere");
assert_eq(_DLG_TAIL, 0,
"anti-cyclic: M² coefficient == (u_j x u_k)(|R-A|² - |A-p|²) with the winding reversed");
assert_eq(_DLG_MISMATCH, 0,
"anti-cyclic: _col_dl_ic_g2 agrees with the general-expansion oracle (2.9.0 inverted every tie)");
assert_eq(_DLG_PERM, 0,
"anti-cyclic: two-ghost in-circle is INDEPENDENT of vertex order (anti-cyclic entry, all 6)");

# ================================================================
# gjk_epa_3d — EPA narrowphase (2.8.3)
# ================================================================
#
# Before 2.8.3 gjk_epa_3d had ZERO assertions in all four suites: neither the
# O(k²) blow-up nor a 40x-wrong depth would have been caught by anything. The
# fixtures below are the two the 2026-08-04 audit and the rejected flood-fill
# repair turned on, and each reference value was computed independently of
# hisab — never by running the code being tested.
test_group("geo_advanced: gjk_epa_3d (EPA narrowphase)");

# --- Fixture 1: cylinder vs rotated box (the rejected repair's counter-example)
# A flood-fill visibility scan returns a depth 40.7x too small here. The
# reference depth is the distance from the origin to the boundary of the
# Minkowski difference K = A ⊖ B, i.e. min over unit d of
#   h_K(d) = r·√(dx²+dy²) + hz·|dz| − ⟨d,c⟩ + Σ hᵢ·|⟨d,uᵢ⟩|
# minimised EXACTLY: the four planes dz = 0 and ⟨d,uᵢ⟩ = 0 cut the sphere into
# cells, h_K is r·ρ(d) + ⟨w,d⟩ inside each one (closed-form minimum), and the
# cell boundaries are four great circles (1-D minimisation) meeting at twelve
# vertices. Enumerating all three families is complete → 0.19769663486454536.
# The audit quotes 0.19783922047988 for this fixture; that is a grid minimum,
# 7.2e-4 relative HIGH — both bounds are asserted below, so either reading
# rejects the flood-fill answer.
var epa_cyl = _ga_mkcyl(0, 0, 0,
0x3FFE11D50BAEBAF1,   # 1.8793535667752475
0x3FF47743423A7FC0);  # 1.2791168772746317
var epa_box = _ga_mkobb(
0x4005732F92CFB63E,   # 2.681243082965721
0xC006EB1792881994,   # -2.8647910545143507
0xBFFF55B8C5B1A9C0,   # -1.9584281656667457
0x3FFE93DAB8D7F5D9,   # 1.911097261472028
0x3FFAE1DE4A99CE2F,   # 1.6801436342328875
0x3FF3482F05E60E8C,   # 1.20512296966709
0xBFC3C6C421B492C3,   # -0.15450336118478533
0xBF83D78D1A18CF7C,   # -0.009688474997439071
0xBFBCE8D2315CE899,   # -0.11292756753110424
0x3FEF68328B0A8894);  # 0.9814694133422273
var epa_n = alloc(8);
var epa_d = alloc(8);
_ga_sup_calls = 0;
var epa_arena0 = alloc_used();
var epa_hit = gjk_epa_3d(&_ga_sup_cyl, epa_cyl, &_ga_sup_obb, epa_box, epa_n, epa_d);
var epa_arena = alloc_used() - epa_arena0;
assert_eq(epa_hit, 1, "gjk_epa_3d: cylinder vs rotated box penetrates");
assert(f64_approx_eq(load64(epa_d), 0x3FC94E1F92A2E07C, 0x3EB0C6F7A0B5ED8D),
"gjk_epa_3d: cyl/box depth == 0.1976966349 ± 1e-6 (flood fill gave 0.00486)");
assert(f64_approx_eq(load64(epa_d), 0x3FC952CBAAE9E248, 0x3F2A36E2EB1C432D),
"gjk_epa_3d: cyl/box depth == 0.19783922047988 ± 2e-4 (the audit's own figure)");
var epa_nlen = hvec3_length(load64(epa_n));
assert(f64_approx_eq(epa_nlen, F64_ONE, TOL_1EM12), "gjk_epa_3d: returned normal is unit");

# --- The O(k²) gate. The polytope's face planes used to be recomputed for
# EVERY face on EVERY iteration, each recompute alloc()ing five blocks from an
# arena that never frees — so arena grew with the SQUARE of the iteration count
# (8,576 face evaluations and 1,474,416 bytes for this one call). Cached face
# records make it linear, and the plane is computed once per face created. EPA
# issues exactly one Minkowski support query per iteration, so
# bytes-per-support-call is the scale-free form of that claim: it was 10,531.
# This assertion FAILS against the pre-2.8.3 source, and stays valid if
# EPA_MAX_ITER is ever raised — which is the whole point of testing the ratio
# rather than the total.
#
# 2.9.0: the bound was 2000 against a true value of 727, i.e. 2.75x headroom,
# and a mutation sweep showed that was ~25x above the defect scale — re-adding
# the pre-2.9.0 per-face-record alloc(80) INSIDE the per-iteration visibility
# scan reads 1,602 here and sailed under 2000. Measured on this tree:
# arena 46,544 B over 64 support calls = 727 B/call, IDENTICAL on five
# consecutive runs (the arena is a bump allocator over a fixed code path, so
# there is no run-to-run variation to leave room for). The bound is now 900 —
# 23.8% over the measured value, and the 80 B/face/iteration injection
# overshoots it by 78%.
assert_lt(epa_arena / _ga_sup_calls, 900,
"gjk_epa_3d: arena per EPA iteration is O(1), not O(faces) (727 B/call, was 10,531)");

# Two identical calls must agree bit-for-bit: the face records are built per
# call, so a leaked pointer or a stale cache between calls would show up here.
var epa_n2 = alloc(8);
var epa_d2 = alloc(8);
gjk_epa_3d(&_ga_sup_cyl, epa_cyl, &_ga_sup_obb, epa_box, epa_n2, epa_d2);
assert_eq(load64(epa_d2), load64(epa_d), "gjk_epa_3d: repeated call is bit-identical (depth)");
assert_eq(HVec3_x(load64(epa_n2)), HVec3_x(load64(epa_n)),
"gjk_epa_3d: repeated call is bit-identical (normal.x)");

# --- Fixture 2: two spheres, where the depth has a closed form.
# r_a + r_b − |c_a − c_b| = 2.433 + 2.041 − 2.0780998532313117.
var epa_sa = hvec4_new(0, 0, 0, 0x400376C8B4395810);            # r = 2.433
var epa_sb = hvec4_new(0xBFF68B4395810625,                      # -1.409
0x3FF85E353F7CED91,                                             # 1.523
0x3FBDF3B645A1CAC1,                                             # 0.117
0x400053F7CED91687);                                            # r = 2.041
var epa_n3 = alloc(8);
var epa_d3 = alloc(8);
_ga_sup_calls = 0;
var epa_ar3_0 = alloc_used();
var epa_hit3 = gjk_epa_3d(&_ga_sup_sphere, epa_sa, &_ga_sup_sphere, epa_sb, epa_n3, epa_d3);
var epa_ar3 = alloc_used() - epa_ar3_0;
assert_eq(epa_hit3, 1, "gjk_epa_3d: overlapping spheres penetrate");
assert(f64_approx_eq(load64(epa_d3), 0x40032ACDB236D32F, 0x3EE4F8B588E368F1),
"gjk_epa_3d: sphere/sphere depth == 2.3959001468 ± 1e-5 (closed form)");

# The same O(1)-per-iteration budget on the fixture that runs the MOST
# iterations, which is where a per-face-per-iteration leak is loudest: a smooth
# body never lands a support point exactly on the hull, so this call spends 552
# support queries against the cylinder/box fixture's 64. Measured on this tree:
# 163,488 B over 552 calls = 296 B/call, identical on five consecutive runs.
# The 80 B/face/iteration injection takes it to 917 — 3.1x, the sharpest signal
# of any arena fixture here, because the leak is quadratic in the iteration
# count and this is the fixture with the iterations. Bound 400 = 35% headroom.
assert_gt(_ga_sup_calls, 100, "gjk_epa_3d: the sphere fixture really does run many iterations");
assert_lt(epa_ar3 / _ga_sup_calls, 400,
"gjk_epa_3d: arena per iteration stays O(1) at 8x the iteration count (296 B/call)");

# --- 2.9.1: THE SAME BUDGET FOR mpr_penetration, ON THE SAME SPHERE PAIR.
# The mpr_penetration arena bound (`:2958`) is an ABSOLUTE one taken on the
# off-axis box/box pair, and that fixture runs 24 support calls. It is far too
# short to see a per-face-per-iteration leak: measured on this tree, baseline
# 22,776 B against a 25,600 bound, and the 80 B/face/iteration injection reaches
# only 25,656 -- it clears the bound by 56 B, 0.22%. Any looser and the injection
# passes; any tighter and legitimate change trips it. A thin bound is not fixed
# by a tighter number, it is fixed by a fixture with MORE ITERATIONS, because the
# leak is quadratic in the iteration count while the honest cost is linear.
#
# This is that fixture, and it is deliberately the pair the gjk_epa_3d row above
# already uses, so the two identically-shaped budgets are directly comparable.
# Measured on this tree, byte-identical on five separate processes AND on five
# repeat calls inside one process (alloc_used() over a fixed code path has no
# run-to-run variation, so the headroom below is for future legitimate change,
# not for noise): 167,904 B over 572 support calls = 293 B/call, against the
# sibling's 296 over 552. The injection takes it to 510,944 B = 893 B/call, a
# 3.05x jump -- the same shape as the sibling's 296 -> 917. Bound 400 (the
# sibling's number): 36% headroom, and the injection overshoots it by 123%.
# Detection margin 0.22% -> 123%.
var mpr_ar_n = alloc(8);
var mpr_ar_d = alloc(8);
_ga_sup_calls = 0;
var mpr_ar_0 = alloc_used();
var mpr_ar_hit = mpr_penetration(&_ga_sup_sphere, epa_sa, &_ga_sup_sphere, epa_sb,
mpr_ar_n, mpr_ar_d);
var mpr_ar = alloc_used() - mpr_ar_0;
var mpr_ar_calls = _ga_sup_calls;
assert_eq(mpr_ar_hit, 1, "mpr_penetration: the high-iteration sphere pair penetrates");
assert(f64_approx_eq(load64(mpr_ar_d), 0x40032ACDB236D32F, 0x3EE4F8B588E368F1),
"mpr_penetration: sphere/sphere depth == 2.3959001468 (same closed form as gjk_epa_3d)");
assert_gt(mpr_ar_calls, 100,
"mpr_penetration: the sphere fixture really does run many iterations (572 vs the box pair's 24)");
assert_lt(mpr_ar / mpr_ar_calls, 400,
"mpr_penetration: arena per iteration stays O(1) at 24x the iteration count (293 B/call)");

# --- Fixture 3: the closest-face TIE-BREAK, which is load-bearing.
# The scan keeps the first face with a STRICTLY smaller distance, and the face
# list is in creation order, so ties resolve to the lowest creation index.
# Relaxing that to ">= wins" (keep the LAST minimum) changes 6,042 of 50,000
# random narrowphase results, 383 of them by more than 0.1% — this fixture is
# one of them: it drops from 0.7379589527 to 0.3718195100. Reference computed
# by the same exact cell/great-circle enumeration as fixture 1:
# 0.737958952740702, which the shipped answer matches to 1.1e-11.
var epa_cyl2 = _ga_mkcyl(0, 0, 0,
0x4001666666666666,   # 2.175
0x3FF1A5E353F7CED9);  # 1.103
var epa_box2 = _ga_mkobb(
0x40067CED916872B0,   # 2.811
0xC005916872B020C5,   # -2.696
0xBFE353F7CED91687,   # -0.604
0x3FE29FBE76C8B439,   # 0.582
0x40036872B020C49C,   # 2.426
0x3FF58D4FDF3B645A,   # 1.347
0x3FEA9F35A31B555D,   # 0.8319347558669211
0xBF82EE5F07E5ED0F,   # -0.009243719509632457
0x3FE1BF7917678E3E,   # 0.5546231705779474
0x3F8C658E8BD8E397);  # 0.013865579264448686
var epa_n5 = alloc(8);
var epa_d5 = alloc(8);
assert_eq(gjk_epa_3d(&_ga_sup_cyl, epa_cyl2, &_ga_sup_obb, epa_box2, epa_n5, epa_d5), 1,
"gjk_epa_3d: tie-break fixture penetrates");
assert(f64_approx_eq(load64(epa_d5), 0x3FE79D5C17F9F9A6, 0x3EB0C6F7A0B5ED8D),
"gjk_epa_3d: cyl/box depth == 0.7379589527 ± 1e-6 (last-minimum tie-break gives 0.372)");

# Separated shapes: no penetration, and the miss must not be reported as a hit.
var epa_far = hvec4_new(0x4024000000000000, 0, 0, F64_ONE);     # centre x=10, r=1
var epa_n4 = alloc(8);
var epa_d4 = alloc(8);
assert_eq(gjk_epa_3d(&_ga_sup_sphere, epa_sa, &_ga_sup_sphere, epa_far, epa_n4, epa_d4), 0,
"gjk_epa_3d: separated spheres do not penetrate");

test_group("_epa_seed_portal: the two SYMMETRY repairs, seen directly (2.9.0)");

# _epa_seed_portal has two branches that exist only for symmetric inputs:
#   * the ORIGIN NUDGE (geo_advanced.cyr:668) — the x-midpoint of the difference
#     IS the origin, so the ray v0 -> origin has no direction and the interior
#     point is displaced by a millionth of the body's own extent; and
#   * the COLINEAR-RAY fallback (geo_advanced.cyr:683) — origin, v0 and v1 are
#     colinear, so the plane through them is undefined and ANY perpendicular to
#     v0 serves. The comment records that the shipped code "treated this as a
#     failure and bailed".
# Replacing EITHER with `return 0;` left all five suites green. Both are live:
# mpr_penetration's concentric-sphere depth moves by 1e-9. Nothing noticed,
# because mpr_penetration falls back to _epa_seed_gjk (collision_core.cyr:126)
# and GJK reaches a usable tetrahedron by a different route — so both answers
# land inside the same tolerance and no depth assertion at any tolerance a real
# consumer would accept can tell "the portal handled it" from "the portal bailed
# and GJK covered".
#
# So do not ask the depth. Ask the SEEDER, which is a plain function in the same
# flat namespace: it must RETURN 1 (it handled the case) and the tetrahedron it
# wrote must be a legal EPA seed — non-degenerate volume and the origin strictly
# inside all four faces, which is exactly _epa_tetra_ok's contract.

var psd = alloc(32);
var psd2 = alloc(32);
var psd3 = alloc(32);

# P1 — concentric spheres: the difference is a ball centred ON the origin, so
# the x-midpoint is the origin (NUDGE) and the ray then runs down -x into a
# support point that is also on -x (COLINEAR). Both branches, one fixture.
var psd_a1 = hvec4_new(0, 0, 0, 0x3FF4000000000000);            # r = 1.25
var psd_b1 = hvec4_new(0, 0, 0, 0x3FE8000000000000);            # r = 0.75
assert_eq(_epa_seed_portal(&_ga_sup_sphere, psd_a1, &_ga_sup_sphere, psd_b1, psd), 1,
"portal seed: concentric spheres are SEEDED, not bailed on");
assert_eq(_psd_ok(psd), 1,
"portal seed: the concentric-sphere tetrahedron encloses the origin");

# P2 — spheres offset along x by 0.5: the difference is a ball centred at
# (-0.5, 0, 0), so the x-midpoint is NOT the origin (no nudge) but the ray
# v0 -> origin still runs along x into an x-axis support point (COLINEAR only).
var psd_b2 = hvec4_new(0x3FE0000000000000, 0, 0, 0x3FE8000000000000);   # c=(0.5,0,0)
assert_eq(_epa_seed_portal(&_ga_sup_sphere, psd_a1, &_ga_sup_sphere, psd_b2, psd2), 1,
"portal seed: colinear ray with an off-origin interior point is SEEDED");
assert_eq(_psd_ok(psd2), 1,
"portal seed: the offset-sphere tetrahedron encloses the origin");

# P3 — a generically rotated box against a sphere, both centred at the origin.
# The rotation has no zero component, so the box's +x and -x support points are
# exact negatives of each other and the x-midpoint is again the origin (NUDGE),
# but they are corners well off the x axis, so the ray is NOT colinear.
var psd_q = f64_div(F64_ONE, f64_sqrt(f64_from(30)));
var psd_a3 = _ga_mkobb(0, 0, 0, F64_ONE, F64_TWO, f64_from(3),
psd_q, f64_mul(F64_TWO, psd_q), f64_mul(f64_from(3), psd_q), f64_mul(f64_from(4), psd_q));
var psd_b3 = hvec4_new(0, 0, 0, F64_HALF);
assert_eq(_epa_seed_portal(&_ga_sup_obb, psd_a3, &_ga_sup_sphere, psd_b3, psd3), 1,
"portal seed: origin x-midpoint with a NON-colinear ray is SEEDED");
assert_eq(_psd_ok(psd3), 1,
"portal seed: the box/sphere tetrahedron encloses the origin");

# And the depth that seed produces still has to be right — asserted here so a
# seed that merely satisfies _epa_tetra_ok cannot pass while feeding _epa_refine
# a tetrahedron that is legal but useless. Concentric: r_a + r_b = 2 exactly.
# Offset by 0.5: r_a + r_b - |c| = 1.5 exactly.
var psd_n = alloc(8);
var psd_d = alloc(8);
assert_eq(mpr_penetration(&_ga_sup_sphere, psd_a1, &_ga_sup_sphere, psd_b1, psd_n, psd_d), 1,
"portal seed: concentric spheres report a hit");
assert(f64_approx_eq(load64(psd_d), F64_TWO, 0x3EB0C6F7A0B5ED8D),
"portal seed: concentric-sphere depth == 2.0 ± 1e-6 (r_a + r_b)");
assert_eq(mpr_penetration(&_ga_sup_sphere, psd_a1, &_ga_sup_sphere, psd_b2, psd_n, psd_d), 1,
"portal seed: offset spheres report a hit");
assert(f64_approx_eq(load64(psd_d), 0x3FF8000000000000, 0x3EB0C6F7A0B5ED8D),
"portal seed: offset-sphere depth == 1.5 ± 1e-6 (r_a + r_b - |c|)");

# 2.8.3 memory safety — the guards, and the answers they must not change
# ================================================================
#
# Every assertion in this block was written against the UNFIXED source first.
# The ones marked "(SIGSEGV)" killed the process with exit 139 rather than
# printing a FAIL line; the num_halton base-0 case raised SIGFPE and base 1
# never returned; the spatial-hash 1e6 case did not terminate in 120 s.

test_group("2.8.3: tensor_add / tensor_scale / tensor_contract null + shape guards");

# tensor_new and einsum both document a 0 return on failure. Storing through it
# is a null dereference (SIGSEGV).
var ms_sh22 = alloc(16); store64(ms_sh22, 2); store64(ms_sh22 + 8, 2);
var ms_sh21 = alloc(16); store64(ms_sh21, 2); store64(ms_sh21 + 8, 1);
var ms_a = tensor_new(2, ms_sh22);
var ms_b = tensor_new(2, ms_sh21);
tensor_set2(ms_a, 0, 0, F64_ONE); tensor_set2(ms_a, 0, 1, F64_TWO);
tensor_set2(ms_a, 1, 0, f64_from(3)); tensor_set2(ms_a, 1, 1, f64_from(4));
assert_eq(tensor_add(0, ms_a), 0, "tensor_add(0, t) -> 0 (SIGSEGV)");
assert_eq(tensor_add(ms_a, 0), 0, "tensor_add(t, 0) -> 0 (SIGSEGV)");
# 2x2 + 2x1 walked 4 elements of a 2-element buffer and returned adjacent heap.
assert_eq(tensor_add(ms_a, ms_b), 0, "tensor_add: shape mismatch -> 0 (was an over-read)");
assert_eq(tensor_scale(0, F64_TWO), 0, "tensor_scale(0, s) -> 0 (SIGSEGV)");
assert_eq(tensor_contract(0, 0, 1), 0, "tensor_contract(0, ..) -> 0 (SIGSEGV)");
# Same total, different shape: rank alone would let this through.
var ms_sh26 = alloc(16); store64(ms_sh26, 2); store64(ms_sh26 + 8, 6);
var ms_sh34 = alloc(16); store64(ms_sh34, 3); store64(ms_sh34 + 8, 4);
assert_eq(tensor_add(tensor_new(2, ms_sh26), tensor_new(2, ms_sh34)), 0,
"tensor_add: 2x6 + 3x4 (equal totals) -> 0");
# The valid path is untouched: 1+3 = 4 and 2+4 = 6 on identical shapes.
var ms_sum = tensor_add(ms_a, ms_a);
assert_eq(f64_to(tensor_get2(ms_sum, 1, 0)), 6, "tensor_add: identical shapes still add");

test_group("2.8.3: tensor_contract validates idx_i / idx_j against the rank");

# Every one of these was a raw load64/store64 at `shape + idx*8` and
# `full_idx + idx*8` with no bound of any kind.
assert_eq(tensor_contract(ms_a, 0 - 1, 1), 0, "contract: idx_i = -1 -> 0 (read/write before shape)");
assert_eq(tensor_contract(ms_a, 0, 0 - 1), 0, "contract: idx_j = -1 -> 0");
assert_eq(tensor_contract(ms_a, 0, 5), 0, "contract: idx_j >= rank -> 0");
assert_eq(tensor_contract(ms_a, 7, 1), 0, "contract: idx_i >= rank -> 0");
assert_eq(tensor_contract(ms_a, 1, 1), 0, "contract: idx_i == idx_j -> 0 (not a trace)");
var ms_r1 = alloc(8); store64(ms_r1, 3);
assert_eq(tensor_contract(tensor_new(1, ms_r1), 0, 0), 0, "contract: rank 1 -> 0");
# Extents must match or the k loop overruns one of the two axes.
var ms_sh23 = alloc(16); store64(ms_sh23, 2); store64(ms_sh23 + 8, 3);
assert_eq(tensor_contract(tensor_new(2, ms_sh23), 0, 1), 0,
"contract: mismatched extents (2 vs 3) -> 0");

# ...and the arithmetic is unchanged. Rank-4 shape (2,3,2,3), entry = flat+1.
# Reference computed exactly in Python over the integers:
#   contract(0,2) -> 3x3 = [[23,25,27],[35,37,39],[47,49,51]]
#   contract(1,3) -> 2x2 = [[24,33],[78,87]]
var ms_sh4 = alloc(32);
store64(ms_sh4, 2); store64(ms_sh4 + 8, 3); store64(ms_sh4 + 16, 2); store64(ms_sh4 + 24, 3);
var ms_t4 = tensor_new(4, ms_sh4);
var ms_fi = 0;
while (ms_fi < 36) {
    store64(HTensor_data(ms_t4) + ms_fi * 8, f64_from(ms_fi + 1));
    ms_fi = ms_fi + 1;
}
var ms_c02 = tensor_contract(ms_t4, 0, 2);
assert_eq(HTensor_rank(ms_c02), 2, "contract(0,2): rank 4 -> 2");
assert_eq(f64_to(tensor_get2(ms_c02, 0, 0)), 23, "contract(0,2)[0][0] = 23");
assert_eq(f64_to(tensor_get2(ms_c02, 0, 2)), 27, "contract(0,2)[0][2] = 27");
assert_eq(f64_to(tensor_get2(ms_c02, 2, 0)), 47, "contract(0,2)[2][0] = 47");
assert_eq(f64_to(tensor_get2(ms_c02, 2, 2)), 51, "contract(0,2)[2][2] = 51");
var ms_c13 = tensor_contract(ms_t4, 1, 3);
assert_eq(f64_to(tensor_get2(ms_c13, 0, 0)), 24, "contract(1,3)[0][0] = 24");
assert_eq(f64_to(tensor_get2(ms_c13, 0, 1)), 33, "contract(1,3)[0][1] = 33");
assert_eq(f64_to(tensor_get2(ms_c13, 1, 0)), 78, "contract(1,3)[1][0] = 78");
assert_eq(f64_to(tensor_get2(ms_c13, 1, 1)), 87, "contract(1,3)[1][1] = 87");
# Axis order must not matter for a trace.
var ms_c20 = tensor_contract(ms_t4, 2, 0);
assert_eq(f64_to(tensor_get2(ms_c20, 1, 1)), 37, "contract(2,0) == contract(0,2)");

test_group("2.8.3: cmat_* null guards (the four the 2.7.0-B family missed)");

# No cap breach is needed to reach any of these: cmat_mul's own conformability
# guard hands back the 0.
var ms_23 = cmat_new(2, 3);
var ms_22 = cmat_new(2, 2);
assert_eq(cmat_mul(ms_23, ms_22), 0, "cmat_mul(2x3, 2x2) -> 0 (non-conformable)");
assert_eq(cmat_exp(cmat_mul(ms_23, ms_22)), 0, "cmat_exp(that 0) -> 0 (SIGSEGV)");
# Non-square. This one did NOT crash before: the Frobenius loop over-read the
# last element of a 3x2 and the Taylor loop then cascaded to 0 through
# cmat_mul's own guard, so the return value is unchanged and only the over-read
# and the wasted work are gone. Kept as a contract assertion, not a repro.
assert_eq(cmat_exp(cmat_new(3, 2)), 0, "cmat_exp(3x2) -> 0 (non-square)");
assert_eq(cmat_exp(ms_23), 0, "cmat_exp(2x3) -> 0 (non-square)");
assert_eq(cmat_mul_vec(0, alloc(32)), 0, "cmat_mul_vec(0, v) -> 0 (SIGSEGV)");
assert_eq(cmat_mul_vec(ms_22, 0), 0, "cmat_mul_vec(m, 0) -> 0 (SIGSEGV)");
assert_eq(cmat_kronecker(0, ms_22), 0, "cmat_kronecker(0, b) -> 0 (SIGSEGV)");
assert_eq(cmat_kronecker(ms_22, 0), 0, "cmat_kronecker(a, 0) -> 0 (SIGSEGV)");
assert_eq(cmat_inverse(0), 0, "cmat_inverse(0) -> 0 (SIGSEGV)");
# exp(0) = I on a square input is unchanged.
var ms_e = cmat_exp(cmat_new(2, 2));
assert_neq(ms_e, 0, "cmat_exp(2x2 zero) still returns a matrix");
assert_eq(f64_to(HComplex_re(cmat_get(ms_e, 0, 0))), 1, "cmat_exp(0) = I: [0][0] = 1");
assert_eq(f64_to(HComplex_re(cmat_get(ms_e, 0, 1))), 0, "cmat_exp(0) = I: [0][1] = 0");

test_group("2.8.3: calc_partial_derivative bounds BOTH ends of index");

# index = -1 was one out-of-bounds READ of x and two out-of-bounds WRITES, one
# into each of the freshly bumped x_plus / x_minus blocks.
var ms_x = alloc(16);
store64(ms_x, f64_from(3)); store64(ms_x + 8, f64_from(4));
var ms_h = F64_HALF;
assert_eq(calc_partial_derivative(&_c9_f, ms_x, 2, 0 - 1, ms_h), 0, "index = -1 -> 0");
assert_eq(calc_partial_derivative(&_c9_f, ms_x, 2, 0 - 4096, ms_h), 0, "index = -4096 -> 0");
assert_eq(calc_partial_derivative(&_c9_f, ms_x, 2, 2, ms_h), 0, "index == n -> 0 (already held)");
assert_eq(calc_partial_derivative(&_c9_f, ms_x, 0, 0, ms_h), 0, "n = 0 -> 0 (already held)");
assert_eq(calc_partial_derivative(&_c9_f, ms_x, 0 - 3, 0, ms_h), 0, "n = -3 -> 0 (already held)");
# n <= 0 only reached the old `index >= n` guard when index was >= n as well.
# n = -3 with index = -5 slips past it into alloc(-24) plus two wild stores.
assert_eq(calc_partial_derivative(&_c9_f, ms_x, 0 - 3, 0 - 5, ms_h), 0,
"n = -3, index = -5 -> 0 (SIGSEGV)");
# Closed form, exact in binary: for f = x0^2 + x1^2 the central difference is
# ((3+h)^2 - (3-h)^2) / 2h = 12h / 2h = 6 for ANY h, and h = 0.5 keeps every
# intermediate exactly representable.
assert_eq(calc_partial_derivative(&_c9_f, ms_x, 2, 0, ms_h), f64_from(6),
"valid index: d/dx0 = 6 exactly");
assert_eq(calc_partial_derivative(&_c9_f, ms_x, 2, 1, ms_h), f64_from(8),
"valid index: d/dx1 = 8 exactly");

test_group("2.8.3: num_halton rejects bases below 2");

# base 0 divided by zero (SIGFPE, process dead); base 1 made i / base == i, so
# the loop never advanced and the call never returned.
assert_eq(num_halton(7, 0), 0, "base 0 -> 0.0 (was SIGFPE)");
assert_eq(num_halton(7, 1), 0, "base 1 -> 0.0 (was an infinite loop)");
assert_eq(num_halton(7, 0 - 2), 0, "base -2 -> 0.0 (left the documented range)");
# Van der Corput base 2 is exact in binary: 1/2, 1/4, 3/4, 1/8, 5/8, 3/8, 7/8.
assert_eq(num_halton(1, 2), F64_HALF, "halton(1,2) = 0.5");
assert_eq(num_halton(2, 2), f64_div(F64_ONE, f64_from(4)), "halton(2,2) = 0.25");
assert_eq(num_halton(3, 2), f64_div(f64_from(3), f64_from(4)), "halton(3,2) = 0.75");
assert_eq(num_halton(5, 2), f64_div(f64_from(5), f64_from(8)), "halton(5,2) = 0.625");
assert_eq(num_halton(7, 2), f64_div(f64_from(7), f64_from(8)), "halton(7,2) = 0.875");
# Base 3 is not exact in binary, but index 1 is a single term: 1 * (1/3).
assert_eq(num_halton(1, 3), f64_div(F64_ONE, f64_from(3)), "halton(1,3) = 1/3");

test_group("2.8.3: spatial_hash_query_radius is bounded by the grid, not the radius");

# 300 points on a unit grid at (k + 0.5) so the cell index is exact. Every count
# below is an exact integer computed in Python over the cell indices --
# #{p : max(|px-qx|, |py-qy|, |pz-qz|) <= ceil(radius)} -- not read off this
# implementation. r <= 4 takes the per-cell block walk, r >= 5 takes the
# bucket walk, so both branches and the crossover are pinned.
var ms_sh = spatial_hash_new(F64_ONE);
var ms_n = 0;
while (ms_n < 300) {
    var ms_ix = _m3_next();
    var ms_iy = _m3_next();
    var ms_iz = _m3_next();
    spatial_hash_insert(ms_sh, hvec3_new(_m3_cc(ms_ix), _m3_cc(ms_iy), _m3_cc(ms_iz)), ms_n);
    ms_n = ms_n + 1;
}
assert_eq(_m3_shq(ms_sh, 0, 0, 0, 2), 4, "q(0,0,0) r=2 -> 4");
assert_eq(_m3_shq(ms_sh, 0, 0, 0, 4), 18, "q(0,0,0) r=4 -> 18 (per-cell path)");
assert_eq(_m3_shq(ms_sh, 0, 0, 0, 5), 37, "q(0,0,0) r=5 -> 37 (bucket-walk path)");
assert_eq(_m3_shq(ms_sh, 0, 0, 0, 6), 65, "q(0,0,0) r=6 -> 65");
assert_eq(_m3_shq(ms_sh, 0, 0, 0, 8), 155, "q(0,0,0) r=8 -> 155");
assert_eq(_m3_shq(ms_sh, 0, 0, 0, 12), 300, "q(0,0,0) r=12 -> all 300");
assert_eq(_m3_shq(ms_sh, 7, 0 - 7, 3, 3), 8, "q(7,-7,3) r=3 -> 8");
assert_eq(_m3_shq(ms_sh, 7, 0 - 7, 3, 4), 16, "q(7,-7,3) r=4 -> 16 (per-cell path)");
assert_eq(_m3_shq(ms_sh, 7, 0 - 7, 3, 5), 24, "q(7,-7,3) r=5 -> 24 (bucket-walk path)");
assert_eq(_m3_shq(ms_sh, 7, 0 - 7, 3, 8), 70, "q(7,-7,3) r=8 -> 70");
assert_eq(_m3_shq(ms_sh, 7, 0 - 7, 3, 12), 159, "q(7,-7,3) r=12 -> 159");
# 1e6 / 1.0 asked for (2e6+1)^3 = 8e18 cell probes: no answer in 120 s.
assert_eq(_m3_shq(ms_sh, 0, 0, 0, 1000000), 300, "q(0,0,0) r=1e6 -> 300 (was 8e18 probes)");
assert_eq(_m3_shq(ms_sh, 0, 0, 0, 0 - 5), 0, "negative radius -> empty");
# Coincident cluster: 50 in cell (3,3,3), 1 in (9,9,9) at Chebyshev distance 6.
var ms_sh2 = spatial_hash_new(F64_ONE);
var ms_c = 0;
while (ms_c < 50) {
    spatial_hash_insert(ms_sh2, hvec3_new(_m3_cc(3), _m3_cc(3), _m3_cc(3)), ms_c);
    ms_c = ms_c + 1;
}
spatial_hash_insert(ms_sh2, hvec3_new(_m3_cc(9), _m3_cc(9), _m3_cc(9)), 999);
assert_eq(_m3_shq(ms_sh2, 3, 3, 3, 0), 50, "cluster r=0 -> 50");
assert_eq(_m3_shq(ms_sh2, 3, 3, 3, 5), 50, "cluster r=5 -> 50 (bucket walk still filters)");
assert_eq(_m3_shq(ms_sh2, 3, 3, 3, 6), 51, "cluster r=6 -> 51");
assert_eq(_m3_shq(ms_sh2, 3, 3, 3, 1000000), 51, "cluster r=1e6 -> 51");
assert_eq(vec_len(spatial_hash_query_radius(ms_sh2,
hvec3_new(_m3_cc(3), _m3_cc(3), _m3_cc(3)), _SP_F64_POS_INF)), 51,
"+Inf radius -> every entry (range test dropped, not the loop)");
# 2.8.3 -- api-consistency repairs.
# Every assertion below fails against the 2.8.2 source.
# ================================================================

test_group("bvh_query_ray: a t = 0 hit is a hit, not a pruned subtree");

# geo_ray_aabb returns the hit parameter t and uses 0 as its miss sentinel, so
# "miss" and "hit at t = 0" were the same value and the walker's `== 0` prune
# threw away the node AND ITS WHOLE SUBTREE. Two unit boxes sharing the plane
# x = 1; truth for every ray below is computed by hand and cross-checked against
# an exact python3 Fraction slab reference over 1680 queries (42 scenes).
var br_arr = alloc(16);
store64(br_arr, geo_aabb_new(hvec3_new(0, 0, 0), hvec3_new(F64_ONE, F64_ONE, F64_ONE)));
store64(br_arr + 8, geo_aabb_new(hvec3_new(F64_ONE, 0, 0),
hvec3_new(F64_TWO, F64_ONE, F64_ONE)));
var br_tree = bvh_build(br_arr, 2);
var br_dirx = hvec3_new(F64_ONE, 0, 0);

# Origin ON the shared face: enters box 1 at t = 0, grazes box 0's far face at
# t = 0 as well. Both are hits; the old walker reported neither.
var br_face = geo_ray_new(hvec3_new(F64_ONE, F64_HALF, F64_HALF), br_dirx);
assert_eq(vec_len(bvh_query_ray(br_tree, br_face)), 2,
"ray from the shared face reports both boxes (was 0)");

# Origin at the scene's minimum corner: t = 0 at the ROOT, so the old walker
# pruned the entire tree in one test.
var br_min = geo_ray_new(hvec3_new(0, F64_HALF, F64_HALF), br_dirx);
assert_eq(vec_len(bvh_query_ray(br_tree, br_min)), 2,
"ray from the scene minimum corner reports both boxes (was 0)");

# Strictly interior origin: t_min < 0 < t_max, so this ALREADY worked. It is the
# regression guard -- the widened predicate must not have changed it.
var br_in = geo_ray_new(hvec3_new(F64_HALF, F64_HALF, F64_HALF), br_dirx);
assert_eq(vec_len(bvh_query_ray(br_tree, br_in)), 2, "interior origin still reports both");

# Pruning must still prune: a ray behind the scene pointing away hits nothing,
# and a parallel ray outside the slab hits nothing.
var br_away = geo_ray_new(hvec3_new(f64_from(10), F64_HALF, F64_HALF), br_dirx);
assert_eq(vec_len(bvh_query_ray(br_tree, br_away)), 0, "ray past the scene, pointing away -> 0");
var br_miss = geo_ray_new(hvec3_new(0, f64_from(5), F64_HALF), br_dirx);
assert_eq(vec_len(bvh_query_ray(br_tree, br_miss)), 0, "parallel ray outside the y slab -> 0");

# A zero-size AABB sitting exactly on the ray: t_min == t_max == 0 at that leaf.
var br_pt = alloc(8);
var br_p = hvec3_new(F64_TWO, 0, 0);
store64(br_pt, geo_aabb_new(br_p, br_p));
var br_ptree = bvh_build(br_pt, 1);
assert_eq(vec_len(bvh_query_ray(br_ptree, geo_ray_new(hvec3_zero(), br_dirx))), 1,
"degenerate point AABB on the ray is found (was 0)");

test_group("gjk_epa_3d: agrees with gjk_intersect_3d, always writes its out-params");

# Two zero-height boxes overlapping in the z = 0 plane. The Minkowski difference
# contains the origin but has no volume, so EPA has no polytope to expand: the
# old code returned 0 ("not penetrating"), contradicting its own sibling, and
# wrote NEITHER out-param. The right answer is depth exactly 0 with a unit
# normal of the set's affine hull -- here exactly +/-z, a closed form.
var ep_n = alloc(8);
var ep_d = alloc(8);
var ep_fa = _mpr_mkbox(0, 0, 0, F64_ONE, F64_ONE, 0);
var ep_fb = _mpr_mkbox(F64_HALF, F64_HALF, 0, F64_ONE, F64_ONE, 0);
assert_eq(gjk_intersect_3d(&_mpr_sup_box, ep_fa, &_mpr_sup_box, ep_fb), 1,
"coplanar flat boxes: gjk_intersect says overlapping");
assert_eq(gjk_epa_3d(&_mpr_sup_box, ep_fa, &_mpr_sup_box, ep_fb, ep_n, ep_d), 1,
"coplanar flat boxes: gjk_epa agrees (was 0)");
assert_eq(load64(ep_d), 0, "coplanar flat boxes: depth is exactly 0");
assert_neq(load64(ep_n), 0, "coplanar flat boxes: normal is not the NULL HVec3");
assert_eq(_ac_len_sq_e9(ep_n), 1000000000, "coplanar flat boxes: normal is a unit vector");
assert_eq(_ac_comp_e9(ep_n, 0), 0, "coplanar flat boxes: normal has no x component");
assert_eq(_ac_comp_e9(ep_n, 1), 0, "coplanar flat boxes: normal has no y component");

# Two zero-thickness segments crossing at the origin: hull is a planar
# parallelogram, so again +/-z with depth 0.
var ep_sa = _mpr_mkbox(0, 0, 0, F64_ONE, 0, 0);
var ep_sb = _mpr_mkbox(0, 0, 0, 0, F64_ONE, 0);
assert_eq(gjk_intersect_3d(&_mpr_sup_box, ep_sa, &_mpr_sup_box, ep_sb), 1,
"crossing segments: gjk_intersect says overlapping");
assert_eq(gjk_epa_3d(&_mpr_sup_box, ep_sa, &_mpr_sup_box, ep_sb, ep_n, ep_d), 1,
"crossing segments: gjk_epa agrees (was 0)");
assert_eq(load64(ep_d), 0, "crossing segments: depth is exactly 0");
assert_eq(_ac_len_sq_e9(ep_n), 1000000000, "crossing segments: normal is a unit vector");

# EXACT TANGENCY. Unit sphere at the origin, unit-half box centred at x = 2:
# they touch at the single point (1,0,0). Penetration depth is exactly 0 and the
# contact normal is exactly the line of centres.
var ep_sph = hvec4_new(0, 0, 0, F64_ONE);
var ep_box = _mpr_mkbox(F64_TWO, 0, 0, F64_ONE, F64_ONE, F64_ONE);
assert_eq(gjk_epa_3d(&_mpr_sup_sphere, ep_sph, &_mpr_sup_box, ep_box, ep_n, ep_d), 1,
"tangent sphere/box: gjk_epa reports contact (was 0)");
assert_eq(load64(ep_d), 0, "tangent sphere/box: depth is exactly 0");
assert_eq(_ac_comp_e9(ep_n, 0), (0 - 1000000000), "tangent sphere/box: normal is exactly -x");
assert_eq(_ac_comp_e9(ep_n, 1), 0, "tangent sphere/box: normal has no y component");
assert_eq(_ac_comp_e9(ep_n, 2), 0, "tangent sphere/box: normal has no z component");

# Genuinely separated shapes must still report 0 -- and now leave DEFINED
# out-params rather than whatever the caller's slots held.
store64(ep_n, 0);
store64(ep_d, 0);
var ep_far = _mpr_mkbox(f64_from(9), 0, 0, F64_ONE, F64_ONE, F64_ONE);
assert_eq(gjk_epa_3d(&_mpr_sup_box, ep_box, &_mpr_sup_box, ep_far, ep_n, ep_d), 0,
"well-separated boxes: still 0");
assert_neq(load64(ep_n), 0, "0 return still writes a readable normal, not a null");
assert_eq(_ac_len_sq_e9(ep_n), 1000000000, "0 return writes a unit normal");

# A real, full-dimensional overlap is untouched by the degenerate paths: it must
# still report a strictly positive depth. (The VALUE of that depth is the
# subject of a separate open finding and is deliberately not pinned here.)
var ep_ov = _mpr_mkbox(f64_add(F64_ONE, F64_HALF), 0, 0, F64_ONE, F64_ONE, F64_ONE);
assert_eq(gjk_epa_3d(&_mpr_sup_box, ep_box, &_mpr_sup_box, ep_ov, ep_n, ep_d), 1,
"overlapping boxes: still 1");
assert_eq(f64_gt(load64(ep_d), 0), 1, "overlapping boxes: depth is strictly positive");
assert_eq(_ac_len_sq_e9(ep_n), 1000000000, "overlapping boxes: normal is a unit vector");

# A MANUFACTURED PROBE DIRECTION CERTIFIES NOTHING. hvec3_length_sq SQUARES, so
# for two zero-volume shapes separated by less than sqrt(DBL_MIN) ~ 1.5e-154 the
# search direction underflows to exactly 0; the degenerate-direction repair then
# substitutes a cardinal axis, and the support along that axis is exactly 0. That
# is not a supporting plane through the origin, and reading it as one reported 64
# genuinely separated point-vs-point pairs as contacts.
var ep_z0 = _mpr_mkbox(0, 0, 0, 0, 0, 0);
var ep_z1 = _mpr_mkbox(0, 0, 0x1DAD7BECC2F23AC2, 0, 0, 0);   # z = 1e-165
assert_eq(gjk_epa_3d(&_mpr_sup_box, ep_z0, &_mpr_sup_box, ep_z1, ep_n, ep_d), 0,
"zero-volume boxes 1e-165 apart: separated, not a touch");
assert_neq(load64(ep_n), 0, "1e-165 separation still leaves a readable normal");

# The complement: genuinely COINCIDENT zero-volume shapes do touch, at depth 0.
# Guarding the manufactured direction must not cost this.
var ep_z2 = _mpr_mkbox(0, 0, 0, 0, 0, 0);
assert_eq(gjk_epa_3d(&_mpr_sup_box, ep_z0, &_mpr_sup_box, ep_z2, ep_n, ep_d), 1,
"coincident zero-volume boxes: a touch at depth 0");
assert_eq(load64(ep_d), 0, "coincident zero-volume boxes: depth is exactly 0");

# ================================================================
# 2.9.0: the four fixtures the two entry points actually disagreed on.
# ================================================================
# Named individually because they are the reproducers, and an aggregate that
# happens to come out right must not be able to hide any one of them.
assert_eq(gjk_intersect_3d(&_mpr_sup_sphere, ep_sph, &_mpr_sup_box, ep_box), 1,
"tangent sphere/box: gjk_intersect agrees with gjk_epa (was 0)");
assert_eq(gjk_intersect_3d(&_mpr_sup_box, ep_box, &_mpr_sup_sphere, ep_sph), 1,
"tangent box/sphere: same in the reversed operand order (was 0)");
assert_eq(gjk_intersect_3d(&_mpr_sup_box, ep_z0, &_mpr_sup_box, ep_z2), 1,
"coincident zero-size boxes: gjk_intersect agrees with gjk_epa (was 0)");
var ag_p0 = hvec4_new(0, 0, 0, 0);
var ag_p1 = hvec4_new(0, 0, 0, 0);
assert_eq(gjk_epa_3d(&_mpr_sup_sphere, ag_p0, &_mpr_sup_sphere, ag_p1, ep_n, ep_d), 1,
"coincident zero-radius spheres: gjk_epa reports a touch");
assert_eq(gjk_intersect_3d(&_mpr_sup_sphere, ag_p0, &_mpr_sup_sphere, ag_p1), 1,
"coincident zero-radius spheres: gjk_intersect agrees (was 0)");

# The complement, and the one that matters most: the repair must NOT turn the
# 1e-165 separation above -- the case a manufactured probe direction reported as
# 64 false contacts -- into a contact for the cheap test either.
assert_eq(gjk_intersect_3d(&_mpr_sup_box, ep_z0, &_mpr_sup_box, ep_z1), 0,
"zero-volume boxes 1e-165 apart: gjk_intersect says separated, like gjk_epa");

# ================================================================
# 2.9.1: the SIX configurations mpr_intersect actually disagreed on.
# ================================================================
# Found by a 1,149-fixture x 5-scale x 2-order sweep classified exactly in
# rationals; the 50 divergent evaluations in its exact-support half reduce to
# these six. Named individually for the same reason as the block above.
#
# The last two are the ones no previous report had: NOT self-pairs, and one
# operand is a solid unit box. They are also where mpr_intersect was
# ORDER-DEPENDENT -- it answered 0 with the box first and 1 with the point first.
# A point resting on the corner of a box is a real resting-contact pose, not a
# pathology, which is why "keep the strict reading and document it" was rejected.
test_group("mpr_intersect / mpr_penetration: exact tangency, both orders (2.9.1)");

var m91_pt = hvec4_new(0, 0, 0, 0);
var m91_pt2 = hvec4_new(0, 0, 0, 0);
var m91_off = hvec4_new(f64_from(3), f64_neg(f64_from(5)), f64_from(7), 0);
var m91_off2 = hvec4_new(f64_from(3), f64_neg(f64_from(5)), f64_from(7), 0);
var m91_bpt = _mpr_mkbox(0, 0, 0, 0, 0, 0);
var m91_bpt2 = _mpr_mkbox(0, 0, 0, 0, 0, 0);
var m91_unit = _mpr_mkbox(0, 0, 0, F64_ONE, F64_ONE, F64_ONE);
var m91_corner = _mpr_mkbox(F64_ONE, F64_ONE, F64_ONE, 0, 0, 0);
var m91_csph = hvec4_new(F64_ONE, F64_ONE, F64_ONE, 0);
var m91_flat = _mpr_mkbox(0, 0, 0, F64_ONE, F64_ONE, 0);

assert_eq(mpr_intersect(&_mpr_sup_sphere, m91_pt, &_mpr_sup_sphere, m91_pt2), 1,
"coincident zero-radius spheres: mpr_intersect agrees with gjk (was 0)");
assert_eq(mpr_intersect(&_mpr_sup_sphere, m91_off, &_mpr_sup_sphere, m91_off2), 1,
"coincident zero-radius spheres off the origin: mpr_intersect (was 0)");
assert_eq(mpr_intersect(&_mpr_sup_box, m91_bpt, &_mpr_sup_box, m91_bpt2), 1,
"coincident point boxes: mpr_intersect agrees with gjk (was 0)");
assert_eq(mpr_intersect(&_mpr_sup_box, m91_unit, &_mpr_sup_box, m91_corner), 1,
"point box on a unit box CORNER: mpr_intersect (was 0 in THIS order only)");
assert_eq(mpr_intersect(&_mpr_sup_box, m91_corner, &_mpr_sup_box, m91_unit), 1,
"point box on a unit box CORNER: reversed order (was already 1 -- the asymmetry)");
assert_eq(mpr_intersect(&_mpr_sup_sphere, m91_csph, &_mpr_sup_box, m91_unit), 1,
"zero-radius sphere on a unit box CORNER: mpr_intersect");
assert_eq(mpr_intersect(&_mpr_sup_box, m91_unit, &_mpr_sup_sphere, m91_csph), 1,
"zero-radius sphere on a unit box CORNER: reversed order (was 0)");

# mpr_penetration had the same gap plus one case the intersect pair agreed on:
# two coplanar flat plates. A certified touch carries depth exactly 0.
var m91_n = alloc(8);
var m91_d = alloc(8);
store64(m91_d, F64_ONE);
assert_eq(mpr_penetration(&_mpr_sup_box, m91_flat, &_mpr_sup_box, m91_flat, m91_n, m91_d), 1,
"coplanar flat plates: mpr_penetration reports the touch, like gjk_epa_3d (was 0)");
assert_eq(load64(m91_d), 0, "coplanar flat plates: mpr_penetration depth is exactly 0");
store64(m91_d, F64_ONE);
assert_eq(mpr_penetration(&_mpr_sup_box, m91_unit, &_mpr_sup_box, m91_corner, m91_n, m91_d), 1,
"point box on a unit box CORNER: mpr_penetration (was 0)");
assert_eq(load64(m91_d), 0, "point box on a corner: mpr_penetration depth is exactly 0");
assert_eq(_ac_len_sq_e9(m91_n), 1000000000,
"a certified mpr_penetration touch writes a UNIT normal, not the NULL HVec3");

# THE NEGATIVE CONTROLS. The repair must not manufacture a contact: one ulp out
# from the corner tangency is a real separation and must still read as one, and
# the 1e-165 pair above must not become a hit for mpr either.
var m91_out = _mpr_mkbox(0x3FF0000000000001, F64_ONE, F64_ONE, 0, 0, 0);
assert_eq(mpr_intersect(&_mpr_sup_box, m91_unit, &_mpr_sup_box, m91_out), 0,
"corner point +1 ulp: mpr_intersect still says separated");
assert_eq(mpr_intersect(&_mpr_sup_box, m91_out, &_mpr_sup_box, m91_unit), 0,
"corner point +1 ulp: separated in the reversed order too");
store64(m91_n, 0);
store64(m91_d, F64_ONE);
assert_eq(mpr_penetration(&_mpr_sup_box, m91_unit, &_mpr_sup_box, m91_out, m91_n, m91_d), 0,
"corner point +1 ulp: mpr_penetration reports no contact");
# 2.9.1: and a 0 return leaves a READABLE placeholder, not the NULL HVec3
# alloc() hands back. gjk_epa_3d has done this since 2.8.3; this sibling did not,
# and the line below faults on the pre-2.9.1 body rather than merely failing.
assert_neq(load64(m91_n), 0, "mpr_penetration: a 0 return still writes a readable normal");
assert_eq(_ac_len_sq_e9(m91_n), 1000000000,
"mpr_penetration: the 0-return placeholder normal is a unit vector");
assert_eq(load64(m91_d), 0, "mpr_penetration: a 0 return writes depth 0, not the caller's value");
assert_eq(mpr_intersect(&_mpr_sup_box, ep_z0, &_mpr_sup_box, ep_z1), 0,
"zero-volume boxes 1e-165 apart: mpr_intersect says separated, like gjk");
# ... and one ulp IN is a real overlap, so the tangency is pinned from both sides.
var m91_in = _mpr_mkbox(0x3FEFFFFFFFFFFFFF, F64_ONE, F64_ONE, 0, 0, 0);
assert_eq(mpr_intersect(&_mpr_sup_box, m91_unit, &_mpr_sup_box, m91_in), 1,
"corner point -1 ulp: mpr_intersect says overlapping");

# ================================================================
# 2.9.0: THE AGREEMENT SWEEP. Both entry points, both operand orders, over
# separated / tangent / overlapping / degenerate fixtures at three scales.
# ================================================================
# Every cls below is an EXACT classification, not a hisab output:
#   sphere/sphere  |c1-c0|^2 vs (r0+r1)^2         -- integer sixteenths, exact
#   box/box        per-axis |dc| vs h0+h1          -- exact
#   sphere/box     sum of max(0,|dc|-h)^2 vs r^2   -- exact
# and the tangency fixtures are built on Pythagorean triples (3,4,5) so that the
# touching configuration is exactly representable rather than nearly so.

_ag_scale = F64_ONE;

# --- sphere/sphere, walked through tangency at d = 2 = r0 + r1 ---
var ag_s_unit = _ag_sph(0, 0, 0, 16);
_ag_pair(&_mpr_sup_sphere, ag_s_unit, &_mpr_sup_sphere, _ag_sph(24, 0, 0, 16), 2);
_ag_pair(&_mpr_sup_sphere, ag_s_unit, &_mpr_sup_sphere, _ag_sph(31, 0, 0, 16), 2);
_ag_pair(&_mpr_sup_sphere, ag_s_unit, &_mpr_sup_sphere, _ag_sph(32, 0, 0, 16), 1);
_ag_pair(&_mpr_sup_sphere, ag_s_unit, &_mpr_sup_sphere, _ag_sph(33, 0, 0, 16), 0);
_ag_pair(&_mpr_sup_sphere, ag_s_unit, &_mpr_sup_sphere, _ag_sph(64, 0, 0, 16), 0);
# 3-4-5: centres exactly 5 apart, radii 2 + 3 -- off-axis tangency, exact.
var ag_s2 = _ag_sph(0, 0, 0, 32);
_ag_pair(&_mpr_sup_sphere, ag_s2, &_mpr_sup_sphere, _ag_sph(48, 64, 0, 48), 1);
_ag_pair(&_mpr_sup_sphere, ag_s2, &_mpr_sup_sphere, _ag_sph(48, 64, 0, 47), 0);
_ag_pair(&_mpr_sup_sphere, ag_s2, &_mpr_sup_sphere, _ag_sph(48, 64, 0, 49), 2);
# a POINT exactly on the surface, and a sixteenth either side of it
_ag_pair(&_mpr_sup_sphere, ag_s_unit, &_mpr_sup_sphere, _ag_sph(16, 0, 0, 0), 1);
_ag_pair(&_mpr_sup_sphere, ag_s_unit, &_mpr_sup_sphere, _ag_sph(17, 0, 0, 0), 0);
_ag_pair(&_mpr_sup_sphere, ag_s_unit, &_mpr_sup_sphere, _ag_sph(15, 0, 0, 0), 2);
# two points: coincident (a touch) and a sixteenth apart (not)
_ag_pair(&_mpr_sup_sphere, _ag_sph(0, 0, 0, 0), &_mpr_sup_sphere, _ag_sph(0, 0, 0, 0), 1);
_ag_pair(&_mpr_sup_sphere, _ag_sph(0, 0, 0, 0), &_mpr_sup_sphere, _ag_sph(1, 0, 0, 0), 0);
_ag_pair(&_mpr_sup_sphere, _ag_sph(8, 8, 8, 0), &_mpr_sup_sphere, _ag_sph(8, 8, 8, 0), 1);
# fully contained
_ag_pair(&_mpr_sup_sphere, ag_s_unit, &_mpr_sup_sphere, _ag_sph(0, 0, 0, 8), 2);

# --- box/box: face, edge and corner tangency, each with both neighbours ---
var ag_b_unit = _ag_box(0, 0, 0, 16, 16, 16);
_ag_pair(&_mpr_sup_box, ag_b_unit, &_mpr_sup_box, _ag_box(16, 0, 0, 16, 16, 16), 2);
_ag_pair(&_mpr_sup_box, ag_b_unit, &_mpr_sup_box, _ag_box(31, 0, 0, 16, 16, 16), 2);
_ag_pair(&_mpr_sup_box, ag_b_unit, &_mpr_sup_box, _ag_box(32, 0, 0, 16, 16, 16), 1);
_ag_pair(&_mpr_sup_box, ag_b_unit, &_mpr_sup_box, _ag_box(33, 0, 0, 16, 16, 16), 0);
_ag_pair(&_mpr_sup_box, ag_b_unit, &_mpr_sup_box, _ag_box(64, 0, 0, 16, 16, 16), 0);
_ag_pair(&_mpr_sup_box, ag_b_unit, &_mpr_sup_box, _ag_box(32, 32, 0, 16, 16, 16), 1);
_ag_pair(&_mpr_sup_box, ag_b_unit, &_mpr_sup_box, _ag_box(32, 32, 32, 16, 16, 16), 1);
# corner touch pulled apart on ONE axis is separated; pushed together on one
# axis is still a touch, because the other two axes still meet exactly.
_ag_pair(&_mpr_sup_box, ag_b_unit, &_mpr_sup_box, _ag_box(33, 32, 32, 16, 16, 16), 0);
_ag_pair(&_mpr_sup_box, ag_b_unit, &_mpr_sup_box, _ag_box(31, 32, 32, 16, 16, 16), 1);
# zero-volume: coplanar flat boxes, crossing segments, coincident points
_ag_pair(&_mpr_sup_box, _ag_box(0, 0, 0, 16, 16, 0), &_mpr_sup_box,
_ag_box(8, 8, 0, 16, 16, 0), 1);
_ag_pair(&_mpr_sup_box, _ag_box(0, 0, 0, 16, 0, 0), &_mpr_sup_box,
_ag_box(0, 0, 0, 0, 16, 0), 1);
_ag_pair(&_mpr_sup_box, _ag_box(0, 0, 0, 0, 0, 0), &_mpr_sup_box,
_ag_box(0, 0, 0, 0, 0, 0), 1);
_ag_pair(&_mpr_sup_box, _ag_box(0, 0, 0, 0, 0, 0), &_mpr_sup_box,
_ag_box(1, 0, 0, 0, 0, 0), 0);
# a point box exactly on a face, and a sixteenth either side
_ag_pair(&_mpr_sup_box, ag_b_unit, &_mpr_sup_box, _ag_box(16, 0, 0, 0, 0, 0), 1);
_ag_pair(&_mpr_sup_box, ag_b_unit, &_mpr_sup_box, _ag_box(17, 0, 0, 0, 0, 0), 0);
_ag_pair(&_mpr_sup_box, ag_b_unit, &_mpr_sup_box, _ag_box(15, 0, 0, 0, 0, 0), 2);
# anisotropic: the shape that made mpr_intersect report a false positive
_ag_pair(&_mpr_sup_box, _ag_box(0, 0, 0, 16, 160, 160), &_mpr_sup_box,
_ag_box(112, 0, 0, 96, 16, 16), 1);
_ag_pair(&_mpr_sup_box, _ag_box(0, 0, 0, 16, 160, 160), &_mpr_sup_box,
_ag_box(113, 0, 0, 96, 16, 16), 0);

# --- sphere/box ---
_ag_pair(&_mpr_sup_sphere, ag_s_unit, &_mpr_sup_box, _ag_box(31, 0, 0, 16, 16, 16), 2);
_ag_pair(&_mpr_sup_sphere, ag_s_unit, &_mpr_sup_box, _ag_box(32, 0, 0, 16, 16, 16), 1);
_ag_pair(&_mpr_sup_sphere, ag_s_unit, &_mpr_sup_box, _ag_box(33, 0, 0, 16, 16, 16), 0);
_ag_pair(&_mpr_sup_sphere, ag_s_unit, &_mpr_sup_box, _ag_box(0, 32, 0, 16, 16, 16), 1);
_ag_pair(&_mpr_sup_sphere, ag_s_unit, &_mpr_sup_box, _ag_box(0, 0, 32, 16, 16, 16), 1);
# zero-radius sphere exactly on a box CORNER, and a sixteenth either side
_ag_pair(&_mpr_sup_sphere, _ag_sph(16, 16, 16, 0), &_mpr_sup_box, ag_b_unit, 1);
_ag_pair(&_mpr_sup_sphere, _ag_sph(17, 16, 16, 0), &_mpr_sup_box, ag_b_unit, 0);
# A zero-radius sphere strictly INSIDE the box: a single-point intersection, but
# the MTV is the point's 1/16 distance to the nearest face, so it is class 2 and
# gjk_epa_3d is right to report a depth of 0.0625 for it.
_ag_pair(&_mpr_sup_sphere, _ag_sph(15, 15, 15, 0), &_mpr_sup_box, ag_b_unit, 2);
# 3-4-5 again: a point box exactly r away from the sphere centre
_ag_pair(&_mpr_sup_sphere, _ag_sph(0, 0, 0, 80), &_mpr_sup_box,
_ag_box(48, 64, 0, 0, 0, 0), 1);
_ag_pair(&_mpr_sup_sphere, _ag_sph(0, 0, 0, 79), &_mpr_sup_box,
_ag_box(48, 64, 0, 0, 0, 0), 0);
_ag_pair(&_mpr_sup_sphere, _ag_sph(0, 0, 0, 81), &_mpr_sup_box,
_ag_box(48, 64, 0, 0, 0, 0), 2);
# sphere resting exactly on a zero-height box
_ag_pair(&_mpr_sup_sphere, _ag_sph(0, 0, 16, 16), &_mpr_sup_box,
_ag_box(0, 0, 0, 16, 16, 0), 1);
_ag_pair(&_mpr_sup_sphere, _ag_sph(0, 0, 17, 16), &_mpr_sup_box,
_ag_box(0, 0, 0, 16, 16, 0), 0);
_ag_pair(&_mpr_sup_sphere, _ag_sph(0, 0, 15, 16), &_mpr_sup_box,
_ag_box(0, 0, 0, 16, 16, 0), 2);
# point vs point across the two shape kinds
_ag_pair(&_mpr_sup_sphere, _ag_sph(0, 0, 0, 0), &_mpr_sup_box,
_ag_box(0, 0, 0, 0, 0, 0), 1);
_ag_pair(&_mpr_sup_sphere, _ag_sph(0, 0, 0, 0), &_mpr_sup_box,
_ag_box(1, 0, 0, 0, 0, 0), 0);

# --- the same tangency at 2^-20 and 2^20 ---
# A uniform dyadic scaling cannot change any of the three classifications, so
# a fixture that changes answer under it has an ABSOLUTE epsilon somewhere in
# the stack. 2^-20 is where the pre-2.9.0 cheap test reported 66 genuine
# interior overlaps as misses, because the sphere support function's
# hvec3_normalize floor (1e-12) is absolute.
var ag_small = f64_div(F64_ONE, f64_from(1048576));
var ag_big = f64_from(1048576);
_ag_scale = ag_small;
_ag_pair(&_mpr_sup_sphere, hvec4_new(0, 0, 0, _ag_qs(16, ag_small)), &_mpr_sup_box,
_mpr_mkbox(_ag_qs(32, ag_small), 0, 0, _ag_qs(16, ag_small), _ag_qs(16, ag_small),
_ag_qs(16, ag_small)), 1);
_ag_pair(&_mpr_sup_sphere, hvec4_new(0, 0, 0, _ag_qs(16, ag_small)), &_mpr_sup_box,
_mpr_mkbox(_ag_qs(31, ag_small), 0, 0, _ag_qs(16, ag_small), _ag_qs(16, ag_small),
_ag_qs(16, ag_small)), 2);
_ag_pair(&_mpr_sup_sphere, hvec4_new(0, 0, 0, _ag_qs(16, ag_small)), &_mpr_sup_box,
_mpr_mkbox(_ag_qs(33, ag_small), 0, 0, _ag_qs(16, ag_small), _ag_qs(16, ag_small),
_ag_qs(16, ag_small)), 0);
_ag_scale = ag_big;
_ag_pair(&_mpr_sup_sphere, hvec4_new(0, 0, 0, _ag_qs(16, ag_big)), &_mpr_sup_box,
_mpr_mkbox(_ag_qs(32, ag_big), 0, 0, _ag_qs(16, ag_big), _ag_qs(16, ag_big),
_ag_qs(16, ag_big)), 1);
_ag_pair(&_mpr_sup_sphere, hvec4_new(0, 0, 0, _ag_qs(16, ag_big)), &_mpr_sup_box,
_mpr_mkbox(_ag_qs(31, ag_big), 0, 0, _ag_qs(16, ag_big), _ag_qs(16, ag_big),
_ag_qs(16, ag_big)), 2);
_ag_pair(&_mpr_sup_sphere, hvec4_new(0, 0, 0, _ag_qs(16, ag_big)), &_mpr_sup_box,
_mpr_mkbox(_ag_qs(33, ag_big), 0, 0, _ag_qs(16, ag_big), _ag_qs(16, ag_big),
_ag_qs(16, ag_big)), 0);

# --- the aggregate. These are the assertions that police the group's title. ---
assert_eq(_ag_pairs, 110, "agreement sweep: 55 fixtures x 2 operand orders were evaluated");
assert_eq(_ag_mismatch, 0,
"agreement sweep: gjk_intersect_3d == gjk_epa_3d on EVERY swept pair (was 21 of 124)");
assert_eq(_ag_falsepos, 0,
"agreement sweep: no exactly-separated pair is reported as a contact");
assert_eq(_ag_missov, 0,
"agreement sweep: no pair with interior overlap is reported as a miss (was 66 at 2^-20)");
assert_eq(_ag_touch, 46, "agreement sweep: every exact tangency is certified, both orders");
assert_eq(_ag_baddepth, 0, "agreement sweep: a certified touch always carries depth exactly 0");
assert_eq(_ag_mprmis, 0,
"agreement sweep: mpr_intersect == gjk_intersect_3d on EVERY swept pair (was 9 of 110)");
assert_eq(_ag_mprasym, 0,
"agreement sweep: mpr_intersect is operand-order symmetric on every pair (was 2)");
assert_eq(_ag_mprpen, 0,
"agreement sweep: mpr_penetration == gjk_epa_3d on EVERY swept pair (was 13 of 110)");

test_group("time_of_impact: a reported collision carries a readable normal");

# alloc() hands back zeroed pages, so when gjk_epa_3d returned without writing,
# time_of_impact copied 0 into out_normal and returned 1 -- "collision found,
# here is the normal", where the normal is a null pointer that faults on the
# first accessor. Two coplanar flat boxes overlapping at t = 0 reproduced it.
var toi_n2 = alloc(8);
var toi_t2 = alloc(8);
store64(toi_n2, 0);
var toi_zero = hvec3_zero();
assert_eq(time_of_impact(&_mpr_sup_box, ep_fa, toi_zero, &_mpr_sup_box, ep_fb, toi_zero,
f64_from(10), toi_t2, toi_n2), 1, "coplanar flat boxes overlap at t = 0 -> hit");
assert_neq(load64(toi_n2), 0, "t = 0 hit stores a real normal, not a NULL HVec3");
assert_eq(_ac_len_sq_e9(toi_n2), 1000000000, "t = 0 hit stores a unit normal");

# 2.9.0: time_of_impact's t = 0 overlap test IS gjk_intersect_3d, so the
# tangency repair reaches it. Two shapes exactly touching at t = 0 are in
# contact at t = 0, and now report so even with no relative motion at all --
# before, the cheap test said "apart" and the zero-speed early out returned 0.
store64(toi_n2, 0);
store64(toi_t2, F64_ONE);
assert_eq(time_of_impact(&_mpr_sup_sphere, ep_sph, toi_zero, &_mpr_sup_box, ep_box, toi_zero,
f64_from(10), toi_t2, toi_n2), 1, "tangent pair at rest: contact at t = 0 (was 0)");
assert_eq(load64(toi_t2), 0, "tangent pair at rest: t is exactly 0");
assert_eq(_ac_len_sq_e9(toi_n2), 1000000000, "tangent pair at rest: normal is a unit vector");

# The swept branch stores its normal through the same guard.
store64(toi_n2, 0);
var toi_left2 = hvec3_new(f64_neg(F64_ONE), 0, 0);
var toi_fc = _mpr_mkbox(f64_from(5), 0, 0, F64_ONE, F64_ONE, 0);
assert_eq(time_of_impact(&_mpr_sup_box, ep_fa, toi_zero, &_mpr_sup_box, toi_fc, toi_left2,
f64_from(10), toi_t2, toi_n2), 1, "swept coplanar flat boxes collide within max_t");
assert_neq(load64(toi_n2), 0, "swept hit stores a real normal, not a NULL HVec3");
assert_eq(_ac_len_sq_e9(toi_n2), 1000000000, "swept hit stores a unit normal");

test_group("halfedge_from_triangles: malformed input returns 0, it does not abort");

# Every one of these went straight into vec_get, whose bounds check calls
# _vec_die() -- so the documented "0 on error" was unreachable and the PROCESS
# exited 1 instead. Against the 2.8.2 source this suite dies here.
var hb_short = vec_new();
vec_push(hb_short, 0); vec_push(hb_short, 1); vec_push(hb_short, 2);
assert_eq(halfedge_from_triangles(hb_short, 2, 3), 0,
"n_tris larger than the supplied triples -> 0 (was: abort)");

var hb_oob = vec_new();
vec_push(hb_oob, 0); vec_push(hb_oob, 1); vec_push(hb_oob, 7);
assert_eq(halfedge_from_triangles(hb_oob, 1, 3), 0,
"vertex index >= n_verts -> 0 (was: abort)");

var hb_neg = vec_new();
vec_push(hb_neg, 0); vec_push(hb_neg, 0 - 1); vec_push(hb_neg, 2);
assert_eq(halfedge_from_triangles(hb_neg, 1, 3), 0,
"negative vertex index -> 0 (was: abort)");

var hb_ok = vec_new();
vec_push(hb_ok, 0); vec_push(hb_ok, 1); vec_push(hb_ok, 2);
assert_eq(halfedge_from_triangles(hb_ok, 1, 0), 0,
"n_verts = 0 with a triangle -> 0 (was: abort)");
assert_eq(halfedge_from_triangles(0, 1, 3), 0, "null triangle vec -> 0");
# And the valid mesh still builds -- the guard must not reject good input.
assert_neq(halfedge_from_triangles(hb_ok, 1, 3), 0, "a well-formed triangle still builds");

test_group("einsum: a repeated OUTPUT label is an error, not a wrong tensor");

# _einsum_compute_element assigns each output axis into label_vals[label], so two
# axes sharing a label overwrite each other and the leading axis wins. "ij->ii"
# on [[1,2],[3,4]] returned [[3,3],[7,7]] -- right shape, wrong tensor, no error.
assert_eq(einsum(str_from("ij->ii"), es_one, 1), 0, "einsum: repeated output label -> 0");
assert_eq(einsum(str_from("ij,jk->ii"), es_two, 2), 0,
"einsum: repeated output label with two operands -> 0");
assert_eq(einsum(str_from("ij->jj"), es_one, 1), 0, "einsum: repeated output label (jj) -> 0");
# The legal notations are untouched.
assert_neq(einsum(str_from("ij->ji"), es_one, 1), 0, "einsum: transpose still works");
assert_neq(einsum(str_from("ii->"), es_one, 1), 0, "einsum: trace still works");
assert_neq(einsum(str_from("ij,jk->ik"), es_two, 2), 0, "einsum: matmul still works");
# 2.8.3 -- the performance tier of the 2026-08-04 audit
# ================================================================
# Three findings, three different ways of pinning a performance repair
# WITHOUT a timing assertion (timings live in bench-history.csv):
#   spatial_hash  -- the table must size itself to the data, and no chain may
#                    be long; both are structural facts a never-growing 1024
#                    bucket table cannot satisfy.
#   bvh_build     -- arena bytes per primitive must be O(1); the pre-2.8.3
#                    5-blocks-per-merge fold made it O(log n).
#   num_dct/dst   -- the FFT reductions must agree with closed forms at sizes
#                    on BOTH sides of the direct/FFT crossover.

test_group("2.8.3 spatial_hash: the table grows with the data");

# 30,000 points, one per cell, on a STRIDE-4 grid. The stride matters: the
# pre-2.8.3 hash (prime-multiply + XOR, no avalanche) is masked by its LOW
# bits, and ix = 4g forces the bottom two of those to zero, so these 30,000
# cells collapse into 256 buckets of 1024 -- 117-deep chains, and an occupied
# count that can never reach the growth threshold.
var shg = spatial_hash_new(F64_ONE);
for (var shi = 0; shi < 30000; shi = shi + 1) {
    spatial_hash_insert(shg, hvec3_new(f64_from(shi * 4), 0, 0), shi);
}
assert_gte(_sh_bucket_count(shg), 16384, "bucket count grew past its initial 1024");
assert_gt(_sh_occupied(shg), 15000, "stride-4 cells spread over the table, not into 256");
assert_gte(_sh_bucket_count(shg) * 3, _sh_occupied(shg) * 4, "load factor stays under 3/4");

# The actual per-query work bound: the longest chain in the table.
fn _sh_longest_chain(sh) {
    var bk = _sh_buckets(sh);
    var bc = _sh_bucket_count(sh);
    var en = _sh_entries(sh);
    var worst = 0;
    for (var b = 0; b < bc; b = b + 1) {
        var e = load64(bk + b * 8);
        var len = 0;
        while (e >= 0) {
            len = len + 1;
            e = vec_get(en, e * _SH_ENTRY_SIZE + 4);
        }
        if (len > worst) { worst = len; }
    }
    return worst;
}
assert_lte(_sh_longest_chain(shg), 12, "no chain exceeds 12 entries out of 30,000");
assert_eq(vec_len(spatial_hash_query_cell(shg, hvec3_new(f64_from(4 * 777), 0, 0))), 1,
"every one of the 30,000 cells still answers exactly its own point");

test_group("2.8.3 spatial_hash: brute-force equality, insertion order, clear");

# Ground truth is the DEFINITION of the grid (cell = floor(coord / size)),
# not the previous implementation.
fn _sh_ref_cell(v, inv) { return f64_to(f64_floor(f64_mul(v, inv))); }

fn _sh_ref_query(pts, npts, inv, px, py, pz) {
    var want = vec_new();
    var cx = _sh_ref_cell(px, inv);
    var cy = _sh_ref_cell(py, inv);
    var cz = _sh_ref_cell(pz, inv);
    for (var i = 0; i < npts; i = i + 1) {
        var p = vec_get(pts, i);
        if (_sh_ref_cell(HVec3_x(p), inv) == cx) {
            if (_sh_ref_cell(HVec3_y(p), inv) == cy) {
                if (_sh_ref_cell(HVec3_z(p), inv) == cz) { vec_push(want, i); }
            }
        }
    }
    return want;
}

fn _sh_seq_eq(got, want) {
    if (vec_len(got) != vec_len(want)) { return 0; }
    for (var i = 0; i < vec_len(got); i = i + 1) {
        if (vec_get(got, i) != vec_get(want, i)) { return 0; }
    }
    return 1;
}

# 900 points: a third uniform, a third all coincident, a third on a plane --
# so one table holds a sparse region, a single 300-deep cell and a flat slab.
var shp = vec_new();
_DLR_STATE = 90210;
for (var spi = 0; spi < 300; spi = spi + 1) {
    vec_push(shp, hvec3_new(f64_mul(f64_from(30), _dlr_unit()),
    f64_mul(f64_from(30), _dlr_unit()), f64_mul(f64_from(30), _dlr_unit())));
}
for (var spj = 0; spj < 300; spj = spj + 1) {
    vec_push(shp, hvec3_new(F64_HALF, F64_HALF, F64_HALF));
}
for (var spk = 0; spk < 300; spk = spk + 1) {
    vec_push(shp, hvec3_new(f64_sub(f64_mul(f64_from(20), _dlr_unit()), f64_from(10)),
    f64_mul(f64_from(20), _dlr_unit()), 0));
}
var shb = spatial_hash_new(F64_ONE);
for (var spl = 0; spl < 900; spl = spl + 1) {
    spatial_hash_insert(shb, vec_get(shp, spl), spl);
}
var sh_mismatch = 0;
for (var spm = 0; spm < 900; spm = spm + 1) {
    var sq = vec_get(shp, spm);
    if (_sh_seq_eq(spatial_hash_query_cell(shb, sq),
    _sh_ref_query(shp, 900, F64_ONE, HVec3_x(sq), HVec3_y(sq), HVec3_z(sq))) == 0) {
        sh_mismatch = sh_mismatch + 1;
    }
}
assert_eq(sh_mismatch, 0, "query_cell matches brute force, in insertion order, 900/900");
assert_eq(vec_len(spatial_hash_query_cell(shb, hvec3_new(F64_HALF, F64_HALF, F64_HALF))), 300,
"the 300 coincident points all come back from one cell");

# clear() then reuse. This is what caught a 16-vs-8 byte bucket stride during
# the repair: the over-wide reset ran off the end of the bucket array and
# corrupted the entry vec's header, so the NEXT insert died in vec_push.
spatial_hash_clear(shb);
assert_eq(vec_len(spatial_hash_query_cell(shb, vec_get(shp, 0))), 0, "clear empties the table");
for (var spn = 0; spn < 900; spn = spn + 1) {
    spatial_hash_insert(shb, vec_get(shp, spn), spn);
}
var sq0 = vec_get(shp, 0);
assert_eq(_sh_seq_eq(spatial_hash_query_cell(shb, sq0),
_sh_ref_query(shp, 900, F64_ONE, HVec3_x(sq0), HVec3_y(sq0), HVec3_z(sq0))), 1,
"the table is fully usable after clear()");

# The broadphase contract: query_radius may over-return, never under-return.
var shr = spatial_hash_query_radius(shb, sq0, f64_from(3));
var sh_missing = 0;
var sh_r2 = f64_from(9);
for (var spq = 0; spq < 900; spq = spq + 1) {
    var pq = vec_get(shp, spq);
    var ddx = f64_sub(HVec3_x(pq), HVec3_x(sq0));
    var ddy = f64_sub(HVec3_y(pq), HVec3_y(sq0));
    var ddz = f64_sub(HVec3_z(pq), HVec3_z(sq0));
    var dd = f64_add(f64_add(f64_mul(ddx, ddx), f64_mul(ddy, ddy)), f64_mul(ddz, ddz));
    if (f64_lt(dd, sh_r2) == 1) {
        var seen = 0;
        for (var spr = 0; spr < vec_len(shr); spr = spr + 1) {
            if (vec_get(shr, spr) == spq) { seen = 1; }
        }
        if (seen == 0) { sh_missing = sh_missing + 1; }
    }
}
assert_eq(sh_missing, 0, "query_radius returns every point inside the radius");

test_group("2.8.3 bvh_build: subtree bounds are exact and the arena is O(n)");

# Every internal node's AABB must be the exact componentwise min/max of the
# AABBs of the leaves beneath it, every leaf index must appear exactly once,
# and every leaf must alias its input box. Recomputed from the leaves, so it
# does not trust the fold that built the node.
var _BV_SEEN = 0;
var _BV_BAD = 0;

fn _bv_check(node, aabbs, out) {
    var leaf = _bvh_node_leaf_idx(node);
    var box = _bvh_node_aabb(node);
    if (leaf != 0 - 1) {
        if (box != load64(aabbs + leaf * 8)) { _BV_BAD = _BV_BAD + 1; }
        vec_set(_BV_SEEN, leaf, vec_get(_BV_SEEN, leaf) + 1);
        var mn = GeoAabb_min(box);
        var mx = GeoAabb_max(box);
        store64(out, HVec3_x(mn));
        store64(out + 8, HVec3_y(mn));
        store64(out + 16, HVec3_z(mn));
        store64(out + 24, HVec3_x(mx));
        store64(out + 32, HVec3_y(mx));
        store64(out + 40, HVec3_z(mx));
        return 0;
    }
    var lb = alloc(48);
    var rb = alloc(48);
    _bv_check(_bvh_node_left(node), aabbs, lb);
    _bv_check(_bvh_node_right(node), aabbs, rb);
    for (var k = 0; k < 3; k = k + 1) {
        store64(out + k * 8, f64_min(load64(lb + k * 8), load64(rb + k * 8)));
    }
    for (var k2 = 3; k2 < 6; k2 = k2 + 1) {
        store64(out + k2 * 8, f64_max(load64(lb + k2 * 8), load64(rb + k2 * 8)));
    }
    var nmn = GeoAabb_min(box);
    var nmx = GeoAabb_max(box);
    if (HVec3_x(nmn) != load64(out)) { _BV_BAD = _BV_BAD + 1; }
    if (HVec3_y(nmn) != load64(out + 8)) { _BV_BAD = _BV_BAD + 1; }
    if (HVec3_z(nmn) != load64(out + 16)) { _BV_BAD = _BV_BAD + 1; }
    if (HVec3_x(nmx) != load64(out + 24)) { _BV_BAD = _BV_BAD + 1; }
    if (HVec3_y(nmx) != load64(out + 32)) { _BV_BAD = _BV_BAD + 1; }
    if (HVec3_z(nmx) != load64(out + 40)) { _BV_BAD = _BV_BAD + 1; }
    return 0;
}

# kind 0 uniform, 1 coincident, 2 a 1e-8 cluster, 3 a 1e6:1 strip
fn _bv_boxes(n, kind, seed) {
    _DLR_STATE = seed;
    var arr = alloc(n * 8);
    for (var i = 0; i < n; i = i + 1) {
        var sx = f64_from(1000);
        var sy = sx;
        var sz = sx;
        if (kind == 1) { sx = 0; sy = 0; sz = 0; }
        if (kind == 2) { sx = 0x3E45798EE2308C3A; sy = sx; sz = sx; }
        if (kind == 3) { sx = f64_from(1000000); sy = F64_ONE; sz = F64_ONE; }
        var bx = f64_mul(sx, _dlr_unit());
        var by = f64_mul(sy, _dlr_unit());
        var bz = f64_mul(sz, _dlr_unit());
        store64(arr + i * 8, geo_aabb_new(hvec3_new(bx, by, bz),
        hvec3_new(f64_add(bx, F64_ONE), f64_add(by, F64_ONE), f64_add(bz, F64_ONE))));
    }
    return arr;
}

var bv_total_bad = 0;
for (var bvk = 0; bvk < 4; bvk = bvk + 1) {
    for (var bvs = 0; bvs < 4; bvs = bvs + 1) {
        var bvn = 1;
        if (bvs == 1) { bvn = 2; }
        if (bvs == 2) { bvn = 37; }
        if (bvs == 3) { bvn = 400; }
        var bva = _bv_boxes(bvn, bvk, 700 + bvk * 13 + bvs);
        var bvt = bvh_build(bva, bvn);
        _BV_SEEN = vec_new();
        for (var bvi = 0; bvi < bvn; bvi = bvi + 1) { vec_push(_BV_SEEN, 0); }
        _BV_BAD = 0;
        _bv_check(bvt, bva, alloc(48));
        for (var bvj = 0; bvj < bvn; bvj = bvj + 1) {
            if (vec_get(_BV_SEEN, bvj) != 1) { _BV_BAD = _BV_BAD + 1; }
        }
        bv_total_bad = bv_total_bad + _BV_BAD;
    }
}
assert_eq(bv_total_bad, 0,
"16 BVHs over 4 input classes x n=1,2,37,400: every node bound exact, every leaf used once");

# ARENA BOUND. Pre-2.8.3 the range-bounds fold allocated FIVE heap blocks per
# merge step and the partition allocated two per item per level, so bytes per
# primitive grew with log n: 1,650 B/prim at n=1000 and 2,288 B/prim at
# n=16000. The rewritten fold is three blocks per internal node, flat at
# 259 B/prim. 700 is loose enough to absorb allocator alignment and tight
# enough that the old fold (1,970 B/prim at n=4000) cannot pass.
var bva4 = _bv_boxes(4000, 0, 31337);
var bv_used0 = alloc_used();
var bvt4 = bvh_build(bva4, 4000);
var bv_bytes = alloc_used() - bv_used0;
assert_neq(bvt4, 0, "bvh_build(4000) returns a tree");
assert_lt(bv_bytes, 700 * 4000, "bvh_build allocates under 700 B per primitive");

test_group("2.9.1 EPA certification rate — the observable six repairs were invisible at");

# WHY THIS EXISTS. The 2.9.0 mutation sweep reverted six separate EPA repairs and
# every one produced BIT-IDENTICAL output, so none could be asserted on. The cause
# is architectural, not accidental: when EPA cannot prove `lo > 0 && strict` it
# leaves `certified` clear and hands the direction to `_epa_polish`, which does not
# depend on the polytope being correct and recovers the same answer. Asserting on
# depth or normal therefore cannot separate "EPA got it right" from "EPA got it
# wrong and the fallback covered" — the fallback is doing its job either way.
#
# The observable is WHICH PATH RAN. These fixtures are ones EPA certifies today, so
# the handoff count is the thing a broken repair moves. It is a RATE assertion, not
# an exact count: the point is to catch a repair that stops EPA certifying, not to
# freeze the current number.
var epc_n = alloc(8);
var epc_d = alloc(8);
var epc_base = _GA_EPA_POLISH_COUNT;
var epc_calls = 0;
var epc_i = 0;
while (epc_i < 12) {
    var epc_off = f64_add(F64_HALF, f64_mul(f64_from(epc_i), 0x3FB999999999999A));
    gjk_epa_3d(&_mpr_sup_box, _mpr_mkbox(0, 0, 0, F64_ONE, F64_ONE, F64_ONE),
    &_mpr_sup_box, _mpr_mkbox(epc_off, F64_HALF, F64_HALF, F64_ONE, F64_ONE, F64_ONE),
    epc_n, epc_d);
    epc_calls = epc_calls + 1;
    epc_i = epc_i + 1;
}
# MEASURED. All 12 of these fall back to _epa_polish through `gjk_epa_3d`.
# [measured: this assertion]
#
# ⚠ 2.9.3 CORRECTION TO WHAT THIS USED TO CONCLUDE. The 2.9.1 text here read the
# [measured: this assertion, and the mpr_penetration one below]
# 12/12 as proof that "EPA's certified exit is never taken", that `_epa_polish`
# is therefore the primary path, and that this explains why six EPA repairs were
# unmutatable. **That inference does not survive measuring the OTHER entry
# point.** `mpr_penetration` computes the same quantity through the same
# `_epa_refine` and takes the CERTIFIED exit on 12 of these same 12 boxes --
# 0 handoffs -- as the assertion below now pins.
#
# So the certified path is not dead code. The real defect is a CERTIFICATION
# ASYMMETRY between two public entry points, and its cause is the SEED, not the
# certificate: `_epa_seed_portal` tries a strictness upgrade (swap v0 for the
# support point opposite the far face, keep it only if the result strictly
# encloses the origin, geo_advanced.cyr:757-766) and `_epa_seed_gjk` does not,
# so the portal path arrives certifiable and the GJK path arrives one rounding
# step short.
#
# BOTH candidate repairs were implemented in 2.9.3, measured, and REJECTED:
#   - drop `strict` from the certificate (what the filing proposes): boxes go
#     12 -> 0 fallbacks, but FOUR exact-tangency pairs then report a nonzero
#     depth for a touch whose true depth is 0 -- `_ag_baddepth` goes 0 -> 4. So
#     `lo > 0` alone is NOT the property the certificate needs, and the seed test
#     was load-bearing after all.
#   - give `_epa_seed_gjk` the portal's strictness upgrade: every assertion in
#     this suite passes and boxes go 12 -> 6, but it costs one extra Minkowski
#     support evaluation per seed and measures **+19.4% on gjk_epa_sphere_box**
#     (150.4 us vs 125.6 us, three runs each, non-overlapping) -- for a change
#     that alters no returned answer, since the polish already recovers it.
# [measured: docs/development/issues/2026-08-06-epa-certificate-tests-the-seed-not-the-polytope.md]
#
# The count therefore stays at 12, and this assertion still pins it.
assert_eq(_GA_EPA_POLISH_COUNT - epc_base, epc_calls,
"gjk_epa_3d certifies NONE of 12 box overlaps -- every call falls back to the polish");
assert_eq(epc_calls, 12, "the box sweep actually ran 12 calls");

# The half the 2.9.1 measurement never took, and the reason its conclusion did
# not hold. Same 12 boxes, same refinement, the OTHER public entry point.
# [measured: this assertion]
var epc_mp = _GA_EPA_POLISH_COUNT;
var epc_mi = 0;
while (epc_mi < 12) {
    var epc_moff = f64_add(F64_HALF, f64_mul(f64_from(epc_mi), 0x3FB999999999999A));
    mpr_penetration(&_mpr_sup_box, _mpr_mkbox(0, 0, 0, F64_ONE, F64_ONE, F64_ONE),
    &_mpr_sup_box, _mpr_mkbox(epc_moff, F64_HALF, F64_HALF, F64_ONE, F64_ONE, F64_ONE),
    epc_n, epc_d);
    epc_mi = epc_mi + 1;
}
assert_eq(_GA_EPA_POLISH_COUNT - epc_mp, 0,
"mpr_penetration certifies ALL 12 -- its portal seed is strict by construction");

var epc_b2 = _GA_EPA_POLISH_COUNT;
var epc_j = 0;
while (epc_j < 12) {
    var epc_r = f64_add(F64_ONE, f64_mul(f64_from(epc_j), 0x3FB999999999999A));
    gjk_epa_3d(&_mpr_sup_sphere, hvec4_new(0, 0, 0, f64_from(2)),
    &_mpr_sup_sphere, hvec4_new(epc_r, 0, 0, f64_from(2)), epc_n, epc_d);
    epc_j = epc_j + 1;
}
assert_eq(_GA_EPA_POLISH_COUNT - epc_b2, 12,
"EPA certifies NONE of 12 sphere overlaps either -- not a box-only artefact");

# The counter must be able to STAY PUT, or the two assertions above would pass
# on a counter that simply increments unconditionally. A separated pair returns
# before _epa_refine and must not touch it.
var epc_b3 = _GA_EPA_POLISH_COUNT;
gjk_epa_3d(&_mpr_sup_sphere, hvec4_new(0, 0, 0, F64_ONE),
&_mpr_sup_sphere, hvec4_new(f64_from(9), 0, 0, F64_ONE), epc_n, epc_d);
assert_eq(_GA_EPA_POLISH_COUNT - epc_b3, 0,
"a separated pair never reaches the polish -- the counter is not unconditional");

test_group("2.9.1 _col_dl_ic_g1: the on-line tie-break is betweenness, not the M^1 form");

# The reproducer from the exact-rational sweep. p is the MIDPOINT of ab, so it is
# strictly between a and b and the truth is 1. The pre-2.9.1 M^1 expression
# factored as |b|^2*(u x a) - |a|^2*(u x b), which vanishes identically when the
# edge is parallel to u_k -- here u_0 = (1,2) and b - a = (-2,-4) = -2*u_0 -- so
# it returned 0. Measured: 228 wrong of 463,086 CCW-presented triples, REACHABLE
# input. The replacement is dot(a - p, b - p) < 0, which needs no ghost direction.
#
# 2.9.3 re-based this fixture. It used to hold only a and b, so points[0] WAS a.
# That was harmless while g1 ignored points[0], but g1 now falls back to the
# apex for the winding when the edge is parallel to u_k -- which is exactly this
# configuration -- and an apex sitting on a vertex of its own edge makes all
# three points collinear for every M. The exact oracle returns NO ANSWER there
# (the circumcircle does not exist), so the old fixture was asserting a value on
# an ill-posed input and only passed because the old code could not see it.
# points[0] is now a real apex off line(a, b), which is what delaunay_2d always
# supplies. The expected value is unchanged and does not depend on which side
# the apex is on: p is the midpoint of segment ab, so it is strictly inside ANY
# circle through a and b, and the branch that decides it is betweenness, which
# takes no winding at all. Verified in exact rationals over four apexes
# (26, 8, -4, 28 for (b - a) x (A - a)): truth = 1 in all four.
var g1_pts = vec_new();
vec_push(g1_pts, hvec2_new(f64_from(5), F64_ONE));                   # apex A = (5, 1)
vec_push(g1_pts, hvec2_new(f64_neg(F64_TWO), 0));                    # a = (-2, 0)
vec_push(g1_pts, hvec2_new(f64_neg(f64_from(4)), f64_neg(f64_from(4))));  # b = (-4,-4)
assert_eq(_col_dl_ic_g1(g1_pts, 1, 2, 0, f64_neg(f64_from(3)), f64_neg(F64_TWO)), 1,
"g1: p is the midpoint of an edge parallel to u_0 -> inside (was 0)");
# And the doubly-degenerate case the old fixture accidentally encoded: apex ON
# line(a, b) as well as the edge parallel to u_0, so there is no circle at all.
# 0 is a convention, but it must be a STABLE one -- both orderings agree.
var g1_deg = vec_new();
vec_push(g1_deg, hvec2_new(f64_neg(F64_TWO), 0));                    # apex == a
vec_push(g1_deg, hvec2_new(f64_neg(F64_TWO), 0));                    # a = (-2, 0)
vec_push(g1_deg, hvec2_new(f64_neg(f64_from(4)), f64_neg(f64_from(4))));  # b = (-4,-4)
assert_eq(_col_dl_ic_g1(g1_deg, 1, 2, 0, f64_neg(f64_from(3)), f64_neg(F64_TWO)),
_col_dl_ic_g1(g1_deg, 2, 1, 0, f64_neg(f64_from(3)), f64_neg(F64_TWO)),
"g1: with no circumcircle at all, both orderings still agree");

# The two cases the old form also could not separate: lambda*(lambda-1) > 0 holds
# for lambda > 1 as well as lambda < 0, so "beyond b on the same ray" scored the
# same as "between". Betweenness separates them.
assert_eq(_col_dl_ic_g1(g1_pts, 1, 2, 0, f64_neg(F64_ONE), F64_TWO), 0,
"g1: p on the line but OUTSIDE the segment -> not inside");
assert_eq(_col_dl_ic_g1(g1_pts, 1, 2, 0, f64_neg(f64_from(6)), f64_neg(f64_from(8))), 0,
"g1: p beyond b on the same ray -> not inside");

# p coinciding with an endpoint is a duplicate point, not an interior hit.
assert_eq(_col_dl_ic_g1(g1_pts, 1, 2, 0, f64_neg(F64_TWO), 0), 0,
"g1: p == a is a duplicate, not inside");
assert_eq(_col_dl_ic_g1(g1_pts, 1, 2, 0, f64_neg(f64_from(4)), f64_neg(f64_from(4))), 0,
"g1: p == b is a duplicate, not inside");

# The fix must not depend on which ghost direction is passed -- betweenness is a
# property of the three points alone. All three ghosts must agree.
assert_eq(_col_dl_ic_g1(g1_pts, 1, 2, 1, f64_neg(f64_from(3)), f64_neg(F64_TWO)), 1,
"g1: same answer under ghost 1 (the answer cannot depend on u_k)");
assert_eq(_col_dl_ic_g1(g1_pts, 1, 2, 2, f64_neg(f64_from(3)), f64_neg(F64_TWO)), 1,
"g1: same answer under ghost 2");

test_group("2.9.1 _col_dl_ic_g3: the all-ghost answer is the constant 1, both windings");

# The predicate takes NO ARGUMENTS because the answer does not depend on any of
# them. Asserting the bare call pins that directly: a reader who sees a geometric
# predicate that ignores its inputs would otherwise suspect a stub.
assert_eq(_col_dl_ic_g3(), 1, "g3: the all-ghost in-circle answer is the constant 1");

# Both windings, through the public entry point. The CYCLIC half is all any
# delaunay_2d fixture can reach -- every triangle is stored CCW and the entry
# point's three rotations are even -- so through 2.9.1 it was the only half ever
# run, and it was also the only half the shipped `orient(u) > 0` body got right.
# The ANTI-CYCLIC half is the other half of the input space and the one that was
# wrong for EVERY point in the plane.
test_group("2.9.3 delaunay_2d on WIDE INTRA-SET DYNAMIC RANGE (exact winding)");

# 2026-08-04-incircle-precision.md was recommended for closure in 2.9.1 on the
# ground that "nothing can hand it that input". That was wrong, and the reason it
# looked right is instructive: the 0-of-1,528,820 sweep behind it enumerated
# [measured: CHANGELOG.md 2.9.1 section]
# quadruples of four fixtures that ALL draw from a single origin-anchored box
# (`_dlr_points`, :126), so the family had no intra-set spread ratio and
# structurally could not reach this failure.
#
# Absolute magnitude is not the problem -- translating a whole set out to 1e9 is
# fine, Sterbenz differencing handles it. RATIO WITHIN ONE SET is. One vertex at
# ~6e5 with five points inside ~5e-17 of the origin makes the winding term's two
# subtractions round to the same double, so two distinct points become one.
#
# THE ORACLE HERE IS DELIBERATELY NOT `_dl_violations` (:225): that helper calls
# `_col_in_circumcircle` to decide whether a circumcircle is empty, i.e. it uses
# the code under test as its own oracle and is blind to a sign flip by
# construction -- which is half of why this survived three releases. `_dl_used`
# and `_dl_max_edge_share` are purely STRUCTURAL and evaluate no predicate.
# Coordinates are literal bit patterns so the fixture is reproducible
# bit-for-bit rather than regenerated from an RNG.
#
# Exact convex hull of these six points, in rationals, has h = 4, so a correct
# triangulation has 2n - 2 - h = 6 triangles. Pre-2.9.3: 4 triangles, and one
# input point missing from the output entirely.
var icp = vec_new();
# [measured: this fixture; hull and counts re-derived in exact rationals]
vec_push(icp, hvec2_new(0x4122_9CE2_D5D6_E212, 0x4127_8907_29BF_24A1));
vec_push(icp, hvec2_new(0x3C8E_24E8_BBBE_CC94, 0xBC5C_7CF2_DE23_7A70));
vec_push(icp, hvec2_new(0xBC5C_8956_4E5D_FCA0, 0x3C80_D342_FFE4_0540));
vec_push(icp, hvec2_new(0x3C88_267B_1B35_CD8E, 0x3C47_9EEC_3C48_9E00));
vec_push(icp, hvec2_new(0xBC7B_7473_90E5_40E4, 0x3C82_D0D7_239D_1858));
vec_push(icp, hvec2_new(0xBC68_8A23_88FE_A9B8, 0x3C6A_FCD4_4D14_CF88));
var ict = delaunay_2d(icp, 6);
assert_eq(_dl_used(6, ict), 6,
"wide dynamic range: every input point appears in the output (pre-2.9.3 dropped one)");
assert_eq(_dl_max_edge_share(ict), 2,
"wide dynamic range: manifold -- no edge shared by 3+ triangles");
assert_eq(vec_len(ict) / 3, 6,
"wide dynamic range: 2n-2-h = 6 triangles from the exact rational hull (pre-2.9.3 gave 4)");

# The predicate itself, on the triple whose float winding is exactly 0.0 while
# the true determinant is -5.457401e-11. This is the unit-level statement of the
# same defect, and it is what an exact-determinant-of-rounded-differences repair
# still gets wrong -- that variant was implemented, measured, and rejected.
# [measured: docs/development/issues/archived/2026-08-04-incircle-precision.md]
assert_eq(_col_orient2d_sign(0x4117_D816_0244_6781, 0x4101_8DAA_C0BF_0023,
0xBC9C_8FCD_CFA2_462D, 0xBC99_B388_F731_3522,
0x3C75_CB11_925B_C2D8, 0x3C9B_1503_87C2_0688), 0 - 1,
"orient2d: clockwise, where the float determinant is exactly 0.0");
assert_eq(_col_orient2d_sign(0, 0, F64_ONE, 0, 0, F64_ONE), 1,
"orient2d: an ordinary CCW triangle still takes the fast path");
assert_eq(_col_orient2d_sign(0, 0, 0, F64_ONE, F64_ONE, 0), 0 - 1,
"orient2d: an ordinary CW triangle");
assert_eq(_col_orient2d_sign(0, 0, F64_ONE, F64_ONE, F64_TWO, F64_TWO), 0,
"orient2d: exactly collinear is 0, not a rounding artefact");

test_group("2.9.3 _col_point_in_tri is BOUNDARY-INCLUSIVE, as ear clipping needs");

# Its doc comment claimed "(2D, strict interior)" until 2.9.3 and was false: an
# edge point makes that edge's signed area exactly 0, which sets neither
# has_neg nor has_pos, so "all signs agree" holds and it returns 1. The code is
# right -- ear clipping must not cut an ear when another vertex lies ON its
# boundary -- so only the contract was wrong. Pinned here so the next reader who
# trusts a comment over the code is contradicted by a test instead.
# Triangle (0,0) (4,0) (0,4).
var pit_z = 0;
var pit_4 = f64_from(4);
assert_eq(_col_point_in_tri(F64_ONE, F64_ONE, pit_z, pit_z, pit_4, pit_z, pit_z, pit_4), 1,
"point_in_tri: strict interior -> 1");
assert_eq(_col_point_in_tri(F64_TWO, pit_z, pit_z, pit_z, pit_4, pit_z, pit_z, pit_4), 1,
"point_in_tri: ON an edge -> 1 (INCLUSIVE, not strict)");
assert_eq(_col_point_in_tri(pit_z, pit_z, pit_z, pit_z, pit_4, pit_z, pit_z, pit_4), 1,
"point_in_tri: exactly ON a vertex -> 1");
assert_eq(_col_point_in_tri(f64_from(3), f64_from(3), pit_z, pit_z, pit_4, pit_z, pit_z, pit_4), 0,
"point_in_tri: strictly outside -> 0");
assert_eq(_col_point_in_tri(f64_neg(F64_ONE), F64_ONE, pit_z, pit_z, pit_4, pit_z, pit_z, pit_4), 0,
"point_in_tri: outside past an edge -> 0");

test_group("2.9.3 _col_dl_ic_g1: the one-ghost answer is order-free");

# The last open half of docs/development/issues/2026-08-06-ghost-incircle-g1-g3-assume-ccw.md.
# g2 was made order-free in 2.9.1 and g3 became the constant 1; g1 was the only
# helper still reading the triple's winding out of the CCW storage convention
# instead of forming it. Until 2.9.3 the whole entry point was therefore
# CCW-only, and the evidence for that was a Python transcription rather than an
# assertion in this suite. It is an assertion now.
_dlg1_run();
assert_eq(_DLG1_PROBES, 1800,
"g1: probe grid ran (4 edges x 25 query points x 3 ghost directions x 6 orderings)");
assert_eq(_DLG1_BAD, 0,
"g1: all six orderings of a one-ghost triple agree (pre-2.9.3 the anti-cyclic three inverted)");
assert_gt(_DLG1_TIE, 0,
"g1: the grid actually reaches the (b - a) x u_k == 0 case, so the fix cannot ignore it");

# ⚠ The grid above asserts ORDER-CONSISTENCY, and consistency alone is too weak
# for the apex fallback: negating the fallback's sign flips every ordering
# together, so the six still agree and the grid stays green -- that mutant
# survived the grid, and the four assertions below are what killed it.
# [measured: scratch mutation run, not reproducible in-tree]
# To re-run it: negate the apex fallback in _col_dl_ic_g1 and run this suite;
# _DLG1_BAD stays 0 while the four assertions below go red. It is the same weakness the g3 harness records
# below, and it needs the same answer: a CORRECTNESS assertion against a truth
# derived independently.
#
# Edge a = (0,0), b = (2,4) is parallel to u_0 = (1,2), so the ghost direction
# cannot supply the winding and the apex must. Two apexes on OPPOSITE sides of
# line(a, b) must give OPPOSITE answers for the same query point -- that is the
# whole content of the fallback, and no single-sided fixture can state it.
# Truths from the exact circumcircle of {a, b, A + 1e30*u_0} in Fractions:
#   A = ( 5, 1), (b-a)x(A-a) = -18:  p=(3,1) -> 1   p=(-3,1) -> 0
#   A = (-5, 1), (b-a)x(A-a) = +22:  p=(3,1) -> 0   p=(-3,1) -> 1
var g1_apr = vec_new();
vec_push(g1_apr, hvec2_new(f64_from(5), F64_ONE));        # apex right of ab
vec_push(g1_apr, hvec2_new(0, 0));                        # a
vec_push(g1_apr, hvec2_new(F64_TWO, f64_from(4)));        # b
assert_eq(_col_dl_ic_g1(g1_apr, 1, 2, 0, f64_from(3), F64_ONE), 1,
"g1: edge parallel to u_0, apex right of it -> p=(3,1) is inside");
assert_eq(_col_dl_ic_g1(g1_apr, 1, 2, 0, f64_neg(f64_from(3)), F64_ONE), 0,
"g1: edge parallel to u_0, apex right of it -> p=(-3,1) is outside");

var g1_apl = vec_new();
vec_push(g1_apl, hvec2_new(f64_neg(f64_from(5)), F64_ONE));   # apex LEFT of ab
vec_push(g1_apl, hvec2_new(0, 0));
vec_push(g1_apl, hvec2_new(F64_TWO, f64_from(4)));
assert_eq(_col_dl_ic_g1(g1_apl, 1, 2, 0, f64_from(3), F64_ONE), 0,
"g1: same edge, apex on the OTHER side -> p=(3,1) flips to outside");
assert_eq(_col_dl_ic_g1(g1_apl, 1, 2, 0, f64_neg(f64_from(3)), F64_ONE), 1,
"g1: same edge, apex on the OTHER side -> p=(-3,1) flips to inside");

_dlg3_run();
assert_eq(_DLG3_PROBES, 1800,
"g3: probe grid ran (4 scales x 3 apexes x 25 query points x 6 orderings)");
assert_eq(_DLG3_BAD_CYC, 0,
"g3: every CYCLIC ordering answers inside, at every scale");
assert_eq(_DLG3_BAD_ANTI, 0,
"g3: every ANTI-CYCLIC ordering answers inside too (2.9.1 answered 0 for all of them)");

# Spot checks naming the two orderings explicitly, so a failure reads as a
# winding bug rather than as a grid-plumbing bug. nr = 1, so the ghosts are 1, 2
# and 3 and the apex is the single real point.
var g3_pts = vec_new();
vec_push(g3_pts, hvec2_new(0, 0));
assert_eq(_col_dl_incircle(g3_pts, 1, 1, 2, 3, F64_ONE, F64_ONE), 1,
"g3: (G0, G1, G2) -- cyclic, CCW -- is inside");
assert_eq(_col_dl_incircle(g3_pts, 1, 1, 3, 2, F64_ONE, F64_ONE), 1,
"g3: (G0, G2, G1) -- anti-cyclic, CW -- is the SAME question, so also inside");

# The apex itself, and a point 1e18 out: no finite bound on p exists, because M
# is symbolic. Both must answer inside under both windings.
assert_eq(_col_dl_incircle(g3_pts, 1, 1, 2, 3, 0, 0), 1,
"g3: p at the apex is inside (cyclic)");
assert_eq(_col_dl_incircle(g3_pts, 1, 3, 2, 1, 0, 0), 1,
"g3: p at the apex is inside (anti-cyclic)");
var g3_far = f64_mul(f64_from(1000000000), f64_from(1000000000));
assert_eq(_col_dl_incircle(g3_pts, 1, 2, 3, 1, g3_far, f64_neg(g3_far)), 1,
"g3: p at 1e18 is still inside (cyclic) -- M is unbounded, so p cannot outrun it");
assert_eq(_col_dl_incircle(g3_pts, 1, 2, 1, 3, g3_far, f64_neg(g3_far)), 1,
"g3: p at 1e18 is still inside (anti-cyclic)");

test_group("2.8.4 _numx_use_fft: the dispatch decision itself");

# The gate is a DECISION FUNCTION, and until 2.8.4 nothing asserted what it
# decides -- only that both paths compute the right answer, which stays true
# whichever one runs. So a mispick was invisible: it cost time and changed no
# result. These pin the four decisions 2.8.4 corrected, measured by forcing both
# paths and timing them, plus the three that must NOT move.
#
# 1 = take the DFT reduction, 0 = take the direct double loop.
# DST-I passes post = 0 (its post-pass is a negate and a halve); DCT-II and its
# inverse pass post = 2 (a cos and a sin twiddle per bin).
assert_eq(_numx_use_fft(7, 16, 0), 1, "dst n=7: FFT (was direct; FFT is 20.6% faster)");
assert_eq(_numx_use_fft(26, 26, 2), 0, "dct n=26: direct (was FFT; direct is 11% faster)");
assert_eq(_numx_use_fft(38, 38, 2), 0, "dct n=38: direct (was FFT; direct is 8.2% faster)");
assert_eq(_numx_use_fft(39, 39, 2), 0, "dct n=39: direct (was FFT; direct is 2.6% faster)");

# The bounds are load-bearing, not incidental. n=40 is the size that a 1/8
# surcharge instead of 1/10 would wrongly flip -- the FFT is measurably faster
# there (66486 ns vs 67340 ns). n=27 is the acknowledged residual: still a 3%
# mispick, kept rather than papered over, because widening the fit to catch it
# drags correctly-picked sizes across.
assert_eq(_numx_use_fft(40, 40, 2), 1, "dct n=40: still FFT -- 1/10 surcharge, not 1/8");
assert_eq(_numx_use_fft(27, 27, 2), 1, "dct n=27: still FFT -- known 3% residual mispick");

# The headline sizes sit far above the crossover (margins 7.1x and 158.4x) and
# were never the gate's problem. 2.8.4 must not have moved them.
assert_eq(_numx_use_fft(1024, 2050, 0), 1, "dst n=1024: FFT (Bluestein), unchanged");
assert_eq(_numx_use_fft(1024, 1024, 2), 1, "dct n=1024: FFT (radix-2), unchanged");

test_group("2.8.3 num_dct / num_dst: closed forms on both sides of the crossover");

# Sizes chosen to hit every dispatch branch: 8 and 16 are direct (DST) or
# radix-2 FFT (DCT); 15 makes DST's 2(n+1) a power of two; 17 and 100 force
# Bluestein; 128 and 256 are the large radix-2 path.
fn _tx_sizes(i) {
    if (i == 0) { return 8; }
    if (i == 1) { return 15; }
    if (i == 2) { return 16; }
    if (i == 3) { return 17; }
    if (i == 4) { return 100; }
    if (i == 5) { return 128; }
    return 256;
}

var tx_bad_const = 0;
var tx_bad_delta = 0;
var tx_bad_rt = 0;
var tx_bad_inv = 0;
for (var txi = 0; txi < 7; txi = txi + 1) {
    var tn = _tx_sizes(txi);

    # (1) DCT-II of a constant c: X[0] = n*c exactly, X[k>0] = 0 exactly.
    var tc = alloc(tn * 8);
    for (var t1 = 0; t1 < tn; t1 = t1 + 1) { store64(tc + t1 * 8, F64_TWO); }
    if (num_dct(tc, tn) != HSB_ERR_NONE) { tx_bad_const = tx_bad_const + 1; }
    if (f64_approx_eq(load64(tc), f64_from(2 * tn), LOOSE_TOL_M) == 0) {
        tx_bad_const = tx_bad_const + 1;
    }
    for (var t2 = 1; t2 < tn; t2 = t2 + 1) {
        if (f64_approx_eq(load64(tc + t2 * 8), 0, LOOSE_TOL_M) == 0) {
            tx_bad_const = tx_bad_const + 1;
        }
    }

    # (2) DCT-II of e_j reads off column j: X[k] = cos(PI (2j+1) k / (2n)).
    var tj = tn / 3;
    var td = alloc(tn * 8);
    for (var t3 = 0; t3 < tn; t3 = t3 + 1) { store64(td + t3 * 8, 0); }
    store64(td + tj * 8, F64_ONE);
    if (num_dct(td, tn) != HSB_ERR_NONE) { tx_bad_delta = tx_bad_delta + 1; }
    for (var t4 = 0; t4 < tn; t4 = t4 + 1) {
        var ang = f64_div(f64_mul(F64_PI, f64_from((2 * tj + 1) * t4)), f64_from(2 * tn));
        if (f64_approx_eq(load64(td + t4 * 8), f64_cos(ang), LOOSE_TOL_M) == 0) {
            tx_bad_delta = tx_bad_delta + 1;
        }
    }

    # (3) round trips: idct(dct(x)) == x and idst(dst(x)) == x
    var tx = alloc(tn * 8);
    var tk = alloc(tn * 8);
    _DLR_STATE = 5150 + tn;
    for (var t5 = 0; t5 < tn; t5 = t5 + 1) {
        var tv = f64_sub(_dlr_unit(), F64_HALF);
        store64(tx + t5 * 8, tv);
        store64(tk + t5 * 8, tv);
    }
    num_dct(tx, tn);
    num_idct(tx, tn);
    for (var t6 = 0; t6 < tn; t6 = t6 + 1) {
        if (f64_approx_eq(load64(tx + t6 * 8), load64(tk + t6 * 8), LOOSE_TOL_M) == 0) {
            tx_bad_rt = tx_bad_rt + 1;
        }
    }
    for (var t7 = 0; t7 < tn; t7 = t7 + 1) { store64(tx + t7 * 8, load64(tk + t7 * 8)); }
    num_dst(tx, tn);
    num_idst(tx, tn);
    for (var t8 = 0; t8 < tn; t8 = t8 + 1) {
        if (f64_approx_eq(load64(tx + t8 * 8), load64(tk + t8 * 8), LOOSE_TOL_M) == 0) {
            tx_bad_rt = tx_bad_rt + 1;
        }
    }

    # (4) DST-I is a symmetric involution: S^2 = ((n+1)/2) I. Unlike the round
    # trip above this does NOT go through num_idst, so a scale error in the
    # forward transform cannot cancel itself out.
    for (var t9 = 0; t9 < tn; t9 = t9 + 1) { store64(tx + t9 * 8, load64(tk + t9 * 8)); }
    num_dst(tx, tn);
    num_dst(tx, tn);
    var thalf = f64_mul(f64_from(tn + 1), F64_HALF);
    for (var ta = 0; ta < tn; ta = ta + 1) {
        if (f64_approx_eq(load64(tx + ta * 8),
        f64_mul(thalf, load64(tk + ta * 8)), LOOSE_TOL_M) == 0) {
            tx_bad_inv = tx_bad_inv + 1;
        }
    }
}
assert_eq(tx_bad_const, 0, "DCT-II of a constant is n*c at k=0 and 0 elsewhere, 7 sizes");
assert_eq(tx_bad_delta, 0, "DCT-II of e_j is column j of the cosine kernel, 7 sizes");
assert_eq(tx_bad_rt, 0, "idct(dct(x)) and idst(dst(x)) round-trip, 7 sizes");
assert_eq(tx_bad_inv, 0, "dst(dst(x)) == ((n+1)/2) x -- DST-I is an involution, 7 sizes");
assert_eq(num_dct(alloc(8), 0), HSB_ERR_INVALID_INPUT, "num_dct(n=0) still rejects");
assert_eq(num_idct(alloc(8), 0), HSB_ERR_INVALID_INPUT, "num_idct(n=0) still rejects");
assert_eq(num_idst(alloc(8), 0), HSB_ERR_INVALID_INPUT, "num_idst(n=0) still rejects");
# NOISE — the four generators had no assertion that any of them computes
# anything (2.8.3)
# ================================================================
test_group("noise: perlin_2d / perlin_3d / simplex_2d / simplex_3d");

# Every noise assertion in the tree through 2.8.2 was of the form
# `|noise(p)| < 1` or `noise(p) == noise(p)` at a single point, plus the fBm
# NaN guards. Replacing the body of any of the four with `return 0;` satisfies
# all of them: 0 is bounded by 1, deterministic, and not NaN. That is roughly
# 320 lines of lattice hashing, skew/unskew, fade curves and gradient tables
# certified by nothing.
#
# Two independent things are checked below.
#
# (1) STRUCTURAL IDENTITIES that follow from the definition of gradient noise
#     and hold for no constant function. They are exact, so they carry no
#     tolerance argument at all.
# (2) VALUES, cross-checked against a reference implementation written from the
#     published algorithm in python3 (Perlin's 2002 "Improving Noise" for the
#     fade curve and permutation, Gustavson's simplex note for the skew factors
#     and the 0.5 - r^2 / 0.6 - r^2 falloff) and NOT transcribed from src/. The
#     permutation table in src/calc.cyr was separately diffed against Perlin's
#     published 256-entry table: identical, and a genuine permutation of 0..255.
#     Agreement is bit-exact for perlin_2d and perlin_3d at every point and
#     aggregate below; simplex differs by at most 3 ulp, purely from
#     associativity in the corner-offset expressions.

# --- (1a) Gradient noise vanishes exactly at its lattice points. At integer
# (x, y) the fractional offsets are 0, the fade weights are 0, and the surviving
# corner contributes grad . (0, 0) == 0. Not a tolerance: exactly zero.
assert_eq(perlin_2d(f64_from(3), f64_from(5)), 0, "perlin_2d == 0 exactly at a lattice point");
assert_eq(perlin_3d(F64_TWO, f64_from(7), f64_from(4)), 0,
"perlin_3d == 0 exactly at a lattice point");
# Simplex noise vanishes at the origin of the skewed lattice for the same
# reason (the near corner contributes grad . 0, the other two/three corners are
# outside the 0.5 / 0.6 falloff radius).
assert_eq(simplex_2d(0, 0), 0, "simplex_2d(0,0) == 0 exactly");
assert_eq(simplex_3d(0, 0, 0), 0, "simplex_3d(0,0,0) == 0 exactly");

# --- (1b) CELL-CENTRE QUANTISATION. fade(1/2) = 6/32 - 15/16 + 10/8 = 1/2
# exactly, and at a cell centre every corner offset is (+-1/2, +-1/2), so each
# 2D gradient dot product is exactly one of {-1, 0, +1}. The two nested lerps at
# weight 1/2 then make perlin_2d(i+1/2, j+1/2) an exact multiple of 1/4 in
# [-1, 1] -- in dyadic arithmetic, with no rounding anywhere. In 3D the eight
# corners and three lerps make it an exact multiple of 1/8.
#
# The histogram of those quantised values over a block of cells is a fingerprint
# of the entire pipeline (permutation table, corner hashing, gradient selection
# and the fade curve at once). Both histograms below were produced by the
# independent reference and match src bin for bin.
var _nz_hp = alloc(7 * 8);
var _nz_i = 0;
while (_nz_i < 7) { store64(_nz_hp + _nz_i * 8, 0); _nz_i = _nz_i + 1; }
var _nz_bad = 0;
var _nz_oob = 0;
_nz_i = 0;
while (_nz_i < 16) {
    var _nz_j = 0;
    while (_nz_j < 16) {
        var _nz_v = perlin_2d(f64_add(f64_from(_nz_i), F64_HALF),
        f64_add(f64_from(_nz_j), F64_HALF));
        var _nz_q = f64_mul(_nz_v, f64_from(4));
        var _nz_n = f64_to(f64_round(_nz_q));
        if (f64_lt(f64_abs(f64_sub(_nz_q, f64_from(_nz_n))), TOL_1EM12) == 0) {
            _nz_bad = _nz_bad + 1;
        }
        if (_nz_n < 0 - 3 || _nz_n > 3) {
            _nz_oob = _nz_oob + 1;
        } else {
            store64(_nz_hp + (_nz_n + 3) * 8, load64(_nz_hp + (_nz_n + 3) * 8) + 1);
        }
        _nz_j = _nz_j + 1;
    }
    _nz_i = _nz_i + 1;
}
assert_eq(_nz_bad, 0, "perlin_2d: all 256 cell centres are exact multiples of 1/4");
assert_eq(_nz_oob, 0, "perlin_2d: all 256 cell centres lie in [-3/4, 3/4]");
assert_eq(load64(_nz_hp), 7, "perlin_2d cell-centre histogram: 4v = -3 occurs 7x");
assert_eq(load64(_nz_hp + 8), 25, "perlin_2d cell-centre histogram: 4v = -2 occurs 25x");
assert_eq(load64(_nz_hp + 16), 62, "perlin_2d cell-centre histogram: 4v = -1 occurs 62x");
assert_eq(load64(_nz_hp + 24), 67, "perlin_2d cell-centre histogram: 4v = 0 occurs 67x");
assert_eq(load64(_nz_hp + 32), 62, "perlin_2d cell-centre histogram: 4v = +1 occurs 62x");
assert_eq(load64(_nz_hp + 40), 22, "perlin_2d cell-centre histogram: 4v = +2 occurs 22x");
assert_eq(load64(_nz_hp + 48), 11, "perlin_2d cell-centre histogram: 4v = +3 occurs 11x");

var _nz_hq = alloc(12 * 8);
_nz_i = 0;
while (_nz_i < 12) { store64(_nz_hq + _nz_i * 8, 0); _nz_i = _nz_i + 1; }
var _nz_bad3 = 0;
var _nz_oob3 = 0;
_nz_i = 0;
while (_nz_i < 8) {
    var _nz_j3 = 0;
    while (_nz_j3 < 8) {
        var _nz_k3 = 0;
        while (_nz_k3 < 8) {
            var _nz_v3 = perlin_3d(f64_add(f64_from(_nz_i), F64_HALF),
            f64_add(f64_from(_nz_j3), F64_HALF), f64_add(f64_from(_nz_k3), F64_HALF));
            var _nz_q3 = f64_mul(_nz_v3, f64_from(8));
            var _nz_n3 = f64_to(f64_round(_nz_q3));
            if (f64_lt(f64_abs(f64_sub(_nz_q3, f64_from(_nz_n3))), TOL_1EM12) == 0) {
                _nz_bad3 = _nz_bad3 + 1;
            }
            if (_nz_n3 < 0 - 6 || _nz_n3 > 5) {
                _nz_oob3 = _nz_oob3 + 1;
            } else {
                store64(_nz_hq + (_nz_n3 + 6) * 8, load64(_nz_hq + (_nz_n3 + 6) * 8) + 1);
            }
            _nz_k3 = _nz_k3 + 1;
        }
        _nz_j3 = _nz_j3 + 1;
    }
    _nz_i = _nz_i + 1;
}
assert_eq(_nz_bad3, 0, "perlin_3d: all 512 cell centres are exact multiples of 1/8");
assert_eq(_nz_oob3, 0, "perlin_3d: all 512 cell centres lie in [-6/8, 5/8]");
assert_eq(load64(_nz_hq), 1, "perlin_3d cell-centre histogram: 8v = -6 occurs 1x");
assert_eq(load64(_nz_hq + 8), 3, "perlin_3d cell-centre histogram: 8v = -5 occurs 3x");
assert_eq(load64(_nz_hq + 16), 8, "perlin_3d cell-centre histogram: 8v = -4 occurs 8x");
assert_eq(load64(_nz_hq + 24), 39, "perlin_3d cell-centre histogram: 8v = -3 occurs 39x");
assert_eq(load64(_nz_hq + 32), 65, "perlin_3d cell-centre histogram: 8v = -2 occurs 65x");
assert_eq(load64(_nz_hq + 40), 93, "perlin_3d cell-centre histogram: 8v = -1 occurs 93x");
assert_eq(load64(_nz_hq + 48), 85, "perlin_3d cell-centre histogram: 8v = 0 occurs 85x");
assert_eq(load64(_nz_hq + 56), 105, "perlin_3d cell-centre histogram: 8v = +1 occurs 105x");
assert_eq(load64(_nz_hq + 64), 67, "perlin_3d cell-centre histogram: 8v = +2 occurs 67x");
assert_eq(load64(_nz_hq + 72), 32, "perlin_3d cell-centre histogram: 8v = +3 occurs 32x");
assert_eq(load64(_nz_hq + 80), 10, "perlin_3d cell-centre histogram: 8v = +4 occurs 10x");
assert_eq(load64(_nz_hq + 88), 4, "perlin_3d cell-centre histogram: 8v = +5 occurs 4x");

# --- (2) POINT VALUES against the independent reference.
var _nz_p1 = f64_div(F64_ONE, f64_from(10));                   # 0.1
var _nz_p2 = f64_div(F64_ONE, f64_from(5));                    # 0.2
var _nz_p3 = f64_div(f64_from(3), f64_from(10));               # 0.3
var _nz_a = f64_div(f64_from(13), f64_from(4));                # 3.25
var _nz_b = f64_div(f64_from(31), f64_from(4));                # 7.75
var _nz_c = f64_div(f64_from(5), f64_from(4));                 # 1.25
var _nz_d = f64_div(f64_from(5), F64_TWO);                     # 2.5
var _nz_e = f64_div(f64_from(15), f64_from(4));                # 3.75
assert_eq(perlin_2d(_nz_a, _nz_b), 0xBFD8B07000000000,
"perlin_2d(3.25, 7.75) == -0.38576889038085938 (bit-exact vs reference)");
assert_eq(perlin_2d(_nz_p1, _nz_p2), 0x3FC32F725475690A,
"perlin_2d(0.1, 0.2) == 0.14988545536000003 (bit-exact vs reference)");
assert_eq(perlin_3d(_nz_p1, _nz_p2, _nz_p3), 0x3FD2B8E731B20FE7,
"perlin_3d(0.1, 0.2, 0.3) == 0.29253558972436483 (bit-exact vs reference)");
assert_eq(perlin_3d(_nz_c, _nz_d, _nz_e), 0x3FD8AF9000000000,
"perlin_3d(1.25, 2.5, 3.75) == 0.38571548461914062 (bit-exact vs reference)");
# Simplex agrees to <= 3 ulp; the difference is association order in the corner
# offsets (src forms x0 + (-i1) - G2, the reference x0 - i1 - G2), not the
# algorithm, so these are pinned at 1e-14 rather than bit-exact.
var _nz_tol = 0x3D06849B86A12B9B;                              # 1e-14
assert(f64_lt(f64_abs(f64_sub(simplex_2d(_nz_p1, _nz_p2), 0x3FD25EECBFB15B55)), _nz_tol) == 1,
"simplex_2d(0.1, 0.2) == 0.28704375 (vs reference)");
assert(f64_lt(f64_abs(f64_sub(simplex_2d(f64_div(f64_from(25), F64_TWO),
f64_div(F64_ONE, f64_from(8))), 0x3FA4E0CB72CED103)), _nz_tol) == 1,
"simplex_2d(12.5, 0.125) == 0.040777547611840624 (vs reference)");
assert(f64_lt(f64_abs(f64_sub(simplex_3d(_nz_p1, _nz_p2, _nz_p3), 0x3FDB826DEA2487AE)),
_nz_tol) == 1, "simplex_3d(0.1, 0.2, 0.3) == 0.42983577599999989 (vs reference)");
assert(f64_lt(f64_abs(f64_sub(simplex_3d(_nz_c, _nz_d, _nz_e), 0xBF81CB1A444367EC)),
_nz_tol) == 1, "simplex_3d(1.25, 2.5, 3.75) == -0.0086881687242801 (vs reference)");

# --- (2b) AGGREGATES over a 40x40 grid at step 1/4 (2D) and a 12x12x12 grid
# (3D), so 1600 / 1728 samples are folded into each number. The L1 mass is the
# statement that the generator produces SIGNAL: `return 0;` gives 0 where the
# reference gives 369.35 / 252.12 / 363.05 / 236.59. max|v| is the amplitude,
# and 3/4 is exact for both Perlin variants (the largest reachable convex
# combination of gradient dots). The rigorous convex-combination bound on
# perlin_2d over a cell is 1.0, so the < 1 range claim in the doc is proved,
# not sampled.
var _nz_step = f64_div(F64_ONE, f64_from(4));
var _nz_eps = f64_div(F64_ONE, f64_from(1024));
var _nz_l1p = 0;
var _nz_l1s = 0;
var _nz_mxp = 0;
var _nz_mxs = 0;
var _nz_cp = 0;
var _nz_cs = 0;
_nz_i = 0;
while (_nz_i < 40) {
    var _nz_jj = 0;
    while (_nz_jj < 40) {
        var _nz_x = f64_mul(f64_from(_nz_i), _nz_step);
        var _nz_y = f64_mul(f64_from(_nz_jj), _nz_step);
        var _nz_vp = perlin_2d(_nz_x, _nz_y);
        var _nz_vs = simplex_2d(_nz_x, _nz_y);
        _nz_l1p = f64_add(_nz_l1p, f64_abs(_nz_vp));
        _nz_l1s = f64_add(_nz_l1s, f64_abs(_nz_vs));
        if (f64_gt(f64_abs(_nz_vp), _nz_mxp) == 1) { _nz_mxp = f64_abs(_nz_vp); }
        if (f64_gt(f64_abs(_nz_vs), _nz_mxs) == 1) { _nz_mxs = f64_abs(_nz_vs); }
        var _nz_dp = f64_abs(f64_sub(perlin_2d(f64_add(_nz_x, _nz_eps), _nz_y), _nz_vp));
        var _nz_ds = f64_abs(f64_sub(simplex_2d(f64_add(_nz_x, _nz_eps), _nz_y), _nz_vs));
        if (f64_gt(_nz_dp, _nz_cp) == 1) { _nz_cp = _nz_dp; }
        if (f64_gt(_nz_ds, _nz_cs) == 1) { _nz_cs = _nz_ds; }
        _nz_jj = _nz_jj + 1;
    }
    _nz_i = _nz_i + 1;
}
var _nz_tol9 = 0x3E112E0BE826D695;                             # 1e-9
assert(f64_lt(f64_abs(f64_sub(_nz_l1p, 0x407715A274000000)), _nz_tol9) == 1,
"perlin_2d: L1 mass over 1600 samples == 369.3521614074707 (reference, bit-exact)");
assert(f64_lt(f64_abs(f64_sub(_nz_l1s, 0x406F83D49FD06065)), _nz_tol9) == 1,
"simplex_2d: L1 mass over 1600 samples == 252.11970511148971 (reference)");
assert_eq(_nz_mxp, 0x3FE8000000000000, "perlin_2d: max|v| over the grid == 3/4 exactly");
assert(f64_lt(f64_abs(f64_sub(_nz_mxs, 0x3FED2230814660DF)), _nz_tol) == 1,
"simplex_2d: max|v| over the grid == 0.9104235196018883 (reference)");
# Continuity: gradient noise is C^2 and simplex is C^1 across its falloff
# boundary, so a 1/1024 step can never move the value far. A hash-scrambled or
# mis-indexed lattice shows up here as a discontinuity even when the amplitude
# statistics still look plausible. Measured maxima: 0.00269 / 0.00427.
var _nz_c01 = 0x3F847AE147AE147B;                              # 0.01
assert(f64_lt(_nz_cp, _nz_c01) == 1, "perlin_2d: no jump > 0.01 across a 1/1024 step");
assert(f64_lt(_nz_cs, _nz_c01) == 1, "simplex_2d: no jump > 0.01 across a 1/1024 step");
# Rigorous bound: |perlin_2d| is a convex combination of four gradient dots
# whose supremum over the cell is exactly 1.
assert(f64_lt(_nz_mxp, F64_ONE) == 1, "perlin_2d: inside the analytic bound of 1");
assert(f64_lt(_nz_mxs, F64_ONE) == 1, "simplex_2d: inside the documented [-1, 1] range");

var _nz_l1p3 = 0;
var _nz_l1s3 = 0;
var _nz_mxp3 = 0;
var _nz_mxs3 = 0;
var _nz_cp3 = 0;
var _nz_cs3 = 0;
_nz_i = 0;
while (_nz_i < 12) {
    var _nz_j5 = 0;
    while (_nz_j5 < 12) {
        var _nz_k5 = 0;
        while (_nz_k5 < 12) {
            var _nz_x3 = f64_mul(f64_from(_nz_i), _nz_step);
            var _nz_y3 = f64_mul(f64_from(_nz_j5), _nz_step);
            var _nz_z3 = f64_mul(f64_from(_nz_k5), _nz_step);
            var _nz_w = perlin_3d(_nz_x3, _nz_y3, _nz_z3);
            var _nz_u = simplex_3d(_nz_x3, _nz_y3, _nz_z3);
            _nz_l1p3 = f64_add(_nz_l1p3, f64_abs(_nz_w));
            _nz_l1s3 = f64_add(_nz_l1s3, f64_abs(_nz_u));
            if (f64_gt(f64_abs(_nz_w), _nz_mxp3) == 1) { _nz_mxp3 = f64_abs(_nz_w); }
            if (f64_gt(f64_abs(_nz_u), _nz_mxs3) == 1) { _nz_mxs3 = f64_abs(_nz_u); }
            var _nz_e3 = f64_abs(f64_sub(perlin_3d(f64_add(_nz_x3, _nz_eps), _nz_y3, _nz_z3),
            _nz_w));
            var _nz_e4 = f64_abs(f64_sub(simplex_3d(f64_add(_nz_x3, _nz_eps), _nz_y3, _nz_z3),
            _nz_u));
            if (f64_gt(_nz_e3, _nz_cp3) == 1) { _nz_cp3 = _nz_e3; }
            if (f64_gt(_nz_e4, _nz_cs3) == 1) { _nz_cs3 = _nz_e4; }
            _nz_k5 = _nz_k5 + 1;
        }
        _nz_j5 = _nz_j5 + 1;
    }
    _nz_i = _nz_i + 1;
}
assert(f64_lt(f64_abs(f64_sub(_nz_l1p3, 0x4076B0C2DDE20000)), _nz_tol9) == 1,
"perlin_3d: L1 mass over 1728 samples == 363.04757488518953 (reference, bit-exact)");
assert(f64_lt(f64_abs(f64_sub(_nz_l1s3, 0x406D92E1565F2544)), _nz_tol9) == 1,
"simplex_3d: L1 mass over 1728 samples == 236.59000700553054 (reference)");
assert_eq(_nz_mxp3, 0x3FE8000000000000, "perlin_3d: max|v| over the grid == 3/4 exactly");
assert(f64_lt(f64_abs(f64_sub(_nz_mxs3, 0x3FEC7D712FA66F29)), _nz_tol) == 1,
"simplex_3d: max|v| over the grid == 0.8903127604166673 (reference)");
assert(f64_lt(_nz_cp3, _nz_c01) == 1, "perlin_3d: no jump > 0.01 across a 1/1024 step");
assert(f64_lt(_nz_cs3, _nz_c01) == 1, "simplex_3d: no jump > 0.01 across a 1/1024 step");
assert(f64_lt(_nz_mxp3, F64_ONE) == 1, "perlin_3d: inside the analytic bound of 1");
assert(f64_lt(_nz_mxs3, F64_ONE) == 1, "simplex_3d: inside the documented [-1, 1] range");

# ================================================================
var r = assert_summary();
# Clamp before exiting: assert_summary() returns the raw failure COUNT, and a wait
# status is only 8 bits — an unclamped 256 / 512 / 768 failures would exit 0 and
# score PASS. Any failure at all is exit 1.
if (r > 0) { r = 1; }
sys_exit_group(r);
