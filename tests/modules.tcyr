# [measured: co2 fixt.py / fixt2.py, exact oracle, 3.3.6, 3.3.7, this tree and the named mutant, 2026-10-31]
var _c37_f9 = _c37_mkbox(hvec3_new(0x3FC98D93E9FECDA8, 0x3FCA1CF3D94491D8, 0xBFE36B44DCEBD2BC),
  hvec3_new(0x3FC59F978719FCEF, 0x3FAA1EC832492661, 0x3FC415FBDF9581FC),
  hvec3_new(0xBFD4E1DEB0437ACC, 0xBFEAD7161C113012, 0x3FDBE61DAD346E0D),
