var _c37_sa = hvec4_new(0x3FE3FA2383749638, 0x3FED74336DC65F74, 0x3FEF19261D53416A, 0x3FED999B4E37A920);
var _c37_sb = hvec4_new(0xBFDD72884CE4B004, 0x3FF699287AA2B1C7, 0x3FFDA98E546ED316, 0x3FE1D20CB5735E3E);
_ga_sup_calls = 0;
