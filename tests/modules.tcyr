# ~1e-8 — for assertions on transcendental / iterative results where exact
# bit equality is not achievable but 8 significant digits is.
var LOOSE_TOL_M = 0x3E45798EE2308C3A;
# ~1e-15 -- a few ulp of 1.0, for order-1 quantities with a closed form
# (group-inverse round-trips, traceless generators, Euler's identity, cot(pi/3)).
# Replaces a literal f64_from(1), which is a tolerance of 1.0 and admits
# everything in [0, 2]. 2.7.0 measured the floor of its 12 sites at <= 2.3e-16 on
# 6.5.6. Re-measured on 6.6.12 over the 24 sites now, by swapping this constant:
# all pass at 2^-52 + 1 ulp (~2.2e-16) and 3 fail at 2^-53 + 1 ulp, so the floor
# still sits at or below 2^-52.
# [measured: scratch harness, ULP_TOL_M swapped, not reproducible in-tree, 2026-09-30; cycc 6.6.12]
var ULP_TOL_M = 0x3CD203AF9EE75616;
var TOL_1EM12 = 0x3D719799812DEA11;  # 1e-12 (== EPSILON_F64)

# ================================================================
# Tolerance helper — added 2.13.0
# ================================================================
# ⭐ WHY THIS EXISTS. Before 2.13.0 this suite compared floats through
# `f64_to(x)`, which TRUNCATES: `assert_eq(f64_to(v), 3)` accepts every v in
# [3, 4), i.e. an absolute error of up to 1.0. Measured on the pre-conversion
# tree: `hvec2_add` could return `a + b + 0.9` and **all 3572 assertions still
# passed**. 2.13.0 converted the exact cases to bit-exact compares; this helper
# is for the cases that are genuinely approximate, so "approximate" is a named
# decision at the call site instead of a side effect of truncation.
# ⚠ Use `assert_eq(a, b, msg)` when the value IS exact — most are. Reach for
# this only when a transcendental or an iteration makes exactness untrue.
# [measured: scratch harness, not reproducible in-tree, 2026-09-09]
fn assert_f64_eq(a, b, msg) {
    assert(f64_approx_eq(a, b, LOOSE_TOL_M), msg);
    return 0;
}
# ~1e-13 -- for the Minkowski interval of (5,3,0,0), whose magnitude is 16 and
# whose measured boost drift is 7.105e-15 (4 ulp of 16).
# [measured: scratch python re-derivation from the pinned cosh/sinh(0.5) bits, 2026-10-11; tests bound it at 1e-13]
var IVL_TOL_M = 0x3D3C25C268497682;  # 1e-13

# Distance in ULPs between two finite f64s of one sign: their bit patterns are
# monotonic in value, so the difference of the patterns IS the ULP count. Opposite
# signs (+0 against -0 included) return the largest gap: without that test, a = -b
# makes a - b exactly -2^63, whose negation is -2^63 again, and `<= k` passed.
fn _tc_ulp_gap(a, b) {
    if ((a ^ b) < 0) { return 0x7FFFFFFFFFFFFFFF; }
    var d = a - b;
    if (d < 0) { d = 0 - d; }
    return d;
}

fn _tc_x2(x) { return f64_mul(x, x); }
fn _tc_sin(x) { return f64_sin(x); }
fn _tc_const(x) { return f64_from(7); }
fn _tc_one(x) { return F64_ONE; }
fn _tc_linear(x) { return x; }
fn _tc_cubic(x) {
    var cx2 = f64_mul(x, x);
    var cx3 = f64_mul(cx2, x);
    var ct1 = f64_sub(cx3, f64_mul(F64_TWO, cx2));
    var ct2 = f64_add(ct1, f64_mul(f64_from(3), x));
    return f64_sub(ct2, f64_from(4));
}
fn _tc_x4(x) { var qx2 = f64_mul(x, x); return f64_mul(qx2, qx2); }
fn _tc_inv1p(x) { return f64_div(F64_ONE, f64_add(F64_ONE, x)); }
fn _tc_cubic_pure(x) { return f64_mul(x, f64_mul(x, x)); }
fn _tn_f(x) { return f64_sub(f64_mul(x, x), F64_TWO); }
fn _tn_df(x) { return f64_mul(F64_TWO, x); }
fn _tn_cube_f(x) { return f64_sub(f64_mul(x, f64_mul(x, x)), f64_from(8)); }
fn _tn_cube_df(x) { return f64_mul(f64_from(3), f64_mul(x, x)); }
fn _tn_lin_f(x) { return f64_sub(x, f64_from(5)); }
fn _tn_lin_df(x) { return F64_ONE; }
fn _tn_sin_f(x) { return f64_sin(x); }
fn _tn_sin_df(x) { return f64_cos(x); }

# Sum of 2x signed areas over a flat triangle-index list (triplets) into points
# p — used to check a triangulation tiles its polygon (|sum| == polygon |2xarea|).
fn _tp_area2x(p, t) {
    var s = 0;
    var k = 0;
    var m = vec_len(t);
    while (k < m) {
        var a = vec_get(p, vec_get(t, k));
        var b = vec_get(p, vec_get(t, k + 1));
        var c = vec_get(p, vec_get(t, k + 2));
        s = f64_add(s, _col_triangle_area_2x(HVec2_x(a), HVec2_y(a),
            HVec2_x(b), HVec2_y(b), HVec2_x(c), HVec2_y(c)));
        k = k + 3;
    }
    return s;
}

# --- splitmix64 seed stream (2.8.2) -----------------------------------------
# Written for the delaunay_2d completeness harness, which runs in modules_b.tcyr.
# splitmix64 so a whole input class is pinned by one seed rather than by
# hundreds of literal coordinates. Integer-only, hence bit-identical anywhere.
var _DLR_STATE = 0;

fn _dlr_next() {
    _DLR_STATE = _DLR_STATE + 0x9E37_79B9_7F4A_7C15;
    var z = _DLR_STATE;
    z = (z ^ (z >> 30)) * 0xBF58_476D_1CE4_E5B9;
    z = (z ^ (z >> 27)) * 0x94D0_49BB_1331_11EB;
    return z ^ (z >> 31);
}

# Count points strictly inside any output triangle's circumcircle — the
# Delaunay empty-circumcircle property holds iff this is 0. Reuses the same
# winding-aware predicate the algorithm uses; cocircular points are not strictly
# inside, so they don't count. t = flat CCW triple-list into points p.
fn _dl_violations(p, n, t) {
    var viol = 0;
    var nt = vec_len(t) / 3;
    var ti = 0;
    while (ti < nt) {
        var a = vec_get(t, ti * 3);
        var b = vec_get(t, ti * 3 + 1);
        var c = vec_get(t, ti * 3 + 2);
        var j = 0;
        while (j < n) {
            var skip = 0;
            if (j == a) { skip = 1; }
            if (j == b) { skip = 1; }
            if (j == c) { skip = 1; }
            if (skip == 0) {
                var pj = vec_get(p, j);
                var ic = _col_in_circumcircle(p, a, b, c, HVec2_x(pj), HVec2_y(pj));
                if (ic == 1) { viol = viol + 1; }
            }
            j = j + 1;
        }
        ti = ti + 1;
    }
    return viol;
}

# Push a triangle (index triple) onto a flat triangle vec.
fn _he_tri(t, a, b, c) { vec_push(t, a); vec_push(t, b); vec_push(t, c); return 0; }

# Count boundary vertices of a half-edge mesh over vertices 0..nv-1.
# ⚠ 3.0.0 — `halfedge_is_boundary` returns its ANSWER in the Ok payload, so this
# helper sums the PAYLOAD and not the tag. Summing `halfedge_is_boundary(...)`
# directly would add the tag — 0 for every success — and every count would read 0
# while still "passing" against a 0 expectation somewhere else.
fn _he_boundary_sum(m, nv) {
    var s = 0;
    var v = 0;
    while (v < nv) {
        var bt, bv = halfedge_is_boundary(m, v);
        if (is_ok(bt) == 1) { s = s + bv; }
        v = v + 1;
    }
    return s;
}

# MPR support functions. Sphere: shape = HVec4 (cx,cy,cz, radius);
# support(dir) = center + radius * normalize(dir).
fn _mpr_sup_sphere(shape, dir) {
    var c = hvec3_new(HVec4_x(shape), HVec4_y(shape), HVec4_z(shape));
    var dn = hvec3_normalize(dir);
    return hvec3_add(c, hvec3_scale(dn, HVec4_w(shape)));
}

# Axis-aligned box: shape = 6 f64 [cx,cy,cz, hx,hy,hz]; per-axis far corner.
fn _mpr_box_axis(c, h, d) {
    if (f64_lt(d, 0) == 1) { return f64_sub(c, h); }
    return f64_add(c, h);
}
fn _mpr_sup_box(shape, dir) {
    var rx = _mpr_box_axis(load64(shape), load64(shape + 24), HVec3_x(dir));
    var ry = _mpr_box_axis(load64(shape + 8), load64(shape + 32), HVec3_y(dir));
    var rz = _mpr_box_axis(load64(shape + 16), load64(shape + 40), HVec3_z(dir));
    return hvec3_new(rx, ry, rz);
}
fn _mpr_mkbox(cx, cy, cz, hx, hy, hz) {
    var s = alloc(48);
    store64(s, cx);
    store64(s + 8, cy);
    store64(s + 16, cz);
    store64(s + 24, hx);
    store64(s + 32, hy);
    store64(s + 40, hz);
    return s;
}

# Elementwise Hermiticity test: A[i][j] == conj(A[j][i]) for EVERY (i,j),
# checked on the raw components. Deliberately does NOT go through
# cmat_adjoint: that writes r[j][i] = cx_conj(m[i][j]) and cx_conj copies the
# real part unchanged, so "Re(A[0][0]) == Re(adjoint(A)[0][0])" is an identity
# for every complex matrix ever built. Returns 1 (Hermitian) or 0.
# At i == j the Im test becomes Im + Im == 0, i.e. the diagonal must be real.
# f64_eq is IEEE equality, so +0.0 and -0.0 compare equal (cx_conj turns the
# +0.0 imaginary parts of the real generators into -0.0).
fn _gm_is_herm(m) {
    var n = cmat_rows(m);
    var i = 0;
    while (i < n) {
        var j = 0;
        while (j < n) {
            var a = cmat_get(m, i, j);
            var b = cmat_get(m, j, i);
            if (f64_eq(HComplex_re(a), HComplex_re(b)) == 0) { return 0; }
            if (f64_eq(f64_add(HComplex_im(a), HComplex_im(b)), 0) == 0) { return 0; }
            j = j + 1;
        }
        i = i + 1;
    }
    return 1;
}

# Brute-force reference for kdtree_within_radius.
fn _kdv_brute(points, n, query, radius) {
    var rsq = f64_mul(radius, radius);
    var c = 0;
    var i = 0;
    while (i < n) {
        var p = load64(points + i * 8);
        var dx = f64_sub(HVec3_x(p), HVec3_x(query));
        var dy = f64_sub(HVec3_y(p), HVec3_y(query));
        var dz = f64_sub(HVec3_z(p), HVec3_z(query));
        var d2 = f64_add(f64_add(f64_mul(dx, dx), f64_mul(dy, dy)), f64_mul(dz, dz));
        if (f64_gt(d2, rsq) == 0) { c = c + 1; }
        i = i + 1;
    }
    return c;
}

# Walk the tree and count points that sit on the WRONG side of their ancestor's
# pruning plane. This is the invariant the whole query algorithm rests on:
# every point in a left subtree has axis <= split_val, every point on the right
# has axis >= split_val. Returns the violation count.
fn _kdv_side_bad(node, points, axis, plane, want_le) {
    if (node == 0) { return 0; }
    var bad = 0;
    var pidx = _kd_node_point_idx(node);
    if (pidx != 0 - 1) {
        var pt = load64(points + pidx * 8);
        var v = _kd_axis_val(pt, axis);
        if (want_le == 1) {
            if (f64_gt(v, plane) == 1) { bad = 1; }
        } else {
            if (f64_lt(v, plane) == 1) { bad = 1; }
        }
        return bad;
    }
    bad = bad + _kdv_side_bad(_kd_node_left(node), points, axis, plane, want_le);
    bad = bad + _kdv_side_bad(_kd_node_right(node), points, axis, plane, want_le);
    return bad;
}

# Depth of the deepest leaf. 2.9.3: the balance guard had NO regression
# assertion -- the two that guarded it (`kdtree_build != 0` and the split-plane
# invariant) both hold perfectly well on a degenerate 500-deep spine, so
# deleting the guard broke nothing that was being checked. Depth is the
# property the guard actually provides, so depth is what has to be asserted.
fn _kdv_depth(node) {
    if (node == 0) { return 0; }
    var l = _kdv_depth(_kd_node_left(node));
    var r = _kdv_depth(_kd_node_right(node));
    if (l > r) { return l + 1; }
    return r + 1;
}

fn _kdv_invariant_bad(node, points) {
    if (node == 0) { return 0; }
    if (_kd_node_point_idx(node) != 0 - 1) { return 0; }
    var axis = _kd_node_split_axis(node);
    var plane = _kd_node_split_val(node);
    var bad = _kdv_side_bad(_kd_node_left(node), points, axis, plane, 1);
    bad = bad + _kdv_side_bad(_kd_node_right(node), points, axis, plane, 0);
    bad = bad + _kdv_invariant_bad(_kd_node_left(node), points);
    bad = bad + _kdv_invariant_bad(_kd_node_right(node), points);
    return bad;
}

# dy/dt = y for the implicit integrators.
fn _cv_dydt_y(t, y) { return y; }
# SHO acceleration for leapfrog.
fn _cv_accel(q) { return f64_neg(q); }

# --- lie_ext: do two SE(3) elements act identically? ------------------------
# Four points (the origin plus the three axes) determine a rigid motion, so
# agreement on all four is agreement everywhere. Used to check the defining
# adjoint identity exp(Ad_g xi) == g exp(xi) g^-1 without reaching into the
# internal layout of either operand.
fn _se_same(a, b) {
    var pts = alloc(32);
    store64(pts, hvec3_zero());
    store64(pts + 8, hvec3_unit_x());
    store64(pts + 16, hvec3_unit_y());
    store64(pts + 24, hvec3_unit_z());
    for (var i = 0; i < 4; i = i + 1) {
        var p = load64(pts + i * 8);
        var qa = se3_transform_point(a, p);
        var qb = se3_transform_point(b, p);
        if (f64_lt(f64_abs(f64_sub(HVec3_x(qa), HVec3_x(qb))), LOOSE_TOL_M) == 0) { return 0; }
        if (f64_lt(f64_abs(f64_sub(HVec3_y(qa), HVec3_y(qb))), LOOSE_TOL_M) == 0) { return 0; }
        if (f64_lt(f64_abs(f64_sub(HVec3_z(qa), HVec3_z(qb))), LOOSE_TOL_M) == 0) { return 0; }
    }
    return 1;
}

# --- 2.8.3: support functions for the gjk_epa_3d (EPA) fixtures ---
# Every one bumps _ga_sup_calls. EPA issues exactly one Minkowski support query
# (= two of these) per iteration, so the counter is a direct, black-box read of
# how many EPA iterations a call ran -- which is what the arena budget below is
# normalised against.
var _ga_sup_calls = 0;

# Sphere: shape = HVec4 [cx, cy, cz, r]
fn _ga_sup_sphere(shape, dir) {
    _ga_sup_calls = _ga_sup_calls + 1;
    var dn = hvec3_normalize(dir);
    var r = HVec4_w(shape);
    return hvec3_new(f64_add(HVec4_x(shape), f64_mul(HVec3_x(dn), r)),
      f64_add(HVec4_y(shape), f64_mul(HVec3_y(dn), r)),
      f64_add(HVec4_z(shape), f64_mul(HVec3_z(dn), r)));
}

# Oriented box: shape = [cx, cy, cz, hx, hy, hz, qx, qy, qz, qw]
fn _ga_mkobb(cx, cy, cz, hx, hy, hz, qx, qy, qz, qw) {
    var s = alloc(80);
    store64(s, cx); store64(s + 8, cy); store64(s + 16, cz);
    store64(s + 24, hx); store64(s + 32, hy); store64(s + 40, hz);
    store64(s + 48, qx); store64(s + 56, qy); store64(s + 64, qz); store64(s + 72, qw);
    return s;
}
fn _ga_sup_obb(shape, dir) {
    _ga_sup_calls = _ga_sup_calls + 1;
    var q = hquat_new(load64(shape + 48), load64(shape + 56), load64(shape + 64), load64(shape + 72));
    var ld = hquat_rotate_vec3(hquat_conjugate(q), dir);
    var lx = load64(shape + 24);
    var ly = load64(shape + 32);
    var lz = load64(shape + 40);
    if (f64_lt(HVec3_x(ld), 0) == 1) { lx = f64_neg(lx); }
    if (f64_lt(HVec3_y(ld), 0) == 1) { ly = f64_neg(ly); }
    if (f64_lt(HVec3_z(ld), 0) == 1) { lz = f64_neg(lz); }
    var wp = hquat_rotate_vec3(q, hvec3_new(lx, ly, lz));
    return hvec3_new(f64_add(load64(shape), HVec3_x(wp)),
      f64_add(load64(shape + 8), HVec3_y(wp)),
      f64_add(load64(shape + 16), HVec3_z(wp)));
}
# --- calc_monotone_cubic shape oracle (2.8.3) ------------------------------
# 3.4.0: calc_monotone_cubic is retired; _mc_at reads calc_monotone_cubic_checked, and
# returns a signalling NaN no Ok value has when it refuses (so no assertion below can
# pass on a refusal), or the refusal's code from _mc_at_err.
var _MC_OUT = alloc(8);
fn _mc_at(xs, ys, n, x) {
    store64(_MC_OUT, 0x7FF4000000000001);
    var t, v = calc_monotone_cubic_checked(xs, ys, n, x, _MC_OUT);
    return load64(_MC_OUT);
}
fn _mc_at_err(xs, ys, n, x) {
    var t, v = calc_monotone_cubic_checked(xs, ys, n, x, _MC_OUT);
    if (is_ok(t) == 1) { return 0; }
    return v;
}
# The CONTRACT, not a reference implementation: on [xs[k], xs[k+1]] the
# interpolant may not leave [ys[k], ys[k+1]]. Worst violation over a 1/steps
# grid across every interval; 0 when the function honours its own name.
fn _mc_box_violation(xs, ys, n, steps) {
    var worst = 0;
    var k = 0;
    while (k < n - 1) {
        var xk = _f64arr_get(xs, k);
        var xk1 = _f64arr_get(xs, k + 1);
        var lo = f64_min(_f64arr_get(ys, k), _f64arr_get(ys, k + 1));
        var hi = f64_max(_f64arr_get(ys, k), _f64arr_get(ys, k + 1));
        var s = 0;
        while (s <= steps) {
            var u = f64_div(f64_from(s), f64_from(steps));
            var v = _mc_at(xs, ys, n,
              f64_add(xk, f64_mul(u, f64_sub(xk1, xk))));
            if (f64_gt(f64_sub(v, hi), worst) == 1) { worst = f64_sub(v, hi); }
            if (f64_gt(f64_sub(lo, v), worst) == 1) { worst = f64_sub(lo, v); }
            s = s + 1;
        }
        k = k + 1;
    }
    return worst;
}

# Largest step taken AGAINST the direction of interval k's own secant.
fn _mc_backstep(xs, ys, n, k, steps) {
    var xk = _f64arr_get(xs, k);
    var xk1 = _f64arr_get(xs, k + 1);
    var up = 1;
    if (f64_lt(_f64arr_get(ys, k + 1), _f64arr_get(ys, k)) == 1) { up = 0; }
    var worst = 0;
    var prev = _mc_at(xs, ys, n, xk);
    var s = 1;
    while (s <= steps) {
        var u = f64_div(f64_from(s), f64_from(steps));
        var v = _mc_at(xs, ys, n,
          f64_add(xk, f64_mul(u, f64_sub(xk1, xk))));
        var d = f64_sub(v, prev);
        if (up == 0) { d = f64_neg(d); }
        if (f64_lt(d, 0) == 1) {
            if (f64_gt(f64_neg(d), worst) == 1) { worst = f64_neg(d); }
        }
        prev = v;
        s = s + 1;
    }
    return worst;
}

# --- time_of_impact exact references (2.8.3) -------------------------------
# Exact first-contact time of two TRANSLATING spheres: the smaller root of
# |d + w t|^2 = R^2. Closed form, so it inherits nothing from the code under
# test. Returns -1 when they never touch.
fn _toi_ref_sphere(ca, ra, va, cb, rb, vb) {
    var d = hvec3_sub(cb, ca);
    var w = hvec3_sub(vb, va);
    var rr = f64_add(ra, rb);
    var qa = hvec3_dot(w, w);
    var qb = hvec3_dot(d, w);
    var qc = f64_sub(hvec3_dot(d, d), f64_mul(rr, rr));
    if (f64_le(qc, 0) == 1) { return 0; }
    # `qa <= 0`, not `qa < EPSILON_F64`: qa is a SQUARED speed, so on 1e-6-scale
    # geometry it is ~1e-12 for a perfectly ordinary approach and an absolute
    # 1e-12 floor makes this oracle declare "never collides" for half of them.
    # The first draft did exactly that and blamed the three resulting
    # disagreements on the code under test.
    if (f64_le(qa, 0) == 1) { return f64_neg(F64_ONE); }
    var disc = f64_sub(f64_mul(qb, qb), f64_mul(qa, qc));
    if (f64_lt(disc, 0) == 1) { return f64_neg(F64_ONE); }
    var t = f64_div(f64_sub(f64_neg(qb), f64_sqrt(disc)), qa);
    if (f64_lt(t, 0) == 1) { return f64_neg(F64_ONE); }
    return t;
}

# Tally block: [0] cases [1] collide [2] miss [3] falsepos [4] late [5] early
fn _toi_tally() {
    var s = alloc(48);
    for (var i = 0; i < 6; i = i + 1) { store64(s + i * 8, 0); }
    return s;
}
fn _toi_bump(s, i) {
    store64(s + i * 8, load64(s + i * 8) + 1);
    return 0;
}

# Score one sphere-vs-sphere sweep (A at the origin, stationary) against the
# exact root. `late`/`early` also catch a null out_normal, which the pre-2.8.3
# code could store whenever EPA failed on the contact polytope.
fn _toi_score(tally, ra, cb, rb, vb, max_t, tol_t) {
    var exact = _toi_ref_sphere(hvec3_zero(), ra, hvec3_zero(), cb, rb, vb);
    var sa = hvec4_new(0, 0, 0, ra);
    var sb = hvec4_new(HVec3_x(cb), HVec3_y(cb), HVec3_z(cb), rb);
    var ot = alloc(8);
    var on = alloc(8);
    store64(on, 0);
    var got = time_of_impact(&_mpr_sup_sphere, sa, hvec3_zero(),
      &_mpr_sup_sphere, sb, vb, max_t, ot, on);

    _toi_bump(tally, 0);
    var should = 0;
    if (f64_ge(exact, 0) == 1 && f64_le(exact, max_t) == 1) { should = 1; }
    if (should == 1) { _toi_bump(tally, 1); }
    if (should == 1 && got == 0) { _toi_bump(tally, 2); }
    if (should == 0 && got == 1) { _toi_bump(tally, 3); }
    if (got == 1 && load64(on) == 0) { _toi_bump(tally, 5); }
    if (should == 1 && got == 1) {
        var dt = f64_sub(load64(ot), exact);
        if (f64_gt(dt, tol_t) == 1) { _toi_bump(tally, 4); }
        if (f64_lt(dt, f64_neg(tol_t)) == 1) { _toi_bump(tally, 5); }
    }
    return 0;
}

# Deterministic f64 in [lo/den, hi/den] from the shared splitmix64 stream.
fn _toi_frac(lo, hi, den) {
    var r = _dlr_next();
    if (r < 0) { r = 0 - r; }
    return f64_div(f64_from(lo + (r % (hi - lo + 1))), f64_from(den));
}

alloc_init();

# ================================================================
# GEO — Primitives, intersections, closest-point, SDF (~30)
# ================================================================
# --- 2.10.0: every geo_ray_* is degree -1 homogeneous in the direction ------
#
# The contract shared by all six is "return t such that geo_ray_at(ray, t) is the
# hit point", i.e. the point is o + t*d. That forces t to be degree -1 in d:
# scale the direction by k and the SAME geometric point is reached at t/k.
#
# Four of the six honoured it; `geo_ray_sphere` did not, and `geo_ray_capsule`
# inherited the failure through its end-cap branches, which call the sphere. The
# sphere used the reduced half-b quadratic, valid only when d.d == 1, so with a
# non-unit direction it returned a t whose "hit point" was not on the sphere at
# all -- 3.74 from the centre of a unit sphere, silently.
#
# geo_ray_new normalises, so this is unreachable through the constructor alone;
# GeoRay is #derive(accessors) though, so GeoRay_set_direction is public and
# nothing documented a unit-length precondition.
#
# This assertion is ORACLE-FREE: it compares each routine against ITSELF at two
# direction scales, so it needs no reference implementation and cannot inherit a
# convention from the code under test.
# [measured: docs/development/issues/archived/2026-08-10-ray-sphere-capsule-assume-unit-direction.md]
fn _homog_bad(t_unit, t_scaled, k) {
    if (t_unit == 0) { return 0; }          # miss: nothing to check
    if (t_scaled == 0) { return 1; }        # scaling must not turn a hit into a miss
    var want = f64_div(t_unit, k);
    if (f64_approx_eq(t_scaled, want, LOOSE_TOL_M) == 1) { return 0; }
    return 1;
}

# --- 2.10.1: the degenerate-direction contract, over ALL SIX primitives ------
#
# Same shape of finding as the homogeneity sweep above, and found the same way:
# by running 2.10.1's own design requirement against the code that already
# ships, before writing the feature. A jet needs to know WHICH face the slab
# method selected, and on a degenerate direction there is no face -- so the
# question "what does the primal return there?" had to be asked, and the answer
# for two of the six was +Inf.
#
# `geo_ray_aabb` and `geo_ray_obb` skip any slab whose direction component is
# below EPSILON_F64. With all three skipped, t_min stays -Inf and t_max stays
# +Inf, and the tail `if (f64_lt(t_max, 0) != 1) { return t_max; }` handed back
# +Inf -- from functions whose contract is stated three times in geo.cyr as
# "0 on miss, positive f64 t on hit". geo_ray_at(ray, +Inf) is NaN in every
# component, so a consumer got NaN geometry with no error anywhere.
#
# ⚠ WHY IT SHIPPED, and the reason this is a SWEEP and not two more assertions:
# the pre-2.10.1 suite tested the zero direction on `geo_ray_sphere` and
# `geo_ray_capsule` only (the two 2.10.0 repaired), so four of the six siblings were
# never asked the question at all. A per-primitive assertion is exactly what
# leaves that hole; the sweep closes it by construction and the _DD_RUN counter
# fails if a primitive is ever silently dropped from it.
#
# ORACLE-FREE: it asserts against the module's own documented sentinel, not
# against a reference implementation.
# [measured: docs/development/issues/archived/2026-08-10-aabb-obb-degenerate-direction.md]
# --- 2.10.1: homogeneity at SMALL direction scales ---------------------------
#
# ⚠ THIS EXISTS BECAUSE THE 2.10.0 SWEEP COULD NOT HAVE CAUGHT WHAT IT MISSED.
# That sweep scales the direction by k = 2, 0.5 and 7 -- all of order 1, none
# anywhere near the degenerate-direction guard the SAME release added. So the
# guard's threshold was never exercised by the assertion written to protect the
# property the guard can break.
#
# It was broken. 2.10.0's guard tested `a = d.d` (a SQUARED length) against
# EPSILON_F64 (an unsquared tolerance), so every direction shorter than 1e-6 was
# reported as a miss. A unit sphere at (0,0,5) with d = (0,0,1e-7) has t = 4e7 --
# finite, exactly representable, and the correct answer that `geo_ray_aabb`,
# `geo_ray_triangle` and `geo_ray_plane` all returned. `geo_ray_sphere` returned
# 0, and `geo_ray_capsule` inherited it through its end caps: the same pair, by
# the same mechanism, as the defect 2.10.0 was fixing.
#
# The comparison here is RELATIVE, not the absolute `f64_approx_eq` the
# order-1 sweep uses -- at k = 1e-9 the t values are ~1e10 and an absolute 1e-8
# tolerance would fail on ordinary rounding rather than on disagreement.
# [measured: docs/development/issues/archived/2026-08-10-squared-epsilon-guards-in-geo-ray.md]
var _HS_BAD = 0;
var _HS_RUN = 0;
fn _homog_rel_bad(t_unit, t_scaled, k) {
    _HS_RUN = _HS_RUN + 1;
    if (t_unit == 0) { return 0; }          # miss at unit scale: nothing to check
    if (t_scaled == 0) { return 1; }        # a real hit must not become a miss
    var want = f64_div(t_unit, k);
    var rel = f64_div(f64_abs(f64_sub(t_scaled, want)), f64_abs(want));
    if (f64_lt(rel, LOOSE_TOL_M) == 1) { return 0; }
    return 1;
}

fn _homog_small_sweep() {
    var o = hvec3_new(f64_neg(f64_from(5)), f64_neg(f64_from(5)), f64_neg(f64_from(5)));
    var sph = geo_sphere_new(hvec3_new(0, 0, 0), F64_ONE);
    var pl  = geo_plane_from_point_normal(hvec3_new(0, 0, 0), hvec3_new(0, 0, F64_ONE));
    var tri = geo_triangle_new(hvec3_new(f64_neg(f64_from(9)), f64_neg(f64_from(9)), 0),
      hvec3_new(f64_from(9), f64_neg(f64_from(9)), 0), hvec3_new(0, f64_from(9), 0));
    var ab  = geo_aabb_new(hvec3_new(f64_neg(F64_ONE), f64_neg(F64_ONE), f64_neg(F64_ONE)),
      hvec3_new(F64_ONE, F64_ONE, F64_ONE));
    var ob  = geo_obb_new(hvec3_new(0, 0, 0), hvec3_new(F64_ONE, F64_ONE, F64_ONE), hquat_identity());
    var cap = geo_capsule_new(hvec3_new(0, 0, f64_neg(F64_ONE)), hvec3_new(0, 0, F64_ONE), F64_ONE);
    # k = 1e-5, 1e-7, 1e-9. The middle one straddles the 2.10.0 guard's threshold;
    # the outer two bracket it, so a fix that merely moved the threshold a decade
    # would still fail here.
    for (var ki = 0; ki < 3; ki = ki + 1) {
        var k = F64_ONE;
        var decades = 5;
        if (ki == 1) { decades = 7; }
        if (ki == 2) { decades = 9; }
        for (var i = 0; i < decades; i = i + 1) { k = f64_div(k, f64_from(10)); }
        var r = geo_ray_new(o, hvec3_new(F64_ONE, F64_ONE, F64_ONE));
        var du = GeoRay_direction(r);
        var ts = geo_ray_sphere(r, sph);   var tp = geo_ray_plane(r, pl);
        var tt = geo_ray_triangle(r, tri); var ta = geo_ray_aabb(r, ab);
        var to = geo_ray_obb(r, ob);       var tc = geo_ray_capsule(r, cap);
        GeoRay_set_direction(r, hvec3_scale(du, k));
        _HS_BAD = _HS_BAD + _homog_rel_bad(ts, geo_ray_sphere(r, sph), k);
        _HS_BAD = _HS_BAD + _homog_rel_bad(tp, geo_ray_plane(r, pl), k);
        _HS_BAD = _HS_BAD + _homog_rel_bad(tt, geo_ray_triangle(r, tri), k);
        _HS_BAD = _HS_BAD + _homog_rel_bad(ta, geo_ray_aabb(r, ab), k);
        _HS_BAD = _HS_BAD + _homog_rel_bad(to, geo_ray_obb(r, ob), k);
        _HS_BAD = _HS_BAD + _homog_rel_bad(tc, geo_ray_capsule(r, cap), k);
    }
    return 0;
}

# --- 2.10.2: the hit point a slab routine reports must be ON the box ---------
#
# THE STRUCTURAL CHECK THAT WOULD HAVE CAUGHT THE PHANTOM HIT, and the reason it
# is a sweep over direction magnitudes rather than a handful of witnesses.
#
# `geo_ray_aabb` and `geo_ray_obb` skipped any axis whose direction component
# fell below EPSILON_F64 (1e-12), treating it as parallel. That threshold is
# scale-free and the consequence is not: over t ~ 1e12 a component of 9e-13 moves
# the coordinate by ~0.9, most of a unit box, so the slab that would have
# REJECTED the ray was deleted and a confident hit came back. Measured on 2.10.1:
# box [0,1]^3, origin (0.5, 0.5, -1e12), direction (9e-13, 0, 1) with |d| = 1.0
# EXACTLY -- an ordinary unit direction, so geo_ray_new offered no protection --
# returned t = 1e12 whose hit point sits at x = 1.4.
# [measured: docs/development/issues/archived/2026-08-10-slab-parallel-test-is-scale-free.md]
#
# The invariant is the same one 2.10.0 used on the sphere ("the hit point is on
# the surface"), which is why it is worth having on every primitive rather than
# on the one that most recently broke. ORACLE-FREE: it compares the routine
# against its own returned geometry, not against a reference implementation.
# [measured: docs/development/issues/archived/2026-08-10-slab-parallel-test-is-scale-free.md]
# --- 2.10.2: scale covariance, the check that actually finds a bad threshold ---
#
# The same scene expressed in different units must give the same answer, scaled.
# A guard comparing a SQUARED length against an unsquared tolerance breaks that
# at a specific scale and nowhere else, so a fixture at one scale -- which is
# every other geometry fixture in this file -- cannot see it however many samples
# it takes. 2.10.1 fixed two such guards and left four, and dispositioned two of
# the four "a degeneracy policy" by READING the code. Measured, they are
# fabricated answers on well-formed input:
# [measured: docs/development/issues/archived/2026-08-10-squared-epsilon-guards-in-geo-ray.md]
#
#   geo_triangle_unit_normal   returned (0,1,0) for a right triangle with 1e-4
#                              legs in the xy-plane, where the truth is (0,0,1).
#                              Its len_sq is the SQUARED cross product, s^4, so
#                              the guard fired three decades earlier than the
#                              others.
#   geo_segment_direction      returned unit_x below 1e-6
#   geo_segment_closest_point  collapsed a short segment to its start, so
#                              geo_segment_distance_to_point -- which callers
#                              reach for as an ORACLE -- reported half the
#                              segment's length as the distance from its own
#                              MIDPOINT
#   geo_ray_capsule degenerate treated any capsule shorter than 1e-6 as a sphere
#
# All four now guard at _GEO_F64_TINY, on the rule the slab repair uses: guard
# exactly what makes the DIVISION fail and nothing more.
# [measured: docs/development/issues/archived/2026-08-10-squared-epsilon-guards-in-geo-ray.md]
# --- 2.10.2: every capsule hit point is ON the capsule ----------------------
#
# The cap branches used to call geo_ray_sphere, which returns only the FIRST
# non-negative root, and then tested that ONE root against the cap's half-space.
# If it failed, the other root was never considered. Two symptoms, one cause:
#
#   * a ray leaving the capsule through a cap reported a MISS -- 32 of 600 random
#     interior origins, 5.3%
#     [measured: docs/development/issues/archived/2026-08-10-capsule-cyl-missed-tags-a-sphere-root-as-a-cap.md]
#   * when the cylinder test yielded nothing, a separate fallback returned the
#     smaller of the two spheres' first roots with NO half-space test at all:
#     capsule (0,0,0)-(10,0,0) r = 1, ray from (5,0,0) along +x returned t = 4,
#     whose hit point (9,0,0) is ON THE AXIS, a full radius inside the solid
#
# The invariant asserted here is the surface residual, not a t value: |dist(hit,
# segment) - r| must be 0. A t-value assertion would have passed the second case,
# because 4.0 is a perfectly plausible number.
#
# ⚠ This sweep needs geo_segment_distance_to_point to be TRUSTWORTHY, and it was
# not until earlier in this same release -- it collapsed any segment shorter than
# 1e-6 to its start point. The commissioned probe that found these defects reached
# for it as an oracle and was silently misled. Fixed first, deliberately.
# [measured: docs/development/issues/archived/2026-08-10-capsule-cyl-missed-tags-a-sphere-root-as-a-cap.md]
var _CS_BAD = 0;
var _CS_RUN = 0;
var _CS_DROP = 0;

fn _cs_sweep() {
    var ca = hvec3_new(0, 0, 0);
    var cb = hvec3_new(f64_from(10), 0, 0);
    var cap = geo_capsule_new(ca, cb, F64_ONE);
    var seg = geo_segment_new(ca, cb);
    var seed = 987654321;
    for (var n = 0; n < 400; n = n + 1) {
        seed = (seed * 1103515245 + 12345) % 2147483648;
        var ax = f64_div(f64_from(seed % 900), f64_from(100));
        seed = (seed * 1103515245 + 12345) % 2147483648;
        var ay = f64_div(f64_from(seed % 120 - 60), f64_from(100));
        seed = (seed * 1103515245 + 12345) % 2147483648;
        var az = f64_div(f64_from(seed % 120 - 60), f64_from(100));
        var o = hvec3_new(ax, ay, az);
        # INTERIOR origins only -- that is the branch that was broken, and a
        # sweep from outside reproduces neither symptom.
        if (f64_gt(geo_segment_distance_to_point(seg, o), F64_ONE) == 1) { continue; }
        seed = (seed * 1103515245 + 12345) % 2147483648;
        var dx = f64_div(f64_from(seed % 200 - 100), f64_from(100));
        seed = (seed * 1103515245 + 12345) % 2147483648;
        var dy = f64_div(f64_from(seed % 200 - 100), f64_from(100));
        seed = (seed * 1103515245 + 12345) % 2147483648;
        var dz = f64_div(f64_from(seed % 200 - 100), f64_from(100));
        var d = hvec3_new(dx, dy, dz);
        if (f64_lt(hvec3_length(d), f64_div(F64_ONE, f64_from(10))) == 1) { continue; }
        _CS_RUN = _CS_RUN + 1;
        var r = alloc(sizeof(GeoRay));
        GeoRay_set_origin(r, o);
        GeoRay_set_direction(r, hvec3_normalize(d));
        var t = geo_ray_capsule(r, cap);
        # An origin INSIDE always has an exit, so a miss here is a dropped hit.
        if (t == 0) { _CS_DROP = _CS_DROP + 1; continue; }
        var resid = f64_abs(f64_sub(geo_segment_distance_to_point(seg,
              geo_ray_at(r, t)), F64_ONE));
        if (f64_gt(resid, LOOSE_TOL_M) == 1) { _CS_BAD = _CS_BAD + 1; }
    }
    return 0;
}

var _SC_BAD = 0;
var _SC_RUN = 0;

fn _sc_bad(got, want) {
    _SC_RUN = _SC_RUN + 1;
    if (f64_approx_eq(got, want, LOOSE_TOL_M) == 1) { return 0; }
    return 1;
}

# ⚠ 2.14.0 — THIS SWEEP WAS 10 DECADES AND THAT WAS 70 DECADES TOO SHALLOW.
# 2.10.2 moved four geo thresholds from EPSILON_F64 to `_GEO_F64_TINY` (DBL_MIN)
# and proved the repair with this sweep — but the sweep bottomed out at 1e-9,
# so it could only ever show that the OLD threshold was wrong, never that the new
# one was right. ⛔ It was not: `geo_triangle_unit_normal` guards `len_sq`, a
# cross product SQUARED and therefore degree FOUR in the caller's units, against
# a threshold for a degree-ONE quantity. Measured by deepening this very loop —
# correct through legs of 1e-76, fabricated (0,1,0) from 1e-77 down, which is
# exactly where sc^4 crosses DBL_MIN. Three sibling guards had the same shape.
# [measured: depth bisect of this loop, first bad decade 77 of 90]
#
# ⭐ 80 IS MEASURED, NOT CHOSEN. After the repair the first failing decade is 80,
# and that is ARITHMETIC rather than a guard: at sc = 1e-80 the quartic `len_sq`
# is 1e-320 — subnormal, ~12 mantissa bits left — so the normal it reconstructs
# is imprecise no matter what any threshold does. Running deeper would assert
# something false about doubles, not something true about this code.
# [measured: depth bisect of this loop, 77 before the repair, 80 after]
fn _sc_sweep() {
    var root_half = f64_div(F64_ONE, f64_sqrt(F64_TWO));
    for (var e = 0; e < 80; e = e + 1) {
        var sc = F64_ONE;
        for (var i = 0; i < e; i = i + 1) { sc = f64_div(sc, f64_from(10)); }

        # A right triangle with legs `sc` in the xy-plane: unit normal (0,0,1).
        var tri = geo_triangle_new(hvec3_new(0, 0, 0), hvec3_new(sc, 0, 0),
          hvec3_new(0, sc, 0));
        _SC_BAD = _SC_BAD + _sc_bad(HVec3_z(geo_triangle_unit_normal(tri)), F64_ONE);

        # ⚠ A DIAGONAL segment. An x-aligned one does NOT discriminate: the
        # degenerate fallback is hvec3_unit_x, which is the right answer there, so
        # the guard could fire and the assertion would still pass. Found while
        # writing this sweep -- the first draft used an x-aligned segment.
        var seg = geo_segment_new(hvec3_new(0, 0, 0), hvec3_new(sc, sc, 0));
        _SC_BAD = _SC_BAD + _sc_bad(HVec3_x(geo_segment_direction(seg)), root_half);

        # The midpoint of a segment is at distance 0 from it, at every scale.
        var mid = hvec3_scale(hvec3_new(sc, sc, 0), F64_HALF);
        _SC_BAD = _SC_BAD + _sc_bad(geo_segment_distance_to_point(seg, mid), 0);

        # Capsule (0,0,0)-(sc,0,0) radius sc/4, ray from (sc/2, 2sc, 0) straight
        # down: it hits the barrel at t = 2sc - sc/4 = 1.75sc.
        var cap = geo_capsule_new(hvec3_new(0, 0, 0), hvec3_new(sc, 0, 0),
          f64_div(sc, f64_from(4)));
        var cr = alloc(sizeof(GeoRay));
        GeoRay_set_origin(cr, hvec3_new(f64_div(sc, F64_TWO), f64_mul(F64_TWO, sc), 0));
        GeoRay_set_direction(cr, hvec3_new(0, f64_neg(F64_ONE), 0));
        _SC_BAD = _SC_BAD + _sc_bad(f64_div(geo_ray_capsule(cr, cap), sc),
          f64_div(f64_from(7), f64_from(4)));
    }
    return 0;
}

var _SF_BAD = 0;
var _SF_RUN = 0;
var _SF_HITS = 0;

# 1 when coordinate v lies outside [lo, hi] by more than a scale-relative slack.
fn _sf_outside(v, lo, hi) {
    var scale = f64_max(F64_ONE, f64_max(f64_abs(lo), f64_abs(hi)));
    var tol = f64_mul(scale, LOOSE_TOL_M);
    if (f64_lt(v, f64_sub(lo, tol)) == 1) { return 1; }
    if (f64_gt(v, f64_add(hi, tol)) == 1) { return 1; }
    return 0;
}

fn _sf_check(ray, box, t) {
    _SF_RUN = _SF_RUN + 1;
    if (t == 0) { return 0; }              # a miss makes no claim about a point
    _SF_HITS = _SF_HITS + 1;
    var p = geo_ray_at(ray, t);
    var lo = GeoAabb_min(box);
    var hi = GeoAabb_max(box);
    var bad = _sf_outside(HVec3_x(p), HVec3_x(lo), HVec3_x(hi));
    bad = bad + _sf_outside(HVec3_y(p), HVec3_y(lo), HVec3_y(hi));
    bad = bad + _sf_outside(HVec3_z(p), HVec3_z(lo), HVec3_z(hi));
    if (bad > 0) { return 1; }
    return 0;
}

fn _sf_sweep() {
    var box = geo_aabb_new(hvec3_new(0, 0, 0), hvec3_new(F64_ONE, F64_ONE, F64_ONE));
    var obb = geo_obb_new(hvec3_new(F64_HALF, F64_HALF, F64_HALF),
      hvec3_new(F64_HALF, F64_HALF, F64_HALF), hquat_identity());
    # ⚠ THE SWEEP RANGES OVER DIRECTION-COMPONENT MAGNITUDE, which is the axis
    # the defect lived on. A fixture at magnitude ~1 -- which is every other geo
    # fixture in this file -- cannot reach it at any number of samples.
    for (var e = 0; e < 18; e = e + 1) {
        var tiny = F64_ONE;
        for (var i = 0; i < e; i = i + 1) { tiny = f64_div(tiny, f64_from(10)); }
        # Start far enough back that the tiny component has room to matter: the
        # ray travels ~1/tiny before the z slab bites, so x drifts by
        # tiny * reach -- which is the whole mechanism, expressed as a fixture.
        var far = f64_div(F64_ONE, tiny);
        # ⚠ TWO DRIFTS, and the first draft had only the second. With reach =
        # 1/tiny the x drift is exactly 1.0, so the ray always exits the box on x
        # and every sample was a MISS -- 72 checks that asserted nothing about a
        # hit point, and the _SF_HITS counter is what said so. reach = 1/(4*tiny)
        # drifts 0.25 and lands inside, giving the surface invariant something to
        # be true of. The 1.0 case is kept: pre-2.10.2 it was reported as a HIT at
        # x = 1.5, which is the defect itself.
        for (var side = 0; side < 2; side = side + 1) {
            var comp = tiny;
            var reach = far;
            if (side == 1) { reach = f64_div(far, f64_from(4)); }
            var d = hvec3_new(comp, 0, F64_ONE);
            var o = hvec3_new(F64_HALF, F64_HALF, f64_neg(reach));
            var r = alloc(sizeof(GeoRay));
            GeoRay_set_origin(r, o);
            GeoRay_set_direction(r, d);
            _SF_BAD = _SF_BAD + _sf_check(r, box, geo_ray_aabb(r, box));
            # The identical box as an OBB: the two must not disagree either.
            var to = geo_ray_obb(r, obb);
            _SF_BAD = _SF_BAD + _sf_check(r, box, to);
            if (_sf_agree(geo_ray_aabb(r, box), to) == 0) { _SF_BAD = _SF_BAD + 1; }
        }
    }
    return 0;
}

# The same box expressed as an AABB and as an OBB must answer the same. Pre-2.10.2
# they used OPPOSITE comparison senses around EPSILON_F64, so a component equal to
# it took the slab branch in one and the parallel branch in the other: measured,
# aabb 0 against obb 4.5e12.
# [measured: docs/development/issues/archived/2026-08-10-slab-parallel-test-is-scale-free.md]
fn _sf_agree(ta, to) {
    if (ta == 0) { if (to == 0) { return 1; } return 0; }
    if (to == 0) { return 0; }
    var scale = f64_max(F64_ONE, f64_max(f64_abs(ta), f64_abs(to)));
    if (f64_lt(f64_abs(f64_sub(ta, to)), f64_mul(scale, LOOSE_TOL_M)) == 1) { return 1; }
    return 0;
}

var _DD_BAD = 0;
var _DD_RUN = 0;
fn _degen_bad(t) {
    _DD_RUN = _DD_RUN + 1;
    if (t == 0) { return 0; }
    return 1;
}

fn _degen_sweep() {
    var zero = hvec3_new(0, 0, 0);
    var bmin = hvec3_new(f64_neg(F64_ONE), f64_neg(F64_ONE), f64_neg(F64_ONE));
    var bmax = hvec3_new(F64_ONE, F64_ONE, F64_ONE);
    var ab  = geo_aabb_new(bmin, bmax);
    var ob  = geo_obb_new(zero, hvec3_new(F64_ONE, F64_ONE, F64_ONE), hquat_identity());
    var sph = geo_sphere_new(zero, F64_ONE);
    var pl  = geo_plane_from_point_normal(zero, hvec3_new(0, 0, F64_ONE));
    var tri = geo_triangle_new(hvec3_new(f64_neg(F64_ONE), f64_neg(F64_ONE), 0),
      hvec3_new(f64_from(3), f64_neg(F64_ONE), 0), hvec3_new(f64_neg(F64_ONE), f64_from(3), 0));
    var cap = geo_capsule_new(hvec3_new(0, 0, f64_neg(F64_ONE)),
      hvec3_new(0, 0, F64_ONE), F64_ONE);

    # Both origin positions: the +Inf path needed the origin INSIDE (outside,
    # the parallel-slab branch already returned 0), so a sweep that only ever
    # fired rays from outside would have reproduced nothing.
    for (var pi = 0; pi < 2; pi = pi + 1) {
        var o = zero;
        if (pi == 1) { o = hvec3_new(f64_from(9), f64_from(9), f64_from(9)); }
        var r = alloc(sizeof(GeoRay));
        GeoRay_set_origin(r, o);
        GeoRay_set_direction(r, hvec3_new(0, 0, 0));
        _DD_BAD = _DD_BAD + _degen_bad(geo_ray_aabb(r, ab));
        _DD_BAD = _DD_BAD + _degen_bad(geo_ray_obb(r, ob));
        _DD_BAD = _DD_BAD + _degen_bad(geo_ray_sphere(r, sph));
        _DD_BAD = _DD_BAD + _degen_bad(geo_ray_plane(r, pl));
        _DD_BAD = _DD_BAD + _degen_bad(geo_ray_triangle(r, tri));
        _DD_BAD = _DD_BAD + _degen_bad(geo_ray_capsule(r, cap));
    }
    return 0;
}

var _HG_BAD = 0;
var _HG_RUN = 0;
fn _homog_sweep() {
    var o = hvec3_new(f64_neg(f64_from(5)), f64_neg(f64_from(5)), f64_neg(f64_from(5)));
    var sph = geo_sphere_new(hvec3_new(0, 0, 0), F64_ONE);
    var pl  = geo_plane_from_point_normal(hvec3_new(0, 0, 0), hvec3_new(0, 0, F64_ONE));
    var tri = geo_triangle_new(hvec3_new(f64_neg(f64_from(9)), f64_neg(f64_from(9)), 0),
      hvec3_new(f64_from(9), f64_neg(f64_from(9)), 0), hvec3_new(0, f64_from(9), 0));
    var ab  = geo_aabb_new(hvec3_new(f64_neg(F64_ONE), f64_neg(F64_ONE), f64_neg(F64_ONE)),
      hvec3_new(F64_ONE, F64_ONE, F64_ONE));
    var ob  = geo_obb_new(hvec3_new(0, 0, 0), hvec3_new(F64_ONE, F64_ONE, F64_ONE), hquat_identity());
    var cap = geo_capsule_new(hvec3_new(0, 0, f64_neg(F64_ONE)), hvec3_new(0, 0, F64_ONE), F64_ONE);
    for (var ki = 0; ki < 3; ki = ki + 1) {
        var k = F64_TWO;
        if (ki == 1) { k = F64_HALF; }
        if (ki == 2) { k = f64_from(7); }
        var r = geo_ray_new(o, hvec3_new(F64_ONE, F64_ONE, F64_ONE));
        var du = GeoRay_direction(r);
        var ts = geo_ray_sphere(r, sph);   var tp = geo_ray_plane(r, pl);
        var tt = geo_ray_triangle(r, tri); var ta = geo_ray_aabb(r, ab);
        var to = geo_ray_obb(r, ob);       var tc = geo_ray_capsule(r, cap);
        GeoRay_set_direction(r, hvec3_scale(du, k));
        _HG_BAD = _HG_BAD + _homog_bad(ts, geo_ray_sphere(r, sph), k);
        _HG_BAD = _HG_BAD + _homog_bad(tp, geo_ray_plane(r, pl), k);
        _HG_BAD = _HG_BAD + _homog_bad(tt, geo_ray_triangle(r, tri), k);
        _HG_BAD = _HG_BAD + _homog_bad(ta, geo_ray_aabb(r, ab), k);
        _HG_BAD = _HG_BAD + _homog_bad(to, geo_ray_obb(r, ob), k);
        _HG_BAD = _HG_BAD + _homog_bad(tc, geo_ray_capsule(r, cap), k);
        _HG_RUN = _HG_RUN + 6;
    }
    return 0;
}

# --- 2.10.0: the analytic jets, checked against the SHIPPED primal ----------
#
# The oracle is central differences of `geo_ray_sphere` / `geo_ray_plane`
# themselves, so the jet is checked against the function it claims to
# differentiate rather than against a second implementation that could share a
# mistake with it.
#
# ⚠ EVERY FD PROBE OVER THESE ROUTINES MUST REJECT THE MISS SENTINEL. A perturbed
# ray can fall off the surface; `geo_ray_*` then returns 0, and differencing that
# against a real hit yields t/(2h) -- with h = 1e-6 that is ~1e6, which looks
# exactly like a catastrophic gradient error. A first draft of this check
# reported a relative error of 267,260 on `geo_ray_triangle` for precisely that
# reason, and the routine was correct.
# [measured: docs/development/issues/archived/2026-08-10-ray-sphere-capsule-assume-unit-direction.md]
var _JT_BAD = 0;
var _JT_RUN = 0;
var _JT_H = 0x3EB0C6F7A0B5ED8D;   # 1e-6
var _GEO_JT_SKIP = 0x7FF8000000000000;   # quiet NaN, used as "sample rejected"

fn _jt_close(a, b) {
    var scale = f64_max(F64_ONE, f64_max(f64_abs(a), f64_abs(b)));
    if (f64_lt(f64_abs(f64_sub(a, b)), f64_mul(0x3EE4F8B588E368F1, scale)) == 1) { return 1; }
    return 0;
}

# central difference of t w.r.t. component `i` of whichever input `which` selects
fn _jt_fd_sphere(o, d, c, r, which, i) {
    var lo = 0;
    var hi = 0;
    for (var side = 0; side < 2; side = side + 1) {
        var h = _JT_H;
        if (side == 0) { h = f64_neg(_JT_H); }
        var oo = o; var dd = d; var cc = c; var rr = r;
        if (which == 0) { oo = _jt_bump(o, i, h); }
        if (which == 1) { dd = _jt_bump(d, i, h); }
        if (which == 2) { cc = _jt_bump(c, i, h); }
        if (which == 3) { rr = f64_add(r, h); }
        var ray = geo_ray_new(oo, dd);
        GeoRay_set_direction(ray, dd);          # keep the perturbation unnormalised
        var tv = geo_ray_sphere(ray, geo_sphere_new(cc, rr));
        if (side == 0) { lo = tv; } else { hi = tv; }
    }
    if (lo == 0) { return _GEO_JT_SKIP; }
    if (hi == 0) { return _GEO_JT_SKIP; }
    return f64_div(f64_sub(hi, lo), f64_mul(F64_TWO, _JT_H));
}

fn _jt_bump(v, i, h) {
    var x = HVec3_x(v); var y = HVec3_y(v); var z = HVec3_z(v);
    if (i == 0) { x = f64_add(x, h); }
    if (i == 1) { y = f64_add(y, h); }
    if (i == 2) { z = f64_add(z, h); }
    return hvec3_new(x, y, z);
}

fn _jt_cmp(got, fdv) {
    if (f64_eq(fdv, fdv) == 0) { return 0; }     # NaN => sample rejected
    _JT_RUN = _JT_RUN + 1;
    if (_jt_close(got, fdv) == 1) { return 0; }
    return 1;
}

fn _jt_sphere_sweep() {
    # Origins on a shell around the unit sphere at the origin, each aimed AT a
    # small offset target so the ray genuinely hits and the hit is not exactly
    # head-on (a head-on hit makes two of the three gradient components zero,
    # which would let a wrong sign hide).
    var oc = alloc(64);
    store64(oc,      hvec3_new(f64_neg(f64_from(4)), 0, 0));
    store64(oc + 8,  hvec3_new(f64_neg(f64_from(3)), F64_TWO, F64_ONE));
    store64(oc + 16, hvec3_new(F64_ONE, f64_neg(f64_from(5)), F64_TWO));
    store64(oc + 24, hvec3_new(F64_TWO, F64_TWO, f64_neg(f64_from(4))));
    var tg = alloc(64);
    store64(tg,      hvec3_new(0, f64_div(F64_ONE, f64_from(4)), 0));
    store64(tg + 8,  hvec3_new(f64_div(F64_ONE, f64_from(8)), 0, f64_div(F64_ONE, f64_from(4))));
    store64(tg + 16, hvec3_new(0, 0, f64_div(F64_ONE, f64_from(8))));
    store64(tg + 24, hvec3_new(f64_div(F64_ONE, f64_from(4)), f64_div(F64_ONE, f64_from(8)), 0));
    for (var oi = 0; oi < 4; oi = oi + 1) {
        for (var ti = 0; ti < 4; ti = ti + 1) {
            var o = load64(oc + oi * 8);
            var d = hvec3_normalize(hvec3_sub(load64(tg + ti * 8), o));
            var c = hvec3_new(0, 0, 0);
            # ⚠ RADIUS MUST NOT BE 1. dt/dradius is r/(g.d), so at r = 1 it is
            # indistinguishable from 1/(g.d) and a mutant that drops the radius
            # factor entirely passes the whole sweep -- measured, it did. Two
            # radii, neither 1, so the factor is load-bearing in the fixture.
            # [measured: scratch mutation run, not reproducible in-tree]
            var r = f64_div(f64_from(3), F64_TWO);
            if (ti % 2 == 1) { r = f64_div(F64_ONE, F64_TWO); }
            var ray = geo_ray_new(o, d);
            var j = geo_jet_sphere(ray, geo_sphere_new(c, r));
            if (geo_jet_hit(j) == 1) {
                for (var k = 0; k < 3; k = k + 1) {
                    _JT_BAD = _JT_BAD + _jt_cmp(_jt_comp(geo_jet_dorigin(j), k),
                      _jt_fd_sphere(o, d, c, r, 0, k));
                    _JT_BAD = _JT_BAD + _jt_cmp(_jt_comp(geo_jet_ddirection(j), k),
                      _jt_fd_sphere(o, d, c, r, 1, k));
                    _JT_BAD = _JT_BAD + _jt_cmp(_jt_comp(geo_jet_sphere_dcenter(j), k),
                      _jt_fd_sphere(o, d, c, r, 2, k));
                }
                _JT_BAD = _JT_BAD + _jt_cmp(geo_jet_sphere_dradius(j),
                  _jt_fd_sphere(o, d, c, r, 3, 0));
            }
        }
    }
    return 0;
}

fn _jt_comp(v, i) {
    if (i == 0) { return HVec3_x(v); }
    if (i == 1) { return HVec3_y(v); }
    return HVec3_z(v);
}

# --- 2.10.1: geo_jet_aabb against central differences of the shipped primal ---
#
# which: 0 = ray origin, 1 = ray direction, 2 = box min, 3 = box max.
fn _jt_fd_aabb(o, d, bmin, bmax, which, i) {
    var lo = 0;
    var hi = 0;
    for (var side = 0; side < 2; side = side + 1) {
        var h = _JT_H;
        if (side == 0) { h = f64_neg(_JT_H); }
        var oo = o; var dd = d; var mn = bmin; var mx = bmax;
        if (which == 0) { oo = _jt_bump(o, i, h); }
        if (which == 1) { dd = _jt_bump(d, i, h); }
        if (which == 2) { mn = _jt_bump(bmin, i, h); }
        if (which == 3) { mx = _jt_bump(bmax, i, h); }
        var ray = geo_ray_new(oo, dd);
        GeoRay_set_direction(ray, dd);          # keep the perturbation unnormalised
        # ⚠ geo_aabb_new applies hvec3_min/hvec3_max to its two corners, so
        # perturbing "min" cannot be tested through it -- it would silently
        # re-sort. The struct is written directly so the perturbed corner stays
        # the corner it was.
        var box = alloc(sizeof(GeoAabb));
        GeoAabb_set_min(box, mn);
        GeoAabb_set_max(box, mx);
        var tv = geo_ray_aabb(ray, box);
        if (side == 0) { lo = tv; } else { hi = tv; }
    }
    if (lo == 0) { return _GEO_JT_SKIP; }
    if (hi == 0) { return _GEO_JT_SKIP; }
    return f64_div(f64_sub(hi, lo), f64_mul(F64_TWO, _JT_H));
}

var _JA_FACES = 0;      # bitmask of which of the 6 faces the sweep actually hit
var _JO_FACES = 0;      # ditto, for the OBB
var _JC_BRANCH = 0;     # bitmask of the capsule BRANCHES the sweep exercised

# which: 0 = origin, 1 = direction, 2 = start, 3 = end, 4 = radius.
fn _jt_fd_capsule(o, d, ca, cb, r, which, i) {
    var lo = 0;
    var hi = 0;
    for (var side = 0; side < 2; side = side + 1) {
        var h = _JT_H;
        if (side == 0) { h = f64_neg(_JT_H); }
        var oo = o; var dd = d; var aa = ca; var bb = cb; var rr = r;
        if (which == 0) { oo = _jt_bump(o, i, h); }
        if (which == 1) { dd = _jt_bump(d, i, h); }
        if (which == 2) { aa = _jt_bump(ca, i, h); }
        if (which == 3) { bb = _jt_bump(cb, i, h); }
        if (which == 4) { rr = f64_add(r, h); }
        var ray = geo_ray_new(oo, dd);
        GeoRay_set_direction(ray, dd);
        var tv = geo_ray_capsule(ray, geo_capsule_new(aa, bb, rr));
        if (side == 0) { lo = tv; } else { hi = tv; }
    }
    if (lo == 0) { return _GEO_JT_SKIP; }
    if (hi == 0) { return _GEO_JT_SKIP; }
    return f64_div(f64_sub(hi, lo), f64_mul(F64_TWO, _JT_H));
}

fn _jt_capsule_sweep() {
    var ca = hvec3_new(0, 0, 0);
    var cb = hvec3_new(0, 0, f64_from(3));
    # ⚠ RADIUS MUST NOT BE 1 -- dt/dradius is r/den, and at r = 1 a mutant that
    # drops the radius factor is indistinguishable. That mutant SURVIVED the
    # first draft of the 2.10.0 sphere fixture; the lesson is applied up front here.
    var r = f64_div(f64_from(3), F64_TWO);
    var cap = geo_capsule_new(ca, cb, r);

    # Origins chosen to reach all three branches. Barrel: side-on at mid height.
    # Start cap: below z = 0 aiming up. End cap: above z = 3 aiming down. The
    # branch bitmask below asserts they actually did, rather than trusting this
    # comment -- a fixture that only ever hits the barrel proves nothing about the
    # caps, and the caps are where 2.10.0's defect lived.
    var oc = alloc(64);
    store64(oc,      hvec3_new(f64_neg(f64_from(6)), f64_div(F64_ONE, f64_from(4)),
        f64_div(f64_from(3), F64_TWO)));
    store64(oc + 8,  hvec3_new(f64_from(5), f64_neg(F64_ONE), F64_ONE));
    store64(oc + 16, hvec3_new(f64_div(F64_ONE, f64_from(4)), f64_div(F64_ONE, f64_from(8)),
        f64_neg(f64_from(7))));
    store64(oc + 24, hvec3_new(f64_neg(F64_ONE), f64_div(F64_ONE, f64_from(4)), f64_from(9)));
    store64(oc + 32, hvec3_new(f64_from(4), f64_from(4), f64_neg(f64_from(4))));
    var tg = alloc(64);
    store64(tg,      hvec3_new(0, 0, f64_div(f64_from(3), F64_TWO)));
    store64(tg + 8,  hvec3_new(0, 0, F64_TWO));
    store64(tg + 16, hvec3_new(0, 0, f64_neg(f64_div(F64_ONE, F64_TWO))));
    store64(tg + 24, hvec3_new(0, 0, f64_add(f64_from(3), f64_div(F64_ONE, F64_TWO))));
    store64(tg + 32, hvec3_new(0, 0, 0));

    for (var oi = 0; oi < 5; oi = oi + 1) {
        var o = load64(oc + oi * 8);
        var d = hvec3_sub(load64(tg + oi * 8), o);
        var ray = geo_ray_new(o, d);
        GeoRay_set_direction(ray, d);
        var j = geo_jet_capsule(ray, cap);
        if (geo_jet_hit(j) == 1) {
            _JC_BRANCH = _JC_BRANCH | (1 << geo_jet_face(j));
            for (var k = 0; k < 3; k = k + 1) {
                _JT_BAD = _JT_BAD + _jt_cmp(_jt_comp(geo_jet_dorigin(j), k),
                  _jt_fd_capsule(o, d, ca, cb, r, 0, k));
                _JT_BAD = _JT_BAD + _jt_cmp(_jt_comp(geo_jet_ddirection(j), k),
                  _jt_fd_capsule(o, d, ca, cb, r, 1, k));
                _JT_BAD = _JT_BAD + _jt_cmp(_jt_comp(geo_jet_capsule_dstart(j), k),
                  _jt_fd_capsule(o, d, ca, cb, r, 2, k));
                _JT_BAD = _JT_BAD + _jt_cmp(_jt_comp(geo_jet_capsule_dend(j), k),
                  _jt_fd_capsule(o, d, ca, cb, r, 3, k));
            }
            _JT_BAD = _JT_BAD + _jt_cmp(geo_jet_capsule_dradius(j),
              _jt_fd_capsule(o, d, ca, cb, r, 4, 0));
        }
    }
    return 0;
}

# which: 0 = ray origin, 1 = ray direction, 2 = box centre, 3 = half-extents.
fn _jt_fd_obb(o, d, c, he, q, which, i) {
    var lo = 0;
    var hi = 0;
    for (var side = 0; side < 2; side = side + 1) {
        var h = _JT_H;
        if (side == 0) { h = f64_neg(_JT_H); }
        var oo = o; var dd = d; var cc = c; var hh = he;
        if (which == 0) { oo = _jt_bump(o, i, h); }
        if (which == 1) { dd = _jt_bump(d, i, h); }
        if (which == 2) { cc = _jt_bump(c, i, h); }
        if (which == 3) { hh = _jt_bump(he, i, h); }
        var ray = geo_ray_new(oo, dd);
        GeoRay_set_direction(ray, dd);
        var tv = geo_ray_obb(ray, geo_obb_new(cc, hh, q));
        if (side == 0) { lo = tv; } else { hi = tv; }
    }
    if (lo == 0) { return _GEO_JT_SKIP; }
    if (hi == 0) { return _GEO_JT_SKIP; }
    return f64_div(f64_sub(hi, lo), f64_mul(F64_TWO, _JT_H));
}

# --- 2.10.2: dt/d(rotation) against central differences of the primal --------
#
# 2.10.1 deferred this partial, and its stated objection was right: a FREE
# perturbation of an axis leaves the rotation group, so an FD across it measures
# nothing. The fix is to perturb WITHIN the group -- pre-multiply the OBB's
# quaternion by a small rotation about a world axis -- which is what this does.
# The analytic form is dt/dw = [a_k x (c - p)] / f_k, derived from
# a_k -> a_k + w x a_k and the scalar triple product.
var _JR_BAD = 0;
var _JR_RUN = 0;

fn _jt_fd_obb_rot(o, d, c, he, q, i) {
    var ax = hvec3_unit_x();
    if (i == 1) { ax = hvec3_unit_y(); }
    if (i == 2) { ax = hvec3_unit_z(); }
    var lo = 0;
    var hi = 0;
    for (var side = 0; side < 2; side = side + 1) {
        var ang = _JT_H;
        if (side == 0) { ang = f64_neg(_JT_H); }
        var qp_t, qp = hquat_normalize_checked(hquat_mul(hquat_from_axis_angle(ax, ang), q));
        var ray = alloc(sizeof(GeoRay));
        GeoRay_set_origin(ray, o);
        GeoRay_set_direction(ray, d);
        var tv = geo_ray_obb(ray, geo_obb_new(c, he, qp));
        if (side == 0) { lo = tv; } else { hi = tv; }
    }
    if (lo == 0) { return _GEO_JT_SKIP; }
    if (hi == 0) { return _GEO_JT_SKIP; }
    return f64_div(f64_sub(hi, lo), f64_mul(F64_TWO, _JT_H));
}

fn _jt_obb_rot_sweep() {
    # ⚠ The box MUST be rotated and the aim MUST be off-centre. A head-on hit
    # zeroes two of the three gradient components, and the first draft of this
    # fixture aimed straight at the centre from four hand-picked directions --
    # three of the four MISSED, leaving three comparisons total.
    var q = hquat_from_axis_angle(hvec3_normalize(hvec3_new(F64_ONE, F64_TWO, f64_from(3))),
      f64_div(f64_from(3), f64_from(5)));
    var c = hvec3_new(F64_ONE, f64_neg(F64_TWO), f64_div(F64_ONE, F64_TWO));
    var he = hvec3_new(f64_div(f64_from(3), F64_TWO), F64_ONE, F64_TWO);
    var obb = geo_obb_new(c, he, q);
    var aim = hvec3_add(c, hvec3_new(f64_div(F64_ONE, f64_from(4)),
        f64_neg(f64_div(F64_ONE, f64_from(8))), f64_div(F64_ONE, f64_from(6))));
    var oc = alloc(64);
    store64(oc,      hvec3_new(f64_neg(f64_from(9)), F64_ONE, F64_TWO));
    store64(oc + 8,  hvec3_new(f64_from(9), f64_neg(F64_ONE), F64_TWO));
    store64(oc + 16, hvec3_new(F64_TWO, f64_from(9), 0));
    store64(oc + 24, hvec3_new(0, f64_neg(f64_from(9)), f64_from(3)));
    store64(oc + 32, hvec3_new(F64_ONE, F64_TWO, f64_from(9)));
    store64(oc + 40, hvec3_new(f64_neg(F64_TWO), 0, f64_neg(f64_from(9))));
    store64(oc + 48, hvec3_new(f64_from(7), f64_from(6), f64_neg(f64_from(5))));
    store64(oc + 56, hvec3_new(f64_neg(f64_from(4)), f64_from(8), f64_from(6)));
    for (var oi = 0; oi < 8; oi = oi + 1) {
        var o = load64(oc + oi * 8);
        var d = hvec3_sub(aim, o);
        var ray = alloc(sizeof(GeoRay));
        GeoRay_set_origin(ray, o);
        GeoRay_set_direction(ray, d);
        var j = geo_jet_obb(ray, obb);
        if (geo_jet_hit(j) == 1) {
            for (var k = 0; k < 3; k = k + 1) {
                _JR_RUN = _JR_RUN + 1;
                var fd = _jt_fd_obb_rot(o, d, c, he, q, k);
                if (f64_eq(fd, fd) == 1) {
                    if (_jt_close(_jt_comp(geo_jet_obb_drotation(j), k), fd) == 0) {
                        _JR_BAD = _JR_BAD + 1;
                    }
                }
            }
        }
    }
    return 0;
}

fn _jt_obb_sweep() {
    # ⚠ THE BOX MUST BE ROTATED. Under the identity quaternion the local axes are
    # the world axes, and an axis mix-up between the face encoding and the
    # gradient is invisible -- the two happen to agree. Rotated about (1,1,1) by
    # ~0.6 rad, all three local axes are distinct from all three world axes.
    var q = hquat_from_axis_angle(hvec3_normalize(hvec3_new(F64_ONE, F64_ONE, F64_ONE)),
      f64_div(f64_from(3), f64_from(5)));
    var c = hvec3_new(F64_ONE, f64_neg(F64_TWO), f64_div(F64_ONE, F64_TWO));
    # Not a cube: dt/dhalf_extents picks out one component, and equal extents
    # would let a wrong component pass.
    var he = hvec3_new(f64_div(f64_from(3), F64_TWO), F64_ONE, f64_from(2));
    var obb = geo_obb_new(c, he, q);
    var axes = geo_obb_axes(obb);

    for (var oi = 0; oi < 7; oi = oi + 1) {
        # Six origins, one beyond each LOCAL face, aimed back at the centre, so
        # every (axis, plane) encoding is exercised. oi = 6 starts INSIDE, which
        # returns t_max and the exit face -- the other core branch.
        var o = c;
        var d = hvec3_new(F64_TWO, F64_ONE, f64_div(F64_ONE, f64_from(3)));
        if (oi < 6) {
            var ax = load64(axes + (oi / 2) * 8);
            var reach = f64_from(9);
            if (oi % 2 == 0) { reach = f64_neg(reach); }
            o = hvec3_add(c, hvec3_scale(ax, reach));
            d = hvec3_sub(c, o);
        }
        var ray = geo_ray_new(o, d);
        GeoRay_set_direction(ray, d);
        var j = geo_jet_obb(ray, obb);
        if (geo_jet_hit(j) == 1) {
            _JO_FACES = _JO_FACES | (1 << geo_jet_face(j));
            for (var k = 0; k < 3; k = k + 1) {
                _JT_BAD = _JT_BAD + _jt_cmp(_jt_comp(geo_jet_dorigin(j), k),
                  _jt_fd_obb(o, d, c, he, q, 0, k));
                _JT_BAD = _JT_BAD + _jt_cmp(_jt_comp(geo_jet_ddirection(j), k),
                  _jt_fd_obb(o, d, c, he, q, 1, k));
                _JT_BAD = _JT_BAD + _jt_cmp(_jt_comp(geo_jet_obb_dcenter(j), k),
                  _jt_fd_obb(o, d, c, he, q, 2, k));
                _JT_BAD = _JT_BAD + _jt_cmp(_jt_comp(geo_jet_obb_dhalf_extents(j), k),
                  _jt_fd_obb(o, d, c, he, q, 3, k));
            }
        }
    }
    return 0;
}

fn _jt_aabb_sweep() {
    # A box that is NOT centred at the origin and NOT a cube, so dt/dmin and
    # dt/dmax are numerically distinguishable and an axis mix-up cannot hide
    # behind symmetry.
    var bmin = hvec3_new(f64_neg(F64_ONE), f64_neg(F64_TWO), f64_div(F64_ONE, F64_TWO));
    var bmax = hvec3_new(f64_from(3), F64_ONE, f64_from(4));
    var box = geo_aabb_new(bmin, bmax);
    var cen = geo_aabb_center(box);

    # Six origins, one well outside each face, each aimed at the box centre so the
    # ray enters through THAT face -- all six (axis, plane) encodings exercised.
    # A sweep that only ever hits +x would pass with the axis mapping wrong.
    var oc = alloc(64);
    store64(oc,      hvec3_new(f64_neg(f64_from(9)), 0, F64_TWO));
    store64(oc + 8,  hvec3_new(f64_from(11), 0, F64_TWO));
    store64(oc + 16, hvec3_new(F64_ONE, f64_neg(f64_from(9)), F64_TWO));
    store64(oc + 24, hvec3_new(F64_ONE, f64_from(9), F64_TWO));
    store64(oc + 32, hvec3_new(F64_ONE, 0, f64_neg(f64_from(9))));
    store64(oc + 40, hvec3_new(F64_ONE, 0, f64_from(12)));

    for (var oi = 0; oi < 7; oi = oi + 1) {
        # oi = 6 is the origin INSIDE the box: the primal then returns t_max and
        # the EXIT face, a different branch of the core. Without it a mutant that
        # reports the entry face on the inside path survives -- and that mutant is
        # exactly what the two-face-register design risks.
        var o = cen;
        var d = hvec3_new(F64_TWO, F64_ONE, f64_div(F64_ONE, f64_from(3)));
        if (oi < 6) {
            o = load64(oc + oi * 8);
            d = hvec3_sub(cen, o);
        }
        var ray = geo_ray_new(o, d);
        GeoRay_set_direction(ray, d);
        var j = geo_jet_aabb(ray, box);
        if (geo_jet_hit(j) == 1) {
            var f = geo_jet_face(j);
            _JA_FACES = _JA_FACES | (1 << f);
            for (var k = 0; k < 3; k = k + 1) {
                _JT_BAD = _JT_BAD + _jt_cmp(_jt_comp(geo_jet_dorigin(j), k),
                  _jt_fd_aabb(o, d, bmin, bmax, 0, k));
                _JT_BAD = _JT_BAD + _jt_cmp(_jt_comp(geo_jet_ddirection(j), k),
                  _jt_fd_aabb(o, d, bmin, bmax, 1, k));
                _JT_BAD = _JT_BAD + _jt_cmp(_jt_comp(geo_jet_aabb_dmin(j), k),
                  _jt_fd_aabb(o, d, bmin, bmax, 2, k));
                _JT_BAD = _JT_BAD + _jt_cmp(_jt_comp(geo_jet_aabb_dmax(j), k),
                  _jt_fd_aabb(o, d, bmin, bmax, 3, k));
            }
        }
    }
    return 0;
}

test_group("2.10.0 geo_jet_sphere: every gradient matches central differences of the primal");
_jt_sphere_sweep();
assert_gt(_JT_RUN, 40, "the sphere jet sweep actually compared a useful number of samples");
assert_eq(_JT_BAD, 0, "geo_jet_sphere: dt/do, dt/dd, dt/dcenter, dt/dradius all match FD");

test_group("2.10.1 geo_jet_aabb: every gradient matches central differences of the primal");
_jt_aabb_sweep();
assert_gt(_JT_RUN, 100, "the aabb jet sweep actually compared a useful number of samples");
assert_eq(_JT_BAD, 0, "geo_jet_aabb: dt/do, dt/dd, dt/dmin, dt/dmax all match FD");
# ⚠ FIXTURE DISCRIMINATION, asserted rather than assumed. All six (axis, plane)
# encodings must actually occur, or a wrong axis mapping passes on the faces the
# sweep happens to miss. 0x3F is faces 0..5.
assert_eq(_JA_FACES, 0x3F, "the aabb jet sweep hit all six faces, not a subset");

# ⚠ EDGES AND CORNERS: the primal still answers, the JET must not.
# `t` has a genuine kink where two slabs tie -- the selected face differs on
# either side, so the gradient does too -- and returning whichever side the
# f64_max happened to land on would be a silent wrong number. This is the same
# convention geo_jet_sphere uses at grazing incidence.
#
# Both fixtures tie EXACTLY in floating point, not approximately: the arithmetic
# is (-1 - -2)/1 on each axis, which is 1.0 with no rounding. An approximate tie
# is a near-edge hit, which IS differentiable and is correctly not reported.
var jab = geo_aabb_new(hvec3_new(f64_neg(F64_ONE), f64_neg(F64_ONE), f64_neg(F64_ONE)),
  hvec3_new(F64_ONE, F64_ONE, F64_ONE));
var j_edge = geo_ray_new(hvec3_new(f64_neg(F64_TWO), f64_neg(F64_TWO), 0),
  hvec3_new(F64_ONE, F64_ONE, 0));
GeoRay_set_direction(j_edge, hvec3_new(F64_ONE, F64_ONE, 0));
assert_eq(geo_ray_aabb(j_edge, jab), F64_ONE,
  "aabb edge hit: the PRIMAL still returns t = 1, so the jet is refusing a real hit");
assert_eq(geo_jet_hit(geo_jet_aabb(j_edge, jab)), 0,
  "geo_jet_aabb on an exact EDGE returns the miss sentinel, not one side's gradient");

var j_corner = geo_ray_new(hvec3_new(f64_neg(F64_TWO), f64_neg(F64_TWO), f64_neg(F64_TWO)),
  hvec3_new(F64_ONE, F64_ONE, F64_ONE));
GeoRay_set_direction(j_corner, hvec3_new(F64_ONE, F64_ONE, F64_ONE));
assert_eq(geo_ray_aabb(j_corner, jab), F64_ONE, "aabb corner hit: the PRIMAL still returns t = 1");
assert_eq(geo_jet_hit(geo_jet_aabb(j_corner, jab)), 0,
  "geo_jet_aabb on an exact CORNER returns the miss sentinel");

# ⚠ TWO MORE WAYS TO TIE, and both shipped WRONG in 2.10.1's first draft. They
# were found by an independent derivation commissioned against the finished
# code, not by this suite -- recorded because that is the whole reason the check
# was commissioned, and because both are ways an edge hides that "two slabs
# achieve the extremum" does not describe.
#
# (1) ZERO-WIDTH SLAB. With min_k == max_k the two faces of that axis coincide,
#     so t1 == t2 and the primal's swap never runs (f64_gt is false on equality).
#     The face was therefore labelled the MIN slot unconditionally -- correct only
#     when d_k > 0. MEASURED on the draft: flat box, d_x = -1, the jet reported
#     dt/dmin_x = -1 and dt/dmax_x = 0 where the one-sided truth is the exact
#     reverse. Half of all flat-box configurations, with tie = 0 asserting
#     differentiability. It is reported as a tie rather than relabelled because t
#     is genuinely not two-sided differentiable there: widening min and widening
#     max give different answers and a central difference averages them to 0.5.
#     ⚠ The per-slab guard first written for this was DELETED as dead code: a
#     zero-width slab pins t_min and t_max to the same value, so the tangential
#     guard below already covers it. Mutation-measured — removing the per-slab
#     guard changed nothing, removing the tangential one broke both fixtures.
#     [measured: docs/development/issues/archived/2026-08-10-jet-tie-blind-to-degenerate-slabs.md]
var jfb = alloc(sizeof(GeoAabb));
GeoAabb_set_min(jfb, hvec3_new(0, 0, 0));
GeoAabb_set_max(jfb, hvec3_new(0, F64_ONE, F64_ONE));   # ZERO x extent
for (var fs = 0; fs < 2; fs = fs + 1) {
    var fo = hvec3_new(F64_ONE, F64_HALF, F64_HALF);
    var fd = hvec3_new(f64_neg(F64_ONE), 0, 0);
    if (fs == 1) {
        fo = hvec3_new(f64_neg(F64_ONE), F64_HALF, F64_HALF);
        fd = hvec3_new(F64_ONE, 0, 0);
    }
    var fr = alloc(sizeof(GeoRay));
    GeoRay_set_origin(fr, fo);
    GeoRay_set_direction(fr, fd);
    # BOTH directions asserted: the d_x > 0 case was already right by luck, so a
    # fixture testing only that one passes on the broken code.
    assert_eq(geo_ray_aabb(fr, jfb), F64_ONE,
      "flat-box fixture: the PRIMAL returns t = 1, so the jet is refusing a real hit");
    assert_eq(geo_jet_hit(geo_jet_aabb(fr, jfb)), 0,
      "geo_jet_aabb on a ZERO-WIDTH slab returns the miss sentinel, either direction");
}

# (2) TANGENTIAL CLIP, t_min == t_max with DIFFERENT slabs owning the two ends.
#     The ray grazes: entry and exit coincide and the hit sits on the BOUNDARY of
#     the hit set, where an arbitrarily small sideways perturbation makes it a
#     miss. The per-slab tie cannot see this -- it compares near against near and
#     far against far, never t_min against t_max.
#
# ⚠ THE FIRST FIXTURE WRITTEN FOR THIS WAS NOT TANGENTIAL AT ALL. Origin
# (-1, 2, 0.5) with direction (1, -1, 0) gives t_min = 1, t_max = 2 -- an
# ordinary EDGE hit, already covered by the per-slab tie. It passed, which is
# exactly the failure mode: a fixture that tests something already tested and
# reads as though it tested something new. The fixture below is the real thing:
# x owns t_min = 1, y owns t_max = 1, and neither slab ties against the running
# value, so removing the t_min == t_max guard flips it to a confident gradient.
# Measured both ways before this comment was written.
# [measured: docs/development/issues/archived/2026-08-10-jet-tie-blind-to-degenerate-slabs.md]
var jub = geo_aabb_new(hvec3_new(0, 0, 0), hvec3_new(F64_ONE, F64_ONE, F64_ONE));
var jtc = alloc(sizeof(GeoRay));
GeoRay_set_origin(jtc, hvec3_new(f64_neg(F64_ONE), F64_ONE, F64_HALF));
GeoRay_set_direction(jtc, hvec3_new(F64_ONE, f64_neg(F64_ONE), 0));
assert_eq(geo_ray_aabb(jtc, jub), F64_ONE,
  "tangential-clip fixture: the PRIMAL returns t = 1, so the jet is refusing a real hit");
assert_eq(geo_jet_hit(geo_jet_aabb(jtc, jub)), 0,
  "geo_jet_aabb on a TANGENTIAL clip (t_min == t_max, different slabs) returns the miss sentinel");

# The OBB carries both guards too -- he_k == 0 is its zero-width slab.
var jfo = geo_obb_new(hvec3_new(0, 0, 0), hvec3_new(0, F64_ONE, F64_ONE), hquat_identity());
for (var os = 0; os < 2; os = os + 1) {
    var oo = hvec3_new(F64_TWO, 0, 0);
    var od = hvec3_new(f64_neg(F64_ONE), 0, 0);
    if (os == 1) { oo = hvec3_new(f64_neg(F64_TWO), 0, 0); od = hvec3_new(F64_ONE, 0, 0); }
    var orr = alloc(sizeof(GeoRay));
    GeoRay_set_origin(orr, oo);
    GeoRay_set_direction(orr, od);
    assert_eq(geo_ray_obb(orr, jfo), F64_TWO, "flat-OBB fixture: the PRIMAL returns t = 2");
    assert_eq(geo_jet_hit(geo_jet_obb(orr, jfo)), 0,
      "geo_jet_obb on a ZERO half-extent returns the miss sentinel, either direction");
}

# And the wrapper equivalence the whole split rests on: geo_ray_aabb must return
# EXACTLY what geo_ray_aabb_face does, bit for bit, on the same input. Asserted
# on a face-crossing ray rather than a trivial one.
var jwo = alloc(GEO_FACE_OUT_BYTES);
var jwr = geo_ray_new(hvec3_new(f64_neg(f64_from(4)), f64_div(F64_ONE, F64_TWO), f64_from(3)),
  hvec3_new(F64_TWO, f64_neg(F64_ONE), f64_neg(F64_TWO)));
assert_eq(geo_ray_aabb(jwr, jab), geo_ray_aabb_face(jwr, jab, jwo),
  "geo_ray_aabb is bit-identical to geo_ray_aabb_face with out = 0");

test_group("3.3.5 geo_diff: geo_jet_aabb at a zero t");
var _g435_j = geo_jet_aabb(geo_ray_new(hvec3_new(0, F64_HALF, F64_HALF), hvec3_unit_x()),
  geo_aabb_new(hvec3_zero(), hvec3_one()));
assert_eq(geo_jet_kind(_g435_j), GEO_JET_MISS,
  "geo_jet_aabb: origin ON the x-min face (primal t = +0.0, face 0): the miss jet");
assert_eq(geo_jet_face(_g435_j), GEO_FACE_NONE, "geo_jet_aabb: ... carrying GEO_FACE_NONE, not face 0");

test_group("2.10.1 geo_jet_obb: every gradient matches central differences of the primal");
_jt_obb_sweep();
assert_eq(_JT_BAD, 0, "geo_jet_obb: dt/do, dt/dd, dt/dcenter, dt/dhalf_extents all match FD");
assert_gt(_JT_RUN, 180, "the obb jet sweep added its own comparisons on top of the aabb ones");
assert_eq(_JO_FACES, 0x3F, "the obb jet sweep hit all six LOCAL faces, not a subset");

test_group("2.10.2 geo_jet_obb dt/d(rotation): matches central differences of the primal");
_jt_obb_rot_sweep();
assert_gt(_JR_RUN, 20, "the rotation-gradient sweep compared a useful number of samples");
assert_eq(_JR_BAD, 0,
  "dt/dw == [a_k x (c - p)] / f_k, checked by perturbing the quaternion WITHIN the rotation group");

var jwo2 = alloc(GEO_FACE_OUT_BYTES);
var job = geo_obb_new(hvec3_new(0, 0, 0), hvec3_new(F64_ONE, F64_TWO, F64_ONE),
  hquat_from_axis_angle(hvec3_unit_y(), f64_div(F64_ONE, F64_TWO)));
var jwr2 = geo_ray_new(hvec3_new(f64_neg(f64_from(4)), f64_div(F64_ONE, F64_TWO), f64_from(3)),
  hvec3_new(F64_TWO, f64_neg(F64_ONE), f64_neg(F64_TWO)));
assert_eq(geo_ray_obb(jwr2, job), geo_ray_obb_face(jwr2, job, jwo2),
  "geo_ray_obb is bit-identical to geo_ray_obb_face with out = 0");

# OBB edges and corners, same contract as the AABB. ⚠ THIS FIXTURE USES THE
# IDENTITY ROTATION ON PURPOSE, which is exactly what the FD sweep above forbids
# -- for a different reason. There the rotation must be non-trivial so an axis
# mix-up cannot hide; here the point is an EXACT floating-point tie, and only
# axis-aligned arithmetic ((1,0,0).(2,2,0) - 1)/1 = 1.0 gives one with no
# rounding. A rotated box ties only approximately, which is a NEAR-edge hit --
# differentiable, and correctly not reported. Two fixtures, two jobs.
var job_e = geo_obb_new(hvec3_new(0, 0, 0), hvec3_new(F64_ONE, F64_ONE, F64_ONE),
  hquat_identity());
var jer = geo_ray_new(hvec3_new(f64_neg(F64_TWO), f64_neg(F64_TWO), 0),
  hvec3_new(F64_ONE, F64_ONE, 0));
GeoRay_set_direction(jer, hvec3_new(F64_ONE, F64_ONE, 0));
assert_eq(geo_ray_obb(jer, job_e), F64_ONE,
  "obb edge hit: the PRIMAL still returns t = 1, so the jet is refusing a real hit");
assert_eq(geo_jet_hit(geo_jet_obb(jer, job_e)), 0,
  "geo_jet_obb on an exact EDGE returns the miss sentinel, not one side's gradient");

var jcr = geo_ray_new(hvec3_new(f64_neg(F64_TWO), f64_neg(F64_TWO), f64_neg(F64_TWO)),
  hvec3_new(F64_ONE, F64_ONE, F64_ONE));
GeoRay_set_direction(jcr, hvec3_new(F64_ONE, F64_ONE, F64_ONE));
assert_eq(geo_ray_obb(jcr, job_e), F64_ONE, "obb corner hit: the PRIMAL still returns t = 1");
assert_eq(geo_jet_hit(geo_jet_obb(jcr, job_e)), 0,
  "geo_jet_obb on an exact CORNER returns the miss sentinel");

# === 3.3.3 R5geo: a jet never carries a non-finite t ===
# Each builder tested its primal's t only against the miss 0 and then guarded `1 / den`,
# so a NaN or infinite t whose `den` stayed finite came back as a HIT jet carrying it.
# Since 3.3.3 every builder answers its miss for a t that is not finite. Each fixture
# below has a finite `den`, so for the smooth primitives the t test is the only guard
# that fires; the primal's answer is asserted first, to show it. ⚠ 3.3.4 — the boxes
# changed: geo_ray_aabb_face and geo_ray_obb_face return a NaN INPUT as a NaN t with
# GEO_FACE_NONE now (roadmap D034), so their jets' slot test fires as well, and the
# box fixtures below pin that pairing (each was a REAL face 0 with the NaN t on 3.3.3).
# The box jets' t test still decides a NaN the slab arithmetic makes from input with
# no NaN, which leaves with a real face as on 3.3.3: see "3.3.4 D034" below.
# THE TRUE VALUE: an infinite t is not a hit (the slab routines' own tail returns the miss
# for one), and a NaN t is not a contact. Each message names what 3.3.2 returned. The
# +Inf cases have ALL-FINITE input (DBL_MAX, 0.75 DBL_MAX, 2^600): the primal overflows
# and still returns +Inf, so the caller can see it there. Plane and triangle get a NaN
# and an infinite t each, because both halves of the test reach them; a NaN t cannot
# reach the sphere's or capsule's `den` finite (the hit point is NaN), and an infinite
# one cannot leave the slab routines (their tail returns the miss), so those get one.
# [measured: R5geo claims probe, 3.3.2, 3.3.3-base and repaired bundles, not in-tree, 2026-10-01; cycc 6.6.12]
var _r5g_nan = 0x7FF8000000000000;
var _r5g_dm = 0x7FEFFFFFFFFFFFFF;    # DBL_MAX
var _r5g_p600 = 0x6570000000000000;  # 2^600
fn _r5g_ray(o, d) {
    var r = alloc(sizeof(GeoRay));
    GeoRay_set_origin(r, o);
    GeoRay_set_direction(r, d);
    return r;
}
fn _r5g_box(x0, y0, z0, x1, y1, z1) {
    var b = alloc(sizeof(GeoAabb));
    GeoAabb_set_min(b, hvec3_new(x0, y0, z0));
    GeoAabb_set_max(b, hvec3_new(x1, y1, z1));
    return b;
}
var _r5g_m5 = f64_neg(f64_from(5));
var _r5g_one = hvec3_new(F64_ONE, F64_ONE, F64_ONE);
# (-5, 0.5, -5) along (1, 0, 1)/sqrt2: x owns the near face, then the NaN enters on z.
# 3.3.2 answered the geo_aabb_new box below with the miss jet only because its
# geo_aabb_new dropped the NaN corner (a flat z slab, an edge tie); the setter box, the
# NaN origin and direction and the OBB built the hit jet with t NaN on 3.3.2 as well.
var _r5g_dg = geo_ray_new(hvec3_new(_r5g_m5, F64_HALF, _r5g_m5), hvec3_new(F64_ONE, 0, F64_ONE));
var _r5g_out = alloc(GEO_FACE_OUT_BYTES);
var _r5g_ub = geo_aabb_new(hvec3_zero(), _r5g_one);
var _r5g_bn = geo_aabb_new(hvec3_new(0, 0, _r5g_nan), _r5g_one);
var _r5g_t = geo_ray_aabb_face(_r5g_dg, _r5g_bn, _r5g_out);
assert_eq(f64_eq(_r5g_t, _r5g_t), 0, "primal: geo_aabb_new((0,0,NaN),(1,1,1)) on the diagonal ray is a NaN t");
assert_eq(load64(_r5g_out), GEO_FACE_NONE, "primal: ... with GEO_FACE_NONE (3.3.3: the real face 0)");
assert_eq(load64(_r5g_out + 8), 0, "primal: ... and no tie");
assert_eq(geo_jet_kind(geo_jet_aabb(_r5g_dg, _r5g_bn)), GEO_JET_MISS,
  "geo_jet_aabb: geo_aabb_new((0,0,NaN),(1,1,1)) on the diagonal is the miss jet, not an AABB jet with t NaN");
assert_eq(geo_jet_kind(geo_jet_aabb(_r5g_dg, _r5g_box(0, 0, _r5g_nan, F64_ONE, F64_ONE, F64_ONE))),
  GEO_JET_MISS, "geo_jet_aabb: setter box min.z NaN is the miss jet (3.3.2: AABB jet, t NaN)");
var _r5g_dz = _r5g_ray(hvec3_new(_r5g_m5, F64_HALF, _r5g_nan), GeoRay_direction(_r5g_dg));
_r5g_t = geo_ray_aabb_face(_r5g_dz, _r5g_ub, _r5g_out);
assert_eq(f64_eq(_r5g_t, _r5g_t), 0, "primal: unit box, origin (-5,0.5,NaN): NaN t");
assert_eq(load64(_r5g_out), GEO_FACE_NONE, "primal: ... with GEO_FACE_NONE (3.3.3: the real face 0)");
assert_eq(geo_jet_kind(geo_jet_aabb(_r5g_dz, _r5g_ub)), GEO_JET_MISS,
  "geo_jet_aabb: unit box, origin (-5,0.5,NaN) is the miss jet (3.3.2: AABB jet, t NaN)");
var _r5g_dd = _r5g_ray(hvec3_new(_r5g_m5, F64_HALF, _r5g_m5),
  hvec3_new(HVec3_x(GeoRay_direction(_r5g_dg)), 0, _r5g_nan));
_r5g_t = geo_ray_aabb_face(_r5g_dd, _r5g_ub, _r5g_out);
assert_eq(f64_eq(_r5g_t, _r5g_t), 0, "primal: unit box, direction (1/sqrt2,0,NaN): NaN t");
assert_eq(load64(_r5g_out), GEO_FACE_NONE, "primal: ... with GEO_FACE_NONE (3.3.3: the real face 0)");
assert_eq(geo_jet_kind(geo_jet_aabb(_r5g_dd, _r5g_ub)), GEO_JET_MISS,
  "geo_jet_aabb: unit box, direction (1/sqrt2,0,NaN) is the miss jet (3.3.2: AABB jet, t NaN)");
var _r5g_ob = geo_obb_new(hvec3_splat(F64_HALF), hvec3_new(F64_HALF, F64_HALF, _r5g_nan), hquat_identity());
_r5g_t = geo_ray_obb_face(_r5g_dg, _r5g_ob, _r5g_out);
assert_eq(f64_eq(_r5g_t, _r5g_t), 0, "primal: unit OBB with half-extent z NaN: NaN t");
assert_eq(load64(_r5g_out), GEO_FACE_NONE, "primal: ... with GEO_FACE_NONE (3.3.3: the real face 0)");
assert_eq(load64(_r5g_out + 8), 0, "primal: ... and no tie");
assert_eq(geo_jet_kind(geo_jet_obb(_r5g_dg, _r5g_ob)), GEO_JET_MISS,
  "geo_jet_obb: half-extent z NaN is the miss jet (3.3.2: OBB jet, t NaN)");

# === 3.3.4 D034: a NaN anywhere in a slab routine's input is a NaN t, GEO_FACE_NONE ===
# Through 3.3.3 f64_max / f64_min erased a NaN slab when a later slab won, a parallel
# slab's two tests (both false against a NaN) skipped one, and a miss found early never
# read the later slabs: a NaN input came back as a finite t, as the miss 0, or as a NaN
# t with an earlier slab's face. Each fixture reaches ONE of the repair's sites, and its
# message names what 3.3.3 returned there. THE TRUE VALUE: there is none for a NaN
# coordinate, and the module's contract (geo_ray_sphere, _plane, _capsule, and the
# "a NaN ray yields NaN" pin in tests/abuse.tcyr) is a NaN t.
# [measured: georay slab sweep and probes, 3.3.3 geo.cyr vs repaired, 3.3.4 tree, not in-tree, 2026-10-03; cycc 6.6.14]
fn _d34_ok(t, out) {
    if (f64_eq(t, t) == 1) { return 0; }
    if (load64(out) != GEO_FACE_NONE) { return 0; }
    if (load64(out + 8) != 0) { return 0; }
    return 1;
}
var _d34_s = 0x3FE6A09E667F3BCD;   # 1/sqrt2
var _d34_m2 = f64_neg(F64_TWO);
var _d34_nz = _r5g_box(0, 0, 0, F64_ONE, F64_ONE, _r5g_nan);    # max.z NaN
var _d34_ux = hvec3_unit_x();
var _d34_uy = hvec3_unit_y();
# merged-slab NaN (the `t_min < t_max` test): x origin NaN on a diagonal ray
assert_eq(_d34_ok(geo_ray_aabb_face(_r5g_ray(hvec3_new(_r5g_nan, F64_HALF, f64_neg(0x4012000000000000)),
        hvec3_new(_d34_s, 0, _d34_s)), _r5g_ub, _r5g_out), _r5g_out), 1,
  "geo_ray_aabb_face: origin (NaN,0.5,-4.5) on (1,0,1)/sqrt2 is NaN, NONE (3.3.3: 4.5*sqrt2, NONE)");
# parallel-slab NaN tests, one per input
assert_eq(_d34_ok(geo_ray_aabb_face(_r5g_ray(hvec3_new(_r5g_nan, F64_HALF, _r5g_m5), hvec3_unit_z()),
      _r5g_ub, _r5g_out), _r5g_out), 1,
  "geo_ray_aabb_face: origin (NaN,0.5,-5) along +z is NaN, NONE (3.3.3: t = 5, face 4)");
var _d34_r = _r5g_ray(hvec3_new(_r5g_m5, F64_HALF, F64_HALF), _d34_ux);
assert_eq(_d34_ok(geo_ray_aabb_face(_d34_r, _r5g_box(0, _r5g_nan, 0, F64_ONE, F64_ONE, F64_ONE), _r5g_out),
    _r5g_out), 1, "geo_ray_aabb_face: box min.y NaN, ray along +x, is NaN, NONE (3.3.3: t = 5, face 0)");
assert_eq(_d34_ok(geo_ray_aabb_face(_d34_r, _r5g_box(0, 0, 0, F64_ONE, _r5g_nan, F64_ONE), _r5g_out),
    _r5g_out), 1, "geo_ray_aabb_face: box max.y NaN, ray along +x, is NaN, NONE (3.3.3: t = 5, face 0)");
assert_eq(_d34_ok(geo_ray_aabb_face(_d34_r, geo_aabb_new(hvec3_new(0, _r5g_nan, 0), _r5g_one), _r5g_out),
    _r5g_out), 1, "geo_ray_aabb_face: geo_aabb_new((0,NaN,0),(1,1,1)) along +x is NaN (3.3.3: t = 5, face 0)");
# a miss found before the last slab, with the NaN in a slab it never read (max.z)
assert_eq(_d34_ok(geo_ray_aabb_face(_r5g_ray(hvec3_new(_d34_m2, _r5g_m5, F64_HALF), _d34_uy), _d34_nz,
      _r5g_out), _r5g_out), 1, "geo_ray_aabb_face: x parallel miss (x < min) before a NaN max.z is NaN (3.3.3: 0)");
assert_eq(_d34_ok(geo_ray_aabb_face(_r5g_ray(hvec3_new(F64_TWO, _r5g_m5, F64_HALF), _d34_uy), _d34_nz,
      _r5g_out), _r5g_out), 1, "geo_ray_aabb_face: x parallel miss (x > max) before a NaN max.z is NaN (3.3.3: 0)");
assert_eq(_d34_ok(geo_ray_aabb_face(_r5g_ray(hvec3_new(_r5g_m5, _d34_m2, F64_HALF), _d34_ux), _d34_nz,
      _r5g_out), _r5g_out), 1, "geo_ray_aabb_face: y parallel miss (y < min) before a NaN max.z is NaN (3.3.3: 0)");
assert_eq(_d34_ok(geo_ray_aabb_face(_r5g_ray(hvec3_new(_r5g_m5, F64_TWO, F64_HALF), _d34_ux), _d34_nz,
      _r5g_out), _r5g_out), 1, "geo_ray_aabb_face: y parallel miss (y > max) before a NaN max.z is NaN (3.3.3: 0)");
assert_eq(_d34_ok(geo_ray_aabb_face(_r5g_ray(hvec3_new(_r5g_m5, F64_TWO, F64_HALF),
        hvec3_new(_d34_s, _d34_s, 0)), _d34_nz, _r5g_out), _r5g_out), 1,
  "geo_ray_aabb_face: x and y slabs disjoint before a NaN max.z is NaN (3.3.3: 0)");
# the last slab's own parallel miss fires before its own NaN tests
assert_eq(_d34_ok(geo_ray_aabb_face(_r5g_ray(hvec3_new(_r5g_m5, F64_HALF, _d34_m2), _d34_ux), _d34_nz,
      _r5g_out), _r5g_out), 1, "geo_ray_aabb_face: z parallel miss (z < min), its own max.z NaN, is NaN (3.3.3: 0)");
assert_eq(_d34_ok(geo_ray_aabb_face(_r5g_ray(hvec3_new(_r5g_m5, F64_HALF, F64_TWO), _d34_ux),
      _r5g_box(0, 0, _r5g_nan, F64_ONE, F64_ONE, F64_ONE), _r5g_out), _r5g_out), 1,
  "geo_ray_aabb_face: z parallel miss (z > max) beside its own NaN min.z is NaN (3.3.3: 0)");
assert_eq(f64_eq(geo_ray_aabb(_r5g_ray(hvec3_new(F64_TWO, _r5g_m5, F64_HALF), _d34_uy), _d34_nz), 0), 0,
  "geo_ray_aabb: the plain entry point is NaN there too, not the miss 0");
# the rest of the parallel-slab NaN tests, each slab's three inputs (no miss first)
var _d34_ry = _r5g_ray(hvec3_new(F64_HALF, _r5g_m5, F64_HALF), _d34_uy);
assert_eq(_d34_ok(geo_ray_aabb_face(_d34_ry, _r5g_box(_r5g_nan, 0, 0, F64_ONE, F64_ONE, F64_ONE), _r5g_out),
    _r5g_out), 1, "geo_ray_aabb_face: box min.x NaN, ray along +y, is NaN, NONE (3.3.3: t = 5, face 2)");
assert_eq(_d34_ok(geo_ray_aabb_face(_d34_ry, _r5g_box(0, 0, 0, _r5g_nan, F64_ONE, F64_ONE), _r5g_out),
    _r5g_out), 1, "geo_ray_aabb_face: box max.x NaN, ray along +y, is NaN, NONE (3.3.3: t = 5, face 2)");
assert_eq(_d34_ok(geo_ray_aabb_face(_r5g_ray(hvec3_new(_r5g_m5, _r5g_nan, F64_HALF), _d34_ux), _r5g_ub,
      _r5g_out), _r5g_out), 1, "geo_ray_aabb_face: origin (-5,NaN,0.5) along +x is NaN, NONE (3.3.3: t = 5, face 0)");
assert_eq(_d34_ok(geo_ray_aabb_face(_r5g_ray(hvec3_new(_r5g_m5, F64_HALF, _r5g_nan), _d34_ux), _r5g_ub,
      _r5g_out), _r5g_out), 1, "geo_ray_aabb_face: origin (-5,0.5,NaN) along +x is NaN, NONE (3.3.3: t = 5, face 0)");
assert_eq(_d34_ok(geo_ray_aabb_face(_d34_r, _r5g_box(0, 0, _r5g_nan, F64_ONE, F64_ONE, F64_ONE), _r5g_out),
    _r5g_out), 1, "geo_ray_aabb_face: box min.z NaN, ray along +x, is NaN, NONE (3.3.3: t = 5, face 0)");
assert_eq(_d34_ok(geo_ray_aabb_face(_d34_r, _d34_nz, _r5g_out), _r5g_out), 1,
  "geo_ray_aabb_face: box max.z NaN, ray along +x, is NaN, NONE (3.3.3: t = 5, face 0)");
# a NaN entering on the second crossing slab: origin y NaN on (1,1,0)/sqrt2
assert_eq(_d34_ok(geo_ray_aabb_face(_r5g_ray(hvec3_new(_r5g_m5, _r5g_nan, F64_HALF),
        hvec3_new(_d34_s, _d34_s, 0)), _r5g_ub, _r5g_out), _r5g_out), 1,
  "geo_ray_aabb_face: origin (-5,NaN,0.5) on (1,1,0)/sqrt2 is NaN, NONE (3.3.3: NaN with face 0)");
# the early-miss scan reads every input: a NaN origin z, direction z, min.x, max.y behind
# an x parallel miss (x = 2 > max.x)
var _d34_o2 = hvec3_new(F64_TWO, _r5g_m5, F64_HALF);
assert_eq(_d34_ok(geo_ray_aabb_face(_r5g_ray(hvec3_new(F64_TWO, _r5g_m5, _r5g_nan), _d34_uy), _r5g_ub,
      _r5g_out), _r5g_out), 1, "geo_ray_aabb_face: x parallel miss before a NaN origin z is NaN (3.3.3: 0)");
assert_eq(_d34_ok(geo_ray_aabb_face(_r5g_ray(_d34_o2, hvec3_new(0, F64_ONE, _r5g_nan)), _r5g_ub,
      _r5g_out), _r5g_out), 1, "geo_ray_aabb_face: x parallel miss before a NaN direction z is NaN (3.3.3: 0)");
assert_eq(_d34_ok(geo_ray_aabb_face(_r5g_ray(_d34_o2, _d34_uy), _r5g_box(_r5g_nan, 0, 0, F64_ONE, F64_ONE, F64_ONE),
      _r5g_out), _r5g_out), 1, "geo_ray_aabb_face: x parallel miss beside a NaN min.x is NaN (3.3.3: 0)");
assert_eq(_d34_ok(geo_ray_aabb_face(_r5g_ray(_d34_o2, _d34_uy), _r5g_box(0, 0, 0, F64_ONE, _r5g_nan, F64_ONE),
      _r5g_out), _r5g_out), 1, "geo_ray_aabb_face: x parallel miss before a NaN max.y is NaN (3.3.3: 0)");
# The OBB: the unit box, a NaN half-extent z, misses on axes 0 and 1 before it.
var _d34_onz = geo_obb_new(hvec3_splat(F64_HALF), hvec3_new(F64_HALF, F64_HALF, _r5g_nan), hquat_identity());
assert_eq(_d34_ok(geo_ray_obb_face(_r5g_ray(hvec3_new(_d34_m2, _r5g_m5, F64_HALF), _d34_uy), _d34_onz,
      _r5g_out), _r5g_out), 1, "geo_ray_obb_face: axis-0 miss (-e + he < 0) before NaN he.z is NaN (3.3.3: 0)");
assert_eq(_d34_ok(geo_ray_obb_face(_r5g_ray(hvec3_new(F64_TWO, _r5g_m5, F64_HALF), _d34_uy), _d34_onz,
      _r5g_out), _r5g_out), 1, "geo_ray_obb_face: axis-0 miss (-e - he > 0) before NaN he.z is NaN (3.3.3: 0)");
assert_eq(_d34_ok(geo_ray_obb_face(_r5g_ray(hvec3_new(_r5g_m5, _d34_m2, F64_HALF), _d34_ux), _d34_onz,
      _r5g_out), _r5g_out), 1, "geo_ray_obb_face: axis-1 miss (-e + he < 0) before NaN he.z is NaN (3.3.3: 0)");
assert_eq(_d34_ok(geo_ray_obb_face(_r5g_ray(hvec3_new(_r5g_m5, F64_TWO, F64_HALF), _d34_ux), _d34_onz,
      _r5g_out), _r5g_out), 1, "geo_ray_obb_face: axis-1 miss (-e - he > 0) before NaN he.z is NaN (3.3.3: 0)");
assert_eq(_d34_ok(geo_ray_obb_face(_r5g_ray(hvec3_new(_r5g_m5, F64_TWO, F64_HALF),
        hvec3_new(_d34_s, _d34_s, 0)), _d34_onz, _r5g_out), _r5g_out), 1,
  "geo_ray_obb_face: axes 0 and 1 disjoint before NaN he.z is NaN (3.3.3: 0)");
# a parallel axis's own NaN half-extent, one per axis
assert_eq(_d34_ok(geo_ray_obb_face(_r5g_ray(hvec3_new(F64_HALF, _r5g_m5, F64_HALF), _d34_uy),
      geo_obb_new(hvec3_splat(F64_HALF), hvec3_new(_r5g_nan, F64_HALF, F64_HALF), hquat_identity()),
      _r5g_out), _r5g_out), 1, "geo_ray_obb_face: he.x NaN, ray along +y, is NaN, NONE (3.3.3: t = 5, face 2)");
assert_eq(_d34_ok(geo_ray_obb_face(_d34_r,
      geo_obb_new(hvec3_splat(F64_HALF), hvec3_new(F64_HALF, _r5g_nan, F64_HALF), hquat_identity()),
      _r5g_out), _r5g_out), 1, "geo_ray_obb_face: he.y NaN, ray along +x, is NaN, NONE (3.3.3: t = 5, face 0)");
assert_eq(_d34_ok(geo_ray_obb_face(_d34_r, _d34_onz, _r5g_out), _r5g_out), 1,
  "geo_ray_obb_face: he.z NaN, ray along +x, is NaN, NONE (3.3.3: t = 5, face 0)");
# The same parallel tests on a box with no NaN, each where it decides. From (-5, 0, 0.5) along
# +x the origin is ON the min-y face's plane, -e + he = +0 exactly, and a ray in a face's plane
# lies in the closed slab: the box is entered at x = 0, t = 5 on face 0 (seed-336 mutant m0050
# tested -e + he < 2^-1074, the bit pattern 1, which takes that +0 for the miss). From
# (-5, 0.5, -2) axis 2 is parallel with the origin below the box, -e + he = -2: the miss
# (seed-336 mutant m0051 never took that arm, and answered the x slab's t = 5).
var _mt50_ob = geo_obb_new(hvec3_splat(F64_HALF), hvec3_splat(F64_HALF), hquat_identity());
assert_eq(geo_ray_obb_face(_r5g_ray(hvec3_new(_r5g_m5, 0, F64_HALF), _d34_ux), _mt50_ob, _r5g_out),
  0x4014000000000000, "geo_ray_obb_face: origin on the min-y plane, axis 1 parallel (-e + he = +0) -> t = 5");
assert_eq(load64(_r5g_out), 0, "geo_ray_obb_face: ... on face 0");
assert_eq(geo_ray_obb_face(_r5g_ray(hvec3_new(_r5g_m5, F64_HALF, _d34_m2), _d34_ux), _mt50_ob, _r5g_out), 0,
  "geo_ray_obb_face: axis-2 miss (-e + he < 0) on a finite box -> the miss 0");
assert_eq(load64(_r5g_out), GEO_FACE_NONE, "geo_ray_obb_face: ... with GEO_FACE_NONE");
# a NaN half-extent on a crossing axis, laundered by a later crossing axis on 3.3.3
assert_eq(_d34_ok(geo_ray_obb_face(_r5g_ray(hvec3_new(_r5g_m5, F64_HALF, f64_neg(0x4012000000000000)),
        hvec3_new(_d34_s, 0, _d34_s)),
      geo_obb_new(hvec3_splat(F64_HALF), hvec3_new(_r5g_nan, F64_HALF, F64_HALF), hquat_identity()),
      _r5g_out), _r5g_out), 1, "geo_ray_obb_face: he.x NaN on (1,0,1)/sqrt2 is NaN, NONE (3.3.3: 4.5*sqrt2, NONE)");
assert_eq(_d34_ok(geo_ray_obb_face(_r5g_ray(hvec3_new(F64_HALF, _r5g_m5, f64_neg(0x4012000000000000)),
        hvec3_new(0, _d34_s, _d34_s)),
      geo_obb_new(hvec3_splat(F64_HALF), hvec3_new(F64_HALF, _r5g_nan, F64_HALF), hquat_identity()),
      _r5g_out), _r5g_out), 1, "geo_ray_obb_face: he.y NaN on (0,1,1)/sqrt2 is NaN, NONE (3.3.3: 4.5*sqrt2, NONE)");
# every axis parallel (a zero direction): only the parallel e tests read the NaN origin
assert_eq(_d34_ok(geo_ray_obb_face(_r5g_ray(hvec3_new(_r5g_nan, F64_HALF, F64_HALF), hvec3_zero()),
      geo_obb_new(hvec3_splat(F64_HALF), hvec3_splat(F64_HALF), hquat_identity()), _r5g_out), _r5g_out), 1,
  "geo_ray_obb_face: zero direction from (NaN,0.5,0.5) is NaN (3.3.3: 0)");
# ⚠ A NaN the ARITHMETIC makes from finite input is not the caller's NaN.
# Centre and origin 1.5 * 2^1024 apart in y: c - o overflows to +Inf in y, and the
# identity axes' exact zeros make 0 * Inf = NaN in e0. The ray along +x passes far
# below the box: the miss, as 3.3.3 answered and as geo_ray_aabb answers the same box.
var _d34_hy = 0x7FE8000000000000;   # 1.5 * 2^1023
var _d34_fr = _r5g_ray(hvec3_new(_r5g_m5, f64_neg(_d34_hy), F64_HALF), _d34_ux);
assert_eq(geo_ray_obb_face(_d34_fr, geo_obb_new(hvec3_new(F64_HALF, _d34_hy, F64_HALF), hvec3_splat(F64_HALF),
      hquat_identity()), _r5g_out), 0, "geo_ray_obb_face: finite input, c - o overflows, is the miss 0, not NaN");
assert_eq(load64(_r5g_out), GEO_FACE_NONE, "geo_ray_obb_face: ... with GEO_FACE_NONE");
assert_eq(geo_ray_aabb(_d34_fr, _r5g_box(0, _d34_hy, 0, F64_ONE, 0x7FEFFFFFFFFFFFFF, F64_ONE)), 0,
  "control: geo_ray_aabb on the same box is the miss 0");
# ⚠ ...so a NaN made from input with NO NaN is left to the slab, as on 3.3.3, and can
# leave as t with an earlier slab's real face. The AABB meets Inf - Inf in y (origin
# and both y bounds at +Inf) after x set face 0; the OBB meets 0 * Inf in axes 1 and 2
# (centre x at +Inf) after axis 0 set face 0. Each jet's own t test answers its miss
# there, and each routine's NaN-true tail pair carries the NaN out: respelled
# NaN-false, the pair returns the miss 0. 3.3.4-base gives the same bits.
# [measured: probe of this tree and the 3.3.4-base bundle, not in-tree, 2026-10-03; cycc 6.6.14]
var _d34_ib = _r5g_box(0, F64_POS_INF, 0, F64_ONE, F64_POS_INF, F64_ONE);
var _d34_ir = _r5g_ray(hvec3_new(_r5g_m5, F64_POS_INF, F64_HALF), hvec3_new(_d34_s, _d34_s, 0));
_r5g_t = geo_ray_aabb_face(_d34_ir, _d34_ib, _r5g_out);
assert_eq(f64_eq(_r5g_t, _r5g_t), 0, "geo_ray_aabb_face: Inf - Inf in y, no NaN in, is a NaN t (as 3.3.3)");
assert_eq(load64(_r5g_out), 0, "geo_ray_aabb_face: ... with the x slab's face 0 (as 3.3.3)");
assert_eq(geo_jet_kind(geo_jet_aabb(_d34_ir, _d34_ib)), GEO_JET_MISS,
  "geo_jet_aabb: ... is the miss jet, which its t test decides (the face is real)");
var _d34_iob = geo_obb_new(hvec3_new(F64_POS_INF, F64_ONE, f64_from(5)), hvec3_new(0, F64_HALF, F64_ONE),
  hquat_identity());
var _d34_ior = _r5g_ray(hvec3_new(0, F64_ONE, 0), hvec3_new(_d34_s, 0, _d34_s));
_r5g_t = geo_ray_obb_face(_d34_ior, _d34_iob, _r5g_out);
assert_eq(f64_eq(_r5g_t, _r5g_t), 0, "geo_ray_obb_face: centre x = +Inf, 0 * Inf, no NaN in, is a NaN t (as 3.3.3)");
assert_eq(load64(_r5g_out), 0, "geo_ray_obb_face: ... with axis 0's face 0 (as 3.3.3)");
assert_eq(geo_jet_kind(geo_jet_obb(_d34_ior, _d34_iob)), GEO_JET_MISS,
  "geo_jet_obb: ... is the miss jet, which its t test decides (the face is real)");
# And every one of the OBB's sixteen input slots, NaN alone, on a ray that
# hits the clean box (the control below) and on a zero direction, where every slab is
# parallel: the slab returns only a NaN the caller supplied, so each slot must be reached
# by the input scan or by its own slab test.
fn _d34_obb_slot(k, out, dx) {
    var s = alloc(128);
    store64(s, f64_neg(F64_TWO));
    store64(s + 8, 0x3FD3333333333333);   # 0.3
    store64(s + 16, 0x3FD999999999999A);  # 0.4
    store64(s + 24, dx);
    store64(s + 32, 0);
    store64(s + 40, 0);
    for (var i = 6; i < 12; i = i + 1) { store64(s + i * 8, F64_HALF); }
    store64(s + 96, 0);
    store64(s + 104, 0);
    store64(s + 112, 0);
    store64(s + 120, F64_ONE);
    if (k < 16) { store64(s + k * 8, 0x7FF8000000000000); }
    var r = alloc(sizeof(GeoRay));
    GeoRay_set_origin(r, hvec3_new(load64(s), load64(s + 8), load64(s + 16)));
    GeoRay_set_direction(r, hvec3_new(load64(s + 24), load64(s + 32), load64(s + 40)));
    var o = geo_obb_new(hvec3_new(load64(s + 48), load64(s + 56), load64(s + 64)),
      hvec3_new(load64(s + 72), load64(s + 80), load64(s + 88)),
      hquat_new(load64(s + 96), load64(s + 104), load64(s + 112), load64(s + 120)));
    return geo_ray_obb_face(r, o, out);
}
assert_eq(_d34_obb_slot(99, _r5g_out, F64_ONE), F64_TWO, "control: the clean OBB slot fixture hits at t = 2");
assert_eq(_d34_obb_slot(99, _r5g_out, 0), 0, "control: ... and with a zero direction is the miss 0");
var _D34_SLOTS = 0;
for (var _d34_k = 0; _d34_k < 16; _d34_k = _d34_k + 1) {
    _D34_SLOTS = _D34_SLOTS + _d34_ok(_d34_obb_slot(_d34_k, _r5g_out, F64_ONE), _r5g_out);
    _D34_SLOTS = _D34_SLOTS + _d34_ok(_d34_obb_slot(_d34_k, _r5g_out, 0), _r5g_out);
}
assert_eq(_D34_SLOTS, 32, "geo_ray_obb_face: a NaN in any one of the 16 input slots, either ray, is NaN, NONE, no tie");
# The smooth primitives: no slot, and `den` finite.
var _r5g_rz = _r5g_ray(hvec3_new(0, 0, _r5g_m5), hvec3_unit_z());
var _r5g_pl = alloc(sizeof(GeoPlane));
GeoPlane_set_normal(_r5g_pl, hvec3_unit_z());
GeoPlane_set_distance(_r5g_pl, _r5g_nan);
_r5g_t = geo_ray_plane(_r5g_rz, _r5g_pl);
assert_eq(f64_eq(_r5g_t, _r5g_t), 0, "primal: plane z = NaN is a NaN t");
assert_eq(geo_jet_kind(geo_jet_plane(_r5g_rz, _r5g_pl)), GEO_JET_MISS,
  "geo_jet_plane: distance NaN is the miss jet (3.3.2: plane jet, t NaN)");
var _r5g_rzd = _r5g_ray(hvec3_new(0, 0, f64_neg(_r5g_dm)), hvec3_unit_z());
GeoPlane_set_distance(_r5g_pl, _r5g_dm);
assert_eq(geo_ray_plane(_r5g_rzd, _r5g_pl), 0x7FF0000000000000,
  "primal: plane z = DBL_MAX from z = -DBL_MAX, all finite, overflows to t = +Inf");
assert_eq(geo_jet_kind(geo_jet_plane(_r5g_rzd, _r5g_pl)), GEO_JET_MISS,
  "geo_jet_plane: that t = +Inf is the miss jet (3.3.2: plane jet, t +Inf)");
var _r5g_tri = geo_triangle_new(hvec3_new(f64_neg(F64_ONE), f64_neg(F64_ONE), 0),
  hvec3_new(f64_from(3), f64_neg(F64_ONE), 0), hvec3_new(f64_neg(F64_ONE), f64_from(3), 0));
var _r5g_rzn = _r5g_ray(hvec3_new(_r5g_nan, 0, _r5g_m5), hvec3_unit_z());
_r5g_t = geo_ray_triangle(_r5g_rzn, _r5g_tri);
assert_eq(f64_eq(_r5g_t, _r5g_t), 0, "primal: triangle, origin (NaN,0,-5): NaN t");
assert_eq(geo_jet_kind(geo_jet_triangle(_r5g_rzn, _r5g_tri)), GEO_JET_MISS,
  "geo_jet_triangle: origin (NaN,0,-5) is the miss jet (3.3.2: triangle jet, t NaN)");
var _r5g_h = 0x7FE7FFFFFFFFFFFF;   # about 0.75 * DBL_MAX: 2h overflows
var _r5g_tfar = geo_triangle_new(hvec3_new(f64_neg(F64_ONE), f64_neg(f64_from(4)), _r5g_h),
  hvec3_new(0, F64_ONE, _r5g_h), hvec3_new(f64_neg(f64_from(4)), 0, _r5g_h));
var _r5g_rfar = _r5g_ray(hvec3_new(F64_ONE, F64_ONE, f64_neg(_r5g_h)), hvec3_unit_z());
# (3.4.1: re-derived. This ray misses the triangle, exact rational Moller-Trumbore v = -5/19:
# (1, 1) is outside its (-1, -4), (0, 1), (-4, 0). The +Inf was the overflow's NaN u and v passing
# the range tests; the 3.4.1 block holds an origin inside it, whose t = 2h is +Inf.)
assert_eq(geo_ray_triangle(_r5g_rfar, _r5g_tfar), 0,
  "primal: triangle in z = h from z = -h, a ray outside it: the miss (3.4.0: +Inf)");
assert_eq(geo_jet_kind(geo_jet_triangle(_r5g_rfar, _r5g_tfar)), GEO_JET_MISS,
  "geo_jet_triangle: that t = +Inf is the miss jet (3.3.2: triangle jet, t +Inf)");
# A t past DBL_MAX from finite input: (0,0,0) along 2^-600 (1,1,1), raw, inside a sphere of
# radius 2^600 at the origin (t = 2^1200 / sqrt3). Every component of the hit point is
# +Inf, so `den` is +Inf and `1 / den` = 0 is finite: only the t test answers the miss.
# ⛔ 3.3.6 — through 3.3.5 this group used the direction (1,1,1), where r^2 overflowed and
# the primal answered +Inf for the finite t = 2^600 / sqrt3; that t is now formed on a
# unit-size copy (_geo_sphere_roots_scaled), so the overflowing t needs the small d.
var _r5g_r111 = _r5g_ray(hvec3_zero(), hvec3_splat(0x1A70000000000000));
var _r5g_sp = geo_sphere_new(hvec3_zero(), _r5g_p600);
assert_eq(geo_ray_sphere(_r5g_r111, _r5g_sp), 0x7FF0000000000000,
  "primal: sphere of radius 2^600 at the origin, d = 2^-600 (1,1,1): t = 2^1200 / sqrt3 overflows to +Inf");
assert_eq(geo_jet_kind(geo_jet_sphere(_r5g_r111, _r5g_sp)), GEO_JET_MISS,
  "geo_jet_sphere: radius 2^600, t = +Inf, is the miss jet (3.3.2: sphere jet, t +Inf)");
var _r5g_cp = geo_capsule_new(hvec3_zero(), hvec3_new(f64_from(3), 0, 0), _r5g_p600);
assert_eq(geo_ray_capsule_branch(_r5g_r111, _r5g_cp, _r5g_out), 0x7FF0000000000000,
  "primal: capsule (0,0,0)-(3,0,0) of radius 2^600, d = 2^-600 (1,1,1): t = +Inf");
assert_eq(load64(_r5g_out), GEO_CAP_END_CAP, "primal: ... on the END_CAP label, so the slot test cannot fire");
assert_eq(geo_jet_kind(geo_jet_capsule(_r5g_r111, _r5g_cp)), GEO_JET_MISS,
  "geo_jet_capsule: radius 2^600, t = +Inf, is the miss jet (3.3.2: capsule jet, t +Inf)");
# The 3.3.5 fixtures themselves, along (1,1,1): finite answers now. Exact: t = r / sqrt3
# (the end cap's root differs by 1, below an ulp), dt/do = -(1/3)(1,1,1) and dt/dr =
# 1/sqrt3, RN 0x656279A74590331C, 0xBFD5555555555555 and 0x3FE279A74590331C at r = 2^600;
# t RN 0x7FE279A74590331C at r = DBL_MAX, where den = g . d overflows and the jet forms
# its quotients on a scaled copy (_geo_jet_round_scaled). Each answer below is within one
# ulp of those.
# [measured: C336 probe and exact Decimal values, this tree, not in-tree, 2026-10-11; cycc 6.6.14]
var _r6g_r111 = _r5g_ray(hvec3_zero(), _r5g_one);
assert_eq(geo_ray_sphere(_r6g_r111, _r5g_sp), 0x656279A74590331D,
  "primal: sphere of radius 2^600, from its centre along (1,1,1): t = 2^600 / sqrt3 (3.3.5: +Inf, r^2 overflowed)");
var _r6g_js = geo_jet_sphere(_r6g_r111, _r5g_sp);
assert_eq(geo_jet_kind(_r6g_js), GEO_JET_SPHERE, "geo_jet_sphere: ... a hit jet (3.3.5: the miss jet)");
assert_eq(HVec3_x(geo_jet_dorigin(_r6g_js)), 0xBFD5555555555555, "geo_jet_sphere: ... dt/do.x = -1/3");
var _r6g_jd = geo_jet_sphere(_r6g_r111, geo_sphere_new(hvec3_zero(), _r5g_dm));
assert_eq(geo_jet_t(_r6g_jd), 0x7FE279A74590331C, "geo_jet_sphere: radius DBL_MAX, t = DBL_MAX / sqrt3");
assert_eq(HVec3_x(geo_jet_dorigin(_r6g_jd)), 0xBFD5555555555556,
  "geo_jet_sphere: ... g . d overflows, and dt/do.x is -1/3 (3.3.5: the miss jet)");
assert_eq(geo_jet_sphere_dradius(_r6g_jd), 0x3FE279A74590331C, "geo_jet_sphere: ... dt/dr = 1/sqrt3");
assert_eq(geo_ray_capsule_branch(_r6g_r111, _r5g_cp, _r5g_out), 0x656279A74590331C,
  "primal: capsule (0,0,0)-(3,0,0) of radius 2^600, along (1,1,1): t on the end cap (3.3.5: +Inf)");
assert_eq(load64(_r5g_out), GEO_CAP_END_CAP, "primal: ... the END_CAP");
var _r6g_jc = geo_jet_capsule(_r6g_r111, geo_capsule_new(hvec3_zero(), hvec3_new(f64_from(3), 0, 0), _r5g_dm));
assert_eq(geo_jet_kind(_r6g_jc), GEO_JET_CAPSULE, "geo_jet_capsule: radius DBL_MAX along (1,1,1) is a hit jet");
# A miss jet's typed accessors return 0, not a vector: read dt/d(end) only from a hit.
var _r6g_de = 0;
if (geo_jet_kind(_r6g_jc) == GEO_JET_CAPSULE) { _r6g_de = HVec3_x(geo_jet_capsule_dend(_r6g_jc)); }
assert_eq(_r6g_de, 0x3FD5555555555556,
  "geo_jet_capsule: ... g . d overflows, and dt/d(end).x is 1/3 (3.3.5: the miss jet)");

test_group("3.3.5 geo_diff: geo_jet_obb at a zero t");
var _g537_j = geo_jet_obb(geo_ray_new(hvec3_new(0, F64_HALF, F64_HALF), hvec3_unit_x()),
  geo_obb_new(hvec3_splat(F64_HALF), hvec3_splat(F64_HALF), hquat_identity()));
assert_eq(geo_jet_kind(_g537_j), GEO_JET_MISS,
  "geo_jet_obb: origin ON the axis-0 min face (primal t = +0.0, face 0): the miss jet");
assert_eq(geo_jet_face(_g537_j), GEO_FACE_NONE, "geo_jet_obb: ... carrying GEO_FACE_NONE, not face 0");

test_group("3.3.5 geo: ray slabs whose t overflows from finite input");
# The e2 = NaN guard (the third block) is equivalent: the NaN it would find can only be
# he.z, which the next line returns anyway.
var _g1101_out = alloc(GEO_FACE_OUT_BYTES);
var _g1101_ray = geo_ray_new(hvec3_new(0xFFE1CCF385EBC8A0, 0, 0), hvec3_unit_x());   # origin x = -1e308
var _g1101_box = geo_aabb_new(hvec3_new(0x7FE1CCF385EBC8A0, f64_neg(F64_ONE), f64_neg(F64_ONE)),
  hvec3_new(0x7FEFFFFFFFFFFFFF, F64_ONE, F64_ONE));                                  # x in [1e308, DBL_MAX]
assert_eq(geo_ray_aabb_face(_g1101_ray, _g1101_box, _g1101_out), 0,
  "geo_ray_aabb_face: all finite, entry (1e308 - -1e308) overflows t_min to +Inf: the miss 0, not +Inf");
assert_eq(load64(_g1101_out), GEO_FACE_NONE, "geo_ray_aabb_face: ... with GEO_FACE_NONE, not face 0");
assert_eq(geo_ray_aabb(_g1101_ray, _g1101_box), 0, "geo_ray_aabb: the same overflowed entry is the miss 0");
var _g1107_out = alloc(GEO_FACE_OUT_BYTES);
var _g1107_ray = geo_ray_new(hvec3_new(0xFFE1CCF385EBC8A0, 0, 0), hvec3_unit_x());   # origin x = -1e308
var _g1107_box = geo_aabb_new(hvec3_new(0xFFEFFFFFFFFFFFFF, f64_neg(F64_ONE), f64_neg(F64_ONE)),
  hvec3_new(0x7FEFFFFFFFFFFFFF, F64_ONE, F64_ONE));                                  # x in [-DBL_MAX, DBL_MAX]
assert_eq(geo_ray_aabb_face(_g1107_ray, _g1107_box, _g1107_out), 0,
  "geo_ray_aabb_face: origin inside, exit (DBL_MAX - -1e308) overflows t_max to +Inf: the miss 0, not +Inf");
assert_eq(load64(_g1107_out), GEO_FACE_NONE, "geo_ray_aabb_face: ... with GEO_FACE_NONE");
var _g1384_out = alloc(GEO_FACE_OUT_BYTES);
var _g1384_ray = geo_ray_new(hvec3_new(0xFFE1CCF385EBC8A0, 0, 0), hvec3_unit_x());   # origin x = -1e308
var _g1384_obb = geo_obb_new(hvec3_zero(), hvec3_new(0x7FEFFFFFFFFFFFFF, F64_ONE, F64_ONE), hquat_identity());
assert_eq(geo_ray_obb_face(_g1384_ray, _g1384_obb, _g1384_out), 0,
  "geo_ray_obb_face: origin inside, exit e0 + he0 = 1e308 + DBL_MAX overflows t_max to +Inf: the miss 0, not +Inf");
assert_eq(load64(_g1384_out), GEO_FACE_NONE, "geo_ray_obb_face: ... with GEO_FACE_NONE");
var _g1363_out = alloc(GEO_FACE_OUT_BYTES);
var _g1363_ray = geo_ray_new(hvec3_new(0xFFEFFFFFFFFFFFFF, 0, 0), hvec3_unit_x());   # origin x = -DBL_MAX
var _g1363_q = hquat_new(0, 0, 0x3FE3333333333333, 0x3FE999999999999A);   # about z: (0, 0, 0.6, 0.8)
var _g1363_c = hvec3_new(0x7FEFFFFFFFFFFFFF, 0, 0);                        # centre x = DBL_MAX
assert_eq(geo_ray_obb_face(_g1363_ray, geo_obb_new(_g1363_c, hvec3_one(), _g1363_q), _g1363_out), 0,
  "geo_ray_obb_face: c - o = (+Inf, 0, 0) from finite input; e2 = 0 * Inf = NaN on parallel axis 2: the miss 0");
assert_eq(load64(_g1363_out), GEO_FACE_NONE, "geo_ray_obb_face: ... with GEO_FACE_NONE");
assert_eq(geo_ray_obb_face(_g1363_ray, geo_obb_new(_g1363_c, hvec3_new(F64_ONE, F64_ONE, 0x7FF8000000000000),
      _g1363_q), _g1363_out), 0x7FF8000000000000, "geo_ray_obb_face: ... and with he.z = NaN, that NaN comes back");

test_group("2.10.1 geo_jet_capsule: every gradient matches central differences of the primal");
_jt_capsule_sweep();
assert_eq(_JT_BAD, 0,
  "geo_jet_capsule: dt/do, dt/dd, dt/dstart, dt/dend, dt/dradius all match FD");
# ⚠ ALL THREE BRANCHES, asserted. 0b0111 = cylinder | start cap | end cap.
assert_eq(_JC_BRANCH, 0x7, "the capsule jet sweep exercised the barrel AND both caps");

# ⚠ Smoke test only, and labelled as one: dt/dstart + dt/dend == -dt/do holds
# because (1-s) + s = 1 cancels algebraically, so it survives ANY shared error in
# the two endpoint expressions. Same trap as the triangle's translation identity.
# The FD sweep above is the oracle; this is here because a reader expects it.
var jcap = geo_capsule_new(hvec3_new(0, 0, 0), hvec3_new(0, 0, f64_from(3)),
  f64_div(f64_from(3), F64_TWO));
var jcray = geo_ray_new(hvec3_new(f64_neg(f64_from(6)), f64_div(F64_ONE, f64_from(4)),
    f64_div(f64_from(3), F64_TWO)), hvec3_new(F64_ONE, 0, 0));
var jcj = geo_jet_capsule(jcray, jcap);
assert_eq(geo_jet_hit(jcj), 1, "the capsule translation-identity fixture actually hits");
var jcsum = hvec3_add(geo_jet_capsule_dstart(jcj), geo_jet_capsule_dend(jcj));
assert(f64_approx_eq(hvec3_length(hvec3_add(jcsum, geo_jet_dorigin(jcj))), 0, LOOSE_TOL_M),
  "capsule: dt/dstart + dt/dend == -dt/do (translating both endpoints == translating the ray)");

# THE SEAM IS DIFFERENTIABLE, and this measures the RATE at which the two
# branches agree rather than checking one offset against one tolerance.
#
# Two rays either side of z = 0 land on different branches -- the barrel just
# above, the start cap just below. A C1 surface makes the gradient gap shrink
# LINEARLY with the offset; a merely-continuous one leaves an O(1) gap that no
# single-offset tolerance test distinguishes from a tight one. Measured: the gap
# falls by exactly one decade per decade of offset, from 1.7e-8 at dz = 1e-8 to
# 1.7e-10 at 1e-10 and below print precision by 1e-13.
# [measured: CHANGELOG.md 2.10.1, the seam convergence table]
#
# ⚠ The first draft of this assertion used dz = 1e-7 against LOOSE_TOL_M (1e-8)
# and FAILED -- correctly, because the true gap there is 6.7e-8. The fixture was
# wrong, not the code, and the way that was established was to measure the gap at
# eleven offsets and look at the slope. A rate assertion is what should have been
# written first: it cannot be satisfied by loosening a tolerance.
# [measured: CHANGELOG.md 2.10.1, "the capsule seam is C1" convergence table]
#
# A box edge fails exactly this test, which is why the box jets return the miss
# sentinel there and this one does not.
fn _jc_seam_gap(dz) {
    var dir = hvec3_new(F64_ONE, 0, 0);
    var cp = geo_capsule_new(hvec3_new(0, 0, 0), hvec3_new(0, 0, f64_from(3)),
      f64_div(f64_from(3), F64_TWO));
    var ru = alloc(sizeof(GeoRay));
    GeoRay_set_origin(ru, hvec3_new(f64_neg(f64_from(6)), 0, dz));
    GeoRay_set_direction(ru, dir);
    var rd = alloc(sizeof(GeoRay));
    GeoRay_set_origin(rd, hvec3_new(f64_neg(f64_from(6)), 0, f64_neg(dz)));
    GeoRay_set_direction(rd, dir);
    var ju = geo_jet_capsule(ru, cp);
    var jd = geo_jet_capsule(rd, cp);
    if (geo_jet_face(ju) != GEO_CAP_CYLINDER) { return f64_neg(F64_ONE); }
    if (geo_jet_face(jd) != GEO_CAP_START_CAP) { return f64_neg(F64_ONE); }
    var g = hvec3_length(hvec3_sub(geo_jet_dorigin(ju), geo_jet_dorigin(jd)));
    g = f64_add(g, hvec3_length(hvec3_sub(geo_jet_capsule_dstart(ju),
          geo_jet_capsule_dstart(jd))));
    g = f64_add(g, hvec3_length(hvec3_sub(geo_jet_capsule_dend(ju),
          geo_jet_capsule_dend(jd))));
    return f64_add(g, f64_abs(f64_sub(geo_jet_capsule_dradius(ju),
          geo_jet_capsule_dradius(jd))));
}

var _seam_far = F64_ONE;
for (var i = 0; i < 8; i = i + 1) { _seam_far = f64_div(_seam_far, f64_from(10)); }
var _seam_near = _seam_far;
for (var i = 0; i < 2; i = i + 1) { _seam_near = f64_div(_seam_near, f64_from(10)); }
var _g_far = _jc_seam_gap(_seam_far);
var _g_near = _jc_seam_gap(_seam_near);
assert(f64_gt(_g_far, 0) == 1,
  "capsule seam: the two offsets land on the barrel and the cap respectively, and the gap is real");
# A hundredfold smaller offset must give at least a fiftyfold smaller gap. C0
# would plateau; C1 gives exactly 100x, so this passes with 2x of margin.
# [measured: CHANGELOG.md 2.10.1, the seam convergence table]
assert(f64_lt(f64_mul(_g_near, f64_from(50)), _g_far) == 1,
  "capsule seam: the barrel/cap gradient gap shrinks LINEARLY with the offset (the surface is C1)");

var jwo3 = alloc(GEO_FACE_OUT_BYTES);
assert_eq(geo_ray_capsule(jcray, jcap), geo_ray_capsule_branch(jcray, jcap, jwo3),
  "geo_ray_capsule is bit-identical to geo_ray_capsule_branch with out = 0");

# The degenerate capsule reports its own branch rather than a cap: start == end
# is a plain sphere, and a consumer differentiating it must know that dt/dend is
# zero because the shipped primal attributes the whole shape to `start`.
var jdeg = geo_capsule_new(hvec3_new(0, 0, 0), hvec3_new(0, 0, 0), F64_TWO);
var jdray = geo_ray_new(hvec3_new(f64_neg(f64_from(6)), 0, 0), hvec3_new(F64_ONE, 0, 0));
GeoRay_set_direction(jdray, hvec3_new(F64_ONE, 0, 0));
var jdj = geo_jet_capsule(jdray, jdeg);
assert_eq(geo_jet_hit(jdj), 1, "the degenerate capsule still produces a jet");
assert_eq(geo_jet_face(jdj), GEO_CAP_SPHERE, "a zero-length capsule reports GEO_CAP_SPHERE");

# The face encoding decodes back, all six. Small, but geo_face_axis /
# geo_face_is_max are the only thing standing between a face index and a wrong
# gradient axis, and nothing else in the suite reads them directly.
for (var fe = 0; fe < 6; fe = fe + 1) {
    assert_eq(geo_face_axis(fe), fe / 2, "geo_face_axis decodes the axis");
    assert_eq(geo_face_is_max(fe), fe % 2, "geo_face_is_max decodes the plane side");
}

# --- 2.10.1: two 2.10.0 entry points that had NO caller anywhere -------------
#
# `geo_jet_plane_ddistance` and `geo_jet_dpoint` shipped in 2.10.0 referenced by
# nothing -- they were 2 of the 5 functions in that release's 599/604 coverage
# gap. Reference coverage is a floor, not a correctness proof, but a PUBLIC
# entry point with no caller has not even cleared the floor.
# [measured: CHANGELOG.md 2.10.1, "Two 2.10.0 entry points had no caller anywhere" (599/604)]
var dpn = geo_plane_from_point_normal(hvec3_new(0, 0, F64_TWO), hvec3_new(0, 0, F64_ONE));
var dpo = hvec3_new(F64_ONE, f64_div(F64_ONE, F64_TWO), f64_neg(f64_from(4)));
var dpd = hvec3_new(f64_div(F64_ONE, f64_from(4)), f64_div(F64_ONE, f64_from(8)), F64_ONE);
var dpr = geo_ray_new(dpo, dpd);
GeoRay_set_direction(dpr, dpd);
var dpj = geo_jet_plane(dpr, dpn);
assert_eq(geo_jet_hit(dpj), 1, "the plane-jet coverage fixture actually hits");

# dt/d(distance) against a central difference of the shipped geo_ray_plane.
var ddlo = geo_ray_plane(dpr, dpn);
var dp_lo = alloc(sizeof(GeoPlane));
GeoPlane_set_normal(dp_lo, GeoPlane_normal(dpn));
GeoPlane_set_distance(dp_lo, f64_sub(GeoPlane_distance(dpn), _JT_H));
var dp_hi = alloc(sizeof(GeoPlane));
GeoPlane_set_normal(dp_hi, GeoPlane_normal(dpn));
GeoPlane_set_distance(dp_hi, f64_add(GeoPlane_distance(dpn), _JT_H));
var dd_fd = f64_div(f64_sub(geo_ray_plane(dpr, dp_hi), geo_ray_plane(dpr, dp_lo)),
  f64_mul(F64_TWO, _JT_H));
assert(_jt_close(geo_jet_plane_ddistance(dpj), dd_fd) == 1,
  "geo_jet_plane_ddistance matches central differences of geo_ray_plane");

# geo_jet_dpoint is the chain rule through geo_ray_at: for a unit perturbation of
# the origin along axis k it must equal d(hit point)/d(o_k), which is a vector.
# Checked on the SPHERE, whose hit point actually curves -- on a plane the answer
# is nearly the identity and a mistake in the dt term would barely show.
var dqs = geo_sphere_new(hvec3_new(0, 0, 0), f64_div(f64_from(3), F64_TWO));
var dqo = hvec3_new(f64_neg(f64_from(4)), f64_div(F64_ONE, F64_TWO), f64_div(F64_ONE, f64_from(4)));
var dqd = hvec3_new(F64_ONE, f64_div(F64_ONE, f64_from(8)), 0);
var dqr = geo_ray_new(dqo, dqd);
GeoRay_set_direction(dqr, dqd);
var dqj = geo_jet_sphere(dqr, dqs);
assert_eq(geo_jet_hit(dqj), 1, "the dpoint coverage fixture actually hits");
var dq_bad = 0;
for (var k = 0; k < 3; k = k + 1) {
    var e_k = _jt_bump(hvec3_new(0, 0, 0), k, F64_ONE);
    var got = geo_jet_dpoint(dqj, dqr, e_k, hvec3_new(0, 0, 0));
    var rlo = alloc(sizeof(GeoRay));
    GeoRay_set_origin(rlo, _jt_bump(dqo, k, f64_neg(_JT_H)));
    GeoRay_set_direction(rlo, dqd);
    var rhi = alloc(sizeof(GeoRay));
    GeoRay_set_origin(rhi, _jt_bump(dqo, k, _JT_H));
    GeoRay_set_direction(rhi, dqd);
    var plo = geo_ray_at(rlo, geo_ray_sphere(rlo, dqs));
    var phi = geo_ray_at(rhi, geo_ray_sphere(rhi, dqs));
    var fdv = hvec3_scale(hvec3_sub(phi, plo), f64_div(F64_ONE, f64_mul(F64_TWO, _JT_H)));
    for (var c = 0; c < 3; c = c + 1) {
        if (_jt_close(_jt_comp(got, c), _jt_comp(fdv, c)) == 0) { dq_bad = dq_bad + 1; }
    }
}
assert_eq(dq_bad, 0,
  "geo_jet_dpoint matches central differences of the hit POINT, all 3 axes x 3 components");

# The typed accessors are the point of the `kind` tag: the same slot holds
# dt/d(center) on a sphere jet and dt/d(normal) on a plane jet.
var jt_r = geo_ray_new(hvec3_new(f64_neg(f64_from(4)), 0, 0), hvec3_new(F64_ONE, 0, 0));
var jt_s = geo_jet_sphere(jt_r, geo_sphere_new(hvec3_new(0, 0, 0), F64_ONE));
var jt_p = geo_jet_plane(jt_r, geo_plane_from_point_normal(hvec3_new(0, 0, 0),
    hvec3_new(F64_ONE, 0, 0)));
assert_eq(geo_jet_hit(jt_s), 1, "sphere jet reports a hit");
assert_eq(geo_jet_hit(jt_p), 1, "plane jet reports a hit");
assert_eq(geo_jet_plane_dnormal(jt_s), 0,
  "a sphere jet refuses the PLANE accessor rather than reinterpreting its centre slot");
assert_eq(geo_jet_sphere_dradius(jt_p), 0,
  "a plane jet refuses the SPHERE accessor rather than returning its distance derivative");
assert_neq(geo_jet_sphere_dcenter(jt_s), 0, "...and the matching accessor still works");

# A miss returns READABLE zero vectors, never null -- the NULL-HVec3 hazard
# gjk_epa_3d fixed in 2.8.3 and mpr_penetration in 2.9.1.
var jt_miss = geo_jet_sphere(geo_ray_new(hvec3_new(f64_from(9), f64_from(9), f64_from(9)),
    hvec3_new(F64_ONE, 0, 0)), geo_sphere_new(hvec3_new(0, 0, 0), F64_ONE));
assert_eq(geo_jet_hit(jt_miss), 0, "a miss reports no hit");
assert_eq(HVec3_x(geo_jet_dorigin(jt_miss)), f64_from(0),
  "a miss still returns a readable dt/do, not a null pointer");

# Euler's relation on the RAW direction gradient. On the analytic jet this is
# near-tautological (dt/dd is built as t * dt/do, and d . dt/do == -1), so it is
# a smoke test -- but it is exactly the relation the shipped sphere BROKE before
# 2.10.0, so it is worth stating.
assert(f64_approx_eq(hvec3_dot(GeoRay_direction(jt_r), geo_jet_ddirection(jt_s)),
    f64_neg(geo_jet_t(jt_s)), LOOSE_TOL_M),
  "geo_jet_sphere: d . (dt/dd) == -t (Euler, degree -1 homogeneity)");
assert(f64_approx_eq(hvec3_dot(GeoRay_direction(jt_r),
      geo_jet_dt_dd_unit(geo_jet_ddirection(jt_s), GeoRay_direction(jt_r))), 0, LOOSE_TOL_M),
  "geo_jet_dt_dd_unit projects out the radial part exactly");

# central difference of geo_ray_triangle w.r.t. one component of one input
fn _jt_fd_tri(o, d, a, b, c, which, i) {
    var lo = 0;
    var hi = 0;
    for (var side = 0; side < 2; side = side + 1) {
        var h = _JT_H;
        if (side == 0) { h = f64_neg(_JT_H); }
        var oo = o; var dd = d; var aa = a; var bb = b; var cc = c;
        if (which == 0) { oo = _jt_bump(o, i, h); }
        if (which == 1) { dd = _jt_bump(d, i, h); }
        if (which == 2) { aa = _jt_bump(a, i, h); }
        if (which == 3) { bb = _jt_bump(b, i, h); }
        if (which == 4) { cc = _jt_bump(c, i, h); }
        var ray = geo_ray_new(oo, dd);
        GeoRay_set_direction(ray, dd);
        var tv = geo_ray_triangle(ray, geo_triangle_new(aa, bb, cc));
        if (side == 0) { lo = tv; } else { hi = tv; }
    }
    if (lo == 0) { return _GEO_JT_SKIP; }
    if (hi == 0) { return _GEO_JT_SKIP; }
    return f64_div(f64_sub(hi, lo), f64_mul(F64_TWO, _JT_H));
}

fn _jt_tri_sweep() {
    # ⚠ THE FIXTURE MUST DISCRIMINATE. A triangle symmetric about the ray, or a
    # head-on hit, zeroes components of dt/dv1 and dt/dv2 and lets a swapped or
    # sign-flipped vertex gradient pass -- the same trap the sphere sweep fell
    # into at radius 1. These three vertices are deliberately scalene and the
    # aim points are off-centre, so every component of every gradient is
    # non-trivial.
    var av = alloc(32);
    store64(av,      hvec3_new(f64_neg(F64_TWO), f64_neg(F64_ONE), 0));
    store64(av + 8,  hvec3_new(f64_from(3), f64_neg(F64_TWO), f64_div(F64_ONE, F64_TWO)));
    store64(av + 16, hvec3_new(0, f64_from(4), f64_neg(F64_ONE)));
    var a = load64(av);
    var b = load64(av + 8);
    var c = load64(av + 16);
    var oc = alloc(32);
    store64(oc,      hvec3_new(F64_ONE, 0, f64_from(6)));
    store64(oc + 8,  hvec3_new(f64_neg(F64_ONE), F64_ONE, f64_from(5)));
    store64(oc + 16, hvec3_new(f64_div(F64_ONE, F64_TWO), f64_neg(F64_ONE), f64_from(7)));
    var tg = alloc(32);
    store64(tg,      hvec3_new(0, 0, f64_neg(f64_div(F64_ONE, f64_from(4)))));
    store64(tg + 8,  hvec3_new(f64_div(F64_ONE, F64_TWO), f64_div(F64_ONE, F64_TWO), 0));
    store64(tg + 16, hvec3_new(f64_neg(f64_div(F64_ONE, F64_TWO)), 0, 0));
    for (var oi = 0; oi < 3; oi = oi + 1) {
        for (var ti = 0; ti < 3; ti = ti + 1) {
            var o = load64(oc + oi * 8);
            var d = hvec3_normalize(hvec3_sub(load64(tg + ti * 8), o));
            var ray = geo_ray_new(o, d);
            var j = geo_jet_triangle(ray, geo_triangle_new(a, b, c));
            if (geo_jet_hit(j) == 1) {
                for (var k = 0; k < 3; k = k + 1) {
                    _JT_BAD = _JT_BAD + _jt_cmp(_jt_comp(geo_jet_dorigin(j), k),
                      _jt_fd_tri(o, d, a, b, c, 0, k));
                    _JT_BAD = _JT_BAD + _jt_cmp(_jt_comp(geo_jet_ddirection(j), k),
                      _jt_fd_tri(o, d, a, b, c, 1, k));
                    _JT_BAD = _JT_BAD + _jt_cmp(_jt_comp(geo_jet_tri_dv0(j), k),
                      _jt_fd_tri(o, d, a, b, c, 2, k));
                    _JT_BAD = _JT_BAD + _jt_cmp(_jt_comp(geo_jet_tri_dv1(j), k),
                      _jt_fd_tri(o, d, a, b, c, 3, k));
                    _JT_BAD = _JT_BAD + _jt_cmp(_jt_comp(geo_jet_tri_dv2(j), k),
                      _jt_fd_tri(o, d, a, b, c, 4, k));
                }
            }
        }
    }
    return 0;
}

test_group("3.3.5 geo_diff: geo_jet_capsule's miss guards and geo_jet_dpoint on a miss");
var _g612_cap = geo_capsule_new(hvec3_zero(), hvec3_new(f64_from(3), 0, 0), F64_ONE);
var _g612_ray = geo_ray_new(hvec3_new(0x3FF8000000000000, F64_ONE, 0), hvec3_unit_y());   # on the barrel, outward
var _g612_out = alloc(GEO_FACE_OUT_BYTES);
assert_eq(geo_ray_capsule_branch(_g612_ray, _g612_cap, _g612_out), 0,
  "primal: origin ON the barrel at (1.5, 1, 0), pointing out: t = +0.0");
assert_eq(load64(_g612_out), GEO_CAP_CYLINDER,
  "primal: ... on the GEO_CAP_CYLINDER branch, so only the t test can answer the miss");
var _g612_j = geo_jet_capsule(_g612_ray, _g612_cap);
assert_eq(geo_jet_kind(_g612_j), GEO_JET_MISS, "geo_jet_capsule: a t = 0 contact on a real branch is the miss jet");
assert_eq(geo_jet_face(_g612_j), GEO_FACE_NONE, "geo_jet_capsule: ... carrying GEO_FACE_NONE, not the barrel");
var _g644_cap = geo_capsule_new(hvec3_zero(), hvec3_new(f64_from(3), 0, 0), F64_ONE);
var _g644_ray = geo_ray_new(hvec3_new(0x3FF8000000000000, F64_ONE, f64_neg(f64_from(5))), hvec3_unit_z());
assert_eq(geo_ray_capsule(_g644_ray, _g644_cap), f64_from(5),
  "primal: the ray grazes the barrel at (1.5, 1, 0), t = 5");
var _g644_j = geo_jet_capsule(_g644_ray, _g644_cap);
assert_eq(geo_jet_kind(_g644_j), GEO_JET_MISS,
  "geo_jet_capsule: tangent to the barrel (q.d = 0) is the miss jet, not -Inf/NaN gradients");
assert_eq(geo_jet_t(_g644_j), 0, "geo_jet_capsule: ... t = 0");
var _g792_ray = geo_ray_new(hvec3_new(f64_from(5), f64_from(5), F64_ONE), hvec3_new(0, 0, f64_neg(F64_ONE)));
var _g792_jm = geo_jet_sphere(_g792_ray, geo_sphere_new(hvec3_new(f64_from(10), 0, 0), F64_ONE));
assert_eq(geo_jet_hit(_g792_jm), 0, "control: the jet is a miss");
var _g792_dp = geo_jet_dpoint(_g792_jm, _g792_ray, hvec3_new(F64_ONE, F64_TWO, f64_from(3)), hvec3_unit_y());
assert_eq(HVec3_x(_g792_dp), 0, "geo_jet_dpoint on a miss jet: the zero vector (x), not d_origin");
assert_eq(HVec3_y(_g792_dp), 0, "geo_jet_dpoint on a miss jet: the zero vector (y)");
assert_eq(HVec3_z(_g792_dp), 0, "geo_jet_dpoint on a miss jet: the zero vector (z)");

test_group("2.10.0 geo_jet_triangle: all 15 partials match central differences");
var _JT_BAD_S = _JT_BAD;
var _JT_RUN_S = _JT_RUN;
_jt_tri_sweep();
assert_gt(_JT_RUN - _JT_RUN_S, 40,
  "the triangle jet sweep compared a useful number of samples");
assert_eq(_JT_BAD - _JT_BAD_S, 0,
  "geo_jet_triangle: dt/do, dt/dd and all three vertex gradients match FD");

var jtt_r = geo_ray_new(hvec3_new(F64_ONE, 0, f64_from(6)), hvec3_new(0, 0, f64_neg(F64_ONE)));
var jtt = geo_jet_triangle(jtt_r, geo_triangle_new(
    hvec3_new(f64_neg(F64_TWO), f64_neg(F64_ONE), 0),
    hvec3_new(f64_from(3), f64_neg(F64_TWO), f64_div(F64_ONE, F64_TWO)),
    hvec3_new(0, f64_from(4), f64_neg(F64_ONE))));
assert_eq(geo_jet_hit(jtt), 1, "triangle jet reports a hit");
assert_eq(geo_jet_sphere_dradius(jtt), 0,
  "a triangle jet refuses the SPHERE accessor");
assert_eq(geo_jet_tri_dv1(jt_s), 0,
  "a sphere jet refuses the TRIANGLE accessor rather than reading its unused slot");

# Translation identity. ⚠ SMOKE TEST ONLY: the three vertex expressions cancel
# algebraically to n/den, so this holds for ANY shared error in them. The FD
# sweep above is the real oracle; this is here because a reader will expect it.
var jt_sum = hvec3_add(hvec3_add(geo_jet_tri_dv0(jtt), geo_jet_tri_dv1(jtt)),
  geo_jet_tri_dv2(jtt));
assert(f64_approx_eq(hvec3_length(hvec3_add(jt_sum, geo_jet_dorigin(jtt))), 0, LOOSE_TOL_M),
  "triangle: sum of vertex gradients == -dt/do (translating the tri == translating the ray)");

test_group("3.3.5 geo_diff: geo_jet_triangle at a zero t");
var _g373_tri = geo_triangle_new(hvec3_zero(), hvec3_unit_x(), hvec3_unit_y());
var _g373_jm = geo_jet_triangle(geo_ray_new(hvec3_new(f64_from(5), f64_from(5), F64_ONE),
    hvec3_new(0, 0, f64_neg(F64_ONE))), _g373_tri);
assert_eq(geo_jet_kind(_g373_jm), GEO_JET_MISS, "geo_jet_triangle: a ray that misses the triangle is the miss jet");
assert_eq(geo_jet_t(_g373_jm), 0, "geo_jet_triangle: ... t = 0");
assert_eq(HVec3_z(geo_jet_dorigin(_g373_jm)), 0, "geo_jet_triangle: ... dt/do.z = 0, not -1/(n.d)");
var _g373_j0 = geo_jet_triangle(geo_ray_new(hvec3_new(0x3FD0000000000000, 0x3FD0000000000000, 0),
    hvec3_new(0, 0, f64_neg(F64_ONE))), _g373_tri);
assert_eq(geo_jet_kind(_g373_j0), GEO_JET_MISS,
  "geo_jet_triangle: origin ON the triangle from the front (primal t = +0.0) is the miss jet");

test_group("3.3.6 geo_diff: a contact at t = -0.0 is the miss jet, as at +0.0");
# A contact at t = 0 is the miss for every primal (src/geo.cyr, "A CONTACT AT t = 0"),
# whichever zero the arithmetic gives; through 3.3.5 the jets tested the integer t == 0
# and built a hit jet, gradients and all, for t = -0.0.
var _g736_r = geo_ray_new(hvec3_new(0x3FD0000000000000, 0x3FD0000000000000, 0), hvec3_unit_z());
# (3.4.1: re-derived. The contact is decided exactly now (t a = 0, _geo_ray_tri_exact) and answered
# +0; 3.4.0's arithmetic gave -0.0. The jet below must still be the miss; the -0.0 contacts of the
# plane, box and OBB below keep this group's -0.0 case.)
assert_eq(geo_ray_triangle(_g736_r, _g373_tri), 0,
  "geo_ray_triangle: origin ON the triangle along +z: the contact at t = 0 is the miss, +0 (3.4.0: -0.0)");
assert_eq(geo_jet_kind(geo_jet_triangle(_g736_r, _g373_tri)), GEO_JET_MISS,
  "geo_jet_triangle: ... and the jet the miss (3.3.5: a hit jet)");
var _g736_pl = alloc(sizeof(GeoPlane));
GeoPlane_set_normal(_g736_pl, hvec3_unit_z());
GeoPlane_set_distance(_g736_pl, 0);
var _g736_rp = geo_ray_new(hvec3_new(0x3FD3333333333333, 0x3FC999999999999A, 0), hvec3_new(0, 0, f64_neg(F64_ONE)));
assert_eq(geo_ray_plane(_g736_rp, _g736_pl), 0x8000000000000000,
  "geo_ray_plane: origin IN the plane z = 0, moving down: the primal answers -0.0");
assert_eq(geo_jet_kind(geo_jet_plane(_g736_rp, _g736_pl)), GEO_JET_MISS,
  "geo_jet_plane: ... and the jet the miss (3.3.5: a hit jet)");
var _g736_ra = geo_ray_new(hvec3_new(F64_ONE, F64_HALF, F64_HALF), hvec3_new(f64_neg(F64_ONE), 0, 0));
var _g736_fo = alloc(GEO_FACE_OUT_BYTES);
assert_eq(geo_ray_aabb_face(_g736_ra, geo_aabb_new(hvec3_zero(), hvec3_one()), _g736_fo), 0x8000000000000000,
  "geo_ray_aabb_face: origin ON the max-x face moving in: the primal answers -0.0");
assert_eq(load64(_g736_fo), 1, "geo_ray_aabb_face: ... on face 1, the contact's face");
assert_eq(geo_jet_kind(geo_jet_aabb(_g736_ra, geo_aabb_new(hvec3_zero(), hvec3_one()))), GEO_JET_MISS,
  "geo_jet_aabb: ... and the jet the miss (3.3.5: a hit jet)");
var _g736_ob = geo_obb_new(hvec3_splat(F64_HALF), hvec3_splat(F64_HALF), hquat_identity());
assert_eq(geo_ray_obb_face(_g736_ra, _g736_ob, _g736_fo), 0x8000000000000000,
  "geo_ray_obb_face: origin ON the axis-0 max face moving in: the primal answers -0.0");
assert_eq(geo_jet_kind(geo_jet_obb(_g736_ra, _g736_ob)), GEO_JET_MISS,
  "geo_jet_obb: ... and the jet the miss (3.3.5: a hit jet)");
# A root of a round surface that underflows below zero is behind the origin, not a contact
# (_geo_quad_roots, _geo_root_ldexp): from 1 + 2^-52 along 2^1023 x both roots of the unit
# sphere are behind, the near one about -2^-1075, and the answer is the miss +0 with no
# branch (the capsule (-1,0,0)-(0,0,0) alike); and from just inside, where that root is
# behind and the exit ahead, the exit: the unit sphere from 1 - 2^-53 along -2^1023 x
# leaves at 2^-1022, a sphere of radius 2^-1030 from 2^-1030 - 2^-1074 along -2 x at
# 2^-1030 (3.3.5: NaN, NaN and 2^-1031; the first hand-back of 3.3.6: -0 for all three); the
# capsule (0,0,0)-(-2^-1029,0,0) of that radius, solved as a copy at unit size since round 3
# (round 2 read it as a sphere at its start, |ab|^2 having flushed: 2^-1030), leaves through
# its end cap at 2^-1029 - 2^-1075, which rounds to 2^-1029 (ties to even).
var _g736_rs = geo_ray_new(hvec3_new(0x3FF0000000000001, 0, 0), hvec3_unit_x());
GeoRay_set_direction(_g736_rs, hvec3_new(0x7FE0000000000000, 0, 0));
var _g736_us = geo_sphere_new(hvec3_zero(), F64_ONE);
assert_eq(geo_ray_sphere(_g736_rs, _g736_us), 0, "geo_ray_sphere: both roots behind, the near one under 2^-1075: 0");
assert_eq(geo_jet_kind(geo_jet_sphere(_g736_rs, _g736_us)), GEO_JET_MISS, "geo_jet_sphere: ... and the jet the miss");
var _g736_uc = geo_capsule_new(hvec3_new(f64_neg(F64_ONE), 0, 0), hvec3_zero(), F64_ONE);
assert_eq(geo_ray_capsule_branch(_g736_rs, _g736_uc, _g736_fo), 0, "geo_ray_capsule_branch: the same end cap: 0");
assert_eq(load64(_g736_fo), GEO_FACE_NONE, "geo_ray_capsule_branch: ... with no branch");
assert_eq(geo_jet_kind(geo_jet_capsule(_g736_rs, _g736_uc)), GEO_JET_MISS, "geo_jet_capsule: ... and the jet the miss");
var _g736_ri = geo_ray_new(hvec3_new(0x3FEFFFFFFFFFFFFF, 0, 0), hvec3_unit_x());
GeoRay_set_direction(_g736_ri, hvec3_new(0xFFE0000000000000, 0, 0));
assert_eq(geo_ray_sphere(_g736_ri, _g736_us), 0x0010000000000000,
  "geo_ray_sphere: from 1 - 2^-53 inside along -2^1023 x: the exit 2^-1022, not the -0 behind");
var _g736_rt = geo_ray_new(hvec3_new(0x00000FFFFFFFFFFF, 0, 0), hvec3_unit_x());
GeoRay_set_direction(_g736_rt, hvec3_new(0xC000000000000000, 0, 0));
assert_eq(geo_ray_sphere(_g736_rt, geo_sphere_new(hvec3_zero(), 0x0000100000000000)), 0x0000100000000000,
  "geo_ray_sphere: radius 2^-1030 from just inside along -2 x: the exit 2^-1030 (3.3.5: 2^-1031)");
assert_eq(geo_ray_capsule_branch(_g736_rt, geo_capsule_new(hvec3_zero(), hvec3_new(0x8000200000000000, 0, 0),
      0x0000100000000000), _g736_fo), 0x0000200000000000, "geo_ray_capsule_branch: ... its capsule: 2^-1029");
assert_eq(load64(_g736_fo), GEO_CAP_END_CAP, "geo_ray_capsule_branch: ... through its end cap (round 2: a sphere)");
# The same on the unscaled path: from (1, 2^-282, 0) along 2^510 x, c = 2^-564 exactly and
# q = -2^511, so c / q = -2^-1075 reads -0; both roots are behind, and the answer is 0.
var _g736_rc = geo_ray_new(hvec3_new(F64_ONE, 0x2E50000000000000, 0), hvec3_unit_x());
GeoRay_set_direction(_g736_rc, hvec3_new(0x5FD0000000000000, 0, 0));
assert_eq(geo_ray_sphere(_g736_rc, _g736_us), 0, "geo_ray_sphere: c / q = -2^-1075 behind the origin: the miss 0");
assert_eq(geo_ray_sphere(geo_ray_new(hvec3_unit_x(), hvec3_unit_x()), _g736_us), 0,
  "geo_ray_sphere: origin ON the unit sphere moving out: +0.0, as in 3.3.5");
assert_eq(geo_ray_capsule_branch(geo_ray_new(hvec3_new(F64_ONE, 0, 0), hvec3_unit_x()), _g736_uc, _g736_fo), 0,
  "geo_ray_capsule_branch: origin ON its end cap moving out: +0.0, as in 3.3.5");
# ... and the contact is the end cap's: its root c / q = -0 is read +0 (c = 0), which the
# capsule accepts; read as the -2^-1074 an underflowing root carries, it was refused.
assert_eq(load64(_g736_fo), GEO_CAP_END_CAP, "geo_ray_capsule_branch: ... the contact reported on the end cap");

test_group("3.3.6 geo_diff: geo_jet_triangle where the primal's a and the jet's den round apart");
# Legs s = 0x1FF1F5FAB7CD0488 (about 2^-511) and the raw direction (0, 0, -c), c =
# 0x3FE964EF4831B102: a = e1 . (d x e2) stays above 2^-1024, so the primal hits, but
# den = (e1 x e2) . d, the same number rounded through the subnormal s^2, falls below
# it and 1 / den overflowed: 3.3.5 answered the miss jet. The scaled gradients now: t is
# the primal's, and dt/do.z = 1/c within an ulp (exact 0x3FF4297A64294850).
# [measured: C336 probe and exact Fraction value, 3.3.5 vs this tree, 2026-10-11; cycc 6.6.14]
var _g738_s = 0x1FF1F5FAB7CD0488;
var _g738_tri = geo_triangle_new(hvec3_zero(), hvec3_new(_g738_s, 0, 0), hvec3_new(0, _g738_s, 0));
var _g738_q = f64_mul(_g738_s, 0x3FD0000000000000);
var _g738_r = alloc(sizeof(GeoRay));
# (s/4, s/8): barycentric weights (5/8, 1/4, 1/8), off the beta1 = beta2 line, so dt/dv1 and
# dt/dv2 differ and a swap of their formulas shows.
GeoRay_set_origin(_g738_r, hvec3_new(_g738_q, f64_mul(_g738_s, 0x3FC0000000000000), F64_ONE));
GeoRay_set_direction(_g738_r, hvec3_new(0, 0, 0xBFE964EF4831B102));
var _g738_j = geo_jet_triangle(_g738_r, _g738_tri);
# (3.4.1: re-derived. t = 1/c exactly rounds to 0x3FF4297A64294850; the pre-scaled primal gives
# ...484F, 3.4.0's unscaled one ...484B; dt/dd.z follows, exact 1/c^2 0x3FF9681D8150C242.)
assert_eq(geo_ray_triangle(_g738_r, _g738_tri), 0x3FF4297A6429484F, "geo_ray_triangle: legs ~2^-511, the primal hits");
assert_eq(geo_jet_kind(_g738_j), GEO_JET_TRIANGLE, "geo_jet_triangle: ... and so does the jet (3.3.5: the miss jet)");
assert_eq(geo_jet_t(_g738_j), 0x3FF4297A6429484F, "geo_jet_triangle: ... carrying the primal's t");
assert_eq(HVec3_z(geo_jet_dorigin(_g738_j)), 0x3FF4297A6429484F, "geo_jet_triangle: ... dt/do.z = 1/c within an ulp");
assert_eq(HVec3_z(geo_jet_ddirection(_g738_j)), 0x3FF9681D8150C241, "geo_jet_triangle: ... dt/dd.z = t * dt/do.z");
var _g738_dv1 = 0;
if (geo_jet_kind(_g738_j) == GEO_JET_TRIANGLE) { _g738_dv1 = HVec3_z(geo_jet_tri_dv1(_g738_j)); }
assert_eq(_g738_dv1, 0xBFD4297A6429484F, "geo_jet_triangle: ... dt/dv1.z = -dt/do.z / 4");
# dt/dv0 and dt/dv2 by their barycentric weights 5/8 and 1/8: z = -5/(8c) and -1/(8c), each
# within an ulp (exact 0xBFE933D8FD339A64 and 0xBFC4297A64294850).
var _g738_dv0 = 0;
var _g738_dv2 = 0;
if (geo_jet_kind(_g738_j) == GEO_JET_TRIANGLE) {
    _g738_dv0 = HVec3_z(geo_jet_tri_dv0(_g738_j));
    _g738_dv2 = HVec3_z(geo_jet_tri_dv2(_g738_j));
}
assert_eq(_g738_dv0, 0xBFE933D8FD339A63, "geo_jet_triangle: ... dt/dv0.z = -5 dt/do.z / 8");
assert_eq(_g738_dv2, 0xBFC4297A6429484F, "geo_jet_triangle: ... dt/dv2.z = -dt/do.z / 8");
# n = e1 x e2 subnormal while 1 / den is finite: legs about 2^-530 with d near 2^37, where
# n's products kept only the bits above 2^-1074 and dt/do was 3.5e-5 off (3.3.5 and the
# first hand-back). Exact dt/do RN (0xBDA1C4F907981204, 0x3D767EE213772806,
# 0x3D9F1E003DF76C4E); the scaled copy gives each within an ulp.
# [measured: C336 probe and exact Fraction value, 3.3.5 vs this tree, 2026-10-11; cycc 6.6.14]
var _g739_r = alloc(sizeof(GeoRay));
GeoRay_set_origin(_g739_r, hvec3_new(0xC24C526C84BEF114, 0x424B17B8128D9C8D, 0xC24009B176170A49));
GeoRay_set_direction(_g739_r, hvec3_new(0x4245F9E7B857F99E, 0xC24505B66B41A224, 0x4238E38E4F79DE54));
var _g739_j = geo_jet_triangle(_g739_r, geo_triangle_new(hvec3_new(0x1EC6B6A8D98348EC, 0x1ECC2C24953FBAB1,
      0x1ECC174A593670F6), hvec3_new(0x1EC2CE5F25C15B06, 0x9EC9C477FCEF2AC4, 0x1ED0B0450116E1A5),
    hvec3_new(0x9ED209E7A9723DED, 0x9ED7BCA49C3177BD, 0x9EC961D44EDEDA76)));
# (3.4.1: re-derived. This ray MISSES the triangle: exact rational Moller-Trumbore u = -1.86e154,
# v = 2.9e152 -- it crosses the plane 8.8e-6 from the centroid of a triangle about 1e-159 across
# (9e153 triangle sizes away; GEO2 3.4.1, review RV-GEO S2: not "1e10"). 3.3.6 checked the
# gradients against the exact derivative of a hit it never verified; the primal's u and v were
# o - v0's rounding (o - v0 = o). The certified pre-scaled primal answers the miss, and so does the
# jet. A hit of the same scales, aimed along an axis, is in the 3.4.1 block.)
assert_eq(geo_ray_triangle(_g739_r, geo_triangle_new(hvec3_new(0x1EC6B6A8D98348EC, 0x1ECC2C24953FBAB1,
        0x1ECC174A593670F6), hvec3_new(0x1EC2CE5F25C15B06, 0x9EC9C477FCEF2AC4, 0x1ED0B0450116E1A5),
      hvec3_new(0x9ED209E7A9723DED, 0x9ED7BCA49C3177BD, 0x9EC961D44EDEDA76))), 0,
  "geo_ray_triangle: legs ~2^-530, d ~2^37, a ray 8.8e-6 off a 1e-159 triangle: the miss (3.4.0: a hit)");
assert_eq(geo_jet_kind(_g739_j), GEO_JET_MISS, "geo_jet_triangle: ... and the miss jet");

test_group("3.3.7 geo: tiny and far capsules, the barrel's accuracy, origins within an ulp of a centre");
# Every expected value below is the exact answer correctly rounded (exact rational roots,
# Decimal square roots in the cancellation-free form), or within the ulp stated; "3.3.6"
# is that tree's answer under cycc 6.6.20.
# [measured: rt337 fixtures (fixtures.py), exact roots, 3.3.6 vs this tree, 2026-10-31]
fn _g737_ray(ox, oy, oz, dx, dy, dz) {
    var r = alloc(sizeof(GeoRay));
    GeoRay_set_origin(r, hvec3_new(ox, oy, oz));
    GeoRay_set_direction(r, hvec3_new(dx, dy, dz));
    return r;
}
var _g737_br = alloc(16);
# A capsule 2^-600 long, r = 2^-602, met from (2^-601, 1, 0) along -y: the barrel at
# 1 - 3 * 2^-602, which rounds to 1 (3.3.6: the miss, |ab|^2 having flushed to 0 and the
# capsule read as its start sphere, which the ray passes beside).
assert_eq(geo_ray_capsule_branch(_g737_ray(0x1A60000000000000, F64_ONE, 0, 0, 0xBFF0000000000000, 0),
    geo_capsule_new(hvec3_zero(), hvec3_new(0x1A70000000000000, 0, 0), 0x1A50000000000000), _g737_br), F64_ONE,
  "geo_ray_capsule_branch: a capsule 2^-600 long from unit distance: its barrel at 1 (3.3.6: a miss)");
assert_eq(load64(_g737_br), GEO_CAP_CYLINDER, "geo_ray_capsule_branch: ... on the barrel");
# Not tiny all through (r = 1.3 * 2^-480) and not far: the scaled axis. The first hit is the
# end cap (3.3.6: GEO_CAP_SPHERE, the right t on a capsule that is not a sphere).
assert_eq(geo_ray_capsule_branch(_g737_ray(0x220F333333333334, 0x21E0000000000000, 0x21D0000000000000,
      0xBFF0000000000000, 0, 0), geo_capsule_new(hvec3_zero(), hvec3_new(0x1A70000000000000, 0x1A60000000000000,
        0x1A50000000000000), 0x21F4CCCCCCCCCCCD), _g737_br), 0x2205CF8662EEA781,
  "geo_ray_capsule_branch: a fat capsule 2^-600 long, three radii out: t rounded");
assert_eq(load64(_g737_br), GEO_CAP_END_CAP, "geo_ray_capsule_branch: ... on its end cap, not GEO_CAP_SPHERE");
# A capsule ~2^-553 long from unit distance along -3 x, solved from where the ray passes it
# (_geo_capsule_far): its start cap, t within 0.34 ulp (3.3.6: GEO_CAP_SPHERE).
assert_eq(geo_ray_capsule_branch(_g737_ray(0x3FFBB7CC865D47BB, 0x9D610518E8C0D0CF, 0x9D58ACC52DF9E3D8,
      0xC008000000000000, 0, 0), geo_capsule_new(hvec3_new(0x9D50000000000000, 0x9D68000000000000, 0),
      hvec3_new(0x1D4B333333333334, 0x9D70CCCCCCCCCCCD, 0x1D60000000000000), 0x1D5F1B2BDD28D873), _g737_br),
  0x3FE27A8859938527, "geo_ray_capsule_branch: a far tiny capsule: its start cap, t within an ulp");
assert_eq(load64(_g737_br), GEO_CAP_START_CAP, "geo_ray_capsule_branch: ... on its start cap");
# Far capsules the far copy decides (the robust tests alone answer the cap, or 4 ulp off): one
# 2^-54 of its distance across (2^319 long, r 2^320.6), by its barrel just under 2^367 (the exact
# root rounded); one 2^-825 long from 0.72 away (rounded).
# [measured: rt2 far-copy hunt (mutant without the copy), exact roots, this tree, 2026-10-31]
assert_eq(geo_ray_capsule_branch(_g737_ray(0x53E0683E477DDC52, 0xD3CBA55D771F16E9, 0xD3CC203D3658218E,
      0x406710FC0524E32C, 0xC0358D52838C24EA, 0x4043D34090D36CC8), geo_capsule_new(hvec3_new(0x575710FC0524E32C,
        0xD7258D52838C24EA, 0x5733D34090D36CC8), hvec3_new(0x575710FC0524E32C, 0xD7258D52838C24E9,
        0x5733D34090D36CC8), 0x53F8F47BDC587AFB), _g737_br), 0x56DFFFFFFFFFFFFF,
  "geo_ray_capsule_branch: a far capsule, from where the ray passes it: t rounded");
assert_eq(load64(_g737_br), GEO_CAP_CYLINDER, "geo_ray_capsule_branch: ... on the barrel, not the start cap");
assert_eq(geo_ray_capsule(_g737_ray(0x3FE7304F771393C4, 0x8C3351B3EBEADE98, 0x8C1292C838482A10, 0xBFE8000000000000,
      0, 0), geo_capsule_new(hvec3_new(0x0C40000000000000, 0x8C64000000000000, 0), hvec3_new(0x0C4B000000000000,
        0x8C57000000000000, 0x0C60000000000000), 0x0C6679E865B62D5D)), 0x3FEEEB149EC4C505,
  "geo_ray_capsule: a capsule 2^-825 long from 0.72: t rounded");
# Far, with t past DBL_MAX: +Inf on the barrel (3.3.6: +Inf on the start cap, an Inf - Inf
# NaN in a first draft of the far copy).
assert_eq(geo_ray_capsule_branch(_g737_ray(0, 0x6BCF7A08507F8363, 0x6BC7269CDD74AF95, 0x1200000000000000, 0, 0),
    geo_capsule_new(hvec3_new(0x6E0EDABD94077472, 0x6BC872C5BE2A7A90, 0x6BC432AB0A6FD000),
      hvec3_new(0x6E0EDABD9404E9D5, 0xEBC4022DF8D54F68, 0x6BE92D848DE1EF3D), 0x6BCABDFF01DA1BF4), _g737_br),
  0x7FF0000000000000, "geo_ray_capsule_branch: a far capsule met past DBL_MAX: +Inf");
assert_eq(load64(_g737_br), GEO_CAP_CYLINDER, "geo_ray_capsule_branch: ... on its barrel");
# Far, passing 2^90 beside a capsule 2^48 long at 2^100: the miss, answered before the copy
# (without that test the copy is as far again, and the recursion does not end).
assert_eq(geo_ray_capsule(_g737_ray(0, 0, 0, F64_ONE, 0x3F50000000000000, 0), geo_capsule_new(hvec3_new(
        0x4630000000000000, 0, 0), hvec3_new(0x4630000000000001, 0, 0), F64_HALF)), 0,
  "geo_ray_capsule: a far ray passing 2^42 lengths beside the capsule: the miss");
# The barrel's accuracy (roadmap: 4,993 ulp at 1.6e4 radii along the axis; exact
# 0x3FFEBDA633ED69E0, 0.502 ulp off) and a ray 1e4 radii along (3.3.6: 0x400496BD67684030,
# 583 ulp; exact rounds to the pinned bits).
# [measured: rt337 fixtures (fixtures.py), exact roots, 3.3.6 vs this tree, 2026-10-31]
assert_eq(geo_ray_capsule(_g737_ray(0x40B33F8C8241857E, 0x40C11DCB5B12F347, 0x40C5E584F5870178, 0x3FEE0C4B13CD9C32,
      0xBFDC585CFBBBDF75, 0xBFB373E859BE4F37), geo_capsule_new(hvec3_new(0xBFE4115D01803530, 0xC01042355B1B6BD0,
        0x4011477561717E7E), hvec3_new(0x40CB8F220269B35E, 0x40D87EC08203A8B0, 0x40DF5299636F48FC), F64_ONE)),
  0x3FFEBDA633ED69DF, "geo_ray_capsule: the roadmap's barrel ray 1.6e4 radii along: within an ulp (3.3.6: 4,993)");
assert_eq(geo_ray_capsule(_g737_ray(0xC0BB3E0F4DDF683C, 0x40BA859F1FDFD190, 0x40A1F5E60CC663BA, 0xBFE2ECC5283EE135,
      0x3FD1CCD8BC706129, 0xBFE83878D73BDB4E), geo_capsule_new(hvec3_new(0xBFEA310497A94544, 0x3FE5E518DBEFD3E0,
        0x3FC9B73CFD8B5000), hvec3_new(0xC0D2AD7A8F1CBBF1, 0x40D22DA6EEAE0B45, 0x40B89890622B6F71), F64_ONE)),
  0x400496BD67684277, "geo_ray_capsule: a barrel ray 1e4 radii along: t rounded");
# A barrel of radius 2^-159 on a 68-unit axis, met along -x from 0.65: the offset of the ray
# from the axis taken from the inputs (_geo_cap_axis_offset); 3.3.6 answered the miss.
assert_eq(geo_ray_capsule_branch(_g737_ray(0x3FE4E046F97542D8, 0xB5F94007216AA958, 0x35F81F5B51B7284C,
      0xBFF0000000000000, 0, 0), geo_capsule_new(hvec3_new(0x4038000000000000, 0x4010000000000000,
        0xC038000000000000), hvec3_new(0xC038000000000000, 0xC010000000000000, 0x4038000000000000),
      0x35FA2A0DCD9358F0), _g737_br), 0x3FE4E046F97542D8,
  "geo_ray_capsule_branch: a thin barrel: t rounded (3.3.6: miss)");
# A capsule of radius 2^-183 on a 2.75-unit axis, met along +z from 0.52 below its end at 0:
# its barrel, the offset and the end cap's side taken from the inputs (_geo_cap_axis_offset,
# _geo_cap_side_exact); 3.3.6 answered 7.5e-9 later (0x3FE08E4A18B6F7F2).
assert_eq(geo_ray_capsule_branch(_g737_ray(0x347EF0314BF62BA3, 0xB45BEA29E2F8E19B, 0xBFE08E4A1CBDB6C4, 0, 0,
      F64_ONE), geo_capsule_new(hvec3_new(0x3FF8000000000000, 0xBFFC000000000000, 0xBFF8000000000000),
      hvec3_zero(), 0x348129B9A7AF3F2E), _g737_br), 0x3FE08E4A1CBDB6C4,
  "geo_ray_capsule_branch: a thin capsule's barrel by its end: t rounded");
assert_eq(load64(_g737_br), GEO_CAP_CYLINDER, "geo_ray_capsule_branch: ... the barrel, not its end cap");
# A ray past the end plane of a barrel of radius 2^-164: its cylinder crossing is off the segment, and
# the segment test is taken from where the root lies (_geo_cap_seam_proj); 3.3.6 answered
# 0x3FC8EB88EF51E69A on the barrel.
assert_eq(geo_ray_capsule_branch(_g737_ray(0x3FE2B0A6B37D6CF3, 0xB5B2A43CF27250D9, 0x359A354E17FC1395,
      0xC008000000000000, 0, 0), geo_capsule_new(hvec3_new(0x3FF8000000000000, 0x4002000000000000,
        0xBFF0000000000000), hvec3_zero(), 0x35A7A1F2B26F259C), _g737_br), 0,
  "geo_ray_capsule_branch: past a thin barrel's end plane: the miss (3.3.6: a barrel hit)");
assert_eq(load64(_g737_br), GEO_FACE_NONE, "geo_ray_capsule_branch: ... with no branch");
# Thin barrels whose ray passes within their radius of the axis: (o - start) . (ab x d)
# formed with n = ab x d's own rounding carried (a 0.57-unit axis of full-mantissa direction,
# r = 2^-87, the barrel at 4.59 within 0.14 ulp; without that part, the miss); with
# o - start's (r = 2^-253 on a 14-unit axis: the miss, 3.3.6 a hit at 2.18); a ray past a
# thin barrel's START plane (the miss, the start plane's own test); and the far root's side
# of the end plane (a barrel of radius 2^-48: the barrel within 0.96 ulp, 3.3.6 6 ulp off).
# [measured: rt337 fixtures (fixtures.py), exact roots, 3.3.6 vs this tree, 2026-10-31]
assert_eq(geo_ray_capsule_branch(_g737_ray(0xBFF6082C5537FB32, 0xBA80AFEC4E5E8658, 0x3A70721AC3F1FD4C,
      0x3FD3333333333333, 0, 0), geo_capsule_new(hvec3_new(0x3FCD82808EDBE386, 0x3FC3E23ED7D18A32,
        0x3FAF83DBE347D2C8), hvec3_new(0xBFCD82808EDBE386, 0xBFC3E23ED7D18A32, 0xBFAF83DBE347D2C8),
      0x3A7BA920A33F1E0D), _g737_br), 0x40125C24F1AEA6AA, "geo_ray_capsule_branch: a full-mantissa thin axis: t");
assert_eq(geo_ray_capsule(_g737_ray(0x30216C0EEF1EA12A, 0x3FFA1A94E5EA962A, 0x3017EC43BE2C674E, 0,
      0xBFE8000000000000, 0), geo_capsule_new(hvec3_new(0xC010000000000000, 0, 0x4018000000000000),
      hvec3_new(0x4010000000000000, 0, 0xC018000000000000), 0x30127F6EE2C58659)), 0,
  "geo_ray_capsule: a barrel of radius 2^-253 passed beside: the miss (3.3.6: 2.18)");
assert_eq(geo_ray_capsule(_g737_ray(0x328E8B5A5BB6DCBA, 0xB271F30B299FE75C, 0xBFFFA38B2E6F686D, 0, 0,
      0x3FE8000000000000), geo_capsule_new(hvec3_zero(), hvec3_new(0xBFE2000000000000, 0x3FC8000000000000,
        0x3FB0000000000000), 0x3281091C0176C968)), 0, "geo_ray_capsule: past a thin barrel's start plane: the miss");
assert_eq(geo_ray_capsule_branch(_g737_ray(0xBCA2692A4B723604, 0x3CE3A0B2BE12794D, 0x3FF80CE76EFE154A, 0, 0,
      0xBFE8000000000000), geo_capsule_new(hvec3_new(0xBFE0000000000000, 0, 0x3FD4000000000000), hvec3_zero(),
      0x3CE86EE3BC42E0AC), _g737_br), 0x4000089A49FEB8D6,
  "geo_ray_capsule_branch: by a thin barrel's end: t (3.4.1 GEO4: the exact root rounded; s14 ...8D7, 0.96 ulp)");
assert_eq(load64(_g737_br), GEO_CAP_CYLINDER, "geo_ray_capsule_branch: ... on the barrel, not the end cap");
# Far capsules: one 2.1e62 long at 1.7e81 whose start is under an ulp of the origin's
# coordinates, missed (3.3.6: a hit on its end cap at 2^260; the copy needs o - start's
# rounding); and one behind the origin (the copy would answer a negative t).
assert_eq(geo_ray_capsule(_g737_ray(0xCD63DBF0F97E5A4A, 0x4D16DEFF92E5F9B4, 0, 0xC08C8C989FC10A98,
      0xC051460CF8379990, 0), geo_capsule_new(hvec3_new(0xD0CC8C989FC10A98, 0xD091460CF8379990,
        0xCCE028B3DA36C23E), hvec3_new(0xD0CC8C989FC10A98, 0xD091460CF8379990, 0), 0x4CF0B701ED772078)), 0,
  "geo_ray_capsule: a far capsule beside the origin's own coordinates: the miss (3.3.6: 2^260)");
assert_eq(geo_ray_capsule(_g737_ray(0, 0, 0, 0xBFF0000000000000, 0, 0), geo_capsule_new(hvec3_new(
        0x4630000000000000, 0, 0), hvec3_new(0x4630000000001000, 0, 0), 0x4390000000000000)), 0,
  "geo_ray_capsule: a far capsule behind the origin: the miss");
# The decisions the review's mutants reached (each value the exact root rounded or within the
# ulp stated, by an exact oracle; "3.3.6" that tree's answer):
# - a far capsule ((1, 1, 1) long, r 0.1, 2^39 out) whose start's offset from the ray reads 1.18
#   by its largest component, past |ab| + r = 1.1 though the ray meets it: the barrel (3.3.6
#   0x4270000000000000, 803 ulp), not the passes-outside miss (its bound is 2 (|ab| + r));
# - a barrel root at a thin barrel's end plane (r 2^-41), the segment test's window: the barrel
#   at 1 (exact);
# - start / end caps (r 2^-23, 2^-28, 2^-29) whose side term is within its rounding of 0, the
#   side from where the root lies (its window, o - cap's rounding, h over |d|): exact or within
#   0.88 ulp;
# - the end-plane side's |ab| (r 2^-36): the barrel at 1 + 2^-51 (exact).
# [measured: rt2 review repros (rt2e/surv.py), exact roots, 3.3.6 vs this tree, 2026-10-31]
assert_eq(geo_ray_capsule_branch(_g737_ray(0, 0, 0, F64_HALF, F64_HALF, 0xBFE8000000000000), geo_capsule_new(
      hvec3_new(0x425FFFFFFFFFC000, 0x425FFFFFFFFFC000, 0xC268000000002000), hvec3_new(0x4260000000000000,
        0x4260000000000000, 0xC268000000000000), 0x3FB999999999999A), _g737_br), 0x426FFFFFFFFFFCDD,
  "geo_ray_capsule_branch: a far capsule passed within its bound: its barrel (3.3.6: 803 ulp)");
assert_eq(load64(_g737_br), GEO_CAP_CYLINDER, "geo_ray_capsule_branch: ... on the barrel");
assert_eq(geo_ray_capsule_branch(_g737_ray(0x400297D5D9866180, 0x4015784A2D174659, 0xBFF851FA115C8874,
      0xC00F78718043ADF8, 0xC019661931021EC4, 0x4006EADC0F89C689), geo_capsule_new(hvec3_new(0xBFF9C1374D7A9384,
        0xBFEF6E781F56CDD4, 0x3FF583BE0DB70E46), hvec3_new(0xBFEE32ED032D39AC, 0x3FE02E1D8F830968,
        0x3FFC74A1245A0D6E), 0x3D68818AAAFC97F7), _g737_br), F64_ONE,
  "geo_ray_capsule_branch: a thin barrel's root at its end plane: 1 (3.3.6: 0x3FEFFFFFF81170D9)");
assert_eq(geo_ray_capsule_branch(_g737_ray(0x41784BF0C18FD5B8, 0x416432297CFC44E1, 0xC19F510EE1F1DFB1,
      0xC1784BF0D2FEA8ED, 0xC1643229856674B5, 0x419F510EDC8DCB08), geo_capsule_new(hvec3_new(0xBFF16ED314AC3E1C,
        0xBFD0D45F2C157870, 0xBFF590527AFFDE98), hvec3_new(0xBFF2473789017552, 0x3FE49860B8275B3A,
        0xC0000A5707EA3628), 0x3E8DFA039C5D37F2), _g737_br), 0x3FF0000000000001,
  "geo_ray_capsule_branch: a start cap's side within its rounding: 1 + 2^-52, 0.82 ulp (s14 1, 0.19)");
assert_eq(load64(_g737_br), GEO_CAP_START_CAP, "geo_ray_capsule_branch: ... on the start cap");
assert_eq(geo_ray_capsule_branch(_g737_ray(0xC046DA6B47A36BFA, 0xC042EC0FD9363B0A, 0xC0394EF7B9E31704,
      0x4046DE864C077BF2, 0x404256ED7EC12C70, 0x4039A9F319EAFEB7), geo_capsule_new(hvec3_new(0x3FA06C11AD0C7300,
        0xBFF2A44B4E1E8FD2, 0x3FD6BED7FF185E80), hvec3_new(0xBFDB2E94A747CDC4, 0xBF59B3D658D89000,
        0x3FE39D3CC4725465), 0x3E342F89E8867AE0), _g737_br), 0x3FEFFFFFFFFFFFFF,
  "geo_ray_capsule_branch: ... with o - cap's rounding carried: the exact root rounded, 0.29 ulp (s14 1, 0.36)");
assert_eq(load64(_g737_br), GEO_CAP_START_CAP, "geo_ray_capsule_branch: ... on the start cap, not the barrel");
assert_eq(geo_ray_capsule_branch(_g737_ray(0x4051C19A3631215E, 0x40648BB4AE1B4F35, 0x4066A5FC1F808C97,
      0xC0517187BDC8E0BB, 0xC064BEF1B9CCBE60, 0xC066BFDF744AB440), geo_capsule_new(hvec3_new(0x3FF7B3DBBA38004C,
        0xBFF14AC527BDA7E8, 0xBFF82ECA5DDD008A), hvec3_new(0x3FF4049E1A118911, 0xBFF99E85D8B89FEA,
        0xBFE9E354CA284CDA), 0x3DBC09EEB3EA8B91), _g737_br), 0x3FF0000000000002,
  "geo_ray_capsule_branch: the end plane's side by |ab|: 1 + 2^-51 (3.3.6: 0x3FF0000002DCE713)");
assert_eq(geo_ray_capsule_branch(_g737_ray(0xC0A57C9D323624CB, 0x40CD575F801DC093, 0xC0B7318CFC84FFD5,
      0x40A57A2F3244F1EA, 0xC0CD5667AD6CB869, 0x40B731711D1DAE6B), geo_capsule_new(hvec3_new(0xBFE8706135D0C1E0,
        0x3FFF885FFFC49EAC, 0xBFF1434876455F02), hvec3_new(0xBFF36FFF89087E0C, 0x3FFEFA5620C89B96,
        0xBFBBDF674D7F4540), 0x3E24DDBD32F65981), _g737_br), 0x3FF0000000000002,
  "geo_ray_capsule_branch: an end cap's side from a raw direction: within 0.88 ulp");
assert_eq(load64(_g737_br), GEO_CAP_END_CAP, "geo_ray_capsule_branch: ... on the end cap");
# Capsules past 2^511.5 long (the scaled axis), origins far along them: o_perp formed with
# o - start's and ab's roundings carried (2^533 long: within 1.02 ulp, 3.3.6 55,061 ulp off;
# 2^526 long with ends of both signs, so end - start rounds: exact, 3.3.6 221,714 ulp), and
# 2^603 long, where |o_perp|^2 overflows and the gate compares exponents (2.76 ulp; 3.3.6 and
# a first draft of this repair 362,762 ulp).
# [measured: rt2 long-capsule families (longcap_big.py, seeds 2101-2102), exact roots, 3.3.6 vs this tree, 2026-10-31]
assert_eq(geo_ray_capsule(_g737_ray(0x611BBD1D30B9F17D, 0xE131951E46EAE723, 0xE135FE35CD8A3965, 0xBFD30ABD3A9D21FD,
      0x3FDCF1170231F80C, 0x3FEAE7FE12A00094), geo_capsule_new(hvec3_new(0x6134C423EE9CC3D4, 0xE12FD87297044E1C,
        0xE1311289A36F77D4), hvec3_new(0xE12C623A3EE2C068, 0xE1341E1BD1ADDC30, 0xE13D82426AC888F6),
      0x5FC134780CB95363)), 0x5FD6CD8A432A67FA,
  "geo_ray_capsule: 2^533 long, far along: the exact root rounded (s14 0.99 ulp; 3.4.0 1.02)");
assert_eq(geo_ray_capsule(_g737_ray(0x60817CBFF5B8DFF1, 0x60804C5FA5FBDD3E, 0x60829B49823F3213, 0x3FE92D11E1CDCE70,
      0xBFC0098ABAAB3D01, 0x3FE357693B0B4A7D), geo_capsule_new(hvec3_new(0xE0BDF995DB6985CB, 0xE092E29FCA52D958,
        0xE090C9BA6DD243FC), hvec3_new(0x60B6AAAF845EFA42, 0x60995D7D9F454D16, 0x6099EB6307CECFBE),
      0x5F8071CB4C3D8A05)), 0x5FA3616F00ECE18D,
  "geo_ray_capsule: 2^526 long, ends of both signs: 0.69 ulp (s14 the exact root rounded, 0.31)");
assert_eq(geo_ray_capsule(_g737_ray(0x65452124590163B4, 0x654F8CC145ADA51E, 0xE55B1EAD9C7A07AC, 0xBFEEAEB5C74B8BAF,
      0xBFC9D8998B1A067A, 0x3FC98F9D9DACA385), geo_capsule_new(hvec3_new(0xE578C88712063936, 0xE5685D4F5D2840D0,
        0xE58B9AD77589EE0C), hvec3_new(0x65798F400FCCCDC8, 0x65716B8AA6A5933B, 0x6580D8A1D8633F53),
      0x642743DA8ECCCB7A)), 0x6439A0BA0B7E4A89,
  "geo_ray_capsule: 2^603 long, |o_perp|^2 overflowing: the exact root rounded (s14 2.76 ulp)");
# A sphere of radius DBL_MAX met from -0.56 DBL_MAX, where o - c overflows and is formed halved:
# its rounding is the halved inputs' (0.53 ulp; 3.3.6 3.5 ulp, 0x7FC2820309826057).
assert_eq(geo_ray_sphere(_g737_ray(0xFFE1D79B3FC0E63E, 0xC9BB657C90D81E70, 0x4959E8A78915B9E8, 0x3FEFC4CA3729D3D6,
      0x3F81204D1A559ED0, 0x3FBEA61E3101599C), geo_sphere_new(hvec3_new(0x7FE2BF1A0BF53CEF, 0x7EE37CE9DE8FD6FF,
        0xC563D550C1BF5974), 0x7FEFFFFFFFFFFFFF)), 0x7FC282030982605B,
  "geo_ray_sphere: o - c overflowing, its rounding from the halved inputs: within 0.53 ulp");
# Origins under half an ulp of a centre's coordinates, where o - c rounds to -c: a unit
# sphere 2^600 out met along its centre from (0, 2^500, 0), and 2^100 out from (0, 2^40, 0),
# both misses by 2^500 and 2^40 (3.3.6: t = 1 for each); and a sphere 2^-60 of its distance
# across missed by 19.5 radii (3.3.6: 2^159).
assert_eq(geo_ray_sphere(_g737_ray(0, 0x5F30000000000000, 0, 0x6578000000000000, 0x6574000000000000, 0),
    geo_sphere_new(hvec3_new(0x6578000000000000, 0x6574000000000000, 0), F64_ONE)), 0,
  "geo_ray_sphere: o - c rounding to -c, 2^600 out: the miss (3.3.6: 1)");
assert_eq(geo_ray_sphere(_g737_ray(0, 0x4270000000000000, 0, 0x4638000000000000, 0x4634000000000000, 0),
    geo_sphere_new(hvec3_new(0x4638000000000000, 0x4634000000000000, 0), F64_ONE)), 0,
  "geo_ray_sphere: ... 2^100 out: the miss (3.3.6: 1)");
assert_eq(geo_ray_sphere(_g737_ray(0xC5F346995F27A474, 0x4612BEEAFB15112A, 0xC6395748685542C4, 0x3F81E3EF5C0A6D78,
      0x3F932D0BDA696F5A, 0xBFA5D69BD9319732), geo_sphere_new(hvec3_new(0x4971E3EF5C0A6D78, 0x49832D0BDA696F5A,
        0xC995D69BD9319732), 0x45DB210AC5BBB8AB)), 0,
  "geo_ray_sphere: ... a small sphere's offset: the miss (3.3.6: 2^159)");
# ... and onto the surface: c = 0 read as the contact. The sphere of radius 6.9e-34 at
# (4.1e-34, 0, 0) from (-3.0e-50, 5.5e-34, 0), the origin under half an ulp inside: the exit
# at 4.28e-50, within 1.09 ulp (3.3.6: the contact 0). Radius DBL_MAX, origin 3.7 outside
# and 4.2 inside its surface (copies at unit size): the entry within 0.27 ulp and the exit
# 2.16e-154 within 1.07 ulp (3.3.6: 0 for both).
# [measured: rt337 fixtures (fixtures.py), exact roots, 3.3.6 vs this tree, 2026-10-31]
assert_eq(geo_ray_sphere(_g737_ray(0xB5A649B14880E3AA, 0x3906D5FED2EF1C10, 0, 0xBFCE1344FB34C520, 0xBFE659EED8166D2F,
      0x3FD1BC969B925386), geo_sphere_new(hvec3_new(0x3901207F1E33550C, 0, 0), 0x390C8B7E87AAE314)),
  0x35B000E8B1D5FF94, "geo_ray_sphere: o - c rounding onto the surface: the exit (3.3.6: the contact 0)");
assert_eq(geo_ray_sphere(_g737_ray(0x4012F1C937737E74, 0xFFEFFFFFFFFFFFFF, 0xBFE8DF040B0877A0, 0x3FE3DEA6F4E5B66A,
      0x3FE68CE80815CD54, 0x3FB8305CB9AAA4BE), geo_sphere_new(hvec3_new(0x3FE7E2AFE5C277D8, 0x400DA6DC762DBCBC,
        0xC01120A8C58EF035), 0xFFEFFFFFFFFFFFFF)), 0x401509E0AD60E85F,
  "geo_ray_sphere: radius DBL_MAX, origin 3.7 outside: the entry (3.3.6: 0)");
assert_eq(geo_ray_sphere(_g737_ray(0x7FEFFFFFFFFFFFFF, 0x4017B78BDEFC33DC, 0x4016D1C81110868C, 0xBFD198166B03709C,
      0xFFEFFFFFFFFFFFFF, 0x3FF0BE3D3CE65FDC), geo_sphere_new(hvec3_new(0x4010B6E5E27A8614, 0x40031061792269F6,
        0xC00A2EA000CD8A5F), 0xFFEFFFFFFFFFFFFF)), 0x20072088E89B850E,
  "geo_ray_sphere: radius DBL_MAX, origin 4.2 inside, along its surface: the exit (3.3.6: 0)");

test_group("3.3.7 geo_diff: jets whose radius is below an ulp of the hit, and a small triangle's vertex gradients");
# Expected values: the exact jets correctly rounded (900-digit Decimal from exact roots;
# zero components whose sign is incidental are compared with f64_eq), "3.3.6" that tree's.
# [measured: rt337 fixtures (fixtures.py), exact jets, 3.3.6 vs this tree, 2026-10-31]
var _g737_js = geo_jet_sphere(_g737_ray(0, 0, 0, F64_ONE, 0, 0),
  geo_sphere_new(hvec3_new(0x745E8D87446FDE22, 0, 0), F64_ONE));
assert_eq(geo_jet_kind(_g737_js), GEO_JET_SPHERE,
  "geo_jet_sphere: a unit sphere at 3.5e252: a hit jet (3.3.6: the miss)");
assert_eq(geo_jet_t(_g737_js), 0x745E8D87446FDE22, "geo_jet_sphere: ... t");
assert_eq(HVec3_x(geo_jet_dorigin(_g737_js)), 0xBFF0000000000000, "geo_jet_sphere: ... dt/do.x = -1");
assert(f64_eq(HVec3_y(geo_jet_dorigin(_g737_js)), 0) == 1, "geo_jet_sphere: ... dt/do.y = 0");
assert_eq(geo_jet_sphere_dradius(_g737_js), 0xBFF0000000000000, "geo_jet_sphere: ... dt/dr = -1");
# An origin under half an ulp of the centre's y, o - c = -c: the offset of the centre from
# the ray is the origin's own (o - c's rounding, carried); dt/do within 2 ulp of the exact
# (0x9A62D8A4EF122B98, 0x9A37E03708EB2A49), dt/dr likewise (0x9A6314C3D92A9E91).
var _g737_jl = geo_jet_sphere(_g737_ray(0, 0x5F30000000000000, 0, 0x6578000000000000, 0x6574000000000000, 0),
  geo_sphere_new(hvec3_new(0x6578000000000000, 0x6574000000000000, 0), 0x5F38000000000000));
assert_eq(geo_jet_t(_g737_jl), F64_ONE, "geo_jet_sphere: radius 1.5 * 2^500 at 2^600, o - c rounding: t = 1");
assert_eq(HVec3_x(geo_jet_dorigin(_g737_jl)), 0x9A62D8A4EF122B97, "geo_jet_sphere: ... dt/do.x within an ulp");
assert_eq(HVec3_y(geo_jet_dorigin(_g737_jl)), 0x9A37E03708EB2A4B, "geo_jet_sphere: ... dt/do.y within 2 ulp");
assert_eq(geo_jet_sphere_dradius(_g737_jl), 0x9A6314C3D92A9E8F, "geo_jet_sphere: ... dt/dr within 2 ulp");
# An origin inside a sphere of radius 32 at 1e17: the exit, g = +32 x (the far root's side).
var _g737_ji = geo_jet_sphere(_g737_ray(0x4376345785D8A001, 0, 0, F64_ONE, 0, 0),
  geo_sphere_new(hvec3_new(0x4376345785D8A000, 0, 0), 0x4040000000000000));
assert_eq(geo_jet_t(_g737_ji), 0x4030000000000000, "geo_jet_sphere: from inside a sphere at 1e17: the exit 16");
assert_eq(HVec3_x(geo_jet_dorigin(_g737_ji)), 0xBFF0000000000000, "geo_jet_sphere: ... dt/do.x = -1");
assert_eq(geo_jet_sphere_dradius(_g737_ji), F64_ONE, "geo_jet_sphere: ... dt/dr = +1 (the exit)");
# The roadmap's capsule: (0.05 DBL_MAX, 0, 0)-(0.06 DBL_MAX, 0, 0), r = 1, from 0 along +x.
var _g737_jc = geo_jet_capsule(_g737_ray(0, 0, 0, F64_ONE, 0, 0), geo_capsule_new(hvec3_new(0x7FA9999999999999, 0, 0),
    hvec3_new(0x7FAEB851EB851EB7, 0, 0), F64_ONE));
assert_eq(geo_jet_kind(_g737_jc), GEO_JET_CAPSULE,
  "geo_jet_capsule: the roadmap's capsule: a hit jet (3.3.6: the miss)");
assert_eq(geo_jet_face(_g737_jc), GEO_CAP_START_CAP, "geo_jet_capsule: ... on its start cap");
assert_eq(HVec3_x(geo_jet_dorigin(_g737_jc)), 0xBFF0000000000000, "geo_jet_capsule: ... dt/do.x = -1");
# (The typed accessors return 0 on another kind, so each is read only from a capsule jet.)
var _g737_jca = hvec3_zero();
if (geo_jet_kind(_g737_jc) == GEO_JET_CAPSULE) { _g737_jca = geo_jet_capsule_dstart(_g737_jc); }
assert_eq(HVec3_x(_g737_jca), F64_ONE, "geo_jet_capsule: ... dt/da.x = 1");
assert_eq(geo_jet_capsule_dradius(_g737_jc), 0xBFF0000000000000, "geo_jet_capsule: ... dt/dr = -1");
# A barrel at 1e17, its axis (1024, 100, 0), met along +x at y = 50: every gradient rounded.
var _g737_jb = geo_jet_capsule(_g737_ray(0, 0x4049000000000000, 0, F64_ONE, 0, 0), geo_capsule_new(
    hvec3_new(0x4376345785D8A000, 0, 0), hvec3_new(0x4376345785D8A040, 0x4059000000000000, 0), F64_ONE));
assert_eq(geo_jet_face(_g737_jb), GEO_CAP_CYLINDER, "geo_jet_capsule: a barrel at 1e17: on the barrel");
assert_eq(geo_jet_t(_g737_jb), 0x4376345785D8A01F, "geo_jet_capsule: ... t");
assert_eq(HVec3_y(geo_jet_dorigin(_g737_jb)), 0x40247AE147AE147B,
  "geo_jet_capsule: ... dt/do.y = 10.24 (3.3.6: 1,611 ulp off)");
var _g737_jba = hvec3_zero();
var _g737_jbb = hvec3_zero();
if (geo_jet_kind(_g737_jb) == GEO_JET_CAPSULE) {
    _g737_jba = geo_jet_capsule_dstart(_g737_jb);
    _g737_jbb = geo_jet_capsule_dend(_g737_jb);
}
assert_eq(HVec3_x(_g737_jba), 0x3FE051883AC845ED, "geo_jet_capsule: ... dt/da.x");
assert_eq(HVec3_y(_g737_jba), 0xC014E33DBBE1A12F, "geo_jet_capsule: ... dt/da.y (3.3.6: 5% off)");
assert_eq(HVec3_x(_g737_jbb), 0x3FDF5CEF8A6F7426, "geo_jet_capsule: ... dt/db.x");
assert_eq(geo_jet_capsule_dradius(_g737_jb), 0xC02493D217F237E0,
  "geo_jet_capsule: ... dt/dr = -10.29 (3.3.6: +6.62, the wrong sign)");
# The jets' far path at scene scale (the review's mutants): a capsule at coordinates near 4e3,
# r 0.075, met on its END cap from 54 away, its g formed about the end (dt/do and dt/db within
# 1.2 ulp of the exact; about the start it is garbage); and a sphere 2^24 out of radius 1.1 met near
# tangency (|f|/r = 0.99935), dt/do.x 377 ulp from the exact 0xBE8303D913521DBD (h =
# sqrt(r^2 - |f|^2) magnifies f's own rounding some 770 times), where the plain g of p - c (the
# 3.3.6 form, a gate at 2^30) is 1.3e-6 off.
# [measured: rt2 review repros (rt2e/surv.py), exact jets, 3.3.6 vs this tree, 2026-10-31]
var _g737_je = geo_jet_capsule(_g737_ray(0xC0A84C63A4235761, 0x409B6816C0CA576A, 0xC0B0C38E41B1573B,
    0x3FF12FC7287A4800, 0xC00E4540F0135400, 0x40488485730FC580), geo_capsule_new(hvec3_new(0xC0A84C8FB3262984,
      0x409B562632EF09D1, 0xC0B08DEE0F6E895C), hvec3_new(0xC0A84A407D7DAAAC, 0x409B5906EA5ECD55,
      0xC0B09272934E2958), 0x3FB345EB0D320F39));
assert_eq(geo_jet_face(_g737_je), GEO_CAP_END_CAP, "geo_jet_capsule: a scene-scale end cap: on the end cap");
assert_eq(HVec3_x(geo_jet_dorigin(_g737_je)), 0x3F59D54824874293, "geo_jet_capsule: ... dt/do.x rounded");
assert_eq(HVec3_z(geo_jet_dorigin(_g737_je)), 0xBF955548E2947615, "geo_jet_capsule: ... dt/do.z rounded");
var _g737_jeb = hvec3_zero();
if (geo_jet_kind(_g737_je) == GEO_JET_CAPSULE) { _g737_jeb = geo_jet_capsule_dend(_g737_je); }
assert_eq(HVec3_x(_g737_jeb), 0xBF59D54824874293, "geo_jet_capsule: ... dt/db.x rounded");
var _g737_jt9 = geo_jet_sphere(_g737_ray(0x41604A8F5BAD4995, 0xC1717CAA6A11FE6C, 0x4164940BF2DCB99C,
    0xC18DE7CD1855DEBF, 0x41A00CDB48D2BF95, 0xC192E3374CFA0C6E), geo_sphere_new(hvec3_new(0x3FE06E23F7CB6858,
      0x400AF5BCCBB6AD10, 0xBFCD08FECBC37D80), 0x3FF1E5620A841FB8));
assert_eq(HVec3_x(geo_jet_dorigin(_g737_jt9)), 0xBE8303D913521C44,
  "geo_jet_sphere: 2^24 out near tangency: dt/do.x 377 ulp from the exact (3.3.6 form: 1.3e-6 off)");

# A 1e-6 triangle near (-0.19, -0.20, -0.012) met from distance 1: w = p - v0 formed with its
# roundings carried (_geo_jet_tri_w). Each vertex gradient within 1.3 ulp of the exact one
# (3.3.6: 6.2e3 to 7.7e6 ulp off, dt/do unchanged).
var _g737_rt = alloc(sizeof(GeoRay));
GeoRay_set_origin(_g737_rt, hvec3_new(0x3FE9184A9C517909, 0xBF92FECDBEBFD668, 0x3FC007DCEC9E0F26));
GeoRay_set_direction(_g737_rt, hvec3_new(0xBFEF2B52E3FBBE5C, 0xBFC70DBF554E8616, 0xBFC18E28DF573B97));
var _g737_jt = geo_jet_triangle(_g737_rt, geo_triangle_new(hvec3_new(0xBFC84C20170D6478, 0xBFC96D995D73B554,
      0xBF8864C0831E0D4A), hvec3_new(0xBFC84C2A724D33F2, 0xBFC96D99D6B6A5E9, 0xBF8864F0FF391744),
    hvec3_new(0xBFC84C24C312EE51, 0xBFC96D8EF2A94EF2, 0xBF886420CA35F77C)));
assert_eq(geo_jet_kind(_g737_jt), GEO_JET_TRIANGLE, "geo_jet_triangle: a 1e-6 triangle from distance 1: a hit jet");
var _g737_jt0 = hvec3_zero();
var _g737_jt1 = hvec3_zero();
var _g737_jt2 = hvec3_zero();
if (geo_jet_kind(_g737_jt) == GEO_JET_TRIANGLE) {
    _g737_jt0 = geo_jet_tri_dv0(_g737_jt);
    _g737_jt1 = geo_jet_tri_dv1(_g737_jt);
    _g737_jt2 = geo_jet_tri_dv2(_g737_jt);
}
assert_eq(HVec3_x(_g737_jt0), 0xBFE783AD70BE85C2, "geo_jet_triangle: ... dt/dv0.x (3.3.6: 6.2e3 ulp)");
assert_eq(HVec3_y(_g737_jt0), 0xC009BEF315F8D9A7, "geo_jet_triangle: ... dt/dv0.y (3.3.6: 1.1e6 ulp)");
assert_eq(HVec3_z(_g737_jt0), 0x40081D83BC7E124E, "geo_jet_triangle: ... dt/dv0.z (3.3.6: 9.2e5 ulp)");
assert_eq(HVec3_x(_g737_jt1), 0xBFB1F12E3200B34B, "geo_jet_triangle: ... dt/dv1.x (3.3.6: 7.3e5 ulp)");
assert_eq(HVec3_z(_g737_jt2), 0x3FBDB1AF925371CB, "geo_jet_triangle: ... dt/dv2.z (3.3.6: 1.5e6 ulp)");

test_group("2.10.0 geo_ray_*: t is degree -1 homogeneous in the direction");
_homog_sweep();
assert_eq(_HG_RUN, 18, "homogeneity sweep ran 6 primitives x 3 direction scales");
assert_eq(_HG_BAD, 0,
  "every geo_ray_* returns t/k when the direction is scaled by k (sphere+capsule failed pre-2.10.0)");

# The invariant that makes it matter: the reported hit point is ON the surface.
var hsp = geo_sphere_new(hvec3_new(f64_from(2), f64_from(4), f64_from(6)), F64_ONE);
var hry = geo_ray_new(hvec3_new(0, 0, 0), hvec3_new(F64_ONE, F64_TWO, f64_from(3)));
GeoRay_set_direction(hry, hvec3_new(F64_ONE, F64_TWO, f64_from(3)));   # NON-unit
var hgt = geo_ray_sphere(hry, hsp);
assert(f64_approx_eq(hvec3_length(hvec3_sub(geo_ray_at(hry, hgt),
        hvec3_new(f64_from(2), f64_from(4), f64_from(6)))), F64_ONE, LOOSE_TOL_M),
  "ray-sphere on a NON-unit ray: geo_ray_at(t) lands ON the sphere (was 3.74 from a unit sphere)");

# The degenerate direction. Carrying `a` explicitly means dividing by it, so a
# zero-length direction must be rejected BEFORE the divide or the routine returns
# +/-Inf or NaN from a function documented to return 0 on a miss -- the same
# failure `geo_ray_capsule` already guards against for its parallel-axis case
# (`f64_abs(a) < EPSILON_F64` when this was written in 2.10.0; the threshold became
# EPSILON_F64 squared in 2.10.1 and `_GEO_F64_TINY` in 2.14.0). Without this
# assertion the guard is free to be deleted: a mutant that removed it passed the
# whole suite.
var hz = geo_ray_new(hvec3_new(0, 0, 0), hvec3_new(F64_ONE, 0, 0));
GeoRay_set_direction(hz, hvec3_new(0, 0, 0));
assert_eq(geo_ray_sphere(hz, hsp), 0,
  "ray-sphere with a ZERO direction returns the miss sentinel, not Inf/NaN");
assert_eq(geo_ray_capsule(hz, geo_capsule_new(hvec3_new(0, 0, f64_neg(F64_ONE)),
      hvec3_new(0, 0, F64_ONE), F64_ONE)), 0,
  "ray-capsule with a ZERO direction likewise");

# 2.10.1 widens that pair to all six. Pre-fix this sweep reported 2 bad of 12 --
# geo_ray_aabb and geo_ray_obb, both with the origin inside, both +Inf.
test_group("2.10.2 geo_ray_capsule: every hit point is ON the capsule");
_cs_sweep();
assert_gt(_CS_RUN, 100, "the capsule interior sweep found a useful number of interior origins");
assert_eq(_CS_DROP, 0,
  "no interior origin loses its exit (32 of 600 did pre-2.10.2, all through a cap)");
assert_eq(_CS_BAD, 0,
  "every capsule hit point sits at distance r from the segment, to LOOSE_TOL_M");

# The witness, asserted on the SURFACE RESIDUAL rather than on t: the broken code
# returned 4.0 here, which is a perfectly plausible number and would have passed
# any loose t assertion. Its hit point was on the axis, a full radius inside.
var cw_cap = geo_capsule_new(hvec3_new(0, 0, 0), hvec3_new(f64_from(10), 0, 0), F64_ONE);
var cw_seg = geo_segment_new(hvec3_new(0, 0, 0), hvec3_new(f64_from(10), 0, 0));
var cw_r = alloc(sizeof(GeoRay));
GeoRay_set_origin(cw_r, hvec3_new(f64_from(5), 0, 0));
GeoRay_set_direction(cw_r, hvec3_new(F64_ONE, 0, 0));
var cw_t = geo_ray_capsule(cw_r, cw_cap);
# The hit point is (11, 0, 0) and the segment ends at (10, 0, 0): both exact, bit for bit.
assert_eq(geo_segment_distance_to_point(cw_seg, geo_ray_at(cw_r, cw_t)), F64_ONE,
  "axial ray from inside: the hit point is on the SURFACE, not a radius inside it");
assert_eq(cw_t, f64_from(6), "axial ray from inside: t = 6, the exit through the end cap (was 4, an interior point)");

test_group("2.10.2 geo: the same scene in different units gives the same answer");
_sc_sweep();
assert_eq(_SC_RUN, 320, "the scale-covariance sweep ran 4 properties x 80 decades");

# ⛔ AND THE SWEEP ALONE PROVES LESS THAN IT LOOKS. Mutation-tested after the
# repair: with the 80-decade sweep as the only evidence, DELETING the triangle
# guard entirely SURVIVED, and restoring `_GEO_F64_TINY` at the other three sites
# SURVIVED TOO — the sweep's quantities there are only QUADRATIC in the scale, so
# they never reach DBL_MIN inside 80 decades and the sweep cannot see the
# difference. Two kinds of assertion close that, and neither is a deeper sweep.
# [measured: 11-mutant run over src/geo.cyr, 4 survivors before this block]

# --- (1) ANTI-DELETION. Each guard must still fire on a genuinely degenerate
# input, or "repairing" it is indistinguishable from removing it.
var _gd_tri = geo_triangle_new(hvec3_new(F64_ONE, 0, 0), hvec3_new(F64_ONE, 0, 0),
  hvec3_new(F64_ONE, 0, 0));
var _gd_n = geo_triangle_unit_normal(_gd_tri);
assert_eq(HVec3_y(_gd_n), 0x3FF0000000000000,
  "geo_triangle_unit_normal: a zero-area triangle still returns the unit_y fallback");
assert_eq(HVec3_x(_gd_n), 0,
  "geo_triangle_unit_normal: the degenerate fallback is exact, not NaN");

var _gd_seg = geo_segment_new(hvec3_new(F64_TWO, 0, 0), hvec3_new(F64_TWO, 0, 0));
assert_eq(HVec3_x(geo_segment_direction(_gd_seg)), 0x3FF0000000000000,
  "geo_segment_direction: a zero-length segment still returns the unit_x fallback");
assert_eq(HVec3_x(geo_segment_closest_point(_gd_seg, hvec3_new(0, 0, 0))),
  0x4000000000000000,
  "geo_segment_closest_point: a zero-length segment still collapses to its start");

# --- (2) THE SUBNORMAL BAND. `len_sq` is quadratic, so the only scale that
# separates DBL_MIN from an exact-zero test is one where the SQUARE itself goes
# subnormal while staying non-zero. s = 2^-512 puts len_sq at exactly 2^-1023 —
# one binade below DBL_MIN, so still 51 bits of mantissa and the answer is
# bit-exact — which the old threshold rejects and the division handles fine.
var _gs = (1023 - 512) << 52;                 # 2^-512
var _gs_seg = geo_segment_new(hvec3_new(0, 0, 0), hvec3_new(_gs, _gs, 0));
assert_eq(hvec3_length_sq(hvec3_new(_gs, _gs, 0)), 0x0008000000000000,
  "the subnormal-band fixture really is subnormal (2^-1023, below DBL_MIN)");
assert_eq(HVec3_x(geo_segment_direction(_gs_seg)), 0x3FE6A09E667F3BCC,
  "geo_segment_direction: a subnormal len_sq still yields a bit-exact 1/sqrt(2)");
assert_eq(HVec3_y(geo_segment_direction(_gs_seg)), 0x3FE6A09E667F3BCC,
  "geo_segment_direction: both components, not just the one that could alias");
assert_eq(geo_segment_distance_to_point(_gs_seg,
    hvec3_scale(hvec3_new(_gs, _gs, 0), F64_HALF)), 0,
  "geo_segment_closest_point: a subnormal len_sq is not collapsed to the start");

# ⚠ geo_ray_capsule's guard is on the same quantity, so it needs the same band.
var _gc_cap = geo_capsule_new(hvec3_new(0, 0, 0), hvec3_new(_gs, 0, 0),
  f64_div(_gs, f64_from(4)));
var _gc_ray = alloc(sizeof(GeoRay));
GeoRay_set_origin(_gc_ray, hvec3_new(f64_div(_gs, F64_TWO), f64_mul(F64_TWO, _gs), 0));
GeoRay_set_direction(_gc_ray, hvec3_new(0, f64_neg(F64_ONE), 0));
assert(f64_approx_eq(f64_div(geo_ray_capsule(_gc_ray, _gc_cap), _gs),
    f64_div(f64_from(7), f64_from(4)), LOOSE_TOL_M) == 1,
  "geo_ray_capsule: a subnormal axis len_sq is still a capsule, not a sphere");
assert_eq(_SC_BAD, 0,
  "triangle normal, segment direction, segment distance and capsule t are all scale-covariant to 1e-9");

# === 3.3.3 G6: the same four guards at a NaN input ===
# The block above puts these guards at a zero and at a subnormal input. The third
# input that reaches them is NaN, and through 3.3.2 all four were spelled
# `f64_gt(x, 0) == 0` — TRUE for NaN — so a NaN coordinate took the degenerate
# fallback and came back as an answer: unit_y, unit_x, the segment's finite start
# (distance sqrt(3) from (1,1,1)), and a capsule-as-sphere hit at t = 4 that
# `geo_jet_capsule` then differentiated.
# THE TRUE VALUES, settled on a second path before either side was changed:
#   * the unit normal / direction — `hvec3_normalize`, the tree's NaN-in-NaN-out
#     normaliser, applied to the same cross product and the same end - start; the
#     two oracle controls below assert that path really is NaN in all three;
#   * the closest point — t = dot(p - a, ab) / |ab|^2 has a NaN numerator and
#     denominator, and every component of a + t*ab is then NaN;
#   * the capsule — the function's own answer for a NaN START (NaN on 3.3.2 too):
#     a NaN anywhere on the axis poisons every quantity, whichever end carries it.
#     The finite control below shows the ray really does hit this capsule's shape.
# Every value is checked for NaN-ness, not for a payload: which NaN bit pattern
# survives a multiply is the hardware's choice, not the contract.
var _g6_nan = 0x7FF8000000000000;
fn _g6_nan3(v) {
    var c = 0;
    if (f64_eq(HVec3_x(v), HVec3_x(v)) == 0) { c = c + 1; }
    if (f64_eq(HVec3_y(v), HVec3_y(v)) == 0) { c = c + 1; }
    if (f64_eq(HVec3_z(v), HVec3_z(v)) == 0) { c = c + 1; }
    return c;
}
var _g6_tri = geo_triangle_new(hvec3_new(0, 0, _g6_nan), hvec3_new(F64_ONE, 0, 0),
  hvec3_new(0, F64_ONE, 0));
assert_eq(_g6_nan3(hvec3_normalize(geo_triangle_normal(_g6_tri))), 3,
  "oracle: hvec3_normalize of the NaN triangle's cross product is NaN in all three");
assert_eq(_g6_nan3(geo_triangle_unit_normal(_g6_tri)), 3,
  "geo_triangle_unit_normal: a NaN vertex gives NaN in all three components, not unit_y");
var _g6_seg_a = hvec3_new(0, _g6_nan, 0);
var _g6_seg_b = hvec3_new(F64_ONE, 0, 0);
assert_eq(_g6_nan3(hvec3_normalize(hvec3_sub(_g6_seg_b, _g6_seg_a))), 3,
  "oracle: hvec3_normalize of the NaN segment's end - start is NaN in all three");
assert_eq(_g6_nan3(geo_segment_direction(geo_segment_new(_g6_seg_a, _g6_seg_b))), 3,
  "geo_segment_direction: a NaN start gives NaN in all three components, not unit_x");
var _g6_cseg = geo_segment_new(hvec3_new(0, 0, 0), hvec3_new(_g6_nan, 0, 0));
var _g6_p111 = hvec3_new(F64_ONE, F64_ONE, F64_ONE);
assert_eq(_g6_nan3(geo_segment_closest_point(_g6_cseg, _g6_p111)), 3,
  "geo_segment_closest_point: a NaN END is NaN out, not collapsed to the finite start (0,0,0)");
var _g6_cd = geo_segment_distance_to_point(_g6_cseg, _g6_p111);
assert_eq(f64_eq(_g6_cd, _g6_cd), 0,
  "geo_segment_distance_to_point: a NaN END is NaN, not sqrt(3) to the start");
var _g6_cseg2 = geo_segment_new(hvec3_new(_g6_nan, 0, 0), hvec3_new(f64_from(3), 0, 0));
assert_eq(_g6_nan3(geo_segment_closest_point(_g6_cseg2, _g6_p111)), 3,
  "geo_segment_closest_point: a NaN START is NaN in all three, not the start (NaN,0,0)");
var _g6_ray = geo_ray_new(hvec3_new(f64_neg(f64_from(5)), 0, 0), hvec3_unit_x());
var _g6_out = alloc(GEO_FACE_OUT_BYTES);
assert_eq(geo_ray_capsule_branch(_g6_ray,
    geo_capsule_new(hvec3_new(0, 0, 0), hvec3_new(f64_from(3), 0, 0), F64_ONE), _g6_out),
  f64_from(4), "control: the same ray hits the finite capsule (0,0,0)-(3,0,0) at t = 4");
assert_eq(load64(_g6_out), GEO_CAP_START_CAP, "control: ... on its start cap");
var _g6_nend = geo_capsule_new(hvec3_new(0, 0, 0), hvec3_new(_g6_nan, 0, 0), F64_ONE);
var _g6_ct = geo_ray_capsule_branch(_g6_ray, _g6_nend, _g6_out);
assert_eq(f64_eq(_g6_ct, _g6_ct), 0,
  "geo_ray_capsule: a NaN END is NaN out, not a sphere hit at the start (t = 4)");
assert_eq(load64(_g6_out), GEO_FACE_NONE,
  "geo_ray_capsule_branch: a NaN END reports no branch, not GEO_CAP_SPHERE");
assert_eq(geo_jet_kind(geo_jet_capsule(_g6_ray, _g6_nend)), GEO_JET_MISS,
  "geo_jet_capsule: a NaN END is the miss jet, not a capsule jet at t = 4");
var _g6_nstart = geo_capsule_new(hvec3_new(_g6_nan, 0, 0), hvec3_new(f64_from(3), 0, 0), F64_ONE);
var _g6_cs = geo_ray_capsule_branch(_g6_ray, _g6_nstart, _g6_out);
assert_eq(f64_eq(_g6_cs, _g6_cs), 0,
  "geo_ray_capsule: a NaN START is still NaN out, not the end cap's t = 7");
assert_eq(load64(_g6_out), GEO_FACE_NONE,
  "geo_ray_capsule_branch: a NaN START reports no branch, not GEO_CAP_SPHERE or END_CAP");

test_group("2.10.2 slab routines: the reported hit point is ON the box");
_sf_sweep();
assert_eq(_SF_RUN, 72, "the slab surface sweep ran 18 magnitudes x 2 signs x 2 primitives");
# ⚠ The sweep is half hits and half misses BY CONSTRUCTION, and this counter is
# what caught the first draft being all misses. A structural invariant about hit
# points is vacuous over a sample of misses.
assert_gt(_SF_HITS, 30, "and a useful number of them were HITS, not all misses");
assert_eq(_SF_BAD, 0,
  "every slab hit point lies on its box, and aabb agrees with obb (both broke pre-2.10.2)");

# The witnesses, kept alongside the sweep because each names a distinct symptom.
var sf_box = geo_aabb_new(hvec3_new(0, 0, 0), hvec3_new(F64_ONE, F64_ONE, F64_ONE));
var sf_e12 = F64_ONE;
for (var i = 0; i < 12; i = i + 1) { sf_e12 = f64_mul(sf_e12, f64_from(10)); }
var sf_9e13 = f64_from(9);
for (var i = 0; i < 13; i = i + 1) { sf_9e13 = f64_div(sf_9e13, f64_from(10)); }
var sf_r = alloc(sizeof(GeoRay));
GeoRay_set_origin(sf_r, hvec3_new(F64_HALF, F64_HALF, f64_neg(sf_e12)));
GeoRay_set_direction(sf_r, hvec3_new(sf_9e13, 0, F64_ONE));
# The direction is UNIT to 16 digits -- the point being that geo_ray_new would
# have produced it, so normalizing is no defence.
assert(f64_approx_eq(hvec3_length(GeoRay_direction(sf_r)), F64_ONE, LOOSE_TOL_M),
  "phantom-hit witness: the direction really is unit length");
assert_eq(geo_ray_aabb(sf_r, sf_box), 0,
  "phantom hit: a unit direction with d_x = 9e-13 no longer reports a hit at x = 1.4");

# The same ray from INSIDE a tall box: the x slab bounds the exit, and deleting it
# gave an exit 18x too large.
# [measured: docs/development/issues/archived/2026-08-10-slab-parallel-test-is-scale-free.md]
var sf_tall = alloc(sizeof(GeoAabb));
GeoAabb_set_min(sf_tall, hvec3_new(0, 0, 0));
var sf_e13 = f64_mul(sf_e12, f64_from(10));
GeoAabb_set_max(sf_tall, hvec3_new(F64_ONE, F64_ONE, sf_e13));
var sf_ri = alloc(sizeof(GeoRay));
GeoRay_set_origin(sf_ri, hvec3_new(F64_HALF, F64_HALF, F64_HALF));
GeoRay_set_direction(sf_ri, hvec3_new(sf_9e13, 0, F64_ONE));
var sf_ti = geo_ray_aabb(sf_ri, sf_tall);
assert(f64_approx_eq(HVec3_x(geo_ray_at(sf_ri, sf_ti)), F64_ONE, LOOSE_TOL_M),
  "interior exit: the ray leaves through the +x face, not 8.5 units past it");

# +Inf from entirely finite inputs. The true t overflows the exponent range, so
# the only contract-conformant answer is the miss sentinel.
var sf_e300 = F64_ONE;
for (var i = 0; i < 300; i = i + 1) { sf_e300 = f64_mul(sf_e300, f64_from(10)); }
var sf_fobb = geo_obb_new(hvec3_new(0, 0, sf_e300), hvec3_new(F64_ONE, F64_ONE, F64_ONE),
  hquat_identity());
var sf_rf = alloc(sizeof(GeoRay));
GeoRay_set_origin(sf_rf, hvec3_new(0, 0, 0));
var sf_2e12 = F64_TWO;
for (var i = 0; i < 12; i = i + 1) { sf_2e12 = f64_div(sf_2e12, f64_from(10)); }
GeoRay_set_direction(sf_rf, hvec3_new(0, 0, sf_2e12));
assert_eq(geo_ray_obb(sf_rf, sf_fobb), 0,
  "a t that overflows to +Inf from FINITE inputs returns the miss sentinel, not Inf");

# === 3.3.5: the AABB slabs divide (b - o) / d_k, so a subnormal d_k is not parallel ===
# Through 3.3.4 a slab multiplied by 1/d_k and so skipped |d_k| < DBL_MIN as parallel:
# a ray inside that slab was never made to leave it, and one outside never entered.
# The parallel test is now d_k = 0 exactly, and each crossing one correctly rounded
# quotient. Expected values are from an exact rational oracle.
# [measured: G1 slab sweep and fixtures, exact Fraction oracle, 3.3.4 tree vs this one, 2026-10-11; cycc 6.6.14]
fn _s5_ray(ox, oy, oz, dx, dy, dz) {
    var r = alloc(sizeof(GeoRay));
    GeoRay_set_origin(r, hvec3_new(ox, oy, oz));
    GeoRay_set_direction(r, hvec3_new(dx, dy, dz));
    return r;
}
fn _s5_box(x0, y0, z0, x1, y1, z1) {
    var b = alloc(sizeof(GeoAabb));
    GeoAabb_set_min(b, hvec3_new(x0, y0, z0));
    GeoAabb_set_max(b, hvec3_new(x1, y1, z1));
    return b;
}
var _s5_fo = alloc(GEO_FACE_OUT_BYTES);
var _s5_o = 0x3FEFFFFFFFFFE000;   # 1 - 2^-40, just inside x <= 1 (or just outside x >= 1)
var _s5_dx = 0x0000100000000000;   # 2^-1030, subnormal
# A false hit: inside the x slab [0, 1] and drifting out of it at 2^-1030 per unit t,
# the ray leaves at t = 2^990, before the y slab [2^1000, 2^1001] begins at t = 2^1000.
var _s5_fh = geo_ray_aabb(_s5_ray(_s5_o, 0, F64_HALF, _s5_dx, F64_ONE, 0),
  _s5_box(0, 0x7E70000000000000, 0, F64_ONE, 0x7E80000000000000, F64_ONE));
assert_eq(_s5_fh, 0, "geo_ray_aabb: leaves the x slab at 2^990, before the y slab at 2^1000 -> miss (3.3.4: 2^1000)");
# A false miss: outside the x slab [1, 2] and drifting in, it enters at t = 2^990
# exactly (b - o = 2^-40), inside y [-2^1010, 2^1010] and z [0, 1] the whole way.
var _s5_fm = geo_ray_aabb_face(_s5_ray(_s5_o, 0, F64_HALF, _s5_dx, F64_ONE, 0),
  _s5_box(F64_ONE, 0xFF10000000000000, 0, F64_TWO, 0x7F10000000000000, F64_ONE), _s5_fo);
assert_eq(_s5_fm, 0x7DD0000000000000, "geo_ray_aabb_face: enters the x slab at t = 2^990 (3.3.4: the miss 0)");
assert_eq(load64(_s5_fo), 0, "geo_ray_aabb_face: ... through face 0, the plane at min.x");
# The same in y and z, from the sweep: d = (0, 2.0e-308, 1.6e-314), box entered through
# its min.y plane at t = 1.78e307 (3.3.4: the miss 0).
var _s5_fm2 = geo_ray_aabb_face(_s5_ray(0x4026BAB3EB7E36FA, 0xC00562D47ED4734A, 0xC002AA5CCB52F770,
    0, 0x000A34F25D96BC3B, 0x0000000000FC7144), _s5_box(0x401D62D0786E6A70, 0xC0035CBEF7E3B8A9,
    0xC019CEC1474C145A, 0x4027CE1BA8D37190, 0x3FFB0A895CEC4292, 0x400578DD77B48664), _s5_fo);
assert_eq(_s5_fm2, 0x7FB96119E9E9DF2D, "geo_ray_aabb_face: subnormal d_y and d_z, entry t = 1.78e307 (3.3.4: 0)");
assert_eq(load64(_s5_fo), 2, "geo_ray_aabb_face: ... through face 2");
# An inverted box: max.x stored below min.x, read sorted, and d_z subnormal.
var _s5_fmi = geo_ray_aabb_face(_s5_ray(0x400908D7A640FA52, 0x3FFD9FE376C5E2DE, 0x401DD62B6F829201,
    0x8000000000000F77, 0, 0x000B36E0B4EC3F30), _s5_box(0x400E4B69DF3145EE, 0x3FE59A9ACEC47E14,
    0x40149C9F803AB900, 0x3FEBD15B4445F326, 0x40130158FA63418E, 0x4020E352F4FB8100), _s5_fo);
assert_eq(_s5_fmi, 0x7FD67B59FB9EB601, "geo_ray_aabb_face: inverted x, subnormal d_z -> t = 6.31e307 (3.3.4: 0)");
assert_eq(load64(_s5_fo), 5, "geo_ray_aabb_face: ... through face 5, the plane at max.z");
# One quotient instead of (b - o) * RN(1/d): three ordinary rays whose t is now
# correctly rounded, through face 2, face 4 and face 0 (3.3.4: one ulp off in each).
assert_eq(geo_ray_aabb(_s5_ray(0xC02301972B1E0F6F, 0xC014D4688D5420AD, 0x4017CA341312881A,
      0xBFE77590B73305AD, 0x3FE5C38A0B83976E, 0xAD236FB2A46C4AC0), _s5_box(0xC025F6E6055C0E9C,
      0xC0122E51C57DA3EE, 0x400926EB36820318, 0xC01B98389E322BD7, 0xBFFA60457D483C87, 0x40289785F43C8FDE)),
  0x3FEF281D89E508D8, "geo_ray_aabb: t correctly rounded through face 2 (3.3.4: ...08D7)");
assert_eq(geo_ray_aabb(_s5_ray(0xC0120839207701A8, 0xC013AC83FB580E58, 0x3FFE3A261522EA6B,
      0x2D2F394325F1860E, 0x3FEC4041EC5904CC, 0xBFEFA3ED670F42A0), _s5_box(0xC01695FF8117EA82,
      0xC019CDE9982BC314, 0x3FF09CA6B60EB250, 0x400A5677DFA2AFA4, 0xBFE46FA23C037920, 0x40237D965F47ABE8)),
  0x3FEB8A3C2C8A23FD, "geo_ray_aabb: t correctly rounded through face 4 (3.3.4: ...23FC)");
assert_eq(geo_ray_aabb(_s5_ray(0x40240449ACE30092, 0x3FE3B30F19FB14BC, 0xBFE5F879AC39D3E0,
      0xBFE7A0A588C40CA6, 0x81534218AB7FDBC0, 0), _s5_box(0x401F7CF16C875996, 0xC0079CECC35DD7C9,
      0xC019603511CCAEC0, 0x402733F6A913A7ED, 0x400678A6B67B09E9, 0x4009B0B73D10A0D8)),
  0x400725A6C24338D4, "geo_ray_aabb: t correctly rounded through face 0 (3.3.4: ...38D3)");
# D034 still holds with a subnormal component: a NaN bound on that axis is the NaN t.
var _s5_nb = _s5_box(0x7FF8000000000000, 0, 0, F64_ONE, F64_ONE, F64_ONE);
assert_eq(f64_eq(geo_ray_aabb_face(_s5_ray(F64_HALF, F64_HALF, f64_neg(F64_ONE), _s5_dx, 0, F64_ONE),
      _s5_nb, _s5_fo), 0), 0, "geo_ray_aabb_face: NaN min.x with d_x = 2^-1030 -> NaN t, not a hit or 0");
assert_eq(load64(_s5_fo), GEO_FACE_NONE, "geo_ray_aabb_face: ... GEO_FACE_NONE");
# bvh_query_ray. An all-subnormal direction meets a box past DBL_MAX: its entry and exit
# both overflow, and their order, decided exactly, reports the leaf (3.3.4 read every
# slab as parallel: none). The predicate answers "meets at some t >= 0", past DBL_MAX
# included; geo_ray_aabb, which must return a double t, answers the miss there.
var _s5_arr = alloc(8);
store64(_s5_arr, _s5_box(0x40171BF4A31DDE86, 0x400E689A48911113, 0x3FFE14AA6A871898, 0x401A06F0AA07B54A,
    0x40111E072207AD47, 0x401C54052DEB69E2));
assert_eq(vec_len(bvh_query_ray(bvh_build(_s5_arr, 1), _s5_ray(0x401D75A75BF85DF2, 0x40106FCC7AC6D30F,
        0x4008D477B8607363, 0x8000000000215693, 0x8000000000000000, 0))), 1,
  "bvh_query_ray: d = (-1.1e-317, -0, 0) from inside y and z meets the box (3.3.4: no leaf)");
# The predicate's own slabs, per axis: the false-miss ray above, with its subnormal
# component on axis k (2^-1030, next to a unit one), enters at t = 2^990 and its box is
# reported. Read as parallel, or crossed with 1/d_k = +Inf, it is not.
fn _s5_perm(k, a, b, c) {
    if (k == 1) { return hvec3_new(c, a, b); }
    if (k == 2) { return hvec3_new(b, c, a); }
    return hvec3_new(a, b, c);
}
