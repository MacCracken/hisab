# ================================================================
# NUM — root finding, number theory, RNG, summation, FFT (~30)
# ================================================================
test_group("num: newton");

var n_out = alloc(8);
var n_rc = num_newton(&_tn_f, &_tn_df, F64_ONE, EPSILON_F64, 100, n_out);
assert_eq(n_rc, 0, "newton ok");
var n_val = load64(n_out);
var n_1000 = f64_to(f64_round(f64_mul(n_val, f64_from(1000))));
assert_eq(n_1000, 1414, "newton sqrt2");

# Newton cube root of 8: x^3 - 8 = 0, root = 2

var n_cube_out = alloc(8);
num_newton(&_tn_cube_f, &_tn_cube_df, f64_from(3), EPSILON_F64, 100, n_cube_out);
assert_eq(f64_to(f64_round(load64(n_cube_out))), 2, "newton cube root 8");

# Newton linear: x - 5 = 0, root = 5

var n_lin_out = alloc(8);
num_newton(&_tn_lin_f, &_tn_lin_df, 0, EPSILON_F64, 100, n_lin_out);
assert_eq(f64_to(f64_round(load64(n_lin_out))), 5, "newton linear root");

# Newton sin root at 0

var n_sin_out = alloc(8);
var n_sin_rc = num_newton(&_tn_sin_f, &_tn_sin_df, F64_HALF, EPSILON_F64, 100, n_sin_out);
assert_eq(n_sin_rc, 0, "newton sin converged");
# num_newton returns the first iterate with |sin(x)| < tol = EPSILON_F64 = 1e-12.
# Near 0, |sin x| >= |x| - |x|^3/6, so the root is bounded by 1.0000000000002e-12
# -- and that bound also excludes the other roots (+-pi, ...). Measured: 1.21e-14.
# The old bound of 1.0 was satisfied by every point in (-1, 1), including x0=0.5.
assert(f64_lt(f64_abs(load64(n_sin_out)), EPSILON_F64) == 1, "newton sin root == 0 (1e-12)");

# ----------------------------------------------------------------
test_group("num: bisection");

var n_bis_out = alloc(8);
var n_bis_rc = num_bisection(&_tn_f, F64_ONE, F64_TWO, EPSILON_F64, 100, n_bis_out);
assert_eq(n_bis_rc, 0, "bisection ok");
var n_bis_1000 = f64_to(f64_round(f64_mul(load64(n_bis_out), f64_from(1000))));
assert_eq(n_bis_1000, 1414, "bisection sqrt2");

# Bisection same-sign error
var n_bis_err = num_bisection(&_tn_f, f64_from(2), f64_from(3), EPSILON_F64, 100, n_bis_out);
assert_neq(n_bis_err, 0, "bisection same sign err");

# ----------------------------------------------------------------
test_group("num: gcd");

assert_eq(num_gcd(12, 8), 4, "gcd(12,8)");
assert_eq(num_gcd(7, 13), 1, "gcd coprime");
assert_eq(num_gcd(100, 75), 25, "gcd(100,75)");
assert_eq(num_gcd(17, 17), 17, "gcd(17,17)");
assert_eq(num_gcd(0, 5), 5, "gcd(0,5)");

# ----------------------------------------------------------------
test_group("num: modpow");

assert_eq(num_modpow(2, 10, 1000), 24, "modpow 2^10 mod 1000");
assert_eq(num_modpow(3, 5, 100), 43, "modpow 3^5 mod 100");
assert_eq(num_modpow(7, 0, 13), 1, "modpow exp=0 -> 1");
assert_eq(num_modpow(5, 1, 100), 5, "modpow exp=1");

# ----------------------------------------------------------------
test_group("num: primality");

assert_eq(num_is_prime(2), 1, "2 prime");
assert_eq(num_is_prime(3), 1, "3 prime");
assert_eq(num_is_prime(5), 1, "5 prime");
assert_eq(num_is_prime(7), 1, "7 prime");
assert_eq(num_is_prime(11), 1, "11 prime");
assert_eq(num_is_prime(13), 1, "13 prime");
assert_eq(num_is_prime(17), 1, "17 prime");
assert_eq(num_is_prime(0), 0, "0 not prime");
assert_eq(num_is_prime(1), 0, "1 not prime");
assert_eq(num_is_prime(4), 0, "4 not prime");
assert_eq(num_is_prime(9), 0, "9 not prime");
assert_eq(num_is_prime(15), 0, "15 not prime");

# ----------------------------------------------------------------
test_group("num: sieve");

var n_primes = num_sieve(100);
assert_eq(vec_len(n_primes), 25, "primes<=100 count=25");
assert_eq(vec_get(n_primes, 0), 2, "sieve first=2");
assert_eq(vec_get(n_primes, 24), 97, "sieve last=97");

# ----------------------------------------------------------------
test_group("num: pcg32 rng");

var n_rng = pcg32_new(42);
var n_r1 = pcg32_next(n_rng);
var n_r2 = pcg32_next(n_rng);
assert(n_r1 != n_r2, "rng different values");

# Different seeds produce different sequences
var n_rng2 = pcg32_new(123);
var n_r3 = pcg32_next(n_rng2);
assert(n_r1 != n_r3, "rng different seeds");

# ----------------------------------------------------------------
test_group("num: kahan and neumaier");

var n_kdata = alloc(24);
store64(n_kdata, f64_from(1));
store64(n_kdata + 8, f64_from(2));
store64(n_kdata + 16, f64_from(3));
var n_ks = num_kahan_sum(n_kdata, 3);
assert_eq(f64_to(n_ks), 6, "kahan sum");

var n_ns = num_neumaier_sum(n_kdata, 3);
assert_eq(f64_to(n_ns), 6, "neumaier sum");

# Empty sum (n=0)
var n_ns0 = num_neumaier_sum(n_kdata, 0);
assert_eq(f64_to(n_ns0), 0, "neumaier n=0");

# ----------------------------------------------------------------
test_group("num: fft roundtrip");

# DC signal: 4 complex elements, all = (1.0, 0.0)
var n_fft_data = alloc(64);  # 4 * 16 bytes
var _fi = 0;
while (_fi < 4) {
    store64(n_fft_data + _fi * 16, F64_ONE);
    store64(n_fft_data + _fi * 16 + 8, 0);
    _fi = _fi + 1;
}
var n_fft_rc = num_fft(n_fft_data, 4);
assert_eq(n_fft_rc, 0, "fft ok");
# DC component (index 0) should be 4+0i
assert_eq(f64_to(load64(n_fft_data)), 4, "fft DC re=4");
assert_eq(f64_to(load64(n_fft_data + 8)), 0, "fft DC im=0");

# Roundtrip: ifft should recover original
num_ifft(n_fft_data, 4);
# All elements should be (1.0, 0.0) again
assert_eq(f64_to(f64_round(load64(n_fft_data))), 1, "ifft[0].re=1");
assert_eq(f64_to(f64_round(load64(n_fft_data + 16))), 1, "ifft[1].re=1");
assert_eq(f64_to(f64_round(load64(n_fft_data + 8))), 0, "ifft[0].im=0");

# ================================================================
# COMPLEX — arithmetic, abs, conj, arg, euler, pauli, matrix (~20)
# ================================================================
test_group("complex: arithmetic");

var c_a = cx_new(f64_from(3), f64_from(4));
var c_b = cx_new(F64_ONE, F64_TWO);

# Add
var c_add = cx_add(c_a, c_b);
assert_eq(f64_to(HComplex_re(c_add)), 4, "cx add re");
assert_eq(f64_to(HComplex_im(c_add)), 6, "cx add im");

# Sub
var c_sub = cx_sub(c_a, c_b);
assert_eq(f64_to(HComplex_re(c_sub)), 2, "cx sub re");
assert_eq(f64_to(HComplex_im(c_sub)), 2, "cx sub im");

# Mul: (3+4i)(1+2i) = -5+10i
var c_mul = cx_mul(c_a, c_b);
assert_eq(f64_to(HComplex_re(c_mul)), (0 - 5), "cx mul re");
assert_eq(f64_to(HComplex_im(c_mul)), 10, "cx mul im");

# Div: (3+4i)/(1+2i) = (3+4i)(1-2i)/5 = (11-2i)/5 = 2.2-0.4i
var c_div = cx_div(c_a, c_b);
var c_div_re10 = f64_to(f64_round(f64_mul(HComplex_re(c_div), f64_from(10))));
assert_eq(c_div_re10, 22, "cx div re*10");

# ----------------------------------------------------------------
test_group("complex: abs, conj, arg");

assert_eq(f64_to(cx_abs(c_a)), 5, "abs(3+4i)=5");

var c_conj = cx_conj(c_a);
assert_eq(f64_to(HComplex_im(c_conj)), (0 - 4), "conj im");
assert_eq(f64_to(HComplex_re(c_conj)), 3, "conj re unchanged");

# arg(1+i) = pi/4
var c_1i = cx_new(F64_ONE, F64_ONE);
var c_arg = cx_arg(c_1i);
var c_arg_1000 = f64_to(f64_round(f64_mul(c_arg, f64_from(1000))));
var c_pi4_1000 = f64_to(f64_round(f64_mul(F64_PI_4, f64_from(1000))));
assert_eq(c_arg_1000, c_pi4_1000, "arg(1+i)=pi/4");

# ----------------------------------------------------------------
test_group("complex: euler identity");

# e^(i*pi) + 1 ~ 0
var c_eipi = cx_exp(cx_new(0, F64_PI));
var c_euler = cx_add(c_eipi, cx_one());
# cos(pi_d) rounds to exactly -1.0 and sin(pi_d) = 1.2246467991473532e-16, so the
# closed-form modulus is 1.2246e-16 (measured: identical). The old bound of 1.0
# passed for any argument within about +-60 deg of pi.
assert(f64_lt(cx_abs(c_euler), ULP_TOL_M) == 1, "euler e^(ipi)+1 == 0 (1e-15)");
# e^(i*pi)+1 == 0 is BLIND to conjugation: pi is a fixed point of z -> conj(z), so
# negating the imaginary output of cx_exp leaves this bit-identical (verified: such
# a mutant passes all four suites). Pin a point where the two differ.
# e^(i*pi/2) = 6.123233995736766e-17 + 1i
var _e_ih = cx_exp(cx_new(0, F64_PI_2));
assert(f64_lt(f64_abs(HComplex_re(_e_ih)), ULP_TOL_M) == 1, "cx_exp(i*pi/2).re == 0");
assert(f64_lt(f64_abs(f64_sub(HComplex_im(_e_ih), F64_ONE)), ULP_TOL_M) == 1,
"cx_exp(i*pi/2).im == +1 (not -1)");

# ----------------------------------------------------------------
test_group("complex: pauli matrices");

# sigma_x^2 = I
var c_sx = pauli_x();
var c_sx2 = cmat_mul(c_sx, c_sx);
var c_tr_sx2 = cmat_trace(c_sx2);
assert_eq(f64_to(HComplex_re(c_tr_sx2)), 2, "sx^2 trace=2");

# sigma_y^2 = I
var c_sy = pauli_y();
var c_sy2 = cmat_mul(c_sy, c_sy);
var c_tr_sy2 = cmat_trace(c_sy2);
assert_eq(f64_to(HComplex_re(c_tr_sy2)), 2, "sy^2 trace=2");

# sigma_z^2 = I
var c_sz = pauli_z();
var c_sz2 = cmat_mul(c_sz, c_sz);
var c_tr_sz2 = cmat_trace(c_sz2);
assert_eq(f64_to(HComplex_re(c_tr_sz2)), 2, "sz^2 trace=2");

# Traceless: tr(sigma_x) = 0
var c_tr_sx = cmat_trace(c_sx);
assert_eq(f64_to(HComplex_re(c_tr_sx)), 0, "sx traceless");
var c_tr_sy = cmat_trace(c_sy);
assert_eq(f64_to(HComplex_re(c_tr_sy)), 0, "sy traceless");
var c_tr_sz = cmat_trace(c_sz);
assert_eq(f64_to(HComplex_re(c_tr_sz)), 0, "sz traceless");

# Commutation: [sx, sy] = 2i*sz
var c_comm = cmat_commutator(c_sx, c_sy);
var c_c00 = cmat_get(c_comm, 0, 0);
assert_eq(f64_to(HComplex_im(c_c00)), 2, "[sx,sy]_00 im=2");

# ----------------------------------------------------------------
test_group("complex: matrix");

# Identity trace
var c_id = cmat_identity(3);
var c_id_tr = cmat_trace(c_id);
assert_eq(f64_to(HComplex_re(c_id_tr)), 3, "identity(3) trace=3");

# Adjoint of identity = identity
var c_id_adj = cmat_adjoint(c_id);
var c_id_adj_tr = cmat_trace(c_id_adj);
assert_eq(f64_to(HComplex_re(c_id_adj_tr)), 3, "adj(I) trace=3");
# If cmat_adjoint were a plain copy, the 8-generator hermitian sweep is A == A
# again -- verified: such a stub passes all four suites, because 'adj(I) trace==3'
# is satisfied by the identity function. Pin adjoint on a NON-hermitian matrix.
var _adj_m = cmat_new(2, 2);
cmat_set(_adj_m, 0, 1, cx_new(F64_TWO, f64_from(3)));
var _adj_r = cmat_adjoint(_adj_m);
assert_eq(f64_to(HComplex_re(cmat_get(_adj_r, 1, 0))), 2, "adj[1][0].re == 2 (transposed)");
assert_eq(f64_to(HComplex_im(cmat_get(_adj_r, 1, 0))), (0 - 3), "adj[1][0].im == -3 (conjugated)");
assert_eq(f64_to(HComplex_re(cmat_get(_adj_r, 0, 1))), 0, "adj[0][1] == 0 (not a copy)");

# ================================================================
# LIE GROUPS (~15)
# ================================================================
test_group("lie: U(1)");

# Compose = add phases
var l_u_a = u1_new(F64_PI_4);
var l_u_b = u1_new(F64_PI_4);
var l_u_c = u1_compose(l_u_a, l_u_b);
var l_u_phase = f64_to(f64_round(f64_mul(load64(l_u_c), f64_from(1000))));
var l_pi2_1000 = f64_to(f64_round(f64_mul(F64_PI_2, f64_from(1000))));
assert_eq(l_u_phase, l_pi2_1000, "u1 compose pi/4+pi/4=pi/2");

# Inverse: phase + (-phase) ~ 0
var l_u_inv = u1_inv(l_u_a);
var l_u_id = u1_compose(l_u_a, l_u_inv);
# f64_add(theta, f64_neg(theta)) is exactly +0.0 in IEEE-754 round-to-nearest for
# every finite theta, so this is exact. Measured bit pattern: 0x0.
assert_eq(load64(l_u_id), 0, "u1 inv phase is exactly +0.0");

# Exp/log roundtrip
var l_u_exp = u1_exp(F64_PI_4);
var l_u_log = u1_log(l_u_exp);
var l_u_rt = f64_to(f64_round(f64_mul(l_u_log, f64_from(1000))));
var l_pi4_1000 = f64_to(f64_round(f64_mul(F64_PI_4, f64_from(1000))));
assert_eq(l_u_rt, l_pi4_1000, "u1 exp/log roundtrip");

# ----------------------------------------------------------------
test_group("lie: SU(2)");

# Identity to_quat -> w=1
var l_su2_id = su2_identity();
var l_su2_q = su2_to_quat(l_su2_id);
assert_eq(f64_to(HQuat_w(l_su2_q)), 1, "su2 identity w=1");

# Compose inverse = identity
var l_su2_r = su2_from_axis_angle(hvec3_unit_z(), F64_PI_4);
var l_su2_ri = su2_inv(l_su2_r);
var l_su2_p = su2_compose(l_su2_r, l_su2_ri);
# Half-angle convention: su2_from_axis_angle(z_hat, pi/4) = cos(pi/8) + sin(pi/8) k.
# Pin those first -- w = 1 after compose-with-inverse and dw = 0 after a to_quat
# round-trip are both TRUE under a full-angle build, so neither check below can
# see the half-vs-full-angle split that shipped through 2.6.12.
#   cos(pi/8) = 0.9238795325112867   (a full-angle build would put 0.7071067811865476 here)
#   sin(pi/8) = 0.3826834323650898
var _cos_pi8 = 0x3FED906BCF328D46;  # 0.9238795325112867
var _sin_pi8 = 0x3FD87DE2A6AEA963;  # 0.3826834323650898
assert(f64_lt(f64_abs(f64_sub(_su2_w(l_su2_r), _cos_pi8)), ULP_TOL_M) == 1, "su2 axis-angle w == cos(pi/8)");
assert(f64_lt(f64_abs(f64_sub(_su2_z(l_su2_r), _sin_pi8)), ULP_TOL_M) == 1, "su2 axis-angle z == sin(pi/8)");
# w of q*q^-1 is w^2+x^2+y^2+z^2 = 1 exactly for a unit quaternion (measured
# residual 0). The old bound of 1.0 merely asserted w > 0.
assert(f64_lt(f64_abs(f64_sub(_su2_w(l_su2_p), F64_ONE)), ULP_TOL_M) == 1, "su2 compose inv w == 1 (1e-15)");
# w of q*q^-1 is an inner product, so EVERY su2 assertion in the repo (w == 1, the
# to_quat dw, the axis-angle pins) survives a sign flip in su2_compose's x/y/z
# cross terms -- verified. Pin all four components of a product of two
# non-parallel rotations.
var _c07 = 0x3FE6666666666666;  # 0.7
var _c11 = 0x3FF199999999999A;  # 1.1
var _sa = su2_from_axis_angle(hvec3_new(F64_ONE, F64_TWO, f64_from(3)), _c07);
var _sb = su2_from_axis_angle(hvec3_new(f64_neg(F64_TWO), F64_ONE, F64_HALF), _c11);
var _sp = su2_compose(_sa, _sb);
var _sp_w = 0x3FE89F9435EE839F;   # 0.7694798520425258
var _sp_x = 0xBFD91ACF6D1B1AAA;   # -0.392261368321139
var _sp_y = 0x3FCE094E17426F47;   # 0.23465896735876354
var _sp_z = 0x3FDC8C331EC15140;   # 0.44605710986549596  (a z-sign flip gives 0.2788)
assert(f64_lt(f64_abs(f64_sub(_su2_w(_sp), _sp_w)), TOL_1EM12) == 1, "su2_compose generic w");
assert(f64_lt(f64_abs(f64_sub(_su2_x(_sp), _sp_x)), TOL_1EM12) == 1, "su2_compose generic x");
assert(f64_lt(f64_abs(f64_sub(_su2_y(_sp), _sp_y)), TOL_1EM12) == 1, "su2_compose generic y");
assert(f64_lt(f64_abs(f64_sub(_su2_z(_sp), _sp_z)), TOL_1EM12) == 1, "su2_compose generic z");
# where: var TOL_1EM12 = 0x3D719799812DEA11;  # 1e-12 (== EPSILON_F64)

# to_quat roundtrip
var l_su2_q2 = su2_to_quat(l_su2_r);
var l_su2_back = su2_from_quat(l_su2_q2);
# Both w's live in [-1, 1], so |dw| < 1.0 was near-unfalsifiable. The round trip
# renormalizes by a norm of exactly 1.0 here: measured dw = 0.
assert(f64_lt(f64_abs(f64_sub(_su2_w(l_su2_back), _su2_w(l_su2_r))), ULP_TOL_M) == 1,
"su2 to_quat roundtrip dw == 0 (1e-15)");

# ----------------------------------------------------------------
test_group("lie: Gell-Mann");

# The three properties that CHARACTERISE the SU(3) Gell-Mann basis:
#   (1) lambda_a = lambda_a^H          (Hermitian, checked elementwise)
#   (2) tr lambda_a = 0                (traceless)
#   (3) tr(lambda_a lambda_b) = 2 delta_ab   (orthogonal, normalised to 2)
# Every expected value below is closed form. The ONLY floating-point residual
# anywhere in this block is tr(l8 l8): l8's entries are fl(1/fl(sqrt 3)), so the
# trace is 6*fl(x*x) = 2.0000000000000004 — exactly one ulp at 2.0
# (4.4408920985006262e-16) above the exact 2. Everything else is bit-exact:
# the other seven generators have entries in {0, +-1, +-i}, and l8's trace
# cancels exactly because fl(2/s) == 2*fl(1/s) for s = fl(sqrt 3).
var GM_TR_TOL = 0x3CD203AF9EE75616;   # 1e-15  = 2.25 ulp at 2.0
var GM_L8_TOL = 0x3CBCD2B297D889BC;   # 4e-16  = 3.6 ulp at 0.577, 1.8 ulp at 1.155
# Correctly-rounded doubles of 1/sqrt(3) and 2/sqrt(3), derived independently at
# 60 decimal digits (NOT read off the library, which rounds twice and lands
# 1 ulp high at 0x3FE279A74590331D — inside GM_L8_TOL).
var GM_L8_A  = 0x3FE279A74590331C;    #  1/sqrt(3) =  0.5773502691896257645091
var GM_L8_B2 = 0xBFF279A74590331C;    # -2/sqrt(3) = -1.1547005383792515290183

# --- (0) the checker must be able to FAIL --------------------------------
# The assertion this replaces compared Re(A[0][0]) against Re(adjoint(A)[0][0]),
# which is bit-identical for every complex matrix. These three controls prove
# _gm_is_herm actually discriminates.
var l_gm_nh1 = cmat_new(3, 3);
cmat_set(l_gm_nh1, 0, 1, cx_one());                 # 1 at (0,1), 0 at (1,0)
assert_eq(_gm_is_herm(l_gm_nh1), 0, "gm herm control: rejects non-symmetric real part");
var l_gm_nh2 = cmat_new(3, 3);
cmat_set(l_gm_nh2, 0, 0, cx_i());                   # imaginary entry on the diagonal
assert_eq(_gm_is_herm(l_gm_nh2), 0, "gm herm control: rejects imaginary diagonal");
var l_gm_nh3 = cmat_new(3, 3);                      # lambda_2 with the conjugation dropped
cmat_set(l_gm_nh3, 0, 1, cx_i());
cmat_set(l_gm_nh3, 1, 0, cx_i());
assert_eq(_gm_is_herm(l_gm_nh3), 0, "gm herm control: rejects unconjugated off-diagonal");

# --- (1) Hermiticity + (2) tracelessness, all 8 generators ---------------
var _gm_a = 0;
while (_gm_a < 8) {
    var l_gma = gell_mann(_gm_a);
    assert_eq(_gm_is_herm(l_gma), 1, "gell-mann hermitian (all 9 entries, re and im)");
    # Hermitian + traceless is invariant under PERMUTING the generators: swapping the
    # lambda_4 and lambda_5 bodies passes all four suites. Pin each one's identity.
    assert_eq(f64_to(HComplex_re(cmat_get(gell_mann(3), 0, 2))), 1, "lambda_4[0][2] == +1 (real)");
    assert_eq(f64_to(HComplex_im(cmat_get(gell_mann(3), 0, 2))), 0, "lambda_4[0][2] has no i");
    assert_eq(f64_to(HComplex_im(cmat_get(gell_mann(4), 0, 2))), (0 - 1), "lambda_5[0][2] == -i");
    assert_eq(f64_to(HComplex_re(cmat_get(gell_mann(4), 0, 2))), 0, "lambda_5[0][2] is pure imaginary");
    assert_eq(f64_to(HComplex_re(cmat_get(gell_mann(5), 1, 2))), 1, "lambda_6[1][2] == +1 (real)");
    assert_eq(f64_to(HComplex_im(cmat_get(gell_mann(6), 1, 2))), (0 - 1), "lambda_7[1][2] == -i");
    assert_eq(f64_to(HComplex_re(cmat_get(gell_mann(2), 0, 0))), 1, "lambda_3[0][0] == +1");
    assert_eq(f64_to(HComplex_re(cmat_get(gell_mann(2), 1, 1))), (0 - 1), "lambda_3[1][1] == -1");
    # cmat_adjoint must reproduce the matrix exactly — all 9 entries, both
    # components. Off-diagonal entries make this a real transpose+conjugate test.
    var l_gma_h = cmat_adjoint(l_gma);
    var l_gm_adj_bad = 0;
    var _gm_i = 0;
    while (_gm_i < 3) {
        var _gm_j = 0;
        while (_gm_j < 3) {
            var l_gm_u = cmat_get(l_gma, _gm_i, _gm_j);
            var l_gm_v = cmat_get(l_gma_h, _gm_i, _gm_j);
            if (f64_eq(HComplex_re(l_gm_u), HComplex_re(l_gm_v)) == 0) {
                l_gm_adj_bad = l_gm_adj_bad + 1;
            }
            if (f64_eq(HComplex_im(l_gm_u), HComplex_im(l_gm_v)) == 0) {
                l_gm_adj_bad = l_gm_adj_bad + 1;
            }
            _gm_j = _gm_j + 1;
        }
        _gm_i = _gm_i + 1;
    }
    assert_eq(l_gm_adj_bad, 0, "gell-mann adjoint == self, entrywise");
    # Traceless: exactly 0, both components (not "within 1.0").
    var l_gm_tr = cmat_trace(l_gma);
    assert_eq(f64_eq(HComplex_re(l_gm_tr), 0), 1, "gell-mann traceless (re exactly 0)");
    assert_eq(f64_eq(HComplex_im(l_gm_tr), 0), 1, "gell-mann traceless (im exactly 0)");
    _gm_a = _gm_a + 1;
}

# --- (3) orthogonality: tr(l_a l_b) = 2 delta_ab over all 64 pairs -------
var _gm_p = 0;
var l_gm_off_bad = 0;
var l_gm_diag_bad = 0;
var l_gm_im_bad = 0;
while (_gm_p < 8) {
    var l_gm_pa = gell_mann(_gm_p);
    var _gm_q = 0;
    while (_gm_q < 8) {
        var l_gm_t = cmat_trace(cmat_mul(l_gm_pa, gell_mann(_gm_q)));
        if (f64_eq(HComplex_im(l_gm_t), 0) == 0) { l_gm_im_bad = l_gm_im_bad + 1; }
        if (_gm_p == _gm_q) {
            if (f64_lt(f64_abs(f64_sub(HComplex_re(l_gm_t), F64_TWO)), GM_TR_TOL) == 0) {
                l_gm_diag_bad = l_gm_diag_bad + 1;
            }
        } else {
            if (f64_eq(HComplex_re(l_gm_t), 0) == 0) { l_gm_off_bad = l_gm_off_bad + 1; }
        }
        _gm_q = _gm_q + 1;
    }
    _gm_p = _gm_p + 1;
}
assert_eq(l_gm_off_bad, 0, "gell-mann tr(la lb) exactly 0 for a != b (56 pairs)");
assert_eq(l_gm_diag_bad, 0, "gell-mann tr(la la) = 2 within 1e-15 (8 pairs)");
assert_eq(l_gm_im_bad, 0, "gell-mann tr(la lb) exactly real (64 pairs)");

# Controls proving the Gram sweep measures normalisation, not a constant 2:
# tr((2 l1)^2) = 4 * tr(l1^2) = 8, and tr((l1+l4)^2) = 2 + 2*tr(l1 l4) + 2 = 4.
var l_gm_2l1 = cmat_scale(gell_mann(0), cx_real(F64_TWO));
var l_gm_ct1 = cmat_trace(cmat_mul(l_gm_2l1, l_gm_2l1));
assert_eq(f64_eq(HComplex_re(l_gm_ct1), f64_from(8)), 1, "gm gram control: tr((2 l1)^2) = 8");
var l_gm_s14 = cmat_add(gell_mann(0), gell_mann(3));
var l_gm_ct2 = cmat_trace(cmat_mul(l_gm_s14, l_gm_s14));
assert_eq(f64_eq(HComplex_re(l_gm_ct2), f64_from(4)), 1, "gm gram control: tr((l1+l4)^2) = 4");

# --- convention pin ------------------------------------------------------
# Hermiticity + tracelessness + tr(la lb) = 2 delta_ab are invariant under any
# unitary change of basis, so they do not by themselves pin the Gell-Mann
# convention. These do:
#   lambda_1 = [[0,1,0],[1,0,0],[0,0,0]]
#   lambda_3 = diag(1, -1, 0)
#   lambda_8 = diag(1, 1, -2)/sqrt(3)
#   [lambda_1, lambda_2] = 2i lambda_3   (structure constant f_123 = +1)
var l_gm_l1 = gell_mann(0);
assert_eq(f64_eq(HComplex_re(cmat_get(l_gm_l1, 0, 1)), F64_ONE), 1, "l1(0,1) = 1");
assert_eq(f64_eq(HComplex_re(cmat_get(l_gm_l1, 0, 0)), 0), 1, "l1(0,0) = 0");
var l_gm_l3 = gell_mann(2);
assert_eq(f64_eq(HComplex_re(cmat_get(l_gm_l3, 0, 0)), F64_ONE), 1, "l3(0,0) = +1");
assert_eq(f64_eq(HComplex_re(cmat_get(l_gm_l3, 1, 1)), f64_neg(F64_ONE)), 1, "l3(1,1) = -1");
assert_eq(f64_eq(HComplex_re(cmat_get(l_gm_l3, 2, 2)), 0), 1, "l3(2,2) = 0");
var l_gm_l8 = gell_mann(7);
var l_gm_e00 = HComplex_re(cmat_get(l_gm_l8, 0, 0));
var l_gm_e11 = HComplex_re(cmat_get(l_gm_l8, 1, 1));
var l_gm_e22 = HComplex_re(cmat_get(l_gm_l8, 2, 2));
assert_eq(f64_lt(f64_abs(f64_sub(l_gm_e00, GM_L8_A)), GM_L8_TOL), 1, "l8(0,0) = 1/sqrt(3)");
assert_eq(f64_eq(l_gm_e11, l_gm_e00), 1, "l8(1,1) == l8(0,0)");
assert_eq(f64_lt(f64_abs(f64_sub(l_gm_e22, GM_L8_B2)), GM_L8_TOL), 1, "l8(2,2) = -2/sqrt(3)");
assert_eq(f64_eq(HComplex_re(cmat_get(l_gm_l8, 0, 1)), 0), 1, "l8(0,1) = 0");
var l_gm_c12 = cmat_commutator(gell_mann(0), gell_mann(1));
var l_gm_k00 = cmat_get(l_gm_c12, 0, 0);
var l_gm_k11 = cmat_get(l_gm_c12, 1, 1);
assert_eq(f64_eq(HComplex_re(l_gm_k00), 0), 1, "[l1,l2](0,0) is pure imaginary");
assert_eq(f64_eq(HComplex_im(l_gm_k00), F64_TWO), 1, "[l1,l2] = 2i l3: (0,0) im = +2");
assert_eq(f64_eq(HComplex_im(l_gm_k11), f64_neg(F64_TWO)), 1, "[l1,l2] = 2i l3: (1,1) im = -2");
assert_eq(f64_eq(HComplex_im(cmat_get(l_gm_c12, 2, 2)), 0), 1, "[l1,l2] = 2i l3: (2,2) im = 0");
assert_eq(f64_eq(HComplex_im(cmat_get(l_gm_c12, 0, 1)), 0), 1, "[l1,l2] = 2i l3: (0,1) im = 0");
# --- (4) convention pin for lambda_4..lambda_7 ---------------------------
# Properties (1)-(3) are invariant under ANY real orthogonal mixing of
# lambda_4..lambda_7 (the 4-dim subspace orthogonal to l1,l2,l3,l8), and the
# pins above touch only l1, l2, l3, l8 -- so a sign flip on l5 or l7, a swap of
# l4 and l6, or a 45-degree rotation of (l4,l6) passes everything above.
# Each pin below plus Hermiticity plus tr(la la) = 2 determines the generator
# uniquely: two off-diagonal entries of modulus 1 already exhaust the norm.
assert_eq(f64_eq(HComplex_re(cmat_get(gell_mann(3), 0, 2)), F64_ONE), 1, "l4(0,2) = +1");
assert_eq(f64_eq(HComplex_im(cmat_get(gell_mann(3), 0, 2)), 0), 1, "l4(0,2) im = 0");
assert_eq(f64_eq(HComplex_re(cmat_get(gell_mann(3), 1, 2)), 0), 1, "l4(1,2) = 0");
assert_eq(f64_eq(HComplex_im(cmat_get(gell_mann(4), 0, 2)), f64_neg(F64_ONE)), 1, "l5(0,2) = -i");
assert_eq(f64_eq(HComplex_re(cmat_get(gell_mann(4), 0, 2)), 0), 1, "l5(0,2) re = 0");
assert_eq(f64_eq(HComplex_re(cmat_get(gell_mann(5), 1, 2)), F64_ONE), 1, "l6(1,2) = +1");
assert_eq(f64_eq(HComplex_re(cmat_get(gell_mann(5), 0, 2)), 0), 1, "l6(0,2) = 0");
assert_eq(f64_eq(HComplex_im(cmat_get(gell_mann(6), 1, 2)), f64_neg(F64_ONE)), 1, "l7(1,2) = -i");
assert_eq(f64_eq(HComplex_re(cmat_get(gell_mann(6), 1, 2)), 0), 1, "l7(1,2) re = 0");

# --- (5) algebra closure: [l_a, l_b] = 2i sum_c f_abc l_c ----------------
# The identity that actually ties the matrices to the algebra, over all 64
# pairs and all 9 entries. Also the first coverage su3_structure_constant
# (src/lie.cyr:310) has ever had -- grep -rn "su3_" tests/ returns nothing
# today, so the table and the matrices have never been checked against each
# other. Exact in double: 2 * (sqrt3/2) * (1/sqrt3) == 1.0 and
# 2 * (sqrt3/2) * (-2/sqrt3) == -2.0 bit for bit, so the tolerance is slack.
var l_gm_sc_bad = 0;
var _gm_u = 0;
while (_gm_u < 8) {
    var _gm_v = 0;
    while (_gm_v < 8) {
        var l_gm_lhs = cmat_commutator(gell_mann(_gm_u), gell_mann(_gm_v));
        var l_gm_rhs = cmat_new(3, 3);
        var _gm_c = 0;
        while (_gm_c < 8) {
            var l_gm_f = su3_structure_constant(_gm_u + 1, _gm_v + 1, _gm_c + 1);
            if (f64_eq(l_gm_f, 0) == 0) {
                var l_gm_w = cx_new(0, f64_mul(F64_TWO, l_gm_f));
                l_gm_rhs = cmat_add(l_gm_rhs, cmat_scale(gell_mann(_gm_c), l_gm_w));
            }
            _gm_c = _gm_c + 1;
        }
        var _gm_r = 0;
        while (_gm_r < 3) {
            var _gm_s = 0;
            while (_gm_s < 3) {
                var l_gm_lv = cmat_get(l_gm_lhs, _gm_r, _gm_s);
                var l_gm_rv = cmat_get(l_gm_rhs, _gm_r, _gm_s);
                var l_gm_dr = f64_abs(f64_sub(HComplex_re(l_gm_lv), HComplex_re(l_gm_rv)));
                var l_gm_di = f64_abs(f64_sub(HComplex_im(l_gm_lv), HComplex_im(l_gm_rv)));
                if (f64_lt(l_gm_dr, GM_TR_TOL) == 0) { l_gm_sc_bad = l_gm_sc_bad + 1; }
                if (f64_lt(l_gm_di, GM_TR_TOL) == 0) { l_gm_sc_bad = l_gm_sc_bad + 1; }
                _gm_s = _gm_s + 1;
            }
            _gm_r = _gm_r + 1;
        }
        _gm_v = _gm_v + 1;
    }
    _gm_u = _gm_u + 1;
}
assert_eq(l_gm_sc_bad, 0, "gell-mann [la,lb] = 2i f_abc lc (64 pairs, 9 entries, re+im)");

# ----------------------------------------------------------------
test_group("lie: Lorentz");

# Identity transforms (t,0,0,0) -> (t,0,0,0)
var l_lor_id = lorentz_identity();
var l_tv4 = alloc(32);
store64(l_tv4, F64_ONE); store64(l_tv4 + 8, 0); store64(l_tv4 + 16, 0); store64(l_tv4 + 24, 0);
var l_tv4_out = lorentz_transform_4vec(l_lor_id, l_tv4);
assert_eq(f64_to(load64(l_tv4_out)), 1, "lorentz id t");
assert_eq(f64_to(load64(l_tv4_out + 8)), 0, "lorentz id x");

# Boost validity: a boost should satisfy Lambda^T eta Lambda = eta
var l_boost = lorentz_boost_x(F64_HALF);
assert_eq(lorentz_is_valid(l_boost), 1, "boost is valid");
# lorentz_boost_x takes RAPIDITY, not velocity: Lambda^0_0 = cosh(0.5) and
# Lambda^1_0 = sinh(0.5). If it ever silently reverts to reading the argument as
# beta, those become gamma = 1.1547005383792517 and gamma*beta = 0.5773502691896258
# -- 0.027 and 0.056 away, both far outside 1e-15. The compose-inverse and
# interval-preservation checks below hold under EITHER reading, so they cannot
# see that regression; these two can.
var _cosh_half = 0x3FF20AC1862AE8D0;  # cosh(0.5) = 1.1276259652063807
var _sinh_half = 0x3FE0ACD00FE63B97;  # sinh(0.5) = 0.5210953054937474
assert(f64_lt(f64_abs(f64_sub(m4_get(l_boost, 0, 0), _cosh_half)), ULP_TOL_M) == 1,
"boost_x(0.5)[0][0] == cosh(0.5)");
assert(f64_lt(f64_abs(f64_sub(m4_get(l_boost, 1, 0), _sinh_half)), ULP_TOL_M) == 1,
"boost_x(0.5)[1][0] == sinh(0.5)");

# Compose inverse = identity (approx)
var l_boost_inv = lorentz_inv(l_boost);
var l_comp = lorentz_compose(l_boost, l_boost_inv);
# Diagonal should be ~1, off-diagonal ~0
# cosh^2 - sinh^2 = 1 in closed form; measured residual 2.22e-16 (1 ulp). The old
# bound of 1.0 accepted any [0][0] in [0, 2]. Check an off-diagonal too, or a
# lorentz_inv that returned the identity would leave [0][0] = cosh(0.5) = 1.128
# and still pass.
assert(f64_lt(f64_abs(f64_sub(m4_get(l_comp, 0, 0), F64_ONE)), ULP_TOL_M) == 1,
"lorentz compose inv [0][0] == 1 (1e-15)");
assert(f64_lt(f64_abs(f64_sub(m4_get(l_comp, 1, 1), F64_ONE)), ULP_TOL_M) == 1,
"lorentz compose inv [1][1] == 1 (1e-15)");
assert(f64_lt(f64_abs(m4_get(l_comp, 0, 1)), ULP_TOL_M) == 1, "lorentz compose inv [0][1] == 0");

# Preserves Minkowski interval
var l_tv4b = alloc(32);
store64(l_tv4b, f64_from(5)); store64(l_tv4b + 8, f64_from(3));
store64(l_tv4b + 16, 0); store64(l_tv4b + 24, 0);
var l_intv_before = minkowski_interval(l_tv4b);
var l_tv4b_out = lorentz_transform_4vec(l_boost, l_tv4b);
var l_intv_after = minkowski_interval(l_tv4b_out);
var l_intv_diff = f64_abs(f64_sub(l_intv_before, l_intv_after));
# Pin the interval itself: 5^2 - 3^2 = 16 exactly. A (-,+,+,+) signature would
# give -16 and the before/after DIFFERENCE would still be 0, so the preservation
# check alone is blind to a global sign flip.
assert_eq(f64_to(l_intv_before), 16, "minkowski interval of (5,3,0,0) == +16");
# Boosted by rapidity 0.5: t' = 5cosh+3sinh = 7.201415742513145,
# x' = 5sinh+3cosh = 5.988354423087879, t'^2 - x'^2 = 15.999999999999993.
# Measured drift 7.105e-15 = 4 ulp of 16. The old bound of 1.0 was a 6.25%
# relative tolerance on a quantity of magnitude 16.
assert(f64_lt(l_intv_diff, IVL_TOL_M) == 1, "lorentz preserves interval (1e-13)");
# (5,3,0,0) leaves y and z at zero, so dropping either spatial term is invisible
# to both the +16 pin and the 1e-13 drift bound -- verified across all four suites.
var _mv = alloc(32);
store64(_mv, f64_from(5)); store64(_mv + 8, f64_from(3));
store64(_mv + 16, f64_from(4)); store64(_mv + 24, F64_TWO);
# 25 - 9 - 16 - 4 = -4
assert_eq(f64_to(minkowski_interval(_mv)), (0 - 4), "interval(5,3,4,2) == -4");
var _mo = lorentz_transform_4vec(l_boost, _mv);
assert(f64_lt(f64_abs(f64_sub(minkowski_interval(_mo), minkowski_interval(_mv))), TOL_1EM12) == 1,
"boost preserves interval(5,3,4,2)");

# ================================================================
# DIFFERENTIAL GEOMETRY (~10)
# ================================================================
test_group("diffgeo: flat metric");

# Flat 2D Euclidean: g_inv = diag(1,1), all metric derivs = 0
var dg_metric_inv = alloc(32);
store64(dg_metric_inv, F64_ONE); store64(dg_metric_inv + 8, 0);
store64(dg_metric_inv + 16, 0); store64(dg_metric_inv + 24, F64_ONE);

var dg_deriv = alloc(64);
var _dg_i = 0;
while (_dg_i < 8) { store64(dg_deriv + _dg_i * 8, 0); _dg_i = _dg_i + 1; }

var dg_chris = christoffel_symbols(dg_metric_inv, dg_deriv, 2);
assert_eq(f64_to(christoffel_get(dg_chris, 2, 0, 0, 0)), 0, "flat Gamma^0_00=0");
assert_eq(f64_to(christoffel_get(dg_chris, 2, 1, 0, 1)), 0, "flat Gamma^1_01=0");
assert_eq(f64_to(christoffel_get(dg_chris, 2, 0, 1, 0)), 0, "flat Gamma^0_10=0");
assert_eq(f64_to(christoffel_get(dg_chris, 2, 1, 1, 1)), 0, "flat Gamma^1_11=0");

# Riemann from flat (all zero christoffel derivs -> all zero riemann)
var dg_chris_deriv = alloc(128);
var _dg_j = 0;
while (_dg_j < 16) { store64(dg_chris_deriv + _dg_j * 8, 0); _dg_j = _dg_j + 1; }
var dg_riemann = riemann_tensor(dg_chris, dg_chris_deriv, 2);
assert_eq(f64_to(riemann_get(dg_riemann, 2, 0, 0, 0, 1)), 0, "flat Riemann=0");
assert_eq(f64_to(riemann_get(dg_riemann, 2, 1, 0, 0, 1)), 0, "flat Riemann b=0");

# Ricci tensor (all zero)
var dg_ricci = ricci_tensor(dg_riemann, 2);
assert_eq(f64_to(ricci_get(dg_ricci, 2, 0, 0)), 0, "flat Ricci=0");

# Ricci scalar = 0
var dg_scalar = ricci_scalar(dg_ricci, dg_metric_inv, 2);
assert_eq(f64_to(dg_scalar), 0, "flat scalar=0");

# Einstein tensor (R_mn - 1/2 R g_mn, but R=0 and all R_mn=0 -> 0)
var dg_metric = alloc(32);
store64(dg_metric, F64_ONE); store64(dg_metric + 8, 0);
store64(dg_metric + 16, 0); store64(dg_metric + 24, F64_ONE);
var dg_einstein = einstein_tensor(dg_ricci, dg_metric, dg_metric_inv, 2);
assert_eq(f64_to(load64(dg_einstein)), 0, "flat Einstein=0");

# ----------------------------------------------------------------
test_group("diffgeo: wedge product");

# alpha=(1,0), beta=(0,1) -> wedge = 1
var dg_alpha = alloc(16);
store64(dg_alpha, F64_ONE); store64(dg_alpha + 8, 0);
var dg_beta = alloc(16);
store64(dg_beta, 0); store64(dg_beta + 8, F64_ONE);
var dg_w = wedge_1_1(dg_alpha, dg_beta, 2);
assert_eq(f64_to(load64(dg_w)), 1, "wedge e1^e2=1");

# Antisymmetry: alpha ^ alpha = 0
var dg_w2 = wedge_1_1(dg_alpha, dg_alpha, 2);
assert_eq(f64_to(load64(dg_w2)), 0, "wedge alpha^alpha=0");

# ================================================================
# SYMBOLIC (~15)
# ================================================================
test_group("symbolic: evaluate");

# Evaluate constant
var s_c = expr_const(f64_from(42));
var s_empty = vec_new();
assert_eq(f64_to(expr_eval(s_c, s_empty)), 42, "eval const");

# Evaluate variable
var s_x = expr_var(str_from("x"));
var s_binds = vec_new();
vec_push(s_binds, expr_bind(str_from("x"), f64_from(7)));
assert_eq(f64_to(expr_eval(s_x, s_binds)), 7, "eval var");

# Evaluate x^2 + 3 at x=2 -> 7
var s_x2 = expr_mul(s_x, s_x);
var s_e = expr_add(s_x2, expr_const(f64_from(3)));
var s_binds2 = vec_new();
vec_push(s_binds2, expr_bind(str_from("x"), f64_from(2)));
assert_eq(f64_to(expr_eval(s_e, s_binds2)), 7, "eval x^2+3 at 2");

# Evaluate sin(0) = 0
var s_sin0 = expr_sin(expr_const(0));
assert_eq(f64_to(expr_eval(s_sin0, s_empty)), 0, "eval sin(0)");

# Evaluate exp(0) = 1
var s_exp0 = expr_exp(expr_const(0));
assert_eq(f64_to(expr_eval(s_exp0, s_empty)), 1, "eval exp(0)");

# ----------------------------------------------------------------
test_group("symbolic: differentiate");

# d/dx(const) = 0
var s_dc = expr_diff(expr_const(f64_from(5)), str_from("x"));
assert_eq(f64_to(expr_eval(s_dc, s_empty)), 0, "diff const=0");

# d/dx(x) = 1
var s_dx = expr_diff(expr_var(str_from("x")), str_from("x"));
assert_eq(f64_to(expr_eval(s_dx, s_binds2)), 1, "diff x=1");

# d/dx(x^2) at x=2 -> 4
var s_dx2 = expr_simplify(expr_diff(s_x2, str_from("x")));
assert_eq(f64_to(expr_eval(s_dx2, s_binds2)), 4, "diff x^2 at 2 = 4");

# d/dx(sin(x)) at x=0 -> cos(0) = 1
var s_sin_x = expr_sin(expr_var(str_from("x")));
var s_dsin = expr_simplify(expr_diff(s_sin_x, str_from("x")));
var s_binds0 = vec_new();
vec_push(s_binds0, expr_bind(str_from("x"), 0));
assert_eq(f64_to(expr_eval(s_dsin, s_binds0)), 1, "diff sin at 0 = cos(0)=1");

# d/dx(exp(x)) at x=0 -> exp(0) = 1
var s_exp_x = expr_exp(expr_var(str_from("x")));
var s_dexp = expr_simplify(expr_diff(s_exp_x, str_from("x")));
assert_eq(f64_to(expr_eval(s_dexp, s_binds0)), 1, "diff exp at 0 = 1");

# ----------------------------------------------------------------
test_group("symbolic: simplify");

# 0 + x = x
var s_xv = expr_var(str_from("x"));
var s_zero_plus = expr_add(expr_const(0), s_xv);
var s_sp = expr_simplify(s_zero_plus);
assert_eq(expr_tag(s_sp), EXPR_VAR, "0+x -> var");

# 1 * x = x
var s_one_mul = expr_mul(expr_const(F64_ONE), s_xv);
var s_sp2 = expr_simplify(s_one_mul);
assert_eq(expr_tag(s_sp2), EXPR_VAR, "1*x -> var");

# 0 * x = 0
var s_zero_mul = expr_mul(expr_const(0), s_xv);
var s_sp3 = expr_simplify(s_zero_mul);
assert_eq(expr_tag(s_sp3), EXPR_CONST, "0*x -> const");

# x^0 = 1
var s_pow0 = expr_pow(s_xv, expr_const(0));
var s_sp4 = expr_simplify(s_pow0);
assert_eq(expr_tag(s_sp4), EXPR_CONST, "x^0 -> const");
assert_eq(f64_to(expr_eval(s_sp4, s_empty)), 1, "x^0 = 1");

# x^1 = x
var s_pow1 = expr_pow(s_xv, expr_const(F64_ONE));
var s_sp5 = expr_simplify(s_pow1);
assert_eq(expr_tag(s_sp5), EXPR_VAR, "x^1 -> var");

# --x = x (double negation)
var s_dblneg = expr_neg(expr_neg(s_xv));
var s_sp6 = expr_simplify(s_dblneg);
assert_eq(expr_tag(s_sp6), EXPR_VAR, "--x -> var");

# ----------------------------------------------------------------
test_group("symbolic: to_str");

var s_str_c = expr_to_str(expr_const(f64_from(42)));
assert(str_eq(s_str_c, str_from("42")) == 1, "to_str const 42");

var s_str_v = expr_to_str(expr_var(str_from("y")));
assert(str_eq(s_str_v, str_from("y")) == 1, "to_str var y");

# ================================================================
# AUTODIFF (~10)
# ================================================================
test_group("autodiff: x^2");

# f(x) = x^2 at x=3: val=9, deriv=6
var ad_x3 = dual_var(f64_from(3));
var ad_x3_sq = dual_mul(ad_x3, ad_x3);
assert_eq(f64_to(Dual_val(ad_x3_sq)), 9, "x^2 at 3 val=9");
assert_eq(f64_to(Dual_deriv(ad_x3_sq)), 6, "x^2 at 3 deriv=6");

# f(x) = x^2 at x=0: val=0, deriv=0
var ad_x0 = dual_var(0);
var ad_x0_sq = dual_mul(ad_x0, ad_x0);
assert_eq(f64_to(Dual_val(ad_x0_sq)), 0, "x^2 at 0 val=0");
assert_eq(f64_to(Dual_deriv(ad_x0_sq)), 0, "x^2 at 0 deriv=0");

# ----------------------------------------------------------------
test_group("autodiff: sin/cos/exp/ln/sqrt");

# sin(0)=0, deriv=cos(0)=1
var ad_sin0 = dual_sin(dual_var(0));
assert_eq(f64_to(Dual_val(ad_sin0)), 0, "sin(0) val");
assert_eq(f64_to(Dual_deriv(ad_sin0)), 1, "sin(0) deriv=cos(0)=1");

# cos(0)=1, deriv=-sin(0)=0
var ad_cos0 = dual_cos(dual_var(0));
assert_eq(f64_to(Dual_val(ad_cos0)), 1, "cos(0) val");
assert_eq(f64_to(Dual_deriv(ad_cos0)), 0, "cos(0) deriv=-sin(0)=0");

# exp(0)=1, deriv=exp(0)=1
var ad_exp0 = dual_exp(dual_var(0));
assert_eq(f64_to(Dual_val(ad_exp0)), 1, "exp(0) val");
assert_eq(f64_to(Dual_deriv(ad_exp0)), 1, "exp(0) deriv");

# ln(1)=0, deriv=1/1=1
var ad_ln1 = dual_ln(dual_var(F64_ONE));
assert_eq(f64_to(Dual_val(ad_ln1)), 0, "ln(1) val");
assert_eq(f64_to(Dual_deriv(ad_ln1)), 1, "ln(1) deriv");

# sqrt(4)=2, deriv=1/(2*2)=0.25
var ad_sqrt4 = dual_sqrt(dual_var(f64_from(4)));
assert_eq(f64_to(Dual_val(ad_sqrt4)), 2, "sqrt(4) val");
var ad_sqrt4_d = f64_to(f64_round(f64_mul(Dual_deriv(ad_sqrt4), f64_from(100))));
assert_eq(ad_sqrt4_d, 25, "sqrt(4) deriv*100=25");

# ----------------------------------------------------------------
test_group("autodiff: composition");

# f(x) = x^2 + 2x at x=3: val = 9+6 = 15, deriv = 2x+2 = 8
var ad_x = dual_var(f64_from(3));
var ad_x_sq = dual_mul(ad_x, ad_x);
var ad_2x = dual_mul(dual_const(F64_TWO), ad_x);
var ad_comp = dual_add(ad_x_sq, ad_2x);
assert_eq(f64_to(Dual_val(ad_comp)), 15, "x^2+2x at 3 val=15");
assert_eq(f64_to(Dual_deriv(ad_comp)), 8, "x^2+2x at 3 deriv=8");

# ================================================================
# INTERVAL (~10)
# ================================================================
test_group("interval: arithmetic");

# NOTE: the interval result vars are named iv_sum/iv_diff/iv_prod, NOT
# iv_add/iv_sub/iv_mul. Those three names are RESERVED SIMD intrinsics in cyrius
# (packed integer-vector add/sub/mul, see the toolchain's lib/simd.cyr) — using
# them as variable names fails to compile with a misleading
# `expected identifier, got unknown` (deterministic, 8/8). iv_div/iv_neg are
# fine (there is no integer-vector divide, so iv_div was never reserved). Do NOT
# rename these back. See docs/development/issues/2026-07-17-cyrius-interval-ident-lex.md.
var iv_a = ivl_new(f64_from(1), f64_from(3));
var iv_b = ivl_new(f64_from(2), f64_from(4));

# Add: [1,3]+[2,4] = [3,7]
var iv_sum = ivl_add(iv_a, iv_b);
assert_eq(f64_to(Interval_lo(iv_sum)), 3, "ivl add lo");
assert_eq(f64_to(Interval_hi(iv_sum)), 7, "ivl add hi");

# Sub: [1,3]-[2,4] = [1-4, 3-2] = [-3, 1]
var iv_diff = ivl_sub(iv_a, iv_b);
assert_eq(f64_to(Interval_lo(iv_diff)), (0 - 3), "ivl sub lo");
assert_eq(f64_to(Interval_hi(iv_diff)), 1, "ivl sub hi");

# Mul: [1,3]*[2,4] = [2,12]
var iv_prod = ivl_mul(iv_a, iv_b);
assert_eq(f64_to(Interval_lo(iv_prod)), 2, "ivl mul lo");
assert_eq(f64_to(Interval_hi(iv_prod)), 12, "ivl mul hi");

# Div: [1,3]/[2,4] = [1/4, 3/2] = [0.25, 1.5]
var iv_div = ivl_div(iv_a, iv_b);
var iv_div_lo100 = f64_to(f64_round(f64_mul(Interval_lo(iv_div), f64_from(100))));
assert_eq(iv_div_lo100, 25, "ivl div lo*100=25");

# ----------------------------------------------------------------
test_group("interval: queries");

assert_eq(ivl_contains(iv_a, f64_from(2)), 1, "ivl contains 2");
assert_eq(ivl_contains(iv_a, f64_from(4)), 0, "ivl not contains 4");
assert_eq(ivl_overlaps(iv_a, iv_b), 1, "ivl overlaps");
assert_eq(f64_to(ivl_width(iv_a)), 2, "ivl width=2");
assert_eq(f64_to(ivl_midpoint(iv_a)), 2, "ivl midpoint=2");

# ----------------------------------------------------------------
test_group("interval: neg, abs, sqrt, point");

# Neg: -[1,3] = [-3,-1]
var iv_neg = ivl_neg(iv_a);
assert_eq(f64_to(Interval_lo(iv_neg)), (0 - 3), "ivl neg lo");
assert_eq(f64_to(Interval_hi(iv_neg)), (0 - 1), "ivl neg hi");

# Abs: |[-3,1]| = [0,3] (contains 0)
var iv_neg3_1 = ivl_new(f64_neg(f64_from(3)), F64_ONE);
var iv_abs = ivl_abs(iv_neg3_1);
assert_eq(f64_to(Interval_lo(iv_abs)), 0, "ivl abs lo=0");
assert_eq(f64_to(Interval_hi(iv_abs)), 3, "ivl abs hi=3");

# Sqrt: sqrt([4,9]) = [2,3]
var iv_49 = ivl_new(f64_from(4), f64_from(9));
var iv_sqrt = ivl_sqrt(iv_49);
assert_eq(f64_to(Interval_lo(iv_sqrt)), 2, "ivl sqrt lo=2");
assert_eq(f64_to(Interval_hi(iv_sqrt)), 3, "ivl sqrt hi=3");

# Point interval
var iv_pt = ivl_point(f64_from(5));
assert_eq(f64_to(ivl_width(iv_pt)), 0, "point width=0");
assert_eq(f64_to(ivl_midpoint(iv_pt)), 5, "point mid=5");

# ================================================================
# TENSOR (~10)
# ================================================================
test_group("tensor: create, get/set");

var t_shape = alloc(16);
store64(t_shape, 3); store64(t_shape + 8, 4);
var t = tensor_new(2, t_shape);
assert_eq(f64_to(tensor_get2(t, 0, 0)), 0, "tensor zero init");

tensor_set2(t, 1, 2, f64_from(42));
assert_eq(f64_to(tensor_get2(t, 1, 2)), 42, "tensor set/get");
assert_eq(f64_to(tensor_get2(t, 2, 3)), 0, "tensor other still 0");

# ----------------------------------------------------------------
test_group("tensor: kronecker delta");

assert_eq(f64_to(kronecker_delta(0, 0)), 1, "delta ii=1");
assert_eq(f64_to(kronecker_delta(1, 1)), 1, "delta jj=1");
assert_eq(f64_to(kronecker_delta(0, 1)), 0, "delta ij=0");
assert_eq(f64_to(kronecker_delta(2, 3)), 0, "delta 23=0");

# ----------------------------------------------------------------
test_group("tensor: minkowski metric");

assert_eq(f64_to(minkowski(0, 0)), 1, "eta 00=+1");
assert_eq(f64_to(minkowski(1, 1)), (0 - 1), "eta 11=-1");
assert_eq(f64_to(minkowski(2, 2)), (0 - 1), "eta 22=-1");
assert_eq(f64_to(minkowski(3, 3)), (0 - 1), "eta 33=-1");
assert_eq(f64_to(minkowski(0, 1)), 0, "eta 01=0");

# ----------------------------------------------------------------
test_group("tensor: levi-civita 3D");

assert_eq(f64_to(levi_civita_3(0, 1, 2)), 1, "eps 012=+1");
assert_eq(f64_to(levi_civita_3(1, 2, 0)), 1, "eps 120=+1");
assert_eq(f64_to(levi_civita_3(2, 0, 1)), 1, "eps 201=+1");
assert_eq(f64_to(levi_civita_3(1, 0, 2)), (0 - 1), "eps 102=-1");
assert_eq(levi_civita_3(0, 0, 1), 0, "eps repeated=0");

# ----------------------------------------------------------------
test_group("tensor: levi-civita 4D");

assert_eq(f64_to(levi_civita_4(0, 1, 2, 3)), 1, "eps4 0123=+1");
assert_eq(f64_to(levi_civita_4(1, 0, 2, 3)), (0 - 1), "eps4 1023=-1");
assert_eq(levi_civita_4(0, 0, 1, 2), 0, "eps4 repeated=0");

# ----------------------------------------------------------------
test_group("tensor: tensor_add");

var t_shape2 = alloc(16);
store64(t_shape2, 2); store64(t_shape2 + 8, 2);
var t_a = tensor_new(2, t_shape2);
tensor_set2(t_a, 0, 0, f64_from(1));
tensor_set2(t_a, 0, 1, f64_from(2));
tensor_set2(t_a, 1, 0, f64_from(3));
tensor_set2(t_a, 1, 1, f64_from(4));

var t_b = tensor_new(2, t_shape2);
tensor_set2(t_b, 0, 0, f64_from(10));
tensor_set2(t_b, 0, 1, f64_from(20));
tensor_set2(t_b, 1, 0, f64_from(30));
tensor_set2(t_b, 1, 1, f64_from(40));

var t_sum = tensor_add(t_a, t_b);
assert_eq(f64_to(tensor_get2(t_sum, 0, 0)), 11, "tensor_add [0,0]");
assert_eq(f64_to(tensor_get2(t_sum, 0, 1)), 22, "tensor_add [0,1]");
assert_eq(f64_to(tensor_get2(t_sum, 1, 0)), 33, "tensor_add [1,0]");
assert_eq(f64_to(tensor_get2(t_sum, 1, 1)), 44, "tensor_add [1,1]");

# ================================================================
# COLLISION_CORE — contacts, sequential impulse smoke
# ================================================================
# 2.4.x collision-correctness arc COMPLETE — every algorithm audited + covered:
# convex_hull_2d (2.4.0), triangulate_polygon (2.4.1), delaunay_2d (2.4.2),
# half-edge mesh (2.4.3), MPR narrowphase (2.4.4), and sequential_impulse (2.4.5,
# below); solve_pgs is covered in hisab.tcyr. Real bugs were found + fixed in the
# hull sort (2.4.0), MPR (2.4.4), and the impulse solver (2.4.5).
test_group("collision_core: contact_new + accessors");

var c_norm = hvec3_new(0, F64_ONE, 0);
var contact = contact_new(0, 1, c_norm, F64_HALF, F64_HALF, F64_HALF, F64_ONE, F64_ONE);
assert_eq(ColContact_body_a(contact), 0, "ColContact body_a");
assert_eq(ColContact_body_b(contact), 1, "ColContact body_b");
assert_eq(f64_to(ColContact_penetration(contact)), 0, "ColContact penetration (0.5 → f64_to → 0 truncated)");

# MPR narrowphase (2.4.4) — fixed a false-positive: separated shapes used to
# report a hit (missing origin-containment early-out → degenerate colinear
# branch returned 1). Now intersect/penetration are correct for spheres + boxes.
test_group("collision_core: MPR narrowphase");

var mpr_a = hvec4_new(0, 0, 0, F64_TWO);            # sphere r=2 @ origin
var mpr_b_ov = hvec4_new(f64_from(3), 0, 0, F64_TWO);   # dist 3 < 4 → overlap
var mpr_b_sep = hvec4_new(f64_from(5), 0, 0, F64_ONE);  # dist 5 > 3 → separated
var mpr_b_off = hvec4_new(f64_from(5), f64_from(5), 0, F64_ONE);  # off-axis sep

var mpr_ov = mpr_intersect(&_mpr_sup_sphere, mpr_a, &_mpr_sup_sphere, mpr_b_ov);
assert_eq(mpr_ov, 1, "mpr_intersect: spheres overlap");
var mpr_sep = mpr_intersect(&_mpr_sup_sphere, mpr_a, &_mpr_sup_sphere, mpr_b_sep);
assert_eq(mpr_sep, 0, "mpr_intersect: spheres separated (was false +ve)");
var mpr_off = mpr_intersect(&_mpr_sup_sphere, mpr_a, &_mpr_sup_sphere, mpr_b_off);
assert_eq(mpr_off, 0, "mpr_intersect: spheres separated off-axis");

# Penetration: depth = sum_radii − dist. Normal along ±x. Scale by 100 for f64_to.
var mpr_n = alloc(8);
var mpr_d = alloc(8);
var mpr_hit = mpr_penetration(&_mpr_sup_sphere, mpr_a, &_mpr_sup_sphere, mpr_b_ov, mpr_n, mpr_d);
assert_eq(mpr_hit, 1, "mpr_penetration: overlap returns hit");
assert_eq(f64_to(f64_mul(load64(mpr_d), f64_from(100))), 100, "mpr_penetration: depth ~1.0 (4-3)");
var mpr_nx = f64_abs(HVec3_x(load64(mpr_n)));
assert_eq(f64_to(f64_mul(mpr_nx, f64_from(100))), 100, "mpr_penetration: normal ~±x");

var mpr_b_deep = hvec4_new(F64_ONE, 0, 0, F64_TWO);     # dist 1 → depth 4-1 = 3
var mpr_n2 = alloc(8);
var mpr_d2 = alloc(8);
mpr_penetration(&_mpr_sup_sphere, mpr_a, &_mpr_sup_sphere, mpr_b_deep, mpr_n2, mpr_d2);
assert_eq(f64_to(f64_mul(load64(mpr_d2), f64_from(100))), 300, "mpr_penetration: deep depth ~3.0 (4-1)");

var mpr_n3 = alloc(8);
var mpr_d3 = alloc(8);
var mpr_miss = mpr_penetration(&_mpr_sup_sphere, mpr_a, &_mpr_sup_sphere, mpr_b_sep, mpr_n3, mpr_d3);
assert_eq(mpr_miss, 0, "mpr_penetration: separated returns miss");

# Boxes (axis-aligned): overlap + separated.
var mpr_box_a = _mpr_mkbox(0, 0, 0, F64_ONE, F64_ONE, F64_ONE);
var mpr_box_ov = _mpr_mkbox(F64_ONE, 0, 0, F64_ONE, F64_ONE, F64_ONE);
var mpr_boxov = mpr_intersect(&_mpr_sup_box, mpr_box_a, &_mpr_sup_box, mpr_box_ov);
assert_eq(mpr_boxov, 1, "mpr_intersect: boxes overlap");
var mpr_box_sep = _mpr_mkbox(f64_from(5), 0, 0, F64_ONE, F64_ONE, F64_ONE);
var mpr_boxsep = mpr_intersect(&_mpr_sup_box, mpr_box_a, &_mpr_sup_box, mpr_box_sep);
assert_eq(mpr_boxsep, 0, "mpr_intersect: boxes separated");

# sequential_impulse (2.4.5) — fixed: the normal impulse was computed with the
# wrong sign and without folding the accumulated impulse into the effective
# velocity, so it clamped to 0 every iteration (the solver did nothing). Now it
# converges to λ = (1+e)·pen / inv_mass and is iteration-independent.
test_group("collision_core: sequential_impulse");

# Resting contact, e=0, two dynamic bodies (inv_mass 1+1=2), pen=0.5 → λ=0.25.
var si_c = contact_new(0, 1, hvec3_unit_y(), F64_HALF, 0, 0, F64_ONE, F64_ONE);
var si_cs = vec_new();
vec_push(si_cs, si_c);
var si_out = alloc(16);
sequential_impulse(si_cs, 1, 10, si_out);
assert_eq(f64_to(f64_mul(load64(si_out), f64_from(100))), 25, "sequential_impulse: resting λ=0.25 (was 0)");

# Idempotent: e=0 converges in a single iteration to the same impulse.
var si_out1 = alloc(16);
sequential_impulse(si_cs, 1, 1, si_out1);
assert_eq(f64_to(f64_mul(load64(si_out1), f64_from(100))), 25, "sequential_impulse: converges in 1 iter");

# Dynamic vs static (inv_mass 1+0=1), pen=1.0 → λ=1.0.
var si_c2 = contact_new(0, 1, hvec3_unit_y(), F64_ONE, 0, 0, F64_ONE, 0);
var si_cs2 = vec_new();
vec_push(si_cs2, si_c2);
var si_out2 = alloc(16);
sequential_impulse(si_cs2, 1, 20, si_out2);
assert_eq(f64_to(f64_mul(load64(si_out2), f64_from(100))), 100, "sequential_impulse: dynamic+static λ=1.0");

# Both static (inv_mass 0) → contact skipped, impulse stays 0.
var si_c3 = contact_new(0, 1, hvec3_unit_y(), F64_HALF, 0, 0, 0, 0);
var si_cs3 = vec_new();
vec_push(si_cs3, si_c3);
var si_out3 = alloc(16);
sequential_impulse(si_cs3, 1, 5, si_out3);
assert_eq(f64_to(load64(si_out3)), 0, "sequential_impulse: both-static skipped (λ=0)");

# convex_hull_2d (2.4.0) — Andrew's monotone chain. Square (side 2) plus an
# interior point: the hull is the 4 corners in CCW order; the interior point
# is dropped. Shoelace 2×area = +8 pins both the geometry and the orientation.
test_group("collision_core: convex_hull_2d");

var ch_pts = vec_new();
vec_push(ch_pts, hvec2_new(0, 0));               # idx 0
vec_push(ch_pts, hvec2_new(F64_TWO, 0));         # idx 1
vec_push(ch_pts, hvec2_new(F64_TWO, F64_TWO));   # idx 2
vec_push(ch_pts, hvec2_new(0, F64_TWO));         # idx 3
vec_push(ch_pts, hvec2_new(F64_ONE, F64_ONE));   # idx 4 (interior)
var ch_hull = convex_hull_2d(ch_pts, 5);
assert_eq(vec_len(ch_hull), 4, "convex_hull_2d: square+interior → 4 hull vertices");

assert_neq(vec_get(ch_hull, 0), 4, "convex_hull_2d: interior excluded [0]");
assert_neq(vec_get(ch_hull, 1), 4, "convex_hull_2d: interior excluded [1]");
assert_neq(vec_get(ch_hull, 2), 4, "convex_hull_2d: interior excluded [2]");
assert_neq(vec_get(ch_hull, 3), 4, "convex_hull_2d: interior excluded [3]");

var ch_h0 = vec_get(ch_pts, vec_get(ch_hull, 0));
var ch_h1 = vec_get(ch_pts, vec_get(ch_hull, 1));
var ch_h2 = vec_get(ch_pts, vec_get(ch_hull, 2));
var ch_h3 = vec_get(ch_pts, vec_get(ch_hull, 3));
var ch_a = f64_sub(f64_mul(HVec2_x(ch_h0), HVec2_y(ch_h1)), f64_mul(HVec2_x(ch_h1), HVec2_y(ch_h0)));
ch_a = f64_add(ch_a, f64_sub(f64_mul(HVec2_x(ch_h1), HVec2_y(ch_h2)), f64_mul(HVec2_x(ch_h2), HVec2_y(ch_h1))));
ch_a = f64_add(ch_a, f64_sub(f64_mul(HVec2_x(ch_h2), HVec2_y(ch_h3)), f64_mul(HVec2_x(ch_h3), HVec2_y(ch_h2))));
ch_a = f64_add(ch_a, f64_sub(f64_mul(HVec2_x(ch_h3), HVec2_y(ch_h0)), f64_mul(HVec2_x(ch_h0), HVec2_y(ch_h3))));
assert_eq(f64_to(ch_a), 8, "convex_hull_2d: shoelace 2xarea = +8 (CCW, exact square)");

# Degeneracies (2.4.0) — each must return a defined hull, never trap.

# Empty / single point → trivial passthrough.
var ch_empty = vec_new();
assert_eq(vec_len(convex_hull_2d(ch_empty, 0)), 0, "convex_hull_2d: empty -> 0 vertices");
var ch_one = vec_new();
vec_push(ch_one, hvec2_new(F64_ONE, F64_ONE));
assert_eq(vec_len(convex_hull_2d(ch_one, 1)), 1, "convex_hull_2d: single point -> 1 vertex");

# Triangle → all 3 vertices; shoelace 2×area = +4 (CCW).
var ch_t = vec_new();
vec_push(ch_t, hvec2_new(0, 0));
vec_push(ch_t, hvec2_new(F64_TWO, 0));
vec_push(ch_t, hvec2_new(F64_ONE, F64_TWO));
var ch_th = convex_hull_2d(ch_t, 3);
assert_eq(vec_len(ch_th), 3, "convex_hull_2d: triangle -> 3 vertices");
var ch_t0 = vec_get(ch_t, vec_get(ch_th, 0));
var ch_t1 = vec_get(ch_t, vec_get(ch_th, 1));
var ch_t2 = vec_get(ch_t, vec_get(ch_th, 2));
var ch_ta = f64_sub(f64_mul(HVec2_x(ch_t0), HVec2_y(ch_t1)), f64_mul(HVec2_x(ch_t1), HVec2_y(ch_t0)));
ch_ta = f64_add(ch_ta, f64_sub(f64_mul(HVec2_x(ch_t1), HVec2_y(ch_t2)), f64_mul(HVec2_x(ch_t2), HVec2_y(ch_t1))));
ch_ta = f64_add(ch_ta, f64_sub(f64_mul(HVec2_x(ch_t2), HVec2_y(ch_t0)), f64_mul(HVec2_x(ch_t0), HVec2_y(ch_t2))));
assert_eq(f64_to(ch_ta), 4, "convex_hull_2d: triangle shoelace 2xarea = +4 (CCW)");

# Collinear → only the 2 extreme endpoints (interior point dropped).
var ch_c = vec_new();
vec_push(ch_c, hvec2_new(0, 0));
vec_push(ch_c, hvec2_new(F64_ONE, 0));
vec_push(ch_c, hvec2_new(F64_TWO, 0));
var ch_ch = convex_hull_2d(ch_c, 3);
assert_eq(vec_len(ch_ch), 2, "convex_hull_2d: collinear -> 2 endpoints");
var ch_c0 = vec_get(ch_c, vec_get(ch_ch, 0));
var ch_c1 = vec_get(ch_c, vec_get(ch_ch, 1));
var ch_cspan = f64_to(f64_abs(f64_sub(HVec2_x(ch_c0), HVec2_x(ch_c1))));
assert_eq(ch_cspan, 2, "convex_hull_2d: collinear endpoints span x=0..2");

# Duplicate corner → still the 4-vertex square (no spurious vertex, no trap).
var ch_d = vec_new();
vec_push(ch_d, hvec2_new(0, 0));
vec_push(ch_d, hvec2_new(0, 0));
vec_push(ch_d, hvec2_new(F64_TWO, 0));
vec_push(ch_d, hvec2_new(F64_TWO, F64_TWO));
vec_push(ch_d, hvec2_new(0, F64_TWO));
assert_eq(vec_len(convex_hull_2d(ch_d, 5)), 4, "convex_hull_2d: duplicate corner -> 4 vertices");

# triangulate_polygon (2.4.1) — ear clipping. Audited; no bug found. Each case
# checks the count (3*(n-2) flat indices) and that the triangles tile the
# polygon: |Σ 2×area| == polygon |2×area| (abs makes it winding-agnostic).
test_group("collision_core: triangulate_polygon");

# Convex quad (side-2 square) → 2 triangles, 2×area = 8.
var tp_q = vec_new();
vec_push(tp_q, hvec2_new(0, 0));
vec_push(tp_q, hvec2_new(F64_TWO, 0));
vec_push(tp_q, hvec2_new(F64_TWO, F64_TWO));
vec_push(tp_q, hvec2_new(0, F64_TWO));
var tp_qt = triangulate_polygon(tp_q, 4);
assert_eq(vec_len(tp_qt), 6, "triangulate_polygon: convex quad -> 2 triangles");
assert_eq(f64_to(f64_abs(_tp_area2x(tp_q, tp_qt))), 8, "triangulate_polygon: quad tiles (2xarea=8)");

# Concave 5-gon (reflex at (1,1)) → 3 triangles, 2×area = 6.
var tp_c = vec_new();
vec_push(tp_c, hvec2_new(0, 0));
vec_push(tp_c, hvec2_new(F64_TWO, 0));
vec_push(tp_c, hvec2_new(F64_TWO, F64_TWO));
vec_push(tp_c, hvec2_new(F64_ONE, F64_ONE));
vec_push(tp_c, hvec2_new(0, F64_TWO));
var tp_ct = triangulate_polygon(tp_c, 5);
assert_eq(vec_len(tp_ct), 9, "triangulate_polygon: concave 5-gon -> 3 triangles");
assert_eq(f64_to(f64_abs(_tp_area2x(tp_c, tp_ct))), 6, "triangulate_polygon: concave tiles (2xarea=6)");

# Convex hexagon → 4 triangles, 2×area = 24.
var tp_h = vec_new();
vec_push(tp_h, hvec2_new(0, 0));
vec_push(tp_h, hvec2_new(F64_TWO, 0));
vec_push(tp_h, hvec2_new(f64_from(3), F64_TWO));
vec_push(tp_h, hvec2_new(F64_TWO, f64_from(4)));
vec_push(tp_h, hvec2_new(0, f64_from(4)));
vec_push(tp_h, hvec2_new(f64_neg(F64_ONE), F64_TWO));
var tp_ht = triangulate_polygon(tp_h, 6);
assert_eq(vec_len(tp_ht), 12, "triangulate_polygon: hexagon -> 4 triangles");
assert_eq(f64_to(f64_abs(_tp_area2x(tp_h, tp_ht))), 24, "triangulate_polygon: hexagon tiles (2xarea=24)");

# U-shape (8 verts, 2 reflex) → 6 triangles, 2×area = 14.
var tp_u = vec_new();
vec_push(tp_u, hvec2_new(0, 0));
vec_push(tp_u, hvec2_new(f64_from(3), 0));
vec_push(tp_u, hvec2_new(f64_from(3), f64_from(3)));
vec_push(tp_u, hvec2_new(F64_TWO, f64_from(3)));
vec_push(tp_u, hvec2_new(F64_TWO, F64_ONE));
vec_push(tp_u, hvec2_new(F64_ONE, F64_ONE));
vec_push(tp_u, hvec2_new(F64_ONE, f64_from(3)));
vec_push(tp_u, hvec2_new(0, f64_from(3)));
var tp_ut = triangulate_polygon(tp_u, 8);
assert_eq(vec_len(tp_ut), 18, "triangulate_polygon: U-shape (2 reflex) -> 6 triangles");
assert_eq(f64_to(f64_abs(_tp_area2x(tp_u, tp_ut))), 14, "triangulate_polygon: U-shape tiles (2xarea=14)");

# CW winding (reversed square) → still 2 triangles tiling area 4.
var tp_w = vec_new();
vec_push(tp_w, hvec2_new(0, 0));
vec_push(tp_w, hvec2_new(0, F64_TWO));
vec_push(tp_w, hvec2_new(F64_TWO, F64_TWO));
vec_push(tp_w, hvec2_new(F64_TWO, 0));
var tp_wt = triangulate_polygon(tp_w, 4);
assert_eq(vec_len(tp_wt), 6, "triangulate_polygon: CW quad -> 2 triangles");
assert_eq(f64_to(f64_abs(_tp_area2x(tp_w, tp_wt))), 8, "triangulate_polygon: CW quad tiles (2xarea=8)");

# Collinear edge vertex (1,0) on the bottom edge → 3 triangles, 2×area = 8.
var tp_l = vec_new();
vec_push(tp_l, hvec2_new(0, 0));
vec_push(tp_l, hvec2_new(F64_ONE, 0));
vec_push(tp_l, hvec2_new(F64_TWO, 0));
vec_push(tp_l, hvec2_new(F64_TWO, F64_TWO));
vec_push(tp_l, hvec2_new(0, F64_TWO));
var tp_lt = triangulate_polygon(tp_l, 5);
assert_eq(vec_len(tp_lt), 9, "triangulate_polygon: collinear edge vertex -> 3 triangles");
assert_eq(f64_to(f64_abs(_tp_area2x(tp_l, tp_lt))), 8, "triangulate_polygon: collinear tiles (2xarea=8)");

# < 3 vertices → empty.
var tp_deg = vec_new();
vec_push(tp_deg, hvec2_new(0, 0));
vec_push(tp_deg, hvec2_new(F64_ONE, 0));
assert_eq(vec_len(triangulate_polygon(tp_deg, 2)), 0, "triangulate_polygon: n<3 -> empty");

# ================================================================
# COLLISION_MESH — Delaunay, half-edge, island detection
# ================================================================

# delaunay_2d (2.4.2) — Bowyer-Watson. Audited; no bug found, numerically robust
# (incl. the cocircular grid). Each fixture checks the empty-circumcircle
# (Delaunay) property holds — no point strictly inside any triangle's
# circumcircle — plus the triangle count (3 indices per triangle).
test_group("collision_mesh: delaunay_2d");

# Square (side 4) + interior point → 4 triangles, Delaunay-valid.
var dl_sq = vec_new();
vec_push(dl_sq, hvec2_new(0, 0));
vec_push(dl_sq, hvec2_new(f64_from(4), 0));
vec_push(dl_sq, hvec2_new(f64_from(4), f64_from(4)));
vec_push(dl_sq, hvec2_new(0, f64_from(4)));
vec_push(dl_sq, hvec2_new(F64_ONE, F64_ONE));
var dl_sqt = delaunay_2d(dl_sq, 5);
assert_eq(vec_len(dl_sqt), 12, "delaunay_2d: square+interior -> 4 triangles");
assert_eq(_dl_violations(dl_sq, 5, dl_sqt), 0, "delaunay_2d: square+interior empty-circumcircle");

# 3x3 grid — heavy cocircularity, the numerical-stability stress case.
var dl_g = vec_new();
vec_push(dl_g, hvec2_new(0, 0));
vec_push(dl_g, hvec2_new(F64_ONE, 0));
vec_push(dl_g, hvec2_new(F64_TWO, 0));
vec_push(dl_g, hvec2_new(0, F64_ONE));
vec_push(dl_g, hvec2_new(F64_ONE, F64_ONE));
vec_push(dl_g, hvec2_new(F64_TWO, F64_ONE));
vec_push(dl_g, hvec2_new(0, F64_TWO));
vec_push(dl_g, hvec2_new(F64_ONE, F64_TWO));
vec_push(dl_g, hvec2_new(F64_TWO, F64_TWO));
var dl_gt = delaunay_2d(dl_g, 9);
assert_eq(vec_len(dl_gt), 24, "delaunay_2d: 3x3 grid -> 8 triangles");
assert_eq(_dl_violations(dl_g, 9, dl_gt), 0, "delaunay_2d: 3x3 grid empty-circumcircle (cocircular)");

# Irregular 6-point set.
var dl_i = vec_new();
vec_push(dl_i, hvec2_new(0, 0));
vec_push(dl_i, hvec2_new(f64_from(5), F64_ONE));
vec_push(dl_i, hvec2_new(f64_from(3), f64_from(4)));
vec_push(dl_i, hvec2_new(F64_ONE, f64_from(5)));
vec_push(dl_i, hvec2_new(f64_from(6), f64_from(5)));
vec_push(dl_i, hvec2_new(F64_TWO, F64_TWO));
var dl_it = delaunay_2d(dl_i, 6);
assert_eq(_dl_violations(dl_i, 6, dl_it), 0, "delaunay_2d: irregular-6 empty-circumcircle");

# Single triangle (n=3).
var dl_t = vec_new();
vec_push(dl_t, hvec2_new(0, 0));
vec_push(dl_t, hvec2_new(f64_from(4), 0));
vec_push(dl_t, hvec2_new(F64_TWO, f64_from(3)));
assert_eq(vec_len(delaunay_2d(dl_t, 3)), 3, "delaunay_2d: n=3 -> 1 triangle");

# Degenerate: n<3 and all-collinear → empty, never a trap.
var dl_two = vec_new();
vec_push(dl_two, hvec2_new(0, 0));
vec_push(dl_two, hvec2_new(F64_ONE, 0));
assert_eq(vec_len(delaunay_2d(dl_two, 2)), 0, "delaunay_2d: n<3 -> empty");
var dl_col = vec_new();
vec_push(dl_col, hvec2_new(0, 0));
vec_push(dl_col, hvec2_new(F64_ONE, 0));
vec_push(dl_col, hvec2_new(F64_TWO, 0));
vec_push(dl_col, hvec2_new(f64_from(3), 0));
assert_eq(vec_len(delaunay_2d(dl_col, 4)), 0, "delaunay_2d: all-collinear -> empty (no trap)");

# halfedge mesh (2.4.3) — halfedge_from_triangles + adjacency / boundary queries.
# Audited; no bug found. Twin wiring (reverse-edge match), the one-ring boundary
# walk, and adjacent-faces-via-twins are correct on closed + open meshes.
test_group("collision_mesh: half-edge mesh");

# Tetrahedron (closed manifold): every edge shared → no boundary vertices,
# each face has 3 neighbours.
var he_tet = vec_new();
_he_tri(he_tet, 0, 1, 2);
_he_tri(he_tet, 0, 2, 3);
_he_tri(he_tet, 0, 3, 1);
_he_tri(he_tet, 1, 3, 2);
var he_tm = halfedge_from_triangles(he_tet, 4, 4);
assert_eq(_he_boundary_sum(he_tm, 4), 0, "half-edge: tetrahedron has no boundary vertices");
assert_eq(vec_len(halfedge_adjacent_faces(he_tm, 0)), 3, "half-edge: tetrahedron face has 3 neighbours");

# Single triangle (open): all 3 verts boundary, no neighbours.
var he_one = vec_new();
_he_tri(he_one, 0, 1, 2);
var he_om = halfedge_from_triangles(he_one, 1, 3);
assert_eq(_he_boundary_sum(he_om, 3), 3, "half-edge: single triangle all-boundary");
assert_eq(vec_len(halfedge_adjacent_faces(he_om, 0)), 0, "half-edge: single triangle has no neighbours");

# Two triangles sharing diagonal 0-2: all 4 corners boundary, face 0 has 1 neighbour.
var he_q = vec_new();
_he_tri(he_q, 0, 1, 2);
_he_tri(he_q, 0, 2, 3);
var he_qm = halfedge_from_triangles(he_q, 2, 4);
assert_eq(_he_boundary_sum(he_qm, 4), 4, "half-edge: quad corners all boundary");
assert_eq(vec_len(halfedge_adjacent_faces(he_qm, 0)), 1, "half-edge: quad face shares 1 edge");

# Hexagon fan: center (0) interior, rim (1..6) boundary → one-ring walk closes.
var he_f = vec_new();
_he_tri(he_f, 0, 1, 2);
_he_tri(he_f, 0, 2, 3);
_he_tri(he_f, 0, 3, 4);
_he_tri(he_f, 0, 4, 5);
_he_tri(he_f, 0, 5, 6);
_he_tri(he_f, 0, 6, 1);
var he_fm = halfedge_from_triangles(he_f, 6, 7);
assert_eq(halfedge_is_boundary(he_fm, 0), 0, "half-edge: fan center is interior");
assert_eq(halfedge_is_boundary(he_fm, 1), 1, "half-edge: fan rim vertex is boundary");
assert_eq(_he_boundary_sum(he_fm, 7), 6, "half-edge: fan has 6 boundary (rim) vertices");
assert_eq(vec_len(halfedge_adjacent_faces(he_fm, 0)), 2, "half-edge: fan face0 shares 2 edges");

# Error path: empty triangle list → null mesh.
var he_empty = vec_new();
assert_eq(halfedge_from_triangles(he_empty, 0, 0), 0, "half-edge: empty -> null mesh");

test_group("collision_mesh: detect_islands");

# Two contact-connected components: bodies {0,1} and {2,3}
var ic1 = contact_new(0, 1, hvec3_unit_y(), F64_HALF, F64_HALF, F64_HALF, F64_ONE, F64_ONE);
var ic2 = contact_new(2, 3, hvec3_unit_y(), F64_HALF, F64_HALF, F64_HALF, F64_ONE, F64_ONE);
var ic_vec = vec_new();
vec_push(ic_vec, ic1);
vec_push(ic_vec, ic2);
var islands = detect_islands(ic_vec, 2, 4);
assert_eq(vec_len(islands), 2, "detect_islands: 2 disjoint contact pairs → 2 islands");

# ================================================================
# einsum — first coverage (the module shipped untested through 2.6.12)
# ================================================================
# `_einsum_is_label` accepted only 'a'..'h', so every example in einsum.cyr's OWN
# header ("ij,jk->ik", "ii->", "ij->ji", "i,j->ij") used labels the parser
# rejected — and it SKIPPED them silently rather than erroring, so matmul returned
# the trace (5, not 19) and then SEGFAULTED. Alphabet widened to a-z and every
# malformed spec is now an explicit 0-return.
test_group("einsum: documented notations");

fn _es_mk2(r2, c2, v0, v1, v2, v3) {
    var sh = alloc(16);
    store64(sh, r2);
    store64(sh + 8, c2);
    var t = tensor_new(2, sh);
    var d = HTensor_data(t);
    store64(d, v0);
    store64(d + 8, v1);
    store64(d + 16, v2);
    store64(d + 24, v3);
    return t;
}

# A = [[1,2],[3,4]], B = [[5,6],[7,8]] -> A*B = [[19,22],[43,50]]
var es_A = _es_mk2(2, 2, f64_from(1), f64_from(2), f64_from(3), f64_from(4));
var es_B = _es_mk2(2, 2, f64_from(5), f64_from(6), f64_from(7), f64_from(8));
var es_two = alloc(16);
store64(es_two, es_A);
store64(es_two + 8, es_B);
var es_one = alloc(8);
store64(es_one, es_A);

var es_mm = einsum(str_from("ij,jk->ik"), es_two, 2);
assert_neq(es_mm, 0, "einsum: matmul returns a tensor");
assert_eq(f64_to(tensor_get2(es_mm, 0, 0)), 19, "einsum matmul [0][0]=19");
assert_eq(f64_to(tensor_get2(es_mm, 0, 1)), 22, "einsum matmul [0][1]=22");
assert_eq(f64_to(tensor_get2(es_mm, 1, 0)), 43, "einsum matmul [1][0]=43");
assert_eq(f64_to(tensor_get2(es_mm, 1, 1)), 50, "einsum matmul [1][1]=50");

var es_tr = einsum(str_from("ii->"), es_one, 1);
assert_neq(es_tr, 0, "einsum: trace returns a tensor");
assert_eq(f64_to(load64(HTensor_data(es_tr))), 5, "einsum trace(A)=5");

var es_tp = einsum(str_from("ij->ji"), es_one, 1);
assert_neq(es_tp, 0, "einsum: transpose returns a tensor");
assert_eq(f64_to(tensor_get2(es_tp, 0, 1)), 3, "einsum transpose [0][1]=3");
assert_eq(f64_to(tensor_get2(es_tp, 1, 0)), 2, "einsum transpose [1][0]=2");

test_group("mat3 — first coverage (module shipped untested through 2.6.12)");
var m3i = m3_identity();
assert_eq(f64_to(m3_determinant(m3i)), 1, "m3_determinant(I)=1");
assert_eq(f64_to(m3_trace(m3i)), 3, "m3_trace(I)=3");
var m3p = m3_mul(m3i, m3i);
assert_eq(f64_to(m3_get(m3p, 0, 0)), 1, "m3_mul(I,I)[0][0]=1");
assert_eq(f64_to(m3_get(m3p, 1, 0)), 0, "m3_mul(I,I)[1][0]=0");
# M * M^-1 = I for a non-symmetric invertible matrix
var m3a = m3_new();
m3_set(m3a, 0, 0, f64_from(2)); m3_set(m3a, 0, 1, F64_ONE);   m3_set(m3a, 0, 2, 0);
m3_set(m3a, 1, 0, F64_ONE);     m3_set(m3a, 1, 1, f64_from(3)); m3_set(m3a, 1, 2, F64_ONE);
m3_set(m3a, 2, 0, 0);           m3_set(m3a, 2, 1, F64_ONE);   m3_set(m3a, 2, 2, F64_TWO);
var m3inv = m3_inverse(m3a);
assert_neq(m3inv, 0, "m3_inverse returns non-null");
var m3ii = m3_mul(m3a, m3inv);
assert(f64_approx_eq(m3_get(m3ii, 0, 0), F64_ONE, LOOSE_TOL_M), "m3 inv round-trip [0][0]=1");
assert(f64_approx_eq(m3_get(m3ii, 1, 1), F64_ONE, LOOSE_TOL_M), "m3 inv round-trip [1][1]=1");
assert(f64_approx_eq(m3_get(m3ii, 0, 1), 0, LOOSE_TOL_M), "m3 inv round-trip [0][1]=0");
# transpose is an involution; det(M^T) == det(M)
assert(f64_approx_eq(m3_determinant(m3_transpose(m3a)), m3_determinant(m3a), LOOSE_TOL_M),
"m3 det(M^T)==det(M)");
# from_quat(identity) is the identity rotation
assert(f64_approx_eq(m3_trace(m3_from_quat(hquat_identity())), f64_from(3), LOOSE_TOL_M),
"m3_from_quat(identity) trace=3");

test_group("Lie: SU(2)->SO(3) double cover (half-angle convention)");
# su2_exp used a FULL-angle convention through 2.6.12 while so3_exp,
# su2_from_axis_angle and su2_to_rotation_matrix all use half-angle, so these two
# rotations differed by a factor of 2 — and se3_exp built R and t from angles a
# factor of 2 apart, producing a pair that was not the exponential of any twist.
var lw = hvec3_new(f64_div(F64_ONE, f64_from(3)), f64_div(F64_ONE, F64_TWO),
f64_div(F64_ONE, f64_from(5)));
var lR_su2 = su2_to_rotation_matrix(su2_exp(lw));
var lR_so3 = so3_exp(lw);
var lei = 0;
while (lei < 9) {
    assert(f64_approx_eq(load64(lR_su2 + lei * 8), load64(lR_so3 + lei * 8), LOOSE_TOL_M),
    "su2_to_rotation_matrix(su2_exp(w)) == so3_exp(w)");
    lei = lei + 1;
}
# exp must agree with the axis-angle constructor
var lax = hvec3_new(0, 0, F64_ONE);
assert(f64_approx_eq(_su2_w(su2_exp(hvec3_scale(lax, F64_PI_2))),
_su2_w(su2_from_axis_angle(lax, F64_PI_2)), LOOSE_TOL_M),
"su2_exp == su2_from_axis_angle (w)");
# log inverts exp
var llg = su2_log(su2_exp(lw));
assert(f64_approx_eq(HVec3_x(llg), HVec3_x(lw), LOOSE_TOL_M), "su2_log(su2_exp(w)).x == w.x");
assert(f64_approx_eq(HVec3_y(llg), HVec3_y(lw), LOOSE_TOL_M), "su2_log(su2_exp(w)).y == w.y");
assert(f64_approx_eq(HVec3_z(llg), HVec3_z(lw), LOOSE_TOL_M), "su2_log(su2_exp(w)).z == w.z");

test_group("lie_ext: SE(3) — first coverage (module shipped untested through 2.6.12)");
var ltw = alloc(48);
store64(ltw, HVec3_x(lw));
store64(ltw + 8, HVec3_y(lw));
store64(ltw + 16, HVec3_z(lw));
store64(ltw + 24, F64_ONE);
store64(ltw + 32, F64_TWO);
store64(ltw + 40, f64_from(3));
var lse = se3_exp(ltw);
assert_neq(lse, 0, "se3_exp returns non-null");
# se3_log must invert se3_exp on all six twist components
var ltw2 = se3_log(lse);
lei = 0;
while (lei < 6) {
    assert(f64_approx_eq(load64(ltw2 + lei * 8), load64(ltw + lei * 8), LOOSE_TOL_M),
    "se3_log(se3_exp(twist)) round-trips");
    lei = lei + 1;
}
# and its rotation block must be the SAME rotation so3_exp gives for that omega
var lR_se3 = su2_to_rotation_matrix(_se3_rot(lse));
lei = 0;
while (lei < 9) {
    assert(f64_approx_eq(load64(lR_se3 + lei * 8), load64(lR_so3 + lei * 8), LOOSE_TOL_M),
    "se3_exp rotation block == so3_exp(omega)");
    lei = lei + 1;
}

# ================================================================
# calc_ext + noise_simplex — first coverage (untested through 2.6.13)
# ================================================================
# ================================================================
# Collision hot paths — O(n log n) rewrites (2.6.15)
# ================================================================
# Both were O(n^2). The assertions here pin the CONTRACT, not the timing:
# a correct sort is a zero-inversion permutation, and a correct half-edge mesh
# satisfies twin(twin(i)) == i with a known boundary count. Timings live in
# bench-history.csv (convex_hull_2d_2k, halfedge_2k_tris).
# ================================================================
# num_ext + symbolic_ext — final two never-tested modules (2.6.15)
# ================================================================
# With these, all 34 shipped modules are included by at least one suite.
test_group("num_ext: transforms and number theory");

# num_dst is DST-I (its label said Type II through 2.6.14). DST-I is its own
# inverse up to the 2/(n+1) scale, so idst(dst(x)) must round-trip.
var ne_n = 8;
var ne_x = alloc(ne_n * 8);
var ne_orig = alloc(ne_n * 8);
var ne_i = 0;
while (ne_i < ne_n) {
    var ne_v = f64_from((ne_i * 7) % 5 + 1);
    store64(ne_x + ne_i * 8, ne_v);
    store64(ne_orig + ne_i * 8, ne_v);
    ne_i = ne_i + 1;
}
assert_eq(num_dst(ne_x, ne_n), HSB_ERR_NONE, "num_dst returns HSB_ERR_NONE");
assert_eq(num_idst(ne_x, ne_n), HSB_ERR_NONE, "num_idst returns HSB_ERR_NONE");
var ne_bad = 0;
ne_i = 0;
while (ne_i < ne_n) {
    if (f64_approx_eq(load64(ne_x + ne_i * 8), load64(ne_orig + ne_i * 8), LOOSE_TOL_M) == 0) {
        ne_bad = ne_bad + 1;
    }
    ne_i = ne_i + 1;
}
assert_eq(ne_bad, 0, "num_idst(num_dst(x)) round-trips");
# The round-trip above is necessary but NOT sufficient: DST-I is symmetric with
# S^2 = ((n+1)/2) I, and so is -S, and so is every other symmetric involution
# (DCT-I included). A global sign flip, or the wrong kernel entirely, round-trips
# perfectly. Pin the kernel itself with delta inputs, which read off one column:
#   x = e_j  =>  X[k] = sin(PI (j+1)(k+1) / (n+1))
# With n = 7 the angles are exact multiples of PI/8, so the column is a closed
# form: sin(PI/8)=0.3826834323650898, sin(PI/4)=0.7071067811865476,
#       sin(3PI/8)=0.9238795325112867, sin(PI/2)=1.
var nd = alloc(7 * 8);
var ndi = 0;
while (ndi < 7) { store64(nd + ndi * 8, 0); ndi = ndi + 1; }
store64(nd, F64_ONE);                      # x = e_0
assert_eq(num_dst(nd, 7), HSB_ERR_NONE, "num_dst(e_0) ok");
assert(f64_approx_eq(load64(nd + 0), 0x3FD87DE2A6AEA963, EPSILON_F64), "DST-I e0 k0 sin(PI/8)");
assert(f64_approx_eq(load64(nd + 8), 0x3FE6A09E667F3BCC, EPSILON_F64), "DST-I e0 k1 sin(PI/4)");
assert(f64_approx_eq(load64(nd + 16), 0x3FED906BCF328D46, EPSILON_F64), "DST-I e0 k2 sin(3PI/8)");
assert(f64_approx_eq(load64(nd + 24), F64_ONE, EPSILON_F64), "DST-I e0 k3 sin(PI/2)=1");
assert(f64_approx_eq(load64(nd + 32), 0x3FED906BCF328D46, EPSILON_F64), "DST-I e0 k4 sin(5PI/8)");
assert(f64_approx_eq(load64(nd + 40), 0x3FE6A09E667F3BCC, EPSILON_F64), "DST-I e0 k5 sin(3PI/4)");
assert(f64_approx_eq(load64(nd + 48), 0x3FD87DE2A6AEA963, EPSILON_F64), "DST-I e0 k6 sin(7PI/8)");
# x = e_1 -> X[k] = sin(PI (k+1)/4): the signed, zero-crossing column. This is
# what catches a sign flip or a cosine kernel; column 0 above is palindromic.
var nd2 = alloc(7 * 8);
ndi = 0;
while (ndi < 7) { store64(nd2 + ndi * 8, 0); ndi = ndi + 1; }
store64(nd2 + 8, F64_ONE);
assert_eq(num_dst(nd2, 7), HSB_ERR_NONE, "num_dst(e_1) ok");
assert(f64_approx_eq(load64(nd2 + 0), 0x3FE6A09E667F3BCC, EPSILON_F64), "DST-I e1 k0 = +sqrt2/2");
assert(f64_approx_eq(load64(nd2 + 8), F64_ONE, EPSILON_F64), "DST-I e1 k1 = +1");
assert(f64_approx_eq(load64(nd2 + 16), 0x3FE6A09E667F3BCC, EPSILON_F64), "DST-I e1 k2 = +sqrt2/2");
assert(f64_approx_eq(load64(nd2 + 24), 0, EPSILON_F64), "DST-I e1 k3 = sin(PI) = 0");
assert(f64_approx_eq(load64(nd2 + 32), 0xBFE6A09E667F3BCC, EPSILON_F64), "DST-I e1 k4 = -sqrt2/2");
assert(f64_approx_eq(load64(nd2 + 40), f64_neg(F64_ONE), EPSILON_F64), "DST-I e1 k5 = -1");
assert(f64_approx_eq(load64(nd2 + 48), 0xBFE6A09E667F3BCC, EPSILON_F64), "DST-I e1 k6 = -sqrt2/2");
assert_eq(num_dst(ne_x, 0), HSB_ERR_INVALID_INPUT, "num_dst(n=0) -> INVALID_INPUT");
# DCT-II: X[0] of a constant signal c is n*c.
var ne_c = alloc(4 * 8);
ne_i = 0;
while (ne_i < 4) {
    store64(ne_c + ne_i * 8, F64_TWO);
    ne_i = ne_i + 1;
}
assert_eq(num_dct(ne_c, 4), HSB_ERR_NONE, "num_dct returns HSB_ERR_NONE");
assert(f64_approx_eq(load64(ne_c), f64_from(8), LOOSE_TOL_M), "DCT-II X[0] of const 2 over n=4 is 8");

# Mobius: mu(1)=1, mu(2)=-1, mu(4)=0 (square factor), mu(6)=1 (two primes)
assert_eq(num_mobius(1), 1, "mobius(1)=1");
assert_eq(num_mobius(2), 0 - 1, "mobius(2)=-1");
assert_eq(num_mobius(4), 0, "mobius(4)=0 (square factor)");
assert_eq(num_mobius(6), 1, "mobius(6)=1");

# Tridiagonal solve: identity system returns the RHS unchanged.
var ne_a = alloc(3 * 8);
var ne_b = alloc(3 * 8);
var ne_cc = alloc(3 * 8);
var ne_d = alloc(3 * 8);
var ne_out = alloc(3 * 8);
ne_i = 0;
while (ne_i < 3) {
    store64(ne_a + ne_i * 8, 0);
    store64(ne_b + ne_i * 8, F64_ONE);
    store64(ne_cc + ne_i * 8, 0);
    store64(ne_d + ne_i * 8, f64_from(ne_i + 1));
    ne_i = ne_i + 1;
}
assert_eq(num_tridiag_solve(ne_a, ne_b, ne_cc, ne_d, 3, ne_out), HSB_ERR_NONE,
"num_tridiag_solve returns HSB_ERR_NONE");
assert_eq(f64_to(load64(ne_out)), 1, "tridiag identity x[0]=1");
assert_eq(f64_to(load64(ne_out + 16)), 3, "tridiag identity x[2]=3");

test_group("symbolic_ext: integration, LaTeX, pattern matching");
# d/dx of the integral must recover the integrand (up to simplification):
# integral of x is x^2/2, whose derivative evaluated at x=3 is 3.
var se_x = expr_var(str_from("x"));
var se_int = sym_integrate(se_x, str_from("x"));
assert_neq(se_int, 0, "sym_integrate(x, x) returns an expression");
var se_d = expr_simplify(expr_diff(se_int, str_from("x")));
var se_binds = vec_new();
vec_push(se_binds, expr_bind(str_from("x"), f64_from(3)));
assert(f64_approx_eq(expr_eval(se_d, se_binds), f64_from(3), LOOSE_TOL_M),
"d/dx(integral of x) evaluates to x at x=3");
# integral of a constant c is c*x -> at x=4 with c=5 gives 20
var se_ic = sym_integrate(expr_const(f64_from(5)), str_from("x"));
var se_b2 = vec_new();
vec_push(se_b2, expr_bind(str_from("x"), f64_from(4)));
assert(f64_approx_eq(expr_eval(se_ic, se_b2), f64_from(20), LOOSE_TOL_M),
"integral of const 5 evaluates to 5x = 20 at x=4");
# LaTeX rendering. != 0 plus len > 0 passes for ANY non-empty output --
# including one that drops every \\left(...\\right) group. Pin the strings.
# Integral-valued constants render as bare integers (_latex_fmt_const), a
# convention already pinned by the carry test at the end of this file.
var se_tex = sym_to_latex(expr_add(se_x, expr_const(F64_ONE)));
assert_neq(se_tex, 0, "sym_to_latex returns a Str");
assert(str_len(se_tex) > 0, "sym_to_latex output is non-empty");
assert_eq(str_eq_cstr(se_tex, "x + 1"), 1, "latex: x + 1");
assert_eq(str_eq_cstr(sym_to_latex(expr_add(se_x, expr_neg(expr_const(F64_TWO)))), "x - 2"), 1,
"latex: a + neg(b) folds to a - b");
assert_eq(str_eq_cstr(sym_to_latex(expr_mul(expr_const(F64_TWO), expr_const(f64_from(3)))),
"2 \\cdot 3"), 1, "latex: number*number needs \\cdot");
assert_eq(str_eq_cstr(sym_to_latex(expr_mul(expr_const(F64_TWO),
expr_add(se_x, expr_const(F64_ONE)))), "2 \\left(x + 1\\right)"), 1,
"latex: juxtaposition + parenthesized sum");
assert_eq(str_eq_cstr(sym_to_latex(expr_pow(se_x, expr_const(f64_neg(F64_ONE)))),
"\\frac{1}{x}"), 1, "latex: x^(-1) -> \\frac{1}{x}");
assert_eq(str_eq_cstr(sym_to_latex(expr_pow(se_x, expr_const(F64_HALF))), "\\sqrt{x}"), 1,
"latex: x^(1/2) -> \\sqrt{x}");
assert_eq(str_eq_cstr(sym_to_latex(expr_const(f64_neg(F64_TWO))), "{-2}"), 1,
"latex: bare negative constant is braced");
assert_eq(str_eq_cstr(sym_to_latex(expr_var(str_from("theta"))), "\\mathrm{theta}"), 1,
"latex: multi-char identifier gets \\mathrm");
assert_eq(str_eq_cstr(sym_to_latex(expr_add(expr_mul(expr_const(f64_from(3)),
expr_pow(se_x, expr_const(F64_TWO))), expr_neg(expr_sin(se_x)))),
"3 x^{2} - \\sin\\left(x\\right)"), 1, "latex: 3x^2 - sin(x)");
# GAP: every assertion above renders MUL and NEG only in paren==0 position, so
# the MUL \left(...\right) guard and the whole EXPR_NEG branch are unreached.
# if (paren == 1) -> if (paren == 9) in the MUL arm, "-" -> "+" in the NEG
# arm, and dropping the paren=1 argument on either child all survive otherwise.
var se_y = expr_var(str_from("y"));
var se_z = expr_var(str_from("z"));
assert_eq(str_eq_cstr(sym_to_latex(expr_mul(se_x, expr_mul(se_y, se_z))),
"x \\left(y z\\right)"), 1, "latex: a MUL operand of a MUL is parenthesized");
assert_eq(str_eq_cstr(sym_to_latex(expr_mul(expr_neg(se_x), se_y)), "-x y"), 1,
"latex: the EXPR_NEG arm itself emits a minus");
assert_eq(str_eq_cstr(sym_to_latex(expr_mul(expr_neg(expr_add(se_x, se_y)), se_z)),
"-\\left(x + y\\right) z"), 1, "latex: NEG of a sum keeps its parens");
assert_eq(str_eq_cstr(sym_to_latex(expr_add(se_x, expr_neg(expr_add(se_y, se_z)))),
"x - \\left(y + z\\right)"), 1, "latex: a - (b + c), not the wrong a - b + c");
# Pattern matching. sym_match takes a PATTERN (PAT_* tag space, built with
# pat_*), not an Expr — passing an Expr silently returns 0, which is why the
# first version of this test failed.
assert_eq(sym_match(pat_wildcard(str_from("a")), expr_const(F64_TWO)), 1,
"sym_match: wildcard matches a constant");
assert_eq(sym_match(pat_wildcard(str_from("a")), expr_var(str_from("x"))), 1,
"sym_match: wildcard matches a variable");
assert_eq(sym_match(pat_any_const(str_from("c")), expr_const(F64_TWO)), 1,
"sym_match: any_const matches a constant");
assert_eq(sym_match(pat_any_const(str_from("c")), expr_var(str_from("x"))), 0,
"sym_match: any_const does NOT match a variable");
# Structural: pattern a + b against x + 1
assert_eq(sym_match(pat_add(pat_wildcard(str_from("a")), pat_wildcard(str_from("b"))),
expr_add(se_x, expr_const(F64_ONE))), 1,
"sym_match: (a + b) matches (x + 1)");
assert_eq(sym_match(pat_mul(pat_wildcard(str_from("a")), pat_wildcard(str_from("b"))),
expr_add(se_x, expr_const(F64_ONE))), 0,
"sym_match: (a * b) does NOT match (x + 1)");
# Bindings are returned on a successful match
assert_neq(sym_match_bindings(pat_wildcard(str_from("a")), expr_const(F64_TWO)), 0,
"sym_match_bindings returns bindings on match");

test_group("collision_core: hull pre-sort is a correct O(n log n) sort");

var hs_n = 2000;
var hs_pts = vec_new();
var hs_i = 0;
while (hs_i < hs_n) {
    vec_push(hs_pts, hvec2_new(f64_from((hs_i * 2654435761) % 10007),
    f64_from((hs_i * 40503) % 10009)));
    hs_i = hs_i + 1;
}
var hs_idx = vec_new();
hs_i = 0;
while (hs_i < hs_n) {
    vec_push(hs_idx, hs_i);
    hs_i = hs_i + 1;
}
_col_sort_indices_by_xy(hs_idx, hs_pts, hs_n);
# Zero inversions under the module's own order predicate.
var hs_inv = 0;
hs_i = 1;
while (hs_i < hs_n) {
    if (_col_xy_greater(hs_pts, vec_get(hs_idx, hs_i - 1), vec_get(hs_idx, hs_i)) == 1) {
        hs_inv = hs_inv + 1;
    }
    hs_i = hs_i + 1;
}
assert_eq(hs_inv, 0, "hull pre-sort: zero inversions over 2000 points");
# ...and a permutation: heapsort must not invent or drop elements.
var hs_seen = alloc(hs_n * 8);
hs_i = 0;
while (hs_i < hs_n) {
    store64(hs_seen + hs_i * 8, 0);
    hs_i = hs_i + 1;
}
hs_i = 0;
while (hs_i < hs_n) {
    var hv = vec_get(hs_idx, hs_i);
    store64(hs_seen + hv * 8, load64(hs_seen + hv * 8) + 1);
    hs_i = hs_i + 1;
}
var hs_bad = 0;
hs_i = 0;
while (hs_i < hs_n) {
    if (load64(hs_seen + hs_i * 8) != 1) { hs_bad = hs_bad + 1; }
    hs_i = hs_i + 1;
}
assert_eq(hs_bad, 0, "hull pre-sort: result is a permutation (multiset preserved)");
# The hull itself is unchanged by the rewrite (fingerprint pinned against the
# pre-2.6.15 insertion sort, which produced byte-identical output).
var hs_hull = convex_hull_2d(hs_pts, hs_n);
assert_eq(vec_len(hs_hull), 17, "convex_hull_2d(2000 scattered) has 17 vertices");

test_group("collision_mesh: half-edge twin pairing invariants");
# 33x33 grid -> 2048 triangles, 6144 half-edges, 4*(33-1) = 128 boundary edges.
var hm_w = 33;
var hm_tris = vec_new();
var hm_gy = 0;
while (hm_gy < hm_w - 1) {
    var hm_gx = 0;
    while (hm_gx < hm_w - 1) {
        var hm_v = hm_gy * hm_w + hm_gx;
        vec_push(hm_tris, hm_v);
        vec_push(hm_tris, hm_v + 1);
        vec_push(hm_tris, hm_v + hm_w + 1);
        vec_push(hm_tris, hm_v);
        vec_push(hm_tris, hm_v + hm_w + 1);
        vec_push(hm_tris, hm_v + hm_w);
        hm_gx = hm_gx + 1;
    }
    hm_gy = hm_gy + 1;
}
var hm_ntris = vec_len(hm_tris) / 3;
var hm_mesh = halfedge_from_triangles(hm_tris, hm_ntris, hm_w * hm_w);
assert_neq(hm_mesh, 0, "halfedge_from_triangles(2048 tris) returns a mesh");
var hm_hes = HalfEdgeMesh_half_edges(hm_mesh);
assert_eq(vec_len(hm_hes), hm_ntris * 3, "half-edge count == 3 * n_tris");
var hm_paired = 0;
var hm_boundary = 0;
var hm_bad = 0;
var hm_i = 0;
while (hm_i < vec_len(hm_hes)) {
    var hm_tw = HalfEdge_twin(vec_get(hm_hes, hm_i));
    if (hm_tw == _COL_SENTINEL) {
        hm_boundary = hm_boundary + 1;
    } else {
        hm_paired = hm_paired + 1;
        if (hm_tw < 0 || hm_tw >= vec_len(hm_hes)) { hm_bad = hm_bad + 1; }
        else {
            if (HalfEdge_twin(vec_get(hm_hes, hm_tw)) != hm_i) { hm_bad = hm_bad + 1; }
        }
    }
    hm_i = hm_i + 1;
}
assert_eq(hm_bad, 0, "twin(twin(i)) == i for every paired half-edge");
assert_eq(hm_boundary, 4 * (hm_w - 1), "boundary half-edge count == 4*(W-1) = 128");
assert_eq(hm_paired + hm_boundary, vec_len(hm_hes), "every half-edge is paired or boundary");
assert_eq(hm_paired % 2, 0, "paired half-edges come in pairs");

test_group("calc_ext: B-spline / NURBS reject ill-formed degree");
# A degree-d B-spline needs at least d+1 control points. Only `n_pts != 0` and the
# knot-count relation were checked through 2.6.13, so degree >= n_pts fell through
# to de Boor with a NEGATIVE control-point index — an out-of-bounds read that
# dereferenced a wild pointer instead of returning the documented 0.
var ce_cps = alloc(3 * 24);
var ce_kn = alloc(7 * 8);
var ce_i = 0;
while (ce_i < 7) {
    store64(ce_kn + ce_i * 8, f64_from(ce_i));
    ce_i = ce_i + 1;
}
assert_eq(calc_bspline(3, ce_cps, 3, ce_kn, 7, f64_from(3)), 0,
"calc_bspline: n_pts <= degree -> 0 (no wild deref)");
assert_eq(calc_nurbs(3, ce_cps, ce_cps, 3, ce_kn, 7, f64_from(3)), 0,
"calc_nurbs: n_pts <= degree -> 0");
assert_eq(calc_bspline(0 - 1, ce_cps, 3, ce_kn, 3, F64_ONE), 0,
"calc_bspline: negative degree -> 0");

test_group("calc_ext / calc / noise_simplex: fBm normalisation is guarded");
# All four fBm entry points divided by an amplitude accumulator that is still
# exactly 0 when octaves <= 0, returning NaN from a function documenting a
# roughly [-1, 1] range — and NaN then propagated through every downstream sample.
var fb2 = fbm_2d(F64_ONE, F64_ONE, 0, F64_ONE, F64_ONE, F64_HALF);
assert_eq(f64_eq(fb2, fb2), 1, "fbm_2d(octaves=0) is not NaN");
assert_eq(f64_to(fb2), 0, "fbm_2d(octaves=0) == 0");
var fb3 = fbm_3d(F64_ONE, F64_ONE, F64_ONE, 0, F64_ONE, F64_ONE, F64_HALF);
assert_eq(f64_eq(fb3, fb3), 1, "fbm_3d(octaves=0) is not NaN");
var sf2 = simplex_fbm_2d(F64_ONE, F64_ONE, 0, F64_ONE, F64_ONE, F64_HALF);
assert_eq(f64_eq(sf2, sf2), 1, "simplex_fbm_2d(octaves=0) is not NaN");
var sf3 = simplex_fbm_3d(F64_ONE, F64_ONE, F64_ONE, 0, F64_ONE, F64_ONE, F64_HALF);
assert_eq(f64_eq(sf3, sf3), 1, "simplex_fbm_3d(octaves=0) is not NaN");
# and a real call is still finite and in range
var fb_ok = fbm_2d(F64_ONE, F64_TWO, 4, F64_ONE, F64_ONE, F64_HALF);
assert_eq(f64_eq(fb_ok, fb_ok), 1, "fbm_2d(octaves=4) is finite");
assert_eq(f64_le(f64_abs(fb_ok), F64_TWO), 1, "fbm_2d(octaves=4) is in a sane range");

test_group("spatial: kdtree_build survives coincident points");
# _kd_partition splits on the axis VALUE midpoint. That separates properly
# whenever lo < hi, so it can only degenerate when every point shares the axis
# value — where the old "one item per side" clamp peeled ONE element per level,
# giving O(n) recursion depth. Measured on the pre-fix code: fine at 40k,
# **SIGSEGV at 60k**. 60000 is the proven threshold and costs ~24 ms.
var kd_n = 60000;
var kd_pts = alloc(kd_n * 8);
var kd_i = 0;
while (kd_i < kd_n) {
    store64(kd_pts + kd_i * 8, hvec3_new(F64_ONE, F64_TWO, f64_from(3)));
    kd_i = kd_i + 1;
}
assert_neq(kdtree_build(kd_pts, kd_n), 0,
"kdtree_build(60000 coincident points) returns a tree (no stack overflow)");
# Pruning must still be correct once the positional fallback fires: build a tree
# that is half coincident, half spread, and demand an exact nearest-neighbour hit.
var kd_m = 4000;
var kd_p2 = alloc(kd_m * 8);
kd_i = 0;
while (kd_i < kd_m) {
    if (kd_i < kd_m / 2) { store64(kd_p2 + kd_i * 8, hvec3_new(0, 0, 0)); }
    else { store64(kd_p2 + kd_i * 8, hvec3_new(f64_from(kd_i), f64_from(kd_i), f64_from(kd_i))); }
    kd_i = kd_i + 1;
}
var kd_t2 = kdtree_build(kd_p2, kd_m);
assert_neq(kd_t2, 0, "kdtree_build(half-coincident) returns a tree");
var kd_tv = f64_from(kd_m - 1);
assert_eq(kdtree_nearest(kd_t2, kd_p2, hvec3_new(kd_tv, kd_tv, kd_tv)), kd_m - 1,
"kdtree_nearest still finds the exact point (pruning correct)");

test_group("einsum: malformed notation must error, not mis-compute");
assert_eq(einsum(str_from("i9,jk->ik"), es_two, 2), 0, "einsum: digit in spec -> 0");
assert_eq(einsum(str_from("IJ,JK->IK"), es_two, 2), 0, "einsum: uppercase -> 0");
assert_eq(einsum(str_from("ijklm,jk->ik"), es_two, 2), 0, "einsum: rank > MAX_RANK -> 0");
assert_eq(einsum(str_from("ijk,jk->ik"), es_two, 2), 0, "einsum: rank != tensor rank -> 0");
assert_eq(einsum(str_from("ij,jk"), es_two, 2), 0, "einsum: missing -> separator -> 0");

# ================================================================
# 2.7.0-A -- the six 2026-08-03 findings that the 2.6.12-2.6.15 arc
# missed. Every assertion below FAILS against the pre-2.7.0 source.
# ================================================================

test_group("f64_fmod: truncated, not floored (sign of the DIVIDEND)");

# The whole point of the fix. floor() gives the sign of the divisor, trunc()
# gives the sign of the dividend, and only the latter is fmod.
assert_eq(f64_to(f64_fmod(f64_neg(f64_from(7)), f64_from(3))), (0 - 1),
"fmod(-7, 3) = -1 (floor form gave +2)");
assert_eq(f64_to(f64_fmod(f64_from(7), f64_neg(f64_from(3)))), 1,
"fmod(7, -3) = +1 (floor form gave -2)");
assert_eq(f64_to(f64_fmod(f64_from(7), f64_from(3))), 1, "fmod(7, 3) = 1");
assert_eq(f64_to(f64_fmod(f64_neg(f64_from(7)), f64_neg(f64_from(3)))), (0 - 1),
"fmod(-7, -3) = -1");

# Non-integer quotient: -5.5 mod 2 is -1.5 truncated, +0.5 floored.
var fm_a = f64_neg(f64_div(f64_from(11), f64_from(2)));
var fm_r = f64_fmod(fm_a, f64_from(2));
assert_eq(fm_r, f64_neg(f64_div(f64_from(3), f64_from(2))), "fmod(-5.5, 2) = -1.5");

# Contract: y == 0 returns 0.
assert_eq(f64_fmod(f64_from(7), 0), 0, "fmod(x, 0) = 0");

test_group("f64_copysign: the SIGN BIT of y, not an ordered comparison");

var cs_neg_zero = 0x8000_0000_0000_0000;

# -0.0 is EQUAL to +0.0, so the old `f64_lt(y, 0)` test could not see it.
assert_eq(f64_copysign(f64_from(3), cs_neg_zero), f64_neg(f64_from(3)),
"copysign(3, -0.0) = -3 (ordered form gave +3)");
# ... and the old form could never PRODUCE -0.0 either.
assert_eq(f64_copysign(0, f64_neg(F64_ONE)), cs_neg_zero,
"copysign(0, -1) = -0.0 (ordered form gave +0.0)");
assert_eq(f64_copysign(f64_from(3), f64_from(2)), f64_from(3), "copysign(3, 2) = 3");
assert_eq(f64_copysign(f64_neg(f64_from(5)), f64_from(2)), f64_from(5), "copysign(-5, 2) = 5");
assert_eq(f64_copysign(f64_neg(f64_from(5)), f64_neg(F64_ONE)), f64_neg(f64_from(5)),
"copysign(-5, -1) = -5");
assert_eq(f64_copysign(f64_from(3), 0), f64_from(3), "copysign(3, +0.0) = +3");

test_group("geo_ray_capsule: ray parallel to the capsule axis");

# a == dot(d_perp, d_perp) is exactly 0 here, so disc is exactly +0.0 -- which
# is NOT < 0, so the pre-2.7.0 code took the quadratic branch and evaluated
# 0.5/0 = +Inf, returning NaN.
var rc_cap = geo_capsule_new(hvec3_zero(), hvec3_new(0, 0, f64_from(4)), F64_ONE);
var rc_par = geo_ray_new(hvec3_new(0, 0, f64_neg(f64_from(10))), hvec3_unit_z());
var rc_t = geo_ray_capsule(rc_par, rc_cap);
assert_eq(f64_to(rc_t), 9, "parallel ray hits the start cap at t = 9");
# A NaN return would satisfy neither of these (both comparisons are unordered).
assert_eq(f64_gt(rc_t, 0), 1, "parallel-ray hit is a real ordered number (not NaN)");

# Parallel and 5 units off a radius-1 axis: a genuine miss, contract says 0.
var rc_miss = geo_ray_new(hvec3_new(f64_from(5), 0, f64_neg(f64_from(10))), hvec3_unit_z());
assert_eq(geo_ray_capsule(rc_miss, rc_cap), 0, "parallel ray outside the radius misses -> 0");

# Parallel, aimed the other way: the capsule is entirely behind the ray.
var rc_away = geo_ray_new(hvec3_new(0, 0, f64_neg(f64_from(10))),
hvec3_new(0, 0, f64_neg(F64_ONE)));
assert_eq(geo_ray_capsule(rc_away, rc_cap), 0, "parallel ray pointing away misses -> 0");

test_group("lorentz_is_valid: tolerance relative to the matrix, not absolute");

# lorentz_boost_x takes RAPIDITY. cosh(10) is 11013, so the entries of
# Lambda^T eta Lambda are O(1.2e8) and one ulp there is 1.5e-8 -- ten thousand
# times the fixed 1e-12 the pre-2.7.0 code demanded. A perfectly valid boost
# was rejected.
assert_eq(lorentz_is_valid(lorentz_boost_x(f64_from(10))), 1, "boost rapidity 10 is valid");
assert_eq(lorentz_is_valid(lorentz_boost_y(f64_from(10))), 1, "boost_y rapidity 10 is valid");
assert_eq(lorentz_is_valid(lorentz_boost_z(f64_from(8))), 1, "boost_z rapidity 8 is valid");
assert_eq(lorentz_is_valid(lorentz_identity()), 1, "identity is valid");
assert_eq(lorentz_is_valid(lorentz_boost_x(F64_ONE)), 1, "boost rapidity 1 is valid");

# The relaxation must not make the predicate vacuous: a non-Lorentzian matrix
# is still rejected, because its defect is O(scale^2), not O(1e-12).
var lv_bad = m4_identity();
m4_set(lv_bad, 0, 0, f64_from(2));
assert_eq(lorentz_is_valid(lv_bad), 0, "diag(2,1,1,1) is NOT a Lorentz transform");
var lv_bad2 = lorentz_boost_x(f64_from(10));
m4_set(lv_bad2, 2, 2, f64_from(3));
assert_eq(lorentz_is_valid(lv_bad2), 0, "perturbed boost is still rejected");

test_group("cmat_exp: the scaling loop terminates on a non-finite norm");

# Halving never brings +Inf below 1, so the pre-2.7.0 loop spun forever. That
# this suite reaches the next line at all is the assertion.
var ce_inf = cmat_new(2, 2);
cmat_set(ce_inf, 0, 0, cx_real(_GEO_F64_POS_INF));
cmat_set(ce_inf, 1, 1, cx_one());
assert_neq(cmat_exp(ce_inf), 0, "cmat_exp(+Inf entry) returns instead of hanging");

# And the ordinary path still works: exp(0) = I.
var ce_zero = cmat_new(2, 2);
var ce_i = cmat_exp(ce_zero);
assert_eq(f64_to(HComplex_re(cmat_get(ce_i, 0, 0))), 1, "exp(0 matrix) diagonal = 1");
assert_eq(f64_to(HComplex_re(cmat_get(ce_i, 0, 1))), 0, "exp(0 matrix) off-diagonal = 0");
assert_eq(f64_to(HComplex_re(cmat_get(ce_i, 1, 1))), 1, "exp(0 matrix) diagonal = 1 (1,1)");

# ================================================================
# 2.7.0-B -- the three high findings from the 2026-08-04 re-audit.
# geo_advanced.cyr is the largest module (1,261 lines) and had ZERO
# coverage on GJK / EPA / BVH / TOI before this block.
# ================================================================

test_group("cmat_mul: conformability, not an out-of-bounds read");

# 2x3 times 2x2 is undefined. The inner loop ran k over cols(a) = 3 while b's
# buffer holds only rows(b)*cols(b) = 4 elements, so k = 2 read past it.
var cm_2x3 = cmat_new(2, 3);
var cm_2x2 = cmat_new(2, 2);
var cm_3x2 = cmat_new(3, 2);
assert_eq(cmat_mul(cm_2x3, cm_2x2), 0, "2x3 * 2x2 is non-conformable -> 0");
assert_neq(cmat_mul(cm_2x3, cm_3x2), 0, "2x3 * 3x2 IS conformable -> matrix");
assert_eq(cmat_rows(cmat_mul(cm_2x3, cm_3x2)), 2, "conformable product has 2 rows");
assert_eq(cmat_cols(cmat_mul(cm_2x3, cm_3x2)), 2, "conformable product has 2 cols");
assert_eq(cmat_mul(0, cm_2x2), 0, "cmat_mul(null, m) -> 0, not a null deref");
assert_eq(cmat_mul(cm_2x2, 0), 0, "cmat_mul(m, null) -> 0, not a null deref");

# The designed 0 must survive being fed onward instead of being dereferenced.
assert_eq(cmat_add(0, cm_2x2), 0, "cmat_add(null, m) -> 0");
assert_eq(cmat_sub(cm_2x2, 0), 0, "cmat_sub(m, null) -> 0");
assert_eq(cmat_add(cm_2x3, cm_2x2), 0, "cmat_add on mismatched shapes -> 0");
assert_eq(cmat_scale(0, cx_one()), 0, "cmat_scale(null) -> 0");
assert_eq(cmat_adjoint(0), 0, "cmat_adjoint(null) -> 0");
assert_eq(cmat_trace(0), 0, "cmat_trace(null) -> 0");
# cmat_commutator feeds cmat_mul's result straight into cmat_sub.
assert_eq(cmat_commutator(cm_2x3, cm_2x2), 0, "commutator of non-conformable -> 0");
assert_neq(cmat_commutator(cm_2x2, cm_2x2), 0, "commutator of conformable -> matrix");

test_group("bvh_build: coincident AABBs must not recurse O(n) deep");

# Every center is identical, so every center IS the split midpoint and
# `cv < mid_val` is false for all of them -- the partition never advances. The
# pre-2.7.0 clamp then forced a 1-vs-(n-1) split, giving recursion depth n and a
# quadratic build. These assertions cover the RESULT; the cost regression is
# guarded by the `bvh_degenerate_20k` benchmark, since 130x slower is a timing
# fact, not something an assert_eq can state.
var bv_n = 20000;
var bv_arr = alloc(bv_n * 8);
var bv_pt = hvec3_new(F64_ONE, F64_ONE, F64_ONE);
var bv_box = geo_aabb_new(bv_pt, hvec3_new(F64_TWO, F64_TWO, F64_TWO));
var bv_i = 0;
while (bv_i < bv_n) {
    store64(bv_arr + bv_i * 8, bv_box);
    bv_i = bv_i + 1;
}
var bv_tree = bvh_build(bv_arr, bv_n);
assert_neq(bv_tree, 0, "bvh_build(20k coincident AABBs) returns a tree");

# Depth is not the only thing that has to survive: the tree must still answer.
var bv_hits = bvh_query_aabb(bv_tree, bv_box);
assert_eq(vec_len(bv_hits), bv_n, "every coincident box is still reported");
var bv_none = geo_aabb_new(hvec3_new(f64_from(100), f64_from(100), f64_from(100)),
hvec3_new(f64_from(101), f64_from(101), f64_from(101)));
assert_eq(vec_len(bvh_query_aabb(bv_tree, bv_none)), 0, "disjoint query returns nothing");

# A well-separated set must keep working -- the median fallback only fires on the
# degenerate branch and must not disturb the normal partition.
var bv_m = 64;
var bv_sep = alloc(bv_m * 8);
var bv_j = 0;
while (bv_j < bv_m) {
    var bv_x = f64_from(bv_j * 10);
    store64(bv_sep + bv_j * 8,
    geo_aabb_new(hvec3_new(bv_x, 0, 0),
    hvec3_new(f64_add(bv_x, F64_ONE), F64_ONE, F64_ONE)));
    bv_j = bv_j + 1;
}
var bv_tree2 = bvh_build(bv_sep, bv_m);
assert_neq(bv_tree2, 0, "bvh_build(separated) returns a tree");
var bv_q = geo_aabb_new(hvec3_new(f64_from(30), 0, 0),
hvec3_new(f64_from(31), F64_ONE, F64_ONE));
assert_eq(vec_len(bvh_query_aabb(bv_tree2, bv_q)), 1, "separated query finds exactly its box");

test_group("time_of_impact: the horizon is max_t, not 0.64 units");

# A needs B to travel 3 units before they touch (centres 5 apart, radii 1+1).
# The pre-2.7.0 loop advanced GJK_MAX_ITER * 0.01 = 0.64 units total and then
# returned 0 -- a false negative from a collision query, with max_t ignored.
var toi_a = hvec4_new(0, 0, 0, F64_ONE);
var toi_b = hvec4_new(f64_from(5), 0, 0, F64_ONE);
var toi_still = hvec3_zero();
var toi_left = hvec3_new(f64_neg(F64_ONE), 0, 0);
var toi_t = alloc(8);
var toi_n = alloc(8);

var toi_hit = time_of_impact(&_mpr_sup_sphere, toi_a, toi_still,
&_mpr_sup_sphere, toi_b, toi_left, f64_from(10), toi_t, toi_n);
assert_eq(toi_hit, 1, "collision 3 units out IS found within max_t = 10");
assert_eq(f64_gt(load64(toi_t), F64_TWO), 1, "impact time is past t = 2");
assert_eq(f64_lt(load64(toi_t), f64_from(4)), 1, "impact time is before t = 4");

# max_t must still be honoured as a genuine bound in the other direction.
assert_eq(time_of_impact(&_mpr_sup_sphere, toi_a, toi_still,
&_mpr_sup_sphere, toi_b, toi_left, F64_ONE, toi_t, toi_n), 0,
"same approach with max_t = 1 is out of range -> 0");

# Receding: never collides no matter how long the horizon.
var toi_right = hvec3_new(F64_ONE, 0, 0);
assert_eq(time_of_impact(&_mpr_sup_sphere, toi_a, toi_still,
&_mpr_sup_sphere, toi_b, toi_right, f64_from(100), toi_t, toi_n), 0,
"receding spheres never collide");

# Zero relative velocity and already apart -> no collision.
assert_eq(time_of_impact(&_mpr_sup_sphere, toi_a, toi_still,
&_mpr_sup_sphere, toi_b, toi_still, f64_from(10), toi_t, toi_n), 0,
"stationary and disjoint -> 0");

# Already overlapping at t = 0 -> immediate hit.
var toi_over = hvec4_new(F64_ONE, 0, 0, F64_ONE);
assert_eq(time_of_impact(&_mpr_sup_sphere, toi_a, toi_still,
&_mpr_sup_sphere, toi_over, toi_left, f64_from(10), toi_t, toi_n), 1,
"already overlapping -> hit");
assert_eq(load64(toi_t), 0, "overlap at t = 0 reports t = 0");

# ================================================================
# 2.7.0-C -- medium correctness & safety findings.
# Every fix below was independently verified AND adversarially
# challenged against the real source before it was applied.
# ================================================================

test_group("detect_islands: negative body indices must be rejected, not subscripted");

# Only the UPPER bound was checked through 2.6.15, so a negative index sailed
# through and _col_uf_find subscripted parent[] BEFORE the array.
var isl_a_c = contact_new(0 - 3, 1, hvec3_unit_y(), F64_HALF, F64_HALF, F64_HALF, F64_ONE, F64_ONE);
var isl_a_v = vec_new();
vec_push(isl_a_v, isl_a_c);
var isl_a = detect_islands(isl_a_v, 1, 4);
assert_eq(vec_len(isl_a), 4, "detect_islands: neg body_a is skipped -> 4 singletons");
# Pins the CORRUPTION, not just the count: pre-fix, island 0 was [0, 1] -- two
# unrelated bodies fused because the OOB read of parent[-3] returned root 0.
assert_eq(vec_len(vec_get(isl_a, 0)), 1, "detect_islands: neg body_a must not merge body 0");

# Second operand independently -- a fix guarding only `ba` would still fail this.
var isl_b_c = contact_new(1, 0 - 3, hvec3_unit_y(), F64_HALF, F64_HALF, F64_HALF, F64_ONE, F64_ONE);
var isl_b_v = vec_new();
vec_push(isl_b_v, isl_b_c);
assert_eq(vec_len(detect_islands(isl_b_v, 1, 4)), 4, "detect_islands: neg body_b is skipped -> 4 singletons");

# The memory-safety half. Pre-fix this SIGSEGVs (exit 139) and the suite prints
# nothing past the group header -- the count assertions above cannot reach it,
# because small-magnitude aliasing happens to stay inside the heap.
var isl_c_c = contact_new(0 - 1000000, 1, hvec3_unit_y(), F64_HALF, F64_HALF, F64_HALF, F64_ONE, F64_ONE);
var isl_c_v = vec_new();
vec_push(isl_c_v, isl_c_c);
assert_eq(vec_len(detect_islands(isl_c_v, 1, 4)), 4, "detect_islands: large neg index must not fault");

test_group("num_ifft: an error return must not leave the caller's buffer conjugated");

# n = 3 is not a power of 2. Through 2.6.15 the conjugate pass ran FIRST, so the
# rejection came back with every imaginary part already negated.
var ift_d = alloc(48);
store64(ift_d + 0,  f64_from(1));  store64(ift_d + 8,  f64_from(2));
store64(ift_d + 16, f64_from(3));  store64(ift_d + 24, f64_from(4));
store64(ift_d + 32, f64_from(5));  store64(ift_d + 40, f64_from(6));
assert_eq(num_ifft(ift_d, 3), HSB_ERR_INVALID_INPUT, "n=3 rejected (rc is -10 either way)");
assert_eq(f64_to(load64(ift_d + 8)),  2, "ifft error leaves im[0] intact");
assert_eq(f64_to(load64(ift_d + 24)), 4, "ifft error leaves im[1] intact");
assert_eq(f64_to(load64(ift_d + 40)), 6, "ifft error leaves im[2] intact");
# Deliberate control: passes BOTH ways. It proves the corruption was confined to
# the imaginary lane -- i.e. silent, not obviously garbage.
assert_eq(f64_to(load64(ift_d + 0)), 1, "re[0] intact (control -- passes both ways)");
# One aggregate that flips sign: +12 correct, -12 corrupted.
var ift_s = f64_add(f64_add(load64(ift_d + 8), load64(ift_d + 24)), load64(ift_d + 40));
assert_eq(f64_to(ift_s), 12, "sum(im) still +12 after a failed ifft");

# The success path must be untouched: n = 4 round-trips.
var ift_r = alloc(64);
store64(ift_r + 0,  f64_from(1));  store64(ift_r + 8,  0);
store64(ift_r + 16, f64_from(2));  store64(ift_r + 24, 0);
store64(ift_r + 32, f64_from(3));  store64(ift_r + 40, 0);
store64(ift_r + 48, f64_from(4));  store64(ift_r + 56, 0);
assert_eq(num_fft(ift_r, 4), HSB_ERR_NONE, "fft n=4 ok");
assert_eq(num_ifft(ift_r, 4), HSB_ERR_NONE, "ifft n=4 ok");
assert_eq(f64_to(load64(ift_r + 0)), 1, "round-trip re[0] = 1");
assert_eq(f64_to(load64(ift_r + 48)), 4, "round-trip re[3] = 4");

test_group("levi_civita: f64 bit patterns, not raw i64");

# Raw (0 - 1) is 0xFFFF_FFFF_FFFF_FFFF -- a NEGATIVE NaN. These four catch the
# ENCODING (pre-fix, f64_to of the raw 1 subnormal truncates to 0)...
assert_eq(f64_to(levi_civita_3(0, 1, 2)), 1, "eps 012 = +1.0 as f64");
assert_eq(f64_to(levi_civita_4(0, 1, 2, 3)), 1, "eps4 0123 = +1.0 as f64");
# ...and these two catch the SIGN. They are not redundant: a mutant with the
# correct f64 encoding but f64_neg dropped passes every encoding assertion above.
assert_eq(f64_to(levi_civita_3(1, 0, 2)), (0 - 1), "eps 102 = -1.0 (pins the sign)");
assert_eq(f64_to(levi_civita_4(1, 0, 2, 3)), (0 - 1), "eps4 1023 = -1.0 (pins the sign)");

# NaN is unordered, so it fails BOTH directions of an ordered comparison -- the
# cleanest statement that the odd branch is a real number at all.
assert_eq(f64_lt(levi_civita_3(1, 0, 2), 0), 1, "eps 102 is an ordered negative, not NaN");
assert_eq(f64_gt(levi_civita_3(0, 1, 2), 0), 1, "eps 012 is an ordered positive");

# The downstream consequence: NaN * 0.0 is NaN, so a raw -1 poisoned even the
# components a contraction should leave at exactly zero.
var lc_prod = f64_mul(levi_civita_3(1, 0, 2), 0);
assert_eq(f64_eq(lc_prod, 0), 1, "eps 102 * 0.0 == 0.0 (was NaN)");
assert_eq(f64_to(levi_civita_3(0, 0, 1)), 0, "eps repeated = 0.0");

test_group("diffgeo: the documented 0 must not be dereferenced, and dims are capped");

# christoffel_symbols and riemann_tensor have capped at 16 and returned 0 since
# they were written. The downstream contractions did neither -- they dereferenced
# that 0 AND sized their own alloc from an unbounded dim (CWE-190 -> CWE-476).
var dg_ch_big = christoffel_symbols(0, 0, 100);
assert_eq(dg_ch_big, 0, "christoffel_symbols over the cap still returns 0");
assert_eq(ricci_tensor(dg_ch_big, 100), 0, "ricci_tensor(0, over-cap) -> 0, not a null store");
assert_eq(ricci_tensor(0, 4), 0, "ricci_tensor(null riemann) -> 0");
assert_eq(einstein_tensor(0, 0, 0, 4), 0, "einstein_tensor(null) -> 0");
assert_eq(weyl_tensor(0, 0, 0, 0, 4), 0, "weyl_tensor(null) -> 0");
assert_eq(geodesic_state_new(0, 0, 4), 0, "geodesic_state_new(null) -> 0");
assert_eq(geodesic_rk4(0, 0, 4, F64_HALF, 1), 0, "geodesic_rk4(null) -> 0");
assert_eq(parallel_transport(0, 0, 0, 4, F64_HALF, 1), 0, "parallel_transport(null) -> 0");
assert_eq(killing_residual(0, 0, 0, 4), 0, "killing_residual(null) -> 0");

# The dimension cap itself, on each entry point that previously had none.
assert_eq(ricci_tensor(0, 100000), 0, "ricci_tensor over the dim cap -> 0");
assert_eq(geodesic_state_new(0, 0, 100000), 0, "geodesic_state_new over the dim cap -> 0");

# wedge_1_1 was NOT in the original finding. dim = 100000 asks for 40 GB, so
# alloc returns 0 and the store wrote to address 0 -- measured exit 139.
var dg_a = alloc(32);
var dg_b = alloc(32);
assert_eq(wedge_1_1(dg_a, dg_b, 100000), 0, "wedge_1_1 over the dim cap -> 0, not a null store");
assert_eq(wedge_1_1(0, dg_b, 4), 0, "wedge_1_1(null alpha) -> 0");

# The valid path must be untouched: a real 2-sphere still contracts correctly.
assert_neq(wedge_1_1(dg_a, dg_b, 4), 0, "wedge_1_1 at dim 4 still returns a form");

test_group("symbolic render: the rounding carry must reach the integer part");

# stdlib fmt_float_buf zero-pads only when pad > 0. A fraction that rounds UP to
# exactly 10^decimals needs decimals+1 digits, so pad goes negative, the pad
# branch is skipped, and the overflowed digit lands AFTER the '.' with nothing
# carrying into the whole part.
var fc_a = f64_div(f64_from(9999999), f64_from(10000000));   # 0.9999999
var fc_sa = expr_to_str(expr_const(fc_a));
assert_eq(str_eq_cstr(fc_sa, "1.000000"), 1, "carry: 0.9999999 renders 1.000000, not 0.1000000");
assert_eq(str_len(fc_sa), 8, "carry: rounded-up render is 6 fraction digits, not 7");

var fc_b = f64_div(f64_from(29999999), f64_from(10000000));   # 2.9999999
assert_eq(str_eq_cstr(expr_to_str(expr_const(fc_b)), "3.000000"), 1,
"carry: 2.9999999 renders 3.000000, not 2.1000000");

var fc_c = f64_neg(f64_div(f64_from(9999999), f64_from(10000000)));   # -0.9999999
assert_eq(str_eq_cstr(expr_to_str(expr_const(fc_c)), "-1.000000"), 1,
"carry: negative values carry through the sign byte");

# The LaTeX path shares the helper -- this is the audit's exact value.
var fc_d = f64_div(f64_from(999999995), f64_from(1000000000));   # 0.999999995
assert_eq(str_eq_cstr(sym_to_latex(expr_const(fc_d)), "1.000000"), 1,
"carry: _latex_fmt_const shares the fix (audit's exact value)");

# Control: the fix must not perturb a value that does not carry.
var fc_e = f64_div(f64_from(1), f64_from(3));
assert_eq(str_eq_cstr(expr_to_str(expr_const(fc_e)), "0.333333"), 1,
"carry fix does not perturb non-carrying values");

test_group("kdtree: the split plane must actually separate the subtrees");

# `split_val` used to be read from items[split] -- SOME right-side value, not the
# partition plane. Every right-side point below that value then sat on the wrong
# side of its own node's pruning plane, so the query pruned subtrees that still
# held valid hits. Measured before the fix: 274 of 400 radius queries returned
# the WRONG COUNT. The suites at the time did not notice.
var KDV_N = 1500;
var kdv_pts = alloc(KDV_N * 8);
var kdv_i = 0;
while (kdv_i < KDV_N) {
    store64(kdv_pts + kdv_i * 8, hvec3_new(f64_from((kdv_i * 2654435761) % 1009),
    f64_from((kdv_i * 40503) % 1013), f64_from((kdv_i * 69069) % 1019)));
    kdv_i = kdv_i + 1;
}
var kdv_tree = kdtree_build(kdv_pts, KDV_N);
assert_neq(kdv_tree, 0, "kdtree_build(1500 scattered) returns a tree");

# The structural invariant, checked directly on every node.
assert_eq(_kdv_invariant_bad(kdv_tree, kdv_pts), 0,
"kdtree: no point sits on the wrong side of its ancestor's split plane");

# And the behaviour that invariant exists to protect, against brute force.
var kdv_bad = 0;
var kdv_q = 0;
while (kdv_q < 200) {
    var kdv_qp = hvec3_new(f64_from((kdv_q * 7919) % 1009), f64_from((kdv_q * 104729) % 1013),
    f64_from((kdv_q * 1299709) % 1019));
    if (vec_len(kdtree_within_radius(kdv_tree, kdv_pts, kdv_qp, f64_from(60)))
    != _kdv_brute(kdv_pts, KDV_N, kdv_qp, f64_from(60))) { kdv_bad = kdv_bad + 1; }
    kdv_q = kdv_q + 1;
}
assert_eq(kdv_bad, 0, "kdtree_within_radius matches brute force on 200 queries");

test_group("triangulate_polygon: partial returns are a documented contract");

# A convex quad triangulates completely: 3*(4-2) = 6 indices.
var tpc = vec_new();
vec_push(tpc, hvec2_new(0, 0));
vec_push(tpc, hvec2_new(F64_TWO, 0));
vec_push(tpc, hvec2_new(F64_TWO, F64_TWO));
vec_push(tpc, hvec2_new(0, F64_TWO));
assert_eq(vec_len(triangulate_polygon(tpc, 4)), 6, "convex quad -> complete, 3*(n-2) = 6");

# A self-intersecting polygon has no ear decomposition. The header claimed
# length = 3*(n-2) unconditionally through 2.7.0; it is actually SHORTER, and
# that is the signal a caller must test for.
var tpd = vec_new();
vec_push(tpd, hvec2_new(0, 0));
vec_push(tpd, hvec2_new(0, F64_TWO));
vec_push(tpd, hvec2_new(F64_ONE, F64_ONE));
vec_push(tpd, hvec2_new(0, F64_TWO));
vec_push(tpd, hvec2_new(F64_TWO, F64_ONE));
var tpd_len = vec_len(triangulate_polygon(tpd, 5));
# The CONTRACT is "at most 3*(n-2), a whole number of triples" -- complete OR
# partial are both valid. An earlier version of this assertion pinned `< 9`,
# i.e. it asserted that THIS input bails; the 2.7.0-O reflex-only pruning then
# triangulates it completely, which is strictly better and broke the assertion.
# Pinning which inputs happen to bail is pinning an implementation detail.
assert(tpd_len <= 9, "self-intersecting pentagon returns AT MOST 3*(n-2) = 9");
# The returned prefix is still whole triples -- a partial triangulation, not a
# truncated array.
assert_eq(tpd_len % 3, 0, "partial return is still a whole number of triples");

test_group("spatial: quadtree / octree / spatial hash had ZERO coverage");

# Three whole data structures, 11 public functions, untested through 2.7.0 --
# the same shape as the k-d tree defect that hid for three releases. Each is
# checked against brute force, not just for non-null.

# --- quadtree: 20x20 grid of points over [0,100]^2 ---
var qt = quadtree_new(0, 0, f64_from(100), f64_from(100), 6);
assert_neq(qt, 0, "quadtree_new returns a root");
var qgx = 0;
var qt_in = 0;
while (qgx < 20) {
    var qgy = 0;
    while (qgy < 20) {
        quadtree_insert(qt, f64_from(qgx * 5), f64_from(qgy * 5), qgx * 100 + qgy);
        qgy = qgy + 1;
    }
    qgx = qgx + 1;
}
# Box [10,30]x[10,30] inclusive covers grid coords 2..6 on each axis = 5*5 = 25.
var qres = quadtree_query(qt, f64_from(10), f64_from(10), f64_from(30), f64_from(30));
assert_eq(vec_len(qres), 25, "quadtree_query [10,30]^2 finds exactly 25 of 400");
# Whole-domain query must return everything.
assert_eq(vec_len(quadtree_query(qt, 0, 0, f64_from(100), f64_from(100))), 400,
"quadtree_query over the whole domain finds all 400");
# Disjoint box finds nothing.
assert_eq(vec_len(quadtree_query(qt, f64_from(200), f64_from(200), f64_from(300), f64_from(300))), 0,
"quadtree_query outside the domain finds nothing");

# --- octree: 8x8x8 grid over [0,80]^3 ---
var ot = octree_new(hvec3_zero(), hvec3_new(f64_from(80), f64_from(80), f64_from(80)), 5);
assert_neq(ot, 0, "octree_new returns a handle");
var oi = 0;
while (oi < 8) {
    var oj = 0;
    while (oj < 8) {
        var ok = 0;
        while (ok < 8) {
            octree_insert(ot, hvec3_new(f64_from(oi * 10), f64_from(oj * 10), f64_from(ok * 10)),
            oi * 64 + oj * 8 + ok);
            ok = ok + 1;
        }
        oj = oj + 1;
    }
    oi = oi + 1;
}
# [0,20]^3 inclusive covers grid 0..2 per axis = 27.
assert_eq(vec_len(octree_query(ot, hvec3_zero(), hvec3_new(f64_from(20), f64_from(20), f64_from(20)))),
27, "octree_query [0,20]^3 finds exactly 27 of 512");
assert_eq(vec_len(octree_query(ot, hvec3_zero(),
hvec3_new(f64_from(80), f64_from(80), f64_from(80)))), 512, "octree_query whole domain finds all 512");

# --- spatial hash: broadphase, so it may over-report but must never MISS ---
var sh = spatial_hash_new(f64_from(10));
assert_neq(sh, 0, "spatial_hash_new returns a handle");
var si = 0;
while (si < 100) {
    spatial_hash_insert(sh, hvec3_new(f64_from(si), f64_from(si), 0), si);
    si = si + 1;
}
# Same-cell query at the origin: points 0..9 share cell (0,0,0) with cell_size 10.
assert_eq(vec_len(spatial_hash_query_cell(sh, hvec3_zero())), 10,
"spatial_hash_query_cell finds the 10 points sharing cell (0,0,0)");
# Radius query is a broadphase: it must be a SUPERSET of the true answer.
var sh_r = spatial_hash_query_radius(sh, hvec3_zero(), f64_from(15));
var sh_true = 0;
si = 0;
while (si < 100) {
    var sd = f64_mul(f64_from(si), f64_sqrt(F64_TWO));
    if (f64_gt(sd, f64_from(15)) == 0) { sh_true = sh_true + 1; }
    si = si + 1;
}
assert(vec_len(sh_r) >= sh_true, "spatial_hash_query_radius never misses a true hit");
assert(sh_true > 0, "the radius test is non-vacuous -- there ARE true hits");
# clear() must actually empty it.
spatial_hash_clear(sh);
assert_eq(vec_len(spatial_hash_query_cell(sh, hvec3_zero())), 0,
"spatial_hash_clear empties every cell");

test_group("color: alpha compositing, tonemap, depth, EV -- 21 untested functions");

# premultiply / unpremultiply round-trip. a = 0.5 is dyadic so this is exact.
var cpm = premultiply_alpha(F64_ONE, F64_HALF, 0, F64_HALF);
assert_eq(HVec4_x(cpm), F64_HALF, "premultiply r = 1*0.5 = 0.5 exactly");
assert_eq(HVec4_y(cpm), 0x3FD0000000000000, "premultiply g = 0.5*0.5 = 0.25 exactly");
assert_eq(HVec4_w(cpm), F64_HALF, "premultiply keeps alpha");
var cup = unpremultiply_alpha(HVec4_x(cpm), HVec4_y(cpm), HVec4_z(cpm), HVec4_w(cpm));
assert_eq(HVec4_x(cup), F64_ONE, "unpremultiply round-trips r to 1");
assert_eq(HVec4_y(cup), F64_HALF, "unpremultiply round-trips g to 0.5");
# a == 0 is the documented guard.
assert_eq(HVec4_x(unpremultiply_alpha(F64_ONE, F64_ONE, F64_ONE, 0)), 0,
"unpremultiply with a = 0 returns zero, not Inf");

# Porter-Duff. Opaque dst under opaque src: dst_over keeps DST.
var cdo = composite_dst_over(F64_ONE, 0, 0, F64_ONE, 0, F64_ONE, 0, F64_ONE);
assert_eq(HVec4_y(cdo), F64_ONE, "dst_over over opaque dst keeps dst green");
assert_eq(HVec4_x(cdo), 0, "dst_over over opaque dst drops src red");
# src_in with opaque dst is src; with transparent dst it is nothing.
assert_eq(HVec4_x(composite_src_in(F64_ONE, 0, 0, F64_ONE, 0, 0, 0, F64_ONE)), F64_ONE,
"src_in with opaque dst keeps src");
assert_eq(HVec4_x(composite_src_in(F64_ONE, 0, 0, F64_ONE, 0, 0, 0, 0)), 0,
"src_in with transparent dst is empty");
assert_eq(HVec4_x(composite_dst_in(0, 0, 0, F64_ONE, F64_ONE, 0, 0, F64_ONE)), F64_ONE,
"dst_in with opaque src keeps dst");
assert_eq(HVec4_x(composite_src_out(F64_ONE, 0, 0, F64_ONE, 0, 0, 0, 0)), F64_ONE,
"src_out against transparent dst keeps src");
assert_eq(HVec4_x(composite_dst_out(0, 0, 0, 0, F64_ONE, 0, 0, F64_ONE)), F64_ONE,
"dst_out against transparent src keeps dst");
assert_eq(HVec4_w(composite_xor(F64_ONE, 0, 0, F64_ONE, 0, 0, 0, F64_ONE)), 0,
"xor of two opaque layers has zero alpha");
# plus saturates at 1.
var cpl = composite_plus(F64_ONE, F64_HALF, 0, F64_ONE, F64_ONE, F64_HALF, 0, F64_ONE);
assert_eq(HVec4_x(cpl), F64_ONE, "plus saturates red at 1");
assert_eq(HVec4_y(cpl), F64_ONE, "plus 0.5 + 0.5 = 1");

# Depth linearisation. ndc = 0 with near/far = 1/100 gives near*far/far = 1.
assert_eq(linearize_depth(0, F64_ONE, f64_from(100)), F64_ONE,
"linearize_depth at ndc = 0 returns near");
# Reverse-Z: ndc = 0 is the far plane and is guarded.
assert_eq(linearize_depth_reverse_z(0, F64_ONE), 0, "reverse-Z at ndc = 0 is guarded");
assert_eq(linearize_depth_reverse_z(F64_HALF, F64_ONE), F64_TWO,
"reverse-Z near/ndc = 1/0.5 = 2");

# EV100 round-trip: luminance_to_ev100(ev100_to_luminance(x)) == x.
var cev = f64_from(10);
var cev_rt = luminance_to_ev100(ev100_to_luminance(cev));
assert(f64_lt(f64_abs(f64_sub(cev_rt, cev)), LOOSE_TOL_M) == 1, "EV100 round-trips at 10");
assert(f64_gt(ev100_to_luminance(cev), ev100_to_luminance(F64_ONE)) == 1,
"higher EV means higher luminance");
assert(f64_gt(ev100_to_exposure(F64_ONE), ev100_to_exposure(cev)) == 1,
"higher EV means LOWER exposure");

# Vec3 sRGB wrappers must agree with the scalar path they wrap.
var csv = srgb_to_linear_vec3(hvec3_new(F64_HALF, F64_HALF, F64_HALF));
assert_eq(HVec3_x(csv), srgb_to_linear(F64_HALF), "srgb_to_linear_vec3 matches the scalar");
var cls = linear_to_srgb_vec3(csv);
assert(f64_lt(f64_abs(f64_sub(HVec3_x(cls), F64_HALF)), LOOSE_TOL_M) == 1,
"linear_to_srgb_vec3 round-trips 0.5");
# lerp at the endpoints is exact.
var cla = hvec3_new(F64_ONE, 0, 0);
var clb = hvec3_new(0, F64_ONE, 0);
# Not bit-exact: lerp_srgb converts to linear, interpolates, and converts back,
# so the endpoints come back 1 ulp low. Tolerance, not equality.
assert(f64_lt(f64_abs(f64_sub(HVec3_x(lerp_srgb_vec3(cla, clb, 0)), F64_ONE)), LOOSE_TOL_M) == 1,
"lerp_srgb t = 0 is a");
assert(f64_lt(f64_abs(f64_sub(HVec3_y(lerp_srgb_vec3(cla, clb, F64_ONE)), F64_ONE)), LOOSE_TOL_M) == 1,
"lerp_srgb t = 1 is b");

# Tonemaps: monotone, and black maps to black.
assert_eq(HVec3_x(tonemap_aces(0, 0, 0)), 0, "ACES maps black to black");
assert(f64_gt(HVec3_x(tonemap_aces(F64_ONE, 0, 0)), 0) == 1, "ACES of 1 is positive");
assert(f64_lt(HVec3_x(tonemap_reinhard_extended(F64_ONE, 0, 0, f64_from(4))), F64_ONE) == 1,
"Reinhard-extended of 1 stays below 1");

# Spherical harmonics L2: 9 coefficients, and the DC term is constant.
var csh = sh_eval_l2(hvec3_unit_z());
assert_neq(csh, 0, "sh_eval_l2 returns coefficients");
assert(f64_gt(load64(csh), 0) == 1, "sh_eval_l2 DC term is positive");
var csh2 = sh_eval_l2(hvec3_unit_x());
assert_eq(load64(csh), load64(csh2), "sh_eval_l2 DC term is direction-independent");

test_group("linalg_ext CSR + ode implicit integrators -- previously untested");

# --- CSR sparse. A = [[1,0,2],[0,3,0],[4,0,5]] ---
var cs_d = mat_new(3, 3);
mat_set(cs_d, 0, 0, F64_ONE);       mat_set(cs_d, 0, 2, F64_TWO);
mat_set(cs_d, 1, 1, f64_from(3));
mat_set(cs_d, 2, 0, f64_from(4));   mat_set(cs_d, 2, 2, f64_from(5));
var cs = csr_from_dense(cs_d);
assert_neq(cs, 0, "csr_from_dense returns a matrix");
assert_eq(csr_nrows(cs), 3, "csr_nrows = 3");
assert_eq(csr_ncols(cs), 3, "csr_ncols = 3");
assert_eq(csr_nnz(cs), 5, "csr_nnz counts exactly the 5 stored entries, not 9");
assert_neq(csr_row_ptr(cs), 0, "csr_row_ptr is populated");
assert_neq(csr_col_idx(cs), 0, "csr_col_idx is populated");
assert_neq(csr_values(cs), 0, "csr_values is populated");

# A * (1,1,1) = (3, 3, 9)
var cs_x = alloc(24);
store64(cs_x, F64_ONE); store64(cs_x + 8, F64_ONE); store64(cs_x + 16, F64_ONE);
var cs_y = csr_spmv(cs, cs_x);
assert_eq(f64_to(load64(cs_y)), 3, "csr_spmv row0 = 1+2 = 3");
assert_eq(f64_to(load64(cs_y + 8)), 3, "csr_spmv row1 = 3");
assert_eq(f64_to(load64(cs_y + 16)), 9, "csr_spmv row2 = 4+5 = 9");

# A + A = 2A, so spmv doubles.
var cs_sum = csr_add(cs, cs);
assert_neq(cs_sum, 0, "csr_add returns a matrix");
var cs_y2 = csr_spmv(cs_sum, cs_x);
assert_eq(f64_to(load64(cs_y2 + 16)), 18, "csr_add: (A+A)*x doubles row2 to 18");

# A^T = [[1,0,4],[0,3,0],[2,0,5]]; A^T*(1,1,1) = (5, 3, 7).
var cs_t = csr_transpose(cs);
assert_eq(csr_nnz(cs_t), 5, "csr_transpose preserves nnz");
var cs_y3 = csr_spmv(cs_t, cs_x);
assert_eq(f64_to(load64(cs_y3)), 5, "csr_transpose row0 = 1+4 = 5");
assert_eq(f64_to(load64(cs_y3 + 16)), 7, "csr_transpose row2 = 2+5 = 7");

# --- inertia_box: solid box I_xx = m(hy^2 + hz^2)/3 for HALF-extents.
# m = 12, h = (1,1,1) -> 12*(1+1)/3 = 8 on every axis.
var ib = inertia_box(f64_from(12), F64_ONE, F64_ONE, F64_ONE);
assert_neq(ib, 0, "inertia_box returns a tensor");
# Returns a Mat3, not a vector. Formula uses FULL extents: w = 2*hx, so for
# m = 12 and half-extents (1,1,1) the box is 2x2x2 and I_xx = (m/12)(h^2+d^2) = 8.
assert_eq(f64_to(mat_get(ib, 0, 0)), 8, "inertia_box 2x2x2 cube I_xx = (m/12)(h^2+d^2) = 8");
assert_eq(f64_to(mat_get(ib, 2, 2)), 8, "inertia_box cube is isotropic");
assert_eq(f64_to(mat_get(ib, 0, 1)), 0, "inertia_box is diagonal for an axis-aligned box");

# --- matrix_condition_number: identity is perfectly conditioned.
var mc_i = mat_identity(3);
var mc = matrix_condition_number(mc_i);
# This uses the FROBENIUS norm, not the 2-norm, so cond(I_3) = sqrt(3)*sqrt(3) = 3,
# not 1. The doc says ||A|| * ||A^-1|| without naming the norm, so it is
# self-consistent -- but it is NOT the spectral condition number a caller may expect.
assert(f64_lt(f64_abs(f64_sub(mc, f64_from(3))), LOOSE_TOL_M) == 1,
"cond_F(I_3) = ||I||_F * ||I^-1||_F = 3");
# A badly-scaled matrix must score worse than the identity.
var mc_b = mat_new(2, 2);
mat_set(mc_b, 0, 0, f64_from(1000)); mat_set(mc_b, 1, 1, f64_div(F64_ONE, f64_from(1000)));
assert(f64_gt(matrix_condition_number(mc_b), mc) == 1,
"cond(diag(1000, 0.001)) is far worse than cond(I)");

# --- eigen_symmetric on diag(3,1): eigenvalues 3 and 1.
var es_A = mat_new(2, 2);
mat_set(es_A, 0, 0, f64_from(3)); mat_set(es_A, 1, 1, F64_ONE);
var es_vals = alloc(16);
var es_vecs = mat_new(2, 2);
assert_eq(eigen_symmetric(es_A, 2, es_vals, es_vecs), HSB_ERR_NONE, "eigen_symmetric converges");
assert_eq(f64_to(load64(es_vals)), 3, "eigen_symmetric dominant eigenvalue = 3");

# --- implicit ODE integrators on y' = y, y(0) = 1, dt = 1/4.
# Backward Euler: y1 = y/(1-dt) = 1/0.75 = 4/3.
var oi_dt = f64_div(F64_ONE, f64_from(4));
var oi_be = ode_backward_euler(&_cv_dydt_y, 0, F64_ONE, oi_dt, EPSILON_F64, 50);
var oi_be_want = f64_div(f64_from(4), f64_from(3));
assert(f64_lt(f64_abs(f64_sub(oi_be, oi_be_want)), LOOSE_TOL_M) == 1,
"backward Euler y1 = 1/(1-dt) = 4/3");
# It must be ABOVE the exact e^dt -- backward Euler over-shoots on a growing solution.
assert(f64_gt(oi_be, f64_exp(oi_dt)) == 1, "backward Euler overshoots exp(dt), as it must");

# BDF2 with a consistent history is at least as accurate as backward Euler here.
var oi_bdf = ode_bdf2(&_cv_dydt_y, 0, F64_ONE, f64_div(F64_ONE, f64_exp(oi_dt)), oi_dt, EPSILON_F64);
assert(f64_gt(oi_bdf, F64_ONE) == 1, "bdf2 advances a growing solution");

# Leapfrog on the SHO from (q,v) = (1,0): one step must reduce q and drive v negative.
var oi_lf = ode_leapfrog(&_cv_accel, F64_ONE, 0, F64_HALF);
assert(f64_lt(load64(oi_lf), F64_ONE) == 1, "leapfrog q decreases from the turning point");
assert(f64_lt(load64(oi_lf + 8), 0) == 1, "leapfrog v goes negative from the turning point");

# Balance guard: the hybrid partition must keep every child at >= 1/4 of its
# parent, so depth is bounded at log_(4/3)(n) regardless of coordinate
# distribution. Geometric spacing is the case the value-midpoint split handles
# badly; this builds and queries correctly either way.
var kdb_n = 8000;
var kdb_p = alloc(kdb_n * 8);
var kdb_i = 0;
var kdb_v = F64_ONE;
while (kdb_i < kdb_n) {
    kdb_v = f64_mul(kdb_v, 0x3FEFFF0000000000);
    store64(kdb_p + kdb_i * 8, hvec3_new(kdb_v, f64_from(kdb_i % 97), f64_from(kdb_i % 89)));
    kdb_i = kdb_i + 1;
}
var kdb_t = kdtree_build(kdb_p, kdb_n);
assert_neq(kdb_t, 0, "kdtree_build handles geometrically-spaced coordinates");
assert_eq(_kdv_invariant_bad(kdb_t, kdb_p), 0,
"geometric spacing: split-plane invariant still holds on every node");

# ================================================================
var r = assert_summary();
# Clamp before exiting: assert_summary() returns the raw failure COUNT, and a wait
# status is only 8 bits — an unclamped 256 / 512 / 768 failures would exit 0 and
# score PASS. Any failure at all is exit 1.
if (r > 0) { r = 1; }
sys_exit_group(r);
