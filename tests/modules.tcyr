# ----------------------------------------------------------------
test_group("tensor: tensor_add");

var t_shape2 = alloc(16);
store64(t_shape2, 2); store64(t_shape2 + 8, 2);
var t_a = tensor_new(2, t_shape2);
tensor_set2(t_a, 0, 0, f64_from(1));
tensor_set2(t_a, 0, 1, f64_from(2));
tensor_set2(t_a, 1, 0, f64_from(3));
tensor_set2(t_a, 1, 1, f64_from(4));

var t_b = tensor_new(2, t_shape2);
tensor_set2(t_b, 0, 0, f64_from(10));
tensor_set2(t_b, 0, 1, f64_from(20));
tensor_set2(t_b, 1, 0, f64_from(30));
tensor_set2(t_b, 1, 1, f64_from(40));

var t_sum = tensor_add(t_a, t_b);
assert_eq(tensor_get2(t_sum, 0, 0), f64_from(11), "tensor_add [0,0]");
assert_eq(tensor_get2(t_sum, 0, 1), f64_from(22), "tensor_add [0,1]");
assert_eq(tensor_get2(t_sum, 1, 0), f64_from(33), "tensor_add [1,0]");
assert_eq(tensor_get2(t_sum, 1, 1), f64_from(44), "tensor_add [1,1]");

# ================================================================
# COLLISION_CORE — contacts, sequential impulse smoke
# ================================================================
# 2.4.x collision-correctness arc COMPLETE — every algorithm audited + covered:
# convex_hull_2d (2.4.0), triangulate_polygon (2.4.1), delaunay_2d (2.4.2),
# half-edge mesh (2.4.3), MPR narrowphase (2.4.4), and sequential_impulse (2.4.5,
# below); solve_pgs_checked (solve_pgs until 3.4.0) is covered in hisab.tcyr. Real bugs were found + fixed in the
# hull sort (2.4.0), MPR (2.4.4), and the impulse solver (2.4.5).
test_group("collision_core: contact_new + accessors");

var c_norm = hvec3_new(0, F64_ONE, 0);
var contact = contact_new(0, 1, c_norm, F64_HALF, F64_HALF, F64_HALF, F64_ONE, F64_ONE);
assert_eq(ColContact_body_a(contact), 0, "ColContact body_a");
assert_eq(ColContact_body_b(contact), 1, "ColContact body_b");
# ⭐ 2.13.0 — the one assertion in this sweep whose truncation was DELIBERATE, and
# its own message said so. Kept as a truncation test, but now pinned on BOTH sides:
# the stored value is bit-exactly 0.5, and reading it through `f64_to` gives 0.
# Before, only the second half was asserted, so the first was free to drift.
assert_eq(ColContact_penetration(contact), F64_HALF, "ColContact penetration is bit-exactly 0.5");
assert_eq(f64_to(ColContact_penetration(contact)), 0, "ColContact penetration: 0.5 truncates to 0 through f64_to");

# MPR narrowphase (2.4.4) — fixed a false-positive: separated shapes used to
# report a hit (missing origin-containment early-out → degenerate colinear
# branch returned 1). Now intersect/penetration are correct for spheres + boxes.
test_group("geo_advanced: MPR narrowphase");

var mpr_a = hvec4_new(0, 0, 0, F64_TWO);            # sphere r=2 @ origin
var mpr_b_ov = hvec4_new(f64_from(3), 0, 0, F64_TWO);   # dist 3 < 4 → overlap
var mpr_b_sep = hvec4_new(f64_from(5), 0, 0, F64_ONE);  # dist 5 > 3 → separated
var mpr_b_off = hvec4_new(f64_from(5), f64_from(5), 0, F64_ONE);  # off-axis sep

var mpr_ov = mpr_intersect(&_mpr_sup_sphere, mpr_a, &_mpr_sup_sphere, mpr_b_ov);
assert_eq(mpr_ov, 1, "mpr_intersect: spheres overlap");
var mpr_sep = mpr_intersect(&_mpr_sup_sphere, mpr_a, &_mpr_sup_sphere, mpr_b_sep);
assert_eq(mpr_sep, 0, "mpr_intersect: spheres separated (was false +ve)");
var mpr_off = mpr_intersect(&_mpr_sup_sphere, mpr_a, &_mpr_sup_sphere, mpr_b_off);
assert_eq(mpr_off, 0, "mpr_intersect: spheres separated off-axis");

# Penetration: depth = sum_radii − dist. Normal along ±x. Scale by 100 for f64_to.
var mpr_n = alloc(8);
var mpr_d = alloc(8);
var mpr_hit = mpr_penetration(&_mpr_sup_sphere, mpr_a, &_mpr_sup_sphere, mpr_b_ov, mpr_n, mpr_d);
assert_eq(mpr_hit, 1, "mpr_penetration: overlap returns hit");
assert_f64_eq(load64(mpr_d), f64_div(f64_from(100), f64_from(100)), "mpr_penetration: depth ~1.0 (4-3)");
# 2.9.0: was assert_eq(f64_to(|nx| * 100), 100). f64_to TRUNCATES, so that read
# "0.99 <= |nx| <= 1.00" -- and it FAILS the moment the normal is right to only
# 15 digits and not exactly, because 0.9999999999 * 100 truncates to 99. The
# depth is now refined to the true MTV, so the normal is a converged direction
# rather than an exact axis; the check below is 1e-9 ABSOLUTE, i.e. seven orders
# of magnitude tighter than the truncation it replaces.
var mpr_nx = f64_abs(HVec3_x(load64(mpr_n)));
assert(f64_approx_eq(mpr_nx, F64_ONE, 0x3E112E0BE826D695),
  "mpr_penetration: normal ~±x within 1e-9");

var mpr_b_deep = hvec4_new(F64_ONE, 0, 0, F64_TWO);     # dist 1 → depth 4-1 = 3
var mpr_n2 = alloc(8);
var mpr_d2 = alloc(8);
mpr_penetration(&_mpr_sup_sphere, mpr_a, &_mpr_sup_sphere, mpr_b_deep, mpr_n2, mpr_d2);
assert_f64_eq(load64(mpr_d2), f64_div(f64_from(300), f64_from(100)), "mpr_penetration: deep depth ~3.0 (4-1)");

var mpr_n3 = alloc(8);
var mpr_d3 = alloc(8);
var mpr_miss = mpr_penetration(&_mpr_sup_sphere, mpr_a, &_mpr_sup_sphere, mpr_b_sep, mpr_n3, mpr_d3);
assert_eq(mpr_miss, 0, "mpr_penetration: separated returns miss");

# Boxes (axis-aligned): overlap + separated.
var mpr_box_a = _mpr_mkbox(0, 0, 0, F64_ONE, F64_ONE, F64_ONE);
var mpr_box_ov = _mpr_mkbox(F64_ONE, 0, 0, F64_ONE, F64_ONE, F64_ONE);
var mpr_boxov = mpr_intersect(&_mpr_sup_box, mpr_box_a, &_mpr_sup_box, mpr_box_ov);
assert_eq(mpr_boxov, 1, "mpr_intersect: boxes overlap");
var mpr_box_sep = _mpr_mkbox(f64_from(5), 0, 0, F64_ONE, F64_ONE, F64_ONE);
var mpr_boxsep = mpr_intersect(&_mpr_sup_box, mpr_box_a, &_mpr_sup_box, mpr_box_sep);
assert_eq(mpr_boxsep, 0, "mpr_intersect: boxes separated");

# ================================================================
# 2.9.0 -- narrowphase depth against an EXACT reference
# ================================================================
# Every expected value below is a closed form or an exact-rational computation,
# never a previous hisab output:
#   box/box     -- 15-axis OBB SAT evaluated in python3 Fractions
#   sphere/box  -- r - sdBox(centre in box frame, half-extents)
#   sphere/sph  -- r0 + r1 - |c1 - c0|
#   cylinder/box-- independent Nelder-Mead minimisation of the support function
#                  h_M over the unit sphere (no closed form exists)
#
# What each assertion catches, measured against the pre-2.9.0 source:
#   off-axis box/box      mpr 0.0        -> 1.61          (portal plane through
#                                                          the INTERIOR point)
#   MPR-is-not-MTV box    mpr 1.0-ish    -> 0.5           (textbook MPR picks the
#                                                          wrong axis; the error
#                                                          ratio is unbounded)
#   separated pair        mpr hit @ 4.6  -> miss
#   box vs sphere         gjk 2.2e-16    -> 0.8           (degenerate GJK simplex
#                                                          reported "no contact")
#   concentric spheres    gjk 1.8875     -> 2.0           (expansion stalled)
#   scale 1e3             gjk 999.98922  -> 1000.0        (absolute epsilon)
#   near tangency         gjk 4.4114e-5  -> 1e-6
#   cylinder vs OBB       mpr 3.2801     -> 0.19769663
# [measured: scratch runs of the pre-repair source, not reproducible in-tree, 2.8.3; the right column is asserted below]
var NP9_TOL = 0x3E112E0BE826D695;   # 1e-9 -- absolute, values here are O(1)

# Oriented box: 15 slots [cx,cy,cz, hx,hy,hz, u0(3), u1(3), u2(3)].
fn _mpr_sup_obb(shape, dir) {
    var acc = hvec3_new(load64(shape), load64(shape + 8), load64(shape + 16));
    for (var oi = 0; oi < 3; oi = oi + 1) {
        var u = hvec3_new(load64(shape + 48 + oi * 24), load64(shape + 56 + oi * 24),
          load64(shape + 64 + oi * 24));
        var hh = load64(shape + 24 + oi * 8);
        if (f64_lt(hvec3_dot(dir, u), 0) == 1) { hh = f64_neg(hh); }
        acc = hvec3_add(acc, hvec3_scale(u, hh));
    }
    return acc;
}

# z-axis cylinder: 5 slots [cx,cy,cz, radius, half_height].
fn _mpr_sup_cyl(shape, dir) {
    var acc = hvec3_new(load64(shape), load64(shape + 8), load64(shape + 16));
    var pl = f64_sqrt(f64_add(f64_mul(HVec3_x(dir), HVec3_x(dir)),
        f64_mul(HVec3_y(dir), HVec3_y(dir))));
    if (f64_gt(pl, 0) == 1) {
        var sc = f64_div(load64(shape + 24), pl);
        acc = hvec3_add(acc, hvec3_new(f64_mul(HVec3_x(dir), sc),
            f64_mul(HVec3_y(dir), sc), 0));
    }
    var hz = load64(shape + 32);
    if (f64_lt(HVec3_z(dir), 0) == 1) { hz = f64_neg(hz); }
    return hvec3_add(acc, hvec3_new(0, 0, hz));
}

fn _mpr_mkobb(cx, cy, cz, hx, hy, hz) {
    var s = alloc(120);
    store64(s, cx);
    store64(s + 8, cy);
    store64(s + 16, cz);
    store64(s + 24, hx);
    store64(s + 32, hy);
    store64(s + 40, hz);
    for (var oi = 0; oi < 9; oi = oi + 1) { store64(s + 48 + oi * 8, 0); }
    store64(s + 48, F64_ONE);
    store64(s + 80, F64_ONE);
    store64(s + 112, F64_ONE);
    return s;
}

fn _mpr_obb_axis(s, i, x, y, z) {
    store64(s + 48 + i * 24, x);
    store64(s + 56 + i * 24, y);
    store64(s + 64 + i * 24, z);
    return 0;
}

# Depth of one narrowphase call; mode 0 = gjk_epa_3d, 1 = mpr_penetration.
# Returns -inf on a reported miss so a miss can never pass an approx-equality.
fn _np9_depth(fa, sa, fb, sb, mode) {
    var nn = alloc(8);
    var dd = alloc(8);
    store64(dd, 0);
    var r = gjk_epa_3d(fa, sa, fb, sb, nn, dd);
    if (mode == 1) { r = mpr_penetration(fa, sa, fb, sb, nn, dd); }
    if (r != 1) { return _COL_F64_NEG_INF; }
    return load64(dd);
}

test_group("geo_advanced: narrowphase depth == exact MTV (2.9.0)");

var np9_pn_n = alloc(8);
var np9_pn_d = alloc(8);
var np9_pn_n2 = alloc(8);
var np9_pn_d2 = alloc(8);

# --- off-axis box/box. Unit boxes, offset (0.3, 0, -0.39).
# Minkowski difference = box centred (-0.3, 0, 0.39) with half-extents 2, so the
# MTV is min(2-0.3, 2-0, 2-0.39) = 1.61 on the z axis. The shipped code reported
# 0.0: it measured the plane through v0, the INTERIOR point.
# [measured: scratch run of the pre-repair source, not reproducible in-tree, 2.8.3; 1.61 is asserted below]
var np9_bb_a = _mpr_mkbox(0, 0, 0, F64_ONE, F64_ONE, F64_ONE);
var np9_bb_b = _mpr_mkbox(f64_div(f64_from(3), f64_from(10)), 0,
  f64_neg(f64_div(f64_from(39), f64_from(100))), F64_ONE, F64_ONE, F64_ONE);
var np9_bb_exp = f64_div(f64_from(161), f64_from(100));   # 1.61 exactly
assert_eq(mpr_penetration(&_mpr_sup_box, np9_bb_a, &_mpr_sup_box, np9_bb_b, np9_pn_n, np9_pn_d), 1,
  "mpr_penetration: off-axis boxes report a hit");
assert(f64_approx_eq(load64(np9_pn_d), np9_bb_exp, NP9_TOL),
  "mpr_penetration: off-axis box/box depth == 1.61 exact SAT (was 0.0)");
assert(f64_approx_eq(f64_abs(HVec3_z(load64(np9_pn_n))), F64_ONE, NP9_TOL),
  "mpr_penetration: off-axis box/box normal is the z axis");
assert_eq(gjk_epa_3d(&_mpr_sup_box, np9_bb_a, &_mpr_sup_box, np9_bb_b, np9_pn_n2, np9_pn_d2), 1,
  "gjk_epa_3d: off-axis boxes report a hit");
assert(f64_approx_eq(load64(np9_pn_d2), np9_bb_exp, NP9_TOL),
  "gjk_epa_3d: off-axis box/box depth == 1.61 exact SAT");

# The unit normal really is a unit vector (the old code stored a portal normal
# built from a cross product it never renormalised on the fallback path).
assert(f64_approx_eq(hvec3_length(load64(np9_pn_n)), F64_ONE, NP9_TOL),
  "mpr_penetration: normal is unit length");

# --- MPR's OWN answer is not the MTV, and this fixture pins the difference.
# A and B are 0.5 x 5 x 5 boxes, B offset (0.5, 9, 0). The difference is a box
# centred (-0.5, -9, 0) with half-extents (1, 10, 10): textbook MPR leaves
# through the axis maximising |c_i|/h_i (y: 0.9) and reports 10-9 = 1.0, while
# the MTV is on the axis minimising h_i-|c_i| (x) and equals 0.5. Stretching the
# y extent makes that ratio arbitrarily large, which is why the depth is refined
# rather than read off the portal.
var np9_mv_h = f64_div(F64_ONE, F64_TWO);
var np9_mv_a = _mpr_mkbox(0, 0, 0, np9_mv_h, f64_from(5), f64_from(5));
var np9_mv_b = _mpr_mkbox(np9_mv_h, f64_from(9), 0, np9_mv_h, f64_from(5), f64_from(5));
assert_eq(mpr_penetration(&_mpr_sup_box, np9_mv_a, &_mpr_sup_box, np9_mv_b, np9_pn_n, np9_pn_d), 1,
  "mpr_penetration: anisotropic boxes report a hit");
assert(f64_approx_eq(load64(np9_pn_d), np9_mv_h, NP9_TOL),
  "mpr_penetration: depth is the MTV 0.5, not MPR's own portal answer 1.0");
assert(f64_approx_eq(f64_abs(HVec3_x(load64(np9_pn_n))), F64_ONE, NP9_TOL),
  "mpr_penetration: anisotropic MTV normal is the x axis, not y");
gjk_epa_3d(&_mpr_sup_box, np9_mv_a, &_mpr_sup_box, np9_mv_b, np9_pn_n2, np9_pn_d2);
assert(f64_approx_eq(load64(np9_pn_d2), np9_mv_h, NP9_TOL),
  "gjk_epa_3d: anisotropic box/box depth == MTV 0.5");

# --- SEPARATED must be a miss. Half-extents (1,10,10) at the origin against a
# 1e-9 box at (1.4, 0.5, 0.1): the x gap is 0.4. The shipped code returned 1
# with depth 4.6063.
var np9_sep_a = _mpr_mkbox(0, 0, 0, F64_ONE, f64_from(10), f64_from(10));
var np9_sep_tiny = f64_div(F64_ONE, f64_from(1000000000));
var np9_sep_b = _mpr_mkbox(f64_div(f64_from(14), f64_from(10)), f64_div(F64_ONE, F64_TWO),
  f64_div(F64_ONE, f64_from(10)), np9_sep_tiny, np9_sep_tiny, np9_sep_tiny);
assert_eq(mpr_penetration(&_mpr_sup_box, np9_sep_a, &_mpr_sup_box, np9_sep_b, np9_pn_n, np9_pn_d), 0,
  "mpr_penetration: separated anisotropic pair is a miss (was hit @ 4.6063)");
assert_eq(gjk_epa_3d(&_mpr_sup_box, np9_sep_a, &_mpr_sup_box, np9_sep_b, np9_pn_n2, np9_pn_d2), 0,
  "gjk_epa_3d: separated anisotropic pair is a miss");

# --- box vs sphere, BOX FIRST. r - sdBox((1.2,0,0.7), (1,1,1)) = 1 - 0.2 = 0.8.
# Order matters to GJK's direction sequence: this ordering produced a degenerate
# simplex, which the shipped code answered with 2.2e-16.
var np9_bs_box = _mpr_mkbox(0, 0, 0, F64_ONE, F64_ONE, F64_ONE);
var np9_bs_sph = hvec4_new(f64_div(f64_from(12), f64_from(10)), 0,
  f64_div(f64_from(7), f64_from(10)), F64_ONE);
var np9_bs_exp = f64_div(f64_from(8), f64_from(10));
assert_eq(gjk_epa_3d(&_mpr_sup_box, np9_bs_box, &_mpr_sup_sphere, np9_bs_sph, np9_pn_n2, np9_pn_d2), 1,
  "gjk_epa_3d: box-then-sphere reports a hit");
assert(f64_approx_eq(load64(np9_pn_d2), np9_bs_exp, NP9_TOL),
  "gjk_epa_3d: box vs sphere depth == 0.8 = r - sdBox (was 2.2e-16)");
mpr_penetration(&_mpr_sup_box, np9_bs_box, &_mpr_sup_sphere, np9_bs_sph, np9_pn_n, np9_pn_d);
assert(f64_approx_eq(load64(np9_pn_d), np9_bs_exp, NP9_TOL),
  "mpr_penetration: box vs sphere depth == 0.8 (was -1.3964)");

# --- concentric unit spheres. Depth = r0 + r1 = 2 exactly. This is the case the
# expansion could not converge on (1.8875 at 64 iterations, 1.9794 at 400) and
# the case where the MPR portal degenerates onto its own v0-v1 edge (0.0).
var np9_cc_a = hvec4_new(0, 0, 0, F64_ONE);
var np9_cc_b = hvec4_new(0, 0, 0, F64_ONE);
assert(f64_approx_eq(_np9_depth(&_mpr_sup_sphere, np9_cc_a, &_mpr_sup_sphere, np9_cc_b, 0),
    F64_TWO, NP9_TOL), "gjk_epa_3d: concentric unit spheres depth == 2.0 (was 1.8875)");
assert(f64_approx_eq(_np9_depth(&_mpr_sup_sphere, np9_cc_a, &_mpr_sup_sphere, np9_cc_b, 1),
    F64_TWO, NP9_TOL), "mpr_penetration: concentric unit spheres depth == 2.0 (was 0.0)");

# --- SCALE INVARIANCE. r=2 spheres 3 apart -> depth 1, the identical geometry at
# 1e-3 / 1e3 / 1e6 -> depth 1e-3 / 1e3 / 1e6. The convergence test used to be an
# ABSOLUTE 1e-12, so the same shape at a different scale gave a different answer
# (1.078e-5 relative at every scale away from 1).
# [measured: scratch run of the pre-repair source, not reproducible in-tree, 2.8.3]
for (var sk = 0; sk < 3; sk = sk + 1) {
    var kf = F64_ONE;
    if (sk == 0) { kf = f64_div(F64_ONE, f64_from(1000)); }
    if (sk == 2) { kf = f64_from(1000000); }
    if (sk == 1) { kf = f64_from(1000); }
    var sc_a = hvec4_new(0, 0, 0, f64_mul(F64_TWO, kf));
    var sc_b = hvec4_new(f64_mul(f64_from(3), kf), 0, 0, f64_mul(F64_TWO, kf));
    var sc_got = _np9_depth(&_mpr_sup_sphere, sc_a, &_mpr_sup_sphere, sc_b, 0);
    assert(f64_approx_eq(f64_div(sc_got, kf), F64_ONE, f64_div(F64_ONE, f64_from(1000000))),
      "gjk_epa_3d: sphere depth is scale-invariant (relative, not absolute, tolerance)");
    var sc_got2 = _np9_depth(&_mpr_sup_sphere, sc_a, &_mpr_sup_sphere, sc_b, 1);
    assert(f64_approx_eq(f64_div(sc_got2, kf), F64_ONE, f64_div(F64_ONE, f64_from(1000000))),
      "mpr_penetration: sphere depth is scale-invariant");
}

# --- SCALE INVARIANCE, CARRIED DOWN TO k = 1e-9. The loop above stops at 1e-3,
# which is ABOVE the scale at which gjk_epa_3d's two scale-sensitive mechanisms
# start to matter, so both of them were live and unpinned. Measured on the 2.9.0
# tree by mutating each one and re-running THIS geometry:
#   * _epa_seed_gjk's "2" return -- "the origin is enclosed but the simplex is
#     not a usable seed, fall back to the portal". Returning 0 instead routes the
#     call into _epa_touch_probe, which certifies a depth-0 TOUCH: at k = 1e-7,
#     1e-8 and 1e-9 gjk_epa_3d then reports a hit whose depth is 0 instead of k
#     and whose normal is +z instead of the line of centres. mpr_penetration is
#     untouched by that mutation -- it seeds itself -- so the sweep runs both
#     siblings and it is the gjk_epa_3d half that pins the fallback.
#   * the RELATIVE convergence tolerance. An ABSOLUTE one (EPSILON_F64) stops
#     early down here: depth/k comes back 1.0000725 at k = 1e-8 and 1.000668 at
#     k = 1e-9 (7.3e-5 and 6.7e-4 relative), with the normal 6.8e-3 and 2.1e-2
#     off the x axis. The shipped code holds depth/k to 1e-12 and the normal to
#     1e-11 at every one of these scales, so 1e-6 is ~700x clear of the noise.
# The NORMAL is the load-bearing half: at k = 1e-7 the absolute tolerance still
# gets the depth right and only the direction gives it away.
# [measured: scratch mutants on the 2.9.0 tree, not reproducible in-tree]
var ns9_n = alloc(8);
var ns9_d = alloc(8);
var NS9_TOL = f64_div(F64_ONE, f64_from(1000000));   # 1e-6, relative
for (var ns_k = 7; ns_k < 10; ns_k = ns_k + 1) {
    var ns_kf = F64_ONE;
    for (var ns_e = 0; ns_e < ns_k; ns_e = ns_e + 1) { ns_kf = f64_div(ns_kf, f64_from(10)); }
    var ns_a = hvec4_new(0, 0, 0, f64_mul(F64_TWO, ns_kf));
    var ns_b = hvec4_new(f64_mul(f64_from(3), ns_kf), 0, 0, f64_mul(F64_TWO, ns_kf));
    for (var ns_m = 0; ns_m < 2; ns_m = ns_m + 1) {
        store64(ns9_d, 0);
        store64(ns9_n, hvec3_zero());
        var ns_r = gjk_epa_3d(&_mpr_sup_sphere, ns_a, &_mpr_sup_sphere, ns_b, ns9_n, ns9_d);
        if (ns_m == 1) {
            ns_r = mpr_penetration(&_mpr_sup_sphere, ns_a, &_mpr_sup_sphere, ns_b, ns9_n, ns9_d);
        }
        assert_eq(ns_r, 1, "narrowphase: r=2k spheres 3k apart report a hit down to k = 1e-9");
        assert(f64_approx_eq(f64_div(load64(ns9_d), ns_kf), F64_ONE, NS9_TOL),
          "narrowphase: depth == k down to k = 1e-9 (a seed fallback that bails answers 0)");
        assert(f64_lt(hvec3_length(hvec3_cross(load64(ns9_n), hvec3_unit_x())), NS9_TOL) == 1,
          "narrowphase: micro-scale normal is the line of centres (an absolute tolerance loses it)");
    }
}

# --- NEAR TANGENCY. r=2 spheres 3.999999 apart -> depth 1e-6. The shipped code
# answered 4.4114e-5, a 43x over-report, because it stopped refining direction
# long before the depth mattered.
# [measured: scratch run of the pre-repair source, not reproducible in-tree, 2.8.3]
var np9_tg_a = hvec4_new(0, 0, 0, F64_TWO);
var np9_tg_b = hvec4_new(f64_sub(f64_from(4), f64_div(F64_ONE, f64_from(1000000))), 0, 0, F64_TWO);
var np9_tg_exp = f64_div(F64_ONE, f64_from(1000000));
var np9_tg_tol = f64_div(F64_ONE, f64_from(1000000000000));
assert(f64_approx_eq(_np9_depth(&_mpr_sup_sphere, np9_tg_a, &_mpr_sup_sphere, np9_tg_b, 0),
    np9_tg_exp, np9_tg_tol), "gjk_epa_3d: near-tangent spheres depth == 1e-6 (was 4.4114e-5)");
assert(f64_approx_eq(_np9_depth(&_mpr_sup_sphere, np9_tg_a, &_mpr_sup_sphere, np9_tg_b, 1),
    np9_tg_exp, np9_tg_tol), "mpr_penetration: near-tangent spheres depth == 1e-6");

# --- THE MANDATORY CYLINDER vs ROTATED-BOX FIXTURE (from the 2.8.2 roadmap's
# gjk_epa_3d O(k^2) row; the 2.8.3 roadmap dropped the row).
# A z-axis cylinder r=1.8793535667752475, half-height=1.2791168772746317 at the
# origin against an OBB. That row gave this reproducer's exact depth as
# 0.19783922047988; that number is WRONG -- it came from a coarse spherical grid
# search. An independent Nelder-Mead minimisation of h_M over the unit sphere,
# multi-started from a 200k-point Fibonacci lattice, converges to
# 0.19769663486454, and hisab's own answer 0.19769663487882 is a CERTIFIED upper
# bound on the MTV (it is h_M evaluated at a real direction), so the true value
# cannot exceed it. Both agree to 7.2e-11 relative. The shipped mpr_penetration
# returned 3.2801295 here.
# [measured: scratch Nelder-Mead oracle and pre-repair run, 2.8.3, not in-tree; the asserts below hold it to 1e-8]
var np9_cy_s = alloc(40);
store64(np9_cy_s, 0);
store64(np9_cy_s + 8, 0);
store64(np9_cy_s + 16, 0);
store64(np9_cy_s + 24, 0x3FFE11D50BAEBAF1);   # radius      1.8793535667752475
store64(np9_cy_s + 32, 0x3FF47743423A7FC0);   # half-height 1.2791168772746317
var np9_cy_b = _mpr_mkobb(0x4005732F92CFB63E, 0xC006EB1792881994, 0xBFFF55B8C5B1A9C0,
  0x3FFE93DAB8D7F5D9, 0x3FFAE1DE4A99CE2F, 0x3FF3482F05E60E8C);
_mpr_obb_axis(np9_cy_b, 0, 0x3FEF2D85DD7338A3, 0xBFCBFD941B69FBE9, 0x3FAB9A84DBCB55FA);
_mpr_obb_axis(np9_cy_b, 1, 0x3FCCC1C7CD456741, 0x3FEDA7F420E83330, 0xBFD34519497EDB0B);
_mpr_obb_axis(np9_cy_b, 2, 0x3F90423091D65D37, 0x3FD38CCD2BAACD4D, 0x3FEE775ADA949BF9);
var np9_cy_exp = 0x3FC94E1F92A2E068;          # 0.1976966348645448
var np9_cy_tol = f64_div(F64_ONE, f64_from(100000000));   # 1e-8 absolute
assert_eq(mpr_penetration(&_mpr_sup_cyl, np9_cy_s, &_mpr_sup_obb, np9_cy_b, np9_pn_n, np9_pn_d), 1,
  "mpr_penetration: cylinder vs rotated OBB reports a hit");
assert(f64_approx_eq(load64(np9_pn_d), np9_cy_exp, np9_cy_tol),
  "mpr_penetration: cylinder vs rotated OBB depth == 0.19769663 (was 3.2801295)");
assert_eq(gjk_epa_3d(&_mpr_sup_cyl, np9_cy_s, &_mpr_sup_obb, np9_cy_b, np9_pn_n2, np9_pn_d2), 1,
  "gjk_epa_3d: cylinder vs rotated OBB reports a hit");
assert(f64_approx_eq(load64(np9_pn_d2), np9_cy_exp, np9_cy_tol),
  "gjk_epa_3d: cylinder vs rotated OBB depth == 0.19769663");
# The two siblings carry the same documented contract, so they must agree.
assert(f64_approx_eq(load64(np9_pn_d), load64(np9_pn_d2), np9_cy_tol),
  "mpr_penetration and gjk_epa_3d agree on the cylinder fixture");

# --- THE INVARIANT A WRONG ANSWER CANNOT SATISFY: translating B by
# depth * normal must SEPARATE the pair. This does not compare against any
# reference value at all -- it re-runs the overlap test on the corrected pose.
var np9_iv_box_a = _mpr_mkbox(0, 0, 0, F64_ONE, F64_ONE, F64_ONE);
var np9_iv_box_b = _mpr_mkbox(f64_div(f64_from(3), f64_from(10)), 0,
  f64_neg(f64_div(f64_from(39), f64_from(100))), F64_ONE, F64_ONE, F64_ONE);
mpr_penetration(&_mpr_sup_box, np9_iv_box_a, &_mpr_sup_box, np9_iv_box_b, np9_pn_n, np9_pn_d);
var np9_iv_push = f64_mul(load64(np9_pn_d), f64_div(f64_from(1000001), f64_from(1000000)));
var np9_iv_nrm = load64(np9_pn_n);
var np9_iv_moved = _mpr_mkbox(f64_add(load64(np9_iv_box_b), f64_mul(HVec3_x(np9_iv_nrm), np9_iv_push)),
  f64_add(load64(np9_iv_box_b + 8), f64_mul(HVec3_y(np9_iv_nrm), np9_iv_push)),
  f64_add(load64(np9_iv_box_b + 16), f64_mul(HVec3_z(np9_iv_nrm), np9_iv_push)),
  F64_ONE, F64_ONE, F64_ONE);
assert_eq(mpr_intersect(&_mpr_sup_box, np9_iv_box_a, &_mpr_sup_box, np9_iv_moved), 0,
  "mpr_penetration: translating B by depth*normal separates the pair");
# ... and translating by a hundredth LESS must NOT separate it, so the depth is tight and
# not merely large enough.
var np9_iv_short = f64_mul(load64(np9_pn_d), f64_div(f64_from(99), f64_from(100)));
var np9_iv_near = _mpr_mkbox(f64_add(load64(np9_iv_box_b), f64_mul(HVec3_x(np9_iv_nrm), np9_iv_short)),
  f64_add(load64(np9_iv_box_b + 8), f64_mul(HVec3_y(np9_iv_nrm), np9_iv_short)),
  f64_add(load64(np9_iv_box_b + 16), f64_mul(HVec3_z(np9_iv_nrm), np9_iv_short)),
  F64_ONE, F64_ONE, F64_ONE);
assert_eq(mpr_intersect(&_mpr_sup_box, np9_iv_box_a, &_mpr_sup_box, np9_iv_near), 1,
  "mpr_penetration: 99% of the depth does NOT separate -- the depth is tight");

# --- ARENA BOUND. A narrowphase call must not scale its allocation with the
# iteration count: the pre-2.9.0 expansion allocated a fresh 16-byte record for
# every face on every pass and rebuilt two vecs per pass.
#
# 2.9.0: both bounds were 256 KB against true values of 51 KB and 22 KB — 5x
# and 11.5x headroom, which is far above the defect scale. Re-adding an
# alloc(80) per face per iteration (the SHAPE of the pre-2.9.0 per-face record)
# passed both. Measured on this tree, and IDENTICAL on five consecutive runs —
# alloc_used() over a fixed code path has no run-to-run variation, so the
# margins below are chosen against future legitimate change, not against noise:
#   gjk_epa_3d  63,032 B -> bound 65,536 (3.8% headroom) at 3.4.1; 52,272 B when the bound was
#               set, where injection read 108,272, 65% over it.
#   mpr_penetration 22,776 B -> bound 25,600 (12.4% headroom); injection reads
#               25,656 -- it clears the bound by only 56 B. This fixture runs
#               few enough iterations that the leak is worth only +12.6% here,
#               so 25,600 is the LOOSEST bound that still sees it at all; that
#               is why this margin is thinner than the others.
# [measured: CHANGELOG.md 2.9.1 for the mpr_penetration figures; the rest is a 2.9.0 scratch run, not in-tree]
#
# 2.9.1: THE THIN BOUND IS NOT REPAIRED BY A TIGHTER NUMBER. 0.22% of detection
# margin is a coin flip against any differently-shaped partial regression, and
# tightening 25,600 only trades that for false alarms on legitimate change. The
# fix is a fixture with MORE ITERATIONS -- see the mpr_penetration sphere-pair
# budget added beside the gjk_epa_3d one further down this file, where the same
# injection overshoots its bound by 123% instead of 0.22%. This absolute bound is
# KEPT as-is: it still guards the polytope regime, which the sphere pair does
# not exercise, and it is the row that carries the historical 22 KB figure.
# The baseline moved 22,752 -> 22,776 in 2.9.1: mpr_penetration now writes a
# placeholder normal on every path, and hvec3_unit_x() allocates one HVec3.
# [measured: CHANGELOG.md 2.9.1, the mpr_penetration arena bound (0.22% -> 123%); 22,752 is a scratch run]
var np9_ar_before = alloc_used();
gjk_epa_3d(&_mpr_sup_cyl, np9_cy_s, &_mpr_sup_obb, np9_cy_b, np9_pn_n2, np9_pn_d2);
var np9_ar_used = alloc_used() - np9_ar_before;
assert_lt(np9_ar_used, 65536, "gjk_epa_3d: arena per call stays under 64 KB (63,032 B)");
var np9_ar_before2 = alloc_used();
mpr_penetration(&_mpr_sup_box, np9_bb_a, &_mpr_sup_box, np9_bb_b, np9_pn_n, np9_pn_d);
assert_lt(alloc_used() - np9_ar_before2, 25600,
  "mpr_penetration: arena per call stays under 25 KB (22,776 B)");

# === 3.3.7: the collision rows (box-in-ball faces, shallow depths, end caps, corners) ===
# Every exact value below is a closed form evaluated in 80-digit Decimal from the f64
# inputs; every assertion fails on the 3.3.6 tree. The capsule support is the end along
# dir plus r dir, as tests/modules_b.tcyr's; spheres use _ga_sup_sphere, which counts.
# [measured: lane-CO co-probe t_fix.py and t_fix2.py on the 3.3.6 base and this tree, 2026-10-31; cycc 6.6.20]
test_group("gjk_epa_3d / mpr_penetration: the 3.3.7 collision rows");
fn _c37_sup_cap(shape, dir) {
    _ga_sup_calls = _ga_sup_calls + 1;
    var c = hvec3_new(load64(shape), load64(shape + 8), load64(shape + 16));
    var a = hvec3_new(load64(shape + 24), load64(shape + 32), load64(shape + 40));
    var p = hvec3_add(c, a);
    if (f64_lt(hvec3_dot(dir, a), 0) == 1) { p = hvec3_sub(c, a); }
    return hvec3_add(p, hvec3_scale(hvec3_normalize(dir), load64(shape + 48)));
}
fn _c37_mkcap(cx, cy, cz, ax, ay, az, r) {
    var s = alloc(56);
    store64(s, cx); store64(s + 8, cy); store64(s + 16, cz);
    store64(s + 24, ax); store64(s + 32, ay); store64(s + 40, az); store64(s + 48, r);
    return s;
}
var _c37_n = alloc(8);
var _c37_d = alloc(8);
# A box concentric with a ball (the roadmap's pair): every face normal of the dilated box
# is a local minimum of h, and 3.3.6 stopped at the second-thinnest, R + h_mid =
# 12.906699824523578. Exact R + h_min = 12.894227117761449 (0x4029C9D82303F6AA); the
# answer is an upper bound 17 ulp above it, along +x, the thinnest axis.
# [measured: lane-CO co-probe t_fix.py, 80-digit Decimal oracle, 3.3.6 base and this tree, 2026-10-31; cycc 6.6.20]
var _c37_bx = _ga_mkobb(0xBFE11889B3A631E6, 0x3FD9DA07E939DA64, 0xBFDAAD9503B36EF8, 0x3FAFAF24B4AE3B09,
  0x3FB308FBA5F9E2C3, 0x401C34E4BDE10586, 0, 0, 0, F64_ONE);
var _c37_bl = hvec4_new(0xBFE11889B3A631E6, 0x3FD9DA07E939DA64, 0xBFDAAD9503B36EF8, 0x4029AA28FE4F486F);
assert_eq(gjk_epa_3d(&_ga_sup_obb, _c37_bx, &_ga_sup_sphere, _c37_bl, _c37_n, _c37_d), 1,
  "gjk_epa_3d: a box concentric with a ball is a contact");
assert_eq(load64(_c37_d), 0x4029C9D82303F6BB, "gjk_epa_3d: ... at R + h_min (3.3.6: R + h_mid, 0x4029D03AF59B3C44)");
assert_eq(HVec3_x(load64(_c37_n)), F64_ONE, "gjk_epa_3d: ... along +x, the thinnest axis (3.3.6: y)");
# A capsule/sphere pair 1.1995e-12 deep (the roadmap's worst): EPA's certificate closed at
# 1e-10 of the shape, and mpr_penetration answered 5.8716e-10, 490x; the other order
# 4.5248e-11 from gjk_epa_3d, and this order a miss.
# [measured: lane-CO co-probe t_fix.py, 80-digit Decimal oracle, 3.3.6 base and this tree, 2026-10-31; cycc 6.6.20]
var _c37_cp = _c37_mkcap(0xBFD0FBAD4706B994, 0xBFEB1D8981B21794, 0xBFB888D305897130, 0xBFEF931CE85D7103,
  0xBFE39028303E5122, 0xBFEA53A55271639C, 0x3FEE121D8D91B466);
var _c37_sp = hvec4_new(0x3FF2EF3E6B7D075E, 0xBFFDDB253F4663AC, 0xBFF1976CD6009E13, 0x3FF188C48375A7E4);
assert_eq(mpr_penetration(&_c37_sup_cap, _c37_cp, &_ga_sup_sphere, _c37_sp, _c37_n, _c37_d), 1,
  "mpr_penetration: a capsule/sphere pair 1.2e-12 deep is a contact");
# ⭐ 3.4.0 — where these pins moved, the new value was checked against the same closed forms
# (80-digit Decimal from the f64 inputs); each message keeps the 3.3.7 value it replaces.
# [measured: lane-CO fixB.py, exact oracles, 3.3.7 base and this tree, 2026-10-31; cycc 6.7.9]
assert_eq(load64(_c37_d), 0x3D751C4000000000,
  "mpr_penetration: ... depth 1.19998e-12, 1.2 ulp(M) off (lane CO: 1.19971e-12; 3.3.7: 1.20010e-12; 3.3.6: 490x)");
assert_eq(gjk_epa_3d(&_ga_sup_sphere, _c37_sp, &_c37_sup_cap, _c37_cp, _c37_n, _c37_d), 1,
  "gjk_epa_3d: ... a contact in the other order");
assert_eq(load64(_c37_d), 0x3D751C4000000000,
  "gjk_epa_3d: ... depth 1.19998e-12, 1.0004x (lane CO: 1.19954e-12; 3.3.7: 1.19971e-12; 3.3.6: 37.7x)");
assert_eq(gjk_epa_3d(&_c37_sup_cap, _c37_cp, &_ga_sup_sphere, _c37_sp, _c37_n, _c37_d), 1,
  "gjk_epa_3d: ... and in this order (3.3.6: a miss)");
# A pair whose polytope's lower bound read above its upper one (a sliver face's rounding):
# exact depth 1.676993e-12, 3.3.6 2.3054e-11 (13.7x).
# [measured: lane-CO co-probe t_fix.py, 80-digit Decimal oracle, 3.3.6 base and this tree, 2026-10-31; cycc 6.6.20]
var _c37_cq = _c37_mkcap(0x3FEE8809AE443320, 0x3FE5A1A5BE6F74B2, 0x3FDC89138F1A1A40, 0xBFECA66F100A8F3F,
  0x3FE76B66FC5F8AAD, 0xBFCC09EE4577364C, 0x3FD85D7B8547C747);
var _c37_sq = hvec4_new(0x3FF02BD53A433FD0, 0x40033D22EAFC4984, 0xBF879373E3F2B5A0, 0x3FF04558327B51F7);
assert_eq(mpr_penetration(&_ga_sup_sphere, _c37_sq, &_c37_sup_cap, _c37_cq, _c37_n, _c37_d), 1,
  "mpr_penetration: a sliver-bound capsule/sphere pair is a contact");
assert_eq(load64(_c37_d), 0x3D7D80F200000000,
  "mpr_penetration: ... depth 1.677091e-12, 0.22 ulp(M) off [CO6: was 0x3D7D844000000000, 1.9 ulp(M) off]");
# An end-cap overlap 1.19997e-12 deep (the roadmap's sample), missed by all four entry
# points in both orders in 3.3.6: no portal is built and the distance query's tetrahedron
# does not clear its margins; a ring round the normal EPA finds does.
# [measured: lane-CO co-probe t_fix.py, 80-digit Decimal oracle, 3.3.6 base and this tree, 2026-10-31; cycc 6.6.20]
var _c37_cc = _c37_mkcap(0x3FDE58E76BCB5D0C, 0x3FDA1288C2129D30, 0x3FE2C4E197B5003A, 0x3FF9B7BC0A658B2F,
  0xBFE25D1A6A71A46A, 0x3FE6F26E1A3A0A16, 0x3FF158071624A44D);
var _c37_sc = hvec4_new(0x400955BE53E03EE1, 0x3FF30FB2A16B4BD4, 0x3FF935B51250D8BB, 0x3FE59D2FCA996935);
assert_eq(gjk_intersect_3d(&_c37_sup_cap, _c37_cc, &_ga_sup_sphere, _c37_sc), 1,
  "gjk_intersect_3d: an end cap 1.2e-12 into a sphere is a contact (3.3.6: a miss)");
assert_eq(gjk_intersect_3d(&_ga_sup_sphere, _c37_sc, &_c37_sup_cap, _c37_cc), 1,
