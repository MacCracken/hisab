test_group("geo: SDF");

# SDF sphere: (3,0,0), center=origin, r=1 -> d = 2
var g_sdf_s = sdf_sphere(hvec3_new(f64_from(3), 0, 0), hvec3_zero(), F64_ONE);
assert_eq(f64_to(g_sdf_s), 2, "sdf sphere outside");

# SDF sphere inside: (0,0,0), center=origin, r=2 -> d = -2
var g_sdf_si = sdf_sphere(hvec3_zero(), hvec3_zero(), F64_TWO);
assert_eq(f64_to(g_sdf_si), (0 - 2), "sdf sphere inside");

# SDF box: point at (3,0,0), center=origin, half=(1,1,1) -> d = 2
var g_sdf_b = sdf_box(hvec3_new(f64_from(3), 0, 0), hvec3_zero(),
hvec3_new(F64_ONE, F64_ONE, F64_ONE));
assert_eq(f64_to(g_sdf_b), 2, "sdf box outside");

# CSG union
assert_eq(f64_to(sdf_union(f64_from(3), f64_from(5))), 3, "sdf union");
# CSG intersection
assert_eq(f64_to(sdf_intersection(f64_from(3), f64_from(5))), 5, "sdf intersection");
# CSG subtraction: max(3, -5) = 3
assert_eq(f64_to(sdf_subtraction(f64_from(3), f64_from(5))), 3, "sdf subtraction");

# ================================================================
# CALC — derivatives, integration, bezier, catmull-rom, easing (~25)
# ================================================================
test_group("calc: derivative");

# d/dx(x^2) at x=3, h=1 central diff: (16-4)/2 = 6
var c_deriv_x2 = calc_derivative(&_tc_x2, f64_from(3), F64_ONE);
assert_eq(f64_to(c_deriv_x2), 6, "deriv x^2 at 3");

# d/dx(sin) at 0 with small h: should be ~cos(0)=1
var c_deriv_sin = calc_derivative(&_tc_sin, 0, f64_from(1));
# central diff (sin(1) - sin(-1))/2 = sin(1)/1 ... approximate
var c_ds_r = f64_to(f64_round(f64_mul(c_deriv_sin, f64_from(1000))));
assert_eq(c_ds_r, 841, "deriv sin at 0 *1000 ~ 841");

# d/dx(const) = 0
var c_deriv_c = calc_derivative(&_tc_const, F64_ONE, F64_ONE);
assert_eq(f64_to(c_deriv_c), 0, "deriv const = 0");

# ----------------------------------------------------------------
test_group("calc: simpson integration");

# EXACT WHERE THE RULE IS EXACT, TIGHT WHERE IT IS NOT.
# The assertions here through 2.7.x quantised the result through f64_to/f64_round
# and so certified almost nothing: round(3I) == 1 accepts I in [1/6, 1/2), i.e.
# -50%/+50% on 1/3; trunc(I) == 7 accepts [7, 8) (+14.3%); round(I) == 2 accepts
# [1.5, 2.5) (+/-25%). No tolerance-based Simpson assertion existed anywhere.
#
# Simpson's rule is EXACT for every polynomial of degree <= 3, and 4th-order
# otherwise: int - S = -(b-a) h^4 f''''(xi) / 180. Each case below runs on a
# dyadic grid -- n = 64 gives h = 2^-6 on [0,1] and h = 2^-5 on [0,2] -- so every
# node i*h, every f(x_i), every weighted term (the weights 4 and 2 are powers of
# two) and every partial sum is an exactly representable dyadic well inside 2^53.
# The ONLY rounding in the whole computation is the closing divide by 3, which is
# correctly rounded. The polynomial answers are therefore bit-exact and are
# asserted as bit patterns; every constant below is the closed-form value, not a
# recorded output.
var c_int_out = alloc(8);

# degree 0: int(7, 0, 1) = 7. T = 7*(2 + 4*32 + 2*31) = 1344, T*h = 21, 21/3 = 7.
var c_rc = calc_integral_simpson(&_tc_const, 0, F64_ONE, 64, c_int_out);
assert_eq(c_rc, 0, "simpson ok");
assert_eq(load64(c_int_out), 0x401C000000000000, "simpson deg-0: int(7,0,1) is 7.0 bit-exact");

# degree 1: int(x, 0, 2) = 2. T = 192, T*h = 6, 6/3 = 2.
calc_integral_simpson(&_tc_linear, 0, F64_TWO, 64, c_int_out);
assert_eq(load64(c_int_out), 0x4000000000000000, "simpson deg-1: int(x,0,2) is 2.0 bit-exact");

# degree 2: int(x^2, 0, 1) = 1/3. T = 64 exactly, T*h = 1.0, and 1.0/3.0 is the
# correctly rounded fl(1/3) = 0x3FD5555555555555.
calc_integral_simpson(&_tc_x2, 0, F64_ONE, 64, c_int_out);
assert_eq(load64(c_int_out), 0x3FD5555555555555, "simpson deg-2: int(x^2,0,1) is fl(1/3) bit-exact");

# degree 3 -- the defining property. int(x^3 - 2x^2 + 3x - 4, 0, 2)
#           = 4 - 16/3 + 6 - 8 = -10/3. T = -320, T*h = -10, fl(-10/3).
calc_integral_simpson(&_tc_cubic, 0, F64_TWO, 64, c_int_out);
assert_eq(load64(c_int_out), 0xC00AAAAAAAAAAAAB, "simpson deg-3: int(cubic,0,2) is fl(-10/3) bit-exact");

# degree 4 -- where the rule stops being exact, and by exactly how much. f'''' is
# constant for a quartic, so Euler-Maclaurin is an identity, not an estimate:
#   S_n = int + (b-a) h^4 f''''/180 = 1/5 + 24 h^4/180 = 1/5 + 2 h^4/15.
# h = 2^-6 gives 2/(15*2^24) = 7.947285970052083e-09, so the rule must return
# 0.20000000794728598 = 0x3FC99999AAAAAAAB -- provably NOT 0.2.
calc_integral_simpson(&_tc_x4, 0, F64_ONE, 64, c_int_out);
assert_eq(load64(c_int_out), 0x3FC99999AAAAAAAB, "simpson deg-4: int(x^4,0,1) is fl(1/5 + 2h^4/15)");
var c_q_dev = f64_sub(load64(c_int_out), 0x3FC999999999999A);   # minus fl(0.2)
assert(f64_gt(c_q_dev, 0x3E410D0FA854A07E) == 1, "simpson deg-4 error term > 7.94e-9");
assert(f64_lt(c_q_dev, 0x3E41128F084CFED7) == 1, "simpson deg-4 error term < 7.95e-9");

# The n=100 shape the old assertions used. h = fl(1/100) is not dyadic, so the
# nodes and node values round -- yet x^2 still lands under one ulp of 1/3.
calc_integral_simpson(&_tc_x2, 0, F64_ONE, 100, c_int_out);
var c_int_err = f64_abs(f64_sub(load64(c_int_out), 0x3FD5555555555555));
assert(f64_lt(c_int_err, 0x3C9CD2B297D889BC) == 1, "simpson x^2 n=100 within 1e-16 of 1/3 (< 2 ulp)");

# 1000 subintervals. The Neumaier compensation in the accumulator is what holds
# these two to zero error: deleting it costs 2 ulp at n=100 and 3 ulp here, so
# this pair is also the only regression test the compensated sum has.
calc_integral_simpson(&_tc_x2, 0, F64_ONE, 1000, c_int_out);
var c_int_err_k = f64_abs(f64_sub(load64(c_int_out), 0x3FD5555555555555));
assert(f64_lt(c_int_err_k, 0x3C9CD2B297D889BC) == 1, "simpson x^2 n=1000 within 1e-16 of 1/3");

# NON-POLYNOMIAL, so the rule is genuinely inexact: int(1/(1+x), 0, 1) = ln 2.
# 1/(1+x) on a dyadic grid is one correctly rounded IEEE divide, so the rule's
# value is computable in exact rational arithmetic independently of this library:
# S_64 = 0.6931471824214548 (0x3FE62E42FFFA11FA), S_32 = 0.693147210289823.
var c_ln2_64 = alloc(8);
calc_integral_simpson(&_tc_inv1p, 0, F64_ONE, 64, c_ln2_64);
var c_s64_err = f64_abs(f64_sub(load64(c_ln2_64), 0x3FE62E42FFFA11FA));
assert(f64_lt(c_s64_err, 0x3CD203AF9EE75616) == 1, "simpson 1/(1+x) n=64 hits exact rule value to 1e-15");

# 4th-order convergence: halving h must cut the error by 16. The exact-rational
# prediction is e(32)/e(64) = 15.9708437; the trapezoid rule would give ~4, and a
# mis-weighted Simpson gives O(1). e(64) itself is pinned to the h^4 term,
# (h^4/180)*(f'''(1) - f'''(0)) = 0.03125*h^4 = 1.8626e-09.
var c_ln2_32 = alloc(8);
calc_integral_simpson(&_tc_inv1p, 0, F64_ONE, 32, c_ln2_32);
var c_e64 = f64_abs(f64_sub(load64(c_ln2_64), 0x3FE62E42FEFA39EF));   # fl(ln 2)
var c_e32 = f64_abs(f64_sub(load64(c_ln2_32), 0x3FE62E42FEFA39EF));
assert(f64_gt(c_e64, 0x3E1EEC7BD512B572) == 1, "simpson n=64 error > 1.8e-9 (h^4 term is real)");
assert(f64_lt(c_e64, 0x3E20C01868BF779E) == 1, "simpson n=64 error < 1.95e-9");
var c_ratio = f64_div(c_e32, c_e64);
assert(f64_gt(c_ratio, 0x402FCCCCCCCCCCCD) == 1, "simpson 4th order: e(32)/e(64) > 15.9");
assert(f64_lt(c_ratio, 0x40300CCCCCCCCCCD) == 1, "simpson 4th order: e(32)/e(64) < 16.05");

# a != 0 -- THE GAP ADVERSARIAL REVIEW FOUND. Every case above starts at a = 0,
# so two independent a-drop mutants survived the whole block:
#   h  = (b - a)/n  ->  b/n          (step size ignores the lower limit)
#   xi = a + i*h    ->  i*h          (nodes ignore the lower limit)
# Both are silent when a == 0. On [1,3] with n = 64 the step is 2^-5, still
# dyadic, so these stay bit-exact: int(x^2,1,3) = 26/3 and int(x^3,1,3) = 20.
# Under the xi a-drop the first becomes int(x^2,0,2) = 8/3 -- off by 3x.
calc_integral_simpson(&_tc_x2, F64_ONE, f64_from(3), 64, c_int_out);
assert_eq(load64(c_int_out), 0x4021555555555555, "simpson a!=0 deg-2: int(x^2,1,3) is fl(26/3)");
calc_integral_simpson(&_tc_cubic_pure, F64_ONE, f64_from(3), 64, c_int_out);
assert_eq(load64(c_int_out), 0x4034000000000000, "simpson a!=0 deg-3: int(x^3,1,3) is 20.0 bit-exact");

# ----------------------------------------------------------------
test_group("calc: gauss-legendre");

# Gauss5 on x^2 from 0 to 1 = 1/3
var c_gl = calc_integral_gauss5(&_tc_x2, 0, F64_ONE);
var c_gl_3 = f64_to(f64_round(f64_mul(c_gl, f64_from(3))));
assert_eq(c_gl_3, 1, "gauss5 x^2 = 1/3");

# Gauss5 on const 7 from 0 to 1 = 7
var c_gl_c = calc_integral_gauss5(&_tc_const, 0, F64_ONE);
assert_eq(f64_to(f64_round(c_gl_c)), 7, "gauss5 const=7");

# TOLERANCE, not rounding. The two assertions above compare f64_round(...) to an
# integer, which permits +/-0.5 absolute -- 7.1% relative on the const-7 case. All
# nine Gauss-Legendre node/weight constants were mis-transcribed through 2.6.11
# (weights summed to 2.000492 instead of 2) and both assertions stayed green.
# 5-point Gauss-Legendre is EXACT for polynomials of degree <= 9, so demand it.
var c_gl_err = f64_abs(f64_sub(c_gl, f64_div(F64_ONE, f64_from(3))));
assert(f64_lt(c_gl_err, f64_div(F64_ONE, f64_from(100000000000))) == 1,
"gauss5: x^2 exact to 1e-11 (degree 2 << 9)");
var c_gl_c_err = f64_abs(f64_sub(c_gl_c, f64_from(7)));
assert(f64_lt(c_gl_c_err, f64_div(F64_ONE, f64_from(100000000000))) == 1,
"gauss5: const 7 exact to 1e-11");
# The weights must sum to 2 (integral of 1 over [-1,1]); on [0,1] that is 1.
var c_gl_one = calc_integral_gauss5(&_tc_one, 0, F64_ONE);
assert(f64_lt(f64_abs(f64_sub(c_gl_one, F64_ONE)), f64_div(F64_ONE, f64_from(1000000000000))) == 1,
"gauss5: weights sum correctly (integral of 1 over [0,1] = 1)");

# ----------------------------------------------------------------
test_group("calc: bezier");

# Quadratic bezier endpoints: B(0)=p0, B(1)=p2
var c_bz_p0 = hvec2_new(0, 0);
var c_bz_p1 = hvec2_new(F64_ONE, F64_TWO);
var c_bz_p2 = hvec2_new(F64_TWO, 0);

var c_bz0 = calc_bezier_quad_2d(c_bz_p0, c_bz_p1, c_bz_p2, 0);
assert_eq(f64_to(HVec2_x(c_bz0)), 0, "bezier t=0 x");
assert_eq(f64_to(HVec2_y(c_bz0)), 0, "bezier t=0 y");

var c_bz1 = calc_bezier_quad_2d(c_bz_p0, c_bz_p1, c_bz_p2, F64_ONE);
assert_eq(f64_to(HVec2_x(c_bz1)), 2, "bezier t=1 x");
assert_eq(f64_to(HVec2_y(c_bz1)), 0, "bezier t=1 y");

# Straight line bezier: all points on x-axis
var c_bz_s0 = hvec2_new(0, 0);
var c_bz_s1 = hvec2_new(F64_ONE, 0);
var c_bz_s2 = hvec2_new(F64_TWO, 0);
var c_bz_mid = calc_bezier_quad_2d(c_bz_s0, c_bz_s1, c_bz_s2, F64_HALF);
assert_eq(f64_to(HVec2_x(c_bz_mid)), 1, "bezier straight mid x");
assert_eq(f64_to(HVec2_y(c_bz_mid)), 0, "bezier straight mid y");

# ----------------------------------------------------------------
test_group("calc: catmull-rom");

# Catmull-Rom passes through p1 at t=0 and p2 at t=1
var c_cr_p0 = hvec3_new(0, 0, 0);
var c_cr_p1 = hvec3_new(F64_ONE, F64_ONE, 0);
var c_cr_p2 = hvec3_new(F64_TWO, F64_TWO, 0);
var c_cr_p3 = hvec3_new(f64_from(3), f64_from(3), 0);

var c_cr_0 = calc_catmull_rom(c_cr_p0, c_cr_p1, c_cr_p2, c_cr_p3, 0);
assert_eq(f64_to(HVec3_x(c_cr_0)), 1, "catmull t=0 x");
assert_eq(f64_to(HVec3_y(c_cr_0)), 1, "catmull t=0 y");

var c_cr_1 = calc_catmull_rom(c_cr_p0, c_cr_p1, c_cr_p2, c_cr_p3, F64_ONE);
assert_eq(f64_to(HVec3_x(c_cr_1)), 2, "catmull t=1 x");
assert_eq(f64_to(HVec3_y(c_cr_1)), 2, "catmull t=1 y");

# The four assertions above were the WHOLE of this function's coverage through
# 2.8.2, and they are the weakest fixture available for it: at t = 0 the t, t^2
# and t^3 terms all vanish; at t = 1 the four coefficients telescope to 2*p2;
# and on collinear EQUALLY-SPACED points coeff2 = 2a - 5b + 4c - d and
# coeff3 = -a + 3b - 3c + d are both identically zero. Deleting term2 and term3
# from _cmr_comp kept the suite green.
#
# Non-collinear, non-uniform control points, evaluated where the cubic terms
# carry real weight. The reference is the closed form, NOT the implementation:
#   q(1/2) = (-p0 + 9 p1 + 9 p2 - p3) / 16        (Catmull-Rom midpoint identity)
#   q(1/4) = (-9 p0 + 111 p1 + 29 p2 - 3 p3) / 128
# Both come out exact dyadic rationals for these coordinates, and replaying
# _cmr_comp's own operation order in IEEE-754 reproduces them bit-for-bit
# (python3: 7/4, 87/64, 11/8, 59/32, -1/8, -3/32), so these are EXACT equalities
# rather than tolerance bands.
var c_cr_q0 = hvec3_new(0, 0, F64_ONE);
var c_cr_q1 = hvec3_new(F64_ONE, F64_TWO, 0);
var c_cr_q2 = hvec3_new(f64_from(3), F64_ONE, 0);
var c_cr_q3 = hvec3_new(f64_from(8), f64_from(5), F64_ONE);

var c_cr_h = calc_catmull_rom(c_cr_q0, c_cr_q1, c_cr_q2, c_cr_q3, F64_HALF);
assert_eq(HVec3_x(c_cr_h), f64_div(f64_from(7), f64_from(4)),
"catmull t=1/2 x = 7/4 exactly");
assert_eq(HVec3_y(c_cr_h), f64_div(f64_from(11), f64_from(8)),
"catmull t=1/2 y = 11/8 exactly");
assert_eq(HVec3_z(c_cr_h), f64_neg(f64_div(F64_ONE, f64_from(8))),
"catmull t=1/2 z = -1/8 exactly");

var c_cr_q = calc_catmull_rom(c_cr_q0, c_cr_q1, c_cr_q2, c_cr_q3,
f64_div(F64_ONE, f64_from(4)));
assert_eq(HVec3_x(c_cr_q), f64_div(f64_from(87), f64_from(64)),
"catmull t=1/4 x = 87/64 exactly");
assert_eq(HVec3_y(c_cr_q), f64_div(f64_from(59), f64_from(32)),
"catmull t=1/4 y = 59/32 exactly");
assert_eq(HVec3_z(c_cr_q), f64_neg(f64_div(f64_from(3), f64_from(32))),
"catmull t=1/4 z = -3/32 exactly");

# Endpoint interpolation on the non-collinear fixture too -- that is the
# property which makes this a Catmull-Rom spline rather than a Bezier.
assert_eq(HVec3_y(calc_catmull_rom(c_cr_q0, c_cr_q1, c_cr_q2, c_cr_q3, 0)), F64_TWO,
"catmull t=0 interpolates p1 exactly (non-collinear)");
assert_eq(HVec3_x(calc_catmull_rom(c_cr_q0, c_cr_q1, c_cr_q2, c_cr_q3, F64_ONE)),
f64_from(3), "catmull t=1 interpolates p2 exactly (non-collinear)");

# ----------------------------------------------------------------
test_group("calc: easing");

# ease_in: t^2
assert_eq(f64_to(ease_in(0)), 0, "ease_in(0)");
assert_eq(f64_to(ease_in(F64_ONE)), 1, "ease_in(1)");

# ease_out: t*(2-t)
assert_eq(f64_to(ease_out(0)), 0, "ease_out(0)");
assert_eq(f64_to(ease_out(F64_ONE)), 1, "ease_out(1)");

# ease_in_out: t^2*(3-2t)
assert_eq(f64_to(ease_in_out(0)), 0, "ease_in_out(0)");
assert_eq(f64_to(ease_in_out(F64_ONE)), 1, "ease_in_out(1)");

# ease_in_cubic: t^3
assert_eq(f64_to(ease_in_cubic(0)), 0, "ease_in_cubic(0)");
assert_eq(f64_to(ease_in_cubic(F64_ONE)), 1, "ease_in_cubic(1)");

# ease_out_cubic: 1-(1-t)^3
assert_eq(f64_to(ease_out_cubic(0)), 0, "ease_out_cubic(0)");
assert_eq(f64_to(ease_out_cubic(F64_ONE)), 1, "ease_out_cubic(1)");

# ease_in_out_smooth (smootherstep)
assert_eq(f64_to(ease_in_out_smooth(0)), 0, "smootherstep(0)");
assert_eq(f64_to(ease_in_out_smooth(F64_ONE)), 1, "smootherstep(1)");

