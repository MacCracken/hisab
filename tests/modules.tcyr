# All helper functions must be defined before alloc_init() to avoid
# compiler pass ordering issues with the permutation table init in Perlin noise.
# ~1e-8 — for assertions on transcendental / iterative results where exact
# bit equality is not achievable but 8 significant digits is.
var LOOSE_TOL_M = 0x3E45798EE2308C3A;
# ~1e-15 -- a few ulp of 1.0, for quantities whose closed form is exactly 0 or 1
# (group-inverse round-trips, traceless generators, Euler's identity). Measured
# floor for all of them on 6.5.6 is <= 2.3e-16. Replaces a literal f64_from(1),
# which is a tolerance of 1.0 and admits everything in [0, 2].
var ULP_TOL_M = 0x3CD203AF9EE75616;
var TOL_1EM14 = 0x3D06849B86A12B9B;  # 1e-14
var TOL_1EM12 = 0x3D719799812DEA11;  # 1e-12 (== EPSILON_F64)  # 1e-15
# ~1e-13 -- for the Minkowski interval of (5,3,0,0), whose magnitude is 16 and
# whose measured boost drift is 7.105e-15 (4 ulp of 16).
var IVL_TOL_M = 0x3D3C25C268497682;  # 1e-13

fn _tc_x2(x) { return f64_mul(x, x); }
fn _tc_sin(x) { return f64_sin(x); }
fn _tc_cos(x) { return f64_cos(x); }
fn _tc_exp(x) { return f64_exp(x); }
fn _tc_const(x) { return f64_from(7); }
fn _tc_one(x) { return F64_ONE; }
fn _tc_linear(x) { return x; }
fn _tc_cubic(x) {
    var cx2 = f64_mul(x, x);
    var cx3 = f64_mul(cx2, x);
    var ct1 = f64_sub(cx3, f64_mul(F64_TWO, cx2));
    var ct2 = f64_add(ct1, f64_mul(f64_from(3), x));
    return f64_sub(ct2, f64_from(4));
}
fn _tc_x4(x) { var qx2 = f64_mul(x, x); return f64_mul(qx2, qx2); }
fn _tc_inv1p(x) { return f64_div(F64_ONE, f64_add(F64_ONE, x)); }
fn _tc_cubic_pure(x) { return f64_mul(x, f64_mul(x, x)); }
fn _tn_f(x) { return f64_sub(f64_mul(x, x), F64_TWO); }
fn _tn_df(x) { return f64_mul(F64_TWO, x); }
fn _tn_cube_f(x) { return f64_sub(f64_mul(x, f64_mul(x, x)), f64_from(8)); }
fn _tn_cube_df(x) { return f64_mul(f64_from(3), f64_mul(x, x)); }
fn _tn_lin_f(x) { return f64_sub(x, f64_from(5)); }
fn _tn_lin_df(x) { return F64_ONE; }
fn _tn_sin_f(x) { return f64_sin(x); }
fn _tn_sin_df(x) { return f64_cos(x); }

# Sum of 2x signed areas over a flat triangle-index list (triplets) into points
# p — used to check a triangulation tiles its polygon (|sum| == polygon |2xarea|).
fn _tp_area2x(p, t) {
    var s = 0;
    var k = 0;
    var m = vec_len(t);
    while (k < m) {
        var a = vec_get(p, vec_get(t, k));
        var b = vec_get(p, vec_get(t, k + 1));
        var c = vec_get(p, vec_get(t, k + 2));
        s = f64_add(s, _col_triangle_area_2x(HVec2_x(a), HVec2_y(a),
        HVec2_x(b), HVec2_y(b), HVec2_x(c), HVec2_y(c)));
        k = k + 3;
    }
    return s;
}

# Count points strictly inside any output triangle's circumcircle — the
# Delaunay empty-circumcircle property holds iff this is 0. Reuses the same
# winding-aware predicate the algorithm uses; cocircular points are not strictly
# inside, so they don't count. t = flat CCW triple-list into points p.
fn _dl_violations(p, n, t) {
    var viol = 0;
    var nt = vec_len(t) / 3;
    var ti = 0;
    while (ti < nt) {
        var a = vec_get(t, ti * 3);
        var b = vec_get(t, ti * 3 + 1);
        var c = vec_get(t, ti * 3 + 2);
        var j = 0;
        while (j < n) {
            var skip = 0;
            if (j == a) { skip = 1; }
            if (j == b) { skip = 1; }
            if (j == c) { skip = 1; }
            if (skip == 0) {
                var pj = vec_get(p, j);
                var ic = _col_in_circumcircle(p, a, b, c, HVec2_x(pj), HVec2_y(pj));
                if (ic == 1) { viol = viol + 1; }
            }
            j = j + 1;
        }
        ti = ti + 1;
    }
    return viol;
}

# Push a triangle (index triple) onto a flat triangle vec.
fn _he_tri(t, a, b, c) { vec_push(t, a); vec_push(t, b); vec_push(t, c); return 0; }

# Count boundary vertices of a half-edge mesh over vertices 0..nv-1.
fn _he_boundary_sum(m, nv) {
    var s = 0;
    var v = 0;
    while (v < nv) {
        s = s + halfedge_is_boundary(m, v);
        v = v + 1;
    }
    return s;
}

# MPR support functions. Sphere: shape = HVec4 (cx,cy,cz, radius);
# support(dir) = center + radius * normalize(dir).
fn _mpr_sup_sphere(shape, dir) {
    var c = hvec3_new(HVec4_x(shape), HVec4_y(shape), HVec4_z(shape));
    var dn = hvec3_normalize(dir);
    return hvec3_add(c, hvec3_scale(dn, HVec4_w(shape)));
}

# Axis-aligned box: shape = 6 f64 [cx,cy,cz, hx,hy,hz]; per-axis far corner.
fn _mpr_box_axis(c, h, d) {
    if (f64_lt(d, 0) == 1) { return f64_sub(c, h); }
    return f64_add(c, h);
}
fn _mpr_sup_box(shape, dir) {
    var rx = _mpr_box_axis(load64(shape), load64(shape + 24), HVec3_x(dir));
    var ry = _mpr_box_axis(load64(shape + 8), load64(shape + 32), HVec3_y(dir));
    var rz = _mpr_box_axis(load64(shape + 16), load64(shape + 40), HVec3_z(dir));
    return hvec3_new(rx, ry, rz);
}
fn _mpr_mkbox(cx, cy, cz, hx, hy, hz) {
    var s = alloc(48);
    store64(s, cx);
    store64(s + 8, cy);
    store64(s + 16, cz);
    store64(s + 24, hx);
    store64(s + 32, hy);
    store64(s + 40, hz);
    return s;
}

# Elementwise Hermiticity test: A[i][j] == conj(A[j][i]) for EVERY (i,j),
# checked on the raw components. Deliberately does NOT go through
# cmat_adjoint: that writes r[j][i] = cx_conj(m[i][j]) and cx_conj copies the
# real part unchanged, so "Re(A[0][0]) == Re(adjoint(A)[0][0])" is an identity
# for every complex matrix ever built. Returns 1 (Hermitian) or 0.
# At i == j the Im test becomes Im + Im == 0, i.e. the diagonal must be real.
# f64_eq is IEEE equality, so +0.0 and -0.0 compare equal (cx_conj turns the
# +0.0 imaginary parts of the real generators into -0.0).
fn _gm_is_herm(m) {
    var n = cmat_rows(m);
    var i = 0;
    while (i < n) {
        var j = 0;
        while (j < n) {
            var a = cmat_get(m, i, j);
            var b = cmat_get(m, j, i);
            if (f64_eq(HComplex_re(a), HComplex_re(b)) == 0) { return 0; }
            if (f64_eq(f64_add(HComplex_im(a), HComplex_im(b)), 0) == 0) { return 0; }
            j = j + 1;
        }
        i = i + 1;
    }
    return 1;
}

# Brute-force reference for kdtree_within_radius.
fn _kdv_brute(points, n, query, radius) {
    var rsq = f64_mul(radius, radius);
    var c = 0;
    var i = 0;
    while (i < n) {
        var p = load64(points + i * 8);
        var dx = f64_sub(HVec3_x(p), HVec3_x(query));
        var dy = f64_sub(HVec3_y(p), HVec3_y(query));
        var dz = f64_sub(HVec3_z(p), HVec3_z(query));
        var d2 = f64_add(f64_add(f64_mul(dx, dx), f64_mul(dy, dy)), f64_mul(dz, dz));
        if (f64_gt(d2, rsq) == 0) { c = c + 1; }
        i = i + 1;
    }
    return c;
}

# Walk the tree and count points that sit on the WRONG side of their ancestor's
# pruning plane. This is the invariant the whole query algorithm rests on:
# every point in a left subtree has axis <= split_val, every point on the right
# has axis >= split_val. Returns the violation count.
fn _kdv_side_bad(node, points, axis, plane, want_le) {
    if (node == 0) { return 0; }
    var bad = 0;
    var pidx = _kd_node_point_idx(node);
    if (pidx != 0 - 1) {
        var pt = load64(points + pidx * 8);
        var v = _kd_axis_val(pt, axis);
        if (want_le == 1) {
            if (f64_gt(v, plane) == 1) { bad = 1; }
        } else {
            if (f64_lt(v, plane) == 1) { bad = 1; }
        }
        return bad;
    }
    bad = bad + _kdv_side_bad(_kd_node_left(node), points, axis, plane, want_le);
    bad = bad + _kdv_side_bad(_kd_node_right(node), points, axis, plane, want_le);
    return bad;
}

fn _kdv_invariant_bad(node, points) {
    if (node == 0) { return 0; }
    if (_kd_node_point_idx(node) != 0 - 1) { return 0; }
    var axis = _kd_node_split_axis(node);
    var plane = _kd_node_split_val(node);
    var bad = _kdv_side_bad(_kd_node_left(node), points, axis, plane, 1);
    bad = bad + _kdv_side_bad(_kd_node_right(node), points, axis, plane, 0);
    bad = bad + _kdv_invariant_bad(_kd_node_left(node), points);
    bad = bad + _kdv_invariant_bad(_kd_node_right(node), points);
    return bad;
}

# dy/dt = y for the implicit integrators.
fn _cv_dydt_y(t, y) { return y; }
# SHO acceleration for leapfrog.
fn _cv_accel(q) { return f64_neg(q); }

alloc_init();

# ================================================================
# GEO — Primitives, intersections, closest-point, SDF (~30)
# ================================================================
test_group("geo: ray_at");

var g_ray = geo_ray_new(hvec3_new(F64_ONE, F64_TWO, f64_from(3)),
hvec3_unit_x());
var g_pt = geo_ray_at(g_ray, f64_from(5));
assert_eq(f64_to(HVec3_x(g_pt)), 6, "ray_at x");
assert_eq(f64_to(HVec3_y(g_pt)), 2, "ray_at y");
assert_eq(f64_to(HVec3_z(g_pt)), 3, "ray_at z");

# ----------------------------------------------------------------
test_group("geo: plane signed distance");

var g_plane = geo_plane_from_point_normal(hvec3_zero(), hvec3_unit_y());
var g_psd_pos = geo_plane_signed_distance(g_plane, hvec3_new(0, f64_from(3), 0));
assert_eq(f64_to(g_psd_pos), 3, "plane sd positive");

var g_psd_neg = geo_plane_signed_distance(g_plane, hvec3_new(0, f64_neg(f64_from(2)), 0));
assert_eq(f64_to(g_psd_neg), (0 - 2), "plane sd negative");

var g_psd_zero = geo_plane_signed_distance(g_plane, hvec3_zero());
assert_eq(f64_to(g_psd_zero), 0, "plane sd on-plane");

# ----------------------------------------------------------------
test_group("geo: aabb center and size");

var g_aabb_cs = geo_aabb_new(hvec3_new(f64_from(2), f64_from(4), f64_from(6)),
hvec3_new(f64_from(4), f64_from(8), f64_from(10)));
var g_center = geo_aabb_center(g_aabb_cs);
assert_eq(f64_to(HVec3_x(g_center)), 3, "aabb center.x");
assert_eq(f64_to(HVec3_y(g_center)), 6, "aabb center.y");
var g_size = geo_aabb_size(g_aabb_cs);
assert_eq(f64_to(HVec3_x(g_size)), 2, "aabb size.x");
assert_eq(f64_to(HVec3_z(g_size)), 4, "aabb size.z");

# ----------------------------------------------------------------
test_group("geo: ray-plane");

var g_rp_ray = geo_ray_new(hvec3_new(0, f64_from(5), 0), hvec3_new(0, f64_neg(F64_ONE), 0));
var g_rp_t = geo_ray_plane(g_rp_ray, g_plane);
assert_eq(f64_to(g_rp_t), 5, "ray-plane hit");

# Parallel ray (miss)
var g_rp_par = geo_ray_new(hvec3_new(0, f64_from(5), 0), hvec3_unit_x());
# 0, not the old -1. -1 as an f64 bit pattern is a NEGATIVE NaN, which the
# module header never promised and which poisons any arithmetic done on it.
assert_eq(geo_ray_plane(g_rp_par, g_plane), 0, "ray-plane parallel miss");

# Behind origin (negative t)
var g_rp_behind = geo_ray_new(hvec3_new(0, f64_neg(F64_ONE), 0), hvec3_new(0, f64_neg(F64_ONE), 0));
assert_eq(geo_ray_plane(g_rp_behind, g_plane), 0, "ray-plane behind");

# ----------------------------------------------------------------
test_group("geo: ray-sphere");

# Hit
var g_rs_ray = geo_ray_new(hvec3_zero(), hvec3_unit_z());
var g_rs_sph = geo_sphere_new(hvec3_new(0, 0, f64_from(5)), F64_ONE);
var g_rs_t = geo_ray_sphere(g_rs_ray, g_rs_sph);
assert_eq(f64_to(g_rs_t), 4, "ray-sphere hit t=4");

# Miss (perpendicular)
var g_rs_miss = geo_ray_new(hvec3_new(0, f64_from(10), 0), hvec3_unit_z());
assert_eq(geo_ray_sphere(g_rs_miss, g_rs_sph), 0, "ray-sphere miss");

# Inside sphere: origin inside, should get positive t for exit
var g_rs_inside = geo_ray_new(hvec3_new(0, 0, f64_from(5)), hvec3_unit_z());
var g_rs_t2 = geo_ray_sphere(g_rs_inside, g_rs_sph);
assert(g_rs_t2 != 0, "ray-sphere inside hit");
assert_eq(f64_to(g_rs_t2), 1, "ray-sphere inside t=1");

# Tangent: origin at distance exactly radius from center along perpendicular approach
# Ray from (1,0,0) going +z toward sphere at (0,0,5) r=1 should miss
var g_rs_tang = geo_ray_new(hvec3_new(F64_ONE, 0, 0), hvec3_unit_z());
# distance from (1,0,5) to (0,0,5) is 1 = radius, so tangent
var g_rs_tt = geo_ray_sphere(g_rs_tang, g_rs_sph);
# tangent at exactly r should still count as a hit (discriminant = 0)
assert(g_rs_tt != 0, "ray-sphere tangent");

# ----------------------------------------------------------------
test_group("geo: ray-triangle");

var g_tri = geo_triangle_new(
hvec3_new(f64_neg(F64_ONE), f64_neg(F64_ONE), f64_from(5)),
hvec3_new(F64_ONE, f64_neg(F64_ONE), f64_from(5)),
hvec3_new(0, F64_ONE, f64_from(5))
);
var g_rt_ray = geo_ray_new(hvec3_zero(), hvec3_unit_z());
var g_rt_t = geo_ray_triangle(g_rt_ray, g_tri);
assert_eq(f64_to(g_rt_t), 5, "ray-tri hit t=5");

# Miss: ray offset to the side
var g_rt_miss = geo_ray_new(hvec3_new(f64_from(10), 0, 0), hvec3_unit_z());
assert_eq(geo_ray_triangle(g_rt_miss, g_tri), 0, "ray-tri miss");

# Parallel to triangle plane
var g_rt_par = geo_ray_new(hvec3_zero(), hvec3_unit_x());
assert_eq(geo_ray_triangle(g_rt_par, g_tri), 0, "ray-tri parallel");

# Behind: ray pointing away from triangle
var g_rt_behind = geo_ray_new(hvec3_zero(), hvec3_new(0, 0, f64_neg(F64_ONE)));
assert_eq(geo_ray_triangle(g_rt_behind, g_tri), 0, "ray-tri behind");

# ----------------------------------------------------------------
test_group("geo: aabb-aabb overlap");

var g_aabb1 = geo_aabb_new(hvec3_new(f64_neg(F64_ONE), f64_neg(F64_ONE), f64_neg(F64_ONE)),
hvec3_new(F64_ONE, F64_ONE, F64_ONE));
var g_aabb2 = geo_aabb_new(hvec3_zero(), hvec3_new(F64_TWO, F64_TWO, F64_TWO));
assert_eq(geo_aabb_aabb(g_aabb1, g_aabb2), 1, "aabb overlap");

# No overlap
var g_aabb3 = geo_aabb_new(hvec3_new(f64_from(5), f64_from(5), f64_from(5)),
hvec3_new(f64_from(6), f64_from(6), f64_from(6)));
assert_eq(geo_aabb_aabb(g_aabb1, g_aabb3), 0, "aabb no overlap");

# Touching (edge contact)
var g_aabb4 = geo_aabb_new(hvec3_new(F64_ONE, 0, 0), hvec3_new(F64_TWO, F64_ONE, F64_ONE));
assert_eq(geo_aabb_aabb(g_aabb1, g_aabb4), 1, "aabb touching");

# Contained
var g_aabb5 = geo_aabb_new(hvec3_new(f64_neg(F64_HALF), f64_neg(F64_HALF), f64_neg(F64_HALF)),
hvec3_new(F64_HALF, F64_HALF, F64_HALF));
assert_eq(geo_aabb_aabb(g_aabb1, g_aabb5), 1, "aabb contained");

# ----------------------------------------------------------------
test_group("geo: sphere-sphere");

var g_s1 = geo_sphere_new(hvec3_zero(), F64_ONE);
var g_s2 = geo_sphere_new(hvec3_new(F64_ONE, 0, 0), F64_ONE);
assert_eq(geo_sphere_sphere(g_s1, g_s2), 1, "sphere overlap");

# No overlap
var g_s3 = geo_sphere_new(hvec3_new(f64_from(5), 0, 0), F64_ONE);
assert_eq(geo_sphere_sphere(g_s1, g_s3), 0, "sphere no overlap");

# Touching (distance = r1 + r2)
var g_s4 = geo_sphere_new(hvec3_new(F64_TWO, 0, 0), F64_ONE);
assert_eq(geo_sphere_sphere(g_s1, g_s4), 1, "sphere touching");

# ----------------------------------------------------------------
test_group("geo: closest point");

# Closest on plane
var g_cp_plane = geo_closest_point_on_plane(g_plane, hvec3_new(f64_from(3), f64_from(7), F64_ONE));
assert_eq(f64_to(HVec3_x(g_cp_plane)), 3, "closest plane.x");
assert_eq(f64_to(HVec3_y(g_cp_plane)), 0, "closest plane.y");

# Closest on sphere (outside)
var g_cp_sph = geo_closest_point_on_sphere(g_s1, hvec3_new(f64_from(5), 0, 0));
assert_eq(f64_to(HVec3_x(g_cp_sph)), 1, "closest sphere outside.x");

# Closest on sphere (at center — returns center + (r,0,0))
var g_cp_sph_c = geo_closest_point_on_sphere(g_s1, hvec3_zero());
assert_eq(f64_to(HVec3_x(g_cp_sph_c)), 1, "closest sphere at center.x");

# Closest on AABB (outside)
var g_cp_aabb = geo_closest_point_on_aabb(g_aabb1, hvec3_new(f64_from(5), 0, 0));
assert_eq(f64_to(HVec3_x(g_cp_aabb)), 1, "closest aabb outside.x");

# Closest on AABB (inside, should clamp to self)
var g_cp_aabb_in = geo_closest_point_on_aabb(g_aabb1, hvec3_new(F64_HALF, 0, 0));
assert_eq(f64_to(f64_mul(HVec3_x(g_cp_aabb_in), f64_from(10))), 5, "closest aabb inside.x");

# ----------------------------------------------------------------
test_group("geo: triangle properties");

var g_tri2 = geo_triangle_new(
hvec3_zero(),
hvec3_new(F64_TWO, 0, 0),
hvec3_new(0, F64_TWO, 0)
);

# Area = 0.5 * |base| * |height| = 0.5 * 2 * 2 = 2
var g_area = geo_triangle_area(g_tri2);
assert_eq(f64_to(g_area), 2, "triangle area");

# Centroid = (2/3, 2/3, 0)
var g_centroid = geo_triangle_centroid(g_tri2);
# centroid x = (0+2+0)/3 = 0.666... multiply by 3 to get 2
var g_centroid_x3 = f64_to(f64_round(f64_mul(HVec3_x(g_centroid), f64_from(3))));
assert_eq(g_centroid_x3, 2, "triangle centroid.x*3");

# Normal: cross of (2,0,0)x(0,2,0) = (0,0,4) — z-component = 4
var g_normal = geo_triangle_normal(g_tri2);
assert_eq(f64_to(HVec3_z(g_normal)), 4, "triangle normal.z");

# ----------------------------------------------------------------
test_group("geo: SDF");

# SDF sphere: (3,0,0), center=origin, r=1 -> d = 2
var g_sdf_s = sdf_sphere(hvec3_new(f64_from(3), 0, 0), hvec3_zero(), F64_ONE);
assert_eq(f64_to(g_sdf_s), 2, "sdf sphere outside");

# SDF sphere inside: (0,0,0), center=origin, r=2 -> d = -2
var g_sdf_si = sdf_sphere(hvec3_zero(), hvec3_zero(), F64_TWO);
assert_eq(f64_to(g_sdf_si), (0 - 2), "sdf sphere inside");

# SDF box: point at (3,0,0), center=origin, half=(1,1,1) -> d = 2
var g_sdf_b = sdf_box(hvec3_new(f64_from(3), 0, 0), hvec3_zero(),
hvec3_new(F64_ONE, F64_ONE, F64_ONE));
assert_eq(f64_to(g_sdf_b), 2, "sdf box outside");

# CSG union
assert_eq(f64_to(sdf_union(f64_from(3), f64_from(5))), 3, "sdf union");
# CSG intersection
assert_eq(f64_to(sdf_intersection(f64_from(3), f64_from(5))), 5, "sdf intersection");
# CSG subtraction: max(3, -5) = 3
assert_eq(f64_to(sdf_subtraction(f64_from(3), f64_from(5))), 3, "sdf subtraction");

# ================================================================
# CALC — derivatives, integration, bezier, catmull-rom, easing (~25)
# ================================================================
test_group("calc: derivative");

# d/dx(x^2) at x=3, h=1 central diff: (16-4)/2 = 6
var c_deriv_x2 = calc_derivative(&_tc_x2, f64_from(3), F64_ONE);
assert_eq(f64_to(c_deriv_x2), 6, "deriv x^2 at 3");

# d/dx(sin) at 0 with small h: should be ~cos(0)=1
var c_deriv_sin = calc_derivative(&_tc_sin, 0, f64_from(1));
# central diff (sin(1) - sin(-1))/2 = sin(1)/1 ... approximate
var c_ds_r = f64_to(f64_round(f64_mul(c_deriv_sin, f64_from(1000))));
assert_eq(c_ds_r, 841, "deriv sin at 0 *1000 ~ 841");

# d/dx(const) = 0
var c_deriv_c = calc_derivative(&_tc_const, F64_ONE, F64_ONE);
assert_eq(f64_to(c_deriv_c), 0, "deriv const = 0");

# ----------------------------------------------------------------
test_group("calc: simpson integration");

# EXACT WHERE THE RULE IS EXACT, TIGHT WHERE IT IS NOT.
# The assertions here through 2.7.x quantised the result through f64_to/f64_round
# and so certified almost nothing: round(3I) == 1 accepts I in [1/6, 1/2), i.e.
# -50%/+50% on 1/3; trunc(I) == 7 accepts [7, 8) (+14.3%); round(I) == 2 accepts
# [1.5, 2.5) (+/-25%). No tolerance-based Simpson assertion existed anywhere.
#
# Simpson's rule is EXACT for every polynomial of degree <= 3, and 4th-order
# otherwise: int - S = -(b-a) h^4 f''''(xi) / 180. Each case below runs on a
# dyadic grid -- n = 64 gives h = 2^-6 on [0,1] and h = 2^-5 on [0,2] -- so every
# node i*h, every f(x_i), every weighted term (the weights 4 and 2 are powers of
# two) and every partial sum is an exactly representable dyadic well inside 2^53.
# The ONLY rounding in the whole computation is the closing divide by 3, which is
# correctly rounded. The polynomial answers are therefore bit-exact and are
# asserted as bit patterns; every constant below is the closed-form value, not a
# recorded output.
var c_int_out = alloc(8);

# degree 0: int(7, 0, 1) = 7. T = 7*(2 + 4*32 + 2*31) = 1344, T*h = 21, 21/3 = 7.
var c_rc = calc_integral_simpson(&_tc_const, 0, F64_ONE, 64, c_int_out);
assert_eq(c_rc, 0, "simpson ok");
assert_eq(load64(c_int_out), 0x401C000000000000, "simpson deg-0: int(7,0,1) is 7.0 bit-exact");

# degree 1: int(x, 0, 2) = 2. T = 192, T*h = 6, 6/3 = 2.
calc_integral_simpson(&_tc_linear, 0, F64_TWO, 64, c_int_out);
assert_eq(load64(c_int_out), 0x4000000000000000, "simpson deg-1: int(x,0,2) is 2.0 bit-exact");

# degree 2: int(x^2, 0, 1) = 1/3. T = 64 exactly, T*h = 1.0, and 1.0/3.0 is the
# correctly rounded fl(1/3) = 0x3FD5555555555555.
calc_integral_simpson(&_tc_x2, 0, F64_ONE, 64, c_int_out);
assert_eq(load64(c_int_out), 0x3FD5555555555555, "simpson deg-2: int(x^2,0,1) is fl(1/3) bit-exact");

# degree 3 -- the defining property. int(x^3 - 2x^2 + 3x - 4, 0, 2)
#           = 4 - 16/3 + 6 - 8 = -10/3. T = -320, T*h = -10, fl(-10/3).
calc_integral_simpson(&_tc_cubic, 0, F64_TWO, 64, c_int_out);
assert_eq(load64(c_int_out), 0xC00AAAAAAAAAAAAB, "simpson deg-3: int(cubic,0,2) is fl(-10/3) bit-exact");

# degree 4 -- where the rule stops being exact, and by exactly how much. f'''' is
# constant for a quartic, so Euler-Maclaurin is an identity, not an estimate:
#   S_n = int + (b-a) h^4 f''''/180 = 1/5 + 24 h^4/180 = 1/5 + 2 h^4/15.
# h = 2^-6 gives 2/(15*2^24) = 7.947285970052083e-09, so the rule must return
# 0.20000000794728598 = 0x3FC99999AAAAAAAB -- provably NOT 0.2.
calc_integral_simpson(&_tc_x4, 0, F64_ONE, 64, c_int_out);
assert_eq(load64(c_int_out), 0x3FC99999AAAAAAAB, "simpson deg-4: int(x^4,0,1) is fl(1/5 + 2h^4/15)");
var c_q_dev = f64_sub(load64(c_int_out), 0x3FC999999999999A);   # minus fl(0.2)
assert(f64_gt(c_q_dev, 0x3E410D0FA854A07E) == 1, "simpson deg-4 error term > 7.94e-9");
assert(f64_lt(c_q_dev, 0x3E41128F084CFED7) == 1, "simpson deg-4 error term < 7.95e-9");

# The n=100 shape the old assertions used. h = fl(1/100) is not dyadic, so the
# nodes and node values round -- yet x^2 still lands under one ulp of 1/3.
calc_integral_simpson(&_tc_x2, 0, F64_ONE, 100, c_int_out);
var c_int_err = f64_abs(f64_sub(load64(c_int_out), 0x3FD5555555555555));
assert(f64_lt(c_int_err, 0x3C9CD2B297D889BC) == 1, "simpson x^2 n=100 within 1e-16 of 1/3 (< 2 ulp)");

# 1000 subintervals. The Neumaier compensation in the accumulator is what holds
# these two to zero error: deleting it costs 2 ulp at n=100 and 3 ulp here, so
# this pair is also the only regression test the compensated sum has.
calc_integral_simpson(&_tc_x2, 0, F64_ONE, 1000, c_int_out);
var c_int_err_k = f64_abs(f64_sub(load64(c_int_out), 0x3FD5555555555555));
assert(f64_lt(c_int_err_k, 0x3C9CD2B297D889BC) == 1, "simpson x^2 n=1000 within 1e-16 of 1/3");

# NON-POLYNOMIAL, so the rule is genuinely inexact: int(1/(1+x), 0, 1) = ln 2.
# 1/(1+x) on a dyadic grid is one correctly rounded IEEE divide, so the rule's
# value is computable in exact rational arithmetic independently of this library:
# S_64 = 0.6931471824214548 (0x3FE62E42FFFA11FA), S_32 = 0.693147210289823.
var c_ln2_64 = alloc(8);
calc_integral_simpson(&_tc_inv1p, 0, F64_ONE, 64, c_ln2_64);
var c_s64_err = f64_abs(f64_sub(load64(c_ln2_64), 0x3FE62E42FFFA11FA));
assert(f64_lt(c_s64_err, 0x3CD203AF9EE75616) == 1, "simpson 1/(1+x) n=64 hits exact rule value to 1e-15");

# 4th-order convergence: halving h must cut the error by 16. The exact-rational
# prediction is e(32)/e(64) = 15.9708437; the trapezoid rule would give ~4, and a
# mis-weighted Simpson gives O(1). e(64) itself is pinned to the h^4 term,
# (h^4/180)*(f'''(1) - f'''(0)) = 0.03125*h^4 = 1.8626e-09.
var c_ln2_32 = alloc(8);
calc_integral_simpson(&_tc_inv1p, 0, F64_ONE, 32, c_ln2_32);
var c_e64 = f64_abs(f64_sub(load64(c_ln2_64), 0x3FE62E42FEFA39EF));   # fl(ln 2)
var c_e32 = f64_abs(f64_sub(load64(c_ln2_32), 0x3FE62E42FEFA39EF));
assert(f64_gt(c_e64, 0x3E1EEC7BD512B572) == 1, "simpson n=64 error > 1.8e-9 (h^4 term is real)");
assert(f64_lt(c_e64, 0x3E20C01868BF779E) == 1, "simpson n=64 error < 1.95e-9");
var c_ratio = f64_div(c_e32, c_e64);
assert(f64_gt(c_ratio, 0x402FCCCCCCCCCCCD) == 1, "simpson 4th order: e(32)/e(64) > 15.9");
assert(f64_lt(c_ratio, 0x40300CCCCCCCCCCD) == 1, "simpson 4th order: e(32)/e(64) < 16.05");

# a != 0 -- THE GAP ADVERSARIAL REVIEW FOUND. Every case above starts at a = 0,
# so two independent a-drop mutants survived the whole block:
#   h  = (b - a)/n  ->  b/n          (step size ignores the lower limit)
#   xi = a + i*h    ->  i*h          (nodes ignore the lower limit)
# Both are silent when a == 0. On [1,3] with n = 64 the step is 2^-5, still
# dyadic, so these stay bit-exact: int(x^2,1,3) = 26/3 and int(x^3,1,3) = 20.
# Under the xi a-drop the first becomes int(x^2,0,2) = 8/3 -- off by 3x.
calc_integral_simpson(&_tc_x2, F64_ONE, f64_from(3), 64, c_int_out);
assert_eq(load64(c_int_out), 0x4021555555555555, "simpson a!=0 deg-2: int(x^2,1,3) is fl(26/3)");
calc_integral_simpson(&_tc_cubic_pure, F64_ONE, f64_from(3), 64, c_int_out);
assert_eq(load64(c_int_out), 0x4034000000000000, "simpson a!=0 deg-3: int(x^3,1,3) is 20.0 bit-exact");

# ----------------------------------------------------------------
test_group("calc: gauss-legendre");

# Gauss5 on x^2 from 0 to 1 = 1/3
var c_gl = calc_integral_gauss5(&_tc_x2, 0, F64_ONE);
var c_gl_3 = f64_to(f64_round(f64_mul(c_gl, f64_from(3))));
assert_eq(c_gl_3, 1, "gauss5 x^2 = 1/3");

# Gauss5 on const 7 from 0 to 1 = 7
var c_gl_c = calc_integral_gauss5(&_tc_const, 0, F64_ONE);
assert_eq(f64_to(f64_round(c_gl_c)), 7, "gauss5 const=7");

# TOLERANCE, not rounding. The two assertions above compare f64_round(...) to an
# integer, which permits +/-0.5 absolute -- 7.1% relative on the const-7 case. All
# nine Gauss-Legendre node/weight constants were mis-transcribed through 2.6.11
# (weights summed to 2.000492 instead of 2) and both assertions stayed green.
# 5-point Gauss-Legendre is EXACT for polynomials of degree <= 9, so demand it.
var c_gl_err = f64_abs(f64_sub(c_gl, f64_div(F64_ONE, f64_from(3))));
assert(f64_lt(c_gl_err, f64_div(F64_ONE, f64_from(100000000000))) == 1,
"gauss5: x^2 exact to 1e-11 (degree 2 << 9)");
var c_gl_c_err = f64_abs(f64_sub(c_gl_c, f64_from(7)));
assert(f64_lt(c_gl_c_err, f64_div(F64_ONE, f64_from(100000000000))) == 1,
"gauss5: const 7 exact to 1e-11");
# The weights must sum to 2 (integral of 1 over [-1,1]); on [0,1] that is 1.
var c_gl_one = calc_integral_gauss5(&_tc_one, 0, F64_ONE);
assert(f64_lt(f64_abs(f64_sub(c_gl_one, F64_ONE)), f64_div(F64_ONE, f64_from(1000000000000))) == 1,
"gauss5: weights sum correctly (integral of 1 over [0,1] = 1)");

# ----------------------------------------------------------------
test_group("calc: bezier");

# Quadratic bezier endpoints: B(0)=p0, B(1)=p2
var c_bz_p0 = hvec2_new(0, 0);
var c_bz_p1 = hvec2_new(F64_ONE, F64_TWO);
var c_bz_p2 = hvec2_new(F64_TWO, 0);

var c_bz0 = calc_bezier_quad_2d(c_bz_p0, c_bz_p1, c_bz_p2, 0);
assert_eq(f64_to(HVec2_x(c_bz0)), 0, "bezier t=0 x");
assert_eq(f64_to(HVec2_y(c_bz0)), 0, "bezier t=0 y");

var c_bz1 = calc_bezier_quad_2d(c_bz_p0, c_bz_p1, c_bz_p2, F64_ONE);
assert_eq(f64_to(HVec2_x(c_bz1)), 2, "bezier t=1 x");
assert_eq(f64_to(HVec2_y(c_bz1)), 0, "bezier t=1 y");

# Straight line bezier: all points on x-axis
var c_bz_s0 = hvec2_new(0, 0);
var c_bz_s1 = hvec2_new(F64_ONE, 0);
var c_bz_s2 = hvec2_new(F64_TWO, 0);
var c_bz_mid = calc_bezier_quad_2d(c_bz_s0, c_bz_s1, c_bz_s2, F64_HALF);
assert_eq(f64_to(HVec2_x(c_bz_mid)), 1, "bezier straight mid x");
assert_eq(f64_to(HVec2_y(c_bz_mid)), 0, "bezier straight mid y");

# ----------------------------------------------------------------
test_group("calc: catmull-rom");

# Catmull-Rom passes through p1 at t=0 and p2 at t=1
var c_cr_p0 = hvec3_new(0, 0, 0);
var c_cr_p1 = hvec3_new(F64_ONE, F64_ONE, 0);
var c_cr_p2 = hvec3_new(F64_TWO, F64_TWO, 0);
var c_cr_p3 = hvec3_new(f64_from(3), f64_from(3), 0);

var c_cr_0 = calc_catmull_rom(c_cr_p0, c_cr_p1, c_cr_p2, c_cr_p3, 0);
assert_eq(f64_to(HVec3_x(c_cr_0)), 1, "catmull t=0 x");
assert_eq(f64_to(HVec3_y(c_cr_0)), 1, "catmull t=0 y");

var c_cr_1 = calc_catmull_rom(c_cr_p0, c_cr_p1, c_cr_p2, c_cr_p3, F64_ONE);
assert_eq(f64_to(HVec3_x(c_cr_1)), 2, "catmull t=1 x");
assert_eq(f64_to(HVec3_y(c_cr_1)), 2, "catmull t=1 y");

# ----------------------------------------------------------------
test_group("calc: easing");

# ease_in: t^2
assert_eq(f64_to(ease_in(0)), 0, "ease_in(0)");
assert_eq(f64_to(ease_in(F64_ONE)), 1, "ease_in(1)");

# ease_out: t*(2-t)
assert_eq(f64_to(ease_out(0)), 0, "ease_out(0)");
assert_eq(f64_to(ease_out(F64_ONE)), 1, "ease_out(1)");

# ease_in_out: t^2*(3-2t)
assert_eq(f64_to(ease_in_out(0)), 0, "ease_in_out(0)");
assert_eq(f64_to(ease_in_out(F64_ONE)), 1, "ease_in_out(1)");

# ease_in_cubic: t^3
assert_eq(f64_to(ease_in_cubic(0)), 0, "ease_in_cubic(0)");
assert_eq(f64_to(ease_in_cubic(F64_ONE)), 1, "ease_in_cubic(1)");

# ease_out_cubic: 1-(1-t)^3
assert_eq(f64_to(ease_out_cubic(0)), 0, "ease_out_cubic(0)");
assert_eq(f64_to(ease_out_cubic(F64_ONE)), 1, "ease_out_cubic(1)");

# ease_in_out_smooth (smootherstep)
assert_eq(f64_to(ease_in_out_smooth(0)), 0, "smootherstep(0)");
assert_eq(f64_to(ease_in_out_smooth(F64_ONE)), 1, "smootherstep(1)");

