# ----------------------------------------------------------------
test_group("num: kahan and neumaier");

var n_kdata = alloc(24);
store64(n_kdata, f64_from(1));
store64(n_kdata + 8, f64_from(2));
store64(n_kdata + 16, f64_from(3));
var n_ks = num_kahan_sum(n_kdata, 3);
assert_eq(n_ks, f64_from(6), "kahan sum");

var n_ns = num_neumaier_sum(n_kdata, 3);
assert_eq(n_ns, f64_from(6), "neumaier sum");

# Empty sum (n=0)
var n_ns0 = num_neumaier_sum(n_kdata, 0);
assert_eq(n_ns0, f64_from(0), "neumaier n=0");

# ----------------------------------------------------------------
test_group("num: fft roundtrip");

# DC signal: 4 complex elements, all = (1.0, 0.0)
var n_fft_data = alloc(64);  # 4 * 16 bytes
var _fi = 0;
while (_fi < 4) {
    store64(n_fft_data + _fi * 16, F64_ONE);
    store64(n_fft_data + _fi * 16 + 8, 0);
    _fi = _fi + 1;
}
var n_fft_rc_t, n_fft_rc_v = num_fft(n_fft_data, 4);
assert_eq(is_ok(n_fft_rc_t), 1, "fft ok");
# DC component (index 0) should be 4+0i
assert_eq(load64(n_fft_data), f64_from(4), "fft DC re=4");
assert_eq(load64(n_fft_data + 8), f64_from(0), "fft DC im=0");

# Roundtrip: ifft should recover original
var _r13t, _r13v = num_ifft(n_fft_data, 4);
# All elements should be (1.0, 0.0) again
assert_eq(f64_to(f64_round(load64(n_fft_data))), 1, "ifft[0].re=1");
assert_eq(f64_to(f64_round(load64(n_fft_data + 16))), 1, "ifft[1].re=1");
assert_eq(f64_to(f64_round(load64(n_fft_data + 8))), 0, "ifft[0].im=0");

# ================================================================
# COMPLEX — arithmetic, abs, conj, arg, euler, pauli, matrix (~20)
# ================================================================
test_group("complex: arithmetic");

var c_a = cx_new(f64_from(3), f64_from(4));
var c_b = cx_new(F64_ONE, F64_TWO);

# Add
var c_add = cx_add(c_a, c_b);
assert_eq(HComplex_re(c_add), f64_from(4), "cx add re");
assert_eq(HComplex_im(c_add), f64_from(6), "cx add im");

# Sub
var c_sub = cx_sub(c_a, c_b);
assert_eq(HComplex_re(c_sub), f64_from(2), "cx sub re");
assert_eq(HComplex_im(c_sub), f64_from(2), "cx sub im");

# Mul: (3+4i)(1+2i) = -5+10i
var c_mul = cx_mul(c_a, c_b);
assert_eq(HComplex_re(c_mul), f64_neg(f64_from(5)), "cx mul re");
assert_eq(HComplex_im(c_mul), f64_from(10), "cx mul im");

# Div: (3+4i)/(1+2i) = (3+4i)(1-2i)/5 = (11-2i)/5 = 2.2-0.4i
var c_div = cx_div(c_a, c_b);
var c_div_re10 = f64_to(f64_round(f64_mul(HComplex_re(c_div), f64_from(10))));
assert_eq(c_div_re10, 22, "cx div re*10");

# ----------------------------------------------------------------
test_group("complex: abs, conj, arg");

assert_eq(cx_abs(c_a), f64_from(5), "abs(3+4i)=5");

var c_conj = cx_conj(c_a);
assert_eq(HComplex_im(c_conj), f64_neg(f64_from(4)), "conj im");
assert_eq(HComplex_re(c_conj), f64_from(3), "conj re unchanged");

# arg(1+i) = pi/4
var c_1i = cx_new(F64_ONE, F64_ONE);
var c_arg = cx_arg(c_1i);
var c_arg_1000 = f64_to(f64_round(f64_mul(c_arg, f64_from(1000))));
var c_pi4_1000 = f64_to(f64_round(f64_mul(F64_PI_4, f64_from(1000))));
assert_eq(c_arg_1000, c_pi4_1000, "arg(1+i)=pi/4");

# ----------------------------------------------------------------
test_group("complex: euler identity");

# e^(i*pi) + 1 ~ 0
var c_eipi = cx_exp(cx_new(0, F64_PI));
var c_euler = cx_add(c_eipi, cx_one());
# cos(pi_d) rounds to exactly -1.0 and sin(pi_d) = 1.2246467991473532e-16, so the
# closed-form modulus is 1.2246e-16 (measured: identical). The old bound of 1.0
# passed for any argument within about +-60 deg of pi.
assert(f64_lt(cx_abs(c_euler), ULP_TOL_M) == 1, "euler e^(ipi)+1 == 0 (1e-15)");
# e^(i*pi)+1 == 0 is BLIND to conjugation: pi is a fixed point of z -> conj(z), so
# negating the imaginary output of cx_exp leaves this bit-identical (verified: such
# a mutant passes all four suites). Pin a point where the two differ.
# e^(i*pi/2) = 6.123233995736766e-17 + 1i
var _e_ih = cx_exp(cx_new(0, F64_PI_2));
assert(f64_lt(f64_abs(HComplex_re(_e_ih)), ULP_TOL_M) == 1, "cx_exp(i*pi/2).re == 0");
assert(f64_lt(f64_abs(f64_sub(HComplex_im(_e_ih), F64_ONE)), ULP_TOL_M) == 1,
  "cx_exp(i*pi/2).im == +1 (not -1)");

# ----------------------------------------------------------------
test_group("complex: pauli matrices");

# sigma_x^2 = I
var c_sx = pauli_x();
var c_sx2 = cmat_mul(c_sx, c_sx);
var c_tr_sx2 = cmat_trace(c_sx2);
assert_eq(HComplex_re(c_tr_sx2), f64_from(2), "sx^2 trace=2");

# sigma_y^2 = I
var c_sy = pauli_y();
var c_sy2 = cmat_mul(c_sy, c_sy);
var c_tr_sy2 = cmat_trace(c_sy2);
assert_eq(HComplex_re(c_tr_sy2), f64_from(2), "sy^2 trace=2");

# sigma_z^2 = I
var c_sz = pauli_z();
var c_sz2 = cmat_mul(c_sz, c_sz);
var c_tr_sz2 = cmat_trace(c_sz2);
assert_eq(HComplex_re(c_tr_sz2), f64_from(2), "sz^2 trace=2");

# Traceless: tr(sigma_x) = 0
var c_tr_sx = cmat_trace(c_sx);
assert_eq(HComplex_re(c_tr_sx), f64_from(0), "sx traceless");
var c_tr_sy = cmat_trace(c_sy);
assert_eq(HComplex_re(c_tr_sy), f64_from(0), "sy traceless");
var c_tr_sz = cmat_trace(c_sz);
assert_eq(HComplex_re(c_tr_sz), f64_from(0), "sz traceless");

# Commutation: [sx, sy] = 2i*sz
var c_comm = cmat_commutator(c_sx, c_sy);
var c_c00 = cmat_get(c_comm, 0, 0);
assert_eq(HComplex_im(c_c00), f64_from(2), "[sx,sy]_00 im=2");

# ----------------------------------------------------------------
test_group("complex: matrix");

# Identity trace
var c_id = cmat_identity(3);
var c_id_tr = cmat_trace(c_id);
assert_eq(HComplex_re(c_id_tr), f64_from(3), "identity(3) trace=3");

# Adjoint of identity = identity
var c_id_adj = cmat_adjoint(c_id);
var c_id_adj_tr = cmat_trace(c_id_adj);
assert_eq(HComplex_re(c_id_adj_tr), f64_from(3), "adj(I) trace=3");
# If cmat_adjoint were a plain copy, the 8-generator hermitian sweep is A == A
# again -- verified: such a stub passes all four suites, because 'adj(I) trace==3'
# is satisfied by the identity function. Pin adjoint on a NON-hermitian matrix.
var _adj_m = cmat_new(2, 2);
cmat_set(_adj_m, 0, 1, cx_new(F64_TWO, f64_from(3)));
var _adj_r = cmat_adjoint(_adj_m);
assert_eq(HComplex_re(cmat_get(_adj_r, 1, 0)), f64_from(2), "adj[1][0].re == 2 (transposed)");
assert_eq(HComplex_im(cmat_get(_adj_r, 1, 0)), f64_neg(f64_from(3)), "adj[1][0].im == -3 (conjugated)");
assert_eq(HComplex_re(cmat_get(_adj_r, 0, 1)), f64_from(0), "adj[0][1] == 0 (not a copy)");

# ================================================================
# LIE GROUPS (~15)
# ================================================================
test_group("lie: U(1)");

# Compose = add phases
var l_u_a = u1_new(F64_PI_4);
var l_u_b = u1_new(F64_PI_4);
var l_u_c = u1_compose(l_u_a, l_u_b);
var l_u_phase = f64_to(f64_round(f64_mul(load64(l_u_c), f64_from(1000))));
var l_pi2_1000 = f64_to(f64_round(f64_mul(F64_PI_2, f64_from(1000))));
assert_eq(l_u_phase, l_pi2_1000, "u1 compose pi/4+pi/4=pi/2");

# Inverse: phase + (-phase) ~ 0
var l_u_inv = u1_inv(l_u_a);
var l_u_id = u1_compose(l_u_a, l_u_inv);
# f64_add(theta, f64_neg(theta)) is exactly +0.0 in IEEE-754 round-to-nearest for
# every finite theta, so this is exact. Measured bit pattern: 0x0.
assert_eq(load64(l_u_id), 0, "u1 inv phase is exactly +0.0");

# Exp/log roundtrip
var l_u_exp = u1_exp(F64_PI_4);
var l_u_log = u1_log(l_u_exp);
var l_u_rt = f64_to(f64_round(f64_mul(l_u_log, f64_from(1000))));
var l_pi4_1000 = f64_to(f64_round(f64_mul(F64_PI_4, f64_from(1000))));
assert_eq(l_u_rt, l_pi4_1000, "u1 exp/log roundtrip");

# ----------------------------------------------------------------
test_group("lie: SU(2)");

# Identity to_quat -> w=1
var l_su2_id = su2_identity();
var l_su2_q = su2_to_quat(l_su2_id);
assert_eq(HQuat_w(l_su2_q), f64_from(1), "su2 identity w=1");

# Compose inverse = identity
var l_su2_r = su2_from_axis_angle(hvec3_unit_z(), F64_PI_4);
var l_su2_ri = su2_inv(l_su2_r);
var l_su2_p = su2_compose(l_su2_r, l_su2_ri);
# Half-angle convention: su2_from_axis_angle(z_hat, pi/4) = cos(pi/8) + sin(pi/8) k.
# Pin those first -- w = 1 after compose-with-inverse and dw = 0 after a to_quat
# round-trip are both TRUE under a full-angle build, so neither check below can
# see the half-vs-full-angle split that shipped through 2.6.12.
#   cos(pi/8) = 0.9238795325112867   (a full-angle build would put 0.7071067811865476 here)
#   sin(pi/8) = 0.3826834323650898
var _cos_pi8 = 0x3FED906BCF328D46;  # 0.9238795325112867
var _sin_pi8 = 0x3FD87DE2A6AEA963;  # 0.3826834323650898
assert(f64_lt(f64_abs(f64_sub(_su2_w(l_su2_r), _cos_pi8)), ULP_TOL_M) == 1, "su2 axis-angle w == cos(pi/8)");
assert(f64_lt(f64_abs(f64_sub(_su2_z(l_su2_r), _sin_pi8)), ULP_TOL_M) == 1, "su2 axis-angle z == sin(pi/8)");
# w of q*q^-1 is w^2+x^2+y^2+z^2 = 1 exactly for a unit quaternion (measured
# residual 0). The old bound of 1.0 merely asserted w > 0.
assert(f64_lt(f64_abs(f64_sub(_su2_w(l_su2_p), F64_ONE)), ULP_TOL_M) == 1, "su2 compose inv w == 1 (1e-15)");
# w of q*q^-1 is an inner product, so EVERY su2 assertion in the repo (w == 1, the
# to_quat dw, the axis-angle pins) survives a sign flip in su2_compose's x/y/z
# cross terms -- verified. Pin all four components of a product of two
# non-parallel rotations.
var _c07 = 0x3FE6666666666666;  # 0.7
var _c11 = 0x3FF199999999999A;  # 1.1
var _sa = su2_from_axis_angle(hvec3_new(F64_ONE, F64_TWO, f64_from(3)), _c07);
var _sb = su2_from_axis_angle(hvec3_new(f64_neg(F64_TWO), F64_ONE, F64_HALF), _c11);
var _sp = su2_compose(_sa, _sb);
var _sp_w = 0x3FE89F9435EE839F;   # 0.7694798520425258
var _sp_x = 0xBFD91ACF6D1B1AAA;   # -0.392261368321139
var _sp_y = 0x3FCE094E17426F47;   # 0.23465896735876354
var _sp_z = 0x3FDC8C331EC15140;   # 0.44605710986549596  (a z-sign flip gives 0.2788)
assert(f64_lt(f64_abs(f64_sub(_su2_w(_sp), _sp_w)), TOL_1EM12) == 1, "su2_compose generic w");
assert(f64_lt(f64_abs(f64_sub(_su2_x(_sp), _sp_x)), TOL_1EM12) == 1, "su2_compose generic x");
assert(f64_lt(f64_abs(f64_sub(_su2_y(_sp), _sp_y)), TOL_1EM12) == 1, "su2_compose generic y");
assert(f64_lt(f64_abs(f64_sub(_su2_z(_sp), _sp_z)), TOL_1EM12) == 1, "su2_compose generic z");
# where: var TOL_1EM12 = 0x3D719799812DEA11;  # 1e-12 (== EPSILON_F64)

# to_quat roundtrip
var l_su2_q2 = su2_to_quat(l_su2_r);
var l_su2_back = su2_from_quat(l_su2_q2);
# Both w's live in [-1, 1], so |dw| < 1.0 was near-unfalsifiable. The round trip
# renormalizes by a norm of exactly 1.0 here: measured dw = 0.
assert(f64_lt(f64_abs(f64_sub(_su2_w(l_su2_back), _su2_w(l_su2_r))), ULP_TOL_M) == 1,
  "su2 to_quat roundtrip dw == 0 (1e-15)");

# ----------------------------------------------------------------
test_group("lie: Gell-Mann");

# The three properties that CHARACTERISE the SU(3) Gell-Mann basis:
#   (1) lambda_a = lambda_a^H          (Hermitian, checked elementwise)
#   (2) tr lambda_a = 0                (traceless)
#   (3) tr(lambda_a lambda_b) = 2 delta_ab   (orthogonal, normalised to 2)
# Every expected value below is closed form. The ONLY floating-point residual
# anywhere in this block is tr(l8 l8): l8's entries are fl(1/fl(sqrt 3)), so the
# trace is 6*fl(x*x) = 2.0000000000000004 — exactly one ulp at 2.0
# (4.4408920985006262e-16) above the exact 2. Everything else is bit-exact:
# the other seven generators have entries in {0, +-1, +-i}, and l8's trace
# cancels exactly because fl(2/s) == 2*fl(1/s) for s = fl(sqrt 3).
var GM_TR_TOL = 0x3CD203AF9EE75616;   # 1e-15  = 2.25 ulp at 2.0
var GM_L8_TOL = 0x3CBCD2B297D889BC;   # 4e-16  = 3.6 ulp at 0.577, 1.8 ulp at 1.155
# Correctly-rounded doubles of 1/sqrt(3) and 2/sqrt(3), derived independently at
# 60 decimal digits (NOT read off the library, which rounds twice and lands
# 1 ulp high at 0x3FE279A74590331D — inside GM_L8_TOL).
var GM_L8_A  = 0x3FE279A74590331C;    #  1/sqrt(3) =  0.5773502691896257645091
var GM_L8_B2 = 0xBFF279A74590331C;    # -2/sqrt(3) = -1.1547005383792515290183

# --- (0) the checker must be able to FAIL --------------------------------
# The assertion this replaces compared Re(A[0][0]) against Re(adjoint(A)[0][0]),
# which is bit-identical for every complex matrix. These three controls prove
# _gm_is_herm actually discriminates.
var l_gm_nh1 = cmat_new(3, 3);
cmat_set(l_gm_nh1, 0, 1, cx_one());                 # 1 at (0,1), 0 at (1,0)
assert_eq(_gm_is_herm(l_gm_nh1), 0, "gm herm control: rejects non-symmetric real part");
var l_gm_nh2 = cmat_new(3, 3);
cmat_set(l_gm_nh2, 0, 0, cx_i());                   # imaginary entry on the diagonal
assert_eq(_gm_is_herm(l_gm_nh2), 0, "gm herm control: rejects imaginary diagonal");
var l_gm_nh3 = cmat_new(3, 3);                      # lambda_2 with the conjugation dropped
cmat_set(l_gm_nh3, 0, 1, cx_i());
cmat_set(l_gm_nh3, 1, 0, cx_i());
assert_eq(_gm_is_herm(l_gm_nh3), 0, "gm herm control: rejects unconjugated off-diagonal");

# --- (1) Hermiticity + (2) tracelessness, all 8 generators ---------------
var _gm_a = 0;
while (_gm_a < 8) {
    var l_gma = gell_mann(_gm_a);
    assert_eq(_gm_is_herm(l_gma), 1, "gell-mann hermitian (all 9 entries, re and im)");
    # Hermitian + traceless is invariant under PERMUTING the generators: swapping the
    # lambda_4 and lambda_5 bodies passes all four suites. Pin each one's identity.
    assert_eq(HComplex_re(cmat_get(gell_mann(3), 0, 2)), f64_from(1), "lambda_4[0][2] == +1 (real)");
    assert_eq(HComplex_im(cmat_get(gell_mann(3), 0, 2)), f64_from(0), "lambda_4[0][2] has no i");
    assert_eq(HComplex_im(cmat_get(gell_mann(4), 0, 2)), f64_neg(f64_from(1)), "lambda_5[0][2] == -i");
    assert_eq(HComplex_re(cmat_get(gell_mann(4), 0, 2)), f64_from(0), "lambda_5[0][2] is pure imaginary");
    assert_eq(HComplex_re(cmat_get(gell_mann(5), 1, 2)), f64_from(1), "lambda_6[1][2] == +1 (real)");
    assert_eq(HComplex_im(cmat_get(gell_mann(6), 1, 2)), f64_neg(f64_from(1)), "lambda_7[1][2] == -i");
    assert_eq(HComplex_re(cmat_get(gell_mann(2), 0, 0)), f64_from(1), "lambda_3[0][0] == +1");
    assert_eq(HComplex_re(cmat_get(gell_mann(2), 1, 1)), f64_neg(f64_from(1)), "lambda_3[1][1] == -1");
    # cmat_adjoint must reproduce the matrix exactly — all 9 entries, both
    # components. Off-diagonal entries make this a real transpose+conjugate test.
    var l_gma_h = cmat_adjoint(l_gma);
    var l_gm_adj_bad = 0;
    var _gm_i = 0;
    while (_gm_i < 3) {
        var _gm_j = 0;
        while (_gm_j < 3) {
            var l_gm_u = cmat_get(l_gma, _gm_i, _gm_j);
            var l_gm_v = cmat_get(l_gma_h, _gm_i, _gm_j);
            if (f64_eq(HComplex_re(l_gm_u), HComplex_re(l_gm_v)) == 0) {
                l_gm_adj_bad = l_gm_adj_bad + 1;
            }
            if (f64_eq(HComplex_im(l_gm_u), HComplex_im(l_gm_v)) == 0) {
                l_gm_adj_bad = l_gm_adj_bad + 1;
            }
            _gm_j = _gm_j + 1;
        }
        _gm_i = _gm_i + 1;
    }
    assert_eq(l_gm_adj_bad, 0, "gell-mann adjoint == self, entrywise");
    # Traceless: exactly 0, both components (not "within 1.0").
    var l_gm_tr = cmat_trace(l_gma);
    assert_eq(f64_eq(HComplex_re(l_gm_tr), 0), 1, "gell-mann traceless (re exactly 0)");
    assert_eq(f64_eq(HComplex_im(l_gm_tr), 0), 1, "gell-mann traceless (im exactly 0)");
    _gm_a = _gm_a + 1;
}

# --- (3) orthogonality: tr(l_a l_b) = 2 delta_ab over all 64 pairs -------
var _gm_p = 0;
var l_gm_off_bad = 0;
var l_gm_diag_bad = 0;
var l_gm_im_bad = 0;
while (_gm_p < 8) {
    var l_gm_pa = gell_mann(_gm_p);
    var _gm_q = 0;
    while (_gm_q < 8) {
        var l_gm_t = cmat_trace(cmat_mul(l_gm_pa, gell_mann(_gm_q)));
        if (f64_eq(HComplex_im(l_gm_t), 0) == 0) { l_gm_im_bad = l_gm_im_bad + 1; }
        if (_gm_p == _gm_q) {
            if (f64_lt(f64_abs(f64_sub(HComplex_re(l_gm_t), F64_TWO)), GM_TR_TOL) == 0) {
                l_gm_diag_bad = l_gm_diag_bad + 1;
            }
        } else {
            if (f64_eq(HComplex_re(l_gm_t), 0) == 0) { l_gm_off_bad = l_gm_off_bad + 1; }
        }
        _gm_q = _gm_q + 1;
    }
    _gm_p = _gm_p + 1;
}
assert_eq(l_gm_off_bad, 0, "gell-mann tr(la lb) exactly 0 for a != b (56 pairs)");
assert_eq(l_gm_diag_bad, 0, "gell-mann tr(la la) = 2 within 1e-15 (8 pairs)");
assert_eq(l_gm_im_bad, 0, "gell-mann tr(la lb) exactly real (64 pairs)");

# Controls proving the Gram sweep measures normalisation, not a constant 2:
# tr((2 l1)^2) = 4 * tr(l1^2) = 8, and tr((l1+l4)^2) = 2 + 2*tr(l1 l4) + 2 = 4.
var l_gm_2l1 = cmat_scale(gell_mann(0), cx_real(F64_TWO));
var l_gm_ct1 = cmat_trace(cmat_mul(l_gm_2l1, l_gm_2l1));
assert_eq(f64_eq(HComplex_re(l_gm_ct1), f64_from(8)), 1, "gm gram control: tr((2 l1)^2) = 8");
var l_gm_s14 = cmat_add(gell_mann(0), gell_mann(3));
var l_gm_ct2 = cmat_trace(cmat_mul(l_gm_s14, l_gm_s14));
assert_eq(f64_eq(HComplex_re(l_gm_ct2), f64_from(4)), 1, "gm gram control: tr((l1+l4)^2) = 4");

# --- convention pin ------------------------------------------------------
# Hermiticity + tracelessness + tr(la lb) = 2 delta_ab are invariant under any
# unitary change of basis, so they do not by themselves pin the Gell-Mann
# convention. These do:
#   lambda_1 = [[0,1,0],[1,0,0],[0,0,0]]
#   lambda_3 = diag(1, -1, 0)
#   lambda_8 = diag(1, 1, -2)/sqrt(3)
#   [lambda_1, lambda_2] = 2i lambda_3   (structure constant f_123 = +1)
var l_gm_l1 = gell_mann(0);
assert_eq(f64_eq(HComplex_re(cmat_get(l_gm_l1, 0, 1)), F64_ONE), 1, "l1(0,1) = 1");
assert_eq(f64_eq(HComplex_re(cmat_get(l_gm_l1, 0, 0)), 0), 1, "l1(0,0) = 0");
var l_gm_l3 = gell_mann(2);
assert_eq(f64_eq(HComplex_re(cmat_get(l_gm_l3, 0, 0)), F64_ONE), 1, "l3(0,0) = +1");
assert_eq(f64_eq(HComplex_re(cmat_get(l_gm_l3, 1, 1)), f64_neg(F64_ONE)), 1, "l3(1,1) = -1");
assert_eq(f64_eq(HComplex_re(cmat_get(l_gm_l3, 2, 2)), 0), 1, "l3(2,2) = 0");
var l_gm_l8 = gell_mann(7);
var l_gm_e00 = HComplex_re(cmat_get(l_gm_l8, 0, 0));
var l_gm_e11 = HComplex_re(cmat_get(l_gm_l8, 1, 1));
var l_gm_e22 = HComplex_re(cmat_get(l_gm_l8, 2, 2));
assert_eq(f64_lt(f64_abs(f64_sub(l_gm_e00, GM_L8_A)), GM_L8_TOL), 1, "l8(0,0) = 1/sqrt(3)");
assert_eq(f64_eq(l_gm_e11, l_gm_e00), 1, "l8(1,1) == l8(0,0)");
assert_eq(f64_lt(f64_abs(f64_sub(l_gm_e22, GM_L8_B2)), GM_L8_TOL), 1, "l8(2,2) = -2/sqrt(3)");
assert_eq(f64_eq(HComplex_re(cmat_get(l_gm_l8, 0, 1)), 0), 1, "l8(0,1) = 0");
var l_gm_c12 = cmat_commutator(gell_mann(0), gell_mann(1));
var l_gm_k00 = cmat_get(l_gm_c12, 0, 0);
var l_gm_k11 = cmat_get(l_gm_c12, 1, 1);
assert_eq(f64_eq(HComplex_re(l_gm_k00), 0), 1, "[l1,l2](0,0) is pure imaginary");
assert_eq(f64_eq(HComplex_im(l_gm_k00), F64_TWO), 1, "[l1,l2] = 2i l3: (0,0) im = +2");
assert_eq(f64_eq(HComplex_im(l_gm_k11), f64_neg(F64_TWO)), 1, "[l1,l2] = 2i l3: (1,1) im = -2");
assert_eq(f64_eq(HComplex_im(cmat_get(l_gm_c12, 2, 2)), 0), 1, "[l1,l2] = 2i l3: (2,2) im = 0");
assert_eq(f64_eq(HComplex_im(cmat_get(l_gm_c12, 0, 1)), 0), 1, "[l1,l2] = 2i l3: (0,1) im = 0");
# --- (4) convention pin for lambda_4..lambda_7 ---------------------------
# Properties (1)-(3) are invariant under ANY real orthogonal mixing of
# lambda_4..lambda_7 (the 4-dim subspace orthogonal to l1,l2,l3,l8), and the
# pins above touch only l1, l2, l3, l8 -- so a sign flip on l5 or l7, a swap of
# l4 and l6, or a 45-degree rotation of (l4,l6) passes everything above.
# Each pin below plus Hermiticity plus tr(la la) = 2 determines the generator
# uniquely: two off-diagonal entries of modulus 1 already exhaust the norm.
assert_eq(f64_eq(HComplex_re(cmat_get(gell_mann(3), 0, 2)), F64_ONE), 1, "l4(0,2) = +1");
assert_eq(f64_eq(HComplex_im(cmat_get(gell_mann(3), 0, 2)), 0), 1, "l4(0,2) im = 0");
assert_eq(f64_eq(HComplex_re(cmat_get(gell_mann(3), 1, 2)), 0), 1, "l4(1,2) = 0");
assert_eq(f64_eq(HComplex_im(cmat_get(gell_mann(4), 0, 2)), f64_neg(F64_ONE)), 1, "l5(0,2) = -i");
assert_eq(f64_eq(HComplex_re(cmat_get(gell_mann(4), 0, 2)), 0), 1, "l5(0,2) re = 0");
assert_eq(f64_eq(HComplex_re(cmat_get(gell_mann(5), 1, 2)), F64_ONE), 1, "l6(1,2) = +1");
assert_eq(f64_eq(HComplex_re(cmat_get(gell_mann(5), 0, 2)), 0), 1, "l6(0,2) = 0");
assert_eq(f64_eq(HComplex_im(cmat_get(gell_mann(6), 1, 2)), f64_neg(F64_ONE)), 1, "l7(1,2) = -i");
assert_eq(f64_eq(HComplex_re(cmat_get(gell_mann(6), 1, 2)), 0), 1, "l7(1,2) re = 0");

# --- (5) algebra closure: [l_a, l_b] = 2i sum_c f_abc l_c ----------------
# The identity that actually ties the matrices to the algebra, over all 64
# pairs and all 9 entries. Also the first coverage su3_structure_constant
# (src/lie.cyr) had: when this landed in 2.7.0 no suite called it, so the table
# and the matrices had never been checked against each other. (tests/abuse.tcyr
# has called it with out-of-range indices since 2.9.0.) Exact in double:
# 2 * (sqrt3/2) * (1/sqrt3) == 1.0 and 2 * (sqrt3/2) * (-2/sqrt3) == -2.0 bit for
# bit, so the tolerance is slack.
var l_gm_sc_bad = 0;
var _gm_u = 0;
while (_gm_u < 8) {
    var _gm_v = 0;
    while (_gm_v < 8) {
        var l_gm_lhs = cmat_commutator(gell_mann(_gm_u), gell_mann(_gm_v));
        var l_gm_rhs = cmat_new(3, 3);
        var _gm_c = 0;
        while (_gm_c < 8) {
            var l_gm_f = su3_structure_constant(_gm_u + 1, _gm_v + 1, _gm_c + 1);
            if (f64_eq(l_gm_f, 0) == 0) {
                var l_gm_w = cx_new(0, f64_mul(F64_TWO, l_gm_f));
                l_gm_rhs = cmat_add(l_gm_rhs, cmat_scale(gell_mann(_gm_c), l_gm_w));
            }
            _gm_c = _gm_c + 1;
        }
        var _gm_r = 0;
        while (_gm_r < 3) {
            var _gm_s = 0;
            while (_gm_s < 3) {
                var l_gm_lv = cmat_get(l_gm_lhs, _gm_r, _gm_s);
                var l_gm_rv = cmat_get(l_gm_rhs, _gm_r, _gm_s);
                var l_gm_dr = f64_abs(f64_sub(HComplex_re(l_gm_lv), HComplex_re(l_gm_rv)));
                var l_gm_di = f64_abs(f64_sub(HComplex_im(l_gm_lv), HComplex_im(l_gm_rv)));
                if (f64_lt(l_gm_dr, GM_TR_TOL) == 0) { l_gm_sc_bad = l_gm_sc_bad + 1; }
                if (f64_lt(l_gm_di, GM_TR_TOL) == 0) { l_gm_sc_bad = l_gm_sc_bad + 1; }
                _gm_s = _gm_s + 1;
            }
            _gm_r = _gm_r + 1;
        }
        _gm_v = _gm_v + 1;
    }
    _gm_u = _gm_u + 1;
}
assert_eq(l_gm_sc_bad, 0, "gell-mann [la,lb] = 2i f_abc lc (64 pairs, 9 entries, re+im)");

# ----------------------------------------------------------------
test_group("lie: Lorentz");

# Identity transforms (t,0,0,0) -> (t,0,0,0)
var l_lor_id = lorentz_identity();
var l_tv4 = alloc(32);
store64(l_tv4, F64_ONE); store64(l_tv4 + 8, 0); store64(l_tv4 + 16, 0); store64(l_tv4 + 24, 0);
var l_tv4_out = lorentz_transform_4vec(l_lor_id, l_tv4);
assert_eq(load64(l_tv4_out), f64_from(1), "lorentz id t");
assert_eq(load64(l_tv4_out + 8), f64_from(0), "lorentz id x");

# Boost validity: a boost should satisfy Lambda^T eta Lambda = eta
var l_boost = lorentz_boost_x(F64_HALF);
assert_eq(lorentz_is_valid(l_boost), 1, "boost is valid");
# lorentz_boost_x takes RAPIDITY, not velocity: Lambda^0_0 = cosh(0.5) and
# Lambda^1_0 = sinh(0.5). If it ever silently reverts to reading the argument as
# beta, those become gamma = 1.1547005383792517 and gamma*beta = 0.5773502691896258
# -- 0.027 and 0.056 away, both far outside 1e-15. The compose-inverse and
# interval-preservation checks below hold under EITHER reading, so they cannot
# see that regression; these two can.
var _cosh_half = 0x3FF20AC1862AE8D0;  # cosh(0.5) = 1.1276259652063807
var _sinh_half = 0x3FE0ACD00FE63B97;  # sinh(0.5) = 0.5210953054937474
assert(f64_lt(f64_abs(f64_sub(m4_get(l_boost, 0, 0), _cosh_half)), ULP_TOL_M) == 1,
  "boost_x(0.5)[0][0] == cosh(0.5)");
assert(f64_lt(f64_abs(f64_sub(m4_get(l_boost, 1, 0), _sinh_half)), ULP_TOL_M) == 1,
  "boost_x(0.5)[1][0] == sinh(0.5)");

# Compose inverse = identity (approx)
var l_boost_inv = lorentz_inv(l_boost);
var l_comp = lorentz_compose(l_boost, l_boost_inv);
# Diagonal should be ~1, off-diagonal ~0
# cosh^2 - sinh^2 = 1 in closed form; measured residual 2.22e-16 (1 ulp). The old
# bound of 1.0 accepted any [0][0] in [0, 2]. Check an off-diagonal too, or a
# lorentz_inv that returned the identity would leave [0][0] = cosh(0.5) = 1.128
# and still pass.
assert(f64_lt(f64_abs(f64_sub(m4_get(l_comp, 0, 0), F64_ONE)), ULP_TOL_M) == 1,
  "lorentz compose inv [0][0] == 1 (1e-15)");
assert(f64_lt(f64_abs(f64_sub(m4_get(l_comp, 1, 1), F64_ONE)), ULP_TOL_M) == 1,
  "lorentz compose inv [1][1] == 1 (1e-15)");
assert(f64_lt(f64_abs(m4_get(l_comp, 0, 1)), ULP_TOL_M) == 1, "lorentz compose inv [0][1] == 0");

# Preserves Minkowski interval
var l_tv4b = alloc(32);
store64(l_tv4b, f64_from(5)); store64(l_tv4b + 8, f64_from(3));
store64(l_tv4b + 16, 0); store64(l_tv4b + 24, 0);
var l_intv_before = minkowski_interval(l_tv4b);
var l_tv4b_out = lorentz_transform_4vec(l_boost, l_tv4b);
var l_intv_after = minkowski_interval(l_tv4b_out);
var l_intv_diff = f64_abs(f64_sub(l_intv_before, l_intv_after));
# Pin the interval itself: 5^2 - 3^2 = 16 exactly. A (-,+,+,+) signature would
# give -16 and the before/after DIFFERENCE would still be 0, so the preservation
# check alone is blind to a global sign flip.
assert_eq(l_intv_before, f64_from(16), "minkowski interval of (5,3,0,0) == +16");
# Boosted by rapidity 0.5: t' = 5cosh+3sinh = 7.201415742513145,
# x' = 5sinh+3cosh = 5.988354423087879, t'^2 - x'^2 = 15.999999999999993.
# Measured drift 7.105e-15 = 4 ulp of 16. The old bound of 1.0 was a 6.25%
# relative tolerance on a quantity of magnitude 16.
assert(f64_lt(l_intv_diff, IVL_TOL_M) == 1, "lorentz preserves interval (1e-13)");
# (5,3,0,0) leaves y and z at zero, so dropping either spatial term is invisible
# to both the +16 pin and the 1e-13 drift bound -- verified across all four suites.
var _mv = alloc(32);
store64(_mv, f64_from(5)); store64(_mv + 8, f64_from(3));
store64(_mv + 16, f64_from(4)); store64(_mv + 24, F64_TWO);
# 25 - 9 - 16 - 4 = -4
assert_eq(minkowski_interval(_mv), f64_neg(f64_from(4)), "interval(5,3,4,2) == -4");
var _mo = lorentz_transform_4vec(l_boost, _mv);
assert(f64_lt(f64_abs(f64_sub(minkowski_interval(_mo), minkowski_interval(_mv))), TOL_1EM12) == 1,
  "boost preserves interval(5,3,4,2)");

# ⭐ 3.3.4 — THE BOOST ENTRIES BIT FOR BIT. ganita 1.2.11 (cyrius 6.6.13) re-derived
# sinh and cosh, and no assertion saw it: the boost_x(0.5) checks above compare
# through a tolerance, and built against 6.6.12 the five suites failed only the atan2
# pins in edge_cases.tcyr. sinh is now computed on |x| and re-signed: below 22 it is
# fdlibm's expm1 form, which removes the cancellation in (e^x - e^-x)/2 (6.6.12 was
# 285 ulp off at 1e-3); from 22 up it is e^|x|/2, which past 709 takes a power of 2
# out of the exponential instead of rounding |x| - ln 2 (6.6.12 was 453 ulp off one
# ulp above 709, 459 at 710.4). cosh is computed on |x| as well, so it is even bit
# for bit, and shares the form past 709. Each pin below is the CORRECTLY ROUNDED
# value by an 80-digit Decimal oracle (two exp routes, cross-checked), and each one
# FAILS when built against cyrius 6.6.12 (ganita 1.2.9), whose value is in the
# message. A value the new code does not round correctly is never pinned -- a later
# ganita improvement would fail it -- so the parity checks at the end assert the
# identity, not the bits. cosh, and both entries from 22 up, go through
# f64_exp, which is x87 on x86_64 and a polyfill on aarch64: these were measured on
# x86_64.
# [measured: scratch harness and Decimal oracle, not reproducible in-tree, 2026-10-03; cycc 6.6.12 and 6.6.14]
# Below 1, the expm1 branch. At -1e-3, 6.6.12 also missed cosh's mirror by an ulp.
var l_hy_s = lorentz_boost_x(0x3F50624DD2F1A9FC);   # fl(1e-3)
assert_eq(m4_get(l_hy_s, 1, 0), 0x3F50624E00C1C9E3,
  "boost_x(1e-3) sinh entry, correctly rounded (6.6.12: ...CB00)");
var l_hy_sn = lorentz_boost_x(0xBF50624DD2F1A9FC);  # fl(-1e-3)
assert_eq(m4_get(l_hy_sn, 1, 0), 0xBF50624E00C1C9E3,
  "boost_x(-1e-3) sinh entry, correctly rounded (6.6.12: ...CA00)");
assert_eq(m4_get(l_hy_sn, 0, 0), 0x3FF000008637BDC1,
  "boost_x(-1e-3) cosh entry, correctly rounded (6.6.12: ...BDC2)");
# From 1 to 22, the other expm1 branch: a positive rapidity, and a negative one whose
# cosh 6.6.12 built from the rounded 1/exp(x).
assert_eq(m4_get(lorentz_boost_x(0x3FF6666666666666), 1, 0), 0x3FFE7804D9E7541C,
  "boost_x(1.4) sinh entry, correctly rounded (6.6.12: ...541D)");
var l_hy_m = lorentz_boost_x(0xC00A666666666666);   # fl(-3.3)
assert_eq(m4_get(l_hy_m, 0, 0), 0x402B2647145E3E5A,
  "boost_x(-3.3) cosh entry, correctly rounded (6.6.12: ...3E59)");
assert_eq(m4_get(l_hy_m, 1, 0), 0xC02B1364BAA2B89C,
  "boost_x(-3.3) sinh entry, correctly rounded (6.6.12: ...B89B)");
# lorentz_boost_y and lorentz_boost_z make the same two calls; without these four
# pins either could revert to the old formula and every suite would still pass.
# [measured: scratch mutants of lorentz_boost_y/z, not reproducible in-tree, 2026-10-03; cycc 6.6.14]
var l_hy_my = lorentz_boost_y(0xC00A666666666666);
assert_eq(m4_get(l_hy_my, 0, 0), 0x402B2647145E3E5A, "boost_y(-3.3) cosh entry, correctly rounded (6.6.12: ...3E59)");
assert_eq(m4_get(l_hy_my, 2, 0), 0xC02B1364BAA2B89C, "boost_y(-3.3) sinh entry, correctly rounded (6.6.12: ...B89B)");
var l_hy_mz = lorentz_boost_z(0xC00A666666666666);
assert_eq(m4_get(l_hy_mz, 0, 0), 0x402B2647145E3E5A, "boost_z(-3.3) cosh entry, correctly rounded (6.6.12: ...3E59)");
assert_eq(m4_get(l_hy_mz, 3, 0), 0xC02B1364BAA2B89C, "boost_z(-3.3) sinh entry, correctly rounded (6.6.12: ...B89B)");
# From 22 to 709 only a negative rapidity moved; through the general lorentz_boost,
# whose unit x direction multiplies sinh by exactly 1.
var l_hy_g = lorentz_boost(hvec3_unit_x(), 0xC058F33333333333);   # fl(-99.8)
assert_eq(m4_get(l_hy_g, 0, 0), 0x48DF949FE9B1C7E5,
  "lorentz_boost(x, -99.8) cosh entry, correctly rounded (6.6.12: ...C7E6)");
assert_eq(m4_get(l_hy_g, 1, 0), 0xC8DF949FE9B1C7E5,
  "lorentz_boost(x, -99.8) sinh entry, correctly rounded (6.6.12: ...C7E6)");
# Near overflow: one ulp above 709, where e^|x|/2 is 0.5 exp(|x|), and 710.4, past
# exp's own overflow at ~709.78, where it is exp(|x| - 2043 ln 2) 2^2042.
var l_hy_o = lorentz_boost_x(0x4086280000000001);
assert_eq(m4_get(l_hy_o, 0, 1), 0x7FCD422D2BE5E043,
  "boost_x(709 + 1 ulp) sinh entry, correctly rounded (6.6.12: ...E208)");
assert_eq(m4_get(l_hy_o, 0, 0), 0x7FCD422D2BE5E043,
  "boost_x(709 + 1 ulp) cosh entry, correctly rounded (6.6.12: ...E208)");
assert_eq(m4_get(lorentz_boost_x(0x4086333333333333), 0, 0), 0x7FEDA98A7371610B,
  "boost_x(710.4) cosh entry, correctly rounded (6.6.12: ...62D6)");
# PARITY, as the identity: boost_x(-eta) is the inverse boost, so its cosh entry must
# equal boost_x(eta)'s and its sinh entry must be the exact negative. 6.6.12 computed
# both on the signed eta and broke both here by an ulp. Not pinned: the cosh at this
# eta is 0.75 ulp from the truth on 6.6.14 (it was 0.25 on 6.6.12's negative side).
# [measured: scratch harness and Decimal oracle, not reproducible in-tree, 2026-10-03; cycc 6.6.12 and 6.6.14]
var l_hy_e = 0x3FF07289649A1BE6;   # 1.0279630594029583
var l_hy_ep = lorentz_boost_x(l_hy_e);
var l_hy_em = lorentz_boost_x(f64_neg(l_hy_e));
assert_eq(m4_get(l_hy_em, 0, 0), m4_get(l_hy_ep, 0, 0),
  "boost_x(-eta) cosh entry == boost_x(eta)'s, bit for bit (6.6.12: 1 ulp apart)");
assert_eq(m4_get(l_hy_em, 1, 0), f64_neg(m4_get(l_hy_ep, 1, 0)),
  "boost_x(-eta) sinh entry == -boost_x(eta)'s, bit for bit (6.6.12: 1 ulp apart)");
# The same identity over 251 rapidities, fl(3e-8) times fl(1.1) per step up to 668.8:
# 182 below 1, 33 in 1..22, 36 in 22..709. Past 709 both pins work on |x| already.
# The expected count is the population, so an emptied loop fails too. 6.6.12 keeps
# cosh even at 205 of them and sinh odd at 152.
# [measured: scratch harness, not reproducible in-tree, 2026-10-03; cycc 6.6.12 and 6.6.14]
var l_hy_x = 0x3E601B2B29A4692B;   # fl(3e-8)
var l_hy_ce = 0;
var l_hy_so = 0;
var l_hy_p = 0;
var l_hy_q = 0;
while (f64_lt(l_hy_x, 0x4086333333333333) == 1) {   # 710.4
    l_hy_p = lorentz_boost_x(l_hy_x);
    l_hy_q = lorentz_boost_x(f64_neg(l_hy_x));
    if (m4_get(l_hy_q, 0, 0) == m4_get(l_hy_p, 0, 0)) { l_hy_ce = l_hy_ce + 1; }
    if (m4_get(l_hy_q, 1, 0) == f64_neg(m4_get(l_hy_p, 1, 0))) { l_hy_so = l_hy_so + 1; }
    l_hy_x = f64_mul(l_hy_x, 0x3FF199999999999A);   # fl(1.1)
}
assert_eq(l_hy_ce, 251, "cosh entry even bit for bit at all 251 sweep rapidities (6.6.12: 205)");
assert_eq(l_hy_so, 251, "sinh entry odd bit for bit at all 251 sweep rapidities (6.6.12: 152)");

# ================================================================
# DIFFERENTIAL GEOMETRY (~10)
# ================================================================
test_group("diffgeo: flat metric");

# Flat 2D Euclidean: g_inv = diag(1,1), all metric derivs = 0
var dg_metric_inv = alloc(32);
store64(dg_metric_inv, F64_ONE); store64(dg_metric_inv + 8, 0);
store64(dg_metric_inv + 16, 0); store64(dg_metric_inv + 24, F64_ONE);

var dg_deriv = alloc(64);
var _dg_i = 0;
while (_dg_i < 8) { store64(dg_deriv + _dg_i * 8, 0); _dg_i = _dg_i + 1; }

var dg_chris = christoffel_symbols(dg_metric_inv, dg_deriv, 2);
assert_eq(christoffel_get(dg_chris, 2, 0, 0, 0), f64_from(0), "flat Gamma^0_00=0");
assert_eq(christoffel_get(dg_chris, 2, 1, 0, 1), f64_from(0), "flat Gamma^1_01=0");
assert_eq(christoffel_get(dg_chris, 2, 0, 1, 0), f64_from(0), "flat Gamma^0_10=0");
assert_eq(christoffel_get(dg_chris, 2, 1, 1, 1), f64_from(0), "flat Gamma^1_11=0");

# ----------------------------------------------------------------
# christoffel_symbols with a metric that actually CURVES (2.8.3)
#
# Both call sites in the suite (here and tests/hisab.tcyr) passed an all-zero
# metric_deriv array. With d_k g_ij == 0 the bracket d1 + d2 - d3 is 0 for every
# index and the whole formula in christoffel_symbols (src/diffgeo.cyr) -- the
# lambda contraction, the three derivative permutations, the sign on d3, the
# factor 1/2 -- collapses to "return zeros". Replacing the body with
# `store64(out + off, 0)` kept the suite green. The flat-metric assertions above
# are still worth keeping (a Christoffel symbol that is nonzero in flat space is
# a real defect) but they certify only that.

test_group("diffgeo: curved metric");

# (a) UNIT 2-SPHERE, g = diag(1, sin^2 th), coordinates (th, phi), at th = pi/3.
# The only nonvanishing derivative is d_th g_phiphi = 2 sin th cos th = sin(2 th),
# which at th = pi/3 is sqrt(3)/2 exactly (2 cos(pi/3) == 1). Closed forms from
# any textbook, independent of this implementation:
#     Gamma^th_phiphi = -sin th cos th = -sqrt(3)/4
#     Gamma^phi_thphi =  cot th        =  1/sqrt(3)
# and every other component is zero. This exercises g^{a lambda} with a != 0,
# the -d3 term (Gamma^th_phiphi comes from d3 alone) and the +d1 term
# (Gamma^phi_thphi comes from d1 alone).
var _s2_ginv = alloc(32);
store64(_s2_ginv, F64_ONE);                          # g^{th th} = 1
store64(_s2_ginv + 8, 0);
store64(_s2_ginv + 16, 0);
store64(_s2_ginv + 24, 0x3FF5555555555555);          # g^{phi phi} = 1/sin^2(pi/3) = 4/3
var _s2_dg = alloc(64);
var _s2_i = 0;
while (_s2_i < 8) { store64(_s2_dg + _s2_i * 8, 0); _s2_i = _s2_i + 1; }
# metric_deriv[(i*dim + j)*dim + k] = d_k g_ij -> (i,j,k) = (1,1,0) is index 6
store64(_s2_dg + 6 * 8, 0x3FEBB67AE8584CAA);         # d_th g_phiphi = sqrt(3)/2
var _s2_ch = christoffel_symbols(_s2_ginv, _s2_dg, 2);
assert_neq(_s2_ch, 0, "2-sphere: christoffel_symbols allocates");
var _s2_gam011 = 0xBFDBB67AE8584CAA;                 # -sqrt(3)/4 = -0.4330127018922193
var _s2_gam101 = 0x3FE279A74590331D;                 # 1/sqrt(3) =  0.5773502691896258
assert_eq(christoffel_get(_s2_ch, 2, 0, 1, 1), _s2_gam011,
  "2-sphere: Gamma^th_phiphi == -sqrt(3)/4 bit-exact");
assert_eq(f64_lt(f64_abs(f64_sub(christoffel_get(_s2_ch, 2, 1, 0, 1), _s2_gam101)),
    ULP_TOL_M), 1, "2-sphere: Gamma^phi_thphi == cot(pi/3) == 1/sqrt(3)");
assert_eq(f64_lt(f64_abs(f64_sub(christoffel_get(_s2_ch, 2, 1, 1, 0), _s2_gam101)),
    ULP_TOL_M), 1, "2-sphere: Gamma^phi_phith == Gamma^phi_thphi (symmetric in mu,nu)");
assert_eq(christoffel_get(_s2_ch, 2, 0, 0, 0), 0, "2-sphere: Gamma^th_thth == 0");
assert_eq(christoffel_get(_s2_ch, 2, 0, 0, 1), 0, "2-sphere: Gamma^th_thphi == 0");
assert_eq(christoffel_get(_s2_ch, 2, 1, 0, 0), 0, "2-sphere: Gamma^phi_thth == 0");
assert_eq(christoffel_get(_s2_ch, 2, 1, 1, 1), 0, "2-sphere: Gamma^phi_phiphi == 0");

# (b) GENERIC 2-METRIC, every input nonzero and every input DYADIC, so the whole
# contraction stays inside binary floating point and the answer is bit-exact --
# no tolerance, no rounding argument. g^{ij} = [[2, 1/2], [1/2, 3]] (off-diagonal
# nonzero, so the lambda sum is live); d_k g_ij runs over 1/2, 1/4, 3/4, 1/8,
# 5/8, 7/8 with the (i,j) symmetry a metric derivative must have. The eight
# expected values were computed by an independent exact-rational evaluation of
# the published formula (python3 fractions.Fraction), not by this code:
#   Gamma^0 = [[13/16, 13/32], [13/32, -5/32]]   Gamma^1 = [[2, 1], [1, 39/32]]
# Sign-flipping d3, dropping d3, permuting d3's indices or dropping the 1/2 each
# change all EIGHT entries.  (Swapping d1 and d2 is a genuine no-op: the bracket
# is symmetric under mu <-> nu, which is why Gamma is too.)
var _gm_ginv = alloc(32);
store64(_gm_ginv, F64_TWO);                                  # g^{00} = 2
store64(_gm_ginv + 8, F64_HALF);                             # g^{01} = 1/2
store64(_gm_ginv + 16, F64_HALF);                            # g^{10} = 1/2
store64(_gm_ginv + 24, f64_from(3));                         # g^{11} = 3
var _gm_dg = alloc(64);
store64(_gm_dg + 0 * 8, F64_HALF);                           # d_0 g_00 = 1/2
store64(_gm_dg + 1 * 8, 0x3FD0000000000000);                 # d_1 g_00 = 1/4
store64(_gm_dg + 2 * 8, 0x3FE8000000000000);                 # d_0 g_01 = 3/4
store64(_gm_dg + 3 * 8, 0x3FC0000000000000);                 # d_1 g_01 = 1/8
store64(_gm_dg + 4 * 8, 0x3FE8000000000000);                 # d_0 g_10 = 3/4
store64(_gm_dg + 5 * 8, 0x3FC0000000000000);                 # d_1 g_10 = 1/8
store64(_gm_dg + 6 * 8, 0x3FE4000000000000);                 # d_0 g_11 = 5/8
store64(_gm_dg + 7 * 8, 0x3FEC000000000000);                 # d_1 g_11 = 7/8
var _gm_ch = christoffel_symbols(_gm_ginv, _gm_dg, 2);
assert_neq(_gm_ch, 0, "generic metric: christoffel_symbols allocates");
assert_eq(christoffel_get(_gm_ch, 2, 0, 0, 0), 0x3FEA000000000000, "generic: Gamma^0_00 == 13/16");
assert_eq(christoffel_get(_gm_ch, 2, 0, 0, 1), 0x3FDA000000000000, "generic: Gamma^0_01 == 13/32");
assert_eq(christoffel_get(_gm_ch, 2, 0, 1, 0), 0x3FDA000000000000, "generic: Gamma^0_10 == 13/32");
assert_eq(christoffel_get(_gm_ch, 2, 0, 1, 1), 0xBFC4000000000000, "generic: Gamma^0_11 == -5/32");
assert_eq(christoffel_get(_gm_ch, 2, 1, 0, 0), 0x4000000000000000, "generic: Gamma^1_00 == 2");
assert_eq(christoffel_get(_gm_ch, 2, 1, 0, 1), 0x3FF0000000000000, "generic: Gamma^1_01 == 1");
assert_eq(christoffel_get(_gm_ch, 2, 1, 1, 0), 0x3FF0000000000000, "generic: Gamma^1_10 == 1");
assert_eq(christoffel_get(_gm_ch, 2, 1, 1, 1), 0x3FF3800000000000, "generic: Gamma^1_11 == 39/32");

test_group("diffgeo: flat metric (continued)");

# Riemann from flat (all zero christoffel derivs -> all zero riemann)
var dg_chris_deriv = alloc(128);
var _dg_j = 0;
while (_dg_j < 16) { store64(dg_chris_deriv + _dg_j * 8, 0); _dg_j = _dg_j + 1; }
var dg_riemann = riemann_tensor(dg_chris, dg_chris_deriv, 2);
assert_eq(riemann_get(dg_riemann, 2, 0, 0, 0, 1), f64_from(0), "flat Riemann=0");
assert_eq(riemann_get(dg_riemann, 2, 1, 0, 0, 1), f64_from(0), "flat Riemann b=0");

# Ricci tensor (all zero)
var dg_ricci = ricci_tensor(dg_riemann, 2);
assert_eq(ricci_get(dg_ricci, 2, 0, 0), f64_from(0), "flat Ricci=0");

# Ricci scalar = 0
var dg_scalar = ricci_scalar(dg_ricci, dg_metric_inv, 2);
assert_eq(dg_scalar, f64_from(0), "flat scalar=0");

# Einstein tensor (R_mn - 1/2 R g_mn, but R=0 and all R_mn=0 -> 0)
var dg_metric = alloc(32);
store64(dg_metric, F64_ONE); store64(dg_metric + 8, 0);
store64(dg_metric + 16, 0); store64(dg_metric + 24, F64_ONE);
var dg_einstein = einstein_tensor(dg_ricci, dg_metric, dg_metric_inv, 2);
assert_eq(load64(dg_einstein), f64_from(0), "flat Einstein=0");

# ----------------------------------------------------------------
test_group("diffgeo: wedge product");

# alpha=(1,0), beta=(0,1) -> wedge = 1
var dg_alpha = alloc(16);
store64(dg_alpha, F64_ONE); store64(dg_alpha + 8, 0);
var dg_beta = alloc(16);
store64(dg_beta, 0); store64(dg_beta + 8, F64_ONE);
var dg_w = wedge_1_1(dg_alpha, dg_beta, 2);
assert_eq(load64(dg_w), f64_from(1), "wedge e1^e2=1");

# Antisymmetry: alpha ^ alpha = 0
var dg_w2 = wedge_1_1(dg_alpha, dg_alpha, 2);
assert_eq(load64(dg_w2), f64_from(0), "wedge alpha^alpha=0");

# ================================================================
# SYMBOLIC (~15)
# ================================================================
test_group("symbolic: evaluate");

# Evaluate constant
var s_c = expr_const(f64_from(42));
var s_empty = vec_new();
assert_eq(expr_eval(s_c, s_empty), f64_from(42), "eval const");

# Evaluate variable
var s_x = expr_var(str_from("x"));
var s_binds = vec_new();
vec_push(s_binds, expr_bind(str_from("x"), f64_from(7)));
assert_eq(expr_eval(s_x, s_binds), f64_from(7), "eval var");

# Evaluate x^2 + 3 at x=2 -> 7
var s_x2 = expr_mul(s_x, s_x);
var s_e = expr_add(s_x2, expr_const(f64_from(3)));
var s_binds2 = vec_new();
vec_push(s_binds2, expr_bind(str_from("x"), f64_from(2)));
assert_eq(expr_eval(s_e, s_binds2), f64_from(7), "eval x^2+3 at 2");

# Evaluate sin(0) = 0
var s_sin0 = expr_sin(expr_const(0));
assert_eq(expr_eval(s_sin0, s_empty), f64_from(0), "eval sin(0)");

# Evaluate exp(0) = 1
var s_exp0 = expr_exp(expr_const(0));
assert_eq(expr_eval(s_exp0, s_empty), f64_from(1), "eval exp(0)");

# ----------------------------------------------------------------
test_group("symbolic: differentiate");

# d/dx(const) = 0
var s_dc = expr_diff(expr_const(f64_from(5)), str_from("x"));
assert_eq(expr_eval(s_dc, s_empty), f64_from(0), "diff const=0");

# d/dx(x) = 1
var s_dx = expr_diff(expr_var(str_from("x")), str_from("x"));
assert_eq(expr_eval(s_dx, s_binds2), f64_from(1), "diff x=1");

# d/dx(x^2) at x=2 -> 4
var s_dx2 = expr_simplify(expr_diff(s_x2, str_from("x")));
assert_eq(expr_eval(s_dx2, s_binds2), f64_from(4), "diff x^2 at 2 = 4");

# d/dx(sin(x)) at x=0 -> cos(0) = 1
var s_sin_x = expr_sin(expr_var(str_from("x")));
var s_dsin = expr_simplify(expr_diff(s_sin_x, str_from("x")));
var s_binds0 = vec_new();
vec_push(s_binds0, expr_bind(str_from("x"), 0));
assert_eq(expr_eval(s_dsin, s_binds0), f64_from(1), "diff sin at 0 = cos(0)=1");

# d/dx(exp(x)) at x=0 -> exp(0) = 1
var s_exp_x = expr_exp(expr_var(str_from("x")));
var s_dexp = expr_simplify(expr_diff(s_exp_x, str_from("x")));
assert_eq(expr_eval(s_dexp, s_binds0), f64_from(1), "diff exp at 0 = 1");

# ----------------------------------------------------------------
test_group("symbolic: simplify");

# 0 + x = x
var s_xv = expr_var(str_from("x"));
var s_zero_plus = expr_add(expr_const(0), s_xv);
var s_sp = expr_simplify(s_zero_plus);
assert_eq(expr_tag(s_sp), EXPR_VAR, "0+x -> var");

# 1 * x = x
var s_one_mul = expr_mul(expr_const(F64_ONE), s_xv);
var s_sp2 = expr_simplify(s_one_mul);
assert_eq(expr_tag(s_sp2), EXPR_VAR, "1*x -> var");

# 0 * x = 0
var s_zero_mul = expr_mul(expr_const(0), s_xv);
var s_sp3 = expr_simplify(s_zero_mul);
assert_eq(expr_tag(s_sp3), EXPR_CONST, "0*x -> const");

# x^0 = 1
var s_pow0 = expr_pow(s_xv, expr_const(0));
var s_sp4 = expr_simplify(s_pow0);
assert_eq(expr_tag(s_sp4), EXPR_CONST, "x^0 -> const");
assert_eq(expr_eval(s_sp4, s_empty), f64_from(1), "x^0 = 1");

# x^1 = x
var s_pow1 = expr_pow(s_xv, expr_const(F64_ONE));
var s_sp5 = expr_simplify(s_pow1);
assert_eq(expr_tag(s_sp5), EXPR_VAR, "x^1 -> var");

# --x = x (double negation)
var s_dblneg = expr_neg(expr_neg(s_xv));
var s_sp6 = expr_simplify(s_dblneg);
assert_eq(expr_tag(s_sp6), EXPR_VAR, "--x -> var");

# ----------------------------------------------------------------
test_group("symbolic: to_str");

var s_str_c = expr_to_str(expr_const(f64_from(42)));
assert(str_eq(s_str_c, str_from("42")) == 1, "to_str const 42");

var s_str_v = expr_to_str(expr_var(str_from("y")));
assert(str_eq(s_str_v, str_from("y")) == 1, "to_str var y");

# === 3.3.3 R3c: expr_to_str wraps a leading minus in a power's base and a negation's child ===
test_group("3.3.3 R3c: expr_to_str wraps a leading minus in a power's base and a negation's child");
# Through 3.3.2 a power's base or a negation's child whose text starts with '-' was
# written bare. A base then read as another expression, (-2)^x as "(-2^x)" (minus
# 2^x); a child kept its value but not its form, neg(-3) as "--3", a decrement in
# C-like syntax. sym_to_latex wraps the same positions (3.3.3 W5); for a constant
# and a negation this is its rule in expr_to_str's notation, keyed on the TEXT (a
# variable named "-a" is wrapped here and not there). The 3.3.2 rendering is in
# each message.
# [measured: scratch probe against dist/hisab.cyr 3.3.2, cycc 6.6.12, 2026-10-01]
var r3c_x = expr_var(str_from("x"));
var r3c_y = expr_var(str_from("y"));
var r3c_m3 = expr_const(f64_neg(f64_from(3)));
var r3c_two = expr_const(F64_TWO);
# A power's base, from a constant and from a negation:
assert_eq(str_eq_cstr(expr_to_str(expr_pow(expr_const(f64_neg(F64_TWO)), r3c_x)), "((-2)^x)"), 1,
  "R3c expr_to_str: (-2)^x (3.3.2: (-2^x))");
assert_eq(str_eq_cstr(expr_to_str(expr_pow(expr_neg(r3c_x), r3c_two)), "((-x)^2)"), 1,
  "R3c expr_to_str: neg(x)^2 (3.3.2: (-x^2))");
assert_eq(str_eq_cstr(expr_to_str(expr_pow(r3c_m3, expr_const(f64_neg(F64_ONE)))), "((-3)^-1)"), 1,
  "R3c expr_to_str: (-3)^(-1), the exponent unwrapped (3.3.2: (-3^-1))");
assert_eq(str_eq_cstr(expr_to_str(expr_pow(expr_neg(expr_pow(r3c_x, r3c_two)), r3c_two)), "((-(x^2))^2)"), 1,
  "R3c expr_to_str: neg(x^2)^2, not -(x^2)^2 (3.3.2: (-(x^2)^2))");
assert_eq(str_eq_cstr(expr_to_str(expr_pow(expr_const(0xBFE0000000000000), r3c_x)), "((-0.500000)^x)"), 1,
  "R3c expr_to_str: (-0.5)^x (3.3.2: (-0.500000^x))");
# A negation's child:
assert_eq(str_eq_cstr(expr_to_str(expr_neg(r3c_m3)), "-(-3)"), 1, "R3c expr_to_str: neg(-3) (3.3.2: --3)");
assert_eq(str_eq_cstr(expr_to_str(expr_add(r3c_x, expr_neg(r3c_m3))), "(x + -(-3))"), 1,
  "R3c expr_to_str: x + neg(-3) (3.3.2: (x + --3))");
assert_eq(str_eq_cstr(expr_to_str(expr_neg(expr_neg(r3c_y))), "-(-y)"), 1,
  "R3c expr_to_str: neg(neg(y)) (3.3.2: --y)");
assert_eq(str_eq_cstr(expr_to_str(expr_neg(expr_neg(expr_neg(r3c_x)))), "-(-(-x))"), 1,
  "R3c expr_to_str: neg(neg(neg(x))), every level (3.3.2: ---x)");
assert_eq(str_eq_cstr(expr_to_str(expr_neg(expr_const(0xFFF0000000000000))), "-(-inf)"), 1,
  "R3c expr_to_str: neg(-inf) (3.3.2: --inf)");
assert_eq(str_eq_cstr(expr_to_str(expr_neg(expr_const(0xFFF8000000000000))), "-(-nan)"), 1,
  "R3c expr_to_str: neg(-nan), a sign-bit NaN's text (3.3.2: --nan)");
# The test is the text's first byte: a variable named "-a" is wrapped, -0 ("0") is not,
# and a zero-length name is never read, even when the byte its view points at is '-'.
var r3c_ma = str_from("-a");
assert_eq(str_eq_cstr(expr_to_str(expr_pow(expr_var(r3c_ma), r3c_two)), "((-a)^2)"), 1,
  "R3c expr_to_str: a variable named -a as a base is wrapped (3.3.2: (-a^2))");
assert_eq(str_eq_cstr(expr_to_str(expr_pow(expr_var(str_sub(r3c_ma, 0, 0)), r3c_two)), "(^2)"), 1,
  "R3c expr_to_str: a zero-length base text is not wrapped (unchanged)");
assert_eq(str_eq_cstr(expr_to_str(expr_neg(expr_var(str_sub(r3c_ma, 0, 0)))), "-"), 1,
  "R3c expr_to_str: a zero-length child text is not wrapped (unchanged)");
assert_eq(str_eq_cstr(expr_to_str(expr_pow(expr_const(1 << 63), r3c_x)), "(0^x)"), 1,
  "R3c expr_to_str: (-0)^x, the text 0 has no minus (unchanged)");
assert_eq(str_eq_cstr(expr_to_str(expr_neg(expr_const(1 << 63))), "-0"), 1,
  "R3c expr_to_str: neg(-0) (unchanged)");
# Unchanged: an exponent, a product's or sum's operand, a base or child that starts
# with '(' or a letter.
assert_eq(str_eq_cstr(expr_to_str(expr_pow(r3c_x, r3c_m3)), "(x^-3)"), 1, "R3c expr_to_str: x^(-3) (unchanged)");
assert_eq(str_eq_cstr(expr_to_str(expr_mul(r3c_x, r3c_m3)), "(x * -3)"), 1, "R3c expr_to_str: x * -3 (unchanged)");
assert_eq(str_eq_cstr(expr_to_str(expr_add(r3c_x, r3c_m3)), "(x + -3)"), 1, "R3c expr_to_str: x + -3 (unchanged)");
assert_eq(str_eq_cstr(expr_to_str(expr_neg(expr_add(r3c_x, r3c_y))), "-(x + y)"), 1,
  "R3c expr_to_str: neg(x + y) (unchanged)");
assert_eq(str_eq_cstr(expr_to_str(expr_neg(r3c_x)), "-x"), 1, "R3c expr_to_str: neg(x) (unchanged)");
assert_eq(str_eq_cstr(expr_to_str(expr_pow(expr_pow(r3c_x, r3c_two), r3c_y)), "((x^2)^y)"), 1,
  "R3c expr_to_str: (x^2)^y (unchanged)");
assert_eq(str_eq_cstr(expr_to_str(expr_pow(expr_sin(r3c_m3), r3c_two)), "(sin(-3)^2)"), 1,
  "R3c expr_to_str: sin(-3)^2 (unchanged)");

# ================================================================
# AUTODIFF (~10)
# ================================================================
# --- 2.11.0: every dual_* derivative against central differences ------------
#
# THE CHECK RUN BEFORE ANY REVERSE-MODE CODE WAS WRITTEN, and the fourth release
# running in which that move found defects in shipped code. Reverse mode is
# validated against forward mode, so a wrong dual_* would have been inherited
# wholesale and then "confirmed" by agreement.
#
# ⚠ THE FD SWEEP ALONE FOUND NOTHING, and that is the point worth recording. At
# every input where a guard fires, the perturbed SCALAR is NaN too, so the sample
# is skipped and the guard is never asked. Five defects sat behind guards that no
# amount of finite differencing could reach; they need direct interrogation,
# which is what the block below the sweep does.
var _AD_BAD = 0;
var _AD_RUN = 0;

fn _ad_fd_cmp(analytic, lo, hi, h) {
    if (f64_eq(lo, lo) == 0) { return 0; }         # scalar undefined here
    if (f64_eq(hi, hi) == 0) { return 0; }
    _AD_RUN = _AD_RUN + 1;
    var fd = f64_div(f64_sub(hi, lo), f64_mul(F64_TWO, h));
    var scale = f64_max(F64_ONE, f64_max(f64_abs(analytic), f64_abs(fd)));
    if (f64_lt(f64_abs(f64_sub(analytic, fd)), f64_mul(scale, LOOSE_TOL_M)) == 1) { return 0; }
    return 1;
}

fn _ad_fd_sweep() {
    # ⚠ h is SCALE-RELATIVE. An absolute 1e-6 straddles the kink of abs and the
    # pole of 1/x at small x, which produced two "mismatches" in the first draft
    # that were the fixture's fault, not the code's.
    var pts = alloc(24);
    store64(pts,     F64_TWO);
    store64(pts + 8, f64_div(F64_ONE, F64_TWO));
    store64(pts + 16, f64_div(f64_from(7), f64_from(3)));
    var k = f64_div(f64_from(7), F64_TWO);
    for (var pi = 0; pi < 3; pi = pi + 1) {
        var x = load64(pts + pi * 8);
        var h = f64_mul(f64_abs(x), _JT_H);
        var xl = f64_sub(x, h);
        var xh = f64_add(x, h);
        var v = dual_var(x);
        var c = dual_const(k);
        _AD_BAD = _AD_BAD + _ad_fd_cmp(Dual_deriv(dual_add(v, c)),
          f64_add(xl, k), f64_add(xh, k), h);
        _AD_BAD = _AD_BAD + _ad_fd_cmp(Dual_deriv(dual_sub(v, c)),
          f64_sub(xl, k), f64_sub(xh, k), h);
        _AD_BAD = _AD_BAD + _ad_fd_cmp(Dual_deriv(dual_mul(v, c)),
          f64_mul(xl, k), f64_mul(xh, k), h);
        _AD_BAD = _AD_BAD + _ad_fd_cmp(Dual_deriv(dual_div(v, c)),
          f64_div(xl, k), f64_div(xh, k), h);
        _AD_BAD = _AD_BAD + _ad_fd_cmp(Dual_deriv(dual_div(c, v)),
          f64_div(k, xl), f64_div(k, xh), h);
        _AD_BAD = _AD_BAD + _ad_fd_cmp(Dual_deriv(dual_neg(v)),
          f64_neg(xl), f64_neg(xh), h);
        _AD_BAD = _AD_BAD + _ad_fd_cmp(Dual_deriv(dual_sin(v)), f64_sin(xl), f64_sin(xh), h);
        _AD_BAD = _AD_BAD + _ad_fd_cmp(Dual_deriv(dual_cos(v)), f64_cos(xl), f64_cos(xh), h);
        _AD_BAD = _AD_BAD + _ad_fd_cmp(Dual_deriv(dual_exp(v)), f64_exp(xl), f64_exp(xh), h);
        _AD_BAD = _AD_BAD + _ad_fd_cmp(Dual_deriv(dual_ln(v)), f64_ln(xl), f64_ln(xh), h);
        _AD_BAD = _AD_BAD + _ad_fd_cmp(Dual_deriv(dual_sqrt(v)), f64_sqrt(xl), f64_sqrt(xh), h);
        _AD_BAD = _AD_BAD + _ad_fd_cmp(Dual_deriv(dual_pow(v, k)),
          ganita_f64_pow(xl, k), ganita_f64_pow(xh, k), h);
        _AD_BAD = _AD_BAD + _ad_fd_cmp(Dual_deriv(dual_abs(v)), f64_abs(xl), f64_abs(xh), h);
    }
    return 0;
}

test_group("2.11.0 autodiff: every dual_* derivative matches central differences");
_ad_fd_sweep();
assert_eq(_AD_RUN, 39, "the dual FD sweep ran 13 ops x 3 points and skipped none of them");
assert_eq(_AD_BAD, 0, "every dual_* derivative agrees with a central difference of its own scalar");

# --- 2.11.0: reverse mode against BOTH oracles -------------------------------
#
# f(x0..x3) = x0*x1 + sin(x2)*exp(x3/x0) - sqrt(|x1|) + x2^3
#
# Four inputs, ten ops, and x0 and x1 each feed MORE THAN ONE consumer -- which
# is the part that matters. A chain where every node has one consumer never
# exercises the reverse ACCUMULATION (adjoints summing), and that is the only
# thing the reverse sweep does that forward mode does not.
#
# ⚠ AGREEMENT WITH FORWARD MODE IS NOT SUFFICIENT ON ITS OWN. The two share the
# domain guards, so agreement is partly tautological. Central differences of the
# plain scalar are the independent oracle and are checked alongside.
fn _rv_scalar(x0, x1, x2, x3) {
    var a = f64_mul(x0, x1);
    var b = f64_mul(f64_sin(x2), f64_exp(f64_div(x3, x0)));
    var c = f64_sqrt(f64_abs(x1));
    var d = f64_mul(f64_mul(x2, x2), x2);
    return f64_add(f64_sub(f64_add(a, b), c), d);
}

fn _rv_fwd(x0, x1, x2, x3, which) {
    var d0 = dual_const(x0); var d1 = dual_const(x1);
    var d2 = dual_const(x2); var d3 = dual_const(x3);
    if (which == 0) { d0 = dual_var(x0); }
    if (which == 1) { d1 = dual_var(x1); }
    if (which == 2) { d2 = dual_var(x2); }
    if (which == 3) { d3 = dual_var(x3); }
    var a = dual_mul(d0, d1);
    var b = dual_mul(dual_sin(d2), dual_exp(dual_div(d3, d0)));
    var c = dual_sqrt(dual_abs(d1));
    var d = dual_pow(d2, f64_from(3));
    return Dual_deriv(dual_add(dual_sub(dual_add(a, b), c), d));
}

var _RV_BAD = 0;
var _RV_RUN = 0;

fn _rv_sweep() {
    var xs = alloc(32);
    store64(xs,      f64_div(f64_from(3), F64_TWO));
    store64(xs + 8,  f64_div(f64_from(7), f64_from(4)));
    store64(xs + 16, f64_div(F64_ONE, f64_from(3)));
    store64(xs + 24, f64_div(f64_from(5), f64_from(6)));
    var t = ad_tape_new(64);
    var ids = alloc(32);
    for (var i = 0; i < 4; i = i + 1) { store64(ids + i * 8, ad_var(t, load64(xs + i * 8))); }
    var i0 = load64(ids); var i1 = load64(ids + 8);
    var i2 = load64(ids + 16); var i3 = load64(ids + 24);
    var a = ad_mul(t, i0, i1);
    var b = ad_mul(t, ad_sin(t, i2), ad_exp(t, ad_div(t, i3, i0)));
    var c = ad_sqrt(t, ad_abs(t, i1));
    var d = ad_pow(t, i2, f64_from(3));
    var root = ad_add(t, ad_sub(t, ad_add(t, a, b), c), d);
    var _rv_t, _rv_v = ad_grad(t, root);
    if (is_err_result(_rv_t) == 1) { _RV_BAD = _RV_BAD + 100; return 0; }
    for (var i = 0; i < 4; i = i + 1) {
        _RV_RUN = _RV_RUN + 2;
        var rev = ad_grad_of(t, load64(ids + i * 8));
        var fwd = _rv_fwd(load64(xs), load64(xs + 8), load64(xs + 16), load64(xs + 24), i);
        if (f64_approx_eq(rev, fwd, LOOSE_TOL_M) == 0) { _RV_BAD = _RV_BAD + 1; }
        var h = f64_mul(f64_abs(load64(xs + i * 8)), _JT_H);
        var lo = alloc(32);
        var hi = alloc(32);
        for (var k = 0; k < 4; k = k + 1) {
            store64(lo + k * 8, load64(xs + k * 8));
            store64(hi + k * 8, load64(xs + k * 8));
        }
        store64(lo + i * 8, f64_sub(load64(xs + i * 8), h));
        store64(hi + i * 8, f64_add(load64(xs + i * 8), h));
        var fd = f64_div(f64_sub(
            _rv_scalar(load64(hi), load64(hi + 8), load64(hi + 16), load64(hi + 24)),
            _rv_scalar(load64(lo), load64(lo + 8), load64(lo + 16), load64(lo + 24))),
          f64_mul(F64_TWO, h));
        if (f64_approx_eq(rev, fd, LOOSE_TOL_M) == 0) { _RV_BAD = _RV_BAD + 1; }
    }
    # The VALUE too: a tape that computes the wrong function would still agree
    # with a forward pass over the same wrong function.
    _RV_RUN = _RV_RUN + 1;
    if (f64_approx_eq(ad_val(t, root),
        _rv_scalar(load64(xs), load64(xs + 8), load64(xs + 16), load64(xs + 24)),
        LOOSE_TOL_M) == 0) { _RV_BAD = _RV_BAD + 1; }
    return 0;
}

# --- 2.11.0: the pairing with optimize.cyr, end to end ----------------------
#
# The reason the roadmap gave for reverse mode before 2.11.0: the solvers require a
# caller-supplied gradient, and an n-input objective means writing one by hand or
# running n forward passes. A capturing closure holding a tape matches the
# existing `fncall2(grad, x, out)` signature exactly -- no API change.
#
# ⚠ CHECKED BEFORE ANY OF THIS WAS WRITTEN, and this time it found nothing: all
# four solvers return HSB_ERR_NONE only from `if (f64_lt(gnorm, tol) == 1)`, so a
# 0 return asserts ||grad|| < tol at out_x, and 16 runs across two objectives and
# both gradient sources honoured it. Recorded because a clean result from that
# check is worth as much as a dirty one -- it is the fifth release it has been
# run and the first to come back empty.
#
# ⚠ AND THE POINT OF DRIVING THE SOLVERS WITH BOTH GRADIENTS: checking a solver
# with the same `grad` it was handed cannot see a WRONG grad -- it would converge
# confidently to the wrong point and pass. The hand-written and tape-backed runs
# reaching the same minimiser is what makes the check independent.
var _OPT_TAPE = 0;

fn _ot_f_bowl(x) {
    var a = f64_sub(load64(x), F64_ONE);
    var b = f64_sub(load64(x + 8), F64_TWO);
    return f64_add(f64_mul(a, a), f64_mul(b, b));
}

fn _ot_g_hand(x, out) {
    store64(out, f64_mul(F64_TWO, f64_sub(load64(x), F64_ONE)));
    store64(out + 8, f64_mul(F64_TWO, f64_sub(load64(x + 8), F64_TWO)));
    return 0;
}

# The tape-backed gradient, written as a plain fn here rather than a closure so
# the assertion does not depend on closure support; the closure form is in the
# module header and is what a consumer writes. Both compile to the same call.
fn _ot_g_tape(x, out) {
    ad_tape_reset(_OPT_TAPE);
    var ids = alloc(16);
    var i0 = ad_var(_OPT_TAPE, load64(x));
    var i1 = ad_var(_OPT_TAPE, load64(x + 8));
    store64(ids, i0);
    store64(ids + 8, i1);
    var a = ad_sub(_OPT_TAPE, i0, ad_const(_OPT_TAPE, F64_ONE));
    var b = ad_sub(_OPT_TAPE, i1, ad_const(_OPT_TAPE, F64_TWO));
    var root = ad_add(_OPT_TAPE, ad_mul(_OPT_TAPE, a, a), ad_mul(_OPT_TAPE, b, b));
    return ad_grad_into(_OPT_TAPE, root, ids, 2, out);
}

var _OT_BAD = 0;
var _OT_RUN = 0;

fn _ot_drive(solver, gp, tol) {
    var x0 = alloc(16);
    store64(x0, f64_neg(f64_div(F64_ONE, F64_TWO)));
    store64(x0 + 8, f64_div(f64_from(5), F64_TWO));
    var ox = alloc(16);
    var of = alloc(8);
    # ⚠ 3.0.0 — a dispatch that ASSIGNED each solver's rc into one variable cannot
    # survive the migration as written: `rc = f(...)` drops the payload. Each arm
    # binds both halves and records success in a plain flag, which keeps the
    # sentinel property the `0 - 99` initialiser was there for — an unmatched
    # `solver` still counts as a failure rather than silently passing.
    var ok = 0;
    if (solver == 0) {
        var t0, v0 = opt_gradient_descent(&_ot_f_bowl, gp, x0, 2,
          f64_div(F64_ONE, f64_from(1000)), tol, 200000, ox, of);
        ok = is_ok(t0);
    }
    if (solver == 1) {
        var t1, v1 = opt_conjugate_gradient(&_ot_f_bowl, gp, x0, 2, tol, 200000, ox, of);
        ok = is_ok(t1);
    }
    if (solver == 2) {
        var t2, v2 = opt_bfgs(&_ot_f_bowl, gp, x0, 2, tol, 200000, ox, of);
        ok = is_ok(t2);
    }
    if (solver == 3) {
        var t3, v3 = opt_lbfgs(&_ot_f_bowl, gp, x0, 2, 5, tol, 200000, ox, of);
        ok = is_ok(t3);
    }
    _OT_RUN = _OT_RUN + 1;
    if (ok != 1) { _OT_BAD = _OT_BAD + 1; return 0; }
    # THE SOLVER'S OWN CONTRACT: a 0 return claims ||grad|| < tol at out_x.
    # Bound, not bare: `gp` may be a capturing closure (see the 3.3.1 block below).
    var g = alloc(16);
    var g_rc = fncall2(gp, ox, g);
    var gn = f64_sqrt(f64_add(f64_mul(load64(g), load64(g)),
        f64_mul(load64(g + 8), load64(g + 8))));
    if (f64_lt(gn, tol) != 1) { _OT_BAD = _OT_BAD + 1; return 0; }
    # AND it landed on the known minimiser (1, 2), which the contract alone does
    # not guarantee -- a wrong gradient satisfies its own norm test happily.
    #
    # ⚠ THE TOLERANCE IS DERIVED FROM THE CONTRACT, not picked. For this bowl
    # grad = 2(x - x*), so ||g|| < tol means ||x - x*|| < tol/2. The first draft
    # asserted LOOSE_TOL_M (1e-8) and failed on gradient descent, which stops at
    # ||g|| < 1e-6 and therefore lands 5e-7 away -- exactly as promised. The
    # ASSERTION was wrong, not the solver: it demanded more than the contract
    # offers, and the other three solvers hid that by converging far tighter.
    var want = f64_mul(tol, F64_HALF);
    if (f64_approx_eq(load64(ox), F64_ONE, want) == 0) { _OT_BAD = _OT_BAD + 1; }
    if (f64_approx_eq(load64(ox + 8), F64_TWO, want) == 0) { _OT_BAD = _OT_BAD + 1; }
    return 0;
}

test_group("2.11.0 autodiff x optimize: a tape-backed gradient drives all four solvers");
_OPT_TAPE = ad_tape_new(64);
var ot_tol = F64_ONE;
for (var i = 0; i < 6; i = i + 1) { ot_tol = f64_div(ot_tol, f64_from(10)); }
for (var sv = 0; sv < 4; sv = sv + 1) { _ot_drive(sv, &_ot_g_hand, ot_tol); }
for (var sv = 0; sv < 4; sv = sv + 1) { _ot_drive(sv, &_ot_g_tape, ot_tol); }
assert_eq(_OT_RUN, 8, "four solvers x two gradient sources");
assert_eq(_OT_BAD, 0,
  "every solver converges to (1,2) with a REVERSE-MODE gradient, and honours ||g|| < tol there");

# --- 3.3.1: the header's closure recipe, compiled as written -----------------
#
# The recipe in autodiff.cyr's header is a CAPTURING CLOSURE, and through 3.3.0 no
# test compiled one: `_ot_g_tape` above is a plain fn "so the assertion does not
# depend on closure support". That premise hid two defects. The recipe's
# `return ad_grad_into(...)` would not compile once a helper fn built it and another
# fn bound the helper's result, on any pin 6.6.3-6.6.14. And on cycc 6.6.2-6.6.4 the
# solvers' bare `fncall2(grad, ...);` statements SIGSEGVed with it (exit 139 under 6.6.3).
# [measured: docs/development/issues/2026-10-03-cyrius-closure-stack-return-blamed-on-enclosing-fn.md]
# This builds the closure inside a helper fn, the form that failed to compile,
# exactly as the header now writes it, and drives all four solvers with it. The
# 6.6.2-6.6.4 half cannot be seen from this suite's 6.6.14 pin; CI's
# bare-`fncall` step is what guards it.
fn _ot_make_closure_grad(tape) {
    var grad = |x, out| {
        ad_tape_reset(tape);
        var ids = alloc(16);
        var i0 = ad_var(tape, load64(x));
        var i1 = ad_var(tape, load64(x + 8));
        store64(ids, i0);
        store64(ids + 8, i1);
        var a = ad_sub(tape, i0, ad_const(tape, F64_ONE));
        var b = ad_sub(tape, i1, ad_const(tape, F64_TWO));
        var root = ad_add(tape, ad_mul(tape, a, a), ad_mul(tape, b, b));
        var gt, gv = ad_grad_into(tape, root, ids, 2, out);
        return 0;
    };
    return grad;
}

# ⚠ The closure is built and bound INSIDE a fn, the way a consumer's main() does.
# That placement is what makes this test able to fail: with the old recipe's
# `return ad_grad_into(...)`, cycc reports `var g = _ot_make_closure_grad(...)`
# inside a fn as an ERROR ("bind both"), but the same bind at top level only as a
# WARNING, which no suite fails on. The first draft bound it at top level and the
# reverted recipe passed all 2323 assertions.
fn _ot_drive_closure_recipe(tol) {
    var grad = _ot_make_closure_grad(ad_tape_new(64));
    for (var sv = 0; sv < 4; sv = sv + 1) { _ot_drive(sv, grad, tol); }
    return 0;
}

test_group("3.3.1 autodiff x optimize: the header's closure recipe, as written");
_OT_RUN = 0;
_OT_BAD = 0;
_ot_drive_closure_recipe(ot_tol);
assert_eq(_OT_RUN, 4, "four solvers driven by the header's closure recipe");
assert_eq(_OT_BAD, 0, "the closure recipe converges to (1,2) in every solver and honours ||g|| < tol there");

# ad_grad_write is the piece that removes a per-variable store64 from every call
# site; it is reached here through ad_grad_into's tail call. Checked against the
# closed-form adjoints of x*y at (3, 5): d/dx = 5 and d/dy = 3.
var ow_t = ad_tape_new(16);
var ow_ids = alloc(16);
var ow_a = ad_var(ow_t, f64_from(3));
var ow_b = ad_var(ow_t, f64_from(5));
store64(ow_ids, ow_a);
store64(ow_ids + 8, ow_b);
var ow_root = ad_mul(ow_t, ow_a, ow_b);
var ow_out = alloc(16);
# ⚠ 3.3.1 — these three sites read only the TAG (Ok = 0, Err = 1) because
# check-result-migration.sh could not see that ad_grad_into returns a Result: it
# has no `return Ok(` of its own, only `?` and a tail call. Both halves now.
var _owt, _owv = ad_grad_into(ow_t, ow_root, ow_ids, 2, ow_out);
assert_eq(is_ok(_owt), 1, "ad_grad_into succeeds");
assert_eq(_owv, 0, "ad_grad_into's Ok payload is 0");
assert(f64_approx_eq(load64(ow_out), f64_from(5), LOOSE_TOL_M),
  "ad_grad_into wrote d(xy)/dx = y = 5 into slot 0");
assert(f64_approx_eq(load64(ow_out + 8), f64_from(3), LOOSE_TOL_M),
  "and d(xy)/dy = x = 3 into slot 1 -- slot ORDER follows the caller's ids, not the tape");

# ⚠ THE FIXTURE ABOVE CANNOT SEE AN `ids` INDIRECTION BUG, and a mutant proved
# it: replacing `ad_grad_of(t, load64(ids + k * 8))` with `ad_grad_of(t, k)`
# survives, because there the variables happen to BE nodes 0 and 1. The whole
# purpose of `ids` is that they need not be. This fixture puts two constants
# first and reverses the order, so ids = {3, 2} and no index coincides with its
# slot.
var oz_t = ad_tape_new(16);
var oz_c1 = ad_const(oz_t, f64_from(9));
var oz_c2 = ad_const(oz_t, f64_from(9));
var oz_y = ad_var(oz_t, f64_from(5));          # node 2
var oz_x = ad_var(oz_t, f64_from(3));          # node 3
assert_eq(oz_x, 3, "the fixture really does put a variable at node 3");
var oz_ids = alloc(16);
store64(oz_ids, oz_x);                          # slot 0 <- node 3
store64(oz_ids + 8, oz_y);                      # slot 1 <- node 2
var oz_out = alloc(16);
var _ozt, _ozv = ad_grad_into(oz_t, ad_mul(oz_t, oz_x, oz_y), oz_ids, 2, oz_out);
assert_eq(is_ok(_ozt), 1, "ad_grad_into on a tape whose variables are not the first nodes");
assert(f64_approx_eq(load64(oz_out), f64_from(5), LOOSE_TOL_M),
  "slot 0 holds d/dx = 5, read through ids -- NOT the adjoint of node 0");
assert(f64_approx_eq(load64(oz_out + 8), f64_from(3), LOOSE_TOL_M),
  "slot 1 holds d/dy = 3, with ids REVERSED relative to tape order");

# ⚠ And ad_grad_into must PROPAGATE the sweep's error rather than writing
# whatever adjoints happen to be lying around. Another surviving mutant: dropping
# the error check on the sweep (an `if (rc != 0) { return rc; }` then, the `?` on
# `ad_grad(...)` since 3.0.0) changed nothing, because nothing called it with a
# bad root.
var oz_bad = alloc(16);
store64(oz_bad, f64_from(77));
store64(oz_bad + 8, f64_from(77));
var _obt, _obv = ad_grad_into(oz_t, AD_FULL, oz_ids, 2, oz_bad);
assert_eq(is_err_result(_obt), 1, "ad_grad_into on a bad root returns the sweep's error");
assert_eq(_obv, HSB_ERR_INVALID_INPUT, "and the payload is ad_grad's own HSB_ERR_INVALID_INPUT, forwarded intact");
assert_eq(load64(oz_bad), f64_from(77),
  "and it wrote NOTHING -- the caller's buffer still holds its own sentinel");

test_group("2.11.0 autodiff reverse mode: gradient matches forward mode AND finite differences");
_rv_sweep();
assert_eq(_RV_RUN, 9, "the reverse sweep compared 4 inputs x 2 oracles, plus the value");
assert_eq(_RV_BAD, 0,
  "one reverse sweep reproduces all four partials, against duals and against central differences");

# A FULL tape must report, not silently drop an operation -- the shape of defect
# this library keeps finding. The error propagates: an op CONSUMING a bad index
# is itself bad, so a caller that checks only the final index is still safe.
var rv_small = ad_tape_new(3);
var rv_a = ad_var(rv_small, F64_ONE);
var rv_b = ad_var(rv_small, F64_TWO);
var rv_c = ad_add(rv_small, rv_a, rv_b);
assert_eq(rv_c, 2, "the third node fits in a tape of capacity 3");
var rv_d = ad_add(rv_small, rv_c, rv_a);
assert_eq(rv_d, AD_FULL, "the fourth returns AD_FULL, not a silently dropped node");
assert_eq(ad_ok(rv_small, rv_d), 0, "and ad_ok rejects it");
assert_eq(ad_mul(rv_small, rv_d, rv_a), AD_FULL, "an op consuming a bad index is itself AD_FULL");
assert_eq(ad_tape_len(rv_small), 3, "and the tape did not grow past its capacity");

# ⚠ ad_grad must clear the WHOLE adjoint array, not just up to `root`. A second
# gradient from a SHORTER root would otherwise read the previous sweep's values
# on every node above it. Asserted because the optimisation is tempting.
var rv_t2 = ad_tape_new(16);
var rv_x = ad_var(rv_t2, f64_from(3));
var rv_y = ad_var(rv_t2, f64_from(5));
var rv_big = ad_mul(rv_t2, rv_x, rv_y);
var rv_top = ad_mul(rv_t2, rv_big, rv_x);          # x^2 * y, d/dx = 2xy = 30
var _rq83t, _rq83v = ad_grad(rv_t2, rv_top);
assert_eq(is_ok(_rq83t), 1, "gradient of the tall root");
assert(f64_approx_eq(ad_grad_of(rv_t2, rv_x), f64_from(30), LOOSE_TOL_M),
  "d/dx of x^2*y at (3,5) is 30");
var _rq84t, _rq84v = ad_grad(rv_t2, rv_big);
assert_eq(is_ok(_rq84t), 1, "now a gradient from a SHORTER root");
assert(f64_approx_eq(ad_grad_of(rv_t2, rv_x), f64_from(5), LOOSE_TOL_M),
  "d/dx of x*y is 5 -- not 30 left over from the previous sweep");
assert_eq(ad_grad_of(rv_t2, rv_top), f64_from(0),
  "and the node ABOVE the new root has adjoint 0, not its stale 1");

# ad_tape_reset lets a caller run many gradients on one tape. The bump allocator
# never frees, so allocating a tape per iteration is a leak, not a style choice.
ad_tape_reset(rv_t2);
assert_eq(ad_tape_len(rv_t2), 0, "ad_tape_reset empties the tape without reallocating");

test_group("2.11.0 autodiff: the guards, asked DIRECTLY (the FD sweep cannot reach them)");
# dual_div: 1/1e-13 = 1e13 is exactly representable. The old guard fired at
# |b| < EPSILON_F64 and fabricated BOTH a value and a derivative.
var ad_e13 = F64_ONE;
for (var i = 0; i < 13; i = i + 1) { ad_e13 = f64_div(ad_e13, f64_from(10)); }
var ad_q = dual_div(dual_const(F64_ONE), dual_var(ad_e13));
assert(f64_approx_eq(f64_div(Dual_val(ad_q), f64_from(10000000000)), f64_from(1000), LOOSE_TOL_M),
  "dual_div: 1/1e-13 is 1e13, not a fabricated 0");
# ln's domain is v > 0. The old guard tested f64_abs(v), so a NEGATIVE passed it
# and dual_ln(-5) came back (NaN, -0.2) -- a NaN value with a CONFIDENT finite
# derivative, which is worse than either alone.
var ad_ln5 = dual_ln(dual_var(f64_neg(f64_from(5))));
assert_eq(Dual_val(ad_ln5), f64_from(0), "dual_ln(-5): value is the miss sentinel, not NaN");
assert_eq(Dual_deriv(ad_ln5), f64_from(0),
  "dual_ln(-5): derivative is 0, not a confident -0.2 beside a NaN value");
var ad_ln13 = dual_ln(dual_var(ad_e13));
assert(f64_approx_eq(Dual_val(ad_ln13), f64_neg(f64_div(f64_from(299336), f64_from(10000))),
    f64_div(F64_ONE, f64_from(1000))), "dual_ln(1e-13) is -29.9336, not a fabricated 0");
# sqrt computed s BEFORE its guard, so a negative was already NaN.
var ad_sq = dual_sqrt(dual_var(f64_neg(f64_from(4))));
assert_eq(Dual_val(ad_sq), f64_from(0), "dual_sqrt(-4): value is the miss sentinel, not NaN");
assert_eq(Dual_deriv(ad_sq), f64_from(0), "dual_sqrt(-4): derivative likewise");
# pow: under ganita 1.0.4 f64_pow was exp(n*ln(base)) and therefore NaN for every
# non-positive base. x^3 is a polynomial and differentiable everywhere.
#
# ⚠ THE PARENTHETICALS THESE TWO ASSERTIONS USED TO CARRY ARE NOW FALSE. They read
# "(f64_pow(0,0) is NaN)" and "(f64_pow rejects negative bases)"; ganita 1.1.4
# (cyrius 6.5.33) fixed both upstream, so an assertion message was asserting
# something about the stdlib that the stdlib had stopped doing. The assertions
# themselves are unchanged and still correct -- since 3.2.2 dual_pow takes ganita's
# pow directly outside three exact IEEE cases (see src/autodiff.cyr).
assert_eq(Dual_deriv(dual_pow(dual_var(0), F64_ONE)), f64_from(1),
  "dual_pow: d/dx x^1 at 0 is 1");
assert_eq(Dual_deriv(dual_pow(dual_var(f64_neg(F64_TWO)), f64_from(3))), f64_from(12),
  "dual_pow: d/dx x^3 at -2 is 12");
assert_eq(Dual_val(dual_pow(dual_var(f64_neg(F64_TWO)), f64_from(4))), f64_from(16),
  "dual_pow: (-2)^4 is 16 by repeated multiplication");
# ⚠ AND THE CONTROL: a case where NaN is the RIGHT answer must still be NaN, or
# the repair has simply replaced one fabrication with another.
assert_eq(f64_eq(Dual_val(dual_pow(dual_var(f64_neg(F64_TWO)), F64_HALF)),
    Dual_val(dual_pow(dual_var(f64_neg(F64_TWO)), F64_HALF))), 0,
  "dual_pow: (-2)^0.5 is still NaN -- the repair did not widen the domain, it fixed the integers");

test_group("2.11.2 stdlib: the f64_pow domain moved under us (ganita 1.0.4 -> 1.1.4)");

# ⚠ THE UPGRADE TO cyrius 6.5.33 CHANGED BEHAVIOUR NO HISAB COMMIT TOUCHED. ganita
# 1.1.4 fixed `f64_pow` upstream -- zero base, zero exponent, and negative base with
# an integral exponent are now special-cased instead of falling into
# `exp(n*ln(base))` and coming back NaN. They are here so the new domain is a
# checked contract: hisab has public entry points sitting directly on it, and a
# silent revert upstream would otherwise reintroduce a NaN nobody was watching for.
#
# ⚠ DISCRIMINATION MEASURED, NOT ASSERTED. The whole group was re-run against a
# checkout still holding ganita 1.0.4: 10 of these 12 assertions FAIL there. The
# two that passed on both sides were the two CONTROLS -- (-2)^0.5 still NaN, and
# the then-loop's (-2)^4 still exactly 16 -- which is what a control is for. A group
# where every line flipped would mean the controls were not controls.
# [measured: 2026-08-21, ganita 1.0.4 vs 1.1.4, same test file]
assert_eq(f64_eq(ganita_f64_pow(f64_neg(F64_TWO), f64_from(3)),
    ganita_f64_pow(f64_neg(F64_TWO), f64_from(3))), 1,
  "ganita_f64_pow(-2,3) is a number, not NaN (was NaN under ganita 1.0.4)");
assert_eq(f64_to(f64_round(ganita_f64_pow(f64_neg(F64_TWO), f64_from(3)))), 0 - 8,
  "ganita_f64_pow(-2,3) rounds to -8");
assert_eq(ganita_f64_pow(f64_from(0), f64_from(0)), f64_from(1),
  "ganita_f64_pow(0,0) is 1, the conventional value (was NaN)");
assert_eq(ganita_f64_pow(f64_neg(F64_TWO), f64_from(0)), f64_from(1),
  "ganita_f64_pow(-2,0) is 1 -- x^0 wins over the negative-base case");
# ⚠ AND THE CONTROL, same shape as the one above it: the domain must have widened
# EXACTLY as far as the integers. A non-integral exponent on a negative base has no
# real value and must still be NaN, or upstream replaced one fabrication with another.
assert_eq(f64_eq(ganita_f64_pow(f64_neg(F64_TWO), F64_HALF),
    ganita_f64_pow(f64_neg(F64_TWO), F64_HALF)), 0,
  "ganita_f64_pow(-2,0.5) is still NaN -- the domain widened to the integers, not past them");

# ⭐ ganita's pow is EXACT on a representable integer power -- since 1.2.8 (cyrius
# 6.6.10) through fdlibm's e_pow core, which replaced 1.2.4's binary exponentiation.
# Under ganita 1.1.4 these read 15 and -7 through a truncating `f64_to`; that history
# is in the CHANGELOG (2.11.2, 2.11.3).
# [measured: tests/modules.tcyr, the ganita_f64_pow(-2,4) bit-exact assertion directly below]
assert_eq(ganita_f64_pow(f64_neg(F64_TWO), f64_from(4)), f64_from(16),
  "ganita_f64_pow(-2,4) is BIT-EXACT 16.0");
assert_eq(ganita_f64_pow(F64_TWO, f64_from(10)), f64_from(1024), "ganita_f64_pow(2,10) bit-exact 1024");
assert_eq(ganita_f64_pow(f64_neg(F64_TWO), f64_from(3)), f64_neg(f64_from(8)),
  "ganita_f64_pow(-2,3) bit-exact -8 (was -7 through the exp/ln path)");
assert_eq(ganita_f64_pow(f64_neg(F64_TWO), f64_from(5)), f64_neg(f64_from(32)),
  "ganita_f64_pow(-2,5) bit-exact -32");

test_group("3.2.2 autodiff: dual_pow / ad_pow take ganita's pow, and stop fabricating zeros");

# ⛔ `_ad_pow`'s REPEATED-MULTIPLICATION LOOP IS RETIRED (src/autodiff.cyr says why).
# ganita 1.2.8's pow is within 1 ulp of truth on all 2088 (base, n) pairs of the 3.2.2
# sweep, where the loop was worse on 1110 -- and the loop fabricated zeros. Every
# assertion below goes through a PUBLIC entry point. Reinstating the 3.2.1 loop fails
# the four value assertions in (1) and (2); the tape comparison shares _ad_pow and
# cannot see it, and (3)-(5) hold under either implementation by design -- they pin
# the fast path and the special values, which the loop also got right.
# [measured: scratch mutant, 2026-09-30 -- 2250/2254 with the 3.2.1 loop installed]
#
# (1) Accuracy where the loop was weakest. 0.9^1024 against a 60-digit reference: the
# loop landed 7 ulp out, ganita 1.2.4's binary exponentiation 137, ganita 1.2.8 is
# correctly rounded. Asserted to ganita's documented bound, 1 ulp.
var apw_b = f64_div(f64_from(9), f64_from(10));
var apw_truth = 0x36346060685B7366;   # 0.9^1024 = 1.394214727062403e-47
assert(_tc_ulp_gap(Dual_val(dual_pow(dual_var(apw_b), f64_from(1024))), apw_truth) <= 1,
  "dual_pow(0.9,1024) is within 1 ulp of truth (the retired loop was 7 out)");

# (2) THE FABRICATED ZERO. For a negative n the loop formed base^|n| and returned its
# reciprocal, so where base^|n| OVERFLOWS but base^n is a representable subnormal it
# returned 0: 201 of 36,864 (base, n) pairs, e.g. 10^-309 .. 10^-323 and 2^-1024.
# [measured: scratch harness, not reproducible in-tree, 2026-09-30]
var apw_ten = f64_from(10);
var apw_sub = 0x000012688B70E62B;     # 10^-310, correctly rounded (a subnormal)
var apw_d310 = dual_pow(dual_var(apw_ten), f64_from(0 - 310));
assert(_tc_ulp_gap(Dual_val(apw_d310), apw_sub) <= 1,
  "dual_pow(10,-310) is 1e-310, not a fabricated 0 (10^310 overflows; 10^-310 does not)");
assert_eq(f64_lt(Dual_deriv(apw_d310), 0), 1,
  "dual_pow(10,-310) derivative is -310 * 10^-311 < 0, not a fabricated -0");
assert_eq(Dual_val(dual_pow(dual_var(F64_TWO), f64_from(0 - 1024))), 0x0004000000000000,
  "dual_pow(2,-1024) is exactly 2^-1024 (a subnormal), not a fabricated 0");
# The tape shares _ad_pow, so the reverse mode agrees with the forward mode bit for bit.
var apw_tp = ad_tape_new(8);
var apw_tx = ad_var(apw_tp, apw_ten);
assert_eq(ad_val(apw_tp, ad_pow(apw_tp, apw_tx, f64_from(0 - 310))), Dual_val(apw_d310),
  "ad_pow(10,-310) matches dual_pow bit for bit");

# (3) The fast path is exact where it is taken: x^2, x^1 and x^-1 are ONE IEEE
# operation, the C99 pow value including the special cases.
# (A mutant returning 1 for x^1 survived the first draft of this block: nothing read
# x^1 or d/dx x^2, which is 2 * x^1. Both are asserted now, and x^-1 on a NEGATIVE
# base, since 1/|x| passed the positive one.)
var apw_x = f64_div(f64_from(7), f64_from(3));
assert_eq(Dual_val(dual_pow(dual_var(apw_x), F64_TWO)), f64_mul(apw_x, apw_x), "dual_pow(x,2) is x*x");
assert_eq(Dual_deriv(dual_pow(dual_var(apw_x), F64_TWO)), f64_mul(F64_TWO, apw_x), "d/dx x^2 is 2x");
assert_eq(Dual_val(dual_pow(dual_var(apw_x), F64_ONE)), apw_x, "dual_pow(x,1) is x");
assert_eq(Dual_val(dual_pow(dual_var(f64_neg(apw_x)), f64_neg(F64_ONE))), f64_div(F64_ONE, f64_neg(apw_x)),
  "dual_pow(-x,-1) is 1/(-x)");
assert_eq(Dual_val(dual_pow(dual_var(0x8000000000000000), f64_neg(F64_ONE))), 0xFFF0000000000000,
  "dual_pow(-0,-1) is -Inf (C99: the sign of the zero survives an odd exponent)");

# (4) THE GUARD THAT FABRICATED 1.0 (2.11.4). The loop truncated n with `f64_to`, and
# below cyrius 6.6.8 x86 returned i64::MIN for 1e300; negating i64::MIN gives it back,
# so a bound checked after the truncation read false, the loop never ran and (-2)^1e300
# came back 1.0 where the answer is +Inf. No loop remains, but the values stay pinned:
# they are the cases a reintroduced integer path would get wrong first.
var apw_huge = 0x7E37E43C8800759C;    # 1e300
assert_eq(Dual_val(dual_pow(dual_var(f64_neg(F64_TWO)), apw_huge)), 0x7FF0000000000000,
  "dual_pow(-2, 1e300) is +Inf, not a fabricated 1.0");
assert_eq(Dual_val(dual_pow(dual_var(f64_neg(F64_TWO)), f64_neg(apw_huge))), 0,
  "dual_pow(-2, -1e300) is +0, not a fabricated 1.0");
assert_eq(Dual_val(dual_pow(dual_var(F64_HALF), apw_huge)), 0,
  "dual_pow(0.5, 1e300) is +0");
assert_eq(Dual_val(dual_pow(dual_var(f64_neg(F64_TWO)), f64_from(4))), f64_from(16),
  "dual_pow(-2,4) is exactly 16");

# (5) pow(0, -1) = +Inf is the IEEE-754 answer (NaN under ganita 1.0.4), and the
# derivative -1 * 0^-2 = -Inf falls, so its sign is not incidental.
assert_eq(Dual_val(dual_pow(dual_var(f64_from(0)), f64_from(0 - 1))), 0x7FF0000000000000,
  "dual_pow(0,-1) is +Inf");
assert_eq(f64_lt(Dual_deriv(dual_pow(dual_var(f64_from(0)), f64_from(0 - 1))), f64_from(0)), 1,
  "dual_pow(0,-1) derivative is -Inf -- d/dx x^-1 falls, so the sign is not incidental");

# ⭐ AND THE PUBLIC SURFACE THAT MOVED WITH IT. symbolic.cyr's expr_eval calls
# f64_pow directly (src/symbolic.cyr, EXPR_POW branch), so evaluating a negative
# base at an integer power returned NaN for hisab's whole history and returns a
# number now. No test covered it, which is why all 3514 assertions passed on both
# sides of the bump.
var s_negpow = expr_pow(expr_const(f64_neg(F64_TWO)), expr_const(f64_from(3)));
var s_nobind = 0;
assert_eq(f64_eq(expr_eval(s_negpow, s_nobind), expr_eval(s_negpow, s_nobind)), 1,
  "expr_eval((-2)^3) is a number, not NaN -- hisab public API, changed by the bump");
assert_eq(f64_to(f64_round(expr_eval(s_negpow, s_nobind))), 0 - 8,
  "expr_eval((-2)^3) rounds to -8");

test_group("autodiff: x^2");

# f(x) = x^2 at x=3: val=9, deriv=6
var ad_x3 = dual_var(f64_from(3));
var ad_x3_sq = dual_mul(ad_x3, ad_x3);
assert_eq(Dual_val(ad_x3_sq), f64_from(9), "x^2 at 3 val=9");
assert_eq(Dual_deriv(ad_x3_sq), f64_from(6), "x^2 at 3 deriv=6");

# f(x) = x^2 at x=0: val=0, deriv=0
var ad_x0 = dual_var(0);
var ad_x0_sq = dual_mul(ad_x0, ad_x0);
assert_eq(Dual_val(ad_x0_sq), f64_from(0), "x^2 at 0 val=0");
assert_eq(Dual_deriv(ad_x0_sq), f64_from(0), "x^2 at 0 deriv=0");

# ----------------------------------------------------------------
test_group("autodiff: sin/cos/exp/ln/sqrt");

# sin(0)=0, deriv=cos(0)=1
var ad_sin0 = dual_sin(dual_var(0));
assert_eq(Dual_val(ad_sin0), f64_from(0), "sin(0) val");
assert_eq(Dual_deriv(ad_sin0), f64_from(1), "sin(0) deriv=cos(0)=1");

# cos(0)=1, deriv=-sin(0)=0 -- NEGATIVE zero since cyrius 6.6.8, whose `f64_neg` is an
# IEEE sign flip (`f64_neg(+0)` was +0 when it computed 0.0 - x); compared as a value.
var ad_cos0 = dual_cos(dual_var(0));
assert_eq(Dual_val(ad_cos0), f64_from(1), "cos(0) val");
assert_eq(f64_eq(Dual_deriv(ad_cos0), 0), 1, "cos(0) deriv=-sin(0)=0 (it is -0.0)");

# exp(0)=1, deriv=exp(0)=1
var ad_exp0 = dual_exp(dual_var(0));
assert_eq(Dual_val(ad_exp0), f64_from(1), "exp(0) val");
assert_eq(Dual_deriv(ad_exp0), f64_from(1), "exp(0) deriv");

# ln(1)=0, deriv=1/1=1
var ad_ln1 = dual_ln(dual_var(F64_ONE));
assert_eq(Dual_val(ad_ln1), f64_from(0), "ln(1) val");
assert_eq(Dual_deriv(ad_ln1), f64_from(1), "ln(1) deriv");

# sqrt(4)=2, deriv=1/(2*2)=0.25
var ad_sqrt4 = dual_sqrt(dual_var(f64_from(4)));
assert_eq(Dual_val(ad_sqrt4), f64_from(2), "sqrt(4) val");
var ad_sqrt4_d = f64_to(f64_round(f64_mul(Dual_deriv(ad_sqrt4), f64_from(100))));
assert_eq(ad_sqrt4_d, 25, "sqrt(4) deriv*100=25");

# ----------------------------------------------------------------
test_group("autodiff: composition");

# f(x) = x^2 + 2x at x=3: val = 9+6 = 15, deriv = 2x+2 = 8
var ad_x = dual_var(f64_from(3));
var ad_x_sq = dual_mul(ad_x, ad_x);
var ad_2x = dual_mul(dual_const(F64_TWO), ad_x);
var ad_comp = dual_add(ad_x_sq, ad_2x);
assert_eq(Dual_val(ad_comp), f64_from(15), "x^2+2x at 3 val=15");
assert_eq(Dual_deriv(ad_comp), f64_from(8), "x^2+2x at 3 deriv=8");

# ================================================================
# INTERVAL (~10)
# ================================================================
test_group("interval: arithmetic");

# NOTE: the interval result vars are named iv_sum/iv_diff/iv_prod, NOT
# iv_add/iv_sub/iv_mul. Those three names are RESERVED SIMD intrinsics in cyrius
# (packed integer-vector add/sub/mul) and cannot be used as identifiers, at file
# scope or inside a fn. iv_div/iv_neg are fine (there is no integer-vector
# divide, so iv_div was never reserved). Do NOT rename these back — doing so
# takes this whole suite down at compile time.
#
# The DIAGNOSTIC changed in cyrius 6.5.9 and this note used to quote the old one.
# Re-verified on 6.5.16 (2026-08-09), the message is now:
#   expected identifier, got reserved keyword 'iv_add' (cannot be used as an
#   identifier; rename the variable/field/fn)
# It was `expected identifier, got unknown`, which named nothing. If you are
# reading this after trying the original names and seeing a message that does not
# match, the reservation still stands — check the wording, not the rule.
# See docs/development/issues/archived/2026-07-17-cyrius-interval-ident-lex.md.
var iv_a = ivl_new(f64_from(1), f64_from(3));
var iv_b = ivl_new(f64_from(2), f64_from(4));

# Add: [1,3]+[2,4] = [3,7]
var iv_sum = ivl_add(iv_a, iv_b);
assert_eq(Interval_lo(iv_sum), f64_from(3), "ivl add lo");
assert_eq(Interval_hi(iv_sum), f64_from(7), "ivl add hi");

# Sub: [1,3]-[2,4] = [1-4, 3-2] = [-3, 1]
var iv_diff = ivl_sub(iv_a, iv_b);
assert_eq(Interval_lo(iv_diff), f64_neg(f64_from(3)), "ivl sub lo");
assert_eq(Interval_hi(iv_diff), f64_from(1), "ivl sub hi");

# Mul: [1,3]*[2,4] = [2,12]
var iv_prod = ivl_mul(iv_a, iv_b);
assert_eq(Interval_lo(iv_prod), f64_from(2), "ivl mul lo");
assert_eq(Interval_hi(iv_prod), f64_from(12), "ivl mul hi");

# Div: [1,3]/[2,4] = [1/4, 3/2] = [0.25, 1.5]
var iv_div = ivl_div(iv_a, iv_b);
var iv_div_lo100 = f64_to(f64_round(f64_mul(Interval_lo(iv_div), f64_from(100))));
assert_eq(iv_div_lo100, 25, "ivl div lo*100=25");

# ----------------------------------------------------------------
test_group("interval: queries");

assert_eq(ivl_contains(iv_a, f64_from(2)), 1, "ivl contains 2");
assert_eq(ivl_contains(iv_a, f64_from(4)), 0, "ivl not contains 4");
assert_eq(ivl_overlaps(iv_a, iv_b), 1, "ivl overlaps");
assert_eq(ivl_width(iv_a), f64_from(2), "ivl width=2");
assert_eq(ivl_midpoint(iv_a), f64_from(2), "ivl midpoint=2");

# ----------------------------------------------------------------
test_group("interval: neg, abs, sqrt, point");

# Neg: -[1,3] = [-3,-1]
var iv_neg = ivl_neg(iv_a);
assert_eq(Interval_lo(iv_neg), f64_neg(f64_from(3)), "ivl neg lo");
assert_eq(Interval_hi(iv_neg), f64_neg(f64_from(1)), "ivl neg hi");

# Abs: |[-3,1]| = [0,3] (contains 0)
var iv_neg3_1 = ivl_new(f64_neg(f64_from(3)), F64_ONE);
var iv_abs = ivl_abs(iv_neg3_1);
assert_eq(Interval_lo(iv_abs), f64_from(0), "ivl abs lo=0");
assert_eq(Interval_hi(iv_abs), f64_from(3), "ivl abs hi=3");

# Sqrt: sqrt([4,9]) = [2,3]
var iv_49 = ivl_new(f64_from(4), f64_from(9));
var iv_sqrt = ivl_sqrt(iv_49);
assert_eq(Interval_lo(iv_sqrt), f64_from(2), "ivl sqrt lo=2");
assert_eq(Interval_hi(iv_sqrt), f64_from(3), "ivl sqrt hi=3");

# Point interval
var iv_pt = ivl_point(f64_from(5));
assert_eq(ivl_width(iv_pt), f64_from(0), "point width=0");
assert_eq(ivl_midpoint(iv_pt), f64_from(5), "point mid=5");

# ================================================================
# TENSOR (~10)
# ================================================================
test_group("tensor: create, get/set");

var t_shape = alloc(16);
store64(t_shape, 3); store64(t_shape + 8, 4);
var t = tensor_new(2, t_shape);
assert_eq(tensor_get2(t, 0, 0), f64_from(0), "tensor zero init");

tensor_set2(t, 1, 2, f64_from(42));
assert_eq(tensor_get2(t, 1, 2), f64_from(42), "tensor set/get");
assert_eq(tensor_get2(t, 2, 3), f64_from(0), "tensor other still 0");

# ----------------------------------------------------------------
test_group("tensor: kronecker delta");

assert_eq(kronecker_delta(0, 0), f64_from(1), "delta ii=1");
assert_eq(kronecker_delta(1, 1), f64_from(1), "delta jj=1");
assert_eq(kronecker_delta(0, 1), f64_from(0), "delta ij=0");
assert_eq(kronecker_delta(2, 3), f64_from(0), "delta 23=0");

# ----------------------------------------------------------------
test_group("tensor: minkowski metric");

assert_eq(minkowski(0, 0), f64_from(1), "eta 00=+1");
assert_eq(minkowski(1, 1), f64_neg(f64_from(1)), "eta 11=-1");
assert_eq(minkowski(2, 2), f64_neg(f64_from(1)), "eta 22=-1");
assert_eq(minkowski(3, 3), f64_neg(f64_from(1)), "eta 33=-1");
assert_eq(minkowski(0, 1), f64_from(0), "eta 01=0");

# ----------------------------------------------------------------
test_group("tensor: levi-civita 3D");

assert_eq(levi_civita_3(0, 1, 2), f64_from(1), "eps 012=+1");
assert_eq(levi_civita_3(1, 2, 0), f64_from(1), "eps 120=+1");
assert_eq(levi_civita_3(2, 0, 1), f64_from(1), "eps 201=+1");
assert_eq(levi_civita_3(1, 0, 2), f64_neg(f64_from(1)), "eps 102=-1");
assert_eq(levi_civita_3(0, 0, 1), 0, "eps repeated=0");

# ----------------------------------------------------------------
test_group("tensor: levi-civita 4D");

assert_eq(levi_civita_4(0, 1, 2, 3), f64_from(1), "eps4 0123=+1");
assert_eq(levi_civita_4(1, 0, 2, 3), f64_neg(f64_from(1)), "eps4 1023=-1");
assert_eq(levi_civita_4(0, 0, 1, 2), 0, "eps4 repeated=0");

# ----------------------------------------------------------------
test_group("tensor: tensor_add");

var t_shape2 = alloc(16);
store64(t_shape2, 2); store64(t_shape2 + 8, 2);
var t_a = tensor_new(2, t_shape2);
tensor_set2(t_a, 0, 0, f64_from(1));
tensor_set2(t_a, 0, 1, f64_from(2));
tensor_set2(t_a, 1, 0, f64_from(3));
tensor_set2(t_a, 1, 1, f64_from(4));

var t_b = tensor_new(2, t_shape2);
tensor_set2(t_b, 0, 0, f64_from(10));
tensor_set2(t_b, 0, 1, f64_from(20));
tensor_set2(t_b, 1, 0, f64_from(30));
tensor_set2(t_b, 1, 1, f64_from(40));

var t_sum = tensor_add(t_a, t_b);
assert_eq(tensor_get2(t_sum, 0, 0), f64_from(11), "tensor_add [0,0]");
assert_eq(tensor_get2(t_sum, 0, 1), f64_from(22), "tensor_add [0,1]");
assert_eq(tensor_get2(t_sum, 1, 0), f64_from(33), "tensor_add [1,0]");
assert_eq(tensor_get2(t_sum, 1, 1), f64_from(44), "tensor_add [1,1]");

# ================================================================
# COLLISION_CORE — contacts, sequential impulse smoke
# ================================================================
# 2.4.x collision-correctness arc COMPLETE — every algorithm audited + covered:
# convex_hull_2d (2.4.0), triangulate_polygon (2.4.1), delaunay_2d (2.4.2),
# half-edge mesh (2.4.3), MPR narrowphase (2.4.4), and sequential_impulse (2.4.5,
# below); solve_pgs is covered in hisab.tcyr. Real bugs were found + fixed in the
# hull sort (2.4.0), MPR (2.4.4), and the impulse solver (2.4.5).
test_group("collision_core: contact_new + accessors");

var c_norm = hvec3_new(0, F64_ONE, 0);
var contact = contact_new(0, 1, c_norm, F64_HALF, F64_HALF, F64_HALF, F64_ONE, F64_ONE);
assert_eq(ColContact_body_a(contact), 0, "ColContact body_a");
assert_eq(ColContact_body_b(contact), 1, "ColContact body_b");
# ⭐ 2.13.0 — the one assertion in this sweep whose truncation was DELIBERATE, and
# its own message said so. Kept as a truncation test, but now pinned on BOTH sides:
# the stored value is bit-exactly 0.5, and reading it through `f64_to` gives 0.
# Before, only the second half was asserted, so the first was free to drift.
assert_eq(ColContact_penetration(contact), F64_HALF, "ColContact penetration is bit-exactly 0.5");
assert_eq(f64_to(ColContact_penetration(contact)), 0, "ColContact penetration: 0.5 truncates to 0 through f64_to");

# MPR narrowphase (2.4.4) — fixed a false-positive: separated shapes used to
# report a hit (missing origin-containment early-out → degenerate colinear
# branch returned 1). Now intersect/penetration are correct for spheres + boxes.
test_group("collision_core: MPR narrowphase");

var mpr_a = hvec4_new(0, 0, 0, F64_TWO);            # sphere r=2 @ origin
var mpr_b_ov = hvec4_new(f64_from(3), 0, 0, F64_TWO);   # dist 3 < 4 → overlap
var mpr_b_sep = hvec4_new(f64_from(5), 0, 0, F64_ONE);  # dist 5 > 3 → separated
var mpr_b_off = hvec4_new(f64_from(5), f64_from(5), 0, F64_ONE);  # off-axis sep

var mpr_ov = mpr_intersect(&_mpr_sup_sphere, mpr_a, &_mpr_sup_sphere, mpr_b_ov);
assert_eq(mpr_ov, 1, "mpr_intersect: spheres overlap");
var mpr_sep = mpr_intersect(&_mpr_sup_sphere, mpr_a, &_mpr_sup_sphere, mpr_b_sep);
assert_eq(mpr_sep, 0, "mpr_intersect: spheres separated (was false +ve)");
var mpr_off = mpr_intersect(&_mpr_sup_sphere, mpr_a, &_mpr_sup_sphere, mpr_b_off);
assert_eq(mpr_off, 0, "mpr_intersect: spheres separated off-axis");

# Penetration: depth = sum_radii − dist. Normal along ±x. Scale by 100 for f64_to.
var mpr_n = alloc(8);
var mpr_d = alloc(8);
var mpr_hit = mpr_penetration(&_mpr_sup_sphere, mpr_a, &_mpr_sup_sphere, mpr_b_ov, mpr_n, mpr_d);
assert_eq(mpr_hit, 1, "mpr_penetration: overlap returns hit");
assert_f64_eq(load64(mpr_d), f64_div(f64_from(100), f64_from(100)), "mpr_penetration: depth ~1.0 (4-3)");
# 2.9.0: was assert_eq(f64_to(|nx| * 100), 100). f64_to TRUNCATES, so that read
# "0.99 <= |nx| <= 1.00" -- and it FAILS the moment the normal is right to only
# 15 digits instead of exact, because 0.9999999999 * 100 truncates to 99. The
# depth is now refined to the true MTV, so the normal is a converged direction
# rather than an exact axis; the check below is 1e-9 ABSOLUTE, i.e. seven orders
# of magnitude tighter than the truncation it replaces.
var mpr_nx = f64_abs(HVec3_x(load64(mpr_n)));
assert(f64_approx_eq(mpr_nx, F64_ONE, 0x3E112E0BE826D695),
  "mpr_penetration: normal ~±x within 1e-9");

var mpr_b_deep = hvec4_new(F64_ONE, 0, 0, F64_TWO);     # dist 1 → depth 4-1 = 3
var mpr_n2 = alloc(8);
var mpr_d2 = alloc(8);
mpr_penetration(&_mpr_sup_sphere, mpr_a, &_mpr_sup_sphere, mpr_b_deep, mpr_n2, mpr_d2);
assert_f64_eq(load64(mpr_d2), f64_div(f64_from(300), f64_from(100)), "mpr_penetration: deep depth ~3.0 (4-1)");

var mpr_n3 = alloc(8);
var mpr_d3 = alloc(8);
var mpr_miss = mpr_penetration(&_mpr_sup_sphere, mpr_a, &_mpr_sup_sphere, mpr_b_sep, mpr_n3, mpr_d3);
assert_eq(mpr_miss, 0, "mpr_penetration: separated returns miss");

# Boxes (axis-aligned): overlap + separated.
var mpr_box_a = _mpr_mkbox(0, 0, 0, F64_ONE, F64_ONE, F64_ONE);
var mpr_box_ov = _mpr_mkbox(F64_ONE, 0, 0, F64_ONE, F64_ONE, F64_ONE);
var mpr_boxov = mpr_intersect(&_mpr_sup_box, mpr_box_a, &_mpr_sup_box, mpr_box_ov);
assert_eq(mpr_boxov, 1, "mpr_intersect: boxes overlap");
var mpr_box_sep = _mpr_mkbox(f64_from(5), 0, 0, F64_ONE, F64_ONE, F64_ONE);
var mpr_boxsep = mpr_intersect(&_mpr_sup_box, mpr_box_a, &_mpr_sup_box, mpr_box_sep);
assert_eq(mpr_boxsep, 0, "mpr_intersect: boxes separated");

# ================================================================
# 2.9.0 -- narrowphase depth against an EXACT reference
# ================================================================
# Every expected value below is a closed form or an exact-rational computation,
# never a previous hisab output:
#   box/box     -- 15-axis OBB SAT evaluated in python3 Fractions
#   sphere/box  -- r - sdBox(centre in box frame, half-extents)
#   sphere/sph  -- r0 + r1 - |c1 - c0|
#   cylinder/box-- independent Nelder-Mead minimisation of the support function
#                  h_M over the unit sphere (no closed form exists)
#
# What each assertion catches, measured against the pre-2.9.0 source:
#   off-axis box/box      mpr 0.0        -> 1.61          (portal plane through
#                                                          the INTERIOR point)
#   MPR-is-not-MTV box    mpr 1.0-ish    -> 0.5           (textbook MPR picks the
#                                                          wrong axis; the error
#                                                          ratio is unbounded)
#   separated pair        mpr hit @ 4.6  -> miss
#   box vs sphere         gjk 2.2e-16    -> 0.8           (degenerate GJK simplex
#                                                          reported "no contact")
#   concentric spheres    gjk 1.8875     -> 2.0           (expansion stalled)
#   scale 1e3             gjk 999.98922  -> 1000.0        (absolute epsilon)
#   near tangency         gjk 4.4114e-5  -> 1e-6
#   cylinder vs OBB       mpr 3.2801     -> 0.19769663
var NP9_TOL = 0x3E112E0BE826D695;   # 1e-9 -- absolute, values here are O(1)

# Oriented box: 15 slots [cx,cy,cz, hx,hy,hz, u0(3), u1(3), u2(3)].
fn _mpr_sup_obb(shape, dir) {
    var acc = hvec3_new(load64(shape), load64(shape + 8), load64(shape + 16));
    for (var oi = 0; oi < 3; oi = oi + 1) {
        var u = hvec3_new(load64(shape + 48 + oi * 24), load64(shape + 56 + oi * 24),
          load64(shape + 64 + oi * 24));
        var hh = load64(shape + 24 + oi * 8);
        if (f64_lt(hvec3_dot(dir, u), 0) == 1) { hh = f64_neg(hh); }
        acc = hvec3_add(acc, hvec3_scale(u, hh));
    }
    return acc;
}

# z-axis cylinder: 5 slots [cx,cy,cz, radius, half_height].
fn _mpr_sup_cyl(shape, dir) {
    var acc = hvec3_new(load64(shape), load64(shape + 8), load64(shape + 16));
    var pl = f64_sqrt(f64_add(f64_mul(HVec3_x(dir), HVec3_x(dir)),
        f64_mul(HVec3_y(dir), HVec3_y(dir))));
    if (f64_gt(pl, 0) == 1) {
        var sc = f64_div(load64(shape + 24), pl);
        acc = hvec3_add(acc, hvec3_new(f64_mul(HVec3_x(dir), sc),
            f64_mul(HVec3_y(dir), sc), 0));
    }
    var hz = load64(shape + 32);
    if (f64_lt(HVec3_z(dir), 0) == 1) { hz = f64_neg(hz); }
    return hvec3_add(acc, hvec3_new(0, 0, hz));
}

fn _mpr_mkobb(cx, cy, cz, hx, hy, hz) {
    var s = alloc(120);
    store64(s, cx);
    store64(s + 8, cy);
    store64(s + 16, cz);
    store64(s + 24, hx);
    store64(s + 32, hy);
    store64(s + 40, hz);
    for (var oi = 0; oi < 9; oi = oi + 1) { store64(s + 48 + oi * 8, 0); }
    store64(s + 48, F64_ONE);
    store64(s + 80, F64_ONE);
    store64(s + 112, F64_ONE);
    return s;
}

fn _mpr_obb_axis(s, i, x, y, z) {
    store64(s + 48 + i * 24, x);
    store64(s + 56 + i * 24, y);
    store64(s + 64 + i * 24, z);
    return 0;
}

# Depth of one narrowphase call; mode 0 = gjk_epa_3d, 1 = mpr_penetration.
# Returns -inf on a reported miss so a miss can never pass an approx-equality.
fn _np9_depth(fa, sa, fb, sb, mode) {
    var nn = alloc(8);
    var dd = alloc(8);
    store64(dd, 0);
    var r = gjk_epa_3d(fa, sa, fb, sb, nn, dd);
    if (mode == 1) { r = mpr_penetration(fa, sa, fb, sb, nn, dd); }
    if (r != 1) { return _COL_F64_NEG_INF; }
    return load64(dd);
}

test_group("collision_core: narrowphase depth == exact MTV (2.9.0)");

var np9_pn_n = alloc(8);
var np9_pn_d = alloc(8);
var np9_pn_n2 = alloc(8);
var np9_pn_d2 = alloc(8);

# --- off-axis box/box. Unit boxes, offset (0.3, 0, -0.39).
# Minkowski difference = box centred (-0.3, 0, 0.39) with half-extents 2, so the
# MTV is min(2-0.3, 2-0, 2-0.39) = 1.61 on the z axis. The shipped code reported
# 0.0: it measured the plane through v0, the INTERIOR point.
var np9_bb_a = _mpr_mkbox(0, 0, 0, F64_ONE, F64_ONE, F64_ONE);
var np9_bb_b = _mpr_mkbox(f64_div(f64_from(3), f64_from(10)), 0,
  f64_neg(f64_div(f64_from(39), f64_from(100))), F64_ONE, F64_ONE, F64_ONE);
var np9_bb_exp = f64_div(f64_from(161), f64_from(100));   # 1.61 exactly
assert_eq(mpr_penetration(&_mpr_sup_box, np9_bb_a, &_mpr_sup_box, np9_bb_b, np9_pn_n, np9_pn_d), 1,
  "mpr_penetration: off-axis boxes report a hit");
assert(f64_approx_eq(load64(np9_pn_d), np9_bb_exp, NP9_TOL),
  "mpr_penetration: off-axis box/box depth == 1.61 exact SAT (was 0.0)");
assert(f64_approx_eq(f64_abs(HVec3_z(load64(np9_pn_n))), F64_ONE, NP9_TOL),
  "mpr_penetration: off-axis box/box normal is the z axis");
assert_eq(gjk_epa_3d(&_mpr_sup_box, np9_bb_a, &_mpr_sup_box, np9_bb_b, np9_pn_n2, np9_pn_d2), 1,
  "gjk_epa_3d: off-axis boxes report a hit");
assert(f64_approx_eq(load64(np9_pn_d2), np9_bb_exp, NP9_TOL),
  "gjk_epa_3d: off-axis box/box depth == 1.61 exact SAT");

# The unit normal really is a unit vector (the old code stored a portal normal
# built from a cross product it never renormalised on the fallback path).
assert(f64_approx_eq(hvec3_length(load64(np9_pn_n)), F64_ONE, NP9_TOL),
  "mpr_penetration: normal is unit length");

# --- MPR's OWN answer is not the MTV, and this fixture pins the difference.
# A and B are 0.5 x 5 x 5 boxes, B offset (0.5, 9, 0). The difference is a box
# centred (-0.5, -9, 0) with half-extents (1, 10, 10): textbook MPR leaves
# through the axis maximising |c_i|/h_i (y: 0.9) and reports 10-9 = 1.0, while
# the MTV is on the axis minimising h_i-|c_i| (x) and equals 0.5. Stretching the
# y extent makes that ratio arbitrarily large, which is why the depth is refined
# rather than read off the portal.
var np9_mv_h = f64_div(F64_ONE, F64_TWO);
var np9_mv_a = _mpr_mkbox(0, 0, 0, np9_mv_h, f64_from(5), f64_from(5));
var np9_mv_b = _mpr_mkbox(np9_mv_h, f64_from(9), 0, np9_mv_h, f64_from(5), f64_from(5));
assert_eq(mpr_penetration(&_mpr_sup_box, np9_mv_a, &_mpr_sup_box, np9_mv_b, np9_pn_n, np9_pn_d), 1,
  "mpr_penetration: anisotropic boxes report a hit");
assert(f64_approx_eq(load64(np9_pn_d), np9_mv_h, NP9_TOL),
  "mpr_penetration: depth is the MTV 0.5, not MPR's own portal answer 1.0");
assert(f64_approx_eq(f64_abs(HVec3_x(load64(np9_pn_n))), F64_ONE, NP9_TOL),
  "mpr_penetration: anisotropic MTV normal is the x axis, not y");
gjk_epa_3d(&_mpr_sup_box, np9_mv_a, &_mpr_sup_box, np9_mv_b, np9_pn_n2, np9_pn_d2);
assert(f64_approx_eq(load64(np9_pn_d2), np9_mv_h, NP9_TOL),
  "gjk_epa_3d: anisotropic box/box depth == MTV 0.5");

# --- SEPARATED must be a miss. Half-extents (1,10,10) at the origin against a
# 1e-9 box at (1.4, 0.5, 0.1): the x gap is 0.4. The shipped code returned 1
# with depth 4.6063.
var np9_sep_a = _mpr_mkbox(0, 0, 0, F64_ONE, f64_from(10), f64_from(10));
var np9_sep_tiny = f64_div(F64_ONE, f64_from(1000000000));
var np9_sep_b = _mpr_mkbox(f64_div(f64_from(14), f64_from(10)), f64_div(F64_ONE, F64_TWO),
  f64_div(F64_ONE, f64_from(10)), np9_sep_tiny, np9_sep_tiny, np9_sep_tiny);
assert_eq(mpr_penetration(&_mpr_sup_box, np9_sep_a, &_mpr_sup_box, np9_sep_b, np9_pn_n, np9_pn_d), 0,
  "mpr_penetration: separated anisotropic pair is a miss (was hit @ 4.6063)");
assert_eq(gjk_epa_3d(&_mpr_sup_box, np9_sep_a, &_mpr_sup_box, np9_sep_b, np9_pn_n2, np9_pn_d2), 0,
  "gjk_epa_3d: separated anisotropic pair is a miss");

# --- box vs sphere, BOX FIRST. r - sdBox((1.2,0,0.7), (1,1,1)) = 1 - 0.2 = 0.8.
# Order matters to GJK's direction sequence: this ordering produced a degenerate
# simplex, which the shipped code answered with 2.2e-16.
var np9_bs_box = _mpr_mkbox(0, 0, 0, F64_ONE, F64_ONE, F64_ONE);
var np9_bs_sph = hvec4_new(f64_div(f64_from(12), f64_from(10)), 0,
  f64_div(f64_from(7), f64_from(10)), F64_ONE);
var np9_bs_exp = f64_div(f64_from(8), f64_from(10));
assert_eq(gjk_epa_3d(&_mpr_sup_box, np9_bs_box, &_mpr_sup_sphere, np9_bs_sph, np9_pn_n2, np9_pn_d2), 1,
  "gjk_epa_3d: box-then-sphere reports a hit");
assert(f64_approx_eq(load64(np9_pn_d2), np9_bs_exp, NP9_TOL),
  "gjk_epa_3d: box vs sphere depth == 0.8 = r - sdBox (was 2.2e-16)");
mpr_penetration(&_mpr_sup_box, np9_bs_box, &_mpr_sup_sphere, np9_bs_sph, np9_pn_n, np9_pn_d);
assert(f64_approx_eq(load64(np9_pn_d), np9_bs_exp, NP9_TOL),
  "mpr_penetration: box vs sphere depth == 0.8 (was -1.3964)");

# --- concentric unit spheres. Depth = r0 + r1 = 2 exactly. This is the case the
# expansion could not converge on (1.8875 at 64 iterations, 1.9794 at 400) and
# the case where the MPR portal degenerates onto its own v0-v1 edge (0.0).
var np9_cc_a = hvec4_new(0, 0, 0, F64_ONE);
var np9_cc_b = hvec4_new(0, 0, 0, F64_ONE);
assert(f64_approx_eq(_np9_depth(&_mpr_sup_sphere, np9_cc_a, &_mpr_sup_sphere, np9_cc_b, 0),
    F64_TWO, NP9_TOL), "gjk_epa_3d: concentric unit spheres depth == 2.0 (was 1.8875)");
assert(f64_approx_eq(_np9_depth(&_mpr_sup_sphere, np9_cc_a, &_mpr_sup_sphere, np9_cc_b, 1),
    F64_TWO, NP9_TOL), "mpr_penetration: concentric unit spheres depth == 2.0 (was 0.0)");

# --- SCALE INVARIANCE. r=2 spheres 3 apart -> depth 1, the identical geometry at
# 1e-3 / 1e3 / 1e6 -> depth 1e-3 / 1e3 / 1e6. The convergence test used to be an
# ABSOLUTE 1e-12, so the same shape at a different scale gave a different answer
# (1.078e-5 relative at every scale away from 1).
for (var sk = 0; sk < 3; sk = sk + 1) {
    var kf = F64_ONE;
    if (sk == 0) { kf = f64_div(F64_ONE, f64_from(1000)); }
    if (sk == 2) { kf = f64_from(1000000); }
    if (sk == 1) { kf = f64_from(1000); }
    var sc_a = hvec4_new(0, 0, 0, f64_mul(F64_TWO, kf));
    var sc_b = hvec4_new(f64_mul(f64_from(3), kf), 0, 0, f64_mul(F64_TWO, kf));
    var sc_got = _np9_depth(&_mpr_sup_sphere, sc_a, &_mpr_sup_sphere, sc_b, 0);
    assert(f64_approx_eq(f64_div(sc_got, kf), F64_ONE, f64_div(F64_ONE, f64_from(1000000))),
      "gjk_epa_3d: sphere depth is scale-invariant (relative, not absolute, tolerance)");
    var sc_got2 = _np9_depth(&_mpr_sup_sphere, sc_a, &_mpr_sup_sphere, sc_b, 1);
    assert(f64_approx_eq(f64_div(sc_got2, kf), F64_ONE, f64_div(F64_ONE, f64_from(1000000))),
      "mpr_penetration: sphere depth is scale-invariant");
}

# --- SCALE INVARIANCE, CARRIED DOWN TO k = 1e-9. The loop above stops at 1e-3,
# which is ABOVE the scale at which gjk_epa_3d's two scale-sensitive mechanisms
# start to matter, so both of them were live and unpinned. Measured on the 2.9.0
# tree by mutating each one and re-running THIS geometry:
#   * _epa_seed_gjk's "2" return -- "the origin is enclosed but the simplex is
#     not a usable seed, fall back to the portal". Returning 0 instead routes the
#     call into _epa_touch_probe, which certifies a depth-0 TOUCH: at k = 1e-7,
#     1e-8 and 1e-9 gjk_epa_3d then reports a hit whose depth is 0 instead of k
#     and whose normal is +z instead of the line of centres. mpr_penetration is
#     untouched by that mutation -- it seeds itself -- so the sweep runs both
#     siblings and it is the gjk_epa_3d half that pins the fallback.
#   * the RELATIVE convergence tolerance. An ABSOLUTE one (EPSILON_F64) stops
#     early down here: depth/k comes back 1.0000725 at k = 1e-8 and 1.000668 at
#     k = 1e-9 (7.3e-5 and 6.7e-4 relative), with the normal 6.8e-3 and 2.1e-2
#     off the x axis. The shipped code holds depth/k to 1e-12 and the normal to
#     1e-11 at every one of these scales, so 1e-6 is ~700x clear of the noise.
# The NORMAL is the load-bearing half: at k = 1e-7 the absolute tolerance still
# gets the depth right and only the direction gives it away.
var ns9_n = alloc(8);
var ns9_d = alloc(8);
var NS9_TOL = f64_div(F64_ONE, f64_from(1000000));   # 1e-6, relative
for (var ns_k = 7; ns_k < 10; ns_k = ns_k + 1) {
    var ns_kf = F64_ONE;
    for (var ns_e = 0; ns_e < ns_k; ns_e = ns_e + 1) { ns_kf = f64_div(ns_kf, f64_from(10)); }
    var ns_a = hvec4_new(0, 0, 0, f64_mul(F64_TWO, ns_kf));
    var ns_b = hvec4_new(f64_mul(f64_from(3), ns_kf), 0, 0, f64_mul(F64_TWO, ns_kf));
    for (var ns_m = 0; ns_m < 2; ns_m = ns_m + 1) {
        store64(ns9_d, 0);
        store64(ns9_n, hvec3_zero());
        var ns_r = gjk_epa_3d(&_mpr_sup_sphere, ns_a, &_mpr_sup_sphere, ns_b, ns9_n, ns9_d);
        if (ns_m == 1) {
            ns_r = mpr_penetration(&_mpr_sup_sphere, ns_a, &_mpr_sup_sphere, ns_b, ns9_n, ns9_d);
        }
        assert_eq(ns_r, 1, "narrowphase: r=2k spheres 3k apart report a hit down to k = 1e-9");
        assert(f64_approx_eq(f64_div(load64(ns9_d), ns_kf), F64_ONE, NS9_TOL),
          "narrowphase: depth == k down to k = 1e-9 (a seed fallback that bails answers 0)");
        assert(f64_lt(hvec3_length(hvec3_cross(load64(ns9_n), hvec3_unit_x())), NS9_TOL) == 1,
          "narrowphase: micro-scale normal is the line of centres (an absolute tolerance loses it)");
    }
}

# --- NEAR TANGENCY. r=2 spheres 3.999999 apart -> depth 1e-6. The shipped code
# answered 4.4114e-5, a 43x over-report, because it stopped refining direction
# long before the depth mattered.
var np9_tg_a = hvec4_new(0, 0, 0, F64_TWO);
var np9_tg_b = hvec4_new(f64_sub(f64_from(4), f64_div(F64_ONE, f64_from(1000000))), 0, 0, F64_TWO);
var np9_tg_exp = f64_div(F64_ONE, f64_from(1000000));
var np9_tg_tol = f64_div(F64_ONE, f64_from(1000000000000));
assert(f64_approx_eq(_np9_depth(&_mpr_sup_sphere, np9_tg_a, &_mpr_sup_sphere, np9_tg_b, 0),
    np9_tg_exp, np9_tg_tol), "gjk_epa_3d: near-tangent spheres depth == 1e-6 (was 4.4114e-5)");
assert(f64_approx_eq(_np9_depth(&_mpr_sup_sphere, np9_tg_a, &_mpr_sup_sphere, np9_tg_b, 1),
    np9_tg_exp, np9_tg_tol), "mpr_penetration: near-tangent spheres depth == 1e-6");

# --- THE MANDATORY CYLINDER vs ROTATED-BOX FIXTURE (from the 2.8.2 roadmap's
# gjk_epa_3d O(k^2) row; the 2.8.3 roadmap dropped the row).
# A z-axis cylinder r=1.8793535667752475, half-height=1.2791168772746317 at the
# origin against an OBB. That row gave this reproducer's exact depth as
# 0.19783922047988; that number is WRONG -- it came from a coarse spherical grid
# search. An independent Nelder-Mead minimisation of h_M over the unit sphere,
# multi-started from a 200k-point Fibonacci lattice, converges to
# 0.19769663486454, and hisab's own answer 0.19769663487882 is a CERTIFIED upper
# bound on the MTV (it is h_M evaluated at a real direction), so the true value
# cannot exceed it. Both agree to 7.2e-11 relative. The shipped mpr_penetration
# returned 3.2801295 here.
var np9_cy_s = alloc(40);
store64(np9_cy_s, 0);
store64(np9_cy_s + 8, 0);
store64(np9_cy_s + 16, 0);
store64(np9_cy_s + 24, 0x3FFE11D50BAEBAF1);   # radius      1.8793535667752475
store64(np9_cy_s + 32, 0x3FF47743423A7FC0);   # half-height 1.2791168772746317
var np9_cy_b = _mpr_mkobb(0x4005732F92CFB63E, 0xC006EB1792881994, 0xBFFF55B8C5B1A9C0,
  0x3FFE93DAB8D7F5D9, 0x3FFAE1DE4A99CE2F, 0x3FF3482F05E60E8C);
_mpr_obb_axis(np9_cy_b, 0, 0x3FEF2D85DD7338A3, 0xBFCBFD941B69FBE9, 0x3FAB9A84DBCB55FA);
_mpr_obb_axis(np9_cy_b, 1, 0x3FCCC1C7CD456741, 0x3FEDA7F420E83330, 0xBFD34519497EDB0B);
_mpr_obb_axis(np9_cy_b, 2, 0x3F90423091D65D37, 0x3FD38CCD2BAACD4D, 0x3FEE775ADA949BF9);
var np9_cy_exp = 0x3FC94E1F92A2E068;          # 0.1976966348645448
var np9_cy_tol = f64_div(F64_ONE, f64_from(100000000));   # 1e-8 absolute
assert_eq(mpr_penetration(&_mpr_sup_cyl, np9_cy_s, &_mpr_sup_obb, np9_cy_b, np9_pn_n, np9_pn_d), 1,
  "mpr_penetration: cylinder vs rotated OBB reports a hit");
assert(f64_approx_eq(load64(np9_pn_d), np9_cy_exp, np9_cy_tol),
  "mpr_penetration: cylinder vs rotated OBB depth == 0.19769663 (was 3.2801295)");
assert_eq(gjk_epa_3d(&_mpr_sup_cyl, np9_cy_s, &_mpr_sup_obb, np9_cy_b, np9_pn_n2, np9_pn_d2), 1,
  "gjk_epa_3d: cylinder vs rotated OBB reports a hit");
assert(f64_approx_eq(load64(np9_pn_d2), np9_cy_exp, np9_cy_tol),
  "gjk_epa_3d: cylinder vs rotated OBB depth == 0.19769663");
# The two siblings carry the same documented contract, so they must agree.
assert(f64_approx_eq(load64(np9_pn_d), load64(np9_pn_d2), np9_cy_tol),
  "mpr_penetration and gjk_epa_3d agree on the cylinder fixture");

# --- THE INVARIANT A WRONG ANSWER CANNOT SATISFY: translating B by
# depth * normal must SEPARATE the pair. This does not compare against any
# reference value at all -- it re-runs the overlap test on the corrected pose.
var np9_iv_box_a = _mpr_mkbox(0, 0, 0, F64_ONE, F64_ONE, F64_ONE);
var np9_iv_box_b = _mpr_mkbox(f64_div(f64_from(3), f64_from(10)), 0,
  f64_neg(f64_div(f64_from(39), f64_from(100))), F64_ONE, F64_ONE, F64_ONE);
mpr_penetration(&_mpr_sup_box, np9_iv_box_a, &_mpr_sup_box, np9_iv_box_b, np9_pn_n, np9_pn_d);
var np9_iv_push = f64_mul(load64(np9_pn_d), f64_div(f64_from(1000001), f64_from(1000000)));
var np9_iv_nrm = load64(np9_pn_n);
var np9_iv_moved = _mpr_mkbox(f64_add(load64(np9_iv_box_b), f64_mul(HVec3_x(np9_iv_nrm), np9_iv_push)),
  f64_add(load64(np9_iv_box_b + 8), f64_mul(HVec3_y(np9_iv_nrm), np9_iv_push)),
  f64_add(load64(np9_iv_box_b + 16), f64_mul(HVec3_z(np9_iv_nrm), np9_iv_push)),
  F64_ONE, F64_ONE, F64_ONE);
assert_eq(mpr_intersect(&_mpr_sup_box, np9_iv_box_a, &_mpr_sup_box, np9_iv_moved), 0,
  "mpr_penetration: translating B by depth*normal separates the pair");
# ... and translating by 1% LESS must NOT separate it, so the depth is tight and
# not merely large enough.
var np9_iv_short = f64_mul(load64(np9_pn_d), f64_div(f64_from(99), f64_from(100)));
var np9_iv_near = _mpr_mkbox(f64_add(load64(np9_iv_box_b), f64_mul(HVec3_x(np9_iv_nrm), np9_iv_short)),
  f64_add(load64(np9_iv_box_b + 8), f64_mul(HVec3_y(np9_iv_nrm), np9_iv_short)),
  f64_add(load64(np9_iv_box_b + 16), f64_mul(HVec3_z(np9_iv_nrm), np9_iv_short)),
  F64_ONE, F64_ONE, F64_ONE);
assert_eq(mpr_intersect(&_mpr_sup_box, np9_iv_box_a, &_mpr_sup_box, np9_iv_near), 1,
  "mpr_penetration: 99% of the depth does NOT separate -- the depth is tight");

# --- ARENA BOUND. A narrowphase call must not scale its allocation with the
# iteration count: the pre-2.9.0 expansion allocated a fresh 16-byte record for
# every face on every pass and rebuilt two vecs per pass.
#
# 2.9.0: both bounds were 256 KB against true values of 51 KB and 22 KB — 5x
# and 11.5x headroom, which is far above the defect scale. Re-adding an
# alloc(80) per face per iteration (the SHAPE of the pre-2.9.0 per-face record)
# passed both. Measured on this tree, and IDENTICAL on five consecutive runs —
# alloc_used() over a fixed code path has no run-to-run variation, so the
# margins below are chosen against future legitimate change, not against noise:
#   gjk_epa_3d  52,272 B -> bound 65,536 (25.4% headroom); injection reads
#               108,272, i.e. 65% over the bound.
#   mpr_penetration 22,776 B -> bound 25,600 (12.4% headroom); injection reads
#               25,656 -- it clears the bound by only 56 B. This fixture runs
#               few enough iterations that the leak is worth only +12.6% here,
#               so 25,600 is the LOOSEST bound that still sees it at all; that
#               is why this margin is thinner than the others.
#
# 2.9.1: THE THIN BOUND IS NOT REPAIRED BY A TIGHTER NUMBER. 0.22% of detection
# margin is a coin flip against any differently-shaped partial regression, and
# tightening 25,600 only trades that for false alarms on legitimate change. The
# fix is a fixture with MORE ITERATIONS -- see the mpr_penetration sphere-pair
# budget added beside the gjk_epa_3d one further down this file, where the same
# injection overshoots its bound by 123% instead of 0.22%. This absolute bound is
# KEPT as-is: it still guards the polytope regime, which the sphere pair does
# not exercise, and it is the row that carries the historical 22 KB figure.
# The baseline moved 22,752 -> 22,776 in 2.9.1: mpr_penetration now writes a
# placeholder normal on every path, and hvec3_unit_x() allocates one HVec3.
var np9_ar_before = alloc_used();
gjk_epa_3d(&_mpr_sup_cyl, np9_cy_s, &_mpr_sup_obb, np9_cy_b, np9_pn_n2, np9_pn_d2);
var np9_ar_used = alloc_used() - np9_ar_before;
assert_lt(np9_ar_used, 65536, "gjk_epa_3d: arena per call stays under 64 KB (52,272 B)");
var np9_ar_before2 = alloc_used();
mpr_penetration(&_mpr_sup_box, np9_bb_a, &_mpr_sup_box, np9_bb_b, np9_pn_n, np9_pn_d);
assert_lt(alloc_used() - np9_ar_before2, 25600,
  "mpr_penetration: arena per call stays under 25 KB (22,776 B)");

# sequential_impulse (2.4.5) — fixed: the normal impulse was computed with the
# wrong sign and without folding the accumulated impulse into the effective
# velocity, so it clamped to 0 every iteration (the solver did nothing). Now it
# converges to λ = (1+e)·pen / inv_mass and is iteration-independent.
test_group("collision_core: sequential_impulse");

# Resting contact, e=0, two dynamic bodies (inv_mass 1+1=2), pen=0.5 → λ=0.25.
var si_c = contact_new(0, 1, hvec3_unit_y(), F64_HALF, 0, 0, F64_ONE, F64_ONE);
var si_cs = vec_new();
vec_push(si_cs, si_c);
var si_out = alloc(16);
var _r12t, _r12v = sequential_impulse(si_cs, 1, 10, si_out);
assert_f64_eq(load64(si_out), f64_div(f64_from(25), f64_from(100)), "sequential_impulse: resting λ=0.25 (was 0)");

# Idempotent: e=0 converges in a single iteration to the same impulse.
var si_out1 = alloc(16);
var _r13t, _r13v = sequential_impulse(si_cs, 1, 1, si_out1);
assert_f64_eq(load64(si_out1), f64_div(f64_from(25), f64_from(100)), "sequential_impulse: converges in 1 iter");

# Dynamic vs static (inv_mass 1+0=1), pen=1.0 → λ=1.0.
var si_c2 = contact_new(0, 1, hvec3_unit_y(), F64_ONE, 0, 0, F64_ONE, 0);
var si_cs2 = vec_new();
vec_push(si_cs2, si_c2);
var si_out2 = alloc(16);
var _r14t, _r14v = sequential_impulse(si_cs2, 1, 20, si_out2);
assert_f64_eq(load64(si_out2), f64_div(f64_from(100), f64_from(100)), "sequential_impulse: dynamic+static λ=1.0");

# Both static (inv_mass 0) → contact skipped, impulse stays 0.
var si_c3 = contact_new(0, 1, hvec3_unit_y(), F64_HALF, 0, 0, 0, 0);
var si_cs3 = vec_new();
vec_push(si_cs3, si_c3);
var si_out3 = alloc(16);
var _r15t, _r15v = sequential_impulse(si_cs3, 1, 5, si_out3);
assert_eq(load64(si_out3), f64_from(0), "sequential_impulse: both-static skipped (λ=0)");

# 2.8.3 — RESTITUTION. Every assertion above uses e = 0, where the pre-2.8.3
# (1+e)-on-the-effective-velocity form happens to be right. For e > 0 that form
# is the affine map λ_{k+1} = -e·λ_k + (1+e)·pen/inv_mass, which only settles
# for |e| < 1: at e = 1 it is a period-2 orbit alternating 0 and 2·pen/inv_mass,
# so an EVEN iteration count returned 0 — no impulse at all — and an odd one
# returned twice the right answer. The solver's result depended on the PARITY of
# a convergence parameter. Restitution is now a one-off bias on the target
# velocity, so λ = (1+e)·pen/inv_mass after a single sweep for every e >= 0.
# pen = 0.5, inv_mass = 2 → 0.375 / 0.5 / 0.75, all exact in binary.
var sr_i = 0;
while (sr_i < 3) {
    var sr_e = F64_HALF;
    var sr_want = 375;
    if (sr_i == 1) { sr_e = F64_ONE; sr_want = 500; }
    if (sr_i == 2) { sr_e = F64_TWO; sr_want = 750; }

    var sr_c = contact_new(0, 1, hvec3_unit_y(), F64_HALF, 0, sr_e, F64_ONE, F64_ONE);
    var sr_cs = vec_new();
    vec_push(sr_cs, sr_c);
    var sr_o1 = alloc(16);
    var sr_o8 = alloc(16);
    var sr_o9 = alloc(16);
    var _r16t, _r16v = sequential_impulse(sr_cs, 1, 1, sr_o1);
    var _r17t, _r17v = sequential_impulse(sr_cs, 1, 8, sr_o8);
    var _r18t, _r18v = sequential_impulse(sr_cs, 1, 9, sr_o9);

    assert_f64_eq(load64(sr_o1), f64_div(f64_from(sr_want), f64_from(1000)),
      "sequential_impulse: 1 sweep reaches (1+e)·pen/inv_mass");
    assert_eq(load64(sr_o8), load64(sr_o1),
      "sequential_impulse: 8 sweeps == 1 sweep (no period-2 orbit)");
    assert_eq(load64(sr_o9), load64(sr_o8),
      "sequential_impulse: 9 sweeps == 8 sweeps (parity-independent)");
    sr_i = sr_i + 1;
}

# Restitution must MOVE the answer at an even sweep count, where the old form
# collapsed it to exactly zero.
var sr_a = contact_new(0, 1, hvec3_unit_y(), F64_HALF, 0, 0, F64_ONE, F64_ONE);
var sr_b = contact_new(0, 1, hvec3_unit_y(), F64_HALF, 0, F64_ONE, F64_ONE, F64_ONE);
var sr_va = vec_new();
var sr_vb = vec_new();
vec_push(sr_va, sr_a);
vec_push(sr_vb, sr_b);
var sr_oa = alloc(16);
var sr_ob = alloc(16);
var _r19t, _r19v = sequential_impulse(sr_va, 1, 4, sr_oa);
var _r20t, _r20v = sequential_impulse(sr_vb, 1, 4, sr_ob);
assert_eq(load64(sr_ob), f64_mul(F64_TWO, load64(sr_oa)),
  "sequential_impulse: e=1 doubles the e=0 impulse at an even sweep count");

# 2.8.4 — FRICTION, the other half of the same audit row. Through 2.8.4 the
# friction block loaded the output slot it had itself zeroed, clamped that zero
# against mu*lambda_n and stored it back, with no update in between: |0| > cone
# is never true, so the friction impulse was identically 0 for every contact, at
# every mu, at every iteration count (measured: 0 of 320 sampled configs
# nonzero). `friction` was a silently ignored parameter. Nothing in tests/ so
# much as mentioned friction and every fixture above uses mu = 0, so the branch
# was never entered — which is why it survived.
#
# `sequential_impulse` now solves the tangential constraint against the relative
# sliding speed carried in the new ColContact.tangent_vel field, giving the
# closed form
#   lambda_t = clamp(-v_t / inv_mass, -mu*lambda_n, +mu*lambda_n)
# with lambda_n = (1+e)*pen/inv_mass from the restitution block above. Every
# expected value below is that closed form evaluated by hand, not a transcript of
# what the solver printed. The fixtures use inv_mass = 1+1 = 2, pen = 0.5 and
# e = 0, so lambda_n = 0.25 and the cone half-width at mu = 0.5 is 0.125 — all
# exact in binary, so these are bit-equality assertions, not tolerance bands.
test_group("collision_core: sequential_impulse friction (Coulomb cone)");

# One contact, pen = 0.5, two unit-inverse-mass bodies (inv_mass = 2).
fn _fr_solve(mu, vt, e, iters, out) {
    var fc = contact_new_fric(0, 1, hvec3_unit_y(), F64_HALF, mu, e, F64_ONE, F64_ONE, vt);
    var fv = vec_new();
    vec_push(fv, fc);
    var _r21t, _r21v = sequential_impulse(fv, 1, iters, out);
    return 0;
}

var fr_8th = f64_div(F64_ONE, f64_from(8));      # 0.125
var fr_16th = f64_div(F64_ONE, f64_from(16));    # 0.0625
var fr_4th = f64_div(F64_ONE, f64_from(4));      # 0.25
var fr_mu = F64_HALF;

# STICKING: |v_t/inv_mass| = 0.0625 is inside the 0.125 cone, so the constraint
# is met exactly — lambda_t = -v_t/inv_mass and the tangential velocity that
# survives, v_t + lambda_t*inv_mass, is exactly zero.
var fr_oa = alloc(16);
_fr_solve(fr_mu, fr_8th, 0, 6, fr_oa);
assert_eq(load64(fr_oa), fr_4th, "friction: normal impulse still (1+e)·pen/inv_mass = 0.25");
assert_eq(load64(fr_oa + 8), f64_neg(fr_16th),
  "friction: sticking λ_t = -v_t/inv_mass = -0.0625");
assert_eq(f64_add(fr_8th, f64_mul(load64(fr_oa + 8), F64_TWO)), 0,
  "friction: sticking drives tangential velocity to exactly 0");

# SLIDING: v_t = 1 wants lambda_t = -0.5, four times the cone, so the Coulomb
# clamp binds at exactly -mu*lambda_n. The tangential velocity is only REDUCED
# (1.0 -> 0.75), never reversed.
var fr_ob = alloc(16);
_fr_solve(fr_mu, F64_ONE, 0, 6, fr_ob);
assert_eq(load64(fr_ob + 8), f64_neg(fr_8th),
  "friction: sliding saturates at -mu·λ_n = -0.125");
assert_eq(f64_abs(load64(fr_ob + 8)), f64_mul(fr_mu, load64(fr_ob)),
  "friction: clamp binds at |λ_t| = mu·λ_n");
var fr_vb = f64_add(F64_ONE, f64_mul(load64(fr_ob + 8), F64_TWO));
assert_eq(fr_vb, f64_div(f64_from(3), f64_from(4)),
  "friction: sliding reduces v_t 1.0 → 0.75 (same sign, not reversed)");
assert_eq(f64_lt(fr_vb, F64_ONE), 1, "friction: |v_t| strictly decreased");
assert_eq(f64_gt(fr_vb, 0), 1, "friction: v_t not driven past zero");

# SIGN: the impulse opposes the motion on both sides.
var fr_oc = alloc(16);
_fr_solve(fr_mu, f64_neg(F64_ONE), 0, 6, fr_oc);
assert_eq(load64(fr_oc + 8), fr_8th, "friction: v_t < 0 → λ_t > 0 (opposes motion)");
assert_eq(load64(fr_oc + 8), f64_neg(load64(fr_ob + 8)),
  "friction: reversing v_t reverses λ_t exactly");

# mu = 0 REGRESSION GUARD: every solver assertion above this block uses mu = 0
# and must not move by a single bit. mu = 0 skips the friction branch entirely,
# so the slot keeps the +0 written at entry and the normal impulse is unchanged.
var fr_od = alloc(16);
_fr_solve(0, F64_ONE, 0, 6, fr_od);
assert_eq(load64(fr_od + 8), 0, "friction: mu = 0 leaves the friction slot at +0");
assert_eq(load64(fr_od), load64(fr_ob),
  "friction: mu = 0 normal impulse bit-identical to mu = 0.5");

# ITERATION INDEPENDENCE: accumulate-then-clamp bounds the TOTAL impulse, so a
# saturated contact stays saturated instead of gaining another mu·λ_n per sweep.
var fr_o1 = alloc(16);
var fr_o8 = alloc(16);
var fr_o9 = alloc(16);
_fr_solve(fr_mu, fr_8th, 0, 1, fr_o1);
_fr_solve(fr_mu, fr_8th, 0, 8, fr_o8);
_fr_solve(fr_mu, fr_8th, 0, 9, fr_o9);
assert_eq(load64(fr_o1 + 8), load64(fr_o8 + 8), "friction: sticking 1 sweep == 8 sweeps");
assert_eq(load64(fr_o8 + 8), load64(fr_o9 + 8), "friction: sticking 8 sweeps == 9 sweeps");
var fr_s1 = alloc(16);
var fr_s8 = alloc(16);
_fr_solve(fr_mu, F64_ONE, 0, 1, fr_s1);
_fr_solve(fr_mu, F64_ONE, 0, 8, fr_s8);
assert_eq(load64(fr_s1 + 8), load64(fr_s8 + 8),
  "friction: sliding 1 sweep == 8 sweeps (cone does not re-charge)");

# The cone tracks lambda_n: e = 1 doubles the normal impulse to 0.5, so the same
# v_t = 1 now saturates at -0.25 instead of -0.125.
var fr_og = alloc(16);
_fr_solve(fr_mu, F64_ONE, F64_ONE, 6, fr_og);
assert_eq(load64(fr_og), F64_HALF, "friction: e = 1 → λ_n = 0.5");
assert_eq(load64(fr_og + 8), f64_neg(fr_4th), "friction: cone tracks λ_n → -0.25");

# NO NORMAL LOAD, NO FRICTION. pen = 0 gives lambda_n = 0, so the cone collapses
# to a point and the clamp must return exactly zero.
# ⛔ THIS COMMENT USED TO SAY "+0 (not -0: f64_neg(+0) is +0)". That described x86's
# `f64_neg` below cyrius 6.6.8, which computed 0.0 - x; from 6.6.8 it is an IEEE sign
# flip, the cone's lower bound -mu*lambda_n is -0, and a negative lambda_t clamps onto
# it. The sign of a zero impulse is incidental, so both friction zeros below are
# compared as values: exact zero of either sign, still failing for NaN or any residue.
var fr_ch = contact_new_fric(0, 1, hvec3_unit_y(), 0, fr_mu, 0, F64_ONE, F64_ONE, F64_ONE);
var fr_vh = vec_new();
vec_push(fr_vh, fr_ch);
var fr_oh = alloc(16);
var _r22t, _r22v = sequential_impulse(fr_vh, 1, 6, fr_oh);
assert_eq(load64(fr_oh), 0, "friction: pen = 0 → λ_n = 0");
assert_eq(f64_eq(load64(fr_oh + 8), 0), 1, "friction: zero-width cone → friction exactly 0 (it is -0.0)");

# Separating contact: lambda_n clamps to 0, so friction goes with it.
var fr_ci = contact_new_fric(0, 1, hvec3_unit_y(), f64_neg(F64_HALF), fr_mu, 0,
  F64_ONE, F64_ONE, F64_ONE);
var fr_vi = vec_new();
vec_push(fr_vi, fr_ci);
var fr_oi = alloc(16);
var _r23t, _r23v = sequential_impulse(fr_vi, 1, 6, fr_oi);
assert_eq(load64(fr_oi), 0, "friction: separating contact → λ_n = 0");
assert_eq(f64_eq(load64(fr_oi + 8), 0), 1, "friction: separating contact → λ_t = 0 (it is -0.0)");

# Both bodies static: the contact is skipped before friction is reached.
var fr_cj = contact_new_fric(0, 1, hvec3_unit_y(), F64_HALF, fr_mu, 0, 0, 0, F64_ONE);
var fr_vj = vec_new();
vec_push(fr_vj, fr_cj);
var fr_oj = alloc(16);
var _r24t, _r24v = sequential_impulse(fr_vj, 1, 6, fr_oj);
assert_eq(load64(fr_oj + 8), 0, "friction: both-static contact → λ_t = 0");

# A cone wide enough never to bind reproduces the unclamped solution.
var fr_ok = alloc(16);
_fr_solve(f64_from(4), F64_ONE, 0, 6, fr_ok);
assert_eq(load64(fr_ok + 8), f64_neg(F64_HALF),
  "friction: mu = 4 leaves λ_t interior at -v_t/inv_mass");
assert_eq(f64_add(F64_ONE, f64_mul(load64(fr_ok + 8), F64_TWO)), 0,
  "friction: interior solution zeroes v_t exactly");

# The 8-argument contact_new is exactly contact_new_fric with tangent_vel = 0:
# no tangential motion means no friction impulse even at mu > 0, which is why
# every pre-2.8.4 fixture (and every consumer) is bit-for-bit unaffected.
var fr_cl1 = contact_new(0, 1, hvec3_unit_y(), F64_HALF, fr_mu, 0, F64_ONE, F64_ONE);
var fr_cl2 = contact_new_fric(0, 1, hvec3_unit_y(), F64_HALF, fr_mu, 0, F64_ONE, F64_ONE, 0);
var fr_vl1 = vec_new();
var fr_vl2 = vec_new();
vec_push(fr_vl1, fr_cl1);
vec_push(fr_vl2, fr_cl2);
var fr_ol1 = alloc(16);
var fr_ol2 = alloc(16);
var _r25t, _r25v = sequential_impulse(fr_vl1, 1, 6, fr_ol1);
var _r26t, _r26v = sequential_impulse(fr_vl2, 1, 6, fr_ol2);
assert_eq(load64(fr_ol1), load64(fr_ol2),
  "friction: contact_new λ_n == contact_new_fric(tangent_vel = 0) λ_n");
assert_eq(load64(fr_ol1 + 8), load64(fr_ol2 + 8),
  "friction: contact_new λ_t == contact_new_fric(tangent_vel = 0) λ_t");
assert_eq(load64(fr_ol1 + 8), 0, "friction: no tangential motion → λ_t = 0 even at mu > 0");
assert_eq(ColContact_tangent_vel(fr_cl1), 0, "friction: contact_new defaults tangent_vel to 0");
assert_eq(ColContact_tangent_vel(fr_ci), F64_ONE, "friction: contact_new_fric stores tangent_vel");

# Two contacts in one batch keep independent friction slots (16 bytes apart).
var fr_m1 = contact_new_fric(0, 1, hvec3_unit_y(), F64_HALF, fr_mu, 0, F64_ONE, F64_ONE,
  F64_ONE);
var fr_m2 = contact_new_fric(1, 2, hvec3_unit_y(), F64_HALF, fr_mu, 0, F64_ONE, F64_ONE,
  f64_neg(F64_ONE));
var fr_vm = vec_new();
vec_push(fr_vm, fr_m1);
vec_push(fr_vm, fr_m2);
var fr_om = alloc(32);
var _r27t, _r27v = sequential_impulse(fr_vm, 2, 6, fr_om);
assert_eq(load64(fr_om + 8), f64_neg(fr_8th), "friction: batch slot 0 saturates negative");
assert_eq(load64(fr_om + 24), fr_8th, "friction: batch slot 1 saturates positive");

# convex_hull_2d (2.4.0) — Andrew's monotone chain. Square (side 2) plus an
# interior point: the hull is the 4 corners in CCW order; the interior point
# is dropped. Shoelace 2×area = +8 pins both the geometry and the orientation.
test_group("collision_core: convex_hull_2d");

var ch_pts = vec_new();
vec_push(ch_pts, hvec2_new(0, 0));               # idx 0
vec_push(ch_pts, hvec2_new(F64_TWO, 0));         # idx 1
vec_push(ch_pts, hvec2_new(F64_TWO, F64_TWO));   # idx 2
vec_push(ch_pts, hvec2_new(0, F64_TWO));         # idx 3
vec_push(ch_pts, hvec2_new(F64_ONE, F64_ONE));   # idx 4 (interior)
var ch_hull = convex_hull_2d(ch_pts, 5);
assert_eq(vec_len(ch_hull), 4, "convex_hull_2d: square+interior → 4 hull vertices");

assert_neq(vec_get(ch_hull, 0), 4, "convex_hull_2d: interior excluded [0]");
assert_neq(vec_get(ch_hull, 1), 4, "convex_hull_2d: interior excluded [1]");
assert_neq(vec_get(ch_hull, 2), 4, "convex_hull_2d: interior excluded [2]");
assert_neq(vec_get(ch_hull, 3), 4, "convex_hull_2d: interior excluded [3]");

var ch_h0 = vec_get(ch_pts, vec_get(ch_hull, 0));
var ch_h1 = vec_get(ch_pts, vec_get(ch_hull, 1));
var ch_h2 = vec_get(ch_pts, vec_get(ch_hull, 2));
var ch_h3 = vec_get(ch_pts, vec_get(ch_hull, 3));
var ch_a = f64_sub(f64_mul(HVec2_x(ch_h0), HVec2_y(ch_h1)), f64_mul(HVec2_x(ch_h1), HVec2_y(ch_h0)));
ch_a = f64_add(ch_a, f64_sub(f64_mul(HVec2_x(ch_h1), HVec2_y(ch_h2)), f64_mul(HVec2_x(ch_h2), HVec2_y(ch_h1))));
ch_a = f64_add(ch_a, f64_sub(f64_mul(HVec2_x(ch_h2), HVec2_y(ch_h3)), f64_mul(HVec2_x(ch_h3), HVec2_y(ch_h2))));
ch_a = f64_add(ch_a, f64_sub(f64_mul(HVec2_x(ch_h3), HVec2_y(ch_h0)), f64_mul(HVec2_x(ch_h0), HVec2_y(ch_h3))));
assert_eq(ch_a, f64_from(8), "convex_hull_2d: shoelace 2xarea = +8 (CCW, exact square)");

# Degeneracies (2.4.0) — each must return a defined hull, never trap.

# Empty / single point → trivial passthrough.
var ch_empty = vec_new();
assert_eq(vec_len(convex_hull_2d(ch_empty, 0)), 0, "convex_hull_2d: empty -> 0 vertices");
var ch_one = vec_new();
vec_push(ch_one, hvec2_new(F64_ONE, F64_ONE));
assert_eq(vec_len(convex_hull_2d(ch_one, 1)), 1, "convex_hull_2d: single point -> 1 vertex");

# Triangle → all 3 vertices; shoelace 2×area = +4 (CCW).
var ch_t = vec_new();
vec_push(ch_t, hvec2_new(0, 0));
vec_push(ch_t, hvec2_new(F64_TWO, 0));
vec_push(ch_t, hvec2_new(F64_ONE, F64_TWO));
var ch_th = convex_hull_2d(ch_t, 3);
assert_eq(vec_len(ch_th), 3, "convex_hull_2d: triangle -> 3 vertices");
var ch_t0 = vec_get(ch_t, vec_get(ch_th, 0));
var ch_t1 = vec_get(ch_t, vec_get(ch_th, 1));
var ch_t2 = vec_get(ch_t, vec_get(ch_th, 2));
var ch_ta = f64_sub(f64_mul(HVec2_x(ch_t0), HVec2_y(ch_t1)), f64_mul(HVec2_x(ch_t1), HVec2_y(ch_t0)));
ch_ta = f64_add(ch_ta, f64_sub(f64_mul(HVec2_x(ch_t1), HVec2_y(ch_t2)), f64_mul(HVec2_x(ch_t2), HVec2_y(ch_t1))));
ch_ta = f64_add(ch_ta, f64_sub(f64_mul(HVec2_x(ch_t2), HVec2_y(ch_t0)), f64_mul(HVec2_x(ch_t0), HVec2_y(ch_t2))));
assert_eq(ch_ta, f64_from(4), "convex_hull_2d: triangle shoelace 2xarea = +4 (CCW)");

# Collinear → only the 2 extreme endpoints (interior point dropped).
var ch_c = vec_new();
vec_push(ch_c, hvec2_new(0, 0));
vec_push(ch_c, hvec2_new(F64_ONE, 0));
vec_push(ch_c, hvec2_new(F64_TWO, 0));
var ch_ch = convex_hull_2d(ch_c, 3);
assert_eq(vec_len(ch_ch), 2, "convex_hull_2d: collinear -> 2 endpoints");
var ch_c0 = vec_get(ch_c, vec_get(ch_ch, 0));
var ch_c1 = vec_get(ch_c, vec_get(ch_ch, 1));
var ch_cspan = f64_to(f64_abs(f64_sub(HVec2_x(ch_c0), HVec2_x(ch_c1))));
assert_eq(ch_cspan, 2, "convex_hull_2d: collinear endpoints span x=0..2");

# Duplicate corner → still the 4-vertex square (no spurious vertex, no trap).
var ch_d = vec_new();
vec_push(ch_d, hvec2_new(0, 0));
vec_push(ch_d, hvec2_new(0, 0));
vec_push(ch_d, hvec2_new(F64_TWO, 0));
vec_push(ch_d, hvec2_new(F64_TWO, F64_TWO));
vec_push(ch_d, hvec2_new(0, F64_TWO));
assert_eq(vec_len(convex_hull_2d(ch_d, 5)), 4, "convex_hull_2d: duplicate corner -> 4 vertices");

# triangulate_polygon (2.4.1) — ear clipping. Audited; no bug found. Each case
# checks the count (3*(n-2) flat indices) and that the triangles tile the
# polygon: |Σ 2×area| == polygon |2×area| (abs makes it winding-agnostic).
test_group("collision_core: triangulate_polygon");

# ================================================================
# 2.20.0 -- THE SELF-INTERSECTING DIVERGENCE, PINNED IN THE DIRECTION IT ACTUALLY
# GOES
# ================================================================
# ⛔ 2.7.1's reflex-only prune changes the return LENGTH on self-intersecting
# input, and the CHANGELOG recorded the direction BACKWARDS, twice, for thirteen
# releases: "old-partial -> new-complete, the new code succeeds where the old
# bailed". Measured by building the 2.7.0 tree and this one side by side on
# cyrius 6.6.2 and running both on the same reproducer: **old returns 9 indices
# (COMPLETE), this code returns 6 (PARTIAL)** -- old [0 1 2 4 0 2 4 2 3], new
# [4 0 1 1 2 3]. The new code BAILS WHERE THE OLD SUCCEEDED.
# ⚠ The decision is unchanged: the divergence is confined to input ear clipping
# does not define, and a partial return is inside the documented contract. What
# was wrong was the sentence, and it lived only in the CHANGELOG where no gate
# could reach it. This assertion puts the direction where a test can hold it.
# [measured: the 2.7.0 tree vs HEAD, both built on cyrius 6.6.2, 2026-09-10]
var _tpx = vec_new();
vec_push(_tpx, hvec2_new(0, 0));
vec_push(_tpx, hvec2_new(F64_ONE, F64_TWO));
vec_push(_tpx, hvec2_new(F64_ONE, F64_ONE));
vec_push(_tpx, hvec2_new(0, F64_TWO));
vec_push(_tpx, hvec2_new(F64_TWO, F64_ONE));
var _tpxt = triangulate_polygon(_tpx, 5);
assert_neq(_tpxt, 0, "triangulate_polygon: self-intersecting pentagon returns a vec");
# ⚠ Asserted as an EXACT length, not `<= 9`. `<= 9` is satisfied by the complete
# answer too, so it could not tell the two directions apart -- which is how the
# backwards claim survived thirteen releases.
assert_eq(vec_len(_tpxt), 6,
  "triangulate_polygon: self-intersecting pentagon is PARTIAL (6), where 2.7.0 gave COMPLETE (9)");
assert_eq(vec_len(_tpxt) < 3 * (5 - 2), 1,
  "triangulate_polygon: ...and PARTIAL is inside the documented < 3*(n-2) contract");

# Convex quad (side-2 square) → 2 triangles, 2×area = 8.
var tp_q = vec_new();
vec_push(tp_q, hvec2_new(0, 0));
vec_push(tp_q, hvec2_new(F64_TWO, 0));
vec_push(tp_q, hvec2_new(F64_TWO, F64_TWO));
vec_push(tp_q, hvec2_new(0, F64_TWO));
var tp_qt = triangulate_polygon(tp_q, 4);
assert_eq(vec_len(tp_qt), 6, "triangulate_polygon: convex quad -> 2 triangles");
assert_eq(f64_abs(_tp_area2x(tp_q, tp_qt)), f64_from(8), "triangulate_polygon: quad tiles (2xarea=8)");

# Concave 5-gon (reflex at (1,1)) → 3 triangles, 2×area = 6.
var tp_c = vec_new();
vec_push(tp_c, hvec2_new(0, 0));
vec_push(tp_c, hvec2_new(F64_TWO, 0));
vec_push(tp_c, hvec2_new(F64_TWO, F64_TWO));
vec_push(tp_c, hvec2_new(F64_ONE, F64_ONE));
vec_push(tp_c, hvec2_new(0, F64_TWO));
var tp_ct = triangulate_polygon(tp_c, 5);
assert_eq(vec_len(tp_ct), 9, "triangulate_polygon: concave 5-gon -> 3 triangles");
assert_eq(f64_abs(_tp_area2x(tp_c, tp_ct)), f64_from(6), "triangulate_polygon: concave tiles (2xarea=6)");

# Convex hexagon → 4 triangles, 2×area = 24.
var tp_h = vec_new();
vec_push(tp_h, hvec2_new(0, 0));
vec_push(tp_h, hvec2_new(F64_TWO, 0));
vec_push(tp_h, hvec2_new(f64_from(3), F64_TWO));
vec_push(tp_h, hvec2_new(F64_TWO, f64_from(4)));
vec_push(tp_h, hvec2_new(0, f64_from(4)));
vec_push(tp_h, hvec2_new(f64_neg(F64_ONE), F64_TWO));
var tp_ht = triangulate_polygon(tp_h, 6);
assert_eq(vec_len(tp_ht), 12, "triangulate_polygon: hexagon -> 4 triangles");
assert_eq(f64_abs(_tp_area2x(tp_h, tp_ht)), f64_from(24), "triangulate_polygon: hexagon tiles (2xarea=24)");

# U-shape (8 verts, 2 reflex) → 6 triangles, 2×area = 14.
var tp_u = vec_new();
vec_push(tp_u, hvec2_new(0, 0));
vec_push(tp_u, hvec2_new(f64_from(3), 0));
vec_push(tp_u, hvec2_new(f64_from(3), f64_from(3)));
vec_push(tp_u, hvec2_new(F64_TWO, f64_from(3)));
vec_push(tp_u, hvec2_new(F64_TWO, F64_ONE));
vec_push(tp_u, hvec2_new(F64_ONE, F64_ONE));
vec_push(tp_u, hvec2_new(F64_ONE, f64_from(3)));
vec_push(tp_u, hvec2_new(0, f64_from(3)));
var tp_ut = triangulate_polygon(tp_u, 8);
assert_eq(vec_len(tp_ut), 18, "triangulate_polygon: U-shape (2 reflex) -> 6 triangles");
assert_eq(f64_abs(_tp_area2x(tp_u, tp_ut)), f64_from(14), "triangulate_polygon: U-shape tiles (2xarea=14)");

# CW winding (reversed square) → still 2 triangles tiling area 4.
var tp_w = vec_new();
vec_push(tp_w, hvec2_new(0, 0));
vec_push(tp_w, hvec2_new(0, F64_TWO));
vec_push(tp_w, hvec2_new(F64_TWO, F64_TWO));
vec_push(tp_w, hvec2_new(F64_TWO, 0));
var tp_wt = triangulate_polygon(tp_w, 4);
assert_eq(vec_len(tp_wt), 6, "triangulate_polygon: CW quad -> 2 triangles");
assert_eq(f64_abs(_tp_area2x(tp_w, tp_wt)), f64_from(8), "triangulate_polygon: CW quad tiles (2xarea=8)");

# Collinear edge vertex (1,0) on the bottom edge → 3 triangles, 2×area = 8.
var tp_l = vec_new();
vec_push(tp_l, hvec2_new(0, 0));
vec_push(tp_l, hvec2_new(F64_ONE, 0));
vec_push(tp_l, hvec2_new(F64_TWO, 0));
vec_push(tp_l, hvec2_new(F64_TWO, F64_TWO));
vec_push(tp_l, hvec2_new(0, F64_TWO));
var tp_lt = triangulate_polygon(tp_l, 5);
assert_eq(vec_len(tp_lt), 9, "triangulate_polygon: collinear edge vertex -> 3 triangles");
assert_eq(f64_abs(_tp_area2x(tp_l, tp_lt)), f64_from(8), "triangulate_polygon: collinear tiles (2xarea=8)");

# < 3 vertices → empty.
var tp_deg = vec_new();
vec_push(tp_deg, hvec2_new(0, 0));
vec_push(tp_deg, hvec2_new(F64_ONE, 0));
assert_eq(vec_len(triangulate_polygon(tp_deg, 2)), 0, "triangulate_polygon: n<3 -> empty");

# ================================================================
# COLLISION_MESH — Delaunay, half-edge, island detection
# ================================================================

# delaunay_2d (2.4.2) — Bowyer-Watson. Audited; no bug found, numerically robust
# (incl. the cocircular grid). Each fixture checks the empty-circumcircle
# (Delaunay) property holds — no point strictly inside any triangle's
# circumcircle — plus the triangle count (3 indices per triangle).
test_group("collision_mesh: delaunay_2d");

# Square (side 4) + interior point → 4 triangles, Delaunay-valid.
var dl_sq = vec_new();
vec_push(dl_sq, hvec2_new(0, 0));
vec_push(dl_sq, hvec2_new(f64_from(4), 0));
vec_push(dl_sq, hvec2_new(f64_from(4), f64_from(4)));
vec_push(dl_sq, hvec2_new(0, f64_from(4)));
vec_push(dl_sq, hvec2_new(F64_ONE, F64_ONE));
var dl_sqt = delaunay_2d(dl_sq, 5);
assert_eq(vec_len(dl_sqt), 12, "delaunay_2d: square+interior -> 4 triangles");
assert_eq(_dl_violations(dl_sq, 5, dl_sqt), 0, "delaunay_2d: square+interior empty-circumcircle");

# 3x3 grid — heavy cocircularity, the numerical-stability stress case.
var dl_g = vec_new();
vec_push(dl_g, hvec2_new(0, 0));
vec_push(dl_g, hvec2_new(F64_ONE, 0));
vec_push(dl_g, hvec2_new(F64_TWO, 0));
vec_push(dl_g, hvec2_new(0, F64_ONE));
vec_push(dl_g, hvec2_new(F64_ONE, F64_ONE));
vec_push(dl_g, hvec2_new(F64_TWO, F64_ONE));
vec_push(dl_g, hvec2_new(0, F64_TWO));
vec_push(dl_g, hvec2_new(F64_ONE, F64_TWO));
vec_push(dl_g, hvec2_new(F64_TWO, F64_TWO));
var dl_gt = delaunay_2d(dl_g, 9);
assert_eq(vec_len(dl_gt), 24, "delaunay_2d: 3x3 grid -> 8 triangles");
assert_eq(_dl_violations(dl_g, 9, dl_gt), 0, "delaunay_2d: 3x3 grid empty-circumcircle (cocircular)");

# Irregular 6-point set.
var dl_i = vec_new();
vec_push(dl_i, hvec2_new(0, 0));
vec_push(dl_i, hvec2_new(f64_from(5), F64_ONE));
vec_push(dl_i, hvec2_new(f64_from(3), f64_from(4)));
vec_push(dl_i, hvec2_new(F64_ONE, f64_from(5)));
vec_push(dl_i, hvec2_new(f64_from(6), f64_from(5)));
vec_push(dl_i, hvec2_new(F64_TWO, F64_TWO));
var dl_it = delaunay_2d(dl_i, 6);
assert_eq(_dl_violations(dl_i, 6, dl_it), 0, "delaunay_2d: irregular-6 empty-circumcircle");

# Single triangle (n=3).
var dl_t = vec_new();
vec_push(dl_t, hvec2_new(0, 0));
vec_push(dl_t, hvec2_new(f64_from(4), 0));
vec_push(dl_t, hvec2_new(F64_TWO, f64_from(3)));
assert_eq(vec_len(delaunay_2d(dl_t, 3)), 3, "delaunay_2d: n=3 -> 1 triangle");

# Degenerate: n<3 and all-collinear → empty, never a trap.
var dl_two = vec_new();
vec_push(dl_two, hvec2_new(0, 0));
vec_push(dl_two, hvec2_new(F64_ONE, 0));
assert_eq(vec_len(delaunay_2d(dl_two, 2)), 0, "delaunay_2d: n<3 -> empty");
var dl_col = vec_new();
vec_push(dl_col, hvec2_new(0, 0));
vec_push(dl_col, hvec2_new(F64_ONE, 0));
vec_push(dl_col, hvec2_new(F64_TWO, 0));
vec_push(dl_col, hvec2_new(f64_from(3), 0));
assert_eq(vec_len(delaunay_2d(dl_col, 4)), 0, "delaunay_2d: all-collinear -> empty (no trap)");

# halfedge mesh (2.4.3) — halfedge_from_triangles + adjacency / boundary queries.
# Audited; no bug found. Twin wiring (reverse-edge match), the one-ring boundary
# walk, and adjacent-faces-via-twins are correct on closed + open meshes.
test_group("collision_mesh: half-edge mesh");

# Tetrahedron (closed manifold): every edge shared → no boundary vertices,
# each face has 3 neighbours.
var he_tet = vec_new();
_he_tri(he_tet, 0, 1, 2);
_he_tri(he_tet, 0, 2, 3);
_he_tri(he_tet, 0, 3, 1);
_he_tri(he_tet, 1, 3, 2);
var he_tm = halfedge_from_triangles(he_tet, 4, 4);
assert_eq(_he_boundary_sum(he_tm, 4), 0, "half-edge: tetrahedron has no boundary vertices");
assert_eq(vec_len(halfedge_adjacent_faces(he_tm, 0)), 3, "half-edge: tetrahedron face has 3 neighbours");

# Single triangle (open): all 3 verts boundary, no neighbours.
var he_one = vec_new();
_he_tri(he_one, 0, 1, 2);
var he_om = halfedge_from_triangles(he_one, 1, 3);
assert_eq(_he_boundary_sum(he_om, 3), 3, "half-edge: single triangle all-boundary");
assert_eq(vec_len(halfedge_adjacent_faces(he_om, 0)), 0, "half-edge: single triangle has no neighbours");

# Two triangles sharing diagonal 0-2: all 4 corners boundary, face 0 has 1 neighbour.
var he_q = vec_new();
_he_tri(he_q, 0, 1, 2);
_he_tri(he_q, 0, 2, 3);
var he_qm = halfedge_from_triangles(he_q, 2, 4);
assert_eq(_he_boundary_sum(he_qm, 4), 4, "half-edge: quad corners all boundary");
assert_eq(vec_len(halfedge_adjacent_faces(he_qm, 0)), 1, "half-edge: quad face shares 1 edge");

# Hexagon fan: center (0) interior, rim (1..6) boundary → one-ring walk closes.
var he_f = vec_new();
_he_tri(he_f, 0, 1, 2);
_he_tri(he_f, 0, 2, 3);
_he_tri(he_f, 0, 3, 4);
_he_tri(he_f, 0, 4, 5);
_he_tri(he_f, 0, 5, 6);
_he_tri(he_f, 0, 6, 1);
var he_fm = halfedge_from_triangles(he_f, 6, 7);
var _rq37t, _rq37v = halfedge_is_boundary(he_fm, 0);
assert_eq(is_ok(_rq37t), 1, "half-edge: fan center is interior");
var _rq38t, _rq38v = halfedge_is_boundary(he_fm, 1);
assert_eq(is_ok(_rq38t), 1, "half-edge: fan rim vertex is boundary");
assert_eq(_rq38v, 1, "half-edge: fan rim vertex is boundary");
assert_eq(_he_boundary_sum(he_fm, 7), 6, "half-edge: fan has 6 boundary (rim) vertices");
assert_eq(vec_len(halfedge_adjacent_faces(he_fm, 0)), 2, "half-edge: fan face0 shares 2 edges");

# Error path: empty triangle list → null mesh.
var he_empty = vec_new();
assert_eq(halfedge_from_triangles(he_empty, 0, 0), 0, "half-edge: empty -> null mesh");

test_group("collision_mesh: detect_islands");

# Two contact-connected components: bodies {0,1} and {2,3}
var ic1 = contact_new(0, 1, hvec3_unit_y(), F64_HALF, F64_HALF, F64_HALF, F64_ONE, F64_ONE);
var ic2 = contact_new(2, 3, hvec3_unit_y(), F64_HALF, F64_HALF, F64_HALF, F64_ONE, F64_ONE);
var ic_vec = vec_new();
vec_push(ic_vec, ic1);
vec_push(ic_vec, ic2);
var islands = detect_islands(ic_vec, 2, 4);
assert_eq(vec_len(islands), 2, "detect_islands: 2 disjoint contact pairs → 2 islands");

# ================================================================
# einsum — first coverage (the module shipped untested through 2.6.12)
# ================================================================
# `_einsum_is_label` accepted only 'a'..'h', so every example in einsum.cyr's OWN
# header ("ij,jk->ik", "ii->", "ij->ji", "i,j->ij") used labels the parser
# rejected — and it SKIPPED them silently rather than erroring, so matmul returned
# the trace (5, not 19) and then SEGFAULTED. Alphabet widened to a-z and every
# malformed spec is now an explicit 0-return.
test_group("einsum: documented notations");

fn _es_mk2(r2, c2, v0, v1, v2, v3) {
    var sh = alloc(16);
    store64(sh, r2);
    store64(sh + 8, c2);
    var t = tensor_new(2, sh);
    var d = HTensor_data(t);
    store64(d, v0);
    store64(d + 8, v1);
    store64(d + 16, v2);
    store64(d + 24, v3);
    return t;
}

# A = [[1,2],[3,4]], B = [[5,6],[7,8]] -> A*B = [[19,22],[43,50]]
var es_A = _es_mk2(2, 2, f64_from(1), f64_from(2), f64_from(3), f64_from(4));
var es_B = _es_mk2(2, 2, f64_from(5), f64_from(6), f64_from(7), f64_from(8));
var es_two = alloc(16);
store64(es_two, es_A);
store64(es_two + 8, es_B);
var es_one = alloc(8);
store64(es_one, es_A);

var es_mm = einsum(str_from("ij,jk->ik"), es_two, 2);
assert_neq(es_mm, 0, "einsum: matmul returns a tensor");
assert_eq(tensor_get2(es_mm, 0, 0), f64_from(19), "einsum matmul [0][0]=19");
assert_eq(tensor_get2(es_mm, 0, 1), f64_from(22), "einsum matmul [0][1]=22");
assert_eq(tensor_get2(es_mm, 1, 0), f64_from(43), "einsum matmul [1][0]=43");
assert_eq(tensor_get2(es_mm, 1, 1), f64_from(50), "einsum matmul [1][1]=50");

var es_tr = einsum(str_from("ii->"), es_one, 1);
assert_neq(es_tr, 0, "einsum: trace returns a tensor");
assert_eq(load64(HTensor_data(es_tr)), f64_from(5), "einsum trace(A)=5");

var es_tp = einsum(str_from("ij->ji"), es_one, 1);
assert_neq(es_tp, 0, "einsum: transpose returns a tensor");
assert_eq(tensor_get2(es_tp, 0, 1), f64_from(3), "einsum transpose [0][1]=3");
assert_eq(tensor_get2(es_tp, 1, 0), f64_from(2), "einsum transpose [1][0]=2");

test_group("mat3 — first coverage (module shipped untested through 2.6.12)");
var m3i = m3_identity();
assert_eq(m3_determinant(m3i), f64_from(1), "m3_determinant(I)=1");
assert_eq(m3_trace(m3i), f64_from(3), "m3_trace(I)=3");
var m3p = m3_mul(m3i, m3i);
assert_eq(m3_get(m3p, 0, 0), f64_from(1), "m3_mul(I,I)[0][0]=1");
assert_eq(m3_get(m3p, 1, 0), f64_from(0), "m3_mul(I,I)[1][0]=0");
# M * M^-1 = I for a non-symmetric invertible matrix
var m3a = m3_new();
m3_set(m3a, 0, 0, f64_from(2)); m3_set(m3a, 0, 1, F64_ONE);   m3_set(m3a, 0, 2, 0);
m3_set(m3a, 1, 0, F64_ONE);     m3_set(m3a, 1, 1, f64_from(3)); m3_set(m3a, 1, 2, F64_ONE);
m3_set(m3a, 2, 0, 0);           m3_set(m3a, 2, 1, F64_ONE);   m3_set(m3a, 2, 2, F64_TWO);
var m3inv = m3_inverse(m3a);
assert_neq(m3inv, 0, "m3_inverse returns non-null");
var m3ii = m3_mul(m3a, m3inv);
assert(f64_approx_eq(m3_get(m3ii, 0, 0), F64_ONE, LOOSE_TOL_M), "m3 inv round-trip [0][0]=1");
assert(f64_approx_eq(m3_get(m3ii, 1, 1), F64_ONE, LOOSE_TOL_M), "m3 inv round-trip [1][1]=1");
assert(f64_approx_eq(m3_get(m3ii, 0, 1), 0, LOOSE_TOL_M), "m3 inv round-trip [0][1]=0");
# transpose is an involution; det(M^T) == det(M)
assert(f64_approx_eq(m3_determinant(m3_transpose(m3a)), m3_determinant(m3a), LOOSE_TOL_M),
  "m3 det(M^T)==det(M)");
# from_quat(identity) is the identity rotation
assert(f64_approx_eq(m3_trace(m3_from_quat(hquat_identity())), f64_from(3), LOOSE_TOL_M),
  "m3_from_quat(identity) trace=3");

test_group("Lie: SU(2)->SO(3) double cover (half-angle convention)");
# su2_exp used a FULL-angle convention through 2.6.12 while so3_exp,
# su2_from_axis_angle and su2_to_rotation_matrix all use half-angle, so these two
# rotations differed by a factor of 2 — and se3_exp built R and t from angles a
# factor of 2 apart, producing a pair that was not the exponential of any twist.
var lw = hvec3_new(f64_div(F64_ONE, f64_from(3)), f64_div(F64_ONE, F64_TWO),
  f64_div(F64_ONE, f64_from(5)));
var lR_su2 = su2_to_rotation_matrix(su2_exp(lw));
var lR_so3 = so3_exp(lw);
var lei = 0;
while (lei < 9) {
    assert(f64_approx_eq(load64(lR_su2 + lei * 8), load64(lR_so3 + lei * 8), LOOSE_TOL_M),
      "su2_to_rotation_matrix(su2_exp(w)) == so3_exp(w)");
    lei = lei + 1;
}
# exp must agree with the axis-angle constructor
var lax = hvec3_new(0, 0, F64_ONE);
assert(f64_approx_eq(_su2_w(su2_exp(hvec3_scale(lax, F64_PI_2))),
    _su2_w(su2_from_axis_angle(lax, F64_PI_2)), LOOSE_TOL_M),
  "su2_exp == su2_from_axis_angle (w)");
# log inverts exp
var llg = su2_log(su2_exp(lw));
assert(f64_approx_eq(HVec3_x(llg), HVec3_x(lw), LOOSE_TOL_M), "su2_log(su2_exp(w)).x == w.x");
assert(f64_approx_eq(HVec3_y(llg), HVec3_y(lw), LOOSE_TOL_M), "su2_log(su2_exp(w)).y == w.y");
assert(f64_approx_eq(HVec3_z(llg), HVec3_z(lw), LOOSE_TOL_M), "su2_log(su2_exp(w)).z == w.z");

test_group("lie_ext: SE(3) — first coverage (module shipped untested through 2.6.12)");
var ltw = alloc(48);
store64(ltw, HVec3_x(lw));
store64(ltw + 8, HVec3_y(lw));
store64(ltw + 16, HVec3_z(lw));
store64(ltw + 24, F64_ONE);
store64(ltw + 32, F64_TWO);
store64(ltw + 40, f64_from(3));
var lse = se3_exp(ltw);
assert_neq(lse, 0, "se3_exp returns non-null");
# se3_log must invert se3_exp on all six twist components
var ltw2 = se3_log(lse);
lei = 0;
while (lei < 6) {
    assert(f64_approx_eq(load64(ltw2 + lei * 8), load64(ltw + lei * 8), LOOSE_TOL_M),
      "se3_log(se3_exp(twist)) round-trips");
    lei = lei + 1;
}
# and its rotation block must be the SAME rotation so3_exp gives for that omega
var lR_se3 = su2_to_rotation_matrix(_se3_rot(lse));
lei = 0;
while (lei < 9) {
    assert(f64_approx_eq(load64(lR_se3 + lei * 8), load64(lR_so3 + lei * 8), LOOSE_TOL_M),
      "se3_exp rotation block == so3_exp(omega)");
    lei = lei + 1;
}
# ⭐ 3.3.4 — se3_log's tangent, bit for bit: a turn of 2 about z, t = (1, 2, 3), so
# v = (2 + cot 1, 2 cot 1 - 1, 3). The inlined sin/cos quotient (hisab's `f64_tan`
# until 3.3.4) gives v_y = ...3f8, 1.95 ulp from the truth; ganita_f64_tan gives ...3f4
# (2.05 ulp). Flip this when se3_log switches tangents.
# [measured: scratch harness and Decimal oracle, not reproducible in-tree, 2026-10-03; cycc 6.6.14]
var lse_z2 = se3_new(su2_from_axis_angle(hvec3_new(0, 0, F64_ONE), F64_TWO),
  hvec3_new(F64_ONE, F64_TWO, f64_from(3)));
assert_eq(HVec3_y(se3_twist_v(se3_log(lse_z2))), 0x3FD23017413873F8,
  "se3_log: v_y of a turn of 2 about z, the quotient tangent bit for bit");

# ================================================================
# calc_ext + noise_simplex — first coverage (untested through 2.6.13)
# ================================================================
# ================================================================
# Collision hot paths — O(n log n) rewrites (2.6.15)
# ================================================================
# Both were O(n^2). The assertions here pin the CONTRACT, not the timing:
# a correct sort is a zero-inversion permutation, and a correct half-edge mesh
# satisfies twin(twin(i)) == i with a known boundary count. Timings live in
# bench-history.csv (convex_hull_2d_2k, halfedge_2k_tris).
# ================================================================
# num_ext + symbolic_ext — final two never-tested modules (2.6.15)
# ================================================================
# With these, all 34 modules shipped at 2.6.15 were included by at least one suite.
# It still holds for the 35 that ship now.
test_group("num_ext: transforms and number theory");

# num_dst is DST-I (its label said Type II through 2.6.14). DST-I is its own
# inverse up to the 2/(n+1) scale, so idst(dst(x)) must round-trip.
var ne_n = 8;
var ne_x = alloc(ne_n * 8);
var ne_orig = alloc(ne_n * 8);
var ne_i = 0;
while (ne_i < ne_n) {
    var ne_v = f64_from((ne_i * 7) % 5 + 1);
    store64(ne_x + ne_i * 8, ne_v);
    store64(ne_orig + ne_i * 8, ne_v);
    ne_i = ne_i + 1;
}
var _rq85t, _rq85v = num_dst(ne_x, ne_n);
assert_eq(is_ok(_rq85t), 1, "num_dst returns HSB_ERR_NONE");
var _rq86t, _rq86v = num_idst(ne_x, ne_n);
assert_eq(is_ok(_rq86t), 1, "num_idst returns HSB_ERR_NONE");
var ne_bad = 0;
ne_i = 0;
while (ne_i < ne_n) {
    if (f64_approx_eq(load64(ne_x + ne_i * 8), load64(ne_orig + ne_i * 8), LOOSE_TOL_M) == 0) {
        ne_bad = ne_bad + 1;
    }
    ne_i = ne_i + 1;
}
assert_eq(ne_bad, 0, "num_idst(num_dst(x)) round-trips");
# The round-trip above is necessary but NOT sufficient: DST-I is symmetric with
# S^2 = ((n+1)/2) I, and so is -S, and so is every other symmetric involution
# (DCT-I included). A global sign flip, or the wrong kernel entirely, round-trips
# perfectly. Pin the kernel itself with delta inputs, which read off one column:
#   x = e_j  =>  X[k] = sin(PI (j+1)(k+1) / (n+1))
# With n = 7 the angles are exact multiples of PI/8, so the column is a closed
# form: sin(PI/8)=0.3826834323650898, sin(PI/4)=0.7071067811865476,
#       sin(3PI/8)=0.9238795325112867, sin(PI/2)=1.
var nd = alloc(7 * 8);
var ndi = 0;
while (ndi < 7) { store64(nd + ndi * 8, 0); ndi = ndi + 1; }
store64(nd, F64_ONE);                      # x = e_0
var _rq87t, _rq87v = num_dst(nd, 7);
assert_eq(is_ok(_rq87t), 1, "num_dst(e_0) ok");
assert(f64_approx_eq(load64(nd + 0), 0x3FD87DE2A6AEA963, EPSILON_F64), "DST-I e0 k0 sin(PI/8)");
assert(f64_approx_eq(load64(nd + 8), 0x3FE6A09E667F3BCC, EPSILON_F64), "DST-I e0 k1 sin(PI/4)");
assert(f64_approx_eq(load64(nd + 16), 0x3FED906BCF328D46, EPSILON_F64), "DST-I e0 k2 sin(3PI/8)");
assert(f64_approx_eq(load64(nd + 24), F64_ONE, EPSILON_F64), "DST-I e0 k3 sin(PI/2)=1");
assert(f64_approx_eq(load64(nd + 32), 0x3FED906BCF328D46, EPSILON_F64), "DST-I e0 k4 sin(5PI/8)");
assert(f64_approx_eq(load64(nd + 40), 0x3FE6A09E667F3BCC, EPSILON_F64), "DST-I e0 k5 sin(3PI/4)");
assert(f64_approx_eq(load64(nd + 48), 0x3FD87DE2A6AEA963, EPSILON_F64), "DST-I e0 k6 sin(7PI/8)");
# x = e_1 -> X[k] = sin(PI (k+1)/4): the signed, zero-crossing column. This is
# what catches a sign flip or a cosine kernel; column 0 above is palindromic.
var nd2 = alloc(7 * 8);
ndi = 0;
while (ndi < 7) { store64(nd2 + ndi * 8, 0); ndi = ndi + 1; }
store64(nd2 + 8, F64_ONE);
var _rq88t, _rq88v = num_dst(nd2, 7);
assert_eq(is_ok(_rq88t), 1, "num_dst(e_1) ok");
assert(f64_approx_eq(load64(nd2 + 0), 0x3FE6A09E667F3BCC, EPSILON_F64), "DST-I e1 k0 = +sqrt2/2");
assert(f64_approx_eq(load64(nd2 + 8), F64_ONE, EPSILON_F64), "DST-I e1 k1 = +1");
assert(f64_approx_eq(load64(nd2 + 16), 0x3FE6A09E667F3BCC, EPSILON_F64), "DST-I e1 k2 = +sqrt2/2");
assert(f64_approx_eq(load64(nd2 + 24), 0, EPSILON_F64), "DST-I e1 k3 = sin(PI) = 0");
assert(f64_approx_eq(load64(nd2 + 32), 0xBFE6A09E667F3BCC, EPSILON_F64), "DST-I e1 k4 = -sqrt2/2");
assert(f64_approx_eq(load64(nd2 + 40), f64_neg(F64_ONE), EPSILON_F64), "DST-I e1 k5 = -1");
assert(f64_approx_eq(load64(nd2 + 48), 0xBFE6A09E667F3BCC, EPSILON_F64), "DST-I e1 k6 = -sqrt2/2");
var _rq89t, _rq89v = num_dst(ne_x, 0);
assert_eq(is_err_result(_rq89t), 1, "num_dst(n=0) -> INVALID_INPUT");
assert_eq(_rq89v, HSB_ERR_INVALID_INPUT, "num_dst(n=0) -> INVALID_INPUT");
# DCT-II: X[0] of a constant signal c is n*c.
var ne_c = alloc(4 * 8);
ne_i = 0;
while (ne_i < 4) {
    store64(ne_c + ne_i * 8, F64_TWO);
    ne_i = ne_i + 1;
}
var _rq90t, _rq90v = num_dct(ne_c, 4);
assert_eq(is_ok(_rq90t), 1, "num_dct returns HSB_ERR_NONE");
assert(f64_approx_eq(load64(ne_c), f64_from(8), LOOSE_TOL_M), "DCT-II X[0] of const 2 over n=4 is 8");

# Mobius: mu(1)=1, mu(2)=-1, mu(4)=0 (square factor), mu(6)=1 (two primes)
assert_eq(num_mobius(1), 1, "mobius(1)=1");
assert_eq(num_mobius(2), 0 - 1, "mobius(2)=-1");
assert_eq(num_mobius(4), 0, "mobius(4)=0 (square factor)");
assert_eq(num_mobius(6), 1, "mobius(6)=1");

# Tridiagonal solve: identity system returns the RHS unchanged.
var ne_a = alloc(3 * 8);
var ne_b = alloc(3 * 8);
var ne_cc = alloc(3 * 8);
var ne_d = alloc(3 * 8);
var ne_out = alloc(3 * 8);
ne_i = 0;
while (ne_i < 3) {
    store64(ne_a + ne_i * 8, 0);
    store64(ne_b + ne_i * 8, F64_ONE);
    store64(ne_cc + ne_i * 8, 0);
    store64(ne_d + ne_i * 8, f64_from(ne_i + 1));
    ne_i = ne_i + 1;
}
var _rq91t, _rq91v = num_tridiag_solve(ne_a, ne_b, ne_cc, ne_d, 3, ne_out);
assert_eq(is_ok(_rq91t), 1, "num_tridiag_solve returns HSB_ERR_NONE");
assert_eq(load64(ne_out), f64_from(1), "tridiag identity x[0]=1");
assert_eq(load64(ne_out + 16), f64_from(3), "tridiag identity x[2]=3");

# ----------------------------------------------------------------
# num_tridiag_solve on systems with LIVE off-diagonals (2.8.3)
#
# The fixture above is DIAGONAL: a and c are all zero, so c'[i] = 0 for every
# i, the elimination denominator collapses to b[i], the d' recurrence loses its
# a*d'[i-1] term and num_tridiag_solve's back-substitution loop subtracts
# c'[j] * x[j+1] == 0. The entire Thomas algorithm -- most of the function's
# body -- is multiplied by zero and the test still passes. The two systems
# below have nonzero sub- AND super-diagonals so every one of those terms is
# load-bearing.
#
# Both right-hand sides were formed as d = A x for a CHOSEN integer x (exact in
# f64, no rounding in the input), and the solutions were re-derived independently
# by exact-rational Gaussian elimination with partial pivoting (python3
# fractions.Fraction), NOT by running this solver.

# (a) 1-D Poisson, n = 5: sub = super = -1, diag = 2, x = (1,2,3,4,5),
# so d = (0,0,0,0,6). Four of the five right-hand sides are ZERO -- the answer
# is produced entirely by the elimination and the back-substitution sweep.
var _tds_n = 5;
var _tds_a = alloc(_tds_n * 8);
var _tds_b = alloc(_tds_n * 8);
var _tds_c = alloc(_tds_n * 8);
var _tds_d = alloc(_tds_n * 8);
var _tds_x = alloc(_tds_n * 8);
var _tds_i = 0;
var _tds_m1 = f64_neg(F64_ONE);
while (_tds_i < _tds_n) {
    store64(_tds_a + _tds_i * 8, _tds_m1);
    store64(_tds_b + _tds_i * 8, F64_TWO);
    store64(_tds_c + _tds_i * 8, _tds_m1);
    store64(_tds_d + _tds_i * 8, 0);
    _tds_i = _tds_i + 1;
}
store64(_tds_d + 4 * 8, f64_from(6));
var _rq92t, _rq92v = num_tridiag_solve(_tds_a, _tds_b, _tds_c, _tds_d, _tds_n, _tds_x);
assert_eq(is_ok(_rq92t), 1, "tridiag poisson: solve succeeds");
var _tds_bad = 0;
_tds_i = 0;
while (_tds_i < _tds_n) {
    var _tds_want = f64_from(_tds_i + 1);
    if (f64_lt(f64_abs(f64_sub(load64(_tds_x + _tds_i * 8), _tds_want)), TOL_1EM12) == 0) {
        _tds_bad = _tds_bad + 1;
    }
    _tds_i = _tds_i + 1;
}
assert_eq(_tds_bad, 0, "tridiag poisson n=5: x == (1,2,3,4,5) (Thomas sweep + back-substitution)");

# (b) ASYMMETRIC system, n = 4: sub = (1,2,3), diag = 9, super = (3,2,1),
# x = (1,2,3,4) -> d = (15,25,35,45). Diagonally dominant, so Thomas without
# pivoting is stable here. sub != super is the point: swapping the a and c
# arguments yields (1.4583, 1.875, 1.875, 4.7917) instead, which the symmetric
# Poisson system in (a) could never distinguish.
var _tda_n = 4;
var _tda_a = alloc(_tda_n * 8);
var _tda_b = alloc(_tda_n * 8);
var _tda_c = alloc(_tda_n * 8);
var _tda_d = alloc(_tda_n * 8);
var _tda_x = alloc(_tda_n * 8);
store64(_tda_a, F64_ONE); store64(_tda_a + 8, F64_TWO); store64(_tda_a + 16, f64_from(3));
store64(_tda_c, f64_from(3)); store64(_tda_c + 8, F64_TWO); store64(_tda_c + 16, F64_ONE);
var _tda_i = 0;
while (_tda_i < _tda_n) {
    store64(_tda_b + _tda_i * 8, f64_from(9));
    store64(_tda_d + _tda_i * 8, f64_from(15 + 10 * _tda_i));
    _tda_i = _tda_i + 1;
}
var _rq93t, _rq93v = num_tridiag_solve(_tda_a, _tda_b, _tda_c, _tda_d, _tda_n, _tda_x);
assert_eq(is_ok(_rq93t), 1, "tridiag asymmetric: solve succeeds");
var _tda_bad = 0;
_tda_i = 0;
while (_tda_i < _tda_n) {
    var _tda_want = f64_from(_tda_i + 1);
    if (f64_lt(f64_abs(f64_sub(load64(_tda_x + _tda_i * 8), _tda_want)), TOL_1EM12) == 0) {
        _tda_bad = _tda_bad + 1;
    }
    _tda_i = _tda_i + 1;
}
assert_eq(_tda_bad, 0, "tridiag asymmetric n=4: x == (1,2,3,4) (sub != super)");

# Residual check: A * x_computed must reproduce d. This is the invariant form of
# the same statement -- it holds for no wrong x, and it needs no reference at all.
var _tdr_max = 0;
_tda_i = 0;
while (_tda_i < _tda_n) {
    var _tdr_row = f64_mul(load64(_tda_b + _tda_i * 8), load64(_tda_x + _tda_i * 8));
    if (_tda_i > 0) {
        _tdr_row = f64_add(_tdr_row, f64_mul(load64(_tda_a + (_tda_i - 1) * 8),
            load64(_tda_x + (_tda_i - 1) * 8)));
    }
    if (_tda_i < _tda_n - 1) {
        _tdr_row = f64_add(_tdr_row, f64_mul(load64(_tda_c + _tda_i * 8),
            load64(_tda_x + (_tda_i + 1) * 8)));
    }
    var _tdr_r = f64_abs(f64_sub(_tdr_row, load64(_tda_d + _tda_i * 8)));
    if (f64_gt(_tdr_r, _tdr_max) == 1) { _tdr_max = _tdr_r; }
    _tda_i = _tda_i + 1;
}
assert_eq(f64_lt(_tdr_max, TOL_1EM12), 1, "tridiag asymmetric: residual |A x - d| < 1e-12");

test_group("symbolic_ext: integration, LaTeX, pattern matching");
# d/dx of the integral must recover the integrand (up to simplification):
# integral of x is x^2/2, whose derivative evaluated at x=3 is 3.
var se_x = expr_var(str_from("x"));
var se_int = sym_integrate(se_x, str_from("x"));
assert_neq(se_int, 0, "sym_integrate(x, x) returns an expression");
var se_d = expr_simplify(expr_diff(se_int, str_from("x")));
var se_binds = vec_new();
vec_push(se_binds, expr_bind(str_from("x"), f64_from(3)));
assert(f64_approx_eq(expr_eval(se_d, se_binds), f64_from(3), LOOSE_TOL_M),
  "d/dx(integral of x) evaluates to x at x=3");
# integral of a constant c is c*x -> at x=4 with c=5 gives 20
var se_ic = sym_integrate(expr_const(f64_from(5)), str_from("x"));
var se_b2 = vec_new();
vec_push(se_b2, expr_bind(str_from("x"), f64_from(4)));
assert(f64_approx_eq(expr_eval(se_ic, se_b2), f64_from(20), LOOSE_TOL_M),
  "integral of const 5 evaluates to 5x = 20 at x=4");
# LaTeX rendering. != 0 plus len > 0 passes for ANY non-empty output --
# including one that drops every \\left(...\\right) group. Pin the strings.
# Integral-valued constants render as bare integers (_latex_fmt_const), a
# convention already pinned by the carry test at the end of this file.
var se_tex = sym_to_latex(expr_add(se_x, expr_const(F64_ONE)));
assert_neq(se_tex, 0, "sym_to_latex returns a Str");
assert(str_len(se_tex) > 0, "sym_to_latex output is non-empty");
assert_eq(str_eq_cstr(se_tex, "x + 1"), 1, "latex: x + 1");
assert_eq(str_eq_cstr(sym_to_latex(expr_add(se_x, expr_neg(expr_const(F64_TWO)))), "x - 2"), 1,
  "latex: a + neg(b) folds to a - b");
assert_eq(str_eq_cstr(sym_to_latex(expr_mul(expr_const(F64_TWO), expr_const(f64_from(3)))),
    "2 \\cdot 3"), 1, "latex: number*number needs \\cdot");
assert_eq(str_eq_cstr(sym_to_latex(expr_mul(expr_const(F64_TWO),
        expr_add(se_x, expr_const(F64_ONE)))), "2 \\left(x + 1\\right)"), 1,
  "latex: juxtaposition + parenthesized sum");
assert_eq(str_eq_cstr(sym_to_latex(expr_pow(se_x, expr_const(f64_neg(F64_ONE)))),
    "\\frac{1}{x}"), 1, "latex: x^(-1) -> \\frac{1}{x}");
assert_eq(str_eq_cstr(sym_to_latex(expr_pow(se_x, expr_const(F64_HALF))), "\\sqrt{x}"), 1,
  "latex: x^(1/2) -> \\sqrt{x}");
assert_eq(str_eq_cstr(sym_to_latex(expr_const(f64_neg(F64_TWO))), "{-2}"), 1,
  "latex: bare negative constant is braced");
assert_eq(str_eq_cstr(sym_to_latex(expr_var(str_from("theta"))), "\\mathrm{theta}"), 1,
  "latex: multi-char identifier gets \\mathrm");
assert_eq(str_eq_cstr(sym_to_latex(expr_add(expr_mul(expr_const(f64_from(3)),
          expr_pow(se_x, expr_const(F64_TWO))), expr_neg(expr_sin(se_x)))),
    "3 x^{2} - \\sin\\left(x\\right)"), 1, "latex: 3x^2 - sin(x)");
# Every assertion above writes MUL and NEG only at the top level (paren 0), where
# neither the MUL arm's \left( \right) wrap nor the EXPR_NEG arm is reached; the four
# below reach both, and the 3.3.3 W5 block after them pins each operand position
# (paren 1) and a product's first factor (paren 2).
var se_y = expr_var(str_from("y"));
var se_z = expr_var(str_from("z"));
assert_eq(str_eq_cstr(sym_to_latex(expr_mul(se_x, expr_mul(se_y, se_z))),
    "x \\left(y z\\right)"), 1, "latex: a MUL operand of a MUL is parenthesized");
assert_eq(str_eq_cstr(sym_to_latex(expr_mul(expr_neg(se_x), se_y)), "-x y"), 1,
  "latex: the EXPR_NEG arm itself emits a minus");
assert_eq(str_eq_cstr(sym_to_latex(expr_mul(expr_neg(expr_add(se_x, se_y)), se_z)),
    "-\\left(x + y\\right) z"), 1, "latex: NEG of a sum keeps its parens");
assert_eq(str_eq_cstr(sym_to_latex(expr_add(se_x, expr_neg(expr_add(se_y, se_z)))),
    "x - \\left(y + z\\right)"), 1, "latex: a - (b + c), not the wrong a - b + c");

# === 3.3.4: sym_to_latex escapes a variable's name ===
test_group("3.3.4: sym_to_latex escapes a variable's name");
# Through 3.3.3 a name was written raw: "%" opened a TeX comment, "a{b" left a brace
# open, "$" ended the math, and "x_1" or "\alpha" came out as markup. Each of the ten
# is now escaped in the math-mode form (src/symbolic_ext.cyr, _latex_add_name); the
# 3.3.3 output is in each message, and every new output parses in KaTeX's strict mode
# and renders as its name.
# [measured: scratch probe of the 3.3.4 tree before/after, cycc 6.6.14, KaTeX 0.16.47, 2026-10-03]
assert_eq(str_eq_cstr(sym_to_latex(expr_var(str_from("%"))), "\\%"), 1, "3.3.4 latex: name % (3.3.3: %)");
assert_eq(str_eq_cstr(sym_to_latex(expr_var(str_from("a{b"))), "\\mathrm{a\\{b}"), 1,
  "3.3.4 latex: name a{b (3.3.3: \\mathrm{a{b})");
assert_eq(str_eq_cstr(sym_to_latex(expr_mul(se_x, expr_var(str_from("}")))), "x \\}"), 1,
  "3.3.4 latex: x * name } (3.3.3: x })");
assert_eq(str_eq_cstr(sym_to_latex(expr_add(expr_var(str_from("$")), se_y)), "\\$ + y"), 1,
  "3.3.4 latex: name $ + y (3.3.3: $ + y)");
assert_eq(str_eq_cstr(sym_to_latex(expr_mul(se_x, expr_var(str_from("&")))), "x \\&"), 1,
  "3.3.4 latex: x * name & (3.3.3: x &)");
assert_eq(str_eq_cstr(sym_to_latex(expr_var(str_from("#1"))), "\\mathrm{\\#1}"), 1,
  "3.3.4 latex: name #1 (3.3.3: \\mathrm{#1})");
assert_eq(str_eq_cstr(sym_to_latex(expr_var(str_from("x_1"))), "\\mathrm{x\\_1}"), 1,
  "3.3.4 latex: name x_1 (3.3.3: \\mathrm{x_1}, a subscript)");
assert_eq(str_eq_cstr(sym_to_latex(expr_pow(se_x, expr_var(str_from("a^b")))), "x^{\\mathrm{a\\hat{}b}}"), 1,
  "3.3.4 latex: x^(name a^b) (3.3.3: x^{\\mathrm{a^b}}, a superscript)");
assert_eq(str_eq_cstr(sym_to_latex(expr_sin(expr_var(str_from("~")))), "\\sin\\left(\\tilde{}\\right)"), 1,
  "3.3.4 latex: sin(name ~) (3.3.3: \\sin\\left(~\\right), a space)");
assert_eq(str_eq_cstr(sym_to_latex(expr_var(str_from("\\alpha"))), "\\mathrm{\\backslash{}alpha}"), 1,
  "3.3.4 latex: name \\alpha (3.3.3: \\mathrm{\\alpha}, an alpha)");
assert_eq(str_eq_cstr(sym_to_latex(expr_pow(expr_var(str_from("\\")), expr_const(F64_TWO))), "\\backslash{}^{2}"), 1,
  "3.3.4 latex: (name \\)^2 (3.3.3: \\^{2}, a text accent)");
# Unchanged: a name without the ten, punctuation that is not markup included.
assert_eq(str_eq_cstr(sym_to_latex(expr_mul(se_x, expr_var(str_from("a b-c.d'e(f)[g]|h@i")))),
    "x \\mathrm{a b-c.d'e(f)[g]|h@i}"), 1, "3.3.4 latex: x * name a b-c.d'e(f)[g]|h@i (unchanged)");

# === 3.3.3 W5: sym_to_latex wraps a leading minus in an operand ===
test_group("3.3.3 W5: sym_to_latex wraps a leading minus in an operand");
# Through 3.3.2 a minus at the front of an operand -- a constant whose text starts
# with '-', or an EXPR_NEG -- was written bare where _latex_write passes paren = 1, and
# the output read as another expression: x * -3 as "x -3" (x minus 3), (-2)^x as
# "-2^{x}" (minus 2^x). Each paren = 1 position is pinned here with both sources of the
# minus: a product's second factor, a power's base, a subtrahend, a negation's child.
# The 3.3.2 rendering is in each message.
# [measured: scratch probe against dist/hisab.cyr 3.3.2, cycc 6.6.12, 2026-10-01]
var w5_m3 = expr_const(f64_neg(f64_from(3)));
var w5_m2 = expr_const(f64_neg(F64_TWO));
assert_eq(str_eq_cstr(sym_to_latex(expr_mul(se_x, w5_m3)), "x \\left(-3\\right)"), 1,
  "W5 latex: x * -3, second factor (3.3.2: x -3)");
assert_eq(str_eq_cstr(sym_to_latex(expr_mul(expr_const(F64_TWO), w5_m3)), "2 \\cdot \\left(-3\\right)"), 1,
  "W5 latex: 2 * -3, second factor after \\cdot (3.3.2: 2 \\cdot -3)");
assert_eq(str_eq_cstr(sym_to_latex(expr_mul(se_x, expr_neg(se_y))), "x \\left(-y\\right)"), 1,
  "W5 latex: x * neg(y), second factor (3.3.2: x -y)");
assert_eq(str_eq_cstr(sym_to_latex(expr_pow(w5_m2, se_x)), "\\left(-2\\right)^{x}"), 1,
  "W5 latex: (-2)^x, base (3.3.2: -2^{x})");
assert_eq(str_eq_cstr(sym_to_latex(expr_pow(expr_neg(se_x), expr_const(F64_TWO))), "\\left(-x\\right)^{2}"), 1,
  "W5 latex: neg(x)^2, base (3.3.2: -x^{2})");
assert_eq(str_eq_cstr(sym_to_latex(expr_add(se_x, expr_neg(w5_m3))), "x - \\left(-3\\right)"), 1,
  "W5 latex: x + neg(-3), subtrahend (3.3.2: x - -3)");
assert_eq(str_eq_cstr(sym_to_latex(expr_add(se_x, expr_neg(expr_neg(se_y)))), "x - \\left(-y\\right)"), 1,
  "W5 latex: x + neg(neg(y)), subtrahend (3.3.2: x - -y)");
assert_eq(str_eq_cstr(sym_to_latex(expr_neg(w5_m3)), "-\\left(-3\\right)"), 1,
  "W5 latex: neg(-3), a negation's child (3.3.2: --3)");
assert_eq(str_eq_cstr(sym_to_latex(expr_neg(expr_neg(se_y))), "-\\left(-y\\right)"), 1,
  "W5 latex: neg(neg(y)), a negation's child (3.3.2: --y)");
# The test is on the constant's TEXT, as the paren = 0 braces are (3.3.3 G8, below):
# a non-integer, an infinity and a NaN with its sign bit are wrapped; -0, whose text is
# "0", is not.
assert_eq(str_eq_cstr(sym_to_latex(expr_mul(se_x, expr_const(0xBFE0000000000000))),
    "x \\left(-0.500000\\right)"), 1, "W5 latex: x * -0.5 (3.3.2: x -0.500000)");
assert_eq(str_eq_cstr(sym_to_latex(expr_pow(expr_const(0xFFF0000000000000), se_x)),
    "\\left(-inf\\right)^{x}"), 1, "W5 latex: (-inf)^x (3.3.2: -inf^{x})");
assert_eq(str_eq_cstr(sym_to_latex(expr_mul(se_x, expr_const(0xFFF8000000000000))),
    "x \\left(-nan\\right)"), 1, "W5 latex: x * -nan (3.3.2: x -nan)");
assert_eq(str_eq_cstr(sym_to_latex(expr_mul(se_x, expr_const(1 << 63))), "x \\cdot 0"), 1,
  "W5 latex: x * -0 renders x \\cdot 0, no wrap: the text has no minus (3.3.2: x 0; \\cdot, R4sym below)");
# A product's FIRST factor passes paren = 2: a sum or product there is still wrapped,
# and a leading minus stays bare, "-3 x", where it cannot be misread. Unchanged from
# 3.3.2 except where the minus sits deeper, in an operand of its own.
assert_eq(str_eq_cstr(sym_to_latex(expr_mul(w5_m3, se_x)), "-3 x"), 1,
  "W5 latex: -3 * x, first factor bare (unchanged)");
assert_eq(str_eq_cstr(sym_to_latex(expr_mul(w5_m2, expr_const(f64_from(3)))), "-2 \\cdot 3"), 1,
  "W5 latex: -2 * 3, first factor bare before \\cdot (unchanged)");
assert_eq(str_eq_cstr(sym_to_latex(expr_mul(expr_add(se_x, expr_const(F64_ONE)), se_y)),
    "\\left(x + 1\\right) y"), 1, "W5 latex: (x + 1) * y, a sum as first factor is still wrapped (unchanged)");
assert_eq(str_eq_cstr(sym_to_latex(expr_mul(expr_mul(se_x, se_y), se_z)), "\\left(x y\\right) z"), 1,
  "W5 latex: (x y) * z, a product as first factor is still wrapped (unchanged)");
assert_eq(str_eq_cstr(sym_to_latex(expr_mul(expr_neg(w5_m3), se_x)), "-\\left(-3\\right) x"), 1,
  "W5 latex: neg(-3) * x, first factor bare, its child wrapped (3.3.2: --3 x)");
# paren = 0 positions are untouched: a sum's terms, an exponent, a function argument.
assert_eq(str_eq_cstr(sym_to_latex(expr_add(se_x, w5_m3)), "x + {-3}"), 1,
  "W5 latex: x + -3 keeps its braces (unchanged)");
assert_eq(str_eq_cstr(sym_to_latex(expr_pow(se_x, w5_m3)), "x^{{-3}}"), 1, "W5 latex: x^(-3), exponent (unchanged)");
assert_eq(str_eq_cstr(sym_to_latex(expr_sin(w5_m3)), "\\sin\\left({-3}\\right)"), 1,
  "W5 latex: sin(-3), argument (unchanged)");
assert_eq(str_eq_cstr(sym_to_latex(expr_add(se_y, expr_mul(w5_m3, se_x))), "y + -3 x"), 1,
  "W5 latex: y + (-3 * x), the product's first factor after + (unchanged)");

# === 3.3.3 R4sym: sym_to_latex \cdot before a leading digit ===
test_group("3.3.3 R4sym: sym_to_latex \\cdot before a leading digit");
# TeX ignores spaces in math mode, so a space between two factors does not separate two
# numbers. Through 3.3.2 \cdot was written only when BOTH factors were constants, and a
# factor before one whose text starts with a digit fused with it: 2 * 2^x rendered
# "2 2^{x}", which typesets as 22^x. \cdot is now written whenever the second factor's
# text starts with a digit or a '.': a constant, a one-character variable, or a power
# written base^{exponent} over one. The 3.3.2 rendering is in each message.
# [measured: scratch probe against dist/hisab.cyr 3.3.2 and the 3.3.3 tree, cycc 6.6.12, 2026-10-01]
var r4s_two = expr_const(F64_TWO);
var r4s_half = expr_const(F64_HALF);
var r4s_2x = expr_pow(r4s_two, se_x);
assert_eq(str_eq_cstr(sym_to_latex(expr_mul(r4s_two, r4s_2x)), "2 \\cdot 2^{x}"), 1,
  "R4sym latex: 2 * 2^x (3.3.2: 2 2^{x}, typeset 22^x)");
assert_eq(str_eq_cstr(sym_to_latex(expr_mul(w5_m3, r4s_2x)), "-3 \\cdot 2^{x}"), 1,
  "R4sym latex: -3 * 2^x (3.3.2: -3 2^{x}, typeset -32^x)");
assert_eq(str_eq_cstr(sym_to_latex(expr_mul(r4s_half, r4s_2x)), "0.500000 \\cdot 2^{x}"), 1,
  "R4sym latex: 0.5 * 2^x (3.3.2: 0.500000 2^{x})");
assert_eq(str_eq_cstr(sym_to_latex(expr_mul(r4s_two, expr_pow(r4s_half, se_x))), "2 \\cdot 0.500000^{x}"), 1,
  "R4sym latex: 2 * 0.5^x (3.3.2: 2 0.500000^{x}, typeset 20.5^x)");
assert_eq(str_eq_cstr(sym_to_latex(expr_add(expr_mul(r4s_two, r4s_2x), expr_const(F64_ONE))),
    "2 \\cdot 2^{x} + 1"), 1, "R4sym latex: 2 * 2^x + 1, a product inside a sum (3.3.2: 2 2^{x} + 1)");
# The test is on the second factor's text, so the first factor does not matter, and
# both ends of the digit range are digits.
assert_eq(str_eq_cstr(sym_to_latex(expr_mul(se_x, r4s_two)), "x \\cdot 2"), 1,
  "R4sym latex: x * 2 (3.3.2: x 2)");
assert_eq(str_eq_cstr(sym_to_latex(expr_mul(se_x, expr_const(0))), "x \\cdot 0"), 1,
  "R4sym latex: x * 0, the digit 0 (3.3.2: x 0)");
assert_eq(str_eq_cstr(sym_to_latex(expr_mul(se_x, expr_const(f64_from(9)))), "x \\cdot 9"), 1,
  "R4sym latex: x * 9, the digit 9 (3.3.2: x 9)");
assert_eq(str_eq_cstr(sym_to_latex(expr_mul(se_x, r4s_2x)), "x \\cdot 2^{x}"), 1,
  "R4sym latex: x * 2^x, a power read through its base (3.3.2: x 2^{x})");
assert_eq(str_eq_cstr(sym_to_latex(expr_mul(r4s_2x, r4s_two)), "2^{x} \\cdot 2"), 1,
  "R4sym latex: 2^x * 2 (3.3.2: 2^{x} 2)");
# A one-character variable is written as its name, so a name that is a digit or a '.'
# is read the same way; the characters on either side of the digit range are not.
var r4s_v7 = expr_var(str_from("7"));
assert_eq(str_eq_cstr(sym_to_latex(expr_mul(r4s_two, r4s_v7)), "2 \\cdot 7"), 1,
  "R4sym latex: 2 * (variable 7) (3.3.2: 2 7, typeset 27)");
assert_eq(str_eq_cstr(sym_to_latex(expr_mul(se_x, expr_pow(r4s_v7, se_y))), "x \\cdot 7^{y}"), 1,
  "R4sym latex: x * (variable 7)^y (3.3.2: x 7^{y})");
assert_eq(str_eq_cstr(sym_to_latex(expr_mul(se_x, expr_var(str_from(".")))), "x \\cdot ."), 1,
  "R4sym latex: x * (variable .) (3.3.2: x .)");
assert_eq(str_eq_cstr(sym_to_latex(expr_mul(se_x, expr_var(str_from("7a")))), "x \\mathrm{7a}"), 1,
  "R4sym latex: x * (variable 7a), a longer name is written \\mathrm{...} (unchanged)");
assert_eq(str_eq_cstr(sym_to_latex(expr_mul(se_x, expr_var(str_from("/")))), "x /"), 1,
  "R4sym latex: x * (variable /), '/' sits just below '0' (unchanged)");
assert_eq(str_eq_cstr(sym_to_latex(expr_mul(se_x, expr_var(str_from(":")))), "x :"), 1,
  "R4sym latex: x * (variable :), ':' sits just above '9' (unchanged)");
# Unchanged: a second factor that starts with a letter, '\', or 'e'. A power written
# \sqrt{b} starts with '\' though its base is a number, and so does a power whose base
# is wrapped (R3c, above) or a negative constant wrapped in \left( (W5, above). A
# power written \frac{1}{b}, alone or as such a base, now gets \cdot too (R5sym, below).
assert_eq(str_eq_cstr(sym_to_latex(expr_mul(r4s_two, se_x)), "2 x"), 1, "R4sym latex: 2 * x (unchanged)");
assert_eq(str_eq_cstr(sym_to_latex(expr_mul(se_x, se_y)), "x y"), 1, "R4sym latex: x * y (unchanged)");
var r4s_3 = expr_const(f64_from(3));
var r4s_3inv = expr_pow(r4s_3, expr_const(f64_neg(F64_ONE)));
assert_eq(str_eq_cstr(sym_to_latex(expr_mul(r4s_two, r4s_3inv)), "2 \\cdot \\frac{1}{3}"), 1,
  "R4sym latex: 2 * 3^-1 (3.3.2: 2 \\frac{1}{3}, the mixed number 2 1/3; R5sym below)");
assert_eq(str_eq_cstr(sym_to_latex(expr_mul(r4s_two, expr_pow(r4s_3, r4s_half))), "2 \\sqrt{3}"), 1,
  "R4sym latex: 2 * 3^0.5 (unchanged)");
assert_eq(str_eq_cstr(sym_to_latex(expr_mul(r4s_two, expr_pow(r4s_3inv, se_x))), "2 \\cdot \\frac{1}{3}^{x}"), 1,
  "R4sym latex: 2 * (3^-1)^x, a \\frac base (3.3.2: 2 \\frac{1}{3}^{x}; R5sym below)");
assert_eq(str_eq_cstr(sym_to_latex(expr_mul(r4s_two, expr_pow(r4s_2x, se_y))), "2 \\left(2^{x}\\right)^{y}"), 1,
  "R4sym latex: 2 * (2^x)^y, a wrapped base (no \\cdot; 3.3.2: 2 2^{x}^{y}, R3c)");
assert_eq(str_eq_cstr(sym_to_latex(expr_mul(r4s_two, expr_pow(w5_m3, se_x))), "2 \\left(-3\\right)^{x}"), 1,
  "R4sym latex: 2 * (-3)^x, a wrapped negative base (no \\cdot; 3.3.2: 2 -3^{x}, W5)");
assert_eq(str_eq_cstr(sym_to_latex(expr_mul(r4s_two, expr_exp(se_x))), "2 e^{x}"), 1,
  "R4sym latex: 2 * e^x (unchanged)");
assert_eq(str_eq_cstr(sym_to_latex(expr_mul(r4s_two, expr_mul(r4s_two, se_x))), "2 \\left(2 x\\right)"), 1,
  "R4sym latex: 2 * (2 * x), a wrapped product (unchanged)");

# === 3.3.3 R5sym: sym_to_latex \cdot before \frac{1}{b} ===
test_group("3.3.3 R5sym: sym_to_latex \\cdot before \\frac{1}{b}");
# A number written before \frac with only a space between is LaTeX's mixed number:
# through 3.3.2 (and R4sym, above) 2 * 3^-1 rendered "2 \frac{1}{3}", which reads 2 1/3
# = 7/3, not 2/3. \frac{1}{b} now counts as a leading digit (its numerator is the
# numeral 1), so the product writes \cdot whatever the first factor and whatever b is,
# alone and as a power's base, which the POW arm does not wrap. The 3.3.2 rendering is
# in each message, and it is the pre-R5sym one too except where the message names R3c
# or W5.
# [measured: scratch probe against dist/hisab.cyr 3.3.2 and the 3.3.3 tree, cycc 6.6.12, 2026-10-01]
var r5s_m1 = expr_const(f64_neg(F64_ONE));
var r5s_2inv = expr_pow(r4s_two, r5s_m1);
var r5s_xinv = expr_pow(se_x, r5s_m1);
assert_eq(str_eq_cstr(sym_to_latex(expr_mul(w5_m3, r5s_2inv)), "-3 \\cdot \\frac{1}{2}"), 1,
  "R5sym latex: -3 * 2^-1 (3.3.2: -3 \\frac{1}{2}, read -3 1/2 = -3.5, value -1.5)");
assert_eq(str_eq_cstr(sym_to_latex(expr_mul(expr_neg(r4s_3), r5s_2inv)), "-3 \\cdot \\frac{1}{2}"), 1,
  "R5sym latex: neg(3) * 2^-1, a negation as first factor (3.3.2: -3 \\frac{1}{2})");
assert_eq(str_eq_cstr(sym_to_latex(expr_mul(r4s_v7, r4s_3inv)), "7 \\cdot \\frac{1}{3}"), 1,
  "R5sym latex: (variable 7) * 3^-1 (3.3.2: 7 \\frac{1}{3})");
assert_eq(str_eq_cstr(sym_to_latex(expr_add(expr_mul(r4s_two, r4s_3inv), expr_const(F64_ONE))),
    "2 \\cdot \\frac{1}{3} + 1"), 1, "R5sym latex: 2 * 3^-1 + 1, inside a sum (3.3.2: 2 \\frac{1}{3} + 1)");
assert_eq(str_eq_cstr(sym_to_latex(expr_mul(r4s_two, expr_mul(r4s_3, r5s_2inv))),
    "2 \\left(3 \\cdot \\frac{1}{2}\\right)"), 1,
  "R5sym latex: 2 * (3 * 2^-1), a wrapped product (3.3.2: 2 \\left(3 \\frac{1}{2}\\right))");
# The test is on the second factor alone, as R4sym's is: a letter or a fraction before
# it, and a denominator that is not a number, get \cdot too.
assert_eq(str_eq_cstr(sym_to_latex(expr_mul(se_x, r4s_3inv)), "x \\cdot \\frac{1}{3}"), 1,
  "R5sym latex: x * 3^-1 (3.3.2: x \\frac{1}{3})");
assert_eq(str_eq_cstr(sym_to_latex(expr_mul(r4s_two, r5s_xinv)), "2 \\cdot \\frac{1}{x}"), 1,
  "R5sym latex: 2 * x^-1 (3.3.2: 2 \\frac{1}{x})");
assert_eq(str_eq_cstr(sym_to_latex(expr_mul(r4s_two, expr_pow(r5s_xinv, se_y))), "2 \\cdot \\frac{1}{x}^{y}"), 1,
  "R5sym latex: 2 * (x^-1)^y, a \\frac base over a letter (3.3.2: 2 \\frac{1}{x}^{y})");
assert_eq(str_eq_cstr(sym_to_latex(expr_mul(r4s_3inv, r5s_2inv)), "\\frac{1}{3} \\cdot \\frac{1}{2}"), 1,
  "R5sym latex: 3^-1 * 2^-1 (3.3.2: \\frac{1}{3} \\frac{1}{2})");
# The fraction is the POW arm's own form test (_latex_pow_form, within 1e-15 of -1), on
# both sides of its edge, alone and as a base: -1 + 9 * 2^-53 is written \frac{1}{x},
# -1 + 10 * 2^-53 is x^{{-1.000000}}, which starts with a letter, and as a base is wrapped.
var r5s_in = expr_const(0xBFEFFFFFFFFFFFF7);
var r5s_out = expr_const(0xBFEFFFFFFFFFFFF6);
assert_eq(str_eq_cstr(sym_to_latex(expr_mul(r4s_two, expr_pow(se_x, r5s_in))), "2 \\cdot \\frac{1}{x}"), 1,
  "R5sym latex: 2 * x^(-1 + 9 * 2^-53), a \\frac on the edge (3.3.2: 2 \\frac{1}{x})");
assert_eq(str_eq_cstr(sym_to_latex(expr_mul(r4s_two, expr_pow(se_x, r5s_out))), "2 x^{{-1.000000}}"), 1,
  "R5sym latex: 2 * x^(-1 + 10 * 2^-53), past the edge (unchanged)");
assert_eq(str_eq_cstr(sym_to_latex(expr_mul(r4s_two, expr_pow(expr_pow(se_x, r5s_in), se_y))),
    "2 \\cdot \\frac{1}{x}^{y}"), 1, "R5sym latex: 2 * (x^(-1 + 9 * 2^-53))^y (3.3.2: 2 \\frac{1}{x}^{y})");
assert_eq(str_eq_cstr(sym_to_latex(expr_mul(r4s_two, expr_pow(expr_pow(se_x, r5s_out), se_y))),
    "2 \\left(x^{{-1.000000}}\\right)^{y}"), 1,
  "R5sym latex: 2 * (x^(-1 + 10 * 2^-53))^y (unchanged since R3c; 3.3.2: 2 x^{{-1.000000}}^{y})");
# Unchanged: \sqrt{b} alone (pinned above) and as a base, a negated fraction, which is
# wrapped, and a fraction as the FIRST factor.
assert_eq(str_eq_cstr(sym_to_latex(expr_mul(r4s_two, expr_pow(expr_pow(r4s_3, r4s_half), se_x))),
    "2 \\sqrt{3}^{x}"), 1, "R5sym latex: 2 * (3^0.5)^x, a \\sqrt base (unchanged)");
assert_eq(str_eq_cstr(sym_to_latex(expr_mul(r4s_two, expr_neg(r4s_3inv))), "2 \\left(-\\frac{1}{3}\\right)"), 1,
  "R5sym latex: 2 * neg(3^-1) (unchanged since W5; 3.3.2: 2 -\\frac{1}{3})");
assert_eq(str_eq_cstr(sym_to_latex(expr_mul(r4s_3inv, se_x)), "\\frac{1}{3} x"), 1,
  "R5sym latex: 3^-1 * x (unchanged)");

# === 3.3.3 R3c: sym_to_latex wraps a power's base that ends in a superscript ===
test_group("3.3.3 R3c: sym_to_latex wraps a power's base that ends in a superscript");
# Through 3.3.2 a power over a power, or over an exponential, put a second superscript
# on the first, which LaTeX rejects ("Double superscript"). A base written b^{e} or
# e^{a} is now wrapped in \left( \right), the way a sum is; one written \frac{1}{b} or
# \sqrt{b} ends in a brace and is not. The 3.3.2 rendering is in each message.
# [measured: scratch probe against dist/hisab.cyr 3.3.2, cycc 6.6.12, 2026-10-01]
var r3c_tx = expr_var(str_from("x"));
var r3c_ty = expr_var(str_from("y"));
var r3c_t2 = expr_const(F64_TWO);
var r3c_t3 = expr_const(f64_from(3));
var r3c_x2 = expr_pow(r3c_tx, r3c_t2);
assert_eq(str_eq_cstr(sym_to_latex(expr_pow(r3c_x2, r3c_t3)), "\\left(x^{2}\\right)^{3}"), 1,
  "R3c latex: (x^2)^3 (3.3.2: x^{2}^{3})");
assert_eq(str_eq_cstr(sym_to_latex(expr_pow(expr_exp(r3c_tx), r3c_t2)), "\\left(e^{x}\\right)^{2}"), 1,
  "R3c latex: exp(x)^2 (3.3.2: e^{x}^{2})");
# Nesting: each level is wrapped, and an exponent is not.
assert_eq(str_eq_cstr(sym_to_latex(expr_pow(expr_pow(r3c_x2, r3c_t3), r3c_t2)),
    "\\left(\\left(x^{2}\\right)^{3}\\right)^{2}"), 1, "R3c latex: ((x^2)^3)^2 (3.3.2: x^{2}^{3}^{2})");
assert_eq(str_eq_cstr(sym_to_latex(expr_pow(expr_pow(expr_exp(r3c_tx), r3c_t2), r3c_t3)),
    "\\left(\\left(e^{x}\\right)^{2}\\right)^{3}"), 1, "R3c latex: (exp(x)^2)^3 (3.3.2: e^{x}^{2}^{3})");
assert_eq(str_eq_cstr(sym_to_latex(expr_pow(expr_exp(r3c_x2), r3c_t3)), "\\left(e^{x^{2}}\\right)^{3}"), 1,
  "R3c latex: exp(x^2)^3 (3.3.2: e^{x^{2}}^{3})");
assert_eq(str_eq_cstr(sym_to_latex(expr_pow(expr_exp(expr_exp(r3c_tx)), r3c_t2)),
    "\\left(e^{e^{x}}\\right)^{2}"), 1, "R3c latex: exp(exp(x))^2 (3.3.2: e^{e^{x}}^{2})");
assert_eq(str_eq_cstr(sym_to_latex(expr_exp(expr_pow(r3c_x2, r3c_t3))), "e^{\\left(x^{2}\\right)^{3}}"), 1,
  "R3c latex: exp((x^2)^3), inside an exponent too (3.3.2: e^{x^{2}^{3}})");
assert_eq(str_eq_cstr(sym_to_latex(expr_pow(r3c_x2, r3c_x2)), "\\left(x^{2}\\right)^{x^{2}}"), 1,
  "R3c latex: (x^2)^(x^2), the exponent unwrapped (3.3.2: x^{2}^{x^{2}})");
assert_eq(str_eq_cstr(sym_to_latex(expr_mul(r3c_ty, expr_pow(r3c_x2, r3c_t3))), "y \\left(x^{2}\\right)^{3}"), 1,
  "R3c latex: y * (x^2)^3, as a product's factor (3.3.2: y x^{2}^{3})");
# The base test is the POW arm's own: within 1e-15 of -1 the base is \frac{1}{x}, not
# wrapped; one ulp-step further out it is x^{...}, wrapped. -1 + 9 * 2^-53 is 9.99e-16
# from -1, -1 + 10 * 2^-53 is 1.11e-15.
# [measured: scratch python3 decode of 0xBFEFFFFFFFFFFFF7 / ...F6 against 1e-15, 2026-10-01]
assert_eq(str_eq_cstr(sym_to_latex(expr_pow(expr_pow(r3c_tx, expr_const(0xBFEFFFFFFFFFFFF7)), r3c_t2)),
    "\\frac{1}{x}^{2}"), 1, "R3c latex: (x^(-1 + 9 * 2^-53))^2, a \\frac base (unchanged)");
assert_eq(str_eq_cstr(sym_to_latex(expr_pow(expr_pow(r3c_tx, expr_const(0xBFEFFFFFFFFFFFF6)), r3c_t2)),
    "\\left(x^{{-1.000000}}\\right)^{2}"), 1, "R3c latex: (x^(-1 + 10 * 2^-53))^2 (3.3.2: x^{{-1.000000}}^{2})");
# Unchanged: a base that ends in a brace or \right), and a power in an exponent.
assert_eq(str_eq_cstr(sym_to_latex(expr_pow(expr_pow(r3c_tx, expr_const(f64_neg(F64_ONE))), r3c_t2)),
    "\\frac{1}{x}^{2}"), 1, "R3c latex: (x^(-1))^2 (unchanged)");
assert_eq(str_eq_cstr(sym_to_latex(expr_pow(expr_pow(r3c_tx, expr_const(F64_HALF)), r3c_t2)),
    "\\sqrt{x}^{2}"), 1, "R3c latex: (x^(1/2))^2 (unchanged)");
assert_eq(str_eq_cstr(sym_to_latex(expr_pow(r3c_x2, expr_const(f64_neg(F64_ONE)))), "\\frac{1}{x^{2}}"), 1,
  "R3c latex: (x^2)^(-1) (unchanged)");
assert_eq(str_eq_cstr(sym_to_latex(expr_pow(expr_exp(r3c_tx), expr_const(F64_HALF))), "\\sqrt{e^{x}}"), 1,
  "R3c latex: exp(x)^(1/2) (unchanged)");
assert_eq(str_eq_cstr(sym_to_latex(expr_pow(expr_sin(r3c_tx), r3c_t2)), "\\sin\\left(x\\right)^{2}"), 1,
  "R3c latex: sin(x)^2 (unchanged)");
assert_eq(str_eq_cstr(sym_to_latex(expr_pow(expr_neg(r3c_x2), r3c_t3)), "\\left(-x^{2}\\right)^{3}"), 1,
  "R3c latex: neg(x^2)^3, wrapped once, by W5's minus rule (3.3.2: -x^{2}^{3})");
assert_eq(str_eq_cstr(sym_to_latex(expr_pow(r3c_tx, r3c_x2)), "x^{x^{2}}"), 1, "R3c latex: x^(x^2) (unchanged)");
assert_eq(str_eq_cstr(sym_to_latex(expr_exp(r3c_x2)), "e^{x^{2}}"), 1, "R3c latex: exp(x^2) (unchanged)");
# Pattern matching. sym_match takes a PATTERN (PAT_* tag space, built with
# pat_*), not an Expr — passing an Expr silently returns 0, which is why the
# first version of this test failed.
assert_eq(sym_match(pat_wildcard(str_from("a")), expr_const(F64_TWO)), 1,
  "sym_match: wildcard matches a constant");
assert_eq(sym_match(pat_wildcard(str_from("a")), expr_var(str_from("x"))), 1,
  "sym_match: wildcard matches a variable");
assert_eq(sym_match(pat_any_const(str_from("c")), expr_const(F64_TWO)), 1,
  "sym_match: any_const matches a constant");
assert_eq(sym_match(pat_any_const(str_from("c")), expr_var(str_from("x"))), 0,
  "sym_match: any_const does NOT match a variable");
# Structural: pattern a + b against x + 1
assert_eq(sym_match(pat_add(pat_wildcard(str_from("a")), pat_wildcard(str_from("b"))),
    expr_add(se_x, expr_const(F64_ONE))), 1,
  "sym_match: (a + b) matches (x + 1)");
assert_eq(sym_match(pat_mul(pat_wildcard(str_from("a")), pat_wildcard(str_from("b"))),
    expr_add(se_x, expr_const(F64_ONE))), 0,
  "sym_match: (a * b) does NOT match (x + 1)");
# Bindings are returned on a successful match
assert_neq(sym_match_bindings(pat_wildcard(str_from("a")), expr_const(F64_TWO)), 0,
  "sym_match_bindings returns bindings on match");

test_group("collision_core: hull pre-sort is a correct O(n log n) sort");

var hs_n = 2000;
var hs_pts = vec_new();
var hs_i = 0;
while (hs_i < hs_n) {
    vec_push(hs_pts, hvec2_new(f64_from((hs_i * 2654435761) % 10007),
        f64_from((hs_i * 40503) % 10009)));
    hs_i = hs_i + 1;
}
var hs_idx = vec_new();
hs_i = 0;
while (hs_i < hs_n) {
    vec_push(hs_idx, hs_i);
    hs_i = hs_i + 1;
}
_col_sort_indices_by_xy(hs_idx, hs_pts, hs_n);
# Zero inversions under the module's own order predicate.
var hs_inv = 0;
hs_i = 1;
while (hs_i < hs_n) {
    if (_col_xy_greater(hs_pts, vec_get(hs_idx, hs_i - 1), vec_get(hs_idx, hs_i)) == 1) {
        hs_inv = hs_inv + 1;
    }
    hs_i = hs_i + 1;
}
assert_eq(hs_inv, 0, "hull pre-sort: zero inversions over 2000 points");
# ...and a permutation: heapsort must not invent or drop elements.
var hs_seen = alloc(hs_n * 8);
hs_i = 0;
while (hs_i < hs_n) {
    store64(hs_seen + hs_i * 8, 0);
    hs_i = hs_i + 1;
}
hs_i = 0;
while (hs_i < hs_n) {
    var hv = vec_get(hs_idx, hs_i);
    store64(hs_seen + hv * 8, load64(hs_seen + hv * 8) + 1);
    hs_i = hs_i + 1;
}
var hs_bad = 0;
hs_i = 0;
while (hs_i < hs_n) {
    if (load64(hs_seen + hs_i * 8) != 1) { hs_bad = hs_bad + 1; }
    hs_i = hs_i + 1;
}
assert_eq(hs_bad, 0, "hull pre-sort: result is a permutation (multiset preserved)");
# The hull itself is unchanged by the rewrite (fingerprint pinned against the
# pre-2.6.15 insertion sort, which produced byte-identical output).
var hs_hull = convex_hull_2d(hs_pts, hs_n);
assert_eq(vec_len(hs_hull), 17, "convex_hull_2d(2000 scattered) has 17 vertices");

test_group("collision_mesh: half-edge twin pairing invariants");
# 33x33 grid -> 2048 triangles, 6144 half-edges, 4*(33-1) = 128 boundary edges.
var hm_w = 33;
var hm_tris = vec_new();
var hm_gy = 0;
while (hm_gy < hm_w - 1) {
    var hm_gx = 0;
    while (hm_gx < hm_w - 1) {
        var hm_v = hm_gy * hm_w + hm_gx;
        vec_push(hm_tris, hm_v);
        vec_push(hm_tris, hm_v + 1);
        vec_push(hm_tris, hm_v + hm_w + 1);
        vec_push(hm_tris, hm_v);
        vec_push(hm_tris, hm_v + hm_w + 1);
        vec_push(hm_tris, hm_v + hm_w);
        hm_gx = hm_gx + 1;
    }
    hm_gy = hm_gy + 1;
}
var hm_ntris = vec_len(hm_tris) / 3;
var hm_mesh = halfedge_from_triangles(hm_tris, hm_ntris, hm_w * hm_w);
assert_neq(hm_mesh, 0, "halfedge_from_triangles(2048 tris) returns a mesh");
var hm_hes = HalfEdgeMesh_half_edges(hm_mesh);
assert_eq(vec_len(hm_hes), hm_ntris * 3, "half-edge count == 3 * n_tris");
var hm_paired = 0;
var hm_boundary = 0;
var hm_bad = 0;
var hm_i = 0;
while (hm_i < vec_len(hm_hes)) {
    var hm_tw = HalfEdge_twin(vec_get(hm_hes, hm_i));
    if (hm_tw == HALFEDGE_NONE) {
        hm_boundary = hm_boundary + 1;
    } else {
        hm_paired = hm_paired + 1;
        if (hm_tw < 0 || hm_tw >= vec_len(hm_hes)) { hm_bad = hm_bad + 1; }
        else {
            if (HalfEdge_twin(vec_get(hm_hes, hm_tw)) != hm_i) { hm_bad = hm_bad + 1; }
        }
    }
    hm_i = hm_i + 1;
}
assert_eq(hm_bad, 0, "twin(twin(i)) == i for every paired half-edge");
assert_eq(hm_boundary, 4 * (hm_w - 1), "boundary half-edge count == 4*(W-1) = 128");
assert_eq(hm_paired + hm_boundary, vec_len(hm_hes), "every half-edge is paired or boundary");
assert_eq(hm_paired % 2, 0, "paired half-edges come in pairs");

test_group("calc_ext: B-spline / NURBS reject ill-formed degree");
# A degree-d B-spline needs at least d+1 control points. Only `n_pts != 0` and the
# knot-count relation were checked through 2.6.13, so degree >= n_pts fell through
# to de Boor with a NEGATIVE control-point index — an out-of-bounds read that
# dereferenced a wild pointer instead of returning the documented 0.
var ce_cps = alloc(3 * 24);
var ce_kn = alloc(7 * 8);
var ce_i = 0;
while (ce_i < 7) {
    store64(ce_kn + ce_i * 8, f64_from(ce_i));
    ce_i = ce_i + 1;
}
assert_eq(calc_bspline(3, ce_cps, 3, ce_kn, 7, f64_from(3)), 0,
  "calc_bspline: n_pts <= degree -> 0 (no wild deref)");
assert_eq(calc_nurbs(3, ce_cps, ce_cps, 3, ce_kn, 7, f64_from(3)), 0,
  "calc_nurbs: n_pts <= degree -> 0");
assert_eq(calc_bspline(0 - 1, ce_cps, 3, ce_kn, 3, F64_ONE), 0,
  "calc_bspline: negative degree -> 0");

# ------------------------------------------------------------------
test_group("calc_ext: calc_monotone_cubic is actually monotone (2.8.3)");
# The function had NO assertions of any kind before 2.8.3, and it was not
# monotone: Fritsch-Carlson has TWO parts and only the alpha^2 + beta^2 <= 9
# circle was implemented. The circle test squares its arguments, so it is blind
# to a tangent that points against its own secant — precisely what the averaged
# tangent does at a local extremum, where it inherits the sign of the larger
# neighbouring secant. Measured against exact-rational extrema of the Hermite
# cubic on 60,000 random data sets containing an extremum: 58.6% left their own
# [y_k, y_k+1] box, by up to 57.6.
#
# xs = 0,1,2,3   ys = 0,10,1,0 — one interior maximum. Secants +10, -9, -1;
# averaged tangent at x=1 is +0.5 while the secant of [1,2] is -9, giving
# alpha = -0.056 and alpha^2 + beta^2 = 0.31, comfortably inside the circle.
# The resulting cubic on [1,2] is 13.5t^3 - 23t^2 + 0.5t + 10, which climbs
# above the peak it is supposed to interpolate. With the sign condition the
# tangent is clamped to 0 and the cubic is 13t^3 - 22t^2 + 10, monotone.
var mc_x = _f64arr_alloc(4);
var mc_y = _f64arr_alloc(4);
_f64arr_set(mc_x, 0, 0);
_f64arr_set(mc_x, 1, F64_ONE);
_f64arr_set(mc_x, 2, F64_TWO);
_f64arr_set(mc_x, 3, f64_from(3));
_f64arr_set(mc_y, 0, 0);
_f64arr_set(mc_y, 1, f64_from(10));
_f64arr_set(mc_y, 2, F64_ONE);
_f64arr_set(mc_y, 3, 0);
assert_eq(f64_gt(calc_monotone_cubic(mc_x, mc_y, 4,
      f64_add(F64_ONE, f64_div(F64_ONE, f64_from(64)))), f64_from(10)), 0,
  "monotone_cubic: the sample just past the peak does not exceed the peak");
assert_eq(f64_gt(_mc_box_violation(mc_x, mc_y, 4, 256), TOL_1EM12), 0,
  "monotone_cubic: no interval leaves its own [y_k, y_k+1] box");
assert_eq(f64_gt(_mc_backstep(mc_x, mc_y, 4, 1, 256), TOL_1EM12), 0,
  "monotone_cubic: the descending interval never turns back upwards");

# The mirror case: a local MINIMUM must not undershoot the trough.
var mc_nx = _f64arr_alloc(4);
var mc_ny = _f64arr_alloc(4);
_f64arr_set(mc_nx, 0, 0);
_f64arr_set(mc_nx, 1, F64_ONE);
_f64arr_set(mc_nx, 2, F64_TWO);
_f64arr_set(mc_nx, 3, f64_from(3));
_f64arr_set(mc_ny, 0, f64_from(10));
_f64arr_set(mc_ny, 1, 0);
_f64arr_set(mc_ny, 2, f64_from(9));
_f64arr_set(mc_ny, 3, f64_from(10));
assert_eq(f64_gt(_mc_box_violation(mc_nx, mc_ny, 4, 256), TOL_1EM12), 0,
  "monotone_cubic: local minimum -- no undershoot below the trough");

# NO REGRESSION on strictly monotone data, which is the class the function was
# already right about: all secants share a sign there, so alpha and beta are
# positive and the sign condition is a no-op. Verified bit-identical tangents on
# 60,000 strictly monotone sets; these two values are the pre-2.8.3 output.
var mc_sx = _f64arr_alloc(4);
var mc_sy = _f64arr_alloc(4);
_f64arr_set(mc_sx, 0, 0);
_f64arr_set(mc_sx, 1, F64_ONE);
_f64arr_set(mc_sx, 2, f64_from(3));
_f64arr_set(mc_sx, 3, f64_from(6));
_f64arr_set(mc_sy, 0, 0);
_f64arr_set(mc_sy, 1, F64_ONE);
_f64arr_set(mc_sy, 2, f64_from(5));
_f64arr_set(mc_sy, 3, f64_from(6));
assert_eq(calc_monotone_cubic(mc_sx, mc_sy, 4, F64_HALF), 0x3FDC000000000000,
  "monotone_cubic: strictly monotone f(0.5) bit-identical to 2.8.2");
assert_eq(calc_monotone_cubic(mc_sx, mc_sy, 4, F64_TWO), 0x400913B322151FAB,
  "monotone_cubic: strictly monotone f(2.0) bit-identical to 2.8.2");
assert_eq(f64_gt(_mc_box_violation(mc_sx, mc_sy, 4, 256), TOL_1EM12), 0,
  "monotone_cubic: strictly monotone stays inside every box");
assert_eq(calc_monotone_cubic(mc_sx, mc_sy, 4, f64_from(7)), 0,
  "monotone_cubic: query past the last knot -> 0");
assert_eq(calc_monotone_cubic(mc_sx, mc_sy, 1, 0), 0,
  "monotone_cubic: n < 2 -> 0");

test_group("calc_ext / calc / noise_simplex: fBm normalisation is guarded");
# All four fBm entry points divided by an amplitude accumulator that is still
# exactly 0 when octaves <= 0, returning NaN from a function documenting a
# roughly [-1, 1] range — and NaN then propagated through every downstream sample.
var fb2 = fbm_2d(F64_ONE, F64_ONE, 0, F64_ONE, F64_ONE, F64_HALF);
assert_eq(f64_eq(fb2, fb2), 1, "fbm_2d(octaves=0) is not NaN");
assert_eq(fb2, f64_from(0), "fbm_2d(octaves=0) == 0");
var fb3 = fbm_3d(F64_ONE, F64_ONE, F64_ONE, 0, F64_ONE, F64_ONE, F64_HALF);
assert_eq(f64_eq(fb3, fb3), 1, "fbm_3d(octaves=0) is not NaN");
var sf2 = simplex_fbm_2d(F64_ONE, F64_ONE, 0, F64_ONE, F64_ONE, F64_HALF);
assert_eq(f64_eq(sf2, sf2), 1, "simplex_fbm_2d(octaves=0) is not NaN");
var sf3 = simplex_fbm_3d(F64_ONE, F64_ONE, F64_ONE, 0, F64_ONE, F64_ONE, F64_HALF);
assert_eq(f64_eq(sf3, sf3), 1, "simplex_fbm_3d(octaves=0) is not NaN");
# and a real call is still finite and in range
var fb_ok = fbm_2d(F64_ONE, F64_TWO, 4, F64_ONE, F64_ONE, F64_HALF);
assert_eq(f64_eq(fb_ok, fb_ok), 1, "fbm_2d(octaves=4) is finite");
assert_eq(f64_le(f64_abs(fb_ok), F64_TWO), 1, "fbm_2d(octaves=4) is in a sane range");

test_group("spatial: kdtree_build survives coincident points");
# _kd_partition splits on the axis VALUE midpoint. That separates properly
# whenever lo < hi, so it can only degenerate when every point shares the axis
# value — where the old "one item per side" clamp peeled ONE element per level,
# giving O(n) recursion depth. Measured on the pre-fix code: fine at 40k,
# **SIGSEGV at 60k**. 60000 is the proven threshold and costs ~24 ms.
var kd_n = 60000;
var kd_pts = alloc(kd_n * 8);
var kd_i = 0;
while (kd_i < kd_n) {
    store64(kd_pts + kd_i * 8, hvec3_new(F64_ONE, F64_TWO, f64_from(3)));
    kd_i = kd_i + 1;
}
assert_neq(kdtree_build(kd_pts, kd_n), 0,
  "kdtree_build(60000 coincident points) returns a tree (no stack overflow)");
# Pruning must still be correct once the positional fallback fires: build a tree
# that is half coincident, half spread, and demand an exact nearest-neighbour hit.
var kd_m = 4000;
var kd_p2 = alloc(kd_m * 8);
kd_i = 0;
while (kd_i < kd_m) {
    if (kd_i < kd_m / 2) { store64(kd_p2 + kd_i * 8, hvec3_new(0, 0, 0)); }
    else { store64(kd_p2 + kd_i * 8, hvec3_new(f64_from(kd_i), f64_from(kd_i), f64_from(kd_i))); }
    kd_i = kd_i + 1;
}
var kd_t2 = kdtree_build(kd_p2, kd_m);
assert_neq(kd_t2, 0, "kdtree_build(half-coincident) returns a tree");
var kd_tv = f64_from(kd_m - 1);
assert_eq(kdtree_nearest(kd_t2, kd_p2, hvec3_new(kd_tv, kd_tv, kd_tv)), kd_m - 1,
  "kdtree_nearest still finds the exact point (pruning correct)");

test_group("einsum: malformed notation must error, not mis-compute");
assert_eq(einsum(str_from("i9,jk->ik"), es_two, 2), 0, "einsum: digit in spec -> 0");
assert_eq(einsum(str_from("IJ,JK->IK"), es_two, 2), 0, "einsum: uppercase -> 0");
assert_eq(einsum(str_from("ijklm,jk->ik"), es_two, 2), 0, "einsum: rank > MAX_RANK -> 0");
assert_eq(einsum(str_from("ijk,jk->ik"), es_two, 2), 0, "einsum: rank != tensor rank -> 0");
assert_eq(einsum(str_from("ij,jk"), es_two, 2), 0, "einsum: missing -> separator -> 0");

# ================================================================
# 2.7.0-A -- the six 2026-08-03 findings that the 2.6.12-2.6.15 arc
# missed. Every assertion below FAILS against the pre-2.7.0 source.
# ================================================================

test_group("f64_fmod: truncated, not floored (sign of the DIVIDEND)");

# The whole point of the fix. floor() gives the sign of the divisor, trunc()
# gives the sign of the dividend, and only the latter is fmod.
assert_eq(f64_fmod(f64_neg(f64_from(7)), f64_from(3)), f64_neg(f64_from(1)),
  "fmod(-7, 3) = -1 (floor form gave +2)");
assert_eq(f64_fmod(f64_from(7), f64_neg(f64_from(3))), f64_from(1),
  "fmod(7, -3) = +1 (floor form gave -2)");
assert_eq(f64_fmod(f64_from(7), f64_from(3)), f64_from(1), "fmod(7, 3) = 1");
assert_eq(f64_fmod(f64_neg(f64_from(7)), f64_neg(f64_from(3))), f64_neg(f64_from(1)),
  "fmod(-7, -3) = -1");

# Non-integer quotient: -5.5 mod 2 is -1.5 truncated, +0.5 floored.
var fm_a = f64_neg(f64_div(f64_from(11), f64_from(2)));
var fm_r = f64_fmod(fm_a, f64_from(2));
assert_eq(fm_r, f64_neg(f64_div(f64_from(3), f64_from(2))), "fmod(-5.5, 2) = -1.5");

# Contract: y == 0 returns 0.
assert_eq(f64_fmod(f64_from(7), 0), 0, "fmod(x, 0) = 0");

# 3.3.4 -- EXACT, integer-only. Every expected value below is x86-64 glibc's `fmod`
# bit for bit, except y = ±0, the kept contract above.
# x - trunc(x/y)*y rounded x/y, lost the sign of a zero result and made NaN of an
# infinite divisor; the rows marked "trunc form" are the values it returned.
# [measured: glibc 2.44 fmod via python ctypes; the 3.3.3 body in a scratch harness, 2026-10-03]
assert_eq(f64_fmod(0x3FF0000000000000, 0x3FB999999999999A), 0x3FB9999999999996,
  "fmod(1, 0.1) is exact (the trunc form gave +0)");
assert_eq(f64_fmod(0xBFF0000000000000, 0x3FB999999999999A), 0xBFB9999999999996,
  "fmod(-1, 0.1) is exact, with x's sign (the trunc form gave +0)");
assert_eq(f64_fmod(0x4024000000000000, 0x3FD3333333333333), 0x3FB99999999999B4,
  "fmod(10, 0.3) is exact (the trunc form gave 0x3FB9999999999980)");
assert_eq(f64_fmod(0xC08F5A3D70A3D70A, 0x400921FB54442D18), 0xBFF1CA8545C5B230,
  "fmod(-1003.28, pi): full mantissas, 8 binades of exponent gap");
# A zero result carries x's sign: after loop steps, with none (|x| = |y|), and as x itself.
assert_eq(f64_fmod(0xC018000000000000, 0x4008000000000000), 0x8000000000000000,
  "fmod(-6, 3) = -0: an exact multiple keeps x's sign (the trunc form gave +0)");
assert_eq(f64_fmod(0xC008000000000000, 0xC008000000000000), 0x8000000000000000,
  "fmod(-3, -3) = -0: |x| = |y|, no binade of gap");
assert_eq(f64_fmod(0x8000000000000000, 0x4008000000000000), 0x8000000000000000,
  "fmod(-0, 3) = -0: |x| < |y| returns x itself");
assert_eq(f64_fmod(0x401E000000000000, 0x4014000000000000), 0x4004000000000000,
  "fmod(7.5, 5) = 2.5: a normal result with an even biased exponent, so the mantissa mask shows");
assert_eq(f64_fmod(0x3FD5555555555555, 0xC00921FB54442D18), 0x3FD5555555555555,
  "fmod(1/3, -pi) = 1/3: a finite |x| < |y| returns x itself");
assert_eq(f64_fmod(0x4018000000000000, 0xC008000000000000), 0,
  "fmod(6, -3) = +0: the sign is x's, never y's");
# An infinite divisor returns a finite x unchanged.
assert_eq(f64_fmod(0x4008000000000000, 0x7FF0000000000000), 0x4008000000000000,
  "fmod(3, +Inf) = 3 (the trunc form gave NaN)");
assert_eq(f64_fmod(0xFFEFFFFFFFFFFFFF, 0xFFF0000000000000), 0xFFEFFFFFFFFFFFFF,
  "fmod(-DBL_MAX, -Inf) = -DBL_MAX");
assert_eq(f64_fmod(0x8000000000000000, 0x7FF0000000000000), 0x8000000000000000,
  "fmod(-0, +Inf) = -0");
# An infinite dividend is invalid: the default NaN for any non-NaN y.
assert_eq(f64_fmod(0x7FF0000000000000, 0x4000000000000000), 0xFFF8000000000000,
  "fmod(+Inf, 2) = 0xFFF8000000000000, glibc's and the 3.3.3 body's NaN");
assert_eq(f64_fmod(0xFFF0000000000000, 0x7FF0000000000000), 0xFFF8000000000000,
  "fmod(-Inf, +Inf) = 0xFFF8000000000000");
# A NaN operand comes back quieted, sign and payload kept, x's ahead of y's.
assert_eq(f64_fmod(0x7FF0000000000001, 0x3FF0000000000000), 0x7FF8000000000001,
  "fmod(sNaN, 1) = x's NaN with the quiet bit set, payload kept");
assert_eq(f64_fmod(0x3FF0000000000000, 0xFFF0000000000123), 0xFFF8000000000123,
  "fmod(1, -sNaN) = y's NaN, quieted, sign and payload kept");
assert_eq(f64_fmod(0x7FF8000000000005, 0xFFF8000000000006), 0x7FF8000000000005,
  "fmod(NaN_a, NaN_b) = NaN_a: x's NaN wins");
assert_eq(f64_fmod(0x7FF0000000000000, 0x7FF4000000000007), 0x7FFC000000000007,
  "fmod(+Inf, sNaN) = y's NaN, not the invalid-operation NaN");
# The kept y = ±0 contract reaches every x, a NaN or an infinity included (C: NaN).
assert_eq(f64_fmod(0x7FF8000000000005, 0), 0, "fmod(NaN, +0) = +0, the kept contract");
assert_eq(f64_fmod(0xFFF0000000000000, 0x8000000000000000), 0,
  "fmod(-Inf, -0) = +0, the kept contract");
assert_eq(f64_fmod(0xC01C000000000000, 0x8000000000000000), 0,
  "fmod(-7, -0) = +0, the kept contract, as before 3.3.4");
# Subnormals: a remainder below DBL_MIN, a subnormal divisor, a subnormal dividend.
assert_eq(f64_fmod(0x003A6A3A6513270E, 0x001F2A7452E6B438), 0x000C298C9B987F90,
  "normal x and y, SUBNORMAL remainder");
assert_eq(f64_fmod(0x3FF3C0CA428C59FB, 0x000B7E151628AED3), 0x00038040A16E9F8D,
  "normal x, subnormal y: 1023 binades of gap");
assert_eq(f64_fmod(0x8018F5C28F5C28F7, 0x0000013579BDF135), 0x800000C841178DCE,
  "negative x in the lowest normal binade, deep subnormal y");
assert_eq(f64_fmod(0x8008F5C28F5C28F7, 0x0000013579BDF135), 0x8000007F6EDBC73A,
  "negative subnormal x, deeper subnormal y");
# The largest exponent gaps: DBL_MAX against subnormal divisors, up to the maximum, 2097
# binades (y = 2^-1074).
assert_eq(f64_fmod(0x7FEFFFFFFFFFFFFF, 0x0000000000000003), 0x0000000000000002,
  "fmod(DBL_MAX, 3 * 2^-1074) = 2 * 2^-1074 (the trunc form gave -Inf)");
assert_eq(f64_fmod(0xFFEFFFFFFFFFFFFF, 0x000FFFFFFFFFFFFF), 0x8000000000020000,
  "fmod(-DBL_MAX, the largest subnormal)");
assert_eq(f64_fmod(0x7FEC9F2C9CD04674, 0x8000000000000007), 0x0000000000000003,
  "fmod(a full-mantissa x near DBL_MAX, -7 * 2^-1074)");
assert_eq(f64_fmod(0xFFEFFFFFFFFFFFFF, 0x0000000000000001), 0x8000000000000000,
  "fmod(-DBL_MAX, 2^-1074) = -0: the largest gap there is, ending at the signed zero");

test_group("f64_copysign: the SIGN BIT of y, not an ordered comparison");

var cs_neg_zero = 0x8000_0000_0000_0000;

# -0.0 is EQUAL to +0.0, so the old `f64_lt(y, 0)` test could not see it.
assert_eq(f64_copysign(f64_from(3), cs_neg_zero), f64_neg(f64_from(3)),
  "copysign(3, -0.0) = -3 (ordered form gave +3)");
# ... and the old form could never PRODUCE -0.0 either.
assert_eq(f64_copysign(0, f64_neg(F64_ONE)), cs_neg_zero,
  "copysign(0, -1) = -0.0 (ordered form gave +0.0)");
assert_eq(f64_copysign(f64_from(3), f64_from(2)), f64_from(3), "copysign(3, 2) = 3");
assert_eq(f64_copysign(f64_neg(f64_from(5)), f64_from(2)), f64_from(5), "copysign(-5, 2) = 5");
assert_eq(f64_copysign(f64_neg(f64_from(5)), f64_neg(F64_ONE)), f64_neg(f64_from(5)),
  "copysign(-5, -1) = -5");
assert_eq(f64_copysign(f64_from(3), 0), f64_from(3), "copysign(3, +0.0) = +3");

test_group("geo_ray_capsule: ray parallel to the capsule axis");

# a == dot(d_perp, d_perp) is exactly 0 here, so disc is exactly +0.0 -- which
# is NOT < 0, so the pre-2.7.0 code took the quadratic branch and evaluated
# 0.5/0 = +Inf, returning NaN.
var rc_cap = geo_capsule_new(hvec3_zero(), hvec3_new(0, 0, f64_from(4)), F64_ONE);
var rc_par = geo_ray_new(hvec3_new(0, 0, f64_neg(f64_from(10))), hvec3_unit_z());
var rc_t = geo_ray_capsule(rc_par, rc_cap);
assert_eq(rc_t, f64_from(9), "parallel ray hits the start cap at t = 9");
# A NaN return would satisfy neither of these (both comparisons are unordered).
assert_eq(f64_gt(rc_t, 0), 1, "parallel-ray hit is a real ordered number (not NaN)");

# Parallel and 5 units off a radius-1 axis: a genuine miss, contract says 0.
var rc_miss = geo_ray_new(hvec3_new(f64_from(5), 0, f64_neg(f64_from(10))), hvec3_unit_z());
assert_eq(geo_ray_capsule(rc_miss, rc_cap), 0, "parallel ray outside the radius misses -> 0");

# Parallel, aimed the other way: the capsule is entirely behind the ray.
var rc_away = geo_ray_new(hvec3_new(0, 0, f64_neg(f64_from(10))),
  hvec3_new(0, 0, f64_neg(F64_ONE)));
assert_eq(geo_ray_capsule(rc_away, rc_cap), 0, "parallel ray pointing away misses -> 0");

test_group("lorentz_is_valid: tolerance relative to the matrix, not absolute");

# lorentz_boost_x takes RAPIDITY. cosh(10) is 11013, so the entries of
# Lambda^T eta Lambda are O(1.2e8) and one ulp there is 1.5e-8 -- ten thousand
# times the fixed 1e-12 the pre-2.7.0 code demanded. A perfectly valid boost
# was rejected.
assert_eq(lorentz_is_valid(lorentz_boost_x(f64_from(10))), 1, "boost rapidity 10 is valid");
assert_eq(lorentz_is_valid(lorentz_boost_y(f64_from(10))), 1, "boost_y rapidity 10 is valid");
assert_eq(lorentz_is_valid(lorentz_boost_z(f64_from(8))), 1, "boost_z rapidity 8 is valid");
assert_eq(lorentz_is_valid(lorentz_identity()), 1, "identity is valid");
assert_eq(lorentz_is_valid(lorentz_boost_x(F64_ONE)), 1, "boost rapidity 1 is valid");

# The relaxation must not make the predicate vacuous: a non-Lorentzian matrix
# is still rejected, because its defect is O(scale^2), not O(1e-12).
var lv_bad = m4_identity();
m4_set(lv_bad, 0, 0, f64_from(2));
assert_eq(lorentz_is_valid(lv_bad), 0, "diag(2,1,1,1) is NOT a Lorentz transform");
var lv_bad2 = lorentz_boost_x(f64_from(10));
m4_set(lv_bad2, 2, 2, f64_from(3));
assert_eq(lorentz_is_valid(lv_bad2), 0, "perturbed boost is still rejected");

test_group("cmat_exp: the scaling loop terminates on a non-finite norm");

# Halving never brings +Inf below 1, so the pre-2.7.0 loop spun forever. That
# this suite reaches the next line at all is the assertion.
var ce_inf = cmat_new(2, 2);
cmat_set(ce_inf, 0, 0, cx_real(F64_POS_INF));
cmat_set(ce_inf, 1, 1, cx_one());
assert_neq(cmat_exp(ce_inf), 0, "cmat_exp(+Inf entry) returns instead of hanging");

# And the ordinary path still works: exp(0) = I.
var ce_zero = cmat_new(2, 2);
var ce_i = cmat_exp(ce_zero);
assert_eq(HComplex_re(cmat_get(ce_i, 0, 0)), f64_from(1), "exp(0 matrix) diagonal = 1");
assert_eq(HComplex_re(cmat_get(ce_i, 0, 1)), f64_from(0), "exp(0 matrix) off-diagonal = 0");
assert_eq(HComplex_re(cmat_get(ce_i, 1, 1)), f64_from(1), "exp(0 matrix) diagonal = 1 (1,1)");

# ================================================================
# 2.7.0-B -- the three high findings from the 2026-08-04 re-audit.
# geo_advanced.cyr is the largest module (1,261 lines) and had ZERO
# coverage on GJK / EPA / BVH / TOI before this block.
# ================================================================

test_group("cmat_mul: conformability, not an out-of-bounds read");

# 2x3 times 2x2 is undefined. The inner loop ran k over cols(a) = 3 while b's
# buffer holds only rows(b)*cols(b) = 4 elements, so k = 2 read past it.
var cm_2x3 = cmat_new(2, 3);
var cm_2x2 = cmat_new(2, 2);
var cm_3x2 = cmat_new(3, 2);
assert_eq(cmat_mul(cm_2x3, cm_2x2), 0, "2x3 * 2x2 is non-conformable -> 0");
assert_neq(cmat_mul(cm_2x3, cm_3x2), 0, "2x3 * 3x2 IS conformable -> matrix");
assert_eq(cmat_rows(cmat_mul(cm_2x3, cm_3x2)), 2, "conformable product has 2 rows");
assert_eq(cmat_cols(cmat_mul(cm_2x3, cm_3x2)), 2, "conformable product has 2 cols");
assert_eq(cmat_mul(0, cm_2x2), 0, "cmat_mul(null, m) -> 0, not a null deref");
assert_eq(cmat_mul(cm_2x2, 0), 0, "cmat_mul(m, null) -> 0, not a null deref");

# The designed 0 must survive being fed onward instead of being dereferenced.
assert_eq(cmat_add(0, cm_2x2), 0, "cmat_add(null, m) -> 0");
assert_eq(cmat_sub(cm_2x2, 0), 0, "cmat_sub(m, null) -> 0");
assert_eq(cmat_add(cm_2x3, cm_2x2), 0, "cmat_add on mismatched shapes -> 0");
assert_eq(cmat_scale(0, cx_one()), 0, "cmat_scale(null) -> 0");
assert_eq(cmat_adjoint(0), 0, "cmat_adjoint(null) -> 0");
assert_eq(cmat_trace(0), 0, "cmat_trace(null) -> 0");
# cmat_commutator feeds cmat_mul's result straight into cmat_sub.
assert_eq(cmat_commutator(cm_2x3, cm_2x2), 0, "commutator of non-conformable -> 0");
assert_neq(cmat_commutator(cm_2x2, cm_2x2), 0, "commutator of conformable -> matrix");

test_group("bvh_build: coincident AABBs must not recurse O(n) deep");

# Every center is identical, so every center IS the split midpoint and
# `cv < mid_val` is false for all of them -- the partition never advances. The
# pre-2.7.0 clamp then forced a 1-vs-(n-1) split, giving recursion depth n and a
# quadratic build. These assertions cover the RESULT; the cost regression is
# guarded by the `bvh_degenerate_4k` benchmark (tests/hisab.bcyr; it never had a
# 20k form), since a cost is a timing fact, not something an assert_eq can state:
# 2.7.0 measured that row at 2.722 s before the repair and 15.5 ms after.
# [measured: CHANGELOG.md 2.7.0 section]
var bv_n = 20000;
var bv_arr = alloc(bv_n * 8);
var bv_pt = hvec3_new(F64_ONE, F64_ONE, F64_ONE);
var bv_box = geo_aabb_new(bv_pt, hvec3_new(F64_TWO, F64_TWO, F64_TWO));
var bv_i = 0;
while (bv_i < bv_n) {
    store64(bv_arr + bv_i * 8, bv_box);
    bv_i = bv_i + 1;
}
var bv_tree = bvh_build(bv_arr, bv_n);
assert_neq(bv_tree, 0, "bvh_build(20k coincident AABBs) returns a tree");

# Depth is not the only thing that has to survive: the tree must still answer.
var bv_hits = bvh_query_aabb(bv_tree, bv_box);
assert_eq(vec_len(bv_hits), bv_n, "every coincident box is still reported");
var bv_none = geo_aabb_new(hvec3_new(f64_from(100), f64_from(100), f64_from(100)),
  hvec3_new(f64_from(101), f64_from(101), f64_from(101)));
assert_eq(vec_len(bvh_query_aabb(bv_tree, bv_none)), 0, "disjoint query returns nothing");

# A well-separated set must keep working -- the median fallback only fires on the
# degenerate branch and must not disturb the normal partition.
var bv_m = 64;
var bv_sep = alloc(bv_m * 8);
var bv_j = 0;
while (bv_j < bv_m) {
    var bv_x = f64_from(bv_j * 10);
    store64(bv_sep + bv_j * 8,
      geo_aabb_new(hvec3_new(bv_x, 0, 0),
        hvec3_new(f64_add(bv_x, F64_ONE), F64_ONE, F64_ONE)));
    bv_j = bv_j + 1;
}
var bv_tree2 = bvh_build(bv_sep, bv_m);
assert_neq(bv_tree2, 0, "bvh_build(separated) returns a tree");
var bv_q = geo_aabb_new(hvec3_new(f64_from(30), 0, 0),
  hvec3_new(f64_from(31), F64_ONE, F64_ONE));
assert_eq(vec_len(bvh_query_aabb(bv_tree2, bv_q)), 1, "separated query finds exactly its box");

# === 3.3.3 R3a: bvh_build folds a NaN box into its node instead of past it ===
# ⛔ 3.3.3 — the node-bounds fold used stdlib f64_min/f64_max, `a < b ? a : b`, which
# drops a NaN accumulator at the next box. Three boxes with x-slabs [0, 1], [4, 5] and
# [8, 9] (y and z [0, 1]): a NaN middle box gave the root slab [8, 9], which excludes
# the finite first box, so a ray and a box that both meet it came back empty; a NaN
# first box gave [4, 9]; only a NaN last box reached the root. A NaN min.x alone in
# the middle box also gave [8, 9]. Every "3.3.2:" below is that bundle's answer.
# [measured: R3a probe on the 3.3.2 bundle, 2026-10-01; cycc 6.6.12]
# ⭐ A NaN anywhere in a range is NaN in that node's slab, on both sides, and both
# walkers descend through a NaN slab: every comparison against it is false.
# ⛔ 3.3.4 — through 3.3.3 the NaN box itself was then reported too, since the leaf
# test was the same NaN-true one. A leaf is now reported only when its own test says
# hit, and a NaN slab says neither (geo_aabb_aabb is NaN-false; _bvh_ray_hits_aabb
# answers 2), so a NaN box is never returned. Each "3.3.3:" below is that answer.
test_group("bvh_build: a NaN box makes its node's slab NaN (3.3.3)");
var _r3a_nan = 0x7FF8000000000000;
var _r3a_boxes = alloc(24);
# Box i spans x in [4i, 4i + 1]; box `nan_at` is NaN in x (both corners).
fn _r3a_bvh(nan_at) {
    for (var i = 0; i < 3; i = i + 1) {
        var x0 = f64_from(i * 4);
        var x1 = f64_add(x0, F64_ONE);
        if (i == nan_at) { x0 = _r3a_nan; x1 = _r3a_nan; }
        store64(_r3a_boxes + i * 8, geo_aabb_new(hvec3_new(x0, 0, 0), hvec3_new(x1, F64_ONE, F64_ONE)));
    }
    return bvh_build(_r3a_boxes, 3);
}
fn _r3a_lo(root) { return HVec3_x(GeoAabb_min(load64(root))); }
fn _r3a_hi(root) { return HVec3_x(GeoAabb_max(load64(root))); }
# The hit list as one integer: a leading 1, then the digit index + 1 for each hit in
# walk order, so [] is 1, [0] is 11 and [0, 1] is 112.
fn _r3a_code(hits) {
    var c = 1;
    for (var k = 0; k < vec_len(hits); k = k + 1) { c = c * 10 + vec_get(hits, k) + 1; }
    return c;
}
# A ray along +y through x = z = 0.5, and the box [0.25, 0.75]^3: both meet box 0 only.
var _r3a_ray = geo_ray_new(hvec3_new(F64_HALF, f64_from(0 - 5), F64_HALF), hvec3_unit_y());
var _r3a_qb = geo_aabb_new(hvec3_splat(0x3FD0000000000000), hvec3_splat(0x3FE8000000000000));

var _r3a_tree = _r3a_bvh(0 - 1);
assert_eq(_r3a_lo(_r3a_tree), 0, "bvh_build: all finite -> root x-slab starts at 0");
assert_eq(_r3a_hi(_r3a_tree), 0x4022000000000000, "bvh_build: ... and ends at 9");
assert_eq(_r3a_code(bvh_query_ray(_r3a_tree, _r3a_ray)), 11, "bvh_query_ray: ... finds box 0 alone");

_r3a_tree = _r3a_bvh(1);
assert_eq(_r3a_lo(_r3a_tree), _r3a_nan, "bvh_build: NaN middle box -> root min.x NaN (3.3.2: 8)");
assert_eq(_r3a_hi(_r3a_tree), _r3a_nan, "bvh_build: ... root max.x NaN (3.3.2: 9)");
assert_eq(_r3a_code(bvh_query_ray(_r3a_tree, _r3a_ray)), 11,
  "bvh_query_ray: ... finds box 0 and not the NaN box 1 (3.3.3: [0, 1]; 3.3.2: nothing)");
assert_eq(_r3a_code(bvh_query_aabb(_r3a_tree, _r3a_qb)), 11,
  "bvh_query_aabb: ... finds box 0 and not the NaN box 1 (3.3.3: [0, 1]; 3.3.2: nothing)");

_r3a_tree = _r3a_bvh(0);
assert_eq(_r3a_lo(_r3a_tree), _r3a_nan, "bvh_build: NaN first box -> root min.x NaN (3.3.2: 4)");
assert_eq(_r3a_hi(_r3a_tree), _r3a_nan, "bvh_build: ... root max.x NaN (3.3.2: 9)");
assert_eq(_r3a_code(bvh_query_ray(_r3a_tree, _r3a_ray)), 1,
  "bvh_query_ray: ... the NaN box 0 is not a hit (3.3.3: [0])");

_r3a_tree = _r3a_bvh(2);
assert_eq(_r3a_lo(_r3a_tree), _r3a_nan, "bvh_build: NaN last box -> root min.x NaN (as 3.3.2)");
assert_eq(_r3a_code(bvh_query_ray(_r3a_tree, _r3a_ray)), 11,
  "bvh_query_ray: ... finds box 0 and not the NaN box 2 (3.3.3: [0, 2])");

# A NaN on ONE side of a box's slab. With the other side finite, the ray walker
# clipped at it through 3.3.3, from the wrong end for a ray running backwards along
# that axis, so the node's slab is made NaN on both sides. Box 1 here is NaN in min.x
# only; the ray runs -x from x = 10 and meets box 0 at x in [0, 1]. (Since 3.3.4 the
# ray test skips a slab with a NaN crossing, so the -x ray would find box 0 without
# the both-sides step too; the bounds assertions are what pin that step now.)
store64(_r3a_boxes, geo_aabb_new(hvec3_zero(), hvec3_one()));
var _r3a_half = alloc(sizeof(GeoAabb));
GeoAabb_set_min(_r3a_half, hvec3_new(_r3a_nan, 0, 0));
GeoAabb_set_max(_r3a_half, hvec3_new(f64_from(5), F64_ONE, F64_ONE));
store64(_r3a_boxes + 8, _r3a_half);
store64(_r3a_boxes + 16, geo_aabb_new(hvec3_new(f64_from(8), 0, 0), hvec3_new(f64_from(9), F64_ONE, F64_ONE)));
_r3a_tree = bvh_build(_r3a_boxes, 3);
assert_eq(_r3a_lo(_r3a_tree), _r3a_nan, "bvh_build: NaN min.x in box 1 -> root min.x NaN (3.3.2: 8)");
assert_eq(_r3a_hi(_r3a_tree), _r3a_nan, "bvh_build: ... and root max.x NaN too (3.3.2: 9)");
var _r3a_back = geo_ray_new(hvec3_new(f64_from(10), F64_HALF, f64_from(0 - 5)),
  hvec3_new(f64_neg(F64_ONE), 0, 0x3FE199999999999A));
assert_eq(_r3a_code(bvh_query_ray(_r3a_tree, _r3a_back)), 11,
  "bvh_query_ray: ... a ray running -x finds box 0 (3.3.2: nothing)");

# Each fold line and each side of each both-sides step, separately: a one-sided NaN
# in every component, never in the last box (a NaN there survived stdlib's fold too).
# P: min.x of box 1, max.y of box 0, min.z of box 1. Q: max.x of box 0, min.y of box 1,
# max.z of box 0.
fn _r3a_onesided(lx, hy, lz, hx, ly, hz) {
    for (var i = 0; i < 3; i = i + 1) {
        var b = alloc(sizeof(GeoAabb));
        var x0 = f64_from(i * 4);
        GeoAabb_set_min(b, hvec3_new(x0, 0, 0));
        GeoAabb_set_max(b, hvec3_new(f64_add(x0, F64_ONE), F64_ONE, F64_ONE));
        store64(_r3a_boxes + i * 8, b);
    }
    var mn1 = GeoAabb_min(load64(_r3a_boxes + 8));
    var mx0 = GeoAabb_max(load64(_r3a_boxes));
    if (lx == 1) { HVec3_set_x(mn1, _r3a_nan); }
    if (hy == 1) { HVec3_set_y(mx0, _r3a_nan); }
    if (lz == 1) { HVec3_set_z(mn1, _r3a_nan); }
    if (hx == 1) { HVec3_set_x(mx0, _r3a_nan); }
    if (ly == 1) { HVec3_set_y(mn1, _r3a_nan); }
    if (hz == 1) { HVec3_set_z(mx0, _r3a_nan); }
    var bb = load64(bvh_build(_r3a_boxes, 3));
    var mn = GeoAabb_min(bb);
    var mx = GeoAabb_max(bb);
    return (HVec3_x(mn) == _r3a_nan) + (HVec3_y(mn) == _r3a_nan) + (HVec3_z(mn) == _r3a_nan)
    + (HVec3_x(mx) == _r3a_nan) + (HVec3_y(mx) == _r3a_nan) + (HVec3_z(mx) == _r3a_nan);
}
assert_eq(_r3a_onesided(1, 1, 1, 0, 0, 0), 6, "bvh_build: one-sided NaNs P -> all six root bounds NaN");
assert_eq(_r3a_onesided(0, 0, 0, 1, 1, 1), 6, "bvh_build: one-sided NaNs Q -> all six root bounds NaN");

# Signed zeros: the fold is IEEE minimum/maximum, so -0 is the minimum and +0 the
# maximum of a mixed pair in either box order (3.3.2: the second box's zero won).
fn _r3a_zeros(first_neg, use_max) {
    var z0 = 0;
    var z1 = 0x8000000000000000;
    if (first_neg == 1) { z0 = 0x8000000000000000; z1 = 0; }
    for (var i = 0; i < 2; i = i + 1) {
        var z = z0;
        if (i == 1) { z = z1; }
        var b = alloc(sizeof(GeoAabb));
        if (use_max == 1) {
            GeoAabb_set_min(b, hvec3_new(f64_neg(F64_ONE), 0, 0));
            GeoAabb_set_max(b, hvec3_new(z, F64_ONE, F64_ONE));
        } else {
            GeoAabb_set_min(b, hvec3_new(z, 0, 0));
            GeoAabb_set_max(b, hvec3_one());
        }
        store64(_r3a_boxes + i * 8, b);
    }
    var root = bvh_build(_r3a_boxes, 2);
    if (use_max == 1) { return _r3a_hi(root); }
    return _r3a_lo(root);
}
assert_eq(_r3a_zeros(0, 0), 0x8000000000000000, "bvh_build: min.x of +0 then -0 is -0");
assert_eq(_r3a_zeros(1, 0), 0x8000000000000000, "bvh_build: min.x of -0 then +0 is -0 (3.3.2: +0)");
assert_eq(_r3a_zeros(0, 1), 0, "bvh_build: max.x of +0 then -0 is +0 (3.3.2: -0)");
assert_eq(_r3a_zeros(1, 1), 0, "bvh_build: max.x of -0 then +0 is +0");

# === 3.3.4: the ray test's NaN slab, and inverted input boxes ===
test_group("bvh_query_ray: a NaN slab is no hit, whichever way the ray runs (3.3.4)");
# ⛔ 3.3.4 — _bvh_ray_hits_aabb never ordered a crossing pair with a NaN in it, so a
# box with min.x NaN and max.x = 1 was clipped at x = 1 as if that were its exit,
# whichever way the ray ran: hit by a +x ray from x = -5 and by a -x ray from x = 5,
# missed by a +x ray from x = 5. A slab that reads a NaN now neither includes nor
# excludes, and a leaf is reported only on a definite hit. Each site alone: [0,1]^3
# alone in its tree (the root is the leaf) with ONE bound NaN, `slot` as
# _sp4_aabb_slot; `par` 0 runs the ray along the NaN bound's axis, from -5 (`back`
# 0) or from +5 backwards (`back` 1), so the crossing pair reads it; `par` 1 runs it
# along the next axis through the box's middle, so the parallel test reads it.
# Returns 11 for [0] and 1 for [].
# [measured: spatial lane probe, 3.3.4-base bundle, not in-tree, 2026-10-03; cycc 6.6.14]
var _sp4_rbox = alloc(8);
fn _sp4_ray1(slot, par, back) {
    var mn = hvec3_zero();
    var mx = hvec3_one();
    if (slot == 0) { HVec3_set_x(mn, _sp4_anan); }
    if (slot == 1) { HVec3_set_y(mn, _sp4_anan); }
    if (slot == 2) { HVec3_set_z(mn, _sp4_anan); }
    if (slot == 3) { HVec3_set_x(mx, _sp4_anan); }
    if (slot == 4) { HVec3_set_y(mx, _sp4_anan); }
    if (slot == 5) { HVec3_set_z(mx, _sp4_anan); }
    var b = alloc(sizeof(GeoAabb));
    GeoAabb_set_min(b, mn);
    GeoAabb_set_max(b, mx);
    store64(_sp4_rbox, b);
    var axis = 0;
    if (slot >= 0) { axis = slot % 3; }
    if (par == 1) { axis = (axis + 1) % 3; }
    var o = hvec3_splat(F64_HALF);
    var d = hvec3_zero();
    var start = f64_from(0 - 5);
    var step = F64_ONE;
    if (back == 1) { start = f64_from(5); step = f64_neg(F64_ONE); }
    if (axis == 0) { HVec3_set_x(o, start); HVec3_set_x(d, step); }
    if (axis == 1) { HVec3_set_y(o, start); HVec3_set_y(d, step); }
    if (axis == 2) { HVec3_set_z(o, start); HVec3_set_z(d, step); }
    return _r3a_code(bvh_query_ray(bvh_build(_sp4_rbox, 1), geo_ray_new(o, d)));
}
assert_eq(_sp4_ray1(0 - 1, 0, 0), 11, "control: bvh_query_ray: [0,1]^3, a +x ray from x = -5 hits it");
assert_eq(_sp4_ray1(0 - 1, 0, 1), 11, "control: ... and a -x ray from x = 5");
assert_eq(_sp4_ray1(0 - 1, 1, 0), 11, "control: ... and a +y ray through x = 0.5");
assert_eq(_sp4_ray1(0, 0, 0), 1, "bvh_query_ray: min.x NaN, +x ray from -5 -> [] (3.3.3: [0])");
assert_eq(_sp4_ray1(0, 0, 1), 1, "bvh_query_ray: min.x NaN, -x ray from 5 -> [] (3.3.3: [0])");
assert_eq(_sp4_ray1(3, 0, 0), 1, "bvh_query_ray: max.x NaN, +x ray from -5 -> [] (3.3.3: [0])");
assert_eq(_sp4_ray1(3, 0, 1), 1, "bvh_query_ray: max.x NaN, -x ray from 5 -> [] (3.3.3: [0])");
assert_eq(_sp4_ray1(1, 0, 0), 1, "bvh_query_ray: min.y NaN, +y ray -> [] (3.3.3: [0])");
assert_eq(_sp4_ray1(4, 0, 0), 1, "bvh_query_ray: max.y NaN, +y ray -> [] (3.3.3: [0])");
assert_eq(_sp4_ray1(2, 0, 0), 1, "bvh_query_ray: min.z NaN, +z ray -> [] (3.3.3: [0])");
assert_eq(_sp4_ray1(5, 0, 0), 1, "bvh_query_ray: max.z NaN, +z ray -> [] (3.3.3: [0])");
assert_eq(_sp4_ray1(4, 0, 1), 1, "bvh_query_ray: max.y NaN, -y ray from 5 -> []");
assert_eq(_sp4_ray1(5, 0, 1), 1, "bvh_query_ray: max.z NaN, -z ray from 5 -> []");
assert_eq(_sp4_ray1(0, 1, 0), 1, "bvh_query_ray: min.x NaN, ray parallel to x -> [] (3.3.3: [0])");
assert_eq(_sp4_ray1(3, 1, 0), 1, "bvh_query_ray: max.x NaN, ray parallel to x -> [] (3.3.3: [0])");
assert_eq(_sp4_ray1(1, 1, 0), 1, "bvh_query_ray: min.y NaN, ray parallel to y -> [] (3.3.3: [0])");
assert_eq(_sp4_ray1(4, 1, 0), 1, "bvh_query_ray: max.y NaN, ray parallel to y -> [] (3.3.3: [0])");
assert_eq(_sp4_ray1(2, 1, 0), 1, "bvh_query_ray: min.z NaN, ray parallel to z -> [] (3.3.3: [0])");
assert_eq(_sp4_ray1(5, 1, 0), 1, "bvh_query_ray: max.z NaN, ray parallel to z -> [] (3.3.3: [0])");
# A NaN ray. geo_ray_new normalises the direction, so one NaN component makes all
# three NaN, and every slab reads it (3.3.3: every slab reset t_min and t_max to NaN
# and the box was hit). A NaN origin x on a +z ray reaches the x parallel test.
store64(_sp4_rbox, geo_aabb_new(hvec3_zero(), hvec3_one()));
var _sp4_rt1 = bvh_build(_sp4_rbox, 1);
var _sp4_nray = geo_ray_new(hvec3_splat(F64_HALF), hvec3_new(_sp4_anan, 0, F64_ONE));
assert_eq(_r3a_code(bvh_query_ray(_sp4_rt1, _sp4_nray)), 1, "bvh_query_ray: a NaN direction hits nothing (3.3.3: [0])");
_sp4_nray = geo_ray_new(hvec3_new(_sp4_anan, F64_HALF, f64_from(0 - 5)), hvec3_unit_z());
assert_eq(_r3a_code(bvh_query_ray(_sp4_rt1, _sp4_nray)), 1,
  "bvh_query_ray: a NaN origin x on a +z ray hits nothing (3.3.3: [0])");
# ⚠ An EQUAL crossing pair is ordered, not unknown: a box of zero width on `axis`
# ([1, 1]) is met at the one t where the ray crosses it. ON the boundary of the
# `x1 <= x2` test that tells an ordered pair from a NaN one.
fn _sp4_flat(axis) {
    var mn = hvec3_zero();
    var o = hvec3_splat(F64_HALF);
    var d = hvec3_zero();
    if (axis == 0) { HVec3_set_x(mn, F64_ONE); HVec3_set_x(o, f64_from(0 - 5)); HVec3_set_x(d, F64_ONE); }
    if (axis == 1) { HVec3_set_y(mn, F64_ONE); HVec3_set_y(o, f64_from(0 - 5)); HVec3_set_y(d, F64_ONE); }
    if (axis == 2) { HVec3_set_z(mn, F64_ONE); HVec3_set_z(o, f64_from(0 - 5)); HVec3_set_z(d, F64_ONE); }
    store64(_sp4_rbox, geo_aabb_new(mn, hvec3_one()));
    return _r3a_code(bvh_query_ray(bvh_build(_sp4_rbox, 1), geo_ray_new(o, d)));
}
assert_eq(_sp4_flat(0), 11, "bvh_query_ray: a box of zero width in x, crossed along +x, is hit");
assert_eq(_sp4_flat(1), 11, "bvh_query_ray: a box of zero width in y, crossed along +y, is hit");
assert_eq(_sp4_flat(2), 11, "bvh_query_ray: a box of zero width in z, crossed along +z, is hit");
# ⚠ An infinite origin coordinate ON a bound of the same infinity holds no NaN, but
# Inf - Inf makes that slab's crossing NaN. The origin stays on the bound for every
# finite t, so the slab holds the ray: [0,10]^3 with `axis` widened to [0, +Inf] (or
# [-Inf, 10], `neg` 1), the origin at that infinity, running (1, 1, 1) (3.3.3: [0]).
fn _sp4_infor(axis, neg) {
    var mn = hvec3_zero();
    var mx = hvec3_splat(f64_from(10));
    var o = hvec3_splat(F64_HALF);
    var inf = F64_POS_INF;
    if (neg == 1) { inf = f64_neg(F64_POS_INF); }
    if (axis == 0) { HVec3_set_x(o, inf); if (neg == 1) { HVec3_set_x(mn, inf); } else { HVec3_set_x(mx, inf); } }
    if (axis == 1) { HVec3_set_y(o, inf); if (neg == 1) { HVec3_set_y(mn, inf); } else { HVec3_set_y(mx, inf); } }
    if (axis == 2) { HVec3_set_z(o, inf); if (neg == 1) { HVec3_set_z(mn, inf); } else { HVec3_set_z(mx, inf); } }
    store64(_sp4_rbox, geo_aabb_new(mn, mx));
    return _r3a_code(bvh_query_ray(bvh_build(_sp4_rbox, 1), geo_ray_new(o, hvec3_one())));
}
assert_eq(_sp4_infor(0, 0), 11, "bvh_query_ray: origin x = +Inf on max.x = +Inf is held by the x slab");
assert_eq(_sp4_infor(1, 0), 11, "bvh_query_ray: origin y = +Inf on max.y = +Inf is held by the y slab");
assert_eq(_sp4_infor(2, 0), 11, "bvh_query_ray: origin z = +Inf on max.z = +Inf is held by the z slab");
assert_eq(_sp4_infor(0, 1), 11, "bvh_query_ray: origin x = -Inf on min.x = -Inf is held by the x slab");
# A NaN in ONE direction component (geo_ray_new would spread it to all three, so the
# setter), with the origin inside that slab: the slab cannot tell, and the box is no hit.
fn _sp4_rawnan(axis) {
    store64(_sp4_rbox, geo_aabb_new(hvec3_zero(), hvec3_one()));
    var o = hvec3_splat(F64_HALF);
    var d = hvec3_zero();
    var nx = (axis + 1) % 3;
    if (nx == 0) { HVec3_set_x(o, f64_from(0 - 5)); HVec3_set_x(d, F64_ONE); }
    if (nx == 1) { HVec3_set_y(o, f64_from(0 - 5)); HVec3_set_y(d, F64_ONE); }
    if (nx == 2) { HVec3_set_z(o, f64_from(0 - 5)); HVec3_set_z(d, F64_ONE); }
    if (axis == 0) { HVec3_set_x(d, _sp4_anan); }
    if (axis == 1) { HVec3_set_y(d, _sp4_anan); }
    if (axis == 2) { HVec3_set_z(d, _sp4_anan); }
    var r = geo_ray_new(o, hvec3_unit_z());
    GeoRay_set_direction(r, d);
    return _r3a_code(bvh_query_ray(bvh_build(_sp4_rbox, 1), r));
}
assert_eq(_sp4_rawnan(0), 1, "bvh_query_ray: direction x NaN alone -> []");
assert_eq(_sp4_rawnan(1), 1, "bvh_query_ray: direction y NaN alone -> []");
assert_eq(_sp4_rawnan(2), 1, "bvh_query_ray: direction z NaN alone -> []");
# The same NaN box beside a finite one, by bvh_query_aabb, far from both: [] (3.3.3: [1]).
var _sp4_two = alloc(16);
store64(_sp4_two, geo_aabb_new(hvec3_zero(), hvec3_one()));
store64(_sp4_two + 8, _sp4_anb);
assert_eq(_r3a_code(bvh_query_aabb(bvh_build(_sp4_two, 2), _sp4_afar)), 1,
  "bvh_query_aabb: [0,1]^3 and a NaN x-slab box vs [100,101] x [0,1]^2 -> [] (3.3.3: [1])");

test_group("bvh_build: inverted input boxes give a node that holds them (3.3.4)");
# ⛔ 3.3.4 — a box with min > max on an axis (made with the setters) gave an unsorted
# node: slabs [5, 1] and [6, 2] made the root [5, 2], which the ray test reads as
# [2, 5] while it reads the boxes alone as [1, 5] and [2, 6], so a +x ray from x = 5.5
# lost the second box and a -x ray from x = 1.5 the first, both hit when tested alone.
# The node is now the hull of every bound below it. Per axis and per side of the hull:
# boxes 0 and 1 inverted on `axis`, [0, 1] on the others, and a ray along `axis`
# through the middle of the others, +axis from 5.5 (`back` 0, box 1 alone) or -axis
# from 1.5 (`back` 1, box 0 alone).
# [measured: spatial lane probe, 3.3.4-base bundle, not in-tree, 2026-10-03; cycc 6.6.14]
fn _sp4_inv(axis, back) {
    for (var i = 0; i < 2; i = i + 1) {
        var mn = hvec3_zero();
        var mx = hvec3_one();
        var lo = f64_from(5 + i);
        var hi = f64_from(1 + i);
        if (axis == 0) { HVec3_set_x(mn, lo); HVec3_set_x(mx, hi); }
        if (axis == 1) { HVec3_set_y(mn, lo); HVec3_set_y(mx, hi); }
        if (axis == 2) { HVec3_set_z(mn, lo); HVec3_set_z(mx, hi); }
        var b = alloc(sizeof(GeoAabb));
        GeoAabb_set_min(b, mn);
        GeoAabb_set_max(b, mx);
        store64(_sp4_two + i * 8, b);
    }
    var o = hvec3_splat(F64_HALF);
    var d = hvec3_zero();
    var start = 0x4016000000000000;
    var step = F64_ONE;
    if (back == 1) { start = 0x3FF8000000000000; step = f64_neg(F64_ONE); }
    if (axis == 0) { HVec3_set_x(o, start); HVec3_set_x(d, step); }
    if (axis == 1) { HVec3_set_y(o, start); HVec3_set_y(d, step); }
    if (axis == 2) { HVec3_set_z(o, start); HVec3_set_z(d, step); }
    return _r3a_code(bvh_query_ray(bvh_build(_sp4_two, 2), geo_ray_new(o, d)));
}
assert_eq(_sp4_inv(0, 0), 12, "bvh_query_ray: x-inverted boxes, +x ray from 5.5 -> [1] (3.3.3: [])");
assert_eq(_sp4_inv(0, 1), 11, "bvh_query_ray: x-inverted boxes, -x ray from 1.5 -> [0] (3.3.3: [])");
assert_eq(_sp4_inv(1, 0), 12, "bvh_query_ray: y-inverted boxes, +y ray from 5.5 -> [1] (3.3.3: [])");
assert_eq(_sp4_inv(1, 1), 11, "bvh_query_ray: y-inverted boxes, -y ray from 1.5 -> [0] (3.3.3: [])");
assert_eq(_sp4_inv(2, 0), 12, "bvh_query_ray: z-inverted boxes, +z ray from 5.5 -> [1] (3.3.3: [])");
assert_eq(_sp4_inv(2, 1), 11, "bvh_query_ray: z-inverted boxes, -z ray from 1.5 -> [0] (3.3.3: [])");
var _sp4_invroot = load64(bvh_build(_sp4_two, 2));
assert_eq(HVec3_z(GeoAabb_min(_sp4_invroot)), F64_ONE,
  "bvh_build: z-inverted boxes -> root min.z 1, the hull (3.3.3: 5)");
assert_eq(HVec3_z(GeoAabb_max(_sp4_invroot)), f64_from(6), "bvh_build: ... root max.z 6 (3.3.3: 2)");
# ⛔ 3.3.4 — and an inverted box is read as its SORTED box throughout, as geo_ray_aabb
# and geo_aabb_aabb read it. (1) The leaf's parallel test read the slab [1, 0] as empty,
# so a ray parallel to it through its middle missed the box a crossing ray hits: [0,1]^3
# alone in its tree, `axis` stored [1, 0], the ray parallel to `axis` at `at` and
# running along the next axis from -5. (2) The hull ran after the split axis was
# chosen from the unsorted fold, so the tree differed from the sorted boxes' tree: box
# 0 stored x [10, 0] and box 1 = [2,3] x [0,5] x [0,1] split on y (x read 1 wide) where
# the sorted boxes split on x, and a +x ray met them in the other order. (3) The node
# test of bvh_query_aabb reads the query as stored, so an inverted query pruned the
# subtrees its sorted box meets: boxes along `axis` at [0,1], [2,3], [10,11], [12,13]
# and the query stored [12.5, 0.5] there met none of the four.
# [measured: probe of this tree, the 3.3.4 tree before it and the 3.3.4-base bundle, 2026-10-03; cycc 6.6.14]
fn _sp4_invpar(axis, at) {
    var mn = hvec3_zero();
    var mx = hvec3_one();
    var o = hvec3_splat(F64_HALF);
    var d = hvec3_zero();
    if (axis == 0) { HVec3_set_x(mn, F64_ONE); HVec3_set_x(mx, 0); HVec3_set_x(o, at); }
    if (axis == 1) { HVec3_set_y(mn, F64_ONE); HVec3_set_y(mx, 0); HVec3_set_y(o, at); }
    if (axis == 2) { HVec3_set_z(mn, F64_ONE); HVec3_set_z(mx, 0); HVec3_set_z(o, at); }
    var nx = (axis + 1) % 3;
    if (nx == 0) { HVec3_set_x(o, f64_from(0 - 5)); HVec3_set_x(d, F64_ONE); }
    if (nx == 1) { HVec3_set_y(o, f64_from(0 - 5)); HVec3_set_y(d, F64_ONE); }
    if (nx == 2) { HVec3_set_z(o, f64_from(0 - 5)); HVec3_set_z(d, F64_ONE); }
    var b = alloc(sizeof(GeoAabb));
    GeoAabb_set_min(b, mn);
    GeoAabb_set_max(b, mx);
    store64(_sp4_rbox, b);
    return _r3a_code(bvh_query_ray(bvh_build(_sp4_rbox, 1), geo_ray_new(o, d)));
}
assert_eq(_sp4_invpar(0, F64_HALF), 11,
  "bvh_query_ray: x stored [1, 0], ray parallel to x through it -> [0] (3.3.3: [])");
assert_eq(_sp4_invpar(1, F64_HALF), 11,
  "bvh_query_ray: y stored [1, 0], ray parallel to y through it -> [0] (3.3.3: [])");
assert_eq(_sp4_invpar(2, F64_HALF), 11,
  "bvh_query_ray: z stored [1, 0], ray parallel to z through it -> [0] (3.3.3: [])");
assert_eq(_sp4_invpar(0, f64_neg(F64_TWO)), 1, "bvh_query_ray: x stored [1, 0], the parallel ray at x = -2 -> []");
assert_eq(_sp4_invpar(1, f64_neg(F64_TWO)), 1, "bvh_query_ray: y stored [1, 0], the parallel ray at y = -2 -> []");
assert_eq(_sp4_invpar(2, f64_neg(F64_TWO)), 1, "bvh_query_ray: z stored [1, 0], the parallel ray at z = -2 -> []");
assert_eq(_sp4_invpar(0, f64_from(3)), 1, "bvh_query_ray: x stored [1, 0], the parallel ray at x = 3 -> []");
assert_eq(_sp4_invpar(1, f64_from(3)), 1, "bvh_query_ray: y stored [1, 0], the parallel ray at y = 3 -> []");
assert_eq(_sp4_invpar(2, f64_from(3)), 1, "bvh_query_ray: z stored [1, 0], the parallel ray at z = 3 -> []");
# ON the stored min, the sorted slab's top: the one origin the second (`elif`) arm can pass
assert_eq(_sp4_invpar(0, F64_ONE), 11, "bvh_query_ray: x stored [1, 0], the parallel ray at x = 1 -> [0] (3.3.3: [])");
assert_eq(_sp4_invpar(1, F64_ONE), 11, "bvh_query_ray: y stored [1, 0], the parallel ray at y = 1 -> [0] (3.3.3: [])");
assert_eq(_sp4_invpar(2, F64_ONE), 11, "bvh_query_ray: z stored [1, 0], the parallel ray at z = 1 -> [0] (3.3.3: [])");
var _sp4_ob0 = alloc(sizeof(GeoAabb));
GeoAabb_set_min(_sp4_ob0, hvec3_new(f64_from(10), 0, 0));
GeoAabb_set_max(_sp4_ob0, hvec3_new(0, F64_ONE, F64_ONE));
store64(_sp4_two, _sp4_ob0);
store64(_sp4_two + 8, geo_aabb_new(hvec3_new(F64_TWO, 0, 0), hvec3_new(f64_from(3), f64_from(5), F64_ONE)));
var _sp4_orx = geo_ray_new(hvec3_new(f64_from(0 - 5), F64_HALF, F64_HALF), hvec3_unit_x());
assert_eq(_r3a_code(bvh_query_ray(bvh_build(_sp4_two, 2), _sp4_orx)), 121,
  "bvh_build: x stored [10, 0] -> the sorted boxes' tree, a +x ray meets [1, 0] (3.3.3: [0, 1])");
var _sp4_four = alloc(32);
fn _sp4_invq(axis) {
    for (var i = 0; i < 4; i = i + 1) {
        var lo = f64_from(2 * i);
        if (i >= 2) { lo = f64_from(2 * i + 6); }
        var mn = hvec3_zero();
        var mx = hvec3_one();
        if (axis == 0) { HVec3_set_x(mn, lo); HVec3_set_x(mx, f64_add(lo, F64_ONE)); }
        if (axis == 1) { HVec3_set_y(mn, lo); HVec3_set_y(mx, f64_add(lo, F64_ONE)); }
        if (axis == 2) { HVec3_set_z(mn, lo); HVec3_set_z(mx, f64_add(lo, F64_ONE)); }
        store64(_sp4_four + i * 8, geo_aabb_new(mn, mx));
    }
    var qmn = hvec3_zero();
    var qmx = hvec3_one();
    if (axis == 0) { HVec3_set_x(qmn, 0x4029000000000000); HVec3_set_x(qmx, F64_HALF); }
    if (axis == 1) { HVec3_set_y(qmn, 0x4029000000000000); HVec3_set_y(qmx, F64_HALF); }
    if (axis == 2) { HVec3_set_z(qmn, 0x4029000000000000); HVec3_set_z(qmx, F64_HALF); }
    var q = alloc(sizeof(GeoAabb));
    GeoAabb_set_min(q, qmn);
    GeoAabb_set_max(q, qmx);
    return _r3a_code(bvh_query_aabb(bvh_build(_sp4_four, 4), q));
}
assert_eq(_sp4_invq(0), 11234, "bvh_query_aabb: query x stored [12.5, 0.5] -> all four, as [0.5, 12.5] (3.3.3: [])");
assert_eq(_sp4_invq(1), 11234, "bvh_query_aabb: query y stored [12.5, 0.5] -> all four (3.3.3: [])");
assert_eq(_sp4_invq(2), 11234, "bvh_query_aabb: query z stored [12.5, 0.5] -> all four (3.3.3: [])");

test_group("time_of_impact: the horizon is max_t, not 0.64 units");

# A needs B to travel 3 units before they touch (centres 5 apart, radii 1+1).
# The pre-2.7.0 loop advanced GJK_MAX_ITER * 0.01 = 0.64 units total and then
# returned 0 -- a false negative from a collision query, with max_t ignored.
var toi_a = hvec4_new(0, 0, 0, F64_ONE);
var toi_b = hvec4_new(f64_from(5), 0, 0, F64_ONE);
var toi_still = hvec3_zero();
var toi_left = hvec3_new(f64_neg(F64_ONE), 0, 0);
var toi_t = alloc(8);
var toi_n = alloc(8);

var toi_hit = time_of_impact(&_mpr_sup_sphere, toi_a, toi_still,
  &_mpr_sup_sphere, toi_b, toi_left, f64_from(10), toi_t, toi_n);
assert_eq(toi_hit, 1, "collision 3 units out IS found within max_t = 10");
assert_eq(f64_gt(load64(toi_t), F64_TWO), 1, "impact time is past t = 2");
assert_eq(f64_lt(load64(toi_t), f64_from(4)), 1, "impact time is before t = 4");

# max_t must still be honoured as a genuine bound in the other direction.
assert_eq(time_of_impact(&_mpr_sup_sphere, toi_a, toi_still,
    &_mpr_sup_sphere, toi_b, toi_left, F64_ONE, toi_t, toi_n), 0,
  "same approach with max_t = 1 is out of range -> 0");

# Receding: never collides no matter how long the horizon.
var toi_right = hvec3_new(F64_ONE, 0, 0);
assert_eq(time_of_impact(&_mpr_sup_sphere, toi_a, toi_still,
    &_mpr_sup_sphere, toi_b, toi_right, f64_from(100), toi_t, toi_n), 0,
  "receding spheres never collide");

# Zero relative velocity and already apart -> no collision.
assert_eq(time_of_impact(&_mpr_sup_sphere, toi_a, toi_still,
    &_mpr_sup_sphere, toi_b, toi_still, f64_from(10), toi_t, toi_n), 0,
  "stationary and disjoint -> 0");

# Already overlapping at t = 0 -> immediate hit.
var toi_over = hvec4_new(F64_ONE, 0, 0, F64_ONE);
assert_eq(time_of_impact(&_mpr_sup_sphere, toi_a, toi_still,
    &_mpr_sup_sphere, toi_over, toi_left, f64_from(10), toi_t, toi_n), 1,
  "already overlapping -> hit");
assert_eq(load64(toi_t), 0, "overlap at t = 0 reports t = 0");
assert_neq(load64(toi_n), 0, "overlap at t = 0 writes a non-null contact normal");

# === 3.3.3 W2: a NaN horizon is not an unbounded one ===
# ⛔ 3.3.3 — the horizon test read `f64_gt(t, max_t) == 1`, false for a NaN max_t, so
# the advance ran on to the impact: unit spheres with centres 9.5 apart, closing at
# speed 1, returned 1 with t = 7.5 for max_t = NaN, exactly what max_t = 10 returns.
# It now reads `f64_le(t, max_t) == 0`, the same test for every non-NaN pair, so a
# NaN horizon answers what a negative one does: the no-impact 0 with neither
# out-param written, as a NaN velocity already got. A contact at t = 0 is still
# reported, as under max_t = -Inf, because no horizon has ever gated one.
# [measured: W2 probe on the 3.3.2 bundle, 2026-10-01; cycc 6.6.12]
test_group("time_of_impact: a NaN horizon bounds like a negative one (3.3.3)");
var _w2_ta = hvec4_new(0, 0, 0, F64_ONE);
var _w2_tfar = hvec4_new(0x4023000000000000, 0, 0, F64_ONE);    # centre 9.5: gap 7.5
var _w2_tv = hvec3_new(f64_neg(F64_ONE), 0, 0);
var _w2_tt = alloc(8);
var _w2_tn = alloc(8);
var _w2_tsent = hvec3_new(F64_TWO, F64_TWO, F64_TWO);
# Both out-params start as sentinels, so a 0 return that wrote either one shows.
fn _w2_toi(b, max_t) {
    store64(_w2_tt, F64_TWO);
    store64(_w2_tn, _w2_tsent);
    return time_of_impact(&_mpr_sup_sphere, _w2_ta, hvec3_zero(),
      &_mpr_sup_sphere, b, _w2_tv, max_t, _w2_tt, _w2_tn);
}
assert_eq(_w2_toi(_w2_tfar, f64_from(10)), 1, "time_of_impact: gap 7.5 at speed 1, max_t = 10 -> hit");
assert_eq(load64(_w2_tt), 0x401E000000000000, "time_of_impact: ... at t = 7.5 exactly");
# ⭐ ON the boundary of the respelled test: t == max_t is inside the horizon.
assert_eq(_w2_toi(_w2_tfar, 0x401E000000000000), 1, "time_of_impact: max_t = 7.5 = the impact time -> hit");
assert_eq(load64(_w2_tt), 0x401E000000000000, "time_of_impact: ... at t = 7.5 exactly");
assert_eq(_w2_toi(_w2_tfar, 0x7FF0000000000000), 1, "time_of_impact: max_t = +Inf is unbounded -> hit");
assert_eq(load64(_w2_tt), 0x401E000000000000, "time_of_impact: ... at t = 7.5 exactly");
assert_eq(_w2_toi(_w2_tfar, 0xFFF0000000000000), 0, "time_of_impact: max_t = -Inf -> no impact");
assert_eq(_w2_toi(_w2_tfar, 0x7FF8000000000000), 0,
  "time_of_impact: max_t = NaN -> no impact (3.3.2: 1 at t = 7.5)");
assert_eq(load64(_w2_tt), F64_TWO, "time_of_impact: ... and out_t is not written");
assert_eq(load64(_w2_tn), _w2_tsent, "time_of_impact: ... and out_normal is not written");
assert_eq(_w2_toi(_w2_tfar, 0xFFF8000000000000), 0,
  "time_of_impact: max_t = -NaN -> no impact (3.3.2: 1 at t = 7.5)");
# The contact at t = 0 under a NaN horizon, on both paths that report one: an overlap
# returns before the advance loop, and a gap inside the contact tolerance (2^-40 here)
# from its first pass. Each answers exactly what max_t = -Inf answers.
var _w2_tover = hvec4_new(0x3FF8000000000000, 0, 0, F64_ONE);   # centre 1.5: overlap
var _w2_tnear = hvec4_new(f64_add(F64_TWO, 0x3D70000000000000), 0, 0, F64_ONE);
assert_eq(_w2_toi(_w2_tover, 0x7FF8000000000000), 1, "time_of_impact: overlap, max_t = NaN -> contact");
assert_eq(load64(_w2_tt), 0, "time_of_impact: ... at t = +0");
assert_eq(_w2_toi(_w2_tnear, 0xFFF0000000000000), 1, "time_of_impact: gap 2^-40, max_t = -Inf -> contact");
assert_eq(load64(_w2_tt), 0, "time_of_impact: ... at t = +0");
assert_eq(_w2_toi(_w2_tnear, 0x7FF8000000000000), 1, "time_of_impact: gap 2^-40, max_t = NaN -> contact");
assert_eq(load64(_w2_tt), 0, "time_of_impact: ... at t = +0");

# === 3.3.3 R4ga: a NaN shape under a finite horizon ===
# The NaN reaching the respelled horizon test need not be max_t's. A NaN or infinite
# centre or radius makes the first advance's t NaN, and with max_t = 10
# that t reaches the test: 3.3.2's `f64_gt(t, max_t) == 1` let it past and the loop
# ran out its 256-step budget, the new test leaves at once. The answer is the same
# no-impact 0 with neither out-param written, so the return alone cannot see the
# difference; the arena can. One call on a NaN-centred B took 43,592 bytes of arena
# here, and 239,456 with the 3.3.2 test put back (a probe on the 3.3.2 bundle: 233,264).
# [measured: R4ga runs of this block with the new and the old test; probe on the 3.3.2 bundle, 2026-10-01; cycc 6.6.12]
var _r4ga_tnan = hvec4_new(0x7FF8000000000000, 0, 0, F64_ONE);
var _r4ga_ta0 = alloc_used();
assert_eq(_w2_toi(_r4ga_tnan, f64_from(10)), 0, "time_of_impact: a NaN-centred B, max_t = 10 -> no impact");
var _r4ga_tar = alloc_used() - _r4ga_ta0;
assert_eq(load64(_w2_tt), F64_TWO, "time_of_impact: ... and out_t is not written");
assert_eq(load64(_w2_tn), _w2_tsent, "time_of_impact: ... and out_normal is not written");
assert_lt(_r4ga_tar, 131072,
  "time_of_impact: ... and it leaves on the first advance: under 128 KB of arena (43,592 B; to the budget: 239,456)");

# ------------------------------------------------------------------
# 2.8.3 — TOI vs the EXACT swept-sphere root, in the regimes a sampler
# cannot survive.
#
# Through 2.8.2 the loop walked t from 0 to max_t in _GA_TOI_MAX_STEPS equal
# steps and asked a BOOLEAN overlap test at each. A boolean says nothing about
# how far apart the shapes are, so the step could only come from the horizon,
# never from the geometry — and the overlap window in t is ~2R/|v_rel| wide.
# Small shapes, fast shapes or a long horizon all shrink the window below the
# step and the collision is tunnelled through in silence. Measured against the
# exact quadratic root, on the reverted source with the seeds below: 120/120
# missed in the tiny+fast regime, 40/40 at a 1e6-unit horizon, 37/40 on 1e-6
# geometry, 22/120 grazing — and in the uniform regime, where it does find the
# hit, 95/101 impact times were quantised LATE by up to a whole step.
#
# Conservative advancement measures the DISTANCE and steps by distance / closing
# speed, which provably cannot reach contact, so it never steps over the window.
# The references below are closed forms; none of them reads geo_advanced.cyr.
test_group("time_of_impact: exact swept-sphere root, four regimes");

var TOI_TOL6 = 0x3EB0C6F7A0B5ED8D;  # 1e-6
var TOI_TOL3 = 0x3F50624DD2F1A9FC;  # 1e-3

# (a) uniform — radii 0.2..2, |v| 0.5..4, horizon 10.
_DLR_STATE = 0x2026_0805_0000_0001;
var toiu = _toi_tally();
for (var tu = 0; tu < 101; tu = tu + 1) {
    var tu_cb = hvec3_new(_toi_frac(0 - 80, 80, 10), _toi_frac(0 - 80, 80, 10),
      _toi_frac(0 - 80, 80, 10));
    var tu_d = hvec3_length(tu_cb);
    var tu_v = hvec3_zero();
    if (f64_gt(tu_d, F64_ONE) == 1) {
        tu_v = hvec3_scale(tu_cb, f64_neg(f64_div(_toi_frac(5, 40, 10), tu_d)));
    }
    _toi_score(toiu, _toi_frac(2, 20, 10), tu_cb, _toi_frac(2, 20, 10), tu_v,
      f64_from(10), TOI_TOL6);
}
assert_eq(load64(toiu), 101, "toi/uniform: 101 pairs scored");
assert_gt(load64(toiu + 8), 40, "toi/uniform: a real share of them collide");
assert_eq(load64(toiu + 16), 0, "toi/uniform: zero false negatives");
assert_eq(load64(toiu + 24), 0, "toi/uniform: zero false positives");
assert_eq(load64(toiu + 32), 0, "toi/uniform: no impact time reported LATE (was 95/101)");
assert_eq(load64(toiu + 40), 0, "toi/uniform: none early, no null normal");

# (b) tiny + fast — radii 0.01..0.05, |v| 20..200, horizon 100. The overlap
# window is ~1e-3 in t; the old step was 100/256 = 0.39.
_DLR_STATE = 0x2026_0805_0000_0002;
var toif = _toi_tally();
for (var tf = 0; tf < 120; tf = tf + 1) {
    var tf_cb = hvec3_new(_toi_frac(0 - 500, 500, 10), _toi_frac(0 - 500, 500, 10),
      _toi_frac(0 - 500, 500, 10));
    var tf_d = hvec3_length(tf_cb);
    var tf_v = hvec3_zero();
    if (f64_gt(tf_d, F64_ONE) == 1) {
        tf_v = hvec3_scale(tf_cb, f64_neg(f64_div(_toi_frac(200, 2000, 10), tf_d)));
    }
    _toi_score(toif, _toi_frac(1, 5, 100), tf_cb, _toi_frac(1, 5, 100), tf_v,
      f64_from(100), TOI_TOL6);
}
assert_eq(load64(toif), 120, "toi/tiny+fast: 120 pairs scored");
assert_gt(load64(toif + 8), 60, "toi/tiny+fast: most of them collide");
assert_eq(load64(toif + 16), 0, "toi/tiny+fast: zero false negatives (was 120/120)");
assert_eq(load64(toif + 24), 0, "toi/tiny+fast: zero false positives");
assert_eq(load64(toif + 32), 0, "toi/tiny+fast: no impact time LATE");

# (c) grazing — impact parameter swept through ra + rb = 2, so half just touch
# and half just miss: the class a sampler is least likely to land inside.
_DLR_STATE = 0x2026_0805_0000_0003;
var toig = _toi_tally();
for (var tg = 0; tg < 120; tg = tg + 1) {
    _toi_score(toig, F64_ONE,
      hvec3_new(f64_from(0 - 20), _toi_frac(1900, 2100, 1000), 0), F64_ONE,
      hvec3_new(_toi_frac(10, 50, 10), 0, 0), f64_from(100), TOI_TOL3);
}
assert_eq(load64(toig), 120, "toi/grazing: 120 pairs scored");
assert_gt(load64(toig + 8), 30, "toi/grazing: some genuinely collide");
assert_eq(load64(toig + 16), 0, "toi/grazing: zero false negatives (was 22/120)");
assert_eq(load64(toig + 32), 0, "toi/grazing: no impact time LATE");

# (d) scale — 1e6 units away with a 1e7 horizon, and 1e-6 geometry. The old
# step was 1e7/256 = 39,000 world units in the first and 0.039 in the second;
# both are astronomically larger than the contact window.
_DLR_STATE = 0x2026_0805_0000_0004;
var toib = _toi_tally();
for (var tb = 0; tb < 40; tb = tb + 1) {
    _toi_score(toib, F64_ONE, hvec3_new(_toi_frac(10000, 1000000, 1), 0, 0), F64_ONE,
      hvec3_new(f64_neg(_toi_frac(10, 100, 10)), 0, 0), f64_from(10000000), TOI_TOL3);
}
var toim = _toi_tally();
var toi_mu = f64_div(F64_ONE, f64_from(1000000));
for (var tm = 0; tm < 40; tm = tm + 1) {
    var tm_cb = hvec3_new(f64_mul(_toi_frac(0 - 80, 80, 10), toi_mu),
      f64_mul(_toi_frac(0 - 80, 80, 10), toi_mu),
      f64_mul(_toi_frac(0 - 80, 80, 10), toi_mu));
    var tm_d = hvec3_length(tm_cb);
    var tm_v = hvec3_zero();
    if (f64_gt(tm_d, f64_mul(toi_mu, F64_HALF)) == 1) {
        tm_v = hvec3_scale(tm_cb,
          f64_neg(f64_div(f64_mul(_toi_frac(5, 40, 10), toi_mu), tm_d)));
    }
    _toi_score(toim, toi_mu, tm_cb, toi_mu, tm_v, f64_from(10), LOOSE_TOL_M);
}
assert_gt(load64(toib + 8), 30, "toi/1e6-horizon: the cases really collide");
assert_eq(load64(toib + 16), 0, "toi/1e6-horizon: zero false negatives (was 40/40)");
assert_eq(load64(toib + 24), 0, "toi/1e6-horizon: zero false positives");
assert_gt(load64(toim + 8), 30, "toi/1e-6-geometry: the cases really collide");
assert_eq(load64(toim + 16), 0, "toi/1e-6-geometry: zero false negatives (was 37/40)");
assert_eq(load64(toim + 24), 0, "toi/1e-6-geometry: zero false positives");

# (e) receding pairs must be CERTIFIED misses, not "no sample found one": the
# closing speed along the direction of closest approach is <= 0, which is a
# proof for all t, and the branch the old sampler had no way to express.
_DLR_STATE = 0x2026_0805_0000_0005;
var toir = _toi_tally();
for (var tr = 0; tr < 60; tr = tr + 1) {
    var tr_cb = hvec3_new(_toi_frac(0 - 80, 80, 10), _toi_frac(0 - 80, 80, 10),
      _toi_frac(0 - 80, 80, 10));
    var tr_d = hvec3_length(tr_cb);
    var tr_v = hvec3_zero();
    if (f64_gt(tr_d, F64_ONE) == 1) {
        tr_v = hvec3_scale(tr_cb, f64_div(_toi_frac(5, 40, 10), tr_d));
    }
    _toi_score(toir, F64_ONE, tr_cb, F64_ONE, tr_v, f64_from(1000), TOI_TOL6);
}
assert_eq(load64(toir + 24), 0, "toi/receding: zero false positives");
assert_eq(load64(toir + 16), 0, "toi/receding: zero false negatives");

# === 3.3.4 D045: the same motion at every scale ===
# ⛔ 3.3.4 — time_of_impact squared its lengths. Two unit spheres with centres 9.5 apart,
# closing at speed 1, meet at t = 7.5 exactly, and so does the same scene scaled by any
# power of two s (velocity too). On the 3.3.4 base it did so only for s in [2^-536,
# 2^509]. Below that the hit came back early at 2^-538 and 2^-537 (t = 7.4833), late at
# 2^-540 and 2^-539 (t = 8.0), and at t = 0 from 2^-541 down -- a contact at the start
# -- and the same spheres passing 3 apart came back as an impact from 2^-539 down; from
# 2^510 up the hit was a miss. Now t is 7.5 bit for bit from 2^-1022 to 2^1020 (9.5 s
# overflows above that) and the pass is a miss at every scale.
# [measured: D045 scale map, every power of two, 3.3.4 base and this tree, 2026-10-03; cycc 6.6.14]
test_group("time_of_impact: the same motion at every scale (3.3.4 D045)");
var _d045_t = alloc(8);
var _d045_n = alloc(8);
fn _d045_toi(e, cy) {
    var s = (1023 + e) << 52;
    store64(_d045_t, F64_TWO);
    return time_of_impact(&_mpr_sup_sphere, hvec4_new(0, 0, 0, s), hvec3_zero(), &_mpr_sup_sphere,
      hvec4_new(f64_mul(0x4023000000000000, s), f64_mul(cy, s), 0, s), hvec3_new(f64_neg(s), 0, 0),
      f64_from(10), _d045_t, _d045_n);
}
var _d045_runs = 0;
var _d045_hit_bad = 0;
var _d045_miss_bad = 0;
# Every 7th binade, plus the binades at the edges of the base's 7.5 band and of its
# false impacts (-539..-536, 509, 510) and the two ends.
for (var _d045_e = 0 - 1022; _d045_e <= 1020; _d045_e = _d045_e + 1) {
    var _d045_take = 0;
    if ((_d045_e + 1022) % 7 == 0) { _d045_take = 1; }
    if (_d045_e >= 0 - 539 && _d045_e <= 0 - 536) { _d045_take = 1; }
    if (_d045_e == 509 || _d045_e == 510 || _d045_e == 1020) { _d045_take = 1; }
    if (_d045_take == 1) {
        _d045_runs = _d045_runs + 1;
        if (_d045_toi(_d045_e, 0) != 1 || load64(_d045_t) != 0x401E000000000000) { _d045_hit_bad = _d045_hit_bad + 1; }
        if (_d045_toi(_d045_e, 0x4008000000000000) != 0) { _d045_miss_bad = _d045_miss_bad + 1; }
    }
}
assert_eq(_d045_runs, 298, "time_of_impact: 298 scales from 2^-1022 to 2^1020 were run");
assert_eq(_d045_hit_bad, 0, "time_of_impact: the hit is at t = 7.5 exactly at every scale (base: 2^-536..2^509 only)");
assert_eq(_d045_miss_bad, 0,
  "time_of_impact: the pass 3 apart is a miss at every scale (base: an impact below 2^-538)");
# Two boxes swept obliquely meet on a face of A (-) B, which the distance query reaches
# through its triangle and tetrahedron routines (products of up to six coordinates).
# The same t, bit for bit, from 2^-1000 to 2^1000; on the 3.3.4 base none of these
# nine scales gave the unit-scale t.
var _d045_bb = 0;
for (var _d045_j = 0; _d045_j < 9; _d045_j = _d045_j + 1) {
    var _d045_be = 0 - 1000;
    if (_d045_j == 1) { _d045_be = 0 - 700; }
    if (_d045_j == 2) { _d045_be = 0 - 600; }
    if (_d045_j == 3) { _d045_be = 0 - 540; }
    if (_d045_j == 4) { _d045_be = 0 - 300; }
    if (_d045_j == 5) { _d045_be = 300; }
    if (_d045_j == 6) { _d045_be = 510; }
    if (_d045_j == 7) { _d045_be = 600; }
    if (_d045_j == 8) { _d045_be = 1000; }
    var _d045_s = (1023 + _d045_be) << 52;
    store64(_d045_t, F64_TWO);
    var _d045_brc = time_of_impact(&_mpr_sup_box, _mpr_mkbox(0, 0, 0, f64_mul(0x3FF05E88B9F91908, _d045_s),
        f64_mul(0x3FD43A6FD732D9C3, _d045_s), f64_mul(0x3FDEE758D8954AB4, _d045_s)), hvec3_zero(),
      &_mpr_sup_box, _mpr_mkbox(f64_mul(0xC01E55D9F26F2B91, _d045_s), f64_mul(0xC0145FB52C1E3884, _d045_s),
        f64_mul(0xBFF965228901D3AD, _d045_s), f64_mul(0x3FD3D2E675D6504D, _d045_s),
        f64_mul(0x3FDADD8FD57FCC00, _d045_s), f64_mul(0x3FF46DB5E59D87C0, _d045_s)),
      hvec3_new(f64_mul(0x3FE71466474BB6DA, _d045_s), f64_mul(0x3FE080A8203BE6A3, _d045_s),
        f64_mul(0x3F987458B578219E, _d045_s)), f64_from(10), _d045_t, _d045_n);
    if (_d045_brc == 1 && load64(_d045_t) == 0x40215585531EB313) { _d045_bb = _d045_bb + 1; }
}
assert_eq(_d045_bb, 9, "time_of_impact: oblique boxes meet at the unit-scale t at all nine scales (3.3.4 base: 0)");

# ================================================================
# 2.7.0-C -- medium correctness & safety findings.
# Every fix below was independently verified AND adversarially
# challenged against the real source before it was applied.
# ================================================================

test_group("detect_islands: negative body indices must be rejected, not subscripted");

# Only the UPPER bound was checked through 2.6.15, so a negative index sailed
# through and _col_uf_find subscripted parent[] BEFORE the array.
var isl_a_c = contact_new(0 - 3, 1, hvec3_unit_y(), F64_HALF, F64_HALF, F64_HALF, F64_ONE, F64_ONE);
var isl_a_v = vec_new();
vec_push(isl_a_v, isl_a_c);
var isl_a = detect_islands(isl_a_v, 1, 4);
assert_eq(vec_len(isl_a), 4, "detect_islands: neg body_a is skipped -> 4 singletons");
# Pins the CORRUPTION, not just the count: pre-fix, island 0 was [0, 1] -- two
# unrelated bodies fused because the OOB read of parent[-3] returned root 0.
assert_eq(vec_len(vec_get(isl_a, 0)), 1, "detect_islands: neg body_a must not merge body 0");

# Second operand independently -- a fix guarding only `ba` would still fail this.
var isl_b_c = contact_new(1, 0 - 3, hvec3_unit_y(), F64_HALF, F64_HALF, F64_HALF, F64_ONE, F64_ONE);
var isl_b_v = vec_new();
vec_push(isl_b_v, isl_b_c);
assert_eq(vec_len(detect_islands(isl_b_v, 1, 4)), 4, "detect_islands: neg body_b is skipped -> 4 singletons");

# The memory-safety half. Pre-fix this SIGSEGVs (exit 139) and the suite prints
# nothing past the group header -- the count assertions above cannot reach it,
# because small-magnitude aliasing happens to stay inside the heap.
var isl_c_c = contact_new(0 - 1000000, 1, hvec3_unit_y(), F64_HALF, F64_HALF, F64_HALF, F64_ONE, F64_ONE);
var isl_c_v = vec_new();
vec_push(isl_c_v, isl_c_c);
assert_eq(vec_len(detect_islands(isl_c_v, 1, 4)), 4, "detect_islands: large neg index must not fault");

test_group("num_ifft: an error return must not leave the caller's buffer conjugated");

# n = 3 is not a power of 2. Through 2.6.15 the conjugate pass ran FIRST, so the
# rejection came back with every imaginary part already negated.
var ift_d = alloc(48);
store64(ift_d + 0,  f64_from(1));  store64(ift_d + 8,  f64_from(2));
store64(ift_d + 16, f64_from(3));  store64(ift_d + 24, f64_from(4));
store64(ift_d + 32, f64_from(5));  store64(ift_d + 40, f64_from(6));
var _rq94t, _rq94v = num_ifft(ift_d, 3);
assert_eq(is_err_result(_rq94t), 1, "n=3 rejected (rc is -10 either way)");
assert_eq(_rq94v, HSB_ERR_INVALID_INPUT, "n=3 rejected (rc is -10 either way)");
assert_eq(load64(ift_d + 8), f64_from(2), "ifft error leaves im[0] intact");
assert_eq(load64(ift_d + 24), f64_from(4), "ifft error leaves im[1] intact");
assert_eq(load64(ift_d + 40), f64_from(6), "ifft error leaves im[2] intact");
# Deliberate control: passes BOTH ways. It proves the corruption was confined to
# the imaginary lane -- i.e. silent, not obviously garbage.
assert_eq(load64(ift_d + 0), f64_from(1), "re[0] intact (control -- passes both ways)");
# One aggregate that flips sign: +12 correct, -12 corrupted.
var ift_s = f64_add(f64_add(load64(ift_d + 8), load64(ift_d + 24)), load64(ift_d + 40));
assert_eq(ift_s, f64_from(12), "sum(im) still +12 after a failed ifft");

# The success path must be untouched: n = 4 round-trips.
var ift_r = alloc(64);
store64(ift_r + 0,  f64_from(1));  store64(ift_r + 8,  0);
store64(ift_r + 16, f64_from(2));  store64(ift_r + 24, 0);
store64(ift_r + 32, f64_from(3));  store64(ift_r + 40, 0);
store64(ift_r + 48, f64_from(4));  store64(ift_r + 56, 0);
var _rq95t, _rq95v = num_fft(ift_r, 4);
assert_eq(is_ok(_rq95t), 1, "fft n=4 ok");
var _rq96t, _rq96v = num_ifft(ift_r, 4);
assert_eq(is_ok(_rq96t), 1, "ifft n=4 ok");
assert_eq(load64(ift_r + 0), f64_from(1), "round-trip re[0] = 1");
assert_eq(load64(ift_r + 48), f64_from(4), "round-trip re[3] = 4");

test_group("levi_civita: f64 bit patterns, not raw i64");

# Raw (0 - 1) is 0xFFFF_FFFF_FFFF_FFFF -- a NEGATIVE NaN. These four catch the
# ENCODING (pre-fix, f64_to of the raw 1 subnormal truncates to 0)...
assert_eq(levi_civita_3(0, 1, 2), f64_from(1), "eps 012 = +1.0 as f64");
assert_eq(levi_civita_4(0, 1, 2, 3), f64_from(1), "eps4 0123 = +1.0 as f64");
# ...and these two catch the SIGN. They are not redundant: a mutant with the
# correct f64 encoding but f64_neg dropped passes every encoding assertion above.
assert_eq(levi_civita_3(1, 0, 2), f64_neg(f64_from(1)), "eps 102 = -1.0 (pins the sign)");
assert_eq(levi_civita_4(1, 0, 2, 3), f64_neg(f64_from(1)), "eps4 1023 = -1.0 (pins the sign)");

# NaN is unordered, so it fails BOTH directions of an ordered comparison -- the
# cleanest statement that the odd branch is a real number at all.
assert_eq(f64_lt(levi_civita_3(1, 0, 2), 0), 1, "eps 102 is an ordered negative, not NaN");
assert_eq(f64_gt(levi_civita_3(0, 1, 2), 0), 1, "eps 012 is an ordered positive");

# The downstream consequence: NaN * 0.0 is NaN, so a raw -1 poisoned even the
# components a contraction should leave at exactly zero.
var lc_prod = f64_mul(levi_civita_3(1, 0, 2), 0);
assert_eq(f64_eq(lc_prod, 0), 1, "eps 102 * 0.0 == 0.0 (was NaN)");
assert_eq(levi_civita_3(0, 0, 1), f64_from(0), "eps repeated = 0.0");

test_group("diffgeo: geodesic_rk4 integrates, not only guards");

# Until 3.3.2 every geodesic_rk4 assertion was a guard: none read a value it
# integrated. Three closed forms pin it, all at t = steps * dt = 1.
#   Γ = 0: each stage sees u0, so x = x0 + u0 t, exact for dyadic inputs.
#   dim 2, only Γ^1_00 = 1: u0 stays 1 and u1' = -1, so x1 is quadratic in t and
#     RK4 is exact. A transposed index (Γ^0_10) reads a zero slot and moves both.
#   dim 1, Γ = 1: u' = -u², so from x0 = 0, u0 = 1, x = ln(1 + t) and u = 1/(1 + t).
#     RK4's error at dt = 1/64 is ~8.5e-10 in x and ~1.8e-10 in u; the bits are
#     pinned, and the 1e-8 band against ln 2 and 1/2 settles them independently.
var gr_dt8 = f64_div(F64_ONE, f64_from(8));
var gr_p = alloc(16);
var gr_v = alloc(16);
store64(gr_p, F64_ONE);
store64(gr_p + 8, F64_TWO);
store64(gr_v, F64_HALF);
store64(gr_v + 8, f64_neg(f64_div(F64_ONE, f64_from(4))));
var gr_flat = geodesic_rk4(geodesic_state_new(gr_p, gr_v, 2), alloc(64), 2, gr_dt8, 8);
assert_eq(load64(gr_flat), 0x3FF8000000000000, "geodesic_rk4 flat: x0 = 1 + 0.5 = 1.5 (bit-exact)");
assert_eq(load64(gr_flat + 8), 0x3FFC000000000000, "geodesic_rk4 flat: x1 = 2 - 0.25 = 1.75 (bit-exact)");
assert_eq(load64(gr_flat + 16), F64_HALF, "geodesic_rk4 flat: u0 unchanged");
assert_eq(load64(gr_flat + 24), 0xBFD0000000000000, "geodesic_rk4 flat: u1 unchanged");

store64(gr_p, 0);
store64(gr_p + 8, F64_ONE);
store64(gr_v, F64_ONE);
store64(gr_v + 8, F64_HALF);
var gr_g = alloc(64);
store64(gr_g + 32, F64_ONE);  # (alpha, mu, nu) = (1, 0, 0) -> (1*2 + 0)*2 + 0 = 4
var gr_ix = geodesic_rk4(geodesic_state_new(gr_p, gr_v, 2), gr_g, 2, gr_dt8, 8);
assert_eq(load64(gr_ix), F64_ONE, "geodesic_rk4 Γ^1_00: x0 = 0 + t = 1");
assert_eq(load64(gr_ix + 8), F64_ONE, "geodesic_rk4 Γ^1_00: x1 = 1 + 0.5 t - t²/2 = 1");
assert_eq(load64(gr_ix + 16), F64_ONE, "geodesic_rk4 Γ^1_00: u0 = 1, untouched");
assert_eq(load64(gr_ix + 24), 0xBFE0000000000000, "geodesic_rk4 Γ^1_00: u1 = 0.5 - t = -0.5");

var gr_p1 = alloc(8);
var gr_v1 = alloc(8);
store64(gr_p1, 0);
store64(gr_v1, F64_ONE);
var gr_g1 = alloc(8);
store64(gr_g1, F64_ONE);
var gr_c = geodesic_rk4(geodesic_state_new(gr_p1, gr_v1, 1), gr_g1, 1, f64_div(F64_ONE, f64_from(64)), 64);
assert_eq(load64(gr_c), 0x3FE62E42FE85D955, "geodesic_rk4 Γ = 1: x(1) bits pinned");
assert_eq(load64(gr_c + 8), 0x3FE000000018E0B1, "geodesic_rk4 Γ = 1: u(1) bits pinned");
assert_eq(f64_lt(f64_abs(f64_sub(load64(gr_c), 0x3FE62E42FEFA39EF)), 0x3E45798EE2308C3A), 1,
  "geodesic_rk4 Γ = 1: |x(1) - ln 2| < 1e-8");
assert_eq(f64_lt(f64_abs(f64_sub(load64(gr_c + 8), F64_HALF)), 0x3E45798EE2308C3A), 1,
  "geodesic_rk4 Γ = 1: |u(1) - 1/2| < 1e-8");

test_group("diffgeo: the documented 0 must not be dereferenced, and dims are capped");

# christoffel_symbols and riemann_tensor have capped at 16 and returned 0 since
# they were written. The downstream contractions did neither -- they dereferenced
# that 0 AND sized their own alloc from an unbounded dim (CWE-190 -> CWE-476).
var dg_ch_big = christoffel_symbols(0, 0, 100);
assert_eq(dg_ch_big, 0, "christoffel_symbols over the cap still returns 0");
assert_eq(ricci_tensor(dg_ch_big, 100), 0, "ricci_tensor(0, over-cap) -> 0, not a null store");
assert_eq(ricci_tensor(0, 4), 0, "ricci_tensor(null riemann) -> 0");
assert_eq(einstein_tensor(0, 0, 0, 4), 0, "einstein_tensor(null) -> 0");
assert_eq(weyl_tensor(0, 0, 0, 0, 4), 0, "weyl_tensor(null) -> 0");
assert_eq(geodesic_state_new(0, 0, 4), 0, "geodesic_state_new(null) -> 0");
assert_eq(geodesic_rk4(0, 0, 4, F64_HALF, 1), 0, "geodesic_rk4(null) -> 0");
assert_eq(parallel_transport(0, 0, 0, 4, F64_HALF, 1), 0, "parallel_transport(null) -> 0");
assert_eq(killing_residual(0, 0, 0, 4), 0, "killing_residual(null) -> 0");

# The dimension cap itself, on each entry point that previously had none.
assert_eq(ricci_tensor(0, 100000), 0, "ricci_tensor over the dim cap -> 0");
assert_eq(geodesic_state_new(0, 0, 100000), 0, "geodesic_state_new over the dim cap -> 0");

# wedge_1_1 was NOT in the original finding. dim = 100000 asks for 40 GB, so
# alloc returns 0 and the store wrote to address 0 -- measured exit 139.
var dg_a = alloc(32);
var dg_b = alloc(32);
assert_eq(wedge_1_1(dg_a, dg_b, 100000), 0, "wedge_1_1 over the dim cap -> 0, not a null store");
assert_eq(wedge_1_1(0, dg_b, 4), 0, "wedge_1_1(null alpha) -> 0");

# The valid path must be untouched: a real 2-sphere still contracts correctly.
assert_neq(wedge_1_1(dg_a, dg_b, 4), 0, "wedge_1_1 at dim 4 still returns a form");

test_group("symbolic render: the rounding carry must reach the integer part");

# stdlib fmt_float_buf zero-pads only when pad > 0. A fraction that rounds UP to
# exactly 10^decimals needs decimals+1 digits, so pad goes negative, the pad
# branch is skipped, and the overflowed digit lands AFTER the '.' with nothing
# carrying into the whole part.
var fc_a = f64_div(f64_from(9999999), f64_from(10000000));   # 0.9999999
var fc_sa = expr_to_str(expr_const(fc_a));
assert_eq(str_eq_cstr(fc_sa, "1.000000"), 1, "carry: 0.9999999 renders 1.000000, not 0.1000000");
assert_eq(str_len(fc_sa), 8, "carry: rounded-up render is 6 fraction digits, not 7");

var fc_b = f64_div(f64_from(29999999), f64_from(10000000));   # 2.9999999
assert_eq(str_eq_cstr(expr_to_str(expr_const(fc_b)), "3.000000"), 1,
  "carry: 2.9999999 renders 3.000000, not 2.1000000");

var fc_c = f64_neg(f64_div(f64_from(9999999), f64_from(10000000)));   # -0.9999999
assert_eq(str_eq_cstr(expr_to_str(expr_const(fc_c)), "-1.000000"), 1,
  "carry: negative values carry through the sign byte");

# The LaTeX path shares the helper -- this is the audit's exact value.
var fc_d = f64_div(f64_from(999999995), f64_from(1000000000));   # 0.999999995
# ================================================================
# 2.20.0 -- EXACT INTEGER RENDERING ABOVE 2^63
# ================================================================
# ⛔ WRITTEN BECAUSE BOTH PUBLIC RENDERERS RETURNED ONE WRONG CONSTANT FOR EVERY
# INPUT ABOVE 2^63, AND ALL 3955 ASSERTIONS PASSED. No i64 holds those values, and on
# the toolchain of the day (x86, below cyrius 6.6.8) `f64_to(f64_floor(mag))` returned
# i64::MIN for any |val| >= 2^63 (6.6.8+ saturates by sign instead): `expr_to_str` and
# `sym_to_latex` both answered **-9223372036854775808** for 1e19, 1e20 and 2^100
# alike -- a NEGATIVE number for a POSITIVE input -- and because the LaTeX path
# writes the sign separately, `sym_to_latex(-1e19)` came out as the malformed
# `{--9223372036854775808.000000}`, a double minus.
# ⚠ The suite could not see it because nothing asserted ANY value above 1e15.
# ⭐ The second half of the repair is a CONTRACT one: `_latex_fmt_const` documents
# "Integer values render without decimals" and capped that at 1e15, so every
# integral value from 1e15 up rendered `1000000000000000.000000` while
# `expr_to_str` rendered `1000000000000000`. The cap was a guard against `f64_to`
# saturating, set ~3 binades below where saturation starts, so it matched neither
# the contract nor the hazard. The two renderers now agree at every magnitude.
# [measured: 10961 renderings vs an exact oracle, 0 mismatches, 2026-09-10]

# 2^63 itself -- the first magnitude f64_to cannot represent.
assert_eq(str_eq_cstr(expr_to_str(expr_const(0x43E0_0000_0000_0000)),
    "9223372036854775808"), 1, "expr_to_str: 2^63 exact (was i64::MIN)");
assert_eq(str_eq_cstr(sym_to_latex(expr_const(0x43E0_0000_0000_0000)),
    "9223372036854775808"), 1, "sym_to_latex: 2^63 exact");

# 1e19 -- the value the original filing named.
assert_eq(str_eq_cstr(expr_to_str(expr_const(0x43E158E460913D00)),
    "10000000000000000000"), 1, "expr_to_str: 1e19 exact");
assert_eq(str_eq_cstr(sym_to_latex(expr_const(0x43E158E460913D00)),
    "10000000000000000000"), 1, "sym_to_latex: 1e19 exact");

# ⚠ THE NEGATIVE CASE IS THE ONE THAT WAS MALFORMED, not merely wrong: the sign
# was written twice. Asserting the magnitude alone would not have caught it.
assert_eq(str_eq_cstr(sym_to_latex(expr_const(0x43E158E460913D00 | (1 << 63))),
    "{-10000000000000000000}"), 1, "sym_to_latex: -1e19 renders ONE minus sign");
assert_eq(str_eq_cstr(expr_to_str(expr_const(0x43E158E460913D00 | (1 << 63))),
    "-10000000000000000000"), 1, "expr_to_str: -1e19 exact");

# 2^100 -- far past anything i64 can hold; 31 digits.
assert_eq(str_eq_cstr(expr_to_str(expr_const((1023 + 100) << 52)),
    "1267650600228229401496703205376"), 1, "expr_to_str: 2^100 exact, 31 digits");

# The contract: integral values render WITHOUT decimals at every magnitude, and
# the two renderers agree. 1e15 is where the old cap sat.
assert_eq(str_eq_cstr(sym_to_latex(expr_const(0x430C_6BF5_2634_0000)),
    "1000000000000000"), 1, "sym_to_latex: 1e15 has no decimal point (old cap)");

# ⚠ A COUNTER, not a spot check: every integral binade, both renderers, compared
# to each other. A loop that ran zero times would report zero disagreements.
var _xi_n = 0;
var _xi_agree = 0;
for (var _xi_e = 0; _xi_e <= 1023; _xi_e = _xi_e + 1) {
    var _xi_v = (1023 + _xi_e) << 52;
    _xi_n = _xi_n + 1;
    if (str_eq(expr_to_str(expr_const(_xi_v)), sym_to_latex(expr_const(_xi_v))) == 1) {
        _xi_agree = _xi_agree + 1;
    }
}
assert_eq(_xi_n, 1024, "integral-binade sweep: all 1024 binades tested");
assert_eq(_xi_agree, 1024, "expr_to_str and sym_to_latex agree on every integral binade");

# Non-integral values still take the 6-decimal float path -- unchanged.
assert_eq(str_eq_cstr(expr_to_str(expr_const(0x3FF8000000000000)), "1.500000"), 1,
  "expr_to_str: 1.5 still renders with 6 decimals");

assert_eq(str_eq_cstr(sym_to_latex(expr_const(fc_d)), "1.000000"), 1,
  "carry: _latex_fmt_const shares the fix (audit's exact value)");

# Control: the fix must not perturb a value that does not carry.
var fc_e = f64_div(f64_from(1), f64_from(3));
assert_eq(str_eq_cstr(expr_to_str(expr_const(fc_e)), "0.333333"), 1,
  "carry fix does not perturb non-carrying values");

test_group("kdtree: the split plane must actually separate the subtrees");

# `split_val` used to be read from items[split] -- SOME right-side value, not the
# partition plane. Every right-side point below that value then sat on the wrong
# side of its own node's pruning plane, so the query pruned subtrees that still
# held valid hits. Measured before the fix: 274 of 400 radius queries returned
# the WRONG COUNT. The suites at the time did not notice.
var KDV_N = 1500;
var kdv_pts = alloc(KDV_N * 8);
var kdv_i = 0;
while (kdv_i < KDV_N) {
    store64(kdv_pts + kdv_i * 8, hvec3_new(f64_from((kdv_i * 2654435761) % 1009),
        f64_from((kdv_i * 40503) % 1013), f64_from((kdv_i * 69069) % 1019)));
    kdv_i = kdv_i + 1;
}
var kdv_tree = kdtree_build(kdv_pts, KDV_N);
assert_neq(kdv_tree, 0, "kdtree_build(1500 scattered) returns a tree");

# The structural invariant, checked directly on every node.
assert_eq(_kdv_invariant_bad(kdv_tree, kdv_pts), 0,
  "kdtree: no point sits on the wrong side of its ancestor's split plane");

# And the behaviour that invariant exists to protect, against brute force.
var kdv_bad = 0;
var kdv_q = 0;
while (kdv_q < 200) {
    var kdv_qp = hvec3_new(f64_from((kdv_q * 7919) % 1009), f64_from((kdv_q * 104729) % 1013),
      f64_from((kdv_q * 1299709) % 1019));
    if (vec_len(kdtree_within_radius(kdv_tree, kdv_pts, kdv_qp, f64_from(60)))
      != _kdv_brute(kdv_pts, KDV_N, kdv_qp, f64_from(60))) { kdv_bad = kdv_bad + 1; }
    kdv_q = kdv_q + 1;
}
assert_eq(kdv_bad, 0, "kdtree_within_radius matches brute force on 200 queries");

test_group("triangulate_polygon: partial returns are a documented contract");

# A convex quad triangulates completely: 3*(4-2) = 6 indices.
var tpc = vec_new();
vec_push(tpc, hvec2_new(0, 0));
vec_push(tpc, hvec2_new(F64_TWO, 0));
vec_push(tpc, hvec2_new(F64_TWO, F64_TWO));
vec_push(tpc, hvec2_new(0, F64_TWO));
assert_eq(vec_len(triangulate_polygon(tpc, 4)), 6, "convex quad -> complete, 3*(n-2) = 6");

# A self-intersecting polygon has no ear decomposition. The header claimed
# length = 3*(n-2) unconditionally through 2.7.0; it is actually SHORTER, and
# that is the signal a caller must test for.
var tpd = vec_new();
vec_push(tpd, hvec2_new(0, 0));
vec_push(tpd, hvec2_new(0, F64_TWO));
vec_push(tpd, hvec2_new(F64_ONE, F64_ONE));
vec_push(tpd, hvec2_new(0, F64_TWO));
vec_push(tpd, hvec2_new(F64_TWO, F64_ONE));
var tpd_len = vec_len(triangulate_polygon(tpd, 5));
# The CONTRACT is "at most 3*(n-2), a whole number of triples" -- complete OR
# partial are both valid. An earlier version of this assertion pinned `< 9`,
# i.e. it asserted that THIS input bails; the 2.7.0-O reflex-only pruning then
# triangulates it completely, which is strictly better and broke the assertion.
# Pinning which inputs happen to bail is pinning an implementation detail.
assert(tpd_len <= 9, "self-intersecting pentagon returns AT MOST 3*(n-2) = 9");
# The returned prefix is still whole triples -- a partial triangulation, not a
# truncated array.
assert_eq(tpd_len % 3, 0, "partial return is still a whole number of triples");

test_group("spatial: quadtree / octree / spatial hash had ZERO coverage");

# Three whole data structures, 11 public functions, untested through 2.7.0 --
# the same shape as the k-d tree defect that hid for three releases. Each is
# checked against brute force, not just for non-null.

# --- quadtree: 20x20 grid of points over [0,100]^2 ---
var qt = quadtree_new(0, 0, f64_from(100), f64_from(100), 6);
assert_neq(qt, 0, "quadtree_new returns a root");
var qgx = 0;
var qt_in = 0;
while (qgx < 20) {
    var qgy = 0;
    while (qgy < 20) {
        var _r28t, _r28v = quadtree_insert(qt, f64_from(qgx * 5), f64_from(qgy * 5), qgx * 100 + qgy);
        qgy = qgy + 1;
    }
    qgx = qgx + 1;
}
# Box [10,30]x[10,30] inclusive covers grid coords 2..6 on each axis = 5*5 = 25.
var qres = quadtree_query(qt, f64_from(10), f64_from(10), f64_from(30), f64_from(30));
assert_eq(vec_len(qres), 25, "quadtree_query [10,30]^2 finds exactly 25 of 400");
# Whole-domain query must return everything.
assert_eq(vec_len(quadtree_query(qt, 0, 0, f64_from(100), f64_from(100))), 400,
  "quadtree_query over the whole domain finds all 400");
# Disjoint box finds nothing.
assert_eq(vec_len(quadtree_query(qt, f64_from(200), f64_from(200), f64_from(300), f64_from(300))), 0,
  "quadtree_query outside the domain finds nothing");

# --- octree: 8x8x8 grid over [0,80]^3 ---
var ot = octree_new(hvec3_zero(), hvec3_new(f64_from(80), f64_from(80), f64_from(80)), 5);
assert_neq(ot, 0, "octree_new returns a handle");
var oi = 0;
while (oi < 8) {
    var oj = 0;
    while (oj < 8) {
        var ok = 0;
        while (ok < 8) {
            var _oi_t, _oi_v = octree_insert(ot,
              hvec3_new(f64_from(oi * 10), f64_from(oj * 10), f64_from(ok * 10)),
              oi * 64 + oj * 8 + ok);
            ok = ok + 1;
        }
        oj = oj + 1;
    }
    oi = oi + 1;
}
# [0,20]^3 inclusive covers grid 0..2 per axis = 27.
assert_eq(vec_len(octree_query(ot, hvec3_zero(), hvec3_new(f64_from(20), f64_from(20), f64_from(20)))),
  27, "octree_query [0,20]^3 finds exactly 27 of 512");
assert_eq(vec_len(octree_query(ot, hvec3_zero(),
      hvec3_new(f64_from(80), f64_from(80), f64_from(80)))), 512, "octree_query whole domain finds all 512");

# --- spatial hash: broadphase, so it may over-report but must never MISS ---
var sh = spatial_hash_new(f64_from(10));
assert_neq(sh, 0, "spatial_hash_new returns a handle");
var si = 0;
while (si < 100) {
    spatial_hash_insert(sh, hvec3_new(f64_from(si), f64_from(si), 0), si);
    si = si + 1;
}
# Same-cell query at the origin: points 0..9 share cell (0,0,0) with cell_size 10.
assert_eq(vec_len(spatial_hash_query_cell(sh, hvec3_zero())), 10,
  "spatial_hash_query_cell finds the 10 points sharing cell (0,0,0)");
# Radius query is a broadphase: it must be a SUPERSET of the true answer.
var sh_r = spatial_hash_query_radius(sh, hvec3_zero(), f64_from(15));
var sh_true = 0;
si = 0;
while (si < 100) {
    var sd = f64_mul(f64_from(si), f64_sqrt(F64_TWO));
    if (f64_gt(sd, f64_from(15)) == 0) { sh_true = sh_true + 1; }
    si = si + 1;
}
assert(vec_len(sh_r) >= sh_true, "spatial_hash_query_radius never misses a true hit");
assert(sh_true > 0, "the radius test is non-vacuous -- there ARE true hits");
# clear() must actually empty it.
spatial_hash_clear(sh);
assert_eq(vec_len(spatial_hash_query_cell(sh, hvec3_zero())), 0,
  "spatial_hash_clear empties every cell");

test_group("arena: the alloc-inside-loop sites are hoisted (bump alloc never frees)");

# 2026-08-04 audit, performance. Three allocation sites sat inside loops (or, for
# _kd_build_rec, inside a recursion) of an allocator that never returns memory, so
# the cost was proportional to the iteration count on EVERY call. Before/after
# measured with alloc_used() around a single call, scratch binaries under
# /tmp/.../tail29 and re-measured in-suite here.

# --- src/spatial.cyr: `var plane_out = alloc(8);` per _kd_build_rec call, now one
#     8-byte slot owned by kdtree_build and threaded through the recursion.
#     4,096 random points: 425,832 B before -> 393,080 B after (-32,752 B = 8 B x
#     4,094 internal nodes, -7.7%).
var kdh_n = 4096;
var kdh_pts = alloc(kdh_n * 8);
var kdh_seed = 12345;
for (var kdhi = 0; kdhi < kdh_n; kdhi = kdhi + 1) {
    kdh_seed = (kdh_seed * 1103515245 + 12345) & 0x7FFFFFFF;
    var kdh_x = f64_div(f64_from(kdh_seed % 100000), f64_from(1000));
    kdh_seed = (kdh_seed * 1103515245 + 12345) & 0x7FFFFFFF;
    var kdh_y = f64_div(f64_from(kdh_seed % 100000), f64_from(1000));
    kdh_seed = (kdh_seed * 1103515245 + 12345) & 0x7FFFFFFF;
    var kdh_z = f64_div(f64_from(kdh_seed % 100000), f64_from(1000));
    store64(kdh_pts + kdhi * 8, hvec3_new(kdh_x, kdh_y, kdh_z));
}
var kdh_a0 = alloc_used();
var kdh_root = kdtree_build(kdh_pts, kdh_n);
var kdh_bytes = alloc_used() - kdh_a0;
assert_neq(kdh_root, 0, "kdtree_build: 4096 points build");
assert_lt(kdh_bytes, kdh_n * 100,
  "kdtree_build: under 100 B per point (was 103.96, now 95.96 -- the per-node plane slot is gone)");
# The tree must still be a tree: every point findable, and the split planes still
# correct. Sharing one slot is only safe because split_val is read before the two
# child calls overwrite it, so a nearest-neighbour query is the direct check.
var kdh_probe = load64(kdh_pts + 777 * 8);
assert_eq(kdtree_nearest(kdh_root, kdh_pts, kdh_probe), 777,
  "kdtree_nearest: the shared plane slot did not corrupt a split (point 777 finds itself)");
# And every point in the set, not just one -- a corrupted split plane sends the
# descent down the wrong subtree and the query silently returns a different point.
var kdh_miss = 0;
for (var kdhq = 0; kdhq < kdh_n; kdhq = kdhq + 4) {
    var kdh_qp = load64(kdh_pts + kdhq * 8);
    var kdh_got = kdtree_nearest(kdh_root, kdh_pts, kdh_qp);
    if (f64_gt(hvec3_length(hvec3_sub(load64(kdh_pts + kdh_got * 8), kdh_qp)), 0) == 1) {
        kdh_miss = kdh_miss + 1;
    }
}
assert_eq(kdh_miss, 0,
  "kdtree_nearest: 1024 sampled points each find a coincident nearest -- no split is stale");

# --- src/tensor.cyr: `var full_idx = alloc(rank * 8);` inside the trace loop.
#     200x200 full trace: 3,256 B before -> 72 B after (-97.8%).
var tnh_shape = alloc(16);
store64(tnh_shape, 200);
store64(tnh_shape + 8, 200);
var tnh_t = tensor_new(2, tnh_shape);
assert_neq(tnh_t, 0, "tensor_new 200x200");
for (var tnhi = 0; tnhi < 200; tnhi = tnhi + 1) {
    var tnh_ix = alloc(16);
    store64(tnh_ix, tnhi);
    store64(tnh_ix + 8, tnhi);
    tensor_set(tnh_t, tnh_ix, F64_ONE);
}
var tnh_a0 = alloc_used();
var tnh_tr = tensor_contract(tnh_t, 0, 1);
var tnh_bytes = alloc_used() - tnh_a0;
assert_neq(tnh_tr, 0, "tensor_contract: the 200x200 trace returns a scalar tensor");
assert_lt(tnh_bytes, 256,
  "tensor_contract: the trace costs under 256 B of arena (was 3,256 -- one alloc per k)");
# The hoisted buffer is zeroed ONCE and only slots ii/jj are rewritten, so a
# wrong answer here is exactly the staleness bug the hoist could have introduced.
# All 200 diagonal entries are 1, so the trace is 200 exactly.
assert_eq(load64(HTensor_data(tnh_tr)), f64_from(200),
  "tensor_contract: trace of I_200 == 200 exactly (the shared full_idx stays clean)");

# --- The OTHER full_idx, before the out_idx loop, was ALREADY hoisted; the audit
#     row listed it as a second site and that half is REFUTED by measurement.
#     A 12^4 rank-4 contraction cost 1,272 B per call both before and after this
#     cycle's edit, i.e. no per-iteration allocation was present to remove.
var tnh_s4 = alloc(32);
store64(tnh_s4, 12); store64(tnh_s4 + 8, 12);
store64(tnh_s4 + 16, 12); store64(tnh_s4 + 24, 12);
var tnh_t4 = tensor_new(4, tnh_s4);
var tnh_b0 = alloc_used();
var tnh_c4 = tensor_contract(tnh_t4, 0, 1);
assert_neq(tnh_c4, 0, "tensor_contract: 12^4 rank-4 contraction returns a tensor");
assert_lt(alloc_used() - tnh_b0, 2048,
  "tensor_contract: the rank-4 path was already hoisted -- 1,272 B per call, unchanged");

test_group("spatial: max_depth is CAPPED, so a coincident-point chain terminates");

# 2026-08-04 audit, memory-safety. quadtree_new / octree_new stored the caller's
# max_depth verbatim and it was the ONLY bound on _qt_insert_rec / _ot_insert_rec.
# Coincident points always route into the same child, so past the node capacity
# every insert drives a split chain the full depth. Measured on the pre-fix tree
# (8 MiB stack, 64 coincident points, scratch binaries, exit codes recorded):
#   quadtree  max_depth 23,750 -> exit 0     23,906 -> SIGSEGV (139)
#   octree    max_depth 20,000 -> exit 0     30,000 -> SIGSEGV (139)
# and the arena (a bump allocator that never frees) grew 1,216 B per quadtree
# level and 6,144 B per octree level: 24.3 MB / 123 MB at max_depth 20,000.
# The suite never saw it because its only fixtures use max_depth 6 and 5.

fn _qtd_max(node) {
    if (node == 0) { return (0 - 1); }
    if (_qt_node_is_split(node) == 0) { return _qt_node_depth(node); }
    var best = _qt_node_depth(node);
    for (var c = 0; c < 4; c = c + 1) {
        var d = _qtd_max(_qt_node_child(node, c));
        if (d > best) { best = d; }
    }
    return best;
}

fn _otd_max(node) {
    if (node == 0) { return (0 - 1); }
    if (_ot_node_is_split(node) == 0) { return _ot_node_depth(node); }
    var best = _ot_node_depth(node);
    for (var c = 0; c < 8; c = c + 1) {
        var d = _otd_max(_ot_node_child(node, c));
        if (d > best) { best = d; }
    }
    return best;
}

# max_depth = 1e6: the pre-fix code SIGSEGV'd on this. Reaching the assertion at
# all is half the test; the other half is that the depth and the arena are bounded
# by the cap and not by the request.
var qcap_a0 = alloc_used();
var qcap = quadtree_new(0, 0, f64_from(1000), f64_from(1000), 1000000);
for (var qcapi = 0; qcapi < 64; qcapi = qcapi + 1) {
    var _rq39t, _rq39v = quadtree_insert(qcap, F64_ONE, F64_ONE, qcapi);
    assert_eq(is_ok(_rq39t), 1, "quadtree_insert: 64 coincident points at max_depth 1e6 all land");
}
var qcap_bytes = alloc_used() - qcap_a0;
assert_eq(_qtd_max(load64(qcap)), _SP_MAX_TREE_DEPTH,
  "quadtree: the split chain stops at _SP_MAX_TREE_DEPTH, not at the requested 1e6");
assert_lt(qcap_bytes, 2097152,
  "quadtree: a coincident-point chain costs under 2 MB of arena (measured 1,311,304 B)");
assert_eq(vec_len(quadtree_query(qcap, 0, 0, f64_from(1000), f64_from(1000))), 64,
  "quadtree: capping loses no points -- all 64 are still queryable");

# i64 max as max_depth must be indistinguishable from the cap itself: same depth,
# same arena. If the clamp were ever removed this diverges immediately.
var qcap2_a0 = alloc_used();
var qcap2 = quadtree_new(0, 0, f64_from(1000), f64_from(1000), _SP_MAX_TREE_DEPTH);
for (var qcap2i = 0; qcap2i < 64; qcap2i = qcap2i + 1) {
    var _r29t, _r29v = quadtree_insert(qcap2, F64_ONE, F64_ONE, qcap2i);
}
assert_eq(alloc_used() - qcap2_a0, qcap_bytes,
  "quadtree: max_depth 1e6 and max_depth _SP_MAX_TREE_DEPTH allocate identically");
assert_eq(_qtd_max(load64(qcap2)), _SP_MAX_TREE_DEPTH, "quadtree: the cap is reachable, not off by one");

# Octree: 8 children per level, so 5x the quadtree's per-level cost.
var ocap_a0 = alloc_used();
var ocap = octree_new(hvec3_zero(), hvec3_splat(f64_from(1000)), 1000000);
for (var ocapi = 0; ocapi < 64; ocapi = ocapi + 1) {
    var _rq40t, _rq40v = octree_insert(ocap, hvec3_one(), ocapi);
    assert_eq(is_ok(_rq40t), 1, "octree_insert: 64 coincident points at max_depth 1e6 all land");
}
var ocap_bytes = alloc_used() - ocap_a0;
assert_eq(_otd_max(load64(ocap)), _SP_MAX_TREE_DEPTH,
  "octree: the split chain stops at _SP_MAX_TREE_DEPTH, not at the requested 1e6");
assert_lt(ocap_bytes, 8388608,
  "octree: a coincident-point chain costs under 8 MB of arena (measured 6,606,992 B)");
assert_eq(vec_len(octree_query(ocap, hvec3_zero(), hvec3_splat(f64_from(1000)))), 64,
  "octree: capping loses no points -- all 64 are still queryable");

# The cap must not touch a sane tree. A 20x20 grid at max_depth 6 splits to 3
# levels; the depth-6 fixture above is unchanged, and this pins that directly.
var qsane = quadtree_new(0, 0, f64_from(100), f64_from(100), 6);
for (var qsx = 0; qsx < 20; qsx = qsx + 1) {
    for (var qsy = 0; qsy < 20; qsy = qsy + 1) {
        var _r30t, _r30v = quadtree_insert(qsane, f64_from(qsx * 5), f64_from(qsy * 5), qsx * 100 + qsy);
    }
}
assert_lte(_qtd_max(load64(qsane)), 6, "quadtree: a max_depth 6 tree still stops at 6");
assert(_qtd_max(load64(qsane)) > 0, "quadtree: the max_depth 6 tree really did split");
assert_eq(vec_len(quadtree_query(qsane, 0, 0, f64_from(100), f64_from(100))), 400,
  "quadtree: the capped build is byte-for-byte the old behaviour below the cap");

# A negative max_depth already meant "never split"; the clamp to 0 writes that
# down rather than changing it.
var qneg = quadtree_new(0, 0, f64_from(10), f64_from(10), (0 - 5));
for (var qni = 0; qni < 32; qni = qni + 1) {
    var _qn_t, _qn_v = quadtree_insert(qneg, F64_ONE, F64_ONE, qni);
}
assert_eq(_qtd_max(load64(qneg)), 0, "quadtree: max_depth -5 clamps to 0 -- everything in the root");
assert_eq(vec_len(quadtree_query(qneg, 0, 0, f64_from(10), f64_from(10))), 32,
  "quadtree: max_depth -5 still stores all 32 points");

test_group("color: alpha compositing, tonemap, depth, EV -- 21 untested functions");

# premultiply / unpremultiply round-trip. a = 0.5 is dyadic so this is exact.
var cpm = premultiply_alpha(F64_ONE, F64_HALF, 0, F64_HALF);
assert_eq(HVec4_x(cpm), F64_HALF, "premultiply r = 1*0.5 = 0.5 exactly");
assert_eq(HVec4_y(cpm), 0x3FD0000000000000, "premultiply g = 0.5*0.5 = 0.25 exactly");
assert_eq(HVec4_w(cpm), F64_HALF, "premultiply keeps alpha");
var cup = unpremultiply_alpha(HVec4_x(cpm), HVec4_y(cpm), HVec4_z(cpm), HVec4_w(cpm));
assert_eq(HVec4_x(cup), F64_ONE, "unpremultiply round-trips r to 1");
assert_eq(HVec4_y(cup), F64_HALF, "unpremultiply round-trips g to 0.5");
# a == 0 is the documented guard.
assert_eq(HVec4_x(unpremultiply_alpha(F64_ONE, F64_ONE, F64_ONE, 0)), 0,
  "unpremultiply with a = 0 returns zero, not Inf");

# Porter-Duff. Opaque dst under opaque src: dst_over keeps DST.
var cdo = composite_dst_over(F64_ONE, 0, 0, F64_ONE, 0, F64_ONE, 0, F64_ONE);
assert_eq(HVec4_y(cdo), F64_ONE, "dst_over over opaque dst keeps dst green");
assert_eq(HVec4_x(cdo), 0, "dst_over over opaque dst drops src red");
# src_in with opaque dst is src; with transparent dst it is nothing.
assert_eq(HVec4_x(composite_src_in(F64_ONE, 0, 0, F64_ONE, 0, 0, 0, F64_ONE)), F64_ONE,
  "src_in with opaque dst keeps src");
assert_eq(HVec4_x(composite_src_in(F64_ONE, 0, 0, F64_ONE, 0, 0, 0, 0)), 0,
  "src_in with transparent dst is empty");
assert_eq(HVec4_x(composite_dst_in(0, 0, 0, F64_ONE, F64_ONE, 0, 0, F64_ONE)), F64_ONE,
  "dst_in with opaque src keeps dst");
assert_eq(HVec4_x(composite_src_out(F64_ONE, 0, 0, F64_ONE, 0, 0, 0, 0)), F64_ONE,
  "src_out against transparent dst keeps src");
assert_eq(HVec4_x(composite_dst_out(0, 0, 0, 0, F64_ONE, 0, 0, F64_ONE)), F64_ONE,
  "dst_out against transparent src keeps dst");
assert_eq(HVec4_w(composite_xor(F64_ONE, 0, 0, F64_ONE, 0, 0, 0, F64_ONE)), 0,
  "xor of two opaque layers has zero alpha");
# plus saturates at 1.
var cpl = composite_plus(F64_ONE, F64_HALF, 0, F64_ONE, F64_ONE, F64_HALF, 0, F64_ONE);
assert_eq(HVec4_x(cpl), F64_ONE, "plus saturates red at 1");
assert_eq(HVec4_y(cpl), F64_ONE, "plus 0.5 + 0.5 = 1");

# Depth linearisation. ndc = 0 with near/far = 1/100 gives near*far/far = 1.
assert_eq(linearize_depth(0, F64_ONE, f64_from(100)), F64_ONE,
  "linearize_depth at ndc = 0 returns near");
# Reverse-Z: ndc = 0 is the far plane and is guarded.
assert_eq(linearize_depth_reverse_z(0, F64_ONE), 0, "reverse-Z at ndc = 0 is guarded");
assert_eq(linearize_depth_reverse_z(F64_HALF, F64_ONE), F64_TWO,
  "reverse-Z near/ndc = 1/0.5 = 2");

# EV100 round-trip: luminance_to_ev100(ev100_to_luminance(x)) == x.
var cev = f64_from(10);
var cev_rt = luminance_to_ev100(ev100_to_luminance(cev));
assert(f64_lt(f64_abs(f64_sub(cev_rt, cev)), LOOSE_TOL_M) == 1, "EV100 round-trips at 10");
assert(f64_gt(ev100_to_luminance(cev), ev100_to_luminance(F64_ONE)) == 1,
  "higher EV means higher luminance");
assert(f64_gt(ev100_to_exposure(F64_ONE), ev100_to_exposure(cev)) == 1,
  "higher EV means LOWER exposure");

# Vec3 sRGB wrappers must agree with the scalar path they wrap.
var csv = srgb_to_linear_vec3(hvec3_new(F64_HALF, F64_HALF, F64_HALF));
assert_eq(HVec3_x(csv), srgb_to_linear(F64_HALF), "srgb_to_linear_vec3 matches the scalar");
var cls = linear_to_srgb_vec3(csv);
assert(f64_lt(f64_abs(f64_sub(HVec3_x(cls), F64_HALF)), LOOSE_TOL_M) == 1,
  "linear_to_srgb_vec3 round-trips 0.5");
# lerp at the endpoints: within 1 ulp, not exact.
var cla = hvec3_new(F64_ONE, 0, 0);
var clb = hvec3_new(0, F64_ONE, 0);
# Not bit-exact, and NOT because of the round trip. srgb_to_linear(1.0) is exact,
# and so is pow(1, 1/2.4). linear_to_srgb(1.0) = 1.055 - 0.055 comes back 1 ulp
# low (0x3FEFFFFFFFFFFFFF) because neither constant is representable, so their
# difference is 1 - 2^-53. (Through 3.3.0 this comment blamed the round trip, and
# the line above it called the endpoints exact.)
# [measured: f64 replay of _SRGB_1_055 and _SRGB_0_055, 2026-09-30]
# Tolerance, not equality.
assert(f64_lt(f64_abs(f64_sub(HVec3_x(lerp_srgb_vec3(cla, clb, 0)), F64_ONE)), LOOSE_TOL_M) == 1,
  "lerp_srgb t = 0 is a");
assert(f64_lt(f64_abs(f64_sub(HVec3_y(lerp_srgb_vec3(cla, clb, F64_ONE)), F64_ONE)), LOOSE_TOL_M) == 1,
  "lerp_srgb t = 1 is b");

# Tonemaps: monotone, and black maps to black.
assert_eq(HVec3_x(tonemap_aces(0, 0, 0)), 0, "ACES maps black to black");
assert(f64_gt(HVec3_x(tonemap_aces(F64_ONE, 0, 0)), 0) == 1, "ACES of 1 is positive");
assert(f64_lt(HVec3_x(tonemap_reinhard_extended(F64_ONE, 0, 0, f64_from(4))), F64_ONE) == 1,
  "Reinhard-extended of 1 stays below 1");

# Spherical harmonics L2: 9 coefficients, and the DC term is constant.
var csh = sh_eval_l2(hvec3_unit_z());
assert_neq(csh, 0, "sh_eval_l2 returns coefficients");
assert(f64_gt(load64(csh), 0) == 1, "sh_eval_l2 DC term is positive");
var csh2 = sh_eval_l2(hvec3_unit_x());
assert_eq(load64(csh), load64(csh2), "sh_eval_l2 DC term is direction-independent");

test_group("linalg_ext CSR + ode implicit integrators -- previously untested");

# --- CSR sparse. A = [[1,0,2],[0,3,0],[4,0,5]] ---
var cs_d = ganita_mat_new(3, 3);
ganita_mat_set(cs_d, 0, 0, F64_ONE);       ganita_mat_set(cs_d, 0, 2, F64_TWO);
ganita_mat_set(cs_d, 1, 1, f64_from(3));
ganita_mat_set(cs_d, 2, 0, f64_from(4));   ganita_mat_set(cs_d, 2, 2, f64_from(5));
var cs = csr_from_dense(cs_d);
assert_neq(cs, 0, "csr_from_dense returns a matrix");
assert_eq(csr_nrows(cs), 3, "csr_nrows = 3");
assert_eq(csr_ncols(cs), 3, "csr_ncols = 3");
assert_eq(csr_nnz(cs), 5, "csr_nnz counts exactly the 5 stored entries, not 9");
assert_neq(csr_row_ptr(cs), 0, "csr_row_ptr is populated");
assert_neq(csr_col_idx(cs), 0, "csr_col_idx is populated");
assert_neq(csr_values(cs), 0, "csr_values is populated");

# A * (1,1,1) = (3, 3, 9)
var cs_x = alloc(24);
store64(cs_x, F64_ONE); store64(cs_x + 8, F64_ONE); store64(cs_x + 16, F64_ONE);
var cs_y = csr_spmv(cs, cs_x);
assert_eq(load64(cs_y), f64_from(3), "csr_spmv row0 = 1+2 = 3");
assert_eq(load64(cs_y + 8), f64_from(3), "csr_spmv row1 = 3");
assert_eq(load64(cs_y + 16), f64_from(9), "csr_spmv row2 = 4+5 = 9");

# A + A = 2A, so spmv doubles.
var cs_sum = csr_add(cs, cs);
assert_neq(cs_sum, 0, "csr_add returns a matrix");
var cs_y2 = csr_spmv(cs_sum, cs_x);
assert_eq(load64(cs_y2 + 16), f64_from(18), "csr_add: (A+A)*x doubles row2 to 18");

# A^T = [[1,0,4],[0,3,0],[2,0,5]]; A^T*(1,1,1) = (5, 3, 7).
var cs_t = csr_transpose(cs);
assert_eq(csr_nnz(cs_t), 5, "csr_transpose preserves nnz");
var cs_y3 = csr_spmv(cs_t, cs_x);
assert_eq(load64(cs_y3), f64_from(5), "csr_transpose row0 = 1+4 = 5");
assert_eq(load64(cs_y3 + 16), f64_from(7), "csr_transpose row2 = 2+5 = 7");

# --- inertia_box: solid box I_xx = m(hy^2 + hz^2)/3 for HALF-extents.
# m = 12, h = (1,1,1) -> 12*(1+1)/3 = 8 on every axis.
var ib = inertia_box(f64_from(12), F64_ONE, F64_ONE, F64_ONE);
assert_neq(ib, 0, "inertia_box returns a tensor");
# Returns a Mat3, not a vector. Formula uses FULL extents: w = 2*hx, so for
# m = 12 and half-extents (1,1,1) the box is 2x2x2 and I_xx = (m/12)(h^2+d^2) = 8.
assert_eq(ganita_mat_get(ib, 0, 0), f64_from(8), "inertia_box 2x2x2 cube I_xx = (m/12)(h^2+d^2) = 8");
assert_eq(ganita_mat_get(ib, 2, 2), f64_from(8), "inertia_box cube is isotropic");
assert_eq(ganita_mat_get(ib, 0, 1), f64_from(0), "inertia_box is diagonal for an axis-aligned box");

# --- matrix_condition_number: identity is perfectly conditioned.
var mc_i = ganita_mat_identity(3);
var mc = matrix_condition_number(mc_i);
# This uses the FROBENIUS norm, not the 2-norm, so cond(I_3) = sqrt(3)*sqrt(3) = 3,
# not 1. matrix_condition_number's doc names the Frobenius norm, so it is
# self-consistent -- but it is NOT the spectral condition number a caller may expect.
assert(f64_lt(f64_abs(f64_sub(mc, f64_from(3))), LOOSE_TOL_M) == 1,
  "cond_F(I_3) = ||I||_F * ||I^-1||_F = 3");
# A badly-scaled matrix must score worse than the identity.
var mc_b = ganita_mat_new(2, 2);
ganita_mat_set(mc_b, 0, 0, f64_from(1000)); ganita_mat_set(mc_b, 1, 1, f64_div(F64_ONE, f64_from(1000)));
assert(f64_gt(matrix_condition_number(mc_b), mc) == 1,
  "cond(diag(1000, 0.001)) is far worse than cond(I)");

# --- eigen_symmetric on diag(3,1): eigenvalues 3 and 1.
var es_A = ganita_mat_new(2, 2);
ganita_mat_set(es_A, 0, 0, f64_from(3)); ganita_mat_set(es_A, 1, 1, F64_ONE);
var es_vals = alloc(16);
var es_vecs = ganita_mat_new(2, 2);
var _rq97t, _rq97v = eigen_symmetric(es_A, 2, es_vals, es_vecs);
assert_eq(is_ok(_rq97t), 1, "eigen_symmetric converges");
assert_eq(load64(es_vals), f64_from(3), "eigen_symmetric dominant eigenvalue = 3");

# --- implicit ODE integrators on y' = y, y(0) = 1, dt = 1/4.
# Backward Euler: y1 = y/(1-dt) = 1/0.75 = 4/3.
var oi_dt = f64_div(F64_ONE, f64_from(4));
var oi_be = ode_backward_euler(&_cv_dydt_y, 0, F64_ONE, oi_dt, EPSILON_F64, 50);
var oi_be_want = f64_div(f64_from(4), f64_from(3));
assert(f64_lt(f64_abs(f64_sub(oi_be, oi_be_want)), LOOSE_TOL_M) == 1,
  "backward Euler y1 = 1/(1-dt) = 4/3");
# It must be ABOVE the exact e^dt -- backward Euler over-shoots on a growing solution.
assert(f64_gt(oi_be, f64_exp(oi_dt)) == 1, "backward Euler overshoots exp(dt), as it must");

# BDF2 with a consistent history is at least as accurate as backward Euler here.
var oi_bdf = ode_bdf2(&_cv_dydt_y, 0, F64_ONE, f64_div(F64_ONE, f64_exp(oi_dt)), oi_dt, EPSILON_F64);
assert(f64_gt(oi_bdf, F64_ONE) == 1, "bdf2 advances a growing solution");

# Leapfrog on the SHO from (q,v) = (1,0): one step must reduce q and drive v negative.
var oi_lf = ode_leapfrog(&_cv_accel, F64_ONE, 0, F64_HALF);
assert(f64_lt(load64(oi_lf), F64_ONE) == 1, "leapfrog q decreases from the turning point");
assert(f64_lt(load64(oi_lf + 8), 0) == 1, "leapfrog v goes negative from the turning point");

# Balance guard: the hybrid partition must keep every child at >= 1/4 of its
# parent, so depth is bounded at log_(4/3)(n) regardless of coordinate
# distribution. Geometric spacing is the case the value-midpoint split handles
# badly; this builds and queries correctly either way.
var kdb_n = 8000;
var kdb_p = alloc(kdb_n * 8);
var kdb_i = 0;
var kdb_v = F64_ONE;
while (kdb_i < kdb_n) {
    kdb_v = f64_mul(kdb_v, 0x3FEFFF0000000000);
    store64(kdb_p + kdb_i * 8, hvec3_new(kdb_v, f64_from(kdb_i % 97), f64_from(kdb_i % 89)));
    kdb_i = kdb_i + 1;
}
var kdb_t = kdtree_build(kdb_p, kdb_n);
assert_neq(kdb_t, 0, "kdtree_build handles geometrically-spaced coordinates");
assert_eq(_kdv_invariant_bad(kdb_t, kdb_p), 0,
  "geometric spacing: split-plane invariant still holds on every node");

# 2.9.3: the guard's OWN property, which nothing asserted until now.
assert_lt(_kdv_depth(kdb_t), 64,
  "geometric spacing: depth stays log-bounded");

# ...and the fixture that makes that assertion MEAN something. The one above
# does not: its ratio is 0.99998, so over 8000 points the axis range is only
# [0.85, 1] and the value-midpoint lands near the count-median anyway -- the
# guard never fires, and deleting it changes nothing -- the whole suite stays
# green with the guard replaced by `if (1 == 1)`. That is the shape of a
# regression test that guards nothing, which is the defect this block is fixing,
# so it must not be repeated one line down.
# [measured: scratch mutation run, not reproducible in-tree]
# To re-run it: replace the `split - start >= quarter && ...` condition in
# `_kd_partition` (src/spatial.cyr) with `1 == 1` and run this suite; only the
# OCTAVE assertion below goes red.
#
# What degenerates the value-midpoint split is a range spanning many orders of
# magnitude: with v = 2^-i the axis range is [2^-n, 1], the midpoint is ~0.5, and
# exactly ONE point sits above it -- so the split peels off a single point per
# level and depth goes linear. All three coordinates decay here, because the axis
# cycles 0,1,2 and a single degenerate axis is diluted by two healthy ones.
# log_(4/3)(512) is about 22; unguarded this builds a ~512-deep spine.
var kds_n = 512;
var kds_p = alloc(kds_n * 8);
var kds_i = 0;
var kds_v = F64_ONE;
while (kds_i < kds_n) {
    kds_v = f64_mul(kds_v, F64_HALF);
    store64(kds_p + kds_i * 8, hvec3_new(kds_v, kds_v, kds_v));
    kds_i = kds_i + 1;
}
var kds_t = kdtree_build(kds_p, kds_n);
assert_neq(kds_t, 0, "kdtree_build handles an octave-spaced axis");
assert_eq(_kdv_invariant_bad(kds_t, kds_p), 0,
  "octave spacing: split-plane invariant holds on every node");
assert_lt(_kdv_depth(kds_t), 64,
  "octave spacing: depth stays log-bounded -- THIS is the balance guard's assertion");

test_group("complex / geo / symbolic: closing the remaining coverage holes");

# --- complex scalar ops with closed-form answers ---
var cz = cx_new(f64_from(3), f64_from(4));
assert_eq(HComplex_re(cx_neg(cz)), f64_neg(f64_from(3)), "cx_neg re");
assert_eq(HComplex_im(cx_neg(cz)), f64_neg(f64_from(4)), "cx_neg im");
assert_eq(HComplex_re(cx_scale(cz, F64_TWO)), f64_from(6), "cx_scale re");
assert_eq(cx_norm_sq(cz), f64_from(25), "cx_norm_sq(3+4i) = 25");
# polar: r=2, theta=0 -> 2 + 0i
var cp = cx_from_polar(F64_TWO, 0);
assert_eq(HComplex_re(cp), f64_from(2), "cx_from_polar(2, 0) re = 2");
assert(f64_lt(f64_abs(HComplex_im(cp)), LOOSE_TOL_M) == 1, "cx_from_polar(2, 0) im = 0");
# ln(1) = 0
var cl = cx_ln(cx_one());
assert(f64_lt(f64_abs(HComplex_re(cl)), LOOSE_TOL_M) == 1, "cx_ln(1) re = 0");
# sqrt(-1) = i, bit-exact. ⛔ Through 3.3.3 the real part was 0x3C91A62633145C07,
# r*cos(fl(pi)/2), and the LOOSE_TOL_M comparison here read that as 0. C99 csqrt
# gives +0 and since 3.3.4 so does cx_sqrt.
# [measured: scratch csqrt probe (special-value table), 2026-10-03; cycc 6.6.14]
var cq = cx_sqrt(cx_new(f64_neg(F64_ONE), 0));
assert_eq(HComplex_re(cq), 0, "cx_sqrt(-1) re = +0 exactly");
assert_eq(HComplex_im(cq), F64_ONE, "cx_sqrt(-1) im = 1 exactly");
# sin(0) = 0, cos(0) = 1
assert(f64_lt(f64_abs(HComplex_re(cx_sin(cx_zero()))), LOOSE_TOL_M) == 1, "cx_sin(0) = 0");
assert(f64_lt(f64_abs(f64_sub(HComplex_re(cx_cos(cx_zero())), F64_ONE)), LOOSE_TOL_M) == 1,
  "cx_cos(0) = 1");
# ⭐ 3.3.4 — cx_sin and cx_cos take ganita's sinh and cosh of the imaginary part, which
# ganita 1.2.11 (cyrius 6.6.13) re-derived ("lie: Lorentz" has the whole change). On
# the imaginary axis sin 0 = 0 and cos 0 = 1 are exact, so sin(iy) = i sinh y and
# cos(iy) = cosh y come through with no rounding of hisab's own. Each pin is the
# correctly rounded value by an 80-digit Decimal oracle, and each FAILS when built
# against cyrius 6.6.12, whose value is in the message: at 3e-8 the old sinh was
# 6.0e6 ulp off, at -44.3 the old cosh 1.07 ulp. cosh(-44.3) goes through f64_exp,
# x87 on x86_64 and a polyfill on aarch64; this pin was measured on x86_64 only.
# [measured: scratch harness and Decimal oracle, not reproducible in-tree, 2026-10-03; cycc 6.6.12 and 6.6.14]
assert_eq(HComplex_im(cx_sin(cx_new(0, 0x3E601B2B29A4692B))), 0x3E601B2B29A4692C,
  "cx_sin(3e-8 i).im = sinh(3e-8), correctly rounded (6.6.12: 0x3E601B2B2A000000)");
assert_eq(HComplex_re(cx_cos(cx_new(0, 0xC046266666666666))), 0x43DE17FDB54D190F,
  "cx_cos(-44.3 i).re = cosh(-44.3), correctly rounded (6.6.12: ...190E)");
# Off the axis, one ulp above 709: sin(1) cosh y and -sin(1) sinh y. Both factors are
# correctly rounded (f64_sin(1) = 0x3FEAED548F090CEE, 0.02 ulp) and so is their f64
# product, 0.18 ulp from the true one. 6.6.12's factor was 453 ulp off. f64_sin is a
# polyfill on every target, but the cosh/sinh factor goes through f64_exp (x87 on x86_64),
# so these two pins were measured on x86_64 only.
# [measured: scratch harness and Decimal oracle, not reproducible in-tree, 2026-10-03; cycc 6.6.12 and 6.6.14]
var c_hy_y = cx_new(F64_ONE, 0x4086280000000001);
assert_eq(HComplex_re(cx_sin(c_hy_y)), 0x7FC89EC422B67842,
  "cx_sin(1 + (709 + 1 ulp) i).re, correctly rounded (6.6.12: ...79BF)");
assert_eq(HComplex_im(cx_cos(c_hy_y)), 0xFFC89EC422B67842,
  "cx_cos(1 + (709 + 1 ulp) i).im, correctly rounded (6.6.12: ...79BF)");
# pauli_0 is the 2x2 identity.
assert_eq(HComplex_re(cmat_get(pauli_0(), 0, 0)), f64_from(1), "pauli_0 is the identity");
assert_eq(HComplex_re(cmat_get(pauli_0(), 0, 1)), f64_from(0), "pauli_0 off-diagonal = 0");
# Dirac gammas: gamma_0^2 = I, and gamma_5 is traceless.
assert_neq(gamma_0(), 0, "gamma_0 exists");
assert_neq(gamma_spatial(1), 0, "gamma_spatial(1) exists");
var cg5 = gamma_5();
assert(f64_lt(f64_abs(HComplex_re(cmat_trace(cg5))), LOOSE_TOL_M) == 1, "gamma_5 is traceless");
# cmat_mul_vec: I * v = v
var cmv = alloc(32);
store64(cmv, F64_ONE); store64(cmv + 8, 0); store64(cmv + 16, F64_TWO); store64(cmv + 24, 0);
var cmr = cmat_mul_vec(cmat_identity(2), cmv);
assert_eq(load64(cmr), f64_from(1), "cmat_mul_vec I*v keeps v0");
assert_eq(load64(cmr + 16), f64_from(2), "cmat_mul_vec I*v keeps v1");

# --- geo ---
var gl = geo_line_new(hvec3_zero(), hvec3_unit_x());
assert_neq(gl, 0, "geo_line_new returns a line");
# Closest point on the x-axis to (5, 3, 0) is (5, 0, 0).
var glc = geo_line_closest_point(gl, hvec3_new(f64_from(5), f64_from(3), 0));
assert_eq(HVec3_x(glc), f64_from(5), "line closest point x = 5");
assert(f64_lt(f64_abs(HVec3_y(glc)), LOOSE_TOL_M) == 1, "line closest point y = 0");
# Segment from origin to (4,0,0): midpoint (2,0,0), distance to (2,3,0) is 3.
var gs = geo_segment_new(hvec3_zero(), hvec3_new(f64_from(4), 0, 0));
assert_eq(HVec3_x(geo_segment_midpoint(gs)), f64_from(2), "segment midpoint x = 2");
assert_eq(geo_segment_distance_to_point(gs, hvec3_new(F64_TWO, f64_from(3), 0)), f64_from(3),
  "segment distance to (2,3,0) = 3");
# Unit normal of the xy triangle is +z.
# These take a Triangle, not three loose vertices.
var gtri = geo_triangle_new(hvec3_zero(), hvec3_unit_x(), hvec3_unit_y());
var gn = geo_triangle_unit_normal(gtri);
assert_eq(HVec3_z(gn), f64_from(1), "triangle unit normal is +z");
var gb = geo_barycentric_coords(gtri, hvec3_zero());
assert_eq(HVec3_x(gb), f64_from(1), "barycentric of vertex a is (1,0,0)");
var gcp = geo_closest_point_on_triangle(gtri, hvec3_new(f64_div(F64_ONE, f64_from(4)),
    f64_div(F64_ONE, f64_from(4)), F64_ONE));
assert(f64_lt(f64_abs(HVec3_z(gcp)), LOOSE_TOL_M) == 1, "closest point on triangle lies in its plane");
# OBB
var gob = geo_obb_new(hvec3_zero(), hvec3_one(), hquat_identity());
assert_neq(gob, 0, "geo_obb_new returns an OBB");
assert_neq(geo_obb_axes(gob), 0, "geo_obb_axes returns axes");
assert_eq(geo_ray_obb(geo_ray_new(hvec3_new(f64_from(10), 0, 0), hvec3_new(f64_neg(F64_ONE), 0, 0)),
    gob) != 0, 1, "geo_ray_obb hits a unit OBB head-on");

# --- symbolic accessors ---
var sxv = expr_var(str_from("x"));
assert_eq(str_eq_cstr(expr_var_name(sxv), "x"), 1, "expr_var_name round-trips");
assert_eq(expr_const_val(expr_const(f64_from(7))), f64_from(7), "expr_const_val = 7");
var sadd = expr_add(sxv, expr_const(F64_ONE));
assert_eq(expr_tag(expr_left(sadd)), expr_tag(sxv), "expr_left of a+b is a");
assert_eq(expr_const_val(expr_right(sadd)), f64_from(1), "expr_right of x+1 is 1");
assert_neq(expr_cos(sxv), 0, "expr_cos builds a node");
assert_neq(expr_ln(sxv), 0, "expr_ln builds a node");
assert_eq(expr_tag(expr_child(expr_cos(sxv))), expr_tag(sxv), "expr_child of cos(x) is x");

test_group("lie_ext SO(3)/SE(3) + num_ext number theory -- closing to 80%");

# --- SO(3): group identities are exact, so they pin the ops without tolerances.
var l3_ax = hvec3_unit_z();
var l3_R = so3_from_axis_angle(l3_ax, F64_PI_2);
assert_neq(l3_R, 0, "so3_from_axis_angle builds a rotation");
# R * R^-1 = I on every entry.
var l3_I = so3_compose(l3_R, so3_inverse(l3_R));
var l3_bad = 0;
var l3_i = 0;
while (l3_i < 3) {
    var l3_j = 0;
    while (l3_j < 3) {
        var want = 0;
        if (l3_i == l3_j) { want = F64_ONE; }
        if (f64_lt(f64_abs(f64_sub(m3_get(l3_I, l3_i, l3_j), want)), LOOSE_TOL_M) == 0) {
            l3_bad = l3_bad + 1;
        }
        l3_j = l3_j + 1;
    }
    l3_i = l3_i + 1;
}
assert_eq(l3_bad, 0, "so3: R * R^-1 == I on all 9 entries");
# log(R) recovers the axis-angle vector: |log| == the rotation angle.
var l3_log = so3_log(l3_R);
assert(f64_lt(f64_abs(f64_sub(hvec3_length(l3_log), F64_PI_2)), LOOSE_TOL_M) == 1,
  "so3_log magnitude equals the rotation angle");
# from_quat and from_mat3 must agree with from_axis_angle.
# so3_from_quat takes an SU(2) element (it calls su2_to_quat internally), NOT an
# HQuat. Passing an HQuat silently reinterprets it and yields a double-angle
# rotation -- cos(180) where cos(90) is meant.
var l3_q = so3_from_quat(su2_from_axis_angle(l3_ax, F64_PI_2));
assert(f64_lt(f64_abs(f64_sub(m3_get(l3_q, 0, 0), m3_get(l3_R, 0, 0))), LOOSE_TOL_M) == 1,
  "so3_from_quat agrees with so3_from_axis_angle");
# so3_from_mat3's doc block claimed "checks determinant ~ +1 and orthogonality"
# and the body did NEITHER -- it was a bare m3_copy, and `!= 0` is the one
# assertion m3_copy cannot fail for any input whatsoever. Both checks are
# implemented as of 2.8.x; the rejections below are the real coverage, and the
# acceptances are the regression guard on the tolerance.
var l3_ok = so3_from_mat3(l3_R);
assert_neq(l3_ok, 0, "so3_from_mat3 accepts a rotation matrix");
assert_eq(m3_get(l3_ok, 0, 1), m3_get(l3_R, 0, 1), "so3_from_mat3 copies the matrix through");
# A reflection is ORTHOGONAL with det = -1. This is the case the determinant
# test exists for: so3_inverse is a bare transpose, which is a true inverse for
# a reflection too, so nothing downstream would ever notice.
var l3_ref = m3_identity();
m3_set(l3_ref, 2, 2, f64_neg(F64_ONE));
assert_eq(so3_from_mat3(l3_ref), 0, "so3_from_mat3 rejects a reflection (det = -1)");
# A shear has det = +1 EXACTLY and is not orthogonal, so only the R^T R test
# can see it -- the determinant check alone would pass it.
var l3_sh = m3_identity();
m3_set(l3_sh, 1, 0, F64_ONE);
assert_eq(so3_from_mat3(l3_sh), 0, "so3_from_mat3 rejects a unit-determinant shear");
# A uniformly scaled rotation fails both tests (R^T R = 4I, det = 8).
assert_eq(so3_from_mat3(m3_scale(l3_R, F64_TWO)), 0, "so3_from_mat3 rejects 2R");
assert_eq(so3_from_mat3(0), 0, "so3_from_mat3 rejects null");
# The tolerance must not be tighter than the arithmetic: a rotation that has
# been through a long compose chain is still a rotation.
var l3_chain = l3_R;
for (var l3_k = 0; l3_k < 64; l3_k = l3_k + 1) { l3_chain = so3_compose(l3_chain, l3_R); }
assert_neq(so3_from_mat3(l3_chain), 0, "so3_from_mat3 accepts a 65-fold composed rotation");

# --- SE(3): identity, compose, inverse, and the point action.
var se_id = se3_identity();
assert_neq(se_id, 0, "se3_identity exists");
var se_t = hvec3_new(F64_ONE, F64_TWO, f64_from(3));
# se3_new takes an SU(2) rotation, not a Mat3 -- see its header.
var se_g = se3_new(su2_from_axis_angle(l3_ax, F64_PI_2), se_t);
assert_neq(se_g, 0, "se3_new builds a transform");
# g * g^-1 applied to a point is the identity on that point.
var se_gi = se3_compose(se_g, se3_inverse(se_g));
var se_p = hvec3_new(f64_from(5), f64_from(7), f64_from(11));
var se_r = se3_transform_point(se_gi, se_p);
assert(f64_lt(f64_abs(f64_sub(HVec3_x(se_r), HVec3_x(se_p))), LOOSE_TOL_M) == 1,
  "se3: (g * g^-1) fixes a point, x");
assert(f64_lt(f64_abs(f64_sub(HVec3_z(se_r), HVec3_z(se_p))), LOOSE_TOL_M) == 1,
  "se3: (g * g^-1) fixes a point, z");
# Identity transform moves nothing.
assert(f64_lt(f64_abs(f64_sub(HVec3_y(se3_transform_point(se_id, se_p)), HVec3_y(se_p))),
    LOOSE_TOL_M) == 1, "se3_identity fixes every point");
assert_neq(se3_to_mat4(se_g), 0, "se3_to_mat4 produces a Mat4");
assert_neq(se3_from_mat4(se3_to_mat4(se_g)), 0, "se3_from_mat4 round-trips");
# Both adjoints act ON something -- Ad_g(xi), not Ad(g).
#
# This assertion used to read `se3_adjoint(se_g, hvec3_unit_x()) != 0`. An
# HVec3 is 24 bytes and a twist is 48, so _twist_v read offsets 24/32/40 past
# the end of the allocation -- and a non-null check cannot see that, because
# alloc() never returns 0 on success. Build the twist with se3_twist_new, added
# in 2.8.x precisely because there was no exported way to build one at all.
#
# Closed form, from the textbook Ad_{(R,t)} = [[R, 0], [[t]_x R, R]]:
# g = (rotation of pi/2 about z, t = (1,2,3)) and xi = [omega = e_x, v = e_y]
# give R omega = e_y, R v = -e_x, t x (R omega) = (-3, 0, 1), hence
# Ad_g(xi) = [ (0, 1, 0), (-4, 0, 1) ].
var se_xi = se3_twist_new(hvec3_unit_x(), hvec3_unit_y());
var se_ad = se3_adjoint(se_g, se_xi);
assert_neq(se_ad, 0, "se3_adjoint acts on a twist");
var se_ad_w = se3_twist_omega(se_ad);
var se_ad_v = se3_twist_v(se_ad);
assert(f64_lt(f64_abs(HVec3_x(se_ad_w)), LOOSE_TOL_M) == 1, "se3_adjoint: Ad omega_x = 0");
assert(f64_lt(f64_abs(f64_sub(HVec3_y(se_ad_w), F64_ONE)), LOOSE_TOL_M) == 1,
  "se3_adjoint: Ad omega_y = 1");
assert(f64_lt(f64_abs(HVec3_z(se_ad_w)), LOOSE_TOL_M) == 1, "se3_adjoint: Ad omega_z = 0");
assert(f64_lt(f64_abs(f64_add(HVec3_x(se_ad_v), f64_from(4))), LOOSE_TOL_M) == 1,
  "se3_adjoint: Ad v_x = -4 (the [t]_x R omega term)");
assert(f64_lt(f64_abs(HVec3_y(se_ad_v)), LOOSE_TOL_M) == 1, "se3_adjoint: Ad v_y = 0");
assert(f64_lt(f64_abs(f64_sub(HVec3_z(se_ad_v), F64_ONE)), LOOSE_TOL_M) == 1,
  "se3_adjoint: Ad v_z = 1");

# The DEFINING identity: exp(Ad_g xi) == g exp(xi) g^-1. It couples the adjoint
# to se3_exp / se3_compose / se3_inverse, so an internally tidy but wrong
# adjoint -- R^T where R belongs, or the [t]_x term attached to the angular
# half -- cannot satisfy it. Compared by the action on four points.
var se_lhs = se3_exp(se_ad);
var se_rhs = se3_compose(se3_compose(se_g, se3_exp(se_xi)), se3_inverse(se_g));
assert_eq(_se_same(se_lhs, se_rhs), 1, "se3: exp(Ad_g xi) == g exp(xi) g^-1");

# Ad is linear in the twist: Ad_g(2 xi) == 2 Ad_g(xi) on all six components.
var se_xi2 = se3_twist_new(hvec3_scale(hvec3_unit_x(), F64_TWO),
  hvec3_scale(hvec3_unit_y(), F64_TWO));
var se_ad2 = se3_adjoint(se_g, se_xi2);
var se_lin = 0;
for (var se_i = 0; se_i < 6; se_i = se_i + 1) {
    if (f64_lt(f64_abs(f64_sub(_vec6_get(se_ad2, se_i),
            f64_mul(F64_TWO, _vec6_get(se_ad, se_i)))), LOOSE_TOL_M) == 0) {
        se_lin = se_lin + 1;
    }
}
assert_eq(se_lin, 0, "se3_adjoint is linear in the twist (all 6 components)");

# Null guards. A pointer carries no length in Cyrius, so these are the only
# validations se3_adjoint can perform -- the 48-vs-24 byte mistake is closed by
# se3_twist_new being the way you build a twist, not by a check in here.
assert_eq(se3_adjoint(0, se_xi), 0, "se3_adjoint rejects a null group element");
assert_eq(se3_adjoint(se_g, 0), 0, "se3_adjoint rejects a null twist");
assert_eq(se3_twist_new(0, hvec3_unit_x()), 0, "se3_twist_new rejects a null omega");
assert_eq(se3_twist_new(hvec3_unit_x(), 0), 0, "se3_twist_new rejects a null v");
assert_eq(se3_twist_omega(0), 0, "se3_twist_omega rejects null");
assert_eq(se3_twist_v(0), 0, "se3_twist_v rejects null");

assert_neq(su2_adjoint(su2_identity(), hvec3_unit_x()), 0, "su2_adjoint acts on a vector");

# --- BCH on so(3). ⛔ 3.1.0: THIS FIXTURE USED TO PASS 24-BYTE HVec3 VALUES
# INTO FUNCTIONS THAT READ 72-BYTE Mat3 OPERANDS -- a 48-byte out-of-bounds
# read per operand -- and then asserted HVec3_x of the returned Mat3, i.e. its
# [0][0] entry, which is identically 0 for any skew matrix. It "passed" only
# because the operands were not skew at all: the over-read bytes were the
# neighbouring allocations (mostly zero), so each "matrix" carried its x
# component in slot [0][0] and 0.5 + 1 = 1.5 fell out of arithmetic on garbage.
# The same shape lie_ext.cyr records for se3_adjoint in 2.8.2. Found by the
# 3.1.0 public-surface review. The operands are now what the functions
# document: X = hat(u), Y = hat(v) with [hat(u), hat(v)] = hat(u x v).
fn _t_hat3(x, y, z) {
    var m = m3_new();
    m3_set(m, 1, 0, f64_neg(z)); m3_set(m, 2, 0, y);
    m3_set(m, 0, 1, z);          m3_set(m, 2, 1, f64_neg(x));
    m3_set(m, 0, 2, f64_neg(y)); m3_set(m, 1, 2, x);
    return m;
}
# vee: read the axis back, and check the result is actually skew-symmetric.
fn _t_vee_x(m) { return m3_get(m, 1, 2); }
fn _t_vee_y(m) { return m3_get(m, 2, 0); }
fn _t_vee_z(m) { return m3_get(m, 0, 1); }
fn _t_is_skew(m) {
    if (f64_eq(m3_get(m, 0, 0), 0) == 0 || f64_eq(m3_get(m, 1, 1), 0) == 0 ||
      f64_eq(m3_get(m, 2, 2), 0) == 0) { return 0; }
    if (f64_eq(m3_get(m, 1, 0), f64_neg(m3_get(m, 0, 1))) == 0) { return 0; }
    if (f64_eq(m3_get(m, 2, 0), f64_neg(m3_get(m, 0, 2))) == 0) { return 0; }
    if (f64_eq(m3_get(m, 2, 1), f64_neg(m3_get(m, 1, 2))) == 0) { return 0; }
    return 1;
}
# Commuting: X = hat(0.5 e_x), Y = hat(e_x). Every bracket is exactly 0, so both
# orders return exactly hat(1.5 e_x) -- bit-exact, no tolerance.
var bch_cx = _t_hat3(F64_HALF, 0, 0);
var bch_cy = _t_hat3(F64_ONE, 0, 0);
var bch_c2 = bch_so3_2nd_order(bch_cx, bch_cy);
var bch_c3 = bch_so3_3rd_order(bch_cx, bch_cy);
assert_eq(_t_is_skew(bch_c2), 1, "bch_so3_2nd_order returns a skew matrix");
assert_eq(_t_vee_x(bch_c2), f64_add(F64_HALF, F64_ONE), "bch_so3_2nd_order commuting: exactly 1.5 e_x");
assert_eq(_t_vee_y(bch_c2), 0, "bch_so3_2nd_order commuting: no y");
assert_eq(_t_vee_z(bch_c2), 0, "bch_so3_2nd_order commuting: no z");
assert_eq(_t_vee_x(bch_c3), f64_add(F64_HALF, F64_ONE), "bch_so3_3rd_order commuting: exactly 1.5 e_x");
assert_eq(_t_is_skew(bch_c3), 1, "bch_so3_3rd_order returns a skew matrix");
# Non-commuting: X = hat(a e_x), Y = hat(b e_y), a = 1/2, b = 1.
#   [X,Y]       = hat(a b e_z)            2nd order: Z = hat(a, b, ab/2)
#   [X,[X,Y]]   = hat(-a^2 b e_y)         3rd order adds (1/12)([X,[X,Y]] - [Y,[X,Y]])
#   [Y,[X,Y]]   = hat( a b^2 e_x)                   = hat(-ab^2/12, -a^2b/12, 0)
# so Z3 = hat(a - ab^2/12, b - a^2 b/12, ab/2) = hat(11/24, 47/48, 1/4).
# A wrong bracket sign or a dropped term moves an entry by >= 1/48; ULP_TOL_M
# (~1e-15) is the rounding of the 1/12 products, five orders below that.
var bch_nx = _t_hat3(F64_HALF, 0, 0);
var bch_ny = _t_hat3(0, F64_ONE, 0);
var bch_n2 = bch_so3_2nd_order(bch_nx, bch_ny);
assert_eq(_t_is_skew(bch_n2), 1, "bch_so3_2nd_order non-commuting: skew");
assert_eq(_t_vee_x(bch_n2), F64_HALF, "bch_so3_2nd_order non-commuting: x = a exactly");
assert_eq(_t_vee_y(bch_n2), F64_ONE, "bch_so3_2nd_order non-commuting: y = b exactly");
assert_eq(_t_vee_z(bch_n2), f64_div(F64_ONE, f64_from(4)), "bch_so3_2nd_order non-commuting: z = ab/2 = 1/4 exactly");
var bch_n3 = bch_so3_3rd_order(bch_nx, bch_ny);
assert_eq(_t_is_skew(bch_n3), 1, "bch_so3_3rd_order non-commuting: skew");
assert(f64_lt(f64_abs(f64_sub(_t_vee_x(bch_n3), f64_div(f64_from(11), f64_from(24)))), ULP_TOL_M) == 1,
  "bch_so3_3rd_order non-commuting: x = a - ab^2/12 = 11/24");
assert(f64_lt(f64_abs(f64_sub(_t_vee_y(bch_n3), f64_div(f64_from(47), f64_from(48)))), ULP_TOL_M) == 1,
  "bch_so3_3rd_order non-commuting: y = b - a^2 b/12 = 47/48");
assert_eq(_t_vee_z(bch_n3), f64_div(F64_ONE, f64_from(4)), "bch_so3_3rd_order non-commuting: z unchanged at 1/4");

# --- num_ext: exact integer answers.
var ng_x = alloc(8);
var ng_y = alloc(8);
assert_eq(num_extended_gcd(240, 46, ng_x, ng_y), 2, "extended_gcd(240, 46) = 2");
# Bezout: 240x + 46y must equal the gcd.
assert_eq(240 * load64(ng_x) + 46 * load64(ng_y), 2, "extended_gcd satisfies Bezout");
assert_eq(num_modinv(3, 11), 4, "modinv(3, 11) = 4 since 3*4 = 12 = 1 mod 11");
assert_eq(num_euler_totient(36), 12, "phi(36) = 12");
assert_eq(num_euler_totient(13), 12, "phi(prime 13) = 12");
# sigma_0(28) = number of divisors = 6; sigma_1(28) = 56 (28 is perfect).
assert_eq(num_divisor_sigma(28, 0), 6, "sigma_0(28) = 6 divisors");
assert_eq(num_divisor_sigma(28, 1), 56, "sigma_1(28) = 56 (28 is perfect)");
# CRT: x = 2 mod 3, 3 mod 5, 2 mod 7 -> 23 mod 105.
# VECS, not raw buffers -- num_crt reads them with vec_get. Passing alloc()
# blocks here SIGSEGVs, which is how this assertion was first written.
var nc_r = vec_new();
vec_push(nc_r, 2); vec_push(nc_r, 3); vec_push(nc_r, 2);
var nc_m = vec_new();
vec_push(nc_m, 3); vec_push(nc_m, 5); vec_push(nc_m, 7);
var nc_x = alloc(8);
var nc_mod = alloc(8);
var _rq98t, _rq98v = num_crt(nc_r, nc_m, 3, nc_x, nc_mod);
assert_eq(is_ok(_rq98t), 1, "num_crt succeeds");
assert_eq(load64(nc_x), 23, "CRT solution is 23");
assert_eq(load64(nc_mod), 105, "CRT modulus is 105");
# Factorisation of 84 = 2^2 * 3 * 7 -> 4 prime factors with multiplicity.
var nf = num_factorize(84);
assert_neq(nf, 0, "num_factorize returns factors");
assert_eq(vec_len(nf), 4, "84 = 2*2*3*7 is 4 factors with multiplicity");
# 3.2.0: the ASCENDING order is asserted, not just the count. It never was --
# the sort moved from a hand-rolled insertion sort onto stdlib `vec_sort_by`
# and nothing in the suites could have seen the difference either way.
# ⚠ A fixture of small primes cannot see the sort at all: trial division up to
# 37 emits its factors ascending by construction, so 84 is ordered BEFORE the
# sort runs and a "delete the sort" mutant passes it (measured: it did). Only
# the Pollard-rho phase emits out of order -- 41 * 43 comes back (43, 41) raw
# -- so the load-bearing pins are below, one per introsort regime: 2 factors
# hits the insertion cutoff, 18 factors (cutoff 16) runs a quicksort partition.
# [measured: probe with the sort call commented out, cycc 6.6.4, 2026-09-14]
assert_eq(vec_get(nf, 0), 2, "num_factorize(84)[0] == 2");
assert_eq(vec_get(nf, 1), 2, "num_factorize(84)[1] == 2");
assert_eq(vec_get(nf, 2), 3, "num_factorize(84)[2] == 3");
assert_eq(vec_get(nf, 3), 7, "num_factorize(84)[3] == 7");
var nf2 = num_factorize(1763);
assert_eq(vec_len(nf2), 2, "num_factorize(1763 = 41*43): 2 factors");
assert_eq(vec_get(nf2, 0), 41, "num_factorize(1763)[0] == 41 (rho emitted 43 first)");
assert_eq(vec_get(nf2, 1), 43, "num_factorize(1763)[1] == 43");
# 2^9 * 41*43*47*53*59*61*67*71*73 = 2810178190898988544 -> 18 factors; the
# rho phase emits the nine large primes as 43 53 41 59 73 47 67 61 71.
var nf18 = num_factorize(2810178190898988544);
assert_eq(vec_len(nf18), 18, "num_factorize(2^9 * nine primes > 37): 18 factors with multiplicity");
var nf18_want = vec_new();
for (var nfi = 0; nfi < 9; nfi = nfi + 1) { vec_push(nf18_want, 2); }
vec_push(nf18_want, 41); vec_push(nf18_want, 43); vec_push(nf18_want, 47); vec_push(nf18_want, 53);
vec_push(nf18_want, 59); vec_push(nf18_want, 61); vec_push(nf18_want, 67); vec_push(nf18_want, 71);
vec_push(nf18_want, 73);
var nf18_bad = 0;
for (var nfj = 0; nfj < 18; nfj = nfj + 1) {
    if (vec_get(nf18, nfj) != vec_get(nf18_want, nfj)) { nf18_bad = nf18_bad + 1; }
}
assert_eq(nf18_bad, 0, "num_factorize(2^9 * nine primes) is 2 x9 then 41..73 ascending (quicksort regime)");
# Pollard rho must return a non-trivial divisor of a composite.
var npr = num_pollard_rho(8051);
assert(npr > 1, "pollard_rho(8051) returns a factor > 1");
assert_eq(8051 % npr, 0, "pollard_rho returns a real divisor");
# Halton is deterministic and lies in [0,1).
var nh = num_halton(1, 2);
assert_eq(nh, F64_HALF, "halton(1, base 2) = 1/2 exactly");
assert(f64_lt(num_halton(5, 3), F64_ONE) == 1, "halton stays below 1");
var nhx = alloc(8);
var nhy = alloc(8);
var _r14t, _r14v = num_halton_2d(3, nhx, nhy);
assert(f64_lt(load64(nhx), F64_ONE) == 1, "halton_2d x in [0,1)");
assert_neq(load64(nhx), load64(nhy), "halton_2d uses different bases per axis");

test_group("3.3.0 number theory above 2^62");
# ⛔ `_num_mulmod` formed `(a + a) % m` and `(result + a) % m`, which wrap once
# m > 2^62, and every caller turned that into a SILENT wrong answer: num_modpow
# returned 0 for 2^61, num_is_prime called two primes composite, num_crt returned Ok
# with a negative modulus product, and num_pollard_rho NEVER RETURNED on a semiprime
# above 2^62 (killed after 120 s; 75 ms now). Expected values are exact, from
# Python's arbitrary-precision arithmetic. Against the 3.2.2 num.cyr/num_ext.cyr:
# both num_modpow values were 0, both primes read composite, the CRT with
# M = 3037000493 * 3037000453 returned Ok with x = 4792163105077547874, the
# overflowing product returned Ok, and Pollard rho hung. The composite, the
# negative-modulus refusal and the negative remainder were already right -- they
# are the controls. `num_mulmod` is new public API, so it has no "before".
# [measured: scratch probe against the 3.2.2 num.cyr/num_ext.cyr, 2026-09-30]
var nt_m63 = 0x7FFF_FFFF_FFFF_FFFF;    # 2^63 - 1
var nt_p63 = 0x7FFF_FFFF_FFFF_FFE7;    # 2^63 - 25, the largest prime below 2^63
var _nt1t, _nt1v = num_modpow(0x4000_0000_0000_0000, 2, nt_m63);
assert_eq(_nt1v, 0x2000_0000_0000_0000, "num_modpow(2^62, 2, 2^63-1) = 2^61 (was 0)");
var _nt2t, _nt2v = num_modpow(3, nt_p63 - 1, nt_p63);
assert_eq(_nt2v, 1, "num_modpow(3, p-1, p) = 1 for p = 2^63-25, Fermat (was 0)");
assert_eq(num_is_prime(nt_p63), 1, "num_is_prime(2^63-25) = 1 (was reported composite)");
assert_eq(num_is_prime(0x4000_0000_0000_0087), 1, "num_is_prime(2^62+135) = 1 (was reported composite)");
var nt_pq = 9223371873002223329;       # 3037000493 * 3037000453, above 2^62
assert_eq(num_is_prime(nt_pq), 0, "num_is_prime(3037000493 * 3037000453) = 0 (control: composite)");
var nt_f = num_pollard_rho(nt_pq);
assert_eq(nt_f == 3037000493 || nt_f == 3037000453, 1,
  "num_pollard_rho factors a semiprime above 2^62 (it never returned before)");
# num_mulmod, promoted from `_num_mulmod`: exact at the top of the range, a negative
# operand contributes its residue, and a modulus <= 0 is an Err (the unchecked
# helper divided by it).
var _nt3t, _nt3v = num_mulmod(nt_m63 - 1, nt_m63 - 1, nt_m63);
assert_eq(_nt3v, 1, "num_mulmod(m-1, m-1, m) = 1 for m = 2^63-1");
var _nt4t, _nt4v = num_mulmod(0 - 7, 3, nt_m63);
assert_eq(_nt4v, nt_m63 - 21, "num_mulmod(-7, 3, m) = m - 21: a negative operand gives its residue");
var _nt5t, _nt5v = num_mulmod(3, 4, 0);
assert_eq(_nt5v, HSB_ERR_DIVISION_BY_ZERO, "num_mulmod(3, 4, 0) -> HSB_ERR_DIVISION_BY_ZERO");
var _nt6t, _nt6v = num_mulmod(3, 4, 0 - 5);
assert_eq(_nt6v, HSB_ERR_INVALID_INPUT, "num_mulmod(3, 4, -5) -> HSB_ERR_INVALID_INPUT");
# The direct-product fast path ends at m = 3037000500, the last modulus whose largest
# residue still squares inside i64; one past it (m-1)^2 overflows. It must be the
# SQUARE: (m-1)(m-2) at m = 3037000501 still fits, and a fixture built on it let a
# fast path one modulus too wide survive. (m-1)^2 is 1 mod m; the wrapped product
# reads -2746052118. [measured: mutant `m <= 3037000501` against both fixtures]
var _ntat, _ntav = num_mulmod(3037000499, 3037000499, 3037000500);
assert_eq(_ntav, 1, "num_mulmod at the last direct-product modulus 3037000500");
var _ntbt, _ntbv = num_mulmod(3037000500, 3037000500, 3037000501);
assert_eq(_ntbv, 1, "num_mulmod one past the direct-product modulus, 3037000501");
# The doubling loop with `%` is exact up to m = 2^62, where two residues sum to at
# most 2^63 - 2; at 2^62 + 1 the residue 2^62 doubles to 2^63 and wraps. Both are
# squares of -1, so both are 1.
var _ntct, _ntcv = num_mulmod(0x3FFF_FFFF_FFFF_FFFF, 0x3FFF_FFFF_FFFF_FFFF, 0x4000_0000_0000_0000);
assert_eq(_ntcv, 1, "num_mulmod at the last doubling-loop modulus, 2^62");
var _ntdt, _ntdv = num_mulmod(0x4000_0000_0000_0000, 0x4000_0000_0000_0000, 0x4000_0000_0000_0001);
assert_eq(_ntdv, 1, "num_mulmod one past the doubling-loop modulus, 2^62 + 1");
# num_crt: a modulus product between 2^62 and 2^63 is exact; one that does not fit,
# or a non-positive modulus, is refused instead of returning Ok with garbage.
var ntr = vec_new();
var ntm = vec_new();
vec_push(ntr, 1234567);
vec_push(ntm, 3037000493);
vec_push(ntr, 7654321);
vec_push(ntm, 3037000453);
var ntx = alloc(8);
var ntmm = alloc(8);
var _nt7t, _nt7v = num_crt(ntr, ntm, 2, ntx, ntmm);
assert_eq(load64(ntx), 5073341950054030866, "num_crt with M = 3037000493 * 3037000453 is exact");
var ntr3 = vec_new();
var ntm3 = vec_new();
vec_push(ntr3, 1);
vec_push(ntm3, 4194301);
vec_push(ntr3, 2);
vec_push(ntm3, 4194287);
vec_push(ntr3, 3);
vec_push(ntm3, 4194277);
var _nt8t, _nt8v = num_crt(ntr3, ntm3, 3, ntx, ntmm);
assert_eq(is_err_result(_nt8t), 1, "num_crt: moduli whose product exceeds 2^63 -> Err (was Ok, M < 0)");
var ntr4 = vec_new();
var ntm4 = vec_new();
vec_push(ntr4, 1);
vec_push(ntm4, 0 - 5);
var _nt9t, _nt9v = num_crt(ntr4, ntm4, 1, ntx, ntmm);
assert_eq(is_err_result(_nt9t), 1, "num_crt: a negative modulus -> Err");
# control: a negative remainder still solves (x = -1 mod 5, x = 2 mod 7 -> 9)
var ntr5 = vec_new();
var ntm5 = vec_new();
vec_push(ntr5, 0 - 1);
vec_push(ntm5, 5);
vec_push(ntr5, 2);
vec_push(ntm5, 7);
var _nt10t, _nt10v = num_crt(ntr5, ntm5, 2, ntx, ntmm);
assert_eq(load64(ntx), 9, "num_crt: a negative remainder contributes its residue (control)");
# num_crt returns x in [0, M) for negative remainders at ANY modulus size. 3.2.2
# returned the same congruence class as a negative x: (-1, 0) mod (5, 7) gave -21.
var ntr6 = vec_new();
var ntm6 = vec_new();
vec_push(ntr6, 0 - 1);
vec_push(ntm6, 5);
vec_push(ntr6, 0);
vec_push(ntm6, 7);
var _nt11t, _nt11v = num_crt(ntr6, ntm6, 2, ntx, ntmm);
assert_eq(load64(ntx), 14, "num_crt: (-1, 0) mod (5, 7) -> 14 in [0, 35) (3.2.2 returned -21)");
# ⛔ The review after 3.3.0's first draft found the same wrap in two functions the
# release had not touched. num_modinv normalised with `(x % m) + m`, which wraps above
# 2^62, so it returned a negative non-inverse, or -1 ("not invertible") for 1 mod
# 2^63-1, and that -1 made num_crt refuse a single congruence modulo 2^63 - 1.
# num_divisor_sigma looped on `d * d <= n`: 2^63 - 1 never returned. It now works
# from the factorization. Exact values from Python.
# [measured: review probes against the 3.2.2 and 3.3.0 trees, not reproducible in-tree]
assert_eq(num_modinv(5, nt_m63), 3689348814741910323, "num_modinv(5, 2^63-1) is the inverse (was negative)");
assert_eq(num_modinv(nt_p63 - 2, nt_p63), 4611686018427387891, "num_modinv(2^63-27, 2^63-25) is the inverse");
assert_eq(num_modinv(1, nt_m63), 1, "num_modinv(1, 2^63-1) = 1 (was -1, not invertible)");
var ntr7 = vec_new();
var ntm7 = vec_new();
vec_push(ntr7, 0 - 1);
vec_push(ntm7, nt_m63);
var _nt12t, _nt12v = num_crt(ntr7, ntm7, 1, ntx, ntmm);
assert_eq(is_ok(_nt12t), 1, "num_crt: x = -1 mod 2^63-1 is solvable (was refused)");
assert_eq(load64(ntx), nt_m63 - 1, "num_crt: x = -1 mod 2^63-1 -> 2^63 - 2");
assert_eq(num_divisor_sigma(nt_m63, 0), 96, "num_divisor_sigma(2^63-1, 0) = 96 (never returned)");
assert_eq(num_divisor_sigma(9223372033000000000, 0), 400, "num_divisor_sigma(9223372033e9, 0) = 400 (was 440)");
assert_eq(num_divisor_sigma(9223372030926248999, 0), 16,
  "num_divisor_sigma just below 3037000499^2 = 16 (control: right before)");
assert_eq(num_divisor_sigma(12, 1), 28, "num_divisor_sigma(12, 1) = 28 (control)");
assert_eq(num_divisor_sigma(0 - 12, 0), 0, "num_divisor_sigma(-12, 0) = 0, as before (control)");

# === 3.3.3 G3: num_divisor_sigma refuses i64 overflow ===
test_group("3.3.3 G3: num_divisor_sigma refuses i64 overflow");
# Through 3.3.2 every product and sum was unchecked, so sigma_k(n) wrapped for k >= 1,
# often to a POSITIVE number. Overflow now returns the designed 0, which sigma_k(n)
# never equals for n >= 1. Each of the four checks (p^k, each power p^(jk), the
# running sum, the product over primes) is asserted at its boundary: a fitting input
# where the check meets its bound with equality or with the largest fitting power,
# and an overflowing input with the smallest excess that reaches it. Every true
# value is from a python3 big-int oracle over the factorization (each factor
# Miller-Rabin prime); the 3.3.2 value, from a probe of the shipped bundle, is in
# each message.
# [measured: scratch probe against dist/hisab.cyr 3.3.2 and python3 big-int oracle, 2026-10-01]
# The roadmap's two named wraps, and sigma_64(2), which wraps to a positive 1.
assert_eq(num_divisor_sigma(3 * 0x2000_0000_0000_0000, 1), 0,
  "sigma_1(3 * 2^61) = 2^64 - 4 overflows -> 0 (3.3.2: -4)");
assert_eq(num_divisor_sigma(720720, 4), 0, "sigma_4(720720) ~ 2.9e23 overflows -> 0 (3.3.2: +5519468047519493040)");
assert_eq(num_divisor_sigma(2, 64), 0, "sigma_64(2) = 2^64 + 1 overflows -> 0 (3.3.2: +1)");
assert_eq(num_divisor_sigma(720720, 3), 449671560269920128, "sigma_3(720720) fits and is exact (control)");
# p^k. Fits: 2^62 is the largest power of 2 in i64. Overflows: 2^63 is 2^63 - 1 + 1.
assert_eq(num_divisor_sigma(2, 62), 0x4000_0000_0000_0001, "sigma_62(2) = 2^62 + 1 (p^k = 2^62 fits)");
assert_eq(num_divisor_sigma(2, 63), 0, "sigma_63(2): p^k = 2^63 overflows by 1 -> 0 (3.3.2: -(2^63 - 1))");
assert_eq(num_divisor_sigma(3, 39), 4052555153018976268, "sigma_39(3) = 3^39 + 1 (p^k = 3^39 fits)");
assert_eq(num_divisor_sigma(3, 40), 0, "sigma_40(3): 3^40 overflows -> 0 (3.3.2: -6289078614652622814)");
# p^(jk). Overflows: (2^3)^21 = 2^63. Fits: (2^3)^20 = 2^60, and (2^2)^31 = 2^62.
assert_eq(num_divisor_sigma(0x10_0000, 3), 1317624576693539401, "sigma_3(2^20) = (2^63 - 1) / 7 (power 2^60 fits)");
assert_eq(num_divisor_sigma(0x20_0000, 3), 0,
  "sigma_3(2^21): the power 2^63 overflows by 1 -> 0 (3.3.2: -7905747460161236407)");
assert_eq(num_divisor_sigma(0x8000_0000, 2), 6148914691236517205, "sigma_2(2^31) = (2^64 - 1) / 3 (power 2^62 fits)");
# The power 2^63 above wraps to -2^63, and the sum check then refuses it by accident
# (2^63 - 1 - term wraps too), so that fixture cannot see the power check alone. Here
# the power (2^2)^32 = 2^64 wraps to exactly 0, every later check passes, and 3.3.2
# returned sigma_2(2^31)'s value for sigma_2(2^32): a positive wrap.
# [measured: scratch mutant, power check deleted: modules 2357 passed, 1 failed (this line), 2026-10-01]
assert_eq(num_divisor_sigma(0x1_0000_0000, 2), 0,
  "sigma_2(2^32) = (2^66 - 1) / 3 overflows -> 0 (3.3.2: +6148914691236517205)");
# The running sum. Fits with equality: sigma_1(2^62) = 2^63 - 1 exactly, the last step
# compares 2^62 - 1 against 2^63 - 1 - 2^62. Overflows: 5^27 and 13^17 are the only
# inputs where the last power fits and the sum does not; 5^27 has the smaller excess.
# Both sums wrap negative, which the product check refuses as well, so deleting the
# sum check is an equivalent mutant (recorded in src/num_ext.cyr).
assert_eq(num_divisor_sigma(0x4000_0000_0000_0000, 1), 0x7FFF_FFFF_FFFF_FFFF,
  "sigma_1(2^62) = 2^63 - 1 exactly (the sum check at equality)");
assert_eq(num_divisor_sigma(7450580596923828125, 1), 0,
  "sigma_1(5^27): the sum overflows by 8.99e16 -> 0 (3.3.2: -9133518327554766460)");
assert_eq(num_divisor_sigma(8650415919381337933, 1), 0,
  "sigma_1(13^17): the sum overflows -> 0 (3.3.2: -9075460161046435522)");
# The product over primes. Fits with equality: for 3 * 2^60 the running product
# 2^61 - 1 equals (2^63 - 1) / 4 when the factor 4 = sigma_1(3) is applied.
# Overflows by exactly 1: sigma_1(3 * (2^61 - 1)) = 4 * 2^61 = 2^63.
assert_eq(num_divisor_sigma(3 * 0x1000_0000_0000_0000, 1), 0x7FFF_FFFF_FFFF_FFFC,
  "sigma_1(3 * 2^60) = 2^63 - 4 (the product check at equality)");
assert_eq(num_divisor_sigma(3 * 0x1FFF_FFFF_FFFF_FFFF, 1), 0,
  "sigma_1(3 * (2^61 - 1)) = 2^63 overflows by 1 -> 0 (3.3.2: -2^63)");
# Every check at equality at once: for the prime p = 2^63 - 25, p^1 compares 1 with
# (2^63 - 1) / p = 1, the power does the same, and the product compares 1 with
# (2^63 - 1) / (p + 1) = 1. A `>=` in any of the three would refuse this.
assert_eq(num_divisor_sigma(nt_p63, 1), nt_p63 + 1, "sigma_1(2^63 - 25) = 2^63 - 24 (three checks at equality)");
assert_eq(num_divisor_sigma(nt_p63, 2), 0, "sigma_2(2^63 - 25): p^2 overflows -> 0 (3.3.2: +626)");

# === 3.3.3 R4num: num_divisor_sigma's bounds, each at a positive wrap ===
test_group("3.3.3 R4num: num_divisor_sigma's bounds, each at a positive wrap");
# The overflowing fixtures above cannot tell a check's derived bound from a wrong one.
# Under each of three wrong bounds, every one of them either still meets a bound that
# refuses it (base 2, where MAX / 2 is MAX / base, for one) or wraps NEGATIVE at its
# first overflowing step, which a later check then refuses by accident. So the three
# passed every suite: a sign test after the product instead of the bound before it,
# MAX / p for MAX / pk in the power check, and MAX / 2 for MAX / base in
# _numx_int_pow. Each fixture below overflows in the named check, at a step that
# wraps to a non-negative value no later check can see, and is refused only by the
# right bound there; the wrong bound's return is in the message.
# Truths and wraps: python3 big ints; each wrong bound was run as a scratch mutant,
# and a wrapping-i64 model of all three over every fixture here gives the reasons.
# [measured: scratch mutants of src/num_ext.cyr and python3 big-int oracle, 2026-10-01]
assert_eq(num_divisor_sigma(6, 26), 0,
  "sigma_26(6) = 170581730721511145450 overflows in the product -> 0 (a sign test after it: +4561034058125180906)");
assert_eq(num_divisor_sigma(0x10000, 4), 0,
  "sigma_4(2^16) = 19676527011956855057 overflows at the power 16^16 -> 0 (MAX / p: +1229782938247303441)");
assert_eq(num_divisor_sigma(7, 23), 0,
  "sigma_23(7) = 7^23 + 1 overflows in p^k -> 0 (MAX / 2 in _numx_int_pow: +8922003266371364728)");

test_group("3.3.0 the promoted helpers, called as API");
# Five names became public API in 3.3.0 and every existing caller was internal, so
# `cyrius coverage` listed all five as unreferenced. These call each one the way a
# consumer would, against values fixed by its contract. (noise_perm is tested in
# tests/edge_cases.tcyr, the one suite where it is the first touch of the table.)
assert_eq(num_is_pow2(1), 1, "num_is_pow2(1) = 1: 2^0 is a power of two");
assert_eq(num_is_pow2(1024), 1, "num_is_pow2(1024) = 1");
assert_eq(num_is_pow2(0x4000_0000_0000_0000), 1, "num_is_pow2(2^62) = 1");
assert_eq(num_is_pow2(0), 0, "num_is_pow2(0) = 0");
assert_eq(num_is_pow2(6), 0, "num_is_pow2(6) = 0");
assert_eq(num_is_pow2(0 - 4), 0, "num_is_pow2(-4) = 0: no negative number is a power of two");
# sym_const_eq is ABSOLUTE: 5e-16 apart is equal, 2e-15 apart is not, and two
# ADJACENT doubles at 1e18 (128 apart) are not equal either.
assert_eq(sym_const_eq(F64_ONE, F64_ONE), 1, "sym_const_eq(1, 1) = 1");
assert_eq(sym_const_eq(0, f64_div(F64_ONE, f64_from(2000000000000000))), 1,
  "sym_const_eq(0, 5e-16) = 1: inside the 1e-15 tolerance");
assert_eq(sym_const_eq(0, f64_div(F64_ONE, f64_from(500000000000000))), 0,
  "sym_const_eq(0, 2e-15) = 0: outside it");
assert_eq(sym_const_eq(f64_from(1000000000000000000), f64_from(1000000000000000128)), 0,
  "sym_const_eq(1e18, next double) = 0: the tolerance is absolute, not in ulps");
# The tolerance IS 1e-15. Through 3.2.x and 3.3.0's first draft `_SYM_EPS` held
# 2^-50 = 8.88e-16, so 9e-16 and pred(1e-15) -- both inside the documented
# |a - b| < 1e-15 -- compared unequal.
# [measured: review probe of the shipped 3.3.0 bundle, not reproducible in-tree]
assert_eq(sym_const_eq(0, 0x3CD0_3684_7569_CD7A), 1, "sym_const_eq(0, 9e-16) = 1 (was 0: the bits held 2^-50)");
assert_eq(sym_const_eq(0, 0x3CD2_03AF_9EE7_5615), 1, "sym_const_eq(0, pred(1e-15)) = 1");
assert_eq(sym_const_eq(0, 0x3CD2_03AF_9EE7_5616), 0, "sym_const_eq(0, 1e-15) = 0: the bound is strict");
# sym_const_to_str: integral values as digits, exactly, including above 2^63 where
# f64_to saturates; anything else with 6 decimals. And it IS the text both renderers
# emit for a constant.
assert_eq(str_eq_cstr(sym_const_to_str(f64_from(42)), "42"), 1, "sym_const_to_str(42) renders 42");
assert_eq(str_eq_cstr(sym_const_to_str(f64_from(0 - 7)), "-7"), 1, "sym_const_to_str(-7) renders -7");
assert_eq(str_eq_cstr(sym_const_to_str(F64_HALF), "0.500000"), 1,
  "sym_const_to_str(0.5) renders 0.500000");
var pc_1e19 = 0x43E158E460913D00;   # 1e19, above 2^63
assert_eq(str_eq_cstr(sym_const_to_str(pc_1e19), "10000000000000000000"), 1,
  "sym_const_to_str(1e19) is exact above 2^63");
assert_eq(str_eq(sym_const_to_str(pc_1e19), expr_to_str(expr_const(pc_1e19))), 1,
  "sym_const_to_str(1e19) is expr_to_str's text for the constant");
assert_eq(str_eq(sym_const_to_str(F64_HALF), sym_to_latex(expr_const(F64_HALF))), 1,
  "sym_const_to_str(0.5) is sym_to_latex's text for the constant");
# ⛔ 3.3.2 — NEGATIVE NEAR-INTEGERS RENDERED ONE TOO HIGH. The integer test is against
# floor(val), but the digits came from f64_to(val), which truncates toward zero, so a
# value within _SYM_EPS above -n printed -(n-1): 21 doubles in (-8, 0), the two below
# among them. The positive mirror never could. (Through 3.3.2 it rendered with
# decimals, because the integer test was one-sided; 3.3.3 made it symmetric, below.)
# [measured: scratch sweep of every f64 within 1e-15 of each integer in [-12, 12], 2026-10-01]
assert_eq(str_eq_cstr(sym_const_to_str(0xBFEFFFFFFFFFFFFF), "-1"), 1,
  "sym_const_to_str(-0.9999999999999999) renders -1, not 0");
assert_eq(str_eq_cstr(sym_const_to_str(0xC01FFFFFFFFFFFFF), "-8"), 1,
  "sym_const_to_str(-7.999999999999999) renders -8, not -7");
assert_eq(str_eq(expr_to_str(expr_const(0xC017FFFFFFFFFFFF)), str_from("-6")), 1,
  "expr_to_str(-5.999999999999999) renders -6, not -5");
# ⛔ 3.3.3 — FLIPPED. 3.3.2 pinned "6.000000" here, the one-sided test's answer.
# Settled independently: 0x4017FFFFFFFFFFFF is 6 - 2^-50 exactly, |x - 6| = 8.88e-16 <
# 1e-15 (exact rational arithmetic, Python Fraction), so it is an integer value within
# _SYM_EPS like its mirror 6 + 2^-50, which has always rendered "6".
# [measured: scratch Python Fraction oracle, not reproducible in-tree, 2026-10-01]
assert_eq(str_eq_cstr(sym_const_to_str(0x4017FFFFFFFFFFFF), "6"), 1,
  "sym_const_to_str(5.999999999999999) renders 6 (3.3.2 pinned 6.000000: one-sided test)");
# === 3.3.3 G8: sym_const_to_str symmetric integer test ===
# The integer test is |val - nearest integer| < _SYM_EPS, on both sides of every integer
# and both signs; zero has no sign. Each value below sits within one or two ulps of
# where a guard decides, and every expected text was settled against an exact rational
# oracle (Python Fraction, round to nearest).
# [measured: scratch sweep, 3.3.2 bundle vs 3.3.3, 6488 f64s, exact oracle, 2026-10-01]
# Just above and just below +6 and -6 (one ulp, 8.88e-16 away):
assert_eq(str_eq_cstr(sym_const_to_str(0x4018000000000001), "6"), 1,
  "G8 sym_const_to_str(6 + 2^-50) renders 6 (above, unchanged)");
assert_eq(str_eq_cstr(sym_const_to_str(0xC018000000000001), "-6"), 1,
  "G8 sym_const_to_str(-6 - 2^-50) renders -6 (was -6.000000)");
assert_eq(str_eq_cstr(sym_const_to_str(0xC017FFFFFFFFFFFF), "-6"), 1,
  "G8 sym_const_to_str(-6 + 2^-50) renders -6");
# Two ulps (1.78e-15) is outside the tolerance on both sides: still the float path.
# [measured: scratch Python Fraction oracle, not reproducible in-tree, 2026-10-01]
assert_eq(str_eq_cstr(sym_const_to_str(0x4017FFFFFFFFFFFE), "6.000000"), 1,
  "G8 sym_const_to_str(6 - 2^-49) stays 6.000000: outside 1e-15");
assert_eq(str_eq_cstr(sym_const_to_str(0xC018000000000002), "-6.000000"), 1,
  "G8 sym_const_to_str(-6 - 2^-49) stays -6.000000: outside 1e-15");
# 0.9999999999999999 (1 - 2^-53) and 7.999999999999999 (8 - 2^-50; 8 is the last
# positive integer with a neighbouring f64 inside 1e-15):
assert_eq(str_eq_cstr(sym_const_to_str(0x3FEFFFFFFFFFFFFF), "1"), 1,
  "G8 sym_const_to_str(1 - 2^-53) renders 1 (was 1.000000)");
assert_eq(str_eq_cstr(sym_const_to_str(0x401FFFFFFFFFFFFF), "8"), 1,
  "G8 sym_const_to_str(8 - 2^-50) renders 8 (was 8.000000)");
# The nearest integer of an integer is itself. 2^52 + 1 is odd, so floor(val + 0.5) would
# not do: val + 0.5 is a tie that rounds to 2^52 + 2, |val - nearest| = 1, float path.
assert_eq(str_eq_cstr(sym_const_to_str(0x4330000000000001), "4503599627370497"), 1,
  "G8 sym_const_to_str(2^52 + 1) renders its digits");
assert_eq(str_eq_cstr(sym_const_to_str(0xC330000000000001), "-4503599627370497"), 1,
  "G8 sym_const_to_str(-(2^52 + 1)) renders its digits");
# Zero, both signs and both sides. -1e-300 rounds to -0.0, and f64_to(-0.0) is 0.
assert_eq(str_eq_cstr(sym_const_to_str(0x01A56E1FC2F8F359), "0"), 1,
  "G8 sym_const_to_str(1e-300) renders 0");
assert_eq(str_eq_cstr(sym_const_to_str(0x81A56E1FC2F8F359), "0"), 1,
  "G8 sym_const_to_str(-1e-300) renders 0 (was -0.000000)");
assert_eq(str_eq_cstr(sym_const_to_str(0), "0"), 1, "G8 sym_const_to_str(+0) renders 0");
assert_eq(str_eq_cstr(sym_const_to_str(1 << 63), "0"), 1, "G8 sym_const_to_str(-0) renders 0, not -0");
assert_eq(str_eq_cstr(sym_const_to_str(0x8000000000000001), "0"), 1,
  "G8 sym_const_to_str(-min subnormal) renders 0 (was -0.000000)");
# The tolerance is strict at its bound on the negative side too: -pred(1e-15) is in,
# -1e-15 itself is out.
assert_eq(str_eq_cstr(sym_const_to_str(0xBCD203AF9EE75615), "0"), 1,
  "G8 sym_const_to_str(-pred(1e-15)) renders 0 (was -0.000000)");
assert_eq(str_eq_cstr(sym_const_to_str(0xBCD203AF9EE75616), "-0.000000"), 1,
  "G8 sym_const_to_str(-1e-15) stays -0.000000: the bound is strict");
# expr_to_str is the same text:
assert_eq(str_eq(expr_to_str(expr_const(0x4017FFFFFFFFFFFF)), str_from("6")), 1,
  "G8 expr_to_str(6 - 2^-50) renders 6");
assert_eq(str_eq(expr_to_str(expr_const(0x81A56E1FC2F8F359)), str_from("0")), 1,
  "G8 expr_to_str(-1e-300) renders 0");
# sym_to_latex braces a constant whose TEXT starts with '-', not one whose value is
# below 0: -1e-300 is "0" with no braces (keyed on the value it would be "{0}"), and a
# sign-bit NaN, "-nan", is braced like "-inf" (keyed on the value it was bare).
assert_eq(str_eq_cstr(sym_to_latex(expr_const(0x81A56E1FC2F8F359)), "0"), 1,
  "G8 sym_to_latex(-1e-300) renders 0, no braces (was {-0.000000})");
assert_eq(str_eq_cstr(sym_to_latex(expr_const(1 << 63)), "0"), 1, "G8 sym_to_latex(-0) renders 0");
assert_eq(str_eq_cstr(sym_to_latex(expr_const(0x4017FFFFFFFFFFFF)), "6"), 1,
  "G8 sym_to_latex(6 - 2^-50) renders 6 (was 6.000000)");
assert_eq(str_eq_cstr(sym_to_latex(expr_const(0xC018000000000001)), "{-6}"), 1,
  "G8 sym_to_latex(-6 - 2^-50) renders {-6} (was {-6.000000})");
assert_eq(str_eq_cstr(sym_to_latex(expr_const(0xBCD203AF9EE75616)), "{-0.000000}"), 1,
  "G8 sym_to_latex(-1e-15) keeps its braces: the text has a minus sign");
assert_eq(str_eq_cstr(sym_to_latex(expr_const(0xFFF8000000000000)), "{-nan}"), 1,
  "G8 sym_to_latex(-nan) is braced like -inf (was bare -nan)");
assert_eq(str_eq_cstr(sym_to_latex(expr_const(0xFFF0000000000000)), "{-inf}"), 1,
  "G8 sym_to_latex(-inf) renders {-inf}");
assert_eq(str_eq_cstr(sym_to_latex(expr_const(0x7FF8000000000000)), "nan"), 1,
  "G8 sym_to_latex(+nan) renders nan, no braces");
# linalg_sort_desc: descending, by value or by |value|, carrying matrix columns (or
# rows) with it; ties keep the FIRST max and swap i <-> max_idx, so (2, 2, 4) puts the
# columns in the order (e3, e2, e1), not a stable sort's (e3, e1, e2).
var ps_v = alloc(24);
store64(ps_v, f64_from(2));
store64(ps_v + 8, f64_from(0 - 5));
store64(ps_v + 16, f64_from(4));
var ps_m = ganita_mat_new(3, 3);
ganita_mat_set(ps_m, 0, 0, F64_ONE);
ganita_mat_set(ps_m, 1, 1, F64_ONE);
ganita_mat_set(ps_m, 2, 2, F64_ONE);
var _ps1t, _ps1v = linalg_sort_desc(ps_v, 3, 1, ps_m, 3, 0, 0);
assert_eq(is_ok(_ps1t), 1, "linalg_sort_desc: a conforming call is Ok");
assert_eq(load64(ps_v), f64_from(0 - 5), "linalg_sort_desc by |v|: (2, -5, 4) -> -5 first");
assert_eq(load64(ps_v + 16), f64_from(2), "linalg_sort_desc by |v|: 2 last");
assert_eq(ganita_mat_get(ps_m, 1, 0), F64_ONE, "linalg_sort_desc: column 0 carries e2 (the -5)");
assert_eq(ganita_mat_get(ps_m, 2, 1), F64_ONE, "linalg_sort_desc: column 1 carries e3 (the 4)");
assert_eq(ganita_mat_get(ps_m, 0, 2), F64_ONE, "linalg_sort_desc: column 2 carries e1 (the 2)");
store64(ps_v, f64_from(2));
store64(ps_v + 8, f64_from(0 - 5));
store64(ps_v + 16, f64_from(4));
var _ps2t, _ps2v = linalg_sort_desc(ps_v, 3, 0, 0, 0, 0, 0);
assert_eq(load64(ps_v + 16), f64_from(0 - 5), "linalg_sort_desc by value: (2, -5, 4) -> -5 last");
store64(ps_v, f64_from(2));
store64(ps_v + 8, f64_from(2));
store64(ps_v + 16, f64_from(4));
var ps_r = ganita_mat_new(3, 3);
ganita_mat_set(ps_r, 0, 0, F64_ONE);
ganita_mat_set(ps_r, 1, 1, F64_ONE);
ganita_mat_set(ps_r, 2, 2, F64_ONE);
var _ps3t, _ps3v = linalg_sort_desc(ps_v, 3, 0, 0, 0, ps_r, 3);
assert_eq(ganita_mat_get(ps_r, 0, 2), F64_ONE, "linalg_sort_desc tie (2, 2, 4): row 0 carries e3");
assert_eq(ganita_mat_get(ps_r, 1, 1), F64_ONE, "linalg_sort_desc tie (2, 2, 4): row 1 keeps e2");
assert_eq(ganita_mat_get(ps_r, 2, 0), F64_ONE, "linalg_sort_desc tie (2, 2, 4): row 2 carries e1");
# A matrix smaller than the region it is told to swap over is refused BEFORE any
# write. Made public in 3.3.0, the first draft swapped through the unchecked
# ganita_mat_set and wrote 8 bytes past a 3x2 col_mat with n = 3; the canary is the
# block allocated right after the matrix.
var ps_short = ganita_mat_new(3, 2);
var ps_canary = alloc(64);
var ps_ci = 0;
while (ps_ci < 8) { store64(ps_canary + ps_ci * 8, 0x1111_1111_1111_1111); ps_ci = ps_ci + 1; }
store64(ps_v, f64_from(1));
store64(ps_v + 8, f64_from(2));
store64(ps_v + 16, f64_from(9));
var _ps4t, _ps4v = linalg_sort_desc(ps_v, 3, 0, ps_short, 3, 0, 0);
assert_eq(is_err_result(_ps4t), 1, "linalg_sort_desc: a 3x2 col_mat for n = 3 -> Err");
var ps_clean = 1;
ps_ci = 0;
while (ps_ci < 8) {
    if (load64(ps_canary + ps_ci * 8) != 0x1111_1111_1111_1111) { ps_clean = 0; }
    ps_ci = ps_ci + 1;
}
assert_eq(ps_clean, 1, "linalg_sort_desc: nothing written past the short matrix");
assert_eq(load64(ps_v), f64_from(1), "linalg_sort_desc: a refused call leaves vals unsorted");
var _ps5t, _ps5v = linalg_sort_desc(ps_v, 3, 0, 0, 0, ps_short, 3);
assert_eq(is_err_result(_ps5t), 1, "linalg_sort_desc: a 3x2 row_mat with row_cols = 3 -> Err");
var _ps6t, _ps6v = linalg_sort_desc(0, 3, 0, 0, 0, 0, 0);
assert_eq(is_err_result(_ps6t), 1, "linalg_sort_desc: null vals with n > 0 -> Err");

var r = assert_summary();
# Clamp before exiting: assert_summary() returns the raw failure COUNT, and a wait
# status is only 8 bits — an unclamped 256 / 512 / 768 failures would exit 0 and
# score PASS. Any failure at all is exit 1.
if (r > 0) { r = 1; }
sys_exit_group(r);
