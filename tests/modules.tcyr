assert_eq(HVec3_y(_gg5_b8), 0x3FD3333333333333, "... v");
assert_eq(HVec3_z(_gg5_b8), 0x52272B7A5AD2130B, "... w, 1 ulp (3.4.0: 0xD25701139BD950EC)");
assert_eq(_gg5_code(0, 0, 0, 0x3FF4CCCCCCCCCCCD, 0x3FE6666666666666, 0x3FC999999999999A, 0xA9E999999999999A,
    0x2A1199999999999A, 0x29F999999999999A, 0x3FD8F5C28F5C28F6, 0x3FCAE147AE147AE1, 0x3FAEB851EB851EB8), 0,
  "... the thin path");
# The point 2^300 edges away (outside the range): the thin path.
