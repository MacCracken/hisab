# S4, its parts: an exactly colinear triangle whose edges round (a near 0, b and c near 1 and 2 on
# the line t (3, -7, 5)), the query 2^20 off the line. Without the line direction's rounding the
# weights are 3.2e4 ulp off, without b - a's 1 ulp more. 1.48, 0.22, 0.70 ulp (integ-snap6: 2.3e4).
# [measured: rt340 S4 fixture search (rounded-edge colinear triangles), exact Fractions, 2026-10-31]
var _r41_b4 = geo_barycentric_coords(geo_triangle_new(hvec3_new(0x3CF2600000000000, 0xBD05700000000000,
      0x3CFEA00000000000), hvec3_new(0x4008000071A5E800, 0xC01C00008496E400, 0x401400005EB4EC00),
    hvec3_new(0x40180003891C0000, 0xC02C00041FF60000, 0x40240002F2420000)), hvec3_new(0x412C000600001C69,
    0x4117FFE3FFFF7B69, 0x401400005EB4EC00));
assert_eq(HVec3_x(_r41_b4), 0x3FD5555814DA6DD3, "S4: rounded edges, the query 2^20 off the line: u, 1.48 ulp");
assert_eq(HVec3_y(_r41_b4), 0x3FD55555555591C0, "... v, 0.22 ulp");
assert_eq(HVec3_z(_r41_b4), 0x3FD5555295D0006C, "... w, 0.70 ulp");

test_group("3.4.0 second review repairs: a fixture for each, against exact rational answers");
# Each input is the second review's repro or one from its family (or this lane's), judged against
# its exact answer (Fractions) as stated; "integ-snap6" is the tree the first review read, and
# "integ-snap12" the merged tree the second review read.
# [measured: R2E repros and families (repro4.py, x_bary.py, x_offpl.py, x_len.aimed), exact Fractions, 2026-10-31]
var _r42_br = alloc(16);
fn _r42_cap(ray, sx, sy, sz, ex, ey, ez, r) {
    store64(_r42_br, 0x7FF4000000000001);
    return geo_ray_capsule_branch(ray, geo_capsule_new(hvec3_new(sx, sy, sz), hvec3_new(ex, ey, ez), r), _r42_br);
}
# N1: an exactly colinear triangle in the top binade, b 2^-1074 off the x axis and c 2^-1073: its
# minimum-norm weights, colinearity decided before the halving flushed b's and c's subnormal
# components (integ-snap12: the thin triangle's weights, (1, 0, 0) at p = a).
var _r42_m = 0x7FE0000000000000;   # 2^1023
var _r42_b1 = geo_barycentric_coords(geo_triangle_new(hvec3_new(f64_neg(_r42_m), 0, 0), hvec3_new(0, 1, 0),
    hvec3_new(_r42_m, 2, 0)), hvec3_new(f64_neg(_r42_m), 0, 0));
assert_eq(HVec3_x(_r42_b1), 0x3FEAAAAAAAAAAAAA, "N1: top-binade colinear, p = a: u = 5/6 (0.67 ulp)");
assert_eq(HVec3_y(_r42_b1), 0x3FD5555555555555, "... v = 1/3");
assert_eq(HVec3_z(_r42_b1), 0xBFC5555555555556, "... w = -1/6");
_r42_b1 = geo_barycentric_coords(geo_triangle_new(hvec3_new(f64_neg(_r42_m), 0, 0), hvec3_new(0, 1, 0),
    hvec3_new(_r42_m, 2, 0)), hvec3_new(_r42_m, 2, 0));
assert_eq(HVec3_x(_r42_b1), 0xBFC5555555555556, "N1: ... p = c: u = -1/6");
assert_eq(HVec3_z(_r42_b1), 0x3FEAAAAAAAAAAAAA, "... w = 5/6");
# (The first review's S6, completed: the same triangle with c on the axis is thin, not colinear,
# and p = b is b, (0, 1, 0) exactly; 3.3.7 and integ-snap6 read (1/3, 1/3, 1/3).)
_r42_b1 = geo_barycentric_coords(geo_triangle_new(hvec3_new(f64_neg(_r42_m), 0, 0), hvec3_new(0, 1, 0),
    hvec3_new(_r42_m, 0, 0)), hvec3_new(0, 1, 0));
assert_eq(HVec3_x(_r42_b1), 0, "S6: thin top-binade triangle, p = b: u = +0");
assert_eq(HVec3_y(_r42_b1), F64_ONE, "... v = 1");
assert_eq(HVec3_z(_r42_b1), 0, "... w = +0");
# S-b: a triangle 2^-20 thin and a query 2^15 of its heights off its plane: the cross products as
# two words, so the query's off-plane part no longer leaks through n's direction: 0.85 ulp at
# most (integ-snap6 6.9e4, 3.3.7 3.8e12).
_r42_b1 = geo_barycentric_coords(geo_triangle_new(hvec3_new(0x3FDAA5AE9F4095C4, 0x3FD0ED167A61BFAC,
      0xBFA28E4B92165A20), hvec3_new(0x3FF3D6313F2D8914, 0x3FA2222D0FF25FA0, 0xBFD02921C757FA4C),
    hvec3_new(0x4000817B5FC0EE47, 0xBFC8C912F636A24B, 0xBFDE007D50BE9D9F)), hvec3_new(0x3FF39BE8344A34DE,
    0x3FB0F119EE4288F1, 0xBFCDFD2DB7632FFB));
assert_eq(HVec3_x(_r42_b1), 0x3FB863936379AC18, "S-b: thin, the query 2^15 heights off the plane: u");
assert_eq(HVec3_y(_r42_b1), 0x3FEAD664C8B68E77, "... v");
assert_eq(HVec3_z(_r42_b1), 0x3FB0E94656D1E02F, "... w");
# N2: thin barrels 2^979 and 2^949 radii from the origin, whose counted roundings refused them and
# whose double-double fallback read 146 ulp and 5.7e8; the subnormal ray (gx 963) stays the miss.
assert_eq(_r42_cap(_r40_ray(0x80696D7B9583A540, 0x00BCDA06A0188B4C, 0x80AA4D557D66FE04, 0x3FD1FC8701A7C095,
      0xBFEE5CB1C5D3F511, 0xBFC27225C19C6242), 0xBDD56378EE8A2A38, 0x3DCFB15F02170B50, 0x3DC8CDFE90C418D8,
    0x3DD56378EE8A2A38, 0xBDCFB15F02170B50, 0xBDC8CDFE90C418D8, 0x00A61E10CB0FF950),
  0x00C60EDC5B7F71B8, "N2: gx 979, the barrel: 0.60 ulp (integ-snap12 146)");
assert_eq(load64(_r42_br), GEO_CAP_CYLINDER, "... on the barrel");
assert_eq(_r42_cap(_r40_ray(0x8165533DD5E53258, 0x01876D13912500B0, 0x81773BDE8EE492C4, 0xBFEC6E0F61E56F0D,
      0xBFD60CF3F292D78F, 0xBFD368D5EEE31E84), 0x3CAB22DF8FBE8410, 0x3CB9D4B257FA3C78, 0xBCDEF565E819C770,
    0xBCAB22DF8FBE8410, 0xBCB9D4B257FA3C78, 0x3CDEF565E819C770, 0x0185A5EC7CFC2A63),
  0x014DD851777A084E, "N2: gx 949: the exact root rounded, 0.13 ulp (s14 0.88; integ-snap12 2.1e7)");
assert_eq(_r42_cap(_r40_ray(0x80000000493066E1, 0x800000127FA90792, 0x800000071D35FB60, 0xC040CDAB4E5791C3,
      0x3F78304FCF7234BD, 0xC013310C85F0EF00), 0x3C144C0E4589E2F8, 0x3C38300D45833EB6, 0xBC3588D53F930F86,
    0xBC144C0E4589E2F8, 0xBC38300D45833EB6, 0x3C3588D53F930F86, 0x00000011A266F050),
  0, "N2: gx 963, subnormal inputs: the exact miss (integ-snap12: a hit at 5.2e-315)");
assert_eq(load64(_r42_br), GEO_FACE_NONE, "... no surface");
# N2, the bounds component by component: a needle capsule 2^-244 long met along its axis, an end
# 2^-1033 off it, so that n = u x d has a word 2^-791 under its largest. The count's worst case
# refused the barrel; its own sizes certify both roots, 1 to within 3.2e-78 ulp each.
var _r42_xb = alloc(24);
store64(_r42_xb + 16, 0);
var _r42_ndl = _r40_ray(0x8000658CE760B646, 0x3D033CB8BB63A08C, 0x90ED67B1F6329F44, 0x1420A72611EC41D3,
  0xBD033CB8BB63A08C, 0xA443961FD7B0D1AE);
var _r42_ncap = geo_capsule_new(hvec3_new(0x1420A72611EC41D3, 0x0000002AD96DCBE2, 0xA443961FD7B0D1AE),
  hvec3_new(0x1420A72611EC41D3, 0xB0C761AACE0E7612, 0xA443961FD7B0D1AE), 0x070BC525D7350BDB);
assert_eq(_geo_barrel_xact(_r42_ndl, _r42_ncap, _r42_xb), 1, "N2: the needle's barrel is solved, not refused");
assert_eq(_geo_root_ldexp(load64(_r42_xb), load64(_r42_xb + 16)), F64_ONE, "... its near root 1");
assert_eq(_geo_root_ldexp(load64(_r42_xb + 8), load64(_r42_xb + 16)), F64_ONE, "... its far root 1");
# N3: an ordinary capsule grazed (hb^2 / dc 8.9) whose exact discriminant met an offset f without
# o_perp's low part: 0.43 ulp (integ-snap12 70.4, integ-snap6 1.57).
assert_eq(_r42_cap(_r40_ray(0x45A2FC801897DA70, 0xC56D7B02E75EBB00, 0xC5E7A738CBCC5F36, 0x46003078B75EB714,
      0x4600CEF49C2A0090, 0xC5EB445FAC1E1830), 0x45D306E941E1BBB2, 0x45A0C40D53EFBB30, 0xC5DF7B0B39C0FEC8,
    0x460210780AF81FE0, 0x45FF053BC3A8D66A, 0xC5F6CABB7F43A8F6, 0x45D39E255DF90BA1),
  0x3FE4169CC2FBA2A0, "N3: a grazed ordinary barrel: 0.43 ulp (integ-snap12 70.4)");
# N4: a seam hit on the START cap only (lambda -3.3e-17), the barrel root equal to it as doubles but
# its side decided in floats: the cap's label (integ-snap12: the barrel's).
assert_eq(_r42_cap(_r40_ray(0xC009F92BC013110E, 0x403339D62CF3AB27, 0x4016173E33B0D269, 0x4005F293A50AC920,
      0xC034079CD88AA655, 0xC0129722AC993B46), 0x3FB767416E2779D0, 0xBFE7D149763AA52A, 0x3FDF3C6A9DD10874,
    0xBFE2DD75D79268AA, 0xBFDA8512A101C96C, 0xBFE03C9C38191EF0, 0x3FE6C8ADBA5ACC5E),
  F64_ONE, "N4: the seam ray: t, the exact root rounded (0.13 ulp; s14 0x3FEFFFFFFFFFFFFF, 0.74)");
assert_eq(load64(_r42_br), GEO_CAP_START_CAP, "... on the START cap, where it is hit (integ-snap12: the barrel)");
# N5: the first round's two t regressions against 3.3.7, an ordinary barrel and a grazed one:
# 1.11 and 0.82 ulp (3.3.7 1.89 and 2.19; integ-snap6 18.1 and 12.2).
assert_eq(_r42_cap(_r40_ray(0xC1D8DEA84466FB41, 0xC1D868C874DECEF8, 0xC1DE557522A04297, 0x425789D776980A55,
      0x42516770E1DE9AD2, 0x420308F45D40560D), 0xC1C8DC9A63C65D0A, 0xC1C9D222680680A8, 0xC1B46AA05BCAF19C,
    0x4254DD021645658D, 0x424EAD055E87A13F, 0x41F985EB4206B6E6, 0x41D5DE3D25F74045),
  0x3FB92A36B76F218B, "N5: well-conditioned: 1.11 ulp (integ-snap6 18.1)");
assert_eq(_r42_cap(_r40_ray(0x05C278ED64D75C16, 0x85CDFA76E6F1B39F, 0x85C0C0C92D5BA4A5, 0x85D305D7D4C77B33,
      0x05D83F843BDCA2FE, 0x05D09B832E00B830), 0x852CE5BE1CE4D0C6, 0x852EBD7DEBA61482, 0x8510A1BF3022FB2C,
    0x85C525A4FF742260, 0x05C3FFDDBAB9C373, 0x05C1D11F3AAA495B, 0x05271C5B1119752E),
  0x3FEFED22E0575405, "N5: grazed (hb^2 / dc 3.5e6): 0.82 ulp (integ-snap6 12.2)");
# S-a: the sphere ray grazing from 1.35 r whose discriminant cancels by 3.5 bits: certified in
# double-double, the same bits as the expansions (1.08 ulp; 3.3.7 1.92).
assert_eq(geo_ray_sphere(_r40_ray(0x400AA55C6F69AEC4, 0xBFF51820D07B7D00, 0x3FF1B425D326A5A4, 0xBFE578BB9C02AACA,
      0xBF92EDA03B1D2D7F, 0x3FE7B83874E2BF9A), geo_sphere_new(hvec3_new(0x3FC016190CFA8F00, 0x400524CD1CFDEA1C,
        0x400DC3B1D860066A), 0x4011F2673ED30028)), 0x40014147047D93AB, "S-a: the grazing sphere ray: 1.08 ulp");
# (A thin barrel near tangency whose double-double cannot certify (hb^2 / dc past 2^76) keeps the
# offset form r^2 - |f|^2: the exact miss; taking the declined double-double's hb^2 - a c read a hit.)
assert_eq(_r42_cap(_r40_ray(0x3E33816CAB1447F7, 0x3E34EEE91844ACDA, 0x3E241CB9BCAFC994, 0xBEAF124F0899669D,
      0xBEAD6BA6DB9501B2, 0x3EAFD95EBC426A2A), 0xBE23430B6AE9B496, 0xBE01017531BDE110, 0x3E2F5660ECE0BF44,
    0xBEC86CB25E5DA369, 0xBEC724208B7CFDF0, 0x3EC9327436746C22, 0x3C30BF35AE91583B),
  0, "S-a: a thin barrel the double-double declines: the exact miss");
# (An ordinary barrel whose classic discriminant cancels by two bits (an origin 1.3 r off the axis)
# is handed from the written-out solve (_geo_barrel_fast) to the one that forms it exactly: 0.88 ulp,
# where the written-out form, as 3.3.7, integ-snap6 and integ-snap12, read 12.1.)
assert_eq(_r42_cap(_r40_ray(0xC38A232AD99F8F86, 0xC36436FDBD6509C3, 0xC3673B357817AADE, 0x40135C9D69290770,
      0x40016E04E40ABC22, 0x3FCC614782E197C0), 0x432527BDA83961B0, 0x4339C69BFDA59DF0, 0x431B3BA813BED350,
    0xC397747EB9435075, 0xC373E854100AA1BE, 0xC37A74F9DEF41E57, 0x4342039727A65179),
  0x432B149CDCB49BB9, "S-a: a grazed ordinary barrel from 1.3 r, handed off: 0.88 ulp (integ-snap12 12.1)");
# _geo_disc_dd itself: the S-a ray's coefficients certified (1); an exactly tangent line, (0.75, 1, -2)
# along z past the sphere of radius 1.25 at 0, whose hb^2 - a c is 0 and so under any bound, declined
# (2: hb, a and c stand, the discriminant does not).
var _r42_dd = alloc(32);
assert_eq(_geo_disc_dd(hvec3_sub(hvec3_new(0x400AA55C6F69AEC4, 0xBFF51820D07B7D00, 0x3FF1B425D326A5A4),
      hvec3_new(0x3FC016190CFA8F00, 0x400524CD1CFDEA1C, 0x400DC3B1D860066A)), 0, hvec3_new(0xBFE578BB9C02AACA,
      0xBF92EDA03B1D2D7F, 0x3FE7B83874E2BF9A), 0, 0x4011F2673ED30028, _r42_dd), 1,
  "S-a: _geo_disc_dd certifies the grazing ray's discriminant");
assert_eq(_geo_disc_dd(hvec3_new(0x3FE8000000000000, F64_ONE, 0xC000000000000000), 0, hvec3_new(0, 0, F64_ONE), 0,
    0x3FF4000000000000, _r42_dd), 2, "S-a: ... and declines an exactly tangent one's (hb^2 - a c = 0)");
# (and one 2^-85 of hb^2 from tangency, (1 - 2^-53, 2^-26 - 2^-58, -2) past the unit sphere: its sign
# is sure but the bound moves the roots by more than 2^-57 of themselves, so the expansions decide.)
assert_eq(_geo_disc_dd(hvec3_new(0x3FEFFFFFFFFFFFFF, 0x3E4FFFFFFFE00000, 0xC000000000000000), 0, hvec3_new(0, 0,
      F64_ONE), 0, F64_ONE, _r42_dd), 2, "S-a: ... and one 2^-85 of hb^2 from tangency (the roots' margin)");
# (Nor where o_perp is under 2^-96 of |o - start|, its lows too coarse to hold it: an origin a few
# units of 2^-1074 off a unit capsule's axis, r 9 such units, the exact hit at 2 of them (0.26 ulp),
# where the exact discriminant from those lows read the miss.)
# [measured: R2E tE3 family (T1 at gx 1070, seed 1), exact Fractions, integ-snap12 and this tree, 2026-10-31]
assert_eq(_r42_cap(_r40_ray(0x000000000000000F, 0x0000000000000008, 0x800000000000000B, 0xC0225B9EFBCF9D16,
      0xC024C2C957392151, 0x3FFFFF92EB9F40BC), 0x3FB0F89468A6D0B0, 0x3FE374358FE5CB6E, 0xBFB8A550882780D0,
    0xBFB0F89468A6D0B0, 0xBFE374358FE5CB6E, 0x3FB8A550882780D0, 0x0000000000000009),
  0x0000000000000002, "S-a: an origin 2^-1070 off the axis: the hit at 2^-1073");
assert_eq(load64(_r42_br), GEO_CAP_CYLINDER, "... on the barrel");
# N2, the roundings' sizes: a thin barrel whose counted products are all far under 2^-1072, refused
# by the count alone and answered by the double-double fallback: the exact miss (3.3.7, integ-snap6 and
# integ-snap12: a hit at t = 1).
assert_eq(_r42_cap(_r40_ray(0x39215E3C65A64250, 0x026B455F142CD91E, 0x24B9980DF1FD0DAC, 0xBC68C7AE444D46BF,
      0x8B80B51FE0C5802A, 0xA4B9980DF1FD0DAC), 0x3B06BE76A6217BF0, 0x00000396D159D5DF, 0x8B2A3B324C287620,
    0xBC7C639A15B16B7A, 0x851721C7A2370762, 0xA0EBFA3DCE7DBEBA, 0x0B70F6CD2078CBFA),
  0, "N2: a thin barrel its counted products cannot move: the exact miss (integ-snap12: a hit)");
assert_eq(load64(_r42_br), GEO_FACE_NONE, "... no surface");

# === 3.4.0: geo_jet_capsule on a capsule with an infinite end or an invalid radius ===
test_group("3.4.0 geo_jet_capsule: the infinite-end and radius contract of geo_ray_capsule, differentiated");
# The jet follows the primal's contract (src/geo.cyr, "A capsule with an infinite end or a radius that
# is not finite and positive"). A barrel hit on a half-infinite capsule is differentiated about its
# axis line: g = p - F with its part along the axis removed, dt/do = -g / (g . d), dt/dd = t dt/do,
# dt/dr = r / (g . d), dt/dF = g / (g . d) (F the finite end), dt/d(infinite end) = 0; through
# integ-snap7 it was the miss jet. Values exact (Fractions) as stated; the analytic gradients agree
# with central differences of the exact t (h = 2^-40) to 7e-20 of their size over 3,419 checks.
# [measured: rt340 RT3 jet oracle (jor.py, jfd.py, jfam.py), exact Fractions, integ-snap7 vs this tree, 2026-10-31]
var _r41j_I = _GEO_F64_POS_INF;
fn _r41j_v(j, which) {
    if (which == 0) { return geo_jet_dorigin(j); }
    if (which == 1) { return geo_jet_ddirection(j); }
    if (which == 2) { return geo_jet_capsule_dstart(j); }
    return geo_jet_capsule_dend(j);
}
# The lane's Finding 3: start (0,0,0), end (1, 2, +Inf), r = 1, from (5, 0, 3) along -x: the barrel
# at t = 4, p = (1, 0, 3), g = (1, 0, 0), g . d = -1.
var _r41j_a = geo_jet_capsule(_r40_ray(f64_from(5), 0, f64_from(3), f64_neg(F64_ONE), 0, 0),
  geo_capsule_new(hvec3_new(0, 0, 0), hvec3_new(F64_ONE, F64_TWO, _r41j_I), F64_ONE));
assert_eq(geo_jet_kind(_r41j_a), GEO_JET_CAPSULE,
  "geo_jet_capsule: a half-infinite barrel hit is a capsule jet (integ-snap7: the miss)");
assert_eq(geo_jet_t(_r41j_a), f64_from(4), "... t = 4");
assert_eq(geo_jet_face(_r41j_a), GEO_CAP_CYLINDER, "... on the barrel");
assert_eq(HVec3_x(_r41j_v(_r41j_a, 0)), F64_ONE, "... dt/do = (1, 0, 0)");
assert_eq(HVec3_z(_r41j_v(_r41j_a, 0)), 0, "... dt/do along the axis 0 (moving o along it moves nothing)");
assert_eq(HVec3_x(_r41j_v(_r41j_a, 1)), f64_from(4), "... dt/dd = t dt/do = (4, 0, 0)");
assert_eq(HVec3_x(_r41j_v(_r41j_a, 2)), f64_neg(F64_ONE), "... dt/dstart = g / (g . d) = (-1, 0, 0), the finite end");
assert_eq(f64_eq(HVec3_z(_r41j_v(_r41j_a, 2)), 0), 1,
  "... and 0 along the axis (-0, 0 over g . d < 0: the sign incidental)");
assert_eq(f64_eq(HVec3_x(_r41j_v(_r41j_a, 3)), 0), 1, "... dt/dend = 0: the infinite end's other coordinates drop out");
assert_eq(geo_jet_capsule_dradius(_r41j_a), f64_neg(F64_ONE), "... dt/dr = r / (g . d) = -1");
# The start infinite instead, (1, 2, -Inf) - (0, 0, 0), from (5, 0, -3): the finite end is the end.
var _r41j_b = geo_jet_capsule(_r40_ray(f64_from(5), 0, f64_neg(f64_from(3)), f64_neg(F64_ONE), 0, 0),
  geo_capsule_new(hvec3_new(F64_ONE, F64_TWO, f64_neg(_r41j_I)), hvec3_new(0, 0, 0), F64_ONE));
assert_eq(geo_jet_t(_r41j_b), f64_from(4), "geo_jet_capsule: the start infinite: t = 4 on the barrel");
assert_eq(HVec3_x(_r41j_v(_r41j_b, 3)), f64_neg(F64_ONE), "... dt/dend = (-1, 0, 0), the finite end now");
assert_eq(f64_eq(HVec3_x(_r41j_v(_r41j_b, 2)), 0), 1, "... dt/dstart = 0");
# Its finite end's cap (unchanged: cap jets were right): from (0, 0, -5) along +z, (0,0,0)-(0,0,+Inf).
var _r41j_c = geo_jet_capsule(_r40_ray(0, 0, f64_neg(f64_from(5)), 0, 0, F64_ONE),
  geo_capsule_new(hvec3_new(0, 0, 0), hvec3_new(0, 0, _r41j_I), F64_ONE));
assert_eq(geo_jet_t(_r41j_c), f64_from(4), "geo_jet_capsule: the half-infinite capsule's cap at t = 4");
assert_eq(geo_jet_face(_r41j_c), GEO_CAP_START_CAP, "... on the start cap");
assert_eq(HVec3_z(_r41j_v(_r41j_c, 2)), F64_ONE, "... dt/dstart = (0, 0, 1)");
assert_eq(geo_jet_capsule_dradius(_r41j_c), f64_neg(F64_ONE), "... dt/dr = -1");
# The infinite cylinder, (0, 0, -Inf) - (0, 0, +Inf): t = 4 with dt/do, dt/dd and dt/dr as above; it
# exists only while its ends agree off the axis (one moved alone is the miss), so neither end has a
# derivative: both end slots NaN.
var _r41j_d = geo_jet_capsule(_r40_ray(f64_from(5), 0, f64_from(3), f64_neg(F64_ONE), 0, 0),
  geo_capsule_new(hvec3_new(0, 0, f64_neg(_r41j_I)), hvec3_new(0, 0, _r41j_I), F64_ONE));
assert_eq(geo_jet_kind(_r41j_d), GEO_JET_CAPSULE, "geo_jet_capsule: the infinite cylinder's barrel: a capsule jet");
assert_eq(HVec3_x(_r41j_v(_r41j_d, 0)), F64_ONE, "... dt/do = (1, 0, 0)");
assert_eq(HVec3_x(_r41j_v(_r41j_d, 1)), f64_from(4), "... dt/dd = (4, 0, 0)");
assert_eq(geo_jet_capsule_dradius(_r41j_d), f64_neg(F64_ONE), "... dt/dr = -1");
assert_eq(f64_eq(HVec3_x(_r41j_v(_r41j_d, 2)), HVec3_x(_r41j_v(_r41j_d, 2))), 0, "... dt/dstart NaN: no derivative");
assert_eq(f64_eq(HVec3_y(_r41j_v(_r41j_d, 3)), HVec3_y(_r41j_v(_r41j_d, 3))), 0, "... dt/dend NaN: no derivative");
# Its axis is taken through F exactly: met 3,007 along it from F = (0, 0, 2.9), dt/do is (1, 0, 0) to the
# bit, the axial part 0, not the projection's rounding of p - F (4.5e-13); and F's axial coordinate 2^60, where
# F_k + 1 is F_k, still gives the axis a length (the stand-in end is F_k / 2).
# [measured: rt340 RT3 mutation fixtures (mut3.py J3, J7), exact values, 2026-10-31]
var _r41j_f = geo_jet_capsule(_r40_ray(f64_from(5), 0, 0x40A782CB13A99CDB, f64_neg(F64_ONE), 0, 0),
  geo_capsule_new(hvec3_new(0, 0, 0x4007333333333333), hvec3_new(F64_ONE, F64_TWO, _r41j_I), F64_ONE));
assert_eq(HVec3_x(_r41j_v(_r41j_f, 0)), F64_ONE, "geo_jet_capsule: met 3,007 along the axis from F: dt/do.x = 1");
assert_eq(HVec3_z(_r41j_v(_r41j_f, 0)), 0, "... dt/do.z = 0 exactly (the axial part removed, not projected)");
var _r41j_h = geo_jet_capsule(_r40_ray(f64_from(5), 0, 0x43B0000000000000, f64_neg(F64_ONE), 0, 0),
  geo_capsule_new(hvec3_new(0, 0, 0x43B0000000000000), hvec3_new(F64_ONE, F64_TWO, _r41j_I), F64_ONE));
assert_eq(geo_jet_t(_r41j_h), f64_from(4), "geo_jet_capsule: F_k = 2^60: t = 4 on the barrel");
assert_eq(HVec3_x(_r41j_v(_r41j_h, 2)), f64_neg(F64_ONE), "... dt/dstart = (-1, 0, 0)");
# A full-mantissa half-infinite barrel (the start infinite along y): exact values rounded, within the
# stated ulps (t 0.78; dt/do 0.27, 2.62; dt/dd 1.06, 1.68; dt/dr 1.01).
var _r41j_e = geo_jet_capsule(_r40_ray(0x3FFD5DA97C2F9464, 0x3FB680463E98AE60, 0x400E819B7BC7A45C, 0xC0101DE1B056BF10,
    0x3FE9D14422D7CD50, 0xC0092DCB9934B550), geo_capsule_new(hvec3_new(0xBF9C0BFCB794B200, 0xFFF0000000000000,
      0x3FED1B19091C5B1C), hvec3_new(0xC0018CEEA295B3EE, 0x4000AD4408D04774, 0x3FF9528668C1DD38), 0x3FF9EA4CAD8E4B5A));
assert_eq(geo_jet_t(_r41j_e), 0x3FE3650C4F7A28F4, "geo_jet_capsule: a full-mantissa half-infinite barrel: t, 0.78 ulp");
assert_eq(HVec3_x(_r41j_v(_r41j_e, 0)), 0x3FCB68F3D2EAB5A5, "... dt/do.x, 0.27 ulp");
assert_eq(HVec3_y(_r41j_v(_r41j_e, 0)), 0, "... dt/do.y 0: along the axis");
assert_eq(HVec3_z(_r41j_v(_r41j_e, 0)), 0x3FA65143D5A48053, "... dt/do.z, 2.62 ulp");
assert_eq(HVec3_x(_r41j_v(_r41j_e, 1)), 0x3FC09CDE923C3CE6, "... dt/dd.x, 1.06 ulp");
assert_eq(HVec3_z(_r41j_v(_r41j_e, 1)), 0x3F9B0D72B5B67ABC, "... dt/dd.z, 1.68 ulp");
assert_eq(HVec3_x(_r41j_v(_r41j_e, 3)), 0xBFCB68F3D2EAB5A5, "... dt/dend.x = -dt/do.x");
assert_eq(geo_jet_capsule_dradius(_r41j_e), 0xBFCBF8D875163F23, "... dt/dr, 1.01 ulp");
# The rest of the contract is the miss jet, as the primal's answer is the miss or not finite: a
# radius below 0 (-1, -Inf), +Inf (t = +Inf), an end with no limit (ends infinite and apart across
# the axis, two infinite components, Inf - Inf), a ray inside along the axis (t = +Inf), and a NaN
# radius or origin (NaN, the jets' rule for a t that is not finite).
fn _r41j_miss(ox, oy, oz, dx, dy, dz, s, e, r) {
    return geo_jet_kind(geo_jet_capsule(_r40_ray(ox, oy, oz, dx, dy, dz), geo_capsule_new(s, e, r))) == GEO_JET_MISS;
}
var _r41j_n = f64_sub(_r41j_I, _r41j_I);
var _r41j_o = hvec3_new(0, 0, 0);
var _r41j_z = hvec3_new(0, 0, _r41j_I);
assert_eq(_r41j_miss(f64_from(5), 0, f64_from(3), f64_neg(F64_ONE), 0, 0, _r41j_o, _r41j_z, f64_neg(_r41j_I)), 1,
  "geo_jet_capsule: radius -Inf: the miss jet");
assert_eq(_r41j_miss(f64_from(5), 0, f64_from(3), f64_neg(F64_ONE), 0, 0, _r41j_o, hvec3_new(F64_ONE, 0, 0), _r41j_I),
  1,
  "geo_jet_capsule: radius +Inf, t = +Inf: the miss jet");
assert_eq(_r41j_miss(f64_from(5), 0, 0, f64_neg(F64_ONE), 0, 0, hvec3_new(F64_ONE, 0, f64_neg(_r41j_I)), _r41j_z,
    F64_ONE),
  1, "geo_jet_capsule: both ends infinite, apart across the axis: the miss jet");
assert_eq(_r41j_miss(f64_from(5), 0, 0, f64_neg(F64_ONE), 0, 0, _r41j_o, hvec3_new(_r41j_I, 0, _r41j_I), F64_ONE), 1,
  "geo_jet_capsule: two infinite components: the miss jet");
assert_eq(_r41j_miss(f64_from(5), 0, 0, f64_neg(F64_ONE), 0, 0, _r41j_z, hvec3_new(0, F64_ONE, _r41j_I), F64_ONE), 1,
  "geo_jet_capsule: +Inf - +Inf: the miss jet");
assert_eq(_r41j_miss(F64_HALF, 0, F64_ONE, 0, 0, F64_ONE, _r41j_o, _r41j_z, F64_ONE), 1,
  "geo_jet_capsule: inside along the axis, t = +Inf: the miss jet");
assert_eq(_r41j_miss(f64_from(5), 0, f64_from(3), f64_neg(F64_ONE), 0, 0, _r41j_o, _r41j_z, _r41j_n), 1,
  "geo_jet_capsule: a NaN radius: the miss jet");
assert_eq(_r41j_miss(_r41j_n, 0, f64_from(3), f64_neg(F64_ONE), 0, 0, _r41j_o, _r41j_z, F64_ONE), 1,
  "geo_jet_capsule: a NaN origin coordinate: the miss jet");
assert_eq(geo_ray_capsule(_r40_ray(f64_from(5), 0, f64_from(3), f64_neg(F64_ONE), 0, 0), geo_capsule_new(_r41j_o,
      hvec3_new(f64_from(7), f64_neg(f64_from(9)), _r41j_I), F64_ONE)), f64_from(4),
  "control: the infinite end's other coordinates drop out of the primal too (t = 4)");

# === 3.4.1: geo primitives -- an inverted box, a zero normal or direction, the top binade ===
test_group("3.4.1 geo: closest point on an inverted box, zero normals, centres in the top binade");
# A setter-built box min (2, 0, 0), max (1, 1, 1) is read sorted, as geo_aabb_aabb reads it: x
# clamps to 1, not 2 (AU2-G2-F12); y and z are inside and unchanged.
var _g41_bx = alloc(16);
GeoAabb_set_min(_g41_bx, hvec3_new(F64_TWO, 0, 0));
GeoAabb_set_max(_g41_bx, hvec3_new(F64_ONE, F64_ONE, F64_ONE));
var _g41_cp = geo_closest_point_on_aabb(_g41_bx, hvec3_new(0x3FA4C3B2A1908F7E, 0x3FC3D2C1B0A9F8E7, 0x3FB5A4B3C2D1E0F1));
assert_eq(HVec3_x(_g41_cp), 0x3FF0000000000000, "geo_closest_point_on_aabb: inverted x [2, 1] -> 1 (3.4.0: 2)");
assert_eq(HVec3_y(_g41_cp), 0x3FC3D2C1B0A9F8E7, "... y inside, unchanged");
GeoAabb_set_min(_g41_bx, hvec3_new(0, F64_TWO, 0));
assert_eq(HVec3_y(geo_closest_point_on_aabb(_g41_bx, hvec3_new(0, f64_from(5), 0))), F64_TWO,
  "geo_closest_point_on_aabb: inverted y [2, 1], query 5 -> 2 (the hi bound once sorted)");
GeoAabb_set_min(_g41_bx, hvec3_new(0, 0, F64_TWO));
assert_eq(HVec3_z(geo_closest_point_on_aabb(_g41_bx, hvec3_new(0, 0, F64_HALF))), F64_ONE,
  "geo_closest_point_on_aabb: inverted z [2, 1], query 0.5 -> 1");
# No plane has a zero normal and no line a zero direction: the designed 0 (AU2-G2-F15). A
# subnormal normal is a normal: the control plane x = 0 gives distance 3 at (3, 0, 0).
assert_eq(geo_plane_from_point_normal(hvec3_new(F64_ONE, 0, 0), hvec3_new(0x8000000000000000, 0, 0)), 0,
  "geo_plane_from_point_normal: a (-0, 0, 0) normal -> 0");
assert_eq(geo_line_new(hvec3_new(F64_ONE, 0, 0), hvec3_zero()), 0, "geo_line_new: a zero direction -> 0");
assert_eq(geo_plane_signed_distance(geo_plane_from_point_normal(hvec3_zero(), hvec3_new(1, 0, 0)),
    hvec3_new(f64_from(3), 0, 0)), f64_from(3), "control: a 2^-1074 normal builds the plane x = 0");
assert_eq(HVec3_z(geo_line_closest_point(geo_line_new(hvec3_zero(), hvec3_new(0, 0, 1)), hvec3_new(F64_ONE, F64_ONE,
        f64_from(3)))), f64_from(3), "control: a 2^-1074 direction builds the z axis");
# (a + b) / 2 and (a + b + c) * RN(1/3) where the sum overflows: min 7FE8000000000000 x3, max
# 7FEC000000000000 x3 -> 7FEA000000000000 x3 (3.4.0: +Inf x3, AU2-G2-F7). The centroid of
# 1.5, 1.75, 1.75 times 2^1023 is 7FEAAAAAAAAAAAAA, what its unit copy gives (exact 5/3 rounds
# to ...AB: the documented product by RN(1/3)).
GeoAabb_set_min(_g41_bx, hvec3_new(0x7FE8000000000000, 0xFFE8000000000000, 0x7FE8000000000000));
GeoAabb_set_max(_g41_bx, hvec3_new(0x7FEC000000000000, 0xFFEC000000000000, 0x7FEC000000000000));
var _g41_c = geo_aabb_center(_g41_bx);
assert_eq(HVec3_x(_g41_c), 0x7FEA000000000000, "geo_aabb_center: 1.5, 1.75 times 2^1023 -> 1.625 (3.4.0: +Inf)");
assert_eq(HVec3_y(_g41_c), 0xFFEA000000000000, "... and its negative");
_g41_c = geo_segment_midpoint(geo_segment_new(hvec3_new(0x7FE8000000000000, F64_ONE, 0),
    hvec3_new(0x7FEC000000000000, F64_TWO, 0)));
assert_eq(HVec3_x(_g41_c), 0x7FEA000000000000, "geo_segment_midpoint: the top binade (3.4.0: +Inf)");
assert_eq(HVec3_y(_g41_c), 0x3FF8000000000000, "... a coordinate that does not overflow: 1.5");
_g41_c = geo_triangle_centroid(geo_triangle_new(hvec3_new(0x7FE8000000000000, F64_ONE, 0),
    hvec3_new(0x7FEC000000000000, F64_TWO, 0), hvec3_new(0x7FEC000000000000, f64_from(3), 0)));
assert_eq(HVec3_x(_g41_c), 0x7FEAAAAAAAAAAAAA, "geo_triangle_centroid: the top binade (3.4.0: +Inf)");
assert_eq(HVec3_y(_g41_c), F64_TWO, "... (1 + 2 + 3) * RN(1/3) = 2");
assert_eq(HVec3_x(geo_triangle_centroid(geo_triangle_new(hvec3_new(0x7FEFFFFFFFFFFFFF, 0, 0),
        hvec3_new(0x7FEFFFFFFFFFFFFF, 0, 0), hvec3_new(0xFFEFFFFFFFFFFFFF, 0, 0)))), 0x7FD5555555555554,
  "geo_triangle_centroid: DBL_MAX + DBL_MAX - DBL_MAX: DBL_MAX * RN(1/3), not +Inf");

# === 3.4.1: geo_ray_triangle at every scale ===
test_group("3.4.1 geo_ray_triangle: pre-scaled, certified, exact where it cannot decide (AU2-G2-F1)");
fn _g41_tri(r, a, b, c) { return geo_ray_triangle(r, geo_triangle_new(a, b, c)); }
# Legs 2^-513 under an origin 5 away along +z: t = 5 exactly (3.4.0: the miss).
assert_eq(_g41_tri(_r40_ray(0x1FC0000000000000, 0x1FC8000000000000, 0xC014000000000000, 0, 0, F64_ONE),
    hvec3_new(0x9FE0000000000000, 0x9FE0000000000000, 0), hvec3_new(0x1FE0000000000000, 0x9FE0000000000000, 0),
    hvec3_new(0, 0x1FE0000000000000, 0)), 0x4014000000000000, "legs 2^-513, origin 5 away: t = 5 (3.4.0: 0)");
# AU2's scaled right triangle, legs L, ray from (L/4, RN(0.3 L), L) along -z, exact t = L: each
# scale's answer is its unit copy's, 3FF3C0CA428C59FA (1 ulp low), times 2^k. 3.4.0: 0 at 2^-359,
# +Inf at 2^342, NaN at 2^512.
# [measured: GEO 3.4.1 the fixtures below, run on both trees, 3.4.0 vs this tree, not in-tree, 2026-10-31]
fn _g41_sc(L) {
    return _g41_tri(_r40_ray(f64_mul(L, 0x3FD0000000000000), f64_mul(L, 0x3FD3333333333333), L, 0, 0,
        f64_neg(F64_ONE)), hvec3_zero(), hvec3_new(L, 0, 0), hvec3_new(0, L, 0));
}
assert_eq(_g41_sc(0x2983C0CA428C59FB), 0x2983C0CA428C59FA, "scene at 2^-359: t = L (3.4.0: 0, the miss)");
assert_eq(_g41_sc(0x5553C0CA428C59FB), 0x5553C0CA428C59FA, "scene at 2^342: t = L (3.4.0: +Inf)");
var _G41_SB = 0;
for (var _g41_k = 0 - 1020; _g41_k <= 1020; _g41_k = _g41_k + 17) {
    if (_g41_sc(f64_mul(0x3FF3C0CA428C59FB, (1023 + _g41_k) << 52)) != f64_mul(0x3FF3C0CA428C59FA,
        (1023 + _g41_k) << 52)) {
        _G41_SB = _G41_SB + 1;
    }
}
assert_eq(_G41_SB, 0, "scenes 2^-1020..2^1020 in steps of 2^17: every t is the unit copy's times 2^k");
assert_eq(_g41_tri(_r40_ray(0x5FE0000000000000, 0x5FE0000000000000, F64_ONE, 0, 0, f64_neg(F64_ONE)), hvec3_zero(),
    hvec3_new(0x7FE0000000000000, 0, 0), hvec3_new(0, 0x5FF0000000000000, 0)), F64_ONE,
  "legs 2^1023 and 2^512, height 1: t = 1");
# Vertices more than DBL_MAX apart: e1 = v1 - v0 overflows; the halved copy answers t = 1.
assert_eq(_g41_tri(_r40_ray(0, 0, F64_ONE, 0, 0, f64_neg(F64_ONE)),
    hvec3_new(0xFFEFFFFFFFFFFFFF, 0xFFEFFFFFFFFFFFFF, 0), hvec3_new(0x7FEFFFFFFFFFFFFF, 0xFFEFFFFFFFFFFFFF, 0),
    hvec3_new(0, 0x7FEFFFFFFFFFFFFF, 0)), F64_ONE,
  "vertices 2 DBL_MAX apart: t = 1 (3.4.0: 0)");
# A hit past DBL_MAX is +Inf, its rounding: the r5g triangle in z = h, h = 0x7FE7FFFFFFFFFFFF,
# from (-2, -1, -h), a point inside it, along +z: t = 2h.
assert_eq(_g41_tri(_r40_ray(f64_neg(F64_TWO), f64_neg(F64_ONE), f64_neg(0x7FE7FFFFFFFFFFFF), 0, 0, F64_ONE),
    hvec3_new(f64_neg(F64_ONE), f64_neg(f64_from(4)), 0x7FE7FFFFFFFFFFFF), hvec3_new(0, F64_ONE, 0x7FE7FFFFFFFFFFFF),
    hvec3_new(f64_neg(f64_from(4)), 0, 0x7FE7FFFFFFFFFFFF)), 0x7FF0000000000000,
  "a hit at t = 2h > DBL_MAX: +Inf, as geo_ray_plane and geo_ray_sphere answer it");
# A triangle of 8 x 2^-1074 at the origin, met from (1, 1, 1) along (-1, -1, -1): the ray passes
# v0 exactly, u = v = 0, which only the exact triple products decide: a hit at t = 1 (3.4.0: 0).
assert_eq(_g41_tri(_r40_ray(F64_ONE, F64_ONE, F64_ONE, f64_neg(F64_ONE), f64_neg(F64_ONE), f64_neg(F64_ONE)),
    hvec3_zero(), hvec3_new(8, 0, 0), hvec3_new(0, 8, 0)), F64_ONE,
  "a 2^-1071 triangle, its vertex from 1 away: t = 1");
# The sweep's case that read a hit at random until (v2 - o) x (v1 - o) left o x o out: subnormal
# vertices, an origin about 0.01 away, exact v = 0.4 and 1 - u - v < 0 by 1.4e295: the miss.
assert_eq(geo_ray_triangle(_r40_ray(0xBEF3758FF1CC33EC, 0xBF322D23E6C34BFB, 0xBF2E4DADCDC78538, 0x3F9E0F98B35E0A00,
      0x3FDC143EB1DA4DE8, 0x3FD76817BF94E834), geo_triangle_new(hvec3_new(0x80000000013CFEAF, 0x80000000021BC434,
        0x80000000033E36F7), hvec3_new(0x8000000002E73D33, 0x2A95D7, 0x8000000001249F41), hvec3_new(0x353683C,
        0x223FF05, 0x3CEE84E))), 0, "subnormal triangle, an oblique origin 0.01 away, exactly outside: the miss");
# A hit at t = 2^-1000: a 2^-1056 triangle, the origin 2^-1000 above it along a tilted d.
assert_eq(_g41_tri(_r40_ray(0x14000, 0x4000, 0x0170000000000000, 0xBC40000000000000, 0x3C40000000000000,
      0xBFF0000000000000), hvec3_zero(), hvec3_new(0x40000, 0, 0), hvec3_new(0, 0x40000, 0)), 0x0170000000000000,
  "a 2^-1056 triangle met at t = 2^-1000 (3.4.0: 0)");
var _g41_jt = geo_jet_triangle(_r40_ray(0x1FC0000000000000, 0x1FC8000000000000, 0xC014000000000000, 0, 0, F64_ONE),
  geo_triangle_new(hvec3_new(0x9FE0000000000000, 0x9FE0000000000000, 0), hvec3_new(0x1FE0000000000000,
      0x9FE0000000000000, 0), hvec3_new(0, 0x1FE0000000000000, 0)));
assert_eq(geo_jet_t(_g41_jt), 0x4014000000000000, "geo_jet_triangle: legs 2^-513: the hit jet, t = 5 (3.4.0: miss)");
assert_eq(HVec3_z(geo_jet_dorigin(_g41_jt)), 0xBFF0000000000000, "... dt/do.z = -1/d.z = -1");
assert_eq(HVec3_z(geo_jet_ddirection(_g41_jt)), 0xC014000000000000, "... dt/dd.z = t dt/do.z = -5");

# === 3.4.1: geo_ray_plane below DBL_MIN, and the plane jet's partials past DBL_MAX ===
test_group("3.4.1 geo_ray_plane: |n . d| under DBL_MIN is a quotient, not the miss (AU2-G2-F4, F10)");
fn _g41_pl(nx, ny, nz, dist) {
    var p = alloc(16);
    GeoPlane_set_normal(p, hvec3_new(nx, ny, nz));
    GeoPlane_set_distance(p, dist);
    return p;
}
assert_eq(geo_ray_plane(_r40_ray(0, 0, 0x8173C0CA428C59FB, F64_ONE, 0, 0x00001E06522C8B91), _g41_pl(0, 0, F64_ONE, 0)),
  0x41C50D793FFAFE38, "plane z = 0, n . d subnormal: t = 7.06e8, exact (3.4.0: 0, the miss)");
# n . d = -2^-1200 from products that each flush: t = -2^-1300 / -2^-1200 = 2^-100.
assert_eq(geo_ray_plane(_r40_ray(0, 0, 0x1430000000000000, 0, F64_ONE, 0x9A70000000000000),
    _g41_pl(F64_ONE, 0, 0x1A70000000000000, 0)), 0x39B0000000000000, "n . d = -2^-1200: t = 2^-100 (3.4.0: 0)");
assert_eq(geo_ray_plane(_r40_ray(0, 0, f64_from(5), F64_ONE, f64_neg(F64_ONE), 0), _g41_pl(F64_ONE, F64_ONE, 0, 0)), 0,
  "n . d = 1 - 1 = 0 exactly: parallel, the miss");
var _g41_nan = f64_sub(0x7FF0000000000000, 0x7FF0000000000000);
var _g41_nt = geo_ray_plane(_r40_ray(0, 0, _g41_nan, F64_ONE, 0, 0x0000000000000400), _g41_pl(0, 0, F64_ONE, 0));
assert_eq(f64_eq(_g41_nt, _g41_nt), 0, "a NaN origin with n . d subnormal: NaN in, NaN out (3.4.0: 0)");
# o (0, 0, 1) along (1, 0, -2^-600) meets z = 0 at t = 2^600, and dt/dd.z = 2^1200: the miss jet,
# as the sphere, capsule and triangle jets answer a partial past DBL_MAX (3.4.0: a hit jet with
# +Inf). At -2^-500 every partial is finite (2^1000): the hit jet.
var _g41_p0 = _g41_pl(0, 0, F64_ONE, 0);
assert_eq(geo_jet_kind(geo_jet_plane(_r40_ray(0, 0, F64_ONE, F64_ONE, 0, 0x9A70000000000000), _g41_p0)), GEO_JET_MISS,
  "geo_jet_plane: dt/dd.z = 2^1200: the miss jet (3.4.0: +Inf in a hit jet)");
var _g41_jp = geo_jet_plane(_r40_ray(0, 0, F64_ONE, F64_ONE, 0, 0xA0B0000000000000), _g41_pl(0, 0, F64_ONE, 0));
assert_eq(HVec3_z(geo_jet_ddirection(_g41_jp)), 0x7E70000000000000, "control: d.z = -2^-500, dt/dd.z = 2^1000, a hit");
assert_eq(HVec3_x(geo_jet_plane_dnormal(_g41_jp)), 0x7E70000000000000, "... dt/dn.x = 2^1000");
# The miss jet is one allocation now: its five vectors are distinct, zero and readable.
var _g41_mj = geo_jet_plane(_r40_ray(0, 0, F64_ONE, F64_ONE, 0, 0), _g41_pl(0, 0, F64_ONE, 0));
assert_eq(geo_jet_kind(_g41_mj), GEO_JET_MISS, "geo_jet_plane: a parallel ray: the miss jet");
assert(geo_jet_dorigin(_g41_mj) != geo_jet_ddirection(_g41_mj), "... dt/do and dt/dd are distinct vectors");
HVec3_set_x(geo_jet_dorigin(_g41_mj), F64_ONE);
assert_eq(HVec3_x(geo_jet_ddirection(_g41_mj)), 0, "... writing one leaves the other 0");
assert_eq(HVec3_z(geo_jet_dpoint(_g41_mj, _r40_ray(0, 0, F64_ONE, F64_ONE, 0, 0), hvec3_one(), hvec3_one())), 0,
  "geo_jet_dpoint on a miss jet: (0, 0, 0), as documented now");

# === 3.4.1: unit normal, segment, sphere-sphere at the ends of the range ===
test_group("3.4.1 geo: unit normal, segment closest point and sphere overlap at every scale");
var _g41_un = geo_triangle_unit_normal(geo_triangle_new(hvec3_zero(), hvec3_new(0x4C73C0CA428C59FB, 0, 0),
    hvec3_new(0, 0x017E06522C8B909A, 0x0176A09E667F3BCD)));
assert_eq(HVec3_y(_g41_un), 0xBFE3425F773FB196, "geo_triangle_unit_normal: edges 2^200 and 2^-1000: y (3.4.0: 1)");
assert_eq(HVec3_z(_g41_un), 0x3FE98E315CDBC592, "... z, exact ...591, 1 ulp (3.4.0: 0, the fallback)");
# A segment 2^-540 long, queried at its end: the end, distance 0 (3.4.0: the start, 1E453C1BB13EF484).
var _g41_se = geo_segment_new(hvec3_zero(), hvec3_new(0x1E33C0CA428C59FB, 0x1E3E06522C8B909A, 0x1E36A09E667F3BCD));
assert_eq(HVec3_y(geo_segment_closest_point(_g41_se, hvec3_new(0x1E33C0CA428C59FB, 0x1E3E06522C8B909A,
        0x1E36A09E667F3BCD))), 0x1E3E06522C8B909A, "geo_segment_closest_point: a 2^-540 segment's end -> the end");
assert_eq(geo_segment_distance_to_point(_g41_se, hvec3_new(0x1E33C0CA428C59FB, 0x1E3E06522C8B909A,
      0x1E36A09E667F3BCD)), 0, "geo_segment_distance_to_point: ... 0");
var _g41_sm = geo_segment_closest_point(geo_segment_new(hvec3_zero(), hvec3_new(0x6573C0CA428C59FB, 0x657E06522C8B909A,
      0)), hvec3_new(0x6563C0CA428C59FB, 0x656E06522C8B909A, 0));
assert_eq(HVec3_x(_g41_sm), 0x6563C0CA428C59FB, "geo_segment_closest_point: a 2^600 segment's midpoint (3.4.0: NaN)");
var _g41_sh = geo_segment_closest_point(geo_segment_new(hvec3_new(0xFFEFFFFFFFFFFFFF, 0, 0),
    hvec3_new(0x7FEFFFFFFFFFFFFF, 0, 0)), hvec3_new(0, F64_ONE, 0));
assert_eq(HVec3_x(_g41_sh), 0, "geo_segment_closest_point: ends 2 DBL_MAX apart, query (0, 1, 0): x = 0 (3.4.0: NaN)");
assert_eq(HVec3_y(_g41_sh), 0, "... y = 0");
assert_eq(geo_segment_distance_to_point(geo_segment_new(hvec3_new(f64_from(4), 0, 0), hvec3_new(f64_from(4), 0, 0)),
    hvec3_new(f64_from(4), f64_from(3), 0)), f64_from(3), "control: a point segment is its start");
# Separated spheres 2^-600 across, radii summing to 0.9 of the distance: not touching (3.4.0: 1).
var _g41_s6 = geo_sphere_new(hvec3_new(0x1A73C0CA428C59FB, 0x1A7E06522C8B909A, 0), 0);
assert_eq(geo_sphere_sphere(geo_sphere_new(hvec3_zero(), 0x1A702C42B72CC809), _g41_s6), 0,
  "geo_sphere_sphere: separated at 2^-600 (3.4.0: touching)");
assert_eq(geo_sphere_sphere(geo_sphere_new(hvec3_zero(), 0x1A90000000000000), _g41_s6), 1,
  "... and a radius 2^-598, past the distance: touching");
assert_eq(geo_sphere_sphere(geo_sphere_new(hvec3_zero(), 0x60E0000000000000),
    geo_sphere_new(hvec3_new(0x6100000000000000, 0, 0), 0x60E0000000000000)), 0,
  "geo_sphere_sphere: radii 2^527 2^529 apart: separated (3.4.0: Inf <= Inf)");
assert_eq(geo_sphere_sphere(geo_sphere_new(hvec3_new(0xFFEFFFFFFFFFFFFF, 0, 0), 0x7FEFFFFFFFFFFFFF),
    geo_sphere_new(hvec3_new(0x7FEFFFFFFFFFFFFF, 0, 0), F64_ONE)), 0,
  "geo_sphere_sphere: centres 2 DBL_MAX apart: separated");

# === 3.4.1: the capsule's cap below the d . u underflow, NaN tags, and the jets at any scale ===
test_group("3.4.1 geo capsule: the start cap under a 2^-590 direction, NaN tags, scaled jets (AU2-G2-F8/F9/F11/F14)");
var _g41_ob = alloc(16);
var _g41_c14 = geo_capsule_new(hvec3_new(0xA32A3B852E5483A2, 0x23052E1B945EEC88, 0xA3207279EFE03CC8),
  hvec3_new(0xA31A894D70DCD754, 0xA31640F321E7E43C, 0xA3266FC0CDD723D0), 0x23228BD0CC5FE205);
var _g41_r14 = _r40_ray(0xA32F7C781AB22883, 0xA2E7EFB0710A6630, 0xA3479059D9C6C069, 0x98E641FA5534C16A,
  0x19097EC6AAD7674D, 0x192F53F3771CC6F5);
assert_eq(geo_ray_capsule_branch(_g41_r14, _g41_c14, _g41_ob), 0x49FFBC7CA92F338C,
  "geo_ray_capsule_branch: |d| 2^-590, d . u subnormal: the start cap, exact ...338B (3.4.0: 0)");
assert_eq(load64(_g41_ob), GEO_CAP_START_CAP, "... branch START_CAP (3.4.0: GEO_FACE_NONE)");
var _g41_cu = geo_capsule_new(hvec3_zero(), hvec3_new(0, F64_ONE, 0), F64_HALF);
geo_ray_capsule_branch(_r40_ray(f64_from(0 - 3), 0x3FD999999999999A, _g41_nan, F64_ONE, 0, 0), _g41_cu, _g41_ob);
assert_eq(load64(_g41_ob), GEO_FACE_NONE,
  "geo_ray_capsule_branch: a NaN origin: NaN t, GEO_FACE_NONE (3.4.0: END_CAP)");
geo_ray_capsule_branch(_r40_ray(f64_from(0 - 3), 0x3FD999999999999A, 0x3FC999999999999A, F64_ONE, 0, 0),
  geo_capsule_new(hvec3_zero(), hvec3_new(0, F64_ONE, 0), _g41_nan), _g41_ob);
assert_eq(load64(_g41_ob), GEO_FACE_NONE, "... a NaN radius: GEO_FACE_NONE");
geo_ray_capsule_branch(_r40_ray(f64_from(0 - 3), 0x3FD999999999999A, _g41_nan, F64_ONE, 0, 0),
  geo_capsule_new(hvec3_zero(), hvec3_zero(), F64_HALF), _g41_ob);
assert_eq(load64(_g41_ob), GEO_FACE_NONE, "... start == end with a NaN origin: GEO_FACE_NONE (3.4.0: SPHERE)");
# AU2's unit capsule scene times 2^-550: the barrel hit jet, bit for bit its 2^550 copy's
# dt/do (3.4.0: the miss jet, |ab|^2 flushed).
var _g41_j8 = geo_jet_capsule(_r40_ray(0x9D3166C978AC5C20, 0x9D93E442AB1B9441, 0x1D918D88FE99C6B6, 0xBFCEDD61B2EED345,
    0x3FE052A48DB4DC08, 0xBFEA6B90C7FD9D69), geo_capsule_new(hvec3_new(0x9D85F12316A70F3C, 0x9D80C4687796DE30,
      0x9D88E63C56F0CADE), hvec3_new(0x9D8523B678B478E4, 0x1D92BDD2BC2219B4, 0x9D7AA626EBDACE34), 0x1D7F2CB955275D02));
assert_eq(geo_jet_t(_g41_j8), 0x1D9B6EBB907D52C0, "geo_jet_capsule: a 2^-550 scene's barrel hit (3.4.0: the miss jet)");
assert_eq(HVec3_x(geo_jet_dorigin(_g41_j8)), 0x3FE22CF683725211, "... dt/do.x, its unit copy's bits");
assert_eq(HVec3_z(geo_jet_dorigin(_g41_j8)), 0x3FED684D14896C70, "... dt/do.z");
assert_eq(HVec3_x(geo_jet_ddirection(_g41_j8)), 0x1D8F29AA2E3CC49E, "... dt/dd.x, its copy's times 2^-550");
# A sphere of 41 x 2^-1074 (AU2-G2-F9): dt/do from the unit copy, 3e-14 off the exact (3FDF598017163D3D,
# ...) where 3.4.0's 3FDF4A0101363332 was 2.9e-3 off; t is the primal's.
var _g41_j9 = geo_jet_sphere(_r40_ray(0x5918, 0x12CC, 0x9340, 0xBFE32AE0225BF04E, 0xBFD8D3DB6D1790EA,
    0xBFE66AA8B158A538), geo_sphere_new(hvec3_new(0x80000000000000A4, 0x8000000000002765, 0x2A4F), 0x29));
assert_eq(geo_jet_t(_g41_j9), 0x95B2, "geo_jet_sphere: a subnormal scene: t, the primal's");
assert_eq(HVec3_x(geo_jet_dorigin(_g41_j9)), 0x3FDF598017163E72, "... dt/do.x 3e-14 off (3.4.0: 2.9e-3)");
assert_eq(HVec3_x(geo_jet_ddirection(_g41_j9)), 0x4954, "... dt/dd.x = t dt/do.x, at the primal's t");
assert_eq(HVec3_x(geo_jet_sphere_dcenter(_g41_j9)), 0xBFDF598017163E72, "... dt/dc.x = -dt/do.x");
# The capsule at the same 2^-1074 scale: a barrel hit whose jet is its 2^1074 copy's.
var _g41_jc = geo_jet_capsule(_r40_ray(0, f64_neg(0x3E8), 0, 0, F64_ONE, 0),
  geo_capsule_new(hvec3_new(0x8000000000000064, 0, 0x3), hvec3_new(0x64, 0, 0x3), 0x5));
assert_eq(geo_jet_kind(_g41_jc), GEO_JET_CAPSULE, "geo_jet_capsule: a subnormal capsule: a hit jet");
assert_eq(HVec3_y(geo_jet_dorigin(_g41_jc)), 0xBFF0000000000000, "... dt/do = (0, -1, -3/4): y");
assert_eq(HVec3_z(geo_jet_dorigin(_g41_jc)), 0xBFE8000000000000, "... z (3.4.0: the miss jet)");
# A tilted ray at the same scale, the hit point off the grid: dt/do is its 2^1074 copy's, bits.
var _g41_jd = geo_jet_capsule(_r40_ray(5, 0x80000000000001F4, 2, 0x3F892DE372C67C35, 0x3FEFFC5FE488A0E8,
    0x3F9BBCF55C191870), geo_capsule_new(hvec3_new(0x8000000000000064, 3, 7), hvec3_new(0x5A, 0x8000000000000002, 0xB),
    0xD));
assert_eq(HVec3_x(geo_jet_dorigin(_g41_jd)), 0xBFA339001F5CD4E4, "geo_jet_capsule: a tilted subnormal ray: dt/do.x");
assert_eq(HVec3_z(geo_jet_dorigin(_g41_jd)), 0x3FE082403BEF97EB, "... dt/do.z, its 2^1074 copy's");

# === 3.4.1 GEO2: geo_ray_triangle's exact determinants keep every term (RV-GEO M1) ===
test_group("3.4.1 GEO2: geo_ray_triangle's exact path sums integers, exact at every magnitude (RV-GEO M1)");
# Each expected value is the exact rational Moller-Trumbore answer (Fraction; a hit's t correctly
# rounded, or within the ulps stated). "GEO" is the first 3.4.1 lane's tree, "3.4.0" the release.
# [measured: GEO2 3.4.1 fixt.py, Fraction oracle, 3.4.0 / GEO / this tree, 2026-10-31]
fn _gg2_tri(ox, oy, oz, dx, dy, dz, ax, ay, az, bx, by, bz, cx, cy, cz) {
    return geo_ray_triangle(_r40_ray(ox, oy, oz, dx, dy, dz), geo_triangle_new(hvec3_new(ax, ay, az),
        hvec3_new(bx, by, bz), hvec3_new(cx, cy, cz)));
}
# The origin in the plane z = Z of edge v0-v2, d = (1, 0, -22 * 2^-1074): u's determinant is
# d_z C_z, below the large terms' 2^-1074 horizon, which cancel exactly. Exact miss (u = -6.5e-320).
assert_eq(_gg2_tri(0x23D199989999999A, 0x23D3333333700000, 0x23D4CCCCCCCCCCCD, F64_ONE, 0, 0x8000000000000016,
    0x23D199999999999A, 0x23D3333333333333, 0x23D4CCCCCCCCCCCD, 0x23D1999999ECCCCD, 0x23D3333333199999,
    0x23D4CCCCCD39999A, 0x23D1999999C66667, 0x23D3333333ACCCCD, 0x23D4CCCCCCCCCCCD), 0,
  "u = -6.5e-320 under cancelling 2^-900 terms: the miss (GEO: a hit, 2290016666680000)");
assert_eq(_gg2_tri(0x23D199989999999A, 0x23D3333333700000, 0x23D4CCCCCCCCCCCD, F64_ONE, 0, 0x16,
    0x23D199999999999A, 0x23D3333333333333, 0x23D4CCCCCCCCCCCD, 0x23D1999999ECCCCD, 0x23D3333333199999,
    0x23D4CCCCCD39999A, 0x23D1999999C66667, 0x23D3333333ACCCCD, 0x23D4CCCCCCCCCCCD), 0x2290016666680000,
  "... its mirror, d_z = +22 * 2^-1074: the hit (3.4.0: 0)");
assert_eq(_gg2_tri(0x139D22E1B8813A28, 0x9392D9B8EA98A5BB, 0x139899918A50D7DE, F64_ONE, 0, 0x800000000001707C,
    0x139D22F02FCE6196, 0x9392D9B8EA990CE0, 0x139899918A50D7DE, 0x139D22F02FCC66E2, 0x9392D9B8EA9C88F4,
    0x139899918A548CE2, 0x139D22F02FD0198C, 0x9392D9B8EA97B544, 0x139899918A50D7DE), 0,
  "the review's family row at 2^-700, exact u = -1.19e-313: the miss (GEO: 128CEE9B56FE7601)");

# === 3.4.1 GEO2: every geo_ray_triangle verdict certified or exact (RV-GEO M3) ===
test_group("3.4.1 GEO2: geo_ray_triangle's verdict is certified by a proven bound or decided exactly (RV-GEO M3)");
# Off-band inputs whose a and t-numerator were in band kept 3.4.0's arithmetic in GEO's tree.
assert_eq(_gg2_tri(0x7BAF00D3AF1B46E9, 0xFBC6BD4A1D1239C1, 0x7BA3202918EE0596, 0, 0, 0x4100000000000000, 0, 0, 0,
    0x051CD35F8824E44E, 0x851AF4D1935B7114, 0x04E10244F74B70D0, 0x7BDCF3EECC2F9700, 0xFBF53C4DEAAC3110,
    0x7BD1DC5B9D52E8A8), 0, "a NaN u from finite input: the miss (3.4.0 and GEO: a hit, 7743A4F98FFF555D)");
assert_eq(_gg2_tri(0x655199999999999A, 0x5283333333333333, 0xDF38000000000000, 0, 0x2D30000000000000, F64_ONE,
    0, 0, 0, 0x6574CCCCCCCCCCCD, 0, 0, 0, 0x52BB333333333333, 0), 0x5F38000000000001,
  "s x e1 overflows: the hit at t = 4.9e150, 1 ulp above the exact 5F38000000000000 (3.4.0 and GEO: 0)");
# In band, a triangle far smaller than its distance from the origin: 3.4.0's verdict was o - v0's
# rounding. Its bound does not certify it; the exact determinants decide.
assert_eq(_gg2_tri(0x3D7FEF8B3718239B, 0xBD92DDE1CE6C069B, 0x3D92078D183CF046, 0xBFD2B93C0856B82B,
    0x3FE61F6AC72B8F8A, 0xBFE52418E46AA38E, 0x3851A7E475587F64, 0xB89B3D9230C87318, 0xB893A5A24F9CD8C8,
    0x386E0E4A05C2DDA0, 0xB89958A3BA46F0AB, 0xB8958DF1C6A453B7, 0x388070EFCC69F29A, 0xB8994D236D957785,
    0xB88C0F26727B15EA), 0, "a 2^-120 triangle 2^-40 away, in band: the miss (3.4.0 and GEO: 3D9B4A4FA4BC2484)");
assert_eq(_gg2_tri(0xB91CE38B1B7D47E4, 0xB9160BD2F8836B78, 0xB91E68E29DF7358E, 0x3FE38256E484722D,
    0x3FDDC6BEE54963F9, 0x3FE48944CD250727, 0x35BC0612F061FC96, 0xB5AF788C1D3909B1, 0xB5BBE994DB277AC7,
    0xB5CEC22E9DE04D89, 0x358605D29962503C, 0xB5CD600024CD5ED2, 0x35CE5E9BC0BA9B23, 0x35CCBD1587A72140,
    0xB588F14000C1D318), 0x3927B14BB6B53ECC,
  "a 2^-160 triangle 2^-110 away: the hit, t within 2^-33 of the exact ...EC5 (3.4.0 and GEO: 0)");
# t whose float bound exceeds 2^-33 of it: the quotient of the two exact numerators.
assert_eq(_gg2_tri(0x3E2AA6C96270FADC, 0xBDE3A72D9210BA20, 0x3E10374284FD6638, 0xC01AD557A55675A4,
    0x401888FCDF026734, 0x401C9A9EBB436100, 0x4988CA08F1D42328, 0x4968C3228B994080, 0x49AE695610EF7B8C,
    0x4A0C970A7A609EC0, 0xCA2C628674E740E0, 0x4A24FD9CC244C78C, 0xC7B11F856EAD8F60, 0x47B4A77E7AB61074,
    0xC77C8CA671674220), 0x477F0388EBA25B0E,
  "an ill-conditioned t: the exact numerators' quotient (3.4.0 and GEO: 477F03887F26A70F, 1.4e-8 off)");
# A subnormal t is good to 2^-1074, not to 2^-33 of itself.
assert_eq(_gg2_tri(0x31E50565967A6, 0xFF19DE608BBB0, 0xCD075842D9374, 0xBFF06A002EB24780, 0xC004AC2C3CAF84CB,
    0xBFF6E2F38C73CEB8, 0x46ACD78F4CFC7, 0x1068BC7639E1E, 0x692FF91A11DD7, 0x8005243D59122922,
    0x8004AE2DC5278DC4, 0x1617CE7AEAF2E, 0x80024D6394CCE878, 0x800745F793FE726E, 0xDB2B6FBE82EE),
  0x0007FFFFFFFFFFF5, "a subnormal triangle and t: within 2^-1074 of the exact t (3.4.0: 0)");
# u = 0 exactly (the ray meets edge v0-v2): no bound certifies it; the one exact determinant does.
assert_eq(_gg2_tri(0xBFD0000000000000, 0xBFD0000000000000, 0x3FF8000000000000, F64_HALF, F64_HALF, 0,
    0x3FE8000000000000, 0x3FF8000000000000, 0x4008000000000000, 0xBFE0000000000000, 0, 0x3FD0000000000000, 0,
    0xBFE0000000000000, F64_HALF), 0x3FF199999999999A, "a ray through an edge (u = 0 exactly): the hit, t = 1.1");
# Every quantity uncertain, a included, in band: all five determinants from the points.
assert_eq(_gg2_tri(0x317EDD3645BE6334, 0x3170F2878AD0F656, 0xB1383A554372BD60, 0xCE5599B123097908,
    0xC6A2B30C75DE5F92, 0, 0xBA448109E6FB367A, 0xBA31C01661F989D8, 0xBA1B60B9018B58D0, 0xB4ACC8C830CB06A4,
    0x34BB539C2F9125BA, 0x34A69DC9B86B088C, 0xB6574DAF8033AC52, 0x36512628925DF434, 0xB657B1202AC4CB88),
  0x266D4E1E4B4F48A6, "a needle triangle, every quantity exact: the hit at t = 1.0e-120 (3.4.0 and GEO: -0)");

# === 3.4.1 GEO2: the tiny capsule jet is formed on a scaled, not translated, copy (RV-GEO M2) ===
test_group("3.4.1 GEO2: geo_jet_capsule at r < 2^-968 with normal coordinates keeps 3.4.0's accuracy (RV-GEO M2)");
# r = 2^-1019, |ab| = 3.6e-300, coordinates near 2^-993: exact dt/do.x BFC3D0AA961DC71F (80-digit
# Decimal); the copy multiplied by 2^k gives 3.4.0's bits, 1.2e-10 off; GEO's translated copy
# BFC3D0AA93836A84 was 9.7e-9 off.
var _gg2_j = geo_jet_capsule(_r40_ray(0x81DE855FC88DDD96, 0x8202DB5BA8EA50F4, 0x8208B0858A8D58DF, 0x3FF6A52064D2384C,
    0x3FFE4BC18B2D48BD, 0x400D97145ED2E868), geo_capsule_new(hvec3_new(0x01EC5DDBDCC78A7E, 0x81DAC4A927412A6C,
      0x01E46B0E2D6805DA), hvec3_new(0x01F09A0BCEDD1B87, 0x81E19B279D88CCD2, 0x01E20BA925FFFB5A), 0x004B336BF6C84EE0));
assert_eq(geo_jet_kind(_gg2_j), GEO_JET_CAPSULE, "geo_jet_capsule: r = 2^-1019 at 2^-993: the barrel hit jet");
assert_eq(geo_jet_t(_gg2_j), 0x01F00000006E0801, "... t, the primal's");
assert_eq(HVec3_x(geo_jet_dorigin(_gg2_j)), 0xBFC3D0AA9625E8A9, "... dt/do.x 1.2e-10 off (GEO: 9.7e-9)");
assert_eq(HVec3_z(geo_jet_dorigin(_gg2_j)), 0xBFC59FA795291DD0, "... dt/do.z, 3.4.0's bits");
assert_eq(HVec3_x(geo_jet_ddirection(_gg2_j)), 0x81C3D0AA96AE2D27, "... dt/dd.x = t dt/do.x");

# === 3.4.1 GEO2: geo_triangle_unit_normal from the exact cross product (RV-GEO S4) ===
test_group("3.4.1 GEO2: geo_triangle_unit_normal is the exact edges' unit normal, never a fabricated (0, 1, 0)");
# Expected: within 8 * 2^-53 of the exact unit normal of the exact edges (Fraction / Decimal).
# [measured: GEO2 3.4.1 fixun.py and un2.py, Fraction oracle, 3.4.0 / GEO / this tree, 2026-10-31]
fn _gg2_un(ax, ay, az, bx, by, bz, cx, cy, cz) {
    return geo_triangle_unit_normal(geo_triangle_new(hvec3_new(ax, ay, az), hvec3_new(bx, by, bz),
        hvec3_new(cx, cy, cz)));
}
# v2 = (1.5 * 2^1000, 1.3 * 2^-80, 0): its own components span 2^1080, and an edge's power of two
# flushed the small one.
var _gg2_n1 = _gg2_un(0, 0, 0, F64_ONE, 0, 0, 0x7E78000000000000, 0x3AF4CCCCCCCCCCCD, 0);
assert_eq(HVec3_z(_gg2_n1), F64_ONE, "an edge spanning 2^1080: (0, 0, 1) (3.4.0 and GEO: the fallback (0, 1, 0))");
assert_eq(HVec3_y(_gg2_n1), 0, "... y = 0");
assert_eq(HVec3_z(_gg2_un(0, 0, 0, F64_ONE, 0, 0, 0x6578000000000000, 0x1A74CCCCCCCCCCCD, 0)), F64_ONE,
  "... the same at 1.5 * 2^600 and 1.3 * 2^-600");
# Each coordinate its own scale: the float cross product cancelled or flushed whole components.
var _gg2_n2 = _gg2_un(0xE93CAB6E98CE5C72, 0xD696268258B7DB22, 0x2F73F45C46359F6C, 0xD95AB3D1FC5949C8,
  0xD188E8A51B42A81E, 0x1683320A154837E6, 0x30D7B31E47897CE6, 0x253A32056A2A4E88, 0x5157C1D94948B0D0);
assert_eq(HVec3_y(_gg2_n2), 0xBFBE4E560BEEDA25, "coordinates 2^-920..2^1000: y = -0.118 (3.4.0 and GEO: -1)");
assert_eq(HVec3_z(_gg2_n2), 0x3FEFC664E408C14B, "... z = 0.993 (3.4.0 and GEO: 0)");
var _gg2_n3 = _gg2_un(0xE8E2A53B9E27CE8C, 0xD1F93A8D4AC53A70, 0x1651CBA7B0F78400, 0x0B1FFBA5D8150602,
  0xB2C683BF6CBCF44E, 0xA5C315BA1F746288, 0x82A6D274C13A97E0, 0xC81622F634CD55E4, 0x23F44EB384F7351C);
assert_eq(HVec3_z(_gg2_n3), 0xBFF0000000000000, "... another: z = -1 (3.4.0 and GEO: (0, -1, 0))");
assert_eq(HVec3_x(_gg2_n3), 0x06B2AA2AF6A5E96E, "... its x, 2.5e-277");
# Exactly colinear: the documented fallback, and only there.
assert_eq(HVec3_y(_gg2_un(F64_ONE, F64_TWO, 0x4008000000000000, F64_TWO, 0x4010000000000000, 0x4018000000000000,
      0x4008000000000000, 0x4018000000000000, 0x4022000000000000)), F64_ONE, "(1,2,3), (2,4,6), (3,6,9): (0, 1, 0)");
# Nearly colinear (0.1, 0.2, 0.3) and its doubles: each component rounded once, the exact value's
# rounding (3.4.0 and GEO: 1 ulp above).
assert_eq(HVec3_x(_gg2_un(0x3FB999999999999A, 0x3FC999999999999A, 0x3FD3333333333333, 0x3FC999999999999A,
      0x3FD999999999999A, 0x3FE3333333333333, 0x3FD3333333333333, 0x3FE3333333333333, 0x3FECCCCCCCCCCCCD)),
  0x3FEC9F25C5BFEDD9, "(0.1, 0.2, 0.3) x 1, 2, 3: x, the exact value's rounding");

# === 3.4.1 GEO2: a fixture for each part of the bounds and of the exact path ===
