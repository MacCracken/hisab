test_group("num: gcd");

assert_eq(num_gcd(12, 8), 4, "gcd(12,8)");
assert_eq(num_gcd(7, 13), 1, "gcd coprime");
assert_eq(num_gcd(100, 75), 25, "gcd(100,75)");
assert_eq(num_gcd(17, 17), 17, "gcd(17,17)");
assert_eq(num_gcd(0, 5), 5, "gcd(0,5)");

# ----------------------------------------------------------------
test_group("num: modpow");

var _rq79t, _rq79v = num_modpow(2, 10, 1000);
assert_eq(is_ok(_rq79t), 1, "modpow 2^10 mod 1000");
assert_eq(_rq79v, 24, "modpow 2^10 mod 1000");
var _rq80t, _rq80v = num_modpow(3, 5, 100);
assert_eq(is_ok(_rq80t), 1, "modpow 3^5 mod 100");
assert_eq(_rq80v, 43, "modpow 3^5 mod 100");
var _rq81t, _rq81v = num_modpow(7, 0, 13);
assert_eq(is_ok(_rq81t), 1, "modpow exp=0 -> 1");
assert_eq(_rq81v, 1, "modpow exp=0 -> 1");
var _rq82t, _rq82v = num_modpow(5, 1, 100);
assert_eq(is_ok(_rq82t), 1, "modpow exp=1");
assert_eq(_rq82v, 5, "modpow exp=1");

