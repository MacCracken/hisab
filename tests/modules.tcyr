  0x40078CC2398D4A54, 0x3FF7D53D700E32E8, 0x3FE8A02374A884E8, 0x3FFF32FEB0D383F0, 0xBFEED65C073378BC,
  0xD7C420DCC0344388, 0x5377354455AA59A4, 0xD49AB13D9EC12848);
assert_eq(HVec3_x(_gg5_b9), 0xD7AA54EB1FF668B8, "a point 2^300 away: u, 1 ulp (3.4.0: ...68B7)");
assert_eq(HVec3_z(_gg5_b9), 0xD798F2BECF68614B, "... w (3.4.0: 0xD798F2BECF68614A)");
assert_eq(_gg5_code(0x3FE1C4A1FBB6E274, 0x400711CFBAFD938C, 0x40063A2FFE6FFF38, 0xBFF61DE4F7D5157A,
    0x40078CC2398D4A54, 0x3FF7D53D700E32E8, 0x3FE8A02374A884E8, 0x3FFF32FEB0D383F0, 0xBFEED65C073378BC,
    0xD7C420DCC0344388, 0x5377354455AA59A4, 0xD49AB13D9EC12848), 0,
  "... the thin path");
# A non-finite point: 3.4.0's Gram weights, bit for bit.
var _gg5_b10 = _gg3_bc(0x3FF501D1170AB89C, 0x40022EDA08535DE4, 0x3FF48E7239751204, 0x40043675DE8FC5A0,
  0xBFE42AC23E8664E4, 0x3FFCE3224AEC4438, 0xBFD543F8C1B93750, 0x4004E87D58CE0D94, 0x40022F837631702E,
  0xC003527B3FC8E0CE, 0xC0017936F307DBEE, 0xFFF0000000000000);
