  "... path thin");
# geo_ray_plane: the bits the integer sums give (the first 3.4.1 tree's), where one term of the certified
# double sum decides the rounding.
assert_eq(_gg5_rp(0xBCC20655E439D8A3, 0xBC371862BD153FF8, 0x94B8733E805BB8E0, 0x5924E1CC0644E90E,
    0xD8EFD3BC4E05CD0E, 0x38E2D407ECF863E8, 0x25EFD3BC4E05CD0E, 0x2624E1CC0644E90E,
    0x0193643F8FACE1A2, 0x8164C95DB361303A), 0x6829CCE0EEF34833,
  "P8 fixture: the numerator's negated product errors decide its rounding");
assert_eq(_gg5_rp(0xA8409F34F23930DC, 0x93AF4EF8696A6DAC, 0x0F3F75ABD6DA2688, 0x3E60DA962966CF8A,
    0xBE3F4B5A95A169DB, 0x24B86EC196BA771C, 0x29FF4B5A95A169DB, 0x2A20DA962966CF8A,
    0x0DE58635E201FBF2, 0x103AE7DA64202788), 0x5F8FA6DA59529ED9,
  "P9 fixture: the third two_sum's error decides the rounding");
# a . b is exactly 0: the sum is c0 itself, with its sign (P16).
assert_eq(_gg5_rp(0, 0, 0, 0, 0x01E21AAC7986353D, 0,
    0x14FD184B64095974, 0xA5BFE572B2BBEEE8, 0, 0xB33B04B812823D25), 0x7FF0000000000000,
  "P16 fixture: t past DBL_MAX, +Inf (c0's sign kept)");
# The split of the second factor at bit 27 (P17).
assert_eq(_gg5_rp(0x190849781C9A1D18, 0x18265305CD8BD98A, 0x17A7F50933A2C5E3, 0x306849781C9A1D18,
    0x2F865305CD8BD98A, 0x95C7F50933A2C5E3, 0xA1165305CD8BD98A, 0x21F849781C9A1D18,
    0x20E5A052BF883032, 0), 0x41D0000000000000,
  "P17 fixture: t");
# A result below 2^-1000 of the scale is not the fast path's: it declines (P11).
assert_eq(_gg5_pair(hvec3_new(0xF0B0B76668BB00A6, 0, 0x8000000D0E7D84BF), hvec3_new(0x1CB57D4AB88F8796, 0,
      0xDB420533827037A6), 0, 1), 0 - 2,
  "P11 fixture: declined");
# 2^53 + 1 + 2^-57: the two_sum errors 1 and 2^-57 round to 1, a false tie that reads 2^53; the exact sum
# rounds to 2^53 + 2. Only Eb's |c0| term sees it, and declines (P13b; hand-built: the term's width is
# about 2^-100 of c0, which no random row reaches).
assert_eq(_gg5_pair(hvec3_new(F64_ONE, 0x3C60000000000000, 0), hvec3_new(0x3CA0000000000000, 0x3CA0000000000000, 0),
    F64_ONE, 0), 0 - 2,
  "P13b fixture: declined");

# === 3.4.1 CO8: the curvature reading and the ball ===
# _epa_tan_eig on chords with a known symmetric part, s = 1/2 so the chord is the map itself:
# [[3, 1], [1, 3]] has rates 2 and 4 on the diagonals; [[1, 0], [0, 5]] takes the q < 0 branch; a zero
# map has no eigenvector and keeps the frame (V = -t1, W = t2).
test_group("gjk_epa_3d: the tangent plane's curvature (review pass CO8)");
var _co8_tp = alloc(40);
var _co8_x = hvec3_unit_x();
var _co8_y = hvec3_unit_y();
_epa_tan_eig(hvec3_new(0x4008000000000000, F64_ONE, 0), hvec3_new(F64_ONE, 0x4008000000000000, 0), _co8_x, _co8_y,
  F64_HALF, _co8_tp);
assert_eq(load64(_co8_tp + 16), F64_TWO, "_epa_tan_eig: the lesser rate of [[3, 1], [1, 3]]");
assert_eq(load64(_co8_tp + 24), 0x4010000000000000, "_epa_tan_eig: the greater rate");
assert_eq(HVec3_x(load64(_co8_tp)), 0xBFE6A09E667F3BCC, "_epa_tan_eig: V, x: -sqrt(1/2)");
assert_eq(HVec3_y(load64(_co8_tp)), 0x3FE6A09E667F3BCC, "_epa_tan_eig: V, y: sqrt(1/2)");
assert_eq(HVec3_x(load64(_co8_tp + 8)), 0x3FE6A09E667F3BCC, "_epa_tan_eig: W, x");
assert_eq(HVec3_y(load64(_co8_tp + 8)), 0x3FE6A09E667F3BCC, "_epa_tan_eig: W, y");
_epa_tan_eig(hvec3_new(F64_ONE, 0, 0), hvec3_new(0, 0x4014000000000000, 0), _co8_x, _co8_y, F64_HALF, _co8_tp);
assert_eq(load64(_co8_tp + 16), F64_ONE, "_epa_tan_eig: q < 0: the lesser rate");
assert_eq(load64(_co8_tp + 24), 0x4014000000000000, "_epa_tan_eig: q < 0: the greater rate");
assert_eq(HVec3_x(load64(_co8_tp)), 0xBFF0000000000000, "_epa_tan_eig: q < 0: V is -x");
assert_eq(HVec3_y(load64(_co8_tp + 8)), F64_ONE, "_epa_tan_eig: q < 0: W is y");
_epa_tan_eig(hvec3_zero(), hvec3_zero(), _co8_x, _co8_y, F64_HALF, _co8_tp);
assert_eq(HVec3_y(load64(_co8_tp + 8)), F64_ONE, "_epa_tan_eig: no motion: W keeps t2");
assert_eq(load64(_co8_tp + 16), 0, "_epa_tan_eig: no motion: rate 0");

# Spheres and a cylinder, general axis. The depths below are this tree's, each checked against the
# closed form r + min(R - rho, hz - |z|) (centre inside) or r - dist (outside) in mpmath at 50 digits, the
# figure after each scene being its error in units of 1e-12. Each is the scene its mutant fails worst on.
# [measured: review pass CO8 mutrun.py, mktests.py, the review's ep3 seeds 1, 2, gen7 seed 5, this tree; 2026-11-01]
var _co8_calls = 0;
fn _co8_sup_ball(sh, d) {
    _co8_calls = _co8_calls + 1;
    var l = f64_sqrt(hvec3_dot(d, d));
    var k = 0;
    if (f64_gt(l, 0) == 1) { k = f64_div(load64(sh + 24), l); }
    return hvec3_new(f64_add(load64(sh), f64_mul(HVec3_x(d), k)), f64_add(load64(sh + 8), f64_mul(HVec3_y(d), k)),
      f64_add(load64(sh + 16), f64_mul(HVec3_z(d), k)));
}
fn _co8_sup_cyl(sh, d) {
    _co8_calls = _co8_calls + 1;
    var ux = load64(sh + 24);
    var uy = load64(sh + 32);
    var uz = load64(sh + 40);
    var dx = HVec3_x(d);
    var dy = HVec3_y(d);
    var dz = HVec3_z(d);
    var du = f64_add(f64_add(f64_mul(dx, ux), f64_mul(dy, uy)), f64_mul(dz, uz));
    var px = f64_sub(dx, f64_mul(du, ux));
    var py = f64_sub(dy, f64_mul(du, uy));
    var pz = f64_sub(dz, f64_mul(du, uz));
    var dp = f64_add(f64_add(f64_mul(px, ux), f64_mul(py, uy)), f64_mul(pz, uz));
    px = f64_sub(px, f64_mul(dp, ux));
    py = f64_sub(py, f64_mul(dp, uy));
    pz = f64_sub(pz, f64_mul(dp, uz));
    var pl = f64_sqrt(f64_add(f64_add(f64_mul(px, px), f64_mul(py, py)), f64_mul(pz, pz)));
    var k = 0;
    if (f64_gt(pl, f64_mul(f64_sqrt(hvec3_dot(d, d)), 0x3CF0000000000000)) == 1) {
        k = f64_div(load64(sh + 48), pl);
    }
    var h = load64(sh + 56);
    if (f64_lt(du, 0) == 1) { h = f64_neg(h); }
    return hvec3_new(f64_add(f64_add(load64(sh), f64_mul(ux, h)), f64_mul(px, k)),
      f64_add(f64_add(load64(sh + 8), f64_mul(uy, h)), f64_mul(py, k)),
      f64_add(f64_add(load64(sh + 16), f64_mul(uz, h)), f64_mul(pz, k)));
}
var _co8_c = alloc(64);
var _co8_b = alloc(32);
var _co8_n = alloc(8);
var _co8_d = alloc(8);
fn _co8_cyl(c0, c1, c2, u0, u1, u2, r, hz) {
    store64(_co8_c, c0);
    store64(_co8_c + 8, c1);
    store64(_co8_c + 16, c2);
    store64(_co8_c + 24, u0);
    store64(_co8_c + 32, u1);
    store64(_co8_c + 40, u2);
    store64(_co8_c + 48, r);
    store64(_co8_c + 56, hz);
    return 0;
}
# The ball's four words, and the query: entry 0 gjk_epa_3d, 1 mpr_penetration; the depth's bits, -1 for a miss.
fn _co8_q(b0, b1, b2, r, entry) {
    store64(_co8_b, b0);
    store64(_co8_b + 8, b1);
    store64(_co8_b + 16, b2);
    store64(_co8_b + 24, r);
    var k = 0;
    if (entry == 0) { k = gjk_epa_3d(&_co8_sup_ball, _co8_b, &_co8_sup_cyl, _co8_c, _co8_n, _co8_d); }
    if (entry == 1) { k = mpr_penetration(&_co8_sup_ball, _co8_b, &_co8_sup_cyl, _co8_c, _co8_n, _co8_d); }
    if (k != 1) { return 0 - 1; }
    return load64(_co8_d);
}

