assert_eq(HVec3_y(_gg5_b7), 0x3ED0C290FCAB941E, "... v (3.4.0: 0x3ED0C290FD1EF8AA)");
assert_eq(HVec3_z(_gg5_b7), 0x3FEA53AAF61B1312, "... w (3.4.0: 0x3FEA53AAF61B12CB)");
assert_eq(_gg5_code(0xFFD98D1EC1737881, 0xFFE9B2F4E9C899A2, 0xFFD61C096C2E351E, 0x7FE9B2F4E9C899A2,
    0xFFE4DA25363029FC, 0xFE583A131A48418C, 0x7FE9B2F4E9C899A2, 0xFFE9B2F4E9C899A2, 0x7E7B1D78A225F8E6,
    0x7FE9B2F4E9C899A2, 0xFFE9B2F4E9C899A2, 0xFFE9B2F4E9C899A2), 1,
  "... certified (the halved copy)");
# Edges 2^350 apart in length (outside the range): the thin path. The point, 0.3 v1 + 0.4 v2 rounded,
