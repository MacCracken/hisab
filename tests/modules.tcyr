var _gg5_b8 = _gg3_bc(0, 0, 0, 0x3FF4CCCCCCCCCCCD, 0x3FE6666666666666, 0x3FC999999999999A, 0xA9E999999999999A,
  0x2A1199999999999A, 0x29F999999999999A, 0x3FD8F5C28F5C28F6, 0x3FCAE147AE147AE1, 0x3FAEB851EB851EB8);
