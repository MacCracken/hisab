# === 3.3.7 (review): which shallow minima the polish runs on ===
# Boxes as three axis columns (_mpr_sup_obb), counted. A shallow certificate whose gap
# exceeds 2^-10 of the depth classifies the minimum on its first probes: a crease or a
# face keeps EPA's answer when the gap is within 1/8 of the depth, and stops the search
# for the walk otherwise; a round minimum is polished. Each assertion below failed under
# a mutant of that rule (named in its message).
# [measured: co2 fixt.py / fixt2.py on review-co families, exact oracles, 3.3.6, 3.3.7 and tree, 2026-10-31]
# ⭐ 3.4.0 — a shallow certificate is snapped first (_ga_snap; _epa_snap_done), and on these box
# faces the snap is exact, so each now answers the face's own depth, to the supports' rounding,
# and the rule above runs only where a snap does not settle the answer. Each message keeps
# the 3.3.7 value and call count.
# [measured: lane-CO fixB.py, 80-digit Decimal oracle, 3.3.7 base and this tree, 2026-10-31; cycc 6.7.9]
fn _c37_sup_box(shape, dir) {
    _ga_sup_calls = _ga_sup_calls + 1;
    return _mpr_sup_obb(shape, dir);
}
fn _c37_mkbox(c, h, e0, e1, e2) {
    var s = _mpr_mkobb(HVec3_x(c), HVec3_y(c), HVec3_z(c), HVec3_x(h), HVec3_y(h), HVec3_z(h));
    store64(s + 48, HVec3_x(e0)); store64(s + 56, HVec3_y(e0)); store64(s + 64, HVec3_z(e0));
    store64(s + 72, HVec3_x(e1)); store64(s + 80, HVec3_y(e1)); store64(s + 88, HVec3_z(e1));
    store64(s + 96, HVec3_x(e2)); store64(s + 104, HVec3_y(e2)); store64(s + 112, HVec3_z(e2));
    return s;
}
# A sphere 1e-9 into a box face whose certificate gap is 3.7e-3 of the depth: classified
# as a face, it keeps 3.3.6's depth (1.0016e-9, exact 1.0000001e-9) in 36 calls (3.3.6 32,
# the same with the threshold at 2^-7).
# [measured: co2 fixt.py / fixt2.py, exact oracle, 3.3.6, 3.3.7, this tree and the named mutant, 2026-10-31]
var _c37_f1 = _c37_mkbox(hvec3_new(0x3FC3D79FED73CE90, 0xBFE5E4A362A22122, 0x3FEB349736BEC8D4),
  hvec3_new(0x3FF6D7A1699A5D06, 0x3FFC1455986C7E5E, 0x3FF5D6AAE5587622),
  hvec3_new(0x3FEEB2FFF4160E4F, 0x3FC1E5E0DCB6C6AD, 0x3FCF60D165AC1168),
  hvec3_new(0xBFCB173B5AFAE92B, 0x3FEDCB496FDDEB90, 0x3FD3053258E08C39),
  hvec3_new(0xBFC7E5612B85FE96, 0xBFD591534CDF2A31, 0x3FED87AD32FB40CA));
var _c37_g1 = hvec4_new(0x4001CDC0B0CCC65A, 0xBFF3385F799CD79D, 0x3FEB8F62B75F73D6, 0x3FDF4CA1DFC5B668);
_ga_sup_calls = 0;
assert_eq(gjk_epa_3d(&_c37_sup_box, _c37_f1, &_ga_sup_sphere, _c37_g1, _c37_n, _c37_d), 1,
  "gjk_epa_3d: a sphere 1e-9 into a box face is a contact");
