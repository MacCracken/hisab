# Four sites rounded from one circle: 3.3.4 kept the non-Delaunay diagonal.
store64(e35_b, 0x4054_0CDA_F7AC_EFF2); store64(e35_b + 8, 0x405A_ADDE_2EB7_7CEA);
store64(e35_b + 16, 0xC058_91CA_C3EB_0ECD); store64(e35_b + 24, 0x4056_8BAA_55F3_B436);
