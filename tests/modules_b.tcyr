store64(e35_w, 0); store64(e35_w + 8, 1); store64(e35_w + 16, 2);
store64(e35_w + 24, 0); store64(e35_w + 32, 2); store64(e35_w + 40, 3);
assert_eq(_dl_list_diff(delaunay_2d(_e35_pts(e35_b, 4), 4), _e35_list(e35_w, 6)), 0,
  "3.3.5 delaunay_2d: four sites on a circle give [0 1 2, 0 2 3] (3.3.4: [1 2 3, 0 1 3], not Delaunay)");
# Three sites near 0.5 and one at 1.99e233: 3.3.4 returned three overlapping triangles.
# [measured: scratch oracle and exact-arithmetic port, not reproducible in-tree, 2026-10-11]
store64(e35_b, 0x3FD6_2AB5_495E_907E); store64(e35_b + 8, 0x3FE8_37B6_15CD_9EF3);
store64(e35_b + 16, 0x3FE3_B66C_1B16_68A4); store64(e35_b + 24, 0x3FEB_5069_2E4A_524B);
store64(e35_b + 32, 0x3FE0_221A_A884_3456); store64(e35_b + 40, 0x3FE4_9E25_04B1_DDD6);
store64(e35_b + 48, 0x705F_FBB5_AF4B_DF66); store64(e35_b + 56, 0x3FE4_E3DB_3A06_6C3A);
store64(e35_w, 1); store64(e35_w + 8, 0); store64(e35_w + 16, 2);
