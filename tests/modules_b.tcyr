  "3.3.5 delaunay_2d: sites near 0.5 and 1.99e233 give [1 0 2, 1 2 3] (3.3.4: three overlapping)");
# Twelve sites spanning 2^-298 to 2^290: 3.3.4 emitted 16 triangles, (8, 5, 10) clockwise.
var e35_s12 = alloc(24 * 8);
store64(e35_s12, 0x4A70_F2B7_2A62_F6AA); store64(e35_s12 + 8, 0xAFCB_C6FC_BBAA_94EA);
