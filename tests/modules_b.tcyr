# ~1e-8 — for assertions on transcendental / iterative results where exact
# bit equality is not achievable but 8 significant digits is.
var LOOSE_TOL_M = 0x3E45798EE2308C3A;
# ~1e-15 -- a few ulp of 1.0, for order-1 quantities with a closed form
# (group-inverse round-trips, traceless generators, Euler's identity, cot(pi/3)).
# Replaces a literal f64_from(1), which is a tolerance of 1.0 and admits
# everything in [0, 2]. 2.7.0 measured the floor of its 12 sites at <= 2.3e-16 on
# 6.5.6. Re-measured on 6.6.12 over the 24 sites now, by swapping this constant:
# all pass at 2^-52 + 1 ulp (~2.2e-16) and 3 fail at 2^-53 + 1 ulp, so the floor
# still sits at or below 2^-52.
# [measured: scratch harness, ULP_TOL_M swapped, not reproducible in-tree, 2026-09-30; cycc 6.6.12]
var ULP_TOL_M = 0x3CD203AF9EE75616;
var TOL_1EM14 = 0x3D06849B86A12B9B;  # 1e-14
var TOL_1EM12 = 0x3D719799812DEA11;  # 1e-12 (== EPSILON_F64)

# ================================================================
# Tolerance helper — added 2.13.0
# ================================================================
# ⭐ WHY THIS EXISTS. Before 2.13.0 this suite compared floats through
# `f64_to(x)`, which TRUNCATES: `assert_eq(f64_to(v), 3)` accepts every v in
# [3, 4), i.e. an absolute error of up to 1.0. Measured on the pre-conversion
# tree: `hvec2_add` could return `a + b + 0.9` and **all 3572 assertions still
# passed**. 2.13.0 converted the exact cases to bit-exact compares; this helper
# is for the cases that are genuinely approximate, so "approximate" is a named
# decision at the call site instead of a side effect of truncation.
# ⚠ Use `assert_eq(a, b, msg)` when the value IS exact — most are. Reach for
# this only when a transcendental or an iteration makes exactness untrue.
# [measured: scratch harness, not reproducible in-tree, 2026-09-09]
fn assert_f64_eq(a, b, msg) {
    assert(f64_approx_eq(a, b, LOOSE_TOL_M), msg);
    return 0;
}
# ~1e-13 -- for the Minkowski interval of (5,3,0,0), whose magnitude is 16 and
# whose measured boost drift is 7.105e-15 (4 ulp of 16).
var IVL_TOL_M = 0x3D3C25C268497682;  # 1e-13

# Distance in ULPs between two positive finite f64s. Their bit patterns are
# monotonic in value, so the difference of the patterns IS the ULP count.
fn _tc_ulp_gap(a, b) { var d = a - b; if (d < 0) { d = 0 - d; } return d; }

fn _tc_x2(x) { return f64_mul(x, x); }
fn _tc_sin(x) { return f64_sin(x); }
fn _tc_cos(x) { return f64_cos(x); }
fn _tc_exp(x) { return f64_exp(x); }
fn _tc_const(x) { return f64_from(7); }
fn _tc_one(x) { return F64_ONE; }
fn _tc_linear(x) { return x; }
fn _tc_cubic(x) {
    var cx2 = f64_mul(x, x);
    var cx3 = f64_mul(cx2, x);
    var ct1 = f64_sub(cx3, f64_mul(F64_TWO, cx2));
    var ct2 = f64_add(ct1, f64_mul(f64_from(3), x));
    return f64_sub(ct2, f64_from(4));
}
fn _tc_x4(x) { var qx2 = f64_mul(x, x); return f64_mul(qx2, qx2); }
fn _tc_inv1p(x) { return f64_div(F64_ONE, f64_add(F64_ONE, x)); }
fn _tc_cubic_pure(x) { return f64_mul(x, f64_mul(x, x)); }
fn _tn_f(x) { return f64_sub(f64_mul(x, x), F64_TWO); }
fn _tn_df(x) { return f64_mul(F64_TWO, x); }
fn _tn_cube_f(x) { return f64_sub(f64_mul(x, f64_mul(x, x)), f64_from(8)); }
fn _tn_cube_df(x) { return f64_mul(f64_from(3), f64_mul(x, x)); }
fn _tn_lin_f(x) { return f64_sub(x, f64_from(5)); }
fn _tn_lin_df(x) { return F64_ONE; }
fn _tn_sin_f(x) { return f64_sin(x); }
fn _tn_sin_df(x) { return f64_cos(x); }

# Sum of 2x signed areas over a flat triangle-index list (triplets) into points
# p — used to check a triangulation tiles its polygon (|sum| == polygon |2xarea|).
fn _tp_area2x(p, t) {
    var s = 0;
    var k = 0;
    var m = vec_len(t);
    while (k < m) {
        var a = vec_get(p, vec_get(t, k));
        var b = vec_get(p, vec_get(t, k + 1));
        var c = vec_get(p, vec_get(t, k + 2));
        s = f64_add(s, _col_triangle_area_2x(HVec2_x(a), HVec2_y(a),
            HVec2_x(b), HVec2_y(b), HVec2_x(c), HVec2_y(c)));
        k = k + 3;
    }
    return s;
}

# --- delaunay_2d completeness harness (2.8.2) ------------------------------
# The 10x super-triangle left HOLES in the mesh — real triangles that were never
# created because a super-vertex sat inside their circumcircle, then silently
# dropped with the super-triangle at compaction. Nothing in the suite noticed,
# because every fixture was either small enough to be unaffected or checked a
# property (empty circumcircle, manifoldness) that a mesh with a hole still
# satisfies. What catches it is COVERAGE: a triangulation of n points tiles the
# convex hull exactly, so the summed triangle area must equal the hull area and
# the triangle count must be 2n - 2 - h.
#
# splitmix64 so a whole input class is pinned by one seed rather than by
# hundreds of literal coordinates. Integer-only, hence bit-identical anywhere.
var _DLR_STATE = 0;

fn _dlr_next() {
    _DLR_STATE = _DLR_STATE + 0x9E37_79B9_7F4A_7C15;
    var z = _DLR_STATE;
    z = (z ^ (z >> 30)) * 0xBF58_476D_1CE4_E5B9;
    z = (z ^ (z >> 27)) * 0x94D0_49BB_1331_11EB;
    return z ^ (z >> 31);
}

# Uniform in [0, 1): the top 53 bits of the state, scaled by 2^-53.
fn _dlr_unit() {
    return f64_mul(f64_from(_dlr_next() >> 11), 0x3CA0_0000_0000_0000);
}

# n uniform points in a box `span` wide and `span * flat` tall.
fn _dlr_points(n, seed, span, flat) {
    _DLR_STATE = seed;
    var p = vec_new();
    for (var i = 0; i < n; i = i + 1) {
        var ux = _dlr_unit();
        var uy = _dlr_unit();
        vec_push(p, hvec2_new(f64_mul(span, ux),
            f64_mul(f64_mul(span, flat), uy)));
    }
    return p;
}

# Total 2x area covered, taking each triangle's area as POSITIVE so a folded or
# duplicated triangle adds instead of cancelling.
fn _dl_area2_abs(p, t) {
    var s = 0;
    var k = 0;
    while (k < vec_len(t)) {
        var a = vec_get(p, vec_get(t, k));
        var b = vec_get(p, vec_get(t, k + 1));
        var c = vec_get(p, vec_get(t, k + 2));
        s = f64_add(s, f64_abs(_col_triangle_area_2x(HVec2_x(a), HVec2_y(a),
              HVec2_x(b), HVec2_y(b), HVec2_x(c), HVec2_y(c))));
        k = k + 3;
    }
    return s;
}

# 2x area of the convex hull of the first n points (shoelace over the hull).
fn _dl_hull_area2(p, n) {
    var h = convex_hull_2d(p, n);
    var m = vec_len(h);
    if (m < 3) { return 0; }
    var s = 0;
    for (var i = 0; i < m; i = i + 1) {
        var a = vec_get(p, vec_get(h, i));
        var b = vec_get(p, vec_get(h, (i + 1) % m));
        s = f64_add(s, f64_sub(f64_mul(HVec2_x(a), HVec2_y(b)),
            f64_mul(HVec2_y(a), HVec2_x(b))));
    }
    return f64_abs(s);
}

# How many of the first n input points appear anywhere in the triangle list.
fn _dl_used(n, t) {
    var seen = alloc(n * 8);
    for (var i = 0; i < n; i = i + 1) { store64(seen + i * 8, 0); }
    for (var k = 0; k < vec_len(t); k = k + 1) {
        store64(seen + vec_get(t, k) * 8, 1);
    }
    var c = 0;
    for (var i = 0; i < n; i = i + 1) {
        if (load64(seen + i * 8) == 1) { c = c + 1; }
    }
    return c;
}

# Largest number of triangles sharing any single edge. 2 for a manifold mesh,
# 3+ for the overlapping soup a broken cavity produces.
fn _dl_max_edge_share(t) {
    var worst = 0;
    var e = 0;
    while (e < vec_len(t)) {
        for (var s = 0; s < 3; s = s + 1) {
            var ua = vec_get(t, e + s);
            var ub = vec_get(t, e + (s + 1) % 3);
            var cnt = 0;
            var f = 0;
            while (f < vec_len(t)) {
                var x0 = vec_get(t, f);
                var x1 = vec_get(t, f + 1);
                var x2 = vec_get(t, f + 2);
                if (x0 == ua || x1 == ua || x2 == ua) {
                    if (x0 == ub || x1 == ub || x2 == ub) { cnt = cnt + 1; }
                }
                f = f + 3;
            }
            if (cnt > worst) { worst = cnt; }
        }
        e = e + 3;
    }
    return worst;
}

# 1 when the mesh covers exactly the convex hull: |mesh area - hull area| under
# a relative 1e-9. A single missing triangle shows up here at 1e-4 and an
# overlapping fold at 10^-1 or worse, so the threshold is nowhere near either.
fn _dl_tiles_hull(p, n, t) {
    var ha = _dl_hull_area2(p, n);
    var ma = _dl_area2_abs(p, t);
    var tol = f64_mul(ha, 0x3E112E0BE826D695);   # 1e-9
    if (f64_lt(f64_abs(f64_sub(ma, ha)), tol) == 1) { return 1; }
    return 0;
}

# Count points strictly inside any output triangle's circumcircle — the
# Delaunay empty-circumcircle property holds iff this is 0. Reuses the same
# winding-aware predicate the algorithm uses; cocircular points are not strictly
# inside, so they don't count. t = flat CCW triple-list into points p.
fn _dl_violations(p, n, t) {
    var viol = 0;
    var nt = vec_len(t) / 3;
    var ti = 0;
    while (ti < nt) {
        var a = vec_get(t, ti * 3);
        var b = vec_get(t, ti * 3 + 1);
        var c = vec_get(t, ti * 3 + 2);
        var j = 0;
        while (j < n) {
            var skip = 0;
            if (j == a) { skip = 1; }
            if (j == b) { skip = 1; }
            if (j == c) { skip = 1; }
            if (skip == 0) {
                var pj = vec_get(p, j);
                var ic = _col_in_circumcircle(p, a, b, c, HVec2_x(pj), HVec2_y(pj));
                if (ic == 1) { viol = viol + 1; }
            }
            j = j + 1;
        }
        ti = ti + 1;
    }
    return viol;
}

# --- delaunay ghost DIRECTIONS: the equal-|u_k|^2 property (2.9.0) ----------
#
# collision_mesh.cyr's symbolic-ghost-vertices comment says the three |u_k|^2
# being equal is "not decoration": it is what makes the M^2 coefficient of the
# TWO-GHOST in-circle determinant collapse to
# (u_j x u_k) * (|R - A|^2 - |A - p|^2), the plain
# apex-distance comparison _col_dl_ic_g2 uses to break its tie. CHANGELOG 2.8.2
# records that the requirement "was found by measurement, not by reasoning" and
# that the obvious set (-1,-1), (1,-1), (0,1) -- which is ALSO counter-clockwise
# and ALSO positively spans the plane -- had its tie rule fail 1,429 of 35,968
# exact trials.
#
# Nothing asserted any of it. Replacing all six constants with that documented
# failing set leaves modules, abuse and hisab green, because no delaunay_2d
# fixture in any suite reaches the tie branch at all.
#
# The helpers below pin the PROPERTY, not the six numbers. They re-derive the
# M^3 and M^2 coefficients of the two-ghost determinant from the GENERAL
# expansion in M -- each ghost carrying its OWN |u_k|^2, nothing factored out --
# and check _col_dl_ic_g2 against the sign of the leading nonzero one. Any
# equal-norm direction set passes; an unequal-norm set passes the CCW and
# spanning checks above and fails here.

# |u_k|^2.
fn _dlg_l(k) {
    return f64_add(f64_mul(_col_ghost_ux(k), _col_ghost_ux(k)),
      f64_mul(_col_ghost_uy(k), _col_ghost_uy(k)));
}

# u_j x u_k as a VALUE; _col_ghost_cross returns only its sign.
fn _dlg_crossv(j, k) {
    return f64_sub(f64_mul(_col_ghost_ux(j), _col_ghost_uy(k)),
      f64_mul(_col_ghost_uy(j), _col_ghost_ux(k)));
}

# M^3 coefficient of det[(r, |r|^2); (g_j, |g_j|^2); (g_k, |g_k|^2)] where
# r = R - p and g_k = A - p + M u_k, i.e. r x (u_j |u_k|^2 - u_k |u_j|^2). With
# the norms equal it becomes |u|^2 * (r x (u_j - u_k)) -- and THAT is the cross
# product _col_dl_ic_g2 actually evaluates, with the positive |u|^2 dropped.
fn _dlg_c3(rx, ry, j, k) {
    var lj = _dlg_l(j);
    var lk = _dlg_l(k);
    return f64_sub(
      f64_mul(rx, f64_sub(f64_mul(_col_ghost_uy(j), lk), f64_mul(_col_ghost_uy(k), lj))),
      f64_mul(ry, f64_sub(f64_mul(_col_ghost_ux(j), lk), f64_mul(_col_ghost_ux(k), lj))));
}

# M^2 coefficient of the same determinant, q = A - p. The (|u_k|^2 - |u_j|^2)
# factor multiplying q is the "query-position-dependent tail" that the same
# collision_mesh.cyr comment says unequal norms leave behind; it is what the
# apex-distance tie rule has no way to see.
fn _dlg_c2(rx, ry, qx, qy, j, k) {
    var dl = f64_sub(_dlg_l(k), _dlg_l(j));
    var qj = f64_add(f64_mul(qx, _col_ghost_ux(j)), f64_mul(qy, _col_ghost_uy(j)));
    var qk = f64_add(f64_mul(qx, _col_ghost_ux(k)), f64_mul(qy, _col_ghost_uy(k)));
    var wy = f64_add(f64_mul(qy, dl),
      f64_mul(F64_TWO, f64_sub(f64_mul(_col_ghost_uy(j), qk), f64_mul(_col_ghost_uy(k), qj))));
    var wx = f64_add(f64_mul(qx, dl),
      f64_mul(F64_TWO, f64_sub(f64_mul(_col_ghost_ux(j), qk), f64_mul(_col_ghost_ux(k), qj))));
    return f64_add(f64_sub(f64_mul(rx, wy), f64_mul(ry, wx)),
      f64_mul(f64_add(f64_mul(rx, rx), f64_mul(ry, ry)), _dlg_crossv(j, k)));
}

# The answer the determinant forces: sign of the leading nonzero coefficient,
# read against the triangle's orientation (u_j x u_k). Returns (0 - 1) when both
# coefficients vanish -- that probe decides nothing at this order and is skipped.
fn _dlg_truth(rx, ry, qx, qy, j, k) {
    var s = _col_f64_sign(_dlg_c3(rx, ry, j, k));
    if (s == 0) { s = _col_f64_sign(_dlg_c2(rx, ry, qx, qy, j, k)); }
    if (s == 0) { return 0 - 1; }
    if (s * _col_ghost_cross(j, k) > 0) { return 1; }
    return 0;
}

# The M^3 coefficient is LINEAR in r, so agreeing with |u|^2 * (r x (u_j - u_k))
# on the two basis vectors is agreement for every r. Counts the disagreements
# over the three cyclic pairs; 0 is the whole claim.
fn _dlg_c3_bad() {
    var bad = 0;
    for (var gi = 0; gi < 3; gi = gi + 1) {
        var j = gi;
        var k = (gi + 1) % 3;
        var l = _dlg_l(j);
        var dx = f64_sub(_col_ghost_ux(j), _col_ghost_ux(k));
        var dy = f64_sub(_col_ghost_uy(j), _col_ghost_uy(k));
        if (f64_eq(_dlg_c3(F64_ONE, 0, j, k), f64_mul(l, dy)) == 0) { bad = bad + 1; }
        if (f64_eq(_dlg_c3(0, F64_ONE, j, k), f64_neg(f64_mul(l, dx))) == 0) { bad = bad + 1; }
    }
    return bad;
}

var _DLG_PROBES = 0;
var _DLG_DECIDED = 0;
var _DLG_MISMATCH = 0;
var _DLG_TIE = 0;
var _DLG_INSIDE = 0;
var _DLG_TAIL = 0;
var _DLG_PERM = 0;

# Answers the two-ghost in-circle question through the PUBLIC entry point for
# all six orderings of (R, G_j, G_k) and returns how many disagree with the
# first. "p is inside the circumcircle of these three points" is a question
# about a SET, so the count must be 0 -- an ordering-dependent answer means the
# predicate is not computing the geometric quantity it advertises.
#
# _col_dl_incircle's three rotations are even permutations, so the six orderings
# collapse to two calls: the pair (j, k) and the pair (k, j). Exactly one of
# those is anti-cyclic, which is why nothing else in any suite reaches the
# anti-cyclic half of _col_dl_ic_g2's input space.
fn _dlg_perm_bad(pts, j, k, px, py) {
    var gj = 2 + j;
    var gk = 2 + k;
    var ref = _col_dl_incircle(pts, 2, 1, gj, gk, px, py);
    var bad = 0;
    if (_col_dl_incircle(pts, 2, gj, gk, 1, px, py) != ref) { bad = bad + 1; }
    if (_col_dl_incircle(pts, 2, gk, 1, gj, px, py) != ref) { bad = bad + 1; }
    if (_col_dl_incircle(pts, 2, 1, gk, gj, px, py) != ref) { bad = bad + 1; }
    if (_col_dl_incircle(pts, 2, gk, gj, 1, px, py) != ref) { bad = bad + 1; }
    if (_col_dl_incircle(pts, 2, gj, 1, gk, px, py) != ref) { bad = bad + 1; }
    return bad;
}

# --- 2.9.1 the ALL-ghost in-circle answer (_col_dl_ic_g3) ------------------
var _DLG3_PROBES = 0;
var _DLG3_BAD_CYC = 0;
var _DLG3_BAD_ANTI = 0;

# Answers the all-ghost in-circle question through the PUBLIC entry point for
# three of the six orderings of (G_0, G_1, G_2) -- the CYCLIC (even) three when
# `anti` is 0, the ANTI-CYCLIC (odd) three when it is 1 -- and returns how many
# answered anything other than 1.
#
# The truth is the CONSTANT 1, for every finite p and every ordering. All three
# |u_k|^2 are equal (5), so the apex A is exactly the circumcenter of the three
# ghosts: their circumcircle is the circle of radius M*sqrt(5) about A, which
# swallows any finite p once M is large enough, and a ghost predicate is the
# sign for all sufficiently large M. Equivalently, the M^4 coefficient of the
# determinant is |u|^2 * orient(u_a, u_b, u_c) -- p cancels out of the leading
# term -- and the ghost triangle's own orientation is M^2 * orient(u), so the
# winding factor cancels between them instead of having to be divided out the
# way _col_dl_ic_g2 divides it out with `cr`.
#
# Verified in exact rationals against the circumcircle of the three actual
# points, sweeping M by decades to 1e40: the answer stabilises at 1 for all six
# orderings, and the only 0s occur at M values where M*sqrt(5) is still short of
# |p - A|, which is the pre-limit transient and not the predicate.
#
# Through 2.9.1 the body returned sign(orient(u_a, u_b, u_c)) > 0, i.e. the
# WINDING of the presented triple rather than the in-circle answer, so the
# anti-cyclic half of this helper is what caught it: 243 of 243 CW-presented
# triples wrong, 0 of 243 cyclic.
fn _dlg3_bad(pts, nr, anti, px, py) {
    var g0 = nr;
    var g1 = nr + 1;
    var g2 = nr + 2;
    var bad = 0;
    if (anti == 0) {
        if (_col_dl_incircle(pts, nr, g0, g1, g2, px, py) != 1) { bad = bad + 1; }
        if (_col_dl_incircle(pts, nr, g1, g2, g0, px, py) != 1) { bad = bad + 1; }
        if (_col_dl_incircle(pts, nr, g2, g0, g1, px, py) != 1) { bad = bad + 1; }
        return bad;
    }
    if (_col_dl_incircle(pts, nr, g0, g2, g1, px, py) != 1) { bad = bad + 1; }
    if (_col_dl_incircle(pts, nr, g2, g1, g0, px, py) != 1) { bad = bad + 1; }
    if (_col_dl_incircle(pts, nr, g1, g0, g2, px, py) != 1) { bad = bad + 1; }
    return bad;
}

# Grid: 4 magnitude scales x 3 apexes x 25 query points x 6 orderings = 1800.
# The scales run to 1e18 because there is NO finite bound on p here -- M is
# symbolic and unbounded, so a query point cannot be "too far out" to be inside
# the all-ghost circumcircle. A reimplementation that reintroduced any
# dependence on p, or any distance comparison against a concrete multiplier,
# would fail on the outer scales.
fn _dlg3_run() {
    _DLG3_PROBES = 0;
    _DLG3_BAD_CYC = 0;
    _DLG3_BAD_ANTI = 0;
    var g3a = alloc(48);
    store64(g3a, 0); store64(g3a + 8, 0);
    store64(g3a + 16, 3); store64(g3a + 24, 0 - 7);
    store64(g3a + 32, 0 - 1000); store64(g3a + 40, 1000);
    var pts = vec_new();
    vec_push(pts, hvec2_new(0, 0));
    for (var si = 0; si < 4; si = si + 1) {
        var scale = F64_ONE;
        if (si == 1) { scale = f64_from(1000); }
        if (si == 2) { scale = f64_from(1000000000); }
        if (si == 3) { scale = f64_mul(f64_from(1000000000), f64_from(1000000000)); }
        for (var ai = 0; ai < 3; ai = ai + 1) {
            vec_set(pts, 0, hvec2_new(f64_from(load64(g3a + ai * 16)),
                f64_from(load64(g3a + ai * 16 + 8))));
            for (var gx = 0 - 2; gx < 3; gx = gx + 1) {
                for (var gy = 0 - 2; gy < 3; gy = gy + 1) {
                    var px = f64_mul(f64_from(gx), scale);
                    var py = f64_mul(f64_from(gy), scale);
                    _DLG3_BAD_CYC = _DLG3_BAD_CYC + _dlg3_bad(pts, 1, 0, px, py);
                    _DLG3_BAD_ANTI = _DLG3_BAD_ANTI + _dlg3_bad(pts, 1, 1, px, py);
                    _DLG3_PROBES = _DLG3_PROBES + 6;
                }
            }
        }
    }
}

# --- 2.9.3: the ONE-ghost in-circle path (_col_dl_ic_g1) ------------------
var _DLG1_PROBES = 0;
var _DLG1_BAD = 0;
var _DLG1_TIE = 0;

# Counts entry-point answers that disagree across the SIX orderings of a
# one-ghost triple (a, b, G_k).
#
# "Is p inside the circumcircle of these three points" is a question about a
# SET, so the answer cannot depend on the order the vertices arrive in.
# _col_dl_incircle rotates the ghost into last place and those rotations are
# even permutations, so the six orderings collapse to two classes -- cyclic and
# anti-cyclic -- and any dependence on the triple's winding shows up here as the
# anti-cyclic three disagreeing with the cyclic three.
#
# This is the assertion the 2026-08-06 filing said was MISSING. Its evidence for
# the one-ghost half was a Python transcription of the Cyrius source measured
# against an exact-rational oracle (462,846 of 463,086 CW-presented triples
# wrong) -- literal, but weaker than a first-party assertion, and the file said
# so.
# [measured: docs/development/issues/archived/2026-08-06-ghost-incircle-g1-g3-assume-ccw.md]
# This is that assertion, and it is deliberately an ORDER-CONSISTENCY test
# rather than a comparison against a truth oracle: consistency is exactly the
# property that was broken, and it needs no oracle to state.
fn _dlg1_perm_bad(pts, nr, k, px, py) {
    var g = nr + k;
    var ref = _col_dl_incircle(pts, nr, 1, 2, g, px, py);
    var bad = 0;
    if (_col_dl_incircle(pts, nr, 2, g, 1, px, py) != ref) { bad = bad + 1; }
    if (_col_dl_incircle(pts, nr, g, 1, 2, px, py) != ref) { bad = bad + 1; }
    if (_col_dl_incircle(pts, nr, 1, g, 2, px, py) != ref) { bad = bad + 1; }
    if (_col_dl_incircle(pts, nr, g, 2, 1, px, py) != ref) { bad = bad + 1; }
    if (_col_dl_incircle(pts, nr, 2, 1, g, px, py) != ref) { bad = bad + 1; }
    return bad;
}

# Grid: 4 edges (a, b) x 25 query points x 3 ghost directions x 6 orderings
# = 1800 probes, matching the all-ghost harness above.
#
# points[0] is the APEX and is deliberately NOT one of the triangle's vertices:
# nr = 3, the triple is (1, 2, ghost), and the ghosts are 3, 4, 5. That layout
# is load-bearing rather than cosmetic. When the edge is parallel to u_k the
# ghost direction cannot supply the winding, and the repair falls back to the
# apex's side of line(a, b) -- so an apex sitting ON the edge, or coinciding
# with a vertex, would silently exercise only the doubly-degenerate path and
# the fallback would never be tested. An earlier draft of this harness put the
# apex at points[0] = a and did exactly that.
#
# Edges 2 and 3 are deliberately PARALLEL to u_0 = (1, 2), presented in both
# directions: that is the configuration zeroing (b - a) x u_0, where the winding
# has to come from the apex instead. It is also the shape of the 2.9.1
# reproducer, so it guards that repair at the same time.
fn _dlg1_run() {
    _DLG1_PROBES = 0;
    _DLG1_BAD = 0;
    _DLG1_TIE = 0;
    var pts = vec_new();
    vec_push(pts, hvec2_new(f64_from(5), f64_from(1)));   # apex A, off every edge below
    vec_push(pts, hvec2_new(0, 0));                       # a
    vec_push(pts, hvec2_new(0, 0));                       # b
    for (var ei = 0; ei < 4; ei = ei + 1) {
        var axi = 0 - 2;
        var ayi = 0;
        var bxi = 0 - 4;
        var byi = 0 - 4;
        if (ei == 1) { axi = 3; ayi = 1; bxi = 1; byi = 0 - 5; }
        # edge parallel to u_0 = (1, 2) -- winding must come from the apex
        if (ei == 2) { axi = 0; ayi = 0; bxi = 2; byi = 4; }
        # the same edge presented the other way round
        if (ei == 3) { axi = 2; ayi = 4; bxi = 0; byi = 0; }
        vec_set(pts, 1, hvec2_new(f64_from(axi), f64_from(ayi)));
        vec_set(pts, 2, hvec2_new(f64_from(bxi), f64_from(byi)));
        for (var gx = 0 - 3; gx < 2; gx = gx + 1) {
            for (var gy = 0 - 3; gy < 2; gy = gy + 1) {
                var px = f64_from(gx);
                var py = f64_from(gy);
                for (var k = 0; k < 3; k = k + 1) {
                    _DLG1_BAD = _DLG1_BAD + _dlg1_perm_bad(pts, 3, k, px, py);
                    _DLG1_PROBES = _DLG1_PROBES + 6;
                    var abx = f64_from(bxi - axi);
                    var aby = f64_from(byi - ayi);
                    if (_col_f64_sign(f64_sub(f64_mul(abx, _col_ghost_uy(k)),
                          f64_mul(aby, _col_ghost_ux(k)))) == 0) {
                        _DLG1_TIE = _DLG1_TIE + 1;
                    }
                }
            }
        }
    }
}

# Deterministic probe grid: three ghost pairs -- CYCLIC when `anti` is 0, the
# ANTI-CYCLIC three when it is 1 -- times 3 apexes A, times 5 real vertices R,
# times 10 query points p. Five p are generic; the other five are
# p = R - t*(u_j - u_k), which zeroes the code's own M^3 cross product EXACTLY,
# whatever the six constants happen to be, so the tie branch is reached by
# construction rather than by luck. All coordinates are small integers or
# halves, so every product here is exact in f64.
#
# The cyclic half is the only one a CCW-stored triangle can hand
# _col_dl_ic_g2, and through 2.9.0 it was the only half any suite ran: the tie
# branch multiplied by the winding a second time, which is the identity there
# and a sign inversion on the anti-cyclic half.
fn _dlg_run(anti) {
    _DLG_PROBES = 0;
    _DLG_DECIDED = 0;
    _DLG_MISMATCH = 0;
    _DLG_TIE = 0;
    _DLG_INSIDE = 0;
    _DLG_TAIL = 0;
    _DLG_PERM = 0;
    var ga = alloc(48);
    store64(ga, 0); store64(ga + 8, 0);
    store64(ga + 16, 1); store64(ga + 24, 0 - 2);
    store64(ga + 32, 0 - 3); store64(ga + 40, 1);
    var gr = alloc(80);
    store64(gr, 2); store64(gr + 8, 1);
    store64(gr + 16, 0 - 1); store64(gr + 24, 3);
    store64(gr + 32, 4); store64(gr + 40, 0 - 2);
    store64(gr + 48, 0); store64(gr + 56, 5);
    store64(gr + 64, 0 - 4); store64(gr + 72, 0 - 4);
    var gq = alloc(80);
    store64(gq, 1); store64(gq + 8, 1);
    store64(gq + 16, 0 - 2); store64(gq + 24, 3);
    store64(gq + 32, 5); store64(gq + 40, 0);
    store64(gq + 48, 0); store64(gq + 56, 0 - 3);
    store64(gq + 64, 3); store64(gq + 72, 3);
    var gt = alloc(80);
    store64(gt, 1); store64(gt + 8, 1);
    store64(gt + 16, 2); store64(gt + 24, 1);
    store64(gt + 32, 0 - 1); store64(gt + 40, 1);
    store64(gt + 48, 1); store64(gt + 56, 2);
    store64(gt + 64, 0 - 3); store64(gt + 72, 1);
    var pts = vec_new();
    vec_push(pts, hvec2_new(0, 0));
    vec_push(pts, hvec2_new(0, 0));
    for (var gi = 0; gi < 3; gi = gi + 1) {
        var j = gi;
        var k = (gi + 1) % 3;
        if (anti == 1) {
            j = (gi + 1) % 3;
            k = gi;
        }
        var dx = f64_sub(_col_ghost_ux(j), _col_ghost_ux(k));
        var dy = f64_sub(_col_ghost_uy(j), _col_ghost_uy(k));
        var crv = _dlg_crossv(j, k);
        for (var ai = 0; ai < 3; ai = ai + 1) {
            var ax = f64_from(load64(ga + ai * 16));
            var ay = f64_from(load64(ga + ai * 16 + 8));
            vec_set(pts, 0, hvec2_new(ax, ay));
            for (var ri = 0; ri < 5; ri = ri + 1) {
                var rvx = f64_from(load64(gr + ri * 16));
                var rvy = f64_from(load64(gr + ri * 16 + 8));
                vec_set(pts, 1, hvec2_new(rvx, rvy));
                for (var qi = 0; qi < 10; qi = qi + 1) {
                    var px = f64_from(load64(gq + (qi % 5) * 16));
                    var py = f64_from(load64(gq + (qi % 5) * 16 + 8));
                    if (qi >= 5) {
                        var tv = f64_div(f64_from(load64(gt + (qi - 5) * 16)),
                          f64_from(load64(gt + (qi - 5) * 16 + 8)));
                        px = f64_sub(rvx, f64_mul(tv, dx));
                        py = f64_sub(rvy, f64_mul(tv, dy));
                    }
                    var rx = f64_sub(rvx, px);
                    var ry = f64_sub(rvy, py);
                    var qx = f64_sub(ax, px);
                    var qy = f64_sub(ay, py);
                    _DLG_PROBES = _DLG_PROBES + 1;
                    if (_col_f64_sign(f64_sub(f64_mul(rx, dy), f64_mul(ry, dx))) == 0) {
                        _DLG_TIE = _DLG_TIE + 1;
                    }
                    var e1x = f64_sub(rvx, ax);
                    var e1y = f64_sub(rvy, ay);
                    var ref = f64_mul(crv, f64_sub(
                        f64_add(f64_mul(e1x, e1x), f64_mul(e1y, e1y)),
                        f64_add(f64_mul(qx, qx), f64_mul(qy, qy))));
                    if (f64_eq(_dlg_c2(rx, ry, qx, qy, j, k), ref) == 0) {
                        _DLG_TAIL = _DLG_TAIL + 1;
                    }
                    _DLG_PERM = _DLG_PERM + _dlg_perm_bad(pts, j, k, px, py);
                    var want = _dlg_truth(rx, ry, qx, qy, j, k);
                    if (want >= 0) {
                        _DLG_DECIDED = _DLG_DECIDED + 1;
                        if (want == 1) { _DLG_INSIDE = _DLG_INSIDE + 1; }
                        if (_col_dl_ic_g2(pts, 1, j, k, px, py) != want) {
                            _DLG_MISMATCH = _DLG_MISMATCH + 1;
                        }
                    }
                }
            }
        }
    }
    return 0;
}

# _epa_tetra_ok, but safe to call on a seed buffer _epa_seed_portal never wrote:
# alloc() hands back zeroed pages, so the raw predicate dereferences four null
# HVec3s and takes the process down with SIGSEGV instead of printing a FAIL.
# Verified: with the origin nudge mutated out, the unguarded form exits 139.
fn _psd_ok(seed) {
    for (var i = 0; i < 4; i = i + 1) {
        if (load64(seed + i * 8) == 0) { return 0; }
    }
    return _epa_tetra_ok(seed);
}

# Push a triangle (index triple) onto a flat triangle vec.
fn _he_tri(t, a, b, c) { vec_push(t, a); vec_push(t, b); vec_push(t, c); return 0; }

# Count boundary vertices of a half-edge mesh over vertices 0..nv-1.
# ⚠ 3.0.0 — `halfedge_is_boundary` returns its ANSWER in the Ok payload, so this
# helper sums the PAYLOAD and not the tag. Summing `halfedge_is_boundary(...)`
# directly would add the tag — 0 for every success — and every count would read 0
# while still "passing" against a 0 expectation somewhere else.
fn _he_boundary_sum(m, nv) {
    var s = 0;
    var v = 0;
    while (v < nv) {
        var bt, bv = halfedge_is_boundary(m, v);
        if (is_ok(bt) == 1) { s = s + bv; }
        v = v + 1;
    }
    return s;
}

# MPR support functions. Sphere: shape = HVec4 (cx,cy,cz, radius);
# support(dir) = center + radius * normalize(dir).
fn _mpr_sup_sphere(shape, dir) {
    var c = hvec3_new(HVec4_x(shape), HVec4_y(shape), HVec4_z(shape));
    var dn = hvec3_normalize(dir);
    return hvec3_add(c, hvec3_scale(dn, HVec4_w(shape)));
}

# Axis-aligned box: shape = 6 f64 [cx,cy,cz, hx,hy,hz]; per-axis far corner.
fn _mpr_box_axis(c, h, d) {
    if (f64_lt(d, 0) == 1) { return f64_sub(c, h); }
    return f64_add(c, h);
}
fn _mpr_sup_box(shape, dir) {
    var rx = _mpr_box_axis(load64(shape), load64(shape + 24), HVec3_x(dir));
    var ry = _mpr_box_axis(load64(shape + 8), load64(shape + 32), HVec3_y(dir));
    var rz = _mpr_box_axis(load64(shape + 16), load64(shape + 40), HVec3_z(dir));
    return hvec3_new(rx, ry, rz);
}
fn _mpr_mkbox(cx, cy, cz, hx, hy, hz) {
    var s = alloc(48);
    store64(s, cx);
    store64(s + 8, cy);
    store64(s + 16, cz);
    store64(s + 24, hx);
    store64(s + 32, hy);
    store64(s + 40, hz);
    return s;
}

# --- 2.9.0: gjk_intersect_3d / gjk_epa_3d sibling-agreement sweep ---------
#
# The group below used to assert that the two agree while exercising the claim
# only on OVERLAPPING fixtures, so it stayed green through a period when they
# disagreed on 141 of 3,012 swept pair evaluations. These counters let the
# assertions police the whole fixture range instead: every fixture is run
# through BOTH entry points, in BOTH operand orders, and the aggregate is
# asserted.
#
# cls is the EXACT classification of the pair, established from rational
# arithmetic or a closed form and never from a hisab output. It is stated in
# terms of the MINIMUM TRANSLATION that separates the pair, because that is the
# quantity both entry points are answering about:
#   0  disjoint                -- both must report 0
#   1  touching, MTV exactly 0 -- the two must AGREE, and any depth reported
#                                 with a 1 must be 0 up to rounding
#   2  MTV strictly positive   -- both must report 1
# Note the third class is not "the intersection has interior": a zero-radius
# sphere strictly inside a box meets it in a single point, yet the MTV is the
# point's distance to the nearest face, so it belongs in class 2.
var _ag_pairs = 0;
var _ag_mismatch = 0;
var _ag_falsepos = 0;
var _ag_missov = 0;
var _ag_touch = 0;
var _ag_baddepth = 0;
var _ag_n_slot = 0;
var _ag_d_slot = 0;
# 2.9.1: the THIRD and FOURTH identically-documented entry points. The 2.9.0
# sweep compared gjk_intersect_3d against gjk_epa_3d only, and the 2026-08-05
# audit addendum records the consequence: mpr_intersect had drifted onto the
# pre-2.9.0 strict-containment answer and no assertion in any suite could see it.
# Both mpr entry points now ride the same fixtures.
var _ag_mprmis = 0;
var _ag_mprasym = 0;
var _ag_mprpen = 0;
var _ag_n_slot2 = 0;
var _ag_d_slot2 = 0;
# Size of the fixtures currently being swept. Set by the sweep before each
# block; the depth bound below is relative to it, because the sweep deliberately
# runs the same geometry at 2^-20 and 2^20 and an absolute bound would be
# meaningless at both ends.
var _ag_scale = 0;

fn _ag_eval(fa, sa, fb, sb, cls) {
    if (_ag_n_slot == 0) {
        _ag_n_slot = alloc(8);
        _ag_d_slot = alloc(8);
    }
    var gi = gjk_intersect_3d(fa, sa, fb, sb);
    var ge = gjk_epa_3d(fa, sa, fb, sb, _ag_n_slot, _ag_d_slot);
    _ag_pairs = _ag_pairs + 1;
    if (gi != ge) { _ag_mismatch = _ag_mismatch + 1; }
    if (cls == 0 && gi == 1) { _ag_falsepos = _ag_falsepos + 1; }
    if (cls == 2 && gi == 0) { _ag_missov = _ag_missov + 1; }
    if (cls == 1 && gi == 1) {
        _ag_touch = _ag_touch + 1;
        # The exact MTV of a class-1 pair is 0, so the reported depth must be 0
        # up to rounding, and never negative. It is NOT always exactly 0: the
        # touch probe writes an exact 0, but a tangency that GJK's own core
        # happens to enclose at rounding level goes through EPA instead and
        # comes back at 1e-20 .. 1e-24 for a unit-scale fixture. The bound below
        # is eight orders above the worst of those and twelve orders below any
        # real penetration, so it separates the two without excusing either.
        var ag_d = load64(_ag_d_slot);
        if (f64_lt(ag_d, 0) == 1) { _ag_baddepth = _ag_baddepth + 1; }
        elif (f64_gt(ag_d, f64_mul(_ag_scale, TOL_1EM14)) == 1) {
            _ag_baddepth = _ag_baddepth + 1;
        }
    }
    # 2.9.1: the mpr siblings ride the same fixtures. mpr_intersect must equal
    # gjk_intersect_3d and must not depend on argument order; mpr_penetration
    # must equal gjk_epa_3d. Scored against the exact pre-2.9.1 bodies on THESE
    # 110 evaluations (scratch harness, both bodies transcribed verbatim, run on
    # this tree): mprmis = 9, mprasym = 2, mprpen = 13.
    if (_ag_n_slot2 == 0) {
        _ag_n_slot2 = alloc(8);
        _ag_d_slot2 = alloc(8);
    }
    var mi = mpr_intersect(fa, sa, fb, sb);
    if (mi != gi) { _ag_mprmis = _ag_mprmis + 1; }
    if (mi != mpr_intersect(fb, sb, fa, sa)) { _ag_mprasym = _ag_mprasym + 1; }
    store64(_ag_d_slot2, 0);
    if (mpr_penetration(fa, sa, fb, sb, _ag_n_slot2, _ag_d_slot2) != ge) {
        _ag_mprpen = _ag_mprpen + 1;
    }
    return 0;
}

# Both operand orders. The 2.8.3 tangency defect showed up in both, and an
# overlap test that is not symmetric is broken whatever else it does.
fn _ag_pair(fa, sa, fb, sb, cls) {
    _ag_eval(fa, sa, fb, sb, cls);
    _ag_eval(fb, sb, fa, sa, cls);
    return 0;
}

# n sixteenths. Dyadic, so the value is exact in f64 AND exact in the rational
# arithmetic the classifications were computed in.
fn _ag_q(n) { return f64_div(f64_from(n), f64_from(16)); }

# Same, scaled by a power of two -- still exact, and it moves a fixture to a
# scene scale where an ABSOLUTE epsilon anywhere in the stack would show up.
fn _ag_qs(n, p2) { return f64_mul(_ag_q(n), p2); }

fn _ag_box(cx, cy, cz, hx, hy, hz) {
    return _mpr_mkbox(_ag_q(cx), _ag_q(cy), _ag_q(cz), _ag_q(hx), _ag_q(hy), _ag_q(hz));
}

fn _ag_sph(cx, cy, cz, r) {
    return hvec4_new(_ag_q(cx), _ag_q(cy), _ag_q(cz), _ag_q(r));
}

# Elementwise Hermiticity test: A[i][j] == conj(A[j][i]) for EVERY (i,j),
# checked on the raw components. Deliberately does NOT go through
# cmat_adjoint: that writes r[j][i] = cx_conj(m[i][j]) and cx_conj copies the
# real part unchanged, so "Re(A[0][0]) == Re(adjoint(A)[0][0])" is an identity
# for every complex matrix ever built. Returns 1 (Hermitian) or 0.
# At i == j the Im test becomes Im + Im == 0, i.e. the diagonal must be real.
# f64_eq is IEEE equality, so +0.0 and -0.0 compare equal (cx_conj turns the
# +0.0 imaginary parts of the real generators into -0.0).
fn _gm_is_herm(m) {
    var n = cmat_rows(m);
    var i = 0;
    while (i < n) {
        var j = 0;
        while (j < n) {
            var a = cmat_get(m, i, j);
            var b = cmat_get(m, j, i);
            if (f64_eq(HComplex_re(a), HComplex_re(b)) == 0) { return 0; }
            if (f64_eq(f64_add(HComplex_im(a), HComplex_im(b)), 0) == 0) { return 0; }
            j = j + 1;
        }
        i = i + 1;
    }
    return 1;
}

# Brute-force reference for kdtree_within_radius.
fn _kdv_brute(points, n, query, radius) {
    var rsq = f64_mul(radius, radius);
    var c = 0;
    var i = 0;
    while (i < n) {
        var p = load64(points + i * 8);
        var dx = f64_sub(HVec3_x(p), HVec3_x(query));
        var dy = f64_sub(HVec3_y(p), HVec3_y(query));
        var dz = f64_sub(HVec3_z(p), HVec3_z(query));
        var d2 = f64_add(f64_add(f64_mul(dx, dx), f64_mul(dy, dy)), f64_mul(dz, dz));
        if (f64_gt(d2, rsq) == 0) { c = c + 1; }
        i = i + 1;
    }
    return c;
}

# Walk the tree and count points that sit on the WRONG side of their ancestor's
# pruning plane. This is the invariant the whole query algorithm rests on:
# every point in a left subtree has axis <= split_val, every point on the right
# has axis >= split_val. Returns the violation count.
fn _kdv_side_bad(node, points, axis, plane, want_le) {
    if (node == 0) { return 0; }
    var bad = 0;
    var pidx = _kd_node_point_idx(node);
    if (pidx != 0 - 1) {
        var pt = load64(points + pidx * 8);
        var v = _kd_axis_val(pt, axis);
        if (want_le == 1) {
            if (f64_gt(v, plane) == 1) { bad = 1; }
        } else {
            if (f64_lt(v, plane) == 1) { bad = 1; }
        }
        return bad;
    }
    bad = bad + _kdv_side_bad(_kd_node_left(node), points, axis, plane, want_le);
    bad = bad + _kdv_side_bad(_kd_node_right(node), points, axis, plane, want_le);
    return bad;
}

# Depth of the deepest leaf. 2.9.3: the balance guard had NO regression
# assertion -- the two that guarded it (`kdtree_build != 0` and the split-plane
# invariant) both hold perfectly well on a degenerate 500-deep spine, so
# deleting the guard broke nothing that was being checked. Depth is the
# property the guard actually provides, so depth is what has to be asserted.
fn _kdv_depth(node) {
    if (node == 0) { return 0; }
    var l = _kdv_depth(_kd_node_left(node));
    var r = _kdv_depth(_kd_node_right(node));
    if (l > r) { return l + 1; }
    return r + 1;
}

fn _kdv_invariant_bad(node, points) {
    if (node == 0) { return 0; }
    if (_kd_node_point_idx(node) != 0 - 1) { return 0; }
    var axis = _kd_node_split_axis(node);
    var plane = _kd_node_split_val(node);
    var bad = _kdv_side_bad(_kd_node_left(node), points, axis, plane, 1);
    bad = bad + _kdv_side_bad(_kd_node_right(node), points, axis, plane, 0);
    bad = bad + _kdv_invariant_bad(_kd_node_left(node), points);
    bad = bad + _kdv_invariant_bad(_kd_node_right(node), points);
    return bad;
}

# dy/dt = y for the implicit integrators.
fn _cv_dydt_y(t, y) { return y; }
# SHO acceleration for leapfrog.
fn _cv_accel(q) { return f64_neg(q); }

fn _c9_f(x) { var a = load64(x); var b = load64(x + 8); return f64_add(f64_mul(a, a), f64_mul(b, b)); }
fn _c9_g(x, out) {
    store64(out, f64_mul(F64_TWO, load64(x)));
    store64(out + 8, f64_mul(F64_TWO, load64(x + 8)));
    return 0;
}
fn _c9_x2(x) { return f64_mul(x, x); }

# --- calc_ext: Hessian mixed partials (2.8.x test-quality repair) -----------
# f(x, y) = x^2*y + y^3. NOT separable, so the true mixed partial d2f/dxdy = 2x
# is nonzero -- unlike _c9_f above (x^2 + y^2), whose Hessian is 2I and whose
# zero off-diagonal is reproduced by ANY sign arrangement of the 4-point cross
# stencil, including deleting the block outright.
# Total degree 3, and both a central second difference and the cross stencil are
# exact through total degree 3, so the finite differences here are the TRUE
# derivatives bit-for-bit at any step size.
fn _hx_f(x) {
    var a = load64(x);
    var b = load64(x + 8);
    return f64_add(f64_mul(f64_mul(a, a), b), f64_mul(f64_mul(b, b), b));
}

# --- calc_ext: adaptive Simpson integrands (2.8.x test-quality repair) ------
# Every integrand counts its own evaluations. The count is the direct evidence
# that the refinement machinery runs: x^2 is integrated exactly by the single
# initial panel and stops at 3 evaluations, everything below does not.
var _as_calls = 0;

fn _as_x2(x) { _as_calls = _as_calls + 1; return f64_mul(x, x); }

fn _as_x4(x) {
    _as_calls = _as_calls + 1;
    var x2 = f64_mul(x, x);
    return f64_mul(x2, x2);
}

# Unbounded derivative at 0: the error concentrates in one corner, so reaching
# 1e-11 is only possible if the subdivision is NON-UNIFORM.
fn _as_sqrt(x) { _as_calls = _as_calls + 1; return f64_sqrt(x); }

# 1/(1+x): no Simpson panel is ever exact, so every level contributes.
fn _as_recip(x) {
    _as_calls = _as_calls + 1;
    return f64_div(F64_ONE, f64_add(F64_ONE, x));
}

# Lorentzian of half-width 1/20 centred in [0,1]: 1 / (1 + 400 (x - 1/2)^2).
# Integral over [0,1] = (1/10) atan(10). One unrefined panel is 355% wrong.
fn _as_peak(x) {
    _as_calls = _as_calls + 1;
    var d = f64_sub(x, F64_HALF);
    return f64_div(F64_ONE, f64_add(F64_ONE, f64_mul(f64_from(400), f64_mul(d, d))));
}

# --- lie_ext: do two SE(3) elements act identically? ------------------------
# Four points (the origin plus the three axes) determine a rigid motion, so
# agreement on all four is agreement everywhere. Used to check the defining
# adjoint identity exp(Ad_g xi) == g exp(xi) g^-1 without reaching into the
# internal layout of either operand.
fn _se_same(a, b) {
    var pts = alloc(32);
    store64(pts, hvec3_zero());
    store64(pts + 8, hvec3_unit_x());
    store64(pts + 16, hvec3_unit_y());
    store64(pts + 24, hvec3_unit_z());
    for (var i = 0; i < 4; i = i + 1) {
        var p = load64(pts + i * 8);
        var qa = se3_transform_point(a, p);
        var qb = se3_transform_point(b, p);
        if (f64_lt(f64_abs(f64_sub(HVec3_x(qa), HVec3_x(qb))), LOOSE_TOL_M) == 0) { return 0; }
        if (f64_lt(f64_abs(f64_sub(HVec3_y(qa), HVec3_y(qb))), LOOSE_TOL_M) == 0) { return 0; }
        if (f64_lt(f64_abs(f64_sub(HVec3_z(qa), HVec3_z(qb))), LOOSE_TOL_M) == 0) { return 0; }
    }
    return 1;
}

# --- delaunay_2d: winding (2.8.x test-quality repair) -----------------------
# How many emitted triangles are NOT strictly counter-clockwise. delaunay_2d
# documents CCW output and normalises for it at emit time, and every other
# delaunay assertion in this file is orientation-blind -- |signed area| for the
# hull-coverage harness, plus edge-share count, point usage and the
# empty-circumcircle test, none of which a clockwise triangle violates. This is
# the only check that can see the normalisation at all.
fn _dl_non_ccw(p, t) {
    var bad = 0;
    for (var k = 0; k < vec_len(t); k = k + 3) {
        var a = vec_get(p, vec_get(t, k));
        var b = vec_get(p, vec_get(t, k + 1));
        var c = vec_get(p, vec_get(t, k + 2));
        var s = _col_triangle_area_2x(HVec2_x(a), HVec2_y(a),
          HVec2_x(b), HVec2_y(b), HVec2_x(c), HVec2_y(c));
        if (f64_gt(s, 0) == 0) { bad = bad + 1; }
    }
    return bad;
}

fn _c80_sq(x) { return f64_mul(x, x); }
fn _c80_f(x) { var a = load64(x); return f64_mul(a, a); }
fn _c80_g(x, out) { store64(out, f64_mul(F64_TWO, load64(x))); return 0; }
fn _c80_sde_f(t, y) { return 0; }
fn _c80_sde_g(t, y) { return F64_ONE; }

# --- 2.8.3: support functions for the gjk_epa_3d (EPA) fixtures ---
# Every one bumps _ga_sup_calls. EPA issues exactly one Minkowski support query
# (= two of these) per iteration, so the counter is a direct, black-box read of
# how many EPA iterations a call ran -- which is what the arena budget below is
# normalised against.
var _ga_sup_calls = 0;

# Sphere: shape = HVec4 [cx, cy, cz, r]
fn _ga_sup_sphere(shape, dir) {
    _ga_sup_calls = _ga_sup_calls + 1;
    var dn = hvec3_normalize(dir);
    var r = HVec4_w(shape);
    return hvec3_new(f64_add(HVec4_x(shape), f64_mul(HVec3_x(dn), r)),
      f64_add(HVec4_y(shape), f64_mul(HVec3_y(dn), r)),
      f64_add(HVec4_z(shape), f64_mul(HVec3_z(dn), r)));
}

# Cylinder about +z: shape = [cx, cy, cz, radius, half_height]
fn _ga_mkcyl(cx, cy, cz, r, hz) {
    var s = alloc(40);
    store64(s, cx); store64(s + 8, cy); store64(s + 16, cz);
    store64(s + 24, r); store64(s + 32, hz);
    return s;
}
fn _ga_sup_cyl(shape, dir) {
    _ga_sup_calls = _ga_sup_calls + 1;
    var dx = HVec3_x(dir);
    var dy = HVec3_y(dir);
    var rho = f64_sqrt(f64_add(f64_mul(dx, dx), f64_mul(dy, dy)));
    var px = 0;
    var py = 0;
    if (f64_gt(rho, 0) == 1) {
        px = f64_mul(load64(shape + 24), f64_div(dx, rho));
        py = f64_mul(load64(shape + 24), f64_div(dy, rho));
    }
    var pz = load64(shape + 32);
    if (f64_lt(HVec3_z(dir), 0) == 1) { pz = f64_neg(pz); }
    return hvec3_new(f64_add(load64(shape), px), f64_add(load64(shape + 8), py),
      f64_add(load64(shape + 16), pz));
}

# Oriented box: shape = [cx, cy, cz, hx, hy, hz, qx, qy, qz, qw]
fn _ga_mkobb(cx, cy, cz, hx, hy, hz, qx, qy, qz, qw) {
    var s = alloc(80);
    store64(s, cx); store64(s + 8, cy); store64(s + 16, cz);
    store64(s + 24, hx); store64(s + 32, hy); store64(s + 40, hz);
    store64(s + 48, qx); store64(s + 56, qy); store64(s + 64, qz); store64(s + 72, qw);
    return s;
}
fn _ga_sup_obb(shape, dir) {
    _ga_sup_calls = _ga_sup_calls + 1;
    var q = hquat_new(load64(shape + 48), load64(shape + 56), load64(shape + 64), load64(shape + 72));
    var ld = hquat_rotate_vec3(hquat_conjugate(q), dir);
    var lx = load64(shape + 24);
    var ly = load64(shape + 32);
    var lz = load64(shape + 40);
    if (f64_lt(HVec3_x(ld), 0) == 1) { lx = f64_neg(lx); }
    if (f64_lt(HVec3_y(ld), 0) == 1) { ly = f64_neg(ly); }
    if (f64_lt(HVec3_z(ld), 0) == 1) { lz = f64_neg(lz); }
    var wp = hquat_rotate_vec3(q, hvec3_new(lx, ly, lz));
    return hvec3_new(f64_add(load64(shape), HVec3_x(wp)),
      f64_add(load64(shape + 8), HVec3_y(wp)),
      f64_add(load64(shape + 16), HVec3_z(wp)));
}
# --- 2.8.3 memory-safety helpers ---------------------------------
# Deterministic LCG shared with the Python reference in the audit workflow record;
# every value stays under 2^61 so the i64 multiply cannot wrap.
var _m3_lcg = 12345;
fn _m3_next() {
    _m3_lcg = (_m3_lcg * 1103515245 + 12345) % 2147483648;
    return _m3_lcg % 21 - 10;
}
# Cell index k -> coordinate k + 0.5, so floor() is exact for both signs.
fn _m3_cc(k) { return f64_add(f64_from(k), F64_HALF); }
fn _m3_shq(sh, qx, qy, qz, r) {
    return vec_len(spatial_hash_query_radius(sh,
        hvec3_new(_m3_cc(qx), _m3_cc(qy), _m3_cc(qz)), f64_from(r)));
}
# --- 2.8.3 api-consistency helpers ---
# Squared length of the HVec3 at a store64 slot, as an integer scaled by 1e9.
# Used to assert "the reported normal is a unit vector", which is also the
# assertion that it is not the NULL pointer the pre-2.8.3 code stored (a null
# would fault in HVec3_x long before the comparison).
fn _ac_len_sq_e9(nptr) {
    var n = load64(nptr);
    var l = hvec3_length_sq(n);
    return f64_to(f64_round(f64_mul(l, f64_from(1000000000))));
}
fn _ac_comp_e9(nptr, axis) {
    var n = load64(nptr);
    var c = HVec3_x(n);
    if (axis == 1) { c = HVec3_y(n); }
    if (axis == 2) { c = HVec3_z(n); }
    return f64_to(f64_round(f64_mul(c, f64_from(1000000000))));
}
# --- calc_monotone_cubic shape oracle (2.8.3) ------------------------------
# The CONTRACT, not a reference implementation: on [xs[k], xs[k+1]] the
# interpolant may not leave [ys[k], ys[k+1]]. Worst violation over a 1/steps
# grid across every interval; 0 when the function honours its own name.
fn _mc_box_violation(xs, ys, n, steps) {
    var worst = 0;
    var k = 0;
    while (k < n - 1) {
        var xk = _f64arr_get(xs, k);
        var xk1 = _f64arr_get(xs, k + 1);
        var lo = f64_min(_f64arr_get(ys, k), _f64arr_get(ys, k + 1));
        var hi = f64_max(_f64arr_get(ys, k), _f64arr_get(ys, k + 1));
        var s = 0;
        while (s <= steps) {
            var u = f64_div(f64_from(s), f64_from(steps));
            var v = calc_monotone_cubic(xs, ys, n,
              f64_add(xk, f64_mul(u, f64_sub(xk1, xk))));
            if (f64_gt(f64_sub(v, hi), worst) == 1) { worst = f64_sub(v, hi); }
            if (f64_gt(f64_sub(lo, v), worst) == 1) { worst = f64_sub(lo, v); }
            s = s + 1;
        }
        k = k + 1;
    }
    return worst;
}

# Largest step taken AGAINST the direction of interval k's own secant.
fn _mc_backstep(xs, ys, n, k, steps) {
    var xk = _f64arr_get(xs, k);
    var xk1 = _f64arr_get(xs, k + 1);
    var up = 1;
    if (f64_lt(_f64arr_get(ys, k + 1), _f64arr_get(ys, k)) == 1) { up = 0; }
    var worst = 0;
    var prev = calc_monotone_cubic(xs, ys, n, xk);
    var s = 1;
    while (s <= steps) {
        var u = f64_div(f64_from(s), f64_from(steps));
        var v = calc_monotone_cubic(xs, ys, n,
          f64_add(xk, f64_mul(u, f64_sub(xk1, xk))));
        var d = f64_sub(v, prev);
        if (up == 0) { d = f64_neg(d); }
        if (f64_lt(d, 0) == 1) {
            if (f64_gt(f64_neg(d), worst) == 1) { worst = f64_neg(d); }
        }
        prev = v;
        s = s + 1;
    }
    return worst;
}

# --- time_of_impact exact references (2.8.3) -------------------------------
# Exact first-contact time of two TRANSLATING spheres: the smaller root of
# |d + w t|^2 = R^2. Closed form, so it inherits nothing from the code under
# test. Returns -1 when they never touch.
fn _toi_ref_sphere(ca, ra, va, cb, rb, vb) {
    var d = hvec3_sub(cb, ca);
    var w = hvec3_sub(vb, va);
    var rr = f64_add(ra, rb);
    var qa = hvec3_dot(w, w);
    var qb = hvec3_dot(d, w);
    var qc = f64_sub(hvec3_dot(d, d), f64_mul(rr, rr));
    if (f64_le(qc, 0) == 1) { return 0; }
    # `qa <= 0`, not `qa < EPSILON_F64`: qa is a SQUARED speed, so on 1e-6-scale
    # geometry it is ~1e-12 for a perfectly ordinary approach and an absolute
    # 1e-12 floor makes this oracle declare "never collides" for half of them.
    # The first draft did exactly that and blamed the three resulting
    # disagreements on the code under test.
    if (f64_le(qa, 0) == 1) { return f64_neg(F64_ONE); }
    var disc = f64_sub(f64_mul(qb, qb), f64_mul(qa, qc));
    if (f64_lt(disc, 0) == 1) { return f64_neg(F64_ONE); }
    var t = f64_div(f64_sub(f64_neg(qb), f64_sqrt(disc)), qa);
    if (f64_lt(t, 0) == 1) { return f64_neg(F64_ONE); }
    return t;
}

# Tally block: [0] cases [1] collide [2] miss [3] falsepos [4] late [5] early
fn _toi_tally() {
    var s = alloc(48);
    for (var i = 0; i < 6; i = i + 1) { store64(s + i * 8, 0); }
    return s;
}
fn _toi_bump(s, i) {
    store64(s + i * 8, load64(s + i * 8) + 1);
    return 0;
}

# Score one sphere-vs-sphere sweep (A at the origin, stationary) against the
# exact root. `late`/`early` also catch a null out_normal, which the pre-2.8.3
# code could store whenever EPA failed on the contact polytope.
fn _toi_score(tally, ra, cb, rb, vb, max_t, tol_t) {
    var exact = _toi_ref_sphere(hvec3_zero(), ra, hvec3_zero(), cb, rb, vb);
    var sa = hvec4_new(0, 0, 0, ra);
    var sb = hvec4_new(HVec3_x(cb), HVec3_y(cb), HVec3_z(cb), rb);
    var ot = alloc(8);
    var on = alloc(8);
    store64(on, 0);
    var got = time_of_impact(&_mpr_sup_sphere, sa, hvec3_zero(),
      &_mpr_sup_sphere, sb, vb, max_t, ot, on);

    _toi_bump(tally, 0);
    var should = 0;
    if (f64_ge(exact, 0) == 1 && f64_le(exact, max_t) == 1) { should = 1; }
    if (should == 1) { _toi_bump(tally, 1); }
    if (should == 1 && got == 0) { _toi_bump(tally, 2); }
    if (should == 0 && got == 1) { _toi_bump(tally, 3); }
    if (got == 1 && load64(on) == 0) { _toi_bump(tally, 5); }
    if (should == 1 && got == 1) {
        var dt = f64_sub(load64(ot), exact);
        if (f64_gt(dt, tol_t) == 1) { _toi_bump(tally, 4); }
        if (f64_lt(dt, f64_neg(tol_t)) == 1) { _toi_bump(tally, 5); }
    }
    return 0;
}

# Deterministic f64 in [lo/den, hi/den] from the shared splitmix64 stream.
fn _toi_frac(lo, hi, den) {
    var r = _dlr_next();
    if (r < 0) { r = 0 - r; }
    return f64_div(f64_from(lo + (r % (hi - lo + 1))), f64_from(den));
}

alloc_init();

# Helpers and fixtures defined after the shared header in modules.tcyr, which the groups
# below reuse: the NaN helper, the MPR OBB support, the Delaunay fixtures and the einsum operands.
var _g6_nan = 0x7FF8000000000000;

fn _g6_nan3(v) {
    var c = 0;
    if (f64_eq(HVec3_x(v), HVec3_x(v)) == 0) { c = c + 1; }
    if (f64_eq(HVec3_y(v), HVec3_y(v)) == 0) { c = c + 1; }
    if (f64_eq(HVec3_z(v), HVec3_z(v)) == 0) { c = c + 1; }
    return c;
}

# Oriented box: 15 slots [cx,cy,cz, hx,hy,hz, u0(3), u1(3), u2(3)].
fn _mpr_sup_obb(shape, dir) {
    var acc = hvec3_new(load64(shape), load64(shape + 8), load64(shape + 16));
    for (var oi = 0; oi < 3; oi = oi + 1) {
        var u = hvec3_new(load64(shape + 48 + oi * 24), load64(shape + 56 + oi * 24),
          load64(shape + 64 + oi * 24));
        var hh = load64(shape + 24 + oi * 8);
        if (f64_lt(hvec3_dot(dir, u), 0) == 1) { hh = f64_neg(hh); }
        acc = hvec3_add(acc, hvec3_scale(u, hh));
    }
    return acc;
}

fn _mpr_mkobb(cx, cy, cz, hx, hy, hz) {
    var s = alloc(120);
    store64(s, cx);
    store64(s + 8, cy);
    store64(s + 16, cz);
    store64(s + 24, hx);
    store64(s + 32, hy);
    store64(s + 40, hz);
    for (var oi = 0; oi < 9; oi = oi + 1) { store64(s + 48 + oi * 8, 0); }
    store64(s + 48, F64_ONE);
    store64(s + 80, F64_ONE);
    store64(s + 112, F64_ONE);
    return s;
}

fn _mpr_obb_axis(s, i, x, y, z) {
    store64(s + 48 + i * 24, x);
    store64(s + 56 + i * 24, y);
    store64(s + 64 + i * 24, z);
    return 0;
}

fn _es_mk2(r2, c2, v0, v1, v2, v3) {
    var sh = alloc(16);
    store64(sh, r2);
    store64(sh + 8, c2);
    var t = tensor_new(2, sh);
    var d = HTensor_data(t);
    store64(d, v0);
    store64(d + 8, v1);
    store64(d + 16, v2);
    store64(d + 24, v3);
    return t;
}

var dl_sq = vec_new();
vec_push(dl_sq, hvec2_new(0, 0));
vec_push(dl_sq, hvec2_new(f64_from(4), 0));
vec_push(dl_sq, hvec2_new(f64_from(4), f64_from(4)));
vec_push(dl_sq, hvec2_new(0, f64_from(4)));
vec_push(dl_sq, hvec2_new(F64_ONE, F64_ONE));
var dl_sqt = delaunay_2d(dl_sq, 5);
var dl_g = vec_new();
vec_push(dl_g, hvec2_new(0, 0));
vec_push(dl_g, hvec2_new(F64_ONE, 0));
vec_push(dl_g, hvec2_new(F64_TWO, 0));
vec_push(dl_g, hvec2_new(0, F64_ONE));
vec_push(dl_g, hvec2_new(F64_ONE, F64_ONE));
vec_push(dl_g, hvec2_new(F64_TWO, F64_ONE));
vec_push(dl_g, hvec2_new(0, F64_TWO));
vec_push(dl_g, hvec2_new(F64_ONE, F64_TWO));
vec_push(dl_g, hvec2_new(F64_TWO, F64_TWO));
var dl_gt = delaunay_2d(dl_g, 9);
var dl_i = vec_new();
vec_push(dl_i, hvec2_new(0, 0));
vec_push(dl_i, hvec2_new(f64_from(5), F64_ONE));
vec_push(dl_i, hvec2_new(f64_from(3), f64_from(4)));
vec_push(dl_i, hvec2_new(F64_ONE, f64_from(5)));
vec_push(dl_i, hvec2_new(f64_from(6), f64_from(5)));
vec_push(dl_i, hvec2_new(F64_TWO, F64_TWO));
var dl_it = delaunay_2d(dl_i, 6);
var es_A = _es_mk2(2, 2, f64_from(1), f64_from(2), f64_from(3), f64_from(4));
var es_B = _es_mk2(2, 2, f64_from(5), f64_from(6), f64_from(7), f64_from(8));
var es_two = alloc(16);
store64(es_two, es_A);
store64(es_two + 8, es_B);
var es_one = alloc(8);
store64(es_one, es_A);
var es_A = ganita_mat_new(2, 2);

test_group("2.7.3 coverage: autodiff, tensor, interval, calc_ext, cga, patterns");

# --- autodiff duals: value and derivative are both exact here.
var d9 = dual_new(f64_from(3), F64_ONE);
assert_eq(Dual_val(d9), f64_from(3), "dual_new value");
assert_eq(Dual_deriv(d9), f64_from(1), "dual_new derivative");
# d/dx (x/2) at x=4 is 1/2.
var dq = dual_div(dual_var(f64_from(4)), dual_const(F64_TWO));
assert_eq(Dual_val(dq), f64_from(2), "dual_div value 4/2 = 2");
assert_eq(Dual_deriv(dq), F64_HALF, "dual_div derivative = 1/2");
# d/dx x^3 at x=2 is 12.
# n is a plain f64, not an integer -- a raw 3 is a subnormal ~1.5e-323.
var dp = dual_pow(dual_var(F64_TWO), f64_from(3));
# ⭐ EXACT, NOT A TOLERANCE, SINCE ganita 1.2.4. This read "f64_pow goes through
# exp/ln, so 2^3 is 7.999... -- tolerance, not equality" and used a tolerance. Binary
# exponentiation made it exact, so the tolerance was hiding the improvement AND
# admitting any future regression up to LOOSE_TOL_M. Asserted as BITS now:
# dual_pow(2,3).val is 0x4020000000000000, identical to f64_from(8).
# [measured: scratch harness, not reproducible in-tree, 2026-09-09; ganita 1.2.4]
assert_eq(Dual_val(dp), f64_from(8), "dual_pow value 2^3 = 8, bit-exact");
assert(f64_lt(f64_abs(f64_sub(Dual_deriv(dp), f64_from(12))), LOOSE_TOL_M) == 1,
  "dual_pow derivative 3x^2 = 12");
# |x| at x=-5 is 5 with derivative -1.
var da = dual_abs(dual_var(f64_neg(f64_from(5))));
assert_eq(Dual_val(da), f64_from(5), "dual_abs value = 5");
assert_eq(Dual_deriv(da), f64_neg(f64_from(1)), "dual_abs derivative = -1");

# --- tensor: get/set/scale/contract with exact integers.
var t9_shape = alloc(16);
store64(t9_shape, 2); store64(t9_shape + 8, 2);
var t9 = tensor_new(2, t9_shape);
var t9_i = alloc(16);
store64(t9_i, 0); store64(t9_i + 8, 1);
tensor_set(t9, t9_i, f64_from(7));
assert_eq(tensor_get(t9, t9_i), f64_from(7), "tensor_set/get round-trips");
var t9s = tensor_scale(t9, f64_from(3));
assert_eq(tensor_get(t9s, t9_i), f64_from(21), "tensor_scale multiplies entries");
# Trace of diag(2,5) is 7.
tensor_set2(t9, 0, 0, F64_TWO);
tensor_set2(t9, 0, 1, 0);
tensor_set2(t9, 1, 1, f64_from(5));
assert_eq(tensor_get2(t9, 1, 1), f64_from(5), "tensor_set2/get2 round-trips");
var t9c = tensor_contract(t9, 0, 1);
assert_neq(t9c, 0, "tensor_contract returns a tensor");

# --- interval: exp is monotone, so the enclosure is [e^lo, e^hi].
var iv9 = ivl_exp(ivl_new(0, F64_ONE));
assert(f64_lt(f64_abs(f64_sub(Interval_lo(iv9), F64_ONE)), LOOSE_TOL_M) == 1, "ivl_exp lower = e^0 = 1");
assert(f64_gt(Interval_hi(iv9), F64_TWO) == 1, "ivl_exp upper = e^1 > 2");
assert(f64_lt(Interval_lo(iv9), Interval_hi(iv9)) == 1, "ivl_exp enclosure is ordered");

# --- calc_ext derivatives of f(x,y) = x^2 + y^2 at (3,4): grad = (6,8).
var c9_x = alloc(16);
store64(c9_x, f64_from(3)); store64(c9_x + 8, f64_from(4));
var c9_h = f64_div(F64_ONE, f64_from(1000));
var c9_pd = calc_partial_derivative(&_c9_f, c9_x, 2, 0, c9_h);
assert(f64_lt(f64_abs(f64_sub(c9_pd, f64_from(6))), LOOSE_TOL_M) == 1, "partial d/dx = 6");
var c9_gr = alloc(16);
var _r15t, _r15v = calc_gradient(&_c9_f, c9_x, 2, c9_h, c9_gr);
assert(f64_lt(f64_abs(f64_sub(load64(c9_gr + 8), f64_from(8))), LOOSE_TOL_M) == 1, "gradient y = 8");
# Hessian of x^2+y^2 is 2I.
var c9_he = alloc(32);
var _r16t, _r16v = calc_hessian(&_c9_f, c9_x, 2, c9_h, c9_he);
assert(f64_lt(f64_abs(f64_sub(load64(c9_he), F64_TWO)), f64_div(F64_ONE, f64_from(1000))) == 1,
  "hessian [0][0] = 2");
# Jacobian of the gradient map is the same 2I.
var c9_ja = alloc(32);
var _r17t, _r17v = calc_jacobian(&_c9_g, c9_x, 2, 2, c9_h, c9_ja);
assert(f64_lt(f64_abs(f64_sub(load64(c9_ja), F64_TWO)), f64_div(F64_ONE, f64_from(1000))) == 1,
  "jacobian [0][0] = 2");

# --- calc_hessian: the mixed-partial block (2.8.x) -------------------------
# The Hessian assertion above pins ONE diagonal entry of 2I on a separable
# integrand. The off-diagonal 4-point cross stencil in calc_ext.cyr was covered
# by nothing at all: for x^2 + y^2 the true mixed partial is zero, so every
# sign arrangement of the four terms -- and deleting the block entirely --
# reproduces it.
#
# f(x, y) = x^2*y + y^3 at (3, 4). Exact derivatives fxx = 2y = 8,
# fyy = 6y = 24, fxy = 2x = 6. The integrand is a cubic and both stencils are
# exact through total degree 3, so the computed values are the true ones
# bit-for-bit -- verified in exact rationals (python3 fractions) AND by
# replaying the implementation's own operation order in IEEE-754, which returns
# 8.0 / 24.0 / 6.0 with zero error. These are equalities, not tolerances.
#
# Asserted at TWO step sizes because h = 1/2 makes 4h^2 exactly 1, which would
# hide any mutation of the inv_4h2 divisor; at h = 1 the divisor is 4.
var hx_x = alloc(16);
store64(hx_x, f64_from(3)); store64(hx_x + 8, f64_from(4));
var hx_he = alloc(32);
var _rq99t, _rq99v = calc_hessian(&_hx_f, hx_x, 2, F64_HALF, hx_he);
assert_eq(is_ok(_rq99t), 1, "calc_hessian returns HSB_ERR_NONE");
assert_eq(load64(hx_he), f64_from(8), "hessian x^2y+y^3 h=1/2: H[0][0] = 2y = 8 exactly");
assert_eq(load64(hx_he + 24), f64_from(24), "hessian x^2y+y^3 h=1/2: H[1][1] = 6y = 24 exactly");
assert_eq(load64(hx_he + 8), f64_from(6), "hessian x^2y+y^3 h=1/2: H[0][1] = 2x = 6 exactly");
assert_eq(load64(hx_he + 16), load64(hx_he + 8), "hessian: H[1][0] == H[0][1] (stored symmetric)");

var hx_he1 = alloc(32);
var _r18t, _r18v = calc_hessian(&_hx_f, hx_x, 2, F64_ONE, hx_he1);
assert_eq(load64(hx_he1), f64_from(8), "hessian x^2y+y^3 h=1: H[0][0] = 8 exactly");
assert_eq(load64(hx_he1 + 24), f64_from(24), "hessian x^2y+y^3 h=1: H[1][1] = 24 exactly");
assert_eq(load64(hx_he1 + 8), f64_from(6), "hessian x^2y+y^3 h=1: H[0][1] = 6 exactly (4h^2 = 4)");

# --- calc_adaptive_simpson: the refinement machinery (2.8.x) ---------------
# x^2 is retained but it is NOT coverage. Simpson integrates any cubic exactly,
# so `refined - whole` is zero at the FIRST tolerance test and
# _adaptive_simpson_rec accepts without ever recursing. The evaluation counter
# says so out loud: 5 calls -- the three initial panel points plus the two
# sub-midpoints of the single accepted bisection, and no descent below it.
_as_calls = 0;
var c9_as = calc_adaptive_simpson(&_as_x2, 0, F64_ONE, EPSILON_F64);
assert(f64_lt(f64_abs(f64_sub(c9_as, 0x3FD5555555555555)), LOOSE_TOL_M) == 1,
  "adaptive Simpson of x^2 over [0,1] = 1/3");
assert_eq(_as_calls, 5, "adaptive Simpson never recurses on x^2 (5 evaluations, no descent)");

# x^4 over [0,1] = 1/5. The single panel gives 5/24 = 0.208333..., off by
# 8.3e-3, so landing within 1e-14 is only reachable by actually refining.
_as_calls = 0;
var as_x4 = calc_adaptive_simpson(&_as_x4, 0, F64_ONE, EPSILON_F64);
assert(f64_lt(f64_abs(f64_sub(as_x4, f64_div(F64_ONE, f64_from(5)))), TOL_1EM14) == 1,
  "adaptive Simpson of x^4 over [0,1] = 1/5 (one panel is 8.3e-3 wrong)");
assert(_as_calls > 100, "adaptive Simpson does refine on x^4 (>100 evaluations)");

# Additivity. A refinement that loses or double-counts a sub-panel can still
# land near the right total; it cannot also stay consistent across a split.
var as_lo = calc_adaptive_simpson(&_as_x4, 0, F64_HALF, EPSILON_F64);
var as_hi = calc_adaptive_simpson(&_as_x4, F64_HALF, F64_ONE, EPSILON_F64);
assert(f64_lt(f64_abs(f64_sub(as_x4, f64_add(as_lo, as_hi))), TOL_1EM14) == 1,
  "adaptive Simpson is additive across a split interval");

# sqrt over [0,1] = 2/3. The derivative blows up at 0, so the error is
# concentrated in one corner: composite Simpson on a UNIFORM grid of the ~1000
# points used here is still ~6e-5 off. Reaching 1e-11 requires the subdivision
# to be non-uniform, which is the entire point of the algorithm and was
# unexercised until 2.8.x.
_as_calls = 0;
var as_sq = calc_adaptive_simpson(&_as_sqrt, 0, F64_ONE, f64_div(F64_ONE, f64_from(10000000000)));
assert(f64_lt(f64_abs(f64_sub(as_sq, f64_div(F64_TWO, f64_from(3)))),
    f64_div(F64_ONE, f64_from(100000000000))) == 1,
  "adaptive Simpson of sqrt over [0,1] = 2/3 (needs non-uniform refinement)");
assert(_as_calls < 4000, "adaptive Simpson reaches 1e-11 on sqrt in under 4000 evaluations");

# 1/(1+x) over [0,1] = ln 2. Not a polynomial anywhere, so no panel at any level
# is ever exact and every recursion level contributes to the answer.
var as_ln = calc_adaptive_simpson(&_as_recip, 0, F64_ONE, EPSILON_F64);
assert(f64_lt(f64_abs(f64_sub(as_ln, f64_ln(F64_TWO))), TOL_1EM14) == 1,
  "adaptive Simpson of 1/(1+x) over [0,1] = ln 2");

# A Lorentzian with 99% of its mass in 10% of the domain. One panel returns
# 0.6702 against a true 0.1471 -- 355% error -- and only adaptivity recovers it.
var as_pk = calc_adaptive_simpson(&_as_peak, 0, F64_ONE,
  f64_div(F64_ONE, f64_from(100000000000)));
var as_pk_want = f64_mul(f64_div(F64_ONE, f64_from(10)), ganita_f64_atan2(f64_from(10), F64_ONE));
assert(f64_lt(f64_abs(f64_sub(as_pk, as_pk_want)), f64_div(F64_ONE, f64_from(100000000000))) == 1,
  "adaptive Simpson resolves a narrow peak: (1/10) atan(10)");

# === 3.3.3 G4: calc_adaptive_simpson unreachable tolerances (D071) ===
# ⛔ `|error| < tol` is false for every error when tol <= 0 or NaN, and for an
# exactly-zero error when tol is 0, so such a tolerance walked the full 2^50-leaf
# tree: tol = 0, -0, -1, NaN and 2^-1074 each exceeded 2*10^7 evaluations of x^4
# over [0,1] on 3.3.2, where 1e-10 takes 257. The integrands here are CAPPED (NaN
# after 100,000 calls, which ends any walk within ~100 more) so that a build missing
# a guard fails these assertions instead of hanging the suite.
# [measured: evaluation-capped x^4 and step probes on the 3.3.2 bundle, 2026-10-01]
var _g4_as_calls = 0;

fn _g4_as_x4cap(x) {
    _g4_as_calls = _g4_as_calls + 1;
    if (_g4_as_calls > 100000) { return 0x7FF8000000000000; }
    var x2 = f64_mul(x, x);
    return f64_mul(x2, x2);
}

# A unit step at 0x3FD5555555555555 (just below 1/3). Every panel clear of the step
# is constant, so its Richardson error is exactly 0 and it converges at once; the
# one panel holding the step never converges and descends alone to the depth cap.
# That makes the depth at which the tolerance runs out directly observable.
fn _g4_as_step(x) {
    _g4_as_calls = _g4_as_calls + 1;
    if (_g4_as_calls > 100000) { return 0x7FF8000000000000; }
    if (f64_lt(x, 0x3FD5555555555555) == 1) { return 0; }
    return F64_ONE;
}

# (a) Rejected at entry, before f is called: the count is the evidence that the
# entry test, not the recursion's, refused them.
_g4_as_calls = 0;
assert_eq(calc_adaptive_simpson(&_g4_as_x4cap, 0, F64_ONE, 0), 0x7FF8000000000000,
  "calc_adaptive_simpson: tol = +0 -> NaN (was > 2*10^7 evaluations)");
assert_eq(calc_adaptive_simpson(&_g4_as_x4cap, 0, F64_ONE, 0x8000000000000000), 0x7FF8000000000000,
  "calc_adaptive_simpson: tol = -0 -> NaN");
assert_eq(calc_adaptive_simpson(&_g4_as_x4cap, 0, F64_ONE, f64_neg(F64_ONE)), 0x7FF8000000000000,
  "calc_adaptive_simpson: tol = -1 -> NaN");
assert_eq(calc_adaptive_simpson(&_g4_as_x4cap, 0, F64_ONE, 0x7FF8000000000000), 0x7FF8000000000000,
  "calc_adaptive_simpson: tol = NaN -> NaN");
assert_eq(_g4_as_calls, 0, "calc_adaptive_simpson: a rejected tolerance evaluates f zero times");

# (b) +Inf is a tolerance every finite error meets: accepted at the root, 5 calls.
# A non-finite test in place of the not-greater one would refuse it.
_g4_as_calls = 0;
assert_eq(calc_adaptive_simpson(&_g4_as_x4cap, 0, F64_ONE, F64_POS_INF), 0x3FC9999999999999,
  "calc_adaptive_simpson: tol = +Inf is accepted (the root's Boole value for x^4, 0.2 - 1 ulp)");
assert_eq(_g4_as_calls, 5, "calc_adaptive_simpson: tol = +Inf stops at the root (5 evaluations)");

# (c) A POSITIVE tolerance that halves to zero, ON its boundaries. 2^-1074 halves
# to 0 at the root's children: NaN after the root's 5 evaluations. 2^-1073 halves
# to 0 one level further down: NaN after 9.
_g4_as_calls = 0;
assert_eq(calc_adaptive_simpson(&_g4_as_x4cap, 0, F64_ONE, 1), 0x7FF8000000000000,
  "calc_adaptive_simpson: tol = 2^-1074 halves to zero at the root's children -> NaN");
assert_eq(_g4_as_calls, 5, "calc_adaptive_simpson: tol = 2^-1074 stops after the root's 5 evaluations");
_g4_as_calls = 0;
assert_eq(calc_adaptive_simpson(&_g4_as_x4cap, 0, F64_ONE, 2), 0x7FF8000000000000,
  "calc_adaptive_simpson: tol = 2^-1073 halves to zero one level down -> NaN");
assert_eq(_g4_as_calls, 9, "calc_adaptive_simpson: tol = 2^-1073 stops after 9 evaluations");

# (d) The guard fires only where a child would TEST the zero. On the step, the
# panel holding it reaches depth 1 with tol * 2^-49; for tol = 2^-1025 that is
# 2^-1074 and its half is 0, but depth-1 children return before testing, so the
# answer stands — the correctly rounded 1 - 0x3FD5555555555555, in 201 calls, the
# same as 3.3.2 and as tol = 1e-10. One binade smaller, 2^-1026, the zero reaches
# a depth-2 node whose children do test it: NaN, four calls sooner.
_g4_as_calls = 0;
assert_eq(calc_adaptive_simpson(&_g4_as_step, 0, F64_ONE, 1 << 49), 0x3FE5555555555556,
  "calc_adaptive_simpson: tol = 2^-1025 on a step, zero only below the last tested level -> answer");
assert_eq(_g4_as_calls, 201, "calc_adaptive_simpson: tol = 2^-1025 on a step takes 201 evaluations");
_g4_as_calls = 0;
assert_eq(calc_adaptive_simpson(&_g4_as_step, 0, F64_ONE, 1 << 48), 0x7FF8000000000000,
  "calc_adaptive_simpson: tol = 2^-1026 on a step, zero at a tested level -> NaN");
assert_eq(_g4_as_calls, 197, "calc_adaptive_simpson: tol = 2^-1026 stops at depth 2 (197 evaluations)");

# (e) b < a is the oriented integral. On x^4 over [1, 0] it is the bit-exact
# negation of [0, 1]'s value, as asserted below — not guaranteed in general: each
# panel adds the same three samples in mirrored order, which happens to round
# identically here.
_g4_as_calls = 0;
var _g4_as_fwd = calc_adaptive_simpson(&_g4_as_x4cap, 0, F64_ONE, 0x3DDB7CDFD9D7BDBB);
var _g4_as_rev = calc_adaptive_simpson(&_g4_as_x4cap, F64_ONE, 0, 0x3DDB7CDFD9D7BDBB);
assert_eq(_g4_as_fwd, 0x3FC9999999999999, "calc_adaptive_simpson: x^4 over [0,1] at tol 1e-10");
assert_eq(_g4_as_rev, f64_neg(_g4_as_fwd), "calc_adaptive_simpson: [1,0] is the exact negation of [0,1]");
assert_eq(_g4_as_calls, 514, "calc_adaptive_simpson: x^4 at tol 1e-10 is 257 evaluations each way");

# === 3.3.4: calc_adaptive_simpson, the relative floor ===
# ⛔ A TOLERANCE BELOW WHAT A PANEL'S ESTIMATE CAN RESOLVE could be met only by luck: with
# tol < 2^-56 |whole| the test |error| < tol needs refined and whole to agree within
# 0.9375 m ulps of whole (m its significand, in [1, 2)), and the children inherit the same
# ratio, so x^4 over [0,1] at tol = 1e-300 (which never halves to zero within the depth
# cap) took 1,415,173 evaluations for the value tol = 1e-10 gives after 257. Each panel
# below the root now tests max(tol, 2^-56 |whole|): 408,529 evaluations, the same value.
# The rest of that cost is the panels at x = 0, whose x^4 is 4% off at every scale, so no
# relative test passes them: they still walk to the depth cap.
# A tolerance at or above 3.2e-13 of the integral moved no result or count on a 1,292-call
# sweep; below that, a Lorentzian peak of width 1e-5 at tol = 1e-13 takes 145,025
# evaluations, not 250,657, and comes out an ulp closer to its exact value.
# [measured: adaptive sweep (9 integrands, 34 tolerances), base tree and this tree, exact values; 2026-10-03]
var _f34_as_calls = 0;
fn _f34_as_x4(x) {
    _f34_as_calls = _f34_as_calls + 1;
    if (_f34_as_calls > 2000000) { return 0x7FF8000000000000; }
    var x2 = f64_mul(x, x);
    return f64_mul(x2, x2);
}
fn _f34_as_lorentz(x) {
    _f34_as_calls = _f34_as_calls + 1;
    if (_f34_as_calls > 2000000) { return 0x7FF8000000000000; }
    var d = f64_sub(x, F64_HALF);
    return f64_div(0x3EE4F8B588E368F1, f64_add(f64_mul(d, d), f64_mul(0x3EE4F8B588E368F1, 0x3EE4F8B588E368F1)));
}
_f34_as_calls = 0;
assert_eq(calc_adaptive_simpson(&_f34_as_x4, 0, F64_ONE, 0x01A56E1FC2F8F359), 0x3FC9999999999999,
  "calc_adaptive_simpson: x^4 at tol 1e-300 is tol 1e-10's value");
assert_eq(_f34_as_calls, 408529,
  "calc_adaptive_simpson: x^4 at tol 1e-300 takes 408,529 evaluations (3.3.3: 1,415,173)");
# The floor is 2^-56 |whole|: -x^4 gets it too, the negated value at the same cost (a
# floor taken from the signed estimate is negative and walks 1,415,173 evaluations).
# [measured: the signed-floor mutant against the assertions below; 2026-10-03; cycc 6.6.14]
fn _f34_as_negx4(x) { return f64_neg(_f34_as_x4(x)); }
_f34_as_calls = 0;
assert_eq(calc_adaptive_simpson(&_f34_as_negx4, 0, F64_ONE, 0x01A56E1FC2F8F359), 0xBFC9999999999999,
  "calc_adaptive_simpson: -x^4 at tol 1e-300 is the negated value");
assert_eq(_f34_as_calls, 408529, "calc_adaptive_simpson: -x^4 at tol 1e-300 takes 408,529 evaluations, as x^4");
# The root is not floored. f = 1.5 at the five root samples, except 1.5 - 2 ulps at
# x = 3/4, so whole and refined differ by rounding alone, which a floored root accepts
# (1.4999999999999998 after 5 evaluations); f is 2.5 on (0.3, 0.45), and the integral
# 1.65 needs the walk. At tol = 1e-17 the root's own test refuses the root, as on 3.3.3.
# [measured: the floored-root mutant against the assertions below; 3.3.3 bundle; 2026-10-03; cycc 6.6.14]
fn _f34_as_bump(x) {
    _f34_as_calls = _f34_as_calls + 1;
    if (f64_eq(x, 0x3FE8000000000000) == 1) { return 0x3FF7FFFFFFFFFFFE; }
    if (f64_lt(0x3FD3333333333333, x) == 1 && f64_lt(x, 0x3FDCCCCCCCCCCCCD) == 1) { return 0x4004000000000000; }
    return 0x3FF8000000000000;
}
_f34_as_calls = 0;
assert_eq(calc_adaptive_simpson(&_f34_as_bump, 0, F64_ONE, 0x3C670EF54646D497), 0x3FFA666666666666,
  "calc_adaptive_simpson: a bump the root samples miss, tol 1e-17 -> 1.65, as on 3.3.3");
assert_eq(_f34_as_calls, 389, "calc_adaptive_simpson: that bump takes 389 evaluations, as on 3.3.3");
_f34_as_calls = 0;
assert_eq(calc_adaptive_simpson(&_f34_as_lorentz, 0, F64_ONE, 0x3D719799812DEA11), 0x400921E65B8EA440,
  "calc_adaptive_simpson: Lorentzian w = 1e-5 at tol 1e-12, unchanged");
assert_eq(_f34_as_calls, 93865, "calc_adaptive_simpson: Lorentzian at tol 1e-12, 93,865 evaluations, unchanged");
_f34_as_calls = 0;
assert_eq(calc_adaptive_simpson(&_f34_as_lorentz, 0, F64_ONE, 0x3D3C25C268497682), 0x400921E65B8EA43F,
  "calc_adaptive_simpson: Lorentzian w = 1e-5 at tol 1e-13, an ulp closer to exact (3.3.3: ...A43E)");
assert_eq(_f34_as_calls, 145025,
  "calc_adaptive_simpson: Lorentzian at tol 1e-13, 145,025 evaluations (3.3.3: 250,657)");

# (f) A zero-width interval. The single panel was ((b - a)/6) * (fa + 4 fmid + fb),
# which with b == a and f(a) = +Inf is 0 * Inf = NaN, returned at the root's
# `mid == a` exit; f = -1 gave -0. The integral over a point is exactly 0, returned
# as +0 — asserted by BITS — without calling f. The test is the width b - a, so
# -0 and +0 are one point either way round, and [+Inf, +Inf] (width NaN) is left
# to the arithmetic, which still gives NaN.
# [measured: zero-width probe on the 3.3.2 bundle, 2026-10-01]
var _g4_as_zc = 0;
fn _g4_as_inf(x) { _g4_as_zc = _g4_as_zc + 1; return F64_POS_INF; }
fn _g4_as_neg(x) { _g4_as_zc = _g4_as_zc + 1; return f64_neg(F64_ONE); }
assert_eq(calc_adaptive_simpson(&_g4_as_inf, F64_ONE, F64_ONE, EPSILON_F64), 0,
  "calc_adaptive_simpson: zero width, f = +Inf -> +0 (was NaN)");
assert_eq(calc_adaptive_simpson(&_g4_as_neg, F64_ONE, F64_ONE, EPSILON_F64), 0,
  "calc_adaptive_simpson: zero width, f = -1 -> +0 (was -0)");
assert_eq(calc_adaptive_simpson(&_g4_as_neg, 0x8000000000000000, 0, EPSILON_F64), 0,
  "calc_adaptive_simpson: [-0, +0] -> +0");
assert_eq(calc_adaptive_simpson(&_g4_as_neg, 0, 0x8000000000000000, EPSILON_F64), 0,
  "calc_adaptive_simpson: [+0, -0] -> +0");
assert_eq(_g4_as_zc, 0, "calc_adaptive_simpson: a zero-width interval never calls f");
var _g4_as_ii = calc_adaptive_simpson(&_g4_as_neg, F64_POS_INF, F64_POS_INF, EPSILON_F64);
assert_eq(f64_eq(_g4_as_ii, _g4_as_ii), 0, "calc_adaptive_simpson: [+Inf, +Inf] -> NaN, not 0");
# The tolerance is checked FIRST: an invalid one is refused whatever the interval.
assert_eq(calc_adaptive_simpson(&_g4_as_neg, F64_ONE, F64_ONE, 0), 0x7FF8000000000000,
  "calc_adaptive_simpson: zero width with tol = 0 -> NaN (the tolerance test comes first)");

# === 3.3.3 R4calc: calc_adaptive_simpson, a vanishing tolerance on a narrow interval ===
# ⛔ The zero-tolerance NaN sat in the PARENT and fired whenever its children would get
# a tolerance of 0, also when they would leave through the `mid == a` / `mid == b` exit
# without ever testing it. It now sits in the node about to test it, and on a narrow
# interval that matters. With u = 2^-52 and a unit step at 1 + u over [1, 1 + 2u] at
# tol = 2^-1074: the root misses (|error| = u/30), and both children are one ulp wide,
# so their midpoints round onto an end (ties to even) and each returns its own panel,
# u/6 and u: u/6 + u rounds to 0x3CB2AAAAAAAAAAAB, after 5 evaluations, as on 3.3.2.
# Over [1, 1 + 4u] with the step at 1 + 2u and tol = 2^-1073, the right half is
# constant and meets 2^-1074 with a zero error, and the left half misses it and hands
# 0 to two children that collide: 5u/6 + 2u rounds to 0x3CC6AAAAAAAAAAAA, after 9.
# Both settled by hand and by replaying the arithmetic in IEEE doubles. The
# parent-side form returned NaN after 5 and after 9.
# ⚠ A zero-tolerance node that does NOT collide still returns NaN, however small its
# subtree: the step at 1 + 2^-41 over [1, 1 + 2^-40] at tol = 2^-1070 is NaN after 21
# evaluations, where 3.3.2 returned 0x3D6001AAAAAAAAAB after 529.
# [measured: narrow-interval probe on the 3.3.2 bundle, the parent-side form and this tree; 2026-10-01]
var _r4c_as_at = 0;
fn _r4c_as_step(x) {
    _g4_as_calls = _g4_as_calls + 1;
    if (_g4_as_calls > 100000) { return 0x7FF8000000000000; }
    if (f64_lt(x, _r4c_as_at) == 1) { return 0; }
    return F64_ONE;
}
_r4c_as_at = 0x3FF0000000000001;  # 1 + u
_g4_as_calls = 0;
assert_eq(calc_adaptive_simpson(&_r4c_as_step, F64_ONE, 0x3FF0000000000002, 1), 0x3CB2AAAAAAAAAAAB,
  "calc_adaptive_simpson: two ulps at tol 2^-1074, children collide before testing 0 -> u/6 + u");
assert_eq(_g4_as_calls, 5, "calc_adaptive_simpson: two ulps at tol 2^-1074 take the root's 5 evaluations");
_r4c_as_at = 0x3FF0000000000002;  # 1 + 2u
_g4_as_calls = 0;
assert_eq(calc_adaptive_simpson(&_r4c_as_step, F64_ONE, 0x3FF0000000000004, 2), 0x3CC6AAAAAAAAAAAA,
  "calc_adaptive_simpson: four ulps at tol 2^-1073, grandchildren collide before testing 0 -> 5u/6 + 2u");
assert_eq(_g4_as_calls, 9, "calc_adaptive_simpson: four ulps at tol 2^-1073 take 9 evaluations");
_r4c_as_at = 0x3FF0000000000800;  # 1 + 2^-41
_g4_as_calls = 0;
assert_eq(calc_adaptive_simpson(&_r4c_as_step, F64_ONE, 0x3FF0000000001000, 16), 0x7FF8000000000000,
  "calc_adaptive_simpson: [1, 1 + 2^-40] at tol 2^-1070, a node that would test 0 -> NaN");
assert_eq(_g4_as_calls, 21, "calc_adaptive_simpson: [1, 1 + 2^-40] at tol 2^-1070 stops after 21 evaluations");

# 3D noise is bounded and deterministic.
var c9_p = perlin_3d(F64_HALF, F64_HALF, F64_HALF);
assert(f64_lt(f64_abs(c9_p), F64_ONE) == 1, "perlin_3d stays inside [-1,1]");
assert_eq(c9_p, perlin_3d(F64_HALF, F64_HALF, F64_HALF), "perlin_3d is deterministic");
assert(f64_lt(f64_abs(simplex_2d(F64_HALF, F64_HALF)), F64_ONE) == 1, "simplex_2d bounded");
assert(f64_lt(f64_abs(simplex_3d(F64_HALF, F64_HALF, F64_HALF)), F64_ONE) == 1, "simplex_3d bounded");

# --- SDF
var s9 = sdf_capsule(hvec3_new(0, F64_TWO, 0), hvec3_zero(), hvec3_unit_x(), F64_ONE);
assert_eq(s9, f64_from(1), "sdf_capsule at distance 2 from a radius-1 capsule = 1");
# Smooth union is the polynomial smooth min, which in exact arithmetic never
# exceeds the plain min for k > 0: it equals min(d1, d2) once |d1 - d2| >= k and
# dips below it, by at most k/4, when the two are closer. Here |1 - 2| >= 0.5, so
# it is the min itself; the assertions below only bound it loosely.
var s9u = sdf_smooth_union(F64_ONE, F64_TWO, F64_HALF);
assert(f64_gt(s9u, 0) == 1, "sdf_smooth_union of two positive distances is positive");
assert(f64_lt(s9u, F64_TWO) == 1, "sdf_smooth_union stays at or below max(d1, d2)");

# ================================================================
# 2.20.0 -- CGA POINT NULLITY: THE USABLE BAND IS A TESTED PROPERTY
# ================================================================
# ⚠ 2.21.0 — THIS BLOCK IS HISTORY, KEPT BECAUSE IT IS THE PROOF THE REPAIR RESTS
# ON. Everything below describes the ep/em basis, which 2.21.0 replaced with the
# null basis; the two acceptance pins it left behind have since INVERTED, exactly
# as they were designed to. The arithmetic facts it asserts are basis-free and
# still true — they are why no arithmetic fix existed.
# ⛔ A conformal point is NEVER exactly null in the ep/em basis, and outside a
# narrow band that is a WRONG ANSWER rather than a representation nicety. The
# canonical use is distance recovery, P1.P2 = -d^2/2; over 2000 random
# full-mantissa pairs per binade the relative error in the recovered d^2 has
# MEDIAN 46.4x at 2^-30 and 48.7x at 2^+30, against exactly 0 at 2^0.
# ⚠ A MEDIAN, never a maximum: rel ~ 2ab/(a-b)^2 diverges as the pair closes, so
# the max is whatever the nearest pair drawn happened to be (5.6e7 / 2.6e8 here).
# An earlier draft quoted maxima as ~2000x and ~32000x and read an asymmetry into
# them; the tails are symmetric.
# ⚠ THE EARLIER FILING CALLED THIS "small coordinates". It is BOTH tails, and the
# small-only reading was an artifact of a POWER-OF-TWO sweep -- dyadic x makes
# x^2 exact, which is the only reason the failure looked banded. ⛔ The first
# draft of THIS BLOCK repeated that exact mistake: it used dyadic fixtures, and
# it also built them with the SUBNORMAL form `1 << (1074 + e)` at e = -30, which
# is a shift of 1044 -- masked to 20 by the hardware -- so it silently tested a
# value 288 decades from the one intended. The fixtures below are full-mantissa
# and built with `(1023 + e) << 52`, the NORMAL form.
# ⭐ No arithmetic fix exists: at x = 2^-30 the correctly-rounded (q-1)/2 IS
# exactly -1/2, asserted below. The remedy was the null basis (n0/ninf), and it
# SHIPPED in 2.21.0 — median |P.P|/q at this binade went 1.0 -> 4.48e-17. These
# assertions now pin the arithmetic that forced the basis change, not a live
# defect; the band pins themselves moved to the null-basis block above.
# [measured: per-binade d^2 recovery sweep, 400 samples/binade, 2026-09-10]

# The representational limit as a bit-exact fact rather than a tolerance: at
# x = 2^-30 the ep/em coefficients round to exactly -1/2 and +1/2, so what should
# distinguish this point from the origin is simply gone.
# ⚠ These are statements about f64 ARITHMETIC, not about `cga_point`, which no
# longer forms either quantity. They are kept because they are the reason the
# basis had to change: no threshold, ordering or compensation recovers a value
# that the correctly-rounded result has already discarded.
var _cn_x = (1023 - 30) << 52;
var _cn_q = f64_mul(_cn_x, _cn_x);
assert_eq(f64_gt(_cn_q, f64_from(0)), 1, "cga nullity fixture: q = x^2 is a real nonzero (not a masked shift)");
assert_eq(f64_sub(f64_mul(F64_HALF, _cn_q), F64_HALF), f64_neg(F64_HALF),
  "ep/em basis: at x=2^-30 the ep coefficient IS exactly -1/2 (no arithmetic fix)");
assert_eq(f64_add(f64_mul(F64_HALF, _cn_q), F64_HALF), F64_HALF,
  "ep/em basis: at x=2^-30 the em coefficient IS exactly +1/2");

# Distance recovery across the clean band, on FULL-MANTISSA coordinates.
var _CN_TOL_1EM6 = 0x3EB0_C6F7_A0B5_ED8D;   # 1e-6
var _cn_m1 = 0x0009_3B4C_6D7E_8F01;
var _cn_m2 = 0x000C_1A2B_3C4D_5E6F;
var _cn_ok = 0;
var _cn_n = 0;
for (var _cn_e = 0 - 11; _cn_e <= 10; _cn_e = _cn_e + 1) {
    var _cn_a = ((1023 + _cn_e) << 52) | _cn_m1;
    var _cn_b = ((1023 + _cn_e) << 52) | _cn_m2;
    var _cn_ip = _cga_scalar_of_geo(cga_point(_cn_a, 0, 0), cga_point(_cn_b, 0, 0));
    var _cn_d2c = f64_mul(f64_from(0 - 2), _cn_ip);
    var _cn_dd = f64_sub(_cn_a, _cn_b);
    var _cn_d2t = f64_mul(_cn_dd, _cn_dd);
    var _cn_rel = f64_abs(f64_div(f64_sub(_cn_d2c, _cn_d2t), _cn_d2t));
    _cn_n = _cn_n + 1;
    # ⚠ NaN-safe: `f64_lt(NaN, tol)` is 0, so a NaN counts as a FAILURE here
    # rather than passing silently. That hole is what broke the first draft.
    # ⚠ The tolerance is 1e-6 because that is the tolerance the band was MEASURED
    # at. An earlier draft asserted this band against `_SYM_EPS` (2^-50) and
    # failed 22 of 22 -- the band is real, but it is a 1e-6 band, not a 2^-50 one.
    # Tightening to 1e-9 narrows it to 2^-7 .. 2^3; loosening to 1e-4 widens it
    # to 2^-15 .. 2^13. Quoting a band without its tolerance means nothing.
    if (f64_lt(_cn_rel, _CN_TOL_1EM6) == 1) { _cn_ok = _cn_ok + 1; }
}
# ⚠ The COUNT is asserted too: a loop that ran zero times would report zero
# failures, which reads exactly like success.
assert_eq(_cn_n, 22, "cga distance-recovery sweep: all 22 binades tested");
assert_eq(_cn_ok, 22, "cga: P1.P2 = -d^2/2 holds to 1e-6 across 2^-11 .. 2^10");

# ⭐ 2.21.0 — THE BASIS CHANGED AND THESE TWO ASSERTIONS INVERTED, EXACTLY AS
# DESIGNED. 2.20.0 pinned the failures at 2^-30 and 2^+30 as KNOWN WRONG so that a
# repair could not land quietly; the null basis made them correct and the suite
# said so by failing until they were rewritten. **A pinned defect is a tripwire for
# its own fix**, which is worth more than a comment saying the fix is pending.
var _cn_lo_a = ((1023 - 30) << 52) | _cn_m1;
var _cn_lo_b = ((1023 - 30) << 52) | _cn_m2;
var _cn_lo_ip = _cga_scalar_of_geo(cga_point(_cn_lo_a, 0, 0), cga_point(_cn_lo_b, 0, 0));
var _cn_lo_dd = f64_sub(_cn_lo_a, _cn_lo_b);
var _cn_lo_t = f64_mul(_cn_lo_dd, _cn_lo_dd);
var _cn_lo_rel = f64_abs(f64_div(f64_sub(f64_mul(f64_from(0 - 2), _cn_lo_ip), _cn_lo_t), _cn_lo_t));
# ⭐ 2.21.0 — THIS PIN HAS INVERTED, WHICH IS THE POINT. It asserted a KNOWN WRONG
# answer so that a repair would have to announce itself. The null basis is that
# repair: recovery at 2^-30 is now ulp-level, not >2x wrong.
assert_eq(f64_lt(_cn_lo_rel, _CN_TOL_1EM6), 1,
  "cga: at 2^-30 distance recovery is now CORRECT (the 2.20.0 pin has inverted)");

var _cn_hi_a = ((1023 + 30) << 52) | _cn_m1;
var _cn_hi_b = ((1023 + 30) << 52) | _cn_m2;
var _cn_hi_ip = _cga_scalar_of_geo(cga_point(_cn_hi_a, 0, 0), cga_point(_cn_hi_b, 0, 0));
var _cn_hi_dd = f64_sub(_cn_hi_a, _cn_hi_b);
var _cn_hi_t = f64_mul(_cn_hi_dd, _cn_hi_dd);
var _cn_hi_rel = f64_abs(f64_div(f64_sub(f64_mul(f64_from(0 - 2), _cn_hi_ip), _cn_hi_t), _cn_hi_t));
assert_eq(f64_lt(_cn_hi_rel, _CN_TOL_1EM6), 1,
  "cga: at 2^+30 distance recovery is now CORRECT too (both tails repaired)");

# ================================================================
# 2.21.0 -- THE NULL-BASIS PRODUCT TABLE MATCHES ITS DERIVATION
# ================================================================
# `scripts/derive-cga-null-table.sh` derives all 1024 entries from first
# principles and prints their FNV-1a. The Cyrius table is built independently, by
# integer arithmetic, and must reproduce it exactly. Two implementations of the
# same algebra agreeing bit for bit is the whole point: either alone could be
# confidently wrong.
# ⚠ The defining identities are asserted separately, because a checksum tells you
# the table CHANGED but not which way -- these say what it must MEAN.
# [measured: scripts/derive-cga-null-table.sh claim 6, blade-index space, 2026-09-10]
var _nt = _cga_null_tbl();
var _nt_h = 1469598103934665603;
for (var _nt_i = 0; _nt_i < 1024; _nt_i = _nt_i + 1) {
    _nt_h = (_nt_h ^ load64(_nt + _nt_i * 8)) * 1099511628211;
}
assert_eq(_nt_h, 0xF4A98C5706D5CF5B,
  "CGA null table reproduces the derivation's FNV-1a over all 1024 entries");

# ⛔ 2.23.0 — AND THE FNV ALONE IS NOT ENOUGH, WHICH A ONE-TOKEN MUTANT PROVED.
# The builder packs only each coefficient's SIGN and blade index, so the table is
# a function of sign and zero-pattern alone: changing `co * cn * wgt` to
# `co * cn * wgt * 3` makes every one of the 1024 coefficients +-3 and the FNV
# stays BIT-EXACT, with all 4018 assertions passing. The same change with its sign
# flipped fails 6 assertions including the FNV — so the checksum sees sign and
# zero but is blind to magnitude, and the "coefficients are exactly +-1" property
# that LICENSES packing only the sign was asserted nowhere on the Cyrius side.
# ⭐ `_CGA_NULL_COEF_BAD` counts, during the build, every coefficient that is not
# exactly +-1 and every `v / scale` that is not exact. It is 0 on a correct table
# (measured: 1024 of 1024 terms +-1, 0 of 1024 divisions inexact) and non-zero for
# a magnitude error the FNV cannot see.
# ⚠ Asserted AFTER `_cga_null_tbl()` has been called above, or it would read 0
# because the lazy build never ran — the zero-iteration trap in another guise.
# [measured: one-token mutant on the shipped tree + 1024-term census, 2026-09-11]
assert_eq(_CGA_NULL_COEF_BAD, 0,
  "CGA null table: every coefficient is exactly +-1 and every division exact");

# n0 is blade index 4, ninf is blade index 5 under the null reading.
assert_eq(load64(_nt + (4 * 32 + 4) * 8), 0, "CGA null basis: n0 * n0 vanishes");
assert_eq(load64(_nt + (5 * 32 + 5) * 8), 0, "CGA null basis: ninf * ninf vanishes");
assert_eq(load64(_nt + (1 * 32 + 1) * 8), 0x1, "CGA null basis: e1 * e1 = +1 (scalar)");
# n0*ninf packs a scalar term AND a bivector term -- the two-slot case.
assert_neq(load64(_nt + (4 * 32 + 5) * 8) >> 7, 0,
  "CGA null basis: n0 * ninf fills BOTH term slots (scalar + bivector)");

# ================================================================
# 2.21.0 -- THE COMPENSATED SCALAR SUM, PINNED BY A CASE THAT NEEDS IT
# ================================================================
# ⛔ THIS BLOCK EXISTS BECAUSE THE RELEASE REMOVED THE NEUMAIER COMPENSATION AND
# NOTHING IN 3989 ASSERTIONS COULD SEE IT. Every suite passed identically with the
# compensation present and absent, so a pre-tag audit -- not the tests -- caught
# that the removal had reintroduced a FABRICATED ZERO.
# The witness: M = 1 + a*e1 + a*n0 + (a/2)*ninf. The scalar part of M*M is
#   (0,0) 1  +  (1,1) a^2  +  (4,5) -a^2/2  +  (5,4) -a^2/2  =  EXACTLY 1
# for every a. Summed plainly left-to-right, `1 + a^2` loses the 1 once a^2 passes
# 2^53, and the two -a^2/2 terms then cancel what is left: the routine returns
# **0 where the answer is 1**. Measured without compensation: wrong for 6 of 11
# magnitudes, every one at a >= 2^30. With it: 0 of 11.
# ⚠ The point is deliberately NOT a conformal point. A point's own nullity cannot
# discriminate here -- its terms are all the same magnitude -- which is precisely
# why the whole suite was blind.
# [measured: scalar-part sweep a = 2^0..2^60 with and without compensation]
var _cs_bad = 0;
var _cs_n = 0;
for (var _cs_e = 0; _cs_e <= 60; _cs_e = _cs_e + 6) {
    var _cs_a = (1023 + _cs_e) << 52;
    var _cs_m = cga_mv_zero();
    cga_mv_set(_cs_m, 0, F64_ONE);
    cga_mv_set(_cs_m, 1, _cs_a);
    cga_mv_set(_cs_m, 4, _cs_a);
    cga_mv_set(_cs_m, 5, f64_mul(F64_HALF, _cs_a));
    _cs_n = _cs_n + 1;
    if (f64_eq(_cga_scalar_of_geo(_cs_m, _cs_m), F64_ONE) == 0) { _cs_bad = _cs_bad + 1; }
}
assert_eq(_cs_n, 11, "compensated scalar sum: all 11 magnitudes tested");
assert_eq(_cs_bad, 0,
  "compensated scalar sum: M*M scalar part is exactly 1 at every magnitude (0 fabricated)");

# === 3.3.3 R4ga: the compensated scalar sum with an infinite term ===
# ⛔ The compensation formed Inf - Inf as soon as one term was infinite, so the
# scalar part came back NaN where the plain sum is ±Inf: cga_norm_sq of +Inf on e1
# alone, whose one term is Inf * Inf = +Inf, returned NaN on 3.3.2. Once the running
# sum is not finite it is now the answer: ±Inf for infinite terms of one sign, NaN
# for both signs or a NaN term. Every "3.3.2:" below is the 3.3.2 bundle's answer.
# [measured: R4ga probe on the 3.3.2 bundle and this tree, 2026-10-01; cycc 6.6.12]
var _r4ga_cinf = 0x7FF0000000000000;
fn _r4ga_mv2(i, a, j, b) {
    var m = cga_mv_zero();
    cga_mv_set(m, i, a);
    if (j >= 0) { cga_mv_set(m, j, b); }
    return m;
}
assert_eq(cga_norm_sq(_r4ga_mv2(1, _r4ga_cinf, 0 - 1, 0)), 0x7FF0000000000000,
  "cga_norm_sq(+Inf e1) = +Inf, its one term Inf * Inf (3.3.2: NaN)");
assert_eq(cga_norm_sq(_r4ga_mv2(0, F64_ONE, 1, _r4ga_cinf)), 0x7FF0000000000000,
  "cga_norm_sq(1 + Inf e1) = +Inf: a finite term before the infinite one (3.3.2: NaN)");
assert_eq(cga_norm_sq(_r4ga_mv2(4, _r4ga_cinf, 5, F64_ONE)), 0xFFF0000000000000,
  "cga_norm_sq(Inf n0 + ninf) = -Inf, the n0.ninf terms' sign kept (3.3.2: NaN)");
var _r4ga_cboth = _r4ga_mv2(1, _r4ga_cinf, 4, _r4ga_cinf);
cga_mv_set(_r4ga_cboth, 5, _r4ga_cinf);
var _r4ga_nb = cga_norm_sq(_r4ga_cboth);
assert_eq(f64_eq(_r4ga_nb, _r4ga_nb), 0,
  "cga_norm_sq(Inf e1 + Inf n0 + Inf ninf) is NaN: +Inf and -Inf terms, the IEEE sum");
var _r4ga_nn = cga_norm_sq(_r4ga_mv2(1, 0x7FF8000000000000, 2, _r4ga_cinf));
assert_eq(f64_eq(_r4ga_nn, _r4ga_nn), 0, "cga_norm_sq(NaN e1 + Inf e2) is NaN: a NaN term");
# ⚠ THE DOCUMENTED LIMIT, NOT THE ANSWER. T = 1.125 * 2^1023 and r = sqrt(T), with
# r * r == T exactly: r e1 + r e2 + r n0 + (r/2) ninf has terms T, T, -T/2, -T/2, so
# its exact scalar part is T, but the running sum overflows at T + T. It is +Inf
# now (3.3.2: NaN). cga_norm rescales a coefficient this large before summing.
# [measured: R4ga probe on the 3.3.2 bundle and this tree, 2026-10-01; cycc 6.6.12]
var _r4ga_rt = f64_sqrt(0x7FE2000000000000);
var _r4ga_cov = _r4ga_mv2(1, _r4ga_rt, 2, _r4ga_rt);
cga_mv_set(_r4ga_cov, 4, _r4ga_rt);
cga_mv_set(_r4ga_cov, 5, f64_mul(F64_HALF, _r4ga_rt));
assert_eq(f64_mul(_r4ga_rt, _r4ga_rt), 0x7FE2000000000000, "oracle: r * r is exactly T");
assert_eq(cga_norm_sq(_r4ga_cov), 0x7FF0000000000000,
  "cga_norm_sq: the sum overflows at T + T, so +Inf where the exact value is T (documented limit)");

# --- CGA: the algebra identities.
var g9a = cga_point(F64_ONE, 0, 0);
var g9b = cga_mv_clone(g9a);
assert_eq(cga_mv_get(g9b, 1), cga_mv_get(g9a, 1), "cga_mv_clone copies blades");
var g9z = cga_mv_sub(g9a, g9b);
assert_eq(cga_norm_sq(g9z), 0, "cga_mv_sub of identical multivectors is zero");
var g9s = cga_mv_scale(g9a, F64_TWO);
assert_eq(cga_mv_get(g9s, 1), f64_mul(F64_TWO, cga_mv_get(g9a, 1)), "cga_mv_scale scales blades");
assert_neq(cga_mv_reverse(g9a), 0, "cga_mv_reverse exists");
# x ^ x = 0 for any vector.
assert_eq(cga_norm_sq(cga_outer_product(g9a, g9a)), 0, "cga outer product x^x = 0");
# A translator sandwiched on a point must move it.
var g9t = cga_translator(F64_ONE, 0, 0);
var g9m = cga_sandwich(cga_point(0, 0, 0), g9t);
assert_neq(g9m, 0, "cga_sandwich applies a versor");
assert_neq(cga_rotor(0, 0, F64_ONE, F64_PI_2), 0, "cga_rotor builds a rotor");
assert_neq(cga_sphere(0, 0, 0, F64_ONE), 0, "cga_sphere builds a sphere");
assert_neq(cga_plane(0, 0, F64_ONE, 0), 0, "cga_plane builds a plane");
assert_neq(cga_blade_inverse(cga_point(F64_ONE, F64_TWO, 0)), 0, "cga_blade_inverse exists");

# --- symbolic_ext pattern constructors and accessors.
var p9c = pat_const(f64_from(5));
assert_eq(pat_val(p9c), f64_from(5), "pat_const stores its value");
var p9v = pat_var(str_from("x"));
assert_eq(str_eq_cstr(pat_name(p9v), "x"), 1, "pat_var stores its name");
var p9p = pat_pow(p9v, p9c);
assert_eq(pat_tag(pat_left(p9p)), pat_tag(p9v), "pat_left of pow is the base");
assert_eq(pat_val(pat_right(p9p)), f64_from(5), "pat_right of pow is the exponent");
assert_eq(pat_tag(pat_child(pat_neg(p9v))), pat_tag(p9v), "pat_child of neg is the operand");
assert_neq(pat_sin(p9v), 0, "pat_sin builds a pattern");
assert_neq(pat_cos(p9v), 0, "pat_cos builds a pattern");
assert_neq(pat_exp(p9v), 0, "pat_exp builds a pattern");
assert_neq(pat_ln(p9v), 0, "pat_ln builds a pattern");
# Rewriting: the default rule set must simplify x + 0 back to x.
var p9rules = sym_default_rules();
assert_neq(p9rules, 0, "sym_default_rules returns rules");
var p9e = expr_add(expr_var(str_from("x")), expr_const(0));
assert_neq(sym_rewrite(p9e, p9rules), 0, "sym_rewrite returns an expression");
assert_neq(sym_rule(pat_var(str_from("x")), expr_var(str_from("x"))), 0, "sym_rule builds a rule");

test_group("2.8.0 coverage: calc, num, optimize, lie_ext, linalg_ext tails");

# Trapezoid on x^2 over [0,1] is 1/3 + h^2/6; at n=1000 that is ~1.67e-7 above.
var c80_o = alloc(8);
var c80_t, c80_v = calc_integral_trapez(&_c80_sq, 0, F64_ONE, 1000, c80_o);
assert_eq(is_ok(c80_t), 1, "trapez ok");
assert(f64_lt(f64_abs(f64_sub(load64(c80_o), 0x3FD5555555555555)), f64_div(F64_ONE, f64_from(1000000))) == 1,
  "trapez of x^2 over [0,1] is within 1e-6 of 1/3");
# lerp endpoints are exact.
assert_eq(calc_lerp(F64_TWO, f64_from(6), 0), F64_TWO, "calc_lerp t=0 is a");
assert_eq(calc_lerp(F64_TWO, f64_from(6), F64_ONE), f64_from(6), "calc_lerp t=1 is b");
assert_eq(calc_lerp(0, f64_from(10), F64_HALF), f64_from(5), "calc_lerp midpoint = 5");
# Bezier ease is pinned at both ends by construction.
assert(f64_lt(f64_abs(cubic_bezier_ease(f64_div(F64_ONE, f64_from(4)), 0,
        f64_div(f64_from(3), f64_from(4)), F64_ONE, 0)), LOOSE_TOL_M) == 1, "cubic_bezier_ease(0) = 0");
# A critically-damped spring already at its target must not move.
var c80_p = alloc(8);
var c80_v = alloc(8);
spring_step(F64_ONE, F64_ONE, 0, f64_from(100), f64_from(20), f64_div(F64_ONE, f64_from(60)),
  c80_p, c80_v);
assert(f64_lt(f64_abs(f64_sub(load64(c80_p), F64_ONE)), LOOSE_TOL_M) == 1,
  "spring_step at rest on target does not move");
assert(f64_lt(f64_abs(load64(c80_v)), LOOSE_TOL_M) == 1, "spring_step at rest keeps zero velocity");
assert(f64_lt(f64_abs(perlin_2d(F64_HALF, F64_HALF)), F64_ONE) == 1, "perlin_2d bounded");

# PCG32 float output is in [0,1) and advances.
var c80_r = pcg32_new(42);
var c80_a = pcg32_next_f64(c80_r);
assert(f64_lt(c80_a, F64_ONE) == 1, "pcg32_next_f64 < 1");
assert(f64_lt(f64_neg(EPSILON_F64), c80_a) == 1, "pcg32_next_f64 >= 0");
assert_neq(c80_a, pcg32_next_f64(c80_r), "pcg32_next_f64 advances the stream");

# Continued fraction of 415/93 is [4;2,6,7].
var c80_cf = num_continued_fraction_rational(415, 93);
assert_neq(c80_cf, 0, "continued fraction returns terms");
assert_eq(vec_get(c80_cf, 0), 4, "415/93 first term is 4");
assert_eq(vec_len(c80_cf), 4, "415/93 = [4;2,6,7] is 4 terms");
# Sobol stays in [0,1).
assert(f64_lt(num_sobol(7), F64_ONE) == 1, "num_sobol < 1");
# DCT/IDCT round-trip.
var c80_d = alloc(32);
store64(c80_d, F64_ONE); store64(c80_d + 8, F64_TWO);
store64(c80_d + 16, f64_from(3)); store64(c80_d + 24, f64_from(4));
var _rq100t, _rq100v = num_dct(c80_d, 4);
assert_eq(is_ok(_rq100t), 1, "num_dct ok");
var _rq101t, _rq101v = num_idct(c80_d, 4);
assert_eq(is_ok(_rq101t), 1, "num_idct ok");
assert(f64_lt(f64_abs(f64_sub(load64(c80_d), F64_ONE)), LOOSE_TOL_M) == 1,
  "dct/idct round-trips element 0");

# Conjugate gradient on f(x) = x^2 must reach 0.
var c80_x0 = alloc(8);
store64(c80_x0, f64_from(5));
var c80_ox = alloc(8);
var c80_of = alloc(8);
var _rq100t, _rq100v = opt_conjugate_gradient(&_c80_f, &_c80_g, c80_x0, 1, EPSILON_F64, 200, c80_ox, c80_of);
assert_eq(is_ok(_rq100t), 1, "conjugate gradient converges");
assert(f64_lt(f64_abs(load64(c80_ox)), f64_div(F64_ONE, f64_from(1000))) == 1,
  "conjugate gradient finds x* = 0");

# Lyapunov exponent of the identity map is 0 (no expansion).
var c80_I = ganita_mat_identity(2);
var c80_ly = alloc(8);
var _rq102t, _rq102v = lyapunov_max(c80_I, 2, 50, c80_ly);
assert_eq(is_ok(_rq102t), 1, "lyapunov_max runs");
assert(f64_lt(f64_abs(load64(c80_ly)), LOOSE_TOL_M) == 1, "lyapunov of the identity is 0");

# svd_compute on a diagonal matrix gives its diagonal as the singular values.
var c80_A = ganita_mat_new(2, 2);
ganita_mat_set(c80_A, 0, 0, f64_from(3)); ganita_mat_set(c80_A, 1, 1, F64_TWO);
var c80_U = ganita_mat_new(2, 2);
var c80_V = ganita_mat_new(2, 2);
var c80_S = alloc(16);
assert_eq(svd_compute(c80_A, c80_U, c80_S, c80_V), HSB_ERR_NONE, "svd_compute succeeds");
assert(f64_lt(f64_abs(f64_sub(load64(c80_S), f64_from(3))), LOOSE_TOL_M) == 1,
  "svd_compute s0 = 3 for diag(3,2)");

# Euler-Maruyama with zero drift and zero noise increment is a no-op.
assert_eq(ode_euler_maruyama(&_c80_sde_f, &_c80_sde_g, 0, F64_ONE, F64_HALF, 0), F64_ONE,
  "euler_maruyama with dW = 0 and zero drift leaves y unchanged");

# bch_2nd_order takes COMPLEX MATRICES (cmat); bch_so3_2nd_order takes 3x3 REAL
# skew matrices (Mat3), not HVec3 -- the comment here used to say "the vector
# one", and the fixture above it believed that. For commuting X, Y the
# commutator vanishes and Z = X + Y.
var c80_bx = cmat_identity(2);
var c80_by = cmat_scale(cmat_identity(2), cx_real(F64_TWO));
var c80_bz = bch_2nd_order(c80_bx, c80_by);
assert_neq(c80_bz, 0, "bch_2nd_order returns a matrix");
assert(f64_lt(f64_abs(f64_sub(HComplex_re(cmat_get(c80_bz, 0, 0)), f64_from(3))), LOOSE_TOL_M) == 1,
  "bch_2nd_order of commuting I and 2I is 3I");
# Ad_L(X) takes a Mat4 GENERATOR X, not a 4-vector. Ad_I(X) = I*X*I^-1 = X.
var c80_X = m4_identity();
var c80_ad = lorentz_adjoint(lorentz_identity(), c80_X);
assert_neq(c80_ad, 0, "lorentz_adjoint returns a Mat4");
assert(f64_lt(f64_abs(f64_sub(m4_get(c80_ad, 0, 0), F64_ONE)), LOOSE_TOL_M) == 1,
  "Ad_I(I) = I on the diagonal");
assert(f64_lt(f64_abs(m4_get(c80_ad, 0, 1)), LOOSE_TOL_M) == 1, "Ad_I(I) is off-diagonal zero");

test_group("delaunay_2d: cocircular input must be a real triangulation");

# The shipped implementation did NOT triangulate points on a circle. At n=150 it
# returned 1651 triangles where 148 is correct, with 206 edges shared by 3+
# triangles, 9 input points dropped, and a total area 244x the convex hull -- an
# overlapping soup, not a mesh. Nothing asserted that, so it survived. These pin
# the class: a convex polygon of n points triangulates to exactly n-2 triangles.
var dcc_n = 60;
var dcc = vec_new();
var dcc_i = 0;
while (dcc_i < dcc_n) {
    var dcc_a = f64_div(f64_mul(f64_mul(F64_TWO, F64_PI), f64_from(dcc_i)), f64_from(dcc_n));
    vec_push(dcc, hvec2_new(f64_mul(f64_from(100), f64_cos(dcc_a)),
        f64_mul(f64_from(100), f64_sin(dcc_a))));
    dcc_i = dcc_i + 1;
}
var dcc_t = delaunay_2d(dcc, dcc_n);
assert_eq(vec_len(dcc_t) / 3, dcc_n - 2, "circle-60 gives exactly n-2 = 58 triangles");

# Every input point must appear. The shipped code dropped 9 of 150 on this class.
var dcc_used = alloc(dcc_n * 8);
dcc_i = 0;
while (dcc_i < dcc_n) { store64(dcc_used + dcc_i * 8, 0); dcc_i = dcc_i + 1; }
dcc_i = 0;
while (dcc_i < vec_len(dcc_t)) {
    store64(dcc_used + vec_get(dcc_t, dcc_i) * 8, 1);
    dcc_i = dcc_i + 1;
}
var dcc_missing = 0;
dcc_i = 0;
while (dcc_i < dcc_n) {
    if (load64(dcc_used + dcc_i * 8) == 0) { dcc_missing = dcc_missing + 1; }
    dcc_i = dcc_i + 1;
}
assert_eq(dcc_missing, 0, "circle-60 uses every input point (shipped dropped 9 of 150)");

# No edge may be shared by more than two triangles -- the manifoldness check that
# would have caught the 206 over-shared edges directly.
var dcc_over = 0;
var dcc_e = 0;
while (dcc_e < vec_len(dcc_t)) {
    var dcc_ta = vec_get(dcc_t, dcc_e);
    var dcc_tb = vec_get(dcc_t, dcc_e + 1);
    var dcc_cnt = 0;
    var dcc_f = 0;
    while (dcc_f < vec_len(dcc_t)) {
        var x0 = vec_get(dcc_t, dcc_f);
        var x1 = vec_get(dcc_t, dcc_f + 1);
        var x2 = vec_get(dcc_t, dcc_f + 2);
        var hit = 0;
        if (x0 == dcc_ta || x1 == dcc_ta || x2 == dcc_ta) {
            if (x0 == dcc_tb || x1 == dcc_tb || x2 == dcc_tb) { hit = 1; }
        }
        dcc_cnt = dcc_cnt + hit;
        dcc_f = dcc_f + 3;
    }
    if (dcc_cnt > 2) { dcc_over = dcc_over + 1; }
    dcc_e = dcc_e + 3;
}
assert_eq(dcc_over, 0, "circle-60 is manifold: no edge shared by 3+ triangles");

# A smaller circle, and a circle with an interior point, for the same invariant.
var dcc2 = vec_new();
dcc_i = 0;
while (dcc_i < 12) {
    var a2 = f64_div(f64_mul(f64_mul(F64_TWO, F64_PI), f64_from(dcc_i)), f64_from(12));
    vec_push(dcc2, hvec2_new(f64_mul(f64_from(50), f64_cos(a2)),
        f64_mul(f64_from(50), f64_sin(a2))));
    dcc_i = dcc_i + 1;
}
assert_eq(vec_len(delaunay_2d(dcc2, 12)) / 3, 10, "circle-12 gives exactly 10 triangles");
vec_push(dcc2, hvec2_new(0, 0));
assert_eq(vec_len(delaunay_2d(dcc2, 13)) / 3, 12, "circle-12 + centre gives 12 triangles");

test_group("delaunay_2d: symbolic ghost vertices — completeness (2.8.2)");

# Until 2.8.2 the enclosing triangle was placed at 10x the bounding box. That is
# not far enough for Bowyer-Watson to reduce to the true Delaunay triangulation:
# a super-vertex lands inside a real circumcircle, the real triangle is never
# created, and compaction then drops the super-vertex triangle that was covering
# the gap — so the mesh comes back with a HOLE and no error signal. Every number
# asserted below was computed independently in exact rational arithmetic
# (python3 fractions) from these same points; the "was" figures are what the 10x
# build actually returned.
#
# Twenty uniform points. Correct answer 32 triangles; the 10x build returned 31,
# missing exactly (3, 7, 17) and leaving a hole of 1.5e-4 of the hull.
var dlu_p = vec_new();
vec_push(dlu_p, hvec2_new(0x3FD8C0CEC328E270, 0x3FE812E629B272E6));
vec_push(dlu_p, hvec2_new(0x3FCDC969F80835E0, 0x3FB96E4EC2DA05B8));
vec_push(dlu_p, hvec2_new(0x3FC80F13C7D500AC, 0x3FD85BE58C2C01D0));
vec_push(dlu_p, hvec2_new(0x3FEF89BC83E37983, 0x3FE05AF18260D33D));
vec_push(dlu_p, hvec2_new(0x3FDB4AFA8EA7BA7A, 0x3FE34F6290EC133A));
vec_push(dlu_p, hvec2_new(0x3FDCD4957A495F30, 0x3FC17F76452A82D0));
vec_push(dlu_p, hvec2_new(0x3FEBF9DC63B08AF1, 0x3FDCF927BD572532));
vec_push(dlu_p, hvec2_new(0x3FEE8CBA8769242D, 0x3FEE0C15B7632E23));
vec_push(dlu_p, hvec2_new(0x3FEA98636076B666, 0x3FDD81DBD1A9532A));
vec_push(dlu_p, hvec2_new(0x3FC422E52A6C09C8, 0x3FDD22851977B7FC));
vec_push(dlu_p, hvec2_new(0x3FBD67C34F6A2A30, 0x3FEF99504BDA8630));
vec_push(dlu_p, hvec2_new(0x3FC70CE1A98856CC, 0x3FEC05582B4C6EE6));
vec_push(dlu_p, hvec2_new(0x3FC3F8F2F2A3F09C, 0x3FE6CDCE8132D3F1));
vec_push(dlu_p, hvec2_new(0x3FEDF6B8FF30665C, 0x3FBF3E8962E9DA60));
vec_push(dlu_p, hvec2_new(0x3FDD591B04B156E8, 0x3FEB0438AD2BC08A));
vec_push(dlu_p, hvec2_new(0x3FD1676710F19B32, 0x3FC8E45942145290));
vec_push(dlu_p, hvec2_new(0x3FEF472D623A46FD, 0x3FD908955BC97386));
vec_push(dlu_p, hvec2_new(0x3FEF1066CD5B4598, 0x3FE6ADE2DE457104));
vec_push(dlu_p, hvec2_new(0x3FD7DAE09D47AB16, 0x3FDCAA334C08CCB8));
vec_push(dlu_p, hvec2_new(0x3FBF6F4281D4A0C0, 0x3F5B894417A4F800));
var dlu_t = delaunay_2d(dlu_p, 20);
assert_eq(vec_len(dlu_t) / 3, 32, "uniform-20: 32 triangles (10x super-triangle gave 31)");
assert_eq(_dl_tiles_hull(dlu_p, 20, dlu_t), 1, "uniform-20: mesh tiles the hull, no hole");
assert_eq(_dl_used(20, dlu_t), 20, "uniform-20: every input point used");
assert_eq(_dl_max_edge_share(dlu_t), 2, "uniform-20: manifold");
assert_eq(_dl_violations(dlu_p, 20, dlu_t), 0, "uniform-20: empty-circumcircle");

# ⛔ 3.3.4 — the scale class, on full mantissas. These twenty sites lost their mesh from
# 2^258 up and from 2^-266 down: overflowing or flushing orientation and in-circle
# products dropped sites and kept non-Delaunay triangles. delaunay_2d now scales a set
# outside its band into it by a power of two, which changes no decision, so the same 32
# triangles come back in the same order at the two 3.3.3 cliffs and at both ends of the
# range where 2^e times every site is exact.
# [measured: scratch sweep of every exact 2^e (-1021..1024), 3.3.4 base vs this tree, 2026-10-03; cycc 6.6.14]
# `n` sites of `p` times 2^e, as two exact factors 2^(e/2) and 2^(e - e/2).
fn _dl_scaled(p, n, e) {
    var e1 = e / 2;
    var s1 = (1023 + e1) << 52;
    var s2 = (1023 + e - e1) << 52;
    var out = vec_new();
    for (var i = 0; i < n; i = i + 1) {
        var q = vec_get(p, i);
        vec_push(out, hvec2_new(f64_mul(f64_mul(HVec2_x(q), s1), s2), f64_mul(f64_mul(HVec2_y(q), s1), s2)));
    }
    return out;
}
# Index-by-index mismatches between two triangle lists, or (0 - 1) on a length mismatch.
fn _dl_list_diff(got, want) {
    if (vec_len(got) != vec_len(want)) { return 0 - 1; }
    var bad = 0;
    for (var i = 0; i < vec_len(want); i = i + 1) {
        if (vec_get(got, i) != vec_get(want, i)) { bad = bad + 1; }
    }
    return bad;
}
assert_eq(_dl_list_diff(delaunay_2d(_dl_scaled(dlu_p, 20, 258), 20), dlu_t), 0,
  "uniform-20 at 2^258: the scale-1 list, same order (3.3.3: not Delaunay)");
assert_eq(_dl_list_diff(delaunay_2d(_dl_scaled(dlu_p, 20, 1024), 20), dlu_t), 0,
  "uniform-20 at 2^1024: the scale-1 list, same order (3.3.3: 8 triangles, one clockwise)");
assert_eq(_dl_list_diff(delaunay_2d(_dl_scaled(dlu_p, 20, 0 - 266), 20), dlu_t), 0,
  "uniform-20 at 2^-266: the scale-1 list, same order (3.3.3: not Delaunay)");
assert_eq(_dl_list_diff(delaunay_2d(_dl_scaled(dlu_p, 20, 0 - 1021), 20), dlu_t), 0,
  "uniform-20 at 2^-1021, partly subnormal: the scale-1 list, same order (3.3.3: empty)");

# 160 uniform points — the class the audit measured at 15-37% incomplete, and
# 29 of 40 seeds short at this size. Correct 305; the 10x build returned 304.
var dlb_p = _dlr_points(160, 2, F64_ONE, F64_ONE);
var dlb_t = delaunay_2d(dlb_p, 160);
assert_eq(vec_len(dlb_t) / 3, 305, "uniform-160: 305 triangles (10x gave 304)");
assert_eq(_dl_tiles_hull(dlb_p, 160, dlb_t), 1, "uniform-160: mesh tiles the hull");
assert_eq(_dl_used(160, dlb_t), 160, "uniform-160: every input point used");

# A cluster of span 1e-20. The old `dx = max(span, 1.0)` floor gave this a
# super-triangle 1e20 times the data, so the in-circle determinant differenced
# quantities 40 orders apart and lost the sign entirely: 61 triangles instead of
# 70, five points dropped, and a total area 1.69x the convex hull — overlapping,
# not merely incomplete. Ghost vertices have no scale, so there is nothing left
# to mis-scale.
var dlc_p = _dlr_points(40, 1, 0x3BC79CA10C924223, F64_ONE);   # span 1e-20
var dlc_t = delaunay_2d(dlc_p, 40);
assert_eq(vec_len(dlc_t) / 3, 70, "cluster-1e-20: 70 triangles (10x gave 61)");
assert_eq(_dl_tiles_hull(dlc_p, 40, dlc_t), 1,
  "cluster-1e-20: mesh tiles the hull (10x covered 1.69x it)");
assert_eq(_dl_used(40, dlc_t), 40, "cluster-1e-20: every input point used (10x dropped 5)");
assert_eq(_dl_max_edge_share(dlc_t), 2, "cluster-1e-20: manifold");
assert_eq(_dl_violations(dlc_p, 40, dlc_t), 0, "cluster-1e-20: empty-circumcircle");

# Aspect ratio 1e6 (a 1 x 1e-6 strip). The 10x build returned ONE triangle of
# the 70 required and dropped 37 of the 40 points, covering 0.07% of the hull —
# the "extreme-aspect" failure the roadmap carried until 2.8.2's ghost vertices
# fixed it.
var dls_p = _dlr_points(40, 1, F64_ONE, 0x3EB0C6F7A0B5ED8D);   # flat 1e-6
var dls_t = delaunay_2d(dls_p, 40);
assert_eq(vec_len(dls_t) / 3, 70, "thin-strip-1e6: 70 triangles (10x gave 1)");
assert_eq(_dl_used(40, dls_t), 40, "thin-strip-1e6: every input point used (10x dropped 37)");
assert_eq(_dl_max_edge_share(dls_t), 2, "thin-strip-1e6: manifold");
assert_eq(_dl_violations(dls_p, 40, dls_t), 0, "thin-strip-1e6: empty-circumcircle");

test_group("delaunay_2d: emitted winding is counter-clockwise");

# delaunay_2d normalises every emitted triangle to CCW at compaction time and
# nothing verified it. Every other assertion in this file is orientation-blind:
# _dl_area2_abs takes |signed area| specifically so a folded triangle cannot
# cancel, _dl_tiles_hull is built on it, and edge-share count, point usage and
# the empty-circumcircle test are all invariant under a vertex swap. Deleting
# or inverting the swap therefore changed nothing the suite could see -- and
# consumers (halfedge_from_triangles, and anything computing a face normal from
# the vertex order) depend on it.
#
# Strictly positive signed area, over every delaunay fixture in this file: the
# regular grid, the cocircular circle-60, the two irregular hand fixtures, and
# all four ghost-vertex classes including the 1e-20 cluster and the 1e6 strip.
# Strict, not >= 0 -- a zero-area triangle has no winding and would be a defect
# in its own right.
assert_eq(_dl_non_ccw(dl_sq, dl_sqt), 0, "winding: square+interior all CCW");
assert_eq(_dl_non_ccw(dl_g, dl_gt), 0, "winding: 3x3 grid all CCW (cocircular)");
assert_eq(_dl_non_ccw(dl_i, dl_it), 0, "winding: irregular-6 all CCW");
assert_eq(_dl_non_ccw(dcc, dcc_t), 0, "winding: cocircular circle-60 all CCW");
assert_eq(_dl_non_ccw(dlu_p, dlu_t), 0, "winding: uniform-20 all CCW");
assert_eq(_dl_non_ccw(dlb_p, dlb_t), 0, "winding: uniform-160 all CCW");
assert_eq(_dl_non_ccw(dlc_p, dlc_t), 0, "winding: cluster-1e-20 all CCW");
assert_eq(_dl_non_ccw(dls_p, dls_t), 0, "winding: thin-strip-1e6 all CCW");

# The eight assertions above pin the CONTRACT, but on all eight of those inputs
# the swap never fires: the ghost-vertex Bowyer-Watson orients its cavity
# boundaries counter-clockwise by construction, exactly as the comment in
# collision_mesh.cyr claims, so the emitted triangles are already CCW and
# deleting the swap changes nothing they can see.
#
# It is NOT dead code, though. Sweeping 432 point sets -- six generators
# (uniform, clustered, thin-strip, lattice-snapped, cocircular, duplicated) x
# four spans (1, 1e-20, 1e16, 1e-4) x three aspect ratios (1, 1e-6, 5.7e6) --
# with the swap disabled, 430 still came back all-CCW and exactly two did not,
# both in the lattice-snapped extreme-aspect class. That class is reproduced
# here: 16 points on a 6x6 lattice, x = i/6, y = (j/6) * 1e-6, with (1,1)
# duplicated, so the input is simultaneously degenerate (repeated point,
# collinear rows) and aspect-1e6. This is the fixture that makes the
# normalisation load-bearing rather than decorative.
var dlw_ij = alloc(128);
store64(dlw_ij, 101); store64(dlw_ij + 8, 303);
store64(dlw_ij + 16, 305); store64(dlw_ij + 24, 505);
store64(dlw_ij + 32, 0); store64(dlw_ij + 40, 404);
store64(dlw_ij + 48, 504); store64(dlw_ij + 56, 300);
store64(dlw_ij + 64, 1); store64(dlw_ij + 72, 101);
store64(dlw_ij + 80, 302); store64(dlw_ij + 88, 202);
store64(dlw_ij + 96, 3); store64(dlw_ij + 104, 104);
store64(dlw_ij + 112, 403); store64(dlw_ij + 120, 304);
var dlw_p = vec_new();
for (var dlw_i = 0; dlw_i < 16; dlw_i = dlw_i + 1) {
    var dlw_c = load64(dlw_ij + dlw_i * 8);
    vec_push(dlw_p, hvec2_new(f64_div(f64_from(dlw_c / 100), f64_from(6)),
        f64_mul(0x3EB0C6F7A0B5ED8D, f64_div(f64_from(dlw_c % 100), f64_from(6)))));
}
var dlw_t = delaunay_2d(dlw_p, 16);
assert(vec_len(dlw_t) > 0, "winding: the lattice-strip fixture produces triangles at all");
assert_eq(_dl_non_ccw(dlw_p, dlw_t), 0,
  "winding: lattice-snapped 1e6 strip all CCW (the class that REACHES the swap)");

# The harness itself must be able to fail, or the assertions above are just
# ways of counting an empty set. Feed it the same triangles with two vertices
# of each transposed: every one must now read as non-CCW.
var dlw_flip = vec_new();
for (var dlw_k = 0; dlw_k < vec_len(dlu_t); dlw_k = dlw_k + 3) {
    vec_push(dlw_flip, vec_get(dlu_t, dlw_k + 1));
    vec_push(dlw_flip, vec_get(dlu_t, dlw_k));
    vec_push(dlw_flip, vec_get(dlu_t, dlw_k + 2));
}
assert_eq(_dl_non_ccw(dlu_p, dlw_flip), vec_len(dlu_t) / 3,
  "winding: the CCW harness flags all 32 triangles when they are transposed");

test_group("delaunay_2d: ghost directions — the equal-|u_k|² property (2.9.0)");

# The eight fixtures above exercise the ghost MACHINERY but not the six numbers
# it runs on: swapping all of them for the documented failing set
# (-1,-1), (1,-1), (0,1) leaves modules, abuse and hisab green. What follows
# asserts the two properties collision_mesh.cyr's symbolic-ghost-vertices comment
# says the set must have (equal |u_k|^2; positive spanning in counter-clockwise
# order), and then the consequence the tie rule is derived from. See the
# harness comment beside _dlg_l for why these are properties and not literals.

# 1. EQUAL SQUARED NORMS — the load-bearing one, exact, no tolerance.
var dlg_l0 = _dlg_l(0);
var dlg_l1 = _dlg_l(1);
var dlg_l2 = _dlg_l(2);
assert_eq(f64_gt(dlg_l0, 0), 1, "ghost dirs: u0 is not the zero vector");
assert_eq(f64_eq(dlg_l0, dlg_l1), 1, "ghost dirs: |u0|² == |u1|² exactly");
assert_eq(f64_eq(dlg_l1, dlg_l2), 1, "ghost dirs: |u1|² == |u2|² exactly");

# 2. ORIENTATION AND SPANNING. All three cyclic crosses positive says exactly
# that the ghost triangle is counter-clockwise AND the origin lies strictly
# inside it, i.e. the directions positively span the plane, i.e. for large
# enough M the ghost triangle contains any bounded input. The anti-cyclic three
# being the negatives says no two directions are parallel. This is the property
# the failing set ALSO has, which is why it cannot be the only thing asserted.
assert_eq(_col_ghost_cross(0, 1), 1, "ghost dirs: u0 x u1 > 0 (cyclic, CCW)");
assert_eq(_col_ghost_cross(1, 2), 1, "ghost dirs: u1 x u2 > 0 (cyclic, CCW)");
assert_eq(_col_ghost_cross(2, 0), 1, "ghost dirs: u2 x u0 > 0 (cyclic, CCW)");
assert_eq(_col_ghost_cross(1, 0), 0 - 1, "ghost dirs: u1 x u0 < 0 (no two parallel)");
assert_eq(_col_ghost_cross(2, 1), 0 - 1, "ghost dirs: u2 x u1 < 0 (no two parallel)");
assert_eq(_col_ghost_cross(0, 2), 0 - 1, "ghost dirs: u0 x u2 < 0 (no two parallel)");

# 3. THE CONSEQUENCE the predicates are written against: with the norms equal,
# the leading coefficients of the two-ghost in-circle determinant lose their
# dependence on the individual ghosts and collapse to the two cheap forms
# _col_dl_ic_g2 evaluates.
assert_eq(_dlg_c3_bad(), 0,
  "ghost dirs: M³ coefficient collapses to |u|² * (r x (u_j - u_k)) for every r");

_dlg_run(0);
assert_eq(_DLG_PROBES, 450, "ghost dirs: probe grid ran (3 cyclic pairs x 3 apexes x 5 R x 10 p)");
assert_gt(_DLG_DECIDED, 400, "ghost dirs: the grid decides at this order (not a skipped set)");
assert_gt(_DLG_TIE, 200, "ghost dirs: the M² TIE branch is REACHED — no other fixture reaches it");
assert_gt(_DLG_INSIDE, 0, "ghost dirs: the oracle answers inside somewhere");
assert_lt(_DLG_INSIDE, _DLG_DECIDED, "ghost dirs: the oracle answers outside somewhere");
assert_eq(_DLG_TAIL, 0,
  "ghost dirs: M² coefficient == (u_j x u_k)(|R-A|² - |A-p|²), no query-dependent tail");
assert_eq(_DLG_MISMATCH, 0,
  "ghost dirs: _col_dl_ic_g2 agrees with the general-expansion oracle on every probe");
assert_eq(_DLG_PERM, 0,
  "ghost dirs: two-ghost in-circle is INDEPENDENT of vertex order (cyclic entry, all 6)");

# 4. THE ANTI-CYCLIC HALF (2.9.1). Everything above -- and every delaunay_2d
# fixture in every suite -- feeds _col_dl_ic_g2 only the three CYCLIC pairs,
# because _col_dl_incircle rotates a CCW-stored triangle and rotation is even.
# The same grid over the three ANTI-CYCLIC pairs is the other half of the
# predicate's input space, and through 2.9.0 the M² tie branch answered it
# backwards: it multiplied by the winding a SECOND time, and the M² coefficient
# already carries one factor of it. _dlg_truth reads the sign of the leading
# nonzero coefficient against the winding once, which is the rule both branches
# owe, so it is the same oracle in both directions.
_dlg_run(1);
assert_eq(_DLG_PROBES, 450, "anti-cyclic: probe grid ran (3 anti-cyclic pairs x 3 A x 5 R x 10 p)");
assert_gt(_DLG_DECIDED, 400, "anti-cyclic: the grid decides at this order (not a skipped set)");
assert_gt(_DLG_TIE, 200, "anti-cyclic: the M² TIE branch is REACHED on the anti-cyclic half too");
assert_gt(_DLG_INSIDE, 0, "anti-cyclic: the oracle answers inside somewhere");
assert_lt(_DLG_INSIDE, _DLG_DECIDED, "anti-cyclic: the oracle answers outside somewhere");
assert_eq(_DLG_TAIL, 0,
  "anti-cyclic: M² coefficient == (u_j x u_k)(|R-A|² - |A-p|²) with the winding reversed");
assert_eq(_DLG_MISMATCH, 0,
  "anti-cyclic: _col_dl_ic_g2 agrees with the general-expansion oracle (2.9.0 inverted every tie)");
assert_eq(_DLG_PERM, 0,
  "anti-cyclic: two-ghost in-circle is INDEPENDENT of vertex order (anti-cyclic entry, all 6)");

# ================================================================
# gjk_epa_3d — EPA narrowphase (2.8.3)
# ================================================================
#
# Before 2.8.3 gjk_epa_3d had ZERO assertions in all four suites: neither the
# O(k²) blow-up nor a 40x-wrong depth would have been caught by anything. The
# fixtures below are the two the 2026-08-04 audit and the rejected flood-fill
# repair turned on, and each reference value was computed independently of
# hisab — never by running the code being tested.
test_group("geo_advanced: gjk_epa_3d (EPA narrowphase)");

# --- Fixture 1: cylinder vs rotated box (the rejected repair's counter-example)
# A flood-fill visibility scan returns a depth 40.7x too small here. The
# reference depth is the distance from the origin to the boundary of the
# Minkowski difference K = A ⊖ B, i.e. min over unit d of
#   h_K(d) = r·√(dx²+dy²) + hz·|dz| − ⟨d,c⟩ + Σ hᵢ·|⟨d,uᵢ⟩|
# minimised EXACTLY: the four planes dz = 0 and ⟨d,uᵢ⟩ = 0 cut the sphere into
# cells, h_K is r·ρ(d) + ⟨w,d⟩ inside each one (closed-form minimum), and the
# cell boundaries are four great circles (1-D minimisation) meeting at twelve
# vertices. Enumerating all three families is complete → 0.19769663486454536.
# The 2.8.2 roadmap quoted 0.19783922047988 for this fixture (the audit never
# carried it, though this comment once said so); that is a grid minimum,
# 7.2e-4 relative HIGH — both bounds are asserted below, so either reading
# rejects the flood-fill answer.
var epa_cyl = _ga_mkcyl(0, 0, 0,
  0x3FFE11D50BAEBAF1,   # 1.8793535667752475
  0x3FF47743423A7FC0);  # 1.2791168772746317
var epa_box = _ga_mkobb(
  0x4005732F92CFB63E,   # 2.681243082965721
  0xC006EB1792881994,   # -2.8647910545143507
  0xBFFF55B8C5B1A9C0,   # -1.9584281656667457
  0x3FFE93DAB8D7F5D9,   # 1.911097261472028
  0x3FFAE1DE4A99CE2F,   # 1.6801436342328875
  0x3FF3482F05E60E8C,   # 1.20512296966709
  0xBFC3C6C421B492C3,   # -0.15450336118478533
  0xBF83D78D1A18CF7C,   # -0.009688474997439071
  0xBFBCE8D2315CE899,   # -0.11292756753110424
  0x3FEF68328B0A8894);  # 0.9814694133422273
var epa_n = alloc(8);
var epa_d = alloc(8);
_ga_sup_calls = 0;
var epa_arena0 = alloc_used();
var epa_hit = gjk_epa_3d(&_ga_sup_cyl, epa_cyl, &_ga_sup_obb, epa_box, epa_n, epa_d);
var epa_arena = alloc_used() - epa_arena0;
assert_eq(epa_hit, 1, "gjk_epa_3d: cylinder vs rotated box penetrates");
assert(f64_approx_eq(load64(epa_d), 0x3FC94E1F92A2E07C, 0x3EB0C6F7A0B5ED8D),
  "gjk_epa_3d: cyl/box depth == 0.1976966349 ± 1e-6 (flood fill gave 0.00486)");
assert(f64_approx_eq(load64(epa_d), 0x3FC952CBAAE9E248, 0x3F2A36E2EB1C432D),
  "gjk_epa_3d: cyl/box depth == 0.19783922047988 ± 2e-4 (the 2.8.2 roadmap's grid figure)");
var epa_nlen = hvec3_length(load64(epa_n));
assert(f64_approx_eq(epa_nlen, F64_ONE, TOL_1EM12), "gjk_epa_3d: returned normal is unit");

# --- The O(k²) gate. The polytope's face planes used to be recomputed for
# EVERY face on EVERY iteration, each recompute alloc()ing five blocks from an
# arena that never frees — so arena grew with the SQUARE of the iteration count
# (8,576 face evaluations and 1,474,416 bytes for this one call). Cached face
# records make it linear, and the plane is computed once per face created. EPA
# issues exactly one Minkowski support query per iteration, so
# bytes-per-support-call is the scale-free form of that claim: it was 10,531.
# This assertion FAILS against the pre-2.8.3 source, and stays valid if
# EPA_MAX_ITER is ever raised — which is the whole point of testing the ratio
# rather than the total.
#
# 2.9.0: the bound was 2000 against a true value of 727, i.e. 2.75x headroom,
# and a mutation sweep showed that was ~25x above the defect scale — re-adding
# the pre-2.9.0 per-face-record alloc(80) INSIDE the per-iteration visibility
# scan reads 1,602 here and sailed under 2000. Measured on this tree:
# arena 46,544 B over 64 support calls = 727 B/call, IDENTICAL on five
# consecutive runs (the arena is a bump allocator over a fixed code path, so
# there is no run-to-run variation to leave room for). The bound is now 900 —
# 23.8% over the measured value, and the 80 B/face/iteration injection
# overshoots it by 78%.
assert_lt(epa_arena / _ga_sup_calls, 900,
  "gjk_epa_3d: arena per EPA iteration is O(1), not O(faces) (727 B/call, was 10,531)");

# Two identical calls must agree bit-for-bit: the face records are built per
# call, so a leaked pointer or a stale cache between calls would show up here.
var epa_n2 = alloc(8);
var epa_d2 = alloc(8);
gjk_epa_3d(&_ga_sup_cyl, epa_cyl, &_ga_sup_obb, epa_box, epa_n2, epa_d2);
assert_eq(load64(epa_d2), load64(epa_d), "gjk_epa_3d: repeated call is bit-identical (depth)");
assert_eq(HVec3_x(load64(epa_n2)), HVec3_x(load64(epa_n)),
  "gjk_epa_3d: repeated call is bit-identical (normal.x)");

# --- Fixture 2: two spheres, where the depth has a closed form.
# r_a + r_b − |c_a − c_b| = 2.433 + 2.041 − 2.0780998532313117.
var epa_sa = hvec4_new(0, 0, 0, 0x400376C8B4395810);            # r = 2.433
var epa_sb = hvec4_new(0xBFF68B4395810625,                      # -1.409
  0x3FF85E353F7CED91,                                             # 1.523
  0x3FBDF3B645A1CAC1,                                             # 0.117
  0x400053F7CED91687);                                            # r = 2.041
var epa_n3 = alloc(8);
var epa_d3 = alloc(8);
_ga_sup_calls = 0;
var epa_ar3_0 = alloc_used();
var epa_hit3 = gjk_epa_3d(&_ga_sup_sphere, epa_sa, &_ga_sup_sphere, epa_sb, epa_n3, epa_d3);
var epa_ar3 = alloc_used() - epa_ar3_0;
assert_eq(epa_hit3, 1, "gjk_epa_3d: overlapping spheres penetrate");
assert(f64_approx_eq(load64(epa_d3), 0x40032ACDB236D32F, 0x3EE4F8B588E368F1),
  "gjk_epa_3d: sphere/sphere depth == 2.3959001468 ± 1e-5 (closed form)");

# The same O(1)-per-iteration budget on the fixture that runs the MOST
# iterations, which is where a per-face-per-iteration leak is loudest: a smooth
# body never lands a support point exactly on the hull, so this call spends 552
# support queries against the cylinder/box fixture's 64. Measured on this tree:
# 163,488 B over 552 calls = 296 B/call, identical on five consecutive runs.
# The 80 B/face/iteration injection takes it to 917 — 3.1x, the sharpest signal
# of any arena fixture here, because the leak is quadratic in the iteration
# count and this is the fixture with the iterations. Bound 400 = 35% headroom.
assert_gt(_ga_sup_calls, 100, "gjk_epa_3d: the sphere fixture really does run many iterations");
assert_lt(epa_ar3 / _ga_sup_calls, 400,
  "gjk_epa_3d: arena per iteration stays O(1) at 8x the iteration count (296 B/call)");

# --- 2.9.1: THE SAME BUDGET FOR mpr_penetration, ON THE SAME SPHERE PAIR.
# The mpr_penetration arena bound (its `assert_lt` in the ARENA BOUND block of
# the "narrowphase depth == exact MTV" group above) is an ABSOLUTE one taken on
# the off-axis box/box pair, and that fixture runs 24 support calls. It is far too
# short to see a per-face-per-iteration leak: measured on this tree, baseline
# 22,776 B against a 25,600 bound, and the 80 B/face/iteration injection reaches
# only 25,656 -- it clears the bound by 56 B, 0.22%. Any looser and the injection
# passes; any tighter and legitimate change trips it. A thin bound is not fixed
# by a tighter number, it is fixed by a fixture with MORE ITERATIONS, because the
# leak is quadratic in the iteration count while the honest cost is linear.
#
# This is that fixture, and it is deliberately the pair the gjk_epa_3d row above
# already uses, so the two identically-shaped budgets are directly comparable.
# Measured on this tree, byte-identical on five separate processes AND on five
# repeat calls inside one process (alloc_used() over a fixed code path has no
# run-to-run variation, so the headroom below is for future legitimate change,
# not for noise): 167,904 B over 572 support calls = 293 B/call, against the
# sibling's 296 over 552. The injection takes it to 510,944 B = 893 B/call, a
# 3.05x jump -- the same shape as the sibling's 296 -> 917. Bound 400 (the
# sibling's number): 36% headroom, and the injection overshoots it by 123%.
# Detection margin 0.22% -> 123%.
var mpr_ar_n = alloc(8);
var mpr_ar_d = alloc(8);
_ga_sup_calls = 0;
var mpr_ar_0 = alloc_used();
var mpr_ar_hit = mpr_penetration(&_ga_sup_sphere, epa_sa, &_ga_sup_sphere, epa_sb,
  mpr_ar_n, mpr_ar_d);
var mpr_ar = alloc_used() - mpr_ar_0;
var mpr_ar_calls = _ga_sup_calls;
assert_eq(mpr_ar_hit, 1, "mpr_penetration: the high-iteration sphere pair penetrates");
assert(f64_approx_eq(load64(mpr_ar_d), 0x40032ACDB236D32F, 0x3EE4F8B588E368F1),
  "mpr_penetration: sphere/sphere depth == 2.3959001468 (same closed form as gjk_epa_3d)");
assert_gt(mpr_ar_calls, 100,
  "mpr_penetration: the sphere fixture really does run many iterations (572 vs the box pair's 24)");
assert_lt(mpr_ar / mpr_ar_calls, 400,
  "mpr_penetration: arena per iteration stays O(1) at 24x the iteration count (293 B/call)");

# --- Fixture 3: the closest-face TIE-BREAK, which is load-bearing.
# The scan keeps the first face with a STRICTLY smaller distance, and the face
# list is in creation order, so ties resolve to the lowest creation index.
# Relaxing that to ">= wins" (keep the LAST minimum) changes 6,042 of 50,000
# random narrowphase results, 383 of them by more than 0.1% — this fixture is
# one of them: it drops from 0.7379589527 to 0.3718195100. Reference computed
# by the same exact cell/great-circle enumeration as fixture 1:
# 0.737958952740702, which the shipped answer matches to 1.1e-11.
var epa_cyl2 = _ga_mkcyl(0, 0, 0,
  0x4001666666666666,   # 2.175
  0x3FF1A5E353F7CED9);  # 1.103
var epa_box2 = _ga_mkobb(
  0x40067CED916872B0,   # 2.811
  0xC005916872B020C5,   # -2.696
  0xBFE353F7CED91687,   # -0.604
  0x3FE29FBE76C8B439,   # 0.582
  0x40036872B020C49C,   # 2.426
  0x3FF58D4FDF3B645A,   # 1.347
  0x3FEA9F35A31B555D,   # 0.8319347558669211
  0xBF82EE5F07E5ED0F,   # -0.009243719509632457
  0x3FE1BF7917678E3E,   # 0.5546231705779474
  0x3F8C658E8BD8E397);  # 0.013865579264448686
var epa_n5 = alloc(8);
var epa_d5 = alloc(8);
assert_eq(gjk_epa_3d(&_ga_sup_cyl, epa_cyl2, &_ga_sup_obb, epa_box2, epa_n5, epa_d5), 1,
  "gjk_epa_3d: tie-break fixture penetrates");
assert(f64_approx_eq(load64(epa_d5), 0x3FE79D5C17F9F9A6, 0x3EB0C6F7A0B5ED8D),
  "gjk_epa_3d: cyl/box depth == 0.7379589527 ± 1e-6 (last-minimum tie-break gives 0.372)");

# Separated shapes: no penetration, and the miss must not be reported as a hit.
var epa_far = hvec4_new(0x4024000000000000, 0, 0, F64_ONE);     # centre x=10, r=1
var epa_n4 = alloc(8);
var epa_d4 = alloc(8);
assert_eq(gjk_epa_3d(&_ga_sup_sphere, epa_sa, &_ga_sup_sphere, epa_far, epa_n4, epa_d4), 0,
  "gjk_epa_3d: separated spheres do not penetrate");

test_group("_epa_seed_portal: the two SYMMETRY repairs, seen directly (2.9.0)");

# _epa_seed_portal has two branches that exist only for symmetric inputs:
#   * the ORIGIN NUDGE (its `|v0| <= EPSILON_F64 * scale` branch) — the
#     x-midpoint of the difference IS the origin, so the ray v0 -> origin has no
#     direction and the interior point is displaced by a millionth of the body's
#     own extent; and
#   * the COLINEAR-RAY fallback (its `_epa_perp(v0)` branch) — origin, v0 and v1 are
#     colinear, so the plane through them is undefined and ANY perpendicular to
#     v0 serves. The comment records that the shipped code "treated this as a
#     failure and bailed".
# Replacing EITHER with `return 0;` left all five suites green. Both are live:
# mpr_penetration's concentric-sphere depth moves by 1e-9. Nothing noticed,
# because mpr_penetration falls back to _epa_seed_gjk whenever the portal seeder
# returns 0 (that call sat at collision_core.cyr:126 in 2.9.0; mpr_penetration
# moved into geo_advanced.cyr in 3.3.0) and GJK reaches a usable tetrahedron by a
# different route — so both answers land inside the same tolerance and no depth
# assertion at any tolerance a real consumer would accept can tell "the portal
# handled it" from "the portal bailed and GJK covered".
#
# So do not ask the depth. Ask the SEEDER, which is a plain function in the same
# flat namespace: it must RETURN 1 (it handled the case) and the tetrahedron it
# wrote must be a legal EPA seed — non-degenerate volume and the origin strictly
# inside all four faces, which is exactly _epa_tetra_ok's contract.

var psd = alloc(32);
var psd2 = alloc(32);
var psd3 = alloc(32);

# P1 — concentric spheres: the difference is a ball centred ON the origin, so
# the x-midpoint is the origin (NUDGE) and the ray then runs down -x into a
# support point that is also on -x (COLINEAR). Both branches, one fixture.
var psd_a1 = hvec4_new(0, 0, 0, 0x3FF4000000000000);            # r = 1.25
var psd_b1 = hvec4_new(0, 0, 0, 0x3FE8000000000000);            # r = 0.75
assert_eq(_epa_seed_portal(&_ga_sup_sphere, psd_a1, &_ga_sup_sphere, psd_b1, psd), 1,
  "portal seed: concentric spheres are SEEDED, not bailed on");
assert_eq(_psd_ok(psd), 1,
  "portal seed: the concentric-sphere tetrahedron encloses the origin");

# P2 — spheres offset along x by 0.5: the difference is a ball centred at
# (-0.5, 0, 0), so the x-midpoint is NOT the origin (no nudge) but the ray
# v0 -> origin still runs along x into an x-axis support point (COLINEAR only).
var psd_b2 = hvec4_new(0x3FE0000000000000, 0, 0, 0x3FE8000000000000);   # c=(0.5,0,0)
assert_eq(_epa_seed_portal(&_ga_sup_sphere, psd_a1, &_ga_sup_sphere, psd_b2, psd2), 1,
  "portal seed: colinear ray with an off-origin interior point is SEEDED");
assert_eq(_psd_ok(psd2), 1,
  "portal seed: the offset-sphere tetrahedron encloses the origin");

# P3 — a generically rotated box against a sphere, both centred at the origin.
# The rotation has no zero component, so the box's +x and -x support points are
# exact negatives of each other and the x-midpoint is again the origin (NUDGE),
# but they are corners well off the x axis, so the ray is NOT colinear.
var psd_q = f64_div(F64_ONE, f64_sqrt(f64_from(30)));
var psd_a3 = _ga_mkobb(0, 0, 0, F64_ONE, F64_TWO, f64_from(3),
  psd_q, f64_mul(F64_TWO, psd_q), f64_mul(f64_from(3), psd_q), f64_mul(f64_from(4), psd_q));
var psd_b3 = hvec4_new(0, 0, 0, F64_HALF);
assert_eq(_epa_seed_portal(&_ga_sup_obb, psd_a3, &_ga_sup_sphere, psd_b3, psd3), 1,
  "portal seed: origin x-midpoint with a NON-colinear ray is SEEDED");
assert_eq(_psd_ok(psd3), 1,
  "portal seed: the box/sphere tetrahedron encloses the origin");

# And the depth that seed produces still has to be right — asserted here so a
# seed that merely satisfies _epa_tetra_ok cannot pass while feeding _epa_refine
# a tetrahedron that is legal but useless. Concentric: r_a + r_b = 2 exactly.
# Offset by 0.5: r_a + r_b - |c| = 1.5 exactly.
var psd_n = alloc(8);
var psd_d = alloc(8);
assert_eq(mpr_penetration(&_ga_sup_sphere, psd_a1, &_ga_sup_sphere, psd_b1, psd_n, psd_d), 1,
  "portal seed: concentric spheres report a hit");
assert(f64_approx_eq(load64(psd_d), F64_TWO, 0x3EB0C6F7A0B5ED8D),
  "portal seed: concentric-sphere depth == 2.0 ± 1e-6 (r_a + r_b)");
assert_eq(mpr_penetration(&_ga_sup_sphere, psd_a1, &_ga_sup_sphere, psd_b2, psd_n, psd_d), 1,
  "portal seed: offset spheres report a hit");
assert(f64_approx_eq(load64(psd_d), 0x3FF8000000000000, 0x3EB0C6F7A0B5ED8D),
  "portal seed: offset-sphere depth == 1.5 ± 1e-6 (r_a + r_b - |c|)");

# 2.8.3 memory safety — the guards, and the answers they must not change
# ================================================================
#
# Every assertion in this block was written against the UNFIXED source first.
# The ones marked "(SIGSEGV)" killed the process with exit 139 rather than
# printing a FAIL line; the num_halton base-0 case raised SIGFPE and base 1
# never returned; the spatial-hash 1e6 case did not terminate in 120 s.

test_group("2.8.3: tensor_add / tensor_scale / tensor_contract null + shape guards");

# tensor_new and einsum both document a 0 return on failure. Storing through it
# is a null dereference (SIGSEGV).
var ms_sh22 = alloc(16); store64(ms_sh22, 2); store64(ms_sh22 + 8, 2);
var ms_sh21 = alloc(16); store64(ms_sh21, 2); store64(ms_sh21 + 8, 1);
var ms_a = tensor_new(2, ms_sh22);
var ms_b = tensor_new(2, ms_sh21);
tensor_set2(ms_a, 0, 0, F64_ONE); tensor_set2(ms_a, 0, 1, F64_TWO);
tensor_set2(ms_a, 1, 0, f64_from(3)); tensor_set2(ms_a, 1, 1, f64_from(4));
assert_eq(tensor_add(0, ms_a), 0, "tensor_add(0, t) -> 0 (SIGSEGV)");
assert_eq(tensor_add(ms_a, 0), 0, "tensor_add(t, 0) -> 0 (SIGSEGV)");
# 2x2 + 2x1 walked 4 elements of a 2-element buffer and returned adjacent heap.
assert_eq(tensor_add(ms_a, ms_b), 0, "tensor_add: shape mismatch -> 0 (was an over-read)");
assert_eq(tensor_scale(0, F64_TWO), 0, "tensor_scale(0, s) -> 0 (SIGSEGV)");
assert_eq(tensor_contract(0, 0, 1), 0, "tensor_contract(0, ..) -> 0 (SIGSEGV)");
# Same total, different shape: rank alone would let this through.
var ms_sh26 = alloc(16); store64(ms_sh26, 2); store64(ms_sh26 + 8, 6);
var ms_sh34 = alloc(16); store64(ms_sh34, 3); store64(ms_sh34 + 8, 4);
assert_eq(tensor_add(tensor_new(2, ms_sh26), tensor_new(2, ms_sh34)), 0,
  "tensor_add: 2x6 + 3x4 (equal totals) -> 0");
# The valid path is untouched: 1+3 = 4 and 2+4 = 6 on identical shapes.
var ms_sum = tensor_add(ms_a, ms_a);
assert_eq(tensor_get2(ms_sum, 1, 0), f64_from(6), "tensor_add: identical shapes still add");

test_group("2.8.3: tensor_contract validates idx_i / idx_j against the rank");

# Every one of these was a raw load64/store64 at `shape + idx*8` and
# `full_idx + idx*8` with no bound of any kind.
assert_eq(tensor_contract(ms_a, 0 - 1, 1), 0, "contract: idx_i = -1 -> 0 (read/write before shape)");
assert_eq(tensor_contract(ms_a, 0, 0 - 1), 0, "contract: idx_j = -1 -> 0");
assert_eq(tensor_contract(ms_a, 0, 5), 0, "contract: idx_j >= rank -> 0");
assert_eq(tensor_contract(ms_a, 7, 1), 0, "contract: idx_i >= rank -> 0");
assert_eq(tensor_contract(ms_a, 1, 1), 0, "contract: idx_i == idx_j -> 0 (not a trace)");
var ms_r1 = alloc(8); store64(ms_r1, 3);
assert_eq(tensor_contract(tensor_new(1, ms_r1), 0, 0), 0, "contract: rank 1 -> 0");
# Extents must match or the k loop overruns one of the two axes.
var ms_sh23 = alloc(16); store64(ms_sh23, 2); store64(ms_sh23 + 8, 3);
assert_eq(tensor_contract(tensor_new(2, ms_sh23), 0, 1), 0,
  "contract: mismatched extents (2 vs 3) -> 0");

# ...and the arithmetic is unchanged. Rank-4 shape (2,3,2,3), entry = flat+1.
# Reference computed exactly in Python over the integers:
#   contract(0,2) -> 3x3 = [[23,25,27],[35,37,39],[47,49,51]]
#   contract(1,3) -> 2x2 = [[24,33],[78,87]]
var ms_sh4 = alloc(32);
store64(ms_sh4, 2); store64(ms_sh4 + 8, 3); store64(ms_sh4 + 16, 2); store64(ms_sh4 + 24, 3);
var ms_t4 = tensor_new(4, ms_sh4);
var ms_fi = 0;
while (ms_fi < 36) {
    store64(HTensor_data(ms_t4) + ms_fi * 8, f64_from(ms_fi + 1));
    ms_fi = ms_fi + 1;
}
var ms_c02 = tensor_contract(ms_t4, 0, 2);
assert_eq(HTensor_rank(ms_c02), 2, "contract(0,2): rank 4 -> 2");
assert_eq(tensor_get2(ms_c02, 0, 0), f64_from(23), "contract(0,2)[0][0] = 23");
assert_eq(tensor_get2(ms_c02, 0, 2), f64_from(27), "contract(0,2)[0][2] = 27");
assert_eq(tensor_get2(ms_c02, 2, 0), f64_from(47), "contract(0,2)[2][0] = 47");
assert_eq(tensor_get2(ms_c02, 2, 2), f64_from(51), "contract(0,2)[2][2] = 51");
var ms_c13 = tensor_contract(ms_t4, 1, 3);
assert_eq(tensor_get2(ms_c13, 0, 0), f64_from(24), "contract(1,3)[0][0] = 24");
assert_eq(tensor_get2(ms_c13, 0, 1), f64_from(33), "contract(1,3)[0][1] = 33");
assert_eq(tensor_get2(ms_c13, 1, 0), f64_from(78), "contract(1,3)[1][0] = 78");
assert_eq(tensor_get2(ms_c13, 1, 1), f64_from(87), "contract(1,3)[1][1] = 87");
# Axis order must not matter for a trace.
var ms_c20 = tensor_contract(ms_t4, 2, 0);
assert_eq(tensor_get2(ms_c20, 1, 1), f64_from(37), "contract(2,0) == contract(0,2)");

test_group("2.8.3: cmat_* null guards (the four the 2.7.0-B family missed)");

# No cap breach is needed to reach any of these: cmat_mul's own conformability
# guard hands back the 0.
var ms_23 = cmat_new(2, 3);
var ms_22 = cmat_new(2, 2);
assert_eq(cmat_mul(ms_23, ms_22), 0, "cmat_mul(2x3, 2x2) -> 0 (non-conformable)");
assert_eq(cmat_exp(cmat_mul(ms_23, ms_22)), 0, "cmat_exp(that 0) -> 0 (SIGSEGV)");
# Non-square. This one did NOT crash before: the Frobenius loop over-read the
# last element of a 3x2 and the Taylor loop then cascaded to 0 through
# cmat_mul's own guard, so the return value is unchanged and only the over-read
# and the wasted work are gone. Kept as a contract assertion, not a repro.
assert_eq(cmat_exp(cmat_new(3, 2)), 0, "cmat_exp(3x2) -> 0 (non-square)");
assert_eq(cmat_exp(ms_23), 0, "cmat_exp(2x3) -> 0 (non-square)");
assert_eq(cmat_mul_vec(0, alloc(32)), 0, "cmat_mul_vec(0, v) -> 0 (SIGSEGV)");
assert_eq(cmat_mul_vec(ms_22, 0), 0, "cmat_mul_vec(m, 0) -> 0 (SIGSEGV)");
assert_eq(cmat_kronecker(0, ms_22), 0, "cmat_kronecker(0, b) -> 0 (SIGSEGV)");
assert_eq(cmat_kronecker(ms_22, 0), 0, "cmat_kronecker(a, 0) -> 0 (SIGSEGV)");
assert_eq(cmat_inverse(0), 0, "cmat_inverse(0) -> 0 (SIGSEGV)");
# exp(0) = I on a square input is unchanged.
var ms_e = cmat_exp(cmat_new(2, 2));
assert_neq(ms_e, 0, "cmat_exp(2x2 zero) still returns a matrix");
assert_eq(HComplex_re(cmat_get(ms_e, 0, 0)), f64_from(1), "cmat_exp(0) = I: [0][0] = 1");
assert_eq(HComplex_re(cmat_get(ms_e, 0, 1)), f64_from(0), "cmat_exp(0) = I: [0][1] = 0");

test_group("2.8.3: calc_partial_derivative bounds BOTH ends of index");

# index = -1 was one out-of-bounds READ of x and two out-of-bounds WRITES, one
# into each of the freshly bumped x_plus / x_minus blocks.
var ms_x = alloc(16);
store64(ms_x, f64_from(3)); store64(ms_x + 8, f64_from(4));
var ms_h = F64_HALF;
assert_eq(calc_partial_derivative(&_c9_f, ms_x, 2, 0 - 1, ms_h), 0, "index = -1 -> 0");
assert_eq(calc_partial_derivative(&_c9_f, ms_x, 2, 0 - 4096, ms_h), 0, "index = -4096 -> 0");
assert_eq(calc_partial_derivative(&_c9_f, ms_x, 2, 2, ms_h), 0, "index == n -> 0 (already held)");
assert_eq(calc_partial_derivative(&_c9_f, ms_x, 0, 0, ms_h), 0, "n = 0 -> 0 (already held)");
assert_eq(calc_partial_derivative(&_c9_f, ms_x, 0 - 3, 0, ms_h), 0, "n = -3 -> 0 (already held)");
# n <= 0 only reached the old `index >= n` guard when index was >= n as well.
# n = -3 with index = -5 slips past it into alloc(-24) plus two wild stores.
assert_eq(calc_partial_derivative(&_c9_f, ms_x, 0 - 3, 0 - 5, ms_h), 0,
  "n = -3, index = -5 -> 0 (SIGSEGV)");
# Closed form, exact in binary: for f = x0^2 + x1^2 the central difference is
# ((3+h)^2 - (3-h)^2) / 2h = 12h / 2h = 6 for ANY h, and h = 0.5 keeps every
# intermediate exactly representable.
assert_eq(calc_partial_derivative(&_c9_f, ms_x, 2, 0, ms_h), f64_from(6),
  "valid index: d/dx0 = 6 exactly");
assert_eq(calc_partial_derivative(&_c9_f, ms_x, 2, 1, ms_h), f64_from(8),
  "valid index: d/dx1 = 8 exactly");

test_group("2.8.3: num_halton rejects bases below 2");

# base 0 divided by zero (SIGFPE, process dead); base 1 made i / base == i, so
# the loop never advanced and the call never returned.
assert_eq(num_halton(7, 0), 0, "base 0 -> 0.0 (was SIGFPE)");
assert_eq(num_halton(7, 1), 0, "base 1 -> 0.0 (was an infinite loop)");
assert_eq(num_halton(7, 0 - 2), 0, "base -2 -> 0.0 (left the documented range)");
# Van der Corput base 2 is exact in binary: 1/2, 1/4, 3/4, 1/8, 5/8, 3/8, 7/8.
assert_eq(num_halton(1, 2), F64_HALF, "halton(1,2) = 0.5");
assert_eq(num_halton(2, 2), f64_div(F64_ONE, f64_from(4)), "halton(2,2) = 0.25");
assert_eq(num_halton(3, 2), f64_div(f64_from(3), f64_from(4)), "halton(3,2) = 0.75");
assert_eq(num_halton(5, 2), f64_div(f64_from(5), f64_from(8)), "halton(5,2) = 0.625");
assert_eq(num_halton(7, 2), f64_div(f64_from(7), f64_from(8)), "halton(7,2) = 0.875");
# Base 3 is not exact in binary, but index 1 is a single term: 1 * (1/3).
assert_eq(num_halton(1, 3), f64_div(F64_ONE, f64_from(3)), "halton(1,3) = 1/3");

test_group("2.8.3: spatial_hash_query_radius is bounded by the grid, not the radius");

# 300 points on a unit grid at (k + 0.5) so the cell index is exact. Every count
# below is an exact integer computed in Python over the cell indices --
# #{p : max(|px-qx|, |py-qy|, |pz-qz|) <= ceil(radius)} -- not read off this
# implementation. r <= 4 takes the per-cell block walk, r >= 5 takes the
# bucket walk, so both branches and the crossover are pinned.
var ms_sh = spatial_hash_new(F64_ONE);
var ms_n = 0;
while (ms_n < 300) {
    var ms_ix = _m3_next();
    var ms_iy = _m3_next();
    var ms_iz = _m3_next();
    spatial_hash_insert(ms_sh, hvec3_new(_m3_cc(ms_ix), _m3_cc(ms_iy), _m3_cc(ms_iz)), ms_n);
    ms_n = ms_n + 1;
}
assert_eq(_m3_shq(ms_sh, 0, 0, 0, 2), 4, "q(0,0,0) r=2 -> 4");
assert_eq(_m3_shq(ms_sh, 0, 0, 0, 4), 18, "q(0,0,0) r=4 -> 18 (per-cell path)");
assert_eq(_m3_shq(ms_sh, 0, 0, 0, 5), 37, "q(0,0,0) r=5 -> 37 (bucket-walk path)");
assert_eq(_m3_shq(ms_sh, 0, 0, 0, 6), 65, "q(0,0,0) r=6 -> 65");
assert_eq(_m3_shq(ms_sh, 0, 0, 0, 8), 155, "q(0,0,0) r=8 -> 155");
assert_eq(_m3_shq(ms_sh, 0, 0, 0, 12), 300, "q(0,0,0) r=12 -> all 300");
assert_eq(_m3_shq(ms_sh, 7, 0 - 7, 3, 3), 8, "q(7,-7,3) r=3 -> 8");
assert_eq(_m3_shq(ms_sh, 7, 0 - 7, 3, 4), 16, "q(7,-7,3) r=4 -> 16 (per-cell path)");
assert_eq(_m3_shq(ms_sh, 7, 0 - 7, 3, 5), 24, "q(7,-7,3) r=5 -> 24 (bucket-walk path)");
assert_eq(_m3_shq(ms_sh, 7, 0 - 7, 3, 8), 70, "q(7,-7,3) r=8 -> 70");
assert_eq(_m3_shq(ms_sh, 7, 0 - 7, 3, 12), 159, "q(7,-7,3) r=12 -> 159");
# 1e6 / 1.0 asked for (2e6+1)^3 = 8e18 cell probes: no answer in 120 s.
assert_eq(_m3_shq(ms_sh, 0, 0, 0, 1000000), 300, "q(0,0,0) r=1e6 -> 300 (was 8e18 probes)");
assert_eq(_m3_shq(ms_sh, 0, 0, 0, 0 - 5), 0, "negative radius -> empty");
# Coincident cluster: 50 in cell (3,3,3), 1 in (9,9,9) at Chebyshev distance 6.
var ms_sh2 = spatial_hash_new(F64_ONE);
var ms_c = 0;
while (ms_c < 50) {
    spatial_hash_insert(ms_sh2, hvec3_new(_m3_cc(3), _m3_cc(3), _m3_cc(3)), ms_c);
    ms_c = ms_c + 1;
}
spatial_hash_insert(ms_sh2, hvec3_new(_m3_cc(9), _m3_cc(9), _m3_cc(9)), 999);
assert_eq(_m3_shq(ms_sh2, 3, 3, 3, 0), 50, "cluster r=0 -> 50");
assert_eq(_m3_shq(ms_sh2, 3, 3, 3, 5), 50, "cluster r=5 -> 50 (bucket walk still filters)");
assert_eq(_m3_shq(ms_sh2, 3, 3, 3, 6), 51, "cluster r=6 -> 51");
assert_eq(_m3_shq(ms_sh2, 3, 3, 3, 1000000), 51, "cluster r=1e6 -> 51");
assert_eq(vec_len(spatial_hash_query_radius(ms_sh2,
      hvec3_new(_m3_cc(3), _m3_cc(3), _m3_cc(3)), _SP_F64_POS_INF)), 51,
  "+Inf radius -> every entry (range test dropped, not the loop)");
# 2.8.3 -- api-consistency repairs.
# Every assertion below fails against the 2.8.2 source.
# ================================================================

test_group("bvh_query_ray: a t = 0 hit is a hit, not a pruned subtree");

# geo_ray_aabb returns the hit parameter t and uses 0 as its miss sentinel, so
# "miss" and "hit at t = 0" were the same value and the walker's `== 0` prune
# threw away the node AND ITS WHOLE SUBTREE. Two unit boxes sharing the plane
# x = 1; truth for every ray below is computed by hand and cross-checked against
# an exact python3 Fraction slab reference over 1680 queries (42 scenes).
var br_arr = alloc(16);
store64(br_arr, geo_aabb_new(hvec3_new(0, 0, 0), hvec3_new(F64_ONE, F64_ONE, F64_ONE)));
store64(br_arr + 8, geo_aabb_new(hvec3_new(F64_ONE, 0, 0),
    hvec3_new(F64_TWO, F64_ONE, F64_ONE)));
var br_tree = bvh_build(br_arr, 2);
var br_dirx = hvec3_new(F64_ONE, 0, 0);

# Origin ON the shared face: enters box 1 at t = 0, grazes box 0's far face at
# t = 0 as well. Both are hits; the old walker reported neither.
var br_face = geo_ray_new(hvec3_new(F64_ONE, F64_HALF, F64_HALF), br_dirx);
assert_eq(vec_len(bvh_query_ray(br_tree, br_face)), 2,
  "ray from the shared face reports both boxes (was 0)");

# Origin at the scene's minimum corner: t = 0 at the ROOT, so the old walker
# pruned the entire tree in one test.
var br_min = geo_ray_new(hvec3_new(0, F64_HALF, F64_HALF), br_dirx);
assert_eq(vec_len(bvh_query_ray(br_tree, br_min)), 2,
  "ray from the scene minimum corner reports both boxes (was 0)");

# Strictly interior origin: t_min < 0 < t_max, so this ALREADY worked. It is the
# regression guard -- the widened predicate must not have changed it.
var br_in = geo_ray_new(hvec3_new(F64_HALF, F64_HALF, F64_HALF), br_dirx);
assert_eq(vec_len(bvh_query_ray(br_tree, br_in)), 2, "interior origin still reports both");

# Pruning must still prune: a ray behind the scene pointing away hits nothing,
# and a parallel ray outside the slab hits nothing.
var br_away = geo_ray_new(hvec3_new(f64_from(10), F64_HALF, F64_HALF), br_dirx);
assert_eq(vec_len(bvh_query_ray(br_tree, br_away)), 0, "ray past the scene, pointing away -> 0");
var br_miss = geo_ray_new(hvec3_new(0, f64_from(5), F64_HALF), br_dirx);
assert_eq(vec_len(bvh_query_ray(br_tree, br_miss)), 0, "parallel ray outside the y slab -> 0");

# A zero-size AABB sitting exactly on the ray: t_min == t_max == 0 at that leaf.
var br_pt = alloc(8);
var br_p = hvec3_new(F64_TWO, 0, 0);
store64(br_pt, geo_aabb_new(br_p, br_p));
var br_ptree = bvh_build(br_pt, 1);
assert_eq(vec_len(bvh_query_ray(br_ptree, geo_ray_new(hvec3_zero(), br_dirx))), 1,
  "degenerate point AABB on the ray is found (was 0)");

test_group("gjk_epa_3d: agrees with gjk_intersect_3d, always writes its out-params");

# Two zero-height boxes overlapping in the z = 0 plane. The Minkowski difference
# contains the origin but has no volume, so EPA has no polytope to expand: the
# old code returned 0 ("not penetrating"), contradicting its own sibling, and
# wrote NEITHER out-param. The right answer is depth exactly 0 with a unit
# normal of the set's affine hull -- here exactly +/-z, a closed form.
var ep_n = alloc(8);
var ep_d = alloc(8);
var ep_fa = _mpr_mkbox(0, 0, 0, F64_ONE, F64_ONE, 0);
var ep_fb = _mpr_mkbox(F64_HALF, F64_HALF, 0, F64_ONE, F64_ONE, 0);
assert_eq(gjk_intersect_3d(&_mpr_sup_box, ep_fa, &_mpr_sup_box, ep_fb), 1,
  "coplanar flat boxes: gjk_intersect says overlapping");
assert_eq(gjk_epa_3d(&_mpr_sup_box, ep_fa, &_mpr_sup_box, ep_fb, ep_n, ep_d), 1,
  "coplanar flat boxes: gjk_epa agrees (was 0)");
assert_eq(load64(ep_d), 0, "coplanar flat boxes: depth is exactly 0");
assert_neq(load64(ep_n), 0, "coplanar flat boxes: normal is not the NULL HVec3");
assert_eq(_ac_len_sq_e9(ep_n), 1000000000, "coplanar flat boxes: normal is a unit vector");
assert_eq(_ac_comp_e9(ep_n, 0), 0, "coplanar flat boxes: normal has no x component");
assert_eq(_ac_comp_e9(ep_n, 1), 0, "coplanar flat boxes: normal has no y component");

# Two zero-thickness segments crossing at the origin: hull is a planar
# parallelogram, so again +/-z with depth 0.
var ep_sa = _mpr_mkbox(0, 0, 0, F64_ONE, 0, 0);
var ep_sb = _mpr_mkbox(0, 0, 0, 0, F64_ONE, 0);
assert_eq(gjk_intersect_3d(&_mpr_sup_box, ep_sa, &_mpr_sup_box, ep_sb), 1,
  "crossing segments: gjk_intersect says overlapping");
assert_eq(gjk_epa_3d(&_mpr_sup_box, ep_sa, &_mpr_sup_box, ep_sb, ep_n, ep_d), 1,
  "crossing segments: gjk_epa agrees (was 0)");
assert_eq(load64(ep_d), 0, "crossing segments: depth is exactly 0");
assert_eq(_ac_len_sq_e9(ep_n), 1000000000, "crossing segments: normal is a unit vector");

# EXACT TANGENCY. Unit sphere at the origin, unit-half box centred at x = 2:
# they touch at the single point (1,0,0). Penetration depth is exactly 0 and the
# contact normal is exactly the line of centres.
var ep_sph = hvec4_new(0, 0, 0, F64_ONE);
var ep_box = _mpr_mkbox(F64_TWO, 0, 0, F64_ONE, F64_ONE, F64_ONE);
assert_eq(gjk_epa_3d(&_mpr_sup_sphere, ep_sph, &_mpr_sup_box, ep_box, ep_n, ep_d), 1,
  "tangent sphere/box: gjk_epa reports contact (was 0)");
assert_eq(load64(ep_d), 0, "tangent sphere/box: depth is exactly 0");
# ⛔ 2.14.0 — THIS ASSERTED -x AND -x WAS THE FABRICATION. The tangent case is the
# only one of the three that reaches EPA's DEGENERATE path, and that path ran
# through `hvec3_normalize`, which used to return the ZERO VECTOR for any input
# shorter than 1e-12. Repairing that guard flipped this to +x — so the pinned sign
# had been produced by the zeroing, not by the geometry.
# ⭐ +x is right, and it is settled by CONTINUITY rather than by argument: the same
# sphere and box OVERLAPPING (box centre 1.5 and 1.75, which never enter the
# degenerate path) return normal +x with depths exactly 0.5 and 0.25. Tangency is
# the limit of that family as the overlap goes to 0, so a normal that flips sign
# there was inconsistent with its own neighbourhood. It also matches the stated
# contract — "translating B by depth * normal separates the pair" — since +x moves
# the box away from the sphere and -x drives it in.
# [measured: probe over box centres 1.5 / 1.75 / 2.0 on the repaired tree]
assert_eq(_ac_comp_e9(ep_n, 0), 1000000000, "tangent sphere/box: normal is exactly +x");
# ⚠ And the continuity itself is now asserted, so the sign cannot drift back
# without the overlapping neighbours disagreeing out loud.
var ep_ov = _mpr_mkbox(f64_div(f64_from(3), F64_TWO), 0, 0, F64_ONE, F64_ONE, F64_ONE);
assert_eq(gjk_epa_3d(&_mpr_sup_sphere, ep_sph, &_mpr_sup_box, ep_ov, ep_n, ep_d), 1,
  "overlapping sphere/box: gjk_epa reports contact");
assert_eq(_ac_comp_e9(ep_n, 0), 1000000000,
  "overlapping sphere/box: normal is +x, the same sign the tangent case must take");
# ⚠ APPROXIMATE, and deliberately so: EPA refines iteratively, so the depth is
# 0.500000000001391 — 1.4e-12 out, its convergence tolerance, not a defect.
# The SIGN above is the assertion that discriminates and it is bit-exact.
# [measured: bit pattern 0x3FE00000000030F1 vs 0.5, 12529 ULP, 2026-09-09]
assert(f64_approx_eq(load64(ep_d), F64_HALF, LOOSE_TOL_M) == 1,
  "overlapping sphere/box: depth converges to 0.5");
assert_eq(_ac_comp_e9(ep_n, 1), 0, "tangent sphere/box: normal has no y component");
assert_eq(_ac_comp_e9(ep_n, 2), 0, "tangent sphere/box: normal has no z component");

# Genuinely separated shapes must still report 0 -- and now leave DEFINED
# out-params rather than whatever the caller's slots held.
store64(ep_n, 0);
store64(ep_d, 0);
var ep_far = _mpr_mkbox(f64_from(9), 0, 0, F64_ONE, F64_ONE, F64_ONE);
assert_eq(gjk_epa_3d(&_mpr_sup_box, ep_box, &_mpr_sup_box, ep_far, ep_n, ep_d), 0,
  "well-separated boxes: still 0");
assert_neq(load64(ep_n), 0, "0 return still writes a readable normal, not a null");
assert_eq(_ac_len_sq_e9(ep_n), 1000000000, "0 return writes a unit normal");

# A real, full-dimensional overlap is untouched by the degenerate paths: it must
# still report a strictly positive depth. (The VALUE of that depth is not pinned
# here yet. The "separate open finding" this once waited on, the narrowphase
# exact-MTV defect, closed in 2.8.3, and the "narrowphase depth == exact MTV"
# group above asserts box/box depths against exact SAT. This pair's closed-form
# depth is exactly 1.5 -- unit half-extents centred at x = 2 and x = 1.5 -- and
# pinning it is roadmap [3.3.5], audit D067.)
var ep_ov = _mpr_mkbox(f64_add(F64_ONE, F64_HALF), 0, 0, F64_ONE, F64_ONE, F64_ONE);
assert_eq(gjk_epa_3d(&_mpr_sup_box, ep_box, &_mpr_sup_box, ep_ov, ep_n, ep_d), 1,
  "overlapping boxes: still 1");
assert_eq(f64_gt(load64(ep_d), 0), 1, "overlapping boxes: depth is strictly positive");
assert_eq(_ac_len_sq_e9(ep_n), 1000000000, "overlapping boxes: normal is a unit vector");

# A MANUFACTURED PROBE DIRECTION CERTIFIES NOTHING. hvec3_length_sq SQUARES, so
# for two zero-volume shapes separated by less than sqrt(DBL_MIN) ~ 1.5e-154 the
# search direction underflows to exactly 0; the degenerate-direction repair then
# substitutes a cardinal axis, and the support along that axis is exactly 0. That
# is not a supporting plane through the origin, and reading it as one reported 64
# genuinely separated point-vs-point pairs as contacts.
var ep_z0 = _mpr_mkbox(0, 0, 0, 0, 0, 0);
var ep_z1 = _mpr_mkbox(0, 0, 0x1DAD7BECC2F23AC2, 0, 0, 0);   # z = 1e-165
assert_eq(gjk_epa_3d(&_mpr_sup_box, ep_z0, &_mpr_sup_box, ep_z1, ep_n, ep_d), 0,
  "zero-volume boxes 1e-165 apart: separated, not a touch");
assert_neq(load64(ep_n), 0, "1e-165 separation still leaves a readable normal");

# The complement: genuinely COINCIDENT zero-volume shapes do touch, at depth 0.
# Guarding the manufactured direction must not cost this.
var ep_z2 = _mpr_mkbox(0, 0, 0, 0, 0, 0);
assert_eq(gjk_epa_3d(&_mpr_sup_box, ep_z0, &_mpr_sup_box, ep_z2, ep_n, ep_d), 1,
  "coincident zero-volume boxes: a touch at depth 0");
assert_eq(load64(ep_d), 0, "coincident zero-volume boxes: depth is exactly 0");

# ================================================================
# 2.9.0: the four fixtures the two entry points actually disagreed on.
# ================================================================
# Named individually because they are the reproducers, and an aggregate that
# happens to come out right must not be able to hide any one of them.
assert_eq(gjk_intersect_3d(&_mpr_sup_sphere, ep_sph, &_mpr_sup_box, ep_box), 1,
  "tangent sphere/box: gjk_intersect agrees with gjk_epa (was 0)");
assert_eq(gjk_intersect_3d(&_mpr_sup_box, ep_box, &_mpr_sup_sphere, ep_sph), 1,
  "tangent box/sphere: same in the reversed operand order (was 0)");
assert_eq(gjk_intersect_3d(&_mpr_sup_box, ep_z0, &_mpr_sup_box, ep_z2), 1,
  "coincident zero-size boxes: gjk_intersect agrees with gjk_epa (was 0)");
var ag_p0 = hvec4_new(0, 0, 0, 0);
var ag_p1 = hvec4_new(0, 0, 0, 0);
assert_eq(gjk_epa_3d(&_mpr_sup_sphere, ag_p0, &_mpr_sup_sphere, ag_p1, ep_n, ep_d), 1,
  "coincident zero-radius spheres: gjk_epa reports a touch");
assert_eq(gjk_intersect_3d(&_mpr_sup_sphere, ag_p0, &_mpr_sup_sphere, ag_p1), 1,
  "coincident zero-radius spheres: gjk_intersect agrees (was 0)");

# The complement, and the one that matters most: the repair must NOT turn the
# 1e-165 separation above -- the case a manufactured probe direction reported as
# 64 false contacts -- into a contact for the cheap test either.
assert_eq(gjk_intersect_3d(&_mpr_sup_box, ep_z0, &_mpr_sup_box, ep_z1), 0,
  "zero-volume boxes 1e-165 apart: gjk_intersect says separated, like gjk_epa");

# ================================================================
# 2.9.1: the SIX configurations mpr_intersect actually disagreed on.
# ================================================================
# Found by a 1,149-fixture x 5-scale x 2-order sweep classified exactly in
# rationals; the 50 divergent evaluations in its exact-support half reduce to
# these six. Named individually for the same reason as the block above.
#
# The last two are the ones no previous report had: NOT self-pairs, and one
# operand is a solid unit box. They are also where mpr_intersect was
# ORDER-DEPENDENT -- it answered 0 with the box first and 1 with the point first.
# A point resting on the corner of a box is a real resting-contact pose, not a
# pathology, which is why "keep the strict reading and document it" was rejected.
test_group("mpr_intersect / mpr_penetration: exact tangency, both orders (2.9.1)");

var m91_pt = hvec4_new(0, 0, 0, 0);
var m91_pt2 = hvec4_new(0, 0, 0, 0);
var m91_off = hvec4_new(f64_from(3), f64_neg(f64_from(5)), f64_from(7), 0);
var m91_off2 = hvec4_new(f64_from(3), f64_neg(f64_from(5)), f64_from(7), 0);
var m91_bpt = _mpr_mkbox(0, 0, 0, 0, 0, 0);
var m91_bpt2 = _mpr_mkbox(0, 0, 0, 0, 0, 0);
var m91_unit = _mpr_mkbox(0, 0, 0, F64_ONE, F64_ONE, F64_ONE);
var m91_corner = _mpr_mkbox(F64_ONE, F64_ONE, F64_ONE, 0, 0, 0);
var m91_csph = hvec4_new(F64_ONE, F64_ONE, F64_ONE, 0);
var m91_flat = _mpr_mkbox(0, 0, 0, F64_ONE, F64_ONE, 0);

assert_eq(mpr_intersect(&_mpr_sup_sphere, m91_pt, &_mpr_sup_sphere, m91_pt2), 1,
  "coincident zero-radius spheres: mpr_intersect agrees with gjk (was 0)");
assert_eq(mpr_intersect(&_mpr_sup_sphere, m91_off, &_mpr_sup_sphere, m91_off2), 1,
  "coincident zero-radius spheres off the origin: mpr_intersect (was 0)");
assert_eq(mpr_intersect(&_mpr_sup_box, m91_bpt, &_mpr_sup_box, m91_bpt2), 1,
  "coincident point boxes: mpr_intersect agrees with gjk (was 0)");
assert_eq(mpr_intersect(&_mpr_sup_box, m91_unit, &_mpr_sup_box, m91_corner), 1,
  "point box on a unit box CORNER: mpr_intersect (was 0 in THIS order only)");
assert_eq(mpr_intersect(&_mpr_sup_box, m91_corner, &_mpr_sup_box, m91_unit), 1,
  "point box on a unit box CORNER: reversed order (was already 1 -- the asymmetry)");
assert_eq(mpr_intersect(&_mpr_sup_sphere, m91_csph, &_mpr_sup_box, m91_unit), 1,
  "zero-radius sphere on a unit box CORNER: mpr_intersect");
assert_eq(mpr_intersect(&_mpr_sup_box, m91_unit, &_mpr_sup_sphere, m91_csph), 1,
  "zero-radius sphere on a unit box CORNER: reversed order (was 0)");

# mpr_penetration had the same gap plus one case the intersect pair agreed on:
# two coplanar flat plates. A certified touch carries depth exactly 0.
var m91_n = alloc(8);
var m91_d = alloc(8);
store64(m91_d, F64_ONE);
assert_eq(mpr_penetration(&_mpr_sup_box, m91_flat, &_mpr_sup_box, m91_flat, m91_n, m91_d), 1,
  "coplanar flat plates: mpr_penetration reports the touch, like gjk_epa_3d (was 0)");
assert_eq(load64(m91_d), 0, "coplanar flat plates: mpr_penetration depth is exactly 0");
store64(m91_d, F64_ONE);
assert_eq(mpr_penetration(&_mpr_sup_box, m91_unit, &_mpr_sup_box, m91_corner, m91_n, m91_d), 1,
  "point box on a unit box CORNER: mpr_penetration (was 0)");
assert_eq(load64(m91_d), 0, "point box on a corner: mpr_penetration depth is exactly 0");
assert_eq(_ac_len_sq_e9(m91_n), 1000000000,
  "a certified mpr_penetration touch writes a UNIT normal, not the NULL HVec3");

# THE NEGATIVE CONTROLS. The repair must not manufacture a contact: one ulp out
# from the corner tangency is a real separation and must still read as one, and
# the 1e-165 pair above must not become a hit for mpr either.
var m91_out = _mpr_mkbox(0x3FF0000000000001, F64_ONE, F64_ONE, 0, 0, 0);
assert_eq(mpr_intersect(&_mpr_sup_box, m91_unit, &_mpr_sup_box, m91_out), 0,
  "corner point +1 ulp: mpr_intersect still says separated");
assert_eq(mpr_intersect(&_mpr_sup_box, m91_out, &_mpr_sup_box, m91_unit), 0,
  "corner point +1 ulp: separated in the reversed order too");
store64(m91_n, 0);
store64(m91_d, F64_ONE);
assert_eq(mpr_penetration(&_mpr_sup_box, m91_unit, &_mpr_sup_box, m91_out, m91_n, m91_d), 0,
  "corner point +1 ulp: mpr_penetration reports no contact");
# 2.9.1: and a 0 return leaves a READABLE placeholder, not the NULL HVec3
# alloc() hands back. gjk_epa_3d has done this since 2.8.3; this sibling did not,
# and the line below faults on the pre-2.9.1 body rather than merely failing.
assert_neq(load64(m91_n), 0, "mpr_penetration: a 0 return still writes a readable normal");
assert_eq(_ac_len_sq_e9(m91_n), 1000000000,
  "mpr_penetration: the 0-return placeholder normal is a unit vector");
assert_eq(load64(m91_d), 0, "mpr_penetration: a 0 return writes depth 0, not the caller's value");
assert_eq(mpr_intersect(&_mpr_sup_box, ep_z0, &_mpr_sup_box, ep_z1), 0,
  "zero-volume boxes 1e-165 apart: mpr_intersect says separated, like gjk");
# ... and one ulp IN is a real overlap, so the tangency is pinned from both sides.
var m91_in = _mpr_mkbox(0x3FEFFFFFFFFFFFFF, F64_ONE, F64_ONE, 0, 0, 0);
assert_eq(mpr_intersect(&_mpr_sup_box, m91_unit, &_mpr_sup_box, m91_in), 1,
  "corner point -1 ulp: mpr_intersect says overlapping");

# ================================================================
# 2.9.0: THE AGREEMENT SWEEP. Both entry points, both operand orders, over
# separated / tangent / overlapping / degenerate fixtures at three scales.
# ================================================================
# Every cls below is an EXACT classification, not a hisab output:
#   sphere/sphere  |c1-c0|^2 vs (r0+r1)^2         -- integer sixteenths, exact
#   box/box        per-axis |dc| vs h0+h1          -- exact
#   sphere/box     sum of max(0,|dc|-h)^2 vs r^2   -- exact
# and the tangency fixtures are built on Pythagorean triples (3,4,5) so that the
# touching configuration is exactly representable rather than nearly so.

_ag_scale = F64_ONE;

# --- sphere/sphere, walked through tangency at d = 2 = r0 + r1 ---
var ag_s_unit = _ag_sph(0, 0, 0, 16);
_ag_pair(&_mpr_sup_sphere, ag_s_unit, &_mpr_sup_sphere, _ag_sph(24, 0, 0, 16), 2);
_ag_pair(&_mpr_sup_sphere, ag_s_unit, &_mpr_sup_sphere, _ag_sph(31, 0, 0, 16), 2);
_ag_pair(&_mpr_sup_sphere, ag_s_unit, &_mpr_sup_sphere, _ag_sph(32, 0, 0, 16), 1);
_ag_pair(&_mpr_sup_sphere, ag_s_unit, &_mpr_sup_sphere, _ag_sph(33, 0, 0, 16), 0);
_ag_pair(&_mpr_sup_sphere, ag_s_unit, &_mpr_sup_sphere, _ag_sph(64, 0, 0, 16), 0);
# 3-4-5: centres exactly 5 apart, radii 2 + 3 -- off-axis tangency, exact.
var ag_s2 = _ag_sph(0, 0, 0, 32);
_ag_pair(&_mpr_sup_sphere, ag_s2, &_mpr_sup_sphere, _ag_sph(48, 64, 0, 48), 1);
_ag_pair(&_mpr_sup_sphere, ag_s2, &_mpr_sup_sphere, _ag_sph(48, 64, 0, 47), 0);
_ag_pair(&_mpr_sup_sphere, ag_s2, &_mpr_sup_sphere, _ag_sph(48, 64, 0, 49), 2);
# a POINT exactly on the surface, and a sixteenth either side of it
_ag_pair(&_mpr_sup_sphere, ag_s_unit, &_mpr_sup_sphere, _ag_sph(16, 0, 0, 0), 1);
_ag_pair(&_mpr_sup_sphere, ag_s_unit, &_mpr_sup_sphere, _ag_sph(17, 0, 0, 0), 0);
_ag_pair(&_mpr_sup_sphere, ag_s_unit, &_mpr_sup_sphere, _ag_sph(15, 0, 0, 0), 2);
# two points: coincident (a touch) and a sixteenth apart (not)
_ag_pair(&_mpr_sup_sphere, _ag_sph(0, 0, 0, 0), &_mpr_sup_sphere, _ag_sph(0, 0, 0, 0), 1);
_ag_pair(&_mpr_sup_sphere, _ag_sph(0, 0, 0, 0), &_mpr_sup_sphere, _ag_sph(1, 0, 0, 0), 0);
_ag_pair(&_mpr_sup_sphere, _ag_sph(8, 8, 8, 0), &_mpr_sup_sphere, _ag_sph(8, 8, 8, 0), 1);
# fully contained
_ag_pair(&_mpr_sup_sphere, ag_s_unit, &_mpr_sup_sphere, _ag_sph(0, 0, 0, 8), 2);

# --- box/box: face, edge and corner tangency, each with both neighbours ---
var ag_b_unit = _ag_box(0, 0, 0, 16, 16, 16);
_ag_pair(&_mpr_sup_box, ag_b_unit, &_mpr_sup_box, _ag_box(16, 0, 0, 16, 16, 16), 2);
_ag_pair(&_mpr_sup_box, ag_b_unit, &_mpr_sup_box, _ag_box(31, 0, 0, 16, 16, 16), 2);
_ag_pair(&_mpr_sup_box, ag_b_unit, &_mpr_sup_box, _ag_box(32, 0, 0, 16, 16, 16), 1);
_ag_pair(&_mpr_sup_box, ag_b_unit, &_mpr_sup_box, _ag_box(33, 0, 0, 16, 16, 16), 0);
_ag_pair(&_mpr_sup_box, ag_b_unit, &_mpr_sup_box, _ag_box(64, 0, 0, 16, 16, 16), 0);
_ag_pair(&_mpr_sup_box, ag_b_unit, &_mpr_sup_box, _ag_box(32, 32, 0, 16, 16, 16), 1);
_ag_pair(&_mpr_sup_box, ag_b_unit, &_mpr_sup_box, _ag_box(32, 32, 32, 16, 16, 16), 1);
# corner touch pulled apart on ONE axis is separated; pushed together on one
# axis is still a touch, because the other two axes still meet exactly.
_ag_pair(&_mpr_sup_box, ag_b_unit, &_mpr_sup_box, _ag_box(33, 32, 32, 16, 16, 16), 0);
_ag_pair(&_mpr_sup_box, ag_b_unit, &_mpr_sup_box, _ag_box(31, 32, 32, 16, 16, 16), 1);
# zero-volume: coplanar flat boxes, crossing segments, coincident points
_ag_pair(&_mpr_sup_box, _ag_box(0, 0, 0, 16, 16, 0), &_mpr_sup_box,
  _ag_box(8, 8, 0, 16, 16, 0), 1);
_ag_pair(&_mpr_sup_box, _ag_box(0, 0, 0, 16, 0, 0), &_mpr_sup_box,
  _ag_box(0, 0, 0, 0, 16, 0), 1);
_ag_pair(&_mpr_sup_box, _ag_box(0, 0, 0, 0, 0, 0), &_mpr_sup_box,
  _ag_box(0, 0, 0, 0, 0, 0), 1);
_ag_pair(&_mpr_sup_box, _ag_box(0, 0, 0, 0, 0, 0), &_mpr_sup_box,
  _ag_box(1, 0, 0, 0, 0, 0), 0);
# a point box exactly on a face, and a sixteenth either side
_ag_pair(&_mpr_sup_box, ag_b_unit, &_mpr_sup_box, _ag_box(16, 0, 0, 0, 0, 0), 1);
_ag_pair(&_mpr_sup_box, ag_b_unit, &_mpr_sup_box, _ag_box(17, 0, 0, 0, 0, 0), 0);
_ag_pair(&_mpr_sup_box, ag_b_unit, &_mpr_sup_box, _ag_box(15, 0, 0, 0, 0, 0), 2);
# anisotropic: the shape that made mpr_intersect report a false positive
_ag_pair(&_mpr_sup_box, _ag_box(0, 0, 0, 16, 160, 160), &_mpr_sup_box,
  _ag_box(112, 0, 0, 96, 16, 16), 1);
_ag_pair(&_mpr_sup_box, _ag_box(0, 0, 0, 16, 160, 160), &_mpr_sup_box,
  _ag_box(113, 0, 0, 96, 16, 16), 0);

# --- sphere/box ---
_ag_pair(&_mpr_sup_sphere, ag_s_unit, &_mpr_sup_box, _ag_box(31, 0, 0, 16, 16, 16), 2);
_ag_pair(&_mpr_sup_sphere, ag_s_unit, &_mpr_sup_box, _ag_box(32, 0, 0, 16, 16, 16), 1);
_ag_pair(&_mpr_sup_sphere, ag_s_unit, &_mpr_sup_box, _ag_box(33, 0, 0, 16, 16, 16), 0);
_ag_pair(&_mpr_sup_sphere, ag_s_unit, &_mpr_sup_box, _ag_box(0, 32, 0, 16, 16, 16), 1);
_ag_pair(&_mpr_sup_sphere, ag_s_unit, &_mpr_sup_box, _ag_box(0, 0, 32, 16, 16, 16), 1);
# zero-radius sphere exactly on a box CORNER, and a sixteenth either side
_ag_pair(&_mpr_sup_sphere, _ag_sph(16, 16, 16, 0), &_mpr_sup_box, ag_b_unit, 1);
_ag_pair(&_mpr_sup_sphere, _ag_sph(17, 16, 16, 0), &_mpr_sup_box, ag_b_unit, 0);
# A zero-radius sphere strictly INSIDE the box: a single-point intersection, but
# the MTV is the point's 1/16 distance to the nearest face, so it is class 2 and
# gjk_epa_3d is right to report a depth of 0.0625 for it.
_ag_pair(&_mpr_sup_sphere, _ag_sph(15, 15, 15, 0), &_mpr_sup_box, ag_b_unit, 2);
# 3-4-5 again: a point box exactly r away from the sphere centre
_ag_pair(&_mpr_sup_sphere, _ag_sph(0, 0, 0, 80), &_mpr_sup_box,
  _ag_box(48, 64, 0, 0, 0, 0), 1);
_ag_pair(&_mpr_sup_sphere, _ag_sph(0, 0, 0, 79), &_mpr_sup_box,
  _ag_box(48, 64, 0, 0, 0, 0), 0);
_ag_pair(&_mpr_sup_sphere, _ag_sph(0, 0, 0, 81), &_mpr_sup_box,
  _ag_box(48, 64, 0, 0, 0, 0), 2);
# sphere resting exactly on a zero-height box
_ag_pair(&_mpr_sup_sphere, _ag_sph(0, 0, 16, 16), &_mpr_sup_box,
  _ag_box(0, 0, 0, 16, 16, 0), 1);
_ag_pair(&_mpr_sup_sphere, _ag_sph(0, 0, 17, 16), &_mpr_sup_box,
  _ag_box(0, 0, 0, 16, 16, 0), 0);
_ag_pair(&_mpr_sup_sphere, _ag_sph(0, 0, 15, 16), &_mpr_sup_box,
  _ag_box(0, 0, 0, 16, 16, 0), 2);
# point vs point across the two shape kinds
_ag_pair(&_mpr_sup_sphere, _ag_sph(0, 0, 0, 0), &_mpr_sup_box,
  _ag_box(0, 0, 0, 0, 0, 0), 1);
_ag_pair(&_mpr_sup_sphere, _ag_sph(0, 0, 0, 0), &_mpr_sup_box,
  _ag_box(1, 0, 0, 0, 0, 0), 0);

# --- the same tangency at 2^-20 and 2^20 ---
# A uniform dyadic scaling cannot change any of the three classifications, so
# a fixture that changes answer under it has an ABSOLUTE epsilon somewhere in
# the stack. 2^-20 is where the pre-2.9.0 cheap test reported 66 genuine
# interior overlaps as misses, because the sphere support function's
# hvec3_normalize floor (1e-12) is absolute.
var ag_small = f64_div(F64_ONE, f64_from(1048576));
var ag_big = f64_from(1048576);
_ag_scale = ag_small;
_ag_pair(&_mpr_sup_sphere, hvec4_new(0, 0, 0, _ag_qs(16, ag_small)), &_mpr_sup_box,
  _mpr_mkbox(_ag_qs(32, ag_small), 0, 0, _ag_qs(16, ag_small), _ag_qs(16, ag_small),
    _ag_qs(16, ag_small)), 1);
_ag_pair(&_mpr_sup_sphere, hvec4_new(0, 0, 0, _ag_qs(16, ag_small)), &_mpr_sup_box,
  _mpr_mkbox(_ag_qs(31, ag_small), 0, 0, _ag_qs(16, ag_small), _ag_qs(16, ag_small),
    _ag_qs(16, ag_small)), 2);
_ag_pair(&_mpr_sup_sphere, hvec4_new(0, 0, 0, _ag_qs(16, ag_small)), &_mpr_sup_box,
  _mpr_mkbox(_ag_qs(33, ag_small), 0, 0, _ag_qs(16, ag_small), _ag_qs(16, ag_small),
    _ag_qs(16, ag_small)), 0);
_ag_scale = ag_big;
_ag_pair(&_mpr_sup_sphere, hvec4_new(0, 0, 0, _ag_qs(16, ag_big)), &_mpr_sup_box,
  _mpr_mkbox(_ag_qs(32, ag_big), 0, 0, _ag_qs(16, ag_big), _ag_qs(16, ag_big),
    _ag_qs(16, ag_big)), 1);
_ag_pair(&_mpr_sup_sphere, hvec4_new(0, 0, 0, _ag_qs(16, ag_big)), &_mpr_sup_box,
  _mpr_mkbox(_ag_qs(31, ag_big), 0, 0, _ag_qs(16, ag_big), _ag_qs(16, ag_big),
    _ag_qs(16, ag_big)), 2);
_ag_pair(&_mpr_sup_sphere, hvec4_new(0, 0, 0, _ag_qs(16, ag_big)), &_mpr_sup_box,
  _mpr_mkbox(_ag_qs(33, ag_big), 0, 0, _ag_qs(16, ag_big), _ag_qs(16, ag_big),
    _ag_qs(16, ag_big)), 0);

# --- the aggregate. These are the assertions that police the group's title. ---
assert_eq(_ag_pairs, 110, "agreement sweep: 55 fixtures x 2 operand orders were evaluated");
assert_eq(_ag_mismatch, 0,
  "agreement sweep: gjk_intersect_3d == gjk_epa_3d on EVERY swept pair (was 21 of 124)");
assert_eq(_ag_falsepos, 0,
  "agreement sweep: no exactly-separated pair is reported as a contact");
assert_eq(_ag_missov, 0,
  "agreement sweep: no pair with interior overlap is reported as a miss (was 66 at 2^-20)");
assert_eq(_ag_touch, 46, "agreement sweep: every exact tangency is certified, both orders");
assert_eq(_ag_baddepth, 0, "agreement sweep: a certified touch always carries depth exactly 0");
assert_eq(_ag_mprmis, 0,
  "agreement sweep: mpr_intersect == gjk_intersect_3d on EVERY swept pair (was 9 of 110)");
assert_eq(_ag_mprasym, 0,
  "agreement sweep: mpr_intersect is operand-order symmetric on every pair (was 2)");
assert_eq(_ag_mprpen, 0,
  "agreement sweep: mpr_penetration == gjk_epa_3d on EVERY swept pair (was 13 of 110)");

# === 3.3.4: GJK cycling on a rotated box ===
# A point at the centre of a near-cube rotated about z (half-extents 1.048, 0.949, 0.906)
# is 0.906 deep inside it. On the 3.3.4 base gjk_intersect_3d and gjk_epa_3d answered
# the MISS: the simplex revisited the same support points for all 64 iterations, an
# exit with no certificate, while mpr_intersect and mpr_penetration answered 1 with
# depth 0.906. 91 of 8,000 random rotated boxes with a point at the centre did this.
# [measured: cycling sweep with this support, 3.3.4 base and this tree, 2026-10-03; cycc 6.6.14]
test_group("gjk_intersect_3d / gjk_epa_3d: a point inside a rotated box is a contact (3.3.4)");
var _cyc_ca = 0xBFEFE1F10B3B1CEF;
var _cyc_sa = 0x3FB5E8FC3A92A2EC;
var _cyc_b = _mpr_mkobb(0, 0, 0, 0x3FF0C59829557784, 0x3FEE5C60AAB73F60, 0x3FED008AF29C48BA);
_mpr_obb_axis(_cyc_b, 0, _cyc_ca, _cyc_sa, 0);
_mpr_obb_axis(_cyc_b, 1, f64_neg(_cyc_sa), _cyc_ca, 0);
var _cyc_p = hvec4_new(0, 0, 0, 0);
var _cyc_n = alloc(8);
var _cyc_d = alloc(8);
assert_eq(gjk_intersect_3d(&_mpr_sup_sphere, _cyc_p, &_mpr_sup_obb, _cyc_b), 1,
  "gjk_intersect_3d: a point at the centre of a rotated box is a contact (3.3.4 base: 0)");
assert_eq(gjk_epa_3d(&_mpr_sup_sphere, _cyc_p, &_mpr_sup_obb, _cyc_b, _cyc_n, _cyc_d), 1,
  "gjk_epa_3d: ... a contact (3.3.4 base: 0)");
assert_eq(f64_approx_eq(load64(_cyc_d), 0x3FED008AF29C48BA, TOL_1EM14), 1,
  "gjk_epa_3d: ... at the depth of the least half-extent, 0.906, within 1e-14");
assert_eq(mpr_intersect(&_mpr_sup_sphere, _cyc_p, &_mpr_sup_obb, _cyc_b), 1,
  "mpr_intersect: ... a contact, as it was");
# The portal that answers there is not a proof by itself: near a tangency its sliver faces
# can enclose an origin that lies outside. This capsule and sphere are 1.0003e-12 apart
# (the capsule's side; exact arithmetic), GJK cycles on them with no certificate, and
# with the portal's 1 taken as it stood gjk_intersect_3d and gjk_epa_3d answered contact.
# They take it only past a depth of 1e-9 of the difference's span now. mpr_intersect and
# mpr_penetration answer contact here on the 3.3.4 base too: their own, not pinned.
# [measured: decimal gap; probe of 3.3.4 base, this tree, portal-alone form, 2026-10-03; cycc 6.6.14]
var _cyc_cap = _r5ga_mkcap(hvec3_new(0x400336FEADEEF7E8, 0x400699CF4C1A5170, 0xBFE1B324C7CBEE20),
  hvec3_new(0x3FFDCAC187A09804, 0xBFCF89C5792B1EC2, 0x3FF563225CD210EF), 0x3FD444A186FB7C79);
var _cyc_sph = hvec4_new(0x40087447E64D42F9, 0x4000BB14BB580FCE, 0xBFFA7878C9CD022C, 0x3FF28D6719DCBCEB);
assert_eq(gjk_intersect_3d(&_r5ga_sup_cap, _cyc_cap, &_mpr_sup_sphere, _cyc_sph), 0,
  "gjk_intersect_3d: a capsule and a sphere 1e-12 apart are not a contact (the portal alone: 1)");
assert_eq(gjk_epa_3d(&_r5ga_sup_cap, _cyc_cap, &_mpr_sup_sphere, _cyc_sph, _cyc_n, _cyc_d), 0,
  "gjk_epa_3d: ... not a contact either (the portal alone: 1, depth 6.6e-12)");

# === 3.3.3 G6: a NaN centre or extent is never a contact ===
# These four entry points answer 0 or 1 and have no error channel, so for a shape
# with a NaN coordinate the only answer that invents nothing is the documented
# miss: 0, with the placeholder out-params (unit_x, depth 0) every 0 return
# writes. That is what all four return on 3.3.2 for a NaN in a centre or a
# half-extent -- every support value NaN. ⚠ NOT for every NaN shape: a support
# that is NaN in some directions only was a contact to gjk_intersect_3d and
# mpr_intersect and a miss to gjk_epa_3d and mpr_penetration, on 3.3.2 and 3.3.3;
# the "3.3.3 R4ga" block below pins the two misses, and the "3.3.4" block after it
# the one contract all five follow since.
# [measured: V6 and R4ga probes on the 3.3.2 bundle and the 3.3.3 tree, 2026-10-01; cycc 6.6.12]
# The miss is why 3.3.3 left src/geo_advanced.cyr's nineteen NaN-true
# `f64_gt(x, 0) == 0` collision guards (3.3.2's count) alone while it rewrote
# geo.cyr's: its `_epa_unit` note records that rewriting six of them together as
# exact-zero tests turns these misses into an `mpr_intersect` CONTACT. The other
# three entry points do not move under that rewrite. What moves all four is the
# opposite slip in GJK's own line test: `_gjk_do_line`'s `f64_gt(dot, 0) == 1`
# respelled `f64_le(dot, 0) == 0` lets a NaN simplex past the line case, and every
# entry point below reports CONTACT.
# [measured: G6 mutation run on the 3.3.3 tree, not reproducible in-tree, 2026-10-01; cycc 6.6.12]
# The sphere's NaN sits in its centre (shape A); the box's in a half-extent of
# shape B, so both operand slots are covered.
var _g6_sn = hvec4_new(_g6_nan, 0, 0, F64_ONE);
var _g6_s1 = hvec4_new(F64_HALF, 0, 0, F64_ONE);
# The out-params start as sentinels, so a 0 return that skipped its placeholder
# writes cannot pass on whatever alloc() handed back.
var _g6_cn = alloc(8);
var _g6_cdp = alloc(8);
store64(_g6_cn, hvec3_new(F64_TWO, F64_TWO, F64_TWO));
store64(_g6_cdp, F64_TWO);
assert_eq(gjk_intersect_3d(&_mpr_sup_sphere, _g6_sn, &_mpr_sup_sphere, _g6_s1), 0,
  "gjk_intersect_3d: a NaN-centred sphere is not a contact");
assert_eq(gjk_epa_3d(&_mpr_sup_sphere, _g6_sn, &_mpr_sup_sphere, _g6_s1, _g6_cn, _g6_cdp), 0,
  "gjk_epa_3d: a NaN-centred sphere is not a contact");
assert_eq(HVec3_x(load64(_g6_cn)), 0x3FF0000000000000,
  "gjk_epa_3d: ... and its normal is the unit_x placeholder");
assert_eq(load64(_g6_cdp), 0, "gjk_epa_3d: ... and its depth is the +0 placeholder");
assert_eq(mpr_intersect(&_mpr_sup_sphere, _g6_sn, &_mpr_sup_sphere, _g6_s1), 0,
  "mpr_intersect: a NaN-centred sphere is not a contact");
store64(_g6_cn, hvec3_new(F64_TWO, F64_TWO, F64_TWO));
store64(_g6_cdp, F64_TWO);
assert_eq(mpr_penetration(&_mpr_sup_sphere, _g6_sn, &_mpr_sup_sphere, _g6_s1, _g6_cn, _g6_cdp), 0,
  "mpr_penetration: a NaN-centred sphere is not a contact");
assert_eq(HVec3_x(load64(_g6_cn)), 0x3FF0000000000000,
  "mpr_penetration: ... and its normal is the unit_x placeholder");
assert_eq(load64(_g6_cdp), 0, "mpr_penetration: ... and its depth is the +0 placeholder");
assert_eq(mpr_intersect(&_mpr_sup_box, _mpr_mkbox(0, 0, 0, F64_ONE, F64_ONE, F64_ONE),
    &_mpr_sup_box, _mpr_mkbox(F64_HALF, 0, 0, F64_ONE, _g6_nan, F64_ONE)), 0,
  "mpr_intersect: a box with a NaN half-extent in the SECOND slot is not a contact");

# === 3.3.3 R4ga: a support NaN in some directions only ===
# A unit sphere at the origin against a radius-1 sphere at (0.5, 0, 0) whose support
# is (0, NaN, 0) whenever dir.y > 0, in the SECOND slot. gjk_intersect_3d and
# mpr_intersect called it a contact through 3.3.3 (the disagreement the block above
# names); gjk_epa_3d and mpr_penetration answer the miss with their placeholders, on
# 3.3.2 and since. ⛔ Nothing pinned those two misses, and `_epa_tetra_ok`'s NaN-true `eref`
# guard is what holds them: respelled `f64_eq(eref, 0) == 1` it passed all five
# suites and turned both into a contact of depth 1.5 (gjk_epa_3d's normal (1, ~0, 0)).
# [measured: V6 mutant G1 on the 3.3.3 sources, re-run by R4ga on this tree, 2026-10-01; cycc 6.6.12]
test_group("gjk_epa_3d / mpr_penetration: a support NaN in some directions is a miss (3.3.3)");
fn _r4ga_sup_top_nan(shape, dir) {
    if (f64_gt(HVec3_y(dir), 0) == 1) { return hvec3_new(0, 0x7FF8000000000000, 0); }
    return _mpr_sup_sphere(shape, dir);
}
var _r4ga_s0 = hvec4_new(0, 0, 0, F64_ONE);
var _r4ga_pn = alloc(8);
var _r4ga_pd = alloc(8);
store64(_r4ga_pn, hvec3_new(F64_TWO, F64_TWO, F64_TWO));
store64(_r4ga_pd, F64_TWO);
assert_eq(gjk_epa_3d(&_mpr_sup_sphere, _r4ga_s0, &_r4ga_sup_top_nan, _g6_s1, _r4ga_pn, _r4ga_pd), 0,
  "gjk_epa_3d: a support NaN for dir.y > 0, second slot, is not a contact");
assert_eq(HVec3_x(load64(_r4ga_pn)), 0x3FF0000000000000, "gjk_epa_3d: ... normal x is the placeholder's 1");
assert_eq(HVec3_y(load64(_r4ga_pn)), 0, "gjk_epa_3d: ... normal y is the placeholder's +0");
assert_eq(load64(_r4ga_pd), 0, "gjk_epa_3d: ... depth is the +0 placeholder");
store64(_r4ga_pn, hvec3_new(F64_TWO, F64_TWO, F64_TWO));
store64(_r4ga_pd, F64_TWO);
assert_eq(mpr_penetration(&_mpr_sup_sphere, _r4ga_s0, &_r4ga_sup_top_nan, _g6_s1, _r4ga_pn, _r4ga_pd), 0,
  "mpr_penetration: a support NaN for dir.y > 0, second slot, is not a contact");
assert_eq(HVec3_x(load64(_r4ga_pn)), 0x3FF0000000000000, "mpr_penetration: ... normal x is the placeholder's 1");
assert_eq(HVec3_y(load64(_r4ga_pn)), 0, "mpr_penetration: ... normal y is the placeholder's +0");
assert_eq(load64(_r4ga_pd), 0, "mpr_penetration: ... depth is the +0 placeholder");

# === 3.3.4: one contract for a non-finite shape, in all five entry points ===
# Any support point with a NaN or infinite coordinate makes the pair the documented
# miss, and every contact first asks the four tetrahedral directions, one of which lies
# in any open half-space -- so a support NaN only for dir.y > 0 is found by all five.
# Every "3.3.4 base:" below is that tree's answer.
# [measured: non-finite survey, 488 pairs, 1,952 motions, 3.3.4 base and tree, 2026-10-03; cycc 6.6.14]
test_group("collision: a NaN or infinite shape is a miss in all five entry points (3.3.4)");
var _nf_n = alloc(8);
var _nf_d = alloc(8);
var _nf_t = alloc(8);
var _nf_sent = hvec3_new(F64_TWO, F64_TWO, F64_TWO);
# 1 when an out-param pair holds exactly the unit_x / +0 placeholder.
fn _nf_placeholder() {
    var n = load64(_nf_n);
    if (HVec3_x(n) != 0x3FF0000000000000 || HVec3_y(n) != 0 || HVec3_z(n) != 0) { return 0; }
    if (load64(_nf_d) != 0) { return 0; }
    return 1;
}
# All five on (sa, a) against (sb, b): 0 when every one answers the miss -- the
# placeholders from the two that write a normal, and nothing written by
# time_of_impact (B closing on A along -x at speed 1). Otherwise a bit per entry
# point that did not: 1 gjk_intersect_3d, 2 gjk_epa_3d, 4 mpr_intersect,
# 8 mpr_penetration, 16 time_of_impact.
fn _nf_all(sa, a, sb, b) {
    var bad = 0;
    if (gjk_intersect_3d(sa, a, sb, b) != 0) { bad = bad + 1; }
    store64(_nf_n, _nf_sent);
    store64(_nf_d, F64_TWO);
    if (gjk_epa_3d(sa, a, sb, b, _nf_n, _nf_d) != 0 || _nf_placeholder() == 0) { bad = bad + 2; }
    if (mpr_intersect(sa, a, sb, b) != 0) { bad = bad + 4; }
    store64(_nf_n, _nf_sent);
    store64(_nf_d, F64_TWO);
    if (mpr_penetration(sa, a, sb, b, _nf_n, _nf_d) != 0 || _nf_placeholder() == 0) { bad = bad + 8; }
    store64(_nf_t, F64_TWO);
    store64(_nf_n, _nf_sent);
    if (time_of_impact(sa, a, hvec3_zero(), sb, b, hvec3_new(f64_neg(F64_ONE), 0, 0), f64_from(10), _nf_t, _nf_n) != 0
      || load64(_nf_t) != F64_TWO || load64(_nf_n) != _nf_sent) { bad = bad + 16; }
    return bad;
}
var _nf_inf = 0x7FF0000000000000;
var _nf_slab = _mpr_mkbox(F64_HALF, 0, 0, _nf_inf, F64_ONE, F64_ONE);
var _nf_slab_far = _mpr_mkbox(F64_HALF, f64_from(10), 0, _nf_inf, F64_ONE, F64_ONE);
var _nf_ub = _mpr_mkbox(0, 0, 0, F64_ONE, F64_ONE, F64_ONE);
assert_eq(_nf_all(&_mpr_sup_box, _nf_slab, &_mpr_sup_box, _nf_ub), 0,
  "collision: a box of half-extent (+Inf, 1, 1) on a unit box, first slot (3.3.4 base: gjk, mpr, toi contacts)");
assert_eq(_nf_all(&_mpr_sup_box, _nf_ub, &_mpr_sup_box, _nf_slab), 0,
  "collision: ... second slot (3.3.4 base: all but mpr_penetration; gjk_epa_3d with the normal (0, 0, 0))");
assert_eq(_nf_all(&_mpr_sup_box, _nf_slab_far, &_mpr_sup_box, _nf_ub), 0,
  "collision: ... the same box 10 units away (3.3.4 base: gjk_intersect_3d, mpr_intersect, toi contacts)");
assert_eq(_nf_all(&_mpr_sup_sphere, _r4ga_s0, &_r4ga_sup_top_nan, _g6_s1), 0,
  "collision: a support NaN for dir.y > 0, second slot (3.3.4 base: gjk, mpr, toi contacts)");
fn _nf_sup_box_topnan(shape, dir) {
    var p = _mpr_sup_box(shape, dir);
    if (f64_gt(HVec3_y(dir), 0) == 1) { HVec3_set_x(p, 0x7FF8000000000000); }
    return p;
}
assert_eq(_nf_all(&_nf_sup_box_topnan, _mpr_mkbox(F64_HALF, 0, 0, F64_ONE, F64_ONE, F64_ONE), &_mpr_sup_sphere,
    _r4ga_s0), 0, "collision: a box whose support x is NaN for dir.y > 0 (3.3.4 base: a contact from all five)");
assert_eq(_nf_all(&_mpr_sup_sphere, _r4ga_s0, &_r4ga_sup_top_nan, hvec4_new(0x4025000000000000, 0, 0, F64_ONE)), 0,
  "collision: ... 10.5 away and closing: time_of_impact asks the four directions before its contact too");
assert_eq(_nf_all(&_r4ga_sup_top_nan, _g6_s1, &_mpr_sup_sphere, _r4ga_s0), 0,
  "collision: ... first slot (3.3.4 base: gjk_intersect_3d, mpr_intersect, toi contacts)");
# A support non-finite in z alone: _ga_finite3 reads all three coordinates.
fn _nf_sup_sph_zinf(shape, dir) {
    var p = _mpr_sup_sphere(shape, dir);
    if (f64_gt(HVec3_z(dir), 0) == 1) { HVec3_set_z(p, _nf_inf); }
    return p;
}
assert_eq(_nf_all(&_nf_sup_sph_zinf, _g6_s1, &_mpr_sup_sphere, _r4ga_s0), 0,
  "collision: a sphere whose support z is +Inf for dir.z > 0 (3.3.4 base: a contact from all five)");
# A capsule [centre, half-axis, radius, w] whose support y is NaN on the open half-space
# dir . w > 0, against a sphere. gjk_epa_3d's own search never meets the NaN here, and
# only its four-direction ask does. The same ask in mpr_intersect and mpr_penetration is
# defensive: removing it changed no answer over 3,600 such pairs and a 1,440-pair survey.
# [measured: half-space NaN sweep, 3,600 pairs, this tree with each ask removed, 2026-10-03; cycc 6.6.14]
fn _nf_sup_cap_half(shape, dir) {
    var p = _r5ga_sup_cap(shape, dir);
    var w = hvec3_new(load64(shape + 56), load64(shape + 64), load64(shape + 72));
    if (f64_gt(hvec3_dot(dir, w), 0) == 1) { HVec3_set_y(p, 0x7FF8000000000000); }
    return p;
}
var _nf_caph = alloc(80);
var _nf_capk = _r5ga_mkcap(hvec3_new(0x3FE3BE42616C9BA8, 0xBFD7E51FD81FACA4, 0xBFEEAB0A8A7A2F84),
  hvec3_new(0xBFC8C343A8BD4CC8, 0xBFE64759C485229E, 0x3FB71688E8CD9D50), 0x3FD9BA13EA822184);
for (var _nf_i = 0; _nf_i < 7; _nf_i = _nf_i + 1) { store64(_nf_caph + _nf_i * 8, load64(_nf_capk + _nf_i * 8)); }
store64(_nf_caph + 56, 0x3FE1D3B340F2C6ED);
store64(_nf_caph + 64, 0xBFA3F863A15B8C92);
store64(_nf_caph + 72, 0xBFEA8B8B15081319);
assert_eq(_nf_all(&_mpr_sup_sphere, hvec4_new(0, 0, 0, 0x3FF09BCCDB7D55D3), &_nf_sup_cap_half, _nf_caph), 0,
  "collision: a capsule whose support y is NaN on a half-space (3.3.4 base: a contact from all five)");
# The flag is cleared on ENTRY: a finite overlap asked right after a non-finite query is
# still a contact. Without its reset each of the four would answer 0 there.
assert_eq(gjk_intersect_3d(&_mpr_sup_box, _nf_slab, &_mpr_sup_box, _nf_ub), 0,
  "gjk_intersect_3d: the (+Inf, 1, 1) box is a miss");
assert_eq(gjk_intersect_3d(&_mpr_sup_sphere, _r4ga_s0, &_mpr_sup_sphere, _g6_s1), 1,
  "gjk_intersect_3d: ... and an overlap of two unit spheres asked next is a contact (no reset on entry: 0)");
assert_eq(gjk_epa_3d(&_mpr_sup_box, _nf_slab, &_mpr_sup_box, _nf_ub, _nf_n, _nf_d), 0,
  "gjk_epa_3d: the (+Inf, 1, 1) box is a miss");
assert_eq(gjk_epa_3d(&_mpr_sup_sphere, _r4ga_s0, &_mpr_sup_sphere, _g6_s1, _nf_n, _nf_d), 1,
  "gjk_epa_3d: ... and the overlap asked next is a contact (no reset on entry: 0)");
assert_eq(mpr_intersect(&_mpr_sup_box, _nf_slab, &_mpr_sup_box, _nf_ub), 0,
  "mpr_intersect: the (+Inf, 1, 1) box is a miss");
assert_eq(mpr_intersect(&_mpr_sup_sphere, _r4ga_s0, &_mpr_sup_sphere, _g6_s1), 1,
  "mpr_intersect: ... and the overlap asked next is a contact (no reset on entry: 0)");
assert_eq(mpr_penetration(&_mpr_sup_box, _nf_slab, &_mpr_sup_box, _nf_ub, _nf_n, _nf_d), 0,
  "mpr_penetration: the (+Inf, 1, 1) box is a miss");
assert_eq(mpr_penetration(&_mpr_sup_sphere, _r4ga_s0, &_mpr_sup_sphere, _g6_s1, _nf_n, _nf_d), 1,
  "mpr_penetration: ... and the overlap asked next is a contact (no reset on entry: 0)");

test_group("time_of_impact: a reported collision carries a readable normal");

# alloc() hands back zeroed pages, so when gjk_epa_3d returned without writing,
# time_of_impact copied 0 into out_normal and returned 1 -- "collision found,
# here is the normal", where the normal is a null pointer that faults on the
# first accessor. Two coplanar flat boxes overlapping at t = 0 reproduced it.
var toi_n2 = alloc(8);
var toi_t2 = alloc(8);
store64(toi_n2, 0);
var toi_zero = hvec3_zero();
assert_eq(time_of_impact(&_mpr_sup_box, ep_fa, toi_zero, &_mpr_sup_box, ep_fb, toi_zero,
    f64_from(10), toi_t2, toi_n2), 1, "coplanar flat boxes overlap at t = 0 -> hit");
assert_neq(load64(toi_n2), 0, "t = 0 hit stores a real normal, not a NULL HVec3");
assert_eq(_ac_len_sq_e9(toi_n2), 1000000000, "t = 0 hit stores a unit normal");

# 2.9.0: time_of_impact's t = 0 overlap test IS gjk_intersect_3d, so the
# tangency repair reaches it. Two shapes exactly touching at t = 0 are in
# contact at t = 0, and now report so even with no relative motion at all --
# before, the cheap test said "apart" and the zero-speed early out returned 0.
store64(toi_n2, 0);
store64(toi_t2, F64_ONE);
assert_eq(time_of_impact(&_mpr_sup_sphere, ep_sph, toi_zero, &_mpr_sup_box, ep_box, toi_zero,
    f64_from(10), toi_t2, toi_n2), 1, "tangent pair at rest: contact at t = 0 (was 0)");
assert_eq(load64(toi_t2), 0, "tangent pair at rest: t is exactly 0");
assert_eq(_ac_len_sq_e9(toi_n2), 1000000000, "tangent pair at rest: normal is a unit vector");

# The swept branch stores its normal through the same guard.
store64(toi_n2, 0);
var toi_left2 = hvec3_new(f64_neg(F64_ONE), 0, 0);
var toi_fc = _mpr_mkbox(f64_from(5), 0, 0, F64_ONE, F64_ONE, 0);
assert_eq(time_of_impact(&_mpr_sup_box, ep_fa, toi_zero, &_mpr_sup_box, toi_fc, toi_left2,
    f64_from(10), toi_t2, toi_n2), 1, "swept coplanar flat boxes collide within max_t");
assert_neq(load64(toi_n2), 0, "swept hit stores a real normal, not a NULL HVec3");
assert_eq(_ac_len_sq_e9(toi_n2), 1000000000, "swept hit stores a unit normal");

# === 3.3.3 R3a: time_of_impact's normal points from A to B, and is measured ===
# ⛔ 3.3.3 — "a unit normal" was all the group above could say, and it was all that
# was true. On a swept impact the loop's last advance lands on the touch (or, being
# floored at the contact tolerance, inside it), the distance query reads v = 0 there,
# and out_normal was the unit_x placeholder: unit spheres 9.5 apart closing at speed
# 1 gave (+1, 0, 0) from +x, from -x and from +y alike. A gap left inside the
# tolerance gave -v/|v|, which is B -> A where gjk_epa_3d's overlap normal is A -> B,
# and at a rounding-level gap is noise in any direction; gjk_epa_3d's exact-touch
# certificate, forwarded on the overlap path, was the inward normal. Every value
# quoted "3.3.2:" below is what the 3.3.2 bundle returned for that input.
# [measured: R3a probes on the 3.3.2 bundle, 2026-10-01; cycc 6.6.12]
# ⭐ One convention now: the outward normal of A (-) B at the contact, pointing from
# A towards B. A zero's sign is incidental in every f64_eq(c, 0) below.
test_group("time_of_impact: the normal points from A to B, on every path (3.3.3)");
var _r3a_a = hvec4_new(0, 0, 0, F64_ONE);
var _r3a_t = alloc(8);
var _r3a_n = alloc(8);
var _r3a_worst = 0;
fn _r3a_toi(sa, a, sb, b, vb) {
    store64(_r3a_t, F64_TWO);
    store64(_r3a_n, 0);
    return time_of_impact(sa, a, hvec3_zero(), sb, b, vb, f64_from(1000), _r3a_t, _r3a_n);
}
fn _r3a_nx() { return HVec3_x(load64(_r3a_n)); }
fn _r3a_ny() { return HVec3_y(load64(_r3a_n)); }
fn _r3a_nz() { return HVec3_z(load64(_r3a_n)); }
# 1 unless the stored normal is on the same side as the unit reference r and within
# `tol` of it (|n x r|). NaN fails both tests. Tracks the worst |n x r| seen.
fn _r3a_bad(r, tol) {
    var n = load64(_r3a_n);
    var e = hvec3_length(hvec3_cross(n, r));
    if (f64_gt(e, _r3a_worst) == 1) { _r3a_worst = e; }
    if (f64_gt(hvec3_dot(n, r), 0) == 0) { return 1; }
    if (f64_le(e, tol) == 0) { return 1; }
    return 0;
}

# Swept impacts, the repro: the loop advances, then measures along its last direction.
var _r3a_far = 0x4023000000000000;   # 9.5
var _r3a_m1 = f64_neg(F64_ONE);
assert_eq(_r3a_toi(&_mpr_sup_sphere, _r3a_a, &_mpr_sup_sphere, hvec4_new(_r3a_far, 0, 0, F64_ONE),
    hvec3_new(_r3a_m1, 0, 0)), 1, "time_of_impact: B from +x hits");
assert_eq(_r3a_nx(), 0x3FF0000000000000, "time_of_impact: B from +x -> n.x = +1 exactly");
assert_eq(f64_eq(_r3a_ny(), 0) + f64_eq(_r3a_nz(), 0), 2, "time_of_impact: ... n.y = n.z = 0");
assert_eq(_r3a_toi(&_mpr_sup_sphere, _r3a_a, &_mpr_sup_sphere, hvec4_new(f64_neg(_r3a_far), 0, 0, F64_ONE),
    hvec3_new(F64_ONE, 0, 0)), 1, "time_of_impact: B from -x hits");
assert_eq(_r3a_nx(), 0xBFF0000000000000, "time_of_impact: B from -x -> n.x = -1 exactly (3.3.2: +1)");
assert_eq(f64_eq(_r3a_ny(), 0) + f64_eq(_r3a_nz(), 0), 2, "time_of_impact: ... n.y = n.z = 0");
assert_eq(_r3a_toi(&_mpr_sup_sphere, _r3a_a, &_mpr_sup_sphere, hvec4_new(0, _r3a_far, 0, F64_ONE),
    hvec3_new(0, _r3a_m1, 0)), 1, "time_of_impact: B from +y hits");
assert_eq(_r3a_ny(), 0x3FF0000000000000, "time_of_impact: B from +y -> n.y = +1 exactly (3.3.2: n = +x)");
assert_eq(f64_eq(_r3a_nx(), 0) + f64_eq(_r3a_nz(), 0), 2, "time_of_impact: ... n.x = n.z = 0");
assert_eq(load64(_r3a_t), 0x401E000000000000, "time_of_impact: ... and the impact time is still 7.5");

# Contact at t = 0 inside the tolerance (gap 2^-40): no advance, so the measuring
# direction comes from A (-) B's own midpoint.
var _r3a_near = f64_add(F64_TWO, 0x3D70000000000000);
assert_eq(_r3a_toi(&_mpr_sup_sphere, _r3a_a, &_mpr_sup_sphere, hvec4_new(_r3a_near, 0, 0, F64_ONE),
    hvec3_new(_r3a_m1, 0, 0)), 1, "time_of_impact: gap 2^-40 on +x is a contact");
assert_eq(load64(_r3a_t), 0, "time_of_impact: ... at t = +0");
assert_eq(_r3a_nx(), 0x3FF0000000000000, "time_of_impact: ... n.x = +1 exactly (3.3.2: -1, B -> A)");
assert_eq(_r3a_toi(&_mpr_sup_sphere, _r3a_a, &_mpr_sup_sphere, hvec4_new(f64_neg(_r3a_near), 0, 0, F64_ONE),
    hvec3_new(F64_ONE, 0, 0)), 1, "time_of_impact: gap 2^-40 on -x is a contact");
assert_eq(_r3a_nx(), 0xBFF0000000000000, "time_of_impact: ... n.x = -1 exactly (3.3.2: +1)");

# Contacts at t = 0 within a few ulp of tangency along d = (1, 2, 3)/|.|, closing
# head-on. gjk_intersect_3d calls each pair apart, so the loop reports the contact.
# At 2d exactly the distance query read "inside" (3.3.2: the placeholder +x); two
# ulp further out it left a gap and -v/|v| was exactly -d; three ulp in it was
# (-0.447, -0.894, 0), on the wrong side of the tangent plane.
var _r3a_d = hvec3_normalize(hvec3_new(F64_ONE, F64_TWO, f64_from(3)));
fn _r3a_tan(k) {
    var c = hvec3_scale(_r3a_d, F64_TWO + k);
    return _r3a_toi(&_mpr_sup_sphere, _r3a_a, &_mpr_sup_sphere,
      hvec4_new(HVec3_x(c), HVec3_y(c), HVec3_z(c), F64_ONE), hvec3_neg(_r3a_d));
}
assert_eq(_r3a_tan(0), 1, "time_of_impact: tangent at 2d is a contact");
assert_eq(load64(_r3a_t), 0, "time_of_impact: ... at t = +0");
assert_eq(_r3a_nx(), HVec3_x(_r3a_d), "time_of_impact: ... n = d exactly, x (3.3.2: +x placeholder)");
assert_eq(_r3a_ny(), HVec3_y(_r3a_d), "time_of_impact: ... n = d exactly, y");
assert_eq(_r3a_nz(), HVec3_z(_r3a_d), "time_of_impact: ... n = d exactly, z");
assert_eq(_r3a_tan(2), 1, "time_of_impact: 2d + 2 ulp is a contact");
assert_eq(_r3a_nx(), HVec3_x(_r3a_d), "time_of_impact: ... n = d exactly, x (3.3.2: -d)");
assert_eq(_r3a_ny(), HVec3_y(_r3a_d), "time_of_impact: ... n = d exactly, y");
assert_eq(_r3a_nz(), HVec3_z(_r3a_d), "time_of_impact: ... n = d exactly, z");
# Measured 1.61e-8 from d, against 1e-7; the capsule below 1.00e-5, against 1e-4.
# [measured: R3a probe on the 3.3.3 tree, 2026-10-01; cycc 6.6.12]
# Since R5ga the 2d - 3 ulp contact's own reading is refined by two probes along it:
# 6.91e-9 from d. The capsule takes the probe chain as before, 1.00e-5.
# [measured: R5ga probe on this tree, 2026-10-01; cycc 6.6.12]
assert_eq(_r3a_tan(0 - 3), 1, "time_of_impact: 2d - 3 ulp is a contact");
assert_eq(_r3a_bad(_r3a_d, 0x3E7AD7F29ABCAF48), 0,
  "time_of_impact: ... n within 1e-7 of d (3.3.2: (-0.447, -0.894, 0))");

# The overlap path: gjk_epa_3d's exact-touch certificate was the INWARD normal.
# gjk_epa_3d turns it outward itself now and this path forwards it (the "3.3.3
# R4ga" touch block below pins gjk_epa_3d and mpr_penetration directly).
# A box at the origin and a point resting on its (1, 1, 1) corner.
assert_eq(_r3a_toi(&_mpr_sup_box, _mpr_mkbox(0, 0, 0, F64_ONE, F64_ONE, F64_ONE), &_mpr_sup_box,
    _mpr_mkbox(F64_ONE, F64_ONE, F64_ONE, 0, 0, 0), hvec3_zero()), 1,
  "time_of_impact: a point on a box corner, at rest, is a contact");
assert_eq(_r3a_ny(), 0x3FF0000000000000, "time_of_impact: ... n.y = +1 exactly (3.3.2: -1)");
assert_eq(f64_eq(_r3a_nx(), 0) + f64_eq(_r3a_nz(), 0), 2, "time_of_impact: ... n.x = n.z = 0");
# A penetration normal is already outward, and keeps its sign: B overlapping A from
# +x. gjk_epa_3d's own answer, 2.4e-9 off +x, against 1e-7.
# [measured: R3a probe on the 3.3.2 bundle and the 3.3.3 tree, 2026-10-01; cycc 6.6.12]
assert_eq(_r3a_toi(&_mpr_sup_sphere, _r3a_a, &_mpr_sup_sphere, hvec4_new(0x3FF8000000000000, 0, 0, F64_ONE),
    hvec3_new(_r3a_m1, 0, 0)), 1, "time_of_impact: B overlapping A from +x at t = 0 is a contact");
assert_eq(_r3a_bad(hvec3_unit_x(), 0x3E7AD7F29ABCAF48), 0, "time_of_impact: ... n within 1e-7 of +x, A -> B");

# Two point shapes head-on: A (-) B is a single point, the one shape whose midpoint
# IS the origin at contact; the loop's own last direction gives the normal.
var _r3a_pt = hvec4_new(0, 0, 0, 0);
assert_eq(_r3a_toi(&_mpr_sup_sphere, _r3a_pt, &_mpr_sup_sphere, hvec4_new(f64_from(0 - 5), 0, 0, 0),
    hvec3_new(F64_ONE, 0, 0)), 1, "time_of_impact: two points meet");
assert_eq(load64(_r3a_t), 0x4014000000000000, "time_of_impact: ... at t = 5 exactly");
assert_eq(_r3a_nx(), 0xBFF0000000000000, "time_of_impact: ... n.x = -1 exactly (3.3.2: +1)");

# The distance query can read a pair that is already in contact as apart along a
# direction unrelated to the normal (a capsule's side, where its support has only
# the two end points). The loop then advanced along that direction, and measuring
# along it finds no separation: the normal is taken from the midpoint instead.
# Capsule A along x (half-length 2, radius 0.5), unit sphere B.
fn _r3a_sup_capsule(shape, dir) {
    var ex = load64(shape);
    if (f64_lt(HVec3_x(dir), 0) == 1) { ex = f64_neg(ex); }
    return hvec3_add(hvec3_new(ex, 0, 0), hvec3_scale(hvec3_normalize(dir), load64(shape + 8)));
}
var _r3a_cap = alloc(16);
store64(_r3a_cap, F64_TWO);
store64(_r3a_cap + 8, F64_HALF);
var _r3a_cb = hvec3_new(0x3FF4059ED986747D, 0x3FF7DFD71A98EFC5, 0xC020F91FB28180FF);
var _r3a_cv = hvec3_new(0xBFC869791260825F, 0xBFCAE73E8450B00B, 0x3FF4A63C67024CC9);
assert_eq(_r3a_toi(&_r3a_sup_capsule, _r3a_cap, &_mpr_sup_sphere,
    hvec4_new(HVec3_x(_r3a_cb), HVec3_y(_r3a_cb), HVec3_z(_r3a_cb), F64_ONE), _r3a_cv), 1,
  "time_of_impact: sphere onto a capsule's side hits");
var _r3a_cc = hvec3_add(_r3a_cb, hvec3_scale(_r3a_cv, load64(_r3a_t)));
assert_eq(_r3a_bad(hvec3_normalize(hvec3_new(0, HVec3_y(_r3a_cc), HVec3_z(_r3a_cc))), 0x3F1A36E2EB1C432D), 0,
  "time_of_impact: ... n within 1e-4 of the capsule's side normal (3.3.2: the +x placeholder)");

# Box A (half-extents 1.5, 1, 0.75), unit sphere B, onto the edge where a box face
# meets a rounded one. Swept: the contact leaves a gap, and the contact's own reading
# (3.3.2's, turned) is 9.75e-3 from the edge normal; two probe readings along it
# replace it at 4.33e-6. At t = 0, a few ulp from the y = -1, z = 0.75 edge, the
# contact's own reading is 2.46e-5 off, the readings along it are worse, and the
# probe chain from the midpoint replaces it: the first midpoint measurement is
# 9.82e-4 off, the second, along it, 5.57e-7.
# [measured: R3a probe on the 3.3.3 tree; R5ga probes on the 3.3.2 bundle and this tree, 2026-10-01; cycc 6.6.12]
var _r3a_ebox = _mpr_mkbox(0, 0, 0, 0x3FF8000000000000, F64_ONE, 0x3FE8000000000000);
var _r3a_sb = hvec3_new(0x4008AA6ABCF07E0F, 0xC0145EBE7CE60090, 0x401A519B050304D2);
var _r3a_sv = hvec3_new(0xBFD2D0CBA80E2240, 0x3FF32929FF051D45, 0xBFF62B82F7CD92FE);
assert_eq(_r3a_toi(&_mpr_sup_box, _r3a_ebox, &_mpr_sup_sphere,
    hvec4_new(HVec3_x(_r3a_sb), HVec3_y(_r3a_sb), HVec3_z(_r3a_sb), F64_ONE), _r3a_sv), 1,
  "time_of_impact: sphere onto the x = 1.5, z = 0.75 box edge hits");
var _r3a_sc = hvec3_add(_r3a_sb, hvec3_scale(_r3a_sv, load64(_r3a_t)));
assert_eq(_r3a_bad(hvec3_normalize(hvec3_new(f64_sub(HVec3_x(_r3a_sc), 0x3FF8000000000000), 0,
        f64_sub(HVec3_z(_r3a_sc), 0x3FE8000000000000))), 0x3EE4F8B588E368F1), 0,
  "time_of_impact: ... n within 1e-5 of the edge normal");
var _r3a_tb = hvec3_new(0xBFECC6C4B5E2D698, 0xBFF9C1FE20696B00, 0x3FF8AE1CE2FC1627);
assert_eq(_r3a_toi(&_mpr_sup_box, _r3a_ebox, &_mpr_sup_sphere,
    hvec4_new(HVec3_x(_r3a_tb), HVec3_y(_r3a_tb), HVec3_z(_r3a_tb), F64_ONE),
    hvec3_new(0x3FB5E2BB67DA62FD, 0x3FE55D1D3A7FA55B, 0xBFE9D0AE04477A33)), 1,
  "time_of_impact: sphere on the y = -1, z = 0.75 box edge at t = 0 is a contact");
assert_eq(_r3a_bad(hvec3_normalize(hvec3_new(0, f64_add(HVec3_y(_r3a_tb), F64_ONE),
        f64_sub(HVec3_z(_r3a_tb), 0x3FE8000000000000))), 0x3EE4F8B588E368F1), 0,
  "time_of_impact: ... n within 1e-5 of the edge normal");

# Same box, unit sphere B within a few ulp of the box's x = -1.5, z = -0.75 edge, at
# t = 0. No probe from the midpoint measures a separation here, and R3a answered with
# the midpoint direction itself, 0.360 rad from the edge normal. The contact leaves a
# gap, though, and its own reading (3.3.2's (0.855, -0.477, 0.206), turned) is 0.497
# rad off on the right side; two probe readings along it agree to 1.7e-6 and replace
# it at 1.95e-6 from the closed-form edge normal (the sphere centre minus its closest
# point on the edge).
# [measured: R5ga probes on the 3.3.2 bundle, the 3.3.3 base and this tree, 2026-10-01; cycc 6.6.12]
var _r3a_eb = hvec3_new(0xC003C7464ED0E3BA, 0xBFED5DADE5F4BCC3, 0xBFEF7AB2B881C324);
assert_eq(_r3a_toi(&_mpr_sup_box, _r3a_ebox,
    &_mpr_sup_sphere, hvec4_new(HVec3_x(_r3a_eb), HVec3_y(_r3a_eb), HVec3_z(_r3a_eb), F64_ONE),
    hvec3_new(0x400662A86B1EC581, 0x3FC50893C271FC25, 0x3FEA6608376D11C6)), 1,
  "time_of_impact: sphere on a box edge at t = 0 is a contact");
assert_eq(_r3a_bad(hvec3_normalize(hvec3_new(f64_add(HVec3_x(_r3a_eb), 0x3FF8000000000000), 0,
        f64_add(HVec3_z(_r3a_eb), 0x3FE8000000000000))), F64_HALF), 0,
  "time_of_impact: ... n on the edge normal's side (3.3.2: (0.855, -0.477, 0.206), the other side)");
assert_eq(_r3a_bad(hvec3_normalize(hvec3_new(f64_add(HVec3_x(_r3a_eb), 0x3FF8000000000000), 0,
        f64_add(HVec3_z(_r3a_eb), 0x3FE8000000000000))), 0x3EE4F8B588E368F1), 0,
  "time_of_impact: ... and n is within 1e-5 of the edge normal (3.3.3 base: the midpoint direction, 0.360 rad)");

# Three sweeps, each tolerance set from the worst |n x reference| on its own sample
# sequence: swept spheres 4.07e-8 and near-tangent spheres 2.51e-8 against 1e-6,
# face-contact boxes 1.40e-10 against 1e-8. With time_of_impact as 3.3.2 shipped it,
# 96, 87 and 96 of the 96 normals fail them.
# [measured: these sequences on the 3.3.3 tree, and with its geo_advanced.cyr reverted, 2026-10-01; cycc 6.6.12]
# ⚠ Since R5ga a contact that leaves a gap keeps its own reading where that reading's
# supporting plane separates the pair, and the worst are now 9.39e-7, 5.08e-8 and
# 6.26e-11. The swept-sphere one is 3.3.2's own reading, kept, 6% inside the 1e-6;
# R3a's probe gave 1.12e-8 there, but taking probe readings over a reading that
# certifies itself made 24 contacts in R5ga's sweeps worse than 3.3.2.
# [measured: these sequences and R5ga's sweeps on this tree and its no-trust mutant, 2026-10-01; cycc 6.6.12]
# A sweep of approach directions against the line of centres at the reported time,
# with impact parameters up to 1.9 of the 2 that still touches.
var _r3a_bad_n = 0;
var _r3a_hits = 0;
_r3a_worst = 0;
_DLR_STATE = 0x2026_1001_0000_00A1;
for (var _r3a_i = 0; _r3a_i < 96; _r3a_i = _r3a_i + 1) {
    var _r3a_q = hvec3_new(_toi_frac(0 - 1000, 1000, 1000), _toi_frac(0 - 1000, 1000, 1000),
      _toi_frac(0 - 1000, 1000, 1000));
    var _r3a_u = hvec3_normalize(hvec3_add(_r3a_q, hvec3_new(0x3F50624DD2F1A9FC, 0, 0)));
    var _r3a_p = hvec3_new(_toi_frac(0 - 1000, 1000, 1000), _toi_frac(0 - 1000, 1000, 1000),
      _toi_frac(0 - 1000, 1000, 1000));
    _r3a_p = hvec3_normalize(hvec3_sub(_r3a_p, hvec3_scale(_r3a_u, hvec3_dot(_r3a_p, _r3a_u))));
    var _r3a_c0 = hvec3_scale(_r3a_u, _toi_frac(6000, 12000, 1000));
    var _r3a_aim = hvec3_add(hvec3_neg(_r3a_c0), hvec3_scale(_r3a_p, _toi_frac(0, 1900, 1000)));
    var _r3a_v = hvec3_scale(hvec3_normalize(_r3a_aim), _toi_frac(500, 4000, 1000));
    _r3a_hits = _r3a_hits + _r3a_toi(&_mpr_sup_sphere, _r3a_a, &_mpr_sup_sphere,
      hvec4_new(HVec3_x(_r3a_c0), HVec3_y(_r3a_c0), HVec3_z(_r3a_c0), F64_ONE), _r3a_v);
    _r3a_bad_n = _r3a_bad_n + _r3a_bad(hvec3_normalize(hvec3_add(_r3a_c0,
          hvec3_scale(_r3a_v, load64(_r3a_t)))), 0x3EB0C6F7A0B5ED8D);
}
assert_eq(_r3a_hits, 96, "time_of_impact: all 96 swept sphere pairs hit");
assert_eq(_r3a_bad_n, 0, "time_of_impact: every swept sphere normal is within 1e-6 of the line of centres");

# Unit boxes: the face whose slab B enters last is the contact face; its axis, signed
# towards B, is the normal. Pairs whose last two slab entries are within 1e-3 in t
# (an edge or corner contact, normal not unique) are skipped and counted.
var _r3a_box_a = _mpr_mkbox(0, 0, 0, F64_ONE, F64_ONE, F64_ONE);
var _r3a_skip = 0;
_r3a_bad_n = 0;
_r3a_hits = 0;
_r3a_worst = 0;
_DLR_STATE = 0x2026_1001_0000_00A2;
for (var _r3a_j = 0; _r3a_j < 96; _r3a_j = _r3a_j + 1) {
    var _r3a_bq = hvec3_new(_toi_frac(0 - 1000, 1000, 1000), _toi_frac(0 - 1000, 1000, 1000),
      _toi_frac(0 - 1000, 1000, 1000));
    var _r3a_bc = hvec3_scale(hvec3_normalize(hvec3_add(_r3a_bq, hvec3_new(0x3F50624DD2F1A9FC, 0, 0))),
      _toi_frac(5000, 10000, 1000));
    var _r3a_bt = hvec3_new(_toi_frac(0 - 1500, 1500, 1000), _toi_frac(0 - 1500, 1500, 1000),
      _toi_frac(0 - 1500, 1500, 1000));
    var _r3a_bv = hvec3_scale(hvec3_normalize(hvec3_sub(_r3a_bt, _r3a_bc)), _toi_frac(1000, 3000, 1000));
    _r3a_hits = _r3a_hits + _r3a_toi(&_mpr_sup_box, _r3a_box_a, &_mpr_sup_box,
      _mpr_mkbox(HVec3_x(_r3a_bc), HVec3_y(_r3a_bc), HVec3_z(_r3a_bc), F64_ONE, F64_ONE, F64_ONE), _r3a_bv);
    var _r3a_best = _GA_F64_NEG_INF;
    var _r3a_next = _GA_F64_NEG_INF;
    var _r3a_ref = 0;
    for (var _r3a_ax = 0; _r3a_ax < 3; _r3a_ax = _r3a_ax + 1) {
        var _r3a_ci = HVec3_x(_r3a_bc);
        var _r3a_vi = HVec3_x(_r3a_bv);
        var _r3a_e = hvec3_unit_x();
        if (_r3a_ax == 1) { _r3a_ci = HVec3_y(_r3a_bc); _r3a_vi = HVec3_y(_r3a_bv); _r3a_e = hvec3_unit_y(); }
        if (_r3a_ax == 2) { _r3a_ci = HVec3_z(_r3a_bc); _r3a_vi = HVec3_z(_r3a_bv); _r3a_e = hvec3_unit_z(); }
        # Slab entry time on this axis: -Inf when already inside it (|c| <= 2).
        var _r3a_te = _GA_F64_NEG_INF;
        if (f64_gt(f64_abs(_r3a_ci), F64_TWO) == 1) {
            var _r3a_side = F64_TWO;
            if (f64_lt(_r3a_ci, 0) == 1) { _r3a_side = f64_neg(F64_TWO); _r3a_e = hvec3_neg(_r3a_e); }
            _r3a_te = f64_div(f64_sub(_r3a_side, _r3a_ci), _r3a_vi);
        }
        if (f64_gt(_r3a_te, _r3a_best) == 1) {
            _r3a_next = _r3a_best;
            _r3a_best = _r3a_te;
            _r3a_ref = _r3a_e;
        } elif (f64_gt(_r3a_te, _r3a_next) == 1) {
            _r3a_next = _r3a_te;
        }
    }
    if (f64_lt(f64_sub(_r3a_best, _r3a_next), 0x3F50624DD2F1A9FC) == 1) {
        _r3a_skip = _r3a_skip + 1;
    } else {
        _r3a_bad_n = _r3a_bad_n + _r3a_bad(_r3a_ref, 0x3E45798EE2308C3A);
    }
}
assert_eq(_r3a_hits, 96, "time_of_impact: all 96 swept box pairs hit");
assert_lt(_r3a_skip, 8, "time_of_impact: at most a few box pairs are edge or corner contacts");
assert_eq(_r3a_bad_n, 0, "time_of_impact: every face-contact box normal is within 1e-8 of the face axis");

# Contacts at t = 0 within 32 ulp of tangency, from random directions, closing
# head-on or obliquely: the loop's t = 0 paths, inside and inside the tolerance.
_r3a_bad_n = 0;
_r3a_hits = 0;
_r3a_worst = 0;
_DLR_STATE = 0x2026_1001_0000_00A3;
for (var _r3a_k = 0; _r3a_k < 96; _r3a_k = _r3a_k + 1) {
    var _r3a_tq = hvec3_new(_toi_frac(0 - 1000, 1000, 1000), _toi_frac(0 - 1000, 1000, 1000),
      _toi_frac(0 - 1000, 1000, 1000));
    var _r3a_td = hvec3_normalize(hvec3_add(_r3a_tq, hvec3_new(0x3F50624DD2F1A9FC, 0, 0)));
    var _r3a_tc = hvec3_scale(_r3a_td, F64_TWO + ((_dlr_next() & 63) - 32));
    var _r3a_tv = hvec3_neg(_r3a_td);
    if ((_r3a_k & 1) == 1) {
        _r3a_tv = hvec3_new(_toi_frac(0 - 1000, 1000, 1000), _toi_frac(0 - 1000, 1000, 1000),
          _toi_frac(0 - 1000, 1000, 1000));
        if (f64_gt(hvec3_dot(_r3a_tv, _r3a_td), 0) == 1) { _r3a_tv = hvec3_neg(_r3a_tv); }
    }
    _r3a_hits = _r3a_hits + _r3a_toi(&_mpr_sup_sphere, _r3a_a, &_mpr_sup_sphere,
      hvec4_new(HVec3_x(_r3a_tc), HVec3_y(_r3a_tc), HVec3_z(_r3a_tc), F64_ONE), _r3a_tv);
    _r3a_bad_n = _r3a_bad_n + _r3a_bad(_r3a_td, 0x3EB0C6F7A0B5ED8D);
}
assert_eq(_r3a_hits, 96, "time_of_impact: all 96 near-tangent sphere pairs are contacts");
assert_eq(_r3a_bad_n, 0, "time_of_impact: every near-tangent normal is within 1e-6 of the line of centres");

# === 3.3.3 R5ga: a contact that leaves a gap keeps its own reading unless the probes agree on a better one ===
# ⛔ 3.3.3 — R3a's probe read the wrong feature where a contact grazes. Moving B along
# the direction its last advance STARTED from measures the pair as it was before the
# closest feature changed: a unit box sliding along -x over another with a 2^-40 gap
# came back (+1, 2.2e-7, 0), about 90 degrees from the closest-approach direction
# (0, +1, 0), where 3.3.2 had (0, -1, 0). Each "3.3.3 base:" below is that tree's
# answer, each "3.3.2:" the shipped bundle's.
# [measured: R5ga probes on the 3.3.2 bundle and the 3.3.3 base, 2026-10-01; cycc 6.6.12]
test_group("time_of_impact: a grazing contact keeps its own reading (3.3.3)");
fn _r5ga_toi(sa, a, sb, b, vb, mt) {
    store64(_r3a_t, F64_TWO);
    store64(_r3a_n, 0);
    return time_of_impact(sa, a, hvec3_zero(), sb, b, vb, mt, _r3a_t, _r3a_n);
}
# 1 when the stored normal is exactly (0, +1, 0) up to the signs of its zeros.
fn _r5ga_is_up() {
    if (_r3a_ny() != 0x3FF0000000000000) { return 0; }
    return f64_eq(_r3a_nx(), 0) * f64_eq(_r3a_nz(), 0);
}
var _r5ga_ub = _mpr_mkbox(0, 0, 0, F64_ONE, F64_ONE, F64_ONE);
var _r5ga_left = hvec3_new(f64_neg(F64_ONE), 0, 0);
var _r5ga_ten = f64_from(10);
assert_eq(_r5ga_toi(&_mpr_sup_box, _r5ga_ub, &_mpr_sup_box,
    _mpr_mkbox(f64_from(5), f64_add(F64_TWO, 0x3D70000000000000), 0, F64_ONE, F64_ONE, F64_ONE),
    _r5ga_left, _r5ga_ten), 1, "time_of_impact: a unit box sliding over a unit box, gap 2^-40, hits");
assert_eq(load64(_r3a_t), 0x4008000000000000, "time_of_impact: ... at t = 3 exactly");
assert_eq(_r5ga_is_up(), 1, "time_of_impact: ... n = (0, +1, 0) (3.3.2: (0, -1, 0); 3.3.3 base: (+1, 2.2e-7, 0))");
assert_eq(_r5ga_toi(&_mpr_sup_box, _r5ga_ub, &_mpr_sup_box,
    _mpr_mkbox(f64_from(5), f64_add(F64_TWO, 0x3D719799812DEA11), 0x3FD0000000000000, F64_ONE, F64_ONE, F64_ONE),
    _r5ga_left, _r5ga_ten), 1, "time_of_impact: the same with gap 1e-12 and z offset 0.25 hits");
assert_eq(_r5ga_is_up(), 1, "time_of_impact: ... n = (0, +1, 0) (3.3.2: (0, -1, 0); 3.3.3 base: (+1, 2.4e-7, 0))");
assert_eq(_r5ga_toi(&_mpr_sup_box, _r5ga_ub, &_mpr_sup_sphere,
    hvec4_new(f64_from(5), f64_add(F64_ONE, 0x3D70000000000000), 0x3FC0000000000000, 0), _r5ga_left, _r5ga_ten), 1,
  "time_of_impact: a point sliding over a unit box, gap 2^-40, hits");
assert_eq(load64(_r3a_t), 0x4010000000000000, "time_of_impact: ... at t = 4 exactly");
assert_eq(_r5ga_is_up(), 1, "time_of_impact: ... n = (0, +1, 0) (3.3.2: (0, -1, 0); 3.3.3 base: (+1, 2.2e-7, 0))");
assert_eq(_r5ga_toi(&_mpr_sup_sphere, hvec4_new(0, 0, 0, 0), &_mpr_sup_sphere,
    hvec4_new(f64_from(5), 0x3D70000000000000, 0, 0), _r5ga_left, _r5ga_ten), 1,
  "time_of_impact: a point passing a point 2^-40 off its path hits");
assert_eq(load64(_r3a_t), 0x4014000000000000, "time_of_impact: ... at t = 5 exactly");
assert_eq(_r5ga_is_up(), 1, "time_of_impact: ... n = (0, +1, 0) (3.3.2: (0, -1, 0); 3.3.3 base: (+1, 1.8e-7, 0))");

# The contact's own reading is kept where its supporting plane separates the pair, and
# where probe readings do not agree with each other far better than with it. On a
# sphere these readings are about as good as each other: two spheres placed at
# tangency plus a few ulp, at t = 0, where 3.3.2's reading is 1.05e-8 from the line
# of centres, and taking the probes' instead (no h <= 0 test) gives 2.58e-8. Bit for
# bit 3.3.2's, turned A -> B, through 3.3.3.
# [measured: R5ga sweep q1 on the 3.3.2 bundle and this tree, mutant without the h <= 0 test, 2026-10-01; cycc 6.6.12]
# ⭐ 3.3.4 — the contact's own reading changed with the distance query (its face point
# is now taken along the triangle's normal; see _toi_tri_closest): 4.56e-9 from the line
# of centres. Each pin below names the 3.3.2 value it replaces.
# [measured: collide-lane Decimal check of the four pinned contacts, 3.3.4 base and tree, 2026-10-03; cycc 6.6.14]
test_group("time_of_impact: the contact's own reading where nothing beats it (3.3.3)");
var _r5ga_hund = f64_from(100);
var _r5ga_ca = hvec3_new(0x40112468B6CFDF88, 0xBFE4CBB4ACDE7290, 0xC0107F41DE4BE4BA);
var _r5ga_cb = hvec3_new(0x400EB81F669E7AAD, 0xBFD537AE52743924, 0xC013DB0538AC82C3);
assert_eq(_r5ga_toi(&_mpr_sup_sphere,
    hvec4_new(HVec3_x(_r5ga_ca), HVec3_y(_r5ga_ca), HVec3_z(_r5ga_ca), 0x3FE8A80F871DBB26),
    &_mpr_sup_sphere, hvec4_new(HVec3_x(_r5ga_cb), HVec3_y(_r5ga_cb), HVec3_z(_r5ga_cb), 0x3FCDAFE4281ACDFB),
    hvec3_new(0x3FC852EE4F4E4890, 0x3FEE871752ED2592, 0x3FE0CA6D740BD57E), _r5ga_hund), 1,
  "time_of_impact: near-tangent spheres at t = 0 are a contact");
assert_eq(_r3a_nx(), 0xBFDC73C043E1AFBE, "time_of_impact: ... n.x (3.3.2's, turned: 0xBFDC73C04AD684C5)");
assert_eq(_r3a_ny(), 0x3FD45301B0DAEAB0, "time_of_impact: ... n.y (3.3.2's, turned: 0x3FD45301AED2D123)");
assert_eq(_r3a_nz(), 0xBFEACD53525B6993, "time_of_impact: ... n.z (3.3.2's, turned: 0xBFEACD5350E564CA)");
_r3a_worst = 0;
assert_eq(_r3a_bad(hvec3_normalize(hvec3_sub(_r5ga_cb, _r5ga_ca)), 0x3E55798EE2308C3A), 0,
  "time_of_impact: ... within 2e-8 of the line of centres (the probes': 2.58e-8)");

# A capsule against a sphere: A (-) B is a cylinder along the capsule's axis, a
# reading of its direction can stall in the distance query up to tenths of a radian
# off, and the support value orders directions badly (tilting along the axis
# costs it linearly, turning about it quadratically). These two contacts sit where the
# factors were set: with 8 instead of 32 after an advance (the first) or 3 instead of
# 4 at t = 0 (the second), a probe reading replaces the contact's own one and lands
# further from the closed-form normal than 3.3.2's: 7.73e-6 against 3.52e-6, and
# 6.49e-5 against 1.28e-5.
# [measured: R5ga sweeps qm3 and z3 on the 3.3.2 bundle, this tree and both factor mutants, 2026-10-01; cycc 6.6.12]
# ⭐ 3.3.4 — both readings moved with the distance query, nearer the closed form: the
# swept contact 3.52e-6 -> 1.10e-7 rad, at a t 1.9e-14 short of contact where 3.3.2's
# was 1.2 tolerances past it; the one at t = 0 1.28e-5 -> 3.81e-9 rad. The factor
# windows above are 3.3.3's measurements, on 3.3.3's readings.
# [measured: collide-lane Decimal check of the four pinned contacts, 3.3.4 base and tree, 2026-10-03; cycc 6.6.14]
# Capsule shape: [centre xyz, half-axis xyz, radius]; support = the end along dir plus r dir.
fn _r5ga_sup_cap(shape, dir) {
    var c = hvec3_new(load64(shape), load64(shape + 8), load64(shape + 16));
    var a = hvec3_new(load64(shape + 24), load64(shape + 32), load64(shape + 40));
    var p = hvec3_add(c, a);
    if (f64_lt(hvec3_dot(dir, a), 0) == 1) { p = hvec3_sub(c, a); }
    return hvec3_add(p, hvec3_scale(hvec3_normalize(dir), load64(shape + 48)));
}
fn _r5ga_mkcap(c, a, r) {
    var s = alloc(56);
    store64(s, HVec3_x(c));
    store64(s + 8, HVec3_y(c));
    store64(s + 16, HVec3_z(c));
    store64(s + 24, HVec3_x(a));
    store64(s + 32, HVec3_y(a));
    store64(s + 40, HVec3_z(a));
    store64(s + 48, r);
    return s;
}
# Closed-form A -> B normal of capsule (c, a) and a sphere centred at p: p minus its
# closest point on the axis segment, normalised.
fn _r5ga_cap_ref(c, a, p) {
    var s = f64_div(hvec3_dot(hvec3_sub(p, c), a), hvec3_dot(a, a));
    if (f64_gt(s, F64_ONE) == 1) { s = F64_ONE; }
    if (f64_lt(s, f64_neg(F64_ONE)) == 1) { s = f64_neg(F64_ONE); }
    return hvec3_normalize(hvec3_sub(p, hvec3_add(c, hvec3_scale(a, s))));
}
fn _r5ga_cs(c, a, r, pb, rb, vb) {
    return _r5ga_toi(&_r5ga_sup_cap, _r5ga_mkcap(c, a, r), &_mpr_sup_sphere,
      hvec4_new(HVec3_x(pb), HVec3_y(pb), HVec3_z(pb), rb), vb, _r5ga_hund);
}
var _r5ga_c1 = hvec3_new(0x3F70C2F46D8F6EAC, 0xBF73D1BB0F630AEB, 0xBF38DC40DAD38B64);
var _r5ga_a1 = hvec3_new(0x3F1BEF38339DF20A, 0xBF62ED79B7A98A47, 0x3F4AD2BE201EC2C3);
var _r5ga_p1 = hvec3_new(0xBF7305ACEA42E154, 0x3F848220859BB68D, 0x3F7A52CB2B6F7577);
var _r5ga_v1 = hvec3_new(0x3F5C14D83F21FB8D, 0xBF6A716A019A86B0, 0xBF538A682AE44F0E);
assert_eq(_r5ga_cs(_r5ga_c1, _r5ga_a1, 0x3F486F204EA2B4AD, _r5ga_p1, 0x3F54785B10522C4A, _r5ga_v1), 1,
  "time_of_impact: a sphere swept onto a capsule's side hits");
assert_eq(load64(_r3a_t), 0x4011B347FF0D81EB,
  "time_of_impact: ... at t 1.9e-14 short of contact (3.3.2: 0x4011B347FF4CA88C, 1.2 tolerances in)");
assert_eq(_r3a_nx(), 0xBFE26C3CF8217D67, "time_of_impact: ... n.x (3.3.2's, turned: 0xBFE26C42CC9E2341)");
assert_eq(_r3a_ny(), 0x3FCFEA2B58B04BBA, "time_of_impact: ... n.y (3.3.2's, turned: 0x3FCFEA24BF4760CA)");
assert_eq(_r3a_nz(), 0x3FE8EB2EFB70C94A, "time_of_impact: ... n.z (3.3.2's, turned: 0x3FE8EB2B333F8E11)");
assert_eq(_r3a_bad(_r5ga_cap_ref(_r5ga_c1, _r5ga_a1, hvec3_add(_r5ga_p1, hvec3_scale(_r5ga_v1, load64(_r3a_t)))),
    0x3ED4F8B588E368F1), 0, "time_of_impact: ... within 5e-6 of the closed-form normal (factor 8: 7.73e-6)");
var _r5ga_c2 = hvec3_new(0x400816D5DBD26D34, 0x4006EEC7B170861A, 0x4013E5AA8ABF4162);
var _r5ga_a2 = hvec3_new(0x3FEBF5C127FDEC3E, 0xBFD2C58136CA6725, 0xC0016ECB7BE811A4);
var _r5ga_p2 = hvec3_new(0x3FFB1A6523A77070, 0x400C3C5AE81A0B4C, 0x401A8569FC576905);
assert_eq(_r5ga_cs(_r5ga_c2, _r5ga_a2, 0x3FD518CDFF4504A8, _r5ga_p2, 0x3FD99E2535AB2800,
    hvec3_new(0x3FC177D9AB50A280, 0xBFEE572917995FFA, 0xBFE9B123342F1806)), 1,
  "time_of_impact: a sphere on a capsule's side at t = 0 is a contact");
assert_eq(_r3a_nx(), 0xBFE7D927D7E9278B, "time_of_impact: ... n.x (3.3.2's, turned: 0xBFE7D918F8FEAEA2)");
assert_eq(_r3a_ny(), 0x3FE1AE8130F001B5, "time_of_impact: ... n.y (3.3.2's, turned: 0x3FE1AE97559FA956)");
assert_eq(_r3a_nz(), 0xBFD7E279064724B7, "time_of_impact: ... n.z (3.3.2's, turned: 0xBFD7E272D889046F)");
assert_eq(_r3a_bad(_r5ga_cap_ref(_r5ga_c2, _r5ga_a2, _r5ga_p2), 0x3EFF75104D551D69), 0,
  "time_of_impact: ... within 3e-5 of the closed-form normal (factor 3: 6.49e-5)");

# Where the probes do agree, their reading replaces the contact's own: a sphere on a
# capsule's side at t = 0, where 3.3.2's reading is 1.09e-2 from the closed form and
# the probe reading 2.97e-6. Taking a reading whose support value is not below the
# contact's own (the h test removed) gives 3.52e-3 here.
# [measured: R5ga sweep z3 on the 3.3.2 bundle, this tree and that mutant, 2026-10-01; cycc 6.6.12]
var _r5ga_c3 = hvec3_new(0xBFE7E68021BCA718, 0x4005FB2C8308F5BC, 0x3FFF79E65C037CD0);
var _r5ga_a3 = hvec3_new(0x4001A95112BC7698, 0x3FD4C61E5E1D9C41, 0x3FFF7920F7AAF33D);
var _r5ga_p3 = hvec3_new(0x3FE2BDE0B76969EF, 0x401343CEAB64A03E, 0x400D815046923245);
assert_eq(_r5ga_cs(_r5ga_c3, _r5ga_a3, 0x3FEB44784A2DDA56, _r5ga_p3, 0x3FF037E88A5F6FD4,
    hvec3_new(0x3FCC5E52CE9648C6, 0xBFEF13504B02BD29, 0xBFB6A76488C49EAA)), 1,
  "time_of_impact: another sphere on a capsule's side at t = 0 is a contact");
assert_eq(_r3a_bad(_r5ga_cap_ref(_r5ga_c3, _r5ga_a3, _r5ga_p3), 0x3EE4F8B588E368F1), 0,
  "time_of_impact: ... within 1e-5 of the closed-form normal (3.3.2: 1.09e-2 off)");

# A gap below 2^-1024, whose reciprocal overflows: 3.3.2 answered (-Inf, -Inf, -Inf).
# Boxes of half-extent 2^-1000 corner to corner, gaps 3, 5 and 7 times 2^-1038 along
# x, y and z. The contact's own reading, scaled by 2^508 before it is normalised (an
# exact scaling), is the closed-form (3, 5, 7)/|.|; without the scaling the reading is
# +Inf in every component, and dropping it leaves the probe chain's (1, 1, 1)/|.|.
# [measured: R5ga probe on the 3.3.2 bundle and this tree, both mutants, 2026-10-01; cycc 6.6.12]
var _r5ga_h = (1023 - 1000) << 52;
var _r5ga_g = hvec3_new(3 << 36, 5 << 36, 7 << 36);
var _r5ga_cg = hvec3_add(hvec3_new(f64_mul(_r5ga_h, F64_TWO), f64_mul(_r5ga_h, F64_TWO), f64_mul(_r5ga_h, F64_TWO)),
  _r5ga_g);
assert_eq(_r5ga_toi(&_mpr_sup_box, _mpr_mkbox(0, 0, 0, _r5ga_h, _r5ga_h, _r5ga_h), &_mpr_sup_box,
    _mpr_mkbox(HVec3_x(_r5ga_cg), HVec3_y(_r5ga_cg), HVec3_z(_r5ga_cg), _r5ga_h, _r5ga_h, _r5ga_h),
    hvec3_neg(hvec3_normalize(hvec3_new(F64_ONE, F64_ONE, F64_ONE))), _r5ga_ten), 1,
  "time_of_impact: boxes of half-extent 2^-1000 with subnormal gaps are a contact");
assert_eq(load64(_r3a_t), 0, "time_of_impact: ... at t = +0");
assert_eq(_r3a_bad(hvec3_normalize(hvec3_new(f64_from(3), f64_from(5), f64_from(7))), 0x3CD0000000000000), 0,
  "time_of_impact: ... n within 2^-50 of (3, 5, 7)/|.| (3.3.2: (-Inf, -Inf, -Inf))");

# A reading the geometry refutes: moving B a probe distance s along it leaves the pair
# apart by no more than s/4. Two box contacts where 3.3.2's reading points along a face
# the boxes overlap across (3.3.2: (0, 0, -1) and (-0.447, 0, -0.894)); the probe
# chain answers with the face axis. Refuting only at "not apart at all" (cut 0) leaves
# the first at (0, +1, 0), 90 degrees off; a cut of 1/2 or 3/4 leaves the second 1.06
# rad off.
# [measured: R5ga sweeps q2 and z2 on this tree and the cut mutants, 2026-10-01; cycc 6.6.12]
var _r5ga_bc1 = hvec3_new(0x402B4FA836DC0B14, 0x401F825A69663634, 0x401A813BE19E4F2C);
store64(_r3a_t, F64_TWO);
store64(_r3a_n, 0);
assert_eq(time_of_impact(&_mpr_sup_box,
    _mpr_mkbox(0x3FF047CA7463D97C, 0xBFCE5BEB50D94180, 0xC0110C757E192214, 0x40032E662EB28615, 0x40038E48DEC869B6,
      0x4006268D55120F77), hvec3_new(0xBF639601828F2098, 0xBFE58C441224FD62, 0x3FCB88F9C01E27DE), &_mpr_sup_box,
    _mpr_mkbox(HVec3_x(_r5ga_bc1), HVec3_y(_r5ga_bc1), HVec3_z(_r5ga_bc1), 0x3FCEF5A711242AED, 0x3FDF23107ABE511F,
      0x3FE2444C61F7A6C1), hvec3_new(0xBFE922A1610D2285, 0xBFF173760093CBCA, 0xBFE2B48739D10DB4), _r5ga_hund,
    _r3a_t, _r3a_n), 1, "time_of_impact: two moving boxes meet");
assert_eq(_r3a_nx(), 0x3FF0000000000000, "time_of_impact: ... n.x = +1 exactly (cut 0: (0, +1, 0))");
assert_eq(f64_eq(_r3a_ny(), 0) + f64_eq(_r3a_nz(), 0), 2, "time_of_impact: ... n.y = n.z = 0");
var _r5ga_bc2 = hvec3_new(0x400E572BA5029488, 0xC016DA0302255DA8, 0xC00C459DCCA93327);
assert_eq(_r5ga_toi(&_mpr_sup_box,
    _mpr_mkbox(0x3FF43F09515D723C, 0xBFE80E93CA18A0F0, 0xC006ECE290F076AC, 0x3FF4DA5D5E8DE996, 0x4001E92205FAA1D0,
      0x3FF225A9D84C1766), &_mpr_sup_box,
    _mpr_mkbox(HVec3_x(_r5ga_bc2), HVec3_y(_r5ga_bc2), HVec3_z(_r5ga_bc2), 0x3FF394F09A19CD3D, 0x4005C73F0BC9F144,
      0x40057A1EC3A9E4C8), hvec3_new(f64_neg(F64_ONE), 0, 0), _r5ga_hund), 1,
  "time_of_impact: two boxes a few ulp apart at t = 0 are a contact");
assert_eq(_r3a_bad(hvec3_unit_x(), 0x3E112E0BE826D695), 0,
  "time_of_impact: ... n within 1e-9 of +x (cut 1/2 or 3/4: 1.06 rad off)");
# The cut's lower side: at 1/10 a sphere swept onto a box keeps a probe reading
# 2.58e-3 off; at 1/4 the answer is 1.30e-5 from the closed form.
# [measured: R5ga sweep q1 on this tree and the cut-1/10 mutant, 2026-10-01; cycc 6.6.12]
var _r5ga_xc = _mpr_mkbox(0x4013E6FAC05A42B8, 0xC00725917D761E02, 0xC00C9C39BB45D9F4, 0x3FE91F6A634E2D18,
  0x40067D4B22EE165C, 0x3FE8FB30DEA9183A);
var _r5ga_xp = hvec3_new(0xC0222C38D07463B8, 0xC02B107C0EEE5CEE, 0x3FD3046D3D7765A0);
var _r5ga_xv = hvec3_new(0x3FFEA55C1753E2FD, 0x3FF94057BCBC2498, 0xBFE7ED81249CFE6E);
assert_eq(_r5ga_toi(&_mpr_sup_box, _r5ga_xc, &_mpr_sup_sphere,
    hvec4_new(HVec3_x(_r5ga_xp), HVec3_y(_r5ga_xp), HVec3_z(_r5ga_xp), 0x3FF127737F30E33D), _r5ga_xv, _r5ga_hund), 1,
  "time_of_impact: a sphere swept onto a box hits");
var _r5ga_xq = hvec3_add(_r5ga_xp, hvec3_scale(_r5ga_xv, load64(_r3a_t)));
# The point of box (c, h) nearest p.
fn _r5ga_clamp_box(c, h, p) {
    var x = HVec3_x(p);
    var y = HVec3_y(p);
    var z = HVec3_z(p);
    if (f64_gt(x, f64_add(HVec3_x(c), HVec3_x(h))) == 1) { x = f64_add(HVec3_x(c), HVec3_x(h)); }
    if (f64_lt(x, f64_sub(HVec3_x(c), HVec3_x(h))) == 1) { x = f64_sub(HVec3_x(c), HVec3_x(h)); }
    if (f64_gt(y, f64_add(HVec3_y(c), HVec3_y(h))) == 1) { y = f64_add(HVec3_y(c), HVec3_y(h)); }
    if (f64_lt(y, f64_sub(HVec3_y(c), HVec3_y(h))) == 1) { y = f64_sub(HVec3_y(c), HVec3_y(h)); }
    if (f64_gt(z, f64_add(HVec3_z(c), HVec3_z(h))) == 1) { z = f64_add(HVec3_z(c), HVec3_z(h)); }
    if (f64_lt(z, f64_sub(HVec3_z(c), HVec3_z(h))) == 1) { z = f64_sub(HVec3_z(c), HVec3_z(h)); }
    return hvec3_new(x, y, z);
}
var _r5ga_xcc = hvec3_new(0x4013E6FAC05A42B8, 0xC00725917D761E02, 0xC00C9C39BB45D9F4);
var _r5ga_xch = hvec3_new(0x3FE91F6A634E2D18, 0x40067D4B22EE165C, 0x3FE8FB30DEA9183A);
var _r5ga_xr = hvec3_normalize(hvec3_sub(_r5ga_xq, _r5ga_clamp_box(_r5ga_xcc, _r5ga_xch, _r5ga_xq)));
assert_eq(_r3a_bad(_r5ga_xr, 0x3F1A36E2EB1C432D), 0,
  "time_of_impact: ... n within 1e-4 of the closed-form normal (cut 1/10: 2.58e-3)");

# The probe chain's pair is offered after an advance too, not only at t = 0: a point
# swept past a unit box's edge with a sub-tolerance gap, where 3.3.2's reading is 90
# degrees from the closest-approach direction (+1, 0, 0) and the chain's readings agree
# on it. Offering the chain's pair at t = 0 only keeps 3.3.2's reading here.
# [measured: R5ga sweep g2 on the 3.3.2 bundle, this tree and that mutant, 2026-10-01; cycc 6.6.12]
assert_eq(_r5ga_toi(&_mpr_sup_box, _r5ga_ub, &_mpr_sup_sphere,
    hvec4_new(0x4006B4C75BF16AEC, 0xC00225A3FEEBB06C, 0xBFAF06F3F19A16D0, 0),
    hvec3_new(0xBFEAA5CE2A887B0A, 0x3FF7B076339A1F1A, 0x3FC01E3F2B0D0D72), _r5ga_hund), 1,
  "time_of_impact: a point swept past a box edge hits");
assert_eq(_r3a_bad(hvec3_unit_x(), 0x3D719799812DEA11), 0,
  "time_of_impact: ... n within 1e-12 of +x (3.3.2 and the chain-at-t = 0-only form: 90 degrees off)");

# === 3.3.4: impact times where A (-) B is a cylinder ===
# A sphere swept onto a box edge, or onto a capsule's side, meets A (-) B where it is a
# cylinder. On the 3.3.4 base, 137 of the 300 box-edge fixtures below came back late
# (inside the pair by more than a tolerance), and of the 300 capsule fixtures 134 came
# back late, up to 82 tolerances deep, and 1 early: the distance query's direction
# leaned along the cylinder's axis, the loop stepped on a lower bound measured along
# another direction, and its least advance was taken along the leaning one.
# [measured: collide-lane tally of this block on the 3.3.4 base sources and this tree, 2026-10-03; cycc 6.6.14]
# Each fixture below is aimed so the sphere's centre passes through a point of contact
# with the edge's (or the side's) rounded region, so every one is a hit, and the
# reported t is judged by the pair's own signed distance there, in f64, against the
# contact tolerance time_of_impact uses (1e-9 times A (-) B's extent along the motion):
# within it on both sides is a contact; beyond it outside is early, inside is late.
test_group("time_of_impact: impact times on box edges and capsule sides (3.3.4)");
var _cyl_t = alloc(8);
var _cyl_n = alloc(8);
var _cyl_tolrel = 0x3E112E0BE826D695;     # 1e-9, time_of_impact's _GA_TOI_TOL_REL
var _cyl_slack = 0x3FF0010624DD2F1B;      # 1.00025: f64 rounding of the judge itself
fn _cyl_sgn(x) {
    if (f64_lt(x, 0) == 1) { return f64_neg(F64_ONE); }
    return F64_ONE;
}
# Signed distance of the sphere (p, r) from the box [-h, h].
fn _cyl_sd_box(h, p, r) {
    var qx = f64_sub(f64_abs(HVec3_x(p)), HVec3_x(h));
    var qy = f64_sub(f64_abs(HVec3_y(p)), HVec3_y(h));
    var qz = f64_sub(f64_abs(HVec3_z(p)), HVec3_z(h));
    var outside = hvec3_length(hvec3_new(f64_max(qx, 0), f64_max(qy, 0), f64_max(qz, 0)));
    var inside = f64_min(f64_max(qx, f64_max(qy, qz)), 0);
    return f64_sub(f64_add(outside, inside), r);
}
# Signed distance of the sphere (p, r) from the capsule (half-axis a, radius ra) at the origin.
fn _cyl_sd_cap(a, ra, p, r) {
    var s = f64_div(hvec3_dot(p, a), hvec3_dot(a, a));
    if (f64_gt(s, F64_ONE) == 1) { s = F64_ONE; }
    if (f64_lt(s, f64_neg(F64_ONE)) == 1) { s = f64_neg(F64_ONE); }
    return f64_sub(hvec3_length(hvec3_sub(p, hvec3_scale(a, s))), f64_add(ra, r));
}
# The contact tolerance time_of_impact uses for a box (half-extents h) or a capsule
# (half-axis a, radius ra) against a sphere of radius r moving at v: 1e-9 times
# |support(u) - support(-u)| of A (-) B, u = v / |v|.
fn _cyl_tol_box(h, r, v) {
    var u = hvec3_normalize(v);
    var e = hvec3_add(hvec3_new(f64_mul(HVec3_x(h), _cyl_sgn(HVec3_x(u))), f64_mul(HVec3_y(h), _cyl_sgn(HVec3_y(u))),
        f64_mul(HVec3_z(h), _cyl_sgn(HVec3_z(u)))), hvec3_scale(u, r));
    return f64_mul(f64_mul(F64_TWO, hvec3_length(e)), _cyl_tolrel);
}
fn _cyl_tol_cap(a, ra, r, v) {
    var u = hvec3_normalize(v);
    var e = hvec3_add(hvec3_scale(a, _cyl_sgn(hvec3_dot(u, a))), hvec3_scale(u, f64_add(ra, r)));
    return f64_mul(f64_mul(F64_TWO, hvec3_length(e)), _cyl_tolrel);
}
# 0 contact, 1 early, 2 late, 3 a miss; tol the contact tolerance, sd at the reported t.
fn _cyl_judge(rc, sd, tol) {
    if (rc != 1) { return 3; }
    var lim = f64_mul(tol, _cyl_slack);
    if (f64_gt(sd, lim) == 1) { return 1; }
    if (f64_lt(sd, f64_neg(lim)) == 1) { return 2; }
    return 0;
}
# One box-edge or capsule-side fixture, everything scaled by 2^e, judged on the
# unit-scale pair at the reported t (t does not scale).
fn _cyl_box_case(h, p, r, v, e) {
    var s = (1023 + e) << 52;
    var rc = time_of_impact(&_mpr_sup_box, _mpr_mkbox(0, 0, 0, f64_mul(HVec3_x(h), s), f64_mul(HVec3_y(h), s),
        f64_mul(HVec3_z(h), s)), hvec3_zero(), &_mpr_sup_sphere, hvec4_new(f64_mul(HVec3_x(p), s),
        f64_mul(HVec3_y(p), s), f64_mul(HVec3_z(p), s), f64_mul(r, s)), hvec3_scale(v, s), f64_from(10),
      _cyl_t, _cyl_n);
    return _cyl_judge(rc, _cyl_sd_box(h, hvec3_add(p, hvec3_scale(v, load64(_cyl_t))), r), _cyl_tol_box(h, r, v));
}
fn _cyl_cap_case(a, ra, p, rb, v, e) {
    var s = (1023 + e) << 52;
    var rc = time_of_impact(&_r5ga_sup_cap, _r5ga_mkcap(hvec3_zero(), hvec3_scale(a, s), f64_mul(ra, s)), hvec3_zero(),
      &_mpr_sup_sphere, hvec4_new(f64_mul(HVec3_x(p), s), f64_mul(HVec3_y(p), s), f64_mul(HVec3_z(p), s),
        f64_mul(rb, s)), hvec3_scale(v, s), f64_from(10), _cyl_t, _cyl_n);
    return _cyl_judge(rc, _cyl_sd_cap(a, ra, hvec3_add(p, hvec3_scale(v, load64(_cyl_t))), rb),
      _cyl_tol_cap(a, ra, rb, v));
}
var _cyl_box_tally = alloc(32);
var _cyl_cap_tally = alloc(32);
for (var _cyl_i = 0; _cyl_i < 4; _cyl_i = _cyl_i + 1) {
    store64(_cyl_box_tally + _cyl_i * 8, 0);
    store64(_cyl_cap_tally + _cyl_i * 8, 0);
}
var _cyl_worst_late = 0;
_DLR_STATE = 0x2026_1003_0000_0001;
for (var _cyl_k = 0; _cyl_k < 300; _cyl_k = _cyl_k + 1) {
    # A sphere onto an edge of the box [-h, h]: `free` is the edge's own axis.
    var _cb_h = hvec3_new(_toi_frac(5, 20, 10), _toi_frac(5, 20, 10), _toi_frac(5, 20, 10));
    var _cb_r = _toi_frac(2, 15, 10);
    var _cb_bits = _dlr_next();
    var _cb_free = _cyl_k % 3;
    var _cb_sx = F64_ONE;
    var _cb_sy = F64_ONE;
    var _cb_sz = F64_ONE;
    if ((_cb_bits & 1) == 1) { _cb_sx = f64_neg(F64_ONE); }
    if ((_cb_bits & 2) == 2) { _cb_sy = f64_neg(F64_ONE); }
    if ((_cb_bits & 4) == 4) { _cb_sz = f64_neg(F64_ONE); }
    var _cb_tx = f64_mul(_cb_sx, HVec3_x(_cb_h));
    var _cb_ty = f64_mul(_cb_sy, HVec3_y(_cb_h));
    var _cb_tz = f64_mul(_cb_sz, HVec3_z(_cb_h));
    var _cb_nx = f64_mul(_cb_sx, _toi_frac(2, 10, 10));
    var _cb_ny = f64_mul(_cb_sy, _toi_frac(2, 10, 10));
    var _cb_nz = f64_mul(_cb_sz, _toi_frac(2, 10, 10));
    var _cb_along = _toi_frac(0 - 9, 9, 10);
    if (_cb_free == 0) { _cb_tx = f64_mul(_cb_along, HVec3_x(_cb_h)); _cb_nx = 0; }
    if (_cb_free == 1) { _cb_ty = f64_mul(_cb_along, HVec3_y(_cb_h)); _cb_ny = 0; }
    if (_cb_free == 2) { _cb_tz = f64_mul(_cb_along, HVec3_z(_cb_h)); _cb_nz = 0; }
    var _cb_n = hvec3_normalize(hvec3_new(_cb_nx, _cb_ny, _cb_nz));
    var _cb_imp = hvec3_add(hvec3_new(_cb_tx, _cb_ty, _cb_tz), hvec3_scale(_cb_n, _cb_r));
    var _cb_d = hvec3_normalize(hvec3_add(hvec3_scale(_cb_n, f64_from(3)),
        hvec3_new(_toi_frac(0 - 10, 10, 10), _toi_frac(0 - 10, 10, 10), _toi_frac(0 - 10, 10, 10))));
    var _cb_speed = _toi_frac(5, 30, 10);
    var _cb_p = hvec3_add(_cb_imp, hvec3_scale(_cb_d, f64_mul(_cb_speed, _toi_frac(5, 40, 10))));
    var _cb_v = hvec3_scale(_cb_d, f64_neg(_cb_speed));
    var _cb_rc = time_of_impact(&_mpr_sup_box, _mpr_mkbox(0, 0, 0, HVec3_x(_cb_h), HVec3_y(_cb_h), HVec3_z(_cb_h)),
      hvec3_zero(), &_mpr_sup_sphere, hvec4_new(HVec3_x(_cb_p), HVec3_y(_cb_p), HVec3_z(_cb_p), _cb_r), _cb_v,
      f64_from(10), _cyl_t, _cyl_n);
    var _cb_tol = _cyl_tol_box(_cb_h, _cb_r, _cb_v);
    var _cb_sd = 0;
    if (_cb_rc == 1) {
        _cb_sd = _cyl_sd_box(_cb_h, hvec3_add(_cb_p, hvec3_scale(_cb_v, load64(_cyl_t))), _cb_r);
    }
    var _cb_j = _cyl_judge(_cb_rc, _cb_sd, _cb_tol);
    store64(_cyl_box_tally + _cb_j * 8, load64(_cyl_box_tally + _cb_j * 8) + 1);

    # A sphere onto the side of a capsule at the origin: half-axis a, radius ra.
    var _cc_a = hvec3_scale(hvec3_normalize(hvec3_new(_toi_frac(0 - 10, 10, 10), _toi_frac(0 - 10, 10, 10),
          _toi_frac(1, 10, 10))), _toi_frac(5, 25, 10));
    var _cc_ra = _toi_frac(2, 10, 10);
    var _cc_rb = _toi_frac(2, 12, 10);
    var _cc_perp = hvec3_normalize(hvec3_cross(_cc_a, hvec3_new(_toi_frac(1, 10, 10), _toi_frac(0 - 10, 10, 10),
          _toi_frac(0 - 10, 10, 10))));
    var _cc_imp = hvec3_add(hvec3_scale(_cc_a, _toi_frac(0 - 9, 9, 10)),
      hvec3_scale(_cc_perp, f64_add(_cc_ra, _cc_rb)));
    var _cc_d = hvec3_normalize(hvec3_add(hvec3_scale(_cc_perp, f64_from(3)),
        hvec3_new(_toi_frac(0 - 10, 10, 10), _toi_frac(0 - 10, 10, 10), _toi_frac(0 - 10, 10, 10))));
    var _cc_speed = _toi_frac(5, 30, 10);
    var _cc_p = hvec3_add(_cc_imp, hvec3_scale(_cc_d, f64_mul(_cc_speed, _toi_frac(5, 40, 10))));
    var _cc_v = hvec3_scale(_cc_d, f64_neg(_cc_speed));
    var _cc_rc = time_of_impact(&_r5ga_sup_cap, _r5ga_mkcap(hvec3_zero(), _cc_a, _cc_ra), hvec3_zero(),
      &_mpr_sup_sphere, hvec4_new(HVec3_x(_cc_p), HVec3_y(_cc_p), HVec3_z(_cc_p), _cc_rb), _cc_v,
      f64_from(10), _cyl_t, _cyl_n);
    var _cc_tol = _cyl_tol_cap(_cc_a, _cc_ra, _cc_rb, _cc_v);
    var _cc_sd = 0;
    if (_cc_rc == 1) {
        _cc_sd = _cyl_sd_cap(_cc_a, _cc_ra, hvec3_add(_cc_p, hvec3_scale(_cc_v, load64(_cyl_t))), _cc_rb);
    }
    var _cc_j = _cyl_judge(_cc_rc, _cc_sd, _cc_tol);
    store64(_cyl_cap_tally + _cc_j * 8, load64(_cyl_cap_tally + _cc_j * 8) + 1);
    if (_cc_j == 2) {
        var _cc_depth = f64_div(f64_neg(_cc_sd), _cc_tol);
        if (f64_gt(_cc_depth, _cyl_worst_late) == 1) { _cyl_worst_late = _cc_depth; }
    }
}
assert_eq(load64(_cyl_box_tally), 300,
  "time_of_impact: all 300 spheres onto box edges are contacts within tolerance (3.3.4 base: 163)");
assert_eq(load64(_cyl_box_tally + 24), 0, "time_of_impact: ... no box-edge hit is a miss");
assert_eq(load64(_cyl_cap_tally + 8), 0, "time_of_impact: no sphere onto a capsule side is early (3.3.4 base: 1)");
assert_eq(load64(_cyl_cap_tally + 24), 0, "time_of_impact: ... and none is a miss");
assert_lt(_cyl_worst_late, 0x4008000000000000,
  "time_of_impact: ... and none lands more than 3 tolerances past contact (3.3.4 base: 82)");
# The same two kinds of contact at the ends of the scale range (D045): everything scaled
# by 2^e, the reported t judged on the unit-scale pair (t does not scale). On the 3.3.4
# base all twelve were wrong: early, or a miss.
var _cyl_xh = hvec3_new(0x3FFC0907CAD812DE, 0x3FFB4B4EB3C99B98, 0x3FF4DC78A40F237E);
var _cyl_xp = hvec3_new(0xC00DB725E5CC72A1, 0x40105233F9D06D5B, 0xBFE67D36A1CBEFC9);
var _cyl_xv = hvec3_new(0x3FE777EF77C33196, 0xBFF2570FCAA77226, 0x3FE69BE0894CFC8E);
var _cyl_xr = 0x3FED78BF0079A324;
var _cyl_ya = hvec3_new(0x3FF39F1C9B0B7797, 0xBFDDF4B39DFD6AD8, 0xBFECA7F5B0D3AEE4);
var _cyl_yra = 0x3FD7BF39BD183AF2;
var _cyl_yp = hvec3_new(0x3F970A24031D90BB, 0xC00A71228ACA56B2, 0xC017B51F3F31DC1F);
var _cyl_yrb = 0x3FE558411892B512;
var _cyl_yv = hvec3_new(0xBFB65BE1F0059801, 0x3FEB342FEEAE8552, 0x3FF86F6EFF6CFAAF);
var _cyl_scale_bad = 0;
for (var _cyl_si = 0; _cyl_si < 6; _cyl_si = _cyl_si + 1) {
    var _cyl_e = 0 - 1000;
    if (_cyl_si == 1) { _cyl_e = 0 - 600; }
    if (_cyl_si == 2) { _cyl_e = 340; }
    if (_cyl_si == 3) { _cyl_e = 512; }
    if (_cyl_si == 4) { _cyl_e = 600; }
    if (_cyl_si == 5) { _cyl_e = 1000; }
    if (_cyl_box_case(_cyl_xh, _cyl_xp, _cyl_xr, _cyl_xv, _cyl_e) != 0) { _cyl_scale_bad = _cyl_scale_bad + 1; }
    if (_cyl_cap_case(_cyl_ya, _cyl_yra, _cyl_yp, _cyl_yrb, _cyl_yv, _cyl_e) != 0) {
        _cyl_scale_bad = _cyl_scale_bad + 1;
    }
}
assert_eq(_cyl_scale_bad, 0,
  "time_of_impact: a box edge and a capsule side at 2^-1000 .. 2^1000 meet within tolerance (3.3.4 base: 12 wrong)");
# One fixture for each part of the repair that the sweeps above do not single out, each
# a contact within tolerance here and wrong with that part alone reverted (named in the
# message), from a 23,000-pair sweep of this tree against each part reverted.
# [measured: collide-lane part sweep (Decimal oracle), this tree against each part reverted, 2026-10-03; cycc 6.6.14]
assert_eq(_cyl_cap_case(hvec3_new(0x3FEDAFDBD5CC5330, 0x3FC0C26BDC064584, 0xBFF3F6E0FA33A0AC), 0x3FE71834428B2B3E,
    hvec3_new(0xBFD16CE45EE85130, 0xC0208C86C192C7EE, 0x40179792FBFB4FE2), 0x3FEFB2F02F700AA2,
    hvec3_new(0x3FA1EB874FF4A9A0, 0x3FFE2911224BEBFB, 0xBFF75BA72670AC74), 0), 0,
  "time_of_impact: a capsule side within tolerance (stepping along the last v: 1.6 tolerances in)");
assert_eq(_cyl_cap_case(hvec3_new(0x3FF1C09D8C701F85, 0xBFE63D2BA8267045, 0x3FE517287D252BFE), 0x3FEE10DC1F0118EE,
    hvec3_new(0x3FF763961E21CE87, 0xBFF53A16C172F0C6, 0xC00318966771E0C2), 0x3FE49EB196095A6E,
    hvec3_new(0xBFDEB1AF133C7C72, 0x3FB81E508EF344BF, 0x3FD8780C029AA146), 0), 0,
  "time_of_impact: another (the least advance along the last v: 3.0 tolerances in)");
assert_eq(_cyl_cap_case(hvec3_new(0xBFD1AEACABE55261, 0xBFC795A81DF62036, 0x3FEE6E009C86BD6D), 0x3FE7D40E1B04CB6A,
    hvec3_new(0x3FDB3D7BC44DCFE3, 0xC0180E194B58396E, 0x4010837D9FF606E0), 0x3FD7F0628F06E1B7,
    hvec3_new(0x3FA5C65960768218, 0x3FFFEFBDFE75BE56, 0xBFF87C0E4B55A6BF), 0), 0,
  "time_of_impact: another (a face point not floored by the edges: 2.0 tolerances in)");
assert_eq(_cyl_box_case(hvec3_new(0x3FFD01092E0F3E48, 0x3FE1A7610B935F70, 0x3FFAB136C00A144B),
    hvec3_new(0xC006A2DA337CA23A, 0x3FE31BADE311C775, 0xC016D9A9C50B0BDC), 0x3FF451E74DFEFEBB,
    hvec3_new(0xBF76E455B69F9B49, 0xBFE3DBF65B968E5D, 0x3FFC7DD6031CE5D9), 524), 0,
  "time_of_impact: a box edge at 2^524 within tolerance (v . p left unscaled when it overflows: a miss)");
assert_eq(_cyl_box_case(hvec3_new(0x3FFFFBAB67F4008E, 0x3FE2AF91DAB6976F, 0x3FE2E84D195955AB),
    hvec3_new(0x3FFF69665C669065, 0x40024EE36DD6CE76, 0xBFFCCA71221B4627), 0x3FF3F6536E10F8E5,
    hvec3_new(0xBFD8860B2BE38727, 0xBFD883269E9A85B9, 0x3FBB7E5B1416338D), 340), 0,
  "time_of_impact: a box edge at 2^340 within tolerance (non-finite flag on an overflowed direction: a miss)");
# Four mutants of this repair survive every suite and are left unpinned. Refuting the
# t = 0 overlap on any positive bound, not one above the tolerance, changes only the
# reported normal (rc and t unchanged): 2 and 17 of 1,200 near-tangent pairs moving
# from contact, in two sweeps. Accepting zero signed areas in the triangle routine,
# dropping a NaN y in _toi_vmax, and removing the no-bound receding exit changed no
# answer over 4,800 swept pairs and a 1,440-pair non-finite survey: equivalent in
# practice, or a cost only.
# [measured: mutant bundles vs the 3.3.4 tree: two near-tangent sweeps, 4,800 swept, survey, 2026-10-03; cycc 6.6.14]
# The normal of a capsule contact: |n - closed form| for unit vectors; 2.0 (fails) for a NaN.
fn _cyl_cap_nerr(a, p, v) {
    var q = hvec3_add(p, hvec3_scale(v, load64(_cyl_t)));
    var s = f64_div(hvec3_dot(q, a), hvec3_dot(a, a));
    if (f64_gt(s, F64_ONE) == 1) { s = F64_ONE; }
    if (f64_lt(s, f64_neg(F64_ONE)) == 1) { s = f64_neg(F64_ONE); }
    var e = hvec3_length(hvec3_sub(load64(_cyl_n), hvec3_normalize(hvec3_sub(q, hvec3_scale(a, s)))));
    if (f64_le(e, F64_TWO) == 0) { return F64_TWO; }
    return e;
}
var _cyl_na = hvec3_new(0x3FD19CF4D1010527, 0x3FEA5BFEB1A8A0A5, 0xBFF0A9F56D7C6C44);
var _cyl_np = hvec3_new(0xBFFB11D695D4869B, 0x3FE1936DEC4F0507, 0xBFD29FE7063A606F);
var _cyl_nv = hvec3_new(0x3FE7713DA62E7093, 0xBFD569617CA50BAA, 0x3FC88E7DFE01BAD6);
assert_eq(_cyl_cap_case(_cyl_na, 0x3FDD5D4FAFFE5467, _cyl_np, 0x3FCA9C8F19ADE1BA, _cyl_nv, 0), 0,
  "time_of_impact: a capsule contact found by a query that stopped short is within tolerance");
assert_lt(_cyl_cap_nerr(_cyl_na, _cyl_np, _cyl_nv), 0x3EB0C6F7A0B5ED8D,
  "time_of_impact: ... and its normal within 1e-6 of the closed form (the contact reading kept: 7.6e-4)");
var _cyl_ma = hvec3_new(0xBFFE68182D218A7C, 0x3FE3FAD0716FA3C6, 0xBFEAADB587C61DBF);
var _cyl_mp2 = hvec3_new(0xBFF5D7E65B939507, 0xC00A403CB3BF0A32, 0x3FF9A9D4D3AB5B42);
var _cyl_mv2 = hvec3_new(0x3FF6A906D6405E7B, 0x3FF65C0F846965EA, 0x3F89CB63558B1927);
assert_eq(_cyl_cap_case(_cyl_ma, 0x3FD2C4D687C88C58, _cyl_mp2, 0x3FEFB9943EC6DC86, _cyl_mv2, 0 - 1000), 0,
  "time_of_impact: a capsule contact at 2^-1000 within tolerance");
assert_lt(_cyl_cap_nerr(_cyl_ma, _cyl_mp2, _cyl_mv2), 0x3EB0C6F7A0B5ED8D,
  "time_of_impact: ... normal within 1e-6 (a probe reading normalised through 1/|v|: 2.5e-6)");

# Two of the gross answers of the 3.3.4 base, from a wider sweep: a sphere swept 0.51
# deep into a box edge (first contact at t = 1.9083) was a MISS, the "proof" of no
# collision taken along a direction that leaned along the edge; and a sphere swept onto
# a capsule's side was an impact at t = 2.0081 with the pair still 0.15 apart, from a
# simplex that "enclosed" the origin after a supporting plane had already separated it.
# [measured: collide-lane Decimal oracle sweep, 3.3.4 base bundle and this tree, 2026-10-03; cycc 6.6.14]
var _cyl_mh = hvec3_new(0x3FF2F31340F2F36D, 0x3FFD9FE7085AA8A5, 0x3FE5F75E2A800A58);
var _cyl_mp = hvec3_new(0xC0079349EA02D6AB, 0x400ABFE869DCA563, 0x4003AAE0536D5BEC);
var _cyl_mv = hvec3_new(0x3FE360C1EBE7F7E6, 0xC000D06917456FC5, 0xBFE5CA2EB8067689);
var _cyl_mrc = time_of_impact(&_mpr_sup_box, _mpr_mkbox(0, 0, 0, HVec3_x(_cyl_mh), HVec3_y(_cyl_mh), HVec3_z(_cyl_mh)),
  hvec3_zero(), &_mpr_sup_sphere, hvec4_new(HVec3_x(_cyl_mp), HVec3_y(_cyl_mp), HVec3_z(_cyl_mp), 0x3FE89D8A19FFA33A),
  _cyl_mv, f64_from(10), _cyl_t, _cyl_n);
assert_eq(_cyl_mrc, 1, "time_of_impact: a sphere 0.51 deep into a box edge hits (3.3.4 base: a miss)");
assert_eq(_cyl_judge(_cyl_mrc, _cyl_sd_box(_cyl_mh, hvec3_add(_cyl_mp, hvec3_scale(_cyl_mv, load64(_cyl_t))),
      0x3FE89D8A19FFA33A), _cyl_tol_box(_cyl_mh, 0x3FE89D8A19FFA33A, _cyl_mv)), 0,
  "time_of_impact: ... within the contact tolerance of contact");
var _cyl_ea = hvec3_new(0xBFFA8F5D093F714D, 0x3FEC7F9E51E001B1, 0x3FD8A777EC6EB53A);
var _cyl_ep = hvec3_new(0x3FE6B6A67E3CEF98, 0x400041DAF3B03C00, 0x4015DB82204B0915);
var _cyl_ev = hvec3_new(0xBFE9134513307509, 0xBFEBF2EBBE4AE1AB, 0xC00073E241D68EA8);
var _cyl_erc = time_of_impact(&_r5ga_sup_cap, _r5ga_mkcap(hvec3_zero(), _cyl_ea, 0x3FCC7723B795143D), hvec3_zero(),
  &_mpr_sup_sphere, hvec4_new(HVec3_x(_cyl_ep), HVec3_y(_cyl_ep), HVec3_z(_cyl_ep), 0x3FE872355DDEE526), _cyl_ev,
  f64_from(10), _cyl_t, _cyl_n);
assert_eq(_cyl_judge(_cyl_erc, _cyl_sd_cap(_cyl_ea, 0x3FCC7723B795143D,
      hvec3_add(_cyl_ep, hvec3_scale(_cyl_ev, load64(_cyl_t))), 0x3FE872355DDEE526),
    _cyl_tol_cap(_cyl_ea, 0x3FCC7723B795143D, 0x3FE872355DDEE526, _cyl_ev)), 0,
  "time_of_impact: a sphere onto a capsule's side is a contact within tolerance (3.3.4 base: 0.15 short)");

# === 3.3.3 R4ga: a touch answers with the outward normal, A -> B ===
# ⛔ gjk_epa_3d and mpr_penetration document the outward normal of A (-) B, the one
# along which moving B separates the pair, and write it on their penetration path.
# On a touch (depth 0) both could write the inward one: _epa_touch_probe wrote -n*,
# and gjk_epa_3d's flat-simplex answer had no sign of its own. A point resting on
# the (1, 1, 1) corner of a unit box gave (0, -1, 0) in BOTH operand orders, so one
# of the two was wrong under either convention. Both entry points now turn every
# depth-0 normal outward (_epa_outward), keeping 3.3.2's where A (-) B is flat and
# either sign is outward. Every "3.3.2:" below is the 3.3.2 bundle's answer; a
# zero's sign is incidental where f64_eq reads it.
# [measured: R4ga probes on the 3.3.2 bundle and this tree, 2026-10-01; cycc 6.6.12]
test_group("gjk_epa_3d / mpr_penetration: a touch's normal points from A to B (3.3.3)");
var _r4ga_un = _mpr_mkbox(0, 0, 0, F64_ONE, F64_ONE, F64_ONE);
var _r4ga_cp = _mpr_mkbox(F64_ONE, F64_ONE, F64_ONE, 0, 0, 0);                 # on the corner
var _r4ga_fp = _mpr_mkbox(f64_neg(F64_HALF), F64_ONE, 0, 0, 0, 0);            # on the y = +1 face
var _r4ga_tn = alloc(8);
var _r4ga_td = alloc(8);
fn _r4ga_epa(a, b) {
    store64(_r4ga_tn, 0);
    store64(_r4ga_td, F64_TWO);
    return gjk_epa_3d(&_mpr_sup_box, a, &_mpr_sup_box, b, _r4ga_tn, _r4ga_td);
}
fn _r4ga_mpr(a, b) {
    store64(_r4ga_tn, 0);
    store64(_r4ga_td, F64_TWO);
    return mpr_penetration(&_mpr_sup_box, a, &_mpr_sup_box, b, _r4ga_tn, _r4ga_td);
}
# 1 when the stored normal is exactly +y (sy = 1) or -y (sy = -1) with zero x and z.
fn _r4ga_is_y(sy) {
    var n = load64(_r4ga_tn);
    var want = 0x3FF0000000000000;
    if (sy < 0) { want = 0xBFF0000000000000; }
    if (HVec3_y(n) != want) { return 0; }
    return f64_eq(HVec3_x(n), 0) * f64_eq(HVec3_z(n), 0);
}
# The corner touch. Box first, both entry points settle it in _epa_touch_probe;
# point first, EPA's refinement answers it, outward on 3.3.2 already, and those
# two pins hold that order to the same convention.
assert_eq(_r4ga_epa(_r4ga_un, _r4ga_cp), 1, "gjk_epa_3d: box, then a point on its corner -> touch");
assert_eq(load64(_r4ga_td), 0, "gjk_epa_3d: ... depth +0");
assert_eq(_r4ga_is_y(1), 1, "gjk_epa_3d: ... normal (0, +1, 0), outward of A (-) B (3.3.2: (-0, -1, -0))");
assert_eq(_r4ga_epa(_r4ga_cp, _r4ga_un), 1, "gjk_epa_3d: the point first, then the box -> touch");
assert_eq(_r4ga_is_y(0 - 1), 1, "gjk_epa_3d: ... normal (0, -1, 0), outward, unchanged from 3.3.2");
assert_eq(_r4ga_mpr(_r4ga_un, _r4ga_cp), 1, "mpr_penetration: box, then a point on its corner -> touch");
assert_eq(load64(_r4ga_td), 0, "mpr_penetration: ... depth +0");
assert_eq(_r4ga_is_y(1), 1, "mpr_penetration: ... normal (0, +1, 0) (3.3.2: (-0, -1, -0))");
assert_eq(_r4ga_mpr(_r4ga_cp, _r4ga_un), 1, "mpr_penetration: the point first, then the box -> touch");
assert_eq(_r4ga_is_y(0 - 1), 1, "mpr_penetration: ... normal (0, -1, 0), unchanged from 3.3.2");
# A point on a face. Box first, gjk_epa_3d settles it on its flat-simplex path and
# mpr_penetration in the touch probe; point first, the refinement again.
assert_eq(_r4ga_epa(_r4ga_un, _r4ga_fp), 1, "gjk_epa_3d: box, then a point on its y = +1 face -> touch");
assert_eq(load64(_r4ga_td), 0, "gjk_epa_3d: ... depth +0");
assert_eq(_r4ga_is_y(1), 1, "gjk_epa_3d: ... normal (0, +1, 0) (3.3.2: (0, -1, 0))");
assert_eq(_r4ga_epa(_r4ga_fp, _r4ga_un), 1, "gjk_epa_3d: the face point first -> touch");
assert_eq(_r4ga_is_y(0 - 1), 1, "gjk_epa_3d: ... normal (0, -1, 0), unchanged from 3.3.2");
assert_eq(_r4ga_mpr(_r4ga_un, _r4ga_fp), 1, "mpr_penetration: box, then a point on its y = +1 face -> touch");
assert_eq(_r4ga_is_y(1), 1, "mpr_penetration: ... normal (0, +1, 0) (3.3.2: (0, -1, 0))");
assert_eq(_r4ga_mpr(_r4ga_fp, _r4ga_un), 1, "mpr_penetration: the face point first -> touch");
assert_eq(_r4ga_is_y(0 - 1), 1, "mpr_penetration: ... normal (0, -1, 0), unchanged from 3.3.2");
# Coplanar flat plates: A (-) B is flat, so h(n) = h(-n) = 0 and either sign is
# outward; the tie keeps the normal each entry point gave on 3.3.2 (+z from both).
var _r4ga_pl = _mpr_mkbox(0, 0, 0, F64_ONE, F64_ONE, 0);
var _r4ga_pl2 = _mpr_mkbox(F64_HALF, 0, 0, F64_ONE, F64_ONE, 0);
assert_eq(_r4ga_epa(_r4ga_pl, _r4ga_pl2), 1, "gjk_epa_3d: coplanar flat plates -> touch");
assert_eq(HVec3_z(load64(_r4ga_tn)), 0x3FF0000000000000, "gjk_epa_3d: ... normal z = +1, as on 3.3.2");
assert_eq(_r4ga_mpr(_r4ga_pl, _r4ga_pl2), 1, "mpr_penetration: coplanar flat plates -> touch");
assert_eq(HVec3_z(load64(_r4ga_tn)), 0x3FF0000000000000, "mpr_penetration: ... normal z = +1, as on 3.3.2");

test_group("halfedge_from_triangles: malformed input returns 0, it does not abort");

# Every one of these went straight into vec_get, whose bounds check calls
# _vec_die() -- so the documented "0 on error" was unreachable and the PROCESS
# exited 1 instead. Against the 2.8.2 source this suite dies here.
var hb_short = vec_new();
vec_push(hb_short, 0); vec_push(hb_short, 1); vec_push(hb_short, 2);
assert_eq(halfedge_from_triangles(hb_short, 2, 3), 0,
  "n_tris larger than the supplied triples -> 0 (was: abort)");

var hb_oob = vec_new();
vec_push(hb_oob, 0); vec_push(hb_oob, 1); vec_push(hb_oob, 7);
assert_eq(halfedge_from_triangles(hb_oob, 1, 3), 0,
  "vertex index >= n_verts -> 0 (was: abort)");

var hb_neg = vec_new();
vec_push(hb_neg, 0); vec_push(hb_neg, 0 - 1); vec_push(hb_neg, 2);
assert_eq(halfedge_from_triangles(hb_neg, 1, 3), 0,
  "negative vertex index -> 0 (was: abort)");

var hb_ok = vec_new();
vec_push(hb_ok, 0); vec_push(hb_ok, 1); vec_push(hb_ok, 2);
assert_eq(halfedge_from_triangles(hb_ok, 1, 0), 0,
  "n_verts = 0 with a triangle -> 0 (was: abort)");
assert_eq(halfedge_from_triangles(0, 1, 3), 0, "null triangle vec -> 0");
# And the valid mesh still builds -- the guard must not reject good input.
assert_neq(halfedge_from_triangles(hb_ok, 1, 3), 0, "a well-formed triangle still builds");

test_group("einsum: a repeated OUTPUT label is an error, not a wrong tensor");

# _einsum_compute_element assigns each output axis into label_vals[label], so two
# axes sharing a label overwrite each other and the leading axis wins. "ij->ii"
# on [[1,2],[3,4]] returned [[3,3],[7,7]] -- right shape, wrong tensor, no error.
assert_eq(einsum(str_from("ij->ii"), es_one, 1), 0, "einsum: repeated output label -> 0");
assert_eq(einsum(str_from("ij,jk->ii"), es_two, 2), 0,
  "einsum: repeated output label with two operands -> 0");
assert_eq(einsum(str_from("ij->jj"), es_one, 1), 0, "einsum: repeated output label (jj) -> 0");
# The legal notations are untouched.
assert_neq(einsum(str_from("ij->ji"), es_one, 1), 0, "einsum: transpose still works");
assert_neq(einsum(str_from("ii->"), es_one, 1), 0, "einsum: trace still works");
assert_neq(einsum(str_from("ij,jk->ik"), es_two, 2), 0, "einsum: matmul still works");
# 2.8.3 -- the performance tier of the 2026-08-04 audit
# ================================================================
# Three findings, three different ways of pinning a performance repair
# WITHOUT a timing assertion (timings live in bench-history.csv):
#   spatial_hash  -- the table must size itself to the data, and no chain may
#                    be long; both are structural facts a never-growing 1024
#                    bucket table cannot satisfy.
#   bvh_build     -- arena bytes per primitive must be O(1); the pre-2.8.3
#                    5-blocks-per-merge fold made it O(log n).
#   num_dct/dst   -- the FFT reductions must agree with closed forms at sizes
#                    on BOTH sides of the direct/FFT crossover.

test_group("2.8.3 spatial_hash: the table grows with the data");

# 30,000 points, one per cell, on a STRIDE-4 grid. The stride matters: the
# pre-2.8.3 hash (prime-multiply + XOR, no avalanche) is masked by its LOW
# bits, and ix = 4g forces the bottom two of those to zero, so these 30,000
# cells collapse into 256 buckets of 1024 -- 117-deep chains, and an occupied
# count that can never reach the growth threshold.
var shg = spatial_hash_new(F64_ONE);
for (var shi = 0; shi < 30000; shi = shi + 1) {
    spatial_hash_insert(shg, hvec3_new(f64_from(shi * 4), 0, 0), shi);
}
assert_gte(_sh_bucket_count(shg), 16384, "bucket count grew past its initial 1024");
assert_gt(_sh_occupied(shg), 15000, "stride-4 cells spread over the table, not into 256");
assert_gte(_sh_bucket_count(shg) * 3, _sh_occupied(shg) * 4, "load factor stays under 3/4");

# The actual per-query work bound: the longest chain in the table.
fn _sh_longest_chain(sh) {
    var bk = _sh_buckets(sh);
    var bc = _sh_bucket_count(sh);
    var en = _sh_entries(sh);
    var worst = 0;
    for (var b = 0; b < bc; b = b + 1) {
        var e = load64(bk + b * 8);
        var len = 0;
        while (e >= 0) {
            len = len + 1;
            e = vec_get(en, e * _SH_ENTRY_SIZE + 4);
        }
        if (len > worst) { worst = len; }
    }
    return worst;
}
assert_lte(_sh_longest_chain(shg), 12, "no chain exceeds 12 entries out of 30,000");
assert_eq(vec_len(spatial_hash_query_cell(shg, hvec3_new(f64_from(4 * 777), 0, 0))), 1,
  "every one of the 30,000 cells still answers exactly its own point");

test_group("2.8.3 spatial_hash: brute-force equality, insertion order, clear");

# Ground truth is the DEFINITION of the grid (cell = floor(coord / size)),
# not the previous implementation.
fn _sh_ref_cell(v, inv) { return f64_to(f64_floor(f64_mul(v, inv))); }

fn _sh_ref_query(pts, npts, inv, px, py, pz) {
    var want = vec_new();
    var cx = _sh_ref_cell(px, inv);
    var cy = _sh_ref_cell(py, inv);
    var cz = _sh_ref_cell(pz, inv);
    for (var i = 0; i < npts; i = i + 1) {
        var p = vec_get(pts, i);
        if (_sh_ref_cell(HVec3_x(p), inv) == cx) {
            if (_sh_ref_cell(HVec3_y(p), inv) == cy) {
                if (_sh_ref_cell(HVec3_z(p), inv) == cz) { vec_push(want, i); }
            }
        }
    }
    return want;
}

fn _sh_seq_eq(got, want) {
    if (vec_len(got) != vec_len(want)) { return 0; }
    for (var i = 0; i < vec_len(got); i = i + 1) {
        if (vec_get(got, i) != vec_get(want, i)) { return 0; }
    }
    return 1;
}

# 900 points: a third uniform, a third all coincident, a third on a plane --
# so one table holds a sparse region, a single 300-deep cell and a flat slab.
var shp = vec_new();
_DLR_STATE = 90210;
for (var spi = 0; spi < 300; spi = spi + 1) {
    vec_push(shp, hvec3_new(f64_mul(f64_from(30), _dlr_unit()),
        f64_mul(f64_from(30), _dlr_unit()), f64_mul(f64_from(30), _dlr_unit())));
}
for (var spj = 0; spj < 300; spj = spj + 1) {
    vec_push(shp, hvec3_new(F64_HALF, F64_HALF, F64_HALF));
}
for (var spk = 0; spk < 300; spk = spk + 1) {
    vec_push(shp, hvec3_new(f64_sub(f64_mul(f64_from(20), _dlr_unit()), f64_from(10)),
        f64_mul(f64_from(20), _dlr_unit()), 0));
}
var shb = spatial_hash_new(F64_ONE);
for (var spl = 0; spl < 900; spl = spl + 1) {
    spatial_hash_insert(shb, vec_get(shp, spl), spl);
}
var sh_mismatch = 0;
for (var spm = 0; spm < 900; spm = spm + 1) {
    var sq = vec_get(shp, spm);
    if (_sh_seq_eq(spatial_hash_query_cell(shb, sq),
        _sh_ref_query(shp, 900, F64_ONE, HVec3_x(sq), HVec3_y(sq), HVec3_z(sq))) == 0) {
        sh_mismatch = sh_mismatch + 1;
    }
}
assert_eq(sh_mismatch, 0, "query_cell matches brute force, in insertion order, 900/900");
assert_eq(vec_len(spatial_hash_query_cell(shb, hvec3_new(F64_HALF, F64_HALF, F64_HALF))), 300,
  "the 300 coincident points all come back from one cell");

# clear() then reuse. This is what caught a 16-vs-8 byte bucket stride during
# the repair: the over-wide reset ran off the end of the bucket array and
# corrupted the entry vec's header, so the NEXT insert died in vec_push.
spatial_hash_clear(shb);
assert_eq(vec_len(spatial_hash_query_cell(shb, vec_get(shp, 0))), 0, "clear empties the table");
for (var spn = 0; spn < 900; spn = spn + 1) {
    spatial_hash_insert(shb, vec_get(shp, spn), spn);
}
var sq0 = vec_get(shp, 0);
assert_eq(_sh_seq_eq(spatial_hash_query_cell(shb, sq0),
    _sh_ref_query(shp, 900, F64_ONE, HVec3_x(sq0), HVec3_y(sq0), HVec3_z(sq0))), 1,
  "the table is fully usable after clear()");

# The broadphase contract: query_radius may over-return, never under-return.
var shr = spatial_hash_query_radius(shb, sq0, f64_from(3));
var sh_missing = 0;
var sh_r2 = f64_from(9);
for (var spq = 0; spq < 900; spq = spq + 1) {
    var pq = vec_get(shp, spq);
    var ddx = f64_sub(HVec3_x(pq), HVec3_x(sq0));
    var ddy = f64_sub(HVec3_y(pq), HVec3_y(sq0));
    var ddz = f64_sub(HVec3_z(pq), HVec3_z(sq0));
    var dd = f64_add(f64_add(f64_mul(ddx, ddx), f64_mul(ddy, ddy)), f64_mul(ddz, ddz));
    if (f64_lt(dd, sh_r2) == 1) {
        var seen = 0;
        for (var spr = 0; spr < vec_len(shr); spr = spr + 1) {
            if (vec_get(shr, spr) == spq) { seen = 1; }
        }
        if (seen == 0) { sh_missing = sh_missing + 1; }
    }
}
assert_eq(sh_missing, 0, "query_radius returns every point inside the radius");

test_group("2.8.3 bvh_build: subtree bounds are exact and the arena is O(n)");

# Every internal node's AABB must be the exact componentwise min/max of the
# AABBs of the leaves beneath it, every leaf index must appear exactly once,
# and every leaf must alias its input box. Recomputed from the leaves, so it
# does not trust the fold that built the node.
var _BV_SEEN = 0;
var _BV_BAD = 0;

fn _bv_check(node, aabbs, out) {
    var leaf = _bvh_node_leaf_idx(node);
    var box = _bvh_node_aabb(node);
    if (leaf != 0 - 1) {
        if (box != load64(aabbs + leaf * 8)) { _BV_BAD = _BV_BAD + 1; }
        vec_set(_BV_SEEN, leaf, vec_get(_BV_SEEN, leaf) + 1);
        var mn = GeoAabb_min(box);
        var mx = GeoAabb_max(box);
        store64(out, HVec3_x(mn));
        store64(out + 8, HVec3_y(mn));
        store64(out + 16, HVec3_z(mn));
        store64(out + 24, HVec3_x(mx));
        store64(out + 32, HVec3_y(mx));
        store64(out + 40, HVec3_z(mx));
        return 0;
    }
    var lb = alloc(48);
    var rb = alloc(48);
    _bv_check(_bvh_node_left(node), aabbs, lb);
    _bv_check(_bvh_node_right(node), aabbs, rb);
    for (var k = 0; k < 3; k = k + 1) {
        store64(out + k * 8, f64_min(load64(lb + k * 8), load64(rb + k * 8)));
    }
    for (var k2 = 3; k2 < 6; k2 = k2 + 1) {
        store64(out + k2 * 8, f64_max(load64(lb + k2 * 8), load64(rb + k2 * 8)));
    }
    var nmn = GeoAabb_min(box);
    var nmx = GeoAabb_max(box);
    if (HVec3_x(nmn) != load64(out)) { _BV_BAD = _BV_BAD + 1; }
    if (HVec3_y(nmn) != load64(out + 8)) { _BV_BAD = _BV_BAD + 1; }
    if (HVec3_z(nmn) != load64(out + 16)) { _BV_BAD = _BV_BAD + 1; }
    if (HVec3_x(nmx) != load64(out + 24)) { _BV_BAD = _BV_BAD + 1; }
    if (HVec3_y(nmx) != load64(out + 32)) { _BV_BAD = _BV_BAD + 1; }
    if (HVec3_z(nmx) != load64(out + 40)) { _BV_BAD = _BV_BAD + 1; }
    return 0;
}

# kind 0 uniform, 1 coincident, 2 a 1e-8 cluster, 3 a 1e6:1 strip
fn _bv_boxes(n, kind, seed) {
    _DLR_STATE = seed;
    var arr = alloc(n * 8);
    for (var i = 0; i < n; i = i + 1) {
        var sx = f64_from(1000);
        var sy = sx;
        var sz = sx;
        if (kind == 1) { sx = 0; sy = 0; sz = 0; }
        if (kind == 2) { sx = 0x3E45798EE2308C3A; sy = sx; sz = sx; }
        if (kind == 3) { sx = f64_from(1000000); sy = F64_ONE; sz = F64_ONE; }
        var bx = f64_mul(sx, _dlr_unit());
        var by = f64_mul(sy, _dlr_unit());
        var bz = f64_mul(sz, _dlr_unit());
        store64(arr + i * 8, geo_aabb_new(hvec3_new(bx, by, bz),
            hvec3_new(f64_add(bx, F64_ONE), f64_add(by, F64_ONE), f64_add(bz, F64_ONE))));
    }
    return arr;
}

var bv_total_bad = 0;
for (var bvk = 0; bvk < 4; bvk = bvk + 1) {
    for (var bvs = 0; bvs < 4; bvs = bvs + 1) {
        var bvn = 1;
        if (bvs == 1) { bvn = 2; }
        if (bvs == 2) { bvn = 37; }
        if (bvs == 3) { bvn = 400; }
        var bva = _bv_boxes(bvn, bvk, 700 + bvk * 13 + bvs);
        var bvt = bvh_build(bva, bvn);
        _BV_SEEN = vec_new();
        for (var bvi = 0; bvi < bvn; bvi = bvi + 1) { vec_push(_BV_SEEN, 0); }
        _BV_BAD = 0;
        _bv_check(bvt, bva, alloc(48));
        for (var bvj = 0; bvj < bvn; bvj = bvj + 1) {
            if (vec_get(_BV_SEEN, bvj) != 1) { _BV_BAD = _BV_BAD + 1; }
        }
        bv_total_bad = bv_total_bad + _BV_BAD;
    }
}
assert_eq(bv_total_bad, 0,
  "16 BVHs over 4 input classes x n=1,2,37,400: every node bound exact, every leaf used once");

# ARENA BOUND. Pre-2.8.3 the range-bounds fold allocated FIVE heap blocks per
# merge step and the partition allocated two per item per level, so bytes per
# primitive grew with log n: 1,650 B/prim at n=1000 and 2,288 B/prim at
# n=16000. The rewritten fold is three blocks per internal node, flat at
# 259 B/prim. 700 is loose enough to absorb allocator alignment and tight
# enough that the old fold (1,970 B/prim at n=4000) cannot pass.
var bva4 = _bv_boxes(4000, 0, 31337);
var bv_used0 = alloc_used();
var bvt4 = bvh_build(bva4, 4000);
var bv_bytes = alloc_used() - bv_used0;
assert_neq(bvt4, 0, "bvh_build(4000) returns a tree");
assert_lt(bv_bytes, 700 * 4000, "bvh_build allocates under 700 B per primitive");

test_group("2.9.1 EPA certification rate — the observable six repairs were invisible at");

# WHY THIS EXISTS. The 2.9.0 mutation sweep reverted six separate EPA repairs and
# every one produced BIT-IDENTICAL output, so none could be asserted on. The cause
# is architectural, not accidental: when EPA cannot prove `lo > 0 && strict` it
# leaves `certified` clear and hands the direction to `_epa_polish`, which does not
# depend on the polytope being correct and recovers the same answer. Asserting on
# depth or normal therefore cannot separate "EPA got it right" from "EPA got it
# wrong and the fallback covered" — the fallback is doing its job either way.
#
# The observable is WHICH PATH RAN. These fixtures are ones EPA certifies today, so
# the handoff count is the thing a broken repair moves. It is a RATE assertion, not
# an exact count: the point is to catch a repair that stops EPA certifying, not to
# freeze the current number.
var epc_n = alloc(8);
var epc_d = alloc(8);
var epc_base = _GA_EPA_POLISH_COUNT;
var epc_calls = 0;
var epc_i = 0;
while (epc_i < 12) {
    var epc_off = f64_add(F64_HALF, f64_mul(f64_from(epc_i), 0x3FB999999999999A));
    gjk_epa_3d(&_mpr_sup_box, _mpr_mkbox(0, 0, 0, F64_ONE, F64_ONE, F64_ONE),
      &_mpr_sup_box, _mpr_mkbox(epc_off, F64_HALF, F64_HALF, F64_ONE, F64_ONE, F64_ONE),
      epc_n, epc_d);
    epc_calls = epc_calls + 1;
    epc_i = epc_i + 1;
}
# MEASURED. All 12 of these fall back to _epa_polish through `gjk_epa_3d`.
# [measured: this assertion]
#
# ⚠ 2.9.3 CORRECTION TO WHAT THIS USED TO CONCLUDE. The 2.9.1 text here read the
# [measured: this assertion, and the mpr_penetration one below]
# 12/12 as proof that "EPA's certified exit is never taken", that `_epa_polish`
# is therefore the primary path, and that this explains why six EPA repairs were
# unmutatable. **That inference does not survive measuring the OTHER entry
# point.** `mpr_penetration` computes the same quantity through the same
# `_epa_refine` and takes the CERTIFIED exit on 12 of these same 12 boxes --
# 0 handoffs -- as the assertion below now pins.
#
# So the certified path is not dead code. The real defect is a CERTIFICATION
# ASYMMETRY between two public entry points, and its cause is the SEED, not the
# certificate: `_epa_seed_portal` tries a strictness upgrade (swap v0 for the
# support point opposite the far face, keep it only if the result strictly
# encloses the origin: its PREFER FOUR BOUNDARY POINTS tail) and `_epa_seed_gjk`
# does not, so the portal path arrives certifiable and the GJK path arrives one
# rounding step short.
#
# BOTH candidate repairs were implemented in 2.9.3, measured, and REJECTED:
#   - drop `strict` from the certificate (what the filing proposes): boxes go
#     12 -> 0 fallbacks, but FOUR exact-tangency pairs then report a nonzero
#     depth for a touch whose true depth is 0 -- `_ag_baddepth` goes 0 -> 4. So
#     `lo > 0` alone is NOT the property the certificate needs, and the seed test
#     was load-bearing after all.
#   - give `_epa_seed_gjk` the portal's strictness upgrade: every assertion in
#     this suite passes and boxes go 12 -> 6, but it costs one extra Minkowski
#     support evaluation per seed and measures **+19.4% on gjk_epa_sphere_box**
#     (150.4 us vs 125.6 us, three runs each, non-overlapping) -- for a change
#     that alters no returned answer, since the polish already recovers it.
# [measured: docs/development/issues/archived/2026-08-06-epa-certificate-tests-the-seed-not-the-polytope.md]
#
# The count therefore stays at 12, and this assertion still pins it.
assert_eq(_GA_EPA_POLISH_COUNT - epc_base, epc_calls,
  "gjk_epa_3d certifies NONE of 12 box overlaps -- every call falls back to the polish");
assert_eq(epc_calls, 12, "the box sweep actually ran 12 calls");

test_group("2.18.0 EPA: the seed trade, declined on measurement");

# ⛔ THE SEED-STRICTNESS TRADE IS DECLINED, AND THE REASON IS THE OPPOSITE OF THE
# ONE THE FILING ARGUES. Giving `_epa_seed_gjk` the strictness upgrade
# `_epa_seed_portal` already performs was carried on the roadmap since 2.9.3 as a
# judgement call whose price was unknown (its "+19.4%" was void — the baseline had
# moved 125.6 us -> 78.5 us). Re-measured on the 2.17.0 tree, the price is not the
# cost, it is the ACCURACY:
# [measured: docs/development/issues/archived/2026-08-06-epa-certificate-tests-the-seed-not-the-polytope.md]
#
#   random overlapping spheres, judged against the EXACT closed form
#   depth = ra + rb - |c1 - c2| — no reference implementation, no harness:
#      over this block's own 1200-pair sequence
#         gjk_epa_3d shipped   mean 1.41e-16   worst 5.57e-16   (essentially exact)
#         gjk_epa_3d upgraded  mean 1.70e-14   worst 2.03e-11   <- 36,000x WORSE
#      over a wider 4000-pair sweep, where rarer near-degenerate configurations
#      appear and both arms get harder
#         gjk_epa_3d shipped   mean 3.40e-10   worst 1.32e-06
#         gjk_epa_3d upgraded  mean 2.85e-09   worst 1.14e-05   <- 8.4x worse
# [measured: 1200- and 4000-pair sphere sweeps, shipped vs upgraded, 2026-09-10]
#
# ⭐ THE MECHANISM IS IN THE SOURCE ALREADY. `_epa_polish`'s own comment states
# that the returned depth is `min` over probed directions of `h_M(n)` and every
# `h_M(n) >= ` the true MTV, so the polish "can only lower an upper bound" —
# monotone. Certifying is an EARLY-OUT that skips it. The filing's premise is that
# certifying is the better state; it is the worse one, and the polish is what was
# delivering the accuracy all along.
# ⚠ Two of the filing's four claims are also false as written: it says "every
# assertion in the suite passes" (the box-fallback assertion above fails — 12 -> 6)
# and "it alters no returned answer" (measured, it alters them, for the worse).
# ⭐ This assertion is the tripwire: it passes on the shipped tree and fails on the
# upgraded one, so the trade cannot be taken by accident.
# [measured: upgrade installed, two assertions fail; reverted byte-identical]
var _ES_N = 0;
var _ES_SEED = 12345;
var _ES_GWORST = 0;
fn _es_rnd() {
    _ES_SEED = (_ES_SEED * 1103515245 + 12345) & 0x7FFFFFFF;
    return _ES_SEED;
}
fn _es_frnd() { return f64_div(f64_from(_es_rnd() % 1000000), f64_from(1000000)); }
for (var _es_i = 0; _es_i < 1200; _es_i = _es_i + 1) {
    var _es_ra = f64_add(F64_ONE, _es_frnd());
    var _es_rb = f64_add(F64_ONE, _es_frnd());
    var _es_ox = f64_mul(f64_sub(_es_frnd(), F64_HALF), F64_TWO);
    var _es_oy = f64_mul(f64_sub(_es_frnd(), F64_HALF), F64_TWO);
    var _es_oz = f64_mul(f64_sub(_es_frnd(), F64_HALF), F64_TWO);
    var _es_d = hvec3_length(hvec3_new(_es_ox, _es_oy, _es_oz));
    if (f64_gt(_es_d, 0) == 1) {
        var _es_truth = f64_sub(f64_add(_es_ra, _es_rb), _es_d);
        if (f64_gt(_es_truth, 0x3FB999999999999A) == 1) {
            var _es_A = hvec4_new(0, 0, 0, _es_ra);
            var _es_B = hvec4_new(_es_ox, _es_oy, _es_oz, _es_rb);
            var _es_n = alloc(8);
            var _es_dp = alloc(8);
            store64(_es_n, 0);
            store64(_es_dp, 0);
            if (gjk_epa_3d(&_mpr_sup_sphere, _es_A, &_mpr_sup_sphere, _es_B,
                _es_n, _es_dp) == 1) {
                var _es_e = f64_abs(f64_div(f64_sub(load64(_es_dp), _es_truth), _es_truth));
                _ES_N = _ES_N + 1;
                if (f64_gt(_es_e, _ES_GWORST) == 1) { _ES_GWORST = _es_e; }
            }
        }
    }
}
assert(_ES_N > 1000, "the EPA sphere-accuracy sweep actually ran (over 1000 overlapping pairs)");
# ⚠ THE BOUND IS TIED TO THIS EXACT 1200-ITERATION SEQUENCE and is derived from
# both arms of the measurement: 1e-12 sits ~1800x above the shipped worst
# (5.57e-16) and ~20x below the upgraded worst (2.03e-11). ⛔ Do NOT change the
# loop count without re-deriving it — at 4000 pairs the shipped worst is 1.32e-06,
# because rarer near-degenerate configurations enter the sequence. A bound copied
# across sample sizes here would be wrong by nine orders of magnitude.
# [measured: both arms at 1200 and at 4000 pairs, 2026-09-10]
assert(f64_lt(_ES_GWORST, 0x3D719799812DEA11) == 1,
  "gjk_epa_3d: depth is within 1e-12 of the exact sphere formula on this sequence");

# ⛔ 2.19.0 — TWO PUBLIC ENTRY POINTS COMPUTING THE SAME QUANTITY DISAGREED BY
# 1.65e-05, AND NOTHING IN THIS SUITE COULD SEE IT. `_ag_mprpen` above compares
# the two entry points' RETURN CODES; no assertion anywhere compared their
# DEPTHS. Measured against the exact closed form `ra + rb - |c1 - c2|` over 1200
# random overlapping sphere pairs: `gjk_epa_3d` worst **5.57e-16**,
# `mpr_penetration` worst **1.65e-05** — roughly 10^10 apart, on geometry whose
# answer is one line of algebra.
# ⭐ THE CAUSE IS THE POLISH BUDGET, AND IT IS ARITHMETIC. `_epa_polish` starts at
# 0.25 rad and breaks when its step falls under EPSILON_F64, which takes 38
# halvings; every round that MOVES spends budget without halving, so a cap of 64
# left at most 26 moving rounds. `mpr_penetration` reaches the refinement through
# the PORTAL seed, which starts further out, so it was the one running out of
# budget — it was returning while still walking, not because it had converged.
# ⚠ TWO HYPOTHESES WERE REFUTED BY MEASUREMENT BEFORE THIS ONE SURVIVED, and both
# had been written down as likely:
#   (a) "the portal builds v0 from the +x axis, so the error is orientation
#       dependent" — REFUTED. Swapping which axis carries the large offset
#       component leaves the error IDENTICAL (3.167e-04 both ways), and counting
#       outliers per orientation bucket gives 2/1/1/2/1 across the range. The
#       10^5 difference in bucket MEANS that suggested it was one outlier landing
#       in one bucket: **the mean of a heavy-tailed sample is not a correlation.**
#   (b) "mpr certifies more often, and certifying skips the polish" — REFUTED.
#       Both entry points take the polish on every one of these cases.
# [measured: 4000-pair sweep, axis swap, per-bucket outlier counts, polish counters]
var _MP_RUN = 0;
var _MP_BADG = 0;
var _MP_BADM = 0;
var _MP_SEED = 12345;
fn _mp_rnd() {
    _MP_SEED = (_MP_SEED * 1103515245 + 12345) & 0x7FFFFFFF;
    return _MP_SEED;
}
fn _mp_frnd() { return f64_div(f64_from(_mp_rnd() % 1000000), f64_from(1000000)); }
for (var _mp_i = 0; _mp_i < 1200; _mp_i = _mp_i + 1) {
    var _mp_ra = f64_add(F64_ONE, _mp_frnd());
    var _mp_rb = f64_add(F64_ONE, _mp_frnd());
    var _mp_ox = f64_mul(f64_sub(_mp_frnd(), F64_HALF), F64_TWO);
    var _mp_oy = f64_mul(f64_sub(_mp_frnd(), F64_HALF), F64_TWO);
    var _mp_oz = f64_mul(f64_sub(_mp_frnd(), F64_HALF), F64_TWO);
    var _mp_d = hvec3_length(hvec3_new(_mp_ox, _mp_oy, _mp_oz));
    if (f64_gt(_mp_d, 0) == 1) {
        var _mp_t = f64_sub(f64_add(_mp_ra, _mp_rb), _mp_d);
        if (f64_gt(_mp_t, 0x3FB999999999999A) == 1) {
            var _mp_A = hvec4_new(0, 0, 0, _mp_ra);
            var _mp_B = hvec4_new(_mp_ox, _mp_oy, _mp_oz, _mp_rb);
            var _mp_gn = alloc(8);
            var _mp_gd = alloc(8);
            store64(_mp_gd, 0);
            var _mp_mn = alloc(8);
            var _mp_md = alloc(8);
            store64(_mp_md, 0);
            _MP_RUN = _MP_RUN + 1;
            if (gjk_epa_3d(&_mpr_sup_sphere, _mp_A, &_mpr_sup_sphere, _mp_B,
                _mp_gn, _mp_gd) == 1) {
                if (f64_gt(f64_abs(f64_div(f64_sub(load64(_mp_gd), _mp_t), _mp_t)),
                    0x3D06849B86A12B9B) == 1) { _MP_BADG = _MP_BADG + 1; }
            }
            if (mpr_penetration(&_mpr_sup_sphere, _mp_A, &_mpr_sup_sphere, _mp_B,
                _mp_mn, _mp_md) == 1) {
                if (f64_gt(f64_abs(f64_div(f64_sub(load64(_mp_md), _mp_t), _mp_t)),
                    0x3D06849B86A12B9B) == 1) { _MP_BADM = _MP_BADM + 1; }
            }
        }
    }
}
assert(_MP_RUN > 1000, "the two-entry-point sphere sweep actually ran over 1000 pairs");
assert_eq(_MP_BADG, 0,
  "gjk_epa_3d: depth within 1e-14 of the exact sphere formula at every pair");
assert_eq(_MP_BADM, 0,
  "mpr_penetration: the same — it was 1.65e-05 out until the polish budget was derived");

# ⚠ ONE MUTANT SURVIVES AND IT IS A HEADROOM CHOICE, NOT A THRESHOLD. A budget of
# **96** also passes every pair here, so 128 is not the smallest sufficient value
# and no assertion can make it look like one. What IS derived is the floor: 38 of
# the rounds are mandatory halvings (0.25 rad down to EPSILON_F64), so a cap of 64
# leaves at most 26 for moves and provably cannot finish a search that needs more.
# 96 leaves 58 and 128 leaves 90; the corpus needs somewhere between 27 and 58,
# and 128 is that measurement plus roughly half again. A tighter cap would be
# fitting the constant to this fixture. [measured: 4-mutant run, 2026-09-10]

# The half the 2.9.1 measurement never took, and the reason its conclusion did
# not hold. Same 12 boxes, same refinement, the OTHER public entry point.
# [measured: this assertion]
var epc_mp = _GA_EPA_POLISH_COUNT;
var epc_mi = 0;
while (epc_mi < 12) {
    var epc_moff = f64_add(F64_HALF, f64_mul(f64_from(epc_mi), 0x3FB999999999999A));
    mpr_penetration(&_mpr_sup_box, _mpr_mkbox(0, 0, 0, F64_ONE, F64_ONE, F64_ONE),
      &_mpr_sup_box, _mpr_mkbox(epc_moff, F64_HALF, F64_HALF, F64_ONE, F64_ONE, F64_ONE),
      epc_n, epc_d);
    epc_mi = epc_mi + 1;
}
assert_eq(_GA_EPA_POLISH_COUNT - epc_mp, 0,
  "mpr_penetration certifies ALL 12 -- its portal seed is strict by construction");

var epc_b2 = _GA_EPA_POLISH_COUNT;
var epc_j = 0;
while (epc_j < 12) {
    var epc_r = f64_add(F64_ONE, f64_mul(f64_from(epc_j), 0x3FB999999999999A));
    gjk_epa_3d(&_mpr_sup_sphere, hvec4_new(0, 0, 0, f64_from(2)),
      &_mpr_sup_sphere, hvec4_new(epc_r, 0, 0, f64_from(2)), epc_n, epc_d);
    epc_j = epc_j + 1;
}
assert_eq(_GA_EPA_POLISH_COUNT - epc_b2, 12,
  "EPA certifies NONE of 12 sphere overlaps either -- not a box-only artefact");

# The counter must be able to STAY PUT, or the two assertions above would pass
# on a counter that simply increments unconditionally. A separated pair returns
# before _epa_refine and must not touch it.
var epc_b3 = _GA_EPA_POLISH_COUNT;
gjk_epa_3d(&_mpr_sup_sphere, hvec4_new(0, 0, 0, F64_ONE),
  &_mpr_sup_sphere, hvec4_new(f64_from(9), 0, 0, F64_ONE), epc_n, epc_d);
assert_eq(_GA_EPA_POLISH_COUNT - epc_b3, 0,
  "a separated pair never reaches the polish -- the counter is not unconditional");

test_group("2.9.1 _col_dl_ic_g1: the on-line tie-break is betweenness, not the M^1 form");

# The reproducer from the exact-rational sweep. p is the MIDPOINT of ab, so it is
# strictly between a and b and the truth is 1. The pre-2.9.1 M^1 expression
# factored as |b|^2*(u x a) - |a|^2*(u x b), which vanishes identically when the
# edge is parallel to u_k -- here u_0 = (1,2) and b - a = (-2,-4) = -2*u_0 -- so
# it returned 0. Measured: 228 wrong of 463,086 CCW-presented triples, REACHABLE
# input. The replacement is dot(a - p, b - p) < 0, which needs no ghost direction.
#
# 2.9.3 re-based this fixture. It used to hold only a and b, so points[0] WAS a.
# That was harmless while g1 ignored points[0], but g1 now falls back to the
# apex for the winding when the edge is parallel to u_k -- which is exactly this
# configuration -- and an apex sitting on a vertex of its own edge makes all
# three points collinear for every M. The exact oracle returns NO ANSWER there
# (the circumcircle does not exist), so the old fixture was asserting a value on
# an ill-posed input and only passed because the old code could not see it.
# points[0] is now a real apex off line(a, b), which is what delaunay_2d always
# supplies. The expected value is unchanged and does not depend on which side
# the apex is on: p is the midpoint of segment ab, so it is strictly inside ANY
# circle through a and b, and the branch that decides it is betweenness, which
# takes no winding at all. Verified in exact rationals over four apexes
# (26, 8, -4, 28 for (b - a) x (A - a)): truth = 1 in all four.
var g1_pts = vec_new();
vec_push(g1_pts, hvec2_new(f64_from(5), F64_ONE));                   # apex A = (5, 1)
vec_push(g1_pts, hvec2_new(f64_neg(F64_TWO), 0));                    # a = (-2, 0)
vec_push(g1_pts, hvec2_new(f64_neg(f64_from(4)), f64_neg(f64_from(4))));  # b = (-4,-4)
assert_eq(_col_dl_ic_g1(g1_pts, 1, 2, 0, f64_neg(f64_from(3)), f64_neg(F64_TWO)), 1,
  "g1: p is the midpoint of an edge parallel to u_0 -> inside (was 0)");
# And the doubly-degenerate case the old fixture accidentally encoded: apex ON
# line(a, b) as well as the edge parallel to u_0, so there is no circle at all.
# 0 is a convention, but it must be a STABLE one -- both orderings agree.
var g1_deg = vec_new();
vec_push(g1_deg, hvec2_new(f64_neg(F64_TWO), 0));                    # apex == a
vec_push(g1_deg, hvec2_new(f64_neg(F64_TWO), 0));                    # a = (-2, 0)
vec_push(g1_deg, hvec2_new(f64_neg(f64_from(4)), f64_neg(f64_from(4))));  # b = (-4,-4)
assert_eq(_col_dl_ic_g1(g1_deg, 1, 2, 0, f64_neg(f64_from(3)), f64_neg(F64_TWO)),
  _col_dl_ic_g1(g1_deg, 2, 1, 0, f64_neg(f64_from(3)), f64_neg(F64_TWO)),
  "g1: with no circumcircle at all, both orderings still agree");

# The two cases the old form also could not separate: lambda*(lambda-1) > 0 holds
# for lambda > 1 as well as lambda < 0, so "beyond b on the same ray" scored the
# same as "between". Betweenness separates them.
assert_eq(_col_dl_ic_g1(g1_pts, 1, 2, 0, f64_neg(F64_ONE), F64_TWO), 0,
  "g1: p on the line but OUTSIDE the segment -> not inside");
assert_eq(_col_dl_ic_g1(g1_pts, 1, 2, 0, f64_neg(f64_from(6)), f64_neg(f64_from(8))), 0,
  "g1: p beyond b on the same ray -> not inside");

# p coinciding with an endpoint is a duplicate point, not an interior hit.
assert_eq(_col_dl_ic_g1(g1_pts, 1, 2, 0, f64_neg(F64_TWO), 0), 0,
  "g1: p == a is a duplicate, not inside");
assert_eq(_col_dl_ic_g1(g1_pts, 1, 2, 0, f64_neg(f64_from(4)), f64_neg(f64_from(4))), 0,
  "g1: p == b is a duplicate, not inside");

# The fix must not depend on which ghost direction is passed -- betweenness is a
# property of the three points alone. All three ghosts must agree.
assert_eq(_col_dl_ic_g1(g1_pts, 1, 2, 1, f64_neg(f64_from(3)), f64_neg(F64_TWO)), 1,
  "g1: same answer under ghost 1 (the answer cannot depend on u_k)");
assert_eq(_col_dl_ic_g1(g1_pts, 1, 2, 2, f64_neg(f64_from(3)), f64_neg(F64_TWO)), 1,
  "g1: same answer under ghost 2");

test_group("2.9.1 _col_dl_ic_g3: the all-ghost answer is the constant 1, both windings");

# The predicate takes NO ARGUMENTS because the answer does not depend on any of
# them. Asserting the bare call pins that directly: a reader who sees a geometric
# predicate that ignores its inputs would otherwise suspect a stub.
assert_eq(_col_dl_ic_g3(), 1, "g3: the all-ghost in-circle answer is the constant 1");

# Both windings, through the public entry point. The CYCLIC half is all any
# delaunay_2d fixture can reach -- every triangle is stored CCW and the entry
# point's three rotations are even -- so through 2.9.1 it was the only half ever
# run, and it was also the only half the shipped `orient(u) > 0` body got right.
# The ANTI-CYCLIC half is the other half of the input space and the one that was
# wrong for EVERY point in the plane.
test_group("2.9.3 delaunay_2d on WIDE INTRA-SET DYNAMIC RANGE (exact winding)");

# 2026-08-04-incircle-precision.md was recommended for closure in 2.9.1 on the
# ground that "nothing can hand it that input". That was wrong, and the reason it
# looked right is instructive: the 0-of-1,528,820 sweep behind it enumerated
# [measured: CHANGELOG.md 2.9.1 section]
# quadruples of four fixtures that ALL draw from a single origin-anchored box
# (`_dlr_points`, defined near the top of this file), so the family had no
# intra-set spread ratio and structurally could not reach this failure.
#
# Absolute magnitude is not the problem -- translating a whole set out to 1e9 is
# fine, Sterbenz differencing handles it. RATIO WITHIN ONE SET is. One vertex at
# ~6e5 with five points inside ~5e-17 of the origin makes the winding term's two
# subtractions round to the same double, so two distinct points become one.
#
# THE ORACLE HERE IS DELIBERATELY NOT `_dl_violations` (near the top of this
# file): that helper calls `_col_in_circumcircle` to decide whether a
# circumcircle is empty, i.e. it uses the code under test as its own oracle and
# is blind to a sign flip by construction -- which is half of why this survived
# three releases. `_dl_used`
# and `_dl_max_edge_share` are purely STRUCTURAL and evaluate no predicate.
# Coordinates are literal bit patterns so the fixture is reproducible
# bit-for-bit rather than regenerated from an RNG.
#
# Exact convex hull of these six points, in rationals, has h = 4, so a correct
# triangulation has 2n - 2 - h = 6 triangles. Pre-2.9.3: 4 triangles, and one
# input point missing from the output entirely.
var icp = vec_new();
# [measured: this fixture; hull and counts re-derived in exact rationals]
vec_push(icp, hvec2_new(0x4122_9CE2_D5D6_E212, 0x4127_8907_29BF_24A1));
vec_push(icp, hvec2_new(0x3C8E_24E8_BBBE_CC94, 0xBC5C_7CF2_DE23_7A70));
vec_push(icp, hvec2_new(0xBC5C_8956_4E5D_FCA0, 0x3C80_D342_FFE4_0540));
vec_push(icp, hvec2_new(0x3C88_267B_1B35_CD8E, 0x3C47_9EEC_3C48_9E00));
vec_push(icp, hvec2_new(0xBC7B_7473_90E5_40E4, 0x3C82_D0D7_239D_1858));
vec_push(icp, hvec2_new(0xBC68_8A23_88FE_A9B8, 0x3C6A_FCD4_4D14_CF88));
var ict = delaunay_2d(icp, 6);
assert_eq(_dl_used(6, ict), 6,
  "wide dynamic range: every input point appears in the output (pre-2.9.3 dropped one)");
assert_eq(_dl_max_edge_share(ict), 2,
  "wide dynamic range: manifold -- no edge shared by 3+ triangles");
assert_eq(vec_len(ict) / 3, 6,
  "wide dynamic range: 2n-2-h = 6 triangles from the exact rational hull (pre-2.9.3 gave 4)");

# The predicate itself, on the triple whose float winding is exactly 0.0 while
# the true determinant is -5.457401e-11. This is the unit-level statement of the
# same defect, and it is what an exact-determinant-of-rounded-differences repair
# still gets wrong -- that variant was implemented, measured, and rejected.
# [measured: docs/development/issues/archived/2026-08-04-incircle-precision.md]
assert_eq(_col_orient2d_sign(0x4117_D816_0244_6781, 0x4101_8DAA_C0BF_0023,
    0xBC9C_8FCD_CFA2_462D, 0xBC99_B388_F731_3522,
    0x3C75_CB11_925B_C2D8, 0x3C9B_1503_87C2_0688), 0 - 1,
  "orient2d: clockwise, where the float determinant is exactly 0.0");
assert_eq(_col_orient2d_sign(0, 0, F64_ONE, 0, 0, F64_ONE), 1,
  "orient2d: an ordinary CCW triangle still takes the fast path");
assert_eq(_col_orient2d_sign(0, 0, 0, F64_ONE, F64_ONE, 0), 0 - 1,
  "orient2d: an ordinary CW triangle");
assert_eq(_col_orient2d_sign(0, 0, F64_ONE, F64_ONE, F64_TWO, F64_TWO), 0,
  "orient2d: exactly collinear is 0, not a rounding artefact");

test_group("2.9.3 _col_point_in_tri is BOUNDARY-INCLUSIVE, as ear clipping needs");

# Its doc comment claimed "(2D, strict interior)" until 2.9.3 and was false: an
# edge point makes that edge's signed area exactly 0, which sets neither
# has_neg nor has_pos, so "all signs agree" holds and it returns 1. The code is
# right -- ear clipping must not cut an ear when another vertex lies ON its
# boundary -- so only the contract was wrong. Pinned here so the next reader who
# trusts a comment over the code is contradicted by a test instead.
# Triangle (0,0) (4,0) (0,4).
var pit_z = 0;
var pit_4 = f64_from(4);
assert_eq(_col_point_in_tri(F64_ONE, F64_ONE, pit_z, pit_z, pit_4, pit_z, pit_z, pit_4), 1,
  "point_in_tri: strict interior -> 1");
assert_eq(_col_point_in_tri(F64_TWO, pit_z, pit_z, pit_z, pit_4, pit_z, pit_z, pit_4), 1,
  "point_in_tri: ON an edge -> 1 (INCLUSIVE, not strict)");
assert_eq(_col_point_in_tri(pit_z, pit_z, pit_z, pit_z, pit_4, pit_z, pit_z, pit_4), 1,
  "point_in_tri: exactly ON a vertex -> 1");
assert_eq(_col_point_in_tri(f64_from(3), f64_from(3), pit_z, pit_z, pit_4, pit_z, pit_z, pit_4), 0,
  "point_in_tri: strictly outside -> 0");
assert_eq(_col_point_in_tri(f64_neg(F64_ONE), F64_ONE, pit_z, pit_z, pit_4, pit_z, pit_z, pit_4), 0,
  "point_in_tri: outside past an edge -> 0");

test_group("2.9.3 _col_dl_ic_g1: the one-ghost answer is order-free");

# The last open half of docs/development/issues/archived/2026-08-06-ghost-incircle-g1-g3-assume-ccw.md,
# closed here in 2.9.3. g2 was made order-free in 2.9.1 and g3 became the
# constant 1; g1 was the only helper still reading the triple's winding out of
# the CCW storage convention instead of forming it. Until 2.9.3 the whole entry point was therefore
# CCW-only, and the evidence for that was a Python transcription rather than an
# assertion in this suite. It is an assertion now.
_dlg1_run();
assert_eq(_DLG1_PROBES, 1800,
  "g1: probe grid ran (4 edges x 25 query points x 3 ghost directions x 6 orderings)");
assert_eq(_DLG1_BAD, 0,
  "g1: all six orderings of a one-ghost triple agree (pre-2.9.3 the anti-cyclic three inverted)");
assert_gt(_DLG1_TIE, 0,
  "g1: the grid actually reaches the (b - a) x u_k == 0 case, so the fix cannot ignore it");

# ⚠ The grid above asserts ORDER-CONSISTENCY, and consistency alone is too weak
# for the apex fallback: negating the fallback's sign flips every ordering
# together, so the six still agree and the grid stays green -- that mutant
# survived the grid, and the four assertions below are what killed it.
# [measured: scratch mutation run, not reproducible in-tree]
# To re-run it: negate the apex fallback in _col_dl_ic_g1 and run this suite;
# _DLG1_BAD stays 0 while the four assertions below go red. It is the same weakness the g3 harness records
# below, and it needs the same answer: a CORRECTNESS assertion against a truth
# derived independently.
#
# Edge a = (0,0), b = (2,4) is parallel to u_0 = (1,2), so the ghost direction
# cannot supply the winding and the apex must. Two apexes on OPPOSITE sides of
# line(a, b) must give OPPOSITE answers for the same query point -- that is the
# whole content of the fallback, and no single-sided fixture can state it.
# Truths from the exact circumcircle of {a, b, A + 1e30*u_0} in Fractions:
#   A = ( 5, 1), (b-a)x(A-a) = -18:  p=(3,1) -> 1   p=(-3,1) -> 0
#   A = (-5, 1), (b-a)x(A-a) = +22:  p=(3,1) -> 0   p=(-3,1) -> 1
var g1_apr = vec_new();
vec_push(g1_apr, hvec2_new(f64_from(5), F64_ONE));        # apex right of ab
vec_push(g1_apr, hvec2_new(0, 0));                        # a
vec_push(g1_apr, hvec2_new(F64_TWO, f64_from(4)));        # b
assert_eq(_col_dl_ic_g1(g1_apr, 1, 2, 0, f64_from(3), F64_ONE), 1,
  "g1: edge parallel to u_0, apex right of it -> p=(3,1) is inside");
assert_eq(_col_dl_ic_g1(g1_apr, 1, 2, 0, f64_neg(f64_from(3)), F64_ONE), 0,
  "g1: edge parallel to u_0, apex right of it -> p=(-3,1) is outside");

var g1_apl = vec_new();
vec_push(g1_apl, hvec2_new(f64_neg(f64_from(5)), F64_ONE));   # apex LEFT of ab
vec_push(g1_apl, hvec2_new(0, 0));
vec_push(g1_apl, hvec2_new(F64_TWO, f64_from(4)));
assert_eq(_col_dl_ic_g1(g1_apl, 1, 2, 0, f64_from(3), F64_ONE), 0,
  "g1: same edge, apex on the OTHER side -> p=(3,1) flips to outside");
assert_eq(_col_dl_ic_g1(g1_apl, 1, 2, 0, f64_neg(f64_from(3)), F64_ONE), 1,
  "g1: same edge, apex on the OTHER side -> p=(-3,1) flips to inside");

_dlg3_run();
assert_eq(_DLG3_PROBES, 1800,
  "g3: probe grid ran (4 scales x 3 apexes x 25 query points x 6 orderings)");
assert_eq(_DLG3_BAD_CYC, 0,
  "g3: every CYCLIC ordering answers inside, at every scale");
assert_eq(_DLG3_BAD_ANTI, 0,
  "g3: every ANTI-CYCLIC ordering answers inside too (2.9.1 answered 0 for all of them)");

# Spot checks naming the two orderings explicitly, so a failure reads as a
# winding bug rather than as a grid-plumbing bug. nr = 1, so the ghosts are 1, 2
# and 3 and the apex is the single real point.
var g3_pts = vec_new();
vec_push(g3_pts, hvec2_new(0, 0));
assert_eq(_col_dl_incircle(g3_pts, 1, 1, 2, 3, F64_ONE, F64_ONE), 1,
  "g3: (G0, G1, G2) -- cyclic, CCW -- is inside");
assert_eq(_col_dl_incircle(g3_pts, 1, 1, 3, 2, F64_ONE, F64_ONE), 1,
  "g3: (G0, G2, G1) -- anti-cyclic, CW -- is the SAME question, so also inside");

# The apex itself, and a point 1e18 out: no finite bound on p exists, because M
# is symbolic. Both must answer inside under both windings.
assert_eq(_col_dl_incircle(g3_pts, 1, 1, 2, 3, 0, 0), 1,
  "g3: p at the apex is inside (cyclic)");
assert_eq(_col_dl_incircle(g3_pts, 1, 3, 2, 1, 0, 0), 1,
  "g3: p at the apex is inside (anti-cyclic)");
var g3_far = f64_mul(f64_from(1000000000), f64_from(1000000000));
assert_eq(_col_dl_incircle(g3_pts, 1, 2, 3, 1, g3_far, f64_neg(g3_far)), 1,
  "g3: p at 1e18 is still inside (cyclic) -- M is unbounded, so p cannot outrun it");
assert_eq(_col_dl_incircle(g3_pts, 1, 2, 1, 3, g3_far, f64_neg(g3_far)), 1,
  "g3: p at 1e18 is still inside (anti-cyclic)");

test_group("2.8.4 _numx_use_fft: the dispatch decision itself");

# The gate is a DECISION FUNCTION, and until 2.8.4 nothing asserted what it
# decides -- only that both paths compute the right answer, which stays true
# whichever one runs. So a mispick was invisible: it cost time and changed no
# result. These pin the four decisions 2.8.4 corrected, measured by forcing both
# paths and timing them, plus the three that must NOT move.
#
# 1 = take the DFT reduction, 0 = take the direct double loop.
# DST-I passes post = 0 (its post-pass is a negate and a halve); DCT-II and its
# inverse pass post = 2 (a cos and a sin twiddle per bin).
# The percentages in these messages are 2.8.4's, timed on cycc 6.5.6.
# [measured: CHANGELOG.md 2.8.4 section]
assert_eq(_numx_use_fft(7, 16, 0), 1, "dst n=7: FFT (was direct; 2.8.4 measured FFT 20.6% faster)");
assert_eq(_numx_use_fft(26, 26, 2), 0, "dct n=26: direct (was FFT; 2.8.4 measured direct 11% faster)");
assert_eq(_numx_use_fft(38, 38, 2), 0, "dct n=38: direct (was FFT; 2.8.4 measured direct 8.2% faster)");
assert_eq(_numx_use_fft(39, 39, 2), 0,
  "dct n=39: direct (was FFT; 2.8.4 measured direct 2.6% faster -- a near-tie the other way on 6.6.12)");

# The bounds are load-bearing, not incidental. n=40 is the size that a 1/8
# surcharge instead of 1/10 would wrongly flip -- 2.8.4 measured the FFT faster
# there (66486 ns vs 67340 ns). n=27 was 2.8.4's acknowledged residual, a 3%
# mispick kept rather than papered over, because widening the fit to catch it
# drags correctly-picked sizes across.
# [measured: 2.8.4 scratch harness, not reproducible in-tree, 2026-08-05; cycc 6.5.6]
#
# Re-timed on cycc 6.6.12 with both DCT paths forced: n = 26, 38 and 40 still
# pick the faster path, by 3.9-10.9%. n = 27's FFT pick and n = 39's direct pick
# are each now within 2% of the other path, and usually the slower of the two:
# mispicks of about 1%. n = 39, which 2.8.4 moved to direct, now runs marginally
# slower there than the FFT would.
# [measured: scratch harness, both DCT paths forced, 9 passes, not reproducible in-tree, 2026-10-01; cycc 6.6.12]
# The model was not refit; these pins assert its DECISIONS, not timings. See
# _numx_use_fft's comment in src/num_ext.cyr for the 6.6.12 re-timing.
assert_eq(_numx_use_fft(40, 40, 2), 1, "dct n=40: still FFT -- 1/10 surcharge, not 1/8");
assert_eq(_numx_use_fft(27, 27, 2), 1,
  "dct n=27: still FFT -- 2.8.4's 3% residual mispick, about 1% or less on 6.6.12");

# The headline sizes sit far above the crossover (margins 7.1x and 158.4x) and
# were never the gate's problem. 2.8.4 must not have moved them.
assert_eq(_numx_use_fft(1024, 2050, 0), 1, "dst n=1024: FFT (Bluestein), unchanged");
assert_eq(_numx_use_fft(1024, 1024, 2), 1, "dct n=1024: FFT (radix-2), unchanged");

test_group("2.8.3 num_dct / num_dst: closed forms on both sides of the crossover");

# Sizes chosen to hit every dispatch branch: 8 and 16 are direct (DST) or
# radix-2 FFT (DCT); 15 makes DST's 2(n+1) a power of two; 17 and 100 force
# Bluestein; 128 and 256 are the large radix-2 path.
fn _tx_sizes(i) {
    if (i == 0) { return 8; }
    if (i == 1) { return 15; }
    if (i == 2) { return 16; }
    if (i == 3) { return 17; }
    if (i == 4) { return 100; }
    if (i == 5) { return 128; }
    return 256;
}

var tx_bad_const = 0;
var tx_bad_delta = 0;
var tx_bad_rt = 0;
var tx_bad_inv = 0;
for (var txi = 0; txi < 7; txi = txi + 1) {
    var tn = _tx_sizes(txi);

    # (1) DCT-II of a constant c: X[0] = n*c exactly, X[k>0] = 0 exactly.
    var tc = alloc(tn * 8);
    for (var t1 = 0; t1 < tn; t1 = t1 + 1) { store64(tc + t1 * 8, F64_TWO); }
    var _ri3t, _ri3v = num_dct(tc, tn);
    if (is_err_result(_ri3t) == 1) { tx_bad_const = tx_bad_const + 1; }
    if (f64_approx_eq(load64(tc), f64_from(2 * tn), LOOSE_TOL_M) == 0) {
        tx_bad_const = tx_bad_const + 1;
    }
    for (var t2 = 1; t2 < tn; t2 = t2 + 1) {
        if (f64_approx_eq(load64(tc + t2 * 8), 0, LOOSE_TOL_M) == 0) {
            tx_bad_const = tx_bad_const + 1;
        }
    }

    # (2) DCT-II of e_j reads off column j: X[k] = cos(PI (2j+1) k / (2n)).
    var tj = tn / 3;
    var td = alloc(tn * 8);
    for (var t3 = 0; t3 < tn; t3 = t3 + 1) { store64(td + t3 * 8, 0); }
    store64(td + tj * 8, F64_ONE);
    var _ri4t, _ri4v = num_dct(td, tn);
    if (is_err_result(_ri4t) == 1) { tx_bad_delta = tx_bad_delta + 1; }
    for (var t4 = 0; t4 < tn; t4 = t4 + 1) {
        var ang = f64_div(f64_mul(F64_PI, f64_from((2 * tj + 1) * t4)), f64_from(2 * tn));
        if (f64_approx_eq(load64(td + t4 * 8), f64_cos(ang), LOOSE_TOL_M) == 0) {
            tx_bad_delta = tx_bad_delta + 1;
        }
    }

    # (3) round trips: idct(dct(x)) == x and idst(dst(x)) == x
    var tx = alloc(tn * 8);
    var tk = alloc(tn * 8);
    _DLR_STATE = 5150 + tn;
    for (var t5 = 0; t5 < tn; t5 = t5 + 1) {
        var tv = f64_sub(_dlr_unit(), F64_HALF);
        store64(tx + t5 * 8, tv);
        store64(tk + t5 * 8, tv);
    }
    var _r19t, _r19v = num_dct(tx, tn);
    var _r20t, _r20v = num_idct(tx, tn);
    for (var t6 = 0; t6 < tn; t6 = t6 + 1) {
        if (f64_approx_eq(load64(tx + t6 * 8), load64(tk + t6 * 8), LOOSE_TOL_M) == 0) {
            tx_bad_rt = tx_bad_rt + 1;
        }
    }
    for (var t7 = 0; t7 < tn; t7 = t7 + 1) { store64(tx + t7 * 8, load64(tk + t7 * 8)); }
    var _r21t, _r21v = num_dst(tx, tn);
    var _r22t, _r22v = num_idst(tx, tn);
    for (var t8 = 0; t8 < tn; t8 = t8 + 1) {
        if (f64_approx_eq(load64(tx + t8 * 8), load64(tk + t8 * 8), LOOSE_TOL_M) == 0) {
            tx_bad_rt = tx_bad_rt + 1;
        }
    }

    # (4) DST-I is a symmetric involution: S^2 = ((n+1)/2) I. Unlike the round
    # trip above this does NOT go through num_idst, so a scale error in the
    # forward transform cannot cancel itself out.
    for (var t9 = 0; t9 < tn; t9 = t9 + 1) { store64(tx + t9 * 8, load64(tk + t9 * 8)); }
    var _r23t, _r23v = num_dst(tx, tn);
    var _r24t, _r24v = num_dst(tx, tn);
    var thalf = f64_mul(f64_from(tn + 1), F64_HALF);
    for (var ta = 0; ta < tn; ta = ta + 1) {
        if (f64_approx_eq(load64(tx + ta * 8),
            f64_mul(thalf, load64(tk + ta * 8)), LOOSE_TOL_M) == 0) {
            tx_bad_inv = tx_bad_inv + 1;
        }
    }
}
assert_eq(tx_bad_const, 0, "DCT-II of a constant is n*c at k=0 and 0 elsewhere, 7 sizes");
assert_eq(tx_bad_delta, 0, "DCT-II of e_j is column j of the cosine kernel, 7 sizes");
assert_eq(tx_bad_rt, 0, "idct(dct(x)) and idst(dst(x)) round-trip, 7 sizes");
assert_eq(tx_bad_inv, 0, "dst(dst(x)) == ((n+1)/2) x -- DST-I is an involution, 7 sizes");
var _rq103t, _rq103v = num_dct(alloc(8), 0);
assert_eq(is_err_result(_rq103t), 1, "num_dct(n=0) still rejects");
assert_eq(_rq103v, HSB_ERR_INVALID_INPUT, "num_dct(n=0) still rejects");
var _rq104t, _rq104v = num_idct(alloc(8), 0);
assert_eq(is_err_result(_rq104t), 1, "num_idct(n=0) still rejects");
assert_eq(_rq104v, HSB_ERR_INVALID_INPUT, "num_idct(n=0) still rejects");
var _rq105t, _rq105v = num_idst(alloc(8), 0);
assert_eq(is_err_result(_rq105t), 1, "num_idst(n=0) still rejects");
assert_eq(_rq105v, HSB_ERR_INVALID_INPUT, "num_idst(n=0) still rejects");
# NOISE — the four generators had no assertion that any of them computes
# anything (2.8.3)
# ================================================================
test_group("noise: perlin_2d / perlin_3d / simplex_2d / simplex_3d");

# Every noise assertion in the tree through 2.8.2 was of the form
# `|noise(p)| < 1` or `noise(p) == noise(p)` at a single point, plus the fBm
# NaN guards. Replacing the body of any of the four with `return 0;` satisfies
# all of them: 0 is bounded by 1, deterministic, and not NaN. That is roughly
# 320 lines of lattice hashing, skew/unskew, fade curves and gradient tables
# certified by nothing.
#
# Two independent things are checked below.
#
# (1) STRUCTURAL IDENTITIES that follow from the definition of gradient noise
#     and hold for no constant function. They are exact, so they carry no
#     tolerance argument at all.
# (2) VALUES, cross-checked against a reference implementation in python3
#     (Perlin's 2002 "Improving Noise" for the fade curve and permutation;
#     for simplex, see below). The permutation table in src/calc.cyr was
#     separately diffed against Perlin's published 256-entry table: identical,
#     and a genuine permutation of 0..255. Agreement is bit-exact for perlin_2d
#     and perlin_3d at every point and aggregate below.
#     ⛔ 3.3.3 — THE SIMPLEX ROWS WERE RE-DERIVED when src/noise_simplex.cyr's corner
#     offsets and 3D falloff were repaired (its header). The simplex half of the
#     reference was rewritten from the listing in Gustavson's "Simplex noise
#     demystified" -- corner offsets x0 - i1 + G2, x0 - 1 + 2*G2 (3D + G3, + 2*G3,
#     - 1 + 3*G3), G2 = (3 - sqrt(3))/6 and F3 = 1/3, G3 = 1/6 as he computes them
#     -- plus only the departures that header lists: the 8-direction 2D gradient,
#     the nested corner hashing, the 0.5 3D falloff and the 76.75 3D scale, F2
#     correctly rounded, the falloff formed as 0.5 - (x^2 + y^2 [+ z^2]), strict
#     3D ordering tests. It reproduces src bit for bit at every simplex point and
#     aggregate below and at 4500 more points along three lines. Of those rounding-
#     level departures only the falloff grouping moves a value pinned here, by up
#     to 5 ulp. The reference shares the departures, so it pins hisab's values; it
#     does not certify the listing's.
#     [measured: scratch reference vs the repaired bundle, not reproducible in-tree, 2026-10-01; cycc 6.6.12]
#     Through 3.3.2 the simplex reference shared src's subtracted corner offsets,
#     its rows sat within 1e-14 rather than bit-exact -- up to 19 ulp
#     (simplex_3d(1.25, 2.5, 3.75)), where this comment said "at most 3 ulp" -- and
#     the comment blamed "associativity in the corner-offset expressions", but
#     x0 + (-i1) and x0 - i1 are one IEEE operation; the 3 ulp at simplex_2d(0.1,
#     0.2) was the falloff grouping. Through 3.3.1 it said the whole reference was
#     "NOT transcribed from src/".
#     [measured: scratch reference vs the 3.3.2 bundle, not reproducible in-tree, 2026-10-01; cycc 6.6.12]

# --- (1a) Gradient noise vanishes exactly at its lattice points. At integer
# (x, y) the fractional offsets are 0, the fade weights are 0, and the surviving
# corner contributes grad . (0, 0) == 0. Not a tolerance: exactly zero.
assert_eq(perlin_2d(f64_from(3), f64_from(5)), 0, "perlin_2d == 0 exactly at a lattice point");
# ⚠ perlin_3d's surviving corner here takes a NEGATED gradient component, so its zero
# is -0.0 since cyrius 6.6.8 (IEEE `f64_neg`); still exactly zero, compared as a value.
assert_eq(f64_eq(perlin_3d(F64_TWO, f64_from(7), f64_from(4)), 0), 1,
  "perlin_3d == 0 exactly at a lattice point (it is -0.0)");
# Simplex noise vanishes at the origin of the skewed lattice for the same
# reason: the near corner contributes grad . 0, and the other corners lie outside
# the 0.5 falloff, at squared distances 2/3, 2/3 (2D) and 3/4, 1, 3/4 (3D). (Through
# 3.3.2 the 3D falloff was 0.6 and the corner offsets were wrong; header of
# src/noise_simplex.cyr.)
assert_eq(simplex_2d(0, 0), 0, "simplex_2d(0,0) == 0 exactly");
assert_eq(simplex_3d(0, 0, 0), 0, "simplex_3d(0,0,0) == 0 exactly");

# --- (1b) CELL-CENTRE QUANTISATION. fade(1/2) = 6/32 - 15/16 + 10/8 = 1/2
# exactly, and at a cell centre every corner offset is (+-1/2, +-1/2), so each
# 2D gradient dot product is exactly one of {-1, 0, +1}. The two nested lerps at
# weight 1/2 then make perlin_2d(i+1/2, j+1/2) an exact multiple of 1/4 in
# [-1, 1] -- in dyadic arithmetic, with no rounding anywhere. In 3D the eight
# corners and three lerps make it an exact multiple of 1/8.
#
# The histogram of those quantised values over a block of cells is a fingerprint
# of the entire pipeline (permutation table, corner hashing, gradient selection
# and the fade curve at once). Both histograms below were produced by the
# independent reference and match src bin for bin.
var _nz_hp = alloc(7 * 8);
var _nz_i = 0;
while (_nz_i < 7) { store64(_nz_hp + _nz_i * 8, 0); _nz_i = _nz_i + 1; }
var _nz_bad = 0;
var _nz_oob = 0;
_nz_i = 0;
while (_nz_i < 16) {
    var _nz_j = 0;
    while (_nz_j < 16) {
        var _nz_v = perlin_2d(f64_add(f64_from(_nz_i), F64_HALF),
          f64_add(f64_from(_nz_j), F64_HALF));
        var _nz_q = f64_mul(_nz_v, f64_from(4));
        var _nz_n = f64_to(f64_round(_nz_q));
        if (f64_lt(f64_abs(f64_sub(_nz_q, f64_from(_nz_n))), TOL_1EM12) == 0) {
            _nz_bad = _nz_bad + 1;
        }
        if (_nz_n < 0 - 3 || _nz_n > 3) {
            _nz_oob = _nz_oob + 1;
        } else {
            store64(_nz_hp + (_nz_n + 3) * 8, load64(_nz_hp + (_nz_n + 3) * 8) + 1);
        }
        _nz_j = _nz_j + 1;
    }
    _nz_i = _nz_i + 1;
}
assert_eq(_nz_bad, 0, "perlin_2d: all 256 cell centres are exact multiples of 1/4");
assert_eq(_nz_oob, 0, "perlin_2d: all 256 cell centres lie in [-3/4, 3/4]");
assert_eq(load64(_nz_hp), 7, "perlin_2d cell-centre histogram: 4v = -3 occurs 7x");
assert_eq(load64(_nz_hp + 8), 25, "perlin_2d cell-centre histogram: 4v = -2 occurs 25x");
assert_eq(load64(_nz_hp + 16), 62, "perlin_2d cell-centre histogram: 4v = -1 occurs 62x");
assert_eq(load64(_nz_hp + 24), 67, "perlin_2d cell-centre histogram: 4v = 0 occurs 67x");
assert_eq(load64(_nz_hp + 32), 62, "perlin_2d cell-centre histogram: 4v = +1 occurs 62x");
assert_eq(load64(_nz_hp + 40), 22, "perlin_2d cell-centre histogram: 4v = +2 occurs 22x");
assert_eq(load64(_nz_hp + 48), 11, "perlin_2d cell-centre histogram: 4v = +3 occurs 11x");

var _nz_hq = alloc(12 * 8);
_nz_i = 0;
while (_nz_i < 12) { store64(_nz_hq + _nz_i * 8, 0); _nz_i = _nz_i + 1; }
var _nz_bad3 = 0;
var _nz_oob3 = 0;
_nz_i = 0;
while (_nz_i < 8) {
    var _nz_j3 = 0;
    while (_nz_j3 < 8) {
        var _nz_k3 = 0;
        while (_nz_k3 < 8) {
            var _nz_v3 = perlin_3d(f64_add(f64_from(_nz_i), F64_HALF),
              f64_add(f64_from(_nz_j3), F64_HALF), f64_add(f64_from(_nz_k3), F64_HALF));
            var _nz_q3 = f64_mul(_nz_v3, f64_from(8));
            var _nz_n3 = f64_to(f64_round(_nz_q3));
            if (f64_lt(f64_abs(f64_sub(_nz_q3, f64_from(_nz_n3))), TOL_1EM12) == 0) {
                _nz_bad3 = _nz_bad3 + 1;
            }
            if (_nz_n3 < 0 - 6 || _nz_n3 > 5) {
                _nz_oob3 = _nz_oob3 + 1;
            } else {
                store64(_nz_hq + (_nz_n3 + 6) * 8, load64(_nz_hq + (_nz_n3 + 6) * 8) + 1);
            }
            _nz_k3 = _nz_k3 + 1;
        }
        _nz_j3 = _nz_j3 + 1;
    }
    _nz_i = _nz_i + 1;
}
assert_eq(_nz_bad3, 0, "perlin_3d: all 512 cell centres are exact multiples of 1/8");
assert_eq(_nz_oob3, 0, "perlin_3d: all 512 cell centres lie in [-6/8, 5/8]");
assert_eq(load64(_nz_hq), 1, "perlin_3d cell-centre histogram: 8v = -6 occurs 1x");
assert_eq(load64(_nz_hq + 8), 3, "perlin_3d cell-centre histogram: 8v = -5 occurs 3x");
assert_eq(load64(_nz_hq + 16), 8, "perlin_3d cell-centre histogram: 8v = -4 occurs 8x");
assert_eq(load64(_nz_hq + 24), 39, "perlin_3d cell-centre histogram: 8v = -3 occurs 39x");
assert_eq(load64(_nz_hq + 32), 65, "perlin_3d cell-centre histogram: 8v = -2 occurs 65x");
assert_eq(load64(_nz_hq + 40), 93, "perlin_3d cell-centre histogram: 8v = -1 occurs 93x");
assert_eq(load64(_nz_hq + 48), 85, "perlin_3d cell-centre histogram: 8v = 0 occurs 85x");
assert_eq(load64(_nz_hq + 56), 105, "perlin_3d cell-centre histogram: 8v = +1 occurs 105x");
assert_eq(load64(_nz_hq + 64), 67, "perlin_3d cell-centre histogram: 8v = +2 occurs 67x");
assert_eq(load64(_nz_hq + 72), 32, "perlin_3d cell-centre histogram: 8v = +3 occurs 32x");
assert_eq(load64(_nz_hq + 80), 10, "perlin_3d cell-centre histogram: 8v = +4 occurs 10x");
assert_eq(load64(_nz_hq + 88), 4, "perlin_3d cell-centre histogram: 8v = +5 occurs 4x");

# --- (2) POINT VALUES against the independent reference.
var _nz_p1 = f64_div(F64_ONE, f64_from(10));                   # 0.1
var _nz_p2 = f64_div(F64_ONE, f64_from(5));                    # 0.2
var _nz_p3 = f64_div(f64_from(3), f64_from(10));               # 0.3
var _nz_a = f64_div(f64_from(13), f64_from(4));                # 3.25
var _nz_b = f64_div(f64_from(31), f64_from(4));                # 7.75
var _nz_c = f64_div(f64_from(5), f64_from(4));                 # 1.25
var _nz_d = f64_div(f64_from(5), F64_TWO);                     # 2.5
var _nz_e = f64_div(f64_from(15), f64_from(4));                # 3.75
assert_eq(perlin_2d(_nz_a, _nz_b), 0xBFD8B07000000000,
  "perlin_2d(3.25, 7.75) == -0.38576889038085938 (bit-exact vs reference)");
assert_eq(perlin_2d(_nz_p1, _nz_p2), 0x3FC32F725475690A,
  "perlin_2d(0.1, 0.2) == 0.14988545536000003 (bit-exact vs reference)");
assert_eq(perlin_3d(_nz_p1, _nz_p2, _nz_p3), 0x3FD2B8E731B20FE7,
  "perlin_3d(0.1, 0.2, 0.3) == 0.29253558972436483 (bit-exact vs reference)");
assert_eq(perlin_3d(_nz_c, _nz_d, _nz_e), 0x3FD8AF9000000000,
  "perlin_3d(1.25, 2.5, 3.75) == 0.38571548461914062 (bit-exact vs reference)");
# Simplex is bit-exact against the 3.3.3 reference (above). Through 3.3.2 these four
# were pinned within 1e-14 at 0.28704375, 0.040777547611840624, 0.42983577599999989
# and -0.0086881687242801 -- the discontinuous field's values.
assert_eq(simplex_2d(_nz_p1, _nz_p2), 0x3FD142435C763B5B,
  "simplex_2d(0.1, 0.2) == 0.26966938046910166 (bit-exact vs reference)");
assert_eq(simplex_2d(f64_div(f64_from(25), F64_TWO), f64_div(F64_ONE, f64_from(8))), 0x3FD8921338625B28,
  "simplex_2d(12.5, 0.125) == 0.38391571527738444 (bit-exact vs reference)");
assert_eq(simplex_3d(_nz_p1, _nz_p2, _nz_p3), 0x3FDF701831CA4CBA,
  "simplex_3d(0.1, 0.2, 0.3) == 0.49121670591666666 (bit-exact vs reference)");
assert_eq(simplex_3d(_nz_c, _nz_d, _nz_e), 0x3FD8159555555566,
  "simplex_3d(1.25, 2.5, 3.75) == 0.37631734212239676 (bit-exact vs reference)");

# --- (2b) AGGREGATES over a 40x40 grid at step 1/4 (2D) and a 12x12x12 grid
# (3D), so 1600 / 1728 samples are folded into each number. The L1 mass is the
# statement that the generator produces SIGNAL: `return 0;` gives 0 where the
# reference gives 369.35 / 631.21 / 363.05 / 512.10 (simplex 252.12 / 236.59 through
# 3.3.2). max|v| is the amplitude,
# and 3/4 is exact for both Perlin variants (the largest reachable convex
# combination of gradient dots). The rigorous convex-combination bound on
# perlin_2d over a cell is 1.0, so the < 1 range claim in the doc is proved,
# not sampled.
var _nz_step = f64_div(F64_ONE, f64_from(4));
var _nz_eps = f64_div(F64_ONE, f64_from(1024));
var _nz_l1p = 0;
var _nz_l1s = 0;
var _nz_mxp = 0;
var _nz_mxs = 0;
var _nz_cp = 0;
var _nz_cs = 0;
_nz_i = 0;
while (_nz_i < 40) {
    var _nz_jj = 0;
    while (_nz_jj < 40) {
        var _nz_x = f64_mul(f64_from(_nz_i), _nz_step);
        var _nz_y = f64_mul(f64_from(_nz_jj), _nz_step);
        var _nz_vp = perlin_2d(_nz_x, _nz_y);
        var _nz_vs = simplex_2d(_nz_x, _nz_y);
        _nz_l1p = f64_add(_nz_l1p, f64_abs(_nz_vp));
        _nz_l1s = f64_add(_nz_l1s, f64_abs(_nz_vs));
        if (f64_gt(f64_abs(_nz_vp), _nz_mxp) == 1) { _nz_mxp = f64_abs(_nz_vp); }
        if (f64_gt(f64_abs(_nz_vs), _nz_mxs) == 1) { _nz_mxs = f64_abs(_nz_vs); }
        var _nz_dp = f64_abs(f64_sub(perlin_2d(f64_add(_nz_x, _nz_eps), _nz_y), _nz_vp));
        var _nz_ds = f64_abs(f64_sub(simplex_2d(f64_add(_nz_x, _nz_eps), _nz_y), _nz_vs));
        if (f64_gt(_nz_dp, _nz_cp) == 1) { _nz_cp = _nz_dp; }
        if (f64_gt(_nz_ds, _nz_cs) == 1) { _nz_cs = _nz_ds; }
        _nz_jj = _nz_jj + 1;
    }
    _nz_i = _nz_i + 1;
}
# ⛔ 3.3.3 — THE TWO PERLIN L1 MASSES (THIS ONE AND perlin_3d's BELOW) SAID "bit-exact"
# AND COMPARED WITHIN 1e-9, through a `_nz_tol9`. Both sums equal the reference's
# doubles to the bit -- on this quarter grid the samples are short dyadic fractions,
# and both sums end in a run of zero mantissa bits -- so they are now compared on the
# bits, as the messages said. The tolerance let either drift by up to 1e-9 unseen:
# scaling perlin_2d's (or perlin_3d's) output by 1 + 2^-52 moves its sum by one ulp,
# which the 1e-9 compare passed and these fail.
# [measured: scratch probe of the 3.3.2 bundle, scratch mutants on the 3.3.3 tree, cycc 6.6.12, 2026-10-01]
assert_eq(_nz_l1p, 0x407715A274000000,
  "perlin_2d: L1 mass over 1600 samples == 369.3521614074707 (reference, bit-exact)");
assert_eq(_nz_l1s, 0x4083B9AD684A1F50,
  "simplex_2d: L1 mass over 1600 samples == 631.2096715727621 (reference, bit-exact)");
assert_eq(_nz_mxp, 0x3FE8000000000000, "perlin_2d: max|v| over the grid == 3/4 exactly");
assert_eq(_nz_mxs, 0x3FEFEE9DB34ACCB3,
  "simplex_2d: max|v| over the grid == 0.9978779317665584 (reference, bit-exact)");
# Continuity: Perlin gradient noise is C^2, so a 1/1024 step can never move the
# value far. A hash-scrambled or mis-indexed lattice shows up here as a
# discontinuity even when the amplitude statistics still look plausible.
# Measured maxima: 0.00269 / 0.00629 (simplex 0.00427 through 3.3.2).
# [measured: scratch rerun of this loop, not reproducible in-tree, 2026-10-01; cycc 6.6.12]
# ⚠ For simplex this proves less than it reads: no step here lands on a simplex
# boundary, so it passed through 3.3.2, when simplex_2d and simplex_3d jumped there
# (src/noise_simplex.cyr's header). Through 3.3.1 this comment said simplex is C^1
# across its falloff boundary. The 3.3.3 block after this group reads the field
# on both sides of points ON the boundaries.
var _nz_c01 = 0x3F847AE147AE147B;                              # 0.01
assert(f64_lt(_nz_cp, _nz_c01) == 1, "perlin_2d: no jump > 0.01 across a 1/1024 step");
assert(f64_lt(_nz_cs, _nz_c01) == 1, "simplex_2d: no jump > 0.01 across a 1/1024 step");
# Rigorous bound: |perlin_2d| is a convex combination of four gradient dots
# whose supremum over the cell is exactly 1.
assert(f64_lt(_nz_mxp, F64_ONE) == 1, "perlin_2d: inside the analytic bound of 1");
assert(f64_lt(_nz_mxs, F64_ONE) == 1, "simplex_2d: inside the documented [-1, 1] range");

var _nz_l1p3 = 0;
var _nz_l1s3 = 0;
var _nz_mxp3 = 0;
var _nz_mxs3 = 0;
var _nz_cp3 = 0;
var _nz_cs3 = 0;
_nz_i = 0;
while (_nz_i < 12) {
    var _nz_j5 = 0;
    while (_nz_j5 < 12) {
        var _nz_k5 = 0;
        while (_nz_k5 < 12) {
            var _nz_x3 = f64_mul(f64_from(_nz_i), _nz_step);
            var _nz_y3 = f64_mul(f64_from(_nz_j5), _nz_step);
            var _nz_z3 = f64_mul(f64_from(_nz_k5), _nz_step);
            var _nz_w = perlin_3d(_nz_x3, _nz_y3, _nz_z3);
            var _nz_u = simplex_3d(_nz_x3, _nz_y3, _nz_z3);
            _nz_l1p3 = f64_add(_nz_l1p3, f64_abs(_nz_w));
            _nz_l1s3 = f64_add(_nz_l1s3, f64_abs(_nz_u));
            if (f64_gt(f64_abs(_nz_w), _nz_mxp3) == 1) { _nz_mxp3 = f64_abs(_nz_w); }
            if (f64_gt(f64_abs(_nz_u), _nz_mxs3) == 1) { _nz_mxs3 = f64_abs(_nz_u); }
            var _nz_e3 = f64_abs(f64_sub(perlin_3d(f64_add(_nz_x3, _nz_eps), _nz_y3, _nz_z3),
                _nz_w));
            var _nz_e4 = f64_abs(f64_sub(simplex_3d(f64_add(_nz_x3, _nz_eps), _nz_y3, _nz_z3),
                _nz_u));
            if (f64_gt(_nz_e3, _nz_cp3) == 1) { _nz_cp3 = _nz_e3; }
            if (f64_gt(_nz_e4, _nz_cs3) == 1) { _nz_cs3 = _nz_e4; }
            _nz_k5 = _nz_k5 + 1;
        }
        _nz_j5 = _nz_j5 + 1;
    }
    _nz_i = _nz_i + 1;
}
assert_eq(_nz_l1p3, 0x4076B0C2DDE20000,
  "perlin_3d: L1 mass over 1728 samples == 363.04757488518953 (reference, bit-exact)");
assert_eq(_nz_l1s3, 0x408000CDFFB425E9,
  "simplex_3d: L1 mass over 1728 samples == 512.1005853723592 (reference, bit-exact)");
assert_eq(_nz_mxp3, 0x3FE8000000000000, "perlin_3d: max|v| over the grid == 3/4 exactly");
assert_eq(_nz_mxs3, 0x3FEDFE32AAAAAAAB,
  "simplex_3d: max|v| over the grid == 0.937280019124349 (reference, bit-exact)");
assert(f64_lt(_nz_cp3, _nz_c01) == 1, "perlin_3d: no jump > 0.01 across a 1/1024 step");
assert(f64_lt(_nz_cs3, _nz_c01) == 1, "simplex_3d: no jump > 0.01 across a 1/1024 step");
assert(f64_lt(_nz_mxp3, F64_ONE) == 1, "perlin_3d: inside the analytic bound of 1");
assert(f64_lt(_nz_mxs3, F64_ONE) == 1, "simplex_3d: inside the documented [-1, 1] range");

# === 3.3.3 G5: simplex continuity across simplex boundaries, and the range ===
# ⛔ 3.3.3 — THROUGH 3.3.2 BOTH SIMPLEX FIELDS JUMPED WHERE THE CONTAINING SIMPLEX
# CHANGED (src/noise_simplex.cyr's header), and nothing above could see it: the
# 1/1024 step on a 1/4 grid never lands on a boundary. Every pair here straddles one.
# A pair is built in skewed lattice coordinates (a, b[, c]) ON a boundary -- a cell
# face a = n or b = m (or c = l), or a plane frac(a) = frac(b) (in 3D also b/c and
# a/c) where the corner ordering flips -- moved 2^-30 to either side, and unskewed
# with the module's own G2 / G3. The cells run from -100 to 99 and the fractions are
# the full-mantissa frac(k * 0.618...) and frac(k * 0.754...): 3 x 32 pairs in 2D,
# 6 x 32 in 3D. A pair's points are at most 2.6e-9 apart, and the repaired fields move
# at most 1.58e-8 (2D) / 1.70e-8 (3D) across one -- inside their largest slope
# (|grad| 7.33 / 6.96) times that distance -- so the 1e-6 bound has a 58x margin. The
# 3.3.2 code broke it at 64 of the 96 2D pairs, by up to 0.70, and at 96 of the 192
# 3D pairs, by up to 1.03.
# [measured: scratch straddle probe, 3.3.2 vs repaired bundle, not reproducible in-tree, 2026-10-01; cycc 6.6.12]
#
# A sweep proves only what it reaches: _sxc_sid_2d / _sxc_sid_3d recompute the
# simplex each point lands in (the skew, floor and corner-ordering tests, with the
# module's F2 / G2 / F3 / G3), and the counts assert that every pair straddles a
# boundary. _SXC_BAD2 / _SXC_BAD3 count the pairs NOT inside the bound, so a NaN
# counts against it.
test_group("noise_simplex: continuous across simplex boundaries (3.3.3)");
var _SXC_DEL = 0x3E10000000000000;                             # 2^-30
var _SXC_PHI = 0x3FE3C6EF372FE950;                             # 0.6180339887498949
var _SXC_RHO = 0x3FE827F5352054C6;                             # 0.7548776662466927
var _SXC_LIP = 0x3EB0C6F7A0B5ED8D;                             # 1e-6
var _SXC_BAD2 = 0;
var _SXC_CROSS2 = 0;
var _SXC_BAD3 = 0;
var _SXC_CROSS3 = 0;

# The simplex simplex_2d puts (x, y) in: skewed cell (i, j) and the x0 > y0 test.
fn _sxc_sid_2d(x, y) {
    var s = f64_mul(f64_add(x, y), _SIMPLEX_F2);
    var i_f = f64_floor(f64_add(x, s));
    var j_f = f64_floor(f64_add(y, s));
    var t = f64_mul(f64_add(i_f, j_f), _SIMPLEX_G2);
    var lo = f64_gt(f64_sub(x, f64_sub(i_f, t)), f64_sub(y, f64_sub(j_f, t)));
    return ((f64_to(i_f) + 512) * 1024 + (f64_to(j_f) + 512)) * 2 + lo;
}

# The simplex simplex_3d puts (x, y, z) in: skewed cell (i, j, k) and the three
# ordering tests that pick the tetrahedron.
fn _sxc_sid_3d(x, y, z) {
    var s = f64_mul(f64_add(f64_add(x, y), z), _SIMPLEX_F3);
    var i_f = f64_floor(f64_add(x, s));
    var j_f = f64_floor(f64_add(y, s));
    var k_f = f64_floor(f64_add(z, s));
    var t = f64_mul(f64_add(f64_add(i_f, j_f), k_f), _SIMPLEX_G3);
    var x0 = f64_sub(x, f64_sub(i_f, t));
    var y0 = f64_sub(y, f64_sub(j_f, t));
    var z0 = f64_sub(z, f64_sub(k_f, t));
    var o = f64_gt(x0, y0) * 4 + f64_gt(y0, z0) * 2 + f64_gt(x0, z0);
    var c = ((f64_to(i_f) + 512) * 1024 + (f64_to(j_f) + 512)) * 1024 + (f64_to(k_f) + 512);
    return c * 8 + o;
}

# One straddle: skewed (a0, b0) and (a1, b1), unskewed, the field read at both.
fn _sxc_pair_2d(a0, b0, a1, b1) {
    var t0 = f64_mul(f64_add(a0, b0), _SIMPLEX_G2);
    var x0 = f64_sub(a0, t0);
    var y0 = f64_sub(b0, t0);
    var t1 = f64_mul(f64_add(a1, b1), _SIMPLEX_G2);
    var x1 = f64_sub(a1, t1);
    var y1 = f64_sub(b1, t1);
    var d = f64_abs(f64_sub(simplex_2d(x1, y1), simplex_2d(x0, y0)));
    if (f64_lt(d, _SXC_LIP) == 0) { _SXC_BAD2 = _SXC_BAD2 + 1; }
    if (_sxc_sid_2d(x0, y0) != _sxc_sid_2d(x1, y1)) { _SXC_CROSS2 = _SXC_CROSS2 + 1; }
    return 0;
}

fn _sxc_pair_3d(a0, b0, c0, a1, b1, c1) {
    var t0 = f64_mul(f64_add(f64_add(a0, b0), c0), _SIMPLEX_G3);
    var x0 = f64_sub(a0, t0);
    var y0 = f64_sub(b0, t0);
    var z0 = f64_sub(c0, t0);
    var t1 = f64_mul(f64_add(f64_add(a1, b1), c1), _SIMPLEX_G3);
    var x1 = f64_sub(a1, t1);
    var y1 = f64_sub(b1, t1);
    var z1 = f64_sub(c1, t1);
    var d = f64_abs(f64_sub(simplex_3d(x1, y1, z1), simplex_3d(x0, y0, z0)));
    if (f64_lt(d, _SXC_LIP) == 0) { _SXC_BAD3 = _SXC_BAD3 + 1; }
    if (_sxc_sid_3d(x0, y0, z0) != _sxc_sid_3d(x1, y1, z1)) { _SXC_CROSS3 = _SXC_CROSS3 + 1; }
    return 0;
}

var _sxc_k = 0;
while (_sxc_k < 32) {
    var _sxc_f = f64_mul(f64_from(_sxc_k + 1), _SXC_PHI);
    _sxc_f = f64_sub(_sxc_f, f64_floor(_sxc_f));
    var _sxc_g = f64_mul(f64_from(_sxc_k + 1), _SXC_RHO);
    _sxc_g = f64_sub(_sxc_g, f64_floor(_sxc_g));
    var _sxc_n = f64_from((_sxc_k * 37) % 200 - 100);
    var _sxc_m = f64_from((_sxc_k * 59) % 200 - 100);
    var _sxc_l = f64_from((_sxc_k * 83) % 200 - 100);
    var _sxc_nf = f64_add(_sxc_n, _sxc_f);
    var _sxc_mf = f64_add(_sxc_m, _sxc_f);
    var _sxc_lf = f64_add(_sxc_l, _sxc_f);
    var _sxc_ng = f64_add(_sxc_n, _sxc_g);
    var _sxc_mg = f64_add(_sxc_m, _sxc_g);
    var _sxc_lg = f64_add(_sxc_l, _sxc_g);
    var _sxc_nlo = f64_sub(_sxc_n, _SXC_DEL);
    var _sxc_nhi = f64_add(_sxc_n, _SXC_DEL);
    var _sxc_mlo = f64_sub(_sxc_m, _SXC_DEL);
    var _sxc_mhi = f64_add(_sxc_m, _SXC_DEL);
    var _sxc_llo = f64_sub(_sxc_l, _SXC_DEL);
    var _sxc_lhi = f64_add(_sxc_l, _SXC_DEL);
    var _sxc_nflo = f64_sub(_sxc_nf, _SXC_DEL);
    var _sxc_nfhi = f64_add(_sxc_nf, _SXC_DEL);
    var _sxc_mflo = f64_sub(_sxc_mf, _SXC_DEL);
    var _sxc_mfhi = f64_add(_sxc_mf, _SXC_DEL);
    var _sxc_lflo = f64_sub(_sxc_lf, _SXC_DEL);
    var _sxc_lfhi = f64_add(_sxc_lf, _SXC_DEL);
    # 2D: the cell faces a = n and b = m, and the plane frac(a) = frac(b)
    _sxc_pair_2d(_sxc_nlo, _sxc_mf, _sxc_nhi, _sxc_mf);
    _sxc_pair_2d(_sxc_nf, _sxc_mlo, _sxc_nf, _sxc_mhi);
    _sxc_pair_2d(_sxc_nfhi, _sxc_mflo, _sxc_nflo, _sxc_mfhi);
    # 3D: the cell faces a = n, b = m, c = l, and the planes a/b, b/c, a/c
    _sxc_pair_3d(_sxc_nlo, _sxc_mf, _sxc_lg, _sxc_nhi, _sxc_mf, _sxc_lg);
    _sxc_pair_3d(_sxc_nf, _sxc_mlo, _sxc_lg, _sxc_nf, _sxc_mhi, _sxc_lg);
    _sxc_pair_3d(_sxc_nf, _sxc_mg, _sxc_llo, _sxc_nf, _sxc_mg, _sxc_lhi);
    _sxc_pair_3d(_sxc_nfhi, _sxc_mflo, _sxc_lg, _sxc_nflo, _sxc_mfhi, _sxc_lg);
    _sxc_pair_3d(_sxc_ng, _sxc_mfhi, _sxc_lflo, _sxc_ng, _sxc_mflo, _sxc_lfhi);
    _sxc_pair_3d(_sxc_nfhi, _sxc_mg, _sxc_lflo, _sxc_nflo, _sxc_mg, _sxc_lfhi);
    _sxc_k = _sxc_k + 1;
}
assert_eq(_SXC_CROSS2, 96, "simplex_2d straddles: all 96 pairs land in two different simplices");
assert_eq(_SXC_BAD2, 0, "simplex_2d: continuous across 96 boundary straddles (|jump| < 1e-6, not NaN)");
assert_eq(_SXC_CROSS3, 192, "simplex_3d straddles: all 192 pairs land in two different simplices");
assert_eq(_SXC_BAD3, 0, "simplex_3d: continuous across 192 boundary straddles (|jump| < 1e-6, not NaN)");

# The documented range, read where it is attained (src/noise_simplex.cyr's header,
# RANGE). 2D: the midpoints of the lattice diagonals (0, 10)-(1, 11) and (0, 29)-(1, 30),
# whose end gradients are (1, 1) / (-1, -1) and (-1, -1) / (1, 1), where simplex_2d is
# +140/(81 sqrt(3)) and -140/(81 sqrt(3)) -- checked bit-exact against the reference
# and, as a second code path, against the closed form. 3D: (x, 302 - x, 163), a
# maximiser the max search found, where simplex_3d is 0.998299. A 3D scale of 76.881
# or more puts that point outside 1 (the bound is 76.88075), one below 76.72 puts it
# under 0.998, and a 2D scale above 70.15 puts the 2D extremum outside 1.
# [measured: scratch max search, not reproducible in-tree, 2026-10-01; cycc 6.6.12]
var _sxc_cf = f64_div(f64_from(140), f64_mul(f64_from(81), f64_sqrt(f64_from(3))));
var _sxc_t2 = f64_mul(f64_from(11), _SIMPLEX_G2);
var _sxc_v2 = simplex_2d(f64_sub(F64_HALF, _sxc_t2), f64_sub(f64_div(f64_from(21), F64_TWO), _sxc_t2));
assert_eq(_sxc_v2, 0x3FEFEEB5A7A3E693,
  "simplex_2d at a maximiser == 0.9978893541549091 (bit-exact vs reference)");
assert(f64_lt(f64_abs(f64_sub(_sxc_v2, _sxc_cf)), 0x3CE203AF9EE75616) == 1,
  "simplex_2d at a maximiser == 140/(81 sqrt(3)) to 2e-15 (closed form)");
var _sxc_t2n = f64_mul(f64_from(30), _SIMPLEX_G2);
var _sxc_v2n = simplex_2d(f64_sub(F64_HALF, _sxc_t2n), f64_sub(f64_div(f64_from(59), F64_TWO), _sxc_t2n));
assert_eq(_sxc_v2n, 0xBFEFEEB5A7A3E694,
  "simplex_2d at a minimiser == -0.9978893541549092 (bit-exact vs reference)");
assert(f64_lt(f64_abs(f64_add(_sxc_v2n, _sxc_cf)), 0x3CE203AF9EE75616) == 1,
  "simplex_2d at a minimiser == -140/(81 sqrt(3)) to 2e-15 (closed form)");
assert(f64_lt(f64_abs(_sxc_v2n), F64_ONE) == 1, "simplex_2d: |v| at its extremum is inside 1");
var _sxc_x3 = 0x40558AADB030BBE0;                              # 86.16685108908814
var _sxc_v3 = simplex_3d(_sxc_x3, f64_sub(f64_from(302), _sxc_x3), f64_from(163));
assert_eq(_sxc_v3, 0x3FEFF211670A59E5,
  "simplex_3d at a maximiser == 0.9982993137844544 (bit-exact vs reference)");
assert(f64_gt(_sxc_v3, 0x3FEFEF9DB22D0E56) == 1, "simplex_3d at a maximiser > 0.998 (the documented maximum)");
assert(f64_lt(_sxc_v3, F64_ONE) == 1, "simplex_3d: its maximum is inside 1");

# ================================================================
# ================================================================
# 2.14.0 — scale covariance for calc_ext's five epsilon guards
# ================================================================
# ⛔ FIVE GUARDS IN THIS FILE COMPARED A DIMENSIONED QUANTITY AGAINST AN ABSOLUTE
# 1e-12 AND THEN FABRICATED A PLAUSIBLE ANSWER — the same class the repo has been
# recording since complex.cyr:58 in 2.6.14. All five passed every assertion in the
# tree before this block existed, and all five still pass them after the repair:
# the existing calc_ext tests are reject-path assertions that return before the
# guard runs, so NO test in the tree ever evaluated a B-spline to a value.
#
# ⭐ SCALE COVARIANCE IS THE ONLY SHAPE OF TEST A BAD THRESHOLD CANNOT PASS, and
# these fixtures are BIT-EXACT rather than tolerance-based: every scale is a power
# of two, so each blend weight is exactly representable and the expected value does
# not move by a single ULP across ~600 decimal decades. A tolerance would have
# re-introduced the 2.13.0 problem — an assertion that accepts a range accepts a
# fabrication that lands in the range.
#
# ⚠ THE DEPTH IS BRACKETING, NOT DECORATION. Each sweep must straddle every
# threshold a repair might plausibly have reached for, because 2.11.1 recorded a
# 12-decade quaternion sweep killing 1 of 3 mutants by looking above where the
# rejected thresholds sat. Measured kill matrix for the de Boor sweep, one build
# per candidate: 1e-6 first fails at 2^-20, 1e-9 at 2^-30, the shipped 1e-12 at
# 2^-40, 1e-15 at 2^-50, DBL_EPSILON at 2^-60, and F64_1E_NEG30 — then declared
# at the top of calc_ext.cyr (3.3.3 retired it), so the likeliest in-file grab — at 2^-200. Only
# DBL_MIN survives all ten. That is why 2^-200 and 2^-1000 are here and why the
# 2^-60 -> 2^-200 gap must not be closed up.
# [measured: per-candidate rebuild of the whole sweep, 2026-09-09]

test_group("calc_ext 2.14.0: scale covariance of the epsilon guards");

# 2^e as an f64 bit pattern: exponent field (1023 + e), zero mantissa.
fn _ce_p2(e) { return (1023 + e) << 52; }

# The shared cubic fixture: P = [(0,0,0),(1,2,0),(3,-1,0),(4,0,0)].
fn _ce_cps4() {
    var c = alloc(4 * 8);
    store64(c + 0,  hvec3_new(0, 0, 0));
    store64(c + 8,  hvec3_new(f64_from(1), f64_from(2), 0));
    store64(c + 16, hvec3_new(f64_from(3), f64_neg(F64_ONE), 0));
    store64(c + 24, hvec3_new(f64_from(4), 0, 0));
    return c;
}

# knots = [0,0,0,0,s,s,s,s]; t = s/2 sits mid-span, so alpha = 1/2 exactly.
fn _ce_knots8(s) {
    var k = _f64arr_alloc(8);
    var i = 0;
    while (i < 4) {
        _f64arr_set(k, i, 0);
        _f64arr_set(k, i + 4, s);
        i = i + 1;
    }
    return k;
}

# --- A. calc_bspline: the knot vector is a UNIT CHOICE, so the curve must not move
var _CE_RUN = 0;
var _CE_BAD = 0;
var _ce_exps = _f64arr_alloc(10);
_f64arr_set(_ce_exps, 0, 0);       _f64arr_set(_ce_exps, 1, 0 - 10);
_f64arr_set(_ce_exps, 2, 0 - 20);  _f64arr_set(_ce_exps, 3, 0 - 30);
_f64arr_set(_ce_exps, 4, 0 - 39);  _f64arr_set(_ce_exps, 5, 0 - 40);
_f64arr_set(_ce_exps, 6, 0 - 50);  _f64arr_set(_ce_exps, 7, 0 - 60);
_f64arr_set(_ce_exps, 8, 0 - 200); _f64arr_set(_ce_exps, 9, 0 - 1000);
# ⚠ 2^-39 is here deliberately: it is the LAST scale that passes on the stock
# tree, so the sweep pins the breakpoint instead of merely straddling it.

var _ce_i = 0;
while (_ce_i < 10) {
    var _ce_s = _ce_p2(_f64arr_get(_ce_exps, _ce_i));
    var _ce_r = calc_bspline(3, _ce_cps4(), 4, _ce_knots8(_ce_s), 8,
      f64_mul(_ce_s, F64_HALF));
    _CE_RUN = _CE_RUN + 1;
    if (_ce_r == 0) {
        _CE_BAD = _CE_BAD + 1;
    } else {
        if (HVec3_x(_ce_r) != 0x4000000000000000) { _CE_BAD = _CE_BAD + 1; }
        if (HVec3_y(_ce_r) != 0x3FD8000000000000) { _CE_BAD = _CE_BAD + 1; }
    }
    _ce_i = _ce_i + 1;
}
# ⚠ The RUN counter is asserted, not assumed. A sweep that silently stops running
# is indistinguishable from a sweep that passes — 2.10.2 caught two such fixtures.
assert_eq(_CE_RUN, 10, "calc_bspline knot-scale sweep actually ran 10 scales");
assert_eq(_CE_BAD, 0,
  "calc_bspline: (2.0, 0.375) bit-exact at every knot scale from 2^0 to 2^-1000");

# --- B. NARROW INTERIOR SPAN — kills the span-RELATIVE repair, which A lets pass.
# ⭐ A guard of the form `denom < eps * (t_max - t_min)` is scale-free and sails
# through sweep A unchanged, because there every span IS the total span. Only a
# knot vector with one fine interior span inside a unit total separates them.
var _ce_nb_cps = alloc(3 * 8);
store64(_ce_nb_cps + 0,  hvec3_new(0, 0, 0));
store64(_ce_nb_cps + 8,  hvec3_new(f64_from(8), f64_from(4), 0));
store64(_ce_nb_cps + 16, hvec3_new(f64_from(16), 0, 0));
var _ce_nb_kn = _f64arr_alloc(5);
_f64arr_set(_ce_nb_kn, 0, 0);
_f64arr_set(_ce_nb_kn, 1, 0);
_f64arr_set(_ce_nb_kn, 2, _ce_p2(0 - 40));
_f64arr_set(_ce_nb_kn, 3, F64_ONE);
_f64arr_set(_ce_nb_kn, 4, F64_ONE);
var _ce_nb = calc_bspline(1, _ce_nb_cps, 3, _ce_nb_kn, 5, _ce_p2(0 - 41));
assert(_ce_nb != 0, "calc_bspline narrow-span fixture returns a point");
assert_eq(HVec3_x(_ce_nb), 0x4010000000000000,
  "calc_bspline: a fine interior span inside a unit knot vector still interpolates");
assert_eq(HVec3_y(_ce_nb), 0x4000000000000000,
  "calc_bspline: narrow-span y is the exact midpoint, not the fabricated P1");

# --- C. ANTI-DELETION CONTROL. Sweeps A and B never drive denom to zero, so both
# pass with the guard deleted entirely. This fixture forces knots[2] == knots[3].
var _ce_z_cps = alloc(3 * 8);
store64(_ce_z_cps + 0,  hvec3_new(F64_ONE, 0, 0));
store64(_ce_z_cps + 8,  hvec3_new(f64_from(5), 0, 0));
store64(_ce_z_cps + 16, hvec3_new(f64_from(9), 0, 0));
var _ce_z_kn = _f64arr_alloc(5);
_f64arr_set(_ce_z_kn, 0, 0);
_f64arr_set(_ce_z_kn, 1, 0);
_f64arr_set(_ce_z_kn, 2, F64_ONE);
_f64arr_set(_ce_z_kn, 3, F64_ONE);
_f64arr_set(_ce_z_kn, 4, F64_ONE);
var _ce_z = calc_bspline(1, _ce_z_cps, 3, _ce_z_kn, 5, F64_ONE);
assert(_ce_z != 0, "calc_bspline zero-span control returns a point");
assert_eq(HVec3_x(_ce_z), 0x4022000000000000,
  "calc_bspline: an exactly-zero knot span still takes the skip, not 0/0");

# --- D. calc_nurbs inherits the same de Boor guard: sweep it at all weights = 1.
var _CE_NR_RUN = 0;
var _CE_NR_BAD = 0;
_ce_i = 0;
while (_ce_i < 10) {
    var _ce_ns = _ce_p2(_f64arr_get(_ce_exps, _ce_i));
    var _ce_nw = _f64arr_alloc(4);
    var _ce_wj = 0;
    while (_ce_wj < 4) { _f64arr_set(_ce_nw, _ce_wj, F64_ONE); _ce_wj = _ce_wj + 1; }
    var _ce_nres = calc_nurbs(3, _ce_cps4(), _ce_nw, 4, _ce_knots8(_ce_ns), 8,
      f64_mul(_ce_ns, F64_HALF));
    _CE_NR_RUN = _CE_NR_RUN + 1;
    if (_ce_nres == 0) {
        _CE_NR_BAD = _CE_NR_BAD + 1;
    } else {
        if (HVec3_x(_ce_nres) != 0x4000000000000000) { _CE_NR_BAD = _CE_NR_BAD + 1; }
    }
    _ce_i = _ce_i + 1;
}
assert_eq(_CE_NR_RUN, 10, "calc_nurbs knot-scale sweep actually ran 10 scales");
assert_eq(_CE_NR_BAD, 0,
  "calc_nurbs: x is bit-exactly 2.0 at every knot scale from 2^0 to 2^-1000");

# --- E. THE WEIGHT GAUGE IS UNOBSERVABLE. w and c*w describe the SAME curve, so
# the perspective-divide guard must not have an opinion about c. This sweep runs
# in BOTH directions — 2^+1000 down to 2^-1000, ~600 decimal decades — and the
# maximum intermediate is 4*2^1000 = 2^1002, so nothing overflows or goes subnormal.
var _CE_W_RUN = 0;
var _CE_W_BAD = 0;
var _ce_wexps = _f64arr_alloc(12);
_f64arr_set(_ce_wexps, 0, 1000);     _f64arr_set(_ce_wexps, 1, 60);
_f64arr_set(_ce_wexps, 2, 10);       _f64arr_set(_ce_wexps, 3, 0);
_f64arr_set(_ce_wexps, 4, 0 - 10);   _f64arr_set(_ce_wexps, 5, 0 - 20);
_f64arr_set(_ce_wexps, 6, 0 - 30);   _f64arr_set(_ce_wexps, 7, 0 - 40);
_f64arr_set(_ce_wexps, 8, 0 - 50);   _f64arr_set(_ce_wexps, 9, 0 - 60);
_f64arr_set(_ce_wexps, 10, 0 - 200); _f64arr_set(_ce_wexps, 11, 0 - 1000);
_ce_i = 0;
while (_ce_i < 12) {
    var _ce_c = _ce_p2(_f64arr_get(_ce_wexps, _ce_i));
    var _ce_gw = _f64arr_alloc(4);
    var _ce_gj = 0;
    while (_ce_gj < 4) { _f64arr_set(_ce_gw, _ce_gj, _ce_c); _ce_gj = _ce_gj + 1; }
    var _ce_gkn = _ce_knots8(F64_ONE);
    var _ce_g = calc_nurbs(3, _ce_cps4(), _ce_gw, 4, _ce_gkn, 8, F64_HALF);
    _CE_W_RUN = _CE_W_RUN + 1;
    if (_ce_g == 0) {
        _CE_W_BAD = _CE_W_BAD + 1;
    } else {
        if (HVec3_x(_ce_g) != 0x4000000000000000) { _CE_W_BAD = _CE_W_BAD + 1; }
    }
    _ce_i = _ce_i + 1;
}
assert_eq(_CE_W_RUN, 12, "calc_nurbs weight-gauge sweep actually ran 12 gauges");
assert_eq(_CE_W_BAD, 0,
  "calc_nurbs: the weight gauge is unobservable, x is 2.0 from 2^+1000 to 2^-1000");

# === 3.3.3 W4: NaN in the B-spline, NURBS and TCB parameter ===
# ⛔ calc_bspline and calc_nurbs range-tested t with two NaN-false comparisons, so a
# NaN t passed. At degree 0 nothing does arithmetic on t: the span search ran to the
# end and returned the LAST control point — (2,0,0) on this fixture, a point on the
# curve — and at degree 1 a NaN point. Both now return the documented invalid-input 0.
# [measured: degree-0 and degree-1 NaN-t probe on the 3.3.2 bundle, 2026-10-01]
var _w4_nan = f64_div(0, 0);
var _w4_cp = alloc(3 * 8);
store64(_w4_cp + 0,  hvec3_new(0, 0, 0));
store64(_w4_cp + 8,  hvec3_new(F64_ONE, F64_ONE, F64_ONE));
store64(_w4_cp + 16, hvec3_new(F64_TWO, 0, 0));
var _w4_k0 = _f64arr_alloc(4);
_f64arr_set(_w4_k0, 0, 0);
_f64arr_set(_w4_k0, 1, F64_ONE);
_f64arr_set(_w4_k0, 2, F64_TWO);
_f64arr_set(_w4_k0, 3, f64_from(3));
var _w4_k1 = _f64arr_alloc(5);
_f64arr_set(_w4_k1, 0, 0);
_f64arr_set(_w4_k1, 1, 0);
_f64arr_set(_w4_k1, 2, F64_ONE);
_f64arr_set(_w4_k1, 3, F64_TWO);
_f64arr_set(_w4_k1, 4, F64_TWO);
var _w4_w = _f64arr_alloc(3);
_f64arr_set(_w4_w, 0, F64_ONE);
_f64arr_set(_w4_w, 1, F64_ONE);
_f64arr_set(_w4_w, 2, F64_ONE);
assert_eq(calc_bspline(0, _w4_cp, 3, _w4_k0, 4, _w4_nan), 0,
  "calc_bspline: degree 0, t = NaN -> 0 (was the last control point)");
assert_eq(calc_bspline(1, _w4_cp, 3, _w4_k1, 5, _w4_nan), 0,
  "calc_bspline: degree 1, t = NaN -> 0 (was a NaN point)");
assert_eq(calc_nurbs(0, _w4_cp, _w4_w, 3, _w4_k0, 4, _w4_nan), 0,
  "calc_nurbs: degree 0, t = NaN -> 0 (was the last control point)");
assert_eq(calc_nurbs(1, _w4_cp, _w4_w, 3, _w4_k1, 5, _w4_nan), 0,
  "calc_nurbs: degree 1, t = NaN -> 0 (was a NaN point)");
# Controls: the guard stops NaN and nothing else. The same degree-0 curve is its
# first control point at t = 0.5 and its last at t = 2.5 and at t_max = 3.
var _w4_b0 = calc_bspline(0, _w4_cp, 3, _w4_k0, 4, F64_HALF);
assert(_w4_b0 != 0, "calc_bspline: degree 0, t = 0.5 is a point");
assert_eq(HVec3_x(_w4_b0), 0, "calc_bspline: degree 0, t = 0.5 is the first control point");
var _w4_b2 = calc_bspline(0, _w4_cp, 3, _w4_k0, 4, f64_add(F64_TWO, F64_HALF));
assert(_w4_b2 != 0, "calc_bspline: degree 0, t = 2.5 is a point");
assert_eq(HVec3_x(_w4_b2), F64_TWO, "calc_bspline: degree 0, t = 2.5 is the last control point");
var _w4_n3 = calc_nurbs(0, _w4_cp, _w4_w, 3, _w4_k0, 4, f64_from(3));
assert(_w4_n3 != 0, "calc_nurbs: degree 0, t = t_max is a point");
assert_eq(HVec3_x(_w4_n3), F64_TWO, "calc_nurbs: degree 0, t = t_max is the last control point");

# ⚠ THE SPAN TESTS STAY NaN-TRUE, ON PURPOSE. de Boor's `f64_lt(|denom|, F64_TINY) == 0`
# and the TCB segment's `f64_lt(|seg_len|, F64_TINY) == 0` are TRUE for a NaN width,
# so a NaN knot or key time is computed THROUGH and comes out NaN. The NaN-false
# spelling (`f64_ge(...) == 1`) skips the update instead, and returns a value built
# from the inputs around the NaN as if it were not there.
# [measured: NaN-knot and NaN-key-time probe on the 3.3.2 bundle and the respelled builds, 2026-10-01]
var _w4_kn = _f64arr_alloc(5);
_f64arr_set(_w4_kn, 0, 0);
_f64arr_set(_w4_kn, 1, 0);
_f64arr_set(_w4_kn, 2, _w4_nan);
_f64arr_set(_w4_kn, 3, F64_TWO);
_f64arr_set(_w4_kn, 4, F64_TWO);
var _w4_bn = calc_bspline(1, _w4_cp, 3, _w4_kn, 5, F64_HALF);
assert(_w4_bn != 0, "calc_bspline: a NaN interior knot still returns a point");
assert_eq(f64_eq(HVec3_x(_w4_bn), HVec3_x(_w4_bn)), 0, "calc_bspline: a NaN interior knot propagates NaN");
var _w4_nn = calc_nurbs(1, _w4_cp, _w4_w, 3, _w4_kn, 5, F64_HALF);
assert(_w4_nn != 0, "calc_nurbs: a NaN interior knot still returns a point");
assert_eq(f64_eq(HVec3_x(_w4_nn), HVec3_x(_w4_nn)), 0, "calc_nurbs: a NaN interior knot propagates NaN");
# ⛔ 3.3.4 — AT DEGREE 0 THE SAME NaN KNOT WAS NEVER READ: knots [0, NaN, 2, 3] gave
# ctrl[1] = (1,1,1) at t = 0.5 and 1.5, where the span holding t cannot be decided. A
# NaN bound of the span t lands in now gives the NaN point, the rule degree >= 1 already
# follows through de Boor's alpha. A NaN knot outside that span is not read: t = 2.5 is
# still ctrl[2]. [0, 1, 2, NaN] puts the NaN on the RIGHT bound of the last span, so the
# two bound tests are proven separately.
# [measured: NaN-knot probe on the base tree, 2026-10-03; cycc 6.6.14]
var _r4_kl = _f64arr_alloc(4);
_f64arr_set(_r4_kl, 0, 0);
_f64arr_set(_r4_kl, 1, _w4_nan);
_f64arr_set(_r4_kl, 2, F64_TWO);
_f64arr_set(_r4_kl, 3, f64_from(3));
var _r4_kr = _f64arr_alloc(4);
_f64arr_set(_r4_kr, 0, 0);
_f64arr_set(_r4_kr, 1, F64_ONE);
_f64arr_set(_r4_kr, 2, F64_TWO);
_f64arr_set(_r4_kr, 3, _w4_nan);
var _r4_p = calc_bspline(0, _w4_cp, 3, _r4_kl, 4, F64_HALF);
assert(_r4_p != 0, "calc_bspline: degree 0, NaN knot 1, t = 0.5 returns a point");
assert_eq(HVec3_x(_r4_p), 0x7FF8000000000000, "calc_bspline: degree 0, NaN knot 1, t = 0.5 -> NaN x (was ctrl[1])");
assert_eq(HVec3_y(_r4_p), 0x7FF8000000000000, "calc_bspline: degree 0, NaN knot 1, t = 0.5 -> NaN y");
assert_eq(HVec3_z(_r4_p), 0x7FF8000000000000, "calc_bspline: degree 0, NaN knot 1, t = 0.5 -> NaN z");
_r4_p = calc_bspline(0, _w4_cp, 3, _r4_kl, 4, f64_add(F64_ONE, F64_HALF));
assert_eq(HVec3_x(_r4_p), 0x7FF8000000000000, "calc_bspline: degree 0, NaN knot 1, t = 1.5 -> NaN (was ctrl[1])");
_r4_p = calc_bspline(0, _w4_cp, 3, _r4_kl, 4, f64_add(F64_TWO, F64_HALF));
assert_eq(HVec3_x(_r4_p), F64_TWO,
  "calc_bspline: degree 0, NaN knot 1, t = 2.5 is ctrl[2]: that span does not read it");
_r4_p = calc_bspline(0, _w4_cp, 3, _r4_kr, 4, f64_add(F64_TWO, F64_HALF));
assert_eq(HVec3_x(_r4_p), 0x7FF8000000000000, "calc_bspline: degree 0, NaN last knot, t = 2.5 -> NaN (was ctrl[2])");
_r4_p = calc_bspline(0, _w4_cp, 3, _r4_kr, 4, f64_add(F64_ONE, F64_HALF));
assert_eq(HVec3_x(_r4_p), F64_ONE, "calc_bspline: degree 0, NaN last knot, t = 1.5 is ctrl[1]");
_r4_p = calc_nurbs(0, _w4_cp, _w4_w, 3, _r4_kl, 4, F64_HALF);
assert(_r4_p != 0, "calc_nurbs: degree 0, NaN knot 1, t = 0.5 returns a point");
assert_eq(HVec3_x(_r4_p), 0x7FF8000000000000, "calc_nurbs: degree 0, NaN knot 1, t = 0.5 -> NaN x (was ctrl[1])");
assert_eq(HVec3_y(_r4_p), 0x7FF8000000000000, "calc_nurbs: degree 0, NaN knot 1, t = 0.5 -> NaN y");
assert_eq(HVec3_z(_r4_p), 0x7FF8000000000000, "calc_nurbs: degree 0, NaN knot 1, t = 0.5 -> NaN z");
_r4_p = calc_nurbs(0, _w4_cp, _w4_w, 3, _r4_kl, 4, f64_add(F64_TWO, F64_HALF));
assert_eq(HVec3_x(_r4_p), F64_TWO, "calc_nurbs: degree 0, NaN knot 1, t = 2.5 is ctrl[2]");
_r4_p = calc_nurbs(0, _w4_cp, _w4_w, 3, _r4_kr, 4, f64_add(F64_TWO, F64_HALF));
assert_eq(HVec3_x(_r4_p), 0x7FF8000000000000, "calc_nurbs: degree 0, NaN last knot, t = 2.5 -> NaN (was ctrl[2])");
var _w4_tt = _f64arr_alloc(3);
_f64arr_set(_w4_tt, 0, 0);
_f64arr_set(_w4_tt, 1, _w4_nan);
_f64arr_set(_w4_tt, 2, F64_TWO);
var _w4_tv = _f64arr_alloc(3);
_f64arr_set(_w4_tv, 0, 0);
_f64arr_set(_w4_tv, 1, f64_from(5));
_f64arr_set(_w4_tv, 2, f64_from(10));
var _w4_th = calc_hermite_tcb(_w4_tt, _w4_tv, 3, 0, 0, 0, F64_HALF);
assert_eq(f64_eq(_w4_th, _w4_th), 0, "calc_hermite_tcb: a NaN key time propagates NaN, not key 1's 5.0");

# --- F. calc_hermite_tcb: THREE queries per scale, because they fail differently.
# ⚠ The on-key query alone is NOT enough and this is measured: at t = key 1 the
# value 5.0 coincides with what the collapsed u = 0 path returns, so repairing the
# end-key clamp alone passes it while the segment interior is still wrong. The
# interior query at t = 1.5s is what forces the sibling seg_len guard to be fixed.
# [measured: per-candidate rebuild of the hermite sweep, 2026-09-09]
var _CE_H_RUN = 0;
var _CE_H_BAD = 0;
var _ce_hexps = _f64arr_alloc(9);
_f64arr_set(_ce_hexps, 0, 0);       _f64arr_set(_ce_hexps, 1, 0 - 10);
_f64arr_set(_ce_hexps, 2, 0 - 20);  _f64arr_set(_ce_hexps, 3, 0 - 30);
_f64arr_set(_ce_hexps, 4, 0 - 40);  _f64arr_set(_ce_hexps, 5, 0 - 50);
_f64arr_set(_ce_hexps, 6, 0 - 60);  _f64arr_set(_ce_hexps, 7, 0 - 200);
_f64arr_set(_ce_hexps, 8, 0 - 1000);
_ce_i = 0;
while (_ce_i < 9) {
    var _ce_hs = _ce_p2(_f64arr_get(_ce_hexps, _ce_i));
    var _ce_ht = _f64arr_alloc(3);
    _f64arr_set(_ce_ht, 0, 0);
    _f64arr_set(_ce_ht, 1, _ce_hs);
    _f64arr_set(_ce_ht, 2, f64_mul(_ce_hs, F64_TWO));
    var _ce_hv = _f64arr_alloc(3);
    _f64arr_set(_ce_hv, 0, 0);
    _f64arr_set(_ce_hv, 1, f64_from(5));
    _f64arr_set(_ce_hv, 2, f64_from(10));
    _CE_H_RUN = _CE_H_RUN + 1;
    # (A) ON KEY 1 — the end-key clamp must not claim this is the LAST key.
    if (calc_hermite_tcb(_ce_ht, _ce_hv, 3, 0, 0, 0, _ce_hs)
      != 0x4014000000000000) { _CE_H_BAD = _CE_H_BAD + 1; }
    # (B) SEGMENT INTERIOR — u must be a real fraction, not collapsed to 0.
    if (calc_hermite_tcb(_ce_ht, _ce_hv, 3, 0, 0, 0,
        f64_add(_ce_hs, f64_mul(_ce_hs, F64_HALF))) != 0x401F400000000000) {
        _CE_H_BAD = _CE_H_BAD + 1;
    }
    # (C) ON THE LAST KEY — the clamp must still fire. This is the assertion that
    # rules DELETION out: with the guard gone it returns 5.0 here from 2^-40 down.
    if (calc_hermite_tcb(_ce_ht, _ce_hv, 3, 0, 0, 0, f64_mul(_ce_hs, F64_TWO))
      != 0x4024000000000000) { _CE_H_BAD = _CE_H_BAD + 1; }
    _ce_i = _ce_i + 1;
}
assert_eq(_CE_H_RUN, 9, "calc_hermite_tcb sweep actually ran 9 key-time scales");
assert_eq(_CE_H_BAD, 0,
  "calc_hermite_tcb: on-key 5.0, interior 7.8125, end 10.0 at every key-time scale");

# --- G. OVERFLOW CONTROL, scale-independent. The end-key clamp is not protecting a
# division — it is protecting h10*m0 from 0*Inf when a tangent overflows. Deleting
# it returns NaN here, which is why the repair is exact equality and not removal.
var _ce_ot = _f64arr_alloc(3);
_f64arr_set(_ce_ot, 0, 0);
_f64arr_set(_ce_ot, 1, F64_ONE);
_f64arr_set(_ce_ot, 2, F64_TWO);
var _ce_ov = _f64arr_alloc(3);
_f64arr_set(_ce_ov, 0, 0);
_f64arr_set(_ce_ov, 1, f64_neg(0x7FE0000000000000));
_f64arr_set(_ce_ov, 2, 0x7FE0000000000000);
assert_eq(calc_hermite_tcb(_ce_ot, _ce_ov, 3, 0, 0, 0, F64_TWO), 0x7FE0000000000000,
  "calc_hermite_tcb: an overflowing tangent at the end key returns the key, not NaN");

# --- H. calc_monotone_cubic: the x axis is a UNIT CHOICE, swept BOTH ways.
# ⚠ The growing side stops at 2^+60 because a SEPARATE guard in
# calc_monotone_cubic's tangent loop (`_CALCX_F64_1E_NEG30`) compared |delta| — a
# SLOPE, y per x — against an absolute 1e-30, and it started zeroing tangents past
# s = 2^+99.7: measured 2.25 at 2^+90, 2.0 at 2^+100 and 2.5 at 2^+110. 3.3.3
# repaired it (audit D068); the sweep past 2^+100 is the "3.3.3 G4" block below.
# [measured: growing-side scan, first deviation at 2^+100]
var _CE_M_RUN = 0;
var _CE_M_BAD = 0;
var _ce_mexps = _f64arr_alloc(12);
_f64arr_set(_ce_mexps, 0, 60);      _f64arr_set(_ce_mexps, 1, 30);
_f64arr_set(_ce_mexps, 2, 10);      _f64arr_set(_ce_mexps, 3, 0);
_f64arr_set(_ce_mexps, 4, 0 - 10);  _f64arr_set(_ce_mexps, 5, 0 - 20);
_f64arr_set(_ce_mexps, 6, 0 - 30);  _f64arr_set(_ce_mexps, 7, 0 - 40);
_f64arr_set(_ce_mexps, 8, 0 - 50);  _f64arr_set(_ce_mexps, 9, 0 - 60);
_f64arr_set(_ce_mexps, 10, 0 - 200); _f64arr_set(_ce_mexps, 11, 0 - 1000);
_ce_i = 0;
while (_ce_i < 12) {
    var _ce_ms = _ce_p2(_f64arr_get(_ce_mexps, _ce_i));
    var _ce_mx = _f64arr_alloc(4);
    _f64arr_set(_ce_mx, 0, 0);
    _f64arr_set(_ce_mx, 1, _ce_ms);
    _f64arr_set(_ce_mx, 2, f64_mul(_ce_ms, F64_TWO));
    _f64arr_set(_ce_mx, 3, f64_mul(_ce_ms, f64_from(3)));
    var _ce_my = _f64arr_alloc(4);
    _f64arr_set(_ce_my, 0, 0);
    _f64arr_set(_ce_my, 1, F64_ONE);
    _f64arr_set(_ce_my, 2, f64_from(4));
    _f64arr_set(_ce_my, 3, f64_from(9));
    _CE_M_RUN = _CE_M_RUN + 1;
    if (calc_monotone_cubic(_ce_mx, _ce_my, 4,
        f64_add(_ce_ms, f64_mul(_ce_ms, F64_HALF))) != 0x4002000000000000) {
        _CE_M_BAD = _CE_M_BAD + 1;
    }
    _ce_i = _ce_i + 1;
}
assert_eq(_CE_M_RUN, 12, "calc_monotone_cubic sweep actually ran 12 x-axis scales");
assert_eq(_CE_M_BAD, 0,
  "calc_monotone_cubic: 2.25 bit-exact from x-scale 2^+60 down to 2^-1000");

# === 3.3.3 G4: calc_monotone_cubic flat-secant test (D068) ===
# ⛔ The flat-segment test was `|delta| < 1e-30`, an absolute threshold on a SLOPE.
# Sweep H past 2^+100 is where it bit: 2.25 at 2^+99, 2.0 at 2^+100 and 2^+101, 2.5
# from 2^+102 on 3.3.2. The fixtures sit ON the boundary — 1e-30 is 2^-99.66, so
# the first secant (1/s) is above it at 2^+99 and below it at 2^+100 — and run on to
# 2^+1022, the last x-scale whose 3s is finite. The y-scale sweep is the same slope
# reached the other way (ys = 2^j [0,1,4,9] on the unit grid, f(1.5) = 2.25 * 2^j,
# exact because every scale is a power of two); 3.3.2 was wrong from 2^-100 down.
# [measured: (x-scale, y-scale) grid probe on the 3.3.2 bundle, 2026-10-01]
# ⚠ The y sweep runs on into SUBNORMAL slopes, because that is where an exact-zero
# test and a smaller threshold part. 2^-1022 is the last y-scale whose slopes are
# normal; from 2^-1023 a `|delta| < DBL_MIN` test flattens every segment and gives
# 2.5 * 2^j (wrong on 50 of the 83 scales 2^-990..2^-1072; 3.3.2 on all 83, this tree
# on none); 2^-1072 is the last scale whose 2.25 * 2^j is exact. The subnormal scales
# are built as an exact product of two normal powers of two, not as a shift.
# [measured: 83-scale y sweep on the 3.3.2 bundle, this tree and a DBL_MIN-threshold build, 2026-10-01]
var _G4_MC_RUN = 0;
var _G4_MC_BAD = 0;
var _g4_mexps = _f64arr_alloc(10);
_f64arr_set(_g4_mexps, 0, 90);   _f64arr_set(_g4_mexps, 1, 99);
_f64arr_set(_g4_mexps, 2, 100);  _f64arr_set(_g4_mexps, 3, 101);
_f64arr_set(_g4_mexps, 4, 102);  _f64arr_set(_g4_mexps, 5, 110);
_f64arr_set(_g4_mexps, 6, 200);  _f64arr_set(_g4_mexps, 7, 500);
_f64arr_set(_g4_mexps, 8, 1000); _f64arr_set(_g4_mexps, 9, 1022);
_ce_i = 0;
while (_ce_i < 10) {
    var _g4_ms = _ce_p2(_f64arr_get(_g4_mexps, _ce_i));
    var _g4_mx = _f64arr_alloc(4);
    _f64arr_set(_g4_mx, 0, 0);
    _f64arr_set(_g4_mx, 1, _g4_ms);
    _f64arr_set(_g4_mx, 2, f64_mul(_g4_ms, F64_TWO));
    _f64arr_set(_g4_mx, 3, f64_mul(_g4_ms, f64_from(3)));
    var _g4_my = _f64arr_alloc(4);
    _f64arr_set(_g4_my, 0, 0);
    _f64arr_set(_g4_my, 1, F64_ONE);
    _f64arr_set(_g4_my, 2, f64_from(4));
    _f64arr_set(_g4_my, 3, f64_from(9));
    _G4_MC_RUN = _G4_MC_RUN + 1;
    if (calc_monotone_cubic(_g4_mx, _g4_my, 4,
        f64_add(_g4_ms, f64_mul(_g4_ms, F64_HALF))) != 0x4002000000000000) {
        _G4_MC_BAD = _G4_MC_BAD + 1;
    }
    _ce_i = _ce_i + 1;
}
assert_eq(_G4_MC_RUN, 10, "calc_monotone_cubic growing sweep actually ran 10 x-axis scales");
assert_eq(_G4_MC_BAD, 0,
  "calc_monotone_cubic: 2.25 bit-exact from x-scale 2^+90 up to 2^+1022 (D068: 2.0 at 2^+100)");

var _G4_MY_RUN = 0;
var _G4_MY_BAD = 0;
var _g4_yexps = _f64arr_alloc(11);
_f64arr_set(_g4_yexps, 0, 0 - 99);   _f64arr_set(_g4_yexps, 1, 0 - 100);
_f64arr_set(_g4_yexps, 2, 0 - 101);  _f64arr_set(_g4_yexps, 3, 0 - 200);
_f64arr_set(_g4_yexps, 4, 0 - 500);  _f64arr_set(_g4_yexps, 5, 0 - 1000);
_f64arr_set(_g4_yexps, 6, 0 - 1022); _f64arr_set(_g4_yexps, 7, 0 - 1023);
_f64arr_set(_g4_yexps, 8, 0 - 1030); _f64arr_set(_g4_yexps, 9, 0 - 1050);
_f64arr_set(_g4_yexps, 10, 0 - 1072);
var _g4_ux = _f64arr_alloc(4);
_f64arr_set(_g4_ux, 0, 0);
_f64arr_set(_g4_ux, 1, F64_ONE);
_f64arr_set(_g4_ux, 2, F64_TWO);
_f64arr_set(_g4_ux, 3, f64_from(3));
_ce_i = 0;
while (_ce_i < 11) {
    var _g4_ye = _f64arr_get(_g4_yexps, _ce_i);
    var _g4_sy = 0;
    if (_g4_ye < 0 - 1022) {
        _g4_sy = f64_mul(_ce_p2(0 - 1000), _ce_p2(_g4_ye + 1000));
    } else {
        _g4_sy = _ce_p2(_g4_ye);
    }
    var _g4_yy = _f64arr_alloc(4);
    _f64arr_set(_g4_yy, 0, 0);
    _f64arr_set(_g4_yy, 1, _g4_sy);
    _f64arr_set(_g4_yy, 2, f64_mul(_g4_sy, f64_from(4)));
    _f64arr_set(_g4_yy, 3, f64_mul(_g4_sy, f64_from(9)));
    _G4_MY_RUN = _G4_MY_RUN + 1;
    var _g4_yv = calc_monotone_cubic(_g4_ux, _g4_yy, 4, f64_add(F64_ONE, F64_HALF));
    if (_g4_yv != f64_mul(0x4002000000000000, _g4_sy)) {
        _G4_MY_BAD = _G4_MY_BAD + 1;
    }
    _ce_i = _ce_i + 1;
}
assert_eq(_G4_MY_RUN, 11, "calc_monotone_cubic y-scale sweep actually ran 11 scales");
assert_eq(_G4_MY_BAD, 0,
  "calc_monotone_cubic: 2.25 * 2^j bit-exact for y-scales 2^-99 down to 2^-1072 (D068)");
# The subnormal end on its own, so a failure names the half of the sweep it is in:
# ys = 2^-1023 [0,1,4,9] (bits 0x0008.., 0x0020.., 0x0032..) has subnormal slopes;
# f(1.5) is 2.25 * 2^-1023 = 0x0012000000000000, and 0x0014000000000000 (2.5x) flat.
# [measured: 83-scale y sweep on a DBL_MIN-threshold build, 2026-10-01]
var _g4_ysub = _f64arr_alloc(4);
_f64arr_set(_g4_ysub, 0, 0);
_f64arr_set(_g4_ysub, 1, 0x0008000000000000);
_f64arr_set(_g4_ysub, 2, 0x0020000000000000);
_f64arr_set(_g4_ysub, 3, 0x0032000000000000);
assert_eq(calc_monotone_cubic(_g4_ux, _g4_ysub, 4, f64_add(F64_ONE, F64_HALF)), 0x0012000000000000,
  "calc_monotone_cubic: subnormal slopes are tangents, not a flat segment (2.25 * 2^-1023)");

# ⛔ THE SECOND HALF OF THE REPAIR. An exact-zero test alone lets a subnormal secant
# reach alpha = m/delta, which overflows to +Inf, and the circle projection then
# formed tau * alpha = 0 * Inf = NaN. ys = [-1, 0, 2^-1074, 1] on the unit grid is
# that case: 3.3.2 flattened the middle interval and the exact-zero-only build
# returned NaN at all three queries. Settled by hand, and by a 400-digit exact
# Fritsch-Carlson oracle that rounds once at the end: the projected tangents at the
# middle knots are 3|delta|/sqrt(2), about 2.1 * 2^-1074, so at x = 0.5 the value is
# -1/2 + 1/8 - (1/8)(2.1 * 2^-1074), which rounds to -0.375, and at x = 2.5 it is
# 1/2 - 1/8 plus terms of order 2^-1074, which round to 0.375.
# [measured: part-1-only and part-2-only bundles against these fixtures, 2026-10-01]
var _g4_sy1 = _f64arr_alloc(4);
_f64arr_set(_g4_sy1, 0, f64_neg(F64_ONE));
_f64arr_set(_g4_sy1, 1, 0);
_f64arr_set(_g4_sy1, 2, 1);
_f64arr_set(_g4_sy1, 3, F64_ONE);
assert_eq(calc_monotone_cubic(_g4_ux, _g4_sy1, 4, F64_HALF), 0xBFD8000000000000,
  "calc_monotone_cubic: a subnormal secant is projected, not 0 * Inf (-0.375 at x = 0.5)");
assert_eq(calc_monotone_cubic(_g4_ux, _g4_sy1, 4, f64_add(F64_TWO, F64_HALF)), 0x3FD8000000000000,
  "calc_monotone_cubic: a subnormal secant is projected, not 0 * Inf (0.375 at x = 2.5)");

# The same overflow WITHOUT the exact-zero test: the 1e-30 guard passed any secant
# above 2^-99.66, so a neighbour 2^1024 times larger still overflowed alpha. Here
# delta = [2^1000, 2^-90] and the shared tangent is 2^999, so alpha = 2^1089. 3.3.2
# returned NaN on BOTH intervals. Settled by hand and by the same exact oracle: the
# projection sends the middle tangent to 3 * 2^-90 and the last to ~0, so
# f(2^89) = 1/2 + (1/8)(2^90)(3 * 2^-90) + 1 = 1.875 and
# f(2^-1001) = (1/8)(2^-1000)(2^1000) + 1/2 = 0.625, each with a correction below
# 2^-1000 that rounds away.
# [measured: scratch harness, not reproducible in-tree, 2026-10-01; 3.3.2 bundle vs this tree]
var _g4_ox = _f64arr_alloc(3);
_f64arr_set(_g4_ox, 0, 0);
_f64arr_set(_g4_ox, 1, _ce_p2(0 - 1000));
_f64arr_set(_g4_ox, 2, _ce_p2(90));
var _g4_oy = _f64arr_alloc(3);
_f64arr_set(_g4_oy, 0, 0);
_f64arr_set(_g4_oy, 1, F64_ONE);
_f64arr_set(_g4_oy, 2, F64_TWO);
assert_eq(calc_monotone_cubic(_g4_ox, _g4_oy, 3, _ce_p2(89)), 0x3FFE000000000000,
  "calc_monotone_cubic: an overflowing alpha is projected in tangent space (1.875, was NaN)");
assert_eq(calc_monotone_cubic(_g4_ox, _g4_oy, 3, _ce_p2(0 - 1001)), 0x3FE4000000000000,
  "calc_monotone_cubic: the neighbouring interval is not poisoned (0.625, was NaN)");

# The two fixtures above cannot see the projection's MAGNITUDE or SIGN: one has the
# result in the subnormal noise, the other a single dominant tangent. Here BOTH
# ratios overflow (delta = [2^966, 2^-60, 2^966], tangents 2^965 at both middle
# knots), the two tangents are equal so the hypot matters, and the interval's values
# are normal: f(1.25) = (0.09375 * 3/sqrt(2) + 0.15625) * 2^-60. The exact oracle
# gives 0x3C16BA5919A791A3; the implementation's own rounding (hypot, four products,
# three sums) lands one ulp below, and that is the value pinned. Descending data is
# the exact negation — the sign comes from m_i, never from di. 3.3.2: NaN, both.
# [measured: scratch harness, not reproducible in-tree, 2026-10-01; 3.3.2, this tree, exact oracle]
var _g4_bx = _f64arr_alloc(4);
_f64arr_set(_g4_bx, 0, 0);
_f64arr_set(_g4_bx, 1, F64_ONE);
_f64arr_set(_g4_bx, 2, F64_TWO);
_f64arr_set(_g4_bx, 3, f64_from(3));
var _g4_by = _f64arr_alloc(4);
_f64arr_set(_g4_by, 0, f64_neg(_ce_p2(966)));
_f64arr_set(_g4_by, 1, 0);
_f64arr_set(_g4_by, 2, _ce_p2(0 - 60));
_f64arr_set(_g4_by, 3, _ce_p2(966));
var _g4_bd = _f64arr_alloc(4);
_f64arr_set(_g4_bd, 0, _ce_p2(966));
_f64arr_set(_g4_bd, 1, 0);
_f64arr_set(_g4_bd, 2, f64_neg(_ce_p2(0 - 60)));
_f64arr_set(_g4_bd, 3, f64_neg(_ce_p2(966)));
var _g4_bq = f64_add(F64_ONE, 0x3FD0000000000000);
assert_eq(calc_monotone_cubic(_g4_bx, _g4_by, 4, _g4_bq), 0x3C16BA5919A791A2,
  "calc_monotone_cubic: both ratios overflow -> 3/sqrt(2)-projected tangents (was NaN)");
assert_eq(calc_monotone_cubic(_g4_bx, _g4_bd, 4, _g4_bq), 0xBC16BA5919A791A2,
  "calc_monotone_cubic: descending data, both ratios overflow -> the exact negation");

# The tangent-space form is used ONLY when `root` overflows. Applied to every
# projection it changes 14,322 of 350,000 results on random full-mantissa sets, and
# on a 1,500-result sample of those it is not consistently closer to the exact
# oracle (the shipped form is closer 732 times, the tangent-space form 678, 90
# tie) — so the finite branch keeps 3.3.2's bits, all 350,000 of which are
# unchanged. This set fires the projection on a finite root; its value is the
# correctly rounded exact one, which the tangent-space form misses by 2 ulps.
# [measured: random-set probe on 3.3.2, this tree and that variant, plus the exact oracle, 2026-10-01]
var _g4_fx = _f64arr_alloc(4);
_f64arr_set(_g4_fx, 0, 0);
_f64arr_set(_g4_fx, 1, 0x3FE3C03D901978A6);
_f64arr_set(_g4_fx, 2, 0x3FED8B4BA8FC2380);
_f64arr_set(_g4_fx, 3, 0x3FF78C7145A0B111);
var _g4_fy = _f64arr_alloc(4);
_f64arr_set(_g4_fy, 0, 0x3FD6FFB7684D9D4E);
_f64arr_set(_g4_fy, 1, 0x3FF3977D06237E76);
_f64arr_set(_g4_fy, 2, 0x404270C4D2ADFDF4);
_f64arr_set(_g4_fy, 3, 0x4042B0336F6327FA);
assert_eq(calc_monotone_cubic(_g4_fx, _g4_fy, 4, 0x3FDA42317E6445F9), 0x3FE3C8425CE98C5A,
  "calc_monotone_cubic: a finite-root projection keeps 3.3.2's bits (here the correctly rounded value)");

# --- I. The controls the repair must KEEP passing. The guard says "not sorted",
# so it must still reject genuinely unsorted, duplicated and NaN abscissae —
# otherwise the fix is just a deletion wearing a comment.
var _ce_uy = _f64arr_alloc(4);
_f64arr_set(_ce_uy, 0, 0);
_f64arr_set(_ce_uy, 1, F64_ONE);
_f64arr_set(_ce_uy, 2, f64_from(4));
_f64arr_set(_ce_uy, 3, f64_from(9));

# ⚠ (a) The obvious control — a fully DESCENDING grid — is VACUOUS and was
# measured to be: with xs = [0,-1,-2,-3] the range gate x0 <= x <= xn rejects every
# query before the loop is entered, so it returns 0 with any guard at all,
# including none. A grid that only dips in the MIDDLE stays in range and reaches it.
# [measured: 0 of 129 sampled queries reach the loop on a descending grid]
var _ce_ux = _f64arr_alloc(4);
_f64arr_set(_ce_ux, 0, 0);
_f64arr_set(_ce_ux, 1, F64_TWO);
_f64arr_set(_ce_ux, 2, F64_ONE);
_f64arr_set(_ce_ux, 3, f64_from(3));
assert_eq(calc_monotone_cubic(_ce_ux, _ce_uy, 4, F64_HALF), 0,
  "calc_monotone_cubic: a mid-grid inversion is still rejected");

var _ce_dx = _f64arr_alloc(4);
_f64arr_set(_ce_dx, 0, 0);
_f64arr_set(_ce_dx, 1, F64_ONE);
_f64arr_set(_ce_dx, 2, F64_ONE);
_f64arr_set(_ce_dx, 3, F64_TWO);
assert_eq(calc_monotone_cubic(_ce_dx, _ce_uy, 4, F64_HALF), 0,
  "calc_monotone_cubic: a duplicated abscissa is still rejected (zero width)");

# ⭐ (b) NaN. This is why the repair is `f64_gt(hi, 0) == 0` and not a smaller
# threshold: `f64_lt(NaN, anything)` is 0, so the old shape — and an F64_TINY
# version of it — lets a NaN abscissa straight through and returns NaN. A
# not-greater test is false for NaN and rejects it.
var _ce_nx = _f64arr_alloc(4);
_f64arr_set(_ce_nx, 0, 0);
_f64arr_set(_ce_nx, 1, 0x7FF8000000000000);
_f64arr_set(_ce_nx, 2, F64_TWO);
_f64arr_set(_ce_nx, 3, f64_from(3));
assert_eq(calc_monotone_cubic(_ce_nx, _ce_uy, 4, F64_HALF), 0,
  "calc_monotone_cubic: a NaN abscissa is rejected, not propagated");

# ⭐ (c) SPAN-RELATIVE DISCRIMINATOR. A guard of the form `hi < eps*(xn - x0)` is
# scale-free and passes sweep H untouched, because hi/(xn-x0) is 1/3 at every
# scale there. Only a grid with ONE fine interval separates it from the sign test.
var _ce_rx = _f64arr_alloc(4);
_f64arr_set(_ce_rx, 0, 0);
_f64arr_set(_ce_rx, 1, _ce_p2(0 - 40));
_f64arr_set(_ce_rx, 2, F64_ONE);
_f64arr_set(_ce_rx, 3, F64_TWO);
var _ce_ry = _f64arr_alloc(4);
_f64arr_set(_ce_ry, 0, 0);
_f64arr_set(_ce_ry, 1, 0);
_f64arr_set(_ce_ry, 2, F64_ONE);
_f64arr_set(_ce_ry, 3, F64_TWO);
assert(calc_monotone_cubic(_ce_rx, _ce_ry, 4,
    f64_add(F64_ONE, F64_HALF)) != 0,
  "calc_monotone_cubic: one fine interval far from the query is not a rejection");

# === 3.3.3 W4: calc_monotone_cubic overflowing differences ===
# ⛔ Three naive differences overflowed on FINITE data, and the function returned NaN
# or +Inf where the data and the answer are both representable: the initial tangent
# 0.5 * (d[i-1] + d[i]), the y difference of a secant, and the x difference of a grid
# wider than DBL_MAX. Every fixture before the closing control was non-finite on the
# 3.3.2 bundle and on the tree without this repair. Each value is settled by an exact rational
# Fritsch-Carlson oracle that rounds once (the three repros and fixtures 1, 2, 3, 3b
# are its correctly rounded value; fixture 4 is 3 ulps from it), and each full-mantissa one
# by a SECOND CODE PATH as well: the unchanged in-range algorithm, run on the same
# set scaled into range by 1/4 (exact), gives the same bits — which is the repair's
# whole claim. The fixtures are full-mantissa so a lost doubling cannot cancel.
# [measured: fixture probe on the 3.3.2 bundle, the base tree and this tree, exact oracle; 2026-10-01]
fn _w4_mc3(x0, x1, x2, y0, y1, y2, q) {
    var xs = _f64arr_alloc(3);
    _f64arr_set(xs, 0, x0);
    _f64arr_set(xs, 1, x1);
    _f64arr_set(xs, 2, x2);
    var ys = _f64arr_alloc(3);
    _f64arr_set(ys, 0, y0);
    _f64arr_set(ys, 1, y1);
    _f64arr_set(ys, 2, y2);
    return calc_monotone_cubic(xs, ys, 3, q);
}
var _W4_Q = 0x3FD0000000000000;  # 1/4, the exact scale of the second code path
var _w4_p = _ce_p2(1023);
var _w4_n = f64_neg(_ce_p2(1023));

# (a) THE MIDPOINT. ys = [-2^1023, 0, 2^1023] on the unit grid is LINEAR data; both
# secants are 2^1023 and their sum overflowed. NaN everywhere, even at the knot.
assert_eq(_w4_mc3(0, F64_ONE, F64_TWO, _w4_n, 0, _w4_p, F64_HALF), 0xFFD0000000000000,
  "calc_monotone_cubic: overflowing tangent midpoint -> -2^1022 at x = 0.5 (was NaN)");
assert_eq(_w4_mc3(0, F64_ONE, F64_TWO, _w4_n, 0, _w4_p, F64_ONE), 0,
  "calc_monotone_cubic: overflowing tangent midpoint -> +0 at the knot x = 1 (was NaN)");
assert_eq(_w4_mc3(0, F64_ONE, F64_TWO, _w4_n, 0, _w4_p, f64_add(F64_ONE, F64_HALF)),
  0x7FD0000000000000, "calc_monotone_cubic: overflowing tangent midpoint -> 2^1022 at x = 1.5");
# Fixture 1: secants 1.18 and 1.92 times 2^1023, the query on the second interval.
assert_eq(_w4_mc3(0, 0x3FE6B4D8A2FA505B, 0x3FF395300FB59C72,
    0xFFDA220AC9E358E3, 0x7F8A1551588FED60, 0x7FE0350EE8DA4526, 0x3FE70EEAAC17AD1A),
  0x7F95DF8F80B7B2E1, "calc_monotone_cubic: full-mantissa midpoint overflow, exact value (was NaN)");
assert_eq(f64_div(_w4_mc3(0, 0x3FE6B4D8A2FA505B, 0x3FF395300FB59C72,
      f64_mul(0xFFDA220AC9E358E3, _W4_Q), f64_mul(0x7F8A1551588FED60, _W4_Q),
      f64_mul(0x7FE0350EE8DA4526, _W4_Q), 0x3FE70EEAAC17AD1A), _W4_Q),
  0x7F95DF8F80B7B2E1, "calc_monotone_cubic: fixture 1 = 4 x the in-range path on ys/4");

# (b) THE Y DIFFERENCE. 2^1023 - (-2^1023) overflowed, so the first secant was +Inf.
assert_eq(_w4_mc3(0, f64_from(4), f64_from(8), _w4_n, _w4_p, _w4_p, F64_TWO), 0x7FC0000000000000,
  "calc_monotone_cubic: overflowing y difference -> 2^1021 at x = 2 (was +Inf)");
# Fixture 2: the second interval's y difference is -2.6 * 2^1023; query on it.
assert_eq(_w4_mc3(0x4054920FAABB4704, 0x405AF0C52E48AF3C, 0x405BB8C829B733E0,
    0x7FDD3B786313C8F6, 0x7FE208E80C4994E4, 0xFFE7D20CDC4C27AE, 0x405B359E59059316),
  0x7FD3A577170CDD45, "calc_monotone_cubic: full-mantissa y-difference overflow, exact value (was +Inf)");
assert_eq(f64_div(_w4_mc3(0x4054920FAABB4704, 0x405AF0C52E48AF3C, 0x405BB8C829B733E0,
      f64_mul(0x7FDD3B786313C8F6, _W4_Q), f64_mul(0x7FE208E80C4994E4, _W4_Q),
      f64_mul(0xFFE7D20CDC4C27AE, _W4_Q), 0x405B359E59059316), _W4_Q),
  0x7FD3A577170CDD45, "calc_monotone_cubic: fixture 2 = 4 x the in-range path on ys/4");

# (c) THE X DIFFERENCE. A grid from -2^1023 to 2^1023 has hi = +Inf: the secant was 0
# and h10 = p10 * Inf. ⚠ This repro alone is weak: it is linear data queried at
# t = 1/2, where h10 and h11 cancel exactly — so it sees a LOST DOUBLING of either,
# but even a flattened secant gives 0.5. Fixtures 3 and 3b (t = 0.30) see the wide
# secant; 3b is monotone, so both of its tangents are non-zero (3 has an extremum at
# knot 1, whose tangent the sign condition zeroes, and cannot see h11).
# [measured: per-part mutants against this block, 2026-10-01]
var _w4_cx = _f64arr_alloc(2);
_f64arr_set(_w4_cx, 0, _w4_n);
_f64arr_set(_w4_cx, 1, _w4_p);
var _w4_cy = _f64arr_alloc(2);
_f64arr_set(_w4_cy, 0, 0);
_f64arr_set(_w4_cy, 1, F64_ONE);
assert_eq(calc_monotone_cubic(_w4_cx, _w4_cy, 2, 0), F64_HALF,
  "calc_monotone_cubic: grid wider than DBL_MAX -> 0.5 at x = 0 (was NaN)");
# Fixture 3: interval 0 is 2.5 * 2^1023 wide, ys near 1e5.
assert_eq(_w4_mc3(0xFFE51D6483A293A0, 0x7FE34E54F249528E, 0x7FEF176D15A73E4C,
    0x40F7C1A7AF16606D, 0x40F8E196364799CD, 0x40F3619B8318B361, 0xFFD1D1A93F065B20),
  0x40F82AEC6EE88C07, "calc_monotone_cubic: full-mantissa wide grid, exact value (was NaN)");
assert_eq(_w4_mc3(f64_mul(0xFFE51D6483A293A0, _W4_Q), f64_mul(0x7FE34E54F249528E, _W4_Q),
    f64_mul(0x7FEF176D15A73E4C, _W4_Q), 0x40F7C1A7AF16606D, 0x40F8E196364799CD,
    0x40F3619B8318B361, f64_mul(0xFFD1D1A93F065B20, _W4_Q)),
  0x40F82AEC6EE88C07, "calc_monotone_cubic: fixture 3 = the in-range path on xs/4");
# Fixture 3b: the same grid with the ordinates sorted.
assert_eq(_w4_mc3(0xFFE51D6483A293A0, 0x7FE34E54F249528E, 0x7FEF176D15A73E4C,
    0x40F3619B8318B361, 0x40F7C1A7AF16606D, 0x40F8E196364799CD, 0xFFD1D1A93F065B20),
  0x40F4B807CE6F3628, "calc_monotone_cubic: full-mantissa wide grid, monotone, exact value (was NaN)");
assert_eq(_w4_mc3(f64_mul(0xFFE51D6483A293A0, _W4_Q), f64_mul(0x7FE34E54F249528E, _W4_Q),
    f64_mul(0x7FEF176D15A73E4C, _W4_Q), 0x40F3619B8318B361, 0x40F7C1A7AF16606D,
    0x40F8E196364799CD, f64_mul(0xFFD1D1A93F065B20, _W4_Q)),
  0x40F4B807CE6F3628, "calc_monotone_cubic: fixture 3b = the in-range path on xs/4");
# Fixture 4: BOTH differences of interval 0 overflow (3.1 and 3.0 times 2^1023).
assert_eq(_w4_mc3(0xFFE9C3A5E7F1B2D4, 0x7FE7E1C2B9D4A6F3, 0x7FEF2B4C6D8E9A17,
    0xFFE5D2C7E9A3B1F8, 0x7FEA3E5C1F7B9D24, 0x7FD1B7D9E3C5A2F6, 0xFFD5C3E9D2A7B1F4),
  0xFFC1902FEDAB2070, "calc_monotone_cubic: x and y differences both overflow (was NaN)");
assert_eq(f64_div(_w4_mc3(f64_mul(0xFFE9C3A5E7F1B2D4, _W4_Q), f64_mul(0x7FE7E1C2B9D4A6F3, _W4_Q),
      f64_mul(0x7FEF2B4C6D8E9A17, _W4_Q), f64_mul(0xFFE5D2C7E9A3B1F8, _W4_Q),
      f64_mul(0x7FEA3E5C1F7B9D24, _W4_Q), f64_mul(0x7FD1B7D9E3C5A2F6, _W4_Q),
      f64_mul(0xFFD5C3E9D2A7B1F4, _W4_Q)), _W4_Q),
  0xFFC1902FEDAB2070, "calc_monotone_cubic: fixture 4 = 4 x the in-range path on xs/4, ys/4");

# ⚠ THE CONTROL: an infinite ABSCISSA is not a wide grid. Its halved width is still
# +Inf, so it keeps the naive quotient — here (MAX - (-MAX)) / Inf = Inf / Inf, NaN,
# which the next interval's tangent inherits, exactly as before the repair. A
# fallback that ignored the difference would hand that interval a finite value
# computed from a non-finite input.
var _w4_inf = _w4_mc3(f64_neg(F64_POS_INF), 0, F64_ONE,
  0xFFEFFFFFFFFFFFFF, 0x7FEFFFFFFFFFFFFF, 0, F64_HALF);
assert_eq(f64_eq(_w4_inf, _w4_inf), 0,
  "calc_monotone_cubic: an infinite abscissa beside an overflowing y difference stays NaN");

# === 3.3.3 R4calc: calc_monotone_cubic infinite tangents and the overflow gate ===
# ⛔ Each set in (a) to (d) has a secant whose exact slope is above DBL_MAX — the class
# the secant loop names and does not repair — so the tangents beside it are infinite.
# The projection's tangent-space branch (the G4 block above) made NaN of them on
# FINITE data, at DATA KNOTS too, where 3.3.2 returned the knot's own y, and replacing
# an infinite tangent by its limit then gave finite, wrong values (the R5calc block
# below). Such a set now gets 3.3.2's computation bit for bit, so every value pinned
# in (a) to (d) is 3.3.2's: a knot's own bits, a value an ulp from the exact
# Fritsch-Carlson one (an exact rational oracle, rounded once), or 3.3.2's NaN where
# the exact value is finite, each named. (e) pins the overflow gate on finite data.
# [measured: fixture probe on the 3.3.2 bundle, the base tree and this tree, exact oracle; 2026-10-01]
# ⛔ 3.3.4 — EVERY SET IN (a) TO (d) IS FINITE DATA WITH A SLOPE PAST DBL_MAX, and is now
# splined in extended range (calc_ext.cyr, _calcx_mc_ext): each pin below that held
# 3.3.2's value or NaN now holds the exact value rounded once — the value named here
# as exact — except where it says otherwise.
# [measured: fixture probe on the base tree and this tree, exact oracle; 2026-10-03; cycc 6.6.14]
fn _r4c_mc4(x0, x1, x2, x3, y0, y1, y2, y3, q) {
    var xs = _f64arr_alloc(4);
    _f64arr_set(xs, 0, x0);
    _f64arr_set(xs, 1, x1);
    _f64arr_set(xs, 2, x2);
    _f64arr_set(xs, 3, x3);
    var ys = _f64arr_alloc(4);
    _f64arr_set(ys, 0, y0);
    _f64arr_set(ys, 1, y1);
    _f64arr_set(ys, 2, y2);
    _f64arr_set(ys, 3, y3);
    return calc_monotone_cubic(xs, ys, 4, q);
}

# (a) THE OVERFLOWING WEIGHT. xs = [0, 0.5, 1.5, 2.5], ys = [-2^1023, 0, 1.5 * 2^1022,
# 1.75 * 2^1022]: interval 0's slope is 2^1024, so the knot-1 tangent is +Inf, and
# interval 1's |delta| = 1.5 * 2^1022 > DBL_MAX/3. The tangent-space branch formed
# 0 * 3|delta| = 0 * Inf for the knot-2 tangent and returned NaN at the knots 1.5 and
# 2.5. 3.3.2 returned these knots' y; so does this tree.
var _r4c_ah = 0x3FF8000000000000;  # 1.5
var _r4c_ay2 = 0x7FD8000000000000;  # 1.5 * 2^1022
var _r4c_ay3 = 0x7FDC000000000000;  # 1.75 * 2^1022
assert_eq(_r4c_mc4(0, F64_HALF, _r4c_ah, 0x4004000000000000, _w4_n, 0, _r4c_ay2, _r4c_ay3, _r4c_ah),
  _r4c_ay2, "calc_monotone_cubic: 3|delta| past DBL_MAX, knot x = 1.5 is y2 (was NaN)");
assert_eq(_r4c_mc4(0, F64_HALF, _r4c_ah, 0x4004000000000000, _w4_n, 0, _r4c_ay2, _r4c_ay3,
    0x4004000000000000), _r4c_ay3, "calc_monotone_cubic: 3|delta| past DBL_MAX, knot x = 2.5 is y3 (was NaN)");
# ⚠ Between those knots the value is finite and inside [y2, y3]. Through 3.3.3 it was
# 3.3.2's 0x7FD9800000000000, 0.38 of the interval's rise below the exact
# 0x7FDB07BB76E265E5, because the overflowed slope of interval 0 projected a tangent
# exact arithmetic leaves alone; 3.3.4 (the slope in extended range) returns the exact
# value, pinned below. NaN is tested first: every comparison with it is 0.
var _r4c_amid = _r4c_mc4(0, F64_HALF, _r4c_ah, 0x4004000000000000, _w4_n, 0, _r4c_ay2, _r4c_ay3, F64_TWO);
var _r4c_aok = 0;
if (f64_eq(_r4c_amid, _r4c_amid) == 1 && f64_lt(_r4c_amid, _r4c_ay2) == 0 && f64_lt(_r4c_ay3, _r4c_amid) == 0) {
    _r4c_aok = 1;
}
assert_eq(_r4c_aok, 1, "calc_monotone_cubic: 3|delta| past DBL_MAX, x = 2.0 is a number inside [y2, y3] (was NaN)");
assert_eq(_r4c_amid, 0x7FDB07BB76E265E5,
  "calc_monotone_cubic: 3|delta| past DBL_MAX, x = 2.0, exact (3.3.3: 3.3.2's 0x7FD9800000000000)");

# (b) AN INFINITE TANGENT BESIDE A SECANT IN 3.3.2's FLAT BAND. xs = [0, 2^-1000,
# 2^90], ys = [0, 2^30, 2^30 + 2^-22]: interval 0's slope is 2^1030, so the knot-1
# tangent is +Inf, and interval 1's secant is 2^-112, which 3.3.2's 1e-30 test
# flattens. The tangent-space branch returned NaN at all three queries; 3.3.2 and 3.3.3
# return y at both knots and 0x41D0000000000000 at 2^89, an ulp below the exact
# 0x41D0000000000001, which 3.3.4 returns.
var _r4c_bx1 = _ce_p2(0 - 1000);
var _r4c_by1 = _ce_p2(30);
var _r4c_by2 = f64_add(_ce_p2(30), _ce_p2(0 - 22));
assert_eq(_w4_mc3(0, _r4c_bx1, _ce_p2(90), 0, _r4c_by1, _r4c_by2, _r4c_bx1), 0x41D0000000000000,
  "calc_monotone_cubic: an infinite tangent, knot x = 2^-1000 is y1 (was NaN)");
assert_eq(_w4_mc3(0, _r4c_bx1, _ce_p2(90), 0, _r4c_by1, _r4c_by2, _ce_p2(89)), 0x41D0000000000001,
  "calc_monotone_cubic: an infinite tangent's interval at 2^89, exact (3.3.3: an ulp low; 3.3.2: NaN)");
assert_eq(_w4_mc3(0, _r4c_bx1, _ce_p2(90), 0, _r4c_by1, _r4c_by2, _ce_p2(90)), 0x41D0000000000001,
  "calc_monotone_cubic: an infinite tangent, knot x = 2^90 is y2 (was NaN)");
# Descending, the exact negation (3.3.3 returned the negation of 3.3.2's 0x41D0000000000000).
assert_eq(_w4_mc3(0, _r4c_bx1, _ce_p2(90), 0x8000000000000000, f64_neg(_r4c_by1), f64_neg(_r4c_by2),
    _ce_p2(89)), 0xC1D0000000000001, "calc_monotone_cubic: a -Inf tangent, the exact negation (3.3.3: an ulp low)");
# Full mantissa: a secant above 1e-30 beside the infinite tangent. 3.3.2's projection
# meets alpha = +Inf, so tau = 0 and that tangent is 0 * Inf: NaN on the whole
# interval, where the exact values are 0x41D00000003A3B21 and 0x41D00000004520D7. 3.3.3
# kept 3.3.2's NaN (the R5calc block below says why); 3.3.4 returns the exact values.
assert_eq(_w4_mc3(0, _r4c_bx1, F64_ONE, 0, _r4c_by1, 0x41D00000004F00F6, 0x3FD6FFB7684D9D4E), 0x41D00000003A3B21,
  "calc_monotone_cubic: an infinite tangent beside a unit-scale secant, interior, exact (3.3.3: NaN)");
assert_eq(_w4_mc3(0, _r4c_bx1, F64_ONE, 0, _r4c_by1, 0x41D00000004F00F6, F64_HALF), 0x41D00000004520D7,
  "calc_monotone_cubic: an infinite tangent beside a unit-scale secant, midpoint, exact (3.3.3: NaN)");

# (c) A -Inf TANGENT BESIDE A UNIT SECANT. xs = [0, 2^-1000, 1, 2], ys = [2^30, 1, -0,
# -1]: the knot-1 tangent is -Inf, so interval 1 was 3.3.2's NaN through 3.3.3 (the exact
# value at x = 0.5 is 0.125, 3.3.4's), and the knot-2 tangent is the zero the projection leaves, of
# the partner's own sign: the knot x = 1, whose ordinate is -0, returns -0, and
# x = 1.5 the exact -0.375.
var _r4c_zm = f64_neg(F64_ONE);
assert_eq(_r4c_mc4(0, _r4c_bx1, F64_ONE, F64_TWO, _r4c_by1, F64_ONE, 0x8000000000000000, _r4c_zm, F64_HALF),
  0x3FC0000000000000, "calc_monotone_cubic: a -Inf tangent beside a unit secant, 0.125 exact (3.3.3: NaN)");
assert_eq(_r4c_mc4(0, _r4c_bx1, F64_ONE, F64_TWO, _r4c_by1, F64_ONE, 0x8000000000000000, _r4c_zm, F64_ONE),
  0x8000000000000000, "calc_monotone_cubic: the zeroed partner keeps its sign, so the -0 knot stays -0 (bits)");
assert_eq(_r4c_mc4(0, _r4c_bx1, F64_ONE, F64_TWO, _r4c_by1, F64_ONE, 0x8000000000000000, _r4c_zm,
    _r4c_ah), 0xBFD8000000000000, "calc_monotone_cubic: the zeroed partner's own interval, -0.375 at x = 1.5");

# (d) BOTH TANGENTS INFINITE. xs = [-2^-1000, 0, 1, 1 + 2^-52], ys = [-2^30, 0, 1,
# 2^1000]: the slopes of intervals 0 and 2 are both past DBL_MAX, so interval 1 has
# two infinite tangents and no ratio between them. 3.3.2 and 3.3.3 returned NaN on
# the whole interval, its knots included, where the exact values are +0 at x = 0 and
# 0x3F900006C0000480 at x = 0.25; an equal split of the two, which the limit made,
# returned 0x3FD6BA5919A791A2 (0.355) there.
# [measured: fixture probe on the 3.3.2 bundle, the base tree and this tree, exact oracle; 2026-10-01]
var _r4c_ix3 = f64_add(F64_ONE, _ce_p2(0 - 52));
var _r4c_iy0 = f64_neg(_ce_p2(30));
assert_eq(_r4c_mc4(f64_neg(_r4c_bx1), 0, F64_ONE, _r4c_ix3, _r4c_iy0, 0, F64_ONE, _ce_p2(1000), 0), 0,
  "calc_monotone_cubic: two infinite tangents, the knot x = 0 is its +0 (3.3.3: NaN)");
assert_eq(_r4c_mc4(f64_neg(_r4c_bx1), 0, F64_ONE, _r4c_ix3, _r4c_iy0, 0, F64_ONE, _ce_p2(1000),
    0x3FD0000000000000), 0x3F900006C0000480,
  "calc_monotone_cubic: two infinite tangents, x = 0.25, exact (3.3.3: NaN)");

# (e) THE OVERFLOW GATE. W4 sends a secant through _calcx_mc_wide_secant only when a
# naive difference overflowed; in range the naive quotient is the correctly rounded
# one, and the halved form rounds a SUBNORMAL quotient at half scale. xs = [0,
# 2^1000], ys = [0, 3 * 2^-74] is linear data with the exact secant 3 * 2^-1074: the
# halved quotient is 1.5 * 2^-1074, rounded to 2 * 2^-1074 and doubled to 4, and at
# x = 2^998 the ungated form returns 0x3B4B000000000000 where the exact value is
# 0.75 * 2^-74. 3.3.2 flattened that secant (D068) and returned 0x3B3E000000000000.
# The full-mantissa set is the same shape; ungated, it returns 0xB8FE8518A195BE6D,
# 3 ulps from the exact value pinned.
# [measured: ungated-helper build against these fixtures, exact oracle; 2026-10-01]
var _r4c_gx = _f64arr_alloc(2);
_f64arr_set(_r4c_gx, 0, 0);
_f64arr_set(_r4c_gx, 1, _ce_p2(1000));
var _r4c_gy = _f64arr_alloc(2);
_f64arr_set(_r4c_gy, 0, 0);
_f64arr_set(_r4c_gy, 1, f64_mul(f64_from(3), _ce_p2(0 - 74)));
assert_eq(calc_monotone_cubic(_r4c_gx, _r4c_gy, 2, _ce_p2(998)), 0x3B48000000000000,
  "calc_monotone_cubic: an in-range subnormal secant takes the naive quotient (0.75 * 2^-74, exact)");
_f64arr_set(_r4c_gx, 1, 0x79529E423A3D6466);
_f64arr_set(_r4c_gy, 0, 0xB8FF845AA3026E4A);
_f64arr_set(_r4c_gy, 1, 0xB8FD6FE723AE2615);
assert_eq(calc_monotone_cubic(_r4c_gx, _r4c_gy, 2, 0x7941D9E6F80DAC57), 0xB8FE8518A195BE70,
  "calc_monotone_cubic: in range, full mantissa, the naive quotient (exact value)");

# === 3.3.3 R5calc: calc_monotone_cubic, a set with a non-finite secant is 3.3.2's ===
# ⛔ The limit (R4calc above) gave finite, monotone, WRONG values, some where 3.3.2 was
# right: on E2 below 0x38E0000000000000 at x = 0.5, where 3.3.2 gives 0x3900000000000000
# and the exact value is 0x38FFFFFFFFFFEE00, and on E1 0.125 where the exact value is
# about 0.5 and 3.3.2 returns NaN. A set with a non-finite secant now gets 3.3.2's whole
# computation, so each value here is 3.3.2's bits — its right answers and its NaNs — and
# each part of that computation is pinned where a 3.3.3 step would change it. Exact
# values come from an exact rational Fritsch-Carlson oracle, rounded once.
# [measured: fixture probe on the 3.3.2 bundle, the base tree and this tree, exact oracle; 2026-10-01]
# ⛔ 3.3.4 — THE FINITE SETS HERE ARE NOW SPLINED IN EXTENDED RANGE (calc_ext.cyr,
# _calcx_mc_ext), and each pin that held 3.3.2's bits holds the exact value rounded
# once, except the one marked; the sets with a NaN ordinate keep 3.3.2's computation.
# [measured: fixture probe on the base tree and this tree, exact oracle; 2026-10-03; cycc 6.6.14]
var _r5c_u1 = 0x3FF0000000000001;   # 1 + 2^-52
var _r5c_u2 = 0x3FF0000000000002;   # 1 + 2^-51
# E2: a secant in 3.3.2's flat band (2^-110 < 1e-30) beside two overflowing slopes.
# 3.3.2 flattens it, which exact arithmetic nearly does too: the next interval's own
# projection shrinks the shared tangent to about 9 * 2^-152.
assert_eq(_r4c_mc4(0, F64_ONE, _r5c_u1, _r5c_u2, 0, _ce_p2(0 - 110), _ce_p2(980), _ce_p2(1023), F64_HALF),
  0x38FFFFFFFFFFEE00, "calc_monotone_cubic: E2 at x = 0.5, exact (3.3.3: 3.3.2's 2^-111)");
assert_eq(_r4c_mc4(0, F64_ONE, _r5c_u1, _r5c_u2, 0, _ce_p2(0 - 110), _ce_p2(980), _ce_p2(1023),
    0x3FD0000000000000), 0x38E3FFFFFFFFF280,
  "calc_monotone_cubic: E2 at x = 0.25, exact (3.3.3: 3.3.2's 0x38E4000000000000)");
assert_eq(_r4c_mc4(0, F64_ONE, _r5c_u1, _r5c_u2, 0, f64_neg(_ce_p2(0 - 110)), f64_neg(_ce_p2(980)),
    f64_neg(_ce_p2(1023)), F64_HALF), 0xB8FFFFFFFFFFEE00, "calc_monotone_cubic: E2 descending, the exact negation");
# ON the 1e-30 boundary: a secant of exactly 0x39B4484BFEEBC2A0 is not below it, so 3.3.2
# projects, meets alpha = +Inf and returns NaN; one ulp below, it flattens.
# (3.3.4: no threshold remains; the two sets differ by their one ulp, as exact values do.)
assert_eq(_r4c_mc4(0, F64_ONE, _r5c_u1, _r5c_u2, 0, 0x39B4484BFEEBC2A0, _ce_p2(980), _ce_p2(1023), F64_HALF),
  0x39A4484BFEEBB737, "calc_monotone_cubic: E2 with a secant of exactly 1e-30, exact (3.3.3: NaN)");
assert_eq(_r4c_mc4(0, F64_ONE, _r5c_u1, _r5c_u2, 0, 0x39B4484BFEEBC29F, _ce_p2(980), _ce_p2(1023), F64_HALF),
  0x39A4484BFEEBB736, "calc_monotone_cubic: E2 with a secant an ulp below 1e-30, exact (3.3.3: the flat half)");
# E1: E2 with ys[1] = 1, a unit secant. 3.3.2 returns NaN on the interval (exact
# 0x3FDFFFFFFFFFEE00 at x = 0.5), and so did 3.3.3; the limit gave 0.125.
assert_eq(_r4c_mc4(0, F64_ONE, _r5c_u1, _r5c_u2, 0, F64_ONE, _ce_p2(980), _ce_p2(1023), F64_HALF),
  0x3FDFFFFFFFFFEE00, "calc_monotone_cubic: E1 at x = 0.5, exact (3.3.3: NaN; the limit: 0.125)");
# The MIRROR images, an infinite tangent on the RIGHT of the interval queried. mA is
# R4calc's (a) reflected: 3.3.2's 0xFFD99681D0723DA4 at x = 0.5, 0.36 of the rise from
# the exact 0xFFDB07BB76E265E5 (the unrepaired slope class's error). E3, E3 descending
# and Zd return 3.3.2's NaN, where the exact values are 0.125, -0.125 and -0.
# 3.3.4: an ulp from the exact value (0.63 ulp), where 3.3.3 was 0.36 of the rise off.
assert_eq(_r4c_mc4(0, F64_ONE, F64_TWO, 0x4004000000000000, 0xFFDC000000000000, 0xFFD8000000000000, 0,
    _ce_p2(1023), F64_HALF), 0xFFDB07BB76E265E4,
  "calc_monotone_cubic: mirror of (a), x = 0.5, an ulp from the exact ...E265E5 (3.3.3: 0xFFD99681D0723DA4)");
assert_eq(_w4_mc3(0, F64_ONE, _r5c_u1, 0, F64_ONE, _ce_p2(1000), F64_HALF), 0x3FC0000000000000,
  "calc_monotone_cubic: E3 (right tangent +Inf) at x = 0.5, 0.125 exact (3.3.3: NaN)");
assert_eq(_w4_mc3(0, F64_ONE, _r5c_u1, 0, _r4c_zm, f64_neg(_ce_p2(1000)), F64_HALF), 0xBFC0000000000000,
  "calc_monotone_cubic: E3 descending at x = 0.5, -0.125 exact (3.3.3: NaN)");
assert_eq(_w4_mc3(0, F64_ONE, _r5c_u1, 0x8000000000000000, _r4c_zm, f64_neg(_ce_p2(1000)), 0), 0x8000000000000000,
  "calc_monotone_cubic: Zd (a -0 knot, right tangent -Inf) at x = 0 is the knot's -0 (3.3.3: NaN)");
# AFTER the non-finite pair: xs = [0, 2^-52, 1, 2], ys = [2^1001, 2^1000, 2^-100, 0].
# Interval 1's 3.3.2 projection meets alpha = +Inf and writes a 0 into the knot-2
# tangent, where exact arithmetic leaves a large one that interval 2 then projects to
# 3 * delta. 3.3.2's flat test then zeroes interval 2: 0x39AB000000000000 at x = 1.25,
# 0.42 of the rise from the exact 0x399B000000000000. A 3.3.3 step on interval 2 reads
# that 0 and keeps the far tangent, farther still.
assert_eq(_r4c_mc4(0, _ce_p2(0 - 52), F64_ONE, F64_TWO, _ce_p2(1001), _ce_p2(1000), _ce_p2(0 - 100), 0,
    0x3FF4000000000000), 0x399B000000000000,
  "calc_monotone_cubic: after a non-finite pair (x = 1.25), exact (3.3.3: 3.3.2's 0x39AB000000000000)");
# BEFORE it, a NaN ordinate: xs = [0, 1, 2, 3], ys = [0, 2^-90, 2^1000, NaN]. Interval 0's
# own tangents are finite and its projection overflows; 3.3.2 returns NaN, and so does
# this tree, where a 3.3.3 step would return 2^-93, a value the NaN's own interval can
# move.
var _r5c_v2 = _r4c_mc4(0, F64_ONE, F64_TWO, 0x4008000000000000, 0, _ce_p2(0 - 90), _ce_p2(1000),
  0x7FF8000000000000, F64_HALF);
assert_eq(f64_eq(_r5c_v2, _r5c_v2), 0, "calc_monotone_cubic: before a NaN ordinate -> 3.3.2's NaN, not a finite guess");
# The overflow repairs stayed out of such a set in 3.3.3: a y difference past DBL_MAX
# beside an overflowing slope kept 3.3.2's +Inf, and an overflowing midpoint 3.3.2's NaN;
# 3.3.4 gives the exact 2^1021 and -2^1022 (finite data). A grid wider than DBL_MAX
# beside a NaN ordinate keeps 3.3.2's NaN.
assert_eq(_r4c_mc4(0, f64_from(4), f64_from(8), 0x4020000000000001, _w4_n, _w4_p, _w4_p,
    f64_sub(_w4_p, _ce_p2(1000)), F64_TWO), 0x7FC0000000000000,
  "calc_monotone_cubic: a y difference past DBL_MAX in such a set, 2^1021 exact (3.3.3: +Inf)");
assert_eq(_r4c_mc4(0, F64_ONE, F64_TWO, f64_add(F64_TWO, _ce_p2(0 - 51)), _w4_n, 0, _w4_p,
    f64_sub(_w4_p, _ce_p2(1000)), F64_HALF), 0xFFD0000000000000,
  "calc_monotone_cubic: an overflowing midpoint in such a set, -2^1022 exact (3.3.3: NaN)");
var _r5c_wn = _r4c_mc4(_w4_n, _w4_p, f64_add(_w4_p, _ce_p2(971)), f64_add(_w4_p, _ce_p2(972)), 0, F64_ONE, F64_TWO,
  0x7FF8000000000000, 0);
assert_eq(f64_eq(_r5c_wn, _r5c_wn), 0, "calc_monotone_cubic: a wide interval beside a NaN ordinate: 3.3.2's NaN");

# === 3.3.3 R5calc: calc_monotone_cubic, an underflowing wide grid and a subnormal width ===
# ⛔ A grid wider than DBL_MAX whose slope underflows was refused through 3.3.3 as 3.3.2
# refused it: xs = [-2^1023, 2^1023], ys = [0, 2^-60] has the slope 2^-1084, which the
# halved quotient rounds to 0; that flat segment gave 0x3C2B000000000000 at x = 2^1022,
# 0.094 of the rise from the exact 0x3C28000000000000, where 3.3.2 returns NaN. 3.3.4
# carries the slope in extended range and returns the exact value. An exact underflowed
# slope was kept all along: ys = [0, 1] (2^-1024) gives the exact 0.75.
# [measured: fixture probe on the 3.3.2 bundle, the base tree and this tree, exact oracle; 2026-10-01]
var _r5c_wx = _f64arr_alloc(2);
_f64arr_set(_r5c_wx, 0, _w4_n);
_f64arr_set(_r5c_wx, 1, _w4_p);
var _r5c_wy = _f64arr_alloc(2);
_f64arr_set(_r5c_wy, 0, 0);
_f64arr_set(_r5c_wy, 1, _ce_p2(0 - 60));
assert_eq(calc_monotone_cubic(_r5c_wx, _r5c_wy, 2, _ce_p2(1022)), 0x3C28000000000000,
  "calc_monotone_cubic: a wide grid whose slope underflows, exact (3.3.3: NaN)");
_f64arr_set(_r5c_wy, 1, F64_ONE);
assert_eq(calc_monotone_cubic(_r5c_wx, _r5c_wy, 2, _ce_p2(1022)), 0x3FE8000000000000,
  "calc_monotone_cubic: a wide grid whose slope is exactly 2^-1024 -> 0.75, exact");
# ⛔ A SUBNORMAL WIDTH: p10 * h rounds to a multiple of 2^-1074. xs = [0, 5 * 2^-1074],
# ys = [-2^-87, 0] is linear data; 3.3.2 returned 0xBA7645A1CAC08312 at x = 2^-1074,
# 0.10 of the rise from the exact -0.8 * 2^-87, which the order p * (h * m) gives.
# Beside a tangent-space interval the same rounding turned 3.3.2's NaN finite and wrong:
# the second set (from the reviewers' generator) returned 0xBA8CB933D447E183 at 2^-1074,
# 0.072 of the rise off; it now gives 0xBA8FB1E0EA3DA964, an ulp from the exact value.
# A set with a non-finite secant kept 3.3.2's order in 3.3.3: the third set (interval 1's
# slope is 2^1072) returned 3.3.2's NaN at 5 * 2^-1074, where the other order gives -Inf;
# 3.3.4 returns its exact value, 0x3FF1C00000000000.
# [measured: fixture probe on the 3.3.2 bundle, the base tree, this tree and an ungated build; 2026-10-01]
var _r5c_sx = _f64arr_alloc(3);
_f64arr_set(_r5c_sx, 0, 0);
_f64arr_set(_r5c_sx, 1, 5);
var _r5c_sy = _f64arr_alloc(3);
_f64arr_set(_r5c_sy, 0, f64_neg(_ce_p2(0 - 87)));
_f64arr_set(_r5c_sy, 1, 0);
assert_eq(calc_monotone_cubic(_r5c_sx, _r5c_sy, 2, 1), 0xBA7999999999999A,
  "calc_monotone_cubic: a subnormal width, linear data, x = 2^-1074 -> -0.8 * 2^-87, exact");
_f64arr_set(_r5c_sx, 2, 0x216FF442A831A4E9);
_f64arr_set(_r5c_sy, 0, 0xBA94A279188024F2);
_f64arr_set(_r5c_sy, 2, 0x1E7EDC1CEDE13B49);
assert_eq(calc_monotone_cubic(_r5c_sx, _r5c_sy, 3, 1), 0xBA8FB1E0EA3DA964,
  "calc_monotone_cubic: a subnormal width beside a tangent-space interval (3.3.2: NaN)");
_f64arr_set(_r5c_sx, 1, 4);
_f64arr_set(_r5c_sx, 2, 8);
_f64arr_set(_r5c_sy, 0, F64_ONE);
_f64arr_set(_r5c_sy, 1, F64_ONE);
_f64arr_set(_r5c_sy, 2, F64_TWO);
assert_eq(calc_monotone_cubic(_r5c_sx, _r5c_sy, 3, 5), 0x3FF1C00000000000,
  "calc_monotone_cubic: a subnormal width beside an overflowing slope, exact (3.3.3: NaN)");

# === 3.3.3 R5calc: calc_monotone_cubic, the tangent-space weight's order ===
# The weight is applied as (m/hypot * |delta|) * 3. With finite tangents this branch has
# |delta| < sqrt(2), so the order changes rounding only; these two full-mantissa sets
# (from the reviewers' generator; 3.3.2 had both wrong) are where it gives the exact
# value, and (m/hypot) * (3|delta|) does not: the first set's m_i line gives
# 0xA0114FE66D300840 and its m_i+1 line 0xA0114FE66D30083A; the second set's m_i line
# gives 0x8D5806D283B3DFA7.
# [measured: fixture probe on this tree and per-line reverted builds, exact oracle; 2026-10-01]
var _r5c_ox = _f64arr_alloc(7);
var _r5c_oy = _f64arr_alloc(7);
_f64arr_set(_r5c_ox, 0, 0x52EEC83E2FFDE808);
_f64arr_set(_r5c_ox, 1, 0x52EEC83E2FFDE809);
_f64arr_set(_r5c_ox, 2, 0x5360090773A07B27);
_f64arr_set(_r5c_ox, 3, 0x53600E128A8EEB57);
_f64arr_set(_r5c_ox, 4, 0x536011B59EE58232);
_f64arr_set(_r5c_ox, 5, 0x536011C2F931162E);
_f64arr_set(_r5c_ox, 6, 0x5390A1C5B08B6997);
_f64arr_set(_r5c_oy, 0, 0x7F12626FBCD40634);
_f64arr_set(_r5c_oy, 1, 0xFF692649241A1659);
_f64arr_set(_r5c_oy, 2, 0x7EB594BB5AC700A7);
_f64arr_set(_r5c_oy, 3, 0x80061B7F2A148A5E);
_f64arr_set(_r5c_oy, 4, 0xA05627069B8414EA);
_f64arr_set(_r5c_oy, 5, 0xFE86E6B633C38F6C);
_f64arr_set(_r5c_oy, 6, 0xFF6FC00FF97FEF2F);
assert_eq(calc_monotone_cubic(_r5c_ox, _r5c_oy, 7, 0x53600EFB4FA4910E), 0xA0114FE66D30083C,
  "calc_monotone_cubic: tangent-space weight order, both lines (exact value)");
_f64arr_set(_r5c_ox, 0, 0x4333771C0F6A63CB);
_f64arr_set(_r5c_ox, 1, 0x43337B918EBCB8FB);
_f64arr_set(_r5c_ox, 2, 0x43DE37EE032CB1F9);
_f64arr_set(_r5c_ox, 3, 0x43EB5A70B46FAEE0);
_f64arr_set(_r5c_ox, 4, 0x61854253998C7F7A);
_f64arr_set(_r5c_ox, 5, 0x61854253998C7F7B);
_f64arr_set(_r5c_oy, 0, 0x7EA0DCDD9C33CF4C);
_f64arr_set(_r5c_oy, 1, 0x80004A61F94A9A17);
_f64arr_set(_r5c_oy, 2, 0x912E3BA4C70E2398);
_f64arr_set(_r5c_oy, 3, 0xFEAD6A7361A2EC7A);
_f64arr_set(_r5c_oy, 4, 0xE82C07DF6D3A0852);
_f64arr_set(_r5c_oy, 5, 0xFF5410D85BD89AA8);
assert_eq(calc_monotone_cubic(_r5c_ox, _r5c_oy, 6, 0x43337B918EBCB8FC), 0x8D5806D283B3DFA8,
  "calc_monotone_cubic: tangent-space weight order, the m_i line (exact value)");

# === 3.3.4: calc_monotone_cubic, slopes outside the f64 range ===
test_group("3.3.4: calc_monotone_cubic, slopes outside the f64 range");
# ⛔ A SET OF FINITE DOUBLES WHOSE EXACT SLOPE IS PAST DBL_MAX OR BELOW DBL_MIN was 3.3.2's
# computation through 3.3.3: NaN for the first (xs = [0, 1], ys = [-2^1023, 2^1023] at
# x = 0.25, where the value is -2^1022) and a flattened segment for the second (xs = [0,
# 2^100], ys = [0, 2^-1000] at 2^98 gave 0x0144000000000000, where it is 2^-1002). Such a
# set is now splined with slopes and tangents carried as mantissa and exponent
# (calc_ext.cyr, _calcx_mc_ext), and so is a finite-secant set whose tangent ratio
# underflows before a projection. Expected values are an exact rational Fritsch-Carlson
# oracle's, rounded once. The fixtures after the repros are the sweep sets that each
# extended-range mutant first gets wrong.
# [measured: repros and five sweeps (2,539,979 results), base tree and this tree, exact oracle; 2026-10-03]
var _mc34_x = _f64arr_alloc(8);
var _mc34_y = _f64arr_alloc(8);
var _mc34_n = 0;
var _mc34_v = 0;
fn _mc34_set(n) {
    _mc34_n = n;
    return 0;
}
fn _mc34_xy(i, x, y) {
    _f64arr_set(_mc34_x, i, x);
    _f64arr_set(_mc34_y, i, y);
    return 0;
}
fn _mc34_at(q) { return calc_monotone_cubic(_mc34_x, _mc34_y, _mc34_n, q); }

_mc34_set(2);
_mc34_xy(0, 0, 0xFFE0000000000000);
_mc34_xy(1, F64_ONE, 0x7FE0000000000000);
assert_eq(_mc34_at(0x3FD0000000000000), 0xFFD0000000000000,
  "calc_monotone_cubic: slope 2^1024, x = 0.25 -> -2^1022 exact (3.3.3: NaN)");
_mc34_v = _mc34_at(0x7FF8000000000000);
assert_eq(f64_eq(_mc34_v, _mc34_v), 0, "calc_monotone_cubic: slope 2^1024, a NaN query stays NaN");
_mc34_xy(0, 0, 0x7FE0000000000000);
_mc34_xy(1, F64_ONE, 0xFFE0000000000000);
assert_eq(_mc34_at(0x3FD0000000000000), 0x7FD0000000000000,
  "calc_monotone_cubic: slope -2^1024, x = 0.25 -> 2^1022 exact (3.3.3: NaN)");
_mc34_xy(0, 0, 0);
_mc34_xy(1, 0x4630000000000000, 0x0170000000000000);
assert_eq(_mc34_at(0x4610000000000000), 0x0150000000000000,
  "calc_monotone_cubic: slope 2^-1100, x = 2^98 -> 2^-1002 exact (3.3.3: 0x0144000000000000)");
# The ratio underflow: a unit grid whose knot-1 tangent is 2^-1549 of interval 1's secant.
_mc34_set(4);
_mc34_xy(0, 0, 0);
_mc34_xy(1, F64_ONE, 0x99AF949826BCF8CB);
_mc34_xy(2, F64_TWO, 0xFA88AB0F612CE1B0);
_mc34_xy(3, 0x4008000000000000, 0xFB0B3BA79C6E8FBA);
assert_eq(_mc34_at(F64_HALF), 0x999F13DDD4A83580,
  "calc_monotone_cubic: a tangent ratio below DBL_MIN, x = 0.5, exact (3.3.3: the chord's midpoint)");
# Non-finite data keeps the previous computation: an infinite abscissa ends the grid, and
# the knot x = 1 is NaN as before (the extended path would read +Inf as a finite width).
_mc34_set(3);
_mc34_xy(0, 0, 0);
_mc34_xy(1, F64_ONE, F64_ONE);
_mc34_xy(2, F64_POS_INF, F64_TWO);
_mc34_v = _mc34_at(F64_ONE);
assert_eq(f64_eq(_mc34_v, _mc34_v), 0,
  "calc_monotone_cubic: an infinite abscissa keeps the previous path (NaN at x = 1)");
assert_eq(_mc34_at(F64_HALF), 0x3FE4000000000000,
  "calc_monotone_cubic: an infinite abscissa keeps the previous path (0.625 at x = 0.5)");
# A NaN query on a grid wider than DBL_MAX: the Hermite form alone would not make it NaN
# there (t would be finite), so the extended path tests it first.
_mc34_set(2);
_mc34_xy(0, 0xFFE0000000000000, 0);
_mc34_xy(1, 0x7FE0000000000000, 0x3C30000000000000);
_mc34_v = _mc34_at(0x7FF8000000000000);
assert_eq(f64_eq(_mc34_v, _mc34_v), 0,
  "calc_monotone_cubic: a wide grid with a slope below DBL_MIN, a NaN query is NaN");
assert_eq(_mc34_at(0x7FD0000000000000), 0x3C28000000000000,
  "calc_monotone_cubic: a wide grid with a slope below DBL_MIN, x = 2^1022, exact (3.3.3: NaN)");
# A ratio that underflows ONTO A ZEROED TANGENT is not lost (m_i = 0 whatever the ratio):
# this set's projection runs with alpha = 0 from a zeroed m_i and stays on the f64 path,
# whose value is the exact one; the extended path, taken needlessly, is an ulp off.
_mc34_set(4);
_mc34_xy(0, 0, 0);
_mc34_xy(1, 0x3E45C6C6CA393801, 0x0C99125767A5293B);
_mc34_xy(2, 0x3E6E1052AF0D00E3, 0x8E695A2CC0D40655);
_mc34_xy(3, 0x3E810381C6FC9525, 0xB07BFC8E90C7A106);
assert_eq(_mc34_at(0x3E7A3B491B78D1C4), 0xB06B716FB1BF3279,
  "calc_monotone_cubic: a zeroed tangent's ratio is not a lost one: the f64 path, exact");
_mc34_set(3);
_mc34_xy(0, 0xFFB9D7CD1D5C4825, 0x119E592075305DB7);
_mc34_xy(1, 0xFFAB439130D5F64F, 0x11B88C78907F9669);
_mc34_xy(2, 0x7FC921EB139F7110, 0x11BE40965D698C8B);
