# The in-circle floor's constant term, through delaunay_2d: the four sites of the
# floor assertion above. Without the + 1 the mesh is not locally Delaunay.
var e35_m6 = vec_new();
vec_push(e35_m6, hvec2_new(0x2F21_DAA2_529D_B348, 0x0000_010C_9605_8AA3));
vec_push(e35_m6, hvec2_new(0x0000_010C_9605_8AA5, 0xAF21_DAA2_529D_B348));
vec_push(e35_m6, hvec2_new(0xAF21_DAA2_529D_B348, 0x8000_010C_9605_8AA3));
vec_push(e35_m6, hvec2_new(0x8000_010C_9605_8AA3, 0x2F21_DAA2_529D_B348));
store64(e35_w, 1); store64(e35_w + 8, 0); store64(e35_w + 16, 2);
store64(e35_w + 24, 2); store64(e35_w + 32, 0); store64(e35_w + 40, 3);
assert_eq(_dl_list_diff(delaunay_2d(e35_m6, 4), _e35_list(e35_w, 6)), 0,
  "3.3.5 delaunay_2d: the floor's four tiny sites give [1 0 2, 2 0 3]");

# The exact paths' scratch buffers belong to one delaunay_2d call. A pointer cached by
# an earlier call survived a caller's alloc_reset() (`_COL_O2D_BUF` through 3.3.4, and
# `_COL_BI_BUF` in the first 3.3.5 draft): the regular 150-gon triangulated, then
# alloc_reset(), then rebuilt and triangulated again printed `vec: index out of
# bounds` and exited 1, and the wide square plus (DBL_MAX, 1) returned a corrupt list.
# [measured: scratch probe across alloc_reset(), 3.3.4, the draft and this tree, 2026-10-11; cycc 6.6.14]
# A suite cannot call alloc_reset() -- every fixture above would dangle -- so the stale
# pointers are planted instead: two filled canary blocks named as the cached buffers,
# which a call that clears both on entry never writes. The square with a site on an
# edge reaches both paths: that site is exactly collinear with the edge (the
# expansion), and a ghost's leading term vanishes exactly (the integers).
var e35_cbi = alloc(_COL_BI_NSLOT * _COL_BI_SLOT);
var e35_co = alloc(40 * 8);
for (var e35_k = 0; e35_k < _COL_BI_NSLOT * _COL_BI_SLOT; e35_k = e35_k + 8) {
    store64(e35_cbi + e35_k, 0x5A5A_5A5A_5A5A_5A5A);
}
for (var e35_k = 0; e35_k < 40 * 8; e35_k = e35_k + 8) { store64(e35_co + e35_k, 0x5A5A_5A5A_5A5A_5A5A); }
fn _e35_canary_hits(buf, nbytes) {
    var hits = 0;
    for (var i = 0; i < nbytes; i = i + 8) {
        if (load64(buf + i) != 0x5A5A_5A5A_5A5A_5A5A) { hits = hits + 1; }
    }
    return hits;
}
var e35_sq = vec_new();
vec_push(e35_sq, hvec2_new(0, 0));
vec_push(e35_sq, hvec2_new(f64_from(4), 0));
vec_push(e35_sq, hvec2_new(f64_from(4), f64_from(4)));
vec_push(e35_sq, hvec2_new(0, f64_from(4)));
vec_push(e35_sq, hvec2_new(F64_TWO, 0));
_COL_BI_BUF = e35_cbi;
_COL_O2D_BUF = e35_co;
var e35_sqt = delaunay_2d(e35_sq, 5);
assert_eq(_e35_canary_hits(e35_cbi, _COL_BI_NSLOT * _COL_BI_SLOT), 0,
  "scratch buffers: an integer-path buffer left from an earlier call is not written");
assert_eq(_e35_canary_hits(e35_co, 40 * 8), 0,
  "scratch buffers: an expansion buffer left from an earlier call is not written");
store64(e35_w, 1); store64(e35_w + 8, 2); store64(e35_w + 16, 4);
store64(e35_w + 24, 2); store64(e35_w + 32, 3); store64(e35_w + 40, 4);
store64(e35_w + 48, 3); store64(e35_w + 56, 0); store64(e35_w + 64, 4);
assert_eq(_dl_list_diff(e35_sqt, _e35_list(e35_w, 9)), 0,
  "scratch buffers: the square with a site on an edge gives [1 2 4, 2 3 4, 3 0 4]");
# A buffer that cannot be allocated is the empty result, not a write near address 0.
# ALLOC_MAX is lowered, for this one call, between the expansion buffer's size and the
# integer slots' (_COL_BI_NSLOT * _COL_BI_SLOT bytes); the vanishing ghost term needs them.
var e35_amax = ALLOC_MAX;
ALLOC_MAX = 8192;
var e35_nomem = delaunay_2d(e35_sq, 5);
ALLOC_MAX = e35_amax;
assert_eq(vec_len(e35_nomem), 0, "scratch buffers: no memory for the integer path gives the empty result");
assert_eq(_dl_list_diff(delaunay_2d(e35_sq, 5), _e35_list(e35_w, 9)), 0,
  "scratch buffers: with memory back, the same call gives the mesh again");
# Each buffer's guard on its own, called directly with nothing allocatable: the
# expansion and the integers each answer 0 for a counter-clockwise triple and raise
# the flag, instead of writing at an address near 0.
var e35_amax2 = ALLOC_MAX;
_COL_O2D_BUF = 0;
_COL_BI_BUF = 0;
_COL_DL_NOMEM = 0;
ALLOC_MAX = 64;
var e35_r1 = _col_o2d_exact_raw(0, 0, F64_ONE, 0, 0, F64_ONE);
var e35_f1 = _COL_DL_NOMEM;
_COL_DL_NOMEM = 0;
var e35_r2 = _col_bi_pp(F64_ONE, 0, F64_ONE, 0, 0, 0, 0, 0, 0 - 1);
var e35_f2 = _COL_DL_NOMEM;
ALLOC_MAX = e35_amax2;
_COL_DL_NOMEM = 0;
assert_eq(e35_r1 * 10 + e35_f1, 1, "scratch buffers: no memory for the expansion gives 0 and the flag");
assert_eq(e35_r2 * 10 + e35_f2, 1, "scratch buffers: no memory for the integers gives 0 and the flag");

test_group("2.9.3 _col_point_in_tri is BOUNDARY-INCLUSIVE, as ear clipping needs");

# Its doc comment claimed "(2D, strict interior)" until 2.9.3 and was false: an
# edge point makes that edge's signed area exactly 0, which sets neither
# has_neg nor has_pos, so "all signs agree" holds and it returns 1. The code is
# right -- ear clipping must not cut an ear when another vertex lies ON its
# boundary -- so only the contract was wrong. Pinned here so the next reader who
# trusts a comment over the code is contradicted by a test instead.
# Triangle (0,0) (4,0) (0,4).
var pit_z = 0;
var pit_4 = f64_from(4);
assert_eq(_col_point_in_tri(F64_ONE, F64_ONE, pit_z, pit_z, pit_4, pit_z, pit_z, pit_4), 1,
  "point_in_tri: strict interior -> 1");
assert_eq(_col_point_in_tri(F64_TWO, pit_z, pit_z, pit_z, pit_4, pit_z, pit_z, pit_4), 1,
  "point_in_tri: ON an edge -> 1 (INCLUSIVE, not strict)");
assert_eq(_col_point_in_tri(pit_z, pit_z, pit_z, pit_z, pit_4, pit_z, pit_z, pit_4), 1,
  "point_in_tri: exactly ON a vertex -> 1");
assert_eq(_col_point_in_tri(f64_from(3), f64_from(3), pit_z, pit_z, pit_4, pit_z, pit_z, pit_4), 0,
  "point_in_tri: strictly outside -> 0");
assert_eq(_col_point_in_tri(f64_neg(F64_ONE), F64_ONE, pit_z, pit_z, pit_4, pit_z, pit_z, pit_4), 0,
  "point_in_tri: outside past an edge -> 0");

test_group("2.9.3 _col_dl_ic_g1: the one-ghost answer is order-free");

# The last open half of docs/development/issues/archived/2026-08-06-ghost-incircle-g1-g3-assume-ccw.md,
# closed here in 2.9.3. g2 was made order-free in 2.9.1 and g3 became the
# constant 1; g1 was the only helper still reading the triple's winding out of
# the CCW storage convention instead of forming it. Until 2.9.3 the whole entry point was therefore
# CCW-only, and the evidence for that was a Python transcription rather than an
# assertion in this suite. It is an assertion now.
_dlg1_run();
assert_eq(_DLG1_PROBES, 1800,
  "g1: probe grid ran (4 edges x 25 query points x 3 ghost directions x 6 orderings)");
assert_eq(_DLG1_BAD, 0,
  "g1: all six orderings of a one-ghost triple agree (pre-2.9.3 the anti-cyclic three inverted)");
assert_gt(_DLG1_TIE, 0,
  "g1: the grid actually reaches the (b - a) x u_k == 0 case, so the fix cannot ignore it");

# ⚠ The grid above asserts ORDER-CONSISTENCY, and consistency alone is too weak
# for the apex fallback: negating the fallback's sign flips every ordering
# together, so the six still agree and the grid stays green -- that mutant
# survived the grid, and the four assertions below are what killed it.
# [measured: scratch mutation run, not reproducible in-tree]
# To re-run it: negate the apex fallback in _col_dl_ic_g1 and run this suite;
# _DLG1_BAD stays 0 while the four assertions below go red. It is the same weakness the g3 harness records
# below, and it needs the same answer: a CORRECTNESS assertion against a truth
# derived independently.
#
# Edge a = (0,0), b = (2,4) is parallel to u_0 = (1,2), so the ghost direction
# cannot supply the winding and the apex must. Two apexes on OPPOSITE sides of
# line(a, b) must give OPPOSITE answers for the same query point -- that is the
# whole content of the fallback, and no single-sided fixture can state it.
# Truths from the exact circumcircle of {a, b, A + 1e30*u_0} in Fractions:
#   A = ( 5, 1), (b-a)x(A-a) = -18:  p=(3,1) -> 1   p=(-3,1) -> 0
#   A = (-5, 1), (b-a)x(A-a) = +22:  p=(3,1) -> 0   p=(-3,1) -> 1
var g1_apr = vec_new();
vec_push(g1_apr, hvec2_new(f64_from(5), F64_ONE));        # apex right of ab
vec_push(g1_apr, hvec2_new(0, 0));                        # a
vec_push(g1_apr, hvec2_new(F64_TWO, f64_from(4)));        # b
assert_eq(_col_dl_ic_g1(g1_apr, 1, 2, 0, f64_from(3), F64_ONE), 1,
  "g1: edge parallel to u_0, apex right of it -> p=(3,1) is inside");
assert_eq(_col_dl_ic_g1(g1_apr, 1, 2, 0, f64_neg(f64_from(3)), F64_ONE), 0,
  "g1: edge parallel to u_0, apex right of it -> p=(-3,1) is outside");

var g1_apl = vec_new();
vec_push(g1_apl, hvec2_new(f64_neg(f64_from(5)), F64_ONE));   # apex LEFT of ab
vec_push(g1_apl, hvec2_new(0, 0));
vec_push(g1_apl, hvec2_new(F64_TWO, f64_from(4)));
assert_eq(_col_dl_ic_g1(g1_apl, 1, 2, 0, f64_from(3), F64_ONE), 0,
  "g1: same edge, apex on the OTHER side -> p=(3,1) flips to outside");
assert_eq(_col_dl_ic_g1(g1_apl, 1, 2, 0, f64_neg(f64_from(3)), F64_ONE), 1,
  "g1: same edge, apex on the OTHER side -> p=(-3,1) flips to inside");

_dlg3_run();
assert_eq(_DLG3_PROBES, 1800,
  "g3: probe grid ran (4 scales x 3 apexes x 25 query points x 6 orderings)");
assert_eq(_DLG3_BAD_CYC, 0,
  "g3: every CYCLIC ordering answers inside, at every scale");
assert_eq(_DLG3_BAD_ANTI, 0,
  "g3: every ANTI-CYCLIC ordering answers inside too (2.9.1 answered 0 for all of them)");

# Spot checks naming the two orderings explicitly, so a failure reads as a
# winding bug rather than as a grid-plumbing bug. nr = 1, so the ghosts are 1, 2
# and 3 and the apex is the single real point.
var g3_pts = vec_new();
vec_push(g3_pts, hvec2_new(0, 0));
assert_eq(_col_dl_incircle(g3_pts, 1, 1, 2, 3, F64_ONE, F64_ONE), 1,
  "g3: (G0, G1, G2) -- cyclic, CCW -- is inside");
assert_eq(_col_dl_incircle(g3_pts, 1, 1, 3, 2, F64_ONE, F64_ONE), 1,
  "g3: (G0, G2, G1) -- anti-cyclic, CW -- is the SAME question, so also inside");

# The apex itself, and a point 1e18 out: no finite bound on p exists, because M
# is symbolic. Both must answer inside under both windings.
assert_eq(_col_dl_incircle(g3_pts, 1, 1, 2, 3, 0, 0), 1,
  "g3: p at the apex is inside (cyclic)");
assert_eq(_col_dl_incircle(g3_pts, 1, 3, 2, 1, 0, 0), 1,
  "g3: p at the apex is inside (anti-cyclic)");
var g3_far = f64_mul(f64_from(1000000000), f64_from(1000000000));
assert_eq(_col_dl_incircle(g3_pts, 1, 2, 3, 1, g3_far, f64_neg(g3_far)), 1,
  "g3: p at 1e18 is still inside (cyclic) -- M is unbounded, so p cannot outrun it");
assert_eq(_col_dl_incircle(g3_pts, 1, 2, 1, 3, g3_far, f64_neg(g3_far)), 1,
  "g3: p at 1e18 is still inside (anti-cyclic)");

test_group("2.8.4 _numx_use_fft: the dispatch decision itself");

# The gate is a DECISION FUNCTION, and until 2.8.4 nothing asserted what it
# decides -- only that both paths compute the right answer, which stays true
# whichever one runs. So a mispick was invisible: it cost time and changed no
# result. These pin the four decisions 2.8.4 corrected, measured by forcing both
# paths and timing them, plus the three that must NOT move.
# [measured: CHANGELOG.md 2.8.4, the _numx_use_fft table (both paths batch-timed at the four corrected sizes)]
#
# 1 = take the DFT reduction, 0 = take the direct double loop.
# DST-I passes post = 0 (its post-pass is a negate and a halve); DCT-II and its
# inverse pass post = 2 (a cos and a sin twiddle per bin).
# The percentages in these messages are 2.8.4's, timed on cycc 6.5.6.
# [measured: CHANGELOG.md 2.8.4 section]
assert_eq(_numx_use_fft(7, 16, 0), 1, "dst n=7: FFT (was direct; 2.8.4 measured FFT 20.6% faster)");
assert_eq(_numx_use_fft(26, 26, 2), 0, "dct n=26: direct (was FFT; 2.8.4 measured direct 11% faster)");
assert_eq(_numx_use_fft(38, 38, 2), 0, "dct n=38: direct (was FFT; 2.8.4 measured direct 8.2% faster)");
assert_eq(_numx_use_fft(39, 39, 2), 0,
  "dct n=39: direct (was FFT; 2.8.4 measured direct 2.6% faster -- a near-tie the other way on 6.6.12)");

# The bounds are load-bearing, not incidental. n=40 is the size that a 1/8
# surcharge instead of 1/10 would wrongly flip -- 2.8.4 measured the FFT faster
# there (66486 ns vs 67340 ns). n=27 was 2.8.4's acknowledged residual, a 3%
# mispick kept rather than papered over, because widening the fit to catch it
# drags correctly-picked sizes across.
# [measured: 2.8.4 scratch harness, not reproducible in-tree, 2026-08-05; cycc 6.5.6]
#
# Re-timed on cycc 6.6.12 with both DCT paths forced: n = 26, 38 and 40 still
# pick the faster path, by 3.9-10.9%. n = 27's FFT pick and n = 39's direct pick
# are each now within 2% of the other path, and usually the slower of the two:
# mispicks of about 1%. n = 39, which 2.8.4 moved to direct, now runs marginally
# slower there than the FFT would.
# [measured: scratch harness, both DCT paths forced, 9 passes, not reproducible in-tree, 2026-10-01; cycc 6.6.12]
# The model was not refit; these pins assert its DECISIONS, not timings. See
# _numx_use_fft's comment in src/num_ext.cyr for the 6.6.12 re-timing.
assert_eq(_numx_use_fft(40, 40, 2), 1, "dct n=40: still FFT -- 1/10 surcharge, not 1/8");
assert_eq(_numx_use_fft(27, 27, 2), 1,
  "dct n=27: still FFT -- 2.8.4's 3% residual mispick, about 1% or less on 6.6.12");

# The headline sizes sit far above the crossover (margins 7.1x and 158.4x) and
# were never the gate's problem. 2.8.4 must not have moved them.
# [measured: scratch harness (2.8.4), not reproducible in-tree, 2026-08-05; cycc 6.5.6]
assert_eq(_numx_use_fft(1024, 2050, 0), 1, "dst n=1024: FFT (Bluestein), unchanged");
assert_eq(_numx_use_fft(1024, 1024, 2), 1, "dct n=1024: FFT (radix-2), unchanged");

test_group("2.8.3 num_dct / num_dst: closed forms on both sides of the crossover");

# Sizes chosen to hit every dispatch branch: 8 and 16 are direct (DST) or
# radix-2 FFT (DCT); 15 makes DST's 2(n+1) a power of two; 17 and 100 force
# Bluestein; 128 and 256 are the large radix-2 path.
fn _tx_sizes(i) {
    if (i == 0) { return 8; }
    if (i == 1) { return 15; }
    if (i == 2) { return 16; }
    if (i == 3) { return 17; }
    if (i == 4) { return 100; }
    if (i == 5) { return 128; }
    return 256;
}

var tx_bad_const = 0;
var tx_bad_delta = 0;
var tx_bad_rt = 0;
var tx_bad_inv = 0;
for (var txi = 0; txi < 7; txi = txi + 1) {
    var tn = _tx_sizes(txi);

    # (1) DCT-II of a constant c: X[0] = n*c exactly, X[k>0] = 0 exactly.
    var tc = alloc(tn * 8);
    for (var t1 = 0; t1 < tn; t1 = t1 + 1) { store64(tc + t1 * 8, F64_TWO); }
    var _ri3t, _ri3v = num_dct(tc, tn);
    if (is_err_result(_ri3t) == 1) { tx_bad_const = tx_bad_const + 1; }
    if (f64_approx_eq(load64(tc), f64_from(2 * tn), LOOSE_TOL_M) == 0) {
        tx_bad_const = tx_bad_const + 1;
    }
    for (var t2 = 1; t2 < tn; t2 = t2 + 1) {
        if (f64_approx_eq(load64(tc + t2 * 8), 0, LOOSE_TOL_M) == 0) {
            tx_bad_const = tx_bad_const + 1;
        }
    }

    # (2) DCT-II of e_j reads off column j: X[k] = cos(PI (2j+1) k / (2n)).
    var tj = tn / 3;
    var td = alloc(tn * 8);
    for (var t3 = 0; t3 < tn; t3 = t3 + 1) { store64(td + t3 * 8, 0); }
    store64(td + tj * 8, F64_ONE);
    var _ri4t, _ri4v = num_dct(td, tn);
    if (is_err_result(_ri4t) == 1) { tx_bad_delta = tx_bad_delta + 1; }
    for (var t4 = 0; t4 < tn; t4 = t4 + 1) {
        var ang = f64_div(f64_mul(F64_PI, f64_from((2 * tj + 1) * t4)), f64_from(2 * tn));
        if (f64_approx_eq(load64(td + t4 * 8), f64_cos(ang), LOOSE_TOL_M) == 0) {
            tx_bad_delta = tx_bad_delta + 1;
        }
    }

    # (3) round trips: idct(dct(x)) == x and idst(dst(x)) == x
    var tx = alloc(tn * 8);
    var tk = alloc(tn * 8);
    _DLR_STATE = 5150 + tn;
    for (var t5 = 0; t5 < tn; t5 = t5 + 1) {
        var tv = f64_sub(_dlr_unit(), F64_HALF);
        store64(tx + t5 * 8, tv);
        store64(tk + t5 * 8, tv);
    }
    var _r19t, _r19v = num_dct(tx, tn);
    var _r20t, _r20v = num_idct(tx, tn);
    for (var t6 = 0; t6 < tn; t6 = t6 + 1) {
        if (f64_approx_eq(load64(tx + t6 * 8), load64(tk + t6 * 8), LOOSE_TOL_M) == 0) {
            tx_bad_rt = tx_bad_rt + 1;
        }
    }
    for (var t7 = 0; t7 < tn; t7 = t7 + 1) { store64(tx + t7 * 8, load64(tk + t7 * 8)); }
    var _r21t, _r21v = num_dst(tx, tn);
    var _r22t, _r22v = num_idst(tx, tn);
    for (var t8 = 0; t8 < tn; t8 = t8 + 1) {
        if (f64_approx_eq(load64(tx + t8 * 8), load64(tk + t8 * 8), LOOSE_TOL_M) == 0) {
            tx_bad_rt = tx_bad_rt + 1;
        }
    }

    # (4) DST-I is a symmetric involution: S^2 = ((n+1)/2) I. Unlike the round
    # trip above this does NOT go through num_idst, so a scale error in the
    # forward transform cannot cancel itself out.
    for (var t9 = 0; t9 < tn; t9 = t9 + 1) { store64(tx + t9 * 8, load64(tk + t9 * 8)); }
    var _r23t, _r23v = num_dst(tx, tn);
    var _r24t, _r24v = num_dst(tx, tn);
    var thalf = f64_mul(f64_from(tn + 1), F64_HALF);
    for (var ta = 0; ta < tn; ta = ta + 1) {
        if (f64_approx_eq(load64(tx + ta * 8),
            f64_mul(thalf, load64(tk + ta * 8)), LOOSE_TOL_M) == 0) {
            tx_bad_inv = tx_bad_inv + 1;
        }
    }
}
assert_eq(tx_bad_const, 0, "DCT-II of a constant is n*c at k=0 and 0 elsewhere, 7 sizes");
assert_eq(tx_bad_delta, 0, "DCT-II of e_j is column j of the cosine kernel, 7 sizes");
assert_eq(tx_bad_rt, 0, "idct(dct(x)) and idst(dst(x)) round-trip, 7 sizes");
assert_eq(tx_bad_inv, 0, "dst(dst(x)) == ((n+1)/2) x -- DST-I is an involution, 7 sizes");
var _rq103t, _rq103v = num_dct(alloc(8), 0);
assert_eq(is_err_result(_rq103t), 1, "num_dct(n=0) still rejects");
assert_eq(_rq103v, HSB_ERR_INVALID_INPUT, "num_dct(n=0) still rejects");
var _rq104t, _rq104v = num_idct(alloc(8), 0);
assert_eq(is_err_result(_rq104t), 1, "num_idct(n=0) still rejects");
assert_eq(_rq104v, HSB_ERR_INVALID_INPUT, "num_idct(n=0) still rejects");
var _rq105t, _rq105v = num_idst(alloc(8), 0);
assert_eq(is_err_result(_rq105t), 1, "num_idst(n=0) still rejects");
assert_eq(_rq105v, HSB_ERR_INVALID_INPUT, "num_idst(n=0) still rejects");

test_group("3.3.5 Bluestein: the chirp angle's (j*j) mod 2N (D026)");
# _numx_chirp_angle reduces j^2 mod 2N before PI * j^2 / N goes to sin and cos; without
# it the argument grows to PI * N and so does its representation error. Nothing above
# reaches a size where that shows (the round trips use LOOSE_TOL_M). These two round
# trips do, on their exact sample sequences (splitmix64 seeds below): with the reduction
# the largest |x - idct(dct(x))| at n = 1000 is 1.902e-14 and |x - idst(dst(x))| at
# n = 1500 6.783e-14; without it 2.479e-13 and 4.835e-13. Each bound is the geometric
# middle of its pair, 3.6x and 2.7x from either side.
# [measured: scratch Bluestein probe (p/pblue.cyr) and the no-mod mutant, these seeds, 2026-10-11; cycc 6.6.14]
fn _bz_roundtrip(kind, n, seed) {
    var x = alloc(n * 8);
    var k = alloc(n * 8);
    _DLR_STATE = seed;
    for (var j = 0; j < n; j = j + 1) {
        var v = f64_sub(_dlr_unit(), F64_HALF);
        store64(x + j * 8, v);
        store64(k + j * 8, v);
    }
    if (kind == 0) {
        var t1, v1 = num_dct(x, n);
        var t2, v2 = num_idct(x, n);
    } else {
        var t3, v3 = num_dst(x, n);
        var t4, v4 = num_idst(x, n);
    }
    var mx = 0;
    for (var q = 0; q < n; q = q + 1) {
        var d = f64_abs(f64_sub(load64(x + q * 8), load64(k + q * 8)));
        if (f64_lt(d, mx) == 0) { mx = d; }
    }
    return mx;
}
var _bz_dct = _bz_roundtrip(0, 1000, 6150);
assert_eq(f64_lt(_bz_dct, 0x3D3354B80EC9D96E), 1,
  "Bluestein: idct(dct(x)) at n = 1000 within 6.87e-14 (1.90e-14 with the chirp reduction, 2.48e-13 without)");
var _bz_dst = _bz_roundtrip(1, 1500, 6150);
assert_eq(f64_lt(_bz_dst, 0x3D497CB997F6F499), 1,
  "Bluestein: idst(dst(x)) at n = 1500 within 1.81e-13 (6.78e-14 with the chirp reduction, 4.84e-13 without)");

test_group("3.3.6 DST / DCT: a power of two past the Bluestein cap takes the reduction");
# Through 3.3.5 num_dct and num_idct went direct for every n past _NUMX_DFT_MAX, and
# num_dst for every 2(n + 1) past it, powers of two included, though a power of two
# never reaches Bluestein: num_dct at n = 2^21 was about 61 hours that way, against 1.1 s
# through the reduction. The cap is lowered to 16 here so that small sizes cross it: a
# power-of-two length must give the bits the reduction gives under the default cap, and
# a length that is not one (48) still takes the direct loop.
# [measured: scratch routing probe (p/proute.cyr), single runs, shared machine, 2026-10-11; cycc 6.6.14]
#
# ⚠ This group ASSIGNS the private cap, and restores it from the value it saved, not from a
# literal: a literal restore (0x100000, through 3.3.6) would silently leave the rest of the
# suite on a stale cap the day the source moves it. Lowering the cap is the only way the suite
# can drive a length past it: the real lengths cost about 1 s through the reduction (a power
# of two, 2^21) and hours through the direct loop (any other length past 2^20), and the
# routing it pins -- the callers consult _numx_bluestein_capped, which exempts a power of
# two, not the bare cap -- is invisible at small n under the real cap. So a conversion of
# _NUMX_DFT_MAX to an enum (the [3.5.0] K003 shape) breaks this group at compile time; it
# needs a seam that takes the cap as an argument first, or the routing loses its coverage.
# [measured: src/num_ext.cyr, the 3.3.6 note at _numx_bluestein_capped (1.1 s at 2^21, 3.8 h at 524,288)]
fn _rt6_mk(n, seed) {
    var x = alloc(n * 8);
    _DLR_STATE = seed;
    for (var j = 0; j < n; j = j + 1) { store64(x + j * 8, f64_sub(_dlr_unit(), F64_HALF)); }
    return x;
}
fn _rt6_diff(x, y, n) {
    var bad = 0;
    for (var j = 0; j < n; j = j + 1) {
        if (load64(x + j * 8) != load64(y + j * 8)) { bad = bad + 1; }
    }
    return bad;
}
var _rt6_r1 = _rt6_mk(32, 336);
var _rt6_r2 = _rt6_mk(32, 337);
var _rt6_r3 = _rt6_mk(31, 338);
var _rt6_r4 = _rt6_mk(48, 339);
var _rt6_rt1, _rt6_rv1 = num_dct(_rt6_r1, 32);                 # default cap: the reduction
var _rt6_rt2, _rt6_rv2 = num_idct(_rt6_r2, 32);
var _rt6_rt3, _rt6_rv3 = num_dst(_rt6_r3, 31);                 # DFT length 64
var _rt6_rt4, _rt6_rv4 = _numx_dct_direct(_rt6_r4, 48);         # the direct loop's bits
var _rt6_c1 = _rt6_mk(32, 336);
var _rt6_c2 = _rt6_mk(32, 337);
var _rt6_c3 = _rt6_mk(31, 338);
var _rt6_c4 = _rt6_mk(48, 339);
var _rt6_cap = _NUMX_DFT_MAX;
_NUMX_DFT_MAX = 16;
var _rt6_ct1, _rt6_cv1 = num_dct(_rt6_c1, 32);
var _rt6_ct2, _rt6_cv2 = num_idct(_rt6_c2, 32);
var _rt6_ct3, _rt6_cv3 = num_dst(_rt6_c3, 31);
var _rt6_ct4, _rt6_cv4 = num_dct(_rt6_c4, 48);
_NUMX_DFT_MAX = _rt6_cap;
assert_eq(_rt6_diff(_rt6_r1, _rt6_c1, 32), 0,
  "num_dct: n = 32 past a cap of 16, a power of two -> the reduction's bits");
assert_eq(_rt6_diff(_rt6_r2, _rt6_c2, 32), 0, "num_idct: n = 32 past a cap of 16 -> the reduction's bits");
assert_eq(_rt6_diff(_rt6_r3, _rt6_c3, 31), 0, "num_dst: n = 31 (length 64) past a cap of 16 -> the reduction's bits");
assert_eq(_rt6_diff(_rt6_r4, _rt6_c4, 48), 0, "num_dct: n = 48 past a cap of 16, not a power of two -> still direct");
assert_eq(_numx_bluestein_capped(0x200000), 0, "_numx_bluestein_capped: 2^21 is a power of two -> not capped");
assert_eq(_numx_bluestein_capped(0x100001), 1, "_numx_bluestein_capped: 2^20 + 1 -> capped");
assert_eq(_numx_bluestein_capped(0xFFFFF), 0, "_numx_bluestein_capped: 2^20 - 1, under the cap -> not capped");
# NOISE — the four generators had no assertion that any of them computes
# anything (2.8.3)
# ================================================================
test_group("noise: perlin_2d / perlin_3d / simplex_2d / simplex_3d");

# Every noise assertion in the tree through 2.8.2 was of the form
# `|noise(p)| < 1` or `noise(p) == noise(p)` at a single point, plus the fBm
# NaN guards. Replacing the body of any of the four with `return 0;` satisfies
# all of them: 0 is bounded by 1, deterministic, and not NaN. That is roughly
# 320 lines of lattice hashing, skew/unskew, fade curves and gradient tables
# certified by nothing.
#
# Two independent things are checked below.
#
# (1) STRUCTURAL IDENTITIES that follow from the definition of gradient noise
#     and hold for no constant function. They are exact, so they carry no
#     tolerance argument at all.
# (2) VALUES, cross-checked against a reference implementation in python3
#     (Perlin's 2002 "Improving Noise" for the fade curve and permutation;
#     for simplex, see below). The permutation table in src/calc.cyr was
#     separately diffed against Perlin's published 256-entry table: identical,
#     and a genuine permutation of 0..255. Agreement is bit-exact for perlin_2d
#     and perlin_3d at every point and aggregate below.
#     ⛔ 3.3.3 — THE SIMPLEX ROWS WERE RE-DERIVED when src/noise_simplex.cyr's corner
#     offsets and 3D falloff were repaired (its header). The simplex half of the
#     reference was rewritten from the listing in Gustavson's "Simplex noise
#     demystified" -- corner offsets x0 - i1 + G2, x0 - 1 + 2*G2 (3D + G3, + 2*G3,
#     - 1 + 3*G3), G2 = (3 - sqrt(3))/6 and F3 = 1/3, G3 = 1/6 as he computes them
#     -- plus only the departures that header lists: the 8-direction 2D gradient,
#     the nested corner hashing, the 0.5 3D falloff and the 76.75 3D scale, F2
#     correctly rounded, the falloff formed as 0.5 - (x^2 + y^2 [+ z^2]), strict
#     3D ordering tests. It reproduces src bit for bit at every simplex point and
#     aggregate below and at 4500 more points along three lines. Of those rounding-
#     level departures only the falloff grouping moves a value pinned here, by up
#     to 5 ulp. The reference shares the departures, so it pins hisab's values; it
#     does not certify the listing's.
#     [measured: scratch reference vs the repaired bundle, not reproducible in-tree, 2026-10-01; cycc 6.6.12]
#     Through 3.3.2 the simplex reference shared src's subtracted corner offsets,
#     its rows sat within 1e-14 rather than bit-exact -- up to 19 ulp
#     (simplex_3d(1.25, 2.5, 3.75)), where this comment said "at most 3 ulp" -- and
#     the comment blamed "associativity in the corner-offset expressions", but
#     x0 + (-i1) and x0 - i1 are one IEEE operation; the 3 ulp at simplex_2d(0.1,
#     0.2) was the falloff grouping. Through 3.3.1 it said the whole reference was
#     "NOT transcribed from src/".
#     [measured: scratch reference vs the 3.3.2 bundle, not reproducible in-tree, 2026-10-01; cycc 6.6.12]

# --- (1a) Gradient noise vanishes exactly at its lattice points. At integer
# (x, y) the fractional offsets are 0, the fade weights are 0, and the surviving
# corner contributes grad . (0, 0) == 0. Not a tolerance: exactly zero.
assert_eq(perlin_2d(f64_from(3), f64_from(5)), 0, "perlin_2d == 0 exactly at a lattice point");
# ⚠ perlin_3d's surviving corner here takes a NEGATED gradient component, so its zero
# is -0.0 since cyrius 6.6.8 (IEEE `f64_neg`); still exactly zero, compared as a value.
assert_eq(f64_eq(perlin_3d(F64_TWO, f64_from(7), f64_from(4)), 0), 1,
  "perlin_3d == 0 exactly at a lattice point (it is -0.0)");
# Simplex noise vanishes at the origin of the skewed lattice for the same
# reason: the near corner contributes grad . 0, and the other corners lie outside
# the 0.5 falloff, at squared distances 2/3, 2/3 (2D) and 3/4, 1, 3/4 (3D). (Through
# 3.3.2 the 3D falloff was 0.6 and the corner offsets were wrong; header of
# src/noise_simplex.cyr.)
assert_eq(simplex_2d(0, 0), 0, "simplex_2d(0,0) == 0 exactly");
assert_eq(simplex_3d(0, 0, 0), 0, "simplex_3d(0,0,0) == 0 exactly");

# --- (1b) CELL-CENTRE QUANTISATION. fade(1/2) = 6/32 - 15/16 + 10/8 = 1/2
# exactly, and at a cell centre every corner offset is (+-1/2, +-1/2), so each
# 2D gradient dot product is exactly one of {-1, 0, +1}. The two nested lerps at
# weight 1/2 then make perlin_2d(i+1/2, j+1/2) an exact multiple of 1/4 in
# [-1, 1] -- in dyadic arithmetic, with no rounding anywhere. In 3D the eight
# corners and three lerps make it an exact multiple of 1/8.
#
# The histogram of those quantised values over a block of cells is a fingerprint
# of the entire pipeline (permutation table, corner hashing, gradient selection
# and the fade curve at once). Both histograms below were produced by the
# independent reference and match src bin for bin.
# ⭐ 3.3.5 — "exact multiple" is now checked exactly: the round only picks the bin, and
# the value must equal it bit for bit. It was |4v - n| < 1e-12, which a pipeline error
# far above the last bit passes.
var _nz_hp = alloc(7 * 8);
var _nz_i = 0;
while (_nz_i < 7) { store64(_nz_hp + _nz_i * 8, 0); _nz_i = _nz_i + 1; }
var _nz_bad = 0;
var _nz_oob = 0;
_nz_i = 0;
while (_nz_i < 16) {
    var _nz_j = 0;
    while (_nz_j < 16) {
        var _nz_v = perlin_2d(f64_add(f64_from(_nz_i), F64_HALF),
          f64_add(f64_from(_nz_j), F64_HALF));
        var _nz_q = f64_mul(_nz_v, f64_from(4));
        var _nz_n = f64_to(f64_round(_nz_q));
        if (f64_eq(_nz_q, f64_from(_nz_n)) == 0) {
            _nz_bad = _nz_bad + 1;
        }
        if (_nz_n < 0 - 3 || _nz_n > 3) {
            _nz_oob = _nz_oob + 1;
        } else {
            store64(_nz_hp + (_nz_n + 3) * 8, load64(_nz_hp + (_nz_n + 3) * 8) + 1);
        }
        _nz_j = _nz_j + 1;
    }
    _nz_i = _nz_i + 1;
}
assert_eq(_nz_bad, 0, "perlin_2d: all 256 cell centres are exact multiples of 1/4");
assert_eq(_nz_oob, 0, "perlin_2d: all 256 cell centres lie in [-3/4, 3/4]");
assert_eq(load64(_nz_hp), 7, "perlin_2d cell-centre histogram: 4v = -3 occurs 7x");
assert_eq(load64(_nz_hp + 8), 25, "perlin_2d cell-centre histogram: 4v = -2 occurs 25x");
assert_eq(load64(_nz_hp + 16), 62, "perlin_2d cell-centre histogram: 4v = -1 occurs 62x");
assert_eq(load64(_nz_hp + 24), 67, "perlin_2d cell-centre histogram: 4v = 0 occurs 67x");
assert_eq(load64(_nz_hp + 32), 62, "perlin_2d cell-centre histogram: 4v = +1 occurs 62x");
assert_eq(load64(_nz_hp + 40), 22, "perlin_2d cell-centre histogram: 4v = +2 occurs 22x");
assert_eq(load64(_nz_hp + 48), 11, "perlin_2d cell-centre histogram: 4v = +3 occurs 11x");

var _nz_hq = alloc(12 * 8);
_nz_i = 0;
while (_nz_i < 12) { store64(_nz_hq + _nz_i * 8, 0); _nz_i = _nz_i + 1; }
var _nz_bad3 = 0;
var _nz_oob3 = 0;
_nz_i = 0;
while (_nz_i < 8) {
    var _nz_j3 = 0;
    while (_nz_j3 < 8) {
        var _nz_k3 = 0;
        while (_nz_k3 < 8) {
            var _nz_v3 = perlin_3d(f64_add(f64_from(_nz_i), F64_HALF),
              f64_add(f64_from(_nz_j3), F64_HALF), f64_add(f64_from(_nz_k3), F64_HALF));
            var _nz_q3 = f64_mul(_nz_v3, f64_from(8));
            var _nz_n3 = f64_to(f64_round(_nz_q3));
            if (f64_eq(_nz_q3, f64_from(_nz_n3)) == 0) {
                _nz_bad3 = _nz_bad3 + 1;
            }
            if (_nz_n3 < 0 - 6 || _nz_n3 > 5) {
                _nz_oob3 = _nz_oob3 + 1;
            } else {
                store64(_nz_hq + (_nz_n3 + 6) * 8, load64(_nz_hq + (_nz_n3 + 6) * 8) + 1);
            }
            _nz_k3 = _nz_k3 + 1;
        }
        _nz_j3 = _nz_j3 + 1;
    }
    _nz_i = _nz_i + 1;
}
assert_eq(_nz_bad3, 0, "perlin_3d: all 512 cell centres are exact multiples of 1/8");
assert_eq(_nz_oob3, 0, "perlin_3d: all 512 cell centres lie in [-6/8, 5/8]");
assert_eq(load64(_nz_hq), 1, "perlin_3d cell-centre histogram: 8v = -6 occurs 1x");
assert_eq(load64(_nz_hq + 8), 3, "perlin_3d cell-centre histogram: 8v = -5 occurs 3x");
assert_eq(load64(_nz_hq + 16), 8, "perlin_3d cell-centre histogram: 8v = -4 occurs 8x");
assert_eq(load64(_nz_hq + 24), 39, "perlin_3d cell-centre histogram: 8v = -3 occurs 39x");
assert_eq(load64(_nz_hq + 32), 65, "perlin_3d cell-centre histogram: 8v = -2 occurs 65x");
assert_eq(load64(_nz_hq + 40), 93, "perlin_3d cell-centre histogram: 8v = -1 occurs 93x");
assert_eq(load64(_nz_hq + 48), 85, "perlin_3d cell-centre histogram: 8v = 0 occurs 85x");
assert_eq(load64(_nz_hq + 56), 105, "perlin_3d cell-centre histogram: 8v = +1 occurs 105x");
assert_eq(load64(_nz_hq + 64), 67, "perlin_3d cell-centre histogram: 8v = +2 occurs 67x");
assert_eq(load64(_nz_hq + 72), 32, "perlin_3d cell-centre histogram: 8v = +3 occurs 32x");
assert_eq(load64(_nz_hq + 80), 10, "perlin_3d cell-centre histogram: 8v = +4 occurs 10x");
assert_eq(load64(_nz_hq + 88), 4, "perlin_3d cell-centre histogram: 8v = +5 occurs 4x");

# --- (2) POINT VALUES against the independent reference.
var _nz_p1 = f64_div(F64_ONE, f64_from(10));                   # 0.1
var _nz_p2 = f64_div(F64_ONE, f64_from(5));                    # 0.2
var _nz_p3 = f64_div(f64_from(3), f64_from(10));               # 0.3
var _nz_a = f64_div(f64_from(13), f64_from(4));                # 3.25
var _nz_b = f64_div(f64_from(31), f64_from(4));                # 7.75
var _nz_c = f64_div(f64_from(5), f64_from(4));                 # 1.25
var _nz_d = f64_div(f64_from(5), F64_TWO);                     # 2.5
var _nz_e = f64_div(f64_from(15), f64_from(4));                # 3.75
assert_eq(perlin_2d(_nz_a, _nz_b), 0xBFD8B07000000000,
  "perlin_2d(3.25, 7.75) == -0.38576889038085938 (bit-exact vs reference)");
assert_eq(perlin_2d(_nz_p1, _nz_p2), 0x3FC32F725475690A,
  "perlin_2d(0.1, 0.2) == 0.14988545536000003 (bit-exact vs reference)");
assert_eq(perlin_3d(_nz_p1, _nz_p2, _nz_p3), 0x3FD2B8E731B20FE7,
  "perlin_3d(0.1, 0.2, 0.3) == 0.29253558972436483 (bit-exact vs reference)");
assert_eq(perlin_3d(_nz_c, _nz_d, _nz_e), 0x3FD8AF9000000000,
  "perlin_3d(1.25, 2.5, 3.75) == 0.38571548461914062 (bit-exact vs reference)");
# Simplex is bit-exact against the 3.3.3 reference (above). Through 3.3.2 these four
# were pinned within 1e-14 at 0.28704375, 0.040777547611840624, 0.42983577599999989
# and -0.0086881687242801 -- the discontinuous field's values.
assert_eq(simplex_2d(_nz_p1, _nz_p2), 0x3FD142435C763B5B,
  "simplex_2d(0.1, 0.2) == 0.26966938046910166 (bit-exact vs reference)");
assert_eq(simplex_2d(f64_div(f64_from(25), F64_TWO), f64_div(F64_ONE, f64_from(8))), 0x3FD8921338625B28,
  "simplex_2d(12.5, 0.125) == 0.38391571527738444 (bit-exact vs reference)");
assert_eq(simplex_3d(_nz_p1, _nz_p2, _nz_p3), 0x3FDF701831CA4CBA,
  "simplex_3d(0.1, 0.2, 0.3) == 0.49121670591666666 (bit-exact vs reference)");
assert_eq(simplex_3d(_nz_c, _nz_d, _nz_e), 0x3FD8159555555566,
  "simplex_3d(1.25, 2.5, 3.75) == 0.37631734212239676 (bit-exact vs reference)");

# --- (2b) AGGREGATES over a 40x40 grid at step 1/4 (2D) and a 12x12x12 grid
# (3D), so 1600 / 1728 samples are folded into each number. The L1 mass is the
# statement that the generator produces SIGNAL: `return 0;` gives 0 where the
# reference gives 369.35 / 631.21 / 363.05 / 512.10 (simplex 252.12 / 236.59 through
# 3.3.2). max|v| is the amplitude,
# and 3/4 is exact for both Perlin variants (the largest reachable convex
# combination of gradient dots). The rigorous convex-combination bound on
# perlin_2d over a cell is 1.0, so the < 1 range claim in the doc is proved,
# not sampled.
var _nz_step = f64_div(F64_ONE, f64_from(4));
var _nz_eps = f64_div(F64_ONE, f64_from(1024));
var _nz_l1p = 0;
var _nz_l1s = 0;
var _nz_mxp = 0;
var _nz_mxs = 0;
var _nz_cp = 0;
var _nz_cs = 0;
_nz_i = 0;
while (_nz_i < 40) {
    var _nz_jj = 0;
    while (_nz_jj < 40) {
        var _nz_x = f64_mul(f64_from(_nz_i), _nz_step);
        var _nz_y = f64_mul(f64_from(_nz_jj), _nz_step);
        var _nz_vp = perlin_2d(_nz_x, _nz_y);
        var _nz_vs = simplex_2d(_nz_x, _nz_y);
        _nz_l1p = f64_add(_nz_l1p, f64_abs(_nz_vp));
        _nz_l1s = f64_add(_nz_l1s, f64_abs(_nz_vs));
        if (f64_gt(f64_abs(_nz_vp), _nz_mxp) == 1) { _nz_mxp = f64_abs(_nz_vp); }
        if (f64_gt(f64_abs(_nz_vs), _nz_mxs) == 1) { _nz_mxs = f64_abs(_nz_vs); }
        var _nz_dp = f64_abs(f64_sub(perlin_2d(f64_add(_nz_x, _nz_eps), _nz_y), _nz_vp));
        var _nz_ds = f64_abs(f64_sub(simplex_2d(f64_add(_nz_x, _nz_eps), _nz_y), _nz_vs));
        if (f64_gt(_nz_dp, _nz_cp) == 1) { _nz_cp = _nz_dp; }
        if (f64_gt(_nz_ds, _nz_cs) == 1) { _nz_cs = _nz_ds; }
        _nz_jj = _nz_jj + 1;
    }
    _nz_i = _nz_i + 1;
}
# ⛔ 3.3.3 — THE TWO PERLIN L1 MASSES (THIS ONE AND perlin_3d's BELOW) SAID "bit-exact"
# AND COMPARED WITHIN 1e-9, through a `_nz_tol9`. Both sums equal the reference's
# doubles to the bit -- on this quarter grid the samples are short dyadic fractions,
# and both sums end in a run of zero mantissa bits -- so they are now compared on the
# bits, as the messages said. The tolerance let either drift by up to 1e-9 unseen:
# scaling perlin_2d's (or perlin_3d's) output by 1 + 2^-52 moves its sum by one ulp,
# which the 1e-9 compare passed and these fail.
# [measured: scratch probe of the 3.3.2 bundle, scratch mutants on the 3.3.3 tree, cycc 6.6.12, 2026-10-01]
assert_eq(_nz_l1p, 0x407715A274000000,
  "perlin_2d: L1 mass over 1600 samples == 369.3521614074707 (reference, bit-exact)");
assert_eq(_nz_l1s, 0x4083B9AD684A1F50,
  "simplex_2d: L1 mass over 1600 samples == 631.2096715727621 (reference, bit-exact)");
assert_eq(_nz_mxp, 0x3FE8000000000000, "perlin_2d: max|v| over the grid == 3/4 exactly");
assert_eq(_nz_mxs, 0x3FEFEE9DB34ACCB3,
  "simplex_2d: max|v| over the grid == 0.9978779317665584 (reference, bit-exact)");
# Continuity: Perlin gradient noise is C^2, so a 1/1024 step can never move the
# value far. A hash-scrambled or mis-indexed lattice shows up here as a
# discontinuity even when the amplitude statistics still look plausible.
# Measured maxima: 0.00269 / 0.00629 (simplex 0.00427 through 3.3.2).
# [measured: scratch rerun of this loop, not reproducible in-tree, 2026-10-01; cycc 6.6.12]
# ⚠ For simplex this proves less than it reads: no step here lands on a simplex
# boundary, so it passed through 3.3.2, when simplex_2d and simplex_3d jumped there
# (src/noise_simplex.cyr's header). Through 3.3.1 this comment said simplex is C^1
# across its falloff boundary. The 3.3.3 block after this group reads the field
# on both sides of points ON the boundaries.
var _nz_c01 = 0x3F847AE147AE147B;                              # 0.01
assert(f64_lt(_nz_cp, _nz_c01) == 1, "perlin_2d: no jump > 0.01 across a 1/1024 step");
assert(f64_lt(_nz_cs, _nz_c01) == 1, "simplex_2d: no jump > 0.01 across a 1/1024 step");
# Rigorous bound: |perlin_2d| is a convex combination of four gradient dots
# whose supremum over the cell is exactly 1.
assert(f64_lt(_nz_mxp, F64_ONE) == 1, "perlin_2d: inside the analytic bound of 1");
assert(f64_lt(_nz_mxs, F64_ONE) == 1, "simplex_2d: inside the documented [-1, 1] range");

var _nz_l1p3 = 0;
var _nz_l1s3 = 0;
var _nz_mxp3 = 0;
var _nz_mxs3 = 0;
var _nz_cp3 = 0;
var _nz_cs3 = 0;
_nz_i = 0;
while (_nz_i < 12) {
    var _nz_j5 = 0;
    while (_nz_j5 < 12) {
        var _nz_k5 = 0;
        while (_nz_k5 < 12) {
            var _nz_x3 = f64_mul(f64_from(_nz_i), _nz_step);
            var _nz_y3 = f64_mul(f64_from(_nz_j5), _nz_step);
            var _nz_z3 = f64_mul(f64_from(_nz_k5), _nz_step);
            var _nz_w = perlin_3d(_nz_x3, _nz_y3, _nz_z3);
            var _nz_u = simplex_3d(_nz_x3, _nz_y3, _nz_z3);
            _nz_l1p3 = f64_add(_nz_l1p3, f64_abs(_nz_w));
            _nz_l1s3 = f64_add(_nz_l1s3, f64_abs(_nz_u));
            if (f64_gt(f64_abs(_nz_w), _nz_mxp3) == 1) { _nz_mxp3 = f64_abs(_nz_w); }
            if (f64_gt(f64_abs(_nz_u), _nz_mxs3) == 1) { _nz_mxs3 = f64_abs(_nz_u); }
            var _nz_e3 = f64_abs(f64_sub(perlin_3d(f64_add(_nz_x3, _nz_eps), _nz_y3, _nz_z3),
                _nz_w));
            var _nz_e4 = f64_abs(f64_sub(simplex_3d(f64_add(_nz_x3, _nz_eps), _nz_y3, _nz_z3),
                _nz_u));
            if (f64_gt(_nz_e3, _nz_cp3) == 1) { _nz_cp3 = _nz_e3; }
            if (f64_gt(_nz_e4, _nz_cs3) == 1) { _nz_cs3 = _nz_e4; }
            _nz_k5 = _nz_k5 + 1;
        }
        _nz_j5 = _nz_j5 + 1;
    }
    _nz_i = _nz_i + 1;
}
assert_eq(_nz_l1p3, 0x4076B0C2DDE20000,
  "perlin_3d: L1 mass over 1728 samples == 363.04757488518953 (reference, bit-exact)");
assert_eq(_nz_l1s3, 0x408000CDFFB425E9,
  "simplex_3d: L1 mass over 1728 samples == 512.1005853723592 (reference, bit-exact)");
assert_eq(_nz_mxp3, 0x3FE8000000000000, "perlin_3d: max|v| over the grid == 3/4 exactly");
assert_eq(_nz_mxs3, 0x3FEDFE32AAAAAAAB,
  "simplex_3d: max|v| over the grid == 0.937280019124349 (reference, bit-exact)");
assert(f64_lt(_nz_cp3, _nz_c01) == 1, "perlin_3d: no jump > 0.01 across a 1/1024 step");
assert(f64_lt(_nz_cs3, _nz_c01) == 1, "simplex_3d: no jump > 0.01 across a 1/1024 step");
assert(f64_lt(_nz_mxp3, F64_ONE) == 1, "perlin_3d: inside the analytic bound of 1");
assert(f64_lt(_nz_mxs3, F64_ONE) == 1, "simplex_3d: inside the documented [-1, 1] range");

# === 3.4.0: eigen_power, a spectrum that is the diagonal ===
# When every strongly connected component of A's graph is a single vertex, A's eigenvalues are
# its diagonal entries exactly, and eigen_power answers without iterating (`_lext_power_exact`).
# Oracles: the diagonal itself, and the eigenvector solved in exact rationals (Fractions) and
# rounded; the 3.3.7 values quoted were measured on the 3.3.7 tree.
# [measured: LA probes p1, p4, p5, p7 + exact_ev.py Fraction oracle, 3.3.7 base vs this tree, cycc 6.7.9, 2026-10-31]
test_group("3.4.0: eigen_power, a spectrum that is the diagonal");
fn _la_m(n, p) {
    var A = ganita_mat_new(n, n);
    for (var i = 0; i < n * n; i = i + 1) { ganita_mat_set(A, i / n, i % n, load64(p + i * 8)); }
    return A;
}
fn _la_m3(a00, a01, a02, a10, a11, a12, a20, a21, a22) {
    var p = alloc(72);
    store64(p, a00); store64(p + 8, a01); store64(p + 16, a02);
    store64(p + 24, a10); store64(p + 32, a11); store64(p + 40, a12);
    store64(p + 48, a20); store64(p + 56, a21); store64(p + 64, a22);
    return _la_m(3, p);
}
fn _la_m2(a, b, c, d) {
    var M = ganita_mat_new(2, 2);
    ganita_mat_set(M, 0, 0, a);  ganita_mat_set(M, 0, 1, b);
    ganita_mat_set(M, 1, 0, c);  ganita_mat_set(M, 1, 1, d);
    return M;
}
var _la_ev = alloc(8);
var _la_vec = alloc(4 * 8);
fn _la_stamp() {
    store64(_la_ev, 0x7FF8000000000BAD);
    for (var i = 0; i < 4; i = i + 1) { store64(_la_vec + i * 8, 0x7FF8000000000BAD); }
    return 0;
}
# (1) THE ROADMAP REPRO. Rows (a00, a01, a02), (0, a11, 0), (0, a21, a22): the eigenvalues are
# a00 = 3.07e-43, a11 = -5.5327160e-43 and a22 = -3.67e-43. 3.3.7 iterated to Ok(-5.5328078e-43),
# 1.7e-5 relative off and larger in modulus than every eigenvalue. Now a11 exactly, with the
# exact eigenvector rounded: v1 within 0.67 ulp, v2 within 0.11 (correctly rounded).
_la_stamp();
var _la1t, _la1v = eigen_power(_la_m3(0x371B5E3E602B33DF, 0xEB649BD1AEEB8399, 0x654A5AEE5D9850EA, 0, 0xB728AD3EB2747301,
    0, 0, 0x427336E7F5A31AA7, 0xB7205AF06B3D7EB8), 3, 1000, _la_ev, _la_vec);
assert_eq(is_ok(_la1t), 1, "eigen_power: the roadmap's non-normal triangular 3x3 -> Ok");
assert_eq(load64(_la_ev), 0xB728AD3EB2747301, "eigen_power: ... -> a11 exactly (3.3.7: 0xB728AD598B5A488C, above rho)");
assert_eq(load64(_la_vec), F64_ONE, "eigen_power: ... -> v0 = 1");
assert_eq(load64(_la_vec + 8), 0x06742BFB98EC5BD4, "eigen_power: ... -> v1, 0.67 ulp from the exact eigenvector");
assert_eq(load64(_la_vec + 16), 0x91D749DAC59E4C45, "eigen_power: ... -> v2, correctly rounded");
# (2) The same matrix with vertices 0 and 2 swapped: Tarjan meets them in another order, and the
# answer is the same, its vector permuted.
_la_stamp();
var _la2t, _la2v = eigen_power(_la_m3(0xB7205AF06B3D7EB8, 0x427336E7F5A31AA7, 0, 0, 0xB728AD3EB2747301, 0,
    0x654A5AEE5D9850EA, 0xEB649BD1AEEB8399, 0x371B5E3E602B33DF), 3, 1000, _la_ev, _la_vec);
assert_eq(load64(_la_ev), 0xB728AD3EB2747301, "eigen_power: the repro permuted -> a11 exactly");
assert_eq(load64(_la_vec), 0x91D749DAC59E4C45, "eigen_power: the repro permuted -> v0 is the old v2");
assert_eq(load64(_la_vec + 8), 0x06742BFB98EC5BD4, "eigen_power: the repro permuted -> v1 as before");
assert_eq(load64(_la_vec + 16), F64_ONE, "eigen_power: the repro permuted -> v2 = 1");
var _la_s = alloc(6 * 3 * 8);
var _la_ord = alloc(3 * 8);
assert_eq(_lext_scc_order(_la_m3(0x371B5E3E602B33DF, 0xEB649BD1AEEB8399, 0x654A5AEE5D9850EA, 0, 0xB728AD3EB2747301,
      0, 0, 0x427336E7F5A31AA7, 0xB7205AF06B3D7EB8), 3, _la_s, _la_ord), 1,
  "_lext_scc_order: the repro, all single -> 1");
assert_eq(load64(_la_ord) * 100 + load64(_la_ord + 8) * 10 + load64(_la_ord + 16), 120,
  "_lext_scc_order: completion order 1, 2, 0 (each vertex after every vertex it reaches)");
assert_eq(_lext_scc_order(_la_m3(F64_ONE, F64_ONE, 0, 0, F64_ONE, F64_ONE, F64_ONE, 0, F64_ONE), 3, _la_s, _la_ord), 0,
  "_lext_scc_order: a 3-cycle is one component -> 0");
# (3) An integer upper-triangular A: lambda = 4 and (A - 4I) v = 0 gives v = (1/2, 1, 1), every
# component exact (3.3.7: 0x400FFFFFFFFFDCDA and v0 = 0x3FE00000000034B9).
_la_stamp();
var _la3t, _la3v = eigen_power(_la_m3(F64_TWO, F64_ONE, 0, 0, f64_from(3), F64_ONE, 0, 0, f64_from(4)), 3, 1000,
  _la_ev, _la_vec);
assert_eq(load64(_la_ev), f64_from(4), "eigen_power: [[2,1,0],[0,3,1],[0,0,4]] -> 4 exactly");
assert_eq(load64(_la_vec), F64_HALF, "eigen_power: [[2,1,0],[0,3,1],[0,0,4]] -> v0 = 1/2 exactly");
assert_eq(load64(_la_vec + 8), F64_ONE, "eigen_power: [[2,1,0],[0,3,1],[0,0,4]] -> v1 = 1 (the first of the tie)");
assert_eq(load64(_la_vec + 16), F64_ONE, "eigen_power: [[2,1,0],[0,3,1],[0,0,4]] -> v2 = 1 exactly");
# (4) No pass is needed: diag(4, 3, 2) at max_iter 1 (3.3.7: NO_CONVERGENCE below 92 passes).
_la_stamp();
var _la4t, _la4v = eigen_power(_la_m3(f64_from(4), 0, 0, 0, f64_from(3), 0, 0, 0, F64_TWO), 3, 1, _la_ev, _la_vec);
assert_eq(is_ok(_la4t), 1, "eigen_power: diag(4,3,2) at max_iter 1 -> Ok (3.3.7: NO_CONVERGENCE)");
assert_eq(load64(_la_ev), f64_from(4), "eigen_power: diag(4,3,2) at max_iter 1 -> 4");
assert_eq(load64(_la_vec + 8), 0, "eigen_power: diag(4,3,2) -> v = e_0, v1 = +0");
# (5) +-lambda tied on the diagonal: no real dominant eigenvalue, NO_CONVERGENCE at once (the
# contract's +1 / -1 case), out_val untouched.
_la_stamp();
var _la5t, _la5v = eigen_power(_la_m2(F64_TWO, F64_ONE, 0, f64_neg(F64_TWO)), 2, 1000, _la_ev, _la_vec);
assert_eq(_la5v, HSB_ERR_NO_CONVERGENCE, "eigen_power: [[2,1],[0,-2]], a +-2 tie -> NO_CONVERGENCE");
assert_eq(load64(_la_ev), 0x7FF8000000000BAD, "eigen_power: a +-2 tie leaves out_val untouched");
# (6) A REPEATED dominant value: [[3,1,0],[0,2,0],[0,0,3]]. The iteration chooses the vector in
# the 2-dimensional eigenspace, and the value is the diagonal's exactly (3.3.7: 3 + 5224 ulp).
_la_stamp();
var _la6t, _la6v = eigen_power(_la_m3(f64_from(3), F64_ONE, 0, 0, F64_TWO, 0, 0, 0, f64_from(3)), 3, 1000,
  _la_ev, _la_vec);
assert_eq(is_ok(_la6t), 1, "eigen_power: a repeated dominant 3 -> Ok");
assert_eq(load64(_la_ev), f64_from(3), "eigen_power: a repeated dominant 3 -> 3 exactly (3.3.7: 0x4008000000001468)");
# And one the iteration missed: 3.3.7's [[1e-3, 0, -1e20], [0, 1.3, 0], [0, 0, -1]] with a fourth
# vertex alone at 1.3. Both 1.3 directions sit about 1e-20 under the -1e20 coupling and the run
# settled on -1 (the first 3.4.0 tree refused it). 3.4.0 review: a repeated value is read off the
# diagonal too, with the eigenvector of its last vertex in completion order, here e_3.
var _la_rp = alloc(16 * 8);
for (var _la_q = 0; _la_q < 16; _la_q = _la_q + 1) { store64(_la_rp + _la_q * 8, 0); }
store64(_la_rp, 0x3F50624DD2F1A9FC);       store64(_la_rp + 16, 0xC415AF1D78B58C40);
store64(_la_rp + 40, 0x3FF4CCCCCCCCCCCD);  store64(_la_rp + 80, 0xBFF0000000000000);
store64(_la_rp + 120, 0x3FF4CCCCCCCCCCCD);
_la_stamp();
var _la6bt, _la6bv = eigen_power(_la_m(4, _la_rp), 4, 1000, _la_ev, _la_vec);
assert_eq(is_ok(_la6bt), 1,
  "eigen_power: a repeated 1.3 the iteration misses -> Ok (first 3.4.0 tree: NO_CONVERGENCE)");
assert_eq(load64(_la_ev), 0x3FF4CCCCCCCCCCCD, "eigen_power: a repeated 1.3 -> 1.3 exactly");
assert_eq(load64(_la_vec) | load64(_la_vec + 8) | load64(_la_vec + 16), 0,
  "eigen_power: a repeated 1.3 -> v0..v2 = +0");
assert_eq(load64(_la_vec + 24), F64_ONE, "eigen_power: a repeated 1.3 -> v = e_3, the last 1.3 vertex");
# The defective [[2,1],[0,2]]: its eigenvector is e_0 (3.4.0 review; through the first 3.4.0 tree
# it was the iteration's NO_CONVERGENCE). diag(1, 1, 1 - 2^-30) and the max_iter <= 0 refusal too.
var _la7t, _la7v = eigen_power(_la_m2(F64_TWO, F64_ONE, 0, F64_TWO), 2, 1000, _la_ev, _la_vec);
assert_eq(is_ok(_la7t), 1, "eigen_power: defective [[2,1],[0,2]] -> Ok (3.3.7: NO_CONVERGENCE)");
assert_eq(load64(_la_ev), F64_TWO, "eigen_power: defective [[2,1],[0,2]] -> 2 exactly");
assert_eq(load64(_la_vec + 8), 0, "eigen_power: defective [[2,1],[0,2]] -> v = e_0 (v1 = +0)");
var _la7bt, _la7bv = eigen_power(_la_m3(F64_ONE, 0, 0, 0, F64_ONE, 0, 0, 0, 0x3FEFFFFFFF800000), 3, 1000,
  _la_ev, _la_vec);
assert_eq(load64(_la_ev), F64_ONE, "eigen_power: diag(1, 1, 1 - 2^-30) -> 1 exactly (3.3.7: NO_CONVERGENCE)");
assert_eq(load64(_la_vec + 8), F64_ONE, "eigen_power: diag(1, 1, 1 - 2^-30) -> v = e_1, the last 1");
var _la7ct, _la7cv = eigen_power(_la_m2(F64_TWO, F64_ONE, 0, F64_TWO), 2, 0, _la_ev, _la_vec);
assert_eq(_la7cv, HSB_ERR_INVALID_INPUT, "eigen_power: max_iter = 0 -> INVALID_INPUT, the exact path too");
var _la7dt, _la7dv = eigen_power(_la_m2(F64_TWO, F64_ONE, F64_ONE, F64_TWO), 2, 0 - 3, _la_ev, _la_vec);
assert_eq(_la7dv, HSB_ERR_INVALID_INPUT, "eigen_power: max_iter = -3 -> INVALID_INPUT on the iteration's path");
# (7) [[0]]: its one eigenvalue, 0 (3.3.7: NO_CONVERGENCE); a NaN beside a triangular diagonal is
# the iteration's NO_CONVERGENCE, not an answer read off the diagonal.
_la_stamp();
var _la8t, _la8v = eigen_power(ganita_mat_new(1, 1), 1, 1000, _la_ev, _la_vec);
assert_eq(is_ok(_la8t), 1, "eigen_power: n = 1, [[0]] -> Ok(0)");
assert_eq(load64(_la_ev), 0, "eigen_power: [[0]] -> 0");
assert_eq(load64(_la_vec), F64_ONE, "eigen_power: [[0]] -> v = (1)");
var _la9t, _la9v = eigen_power(_la_m2(F64_TWO, 0x7FF8000000000000, 0, f64_from(3)), 2, 1000, _la_ev, _la_vec);
assert_eq(_la9v, HSB_ERR_NO_CONVERGENCE, "eigen_power: triangular with a NaN coupling -> NO_CONVERGENCE");
# (8) lambda - a_ii near the overflow line: d = 1.5 * 2^1023 dominant, a = -1.4 * 2^1023, so
# d - a = 2.9 * 2^1023 is past DBL_MAX and is formed from halves. v0 = 1 / (d - a) lands on
# the subnormal grid, one step above the exact 0x0002C234F72C234F (two roundings there).
_la_stamp();
var _la9bt, _la9bv = eigen_power(_la_m2(0xFFE6666666666666, F64_ONE, 0, 0x7FE8000000000000), 2, 1000, _la_ev, _la_vec);
assert_eq(load64(_la_ev), 0x7FE8000000000000, "eigen_power: [[-1.4, 1], [0, 1.5]] * 2^1023 -> d exactly");
assert_eq(load64(_la_vec), 0x0002C234F72C2350,
  "eigen_power: ... -> v0 = 1 / (d - a) without overflow, 1 grid step high");
assert_eq(load64(_la_vec + 8), F64_ONE, "eigen_power: ... -> v1 = 1");

# === 3.4.0: eigen_power, a complex pair in a component of two ===
# Row 2 of the [3.3.8] list. A 2 x 2 component's eigenvalues are A's, so its spectral radius is
# a floor like a single vertex's: max(|a + d| / 2, sqrt |ad - bc|), the second its modulus when
# the pair is complex. 3.3.7 ran Tarjan only when a diagonal entry was past the answer, and
# answered the roadmap's 4x4 with a33.
test_group("3.4.0: eigen_power, a complex pair in a component of two");
var _la_r2 = alloc(16 * 8);
for (var _la_i = 0; _la_i < 16; _la_i = _la_i + 1) { store64(_la_r2 + _la_i * 8, 0); }
store64(_la_r2, 0xB8350A7018574CEB);       store64(_la_r2 + 8, 0x383E22F02D064C7F);
store64(_la_r2 + 32, 0xB83E22F02D064C7F);  store64(_la_r2 + 40, 0xB8350A7018574CEB);
store64(_la_r2 + 80, 0x3831EEDF183EEFEA);  store64(_la_r2 + 88, 0xBB23DB28B4E134C6);
store64(_la_r2 + 120, 0x3840D712CBCE1F36);
_la_stamp();
var _la10t, _la10v = eigen_power(_la_m(4, _la_r2), 4, 1000, _la_ev, _la_vec);
assert_eq(_la10v, HSB_ERR_NO_CONVERGENCE,
  "eigen_power: the roadmap 4x4, pair -6.18e-38 +- 8.86e-38i dominant -> NO_CONVERGENCE (3.3.7: Ok, ~a33)");
assert_eq(load64(_la_ev), 0x7FF8000000000BAD, "eigen_power: the complex-pair 4x4 leaves out_val untouched");
# The floor itself (white-box). A rotation block has modulus 1: its floor is 1 less the rounding
# bound taken off det = 1, so with the margin the first |lam| refused is 3 ulp below 1 - 2^-26.
# [[2,1],[1,2]] (eigenvalues 3, 1) floors at max(2, sqrt 3) = 2: 2.5 is
# above the floor (not refused, though below rho), 1.9 below it.
var _la_rot = _la_m2(0, f64_neg(F64_ONE), F64_ONE, 0);
assert_eq(_lext_blk2_past(_la_rot, 0, 1, 0x3FEFFFFFF7FFFFFE), 0, "_lext_blk2_past: rotation, 1 - 2^-26 - 2 ulp -> 0");
assert_eq(_lext_blk2_past(_la_rot, 0, 1, 0x3FEFFFFFF7FFFFFD), 1, "_lext_blk2_past: rotation, 1 - 2^-26 - 3 ulp -> 1");
var _la_sym = _la_m2(F64_TWO, F64_ONE, F64_ONE, F64_TWO);
assert_eq(_lext_blk2_past(_la_sym, 0, 1, 0x4004000000000000), 0, "_lext_blk2_past: [[2,1],[1,2]] at 2.5 -> 0");
assert_eq(_lext_blk2_past(_la_sym, 0, 1, 0x3FFE666666666666), 1, "_lext_blk2_past: [[2,1],[1,2]] at 1.9 -> 1");
assert_eq(_lext_blk2_past(_la_sym, 1, 0, 0x3FFE666666666666), 1, "_lext_blk2_past: the pair read either way -> 1");
# Products as m * 2^e: [[0, 2^1000], [-2^-1000, 0]] has modulus 1 and its bc does not flush; and
# [[1, 2^1000], [-2^-1000, -1]] is nilpotent (det = 0, trace 0), so no floor, however small |lam|.
assert_eq(_lext_blk2_past(_la_m2(0, 0x7E70000000000000, 0x8170000000000000, 0), 0, 1, 0x3FEFAE147AE147AE), 1,
  "_lext_blk2_past: [[0, 2^1000], [-2^-1000, 0]] (modulus 1) at 0.99 -> 1");
assert_eq(_lext_blk2_past(_la_m2(F64_ONE, 0x7E70000000000000, 0x8170000000000000, f64_neg(F64_ONE)), 0, 1, 1), 0,
  "_lext_blk2_past: nilpotent [[1, 2^1000], [-2^-1000, -1]] at 2^-1074 -> 0 (no false floor)");
# ad = 2^1200 overflows a double; as m * 2^e the floor is 2^600, so 2^600 itself is not refused.
var _la_big = _la_m2(0x6570000000000000, F64_ONE, F64_ONE, 0x6570000000000000);
assert_eq(_lext_blk2_past(_la_big, 0, 1, 0x6570000000000000), 0,
  "_lext_blk2_past: [[2^600, 1], [1, 2^600]] at 2^600 -> 0 (a plain ad would be +Inf, a floor of +Inf)");
# Reducibility, both directions: a 3-cycle is strongly connected; block-triangular is not; and
# [[1,1,1],[0,1,1],[0,1,1]] reaches every vertex from 0, but no vertex reaches 0.
assert_eq(_lext_reducible(_la_m3(F64_ONE, F64_ONE, 0, 0, F64_ONE, F64_ONE, F64_ONE, 0, F64_ONE), 3, _la_s), 0,
  "_lext_reducible: a 3-cycle -> 0");
assert_eq(_lext_reducible(_la_m3(F64_ONE, F64_ONE, F64_ONE, 0, F64_ONE, F64_ONE, 0, F64_ONE, F64_ONE), 3, _la_s), 1,
  "_lext_reducible: 0 reaches all, nothing reaches 0 -> 1");
assert_eq(_lext_reducible(_la_m3(F64_ONE, 0, 0, F64_ONE, F64_ONE, F64_ONE, F64_ONE, F64_ONE, F64_ONE), 3, _la_s), 1,
  "_lext_reducible: everything reaches 0, 0 reaches nothing -> 1");
# Through eigen_power with a 2-cycle beside single vertices: 3.3.7's [[1e-3, 0, -1e20], [0, 1.3, 0],
# [0, 0, -1]] with a fourth vertex on a 2-cycle with the third, 1.3 still dominant and alone. The
# iteration stops on the pair's -1.10; 1.3 is a single-vertex floor, so NO_CONVERGENCE.
var _la_mx = alloc(16 * 8);
for (var _la_j = 0; _la_j < 16; _la_j = _la_j + 1) { store64(_la_mx + _la_j * 8, 0); }
store64(_la_mx, 0x3F50624DD2F1A9FC);       store64(_la_mx + 16, 0xC415AF1D78B58C40);
store64(_la_mx + 40, 0x3FF4CCCCCCCCCCCD);  store64(_la_mx + 80, 0xBFF0000000000000);
store64(_la_mx + 88, 0x3FD0000000000000);  store64(_la_mx + 112, 0x3FD0000000000000);
store64(_la_mx + 120, 0xBFE0000000000000);
var _la11t, _la11v = eigen_power(_la_m(4, _la_mx), 4, 1000, _la_ev, _la_vec);
assert_eq(_la11v, HSB_ERR_NO_CONVERGENCE,
  "eigen_power: a single-vertex 1.3 past the answer, beside a 2-cycle -> NO_CONVERGENCE");

# === 3.4.0: eigen_power below 2.47e-312, in a scaled frame ===
# Row 3 of the [3.3.8] list. The relative test tol |new| rounded to 0 below 2.47e-312, and the
# matvec rounded on the subnormal grid before that. A matrix whose largest |a_ij| is below 2^-511
# is now iterated as A 2^s (exact), and lambda rounded once on the way back. 1 x 1 inputs are
# the diagonal case above, so these are 2 x 2 and irreducible.
# [measured: LA probes p1, p3, p9, 3.3.7 base vs this tree, cycc 6.7.9, 2026-10-31]
test_group("3.4.0: eigen_power below 2.47e-312, in a scaled frame");
_la_stamp();
var _la12t, _la12v = eigen_power(_la_m2(0x00000000000ABCDE, 0x0000000000012345, 0x0000000000012345,
    0x00000000000ABCDE), 2,
  1000, _la_ev, _la_vec);
assert_eq(is_ok(_la12t), 1, "eigen_power: [[a,b],[b,a]], a = 3.5e-318 -> Ok (3.3.7: NO_CONVERGENCE)");
assert_eq(load64(_la_ev), 0x00000000000BE023, "eigen_power: [[a,b],[b,a]], a = 3.5e-318 -> a + b exactly");
var _la13t, _la13v = eigen_power(_la_m2(0x00000000ABCDEF12, 0x0000000012345678, 0x0000000012345678,
    0x00000000ABCDEF12), 2,
  1000, _la_ev, _la_vec);
assert_eq(load64(_la_ev), 0x00000000BE02458A,
  "eigen_power: [[a,b],[b,a]], a = 1.4e-314 -> a + b exactly (3.3.7: NO_CONVERGENCE)");
var _la14t, _la14v = eigen_power(_la_m2(0x8000, 0x4000, 0x4000, 0x8000), 2, 1000, _la_ev, _la_vec);
assert_eq(load64(_la_ev), 0xC000, "eigen_power: 2^-1060 [[2,1],[1,2]] -> 3 * 2^-1060 exactly (3.3.7: NO_CONVERGENCE)");
# THE SCALED FRAME IS THE UNSCALED ITERATION. B (entries on a 2^-10 grid) and B 2^-1040 and
# B 2^-1060, all exact: the answers are lambda(B) 2^-1040 and lambda(B) 2^-1060, each correctly
# rounded from B's (Python's own product), with B's eigenvector bit for bit.
var _la_B = _la_m2(0x3FE6C00000000000, 0x3FD3000000000000, 0x3FCB000000000000, 0x3FECE00000000000);
var _la15t, _la15v = eigen_power(_la_B, 2, 1000, _la_ev, _la_vec);
var _la_lb = load64(_la_ev);
var _la_vb = load64(_la_vec);
assert_eq(_la_lb, 0x3FF131668B6D1335, "eigen_power: B -> lambda(B), as on 3.3.7");
var _la16t, _la16v = eigen_power(_la_m2(0x00000002D8000000, 0x0000000130000000, 0x00000000D8000000,
    0x000000039C000000), 2,
  1000, _la_ev, _la_vec);
assert_eq(load64(_la_ev), 0x000000044C59A2DB,
  "eigen_power: B 2^-1040 -> lambda(B) 2^-1040, rounded once (3.3.7: NO_CONVERGENCE)");
assert_eq(load64(_la_vec), _la_vb, "eigen_power: B 2^-1040 -> B's eigenvector, bit for bit");
var _la17t, _la17v = eigen_power(_la_m2(0x2D80, 0x1300, 0xD80, 0x39C0), 2, 1000, _la_ev, _la_vec);
assert_eq(load64(_la_ev), 0x00000000000044C6,
  "eigen_power: B 2^-1060 -> lambda(B) 2^-1060, rounded once (3.3.7: NO_CONVERGENCE)");
assert_eq(load64(_la_vec), _la_vb, "eigen_power: B 2^-1060 -> B's eigenvector (the scale capped at 2^1023)");

# === 3.4.0: lyapunov_max, every column read and every scale answered ===
# Rows 5 and 9 ([3.3.8] / [3.4.0] D032). The answer is the largest of the n column averages of
# ln |r_jj|, each column of A Q scaled by the nearest power of two before the QR (hisab's own
# Householder since the 3.4.0 review; see the review group at the end of this file).
# Oracles: ln 2 and -Inf in closed form; (1/k) ln ||A^k e_0|| in 80- to 1300-digit Decimal for
# the k-step values; for the all-equal 2 x 2, (ln(a sqrt 2) + 9 ln 2a) / 10.
# [measured: LA probes p2, p7 + orc.py Decimal oracles, 3.3.7 base vs this tree, cycc 6.7.9, 2026-10-31]
test_group("3.4.0: lyapunov_max, every column read and every scale answered");
var _ly_o = alloc(8);
fn _ly_run(A, n, k) {
    store64(_ly_o, 0x7FF8000000000BAD);
    var t, v = lyapunov_max(A, n, k, _ly_o);
    if (is_err_result(t) == 1) { return v; }
    return 0;
}
# iterations <= 0: an average over no steps (3.3.7: Ok(0)).
assert_eq(_ly_run(_la_m2(F64_TWO, F64_ONE, F64_ONE, F64_TWO), 2, 0), HSB_ERR_INVALID_INPUT,
  "lyapunov_max: iterations = 0 -> INVALID_INPUT (3.3.7: Ok(0))");
assert_eq(load64(_ly_o), 0x7FF8000000000BAD, "lyapunov_max: iterations = 0 leaves out untouched");
assert_eq(_ly_run(_la_m2(F64_TWO, F64_ONE, F64_ONE, F64_TWO), 2, 0 - 1), HSB_ERR_INVALID_INPUT,
  "lyapunov_max: iterations = -1 -> INVALID_INPUT");
# e_0 not in general position: an upper-triangular A keeps it an eigenvector, and diag(0, 2)
# annihilates it. The exponent is ln 2 in all three (3.3.7: Ok(0) for each).
assert_eq(_ly_run(_la_m2(0, 0, 0, F64_TWO), 2, 10), 0, "lyapunov_max: diag(0, 2) -> Ok");
assert_eq(load64(_ly_o), F64_LN2, "lyapunov_max: diag(0, 2) -> ln 2, correctly rounded (3.3.7: 0)");
assert_eq(_ly_run(_la_m2(F64_ONE, 0, 0, F64_TWO), 2, 10), 0, "lyapunov_max: diag(1, 2) -> Ok");
assert_eq(load64(_ly_o), F64_LN2, "lyapunov_max: diag(1, 2) -> ln 2 (3.3.7: 0, column 0's ln 1)");
assert_eq(_ly_run(_la_m2(F64_ONE, F64_ONE, 0, F64_TWO), 2, 10), 0, "lyapunov_max: [[1,1],[0,2]] -> Ok");
assert_eq(load64(_ly_o), F64_LN2, "lyapunov_max: [[1,1],[0,2]] -> ln 2 (3.3.7: 0)");
# Nilpotent: A^n = 0, the exponent is -Inf (3.3.7: Ok(0)).
assert_eq(_ly_run(_la_m2(0, F64_ONE, 0, 0), 2, 10), 0, "lyapunov_max: [[0,1],[0,0]] -> Ok");
assert_eq(load64(_ly_o), 0xFFF0000000000000, "lyapunov_max: [[0,1],[0,0]] -> -Inf (3.3.7: 0)");
assert_eq(_ly_run(_la_m3(0, F64_ONE, 0, 0, 0, F64_ONE, 0, 0, 0), 3, 10), 0, "lyapunov_max: 3x3 shift -> Ok");
assert_eq(load64(_ly_o), 0xFFF0000000000000, "lyapunov_max: 3x3 shift -> -Inf");
# A rotation's columns already have largest |entry| in [2^-1/2, 2^1/2), so nothing is scaled and
# a growth factor near 1 keeps its logarithm whole: 3.1e-17 for (0.6, 0.8) against the exact
# 100-step value ln sqrt(det) = 2.2e-17 for the rounded entries (Fractions); scaling to [1, 2)
# instead gave 1.0e-15.
assert_eq(_ly_run(_la_m2(0x3FE3333333333333, 0xBFE999999999999A, 0x3FE999999999999A, 0x3FE3333333333333), 2, 100),
  0, "lyapunov_max: rotation (0.6, 0.8) -> Ok");
assert_eq(load64(_ly_o), 0x3C81EB851EB851EA,
  "lyapunov_max: rotation (0.6, 0.8), 100 steps -> 3.1e-17 (oracle ln sqrt(det) = 2.2e-17; 3.3.7: 4.2e-17)");
# An ordinary A against its k-step closed form: [[2,1],[1,2]] (lambda 3, 1), (1/k) ln ||A^k e_0||.
assert_eq(_ly_run(_la_m2(F64_TWO, F64_ONE, F64_ONE, F64_TWO), 2, 10), 0, "lyapunov_max: [[2,1],[1,2]], k = 10 -> Ok");
assert_eq(load64(_ly_o), 0x3FF105F59AB48AAA,
  "lyapunov_max: [[2,1],[1,2]], k = 10 -> the oracle, correctly rounded (3.3.7: 1.4 ulp)");
assert_eq(_ly_run(_la_m2(F64_TWO, F64_ONE, F64_ONE, F64_TWO), 2, 1000), 0,
  "lyapunov_max: [[2,1],[1,2]], k = 1000 -> Ok");
assert_eq(load64(_ly_o), 0x3FF1927F12093CB2,
  "lyapunov_max: [[2,1],[1,2]], k = 1000 -> 15 ulp from the oracle 0x...CC1 (3.3.7: 126 ulp, 0x...D3F)");
# ganita QR's silent band: a column norm whose reflector norm overflows came back Q = I, R = Z.
# a = 1.6 * 2^1022: 3.3.7 answered ln a = 708.866; the 10-step exponent is 709.525. And at
# a = 1.5 * 2^1022 A Q's reflector overflowed into NO_CONVERGENCE.
var _ly_a16 = 0x7FD999999999999A;
assert_eq(_ly_run(_la_m2(_ly_a16, _ly_a16, _ly_a16, _ly_a16), 2, 10), 0,
  "lyapunov_max: all-equal a = 1.6 * 2^1022 -> Ok");
assert_eq(load64(_ly_o), 0x40862C33050DC38B,
  "lyapunov_max: a = 1.6 * 2^1022 -> 709.52491198304179, correctly rounded (3.3.7: ln a, 0x408626EE6EBE01B7)");
var _ly_a15 = 0x7FD8000000000000;
assert_eq(_ly_run(_la_m2(_ly_a15, _ly_a15, _ly_a15, _ly_a15), 2, 10), 0,
  "lyapunov_max: all-equal a = 1.5 * 2^1022 -> Ok (3.3.7: NO_CONVERGENCE)");
assert_eq(load64(_ly_o), 0x40862BAED848169A, "lyapunov_max: a = 1.5 * 2^1022 -> 0.56 ulp from 709.46037346190422");
# and at 1.5 * 2^1023 A Q itself overflows on the second step: that column is formed from 2^-64 q_j.
var _ly_a17 = 0x7FE8000000000000;
assert_eq(_ly_run(_la_m2(_ly_a17, _ly_a17, _ly_a17, _ly_a17), 2, 10), 0,
  "lyapunov_max: all-equal a = 1.5 * 2^1023 -> Ok (3.3.7: NO_CONVERGENCE)");
assert_eq(load64(_ly_o), 0x4086313A6907D528, "lyapunov_max: a = 1.5 * 2^1023 -> 710.15352064246416, correctly rounded");
# Z is one n x n buffer for the whole call: 100 steps of an 8 x 8 took 8,760 B of arena, where a
# product per step (3.3.7) took 60,264. Since the 3.4.0 review A, Q and Z are flat n x n arrays
# and the QR is hisab's own: 1,920 B (8,752 under the same probe on the first 3.4.0 tree).
# [measured: LA probe p7 (alloc_used around the call), 3.3.7 base vs this tree, cycc 6.7.9, 2026-10-31]
# [measured: LA2 probe ar, integ-snap5 vs LA2, cycc 6.7.9, 2026-10-31]
var _ly_A8 = ganita_mat_new(8, 8);
for (var _ly_i = 0; _ly_i < 8; _ly_i = _ly_i + 1) {
    for (var _ly_j = 0; _ly_j < 8; _ly_j = _ly_j + 1) {
        ganita_mat_set(_ly_A8, _ly_i, _ly_j, f64_div(f64_from(_ly_i + 2 * _ly_j + 1), f64_from(17)));
    }
}
var _ly_u0 = alloc_used();
assert_eq(_ly_run(_ly_A8, 8, 100), 0, "lyapunov_max: 8x8, 100 steps -> Ok");
assert_lt(alloc_used() - _ly_u0, 4096, "lyapunov_max: 8x8, 100 steps -> arena under 4 KB (1,920 B; 3.3.7: 60,264)");
assert_eq(load64(_ly_o), 0x3FFBD9A9CEEBDD24, "lyapunov_max: 8x8, 100 steps -> 7.2 ulp from the oracle (3.3.7: 14.8)");

# === 3.4.0: svd_compute_checked, and the SVD out-params' shapes ===
# Row 7 ([3.4.0] D012): svd_compute retired for a Result. svd_golub_kahan's out-params are now
# held to their shapes before anything is written: through 3.3.7 a 2 x 2 out_U or out_Vt for a
# 3 x 3 A was written 5 words past its end, and then the call came back INVALID_INPUT.
# [measured: LA probe p6 (64-byte canaries), 3.3.7 base, cycc 6.7.9, 2026-10-31]
test_group("3.4.0: svd_compute_checked, and the SVD out-params' shapes");
var _sv_A = _la_m3(F64_TWO, F64_ONE, 0, 0, f64_from(3), F64_ONE, 0, 0, f64_from(4));
fn _sv_canary_ok(p) {
    for (var i = 0; i < 8; i = i + 1) { if (load64(p + i * 8) != 0x7777) { return 0; } }
    return 1;
}
fn _sv_canary(p) {
    for (var i = 0; i < 8; i = i + 1) { store64(p + i * 8, 0x7777); }
    return p;
}
var _sv_U2 = ganita_mat_new(2, 2);
var _sv_c1 = _sv_canary(alloc(64));
var _sv_S = alloc(24);
for (var _sv_i = 0; _sv_i < 3; _sv_i = _sv_i + 1) { store64(_sv_S + _sv_i * 8, 0x7FF8000000000BAD); }
var _sv1t, _sv1v = svd_golub_kahan(_sv_A, _sv_U2, _sv_S, ganita_mat_new(3, 3));
assert_eq(_sv1v, HSB_ERR_INVALID_INPUT, "svd_golub_kahan: 3x3 A, 2x2 out_U -> INVALID_INPUT");
assert_eq(_sv_canary_ok(_sv_c1), 1, "svd_golub_kahan: 2x2 out_U -> nothing written past it (3.3.7: 5 words)");
var _sv_Vt2 = ganita_mat_new(2, 2);
var _sv_c2 = _sv_canary(alloc(64));
var _sv2t, _sv2v = svd_golub_kahan(_sv_A, ganita_mat_new(3, 3), _sv_S, _sv_Vt2);
assert_eq(_sv2v, HSB_ERR_INVALID_INPUT, "svd_golub_kahan: 3x3 A, 2x2 out_Vt -> INVALID_INPUT");
assert_eq(_sv_canary_ok(_sv_c2), 1, "svd_golub_kahan: 2x2 out_Vt -> nothing written past it (3.3.7: 5 words)");
var _sv3t, _sv3v = svd_golub_kahan(_sv_A, ganita_mat_new(3, 4), _sv_S, ganita_mat_new(3, 3));
assert_eq(_sv3v, HSB_ERR_INVALID_INPUT, "svd_golub_kahan: a 3x4 out_U (not exactly m x n) -> INVALID_INPUT");
var _sv4t, _sv4v = svd_compute_checked(_sv_A, ganita_mat_new(2, 2), _sv_S, ganita_mat_new(3, 3));
assert_eq(_sv4v, HSB_ERR_INVALID_INPUT, "svd_compute_checked: 2x2 out_U -> INVALID_INPUT (svd_compute: ganita's -2)");
var _sv5t, _sv5v = svd_compute_checked(_sv_A, ganita_mat_new(3, 3), _sv_S, ganita_mat_new(3, 2));
assert_eq(_sv5v, HSB_ERR_INVALID_INPUT, "svd_compute_checked: 3x2 out_Vt -> INVALID_INPUT");
assert_eq(load64(_sv_S), 0x7FF8000000000BAD, "svd_compute_checked / svd_golub_kahan: refused -> out_S untouched");
# Its own n-slot scratch refused (ALLOC_MAX 16 against 24 bytes): ALLOC, where svd_compute gave -1.
var _sv_keep = ALLOC_MAX;
var _sv_U3 = ganita_mat_new(3, 3);
var _sv_V3 = ganita_mat_new(3, 3);
ALLOC_MAX = 16;
var _sv6t, _sv6v = svd_compute_checked(_sv_A, _sv_U3, _sv_S, _sv_V3);
ALLOC_MAX = _sv_keep;
assert_eq(_sv6v, HSB_ERR_ALLOC, "svd_compute_checked: its scratch refused -> ALLOC (svd_compute: -1)");
assert_eq(load64(_sv_S), 0x7FF8000000000BAD, "svd_compute_checked: ALLOC -> out_S untouched");
var _sv7t, _sv7v = svd_compute_checked(_sv_A, _sv_U3, _sv_S, _sv_V3);
assert_eq(is_ok(_sv7t), 1, "svd_compute_checked: the same call with the scratch admitted -> Ok");
# The arguments are judged before anything is allocated: a wrong out_U under the same cap is
# INVALID_INPUT, not the scratch's ALLOC (the shape test is hisab's own, not ganita's -2).
var _sv_U22 = ganita_mat_new(2, 2);
ALLOC_MAX = 16;
var _sv8t, _sv8v = svd_compute_checked(_sv_A, _sv_U22, _sv_S, _sv_V3);
ALLOC_MAX = _sv_keep;
assert_eq(_sv8v, HSB_ERR_INVALID_INPUT,
  "svd_compute_checked: a 2x2 out_U under ALLOC_MAX 16 -> INVALID_INPUT, before any allocation");

# === 3.4.0: solve_gmres_checked / solve_bicgstab_checked ===
# Row 8 ([3.4.0] D015). Ok only when a residual test passes, tol relative to ||b||, every other
# exit an Err; and a system scaled by powers of two gives the scaled x bit for bit.
# [measured: LA probes p10, p11, 3.3.7 base vs this tree, cycc 6.7.9, 2026-10-31]
test_group("3.4.0: solve_gmres_checked / solve_bicgstab_checked");
var _KR_KA = F64_ONE;
fn _kr_nmul(xp) {
    var o = alloc(24);
    var a0 = load64(xp);
    var a1 = load64(xp + 8);
    var a2 = load64(xp + 16);
    store64(o, f64_mul(_KR_KA, f64_add(f64_mul(f64_from(4), a0), a1)));
    store64(o + 8, f64_mul(_KR_KA, f64_add(f64_sub(f64_mul(f64_from(3), a1), a0), a2)));
    store64(o + 16, f64_mul(_KR_KA, f64_sub(f64_mul(F64_TWO, a2), f64_mul(F64_TWO, a1))));
    return o;
}
var _kr_MV = 0;
fn _kr_zero(xp) {
    _kr_MV = _kr_MV + 1;
    var o = alloc(16);
    store64(o, 0);
    store64(o + 8, 0);
    return o;
}
var _kr_b2 = alloc(16);
store64(_kr_b2, F64_ONE);
store64(_kr_b2 + 8, F64_ONE);
var _kr_x02 = alloc(16);
store64(_kr_x02, 0);
store64(_kr_x02 + 8, 0);
# A = 0, b = (1, 1): no solution. 3.3.7's GMRES returned x0 = (0, 0) as converged after 2
# matvecs (the Givens estimate of a singular Hessenberg, -0 * g0); BiCGSTAB returned x0 too.
_kr_MV = 0;
var _kr1t, _kr1v = solve_gmres_checked(&_kr_zero, _kr_b2, _kr_x02, 2, EPSILON_F64, 50, 2);
assert_eq(_kr1v, HSB_ERR_NO_CONVERGENCE, "solve_gmres_checked: A = 0, b != 0 -> NO_CONVERGENCE (3.3.7: x0)");
assert_eq(_kr_MV, 2, "solve_gmres_checked: A = 0 -> stops after 2 matvecs (a cycle that moves nothing)");
var _kr2t, _kr2v = solve_bicgstab_checked(&_kr_zero, _kr_b2, _kr_x02, 2, EPSILON_F64, 50);
assert_eq(_kr2v, HSB_ERR_NO_CONVERGENCE, "solve_bicgstab_checked: A = 0, b != 0 -> NO_CONVERGENCE (3.3.7: x0)");
# b = 0: x = 0 exactly, no matvec.
var _kr_bz = alloc(16);
store64(_kr_bz, 0);
store64(_kr_bz + 8, 0);
var _kr_xo = alloc(16);
store64(_kr_xo, F64_ONE);
store64(_kr_xo + 8, F64_TWO);
_kr_MV = 0;
var _kr3t, _kr3x = solve_gmres_checked(&_kr_zero, _kr_bz, _kr_xo, 2, EPSILON_F64, 50, 2);
assert_eq(is_ok(_kr3t), 1, "solve_gmres_checked: b = 0 -> Ok");
assert_eq(load64(_kr3x) | load64(_kr3x + 8), 0, "solve_gmres_checked: b = 0 -> x = +0 exactly, x0 ignored");
var _kr4t, _kr4x = solve_bicgstab_checked(&_kr_zero, _kr_bz, _kr_xo, 2, EPSILON_F64, 50);
assert_eq(is_ok(_kr4t), 1, "solve_bicgstab_checked: b = 0 -> Ok");
assert_eq(load64(_kr4x) | load64(_kr4x + 8), 0, "solve_bicgstab_checked: b = 0 -> x = +0 exactly");
assert_eq(_kr_MV, 0, "solve_*_checked: b = 0 -> no matvec");
# The budget: GMRES's 3 matvecs at tol 1e-18 cannot reach it (3.3.7 returned that x).
var _kr_b3 = alloc(24);
store64(_kr_b3, F64_ONE); store64(_kr_b3 + 8, F64_ONE); store64(_kr_b3 + 16, F64_ONE);
var _kr_x03 = alloc(24);
store64(_kr_x03, 0); store64(_kr_x03 + 8, 0); store64(_kr_x03 + 16, 0);
var _kr5t, _kr5v = solve_gmres_checked(&_kr_nmul, _kr_b3, _kr_x03, 3, 0x3C32725DD1D243AC, 3, 2);
assert_eq(_kr5v, HSB_ERR_NO_CONVERGENCE, "solve_gmres_checked: budget 3 spent short of tol -> NO_CONVERGENCE");
var _kr6t, _kr6v = solve_bicgstab_checked(&_kr_nmul, _kr_b3, _kr_x03, 3, 0, 1);
assert_eq(_kr6v, HSB_ERR_NO_CONVERGENCE, "solve_bicgstab_checked: max_iter 1 short of tol 0 -> NO_CONVERGENCE");
# Arguments.
var _kr_bn = alloc(24);
store64(_kr_bn, F64_ONE); store64(_kr_bn + 8, 0x7FF8000000000000); store64(_kr_bn + 16, F64_ONE);
var _kr_xi = alloc(24);
store64(_kr_xi, 0); store64(_kr_xi + 8, 0); store64(_kr_xi + 16, 0x7FF0000000000000);
var _kr7t, _kr7v = solve_gmres_checked(&_kr_nmul, _kr_b3, _kr_x03, 3, f64_neg(F64_ONE), 10, 2);
assert_eq(_kr7v, HSB_ERR_INVALID_INPUT, "solve_gmres_checked: tol < 0 -> INVALID_INPUT");
var _kr8t, _kr8v = solve_gmres_checked(&_kr_nmul, _kr_b3, _kr_x03, 3, 0x7FF8000000000000, 10, 2);
assert_eq(_kr8v, HSB_ERR_INVALID_INPUT, "solve_gmres_checked: tol NaN -> INVALID_INPUT");
var _kr9t, _kr9v = solve_gmres_checked(&_kr_nmul, _kr_bn, _kr_x03, 3, EPSILON_F64, 10, 2);
assert_eq(_kr9v, HSB_ERR_INVALID_INPUT, "solve_gmres_checked: a NaN in b -> INVALID_INPUT");
var _kr10t, _kr10v = solve_bicgstab_checked(&_kr_nmul, _kr_b3, _kr_xi, 3, EPSILON_F64, 10);
assert_eq(_kr10v, HSB_ERR_INVALID_INPUT, "solve_bicgstab_checked: an Inf in x0 -> INVALID_INPUT");
var _kr11t, _kr11v = solve_bicgstab_checked(0, _kr_b3, _kr_x03, 3, EPSILON_F64, 10);
assert_eq(_kr11v, HSB_ERR_INVALID_INPUT, "solve_bicgstab_checked: A_fn = 0 -> INVALID_INPUT");
var _kr12t, _kr12v = solve_bicgstab_checked(&_kr_nmul, _kr_b3, _kr_x03, 0, EPSILON_F64, 10);
assert_eq(_kr12v, HSB_ERR_INVALID_INPUT, "solve_bicgstab_checked: n = 0 -> INVALID_INPUT");
# An n whose n-word vectors pass ALLOC_MAX (16 < 24 bytes) is ALLOC before any allocation. (The
# per-buffer checks behind it answer only an exhausted heap: n 8 > ALLOC_MAX exactly when
# n > ALLOC_MAX / 8, so no cap reaches them first.)
var _kr_keep = ALLOC_MAX;
ALLOC_MAX = 16;
var _kr13t, _kr13v = solve_gmres_checked(&_kr_nmul, _kr_b3, _kr_x03, 3, EPSILON_F64, 10, 1);
var _kr14t, _kr14v = solve_bicgstab_checked(&_kr_nmul, _kr_b3, _kr_x03, 3, EPSILON_F64, 10);
ALLOC_MAX = _kr_keep;
assert_eq(_kr13v, HSB_ERR_ALLOC, "solve_gmres_checked: n 8 past ALLOC_MAX -> ALLOC");
assert_eq(_kr14v, HSB_ERR_ALLOC, "solve_bicgstab_checked: n 8 past ALLOC_MAX -> ALLOC");
# SCALE INVARIANCE. N = [[4,1,0],[-1,3,1],[0,-2,2]], c = (1.1, 2.1, 2.9), x0 = (1/2, -1/4, 1/8):
# (2^i N) x = 2^j c from 2^(j-i) x0, i and j in [-1020, 1020] step 20, |j - i| <= 900 (7303
# cells; 1175 in [-1000, 1000] step 50 until the second review). x 2^(i-j) must be the unit
# solve's bits, and both solvers hold it in every cell; integ-snap9 differed in 46 of them for
# each solver, all at i = 1020, where A_fn's input went subnormal. (x 2^(i-j) is formed in one
# multiply: as x 2^i 2^-j it passed through the subnormal range at j = -1020.)
# ⛔ 3.4.0 review — THE FIRST 3.4.0 TREE SWEPT ONLY [-500, 500] AND STILL EXCUSED BiCGSTAB in
# the 110 cells with |i + j| > 500, where t . t (degree two in A p) left the range; at
# (2^600, 2^600) it returned NO_CONVERGENCE. Both now solve b 2^-eb = (A 2^-ea) x' in a frame
# fixed by exact powers of two (read from b and from one probe matvec), so nothing in the
# iteration depends on the scale. The unit solves against the exact solution (Fractions):
# GMRES 3.9e-12 relative (tol 1e-12, times cond N), BiCGSTAB 1.2e-15.
# [measured: LA2 probe sw, 1175 cells per solver, cycc 6.7.9, 2026-10-31]
# [measured: LA3 probe ksw, 7303 cells per solver, integ-snap9 vs LA3, cycc 6.7.9, 2026-10-31]
fn _kr_solve(kind, i, j) {
    _KR_KA = (1023 + i) << 52;
    var kb = (1023 + j) << 52;
    var kx = (1023 + j - i) << 52;
    var b = alloc(24);
    var x0 = alloc(24);
    store64(b, f64_mul(kb, 0x3FF199999999999A));
    store64(b + 8, f64_mul(kb, 0x4000CCCCCCCCCCCD));
    store64(b + 16, f64_mul(kb, 0x4007333333333333));
    store64(x0, f64_mul(kx, F64_HALF));
    store64(x0 + 8, f64_mul(kx, 0xBFD0000000000000));
    store64(x0 + 16, f64_mul(kx, 0x3FC0000000000000));
    var t = 0;
    var x = 0;
    if (kind == 0) {
        var t1, x1 = solve_gmres_checked(&_kr_nmul, b, x0, 3, EPSILON_F64, 200, 2);
        t = t1;
        x = x1;
    } else {
        var t2, x2 = solve_bicgstab_checked(&_kr_nmul, b, x0, 3, EPSILON_F64, 200);
        t = t2;
        x = x2;
    }
    _KR_KA = F64_ONE;
    if (is_err_result(t) == 1) { return 0; }
    var o = alloc(24);
    for (var k = 0; k < 3; k = k + 1) {
        store64(o + k * 8, f64_mul(load64(x + k * 8), (1023 + i - j) << 52));   # one exact multiply
    }
    return o;
}
var _kr_xs = alloc(24);
store64(_kr_xs, 0x3FCC3C3C3C3C3C3D); store64(_kr_xs + 8, 0x3FCBDBDBDBDBDBDD); store64(_kr_xs + 16, 0x3FFAAEAEAEAEAEAF);
for (var _kr_kind = 0; _kr_kind < 2; _kr_kind = _kr_kind + 1) {
    var _kr_ref = _kr_solve(_kr_kind, 0, 0);
    var _kr_bound = 0x3DDB7CDFD9D7BDBB;   # 1e-10 (GMRES: cond N times tol 1e-12, with room)
    if (_kr_kind == 1) { _kr_bound = 0x3D06849B86A12B9B; }   # 1e-14
    var _kr_close = 0;
    for (var _kr_c = 0; _kr_c < 3; _kr_c = _kr_c + 1) {
        var _kr_e = load64(_kr_xs + _kr_c * 8);
        if (f64_lt(f64_abs(f64_sub(load64(_kr_ref + _kr_c * 8), _kr_e)), f64_mul(f64_abs(_kr_e), _kr_bound)) == 1) {
            _kr_close = _kr_close + 1;
        }
    }
    assert_eq(_kr_close, 3, "solve_*_checked: N x = c at unit scale, against the exact solution");
    var _kr_cells = 0;
    var _kr_same = 0;
    var _kr_near = 0;
    var _kr_bad = 0;
    for (var _kr_i = 0 - 1020; _kr_i <= 1020; _kr_i = _kr_i + 20) {
        for (var _kr_j = 0 - 1020; _kr_j <= 1020; _kr_j = _kr_j + 20) {
            var _kr_d = _kr_j - _kr_i;
            if (_kr_d < 0) { _kr_d = 0 - _kr_d; }
            var _kr_s = _kr_i + _kr_j;
            if (_kr_s < 0) { _kr_s = 0 - _kr_s; }
            if (_kr_d <= 900) {
                _kr_cells = _kr_cells + 1;
                var _kr_x = _kr_solve(_kr_kind, _kr_i, _kr_j);
                if (_kr_x == 0) {
                    _kr_bad = _kr_bad + 1;
                } else {
                    var _kr_eq = 0;
                    var _kr_nr = 0;
                    for (var _kr_k = 0; _kr_k < 3; _kr_k = _kr_k + 1) {
                        var _kr_r = load64(_kr_ref + _kr_k * 8);
                        var _kr_v = load64(_kr_x + _kr_k * 8);
                        if (_kr_v == _kr_r) { _kr_eq = _kr_eq + 1; }
                        if (f64_lt(f64_abs(f64_sub(_kr_v, _kr_r)), f64_mul(f64_abs(_kr_r), 0x3D06849B86A12B9B)) == 1) {
                            _kr_nr = _kr_nr + 1;
                        }
                    }
                    if (_kr_eq == 3) { _kr_same = _kr_same + 1; }
                    if (_kr_eq == 3 && _kr_s > 500) { _kr_near = _kr_near + 1; }
                    if (_kr_eq != 3) { _kr_bad = _kr_bad + 1; }
                    if (_kr_nr != 3) { _kr_bad = _kr_bad + 1; }
                }
            }
        }
    }
    assert_eq(_kr_cells, 7303, "solve_*_checked: the 2D scale sweep ran its 7303 cells");
    assert_eq(_kr_bad, 0, "solve_*_checked: every cell Ok and the unit x, bit for bit");
    assert_eq(_kr_same, 7303, "solve_*_checked: all 7303 cells give the unit x, bit for bit");
    assert_eq(_kr_near, 4982, "solve_*_checked: 4982 of the cells have |i + j| > 500, bit for bit too");
}

# === 3.4.0: linalg_ext allocations are checked ===
# Row 6 ([3.3.8] Numerics, "linalg_ext CSR / GMRES / BiCGSTAB"). Each of these stored through a
# refused allocation on 3.3.7 (exit 139); each now returns its designed 0. The CSR headers are
# forged with counts past ALLOC_MAX / 8, which only the derived bound can refuse.
# [measured: LA probes pa_spmv / pa_add / pa_transpose / pa_inertia, 3.3.7 base vs this tree, cycc 6.7.9, 2026-10-31]
test_group("3.4.0: linalg_ext allocations are checked");
var _al_rp = alloc(24);
var _al_ci = alloc(16);
var _al_v = alloc(16);
store64(_al_rp, 0); store64(_al_rp + 8, 1); store64(_al_rp + 16, 2);
store64(_al_ci, 0); store64(_al_ci + 8, 1);
store64(_al_v, F64_ONE); store64(_al_v + 8, F64_TWO);
var _al_c = csr_new(2, 2, 2, _al_rp, _al_ci, _al_v);
var _al_x = alloc(16);
store64(_al_x, F64_ONE); store64(_al_x + 8, F64_ONE);
var _al_y = csr_spmv(_al_c, _al_x);
assert_eq(load64(_al_y + 8), F64_TWO, "csr_spmv: diag(1, 2) (1, 1) -> (1, 2) (control)");
store64(_al_c, ALLOC_MAX / 8 + 1);
assert_eq(csr_spmv(_al_c, _al_x), 0, "csr_spmv: nrows past ALLOC_MAX / 8 -> 0 (3.3.7: exit 139)");
store64(_al_c, 0 - 1);
assert_eq(csr_spmv(_al_c, _al_x), 0, "csr_spmv: nrows = -1 -> 0");
# 2^61 + 1 rows: nrows * 8 wraps to 8, which alloc grants; only the derived bound refuses it.
store64(_al_c, (1 << 61) + 1);
assert_eq(csr_spmv(_al_c, _al_x), 0, "csr_spmv: nrows = 2^61 + 1 (nrows * 8 wraps to 8) -> 0");
store64(_al_c, 2);
assert_eq(csr_add(_al_c, csr_new(2, 2, 0x7FFFFFFFFFFFFFF0, _al_rp, _al_ci, _al_v)), 0,
  "csr_add: nnz whose sum overflows -> 0 (3.3.7: exit 139)");
assert_eq(csr_add(_al_c, csr_new(2, 2, 1 << 61, _al_rp, _al_ci, _al_v)), 0,
  "csr_add: nnz 2 + 2^61 (times 8 wraps to 16) -> 0");
assert_neq(csr_add(_al_c, _al_c), 0, "csr_add: the same CSR twice (control) -> a CSR");
store64(_al_c + 8, ALLOC_MAX / 8 + 1);
assert_eq(csr_transpose(_al_c), 0, "csr_transpose: ncols past ALLOC_MAX / 8 -> 0 (3.3.7: exit 139)");
store64(_al_c + 8, (1 << 61) + 1);
assert_eq(csr_transpose(_al_c), 0, "csr_transpose: ncols = 2^61 + 1 (ncols * 8 wraps to 8) -> 0");
store64(_al_c + 8, 2);
assert_neq(csr_transpose(_al_c), 0, "csr_transpose: the control -> a CSR");
var _al_keep = ALLOC_MAX;
ALLOC_MAX = 8;
var _al_is = inertia_sphere(F64_ONE, F64_ONE);
var _al_ib = inertia_box(F64_ONE, F64_ONE, F64_ONE, F64_ONE);
var _al_cn = csr_new(2, 2, 2, _al_rp, _al_ci, _al_v);
var _al_sp = csr_spmv(_al_c, _al_x);
var _al_cp = _lext_copy(_al_x, 2);
ALLOC_MAX = _al_keep;
assert_eq(_al_is, 0, "inertia_sphere: its 3x3 refused -> 0 (3.3.7: exit 139)");
assert_eq(_al_ib, 0, "inertia_box: its 3x3 refused -> 0");
assert_eq(_al_cn, 0, "csr_new: its 48-byte header refused -> 0");
assert_eq(_al_sp, 0, "csr_spmv: its 16-byte y refused -> 0");
assert_eq(_al_cp, 0, "_lext_copy: its buffer refused -> 0, before any store");

# === 3.4.0: the D102 audit's linalg findings (AU2-G3-F1, F2, F10) ===
# Every argument is judged before anything is read or written. Each of these exited 139 on
# 3.3.7, or (F1) wrote past the caller's buffer and then returned Err.
# [measured: D102 audit AU2 (G3-F1, F2, F10 repros), re-run on 3.3.7 base and this tree, cycc 6.7.9, 2026-10-31]
test_group("3.4.0: the D102 audit's linalg findings (AU2-G3-F1, F2, F10)");
fn _d1_canary(p) {
    for (var i = 0; i < 8; i = i + 1) { store64(p + i * 8, 0x5A5A5A5A5A5A5A5A); }
    return p;
}
fn _d1_intact(p) {
    for (var i = 0; i < 8; i = i + 1) { if (load64(p + i * 8) != 0x5A5A5A5A5A5A5A5A) { return 0; } }
    return 1;
}
# F1: a 3x3 A with a 1x1 out_U (3.3.7: 8 canary words overwritten), a 1x1 out_Vt, and a 4x3 A
# with a 3x3 out_U (3.3.7: 3 words).
var _d1_U11 = ganita_mat_new(1, 1);
var _d1_c1 = _d1_canary(alloc(64));
var _d1_1t, _d1_1v = svd_golub_kahan(_sv_A, _d1_U11, alloc(24), ganita_mat_new(3, 3));
assert_eq(_d1_1v, HSB_ERR_INVALID_INPUT, "svd_golub_kahan: 3x3 A, 1x1 out_U -> INVALID_INPUT");
assert_eq(_d1_intact(_d1_c1), 1,
  "svd_golub_kahan: 3x3 A, 1x1 out_U -> the 64 bytes after it untouched (3.3.7: all 8 words)");
var _d1_V11 = ganita_mat_new(1, 1);
var _d1_c2 = _d1_canary(alloc(64));
var _d1_2t, _d1_2v = svd_golub_kahan(_sv_A, ganita_mat_new(3, 3), alloc(24), _d1_V11);
assert_eq(_d1_2v, HSB_ERR_INVALID_INPUT, "svd_golub_kahan: 3x3 A, 1x1 out_Vt -> INVALID_INPUT");
assert_eq(_d1_intact(_d1_c2), 1, "svd_golub_kahan: 1x1 out_Vt -> the 64 bytes after it untouched");
var _d1_A43 = ganita_mat_new(4, 3);
for (var _d1_i = 0; _d1_i < 12; _d1_i = _d1_i + 1) {
    ganita_mat_set(_d1_A43, _d1_i / 3, _d1_i % 3, f64_from(_d1_i % 5 + 1));
}
var _d1_U33 = ganita_mat_new(3, 3);
var _d1_c3 = _d1_canary(alloc(64));
var _d1_3t, _d1_3v = svd_golub_kahan(_d1_A43, _d1_U33, alloc(24), ganita_mat_new(3, 3));
assert_eq(_d1_3v, HSB_ERR_INVALID_INPUT, "svd_golub_kahan: 4x3 A, 3x3 out_U -> INVALID_INPUT");
assert_eq(_d1_intact(_d1_c3), 1, "svd_golub_kahan: 4x3 A, 3x3 out_U -> untouched past it (3.3.7: 3 words)");
# F10: n <= 0 never reaches A_fn (3.3.7 called it with a null input: exit 139).
# [measured: LA probes pd_4, pd_5 on 3.3.7 base, cycc 6.7.9, 2026-10-31]
var _d1_MV = 0;
fn _d1_read0(xp) {
    _d1_MV = _d1_MV + 1;
    var o = alloc(8);
    store64(o, load64(xp));
    return o;
}
var _d1_b1 = alloc(8);
store64(_d1_b1, F64_ONE);
var _d1_x1 = alloc(8);
store64(_d1_x1, 0);
var _d1_4t, _d1_4v = solve_gmres_checked(&_d1_read0, _d1_b1, _d1_x1, 0, EPSILON_F64, 10, 2);
var _d1_5t, _d1_5v = solve_gmres_checked(&_d1_read0, _d1_b1, _d1_x1, 0 - 1, EPSILON_F64, 10, 2);
var _d1_6t, _d1_6v = solve_bicgstab_checked(&_d1_read0, _d1_b1, _d1_x1, 0, EPSILON_F64, 10);
var _d1_7t, _d1_7v = solve_bicgstab_checked(&_d1_read0, _d1_b1, _d1_x1, 0 - 1, EPSILON_F64, 10);
assert_eq(_d1_4v, HSB_ERR_INVALID_INPUT, "solve_gmres_checked: n = 0 -> INVALID_INPUT (3.3.7 solve_gmres: exit 139)");
assert_eq(_d1_5v, HSB_ERR_INVALID_INPUT, "solve_gmres_checked: n = -1 -> INVALID_INPUT");
assert_eq(_d1_6v, HSB_ERR_INVALID_INPUT,
  "solve_bicgstab_checked: n = 0 -> INVALID_INPUT (3.3.7 solve_bicgstab: exit 139)");
assert_eq(_d1_7v, HSB_ERR_INVALID_INPUT, "solve_bicgstab_checked: n = -1 -> INVALID_INPUT");
assert_eq(_d1_MV, 0, "solve_*_checked: n <= 0 -> A_fn never called");
# F2: the designed 0 (or a null handle) handed to the next call.
assert_eq(matrix_condition_number(0), 0xBFF0000000000000,
  "matrix_condition_number(0) -> -1, its failure value (3.3.7: exit 139)");
var _d1_c22 = csr_from_dense(_la_m2(F64_ONE, 0, 0, F64_TWO));
var _d1_d23 = ganita_mat_new(2, 3);
ganita_mat_set(_d1_d23, 0, 0, F64_ONE);
var _d1_c23 = csr_from_dense(_d1_d23);
var _d1_d32 = ganita_mat_new(3, 2);
ganita_mat_set(_d1_d32, 0, 0, F64_ONE);
var _d1_c32 = csr_from_dense(_d1_d32);
var _d1_x2 = alloc(16);
store64(_d1_x2, F64_ONE);
store64(_d1_x2 + 8, F64_ONE);
assert_eq(csr_add(_d1_c22, _d1_c23), 0, "csr_add: 2x2 + 2x3 -> 0 (the designed 0 used below)");
assert_eq(csr_spmv(csr_add(_d1_c22, _d1_c23), _d1_x2), 0, "csr_spmv(csr_add's 0) -> 0 (3.3.7: exit 139)");
assert_eq(csr_transpose(csr_add(_d1_c22, _d1_c32)), 0, "csr_transpose(csr_add's 0) -> 0 (3.3.7: exit 139)");
assert_eq(csr_from_dense(mat_new_guarded(0, 3)), 0, "csr_from_dense(mat_new_guarded(0, 3)) -> 0 (3.3.7: exit 139)");
assert_eq(csr_add(0, _d1_c22), 0, "csr_add(0, b) -> 0");
assert_eq(csr_add(_d1_c22, 0), 0, "csr_add(a, 0) -> 0");
var _d1_px = alloc(16);
store64(_d1_px, 0x7777);
store64(_d1_px + 8, 0x7777);
var _d1_lo = alloc(16);
var _d1_hi = alloc(16);
store64(_d1_lo, f64_neg(F64_ONE)); store64(_d1_lo + 8, f64_neg(F64_ONE));
store64(_d1_hi, F64_ONE); store64(_d1_hi + 8, F64_ONE);
var _d1_pg1t, _d1_pg1v = solve_pgs_checked(mat_new_guarded(0, 2), _d1_x2, _d1_px, 2, _d1_lo, _d1_hi, 5);
assert_eq(_d1_pg1v, HSB_ERR_INVALID_INPUT,
  "solve_pgs_checked(mat_new_guarded(0, 2), ...) -> INVALID_INPUT (3.3.7: exit 139)");
assert_eq(load64(_d1_px) + load64(_d1_px + 8), 0x7777 * 2, "solve_pgs_checked: a refused call leaves x untouched");
var _d1_pg2t, _d1_pg2v = solve_pgs_checked(_la_m2(F64_ONE, 0, 0, F64_ONE), _d1_x2, _d1_px, 3, _d1_lo, _d1_hi, 5);
assert_eq(_d1_pg2v, HSB_ERR_INVALID_INPUT, "solve_pgs_checked: a 2x2 A for n = 3 -> INVALID_INPUT (it read past A)");
var _d1_pg3t, _d1_pg3v = solve_pgs_checked(_la_m2(F64_ONE, 0, 0, F64_ONE), _d1_x2, _d1_px, 2, _d1_lo, _d1_hi, 5);
assert_eq(is_ok(_d1_pg3t), 1, "solve_pgs_checked: the control, I x = (1, 1) -> Ok");
assert_eq(load64(_d1_px), F64_ONE, "solve_pgs_checked: the control -> x0 = 1");

# === 3.4.0 review: the Krylov frame, its guards and BiCGSTAB's breakdown bound ===
# The independent review of the first 3.4.0 tree (REV-LA M1, S1, S2): a finite b whose ||b||
# overflowed made the threshold +Inf and returned x0 as Ok after one matvec; four non-finite
# residual checks could be removed with every suite green; and BiCGSTAB's orthogonal-t bound
# had lost the fixture that pinned its factor n.
# [measured: LA2 probes k1, s2 and s1f, integ-snap5 vs LA2, cycc 6.7.9, 2026-10-31]
test_group("3.4.0 review: the Krylov frame, its guards and BiCGSTAB's breakdown bound");
var _rk_D0 = F64_ONE;
var _rk_D1 = F64_ONE;
var _rk_MV = 0;
fn _rk_diag(xp) {
    _rk_MV = _rk_MV + 1;
    var o = alloc(16);
    store64(o, f64_mul(_rk_D0, load64(xp)));
    store64(o + 8, f64_mul(_rk_D1, load64(xp + 8)));
    return o;
}
# diag(d0, d1) x = (1.5e308, 1.5e308) from x0 = (x00, x00), tol 1e-10. The number of x_i
# within 2^-49 relative of b_i / d_i when Ok, -1 for an Err; _rk_MV the matvecs.
fn _rk_m1(kind, d0, d1, x00) {
    _rk_D0 = d0;
    _rk_D1 = d1;
    _rk_MV = 0;
    var bb = 0x7FEAB36D48E1ACF0;   # 1.5e308
    var b = alloc(16);
    store64(b, bb);
    store64(b + 8, bb);
    var x0 = alloc(16);
    store64(x0, x00);
    store64(x0 + 8, x00);
    var t = 0;
    var x = 0;
    if (kind == 0) {
        var t1, x1 = solve_gmres_checked(&_rk_diag, b, x0, 2, 0x3DDB7CDFD9D7BDBB, 50, 2);
        t = t1;
        x = x1;
    } else {
        var t2, x2 = solve_bicgstab_checked(&_rk_diag, b, x0, 2, 0x3DDB7CDFD9D7BDBB, 50);
        t = t2;
        x = x2;
    }
    _rk_D0 = F64_ONE;
    _rk_D1 = F64_ONE;
    if (is_ok(t) != 1) { return 0 - 1; }
    var c = 0;
    var u49 = (1023 - 49) << 52;
    var e0 = f64_div(bb, d0);
    var e1 = f64_div(bb, d1);
    if (f64_le(f64_abs(f64_sub(load64(x), e0)), f64_mul(e0, u49)) == 1) { c = c + 1; }
    if (f64_le(f64_abs(f64_sub(load64(x + 8), e1)), f64_mul(e1, u49)) == 1) { c = c + 1; }
    return c;
}
var _rk_x14 = 0x7FE8EB5E3FD5E4CB;   # 1.4e308
assert_eq(_rk_m1(0, F64_ONE, F64_ONE, 0), 2,
  "solve_gmres_checked: I x = (1.5e308, 1.5e308) from 0 -> b (3.4.0 first tree: Ok(0))");
assert_eq(_rk_MV, 3, "solve_gmres_checked: I x = 1.5e308 (1, 1) from 0 -> 3 matvecs (first tree: 1)");
assert_eq(_rk_m1(0, F64_ONE, F64_ONE, _rk_x14), 2,
  "solve_gmres_checked: I x = 1.5e308 (1, 1) from 1.4e308 -> b (first tree: x0)");
assert_eq(_rk_MV, 4, "solve_gmres_checked: I x = 1.5e308 (1, 1) from 1.4e308 -> 4 matvecs");
assert_eq(_rk_m1(1, F64_ONE, F64_ONE, 0), 2,
  "solve_bicgstab_checked: I x = 1.5e308 (1, 1) from 0 -> b (first tree: Ok(0))");
assert_eq(_rk_MV, 3, "solve_bicgstab_checked: I x = 1.5e308 (1, 1) from 0 -> 3 matvecs");
assert_eq(_rk_m1(1, F64_ONE, F64_ONE, _rk_x14), 2, "solve_bicgstab_checked: I x = 1.5e308 (1, 1) from 1.4e308 -> b");
assert_eq(_rk_MV, 4, "solve_bicgstab_checked: I x = 1.5e308 (1, 1) from 1.4e308 -> 4 matvecs");
assert_eq(_rk_m1(0, F64_TWO, 0x4008000000000000, 0), 2, "solve_gmres_checked: diag(2, 3) x = 1.5e308 (1, 1) -> b / d");
assert_eq(_rk_MV, 4, "solve_gmres_checked: diag(2, 3) x = 1.5e308 (1, 1) -> 4 matvecs");
assert_eq(_rk_m1(1, F64_TWO, 0x4008000000000000, 0), 2,
  "solve_bicgstab_checked: diag(2, 3) x = 1.5e308 (1, 1) -> b / d");
assert_eq(_rk_MV, 5, "solve_bicgstab_checked: diag(2, 3) x = 1.5e308 (1, 1) -> 5 matvecs");
# A solution past DBL_MAX: 2^-10 I x = 1.5e308 (1, 1) is x = 1.5e308 2^10 (1, 1). Both solve it in
# the frame, where it is finite, and refuse to return it.
assert_eq(_rk_m1(0, 0x3F50000000000000, 0x3F50000000000000, 0), 0 - 1, "solve_gmres_checked: x past DBL_MAX -> Err");
assert_eq(_rk_m1(1, 0x3F50000000000000, 0x3F50000000000000, 0), 0 - 1, "solve_bicgstab_checked: x past DBL_MAX -> Err");
# AN A_fn THAT RETURNS +Inf FROM ITS k-TH CALL. N = [[4,1,0],[-1,3,1],[0,-2,2]], c = (1.1, 2.1,
# 2.9), tol 1e-12, budget 50 (GMRES restart 2). Each run is NO_CONVERGENCE, and the matvec at
# which it stops pins where the non-finite residual is caught: removing GMRES's r check, or
# BiCGSTAB's r0, s, r or either confirmation check, moves a count (the review's mutants
# survived because nothing counted). Digit k of each row is the stop for an Inf from call k.
var _rk_INF = 0 - 1;
fn _rk_nmul(xp) {
    _rk_MV = _rk_MV + 1;
    var o = alloc(24);
    if (_rk_INF > 0 && _rk_MV >= _rk_INF) {
        store64(o, 0x7FF0000000000000);
        store64(o + 8, 0x7FF0000000000000);
        store64(o + 16, 0x7FF0000000000000);
        return o;
    }
    var a0 = load64(xp);
    var a1 = load64(xp + 8);
    var a2 = load64(xp + 16);
    store64(o, f64_add(f64_mul(f64_from(4), a0), a1));
    store64(o + 8, f64_add(f64_sub(f64_mul(f64_from(3), a1), a0), a2));
    store64(o + 16, f64_sub(f64_mul(F64_TWO, a2), f64_mul(F64_TWO, a1)));
    return o;
}
var _rk_c = alloc(24);
store64(_rk_c, 0x3FF199999999999A); store64(_rk_c + 8, 0x4000CCCCCCCCCCCD); store64(_rk_c + 16, 0x4007333333333333);
var _rk_xh = alloc(24);
store64(_rk_xh, F64_HALF); store64(_rk_xh + 8, 0xBFD0000000000000); store64(_rk_xh + 16, 0x3FC0000000000000);
var _rk_xz = alloc(24);
store64(_rk_xz, 0); store64(_rk_xz + 8, 0); store64(_rk_xz + 16, 0);
fn _rk_infrow(kind, x0, want) {
    var bad = 0;
    var p = 1000000;
    for (var k = 1; k <= 7; k = k + 1) {
        _rk_INF = k;
        _rk_MV = 0;
        var e = 0;
        if (kind == 0) {
            var t1, v1 = solve_gmres_checked(&_rk_nmul, _rk_c, x0, 3, EPSILON_F64, 50, 2);
            if (is_ok(t1) == 1) { e = 1; }
            if (is_ok(t1) == 0 && v1 != HSB_ERR_NO_CONVERGENCE) { e = 1; }
        } else {
            var t2, v2 = solve_bicgstab_checked(&_rk_nmul, _rk_c, x0, 3, EPSILON_F64, 50);
            if (is_ok(t2) == 1) { e = 1; }
            if (is_ok(t2) == 0 && v2 != HSB_ERR_NO_CONVERGENCE) { e = 1; }
        }
        if (_rk_MV != (want / p) % 10) { e = 1; }
        bad = bad + e;
        p = p / 10;
    }
    _rk_INF = 0 - 1;
    return bad;
}
assert_eq(_rk_infrow(0, _rk_xh, 2245578), 0,
  "solve_gmres_checked: Inf from call k, x0 != 0 -> NO_CONVERGENCE at 2245578");
assert_eq(_rk_infrow(0, _rk_xz, 2344677), 0,
  "solve_gmres_checked: Inf from call k, x0 = 0 -> NO_CONVERGENCE at 2344677");
assert_eq(_rk_infrow(1, _rk_xh, 2234567), 0,
  "solve_bicgstab_checked: Inf from call k, x0 != 0 -> NO_CONVERGENCE at 2234567");
assert_eq(_rk_infrow(1, _rk_xz, 2234567), 0,
  "solve_bicgstab_checked: Inf from call k, x0 = 0 -> NO_CONVERGENCE at 2234567");
# and with no Inf, the controls: Ok, GMRES after 41 matvecs (x0 = 0: 43), BiCGSTAB after 8 (7).
_rk_MV = 0;
var _rk1t, _rk1v = solve_gmres_checked(&_rk_nmul, _rk_c, _rk_xh, 3, EPSILON_F64, 50, 2);
assert_eq(is_ok(_rk1t) * 100 + _rk_MV, 141, "solve_gmres_checked: N x = c from x0 != 0 -> Ok after 41 matvecs");
_rk_MV = 0;
var _rk2t, _rk2v = solve_bicgstab_checked(&_rk_nmul, _rk_c, _rk_xz, 3, EPSILON_F64, 50);
assert_eq(is_ok(_rk2t) * 100 + _rk_MV, 107, "solve_bicgstab_checked: N x = c from 0 -> Ok after 7 matvecs");
# THE ORTHOGONAL-t BOUND CARRIES THE FACTOR n (REV-LA S1). A system from 40,000 runs of an A_fn
# whose 3rd call returns t = (-s1 + 2^-50 s1, s0, 0) for its input s: t . s is 2^-51 of the term
# sum, inside n 2^-52 = 1.5 2^-51 and outside 2^-52. With n the step is a breakdown, reported
# after 3 matvecs; without it the run went on and, on this system, converged after 9 (Ok on the
# true residual). The bound is a rounding bound and cannot tell those apart; it refuses. Of the
# 40,000 runs, dropping n changed 117: 107 ended in the same Err later (up to 402 matvecs), and
# 10 were answered (each a solution to tol). ⚠ The DBL_MIN condition beside it changed none of
# the 40,000 (tol 0 included): every term below DBL_MIN needs |s| under about 2^-1022 in a
# frame where max|b'_i| is in [1, 2), which a stop at tol >= 2^-1022 reaches first. It is
# recorded as verdict-equivalent rather than pinned.
# [measured: LA2 probe s1f, 40,000 injected-t runs with and without each condition, cycc 6.7.9, 2026-10-31]
var _rk_M = alloc(72);
var _rk_AT = 0 - 1;
fn _rk_m3(xp) {
    _rk_MV = _rk_MV + 1;
    var o = alloc(24);
    if (_rk_MV == _rk_AT) {
        var s1 = load64(xp + 8);
        store64(o, f64_add(f64_neg(s1), f64_mul(0x3CD0000000000000, s1)));   # 2^-50
        store64(o + 8, load64(xp));
        store64(o + 16, 0);
        return o;
    }
    for (var i = 0; i < 3; i = i + 1) {
        var acc = 0;
        for (var j = 0; j < 3; j = j + 1) {
            acc = f64_add(acc, f64_mul(load64(_rk_M + (i * 3 + j) * 8), load64(xp + j * 8)));
        }
        store64(o + i * 8, acc);
    }
    return o;
}
store64(_rk_M, 0x9A7EA9AEA770F480);      store64(_rk_M + 8, 0x9A88779D4F370D6C);
store64(_rk_M + 16, 0x1A8E828A72B10D18); store64(_rk_M + 24, 0x1A8A15EB307E1070);
store64(_rk_M + 32, 0x1A70000000000000); store64(_rk_M + 40, 0x1A8DB8B92E972FA6);
store64(_rk_M + 48, 0x1A8DE9480A523D66); store64(_rk_M + 56, 0x9A73BBEBF4F26CA4);
store64(_rk_M + 64, 0x1A70000000000000);
var _rk_b16 = alloc(24);
store64(_rk_b16, 0x20B50E4AA780BDE0);
store64(_rk_b16 + 8, 0xA0C7187A44C1F45E);
store64(_rk_b16 + 16, 0x3F9B8AB6F9F08B00);
_rk_AT = 3;
_rk_MV = 0;
var _rk3t, _rk3v = solve_bicgstab_checked(&_rk_m3, _rk_b16, _rk_xz, 3, 0x3DDB7CDFD9D7BDBB, 200);
_rk_AT = 0 - 1;
assert_eq(_rk3v, HSB_ERR_NO_CONVERGENCE, "solve_bicgstab_checked: t . s within n 2^-52 of its term sum -> breakdown");
assert_eq(_rk_MV, 3,
  "solve_bicgstab_checked: the orthogonal-t breakdown is reported at the 3rd matvec (without n: Ok at 9)");
# BiCGSTAB'S TWO CONFIRMATIONS (REV-LA S3). Random 3 x 3 systems, b and A from a Gaussian
# generator (seed 23), tol 1e-15, x0 = 0; oracle: the exact solution and residual in Fractions.
# S53 = [[-141.35, -0.0029, 0.13], [419.7, -38.75, 0.30], [0.34, -0.014, -49.99]]: the full
# step's recurrence residual meets tol after 7 matvecs while b - A x, the 8th, is 2.64 tol ||b||;
# the confirmation refuses it and restarts, and Ok comes at the 12th with 0.31 tol ||b||, each
# x_i within 1 ulp of the exact solution. Accepting on the recurrence returns the refused x, 8
# to 17 ulps off.
# S77 = [[-44.16, 1.59, -0.068], [-502.2, 50.05, -150.8], [0.55, 0.037, -653.96]] ends on the
# full step's confirmation (the 21st matvec): an A_fn that returns +Inf there is refused at it.
# [measured: LA2 search probe gen.py, seed 23, 90 systems, LA2 and two mutant trees + fractions, 2026-10-31]
fn _rk_m3i(xp) {
    _rk_MV = _rk_MV + 1;
    var o = alloc(24);
    for (var i = 0; i < 3; i = i + 1) {
        var acc = 0;
        for (var j = 0; j < 3; j = j + 1) {
            acc = f64_add(acc, f64_mul(load64(_rk_M + (i * 3 + j) * 8), load64(xp + j * 8)));
        }
        if (_rk_INF > 0 && _rk_MV >= _rk_INF) { acc = 0x7FF0000000000000; }
        store64(o + i * 8, acc);
    }
    return o;
}
fn _rk_set9(p, a0, a1, a2, a3, a4, a5, a6, a7, a8) {
    store64(p, a0); store64(p + 8, a1); store64(p + 16, a2); store64(p + 24, a3); store64(p + 32, a4);
    store64(p + 40, a5); store64(p + 48, a6); store64(p + 56, a7); store64(p + 64, a8);
    return p;
}
_rk_set9(_rk_M, 0xC061AB55CD09BE02, 0xBF679982BB389810, 0x3FC115EECDE9C041, 0x407A3BF6CE967D44,
  0xC04360203DC8D7CC, 0x3FD333DF7226D770, 0x3FD5B7CD942B767D, 0xBF8C65B56A1F7CAE, 0xC048FF098BFFF1D8);
var _rk_b53 = alloc(24);
store64(_rk_b53, 0xBFE196495C5DA173);
store64(_rk_b53 + 8, 0xBFEA8792E5063F4F);
store64(_rk_b53 + 16, 0x3FFD3DAC6F7AFB80);
_rk_MV = 0;
var _rk4t, _rk4x = solve_bicgstab_checked(&_rk_m3i, _rk_b53, _rk_xz, 3, 0x3CD203AF9EE75616, 200);
assert_eq(is_ok(_rk4t), 1, "solve_bicgstab_checked: S53 at tol 1e-15 -> Ok");
assert_eq(_rk_MV, 12, "solve_bicgstab_checked: S53 -> 12 matvecs (b - A x refused the full step at the 8th)");
assert_eq(load64(_rk4x), 0x3F6F8ED0F4BAF0C0, "solve_bicgstab_checked: S53 x0, 1 ulp from the exact ...F0C1");
assert_eq(load64(_rk4x + 8), 0x3FB01635E7A7AE2E, "solve_bicgstab_checked: S53 x1, 1 ulp from the exact ...AE2D");
assert_eq(load64(_rk4x + 16), 0xBFA2B668AE7F3A2A, "solve_bicgstab_checked: S53 x2, 1 ulp from the exact ...3A29");
_rk_set9(_rk_M, 0xC04614FFBED76A58, 0x3FF979543E44CAA0, 0xBFB1720D8DEAF154, 0xC07F6331049830DC,
  0x4049063E7A23E752, 0xC062DA649B47DA6C, 0x3FE1BDF7411222A7, 0x3FA2F42C89A58BF5, 0xC0846FAE2FCDE315);
var _rk_b77 = alloc(24);
store64(_rk_b77, 0xBFFBD851E32CFFDB);
store64(_rk_b77 + 8, 0x3F9F9AEF47211C85);
store64(_rk_b77 + 16, 0xBFEFD1F7B850FE1D);
_rk_MV = 0;
var _rk5t, _rk5x = solve_bicgstab_checked(&_rk_m3i, _rk_b77, _rk_xz, 3, 0x3CD203AF9EE75616, 200);
assert_eq(is_ok(_rk5t) * 100 + _rk_MV, 121, "solve_bicgstab_checked: S77 at tol 1e-15 -> Ok after 21 matvecs");
_rk_INF = 21;
_rk_MV = 0;
var _rk6t, _rk6v = solve_bicgstab_checked(&_rk_m3i, _rk_b77, _rk_xz, 3, 0x3CD203AF9EE75616, 200);
_rk_INF = 0 - 1;
assert_eq(_rk6v, HSB_ERR_NO_CONVERGENCE,
  "solve_bicgstab_checked: S77, +Inf at the confirming matvec -> NO_CONVERGENCE");
assert_eq(_rk_MV, 21, "solve_bicgstab_checked: S77, +Inf at the confirming matvec -> refused at it, the 21st");

# === 3.4.0 review: lyapunov_max's own QR, and subnormal entries ===
# REV-LA M2 and S4. Oracle: the exact finite-k value (1/k) ln of the largest column average,
# from the Gram determinants of A^k in Fractions (exact arithmetic, then a 60-digit log).
# M2: A = [[1, 1, 0], [0, 0, 3e13], [0, 1e-13, 0.5]]. ganita's QR skipped a reflector whose
# subcolumn norm was below 1e-12 of max|Z| and the comment called that harmless; it is not: Q
# never took the dominant direction, and the first 3.4.0 tree returned Ok(0) (column 0's ln 1)
# at k = 10, 100 and 1000, where ln rho = ln 2 and the oracle reads 0.6157 at k = 10 and 0.6847
# at k = 100. The QR is now hisab's own, and skips a reflector only for an exactly zero
# subcolumn. S4: B = [[0x1.7816cb4f1a2b3p-1, -0x1.a5f1c3d7e9b21p-2], [0x1.d0a3b5c7e9f11p-3,
# 0x1.5566778899aabp+0]] 2^e, k = 100: A Q in the caller's units lost up to 7 digits once the
# entries were subnormal; the matrix is now scaled by a power of two first, and the exponent
# taken back exactly.
# [measured: LA2 probe y1 + lyor.py exact oracle, integ-snap5 vs LA2, cycc 6.7.9, 2026-10-31]
test_group("3.4.0 review: lyapunov_max's own QR, and subnormal entries");
var _ly_M2 = _la_m3(F64_ONE, F64_ONE, 0, 0, 0, 0x42BB48EB57E00000, 0, 0x3D3C25C268497682, F64_HALF);
assert_eq(_ly_run(_ly_M2, 3, 10), 0, "lyapunov_max: [[1,1,0],[0,0,3e13],[0,1e-13,0.5]], k = 10 -> Ok");
assert_eq(load64(_ly_o), 0x3FE3B377049E6340,
  "lyapunov_max: M2, k = 10 -> 0.6157..., 2 ulp from the oracle (first tree: 0)");
assert_eq(_ly_run(_ly_M2, 3, 100), 0, "lyapunov_max: M2, k = 100 -> Ok");
assert_eq(load64(_ly_o), 0x3FE5E8D9DF3A1EBD,
  "lyapunov_max: M2, k = 100 -> 0.6847..., the oracle correctly rounded (first tree: 0)");
var _ly_s0 = _la_m2(0x0000000000002F03, 0x8000000000001A5F, 0x0000000000000E85, 0x000000000000555A);
assert_eq(_ly_run(_ly_s0, 2, 100), 0, "lyapunov_max: B 2^-1060 (subnormal entries) -> Ok");
assert_eq(load64(_ly_o), 0xC086F584F11096F2,
  "lyapunov_max: B 2^-1060, k = 100 -> the oracle to 0.7 ulp (first tree: ...E14B27CF)");
var _ly_s1 = _la_m2(0x0000000000000178, 0x80000000000000D3, 0x0000000000000074, 0x00000000000002AB);
assert_eq(_ly_run(_ly_s1, 2, 100), 0, "lyapunov_max: B 2^-1065 (subnormal entries) -> Ok");
assert_eq(load64(_ly_o), 0xC0871137AE81F689,
  "lyapunov_max: B 2^-1065, k = 100 -> the oracle to 0.7 ulp (first tree: ...1CA65817)");

# === 3.4.0 review: eigen_power's answer is certified on every iterative path ===
# Row 4. The power iteration can settle on a value that is not the dominant one: rounding on a
# nearly reducible A, or a dominant LEFT eigenvector orthogonal to the fixed SplitMix seed, on
# any A, normal or not. [[a00, 7.1e-5, 2.0e17], [0, -1.3556, -0.55], [2.1e-36, 0, 0.44]] with
# a00 = -1.2222 has its dominant eigenvalue at -1.3556436113151007 (roots of the exact
# characteristic polynomial; the next is 0.90 of it), and the first 3.4.0 tree returned
# Ok(-1.2222052). Every answer of the iteration must now pass a Gelfand bound below 1.001 (the
# smaller of ||(D^-1 B D)^m||_inf and ||B^m||_F, B = A / |lambda|, D = |v|, m = 1, 2, 4, ...,
# up to 2^24).
# ⛔ SECOND REVIEW (R2A SF1): the first review asked for it only when ||A||_F^2 > n lambda^2, and
# R2A's seed-orthogonal 4 x 4s passed that gate with Ok(0.99) where rho = 1: nn4_0 and nn4_6
# (non-normal), and sym4_seedorth (symmetric) with Ok(0.995). Each is NO_CONVERGENCE now, and
# so is nn4_0 at 2^1000, which takes the wide form of B'.
# [measured: LA2 probe c4 and the r4 family drive, integ-snap5 vs LA2, cycc 6.7.9, 2026-10-31]
# [measured: LA3 probes adv.py (R2A gate1/gate2 fixtures, char-poly oracle), integ-snap9 vs LA3, 2026-10-31]
test_group("3.4.0 review: eigen_power's answer is certified on every iterative path");
var _ep_R = _la_m3(0xBFF38E27098594CA, 0x3F128DB40BB7FD1D, 0x43865A075B19804B, 0, 0xBFF5B0B75AFA1339,
  0xBFE1A485C92C8056, 0x3886624D11D2F41F, 0, 0x3FDC2B568907DBC8);
var _ep_Rv = alloc(8);
var _ep_Rx = alloc(32);
var _ep_R1t, _ep_R1v = eigen_power(_ep_R, 3, 1000, _ep_Rv, _ep_Rx);
assert_eq(_ep_R1v, HSB_ERR_NO_CONVERGENCE,
  "eigen_power: a nearly reducible A, wrong lambda -> NO_CONVERGENCE (first tree: Ok(a00))");
var _ep_1 = alloc(32);
for (var _ep_i = 0; _ep_i < 4; _ep_i = _ep_i + 1) { store64(_ep_1 + _ep_i * 8, F64_ONE); }
assert_eq(_lext_gelfand(_ep_R, 3, 0xBFF38E27098594CA, _ep_1), 0,
  "eigen_power: Gelfand refuses lambda = a00 (|a11| > |a00|)");
assert_eq(_lext_gelfand(_ep_R, 3, 0xBFF5B0B75AFA1339, _ep_1), 1, "eigen_power: Gelfand certifies lambda = a11");
# a non-negative A with its Perron pair: the Collatz-Wielandt ratio, one pass
var _ep_S = _la_m3(F64_TWO, F64_ONE, 0, F64_ONE, F64_TWO, 0, 0, 0, F64_ONE);
var _ep_Sv = alloc(24);
store64(_ep_Sv, F64_ONE); store64(_ep_Sv + 8, F64_ONE); store64(_ep_Sv + 16, 0);
assert_eq(_lext_gelfand(_ep_S, 3, 0x4008000000000000, _ep_Sv), 1,
  "eigen_power: Gelfand certifies the Perron pair of [[2,1,0],[1,2,0],[0,0,1]]");
assert_eq(_lext_gelfand(_ep_S, 3, 0x4000000000000000, _ep_Sv), 0, "eigen_power: Gelfand refuses lambda = 2 there");
assert_eq(_lext_gelfand(_ep_S, 3, 0, _ep_Sv), 0, "eigen_power: Gelfand never certifies lambda = 0");
# a symmetric A with mixed signs, right answer: Ok (certified through the squarings)
var _ep_M = _la_m3(f64_from(4), F64_ONE, 0xBFF0000000000000, F64_ONE, F64_TWO, F64_ONE, 0xBFF0000000000000, F64_ONE,
  F64_ONE);
var _ep_Mt, _ep_Mv = eigen_power(_ep_M, 3, 1000, _ep_Rv, _ep_Rx);
assert_eq(is_ok(_ep_Mt), 1, "eigen_power: [[4,1,-1],[1,2,1],[-1,1,1]] -> Ok");
assert_eq(load64(_ep_Rv), 0x40120E79E944A7E6, "eigen_power: [[4,1,-1],[1,2,1],[-1,1,1]] -> 4.514136926...");
var _ep_nn0 = ganita_mat_new(4, 4);
ganita_mat_set(_ep_nn0, 0, 0, 0x3FE47B1BF61CBDAD); ganita_mat_set(_ep_nn0, 0, 1, 0x3FB030F071EC363C);
ganita_mat_set(_ep_nn0, 0, 2, 0xBFBD2D0D54EB4238); ganita_mat_set(_ep_nn0, 0, 3, 0xBFE5E288F76E58A7);
ganita_mat_set(_ep_nn0, 1, 0, 0xBFD481BD9EC86475); ganita_mat_set(_ep_nn0, 1, 1, 0x3FF1C7982B61B869);
ganita_mat_set(_ep_nn0, 1, 2, 0x3FA7CE924A41CD86); ganita_mat_set(_ep_nn0, 1, 3, 0xBFE8B342CBEBD18E);
ganita_mat_set(_ep_nn0, 2, 0, 0xBFBEA29E356BBDAE); ganita_mat_set(_ep_nn0, 2, 1, 0xBFCFB04BE58AA705);
ganita_mat_set(_ep_nn0, 2, 2, 0x3FD326E022D3A139); ganita_mat_set(_ep_nn0, 2, 3, 0x3FE01B9F6929DF62);
ganita_mat_set(_ep_nn0, 3, 0, 0xBFD75723242C732E); ganita_mat_set(_ep_nn0, 3, 1, 0x3FC5A92898FB3D16);
ganita_mat_set(_ep_nn0, 3, 2, 0x3FC04D33CD7F4134); ganita_mat_set(_ep_nn0, 3, 3, 0x3FA438B4FCA7BC70);
var _ep_nn6 = ganita_mat_new(4, 4);
ganita_mat_set(_ep_nn6, 0, 0, 0x3FE3F32767AA333B); ganita_mat_set(_ep_nn6, 0, 1, 0x3FBF0501CAC16056);
ganita_mat_set(_ep_nn6, 0, 2, 0xBFC4CC9F7ED1FBC5); ganita_mat_set(_ep_nn6, 0, 3, 0xBFE4EE7E196AA433);
ganita_mat_set(_ep_nn6, 1, 0, 0xBFD336CC78473114); ganita_mat_set(_ep_nn6, 1, 1, 0x3FF107DF913BE7E8);
ganita_mat_set(_ep_nn6, 1, 2, 0x3FBB4F714AEA3576); ganita_mat_set(_ep_nn6, 1, 3, 0xBFE1FB05D5B52E82);
ganita_mat_set(_ep_nn6, 2, 0, 0xBFB0A955F585FE7C); ganita_mat_set(_ep_nn6, 2, 1, 0x3FB7154E207A0CC2);
ganita_mat_set(_ep_nn6, 2, 2, 0x3FD1C0E264BCD4AA); ganita_mat_set(_ep_nn6, 2, 3, 0x3F71004D2FE36EA3);
ganita_mat_set(_ep_nn6, 3, 0, 0xBFDE19FDACE48CBA); ganita_mat_set(_ep_nn6, 3, 1, 0x3FBE57E3657F271E);
ganita_mat_set(_ep_nn6, 3, 2, 0x3FC24A08C2A106F7); ganita_mat_set(_ep_nn6, 3, 3, 0x3FBFEF7F8CA06C12);
var _ep_s4 = ganita_mat_new(4, 4);
ganita_mat_set(_ep_s4, 0, 0, 0x3FD8735071301D58); ganita_mat_set(_ep_s4, 0, 1, 0xBFE1CF1015063201);
ganita_mat_set(_ep_s4, 0, 2, 0xBFC55645577AFCCC); ganita_mat_set(_ep_s4, 0, 3, 0xBF70DC360AAB5D2D);
ganita_mat_set(_ep_s4, 1, 0, 0xBFE1CF1015063202); ganita_mat_set(_ep_s4, 1, 1, 0x3FD55AC227A3DE57);
ganita_mat_set(_ep_s4, 1, 2, 0x3FC38D76977993A8); ganita_mat_set(_ep_s4, 1, 3, 0x3FA7A4370EA9E11C);
ganita_mat_set(_ep_s4, 2, 0, 0xBFC55645577AFCCC); ganita_mat_set(_ep_s4, 2, 1, 0x3FC38D76977993A9);
ganita_mat_set(_ep_s4, 2, 2, 0x3FD991D25EDDAD0A); ganita_mat_set(_ep_s4, 2, 3, 0xBFB7BA79256C4E29);
ganita_mat_set(_ep_s4, 3, 0, 0xBF70DC360AAB5D32); ganita_mat_set(_ep_s4, 3, 1, 0x3FA7A4370EA9E11E);
ganita_mat_set(_ep_s4, 3, 2, 0xBFB7BA79256C4E29); ganita_mat_set(_ep_s4, 3, 3, 0x3FEF5A4AF4CB02AF);
var _ep_n0t, _ep_n0v = eigen_power(_ep_nn0, 4, 1000, _ep_Rv, _ep_Rx);
assert_eq(_ep_n0v, HSB_ERR_NO_CONVERGENCE, "eigen_power: R2A nn4_0 -> NO_CONVERGENCE (integ-snap9: Ok(0.99), rho = 1)");
var _ep_n6t, _ep_n6v = eigen_power(_ep_nn6, 4, 1000, _ep_Rv, _ep_Rx);
assert_eq(_ep_n6v, HSB_ERR_NO_CONVERGENCE, "eigen_power: R2A nn4_6 -> NO_CONVERGENCE (integ-snap9: Ok(0.99), rho = 1)");
var _ep_s4t, _ep_s4v = eigen_power(_ep_s4, 4, 1000, _ep_Rv, _ep_Rx);
assert_eq(_ep_s4v, HSB_ERR_NO_CONVERGENCE,
  "eigen_power: R2A sym4_seedorth -> NO_CONVERGENCE (integ-snap9: Ok(0.995), rho = 1)");
# nn4_0 at 2^1000 (|lambda| past 2^900: the wide form of B'), and a right answer there and at 2^-1040
var _ep_big = ganita_mat_new(4, 4);
for (var _ep_r = 0; _ep_r < 4; _ep_r = _ep_r + 1) {
    for (var _ep_c = 0; _ep_c < 4; _ep_c = _ep_c + 1) {
        ganita_mat_set(_ep_big, _ep_r, _ep_c, f64_mul(ganita_mat_get(_ep_nn0, _ep_r, _ep_c), (1023 + 1000) << 52));
    }
}
var _ep_bgt, _ep_bgv = eigen_power(_ep_big, 4, 1000, _ep_Rv, _ep_Rx);
assert_eq(_ep_bgv, HSB_ERR_NO_CONVERGENCE,
  "eigen_power: nn4_0 2^1000 -> NO_CONVERGENCE (integ-snap9: Ok(0.99 2^1000))");
var _ep_U = (1023 + 1000) << 52;   # 2^1000
var _ep_T = _la_m3(f64_mul(F64_TWO, _ep_U), _ep_U, 0, _ep_U, f64_mul(f64_from(3), _ep_U), _ep_U, 0, _ep_U,
  f64_mul(f64_from(4), _ep_U));
var _ep_Tt, _ep_Tv = eigen_power(_ep_T, 3, 1000, _ep_Rv, _ep_Rx);
assert_eq(is_ok(_ep_Tt), 1, "eigen_power: [[2,1,0],[1,3,1],[0,1,4]] 2^1000 -> Ok (the wide form certifies)");
assert_eq(load64(_ep_Rv), 0x7E92ED9EBA161F2A, "eigen_power: [[2,1,0],[1,3,1],[0,1,4]] 2^1000 -> 4.7320508 2^1000");
var _ep_u = 0x0000000400000000;   # 2^-1040
var _ep_t = _la_m3(f64_mul(F64_TWO, _ep_u), _ep_u, 0, _ep_u, f64_mul(f64_from(3), _ep_u), _ep_u, 0, _ep_u,
  f64_mul(f64_from(4), _ep_u));
var _ep_tt, _ep_tv = eigen_power(_ep_t, 3, 1000, _ep_Rv, _ep_Rx);
assert_eq(is_ok(_ep_tt), 1, "eigen_power: [[2,1,0],[1,3,1],[0,1,4]] 2^-1040 -> Ok (the wide form certifies)");
assert_eq(load64(_ep_Rv), 0x00000012ED9EBA16,
  "eigen_power: [[2,1,0],[1,3,1],[0,1,4]] 2^-1040 -> 4.7320508 2^-1040, rounded");

# === 3.4.0 review: solve_pgs_checked ===
# solve_pgs returned 0 for every outcome. The audit's repro (AU1 F-A1): A = [[5,1,1],[1,3,0],
# [1,0,2]], b = (11, 7, 9), bounds +-1000, 50 sweeps. x passed as b, lo or hi now gives the
# same bits as separate storage; max_iter 1 is NO_CONVERGENCE (3.3.7: 0 and (-1, 2.67, 5)).
# [measured: LA2 probe p1g, integ-snap5 vs LA2, cycc 6.7.9, 2026-10-31]
test_group("3.4.0 review: solve_pgs_checked");
var _pg_A = _la_m3(f64_from(5), F64_ONE, F64_ONE, F64_ONE, f64_from(3), 0, F64_ONE, 0, F64_TWO);
fn _pg_v3(a, b, c) {
    var v = alloc(24);
    store64(v, a);
    store64(v + 8, b);
    store64(v + 16, c);
    return v;
}
fn _pg_b() { return _pg_v3(f64_from(11), f64_from(7), f64_from(9)); }
fn _pg_k(c) { return _pg_v3(f64_from(c), f64_from(c), f64_from(c)); }
fn _pg_same(x, y) {
    var c = 0;
    for (var i = 0; i < 3; i = i + 1) {
        if (load64(x + i * 8) == load64(y + i * 8)) { c = c + 1; }
    }
    return c;
}
var _pg_x = _pg_b();
var _pg1t, _pg1v = solve_pgs_checked(_pg_A, _pg_b(), _pg_x, 3, _pg_k(0 - 1000), _pg_k(1000), 50);
assert_eq(is_ok(_pg1t), 1, "solve_pgs_checked: the audit's system, separate x -> Ok");
assert_eq(load64(_pg_x), 0x3FEFFFFFFFFFE70E, "solve_pgs_checked: separate x0 (1 to 6e-13)");
assert_eq(load64(_pg_x + 8), 0x4000000000000214, "solve_pgs_checked: separate x1 (2 to 6e-13)");
assert_eq(load64(_pg_x + 16), 0x401000000000018F, "solve_pgs_checked: separate x2 (4 to 2e-13)");
var _pg_xb = _pg_b();
var _pg2t, _pg2v = solve_pgs_checked(_pg_A, _pg_xb, _pg_xb, 3, _pg_k(0 - 1000), _pg_k(1000), 50);
assert_eq(is_ok(_pg2t), 1, "solve_pgs_checked: x passed as b -> Ok");
assert_eq(_pg_same(_pg_xb, _pg_x), 3,
  "solve_pgs_checked: x passed as b -> the separate solve, bit for bit (3.3.7: about 0)");
var _pg_xl = _pg_k(0 - 1000);
var _pg_xs = _pg_k(0 - 1000);
var _pg3t, _pg3v = solve_pgs_checked(_pg_A, _pg_b(), _pg_xl, 3, _pg_xl, _pg_k(1000), 50);
var _pg4t, _pg4v = solve_pgs_checked(_pg_A, _pg_b(), _pg_xs, 3, _pg_k(0 - 1000), _pg_k(1000), 50);
assert_eq(is_ok(_pg3t) + is_ok(_pg4t), 2, "solve_pgs_checked: x passed as lo, and its control -> Ok");
assert_eq(_pg_same(_pg_xl, _pg_xs), 3,
  "solve_pgs_checked: x passed as lo -> the separate solve, bit for bit (3.3.7: (402, -132, -197))");
var _pg_xh = _pg_k(1000);
var _pg_xt = _pg_k(1000);
var _pg5t, _pg5v = solve_pgs_checked(_pg_A, _pg_b(), _pg_xh, 3, _pg_k(0 - 1000), _pg_xh, 50);
var _pg6t, _pg6v = solve_pgs_checked(_pg_A, _pg_b(), _pg_xt, 3, _pg_k(0 - 1000), _pg_k(1000), 50);
assert_eq(is_ok(_pg5t) + is_ok(_pg6t), 2, "solve_pgs_checked: x passed as hi, and its control -> Ok");
assert_eq(_pg_same(_pg_xh, _pg_xt), 3, "solve_pgs_checked: x passed as hi -> the separate solve, bit for bit");
# Every entry is scanned before a zero pivot is reported: a00 = 0 with a NaN in the LAST row is
# INVALID_INPUT, not SINGULAR_PIVOT (a refusal for the zero pivot alone would hide the NaN).
var _pg_xn = _pg_b();
var _pg_N = _la_m3(0, F64_ONE, F64_ONE, F64_ONE, f64_from(3), 0, F64_ONE, 0, 0x7FF8000000000000);
var _pg0t, _pg0v = solve_pgs_checked(_pg_N, _pg_b(), _pg_xn, 3, _pg_k(0 - 1000), _pg_k(1000), 50);
assert_eq(_pg0v, HSB_ERR_INVALID_INPUT,
  "solve_pgs_checked: a00 = 0 and a22 = NaN -> INVALID_INPUT, not SINGULAR_PIVOT");
var _pg_x1 = _pg_b();
var _pg7t, _pg7v = solve_pgs_checked(_pg_A, _pg_b(), _pg_x1, 3, _pg_k(0 - 1000), _pg_k(1000), 1);
assert_eq(_pg7v, HSB_ERR_NO_CONVERGENCE, "solve_pgs_checked: one sweep, unconverged -> NO_CONVERGENCE (3.3.7: 0)");
assert_eq(load64(_pg_x1), 0xBFF0000000000000, "solve_pgs_checked: NO_CONVERGENCE leaves the last sweep in x (x0 = -1)");
# A slow sweep: [[1,1,1],[1,3,0],[1,0,2]] x = (1,2,4) is (-10, 4, 7); Gauss-Seidel contracts by
# 5/6 a sweep, so 100 sweeps stop 2e-8 short and 300 meet the stopping test.
var _pg_S = _la_m3(F64_ONE, F64_ONE, F64_ONE, F64_ONE, f64_from(3), 0, F64_ONE, 0, F64_TWO);
var _pg_xs1 = _pg_k(0);
var _pg8t, _pg8v = solve_pgs_checked(_pg_S, _pg_v3(F64_ONE, F64_TWO, f64_from(4)), _pg_xs1, 3, _pg_k(0 - 1000),
  _pg_k(1000), 100);
assert_eq(_pg8v, HSB_ERR_NO_CONVERGENCE,
  "solve_pgs_checked: 100 sweeps at 5/6 a sweep -> NO_CONVERGENCE (3.3.7: 0, x0 = -9.99999984)");
var _pg_xs2 = _pg_k(0);
var _pg9t, _pg9v = solve_pgs_checked(_pg_S, _pg_v3(F64_ONE, F64_TWO, f64_from(4)), _pg_xs2, 3, _pg_k(0 - 1000),
  _pg_k(1000), 300);
assert_eq(is_ok(_pg9t), 1, "solve_pgs_checked: 300 sweeps -> Ok");
assert_eq(f64_lt(f64_abs(f64_add(load64(_pg_xs2), f64_from(10))), 0x3E112E0BE826D695), 1,
  "solve_pgs_checked: 300 sweeps -> x0 = -10 to 1e-9");
# A divergent sweep, unbounded: [[1,2],[2,1]] grows 4x a sweep and overflows near sweep 512. Once
# an x_i is infinite its change is NaN, and that counts as moved, so the run never stops on
# max|x| = +Inf making the test +Inf: 1000 sweeps are NO_CONVERGENCE, never Ok with +-Inf in x.
var _pg_lo2 = alloc(16);
var _pg_hi2 = alloc(16);
store64(_pg_lo2, 0xFFF0000000000000); store64(_pg_lo2 + 8, 0xFFF0000000000000);
store64(_pg_hi2, 0x7FF0000000000000); store64(_pg_hi2 + 8, 0x7FF0000000000000);
var _pg_b2 = alloc(16);
store64(_pg_b2, F64_ONE); store64(_pg_b2 + 8, F64_ONE);
var _pg_x2 = alloc(16);
store64(_pg_x2, 0); store64(_pg_x2 + 8, 0);
var _pg10t, _pg10v = solve_pgs_checked(_la_m2(F64_ONE, F64_TWO, F64_TWO, F64_ONE), _pg_b2, _pg_x2, 2, _pg_lo2,
  _pg_hi2, 1000);
assert_eq(_pg10v, HSB_ERR_NO_CONVERGENCE,
  "solve_pgs_checked: a divergent sweep overflows -> NO_CONVERGENCE, not Ok with Inf");

# === 3.4.0 second review: the Krylov frame's input headroom ===
# R2A note 1: A = 2^-1020 [[1, 0.99], [0.99, 1]], b = (2^-720, 0). x = 2^300 (50.25..., -49.75...)
# is representable, and the same system at 2^-1018 was answered, but an iterate overflowed A_fn's
# input v 2^-ea (ea near -1020): NO_CONVERGENCE from both solvers on integ-snap9, at 2^-1020 and
# 2^-1022. A_fn's input is now kept in [2^-960, 2^1000] where |ea| > 800, and the three scales
# give the same bits up to the power of two.
# [measured: LA3 probe kh.py, integ-snap9 vs LA3, cycc 6.7.9, 2026-10-31]
test_group("3.4.0 second review: the Krylov frame's input headroom");
var _kh_D = 0;
fn _kh_mv(xp) {
    var o = alloc(16);
    var x0 = load64(xp);
    var x1 = load64(xp + 8);
    store64(o, f64_mul(_kh_D, f64_add(x0, f64_mul(0x3FEFAE147AE147AE, x1))));
    store64(o + 8, f64_mul(_kh_D, f64_add(f64_mul(0x3FEFAE147AE147AE, x0), x1)));
    return o;
}
fn _kh_run(kind, e, xout) {
    _kh_D = (1023 + e) << 52;
    var b = alloc(16);
    store64(b, 0x12F0000000000000);   # 2^-720
    store64(b + 8, 0);
    var z = alloc(16);
    store64(z, 0);
    store64(z + 8, 0);
    var t = 0;
    var x = 0;
    if (kind == 0) {
        var t1, x1 = solve_gmres_checked(&_kh_mv, b, z, 2, 0x3DDB7CDFD9D7BDBB, 200, 2);
        t = t1;
        x = x1;
    } else {
        var t2, x2 = solve_bicgstab_checked(&_kh_mv, b, z, 2, 0x3DDB7CDFD9D7BDBB, 200);
        t = t2;
        x = x2;
    }
    if (is_ok(t) != 1) { return x; }
    store64(xout, load64(x));
    store64(xout + 8, load64(x + 8));
    return 0;
}
var _kh_x18 = alloc(16);
var _kh_x20 = alloc(16);
var _kh_x22 = alloc(16);
for (var _kh_k = 0; _kh_k < 2; _kh_k = _kh_k + 1) {
    assert_eq(_kh_run(_kh_k, 0 - 1018, _kh_x18), 0,
      "solve_*_checked: 2^-1018 [[1, .99], [.99, 1]] x = (2^-720, 0) -> Ok");
    assert_eq(_kh_run(_kh_k, 0 - 1020, _kh_x20), 0,
      "solve_*_checked: the same at 2^-1020 -> Ok (integ-snap9: NO_CONVERGENCE)");
    assert_eq(_kh_run(_kh_k, 0 - 1022, _kh_x22), 0,
      "solve_*_checked: the same at 2^-1022 -> Ok (integ-snap9: NO_CONVERGENCE)");
    assert_eq(load64(_kh_x20), load64(_kh_x18) + (2 << 52),
      "solve_*_checked: x0 at 2^-1020 = 4 x0 at 2^-1018, bit for bit");
    assert_eq(load64(_kh_x20 + 8), load64(_kh_x18 + 8) + (2 << 52), "solve_*_checked: x1 at 2^-1020 = 4 x1 at 2^-1018");
    assert_eq(load64(_kh_x22), load64(_kh_x18) + (4 << 52), "solve_*_checked: x0 at 2^-1022 = 16 x0 at 2^-1018");
}
assert_eq(load64(_kh_x20), 0x530920292A73C7A0, "solve_bicgstab_checked: x0 at 2^-1020 = 1.0236361690123e92");
assert_eq(load64(_kh_x20 + 8), 0xD308DFD6D58C38D5, "solve_bicgstab_checked: x1 at 2^-1020 = -1.0133998073221e92");

# === 3.4.0 second review: lyapunov_max keeps a column's small entries ===
# R2A SF3: each column of A Q was scaled to a largest |entry| near 1, so an entry below 2^-1074 of
# it flushed although the caller's units held it, and the method then read the wrong column. For
# upper-triangular A the exact finite-k value is max_j ln |a_jj| at every k (exact oracle,
# Fractions). Columns now go near 2^1000; every other lyapunov assertion is unchanged in its bits.
# [measured: LA3 probe ly.py (R2A ly2.py's rows + 80 random, exact oracle), integ-snap9 vs LA3, 2026-10-31]
test_group("3.4.0 second review: lyapunov_max keeps a column's small entries");
assert_eq(_ly_run(_la_m2(0x3AF4CCCCCCCCCCCD, 0x7FEE42D130773B76, 0, 0x3C3B333333333333), 2, 20), 0,
  "lyapunov_max: [[1.3 2^-80, 1.7e308], [0, 1.7 2^-60]], k = 20 -> Ok");
assert_eq(load64(_ly_o), 0xC04487732EA643AA,
  "lyapunov_max: that -> ln a11 = -41.0582..., correctly rounded (integ-snap9: ln a00 = -55.19)");
assert_eq(_ly_run(_la_m2(0x166FD7BDE88041F9, 0x7E41EB2D66005835, 0, 0x18883CEB534F77F1), 2, 20), 0,
  "lyapunov_max: [[1.3e-200, 1.5e300], [0, 1.7e-190]], k = 20 -> Ok");
assert_eq(load64(_ly_o), 0xC07B4F5E5E949FF6,
  "lyapunov_max: that -> ln a11 = -436.96..., to 1 ulp (integ-snap9: -460.25)");

# === 3.4.0 third review: eigen_power's inertia certificate for a symmetric A ===
# Gelfand's squarings cost n^3 each, +412% at n = 100 for a symmetric A in the second review. An
# exactly symmetric A is now certified by two Cholesky factorizations, of mu I - A and mu I + A
# with mu = |lambda| (1 + 2^-11), and a rounding bound (Higham Thm 10.3, Rump's isspd form) that
# keeps every eigenvalue below 1.001 |lambda| when both succeed. Seed-orthogonal symmetric 4 x 4s
# (dominant +1 and -1, the second at 0.93 to 0.999 of it): the iteration returns the second
# (Ok(0.9932) and Ok(0.9287) without a certificate); both are NO_CONVERGENCE, the -1 one through
# the mu I + A factorization alone.
# [measured: LA4 probes so.py, symfam.py, negative-dominant set; no-cert tree, integ-snap12, LA4; 2026-10-31]
test_group("3.4.0 third review: eigen_power's inertia certificate for a symmetric A");
var _ic_pos = ganita_mat_new(4, 4);
ganita_mat_set(_ic_pos, 0, 0, 0x3FD93BB4A49EAA1E); ganita_mat_set(_ic_pos, 0, 1, 0xBFA74E8F5E1DA389);
ganita_mat_set(_ic_pos, 0, 2, 0xBFC31B87A80A9BAA); ganita_mat_set(_ic_pos, 0, 3, 0xBFB561275519F18D);
ganita_mat_set(_ic_pos, 1, 0, 0xBFA74E8F5E1DA389); ganita_mat_set(_ic_pos, 1, 1, 0x3FCDCF214D919165);
ganita_mat_set(_ic_pos, 1, 2, 0x3FCA0CA5A6298936); ganita_mat_set(_ic_pos, 1, 3, 0xBFEBACE9EFAE0BC4);
ganita_mat_set(_ic_pos, 2, 0, 0xBFC31B87A80A9BAA); ganita_mat_set(_ic_pos, 2, 1, 0x3FCA0CA5A6298936);
ganita_mat_set(_ic_pos, 2, 2, 0x3FECAC56C4DEB52C); ganita_mat_set(_ic_pos, 2, 3, 0x3FCC0538EBAB8724);
ganita_mat_set(_ic_pos, 3, 0, 0xBFB561275519F18D); ganita_mat_set(_ic_pos, 3, 1, 0xBFEBACE9EFAE0BC4);
ganita_mat_set(_ic_pos, 3, 2, 0x3FCC0538EBAB8724); ganita_mat_set(_ic_pos, 3, 3, 0x3F973B7E9371D98E);
var _ic_neg = ganita_mat_new(4, 4);
ganita_mat_set(_ic_neg, 0, 0, 0xBFCB99CDEAD896FD); ganita_mat_set(_ic_neg, 0, 1, 0x3F7F5437F9055B79);
ganita_mat_set(_ic_neg, 0, 2, 0xBFDD4BDF569F9B52); ganita_mat_set(_ic_neg, 0, 3, 0x3FDE3EDAF662A58D);
ganita_mat_set(_ic_neg, 1, 0, 0x3F7F5437F9055B79); ganita_mat_set(_ic_neg, 1, 1, 0x3FDB2AF7E22179F7);
ganita_mat_set(_ic_neg, 1, 2, 0xBFA6E26170BAEC1A); ganita_mat_set(_ic_neg, 1, 3, 0x3FE352F2F07FABEB);
ganita_mat_set(_ic_neg, 2, 0, 0xBFDD4BDF569F9B52); ganita_mat_set(_ic_neg, 2, 1, 0xBFA6E26170BAEC1A);
ganita_mat_set(_ic_neg, 2, 2, 0x3FD6B2F9DA4ABA27); ganita_mat_set(_ic_neg, 2, 3, 0xBFC5F37E3F4C1616);
ganita_mat_set(_ic_neg, 3, 0, 0x3FDE3EDAF662A58D); ganita_mat_set(_ic_neg, 3, 1, 0x3FE352F2F07FABEB);
ganita_mat_set(_ic_neg, 3, 2, 0xBFC5F37E3F4C1616); ganita_mat_set(_ic_neg, 3, 3, 0xBFDCC68CB0CEB993);
var _ic_v = alloc(8);
var _ic_x = alloc(32);
var _ic_pt, _ic_pv = eigen_power(_ic_pos, 4, 1000, _ic_v, _ic_x);
assert_eq(_ic_pv, HSB_ERR_NO_CONVERGENCE, "eigen_power: symmetric, dominant +1 hidden from the seed -> NO_CONVERGENCE");
var _ic_nt, _ic_nv = eigen_power(_ic_neg, 4, 1000, _ic_v, _ic_x);
assert_eq(_ic_nv, HSB_ERR_NO_CONVERGENCE, "eigen_power: symmetric, dominant -1 hidden from the seed -> NO_CONVERGENCE");
# the inertia certificate directly (T is A row-major, rescaled in place; W scratch)
fn _ic_cert(A, n, lam) {
    var T = alloc(n * n * 8);
    var W = alloc(n * n * 8);
    for (var i = 0; i < n; i = i + 1) {
        for (var j = 0; j < n; j = j + 1) { store64(T + (i * n + j) * 8, ganita_mat_get(A, i, j)); }
    }
    return _lext_sym_cert(T, W, n, lam);
}
var _ic_M = _la_m3(f64_from(4), F64_ONE, 0xBFF0000000000000, F64_ONE, F64_TWO, F64_ONE, 0xBFF0000000000000, F64_ONE,
  F64_ONE);
assert_eq(_ic_cert(_ic_M, 3, 0x40120E79E944A7E6), 1, "_lext_sym_cert: [[4,1,-1],[1,2,1],[-1,1,1]], its rho -> 1");
assert_eq(_ic_cert(_ic_M, 3, 0x40120BB3E61B8045), 0,
  "_lext_sym_cert: lambda 0.06% short of rho -> 0 (no Cholesky factor)");
assert_eq(_ic_cert(_ic_M, 3, 0x40120D16E7B01416), 1,
  "_lext_sym_cert: lambda 0.03% short -> 1 (inside the 2^-11 shift: no eigenvalue past 1.001 lambda)");
assert_eq(_ic_cert(_ic_M, 3, 0x3FF0000000000000), 0, "_lext_sym_cert: lambda = 1 -> 0 (|a_00| = 4 > 2 lambda)");
assert_eq(_ic_cert(_ic_neg, 4, 0x3FEDB7FC22A14CF7), 0, "_lext_sym_cert: the -1 matrix at its +0.93 answer -> 0");
# mixed signs, so the first pass cannot certify: Ok through the inertia path, at 1, 2^1000 and
# 2^-1040 (A rescaled by the power of two that puts |lambda| in [1, 2))
var _ic_mt, _ic_mv = eigen_power(_ic_M, 3, 1000, _ic_v, _ic_x);
assert_eq(is_ok(_ic_mt), 1, "eigen_power: [[4,1,-1],[1,2,1],[-1,1,1]] -> Ok (inertia certificate)");
assert_eq(load64(_ic_v), 0x40120E79E944A7E6, "eigen_power: [[4,1,-1],[1,2,1],[-1,1,1]] -> 4.514136926...");
var _ic_U = (1023 + 1000) << 52;   # 2^1000
var _ic_B = _la_m3(f64_mul(f64_from(4), _ic_U), _ic_U, f64_neg(_ic_U), _ic_U, f64_mul(F64_TWO, _ic_U), _ic_U,
  f64_neg(_ic_U), _ic_U, _ic_U);
var _ic_bt, _ic_bv = eigen_power(_ic_B, 3, 1000, _ic_v, _ic_x);
assert_eq(is_ok(_ic_bt), 1, "eigen_power: [[4,1,-1],[1,2,1],[-1,1,1]] 2^1000 -> Ok");
assert_eq(load64(_ic_v), 0x7E920E79E944A7E6, "eigen_power: [[4,1,-1],[1,2,1],[-1,1,1]] 2^1000 -> 4.514136926 2^1000");
var _ic_u = 0x0000000400000000;   # 2^-1040
var _ic_S = _la_m3(f64_mul(f64_from(4), _ic_u), _ic_u, f64_neg(_ic_u), _ic_u, f64_mul(F64_TWO, _ic_u), _ic_u,
  f64_neg(_ic_u), _ic_u, _ic_u);
var _ic_st, _ic_sv = eigen_power(_ic_S, 3, 1000, _ic_v, _ic_x);
assert_eq(is_ok(_ic_st), 1, "eigen_power: [[4,1,-1],[1,2,1],[-1,1,1]] 2^-1040 -> Ok");
assert_eq(load64(_ic_v), 0x000000120E79E945, "eigen_power: [[4,1,-1],[1,2,1],[-1,1,1]] 2^-1040 -> rounded once");

var r = assert_summary();
# Clamp before exiting: assert_summary() returns the raw failure COUNT, and a wait
# status is only 8 bits — an unclamped 256 / 512 / 768 failures would wrap to status 0 and
# score PASS. Any failure at all becomes status 1.
if (r > 0) { r = 1; }
sys_exit_group(r);
