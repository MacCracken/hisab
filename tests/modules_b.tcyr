store64(e35_s12 + 96, 0xC79F_A7A8_5DCA_D933); store64(e35_s12 + 104, 0x369B_FE52_F461_1EB6);
store64(e35_s12 + 112, 0xC2D0_857A_188D_B9FA); store64(e35_s12 + 120, 0xB4E6_4C45_19D7_D36C);
store64(e35_s12 + 128, 0xB56C_D806_3913_E978); store64(e35_s12 + 136, 0x4733_D17E_1879_E48A);
store64(e35_s12 + 144, 0x3D62_8BB6_BE3F_4916); store64(e35_s12 + 152, 0xC446_8FED_1B50_6014);
store64(e35_s12 + 160, 0xAF00_F1B7_E397_15F4); store64(e35_s12 + 168, 0xB969_8B92_361A_D3A1);
store64(e35_s12 + 176, 0x5202_53DD_A262_3D1E); store64(e35_s12 + 184, 0x4A97_04D4_68ED_3132);
var e35_s12w = vec_new();
var e35_s12i = 0;
# 2 0 3, 3 0 8, 6 7 8, 7 5 8, 5 1 8, 1 3 8, 1 4 9, 4 7 9, 2 3 9,
# 3 1 9, 7 6 9, 6 2 9, 5 7 10, 7 4 10, 1 5 10, 4 1 10, 8 0 11, 0 2 11
var e35_s12d = "20330867875851813814947923931976962957A74A15A41A80B02B";
while (e35_s12i < 54) {
    var e35_c = load8(e35_s12d + e35_s12i);
    if (e35_c >= 65) { e35_c = e35_c - 55; } else { e35_c = e35_c - 48; }
    vec_push(e35_s12w, e35_c);
    e35_s12i = e35_s12i + 1;
}
assert_eq(_dl_list_diff(delaunay_2d(_e35_pts(e35_s12, 12), 12), e35_s12w), 0,
  "3.3.5 delaunay_2d: twelve sites from 2^-298 to 2^290 give the exact 18 triangles (3.3.4: 16, one clockwise)");

# The witnesses above whose four sites, given to delaunay_2d, come back as a different
# list under the mutant they kill: the real lists, each checked in exact rationals.
# [measured: compiled mutants on scratch copies, and the exact-rational oracle, 2026-10-11; cycc 6.6.14]
fn _e35_dlw(a, b, c, d, e, f, g, h, want) {
    var p = vec_new();
    vec_push(p, hvec2_new(a, b));
    vec_push(p, hvec2_new(c, d));
    vec_push(p, hvec2_new(e, f));
    vec_push(p, hvec2_new(g, h));
    var w = vec_new();
    var i = 0;
    while (load8(want + i) != 0) {
        vec_push(w, load8(want + i) - 48);
        i = i + 1;
    }
    return _dl_list_diff(delaunay_2d(p, 4), w);
}
assert_eq(_e35_dlw(0x4D14_8E74_0000_0000, 0x4D23_2EA2_0000_0001, 0x4D14_8DEC_0000_0000, 0x4D23_2EA2_0000_0000,
    0x4D14_8E50_0000_0000, 0x4D23_2E84_0000_0000, 0x4D14_8E30_0000_0000, 0x4D23_2EC4_0000_0000, "123203"), 0,
  "middle-stage witness Ca_q2t through delaunay_2d: [1 2 3, 2 0 3]");
assert_eq(_e35_dlw(0xBEA3_B880_0000_0000, 0x3F07_407C_0000_0000, 0xBEA3_B680_0000_0001, 0x3F07_4080_0000_0000,
