store64(e35_w, 0); store64(e35_w + 8, 1); store64(e35_w + 16, 2);
store64(e35_w + 24, 2); store64(e35_w + 32, 1); store64(e35_w + 40, 3);
store64(e35_w + 48, 0); store64(e35_w + 56, 2); store64(e35_w + 64, 3);
assert_eq(_dl_list_diff(delaunay_2d(_e35_pts(e35_b, 4), 4), _e35_list(e35_w, 9)), 0,
  "3.3.5 delaunay_2d: sites near 1 and 7.8e29 give [0 1 2, 2 1 3, 0 2 3] (3.3.4: [0 1 2], site 3 dropped)");
# Two sites near 1e30 and two near 0.1: 3.3.4 returned two triangles short of the hull.
store64(e35_b, 0x4612_8DB9_0203_857E); store64(e35_b + 8, 0x462C_8966_43A5_92BC);
store64(e35_b + 16, 0x3FC3_ED1B_E3F8_26AC); store64(e35_b + 24, 0x3FE2_DE47_7651_9E64);
store64(e35_b + 32, 0x3F92_9A8C_8459_4FE0); store64(e35_b + 40, 0x3FD7_D093_868B_7888);
store64(e35_b + 48, 0x4621_BF4A_770B_2B92); store64(e35_b + 56, 0x460D_7925_52F5_1198);
store64(e35_w, 1); store64(e35_w + 8, 0); store64(e35_w + 16, 2);
store64(e35_w + 24, 0); store64(e35_w + 32, 1); store64(e35_w + 40, 3);
