assert_eq(geo_ray_capsule_branch(_graw(0x400FB17BAD811244, 0x4030572343B608E3, 0xC0291EBEE3EFC07F,
      0xBFE31309F48D716C, 0xBFE150310F623775, 0x3FE2FC16FA86E277),
