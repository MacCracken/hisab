assert_eq(geo_ray_sphere(_graw(0, 0, 0, 0, 0, 0x3FFB333333333333), geo_sphere_new(hvec3_new(0x3FD3333333333333, 0,
        0x6574CCCCCCCCCCCD), F64_ONE)), 0x6568787878787879, "geo_ray_sphere: ... and 1.3 * 2^600 away (3.3.5: NaN)");
