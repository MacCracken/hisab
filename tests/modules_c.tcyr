      F64_ONE)), 0x6570000000000000, "geo_ray_sphere: ... met half a radius off its axis: t = RN(2^600 - 0.866)");
assert_eq(geo_ray_sphere(_graw(0x1A80000000000000, 0, f64_neg(F64_ONE), 0, 0, F64_ONE), geo_sphere_new(hvec3_zero(),
      0x1A70000000000000)), 0, "geo_ray_sphere: radius 2^-600, the line 2^-599 off its centre -> 0 (3.3.5: t = 1)");
assert_eq(geo_ray_sphere(_graw(0x1A60000000000000, 0, f64_neg(F64_ONE), 0, 0, F64_ONE), geo_sphere_new(hvec3_zero(),
      0x1A70000000000000)), F64_ONE, "geo_ray_sphere: ... 2^-601 off it -> t = RN(1 - 2^-601) = 1");
