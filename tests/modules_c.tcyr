# === 3.4.1 GEO6: underflows in the sphere's certificates ===
test_group("3.4.1 GEO6: underflows in the sphere's certificates");
# a delta under DBL_MIN keeps a few bits of sq or none, and a certificate that reads them passes on their
# rounding: t 2.7e8 ulp off where 3.4.0 was right. _geo_sqrt_tiny forms sq at 2^1500, the bits of the same
# quadratic at any direction's scale. And where a sphere is under about 2^-400, |f|^2 |oc|^2 and both sides of
# each certificate's comparison flush: 0 <= 0 certified an exact miss.
# [measured: GEO6 3.4.1 us.py raw / ut.py families, exact Fraction oracle, s22 / mutants / this tree, 2026-11-01]
assert_eq(geo_ray_sphere(_graw(0xB60CEDB677743A9A, 0xB61520BED65EFD33, 0x35F83062B96E0B6F, 0x28F70B2F9627FB41,
      0x2903B49E8DF35194, 0xA8D246020928A886),
    geo_sphere_new(hvec3_new(0xB5C4EECB755E7120, 0xB5C6150D106BF198, 0x35E404FF64B41BAC), 0x35E00806BE90A632)),
  0x4D00F5B0E7B1AF64,
  "a delta under DBL_MIN: exact 4D00F5B0E7B1AF64, s22 and 3.3.7 2.7e8 ulp off");
assert_eq(geo_ray_sphere(_graw(0x2FB99561E31EF8C0, 0x300F9C9695F991F6, 0xAFF79BFDD077A31C, 0xAF795E4AE07C2E47,
      0x2F735EB5D4070A89, 0xAF4255A1C6B5BAFB),
    geo_sphere_new(hvec3_new(0xB00D61FAAFA2E18C, 0x301B5422F9528DE2, 0xAFFD10102CD33512), 0x2ED3094255EBC989)),
  0x4083094223907335,
  "_geo_sph_comp's sq (usr 1-67; mutant 0x4083094255EBC904)");
assert_eq(geo_ray_sphere(_graw(0xBA477B0C83CB4664, 0xBA4EAC08A0A4F818, 0xBA59898EBC61E8FC, 0xA4D0919310FB4896,
      0xA4D0897BC3F76477, 0x24D5D14BB134A610),
    geo_sphere_new(hvec3_new(0xBA6176059AA3B692, 0xBA633C8104BDB26C, 0x3A33FB13C35CEC82), 0x39966363BCF6C5EE)),
  0x55766361E573C937,
  "big_d flushed to 0, so sq = 0 passed _geo_sph_graze: 3.4.0 18 ulp off");
assert_eq(geo_ray_sphere(_graw(0x24F6F4B8313C7263, 0x250C8A96A5C45F6E, 0x2504EBE6FE724AEF, 0xBFBA6095FE5634BC,
      0x3FB204084D411471, 0xBF7EA83AF9DA9B51),
    geo_sphere_new(hvec3_new(0xA51046C58B5BADD0, 0x251D4EA9A6525AF6, 0x2501B919AF868D08), 0x22D612ECE61A3414)),
  0x0000000000000000,
  "both sides of _geo_sph_graze flushed: 0 <= 0 (ut 1-0; mutant 0x254AB556A1682A1A)");
assert_eq(geo_ray_sphere(_graw(0x285DCD26DA839F22, 0x2850BBBFFE7B3F6D, 0x285E59D8F62E4CFB, 0x3FD1AD0C45A44B34,
      0xBFDD40751B4F47E7, 0xBFEB0E14C8681F0C),
    geo_sphere_new(hvec3_new(0x2863538B37F32D6B, 0x2820AEFFD7F49F39, 0x282A0A92E7AF0EB9), 0x2661BAF00A1953F2)),
  0x0000000000000000,
  "both sides of _geo_sph_comp's test flushed (ut 1-28; mutant 0x2860062D43093D3D)");
assert_eq(geo_ray_sphere(_graw(0x2B627C6E564A0718, 0x2B7BF9D49D09EE18, 0xAB623D49D2CDD400, 0xB502D2115ACF1CFE,
      0xB4F56B6E1B13FAF3, 0x35078F6CC0DFD510),
    geo_sphere_new(hvec3_new(0xAB781BA567E67B8D, 0x2B61FEBE56CF6237, 0x2B8050AC8823CD15), 0x296C5A5219641D90)),
  0x366C5A5219631D47,
  "|f|^2 |oc|^2 flushed, the bound's main term gone (usr 1-2082; mutant 0x366C5A5219631D42)");
assert_eq(geo_ray_sphere(_graw(0xA85B001DF3299846, 0x2859393AAFD307BC, 0x28579F6DB9C92C42, 0x39D412FC9764FB5E,
      0xB9CB4B2E5DD35547, 0xB9D4DA064145BB98),
    geo_sphere_new(hvec3_new(0x2845A8FDFF1584F9, 0xA7FFA4AE6C96F918, 0xA84F588E9FA515B9), 0x263E2710C8FFC97C)),
  0x2E7E2710C8FFA9F6,
