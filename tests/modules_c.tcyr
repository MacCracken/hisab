# === 3.4.1 GEO6: d_perp's rounding ===
test_group("3.4.1 GEO6: d_perp's rounding");
# The plain d_perp carries 2^-53 |d| of rounding and ab's rounding as much again: over |d_perp| that is 2^-53 /
# sin(angle) of itself, and the roots take it whole. Within 1/8 of the axis it is formed with end - start's
# rounding carried, _geo_dperp_fine. The first three rows are the review's M4; then the near-parallel rays no
# family of GEO4's or the review's had (an origin in or by the barrel's end, 1,695 of 3,000 past 4 ulp on every
# tree), the threshold from both sides, and d past the squares' range each way.
# [measured: GEO6 3.4.1 capb.py pt, capc.py st, nv, nvs, exact Fraction oracle, s22 / mutants / this tree, 2026-11-01]
assert_eq(geo_ray_capsule_branch(_graw(0x42CAE64541AA4063, 0xC2B1F9CC83FCA483, 0x42BDA3E2C86986DA,
      0xBFEAE64544AB71D1, 0x3FD1F9CC85FEB16F, 0xBFDDA3E2CBB911E3),
    geo_capsule_new(hvec3_new(0xC002898CBEED9290, 0x40041372F7146998, 0xBFEEBC8E9EAFD806),
      hvec3_new(0xC14AE6465C005B6B, 0x4131F9CF29092600, 0xC13DA3E3EC837C7F), 0x401FFF5BD43F60EA), _g6_br),
  0x42CFFFFFFFEA47B8,
  "exact barrel hit 42CFFFFFFFEA47B8 (s19 the miss)");
assert_eq(load64(_g6_br), GEO_CAP_CYLINDER, "... the barrel");
assert_eq(geo_ray_capsule_branch(_graw(0x40AB050F2930679A, 0x4086184B2060491E, 0xC0A6D181FBA14D5B,
      0xBFE82906D06F4EF0, 0xBFC3C1B79B4C45B5, 0x3FE464AEC80CBF8B),
    geo_capsule_new(hvec3_new(0xBFE3F82F59D76B50, 0xBFC0DB403A82DA60, 0xBFEDFD94FCE688B0),
      hvec3_new(0x40D828DEE05C81B7, 0x40B3C195E101D8E4, 0xC0D464EAC31788CE), 0x3ED973AB8DB3D12F), _g6_br),
  0x40B1E59C72BD32A2,
  "exact barrel exit 40B1E59C72BD32A2 (s19 the miss)");
assert_eq(load64(_g6_br), GEO_CAP_CYLINDER, "... the barrel");
assert_eq(geo_ray_capsule_branch(_graw(0x40B009A458BAA59C, 0xC0DC61AF7AB2982D, 0xC0D8CD75A2A70D9E,
      0xBFBB1B278BB26631, 0x3FE7F627C894018D, 0x3FE4EFE8CD48EBC3),
