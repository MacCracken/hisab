assert_eq(geo_ray_sphere(_graw(0xC2585831B3859D55, 0xC256307850AEA117, 0xC24B49A608FDC384, 0x3FFCE741DDD40EA8,
      0x3FFA58371E166749, 0x3FF032E73583C190), geo_sphere_new(hvec3_new(0xC09A6F33B80D66FC, 0xC056E3B63A42A540,
