# === 3.4.1 CO7: a ball on a cylinder at any orientation, up to the rim ===
# Exact depths from the closed form in 80-digit Decimal (a side: r - (rho - R); a cap: r - (|z| - hz)),
# eps M 2^-46. Each scene is the worst of one repair part's mutant: without that part it is the
# number of eps the message gives; every pin is under 0.01 eps of exact.
# [measured: lane CO7 mutrun.py and gen7.py seeds 1 to 5, this tree and each mutant; 2026-11-01]
fn _co7_sup_cyl(s, d) {
    _co4_calls = _co4_calls + 1;
    var c = hvec3_new(load64(s), load64(s + 8), load64(s + 16));
    var u = hvec3_new(load64(s + 24), load64(s + 32), load64(s + 40));
    var hz = load64(s + 56);
    var du = hvec3_dot(d, u);
    var p = hvec3_sub(d, hvec3_scale(u, du));
    p = hvec3_sub(p, hvec3_scale(u, hvec3_dot(p, u)));
    var pl = hvec3_length(p);
    if (f64_gt(pl, f64_mul(hvec3_length(d), 0x3CF0000000000000)) == 1) {
        c = hvec3_add(c, hvec3_scale(p, f64_div(load64(s + 48), pl)));
    }
    if (f64_lt(du, 0) == 1) { hz = f64_neg(hz); }
    return hvec3_add(c, hvec3_scale(u, hz));
}
fn _co7_cyl(c, u, r, hz) {
    var s = alloc(64);
    for (var i = 0; i < 3; i = i + 1) {
        store64(s + i * 8, load64(c + i * 8));
        store64(s + 24 + i * 8, load64(u + i * 8));
    }
    store64(s + 48, r);
    store64(s + 56, hz);
    return s;
}
fn _co7_ge(c, b) {
    var r = gjk_epa_3d(&_co7_sup_cyl, c, &_co4_sup_sph, b, _co4_n, _co4_d);
    if (r != 1) { return 0 - 1; }
    return load64(_co4_d);
}
fn _co7_mp(c, b) {
