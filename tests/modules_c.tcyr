assert_eq(geo_ray_sphere(_graw(0xE58AE29B14B4F4CA, 0x6576DFAB2AA4FBAA, 0xE58019A6D77E92CA, 0x3FC57DBFAF500276,
      0xBFEE5DB765EEFB7C, 0x3FD1178E051A5192), geo_sphere_new(hvec3_new(0xE57F37EBFD028BBC, 0x6562F01EFF38BE34,
        0xE5710BAD3D02CB26), 0x657E4C2A485D48E9)), 0x6454D1FA9A0E6F0B,
  "geo_ray_sphere: ... 1.78e-6 radii outside, at 2^600: the same t times 2^600 (3.3.5: NaN)");
