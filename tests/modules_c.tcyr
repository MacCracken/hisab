assert_eq(geo_ray_capsule_branch(_graw(0x70F1F5625343B468, 0x70E058F5860612BC, 0xF0EA2AD3D42C6AE0, 0x3FE0310B5AD5964E,
      0xBFF0000000000000, 0x3FE5FE0B6DCA9F5A), geo_capsule_new(hvec3_new(0x70FA919D51D5DFE0, 0xF0FADD3D620C3FB8,
        0x70E31A9261012804), hvec3_new(0x710CE6D7BBB92A32, 0xF0F42CDAFC2309A4, 0x70E4E123E592F358),
      0x6D957A64EB2F7756), _rq6_br), 0, "geo_ray_capsule_branch: ... z: the miss");
assert_eq(geo_ray_capsule_branch(_graw(0xBFE44CCD8FA3FB70, 0xC019C61044BEA6F0, 0xBFF6F2FAE14E0750, 0x3FC990025E857233,
      0xBFEEB8E4E5C5ED66, 0x3FC913B8753151CB), geo_capsule_new(hvec3_new(0x3FE81A0465304CD0, 0xC005CCCF6DE9A9CA,
        0xBFF1038F6375CCFB), hvec3_new(0x56B610A5F87ADAD8, 0xD6DA84CECBADF39C, 0x56B5A55D6EB415E0),
      0x3FBE18D3D5EFBF82), _rq6_br), 0, "geo_ray_capsule_branch: ... an end cap 2.6e110 away: 0");
assert_eq(geo_ray_sphere(_graw(0xCCFFA82D7DD97206, 0xCD0AB49E16110B2C, 0x4D18CCCDEB416D59, 0x3FC351AA18103000,
      0x3FF0000000000000, 0xBFEAED1113B1CE7D), geo_sphere_new(hvec3_new(0xCCF0F8ED3D085DF0, 0x4D05F10805DB0C28,
        0x4CF155402746A728), 0x45A4BE175B3EF594)), 0, "geo_ray_sphere: ... a sphere missed the same way: 0");
# And a part the threshold sends to it (2^-80 of the squared vector, the test inline in
# geo_ray_capsule_branch): the capsule (0,0,0)-(2^60, 2^61, 2^61) of radius 1, from the
# axis point 2^59 (1,2,2) along (1 + 2^-48, 2 - 2^-48, 2 + 2^-48), whose part across the
# axis is 2^-48 (8, -11, 7) / 9, so |d_perp|^2 is 2^-97 of d . d (this fixture's ratio, well
# under the threshold): the barrel exit rounded (exact 0.34 ulp away; 3.3.5: 1.6e12 ulp
# off, as the projection's rounding reads d_perp).
assert_eq(geo_ray_capsule_branch(_graw(0x43A0000000000000, 0x43B0000000000000, 0x43B0000000000000, 0x3FF0000000000010,
      0x3FFFFFFFFFFFFFF0, 0x4000000000000008), geo_capsule_new(hvec3_zero(), hvec3_new(0x43B0000000000000,
        0x43C0000000000000, 0x43C0000000000000), F64_ONE), _rq6_br), 0x42E2D3C008FD1895,
  "geo_ray_capsule_branch: |d_perp|^2 under 2^-97 d . d: the barrel exit rounded, 0.34 ulp (s14 0.66)");
# (3.4.0: the origin is 2^61 radii from the start, so the barrel is solved from exact coefficients
# (_geo_barrel_xact); exact 0x42E2D3C008FD1895 + 0.34 ulp, re-derived in Fractions.)
assert_eq(load64(_rq6_br), GEO_CAP_CYLINDER, "... on the barrel");

assert_eq(_GB_RUN, 250, "barycentric triangle-scale sweep actually ran");
assert_eq(_GB_BAD, 0,
  "geo_barycentric_coords: (1/4, 1/2, 1/4) exact for legs 2^0 down to 2^-249");
# ⭐ ANTI-DELETION, 3.4.0: a colinear triangle gets the [3.4.0] contract's least-squares weights of
# minimum norm, which reproduce the point: for (0,0,0), (1,0,0), (2,0,0) and p = (1/2, 0, 0) they
# are (7/12, 1/3, 1/12), here 0.67 ulp low in u and 1 in w (3.3.7: the centroid, which put p at 1).
# [measured: rt340 barycentric fixtures (fix3.py), exact Fraction oracle, 2026-10-31; cyrius 6.7.9]
var _gb_colw = geo_barycentric_coords(geo_triangle_new(hvec3_new(0, 0, 0), hvec3_new(F64_ONE, 0, 0),
    hvec3_new(F64_TWO, 0, 0)), hvec3_new(F64_HALF, 0, 0));
assert_eq(HVec3_x(_gb_colw), 0x3FE2AAAAAAAAAAAA,
  "geo_barycentric_coords: a colinear triangle: u = 7/12 (3.3.7: the centroid)");
assert_eq(HVec3_y(_gb_colw), _GEO_F64_THIRD, "geo_barycentric_coords: ... v = 1/3");
assert_eq(HVec3_z(_gb_colw), 0x3FB5555555555554, "geo_barycentric_coords: ... w = 1/12");
# 3.3.4: and one with A = B, so v0 = 0 and the scale comes from v1 alone (from v0 it
# would be 2^1023, v1 would overflow, and the weights would be NaN).
assert_eq(HVec3_z(geo_barycentric_coords(geo_triangle_new(hvec3_new(0, 0, 0), hvec3_new(0, 0, 0),
        hvec3_new(f64_from(3), 0, 0)), hvec3_new(F64_ONE, F64_ONE, 0))), _GEO_F64_THIRD,
  "geo_barycentric_coords: a triangle with A = B still returns centroid weights");
# 3.3.4: a query whose weights are near 2^1023 holds the scale down, as the closest
# point's offset does. Edges 1.9 * 2^-10, query (2^1014, 0, 0): scaled by the edges alone
# (2^10) the query is 2^1024 = +Inf. 3.3.3's arithmetic gave v 1 ulp under 2^1024 / 1.9 (2.8 2^-53 of it
# off); 3.4.1 (GEO5) gives the exact weights' roundings (the offset is outside the certified range:
# _geo_bary_thin).
# [measured: GEO5 3.4.1 Fraction oracle on this fixture, 2026-11-01]
var _bq_e = 0x3F5E666666666666;   # 1.9 * 2^-10
var _bq_w = geo_barycentric_coords(geo_triangle_new(hvec3_zero(), hvec3_new(_bq_e, 0, 0), hvec3_new(0, _bq_e, 0)),
  hvec3_new(0x7F50000000000000, 0, 0));
assert_eq(HVec3_y(_bq_w), 0x7FE0D79435E50D79, "geo_barycentric_coords: weights near 2^1023, v (bits; not Inf)");
assert_eq(HVec3_x(_bq_w), 0xFFE0D79435E50D79, "geo_barycentric_coords: ... u = 1 - v (bits; not NaN)");
assert_eq(HVec3_z(_bq_w), 0, "geo_barycentric_coords: ... w = +0");

test_group("3.3.6 geo: the sphere's fast path against the general routine, and the capsule's repairs");
# _geo_sphere_roots is _geo_sphere_roots_full's common case written out on its own: the two
# must agree word for word, on rays that take each hand-off (a small d, an overflow, a tiny
# sphere, a cancelled c, an offset that needs the exact form, a classic discriminant out of
# range, a tangent) and on rays that take none (outside and inside, both signs of hb, a miss).
var _r3_runs = 0;
var _r3_drift = 0;
fn _r3_cmp(ox, oy, oz, dx, dy, dz, cx, cy, cz, r) {
    var ray = _graw(ox, oy, oz, dx, dy, dz);
    var sph = geo_sphere_new(hvec3_new(cx, cy, cz), r);
    var ra = alloc(16);
    var rb = alloc(16);
    store64(ra, 0x7FF4000000000001);
    store64(ra + 8, 0x7FF4000000000001);
    store64(rb, 0x7FF4000000000001);
    store64(rb + 8, 0x7FF4000000000001);
    var ka = _geo_sphere_roots(ray, sph, ra);
    var kb = _geo_sphere_roots_full(ray, sph, rb);
    _r3_runs = _r3_runs + 1;
    if (ka != kb || load64(ra) != load64(rb) || load64(ra + 8) != load64(rb + 8)) { _r3_drift = _r3_drift + 1; }
    return 0;
}
for (var _r3k = 0; _r3k < 16; _r3k = _r3k + 1) {
    # full-mantissa rays at unit size: outside and moving in, then the same reversed
    var _r3x = f64_sub(f64_mul(f64_from(_r3k), 0x3FD7AE147AE147AE), 0x4008CCCCCCCCCCCD);
    _r3_cmp(_r3x, 0x3FFB333333333333, 0xC022333333333333, 0x3FB999999999999A, 0xBFC999999999999A,
      0x3FF0A3D70A3D70A4, 0x3FB999999999999A, 0xBFC999999999999A, 0x3FD3333333333333, 0x3FF4A3D70A3D70A4);
    _r3_cmp(_r3x, 0x3FFB333333333333, 0xC022333333333333, 0xBFB999999999999A, 0x3FC999999999999A,
      0xBFF0A3D70A3D70A4, 0x3FB999999999999A, 0xBFC999999999999A, 0x3FD3333333333333, 0x3FF4A3D70A3D70A4);
    # inside, the classic discriminant
    _r3_cmp(f64_mul(_r3x, 0x3FC0000000000000), 0x3FC999999999999A, 0x3FD3333333333333, 0x3FD3333333333333,
      0xBFE0000000000000, 0x3FE999999999999A, 0, 0, 0, F64_ONE);
}
_r3_cmp(0, 0, f64_neg(f64_from(10)), 0, 0, F64_ONE, 0, 0, 0, F64_ONE);                         # the bench ray
_r3_cmp(0, 0, f64_neg(f64_from(10)), 0, 0, f64_neg(F64_ONE), 0, 0, 0, F64_ONE);                # moving away
_r3_cmp(0x4000000000000000, 0, f64_neg(f64_from(5)), 0, 0, F64_ONE, 0, 0, 0, F64_ONE);         # a miss
_r3_cmp(F64_ONE, 0, f64_neg(f64_from(5)), 0, 0, F64_ONE, 0, 0, 0, F64_ONE);                    # tangent
_r3_cmp(0, 0, f64_neg(f64_from(5)), 0, 0, 0x1A70000000000000, 0, 0, 0, F64_ONE);               # small d
_r3_cmp(0, 0, 0, 0, 0, F64_ONE, 0, 0, 0x6570000000000000, F64_ONE);                             # overflow: c
_r3_cmp(0, 0, f64_neg(f64_from(5)), 0, 0, 0x6570000000000000, 0, 0, 0, F64_ONE);               # overflow: a delta
_r3_cmp(0x03F8000000000000, 0, 0, 0x4370000000000000, 0, 0, 0, 0, 0, 0x03F0000000000000);    # tiny
_r3_cmp(0x1F75555555555555, 0x1F65555555555555, 0, 0x5F3AAAAAAAAAAAAB, 0x5F2AAAAAAAAAAAAB, 0, 0, 0, 0,
  0x1F7999999999999A);                                                                          # tiny, inside
_r3_cmp(0x4314000000000000, 0xC310000000000000, 0, 0, 0x5F30000000000000, 0, 0, 0, 0, 0x4314000000000000);
_r3_cmp(0, 0, 0, 0x2FB0000000000000, 0, 0, 0, 0, 0, 0x2D30000000000000);                       # a classic dc flushed
_r3_cmp(0xC00AE29B14B4F4CA, 0x3FF6DFAB2AA4FBAA, 0xC00019A6D77E92CA, 0x3FC57DBFAF500276, 0xBFEE5DB765EEFB7C,
  0x3FD1178E051A5192, 0xBFFF37EBFD028BBC, 0x3FE2F01EFF38BE34, 0xBFF10BAD3D02CB26, 0x3FFE4C2A485D48E9);   # c cancelled
_r3_cmp(0, 0, 0, 0, 0, 0x3FF540DBA2859D1A, 0x3FB2BF8099FC1E00, 0x3FC056A8DC159324, 0x4844A23D58D69964,
  F64_ONE);                                                                                     # the exact offset
assert_eq(_r3_runs, 61, "the sphere's fast path against the general routine: the comparison ran");
assert_eq(_r3_drift, 0, "_geo_sphere_roots and _geo_sphere_roots_full agree word for word");
# A sphere ray handed to the general routine with c = 0 and the near root behind the origin
# underflowing: from (1, 0, 0) on the unit sphere along (2^-1074, 2^500, 0), q / a reads -0,
# which is the -2^-1074 the general routine's roots carry for it, so t is the contact +0,
# not that -0. (Pinned in the bits: the sign is the only difference.)
# [measured: C336 fixture probe (fx3) and exact Fraction/Decimal values, 3.3.5 and round 2 vs this tree, 2026-10-11]
assert_eq(geo_ray_sphere(_graw(F64_ONE, 0, 0, 1, 0x5F30000000000000, 0), geo_sphere_new(hvec3_zero(), F64_ONE)), 0,
  "geo_ray_sphere: c = 0 and q / a underflowing behind the origin: the contact +0 (bits)");
# The tiny barrel (the verifier's repro): (0,0,0)-(3,0,0), r = 2^-960, from (0.1, 2^-958, 0)
# along (0, -2^56, 2^56): an exact miss, 2 sqrt(2) r from the axis. Round 2 read the tangent
# 2^-1015 on the barrel, c and b^2 having flushed; 3.3.5 the miss.
# [measured: C336 fixture probe (fx3) and exact Fraction/Decimal values, 3.3.5 and round 2 vs this tree, 2026-10-11]
var _r3_br = alloc(16);
assert_eq(geo_ray_capsule_branch(_graw(0x3FB999999999999A, 0x0410000000000000, 0, 0, 0xC370000000000000,
      0x4370000000000000), geo_capsule_new(hvec3_zero(), hvec3_new(0x4008000000000000, 0, 0), 0x03F0000000000000),
    _r3_br), 0, "geo_ray_capsule_branch: tiny barrel missed by 2 sqrt(2) r: 0 (round 2: the tangent 2^-1015)");
assert_eq(load64(_r3_br), GEO_FACE_NONE, "... no branch");
# o_perp's exact part keeps the components across an axis-aligned w exactly: (0.33, ~2^-485,
# ~-2^-484) against (0.46, 0, 0)-(0.096, 0, 0), r ~ 2^-484, the barrel root 0.75 ulp from the
# exact 1.1535295244349881e-150 (round 2: 65 ulp, the three roundings of the cross products;
# 3.3.7's barrel 0.25 ulp, the exact root rounded; 3.4.0 solves it, 482 radii away in exponent,
# from exact coefficients, _geo_barrel_xact, whose q / N lands 0.75 ulp off, the root's other side).
# [measured: lane RT pins.py, exact roots, 3.3.6 vs this tree, 2026-10-31]
# [measured: C336 fixture probe (fx3) and exact Fraction/Decimal values, 3.3.5 and round 2 vs this tree, 2026-10-11]
assert_eq(geo_ray_capsule_branch(_graw(0x3FD55686735ECCCF, 0x21A0541AD8F34DB4, 0xA1B48642702A514D, 0xC0D986C92337B88C,
      0xC0CD6FBE5DF6EC8A, 0x40B95999C66AF470), geo_capsule_new(hvec3_new(0x3FDD9BCC169884A0, 0, 0),
      hvec3_new(0xBFB8731B5A4E8B40, 0, 0), 0x21AF428A8E6658FE), _r3_br), 0x20CE3526B1EF55E5,
  "geo_ray_capsule_branch: o_perp's exact part across an axis-aligned w: the barrel root rounded (s14 0.75 ulp)");
# A capsule tiny all through (the review's L2): (0,0,0)-(0,0,-2^-537), r = 2^-540, from just
# past the start on the axis along 2^60 z: the start cap's far side, t = 2^-599 (1 + 2^-53)
# exactly, 0.5 ulp (round 2: 2^-652, an interior point, the half-space dot product flushed).
# [measured: C336 fixture probe (fx3) and exact Fraction/Decimal values, 3.3.5 and round 2 vs this tree, 2026-10-11]
assert_eq(geo_ray_capsule_branch(_graw(0, 0, 0x9E30000000000001, 0x8000000000000000, 0x8000000000000000,
      0x43B0000000000000), geo_capsule_new(hvec3_zero(), hvec3_new(0, 0, 0x9E60000000000000), 0x1E30000000000000),
