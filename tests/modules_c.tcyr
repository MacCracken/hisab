assert_eq(geo_ray_sphere(_graw(0x4010893F256B9DCF, 0x4010C561CABBB478, 0x40013AD4D2FEA674, 0xBFE5A84D58140398,
      0xBFDD5A91B00775F6, 0xBFE26D3E75975063), geo_sphere_new(hvec3_new(0x3FF02DE3BD29868E, 0x3FF04858D7DFAC0C,
        0xBFFA04F8FCBBBA54), 0x3FF49817A5ACCB15)), 0x40140055239EE7CF,
  "geo_ray_sphere: the roadmap's ordinary ray, 1.06 ulp (3.3.5: ...E7D6, 8.06 ulp)");
assert_eq(geo_ray_sphere(_graw(0xC00AE29B14B4F4CA, 0x3FF6DFAB2AA4FBAA, 0xC00019A6D77E92CA, 0x3FC57DBFAF500276,
      0xBFEE5DB765EEFB7C, 0x3FD1178E051A5192), geo_sphere_new(hvec3_new(0xBFFF37EBFD028BBC, 0x3FE2F01EFF38BE34,
        0xBFF10BAD3D02CB26), 0x3FFE4C2A485D48E9)), 0x3ED4D1FA9A0E6F0B,
  "geo_ray_sphere: origin 1.78e-6 radii outside: the near root rounded (3.3.5: ...0000, 1.59e5 ulp)");
assert_eq(geo_ray_sphere(_graw(0xC009F146C6EB0B10, 0xBFEFD3C82190AE0F, 0x3FFC1DB16C74DA06, 0xBFA27E338B6053B2,
      0xBFEE269145B8E0F8, 0xBFD5511DE1E8A27B), geo_sphere_new(hvec3_new(0xC0046A900CF17DE2, 0xBFE5AC9C3421FE2C,
        0x3FFAEC032C4AD48C), 0x3FE87129E3AD92CA)), 0x3D8127E08D7AE2B7,
