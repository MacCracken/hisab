# === 3.4.1: SDF -- the zero-length capsule, |ab|^2 at the ends of the range, NaN in, NaN out ===
# Oracles: the closed forms (a capsule with a == b is the sphere about a; a point beside the
# axis of a capsule along x is |p.y| from it), and the Fraction oracle of lane CO's sweep
# (2,856 scenes at scales 2^-1060 to 2^1020: 1,798 wrong on the 3.4.0 base, 0 now, worst
# 2.07 ulp of max(distance, r)).
# [measured: lane CO 3.4.1 Fraction oracle (sdf_capsule rows, scales 2^-1060 to 2^1020); cycc 6.7.18]
var _c41_nan = 0x7FF8000000000000;
fn _c41_isnan(x) { return 1 - f64_eq(x, x); }
assert_eq(sdf_capsule(hvec3_new(f64_from(3), f64_from(4), 0), hvec3_zero(), hvec3_zero(), F64_ONE),
  0x4010000000000000, "sdf_capsule: a == b at the origin, p = (3, 4, 0), r = 1 -> 4, as sdf_sphere (3.4.0: NaN)");
assert_eq(sdf_capsule(hvec3_new(f64_from(3), f64_from(4), 0), hvec3_zero(), hvec3_zero(), F64_ONE),
  sdf_sphere(hvec3_new(f64_from(3), f64_from(4), 0), hvec3_zero(), F64_ONE),
  "sdf_capsule: ... the same bits as sdf_sphere");
# A point beside an x-axis capsule of length L at L/2: exactly |p.y| = h 2^k, every scale.
var _c41_L = 0x3FF3C0CA428C59FB;
var _c41_H = 0x3FE5555555555555;
fn _c41_cap(k) {
    var s1 = 0;
    var s2 = 0;
    if (k >= 0) {
        s1 = (1023 + k / 2) << 52;
        s2 = (1023 + k - k / 2) << 52;
    } else {
        s1 = (1023 - 537) << 52;
        s2 = (1023 + k + 537) << 52;
    }
    var p = hvec3_new(f64_mul(f64_mul(f64_mul(_c41_L, F64_HALF), s1), s2), f64_mul(f64_mul(_c41_H, s1), s2), 0);
    var b = hvec3_new(f64_mul(f64_mul(_c41_L, s1), s2), 0, 0);
    return sdf_capsule(p, hvec3_zero(), b, 0);
}
assert_eq(_c41_cap(512), 0x5FE5555555555555,
  "sdf_capsule: the beside-the-axis scene at 2^512 is exact (3.4.0: 24% high)");
assert_eq(_c41_cap(513), 0x5FF5555555555555, "sdf_capsule: ... at 2^513 (3.4.0: NaN)");
assert_eq(_c41_cap(1020), 0x7FA5555555555555, "sdf_capsule: ... at 2^1020 (3.4.0: NaN)");
assert_eq(_c41_cap(0 - 538), 0x1E45555555555555, "sdf_capsule: ... at 2^-538 (3.4.0: NaN)");
assert_eq(_c41_cap(0 - 1000), 0x0165555555555555, "sdf_capsule: ... at 2^-1000");
assert_eq(_c41_cap(0 - 1030), 0x00000AAAAAAAAAAB, "sdf_capsule: ... at 2^-1030, subnormal, correctly rounded");
assert_eq(_c41_cap(0), 0x3FE5555555555555, "sdf_capsule: ... at unit scale");
# A segment spanning more than DBL_MAX: -DBL_MAX to DBL_MAX along x, p = (0, 3, 0), r = 1 -> 2.
assert_eq(sdf_capsule(hvec3_new(0, f64_from(3), 0), hvec3_new(0xFFEFFFFFFFFFFFFF, 0, 0),
    hvec3_new(0x7FEFFFFFFFFFFFFF, 0, 0), F64_ONE), F64_TWO,
  "sdf_capsule: a segment from -DBL_MAX to DBL_MAX is |p.y| - r = 2 from (0, 3, 0) (3.4.0: NaN)");
# Non-finite: a finite segment and an infinite point is +Inf away; an infinite end, NaN.
assert_eq(sdf_capsule(hvec3_new(F64_POS_INF, 0, 0), hvec3_zero(), hvec3_new(0, F64_ONE, 0), F64_ONE),
  F64_POS_INF, "sdf_capsule: an infinite point is +Inf away from a finite capsule");
assert_eq(_c41_isnan(sdf_capsule(hvec3_zero(), hvec3_new(F64_POS_INF, 0, 0), hvec3_zero(), F64_ONE)), 1,
  "sdf_capsule: an infinite end has no segment: NaN");
assert_eq(_c41_isnan(sdf_capsule(hvec3_new(_c41_nan, 0, 0), hvec3_zero(), hvec3_unit_x(), F64_ONE)), 1,
  "sdf_capsule: a NaN point: NaN");
# sdf_box: a NaN point, centre or extent is NaN (3.4.0: f64_max dropped it, -0.667 "inside").
var _c41_bh = hvec3_new(0x3FF3C0CA428C59FB, 0x3FE5555555555555, 0x3FF8000000000000);
assert_eq(_c41_isnan(sdf_box(hvec3_new(_c41_nan, 0, 0), hvec3_zero(), _c41_bh)), 1,
  "sdf_box: a NaN point is NaN (3.4.0: BFE5555555555555)");
assert_eq(_c41_isnan(sdf_box(hvec3_zero(), hvec3_new(0, _c41_nan, 0), _c41_bh)), 1, "sdf_box: a NaN centre is NaN");
assert_eq(_c41_isnan(sdf_box(hvec3_zero(), hvec3_zero(), hvec3_new(F64_ONE, F64_ONE, _c41_nan))), 1,
  "sdf_box: a NaN extent is NaN");
assert_eq(sdf_box(hvec3_zero(), hvec3_zero(), _c41_bh), 0xBFE5555555555555,
  "sdf_box: control, the finite point at the centre is -min(h) inside");
# The booleans: NaN in either place.
assert_eq(_c41_isnan(sdf_union(_c41_nan, F64_ONE)), 1, "sdf_union(NaN, 1) is NaN (3.4.0: 1)");
assert_eq(_c41_isnan(sdf_union(F64_ONE, _c41_nan)), 1, "sdf_union(1, NaN) is NaN");
assert_eq(_c41_isnan(sdf_intersection(_c41_nan, F64_ONE)), 1, "sdf_intersection(NaN, 1) is NaN (3.4.0: 1)");
assert_eq(_c41_isnan(sdf_intersection(F64_ONE, _c41_nan)), 1, "sdf_intersection(1, NaN) is NaN");
assert_eq(_c41_isnan(sdf_subtraction(_c41_nan, F64_ONE)), 1, "sdf_subtraction(NaN, 1) is NaN (3.4.0: -1)");
assert_eq(_c41_isnan(sdf_subtraction(F64_ONE, _c41_nan)), 1, "sdf_subtraction(1, NaN) is NaN");
# sdf_smooth_union at k = +-0 is the hard union, the limit k -> 0+.
assert_eq(sdf_smooth_union(F64_ONE, F64_ONE, 0), F64_ONE, "sdf_smooth_union(1, 1, 0) = 1 (3.4.0: NaN)");
assert_eq(sdf_smooth_union(F64_ONE, F64_TWO, 0), F64_ONE, "sdf_smooth_union(1, 2, 0) = 1");
assert_eq(sdf_smooth_union(0x3FE3333333333333, 0x3FE6666666666666, 0x8000000000000000), 0x3FE3333333333333,
  "sdf_smooth_union(0.6, 0.7, -0) = 0.6 (3.4.0: 0.7, the maximum)");
assert_eq(sdf_smooth_union(0x3FE6666666666666, 0x3FE3333333333333, 0x8000000000000000), 0x3FE3333333333333,
  "sdf_smooth_union(0.7, 0.6, -0) = 0.6 (3.4.0: 0.7)");
assert_eq(_c41_isnan(sdf_smooth_union(_c41_nan, F64_ONE, 0)), 1, "sdf_smooth_union(NaN, 1, 0) is NaN");
assert_eq(sdf_smooth_union(F64_ONE, F64_ONE, F64_ONE), 0x3FE8000000000000,
  "sdf_smooth_union(1, 1, 1) = 1 - k/4 = 0.75, control for k > 0");

# === 3.4.1: halfedge_is_boundary -- the walk bounded by the half-edge count ===
# An open fan around vertex 0: (0,2,3), (0,1,2), then (0,k,k+1) for k = 3..N. Half-edge 0->1
# has no twin, so vertex 0 is on the boundary for every N; the walk from 0->2 takes N - 2
# steps to the free edge 0->(N+1) side (3.4.0: Ok(0) from N = 1002).
# [measured: lane CO 3.4.1 fan repro, N = 1001 / 1002 / 5000, base and this tree; cycc 6.7.18]
fn _c41_fan(n) {
    var t = vec_new();
    vec_push(t, 0); vec_push(t, 2); vec_push(t, 3);
    vec_push(t, 0); vec_push(t, 1); vec_push(t, 2);
    for (var k = 3; k <= n; k = k + 1) {
        vec_push(t, 0);
        vec_push(t, k);
        vec_push(t, k + 1);
    }
    return halfedge_from_triangles(t, vec_len(t) / 3, n + 2);
}
var _c41_f1 = _c41_fan(1002);
var _c41_ft, _c41_fv = halfedge_is_boundary(_c41_f1, 0);
assert_eq(is_ok(_c41_ft), 1, "halfedge_is_boundary: the N = 1002 fan's hub is answered");
assert_eq(_c41_fv, 1, "halfedge_is_boundary: ... boundary (3.4.0: Ok(0), interior)");
var _c41_f2 = _c41_fan(5000);
var _c41_ft2, _c41_fv2 = halfedge_is_boundary(_c41_f2, 0);
assert_eq(is_ok(_c41_ft2) == 1 && _c41_fv2 == 1, 1, "halfedge_is_boundary: the N = 5000 fan's hub is boundary");
# A closed fan: an octahedron's vertex is interior after a full loop.
var _c41_oct = vec_new();
vec_push(_c41_oct, 0); vec_push(_c41_oct, 1); vec_push(_c41_oct, 2);
vec_push(_c41_oct, 0); vec_push(_c41_oct, 2); vec_push(_c41_oct, 3);
vec_push(_c41_oct, 0); vec_push(_c41_oct, 3); vec_push(_c41_oct, 4);
vec_push(_c41_oct, 0); vec_push(_c41_oct, 4); vec_push(_c41_oct, 1);
vec_push(_c41_oct, 5); vec_push(_c41_oct, 2); vec_push(_c41_oct, 1);
vec_push(_c41_oct, 5); vec_push(_c41_oct, 3); vec_push(_c41_oct, 2);
vec_push(_c41_oct, 5); vec_push(_c41_oct, 4); vec_push(_c41_oct, 3);
vec_push(_c41_oct, 5); vec_push(_c41_oct, 1); vec_push(_c41_oct, 4);
var _c41_om = halfedge_from_triangles(_c41_oct, 8, 6);
var _c41_ot, _c41_ov = halfedge_is_boundary(_c41_om, 0);
assert_eq(is_ok(_c41_ot) == 1 && _c41_ov == 0, 1, "halfedge_is_boundary: an octahedron's vertex is interior");
# Twin links edited after the build so that the walk from vertex 0 enters a loop that never
# returns to its start: Err(HSB_ERR_INVALID_INPUT), not a guess. Vertex 0's walk is
# h -> twin(next(next(h))); pointing the incoming half-edge of the walk's SECOND outgoing
# half-edge back at that half-edge makes it its own successor.
var _c41_s0 = vec_get(HalfEdgeMesh_vertex_edge(_c41_om), 0);
var _c41_hes = HalfEdgeMesh_half_edges(_c41_om);
var _c41_n1 = HalfEdge_next(vec_get(_c41_hes, HalfEdge_next(vec_get(_c41_hes, _c41_s0))));
var _c41_h1 = HalfEdge_twin(vec_get(_c41_hes, _c41_n1));
var _c41_in1 = HalfEdge_next(vec_get(_c41_hes, HalfEdge_next(vec_get(_c41_hes, _c41_h1))));
HalfEdge_set_twin(vec_get(_c41_hes, _c41_in1), _c41_h1);
var _c41_ct, _c41_cv = halfedge_is_boundary(_c41_om, 0);
assert_eq(is_err_result(_c41_ct), 1, "halfedge_is_boundary: twin links that loop away from the start are refused");
assert_eq(_c41_cv, HSB_ERR_INVALID_INPUT, "halfedge_is_boundary: ... with HSB_ERR_INVALID_INPUT");

# === 3.4.1: sequential_impulse -- an inverse-mass sum below DBL_MIN is solved, not skipped ===
# lambda = (1 + e) pen / (ima + imb), exactly where it is representable (AU2-G5-F10).
# [measured: AU2-G5-F10 repros, the 3.4.0 base and this tree, lane CO 3.4.1; cycc 6.7.18]
var _c41_imp = alloc(16);
fn _c41_si(pen, ima, imb, mu, vt, it) {
    var cs = vec_new();
    vec_push(cs, contact_new_fric(0, 1, hvec3_unit_y(), pen, mu, 0, ima, imb, vt));
    var tg, vv = sequential_impulse(cs, 1, it, _c41_imp);
    if (is_ok(tg) == 0) { return 0 - 1; }
    return load64(_c41_imp);
}
assert_eq(_c41_si(0x0000000300000000, 0x0000000400000000, 0x0000000400000000, 0, 0, 4), 0x3FD8000000000000,
  "sequential_impulse: pen 3 u, inverse masses 4 u x 2 (subnormal) -> 3/8 (3.4.0: 0, skipped)");
assert_eq(_c41_si(0x0000000300000000, 0x0000000400000000, 0x0000000400000000, 0, 0, 1), 0x3FD8000000000000,
  "sequential_impulse: ... the same after one sweep");
assert_eq(_c41_si(0x39B0000000000000, 0x0004000000000000, 0x0004000000000000, 0, 0, 4), 0x79A0000000000000,
  "sequential_impulse: pen 2^-100, inverse masses 2^-1024 x 2 -> 2^923 (3.4.0: 0)");
assert_eq(_c41_si(0x3E70000000000000, 0x0000000400000000, 0x0000000400000000, 0, 0, 4), 0x7F60000000000000,
  "sequential_impulse: pen 2^-24 over 2^-1039 -> 2^1015");
# lambda past DBL_MAX rounds to +Inf, and the friction to -Inf, never NaN.
assert_eq(_c41_si(F64_ONE, 1, 0, F64_HALF, F64_ONE, 3), F64_POS_INF,
  "sequential_impulse: pen 1 over 2^-1074 -> lambda 2^1074, +Inf rounded, not NaN");
assert_eq(load64(_c41_imp + 8), 0xFFF0000000000000, "sequential_impulse: ... its friction -2^1074, -Inf rounded");
# Friction in impulse units: clamp(-v_t / im, +-mu lambda) with v_t = 2^-1070, im = 2^-1072 -> -4,
# inside mu lambda = 0.5 * 4.
assert_eq(_c41_si(0x0000000000000010, 0x0000000000000004, 0, F64_HALF, 0x0000000000000010, 2), 0x4010000000000000,
  "sequential_impulse: pen 2^-1070 over 2^-1072 -> 4");
assert_eq(load64(_c41_imp + 8), 0xC000000000000000, "sequential_impulse: ... friction clamped to -mu lambda = -2");
# Controls: a normal mass sum keeps its bits; zero and NaN as before.
assert_eq(_c41_si(F64_ONE, F64_ONE, 0, 0, 0, 3), F64_ONE, "sequential_impulse: control, pen 1 over 1 -> 1");
assert_eq(_c41_si(F64_ONE, 0, 0, 0, 0, 3), 0, "sequential_impulse: control, both static -> 0");
assert_eq(_c41_isnan(_c41_si(F64_ONE, _c41_nan, 0, 0, 0, 3)), 1, "sequential_impulse: control, a NaN mass -> NaN");

# === 3.4.1: cga_project / cga_reject -- no inverse, no projection ===
# x = cga_point(1, 2, 3), b a unit sphere at 19998112 (norm^2 exactly 1). 3.4.0 returned the
# projection as the zero multivector and the rejection as x itself, where the blade's exact
# projection has e1 = C46B18EDA5209F17 (Fraction, as the audit's). Re-derived in review pass
# CO3: lane CO made both NaN x 32, following cga_blade_inverse's resolution limit, which
# refused a blade that is its own inverse. Since CO3 the inverse decides from the exact
# norm², and the projection is the exact one: e1, n0, ninf = C46B18EDA5209F17,
# C2E6BBAAA6558CD0, C5E0265755D4A12F (the reviewer's Fraction projection, RV-CO S3).
# [measured: AU2-G1-F1 repro on the 3.4.0 base and this tree, lane CO 3.4.1; cycc 6.7.18]
# [measured: RV-CO cgapj.py Fraction projection; lane CO3 cgafix.py; 2026-10-31]
fn _c41_nan32(m) {
    var c = 0;
    for (var i = 0; i < 32; i = i + 1) {
        if (_c41_isnan(cga_mv_get(m, i)) == 1) { c = c + 1; }
    }
    return c;
}
var _c41_px = cga_point(F64_ONE, F64_TWO, f64_from(3));
var _c41_pb = cga_sphere(0x4173125A00000000, 0, 0, F64_ONE);
assert_eq(cga_norm_sq(_c41_pb), F64_ONE, "pinned: the fixture sphere's norm^2 is exactly 1");
assert_eq(cga_mv_get(cga_blade_inverse(_c41_pb), 4), F64_ONE,
  "cga_blade_inverse: the fixture sphere is its own inverse");
var _c41_pp = cga_project(_c41_px, _c41_pb);
assert_eq(cga_mv_get(_c41_pp, 1), 0xC46B18EDA5209F17, "cga_project onto the 19998112 sphere: exact e1 (3.4.0: 0)");
assert_eq(cga_mv_get(_c41_pp, 4), 0xC2E6BBAAA6558CD0, "cga_project: ... exact n0");
assert_eq(cga_mv_get(_c41_pp, 5), 0xC5E0265755D4A12F, "cga_project: ... exact ninf");
assert_eq(cga_mv_get(cga_reject(_c41_px, _c41_pb), 1), 0x446B18EDA5209F17,
  "cga_reject: ... x - project, e1 (3.4.0: x)");
# No inverse, no projection: onto the exactly null point (1, 2, 3) both are NaN in all 32 slots.
assert_eq(_c41_nan32(cga_project(_c41_px, _c41_px)), 32, "cga_project onto an exactly null blade: NaN x 32 (3.4.0: 0)");
assert_eq(_c41_nan32(cga_reject(_c41_px, _c41_px)), 32, "cga_reject: ... NaN x 32 (3.4.0: x)");
# Control: a sphere the inverse resolves projects as before (e1 onto a unit sphere at 1e4).
var _c41_pj = cga_project(cga_point(F64_ONE, 0, 0), cga_sphere(f64_from(10000), 0, 0, F64_ONE));
assert_eq(_c41_nan32(_c41_pj), 0, "cga_project: control, a resolvable sphere answers finitely");

# === 3.4.1: cga_norm -- the range gate reads the terms the norm^2 forms ===
# [measured: AU2-G1-F2 and F7 repros, and the translator sweep to 2^1020, lane CO 3.4.1; cycc 6.7.18]
assert_eq(cga_norm(cga_translator(0x61A0000000000000, 0, 0)), F64_ONE,
  "cga_norm(translator(2^539)) = 1, its norm^2 (3.4.0: 0)");
var _c41_rot = cga_rotor(F64_HALF, 0x3FE8000000000000, F64_ONE, 0x3FF1E3779B97F4A8);
var _c41_mo = cga_geometric_product(cga_translator(f64_mul(0x3FFBC01A36E2EB1C, (1023 + 536) << 52), 0, 0), _c41_rot);
assert_eq(cga_norm(_c41_mo), F64_ONE, "cga_norm: a motor at t = 1.7346 2^536 is a unit versor, 1 (3.4.0: 0.968)");
assert_eq(cga_norm(_c41_mo), cga_norm(_c41_rot), "cga_norm: ... the norm of its rotor, bit for bit");
var _c41_mx = cga_mv_zero();
cga_mv_set(_c41_mx, 8, F64_ONE);
cga_mv_set(_c41_mx, 10, (1023 - 600) << 52);
assert_eq(cga_norm(_c41_mx), (1023 - 600) << 52, "cga_norm(e1n0 + 2^-600 e23) = 2^-600 (3.4.0: 0)");
# Inside 3.4.0's coefficient window with a norm² below 2^-960: a full-mantissa e23 of about
# 2^-527 beside 1 e1n0 has the norm |e23|, whose square rounds on the subnormal grid.
var _c41_mz = cga_mv_zero();
cga_mv_set(_c41_mz, 8, F64_ONE);
cga_mv_set(_c41_mz, 10, 0x1F00123456789ABC);
assert_eq(cga_norm(_c41_mz), 0x1F00123456789ABC, "cga_norm(e1n0 + x e23), x ~ 2^-527 full mantissa, = |x| exactly");
var _c41_mi = cga_mv_zero();
cga_mv_set(_c41_mi, 4, F64_POS_INF);
assert_eq(cga_norm(_c41_mi), 0, "cga_norm(+Inf n0) = 0: no term forms, as for every finite multiple (3.4.0: +Inf)");
assert_eq(cga_norm_sq(_c41_mi), 0, "cga_norm_sq(+Inf n0) = 0, the value cga_norm takes the root of");
var _c41_mf = cga_mv_zero();
cga_mv_set(_c41_mf, 4, (1023 + 1000) << 52);
assert_eq(cga_norm(_c41_mf), 0, "cga_norm(2^1000 n0) = 0");
var _c41_mb = cga_mv_zero();
cga_mv_set(_c41_mb, 1, (1023 + 1023) << 52);
assert_eq(cga_norm(_c41_mb), (1023 + 1023) << 52, "cga_norm(2^1023 e1) = 2^1023, its one term 2^2046 scaled");
var _c41_ms = cga_mv_zero();
cga_mv_set(_c41_ms, 1, 1);
assert_eq(cga_norm(_c41_ms), 1, "cga_norm(2^-1074 e1) = 2^-1074, its one term 2^-2148 scaled");

# === 3.4.1: time_of_impact -- a relative speed that overflows from finite velocities ===
# Spheres r = 1 at 0 and (10, 10, 0); vel_b = (v, v, 0), v = FFE72409614C1E6A (each finite,
# the speed 1.8e308). Exact t = (sqrt(2) - 10) / v = 0027BEDC8CC94029 (Decimal, 80 digits).
# With vel_a = -vel_b the difference itself overflows: t = 0017BEDC8CC94029.
# [measured: AU2-G1-F3 repro, both forms, base and this tree, lane CO 3.4.1; cycc 6.7.18]
var _c41_ta = hvec4_new(0, 0, 0, F64_ONE);
var _c41_tb = hvec4_new(f64_from(10), f64_from(10), 0, F64_ONE);
var _c41_vb = hvec3_new(0xFFE72409614C1E6A, 0xFFE72409614C1E6A, 0);
var _c41_va = hvec3_new(0x7FE72409614C1E6A, 0x7FE72409614C1E6A, 0);
var _c41_tt = alloc(8);
var _c41_tn = alloc(8);
store64(_c41_tt, 0);
store64(_c41_tn, hvec3_zero());
assert_eq(time_of_impact(&_mpr_sup_sphere, _c41_ta, hvec3_zero(), &_mpr_sup_sphere, _c41_tb, _c41_vb, F64_ONE,
    _c41_tt, _c41_tn), 1, "time_of_impact: a speed past DBL_MAX from finite velocities is a hit (3.4.0: a miss)");
assert_eq(load64(_c41_tt), 0x0027BEDC8CC94029, "time_of_impact: ... at the exact t, 0027BEDC8CC94029");
assert_eq(HVec3_x(load64(_c41_tn)), 0x3FE6A09E667F3BCD, "time_of_impact: ... normal x = sqrt(1/2)");
assert_eq(HVec3_y(load64(_c41_tn)), 0x3FE6A09E667F3BCD, "time_of_impact: ... normal y = sqrt(1/2)");
assert_eq(time_of_impact(&_mpr_sup_sphere, _c41_ta, _c41_va, &_mpr_sup_sphere, _c41_tb, _c41_vb, F64_ONE,
    _c41_tt, _c41_tn), 1, "time_of_impact: a difference of finite velocities past DBL_MAX is a hit (3.4.0: a miss)");
assert_eq(load64(_c41_tt), 0x0017BEDC8CC94029, "time_of_impact: ... at the exact t, 0017BEDC8CC94029");
# Control: the same pair at 1/4 of v is unchanged by the halving (t four times as long).
assert_eq(time_of_impact(&_mpr_sup_sphere, _c41_ta, hvec3_zero(), &_mpr_sup_sphere, _c41_tb,
    hvec3_new(0xFFC72409614C1E6A, 0xFFC72409614C1E6A, 0), F64_ONE, _c41_tt, _c41_tn), 1,
  "time_of_impact: control, v / 4 (speed finite) is a hit");
assert_eq(load64(_c41_tt), 0x0047BEDC8CC94029, "time_of_impact: ... at 4 t");

# === 3.4.1: convex_hull_2d / triangulate_polygon -- exact orientation, finite sites only ===
# [measured: AU2-G5-F4 and F5 repros, the 3.4.0 base and this tree, lane CO 3.4.1; cycc 6.7.18]
# Fixtures found by lane CO's search against Fraction orientations (float sign != exact sign).
fn _c41_pt(v, x, y) {
    vec_push(v, hvec2_new(x, y));
    return 0;
}
fn _c41_is(v, n, a, b, c, d) {
    if (v == 0) { return 0; }
    if (vec_len(v) != n) { return 0; }
    if (n > 0 && vec_get(v, 0) != a) { return 0; }
    if (n > 1 && vec_get(v, 1) != b) { return 0; }
    if (n > 2 && vec_get(v, 2) != c) { return 0; }
    if (n > 3 && vec_get(v, 3) != d) { return 0; }
    return 1;
}
# P0 = (0.5 + 119 u, 0.5 + 150 u), (12, 12), (24, 24): exact orientation +93/2^51.
var _c41_s = vec_new();
_c41_pt(_c41_s, 0x3FE0000000000077, 0x3FE0000000000096);
_c41_pt(_c41_s, 0x4028000000000000, 0x4028000000000000);
_c41_pt(_c41_s, 0x4038000000000000, 0x4038000000000000);
assert_eq(_c41_is(convex_hull_2d(_c41_s, 3), 3, 0, 1, 2, 0), 1,
  "convex_hull_2d: the +93/2^51 sliver is the triangle [0 1 2], as delaunay_2d has it (3.4.0: [0 2])");
# An interior point the float cross product kept: P (index 1) is above AB by an exact
# -1 orientation; C = (10, 40) closes the triangle.
var _c41_i = vec_new();
_c41_pt(_c41_i, 0x3FC3476623B5F3D8, 0x3FE450C74C9B42E5);
_c41_pt(_c41_i, 0x402654E8BCF65597, 0x4020F9E6746CDBCD);
_c41_pt(_c41_i, 0x40322BDA0E83D292, 0x402AF71492000B07);
_c41_pt(_c41_i, 0x4024000000000000, 0x4044000000000000);
assert_eq(_c41_is(convex_hull_2d(_c41_i, 4), 3, 0, 2, 3, 0), 1,
  "convex_hull_2d: an interior point is not a corner, [0 2 3] (3.4.0: [0 1 2 3])");
# The same four as a counter-clockwise polygon starting at P: P is reflex, and 3.4.0 clipped
# the ear (A, P, B), outside the polygon.
var _c41_q = vec_new();
_c41_pt(_c41_q, 0x402654E8BCF65597, 0x4020F9E6746CDBCD);
_c41_pt(_c41_q, 0x40322BDA0E83D292, 0x402AF71492000B07);
_c41_pt(_c41_q, 0x4024000000000000, 0x4044000000000000);
_c41_pt(_c41_q, 0x3FC3476623B5F3D8, 0x3FE450C74C9B42E5);
var _c41_qt = triangulate_polygon(_c41_q, 4);
# 3.4.1 (lane CO4): each check reads the list only once its length is known. A short list
# ended the suite at its first out-of-range vec_get ("vec: index out of bounds", exit 1, no
# summary) instead of failing these assertions, and a 0 handle at the vec_len: under lane CO2's
# mutant M7 (ear flag inverted, 3 indices back) the CO2 tree's modules_c stopped after 5
# failures; this one reports 24 and its summary.
# [measured: lane CO4 3.4.1 mut_m7.py, M7 on the CO2 tree (s6) and on this one; cycc 6.7.18]
var _c41_qn = 0 - 1;
if (_c41_qt != 0) { _c41_qn = vec_len(_c41_qt); }
assert_eq(_c41_qn, 6, "triangulate_polygon: the polygon with a reflex P is complete");
assert_eq(_c41_qn >= 3 && vec_get(_c41_qt, 0) == 0 && vec_get(_c41_qt, 1) == 1 && vec_get(_c41_qt, 2) == 2, 1,
  "triangulate_polygon: ... its first ear is (P, B, C), not the reflex P (3.4.0: (A, P, B))");
assert_eq(_c41_qn >= 6 && vec_get(_c41_qt, 3) == 3 && vec_get(_c41_qt, 4) == 0 && vec_get(_c41_qt, 5) == 2, 1,
  "triangulate_polygon: ... then (A, P, C)");
# A clockwise sliver far from the origin whose float shoelace sum is exactly 0: the winding
# is decided exactly (in integers), so the triangle is complete (3.4.0: empty).
var _c41_w = vec_new();
_c41_pt(_c41_w, 0x40B9CE1D81496029, 0x40BDFC1539275A39);
_c41_pt(_c41_w, 0x40B9CF1D81496029, 0x40BDFD1539275A39);
_c41_pt(_c41_w, 0x40B9CECAD8C51A37, 0x40BDFCC290A31446);
assert_eq(_c41_is(triangulate_polygon(_c41_w, 3), 3, 2, 0, 1, 0), 1,
  "triangulate_polygon: a clockwise sliver whose float area is 0 is one triangle (3.4.0: none)");
# A corner of the UPPER chain the float cross product dropped: P (index 1) lies above AC by
# an exact +1 orientation, so the hull is the quadrilateral [0 3 2 1], as delaunay_2d's two
# triangles say (3.4.0: the triangle [0 3 2]).
var _c41_u = vec_new();
_c41_pt(_c41_u, 0x3FCAE248766F4A20, 0x3FC9715DDFC6F310);
_c41_pt(_c41_u, 0x401FCEE4D27A583F, 0x401AE56AA1DE9F48);
_c41_pt(_c41_u, 0x403369E053E09944, 0x4030625EFB685ECA);
_c41_pt(_c41_u, 0x40239FA4E4CD77D8, 0xC044000000000000);
assert_eq(_c41_is(convex_hull_2d(_c41_u, 4), 4, 0, 3, 2, 1), 1,
  "convex_hull_2d: an upper corner ulps above AC is kept, [0 3 2 1] (3.4.0: [0 3 2])");
# Two simple counter-clockwise polygons, each with one vertex placed a few ulps off a line
# through two others, where 3.4.0's triangulation was complete in count but not a
# triangulation: one triangle clockwise, the areas summing past the polygon's (Fraction
# check). The first needs the exact point-in-triangle test (a blocking vertex the float test
# placed outside an ear), the second the exact ring test (a reflex vertex the float test
# called convex, so it blocked nothing). The expected lists are the exact predicates' (lane
# CO's Fraction port of this function), each a valid triangulation.
fn _c41_tri_is(v, n, l) {
    if (v == 0 || vec_len(v) != n) { return 0; }
    for (var i = 0; i < n; i = i + 1) {
        if (vec_get(v, i) != load64(l + i * 8)) { return 0; }
    }
    return 1;
}
var _c41_pa = vec_new();
_c41_pt(_c41_pa, 0x401C1B329911D8B4, 0x3FF9CEBB07980859);
_c41_pt(_c41_pa, 0xBFFF330CD3082C36, 0x4011E9B61F1F1884);
_c41_pt(_c41_pa, 0xC011E5660450E4FE, 0x40133151E7E55EA6);
_c41_pt(_c41_pa, 0xC010A10309D41902, 0x4000C95C02E53B9F);
_c41_pt(_c41_pa, 0xC024A38D2834E6EE, 0x40084872D61DE355);
_c41_pt(_c41_pa, 0xC01533BE70403B7E, 0x3FDA3E143CC74649);
_c41_pt(_c41_pa, 0xC021A376125D9746, 0xC00EE60F5C7E4EFC);
var _c41_la: i64[15];
store64(&_c41_la, 0); store64(&_c41_la + 8, 1); store64(&_c41_la + 16, 2);
store64(&_c41_la + 24, 0); store64(&_c41_la + 32, 2); store64(&_c41_la + 40, 3);
store64(&_c41_la + 48, 3); store64(&_c41_la + 56, 4); store64(&_c41_la + 64, 5);
store64(&_c41_la + 72, 0); store64(&_c41_la + 80, 3); store64(&_c41_la + 88, 5);
store64(&_c41_la + 96, 6); store64(&_c41_la + 104, 0); store64(&_c41_la + 112, 5);
assert_eq(_c41_tri_is(triangulate_polygon(_c41_pa, 7), 15, &_c41_la), 1,
  "triangulate_polygon: the 7-gon is [0 1 2, 0 2 3, 3 4 5, 0 3 5, 6 0 5] (3.4.0: (1 5 6) clockwise)");
var _c41_pb = vec_new();
_c41_pt(_c41_pb, 0x402031A4F48B6301, 0x4018C5A042B928CA);
_c41_pt(_c41_pb, 0x4013841887895A4A, 0x40108680286FEE33);
_c41_pt(_c41_pb, 0x40001D93DE229631, 0x4015022052A57472);
_c41_pt(_c41_pb, 0x4006CB7F19246996, 0xC01ADD29E574FC29);
_c41_pt(_c41_pb, 0x40017C9FFEF21FA6, 0xC0248631880EFCB0);
var _c41_lb: i64[9];
store64(&_c41_lb, 1); store64(&_c41_lb + 8, 2); store64(&_c41_lb + 16, 3);
store64(&_c41_lb + 24, 0); store64(&_c41_lb + 32, 1); store64(&_c41_lb + 40, 3);
store64(&_c41_lb + 48, 4); store64(&_c41_lb + 56, 0); store64(&_c41_lb + 64, 3);
assert_eq(_c41_tri_is(triangulate_polygon(_c41_pb, 5), 9, &_c41_lb), 1,
  "triangulate_polygon: the 5-gon is [1 2 3, 0 1 3, 4 0 3] (3.4.0: (1 3 4) clockwise)");
# Non-finite sites are rejected, as delaunay_2d rejects them.
var _c41_n = vec_new();
_c41_pt(_c41_n, 0, 0);
_c41_pt(_c41_n, f64_from(4), 0);
_c41_pt(_c41_n, f64_from(4), f64_from(4));
_c41_pt(_c41_n, 0, f64_from(4));
_c41_pt(_c41_n, _c41_nan, F64_TWO);
assert_eq(vec_len(convex_hull_2d(_c41_n, 5)), 0, "convex_hull_2d: a NaN site is rejected (3.4.0: 8 indices)");
assert_eq(vec_len(convex_hull_2d(_c41_n, 4)), 4, "convex_hull_2d: control, the square without it");
var _c41_g = vec_new();
_c41_pt(_c41_g, 0, 0);
_c41_pt(_c41_g, f64_from(4), 0);
_c41_pt(_c41_g, F64_POS_INF, F64_TWO);
_c41_pt(_c41_g, f64_from(4), f64_from(4));
_c41_pt(_c41_g, 0, f64_from(4));
assert_eq(vec_len(triangulate_polygon(_c41_g, 5)), 0, "triangulate_polygon: an infinite vertex is rejected (3.4.0: 9)");
assert_eq(vec_len(convex_hull_2d(_c41_g, 5)), 0, "convex_hull_2d: an infinite site is rejected");
# The same pentagon clockwise, so that a winding read off the infinite vertex could still
# match the ears: rejected all the same.
var _c41_gr = vec_new();
for (var _c41_gi = 4; _c41_gi >= 0; _c41_gi = _c41_gi - 1) { vec_push(_c41_gr, vec_get(_c41_g, _c41_gi)); }
assert_eq(vec_len(triangulate_polygon(_c41_gr, 5)), 0,
  "triangulate_polygon: an infinite vertex, clockwise, is rejected");
# The exact paths' scratch refused (ALLOC_MAX below its size, above every other request of
# the call): the winding's integer slots (_COL_BI_NSLOT * _COL_BI_SLOT bytes) for the shoelace
# sliver, the expansion's buffer (40 doubles) for the hull's +93/2^51 sliver. The answer was 0,
# the refused allocation's, not a list built on a sign that was never computed.
# 3.4.1 (lane CO2) re-derived: the scratch is on the call's stack now, so there is nothing to
# refuse, and under the same ALLOC_MAX both calls give their slivers' own answers.
var _c41_ak = ALLOC_MAX;
ALLOC_MAX = 20000;
var _c41_tw = triangulate_polygon(_c41_w, 3);
ALLOC_MAX = 300;
var _c41_hw = convex_hull_2d(_c41_s, 3);
ALLOC_MAX = _c41_ak;
assert_eq(_c41_is(_c41_tw, 3, 2, 0, 1, 0), 1,
  "triangulate_polygon: ALLOC_MAX below the integer slots' size -> the sliver's triangle (no heap scratch)");
assert_eq(_c41_is(_c41_hw, 3, 0, 1, 2, 0), 1,
  "convex_hull_2d: ALLOC_MAX below the expansion buffer's size -> the sliver's hull (no heap scratch)");
# Their scratch belongs to the call, as delaunay_2d's does (tests/modules_b.tcyr, "scratch
# buffers"): stale pointers planted as the cached buffers, which a call that clears both on
# entry never writes, while the slivers reach the expansion and the integers. (3.4.1 lane CO2:
# the triangulation's sliver no longer reaches the integers -- the winding filter now runs on
# coordinates translated by vertex 0, where its sum is exact -- so the CO2 group below plants
# the same canaries under a square at 2^600, whose every sign is taken in integers.)
var _c41_cbi = alloc(_COL_BI_NSLOT * _COL_BI_SLOT);
var _c41_co = alloc(40 * 8);
fn _c41_canary(buf, nbytes, fill) {
    var hits = 0;
    for (var i = 0; i < nbytes; i = i + 8) {
        if (fill == 1) { store64(buf + i, 0x5A5A_5A5A_5A5A_5A5A); }
        if (load64(buf + i) != 0x5A5A_5A5A_5A5A_5A5A) { hits = hits + 1; }
    }
    return hits;
}
_c41_canary(_c41_cbi, _COL_BI_NSLOT * _COL_BI_SLOT, 1);
_c41_canary(_c41_co, 40 * 8, 1);
_COL_BI_BUF = _c41_cbi;
_COL_O2D_BUF = _c41_co;
var _c41_hc = convex_hull_2d(_c41_s, 3);
var _c41_hcb = _c41_canary(_c41_co, 40 * 8, 0);
_COL_BI_BUF = _c41_cbi;
_COL_O2D_BUF = _c41_co;
var _c41_tc = triangulate_polygon(_c41_w, 3);
var _c41_tcb = _c41_canary(_c41_cbi, _COL_BI_NSLOT * _COL_BI_SLOT, 0) + _c41_canary(_c41_co, 40 * 8, 0);
assert_eq(_c41_hcb + _c41_tcb, 0,
  "convex_hull_2d / triangulate_polygon: scratch left from an earlier call is not written");
assert_eq(_c41_is(_c41_hc, 3, 0, 1, 2, 0) + _c41_is(_c41_tc, 3, 2, 0, 1, 0), 2,
  "convex_hull_2d / triangulate_polygon: ... and the answers are the slivers' own");

# === 3.4.1: collision_mesh -- a refused vec growth is the function's refusal, not an exit ===
# The stdlib's vec_push ends the process when a growth is refused ("vec: alloc failed",
# exit 1); the hull, triangulation, Delaunay, half-edge and island builders now push with
# vec_push_a and answer through their own channels. ALLOC_MAX is lowered so that a vec's
# first growth (16 -> 32 slots, 256 B) is refused and everything before it is not.
# [measured: lane CO 3.4.1 exhaustion probe, each builder, the 3.4.0 base (exit 1) and this tree; cycc 6.7.18]
var _c41_xp = vec_new();
for (var _c41_xi = 0; _c41_xi < 20; _c41_xi = _c41_xi + 1) {
    vec_push(_c41_xp, hvec2_new(f64_from(_c41_xi * _c41_xi % 17), f64_from(_c41_xi * 7 % 13)));
}
var _c41_xr = vec_new();
for (var _c41_xj = 0; _c41_xj < 20; _c41_xj = _c41_xj + 1) {
    var _c41_xa = f64_div(f64_mul(f64_from(_c41_xj), 0x401921FB54442D18), f64_from(20));
    vec_push(_c41_xr, hvec2_new(f64_cos(_c41_xa), f64_sin(_c41_xa)));
}
var _c41_xt = vec_new();
for (var _c41_xk = 0; _c41_xk < 18; _c41_xk = _c41_xk + 1) {
    vec_push(_c41_xt, 0);
    vec_push(_c41_xt, _c41_xk + 1);
    vec_push(_c41_xt, _c41_xk + 2);
}
var _c41_keep = ALLOC_MAX;
ALLOC_MAX = 200;
var _c41_x0 = convex_hull_2d(_c41_xp, 20);
var _c41_x1 = triangulate_polygon(_c41_xr, 20);
var _c41_x2 = delaunay_2d(_c41_xp, 20);
var _c41_x4 = detect_islands(0, 0, 20);
ALLOC_MAX = 1024;
var _c41_x3 = halfedge_from_triangles(_c41_xt, 18, 200);
ALLOC_MAX = _c41_keep;
assert_eq(_c41_x0, 0, "convex_hull_2d: a refused growth answers 0 (3.4.0: exit 1)");
assert_eq(_c41_x1, 0, "triangulate_polygon: a refused growth answers 0 (3.4.0: exit 1)");
# 3.4.1 (lane CO4) re-derived: this pinned the EMPTY vec, delaunay_2d's answer for a set with
# nothing to mesh; a refusal is 0, as for the hull and the triangulation above.
assert_eq(_c41_x2, 0, "delaunay_2d: a refused growth answers 0 (3.4.0: exit 1; lane CO: the empty vec)");
assert_eq(_c41_x3, 0, "halfedge_from_triangles: a refused growth answers 0 (3.4.0: exit 1)");
assert_eq(_c41_x4 != 0 && vec_len(_c41_x4) == 0, 1,
  "detect_islands: a refused growth answers the empty vec (3.4.0: exit 1)");
# Controls: the same calls with the heap as it was.
assert_eq(vec_len(convex_hull_2d(_c41_xp, 20)) > 2, 1, "convex_hull_2d: control, the same call answers a hull");
assert_eq(vec_len(triangulate_polygon(_c41_xr, 20)), 54, "triangulate_polygon: control, 3(n - 2) indices");
assert_eq(vec_len(delaunay_2d(_c41_xp, 20)) > 0, 1, "delaunay_2d: control, a mesh");
assert_eq(halfedge_from_triangles(_c41_xt, 18, 200) != 0, 1, "halfedge_from_triangles: control, a mesh");
assert_eq(vec_len(detect_islands(0, 0, 20)), 20, "detect_islands: control, 20 singleton islands");

# === 3.4.1: collision_core / collision_mesh -- every exhaustion point answers, none exits ===
# Lane INS found delaunay_2d on the 4-point square ending the process ("vec: alloc failed",
# exit 1) at the exhaustion point k = 1824 of a sweep in 8-byte steps (the 228 below it
# answer 0 or the empty vec): a vec_push. Every builder in the two files now pushes with
# vec_push_a and answers a refused growth through its own channel, so each is swept here
# from k = 0, every 8 bytes, to its first full answer: the 3.4.0 base exits on the way for
# convex_hull_2d, triangulate_polygon, delaunay_2d, halfedge_from_triangles and
# detect_islands. The instrument is tests/abuse.tcyr's (_al_exhaust_after, lane AL), with
# lib/alloc.cyr's Linux internals; its own check follows.
# [measured: lane INS delaunay-sweep.tcyr and lane CO 3.4.1 xsweep, 3.4.0 base (exit 1) and this tree; cycc 6.7.18]
# ⛔ 3.4.1 third review -- ITS FIRST FORM COST 2 GB OF ADDRESS SPACE. A point with too little
# room mapped a fresh chunk of at least 64 KiB, and _c41_exh_end put the 256 MB grain back, so
# an ordinary allocation that missed the spent chunk mapped a fresh 256 MB one: the suite peaked
# at 2.0 GB, and under `ulimit -v` 1,000,000 KB the sweep below stopped at 2 of its 11 calls and
# the suite ended with SIGSEGV. Now each point takes its k bytes from the heap with the heap
# open, keeps the heap's own _heap_ptr / _heap_end, leaves exactly that block as the room, and
# _c41_exh_end puts every pointer it saved back (tests/abuse.tcyr's form). The suite peaks at
# 0.54 GB and passes under 600,000 KB; every one of the 18,755 points leaves the same room and
# answers the same shape as before. ⚠ The cost is resident memory, 246 MB to 386 MB: each point's
# block is fresh memory the call writes into, 347 MB of blocks over the sweep.
# [measured: modules_c binaries VmPeak, VmHWM and ulimit -v runs, merged tree s5 and this one, lane INS4; 2026-10-31]
var _c41_gk = 0;
var _c41_sk = 0;
var _c41_hp = 0;
var _c41_he = 0;
fn _c41_exh(k) {
    var blk = 0;
    if (k > 0) { blk = alloc(k); }
    _c41_gk = _linux_grain;
    _c41_sk = _LINUX_CHUNK_SMALL;
    _c41_hp = _heap_ptr;
    _c41_he = _heap_end;
    if (blk != 0) {
        _heap_ptr = blk;
        _heap_end = blk + k;
    } else {
        _heap_end = _heap_ptr;
    }
    _linux_grain = 0x4000_0000_0000_0000;
    _LINUX_CHUNK_SMALL = 0x4000_0000_0000_0000;
    return _heap_end - _heap_ptr;
}
fn _c41_exh_end() {
    var left = _heap_end - _heap_ptr;
    _heap_ptr = _c41_hp;
    _heap_end = _c41_he;
    _linux_grain = _c41_gk;
    _LINUX_CHUNK_SMALL = _c41_sk;
    return left;
}
# The grains as they stand before the instrument runs: a point's own saved copy cannot pin
# them, since a point that left them unrestored hands the next point its 2^62 to save.
var _c41_gr0 = _linux_grain;
var _c41_sm0 = _LINUX_CHUNK_SMALL;
var _c41_room = _c41_exh(64);
var _c41_e1 = alloc(64);
var _c41_e2 = alloc(8);
_c41_exh_end();
# The restore, on a room left part spent: every pointer saved is back, and the heap resumes in
# its own chunk where it left off.
_c41_exh(64);
var _c41_e4 = alloc(24);
var _c41_el = _c41_exh_end();
var _c41_rs = (_heap_ptr == _c41_hp && _heap_end == _c41_he && _linux_grain == _c41_gr0
  && _LINUX_CHUNK_SMALL == _c41_sm0 && _c41_el == 40);
var _c41_e3 = alloc(8);
assert_eq(_c41_room == 64 && _c41_e1 != 0 && _c41_e2 == 0 && _c41_e4 != 0 && _c41_rs == 1 && _c41_e3 == _c41_hp, 1,
  "exhaust instrument: 64 bytes left, a 64-byte request fits, the next is refused, the heap resumes where it left off");
var _c41_ep = vec_new();
vec_push(_c41_ep, hvec2_new(0, 0));
vec_push(_c41_ep, hvec2_new(f64_from(4), 0));
vec_push(_c41_ep, hvec2_new(0, f64_from(4)));
vec_push(_c41_ep, hvec2_new(f64_from(4), f64_from(4)));
vec_push(_c41_ep, hvec2_new(F64_ONE, F64_TWO));
var _c41_et = vec_new();
vec_push(_c41_et, 0); vec_push(_c41_et, 1); vec_push(_c41_et, 2);
vec_push(_c41_et, 1); vec_push(_c41_et, 3); vec_push(_c41_et, 2);
var _c41_em = halfedge_from_triangles(_c41_et, 2, 4);
var _c41_ec = vec_new();
vec_push(_c41_ec, contact_new(0, 1, hvec3_unit_y(), F64_ONE, 0, 0, F64_ONE, F64_ONE));
vec_push(_c41_ec, contact_new(2, 3, hvec3_unit_y(), F64_ONE, 0, 0, F64_ONE, F64_ONE));
fn _c41_ecall(w) {
    if (w == 0) { return convex_hull_2d(_c41_ep, 5); }
    if (w == 1) { return triangulate_polygon(_c41_ep, 4); }
    if (w == 2) { return delaunay_2d(_c41_ep, 4); }
    if (w == 3) { return delaunay_2d(_c41_ep, 5); }
    if (w == 4) { return halfedge_from_triangles(_c41_et, 2, 4); }
    if (w == 5) { return halfedge_adjacent_faces(_c41_em, 0); }
    if (w == 6) { return detect_islands(_c41_ec, 2, 6); }
    if (w == 7) { return contact_new_fric(0, 1, hvec3_unit_y(), F64_ONE, 0, 0, F64_ONE, F64_ONE, 0); }
    # The twenty-point sets of the group above, whose vecs grow past their first 16 slots.
    if (w == 8) { return convex_hull_2d(_c41_xp, 20); }
    if (w == 9) { return triangulate_polygon(_c41_xr, 20); }
    return delaunay_2d(_c41_xp, 20);
}
# 1 for a full answer; 0 for the refusal shape (0, or an empty vec); 2 for anything else.
# 3.4.1 (lane CO4) re-derived: the hull, triangulation and Delaunay builders answer a refusal
# with 0 alone (lanes CO2, CO4), and every input here has a nonempty answer, so for them the
# empty vec is a wrong answer (2); the half-edge query and the island builder keep it as theirs.
fn _c41_eshape(w, d) {
    if (d == 0) { return 0; }
    if (w == 4 || w == 7) { return 1; }
    if (vec_len(d) == 0) {
        if (w == 5 || w == 6) { return 0; }
        return 2;
    }
    if (w == 6 && vec_len(d) != 4) { return 2; }
    return 1;
}
var _c41_eodd = 0;
var _c41_epts = 0;
var _c41_edone = 0;
for (var _c41_ew = 0; _c41_ew < 11; _c41_ew = _c41_ew + 1) {
    var _c41_ek = 0;
    var _c41_ed = 0;
    while (_c41_ek <= 400000 && _c41_ed == 0) {
        _c41_exh(_c41_ek);
        var _c41_er = _c41_ecall(_c41_ew);
        _c41_exh_end();
        var _c41_es = _c41_eshape(_c41_ew, _c41_er);
        if (_c41_es == 2) { _c41_eodd = _c41_eodd + 1; }
        if (_c41_es == 1) { _c41_ed = 1; }
        _c41_epts = _c41_epts + 1;
        _c41_ek = _c41_ek + 8;
    }
    _c41_edone = _c41_edone + _c41_ed;
}
assert_eq(_c41_edone, 11, "collision builders: each of the 11 calls reached its full answer, no exit on the way");
assert_eq(_c41_eodd, 0, "collision builders: every exhaustion point before it answered the refusal shape");
# 3.4.1 (lane CO2) re-derived: 4,259 points, not over 12,000. The exact predicates' 29 KB of
# scratch moved to the stack, so a builder that reaches them now gets its full answer that
# much sooner in the sweep (the 11 calls and the 8-byte step are unchanged).
# [measured: lane CO2 3.4.1, this sweep's count printed on this tree; cycc 6.7.18]
assert_eq(_c41_epts > 4000, 1, "collision builders: the sweeps ran over 4,000 exhaustion points");

# === 3.4.1: EPA goes on past a falling lower bound -- deep tiny spheres at a box corner ===
# A sphere of radius r ~ 1e-7 to 1e-6 whose centre is inside a box near a corner: the depth is
# r plus the distance to the NEAREST face (exact: the face-plane distances in Fractions, the
# root in 80-digit Decimal). EPA's closest-face distance fell after a few rounds (sliver faces
# between the sphere's close supports and the box's), the expansion stopped, and the polish
# settled in another face's basin: 9.8% to 11.3% too deep, 1.6e4 to 5.9e5 eps.
# [measured: lane CO 3.4.1 deep.py (seeds 5 to 7) and its exact face-distance oracle, base and tree; cycc 6.7.18]
var _c41_k1 = _co4_mk(0, 0, 0, 0x3FF7A6CD476CE2AA, 0x3FE1440A51AAE7D0, 0x3FF5DC5A44C54CBC, 0xBFE6E24282F2F6A2,
  0xBFC0C57D7E3D2472, 0xBFE5F8B98279882D, 0xBFE36FE163465DF0, 0x3FE3486508BF9E1C, 0x3FE090754C9EC3DE,
  0x3FD6238BD4C91DE2, 0x3FE930EEF8CBC0F2, 0xBFE056163F83864E);
var _c41_k1s = hvec4_new(0x3FF33B69C053AC8E, 0x3FF982A66C83916F, 0x3FE3189663EF05AC, 0x3E8B6CF3F111E046);
assert_eq(mpr_penetration(&_co4_sup_obb, _c41_k1, &_co4_sup_sph, _c41_k1s, _co4_n, _co4_d), 1,
  "mpr_penetration: a ball of radius 2.04e-7 deep in a box corner is a contact");
assert_eq(load64(_co4_d), 0x3E95FC0566A08947,
  "mpr_penetration: ... depth 3.2759394e-7, exact 3.27593944e-7 (3.4.0: 3.6303689e-7, 10.8% deep) [CO3 order]");
assert_eq(mpr_penetration(&_co4_sup_sph, _c41_k1s, &_co4_sup_obb, _c41_k1, _co4_n, _co4_d), 1,
  "mpr_penetration: ... ball first, a contact");
assert_eq(load64(_co4_d), 0x3E95FC0566A08947, "mpr_penetration: ... ball first, depth 3.2759394e-7 (3.4.0: 3.63e-7)");
assert_eq(gjk_epa_3d(&_co4_sup_obb, _c41_k1, &_co4_sup_sph, _c41_k1s, _co4_n, _co4_d) == 1
  && load64(_co4_d) == 0x3E95FC0566A08946, 1,
  "gjk_epa_3d: control, the same pair's depth, the exact 3.27593944e-7 (CO3 order; was ...6900000)");
# Another corner (seed 6, pair 627): the second-nearest face, 11.3% deep, through 3.4.0.
# [measured: lane CO 3.4.1 deep.py seed 6 pair 627, exact oracle, 3.4.0 base and this tree; cycc 6.7.18]
var _c41_k2 = _co4_mk(0, 0, 0, 0x3FF515591A0C463C, 0x3FF24AEEB0803A62, 0x3FE09596CD528E34, 0xBFE8CDCBECC8E952,
  0xBFD7B3AB2AF8D516, 0x3FE0616C4BE81748, 0xBFE41FF849E96AB8, 0x3FD7F93DC259D194, 0xBFE5CD2FA1B20EC0,
  0x3FAF0238AFAA9304, 0xBFEB335A4A9950DC, 0xBFE0BE8A5DE3AB44);
var _c41_k2s = hvec4_new(0x3FFC5945F64CB5DB, 0xBFD85EE3CC398863, 0xBFC559523D5380F0, 0x3E81EFDB9C8C8DB1);
assert_eq(mpr_penetration(&_co4_sup_obb, _c41_k2, &_co4_sup_sph, _c41_k2s, _co4_n, _co4_d) == 1
  && load64(_co4_d) == 0x3E9103923E100000, 1,
  "mpr_penetration: a ball 1.34e-7 deep in another corner, depth 2.5352761e-7 (3.4.0: 2.82e-7; CO3 order)");
assert_eq(HVec3_x(load64(_co4_n)), 0x3FE41FF849E96AB8,
  "mpr_penetration: ... its normal the nearest face's, -u1 (x 0.629; 3.4.0: -u2, x 0.0605) [CO3 order]");
# At 1e3 (seed 5, pair 35), and from gjk_epa_3d with the ball first: 9.8% deep through 3.4.0.
# [measured: lane CO 3.4.1 deep.py seed 5 pair 35, exact oracle, 3.4.0 base and this tree; cycc 6.7.18]
var _c41_k3 = _co4_mk(0x408F47BA1BCA30CB, 0xC09F400000000000, 0x407F400000000000, 0x3FE065F4F8A736D8,
  0x3FF159C8353D090F, 0x3FF53B13A4538A54, 0x3FC531D59AFF8B30, 0xBFE17E33C8E355F6, 0x3FEA442DEC07ED6F,
  0xBFE72EBCEB29F4E4, 0xBFE43A96EF997EE6, 0xBFD197505EE7B2FA, 0x3FE56995A63F0117, 0xBFE19287D98649B6,
  0xBFE005BEDBE71742);
var _c41_k3s = hvec4_new(0x408F47DDCDF99BB5, 0xC09F4489443EA9A9, 0x407F29DEE5919765, 0x3EB3D4E8F3759665);
assert_eq(gjk_epa_3d(&_co4_sup_sph, _c41_k3s, &_co4_sup_obb, _c41_k3, _co4_n, _co4_d) == 1
  && load64(_co4_d) == 0x3EB918BF6CD391CB, 1,
  "gjk_epa_3d: a ball 1.18e-6 deep in a box corner at 1e3, ball first, depth 1.4958782e-6 (3.4.0: 1.6425e-6)");
assert_eq(mpr_penetration(&_co4_sup_obb, _c41_k3, &_co4_sup_sph, _c41_k3s, _co4_n, _co4_d) == 1
  && load64(_co4_d) == 0x3EB918BF6CD391CB, 1, "mpr_penetration: ... box first, the same depth (3.4.0: 1.6425e-6)");

# === 3.4.1 CO2: hull / triangulation / Delaunay -- the exact predicates' scratch takes no heap ===
# The first 3.4.1 draft allocated the integer and expansion scratch (28,992 + 320 B) on the heap
# in every call that reached them, and the bump allocator never frees: triangulate_polygon on the
# unit square at (1e9, 1e9) grew the heap by 29,328 B a call (3.4.0: 336), and delaunay_2d by
# 32,352 B a call even at the origin (its ghost terms reach the integers). The scratch is on the
# builder's stack now, so a call that reaches the exact paths grows the heap by exactly what the
# same call grows it by when it does not: its result and working vecs.
# [measured: lane CO2 3.4.1 heap.py, alloc_used() around 4 repeated calls, 3.4.0, the first draft and this; cycc 6.7.18]
fn _co2_sq(ox, oy, s) {
    var v = vec_new();
    vec_push(v, hvec2_new(ox, oy));
    vec_push(v, hvec2_new(f64_add(ox, s), oy));
    vec_push(v, hvec2_new(f64_add(ox, s), f64_add(oy, s)));
    vec_push(v, hvec2_new(ox, f64_add(oy, s)));
    return v;
}
var _co2_res = 0;
# Heap bytes one call takes: w 0 = triangulate_polygon, 1 = convex_hull_2d, 2 = delaunay_2d.
fn _co2_heap(w, v, n) {
    var a = alloc_used();
    if (w == 0) { _co2_res = triangulate_polygon(v, n); }
    if (w == 1) { _co2_res = convex_hull_2d(v, n); }
    if (w == 2) { _co2_res = delaunay_2d(v, n); }
    return alloc_used() - a;
}
fn _co2_list(v, n, a0, a1, a2, a3, a4, a5) {
    if (v == 0) { return 0; }
    if (vec_len(v) != n) { return 0; }
    var w: i64[6];
    store64(&w, a0); store64(&w + 8, a1); store64(&w + 16, a2);
    store64(&w + 24, a3); store64(&w + 32, a4); store64(&w + 40, a5);
    for (var i = 0; i < n && i < 6; i = i + 1) {
        if (vec_get(v, i) != load64(&w + i * 8)) { return 0; }
    }
    return 1;
}
var _co2_p600 = (1023 + 600) << 52;
var _co2_o9 = f64_from(1000000000);
var _co2_sq0 = _co2_sq(0, 0, F64_ONE);
var _co2_sq9 = _co2_sq(_co2_o9, _co2_o9, F64_ONE);
var _co2_sq6 = _co2_sq(_co2_p600, _co2_p600, _co2_p600);
var _co2_h0 = _co2_heap(0, _co2_sq0, 4);
assert_eq(_co2_list(_co2_res, 6, 3, 0, 1, 3, 1, 2), 1, "triangulate_polygon: the unit square -> [3 0 1, 3 1 2]");
var _co2_h9 = _co2_heap(0, _co2_sq9, 4);
assert_eq(_co2_list(_co2_res, 6, 3, 0, 1, 3, 1, 2), 1, "triangulate_polygon: ... at (1e9, 1e9), the same list");
var _co2_h6 = _co2_heap(0, _co2_sq6, 4);
assert_eq(_co2_list(_co2_res, 6, 3, 0, 1, 3, 1, 2), 1,
  "triangulate_polygon: ... at 2^600, where every sign is taken in integers, the same list");
var _co2_h6b = _co2_heap(0, _co2_sq6, 4);
assert_eq(_co2_h0 > 0 && _co2_h0 < 1024, 1, "triangulate_polygon: the unit square takes under 1 KB of heap");
assert_eq(_co2_h9, _co2_h0, "triangulate_polygon: at 1e9 it takes the same heap as at 0 (first draft: +28,992 B)");
assert_eq(_co2_h6, _co2_h0, "triangulate_polygon: at 2^600, through the integer paths, the same heap as at 0");
assert_eq(_co2_h6b, _co2_h6, "triangulate_polygon: a second call takes the same again -- nothing accumulates");
# A zero-area quadrilateral (an out-and-back path): its winding is an exact 0, so the integer
# shoelace always runs; the triangulation is empty (no ear) and the heap the unit square's.
var _co2_z = vec_new();
vec_push(_co2_z, hvec2_new(0, 0));
vec_push(_co2_z, hvec2_new(F64_ONE, F64_ONE));
vec_push(_co2_z, hvec2_new(F64_TWO, F64_TWO));
vec_push(_co2_z, hvec2_new(F64_ONE, F64_ONE));
var _co2_hz = _co2_heap(0, _co2_z, 4);
assert_eq(_co2_res != 0 && vec_len(_co2_res) == 0, 1, "triangulate_polygon: a zero-area quad -> no ear, the empty vec");
assert_eq(_co2_hz, _co2_h0, "triangulate_polygon: ... and the unit square's heap, though the integer shoelace ran");
# The hull: five collinear points at multiples of 2^600 (every orientation in integers) against
# five at small integers (decided by the expansion's certificate, no scratch): both give their
# two ends and take the same heap.
var _co2_cl6 = vec_new();
var _co2_cl1 = vec_new();
for (var _co2_i = 0; _co2_i < 5; _co2_i = _co2_i + 1) {
    vec_push(_co2_cl6, hvec2_new(f64_mul(f64_from(_co2_i), _co2_p600), f64_mul(f64_from(_co2_i), _co2_p600)));
    vec_push(_co2_cl1, hvec2_new(f64_from(_co2_i), f64_from(_co2_i)));
}
var _co2_hc1 = _co2_heap(1, _co2_cl1, 5);
assert_eq(_co2_list(_co2_res, 2, 0, 4, 0, 0, 0, 0), 1, "convex_hull_2d: 5 collinear points -> their ends [0 4]");
var _co2_hc6 = _co2_heap(1, _co2_cl6, 5);
assert_eq(_co2_list(_co2_res, 2, 0, 4, 0, 0, 0, 0), 1, "convex_hull_2d: ... the same at multiples of 2^600");
assert_eq(_co2_hc6, _co2_hc1, "convex_hull_2d: ... and the same heap (first draft: +28,992 B)");
# The +93/2^51 sliver of lane CO's group reaches the expansion (40 doubles of scratch): its
# hull takes the heap of a plain triangle's.
var _co2_t3 = vec_new();
vec_push(_co2_t3, hvec2_new(0, 0));
vec_push(_co2_t3, hvec2_new(F64_ONE, 0));
vec_push(_co2_t3, hvec2_new(0, F64_ONE));
var _co2_ht3 = _co2_heap(1, _co2_t3, 3);
var _co2_hs = _co2_heap(1, _c41_s, 3);
assert_eq(_co2_list(_co2_res, 3, 0, 1, 2, 0, 0, 0), 1, "convex_hull_2d: the +93/2^51 sliver -> [0 1 2]");
assert_eq(_co2_hs, _co2_ht3,
  "convex_hull_2d: ... through the expansion, the heap of a plain triangle (first draft: +320 B)");
# delaunay_2d: the square with a site on an edge reaches the expansion and the integers; two
# calls take the same heap, and less than the integer scratch alone would.
var _co2_e = _co2_sq(0, 0, f64_from(4));
vec_push(_co2_e, hvec2_new(F64_TWO, 0));
var _co2_hd1 = _co2_heap(2, _co2_e, 5);
var _co2_hd2 = _co2_heap(2, _co2_e, 5);
assert_eq(_co2_list(_co2_res, 9, 1, 2, 4, 2, 3, 4), 1,
  "delaunay_2d: the square with an edge site -> [1 2 4, 2 3 4, ...]");
assert_eq(_co2_hd1 == _co2_hd2 && _co2_hd1 < _COL_BI_NSLOT * _COL_BI_SLOT, 1,
  "delaunay_2d: two calls take the same heap, under the integer scratch's 28,992 B (3.4.0: 32,608 B a call)");
# The stack buffers are written as literals (cycc 6.6.x reads no expression in `u8[...]`):
# the integer slots' size must still be the 28,992 bytes `_col_scratch_call` declares.
# [measured: src/collision_mesh.cyr, the literal in _col_scratch_call against enum _ColBi]
assert_eq(_COL_BI_NSLOT * _COL_BI_SLOT, 28992,
  "_col_scratch_call: the integer scratch is _COL_BI_NSLOT * _COL_BI_SLOT = 28,992 bytes, its literal size");
# The pointers are the call's: clear when it returns, and a stale pair planted as the cached
# buffers is never written while the 2^600 square takes every sign in integers.
var _co2_cbi = alloc(_COL_BI_NSLOT * _COL_BI_SLOT);
var _co2_co = alloc(40 * 8);
_c41_canary(_co2_cbi, _COL_BI_NSLOT * _COL_BI_SLOT, 1);
_c41_canary(_co2_co, 40 * 8, 1);
_COL_BI_BUF = _co2_cbi;
_COL_O2D_BUF = _co2_co;
var _co2_tq = triangulate_polygon(_co2_sq6, 4);
assert_eq(_c41_canary(_co2_cbi, _COL_BI_NSLOT * _COL_BI_SLOT, 0) + _c41_canary(_co2_co, 40 * 8, 0), 0,
  "triangulate_polygon at 2^600: stale scratch pointers planted before the call are not written");
assert_eq(_COL_BI_BUF == 0 && _COL_O2D_BUF == 0 && _co2_list(_co2_tq, 6, 3, 0, 1, 3, 1, 2) == 1, 1,
  "triangulate_polygon at 2^600: ... both pointers read 0 after it, and the list is the square's");

# === 3.4.1 CO2: the winding filter runs on coordinates translated by vertex 0 ===
# The first draft filtered the raw shoelace sum, whose products the polygon's distance from the
# origin sets: the unit square at 1e9 never cleared it and every call took the integers. On
# x_i - x_0, y_i - y_0 the square's sum is exact. White-box: with the integer scratch made
# unallocatable, the filter must decide alone (the flag stays 0).
# [measured: lane CO2 3.4.1 shoe2.py seeds 1-7 (Fraction oracle and a replica of the filter); cycc 6.7.18]
fn _co2_wsign(v, n) {
    _COL_BI_BUF = 0;
    _COL_DL_NOMEM = 0;
    var keep = ALLOC_MAX;
    ALLOC_MAX = 64;
    var sg = _col_poly_area_sign(v, n);
    ALLOC_MAX = keep;
    var f = _COL_DL_NOMEM;
    _COL_DL_NOMEM = 0;
    return sg * 10 + f;
}
assert_eq(_co2_wsign(_co2_sq9, 4), 10,
  "_col_poly_area_sign: the unit square at 1e9 -> +1 from the filter, no integers");
var _co2_sq9r = vec_new();
for (var _co2_j = 3; _co2_j >= 0; _co2_j = _co2_j - 1) { vec_push(_co2_sq9r, vec_get(_co2_sq9, _co2_j)); }
assert_eq(_co2_wsign(_co2_sq9r, 4), 0 - 10, "_col_poly_area_sign: ... clockwise -> -1 from the filter");
# The translation ROUNDS (x_0 has a full mantissa, x_i ~ 1e9), so the bound must carry it: on
# this near-collinear triangle the translated float sum is NEGATIVE (|sum| 0.05 of the bound)
# while the exact area is positive. The filter defers and the integers give +1; a bound that
# ignored the rounding would answer -1 and lose the triangle (wrong winding: no ear).
# [measured: lane CO2 3.4.1 search, Fraction oracle and a replica of the filter, 400,000 triangles; cycc 6.7.18]
var _co2_w = vec_new();
vec_push(_co2_w, hvec2_new(0x3FE9BF2BE12539F5, 0x3FC5711EAFBB10EA));
vec_push(_co2_w, hvec2_new(0x41D26D767B49FACF, 0x41D73279C01777D1));
vec_push(_co2_w, hvec2_new(0x41DF82F057DB8CB4, 0x41E3D57202F9D57A));
assert_eq(_col_poly_area_sign(_co2_w, 3), 1,
  "_col_poly_area_sign: a triangle whose translated float sum is < 0 -> +1 (exact)");
_COL_BI_BUF = 0;
assert_eq(_co2_list(triangulate_polygon(_co2_w, 3), 3, 2, 0, 1, 0, 0, 0), 1,
  "triangulate_polygon: ... its ear [2 0 1]");
# The translated loop reads vertices 0 and 1 before it and the rest inside it; a NaN or an
# infinity at each of the three places is still a rejected polygon (-2, the empty vec).
fn _co2_bad(k, x) {
    var v = _co2_sq(0, 0, F64_ONE);
    vec_set(v, k, hvec2_new(x, F64_ONE));
    return _col_poly_area_sign(v, 4);
}
var _co2_nan = 0x7FF8000000000000;
assert_eq(_co2_bad(0, _co2_nan) + _co2_bad(1, F64_POS_INF) + _co2_bad(2, _co2_nan) + _co2_bad(3, F64_POS_INF), 0 - 8,
  "_col_poly_area_sign: a NaN or infinite vertex 0, 1, 2 or 3 -> -2 each");
var _co2_by = _co2_sq(0, 0, F64_ONE);
vec_set(_co2_by, 0, hvec2_new(0, _co2_nan));
var _co2_b1 = _co2_sq(0, 0, F64_ONE);
vec_set(_co2_b1, 1, hvec2_new(F64_ONE, F64_POS_INF));
var _co2_b2 = _co2_sq(0, 0, F64_ONE);
vec_set(_co2_b2, 2, hvec2_new(F64_ONE, _co2_nan));
assert_eq(_col_poly_area_sign(_co2_by, 4) + _col_poly_area_sign(_co2_b1, 4) + _col_poly_area_sign(_co2_b2, 4), 0 - 6,
  "_col_poly_area_sign: ... and in y, at vertex 0, 1 and 2");
assert_eq(vec_len(triangulate_polygon(_co2_by, 4)), 0, "triangulate_polygon: a NaN y at vertex 0 -> rejected");

# === 3.4.1 CO2: triangulate_polygon -- the ear's convexity is its blocker flag; the bounding-box reject ===
# Both change no decision (6,300 adversarial polygons and 9,900 ordinary sets gave the same lists),
# so the proof is a polygon where each one decides: the notch (0,0) (4,0) (4,4) (2,1) (0,4),
# whose reflex vertex 3 lies inside the first two candidate ears' triangles (and inside their
# bounding boxes), so ears 0 and 1 must be refused and ear 2 taken first.
# [measured: lane CO2 3.4.1 ht_run2.py seeds 1-7, ht_ord2.py seeds 1-3, exact mirror; cycc 6.7.18]
var _co2_n = vec_new();
vec_push(_co2_n, hvec2_new(0, 0));
vec_push(_co2_n, hvec2_new(f64_from(4), 0));
vec_push(_co2_n, hvec2_new(f64_from(4), f64_from(4)));
vec_push(_co2_n, hvec2_new(F64_TWO, F64_ONE));
vec_push(_co2_n, hvec2_new(0, f64_from(4)));
var _co2_nt = triangulate_polygon(_co2_n, 5);
assert_eq(_co2_list(_co2_nt, 9, 1, 2, 3, 0, 1, 3), 1,
  "triangulate_polygon: the notch -> [1 2 3, 0 1 3, ...] (exact mirror)");
assert_eq(vec_len(_co2_nt) == 9 && vec_get(_co2_nt, 6) * 100 + vec_get(_co2_nt, 7) * 10 + vec_get(_co2_nt, 8) == 403, 1,
  "triangulate_polygon: ... and [4 0 3] last");

# === 3.4.1 CO2: convex_hull_2d -- points that coincide are one corner; a refusal is 0 ===
# Through 3.4.0 (and the first draft) a set whose points all coincide came back as 2 indices of
# one point -- 2, 3, 5 or 6 copies alike -- because the chain ends at the first and last point
# of the sort, which coincide only then. The hull of one point is that point: one index, the
# first in the sort (index 1 for these, as the heap orders equal keys).
# [measured: lane RV-CO 3.4.1 review S4 probe and lane CO2 fixture probe, 3.4.0 and this tree; cycc 6.7.18]
fn _co2_same(k) {
    var v = vec_new();
    for (var i = 0; i < k; i = i + 1) { vec_push(v, hvec2_new(F64_ONE, F64_TWO)); }
    return v;
}
assert_eq(_co2_list(convex_hull_2d(_co2_same(2), 2), 1, 1, 0, 0, 0, 0, 0), 1,
  "convex_hull_2d: 2 coincident points -> [1]");
assert_eq(_co2_list(convex_hull_2d(_co2_same(3), 3), 1, 1, 0, 0, 0, 0, 0), 1,
  "convex_hull_2d: 3 coincident points -> [1]");
assert_eq(_co2_list(convex_hull_2d(_co2_same(5), 5), 1, 1, 0, 0, 0, 0, 0), 1,
  "convex_hull_2d: 5 coincident points -> [1]");
# Coincident means equal coordinates, signed zeros included: (0, 0) and (0, -0).
var _co2_zz = vec_new();
vec_push(_co2_zz, hvec2_new(0, 0));
vec_push(_co2_zz, hvec2_new(0, 0x8000000000000000));
assert_eq(_co2_list(convex_hull_2d(_co2_zz, 2), 1, 1, 0, 0, 0, 0, 0), 1,
  "convex_hull_2d: (0, 0) and (0, -0) -> one index");
# Controls: a duplicated end and three copies of a corner keep the true corners, once each.
var _co2_m1 = vec_new();
vec_push(_co2_m1, hvec2_new(F64_ONE, F64_TWO));
vec_push(_co2_m1, hvec2_new(F64_ONE, F64_TWO));
vec_push(_co2_m1, hvec2_new(f64_from(3), F64_TWO));
assert_eq(_co2_list(convex_hull_2d(_co2_m1, 3), 2, 1, 2, 0, 0, 0, 0), 1,
  "convex_hull_2d: A, A, B -> [1 2], the two ends");
var _co2_vp = vec_new();
vec_push(_co2_vp, hvec2_new(F64_ONE, F64_TWO));
vec_push(_co2_vp, hvec2_new(F64_ONE, f64_from(5)));
assert_eq(vec_len(convex_hull_2d(_co2_vp, 2)), 2, "convex_hull_2d: (1, 2), (1, 5) -> both: equal x is not coincident");
var _co2_m2 = vec_new();
vec_push(_co2_m2, hvec2_new(0, 0));
vec_push(_co2_m2, hvec2_new(0, 0));
vec_push(_co2_m2, hvec2_new(0, 0));
vec_push(_co2_m2, hvec2_new(f64_from(4), 0));
vec_push(_co2_m2, hvec2_new(0, f64_from(4)));
assert_eq(_co2_list(convex_hull_2d(_co2_m2, 5), 3, 0, 3, 4, 0, 0, 0), 1,
  "convex_hull_2d: O x3, (4,0), (0,4) -> [0 3 4]");
# A refused allocation is 0, never the empty vec (which is the answer for n <= 0 and for a
# rejected site): swept every 8 bytes from 0 to the first full answer with lane CO's exhaust
# instrument, the hull of 5 and of 20 points and the triangulations of the 20-gon and of the
# notch never answer the empty vec. Through the first draft the sort's and the chain's vecs
# returned it (38 of 570 exhaustion points on a 200-point hull), and the triangulation's ring
# and blocker cache did too.
# [measured: lane RV-CO 3.4.1 exh.py, and this sweep on the first draft and this tree; cycc 6.7.18]
fn _co2_ecall(w) {
    if (w == 0) { return convex_hull_2d(_c41_ep, 5); }
    if (w == 1) { return convex_hull_2d(_c41_xp, 20); }
    if (w == 2) { return triangulate_polygon(_c41_xr, 20); }
    return triangulate_polygon(_co2_n, 5);
}
var _co2_eempty = 0;
var _co2_edone = 0;
var _co2_epts = 0;
for (var _co2_ew = 0; _co2_ew < 4; _co2_ew = _co2_ew + 1) {
    var _co2_ek = 0;
    var _co2_ed = 0;
    while (_co2_ek <= 100000 && _co2_ed == 0) {
        _c41_exh(_co2_ek);
        var _co2_er = _co2_ecall(_co2_ew);
        _c41_exh_end();
        if (_co2_er != 0) {
            if (vec_len(_co2_er) == 0) { _co2_eempty = _co2_eempty + 1; } else { _co2_ed = 1; }
        }
        _co2_epts = _co2_epts + 1;
        _co2_ek = _co2_ek + 8;
    }
    _co2_edone = _co2_edone + _co2_ed;
}
assert_eq(_co2_edone, 4, "hull / triangulation exhaustion: each of the 4 calls reached its full answer");
assert_eq(_co2_eempty, 0, "hull / triangulation exhaustion: no point answered the empty vec -- a refusal is 0");
assert_eq(_co2_epts > 300, 1, "hull / triangulation exhaustion: the sweeps ran over 300 points");

# === 3.4.1 CO2: sequential_impulse -- overflow, an overflowing mass sum and a pen below 2^-969 ===
# Expected values from the exact closed form n = max(0, (1 + e) pen / (ima + imb)), f = clamp(
# -v_t / (ima + imb), +-mu n), rounded once (Fractions), each fixture chosen so the solver's own
# roundings are exact. 3.4.0 and the first draft: NaN, +Inf or 0 where noted.
# [measured: lane CO2 3.4.1 si2.py (Fraction oracle), 3.4.0, the first draft and this tree; cycc 6.7.18]
var _co2_imp = alloc(16);
fn _co2_si(pen, ima, imb, mu, e, vt, it) {
    var cs = vec_new();
    vec_push(cs, contact_new_fric(0, 1, hvec3_unit_y(), pen, mu, e, ima, imb, vt));
    var tg, vv = sequential_impulse(cs, 1, it, _co2_imp);
    if (is_ok(tg) == 0) { return 0 - 1; }
    return load64(_co2_imp);
}
fn _co2_p2(k) { return (1023 + k) << 52; }
# An impulse past DBL_MAX: pen 2^1000 over 2^-100 -> 2^1100, +Inf at every sweep count.
assert_eq(_co2_si(_co2_p2(1000), _co2_p2(-100), 0, F64_HALF, 0, F64_ONE, 1), F64_POS_INF,
  "sequential_impulse: pen 2^1000 over 2^-100 -> +Inf after one sweep");
assert_eq(load64(_co2_imp + 8), 0xC630000000000000,
  "sequential_impulse: ... friction -2^100, inside the infinite cone");
assert_eq(_co2_si(_co2_p2(1000), _co2_p2(-100), 0, F64_HALF, 0, F64_ONE, 2), F64_POS_INF,
  "sequential_impulse: ... +Inf after two sweeps (3.4.0: NaN)");
assert_eq(_co2_si(_co2_p2(1000), _co2_p2(-100), 0, F64_HALF, 0, F64_ONE, 5), F64_POS_INF,
  "sequential_impulse: ... +Inf after five (3.4.0: NaN)");
# (1 + e) pen past DBL_MAX, the impulse not: pen 1.5 2^1023, e 1, inverse mass 4 -> 1.5 2^1022.
assert_eq(_co2_si(0x7FE8000000000000, f64_from(4), 0, F64_HALF, F64_ONE, _co2_p2(1020), 1), 0x7FD8000000000000,
  "sequential_impulse: pen 1.5 2^1023, e 1, over 4 -> 1.5 2^1022 after one sweep (3.4.0: +Inf)");
assert_eq(load64(_co2_imp + 8), 0xFF90000000000000, "sequential_impulse: ... friction -2^1018, under the cone");
assert_eq(_co2_si(0x7FE8000000000000, f64_from(4), 0, F64_HALF, F64_ONE, _co2_p2(1020), 2), 0x7FD8000000000000,
  "sequential_impulse: ... the same after two: the second sweep's -Inf is re-solved, not clamped to 0 (3.4.0: NaN)");
assert_eq(_co2_si(0x7FE8000000000000, f64_from(4), 0, F64_HALF, F64_ONE, _co2_p2(1020), 3), 0x7FD8000000000000,
  "sequential_impulse: ... the same after three (3.4.0: NaN)");
# Inverse masses whose sum overflows: 2^1023 + 2^1023, pen 1 -> 2^-1024 (subnormal), friction
# clamped to mu n = 2^-1025.
assert_eq(_co2_si(F64_ONE, _co2_p2(1023), _co2_p2(1023), F64_HALF, 0, _co2_p2(1000), 1), 0x0004000000000000,
  "sequential_impulse: inverse masses 2^1023 x 2, pen 1 -> 2^-1024 (3.4.0: NaN)");
assert_eq(load64(_co2_imp + 8), 0x8002000000000000, "sequential_impulse: ... friction -2^-1025, the cone");
assert_eq(_co2_si(F64_ONE, _co2_p2(1023), _co2_p2(1023), F64_HALF, 0, _co2_p2(1000), 4), 0x0004000000000000,
  "sequential_impulse: ... the same after four sweeps");
# n past DBL_MAX with a cone that is not: pen 2^1000 over 2^-30 (n 2^1030, +Inf), mu 2^-30, so
# mu n = 2^1000, and v_t 2^980 slides past it: f = -2^1000, not the unclamped -2^1010.
assert_eq(_co2_si(_co2_p2(1000), _co2_p2(-30), 0, _co2_p2(-30), 0, _co2_p2(980), 1), F64_POS_INF,
  "sequential_impulse: pen 2^1000 over 2^-30 -> +Inf");
assert_eq(load64(_co2_imp + 8), 0xFE70000000000000,
  "sequential_impulse: ... friction clamped to mu n = -2^1000 from the exact n (3.4.0: -2^1010, unclamped)");
# A cone and a friction both past DBL_MAX with n finite: pen 2^1000 over 2^-10 (n 2^1010), mu
# 2^20, v_t 2^1020 -> f -Inf; the second sweep made Inf - Inf = NaN of the kept -Inf.
assert_eq(_co2_si(_co2_p2(1000), _co2_p2(-10), 0, _co2_p2(20), 0, _co2_p2(1020), 3), 0x7F10000000000000,
  "sequential_impulse: pen 2^1000 over 2^-10 -> 2^1010");
assert_eq(load64(_co2_imp + 8), 0xFFF0000000000000,
  "sequential_impulse: ... friction -Inf after three sweeps (3.4.0: NaN)");
# A pen below 2^-969 with a restitution: 3 2^-1074, e 1/2, over 2^-1000 -> 4.5 2^-74 exactly;
# the sweep's e pen rounded 1.5 2^-1074 to 2 2^-1074 and answered 5 2^-74, 11% high. A
# caller whose length and inverse-mass units are both 2^-1000 times these meets it.
# [measured: lane CO2 3.4.1 Python replica of 3.4.0's sweep and the Fraction closed form; cycc 6.7.18]
assert_eq(_co2_si(3, _co2_p2(-1000), 0, 0, F64_HALF, 0, 1), 0x3B72000000000000,
  "sequential_impulse: pen 3 2^-1074, e 1/2, over 2^-1000 -> 4.5 2^-74 (3.4.0: 5 2^-74)");
assert_eq(_co2_si(3, _co2_p2(-1000), 0, 0, F64_HALF, 0, 4), 0x3B72000000000000,
  "sequential_impulse: ... the same after four sweeps");
assert_eq(_co2_si(0x8000000000000003, _co2_p2(-1000), 0, 0, F64_HALF, 0, 2), 0,
  "sequential_impulse: ... -3 2^-1074 (separating) -> +0");
assert_eq(_co2_si(0x8000000000000003, _co2_p2(1000), 0, 0, F64_HALF, 0, 1), 0,
  "sequential_impulse: ... over 2^1000, where the negative quotient underflows to -0 -> +0, as the sweep gives");
# A subnormal impulse from the closed form is rounded ONCE, to the sweep's own value: pen
# 0x000904D881A2A1ED over 1.37 (e 0) -> 0x000690FB8725DA2F, where rounding the scaled
# quotient and then scaling it into the subnormal range gives ...2E.
# [measured: lane CO2 3.4.1 double-rounding search, Fraction oracle, 2,000,000 draws; cycc 6.7.18]
assert_eq(_co2_si(0x000904D881A2A1ED, 0x3FF5F9E541460020, 0, 0, 0, 0, 1), 0x000690FB8725DA2F,
  "sequential_impulse: a subnormal impulse from the closed form, correctly rounded (once)");
# The doc block's sweep-count sentence: an ordinary contact whose bits move between 1 and 4
# sweeps -- by an ulp, toward the exact value here (0x3F9B4C9B89557BE0).
assert_eq(_co2_si(0x3FB072D8F43E40BF, 0x400DD78E12BBBB9B, 0, 0, 0x3FE1871F66D93390, 0, 1), 0x3F9B4C9B89557BDF,
  "sequential_impulse: an ordinary contact after one sweep, 1 ulp under the exact impulse");
assert_eq(_co2_si(0x3FB072D8F43E40BF, 0x400DD78E12BBBB9B, 0, 0, 0x3FE1871F66D93390, 0, 4), 0x3F9B4C9B89557BE0,
  "sequential_impulse: ... after four, the exact impulse: the count moves bits, not the value");

# ================================================================
# 3.4.1 LIE2: review repairs of lane LIE (color, lie, lie_ext, tensor, spatial)
# ================================================================
# Oracles: exact Fraction (tone map, minkowski_interval), 80-digit mpmath (so3_log), brute
# force (the symbols' permutation signs, the spatial structures' answers), and exact i64
# arithmetic (minkowski_interval on integer vectors, below; that group rewritten by lane LIE3).
# [measured: LIE2 lane oracle scripts, 2026-10-31; cycc 6.7.18]

fn _l2_nan(x) {
    if (f64_eq(x, x) == 0) { return 1; }
    return 0;
}
fn _l2_v4(t, x, y, z) {
    var v = alloc(32);
    store64(v, t); store64(v + 8, x); store64(v + 16, y); store64(v + 24, z);
    return v;
}
fn _l2_mk(t, x, y, z) { return minkowski_interval(_l2_v4(t, x, y, z)); }
# A 64-bit LCG at sp; returns the next state.
fn _l2_next(sp) {
    var s = load64(sp) * 6364136223846793005 + 1442695040888963407;
    store64(sp, s);
    return s;
}
# A signed integer in (-2^b, 2^b) from the LCG.
fn _l2_int(sp, b) {
    var s = _l2_next(sp);
    var m = (s >> 20) & ((1 << b) - 1);
    if (((s >> 10) & 1) == 1) { return 0 - m; }
    return m;
}

# === 3.4.1 LIE2: tonemap_reinhard_extended ===
test_group("3.4.1 LIE2: tonemap_reinhard_extended is t + (x / w)(t / w), under 6 ulps (review RV-LIE M1)");
# Oracle: Fraction x (w^2 + x) / (w^2 (1 + x)), correctly rounded. The first 3.4.1 form,
# t + ((t / w) x) / w, underflowed (t / w) x where the x^2 / w^2 term was the whole answer.
# Full-range sweep, 200,000 inputs with x >= 0 (subnormal to 1.8e308, results near DBL_MIN
# and DBL_MAX): at most 2.63 ulps, none past 4 where 3.4.0 was within 4 (3.4.0 itself:
# 79,204 past 4 ulps, 78,046 of them a wrong +Inf or NaN).
# [measured: LIE2 lane Fraction sweep rh2.py seed 101, this tree and 3.4.0, 2026-10-31; cycc 6.7.18]
assert_eq(HVec3_x(tonemap_reinhard_extended(0x0EE077FD8C5EDF18, 0, 0, 0x244980288CB7AD0E)), 0x151AB16A44BF858F,
  "reinhard_ext(5.06e-237, white 7.02e-134): oracle ...858E, 1 ulp (first 3.4.1 form: x, 1e30x low)");
assert_eq(HVec3_x(tonemap_reinhard_extended(0x01A56E1FC2F8F359, 0, 0, 0x16687E92154EF7AC)), 0x16687E92154EF7AC,
  "reinhard_ext(1e-300, white 1e-200) = 1e-200, oracle ...AD, 1 ulp (first 3.4.1 form 1e-300; 3.4.0 +Inf)");
assert_eq(HVec3_x(tonemap_reinhard_extended(0x3DDB7CDFD9D7BDBB, 0, 0, 0x1EB67E9C127B6E74)), 0x7E37E43C87F632B5,
  "reinhard_ext(1e-10, white 1e-160) = 1e300, oracle-exact (3.4.0 +Inf: white^2 underflowed)");
assert_eq(HVec3_x(tonemap_reinhard_extended(f64_from(3), 0, 0, F64_TWO)), 0x3FF5000000000000,
  "reinhard_ext(3, white 2) = 21/16 exactly");
assert_eq(HVec3_x(tonemap_reinhard_extended(f64_from(3), 0, 0, f64_neg(F64_TWO))), 0x3FF5000000000000,
  "reinhard_ext(3, white -2) = 21/16: only white^2 matters");
assert_eq(HVec3_x(tonemap_reinhard_extended(F64_TWO, 0, 0, 0)), 0x7FF0000000000000,
  "reinhard_ext(2, white 0) = +Inf, the limit as white -> 0 (the doc said NaN)");
assert_eq(HVec3_x(tonemap_reinhard_extended(F64_TWO, 0, 0, 0x8000000000000000)), 0x7FF0000000000000,
  "reinhard_ext(2, white -0) = +Inf");
assert_eq(_l2_nan(HVec3_x(tonemap_reinhard_extended(0, 0, 0, 0))), 1, "reinhard_ext(0, white 0) = NaN (0 / 0)");
assert_eq(HVec3_x(tonemap_reinhard_extended(f64_from(3), 0, 0, 0x7FF0000000000000)), 0x3FE8000000000000,
  "reinhard_ext(3, white +Inf) = 3/4, Reinhard's map");
assert_eq(_l2_nan(HVec3_x(tonemap_reinhard_extended(0x7FF0000000000000, 0, 0, F64_ONE))), 1,
  "reinhard_ext(+Inf, white 1) = NaN (Inf / Inf), as documented");

# === 3.4.1 LIE2: so3_log ===
test_group("3.4.1 LIE2: so3_log past a quarter turn, the symmetric column normalised twice (review RV-LIE S1, N1)");
# Oracle: 80-digit log of the stored matrix's polar factor. Just past a quarter turn about
# (1, 2, 3): oracle-exact in all three slots (the first 3.4.1 form one ulp low in each).
# [measured: LIE2 lane so3 pin probe, 80-digit mpmath, 2026-10-31; cycc 6.7.18]
var _l2_rq = so3_log(so3_from_axis_angle(hvec3_new(F64_ONE, F64_TWO, f64_from(3)), 0x3FF921FB54442D19));
assert_eq(HVec3_x(_l2_rq), 0x3FDADE373FC29D7A, "so3_log just past a quarter turn: x oracle-exact (first form ...79)");
assert_eq(HVec3_y(_l2_rq), 0x3FEADE373FC29D7A, "so3_log just past a quarter turn: y oracle-exact (first form ...79)");
assert_eq(HVec3_z(_l2_rq), 0x3FF426A96FD1F61B, "so3_log just past a quarter turn: z oracle-exact (first form ...1A)");
var _l2_mi = m3_identity();
m3_set(_l2_mi, 0, 0, f64_neg(F64_ONE)); m3_set(_l2_mi, 1, 1, f64_neg(F64_ONE)); m3_set(_l2_mi, 2, 2, f64_neg(F64_ONE));
var _l2_lmi = so3_log(_l2_mi);
assert_eq(_l2_nan(HVec3_x(_l2_lmi)) + _l2_nan(HVec3_y(_l2_lmi)) + _l2_nan(HVec3_z(_l2_lmi)), 3,
  "so3_log(-I), det -1, no rotation: NaN in every slot (3.4.0: (0, 0, pi))");
# diag(1e300, -1e300, -1e300): its polar factor is the half turn diag(1, -1, -1), log (pi, 0, 0).
# |v| = 1e300 overflows the plain norm; the scaled one keeps the axis.
var _l2_mb = m3_identity();
m3_set(_l2_mb, 0, 0, 0x7E37E43C8800759C); m3_set(_l2_mb, 1, 1, 0xFE37E43C8800759C);
m3_set(_l2_mb, 2, 2, 0xFE37E43C8800759C);
var _l2_lmb = so3_log(_l2_mb);
assert_eq(HVec3_x(_l2_lmb), F64_PI, "so3_log(diag(1e300, -1e300, -1e300)) = (pi, 0, 0): x");
assert_eq(HVec3_y(_l2_lmb) | HVec3_z(_l2_lmb), 0, "so3_log(diag(1e300, -1e300, -1e300)): y, z are +0");

# === 3.4.1 LIE2: tensor symbols ===
test_group("3.4.1 LIE2: levi_civita_3 takes levi_civita_4's rule, minkowski keeps 3.4.0's (review RV-LIE S2)");
# Brute force: the sign of an arrangement of distinct integers is prod_{a < b} sgn(v_b - v_a),
# a formula independent of the inversion count the code takes; a repeated index gives 0.
# Appending the maximum keeps a parity, so levi_civita_4(i, j, k, 9) must agree for i, j, k
# below 9. [measured: LIE2 lane brute-force permutation parity, 4,096 + 6,561 cases, 2026-10-31]
var _l2_lcbad = 0;
var _l2_lcrun = 0;
for (var i = 0 - 3; i <= 5; i = i + 1) {
    for (var j = 0 - 3; j <= 5; j = j + 1) {
        for (var k = 0 - 3; k <= 5; k = k + 1) {
            var want = 0;
            if (i != j && j != k && i != k) {
                var sg = 1;
                if (j < i) { sg = 0 - sg; }
                if (k < i) { sg = 0 - sg; }
                if (k < j) { sg = 0 - sg; }
                want = F64_ONE;
                if (sg < 0) { want = f64_neg(F64_ONE); }
            }
            if (levi_civita_3(i, j, k) != want) { _l2_lcbad = _l2_lcbad + 1; }
            if (levi_civita_4(i, j, k, 9) != want) { _l2_lcbad = _l2_lcbad + 100; }
            _l2_lcrun = _l2_lcrun + 1;
        }
    }
}
assert_eq(_l2_lcrun, 729, "the levi_civita_3 sweep ran 9^3 triples");
assert_eq(_l2_lcbad, 0, "levi_civita_3 = the permutation sign on [-3, 5]^3, and levi_civita_4(i, j, k, 9) agrees");
var _l2_imin = 0 - 9223372036854775807 - 1;
assert_eq(levi_civita_3(_l2_imin, 0, 9223372036854775807), F64_ONE, "levi_civita_3(i64 min, 0, i64 max): sorted, +1");
assert_eq(levi_civita_3(9223372036854775807, 0, _l2_imin), f64_neg(F64_ONE),
  "levi_civita_3(i64 max, 0, i64 min): three inversions, -1");
assert_eq(levi_civita_3(0, 1, 3), F64_ONE, "levi_civita_3(0, 1, 3) = +1 (3.4.0: -1.0, the wrong sign)");
var _l2_mkbad = 0;
for (var i = 0 - 4; i <= 6; i = i + 1) {
    for (var j = 0 - 4; j <= 6; j = j + 1) {
        var want = 0;
        if (i == j) {
            want = f64_neg(F64_ONE);
            if (i == 0) { want = F64_ONE; }
        }
        if (minkowski(i, j) != want) { _l2_mkbad = _l2_mkbad + 1; }
    }
}
assert_eq(_l2_mkbad, 0, "minkowski on [-4, 6]^2 = 3.4.0's rule (0 off the diagonal, +1 at (0, 0), -1 elsewhere on it)");
assert_eq(minkowski(9, 9), f64_neg(F64_ONE), "minkowski(9, 9) = -1, 3.4.0's value, documented");

# === 3.4.1 LIE2: se3_log ===
test_group("3.4.1 LIE2: se3_log is principal -- |omega| <= pi, -q for w < 0, the sign at pi (review RV-LIE S3)");
fn _l2_se3(w, x, y, z) { return se3_new(_su2_alloc(w, x, y, z), hvec3_new(F64_ONE, F64_TWO, f64_from(3))); }
# Exactly pi (w = +0 or -0): nothing is negated, omega = pi (x, y, z) / |(x, y, z)|.
var _l2_p1 = se3_log(_l2_se3(0x8000000000000000, 0xBFE3333333333333, 0x3FE999999999999A, 0));
assert_eq(load64(_l2_p1), 0xBFFE28C731EB6950, "se3_log at pi, w = -0: omega x = -0.6 pi");
assert_eq(load64(_l2_p1 + 8), 0x40041B2F769CF0E0, "se3_log at pi, w = -0: omega y = 0.8 pi");
var _l2_p2 = se3_log(_l2_se3(0, 0xBFE3333333333333, 0x3FE999999999999A, 0));
assert_eq(load64(_l2_p2), 0xBFFE28C731EB6950, "se3_log at pi, w = +0: the same omega");
var _l2_p3 = se3_log(_l2_se3(0, 0x3FE3333333333333, 0xBFE999999999999A, 0));
assert_eq(load64(_l2_p3 + 8), 0xC0041B2F769CF0E0, "se3_log at pi, the opposite element: omega y = -0.8 pi");
# w < 0: logged as -q, so the round trip is -q, the same rigid motion.
var _l2_rt = load64(se3_exp(se3_log(_l2_se3(0xBFE0000000000000, F64_HALF, 0xBFE0000000000000, F64_HALF))));
assert_eq(_su2_w(_l2_rt), 0x3FE0000000000001, "se3_exp(se3_log((-1/2, 1/2, -1/2, 1/2))): w = +1/2 (+1 ulp), -q");
assert_eq(_su2_x(_l2_rt), 0xBFE0000000000000, "... x = -1/2: -q (3.4.0 returned q)");
# 200 elements with w <= 0 (unit quaternions from the LCG): |omega| <= pi + 3 ulps and the
# round trip is -q to 2^-50.
var _l2_sd: i64[1];
store64(&_l2_sd, 2718281);
var _l2_qbad = 0;
for (var i = 0; i < 200; i = i + 1) {
    var a = f64_from(_l2_int(&_l2_sd, 30)); var b = f64_from(_l2_int(&_l2_sd, 30));
    var c = f64_from(_l2_int(&_l2_sd, 30)); var d = f64_from(_l2_int(&_l2_sd, 30));
    var nq = f64_sqrt(f64_add(f64_add(f64_mul(a, a), f64_mul(b, b)), f64_add(f64_mul(c, c), f64_mul(d, d))));
    var qw = f64_neg(f64_abs(f64_div(a, nq)));
    var qx = f64_div(b, nq); var qy = f64_div(c, nq); var qz = f64_div(d, nq);
    var tw = se3_log(_l2_se3(qw, qx, qy, qz));
    if (f64_le(lie_norm3(load64(tw), load64(tw + 8), load64(tw + 16)), 0x400921FB54442D1B) == 0) {
        _l2_qbad = _l2_qbad + 1;
    }
    var q2 = load64(se3_exp(tw));
    if (f64_le(f64_abs(f64_add(_su2_w(q2), qw)), 0x3CD0000000000000) == 0) { _l2_qbad = _l2_qbad + 1; }
    if (f64_le(f64_abs(f64_add(_su2_x(q2), qx)), 0x3CD0000000000000) == 0) { _l2_qbad = _l2_qbad + 1; }
}
assert_eq(_l2_qbad, 0, "se3_log, 200 elements with w <= 0: |omega| <= pi + 3 ulps, exp(log) = -q to 2^-50");
assert_eq(_l2_nan(load64(se3_log(_l2_se3(0x7FF8000000000000, 0, 0, 0)))), 1, "se3_log of a NaN element: omega NaN");

# === 3.4.1 LIE2: spatial structures at VEC_CAP_MAX ===
test_group("3.4.1 LIE2: spatial structures refuse a growth past VEC_CAP_MAX, never exit (review RV-LIE S4, S5)");
# vec_push_a returns -1 for a refused allocation but ENDS THE PROCESS when a full vec's doubling
# would pass VEC_CAP_MAX. VEC_CAP_MAX is lowered here (16, and 20, which is no power of two)
# around each call, and put back before anything is asserted. Through the first 3.4.1 form
# spatial_hash_insert and quadtree_insert exited 1 here, and kdtree_build at a cap of 20.
# [measured: review RV-LIE S5 repro (cap.cyr, cap2.cyr) on 3.4.1-dev, LIE2 lane 2026-10-31]
var _l2_capk = VEC_CAP_MAX;
var _l2_rc: i64[10];
VEC_CAP_MAX = 16;
var _l2_sh = spatial_hash_new(F64_ONE);
for (var i = 0; i < 10; i = i + 1) {
    store64(&_l2_rc + i * 8, spatial_hash_insert(_l2_sh, hvec3_new(f64_from(i), 0, 0), i));
}
VEC_CAP_MAX = _l2_capk;
var _l2_shbad = 0;
for (var i = 0; i < 10; i = i + 1) {
    var want = 0;
    if (i >= 3) { want = HSB_ERR_ALLOC; }
    if (load64(&_l2_rc + i * 8) != want) { _l2_shbad = _l2_shbad + 1; }
}
assert_eq(_l2_shbad, 0, "spatial_hash_insert at VEC_CAP_MAX 16: three stored (15 slots), then -11 each (was exit 1)");
assert_eq(vec_len(spatial_hash_query_radius(_l2_sh, hvec3_zero(), 0x7FF0000000000000)), 3,
  "... the hash holds exactly the three stored points");
VEC_CAP_MAX = 16;
var _l2_qt = quadtree_new(0, 0, f64_from(10), f64_from(10), 0);
var _l2_qok = 0;
var _l2_qerr = 0;
for (var i = 0; i < 10; i = i + 1) {
    var t, v = quadtree_insert(_l2_qt, f64_from(i), F64_ONE, i);
    if (is_ok(t) == 1) { _l2_qok = _l2_qok + 1; } elif (v == HSB_ERR_ALLOC) { _l2_qerr = _l2_qerr + 1; }
}
var _l2_ot = octree_new(hvec3_zero(), hvec3_splat(f64_from(10)), 0);
var _l2_ook = 0;
var _l2_oerr = 0;
for (var i = 0; i < 10; i = i + 1) {
    var t, v = octree_insert(_l2_ot, hvec3_new(f64_from(i), F64_ONE, F64_ONE), i);
    if (is_ok(t) == 1) { _l2_ook = _l2_ook + 1; } elif (v == HSB_ERR_ALLOC) { _l2_oerr = _l2_oerr + 1; }
}
VEC_CAP_MAX = _l2_capk;
assert_eq(_l2_qok * 100 + _l2_qerr, 505,
  "quadtree_insert at VEC_CAP_MAX 16, one leaf: 5 Ok, then 5 Err(ALLOC) (was exit 1)");
assert_eq(vec_len(quadtree_query(_l2_qt, 0, 0, f64_from(10), f64_from(10))), 5, "... the quadtree holds the 5");
assert_eq(load64(_l2_qt + 16), 5, "... and its count is 5");
assert_eq(_l2_ook * 100 + _l2_oerr, 802, "octree_insert at VEC_CAP_MAX 16, one leaf: 8 Ok, then 2 Err(ALLOC)");
assert_eq(vec_len(octree_query(_l2_ot, hvec3_zero(), hvec3_splat(f64_from(10)))), 8, "... the octree holds the 8");
# A cap that is no power of two: the vec's 16 -> 32 doubling passes 20.
var _l2_kp = alloc(8 * 20);
for (var i = 0; i < 20; i = i + 1) { store64(_l2_kp + i * 8, hvec3_new(f64_from(i), f64_from(i % 3), 0)); }
VEC_CAP_MAX = 20;
var _l2_k18 = kdtree_build(_l2_kp, 18);
var _l2_k16 = kdtree_build(_l2_kp, 16);
var _l2_sh20 = spatial_hash_new(F64_ONE);
var _l2_s20: i64[5];
for (var i = 0; i < 5; i = i + 1) {
    store64(&_l2_s20 + i * 8, spatial_hash_insert(_l2_sh20, hvec3_new(f64_from(i), 0, 0), i));
}
VEC_CAP_MAX = _l2_capk;
assert_eq(_l2_k18, 0, "kdtree_build of 18 at VEC_CAP_MAX 20: 0, its index list cannot grow (was exit 1)");
assert_eq(kdtree_nearest(_l2_k16, _l2_kp, hvec3_new(f64_from(7), F64_ONE, 0)), 7,
  "... 16 points fit: a tree that answers");
assert_eq(load64(&_l2_s20 + 16) * 10 + load64(&_l2_s20 + 24), 0 - 11,
  "spatial_hash_insert at VEC_CAP_MAX 20: the third stored, the fourth -11 (was exit 1)");
# Queries whose answer would pass the cap: 0, no vec; within it, the full answer.
var _l2_kt20 = kdtree_build(_l2_kp, 20);
var _l2_sq = spatial_hash_new(f64_from(100));
var _l2_q20 = quadtree_new(0, 0, f64_from(20), f64_from(20), 8);
var _l2_o20 = octree_new(hvec3_zero(), hvec3_splat(f64_from(20)), 8);
for (var i = 0; i < 20; i = i + 1) {
    spatial_hash_insert(_l2_sq, hvec3_new(f64_from(i), 0, 0), i);
    var a_t, a_v = quadtree_insert(_l2_q20, f64_from(i), F64_ONE, i);
    var b_t, b_v = octree_insert(_l2_o20, hvec3_new(f64_from(i), F64_ONE, F64_ONE), i);
}
var _l2_qr: i64[16];
VEC_CAP_MAX = 16;
store64(&_l2_qr, kdtree_within_radius(_l2_kt20, _l2_kp, hvec3_zero(), f64_from(100)));
store64(&_l2_qr + 8, kdtree_within_radius(_l2_kt20, _l2_kp, hvec3_zero(), f64_from(10)));
store64(&_l2_qr + 16, quadtree_query(_l2_q20, 0, 0, f64_from(20), f64_from(20)));
store64(&_l2_qr + 24, quadtree_query(_l2_q20, 0, 0, f64_add(F64_HALF, f64_from(9)), f64_from(20)));
store64(&_l2_qr + 32, octree_query(_l2_o20, hvec3_zero(), hvec3_splat(f64_from(20))));
store64(&_l2_qr + 40, octree_query(_l2_o20, hvec3_zero(), hvec3_new(f64_from(9), f64_from(20), f64_from(20))));
store64(&_l2_qr + 48, spatial_hash_query_cell(_l2_sq, hvec3_zero()));
store64(&_l2_qr + 56, spatial_hash_query_radius(_l2_sq, hvec3_zero(), F64_ONE));
store64(&_l2_qr + 64, spatial_hash_query_radius(_l2_sq, hvec3_zero(), 0x7FF0000000000000));
store64(&_l2_qr + 72, spatial_hash_query_radius(_l2_sq, hvec3_zero(), 0x46293E5939A08CEA));
VEC_CAP_MAX = _l2_capk;
assert_eq(load64(&_l2_qr), 0, "kdtree_within_radius, 20 hits at VEC_CAP_MAX 16: 0, no vec (was exit 1)");
assert_eq(vec_len(load64(&_l2_qr + 8)), 10, "... radius 10, 10 hits: the full answer");
assert_eq(load64(&_l2_qr + 16), 0, "quadtree_query, 20 hits at VEC_CAP_MAX 16: 0");
assert_eq(vec_len(load64(&_l2_qr + 24)), 10, "... 10 hits: the full answer");
assert_eq(load64(&_l2_qr + 32), 0, "octree_query, 20 hits at VEC_CAP_MAX 16: 0");
assert_eq(vec_len(load64(&_l2_qr + 40)), 10, "... 10 hits: the full answer");
assert_eq(load64(&_l2_qr + 48), 0, "spatial_hash_query_cell, 20 in the cell at VEC_CAP_MAX 16: 0");
assert_eq(load64(&_l2_qr + 56), 0, "spatial_hash_query_radius, the cell walk: 0");
assert_eq(load64(&_l2_qr + 64), 0, "spatial_hash_query_radius, radius +Inf: 0");
assert_eq(load64(&_l2_qr + 72), 0, "spatial_hash_query_radius, radius 1e30 (the flat scan): 0");
assert_eq(vec_len(spatial_hash_query_radius(_l2_sq, hvec3_zero(), 0x46293E5939A08CEA)), 20,
  "... and with the cap back, the flat scan's full 20");
# Exhaustion sweep over caps 16 .. 128, powers of two and not: 40 inserts into a spatial hash
# and one-leaf quadtree and octree. Stored = min(40, floor(C / slots per point)), C the
# largest 16 * 2^j <= cap (so each of a record's pushes meets the boundary at some cap);
# every refusal is -11; every stored point, and only those, is found.
var _l2_xbad = 0;
var _l2_xruns = 0;
var _l2_caps: i64[11];
store64(&_l2_caps, 16); store64(&_l2_caps + 8, 17); store64(&_l2_caps + 16, 20); store64(&_l2_caps + 24, 24);
store64(&_l2_caps + 32, 31); store64(&_l2_caps + 40, 32); store64(&_l2_caps + 48, 33); store64(&_l2_caps + 56, 48);
store64(&_l2_caps + 64, 63); store64(&_l2_caps + 72, 64); store64(&_l2_caps + 80, 128);
for (var ci = 0; ci < 11; ci = ci + 1) {
    var cap = load64(&_l2_caps + ci * 8);
    var cc = 16;
    while (cc * 2 <= cap) { cc = cc * 2; }
    var xsh = spatial_hash_new(F64_ONE);
    var xqt = quadtree_new(0, 0, f64_from(40), f64_from(40), 0);
    var xot = octree_new(hvec3_zero(), hvec3_splat(f64_from(40)), 0);
    var nsh = 0; var nqt = 0; var not = 0; var oddrc = 0;
    VEC_CAP_MAX = cap;
    for (var i = 0; i < 40; i = i + 1) {
        var rc = spatial_hash_insert(xsh, hvec3_new(f64_from(i), 0, 0), i);
        if (rc == 0) { nsh = nsh + 1; } elif (rc != HSB_ERR_ALLOC) { oddrc = oddrc + 1; }
        var t1, v1 = quadtree_insert(xqt, f64_from(i), F64_ONE, i);
        if (is_ok(t1) == 1) { nqt = nqt + 1; } elif (v1 != HSB_ERR_ALLOC) { oddrc = oddrc + 1; }
        var t2, v2 = octree_insert(xot, hvec3_new(f64_from(i), F64_ONE, F64_ONE), i);
        if (is_ok(t2) == 1) { not = not + 1; } elif (v2 != HSB_ERR_ALLOC) { oddrc = oddrc + 1; }
    }
    VEC_CAP_MAX = _l2_capk;
    _l2_xruns = _l2_xruns + 1;
    if (oddrc != 0) { _l2_xbad = _l2_xbad + 1; }
    var wsh = cc / 5; var wqt = cc / 3; var wot = cc / 2;
    if (wsh > 40) { wsh = 40; }
    if (wqt > 40) { wqt = 40; }
    if (wot > 40) { wot = 40; }
    if (nsh != wsh || nqt != wqt || not != wot) { _l2_xbad = _l2_xbad + 10; }
    if (vec_len(spatial_hash_query_radius(xsh, hvec3_zero(), 0x7FF0000000000000)) != nsh) { _l2_xbad = _l2_xbad + 100; }
    if (vec_len(quadtree_query(xqt, 0, 0, f64_from(40), f64_from(40))) != nqt) { _l2_xbad = _l2_xbad + 1000; }
    if (vec_len(octree_query(xot, hvec3_zero(), hvec3_splat(f64_from(40)))) != not) { _l2_xbad = _l2_xbad + 10000; }
}
assert_eq(_l2_xruns, 11, "the cap sweep ran 11 caps");
assert_eq(_l2_xbad, 0, "cap sweep 16 .. 128: min(40, C / slots) stored, every refusal -11, every stored point found");

# === 3.4.1 LIE2: minkowski_interval ===
test_group("3.4.1 LIE3: minkowski_interval: the sign exact, within 2^-50 (review RV-LIE S6, decided contract)");
# The contract (lane LIE3): the sign is exact -- +0 exactly when the interval is exactly 0,
# never +-0 otherwise (below half the smallest subnormal: +-2^-1074) -- an interval in the
# normal range comes back within 2^-50 of the exact value, a subnormal one within one step.
# Lane LIE2's correctly rounded form needs every square's exact low part on every vector,
# about 10x 3.4.0's cost; it was measured and not adopted. Oracle: Fraction t^2 - x^2 - y^2
# - z^2. Each pin names the path that answers it: the plain formula (3.4.0's bits), level 1,
# level 2, an exact zero, or the exact sum. 1,060,168 vectors swept: 0 outside the contract.
# [measured: LIE3 lane Fraction oracle and path-instrumented copy (orc.py, pins.py), 2026-10-31; cycc 6.7.18]
assert_eq(_l2_mk(0xBFC3540158BC8735, 0xBFF4D5154E6D6241, 0x3FD25B33D521C173, 0xBFF719F91F1C9F28), 0xC00EB71822B4C331,
  "minkowski, a Gaussian 4-vector off the cone: the plain formula, 3.4.0's bits (1.2 u; rounded: ...330)");
assert_eq(_l2_mk(f64_from(5), f64_from(3), F64_ONE, F64_HALF), 0x402D800000000000, "minkowski(5, 3, 1, 0.5) = 14.75");
# Level 1 (the cancellation factor (a + 3 s) / |r| at 7 or more: 13.2 and 14.8 here). 3.4.0's
# plain value is 9.86 u and 11.37 u off, past 2^-50: a looser filter (14 for 7, or s for 3 s)
# takes it.
# [measured: LIE3 lane ksearch.py (Fraction errors of the plain formula), 2026-10-31]
assert_eq(_l2_mk(0x3FFD3E4C05B25B60, 0xBFE67C0CE489BD36, 0xC00050D98ADE5BAD, 0x3FA28DA45DF33968), 0xBFF5060294A67FCE,
  "minkowski, level 1: 0.73 u (3.4.0 ...FD4, 9.86 u: past the bound)");
assert_eq(_l2_mk(0xBFF714CA5EB1E4D3, 0x3FC8AA93AFD43E8D, 0xBFF8DF3655FF9898, 0xBFE26F10E68B950A), 0xBFE68A837FB01984,
  "minkowski, level 1: 0.01 u (3.4.0 ...98C, 11.37 u: past the bound)");
# At the filter's edge ((a + 3 s) / |r| between 7 and 8): level 1, 0.37 u; the plain value (a filter
# taking 8 for 7) is 4.64 u, within the bound but not what the contract's proof covers.
# [measured: LIE3 lane mutant run zzm_F1b.cyr against the Fraction oracle, 2026-10-31]
assert_eq(_l2_mk(0x3FF78AFCF7BBF3CD, 0x3FB0DF289788229F, 0xBFF096E73CE00E18, 0xBFE12C54D265EDB7), 0x3FE986F55D0E125E,
  "minkowski at the filter's edge, level 1: 0.37 u (plain 3FE986F55D0E1262, 4.64 u)");
# Far off the cone near 2^511, where a + 3 s overflows the filter's test: level 1, whose r = a - s
# has a rounding error (dr != 0) that it keeps.
# [measured: LIE3 lane l1e search (path-instrumented copy), 2026-10-31]
assert_eq(_l2_mk(0x5FD2C13E3736073F, 0x5FE288590A0F41B5, 0x5FC220A0B330AB80, 0), 0xFFD140F289797ED0,
  "minkowski near 2^511, the filter's sum overflowing: level 1 keeps dr (0.03 u)");
assert_eq(_l2_mk(0x40140000431BDE83, f64_from(3), f64_from(4), 0), 0x3EE4F8B5AC1F3303,
  "minkowski(5.000001, 3, 4, 0), level 1: 0.73 u (3.4.0: 3EE4F8B5AC200000)");
assert_eq(_l2_mk(0x431555555555555C, 0x4315555555555550, 0, 0), 0x4340000000000000,
  "minkowski, t^2 - x^2 = 2^53 + 1 exactly, level 1: 2^53");
assert_eq(_l2_mk(0x5C1555555555555C, 0, 0x5C15555555555550, 0), 0x7540000000000000,
  "minkowski, the same times 2^800, level 1: 2^853");
# Within the bound, not correctly rounded: -(2^53 + 1) - 2^-1000 rounds to -(2^53 + 2); level 1
# answers -2^53, 1 u away.
assert_eq(_l2_mk(0x4315555555555550, 0x431555555555555C, 0x20B0000000000000, 0), 0xC340000000000000,
  "minkowski = -(2^53 + 1) - 2^-1000, level 1: -2^53 (1 u; the rounding is -(2^53 + 2))");
# Level 2 (photons a rounding off the cone). 3.4.0 answered 0 -- lightlike -- for the first four.
assert_eq(_l2_mk(0x3FDD9CB526190711, 0x3FDD9CB3E39A2EE8, 0x3F41466FC5520B29, 0x3E44EB6A850052EB), 0xBC329E1399950E38,
  "minkowski near the cone, level 2: correctly rounded here (3.4.0: 0)");
assert_eq(_l2_mk(0x40836821F816A810, 0x405DD16564129DC4, 0x4070F879DBBCD906, 0x40810D017B225944), 0xBDB8140B68453045,
  "minkowski, a photon one rounding off the cone, level 2 (3.4.0: 0)");
assert_eq(_l2_mk(F64_ONE, F64_ONE, 0x3E10000000000000, 0), 0xBC30000000000000,
  "minkowski(1, 1, 2^-30, 0) = -2^-60, level 2: r = 0 does not make it lightlike (3.4.0: 0)");
assert_eq(_l2_mk(0x4014000000000001, 0x4008000000000001, 0x4010000000000001, 0), 0xBCD0000000000001,
  "minkowski(5 + ulp, 3 + ulp, 4 + ulp, 0), level 2 (3.4.0: 0)");
assert_eq(_l2_mk(0x40879009CF24E3E5, 0xC0851C60E9BD2EF0, 0xC0569FC33819A054, 0x407427165BC816C1), 0x3DD658861B14160A,
  "minkowski, a photon whose interval is a tie, level 2 (3.4.0: 3DE0...)");
assert_eq(_l2_mk(0xDF26720B244B4EF1, 0xDE99A3D17795C800, 0xDF2672077B0BB418, 0x8000000000000000), 0xFB282CCF188C4F38,
  "minkowski at 2^-269 scale, level 2 (3.4.0: FB28000000000000)");
# Deeper cancellation, |R| = 2^-161 (a + s): level 2 cannot decide, the exact sum does (3.4.0: 0).
assert_eq(_l2_mk(0xC22B1531EF6779E9, 0xC0997EAE0D8F6F9A, 0x3EF0672D910FD340, 0xC22B1531EF6779E6), 0xBA66591DFA520000,
  "minkowski, |R| = 2^-161 (a + s): the exact sum (3.4.0: 0)");
# Slots past 2^511, whose squares overflow: the exact sum. (5, 3, 4, 1) 2^510 = -2^1020 (3.4.0: NaN).
assert_eq(_l2_mk(0x5FF4000000000000, 0x5FE8000000000000, 0x5FF0000000000000, 0x5FD0000000000000), 0xFFB0000000000000,
  "minkowski((5, 3, 4, 1) 2^510) = -2^1020 (3.4.0: NaN)");
# A photon two roundings off the cone: level 1 cannot certify it (a level 1 taking 2^-60 (a + s)
# for 2^-50 would answer ...944, 1.87 u); level 2 gives 0.11 u.
assert_eq(_l2_mk(0x40419883D61186DD, 0xC02CB1599D284119, 0x4028770F9CB35E45, 0x403DB7134C7D9BF5), 0xBD6229977F621943,
  "minkowski, a photon two roundings off, level 2: 0.11 u (3.4.0: BD68000000000000)");
# Exact zeros: +0.
assert_eq(_l2_mk(f64_from(5), f64_from(3), f64_from(4), 0), 0, "minkowski(5, 3, 4, 0) = +0, every term 0");
assert_eq(_l2_mk(0x3FB999999999999A, 0, 0x3FB999999999999A, 0), 0, "minkowski(0.1, 0, 0.1, 0) = +0, level 2's zero");
# The exact sum: rounded to nearest, ties to even, on the double grid (the subnormal one
# included) -- but a nonzero interval never rounds to 0.
assert_eq(_l2_mk(0x20A97BD194BFC3EC, 0x20A18B32043CC82E, 0x20A24C70F49789E1, 0xA074DAF890122EDA), 0x800000000029409B,
  "minkowski at 2^-500, a subnormal interval on its grid (3.4.0: 8000000000400000)");
assert_eq(_l2_mk(0x20AAE40CC6381CB1, 0x20A11D6541019CF6, 0x20A4B04001D07D42, 0x2067A7C82DFE5548), 0x80000000000F1EEB,
  "minkowski at 2^-500, another subnormal interval (3.4.0: 0)");
assert_eq(_l2_mk(0, 0x1E50000000000000, 0x1E50000000000000, 0), 0x8000000000000001,
  "minkowski = -2^-1075: -2^-1074, never -0 (the rounding is -0; 3.4.0: +0)");
assert_eq(_l2_mk(0x1E58000000000000, 0x1E40000000000000, 0, 0), 1, "minkowski = +2^-1075: 2^-1074, never +0");
assert_eq(_l2_mk(0, 0x1E60000000000000, 0x1E50000000000000, 0x1E50000000000000), 0x8000000000000002,
  "minkowski = -3 2^-1075, a tie: -2^-1073, the even neighbour (3.4.0: -2^-1074)");
assert_eq(_l2_mk(0x1E64000000000000, 0x1E40000000000000, 0, 0), 2, "minkowski = +3 2^-1075, a tie: 2^-1073");
assert_eq(_l2_mk(0, 0x1A70000000000000, 0, 0), 0x8000000000000001, "minkowski(0, 2^-600, 0, 0) = -2^-1074 (3.4.0: +0)");
# Subnormal ties and near-ties on the exact sum's grid: (11, 9) 2^-539 = 2.5 steps -> 2 (even);
# (7, 2, 2) 2^-539 = 2.5625 steps -> 3 (the sticky bit in the round bit's limb); (11 (1 + 2^-49),
# 9) 2^-539 = 2.5 + 2^-45 steps -> 3 (the sticky bits limbs below).
assert_eq(_l2_mk(0x1E76000000000000, 0x1E72000000000000, 0, 0), 2, "minkowski = 2.5 2^-1074, a tie: 2^-1073 (even)");
assert_eq(_l2_mk(0x1E6C000000000000, 0x1E50000000000000, 0x1E50000000000000, 0), 3,
  "minkowski = 2.5625 2^-1074: 3 2^-1074");
assert_eq(_l2_mk(0x1E7600000000000B, 0x1E72000000000000, 0, 0), 3, "minkowski = (2.5 + 2^-45) 2^-1074: 3 2^-1074");
assert_eq(_l2_mk(F64_ONE, F64_ONE, 0x1A70000000000000, 0), 0x8000000000000001,
  "minkowski(1, 1, 2^-600, 0) = -2^-1074: the exact zeros of 1 - 1 do not hide -2^-1200");
assert_eq(_l2_mk(0, 0x1E50000000000000, 0x1E50000000000000, 0x1A70000000000000), 0x8000000000000001,
  "minkowski = -(2^-1075 + 2^-1200): -2^-1074");
# t = 2^-512 against three spatial slots whose squares (0.49 of a subnormal step each) round to
# 0: the plain value 2^-1024 is 1.47 steps from the interval. A filter without its 2^-1019 term
# (or level 1 without its own) takes it; the exact sum gives (2^50 - 1) 2^-1074.
var _l3_x07 = f64_mul(0x3FE6666666666666, 0x1E60000000000000);   # 0.7 2^-537
assert_eq(_l2_mk(0x1FF0000000000000, _l3_x07, _l3_x07, _l3_x07), 0x0003FFFFFFFFFFFF,
  "minkowski(2^-512, three slots squaring under half a step) = (2^50 - 1) 2^-1074 (3.4.0: 2^-1024)");
assert_eq(_l2_mk(0x6570000000000000, 0x6570000000000000, 0x20B0000000000000, 0), 0x8170000000000000,
  "minkowski(2^600, 2^600, 2^-500, 0) = -2^-1000: the larger squares cancel, the small slot answers");
assert_eq(_l2_mk(0x4008000000000000, 0x4008000000000000, 0x20B0000000000000, 0x2150000000000000), 0x82B0000100000000,
  "minkowski(3, 3, 2^-500, 2^-490) = -(2^-1000 + 2^-980), exactly");
assert_eq(_l2_mk(0x5FF0000000000000, 0x5E40000000000000, 0, 0), 0x7FF0000000000000,
  "minkowski(2^512, 2^485) = 2^1024 - 2^970, the overflow tie: +Inf");
assert_eq(_l2_mk(0x5FF0000000000000, 0x5E50000000000000, 0, 0), 0x7FEFFFFFFFFFFFFE,
  "minkowski(2^512, 2^486) = 2^1024 - 2^972, finite (3.4.0: +Inf)");
# Non-finite slots: the extended-real value. 3.4.0 gave NaN for the first two (2^600 squared overflows).
assert_eq(_l2_mk(0x7FF0000000000000, 0x6570000000000000, 0, 0), 0x7FF0000000000000,
  "minkowski(+Inf, 2^600, 0, 0) = +Inf");
assert_eq(_l2_mk(0x6570000000000000, 0, 0xFFF0000000000000, 0), 0xFFF0000000000000,
  "minkowski(2^600, 0, -Inf, 0) = -Inf");
assert_eq(_l2_nan(_l2_mk(0x7FF0000000000000, 0, 0, 0xFFF0000000000000)), 1, "minkowski(+Inf, 0, 0, -Inf) = NaN");
assert_eq(_l2_nan(_l2_mk(0x7FF8000000000000, F64_ONE, 0, 0)), 1, "minkowski(NaN, 1, 0, 0) = NaN");
# Five vectors of mixed magnitudes near the cone (lane LIE2's level-1 search): level 1 answers
# each within 1 u (0.76, 0.70, 0.97, 0.97, 0.56 u), one ulp from the rounding.
var _l2_l1bad = 0;
if (_l2_mk(0x3F61DEDD635CF9C2, 0x3F61DEDD635D0332, 0x3DC8D3E26EBFCCC8, 0xBD39690B6A50B790) != 0xBC55175195ACEED8) {
    _l2_l1bad = _l2_l1bad + 1;
}
if (_l2_mk(0x3F1FF9DD03014EA1, 0x3E018057D4685CB8, 0xBD865129C67E9812, 0x3F1FF9DD0300781E) != 0xBBF6FD05D41D8514) {
    _l2_l1bad = _l2_l1bad + 1;
}
if (_l2_mk(0x3FE31A4FFAEA77EF, 0x3DEF6A3158F30358, 0x3E8FCD39729C8128, 0x3FE31A4FFAEA6876) != 0x3D607F75A1D60906) {
    _l2_l1bad = _l2_l1bad + 1;
}
if (_l2_mk(0x3EBA78A91DBF5780, 0x3E9F960A676E90B2, 0xBE2C87AEBD203640, 0x3EB9441BAB7A71B6) != 0x3B7093B54F56903C) {
    _l2_l1bad = _l2_l1bad + 1;
}
if (_l2_mk(0x3F6C7BE48EACE66C, 0x3F1B96F861996496, 0xBF6C788D35011424, 0xBE0B08FF5B089D1C) != 0x3C6C5F15E693D312) {
    _l2_l1bad = _l2_l1bad + 1;
}
assert_eq(_l2_l1bad, 0, "minkowski: five mixed-magnitude vectors, level 1, each within 1 u");
# Integer vectors: t^2 - x^2 - y^2 - z^2 exact in i64 (|slot| < 2^30), random (|R| up to 2^61) and
# near the cone (t = round(|p|) + {-1, 0, 1}), each also times 2^(2k) for k = 480, 490 (scaled
# past 2^511), -250 and -520 (scaled under 2^-485). Checked exactly: the sign (+0 exactly for 0);
# for a normal interval |g - R| <= 2^-50 |R| on the unscaled result g (in doubles where |R| <
# 2^53, in i64 above); for a subnormal one, under one step; past DBL_MAX, the infinity. Off the
# cone ((a + 3 s) / |r| below 6, a stricter test than the filter's) the plain formula's bits.
# [measured: the assertions below]
var _l2_isd: i64[1];
store64(&_l2_isd, 161803);
var _l2_ibad = 0;
var _l2_irun = 0;
var _l2_iplain = 0;
var _l2_ks: i64[5];
store64(&_l2_ks, 0); store64(&_l2_ks + 8, 480); store64(&_l2_ks + 16, 490); store64(&_l2_ks + 24, 0 - 250);
store64(&_l2_ks + 32, 0 - 520);
for (var i = 0; i < 2000; i = i + 1) {
    var it = _l2_int(&_l2_isd, 30); var ix = _l2_int(&_l2_isd, 30);
    var iy = _l2_int(&_l2_isd, 30); var iz = _l2_int(&_l2_isd, 30);
    if (i % 2 == 1) {
        var rr2 = f64_sqrt(f64_from(ix * ix + iy * iy + iz * iz));
        it = f64_to(f64_add(rr2, F64_HALF)) + (i % 3) - 1;
    }
    var ri = it * it - ix * ix - iy * iy - iz * iz;
    var rd = f64_from(ri);
    var ar = ri;
    if (ar < 0) { ar = 0 - ar; }
    for (var kk = 0; kk < 5; kk = kk + 1) {
        var k = load64(&_l2_ks + kk * 8);
        var sk = (1023 + k) << 52;
        var usk = (1023 - k) << 52;
        var vt = f64_mul(f64_from(it), sk); var vx = f64_mul(f64_from(ix), sk);
        var vy = f64_mul(f64_from(iy), sk); var vz = f64_mul(f64_from(iz), sk);
        var got = _l2_mk(vt, vx, vy, vz);
        _l2_irun = _l2_irun + 1;
        if (ri == 0) {
            if (got != 0) { _l2_ibad = _l2_ibad + 1; }
        } else {
            if (ri > 0 && f64_gt(got, 0) == 0) { _l2_ibad = _l2_ibad + 1; }
            if (ri < 0 && f64_lt(got, 0) == 0) { _l2_ibad = _l2_ibad + 1; }
            var gu = f64_mul(f64_mul(got, usk), usk);   # exact: a power of two, no overflow
            var w2 = f64_mul(f64_mul(rd, sk), sk);
            if ((w2 & 0x7FFFFFFFFFFFFFFF) == 0x7FF0000000000000) {
                if (got != w2) { _l2_ibad = _l2_ibad + 1; }   # the interval's rounding overflows
            } elif (f64_ge(f64_abs(w2), 0x0010000000000000) == 1) {
                if (ar < 0x20000000000000) {
                    if (f64_gt(f64_abs(f64_sub(gu, rd)), f64_mul(f64_abs(rd), 0x3CD0000000000000)) == 1) {
                        _l2_ibad = _l2_ibad + 1;
                    }
                } else {
                    var dd = f64_to(gu) - ri;   # gu is integer-valued past 2^52
                    if (dd < 0) { dd = 0 - dd; }
                    if (dd > (ar >> 50)) { _l2_ibad = _l2_ibad + 1; }
                }
            } else {
                # a subnormal interval (k < 0 only): under one step, 2^(-1074 - 2k) unscaled
                if (f64_lt(f64_abs(f64_sub(gu, rd)), (1023 - 1074 - 2 * k) << 52) == 0) { _l2_ibad = _l2_ibad + 1; }
            }
        }
        var pa = f64_mul(vt, vt);
        var ps = f64_add(f64_add(f64_mul(vx, vx), f64_mul(vy, vy)), f64_mul(vz, vz));
        var pr = f64_sub(pa, ps);
        var plhs = f64_add(f64_add(pa, f64_mul(ps, 0x4008000000000000)), 0x0050000000000000);
        if (f64_lt(plhs, f64_mul(f64_abs(pr), 0x4018000000000000)) == 1) {
            _l2_iplain = _l2_iplain + 1;
            if (got != pr) { _l2_ibad = _l2_ibad + 1; }
        }
    }
}
assert_eq(_l2_irun, 10000, "the integer sweep compared 10,000 vectors");
assert_eq(_l2_iplain > 2000, 1, "over 2,000 of them off the cone, where the plain formula's bits are required");
assert_eq(_l2_ibad, 0, "minkowski on integer vectors at five scales: the sign exact, within 2^-50 (or a step)");

# === 3.4.1 LIE2: _ot_center_into ===
test_group("3.4.1 LIE2: _ot_center_into in scalar ops, bit-identical to the packed form (cycc 6.6.3 miscompile)");
# The packed form f64v_add(out, mn, mx, 2) ... f64v_scale(out, out, 0.5, 2) is miscompiled by
# cycc 6.6.0 - 6.6.4 (a pinned 6.6.3 consumer inserting into an octree ended with exit 139).
# Under this suite's toolchain the packed form is right, so it is the oracle here: 4,000 boxes
# whose corners mix +-0, subnormals, values near DBL_MAX, +-Inf, NaN and ordinary numbers.
# 120,000 boxes compared under cycc 6.7.18: 0 of 360,000 components differ.
# [measured: LIE2 lane octc.cyr probe and check-miscompile.sh --pin 6.6.3 (2 slots before, 0 after)]
fn _l2_pick(sp) {
    var s = _l2_next(sp);
    var kind = (s >> 40) & 7;
    var r = s >> 1;
    if (kind == 0) { return (s >> 3) & 0x000FFFFFFFFFFFFF; }                       # subnormal
    if (kind == 1) { return 0x7FD0000000000000 + ((s >> 3) & 0x001FFFFFFFFFFFFF); }   # near DBL_MAX
    if (kind == 2) {
        var sp6 = (s >> 8) & 7;
        if (sp6 == 0) { return 0; }
        if (sp6 == 1) { return 0x8000000000000000; }
        if (sp6 == 2) { return 0x7FF0000000000000; }
        if (sp6 == 3) { return 0xFFF0000000000000; }
        if (sp6 == 4) { return 0x7FF8000000000000; }
        if (sp6 == 5) { return 0x7FEFFFFFFFFFFFFF; }
        return 0x0010000000000000;
    }
    if (kind == 3) { return r; }                                                    # any pattern
    return f64_div(f64_from((s >> 20) & 0xFFFFF), f64_from(1000));                  # ordinary
}
var _l2_csd: i64[1];
store64(&_l2_csd, 314159);
var _l2_cmn = hvec3_zero();
var _l2_cmx = hvec3_zero();
var _l2_cbox = alloc(16);
store64(_l2_cbox, _l2_cmn); store64(_l2_cbox + 8, _l2_cmx);
var _l2_cbad = 0;
var _l2_crun = 0;
var _l2_cpk: i64[3];
var _l2_csc: i64[3];
# The packed form, as 3.4.0 wrote it (SIMD intrinsics are called inside a function).
fn _l2_packed_center(mn, mx, out) {
    f64v_add(out, mn, mx, 2);
    f64v_scale(out, out, F64_HALF, 2);
    store64(out + 16, f64_mul(f64_add(HVec3_z(mn), HVec3_z(mx)), F64_HALF));
    return 0;
}
for (var i = 0; i < 4000; i = i + 1) {
    HVec3_set_x(_l2_cmn, _l2_pick(&_l2_csd)); HVec3_set_y(_l2_cmn, _l2_pick(&_l2_csd));
    HVec3_set_z(_l2_cmn, _l2_pick(&_l2_csd));
    HVec3_set_x(_l2_cmx, _l2_pick(&_l2_csd)); HVec3_set_y(_l2_cmx, _l2_pick(&_l2_csd));
    HVec3_set_z(_l2_cmx, _l2_pick(&_l2_csd));
    _l2_packed_center(_l2_cmn, _l2_cmx, &_l2_cpk);
    _ot_center_into(_l2_cbox, &_l2_csc);
    for (var c = 0; c < 3; c = c + 1) {
        if (load64(&_l2_cpk + c * 8) != load64(&_l2_csc + c * 8)) { _l2_cbad = _l2_cbad + 1; }
        _l2_crun = _l2_crun + 1;
    }
}
assert_eq(_l2_crun, 12000, "the centre comparison ran 12,000 components");
assert_eq(_l2_cbad, 0, "_ot_center_into = the packed (min + max) * 0.5, bit for bit, NaN and signed zeros included");

# === 3.4.1 LIE3: wedge_1_1 ===
test_group("3.4.1 LIE3: wedge_1_1 for dim 1, 2, 3 (roadmap AU2-G6-F11)");
# Lambda^2(R^1) has no components: dim 1 is an empty array, a real pointer (0 is the refusal;
# 3.4.0 answered 0). dim 2 and 3 against the exact wedge alpha_i beta_j - alpha_j beta_i (every
# product exact here, so the components are).
var _l3_wa: i64[3];
var _l3_wb: i64[3];
store64(&_l3_wa, F64_ONE); store64(&_l3_wa + 8, F64_TWO); store64(&_l3_wa + 16, f64_from(3));
store64(&_l3_wb, f64_from(4)); store64(&_l3_wb + 8, f64_from(5)); store64(&_l3_wb + 16, f64_from(6));
assert_eq(wedge_1_1(&_l3_wa, &_l3_wb, 1) != 0, 1, "wedge_1_1, dim 1: an empty array, not the refusal 0 (3.4.0: 0)");
var _l3_w2 = wedge_1_1(&_l3_wa, &_l3_wb, 2);
assert_eq(load64(_l3_w2), f64_from(0 - 3), "wedge_1_1, dim 2: 1 * 5 - 2 * 4 = -3");
var _l3_w3 = wedge_1_1(&_l3_wa, &_l3_wb, 3);
assert_eq(load64(_l3_w3), f64_from(0 - 3), "wedge_1_1, dim 3: (01) = 1 * 5 - 2 * 4 = -3");
assert_eq(load64(_l3_w3 + 8), f64_from(0 - 6), "wedge_1_1, dim 3: (02) = 1 * 6 - 3 * 4 = -6");
assert_eq(load64(_l3_w3 + 16), f64_from(0 - 3), "wedge_1_1, dim 3: (12) = 2 * 6 - 3 * 5 = -3");
# dyadic: alpha = (0.75, -1.5, 2.25), beta = (0.5, 0.125, -3)
store64(&_l3_wa, 0x3FE8000000000000); store64(&_l3_wa + 8, 0xBFF8000000000000);
store64(&_l3_wa + 16, 0x4002000000000000);
store64(&_l3_wb, F64_HALF); store64(&_l3_wb + 8, 0x3FC0000000000000); store64(&_l3_wb + 16, 0xC008000000000000);
var _l3_w3d = wedge_1_1(&_l3_wa, &_l3_wb, 3);
assert_eq(load64(_l3_w3d), 0x3FEB000000000000, "wedge_1_1, dim 3 dyadic: (01) = 0.84375");
assert_eq(load64(_l3_w3d + 8), 0xC00B000000000000, "wedge_1_1, dim 3 dyadic: (02) = -3.375");
assert_eq(load64(_l3_w3d + 16), 0x4010E00000000000, "wedge_1_1, dim 3 dyadic: (12) = 4.21875");
assert_eq(wedge_1_1(&_l3_wa, &_l3_wb, 0), 0, "wedge_1_1, dim 0: refused (0)");

# === 3.4.1 LIE3: kd-tree distances ===
test_group("3.4.1 LIE3: kd-tree nearest / within_radius by exact distance, whole range (roadmap SPC-F2, AU2-G5-F6)");
# The audit's cases, then integer point sets scaled by 2^k (k = 0, 520, -545, -1060, 1001):
# the exact squared distances are i64 values times 4^k, so brute force over them is the oracle.
fn _l3_v3s(pts, i, x, y, z) {
    store64(pts + i * 8, hvec3_new(x, y, z));
    return 0;
}
var _l3_kp = alloc(64);
_l3_v3s(_l3_kp, 0, 0x5FF4CCCCCCCCCCCD, 0, 0);
_l3_v3s(_l3_kp, 1, 0x600599999999999A, 0, 0);
var _l3_kt = kdtree_build(_l3_kp, 2);
assert_eq(kdtree_nearest(_l3_kt, _l3_kp, hvec3_zero()), 0, "nearest, two points near 2^512, query 0 (3.4.0: -1)");
_l3_v3s(_l3_kp, 0, 0x1CBCFBE97BBA6E07, 0x1CC8274291C6065B, 0);
_l3_v3s(_l3_kp, 1, 0x9CA3529BA7D19EAF, 0, 0);
_l3_kt = kdtree_build(_l3_kp, 2);
assert_eq(kdtree_nearest(_l3_kt, _l3_kp, hvec3_new(0x1CA54144D23361C1, 0, 0)), 1,
  "kdtree_nearest at 2^-560: the nearer point, 1 (3.4.0: 0)");
# within_radius: r = 2^516 (r^2 overflows) and r = 2^-540 (r^2 flushes); a point 3r away is out.
_l3_v3s(_l3_kp, 0, 0, 0, 0);
_l3_v3s(_l3_kp, 1, 0x6048000000000000, 0, 0);   # 3 2^516
_l3_kt = kdtree_build(_l3_kp, 2);
var _l3_kr = kdtree_within_radius(_l3_kt, _l3_kp, hvec3_zero(), 0x6030000000000000);
assert_eq(vec_len(_l3_kr) * 10 + vec_get(_l3_kr, 0), 10, "within_radius(r = 2^516): the centre only (3.4.0: both)");
_l3_v3s(_l3_kp, 1, 0x1E48000000000000, 0, 0);   # 3 2^-540
_l3_kt = kdtree_build(_l3_kp, 2);
_l3_kr = kdtree_within_radius(_l3_kt, _l3_kp, hvec3_zero(), 0x1E30000000000000);
assert_eq(vec_len(_l3_kr) * 10 + vec_get(_l3_kr, 0), 10, "within_radius(r = 2^-540): the centre only (3.4.0: both)");
# A tree whose only point is infinite: that point, at +Inf, is the nearest (3.4.0: -1, "empty").
_l3_v3s(_l3_kp, 0, 0x7FF0000000000000, 0, 0);
_l3_kt = kdtree_build(_l3_kp, 1);
assert_eq(kdtree_nearest(_l3_kt, _l3_kp, hvec3_zero()), 0, "kdtree_nearest, the only point infinite: 0 (3.4.0: -1)");
# A query with a NaN or infinite coordinate: -1, as 3.4.0.
_l3_v3s(_l3_kp, 0, F64_ONE, 0, 0);
_l3_kt = kdtree_build(_l3_kp, 1);
assert_eq(kdtree_nearest(_l3_kt, _l3_kp, hvec3_new(0x7FF0000000000000, 0, 0)), 0 - 1, "nearest, query +Inf: -1");
assert_eq(kdtree_nearest(_l3_kt, _l3_kp, hvec3_new(0x7FF8000000000000, 0, 0)), 0 - 1, "nearest, query NaN: -1");
# A NaN radius encloses nothing (as documented; the robust path must not take it as a size).
_l3_v3s(_l3_kp, 0, 0, 0, 0);
_l3_v3s(_l3_kp, 1, F64_ONE, 0, 0);
_l3_kt = kdtree_build(_l3_kp, 2);
assert_eq(vec_len(kdtree_within_radius(_l3_kt, _l3_kp, hvec3_zero(), 0x7FF8000000000000)), 0, "radius NaN: none");
# Two points whose squared distances from the query differ by 1 at 2^54 (equal in floating
# point): the exact comparison picks the nearer, whichever the traversal meets first.
_l3_v3s(_l3_kp, 0, 0x4190000000000000, 0x4190000000000000, F64_ONE);   # (2^26, 2^26, 1)
_l3_v3s(_l3_kp, 1, 0x4190000000000000, 0xC190000000000000, 0);         # (2^26, -2^26, 0)
_l3_kt = kdtree_build(_l3_kp, 2);
assert_eq(kdtree_nearest(_l3_kt, _l3_kp, hvec3_zero()), 1, "kdtree_nearest, D = 2^53 + 1 against 2^53: 1");
_l3_v3s(_l3_kp, 0, 0x4190000000000000, 0x4190000000000000, 0);
_l3_v3s(_l3_kp, 1, 0x4190000000000000, 0xC190000000000000, F64_ONE);
_l3_kt = kdtree_build(_l3_kp, 2);
assert_eq(kdtree_nearest(_l3_kt, _l3_kp, hvec3_zero()), 0, "kdtree_nearest, the same swapped: 0");
# On the sphere: (3, 4, 0) 2^25 at exactly r = 5 2^25 is in; (3 2^25, 4 2^25, 1), 1 further in
# r^2 = 25 2^50, rounds onto r^2 and is out (3.4.0: in).
_l3_v3s(_l3_kp, 0, 0x4198000000000000, 0x41A0000000000000, 0);         # (3 2^25, 4 2^25, 0)
_l3_v3s(_l3_kp, 1, 0x4198000000000000, 0x41A0000000000000, F64_ONE);   # (3 2^25, 4 2^25, 1)
_l3_kt = kdtree_build(_l3_kp, 2);
_l3_kr = kdtree_within_radius(_l3_kt, _l3_kp, hvec3_zero(), 0x41A4000000000000);   # 5 2^25
assert_eq(vec_len(_l3_kr) * 10 + vec_get(_l3_kr, 0), 10, "within_radius(5 2^25): the point on the sphere (3.4.0 both)");
# Two-point cases found by a search against the exact oracle: each needs one part of the
# repair (the margins of the leaf bounds, the scaled comparison's margin, the exact sum's 2 s e
# term, the overflow halving, the plane bound), and 3.4.0 answers each wrongly or not at all.
# [measured: LIE3 lane kdsmall.py searches against Fraction distances, 2026-11-01]
fn _l3_k2(ax, ay, az, bx, by, bz) {
    _l3_v3s(_l3_kp, 0, ax, ay, az);
    _l3_v3s(_l3_kp, 1, bx, by, bz);
    return kdtree_build(_l3_kp, 2);
}
fn _l3_rset(t, qx, qy, qz, r) {
    var res = kdtree_within_radius(t, _l3_kp, hvec3_new(qx, qy, qz), r);
    var m = 0;
    for (var i = 0; i < vec_len(res); i = i + 1) { m = m | (1 << vec_get(res, i)); }
    return vec_len(res) * 16 + m;
}
_l3_kt = _l3_k2(0xBFF4CC967683DF24, 0x3FED8C845D294AC2, 0xBFDBE2E0B249EA0D, 0xBFE027743833ACC7, 0xBFBE8917C5D0C08F,
  0x3FD1D12184C0D743);
assert_eq(kdtree_nearest(_l3_kt, _l3_kp, hvec3_new(0xBFECE050929DB588, 0x3FD9BB61646F32B0, 0xBFB4237E5B122590)), 1,
  "nearest, a near tie at 1: point 1");
_l3_kt = _l3_k2(0xE020F45FD69F39E0, 0x6063268E7954BE7D, 0x606F2B09FE80E8F3, 0xE07534C54C587961, 0xE074FC4162E9C9B4,
  0xE02DDC885AC50040);
assert_eq(_l3_rset(_l3_kt, 0xE065BC684B0D7330, 0xE056D1F44C7ED4E8, 0x605D4D4178D498F0, 0x607436901EF0CB89), 0,
  "within_radius past 2^512, just outside: none");
_l3_kt = _l3_k2(0xBFD9307CE320400C, 0xBFE480AE641CEFAD, 0xBFC8F1B12B6E7DE8, 0xBFD32EED79DE24F5, 0xBFE5A2762E43B6BB,
  0xBFD6316FB7B3497C);
assert_eq(_l3_rset(_l3_kt, 0xBFD62FB52E7F3280, 0xBFE5119249305334, 0xBFD1552426B54438, 0x3FB74C3F89FFEF3C), 16 + 2,
  "within_radius, point 1 on the sphere's edge: in");
_l3_kt = _l3_k2(0x7FEBBDA927F60396, 0x7F81469FF55F2FBF, 0, 0x7FEBAF79A240DE03, 0xFFB5D606E5AF1A21, 0);
assert_eq(kdtree_nearest(_l3_kt, _l3_kp, hvec3_new(0xFFEFE192EA71CECB, 0, 0)), 0,
  "nearest across 2^1024 (differences overflow): point 0");
_l3_kt = _l3_k2(0xA9C7D33C7EE35DAC, 0xA4860D954AF86ED2, 0x45E0B158F2349660, 0x3C2A37025B47D544, 0xB75378EF48DCB200,
  0x2B3AB852D5F47CA0);
assert_eq(kdtree_nearest(_l3_kt, _l3_kp, hvec3_new(0xCC87DFC9325E40AC, 0x97B152BDECD3655E, 0xC745EF7023478C76)), 1,
  "nearest, mixed exponents: point 1");
assert_eq(_l3_rset(_l3_kt, 0xCC87DFC9325E40AC, 0x97B152BDECD3655E, 0xC745EF7023478C76, 0x591E573086A679AF), 32 + 3,
  "within_radius, mixed exponents: both");
_l3_kt = _l3_k2(0x24D8F3AF9F68CC60, 0x3150156EE8C62B76, 0xCDCDF7D2F867F38E, 0xC20AC16E4F069CCA, 0xC6BC145ED8F8630E,
  0x28BC17A49C7CC758);
assert_eq(kdtree_nearest(_l3_kt, _l3_kp, hvec3_new(0x66ED9C1A82631C78, 0x119CF79C390A3A4A, 0x7B)), 0,
  "nearest, mixed exponents (an inexact difference): point 0");
# The grid {-3, 0, 3}^3 and the ball of radius 3 about 0: the 7 points at distance 0 or exactly 3.
var _l3_gp = alloc(27 * 8);
for (var i = 0; i < 27; i = i + 1) {
    var gx = f64_from((i / 9) * 3 - 3);
    store64(_l3_gp + i * 8, hvec3_new(gx, f64_from(((i / 3) % 3) * 3 - 3), f64_from((i % 3) * 3 - 3)));
}
var _l3_gt = kdtree_build(_l3_gp, 27);
var _l3_gr = kdtree_within_radius(_l3_gt, _l3_gp, hvec3_zero(), f64_from(3));
var _l3_gm = 0;
for (var i = 0; i < vec_len(_l3_gr); i = i + 1) { _l3_gm = _l3_gm | (1 << vec_get(_l3_gr, i)); }
assert_eq(_l3_gm, (1 << 4) | (1 << 10) | (1 << 12) | (1 << 13) | (1 << 14) | (1 << 16) | (1 << 22),
  "within_radius on the grid {-3, 0, 3}^3, r = 3: the centre and its six neighbours, the boundary included");
# The sweep.
var _l3_ksd: i64[1];
store64(&_l3_ksd, 141421);
var _l3_kbad = 0;
var _l3_kbadr = 0;
var _l3_kruns = 0;
var _l3_kin = 0;
var _l3_ks: i64[5];
store64(&_l3_ks, 0); store64(&_l3_ks + 8, 520); store64(&_l3_ks + 16, 0 - 545); store64(&_l3_ks + 24, 0 - 1060);
store64(&_l3_ks + 32, 1001);
var _l3_ip = alloc(64 * 3 * 8);
var _l3_pp = alloc(64 * 8);
var _l3_dd = alloc(64 * 8);
for (var tr = 0; tr < 60; tr = tr + 1) {
    var nb = 4;                       # ties: small coordinates
    if (tr % 3 == 1) { nb = 23; }
    if (tr % 3 == 2) { nb = 26; }     # squares past 2^53: rounded distances
    var np = 1 + (tr * 7) % 60;
    for (var i = 0; i < np * 3; i = i + 1) { store64(_l3_ip + i * 8, _l2_int(&_l3_ksd, nb)); }
    if (tr % 3 == 2 && np >= 2) {     # a pair at squared distances D and D + 1 from point 0
        store64(_l3_ip + 3 * 8, load64(_l3_ip) + (1 << 25));
        store64(_l3_ip + 4 * 8, load64(_l3_ip + 8) + (1 << 25));
        store64(_l3_ip + 5 * 8, load64(_l3_ip + 16) + 1);
    }
    for (var kk = 0; kk < 5; kk = kk + 1) {
        var k = load64(&_l3_ks + kk * 8);
        if (k == 1001 && nb > 23) { continue; }   # 2^26 2^1001 would overflow
        var sk = (1023 + k) << 52;
        if (k < 0 - 1022) { sk = 1 << (1074 + k); }
        for (var i = 0; i < np; i = i + 1) {
            var cx = f64_mul(f64_from(load64(_l3_ip + i * 24)), sk);
            var cy = f64_mul(f64_from(load64(_l3_ip + i * 24 + 8)), sk);
            store64(_l3_pp + i * 8, hvec3_new(cx, cy, f64_mul(f64_from(load64(_l3_ip + i * 24 + 16)), sk)));
        }
        var root = kdtree_build(_l3_pp, np);
        for (var qi = 0; qi < 8; qi = qi + 1) {
            var qx = _l2_int(&_l3_ksd, nb); var qy = _l2_int(&_l3_ksd, nb); var qz = _l2_int(&_l3_ksd, nb);
            if (qi == 0) { qx = load64(_l3_ip); qy = load64(_l3_ip + 8); qz = load64(_l3_ip + 16); }
            var mn = 0x7FFFFFFFFFFFFFFF;
            for (var i = 0; i < np; i = i + 1) {
                var ax = load64(_l3_ip + i * 24) - qx; var ay = load64(_l3_ip + i * 24 + 8) - qy;
                var az = load64(_l3_ip + i * 24 + 16) - qz;
                var dv = ax * ax + ay * ay + az * az;
                store64(_l3_dd + i * 8, dv);
                if (dv < mn) { mn = dv; }
            }
            var q = hvec3_new(f64_mul(f64_from(qx), sk), f64_mul(f64_from(qy), sk), f64_mul(f64_from(qz), sk));
            var ni = kdtree_nearest(root, _l3_pp, q);
            if (ni < 0 || load64(_l3_dd + ni * 8) != mn) { _l3_kbad = _l3_kbad + 1; }
            # radius rho 2^k, rho an integer: rho^2 against the i64 distances, the boundary included
            var rho = f64_to(f64_sqrt(f64_from(load64(_l3_dd + (qi % np) * 8)))) + (qi % 3) - 1;
            if (rho < 0) { rho = 0; }
            var rr = f64_mul(f64_from(rho), sk);
            if (rr == 0x7FF0000000000000) { continue; }   # rho 2^1000 past DBL_MAX: no finite radius
            var res = kdtree_within_radius(root, _l3_pp, q, rr);
            var want = 0;
            for (var i = 0; i < np; i = i + 1) { if (load64(_l3_dd + i * 8) <= rho * rho) { want = want + 1; } }
            if (res == 0 || vec_len(res) != want) { _l3_kbadr = _l3_kbadr + 1; }
            else {
                for (var a = 0; a < vec_len(res); a = a + 1) {
                    if (load64(_l3_dd + vec_get(res, a) * 8) > rho * rho) { _l3_kbadr = _l3_kbadr + 1; }
                }
            }
            _l3_kin = _l3_kin + want;
            _l3_kruns = _l3_kruns + 1;
        }
    }
}
assert_eq(_l3_kruns > 2000, 1, "the kd-tree sweep ran over 2,000 queries");
assert_eq(_l3_kin > 2000, 1, "and found over 2,000 points inside their radii");
assert_eq(_l3_kbad, 0, "kdtree_nearest at 2^0, 2^520, 2^-545, 2^-1060, 2^1001: a nearest point by exact distance");
assert_eq(_l3_kbadr, 0, "kdtree_within_radius at the same scales: exactly the points within rho 2^k");

# === 3.4.1 GEO4: far thin capsules decided exactly ===
test_group("3.4.1 GEO4: far thin capsules decided exactly");
# RV-GEO's rebuilt "aimed" family (a far capsule 2^-40 .. 2^-1000 long met by a ray through 0) and a
# spread variant, against an exact Fraction oracle: s14, 3.4.0 and 3.3.7 had the hit/miss wrong on
# 145 / 166 / 123 / 138 of 4,000 (seeds 1-4); the far copy's answer now stands only where its float
# certificate holds, else _geo_cap_xsolve decides. Each row below was wrong in s14 (its value given).
# [measured: GEO4 3.4.1 fam.py aimed/aspread, run.py, exact Fraction oracle, s14 vs this tree, 2026-11-01]
