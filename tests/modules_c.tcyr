# _ga_hull_near certifies a point of the hull within 2^-49 of the largest coordinate, its
# rounding term 2^-51 (|p| + |r|) (through the lane review 2^-48 and 2^-50): an edge 2^-49
# from the origin is no longer near, one 2^-51 from it is.
var _cr_h = alloc(40);
store64(_cr_h, hvec3_new(f64_neg(F64_ONE), 0x3CE0000000000000, 0));
store64(_cr_h + 8, hvec3_new(F64_ONE, 0x3CE0000000000000, 0));
store64(_cr_h + 16, hvec3_new(0, F64_ONE, F64_ONE));
store64(_cr_h + 24, hvec3_new(0, F64_ONE, f64_neg(F64_ONE)));
assert_eq(_ga_hull_near(_cr_h), 0,
  "_ga_hull_near: an edge 2^-49 from the origin is not near (the lane's first round: 1)");
store64(_cr_h, hvec3_new(f64_neg(F64_ONE), 0x3CC0000000000000, 0));
store64(_cr_h + 8, hvec3_new(F64_ONE, 0x3CC0000000000000, 0));
assert_eq(_ga_hull_near(_cr_h), 1, "_ga_hull_near: ... one 2^-51 from it is (control)");

