      0x40526F6B45222952, 0xC07591D14DE30E93), geo_capsule_new(hvec3_new(0x306BD9285AA35102,
        0xB09E5107AC2553AF, 0x30807F2BB75586C2), hvec3_new(0xB0853AA2CBC6549A, 0x30B71C51B7DD489B,
        0xB09926BD6486BB09), 0x2D0FCD2CF1F9A4DB), _g4_br), 0x3F90000000000000,
