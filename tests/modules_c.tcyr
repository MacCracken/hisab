# === 3.4.1 CO7: what the wider rings cost, and where they stop ===
# Support calls, pinned: a deep cap far from the rim stops at the first ring that reads n itself
# (four supports; each further ring would add its own), two tilted cylinders stop at the crease
# the ring refused, and a ball pair run after a cylinder asks no ring on the cylinder's flag.
# [measured: lane CO7 costmut.py, the nostop, widestop and nostale mutants; 2026-11-01]
var _co7_zc = _co7_cyl(hvec3_new(0, 0, 0), hvec3_new(0, 0, F64_ONE), F64_ONE, F64_ONE);
var _co7_ac = _co7_cyl(hvec3_new(0, 0, 0), hvec3_new(0x3FE3333333333333, 0x3FDEB851EB851EB8, 0x3FE47AE147AE147B),
  F64_ONE, F64_ONE);
var _co7_tc = _co7_cyl(hvec3_new(0x3FF8000000000000, 0x3FC999999999999A, 0x3FD3333333333333),
  hvec3_new(0, 0x3FE999999999999A, 0x3FE3333333333333), F64_ONE, F64_ONE);
var _co7_db = hvec4_new(0x3FC999999999999A, 0x3FB999999999999A, 0x3FF3333333333333, 0x3FD3333333333333);
_co4_calls = 0;
_co7_ge(_co7_zc, _co7_db);
assert_eq(_co4_calls, 97,
  "gjk_epa_3d: a deep cap: one ring (a further ring each would be 22 more calls) [CO7: 89; CO8 reads the ball]");
_co4_calls = 0;
assert_eq(gjk_epa_3d(&_co7_sup_cyl, _co7_ac, &_co7_sup_cyl, _co7_tc, _co4_n, _co4_d), 1,
  "gjk_epa_3d: two tilted cylinders");
assert_eq(_co4_calls, 181, "gjk_epa_3d: ... the ring stops at the crease it refused");
var _co7_s1 = hvec4_new(0, 0, 0, F64_ONE);
var _co7_s2 = hvec4_new(0x3FE0000000000000, 0, 0, F64_ONE);
_co7_ge(_co7_c2, _co7_b2);
_co4_calls = 0;
gjk_epa_3d(&_co4_sup_sph, _co7_s1, &_co4_sup_sph, _co7_s2, _co4_n, _co4_d);
assert_eq(_co4_calls, 559, "gjk_epa_3d: two balls deep, after a cylinder: no ring");

# === 3.4.1 CO7: the order key's generic directions ===
# A sphere and the octahedron of its axis points tie along all six axes; the key's eight generic
# directions tell them apart, so the two calls of the pair are one run, mirrored. Through CO6: 99 to
# 100 of 100 normals and 6 to 30 of 100 depths differed from their mirror. (Two copies of one shape
# tie along all fourteen, and are run in the order given.)
# [measured: review R2-CO order_tie.py, 3.4.1-dev and this tree; 2026-11-01]
fn _co7_sup_oct(s, d) {
    _co4_calls = _co4_calls + 1;
    var k = 0;
    var m = f64_abs(HVec3_x(d));
    if (f64_gt(f64_abs(HVec3_y(d)), m) == 1) {
        k = 1;
        m = f64_abs(HVec3_y(d));
    }
    if (f64_gt(f64_abs(HVec3_z(d)), m) == 1) { k = 2; }
    var p = hvec3_new(load64(s), load64(s + 8), load64(s + 16));
    var r = load64(s + 24);
    if (f64_lt(load64(d + k * 8), 0) == 1) { r = f64_neg(r); }
    store64(p + k * 8, f64_add(load64(p + k * 8), r));
    return p;
}
var _co7_os = hvec4_new(0x3FD0000000000000, 0xBFE0000000000000, F64_ONE, 0x3FF4000000000000);
assert_eq(gjk_epa_3d(&_co4_sup_sph, _co7_os, &_co7_sup_oct, _co7_os, _co4_n, _co4_d), 1,
  "gjk_epa_3d: a sphere and the octahedron of its axis points: contact");
var _co7_d1 = load64(_co4_d);
var _co7_n1 = load64(_co4_n);
assert_eq(gjk_epa_3d(&_co7_sup_oct, _co7_os, &_co4_sup_sph, _co7_os, _co4_n, _co4_d), 1,
  "gjk_epa_3d: ... the other order");
assert_eq(load64(_co4_d), _co7_d1, "gjk_epa_3d: ... the same depth, bit for bit");
assert_eq(HVec3_x(load64(_co4_n)) ^ 0x8000000000000000, HVec3_x(_co7_n1), "gjk_epa_3d: ... a mirrored normal: x");
assert_eq(HVec3_y(load64(_co4_n)) ^ 0x8000000000000000, HVec3_y(_co7_n1), "gjk_epa_3d: ... y");
assert_eq(HVec3_z(load64(_co4_n)) ^ 0x8000000000000000, HVec3_z(_co7_n1), "gjk_epa_3d: ... z");
assert_eq(mpr_penetration(&_co4_sup_sph, _co7_os, &_co7_sup_oct, _co7_os, _co4_n, _co4_d), 1,
  "mpr_penetration: the same pair: contact");
var _co7_d2 = load64(_co4_d);
var _co7_n2 = load64(_co4_n);
assert_eq(mpr_penetration(&_co7_sup_oct, _co7_os, &_co4_sup_sph, _co7_os, _co4_n, _co4_d), 1,
  "mpr_penetration: ... the other order");
assert_eq(load64(_co4_d), _co7_d2, "mpr_penetration: ... the same depth, bit for bit");
assert_eq(HVec3_x(load64(_co4_n)) ^ 0x8000000000000000, HVec3_x(_co7_n2), "mpr_penetration: ... a mirrored normal: x");
assert_eq(HVec3_y(load64(_co4_n)) ^ 0x8000000000000000, HVec3_y(_co7_n2), "mpr_penetration: ... y");
assert_eq(HVec3_z(load64(_co4_n)) ^ 0x8000000000000000, HVec3_z(_co7_n2), "mpr_penetration: ... z");

# === 3.4.1 CO7: sequential_impulse, _col_si_top's four branches, -v_t / M, and the exact sign ===
# Oracle: the closed form in Fractions, rounded once, +Inf from T = 2^1024 - 2^970 on (ties to even).
# Each row is a family of the review's (py/si_top.py), the last words what lane CO6 answered.
# [measured: lane CO7 gen_si_tests.py, si_top.py seed 1 (all families 0 wrong), review R2-CO on CO6; 2026-11-01]
_co6_si(0x7FE0000000000000, 0x0000000000000001, 0x0000000000000000, 0x7E70000000000000, 0x7E70000000000000,
  0x3FF0000000000000, 1);
assert_eq(load64(&_co6_si2), 0x7FF0000000000000,
  "sequential_impulse: kt past 4095: the cone's scale wraps a shift unless +Inf is answered first (CO6: -DBL_MAX)");
assert_eq(load64(&_co6_si2 + 8), 0xFFF0000000000000, "sequential_impulse: ... its friction");
_co6_si(0x7EDFFFFFFC000000, 0x4090000000000000, 0x0000000000000200, 0x0000000000000000, 0x41A0000000000000,
  0x0000000000000000, 1);
assert_eq(load64(&_co6_si2), 0x7FEFFFFFFFFFFFFF,
  "sequential_impulse: msl below 2^-1080 keeps its sign: a tie broken 2^-1075 of M below T (CO6: +Inf)");
_co6_si(0x588FFFFFFC000000, 0x3FD0000000000000, 0x1A40000000000000, 0x0000000000000000, 0x6730000002000000,
  0x0000000000000000, 1);
assert_eq(load64(&_co6_si2), 0x7FEFFFFFFFFFFFFF,
  "sequential_impulse: two tiny terms, e pen's 1 and the mass's err, compared by size (CO6: +Inf)");
_co6_si(0x7E8FFFFFFC000000, 0x3FD0000000000000, 0x1730000000000000, 0x4130000002000000, 0x1430000000000000,
  0x7FE0000000000000, 1);
assert_eq(load64(&_co6_si2), 0x7EAFFFFFFC000000,
  "sequential_impulse: the cone's two tiny terms (CO6: -Inf)");
assert_eq(load64(&_co6_si2 + 8), 0xFFEFFFFFFFFFFFFF, "sequential_impulse: ... its friction");
_co6_si(0x5A4FFFFFFC000000, 0x3FD0000000000000, 0x1A4FFFFFFF800000, 0x0000000000000000, 0x6570000002000000,
  0x0000000000000000, 1);
assert_eq(load64(&_co6_si2), 0x7FEFFFFFFFFFFFFF,
  "sequential_impulse: a kept term smaller than a dropped msl (CO6: +Inf)");
_co6_si(0x7E3FFFFFFC000000, 0x3FF0000000000000, 0x3870000000000000, 0x0000000000000000, 0x41A0000000000000,
  0x0000000000000000, 1);
assert_eq(load64(&_co6_si2), 0x7FEFFFFFFFFFFFFF,
  "sequential_impulse: the double-double cannot see it: the exact sign must (si_ddonly's kill)");
_co6_si(0x7E1FFFFFFC000000, 0x3FD0000000000000, 0x0000000000000000, 0x0000000000000000, 0x41A0000000000000,
  0x0000000000000000, 1);
assert_eq(load64(&_co6_si2), 0x7FF0000000000000,
  "sequential_impulse: an exact tie at T, an inexact mass sum: +Inf");
_co6_si(0x43B0000000000000, 0x3FE0D97EDE28CA10, 0x3C87178DD38DA17F, 0x7E70000000000000, 0x0000000000000000,
  0xFFE0D97EDE28CA10, 1);
assert_eq(load64(&_co6_si2), 0x43BE62F1283913F7,
  "sequential_impulse: -v_t / M divides by the exact sum: the rounded one reads +Inf (CO6: +Inf)");
assert_eq(load64(&_co6_si2 + 8), 0x7FEFFFFFFFFFFFFF, "sequential_impulse: ... its friction");
_co6_si(0x43B0000000000000, 0x3FE0D97EDE28CA10, 0x3C87178DD38DA17F, 0x7E70000000000000, 0x0000000000000000,
  0xFFE0D97EDE28CA10, 2);
assert_eq(load64(&_co6_si2), 0x43BE62F1283913F7,
  "sequential_impulse: ... at two sweeps");
assert_eq(load64(&_co6_si2 + 8), 0x7FEFFFFFFFFFFFFF, "sequential_impulse: ... its friction");

# === 3.4.1 INS6: einsum's scratch ===
# einsum's scratch is the static _EINSUM_SCRATCH, sized to what one call takes: every call that
# reaches its output tensor takes all 173 slots, whatever the notation, and the heap holds nothing
# but the result. The sum is pinned here against the literal in the declaration, which cannot be
# an expression (cycc 6.6.x reads only a number between the brackets).
test_group("3.4.1 INS6: einsum's scratch");
fn _i6_t22(a, b, c, d) {
    var sh = alloc(16);
    if (sh == 0) { return 0; }
    store64(sh, 2);
    store64(sh + 8, 2);
    var t = tensor_new(2, sh);
    if (t == 0) { return 0; }
    var p = HTensor_data(t);
    store64(p, f64_from(a));
    store64(p + 8, f64_from(b));
    store64(p + 16, f64_from(c));
    store64(p + 24, f64_from(d));
    return t;
}
var _i6_e_ops = alloc(64);
var _i6_e_mm = str_from("ij,jk->ik");
store64(_i6_e_ops, _i6_t22(1, 2, 3, 4));
store64(_i6_e_ops + 8, _i6_t22(5, 6, 7, 8));
var _i6_r0 = einsum(_i6_e_mm, _i6_e_ops, 2);
assert_eq(load64(HTensor_data(_i6_r0) + 24), f64_from(50), "einsum: [[1,2],[3,4]] [[5,6],[7,8]] -> 50 at (1, 1)");
assert_eq(_einsum_top, 173 * 8, "einsum: a matrix product takes the 173 slots _EINSUM_SCRATCH holds");
assert_eq(&_einsum_top - &_EINSUM_SCRATCH, 173 * 8, "_EINSUM_SCRATCH: declared 173 slots (the next global follows it)");
var _i6_r1 = einsum(str_from("ii->"), _i6_e_ops, 1);
assert_eq(load64(HTensor_data(_i6_r1)), f64_from(5), "einsum: the trace -> 5");
assert_eq(_einsum_top, 173 * 8, "einsum: a scalar output takes the same 173");
var _i6_e_ld = alloc(8);
store64(_i6_e_ld, 2);
var _i6_e_t = tensor_new(1, _i6_e_ld);
store64(HTensor_data(_i6_e_t), f64_from(3));
store64(HTensor_data(_i6_e_t) + 8, f64_from(5));
var _i6_e_o8 = alloc(64);
for (var _i6_k = 0; _i6_k < 8; _i6_k = _i6_k + 1) { store64(_i6_e_o8 + _i6_k * 8, _i6_e_t); }
var _i6_r2 = einsum(str_from("i,i,i,i,i,i,i,i->"), _i6_e_o8, 8);
assert_eq(load64(HTensor_data(_i6_r2)), f64_from(397186), "einsum: eight operands -> 3^8 + 5^8 = 397,186");
assert_eq(_einsum_top, 173 * 8, "einsum: eight operands, the module's limit, take the same 173");
var _i6_h1 = alloc_used();
var _i6_r3 = einsum(_i6_e_mm, _i6_e_ops, 2);
var _i6_h2 = alloc_used();
var _i6_r4 = einsum(_i6_e_mm, _i6_e_ops, 2);
var _i6_h3 = alloc_used();
assert_eq(_i6_h2 - _i6_h1, sizeof(HTensor) + 16 + 32, "einsum: a call's heap is its result alone: header, shape, data");
assert_eq(_i6_h3 - _i6_h2, _i6_h2 - _i6_h1, "einsum: ... the same again on the next call");

# === 3.4.1 INS6: a caller's alloc_reset() between calls, module by module ===
# hisab's rule since 3.3.5: no pointer into the bump heap is kept across calls, because a caller's
# alloc_reset() zeroes the first chunk and hands it out again. scripts/check-heap-globals.sh is the
# static half (every module global a pointer can reach is named there, with why it is safe); this
# is the running half, one row per module with lazily built or cached state. Each row is a function
# that makes real public calls on fixtures it builds itself, and returns how many answers differ
# from their closed form or pinned bits. The parent runs every row, so that whatever a row caches
# is cached, and forks; the child (the suite cannot reset its own heap: every fixture above would
# dangle) resets, fills all the heap the suite held with a pattern, and forks one grandchild per row,
# which calls the row again over that heap and reads the pattern back. The child's exit status has
# a bit per row, set where the grandchild's answers were wrong, the pattern changed, or it died.
# The last two rows are the harness's own controls: a kept pointer read back, and one written
# through. Each is a defect planted on purpose, and each must set its bit.
# [measured: lane INS6, this group on this tree and with each kept pointer planted back, s24's arena too; 2026-11-01]
test_group("3.4.1 INS6: a caller's alloc_reset() between calls, module by module");
var _i6_bad = 0;
fn _i6_ne(a, b) {
    if (a != b) { _i6_bad = _i6_bad + 1; }
    return 0;
}
fn _i6_row_einsum() {
    _i6_bad = 0;
    var ops = alloc(16);
    if (ops == 0) { return 1; }
    store64(ops, _i6_t22(1, 2, 3, 4));
    store64(ops + 8, _i6_t22(5, 6, 7, 8));
    var mm = einsum(str_from("ij,jk->ik"), ops, 2);
    var tr = einsum(str_from("ii->"), ops, 1);
    var tp = einsum(str_from("ij->ji"), ops, 1);
    var ip = einsum(str_from("ij,ij->"), ops, 2);
    if (mm == 0 || tr == 0 || tp == 0 || ip == 0) { return 1; }
    _i6_ne(load64(HTensor_data(mm)), f64_from(19));
    _i6_ne(load64(HTensor_data(mm) + 8), f64_from(22));
    _i6_ne(load64(HTensor_data(mm) + 16), f64_from(43));
    _i6_ne(load64(HTensor_data(mm) + 24), f64_from(50));
    _i6_ne(load64(HTensor_data(tr)), f64_from(5));
    _i6_ne(load64(HTensor_data(tp) + 8), f64_from(3));
    _i6_ne(load64(HTensor_data(tp) + 16), f64_from(2));
    _i6_ne(load64(HTensor_data(ip)), f64_from(70));
    return _i6_bad;
}
# Closed forms: P . Q = -|p - q|^2 / 2 for conformal points, S^2 = r^2 for a sphere, n0 . ninf = -1;
# e1 + Inf n0 reads the partner table, where the null n0 pairs with an absent ninf: norm 1, and
# an inverse that keeps the infinity, since a pair that never forms does not make the blade null. A
# wrong partner index reads past the multivector, so the block after it holds ones, not zeros.
fn _i6_row_cga() {
    _i6_bad = 0;
    var f = cga_mv_zero();
    if (f == 0) { return 1; }
    var e1 = cga_mv_clone(f);
    var e2 = cga_mv_clone(f);
    var n0 = cga_mv_clone(f);
    var ni = cga_mv_clone(f);
    cga_mv_set(e1, 1, F64_ONE);
    cga_mv_set(e2, 2, F64_ONE);
    cga_mv_set(n0, 4, F64_ONE);
    cga_mv_set(ni, 5, F64_ONE);
    var p = cga_point(f64_from(1), f64_from(2), f64_from(3));
    var q = cga_point(f64_from(4), f64_from(6), f64_from(3));
    var sp = cga_sphere(f64_from(3), f64_from(4), f64_from(5), F64_TWO);
    _i6_ne(cga_scalar_part(cga_geometric_product(p, q)), f64_neg(0x4029000000000000));
    _i6_ne(cga_scalar_part(cga_geometric_product(n0, ni)), f64_neg(F64_ONE));
    _i6_ne(cga_mv_get(cga_left_contraction(e1, cga_outer_product(e1, e2)), 2), F64_ONE);
    _i6_ne(cga_norm(sp), F64_TWO);
    _i6_ne(cga_norm(p), 0);
    _i6_ne(cga_mv_get(cga_blade_inverse(sp), 1), 0x3FE8000000000000);
    var w = cga_mv_clone(f);
    var past = alloc(2048);
    if (w == 0 || past == 0) { return 1; }
    for (var i = 0; i < 2048; i = i + 8) { store64(past + i, F64_ONE); }
    cga_mv_set(w, 4, F64_POS_INF);
    cga_mv_set(w, 1, F64_ONE);
    _i6_ne(cga_norm(w), F64_ONE);
    var wi = cga_blade_inverse(w);
    if (wi == 0) { return 1; }
    _i6_ne(cga_mv_get(wi, 1), F64_ONE);
    _i6_ne(cga_mv_get(wi, 4), F64_POS_INF);
    return _i6_bad;
}
# Perlin's table and simplex noise's gradients: noise_perm's closed table, and bits the suites pin.
fn _i6_row_noise() {
    _i6_bad = 0;
    _i6_ne(noise_perm(0), 151);
    _i6_ne(noise_perm(255), 180);
    _i6_ne(noise_perm(256), 151);
    _i6_ne(perlin_2d(0x43E5EB851EB851EC, 0x3FD3333333333333), 0x3FD75FF609DCF894);
    _i6_ne(perlin_3d(0x3FE3C6EF372FE950, 0x3FE827F5352054C6, 0x43E5EB851EB851EC), 0xBFBA2E15BF66A71C);
    _i6_ne(simplex_2d(0x43D76CF5D0B09B34, 0xC13BF9FF5E62EBCA), 0xBFD99E8BD9A4B258);
    _i6_ne(simplex_3d(0x43D84C3DD44A9C71, 0x3FEFDA77C518222A, 0xC3930F7512A71C28), 0x3FE8B09F38578571);
    return _i6_bad;
}
# _IVL_SIN_STATE, the verdict on f64_sin: [1.4, 1.8] straddles pi/2, so hi is 1, and lo is the
# nearest double below sin(1.8), 0x3FEF29C281BD15F0 (exact Taylor sum in rationals), widened outward
# by the two steps the module's trusted path takes.
fn _i6_row_interval() {
    _i6_bad = 0;
    var iv = ivl_new(0x3FF6666666666666, 0x3FFCCCCCCCCCCCCD);
    if (iv == 0) { return 1; }
    var s = ivl_sin(iv);
    if (s == 0) { return 1; }
    _i6_ne(Interval_hi(s), F64_ONE);
    _i6_ne(Interval_lo(s), 0x3FEF29C281BD15EE);
    return _i6_bad;
}
# The exact predicates' scratch: the unit square at 2^600, where every sign is taken in integers,
# and at (1e9, 1e9); five collinear multiples of 2^600 and a hull's +93/2^51 sliver, through the
# expansion; the square with a site on an edge, Delaunay's ghost terms.
fn _i6_row_mesh() {
    _i6_bad = 0;
    var o9 = f64_from(1000000000);
    var p6 = (1023 + 600) << 52;
    var sq9 = _co2_sq(o9, o9, F64_ONE);
    var sq6 = _co2_sq(p6, p6, p6);
    if (sq9 == 0 || sq6 == 0) { return 1; }
    _i6_ne(_co2_list(triangulate_polygon(sq9, 4), 6, 3, 0, 1, 3, 1, 2), 1);
    _i6_ne(_co2_list(triangulate_polygon(sq6, 4), 6, 3, 0, 1, 3, 1, 2), 1);
    var cl = vec_new();
    for (var i = 0; i < 5; i = i + 1) { vec_push(cl, hvec2_new(f64_mul(f64_from(i), p6), f64_mul(f64_from(i), p6))); }
    _i6_ne(_co2_list(convex_hull_2d(cl, 5), 2, 0, 4, 0, 0, 0, 0), 1);
    var sl = vec_new();
    vec_push(sl, hvec2_new(0x3FE0000000000077, 0x3FE0000000000096));
    vec_push(sl, hvec2_new(0x4028000000000000, 0x4028000000000000));
    vec_push(sl, hvec2_new(0x4038000000000000, 0x4038000000000000));
    _i6_ne(_co2_list(convex_hull_2d(sl, 3), 3, 0, 1, 2, 0, 0, 0), 1);
    var ed = _co2_sq(0, 0, f64_from(4));
    vec_push(ed, hvec2_new(F64_TWO, 0));
    _i6_ne(_co2_list(delaunay_2d(ed, 5), 9, 1, 2, 4, 2, 3, 4), 1);
    return _i6_bad;
}
# The collision queries' per-query state: whatever each entry saves and restores must read as it did
# before the first query, and in the grandchild the six pointers left behind by design
# (scripts/check-heap-globals.sh says why each is safe) are set between queries to an address
# nothing maps, so that a read before the query's own write dies there. Fixtures from the groups
# above, with the answers they pin; between them they reach every reader the script lists.
var _i6_poison = 0;
fn _i6_ga_after() {
    _i6_ne(_GA_PM, 0);
    _i6_ne(_GA_PM_ON, 0);
    _i6_ne(_GA_SNAP_SM, 0);
    _i6_ne(_GA_SNAP_SMX, 0);
    _i6_ne(_GA_MINK_AXES, 0);
    _i6_ne(_GA_KC_F, 0);
    _i6_ne(_GA_KC_S, 0);
    _i6_ne(_GA_KC_P, 0);
    if (_i6_poison == 1) {
        _GA_MS_PA = 8;
        _GA_MS_PB = 8;
        _GA_RF_P = 8;
        _GA_NEAR_V = 8;
        _GA_NEAR_TETRA = 8;
        _GA_PORTAL_SEPD = 8;
