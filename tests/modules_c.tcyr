assert_eq(load64(_co4_d), 0x3E112E0BC0000000,
  "mpr_penetration: ... at 9.9999997e-10 (3.3.7: 1.0000245e-9) [CO3 order]");

# [3.3.8] Collision: time_of_impact's normal on a box edge and a capsule side is the
# closest-approach direction at the reported t (the 3.3.7 contract, there for corners only):
# a sphere swept head-on onto a rotated box's edge, 2.2e-16 rad from it (3.3.7: 7.1e-6), and
# one onto a capsule's side, 2.4e-16 rad (3.3.7: 9.3e-7).
# [measured: lane CO2 fx/toi.py closest points at the reported t, 60-digit Decimal; 2026-10-31]
var _co4_b6 = _co4_mk(0xBFE100B8B6774EE0, 0x3FEFB8A51DBCB81C, 0xBFAE733E3AC15E40, 0x3FE0A1CEEB73F1EF,
  0x3FFC1968F8685ED5, 0x3FEC72F12F4E0154, 0x3FAF0C9C39DB80B1, 0x3FE99CF707B8443C, 0xBFE3158457F4E033,
  0x3FEDFCA390E29724, 0xBFD0177B9A1E5B84, 0xBFCEFF48447C3B12, 0xBFD6008179978AED,
  0xBFE169DCD9A4B288, 0xBFE87D5F9CB79D37);
var _co4_s6 = hvec4_new(0xBFA4360F118107C0, 0x401640DC4F66865F, 0xBFE23F46B480181E, 0x3FEC56345D23935C);
assert_eq(time_of_impact(&_co4_sup_obb, _co4_b6, hvec3_zero(), &_co4_sup_sph, _co4_s6,
    hvec3_new(0xBFC96BCDB154BB32, 0xBFF065A429EDD108, 0x3FD2E9C3E21EDE52), f64_from(10), _co4_t, _co4_n), 1,
  "time_of_impact: a sphere swept onto a box edge hits");
assert_eq(load64(_co4_t), 0x4005072A02DC0DBF, "time_of_impact: ... at the same t as 3.3.7");
assert_eq(_co4_nx(), 0x3FC76E80158CC173,
  "time_of_impact: ... normal x, 2.2e-16 rad off (pre-review ...C171; 3.3.7: 7.1e-6 rad)");
assert_eq(_co4_ny(), 0x3FEE3A43B976BE07, "time_of_impact: ... normal y (3.3.7: 0x3FEE3A46DB019EC6)");
assert_eq(_co4_nz(), 0xBFD16ED8C7CC2AB8, "time_of_impact: ... normal z (3.3.7: 0xBFD16EBD22291712)");
var _co4_c7 = _co4_mk(0xBFEBCE600B27BB70, 0xBFEF284170BABD6C, 0x3FE59917EBC0FCE2, 0x3FB05074A4847424,
  0x3FEAEA7B1708030F, 0xBFE40E0403EE8EF1, 0x3FDA143476B99B05, 0, 0, 0, 0, 0, 0, 0, 0);
var _co4_s7 = hvec4_new(0x3FF59BAADFED7B9A, 0xBFF93182E3EE4790, 0xBFEE8696454FED78, 0x3FD8CC3907A08DB4);
assert_eq(time_of_impact(&_co4_sup_cap, _co4_c7, hvec3_zero(), &_co4_sup_sph, _co4_s7,
    hvec3_new(0xBFF2877F1BE5E08E, 0x3FE2B4DA963FED69, 0x3FE55689AFD67646), f64_from(10), _co4_t, _co4_n), 1,
  "time_of_impact: a sphere swept onto a capsule's side hits");
assert_eq(load64(_co4_t), 0x3FF56B8711075A89, "time_of_impact: ... at the same t as 3.3.7");
assert_eq(_co4_nx(), 0x3FE9682ADEC1EE66, "time_of_impact: ... normal x (3.3.7: 0x3FE9682C0CED6036, 9.3e-7 rad off)");
assert_eq(_co4_ny(), 0xBFD9A65C3F4D2A85, "time_of_impact: ... normal y (pre-review ...2A83)");
assert_eq(_co4_nz(), 0xBFDD421978531CF6, "time_of_impact: ... normal z, 2.4e-16 rad off (pre-review ...1CF7)");
# Two unit boxes sliding one over the other with the gap 2^-40: at the reported t the support
# along the normal (0, +1, 0) is the middle of an edge of A (-) B, every tilt moves it by half
# an edge, and a ball of radius |J| / t would move it the same: rho is read off two tilts
# along one direction (_ga_snap), 0 here, and the face's own normal stands.
var _co4_ub = _mpr_mkbox(0, 0, 0, F64_ONE, F64_ONE, F64_ONE);
assert_eq(time_of_impact(&_mpr_sup_box, _co4_ub, hvec3_zero(), &_mpr_sup_box,
    _mpr_mkbox(f64_from(5), f64_add(F64_TWO, 0x3D70000000000000), 0, F64_ONE, F64_ONE, F64_ONE),
    hvec3_new(f64_neg(F64_ONE), 0, 0), f64_from(10), _co4_t, _co4_n), 1,
  "time_of_impact: a unit box sliding over a unit box hits");
assert_eq(_co4_ny(), F64_ONE,
  "time_of_impact: ... normal (0, +1, 0) (a ball's reading of the tie: (9.8e-4, 0.9999995, 0))");
assert_eq(f64_eq(_co4_nx(), 0), 1, "time_of_impact: ... x is 0 (its sign incidental)");

# [3.3.8] Collision: at coordinates about 1e3 an end cap 1.2758e-12 (exact) into a sphere,
# below the proof margin there (1.4e-11): 3.3.7 answered a miss from gjk_* and a contact from
# mpr_*; the overlap is real, and the band (a certain containment, no plane parting the pair
# by more than 2^-46 of the span) makes it a contact from all four, in both orders.
# [measured: lane-CO r1.py, r23.py, pick.py, pick2.py, cornw.py, exact oracles, 3.3.7 base and this tree, 2026-10-31]
var _co4_c8 = _co4_mk(0x408F3F9EAA73E7F5, 0x408F40ED2305FFD8, 0x408F41C8052E79C2, 0x3FC0E6461D322E79,
  0xBFDA818DD23C8AB8, 0x3FABD1AFE1E295F2, 0x3FD43F8609F52BEA, 0, 0, 0, 0, 0, 0, 0, 0);
var _co4_s8 = hvec4_new(0x408F377F3B764276, 0x408F4656DB1DCE83, 0x408F3DD4D05E5481, 0x3FE68B6E821D9708);
assert_eq(gjk_intersect_3d(&_co4_sup_cap, _co4_c8, &_co4_sup_sph, _co4_s8), 1,
  "gjk_intersect_3d: an end cap 1.28e-12 into a sphere at 1e3 is a contact (3.3.7: a miss)");
assert_eq(gjk_intersect_3d(&_co4_sup_sph, _co4_s8, &_co4_sup_cap, _co4_c8), 1,
  "gjk_intersect_3d: ... in the other order (3.3.7: a miss)");
assert_eq(gjk_epa_3d(&_co4_sup_cap, _co4_c8, &_co4_sup_sph, _co4_s8, _co4_n, _co4_d), 1,
  "gjk_epa_3d: ... a contact (3.3.7: a miss)");
assert_eq(mpr_intersect(&_co4_sup_cap, _co4_c8, &_co4_sup_sph, _co4_s8), 1,
  "mpr_intersect: ... a contact, as in 3.3.7");
assert_eq(mpr_penetration(&_co4_sup_sph, _co4_s8, &_co4_sup_cap, _co4_c8, _co4_n, _co4_d), 1,
  "mpr_penetration: ... a contact, as in 3.3.7");
# And a capsule side 1.3469e-12 (exact) from a sphere there: mpr_* called it a contact, capsule
# first (its portal kept); all four now refute it.
# [measured: lane-CO r1.py, r23.py, pick.py, pick2.py, cornw.py, exact oracles, 3.3.7 base and this tree, 2026-10-31]
var _co4_c9 = _co4_mk(0x408F43932D587C82, 0x408F3F62358F70E3, 0x408F3CED9417D831, 0xBFE0260DE97783FC,
  0x3FCED78635A04A62, 0xBFF62C2E1660B1FE, 0x3FEF02E183D5333A, 0, 0, 0, 0, 0, 0, 0, 0);
var _co4_s9 = hvec4_new(0x408F3AE62075073E, 0x408F43C302DA41C5, 0x408F4152E5DC9C50, 0x3FD73B8EB26FC532);
assert_eq(mpr_intersect(&_co4_sup_cap, _co4_c9, &_co4_sup_sph, _co4_s9), 0,
  "mpr_intersect: a capsule side 1.35e-12 from a sphere at 1e3 is a miss (3.3.7: a contact)");
assert_eq(mpr_penetration(&_co4_sup_cap, _co4_c9, &_co4_sup_sph, _co4_s9, _co4_n, _co4_d), 0,
  "mpr_penetration: ... a miss (3.3.7: a contact)");
assert_eq(gjk_intersect_3d(&_co4_sup_cap, _co4_c9, &_co4_sup_sph, _co4_s9), 0,
  "gjk_intersect_3d: ... a miss, as in 3.3.7");

# A sphere 6.5754e-13 (exact) into a box edge at unit scale: 3.3.7's gjk_* answered a miss and
# mpr_* a contact, box first. A ring of supports round the normal EPA measured holds the origin
# for certain (_ga_ring_proves' second level), and nothing parts the pair: a contact from all
# four, both orders.
# [measured: lane-CO r1.py, r23.py, pick.py, pick2.py, cornw.py, exact oracles, 3.3.7 base and this tree, 2026-10-31]
var _co4_b11 = _co4_mk(0x3FEAECFF4F520828, 0xBFEA59575426C648, 0xBFE4593162E60A92, 0x3FEAC282CA32FB6E,
  0x3FF850974ED197BA, 0x3FF90B1F567073A0, 0x3FEAC0FD87403BBB, 0x3FE07638A608DD2D, 0x3FC868E23AEF0B34,
  0x3FC1CC68802865BE, 0xBFE11E151DC5A8C7, 0x3FEAAB0DC5ECD320, 0x3FE0FBB7833339CE,
  0xBFE57296840D82A3, 0xBFE099AAA5F2B0C2);
var _co4_s11 = hvec4_new(0x4005F283811B0FD8, 0xBFF037B631DCD5F9, 0xC004405F9D47B0C1, 0x3FE41B9132562687);
assert_eq(gjk_intersect_3d(&_co4_sup_obb, _co4_b11, &_co4_sup_sph, _co4_s11), 1,
  "gjk_intersect_3d: a sphere 6.6e-13 into a box edge is a contact (3.3.7: a miss)");
assert_eq(gjk_epa_3d(&_co4_sup_obb, _co4_b11, &_co4_sup_sph, _co4_s11, _co4_n, _co4_d), 1,
  "gjk_epa_3d: ... a contact (3.3.7: a miss)");
assert_eq(mpr_intersect(&_co4_sup_obb, _co4_b11, &_co4_sup_sph, _co4_s11), 1,
  "mpr_intersect: ... a contact, as in 3.3.7");
# A capsule side 6.28e-14 (exact) from a sphere at 1e3, below an ulp of the coordinates (1.1e-13):
# a miss from all four, as the exact geometry has it; mpr_* without the band's refutation would
# keep its portal.
# ⭐ 3.4.0 (lane CO3): 0.0044 of the contract's eps there, and the portal GJK asks at round 8 holds
# the origin for certain: a contact from all four, as the contract allows inside the band.
# [measured: lane CO3 fixchk3.py (review-CO orc.py, exact), this tree; 2026-10-31]
# [measured: lane-CO r1.py, r23.py, pick.py, pick2.py, cornw.py, exact oracles, 3.3.7 base and this tree, 2026-10-31]
var _co4_c12 = _co4_mk(0x408F40D6EB641637, 0x408F3BCD633F6A3C, 0x408F3DED75AFB3E4, 0x3FC1E3363989E4E3,
  0x3FE3EF7158F94D80, 0xBFB8A27D973D3AA2, 0x3FDB482C4A3E4E00, 0, 0, 0, 0, 0, 0, 0, 0);
var _co4_s12 = hvec4_new(0x408F3BD994229436, 0x408F3AF7F16E8E2A, 0x408F43862519D399, 0x3FDD03E21C5311D8);
assert_eq(mpr_intersect(&_co4_sup_cap, _co4_c12, &_co4_sup_sph, _co4_s12), 1,
  "mpr_intersect: a capsule side 6.3e-14 from a sphere at 1e3, in the band, a contact (lane CO2: 0)");
assert_eq(mpr_penetration(&_co4_sup_cap, _co4_c12, &_co4_sup_sph, _co4_s12, _co4_n, _co4_d), 1,
  "mpr_penetration: ... a contact (lane CO2: 0)");
assert_eq(gjk_intersect_3d(&_co4_sup_cap, _co4_c12, &_co4_sup_sph, _co4_s12), 1,
  "gjk_intersect_3d: ... a contact (lane CO2: 0)");

# [3.3.8] Numerics: _toi_outside_plane compared the origin's and d's sides of plane (a, b, c)
# through f64_gt(sp * sd, 0); for this tetrahedron, 2e-170 thick and holding the origin,
# sp = 4e-170 and sd = 8e-170 multiply to 0 and the face read as one the origin lies outside
# of, so the distance query answered the face point (0, 0, -1e-170) for an origin inside.
var _co4_pa = hvec3_new(f64_neg(F64_ONE), f64_neg(F64_ONE), 0x9CBDA3AC2C7EA75B);
var _co4_pb = hvec3_new(F64_ONE, f64_neg(F64_ONE), 0x9CBDA3AC2C7EA75B);
var _co4_pc = hvec3_new(0, F64_ONE, 0x9CBDA3AC2C7EA75B);
var _co4_pd = hvec3_new(0, 0, 0x1CBDA3AC2C7EA75B);
assert_eq(_toi_outside_plane(_co4_pa, _co4_pb, _co4_pc, _co4_pd), 0,
  "_toi_outside_plane: the origin and d on one side, 4e-170 and 8e-170 off the plane (3.3.7: outside)");
var _co4_mk8 = alloc(8);
_toi_tetra_closest(_co4_pa, _co4_pb, _co4_pc, _co4_pd, _co4_mk8);
assert_eq(load64(_co4_mk8), 15,
  "_toi_tetra_closest: ... so the origin is inside the tetrahedron (3.3.7: mask 7, face abc)");

# [3.3.8] Instruments: the cycling path's refutation along its portal's EPA normal parts the pair
# only on a support value strictly below zero. Two unit boxes touching at x = 2 have h(+x)
# exactly 0, a supporting plane through the origin: a touch, which is a contact (2.9.0), and
# "h <= 0" would refute it. 0.5 further apart, h(+x) = -0.5 parts them.
assert_eq(_ga_plane_parts(&_mpr_sup_box, _co4_ub, &_mpr_sup_box, _mpr_mkbox(F64_TWO, 0, 0, F64_ONE, F64_ONE, F64_ONE),
    hvec3_unit_x()), 0, "_ga_plane_parts: a plane through the origin that supports A (-) B parts nothing (h = 0)");
assert_eq(_ga_plane_parts(&_mpr_sup_box, _co4_ub, &_mpr_sup_box,
    _mpr_mkbox(f64_div(f64_from(5), F64_TWO), 0, 0, F64_ONE, F64_ONE, F64_ONE), hvec3_unit_x()), 1,
  "_ga_plane_parts: ... and 0.5 apart, h(+x) = -0.5 parts them (control)");

# [3.4.0] Contract: a support noisier than 2^-46 of the coordinates. A sphere support taken
# through K = 2^20 rounds by about ulp(2^20) = 2.3e-10 absolute; spheres 1.0e-9 of their radii
# apart (well above that) are a miss to all four, and the same pair 1.2e-9 deep a contact.
var _co4_k = 0x4130000000000000;  # 2^20
var _co4_sa = alloc(40);
var _co4_sb = alloc(40);
store64(_co4_sa, 0x3FC999999999999A);
store64(_co4_sa + 8, 0xBFB999999999999A);
store64(_co4_sa + 16, 0x3FD3333333333333);
store64(_co4_sa + 24, F64_ONE); store64(_co4_sa + 32, _co4_k);
store64(_co4_sb, 0x3FF1999999D77291);
store64(_co4_sb + 8, 0x3FEB851EB8D5DC84);
store64(_co4_sb + 16, 0x3FF051EB855032B1);
store64(_co4_sb + 24, F64_HALF); store64(_co4_sb + 32, _co4_k);
assert_eq(gjk_intersect_3d(&_co4_sup_slop, _co4_sa, &_co4_sup_slop, _co4_sb), 0,
  "gjk_intersect_3d: K-noisy spheres 1.4999999e-9 apart (6.5 times the noise) are a miss");
assert_eq(gjk_epa_3d(&_co4_sup_slop, _co4_sb, &_co4_sup_slop, _co4_sa, _co4_n, _co4_d), 0, "gjk_epa_3d: ... a miss");
assert_eq(mpr_intersect(&_co4_sup_slop, _co4_sa, &_co4_sup_slop, _co4_sb), 0, "mpr_intersect: ... a miss");
assert_eq(mpr_penetration(&_co4_sup_slop, _co4_sb, &_co4_sup_slop, _co4_sa, _co4_n, _co4_d), 0,
  "mpr_penetration: ... a miss");
store64(_co4_sb, 0x3FF19999994F620A);
store64(_co4_sb + 8, 0x3FEB851EB7B39720);
store64(_co4_sb + 16, 0x3FF051EB84E358AC);
assert_eq(gjk_intersect_3d(&_co4_sup_slop, _co4_sa, &_co4_sup_slop, _co4_sb), 1,
  "gjk_intersect_3d: ... and 1.8e-9 deep, a contact (control)");
assert_eq(mpr_intersect(&_co4_sup_slop, _co4_sb, &_co4_sup_slop, _co4_sa), 1, "mpr_intersect: ... a contact (control)");

# The unchecked allocations of geo_advanced.cyr (the roadmap's 238-site row, this file's
# share): each is checked and answers its function's designed refusal. Reached as the 3.3.5
# group in tests/modules_b.tcyr reaches the others, by lowering ALLOC_MAX past the size:
# GJK's 40-byte simplex refused is an exit with no certificate (3.3.7 stored through the null
# pointer: a fault); since the lane review gjk_intersect_3d's portal path, whose buffers are 32
# bytes at most, proves the contact, and gjk_epa_3d, whose EPA needs more, answers its 0,
# and a 256-byte multivector refused is the 0 handle from cga_mv_zero, cga_point and
# cga_geometric_product (3.3.7: a fault in each).
# [measured: lane-CO r1.py, r23.py, pick.py, pick2.py, cornw.py, exact oracles, 3.3.7 base and this tree, 2026-10-31]
var _co4_keep = ALLOC_MAX;
var _co4_ga = hvec4_new(0, 0, 0, F64_ONE);
var _co4_gb = hvec4_new(F64_HALF, 0, 0, F64_ONE);
var _co4_cp = cga_point(F64_ONE, F64_TWO, 0);
ALLOC_MAX = 39;
var _co4_r1 = gjk_intersect_3d(&_mpr_sup_sphere, _co4_ga, &_mpr_sup_sphere, _co4_gb);
var _co4_r2 = gjk_epa_3d(&_mpr_sup_sphere, _co4_ga, &_mpr_sup_sphere, _co4_gb, _co4_n, _co4_d);
ALLOC_MAX = 255;
var _co4_m1 = cga_mv_zero();
var _co4_m2 = cga_point(F64_ONE, 0, 0);
var _co4_m3 = cga_geometric_product(_co4_cp, _co4_cp);
var _co4_m4 = cga_mv_add(_co4_cp, _co4_cp);
ALLOC_MAX = _co4_keep;
# (3.4.1 lane INS5: this read 1, the portal's path finding the contact. A query past a refused
# request can no longer say "apart" (a refused test reads as no proof of it), and the sweep found
# gjk_intersect_3d answering a contact for a miss at 5 points that way, so every refusal is now the
# designed 0: the pair's contact is the control below the block.)
assert_eq(_co4_r1, 0, "gjk_intersect_3d: its 40-byte simplex refused: the designed 0 (3.3.7: a fault)");
assert_eq(_co4_r2, 0, "gjk_epa_3d: ... the designed 0 (3.3.7: a fault)");
assert_eq(HVec3_x(load64(_co4_n)), F64_ONE, "gjk_epa_3d: ... with the unit_x placeholder");
assert_eq(_co4_m1, 0, "cga_mv_zero: a refused multivector is the 0 handle (3.3.7: a fault)");
assert_eq(_co4_m2, 0, "cga_point: ... the 0 handle (3.3.7: a fault)");
assert_eq(_co4_m3, 0, "cga_geometric_product: ... the 0 handle (3.3.7: a fault)");
assert_eq(_co4_m4, 0, "cga_mv_add: ... the 0 handle (3.3.7: a fault)");
assert_eq(gjk_intersect_3d(&_mpr_sup_sphere, _co4_ga, &_mpr_sup_sphere, _co4_gb), 1, "control: the pair overlaps");
assert_neq(cga_mv_zero(), 0, "control: a multivector is allocated");

# === 3.4.0: collision -- the lane review: exact orientation, one band for GJK and MPR, the edge snap's conditioning ===
test_group("3.4.0 collision (lane review): exact orientation, one band, the snap's conditioning");
# _ga_det_sign's underflow term bounds the products it multiplies, the z column: rows
# a = (0, 2^-536, 0), b = (2^-41, 0, 2^500), c = (2^-540, 0, 1) have det +2^-577 exactly, and
# cx ay = 2^-1076 flushes to 0 before bz = 2^500 multiplies it (through the lane review the
# term read the first row, and the filter answered a certain -1).
# [measured: review-CO fz_det.py / fz_tet.py / tet_attack.py (seeds 1-3), lane CO2 rd_wb; 2026-10-31]
assert_eq(_ga_det_sign(0, 0x1E70000000000000, 0, 0x3D60000000000000, 0, 0x5F30000000000000, 0x1E30000000000000, 0,
    F64_ONE), 0, "_ga_det_sign: det +2^-577 under an underflowed product is not certain (the lane's first round: -1)");
assert_eq(_ga_det_exact(0, 0x1E70000000000000, 0, 0x3D60000000000000, 0, 0x5F30000000000000, 0x1E30000000000000, 0,
    F64_ONE), 2, "_ga_det_exact: ... and an entry 2^-541 below its row's largest is beyond exactness (2)");
# Rows (1, 1, 1), (1, 1 + 2^-52, 1), (1, 1, 1 + 2^-52): det 2^-104, far below the filter's
# 2^-49 of the permanent; the expansion has it exactly, and swapping two rows turns it.
assert_eq(_ga_det_sign(F64_ONE, F64_ONE, F64_ONE, F64_ONE, 0x3FF0000000000001, F64_ONE, F64_ONE, F64_ONE,
    0x3FF0000000000001), 0, "_ga_det_sign: det 2^-104 is not certain to the filter");
assert_eq(_ga_det_exact(F64_ONE, F64_ONE, F64_ONE, F64_ONE, 0x3FF0000000000001, F64_ONE, F64_ONE, F64_ONE,
    0x3FF0000000000001), 1, "_ga_det_exact: ... its exact sign is +1");
assert_eq(_ga_det_exact(F64_ONE, 0x3FF0000000000001, F64_ONE, F64_ONE, F64_ONE, F64_ONE, F64_ONE, F64_ONE,
    0x3FF0000000000001), 0 - 1, "_ga_det_exact: ... and -1 with two rows swapped");
assert_eq(_ga_det_exact(F64_ONE, 0, 0, 0, F64_ONE, 0, F64_ONE, F64_ONE, 0), 0,
  "_ga_det_exact: an exactly singular matrix is an exact 0");
assert_eq(_ga_det_exact(F64_ONE, 0x3000000000000000, 0, 0, F64_ONE, 0, 0, 0, F64_ONE), 2,
  "_ga_det_exact: an entry 2^-255 below its row's largest cannot be had exactly (2)");
# One of the reviewer's 30 constructed tetrahedra: exact barycentric signs (+, -, -, -), the
# origin outside, and the first-row term certified it holding the origin.
assert_eq(_ga_tetra_certain4(hvec3_new(0x26B061FBB6D71232, 0x38ABDA8923E7D015, 0xB0B27B277E63ACAF),
    hvec3_new(0x9F99223598C006C8, 0x9F94E478F31B0D65, 0x00000026233241A9),
    hvec3_new(0x1F94B91CE3618240, 0x1F7C511AFEBB6A18, 0x45B3D69FE34DD719),
    hvec3_new(0x1F459F7F89CAD13A, 0x1F80ED9C5F5C8437, 0xC5AEE6617B1A94E1)), 0,
  "_ga_tetra_certain4: a tetrahedron with the origin outside is not a containment (the lane's first round: 1)");

# GJK's float enclosure is checked exactly, and where the origin lies outside one face GJK
# goes on from it (_ga_tetra_exit): the reviewer's M3 pair, a ball of radius 9.9e-7 1e-11
# (486 eps) into a box edge, was a miss from all four entry points in the lane's first round
# (3.3.7: a contact, from that same wrong enclosure). Its simplex's exact signs are
# (+, -, +, +): vertex 1 is dropped.
# [measured: review-CO M3 pair, lane CO2 exin.py (Fractions) and rh.py; 2026-10-31]
var _cr_w = alloc(40);
store64(_cr_w, hvec3_new(0xBF8FD34A37788800, 0x3FCFA791A90C2418, 0x3FB51FD46B590AF8));
store64(_cr_w + 8, hvec3_new(0x3FB201114E612230, 0xBFF1E8557A8F4A1D, 0xBFD7E69CADE415B6));
store64(_cr_w + 16, hvec3_new(0xBF8FD34CCC5D5800, 0x3FCFA7919FD64D8A, 0x3FB51FD492FF11B0));
store64(_cr_w + 24, hvec3_new(0x3FB2011193758E60, 0xBFF1E855799CEEDD, 0xBFD7E69CB5FCD742));
store64(_cr_w + 32, 4);
var _cr_v1 = load64(_cr_w + 8);
var _cr_dir = alloc(8);
assert_eq(_ga_tetra_certain(_cr_w), 0, "_ga_tetra_certain: the M3 pair's GJK simplex does not hold the origin");
