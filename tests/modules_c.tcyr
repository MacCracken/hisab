var _cr_kept = 1;
for (var _cr_i = 0; _cr_i < 3; _cr_i = _cr_i + 1) { if (load64(_cr_w + _cr_i * 8) == _cr_v1) { _cr_kept = 0; } }
assert_eq(_cr_kept, 1, "_ga_tetra_exit: ... without vertex 1");
var _cr_b3 = _co4_mk(0, 0x8000000000000000, 0, 0x3FEC532D831CD2EC, 0x3FF12BBF5E6E46F4, 0x3FE7171EA8B00655,
  0x3FEE58938B237FC8, 0x3FC383A8F7DDF654, 0xBFD1CFF46D2CFD97, 0x3FD3F30D5B7AB55C, 0xBFD21DB47744531C,
  0x3FED066E1C28AA16, 0x3FAE76EA3C07C990, 0xBFEE4D0FAB073138, 0xBFD43897783528CC);
