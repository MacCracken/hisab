# The controls: a cache kept the way the rule forbids. The first answers from it, the second
# writes through it, so that one can only fail on its answer and the other on the pattern.
var _i6_kept_r = 0;
var _i6_kept_w = 0;
fn _i6_row_ctl_read() {
    if (_i6_kept_r == 0) {
        _i6_kept_r = alloc(8);
        store64(_i6_kept_r, 0x1234);
    }
    if (load64(_i6_kept_r) != 0x1234) { return 1; }
    return 0;
}
fn _i6_row_ctl_write() {
    if (_i6_kept_w == 0) { _i6_kept_w = alloc(8); }
    store64(_i6_kept_w, 0x1234);
    return 0;
}
var _i6_rows: i64[8];
store64(&_i6_rows, &_i6_row_einsum);
store64(&_i6_rows + 8, &_i6_row_cga);
store64(&_i6_rows + 16, &_i6_row_noise);
store64(&_i6_rows + 24, &_i6_row_interval);
store64(&_i6_rows + 32, &_i6_row_mesh);
store64(&_i6_rows + 40, &_i6_row_gjk);
store64(&_i6_rows + 48, &_i6_row_ctl_read);
store64(&_i6_rows + 56, &_i6_row_ctl_write);
var _i6_fill = 0;
var _i6_size = 0;
# The grandchild: 0 where the row's answers are right and the pattern intact.
fn _i6_row_run(fp) {
    var code = 0;
    _i6_poison = 1;
    if (fncall0(fp) != 0) { code = 1; }
    for (var i = 0; i < _i6_size; i = i + 8) {
        if (load64(_i6_fill + i) != 0xA5A5_5A5A_A5A5_5A5A) { code = code | 2; }
    }
    sys_exit_group(code);
    return 0;
}
# The child: 1 << k for each row k that did not come back clean.
fn _i6_child() {
    alloc_reset();
    _i6_fill = alloc(_i6_size);
    if (_i6_fill == 0) { sys_exit_group(255); }
    for (var i = 0; i < _i6_size; i = i + 8) { store64(_i6_fill + i, 0xA5A5_5A5A_A5A5_5A5A); }
    var bits = 0;
    for (var k = 0; k < 8; k = k + 1) {
        var pid = sys_fork();
        if (pid == 0) { _i6_row_run(load64(&_i6_rows + k * 8)); }
        var st: i64[1];
        store64(&st, 0 - 1);
        if (pid > 0) { sys_waitpid(pid, &st, 0); }
        if ((load64(&st) & 0xFFFF) != 0) { bits = bits | (1 << k); }
    }
    sys_exit_group(bits);
    return 0;
}
assert_eq(_i6_row_einsum(), 0, "alloc_reset: einsum right before the reset");
assert_eq(_i6_row_cga(), 0, "alloc_reset: CGA right before the reset");
assert_eq(_i6_row_noise(), 0, "alloc_reset: noise right before the reset");
assert_eq(_i6_row_interval(), 0, "alloc_reset: ivl_sin right before the reset");
assert_eq(_i6_row_mesh(), 0, "alloc_reset: hull, triangulation and Delaunay right before the reset");
assert_eq(_i6_row_gjk(), 0, "alloc_reset: the five collision entries right before the reset");
assert_eq(_i6_row_ctl_read(), 0, "alloc_reset: control, a kept pointer reads back before the reset");
assert_eq(_i6_row_ctl_write(), 0, "alloc_reset: control, a kept pointer writes before the reset");
_i6_size = alloc_used();
if (_i6_size > 256 * 1024 * 1024) { _i6_size = 256 * 1024 * 1024; }
var _i6_pid = sys_fork();
if (_i6_pid == 0) { _i6_child(); }
var _i6_st: i64[1];
store64(&_i6_st, 0 - 1);
if (_i6_pid > 0) { sys_waitpid(_i6_pid, &_i6_st, 0); }
var _i6_bits = (load64(&_i6_st) >> 8) & 0xFF;
assert_eq(_i6_pid > 0, 1, "alloc_reset: the child process started");
assert_eq(load64(&_i6_st) & 0x7F, 0, "alloc_reset: the child ran to its exit (no signal)");
assert_eq(_i6_size > 4096, 1, "alloc_reset: the fill covers the heap the suite used");
assert_eq(_i6_bits & 1, 0, "alloc_reset: einsum right and the pattern intact (3.4.1-dev: SIGSEGV)");
assert_eq((_i6_bits >> 1) & 1, 0, "alloc_reset: CGA products, norms and inverse right, the pattern intact");
assert_eq((_i6_bits >> 2) & 1, 0, "alloc_reset: Perlin and simplex noise right, the pattern intact");
assert_eq((_i6_bits >> 3) & 1, 0, "alloc_reset: ivl_sin right, the pattern intact");
assert_eq((_i6_bits >> 4) & 1, 0, "alloc_reset: hull, triangulation and Delaunay right, the pattern intact");
assert_eq((_i6_bits >> 5) & 1, 0, "alloc_reset: the five collision entries right, the pattern intact");
assert_eq((_i6_bits >> 6) & 1, 1, "alloc_reset: control, a pointer kept and read is caught by its answer");
assert_eq((_i6_bits >> 7) & 1, 1, "alloc_reset: control, a pointer kept and written through is caught by the pattern");

var r = assert_summary();
# Clamp before exiting: assert_summary() returns the raw failure COUNT, and a wait
# status is only 8 bits — an unclamped 256 / 512 / 768 failures would wrap to status 0 and
# score PASS. Any failure at all becomes status 1.
if (r > 0) { r = 1; }
sys_exit_group(r);
