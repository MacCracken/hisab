# ~1e-8 — for assertions on transcendental / iterative results where exact
# bit equality is not achievable but 8 significant digits is.
var LOOSE_TOL_M = 0x3E45798EE2308C3A;
# ~1e-15 -- a few ulp of 1.0, for order-1 quantities with a closed form
# (group-inverse round-trips, traceless generators, Euler's identity, cot(pi/3)).
# Replaces a literal f64_from(1), which is a tolerance of 1.0 and admits
# everything in [0, 2]. 2.7.0 measured the floor of its 12 sites at <= 2.3e-16 on
# 6.5.6. Re-measured on 6.6.12 over the 24 sites now, by swapping this constant:
# all pass at 2^-52 + 1 ulp (~2.2e-16) and 3 fail at 2^-53 + 1 ulp, so the floor
# still sits at or below 2^-52.
# [measured: scratch harness, ULP_TOL_M swapped, not reproducible in-tree, 2026-09-30; cycc 6.6.12]
var ULP_TOL_M = 0x3CD203AF9EE75616;
var TOL_1EM14 = 0x3D06849B86A12B9B;  # 1e-14

# 3.4.0: calc_monotone_cubic, calc_hermite_tcb and calc_adaptive_simpson are retired. These
# read their _checked replacements: _cmc / _ctcb / _cas return the value written to `out`,
# a signalling NaN no Ok value has when the call refuses (so no value assertion can pass
# on a refusal), and _cmc_err the refusal's code (0 for Ok).
var _C34_OUT = alloc(8);
fn _cmc(xs, ys, n, x) {
    store64(_C34_OUT, 0x7FF4000000000001);
    var t, v = calc_monotone_cubic_checked(xs, ys, n, x, _C34_OUT);
    return load64(_C34_OUT);
}
fn _cmc_err(xs, ys, n, x) {
    var t, v = calc_monotone_cubic_checked(xs, ys, n, x, _C34_OUT);
    if (is_ok(t) == 1) { return 0; }
    return v;
}
fn _ctcb(times, values, n, tension, continuity, bias, t) {
    store64(_C34_OUT, 0x7FF4000000000001);
    var ht, hv = calc_hermite_tcb_checked(times, values, n, tension, continuity, bias, t, _C34_OUT);
    return load64(_C34_OUT);
}
var _CAS_T = 0;
fn _cas(f, a, b, tol) {
    store64(_C34_OUT, 0x7FF4000000000001);
    var at, av = calc_adaptive_simpson_checked(f, a, b, tol, _C34_OUT);
    _CAS_T = at;
    return load64(_C34_OUT);
}

# MPR support functions. Sphere: shape = HVec4 (cx,cy,cz, radius);
# support(dir) = center + radius * normalize(dir).
fn _mpr_sup_sphere(shape, dir) {
    var c = hvec3_new(HVec4_x(shape), HVec4_y(shape), HVec4_z(shape));
    var dn = hvec3_normalize(dir);
    return hvec3_add(c, hvec3_scale(dn, HVec4_w(shape)));
}

# Axis-aligned box: shape = 6 f64 [cx,cy,cz, hx,hy,hz]; per-axis far corner.
fn _mpr_box_axis(c, h, d) {
    if (f64_lt(d, 0) == 1) { return f64_sub(c, h); }
    return f64_add(c, h);
}
fn _mpr_sup_box(shape, dir) {
    var rx = _mpr_box_axis(load64(shape), load64(shape + 24), HVec3_x(dir));
    var ry = _mpr_box_axis(load64(shape + 8), load64(shape + 32), HVec3_y(dir));
    var rz = _mpr_box_axis(load64(shape + 16), load64(shape + 40), HVec3_z(dir));
    return hvec3_new(rx, ry, rz);
}
fn _mpr_mkbox(cx, cy, cz, hx, hy, hz) {
    var s = alloc(48);
    store64(s, cx);
    store64(s + 8, cy);
    store64(s + 16, cz);
    store64(s + 24, hx);
    store64(s + 32, hy);
    store64(s + 40, hz);
    return s;
}

alloc_init();

# The NaN helper the groups below share (moved from modules_b.tcyr; modules.tcyr has its own).
var _g6_nan = 0x7FF8000000000000;

fn _g6_nan3(v) {
    var c = 0;
    if (f64_eq(HVec3_x(v), HVec3_x(v)) == 0) { c = c + 1; }
    if (f64_eq(HVec3_y(v), HVec3_y(v)) == 0) { c = c + 1; }
    if (f64_eq(HVec3_z(v), HVec3_z(v)) == 0) { c = c + 1; }
    return c;
}

# === 3.3.5: perlin cell index past 2^63 ===
test_group("3.3.5: perlin_2d / perlin_3d past 2^63, 256-periodic on every toolchain");
# A double of magnitude 2^63 or more is a multiple of 2048, so its cell is 0 mod 256 and
# its fractional part is 0: the field there is the field at 0. Through 3.3.4 the cell
# went through f64_to, which from cycc 6.6.8 saturates a positive one to i64 max,
# residue 255 (6.6.3 to 6.6.7: i64 min, residue 0). Expected bits from a python3 perlin
# with exact integer cells (it gives the noise group's four reference values, in
# modules_b.tcyr, bit for bit); each
# message gives the 3.3.4 code's value on 6.6.14, and 6.6.3 returns the expected bits
# from both trees.
# [measured: scratch perlin fixture probe, 3.3.4 tree and this tree, cycc 6.6.3 and 6.6.14, 2026-10-11]
# [measured: scratch f64_to probe, cycc 6.6.3, 6.6.6, 6.6.7, 6.6.8, 6.6.9, 6.6.14, 2026-10-11]
assert_eq(perlin_2d(0x43E5EB851EB851EC, 0x3FD3333333333333), 0x3FD75FF609DCF894,
  "3.3.5 perlin_2d(1.26e19, 0.3) == perlin_2d(0, 0.3) (3.3.4: 0xBFC1869835158B81, cell 255)");
# ON the edge: a cell of exactly 2^63, the first one f64_to cannot convert.
assert_eq(perlin_2d(0x3FE3C6EF372FE950, 0x43E0000000000000), 0x3FB85EB21CBD5990,
  "3.3.5 perlin_2d(0.618, 2^63): cell 0 mod 256 (3.3.4: 0x3FDCC7495278BDB6)");
# Below 2^60 doubles need not be multiples of 256: this cell, 2^60 - 128, is 128 mod 256,
# so a bound set below 2^60 would hash it as 0. Unchanged.
assert_eq(perlin_2d(0x43AFFFFFFFFFFFFF, 0x3FD41B2F769CF0E0), 0x3FC0E06D30C37955,
  "3.3.5 perlin_2d(2^60 - 128, 0.314): cell residue 128 kept (unchanged)");
assert_eq(perlin_3d(0x3FE3C6EF372FE950, 0x3FE827F5352054C6, 0x43E5EB851EB851EC), 0xBFBA2E15BF66A71C,
  "3.3.5 perlin_3d(0.618, 0.755, 1.26e19): z cell 0 mod 256 (3.3.4: 0x3FD80EE22C4FE2E4)");
assert_eq(perlin_3d(0x43E0000000000000, 0x3FD3333333333333, 0x3FE6666666666666), 0x3FD4FDEF02A67E52,
  "3.3.5 perlin_3d(2^63, 0.3, 0.7): x cell 0 mod 256 (3.3.4: 0xBFE1385B286A3666)");
assert_eq(perlin_3d(0x3FD41B2F769CF0E0, 0x43E0000000000000, 0x3FE3C6EF372FE950), 0x3F9C5A6D50EE925C,
  "3.3.5 perlin_3d(0.314, 2^63, 0.618): y cell 0 mod 256 (3.3.4: 0x3FA74E7A32FFDA3A)");
assert_eq(perlin_3d(0x3FD3333333333333, 0x43AFFFFFFFFFFFFF, 0x3FE6666666666666), 0xBFC6C44BBD216CE0,
  "3.3.5 perlin_3d(0.3, 2^60 - 128, 0.7): cell residue 128 kept (unchanged)");
# A negative one was right by accident: i64 min is 0 mod 256. Unchanged.
assert_eq(perlin_3d(0xC3E5EB851EB851EC, 0x3FD3333333333333, 0x3FE6666666666666), 0x3FD4FDEF02A67E52,
  "3.3.5 perlin_3d(-1.26e19, 0.3, 0.7) == perlin_3d(2^63, 0.3, 0.7) (unchanged)");

# === 3.3.3 G5: simplex continuity across simplex boundaries, and the range ===
# ⛔ 3.3.3 — THROUGH 3.3.2 BOTH SIMPLEX FIELDS JUMPED WHERE THE CONTAINING SIMPLEX
# CHANGED (src/noise_simplex.cyr's header), and nothing in the noise group (modules_b.tcyr)
# could see it: the 1/1024 step on a 1/4 grid never lands on a boundary. Every pair here straddles one.
# A pair is built in skewed lattice coordinates (a, b[, c]) ON a boundary -- a cell
# face a = n or b = m (or c = l), or a plane frac(a) = frac(b) (in 3D also b/c and
# a/c) where the corner ordering flips -- moved 2^-30 to either side, and unskewed
# with the module's own G2 / G3. The cells run from -100 to 99 and the fractions are
# the full-mantissa frac(k * 0.618...) and frac(k * 0.754...): 3 x 32 pairs in 2D,
# 6 x 32 in 3D. A pair's points are at most 2.6e-9 apart, and the repaired fields move
# at most 1.58e-8 (2D) / 1.70e-8 (3D) across one -- inside their largest slope
# (|grad| 7.33 / 6.96) times that distance -- so the 1e-6 bound has a 58x margin. The
# 3.3.2 code broke it at 64 of the 96 2D pairs, by up to 0.70, and at 96 of the 192
# 3D pairs, by up to 1.03.
# [measured: scratch straddle probe, 3.3.2 vs repaired bundle, not reproducible in-tree, 2026-10-01; cycc 6.6.12]
#
# A sweep proves only what it reaches: _sxc_sid_2d / _sxc_sid_3d recompute the
# simplex each point lands in (the skew, floor and corner-ordering tests, with the
# module's F2 / G2 / F3 / G3), and the counts assert that every pair straddles a
# boundary. _SXC_BAD2 / _SXC_BAD3 count the pairs NOT inside the bound, so a NaN
# counts against it.
test_group("noise_simplex: continuous across simplex boundaries (3.3.3)");
var _SXC_DEL = 0x3E10000000000000;                             # 2^-30
var _SXC_PHI = 0x3FE3C6EF372FE950;                             # 0.6180339887498949
var _SXC_RHO = 0x3FE827F5352054C6;                             # 0.7548776662466927
var _SXC_LIP = 0x3EB0C6F7A0B5ED8D;                             # 1e-6
var _SXC_BAD2 = 0;
var _SXC_CROSS2 = 0;
var _SXC_BAD3 = 0;
var _SXC_CROSS3 = 0;

# The simplex simplex_2d puts (x, y) in: skewed cell (i, j) and the x0 > y0 test.
fn _sxc_sid_2d(x, y) {
    var s = f64_mul(f64_add(x, y), _SIMPLEX_F2);
    var i_f = f64_floor(f64_add(x, s));
    var j_f = f64_floor(f64_add(y, s));
    var t = f64_mul(f64_add(i_f, j_f), _SIMPLEX_G2);
    var lo = f64_gt(f64_sub(x, f64_sub(i_f, t)), f64_sub(y, f64_sub(j_f, t)));
    return ((f64_to(i_f) + 512) * 1024 + (f64_to(j_f) + 512)) * 2 + lo;
}

# The simplex simplex_3d puts (x, y, z) in: skewed cell (i, j, k) and the three
# ordering tests that pick the tetrahedron.
fn _sxc_sid_3d(x, y, z) {
    var s = f64_mul(f64_add(f64_add(x, y), z), _SIMPLEX_F3);
    var i_f = f64_floor(f64_add(x, s));
    var j_f = f64_floor(f64_add(y, s));
    var k_f = f64_floor(f64_add(z, s));
    var t = f64_mul(f64_add(f64_add(i_f, j_f), k_f), _SIMPLEX_G3);
    var x0 = f64_sub(x, f64_sub(i_f, t));
    var y0 = f64_sub(y, f64_sub(j_f, t));
    var z0 = f64_sub(z, f64_sub(k_f, t));
    var o = f64_gt(x0, y0) * 4 + f64_gt(y0, z0) * 2 + f64_gt(x0, z0);
    var c = ((f64_to(i_f) + 512) * 1024 + (f64_to(j_f) + 512)) * 1024 + (f64_to(k_f) + 512);
    return c * 8 + o;
}

# One straddle: skewed (a0, b0) and (a1, b1), unskewed, the field read at both.
fn _sxc_pair_2d(a0, b0, a1, b1) {
    var t0 = f64_mul(f64_add(a0, b0), _SIMPLEX_G2);
    var x0 = f64_sub(a0, t0);
    var y0 = f64_sub(b0, t0);
    var t1 = f64_mul(f64_add(a1, b1), _SIMPLEX_G2);
    var x1 = f64_sub(a1, t1);
    var y1 = f64_sub(b1, t1);
    var d = f64_abs(f64_sub(simplex_2d(x1, y1), simplex_2d(x0, y0)));
    if (f64_lt(d, _SXC_LIP) == 0) { _SXC_BAD2 = _SXC_BAD2 + 1; }
    if (_sxc_sid_2d(x0, y0) != _sxc_sid_2d(x1, y1)) { _SXC_CROSS2 = _SXC_CROSS2 + 1; }
    return 0;
}

fn _sxc_pair_3d(a0, b0, c0, a1, b1, c1) {
    var t0 = f64_mul(f64_add(f64_add(a0, b0), c0), _SIMPLEX_G3);
    var x0 = f64_sub(a0, t0);
    var y0 = f64_sub(b0, t0);
    var z0 = f64_sub(c0, t0);
    var t1 = f64_mul(f64_add(f64_add(a1, b1), c1), _SIMPLEX_G3);
    var x1 = f64_sub(a1, t1);
    var y1 = f64_sub(b1, t1);
    var z1 = f64_sub(c1, t1);
    var d = f64_abs(f64_sub(simplex_3d(x1, y1, z1), simplex_3d(x0, y0, z0)));
    if (f64_lt(d, _SXC_LIP) == 0) { _SXC_BAD3 = _SXC_BAD3 + 1; }
    if (_sxc_sid_3d(x0, y0, z0) != _sxc_sid_3d(x1, y1, z1)) { _SXC_CROSS3 = _SXC_CROSS3 + 1; }
    return 0;
}

var _sxc_k = 0;
while (_sxc_k < 32) {
    var _sxc_f = f64_mul(f64_from(_sxc_k + 1), _SXC_PHI);
    _sxc_f = f64_sub(_sxc_f, f64_floor(_sxc_f));
    var _sxc_g = f64_mul(f64_from(_sxc_k + 1), _SXC_RHO);
    _sxc_g = f64_sub(_sxc_g, f64_floor(_sxc_g));
    var _sxc_n = f64_from((_sxc_k * 37) % 200 - 100);
    var _sxc_m = f64_from((_sxc_k * 59) % 200 - 100);
    var _sxc_l = f64_from((_sxc_k * 83) % 200 - 100);
    var _sxc_nf = f64_add(_sxc_n, _sxc_f);
    var _sxc_mf = f64_add(_sxc_m, _sxc_f);
    var _sxc_lf = f64_add(_sxc_l, _sxc_f);
    var _sxc_ng = f64_add(_sxc_n, _sxc_g);
    var _sxc_mg = f64_add(_sxc_m, _sxc_g);
    var _sxc_lg = f64_add(_sxc_l, _sxc_g);
    var _sxc_nlo = f64_sub(_sxc_n, _SXC_DEL);
    var _sxc_nhi = f64_add(_sxc_n, _SXC_DEL);
    var _sxc_mlo = f64_sub(_sxc_m, _SXC_DEL);
    var _sxc_mhi = f64_add(_sxc_m, _SXC_DEL);
    var _sxc_llo = f64_sub(_sxc_l, _SXC_DEL);
    var _sxc_lhi = f64_add(_sxc_l, _SXC_DEL);
    var _sxc_nflo = f64_sub(_sxc_nf, _SXC_DEL);
    var _sxc_nfhi = f64_add(_sxc_nf, _SXC_DEL);
    var _sxc_mflo = f64_sub(_sxc_mf, _SXC_DEL);
    var _sxc_mfhi = f64_add(_sxc_mf, _SXC_DEL);
    var _sxc_lflo = f64_sub(_sxc_lf, _SXC_DEL);
    var _sxc_lfhi = f64_add(_sxc_lf, _SXC_DEL);
    # 2D: the cell faces a = n and b = m, and the plane frac(a) = frac(b)
    _sxc_pair_2d(_sxc_nlo, _sxc_mf, _sxc_nhi, _sxc_mf);
    _sxc_pair_2d(_sxc_nf, _sxc_mlo, _sxc_nf, _sxc_mhi);
    _sxc_pair_2d(_sxc_nfhi, _sxc_mflo, _sxc_nflo, _sxc_mfhi);
    # 3D: the cell faces a = n, b = m, c = l, and the planes a/b, b/c, a/c
    _sxc_pair_3d(_sxc_nlo, _sxc_mf, _sxc_lg, _sxc_nhi, _sxc_mf, _sxc_lg);
    _sxc_pair_3d(_sxc_nf, _sxc_mlo, _sxc_lg, _sxc_nf, _sxc_mhi, _sxc_lg);
    _sxc_pair_3d(_sxc_nf, _sxc_mg, _sxc_llo, _sxc_nf, _sxc_mg, _sxc_lhi);
    _sxc_pair_3d(_sxc_nfhi, _sxc_mflo, _sxc_lg, _sxc_nflo, _sxc_mfhi, _sxc_lg);
    _sxc_pair_3d(_sxc_ng, _sxc_mfhi, _sxc_lflo, _sxc_ng, _sxc_mflo, _sxc_lfhi);
    _sxc_pair_3d(_sxc_nfhi, _sxc_mg, _sxc_lflo, _sxc_nflo, _sxc_mg, _sxc_lfhi);
    _sxc_k = _sxc_k + 1;
}
assert_eq(_SXC_CROSS2, 96, "simplex_2d straddles: all 96 pairs land in two different simplices");
assert_eq(_SXC_BAD2, 0, "simplex_2d: continuous across 96 boundary straddles (|jump| < 1e-6, not NaN)");
assert_eq(_SXC_CROSS3, 192, "simplex_3d straddles: all 192 pairs land in two different simplices");
assert_eq(_SXC_BAD3, 0, "simplex_3d: continuous across 192 boundary straddles (|jump| < 1e-6, not NaN)");

# The documented range, read where it is attained (src/noise_simplex.cyr's header,
# RANGE). 2D: the midpoints of the lattice diagonals (0, 10)-(1, 11) and (0, 29)-(1, 30),
# whose end gradients are (1, 1) / (-1, -1) and (-1, -1) / (1, 1), where simplex_2d is
# +140/(81 sqrt(3)) and -140/(81 sqrt(3)) -- checked bit-exact against the reference
# and, as a second code path, against the closed form. 3D: (x, 302 - x, 163), a
# maximiser the max search found, where simplex_3d is 0.998299. A 3D scale of 76.881
# or more puts that point outside 1 (the bound is 76.88075), one below 76.72 puts it
# under 0.998, and a 2D scale above 70.15 puts the 2D extremum outside 1.
# [measured: scratch max search, not reproducible in-tree, 2026-10-01; cycc 6.6.12]
var _sxc_cf = f64_div(f64_from(140), f64_mul(f64_from(81), f64_sqrt(f64_from(3))));
var _sxc_t2 = f64_mul(f64_from(11), _SIMPLEX_G2);
var _sxc_v2 = simplex_2d(f64_sub(F64_HALF, _sxc_t2), f64_sub(f64_div(f64_from(21), F64_TWO), _sxc_t2));
assert_eq(_sxc_v2, 0x3FEFEEB5A7A3E693,
  "simplex_2d at a maximiser == 0.9978893541549091 (bit-exact vs reference)");
assert(f64_lt(f64_abs(f64_sub(_sxc_v2, _sxc_cf)), 0x3CE203AF9EE75616) == 1,
  "simplex_2d at a maximiser == 140/(81 sqrt(3)) to 2e-15 (closed form)");
var _sxc_t2n = f64_mul(f64_from(30), _SIMPLEX_G2);
var _sxc_v2n = simplex_2d(f64_sub(F64_HALF, _sxc_t2n), f64_sub(f64_div(f64_from(59), F64_TWO), _sxc_t2n));
assert_eq(_sxc_v2n, 0xBFEFEEB5A7A3E694,
  "simplex_2d at a minimiser == -0.9978893541549092 (bit-exact vs reference)");
assert(f64_lt(f64_abs(f64_add(_sxc_v2n, _sxc_cf)), 0x3CE203AF9EE75616) == 1,
  "simplex_2d at a minimiser == -140/(81 sqrt(3)) to 2e-15 (closed form)");
assert(f64_lt(f64_abs(_sxc_v2n), F64_ONE) == 1, "simplex_2d: |v| at its extremum is inside 1");
var _sxc_x3 = 0x40558AADB030BBE0;                              # 86.16685108908814
var _sxc_v3 = simplex_3d(_sxc_x3, f64_sub(f64_from(302), _sxc_x3), f64_from(163));
assert_eq(_sxc_v3, 0x3FEFF211670A59E5,
  "simplex_3d at a maximiser == 0.9982993137844544 (bit-exact vs reference)");
assert(f64_gt(_sxc_v3, 0x3FEFEF9DB22D0E56) == 1, "simplex_3d at a maximiser > 0.998 (the documented maximum)");
assert(f64_lt(_sxc_v3, F64_ONE) == 1, "simplex_3d: its maximum is inside 1");

# ================================================================
# ================================================================
# 2.14.0 — scale covariance for calc_ext's five epsilon guards
# ================================================================
# ⛔ FIVE GUARDS IN THIS FILE COMPARED A DIMENSIONED QUANTITY AGAINST AN ABSOLUTE
# 1e-12 AND THEN FABRICATED A PLAUSIBLE ANSWER — the same class the repo has been
# recording since complex.cyr:58 in 2.6.14. All five passed every assertion in the
# tree before this block existed, and all five still pass them after the repair:
# the existing calc_ext tests are reject-path assertions that return before the
# guard runs, so NO test in the tree ever evaluated a B-spline to a value.
#
# ⭐ SCALE COVARIANCE IS THE ONLY SHAPE OF TEST A BAD THRESHOLD CANNOT PASS, and
# these fixtures are BIT-EXACT rather than tolerance-based: every scale is a power
# of two, so each blend weight is exactly representable and the expected value does
# not move by a single ULP across ~600 decimal decades. A tolerance would have
# re-introduced the 2.13.0 problem — an assertion that accepts a range accepts a
# fabrication that lands in the range.
#
# ⚠ THE DEPTH IS BRACKETING, NOT DECORATION. Each sweep must straddle every
# threshold a repair might plausibly have reached for, because 2.11.1 recorded a
# 12-decade quaternion sweep killing 1 of 3 mutants by looking above where the
# rejected thresholds sat. Measured kill matrix for the de Boor sweep, one build
# per candidate: 1e-6 first fails at 2^-20, 1e-9 at 2^-30, the shipped 1e-12 at
# 2^-40, 1e-15 at 2^-50, DBL_EPSILON at 2^-60, and F64_1E_NEG30 — then declared
# at the top of calc_ext.cyr (3.3.3 retired it), so the likeliest in-file grab — at 2^-200. Only
# DBL_MIN survives all ten. That is why 2^-200 and 2^-1000 are here and why the
# 2^-60 -> 2^-200 gap must not be closed up.
# [measured: per-candidate rebuild of the whole sweep, 2026-09-09]

test_group("calc_ext 2.14.0: scale covariance of the epsilon guards");

# 2^e as an f64 bit pattern: exponent field (1023 + e), zero mantissa.
fn _ce_p2(e) { return (1023 + e) << 52; }

# The shared cubic fixture: P = [(0,0,0),(1,2,0),(3,-1,0),(4,0,0)].
fn _ce_cps4() {
    var c = alloc(4 * 8);
    store64(c + 0,  hvec3_new(0, 0, 0));
    store64(c + 8,  hvec3_new(f64_from(1), f64_from(2), 0));
    store64(c + 16, hvec3_new(f64_from(3), f64_neg(F64_ONE), 0));
    store64(c + 24, hvec3_new(f64_from(4), 0, 0));
    return c;
}

# knots = [0,0,0,0,s,s,s,s]; t = s/2 sits mid-span, so alpha = 1/2 exactly.
fn _ce_knots8(s) {
    var k = _f64arr_alloc(8);
    var i = 0;
    while (i < 4) {
        _f64arr_set(k, i, 0);
        _f64arr_set(k, i + 4, s);
        i = i + 1;
    }
    return k;
}

# --- A. calc_bspline: the knot vector is a UNIT CHOICE, so the curve must not move
var _CE_RUN = 0;
var _CE_BAD = 0;
var _ce_exps = _f64arr_alloc(10);
_f64arr_set(_ce_exps, 0, 0);       _f64arr_set(_ce_exps, 1, 0 - 10);
_f64arr_set(_ce_exps, 2, 0 - 20);  _f64arr_set(_ce_exps, 3, 0 - 30);
_f64arr_set(_ce_exps, 4, 0 - 39);  _f64arr_set(_ce_exps, 5, 0 - 40);
_f64arr_set(_ce_exps, 6, 0 - 50);  _f64arr_set(_ce_exps, 7, 0 - 60);
_f64arr_set(_ce_exps, 8, 0 - 200); _f64arr_set(_ce_exps, 9, 0 - 1000);
# ⚠ 2^-39 is here deliberately: it is the LAST scale that passes on the stock
# tree, so the sweep pins the breakpoint instead of merely straddling it.

var _ce_i = 0;
while (_ce_i < 10) {
    var _ce_s = _ce_p2(_f64arr_get(_ce_exps, _ce_i));
    var _ce_r = calc_bspline(3, _ce_cps4(), 4, _ce_knots8(_ce_s), 8,
      f64_mul(_ce_s, F64_HALF));
    _CE_RUN = _CE_RUN + 1;
    if (_ce_r == 0) {
        _CE_BAD = _CE_BAD + 1;
    } else {
        if (HVec3_x(_ce_r) != 0x4000000000000000) { _CE_BAD = _CE_BAD + 1; }
        if (HVec3_y(_ce_r) != 0x3FD8000000000000) { _CE_BAD = _CE_BAD + 1; }
    }
    _ce_i = _ce_i + 1;
}
# ⚠ The RUN counter is asserted, not assumed. A sweep that silently stops running
# is indistinguishable from a sweep that passes — 2.10.2 caught two such fixtures.
assert_eq(_CE_RUN, 10, "calc_bspline knot-scale sweep actually ran 10 scales");
assert_eq(_CE_BAD, 0,
  "calc_bspline: (2.0, 0.375) bit-exact at every knot scale from 2^0 to 2^-1000");

# --- B. NARROW INTERIOR SPAN — kills the span-RELATIVE repair, which A lets pass.
# ⭐ A guard of the form `denom < eps * (t_max - t_min)` is scale-free and sails
# through sweep A unchanged, because there every span IS the total span. Only a
# knot vector with one fine interior span inside a unit total separates them.
var _ce_nb_cps = alloc(3 * 8);
store64(_ce_nb_cps + 0,  hvec3_new(0, 0, 0));
store64(_ce_nb_cps + 8,  hvec3_new(f64_from(8), f64_from(4), 0));
store64(_ce_nb_cps + 16, hvec3_new(f64_from(16), 0, 0));
var _ce_nb_kn = _f64arr_alloc(5);
_f64arr_set(_ce_nb_kn, 0, 0);
_f64arr_set(_ce_nb_kn, 1, 0);
_f64arr_set(_ce_nb_kn, 2, _ce_p2(0 - 40));
_f64arr_set(_ce_nb_kn, 3, F64_ONE);
_f64arr_set(_ce_nb_kn, 4, F64_ONE);
var _ce_nb = calc_bspline(1, _ce_nb_cps, 3, _ce_nb_kn, 5, _ce_p2(0 - 41));
assert(_ce_nb != 0, "calc_bspline narrow-span fixture returns a point");
assert_eq(HVec3_x(_ce_nb), 0x4010000000000000,
  "calc_bspline: a fine interior span inside a unit knot vector still interpolates");
assert_eq(HVec3_y(_ce_nb), 0x4000000000000000,
  "calc_bspline: narrow-span y is the exact midpoint, not the fabricated P1");

# --- C. ANTI-DELETION CONTROL. Sweeps A and B never drive denom to zero, so both
# pass with the guard deleted entirely. This fixture forces knots[2] == knots[3].
var _ce_z_cps = alloc(3 * 8);
store64(_ce_z_cps + 0,  hvec3_new(F64_ONE, 0, 0));
store64(_ce_z_cps + 8,  hvec3_new(f64_from(5), 0, 0));
store64(_ce_z_cps + 16, hvec3_new(f64_from(9), 0, 0));
var _ce_z_kn = _f64arr_alloc(5);
_f64arr_set(_ce_z_kn, 0, 0);
_f64arr_set(_ce_z_kn, 1, 0);
_f64arr_set(_ce_z_kn, 2, F64_ONE);
_f64arr_set(_ce_z_kn, 3, F64_ONE);
_f64arr_set(_ce_z_kn, 4, F64_ONE);
var _ce_z = calc_bspline(1, _ce_z_cps, 3, _ce_z_kn, 5, F64_ONE);
assert(_ce_z != 0, "calc_bspline zero-span control returns a point");
assert_eq(HVec3_x(_ce_z), 0x4022000000000000,
  "calc_bspline: an exactly-zero knot span still takes the skip, not 0/0");

# --- D. calc_nurbs inherits the same de Boor guard: sweep it at all weights = 1.
var _CE_NR_RUN = 0;
var _CE_NR_BAD = 0;
_ce_i = 0;
while (_ce_i < 10) {
    var _ce_ns = _ce_p2(_f64arr_get(_ce_exps, _ce_i));
    var _ce_nw = _f64arr_alloc(4);
    var _ce_wj = 0;
    while (_ce_wj < 4) { _f64arr_set(_ce_nw, _ce_wj, F64_ONE); _ce_wj = _ce_wj + 1; }
    var _ce_nres = calc_nurbs(3, _ce_cps4(), _ce_nw, 4, _ce_knots8(_ce_ns), 8,
      f64_mul(_ce_ns, F64_HALF));
    _CE_NR_RUN = _CE_NR_RUN + 1;
    if (_ce_nres == 0) {
        _CE_NR_BAD = _CE_NR_BAD + 1;
    } else {
        if (HVec3_x(_ce_nres) != 0x4000000000000000) { _CE_NR_BAD = _CE_NR_BAD + 1; }
    }
    _ce_i = _ce_i + 1;
}
assert_eq(_CE_NR_RUN, 10, "calc_nurbs knot-scale sweep actually ran 10 scales");
assert_eq(_CE_NR_BAD, 0,
  "calc_nurbs: x is bit-exactly 2.0 at every knot scale from 2^0 to 2^-1000");

# --- E. THE WEIGHT GAUGE IS UNOBSERVABLE. w and c*w describe the SAME curve, so
# the perspective-divide guard must not have an opinion about c. This sweep runs
# in BOTH directions — 2^+1000 down to 2^-1000, ~600 decimal decades — and the
# maximum intermediate is 4*2^1000 = 2^1002, so nothing overflows or goes subnormal.
var _CE_W_RUN = 0;
var _CE_W_BAD = 0;
var _ce_wexps = _f64arr_alloc(12);
_f64arr_set(_ce_wexps, 0, 1000);     _f64arr_set(_ce_wexps, 1, 60);
_f64arr_set(_ce_wexps, 2, 10);       _f64arr_set(_ce_wexps, 3, 0);
_f64arr_set(_ce_wexps, 4, 0 - 10);   _f64arr_set(_ce_wexps, 5, 0 - 20);
_f64arr_set(_ce_wexps, 6, 0 - 30);   _f64arr_set(_ce_wexps, 7, 0 - 40);
_f64arr_set(_ce_wexps, 8, 0 - 50);   _f64arr_set(_ce_wexps, 9, 0 - 60);
_f64arr_set(_ce_wexps, 10, 0 - 200); _f64arr_set(_ce_wexps, 11, 0 - 1000);
_ce_i = 0;
while (_ce_i < 12) {
    var _ce_c = _ce_p2(_f64arr_get(_ce_wexps, _ce_i));
    var _ce_gw = _f64arr_alloc(4);
    var _ce_gj = 0;
    while (_ce_gj < 4) { _f64arr_set(_ce_gw, _ce_gj, _ce_c); _ce_gj = _ce_gj + 1; }
    var _ce_gkn = _ce_knots8(F64_ONE);
    var _ce_g = calc_nurbs(3, _ce_cps4(), _ce_gw, 4, _ce_gkn, 8, F64_HALF);
    _CE_W_RUN = _CE_W_RUN + 1;
    if (_ce_g == 0) {
        _CE_W_BAD = _CE_W_BAD + 1;
    } else {
        if (HVec3_x(_ce_g) != 0x4000000000000000) { _CE_W_BAD = _CE_W_BAD + 1; }
    }
    _ce_i = _ce_i + 1;
}
assert_eq(_CE_W_RUN, 12, "calc_nurbs weight-gauge sweep actually ran 12 gauges");
assert_eq(_CE_W_BAD, 0,
  "calc_nurbs: the weight gauge is unobservable, x is 2.0 from 2^+1000 to 2^-1000");

# === 3.3.3 W4: NaN in the B-spline, NURBS and TCB parameter ===
# ⛔ calc_bspline and calc_nurbs range-tested t with two NaN-false comparisons, so a
# NaN t passed. At degree 0 nothing does arithmetic on t: the span search ran to the
# end and returned the LAST control point — (2,0,0) on this fixture, a point on the
# curve — and at degree 1 a NaN point. Both now return the documented invalid-input 0.
# [measured: degree-0 and degree-1 NaN-t probe on the 3.3.2 bundle, 2026-10-01]
var _w4_nan = f64_div(0, 0);
var _w4_cp = alloc(3 * 8);
store64(_w4_cp + 0,  hvec3_new(0, 0, 0));
store64(_w4_cp + 8,  hvec3_new(F64_ONE, F64_ONE, F64_ONE));
store64(_w4_cp + 16, hvec3_new(F64_TWO, 0, 0));
var _w4_k0 = _f64arr_alloc(4);
_f64arr_set(_w4_k0, 0, 0);
_f64arr_set(_w4_k0, 1, F64_ONE);
_f64arr_set(_w4_k0, 2, F64_TWO);
_f64arr_set(_w4_k0, 3, f64_from(3));
var _w4_k1 = _f64arr_alloc(5);
_f64arr_set(_w4_k1, 0, 0);
_f64arr_set(_w4_k1, 1, 0);
_f64arr_set(_w4_k1, 2, F64_ONE);
_f64arr_set(_w4_k1, 3, F64_TWO);
_f64arr_set(_w4_k1, 4, F64_TWO);
var _w4_w = _f64arr_alloc(3);
_f64arr_set(_w4_w, 0, F64_ONE);
_f64arr_set(_w4_w, 1, F64_ONE);
_f64arr_set(_w4_w, 2, F64_ONE);
assert_eq(calc_bspline(0, _w4_cp, 3, _w4_k0, 4, _w4_nan), 0,
  "calc_bspline: degree 0, t = NaN -> 0 (was the last control point)");
assert_eq(calc_bspline(1, _w4_cp, 3, _w4_k1, 5, _w4_nan), 0,
  "calc_bspline: degree 1, t = NaN -> 0 (was a NaN point)");
assert_eq(calc_nurbs(0, _w4_cp, _w4_w, 3, _w4_k0, 4, _w4_nan), 0,
  "calc_nurbs: degree 0, t = NaN -> 0 (was the last control point)");
assert_eq(calc_nurbs(1, _w4_cp, _w4_w, 3, _w4_k1, 5, _w4_nan), 0,
  "calc_nurbs: degree 1, t = NaN -> 0 (was a NaN point)");
# Controls: the guard stops NaN and nothing else. The same degree-0 curve is its
# first control point at t = 0.5 and its last at t = 2.5 and at t_max = 3.
var _w4_b0 = calc_bspline(0, _w4_cp, 3, _w4_k0, 4, F64_HALF);
assert(_w4_b0 != 0, "calc_bspline: degree 0, t = 0.5 is a point");
assert_eq(HVec3_x(_w4_b0), 0, "calc_bspline: degree 0, t = 0.5 is the first control point");
var _w4_b2 = calc_bspline(0, _w4_cp, 3, _w4_k0, 4, f64_add(F64_TWO, F64_HALF));
assert(_w4_b2 != 0, "calc_bspline: degree 0, t = 2.5 is a point");
assert_eq(HVec3_x(_w4_b2), F64_TWO, "calc_bspline: degree 0, t = 2.5 is the last control point");
var _w4_n3 = calc_nurbs(0, _w4_cp, _w4_w, 3, _w4_k0, 4, f64_from(3));
assert(_w4_n3 != 0, "calc_nurbs: degree 0, t = t_max is a point");
assert_eq(HVec3_x(_w4_n3), F64_TWO, "calc_nurbs: degree 0, t = t_max is the last control point");

# ⚠ THE SPAN TESTS STAY NaN-TRUE, ON PURPOSE. de Boor's `f64_lt(|denom|, F64_TINY) == 0`
# and the TCB segment's `f64_lt(|seg_len|, F64_TINY) == 0` are TRUE for a NaN width,
# so a NaN knot or key time is computed THROUGH and comes out NaN. The NaN-false
# spelling (`f64_ge(...) == 1`) skips the update instead, and returns a value built
# from the inputs around the NaN as if it were not there.
# [measured: NaN-knot and NaN-key-time probe on the 3.3.2 bundle and the respelled builds, 2026-10-01]
var _w4_kn = _f64arr_alloc(5);
_f64arr_set(_w4_kn, 0, 0);
_f64arr_set(_w4_kn, 1, 0);
_f64arr_set(_w4_kn, 2, _w4_nan);
_f64arr_set(_w4_kn, 3, F64_TWO);
_f64arr_set(_w4_kn, 4, F64_TWO);
var _w4_bn = calc_bspline(1, _w4_cp, 3, _w4_kn, 5, F64_HALF);
assert(_w4_bn != 0, "calc_bspline: a NaN interior knot still returns a point");
assert_eq(f64_eq(HVec3_x(_w4_bn), HVec3_x(_w4_bn)), 0, "calc_bspline: a NaN interior knot propagates NaN");
var _w4_nn = calc_nurbs(1, _w4_cp, _w4_w, 3, _w4_kn, 5, F64_HALF);
assert(_w4_nn != 0, "calc_nurbs: a NaN interior knot still returns a point");
assert_eq(f64_eq(HVec3_x(_w4_nn), HVec3_x(_w4_nn)), 0, "calc_nurbs: a NaN interior knot propagates NaN");
# ⛔ 3.3.4 — AT DEGREE 0 THE SAME NaN KNOT WAS NEVER READ: knots [0, NaN, 2, 3] gave
# ctrl[1] = (1,1,1) at t = 0.5 and 1.5, where the span holding t cannot be decided. A
# NaN bound of the span t lands in now gives the NaN point, the rule degree >= 1 already
# follows through de Boor's alpha. A NaN knot outside that span is not read: t = 2.5 is
# still ctrl[2]. [0, 1, 2, NaN] puts the NaN on the RIGHT bound of the last span, so the
# two bound tests are proven separately.
# [measured: NaN-knot probe on the base tree, 2026-10-03; cycc 6.6.14]
var _r4_kl = _f64arr_alloc(4);
_f64arr_set(_r4_kl, 0, 0);
_f64arr_set(_r4_kl, 1, _w4_nan);
_f64arr_set(_r4_kl, 2, F64_TWO);
_f64arr_set(_r4_kl, 3, f64_from(3));
var _r4_kr = _f64arr_alloc(4);
_f64arr_set(_r4_kr, 0, 0);
_f64arr_set(_r4_kr, 1, F64_ONE);
_f64arr_set(_r4_kr, 2, F64_TWO);
_f64arr_set(_r4_kr, 3, _w4_nan);
var _r4_p = calc_bspline(0, _w4_cp, 3, _r4_kl, 4, F64_HALF);
assert(_r4_p != 0, "calc_bspline: degree 0, NaN knot 1, t = 0.5 returns a point");
assert_eq(HVec3_x(_r4_p), 0x7FF8000000000000, "calc_bspline: degree 0, NaN knot 1, t = 0.5 -> NaN x (was ctrl[1])");
assert_eq(HVec3_y(_r4_p), 0x7FF8000000000000, "calc_bspline: degree 0, NaN knot 1, t = 0.5 -> NaN y");
assert_eq(HVec3_z(_r4_p), 0x7FF8000000000000, "calc_bspline: degree 0, NaN knot 1, t = 0.5 -> NaN z");
_r4_p = calc_bspline(0, _w4_cp, 3, _r4_kl, 4, f64_add(F64_ONE, F64_HALF));
assert_eq(HVec3_x(_r4_p), 0x7FF8000000000000, "calc_bspline: degree 0, NaN knot 1, t = 1.5 -> NaN (was ctrl[1])");
_r4_p = calc_bspline(0, _w4_cp, 3, _r4_kl, 4, f64_add(F64_TWO, F64_HALF));
assert_eq(HVec3_x(_r4_p), F64_TWO,
  "calc_bspline: degree 0, NaN knot 1, t = 2.5 is ctrl[2]: that span does not read it");
_r4_p = calc_bspline(0, _w4_cp, 3, _r4_kr, 4, f64_add(F64_TWO, F64_HALF));
assert_eq(HVec3_x(_r4_p), 0x7FF8000000000000, "calc_bspline: degree 0, NaN last knot, t = 2.5 -> NaN (was ctrl[2])");
_r4_p = calc_bspline(0, _w4_cp, 3, _r4_kr, 4, f64_add(F64_ONE, F64_HALF));
assert_eq(HVec3_x(_r4_p), F64_ONE, "calc_bspline: degree 0, NaN last knot, t = 1.5 is ctrl[1]");
_r4_p = calc_nurbs(0, _w4_cp, _w4_w, 3, _r4_kl, 4, F64_HALF);
assert(_r4_p != 0, "calc_nurbs: degree 0, NaN knot 1, t = 0.5 returns a point");
assert_eq(HVec3_x(_r4_p), 0x7FF8000000000000, "calc_nurbs: degree 0, NaN knot 1, t = 0.5 -> NaN x (was ctrl[1])");
assert_eq(HVec3_y(_r4_p), 0x7FF8000000000000, "calc_nurbs: degree 0, NaN knot 1, t = 0.5 -> NaN y");
assert_eq(HVec3_z(_r4_p), 0x7FF8000000000000, "calc_nurbs: degree 0, NaN knot 1, t = 0.5 -> NaN z");
_r4_p = calc_nurbs(0, _w4_cp, _w4_w, 3, _r4_kl, 4, f64_add(F64_TWO, F64_HALF));
assert_eq(HVec3_x(_r4_p), F64_TWO, "calc_nurbs: degree 0, NaN knot 1, t = 2.5 is ctrl[2]");
_r4_p = calc_nurbs(0, _w4_cp, _w4_w, 3, _r4_kr, 4, f64_add(F64_TWO, F64_HALF));
assert_eq(HVec3_x(_r4_p), 0x7FF8000000000000, "calc_nurbs: degree 0, NaN last knot, t = 2.5 -> NaN (was ctrl[2])");
var _w4_tt = _f64arr_alloc(3);
_f64arr_set(_w4_tt, 0, 0);
_f64arr_set(_w4_tt, 1, _w4_nan);
_f64arr_set(_w4_tt, 2, F64_TWO);
var _w4_tv = _f64arr_alloc(3);
_f64arr_set(_w4_tv, 0, 0);
_f64arr_set(_w4_tv, 1, f64_from(5));
_f64arr_set(_w4_tv, 2, f64_from(10));
var _w4_th = _ctcb(_w4_tt, _w4_tv, 3, 0, 0, 0, F64_HALF);
assert_eq(f64_eq(_w4_th, _w4_th), 0, "calc_hermite_tcb: a NaN key time propagates NaN, not key 1's 5.0");

# --- F. calc_hermite_tcb: THREE queries per scale, because they fail differently.
# ⚠ The on-key query alone is NOT enough and this is measured: at t = key 1 the
# value 5.0 coincides with what the collapsed u = 0 path returns, so repairing the
# end-key clamp alone passes it while the segment interior is still wrong. The
# interior query at t = 1.5s is what forces the sibling seg_len guard to be fixed.
# [measured: per-candidate rebuild of the hermite sweep, 2026-09-09]
var _CE_H_RUN = 0;
var _CE_H_BAD = 0;
var _ce_hexps = _f64arr_alloc(9);
_f64arr_set(_ce_hexps, 0, 0);       _f64arr_set(_ce_hexps, 1, 0 - 10);
_f64arr_set(_ce_hexps, 2, 0 - 20);  _f64arr_set(_ce_hexps, 3, 0 - 30);
_f64arr_set(_ce_hexps, 4, 0 - 40);  _f64arr_set(_ce_hexps, 5, 0 - 50);
_f64arr_set(_ce_hexps, 6, 0 - 60);  _f64arr_set(_ce_hexps, 7, 0 - 200);
_f64arr_set(_ce_hexps, 8, 0 - 1000);
_ce_i = 0;
while (_ce_i < 9) {
    var _ce_hs = _ce_p2(_f64arr_get(_ce_hexps, _ce_i));
    var _ce_ht = _f64arr_alloc(3);
    _f64arr_set(_ce_ht, 0, 0);
    _f64arr_set(_ce_ht, 1, _ce_hs);
    _f64arr_set(_ce_ht, 2, f64_mul(_ce_hs, F64_TWO));
    var _ce_hv = _f64arr_alloc(3);
    _f64arr_set(_ce_hv, 0, 0);
    _f64arr_set(_ce_hv, 1, f64_from(5));
    _f64arr_set(_ce_hv, 2, f64_from(10));
    _CE_H_RUN = _CE_H_RUN + 1;
    # (A) ON KEY 1 — the end-key clamp must not claim this is the LAST key.
    if (_ctcb(_ce_ht, _ce_hv, 3, 0, 0, 0, _ce_hs)
      != 0x4014000000000000) { _CE_H_BAD = _CE_H_BAD + 1; }
    # (B) SEGMENT INTERIOR — u must be a real fraction, not collapsed to 0.
    if (_ctcb(_ce_ht, _ce_hv, 3, 0, 0, 0,
        f64_add(_ce_hs, f64_mul(_ce_hs, F64_HALF))) != 0x401F400000000000) {
        _CE_H_BAD = _CE_H_BAD + 1;
    }
    # (C) ON THE LAST KEY — the clamp must still fire. This is the assertion that
    # rules DELETION out: with the guard gone it returns 5.0 here from 2^-40 down.
    if (_ctcb(_ce_ht, _ce_hv, 3, 0, 0, 0, f64_mul(_ce_hs, F64_TWO))
      != 0x4024000000000000) { _CE_H_BAD = _CE_H_BAD + 1; }
    _ce_i = _ce_i + 1;
}
assert_eq(_CE_H_RUN, 9, "calc_hermite_tcb sweep actually ran 9 key-time scales");
assert_eq(_CE_H_BAD, 0,
  "calc_hermite_tcb: on-key 5.0, interior 7.8125, end 10.0 at every key-time scale");
# --- F2. The FIRST segment of three keys. Every query above lands in segment 1, so the
# sentinel unwrap `if (seg >= n)` was never exercised at seg = 0, the one case only its
# `=` handles (the sentinel leaves seg = 0 + n): seed-336 mutant m0010 (`seg > n`) kept
# seg = 3 there and read times[3], times[4], values[3] and values[4], past both 3-key
# arrays. Keys (0,0), (1,5), (2,10), Catmull-Rom (T = C = B = 0), t = 1/2: seg 0 has no
# left key, so p0 = p1 = 0, p2 = 5, p3 = 10, m0 = 5/2, m1 = 5, u = 1/2, and the Hermite
# sum is 0 + (1/8)(5/2) + (1/2)5 - (1/8)5 = 35/16. A segment-selection fixture, not a
# precision one: every operand is a short dyadic, so each IEEE step is exact.
# [measured: scratch python3 fractions oracle + IEEE replay of the op order, 3.3.7 tree, 2026-10-31]
var _mt10_t = _f64arr_alloc(3);
_f64arr_set(_mt10_t, 0, 0);
_f64arr_set(_mt10_t, 1, F64_ONE);
_f64arr_set(_mt10_t, 2, F64_TWO);
var _mt10_v = _f64arr_alloc(3);
_f64arr_set(_mt10_v, 0, 0);
_f64arr_set(_mt10_v, 1, f64_from(5));
_f64arr_set(_mt10_v, 2, f64_from(10));
assert_eq(_ctcb(_mt10_t, _mt10_v, 3, 0, 0, 0, F64_HALF), 0x4001800000000000,
  "calc_hermite_tcb: first segment of 3 keys, t = 0.5 -> 35/16 = 2.1875");

# --- G. OVERFLOW CONTROL, scale-independent. The end-key clamp is not protecting a
# division — it is protecting h10*m0 from 0*Inf when a tangent overflows. Deleting
# it returns NaN here, which is why the repair is exact equality and not removal.
var _ce_ot = _f64arr_alloc(3);
_f64arr_set(_ce_ot, 0, 0);
_f64arr_set(_ce_ot, 1, F64_ONE);
_f64arr_set(_ce_ot, 2, F64_TWO);
var _ce_ov = _f64arr_alloc(3);
_f64arr_set(_ce_ov, 0, 0);
_f64arr_set(_ce_ov, 1, f64_neg(0x7FE0000000000000));
_f64arr_set(_ce_ov, 2, 0x7FE0000000000000);
assert_eq(_ctcb(_ce_ot, _ce_ov, 3, 0, 0, 0, F64_TWO), 0x7FE0000000000000,
  "calc_hermite_tcb: an overflowing tangent at the end key returns the key, not NaN");

# --- H. calc_monotone_cubic: the x axis is a UNIT CHOICE, swept BOTH ways.
# ⚠ The growing side stops at 2^+60 because a SEPARATE guard in
# calc_monotone_cubic's tangent loop (`_CALCX_F64_1E_NEG30`) compared |delta| — a
# SLOPE, y per x — against an absolute 1e-30, and it started zeroing tangents past
# s = 2^+99.7: measured 2.25 at 2^+90, 2.0 at 2^+100 and 2.5 at 2^+110. 3.3.3
# repaired it (audit D068); the sweep past 2^+100 is the "3.3.3 G4" block below.
# [measured: growing-side scan, first deviation at 2^+100]
var _CE_M_RUN = 0;
var _CE_M_BAD = 0;
var _ce_mexps = _f64arr_alloc(12);
_f64arr_set(_ce_mexps, 0, 60);      _f64arr_set(_ce_mexps, 1, 30);
_f64arr_set(_ce_mexps, 2, 10);      _f64arr_set(_ce_mexps, 3, 0);
_f64arr_set(_ce_mexps, 4, 0 - 10);  _f64arr_set(_ce_mexps, 5, 0 - 20);
_f64arr_set(_ce_mexps, 6, 0 - 30);  _f64arr_set(_ce_mexps, 7, 0 - 40);
_f64arr_set(_ce_mexps, 8, 0 - 50);  _f64arr_set(_ce_mexps, 9, 0 - 60);
_f64arr_set(_ce_mexps, 10, 0 - 200); _f64arr_set(_ce_mexps, 11, 0 - 1000);
_ce_i = 0;
while (_ce_i < 12) {
    var _ce_ms = _ce_p2(_f64arr_get(_ce_mexps, _ce_i));
    var _ce_mx = _f64arr_alloc(4);
    _f64arr_set(_ce_mx, 0, 0);
    _f64arr_set(_ce_mx, 1, _ce_ms);
    _f64arr_set(_ce_mx, 2, f64_mul(_ce_ms, F64_TWO));
    _f64arr_set(_ce_mx, 3, f64_mul(_ce_ms, f64_from(3)));
    var _ce_my = _f64arr_alloc(4);
    _f64arr_set(_ce_my, 0, 0);
    _f64arr_set(_ce_my, 1, F64_ONE);
    _f64arr_set(_ce_my, 2, f64_from(4));
    _f64arr_set(_ce_my, 3, f64_from(9));
    _CE_M_RUN = _CE_M_RUN + 1;
    if (_cmc(_ce_mx, _ce_my, 4,
        f64_add(_ce_ms, f64_mul(_ce_ms, F64_HALF))) != 0x4002000000000000) {
        _CE_M_BAD = _CE_M_BAD + 1;
    }
    _ce_i = _ce_i + 1;
}
assert_eq(_CE_M_RUN, 12, "calc_monotone_cubic sweep actually ran 12 x-axis scales");
assert_eq(_CE_M_BAD, 0,
  "calc_monotone_cubic: 2.25 bit-exact from x-scale 2^+60 down to 2^-1000");

# === 3.3.3 G4: calc_monotone_cubic flat-secant test (D068) ===
# ⛔ The flat-segment test was `|delta| < 1e-30`, an absolute threshold on a SLOPE.
# Sweep H past 2^+100 is where it bit: 2.25 at 2^+99, 2.0 at 2^+100 and 2^+101, 2.5
# from 2^+102 on 3.3.2. The fixtures sit ON the boundary — 1e-30 is 2^-99.66, so
# the first secant (1/s) is above it at 2^+99 and below it at 2^+100 — and run on to
# 2^+1022, the last x-scale whose 3s is finite. The y-scale sweep is the same slope
# reached the other way (ys = 2^j [0,1,4,9] on the unit grid, f(1.5) = 2.25 * 2^j,
# exact because every scale is a power of two); 3.3.2 was wrong from 2^-100 down.
# [measured: (x-scale, y-scale) grid probe on the 3.3.2 bundle, 2026-10-01]
# ⚠ The y sweep runs on into SUBNORMAL slopes, because that is where an exact-zero
# test and a smaller threshold part. 2^-1022 is the last y-scale whose slopes are
# normal; from 2^-1023 a `|delta| < DBL_MIN` test flattens every segment and gives
# 2.5 * 2^j (wrong on 50 of the 83 scales 2^-990..2^-1072; 3.3.2 on all 83, this tree
# on none); 2^-1072 is the last scale whose 2.25 * 2^j is exact. The subnormal scales
# are built as an exact product of two normal powers of two, not as a shift.
# [measured: 83-scale y sweep on the 3.3.2 bundle, this tree and a DBL_MIN-threshold build, 2026-10-01]
var _G4_MC_RUN = 0;
var _G4_MC_BAD = 0;
var _g4_mexps = _f64arr_alloc(10);
_f64arr_set(_g4_mexps, 0, 90);   _f64arr_set(_g4_mexps, 1, 99);
_f64arr_set(_g4_mexps, 2, 100);  _f64arr_set(_g4_mexps, 3, 101);
_f64arr_set(_g4_mexps, 4, 102);  _f64arr_set(_g4_mexps, 5, 110);
_f64arr_set(_g4_mexps, 6, 200);  _f64arr_set(_g4_mexps, 7, 500);
_f64arr_set(_g4_mexps, 8, 1000); _f64arr_set(_g4_mexps, 9, 1022);
_ce_i = 0;
while (_ce_i < 10) {
    var _g4_ms = _ce_p2(_f64arr_get(_g4_mexps, _ce_i));
    var _g4_mx = _f64arr_alloc(4);
    _f64arr_set(_g4_mx, 0, 0);
    _f64arr_set(_g4_mx, 1, _g4_ms);
    _f64arr_set(_g4_mx, 2, f64_mul(_g4_ms, F64_TWO));
    _f64arr_set(_g4_mx, 3, f64_mul(_g4_ms, f64_from(3)));
    var _g4_my = _f64arr_alloc(4);
    _f64arr_set(_g4_my, 0, 0);
    _f64arr_set(_g4_my, 1, F64_ONE);
    _f64arr_set(_g4_my, 2, f64_from(4));
    _f64arr_set(_g4_my, 3, f64_from(9));
    _G4_MC_RUN = _G4_MC_RUN + 1;
    if (_cmc(_g4_mx, _g4_my, 4,
        f64_add(_g4_ms, f64_mul(_g4_ms, F64_HALF))) != 0x4002000000000000) {
        _G4_MC_BAD = _G4_MC_BAD + 1;
    }
    _ce_i = _ce_i + 1;
}
assert_eq(_G4_MC_RUN, 10, "calc_monotone_cubic growing sweep actually ran 10 x-axis scales");
assert_eq(_G4_MC_BAD, 0,
  "calc_monotone_cubic: 2.25 bit-exact from x-scale 2^+90 up to 2^+1022 (D068: 2.0 at 2^+100)");

var _G4_MY_RUN = 0;
var _G4_MY_BAD = 0;
var _g4_yexps = _f64arr_alloc(11);
_f64arr_set(_g4_yexps, 0, 0 - 99);   _f64arr_set(_g4_yexps, 1, 0 - 100);
_f64arr_set(_g4_yexps, 2, 0 - 101);  _f64arr_set(_g4_yexps, 3, 0 - 200);
_f64arr_set(_g4_yexps, 4, 0 - 500);  _f64arr_set(_g4_yexps, 5, 0 - 1000);
_f64arr_set(_g4_yexps, 6, 0 - 1022); _f64arr_set(_g4_yexps, 7, 0 - 1023);
_f64arr_set(_g4_yexps, 8, 0 - 1030); _f64arr_set(_g4_yexps, 9, 0 - 1050);
_f64arr_set(_g4_yexps, 10, 0 - 1072);
var _g4_ux = _f64arr_alloc(4);
_f64arr_set(_g4_ux, 0, 0);
_f64arr_set(_g4_ux, 1, F64_ONE);
_f64arr_set(_g4_ux, 2, F64_TWO);
_f64arr_set(_g4_ux, 3, f64_from(3));
_ce_i = 0;
while (_ce_i < 11) {
    var _g4_ye = _f64arr_get(_g4_yexps, _ce_i);
    var _g4_sy = 0;
    if (_g4_ye < 0 - 1022) {
        _g4_sy = f64_mul(_ce_p2(0 - 1000), _ce_p2(_g4_ye + 1000));
    } else {
        _g4_sy = _ce_p2(_g4_ye);
    }
    var _g4_yy = _f64arr_alloc(4);
    _f64arr_set(_g4_yy, 0, 0);
    _f64arr_set(_g4_yy, 1, _g4_sy);
    _f64arr_set(_g4_yy, 2, f64_mul(_g4_sy, f64_from(4)));
    _f64arr_set(_g4_yy, 3, f64_mul(_g4_sy, f64_from(9)));
    _G4_MY_RUN = _G4_MY_RUN + 1;
    var _g4_yv = _cmc(_g4_ux, _g4_yy, 4, f64_add(F64_ONE, F64_HALF));
    if (_g4_yv != f64_mul(0x4002000000000000, _g4_sy)) {
        _G4_MY_BAD = _G4_MY_BAD + 1;
    }
    _ce_i = _ce_i + 1;
}
assert_eq(_G4_MY_RUN, 11, "calc_monotone_cubic y-scale sweep actually ran 11 scales");
assert_eq(_G4_MY_BAD, 0,
  "calc_monotone_cubic: 2.25 * 2^j bit-exact for y-scales 2^-99 down to 2^-1072 (D068)");
# The subnormal end on its own, so a failure names the half of the sweep it is in:
# ys = 2^-1023 [0,1,4,9] (bits 0x0008.., 0x0020.., 0x0032..) has subnormal slopes;
# f(1.5) is 2.25 * 2^-1023 = 0x0012000000000000, and 0x0014000000000000 (2.5x) flat.
# [measured: 83-scale y sweep on a DBL_MIN-threshold build, 2026-10-01]
var _g4_ysub = _f64arr_alloc(4);
_f64arr_set(_g4_ysub, 0, 0);
_f64arr_set(_g4_ysub, 1, 0x0008000000000000);
_f64arr_set(_g4_ysub, 2, 0x0020000000000000);
_f64arr_set(_g4_ysub, 3, 0x0032000000000000);
assert_eq(_cmc(_g4_ux, _g4_ysub, 4, f64_add(F64_ONE, F64_HALF)), 0x0012000000000000,
  "calc_monotone_cubic: subnormal slopes are tangents, not a flat segment (2.25 * 2^-1023)");

# ⛔ THE SECOND HALF OF THE REPAIR. An exact-zero test alone lets a subnormal secant
# reach alpha = m/delta, which overflows to +Inf, and the circle projection then
# formed tau * alpha = 0 * Inf = NaN. ys = [-1, 0, 2^-1074, 1] on the unit grid is
# that case: 3.3.2 flattened the middle interval and the exact-zero-only build
# returned NaN at all three queries. Settled by hand, and by a 400-digit exact
# Fritsch-Carlson oracle that rounds once at the end: the projected tangents at the
# middle knots are 3|delta|/sqrt(2), about 2.1 * 2^-1074, so at x = 0.5 the value is
# -1/2 + 1/8 - (1/8)(2.1 * 2^-1074), which rounds to -0.375, and at x = 2.5 it is
# 1/2 - 1/8 plus terms of order 2^-1074, which round to 0.375.
# [measured: part-1-only and part-2-only bundles against these fixtures, 2026-10-01]
var _g4_sy1 = _f64arr_alloc(4);
_f64arr_set(_g4_sy1, 0, f64_neg(F64_ONE));
_f64arr_set(_g4_sy1, 1, 0);
_f64arr_set(_g4_sy1, 2, 1);
_f64arr_set(_g4_sy1, 3, F64_ONE);
assert_eq(_cmc(_g4_ux, _g4_sy1, 4, F64_HALF), 0xBFD8000000000000,
  "calc_monotone_cubic: a subnormal secant is projected, not 0 * Inf (-0.375 at x = 0.5)");
assert_eq(_cmc(_g4_ux, _g4_sy1, 4, f64_add(F64_TWO, F64_HALF)), 0x3FD8000000000000,
  "calc_monotone_cubic: a subnormal secant is projected, not 0 * Inf (0.375 at x = 2.5)");

# The same overflow WITHOUT the exact-zero test: the 1e-30 guard passed any secant
# above 2^-99.66, so a neighbour 2^1024 times larger still overflowed alpha. Here
# delta = [2^1000, 2^-90] and the shared tangent is 2^999, so alpha = 2^1089. 3.3.2
# returned NaN on BOTH intervals. Settled by hand and by the same exact oracle: the
# projection sends the middle tangent to 3 * 2^-90 and the last to ~0, so
# f(2^89) = 1/2 + (1/8)(2^90)(3 * 2^-90) + 1 = 1.875 and
# f(2^-1001) = (1/8)(2^-1000)(2^1000) + 1/2 = 0.625, each with a correction below
# 2^-1000 that rounds away.
# [measured: scratch harness, not reproducible in-tree, 2026-10-01; 3.3.2 bundle vs this tree]
var _g4_ox = _f64arr_alloc(3);
_f64arr_set(_g4_ox, 0, 0);
_f64arr_set(_g4_ox, 1, _ce_p2(0 - 1000));
_f64arr_set(_g4_ox, 2, _ce_p2(90));
var _g4_oy = _f64arr_alloc(3);
_f64arr_set(_g4_oy, 0, 0);
_f64arr_set(_g4_oy, 1, F64_ONE);
_f64arr_set(_g4_oy, 2, F64_TWO);
assert_eq(_cmc(_g4_ox, _g4_oy, 3, _ce_p2(89)), 0x3FFE000000000000,
  "calc_monotone_cubic: an overflowing alpha is projected in tangent space (1.875, was NaN)");
assert_eq(_cmc(_g4_ox, _g4_oy, 3, _ce_p2(0 - 1001)), 0x3FE4000000000000,
  "calc_monotone_cubic: the neighbouring interval is not poisoned (0.625, was NaN)");

# The two fixtures above cannot see the projection's MAGNITUDE or SIGN: one has the
# result in the subnormal noise, the other a single dominant tangent. Here BOTH
# ratios overflow (delta = [2^966, 2^-60, 2^966], tangents 2^965 at both middle
# knots), the two tangents are equal so the hypot matters, and the interval's values
# are normal: f(1.25) = (0.09375 * 3/sqrt(2) + 0.15625) * 2^-60. The exact oracle
# gives 0x3C16BA5919A791A3; the implementation's own rounding (hypot, four products,
# three sums) lands one ulp below, and that is the value pinned. Descending data is
# the exact negation — the sign comes from m_i, never from di. 3.3.2: NaN, both.
# [measured: scratch harness, not reproducible in-tree, 2026-10-01; 3.3.2, this tree, exact oracle]
var _g4_bx = _f64arr_alloc(4);
_f64arr_set(_g4_bx, 0, 0);
_f64arr_set(_g4_bx, 1, F64_ONE);
_f64arr_set(_g4_bx, 2, F64_TWO);
_f64arr_set(_g4_bx, 3, f64_from(3));
var _g4_by = _f64arr_alloc(4);
_f64arr_set(_g4_by, 0, f64_neg(_ce_p2(966)));
_f64arr_set(_g4_by, 1, 0);
_f64arr_set(_g4_by, 2, _ce_p2(0 - 60));
_f64arr_set(_g4_by, 3, _ce_p2(966));
var _g4_bd = _f64arr_alloc(4);
_f64arr_set(_g4_bd, 0, _ce_p2(966));
_f64arr_set(_g4_bd, 1, 0);
_f64arr_set(_g4_bd, 2, f64_neg(_ce_p2(0 - 60)));
_f64arr_set(_g4_bd, 3, f64_neg(_ce_p2(966)));
var _g4_bq = f64_add(F64_ONE, 0x3FD0000000000000);
assert_eq(_cmc(_g4_bx, _g4_by, 4, _g4_bq), 0x3C16BA5919A791A2,
  "calc_monotone_cubic: both ratios overflow -> 3/sqrt(2)-projected tangents (was NaN)");
assert_eq(_cmc(_g4_bx, _g4_bd, 4, _g4_bq), 0xBC16BA5919A791A2,
  "calc_monotone_cubic: descending data, both ratios overflow -> the exact negation");

# The tangent-space form is used ONLY when `root` overflows. Applied to every
# projection it changes 14,322 of 350,000 results on random full-mantissa sets, and
# on a 1,500-result sample of those it is not consistently closer to the exact
# oracle (the shipped form is closer 732 times, the tangent-space form 678, 90
# tie) — so the finite branch keeps 3.3.2's bits, all 350,000 of which are
# unchanged. This set fires the projection on a finite root; its value is the
# correctly rounded exact one, which the tangent-space form misses by 2 ulps.
# [measured: random-set probe on 3.3.2, this tree and that variant, plus the exact oracle, 2026-10-01]
var _g4_fx = _f64arr_alloc(4);
_f64arr_set(_g4_fx, 0, 0);
_f64arr_set(_g4_fx, 1, 0x3FE3C03D901978A6);
_f64arr_set(_g4_fx, 2, 0x3FED8B4BA8FC2380);
_f64arr_set(_g4_fx, 3, 0x3FF78C7145A0B111);
var _g4_fy = _f64arr_alloc(4);
_f64arr_set(_g4_fy, 0, 0x3FD6FFB7684D9D4E);
_f64arr_set(_g4_fy, 1, 0x3FF3977D06237E76);
_f64arr_set(_g4_fy, 2, 0x404270C4D2ADFDF4);
_f64arr_set(_g4_fy, 3, 0x4042B0336F6327FA);
assert_eq(_cmc(_g4_fx, _g4_fy, 4, 0x3FDA42317E6445F9), 0x3FE3C8425CE98C5A,
  "calc_monotone_cubic: a finite-root projection keeps 3.3.2's bits (here the correctly rounded value)");

# --- I. The controls the repair must KEEP passing. The guard says "not sorted",
# so it must still reject genuinely unsorted, duplicated and NaN abscissae —
# otherwise the fix is just a deletion wearing a comment.
var _ce_uy = _f64arr_alloc(4);
_f64arr_set(_ce_uy, 0, 0);
_f64arr_set(_ce_uy, 1, F64_ONE);
_f64arr_set(_ce_uy, 2, f64_from(4));
_f64arr_set(_ce_uy, 3, f64_from(9));

# ⚠ (a) The obvious control — a fully DESCENDING grid — is VACUOUS and was
# measured to be: with xs = [0,-1,-2,-3] the range gate x0 <= x <= xn rejects every
# query before the loop is entered, so it returns 0 with any guard at all,
# including none. A grid that only dips in the MIDDLE stays in range and reaches it.
# [measured: 0 of 129 sampled queries reach the loop on a descending grid]
var _ce_ux = _f64arr_alloc(4);
_f64arr_set(_ce_ux, 0, 0);
_f64arr_set(_ce_ux, 1, F64_TWO);
_f64arr_set(_ce_ux, 2, F64_ONE);
_f64arr_set(_ce_ux, 3, f64_from(3));
assert_eq(_cmc_err(_ce_ux, _ce_uy, 4, F64_HALF), HSB_ERR_INVALID_INPUT,
  "calc_monotone_cubic: a mid-grid inversion is still rejected");

var _ce_dx = _f64arr_alloc(4);
_f64arr_set(_ce_dx, 0, 0);
_f64arr_set(_ce_dx, 1, F64_ONE);
_f64arr_set(_ce_dx, 2, F64_ONE);
_f64arr_set(_ce_dx, 3, F64_TWO);
assert_eq(_cmc_err(_ce_dx, _ce_uy, 4, F64_HALF), HSB_ERR_INVALID_INPUT,
  "calc_monotone_cubic: a duplicated abscissa is still rejected (zero width)");

# ⭐ (b) NaN. This is why the repair is `f64_gt(hi, 0) == 0` and not a smaller
# threshold: `f64_lt(NaN, anything)` is 0, so the old shape — and an F64_TINY
# version of it — lets a NaN abscissa straight through and returns NaN. A
# not-greater test is false for NaN and rejects it.
var _ce_nx = _f64arr_alloc(4);
_f64arr_set(_ce_nx, 0, 0);
_f64arr_set(_ce_nx, 1, 0x7FF8000000000000);
_f64arr_set(_ce_nx, 2, F64_TWO);
_f64arr_set(_ce_nx, 3, f64_from(3));
assert_eq(_cmc_err(_ce_nx, _ce_uy, 4, F64_HALF), HSB_ERR_INVALID_INPUT,
  "calc_monotone_cubic: a NaN abscissa is rejected, not propagated");

# ⭐ (c) SPAN-RELATIVE DISCRIMINATOR. A guard of the form `hi < eps*(xn - x0)` is
# scale-free and passes sweep H untouched, because hi/(xn-x0) is 1/3 at every
# scale there. Only a grid with ONE fine interval separates it from the sign test.
var _ce_rx = _f64arr_alloc(4);
_f64arr_set(_ce_rx, 0, 0);
_f64arr_set(_ce_rx, 1, _ce_p2(0 - 40));
_f64arr_set(_ce_rx, 2, F64_ONE);
_f64arr_set(_ce_rx, 3, F64_TWO);
var _ce_ry = _f64arr_alloc(4);
_f64arr_set(_ce_ry, 0, 0);
_f64arr_set(_ce_ry, 1, 0);
_f64arr_set(_ce_ry, 2, F64_ONE);
_f64arr_set(_ce_ry, 3, F64_TWO);
assert(_cmc(_ce_rx, _ce_ry, 4,
    f64_add(F64_ONE, F64_HALF)) != 0,
  "calc_monotone_cubic: one fine interval far from the query is not a rejection");

# === 3.3.3 W4: calc_monotone_cubic overflowing differences ===
# ⛔ Three naive differences overflowed on FINITE data, and the function returned NaN
# or +Inf where the data and the answer are both representable: the initial tangent
# 0.5 * (d[i-1] + d[i]), the y difference of a secant, and the x difference of a grid
# wider than DBL_MAX. Every fixture before the closing control was non-finite on the
# 3.3.2 bundle and on the tree without this repair. Each value is settled by an exact rational
# Fritsch-Carlson oracle that rounds once (the three repros and fixtures 1, 2, 3, 3b
# are its correctly rounded value; fixture 4 is 3 ulps from it), and each full-mantissa one
# by a SECOND CODE PATH as well: the unchanged in-range algorithm, run on the same
# set scaled into range by 1/4 (exact), gives the same bits — which is the repair's
# whole claim. The fixtures are full-mantissa so a lost doubling cannot cancel.
# [measured: fixture probe on the 3.3.2 bundle, the base tree and this tree, exact oracle; 2026-10-01]
fn _w4_mc3(x0, x1, x2, y0, y1, y2, q) {
    var xs = _f64arr_alloc(3);
    _f64arr_set(xs, 0, x0);
    _f64arr_set(xs, 1, x1);
    _f64arr_set(xs, 2, x2);
    var ys = _f64arr_alloc(3);
    _f64arr_set(ys, 0, y0);
    _f64arr_set(ys, 1, y1);
    _f64arr_set(ys, 2, y2);
    return _cmc(xs, ys, 3, q);
}
var _W4_Q = 0x3FD0000000000000;  # 1/4, the exact scale of the second code path
var _w4_p = _ce_p2(1023);
var _w4_n = f64_neg(_ce_p2(1023));

# (a) THE MIDPOINT. ys = [-2^1023, 0, 2^1023] on the unit grid is LINEAR data; both
# secants are 2^1023 and their sum overflowed. NaN everywhere, even at the knot.
assert_eq(_w4_mc3(0, F64_ONE, F64_TWO, _w4_n, 0, _w4_p, F64_HALF), 0xFFD0000000000000,
  "calc_monotone_cubic: overflowing tangent midpoint -> -2^1022 at x = 0.5 (was NaN)");
assert_eq(_w4_mc3(0, F64_ONE, F64_TWO, _w4_n, 0, _w4_p, F64_ONE), 0,
  "calc_monotone_cubic: overflowing tangent midpoint -> +0 at the knot x = 1 (was NaN)");
assert_eq(_w4_mc3(0, F64_ONE, F64_TWO, _w4_n, 0, _w4_p, f64_add(F64_ONE, F64_HALF)),
  0x7FD0000000000000, "calc_monotone_cubic: overflowing tangent midpoint -> 2^1022 at x = 1.5");
# Fixture 1: secants 1.18 and 1.92 times 2^1023, the query on the second interval.
assert_eq(_w4_mc3(0, 0x3FE6B4D8A2FA505B, 0x3FF395300FB59C72,
    0xFFDA220AC9E358E3, 0x7F8A1551588FED60, 0x7FE0350EE8DA4526, 0x3FE70EEAAC17AD1A),
  0x7F95DF8F80B7B2E1, "calc_monotone_cubic: full-mantissa midpoint overflow, exact value (was NaN)");
assert_eq(f64_div(_w4_mc3(0, 0x3FE6B4D8A2FA505B, 0x3FF395300FB59C72,
      f64_mul(0xFFDA220AC9E358E3, _W4_Q), f64_mul(0x7F8A1551588FED60, _W4_Q),
      f64_mul(0x7FE0350EE8DA4526, _W4_Q), 0x3FE70EEAAC17AD1A), _W4_Q),
  0x7F95DF8F80B7B2E1, "calc_monotone_cubic: fixture 1 = 4 x the in-range path on ys/4");

# (b) THE Y DIFFERENCE. 2^1023 - (-2^1023) overflowed, so the first secant was +Inf.
assert_eq(_w4_mc3(0, f64_from(4), f64_from(8), _w4_n, _w4_p, _w4_p, F64_TWO), 0x7FC0000000000000,
  "calc_monotone_cubic: overflowing y difference -> 2^1021 at x = 2 (was +Inf)");
# Fixture 2: the second interval's y difference is -2.6 * 2^1023; query on it.
assert_eq(_w4_mc3(0x4054920FAABB4704, 0x405AF0C52E48AF3C, 0x405BB8C829B733E0,
    0x7FDD3B786313C8F6, 0x7FE208E80C4994E4, 0xFFE7D20CDC4C27AE, 0x405B359E59059316),
  0x7FD3A577170CDD45, "calc_monotone_cubic: full-mantissa y-difference overflow, exact value (was +Inf)");
assert_eq(f64_div(_w4_mc3(0x4054920FAABB4704, 0x405AF0C52E48AF3C, 0x405BB8C829B733E0,
      f64_mul(0x7FDD3B786313C8F6, _W4_Q), f64_mul(0x7FE208E80C4994E4, _W4_Q),
      f64_mul(0xFFE7D20CDC4C27AE, _W4_Q), 0x405B359E59059316), _W4_Q),
  0x7FD3A577170CDD45, "calc_monotone_cubic: fixture 2 = 4 x the in-range path on ys/4");

# (c) THE X DIFFERENCE. A grid from -2^1023 to 2^1023 has hi = +Inf: the secant was 0
# and h10 = p10 * Inf. ⚠ This repro alone is weak: it is linear data queried at
# t = 1/2, where h10 and h11 cancel exactly — so it sees a LOST DOUBLING of either,
# but even a flattened secant gives 0.5. Fixtures 3 and 3b (t = 0.30) see the wide
# secant; 3b is monotone, so both of its tangents are non-zero (3 has an extremum at
# knot 1, whose tangent the sign condition zeroes, and cannot see h11).
# [measured: per-part mutants against this block, 2026-10-01]
var _w4_cx = _f64arr_alloc(2);
_f64arr_set(_w4_cx, 0, _w4_n);
_f64arr_set(_w4_cx, 1, _w4_p);
var _w4_cy = _f64arr_alloc(2);
_f64arr_set(_w4_cy, 0, 0);
_f64arr_set(_w4_cy, 1, F64_ONE);
assert_eq(_cmc(_w4_cx, _w4_cy, 2, 0), F64_HALF,
  "calc_monotone_cubic: grid wider than DBL_MAX -> 0.5 at x = 0 (was NaN)");
# Fixture 3: interval 0 is 2.5 * 2^1023 wide, ys near 1e5.
assert_eq(_w4_mc3(0xFFE51D6483A293A0, 0x7FE34E54F249528E, 0x7FEF176D15A73E4C,
    0x40F7C1A7AF16606D, 0x40F8E196364799CD, 0x40F3619B8318B361, 0xFFD1D1A93F065B20),
  0x40F82AEC6EE88C07, "calc_monotone_cubic: full-mantissa wide grid, exact value (was NaN)");
assert_eq(_w4_mc3(f64_mul(0xFFE51D6483A293A0, _W4_Q), f64_mul(0x7FE34E54F249528E, _W4_Q),
    f64_mul(0x7FEF176D15A73E4C, _W4_Q), 0x40F7C1A7AF16606D, 0x40F8E196364799CD,
    0x40F3619B8318B361, f64_mul(0xFFD1D1A93F065B20, _W4_Q)),
  0x40F82AEC6EE88C07, "calc_monotone_cubic: fixture 3 = the in-range path on xs/4");
# Fixture 3b: the same grid with the ordinates sorted.
assert_eq(_w4_mc3(0xFFE51D6483A293A0, 0x7FE34E54F249528E, 0x7FEF176D15A73E4C,
    0x40F3619B8318B361, 0x40F7C1A7AF16606D, 0x40F8E196364799CD, 0xFFD1D1A93F065B20),
  0x40F4B807CE6F3628, "calc_monotone_cubic: full-mantissa wide grid, monotone, exact value (was NaN)");
assert_eq(_w4_mc3(f64_mul(0xFFE51D6483A293A0, _W4_Q), f64_mul(0x7FE34E54F249528E, _W4_Q),
    f64_mul(0x7FEF176D15A73E4C, _W4_Q), 0x40F3619B8318B361, 0x40F7C1A7AF16606D,
    0x40F8E196364799CD, f64_mul(0xFFD1D1A93F065B20, _W4_Q)),
  0x40F4B807CE6F3628, "calc_monotone_cubic: fixture 3b = the in-range path on xs/4");
# Fixture 4: BOTH differences of interval 0 overflow (3.1 and 3.0 times 2^1023).
assert_eq(_w4_mc3(0xFFE9C3A5E7F1B2D4, 0x7FE7E1C2B9D4A6F3, 0x7FEF2B4C6D8E9A17,
    0xFFE5D2C7E9A3B1F8, 0x7FEA3E5C1F7B9D24, 0x7FD1B7D9E3C5A2F6, 0xFFD5C3E9D2A7B1F4),
  0xFFC1902FEDAB2070, "calc_monotone_cubic: x and y differences both overflow (was NaN)");
assert_eq(f64_div(_w4_mc3(f64_mul(0xFFE9C3A5E7F1B2D4, _W4_Q), f64_mul(0x7FE7E1C2B9D4A6F3, _W4_Q),
      f64_mul(0x7FEF2B4C6D8E9A17, _W4_Q), f64_mul(0xFFE5D2C7E9A3B1F8, _W4_Q),
      f64_mul(0x7FEA3E5C1F7B9D24, _W4_Q), f64_mul(0x7FD1B7D9E3C5A2F6, _W4_Q),
      f64_mul(0xFFD5C3E9D2A7B1F4, _W4_Q)), _W4_Q),
  0xFFC1902FEDAB2070, "calc_monotone_cubic: fixture 4 = 4 x the in-range path on xs/4, ys/4");

# ⚠ THE CONTROL: an infinite ABSCISSA is not a wide grid. Its halved width is still
# +Inf, so it keeps the naive quotient — here (MAX - (-MAX)) / Inf = Inf / Inf, NaN,
# which the next interval's tangent inherits, exactly as before the repair. A
# fallback that ignored the difference would hand that interval a finite value
# computed from a non-finite input.
var _w4_inf = _w4_mc3(f64_neg(F64_POS_INF), 0, F64_ONE,
  0xFFEFFFFFFFFFFFFF, 0x7FEFFFFFFFFFFFFF, 0, F64_HALF);
assert_eq(f64_eq(_w4_inf, _w4_inf), 0,
  "calc_monotone_cubic: an infinite abscissa beside an overflowing y difference stays NaN");

# === 3.3.3 R4calc: calc_monotone_cubic infinite tangents and the overflow gate ===
# ⛔ Each set in (a) to (d) has a secant whose exact slope is above DBL_MAX — the class
# the secant loop names and does not repair — so the tangents beside it are infinite.
# The projection's tangent-space branch (the G4 block above) made NaN of them on
# FINITE data, at DATA KNOTS too, where 3.3.2 returned the knot's own y, and replacing
# an infinite tangent by its limit then gave finite, wrong values (the R5calc block
# below). Such a set now gets 3.3.2's computation bit for bit, so every value pinned
# in (a) to (d) is 3.3.2's: a knot's own bits, a value an ulp from the exact
# Fritsch-Carlson one (an exact rational oracle, rounded once), or 3.3.2's NaN where
# the exact value is finite, each named. (e) pins the overflow gate on finite data.
# [measured: fixture probe on the 3.3.2 bundle, the base tree and this tree, exact oracle; 2026-10-01]
# ⛔ 3.3.4 — EVERY SET IN (a) TO (d) IS FINITE DATA WITH A SLOPE PAST DBL_MAX, and is now
# splined in extended range (calc_ext.cyr, _calcx_mc_ext): each pin below that held
# 3.3.2's value or NaN now holds the exact value rounded once — the value named here
# as exact — except where it says otherwise.
# [measured: fixture probe on the base tree and this tree, exact oracle; 2026-10-03; cycc 6.6.14]
fn _r4c_mc4(x0, x1, x2, x3, y0, y1, y2, y3, q) {
    var xs = _f64arr_alloc(4);
    _f64arr_set(xs, 0, x0);
    _f64arr_set(xs, 1, x1);
    _f64arr_set(xs, 2, x2);
    _f64arr_set(xs, 3, x3);
    var ys = _f64arr_alloc(4);
    _f64arr_set(ys, 0, y0);
    _f64arr_set(ys, 1, y1);
    _f64arr_set(ys, 2, y2);
    _f64arr_set(ys, 3, y3);
    return _cmc(xs, ys, 4, q);
}

# (a) THE OVERFLOWING WEIGHT. xs = [0, 0.5, 1.5, 2.5], ys = [-2^1023, 0, 1.5 * 2^1022,
# 1.75 * 2^1022]: interval 0's slope is 2^1024, so the knot-1 tangent is +Inf, and
# interval 1's |delta| = 1.5 * 2^1022 > DBL_MAX/3. The tangent-space branch formed
# 0 * 3|delta| = 0 * Inf for the knot-2 tangent and returned NaN at the knots 1.5 and
# 2.5. 3.3.2 returned these knots' y; so does this tree.
var _r4c_ah = 0x3FF8000000000000;  # 1.5
var _r4c_ay2 = 0x7FD8000000000000;  # 1.5 * 2^1022
var _r4c_ay3 = 0x7FDC000000000000;  # 1.75 * 2^1022
assert_eq(_r4c_mc4(0, F64_HALF, _r4c_ah, 0x4004000000000000, _w4_n, 0, _r4c_ay2, _r4c_ay3, _r4c_ah),
  _r4c_ay2, "calc_monotone_cubic: 3|delta| past DBL_MAX, knot x = 1.5 is y2 (was NaN)");
assert_eq(_r4c_mc4(0, F64_HALF, _r4c_ah, 0x4004000000000000, _w4_n, 0, _r4c_ay2, _r4c_ay3,
    0x4004000000000000), _r4c_ay3, "calc_monotone_cubic: 3|delta| past DBL_MAX, knot x = 2.5 is y3 (was NaN)");
# ⚠ Between those knots the value is finite and inside [y2, y3]. Through 3.3.3 it was
# 3.3.2's 0x7FD9800000000000, 0.38 of the interval's rise below the exact
# 0x7FDB07BB76E265E5, because the overflowed slope of interval 0 projected a tangent
# exact arithmetic leaves alone; 3.3.4 (the slope in extended range) returns the exact
# value, pinned below. NaN is tested first: every comparison with it is 0.
var _r4c_amid = _r4c_mc4(0, F64_HALF, _r4c_ah, 0x4004000000000000, _w4_n, 0, _r4c_ay2, _r4c_ay3, F64_TWO);
var _r4c_aok = 0;
if (f64_eq(_r4c_amid, _r4c_amid) == 1 && f64_lt(_r4c_amid, _r4c_ay2) == 0 && f64_lt(_r4c_ay3, _r4c_amid) == 0) {
    _r4c_aok = 1;
}
assert_eq(_r4c_aok, 1, "calc_monotone_cubic: 3|delta| past DBL_MAX, x = 2.0 is a number inside [y2, y3] (was NaN)");
assert_eq(_r4c_amid, 0x7FDB07BB76E265E5,
  "calc_monotone_cubic: 3|delta| past DBL_MAX, x = 2.0, exact (3.3.3: 3.3.2's 0x7FD9800000000000)");

# (b) AN INFINITE TANGENT BESIDE A SECANT IN 3.3.2's FLAT BAND. xs = [0, 2^-1000,
# 2^90], ys = [0, 2^30, 2^30 + 2^-22]: interval 0's slope is 2^1030, so the knot-1
# tangent is +Inf, and interval 1's secant is 2^-112, which 3.3.2's 1e-30 test
# flattens. The tangent-space branch returned NaN at all three queries; 3.3.2 and 3.3.3
# return y at both knots and 0x41D0000000000000 at 2^89, an ulp below the exact
# 0x41D0000000000001, which 3.3.4 returns.
var _r4c_bx1 = _ce_p2(0 - 1000);
var _r4c_by1 = _ce_p2(30);
var _r4c_by2 = f64_add(_ce_p2(30), _ce_p2(0 - 22));
assert_eq(_w4_mc3(0, _r4c_bx1, _ce_p2(90), 0, _r4c_by1, _r4c_by2, _r4c_bx1), 0x41D0000000000000,
  "calc_monotone_cubic: an infinite tangent, knot x = 2^-1000 is y1 (was NaN)");
assert_eq(_w4_mc3(0, _r4c_bx1, _ce_p2(90), 0, _r4c_by1, _r4c_by2, _ce_p2(89)), 0x41D0000000000001,
  "calc_monotone_cubic: an infinite tangent's interval at 2^89, exact (3.3.3: an ulp low; 3.3.2: NaN)");
assert_eq(_w4_mc3(0, _r4c_bx1, _ce_p2(90), 0, _r4c_by1, _r4c_by2, _ce_p2(90)), 0x41D0000000000001,
  "calc_monotone_cubic: an infinite tangent, knot x = 2^90 is y2 (was NaN)");
# Descending, the exact negation (3.3.3 returned the negation of 3.3.2's 0x41D0000000000000).
assert_eq(_w4_mc3(0, _r4c_bx1, _ce_p2(90), 0x8000000000000000, f64_neg(_r4c_by1), f64_neg(_r4c_by2),
    _ce_p2(89)), 0xC1D0000000000001, "calc_monotone_cubic: a -Inf tangent, the exact negation (3.3.3: an ulp low)");
# Full mantissa: a secant above 1e-30 beside the infinite tangent. 3.3.2's projection
# meets alpha = +Inf, so tau = 0 and that tangent is 0 * Inf: NaN on the whole
# interval, where the exact values are 0x41D00000003A3B21 and 0x41D00000004520D7. 3.3.3
# kept 3.3.2's NaN (the R5calc block below says why); 3.3.4 returns the exact values.
assert_eq(_w4_mc3(0, _r4c_bx1, F64_ONE, 0, _r4c_by1, 0x41D00000004F00F6, 0x3FD6FFB7684D9D4E), 0x41D00000003A3B21,
  "calc_monotone_cubic: an infinite tangent beside a unit-scale secant, interior, exact (3.3.3: NaN)");
assert_eq(_w4_mc3(0, _r4c_bx1, F64_ONE, 0, _r4c_by1, 0x41D00000004F00F6, F64_HALF), 0x41D00000004520D7,
  "calc_monotone_cubic: an infinite tangent beside a unit-scale secant, midpoint, exact (3.3.3: NaN)");

# (c) A -Inf TANGENT BESIDE A UNIT SECANT. xs = [0, 2^-1000, 1, 2], ys = [2^30, 1, -0,
# -1]: the knot-1 tangent is -Inf, so interval 1 was 3.3.2's NaN through 3.3.3 (the exact
# value at x = 0.5 is 0.125, 3.3.4's), and the knot-2 tangent is the zero the projection leaves, of
# the partner's own sign: the knot x = 1, whose ordinate is -0, returns -0, and
# x = 1.5 the exact -0.375.
var _r4c_zm = f64_neg(F64_ONE);
assert_eq(_r4c_mc4(0, _r4c_bx1, F64_ONE, F64_TWO, _r4c_by1, F64_ONE, 0x8000000000000000, _r4c_zm, F64_HALF),
  0x3FC0000000000000, "calc_monotone_cubic: a -Inf tangent beside a unit secant, 0.125 exact (3.3.3: NaN)");
assert_eq(_r4c_mc4(0, _r4c_bx1, F64_ONE, F64_TWO, _r4c_by1, F64_ONE, 0x8000000000000000, _r4c_zm, F64_ONE),
  0x8000000000000000, "calc_monotone_cubic: the zeroed partner keeps its sign, so the -0 knot stays -0 (bits)");
assert_eq(_r4c_mc4(0, _r4c_bx1, F64_ONE, F64_TWO, _r4c_by1, F64_ONE, 0x8000000000000000, _r4c_zm,
    _r4c_ah), 0xBFD8000000000000, "calc_monotone_cubic: the zeroed partner's own interval, -0.375 at x = 1.5");

# (d) BOTH TANGENTS INFINITE. xs = [-2^-1000, 0, 1, 1 + 2^-52], ys = [-2^30, 0, 1,
# 2^1000]: the slopes of intervals 0 and 2 are both past DBL_MAX, so interval 1 has
# two infinite tangents and no ratio between them. 3.3.2 and 3.3.3 returned NaN on
# the whole interval, its knots included, where the exact values are +0 at x = 0 and
# 0x3F900006C0000480 at x = 0.25; an equal split of the two, which the limit made,
# returned 0x3FD6BA5919A791A2 (0.355) there.
# [measured: fixture probe on the 3.3.2 bundle, the base tree and this tree, exact oracle; 2026-10-01]
var _r4c_ix3 = f64_add(F64_ONE, _ce_p2(0 - 52));
var _r4c_iy0 = f64_neg(_ce_p2(30));
assert_eq(_r4c_mc4(f64_neg(_r4c_bx1), 0, F64_ONE, _r4c_ix3, _r4c_iy0, 0, F64_ONE, _ce_p2(1000), 0), 0,
  "calc_monotone_cubic: two infinite tangents, the knot x = 0 is its +0 (3.3.3: NaN)");
assert_eq(_r4c_mc4(f64_neg(_r4c_bx1), 0, F64_ONE, _r4c_ix3, _r4c_iy0, 0, F64_ONE, _ce_p2(1000),
    0x3FD0000000000000), 0x3F900006C0000480,
  "calc_monotone_cubic: two infinite tangents, x = 0.25, exact (3.3.3: NaN)");

# (e) THE OVERFLOW GATE. W4 sends a secant through _calcx_mc_wide_secant only when a
# naive difference overflowed; in range the naive quotient is the correctly rounded
# one, and the halved form rounds a SUBNORMAL quotient at half scale. xs = [0,
# 2^1000], ys = [0, 3 * 2^-74] is linear data with the exact secant 3 * 2^-1074: the
# halved quotient is 1.5 * 2^-1074, rounded to 2 * 2^-1074 and doubled to 4, and at
# x = 2^998 the ungated form returns 0x3B4B000000000000 where the exact value is
# 0.75 * 2^-74. 3.3.2 flattened that secant (D068) and returned 0x3B3E000000000000.
# The full-mantissa set is the same shape; ungated, it returns 0xB8FE8518A195BE6D,
# 3 ulps from the exact value pinned.
# [measured: ungated-helper build against these fixtures, exact oracle; 2026-10-01]
var _r4c_gx = _f64arr_alloc(2);
_f64arr_set(_r4c_gx, 0, 0);
_f64arr_set(_r4c_gx, 1, _ce_p2(1000));
var _r4c_gy = _f64arr_alloc(2);
_f64arr_set(_r4c_gy, 0, 0);
_f64arr_set(_r4c_gy, 1, f64_mul(f64_from(3), _ce_p2(0 - 74)));
assert_eq(_cmc(_r4c_gx, _r4c_gy, 2, _ce_p2(998)), 0x3B48000000000000,
  "calc_monotone_cubic: an in-range subnormal secant takes the naive quotient (0.75 * 2^-74, exact)");
_f64arr_set(_r4c_gx, 1, 0x79529E423A3D6466);
_f64arr_set(_r4c_gy, 0, 0xB8FF845AA3026E4A);
_f64arr_set(_r4c_gy, 1, 0xB8FD6FE723AE2615);
assert_eq(_cmc(_r4c_gx, _r4c_gy, 2, 0x7941D9E6F80DAC57), 0xB8FE8518A195BE70,
  "calc_monotone_cubic: in range, full mantissa, the naive quotient (exact value)");

# === 3.3.3 R5calc: calc_monotone_cubic, a set with a non-finite secant is 3.3.2's ===
# ⛔ The limit (R4calc above) gave finite, monotone, WRONG values, some where 3.3.2 was
# right: on E2 below 0x38E0000000000000 at x = 0.5, where 3.3.2 gives 0x3900000000000000
# and the exact value is 0x38FFFFFFFFFFEE00, and on E1 0.125 where the exact value is
# about 0.5 and 3.3.2 returns NaN. A set with a non-finite secant now gets 3.3.2's whole
# computation, so each value here is 3.3.2's bits — its right answers and its NaNs — and
# each part of that computation is pinned where a 3.3.3 step would change it. Exact
# values come from an exact rational Fritsch-Carlson oracle, rounded once.
# [measured: fixture probe on the 3.3.2 bundle, the base tree and this tree, exact oracle; 2026-10-01]
# ⛔ 3.3.4 — THE FINITE SETS HERE ARE NOW SPLINED IN EXTENDED RANGE (calc_ext.cyr,
# _calcx_mc_ext), and each pin that held 3.3.2's bits holds the exact value rounded
# once, except the one marked; the sets with a NaN ordinate keep 3.3.2's computation.
# [measured: fixture probe on the base tree and this tree, exact oracle; 2026-10-03; cycc 6.6.14]
var _r5c_u1 = 0x3FF0000000000001;   # 1 + 2^-52
var _r5c_u2 = 0x3FF0000000000002;   # 1 + 2^-51
# E2: a secant in 3.3.2's flat band (2^-110 < 1e-30) beside two overflowing slopes.
# 3.3.2 flattens it, which exact arithmetic nearly does too: the next interval's own
# projection shrinks the shared tangent to about 9 * 2^-152.
assert_eq(_r4c_mc4(0, F64_ONE, _r5c_u1, _r5c_u2, 0, _ce_p2(0 - 110), _ce_p2(980), _ce_p2(1023), F64_HALF),
  0x38FFFFFFFFFFEE00, "calc_monotone_cubic: E2 at x = 0.5, exact (3.3.3: 3.3.2's 2^-111)");
assert_eq(_r4c_mc4(0, F64_ONE, _r5c_u1, _r5c_u2, 0, _ce_p2(0 - 110), _ce_p2(980), _ce_p2(1023),
    0x3FD0000000000000), 0x38E3FFFFFFFFF280,
  "calc_monotone_cubic: E2 at x = 0.25, exact (3.3.3: 3.3.2's 0x38E4000000000000)");
assert_eq(_r4c_mc4(0, F64_ONE, _r5c_u1, _r5c_u2, 0, f64_neg(_ce_p2(0 - 110)), f64_neg(_ce_p2(980)),
    f64_neg(_ce_p2(1023)), F64_HALF), 0xB8FFFFFFFFFFEE00, "calc_monotone_cubic: E2 descending, the exact negation");
# ON the 1e-30 boundary: a secant of exactly 0x39B4484BFEEBC2A0 is not below it, so 3.3.2
# projects, meets alpha = +Inf and returns NaN; one ulp below, it flattens.
# (3.3.4: no threshold remains; the two sets differ by their one ulp, as exact values do.)
assert_eq(_r4c_mc4(0, F64_ONE, _r5c_u1, _r5c_u2, 0, 0x39B4484BFEEBC2A0, _ce_p2(980), _ce_p2(1023), F64_HALF),
  0x39A4484BFEEBB737, "calc_monotone_cubic: E2 with a secant of exactly 1e-30, exact (3.3.3: NaN)");
assert_eq(_r4c_mc4(0, F64_ONE, _r5c_u1, _r5c_u2, 0, 0x39B4484BFEEBC29F, _ce_p2(980), _ce_p2(1023), F64_HALF),
  0x39A4484BFEEBB736, "calc_monotone_cubic: E2 with a secant an ulp below 1e-30, exact (3.3.3: the flat half)");
# E1: E2 with ys[1] = 1, a unit secant. 3.3.2 returns NaN on the interval (exact
# 0x3FDFFFFFFFFFEE00 at x = 0.5), and so did 3.3.3; the limit gave 0.125.
assert_eq(_r4c_mc4(0, F64_ONE, _r5c_u1, _r5c_u2, 0, F64_ONE, _ce_p2(980), _ce_p2(1023), F64_HALF),
  0x3FDFFFFFFFFFEE00, "calc_monotone_cubic: E1 at x = 0.5, exact (3.3.3: NaN; the limit: 0.125)");
# The MIRROR images, an infinite tangent on the RIGHT of the interval queried. mA is
# R4calc's (a) reflected: 3.3.2's 0xFFD99681D0723DA4 at x = 0.5, 0.36 of the rise from
# the exact 0xFFDB07BB76E265E5 (the unrepaired slope class's error). E3, E3 descending
# and Zd return 3.3.2's NaN, where the exact values are 0.125, -0.125 and -0.
# 3.3.4: an ulp from the exact value (0.63 ulp), where 3.3.3 was 0.36 of the rise off.
assert_eq(_r4c_mc4(0, F64_ONE, F64_TWO, 0x4004000000000000, 0xFFDC000000000000, 0xFFD8000000000000, 0,
    _ce_p2(1023), F64_HALF), 0xFFDB07BB76E265E4,
  "calc_monotone_cubic: mirror of (a), x = 0.5, an ulp from the exact ...E265E5 (3.3.3: 0xFFD99681D0723DA4)");
assert_eq(_w4_mc3(0, F64_ONE, _r5c_u1, 0, F64_ONE, _ce_p2(1000), F64_HALF), 0x3FC0000000000000,
  "calc_monotone_cubic: E3 (right tangent +Inf) at x = 0.5, 0.125 exact (3.3.3: NaN)");
assert_eq(_w4_mc3(0, F64_ONE, _r5c_u1, 0, _r4c_zm, f64_neg(_ce_p2(1000)), F64_HALF), 0xBFC0000000000000,
  "calc_monotone_cubic: E3 descending at x = 0.5, -0.125 exact (3.3.3: NaN)");
assert_eq(_w4_mc3(0, F64_ONE, _r5c_u1, 0x8000000000000000, _r4c_zm, f64_neg(_ce_p2(1000)), 0), 0x8000000000000000,
  "calc_monotone_cubic: Zd (a -0 knot, right tangent -Inf) at x = 0 is the knot's -0 (3.3.3: NaN)");
# AFTER the non-finite pair: xs = [0, 2^-52, 1, 2], ys = [2^1001, 2^1000, 2^-100, 0].
# Interval 1's 3.3.2 projection meets alpha = +Inf and writes a 0 into the knot-2
# tangent, where exact arithmetic leaves a large one that interval 2 then projects to
# 3 * delta. 3.3.2's flat test then zeroes interval 2: 0x39AB000000000000 at x = 1.25,
# 0.42 of the rise from the exact 0x399B000000000000. A 3.3.3 step on interval 2 reads
# that 0 and keeps the far tangent, farther still.
assert_eq(_r4c_mc4(0, _ce_p2(0 - 52), F64_ONE, F64_TWO, _ce_p2(1001), _ce_p2(1000), _ce_p2(0 - 100), 0,
    0x3FF4000000000000), 0x399B000000000000,
  "calc_monotone_cubic: after a non-finite pair (x = 1.25), exact (3.3.3: 3.3.2's 0x39AB000000000000)");
# BEFORE it, a NaN ordinate: xs = [0, 1, 2, 3], ys = [0, 2^-90, 2^1000, NaN]. Interval 0's
# own tangents are finite and its projection overflows; 3.3.2 returns NaN, and so does
# this tree, where a 3.3.3 step would return 2^-93, a value the NaN's own interval can
# move.
var _r5c_v2 = _r4c_mc4(0, F64_ONE, F64_TWO, 0x4008000000000000, 0, _ce_p2(0 - 90), _ce_p2(1000),
  0x7FF8000000000000, F64_HALF);
assert_eq(f64_eq(_r5c_v2, _r5c_v2), 0, "calc_monotone_cubic: before a NaN ordinate -> 3.3.2's NaN, not a finite guess");
# The overflow repairs stayed out of such a set in 3.3.3: a y difference past DBL_MAX
# beside an overflowing slope kept 3.3.2's +Inf, and an overflowing midpoint 3.3.2's NaN;
# 3.3.4 gives the exact 2^1021 and -2^1022 (finite data). A grid wider than DBL_MAX
# beside a NaN ordinate keeps 3.3.2's NaN.
assert_eq(_r4c_mc4(0, f64_from(4), f64_from(8), 0x4020000000000001, _w4_n, _w4_p, _w4_p,
    f64_sub(_w4_p, _ce_p2(1000)), F64_TWO), 0x7FC0000000000000,
  "calc_monotone_cubic: a y difference past DBL_MAX in such a set, 2^1021 exact (3.3.3: +Inf)");
assert_eq(_r4c_mc4(0, F64_ONE, F64_TWO, f64_add(F64_TWO, _ce_p2(0 - 51)), _w4_n, 0, _w4_p,
    f64_sub(_w4_p, _ce_p2(1000)), F64_HALF), 0xFFD0000000000000,
  "calc_monotone_cubic: an overflowing midpoint in such a set, -2^1022 exact (3.3.3: NaN)");
var _r5c_wn = _r4c_mc4(_w4_n, _w4_p, f64_add(_w4_p, _ce_p2(971)), f64_add(_w4_p, _ce_p2(972)), 0, F64_ONE, F64_TWO,
  0x7FF8000000000000, 0);
assert_eq(f64_eq(_r5c_wn, _r5c_wn), 0, "calc_monotone_cubic: a wide interval beside a NaN ordinate: 3.3.2's NaN");

# === 3.3.3 R5calc: calc_monotone_cubic, an underflowing wide grid and a subnormal width ===
# ⛔ A grid wider than DBL_MAX whose slope underflows was refused through 3.3.3 as 3.3.2
# refused it: xs = [-2^1023, 2^1023], ys = [0, 2^-60] has the slope 2^-1084, which the
# halved quotient rounds to 0; that flat segment gave 0x3C2B000000000000 at x = 2^1022,
# 0.094 of the rise from the exact 0x3C28000000000000, where 3.3.2 returns NaN. 3.3.4
# carries the slope in extended range and returns the exact value. An exact underflowed
# slope was kept all along: ys = [0, 1] (2^-1024) gives the exact 0.75.
# [measured: fixture probe on the 3.3.2 bundle, the base tree and this tree, exact oracle; 2026-10-01]
var _r5c_wx = _f64arr_alloc(2);
_f64arr_set(_r5c_wx, 0, _w4_n);
_f64arr_set(_r5c_wx, 1, _w4_p);
var _r5c_wy = _f64arr_alloc(2);
_f64arr_set(_r5c_wy, 0, 0);
_f64arr_set(_r5c_wy, 1, _ce_p2(0 - 60));
assert_eq(_cmc(_r5c_wx, _r5c_wy, 2, _ce_p2(1022)), 0x3C28000000000000,
  "calc_monotone_cubic: a wide grid whose slope underflows, exact (3.3.3: NaN)");
_f64arr_set(_r5c_wy, 1, F64_ONE);
assert_eq(_cmc(_r5c_wx, _r5c_wy, 2, _ce_p2(1022)), 0x3FE8000000000000,
  "calc_monotone_cubic: a wide grid whose slope is exactly 2^-1024 -> 0.75, exact");
# ⛔ A SUBNORMAL WIDTH: p10 * h rounds to a multiple of 2^-1074. xs = [0, 5 * 2^-1074],
# ys = [-2^-87, 0] is linear data; 3.3.2 returned 0xBA7645A1CAC08312 at x = 2^-1074,
# 0.10 of the rise from the exact -0.8 * 2^-87, which the order p * (h * m) gives.
# Beside a tangent-space interval the same rounding turned 3.3.2's NaN finite and wrong:
# the second set (from the reviewers' generator) returned 0xBA8CB933D447E183 at 2^-1074,
# 0.072 of the rise off; it now gives 0xBA8FB1E0EA3DA964, an ulp from the exact value.
# A set with a non-finite secant kept 3.3.2's order in 3.3.3: the third set (interval 1's
# slope is 2^1072) returned 3.3.2's NaN at 5 * 2^-1074, where the other order gives -Inf;
# 3.3.4 returns its exact value, 0x3FF1C00000000000.
# [measured: fixture probe on the 3.3.2 bundle, the base tree, this tree and an ungated build; 2026-10-01]
var _r5c_sx = _f64arr_alloc(3);
_f64arr_set(_r5c_sx, 0, 0);
_f64arr_set(_r5c_sx, 1, 5);
var _r5c_sy = _f64arr_alloc(3);
_f64arr_set(_r5c_sy, 0, f64_neg(_ce_p2(0 - 87)));
_f64arr_set(_r5c_sy, 1, 0);
assert_eq(_cmc(_r5c_sx, _r5c_sy, 2, 1), 0xBA7999999999999A,
  "calc_monotone_cubic: a subnormal width, linear data, x = 2^-1074 -> -0.8 * 2^-87, exact");
_f64arr_set(_r5c_sx, 2, 0x216FF442A831A4E9);
_f64arr_set(_r5c_sy, 0, 0xBA94A279188024F2);
_f64arr_set(_r5c_sy, 2, 0x1E7EDC1CEDE13B49);
assert_eq(_cmc(_r5c_sx, _r5c_sy, 3, 1), 0xBA8FB1E0EA3DA964,
  "calc_monotone_cubic: a subnormal width beside a tangent-space interval (3.3.2: NaN)");
_f64arr_set(_r5c_sx, 1, 4);
_f64arr_set(_r5c_sx, 2, 8);
_f64arr_set(_r5c_sy, 0, F64_ONE);
_f64arr_set(_r5c_sy, 1, F64_ONE);
_f64arr_set(_r5c_sy, 2, F64_TWO);
assert_eq(_cmc(_r5c_sx, _r5c_sy, 3, 5), 0x3FF1C00000000000,
  "calc_monotone_cubic: a subnormal width beside an overflowing slope, exact (3.3.3: NaN)");

# === 3.3.3 R5calc: calc_monotone_cubic, the tangent-space weight's order ===
# The weight is applied as (m/hypot * |delta|) * 3. With finite tangents this branch has
# |delta| < sqrt(2), so the order changes rounding only; these two full-mantissa sets
# (from the reviewers' generator; 3.3.2 had both wrong) are where it gives the exact
# value, and (m/hypot) * (3|delta|) does not: the first set's m_i line gives
# 0xA0114FE66D300840 and its m_i+1 line 0xA0114FE66D30083A; the second set's m_i line
# gives 0x8D5806D283B3DFA7.
# [measured: fixture probe on this tree and per-line reverted builds, exact oracle; 2026-10-01]
var _r5c_ox = _f64arr_alloc(7);
var _r5c_oy = _f64arr_alloc(7);
_f64arr_set(_r5c_ox, 0, 0x52EEC83E2FFDE808);
_f64arr_set(_r5c_ox, 1, 0x52EEC83E2FFDE809);
_f64arr_set(_r5c_ox, 2, 0x5360090773A07B27);
_f64arr_set(_r5c_ox, 3, 0x53600E128A8EEB57);
_f64arr_set(_r5c_ox, 4, 0x536011B59EE58232);
_f64arr_set(_r5c_ox, 5, 0x536011C2F931162E);
_f64arr_set(_r5c_ox, 6, 0x5390A1C5B08B6997);
_f64arr_set(_r5c_oy, 0, 0x7F12626FBCD40634);
_f64arr_set(_r5c_oy, 1, 0xFF692649241A1659);
_f64arr_set(_r5c_oy, 2, 0x7EB594BB5AC700A7);
_f64arr_set(_r5c_oy, 3, 0x80061B7F2A148A5E);
_f64arr_set(_r5c_oy, 4, 0xA05627069B8414EA);
_f64arr_set(_r5c_oy, 5, 0xFE86E6B633C38F6C);
_f64arr_set(_r5c_oy, 6, 0xFF6FC00FF97FEF2F);
assert_eq(_cmc(_r5c_ox, _r5c_oy, 7, 0x53600EFB4FA4910E), 0xA0114FE66D30083C,
  "calc_monotone_cubic: tangent-space weight order, both lines (exact value)");
_f64arr_set(_r5c_ox, 0, 0x4333771C0F6A63CB);
_f64arr_set(_r5c_ox, 1, 0x43337B918EBCB8FB);
_f64arr_set(_r5c_ox, 2, 0x43DE37EE032CB1F9);
_f64arr_set(_r5c_ox, 3, 0x43EB5A70B46FAEE0);
_f64arr_set(_r5c_ox, 4, 0x61854253998C7F7A);
_f64arr_set(_r5c_ox, 5, 0x61854253998C7F7B);
_f64arr_set(_r5c_oy, 0, 0x7EA0DCDD9C33CF4C);
_f64arr_set(_r5c_oy, 1, 0x80004A61F94A9A17);
_f64arr_set(_r5c_oy, 2, 0x912E3BA4C70E2398);
_f64arr_set(_r5c_oy, 3, 0xFEAD6A7361A2EC7A);
_f64arr_set(_r5c_oy, 4, 0xE82C07DF6D3A0852);
_f64arr_set(_r5c_oy, 5, 0xFF5410D85BD89AA8);
assert_eq(_cmc(_r5c_ox, _r5c_oy, 6, 0x43337B918EBCB8FC), 0x8D5806D283B3DFA8,
  "calc_monotone_cubic: tangent-space weight order, the m_i line (exact value)");

# === 3.3.7: calc_adaptive_simpson, an ordinary interval whose panels overflow ===
test_group("3.3.7 calc_adaptive_simpson: an ordinary interval whose panels overflow");
# 3.3.7 recurses on an ordinary interval (|a|, |b| < 2^1023, b - a >= 2^-900) without the
# value frames (_adaptive_simpson_rec0), and hands a panel to the re-framed recursion as
# 3.3.6 does when its refined sum is NaN from finite samples. f = x 2^1003 on [-2^20, 2^20]:
# each half-panel's weighted sum overflows, one to -Inf and one to +Inf, and their sum is
# NaN; re-framed, the two are exact negatives (f is odd and the nodes symmetric), so the rule
# gives exactly 0, the integral. Without the hand-over the NaN is returned.
# [measured: scratch pfb/adprobe.cyr, 3.3.6, integrated 3.3.7, this tree and the mutant, 2026-10-31]
var _ad7_n = 0;
fn _ad7_odd(x) {
    _ad7_n = _ad7_n + 1;
    return f64_mul(x, 0x7EA0000000000000);   # x * 2^1003
}
assert_eq(_cas(&_ad7_odd, 0xC130000000000000, 0x4130000000000000, 0x3DDB7CDFD9D7BDBB), 0,
  "calc_adaptive_simpson: x 2^1003 on [-2^20, 2^20] -> +0, re-framed (without the hand-over: NaN)");
assert_eq(_ad7_n, 7, "calc_adaptive_simpson: ... in 7 evaluations, as 3.3.6");

# === 3.3.4: calc_monotone_cubic, slopes outside the f64 range ===
test_group("3.3.4: calc_monotone_cubic, slopes outside the f64 range");
# ⛔ A SET OF FINITE DOUBLES WHOSE EXACT SLOPE IS PAST DBL_MAX OR BELOW DBL_MIN was 3.3.2's
# computation through 3.3.3: NaN for the first (xs = [0, 1], ys = [-2^1023, 2^1023] at
# x = 0.25, where the value is -2^1022) and a flattened segment for the second (xs = [0,
# 2^100], ys = [0, 2^-1000] at 2^98 gave 0x0144000000000000, where it is 2^-1002). Such a
# set is now splined with slopes and tangents carried as mantissa and exponent
# (calc_ext.cyr, _calcx_mc_ext), and so is a finite-secant set whose tangent ratio
# underflows before a projection. Expected values are an exact rational Fritsch-Carlson
# oracle's, rounded once. The fixtures after the repros are the sweep sets that each
# extended-range mutant first gets wrong.
# [measured: repros and five sweeps (2,539,979 results), base tree and this tree, exact oracle; 2026-10-03]
var _mc34_x = _f64arr_alloc(8);
var _mc34_y = _f64arr_alloc(8);
var _mc34_n = 0;
var _mc34_v = 0;
fn _mc34_set(n) {
    _mc34_n = n;
    return 0;
}
fn _mc34_xy(i, x, y) {
    _f64arr_set(_mc34_x, i, x);
    _f64arr_set(_mc34_y, i, y);
    return 0;
}
fn _mc34_at(q) { return _cmc(_mc34_x, _mc34_y, _mc34_n, q); }

_mc34_set(2);
_mc34_xy(0, 0, 0xFFE0000000000000);
_mc34_xy(1, F64_ONE, 0x7FE0000000000000);
assert_eq(_mc34_at(0x3FD0000000000000), 0xFFD0000000000000,
  "calc_monotone_cubic: slope 2^1024, x = 0.25 -> -2^1022 exact (3.3.3: NaN)");
_mc34_v = _mc34_at(0x7FF8000000000000);
assert_eq(f64_eq(_mc34_v, _mc34_v), 0, "calc_monotone_cubic: slope 2^1024, a NaN query stays NaN");
_mc34_xy(0, 0, 0x7FE0000000000000);
_mc34_xy(1, F64_ONE, 0xFFE0000000000000);
assert_eq(_mc34_at(0x3FD0000000000000), 0x7FD0000000000000,
  "calc_monotone_cubic: slope -2^1024, x = 0.25 -> 2^1022 exact (3.3.3: NaN)");
_mc34_xy(0, 0, 0);
_mc34_xy(1, 0x4630000000000000, 0x0170000000000000);
assert_eq(_mc34_at(0x4610000000000000), 0x0150000000000000,
  "calc_monotone_cubic: slope 2^-1100, x = 2^98 -> 2^-1002 exact (3.3.3: 0x0144000000000000)");
# The ratio underflow: a unit grid whose knot-1 tangent is 2^-1549 of interval 1's secant.
_mc34_set(4);
_mc34_xy(0, 0, 0);
_mc34_xy(1, F64_ONE, 0x99AF949826BCF8CB);
_mc34_xy(2, F64_TWO, 0xFA88AB0F612CE1B0);
_mc34_xy(3, 0x4008000000000000, 0xFB0B3BA79C6E8FBA);
assert_eq(_mc34_at(F64_HALF), 0x999F13DDD4A83580,
  "calc_monotone_cubic: a tangent ratio below DBL_MIN, x = 0.5, exact (3.3.3: the chord's midpoint)");
# Non-finite data keeps the previous computation: an infinite abscissa ends the grid, and
# the knot x = 1 is NaN as before (the extended path would read +Inf as a finite width).
_mc34_set(3);
_mc34_xy(0, 0, 0);
_mc34_xy(1, F64_ONE, F64_ONE);
_mc34_xy(2, F64_POS_INF, F64_TWO);
_mc34_v = _mc34_at(F64_ONE);
assert_eq(f64_eq(_mc34_v, _mc34_v), 0,
  "calc_monotone_cubic: an infinite abscissa keeps the previous path (NaN at x = 1)");
assert_eq(_mc34_at(F64_HALF), 0x3FE4000000000000,
  "calc_monotone_cubic: an infinite abscissa keeps the previous path (0.625 at x = 0.5)");
# A NaN query on a grid wider than DBL_MAX: the Hermite form alone would not make it NaN
# there (t would be finite), so the extended path tests it first.
_mc34_set(2);
_mc34_xy(0, 0xFFE0000000000000, 0);
_mc34_xy(1, 0x7FE0000000000000, 0x3C30000000000000);
_mc34_v = _mc34_at(0x7FF8000000000000);
assert_eq(f64_eq(_mc34_v, _mc34_v), 0,
  "calc_monotone_cubic: a wide grid with a slope below DBL_MIN, a NaN query is NaN");
assert_eq(_mc34_at(0x7FD0000000000000), 0x3C28000000000000,
  "calc_monotone_cubic: a wide grid with a slope below DBL_MIN, x = 2^1022, exact (3.3.3: NaN)");
# A ratio that underflows ONTO A ZEROED TANGENT is not lost (m_i = 0 whatever the ratio):
# this set's projection runs with alpha = 0 from a zeroed m_i and stays on the f64 path,
# whose value is the exact one; the extended path, taken needlessly, is an ulp off.
_mc34_set(4);
_mc34_xy(0, 0, 0);
_mc34_xy(1, 0x3E45C6C6CA393801, 0x0C99125767A5293B);
_mc34_xy(2, 0x3E6E1052AF0D00E3, 0x8E695A2CC0D40655);
_mc34_xy(3, 0x3E810381C6FC9525, 0xB07BFC8E90C7A106);
assert_eq(_mc34_at(0x3E7A3B491B78D1C4), 0xB06B716FB1BF3279,
  "calc_monotone_cubic: a zeroed tangent's ratio is not a lost one: the f64 path, exact");
_mc34_set(3);
_mc34_xy(0, 0xFFB9D7CD1D5C4825, 0x119E592075305DB7);
_mc34_xy(1, 0xFFAB439130D5F64F, 0x11B88C78907F9669);
_mc34_xy(2, 0x7FC921EB139F7110, 0x11BE40965D698C8B);
assert_eq(_mc34_at(0x7FC921EB139F7110), 0x11BE40965D698C8B,
  "calc_monotone_cubic: m1 set 9 (wide, inc) at 0x7FC921EB139F7110, exact");
assert_eq(_mc34_at(0xFFB6CA4BFC1FF4E6), 0x11A8F0D36235492A,
  "calc_monotone_cubic: m1 set 9 (wide, inc) at 0xFFB6CA4BFC1FF4E6, exact");
assert_eq(_mc34_at(0xFFA9AE7ED2EFFD5D), 0x11B8C193D43D74C8,
  "calc_monotone_cubic: m1 set 9 (wide, inc) at 0xFFA9AE7ED2EFFD5D, exact");
_mc34_set(2);
_mc34_xy(0, 0, 0xE88736EB1D95389B);
_mc34_xy(1, 0x0703D589301BA988, 0x688BE77328B09A93);
assert_eq(_mc34_at(0), 0xE88736EB1D95389B,
  "calc_monotone_cubic: m1 set 10 (ratio, rand) at 0, exact");
_mc34_set(2);
_mc34_xy(0, 0, 0x7D527CF9EAFF520B);
_mc34_xy(1, 0x00000000000EAE78, 0xFD71B117D3765E6D);
assert_eq(_mc34_at(0x000000000007573C), 0xFD5A23B2B16D13D4,
  "calc_monotone_cubic: m1 set 38 (subw, rand) at 0x000000000007573C, exact");
_mc34_set(3);
_mc34_xy(0, 0, 0x7F9B80A5A9690F96);
_mc34_xy(1, 0x000000000007B810, 0x7F9B80A5A9690F5B);
_mc34_xy(2, 0x000000000013EEB2, 0x7F9B80A5A9690F49);
assert_eq(_mc34_at(0x000000000003DC08), 0x7F9B80A5A9690F75,
