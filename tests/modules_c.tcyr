# === 3.4.1 GEO6: a barrel the solve cannot vouch for ===
test_group("3.4.1 GEO6: a barrel the solve cannot vouch for");
# Near tangency _geo_sph_solve forms hb, a and c in double-double; where it cannot certify hb^2 - a c, or its
# lows' own error can reach the discriminant or c (_geo_lows_hold), the exact solve answers, at any distance.
# GEO4's gate was the distance alone, 2^20 radii: 165 of 4,000 rays within 2 ulps of tangency 2^11 .. 2^20 radii
# away had the wrong verdict, on every tree. The first two rows are the review's.
# [measured: GEO6 3.4.1 capb.py bt / pt, capc.py sf, exact Fraction oracle, s22 / mutants / this tree, 2026-11-01]
assert_eq(geo_ray_capsule_branch(_graw(0xC0C0D538DE7729FB, 0xC0FE42CE5B273AED, 0xC0E460E3396BB521,
      0x3FB0DCB2B24EAAD4, 0x3FEE42BCA00FDF9E, 0x3FD46193CB6052CF),
    geo_capsule_new(hvec3_new(0xBFE86C04AEFA03E6, 0x3FE8C8C7F91EF5B4, 0x4009637DE41A7FB4),
      hvec3_new(0xBFE8600355CBAE9A, 0x3FE8EBF321CF4E38, 0x400956771A0ADC8A), 0x4030000000000061), _g6_br),
  0x0000000000000000,
  "2^16 radii away: the exact miss (every tree the hit 40FFFFFFFFF8D4E8)");
assert_eq(load64(_g6_br), GEO_FACE_NONE, "... no piece");
assert_eq(geo_ray_capsule_branch(_graw(0x415F72CBF4652F0D, 0xC13757746D806B04, 0xC10F1AED22A78276,
      0xBFEF72CBABABC71A, 0x3FC7576B42BE009B, 0x3F9F1CE03FB350C3),
    geo_capsule_new(hvec3_new(0x3FEAA234A3AD2784, 0xBFD448C349D2206C, 0xBFEFD8F3E0123D50),
      hvec3_new(0x3FE94CF778D1C966, 0xBFC9A1E320E24ABA, 0xBFEF516BCE822BB6), 0x404FFFFFFFFFFD9A), _g6_br),
  0x415FFFFFFFFFFA17,
  "2^17 radii away: the exact hit (every tree the miss)");
assert_eq(load64(_g6_br), GEO_CAP_CYLINDER, "... the barrel");
assert_eq(geo_ray_capsule_branch(_graw(0xC0490683F460E424, 0xC03508A4F2D1FEF7, 0x403BC8E7C4B80236,
      0x3FE9D34BE474F6D6, 0x3FD9E8E194684691, 0xBFDB82F77A86C5FB),
    geo_capsule_new(hvec3_new(0x3FF9901C00E52BC8, 0x40137E1101D63B28, 0x3FD153D702D5DB78),
      hvec3_new(0x3FF9B45EA22370FB, 0x401387173BEE0E28, 0x3FD1EDA0D1CEA549), 0x3F3FFFFFFFFF9B9B), _g6_br),
  0x404FFFFFFFFFF995,
  "_geo_disc_dd's 2 not routed (bt 1-5; mutant 0x404FFFFFFFFB8509)");
assert_eq(load64(_g6_br), GEO_CAP_CYLINDER, "... the barrel");
assert_eq(geo_ray_capsule_branch(_graw(0xBE6B27545A664E6A, 0x3E74CCFAA382DFAE, 0xBE6753D0420DEC02,
      0x3FD85A33110317E3, 0xBFE832AC973F016E, 0x3FE1090729437F39),
    geo_capsule_new(hvec3_new(0xBE4A60B60A13A74A, 0x3E17B68C1260F370, 0x3E45BE6B23A214DE),
      hvec3_new(0x3E750E1C4FB30902, 0xBE88033F7F1AB91E, 0x3E8264EDDB81D035), 0x3D8FFFFFFFFFFBF1), _g6_br),
  0x3E843DEB76EFD751,
  "_geo_lows_hold off (pt 7-104; mutant 0x3E843DEB76EFD748)");
assert_eq(load64(_g6_br), GEO_CAP_CYLINDER, "... the barrel");
