  0x3FD34D7D44C997A7, 0x3FF107A9622124E3, 0x3FB20CF17F789468, 0xBFC8477780D9AD24, 0x3FEF5683684A6B99,
  0x3FEF34D456E7DE89, 0x3FCC1B9AA4DADF40, 0xBF9C5888945BF200, 0xBFCADAADC61DD464, 0x3FEE9F8918C611DA,
  0x3FC9A8ADB13E9720);
