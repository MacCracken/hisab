assert_eq(load64(_rq6_br), GEO_CAP_CYLINDER, "... on the barrel");
assert_eq(geo_ray_capsule_branch(_graw(0x400AF88386014649, 0x4011569435BF694A, 0x400B6B798C518D66, 0x3FF16B28512921F3,
