# other three answers were 4.7e-4, 2.5e-5 and 2.4e-5 of the depth deep.
# [measured: lane CO2 face_depth with the rot_new of lane FB's scratch obb_oracle.py, 80-digit Decimal; 2026-10-31]
# [measured: lane-CO r1.py, r23.py, pick.py, pick2.py, cornw.py, exact oracles, 3.3.7 base and this tree, 2026-10-31]
var _co4_b5 = _co4_mk(0x3F8E166792D29900, 0x3FE3445D3F532334, 0x3FE0C0386E64E880, 0x3FF2FD63699B3F08,
  0x3FE7C7FBDA9ED738, 0x3FF111049041DCE8, 0x3FD6C81C22CA2B18, 0x3FD3F882420CFAC5, 0x3FDDD94F6700C7D0,
  0xBFE7E99278B4FB98, 0, 0, 0, 0, 0);
var _co4_s5 = hvec4_new(0xBFF29FE8714B4DF3, 0x3F5B1DF9BD736200, 0x3FEB1E57B758C839, 0x3FE35FA860613C3E);
