      0x6518C9BD4C8F60C6, 0xE53C54BA0DE5D5ED), geo_sphere_new(hvec3_new(0x653779024D718B6A, 0x6518C9BD4C8F60B8,
        0xE53C54BA0DE5D5EA), 0x621F0C581002C264)), 0x3FEFFFFFFFFFFFFF, "geo_ray_sphere: ... y: t rounded");
assert_eq(geo_ray_sphere(_graw(0xF4E8B4747E6AF8D6, 0xF4CA19DB4317DA04, 0x74BDFB2D6A98C05D, 0x3FEE9C8AF956AEF9,
      0x3FD02BB26C8FDB36, 0xBFC2931A17939886), geo_sphere_new(hvec3_zero(), 0x71760F3F3C0DD322)),
  0x74E9D35354E9EF9C, "geo_ray_sphere: ... z: t rounded");
assert_eq(geo_ray_capsule_branch(_graw(0x4008AC451A9BD780, 0xC01E1284333A3258, 0x4002F53917CEE700, 0xF980000000000000,
      0xE813C21A40989584, 0xE34F90C72D0DE070), geo_capsule_new(hvec3_new(0x4006F652CA91D76C, 0xC0056048CF252A00,
        0xC00AE5F6B2F2F790), hvec3_new(0xBFE51890C73E7218, 0xC0205848737AFA06, 0x4000D96D00EBAC58),
      0x3FFBC1F5D37C2BCB), _rq6_br), 0x066D94AD2FCCA130, "geo_ray_capsule_branch: the second cross product, x");
assert_eq(geo_ray_capsule_branch(_graw(0xE05680434D1F7FF4, 0xE041502BEFD3EE5C, 0x6049E3FA628C8BB4, 0x6057C91D3B739504,
      0xE04B6869BE1950FC, 0x5FE5FB2435FE6140), geo_capsule_new(hvec3_new(0x6030CFF5E1179CC8, 0xE0599DD4966A925E,
