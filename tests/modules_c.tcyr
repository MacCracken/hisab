# [measured: lane CO3 fixchk3.py (review-CO orc.py with R(q / |q|)), lane CO2's and lane CO3's answers; 2026-10-31]
assert_eq(load64(_co4_d), 0x3E112E0BC0000000,
  "gjk_epa_3d: ... at 9.9999997e-10 (3.3.7: 1.11694e-9, 11.7% deep) [CO3 order]");
assert_eq(gjk_epa_3d(&_co4_sup_sph, _co4_s5, &_co4_sup_qobb, _co4_b5, _co4_n, _co4_d), 1,
