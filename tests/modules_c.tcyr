assert_eq(geo_ray_capsule_branch(_graw(0, f64_from(3), 0, 0, f64_neg(F64_ONE), 0), geo_capsule_new(
      hvec3_new(0xFFECCCCCCCCCCCCC, 0, 0), hvec3_new(0x7FECCCCCCCCCCCCC, 0, 0), F64_ONE), _rq6_br), 0x4000000000000000,
