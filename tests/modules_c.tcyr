# from (-3 * 2^-600, 0, 0) along x is met at t = 2r = 2^-599, exactly.
assert_eq(geo_ray_capsule_branch(_graw(0x9A88000000000000, 0, 0, F64_ONE, 0, 0), geo_capsule_new(hvec3_zero(),
      hvec3_zero(), 0x1A70000000000000), _r3_br), 0x1A80000000000000,
