assert_eq(_r2_d0 == 1 && _r2_d1 == 1, 1, "gjk_epa_3d: R2's pair, capsule first, a contact in the band");
assert_eq(load64(_co4_d), _r2_dd0, "gjk_epa_3d: ... its depth after a refused cycling-path EPA run as before it");
