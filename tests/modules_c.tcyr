assert_eq(geo_ray_sphere(_graw(0xBF234F47FBBDE4C2, 0xBF401BB9DC385DC1, 0xBF3864776F457785, 0x3FD8A2A9D21EDBF4,
      0x3FD2F96F1B6597FF, 0x3FDA0D6B5D17B738), geo_sphere_new(hvec3_new(0x3F3745A6BDA6DB44, 0xBF26CB1006389470,
        0x3F12CD6D9CC32350), 0x3F11C7BA3DED67A0)), 0, "stan 1-2031: the exact miss (s14 a tangent hit)");
# Both roots exactly (_geo_sph_xroots) on stan 1-1: the near one within an ulp of the exact root.
var _g4_rt: i64[2];
assert_eq(_geo_sph_xroots(_graw(0x40931784BEE4D6E4, 0x4096C0B9AB1D1A48, 0xC094FF7A13E2B836, 0xBFDC5343EDA4A78A,
      0xBFE6531D6B81942B, 0x3FEF31F2970666E2), geo_sphere_new(hvec3_new(0x4055904DD5C45280, 0x404021DA2589E580,
        0x408B90C393518A64), 0x40699021E02E9454), &_g4_rt), 1, "_geo_sph_xroots: stan 1-1 is hit");
assert_eq(load64(&_g4_rt), 0x40A18A040FDA1A81, "... its near root, 1 ulp under the exact one rounded");

# === 3.4.1 GEO4: thin barrels and capsule caps near tangency ===
test_group("3.4.1 GEO4: thin barrels and capsule caps near tangency");
