# The certificate itself, on 3.3.7's GJK simplex for that pair: the origin's exact barycentric
# orientations are 6.9e-17, -6.3e-16, 6.7e-16 and 1.1e-15, so it lies outside, and the
# rounding of their evaluation cannot place three of them: _ga_tetra_certain4 refuses it. The
# four tetrahedral corners hold the origin for certain.
var _co4_ta = hvec3_new(0xBFEDAD8C4C9D9C06, 0x3FE08B11F6D29432, 0xBFEBA65777016A5D);
var _co4_tb = hvec3_new(0x3FF71198BE596A41, 0xBFE9B7DAF6ADEC96, 0x3FF57E03022C5398);
var _co4_tc = hvec3_new(0xBFEDAD994E262F47, 0x3FE08B0448B5C181, 0xBFEBA651B0901D8A);
var _co4_td = hvec3_new(0x3FF7119C5558C80C, 0xBFE9B7D368BF8754, 0x3FF57E0169D4ADE7);
assert_eq(_ga_tetra_certain4(_co4_ta, _co4_tb, _co4_tc, _co4_td), 0,
  "_ga_tetra_certain4: the roadmap pair's sliver simplex does not certainly hold the origin");
var _co4_m = f64_neg(F64_ONE);
assert_eq(_ga_tetra_certain4(hvec3_new(F64_ONE, F64_ONE, F64_ONE), hvec3_new(F64_ONE, _co4_m, _co4_m),
    hvec3_new(_co4_m, F64_ONE, _co4_m), hvec3_new(_co4_m, _co4_m, F64_ONE)), 1,
  "_ga_tetra_certain4: the tetrahedral corners certainly hold the origin (control)");

