# [measured: review-CO sw11 / sw12 (11 and 12 seeds), lane CO2 disagree.py: 270 + 214 -> 0 + 0; 2026-10-31]
var _cr_b4 = _co4_mk(0x408F400000000000, 0xC09F400000000000, 0x407F400000000000, 0x3FF4C169F11A1BAB,
  0x3FDEE69F86F825EA, 0x3FE77768363E9CA4, 0xBFEFF53E99E0FB14, 0xBF99C99839145E26, 0x3FA6D6F2E772A5A6,
  0x3FA1A015CF09E6FA, 0x3FD4281B0F8CE504, 0x3FEE59FC1DE0FED3, 0xBFA36C3D30A1EC5C, 0x3FEE5C5D02DD23EB,
  0xBFD413209A76DED4);
