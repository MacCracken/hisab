var _r2_nan = 0x7FF8000000000000;
assert_eq(_ga_det_exact(F64_ONE, _r2_nan, F64_HALF, 0x3FD3333333333333, F64_ONE, 0x3FC999999999999A,
    0x3FB999999999999A, 0x3FC999999999999A, F64_ONE), 2,
  "_ga_det_exact: a row with a NaN is not exact (integ-snap11: a certain -1)");
assert_eq(_ga_orient_o(hvec3_new(F64_ONE, _r2_nan, F64_HALF), hvec3_new(0x3FD3333333333333, F64_ONE,
      0x3FC999999999999A), hvec3_new(0x3FB999999999999A, 0x3FC999999999999A, F64_ONE)), 0,
