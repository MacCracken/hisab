test_group("3.5.0 W3: the deep snap takes a face form lower than EPA's at all (F-CO8-2)");
# A ball concentric with a parallelepiped (tests/modules.tcyr's 3.3.7 pair): the exact depth r + h_min,
# 3.96715843675280566600541..., rounds to 0x400FBCBD8FFF3AF4. Through 3.4.2 gjk_epa_3d answered 0x...3B11, 29 ulp
# above it, its normal 8.4e-14 rad off: the snap's face form (_epa_snap_deep) was 27 ulp lower and refused, its gain
# under 2^-49 of the points' scale. Now both entries answer 0x...3AF6, 2 ulp above, their normals 3.4e-15 and
# 4.7e-15 rad off. And a box concentric with a ball (axis-aligned): r + h_x correctly rounded, 0x4029C9D82303F6AA
# (3.4.2: 17 ulp above).
# [measured: scratch W3 py/r5.py (Fractions, 120-digit Decimal), t1.py, this tree and 3.4.2; 2026-11-14]
fn _w2W3_sup_par(sh, d) {
    var x = load64(sh);
    var y = load64(sh + 8);
    var z = load64(sh + 16);
    for (var i = 0; i < 3; i = i + 1) {
        var ux = load64(sh + 48 + i * 24);
        var uy = load64(sh + 56 + i * 24);
        var uz = load64(sh + 64 + i * 24);
        var hh = load64(sh + 24 + i * 8);
        var dd = f64_add(f64_add(f64_mul(HVec3_x(d), ux), f64_mul(HVec3_y(d), uy)), f64_mul(HVec3_z(d), uz));
        if (f64_lt(dd, 0) == 1) { hh = f64_neg(hh); }
        x = f64_add(x, f64_mul(ux, hh));
        y = f64_add(y, f64_mul(uy, hh));
        z = f64_add(z, f64_mul(uz, hh));
    }
    return hvec3_new(x, y, z);
}
fn _w2W3_sup_sph(sh, d) {
    var dn = hvec3_normalize(d);
    var r = load64(sh + 24);
    return hvec3_new(f64_add(load64(sh), f64_mul(HVec3_x(dn), r)), f64_add(load64(sh + 8), f64_mul(HVec3_y(dn), r)),
      f64_add(load64(sh + 16), f64_mul(HVec3_z(dn), r)));
}
var _w2W3_pp: i64[15];
fn _w2W3_par(c0, c1, c2, h0, h1, h2) {
    store64(&_w2W3_pp, c0);
    store64(&_w2W3_pp + 8, c1);
    store64(&_w2W3_pp + 16, c2);
    store64(&_w2W3_pp + 24, h0);
    store64(&_w2W3_pp + 32, h1);
    store64(&_w2W3_pp + 40, h2);
    return 0;
}
fn _w2W3_axes(a0, a1, a2, b0, b1, b2, c0, c1, c2) {
    store64(&_w2W3_pp + 48, a0);
    store64(&_w2W3_pp + 56, a1);
    store64(&_w2W3_pp + 64, a2);
    store64(&_w2W3_pp + 72, b0);
    store64(&_w2W3_pp + 80, b1);
    store64(&_w2W3_pp + 88, b2);
    store64(&_w2W3_pp + 96, c0);
    store64(&_w2W3_pp + 104, c1);
    store64(&_w2W3_pp + 112, c2);
    return 0;
}
var _w2W3_sw: i64[4];
_w2W3_par(0x3FC98D93E9FECDA8, 0x3FCA1CF3D94491D8, 0xBFE36B44DCEBD2BC, 0x3FC59F978719FCEF, 0x3FAA1EC832492661,
  0x3FC415FBDF9581FC);
_w2W3_axes(0xBFD4E1DEB0437ACC, 0xBFEAD7161C113012, 0x3FDBE61DAD346E0D, 0x3FE119C20D62D48E, 0x3FCBBD62EE36575C,
  0x3FEA24B3637F7211, 0xBFE8F3733380285E, 0x3FDFF82CD413790E, 0x3FD8293276F4E81A);
store64(&_w2W3_sw, 0x3FC98D93E9FECDA8);
store64(&_w2W3_sw + 8, 0x3FCA1CF3D94491D8);
store64(&_w2W3_sw + 16, 0xBFE36B44DCEBD2BC);
store64(&_w2W3_sw + 24, 0x400F54426F36165A);
assert_eq(gjk_epa_3d(&_w2W3_sup_par, &_w2W3_pp, &_w2W3_sup_sph, &_w2W3_sw, _w2W3_n, _w2W3_d), 1,
  "gjk_epa_3d: a ball concentric with a parallelepiped is a contact");
