# Axis-aligned: r + h_x = 12.894227117761449 exactly rounded.
_w2W3_par(0xBFE11889B3A631E6, 0x3FD9DA07E939DA64, 0xBFDAAD9503B36EF8, 0x3FAFAF24B4AE3B09, 0x3FB308FBA5F9E2C3,
  0x401C34E4BDE10586);
_w2W3_axes(F64_ONE, 0, 0, 0, F64_ONE, 0, 0, 0, F64_ONE);
store64(&_w2W3_sw, 0xBFE11889B3A631E6);
store64(&_w2W3_sw + 8, 0x3FD9DA07E939DA64);
store64(&_w2W3_sw + 16, 0xBFDAAD9503B36EF8);
