assert_eq(_w2W3_q(0), 0x3D5B95880FF1C000, "gjk_epa_3d: a ball past the rim 23.5 eps deep: the rim form, uncompared");
assert_eq(_w2W3_q(1), 0x3D5B95880FF1C000, "mpr_penetration: ... the same, 1e-5 eps below the exact");
assert_eq(_w2W3_q(5), 0x3D5B95880FF1C000, "gjk_epa_3d: ... the same with the ball first");
# _ga_rim_ring's two caps, asked directly at inputs where each decides the ring. Over four families of 3,000 balls
# past the rim, t's cap fires in 29 to 49 rings each and without it 5 to 10 scenes take up to 16 more support calls,
# no answer moving; delta's fires in none. Cylinder about z, R 1, from n = +z; 1 when the ring proves the contact.
# [measured: scratch W3 py/gen.py families fo1 to fo4, an instrumented copy and one without t's cap; 2026-11-14]
fn _w2W3_rr() {
    _GA_MINK_S = F64_ONE;
    _GA_MINK_AXES = 0;
    _GA_CORE_RHO = 0;
    _GA_DL_SM = 0;
    _GA_DL_SMS = 0;
    var dl = _ga_proof_margin(&_w2W3_sup_cyl, _w2W3_c, &_w2W3_sup_ball, _w2W3_b);
    var n = hvec3_new(0, 0, F64_ONE);
    var d = hvec3_dot(_gjk_mink_support(&_w2W3_sup_cyl, _w2W3_c, &_w2W3_sup_ball, _w2W3_b, n), n);
    var w4: i64[4];
    var cand: i64[2];
    var r = _ga_rim_ring(&_w2W3_sup_cyl, _w2W3_c, &_w2W3_sup_ball, _w2W3_b, n, d, dl, &w4, &cand);
    _GA_MINK_S = 0;
    _GA_DL_SM = 0;
    _GA_DL_SMS = 0;
    return r;
}
# A ball of radius 0.5 over the cap's centre, 1e-6 deep: sin^2 delta = gr / R = 1.0005, no cosine; with delta
# uncapped the ring's directions are NaN and it answers 0.
_w2W3_cyl(0, 0, 0, 0, 0, F64_ONE, F64_ONE, F64_ONE);
_w2W3_ball(0, 0, 0x3FF7FFFEF39085F5, 0x3FE0000000000000);
assert_eq(_w2W3_rr(), 1, "_ga_rim_ring: a ball over the cap's centre is held with delta capped at 1/4");
# A cylinder of half height 500, a ball of radius 0.01 at radius 0.99 (0.01 in from the side) and 0.5 below the cap: t's
# midpoint is 5, where kr t overstates the rim's reach (kr sin(atan 5) = 0.98 kr) and the chord passes inside the
# origin; uncapped the ring answers 0.
_w2W3_cyl(0, 0, 0, 0, 0, F64_ONE, F64_ONE, 0x407F400000000000);
_w2W3_ball(0x3FEFAE147AE147AE, 0, 0x407F3828F5C28F5C, 0x3F847AE147AE147B);
assert_eq(_w2W3_rr(), 1, "_ga_rim_ring: a ball 0.01 in from a tall cylinder's side is held with t capped at b");

# ==================================================================================================
test_group("3.5.0 W3: the collision entries refuse every working slot in turn (INS5 F1)");
# The refusal sweep of tests/modules_d.tcyr's "the collision entries' failure channel" group reaches the slots its
# fourteen fixtures' paths allocate. 29 of the 65 refusal checks in the five entries' paths are on paths none of them
# takes (the cycling path's portal, distance query, rings and band, the touch probe, an aspect confirmation, the
# shallow snap, and time_of_impact's second distance query): with any one of those checks deleted every suite still
# passed. So these fixtures take those paths, and a counting allocator in hisab's scope refuses the k-th request of a
# size other than 24 bytes (an HVec3's, the temporaries the first sweep covers; each of the 29 is 8 to 48 bytes),
# for every k the query makes. Each _checked answer must be Err(HSB_ERR_ALLOC) with the plain form's placeholders or
# the open answer bit for bit, and the plain form 0 or that same answer.
# [measured: scratch W3 mut/run.py over mut/sweep.tcyr (the first sweep alone) and this group, this tree; 2026-11-14]
var _w2W3_k = 0;
var _w2W3_kn = 0;
var _w2W3_hits = 0;
# The requests it grants come from a growable arena, rewound at each refusal point as in the 3.5.0 L2
# sweeps above (served from the global heap, this group held 3.1 GB resident at the end).
# [measured: scratch vmpeak.py and a per-group VmRSS trace of the modules_d binary, 2026-11-14]
var _w2W3_ar = arena_new_growable(1048576);
fn _w2W3_al(state, size) {
    if (size != 24) {
        _w2W3_kn = _w2W3_kn + 1;
        if (_w2W3_k != 0 && _w2W3_kn == _w2W3_k) {
            _w2W3_hits = _w2W3_hits + 1;
            return 0;
        }
    }
    return arena_alloc(_w2W3_ar, size);
}
fn _w2W3_re(state, p, osz, nsz) {
    var q = _w2W3_al(state, nsz);
    if (q != 0 && p != 0) {
        var m = osz;
        if (nsz < m) { m = nsz; }
        for (var i = 0; i < m; i = i + 1) { store8(q + i, load8(p + i)); }
    }
    return q;
}
fn _w2W3_fr(state, p) { return 0; }
fn _w2W3_rs(state) { return 0; }
var _w2W3_A = allocator_new(&_w2W3_al, &_w2W3_re, &_w2W3_fr, &_w2W3_rs, 0);
fn _w2W3_arm(k) {
    _w2W3_k = k;
    _w2W3_kn = 0;
    _w2W3_hits = 0;
    return hisab_alloc_scope(_w2W3_A);
}
fn _w2W3_disarm(prev) {
    hisab_alloc_scope(prev);
    _w2W3_k = 0;
    return 0;
}
# Axis-aligned box: shape = [cx, cy, cz, hx, hy, hz]; one allocation, its answer.
fn _w2W3_bx(c, h, d) {
    if (f64_lt(d, 0) == 1) { return f64_sub(c, h); }
    return f64_add(c, h);
}
fn _w2W3_sup_box(sh, d) {
    _w2W3_calls = _w2W3_calls + 1;
    var x = _w2W3_bx(load64(sh), load64(sh + 24), HVec3_x(d));
    var y = _w2W3_bx(load64(sh + 8), load64(sh + 32), HVec3_y(d));
    return hvec3_new(x, y, _w2W3_bx(load64(sh + 16), load64(sh + 40), HVec3_z(d)));
}
fn _w2W3_w8b(c0, c1, c2, h0, h1, h2) {
    var s = alloc(48);
    store64(s, c0);
    store64(s + 8, c1);
    store64(s + 16, c2);
    store64(s + 24, h0);
    store64(s + 32, h1);
    store64(s + 40, h2);
    return s;
}
fn _w2W3_w(n, p) {
    var s = alloc(n * 8);
    for (var i = 0; i < n; i = i + 1) { store64(s + i * 8, load64(p + i * 8)); }
    return s;
}
# The fixtures: [support A, shape A, support B, shape B, B's velocity, the entries asked (bit e for entry e)] per
# case. gjk_intersect_3d and mpr_intersect share one path, and time_of_impact is asked where its own query runs.
var _w2W3_NF = 6;
var _w2W3_fx: i64[36];
var _w2W3_tw: i64[8];
fn _w2W3_fix(i, fa, sa, fb, sb, vb) {
    store64(&_w2W3_fx + i * 48, fa);
    store64(&_w2W3_fx + i * 48 + 8, sa);
    store64(&_w2W3_fx + i * 48 + 16, fb);
    store64(&_w2W3_fx + i * 48 + 24, sb);
    store64(&_w2W3_fx + i * 48 + 32, vb);
    store64(&_w2W3_fx + i * 48 + 40, 31);
    return 0;
}
fn _w2W3_t8(c0, c1, c2, u0, u1, u2, r, hz) {
    store64(&_w2W3_tw, c0);
    store64(&_w2W3_tw + 8, c1);
    store64(&_w2W3_tw + 16, c2);
    store64(&_w2W3_tw + 24, u0);
    store64(&_w2W3_tw + 32, u1);
    store64(&_w2W3_tw + 40, u2);
    store64(&_w2W3_tw + 48, r);
    store64(&_w2W3_tw + 56, hz);
    return _w2W3_w(8, &_w2W3_tw);
}
var _w2W3_z3 = hvec3_zero();
# 0: the roadmap's ball over a cap by its rim (the cycling path, the distance query, the rings).
_w2W3_fix(0, &_w2W3_sup_cyl, _w2W3_t8(0, 0, 0, 0x3FDEC52278832907, 0x3FEBF3777A16626A, 0xBFB3A95058ECC51E,
    0x3FEE7E8EA65106AC, 0x3FF4CCBB9D4EA828), &_w2W3_sup_ball, _w2W3_t8(0xBFF1AE7133FE37DC, 0xBFEE6E9C63A92831,
    0xBFE67A6B12AD89CC, 0x3F807A643D37EE23, 0, 0, 0, 0), _w2W3_z3);
# 1: a ball past the rim 8.6 eps deep (the portal's run, the ring round its normal).
_w2W3_fix(1, &_w2W3_sup_cyl, _w2W3_t8(0xBFB02F93BE21B8B0, 0xBFED7334BADC56F2, 0xBFC4D3DF6114BBB0, 0xBF7B3B37C7F828DA,
    0xBFCC470E0BEAD70F, 0x3FEF3568A7AB6576, 0x3FDA32EDC1691DC0, 0x3FE38153A2D22124), &_w2W3_sup_ball,
  _w2W3_t8(0x3FCB9E856039BE8C, 0xBFDDE60013C9AF2E, 0xBFE9349C37D8FA1D, 0x3FBA17F4CC94EB68, 0, 0, 0, 0), _w2W3_z3);
# 2: tests/modules.tcyr's ball on a cylinder at 2^300 (the call's scale, an aspect confirmation).
_w2W3_fix(2, &_w2W3_sup_cyl, _w2W3_t8(0x530E0C9CDBD59BE3, 0x529278744C7B6468, 0xD263FEF53FE413C0, 0xBFECAC3C820E620A,
    0xBFD11DF14D145C22, 0xBFD6AEB300C2069F, 0x52A8B97FAE3262C2, 0x52E4E677E9D74E0D), &_w2W3_sup_ball,
  _w2W3_t8(0x53116CD3A01A773E, 0x52C2CD2C11ECF720, 0x52CCECA026BF5895, 0x52BA6E17CB5A58A4, 0, 0, 0, 0), _w2W3_z3);
# 3: two unit boxes touching at x = 1 (the touch probe).
_w2W3_fix(3, &_w2W3_sup_box, _w2W3_t8(0, 0, 0, F64_ONE, F64_ONE, F64_ONE, 0, 0), &_w2W3_sup_box,
  _w2W3_t8(F64_TWO, 0x3FE0000000000000, 0, F64_ONE, F64_ONE, F64_ONE, 0, 0), _w2W3_z3);
# 4: a ball 0.5 eps off a cylinder's rim (in the band: its decision, _ga_band_apart).
_w2W3_fix(4, &_w2W3_sup_cyl, _w2W3_t8(0xBFEFB2B09E78C02C, 0xBFE8D5BC6BEA8648, 0x3FBB7CDCE2772EB0, 0xBFEF95F74B9C62DF,
    0xBFC27A9E94029B29, 0x3FB1E120D7FDAEF1, 0x3FE34CD238B724C8, 0x3FD68E48BB1F05E7), &_w2W3_sup_ball,
  _w2W3_t8(0xBFF760FE46A4E8BD, 0xBFCE958AB0302977, 0x3FC9926845B18F1D, 0x3FA4FDB6777C06C2, 0, 0, 0, 0), _w2W3_z3);
# 5: a ball swept onto a cylinder's side (time_of_impact's queries).
_w2W3_fix(5, &_w2W3_sup_cyl, _w2W3_t8(0, 0, 0, 0, 0, F64_ONE, F64_ONE, F64_TWO), &_w2W3_sup_ball,
  _w2W3_t8(0x4010000000000000, 0x3FC0000000000000, 0x3FD0000000000000, 0x3FE0000000000000, 0, 0, 0, 0),
  hvec3_new(0xC008000000000000, 0, 0));
store64(&_w2W3_fx + 40, 5);
store64(&_w2W3_fx + 88, 9);
store64(&_w2W3_fx + 232, 9);
store64(&_w2W3_fx + 280, 16);
# Entry e of case c, checked (pl 0) or plain (pl 1): out = [kind (1 Ok, 2 Err, 3 plain), value, nx, ny, nz, d].
fn _w2W3_run(c, e, pl, out) {
    var fa = load64(&_w2W3_fx + c * 48);
    var sa = load64(&_w2W3_fx + c * 48 + 8);
    var fb = load64(&_w2W3_fx + c * 48 + 16);
    var sb = load64(&_w2W3_fx + c * 48 + 24);
    var vb = load64(&_w2W3_fx + c * 48 + 32);
    var nb: i64[1];
    var db: i64[1];
    store64(&nb, 0x1234);
    store64(&db, 0x5678);
    var t = 0;
    var v = 0;
    if (e == 0) {
        if (pl == 1) { v = gjk_intersect_3d(fa, sa, fb, sb); }
        else {
            var t0, v0 = gjk_intersect_3d_checked(fa, sa, fb, sb);
            t = t0;
            v = v0;
        }
    } elif (e == 1) {
        if (pl == 1) { v = mpr_intersect(fa, sa, fb, sb); }
        else {
            var t1, v1 = mpr_intersect_checked(fa, sa, fb, sb);
            t = t1;
            v = v1;
        }
    } elif (e == 2) {
        if (pl == 1) { v = gjk_epa_3d(fa, sa, fb, sb, &nb, &db); }
        else {
            var t2, v2 = gjk_epa_3d_checked(fa, sa, fb, sb, &nb, &db);
            t = t2;
            v = v2;
        }
    } elif (e == 3) {
        if (pl == 1) { v = mpr_penetration(fa, sa, fb, sb, &nb, &db); }
        else {
            var t3, v3 = mpr_penetration_checked(fa, sa, fb, sb, &nb, &db);
            t = t3;
            v = v3;
        }
    } else {
        if (pl == 1) { v = time_of_impact(fa, sa, _w2W3_z3, fb, sb, vb, F64_TWO, &db, &nb); }
        else {
            var t4, v4 = time_of_impact_checked(fa, sa, _w2W3_z3, fb, sb, vb, F64_TWO, &db, &nb);
            t = t4;
            v = v4;
        }
    }
    store64(out, 3);
    if (pl == 0) {
        store64(out, 2);
        if (is_ok(t) == 1) { store64(out, 1); }
    }
    store64(out + 8, v);
    var n = load64(&nb);
    if (n == 0x1234 || n == 0) {
        store64(out + 16, n);
        store64(out + 24, n);
        store64(out + 32, n);
    } else {
        store64(out + 16, HVec3_x(n));
        store64(out + 24, HVec3_y(n));
        store64(out + 32, HVec3_z(n));
    }
    store64(out + 40, load64(&db));
    return 0;
}
fn _w2W3_same(a, b) {
    for (var i = 1; i < 6; i = i + 1) { if (load64(a + i * 8) != load64(b + i * 8)) { return 0; } }
    return 1;
}
# 1 when out is the designed refusal of entry e: Err(HSB_ERR_ALLOC) and the plain form's placeholders (gjk_epa_3d,
# mpr_penetration: unit_x or a 0 normal, depth +0; time_of_impact: neither written).
fn _w2W3_refusal(e, out) {
    if (load64(out) != 2 || load64(out + 8) != HSB_ERR_ALLOC) { return 0; }
    if (e < 2) { return 1; }
    if (e == 4) { return load64(out + 16) == 0x1234 && load64(out + 40) == 0x5678; }
    var nx = load64(out + 16);
    var nok = (nx == F64_ONE && load64(out + 24) == 0 && load64(out + 32) == 0) || nx == 0;
    return nok == 1 && load64(out + 40) == 0;
}
var _w2W3_open: i64[6];
var _w2W3_cw: i64[6];
var _w2W3_pw: i64[6];
var _w2W3_bad = 0;
var _w2W3_errs = 0;
var _w2W3_ok1 = 0;
var _w2W3_good = 0;
for (var _w2W3_ci = 0; _w2W3_ci < _w2W3_NF; _w2W3_ci = _w2W3_ci + 1) {
    for (var _w2W3_e = 0; _w2W3_e < 5; _w2W3_e = _w2W3_e + 1) {
        if (((load64(&_w2W3_fx + _w2W3_ci * 48 + 40) >> _w2W3_e) & 1) == 0) { continue; }
        var _w2W3_e0 = _w2W3_errs;
        _w2W3_run(_w2W3_ci, _w2W3_e, 0, &_w2W3_open);
        if (load64(&_w2W3_open) == 1) { _w2W3_ok1 = _w2W3_ok1 + 1; }
        var _w2W3_kk = 1;
        var _w2W3_done = 0;
        while (_w2W3_done == 0 && _w2W3_kk < 100000) {
            arena_reset(_w2W3_ar);
            var _w2W3_pv = _w2W3_arm(_w2W3_kk);
            _w2W3_run(_w2W3_ci, _w2W3_e, 0, &_w2W3_cw);
            var _w2W3_hit = _w2W3_hits;
            _w2W3_disarm(_w2W3_pv);
            _w2W3_pv = _w2W3_arm(_w2W3_kk);
            _w2W3_run(_w2W3_ci, _w2W3_e, 1, &_w2W3_pw);
            _w2W3_disarm(_w2W3_pv);
            if (_w2W3_hit == 0) { _w2W3_done = 1; }
            if (_w2W3_refusal(_w2W3_e, &_w2W3_cw) == 1) {
                _w2W3_errs = _w2W3_errs + 1;
                if (load64(&_w2W3_pw + 8) != 0) { _w2W3_bad = _w2W3_bad + 1; }
            } elif (load64(&_w2W3_cw) == 1 && _w2W3_same(&_w2W3_cw, &_w2W3_open) == 1) {
                if (_w2W3_same(&_w2W3_pw, &_w2W3_open) == 0) { _w2W3_bad = _w2W3_bad + 1; }
            } else {
                _w2W3_bad = _w2W3_bad + 1;
            }
            _w2W3_kk = _w2W3_kk + 1;
        }
        if (_w2W3_done == 1 && _w2W3_errs > _w2W3_e0) { _w2W3_good = _w2W3_good + 1; }
    }
}
assert_eq(_w2W3_ok1, 17, "the 17 entries asked: each _checked open answer is Ok");
assert_eq(_w2W3_good, 17, "the 17 entries asked: each sweep ran to its open answer, with an Err at some refusal");
assert_eq(_w2W3_bad, 0, "every refusal: Err(HSB_ERR_ALLOC) and the plain 0, or the open answer bit for bit");

