var _w2W6_bd = ad_add(_w2W6_t9, ad_sqrt(_w2W6_t9, _w2W6_zd), ad_pow(_w2W6_t9, _w2W6_xd, _w2W6_MONE));
var _w2W6_gd = _w2W6_tg(_w2W6_t9, ad_mul(_w2W6_t9, _w2W6_bd, _w2W6_vd), _w2W6_xd);
assert_eq(f64_eq(_w2W6_gd, _w2W6_gd), 0, "tape: (sqrt(z) + x^-1) v at v = 0 along x: NaN, v moves (item (3))");
_w2W6_gd = _w2W6_tg(_w2W6_t9, ad_mul(_w2W6_t9, _w2W6_vd, _w2W6_bd), _w2W6_xd);
assert_eq(f64_eq(_w2W6_gd, _w2W6_gd), 0, "tape: v (sqrt(z) + x^-1): NaN too");
# The uncompensated sweep refuses an i2 of -2 (no i2's value) as the compensated one does.
var _w2W6_te = ad_tape_new(4200);
for (var _w2W6_ie = 0; _w2W6_ie < 4100; _w2W6_ie = _w2W6_ie + 1) { var _w2W6_ce = ad_var(_w2W6_te, F64_ONE); }
var _w2W6_re = ad_mul(_w2W6_te, 4098, 4099);
store64(_ad_node(_w2W6_te, _w2W6_re) + 32, 0 - 2);
var _w2W6_et, _w2W6_ev = ad_grad(_w2W6_te, _w2W6_re);
assert_eq(_w2W6_et, 1, "tape: an i2 of -2 past 4,096 nodes: refused, Err");
assert_eq(_w2W6_ev, HSB_ERR_INVALID_INPUT, "... HSB_ERR_INVALID_INPUT");
# Past 63 cuttable edges two share a label; 70 terms sqrt(y_i) (sqrt(z_i) + x_i^-1) on one tape, one
# label pass and one more sweep: every x_i is cut (+0), every y_i and z_i keeps the miss's NaN. Each
# product's partner is its second factor (o = 0) on one tape and its first (o = 1) on the other.
fn _w2W6_many(o) {
    var t = ad_tape_new(1024);
    var ids: i64[210];
    var r = ad_const(t, 0);
    for (var i = 0; i < 70; i = i + 1) {
        var y = ad_var(t, 0);
        var z = ad_var(t, 0);
        var x = ad_var(t, _w2W6_E200);
        store64(&ids + i * 24, y);
        store64(&ids + i * 24 + 8, z);
        store64(&ids + i * 24 + 16, x);
        var b = ad_add(t, ad_sqrt(t, z), ad_pow(t, x, _w2W6_MONE));
        var p = ad_mul(t, ad_sqrt(t, y), b);
        if (o == 1) { p = ad_mul(t, b, ad_sqrt(t, y)); }
        r = ad_add(t, r, p);
    }
    var gt, gv = ad_grad(t, r);
    var bad = 0;
    for (var i = 0; i < 70; i = i + 1) {
        if (ad_grad_of(t, load64(&ids + i * 24 + 16)) != 0) { bad = bad + 1; }
        if (ad_grad_of(t, load64(&ids + i * 24)) != _w2W6_NAN) { bad = bad + 1; }
        if (ad_grad_of(t, load64(&ids + i * 24 + 8)) != _w2W6_NAN) { bad = bad + 1; }
    }
    return bad;
}
assert_eq(_w2W6_many(0), 0, "tape: 70 terms, labels shared past 63: every x_i cut to +0 (3.4.2: NaN), y_i, z_i NaN");
assert_eq(_w2W6_many(1), 0, "tape: ... the factors swapped: the same");
# A cut node's one edge is cut where its partial is +-0, the constant zero's, which every cut node
# ad_* records has. An i2 of -4 set by hand beside a nonzero partial is an ordinary edge: on
# k = (sqrt(y) + x^-1) 1 (partial 1), k - x^-1 at (y, x) = (0, 1e-200) has the chain rule's d/dx
# 1 (-Inf) + (-1)(-Inf) = -Inf + Inf, NaN, in both sweeps, and so does forward mode (as built and in
# 3.4.2: NaN). As ad_mul records it, 0 (sqrt(y) + x^-1) - x^-1 cuts that edge along x and reads
# x^-1's slope alone, 1e400 = +Inf, forward mode's answer. kind 0: the hand-set node; 1: as recorded.
# pad 1 puts the root past 4,096 (the uncompensated sweep). j: 0 d/dx, 1 the sweep's tag, 2 k's i2.
# [measured: tests/modules_d.tcyr, the assertions below]
fn _w2W6_h4(kind, pad, j) {
    var t = ad_tape_new(4200);
    if (pad == 1) {
        for (var i = 0; i < 4100; i = i + 1) { var c = ad_const(t, F64_ONE); }
    }
    var y = ad_var(t, 0);
    var x = ad_var(t, _w2W6_E200);
    var o = ad_add(t, ad_sqrt(t, y), ad_pow(t, x, _w2W6_MONE));
    var k = ad_mul(t, ad_const(t, 0), o);
    if (kind == 0) {
        k = ad_mul(t, o, ad_const(t, F64_ONE));
        store64(_ad_node(t, k) + 32, _AD_CUT_NODE);
    }
    var r = ad_add(t, k, ad_neg(t, ad_pow(t, x, _w2W6_MONE)));
    if (j == 2) { return load64(_ad_node(t, k) + 32); }
    var gt, gv = ad_grad(t, r);
    if (j == 1) { return gt; }
    return ad_grad_of(t, x);
}
var _w2W6_dh4 = dual_var(_w2W6_E200);
var _w2W6_oh4 = dual_add(dual_sqrt(dual_const(0)), dual_pow(_w2W6_dh4, _w2W6_MONE));
var _w2W6_nh4 = dual_neg(dual_pow(_w2W6_dh4, _w2W6_MONE));
var _w2W6_fh4 = Dual_deriv(dual_add(dual_mul(_w2W6_oh4, dual_const(F64_ONE)), _w2W6_nh4));
assert_eq(f64_eq(_w2W6_fh4, _w2W6_fh4), 0, "forward: (sqrt(y) + x^-1) 1 - x^-1 along x: -Inf + Inf, NaN");
assert_eq(_w2W6_h4(0, 0, 1), 0, "tape: a hand-set i2 = -4 beside the partial 1: Ok, one edge");
var _w2W6_gh4 = _w2W6_h4(0, 0, 0);
assert_eq(f64_eq(_w2W6_gh4, _w2W6_gh4), 0, "tape: ... d/dx NaN, the edge kept (merged tree: +Inf, cut)");
assert_eq(_w2W6_h4(0, 1, 1), 0, "tape: ... from a root past 4,096: Ok, one edge");
_w2W6_gh4 = _w2W6_h4(0, 1, 0);
assert_eq(f64_eq(_w2W6_gh4, _w2W6_gh4), 0, "tape: ... d/dx NaN there too, no cut");
_w2W6_fh4 = Dual_deriv(dual_add(dual_mul(dual_const(0), _w2W6_oh4), _w2W6_nh4));
assert_eq(_w2W6_fh4, 0x7FF0000000000000, "forward: 0 (sqrt(y) + x^-1) - x^-1 along x: +Inf");
assert_eq(_w2W6_h4(1, 0, 2), _AD_CUT_NODE, "tape: ad_mul records 0 (sqrt(y) + x^-1) as a cut node");
assert_eq(_w2W6_h4(1, 0, 0), 0x7FF0000000000000, "tape: ... its zero partial cut along x: +Inf, as forward");

# ==================================================================================================
# 3.5.0 W6 — autodiff: a constant zero annihilates an infinite slope that is not a miss
# ==================================================================================================
# x^0.5 at 0 was the infinite slope of 3.4.1 SYM2's and SYM3's groups, and is a miss now; x^-1 at
# 1e-200 (value 1e200, slope -1e400 = -Inf) keeps their rule in both modes.
test_group("3.5.0 W6: a constant zero annihilates an infinite slope that is not a miss");
var _w2W6_u = dual_pow(dual_var(_w2W6_E200), _w2W6_MONE);
assert_eq(Dual_val(_w2W6_u), _w2W6_P200, "fixture: x^-1 at 1e-200 is 1e200");
assert_eq(Dual_deriv(_w2W6_u), 0xFFF0000000000000, "fixture: its tangent -1e400 is -Inf, not a miss");
assert_eq(Dual_deriv(dual_mul(dual_const(0), _w2W6_u)), 0, "forward: const 0 * u -> +0");
assert_eq(Dual_deriv(dual_mul(_w2W6_u, dual_const(0x8000000000000000))), 0, "forward: u * const -0 -> +0");
assert_eq(Dual_deriv(dual_mul(dual_pow(dual_const(0), F64_TWO), _w2W6_u)), 0, "forward: (const 0)^2 u -> +0");
assert_eq(Dual_deriv(dual_mul(dual_new(0, 0), _w2W6_u)), 0, "forward: (y = 0, seed +0) u -> +0");
var _w2W6_mz = dual_mul(dual_sub(dual_var(_w2W6_E200), dual_const(_w2W6_E200)), _w2W6_u);
assert_eq(f64_eq(Dual_deriv(_w2W6_mz), Dual_deriv(_w2W6_mz)), 0, "forward: a moving zero times u -> NaN (0 * -Inf)");
ad_tape_reset(_w2W6_t);
_w2W6_x = ad_var(_w2W6_t, _w2W6_E200);
var _w2W6_tu = ad_pow(_w2W6_t, _w2W6_x, _w2W6_MONE);
_w2W6_r = ad_mul(_w2W6_t, ad_const(_w2W6_t, 0), _w2W6_tu);
assert_eq(_w2W6_tg(_w2W6_t, _w2W6_r, _w2W6_x), 0, "tape: const 0 * u -> +0, the constant recorded");
_w2W6_r = ad_mul(_w2W6_t, _w2W6_tu, ad_const(_w2W6_t, 0x8000000000000000));
assert_eq(_w2W6_tg(_w2W6_t, _w2W6_r, _w2W6_x), 0, "tape: u * const -0 -> +0");
var _w2W6_tv = ad_var(_w2W6_t, 0);
_w2W6_r = ad_mul(_w2W6_t, _w2W6_tv, _w2W6_tu);
var _w2W6_g6 = _w2W6_tg(_w2W6_t, _w2W6_r, _w2W6_x);
assert_eq(f64_eq(_w2W6_g6, _w2W6_g6), 0, "tape: y u at y = 0 along x: NaN, every ad_var moves (item (3))");
# Next to an infinity no compensation term is kept (3.4.1 SYM3): u + u (two nodes) is -Inf, and
# 1 u + (-2^-60) u (one node, adjoint 1 - 2^-60, which rounds to 1) is -Inf too, not NaN.
_w2W6_r = ad_add(_w2W6_t, _w2W6_tu, ad_pow(_w2W6_t, _w2W6_x, _w2W6_MONE));
assert_eq(_w2W6_tg(_w2W6_t, _w2W6_r, _w2W6_x), 0xFFF0000000000000, "tape: d/dx (x^-1 + x^-1) at 1e-200 = -Inf");
_w2W6_r = ad_add(_w2W6_t, ad_mul(_w2W6_t, ad_const(_w2W6_t, F64_ONE), _w2W6_tu),
  ad_mul(_w2W6_t, ad_const(_w2W6_t, 0xBC30000000000000), _w2W6_tu));
assert_eq(_w2W6_tg(_w2W6_t, _w2W6_r, _w2W6_x), 0xFFF0000000000000, "tape: d/dx ((1 - 2^-60) x^-1) = -Inf, not NaN");
# The block above dual_div's examples. An operand minus itself is the constant 0, so (x - x) x^-1 at
# 1e-200 is +0 in both modes; x - x' with x' a second handle to 1e-200 is a moving zero, and so is
# x - 1e-200, each meeting x^-1's -Inf: NaN in both modes ((x - 1e-200) x^-1 has the derivative
# 1 / 1e-200, which the slope -1e400 no longer holds: item (4)).
var _w2W6_sx = dual_var(_w2W6_E200);
var _w2W6_su = dual_pow(_w2W6_sx, _w2W6_MONE);
assert_eq(Dual_deriv(dual_mul(dual_sub(_w2W6_sx, _w2W6_sx), _w2W6_su)), 0, "forward: (x - x) x^-1 at 1e-200 -> +0");
var _w2W6_sd = Dual_deriv(dual_mul(dual_sub(_w2W6_sx, dual_var(_w2W6_E200)), _w2W6_su));
assert_eq(f64_eq(_w2W6_sd, _w2W6_sd), 0, "forward: (x - x') x^-1, x' a second handle -> NaN (0 * -Inf)");
ad_tape_reset(_w2W6_t);
_w2W6_x = ad_var(_w2W6_t, _w2W6_E200);
_w2W6_tu = ad_pow(_w2W6_t, _w2W6_x, _w2W6_MONE);
_w2W6_r = ad_mul(_w2W6_t, ad_sub(_w2W6_t, _w2W6_x, _w2W6_x), _w2W6_tu);
assert_eq(_w2W6_tg(_w2W6_t, _w2W6_r, _w2W6_x), 0, "tape: (x - x) x^-1 at 1e-200 -> +0");
var _w2W6_x2h = ad_mul(_w2W6_t, _w2W6_x, ad_const(_w2W6_t, F64_ONE));
_w2W6_r = ad_mul(_w2W6_t, ad_sub(_w2W6_t, _w2W6_x, _w2W6_x2h), _w2W6_tu);
var _w2W6_sg = _w2W6_tg(_w2W6_t, _w2W6_r, _w2W6_x);
assert_eq(f64_eq(_w2W6_sg, _w2W6_sg), 0, "tape: (x - x') x^-1, x' = 1 x a second node -> NaN (0 * -Inf)");
_w2W6_r = ad_mul(_w2W6_t, ad_sub(_w2W6_t, _w2W6_x, ad_const(_w2W6_t, _w2W6_E200)), _w2W6_tu);
_w2W6_sg = _w2W6_tg(_w2W6_t, _w2W6_r, _w2W6_x);
assert_eq(f64_eq(_w2W6_sg, _w2W6_sg), 0, "tape: (x - 1e-200) x^-1 at 1e-200 -> NaN (0 * -Inf)");

# ==================================================================================================
# 3.5.0 W6 — symbolic: the memo walks answer as the plain walks do
# ==================================================================================================
# Roadmap [3.5.0] row "the memo walks' cost" (wave 1's note 3). The memo walks were rewritten with
# their stacks and the memo's look-up in place, two visits per operator and a bit filter before the
# table; the oracle is the plain walks (3.4.2's, unchanged): random DAGs whose nodes are shared
# from a pool, deep chains past _SYM_REC_DEPTH, a DAG whose plain walk is 2^31 visits.
test_group("3.5.0 W6: the memo walks answer as the plain walks do");
var _w2W6_seed = 7;
fn _w2W6_rnd(m) {
    _w2W6_seed = _w2W6_seed * 6364136223846793005 + 1442695040888963407;
    return ((_w2W6_seed >> 33) & 0x7FFFFFFF) % m;
}
var _w2W6_X = str_from("x");
var _w2W6_Y = str_from("y");
var _w2W6_pool = vec_new();
fn _w2W6_leaf() {
    var k = _w2W6_rnd(5);
    if (k == 0) { return expr_var(_w2W6_X); }
    if (k == 1) { return expr_var(_w2W6_Y); }
    if (k == 2) { return expr_const(f64_from(_w2W6_rnd(5))); }
    if (k == 3) { return expr_const(f64_div(f64_from(_w2W6_rnd(9) + 1), f64_from(4))); }
    return expr_neg(expr_var(_w2W6_X));
}
fn _w2W6_gen(d) {
    var n = vec_len(_w2W6_pool);
    if (n > 0 && _w2W6_rnd(4) == 0) { return vec_get(_w2W6_pool, n - 1 - _w2W6_rnd(n)); }
    if (d == 0 || _w2W6_rnd(6) == 0) { return _w2W6_leaf(); }
    var k = _w2W6_rnd(9);
    var e = 0;
    if (k == 0) { e = expr_add(_w2W6_gen(d - 1), _w2W6_gen(d - 1)); }
    elif (k == 1) { e = expr_mul(_w2W6_gen(d - 1), _w2W6_gen(d - 1)); }
    elif (k == 2) { e = expr_pow(_w2W6_gen(d - 1), _w2W6_gen(d - 1)); }
    elif (k == 3) { e = expr_neg(_w2W6_gen(d - 1)); }
    elif (k == 4) { e = expr_sin(_w2W6_gen(d - 1)); }
    elif (k == 5) { e = expr_cos(_w2W6_gen(d - 1)); }
    elif (k == 6) { e = expr_exp(_w2W6_gen(d - 1)); }
    elif (k == 7) { e = expr_ln(_w2W6_gen(d - 1)); }
    else { e = expr_neg(expr_neg(_w2W6_gen(d - 1))); }
    vec_push(_w2W6_pool, e);
    return e;
}
fn _w2W6_chain(n) {
    var e = expr_var(_w2W6_X);
    for (var i = 0; i < n; i = i + 1) {
        var k = _w2W6_rnd(5);
        if (k == 0) { e = expr_add(e, _w2W6_gen(2)); }
        elif (k == 1) { e = expr_pow(_w2W6_gen(1), e); }
        elif (k == 2) { e = expr_neg(e); }
        elif (k == 3) { e = expr_sin(e); }
        else { e = expr_mul(e, _w2W6_gen(1)); }
    }
    return e;
}
# 1 when the trees a and b are equal node for node (tags, constants' bits, variables' names).
fn _w2W6_seq(a, b) {
    if (a == b) { return 1; }
    if (a == 0 || b == 0) { return 0; }
    var t = load64(a);
    if (t != load64(b)) { return 0; }
    if (t == EXPR_CONST) { if (load64(a + 8) == load64(b + 8)) { return 1; } return 0; }
    if (t == EXPR_VAR) { return str_eq(load64(a + 8), load64(b + 8)); }
    if (t <= EXPR_POW) {
        if (_w2W6_seq(load64(a + 8), load64(b + 8)) == 0) { return 0; }
        return _w2W6_seq(load64(a + 16), load64(b + 16));
    }
    return _w2W6_seq(load64(a + 8), load64(b + 8));
}
var _w2W6_vars = vec_new();
vec_push(_w2W6_vars, expr_bind(_w2W6_X, 0x3FE3333333333333));
vec_push(_w2W6_vars, expr_bind(_w2W6_Y, 0xBFF8000000000000));
var _w2W6_bad: i64[2];
var _w2W6_n = 0;
var _w2W6_fe = 0;
var _w2W6_fs = 0;
var _w2W6_fd = 0;
for (var _w2W6_i = 0; _w2W6_i < 600; _w2W6_i = _w2W6_i + 1) {
    if (_w2W6_i % 40 == 0) { _w2W6_pool = vec_new(); }
    var _w2W6_e = 0;
    if (_w2W6_i % 12 == 11) {
        _w2W6_e = _w2W6_chain(300 + _w2W6_rnd(200));
    } else {
        _w2W6_e = _w2W6_gen(5 + _w2W6_rnd(5));
    }
    store64(&_w2W6_bad, 0);
    store64(&_w2W6_bad + 8, 0);
    var _w2W6_va = _sym_eval(_w2W6_e, _w2W6_vars, &_w2W6_bad, 0);
    var _w2W6_ba = load64(&_w2W6_bad);
    if (load64(&_w2W6_bad + 8) <= _SYM_SHARE_WALK) {
        _w2W6_n = _w2W6_n + 1;
        store64(&_w2W6_bad, 0);
        var _w2W6_vb = _sym_eval_memo(_w2W6_e, _w2W6_vars, &_w2W6_bad);
        if (load64(&_w2W6_bad) != _w2W6_ba || _w2W6_va != _w2W6_vb) { _w2W6_fe = _w2W6_fe + 1; }
        store64(&_w2W6_bad, 0);
        var _w2W6_sa = _sym_simp_rec(_w2W6_e, 0, &_w2W6_bad);
        if (_w2W6_seq(_w2W6_sa, _sym_simp_memo(_w2W6_e)) == 0) { _w2W6_fs = _w2W6_fs + 1; }
        store64(&_w2W6_bad, 0);
        if (_w2W6_seq(_w2W6_sa, _sym_simp_deep(_w2W6_e, &_w2W6_bad)) == 0) { _w2W6_fs = _w2W6_fs + 1; }
        store64(&_w2W6_bad, 0);
        var _w2W6_da = _sym_diff_rec(_w2W6_e, _w2W6_X, 0, &_w2W6_bad);
        if (_w2W6_seq(_w2W6_da, _sym_diff_memo(_w2W6_e, _w2W6_X)) == 0) { _w2W6_fd = _w2W6_fd + 1; }
        store64(&_w2W6_bad, 0);
        if (_w2W6_seq(_w2W6_da, _sym_diff_deep(_w2W6_e, _w2W6_X, &_w2W6_bad)) == 0) { _w2W6_fd = _w2W6_fd + 1; }
    }
}
var _w2W6_enough = 0;
if (_w2W6_n >= 590) { _w2W6_enough = 1; }
assert_eq(_w2W6_enough, 1, "the DAGs compared: all but a few of 600 (a plain walk past 2^20 is skipped)");
assert_eq(_w2W6_fe, 0, "_sym_eval_memo gives _sym_eval's bits and flags on every DAG");
assert_eq(_w2W6_fs, 0, "_sym_simp_memo and _sym_simp_deep give _sym_simp_rec's tree on every DAG");
assert_eq(_w2W6_fd, 0, "_sym_diff_memo and _sym_diff_deep give _sym_diff_rec's tree on every DAG");
# x doubled 30 times: 2^31 visits for a plain walk, 31 operators held; a hit is what ends it.
var _w2W6_dd = expr_var(_w2W6_X);
for (var _w2W6_k = 0; _w2W6_k < 30; _w2W6_k = _w2W6_k + 1) { _w2W6_dd = expr_add(_w2W6_dd, _w2W6_dd); }
store64(&_w2W6_bad, 0);
assert_eq(_sym_eval_memo(_w2W6_dd, _w2W6_vars, &_w2W6_bad), 0x41C3333333333333, "x doubled 30 at 0.6: 0.6 * 2^30");
assert_eq(load64(&_w2W6_bad), 0, "... no flag");
var _w2W6_ds = _sym_simp_memo(_w2W6_dd);
store64(&_w2W6_bad, 0);
assert_eq(_sym_eval_memo(_w2W6_ds, _w2W6_vars, &_w2W6_bad), 0x41C3333333333333,
  "its simplification evaluates the same");
var _w2W6_dg = _sym_diff_memo(_w2W6_dd, _w2W6_X);
store64(&_w2W6_bad, 0);
assert_eq(_sym_eval_memo(_w2W6_dg, _w2W6_vars, &_w2W6_bad), 0x41D0000000000000, "its derivative evaluates to 2^30");
# A variable with no binding: bit 0 and 0, as the plain walk answers.
var _w2W6_vx = vec_new();
vec_push(_w2W6_vx, expr_bind(_w2W6_X, F64_ONE));
store64(&_w2W6_bad, 0);
assert_eq(_sym_eval_memo(expr_add(expr_var(_w2W6_X), expr_var(_w2W6_Y)), _w2W6_vx, &_w2W6_bad), 0, "unbound y: 0");
assert_eq(load64(&_w2W6_bad), 1, "... and bit 0 of the flag");
# --(f) with f shared and past _SYM_KEEP operators: the memo walk's negation of a negation keeps it.
_w2W6_pool = vec_new();
var _w2W6_f = _w2W6_chain(80);
var _w2W6_g = expr_neg(expr_neg(_w2W6_f));
var _w2W6_nn = expr_add(_w2W6_g, expr_pow(_w2W6_f, _w2W6_g));
store64(&_w2W6_bad, 0);
assert_eq(_w2W6_seq(_sym_simp_rec(_w2W6_nn, 0, &_w2W6_bad), _sym_simp_memo(_w2W6_nn)), 1,
  "--f with f shared: the same tree");
# The public path past _SYM_SHARE_WALK: 350,000 terms 2 sin(x), 1,049,999 operators, nothing shared.
# [measured: tests/modules_d.tcyr, the three assertions below]
var _w2W6_big = expr_mul(expr_const(F64_TWO), expr_sin(expr_var(_w2W6_X)));
for (var _w2W6_q = 1; _w2W6_q < 350000; _w2W6_q = _w2W6_q + 1) {
    _w2W6_big = expr_add(_w2W6_big, expr_mul(expr_const(F64_TWO), expr_sin(expr_var(_w2W6_X))));
}
store64(&_w2W6_bad, 0);
store64(&_w2W6_bad + 8, 0 - 4000000);
var _w2W6_bv = _sym_eval(_w2W6_big, _w2W6_vars, &_w2W6_bad, 0);
assert_eq(load64(&_w2W6_bad), 0, "the plain walk, its count started below 0 so that it finishes: no flag");
var _w2W6_bt, _w2W6_bw = expr_eval_checked(_w2W6_big, _w2W6_vars);
assert_eq(_w2W6_bt, 0, "expr_eval_checked past 2^20 operators: Ok");
assert_eq(_w2W6_bw, _w2W6_bv, "... the plain walk's bits, through the memo walk");

# ==================================================================================================
# 3.5.0 wave 2 — sectional_curvature's three tiers, se3_log, cx_ln's band (diffgeo, lie_ext, complex)
# ==================================================================================================
# (Written as tests/w2_W7.tcyr; every global and fn below is prefixed _w2W7_.)

# ==================================================================================================
# 3.5.0 W7 -- sectional_curvature: within 2^-46 whatever cancels (RV-LIE N11, LIE F3)
# ==================================================================================================
# Two families built in the harness from a closed form, on the Lorentzian g = diag(-1, 1, 1):
#  - the space form R^r_smn = kappa (d^r_m g_sn - d^r_n g_sm), every entry +-kappa or 0, so num =
#    kappa den exactly and K = kappa for every plane: kappa = 0x3FE6CB1A7B9F1D3B (0.71229...).
#  - the Gauss form R^r_smn = e_r (h_rm h_sn - h_rn h_sm), e = (-1, 1, 1), each entry rounded, h a
#    symmetric 3x3 with full mantissas; K's oracle is Fractions on those rounded entries.
# u = (1, 1, 0) is null and v = (0.3, 0.3 + 2^-e, 1): den is -g(u, v)^2 in exact arithmetic, a
# cancellation of 2^-2e of its terms in the bivector form, which sends the plain path to the
# double-double tier (e = 1 .. 22 here) and then to the exact one.
var _w2W7_g3 = alloc(72);
var _w2W7_rk = alloc(648);
var _w2W7_rh = alloc(648);
var _w2W7_h = alloc(72);
var _w2W7_KAPPA = 0x3FE6CB1A7B9F1D3B;   # the space form's curvature, bits
fn _w2W7_vec3(x, y, z) {
    var p = alloc(24);
    store64(p, x); store64(p + 8, y); store64(p + 16, z);
    return p;
}
fn _w2W7_build() {
    for (var i = 0; i < 9; i = i + 1) { store64(_w2W7_g3 + i * 8, 0); }
    store64(_w2W7_g3, 0xBFF0000000000000);   # -1
    store64(_w2W7_g3 + 32, F64_ONE);
    store64(_w2W7_g3 + 64, F64_ONE);
    # h, symmetric: h00 h01 h02 / h11 h12 / h22
    var hv = alloc(48);
    store64(hv, 0x3FE3C6EF372FE950); store64(hv + 8, 0xBFD5555555555555); store64(hv + 16, 0x3FC999999999999A);
    store64(hv + 24, 0x3FF6A09E667F3BCD); store64(hv + 32, 0xBFE0000000000001); store64(hv + 40, 0x3FF2F7A3C1B4E5D7);
    store64(_w2W7_h, load64(hv)); store64(_w2W7_h + 8, load64(hv + 8)); store64(_w2W7_h + 16, load64(hv + 16));
    store64(_w2W7_h + 24, load64(hv + 8)); store64(_w2W7_h + 32, load64(hv + 24));
    store64(_w2W7_h + 40, load64(hv + 32)); store64(_w2W7_h + 48, load64(hv + 16));
    store64(_w2W7_h + 56, load64(hv + 32)); store64(_w2W7_h + 64, load64(hv + 40));
    for (var r = 0; r < 3; r = r + 1) {
        for (var s = 0; s < 3; s = s + 1) {
            for (var m = 0; m < 3; m = m + 1) {
                for (var n = 0; n < 3; n = n + 1) {
                    var val = 0;
                    if (r == m) { val = f64_add(val, f64_mul(_w2W7_KAPPA, load64(_w2W7_g3 + (s * 3 + n) * 8))); }
                    if (r == n) { val = f64_sub(val, f64_mul(_w2W7_KAPPA, load64(_w2W7_g3 + (s * 3 + m) * 8))); }
                    store64(_w2W7_rk + (((r * 3 + s) * 3 + m) * 3 + n) * 8, val);
                    var gv = f64_sub(f64_mul(load64(_w2W7_h + (r * 3 + m) * 8), load64(_w2W7_h + (s * 3 + n) * 8)),
                      f64_mul(load64(_w2W7_h + (r * 3 + n) * 8), load64(_w2W7_h + (s * 3 + m) * 8)));
                    if (r == 0) { gv = f64_neg(gv); }
                    store64(_w2W7_rh + (((r * 3 + s) * 3 + m) * 3 + n) * 8, gv);
                }
            }
        }
    }
    return 0;
}
_w2W7_build();
var _w2W7_un = _w2W7_vec3(F64_ONE, F64_ONE, 0);
fn _w2W7_v(e) {
    # (0.3, 0.3 + 2^-e, 1), the sum rounded as the oracle rounded it
    return _w2W7_vec3(0x3FD3333333333333, f64_add(0x3FD3333333333333, (1023 - e) << 52), F64_ONE);
}

test_group("3.5.0 W7: sectional_curvature's three tiers");
# _dg_sect's tier for a fixture (white-box: the suites see the module's internals): 1 the plain
# path, its certificate met; 2 the double-double; 3 the exact; 0 a non-finite operand.
fn _w2W7_tier(rk, g, u, v, d) {
    var k: i64[1];
    return _dg_sect(rk, g, u, v, d, &k);
}
# The plain path, certified: a spacelike plane of the Gauss form, 1.785 u (u = 2^-53) from the
# oracle's 3FF872301D6F6F12, its 3.4.1 bits.
assert_eq(sectional_curvature(_w2W7_rh, _w2W7_g3, _w2W7_vec3(0, F64_ONE, 0x3FD0000000000000),
    _w2W7_vec3(0x3FC0000000000000, F64_HALF, F64_ONE), 3), 0x3FF872301D6F6F11,
  "Gauss form, spacelike plane: the plain path's bits (oracle ...12, 1.79 u)");
assert_eq(_w2W7_tier(_w2W7_rh, _w2W7_g3, _w2W7_vec3(0, F64_ONE, 0x3FD0000000000000),
    _w2W7_vec3(0x3FC0000000000000, F64_HALF, F64_ONE), 3), 1, "  ... from the plain path");
# The double-double tier: the plain path is off by 1, 59 ulps and 2^28 ulps at e = 1, 4, 16, and
# is not certified; the tier gives kappa, the oracle's, bit for bit.
assert_eq(sectional_curvature(_w2W7_rk, _w2W7_g3, _w2W7_un, _w2W7_v(1), 3), _w2W7_KAPPA,
  "space form, near-null plane e = 1: kappa (3.4.2: ...1D3C)");
assert_eq(_w2W7_tier(_w2W7_rk, _w2W7_g3, _w2W7_un, _w2W7_v(1), 3), 2, "  ... from the double-double tier");
assert_eq(sectional_curvature(_w2W7_rk, _w2W7_g3, _w2W7_un, _w2W7_v(4), 3), _w2W7_KAPPA,
  "space form, e = 4: kappa (3.4.2: ...1D00)");
assert_eq(sectional_curvature(_w2W7_rk, _w2W7_g3, _w2W7_un, _w2W7_v(16), 3), _w2W7_KAPPA,
  "space form, e = 16: kappa (3.4.2: 3FE6CB1A00000000)");
assert_eq(_w2W7_tier(_w2W7_rk, _w2W7_g3, _w2W7_un, _w2W7_v(16), 3), 2, "  ... from the double-double tier");
assert_eq(sectional_curvature(_w2W7_rh, _w2W7_g3, _w2W7_un, _w2W7_v(1), 3), 0xC015C6D5F2C5768B,
  "Gauss form, e = 1: the oracle's C015C6D5F2C5768B, 0.51 u (3.4.2: ...768D)");
assert_eq(sectional_curvature(_w2W7_rh, _w2W7_g3, _w2W7_un, _w2W7_v(16), 3), 0xC1F876157AE08D75,
  "Gauss form, e = 16: the oracle's C1F876157AE08D75 (3.4.2: ...8D76)");
assert_eq(_w2W7_tier(_w2W7_rh, _w2W7_g3, _w2W7_un, _w2W7_v(16), 3), 2, "  ... from the double-double tier");
# The exact tier: past the double-double bound. 3.4.2 gave 0.75 at e = 25, 0.5 at e = 26 and +0,
# "flat", from e = 27: its den rounds to 0 there, and the plane is not null.
assert_eq(sectional_curvature(_w2W7_rk, _w2W7_g3, _w2W7_un, _w2W7_v(25), 3), _w2W7_KAPPA,
  "space form, e = 25: kappa (3.4.2: 0.75)");
assert_eq(_w2W7_tier(_w2W7_rk, _w2W7_g3, _w2W7_un, _w2W7_v(25), 3), 3, "  ... from the exact tier");
assert_eq(sectional_curvature(_w2W7_rk, _w2W7_g3, _w2W7_un, _w2W7_v(40), 3), _w2W7_KAPPA,
  "space form, e = 40: kappa (3.4.2: +0, flat)");
assert_eq(sectional_curvature(_w2W7_rh, _w2W7_g3, _w2W7_un, _w2W7_v(40), 3), 0xC4F87620F3E09A2F,
  "Gauss form, e = 40: the oracle's C4F87620F3E09A2F, correctly rounded (3.4.2: +0, flat)");
# e = 58: 0.3 + 2^-58 rounds to 0.3, g(u, v) = 0 exactly, the plane is null: NaN, decided exactly.
assert_eq(sectional_curvature(_w2W7_rk, _w2W7_g3, _w2W7_un, _w2W7_v(58), 3), 0x7FF8000000000000,
  "space form, e = 58: v1 = 0.3, a null plane: NaN");
# A flat R (all zero): num = 0 exactly, K is 0 signed as +0 / den is. A spacelike plane takes the
# plain path (+0); a near-null one has den < 0 and goes to the exact tier: -0.
var _w2W7_r0 = alloc(648);
for (var _w2W7_i = 0; _w2W7_i < 81; _w2W7_i = _w2W7_i + 1) { store64(_w2W7_r0 + _w2W7_i * 8, 0); }
assert_eq(sectional_curvature(_w2W7_r0, _w2W7_g3, _w2W7_vec3(0, F64_ONE, 0), _w2W7_vec3(0, 0, F64_ONE), 3), 0,
  "flat, spacelike plane: +0");
assert_eq(sectional_curvature(_w2W7_r0, _w2W7_g3, _w2W7_un, _w2W7_v(30), 3), 0x8000000000000000,
  "flat, near-null plane with den < 0: -0, +0 / den (3.4.2: +0)");
# An operand below 2^-200 of its tensor's largest (lo): g = diag(1, 2^-100), R^0_000 = 1 and
# R^1_001 = 2^-1000, u = e0, v = e1. The only nonzero term of num is g_11 R^1_001 = 2^-1100, which
# the plain path's product flushes to 0 (and its absolute contraction with it): K = -2^-1002
# exactly, where 3.4.2 and a certificate without the underflow allowance answer +0.
var _w2W7_g2 = alloc(32);
store64(_w2W7_g2, F64_ONE); store64(_w2W7_g2 + 8, 0); store64(_w2W7_g2 + 16, 0);
store64(_w2W7_g2 + 24, 0x39B0000000000000);   # 2^-100
var _w2W7_r2 = alloc(128);
for (var _w2W7_j = 0; _w2W7_j < 16; _w2W7_j = _w2W7_j + 1) { store64(_w2W7_r2 + _w2W7_j * 8, 0); }
store64(_w2W7_r2, F64_ONE);                          # R^0_000
store64(_w2W7_r2 + 9 * 8, 0x0170000000000000);       # R^1_001 = 2^-1000
var _w2W7_e0 = alloc(16);
var _w2W7_e1 = alloc(16);
store64(_w2W7_e0, F64_ONE); store64(_w2W7_e0 + 8, 0);
store64(_w2W7_e1, 0); store64(_w2W7_e1 + 8, F64_ONE);
assert_eq(sectional_curvature(_w2W7_r2, _w2W7_g2, _w2W7_e0, _w2W7_e1, 2), 0x8150000000000000,
  "an underflowing product: K = -2^-1002 exactly (3.4.2: +0)");
# Four Gauss forms on a full-mantissa diagonal g, R^r_smn = (1 / g_rr) (h_rm h_sn - h_rn h_sm) with
# each step rounded, where every two-product's low part and the double-double quotient's residual
# matter (found by search against the tiers with each part removed): A, C and D take the
# double-double tier, B the exact one. Oracle values are Fractions on the rounded R, correctly
# rounded; the tiers give them bit for bit (A 0.44 u, B 0.26, C 0.42, D 0.49).
var _w2W7_gd = alloc(24);
var _w2W7_hv = alloc(48);
var _w2W7_gx = alloc(72);
var _w2W7_rx = alloc(648);
fn _w2W7_gauss(g0, g1, g2, h0, h1, h2, h3, h4, h5) {
    store64(_w2W7_gd, g0); store64(_w2W7_gd + 8, g1); store64(_w2W7_gd + 16, g2);
    var hm = alloc(72);
    store64(hm, h0); store64(hm + 8, h1); store64(hm + 16, h2);
    store64(hm + 24, h1); store64(hm + 32, h3); store64(hm + 40, h4);
    store64(hm + 48, h2); store64(hm + 56, h4); store64(hm + 64, h5);
    for (var i = 0; i < 9; i = i + 1) { store64(_w2W7_gx + i * 8, 0); }
    for (var k = 0; k < 3; k = k + 1) { store64(_w2W7_gx + (k * 3 + k) * 8, load64(_w2W7_gd + k * 8)); }
    for (var r = 0; r < 3; r = r + 1) {
        var gi = f64_div(F64_ONE, load64(_w2W7_gd + r * 8));
        for (var s = 0; s < 3; s = s + 1) {
            for (var m = 0; m < 3; m = m + 1) {
                for (var n = 0; n < 3; n = n + 1) {
                    var w = f64_sub(f64_mul(load64(hm + (r * 3 + m) * 8), load64(hm + (s * 3 + n) * 8)),
                      f64_mul(load64(hm + (r * 3 + n) * 8), load64(hm + (s * 3 + m) * 8)));
                    store64(_w2W7_rx + (((r * 3 + s) * 3 + m) * 3 + n) * 8, f64_mul(gi, w));
                }
            }
        }
    }
    return 0;
}
_w2W7_gauss(0xBFE673115D6A4C12, 0x3FFC56A2046823BA, 0x3FFA54A19A30774E, 0xBFDF59E5EE1D0148, 0xBF82B2A87A632180,
  0xBFB9DC4EA1C6BBF0, 0x3FD367660612E768, 0x3FE27A7181ADFCC8, 0xBFE9FE345C18DE9C);
assert_eq(sectional_curvature(_w2W7_rx, _w2W7_gx, _w2W7_vec3(F64_ONE, 0x3FE423BB8DB9336E, 0),
    _w2W7_vec3(0xBFEE2F8E10DA7C9A, 0xBFE2FF6DFE5A2272, F64_ONE), 3), 0xC2A5636EFED7C5BC,
  "Gauss form A (double-double): the oracle's C2A5636EFED7C5BC (3.4.2: C2A571E4FBF79B19)");
assert_eq(_w2W7_tier(_w2W7_rx, _w2W7_gx, _w2W7_vec3(F64_ONE, 0x3FE423BB8DB9336E, 0),
    _w2W7_vec3(0xBFEE2F8E10DA7C9A, 0xBFE2FF6DFE5A2272, F64_ONE), 3), 2, "  ... from the double-double tier");
# A with R^r_smn no longer exactly -R^r_snm (three entries moved by 3072, 3 and -1 in their last
# bits): the double-double tier's pairs then have a nonzero rl (Rh_mn - Rh_nm = rh + rl), which its
# product must carry. The oracle's C2A5636EFED7C645; without rl, ...C646.
store64(_w2W7_rx + 65 * 8, load64(_w2W7_rx + 65 * 8) + 3072);
store64(_w2W7_rx + 55 * 8, load64(_w2W7_rx + 55 * 8) + 3);
store64(_w2W7_rx + 60 * 8, load64(_w2W7_rx + 60 * 8) - 1);
assert_eq(sectional_curvature(_w2W7_rx, _w2W7_gx, _w2W7_vec3(F64_ONE, 0x3FE423BB8DB9336E, 0),
    _w2W7_vec3(0xBFEE2F8E10DA7C9A, 0xBFE2FF6DFE5A2272, F64_ONE), 3), 0xC2A5636EFED7C645,
  "A, R not antisymmetric in (m, n): the oracle's C2A5636EFED7C645");
assert_eq(_w2W7_tier(_w2W7_rx, _w2W7_gx, _w2W7_vec3(F64_ONE, 0x3FE423BB8DB9336E, 0),
    _w2W7_vec3(0xBFEE2F8E10DA7C9A, 0xBFE2FF6DFE5A2272, F64_ONE), 3), 2, "  ... from the double-double tier");
_w2W7_gauss(0xBFEAA425AE950B73, 0x3FF28261A1D147BF, 0x3FF3E64539A8989E, 0xBFE11524F53C016C, 0xBFE1397B8A95D070,
  0xBFE1FF7DD1E9943C, 0xBFB4AEDAC30E6D50, 0xBFDAE86FA12D0764, 0xBFEE9FE9A4ABA9DC);
assert_eq(sectional_curvature(_w2W7_rx, _w2W7_gx, _w2W7_vec3(F64_ONE, 0x3FEB258D54A6B9BF, 0),
    _w2W7_vec3(0x3FE59AE0A7548546, 0x3FE254080CF1DE94, F64_ONE), 3), 0x433F991E2CA45703,
  "Gauss form B (exact; the double-double num certifies, its den does not): 433F991E2CA45703 (3.4.2: +0, flat)");
assert_eq(_w2W7_tier(_w2W7_rx, _w2W7_gx, _w2W7_vec3(F64_ONE, 0x3FEB258D54A6B9BF, 0),
    _w2W7_vec3(0x3FE59AE0A7548546, 0x3FE254080CF1DE94, F64_ONE), 3), 3, "  ... from the exact tier");
_w2W7_gauss(0x3FE4CCCDA71D8D51, 0x3FF71ABE86FA45F9, 0x3FF95E09BF94705E, 0xBFDA0FE12E10D5B4, 0x3FDF1F6E0552B82C,
  0x3FE9511B75C5999C, 0x3FEE49C3D5B0854E, 0x3F5A345EFBA91C00, 0x3FEDE6C5EB6079A2);
assert_eq(sectional_curvature(_w2W7_rx, _w2W7_gx,
    _w2W7_vec3(0x3F8F9C1FA8FA7000, 0x3FEA4078D55CC92A, 0xBFE3D9808592B388),
    _w2W7_vec3(0xBFDBA0AA76994518, 0x3FEE4D071F0F5126, 0xBF54E77275F9B400), 3), 0xBFCF612521C88172,
  "Gauss form C, a definite g (num cancels, den does not): BFCF612521C88172 (3.4.2: ...8171)");
assert_eq(_w2W7_tier(_w2W7_rx, _w2W7_gx, _w2W7_vec3(0x3F8F9C1FA8FA7000, 0x3FEA4078D55CC92A, 0xBFE3D9808592B388),
    _w2W7_vec3(0xBFDBA0AA76994518, 0x3FEE4D071F0F5126, 0xBF54E77275F9B400), 3), 2, "  ... from the double-double tier");
_w2W7_gauss(0xBFFE94F8F0840ED7, 0x3FF170C3C0C45A8E, 0x3FFC7A99E61A840E, 0xBFA43F6160EDE5A0, 0x3FDF3290ECC22AF4,
  0xBFC8809352BDF098, 0x3FD51650D2C4A368, 0xBFD1021617381ECC, 0x3FE87EAE759FD3D4);
assert_eq(sectional_curvature(_w2W7_rx, _w2W7_gx, _w2W7_vec3(F64_ONE, 0x3FF52FEAC772AF30, 0),
    _w2W7_vec3(0x3FE1A752F56558D2, 0x3FE759DD9CC9A539, F64_ONE), 3), 0xC128CF6AEDE97284,
  "Gauss form D (double-double; its quotient's residual counts): C128CF6AEDE97284 (3.4.2: ...E3EF45)");
assert_eq(_w2W7_tier(_w2W7_rx, _w2W7_gx, _w2W7_vec3(F64_ONE, 0x3FF52FEAC772AF30, 0),
    _w2W7_vec3(0x3FE1A752F56558D2, 0x3FE759DD9CC9A539, F64_ONE), 3), 2, "  ... from the double-double tier");
# E: an indefinite g whose den certificate is within a factor 2 of passing on the plain path (its
# den off by 6 ulps there): the double-double tier, the oracle's C01880DE3BE0A96C (3.4.2: ...A972).
# G: a definite g with u on h's null cone and v nearly h-orthogonal to it, so num cancels by about
# 2^55 and only the exact tier certifies: K = -2.9e-17, the oracle's BC80F32758EA65FA, where 3.4.2
# gave BC6B106C6206F568 (-2.4e-18, a factor 12 off).
_w2W7_gauss(0xBFF337AD18BB90D1, 0x3FEB0557E5588EFC, 0x3FEB44F5FFE3B636, 0x3FDBDD364C6FF468, 0x3FD671E5411BB4E0,
  0x3FED5B94E1BD2D70, 0x3FE6A5FEA2088B8C, 0xBFE0819160E0ED54, 0xBFE3DD36C9CB28EA);
assert_eq(sectional_curvature(_w2W7_rx, _w2W7_gx,
    _w2W7_vec3(0xBFDEE570CDCCE208, 0xBFE405261306550E, 0x3FDA34BBEACD62C4),
    _w2W7_vec3(0x3FE6F33AD04B4894, 0x3FE995AAF7785FD2, 0xBFFDC94FA09C1C20), 3), 0xC01880DE3BE0A96C,
  "Gauss form E (den's certificate within 2x): C01880DE3BE0A96C (3.4.2: ...A972)");
assert_eq(_w2W7_tier(_w2W7_rx, _w2W7_gx, _w2W7_vec3(0xBFDEE570CDCCE208, 0xBFE405261306550E, 0x3FDA34BBEACD62C4),
    _w2W7_vec3(0x3FE6F33AD04B4894, 0x3FE995AAF7785FD2, 0xBFFDC94FA09C1C20), 3), 2, "  ... from the double-double tier");
_w2W7_gauss(0x3FE2A72A5A6C37F0, 0x3FE8189ECB92BDD3, 0x3FF83E6D01E96F6C, 0xBFE66C4A1B25DA2A, 0xBFED6204FBA15226,
  0xBF931CDB6AD67640, 0xBFE00F6C4D6DB490, 0x3FEFD946E048DAFE, 0xBFE82CACC95239EE);
assert_eq(sectional_curvature(_w2W7_rx, _w2W7_gx,
    _w2W7_vec3(0x3FADF181A57DFD60, 0x3FE185CF67F9A9B8, 0x3FCDB18EBC393C01),
    _w2W7_vec3(0xBFC736B94B25FE40, 0x3FEF35C7519A22A8, 0xBF873254BE3BB7A7), 3), 0xBC80F32758EA65FA,
  "Gauss form G (num cancels by 2^55): BC80F32758EA65FA (3.4.2: BC6B106C6206F568)");
assert_eq(_w2W7_tier(_w2W7_rx, _w2W7_gx, _w2W7_vec3(0x3FADF181A57DFD60, 0x3FE185CF67F9A9B8, 0x3FCDB18EBC393C01),
    _w2W7_vec3(0xBFC736B94B25FE40, 0x3FEF35C7519A22A8, 0xBF873254BE3BB7A7), 3), 3, "  ... from the exact tier");
# Two more underflowing products, each flagged by one operand alone. g = diag(1, 2^-1000) with
# R^1_001 = 2^-100: num's one term g_11 R^1_001 = 2^-1100 flushes, K = -2^-102 exactly. And u = (2^-600,
# 0, 1), v = (0, 2^-600, 1), whose B^{01} = 2^-1200 flushes in u ∧ v, with R^0_101 = -R^0_110 = 2^1000
# on g = I: num sees only B^{01}, K = 2^-202 (to 2^-1201). 3.4.2 answers +0 for both.
store64(_w2W7_g2 + 24, 0x0170000000000000);   # 2^-1000
store64(_w2W7_r2 + 9 * 8, 0x39B0000000000000);   # R^1_001 = 2^-100
assert_eq(sectional_curvature(_w2W7_r2, _w2W7_g2, _w2W7_e0, _w2W7_e1, 2), 0xB990000000000000,
  "g = diag(1, 2^-1000): K = -2^-102 (3.4.2: +0)");
var _w2W7_i3 = alloc(72);
var _w2W7_r3 = alloc(648);
for (var _w2W7_k = 0; _w2W7_k < 81; _w2W7_k = _w2W7_k + 1) { store64(_w2W7_r3 + _w2W7_k * 8, 0); }
for (var _w2W7_k2 = 0; _w2W7_k2 < 9; _w2W7_k2 = _w2W7_k2 + 1) { store64(_w2W7_i3 + _w2W7_k2 * 8, 0); }
store64(_w2W7_i3, F64_ONE); store64(_w2W7_i3 + 32, F64_ONE); store64(_w2W7_i3 + 64, F64_ONE);
store64(_w2W7_r3 + 10 * 8, 0x7E70000000000000);   # R^0_101 = 2^1000
store64(_w2W7_r3 + 12 * 8, 0xFE70000000000000);   # R^0_110 = -2^1000
assert_eq(sectional_curvature(_w2W7_r3, _w2W7_i3, _w2W7_vec3(0x1A70000000000000, 0, F64_ONE),
    _w2W7_vec3(0, 0x1A70000000000000, F64_ONE), 3), 0x3350000000000000,
  "u, v with 2^-600 parts: K = 2^-202 (3.4.2: +0)");
# _dg_det2's second output, |pe - qe| as rounded (the certificate's eB, what a cancelling u ∧ v can
# leave in B): 3 * 0.1 - 7 * (1/3), whose low parts are -2^-55 and 1.5 2^-53.
var _w2W7_o = alloc(8);
assert_eq(_dg_det2(0x4008000000000000, 0x3FB999999999999A, 0x401C000000000000, 0x3FD5555555555555, _w2W7_o),
  0xC000444444444444, "_dg_det2(3, 0.1, 7, 1/3): -2.0333...");
assert_eq(load64(_w2W7_o), 0x3CAC000000000000, "_dg_det2's |pe - qe| = 1.75 2^-53");
# And one flagged by u ∧ v alone: u = (s, s, 1, 0), v = (s, s (1 + 2^-52), 0, 1) with s = 2^-199 (no
# operand below 2^-200 of its tensor's largest), whose B^{01} = 2^-450 is exact with no low part (so
# no eB either); g = diag(s, s, 1, 1) and R^0_101 = -R^0_110 = 2^1000. num is B^{01}^2 g_00 R^0_101,
# 2^-1099 in the scaled units, which the plain path flushes: K = 2^-100 exactly (3.4.2: +0).
var _w2W7_g4 = alloc(128);
var _w2W7_r4 = alloc(2048);
for (var _w2W7_q = 0; _w2W7_q < 256; _w2W7_q = _w2W7_q + 1) { store64(_w2W7_r4 + _w2W7_q * 8, 0); }
for (var _w2W7_q2 = 0; _w2W7_q2 < 16; _w2W7_q2 = _w2W7_q2 + 1) { store64(_w2W7_g4 + _w2W7_q2 * 8, 0); }
store64(_w2W7_g4, 0x3380000000000000); store64(_w2W7_g4 + 40, 0x3380000000000000);   # 2^-199
store64(_w2W7_g4 + 80, F64_ONE); store64(_w2W7_g4 + 120, F64_ONE);
store64(_w2W7_r4 + 17 * 8, 0x7E70000000000000);   # R^0_101 = 2^1000
store64(_w2W7_r4 + 20 * 8, 0xFE70000000000000);   # R^0_110 = -2^1000
var _w2W7_u4 = alloc(32);
var _w2W7_v4 = alloc(32);
store64(_w2W7_u4, 0x3380000000000000); store64(_w2W7_u4 + 8, 0x3380000000000000);
store64(_w2W7_u4 + 16, F64_ONE); store64(_w2W7_u4 + 24, 0);
store64(_w2W7_v4, 0x3380000000000000); store64(_w2W7_v4 + 8, 0x3380000000000001);
store64(_w2W7_v4 + 16, 0); store64(_w2W7_v4 + 24, F64_ONE);
assert_eq(sectional_curvature(_w2W7_r4, _w2W7_g4, _w2W7_u4, _w2W7_v4, 4), 0x39B0000000000000,
  "a B^{01} of 2^-450 beside B^{23} = 1: K = 2^-100 (3.4.2: +0)");
# And by u alone, then v alone: u = (2^-900, 0, 1), v = (1, 2^-190, 0) on g = diag(1, 1, 2^-199) with the
# same R. B^{01} = u^0 v^1 = 2^-1090 flushes to 0 in u ∧ v itself, so nothing tiny is left in B to flag;
# the other entries are -1 and -2^-190. K = 2^-982 exactly (3.4.2: +0); the same with u and v swapped.
var _w2W7_g5 = alloc(72);
for (var _w2W7_q3 = 0; _w2W7_q3 < 9; _w2W7_q3 = _w2W7_q3 + 1) { store64(_w2W7_g5 + _w2W7_q3 * 8, 0); }
store64(_w2W7_g5, F64_ONE); store64(_w2W7_g5 + 32, F64_ONE); store64(_w2W7_g5 + 64, 0x3380000000000000);
assert_eq(sectional_curvature(_w2W7_r3, _w2W7_g5, _w2W7_vec3(0x07B0000000000000, 0, F64_ONE),
    _w2W7_vec3(F64_ONE, 0x3410000000000000, 0), 3), 0x0290000000000000, "u with a 2^-900 part: K = 2^-982 (3.4.2: +0)");
assert_eq(sectional_curvature(_w2W7_r3, _w2W7_g5, _w2W7_vec3(F64_ONE, 0x3410000000000000, 0),
    _w2W7_vec3(0x07B0000000000000, 0, F64_ONE), 3), 0x0290000000000000, "v with a 2^-900 part: K = 2^-982 (3.4.2: +0)");
# ---- second pass: the certificate's depths, B's underflow allowance, the quotient's range ----
# The plain certificate counts only nonzero terms (a zero adds exactly): g = I, u = e0, v = e1, so B
# is B^{01} = 1 alone (cN = 1, cL = 1); R^0_{101} = -R^0_{110} = 1, R^1_{001} = -R^1_{010} = beta,
# and four entries of (0, 1)'s slice that meet B's zeros, so cT = min(6, 2 cN) = 2. num = 2 - 2 beta,
# NA = 2 + 2 beta, and the test is (2 + 1 + 1 + 1 + 5) u (1 + 2^-8) NA <= 63 u |num|: beta = 0.71
# meets it with 10 and would not with 11; beta = 0.73 fails it with 10 and would meet it with 9.
# K = (1 - beta) / 2, the oracle's, from either tier.
var _w2W7_rb = alloc(648);
fn _w2W7_beta(beta) {
    for (var i = 0; i < 81; i = i + 1) { store64(_w2W7_rb + i * 8, 0); }
    store64(_w2W7_rb + 10 * 8, F64_ONE); store64(_w2W7_rb + 12 * 8, f64_neg(F64_ONE));   # R^0_101, R^0_110
    store64(_w2W7_rb + 11 * 8, F64_HALF); store64(_w2W7_rb + 15 * 8, f64_neg(F64_HALF));   # R^0_102, R^0_120
    store64(_w2W7_rb + 14 * 8, 0x3FD0000000000000); store64(_w2W7_rb + 16 * 8, 0xBFD0000000000000);   # R^0_112, R^0_121
    store64(_w2W7_rb + 28 * 8, beta); store64(_w2W7_rb + 30 * 8, f64_neg(beta));   # R^1_001, R^1_010
    return 0;
}
var _w2W7_x0 = _w2W7_vec3(F64_ONE, 0, 0);
var _w2W7_x1 = _w2W7_vec3(0, F64_ONE, 0);
_w2W7_beta(0x3FE6B851EB851EB8);   # 0.71
assert_eq(sectional_curvature(_w2W7_rb, _w2W7_i3, _w2W7_x0, _w2W7_x1, 3), 0x3FC28F5C28F5C290, "beta = 0.71: K = 0.145");
assert_eq(_w2W7_tier(_w2W7_rb, _w2W7_i3, _w2W7_x0, _w2W7_x1, 3), 1, "  ... certified on the plain path, depth 10");
_w2W7_beta(0x3FE75C28F5C28F5C);   # 0.73
assert_eq(sectional_curvature(_w2W7_rb, _w2W7_i3, _w2W7_x0, _w2W7_x1, 3), 0x3FC147AE147AE148, "beta = 0.73: K = 0.135");
assert_eq(_w2W7_tier(_w2W7_rb, _w2W7_i3, _w2W7_x0, _w2W7_x1, 3), 2,
  "  ... not certified at depth 10: the double-double");
# den's: g = diag(-1, 1, 1), u = (0, 1, 0), v = (x, 0, 1), B^{01} = -x and B^{12} = 1 (cN = 2), and
# R^1_{212} = -R^1_{221} = 1, so num = 2 = NA and den = 2 - 2 x^2 over DA = 2 + 2 x^2; the test is (2
# cL + 1 + cN + 5) = 10. x = 0.8439 meets it and would not with 11; x = 0.8584 fails it and would
# meet it with 9. K = 1 / (2 (1 - x^2)): the oracle's 3FFBCB3DFDA47ED2 is 1.4 u from the plain ...ED1.
var _w2W7_rd = alloc(648);
for (var _w2W7_q4 = 0; _w2W7_q4 < 81; _w2W7_q4 = _w2W7_q4 + 1) { store64(_w2W7_rd + _w2W7_q4 * 8, 0); }
store64(_w2W7_rd + 50 * 8, F64_ONE); store64(_w2W7_rd + 52 * 8, f64_neg(F64_ONE));   # R^1_212, R^1_221
var _w2W7_vd1 = _w2W7_vec3(0x3FEB013A92A30553, 0, F64_ONE);   # x = 0.8439
var _w2W7_vd2 = _w2W7_vec3(0x3FEB780346DC5D64, 0, F64_ONE);   # x = 0.8584
assert_eq(sectional_curvature(_w2W7_rd, _w2W7_g3, _w2W7_x1, _w2W7_vd1, 3), 0x3FFBCB3DFDA47ED1, "x = 0.8439: K = 1.74");
assert_eq(_w2W7_tier(_w2W7_rd, _w2W7_g3, _w2W7_x1, _w2W7_vd1, 3), 1, "  ... den certified on the plain path, depth 10");
assert_eq(sectional_curvature(_w2W7_rd, _w2W7_g3, _w2W7_x1, _w2W7_vd2, 3), 0x3FFE66A66915F064, "x = 0.8584: K = 1.90");
assert_eq(_w2W7_tier(_w2W7_rd, _w2W7_g3, _w2W7_x1, _w2W7_vd2, 3), 2, "  ... den not certified at depth 10");
# The unit sphere at dim 8 on the plane (e0, e1): exact everywhere, so the plain path's K = 1 is
# certified (a bound counting every term, depth d (d - 1) + d + 1 + p + 5 = 98, could never be met
# past dim 6, and sent it to the double-double tier).
var _w2W7_s8 = alloc(32768);
var _w2W7_i8 = alloc(512);
for (var _w2W7_q5 = 0; _w2W7_q5 < 64; _w2W7_q5 = _w2W7_q5 + 1) { store64(_w2W7_i8 + _w2W7_q5 * 8, 0); }
for (var _w2W7_q6 = 0; _w2W7_q6 < 8; _w2W7_q6 = _w2W7_q6 + 1) { store64(_w2W7_i8 + _w2W7_q6 * 72, F64_ONE); }
for (var _w2W7_r8 = 0; _w2W7_r8 < 8; _w2W7_r8 = _w2W7_r8 + 1) {
    for (var _w2W7_s8i = 0; _w2W7_s8i < 8; _w2W7_s8i = _w2W7_s8i + 1) {
        for (var _w2W7_m8 = 0; _w2W7_m8 < 8; _w2W7_m8 = _w2W7_m8 + 1) {
            for (var _w2W7_n8 = 0; _w2W7_n8 < 8; _w2W7_n8 = _w2W7_n8 + 1) {
                var _w2W7_sv = 0;
                if (_w2W7_r8 == _w2W7_m8 && _w2W7_s8i == _w2W7_n8) { _w2W7_sv = F64_ONE; }
                if (_w2W7_r8 == _w2W7_n8 && _w2W7_s8i == _w2W7_m8) { _w2W7_sv = f64_neg(F64_ONE); }
                store64(_w2W7_s8 + (((_w2W7_r8 * 8 + _w2W7_s8i) * 8 + _w2W7_m8) * 8 + _w2W7_n8) * 8, _w2W7_sv);
            }
        }
    }
}
var _w2W7_y0 = alloc(64);
var _w2W7_y1 = alloc(64);
for (var _w2W7_q7 = 0; _w2W7_q7 < 8; _w2W7_q7 = _w2W7_q7 + 1) {
    store64(_w2W7_y0 + _w2W7_q7 * 8, 0);
    store64(_w2W7_y1 + _w2W7_q7 * 8, 0);
}
store64(_w2W7_y0, F64_ONE); store64(_w2W7_y1 + 8, F64_ONE);
assert_eq(sectional_curvature(_w2W7_s8, _w2W7_i8, _w2W7_y0, _w2W7_y1, 8), F64_ONE, "the unit sphere at dim 8: K = 1");
assert_eq(_w2W7_tier(_w2W7_s8, _w2W7_i8, _w2W7_y0, _w2W7_y1, 8), 1,
  "  ... certified on the plain path (every term counted: 2)");
# And on a generic plane, where B is dense (cN = p = 28) and each (rho, s) slice of R has two nonzero
# entries (cT = 2): depth 2 + 1 + 1 + 28 + 5 = 37, and num = 2 den exactly, so K = 1 from the plain
# path (counting every entry of a slice, cT = 56, would not certify it).
var _w2W7_y2 = alloc(64);
var _w2W7_y3 = alloc(64);
store64(_w2W7_y2, 0x3FD3333333333333); store64(_w2W7_y2 + 8, 0xBFFB333333333333);
store64(_w2W7_y2 + 16, 0x3FDCCCCCCCCCCCCD); store64(_w2W7_y2 + 24, 0x4000CCCCCCCCCCCD);
store64(_w2W7_y2 + 32, 0xBFE999999999999A); store64(_w2W7_y2 + 40, 0x3FF4CCCCCCCCCCCD);
store64(_w2W7_y2 + 48, 0x3FA999999999999A); store64(_w2W7_y2 + 56, 0xBFE3333333333333);
store64(_w2W7_y3, 0x3FF199999999999A); store64(_w2W7_y3 + 8, 0x3FD0000000000000);
store64(_w2W7_y3 + 16, 0xBFECCCCCCCCCCCCD); store64(_w2W7_y3 + 24, 0x3FE6666666666666);
store64(_w2W7_y3 + 32, 0x3FFE666666666666); store64(_w2W7_y3 + 40, 0xBFD6666666666666);
store64(_w2W7_y3 + 48, 0x3FE999999999999A); store64(_w2W7_y3 + 56, 0x3FC3333333333333);
assert_eq(sectional_curvature(_w2W7_s8, _w2W7_i8, _w2W7_y2, _w2W7_y3, 8), F64_ONE,
  "the unit sphere at dim 8, a generic plane: K = 1");
assert_eq(_w2W7_tier(_w2W7_s8, _w2W7_i8, _w2W7_y2, _w2W7_y3, 8), 1, "  ... certified on the plain path, depth 37");
# The double-double tier's T level carries sum |R B|, not |T|: g = I, R^0_{101} = -R^0_{110} = 1 and
# R^0_{102} = -R^0_{120} = y = -fl(B^{01} / B^{02}), so T^0_1 = 2 (B^{01} + y B^{02}) cancels to about u
# of its terms and num = B^{01} T^0_1 with it. Its bound with |T| in place would certify T to u^2 of
# the terms, which is u of T; with sum |R B| it does not, and the exact tier answers.
var _w2W7_rt = alloc(648);
for (var _w2W7_q8 = 0; _w2W7_q8 < 81; _w2W7_q8 = _w2W7_q8 + 1) { store64(_w2W7_rt + _w2W7_q8 * 8, 0); }
store64(_w2W7_rt + 10 * 8, F64_ONE); store64(_w2W7_rt + 12 * 8, f64_neg(F64_ONE));
store64(_w2W7_rt + 11 * 8, 0x3FD2DD2967564269); store64(_w2W7_rt + 15 * 8, 0xBFD2DD2967564269);
var _w2W7_ut = _w2W7_vec3(0xBFE0C5308BB90646, 0x3FB6A52EF911CF35, 0xBFD0A550870110A1);
var _w2W7_vt = _w2W7_vec3(0x3FCA9A8049667B5F, 0x3FD0179BFDF7E804, 0xBFEBCE5F7403DDDB);
assert_eq(sectional_curvature(_w2W7_rt, _w2W7_i3, _w2W7_ut, _w2W7_vt, 3), 0x3C5114116748E5C4,
  "T cancelling to u of its terms: the oracle's 3C5114116748E5C4");
assert_eq(_w2W7_tier(_w2W7_rt, _w2W7_i3, _w2W7_ut, _w2W7_vt, 3), 3, "  ... from the exact tier");
# Five ulps off in y, T cancels to 2^-50.8 of its terms: between the tier's constant at dim 3 (cn(6) +
# cn(3) + cn(3) + 7 = 301 u^2, failed) and the same without the T level's cn(p) (239 u^2, met).
store64(_w2W7_rt + 11 * 8, 0x3FD2DD2967564264); store64(_w2W7_rt + 15 * 8, 0xBFD2DD2967564264);
assert_eq(sectional_curvature(_w2W7_rt, _w2W7_i3, _w2W7_ut, _w2W7_vt, 3), 0x3C87D1DD2FBC9E9B,
  "T cancelling to 2^-50.8: the oracle's 3C87D1DD2FBC9E9B");
assert_eq(_w2W7_tier(_w2W7_rt, _w2W7_i3, _w2W7_ut, _w2W7_vt, 3), 3, "  ... from the exact tier, the T level counted");
# The same cancellation in T^1_0 (R^1_{001} = -R^1_{010} = 1, R^1_{002} = -R^1_{020} = y), which num reads
# through L_sa: NA's sum carries both LA_as and LA_sa (with LA_as alone the tier certifies ...E5C5).
var _w2W7_rm = alloc(648);
for (var _w2W7_qb = 0; _w2W7_qb < 81; _w2W7_qb = _w2W7_qb + 1) { store64(_w2W7_rm + _w2W7_qb * 8, 0); }
store64(_w2W7_rm + 28 * 8, F64_ONE); store64(_w2W7_rm + 30 * 8, f64_neg(F64_ONE));
store64(_w2W7_rm + 29 * 8, 0x3FD2DD2967564269); store64(_w2W7_rm + 33 * 8, 0xBFD2DD2967564269);
assert_eq(sectional_curvature(_w2W7_rm, _w2W7_i3, _w2W7_ut, _w2W7_vt, 3), 0xBC5114116748E5C4,
  "T^1_0 cancelling: the oracle's BC5114116748E5C4");
assert_eq(_w2W7_tier(_w2W7_rm, _w2W7_i3, _w2W7_ut, _w2W7_vt, 3), 3, "  ... from the exact tier, L_sa's terms counted");
# den at the double-double tier's edge: the Gauss form beside u = (1, 1, 0) with v = (0.3, 0.3 + 3.24e-8, 1)
# (e = 24.88): DA over |den| sits between the tier's den constant at dim 3 (cn(6) + 2 cn(3) + 7 =
# 301 u^2, failed) and the constant with one cn(d) (239 u^2), or DA with CA_sa dropped, which meet it.
# [measured: a scan of v^1 against builds with each change, scratch ht_N1 and ht_N5; sc.py (Fractions), 2026-11-14]
var _w2W7_vb = _w2W7_vec3(0x3FD3333333333333, 0x3FD3333355F9BB64, F64_ONE);
assert_eq(sectional_curvature(_w2W7_rh, _w2W7_g3, _w2W7_un, _w2W7_vb, 3), 0xC314B66D95032FC8,
  "Gauss form, e = 24.88: the oracle's C314B66D95032FC8");
assert_eq(_w2W7_tier(_w2W7_rh, _w2W7_g3, _w2W7_un, _w2W7_vb, 3), 3,
  "  ... from the exact tier, den's GB and C sums and both its C terms counted");
# B's underflow allowance. u = (1.3, 1.7, 0), v = (1.3, 1.7 + 2^-52, 2^-1049 (1 - 2^-25)) on g = I, with
# R^0_{101} = -R^0_{110} = 2^-183 and R^0_{102} = -R^0_{120} = 1.5 2^800: B^{01} is 2^-51.6 and B^{02} =
# 1.3 v^2 is rounded to 2^-1074 in u ∧ v, which B's scaling by 2^52 magnifies to 2^-1023 in the
# scaled units. A certificate allowing only 2^-1030 for it passes the double-double tier's
# 3470005FFFFFE9D9 (6,617 ulps; 3.4.2 returns ...E9D8); the oracle's K is 3470005FFFFFD000, which the
# exact tier gives.
# [measured: scratch rev.py, sc.py (Fractions oracle) against a build without eu and against 3.4.2's, 2026-11-14]
var _w2W7_rs = alloc(648);
for (var _w2W7_q9 = 0; _w2W7_q9 < 81; _w2W7_q9 = _w2W7_q9 + 1) { store64(_w2W7_rs + _w2W7_q9 * 8, 0); }
store64(_w2W7_rs + 10 * 8, 0x3480000000000000); store64(_w2W7_rs + 12 * 8, 0xB480000000000000);
store64(_w2W7_rs + 11 * 8, 0x71F8000000000000); store64(_w2W7_rs + 15 * 8, 0xF1F8000000000000);
var _w2W7_us = _w2W7_vec3(0x3FF4CCCCCCCCCCCD, 0x3FFB333333333333, 0);
var _w2W7_vs = _w2W7_vec3(0x3FF4CCCCCCCCCCCD, 0x3FFB333333333334, 0x0000000001FFFFFF);
assert_eq(sectional_curvature(_w2W7_rs, _w2W7_i3, _w2W7_us, _w2W7_vs, 3), 0x3470005FFFFFD000,
  "a subnormal in v, B scaled by 2^52: the oracle's 3470005FFFFFD000 (3.4.2: ...E9D8)");
assert_eq(_w2W7_tier(_w2W7_rs, _w2W7_i3, _w2W7_us, _w2W7_vs, 3), 3, "  ... from the exact tier (without eu: 2)");
# And on the plain path: u = (1, b, 0), v = (1, b + 2^-52, s), b = 1 + 2^-40, s = (2^43 + 2^39) 2^-1074,
# so B^{01} = 2^-52 exactly (no low parts, no eB) and B^{12} = b s = s + 8.5 2^-1074, which u ∧ v rounds
# to s + 8 2^-1074 (a tie, to even); R^0_{112} = -R^0_{121} = 1 makes num 2 B^{01} B^{12} alone, and B's
# scaling by 2^52 leaves it 2^-44 off. Without the allowance the plain path certifies K 482 u off; the
# oracle's K is 02B1000000001100.
var _w2W7_re = alloc(648);
for (var _w2W7_qa = 0; _w2W7_qa < 81; _w2W7_qa = _w2W7_qa + 1) { store64(_w2W7_re + _w2W7_qa * 8, 0); }
store64(_w2W7_re + 14 * 8, F64_ONE); store64(_w2W7_re + 16 * 8, f64_neg(F64_ONE));   # R^0_112, R^0_121
var _w2W7_ue = _w2W7_vec3(F64_ONE, 0x3FF0000000001000, 0);
var _w2W7_ve = _w2W7_vec3(F64_ONE, 0x3FF0000000001001, 0x0000088000000000);
assert_eq(sectional_curvature(_w2W7_re, _w2W7_i3, _w2W7_ue, _w2W7_ve, 3), 0x02B1000000001100,
  "B^{12} rounded in u ∧ v, B scaled by 2^52: the oracle's 02B1000000001100");
assert_eq(_w2W7_tier(_w2W7_re, _w2W7_i3, _w2W7_ue, _w2W7_ve, 3), 3, "  ... from the exact tier");
# And den's share of the allowance, on the double-double tier: g_02 = g_20 = g_11 = 1 (indefinite;
# the plane (e0, e1) is null), R^2_{101} = -R^2_{110} = c = 1.82, u = (1, 0, w), v = (1, y, w) with
# w = 2^-591.3 and y = 2^-483.2. B^{01} = y, B^{02} = 0, and B^{12} = -w y = -0.712 2^-1074, which
# u ∧ v rounds to -2^-1074. R(B, B) = c y^2 / 2 does not read B^{12}; |B|^2 = 2 w y^2 is -2 B^{01}
# B^{12} alone, so K = c / (4 w) exactly, y cancelling: the oracle's 64D184BD4B407564. Without eu in den's
# bound, the double-double tier certifies c y / (4 |B^{12}|) = 64C8F38EF56F56CD (0.712 K).
var _w2W7_gz = alloc(72);
var _w2W7_rz = alloc(648);
for (var _w2W7_qc = 0; _w2W7_qc < 9; _w2W7_qc = _w2W7_qc + 1) { store64(_w2W7_gz + _w2W7_qc * 8, 0); }
for (var _w2W7_qd = 0; _w2W7_qd < 81; _w2W7_qd = _w2W7_qd + 1) { store64(_w2W7_rz + _w2W7_qd * 8, 0); }
store64(_w2W7_gz + 16, F64_ONE); store64(_w2W7_gz + 32, F64_ONE); store64(_w2W7_gz + 48, F64_ONE);   # g02 g11 g20
store64(_w2W7_rz + 64 * 8, 0x3FFD1F5DD59BF57D); store64(_w2W7_rz + 66 * 8, 0xBFFD1F5DD59BF57D);   # R^2_101, R^2_110
var _w2W7_uz = _w2W7_vec3(F64_ONE, 0, 0x1AFA9921B623E218);
var _w2W7_vz = _w2W7_vec3(F64_ONE, 0x21BB6AAFAE88C0AD, 0x1AFA9921B623E218);
assert_eq(sectional_curvature(_w2W7_rz, _w2W7_gz, _w2W7_uz, _w2W7_vz, 3), 0x64D184BD4B407564,
  "B^{12} below 2^-1074, den alone reading it: K = c / (4 w), the oracle's 64D184BD4B407564");
assert_eq(_w2W7_tier(_w2W7_rz, _w2W7_gz, _w2W7_uz, _w2W7_vz, 3), 3,
  "  ... from the exact tier (without eu in den's double-double bound: 2, 64C8F38EF56F56CD)");
# The double-double quotient's range: dim 16, g_aa = t = 1.46e-149 for a < 8, g_ar = g_ra = 1.99 for a < 8
# <= r, g_rr = 1 for r >= 8; u and v on coordinates 0 .. 7; R^rho_smn = sign((g B)_{rho s} B^{mn}) 1.99
# 2^-990 (m != n; B and g B in doubles, only their signs read). num / den is 2^1006 in the scaled
# units, which split unscaled overflows to NaN; K is 116.35, the oracle's 405D166999CFD923.
var _w2W7_g16 = alloc(2048);
var _w2W7_r16 = alloc(524288);
var _w2W7_u16 = alloc(128);
var _w2W7_v16 = alloc(128);
fn _w2W7_build16() {
    var uw = alloc(64);
    var vw = alloc(64);
    store64(uw, 0xBFEA7C5E048E4F11); store64(uw + 8, 0x3FECF0B8C3EB4FC1); store64(uw + 16, 0xBFE466C253FB06AD);
    store64(uw + 24, 0x3FE8BD4A875F34E4); store64(uw + 32, 0x3FEC6F8AD9486D96); store64(uw + 40, 0xBFEEBCFF5BB5381C);
    store64(uw + 48, 0xBFEF389A9E35C0DE); store64(uw + 56, 0x3FEC7DAC7E724B8C);
    store64(vw, 0xBFE677029B637FDF); store64(vw + 8, 0x3FEB8A57009B7D8A); store64(vw + 16, 0xBFEEA26BD9565452);
    store64(vw + 24, 0xBFEC1B4E1D833B08); store64(vw + 32, 0xBFEAC44AA4B66204); store64(vw + 40, 0xBFE37C58580A6C31);
    store64(vw + 48, 0x3FEBFCAB9858B818); store64(vw + 56, 0xBFECF9B20719C23E);
    for (var i = 0; i < 16; i = i + 1) {
        var ui = 0;
        var vi = 0;
        if (i < 8) { ui = load64(uw + i * 8); vi = load64(vw + i * 8); }
        store64(_w2W7_u16 + i * 8, ui); store64(_w2W7_v16 + i * 8, vi);
    }
    for (var a = 0; a < 16; a = a + 1) {
        for (var r = 0; r < 16; r = r + 1) {
            var gv = 0;
            if (a == r) {
                gv = F64_ONE;
                if (a < 8) { gv = 0x2107E339E878BB17; }
            } else {
                if ((a < 8 && r >= 8) || (a >= 8 && r < 8)) { gv = 0x3FFFD70A3D70A3D7; }   # 1.99
            }
            store64(_w2W7_g16 + (a * 16 + r) * 8, gv);
        }
    }
    var bm = alloc(2048);
    var gbm = alloc(2048);
    for (var m = 0; m < 16; m = m + 1) {
        for (var n = 0; n < 16; n = n + 1) {
            store64(bm + (m * 16 + n) * 8, f64_sub(f64_mul(load64(_w2W7_u16 + m * 8), load64(_w2W7_v16 + n * 8)),
                f64_mul(load64(_w2W7_u16 + n * 8), load64(_w2W7_v16 + m * 8))));
        }
    }
    for (var r2 = 0; r2 < 16; r2 = r2 + 1) {
        for (var s = 0; s < 16; s = s + 1) {
            var acc = 0;
            for (var k = 0; k < 16; k = k + 1) {
                acc = f64_add(acc, f64_mul(load64(_w2W7_g16 + (r2 * 16 + k) * 8), load64(bm + (k * 16 + s) * 8)));
            }
            store64(gbm + (r2 * 16 + s) * 8, acc);
        }
    }
    for (var r3 = 0; r3 < 16; r3 = r3 + 1) {
        for (var s3 = 0; s3 < 16; s3 = s3 + 1) {
            var x = load64(gbm + (r3 * 16 + s3) * 8);
            for (var m3 = 0; m3 < 16; m3 = m3 + 1) {
                for (var n3 = 0; n3 < 16; n3 = n3 + 1) {
                    var y = load64(bm + (m3 * 16 + n3) * 8);
                    var rv = 0;
                    if (m3 != n3 && (x & 0x7FFFFFFFFFFFFFFF) != 0 && (y & 0x7FFFFFFFFFFFFFFF) != 0) {
                        rv = 0x021FD70A3D70A3D7 | ((x ^ y) & 0x8000000000000000);   # +-1.99 2^-990
                    }
                    store64(_w2W7_r16 + (((r3 * 16 + s3) * 16 + m3) * 16 + n3) * 8, rv);
                }
            }
        }
    }
    return 0;
}
_w2W7_build16();
assert_eq(sectional_curvature(_w2W7_r16, _w2W7_g16, _w2W7_u16, _w2W7_v16, 16), 0x405D166999CFD923,
  "dim 16, num / den = 2^1006 scaled: the oracle's 405D166999CFD923 (divided unscaled: NaN)");
assert_eq(_w2W7_tier(_w2W7_r16, _w2W7_g16, _w2W7_u16, _w2W7_v16, 16), 2, "  ... from the double-double tier");
assert_eq(_dg_kq(0x4090000000000000, 0, 0x0210000000000000, 0, 0), 0x7E60000000000000,
  "_dg_kq(2^10, 0, 2^-990, 0, 0) = 2^999 (the quotient split unscaled: NaN)");
# A NaN operand keeps the plain answer (NaN), and so does dim 1 (no plane).
assert_eq(sectional_curvature(_w2W7_rk, _w2W7_g3, _w2W7_un, _w2W7_vec3(0x7FF8000000000000, F64_ONE, F64_ONE), 3),
  0x7FF8000000000000, "a NaN in v: NaN");
assert_eq(_w2W7_tier(_w2W7_rk, _w2W7_g3, _w2W7_un, _w2W7_vec3(0x7FF8000000000000, F64_ONE, F64_ONE), 3), 0,
  "  ... the plain answer, no tier claimed");
assert_eq(sectional_curvature(_w2W7_r2, _w2W7_g2, _w2W7_e0, _w2W7_e1, 1), 0x7FF8000000000000, "dim 1: NaN");

# ==================================================================================================
# 3.5.0 W7 -- se3_log forms -q on the stack (RV-LIE N2, LIE4 F2)
# ==================================================================================================
test_group("3.5.0 W7: se3_log's -q on the stack");
fn _w2W7_log_bytes(se) {
    var a = alloc_used();
    var tw = se3_log(se);
    if (tw == 0) { return 0 - 1; }
    return alloc_used() - a;
}
# -q by the 3.4.1 route, su2_compose by (-1, 0, 0, 0), then logged as a w > 0 element: the six
# words se3_log of q must give, bit for bit.
fn _w2W7_log_eq(q, t) {
    var mq = su2_compose(q, su2_from_quat(hquat_new(0, 0, 0, f64_neg(F64_ONE))));
    var a = se3_log(se3_new(q, t));
    var b = se3_log(se3_new(mq, t));
    var n = 0;
    for (var i = 0; i < 6; i = i + 1) {
        if (_vec6_get(a, i) == _vec6_get(b, i)) { n = n + 1; }
    }
    return n;
}
var _w2W7_t = hvec3_new(F64_ONE, f64_neg(F64_TWO), 0x3FD5555555555555);
# A turn of 5 about (1, 2, 3) has w = cos 2.5 < 0; a turn of 1 has w > 0. Each log allocates its
# twist and V^-1's temporaries alone: the same bytes (3.4.2: 96 B more at w < 0, -q's HQuat and
# two SU(2) elements; 776 B against 680, before 3.5.0 read w in place).
var _w2W7_qn = su2_from_axis_angle(hvec3_new(F64_ONE, F64_TWO, f64_from(3)), f64_from(5));
var _w2W7_qp = su2_from_axis_angle(hvec3_new(F64_ONE, F64_TWO, f64_from(3)), F64_ONE);
assert_eq(f64_lt(HQuat_w(su2_to_quat(_w2W7_qn)), 0), 1, "control: the turn of 5 has w < 0");
assert_eq(_w2W7_log_bytes(se3_new(_w2W7_qn, _w2W7_t)), _w2W7_log_bytes(se3_new(_w2W7_qp, _w2W7_t)),
  "se3_log allocates the same at w < 0 as at w > 0");
assert_eq(_w2W7_log_bytes(se3_new(_w2W7_qn, _w2W7_t)), 648, "se3_log at w < 0: 648 B (3.4.2: 776)");
assert_eq(_w2W7_log_eq(_w2W7_qn, _w2W7_t), 6, "se3_log at w < 0: all six words are -q's log, as 3.4.1 formed -q");
# Zero components keep the signs su2_compose gave them (+0 where a plain negation gives -0, about
# y): a turn of 5 about x, about y, about -y, and the element (-1/2, 1/2, -1/2, 1/2).
assert_eq(_w2W7_log_eq(su2_from_axis_angle(hvec3_new(F64_ONE, 0, 0), f64_from(5)), _w2W7_t), 6,
  "about x: six words as 3.4.1's -q");
assert_eq(_w2W7_log_eq(su2_from_axis_angle(hvec3_new(0, F64_ONE, 0), f64_from(5)), _w2W7_t), 6,
  "about y: six words as 3.4.1's -q");
assert_eq(_w2W7_log_eq(su2_from_axis_angle(hvec3_new(0, f64_neg(F64_ONE), 0), f64_from(5)), _w2W7_t), 6,
  "about -y: six words as 3.4.1's -q");
assert_eq(_w2W7_log_eq(su2_from_quat(hquat_new(F64_HALF, f64_neg(F64_HALF), F64_HALF, f64_neg(F64_HALF))), _w2W7_t),
  6, "(-1/2, 1/2, -1/2, 1/2): six words as 3.4.1's -q");

# ==================================================================================================
# 3.5.0 W7 -- cx_ln's band at less cost (wave 1's form: 1.6 to 2.5 times 3.4.2)
# ==================================================================================================
# Each value is the 120-digit Decimal oracle's (1/2) ln(re^2 + im^2) within the stated ulps; the
# path each point takes is named, with what the other path or form would have given.
test_group("3.5.0 W7: cx_ln's band at less cost");
fn _w2W7_lnre(x, y) { return HComplex_re(cx_ln(cx_new(x, y))); }
assert_eq(_w2W7_lnre(0x3FECCCCCCCCCCCCD, 0x3FD3333333333333), 0xBFAAF8E8210A415B,
  "0.9 + 0.3i, the ln path: 0.235 ulp (ln of the modulus: ...4162, 7.2 ulp)");
assert_eq(_w2W7_lnre(0x3FE3333333333333, 0x3FE999999999999A), 0x3C7999999999999A,
  "0.6 + 0.8i, the series by four 2Sums: 0.160 ulp (ln of the modulus: 0)");
# The band's top: ns = 4 + 2^-50 has root 2, in the band; 4 + 2^-49 does not.
assert_eq(_w2W7_lnre(0x4000000000000000, 0x3E60000000000000), 0x3FE62E42FEFA39F0,
  "2 + 2^-25 i, ns = 4 + 2^-50, the band: 0.209 ulp (ln of the modulus: ...39EF, 1.2)");
assert_eq(_w2W7_lnre(0x4000000000000000, 0x3E66A09E667F3BCD), 0x3FE62E42FEFA39F1,
  "2 + 2^-24.5 i, ns = 4 + 2^-49, outside: ln of the modulus");
assert_eq(_w2W7_lnre(0x4000000000000000, 0x3E70000000000000), 0x3FE62E42FEFA39F3,
  "2 + 2^-24 i, ns = 4 + 2^-48, outside: 0.209 ulp");
# The ln path moves u to its neighbour when |e| passes half its ulp: wave 1's form gave ...548E (0.515).
assert_eq(_w2W7_lnre(0xBFC7927A6C414E50, 0xBFFA334955828AA2), 0x3FDFF747534B548F,
  "-0.184 - 1.637i, the ln path with u moved: 0.485 ulp (unmoved: ...548E, 0.515)");
# The series: re^2 = 0.09 < 1/4 takes D = (im^2 - 1) + re^2 + lows; re = im = 0.7071 (both squares
# under 1/2) takes D = (re^2 - 1/2) + (im^2 - 1/2) + lows; re = 1, im = 2^-60, D = 2^-120 exactly.
assert_eq(_w2W7_lnre(0x3FD3333333333333, 0x3FEE86AB810EA912), 0x3C5C3C241224E272,
  "0.3 + 0.954i, the series with the larger square im's: 0.049 ulp");
assert_eq(_w2W7_lnre(0x3FE6A09E667F3BCC, 0x3FE6A09E667F3BCC), 0xBC998D4D0DA05571,
  "0.7071 (1 + i), the series from 1/2 and 1/2: 0.362 ulp");
assert_eq(_w2W7_lnre(F64_ONE, 0x3C30000000000000), 0x3860000000000000, "1 + 2^-60 i: 2^-121 exactly");
# Points where one part decides the last bit, found on a sweep of the band (Decimal oracle):
# the band's two edges (ns = 4 + 2^-49 and 1/4 - 2^-55 outside it, 1/4 inside), u moved down, the
# series from 1/2 and 1/2 with an odd square, and each of the series' three carried errors.
assert_eq(_w2W7_lnre(0x3FE918C7EA526A75, 0x3FFD6FDFFDE9000B), 0x3FE62E42FEFA39F1,
  "ns = 4 + 2^-49, outside: ln of the modulus, 0.819 ulp (the band: ...39F2)");
assert_eq(_w2W7_lnre(0xBFD630D5F4884052, 0xBFD70E48FA4D4757), 0xBFE62E42FEFA39EE,
  "ns = 1/4, the band: 0.577 ulp (ln of the modulus: ...39EF)");
assert_eq(_w2W7_lnre(0xBFC1E4BDCB586D8B, 0x3FDEB94EC91529B5), 0xBFE62E42FEFA39F0,
  "ns = 1/4 - 2^-55, outside: 0.642 ulp (the band: ...39EF)");
assert_eq(_w2W7_lnre(0x3FE6A09E667F3014, 0x3FE6A09E667F3011), 0xBD60958F7D543D89,
  "both squares just under 1/2, the series from 1/2 and 1/2: 0.251 ulp");
assert_eq(_w2W7_lnre(0xBFE04E5987DA7571, 0xBFA7EF37785580D0), 0xBFE570B6D3F2C1BA,
  "the ln path with u moved down: 0.673 ulp (unmoved: ...C1B9, 0.327)");
assert_eq(_w2W7_lnre(0xBFCA46ABDEBED4FB, 0xBFEF5188CC0B7B52), 0xBC472A218EFCEDA7,
  "the series, its low parts' 2Sum error carried: 0.016 ulp");
assert_eq(_w2W7_lnre(0xBFB3F553DC66F6F7, 0x3FEFE710F071F35F), 0xBC8CB6E4EDB83436,
  "the series, the third 2Sum's error carried: 0.137 ulp");
assert_eq(_w2W7_lnre(0xBDFA705CC16DBB5C, 0x3FF0000000000119), 0x3D3190015D8213B0,
  "the series, the fourth 2Sum's error carried: 0.352 ulp");
# Outside the band ns is cx_abs's own: below DBL_MIN (2^-600: ns flushes to 0) and past DBL_MAX
# (2^600: ns overflows) the modulus comes from the rescue, and ln of it is +-600 ln 2.
assert_eq(_w2W7_lnre(0x1A70000000000000, 0), 0xC079FE3682CD3BE4, "cx_ln(2^-600).re = -600 ln 2");
assert_eq(_w2W7_lnre(0x6570000000000000, 0), 0x4079FE3682CD3BE4, "cx_ln(2^600).re = 600 ln 2");

# ==================================================================================================
# 3.5.0 wave 2 — a 0 handle passed to the vec/quat foundations (vec2, vec3, vec4, quat)
# ==================================================================================================
# (Written as tests/w2_W8.tcyr; every global and fn below is prefixed _w2W8_.)

# ==================================================================================================
# 3.5.0 W8 -- a 0 handle passed in (roadmap [3.5.0] "A 0 handle passed in still faults", INS5 F3)
# ==================================================================================================
# 0 is the designed answer of every constructor whose allocation was refused, and through 3.4.2
# these functions read address 0 for it (rc 139). The contract since 3.5.0, by the function's
# type: a handle result is the designed 0, before anything is allocated (alloc_used() does not move);
# a double result is NaN, 0x7FF8000000000000; a Result is Err(HSB_ERR_INVALID_INPUT); an `_into`
# form writes NaN into every component of out and returns 0. Each function is called with 0 in
# each handle position in turn, the others valid.
# Each case runs in a child process (_w2W8_iso), so one that faults is a failed assertion, counted,
# and the cases after it still run. On the 3.5.0 wave-1 tree 77 of the 90 cases fault that way
# (five of the functions tested do not exist in 3.4.2, so this block does not build there).
# [measured: lane W8's run of this block on the 3.5.0 wave-1 tree, cycc 6.7.18]
# The child is made non-dumpable first (prctl PR_SET_DUMPABLE 0), so such a fault leaves no core file.
test_group("3.5.0 W8: a 0 handle passed in is the designed answer, never a read of address 0");
var _w2W8_NAN = 0x7FF8000000000000;
var _w2W8_u0 = 0;
# Record the heap's use before a call.
fn _w2W8_mark() {
    _w2W8_u0 = alloc_used();
    return 0;
}
# 1 when h is the designed 0 and nothing was allocated since _w2W8_mark(); 0 for a non-zero h, 2
# for a 0 that allocated first.
fn _w2W8_z(h) {
    if (h != 0) { return 0; }
    if (alloc_used() != _w2W8_u0) { return 2; }
    return 1;
}
# 1 when a Result's tag is Err, its code HSB_ERR_INVALID_INPUT, and nothing was allocated since
# _w2W8_mark(); 0 otherwise.
fn _w2W8_err(t, v) {
    if (is_err_result(t) != 1 || v != HSB_ERR_INVALID_INPUT) { return 0; }
    if (alloc_used() != _w2W8_u0) { return 0; }
    return 1;
}
# 1 when an `_into` call returned 0 and left NaN in all n components of out (n = 3 or 4).
fn _w2W8_nan_out(r, out, n) {
    if (r != 0) { return 0; }
    var i = 0;
    while (i < n) {
        if (load64(out + i * 8) != _w2W8_NAN) { return 2; }
        i = i + 1;
    }
    return 1;
}
# out set to (1, 2, 3, 4) before an `_into` call, so a call that writes nothing is seen.
fn _w2W8_fill(out, n) {
    var i = 0;
    while (i < n) {
        store64(out + i * 8, f64_from(i + 1));
        i = i + 1;
    }
    return out;
}
var _w2W8_v2 = hvec2_new(F64_ONE, F64_TWO);
var _w2W8_v3 = hvec3_new(F64_ONE, F64_TWO, 0x4008000000000000);
var _w2W8_n3 = hvec3_unit_z();
var _w2W8_v4 = hvec4_new(F64_ONE, F64_TWO, 0x4008000000000000, 0x4010000000000000);
var _w2W8_q = hquat_from_rotation_y(F64_HALF);
