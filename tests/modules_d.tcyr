assert_eq(_v35L4_rvt, 1, "... y");
# Its matcher refuses as sym_match_checked does: {a + a -> 2a} on V + V, V a variable named 0 that the
# comparison meets, is refused, 0 (3.4.2: no match, the input back), as a pattern variable meeting
# one already was. The control: x + x -> 2x.
var _v35L4_rr2 = vec_new();
vec_push(_v35L4_rr2, sym_rule(pat_add(_v35L4_pa, _v35L4_pa), pat_mul(pat_const(F64_TWO), _v35L4_pa)));
assert_eq(sym_rewrite(expr_add(_v35L4_nv, _v35L4_nv), _v35L4_rr2), 0, "{a + a -> 2a} on V + V, V named 0: refused, 0");
var _v35L4_rx2 = sym_rewrite(expr_add(_v35L4_x, _v35L4_x), _v35L4_rr2);
assert_eq(expr_tag(_v35L4_rx2), EXPR_MUL, "... on x + x: 2x");
# A refused allocation: every point of a refusal sweep answers Ok(1) or Err(ALLOC), never Ok(0).
fn _v35L4_msweep() {
    var p = pat_add(pat_wildcard(str_from("a")), pat_add(pat_wildcard(str_from("b")), pat_wildcard(str_from("a"))));
    var y = expr_var(str_from("y"));
    var e = expr_add(y, expr_add(expr_var(str_from("z")), y));
    var bad = 0;
    var errs = 0;
    var k = 0;
    while (k < 40) {
        var ta = test_allocator();
        test_allocator_fail_after(ta, k);
        var prev = hisab_alloc_scope(ta);
        var t, v = sym_match_checked(p, e);
        var bt, bv = sym_match_bindings_checked(p, e);
        hisab_alloc_scope(prev);
        if (is_ok(t) == 1) {
            if (v != 1) { bad = bad + 1; }
        } else {
            if (v != HSB_ERR_ALLOC) { bad = bad + 1; }
            errs = errs + 1;
        }
        if (is_ok(bt) == 1) {
            if (bv == 0) { bad = bad + 1; }
        } elif (bv != HSB_ERR_ALLOC) { bad = bad + 1; }
        if (is_ok(t) == 1 && is_ok(bt) == 1) { return bad * 1000 + errs; }
        k = k + 1;
    }
    return 0 - 1;
}
var _v35L4_ta4 = test_allocator();
test_allocator_fail_after(_v35L4_ta4, 0);
var _v35L4_scm = hisab_alloc_scope(_v35L4_ta4);
var _v35L4_iat0, _v35L4_iav0 = sym_match_checked(0, _v35L4_x);
var _v35L4_ibt0, _v35L4_ibv0 = sym_match_bindings_checked(_v35L4_pa, 0);
hisab_alloc_scope(_v35L4_scm);
assert_eq(_v35L4_iav0, HSB_ERR_INVALID_INPUT,
  "a 0 pattern under a refusing scope: INVALID_INPUT, before any allocation");
assert_eq(_v35L4_ibv0, HSB_ERR_INVALID_INPUT, "... and a 0 expression, through the bindings form");
var _v35L4_ms = _v35L4_msweep();
assert_eq(_v35L4_ms / 1000, 0, "a refusal sweep: no Ok(0) and no other code (3.4.2: no match at each refusal)");
assert_eq(_v35L4_ms > 0, 1, "... the sweep met a refusal, and an answer at the end");

# ================================================================
test_group("3.5.0 L4: the walkers read a shared node once");
# RV-SYM N6, SYM2 item 7: every walker but sym_rewrite walked a shared node once per parent. x + x
# doubled 60 times is 61 nodes and 2^61 visits as a tree; each answer is exact, so its bits are
# the oracle: 3 x 2^60, 2^60, and 4.5 x 2^60 for the integral (x^2 / 2 at 3, 2^60 times).
var _v35L4_d60 = _v35L4_edbl(_v35L4_x, 60);
var _v35L4_g1t, _v35L4_g1v = expr_eval_checked(_v35L4_d60, _v35L4_vx3);
assert_eq(_v35L4_g1v, 0x43C8_0000_0000_0000, "eval(x doubled 60) at 3: 3 x 2^60 (3.4.2: 2^61 visits)");
var _v35L4_g2t, _v35L4_g2v = expr_eval_checked(expr_diff(_v35L4_d60, _v35L4_xs), _v35L4_vx3);
assert_eq(_v35L4_g2v, 0x43B0_0000_0000_0000, "d/dx (x doubled 60): 2^60");
var _v35L4_g3t, _v35L4_g3v = expr_eval_checked(expr_simplify(_v35L4_d60), _v35L4_vx3);
assert_eq(_v35L4_g3v, 0x43C8_0000_0000_0000, "simplify(x doubled 60) at 3: 3 x 2^60");
var _v35L4_g4t, _v35L4_g4v = expr_eval_checked(sym_integrate(_v35L4_d60, _v35L4_xs), _v35L4_vx3);
assert_eq(_v35L4_g4v, 0x43D2_0000_0000_0000, "integral of (x doubled 60) at 3: 4.5 x 2^60");
# The derivative of a 4,000-deep chain, simplified: quadratic through 3.4.2 (0.84 s at 4,000).
# Its value against forward mode, which forms the same products in the same order (dual_sin's
# tangent t cos(v), the derivative's cos(f) f'), an independent path to the same bits.
# [measured: scratch probes sh_*.cyr on the 3.4.2 tree, taskset, 2026-11-14]
var _v35L4_sc4 = _v35L4_x;
var _v35L4_pc4 = _v35L4_x;
var _v35L4_du = dual_var(F64_HALF);
for (var i = 0; i < 4000; i = i + 1) {
    _v35L4_sc4 = expr_sin(_v35L4_sc4);
    _v35L4_pc4 = expr_pow(_v35L4_pc4, expr_const(F64_ONE));
    _v35L4_du = dual_sin(_v35L4_du);
}
var _v35L4_vh = vec_new();
vec_push(_v35L4_vh, expr_bind(_v35L4_xs, F64_HALF));
var _v35L4_g5t, _v35L4_g5v = expr_eval_checked(expr_simplify(expr_diff(_v35L4_sc4, _v35L4_xs)), _v35L4_vh);
assert_eq(_v35L4_g5v, Dual_deriv(_v35L4_du), "simplify(d/dx sin^4000(x)) at 0.5: forward mode's bits");
var _v35L4_g6 = expr_simplify(expr_diff(_v35L4_pc4, _v35L4_xs));
assert_eq(expr_tag(_v35L4_g6), EXPR_CONST, "simplify(d/dx (x^1)^1... 4,000 deep) is a constant");
assert_eq(expr_const_val(_v35L4_g6), F64_ONE, "... 1");
# A product nested 20,000 deep on the left: O(n^2) through 3.4.2 (5.85 s), the factor 1 so the value
# is exact: x^2 / 2 at 3 is 4.5.
# [measured: scratch probe ln_20000.cyr on the 3.4.2 tree, taskset, 2026-11-14]
var _v35L4_lp = _v35L4_x;
for (var i = 0; i < 20000; i = i + 1) { _v35L4_lp = expr_mul(_v35L4_lp, expr_const(F64_ONE)); }
var _v35L4_g7t, _v35L4_g7v = expr_eval_checked(sym_integrate(_v35L4_lp, _v35L4_xs), _v35L4_vx3);
assert_eq(_v35L4_g7v, 0x4012_0000_0000_0000, "integral of ((x * 1) * 1)... 20,000 deep at 3: 4.5");
# The memo walks give the plain walks' answers (white-box: each called on a shared tree the plain
# walk takes too). The tree mixes every operator, negations of negations among them.
fn _v35L4_mix(n) {
    var x = expr_var(str_from("x"));
    var y = expr_var(str_from("y"));
    var e = expr_add(x, y);
    for (var i = 0; i < n; i = i + 1) {
        var k = i % 6;
        if (k == 0) { e = expr_neg(expr_neg(expr_sin(e))); }
        if (k == 1) { e = expr_mul(e, expr_add(e, expr_const(F64_TWO))); }
        if (k == 2) { e = expr_pow(expr_neg(expr_neg(e)), expr_const(F64_TWO)); }
        if (k == 3) { e = expr_add(expr_exp(expr_mul(e, expr_const(F64_HALF))), expr_neg(e)); }
        if (k == 4) { e = expr_ln(expr_add(expr_mul(e, e), expr_const(F64_ONE))); }
        if (k == 5) { e = expr_add(expr_cos(e), expr_neg(expr_neg(expr_neg(e)))); }
    }
    return e;
}
var _v35L4_mx = _v35L4_mix(13);
var _v35L4_mxd = expr_diff(_v35L4_mx, _v35L4_xs);
var _v35L4_cnt: i64[1];
store64(&_v35L4_cnt, 0);
var _v35L4_pl = _sym_simp_rec(_v35L4_mxd, 0, &_v35L4_cnt);
assert_eq(load64(&_v35L4_cnt) > 100000 && load64(&_v35L4_cnt) <= _SYM_SHARE_WALK, 1,
  "fixture: the plain walk takes the derivative, a shared tree of over 100,000 operators");
assert_eq(str_eq(expr_to_str(_sym_simp_memo(_v35L4_mxd)), expr_to_str(expr_simplify(_v35L4_mxd))), 1,
  "the simplify memo walk: the plain walk's text");
assert_eq(str_eq(expr_to_str(_sym_simp_memo(_v35L4_mx)), expr_to_str(expr_simplify(_v35L4_mx))), 1,
  "... and on the tree itself, its negations of negations");
assert_eq(str_eq(expr_to_str(_sym_diff_memo(_v35L4_mx, _v35L4_xs)), expr_to_str(_v35L4_mxd)), 1,
  "the diff memo walk: the plain walk's text");
var _v35L4_vxy = vec_new();
vec_push(_v35L4_vxy, expr_bind(_v35L4_xs, 0x3FE3_3333_3333_3333));
vec_push(_v35L4_vxy, expr_bind(str_from("y"), 0x3FD0_0000_0000_0000));
var _v35L4_bad2: i64[2];
store64(&_v35L4_bad2, 0);
var _v35L4_ev1 = _sym_eval_memo(_v35L4_mxd, _v35L4_vxy, &_v35L4_bad2);
var _v35L4_ev2t, _v35L4_ev2v = expr_eval_checked(_v35L4_mxd, _v35L4_vxy);
assert_eq(_v35L4_ev1, _v35L4_ev2v, "the eval memo walk: the plain walk's bits");
assert_eq(load64(&_v35L4_bad2), 0, "... with no failure bit");
fn _v35L4_intmemo(e, v) {
    var b: i64[17];
    var f: i64[768];
    _sx_call_open(&b, &f, 0x7FFF_FFFF_FFFF_FFFF);
    _sx_memo_open(&b);
    store64(&b + _SX_B_DEEP, 1);
    return _sym_int_walk(e, v, &b);
}
var _v35L4_is = expr_add(expr_add(expr_mul(_v35L4_two, expr_sin(_v35L4_x)), expr_ln(_v35L4_x)),
  expr_neg(expr_pow(_v35L4_x, expr_const(0x4008_0000_0000_0000))));
var _v35L4_is2 = expr_add(expr_add(_v35L4_is, _v35L4_is), expr_mul(expr_mul(_v35L4_y, _v35L4_is), expr_cos(_v35L4_y)));
var _v35L4_imt = expr_to_str(_v35L4_intmemo(_v35L4_is2, _v35L4_xs));
assert_eq(str_eq(_v35L4_imt, expr_to_str(sym_integrate(_v35L4_is2, _v35L4_xs))), 1,
  "the integrate memo walk: the plain walk's text");
assert_eq(_v35L4_intmemo(expr_mul(_v35L4_x, expr_sin(_v35L4_x)), _v35L4_xs), 0,
  "... and its 0 for x sin(x), the product it cannot integrate");

# ================================================================
test_group("3.5.0 L4: a no-op rewrite reuses its walks' stack blocks");
# SYM F5, SYM4: every walk a rewrite began grew a stack of its own into new heap, never reused:
# {a * a -> a^2} on d/dx sin^17000(x) allocated 39.8 MB, 33.2 MB of it in 575 stack blocks. Here,
# on d/dx sin^3000(x), the bytes of one call, against what the 3.4.2 tree allocated for it.
# [measured: scratch probe nr.cyr, the 3.4.2 tree and lane L4's, alloc_used, 2026-11-14]
var _v35L4_sq = vec_new();
vec_push(_v35L4_sq, sym_rule(pat_mul(_v35L4_pa, _v35L4_pa), pat_pow(_v35L4_pa, pat_const(F64_TWO))));
var _v35L4_s3k = _v35L4_x;
for (var i = 0; i < 3000; i = i + 1) { _v35L4_s3k = expr_sin(_v35L4_s3k); }
var _v35L4_ds3k = expr_diff(_v35L4_s3k, _v35L4_xs);
var _v35L4_u0 = alloc_used();
var _v35L4_rs3k = sym_rewrite(_v35L4_ds3k, _v35L4_sq);
var _v35L4_ub = alloc_used() - _v35L4_u0;
assert_eq(_v35L4_rs3k, _v35L4_ds3k, "the no-op answers its input");
assert_eq(_v35L4_ub, 930840, "... in 930,840 bytes, its walks' stacks reused (3.4.2: 17,531,928)");
# The instantiation's stacks: {x -> sin^300(y)} on a sum of 40 x's builds 40 deep templates.
# [measured: scratch probe id.cyr, the 3.4.2 tree and lane L4's, alloc_used, 2026-11-14]
var _v35L4_ty = pat_var(str_from("y"));
for (var i = 0; i < 300; i = i + 1) { _v35L4_ty = pat_sin(_v35L4_ty); }
var _v35L4_txr = vec_new();
vec_push(_v35L4_txr, sym_rule(pat_var(_v35L4_xs), _v35L4_ty));
var _v35L4_s40 = _v35L4_x;
for (var i = 1; i < 40; i = i + 1) { _v35L4_s40 = expr_add(_v35L4_s40, expr_var(_v35L4_xs)); }
var _v35L4_u1 = alloc_used();
var _v35L4_r40 = sym_rewrite(_v35L4_s40, _v35L4_txr);
var _v35L4_ub1 = alloc_used() - _v35L4_u1;
assert_neq(_v35L4_r40, 0, "{x -> sin^300(y)} on 40 x's answers");
assert_eq(_v35L4_ub1, 203968, "... in 203,968 bytes: 193,728 of nodes and the vec, 10,240 of stack (3.4.2: 501,952)");
# The deep parts of a rewrite walk: a no-op on a sum of 64 terms sin^400(x), each past 256 levels.
var _v35L4_s64 = 0;
for (var i = 0; i < 64; i = i + 1) {
    var _v35L4_tm = _v35L4_x;
    for (var j = 0; j < 400; j = j + 1) { _v35L4_tm = expr_sin(_v35L4_tm); }
    if (i == 0) { _v35L4_s64 = _v35L4_tm; } else { _v35L4_s64 = expr_add(_v35L4_s64, _v35L4_tm); }
}
var _v35L4_u2 = alloc_used();
var _v35L4_r64 = sym_rewrite(_v35L4_s64, _v35L4_sq);
var _v35L4_ub2 = alloc_used() - _v35L4_u2;
assert_eq(_v35L4_r64, _v35L4_s64, "a no-op on 64 terms sin^400(x) answers its input");
assert_eq(_v35L4_ub2, 2200, "... in 2,200 bytes: the vec and one 2,048-byte region (3.4.2: 196,760)");
# The match's stacks: {a + a -> 2a} on a product of 40 pairs P + Q, P and Q left-deep sums of 400
# ones on x and on y: each comparison 400 deep, its stack growing, failing at the bottom, x against
# y. (Of the bytes, 512,000 are the binding pairs of the 32,000 one-term sums, a bound before 1.)
# [measured: scratch probe t14b.cyr, the 3.4.2 tree and lane L4's, alloc_used, 2026-11-14]
var _v35L4_aa = vec_new();
vec_push(_v35L4_aa, sym_rule(pat_add(_v35L4_pa, _v35L4_pa), pat_mul(pat_const(F64_TWO), _v35L4_pa)));
var _v35L4_npr = 0;
for (var i = 0; i < 40; i = i + 1) {
    var _v35L4_pp = _v35L4_x;
    var _v35L4_pq = _v35L4_y;
    for (var j = 0; j < 400; j = j + 1) {
        _v35L4_pp = expr_add(_v35L4_pp, expr_const(F64_ONE));
        _v35L4_pq = expr_add(_v35L4_pq, expr_const(F64_ONE));
    }
    if (i == 0) {
        _v35L4_npr = expr_mul(_v35L4_pp, _v35L4_pq);
    } else {
        _v35L4_npr = expr_mul(_v35L4_npr, expr_add(_v35L4_pp, _v35L4_pq));
    }
}
var _v35L4_u3 = alloc_used();
var _v35L4_r3 = sym_rewrite(_v35L4_npr, _v35L4_aa);
var _v35L4_ub3 = alloc_used() - _v35L4_u3;
assert_eq(_v35L4_r3, _v35L4_npr, "40 near-pairs, {a + a -> 2a}: no match, the input");
assert_eq(_v35L4_ub3, 523016, "... in 523,016 bytes, the comparisons' stacks reused (3.4.2: 1,038,088)");
# Each rule's turn: {sin a -> cos a} and {cos a -> sin a} on sin^300(y doubled 22) flip it for 50
# passes, each a memo walk (past 2^20 visits) with a stack 322 deep.
var _v35L4_e22 = _v35L4_edbl(_v35L4_y, 22);
for (var i = 0; i < 300; i = i + 1) { _v35L4_e22 = expr_sin(_v35L4_e22); }
var _v35L4_sc2 = vec_new();
vec_push(_v35L4_sc2, sym_rule(pat_sin(_v35L4_pa), pat_cos(_v35L4_pa)));
vec_push(_v35L4_sc2, sym_rule(pat_cos(_v35L4_pa), pat_sin(_v35L4_pa)));
var _v35L4_u4 = alloc_used();
var _v35L4_r4 = sym_rewrite(_v35L4_e22, _v35L4_sc2);
var _v35L4_ub4 = alloc_used() - _v35L4_u4;
assert_neq(_v35L4_r4, 0, "sin/cos flipped 50 passes on sin^300(y doubled 22): answered");
assert_eq(_v35L4_ub4, 741880, "... in 741,880 bytes, each pass in the stacks of the one before (3.4.2: 1,270,264)");
# The cost: a call that hands little back can need more meter, its regions doubling. One deep walk
# down a chain of 2,400 mixed operators answers from 271,360 bytes; 3.4.2's from 230,400.
# [measured: scratch probe p_meter2.tcyr, least answering ALLOC_MAX bisected, 3.4.2 tree and lane L4's, 2026-11-14]
var _v35L4_ch24 = _v35L4_x;
for (var i = 0; i < 2400; i = i + 1) {
    var j = (i * 7) % 5;
    if (j == 0) { _v35L4_ch24 = expr_sin(_v35L4_ch24); }
    if (j == 1) { _v35L4_ch24 = expr_add(_v35L4_ch24, _v35L4_two); }
    if (j == 2) { _v35L4_ch24 = expr_mul(_v35L4_two, _v35L4_ch24); }
    if (j == 3) { _v35L4_ch24 = expr_neg(_v35L4_ch24); }
    if (j == 4) { _v35L4_ch24 = expr_cos(_v35L4_ch24); }
}
var _v35L4_r3r = vec_new();
vec_push(_v35L4_r3r, sym_rule(pat_neg(pat_neg(_v35L4_pa)), _v35L4_pa));
vec_push(_v35L4_r3r, sym_rule(pat_mul(_v35L4_pa, pat_const(F64_ONE)), _v35L4_pa));
vec_push(_v35L4_r3r, sym_rule(pat_add(_v35L4_pa, pat_const(0)), _v35L4_pa));
var _v35L4_amk = ALLOC_MAX;
ALLOC_MAX = 271360;
var _v35L4_r5 = sym_rewrite(_v35L4_ch24, _v35L4_r3r);
ALLOC_MAX = 271359;
var _v35L4_r5b = sym_rewrite(_v35L4_ch24, _v35L4_r3r);
ALLOC_MAX = _v35L4_amk;
assert_neq(_v35L4_r5, 0, "a 2,400-operator chain under three rules: answered at 271,360 bytes");
assert_eq(_v35L4_r5b, 0, "... refused one byte below, where 3.4.2 answered from 230,400");

# ================================================================
test_group("3.5.0 L4: a shared template is built once");
# SYM5: a rule whose template shares a node was built as a tree at every firing: a constant
# doubled 40 times, 41 pattern nodes, built until the meter refused, 0 after about 2 GiB.
# [measured: scratch probe r12_1_40.cyr, the 3.4.2 tree (refused, 7.7 s) and lane L4's, 2026-11-14]
var _v35L4_tp = _v35L4_pdbl(pat_const(F64_ONE), 40);
var _v35L4_tr = vec_new();
vec_push(_v35L4_tr, sym_rule(pat_var(_v35L4_xs), _v35L4_tp));
var _v35L4_t40 = sym_rewrite(_v35L4_x, _v35L4_tr);
assert_neq(_v35L4_t40, 0, "{x -> 1 doubled 40 times} on x answers (3.4.2: 0)");
assert_eq(expr_left(_v35L4_t40), expr_right(_v35L4_t40), "... and its root's two operands are one node, shared");
var _v35L4_t4t, _v35L4_t4v = expr_eval_checked(_v35L4_t40, vec_new());
assert_eq(_v35L4_t4v, 0x4270_0000_0000_0000, "... evaluating to 2^40");
# Each firing is an instantiation of its own: {sin(a) -> (1 doubled 13) + a} on sin(x) + sin(y),
# the rule big (2^14 template visits), a bound to x and then to y: 2^13 + x + 2^13 + y.
var _v35L4_tw = vec_new();
vec_push(_v35L4_tw, sym_rule(pat_sin(_v35L4_pa), pat_add(_v35L4_pdbl(pat_const(F64_ONE), 13), _v35L4_pa)));
assert_eq(_rule_big(vec_get(_v35L4_tw, 0)), 1, "fixture: the rule is big");
var _v35L4_sxy = sym_rewrite(expr_add(expr_sin(_v35L4_x), expr_sin(_v35L4_y)), _v35L4_tw);
var _v35L4_vxy2 = vec_new();
vec_push(_v35L4_vxy2, expr_bind(_v35L4_xs, F64_ONE));
vec_push(_v35L4_vxy2, expr_bind(str_from("y"), F64_TWO));
var _v35L4_sxt, _v35L4_sxv = expr_eval_checked(_v35L4_sxy, _v35L4_vxy2);
assert_eq(_v35L4_sxv, f64_from(16387), "... (8192 + 1) + (8192 + 2) = 16,387: each firing its own binding");
# A rule small enough to walk as a tree is built as before, a node per use.
var _v35L4_tq = vec_new();
vec_push(_v35L4_tq, sym_rule(pat_var(_v35L4_xs), _v35L4_pdbl(pat_const(F64_ONE), 2)));
var _v35L4_t2 = sym_rewrite(_v35L4_x, _v35L4_tq);
assert_neq(expr_left(_v35L4_t2), expr_right(_v35L4_t2), "{x -> 1 doubled twice}: the plain build, two nodes");
assert_eq(str_eq_cstr(expr_to_str(_v35L4_t2), "((1 + 1) + (1 + 1))"), 1, "... it is ((1 + 1) + (1 + 1))");

# ================================================================
test_group("3.5.0 L4: a shared input's first walk leaves the memo room");
# R4-SYM N1, SYM5: {y -> sin^L(z)} on y doubled 60 builds L + 1 nodes at every plain visit of y,
# and at L = 300 the plain walk spent the 2 GiB meter before the memo walk began: 0 (3.4.2: 3.9 s,
# 2 GiB). The plain walk stops at a 32nd of the meter now. The answer is y doubled 60 with each y
# replaced: its value is sin^300(1) x 2^60, the oracle sin^300(z) evaluated alone, times 2^60.
# [measured: scratch probe r12_2_300.cyr, the 3.4.2 tree (refused, 2,147,483,792 bytes) and lane L4's, 2026-11-14]
var _v35L4_zs = str_from("z");
var _v35L4_sp = pat_var(_v35L4_zs);
var _v35L4_se = expr_var(_v35L4_zs);
for (var i = 0; i < 300; i = i + 1) {
    _v35L4_sp = pat_sin(_v35L4_sp);
    _v35L4_se = expr_sin(_v35L4_se);
}
var _v35L4_yr = vec_new();
vec_push(_v35L4_yr, sym_rule(pat_var(str_from("y")), _v35L4_sp));
var _v35L4_y60 = sym_rewrite(_v35L4_edbl(_v35L4_y, 60), _v35L4_yr);
assert_neq(_v35L4_y60, 0, "{y -> sin^300(z)} on y doubled 60 answers (3.4.2: 0 after 2 GiB)");
var _v35L4_vz = vec_new();
vec_push(_v35L4_vz, expr_bind(_v35L4_zs, F64_ONE));
var _v35L4_y6t, _v35L4_y6v = expr_eval_checked(_v35L4_y60, _v35L4_vz);
var _v35L4_zst, _v35L4_zsv = expr_eval_checked(_v35L4_se, _v35L4_vz);
assert_eq(_v35L4_y6v, f64_mul(_v35L4_zsv, 0x43B0_0000_0000_0000), "... and its value is sin^300(1) x 2^60");
# The same under 300 negations, so that the plain walk reaches y past 256 levels, iteratively.
var _v35L4_n60 = _v35L4_edbl(_v35L4_y, 60);
for (var i = 0; i < 300; i = i + 1) { _v35L4_n60 = expr_neg(_v35L4_n60); }
var _v35L4_n6r = sym_rewrite(_v35L4_n60, _v35L4_yr);
assert_neq(_v35L4_n6r, 0, "... under 300 negations it answers too, the deep plain walk stopped");
var _v35L4_n6t, _v35L4_n6v = expr_eval_checked(_v35L4_n6r, _v35L4_vz);
assert_eq(_v35L4_n6v, _v35L4_y6v, "... with the same value, an even number of negations");

# ==================================================================================================
# 3.5.0 — ODEs, optimisation, splines, number theory (ode, optimize, calc_ext, num_ext)
# ==================================================================================================
# (Written as tests/v35_L5.tcyr; every global and fn below is prefixed _v35L5_.)

var _V35L5_QNAN = 0x7FF8000000000000;
var _v35L5_calls = 0;

# === K003: the DFT cap is an enum member, and the routing tests lower it through a seam ===
test_group("3.5.0 L5: _NUMX_DFT_MAX is an enum member, lowered only through the seam");
assert_eq(_NUMX_DFT_MAX, 1048576, "_NUMX_DFT_MAX = 2^20, as the var held");
assert_eq(_numx_capped_at(17, 16), 1, "_numx_capped_at(17, 16): past the cap, not a power of two -> capped");
assert_eq(_numx_capped_at(16, 16), 0, "_numx_capped_at(16, 16): at the cap -> not capped");
assert_eq(_numx_capped_at(48, 16), 1, "_numx_capped_at(48, 16) -> capped");
assert_eq(_numx_capped_at(64, 16), 0, "_numx_capped_at(64, 16): a power of two is never capped");
assert_eq(_numx_bluestein_capped(0x100001), _numx_capped_at(0x100001, _NUMX_DFT_MAX),
  "_numx_bluestein_capped is the seam at _NUMX_DFT_MAX");
assert_eq(_numx_capped_at(24, 24), 0, "_numx_capped_at(24, 24): at the cap, not a power of two -> not capped");
assert_eq(_numx_capped_at(25, 24), 1, "_numx_capped_at(25, 24): one past the cap -> capped");
assert_eq(_numx_bluestein_capped(0xFFFFF), 0, "_numx_bluestein_capped(2^20 - 1): under the enum's cap -> not capped");

# === row 13: num_mobius_checked ===
test_group("3.5.0 L5: num_mobius_checked refuses n <= 0");
var _v35L5_mz_t, _v35L5_mz_v = num_mobius_checked(0);
assert_eq(is_err_result(_v35L5_mz_t), 1, "num_mobius_checked(0) is an Err (num_mobius: 0, mu of a square)");
assert_eq(_v35L5_mz_v, HSB_ERR_INVALID_INPUT, "num_mobius_checked(0) -> HSB_ERR_INVALID_INPUT");
var _v35L5_mn_t, _v35L5_mn_v = num_mobius_checked(0 - 1);
assert_eq(is_err_result(_v35L5_mn_t), 1, "num_mobius_checked(-1) is an Err");
var _v35L5_m1_t, _v35L5_m1_v = num_mobius_checked(1);
assert_eq(is_ok(_v35L5_m1_t), 1, "num_mobius_checked(1) is Ok, the boundary's other side");
assert_eq(_v35L5_m1_v, 1, "num_mobius_checked(1) = Ok(1)");
var _v35L5_m4_t, _v35L5_m4_v = num_mobius_checked(4);
assert_eq(is_ok(_v35L5_m4_t), 1, "num_mobius_checked(4) is Ok: 0 is an answer here");
assert_eq(_v35L5_m4_v, 0, "num_mobius_checked(4) = Ok(0), a squared factor");
var _v35L5_m30_t, _v35L5_m30_v = num_mobius_checked(30);
assert_eq(_v35L5_m30_v, 0 - 1, "num_mobius_checked(30) = Ok(-1), three primes");
var _v35L5_m6_t, _v35L5_m6_v = num_mobius_checked(6);
assert_eq(_v35L5_m6_v, 1, "num_mobius_checked(6) = Ok(1), two primes");

# === row 13: num_halton's base refusal ===
test_group("3.5.0 L5: num_halton refuses a base below 2 with NaN");
assert_eq(num_halton(0, 1), _V35L5_QNAN, "num_halton(0, 1) -> quiet NaN (3.4.2: 0.0, index 0's sample)");
assert_eq(num_halton(3, 0), _V35L5_QNAN, "num_halton(3, 0) -> quiet NaN (3.4.2: 0.0)");
assert_eq(num_halton(3, 0 - 7), _V35L5_QNAN, "num_halton(3, -7) -> quiet NaN (3.4.2: 0.0)");
assert_eq(num_halton(0, 2), 0, "num_halton(0, 2) = 0.0, base 2 is the boundary's other side");
assert_eq(num_halton(5, 2), 0x3FE4000000000000, "num_halton(5, 2) = 0.625, unchanged");

# === row 11: ode_dopri45_trajectory refuses a NaN or infinite y0 ===
fn _v35L5_neg10(t, y) {
    _v35L5_calls = _v35L5_calls + 1;
    return f64_mul(0xC024000000000000, y);   # -10.0 y
}
fn _v35L5_one(t, y) {
    _v35L5_calls = _v35L5_calls + 1;
    return F64_ONE;
}
test_group("3.5.0 L5: ode_dopri45_trajectory refuses a NaN or infinite y0");
var _v35L5_dts = vec_new();
var _v35L5_dys = vec_new();
_v35L5_calls = 0;
var _v35L5_dn_t, _v35L5_dn_v = ode_dopri45_trajectory(&_v35L5_neg10, 0, _V35L5_QNAN, F64_ONE,
  0x3FB999999999999A, 0x3E45798EE2308C3A, _v35L5_dts, _v35L5_dys);
assert_eq(_v35L5_dn_v, HSB_ERR_INVALID_INPUT, "NaN y0 -> Err(INVALID_INPUT) (3.4.2: NO_CONVERGENCE)");
assert_eq(vec_len(_v35L5_dts), 0, "NaN y0: nothing pushed to ts (3.4.2: the one point)");
assert_eq(vec_len(_v35L5_dys), 0, "NaN y0: nothing pushed to ys");
assert_eq(_v35L5_calls, 0, "NaN y0: f never called");
var _v35L5_dts2 = vec_new();
var _v35L5_dys2 = vec_new();
var _v35L5_di_t, _v35L5_di_v = ode_dopri45_trajectory(&_v35L5_neg10, 0, F64_ONE, 0,
  0x3FB999999999999A, 0x3E45798EE2308C3A, _v35L5_dts2, _v35L5_dys2);
assert_eq(is_ok(_v35L5_di_t), 1, "y0 = 1, tf = t0: Ok, the guard is on a non-finite y0 alone");
assert_eq(vec_len(_v35L5_dys2), 1, "y0 = 1, tf = t0: the one initial point");
# An infinite y0: y' = -10y from +Inf (3.4.2: NO_CONVERGENCE after 3,234 calls of f, the one point pushed) and
# y' = 1 from -Inf (3.4.2: Ok on four points of -Inf). A finite y0 whose f overflows is still integrated.
# [measured: scratch probe (scratch_L5 p/dp.cyr), 3.4.2 and this tree, 2026-11-14]
var _v35L5_dts3 = vec_new();
var _v35L5_dys3 = vec_new();
_v35L5_calls = 0;
var _v35L5_dp_t, _v35L5_dp_v = ode_dopri45_trajectory(&_v35L5_neg10, 0, F64_POS_INF, F64_ONE,
  0x3FB999999999999A, 0x3E45798EE2308C3A, _v35L5_dts3, _v35L5_dys3);
assert_eq(_v35L5_dp_v, HSB_ERR_INVALID_INPUT, "y0 = +Inf -> Err(INVALID_INPUT) (3.4.2: NO_CONVERGENCE, 3,234 calls)");
assert_eq(vec_len(_v35L5_dts3) + vec_len(_v35L5_dys3), 0, "y0 = +Inf: nothing pushed (3.4.2: the one point)");
assert_eq(_v35L5_calls, 0, "y0 = +Inf: f never called (3.4.2: 3,234 calls)");
_v35L5_calls = 0;
var _v35L5_dm_t, _v35L5_dm_v = ode_dopri45_trajectory(&_v35L5_one, 0, 0xFFF0000000000000, F64_ONE,
  0x3FB999999999999A, 0x3E45798EE2308C3A, _v35L5_dts3, _v35L5_dys3);
assert_eq(_v35L5_dm_v, HSB_ERR_INVALID_INPUT,
  "y' = 1 from -Inf -> Err(INVALID_INPUT) (3.4.2: Ok, four points of -Inf)");
assert_eq(vec_len(_v35L5_dys3) + _v35L5_calls, 0, "y' = 1 from -Inf: nothing pushed, f never called");
_v35L5_calls = 0;
var _v35L5_dx_t, _v35L5_dx_v = ode_dopri45_trajectory(&_v35L5_neg10, 0, 0x7FEFFFFFFFFFFFFF, F64_ONE,
  0x3FB999999999999A, 0x3E45798EE2308C3A, _v35L5_dts3, _v35L5_dys3);
assert_eq(_v35L5_dx_v, HSB_ERR_NO_CONVERGENCE,
  "y' = -10y from DBL_MAX: integrated, f overflows -> NO_CONVERGENCE (control)");
assert_eq(vec_len(_v35L5_dys3), 1, "y' = -10y from DBL_MAX: the initial point pushed (control: a finite y0 is tried)");

# === row 12: ode_bdf_checked refuses a 0 history ===
test_group("3.5.0 L5: ode_bdf_checked refuses a 0 history");
var _v35L5_bo = alloc(8);
store64(_v35L5_bo, 0x7FF4000000000001);
_v35L5_calls = 0;
var _v35L5_b0_t, _v35L5_b0_v = ode_bdf_checked(&_v35L5_neg10, 0, 0, 2, 0x3FB999999999999A, 0x3E45798EE2308C3A,
  _v35L5_bo);
assert_eq(_v35L5_b0_v, HSB_ERR_INVALID_INPUT, "ode_bdf_checked(f, 0, 0, 2, h, tol, out) -> INVALID_INPUT (3.4.2: 139)");
assert_eq(load64(_v35L5_bo), 0x7FF4000000000001, "a 0 history: out untouched");
assert_eq(_v35L5_calls, 0, "a 0 history: f never called");
var _v35L5_bh = vec_new();
vec_push(_v35L5_bh, F64_ONE);
vec_push(_v35L5_bh, F64_ONE);
var _v35L5_b1_t, _v35L5_b1_v = ode_bdf_checked(&_v35L5_neg10, 0, _v35L5_bh, 2, 0x3FB999999999999A,
  0x3E45798EE2308C3A, _v35L5_bo);
assert_eq(is_ok(_v35L5_b1_t), 1, "a real history of 1, 1: Ok");
# === row 10: calc_bspline / calc_nurbs keep their de Boor scratch on the stack ===
test_group("3.5.0 L5: calc_bspline / calc_nurbs take only their result from the heap");
# P_i = (i, i^2, 1 - i), unit weights, uniform knots 0, 1, 2, ...: a uniform B-spline reproduces a
# linear function through its Greville abscissae i + (d + 1)/2, so x(t) = t - (d + 1)/2 exactly in
# reals. Degrees 3, 15 / 16 (NURBS) and 20 / 21 (B-spline) sit on each side of the stack bound, 64
# doubles: 3 (d + 1) for the B-spline, 4 (d + 1) for NURBS.
var _v35L5_sp_pts = alloc(24 * 8);
var _v35L5_sp_w = alloc(24 * 8);
var _v35L5_sp_kn = alloc(48 * 8);
for (var _v35L5_si = 0; _v35L5_si < 24; _v35L5_si = _v35L5_si + 1) {
    store64(_v35L5_sp_pts + _v35L5_si * 8,
      hvec3_new(f64_from(_v35L5_si), f64_from(_v35L5_si * _v35L5_si), f64_from(1 - _v35L5_si)));
    store64(_v35L5_sp_w + _v35L5_si * 8, F64_ONE);
}
for (var _v35L5_sk = 0; _v35L5_sk < 48; _v35L5_sk = _v35L5_sk + 1) {
    store64(_v35L5_sp_kn + _v35L5_sk * 8, f64_from(_v35L5_sk));
}
fn _v35L5_bsp(d, t) { return calc_bspline(d, _v35L5_sp_pts, d + 1, _v35L5_sp_kn, 2 * d + 2, t); }
fn _v35L5_nrb(d, t) { return calc_nurbs(d, _v35L5_sp_pts, _v35L5_sp_w, d + 1, _v35L5_sp_kn, 2 * d + 2, t); }
# The heap a call takes: its 24-byte result, and no scratch up to the bound.
var _v35L5_u0 = alloc_used();
var _v35L5_b3 = _v35L5_bsp(3, 0x400C000000000000);                  # t = 3.5
var _v35L5_u1 = alloc_used();
var _v35L5_n3 = _v35L5_nrb(3, 0x400C000000000000);
var _v35L5_u2 = alloc_used();
assert_eq(_v35L5_u1 - _v35L5_u0, 24, "calc_bspline degree 3: 24 bytes of heap, the result (3.4.2: 120)");
assert_eq(_v35L5_u2 - _v35L5_u1, 24, "calc_nurbs degree 3: 24 bytes of heap, the result (3.4.2: 152)");
assert_eq(HVec3_x(_v35L5_b3), 0x3FF8000000000000, "calc_bspline degree 3 at 3.5: x = 1.5");
assert_eq(HVec3_x(_v35L5_n3), 0x3FF8000000000000, "calc_nurbs degree 3 at 3.5: x = 1.5");
assert_eq(HVec3_z(_v35L5_b3), 0xBFE0000000000000, "calc_bspline degree 3 at 3.5: z = 1 - x = -0.5");
assert_eq(HVec3_z(_v35L5_n3), 0xBFE0000000000000, "calc_nurbs degree 3 at 3.5: z = 1 - x = -0.5");
# The bound, with the heap held to the result's 24 bytes: the stack sides answer, the heap sides refuse.
var _v35L5_b20f = _v35L5_bsp(20, 0x4034800000000000);               # t = 20.5, x = 10
var _v35L5_n15f = _v35L5_nrb(15, 0x402F000000000000);               # t = 15.5, x = 7.5
var _v35L5_b21f = _v35L5_bsp(21, 0x4035800000000000);               # t = 21.5, x = 10.5
var _v35L5_n16f = _v35L5_nrb(16, 0x4030800000000000);               # t = 16.5, x = 8
var _v35L5_akeep = ALLOC_MAX;
ALLOC_MAX = 24;
var _v35L5_b20 = _v35L5_bsp(20, 0x4034800000000000);
var _v35L5_n15 = _v35L5_nrb(15, 0x402F000000000000);
var _v35L5_b21 = _v35L5_bsp(21, 0x4035800000000000);
var _v35L5_n16 = _v35L5_nrb(16, 0x4030800000000000);
ALLOC_MAX = _v35L5_akeep;
assert_eq(HVec3_x(_v35L5_b20f), 0x4024000000000000, "calc_bspline degree 20 at 20.5: x = 10 (t - 21/2)");
assert_eq(HVec3_x(_v35L5_n15f), 0x401E000000000000, "calc_nurbs degree 15 at 15.5: x = 7.5 (t - 8)");
assert_eq(HVec3_x(_v35L5_b21f), 0x4025000000000000, "calc_bspline degree 21 at 21.5: x = 10.5 (t - 11)");
assert_eq(HVec3_x(_v35L5_n16f), 0x4020000000000000, "calc_nurbs degree 16 at 16.5: x = 8 (t - 17/2)");
assert_eq(HVec3_x(_v35L5_b20), HVec3_x(_v35L5_b20f), "calc_bspline degree 20, heap of 24 bytes: the same x (stack)");
assert_eq(HVec3_y(_v35L5_b20), HVec3_y(_v35L5_b20f), "calc_bspline degree 20, heap of 24 bytes: the same y");
# y = sum N_i i^2 = (t - (d + 1)/2)^2 + (d + 1)/12 for uniform knots: exactly 101.75 at d = 20, t = 20.5;
# de Boor's rounding leaves 2 ulps above it, 3.4.2's bits.
assert_eq(HVec3_y(_v35L5_b20f), 0x4059700000000002, "calc_bspline degree 20 at 20.5: y = 101.75 + 2 ulps");
assert_eq(HVec3_z(_v35L5_b20f), 0xC022000000000000, "calc_bspline degree 20 at 20.5: z = 1 - x = -9");
assert_eq(HVec3_z(_v35L5_n15f), 0xC01A000000000000, "calc_nurbs degree 15 at 15.5: z = 1 - x = -6.5");
assert_eq(HVec3_x(_v35L5_n15), HVec3_x(_v35L5_n15f), "calc_nurbs degree 15, heap of 24 bytes: the same x (stack)");
assert_eq(HVec3_y(_v35L5_n15), HVec3_y(_v35L5_n15f), "calc_nurbs degree 15, heap of 24 bytes: the same y");
assert_eq(_v35L5_b21, 0, "calc_bspline degree 21, heap of 24 bytes: the scratch is the heap's, refused -> 0");
assert_eq(_v35L5_n16, 0, "calc_nurbs degree 16, heap of 24 bytes: the scratch is the heap's, refused -> 0");

# === row 2: Newton's answer carries the branch certificate ===
test_group("3.5.0 L5: Newton's answer carries the branch certificate");
# The 3.4.1 NUM3 fixtures at max_newton 50, where Newton itself converges. Robertson's y2 by backward
# Euler: the step's quadratic has the roots +3.9076935786965366e-5 (the branch's) and -7.5416e-5 (exact,
# Fractions); Van der Pol mu = 100: the cubic's roots -1.324398597546027 (the branch's) and +1.79539.
# 3.4.2 returned Newton's roots, -7.54e-5 (0xBF13C516D5CA17DB) and +1.7954 (0x3FFCB9E8C37474AC).
# [measured: scratch probes (scratch_L5 p/ode1.cyr, rv.py: Fractions, 60-digit Decimal), 3.4.2 and L5, 2026-11-14]
var _v35L5_N = 0;
var _v35L5_P1 = 0;
var _v35L5_P2 = 0;
fn _v35L5_rob(t, y) {
    _v35L5_N = _v35L5_N + 1;
    return f64_sub(f64_sub(f64_mul(0x3FA47AE147AE147B, _v35L5_P1), f64_mul(0x40C3880000000000, f64_mul(y, _v35L5_P2))),
      f64_mul(0x417C9C3800000000, f64_mul(y, y)));
}
fn _v35L5_vdp(t, y) {
    _v35L5_N = _v35L5_N + 1;
    return f64_mul(_v35L5_P1, f64_add(f64_sub(_v35L5_P2, f64_div(f64_mul(y, f64_mul(y, y)), 0x4008000000000000)), y));
}
fn _v35L5_neg(t, y) {
    _v35L5_N = _v35L5_N + 1;
    return f64_neg(y);
}
var _v35L5_oo = alloc(8);
_v35L5_P1 = 0x3FDB4410A6615477;
_v35L5_P2 = 0x3EF35AD52EB6922E;
_v35L5_N = 0;
var _v35L5_rt, _v35L5_rv = ode_backward_euler_checked(&_v35L5_rob, f64_neg(0x3F4E10099CCEE204), 0x3F112A1D023252B8,
  0x3F4E10099CCEE204, 0x3C912A1D023252B8, 50, _v35L5_oo);
assert_eq(is_ok(_v35L5_rt), 1, "backward Euler: Robertson, max_newton 50 -> Ok (precondition; 3.4.2 Ok too)");
assert_eq(load64(_v35L5_oo), 0x3F047CD14A347ACC,
  "backward Euler: Robertson -> +3.9077e-5, the branch root (3.4.2: Newton's -7.54e-5, a negative concentration)");
assert_eq(f64_lt(0, load64(_v35L5_oo)), 1, "backward Euler: Robertson -> a positive concentration");
# 3.5.0 W5: 139 -> 129, Newton's answer refused by the slope, not the samples [measured: tests/modules_d.tcyr, below].
assert_eq(_v35L5_N, 129, "backward Euler: Robertson -> 129 evaluations (3.4.2: 14; refused, then continued)");
_v35L5_P1 = 0x4059000000000000;
_v35L5_P2 = 0x3FE319DB165F3644;
_v35L5_N = 0;
var _v35L5_vt, _v35L5_vv = ode_backward_euler_checked(&_v35L5_vdp, f64_sub(0x4018B9F2EDA71EC8, 0x3FB32EC8E140063D),
  0xBFFACEC708CEF99E, 0x3FB32EC8E140063D, 0x3DDB7CDFD9D7BDBB, 50, _v35L5_oo);
assert_eq(is_ok(_v35L5_vt), 1, "backward Euler: Van der Pol mu 100, max_newton 50 -> Ok");
assert_eq(load64(_v35L5_oo), 0xBFF530BC9574CED8,
  "backward Euler: Van der Pol -> -1.32440, the branch root (3.4.2: Newton's +1.7954, across the cycle)");
# The branch root is -1.324398597546027 (exact); tol 1e-10 over g' = 6.65 allows 1.5e-11 of it.
assert_eq(f64_lt(f64_abs(f64_sub(load64(_v35L5_oo), 0xBFF530BC95754157)), 0x3DB07E1FE91B0B70), 1,
  "backward Euler: Van der Pol -> within 1.5e-11 of the exact branch root");
# 3.5.0 W5: 130 -> 134, the slope read at the answer (_ode_zslope: two secants), twice
# [measured: tests/modules_d.tcyr, below].
assert_eq(_v35L5_N, 134, "backward Euler: Van der Pol -> 134 evaluations (3.4.2: 10)");
# y' = -y at dt 0.1 from 1, tol 1e-12: Newton's 1/1.1 on the branch, its 4 evaluations and the 63 of the
# certificate.
_v35L5_N = 0;
var _v35L5_nt, _v35L5_nv = ode_backward_euler_checked(&_v35L5_neg, 0, F64_ONE, 0x3FB999999999999A,
  0x3D719799812DEA11, 50, _v35L5_oo);
assert_eq(load64(_v35L5_oo), 0x3FED1745D1745D18, "backward Euler: y' = -y -> 1/1.1, Newton's bits (3.4.2: the same)");
# 3.5.0 W5: 67 -> 69, the slope read at the answer (_ode_zslope: two secants).
assert_eq(_v35L5_N, 69, "backward Euler: y' = -y -> 69 evaluations: Newton's 4 and the certificate's 65 (3.4.2: 4)");
# BDF-2 on Robertson's equation from the same state (y_prev = y): its branch root is positive too.
_v35L5_P1 = 0x3FDB4410A6615477;
_v35L5_P2 = 0x3EF35AD52EB6922E;
_v35L5_N = 0;
var _v35L5_bt, _v35L5_bv = ode_bdf2_checked(&_v35L5_rob, 0x3F4E10099CCEE204, 0x3F112A1D023252B8, 0x3F112A1D023252B8,
  0x3F4E10099CCEE204, 0x3C912A1D023252B8, _v35L5_oo);
assert_eq(is_ok(_v35L5_bt), 1, "bdf2: Robertson -> Ok (control: 3.4.2 Ok too)");
assert_eq(load64(_v35L5_oo), 0x3F065581916CC1A3, "bdf2: Robertson -> Newton's positive root, 3.4.2's bits (control)");
# 3.5.0 W5: 72 -> 74, the slope read at the answer (_ode_zslope: two secants).
assert_eq(_v35L5_N, 74, "bdf2: Robertson -> 74 evaluations: Newton's 9, the certificate's 65 (3.4.2: 9)");

# BDF-2 on A sin(B y) + D (a step of the 6,000-step oracle set): Newton from the predictor reached
# -0.6056 (0xBFE361386CEDEAB1), another root; the branch root is -1.179796755447155 (dense sigma scan,
# refined in 60-digit Decimal), whose nearest double is the answer now.
# [measured: scratch harness (scratch_L5 p/odeset.cyr, oracle.py, pick.py), 3.4.2 and L5, 2026-11-14]
var _v35L5_SA = 0;
var _v35L5_SB = 0;
var _v35L5_SD = 0;
fn _v35L5_sin(t, y) {
    _v35L5_N = _v35L5_N + 1;
    return f64_add(f64_mul(_v35L5_SA, f64_sin(f64_mul(_v35L5_SB, y))), _v35L5_SD);
}
_v35L5_SA = 0xC04F2DA9AB93E5C1;
_v35L5_SB = 0x40258EB2008A9029;
_v35L5_SD = 0xC0203CF3897BF928;
var _v35L5_st, _v35L5_sv = ode_bdf2_checked(&_v35L5_sin, 0x3FC32161DD7CEB68, 0xBFF4B9B694F1447E, 0xBFF471D5D37D2E56,
  0x3FC32161DD7CEB68, 0x3D719799812DEA11, _v35L5_oo);
assert_eq(is_ok(_v35L5_st), 1, "bdf2: A sin(B y) + D -> Ok");
assert_eq(load64(_v35L5_oo), 0xBFF2E072900928B7, "bdf2: A sin(B y) + D -> -1.1798, the branch root (3.4.2: -0.6056)");
# A second step of a sin set (seed 11, step 1116): Newton reached 1.947 (0x3FFF2764B2473D6D), another root;
# the branch root is 1.47846 (scan of sigma at 400,000 points, refined in 70-digit Decimal). The certificate
# reads sigma at the step's own c = beta dt: read at dt it refuses Newton's root four samples later.
# [measured: scratch harness (scratch_L5 p/oh.cyr, gensin.py, sinorc.py), 3.4.2 and this tree, 2026-11-14]
_v35L5_SA = 0xC01030072F9F4132;
_v35L5_SB = 0x4022E95840EE3A57;
_v35L5_SD = 0x401F18592081B7D8;
_v35L5_N = 0;
var _v35L5_s2t, _v35L5_s2v = ode_bdf2_checked(&_v35L5_sin, 0, 0x3FF297EFD0332BFA, 0x3FF24717D60501C1,
  0x3FBF7F355976E85C, 0x3E45798EE2308C3A, _v35L5_oo);
assert_eq(load64(_v35L5_oo), 0x3FF7A7C39CEA5DA4, "bdf2: a second sin step -> 1.47846, the branch root (3.4.2: 1.947)");
# 3.5.0 W5: 151 -> 155, the slope read at the answer (_ode_zslope: two secants), twice
# [measured: tests/modules_d.tcyr, below].
assert_eq(_v35L5_N, 155, "bdf2: a second sin step -> 155 evaluations (3.4.2: 9; the certificate read at dt: 159)");
# The certificate reads f at the step's own time, t + dt for backward Euler. f below is 20 up to t = 1/2 and
# 0.1 y^2 - 0.1 y + 1 after, so the step from y = 0 at t = 0, dt = 1, has the equation z = 0.1 z^2 - 0.1 z + 1
# with the roots 1 (the branch's: sigma = z / f(z) rises from 0 to 1 there) and 10. The predictor, which
# reads f at t, starts Newton at 20, and Newton reaches 10. Read at t, sigma = z / 20 rises to 1/2 and
# passes 10; read at t + dt it refuses 10, and the continuation answers 1.
fn _v35L5_sw(t, y) {
    _v35L5_N = _v35L5_N + 1;
    if (f64_lt(F64_HALF, t) == 1) {
        return f64_add(f64_sub(f64_mul(0x3FB999999999999A, f64_mul(y, y)), f64_mul(0x3FB999999999999A, y)), F64_ONE);
    }
    return 0x4034000000000000;
}
_v35L5_N = 0;
var _v35L5_swt, _v35L5_swv = ode_backward_euler_checked(&_v35L5_sw, 0, 0, F64_ONE, 0x3D719799812DEA11, 50, _v35L5_oo);
assert_eq(is_ok(_v35L5_swt), 1, "backward Euler: f switching at t = 1/2 -> Ok");
assert_eq(load64(_v35L5_oo), F64_ONE,
  "backward Euler: f switching at t = 1/2 -> 1, the branch root (3.4.2: Newton's 10)");
# 3.5.0 W5: 89 -> 85, Newton's answer refused by the slope, not the samples.
assert_eq(_v35L5_N, 85, "backward Euler: f switching at t = 1/2 -> 85 evaluations (3.4.2: 14)");

# === row 2 (review): Newton's answer near an equilibrium keeps 3.4.2's bits ===
test_group("3.5.0 L5: Newton's answer near an equilibrium keeps 3.4.2's bits");
# y' = -(y - 1e5) from 1e5 - 40 ulps, tol 1e-12, under half an ulp of y: Newton's answer is the correctly
# rounded root (C - 39.6 ulps at dt 0.01, C - 36.36 at dt 0.1), and it is a move of 0 and of 4 ulps. Read at
# unrounded offsets, the certificate refused both (the first form: Err after 8 and 125 evaluations).
# [measured: scratch harness (scratch_L5 p/oh.cyr, gen1.py, orc.py: 70-digit Decimal), 3.4.2 and this tree, 2026-11-14]
var _v35L5_LA = 0;
var _v35L5_LC = 0;
fn _v35L5_lin(t, y) {
    _v35L5_N = _v35L5_N + 1;
    return f64_mul(_v35L5_LA, f64_sub(y, _v35L5_LC));
}
fn _v35L5_sq(t, y) {
    _v35L5_N = _v35L5_N + 1;
    return f64_sub(f64_mul(y, y), 0x412E848000000000);                 # y^2 - 1e6
}
_v35L5_LA = 0xBFF0000000000000;
_v35L5_LC = 0x40F86A0000000000;
_v35L5_N = 0;
var _v35L5_e1t, _v35L5_e1v = ode_backward_euler_checked(&_v35L5_lin, 0, 0x40F869FFFFFFFFD8, 0x3F847AE147AE147B,
  0x3D719799812DEA11, 50, _v35L5_oo);
assert_eq(is_ok(_v35L5_e1t), 1, "backward Euler: 1e5 - 40 ulps, dt 0.01 -> Ok (first form: NO_CONVERGENCE)");
assert_eq(load64(_v35L5_oo), 0x40F869FFFFFFFFD8, "backward Euler: ... dt 0.01 -> y itself, 3.4.2's bits");
# 3.5.0 W5: 2 -> 4, the slope read at the answer (_ode_zslope: two secants), z = y and f(y) != 0.
assert_eq(_v35L5_N, 4, "backward Euler: ... dt 0.01 -> 4 evaluations: Newton's 2; no move, the slope's 2");
_v35L5_N = 0;
var _v35L5_e2t, _v35L5_e2v = ode_backward_euler_checked(&_v35L5_lin, 0, 0x40F869FFFFFFFFD8, 0x3FB999999999999A,
  0x3D719799812DEA11, 50, _v35L5_oo);
assert_eq(is_ok(_v35L5_e2t), 1, "backward Euler: 1e5 - 40 ulps, dt 0.1 -> Ok (first form: NO_CONVERGENCE)");
assert_eq(load64(_v35L5_oo), 0x40F869FFFFFFFFDC, "backward Euler: ... dt 0.1 -> y + 4 ulps, 3.4.2's bits");
# 3.5.0 W5: 7 -> 9, the slope read at the answer (_ode_zslope: two secants).
assert_eq(_v35L5_N, 9, "backward Euler: ... dt 0.1 -> 9 evaluations: Newton's 2, f(y) once, the 4 doubles crossed");
_v35L5_N = 0;
var _v35L5_e3t, _v35L5_e3v = ode_bdf2_checked(&_v35L5_lin, 0, 0x40F869FFFFFFFFD8, 0x40F869FFFFFFFFD8,
  0x3F847AE147AE147B, 0x3D719799812DEA11, _v35L5_oo);
assert_eq(load64(_v35L5_oo), 0x40F869FFFFFFFFD8,
  "bdf2: 1e5 - 40 ulps, dt 0.01 -> the predictor, 3.4.2's bits (first form: Err)");
# 3.5.0 W5: 1 -> 3, the slope read at the answer (_ode_zslope: two secants), z = s and f(s) != 0.
assert_eq(_v35L5_N, 3, "bdf2: ... dt 0.01 -> Newton's 1 evaluation and the slope's 2");
# Unstable: y' = 0.7 (y - 1) from 1 - 17 ulps, dt 1, tol 2^-60. The move is 40 ulps away from 1, |f| grows
# along it, and a sigma read at unrounded offsets falls at each double; read at each double's own offset
# it rises. 3.4.2's answer, 1 - 56 ulps, is 0.67 ulp from the root, with the step's residual in doubles 0.
_v35L5_LA = 0x3FE6666666666666;
_v35L5_LC = F64_ONE;
_v35L5_N = 0;
var _v35L5_e4t, _v35L5_e4v = ode_backward_euler_checked(&_v35L5_lin, 0, 0x3FEFFFFFFFFFFFEF, F64_ONE, 0x3C30000000000000,
  50, _v35L5_oo);
assert_eq(is_ok(_v35L5_e4t), 1, "backward Euler: 0.7 (y - 1) from 1 - 17 ulps -> Ok (first form: NO_CONVERGENCE)");
assert_eq(load64(_v35L5_oo), 0x3FEFFFFFFFFFFFC8, "backward Euler: 0.7 (y - 1) -> 3.4.2's bits");
# 3.5.0 W5: 43 -> 45, the slope read at the answer (_ode_zslope: two secants).
assert_eq(_v35L5_N, 45, "backward Euler: 0.7 (y - 1) -> 45 evaluations (3.4.2: 4)");
# A move of one ulp has no double between y and the answer: the samples that round onto y read the branch's
# direction there. y' = y^2 - 1e6 from 1000 - 1 ulp, dt 0.01: c f(y) < 0, the branch goes down from y and
# folds (g' = 1 - 0.02 sigma z reaches 0 near sigma = 1/20); Newton's 1000 is one ulp up, on the far side.
_v35L5_N = 0;
var _v35L5_e5t, _v35L5_e5v = ode_backward_euler_checked(&_v35L5_sq, 0, 0x408F3FFFFFFFFFFF, 0x3F847AE147AE147B,
  0x3D719799812DEA11, 50, _v35L5_oo);
assert_eq(_v35L5_e5v, HSB_ERR_NO_CONVERGENCE,
  "backward Euler: y^2 - 1e6 from 1000 - 1 ulp -> NO_CONVERGENCE (3.4.2: Ok 1000)");
# The direction read at s, when it disagrees with the move: s must meet |g| < tol itself, and every sample
# after it is one past the root. f below is 2^-47 up to t = 1/20 and lam (y - 1) after: the predictor moves
# 3 ulps off 1, Newton's residual there is under tol at once, and 1 is the exact root, so c f(t + dt, 1) = 0
# reads no direction. lam = -1: sigma is -10 at every double, past the root, each within tol -> Newton's
# 1 + 3 ulps stands. lam = 20: sigma is 1/2, back below 1 after the read at s -> refused; the branch through
# s is z = 1 itself (s is a root at every sigma), and the continuation answers it.
# [measured: scratch probe (scratch_L5 p/dir.cyr), 3.4.2 and this tree, 2026-11-14]
var _v35L5_DL = 0;
fn _v35L5_dsw(t, y) {
    _v35L5_N = _v35L5_N + 1;
    if (f64_lt(0x3FA999999999999A, t) == 1) { return f64_mul(_v35L5_DL, f64_sub(y, F64_ONE)); }
    return 0x3D00000000000000;
}
_v35L5_DL = 0xBFF0000000000000;
_v35L5_N = 0;
var _v35L5_d1t, _v35L5_d1v = ode_backward_euler_checked(&_v35L5_dsw, 0, F64_ONE, 0x3FB999999999999A, 0x3D719799812DEA11,
  50, _v35L5_oo);
assert_eq(load64(_v35L5_oo), 0x3FF0000000000003,
  "backward Euler: no direction at s, s within tol -> Newton's 1 + 3 ulps");
# 3.5.0 W5: 6 -> 8, the slope read at the answer (_ode_zslope: two secants).
assert_eq(_v35L5_N, 8,
  "backward Euler: no direction at s -> 8 evaluations: Newton's 2, the slope's 2, f(s), 3 doubles (3.4.2: 2)");
_v35L5_DL = 0x4034000000000000;
_v35L5_N = 0;
var _v35L5_d2t, _v35L5_d2v = ode_backward_euler_checked(&_v35L5_dsw, 0, F64_ONE, 0x3FB999999999999A, 0x3D719799812DEA11,
  50, _v35L5_oo);
assert_eq(is_ok(_v35L5_d2t), 1, "backward Euler: no direction at s, sigma back below 1 -> Ok");
assert_eq(load64(_v35L5_oo), F64_ONE, "backward Euler: ... -> 1, the root on the branch (3.4.2: Newton's 1 + 3 ulps)");

# === row 4: opt_conjugate_gradient takes the quasi-Newton repairs ===
test_group("3.5.0 L5: opt_conjugate_gradient takes the quasi-Newton repairs");
var _v35L5_NG = 0;
var _v35L5_SH = 0;
var _v35L5_C = F64_ONE;
fn _v35L5_tf(x) {                                      # 1e12 + 1 - exp(-(x - SH)^2)
    var v = f64_sub(load64(x), _v35L5_SH);
    return f64_sub(f64_add(0x426D1A94A2000000, F64_ONE), f64_exp(f64_neg(f64_mul(v, v))));
}
fn _v35L5_tg(x, o) {
    _v35L5_NG = _v35L5_NG + 1;
    var v = f64_sub(load64(x), _v35L5_SH);
    store64(o, f64_mul(f64_mul(F64_TWO, v), f64_exp(f64_neg(f64_mul(v, v)))));
    return 0;
}
fn _v35L5_qf(x) {                                      # C ((x0 - 1.3)^2 + 10 (x1 - 2.7)^2)
    var a = f64_sub(load64(x), 0x3FF4CCCCCCCCCCCD);
    var b = f64_sub(load64(x + 8), 0x400599999999999A);
    return f64_mul(_v35L5_C, f64_add(f64_mul(a, a), f64_mul(0x4024000000000000, f64_mul(b, b))));
}
fn _v35L5_qg(x, o) {
    _v35L5_NG = _v35L5_NG + 1;
    store64(o, f64_mul(_v35L5_C, f64_mul(F64_TWO, f64_sub(load64(x), 0x3FF4CCCCCCCCCCCD))));
    store64(o + 8, f64_mul(_v35L5_C, f64_mul(0x4034000000000000, f64_sub(load64(x + 8), 0x400599999999999A))));
    return 0;
}
fn _v35L5_bf(x) { return f64_sub(load64(x), f64_ln(load64(x))); }          # x - ln x
fn _v35L5_bg(x, o) {
    _v35L5_NG = _v35L5_NG + 1;
    store64(o, f64_sub(F64_ONE, f64_div(F64_ONE, load64(x))));
    return 0;
}
var _v35L5_x0 = alloc(16);
var _v35L5_ox = alloc(16);
var _v35L5_of = alloc(8);
# The flat tail: from 1.5, tol 1e-8, the minimum at 0 (3.4.2: Ok at 0x40683B706DD79A05, 193.9).
store64(_v35L5_x0, 0x3FF8000000000000);
_v35L5_NG = 0;
var _v35L5_ct, _v35L5_cv = opt_conjugate_gradient(&_v35L5_tf, &_v35L5_tg, _v35L5_x0, 1, 0x3E45798EE2308C3A, 1000,
  _v35L5_ox, _v35L5_of);
assert_eq(is_ok(_v35L5_ct), 1, "cg: the flat tail from 1.5 -> Ok");
assert_eq(load64(_v35L5_ox), 0xBDE9DEC125B12000, "cg: the flat tail -> -1.2e-10, at the minimum (3.4.2: 193.9)");
assert_eq(f64_lt(f64_abs(load64(_v35L5_ox)), 0x3E112E0BE826D695), 1, "cg: the flat tail -> within 1e-9 of 0");
assert_eq(_v35L5_NG, 19, "cg: the flat tail -> 19 gradients (3.4.2: 23)");
# The same tail about 2^41 (3.4.2: Ok 204.6 past the minimum).
_v35L5_SH = 0x4260000000000000;
store64(_v35L5_x0, f64_add(_v35L5_SH, 0x3FF8000000000000));
var _v35L5_c2t, _v35L5_c2v = opt_conjugate_gradient(&_v35L5_tf, &_v35L5_tg, _v35L5_x0, 1, 0x3E45798EE2308C3A, 1000,
  _v35L5_ox, _v35L5_of);
assert_eq(is_ok(_v35L5_c2t), 1, "cg: the tail about 2^41 -> Ok");
assert_eq(load64(_v35L5_ox), _v35L5_SH, "cg: the tail about 2^41 -> 2^41 exactly, the minimum (3.4.2: 2^41 + 204.6)");
_v35L5_SH = 0;
# The objective-scaled quadratic, c = 2^-1000, 2^-990, ..., 2^1000 from (0, 0), tol c 1e-10: Ok within 1e-9 of
# (1.3, 2.7) at every scale (3.4.2: 153 of 201), and no Ok anywhere else.
# [measured: scratch probe (scratch_L5 p/cg.cyr), 3.4.2 and L5, 2026-11-14]
var _v35L5_qok = 0;
var _v35L5_qbad = 0;
for (var _v35L5_e = 0 - 1000; _v35L5_e <= 1000; _v35L5_e = _v35L5_e + 10) {
    var _v35L5_k1 = _v35L5_e / 2;
    _v35L5_C = f64_mul((1023 + _v35L5_k1) << 52, (1023 + _v35L5_e - _v35L5_k1) << 52);
    store64(_v35L5_x0, 0);
    store64(_v35L5_x0 + 8, 0);
    var _v35L5_qt, _v35L5_qv = opt_conjugate_gradient(&_v35L5_qf, &_v35L5_qg, _v35L5_x0, 2,
      f64_mul(_v35L5_C, 0x3DDB7CDFD9D7BDBB), 2000, _v35L5_ox, _v35L5_of);
    var _v35L5_dx = f64_abs(f64_sub(load64(_v35L5_ox), 0x3FF4CCCCCCCCCCCD));
    var _v35L5_dy = f64_abs(f64_sub(load64(_v35L5_ox + 8), 0x400599999999999A));
    if (is_ok(_v35L5_qt) == 1) {
        if (f64_lt(_v35L5_dx, 0x3E112E0BE826D695) == 1 && f64_lt(_v35L5_dy, 0x3E112E0BE826D695) == 1) {
            _v35L5_qok = _v35L5_qok + 1;
        } else {
            _v35L5_qbad = _v35L5_qbad + 1;
        }
    }
}
_v35L5_C = F64_ONE;
assert_eq(_v35L5_qok, 201, "cg: the scaled quadratic -> Ok at the minimiser at 201 of 201 scales (3.4.2: 153)");
assert_eq(_v35L5_qbad, 0, "cg: the objective-scaled quadratic -> no Ok away from the minimiser");
# x - ln x from 2^41 + 3, tol 1e-14: the first trial from _opt_qn_first is 2^41 long and its point is
# not in the domain; the back-off past the trial cap reaches the minimum (without it NO_CONVERGENCE at 2).
store64(_v35L5_x0, 0x4260000000000018);
_v35L5_NG = 0;
var _v35L5_lt, _v35L5_lv = opt_conjugate_gradient(&_v35L5_bf, &_v35L5_bg, _v35L5_x0, 1, 0x3D06849B86A12B9B, 2000,
  _v35L5_ox, _v35L5_of);
assert_eq(is_ok(_v35L5_lt), 1, "cg: x - ln x from 2^41 + 3 -> Ok");
assert_eq(load64(_v35L5_ox), F64_ONE, "cg: x - ln x from 2^41 + 3 -> 1 exactly (3.4.2: 1 + 2^-52)");
assert_eq(_v35L5_NG, 89, "cg: x - ln x from 2^41 + 3 -> 89 gradients (3.4.2: 121)");

# The longer length (a1) on the first trial: 1e15 + cosh(x) from 2, tol 1e-8, extrapolates to it.
fn _v35L5_hf(x) { return f64_add(0x430C6BF526340000, f64_cosh(load64(x))); }
fn _v35L5_hg(x, o) {
    _v35L5_NG = _v35L5_NG + 1;
    store64(o, f64_sinh(load64(x)));
    return 0;
}
store64(_v35L5_x0, F64_TWO);
_v35L5_NG = 0;
var _v35L5_ht, _v35L5_hv = opt_conjugate_gradient(&_v35L5_hf, &_v35L5_hg, _v35L5_x0, 1, 0x3E45798EE2308C3A, 2000,
  _v35L5_ox, _v35L5_of);
assert_eq(is_ok(_v35L5_ht), 1, "cg: 1e15 + cosh(x) from 2 -> Ok");
assert_eq(f64_lt(f64_abs(load64(_v35L5_ox)), 0x3E45798EE2308C3A), 1, "cg: 1e15 + cosh(x) from 2 -> within 1e-8 of 0");
assert_eq(_v35L5_NG, 42, "cg: 1e15 + cosh(x) from 2 -> 42 gradients (3.4.2: 83; without the longer length: 249)");
# The back-off past the trial cap: f = 2^700 + (x - 1)^2 below x = 2 and NaN (f and g) from 2, from 0, tol
# 1e-8. The first trial, 4 |f| / |g| = 2^701 long, lands far inside the NaN; 40 trials do not reach x < 2.
# The cost of the scale-free trial is plain here: 3.4.2's unit trial took 3 gradients.
fn _v35L5_wf(x) {
    var v = load64(x);
    if (f64_lt(v, F64_TWO) == 0) { return 0x7FF8000000000000; }
    var u = f64_sub(v, F64_ONE);
    return f64_add(0x6BB0000000000000, f64_mul(u, u));                   # 2^700 + (x - 1)^2
}
fn _v35L5_wg(x, o) {
    _v35L5_NG = _v35L5_NG + 1;
    var v = load64(x);
    if (f64_lt(v, F64_TWO) == 0) {
        store64(o, 0x7FF8000000000000);
        return 0;
    }
    store64(o, f64_mul(F64_TWO, f64_sub(v, F64_ONE)));
    return 0;
}
store64(_v35L5_x0, 0);
_v35L5_NG = 0;
var _v35L5_wt, _v35L5_wv = opt_conjugate_gradient(&_v35L5_wf, &_v35L5_wg, _v35L5_x0, 1, 0x3E45798EE2308C3A, 100,
  _v35L5_ox, _v35L5_of);
assert_eq(is_ok(_v35L5_wt), 1, "cg: 2^700 + (x - 1)^2 behind a NaN wall at 2, from 0 -> Ok (a cap of 40 trials: Err)");
assert_eq(load64(_v35L5_ox), F64_ONE, "cg: ... -> 1 exactly");
assert_eq(_v35L5_NG, 54, "cg: ... -> 54 gradients (3.4.2: 3, its unit trial)");

# === row 4 (review): opt_conjugate_gradient stops at a fixed point ===
test_group("3.5.0 L5: opt_conjugate_gradient stops at a fixed point");
# The reviewer's two 4-D runs, sum w_i phi(x_i - c_i). With the first trial from _opt_qn_first and no stall
# rule, a fallback step that rounded back to x repeated with the same x, g and d until max_iter.
# [measured: scratch probe (scratch_L5 p/cgh.cyr, gencg.py), 3.4.2, the first form and this tree, 2026-11-14]
var _v35L5_K4 = 0;
var _v35L5_c4 = alloc(32);
var _v35L5_w4 = alloc(32);
var _v35L5_x4 = alloc(32);
var _v35L5_o4 = alloc(32);
fn _v35L5_f4(x) {
    var s = 0;
    for (var i = 0; i < 4; i = i + 1) {
        var a = f64_sub(load64(x + i * 8), load64(_v35L5_c4 + i * 8));
        var p = f64_mul(a, a);
        if (_v35L5_K4 == 1) { p = f64_ln(f64_add(F64_ONE, p)); }
        s = f64_add(s, f64_mul(load64(_v35L5_w4 + i * 8), p));
    }
    return s;
}
fn _v35L5_g4(x, o) {
    _v35L5_NG = _v35L5_NG + 1;
    for (var i = 0; i < 4; i = i + 1) {
        var a = f64_sub(load64(x + i * 8), load64(_v35L5_c4 + i * 8));
        var d = f64_mul(F64_TWO, a);
        if (_v35L5_K4 == 1) { d = f64_div(d, f64_add(F64_ONE, f64_mul(a, a))); }
        store64(o + i * 8, f64_mul(load64(_v35L5_w4 + i * 8), d));
    }
    return 0;
}
fn _v35L5_set4(k, c0, c1, c2, c3, w0, w1, w2, w3, x0, x1, x2, x3) {
    _v35L5_K4 = k;
    store64(_v35L5_c4, c0);
    store64(_v35L5_c4 + 8, c1);
    store64(_v35L5_c4 + 16, c2);
    store64(_v35L5_c4 + 24, c3);
    store64(_v35L5_w4, w0);
    store64(_v35L5_w4 + 8, w1);
    store64(_v35L5_w4 + 16, w2);
    store64(_v35L5_w4 + 24, w3);
    store64(_v35L5_x4, x0);
    store64(_v35L5_x4 + 8, x1);
    store64(_v35L5_x4 + 16, x2);
    store64(_v35L5_x4 + 24, x3);
    _v35L5_NG = 0;
    return 0;
}
# The quadratic at tol 2^-52, where only c itself passes: the stall came 1 ulp off in x3 (the first form:
# NO_CONVERGENCE after 3,946 gradients at max_iter 100); the restart along -g reaches c.
# [measured: scratch probe (scratch_L5 p/cgh.cyr, gencg.py), 3.4.2, the first form and this tree, 2026-11-14]
_v35L5_set4(0, 0x3FF5904C4FA02CA8, 0x3FC2D6E9D0AB9160, 0xBFF27C3672B85E0C, 0x3FE4024510359750, 0x401B036419993C8B,
  0x401E9DC2F9A633CD, 0x4023F0F8F44D0C92, 0x4001902F03645B17, 0xBFEE040FBB248F58, 0xBFE6E858B4314290,
  0x3FDB8FDB07032790, 0x3FD022470DF148A0);
var _v35L5_q4t, _v35L5_q4v = opt_conjugate_gradient(&_v35L5_f4, &_v35L5_g4, _v35L5_x4, 4, 0x3CB0000000000000, 100,
  _v35L5_o4, _v35L5_of);
assert_eq(is_ok(_v35L5_q4t), 1, "cg: the 4-D quadratic at tol 2^-52 -> Ok (first form: NO_CONVERGENCE at max_iter)");
assert_eq(load64(_v35L5_o4 + 24), 0x3FE4024510359750, "cg: the 4-D quadratic -> x3 = c3 (first form: 1 ulp off)");
assert_eq(load64(_v35L5_o4), 0x3FF5904C4FA02CA8, "cg: the 4-D quadratic -> x0 = c0");
assert_eq(_v35L5_NG, 53, "cg: the 4-D quadratic -> 53 gradients (3.4.2: 11; the first form: 3,946)");
# sum w ln(1 + (x - c)^2) at tol 1e-12: f is 3.6e-16 there and its rounding, 1 + a^2 to the double, is
# as large, so no trial meets Armijo; the step that rounds back to x is a fixed point after the restart.
# 3.4.2's path passed this point (Ok in 90 gradients); this one does not, and stops there.
_v35L5_set4(1, 0xBFC4B6E51956E2C0, 0xBFBE9F4203E48340, 0x3FDF7408D46E7D30, 0xBFE37319A8F30690, 0x3FC4C736D102569D,
  0x40048F88F7034458, 0x401BA82826A8ECDC, 0x4008F702235E36D6, 0x3FF25480D516FAC4, 0xBFFE145D29B7ECD4,
  0x3FFB92B63C0FBB70, 0xBFEDBACE9CD94968);
var _v35L5_l4t, _v35L5_l4v = opt_conjugate_gradient(&_v35L5_f4, &_v35L5_g4, _v35L5_x4, 4, 0x3D719799812DEA11, 3000,
  _v35L5_o4, _v35L5_of);
assert_eq(_v35L5_NG < 200, 1, "cg: sum w ln(1 + a^2) at tol 1e-12 -> under 200 gradients (the first form: 122,351)");
assert_eq(_v35L5_l4v, HSB_ERR_NO_CONVERGENCE,
  "cg: sum w ln(1 + a^2) -> NO_CONVERGENCE at the fixed point, f's rounding (3.4.2: Ok; flips once repaired)");

# ==================================================================================================
# 3.5.0 — vectors, quaternions, mat4, transforms, colour, tensors (the foundation modules)
# ==================================================================================================
# (Written as tests/v35_L6.tcyr; every global and fn below is prefixed _v35L6_.)

# The Err code of a Result call, 0 for an Ok; and the Ok value, or for an Err the address of 32
# words that each hold that same address, so an assertion that reads through it, however many
# handles deep (t3d_rot, then HQuat_y), reads an address no expected value is, and fails rather
# than faults.
var _v35L6_dummy: i64[32];
fn _v35L6_dummy_fill() {
    var i = 0;
    while (i < 32) { store64(&_v35L6_dummy + i * 8, &_v35L6_dummy); i = i + 1; }
    return &_v35L6_dummy;
}
fn _v35L6_err(t, v) {
    if (is_err_result(t) == 1) { return v; }
    return 0;
}
fn _v35L6_ok(t, v) {
    if (is_err_result(t) == 1) { return _v35L6_dummy_fill(); }
    return v;
}
# 1 when x is a NaN.
fn _v35L6_nan(x) {
    if ((x & 0x7FFFFFFFFFFFFFFF) > 0x7FF0000000000000) { return 1; }
    return 0;
}

# ================================================================
test_group("3.5.0 L6: K003, the f64 constants are enum members");
# The values, bit for bit, and a `var` initialised from each (spatial.cyr's alias shape).
var _v35L6_k_eps = EPSILON_F64;
var _v35L6_k_tiny = F64_TINY;
var _v35L6_k_inf = F64_POS_INF;
assert_eq(_v35L6_k_eps, 0x3D719799812DEA11, "EPSILON_F64 is 1e-12's bits, through a var initialiser");
assert_eq(_v35L6_k_tiny, 0x0010000000000000, "F64_TINY is DBL_MIN, through a var initialiser");
assert_eq(_v35L6_k_inf, 0x7FF0000000000000, "F64_POS_INF is +Inf, through a var initialiser");
assert_eq(EPSILON_F64 + F64_TINY + F64_POS_INF, 0x3D719799812DEA11 + 0x0010000000000000 + 0x7FF0000000000000,
  "the three read directly");

# ================================================================
test_group("3.5.0 L6: linearize_depth_reverse_z at the far plane (D096)");
assert_eq(linearize_depth_reverse_z(0, 0x3FB999999999999A), 0x7FF0000000000000,
  "ndc +0 is the far plane at infinity: +Inf (3.4.2: 0, the eye)");
assert_eq(linearize_depth_reverse_z(0x8000000000000000, 0x3FB999999999999A), 0x7FF0000000000000,
  "ndc -0 is the same real 0: +Inf, not IEEE's -Inf");
assert_eq(linearize_depth_reverse_z(1, F64_ONE), 0x7FF0000000000000,
  "the subnormal neighbour 2^-1074 overflows to +Inf too: continuity");
assert_eq(_v35L6_nan(linearize_depth_reverse_z(0, 0)), 1, "near 0 at ndc 0: 0 / 0, NaN");
assert_eq(linearize_depth_reverse_z(0x3F947AE147AE147B, 0x3FB999999999999A), 0x4014000000000000,
  "ndc 0.02, near 0.1: 5, one rounding");

# ================================================================
test_group("3.5.0 L6: t2d_transform_point returns an HVec2 (D090)");
var _v35L6_t2 = t2d_new(hvec2_new(F64_ONE, 0xBFF0000000000000), 0, hvec2_new(F64_TWO, 0x4008000000000000));
var _v35L6_u0 = alloc_used();
var _v35L6_p2 = t2d_transform_point(_v35L6_t2, hvec2_new(0x3FD0000000000000, F64_HALF));
assert_eq(alloc_used() - _v35L6_u0, 32, "one HVec2 point in, one HVec2 out: 16 + 16 bytes (t2d_apply's answer was 24)");
assert_eq(HVec2_x(_v35L6_p2), 0x3FF8000000000000, "rotation 0, scale (2, 3), pos (1, -1): x = 2 (1/4) + 1, exact");
assert_eq(HVec2_y(_v35L6_p2), 0x3FE0000000000000, "y = 3 (1/2) - 1, exact");
# A quarter turn: (0.5 c - 1.5 s + 1, 0.5 s + 1.5 c - 1) with c, s the double pi/2's cosine and sine.
# y is the oracle-nearest double (exact 9.18e-17 above -1/2); x is 0.55 ulp from it, t2d_apply's
# bits (the same arithmetic in the same order).
# [measured: scratch oracles (Decimal sin / cos, Fraction), tests/modules_d.tcyr pins, 2026-11-14; cycc 6.7.18]
var _v35L6_t2q = t2d_new(hvec2_new(F64_ONE, 0xBFF0000000000000), F64_PI_2, hvec2_new(F64_TWO, 0x4008000000000000));
var _v35L6_p2q = t2d_transform_point(_v35L6_t2q, hvec2_new(0x3FD0000000000000, F64_HALF));
assert_eq(HVec2_x(_v35L6_p2q), 0xBFE0000000000000, "quarter turn: x");
assert_eq(HVec2_y(_v35L6_p2q), 0xBFDFFFFFFFFFFFFE, "quarter turn: y, oracle-nearest");

# ================================================================
test_group("3.5.0 L6: t2d_compose_checked (F-X2)");
# The audit's pair: a rotation by 0.7, then the non-uniform scale (2, 1/2), is a shear.
var _v35L6_fa = t2d_new(hvec2_new(0x3FD3333333333333, 0xBFC999999999999A), 0x3FE6666666666666, hvec2_one());
var _v35L6_fb = t2d_new(hvec2_new(F64_HALF, 0x3FB999999999999A), 0, hvec2_new(F64_TWO, F64_HALF));
var _v35L6_c1t, _v35L6_c1 = t2d_compose_checked(_v35L6_fa, _v35L6_fb);
assert_eq(_v35L6_err(_v35L6_c1t, _v35L6_c1), HSB_ERR_INVALID_TRANSFORM, "F-X2's pair: a shear, Err(INVALID_TRANSFORM)");
# A quarter turn before (2, 1/2) IS a triple: its scales swap. phi = atan2(0.25 s, c), the column's
# own angle: pi/2 - 2.4e-16, oracle-nearest.
# [measured: scratch oracles (Decimal sin / cos, Fraction), tests/modules_d.tcyr pins, 2026-11-14; cycc 6.7.18]
var _v35L6_qa2 = t2d_new(hvec2_zero(), F64_PI_2, hvec2_one());
var _v35L6_qb2 = t2d_new(hvec2_zero(), 0, hvec2_new(F64_TWO, F64_HALF));
var _v35L6_c2t, _v35L6_c2 = t2d_compose_checked(_v35L6_qa2, _v35L6_qb2);
assert_eq(_v35L6_err(_v35L6_c2t, _v35L6_c2), 0, "quarter turn then (2, 1/2): Ok");
assert_eq(t2d_rotation(_v35L6_c2), 0x3FF921FB54442D17, "its rotation, the column's angle");
assert_eq(t2d_scale_x(_v35L6_c2), F64_HALF, "its x scale 1/2 (3.4.2 said 2)");
assert_eq(t2d_scale_y(_v35L6_c2), F64_TWO, "its y scale 2 (3.4.2 said 1/2)");
# A mirror (s, -s): S R(t) = R(-t) S exactly, so rotation rot_b - rot_a.
var _v35L6_m2a = t2d_new(hvec2_zero(), 0x3FE6666666666666, hvec2_new(F64_TWO, F64_HALF));
var _v35L6_m2b = t2d_new(hvec2_zero(), 0x3FB999999999999A, hvec2_new(0x3FF8000000000000, 0xBFF8000000000000));
var _v35L6_c3t, _v35L6_c3 = t2d_compose_checked(_v35L6_m2a, _v35L6_m2b);
assert_eq(t2d_rotation(_v35L6_ok(_v35L6_c3t, _v35L6_c3)), 0xBFE3333333333333, "mirror: rotation 0.1 - 0.7 = -0.6");
assert_eq(t2d_scale_x(_v35L6_c3) + t2d_scale_y(_v35L6_c3), 0x4008000000000000 + 0xBFE8000000000000,
  "mirror: scales (3, -3/4)");
# Past pi the mirror is still rot_b - rot_a, not a wrapped atan2: 0.1 - 4 = -3.9.
var _v35L6_m2c = t2d_new(hvec2_zero(), 0x4010000000000000, hvec2_new(F64_TWO, F64_HALF));
var _v35L6_c3bt, _v35L6_c3b = t2d_compose_checked(_v35L6_m2c, _v35L6_m2b);
assert_eq(t2d_rotation(_v35L6_ok(_v35L6_c3bt, _v35L6_c3b)), 0xC00F333333333333,
  "mirror after a turn of 4: rotation -3.9");
# rot_a = +0 commutes with any b: the formula's +0 + -0 = +0, scales (1 * -2, 2 * 1).
var _v35L6_c3ct, _v35L6_c3c = t2d_compose_checked(t2d_new(hvec2_zero(), 0, hvec2_new(F64_ONE, F64_TWO)),
  t2d_new(hvec2_zero(), 0x8000000000000000, hvec2_new(0xC000000000000000, F64_ONE)));
assert_eq(t2d_rotation(_v35L6_ok(_v35L6_c3ct, _v35L6_c3c)), 0, "rot_a +0, rot_b -0: the formula's +0");
assert_eq(t2d_scale_x(_v35L6_c3c), 0xC000000000000000, "... x scale -2");
# a's scales both zero: every pair commutes, so the formula, rot_a + rot_b = 0.8.
var _v35L6_c3dt, _v35L6_c3d = t2d_compose_checked(t2d_new(hvec2_zero(), 0x3FE6666666666666, hvec2_zero()),
  t2d_new(hvec2_zero(), 0x3FB999999999999A, hvec2_new(F64_TWO, F64_HALF)));
assert_eq(t2d_rotation(_v35L6_ok(_v35L6_c3dt, _v35L6_c3d)), 0x3FE9999999999999, "a's scales 0: rotation 0.7 + 0.1");
# The commuting case keeps 3.4.2's formula, bit for bit (foundation.tcyr's mt194 pins its position).
var _v35L6_ua = t2d_new(hvec2_new(F64_ONE, F64_TWO), 0x3FE6666666666666, hvec2_new(F64_TWO, F64_HALF));
var _v35L6_ub = t2d_new(hvec2_zero(), 0x3FB999999999999A, hvec2_new(0x3FF8000000000000, 0x3FF8000000000000));
var _v35L6_c4t, _v35L6_c4 = t2d_compose_checked(_v35L6_ua, _v35L6_ub);
assert_eq(t2d_rotation(_v35L6_ok(_v35L6_c4t, _v35L6_c4)), f64_add(0x3FE6666666666666, 0x3FB999999999999A),
  "uniform b: rotation rot_a + rot_b");
assert_eq(t2d_scale_x(_v35L6_c4), 0x4008000000000000, "uniform b: scale 2 * 1.5");
# The threshold, 2^-48 of cosine between M's columns: a turn of 2^-49 before (2, 1) has cosine
# 0.75 2^-48 (Ok: the column's angle 2^-50), one of 2^-48 has 1.5 2^-48 (Err).
var _v35L6_sb2 = t2d_new(hvec2_zero(), 0, hvec2_new(F64_TWO, F64_ONE));
var _v35L6_c5t, _v35L6_c5 = t2d_compose_checked(t2d_new(hvec2_zero(), 0x3CE0000000000000, hvec2_one()), _v35L6_sb2);
assert_eq(t2d_rotation(_v35L6_ok(_v35L6_c5t, _v35L6_c5)), 0x3CD0000000000000,
  "a 2^-49 turn before (2, 1): Ok, its column at angle 2^-50");
var _v35L6_c6t, _v35L6_c6 = t2d_compose_checked(t2d_new(hvec2_zero(), 0x3CF0000000000000, hvec2_one()), _v35L6_sb2);
assert_eq(_v35L6_err(_v35L6_c6t, _v35L6_c6), HSB_ERR_INVALID_TRANSFORM, "a 2^-48 turn before (2, 1): past 2^-48, Err");
# A zero scale in a: a single live column is always a triple.
var _v35L6_z2 = t2d_new(hvec2_zero(), 0x3FE6666666666666, hvec2_new(F64_ONE, 0));
var _v35L6_c7t, _v35L6_c7 = t2d_compose_checked(_v35L6_z2, _v35L6_qb2);
assert_eq(_v35L6_err(_v35L6_c7t, _v35L6_c7), 0, "a's y scale 0: one live column, Ok");
assert_eq(t2d_scale_y(_v35L6_c7) & 0x7FFFFFFFFFFFFFFF, 0, "... its y scale is 0");
# ... and maps as a then b (the formula would not: a's x column is live and b non-uniform).
fn _v35L6_close2(a, b) {
    var n = 0;
    var i = 0;
    while (i < 2) {
        var x = load64(a + i * 8);
        var y = load64(b + i * 8);
        var tol = f64_mul(f64_max(F64_ONE, f64_abs(y)), 0x3CD0000000000000);   # 2^-50
        if (f64_lt(f64_abs(f64_sub(x, y)), tol) == 1) { n = n + 1; }
        i = i + 1;
    }
    return n;
}
var _v35L6_p2p = hvec2_new(0x3FE6666666666666, 0xBFF3333333333333);
assert_eq(_v35L6_close2(t2d_transform_point(_v35L6_c7, _v35L6_p2p),
    t2d_transform_point(_v35L6_qb2, t2d_transform_point(_v35L6_z2, _v35L6_p2p))), 2, "... applies as a then b");
# The sign each column takes: the one nearer a's own axis. A 2^-49 turn before (-2, 1): rotation
# -2^-50, scales (-2, 1), not pi - 2^-50 with (2, -1); before (2, -1): -2^-50 with (2, -1), the
# reflection in the second scale (det < 0).
var _v35L6_cet, _v35L6_ce = t2d_compose_checked(t2d_new(hvec2_zero(), 0x3CE0000000000000, hvec2_one()),
  t2d_new(hvec2_zero(), 0, hvec2_new(0xC000000000000000, F64_ONE)));
assert_eq(t2d_rotation(_v35L6_ok(_v35L6_cet, _v35L6_ce)), 0xBCD0000000000000, "before (-2, 1): rotation -2^-50");
assert_eq(t2d_scale_x(_v35L6_ce), 0xC000000000000000, "before (-2, 1): x scale -2");
var _v35L6_cft, _v35L6_cf = t2d_compose_checked(t2d_new(hvec2_zero(), 0x3CE0000000000000, hvec2_one()),
  t2d_new(hvec2_zero(), 0, hvec2_new(F64_TWO, 0xBFF0000000000000)));
assert_eq(t2d_scale_y(_v35L6_ok(_v35L6_cft, _v35L6_cf)), 0xBFF0000000000000, "before (2, -1): y scale -1");
assert_eq(t2d_scale_x(_v35L6_cf), F64_TWO, "before (2, -1): x scale 2");
# The first column dead (a's x scale 0), b (-2, -1): the second column is signed toward R_a's own
# e1, so the rotation is 1.035, near rot_a = 0.7, with y scale -1.5; the opposite sign would give the
# same map as rotation 1.035 - pi with y scale +1.5.
var _v35L6_g2a = t2d_new(hvec2_zero(), 0x3FE6666666666666, hvec2_new(0, F64_ONE));
var _v35L6_g2b = t2d_new(hvec2_zero(), 0, hvec2_new(0xC000000000000000, 0xBFF0000000000000));
var _v35L6_cgt, _v35L6_cg = t2d_compose_checked(_v35L6_g2a, _v35L6_g2b);
assert_eq(t2d_rotation(_v35L6_ok(_v35L6_cgt, _v35L6_cg)), 0x3FF08FB09ABB43F9,
  "x column dead, b (-2, -1): rotation 1.035, on R_a's side");
assert_eq(t2d_scale_y(_v35L6_cg), 0xBFF7F93CA5A279A1, "... y scale -1.5, signed with it");
assert_eq(_v35L6_close2(t2d_transform_point(_v35L6_cg, _v35L6_p2p),
    t2d_transform_point(_v35L6_g2b, t2d_transform_point(_v35L6_g2a, _v35L6_p2p))), 2, "... applies as a then b");
var _v35L6_nn2 = t2d_new(hvec2_zero(), 0x7FF8000000000000, hvec2_one());
var _v35L6_c8t, _v35L6_c8 = t2d_compose_checked(_v35L6_nn2, _v35L6_qb2);
assert_eq(_v35L6_err(_v35L6_c8t, _v35L6_c8), HSB_ERR_INVALID_INPUT, "a NaN field: Err(INVALID_INPUT)");
var _v35L6_cib = t2d_new(hvec2_zero(), 0, hvec2_new(F64_ONE, 0xFFF0000000000000));
var _v35L6_cit, _v35L6_ci = t2d_compose_checked(_v35L6_qb2, _v35L6_cib);
assert_eq(_v35L6_err(_v35L6_cit, _v35L6_ci), HSB_ERR_INVALID_INPUT, "an infinite scale in b: Err(INVALID_INPUT)");
var _v35L6_c9t, _v35L6_c9 = t2d_compose_checked(0, _v35L6_qb2);
assert_eq(_v35L6_err(_v35L6_c9t, _v35L6_c9), HSB_ERR_INVALID_INPUT, "a 0 handle: Err(INVALID_INPUT)");

# ================================================================
test_group("3.5.0 L6: t3d_compose_checked (F-X2)");
fn _v35L6_t3(px, py, pz, q, sx, sy, sz) {
    return t3d_new(hvec3_new(px, py, pz), q, hvec3_new(sx, sy, sz));
}
var _v35L6_qg = hquat_new(0x3FC999999999999A, 0xBFD999999999999A, 0x3FE3333333333333, 0x3FE999999999999A);
var _v35L6_qh = hquat_new(0x3FB999999999999A, 0x3FC999999999999A, 0xBFD3333333333333, 0x3FEE666666666666);
var _v35L6_a3 = _v35L6_t3(F64_ONE, 0, 0, _v35L6_qg, F64_TWO, F64_HALF, 0x4008000000000000);
# A general rotation before (2, 1/2, 1): a shear.
var _v35L6_b3 = _v35L6_t3(0, 0, 0, hquat_identity(), F64_TWO, F64_HALF, F64_ONE);
var _v35L6_d1t, _v35L6_d1 = t3d_compose_checked(_v35L6_a3, _v35L6_b3);
assert_eq(_v35L6_err(_v35L6_d1t, _v35L6_d1), HSB_ERR_INVALID_TRANSFORM, "general rotation, then (2, 1/2, 1): Err");
# Uniform b: 3.4.2's formula, bit for bit.
var _v35L6_b4 = _v35L6_t3(0, F64_ONE, 0, _v35L6_qh, 0x3FF4000000000000, 0x3FF4000000000000, 0x3FF4000000000000);
var _v35L6_d2t, _v35L6_d2 = t3d_compose_checked(_v35L6_a3, _v35L6_b4);
var _v35L6_fq = hquat_mul(_v35L6_qh, _v35L6_qg);
var _v35L6_d2r = t3d_rot(_v35L6_ok(_v35L6_d2t, _v35L6_d2));
assert_eq((HQuat_x(_v35L6_d2r) == HQuat_x(_v35L6_fq)) + (HQuat_y(_v35L6_d2r) == HQuat_y(_v35L6_fq))
  + (HQuat_z(_v35L6_d2r) == HQuat_z(_v35L6_fq)) + (HQuat_w(_v35L6_d2r) == HQuat_w(_v35L6_fq)), 4,
  "uniform b: rotation q_b q_a, hquat_mul's bits");
assert_eq(HVec3_z(t3d_scale(_v35L6_d2)), 0x400E000000000000, "uniform b: scale z 1.25 * 3");
# A quarter turn about z (q = (0, 0, c, c), exactly 90 degrees) before (2, 1/2, 1): a triple, its x
# and y scales swapped. The rotation is the quarter turn's (z one ulp under the nearest 1/sqrt(2),
# Shepperd's rounding).
var _v35L6_qz = hquat_new(0, 0, 0x3FE6A09E667F3BCD, 0x3FE6A09E667F3BCD);
var _v35L6_a5 = _v35L6_t3(F64_ONE, F64_TWO, 0x4008000000000000, _v35L6_qz, F64_ONE, F64_ONE, F64_ONE);
var _v35L6_d3t, _v35L6_d3 = t3d_compose_checked(_v35L6_a5, _v35L6_b3);
var _v35L6_d3s = t3d_scale(_v35L6_ok(_v35L6_d3t, _v35L6_d3));
assert_eq(HVec3_x(_v35L6_d3s), F64_HALF, "quarter turn then (2, 1/2, 1): x scale 1/2 (3.4.2: 2)");
assert_eq(HVec3_y(_v35L6_d3s), F64_TWO, "... y scale 2 (3.4.2: 1/2)");
assert_eq(HVec3_z(_v35L6_d3s), F64_ONE, "... z scale 1");
assert_eq(HQuat_z(t3d_rot(_v35L6_d3)) + HQuat_w(t3d_rot(_v35L6_d3)), 0x3FE6A09E667F3BCC + 0x3FE6A09E667F3BCD,
  "... rotation the quarter turn about z");
assert_eq(HVec3_x(t3d_pos(_v35L6_d3)) + HVec3_y(t3d_pos(_v35L6_d3)), F64_TWO + F64_ONE,
  "... position (2 * 1, 1/2 * 2, 3), 3.4.2's formula");
# A point through the composite and through a then b: within 2^-50 of each other.
fn _v35L6_close3(a, b) {
    var n = 0;
    var i = 0;
    while (i < 3) {
        var x = load64(a + i * 8);
        var y = load64(b + i * 8);
        var tol = f64_mul(f64_max(F64_ONE, f64_abs(y)), 0x3CD0000000000000);   # 2^-50
        if (f64_lt(f64_abs(f64_sub(x, y)), tol) == 1) { n = n + 1; }
        i = i + 1;
    }
    return n;
}
var _v35L6_pp = hvec3_new(0x3FE6666666666666, 0xBFF3333333333333, 0x4004000000000000);
assert_eq(_v35L6_close3(t3d_apply(_v35L6_d3, _v35L6_pp), t3d_apply(_v35L6_b3, t3d_apply(_v35L6_a5, _v35L6_pp))), 3,
  "quarter turn: the composite applies as a then b");
# A mirror b (1, -1, 1) after a general rotation: a triple (a negative scale), applying as a then b.
var _v35L6_bm = _v35L6_t3(0, 0, 0, hquat_identity(), F64_ONE, 0xBFF0000000000000, F64_ONE);
var _v35L6_d4t, _v35L6_d4 = t3d_compose_checked(_v35L6_a3, _v35L6_bm);
assert_eq(_v35L6_err(_v35L6_d4t, _v35L6_d4), 0, "mirror b after a general rotation: Ok");
assert_eq(_v35L6_close3(t3d_apply(_v35L6_d4, _v35L6_pp), t3d_apply(_v35L6_bm, t3d_apply(_v35L6_a3, _v35L6_pp))), 3,
  "mirror: the composite applies as a then b");
assert_eq(HVec3_z(t3d_scale(_v35L6_d4)), 0xC008000000000000, "mirror: the flipped column's scale, -3");
# The whole triple: each column signed to R_a's side, the rotation on q_a's.
var _v35L6_d4r = t3d_rot(_v35L6_d4);
assert_eq(HQuat_x(_v35L6_d4r), 0x3FE75E9746A0B099, "mirror: rotation x");
assert_eq(HQuat_y(_v35L6_d4r), 0xBFE186F174F88472, "mirror: rotation y");
assert_eq(HQuat_z(_v35L6_d4r) + HQuat_w(_v35L6_d4r), 0x3FD75E9746A0B099 + 0x3FC75E9746A0B099, "mirror: rotation z, w");
assert_eq(HVec3_x(t3d_scale(_v35L6_d4)), 0x4000000000000001, "mirror: x scale 2 (1 ulp, the column's length)");
assert_eq(HVec3_y(t3d_scale(_v35L6_d4)), F64_HALF, "mirror: y scale 1/2");
# The mirror (1, -1, 1) after a turn of 0.2 about x: diag(1, -1, 1) R_x(t) = R_x(-t) diag(1, -1, 1), so
# the triple is the turn by -0.2 with scales (2, -1/2, 3) (the y column signed to R_a's side, -1).
var _v35L6_dft, _v35L6_df = t3d_compose_checked(_v35L6_t3(0, 0, 0, hquat_new(0x3FB999999999999A, 0, 0, F64_ONE),
    F64_TWO, F64_HALF, 0x4008000000000000), _v35L6_bm);
assert_eq(HQuat_x(t3d_rot(_v35L6_ok(_v35L6_dft, _v35L6_df))), 0xBFB9791363068B55,
  "mirror after R_x(0.2): rotation x < 0");
assert_eq(HVec3_y(t3d_scale(_v35L6_df)), 0xBFDFFFFFFFFFFFFF, "... y scale -1/2 (1 ulp, the column's length)");
assert_eq(HVec3_x(t3d_scale(_v35L6_df)), F64_TWO, "... x scale 2");
# b = (-1, -1, 1), a half turn about z as a scale: two columns signed to R_a's side, scales
# (2, -1/2, -3), and the rotation that leaves.
var _v35L6_dgt, _v35L6_dg = t3d_compose_checked(_v35L6_a3, _v35L6_t3(0, 0, 0, hquat_identity(), 0xBFF0000000000000,
    0xBFF0000000000000, F64_ONE));
assert_eq(HQuat_x(t3d_rot(_v35L6_ok(_v35L6_dgt, _v35L6_dg))), 0x3FE186F174F88472, "b (-1, -1, 1): rotation x");
assert_eq(HQuat_w(t3d_rot(_v35L6_dg)), 0x3FD75E9746A0B099, "b (-1, -1, 1): rotation w");
assert_eq(HVec3_y(t3d_scale(_v35L6_dg)) + HVec3_z(t3d_scale(_v35L6_dg)), 0xBFE0000000000000 + 0xC008000000000000,
  "b (-1, -1, 1): scales y -1/2 and z -3");
var _v35L6_bhz = _v35L6_t3(0, 0, 0, hquat_identity(), 0xBFF0000000000000, 0xBFF0000000000000, F64_ONE);
assert_eq(_v35L6_close3(t3d_apply(_v35L6_dg, _v35L6_pp), t3d_apply(_v35L6_bhz, t3d_apply(_v35L6_a3, _v35L6_pp))), 3,
  "b (-1, -1, 1): as a then b");
# A quarter turn written with w < 0, (0, 0, -c, -c): the answer stays on that side.
var _v35L6_qzn = hquat_new(0, 0, 0xBFE6A09E667F3BCD, 0xBFE6A09E667F3BCD);
var _v35L6_dct, _v35L6_dc = t3d_compose_checked(_v35L6_t3(0, 0, 0, _v35L6_qzn, F64_ONE, F64_ONE, F64_ONE), _v35L6_b3);
assert_eq(HQuat_w(t3d_rot(_v35L6_ok(_v35L6_dct, _v35L6_dc))), 0xBFE6A09E667F3BCD,
  "q_a with w < 0: the rotation's w < 0 too");
# A zero scale in a: one or two live columns, each completed to a rotation; the composite applies
# as a then b (a mirror b, so every pair of columns is orthogonal).
var _v35L6_a6 = _v35L6_t3(F64_ONE, 0, 0, _v35L6_qg, F64_TWO, F64_HALF, 0);
var _v35L6_dat, _v35L6_da = t3d_compose_checked(_v35L6_a6, _v35L6_bm);
assert_eq(_v35L6_close3(t3d_apply(_v35L6_ok(_v35L6_dat, _v35L6_da), _v35L6_pp),
    t3d_apply(_v35L6_bm, t3d_apply(_v35L6_a6, _v35L6_pp))), 3, "a's z scale 0 (two live columns): as a then b");
assert_eq(HVec3_z(t3d_scale(_v35L6_da)) & 0x7FFFFFFFFFFFFFFF, 0, "... its z scale is 0");
var _v35L6_a7 = _v35L6_t3(F64_ONE, 0, 0, _v35L6_qg, 0, F64_HALF, 0);
var _v35L6_dbt, _v35L6_db = t3d_compose_checked(_v35L6_a7, _v35L6_b3);
assert_eq(_v35L6_close3(t3d_apply(_v35L6_ok(_v35L6_dbt, _v35L6_db), _v35L6_pp),
    t3d_apply(_v35L6_b3, t3d_apply(_v35L6_a7, _v35L6_pp))), 3, "one live column, a general b: as a then b");
var _v35L6_a8 = _v35L6_t3(F64_ONE, 0, 0, _v35L6_qg, F64_TWO, 0, 0);
var _v35L6_ddt, _v35L6_dd = t3d_compose_checked(_v35L6_a8, _v35L6_b3);
assert_eq(_v35L6_close3(t3d_apply(_v35L6_ok(_v35L6_ddt, _v35L6_dd), _v35L6_pp),
    t3d_apply(_v35L6_b3, t3d_apply(_v35L6_a8, _v35L6_pp))), 3, "the x column alone live: as a then b");
# Its rotation: the two dead columns are completed from R_a's column less aligned with the live
# one, made orthogonal to it (the more aligned one gives another rotation, x ...CFE0, as valid for
# the map and further from R_a).
assert_eq(HQuat_x(t3d_rot(_v35L6_dd)), 0x3FD1C800B7588370, "the x column alone live: its rotation x");
assert_eq(HQuat_w(t3d_rot(_v35L6_dd)), 0x3FE85E8A6C52C92E, "... and w");
var _v35L6_a9 = _v35L6_t3(F64_ONE, 0, 0, _v35L6_qg, 0, 0, 0x4008000000000000);
var _v35L6_det, _v35L6_de = t3d_compose_checked(_v35L6_a9, _v35L6_b3);
assert_eq(_v35L6_close3(t3d_apply(_v35L6_ok(_v35L6_det, _v35L6_de), _v35L6_pp),
    t3d_apply(_v35L6_b3, t3d_apply(_v35L6_a9, _v35L6_pp))), 3, "the z column alone live: as a then b");
# The threshold: q = (2^-50, 0, 0, 1) is a turn of about 2^-49 about x, cosine 0.75 2^-48 before
# (1, 2, 1): Ok; q = (2^-49, 0, 0, 1), 1.5 2^-48: Err.
var _v35L6_bt = _v35L6_t3(0, 0, 0, hquat_identity(), F64_ONE, F64_TWO, F64_ONE);
var _v35L6_d5t, _v35L6_d5 = t3d_compose_checked(_v35L6_t3(0, 0, 0, hquat_new(0x3CD0000000000000, 0, 0, F64_ONE),
    F64_ONE, F64_ONE, F64_ONE), _v35L6_bt);
assert_eq(_v35L6_err(_v35L6_d5t, _v35L6_d5), 0, "a 2^-49 turn before (1, 2, 1): Ok");
var _v35L6_d6t, _v35L6_d6 = t3d_compose_checked(_v35L6_t3(0, 0, 0, hquat_new(0x3CE0000000000000, 0, 0, F64_ONE),
    F64_ONE, F64_ONE, F64_ONE), _v35L6_bt);
assert_eq(_v35L6_err(_v35L6_d6t, _v35L6_d6), HSB_ERR_INVALID_TRANSFORM, "a 2^-48 turn before (1, 2, 1): Err");
# R_a's entries are each relatively accurate (`_trs_rot_rel`). q = (x, x, z, z) with x one ulp above
# z = sqrt(2)'s double: R_01 = 2 (x x - z z) / |q|^2 = 1.57e-16, which x x and z z rounded apart put
# 41% too high. Before (18, 1, 1) the cosine between the y and z columns is 0.79 2^-48, Ok, where
# that R_01 makes it 1.12 2^-48 and an Err.
# [measured: scratch orc.py (Fraction composite), this tree and the review's mutant MU12, 2026-11-14]
var _v35L6_q10 = hquat_new(0x3FF6A09E667F3BCD, 0x3FF6A09E667F3BCD, 0x3FF6A09E667F3BCC, 0x3FF6A09E667F3BCC);
var _v35L6_d10t, _v35L6_d10 = t3d_compose_checked(_v35L6_t3(0, 0, 0, _v35L6_q10, F64_ONE, F64_ONE, F64_ONE),
  _v35L6_t3(0, 0, 0, hquat_identity(), 0x4032000000000000, F64_ONE, F64_ONE));
assert_eq(_v35L6_err(_v35L6_d10t, _v35L6_d10), 0, "cosine 0.79 2^-48 through a cancelling R_01: Ok");
assert_eq(HQuat_y(t3d_rot(_v35L6_ok(_v35L6_d10t, _v35L6_d10))), 0x3FE000000000000D, "... its rotation y");
# Refusals: a zero quaternion is no rotation; NaN; a 0 handle.
var _v35L6_d7t, _v35L6_d7 = t3d_compose_checked(_v35L6_t3(0, 0, 0, hquat_new(0, 0, 0, 0), F64_ONE, F64_ONE, F64_ONE),
  _v35L6_bt);
assert_eq(_v35L6_err(_v35L6_d7t, _v35L6_d7), HSB_ERR_INVALID_INPUT, "a zero quaternion: Err(INVALID_INPUT)");
var _v35L6_d8t, _v35L6_d8 = t3d_compose_checked(_v35L6_t3(0x7FF8000000000000, 0, 0, hquat_identity(), F64_ONE,
    F64_ONE, F64_ONE), _v35L6_bt);
assert_eq(_v35L6_err(_v35L6_d8t, _v35L6_d8), HSB_ERR_INVALID_INPUT, "a NaN position: Err(INVALID_INPUT)");
var _v35L6_dib = _v35L6_t3(0, 0, 0, hquat_new(0, 0x7FF0000000000000, 0, F64_ONE), F64_ONE, F64_ONE, F64_ONE);
var _v35L6_dit, _v35L6_di = t3d_compose_checked(_v35L6_bt, _v35L6_dib);
assert_eq(_v35L6_err(_v35L6_dit, _v35L6_di), HSB_ERR_INVALID_INPUT, "an infinite quaternion part: Err(INVALID_INPUT)");
var _v35L6_d9t, _v35L6_d9 = t3d_compose_checked(_v35L6_bt, 0);
assert_eq(_v35L6_err(_v35L6_d9t, _v35L6_d9), HSB_ERR_INVALID_INPUT, "a 0 handle: Err(INVALID_INPUT)");

# ================================================================
test_group("3.5.0 L6: compose's general path at the ends of the range (review)");
# A scale of a times a column length in units of 2^-p, rescaled after: a near either end of the range
# overflowed the product to +Inf, or took it into the subnormals, where the composite's scale is a
# normal double. Beside each pin: the worst column's distance from the oracle (Decimal sin / cos in
# 2-D, the exact rational composite in 3-D), relative to that column, and the first review tree's.
# [measured: scratch orc.py, Decimal sin / cos and Fraction composites, 2026-11-14; cycc 6.7.18]
var _v35L6_eb2 = t2d_new(hvec2_zero(), 0, hvec2_new(0x3DCE666666666666, 0x3DDE666666666666));
var _v35L6_e1t, _v35L6_e1 = t2d_compose_checked(t2d_new(hvec2_zero(), F64_PI_2,
    hvec2_new(0x7FE1CCF385EBC8A0, 0x7FE1CCF385EBC8A0)), _v35L6_eb2);
assert_eq(t2d_scale_x(_v35L6_ok(_v35L6_e1t, _v35L6_e1)), 0x7DD0E91A8C0664FE,
  "2-D, a's scale 1e308 at a quarter turn: x scale 1.1e298, 0.65 u (was +Inf)");
assert_eq(t2d_scale_y(_v35L6_e1), 0x7DC0E91A8C0664FE, "... y scale 5.5e297");
var _v35L6_e1bt, _v35L6_e1b = t2d_compose_checked(t2d_new(hvec2_zero(), F64_PI_2,
    hvec2_new(0x7FE1CCF385EBC8A0, 0x7FE1CCF385EBC8A0)), t2d_new(hvec2_zero(), 0, hvec2_new(0x3DDE666666666666,
      0x3DCE666666666666)));
assert_eq(t2d_scale_y(_v35L6_ok(_v35L6_e1bt, _v35L6_e1b)), 0x7DD0E91A8C0664FE,
  "2-D, b's larger part on x: y scale 1.1e298, 0.65 u (was +Inf)");
var _v35L6_e2t, _v35L6_e2 = t2d_compose_checked(t2d_new(hvec2_zero(), F64_PI_2, hvec2_new(0, 0x7FE1CCF385EBC8A0)),
  t2d_new(hvec2_zero(), 0, hvec2_new(0x3DDE666666666666, 0x3DCE666666666666)));
assert_eq(t2d_scale_y(_v35L6_ok(_v35L6_e2t, _v35L6_e2)), 0x7DD0E91A8C0664FE,
  "2-D, a's x scale 0 (the second column alone): y scale 1.1e298, 0.43 u (was +Inf)");
var _v35L6_e3t, _v35L6_e3 = t2d_compose_checked(t2d_new(hvec2_zero(), F64_PI_2,
    hvec2_new(0x000000000000ABCD, 0x000000000000ABCD)),
  t2d_new(hvec2_zero(), 0, hvec2_new(0x43B4CCCCCCCCCCCD, 0x43C3333333333333)));
assert_eq(t2d_scale_x(_v35L6_ok(_v35L6_e3t, _v35L6_e3)), 0x0199C52666666666,
  "2-D, a's scale subnormal (2.2e-319), b's 2^60: x scale 4.0e-301, 0.49 u (was 1.1e11 u off)");
var _v35L6_eq = hquat_new(0, 0, 0x3FE6A09E667F3BCD, 0x3FE6A09E667F3BCD);
var _v35L6_e4t, _v35L6_e4 = t3d_compose_checked(_v35L6_t3(0, 0, 0, _v35L6_eq, 0x7FEAB36D48E1ACF0, 0x7FEAB36D48E1ACF0,
    0x7FEAB36D48E1ACF0), _v35L6_t3(0, 0, 0, hquat_identity(), 0x3DDB7CDFD9D7BDBB, 0x3DEA1D07DBC02771,
    0x3DDB7CDFD9D7BDBB));
assert_eq(HVec3_x(t3d_scale(_v35L6_ok(_v35L6_e4t, _v35L6_e4))), 0x7DE5CA01F4DD9A5D,
  "3-D, a's scale 1.5e308 at a quarter turn: x scale 2.85e298, 1.56 u (was +Inf)");
var _v35L6_e5t, _v35L6_e5 = t3d_compose_checked(_v35L6_t3(0, 0, 0, _v35L6_eq, 0x00159283684DBA77, 0x80159283684DBA77,
    0x00159283684DBA77), _v35L6_t3(0, 0, 0, hquat_identity(), 0x40C3880000000000, 0x4211B1F3F8000000,
    0x4202A05F20000000));
assert_eq(HVec3_y(t3d_scale(_v35L6_ok(_v35L6_e5t, _v35L6_e5))), 0x80EA555968D2E21E,
  "3-D, a's scale -3e-308 on y: y scale -3e-304, 1.52 u (was ...E00000, 1.04e6 u off)");
var _v35L6_e6a = _v35L6_t3(0, 0, 0, hquat_new(0, 0, F64_ONE, F64_ONE), 0x000000000000ABCD, 0x000000000000ABCD,
  0x000000000000ABCD);
var _v35L6_e6b = _v35L6_t3(0, 0, 0, hquat_identity(), 0x43B4CCCCCCCCCCCD, 0x43C3333333333333, 0x43B199999999999A);
var _v35L6_e6t, _v35L6_e6 = t3d_compose_checked(_v35L6_e6a, _v35L6_e6b);
assert_eq(HVec3_z(t3d_scale(_v35L6_ok(_v35L6_e6t, _v35L6_e6))), 0x01879F6333333334,
  "3-D, a's scale subnormal (2.2e-319), b's 2^60: z scale, 1.42 u (was 1.7e11 u off)");
assert_eq(HVec3_x(t3d_scale(_v35L6_e6)), 0x0199C52666666666, "... x scale (b's y scale, swapped)");
# A zero scale in a beside b's scale near 2^1000: the dead columns' scales are 0, whatever 2^-p is.
var _v35L6_e7t, _v35L6_e7 = t3d_compose_checked(_v35L6_t3(F64_ONE, 0, 0, _v35L6_qg, F64_TWO, 0, 0),
  _v35L6_t3(0, 0, 0, hquat_identity(), 0x7E80000000000000, 0x7E60000000000000, 0x7E70000000000000));
assert_eq(HVec3_y(t3d_scale(_v35L6_ok(_v35L6_e7t, _v35L6_e7))), 0, "a's y scale 0, b's 2^1001: y scale 0");
assert_eq(HVec3_z(t3d_scale(_v35L6_e7)), 0, "... z scale 0");

# ================================================================
test_group("3.5.0 L6: tensor_get_checked / _set_checked and the 2-D pair (AU3-F12)");
var _v35L6_sh: i64[2];
store64(&_v35L6_sh, 2); store64(&_v35L6_sh + 8, 2);
var _v35L6_tt = tensor_new(2, &_v35L6_sh);
var _v35L6_tu = tensor_new(2, &_v35L6_sh);   # the next tensor, the audit's canary
var _v35L6_ix: i64[2];
store64(&_v35L6_ix, 1); store64(&_v35L6_ix + 8, 1);
var _v35L6_s1t, _v35L6_s1 = tensor_set_checked(_v35L6_tt, &_v35L6_ix, 0x408F380000000000);
var _v35L6_g1t, _v35L6_g1 = tensor_get_checked(_v35L6_tt, &_v35L6_ix);
assert_eq(_v35L6_ok(_v35L6_g1t, _v35L6_g1), 0x408F380000000000, "[1, 1]: set then get, the bits");
store64(&_v35L6_ix, 2); store64(&_v35L6_ix + 8, 0);
var _v35L6_s2t, _v35L6_s2 = tensor_set_checked(_v35L6_tt, &_v35L6_ix, 0x408F380000000000);
assert_eq(_v35L6_err(_v35L6_s2t, _v35L6_s2), HSB_ERR_OUT_OF_RANGE, "[2, 0] on shape [2, 2]: Err(OUT_OF_RANGE)");
assert_eq(HTensor_rank(_v35L6_tu), 2, "... and the next tensor's rank is untouched (3.4.2 wrote 999.0 there)");
store64(&_v35L6_ix, 0 - 1);
var _v35L6_s3t, _v35L6_s3 = tensor_set_checked(_v35L6_tt, &_v35L6_ix, 0x4081580000000000);
assert_eq(_v35L6_err(_v35L6_s3t, _v35L6_s3), HSB_ERR_OUT_OF_RANGE, "[-1, 0]: Err(OUT_OF_RANGE)");
assert_eq(load64(HTensor_shape(_v35L6_tt)), 2, "... and t's own shape[0] is untouched");
store64(&_v35L6_ix, 0); store64(&_v35L6_ix + 8, 2);
var _v35L6_g2t, _v35L6_g2 = tensor_get_checked(_v35L6_tt, &_v35L6_ix);
assert_eq(_v35L6_err(_v35L6_g2t, _v35L6_g2), HSB_ERR_OUT_OF_RANGE, "get [0, 2]: Err(OUT_OF_RANGE), the last axis");
var _v35L6_g3t, _v35L6_g3 = tensor_get_checked(0, &_v35L6_ix);
assert_eq(_v35L6_err(_v35L6_g3t, _v35L6_g3), HSB_ERR_INVALID_INPUT, "t = 0: Err(INVALID_INPUT)");
var _v35L6_g4t, _v35L6_g4 = tensor_get_checked(_v35L6_tt, 0);
assert_eq(_v35L6_err(_v35L6_g4t, _v35L6_g4), HSB_ERR_INVALID_INPUT, "indices = 0 at rank 2: Err(INVALID_INPUT)");
var _v35L6_t0 = tensor_new(0, 0);
var _v35L6_s5t, _v35L6_s5 = tensor_set_checked(_v35L6_t0, 0, 0x4045000000000000);
var _v35L6_g5t, _v35L6_g5 = tensor_get_checked(_v35L6_t0, 0);
assert_eq(_v35L6_ok(_v35L6_g5t, _v35L6_g5), 0x4045000000000000, "rank 0: its one element, no index");
var _v35L6_g6t, _v35L6_g6 = tensor_get2_checked(_v35L6_tt, 1, 1);
assert_eq(_v35L6_ok(_v35L6_g6t, _v35L6_g6), 0x408F380000000000, "get2 (1, 1): the element set above");
var _v35L6_g7t, _v35L6_g7 = tensor_set2_checked(_v35L6_tt, 0, 2, 0x4045000000000000);
assert_eq(_v35L6_err(_v35L6_g7t, _v35L6_g7), HSB_ERR_OUT_OF_RANGE, "set2 (0, 2): Err(OUT_OF_RANGE)");
var _v35L6_g8t, _v35L6_g8 = tensor_get2_checked(_v35L6_tt, 2, 0);
assert_eq(_v35L6_err(_v35L6_g8t, _v35L6_g8), HSB_ERR_OUT_OF_RANGE, "get2 (2, 0): Err(OUT_OF_RANGE), the rows");
var _v35L6_g9t, _v35L6_g9 = tensor_get2_checked(_v35L6_tt, 0 - 1, 0);
assert_eq(_v35L6_err(_v35L6_g9t, _v35L6_g9), HSB_ERR_OUT_OF_RANGE, "get2 (-1, 0): Err(OUT_OF_RANGE)");
var _v35L6_sh1: i64[1];
store64(&_v35L6_sh1, 4);
var _v35L6_t1 = tensor_new(1, &_v35L6_sh1);
var _v35L6_gat, _v35L6_ga = tensor_get2_checked(_v35L6_t1, 0, 0);
assert_eq(_v35L6_err(_v35L6_gat, _v35L6_ga), HSB_ERR_INVALID_INPUT, "get2 on rank 1: Err(INVALID_INPUT)");
var _v35L6_gbt, _v35L6_gb = tensor_set2_checked(0, 0, 0, 0);
assert_eq(_v35L6_err(_v35L6_gbt, _v35L6_gb), HSB_ERR_INVALID_INPUT, "set2 on t = 0: Err(INVALID_INPUT)");

# ================================================================
test_group("3.5.0 L6: ev100_to_avg_luminance / avg_luminance_to_ev100 (SPC-F5, #12(c))");
# L = 2^(EV - 3), the reflected-light meter equation at K = 12.5, S = 100; oracle: 80-digit Decimal.
assert_eq(ev100_to_avg_luminance(0), 0x3FC0000000000000, "EV 0: 1/8 (3.4.2: 0.4974, 12.5 / pi too much)");
assert_eq(ev100_to_avg_luminance(0x4024000000000000), 0x4060000000000000, "EV 10: 128, exact");
assert_eq(ev100_to_avg_luminance(0xC090BC0000000000), 1, "EV -1071: 2^-1074, the subnormal end, exact");
assert_eq(ev100_to_avg_luminance(0xC090C00000000000), 0, "EV -1072: 2^-1075 rounds to even, 0");
assert_eq(ev100_to_avg_luminance(0x4090080000000000), 0x7FE0000000000000, "EV 1026: 2^1023, exact");
assert_eq(ev100_to_avg_luminance(0x40900C0000000000), 0x7FF0000000000000, "EV 1027: overflows to +Inf");
assert_eq(ev100_to_avg_luminance(0xC08FEBA2CCF3365F), 0x0002EB48006B852F,
  "EV -1021.4545: the correctly rounded subnormal (ev - 3 would round: 86 ulp)");
assert_eq(ev100_to_avg_luminance(0x40240A3D70A3D70A), 0x4060392D9352AD74, "EV 10.02: correctly rounded");
assert_eq(ev100_to_avg_luminance(0xC09005339C0EBEDF), 0x000033F84107FAFD,
  "EV -1025.3: correctly rounded, where 2^ev is itself subnormal (2^ev / 8 would round twice)");
assert_eq(ev100_to_avg_luminance(0xC08FF00900000009), 0x0001FE715ACC5433,
  "EV -1022.0044: correctly rounded (2^ev / 8 rounds twice to ...5434)");
assert_eq(avg_luminance_to_ev100(0x7FD0000000000000), 0x4090040000000000, "L 2^1022: EV 1025 (8 L overflows)");
assert_eq(avg_luminance_to_ev100(0x3FC0000000000000), 0, "L 1/8: EV 0, exact");
assert_eq(avg_luminance_to_ev100(F64_ONE), 0x4008000000000000, "L 1: EV 3, exact");
assert_eq(avg_luminance_to_ev100(0x7FE0000000000000), 0x4090080000000000, "L 2^1023: EV 1026, the 8 L overflow branch");
assert_eq(avg_luminance_to_ev100(0x4059000000000000), 0x402349A784BCD1B9, "L 100: log2(100) + 3, correctly rounded");
assert_eq(avg_luminance_to_ev100(0), 0xFFF0000000000000, "L 0: -Inf");
assert_eq(_v35L6_nan(avg_luminance_to_ev100(0xBFF0000000000000)), 1, "L -1: NaN");
assert_eq(avg_luminance_to_ev100(0x7FF0000000000000), 0x7FF0000000000000, "L +Inf: +Inf");

# ================================================================
test_group("3.5.0 L6: m4_look_at_rh_checked (AU2-G7-F6)");
var _v35L6_l1t, _v35L6_l1 = m4_look_at_rh_checked(hvec3_new(F64_ONE, F64_TWO, 0x4008000000000000),
  hvec3_new(F64_ONE, F64_TWO, 0x4008000000000000), hvec3_unit_y());
assert_eq(_v35L6_err(_v35L6_l1t, _v35L6_l1), HSB_ERR_DEGENERATE, "eye = target: Err(DEGENERATE) (3.4.2: a zero block)");
var _v35L6_l2t, _v35L6_l2 = m4_look_at_rh_checked(hvec3_zero(), hvec3_new(0, 0x4014000000000000, 0), hvec3_unit_y());
assert_eq(_v35L6_err(_v35L6_l2t, _v35L6_l2), HSB_ERR_DEGENERATE, "up parallel to forward: Err(DEGENERATE)");
var _v35L6_l3t, _v35L6_l3 = m4_look_at_rh_checked(hvec3_zero(), hvec3_unit_z(), hvec3_zero());
assert_eq(_v35L6_err(_v35L6_l3t, _v35L6_l3), HSB_ERR_DEGENERATE, "up = 0: Err(DEGENERATE)");
var _v35L6_l4t, _v35L6_l4 = m4_look_at_rh_checked(hvec3_new(0x7FF8000000000000, 0, 0), hvec3_unit_z(), hvec3_unit_y());
assert_eq(_v35L6_err(_v35L6_l4t, _v35L6_l4), HSB_ERR_INVALID_INPUT, "a NaN eye: Err(INVALID_INPUT)");
var _v35L6_lat, _v35L6_la = m4_look_at_rh_checked(hvec3_new(0x7FF0000000000000, 0, 0), hvec3_unit_z(), hvec3_unit_y());
assert_eq(_v35L6_err(_v35L6_lat, _v35L6_la), HSB_ERR_INVALID_INPUT, "an infinite eye: Err(INVALID_INPUT)");
var _v35L6_lbt, _v35L6_lb = m4_look_at_rh_checked(hvec3_zero(), hvec3_new(0, 0xFFF0000000000000, 0), hvec3_unit_y());
assert_eq(_v35L6_err(_v35L6_lbt, _v35L6_lb), HSB_ERR_INVALID_INPUT, "an infinite target: Err(INVALID_INPUT)");
var _v35L6_lct, _v35L6_lc = m4_look_at_rh_checked(hvec3_zero(), hvec3_unit_z(), hvec3_new(0, 0, 0x7FF0000000000000));
assert_eq(_v35L6_err(_v35L6_lct, _v35L6_lc), HSB_ERR_INVALID_INPUT, "an infinite up: Err(INVALID_INPUT)");
var _v35L6_l5t, _v35L6_l5 = m4_look_at_rh_checked(0, hvec3_unit_z(), hvec3_unit_y());
assert_eq(_v35L6_err(_v35L6_l5t, _v35L6_l5), HSB_ERR_INVALID_INPUT, "a 0 handle: Err(INVALID_INPUT)");
# up (1, 2, 3 + 2^-51) against forward (1, 2, 3): the exact side (2^-50, -2^-51, 0), normalised to
# (2, -1, 0) / sqrt(5), the oracle-nearest doubles.
var _v35L6_l6t, _v35L6_l6 = m4_look_at_rh_checked(hvec3_zero(), hvec3_new(F64_ONE, F64_TWO, 0x4008000000000000),
  hvec3_new(F64_ONE, F64_TWO, 0x4008000000000002));
var _v35L6_l6m = _v35L6_ok(_v35L6_l6t, _v35L6_l6);
assert_eq(m4_get(_v35L6_l6m, 0, 0), 0x3FEC9F25C5BFEDD9, "nearly parallel up: s.x, oracle-nearest");
assert_eq(m4_get(_v35L6_l6m, 1, 0), 0xBFDC9F25C5BFEDD9, "nearly parallel up: s.y, oracle-nearest");
assert_eq(m4_get(_v35L6_l6m, 2, 0), 0, "nearly parallel up: s.z, exactly 0");
# A camera 3.4.2 put 70 ulp off: the exact side's direction, s.x and s.z oracle-nearest, s.y 1 ulp.
# [measured: scratch lagen.py / lachk.py, Fraction and 60-digit roots, both trees, 2026-11-14; cycc 6.7.18]
var _v35L6_l7t, _v35L6_l7 = m4_look_at_rh_checked(hvec3_new(0xC01780C7B377E215, 0xC01DDD7CFF0F8376, 0xC0151297550C2F4C),
  hvec3_new(0x3FAD2AA7C9CC6C00, 0x401EE055698D0748, 0x4013211C28251372),
  hvec3_new(0x401F6909F161739E, 0x4033E5B31E602929, 0x402A70E6F98F9068));
var _v35L6_l7m = _v35L6_ok(_v35L6_l7t, _v35L6_l7);
assert_eq(m4_get(_v35L6_l7m, 0, 0), 0x3FE087735DE54880, "near-parallel camera: s.x (3.4.2: ...48C6)");
assert_eq(m4_get(_v35L6_l7m, 1, 0), 0x3FD4ACB4CB2C3094, "near-parallel camera: s.y (3.4.2: ...30C9)");
assert_eq(m4_get(_v35L6_l7m, 2, 0), 0xBFE960310915929D, "near-parallel camera: s.z (3.4.2: ...9264)");
# Its translation (-s . eye, -u . eye, f . eye): 4, 2 and 1 ulp from the exact, within 1 u |eye|.
# [measured: scratch lagen.py / lachk.py, Fraction and 60-digit roots, 2026-11-14; cycc 6.7.18]
assert_eq(m4_get(_v35L6_l7m, 3, 0), 0x3FF44F4109EA7DEC, "near-parallel camera: translation x, a sign-bit flip");
assert_eq(m4_get(_v35L6_l7m, 3, 1), 0x4003B42934EBD09D, "near-parallel camera: translation y");
assert_eq(m4_get(_v35L6_l7m, 3, 2), 0xC0250258182FA5EC, "near-parallel camera: translation z, unflipped");
# A difference past DBL_MAX: formed from halves, a finite view.
var _v35L6_l8t, _v35L6_l8 = m4_look_at_rh_checked(hvec3_new(0xFFE0000000000000, 0, 0),
  hvec3_new(0x7FE0000000000000, 0, 0),
  hvec3_unit_y());
assert_eq(m4_get(_v35L6_ok(_v35L6_l8t, _v35L6_l8), 0, 2), 0xBFF0000000000000, "eye -2^1023, target 2^1023: -f.x = -1");
assert_eq(m4_get(_v35L6_l8, 2, 0), F64_ONE, "... s = f x up = (0, 0, 1)");
# eye and target near -+DBL_MAX: -s . eye is -1.23e308, though s_x e_x + s_y e_y passed -DBL_MAX
# before s_z e_z came back. Twice the dot with eye halved: 0.14 ulp from the exact translation (the
# first review tree: -Inf); f . eye is itself past -DBL_MAX, and stays -Inf.
# [measured: scratch la.py (Fraction differences and cross products), 2026-11-14; cycc 6.7.18]
var _v35L6_lbt2, _v35L6_lb2 = m4_look_at_rh_checked(hvec3_new(0xFFE955D93F4A5CB0, 0xFFED3C26C9E341AE,
    0xFFECF76D2097E129), hvec3_new(0xFFEABFFF4CFA70F5, 0x7FE01E6E2B55F74B, 0x7FE06968E251692B),
  hvec3_new(0xBFE523BB2EAAE680, 0x3FEA4D9FB44E4062, 0xBFE25EBAA5DB1D9C));
assert_eq(m4_get(_v35L6_ok(_v35L6_lbt2, _v35L6_lb2), 3, 0), 0xFFE5F4FC3522F62E,
  "eye near DBL_MAX: translation x = -1.23e308 (was -Inf)");
assert_eq(m4_get(_v35L6_lb2, 3, 1), 0xFFDCB997C3544B28, "... translation y, the dot's own bits");
assert_eq(m4_get(_v35L6_lb2, 3, 2), 0xFFF0000000000000, "... translation z past the range: -Inf");
# The standard camera keeps the exact basis (foundation.tcyr's det = 1 pin).
var _v35L6_l9t, _v35L6_l9 = m4_look_at_rh_checked(hvec3_new(0, 0, 0x4014000000000000), hvec3_zero(), hvec3_unit_y());
assert_eq(m4_get(_v35L6_ok(_v35L6_l9t, _v35L6_l9), 3, 2), 0xC014000000000000, "eye (0, 0, 5): translation z = -5");
assert_eq(m4_get(_v35L6_l9, 0, 2), 0x8000000000000000, "... -f.x is -0, a sign-bit flip on every pin");

# ================================================================
test_group("3.5.0 L6: hvec2/3/4_normalize_checked (FB F4)");
var _v35L6_n1t, _v35L6_n1 = hvec3_normalize_checked(hvec3_zero());
assert_eq(_v35L6_err(_v35L6_n1t, _v35L6_n1), HSB_ERR_DIVISION_BY_ZERO, "vec3 zero: Err(DIVISION_BY_ZERO)");
var _v35L6_n2t, _v35L6_n2 = hvec3_normalize_checked(hvec3_new(0x8000000000000000, 0, 0x8000000000000000));
assert_eq(_v35L6_err(_v35L6_n2t, _v35L6_n2), HSB_ERR_DIVISION_BY_ZERO, "vec3 (-0, 0, -0): Err(DIVISION_BY_ZERO)");
var _v35L6_n3t, _v35L6_n3 = hvec3_normalize_checked(hvec3_new(1, 0, 0));
assert_eq(HVec3_x(_v35L6_ok(_v35L6_n3t, _v35L6_n3)), F64_ONE, "vec3 (2^-1074, 0, 0): Ok, the axis");
var _v35L6_n4t, _v35L6_n4 = hvec3_normalize_checked(hvec3_new(0, 0x7FF8000000000000, 0));
assert_eq(_v35L6_err(_v35L6_n4t, _v35L6_n4), HSB_ERR_INVALID_INPUT, "vec3 NaN: Err(INVALID_INPUT)");
var _v35L6_n5t, _v35L6_n5 = hvec3_normalize_checked(hvec3_new(0, 0, 0xFFF0000000000000));
assert_eq(_v35L6_err(_v35L6_n5t, _v35L6_n5), HSB_ERR_INVALID_INPUT, "vec3 -Inf: Err(INVALID_INPUT)");
var _v35L6_n6v = hvec3_new(0x3FF3C0CA428C59FB, 0xBFE225E01776813F, 0x3FEC84FE5B44E382);
var _v35L6_n6t, _v35L6_n6 = hvec3_normalize_checked(_v35L6_n6v);
var _v35L6_n6u = hvec3_normalize(_v35L6_n6v);
var _v35L6_n6x = HVec3_x(_v35L6_ok(_v35L6_n6t, _v35L6_n6));
assert_eq((_v35L6_n6x == HVec3_x(_v35L6_n6u)) + (HVec3_y(_v35L6_n6) == HVec3_y(_v35L6_n6u))
  + (HVec3_z(_v35L6_n6) == HVec3_z(_v35L6_n6u)), 3, "vec3 ordinary: hvec3_normalize's bits");
var _v35L6_n7t, _v35L6_n7 = hvec3_normalize_checked(0);
assert_eq(_v35L6_err(_v35L6_n7t, _v35L6_n7), HSB_ERR_INVALID_INPUT, "vec3 0 handle: Err(INVALID_INPUT)");
var _v35L6_n8t, _v35L6_n8 = hvec2_normalize_checked(hvec2_zero());
assert_eq(_v35L6_err(_v35L6_n8t, _v35L6_n8), HSB_ERR_DIVISION_BY_ZERO, "vec2 zero: Err(DIVISION_BY_ZERO)");
var _v35L6_n9t, _v35L6_n9 = hvec2_normalize_checked(hvec2_new(0x7FF0000000000000, 0));
assert_eq(_v35L6_err(_v35L6_n9t, _v35L6_n9), HSB_ERR_INVALID_INPUT, "vec2 +Inf: Err(INVALID_INPUT)");
var _v35L6_nat, _v35L6_na = hvec2_normalize_checked(hvec2_new(0x4008000000000000, 0x4010000000000000));
assert_eq(HVec2_y(_v35L6_ok(_v35L6_nat, _v35L6_na)), 0x3FE999999999999A, "vec2 (3, 4): y 0.8");
var _v35L6_nbt, _v35L6_nb = hvec4_normalize_checked(hvec4_new(0, 0x8000000000000000, 0, 0));
assert_eq(_v35L6_err(_v35L6_nbt, _v35L6_nb), HSB_ERR_DIVISION_BY_ZERO, "vec4 zero: Err(DIVISION_BY_ZERO)");
var _v35L6_nct, _v35L6_nc = hvec4_normalize_checked(hvec4_new(0, 0, 0, 0x7FF8000000000000));
assert_eq(_v35L6_err(_v35L6_nct, _v35L6_nc), HSB_ERR_INVALID_INPUT, "vec4 NaN w: Err(INVALID_INPUT)");
var _v35L6_ndt, _v35L6_nd = hvec4_normalize_checked(hvec4_new(0, 0, 0, 0xC000000000000000));
assert_eq(HVec4_w(_v35L6_ok(_v35L6_ndt, _v35L6_nd)), 0xBFF0000000000000, "vec4 (0, 0, 0, -2): w -1");

# ================================================================
test_group("3.5.0 L6: screen_to_world_ray, a point at infinity (FB F3)");
var _v35L6_ro: i64[1];
var _v35L6_rd: i64[1];
# Point both out params at the dummy, so a call that fails and leaves them is read without a fault.
fn _v35L6_rayreset() {
    store64(&_v35L6_ro, _v35L6_dummy_fill());
    store64(&_v35L6_rd, &_v35L6_dummy);
    return 0;
}
# inv_vp's w row zero: the near point is at infinity, no origin. The out params are untouched.
var _v35L6_iw = m4_identity();
m4_set(_v35L6_iw, 3, 3, 0);
store64(&_v35L6_ro, 0x1234); store64(&_v35L6_rd, 0x5678);
assert_eq(screen_to_world_ray(f64_from(200), f64_from(150), _v35L6_iw, f64_from(800), f64_from(600), &_v35L6_ro,
    &_v35L6_rd), HSB_ERR_DIVISION_BY_ZERO, "w row 0: HSB_ERR_DIVISION_BY_ZERO (3.4.2: rc 0, a NaN direction)");
assert_eq(load64(&_v35L6_ro) + load64(&_v35L6_rd), 0x1234 + 0x5678, "... the out params untouched");
var _v35L6_in = m4_identity();
m4_set(_v35L6_in, 1, 2, 0x7FF0000000000000);
_v35L6_rayreset();
assert_eq(screen_to_world_ray(f64_from(200), f64_from(150), _v35L6_in, f64_from(800), f64_from(600), &_v35L6_ro,
    &_v35L6_rd), HSB_ERR_INVALID_INPUT, "an infinite entry: HSB_ERR_INVALID_INPUT");
# An infinite GL far plane, its inverse exact (near 1): NDC z = +1 has w = 0, a direction. The ray
# runs from the near point (-1/2, 1/2, -1) away from the camera at the origin: (-1, 1, -2) / sqrt(6).
var _v35L6_ip = m4_new();
m4_set(_v35L6_ip, 0, 0, F64_ONE); m4_set(_v35L6_ip, 1, 1, F64_ONE);
m4_set(_v35L6_ip, 3, 2, 0xBFF0000000000000);
m4_set(_v35L6_ip, 2, 3, 0xBFE0000000000000); m4_set(_v35L6_ip, 3, 3, F64_HALF);
_v35L6_rayreset();
assert_eq(screen_to_world_ray(f64_from(200), f64_from(150), _v35L6_ip, f64_from(800), f64_from(600), &_v35L6_ro,
    &_v35L6_rd), 0, "infinite far plane: rc 0 (3.4.2: rc 0 with a NaN direction)");
assert_eq(HVec3_x(load64(&_v35L6_ro)) + HVec3_z(load64(&_v35L6_ro)), 0xBFE0000000000000 + 0xBFF0000000000000,
  "... origin (-1/2, 1/2, -1)");
assert_eq(HVec3_x(load64(&_v35L6_rd)), 0xBFDA20BD700C2C3E, "... direction x = -1 / sqrt(6)");
assert_eq(HVec3_z(load64(&_v35L6_rd)), 0xBFEA20BD700C2C3E, "... direction z = -2 / sqrt(6), away from the camera");
# The same camera moved 10^6 along x: the point at z = 1 - 2^-29 lies 2^30 times further along the
# ray than the near point, so their difference keeps the direction's bits (one at z = 1/2, 3 units
# along, would carry 10^6 u of the near point's rounding). Pixel (123, 456): the exact direction is
# (nx, ny, -1) normalised, x and z oracle-nearest, y 1 ulp.
m4_set(_v35L6_ip, 2, 0, 0xC11E84800CCCCCCD); m4_set(_v35L6_ip, 3, 0, 0x411E84800CCCCCCD);   # -+500000.0125
_v35L6_rayreset();
assert_eq(screen_to_world_ray(f64_from(123), f64_from(456), _v35L6_ip, f64_from(800), f64_from(600), &_v35L6_ro,
    &_v35L6_rd), 0, "infinite far plane, camera at x = 10^6: rc 0");
assert_eq(HVec3_x(load64(&_v35L6_rd)), 0xBFE0C06884F9B2F1, "... direction x, oracle-nearest");
assert_eq(HVec3_y(load64(&_v35L6_rd)), 0xBFD9285A6D21F954, "... direction y, 1 ulp");
assert_eq(HVec3_z(load64(&_v35L6_rd)), 0xBFE830A5B7B45C0B, "... direction z, oracle-nearest");
# Near and far 2^1024 apart: far - near overflows, and is formed from halves: the direction (0, 0, 1).
var _v35L6_ib = m4_identity();
m4_set(_v35L6_ib, 2, 2, 0x7FE0000000000000);
_v35L6_rayreset();
assert_eq(screen_to_world_ray(f64_from(400), f64_from(300), _v35L6_ib, f64_from(800), f64_from(600), &_v35L6_ro,
    &_v35L6_rd), 0, "far - near past DBL_MAX: rc 0");
assert_eq(HVec3_z(load64(&_v35L6_rd)), F64_ONE, "... direction z = 1 (not NaN)");
assert_eq(HVec3_z(load64(&_v35L6_ro)), 0xFFE0000000000000, "... origin z = -2^1023");
# The review's far point past the double range: w = 2^-1074 nx at z = +1, not 0, so the far point is
# (nx, ny, 1) / (-0.75 2^-1074), finite but beyond DBL_MAX. Its direction from the near point is
# defined: (0.75, -0.833, -1) / 1.502 nearly, each component within 0.74 ulp of the exact ray's.
# [measured: scratch ray.py (Fraction unprojections), 2026-11-14; cycc 6.7.18]
var _v35L6_ifo = m4_identity();
m4_set(_v35L6_ifo, 0, 3, 1); m4_set(_v35L6_ifo, 2, 3, 0xBFE0000000000000); m4_set(_v35L6_ifo, 3, 3, F64_HALF);
_v35L6_rayreset();
assert_eq(screen_to_world_ray(f64_from(100), f64_from(50), _v35L6_ifo, f64_from(800), f64_from(600), &_v35L6_ro,
    &_v35L6_rd), 0, "far point past DBL_MAX: rc 0");
assert_eq(HVec3_x(load64(&_v35L6_rd)), 0x3FDFF363206BD5DB, "... direction x (the first review tree: NaN)");
assert_eq(HVec3_y(load64(&_v35L6_rd)), 0xBFE1C01AA03BE896, "... direction y");
assert_eq(HVec3_z(load64(&_v35L6_rd)), 0xBFE54CECC047E3E7, "... direction z");
assert_eq(HVec3_x(load64(&_v35L6_ro)), 0xBFE8000000000000, "... origin x = nx = -0.75, finite");
# w = 2^-1074 everywhere: the near point is past the range too, an origin no HVec3 holds.
var _v35L6_ioo = m4_identity();
m4_set(_v35L6_ioo, 3, 3, 1);
store64(&_v35L6_ro, 0x1234); store64(&_v35L6_rd, 0x5678);
assert_eq(screen_to_world_ray(f64_from(100), f64_from(50), _v35L6_ioo, f64_from(800), f64_from(600), &_v35L6_ro,
    &_v35L6_rd), HSB_ERR_OUT_OF_RANGE, "near point past DBL_MAX: HSB_ERR_OUT_OF_RANGE (was rc 0, origin -Inf)");
assert_eq(load64(&_v35L6_ro) + load64(&_v35L6_rd), 0x1234 + 0x5678, "... the out params untouched");
# The infinite far plane with the near point at 1e300 scale: the z = 1 - 2^-29 point is past the
# range, and the direction is the unscaled camera's (x and y its bits, z 1 ulp), 0.97 ulp at most.
var _v35L6_ifs = m4_new();
m4_set(_v35L6_ifs, 0, 0, 0x7E37E43C8800759C); m4_set(_v35L6_ifs, 1, 1, 0x7E37E43C8800759C);
m4_set(_v35L6_ifs, 3, 2, 0xFE37E43C8800759C);
m4_set(_v35L6_ifs, 2, 3, 0xBFE0000000000000); m4_set(_v35L6_ifs, 3, 3, F64_HALF);
_v35L6_rayreset();
assert_eq(screen_to_world_ray(f64_from(123), f64_from(456), _v35L6_ifs, f64_from(800), f64_from(600), &_v35L6_ro,
    &_v35L6_rd), 0, "infinite far plane, near point 1e300 away: rc 0");
assert_eq(HVec3_x(load64(&_v35L6_rd)), 0xBFE0C06884F9B2F1, "... direction x (the first review tree: NaN)");
assert_eq(HVec3_z(load64(&_v35L6_rd)), 0xBFE830A5B7B45C0C, "... direction z");
# An ordinary inverse view-projection: the 3.4.2 bits (the same unprojection where 1/w is normal).
var _v35L6_a4 = m4_from_srt(hvec3_one(), hquat_from_rotation_y(F64_HALF),
  hvec3_new(F64_ONE, F64_TWO, 0x4008000000000000));
var _v35L6_pr = m4_perspective_rh(F64_ONE, 0x3FF5555555555555, 0x3FB999999999999A, 0x4059000000000000);
var _v35L6_ivt, _v35L6_iv = m4_inverse_checked(m4_mul(_v35L6_pr, _v35L6_a4));
_v35L6_rayreset();
assert_eq(screen_to_world_ray(f64_from(123), f64_from(456), _v35L6_iv, f64_from(800), f64_from(600), &_v35L6_ro,
    &_v35L6_rd), 0, "ordinary: rc 0");
assert_eq(HVec3_x(load64(&_v35L6_ro)), 0x3FE20F50F08CA101, "ordinary: origin x, 3.4.2's bits");
assert_eq(HVec3_z(load64(&_v35L6_rd)), 0xBFEF004A1BE734BC, "ordinary: direction z, 3.4.2's bits");

# ================================================================
test_group("3.5.0 L6: m4_transform_point_frexp_checked (review)");
var _v35L6_fe: i64[1];
var _v35L6_fv = hvec3_new(0x4008000000000000, 0x4014000000000000, 0x401C000000000000);   # (3, 5, 7)
var _v35L6_f1t, _v35L6_f1 = m4_transform_point_frexp_checked(m4_identity(), _v35L6_fv, &_v35L6_fe);
assert_eq(HVec3_z(_v35L6_ok(_v35L6_f1t, _v35L6_f1)), 0x3FFC000000000000,
  "I (3, 5, 7): q.z = 7/4, the largest in [1, 2)");
assert_eq(HVec3_x(_v35L6_f1), 0x3FE8000000000000, "... q.x = 3/4");
assert_eq(load64(&_v35L6_fe), 2, "... e = 2");
# w = 2^-1074: the point (3, 5, 7) 2^1074 is past DBL_MAX, as `m4_transform_point_checked`'s +Inf.
var _v35L6_fm = m4_identity();
m4_set(_v35L6_fm, 3, 3, 1);
var _v35L6_f2t, _v35L6_f2 = m4_transform_point_frexp_checked(_v35L6_fm, _v35L6_fv, &_v35L6_fe);
assert_eq(HVec3_y(_v35L6_ok(_v35L6_f2t, _v35L6_f2)), 0x3FF4000000000000, "w = 2^-1074: q.y = 5/4");
assert_eq(load64(&_v35L6_fe), 1076, "... e = 1076: the point is (3, 5, 7) 2^1074");
var _v35L6_f3t, _v35L6_f3 = m4_transform_point_frexp_checked(_v35L6_fm, hvec3_zero(), &_v35L6_fe);
assert_eq(HVec3_x(_v35L6_ok(_v35L6_f3t, _v35L6_f3)) + HVec3_z(_v35L6_f3), 0, "the origin: q = 0");
assert_eq(load64(&_v35L6_fe), 0, "... e = 0");
var _v35L6_f4t, _v35L6_f4 = m4_transform_point_frexp_checked(_v35L6_iw, _v35L6_fv, &_v35L6_fe);
assert_eq(_v35L6_err(_v35L6_f4t, _v35L6_f4), HSB_ERR_DIVISION_BY_ZERO, "w row 0: Err(DIVISION_BY_ZERO)");
var _v35L6_f5t, _v35L6_f5 = m4_transform_point_frexp_checked(_v35L6_in, _v35L6_fv, &_v35L6_fe);
assert_eq(_v35L6_err(_v35L6_f5t, _v35L6_f5), HSB_ERR_INVALID_INPUT, "an infinite entry: Err(INVALID_INPUT)");
var _v35L6_f6t, _v35L6_f6 = m4_transform_point_frexp_checked(m4_identity(), _v35L6_fv, 0);
assert_eq(_v35L6_err(_v35L6_f6t, _v35L6_f6), HSB_ERR_INVALID_INPUT, "out_e = 0: Err(INVALID_INPUT)");
# A negative w: the signs of 0 / w and of the quotients follow it, as through the exact path.
var _v35L6_fn = m4_identity();
m4_set(_v35L6_fn, 3, 3, 0xBFF0000000000000);
var _v35L6_f7t, _v35L6_f7 = m4_transform_point_frexp_checked(_v35L6_fn, hvec3_new(0, F64_TWO, 0), &_v35L6_fe);
assert_eq(HVec3_x(_v35L6_ok(_v35L6_f7t, _v35L6_f7)), 0x8000000000000000, "w = -1: 0 / w is -0");
assert_eq(HVec3_y(_v35L6_f7), 0xBFF0000000000000, "... 2 / -1 = -1 2^1");
assert_eq(load64(&_v35L6_fe), 1, "... e = 1");

# ================================================================
test_group("3.5.0 L6: world_to_screen_checked's depth range (F-X1)");
var _v35L6_rz = m4_perspective_reverse_z(0x3FF0C152382D7365, 0x3FF5555555555555, 0x3FB999999999999A);
var _v35L6_w1t, _v35L6_w1 = world_to_screen_checked(hvec3_new(0, 0, 0xC014000000000000), _v35L6_rz, f64_from(800),
  f64_from(600), NDC_Z_ZERO_TO_ONE);
# depth = nz = near * (1 / 5): two roundings, one ulp above the exact 0.1 / 5 (3F947AE147AE147B)
assert_eq(HVec3_z(_v35L6_ok(_v35L6_w1t, _v35L6_w1)), 0x3F947AE147AE147C, "reverse-Z, [0, 1]: depth = nz");
assert_eq(linearize_depth_reverse_z(HVec3_z(_v35L6_w1), 0x3FB999999999999A), 0x4013FFFFFFFFFFFF,
  "... which linearize_depth_reverse_z reads back as 5, within an ulp (the GL depth read 0.196)");
var _v35L6_w2t, _v35L6_w2 = world_to_screen_checked(hvec3_new(0, 0, 0xC014000000000000), _v35L6_rz, f64_from(800),
  f64_from(600), NDC_Z_MINUS_ONE_TO_ONE);
assert_eq(HVec3_z(_v35L6_ok(_v35L6_w2t, _v35L6_w2)), 0x3FE051EB851EB852, "the GL range keeps 3.4.2's nz / 2 + 1/2");
assert_eq(HVec3_x(_v35L6_w1), HVec3_x(_v35L6_w2), "x does not depend on the range");
var _v35L6_w3t, _v35L6_w3 = world_to_screen_checked(hvec3_zero(), _v35L6_rz, f64_from(800), f64_from(600), 2);
assert_eq(_v35L6_err(_v35L6_w3t, _v35L6_w3), HSB_ERR_INVALID_INPUT, "range 2: Err(INVALID_INPUT)");
var _v35L6_w4t, _v35L6_w4 = world_to_screen_checked(hvec3_zero(), _v35L6_rz, f64_from(800), f64_from(600), 0 - 1);
assert_eq(_v35L6_err(_v35L6_w4t, _v35L6_w4), HSB_ERR_INVALID_INPUT, "range -1: Err(INVALID_INPUT)");

# ================================================================
test_group("3.5.0 L6: hquat_from_axis_angle_checked (MAT F4)");
var _v35L6_q1t, _v35L6_q1 = hquat_from_axis_angle_checked(hvec3_new(F64_TWO, 0, 0), F64_PI_2);
assert_eq(HQuat_x(_v35L6_ok(_v35L6_q1t, _v35L6_q1)), 0x3FE6A09E667F3BCC,
  "axis (2, 0, 0), pi/2: x = sin(pi/4) (3.4.2: 2 sin)");
assert_eq(HQuat_w(_v35L6_q1), 0x3FE6A09E667F3BCD, "... w = cos(pi/4)");
var _v35L6_q2t, _v35L6_q2 = hquat_from_axis_angle_checked(hvec3_unit_z(), F64_PI_2);
assert_eq(HQuat_z(_v35L6_ok(_v35L6_q2t, _v35L6_q2)), 0x3FE6A09E667F3BCC, "a unit axis: 3.4.2's bits, z = sin(pi/4)");
var _v35L6_q3t, _v35L6_q3 = hquat_from_axis_angle_checked(hvec3_new(F64_ONE, F64_TWO, F64_TWO), 0x3FF0C152382D7365);
assert_eq(HQuat_x(_v35L6_ok(_v35L6_q3t, _v35L6_q3)), 0x3FC5555555555554, "axis (1, 2, 2), pi/3: x = sin(pi/6) / 3");
assert_eq(HQuat_y(_v35L6_q3), 0x3FD5555555555554, "... y = 2 sin(pi/6) / 3");
var _v35L6_q4t, _v35L6_q4 = hquat_from_axis_angle_checked(hvec3_zero(), 0);
assert_eq(HQuat_w(_v35L6_ok(_v35L6_q4t, _v35L6_q4)), F64_ONE, "zero axis, angle 0: the identity");
var _v35L6_q5t, _v35L6_q5 = hquat_from_axis_angle_checked(hvec3_zero(), F64_ONE);
assert_eq(_v35L6_err(_v35L6_q5t, _v35L6_q5), HSB_ERR_DIVISION_BY_ZERO, "zero axis, angle 1: Err (3.4.2: the identity)");
var _v35L6_q6t, _v35L6_q6 = hquat_from_axis_angle_checked(hvec3_unit_x(), 0x7FF0000000000000);
assert_eq(_v35L6_err(_v35L6_q6t, _v35L6_q6), HSB_ERR_INVALID_INPUT, "angle +Inf: Err(INVALID_INPUT)");
var _v35L6_q7t, _v35L6_q7 = hquat_from_axis_angle_checked(hvec3_new(0, 0x7FF8000000000000, 0), F64_ONE);
assert_eq(_v35L6_err(_v35L6_q7t, _v35L6_q7), HSB_ERR_INVALID_INPUT, "a NaN axis: Err(INVALID_INPUT)");
var _v35L6_q8t, _v35L6_q8 = hquat_from_axis_angle_checked(0, F64_ONE);
assert_eq(_v35L6_err(_v35L6_q8t, _v35L6_q8), HSB_ERR_INVALID_INPUT, "a 0 handle: Err(INVALID_INPUT)");

# ================================================================
test_group("3.5.0 L6: hquat_slerp of an identical pair at any t (MAT4, R2-MAT N6)");
var _v35L6_sa = hquat_new(0x3FE3333333333333, 0x3FE999999999999A, 0, 0);
var _v35L6_sq = hquat_slerp(_v35L6_sa, _v35L6_sa, 0x4340000000000000);
assert_eq(HQuat_x(_v35L6_sq) + HQuat_y(_v35L6_sq), 0x3FE3333333333333 + 0x3FE999999999999A,
  "t = 2^53: a (3.4.2: (0.7071, 0.7071, 0, 0))");
var _v35L6_sq2 = hquat_slerp(_v35L6_sa, _v35L6_sa, 0x4350000000000000);
assert_eq(HQuat_x(_v35L6_sq2), 0x3FE3333333333333, "t = 2^54: a's x (3.4.2: NaN)");
var _v35L6_sq3 = hquat_slerp(_v35L6_sa, _v35L6_sa, 0x4360000000000000);
assert_eq(HQuat_y(_v35L6_sq3), 0x3FE999999999999A, "t = 2^55: a's y (3.4.2: NaN)");
var _v35L6_sq4 = hquat_slerp(_v35L6_sa, _v35L6_sa, F64_HALF);
assert_eq(HQuat_x(_v35L6_sq4), 0x3FE3333333333333, "t = 1/2: a's own bits (3.4.2: the normalised lerp's)");
var _v35L6_sb5 = hquat_new(0xBFE3333333333333, 0xBFE999999999999A, 0x8000000000000000, 0);
var _v35L6_sq5 = hquat_slerp(_v35L6_sa, _v35L6_sb5, 0xC024000000000000);
assert_eq(HQuat_y(_v35L6_sq5), 0x3FE999999999999A, "an antipodal pair at t = -10: a");
assert_eq(_v35L6_nan(HQuat_x(hquat_slerp(_v35L6_sa, _v35L6_sa, 0x7FF0000000000000))), 1, "t = +Inf: NaN, as before");
# A non-unit identical pair (outside the unit contract): with d >= 1 the exit gives a itself, not
# a / |a| as through 3.4.2; with d <= 0.9995 the acos form, like any pair there.
var _v35L6_sn2 = hquat_new(F64_TWO, 0, 0, 0);
assert_eq(HQuat_x(hquat_slerp(_v35L6_sn2, _v35L6_sn2, F64_HALF)), F64_TWO, "(2, 0, 0, 0) with itself: 2 (3.4.2: 1)");
var _v35L6_sn3 = hquat_new(F64_HALF, 0, 0, 0);
assert_eq(HQuat_x(hquat_slerp(_v35L6_sn3, _v35L6_sn3, F64_HALF)), 0x3FE43D136248490E,
  "(1/2, 0, 0, 0) with itself, d = 1/4: the acos form's 0.633, not a");
# A pair that differs in w alone is not identical: the lerp branch, w = 1e-9 / 2.
var _v35L6_sb6 = hquat_new(0x3FE3333333333333, 0x3FE999999999999A, 0, 0x3E112E0BE826D695);
assert_eq(HQuat_w(hquat_slerp(_v35L6_sa, _v35L6_sb6, F64_HALF)), 0x3E012E0BE826D695, "a pair differing in w: not a");

# ================================================================
test_group("3.5.0 L6: tone maps at +-Inf, linearize_depth past the ratio (LIE2 F2, RV-LIE N7)");
assert_eq(HVec3_x(tonemap_reinhard(0x7FF0000000000000, 0, 0)), F64_ONE, "reinhard(+Inf) = 1, the limit (3.4.2: NaN)");
assert_eq(HVec3_y(tonemap_reinhard(0, 0xFFF0000000000000, 0)), F64_ONE, "reinhard(-Inf) = 1, the limit");
assert_eq(HVec3_z(tonemap_reinhard(0, 0, F64_ONE)), F64_HALF, "reinhard(1) = 1/2, the finite path");
assert_eq(HVec3_z(tonemap_reinhard(0, 0, 0x7FF0000000000000)), F64_ONE, "reinhard's third channel at +Inf = 1");
assert_eq(HVec3_x(tonemap_reinhard_extended(0x7FF0000000000000, 0, 0, F64_ONE)), 0x7FF0000000000000,
  "reinhard_ext(+Inf, 1) = +Inf (3.4.2: NaN)");
assert_eq(HVec3_x(tonemap_reinhard_extended(0xFFF0000000000000, 0, 0, F64_ONE)), 0xFFF0000000000000,
  "reinhard_ext(-Inf, 1) = -Inf, x / w^2's limit");
assert_eq(HVec3_x(tonemap_reinhard_extended(0x7FF0000000000000, 0, 0, 0x7FF0000000000000)), F64_ONE,
  "reinhard_ext(+Inf, white +Inf) = 1, Reinhard's limit");
assert_eq(_v35L6_nan(HVec3_x(tonemap_reinhard_extended(0x7FF0000000000000, 0, 0, 0x7FF8000000000000))), 1,
  "reinhard_ext(+Inf, white NaN) = NaN");
assert_eq(HVec3_x(tonemap_reinhard_extended(0x7FF0000000000000, 0, 0, 0)), 0x7FF0000000000000,
  "reinhard_ext(+Inf, white 0) = +Inf");
assert_eq(HVec3_x(tonemap_aces(0x7FF0000000000000, 0, 0)), F64_ONE, "aces(+Inf) = 1, 2.51 / 2.43 clamped (3.4.2: NaN)");
assert_eq(HVec3_x(tonemap_aces(0xFFF0000000000000, 0, 0)), F64_ONE, "aces(-Inf) = 1, the same limit");
assert_eq(_v35L6_nan(HVec3_x(tonemap_aces(0x7FF8000000000000, 0, 0))), 1, "aces(NaN) = NaN");
assert_eq(linearize_depth(F64_ONE, 0x16687E92154EF7AC, 0x6974E718D7D7625A), 0x6974E718D7D7625A,
  "linearize_depth(1, 1e-200, 1e200) = 1e200, far exactly (3.4.2: +Inf)");
assert_eq(linearize_depth(0, 0x6974E718D7D7625A, 0x16687E92154EF7AC), 0x6974E718D7D7625A,
  "linearize_depth(0, 1e200, 1e-200) = 1e200, near exactly (3.4.2: NaN)");
assert_eq(linearize_depth(F64_HALF, 0x6974E718D7D7625A, 0x16687E92154EF7AC), 0x16787E92154EF7AC,
  "linearize_depth(0.5, 1e200, 1e-200) = 2e-200, oracle-nearest (3.4.2: 0)");
assert_eq(linearize_depth(0x3FE8000000000000, 0x3F847AE147AE147B, 0x4059000000000000), 0x3FA4794EBF611F74,
  "an ordinary depth keeps 3.4.2's bits");
assert_eq(_v35L6_nan(linearize_depth(F64_ONE, 0, 0x4014000000000000)), 1, "near 0 at ndc 1: NaN, 0 / 0");
# near / far past DBL_MAX with a subnormal ndc: the branch's quotient over 2^-1000, so far / near is
# not rounded on the subnormal grid (the first review tree: 3.4e9 ulp off).
# [measured: scratch ld.py (Fraction oracle), 2026-11-14; cycc 6.7.18]
assert_eq(linearize_depth(0x0000000000000301, 0x65B6D66432F1ECB8, 0x21E960B40CE78894), 0x6470E58015A1A9DD,
  "linearize_depth(3.8e-321, 9.48e181, 2.54e-145) = 6.6864233e175, 0.03 ulp");
assert_eq(linearize_depth(F64_HALF, 0x7FF0000000000000, 0x46293E5939A08CEA), 0x46393E5939A08CEA,
  "near +Inf, far 1e30 (far 2^1000 would overflow): far / ndc = 2e30");
assert_eq(linearize_depth(0x46293E5939A08CEA, 0x6974E718D7D7625A, 0x16687E92154EF7AC), 0x102F0CE4839198DA,
  "ndc 1e30, outside [0, 1] (ndc 2^1000 would overflow): the formula's 1e-230");
assert_eq(linearize_depth(F64_ONE, 0x01A56E1FC2F8F359, 0x4202A05F20000000), 0x4202A05F20000000,
  "linearize_depth(1, 1e-300, 1e10) = 1e10: near / far is subnormal, rounded, not flushed");

# ================================================================
test_group("3.5.0 L6: zero signs on consumer pins below cycc 6.6.8 (MAT F1)");
# Each is a flip of the sign bit. Under cycc 6.7.18 `f64_neg` gives the same bits, so on the CI pin
# the f64_neg forms are equivalent mutants no suite can tell apart; under 6.6.3 to 6.6.7, which the
# bundle's 6.6.3 floor admits, it gave +0 for +0, and these assertions fail on those forms there.
# Two -0s are tested with `&` (both sign bits), never a sum: 2^63 + 2^63 wraps to the +0 + +0 it
# should tell apart.
# On this tree's bundle hvec3_neg(0).x is -0 under all three, f64_neg(0) +0 under 6.6.3 and 6.6.7.
# [measured: scratch p6.6.3 / p6.6.7 / p6.7.18 probes of the regenerated bundle, 2026-11-14]
var _v35L6_zv2 = hvec2_neg(hvec2_zero());
assert_eq(HVec2_x(_v35L6_zv2) & HVec2_y(_v35L6_zv2), 0x8000000000000000,
  "hvec2_neg(0) = (-0, -0)");
var _v35L6_z3 = hvec3_neg(hvec3_zero());
assert_eq(HVec3_x(_v35L6_z3) & HVec3_z(_v35L6_z3), 0x8000000000000000, "hvec3_neg(0): -0");
assert_eq(HVec3_y(_v35L6_z3), 0x8000000000000000, "hvec3_neg(0).y = -0");
var _v35L6_z4 = hvec4_neg(hvec4_zero());
assert_eq(HVec4_w(_v35L6_z4), 0x8000000000000000, "hvec4_neg(0).w = -0");
assert_eq(HVec4_x(_v35L6_z4), 0x8000000000000000, "hvec4_neg(0).x = -0");
var _v35L6_zc = hquat_conjugate(hquat_identity());
assert_eq(HQuat_x(_v35L6_zc) & HQuat_z(_v35L6_zc), 0x8000000000000000,
  "hquat_conjugate(1) = (-0, ., -0, 1)");
assert_eq(HQuat_y(_v35L6_zc), 0x8000000000000000, "hquat_conjugate(1).y = -0");
var _v35L6_zf = m4_flip_handedness_z(m4_identity());
assert_eq(m4_get(_v35L6_zf, 2, 0) & m4_get(_v35L6_zf, 2, 3), 0x8000000000000000,
  "m4_flip_handedness_z(I): column 2's zeros are -0");
assert_eq(m4_get(_v35L6_zf, 2, 2), 0xBFF0000000000000, "m4_flip_handedness_z(I): (2, 2) = -1");
var _v35L6_zo = m4_ortho_rh(0xBFF0000000000000, F64_ONE, 0xBFF0000000000000, F64_ONE, F64_ONE, 0x4059000000000000);
assert_eq(m4_get(_v35L6_zo, 3, 0) & m4_get(_v35L6_zo, 3, 1), 0x8000000000000000,
  "m4_ortho_rh, a symmetric frustum: the zero translations are -0");
var _v35L6_zit, _v35L6_ziv = hquat_inverse_checked(hquat_new(0, 0, 0, F64_TWO));
assert_eq(HQuat_x(_v35L6_ok(_v35L6_zit, _v35L6_ziv)), 0x8000000000000000, "hquat_inverse_checked((0, 0, 0, 2)).x = -0");
var _v35L6_zjt, _v35L6_zjv = hquat_inverse_checked(hquat_new(0, 0, 0, 0x1A70000000000000));
assert_eq(HQuat_y(_v35L6_ok(_v35L6_zjt, _v35L6_zjv)), 0x8000000000000000,
  "hquat_inverse_checked((0, 0, 0, 2^-600)).y = -0, the rescue's copy");
# slerp's b negation: a's zeros are -0, b's +0 (d < 0), so a s0 + (-b) s1 is -0 only with the flip.
var _v35L6_zs = hquat_slerp(hquat_new(0x8000000000000000, 0x8000000000000000, 0x3FE3333333333333, 0x3FE999999999999A),
  hquat_new(0, 0, 0xBFE999999999999A, 0xBFE3333333333333), F64_HALF);
assert_eq(HQuat_x(_v35L6_zs), 0x8000000000000000, "hquat_slerp, b negated: x = -0");

# ================================================================
test_group("3.5.0 L6: _hquat_rotate_wide's doubling moves bits (the [3.4.2] carried row)");
# |q|^2 = 0.338 and v near 2^1023: the fast path overflows and the wide path rotates a copy. Its
# y, -6.6e-308 on the subnormal side of |v|'s scale, is the copy's. A turn about y keeps y, so the
# exact answer is v's own y, ...B153: the doubled q gives ...B140, 19 ulp off, and the undoubled
# ...B150, 3 ulp (both 0 u |v|, the contract). The doubling stays (the trust test's bound is derived
# for |q|^2 >= 1), and this pins the less accurate bits it gives: a maintainer's call, carried.
# [measured: scratch rw.cyr / rwchk.py, Fraction rotation, 2026-11-14; cycc 6.7.18]
var _v35L6_wq = hquat_new(0, 0x3FE2015E50C3D2FF, 0, 0x3FC2AB8343B49E6B);
var _v35L6_wv = hvec3_new(0x7FE1960764960884, 0x8027C8532976B153, 0x012DFB5ADB7CDE67);
var _v35L6_wr = hquat_rotate_vec3(_v35L6_wq, _v35L6_wv);
assert_eq(HVec3_y(_v35L6_wr), 0x8027C8532976B140, "the doubled copy's y (undoubled: ...B150)");
assert_eq(HVec3_x(_v35L6_wr), 0xFFDEBE2014E5DDF0, "x, the same either way");
assert_eq(HVec3_z(_v35L6_wr), 0xFFD1164386A70B4D, "z, the same either way");

# ================================================================
test_group("3.5.0 L6: a 0 handle into hvec3_add and its packed siblings (INS5 F3)");
var _v35L6_hv = hvec3_one();
assert_eq(hvec3_add(0, _v35L6_hv), 0, "hvec3_add(0, v) = 0 (3.4.2: rc 139)");
assert_eq(hvec3_add(_v35L6_hv, 0), 0, "hvec3_add(v, 0) = 0");
assert_eq(hvec3_sub(0, _v35L6_hv) + hvec3_sub(_v35L6_hv, 0), 0, "hvec3_sub with a 0 operand = 0");
assert_eq(hvec3_mul(0, _v35L6_hv) + hvec3_mul(_v35L6_hv, 0), 0, "hvec3_mul with a 0 operand = 0");
assert_eq(hvec3_scale(0, F64_TWO), 0, "hvec3_scale(0, s) = 0");
var _v35L6_u1 = alloc_used();
var _v35L6_hz = hvec3_add(0, _v35L6_hv);
assert_eq(alloc_used() - _v35L6_u1, 0, "... before anything is allocated");
assert_eq(HVec3_z(hvec3_add(_v35L6_hv, _v35L6_hv)), F64_TWO, "ordinary operands still add");

# ================================================================
test_group("3.5.0 L6: hvec3_angle_checked (AU2 2b)");
var _v35L6_h1t, _v35L6_h1 = hvec3_angle_checked(hvec3_zero(), hvec3_unit_x());
assert_eq(_v35L6_err(_v35L6_h1t, _v35L6_h1), HSB_ERR_DIVISION_BY_ZERO,
  "a zero: Err(DIVISION_BY_ZERO) (3.4.2: 0, parallel)");
var _v35L6_h2t, _v35L6_h2 = hvec3_angle_checked(hvec3_unit_y(), hvec3_new(0x8000000000000000, 0, 0x8000000000000000));
assert_eq(_v35L6_err(_v35L6_h2t, _v35L6_h2), HSB_ERR_DIVISION_BY_ZERO, "b (-0, 0, -0): Err(DIVISION_BY_ZERO)");
var _v35L6_h3t, _v35L6_h3 = hvec3_angle_checked(hvec3_new(0x7FF8000000000000, 0, 0), hvec3_unit_x());
assert_eq(_v35L6_err(_v35L6_h3t, _v35L6_h3), HSB_ERR_INVALID_INPUT, "NaN: Err(INVALID_INPUT) (3.4.2: NaN)");
var _v35L6_h4t, _v35L6_h4 = hvec3_angle_checked(hvec3_unit_x(), hvec3_new(0, 0xFFF0000000000000, 0));
assert_eq(_v35L6_err(_v35L6_h4t, _v35L6_h4), HSB_ERR_INVALID_INPUT, "-Inf in b: Err(INVALID_INPUT)");
var _v35L6_h5t, _v35L6_h5 = hvec3_angle_checked(0, hvec3_unit_x());
assert_eq(_v35L6_err(_v35L6_h5t, _v35L6_h5), HSB_ERR_INVALID_INPUT, "a 0 handle: Err(INVALID_INPUT)");
var _v35L6_h6t, _v35L6_h6 = hvec3_angle_checked(hvec3_new(F64_ONE, F64_ONE, 0), hvec3_unit_x());
assert_eq(_v35L6_ok(_v35L6_h6t, _v35L6_h6), 0x3FE921FB54442D18, "(1, 1, 0) to x: pi/4, oracle-nearest");
var _v35L6_h7t, _v35L6_h7 = hvec3_angle_checked(hvec3_new(1, 1, 0), hvec3_new(0x7E70000000000000, 0, 0));
assert_eq(_v35L6_ok(_v35L6_h7t, _v35L6_h7), 0x3FE921FB54442D18, "(2^-1074, 2^-1074, 0) to (2^1000, 0, 0): pi/4");

# ==================================================================================================
# 3.5.0 — complex numbers, Lie groups, differential geometry (complex, lie, lie_ext, diffgeo)
# ==================================================================================================
# (Written as tests/v35_L7.tcyr; every global and fn below is prefixed _v35L7_.)

fn _v35L7_nan(x) {
    if (f64_eq(x, x) == 1) { return 0; }
    return 1;
}

# ================================================================
# complex.cyr
# ================================================================
test_group("3.5.0 L7: cx_powf with a zero base");
var _v35L7_z = cx_powf(cx_zero(), 0);
assert_eq(HComplex_re(_v35L7_z), F64_ONE, "cx_powf(0, 0).re = 1: 0^0 is the empty product (3.4.2: 0)");
assert_eq(HComplex_im(_v35L7_z), 0, "cx_powf(0, 0).im = +0: arg(+0 + 0i) times +0");
_v35L7_z = cx_powf(cx_new(0, 0x8000000000000000), 0);
assert_eq(HComplex_re(_v35L7_z), F64_ONE, "cx_powf(+0 - 0i, 0).re = 1");
assert_eq(HComplex_im(_v35L7_z), 0x8000000000000000, "cx_powf(+0 - 0i, 0).im = -0: arg -0 times +0");
_v35L7_z = cx_powf(cx_zero(), 0x8000000000000000);
assert_eq(HComplex_re(_v35L7_z), F64_ONE, "cx_powf(0, -0).re = 1");
assert_eq(HComplex_im(_v35L7_z), 0x8000000000000000, "cx_powf(0, -0).im = -0: arg +0 times -0");
_v35L7_z = cx_powf(cx_zero(), 0xBFF0000000000000);
assert_eq(HComplex_re(_v35L7_z), F64_POS_INF, "cx_powf(0, -1).re = +Inf: |0^-1| = pow(0, -1) (3.4.2: 0)");
assert_eq(HComplex_im(_v35L7_z), 0x7FF8000000000000, "cx_powf(0, -1).im = the quiet NaN: 0 has no argument");
var _v35L7_zi = cx_inv(cx_zero());
assert_eq(HComplex_re(_v35L7_z) | (HComplex_im(_v35L7_z) << 1),
  HComplex_re(_v35L7_zi) | (HComplex_im(_v35L7_zi) << 1), "cx_powf(0, -1) has cx_inv(0)'s bits");
_v35L7_z = cx_powf(cx_zero(), 0xBFE0000000000000);
assert_eq(HComplex_re(_v35L7_z), F64_POS_INF, "cx_powf(0, -0.5).re = +Inf");
assert_eq(HComplex_im(_v35L7_z), 0x7FF8000000000000, "cx_powf(0, -0.5).im = NaN");
_v35L7_z = cx_powf(cx_new(0x8000000000000000, 0), 0xFFF0000000000000);
assert_eq(HComplex_re(_v35L7_z), F64_POS_INF, "cx_powf(-0 + 0i, -Inf).re = +Inf, whatever the zero's signs");
assert_eq(HComplex_im(_v35L7_z), 0x7FF8000000000000, "cx_powf(-0 + 0i, -Inf).im = NaN");
_v35L7_z = cx_powf(cx_zero(), 0x8000000000000001);
assert_eq(HComplex_re(_v35L7_z), F64_POS_INF, "cx_powf(0, -2^-1074).re = +Inf: every n < 0");
_v35L7_z = cx_powf(cx_zero(), 1);
assert_eq(HComplex_re(_v35L7_z) | HComplex_im(_v35L7_z), 0, "cx_powf(0, 2^-1074) = +0 + 0i: every n > 0");
_v35L7_z = cx_powf(cx_zero(), F64_POS_INF);
assert_eq(HComplex_re(_v35L7_z) | HComplex_im(_v35L7_z), 0, "cx_powf(0, +Inf) = +0 + 0i");
_v35L7_z = cx_powf(cx_new(0x8000000000000000, 0), F64_TWO);
assert_eq(HComplex_re(_v35L7_z) | HComplex_im(_v35L7_z), 0, "cx_powf(-0 + 0i, 2) = +0 + 0i, both signs +");
_v35L7_z = cx_powf(cx_zero(), 0x7FF8000000000000);
assert_eq(HComplex_re(_v35L7_z), 0x7FF8000000000000, "cx_powf(0, NaN).re is n, the NaN operand");
assert_eq(HComplex_im(_v35L7_z), 0x7FF8000000000000, "cx_powf(0, NaN).im is n");
_v35L7_z = cx_powf(cx_new(0x8000000000000000, 0), 0x7FF0000000000001);
assert_eq(HComplex_re(_v35L7_z), 0x7FF8000000000001,
  "cx_powf(-0 + 0i, sNaN).re is n quieted: decided by the zero-base guard, not pow's arithmetic NaN");
assert_eq(HComplex_im(_v35L7_z), 0x7FF8000000000001, "cx_powf(-0 + 0i, sNaN).im is n quieted");
_v35L7_z = cx_powf(cx_new(1, 0), 0xBFF0000000000000);
assert_eq(HComplex_re(_v35L7_z), F64_POS_INF, "control: cx_powf(2^-1074, -1).re = +Inf (2^1074 overflows)");
assert_eq(HComplex_im(_v35L7_z), 0x8000000000000000, "control: a nonzero base keeps its angle: im = -0, not NaN");

test_group("3.5.0 L7: cx_div / cx_inv at the pole");
_v35L7_z = cx_div(cx_one(), cx_zero());
assert_eq(HComplex_re(_v35L7_z), F64_POS_INF, "(1 + 0i) / (+0 + 0i): re +Inf = +Inf * 1 (3.4.2: +0)");
assert_eq(HComplex_im(_v35L7_z), 0x7FF8000000000000, "(1 + 0i) / (+0 + 0i): im NaN = Inf * 0 (3.4.2: +0)");
_v35L7_z = cx_div(cx_one(), cx_new(0x8000000000000000, 0));
assert_eq(HComplex_re(_v35L7_z), 0xFFF0000000000000, "(1 + 0i) / (-0 + 0i): re -Inf, copysign(Inf, -0) * 1");
_v35L7_z = cx_div(cx_one(), cx_new(0, 0x8000000000000000));
assert_eq(HComplex_re(_v35L7_z), F64_POS_INF, "(1 + 0i) / (+0 - 0i): re +Inf, the imaginary zero's sign unread");
_v35L7_z = cx_div(cx_new(f64_from(3), f64_from(4)), cx_zero());
assert_eq(HComplex_re(_v35L7_z), F64_POS_INF, "(3 + 4i) / 0: re +Inf");
assert_eq(HComplex_im(_v35L7_z), F64_POS_INF, "(3 + 4i) / 0: im +Inf");
_v35L7_z = cx_div(cx_new(f64_from(0 - 3), f64_from(4)), cx_new(0x8000000000000000, 0x8000000000000000));
assert_eq(HComplex_re(_v35L7_z), F64_POS_INF, "(-3 + 4i) / (-0 - 0i): re -Inf * -3 = +Inf");
assert_eq(HComplex_im(_v35L7_z), 0xFFF0000000000000, "(-3 + 4i) / (-0 - 0i): im -Inf * 4 = -Inf");
_v35L7_z = cx_div(cx_zero(), cx_zero());
assert_eq(HComplex_re(_v35L7_z), 0x7FF8000000000000, "0 / 0: re NaN, no value (3.4.2: +0)");
assert_eq(HComplex_im(_v35L7_z), 0x7FF8000000000000, "0 / 0: im NaN");
_v35L7_z = cx_div(cx_new(0, F64_TWO), cx_zero());
assert_eq(HComplex_re(_v35L7_z), 0x7FF8000000000000, "2i / 0: re NaN (Inf * 0)");
assert_eq(HComplex_im(_v35L7_z), F64_POS_INF, "2i / 0: im +Inf, an infinity");
_v35L7_z = cx_div(cx_new(F64_POS_INF, 0), cx_zero());
assert_eq(HComplex_re(_v35L7_z), F64_POS_INF, "Inf / 0: re +Inf");
assert_eq(HComplex_im(_v35L7_z), 0x7FF8000000000000, "Inf / 0: im NaN");
_v35L7_z = cx_div(cx_new(0x7FF0000000000001, F64_ONE), cx_zero());
assert_eq(HComplex_re(_v35L7_z), 0x7FF8000000000001, "sNaN + 1i over 0: re the NaN operand, quieted");
assert_eq(HComplex_im(_v35L7_z), F64_POS_INF, "sNaN + 1i over 0: im +Inf, the known nonzero part");
_v35L7_z = cx_div(cx_new(0xFFF0000000000002, 0), cx_zero());
assert_eq(HComplex_re(_v35L7_z), 0xFFF8000000000002, "-sNaN + 0i over 0: re the NaN quieted, its sign kept");
assert_eq(HComplex_im(_v35L7_z), 0x7FF8000000000000, "-sNaN + 0i over 0: im NaN, 0 * Inf");
_v35L7_z = cx_inv(cx_zero());
assert_eq(HComplex_re(_v35L7_z), F64_POS_INF, "cx_inv(+0 + 0i).re = +Inf (3.4.2: +0)");
assert_eq(HComplex_im(_v35L7_z), 0x7FF8000000000000, "cx_inv(+0 + 0i).im = NaN (3.4.2: +0)");
_v35L7_z = cx_inv(cx_new(0x8000000000000000, 0x8000000000000000));
assert_eq(HComplex_re(_v35L7_z), 0xFFF0000000000000, "cx_inv(-0 - 0i).re = -Inf");
assert_eq(HComplex_im(_v35L7_z), 0x7FF8000000000000, "cx_inv(-0 - 0i).im = NaN");
_v35L7_z = cx_inv(cx_new(0, 0x8000000000000000));
assert_eq(HComplex_re(_v35L7_z), F64_POS_INF, "cx_inv(+0 - 0i).re = +Inf: the real zero's sign, not the imaginary");
_v35L7_z = cx_inv(cx_inv(cx_zero()));
assert_eq(HComplex_re(_v35L7_z) | HComplex_im(_v35L7_z), 0, "cx_inv(cx_inv(0)) = 0 + 0i: 1 / Inf (C99 G.5.1)");
_v35L7_z = cx_div(cx_one(), cx_new(1, 0));
assert_eq(HComplex_re(_v35L7_z), F64_POS_INF, "control: 1 / 2^-1074 is the quotient, +Inf by overflow");
assert_eq(HComplex_im(_v35L7_z), 0, "control: 1 / 2^-1074: im +0, Smith's, not the pole's NaN");

test_group("3.5.0 L7: cx_mul past DBL_MAX");
_v35L7_z = cx_mul(cx_new(0x7E37E43C8800759C, 0x7E37E43C8800759C), cx_new(0x4202A05F20000000, 0xC202A05F20000000));
assert_eq(HComplex_re(_v35L7_z), F64_POS_INF, "(1e300 (1 + i)) (1e10 (1 - i)).re = +Inf: 2e310 (3.4.2: +Inf)");
assert_eq(HComplex_im(_v35L7_z), 0, "(1e300 (1 + i)) (1e10 (1 - i)).im = +0, exact (3.4.2: NaN)");
_v35L7_z = cx_mul(cx_new(0x7E37E43C8800759C, 0x7E37E43C8800759C), cx_new(0x4202A05F20000000, 0x4202A05F20000000));
assert_eq(HComplex_re(_v35L7_z), 0, "(1e300 (1 + i)) (1e10 (1 + i)).re = +0, exact (3.4.2: NaN)");
assert_eq(HComplex_im(_v35L7_z), F64_POS_INF, "(1e300 (1 + i)) (1e10 (1 + i)).im = +Inf");
_v35L7_z = cx_mul(cx_new(0xFE37E43C8800759C, 0x7E37E43C8800759C), cx_new(0x4202A05F20000000, 0x4202A05F20000000));
assert_eq(HComplex_re(_v35L7_z), 0xFFF0000000000000, "(1e300 (-1 + i)) (1e10 (1 + i)).re = -Inf");
assert_eq(HComplex_im(_v35L7_z), 0, "(1e300 (-1 + i)) (1e10 (1 + i)).im = +0 (x - x)");
_v35L7_z = cx_mul(cx_new(0x7FE0000000000000, 0x0000000000000001), cx_new(0x4000000000000000, 0x7FE0000000000000));
assert_eq(HComplex_re(_v35L7_z), F64_POS_INF, "(2^1023 + 2^-1074 i)(2 + 2^1023 i).re = 2^1024: +Inf");
assert_eq(HComplex_im(_v35L7_z), F64_POS_INF, "(2^1023 + 2^-1074 i)(2 + 2^1023 i).im = 2^2046 + 2^-1073: +Inf");
_v35L7_z = cx_mul(cx_new(F64_POS_INF, 0), cx_new(F64_ONE, 0));
assert_eq(HComplex_re(_v35L7_z), F64_POS_INF, "(Inf + 0i)(1 + 0i).re = +Inf: an infinite operand keeps the formula");
assert_eq(_v35L7_nan(HComplex_im(_v35L7_z)), 1, "(Inf + 0i)(1 + 0i).im = Inf * 0: NaN, C99's _Cmultd too");
_v35L7_z = cx_mul(cx_new(0x7E37E43C8800759C, 0x7FF8000000000000), cx_new(0x4202A05F20000000, 0xC202A05F20000000));
assert_eq(_v35L7_nan(HComplex_im(_v35L7_z)), 1, "a NaN operand keeps the formula's NaN (not the extended path)");
_v35L7_z = cx_mul(cx_new(F64_POS_INF, 0x7E37E43C8800759C), cx_new(0x4202A05F20000000, 0xC202A05F20000000));
assert_eq(_v35L7_nan(HComplex_im(_v35L7_z)), 1, "(Inf + 1e300 i)(1e10 - 1e10 i).im: -Inf + Inf, NaN as formed");
_v35L7_z = cx_mul(cx_new(0x7E37E43C8800759C, 0x7E37E43C8800759C), cx_new(F64_POS_INF, 0xC202A05F20000000));
assert_eq(_v35L7_nan(HComplex_im(_v35L7_z)), 1, "(1e300 (1 + i))(Inf - 1e10 i).im: -1e310 + Inf, NaN as formed");
_v35L7_z = cx_mul(cx_new(0x7E37E43C8800759C, 0x7E37E43C8800759C), cx_new(0x4202A05F20000000, F64_POS_INF));
assert_eq(_v35L7_nan(HComplex_re(_v35L7_z)), 1, "(1e300 (1 + i))(1e10 + Inf i).re: 1e310 - Inf, NaN as formed");
# One part overflows and the other is one product in the subnormals (its other term exactly 0):
# the finite part is the plain formula's, rounded once into the subnormals. The exact parts are
# Fraction products; the review's first fix of 3.5.0 recomputed both and rounded this one twice.
_v35L7_z = cx_mul(cx_new(0x7EF3138B5F5049CF, 0x80000000000000B4), cx_new(0xC2ADA94DE6F039C3, 0x8000000000000000));
assert_eq(HComplex_re(_v35L7_z), 0xFFF0000000000000, "(3.3e303 - 180 2^-1074 i)(-1.6e13 - 0i).re = -Inf");
assert_eq(HComplex_im(_v35L7_z), 0x000A6D856330744F,
  "(3.3e303 - 180 2^-1074 i)(-1.6e13 - 0i).im: 0.445 ulp, correctly rounded (double rounding: ...4E)");
_v35L7_z = cx_mul(cx_new(0x7F693AAD6D975DCD, 0x0000000000000048), cx_new(0x42AD581FC26EA02F, 0));
assert_eq(HComplex_re(_v35L7_z), F64_POS_INF, "(5.5e305 + 72 2^-1074 i)(1.6e13 + 0i).re = +Inf");
assert_eq(HComplex_im(_v35L7_z), 0x0004206477578E87,
  "(5.5e305 + 72 2^-1074 i)(1.6e13 + 0i).im: 0.391 ulp, correctly rounded (double rounding: ...86)");
_v35L7_z = cx_mul(cx_new(0x80000000000000B4, 0x7EF3138B5F5049CF), cx_new(0xC2ADA94DE6F039C3, 0));
assert_eq(HComplex_re(_v35L7_z), 0x000A6D856330744F,
  "(-180 2^-1074 + 3.3e303 i)(-1.6e13 + 0i).re: 0.445 ulp, the plain part kept while im overflows");
assert_eq(HComplex_im(_v35L7_z), 0xFFF0000000000000, "(-180 2^-1074 + 3.3e303 i)(-1.6e13 + 0i).im = -Inf");
_v35L7_z = cx_mul(cx_new(f64_from(3), f64_from(4)), cx_new(f64_from(5), f64_from(0 - 2)));
assert_eq(HComplex_re(_v35L7_z), f64_from(23), "control: (3 + 4i)(5 - 2i).re = 23");
assert_eq(HComplex_im(_v35L7_z), f64_from(14), "control: (3 + 4i)(5 - 2i).im = 14");

test_group("3.5.0 L7: cx_exp past re = 709.78 and C99's rows");
# 710 = 0x4086300000000000, 1e-300 = 0x01A56E1FC2F8F359, 1000 = 0x408F400000000000.
_v35L7_z = cx_exp(cx_new(0x4086300000000000, 0));
assert_eq(HComplex_re(_v35L7_z), F64_POS_INF, "cx_exp(710 + 0i).re = +Inf (e^710 = 2.2e308)");
assert_eq(HComplex_im(_v35L7_z), 0, "cx_exp(710 + 0i).im = +0, C99 (3.4.2: NaN)");
_v35L7_z = cx_exp(cx_new(0x4086300000000000, 0x8000000000000000));
assert_eq(HComplex_im(_v35L7_z), 0x8000000000000000, "cx_exp(710 - 0i).im = -0");
_v35L7_z = cx_exp(cx_new(0x4086300000000000, 0x01A56E1FC2F8F359));
assert_eq(HComplex_im(_v35L7_z), 0x41AAA19C693B7AC7,
  "cx_exp(710 + 1e-300 i).im = 2.234e8, 0.57 ulp from exact, 1 ulp under its rounding (3.4.2: +Inf)");
_v35L7_z = cx_exp(cx_new(0x408F400000000000, 1));
assert_eq(HComplex_im(_v35L7_z), 0x56F9E72379AED73B, "cx_exp(1000 + 2^-1074 i).im = 9.733e110, correctly rounded");
assert_eq(HComplex_re(_v35L7_z), F64_POS_INF, "cx_exp(1000 + 2^-1074 i).re = +Inf (e^1000)");
_v35L7_z = cx_exp(cx_new(0x4096B40000000000, 1));
assert_eq(HComplex_im(_v35L7_z), 0x7FD2D79978FD94EE, "cx_exp(1453 + 2^-1074 i).im = 5.29e307, correctly rounded");
_v35L7_z = cx_exp(cx_new(0x4096BA0000000000, 1));
assert_eq(HComplex_im(_v35L7_z), F64_POS_INF, "cx_exp(1454.5 + 2^-1074 i).im = +Inf: 2.37e308 is past DBL_MAX");
_v35L7_z = cx_exp(cx_new(0x40A1300000000000, 0x8000000000000001));
assert_eq(HComplex_im(_v35L7_z), 0xFFF0000000000000, "cx_exp(2200 - 2^-1074 i).im = -Inf: exp(x - c) overflows");
_v35L7_z = cx_exp(cx_new(F64_POS_INF, 0));
assert_eq(HComplex_re(_v35L7_z), F64_POS_INF, "C99: cexp(+Inf + 0i).re = +Inf");
assert_eq(HComplex_im(_v35L7_z), 0, "C99: cexp(+Inf + 0i).im = +0 (3.4.2: NaN)");
_v35L7_z = cx_exp(cx_new(F64_POS_INF, 0x8000000000000000));
assert_eq(HComplex_im(_v35L7_z), 0x8000000000000000, "C99: cexp(+Inf - 0i).im = -0");
_v35L7_z = cx_exp(cx_new(F64_POS_INF, F64_TWO));
assert_eq(HComplex_re(_v35L7_z), 0xFFF0000000000000, "C99: cexp(+Inf + 2i) = +Inf cis 2: re -Inf (cos 2 < 0)");
assert_eq(HComplex_im(_v35L7_z), F64_POS_INF, "C99: cexp(+Inf + 2i): im +Inf");
_v35L7_z = cx_exp(cx_new(F64_POS_INF, F64_POS_INF));
assert_eq(HComplex_re(_v35L7_z), F64_POS_INF, "C99: cexp(+Inf + Inf i).re = +Inf (3.4.2: NaN)");
assert_eq(HComplex_im(_v35L7_z), 0x7FF8000000000000, "C99: cexp(+Inf + Inf i).im = NaN");
_v35L7_z = cx_exp(cx_new(F64_POS_INF, 0x7FF0000000000003));
assert_eq(HComplex_re(_v35L7_z), F64_POS_INF, "C99: cexp(+Inf + i sNaN).re = +Inf");
assert_eq(HComplex_im(_v35L7_z), 0x7FF8000000000003, "C99: cexp(+Inf + i sNaN).im = the NaN, quieted");
_v35L7_z = cx_exp(cx_new(0xFFF0000000000000, F64_POS_INF));
assert_eq(HComplex_re(_v35L7_z) | HComplex_im(_v35L7_z), 0, "C99: cexp(-Inf + Inf i) = +0 + 0i (3.4.2: NaN)");
_v35L7_z = cx_exp(cx_new(0xFFF0000000000000, 0xFFF0000000000000));
assert_eq(HComplex_re(_v35L7_z), 0, "C99: cexp(-Inf - Inf i).re = +0");
assert_eq(HComplex_im(_v35L7_z), 0x8000000000000000, "C99: cexp(-Inf - Inf i).im = -0, im's sign");
_v35L7_z = cx_exp(cx_new(0xFFF0000000000000, 0x7FF8000000000000));
assert_eq(HComplex_re(_v35L7_z) | HComplex_im(_v35L7_z), 0, "C99: cexp(-Inf + i NaN) = +0 + 0i");
_v35L7_z = cx_exp(cx_new(0xFFF0000000000000, F64_TWO));
assert_eq(HComplex_re(_v35L7_z), 0x8000000000000000, "cexp(-Inf + 2i) = +0 cis 2: re -0, unchanged");
_v35L7_z = cx_exp(cx_new(0x7FF8000000000000, 0));
assert_eq(_v35L7_nan(HComplex_re(_v35L7_z)), 1, "C99: cexp(NaN + 0i).re NaN");
assert_eq(HComplex_im(_v35L7_z), 0, "C99: cexp(NaN + 0i).im = +0 (3.4.2: NaN)");
_v35L7_z = cx_exp(cx_new(0x7FF8000000000000, 0x8000000000000000));
assert_eq(HComplex_im(_v35L7_z), 0x8000000000000000, "C99: cexp(NaN - 0i).im = -0");
_v35L7_z = cx_exp(cx_new(0x7FF8000000000000, F64_ONE));
assert_eq(_v35L7_nan(HComplex_im(_v35L7_z)), 1, "C99: cexp(NaN + 1i).im NaN");
_v35L7_z = cx_exp(cx_new(F64_ONE, F64_POS_INF));
assert_eq(_v35L7_nan(HComplex_re(_v35L7_z)), 1, "C99: cexp(1 + Inf i).re NaN");
assert_eq(_v35L7_nan(HComplex_im(_v35L7_z)), 1, "C99: cexp(1 + Inf i).im NaN");
_v35L7_z = cx_exp(cx_new(0x4086200000000000, F64_ONE));
assert_eq(HComplex_re(_v35L7_z), f64_mul(f64_exp(0x4086200000000000), f64_cos(F64_ONE)),
  "control: cx_exp(708 + 1i).re is e^708 cos 1 as formed, bit for bit");

test_group("3.5.0 L7: cx_sin / cx_cos past |im| = 710.47 and C99's rows");
_v35L7_z = cx_sin(cx_new(0, 0x4089000000000000));
assert_eq(HComplex_re(_v35L7_z), 0, "cx_sin(0 + 800i).re = +0, exact (3.4.2: NaN)");
assert_eq(HComplex_im(_v35L7_z), F64_POS_INF, "cx_sin(0 + 800i).im = +Inf");
_v35L7_z = cx_sin(cx_new(0x8000000000000000, 0xC089000000000000));
assert_eq(HComplex_re(_v35L7_z), 0x8000000000000000, "cx_sin(-0 - 800i).re = -0: sin(-0) cosh");
assert_eq(HComplex_im(_v35L7_z), 0xFFF0000000000000, "cx_sin(-0 - 800i).im = -Inf");
_v35L7_z = cx_cos(cx_new(0, 0x4089000000000000));
assert_eq(HComplex_re(_v35L7_z), F64_POS_INF, "cx_cos(0 + 800i).re = +Inf");
assert_eq(HComplex_im(_v35L7_z), 0x8000000000000000, "cx_cos(0 + 800i).im = -0, exact (3.4.2: NaN)");
_v35L7_z = cx_cos(cx_new(0, 0xC089000000000000));
assert_eq(HComplex_im(_v35L7_z), 0, "cx_cos(0 - 800i).im = +0: -(+0 * sinh(-800))");
_v35L7_z = cx_sin(cx_new(0x01A56E1FC2F8F359, 0x408F400000000000));
assert_eq(HComplex_re(_v35L7_z), 0x5BC158D3878A2F84,
  "cx_sin(1e-300 + 1000i).re = 9.850e133, correctly rounded (3.4.2: +Inf)");
assert_eq(HComplex_im(_v35L7_z), F64_POS_INF, "cx_sin(1e-300 + 1000i).im = +Inf");
_v35L7_z = cx_cos(cx_new(0x01A56E1FC2F8F359, 0x408F400000000000));
assert_eq(HComplex_im(_v35L7_z), 0xDBC158D3878A2F84, "cx_cos(1e-300 + 1000i).im = -9.850e133, correctly rounded");
_v35L7_z = cx_sin(cx_new(1, 0xC096B40000000000));
assert_eq(HComplex_re(_v35L7_z), 0x7FC2D79978FD94EE, "cx_sin(2^-1074 - 1453i).re = 2.646e307, correctly rounded");
_v35L7_z = cx_cos(cx_new(1, 0xC096B40000000000));
assert_eq(HComplex_im(_v35L7_z), 0x7FC2D79978FD94EE, "cx_cos(2^-1074 - 1453i).im = +2.646e307, sinh's sign");
_v35L7_z = cx_sin(cx_new(F64_POS_INF, 0));
assert_eq(_v35L7_nan(HComplex_re(_v35L7_z)), 1, "C99: csin(+Inf + 0i).re NaN");
assert_eq(HComplex_im(_v35L7_z), 0, "C99: csin(+Inf + 0i).im = +0 (3.4.2: NaN)");
_v35L7_z = cx_sin(cx_new(0x7FF8000000000000, 0x8000000000000000));
assert_eq(HComplex_im(_v35L7_z), 0x8000000000000000, "C99: csin(NaN - 0i).im = -0, im's sign");
_v35L7_z = cx_sin(cx_new(F64_POS_INF, F64_POS_INF));
assert_eq(_v35L7_nan(HComplex_re(_v35L7_z)), 1, "C99: csin(+Inf + Inf i).re NaN");
assert_eq(HComplex_im(_v35L7_z), F64_POS_INF, "C99: csin(+Inf + Inf i).im = +Inf (3.4.2: NaN)");
_v35L7_z = cx_sin(cx_new(0x7FF8000000000000, 0xFFF0000000000000));
assert_eq(HComplex_im(_v35L7_z), 0xFFF0000000000000, "C99: csin(NaN - Inf i).im = -Inf");
_v35L7_z = cx_sin(cx_new(0, 0x7FF8000000000000));
assert_eq(HComplex_re(_v35L7_z), 0, "C99: csin(+0 + i NaN).re = +0 (3.4.2: NaN)");
assert_eq(_v35L7_nan(HComplex_im(_v35L7_z)), 1, "C99: csin(+0 + i NaN).im NaN");
_v35L7_z = cx_sin(cx_new(F64_ONE, F64_POS_INF));
assert_eq(HComplex_re(_v35L7_z), F64_POS_INF, "C99: csin(1 + Inf i) = (Inf sin 1, Inf cos 1): re +Inf");
assert_eq(HComplex_im(_v35L7_z), F64_POS_INF, "C99: csin(1 + Inf i): im +Inf");
_v35L7_z = cx_sin(cx_new(F64_POS_INF, 0x4089000000000000));
assert_eq(_v35L7_nan(HComplex_im(_v35L7_z)), 1, "C99: csin(+Inf + 800i).im NaN, a finite im");
_v35L7_z = cx_cos(cx_new(F64_POS_INF, F64_POS_INF));
assert_eq(HComplex_re(_v35L7_z), F64_POS_INF, "C99: ccos(+Inf + Inf i).re = +Inf (3.4.2: NaN)");
assert_eq(_v35L7_nan(HComplex_im(_v35L7_z)), 1, "C99: ccos(+Inf + Inf i).im NaN");
_v35L7_z = cx_cos(cx_new(F64_POS_INF, 0));
assert_eq(_v35L7_nan(HComplex_re(_v35L7_z)), 1, "C99: ccos(+Inf + 0i).re NaN");
assert_eq(HComplex_im(_v35L7_z), 0x8000000000000000, "C99: ccos(+Inf + 0i).im = -0 (unspecified sign; 3.4.2: NaN)");
_v35L7_z = cx_cos(cx_new(0, F64_POS_INF));
assert_eq(HComplex_re(_v35L7_z), F64_POS_INF, "C99: ccos(+0 + Inf i).re = +Inf");
assert_eq(HComplex_im(_v35L7_z), 0x8000000000000000, "C99: ccos(+0 + Inf i).im = -0 (3.4.2: NaN)");
_v35L7_z = cx_sin(cx_new(F64_ONE, 0x4086200000000000));
assert_eq(HComplex_re(_v35L7_z), f64_mul(f64_sin(F64_ONE), ganita_f64_cosh(0x4086200000000000)),
  "control: cx_sin(1 + 708i).re is sin 1 cosh 708 as formed, bit for bit");

test_group("3.5.0 L7: cx_from_polar with an infinite or zero r");
_v35L7_z = cx_from_polar(F64_POS_INF, 0);
assert_eq(HComplex_re(_v35L7_z), F64_POS_INF, "cx_from_polar(+Inf, 0).re = +Inf");
assert_eq(HComplex_im(_v35L7_z), 0, "cx_from_polar(+Inf, 0).im = +0 (3.4.2: NaN)");
_v35L7_z = cx_from_polar(0xFFF0000000000000, 0);
assert_eq(HComplex_im(_v35L7_z), 0x8000000000000000, "cx_from_polar(-Inf, +0).im = -0");
_v35L7_z = cx_from_polar(F64_POS_INF, 0x8000000000000000);
assert_eq(HComplex_im(_v35L7_z), 0x8000000000000000, "cx_from_polar(+Inf, -0).im = -0");
_v35L7_z = cx_from_polar(F64_POS_INF, F64_TWO);
assert_eq(HComplex_re(_v35L7_z), 0xFFF0000000000000, "cx_from_polar(+Inf, 2).re = -Inf");
assert_eq(HComplex_im(_v35L7_z), F64_POS_INF, "cx_from_polar(+Inf, 2).im = +Inf");
_v35L7_z = cx_from_polar(F64_POS_INF, F64_POS_INF);
assert_eq(HComplex_re(_v35L7_z), F64_POS_INF, "cx_from_polar(+Inf, Inf).re = +Inf: no direction");
assert_eq(HComplex_im(_v35L7_z), 0x7FF8000000000000, "cx_from_polar(+Inf, Inf).im = NaN (3.4.2: NaN, NaN)");
_v35L7_z = cx_from_polar(0, F64_POS_INF);
assert_eq(HComplex_re(_v35L7_z) | HComplex_im(_v35L7_z), 0, "cx_from_polar(+0, +Inf) = +0 + 0i (3.4.2: NaN)");
_v35L7_z = cx_from_polar(0, 0xFFF0000000000000);
assert_eq(HComplex_im(_v35L7_z), 0x8000000000000000, "cx_from_polar(+0, -Inf).im = -0, theta's sign");
_v35L7_z = cx_from_polar(F64_ONE, F64_POS_INF);
assert_eq(_v35L7_nan(HComplex_re(_v35L7_z)), 1, "cx_from_polar(1, Inf).re NaN: no angle, a finite r");
_v35L7_z = cx_from_polar(0x7FF8000000000000, 0);
assert_eq(_v35L7_nan(HComplex_re(_v35L7_z)), 1, "cx_from_polar(NaN, 0).re NaN");
assert_eq(_v35L7_nan(HComplex_im(_v35L7_z)), 1, "cx_from_polar(NaN, 0).im NaN");

test_group("3.5.0 L7: cx_ln near |a| = 1");
# Every expected real part below is the double nearest a 90-digit Decimal evaluation of
# (1/2) ln(x^2 + y^2) from the exact x and y; the distance from it is in each message. Each
# point after the first group was chosen so that one change to the band's code moves its bits
# (the change named in the message, a mutant run on 34,151 points).
# [measured: scratch lnorc.py (the oracle), mutsearch.py and mutrun.py (the mutants), 2026-11-14]
_v35L7_z = cx_ln(cx_new(F64_ONE, 0x3DDB7CDFD9D7BDBB));
assert_eq(HComplex_re(_v35L7_z), 0x3BB79CA10C924224, "cx_ln(1 + 1e-10 i).re = 5e-21, 0.15 ulp (3.4.2: 0)");
assert_eq(HComplex_im(_v35L7_z), 0x3DDB7CDFD9D7BDBB, "cx_ln(1 + 1e-10 i).im = atan2(1e-10, 1), unchanged");
_v35L7_z = cx_ln(cx_new(0x3FE3333333333333, 0x3FE999999999999A));
assert_eq(HComplex_re(_v35L7_z), 0x3C7999999999999A,
  "cx_ln(0.6 + 0.8i).re = 2.22e-17, 0.16 ulp: |fl(0.6) + i fl(0.8)| is not 1 (3.4.2: 0)");
_v35L7_z = cx_ln(cx_new(0x3FFFFFFFFFFFFFFF, 0));
assert_eq(HComplex_re(_v35L7_z), 0x3FE62E42FEFA39EE, "cx_ln(2 - 2^-52).re, 0.21 ulp (the first 3.5.0 form: ...EF)");
_v35L7_z = cx_ln(cx_new(0x3FE0000000000001, 0));
assert_eq(HComplex_re(_v35L7_z), 0xBFE62E42FEFA39ED, "cx_ln(0.5 + 2^-53).re, 0.21 ulp");
_v35L7_z = cx_ln(cx_new(0xBFF0000000000000, 0));
assert_eq(HComplex_re(_v35L7_z), 0, "cx_ln(-1).re = +0");
assert_eq(HComplex_im(_v35L7_z), F64_PI, "cx_ln(-1).im = pi");
# The band's outer part, where the first 3.5.0 form (atanh of a rounded d) was 3.37 ulp off.
# [measured: the 3.5.0 review's Decimal oracle; scratch lnorc.py, 2026-11-14]
_v35L7_z = cx_ln(cx_new(0xBFC9F1A3C4E7EB42, 0xBFE24DBE1B8EAFF1));
# 3.5.0 W7: old ...8737 (0.37 ulp) -> new ...8738 (0.63 ulp): the wave 2 ln path takes u = re^2 + im^2
# to the nearest double where wave 1 took 1 + D on D's coarser grid, a different rounding of ln u;
# both within the 1 ulp the path is bounded by, its mean over 25,632 band points 0.325 ulp, wave 1's 0.326.
# [measured: scratch lnpts.py and lnstat3.py (Decimal oracle), lane W7, 2026-11-14]
assert_eq(HComplex_re(_v35L7_z), 0xBFDFF7A6B0AE8738,
  "cx_ln(-0.2027 - 0.5720i).re, |a| = 0.607: 0.63 ulp (3.4.2 ...37, 0.37; the first 3.5.0 form ...34, 3.37)");
_v35L7_z = cx_ln(cx_new(0x3FECCCCCCCCCCCCD, 0x3FD3333333333333));
assert_eq(HComplex_re(_v35L7_z), 0xBFAAF8E8210A415B,
  "cx_ln(0.9 + 0.3i).re, the band's ln path: 0.24 ulp (3.4.2: ...62, 7.2)");
_v35L7_z = cx_ln(cx_new(F64_ONE, F64_HALF));
assert_eq(HComplex_re(_v35L7_z), 0x3FBC8FF7C79A9A22, "cx_ln(1 + 0.5i).re: 0.33 ulp (3.4.2: ...25, 3.3)");
# The band's ends: the rounded modulus is exactly 2, and exactly 1/2, and the band includes
# them (ln of that modulus is 1.00 ulp off at both).
# [measured: scratch lnorc.py over 2,251 points whose modulus rounds to 1/2 or 2, 2026-11-14]
_v35L7_z = cx_new(F64_TWO, 0x3E5C7C112A726CB2);
assert_eq(cx_abs(_v35L7_z), F64_TWO, "control: |2 + 2.65e-8 i| rounds to 2, the band's top");
assert_eq(HComplex_re(cx_ln(_v35L7_z)), 0x3FE62E42FEFA39F0,
  "cx_ln(2 + 2.65e-8 i).re: 0.001 ulp, the band's path at |a| = 2 (an exclusive top: ...EF, 1.00 ulp)");
_v35L7_z = cx_new(F64_HALF, 0x3E41978F6075F389);
assert_eq(cx_abs(_v35L7_z), F64_HALF, "control: |0.5 + 8.19e-9 i| rounds to 1/2, the band's bottom");
assert_eq(HComplex_re(cx_ln(_v35L7_z)), 0xBFE62E42FEFA39EE,
  "cx_ln(0.5 + 8.19e-9 i).re: 0.000 ulp, the band's path at |a| = 1/2 (an exclusive bottom: ...EF, 1.00 ulp)");
# Around the series threshold |D| = 2^-20: D = 2^-10.7 takes the ln path, 2^-23.1 and 2^-26.1
# the series.
_v35L7_z = cx_ln(cx_new(0xBF98F1BEEC4D9142, 0x3FF0000000000210));
assert_eq(HComplex_re(_v35L7_z), 0x3F337046BBF07FC9,
  "cx_ln(-0.02436 + (1 + 528 2^-52) i).re, D = 2^-10.7: 0.008 ulp (a series from 2^-10 up: 2.9e5 ulp)");
_v35L7_z = cx_ln(cx_new(0x3FF0000000000338, 0x3F362F313CC929DE));
assert_eq(HComplex_re(_v35L7_z), 0x3E6EC258EB74D30C,
  "cx_ln((1 + 824 2^-52) + 3.39e-4 i).re, D = 2^-23.1: 0.013 ulp (the ln path below 2^-20: ...0B)");
_v35L7_z = cx_ln(cx_new(0x3FF0000000000297, 0x3F1F1125944536D3));
assert_eq(HComplex_re(_v35L7_z), 0x3E3E296B6BD20971,
  "cx_ln((1 + 663 2^-52) + 1.19e-4 i).re, D = 2^-26.1: 0.003 ulp (no D^3 / 3 term: ...70)");
_v35L7_z = cx_ln(cx_new(0x3FBDB0DF522955B1, 0xBFEFC8B77232F4E5));
assert_eq(HComplex_re(_v35L7_z), 0xBC8F67A9B8792716,
  "cx_ln(0.1160 - 0.9933i).re, D = -2^-53.0: 0.034 ulp (the series without lo: ...15)");
# The ln path's pieces: hi + lo's lo, the errors' sum c, and each 2Sum's full error term.
_v35L7_z = cx_ln(cx_new(0x3FE06AEA111D72B1, 0xBFD0E355FB9964B6));
assert_eq(HComplex_re(_v35L7_z), 0xBFE199D6C64FBC62,
  "cx_ln(0.5131 - 0.2639i).re: 0.001 ulp (without lo in e, without e / u, or without c: ...61)");
_v35L7_z = cx_ln(cx_new(0xBFECDB5FBB7328B3, 0x3FEBBA8D0C04164F));
assert_eq(HComplex_re(_v35L7_z), 0x3FCCA0627679AFF4,
  "cx_ln(-0.9018 + 0.8665i).re: 0.000 ulp (_cx_sum2's error term as b - (sm - s) alone: ...F3)");
_v35L7_z = cx_ln(cx_new(0x3FE5B69961FB1F86, 0x3FB92EBF2C7A7894));
assert_eq(HComplex_re(_v35L7_z), 0xBFD82786240DCF22,
  "cx_ln(0.6785 + 0.0984i).re: 0.003 ulp (the squares without their low parts: ...21)");
# The series' pieces: the renormalisation, its error terms, and the cascade after it.
_v35L7_z = cx_ln(cx_new(0xBFEFFFFFFFFFFFFC, 0xBE5FFFFFFFFFFFFF));
assert_eq(HComplex_re(_v35L7_z), 0x3620000000000000,
  "cx_ln(-(1 - 2^-51) - 2.98e-8 i).re = 2^-157, D = 2^-156: 0.000 ulp (no renormalisation, or no cascade after it: 0)");
_v35L7_z = cx_ln(cx_new(0xBFD1B8DC3E7EC277, 0xBFEEBFA9E4D873FE));
assert_eq(HComplex_re(_v35L7_z), 0x3C86AB5BCA6554D8,
  "cx_ln(-0.2769 - 0.9609i).re, D = 2^-53.5: 0.001 ulp (renormalised without the error terms: 0)");
# x^2 + y^2 - 1 = -2^-73.3 for x = 0.99982..., y = 0.02656...: every term of the sum cancels to
# that; 3.4.2's ln of the rounded modulus 1.0 was 0.
_v35L7_z = cx_ln(cx_new(0x3FEFFD1C4E9EB2E3, 0x3F9B31E4CAC115F4));
assert_eq(HComplex_re(_v35L7_z), 0xBB4A500983ADC000, "cx_ln on the circle to 2^-73: re 0.000 ulp (3.4.2: 0)");

test_group("3.5.0 L7: gamma_spatial, gell_mann and su3_structure_constant out of range");
assert_eq(gamma_spatial(3), 0, "gamma_spatial(3): no gamma^4, the designed 0 (3.4.2: the zero matrix)");
assert_eq(gamma_spatial(0 - 1), 0, "gamma_spatial(-1): the designed 0");
assert_neq(gamma_spatial(2), 0, "control: gamma_spatial(2) is gamma^3");
assert_eq(HComplex_re(cmat_get(gamma_spatial(2), 0, 2)), F64_ONE, "control: gamma^3 [0][2] = sigma_z [0][0] = 1");
assert_eq(HComplex_re(cmat_get(gamma_spatial(0), 0, 3)), F64_ONE, "control: gamma^1 [0][3] = sigma_x [0][1] = 1");
assert_eq(gell_mann(8), 0, "gell_mann(8): no lambda_9, the designed 0 (3.4.2: the zero matrix)");
assert_eq(gell_mann(0 - 1), 0, "gell_mann(-1): the designed 0");
assert_eq(HComplex_re(cmat_get(gell_mann(7), 2, 2)), 0xBFF279A74590331C, "gell_mann(7) [2][2] = -2/sqrt(3)");
assert_eq(HComplex_im(cmat_get(gell_mann(6), 1, 2)), 0xBFF0000000000000, "gell_mann(6) [1][2] = -i: not lambda_8");
assert_eq(HComplex_re(cmat_get(gell_mann(6), 2, 2)), 0, "gell_mann(6) [2][2] = 0: not lambda_8");
assert_eq(HComplex_re(cmat_get(gell_mann(0), 0, 1)), F64_ONE, "gell_mann(0) [0][1] = 1: lambda_1");
assert_eq(su3_structure_constant(0, 2, 3), 0x7FF8000000000000, "f_{0,2,3}: no index 0, NaN (3.4.2: 0)");
assert_eq(su3_structure_constant(9, 2, 3), 0x7FF8000000000000, "f_{9,2,3}: no index 9, NaN");
assert_eq(su3_structure_constant(1, 0, 3), 0x7FF8000000000000, "f_{1,0,3}: NaN");
assert_eq(su3_structure_constant(1, 9, 3), 0x7FF8000000000000, "f_{1,9,3}: NaN");
assert_eq(su3_structure_constant(1, 2, 0), 0x7FF8000000000000, "f_{1,2,0}: NaN");
assert_eq(su3_structure_constant(1, 2, 9), 0x7FF8000000000000, "f_{1,2,9}: NaN");
assert_eq(su3_structure_constant(1, 2, 3), F64_ONE, "control: f_123 = 1");
assert_eq(su3_structure_constant(8, 8, 8), 0, "control: f_888 = 0, a value");
assert_eq(su3_structure_constant(1, 1, 1), 0, "control: f_111 = 0, a value");
assert_eq(su3_structure_constant(5, 4, 8), f64_neg(f64_div(f64_sqrt(f64_from(3)), F64_TWO)),
  "control: f_548 = -sqrt(3)/2, antisymmetric in its last index pair");

# ================================================================
# lie.cyr, lie_ext.cyr
# ================================================================
test_group("3.5.0 L7: a zero axis names no direction");
var _v35L7_z3 = hvec3_new(0, 0, 0);
var _v35L7_q = su2_from_axis_angle(_v35L7_z3, 0);
assert_eq(_su2_w(_v35L7_q), F64_ONE, "su2_from_axis_angle(0, 0) = the identity: w 1");
assert_eq(_su2_x(_v35L7_q) | _su2_y(_v35L7_q) | _su2_z(_v35L7_q), 0, "su2_from_axis_angle(0, 0): vector part 0");
_v35L7_q = su2_from_axis_angle(_v35L7_z3, 0x8000000000000000);
assert_eq(_su2_w(_v35L7_q), F64_ONE, "su2_from_axis_angle(0, -0) = the identity");
_v35L7_q = su2_from_axis_angle(_v35L7_z3, 1);
assert_eq(_su2_x(_v35L7_q), 0, "su2_from_axis_angle(0, 2^-1074): sin(angle/2) rounds to 0, every axis gives 0");
_v35L7_q = su2_from_axis_angle(_v35L7_z3, 3);
assert_eq(_su2_x(_v35L7_q), 0x7FF8000000000000, "su2_from_axis_angle(0, 3 2^-1074): sin(angle/2) is not 0: NaN");
_v35L7_q = su2_from_axis_angle(_v35L7_z3, F64_ONE);
assert_eq(_su2_w(_v35L7_q), f64_cos(F64_HALF), "su2_from_axis_angle(0, 1): w = cos(1/2) (3.4.2: 1)");
assert_eq(_su2_x(_v35L7_q), 0x7FF8000000000000, "su2_from_axis_angle(0, 1): x the quiet NaN (3.4.2: 0)");
assert_eq(_su2_y(_v35L7_q), 0x7FF8000000000000, "su2_from_axis_angle(0, 1): y NaN");
assert_eq(_su2_z(_v35L7_q), 0x7FF8000000000000, "su2_from_axis_angle(0, 1): z NaN");
_v35L7_q = su2_from_quat(hquat_new(0, 0, 0, 0));
assert_eq(_su2_w(_v35L7_q), 0x7FF8000000000000, "su2_from_quat(0): w NaN (3.4.2: 1)");
assert_eq(_su2_x(_v35L7_q), 0x7FF8000000000000, "su2_from_quat(0): x NaN");
assert_eq(_su2_y(_v35L7_q), 0x7FF8000000000000, "su2_from_quat(0): y NaN");
assert_eq(_su2_z(_v35L7_q), 0x7FF8000000000000, "su2_from_quat(0): z NaN");
_v35L7_q = su2_from_quat(hquat_new(0, 0, 0x8000000000000000, 0x8000000000000000));
assert_eq(_su2_w(_v35L7_q), 0x7FF8000000000000, "su2_from_quat(-0 quaternion): NaN too");
var _v35L7_m = so3_from_axis_angle(_v35L7_z3, 0);
assert_eq(m3_get(_v35L7_m, 0, 0), F64_ONE, "so3_from_axis_angle(0, 0) = I: [0][0] 1");
assert_eq(m3_get(_v35L7_m, 0, 1), 0, "so3_from_axis_angle(0, 0) = I: [0][1] 0");
_v35L7_m = so3_from_axis_angle(_v35L7_z3, F64_ONE);
assert_eq(m3_get(_v35L7_m, 0, 0), 0x7FF8000000000000, "so3_from_axis_angle(0, 1): [0][0] the quiet NaN (3.4.2: 1)");
assert_eq(m3_get(_v35L7_m, 1, 2), 0x7FF8000000000000, "so3_from_axis_angle(0, 1): [1][2] NaN (3.4.2: 0)");
_v35L7_m = so3_from_axis_angle(_v35L7_z3, 1);
assert_eq(_v35L7_nan(m3_get(_v35L7_m, 1, 2)), 1, "so3_from_axis_angle(0, 2^-1074): sin is not 0: NaN");
var _v35L7_l = lorentz_boost(_v35L7_z3, 0);
assert_eq(m4_get(_v35L7_l, 0, 0), F64_ONE, "lorentz_boost(0, 0) = I: [0][0] 1");
assert_eq(m4_get(_v35L7_l, 1, 1), F64_ONE, "lorentz_boost(0, 0) = I: [1][1] 1");
assert_eq(m4_get(_v35L7_l, 0, 1), 0, "lorentz_boost(0, 0) = I: [0][1] 0");
_v35L7_l = lorentz_boost(_v35L7_z3, 0x8000000000000000);
assert_eq(m4_get(_v35L7_l, 1, 1), F64_ONE, "lorentz_boost(0, -0) = I");
_v35L7_l = lorentz_boost(_v35L7_z3, F64_ONE);
assert_eq(m4_get(_v35L7_l, 0, 0), ganita_f64_cosh(F64_ONE), "lorentz_boost(0, 1): Lambda^0_0 = cosh 1, determined");
assert_eq(m4_get(_v35L7_l, 1, 0), 0x7FF8000000000000, "lorentz_boost(0, 1): Lambda^0_1 the quiet NaN (3.4.2: 0)");
assert_eq(m4_get(_v35L7_l, 2, 2), 0x7FF8000000000000, "lorentz_boost(0, 1): Lambda^2_2 NaN (3.4.2: 1)");
_v35L7_l = lorentz_rotate(_v35L7_z3, 0);
assert_eq(m4_get(_v35L7_l, 2, 2), F64_ONE, "lorentz_rotate(0, 0) = I: [2][2] 1");
assert_eq(m4_get(_v35L7_l, 1, 2), 0, "lorentz_rotate(0, 0) = I: [1][2] 0");
_v35L7_l = lorentz_rotate(_v35L7_z3, F64_ONE);
assert_eq(m4_get(_v35L7_l, 0, 0), F64_ONE, "lorentz_rotate(0, 1): time unchanged, 1");
assert_eq(m4_get(_v35L7_l, 0, 1), 0, "lorentz_rotate(0, 1): [0][1] 0, the time row");
assert_eq(m4_get(_v35L7_l, 1, 1), 0x7FF8000000000000, "lorentz_rotate(0, 1): spatial [1][1] the quiet NaN (3.4.2: 1)");
assert_eq(m4_get(_v35L7_l, 2, 1), 0x7FF8000000000000, "lorentz_rotate(0, 1): spatial [2][1] NaN (3.4.2: 0)");
var _v35L7_ax = hvec3_new(0, 0, F64_TWO);
assert_eq(m4_get(lorentz_rotate(_v35L7_ax, F64_ONE), 1, 1), f64_cos(F64_ONE),
  "control: lorentz_rotate((0, 0, 2), 1) [1][1] = cos 1");
assert_eq(m3_get(so3_from_axis_angle(_v35L7_ax, F64_ONE), 0, 1), f64_sin(F64_ONE),
  "control: so3_from_axis_angle((0, 0, 2), 1) [0][1] = sin 1");
assert_eq(_su2_z(su2_from_axis_angle(_v35L7_ax, F64_ONE)), f64_sin(F64_HALF),
  "control: su2_from_axis_angle((0, 0, 2), 1) z = sin(1/2)");
assert_eq(m4_get(lorentz_boost(_v35L7_ax, F64_ONE), 3, 0), ganita_f64_sinh(F64_ONE),
  "control: lorentz_boost((0, 0, 2), 1) Lambda^0_3 = sinh 1");

test_group("3.5.0 L7: lorentz_is_valid and se3_new refuse a 0 handle");
assert_eq(lorentz_is_valid(0), 0, "lorentz_is_valid(0) = 0: no transformation (3.4.2: a null read)");
assert_eq(lorentz_is_valid(lorentz_identity()), 1, "control: lorentz_is_valid(I) = 1");
var _v35L7_r = su2_identity();
var _v35L7_t = hvec3_new(F64_ONE, F64_TWO, 0);
assert_eq(se3_new(0, _v35L7_t), 0, "se3_new(0, t) = 0 (3.4.2: a pose holding a 0 rotation)");
assert_eq(se3_new(_v35L7_r, 0), 0, "se3_new(r, 0) = 0 (3.4.2: a pose holding a 0 translation)");
var _v35L7_p = se3_new(_v35L7_r, _v35L7_t);
assert_eq(load64(_v35L7_p), _v35L7_r, "control: se3_new(r, t) stores r's handle");
assert_eq(load64(_v35L7_p + 8), _v35L7_t, "control: se3_new(r, t) stores t's handle");

test_group("3.5.0 L7: se3_log reads w in place");
fn _v35L7_log_bytes(se) {
    var a = alloc_used();
    var tw = se3_log(se);
    if (tw == 0) { return 0 - 1; }
    return alloc_used() - a;
}
var _v35L7_se = se3_new(su2_from_axis_angle(hvec3_new(F64_ONE, F64_TWO, f64_from(3)), F64_ONE), _v35L7_t);
var _v35L7_ref = se3_log(_v35L7_se);
# 3.4.2 allocated 680 B here, an HQuat (32 B) more, to read w; 776 against 744 at angle 5 (w < 0).
# [measured: scratch alloc.py, alloc_used() around se3_log on this tree and 3.4.2's, 2026-11-14]
assert_eq(_v35L7_log_bytes(_v35L7_se), 648, "se3_log at w > 0 allocates 648 B (3.4.2: 680, an HQuat to read w)");
var _v35L7_neg = se3_new(su2_from_quat(hquat_new(F64_HALF, F64_HALF, F64_HALF, f64_neg(F64_HALF))), _v35L7_t);
var _v35L7_pos = se3_new(su2_from_quat(hquat_new(f64_neg(F64_HALF), f64_neg(F64_HALF), f64_neg(F64_HALF),
      F64_HALF)), _v35L7_t);
assert_eq(_vec6_get(se3_log(_v35L7_neg), 0), _vec6_get(se3_log(_v35L7_pos), 0),
  "se3_log at w = -1/2 logs -q: omega_x is -q's, w read in place");
assert_eq(_vec6_get(se3_log(_v35L7_neg), 5), _vec6_get(se3_log(_v35L7_pos), 5),
  "se3_log at w = -1/2 logs -q: v_z is -q's");
assert_eq(_vec6_get(se3_log(_v35L7_pos), 0), 0xBFF358E1A79ED7E1,
  "se3_log of (w 1/2, -1/2 (1, 1, 1)): omega_x = -(2 pi/3)/sqrt 3, correctly rounded");

# ================================================================
# diffgeo.cyr
# ================================================================
test_group("3.5.0 L7: diffgeo's f64 answers with no value");
var _v35L7_g2 = alloc(32);
store64(_v35L7_g2, F64_ONE); store64(_v35L7_g2 + 8, 0); store64(_v35L7_g2 + 16, 0); store64(_v35L7_g2 + 24, F64_ONE);
var _v35L7_r2 = alloc(32);
store64(_v35L7_r2, 0); store64(_v35L7_r2 + 8, 0); store64(_v35L7_r2 + 16, 0); store64(_v35L7_r2 + 24, 0);
assert_eq(ricci_scalar(_v35L7_r2, _v35L7_g2, 2), 0, "control: ricci_scalar of a zero Ricci tensor is +0, a value");
assert_eq(ricci_scalar(0, _v35L7_g2, 2), 0x7FF8000000000000, "ricci_scalar(null ricci): NaN (3.4.2: 0)");
assert_eq(ricci_scalar(_v35L7_r2, 0, 2), 0x7FF8000000000000, "ricci_scalar(null metric_inv): NaN");
assert_eq(ricci_scalar(_v35L7_r2, _v35L7_g2, 0), 0x7FF8000000000000, "ricci_scalar(dim 0): NaN");
assert_eq(ricci_scalar(_v35L7_r2, _v35L7_g2, 17), 0x7FF8000000000000, "ricci_scalar(dim 17): NaN");
# the unit sphere's (1,3) Riemann at the equator: R^0_{101} = 1, R^0_{110} = -1, R^1_{001} = -1, R^1_{010} = 1
var _v35L7_rie = alloc(128);
var _v35L7_i = 0;
while (_v35L7_i < 16) { store64(_v35L7_rie + _v35L7_i * 8, 0); _v35L7_i = _v35L7_i + 1; }
store64(_v35L7_rie + _dg_idx4(0, 1, 0, 1, 2), F64_ONE);
store64(_v35L7_rie + _dg_idx4(0, 1, 1, 0, 2), f64_neg(F64_ONE));
store64(_v35L7_rie + _dg_idx4(1, 0, 0, 1, 2), f64_neg(F64_ONE));
store64(_v35L7_rie + _dg_idx4(1, 0, 1, 0, 2), F64_ONE);
var _v35L7_e0 = alloc(16); store64(_v35L7_e0, F64_ONE); store64(_v35L7_e0 + 8, 0);
var _v35L7_e1 = alloc(16); store64(_v35L7_e1, 0); store64(_v35L7_e1 + 8, F64_ONE);
var _v35L7_e2 = alloc(16); store64(_v35L7_e2, 0x8000000000000000); store64(_v35L7_e2 + 8, 0);
assert_eq(sectional_curvature(_v35L7_rie, _v35L7_g2, _v35L7_e0, _v35L7_e1, 2), F64_ONE, "control: K = 1 on the sphere");
assert_eq(sectional_curvature(_v35L7_rie, _v35L7_g2, _v35L7_e0, _v35L7_e0, 2), 0x7FF8000000000000,
  "sectional_curvature(u, u): no plane, NaN (3.4.2: 0, flat)");
assert_eq(sectional_curvature(_v35L7_rie, _v35L7_g2, _v35L7_e0, _v35L7_e2, 2), 0x7FF8000000000000,
  "sectional_curvature(u, -0 v): the zero vector spans no plane: NaN");
assert_eq(sectional_curvature(0, _v35L7_g2, _v35L7_e0, _v35L7_e1, 2), 0x7FF8000000000000,
  "sectional_curvature(null riemann): NaN (3.4.2: 0)");
assert_eq(sectional_curvature(_v35L7_rie, 0, _v35L7_e0, _v35L7_e1, 2), 0x7FF8000000000000,
  "sectional_curvature(null metric): NaN");
assert_eq(sectional_curvature(_v35L7_rie, _v35L7_g2, 0, _v35L7_e1, 2), 0x7FF8000000000000,
  "sectional_curvature(null u): NaN");
assert_eq(sectional_curvature(_v35L7_rie, _v35L7_g2, _v35L7_e0, _v35L7_e1, 0), 0x7FF8000000000000,
  "sectional_curvature(dim 0): NaN");
assert_eq(sectional_curvature(_v35L7_rie, _v35L7_g2, _v35L7_e0, _v35L7_e1, 17), 0x7FF8000000000000,
  "sectional_curvature(dim 17): NaN");
# a Killing field of the flat plane, a rotation: xi = (-y, x) at (x, y) = (1, 2), d_nu xi^mu = [[0, -1], [1, 0]]
var _v35L7_f = alloc(48);
store64(_v35L7_f, f64_neg(F64_TWO)); store64(_v35L7_f + 8, F64_ONE);
store64(_v35L7_f + 16, 0); store64(_v35L7_f + 24, f64_neg(F64_ONE));
store64(_v35L7_f + 32, F64_ONE); store64(_v35L7_f + 40, 0);
var _v35L7_ch = alloc(64);
_v35L7_i = 0;
while (_v35L7_i < 8) { store64(_v35L7_ch + _v35L7_i * 8, 0); _v35L7_i = _v35L7_i + 1; }
assert_eq(killing_residual(_v35L7_f, _v35L7_g2, _v35L7_ch, 2), 0, "control: a rotation is a Killing field, residual 0");
assert_eq(killing_residual(0, _v35L7_g2, _v35L7_ch, 2), 0x7FF8000000000000,
  "killing_residual(null field): NaN (3.4.2: 0)");
assert_eq(killing_residual(_v35L7_f, 0, _v35L7_ch, 2), 0x7FF8000000000000, "killing_residual(null metric): NaN");
assert_eq(killing_residual(_v35L7_f, _v35L7_g2, 0, 2), 0x7FF8000000000000, "killing_residual(null christoffel): NaN");
assert_eq(killing_residual(_v35L7_f, _v35L7_g2, _v35L7_ch, 0), 0x7FF8000000000000, "killing_residual(dim 0): NaN");
assert_eq(killing_residual(_v35L7_f, _v35L7_g2, _v35L7_ch, 17), 0x7FF8000000000000, "killing_residual(dim 17): NaN");

# ==================================================================================================
# 3.5.0 wave 2 — rays at spheres: certificates past the limits and at flushed radii (geo)
# ==================================================================================================
# (Written as tests/w2_W1.tcyr; every global and fn below is prefixed _w2W1_.)

# ================================================================
# Helpers
# ================================================================
# A ray and a sphere built through the setters (the direction is NOT normalised, as geo_ray_new would).
fn _w2W1_ray(ox, oy, oz, dx, dy, dz) {
    var r = alloc(16);
    GeoRay_set_origin(r, hvec3_new(ox, oy, oz));
    GeoRay_set_direction(r, hvec3_new(dx, dy, dz));
    return r;
}
fn _w2W1_sphere(cx, cy, cz, r) {
    var s = alloc(16);
    GeoSphere_set_center(s, hvec3_new(cx, cy, cz));
    GeoSphere_set_radius(s, r);
    return s;
}
fn _w2W1_sph(ox, oy, oz, dx, dy, dz, cx, cy, cz, r) {
    return geo_ray_sphere(_w2W1_ray(ox, oy, oz, dx, dy, dz), _w2W1_sphere(cx, cy, cz, r));
}
var _w2W1_out: i64[2];
var _w2W1_hac: i64[3];
var _w2W1_v1: i64[3];
var _w2W1_v2: i64[3];
var _w2W1_v3: i64[3];
fn _w2W1_set(v, x, y, z) {
    store64(v, x);
    store64(v + 8, y);
    store64(v + 16, z);
    return v;
}

# ================================================================
test_group("3.5.0 W1: the unit-size copy's near-tangent certificate (roadmap: _geo_sphere_roots_scaled)");
# ================================================================
# The roadmap's repro: an exact miss on a sphere of radius 2^-754, read a hit at 1.16e-123 through 3.4.2.
# [measured: scratch py/fixtures.py, exact Fraction oracle, 3.4.2 / base / this tree, 2026-11-14]
assert_eq(_w2W1_sph(0xA21C6E35AF4DF918, 0x221ECA546967D073, 0xA23791F84853FB67, 0xBBB71B5E73419454, 0x3BB61D1D3E53D795,
    0xBB706CADEFB7FFB1, 0xA238D3BA2C213A0A, 0x2238A7C8F4011EDC, 0xA2385B7DDE23332D, 0x20D779409AF0DECD), 0,
  "geo_ray_sphere: the roadmap's tiny sphere, an exact miss -> 0 (3.4.2: 0x26688A002C0009A6)");
# Past the limits (|d| 2^940, r 2^861), within 8 ulps of tangency: the copy's plain offset read the miss.
assert_eq(_w2W1_sph(0x765A0DC230AFC315, 0x766489DC73054651, 0xF65F349B4112B050, 0xFAD6DC393A5E38CE, 0xFAE2022CA3960F23,
    0x7ADB52C4C0E47FCA, 0x754A8299A19A32A0, 0x7548565371B6A8DE, 0xF52D96BCB8F938C0, 0x75C6E4F2739B81B5),
  0x3B7240AA11659F61, "geo_ray_sphere: a near-tangent hit past the limits -> the compensated root (3.4.2: the miss)");
# ... and a near-tangent miss there, which read a hit at 3809.3.
assert_eq(_w2W1_sph(0x727246C0466AD56F, 0xF2591B01002455A0, 0x723C7B17419AFA30, 0xF1B3A77F6051B9C2, 0x719AF54813035BBC,
    0xF17EBD5425875D8E, 0xF01D775BB22BB030, 0x702E23B39FCC81DA, 0x70236B1814BDEECC, 0x71C6BB6A3DFAEA50), 0,
  "geo_ray_sphere: a near-tangent miss past the limits -> 0 (3.4.2: 0x40ADC2A08A2552E3)");
# |d| 2^577, r 2^44: the compensated offset cannot certify either way; the double-double or exact roots answer.
assert_eq(_w2W1_sph(0xC437E41688434365, 0xC4350046D549C9C1, 0xC417739198C5663F, 0x640234A2D6E8D291, 0x640000E0C74E2F3E,
    0x63E1DEE4984F5AA3, 0xC08EE7958BFC5D70, 0xC08CB62271827C38, 0xC0845F19A732F6B8, 0x42BA5E3F4D2BD08A),
  0x2024FF1FC830E537, "geo_ray_sphere: past the limits, the compensated step declines -> _geo_sphere_acc's root");
# A sphere of radius 2^-932 met from 2^-913 (both under 2^-484, so the copy), within 8 ulps of tangency.
assert_eq(_w2W1_sph(0x06BF1A5FCD2D40BF, 0x86F517334D2B8B99, 0x86D01C9282D9F218, 0xC67797057E15FD74, 0x46AFFE089D0A65C3,
    0x46887093DB724B3C, 0x83E60A705EDB41DC, 0x83D0481D6A65047C, 0x83E4547C3C8DD2F8, 0x05B34BB6C256A039),
  0x0035187F06D63528, "geo_ray_sphere: a tiny sphere, near tangency -> the compensated root (3.4.2: the miss)");
# r^2 under DBL_MIN (r 2^-513), the roadmap's "r^2 near DBL_MIN" class.
assert_eq(_w2W1_sph(0x213CB75D0B85E49D, 0x21512BCB7D99144B, 0x213E2EB815C14CC4, 0xC265CA1D23B17BDD, 0xC27A0EEF5BFE6477,
    0xC266E6ED51891815, 0x1F0EB2B49B45F51C, 0x9EFBBF6237C6CEF8, 0x9EF44572C5A41A80, 0x1FE8329C05D5D52F),
  0x1EC51618A12261F5, "geo_ray_sphere: r^2 under DBL_MIN, near tangency -> the root (3.4.2: the miss)");
# o - c overflows (halved into the copy): the compensated step and the exact roots.
assert_eq(_w2W1_sph(0xFFE8C2DC8E05015C, 0xF9E1397B8A95D070, 0x7A70B35E23AD4494, 0x41D1999975744DD4, 0x41A1FFB7880E2193,
    0xC1A315A383EC1542, 0x7FE808840BF7C4AC, 0xFF55753B45328FB0, 0x7D1CE794BB052320, 0x7FD1EE6BC3CD7B17),
  0x7E156ECF7DB8CD58, "geo_ray_sphere: o - c overflows, near tangency -> the compensated root (3.4.2: 8.7e5 ulps off)");
assert_eq(_w2W1_sph(0x7FE2BC1ECF397D39, 0xFC0F59E5EE1D0148, 0x7BE0B39BD3988EC4, 0xC04D5F4B3AA9AE77, 0x3C6A6AB5AEE43530,
    0xBF54F48D64EFF8C0, 0xFFE01FB83384F5AD, 0x78E27A7181ADFCC8, 0xFEF8DE9BF8BE3880, 0x7B990F5BC53D34C3),
  0x7F92FD19E60904D3, "geo_ray_sphere: o - c overflows, the compensated step declines -> the exact roots");
# A ray past the limits that is not near tangency, its c cancelled by between one bit and two: 7.38 ulps through 3.4.2.
assert_eq(_w2W1_sph(0x6124B39A6EAA1368, 0xE1405911177CA869, 0x610F22F071139AFC, 0xDC8007706EE1C6F7, 0x5C823E430DA2F764,
    0xDC79928BE1FB582A, 0x6020DC5BD1D91F8E, 0xE0296693F7D7EF28, 0xE01335B35EC45548, 0x613D3F0056F9D818),
  0x447DA96DAB725977, "geo_ray_sphere: past the limits, c one bit down -> c formed exactly (3.4.2: ...970)");
assert_eq(_w2W1_sph(0xFC7113E2EFC73869, 0x7C53A9C926A794A8, 0x7C629D1EEBEF14ED, 0x6A7A1D1810093EB5, 0xEA5E112E134EC8B8,
    0xEA6C7665365582F4, 0x7B274AB1540E9198, 0x7B3125E149E18EFA, 0xFB249F0C2EB5E40C, 0x7A3AC97EE440B58A),
  0x51E4ED5E89C00F04, "geo_ray_sphere: past the limits, grazing -> certified (3.4.2: ...EF9, 10.6 ulps)");

# The copy's solve directly, at unit size: oc = (-4, 1, 0) along x, r = 1 + 2^-52: r^2 - |f|^2 = 2^-51 + 2^-104, which
# the plain offset's bound does not certify (2); the compensated offset does, with the roots 4 -+ sqrt(2^-51 + 2^-104).
_w2W1_set(&_w2W1_v1, 0xC010000000000000, F64_ONE, 0);
_w2W1_set(&_w2W1_v2, F64_ONE, 0, 0);
_w2W1_set(&_w2W1_v3, 0, 0, 0);
assert_eq(_geo_sph_solve_s(&_w2W1_v1, &_w2W1_v2, 0x3FF0000000000001, &_w2W1_v3, &_w2W1_hac, &_w2W1_out), 2,
  "_geo_sph_solve_s: within 2^-51 of tangency -> 2, not certified");
assert_eq(load64(&_w2W1_hac), 0xC010000000000000, "... hb = -4 handed back");
assert_eq(load64(&_w2W1_hac + 8), F64_ONE, "... a = 1");
assert_eq(load64(&_w2W1_hac + 16), 0x4030000000000000, "... c = 16 (17 - r^2 rounded)");
assert_eq(_geo_sph_comp_v(&_w2W1_v1, &_w2W1_v3, F64_ONE, 0, 0, 0x3FF0000000000001, 0xC010000000000000, F64_ONE,
    0x4030000000000000, &_w2W1_out), 1, "_geo_sph_comp_v: the same copy -> 1, certified");
assert_eq(load64(&_w2W1_out), 0x400FFFFFFD2BEC33, "... the near root 4 - sqrt(2^-51 + 2^-104), rounded (0.19 ulp)");
assert_eq(load64(&_w2W1_out + 8), 0x40100000016A09E6, "... the far root 4 + sqrt(2^-51 + 2^-104), rounded (0.41 ulp)");
# Not near tangency: r = 1, |f| = 1/2 -> certified on the spot, the roots 4 -+ sqrt(3) / 2.
_w2W1_set(&_w2W1_v1, 0xC010000000000000, F64_HALF, 0);
assert_eq(_geo_sph_solve_s(&_w2W1_v1, &_w2W1_v2, F64_ONE, &_w2W1_v3, &_w2W1_hac, &_w2W1_out), 1,
  "_geo_sph_solve_s: |f| = r / 2 -> 1, certified");
assert_eq(load64(&_w2W1_out), 0x4009126145E9ECD6, "... 4 - sqrt(3) / 2, 0.61 ulp (exact ...D5)");
assert_eq(load64(&_w2W1_out + 8), 0x401376CF5D0B0995, "... 4 + sqrt(3) / 2, rounded (0.31 ulp)");
# r and |f| whose squares flush (2^-600 at unit size): read at their own scale (_geo_sph_fine_near); near tangency
# they go back to the caller for _geo_sph_xcert (3), with hb, a and c.
_w2W1_set(&_w2W1_v1, 0xC010000000000000, 0x1A70000000000000, 0);
assert_eq(_geo_sph_solve_s(&_w2W1_v1, &_w2W1_v2, 0x1A70000000000001, &_w2W1_v3, &_w2W1_hac, &_w2W1_out), 3,
  "_geo_sph_solve_s: r, |f| 2^-600 within an ulp of tangency -> 3, for _geo_sph_xcert");
assert_eq(load64(&_w2W1_hac + 16), 0x4030000000000000, "... c = 16 handed back");
assert_eq(_geo_sph_solve_s(&_w2W1_v1, &_w2W1_v2, 0x1A80000000000000, &_w2W1_v3, &_w2W1_hac, &_w2W1_out), 1,
  "_geo_sph_solve_s: ... r = 2 |f| -> 1, _geo_delta_fine's roots");
assert_eq(load64(&_w2W1_out), 0x4010000000000000, "... 4 - 2^-600 sqrt(3), rounded: 4");

# |f| 2^-55 of |oc|, r = 1.25 |f|: r^2 - |f|^2 = 0.5625 |f|^2, inside the certificate's 1.0625, and the offset's
# k rounding (2^-99 |oc|^2) is past what that delta can carry: 2, where a narrower test (0.5) would answer 1.
_w2W1_set(&_w2W1_v1, 0xBFF0000000000000, 0x3C80000000000000, 0);
assert_eq(_geo_sph_solve_s(&_w2W1_v1, &_w2W1_v2, 0x3C84000000000000, &_w2W1_v3, &_w2W1_hac, &_w2W1_out), 2,
  "_geo_sph_solve_s: r^2 - |f|^2 = 0.5625 |f|^2, |f| 2^-55 |oc| -> 2");

# ================================================================
test_group("3.5.0 W1: _geo_sph_fine_near -- r^2 - |f|^2 < 1.0625 |f|^2 at their own scale");
# ================================================================
assert_eq(_geo_sph_fine_near(_w2W1_set(&_w2W1_v1, F64_ONE, 0, 0), F64_ONE), 1, "|f| = r: tangent -> 1");
assert_eq(_geo_sph_fine_near(_w2W1_set(&_w2W1_v1, F64_ONE, 0, 0), 0x3FF6A09E667F3BCD), 1,
  "r = sqrt(2) |f| rounded up: r^2 - |f|^2 = 1 + 2^-52 < 1.0625 -> 1");
assert_eq(_geo_sph_fine_near(_w2W1_set(&_w2W1_v1, F64_ONE, 0, 0), 0x3FF6FA6EA162D0EF), 1,
  "r = sqrt(2.0625) |f| less 1 ulp: r^2 - |f|^2 rounds under 1.0625 |f|^2 -> 1");
assert_eq(_geo_sph_fine_near(_w2W1_set(&_w2W1_v1, F64_ONE, 0, 0), 0x3FF6FA6EA162D0F0), 0,
  "r = sqrt(2.0625) |f| rounded: r^2 - |f|^2 rounds to 1.0625 |f|^2, not under it -> 0");
assert_eq(_geo_sph_fine_near(_w2W1_set(&_w2W1_v1, 1, 0, 0), 1), 1, "f and r 2^-1074 -> 1 (their squares flush)");
assert_eq(_geo_sph_fine_near(_w2W1_set(&_w2W1_v1, 1, 0, 0), 2), 0, "f 2^-1074, r 2^-1073 -> 0");
assert_eq(_geo_sph_fine_near(_w2W1_set(&_w2W1_v1, 0, 0, 0), F64_ONE), 0, "f = 0 -> 0 (through the centre)");
assert_eq(_geo_sph_fine_near(_w2W1_set(&_w2W1_v1, 0x4000000000000000, 0, 0), F64_ONE), 1, "|f| = 2 r, a miss -> 1");
assert_eq(_geo_sph_fine_near(_w2W1_set(&_w2W1_v1, 0, 0x7FE0000000000000, 0), 0x7FE0000000000000), 1,
  "f and r 2^1023 -> 1 (their squares overflow)");
assert_eq(_geo_sph_fine_near(_w2W1_set(&_w2W1_v1, F64_ONE, 0, 0), 0x7FF8000000000000), 0, "a NaN r -> 0");

# ================================================================
test_group("3.5.0 W1: the copy's solve keeps _geo_sph_solve's forms for the sphere");
# ================================================================
# Rays past the limits through _geo_sph_solve_s, each taking one of the forms it copies from _geo_sph_solve (the
# same answers as 3.4.2 there); each assertion fails when that form is dropped (the mutant's answer in brackets).
# [measured: scratch mutrun/mkdrv.py mutant drivers and py/mfam.py, exact Fraction oracle, 2026-11-14]
# The classic discriminant for an origin inside (without it, the RTG form: ...90C, 1.04 ulps).
assert_eq(_w2W1_sph(0x6A1260C0BD3B6DEF, 0x698E74D882418000, 0x6A21F279435C0BE6, 0xD9906F69891DF901, 0x59A6DB7E5CB29206,
    0xD9E77B40CDF29168, 0xE81AEB7A4315C150, 0x6837FD7F6A5641A4, 0xE830BDC426BA4ADE, 0x6A39A42FB61AEEC4),
  0x5047545132F2790D, "geo_ray_sphere: past the limits, origin inside -> the classic discriminant's root");
# hb with o - c's lows for a grazing chord from the surface (plain hb: ...60DD2, 49,067 ulps). 1.20 ulps from exact.
# [measured: scratch mutrun/mkdrv.py mutant drivers and py/mfam.py, exact Fraction oracle, 2026-11-14]
assert_eq(_w2W1_sph(0xE4B3B9A651669CF2, 0x64933E0DC7448BCE, 0x64B5399DF07D4630, 0xC59D94A7997E53A2, 0x454B285157ABB80C,
    0xC59BAED1C60CFC87, 0x62EB810E78649930, 0x6301191C5004502C, 0x62F9110D27204E50, 0x64BD5F4B3AC79505),
  0x5DF37E598DC6CD7E, "geo_ray_sphere: past the limits, a grazing chord -> hb with o - c's lows (1.20 ulps)");
# c formed exactly within 2^-48 |oc|^2 of 0, an origin on the surface (without: ...94A, 1.29 ulps).
# [measured: scratch mutrun/mkdrv.py mutant drivers and py/mfam.py, exact Fraction oracle, 2026-11-14]
assert_eq(_w2W1_sph(0x60432C8C0AE7EEE2, 0xE074FF529D3F7AA1, 0xE0A0C2F23FF68522, 0xBFB7C9F93BBA8F17, 0xBF86701B6AAF4669,
    0xBF96AE24CBD90B56, 0xE05EDF952FC83240, 0xE09254B4D95E8468, 0xE093B3B7FFF98248, 0x6093328AD1E1CC86),
  0x5D7DDAA67A0AD949, "geo_ray_sphere: past the limits, origin on the surface -> c exact");
# The offset across d (_geo_perp_part) for a ray near a small sphere's centre: an exact miss (the plain offset:
# a hit at 0x5ACAA1DD7B97726A).
assert_eq(_w2W1_sph(0x60C0BBF8ECE08F73, 0xE06EBA1359CCF25A, 0x60BF52414F2EB5B0, 0xC5E41B673E2EFF60, 0x459275BCF8455F7B,
    0xC5E2D129EBA665E5, 0x5D30C9326623238A, 0xDD3FDD7E926EEF2E, 0xDD0BF635AEF470B0, 0x5B4D5F4B3AC79505), 0,
  "geo_ray_sphere: past the limits, near a small sphere's centre -> the offset across d: the miss");
# The exact discriminant where hb^2 and a c cancel (without: ...AC2, 1.58 ulps).
assert_eq(_w2W1_sph(0xE490B5E0E851B681, 0xE49D69663F1F037D, 0xE47B81C348795988, 0x5D76EB6FB2EE0624, 0x5D548CEC2A92E8A4,
    0xDD53B1EA2728E920, 0xE370F08B8D55846A, 0xE36E43FBF0B610B8, 0xE3783D8FF4C25538, 0x649B83DEC8B65F9E),
  0x470BCB33775B7AC4, "geo_ray_sphere: past the limits, hb^2 and a c cancel -> the exact discriminant");

# ================================================================
test_group("3.5.0 W1: grazing rays where r^2 and |f|^2 both flush (_geo_sphere_roots_full)");
# ================================================================
# r 2^-484 or less, |o - c| more: _geo_sph_xcert at the general routine's own scale, and nearer tangency than it
# certifies the unit-size copy, where r^2 does not flush (r 2^-21 of |o - c|). Read the miss through 3.4.2.
assert_eq(_w2W1_sph(0x22D2DC9FB66C76B9, 0x22D805ED0094407C, 0xA2C05920843C8564, 0xB6E6430CEB6A0352, 0xB6EC5A88948D5279,
    0x36D34B8CF236470A, 0x213D3790E2ACBA0E, 0x20F29324922868E0, 0x20FE0B537D775A00, 0x217B036D9CDFB603),
  0x2BDB1CD26A40FE9B, "geo_ray_sphere: r 2^-487, |o - c| 2^-466, near tangency -> the root rounded (3.4.2: the miss)");
# r 2^-568 of |o - c| (so they flush in the copy too): a miss that read a hit, and a hit that read the miss.
assert_eq(_w2W1_sph(0x73C53BDF06B0C813, 0x739916CCFB2B1D36, 0xF3D43F060D5D6844, 0xC02CB226936392EC, 0xC000F46DB8955239,
    0x403B5C6356026C62, 0x72944ADA37DCEEB0, 0xF2C619F1D24F0368, 0xF2CB3F45345B1312, 0x70511857D83A5C25), 0,
  "geo_ray_sphere: a sphere 2^-568 of its distance, an exact miss -> 0 (3.4.2: 0x7387ADC1A1002612)");
assert_eq(_w2W1_sph(0xE295D5F6FC3B4D80, 0xE2E498ECAC1B90F6, 0xE2CC27B6F24F6289, 0x3D308F7ABC5CA65A, 0x3D7F3E1104E82E71,
    0x3D655A653B1E01E5, 0x5FAEA4751D43198E, 0xDF7BF5A620FB14A0, 0x5F1DC129C7DFC800, 0x5F5DDAA581D58178),
  0x655518C7AE45D896, "geo_ray_sphere: ... a hit -> the exact root rounded (3.4.2: the miss)");

# ================================================================
test_group("3.5.0 W1: the flushed rays' certificate (_geo_sph_xcert) -- the review's right -> wrong rays");
# ================================================================
# The first repair sent these to the unit-size copy, where a radius under 2^-1074 of |o - c| rounds to 0 and the
# offset beside it too: each read a tangent hit. Each is an exact miss, as 3.4.2 and the merged tree answered.
# [measured: scratch orc.py exact Fraction oracle, 3.4.2 / merged tree / first repair / this tree, 2026-11-14]
assert_eq(_w2W1_sph(0xC6293E5939A08CEA, 0x01D81BE3BB5811C4, 0, F64_ONE, 0, 0, 0, 0, 0, 0x01A56E1FC2F8F359), 0,
  "geo_ray_sphere: r 1e-300 missed by 8 radii from 1e30 away -> 0 (first repair: 1e30)");
assert_eq(_w2W1_sph(0xC630000000000000, 0x0210000000000000, 0, F64_ONE, 0, 0, 0, 0, 0, 0x0170000000000000), 0,
  "geo_ray_sphere: r 2^-1000 missed by 1023 radii from 2^100 away -> 0 (first repair: 2^100)");
assert_eq(_w2W1_sph(0xC630000000000000, 0x0188000000000000, 0x0190000000000000, F64_ONE, 0, 0, 0, 0, 0,
    0x0193FFFFFFFFFFFF), 0, "geo_ray_sphere: ... r one ulp under tangency -> 0 (first repair: 2^100)");
assert_eq(_w2W1_sph(0xC630000000000000, 0x0188000000000000, 0x0190000000000000, F64_ONE, 0, 0, 0, 0, 0,
    0x0194000000000000), 0x4630000000000000, "geo_ray_sphere: ... r exactly tangent -> the double root 2^100");

# ================================================================
test_group("3.5.0 W1: _geo_sph_xcert's parts, each pinned by a ray it decides");
# ================================================================
# Each ray below changes its answer when one part of the certificate or its routing is taken out, and the expected
# value is the exact root correctly rounded. r and |o - c| are given as powers of two, "the copy" being the unit-size
# copy (_geo_sphere_roots_scaled).
# [measured: scratch mutants.py / cover.py, 44 mutants over the 181,500-ray corpus, Fraction oracle, 2026-11-14]
# r 2^-1086 of |o - c| (2^368), near tangency: the exact products at the general routine's scale.
assert_eq(_w2W1_sph(0xD6FA55123BFAE546, 0x93E5B568D9C34E12, 0xCB2EC0E3043C88C9, F64_ONE, 0, 0, 0x20D9038061D38CA1,
    0x93E5B4942E14AC03, 0xCB2EC0E3043C88C9, 0x131A9575D441E008), 0x56FA55123BFAE546,
  "geo_ray_sphere: r 2^-1086 of |o - c|, near tangency -> the root rounded (3.4.2: ...545, 1.00 ulp)");
# |o - c| 2^970, r 2^-108: r rounds in the copy, and the certificate is taken at 2^499 times its scale.
assert_eq(_w2W1_sph(0x3935118FE3C68B50, 0x7C937DC3F538FDC0, 0x39297538888FE856, 0, 0xBFEF5F3A83F52864, 0, 0, 0, 0,
    0x39389D831341BA1C), 0x7C93E1A6EA07D901, "geo_ray_sphere: |o - c| 2^970, r 2^-108 -> the root rounded");
# A subnormal r (2^-1053) from 2^27 away: X on the subnormal grid, inside the 2^-1066 each X_i takes.
assert_eq(_w2W1_sph(0xC1A76614E80E7AFC, 0x8000000000228E94, 0x00000000000D16FA, 0x3FD4DC07EE43BA48, 0, 0, 0, 0, 0,
    0x000000000024F3F8), 0x41C1F29CDE2B5927, "geo_ray_sphere: r 2^-1053 from 2^27 -> the root rounded (3.4.2: ...926)");
# r 2^-48 of |o - c| (2^-476): the plain products, then the copy, where r^2 does not flush.
assert_eq(_w2W1_sph(0xA237D1005D6463BF, 0x2221ADF9F2E9B94D, 0x2226C7DD2B471AB9, 0x3DD2D04E1E13529F, 0xBDBBEE8F06090E00,
    0xBDC1FEDC57813988, 0x9F7AA24030D28570, 0x1F655471AC02AD32, 0x9F7925F1F72E387F, 0x1F31EC2AD077CBC3),
  0x245441293A6500F6, "geo_ray_sphere: r 2^-48 of |o - c| 2^-476 -> the root rounded (3.4.2: ...0F7, 1.21 ulps)");
# |o - c| 2^972, r 2^-523: at 2^499 times the copy's scale, both roots.
var _w2W1_ro4 = _w2W1_ray(0x1F4324622308922E, 0x7CB1213F387568F8, 0x1F34DAFF76C30467, 0, 0xC004E5398AD52C96, 0);
assert_eq(_geo_sphere_roots(_w2W1_ro4, _w2W1_sphere(0, 0, 0, 0x1F45CC5228091520), &_w2W1_out), 1,
  "_geo_sphere_roots: |o - c| 2^972, r 2^-523 -> 1");
assert_eq(load64(&_w2W1_out), 0x7C9A3BBA94D8DB83, "... the near root rounded");
assert_eq(load64(&_w2W1_out + 8), 0x7C9A3BBA94D8DB83, "... the far root rounded");
# |d| 2^511 at a sphere 2^-692 across: a dl, and _geo_delta_fine's a delta, past DBL_MAX (_geo_sqrt_ad).
assert_eq(_w2W1_sph(0xA532462CB6A234D3, 0x1408F5351A613BB8, 0x1DFC2B3711A7AFA2, 0x5FEEC4AA6C6FF046, 0, 0,
    0x19E22DBE1AF181A5, 0x925E6F0A7B08A9F4, 0x1DFC2B3711A7AFA2, 0x14B0DF14119C119C), 0x05330175EAE80EB5,
  "geo_ray_sphere: |d| 2^511, r 2^-692 -> the root rounded (3.4.2: 0, the miss)");
assert_eq(_w2W1_sph(0x14FDB1DA5347C8F3, 0x1523CDE816BB6B7D, 0xA24140E77F2A6F3D, 0, 0, 0x5FEAD777015E47C2, 0, 0, 0,
    0x1763B2653FA46A01), 0x024491BAECDC004A, "geo_ray_sphere: |d| 2^511.7, r 2^-649 -> the root rounded (3.4.2: 0)");
# r 2^-862 of |o - c| (2^-132): the exact products, where the plain ones refuse.
assert_eq(_w2W1_sph(0x81D0C2423D02C9BE, 0x37B1617136C0194A, 0x01A08D4AE6ECA153, 0, 0xC02F3A674C4FA24F, 0, 0, 0, 0,
    0x01D0E2D48C0112F7), 0x3771CF6B1F791872, "geo_ray_sphere: r 2^-862 of |o - c| -> the exact products' root");
# r 2^-18 of |o - c| (2^-483), near tangency: the plain products decline and the copy answers (3.4.2: the miss).
assert_eq(_w2W1_sph(0x21C4562FD9077A20, 0xA1BADDBD09B658F9, 0xA1B0219F14D48745, 0xBD88195D97E208ED, 0x3D7FD639F12B3092,
    0x3D731DACB7224165, 0x9FC2D0FD85B5A41F, 0x9FC86C6952C8B4AE, 0x9FAC57C4DFDF0C1C, 0x20AA593CEE209022),
  0x242B0105723CF542, "geo_ray_sphere: r 2^-18 of |o - c| 2^-483 -> the copy's root rounded (3.4.2: 0)");
# r 2^-55 of |o - c| (2^-472): the plain products certify, their bound with E_i^2 (3.4.2: ...545, 1.00 ulp).
assert_eq(_w2W1_sph(0x1E4B99E7AFA2DB8B, 0xA26BDBF890ADABEF, 0xA27DEC212FB7755C, 0xB8F86A8590FFF71E, 0x3FE651D3DE099E8D,
    0x3FF7F8F72F4195D1, 0, 0, 0, 0x1F0625E60ED6569A), 0x2273F89B4DADC546,
  "geo_ray_sphere: r 2^-55 of |o - c| 2^-472 -> the root rounded");
# |o - c| 2^-536, r 2^-1041 (both under 2^-484: the copy, where r is 2^-505 and normal): its own scale.
assert_eq(_w2W1_sph(0x9E756927E7174A81, 0x00000002D9476726, 0, 0x3FBB5D9F0B5E9801, 0, 0, 0, 0, 0, 0x00000002DB3DCC8B),
  0x1EA9095F16D91B1B, "geo_ray_sphere: |o - c| 2^-536, r 2^-1041 -> the copy's certificate, rounded");
# r 2^-38 of |o - c| (2^-477), a hit outside the 1.0625 window: _geo_delta_fine's root, the merged tree's bits.
assert_eq(_w2W1_sph(0x2221FA4380E7AA6C, 0xA1FFC59D903C9FB8, 0x22214BB268F66D4B, 0xC00D2D999BF2BBAA, 0x3FE9C88A55A8CCC3,
    0xC00C1245FC757F3B, 0x9E6188CDAC471E22, 0x9E726197FDEF7687, 0x9E76EAC4688EE0D3, 0x1FCC58F9C91F6B0E),
  0x2203B75B99BD6477, "geo_ray_sphere: r 2^-38 of |o - c|, away from tangency -> the root rounded");
# o - c overflows, r 2^-28, both roots behind the origin (3.4.2: the miss).
var _w2W1_rov = _w2W1_ray(0xBE3741B3D724D423, 0xFFDB383A0A7E1D23, 0xBE2566723A6C369D, 0, 0xC0525F27451F71DF, 0);
assert_eq(_geo_sphere_roots(_w2W1_rov, _w2W1_sphere(0, 0x7FE66AE8DBDC4A07, 0, 0x3E39999E5C327F96), &_w2W1_out), 1,
  "_geo_sphere_roots: o - c past DBL_MAX, r 2^-28, both roots behind -> 1 (3.4.2: 0)");
assert_eq(load64(&_w2W1_out), 0xFF8F60608F62F645, "... the near root rounded");
assert_eq(load64(&_w2W1_out + 8), 0xFF8F60608F62F645, "... the far root rounded (a double root to 2^-53)");
# A direction 2^-1060 long (scaled by sc in the general routine) at a sphere 2^-500 across, 2^-400 away: the roots
# multiplied back by sc, exactly 2^660 to the rounding.
assert_eq(_w2W1_sph(0xA6F0000000000000, 0x20A8000000000000, 0, 0x4000, 0, 0, 0, 0, 0, 0x20B0000000000000),
  0x6930000000000000, "geo_ray_sphere: |d| 2^-1060, r 2^-500 from 2^-400 -> 2^660");

# ================================================================
test_group("3.5.0 W1: the certificate's helpers, directly");
# ================================================================
# _geo_xc_dd: x y - z t and the exact sum of its roundings' errors, 2^-50 larger. Products of magnitudes 2^29 apart
# leave the high words' difference and the sum inexact; the expected values are the same arithmetic in Python
# floats (IEEE binary64), and |x y - z t - result| is under the bound (exactly, in Fractions).
# [measured: scratch emu.py / emu3.py, Fraction check of the bound, 2026-11-14]
assert_eq(_geo_xc_dd(0xBFE9A20F5E320F4A, 0x3FF56D6B84B58297, 0xBFF9A20F5E320F4A, 0x41A56D6B84B83044, &_w2W1_out), 0,
  "_geo_xc_dd: returns 0");
assert_eq(load64(&_w2W1_out), 0x41B12A00394A8167, "... x y - z t, rounded");
assert_eq(load64(&_w2W1_out + 8), 0x3E4179BB21454821,
  "... its bound: the low words' rounding (2^-79.6) one ulp of it, the 2^-50 four (without: ...820, ...81D)");
_geo_xc_dd(0xC0127032A5081794, 0x40051E28F0484DE3, 0x3F956973F85680D1, 0x3DE1DF9A98B84DB3, &_w2W1_out);
assert_eq(load64(&_w2W1_out), 0xC028560404F4FAFE, "_geo_xc_dd: a second pair, x y - z t rounded");
assert_eq(load64(&_w2W1_out + 8), 0x3CCB7DED78044FFC, "... its bound: the 2nd sum's error, one ulp (without: ...FFB)");
# _geo_sph_xcert: a ray through the centre of a sphere 2^30 across from 2^40 away along x, |X| 2^-1000: D is
# formed at r's scale (from |X| alone r overflows there), certified, roots 2^40 -+ 2^30.
_w2W1_set(&_w2W1_v1, 0xC270000000000000, 0x0170000000000000, 0);
_w2W1_set(&_w2W1_v2, 0, 0, 0);
_w2W1_set(&_w2W1_v3, F64_ONE, 0, 0);
assert_eq(_geo_sph_xcert(&_w2W1_v1, &_w2W1_v2, &_w2W1_v3, 0x41D0000000000000, F64_ONE, 0xC270000000000000,
    0x44EFFFFE00000000, 0, &_w2W1_out), 1, "_geo_sph_xcert: |X| 2^-1030 of r -> 1, at r's scale");
assert_eq(load64(&_w2W1_out), 0x426FF80000000000, "... 2^40 - 2^30");
assert_eq(load64(&_w2W1_out + 8), 0x4270040000000000, "... 2^40 + 2^30");
# _geo_dir_unit: d into [1, 2) by a power of two; 0 where a component loses a bit there.
assert_eq(_geo_dir_unit(_w2W1_set(&_w2W1_v1, 0x4008000000000000, 0x1A70000000000000, F64_ONE), &_w2W1_v2), 1,
  "_geo_dir_unit: (3, 2^-600, 1) -> 1, exact");
assert_eq(load64(&_w2W1_v2), 0x3FF8000000000000, "... 3 -> 1.5");
assert_eq(load64(&_w2W1_v2 + 8), 0x1A60000000000000, "... 2^-600 -> 2^-601");
assert_eq(_geo_dir_unit(_w2W1_set(&_w2W1_v1, 0x6570000000000000, 0x1A70000000000003, 0), &_w2W1_v2), 0,
  "_geo_dir_unit: (2^600, 2^-600 (1 + 3 2^-52), 0) -> 0, a bit lost under DBL_MIN");
# _geo_sqrt_ad: sqrt(a x) where the product is subnormal (plain: ...45B64EB) or past DBL_MAX.
assert_eq(_geo_sqrt_ad(0x037ABCDEF0123457, 0x3AF3456789ABCDEF), 0x1F36B311848198C6,
  "_geo_sqrt_ad: a x 2^-1047, subnormal -> sqrt(a x) rounded");
assert_eq(_geo_sqrt_ad(0x7FE8000000000000, 0x4008000000000000), 0x5FF8000000000000,
  "_geo_sqrt_ad: 1.5 2^1023 times 3, past DBL_MAX -> 3 2^511");

# ================================================================
test_group("3.5.0 W1: _geo_sph_comp past r |oc| 2^512 (roadmap Rays, GEO7 F5)");
# ================================================================
# r 2^394, |o - c| 2^395, |d| 1/4, within 8 ulps of tangency: |f|^2 |oc|^2 overflows. The compensated step
# now certifies (3.4.2 refused, and _geo_sphere_acc answered at 2.3 times the cost).
fn _w2W1_comp_at(ox, oy, oz, dx, dy, dz, cx, cy, cz, r) {
    _w2W1_set(&_w2W1_v1, ox, oy, oz);
    _w2W1_set(&_w2W1_v2, cx, cy, cz);
    var px = f64_sub(ox, cx);
    var py = f64_sub(oy, cy);
    var pz = f64_sub(oz, cz);
    var a = f64_add(f64_add(f64_mul(dx, dx), f64_mul(dy, dy)), f64_mul(dz, dz));
    var hb = f64_add(f64_add(f64_mul(px, dx), f64_mul(py, dy)), f64_mul(pz, dz));
    var c = f64_sub(f64_add(f64_add(f64_mul(px, px), f64_mul(py, py)), f64_mul(pz, pz)), f64_mul(r, r));
    return _geo_sph_comp(&_w2W1_v1, &_w2W1_v2, dx, dy, dz, r, hb, a, c, &_w2W1_out);
}
assert_eq(_w2W1_comp_at(0xD8C0048406A203E5, 0xD8AB3C997E73F766, 0xD8B85E4838667540, 0x3FCE05C24711162C,
    0x3FC2FBE9DCF50423, 0x3FD208BB620D685E, 0xD78E91FA4ACA5580, 0x5785DE36B66F3ECA, 0xD763C6FB5DF33FD8,
    0x58A289F871228A71), 1, "_geo_sph_comp: |f| |oc| 2^789 -> 1, certified (3.4.2: 0, the bound +Inf)");
assert_eq(load64(&_w2W1_out), 0x58DA368FF420559B, "... the near root, rounded");
assert_eq(_w2W1_sph(0xD8C0048406A203E5, 0xD8AB3C997E73F766, 0xD8B85E4838667540, 0x3FCE05C24711162C, 0x3FC2FBE9DCF50423,
    0x3FD208BB620D685E, 0xD78E91FA4ACA5580, 0x5785DE36B66F3ECA, 0xD763C6FB5DF33FD8, 0x58A289F871228A71),
  0x58DA368FF420559B, "geo_ray_sphere: the same ray -> the compensated root (3.4.2: ...59C, 0.70 ulp)");

# ================================================================
test_group("3.5.0 W1: _geo_sph_comp's roots from double-double hb, a and c (the second review's must-fix 3)");
# ================================================================
# The compensated step certified its roots against delta's error only, and took them from the caller's plain hb,
# a and c: near-tangent rays read up to 6.6 ulps, and past r |oc| 2^512, where it had refused and _geo_sphere_acc
# answered, 7 of 39,000 went right -> wrong. Each expected value is the exact root, correctly rounded (Fractions);
# the merged tree's bits are in the message.
# [measured: scratch ev4.py comp512in / mid / unit / graze families, seeds 1-3, Fraction oracle, 2026-11-14]
assert_eq(_w2W1_sph(0x5C9510281AA965AC, 0xDCD138565F780B96, 0xDCB1359F7D20CD40, 0xBF250D2D00000000, 0x3F6135E680000000,
    0x3F41333000000000, 0x5C63032262B060F1, 0xDC7E01AF11636CFB, 0xDC797B20C70B0327, 0x5C72C05DB4CDBC16),
  0x5D5F023E2ADF881A, "geo_ray_sphere: r |oc| 2^914, near tangency -> the root, rounded (merged: ...816, 4.40)");
assert_eq(_w2W1_sph(0x536B6A3B7E9D5C60, 0xD36919BA86E34C08, 0xD37217132B62DCA4, 0xBEB2ECB538F00000, 0x3EB153B35F940000,
    0x3EB8F9B0ECB40000, 0x536F1045B291F44E, 0x534CAC65A330AF58, 0xD351BA3353BC6BF7, 0x536AFF761356B557),
  0x549D4253904F4E1A, "geo_ray_sphere: |oc| 1.57 r, near tangency -> the root, rounded (merged: ...E16, 4.03)");
# Grazing from 1.42 radii out: without its 5 |f|^2 term _geo_sph_graze certifies the plain root (...242, 4.74 ulps);
# the compensated step's root is the exact one, rounded (3.4.2 and merged: ...244, 2.74 ulps).
assert_eq(_w2W1_sph(0x4071023EF36A5E9E, 0xC07105E4087AB9B4, 0x4071DC0B4AFAB93B, 0xC00B44CFECFDCC11, 0x3FC982E8ABD03E42,
    0xBFF714A18FF07F5F, 0x4060C9759F2B5AC6, 0xC06102316D9E0E2B, 0x405E9154612691E3, 0x406655BDA55B101B),
  0x403F3CEF3877F247, "geo_ray_sphere: 1.42 radii out, grazing -> the root, rounded (3.4.2: ...244, 2.74)");
# Both roots, each the exact one rounded: the first pair pins the coefficients' low words and the quotients'
# correction, the second the exact products' errors.
var _w2W1_rr: i64[2];
fn _w2W1_roots(ox, oy, oz, dx, dy, dz, cx, cy, cz, r) {
    store64(&_w2W1_rr, 0);
    store64(&_w2W1_rr + 8, 0);
    return _geo_sphere_roots(_w2W1_ray(ox, oy, oz, dx, dy, dz), _w2W1_sphere(cx, cy, cz, r), &_w2W1_rr);
}
assert_eq(_w2W1_roots(0x401718EBDED26AA6, 0xC039AA69ADD264A6, 0xC034A4D49BCC0553, 0x02FE5F987B5BE1F8,
    0x8300E1EC36919C28, 0x02EF6809196E2108, 0x4011F530E052B60B, 0xC022FD72FDE184EF, 0xC03347C1361764EA,
    0x402693DBFA69CB09), 1,
  "_geo_sphere_roots: |d| 2^-975, behind the origin, grazing -> 1");
assert_eq(load64(&_w2W1_rr), 0xFD0F3DCA6AD1F6D9, "... the far root, rounded");
assert_eq(load64(&_w2W1_rr + 8), 0xFD0F3DCA3FF8FAC7, "... the near root, rounded (merged: ...AC2, 4.69 ulps)");
assert_eq(_w2W1_roots(0x5DD885F63E1B63A2, 0xDDBE6D6BB46353BE, 0xDDD6C244162F5A09, 0xBF9863C8870E605E,
    0xBF9880F3CD15A289, 0x3F978060F1973926, 0xDD7982231A642F1D, 0xDDD06D253B78B7F1, 0xDDD6FBF380C36A9D,
    0x5DD1C2BD689F9F34), 1,
  "_geo_sphere_roots: r |oc| 2^957, near tangency -> 1");
assert_eq(load64(&_w2W1_rr), 0x5E1DFAEF0D9B372F, "... the near root, rounded (merged: ...729, 6.06 ulps)");
assert_eq(load64(&_w2W1_rr + 8), 0x5E1DFAEF3BD62CB9, "... the far root, rounded (merged: ...CBA, 0.72 ulp)");
# 2^-8 of tangency at unit size: sq from the double-double a (from the plain a, the near root's ...FB3, 0.51 ulp).
assert_eq(_w2W1_roots(0xC057F60233BCF23C, 0x40487A19517A17AE, 0x404CB6542ADB3B8C, 0x3F949157FA0FB0F9,
    0xBF8DB68404142EC1, 0x3F77DCD899415ACE, 0x4041C23B71076884, 0xC053C55BEE9F5E43, 0x405BE70FC7999738,
    0x403D55C74A68258A), 1, "_geo_sphere_roots: unit size, grazing -> 1");
assert_eq(load64(&_w2W1_rr), 0x40BC78213E7DFFB4, "... the near root, rounded (merged: ...FB3, 0.51 ulp)");
assert_eq(load64(&_w2W1_rr + 8), 0x40BD8E1572D0FB62, "... the far root, rounded (merged: ...B61, 1.33 ulps)");
# The capsule's end cap takes the sphere's roots: past r |oc| 2^512 it read 4.41 ulps in the merged tree.
var _w2W1_cap = geo_capsule_new(hvec3_new(0x59B938AFCC661DB8, 0x59F8521F5295ED5E, 0x59ED67415854313C),
  hvec3_new(0xDA05DF77B6582B70, 0x5A3049C8ED38A199, 0xDA364AF8ED1F6FE3), 0x59F5EEE53DC8DC50);
assert_eq(geo_ray_capsule_branch(_w2W1_ray(0xD9EC1CECFD0C80BA, 0x5A31085DB86F30F2, 0xDA363BD13BC7F051,
      0xBFB74CB517696691, 0x3FA204CA077BA432, 0x3F765D48965EBD09), _w2W1_cap, &_w2W1_out), 0x5A2DCED5B7329D09,
  "geo_ray_capsule_branch: an end cap of radius 2^416, grazing -> its root, rounded (merged: ...D05, 4.41)");
assert_eq(load64(&_w2W1_out), GEO_CAP_END_CAP, "... on the end cap");
# A c the caller formed exactly (c under 2^-44 |oc|^2, as _geo_c_near forms it) is kept: the double-double c's
# 2^-103 |oc|^2 would take the near root 745 ulps off here. Direct, at unit size: the origin 2^-65 radii inside.
# [measured: scratch srch_cdd.py, the always-double-double mutant's probe against Fractions, 2026-11-14]
_w2W1_set(&_w2W1_v1, 0x3FE8BC91B83607B6, 0xBFE440D8621DBD75, 0x3FEC7D7CF3C4ED78);
_w2W1_set(&_w2W1_v3, 0x3C563A2691574B20, 0x3C85DC9F2973987C, 0x3C656FF6997E48F8);
assert_eq(_geo_sph_comp_v(&_w2W1_v1, &_w2W1_v3, 0xBFE01427A9795A8D, 0xBFD8C53203800EB8, 0xBFE78AF7DBEAB71B,
    0x3FF5694F44EABCB7, 0xBFE98D1073DCB453, 0x3FEE3176B5FEB1C7, 0xBBF5D4AB1A6713AD, &_w2W1_out), 1,
  "_geo_sph_comp_v: c 2^-64 of |oc|^2, given exactly -> 1, certified");
assert_eq(load64(&_w2W1_out), 0xBBEB57393CEB8527, "... the near root c / q, rounded, from the caller's c");
assert_eq(load64(&_w2W1_out + 8), 0x3FFB147C66356770, "... the far root, rounded");
# _geo_sph_dd_quot: (nh + nl) / (dh + dl), corrected once; t alone where nh is under 2^-967 or the product overflows.
assert_eq(_geo_sph_dd_quot(0x038C61F6657B9A7A, 0x00259163724DC8DE, 0x3FF7BB13881D6796, 0xBC9CA92FF12C6D4A),
  0x038322EE73AF7FEF, "_geo_sph_dd_quot: nh 2^-967, the bound -> corrected, rounded (nh / dh alone: ...FEE)");
assert_eq(_geo_sph_dd_quot(0x0000000001DCCC84, 0x8000000000000000, 0x3CC01613BB05E8B1, 0xB9663F8A2FD82043),
  0x018DA3E25BAECAF3, "_geo_sph_dd_quot: a subnormal nh -> nh / dh (corrected, 2.7e8 ulps off)");
assert_eq(_geo_sph_dd_quot(0x7FEFFFFFFFFFFFFF, 0, 0x4388712B8A718192, 0), 0x7C54F28E9FBAA287,
  "_geo_sph_dd_quot: nh = DBL_MAX, t dh past it -> nh / dh (corrected: NaN)");
# _geo_sph_comp_roots: c = 0 is the root +0, and a root that underflows below zero -2^-1074, as _geo_quad_roots.
var _w2W1_cf: i64[6];
fn _w2W1_cr(hh, ah, ch, sq) {
    store64(&_w2W1_cf, hh);
    store64(&_w2W1_cf + 8, 0);
    store64(&_w2W1_cf + 16, ah);
    store64(&_w2W1_cf + 24, 0);
    store64(&_w2W1_cf + 32, ch);
    store64(&_w2W1_cf + 40, 0);
    return _geo_sph_comp_roots(&_w2W1_cf, sq, &_w2W1_out);
}
assert_eq(_w2W1_cr(0x0000000000004000, 0x43B0000000000000, 0, 0x0000000000004000), 1,
  "_geo_sph_comp_roots: hb = sq = 2^-1060, a = 2^60, c = 0 -> 1");
assert_eq(load64(&_w2W1_out), 0x8000000000000001, "... q / a under 2^-1074 below zero -> -2^-1074, not -0");
assert_eq(load64(&_w2W1_out + 8), 0, "... c = 0 -> the root +0");
assert_eq(_w2W1_cr(0x43B0000000000000, F64_ONE, 0x0000000000004000, F64_ONE), 1,
  "_geo_sph_comp_roots: hb = 2^60, a = sq = 1, c = 2^-1060 -> 1");
assert_eq(load64(&_w2W1_out), 0xC3B0000000000000, "... q / a = -(2^60 + 1), rounded");
assert_eq(load64(&_w2W1_out + 8), 0x8000000000000001, "... c / q under 2^-1074 below zero -> -2^-1074, not -0");

# ================================================================
test_group("3.5.0 W1: _geo_dir_unit's refusals (the second review's should-fix)");
# ================================================================
# A direction along x with a component 2^1022 or more under the largest, which loses bits taken to unit size,
# carries the line across a flushed sphere at the origin. Each refusal sends the ray on; without it the
# certificate reads the lost bits' line and the hit reads the miss. (3.4.2: the miss for both.)
# [measured: scratch famdu2.py MIfam / MHfam, seeds 1-2, Fraction oracle, 2026-11-14]
assert_eq(_w2W1_sph(0xCDB5DE6C66B9EE57, 0x0B6257158593509C, 0x0B8F99DAB1F7ABC5, 0x42564C2F2F4B580E, 0,
    0x8012B28FEF01256A, 0, 0, 0, 0x0B86E552C20EED81),
  0x4B4F627A86D61B26, "geo_ray_sphere: r 2^-839 from 2^220, d_z 2^-1060 of d_x -> the root (_geo_sph_xcert_at)");
assert_eq(_w2W1_sph(0xE7FB187482C234EA, 0x24949027EF7468DB, 0xA4B0473E8D1C8E4C, 0x4370E7A2682EE434, 0x80452DBBEA1CBBC6,
    0x8025C6E433ABC682, 0, 0, 0, 0x24D1CF7AFD85A68A),
  0x6479A52F57C2F16F, "geo_ray_sphere: r 2^-434 from 2^640, d 2^-1077 apart -> the root (_geo_sph_xcert_s)");

# ==================================================================================================
# 3.5.0 wave 2 — capsules: spread exponents, the near-axis route, the band (geo)
# ==================================================================================================
# (Written as tests/w2_W2.tcyr; every global and fn below is prefixed _w2W2_.)

fn _w2W2_ray(ox, oy, oz, dx, dy, dz) {
    var r = alloc(16);
    GeoRay_set_origin(r, hvec3_new(ox, oy, oz));
    GeoRay_set_direction(r, hvec3_new(dx, dy, dz));
    return r;
}
var _w2W2_br = alloc(16);

# ==================================================================================================
test_group("3.5.0 W2: the barrel's c cancelled by one bit, o_perp's rounding carried");
# _geo_barrel_fast's band (|c| under |o_perp|^2 / 2) forms c again with o_perp's rounding (_geo_cap_band_c).
# [measured: scratch W2 first pass, evalfam.py mixed seed 5 row 1253, nearaxis_in seed 7 row 2584, 2026-11-14]
# (mixed seed 5 row 1253: exact 0x3FCBC4BB1F071BE6; 3.4.2 and base 0x3FCBC4BB1F071BF2, 11.66 ulp)
var _w2W2_a_r = _w2W2_ray(0xC01B8AA4C8B54EEE, 0x401FDF769913F1B6, 0xC012B0CF048E88BB, 0xBFE89D301DEB01A8,
  0xC0216165555BECEA, 0x4026439AA77620E8);
var _w2W2_a_c = geo_capsule_new(hvec3_new(0xC01C13D50B1A8ED6, 0x401F89F24BC575F0, 0xC022D2F84EC617F1),
  hvec3_new(0xC01B0B841D809676, 0xBFF6A9F687DCB5C8, 0x401E6F184A605FC8), 0x3FFDAA917A04D641);
assert_eq(geo_ray_capsule_branch(_w2W2_a_r, _w2W2_a_c, _w2W2_br), 0x3FCBC4BB1F071BE7,
  "band, origin 1.27 radii off the axis, barrel hit: 0.66 ulp");
assert_eq(load64(_w2W2_br), GEO_CAP_CYLINDER, "... on the barrel (mixed 1253)");
# (nearaxis_in seed 7 row 2584: exact 0x4054817C5D2148EB; 3.4.2 and base 0x4054817C5D2148F0, 5.19 ulp)
var _w2W2_b_r = _w2W2_ray(0xC0572E7DEDB305E5, 0xC07652C3703A9006, 0xC04E336208877797, 0x3FE26EB929FE4F57,
  0x4001B6E284605EF6, 0x3FDA3FC88CB3887C);
var _w2W2_b_c = geo_capsule_new(hvec3_new(0x3FF8F35A4D933AA8, 0x4005F64C1CA8991C, 0x401000E4ECA8C928),
  hvec3_new(0xC06318C0AD376E36, 0xC0826CF70219A54B, 0xC05A32A8F371A3B8), 0x400079373B67A1A1);
assert_eq(geo_ray_capsule_branch(_w2W2_b_r, _w2W2_b_c, _w2W2_br), 0x4054817C5D2148EB,
  "band, origin 0.86 radii off a long axis inside, barrel exit: 0.19 ulp");
assert_eq(load64(_w2W2_br), GEO_CAP_CYLINDER, "... on the barrel (nearaxis_in 2584)");

# ==================================================================================================
test_group("3.5.0 W2: d_perp from 1/8 to 1/4 of the axis, end - start's rounding carried");
# (_geo_dperp_q, three exact products)
# [measured: scratch W2 first pass, evalfam.py nearaxis_q seed 1 row 2631, mixed seed 5 row 1171, 2026-11-14]
# (nearaxis_q seed 1 row 2631: exact 0x400E824578AF0EB8; 3.4.2 and base 0x400E824578AF0EAF, 8.54 ulp)
var _w2W2_c_r = _w2W2_ray(0x40458E99CACEF37C, 0xC04B2DA850C83CCB, 0x40420F16C3A7673C, 0x3FF5487EAE7894C1,
  0xBFFA356DF00F67DD, 0x3FE337AE60E92D84);
