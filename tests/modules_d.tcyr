include "src/spatial.cyr"
include "src/collision_core.cyr"
include "src/collision_mesh.cyr"
include "src/linalg_ext.cyr"
include "src/linalg_precision.cyr"
include "src/ode.cyr"
include "src/optimize.cyr"

# ~1e-8 — for assertions on transcendental / iterative results where exact
# bit equality is not achievable but 8 significant digits is.
var LOOSE_TOL_M = 0x3E45798EE2308C3A;
# ~1e-15 -- a few ulp of 1.0, for order-1 quantities with a closed form
# (group-inverse round-trips, traceless generators, Euler's identity, cot(pi/3)).
# Replaces a literal f64_from(1), which is a tolerance of 1.0 and admits
# everything in [0, 2]. 2.7.0 measured the floor of its 12 sites at <= 2.3e-16 on
# 6.5.6. Re-measured on 6.6.12 over the 24 sites now, by swapping this constant:
# all pass at 2^-52 + 1 ulp (~2.2e-16) and 3 fail at 2^-53 + 1 ulp, so the floor
# still sits at or below 2^-52.
# [measured: scratch harness, ULP_TOL_M swapped, not reproducible in-tree, 2026-09-30; cycc 6.6.12]
var ULP_TOL_M = 0x3CD203AF9EE75616;
var TOL_1EM14 = 0x3D06849B86A12B9B;  # 1e-14

# ==================================================================================================
# 3.5.0 — geometry: rays, planes, triangles, jets (geo, geo_diff)
# ==================================================================================================
# (Written as tests/v35_L1.tcyr; every global and fn below is prefixed _v35L1_.)

# ================================================================
# Helpers
# ================================================================
# A ray built through the setters (the direction is NOT normalised, as geo_ray_new would) and a
# plane likewise (the normal need not be unit: GeoPlane_set_normal).
fn _v35L1_ray(ox, oy, oz, dx, dy, dz) {
    var r = alloc(16);
    GeoRay_set_origin(r, hvec3_new(ox, oy, oz));
    GeoRay_set_direction(r, hvec3_new(dx, dy, dz));
    return r;
}
fn _v35L1_plane(nx, ny, nz, dist) {
    var p = alloc(16);
    GeoPlane_set_normal(p, hvec3_new(nx, ny, nz));
    GeoPlane_set_distance(p, dist);
    return p;
}
# geo_ray_plane from ten doubles in the order n (3), d0, o (3), d (3).
fn _v35L1_rp(nx, ny, nz, dist, ox, oy, oz, dx, dy, dz) {
    return geo_ray_plane(_v35L1_ray(ox, oy, oz, dx, dy, dz), _v35L1_plane(nx, ny, nz, dist));
}

# ================================================================
test_group("3.5.0 L1: K003 -- the geo tags are enum members, values unchanged");
# ================================================================
# (An assignment to one is a compile error now; a suite cannot assert that, so these pin the values
# every consumer compiled against.)
assert_eq(GEO_FACE_NONE, 0 - 1, "GEO_FACE_NONE = -1");
assert_eq(GEO_FACE_OUT_BYTES, 16, "GEO_FACE_OUT_BYTES = 16");
assert_eq(GEO_CAP_CYLINDER, 0, "GEO_CAP_CYLINDER = 0");
assert_eq(GEO_CAP_START_CAP, 1, "GEO_CAP_START_CAP = 1");
assert_eq(GEO_CAP_END_CAP, 2, "GEO_CAP_END_CAP = 2");
assert_eq(GEO_CAP_SPHERE, 3, "GEO_CAP_SPHERE = 3");
assert_eq(GEO_JET_MISS, 0, "GEO_JET_MISS = 0");
assert_eq(GEO_JET_PLANE, 1, "GEO_JET_PLANE = 1");
assert_eq(GEO_JET_SPHERE, 2, "GEO_JET_SPHERE = 2");
assert_eq(GEO_JET_TRIANGLE, 3, "GEO_JET_TRIANGLE = 3");
assert_eq(GEO_JET_AABB, 4, "GEO_JET_AABB = 4");
assert_eq(GEO_JET_OBB, 5, "GEO_JET_OBB = 5");
assert_eq(GEO_JET_CAPSULE, 6, "GEO_JET_CAPSULE = 6");

# ================================================================
test_group("3.5.0 L1: geo_ray_plane -- n . d and d0 - n . o certified before the quotient");
# ================================================================
# Oracle: t = (d0 - n . o) / (n . d) in Python Fractions, correctly rounded; a miss where n . d is
# exactly 0 or t <= 0. Rays and planes through the setters (n not unit, d not normalised).
# The roadmap repro: exact n . d = -5.55e-17; 3.4.2 gave 438B800000000000, a factor of 2.
assert_eq(_v35L1_rp(F64_ONE, f64_from(3), f64_from(7), F64_HALF, F64_ONE, f64_from(2), f64_from(3),
    0x3FB999999999999A, 0xBFC999999999999A, 0x3FB2492492492492), 0x439B800000000000,
  "geo_ray_plane: n . d cancelling to -5.55e-17 -> the correctly rounded t (3.4.2: half of it)");
# n . d cancels by about 2^-34 of its terms: 3.4.2 was 43209167BB21064C, 2.6e9 ulps off.
assert_eq(_v35L1_rp(0x3FCB191BEACC0040, 0x3FD5FA503634F804, 0x3F8862FC7F6C5A00, 0x3FC56EEB7E70A740,
    0x3FF72849D4323F38, 0x401E95DB691E1C78, 0x401BD7F163A6EE94,
    0xBFE49F15F6057BEE, 0xBFAB0BC6DC290A00, 0x4029F60514CBA4AB), 0x432096EC8BB3D335,
  "geo_ray_plane: a cancelling n . d above DBL_MIN -> the correctly rounded t");
# The origin almost on the plane: d0 - n . o cancels and its rounding flipped the sign (3.4.2: miss).
assert_eq(_v35L1_rp(0x3FDA40C661E6322C, 0xBFE72FABC272F4BE, 0xBFE6383D3F67988C, 0x400000C254BCC8E0,
    0x401E869710BC13B0, 0x4001EC7B6673EDF4, 0xC00A6455C1405CAA,
    0x3FDF2B458D3D8EF4, 0xBFD2181B8F8D0580, 0x3FE2A5B80F46C316), 0x4381AAF8181103DD,
  "geo_ray_plane: a cancelling numerator -> the hit, correctly rounded (3.4.2: the miss)");
# ... and the other way: the exact t is negative (3.4.2: a hit at 43C08454AD83B0EE).
assert_eq(_v35L1_rp(0x3FEC6F39933C3032, 0xBFD81609B6FF49C8, 0x3FEDBA1BA8B8BFB2, 0x4020CCFF3E299F7C,
    0xC01CFAE0F583E1E8, 0xC013855E9E8034BC, 0xC00E462420046AE8,
    0xBFD31F06EC50B858, 0xBFE232CC90900306, 0x3FAC5B78D8198F10), 0,
  "geo_ray_plane: a cancelling sum whose exact t is negative -> the miss (3.4.2: a hit)");
# n . d exactly 0 though its plain sum is -2^-60: (1 + 2^-30)^2 - (1 + 2^-29) - 2^-60 = 0. A parallel
# ray, the miss; 3.4.2 answered 2^60.
assert_eq(_v35L1_rp(0x3FF0000000400000, 0xBFF0000000800000, F64_ONE, f64_neg(F64_ONE), 0, 0, 0,
    0x3FF0000000400000, F64_ONE, 0xBC30000000000000), 0,
  "geo_ray_plane: an exactly parallel ray whose plain n . d is -2^-60 -> the miss (3.4.2: 2^60)");
# Setter-built n and d past 2^512: n0 d0 and n1 d1 overflow, n . d = 2.56e297 is finite. 3.4.2: NaN.
assert_eq(_v35L1_rp(0x6011675CE0126946, 0x6011675CE0126946, 0xBFB30098E5837F40, 0xBFFCD2B291A01050,
    0x3FE8D3EAAEBEA600, 0xC022E86D01B41FC7, 0xC023D756F8DA8734,
    0x6028D0DD3BAAF0FA, 0xE028D0DD3BAAE9C7, 0x3FDFE04A38ED0FFC), 0x228349674DF5F3F2,
  "geo_ray_plane: n . d of products past DBL_MAX, finite in sum -> the t (3.4.2: NaN)");
# A subnormal numerator over a normal n . d: 3.4.2 kept a few bits (0002A7FFDBA812A3).
assert_eq(_v35L1_rp(0xBFE7D3D409E94866, 0x3FE2159AF140978C, 0x3FDE332661158574, 0x000000326CFEE86F,
    0x000068C465D01981, 0x800000000000001B, 0x800000BB6D74BF34,
    0x3FE95808DCCE63F0, 0x3FE7CA75CA1520DC, 0x3FE3554897890DBE), 0x0002A7FFDBA812A8,
  "geo_ray_plane: a subnormal numerator -> the correctly rounded subnormal t");
# The same overflowing n . d with an origin at -Inf: d0 - n . o is +Inf, and n . d's exact sign is +, so
# +Inf (through 3.4.2 the overflowed n . d made it NaN).
assert_eq(_v35L1_rp(0x6011675CE0126946, 0x6011675CE0126946, 0xBFB30098E5837F40, 0xBFFCD2B291A01050,
    0xFFF0000000000000, 0, 0, 0x6028D0DD3BAAF0FA, 0xE028D0DD3BAAE9C7, 0x3FDFE04A38ED0FFC), 0x7FF0000000000000,
  "geo_ray_plane: an infinite origin over an overflowing finite n . d -> +Inf, not NaN");
# d0 - n . o cancels to 1.2e-14 of its terms while n . d does not: 3.4.2 was 3.1e13 ulps off.
assert_eq(_v35L1_rp(0x3F91BB7CBCEBA040, 0x3FDCEF4828A25DA8, 0xBFC2D838B380CD68, 0xC00E1AFA548F2FC7,
    0x40231AB3BD346498, 0xC01A606D00818E46, 0x4019BD159F667ACC,
    0x3FD3AA03E1EF1B78, 0xBFEE7B10C87835F6, 0x3FC8EAE6BA393B68), 0x3D4E1F3356FCA6A0,
  "geo_ray_plane: only the numerator cancels -> the correctly rounded t (3.4.2: 3.1e13 ulps off)");
# n . d cancels to 1.5e-5 of its terms, past 2^-16 only with its x product counted: 3.4.2 was 12,300 ulps off.
# [measured: scratch plane_kill.py / plane_sweep.py fixtures, Python Fraction oracle, 2026-11-14]
assert_eq(_v35L1_rp(0x3FDE333A0C591094, 0x3FE0F2B153141B44, 0xBFEE2980FABD6564, 0xC02146DA4330A6E8,
    0xC015798E02CA2516, 0xC018EF520D5F5CF2, 0x401F4E3F8116F0E4,
    0x3FDBEEE0D91538A4, 0xBFE6B72D15838114, 0xBFC716A24AFB79EE), 0x411901A3CBD4D442,
  "geo_ray_plane: n . d at 1.5e-5 of its terms -> the correctly rounded t (3.4.2: 12,300 ulps off)");
# d0 and n . o cancel (the products do not): 3.4.2 was 30,700 ulps off; the sums' t is 0.96 ulp from exact.
# [measured: scratch plane_kill.py / plane_sweep.py fixtures, Python Fraction oracle, 2026-11-14]
assert_eq(_v35L1_rp(0xBFE467D880A1FD0E, 0xBFE5ABDD5B1158B0, 0x3FBCDC94B50F4860, 0xC005151D5DA2641D,
    0x40005012AF046574, 0x3FE5E51AC2FDC480, 0xC01EEC6B3BD2CAEA,
    0x3FD19A193BF9E938, 0x3FE67D28BAE1E338, 0x3FEAF9408015B9FA), 0x3F1FF02ED5736C20,
  "geo_ray_plane: d0 against n . o cancelling -> the sums' t (3.4.2: 30,700 ulps off)");
# Certified rays keep 3.4.2's bits: the plain quotient with each dot product in hvec3_dot's order
# ((x x' + y y') + z z'), here 1.66 and 0.27 ulps from the exact t.
# [measured: scratch plane_kill.py / plane_sweep.py fixtures, Python Fraction oracle, 2026-11-14]
assert_eq(_v35L1_rp(0x3FE4BF3543EA14AA, 0xBFDBC650BD2E6458, 0xBFE03102FE83E000, 0x4020FA8E1E4B4780,
    0x401B15C453360924, 0x400FDD2275842814, 0xBFF057D3A9F3F540,
    0x3FEA93FBC0482DFA, 0xBFE0765B212CEA18, 0x3FE86D1B0D5F8918), 0x402C492C13A7BA83,
  "geo_ray_plane: an ordinary ray, 3.4.2's bits (n . d in hvec3_dot's order)");
assert_eq(_v35L1_rp(0x3FD6189C60E1A1FC, 0xBFEB2A9FB7FD96AE, 0xBFC7F84D94215280, 0x4012CFB4A5963C38,
    0xC01CAABB207B187E, 0xC01AF2E68A83AB9D, 0x40134EF5A0CF8B38,
    0x3FE331CB68F8FF5A, 0x3FACFB9119572F00, 0x3FD8A8714F5D2F4C), 0x403B2E08C0EDD169,
  "geo_ray_plane: an ordinary ray, 3.4.2's bits (n . o in hvec3_dot's order)");
# Exactly parallel by zero factors (n = (0, 1, 0), d = (1, 0, 0)), from y = -5: the miss, before any quotient
# (the sums' path would divide d0 - n . o = 5 by that zero).
assert_eq(_v35L1_rp(0, F64_ONE, 0, 0, 0, f64_from(-5), 0, F64_ONE, 0, 0), 0,
  "geo_ray_plane: n . d = 0 by zero factors in every pair -> the miss");
# Ordinary rays keep the plain quotient: 5 / 2, and the miss behind.
assert_eq(_v35L1_rp(0, 0, F64_ONE, 0, 0, 0, f64_from(5), 0, 0, f64_neg(F64_TWO)), 0x4004000000000000,
  "geo_ray_plane: an ordinary hit, t = 2.5");
assert_eq(_v35L1_rp(0, 0, F64_ONE, 0, 0, 0, f64_from(5), 0, 0, F64_TWO), 0,
  "geo_ray_plane: an ordinary ray moving away -> the miss");
# NaN in, NaN out (a NaN direction keeps the plain quotient).
assert_eq(_v35L1_rp(F64_ONE, 0, 0, F64_ONE, 0, 0, 0, 0x7FF8000000000000, 0, 0), 0x7FF8000000000000,
  "geo_ray_plane: a NaN direction -> NaN");
assert_eq(_v35L1_rp(F64_ONE, 0, 0, F64_ONE, 0x7FF8000000000000, 0, 0, F64_ONE, 0, 0), 0x7FF8000000000000,
  "geo_ray_plane: a NaN origin -> NaN");
# (Review of the first 3.5.0 pass.) A NaN origin or distance is NaN on every path, an exactly parallel ray's
# included: the first pass answered the parallel test's miss before reading o or d0. n . d below is exactly
# 0 though its plain sum is -2^-60 (3.4.2: NaN, by the plain quotient; first pass: 0).
assert_eq(_v35L1_rp(0x3FF0000000400000, 0xBFF0000000800000, F64_ONE, f64_neg(F64_ONE), 0x7FF8000000000000, 0, 0,
    0x3FF0000000400000, F64_ONE, 0xBC30000000000000), 0x7FF8000000000000,
  "geo_ray_plane: a NaN origin, n . d exactly 0 by cancellation -> NaN (first 3.5.0 pass: 0)");
assert_eq(_v35L1_rp(0x3FF0000000400000, 0xBFF0000000800000, F64_ONE, 0x7FF8000000000000, 0, 0, 0,
    0x3FF0000000400000, F64_ONE, 0xBC30000000000000), 0x7FF8000000000000,
  "geo_ray_plane: a NaN distance, n . d exactly 0 by cancellation -> NaN (first 3.5.0 pass: 0)");
# n . d = 1e600 - 1e600, exactly 0 with its plain sum Inf - Inf, and a NaN origin.
assert_eq(_v35L1_rp(0x7E37E43C8800759C, 0x7E37E43C8800759C, 0, F64_ONE, 0x7FF8000000000000, 0, 0,
    0x7E37E43C8800759C, 0xFE37E43C8800759C, 0), 0x7FF8000000000000,
  "geo_ray_plane: a NaN origin, n . d = 1e600 - 1e600 = 0 -> NaN (first 3.5.0 pass: 0)");
# Exactly parallel by zero factors (n = (0, 0, 1), d = (1, 0, 0)): a NaN origin is NaN (old -> new, 3.5.0:
# 3.4.2 answered this path's miss 0 whatever o was); an infinite one is still the miss.
assert_eq(_v35L1_rp(0, 0, F64_ONE, F64_ONE, 0x7FF8000000000000, 0, 0, F64_ONE, 0, 0), 0x7FF8000000000000,
  "geo_ray_plane: a NaN origin, parallel by zero factors -> NaN (3.4.2: the miss 0)");
assert_eq(_v35L1_rp(0, 0, F64_ONE, F64_ONE, 0x7FF0000000000000, 0, 0, F64_ONE, 0, 0), 0,
  "geo_ray_plane: an infinite origin, parallel by zero factors -> the miss");
# An infinite origin with a finite n . d whose plain sum overflows (1e300 * 1e300): d0 - n . o = +-Inf, and
# the answer is its sign against n . d's exact one (3.4.2: Inf / Inf, NaN). n_x = 0 against o_x = Inf
# makes d0 - n . o itself NaN: NaN.
assert_eq(_v35L1_rp(0x7E37E43C8800759C, 0, 0, 0, 0xFFF0000000000000, 0, 0, 0x7E37E43C8800759C, 0, 0),
  0x7FF0000000000000, "geo_ray_plane: o_x = -Inf toward x = 0, n . d = 1e600 -> +Inf (3.4.2: NaN)");
assert_eq(_v35L1_rp(0x7E37E43C8800759C, 0, 0, 0, 0x7FF0000000000000, 0, 0, 0x7E37E43C8800759C, 0, 0), 0,
  "geo_ray_plane: o_x = +Inf moving away, n . d = 1e600 -> the miss (3.4.2: NaN)");
assert_eq(f64_eq(_v35L1_rp(0, F64_ONE, F64_ONE, F64_ONE, 0x7FF0000000000000, 0, 0, F64_ONE, F64_ONE, 0), 0), 0,
  "geo_ray_plane: o_x = +Inf against n_x = 0 -> NaN, not the miss");
# A non-finite d keeps 3.4.2's quotient bit for bit: n . o of -0 products is +0 in hvec3_dot (its sign
# here, d0 = -0: -0 - +0 = -0 over +Inf, -0), where the products summed in order give -0.
assert_eq(_v35L1_rp(F64_ONE, F64_ONE, F64_ONE, 0x8000000000000000, 0x8000000000000000, 0x8000000000000000,
    0x8000000000000000, 0x7FF0000000000000, 0, 0), 0x8000000000000000,
  "geo_ray_plane: an infinite d -> 3.4.2's plain quotient, its -0 included");
# A miss is +0: -0 only for an origin on the plane with n . d < 0 (the doc). Opposite exact signs whose
# quotient underflows: through 3.4.2 -0 from the plain quotient (d0 - n . o = -2^-990 over 2^1000), and in
# the sums' path (the exact t below -2^-1075) -0 in the first 3.5.0 pass.
assert_eq(_v35L1_rp(F64_ONE, 0, 0, 0, 0x0210000000000000, 0, 0, 0x7E70000000000000, 0, 0), 0,
  "geo_ray_plane: a certified t < 0 that underflows -> +0 (3.4.2: -0)");
assert_eq(_v35L1_rp(0x7E37E43C8800759C, 0xBFE0000000000000, 0xBFE0000000000000, 0, 0x8000000000000000,
    0x8000000000000000, 0x8000000000000001, F64_ONE, 0, F64_TWO), 0,
  "geo_ray_plane: the sums' t < 0 that underflows -> +0 (first 3.5.0 pass: -0)");
# The certified quotient is answered only in [2^-1021, 2^1023): within 2^-33 it can stand for an exact t
# past DBL_MAX or below DBL_MIN, which the correctly rounded sums answer. d0 - n . o cancels by 2^-38.6
# below (2^938 + 2^885 - 2^832 rounds to 2^938); exact t 0x7FEFFFFFFFFFC000 and 0x7FE7FFFFFFFFC000 (both
# Fractions), where the certified quotient read +Inf and 0x7FE8000000000000.
assert_eq(_v35L1_rp(F64_ONE, F64_ONE, 0, 0x7A90004000000000, 0x7A90000000000000, 0x773FFFFFFFFFFFFF, 0,
    0x39B0000000000000, 0, 0), 0x7FEFFFFFFFFFC000,
  "geo_ray_plane: an exact t below DBL_MAX whose certified quotient overflows -> the t (3.4.2: +Inf)");
assert_eq(_v35L1_rp(F64_ONE, F64_ONE, 0, 0x7A90003000000000, 0x7A90000000000000, 0x773FFFFFFFFFFFFF, 0,
    0x39B0000000000000, 0, 0), 0x7FE7FFFFFFFFC000,
  "geo_ray_plane: a certified quotient in the top binade -> the sums' t (3.4.2: 0x7FE8000000000000)");
# Subnormal and least-normal exact t (Fractions) whose certified quotients were 5.0 and 4.2 ulps off.
# [measured: scratch fix2.py, Python Fraction oracle, 3.4.2 base vs this tree, 2026-11-14]
assert_eq(_v35L1_rp(0x3FEE3C3A60747678, 0xBFE1EB81439ED178, 0xC0008FF3ABCEA5E0, 0x3EBF124596A9A554,
    0x3ECA9B38F20A2922, 0xBEC0DA1921E0CA2C, 0x3EB5762E3440352C,
    0xFE7E5856CFC461FF, 0xFE8035D700F64BE6, 0xFE72BFC7FF01A1BF), 0x000E5CD0EF0BF321,
  "geo_ray_plane: a subnormal t -> correctly rounded (3.4.2: 5 ulps off)");
assert_eq(_v35L1_rp(0x3FEB52A43AAD00D1, 0x3FF5AF84E7A314CD, 0x3FEB248918A1AFA2, 0xBEDA19AB93A1C874,
    0xBEC5DBE440C0B2F8, 0xBEC73EC28C17EC9E, 0xBEA9FABA83E90D56,
    0xFE678F845F68CA64, 0x7E6419521FF34040, 0x7E6D84A1D2CEFFA2), 0x001BAEBF2871658A,
  "geo_ray_plane: a t in [2^-1022, 2^-1021) -> the sums' t (3.4.2: 4.2 ulps off)");

# ================================================================
test_group("3.5.0 L1: geo_jet_plane -- 1 / (n . d) from the n . d the primal decided with");
# ================================================================
# Review of the first 3.5.0 pass: the jet divided by the plain hvec3_dot(n, d) while geo_ray_plane certifies
# n . d, so on a cancelling ray the repaired primal hit and the jet carried the plain sum's sign. Oracle:
# 1 / (n . d) and -n / (n . d) in Python Fractions, correctly rounded. Exact n . d = +1.089e-17 here; the
# first pass's jet read dt/d(distance) = -1.80e16 (3.4.2: the primal's miss, the miss jet).
# [measured: scratch fix.py / jet_sweep.py, Python Fraction oracle, 3.4.2 base vs this tree, 2026-11-14]
fn _v35L1_jp(nx, ny, nz, dist, ox, oy, oz, dx, dy, dz) {
    return geo_jet_plane(_v35L1_ray(ox, oy, oz, dx, dy, dz), _v35L1_plane(nx, ny, nz, dist));
}
# Component k of a jet's dt/dn, or the marker 7FF80000000000DD where geo_jet_plane_dnormal answers 0 (any
# jet but a plane's hit), so that a wrong kind fails an assertion instead of faulting the suite.
fn _v35L1_jdn(j, k) {
    var v = geo_jet_plane_dnormal(j);
    if (v == 0) { return 0x7FF8_0000_0000_00DD; }
    return load64(v + k * 8);
}
var _v35L1_jw = _v35L1_jp(0x3FDD83C97DF1A55C, 0xBFE1570B04F07BEE, 0x3F91F7CADC0D3C40, 0x4022D7DF93BD86E0,
  0xBFE96D9FD975BFA0, 0x40227B05762B7044, 0x3FD2D754B6C22AC0, 0xBFDB5BB1717D824C, 0xBFEF60B00E012920,
  0xC0330BD68BB60842);
assert_eq(geo_jet_kind(_v35L1_jw), GEO_JET_PLANE, "geo_jet_plane: n . d = +1.09e-17, a hit jet");
assert_eq(geo_jet_t(_v35L1_jw), 0x43B2D70F4677554E, "geo_jet_plane: ... t is the primal's (exact ...554F, 0.77 ulp)");
assert_eq(geo_jet_plane_ddistance(_v35L1_jw), 0x437461A4ED0EF06A,
  "geo_jet_plane: ... dt/d(distance) = 1 / (n . d), correctly rounded (first 3.5.0 pass: -1.80e16)");
assert_eq(HVec3_x(geo_jet_dorigin(_v35L1_jw)), 0xC362CC6D878B4500,
  "geo_jet_plane: ... dt/do.x = -n.x / (n . d), correctly rounded");
assert_eq(HVec3_y(geo_jet_dorigin(_v35L1_jw)), 0x436616A036150369,
  "geo_jet_plane: ... dt/do.y = -n.y / (n . d), correctly rounded");
# The roadmap's ray: exact n . d = -5.55e-17 = -2^-54 (Fractions), whose plain sum is -2^-53. 3.4.2 and the
# first pass: dt/d(distance) -2^53, half of 1 / (n . d) = -2^54.
var _v35L1_jr2 = _v35L1_jp(F64_ONE, f64_from(3), f64_from(7), F64_HALF, F64_ONE, f64_from(2), f64_from(3),
  0x3FB999999999999A, 0xBFC999999999999A, 0x3FB2492492492492);
assert_eq(geo_jet_plane_ddistance(_v35L1_jr2), 0xC350000000000000,
  "geo_jet_plane: the roadmap ray -> dt/d(distance) = -2^54, exact (3.4.2: -2^53)");
assert_eq(HVec3_z(geo_jet_dorigin(_v35L1_jr2)), 0x437C000000000000,
  "geo_jet_plane: the roadmap ray -> dt/do.z = 7 2^54, exact (3.4.2: 7 2^53)");
# Certified rays keep 3.4.2's bits: plane z = 0 from (0, 0, 5) along (0.6, 0, -0.8): 1 / -0.8 rounded, -1.25.
var _v35L1_jo = _v35L1_jp(0, 0, F64_ONE, 0, 0, 0, f64_from(5), 0x3FE3333333333333, 0, 0xBFE999999999999A);
assert_eq(geo_jet_plane_ddistance(_v35L1_jo), 0xBFF4000000000000,
  "geo_jet_plane: an ordinary ray -> 1 / den, 3.4.2's bits");

# |n . d| past 2^1022: 1 / (n . d) is subnormal or 0, and the partials are formed at unit size
# (_geo_jet_plane_far). n = (2^600, 0, 0), d = (2^500, 0, 0) from (-2^500, 0, 0) to x = 0: t = 1 and
# dt/do.x = -2^-500, where 1 / (n . d) = 2^-1100 made it -0 in a hit jet (first 3.5.0 pass; 3.4.2's primal
# read NaN, its n . o overflowing, and the jet was the miss).
var _v35L1_jf = _v35L1_jp(0x6570000000000000, 0, 0, 0, 0xDF30000000000000, 0, 0, 0x5F30000000000000, 0, 0);
assert_eq(geo_jet_kind(_v35L1_jf), GEO_JET_PLANE, "geo_jet_plane: n . d = 2^1100 -> a hit jet");
assert_eq(geo_jet_t(_v35L1_jf), F64_ONE, "geo_jet_plane: ... t = 1");
assert_eq(HVec3_x(geo_jet_dorigin(_v35L1_jf)), 0xA0B0000000000000,
  "geo_jet_plane: ... dt/do.x = -2^-500, exact (first 3.5.0 pass: -0)");
# The same ray reversed (d = (-2^500, 0, 0) from (2^500, 0, 0)): n . d = -2^1100, and dt/d(distance) =
# -2^-1100 rounds to -0, its sign the far form's (the reciprocal read 0 there).
var _v35L1_jf2 = _v35L1_jp(0x6570000000000000, 0, 0, 0, 0x5F30000000000000, 0, 0, 0xDF30000000000000, 0, 0);
assert_eq(geo_jet_t(_v35L1_jf2), F64_ONE, "geo_jet_plane: n . d = -2^1100 -> t = 1");
assert_eq(geo_jet_plane_ddistance(_v35L1_jf2), 0x8000000000000000,
  "geo_jet_plane: ... dt/d(distance) = -2^-1100, -0 (its sign kept)");
assert_eq(HVec3_x(geo_jet_dorigin(_v35L1_jf2)), 0x20B0000000000000, "geo_jet_plane: ... dt/do.x = +2^-500");
# n = (2^600, 2^600, 0), d = (2^500, -2^499, 0): n . d = 2^1099, its plain sum Inf - Inf. From (-2^500, 0,
# 2^30) to the plane n . x = 0: t = 2, p = (2^500, -2^500, 2^30); every partial a power of two (Fractions).
var _v35L1_jg = _v35L1_jp(0x6570000000000000, 0x6570000000000000, 0, 0, 0xDF30000000000000, 0, 0x41D0000000000000,
  0x5F30000000000000, 0xDF20000000000000, 0);
assert_eq(geo_jet_t(_v35L1_jg), F64_TWO, "geo_jet_plane: n . d = 2^1099 from Inf - Inf -> a hit jet, t = 2");
assert_eq(HVec3_y(geo_jet_dorigin(_v35L1_jg)), 0xA0C0000000000000, "geo_jet_plane: ... dt/do.y = -2^-499");
assert_eq(HVec3_x(geo_jet_ddirection(_v35L1_jg)), 0xA0D0000000000000, "geo_jet_plane: ... dt/dd.x = -2^-498");
assert_eq(_v35L1_jdn(_v35L1_jg, 0), 0x9A80000000000000, "geo_jet_plane: ... dt/dn.x = -2^-599");
assert_eq(_v35L1_jdn(_v35L1_jg, 2), 0x8000000000000020,
  "geo_jet_plane: ... dt/dn.z = -2^-1069, subnormal, exact");
assert_eq(geo_jet_plane_ddistance(_v35L1_jg), 0, "geo_jet_plane: ... dt/d(distance) = 2^-1099 rounds to +0");
# n . d = 2^1023.99, 1 / (n . d) subnormal: dt/do.x correctly rounded, where n times the subnormal
# reciprocal was 4.15 ulps off (3.4.2 and the first pass alike).
# [measured: scratch far fixture search, Python Fraction oracle, 3.4.2 base vs this tree, 2026-11-14]
var _v35L1_jh = _v35L1_jp(0x65BDF73E59B5C468, 0, 0, 0, 0xD2B5653CB44817F2, 0, 0, 0x5A20F799559D0D59, 0, 0);
assert_eq(HVec3_x(geo_jet_dorigin(_v35L1_jh)), 0xA5BE2D07A9A4735A,
  "geo_jet_plane: 1 / (n . d) subnormal -> dt/do.x correctly rounded (3.4.2: 4.15 ulps off)");
assert_eq(geo_jet_plane_ddistance(_v35L1_jh), 0x0004072E0100EA15,
  "geo_jet_plane: ... dt/d(distance), the subnormal 1 / (n . d) itself, correctly rounded (3.4.2's bits)");

# ================================================================
test_group("3.5.0 L1: geo_triangle_unit_normal_checked -- a degenerate triangle is an Err");
# ================================================================
# An Allocator that refuses every request, for the Err(HSB_ERR_ALLOC) exits (hisab_alloc_scope).
fn _v35L1_no_alloc(st, n) { return 0; }
fn _v35L1_no_realloc(st, p, a, b) { return 0; }
fn _v35L1_no_reset(st) { return 0; }
var _v35L1_refuser = allocator_new(&_v35L1_no_alloc, &_v35L1_no_realloc, &_alloc_free_noop, &_v35L1_no_reset, 0);
# The Ok payload's three words, or the Err code in word 0 and a NaN marker in words 1, 2.
var _v35L1_o3: i64[3];
fn _v35L1_un(tri) {
    var t, v = geo_triangle_unit_normal_checked(tri);
    if (is_err_result(t) == 1) {
        store64(&_v35L1_o3, v);
        store64(&_v35L1_o3 + 8, 0x7FF4000000000001);
        store64(&_v35L1_o3 + 16, 0x7FF4000000000001);
        return 1;
    }
    store64(&_v35L1_o3, HVec3_x(v));
    store64(&_v35L1_o3 + 8, HVec3_y(v));
    store64(&_v35L1_o3 + 16, HVec3_z(v));
    return 0;
}
fn _v35L1_tri(ax, ay, az, bx, by, bz, cx, cy, cz) {
    return geo_triangle_new(hvec3_new(ax, ay, az), hvec3_new(bx, by, bz), hvec3_new(cx, cy, cz));
}
# A right triangle: Ok((0, 0, 1)).
assert_eq(_v35L1_un(_v35L1_tri(0, 0, 0, F64_ONE, 0, 0, 0, F64_ONE, 0)), 0, "unit_normal_checked: right triangle is Ok");
assert_eq(load64(&_v35L1_o3 + 16), F64_ONE, "unit_normal_checked: right triangle -> z = 1");
assert_eq(load64(&_v35L1_o3), 0, "unit_normal_checked: right triangle -> x = +0");
# (1, 0, 0) x (1, 1, 1) = (0, -1, 1): -1 / RN(sqrt 2) and its negation, geo_triangle_unit_normal's bits.
assert_eq(_v35L1_un(_v35L1_tri(0, 0, 0, F64_ONE, 0, 0, F64_ONE, F64_ONE, F64_ONE)), 0, "unit_normal_checked: Ok");
assert_eq(load64(&_v35L1_o3 + 8), 0xBFE6A09E667F3BCC, "unit_normal_checked: y = -1 / RN(sqrt 2)");
assert_eq(load64(&_v35L1_o3 + 16), 0x3FE6A09E667F3BCC, "unit_normal_checked: z = 1 / RN(sqrt 2)");
var _v35L1_ut = _v35L1_tri(0, 0, 0, F64_ONE, 0, 0, F64_ONE, F64_ONE, F64_ONE);
assert_eq(HVec3_y(geo_triangle_unit_normal(_v35L1_ut)), 0xBFE6A09E667F3BCC,
  "unit_normal: the unchecked form's bits are the checked form's");
# Legs of 2^-1074: the certified path declines (an edge below 2^-400) and the exact sum answers.
assert_eq(_v35L1_un(_v35L1_tri(0, 0, 0, 1, 0, 0, 0, 1, 0)), 0, "unit_normal_checked: legs 2^-1074 are Ok");
assert_eq(load64(&_v35L1_o3 + 16), F64_ONE, "unit_normal_checked: legs 2^-1074 -> (0, 0, 1)");
# Colinear and coincident vertices: the cross product is exactly zero.
assert_eq(_v35L1_un(_v35L1_tri(0, 0, 0, F64_ONE, F64_ONE, F64_ONE, F64_TWO, F64_TWO, F64_TWO)), 1,
  "unit_normal_checked: colinear -> Err");
assert_eq(load64(&_v35L1_o3), HSB_ERR_DEGENERATE, "unit_normal_checked: colinear -> HSB_ERR_DEGENERATE");
assert_eq(_v35L1_un(_v35L1_tri(F64_ONE, 0, 0, F64_ONE, 0, 0, F64_ONE, 0, 0)), 1,
  "unit_normal_checked: one point -> Err");
assert_eq(load64(&_v35L1_o3), HSB_ERR_DEGENERATE, "unit_normal_checked: one point -> HSB_ERR_DEGENERATE");
# The unchecked form keeps its documented (0, 1, 0) there.
assert_eq(HVec3_y(geo_triangle_unit_normal(_v35L1_tri(0, 0, 0, F64_ONE, F64_ONE, F64_ONE, F64_TWO, F64_TWO,
        F64_TWO))), F64_ONE, "unit_normal: colinear still answers (0, 1, 0), unchanged");
# Non-finite vertices and 0 handles: HSB_ERR_INVALID_INPUT.
assert_eq(_v35L1_un(_v35L1_tri(0, 0, 0, 0x7FF8000000000000, 0, 0, 0, F64_ONE, 0)), 1,
  "unit_normal_checked: NaN -> Err");
assert_eq(load64(&_v35L1_o3), HSB_ERR_INVALID_INPUT, "unit_normal_checked: NaN vertex -> HSB_ERR_INVALID_INPUT");
assert_eq(_v35L1_un(_v35L1_tri(0, 0, 0, F64_ONE, 0, 0, 0, 0x7FF0000000000000, 0)), 1,
  "unit_normal_checked: Inf -> Err");
assert_eq(load64(&_v35L1_o3), HSB_ERR_INVALID_INPUT, "unit_normal_checked: infinite vertex -> HSB_ERR_INVALID_INPUT");
assert_eq(_v35L1_un(0), 1, "unit_normal_checked: a 0 triangle -> Err");
assert_eq(load64(&_v35L1_o3), HSB_ERR_INVALID_INPUT, "unit_normal_checked: a 0 triangle -> HSB_ERR_INVALID_INPUT");
assert_eq(_v35L1_un(geo_triangle_new(hvec3_zero(), 0, hvec3_one())), 1, "unit_normal_checked: a 0 vertex -> Err");
assert_eq(load64(&_v35L1_o3), HSB_ERR_INVALID_INPUT, "unit_normal_checked: a 0 vertex -> HSB_ERR_INVALID_INPUT");
# A refused result allocation.
var _v35L1_rt = _v35L1_tri(0, 0, 0, F64_ONE, 0, 0, 0, F64_ONE, 0);
var _v35L1_pv = hisab_alloc_scope(_v35L1_refuser);
var _v35L1_rr = _v35L1_un(_v35L1_rt);
hisab_alloc_scope(_v35L1_pv);
assert_eq(_v35L1_rr, 1, "unit_normal_checked: a refused allocation -> Err");
assert_eq(load64(&_v35L1_o3), HSB_ERR_ALLOC, "unit_normal_checked: a refused allocation -> HSB_ERR_ALLOC");

# ================================================================
test_group("3.5.0 L1: geo_segment_direction_checked -- a zero segment is an Err");
# ================================================================
fn _v35L1_sd(sx, sy, sz, ex, ey, ez) {
    var t, v = geo_segment_direction_checked(geo_segment_new(hvec3_new(sx, sy, sz), hvec3_new(ex, ey, ez)));
    if (is_err_result(t) == 1) {
        store64(&_v35L1_o3, v);
        store64(&_v35L1_o3 + 8, 0x7FF4000000000001);
        store64(&_v35L1_o3 + 16, 0x7FF4000000000001);
        return 1;
    }
    store64(&_v35L1_o3, HVec3_x(v));
    store64(&_v35L1_o3 + 8, HVec3_y(v));
    store64(&_v35L1_o3 + 16, HVec3_z(v));
    return 0;
}
# (3, 4, 0): scaled by 2^-2 to (0.75, 1, 0), length 1.25 exactly, times RN(0.8).
assert_eq(_v35L1_sd(0, 0, 0, f64_from(3), f64_from(4), 0), 0, "segment_direction_checked: (3, 4, 0) is Ok");
assert_eq(load64(&_v35L1_o3), 0x3FE3333333333334, "segment_direction_checked: x = 0.75 RN(0.8)");
assert_eq(load64(&_v35L1_o3 + 8), 0x3FE999999999999A, "segment_direction_checked: y = RN(0.8)");
# Ends DBL_MAX apart on a diagonal: end - start overflows and is formed from halved ends.
assert_eq(_v35L1_sd(0xFFEFFFFFFFFFFFFF, 0xFFEFFFFFFFFFFFFF, 0, 0x7FEFFFFFFFFFFFFF, 0x7FEFFFFFFFFFFFFF, 0), 0,
  "segment_direction_checked: ends 2 DBL_MAX apart are Ok");
assert_eq(load64(&_v35L1_o3), 0x3FE6A09E667F3BCC,
  "segment_direction_checked: overflowing diagonal -> x = 1 / RN(sqrt 2)");
assert_eq(load64(&_v35L1_o3 + 8), 0x3FE6A09E667F3BCC, "segment_direction_checked: overflowing diagonal -> y");
# The shortest segment there is: Ok((1, 0, 0)), not degenerate.
assert_eq(_v35L1_sd(0, 0, 0, 1, 0, 0), 0, "segment_direction_checked: 2^-1074 long is Ok");
assert_eq(load64(&_v35L1_o3), F64_ONE, "segment_direction_checked: 2^-1074 long -> (1, 0, 0)");
assert_eq(_v35L1_sd(F64_ONE, F64_TWO, 0, F64_ONE, F64_TWO, 0), 1, "segment_direction_checked: start = end -> Err");
assert_eq(load64(&_v35L1_o3), HSB_ERR_DEGENERATE, "segment_direction_checked: start = end -> HSB_ERR_DEGENERATE");
assert_eq(HVec3_x(geo_segment_direction(geo_segment_new(hvec3_one(), hvec3_one()))), F64_ONE,
  "segment_direction: a zero segment still answers (1, 0, 0), unchanged");
assert_eq(_v35L1_sd(0, 0, 0, 0x7FF8000000000000, 0, 0), 1, "segment_direction_checked: NaN end -> Err");
assert_eq(load64(&_v35L1_o3), HSB_ERR_INVALID_INPUT, "segment_direction_checked: NaN end -> HSB_ERR_INVALID_INPUT");
assert_eq(_v35L1_sd(0xFFF0000000000000, 0, 0, 0, 0, 0), 1, "segment_direction_checked: -Inf start -> Err");
assert_eq(load64(&_v35L1_o3), HSB_ERR_INVALID_INPUT, "segment_direction_checked: -Inf start -> HSB_ERR_INVALID_INPUT");
var _v35L1_st, _v35L1_sv = geo_segment_direction_checked(0);
assert_eq(_v35L1_sv, HSB_ERR_INVALID_INPUT, "segment_direction_checked: a 0 segment -> HSB_ERR_INVALID_INPUT");
assert_eq(is_err_result(_v35L1_st), 1, "segment_direction_checked: a 0 segment -> Err");
var _v35L1_s0t, _v35L1_s0v = geo_segment_direction_checked(geo_segment_new(hvec3_zero(), 0));
assert_eq(_v35L1_s0v, HSB_ERR_INVALID_INPUT, "segment_direction_checked: a 0 end -> HSB_ERR_INVALID_INPUT");
var _v35L1_sg = geo_segment_new(hvec3_zero(), hvec3_one());
_v35L1_pv = hisab_alloc_scope(_v35L1_refuser);
var _v35L1_sat, _v35L1_sav = geo_segment_direction_checked(_v35L1_sg);
hisab_alloc_scope(_v35L1_pv);
assert_eq(_v35L1_sav, HSB_ERR_ALLOC, "segment_direction_checked: a refused allocation -> HSB_ERR_ALLOC");

# ================================================================
test_group("3.5.0 L1: the scalar jet accessors' _checked forms refuse a kind mismatch");
# ================================================================
# Each hit below has t = 5 - r with r the radius or 5 - d0 the plane's distance, so the partial is
# exactly -1: an origin 5 from the centre (or the plane) along a unit axis.
var _v35L1_jsph = geo_jet_sphere(_v35L1_ray(0, 0, f64_from(-5), 0, 0, F64_ONE), geo_sphere_new(hvec3_zero(), F64_ONE));
var _v35L1_jpl = geo_jet_plane(_v35L1_ray(0, 0, f64_from(5), 0, 0, f64_neg(F64_ONE)),
  _v35L1_plane(0, 0, F64_ONE, 0));
var _v35L1_jcap = geo_jet_capsule(_v35L1_ray(f64_from(-5), 0, 0, F64_ONE, 0, 0),
  geo_capsule_new(hvec3_new(0, f64_neg(F64_ONE), 0), hvec3_new(0, F64_ONE, 0), F64_ONE));
var _v35L1_jmiss = geo_jet_sphere(_v35L1_ray(0, f64_from(9), f64_from(-5), 0, 0, F64_ONE),
  geo_sphere_new(hvec3_zero(), F64_ONE));
fn _v35L1_jr(k, j) {
    if (k == 0) {
        var t0, v0 = geo_jet_sphere_dradius_checked(j);
        if (is_err_result(t0) == 1) { return 0x7FF4000000000000 | (0 - v0); }
        return v0;
    }
    if (k == 1) {
        var t1, v1 = geo_jet_plane_ddistance_checked(j);
        if (is_err_result(t1) == 1) { return 0x7FF4000000000000 | (0 - v1); }
        return v1;
    }
    var t2, v2 = geo_jet_capsule_dradius_checked(j);
    if (is_err_result(t2) == 1) { return 0x7FF4000000000000 | (0 - v2); }
    return v2;
}
# (An Err reads as the signalling NaN 7FF4... with the negated code in its low bits: 10 = INVALID_INPUT.)
assert_eq(_v35L1_jr(0, _v35L1_jsph), 0xBFF0000000000000, "geo_jet_sphere_dradius_checked: Ok(-1) on a sphere jet");
assert_eq(_v35L1_jr(1, _v35L1_jpl), 0xBFF0000000000000, "geo_jet_plane_ddistance_checked: Ok(-1) on a plane jet");
assert_eq(_v35L1_jr(2, _v35L1_jcap), 0xBFF0000000000000, "geo_jet_capsule_dradius_checked: Ok(-1) on a capsule jet");
assert_eq(geo_jet_sphere_dradius(_v35L1_jsph), 0xBFF0000000000000, "geo_jet_sphere_dradius: the same -1");
assert_eq(_v35L1_jr(0, _v35L1_jpl), 0x7FF400000000000A, "geo_jet_sphere_dradius_checked: a plane jet -> INVALID_INPUT");
assert_eq(_v35L1_jr(0, _v35L1_jmiss), 0x7FF400000000000A,
  "geo_jet_sphere_dradius_checked: a miss jet -> INVALID_INPUT");
assert_eq(_v35L1_jr(0, 0), 0x7FF400000000000A, "geo_jet_sphere_dradius_checked: a 0 jet -> INVALID_INPUT");
assert_eq(_v35L1_jr(1, _v35L1_jcap), 0x7FF400000000000A,
  "geo_jet_plane_ddistance_checked: a capsule jet -> INVALID_INPUT");
assert_eq(_v35L1_jr(1, _v35L1_jmiss), 0x7FF400000000000A,
  "geo_jet_plane_ddistance_checked: a miss jet -> INVALID_INPUT");
assert_eq(_v35L1_jr(1, 0), 0x7FF400000000000A, "geo_jet_plane_ddistance_checked: a 0 jet -> INVALID_INPUT");
assert_eq(_v35L1_jr(2, _v35L1_jsph), 0x7FF400000000000A,
  "geo_jet_capsule_dradius_checked: a sphere jet -> INVALID_INPUT");
assert_eq(_v35L1_jr(2, _v35L1_jmiss), 0x7FF400000000000A,
  "geo_jet_capsule_dradius_checked: a miss jet -> INVALID_INPUT");
assert_eq(_v35L1_jr(2, 0), 0x7FF400000000000A, "geo_jet_capsule_dradius_checked: a 0 jet -> INVALID_INPUT");
# The unchecked forms keep their +0 for the mismatch.
assert_eq(geo_jet_capsule_dradius(_v35L1_jsph), 0, "geo_jet_capsule_dradius: a sphere jet still reads +0, unchanged");

# ================================================================
test_group("3.5.0 L1: geo_ray_triangle -- a NaN input is the first NaN, not the miss");
# ================================================================
fn _v35L1_rt3(ox, dx, v0x, v1x, v2y) {
    return geo_ray_triangle(_v35L1_ray(ox, 0x3FD0000000000000, F64_ONE, dx, 0, f64_neg(F64_ONE)),
      _v35L1_tri(v0x, 0, 0, v1x, 0, 0, 0, v2y, 0));
}
assert_eq(_v35L1_rt3(0x3FD0000000000000, 0, 0, F64_ONE, F64_ONE), F64_ONE,
  "geo_ray_triangle: the finite control hits at t = 1");
assert_eq(_v35L1_rt3(0x3FD0000000000000, 0x7FF8000000000123, 0, F64_ONE, F64_ONE), 0x7FF8000000000123,
  "geo_ray_triangle: a NaN direction -> that NaN (3.4.2: the miss)");
assert_eq(_v35L1_rt3(0x3FD0000000000000, 0, 0x7FF8000000000456, F64_ONE, F64_ONE), 0x7FF8000000000456,
  "geo_ray_triangle: a NaN v0 -> that NaN (3.4.2: the miss)");
assert_eq(_v35L1_rt3(0x3FD0000000000000, 0, 0, 0x7FF8000000000789, F64_ONE), 0x7FF8000000000789,
  "geo_ray_triangle: a NaN v1 -> that NaN (3.4.2: the miss)");
assert_eq(_v35L1_rt3(0x3FD0000000000000, 0, 0, F64_ONE, 0xFFF8000000000ABC), 0xFFF8000000000ABC,
  "geo_ray_triangle: a NaN v2 -> that NaN (3.4.2: the miss)");
assert_eq(_v35L1_rt3(0x7FF8000000000DEF, 0x7FF8000000000123, 0, F64_ONE, 0x7FF8000000000456), 0x7FF8000000000DEF,
  "geo_ray_triangle: NaN origin, direction and vertex -> the origin's (the first)");
assert_eq(_v35L1_rt3(0x3FD0000000000000, 0x7FF8000000000123, 0, F64_ONE, 0x7FF8000000000456), 0x7FF8000000000123,
  "geo_ray_triangle: NaN direction and vertex -> the direction's (the first)");
assert_eq(_v35L1_rt3(0x3FD0000000000000, 0, 0, 0x7FF8000000000789, 0x7FF8000000000456), 0x7FF8000000000789,
  "geo_ray_triangle: NaN v1 and v2 -> v1's (the first)");
# An infinite vertex with no NaN keeps the 3.4 arithmetic: here f = 1 / Inf = 0 and v = 0 * Inf, so the
# default NaN the arithmetic makes (FFF8000000000000), as 3.4.2 answered it.
assert_eq(_v35L1_rt3(0x3FD0000000000000, 0, 0, 0x7FF0000000000000, F64_ONE), 0xFFF8000000000000,
  "geo_ray_triangle: an infinite vertex and no NaN -> the arithmetic's NaN, unchanged");

# ================================================================
test_group("3.5.0 L1: geo_closest_point_on_plane -- a 0 handle is the designed 0");
# ================================================================
assert_eq(geo_closest_point_on_plane(geo_plane_from_point_normal(hvec3_zero(), hvec3_zero()), hvec3_one()), 0,
  "geo_closest_point_on_plane: the plane of a zero normal (0) -> 0, not a fault");
assert_eq(geo_closest_point_on_plane(_v35L1_plane(0, 0, F64_ONE, 0), 0), 0,
  "geo_closest_point_on_plane: a 0 point -> 0");
var _v35L1_cpp = geo_closest_point_on_plane(_v35L1_plane(0, 0, F64_ONE, F64_TWO),
  hvec3_new(F64_ONE, F64_TWO, f64_from(7)));
assert_eq(HVec3_z(_v35L1_cpp), F64_TWO, "geo_closest_point_on_plane: z = 2 on the plane z = 2");
assert_eq(HVec3_x(_v35L1_cpp), F64_ONE, "geo_closest_point_on_plane: x kept");

# ================================================================
test_group("3.5.0 L1: geo_triangle_normal / geo_triangle_area -- the exact cross product, rounded once");
# ================================================================
# Oracle: (v1 - v0) x (v2 - v0) in Python Fractions, each component correctly rounded, and the area
# half its length in 700-digit Decimal, correctly rounded.
var _v35L1_e300 = 0x7E37E43C8800759C;   # 1e300
var _v35L1_t300 = _v35L1_tri(0, 0, 0, _v35L1_e300, _v35L1_e300, 0, _v35L1_e300, _v35L1_e300, F64_ONE);
var _v35L1_n300 = geo_triangle_normal(_v35L1_t300);
assert_eq(HVec3_x(_v35L1_n300), 0x7E37E43C8800759C, "geo_triangle_normal: the 1e300 triangle, x = 1e300");
assert_eq(HVec3_y(_v35L1_n300), 0xFE37E43C8800759C, "geo_triangle_normal: the 1e300 triangle, y = -1e300");
assert_eq(HVec3_z(_v35L1_n300), 0, "geo_triangle_normal: the 1e300 triangle, z = +0 exactly (3.4.2: NaN)");
assert_eq(geo_triangle_area(_v35L1_t300), 0x7E30E4D50F99B211,
  "geo_triangle_area: the 1e300 triangle, correctly rounded (3.4.2: NaN)");
# z cancels to 2^-55-ish: the plain products kept 3C80000000000000.
var _v35L1_tc = _v35L1_tri(0x3FB999999999999A, 0x3FC999999999999A, 0, 0x3FD3333333333334, 0x3FE3333333333334, 0,
  0x3FE6666666666666, 0x3FF6666666666667, F64_ONE);
var _v35L1_nc = geo_triangle_normal(_v35L1_tc);
assert_eq(HVec3_z(_v35L1_nc), 0x3C8999999999999B, "geo_triangle_normal: a cancelling component, correctly rounded");
assert_eq(HVec3_x(_v35L1_nc), 0x3FD999999999999B, "geo_triangle_normal: x correctly rounded");
assert_eq(HVec3_y(_v35L1_nc), 0xBFC999999999999B, "geo_triangle_normal: y correctly rounded");
assert_eq(geo_triangle_area(_v35L1_tc), 0x3FCC9F25C5BFEDDB, "geo_triangle_area: the same triangle, correctly rounded");
# Edges at 2^-530: a subnormal z, rounded once (3.4.2: 8C28, two products rounded to the subnormal grid).
var _v35L1_ts = _v35L1_tri(0, 0, 0, 0x1ED4CCCCCCCCCCCD, 0x1EC6666666666666, 0, 0x1EB999999999999A, 0x1EDE666666666666,
  0);
assert_eq(HVec3_z(geo_triangle_normal(_v35L1_ts)), 0x0000000000008C29,
  "geo_triangle_normal: a subnormal z, rounded once");
assert_eq(geo_triangle_area(_v35L1_ts), 0x0000000000004614, "geo_triangle_area: a subnormal area, correctly rounded");
# z = 1.5 2^1024 passes DBL_MAX, the area 1.5 2^1023 does not (3.4.2: +Inf).
var _v35L1_tz = _v35L1_tri(0, 0, 0, 0x5FF8000000000000, 0, 0, 0, 0x5FF0000000000000, 0);
assert_eq(HVec3_z(geo_triangle_normal(_v35L1_tz)), 0x7FF0000000000000, "geo_triangle_normal: z past DBL_MAX -> +Inf");
assert_eq(geo_triangle_area(_v35L1_tz), 0x7FE8000000000000, "geo_triangle_area: 1.5 2^1023, finite (3.4.2: +Inf)");
# Vertices at 2^600 whose z passes DBL_MAX and whose x, y do not (3.4.2: z and the area NaN).
var _v35L1_tb = _v35L1_tri(0, 0, 0, 0x6574000000000000, 0x6560000000000000, 0, 0x6568000000000000, 0x6578000000000000,
  0x2D30000000000000);
var _v35L1_nb = geo_triangle_normal(_v35L1_tb);
assert_eq(HVec3_x(_v35L1_nb), 0x52A0000000000000, "geo_triangle_normal: 2^600 vertices, x");
assert_eq(HVec3_y(_v35L1_nb), 0xD2B4000000000000, "geo_triangle_normal: 2^600 vertices, y");
assert_eq(HVec3_z(_v35L1_nb), 0x7FF0000000000000, "geo_triangle_normal: 2^600 vertices, z -> +Inf (3.4.2: NaN)");
assert_eq(geo_triangle_area(_v35L1_tb), 0x7FF0000000000000, "geo_triangle_area: 2^600 vertices -> +Inf (3.4.2: NaN)");
# An exactly zero component is +0: (1, 0, 0) x (-1, 1, 0) has y = 0 (-1) - 1 0, which the plain products made -0.
var _v35L1_nz = geo_triangle_normal(_v35L1_tri(0, 0, 0, F64_ONE, 0, 0, f64_neg(F64_ONE), F64_ONE, 0));
assert_eq(HVec3_y(_v35L1_nz), 0, "geo_triangle_normal: an exactly zero component is +0");
assert_eq(HVec3_x(_v35L1_nz), 0, "geo_triangle_normal: x = +0");
assert_eq(HVec3_z(_v35L1_nz), F64_ONE, "geo_triangle_normal: z = 1");
# A degenerate triangle: the zero vector and area 0.
var _v35L1_td = _v35L1_tri(F64_ONE, F64_TWO, f64_from(3), F64_TWO, f64_from(4), f64_from(6), f64_from(3), f64_from(6),
  f64_from(9));
var _v35L1_ndg = geo_triangle_normal(_v35L1_td);
assert_eq(HVec3_x(_v35L1_ndg), 0, "geo_triangle_normal: colinear -> x = +0");
assert_eq(HVec3_y(_v35L1_ndg), 0, "geo_triangle_normal: colinear -> y = +0");
assert_eq(HVec3_z(_v35L1_ndg), 0, "geo_triangle_normal: colinear -> z = +0");
assert_eq(geo_triangle_area(_v35L1_td), 0, "geo_triangle_area: colinear -> 0");
# Integer vertices take the certified path with nothing rounded: (1, 2, 3) x (4, 5, 7) = (-1, 5, -3), area
# sqrt(35) / 2 correctly rounded (sqrt is, and the halving is exact).
var _v35L1_ti3 = _v35L1_tri(0, 0, 0, F64_ONE, F64_TWO, f64_from(3), f64_from(4), f64_from(5), f64_from(7));
var _v35L1_ni3 = geo_triangle_normal(_v35L1_ti3);
assert_eq(HVec3_x(_v35L1_ni3), 0xBFF0000000000000, "geo_triangle_normal: integer vertices, x = -1");
assert_eq(HVec3_y(_v35L1_ni3), 0x4014000000000000, "geo_triangle_normal: integer vertices, y = 5");
assert_eq(HVec3_z(_v35L1_ni3), 0xC008000000000000, "geo_triangle_normal: integer vertices, z = -3");
assert_eq(geo_triangle_area(_v35L1_ti3), 0x4007AA10D193C22D, "geo_triangle_area: integer vertices, sqrt(35) / 2");
# Legs 2^-450 and 3 2^-450 (the integer sums: an edge under 2^-400), its area asked right after another
# triangle's normal: 1.5 2^-900 exactly.
assert_eq(HVec3_y(geo_triangle_normal(_v35L1_t300)), 0xFE37E43C8800759C,
  "geo_triangle_normal: the 1e300 triangle again");
var _v35L1_t450 = _v35L1_tri(0, 0, 0, 0x23D0000000000000, 0, 0, 0, 0x23E8000000000000, 0);
assert_eq(geo_triangle_area(_v35L1_t450), 0x07B8000000000000,
  "geo_triangle_area: legs 2^-450 and 3 2^-450 -> 1.5 2^-900 exactly");
# A non-finite vertex keeps the plain products: (0, NaN, +Inf) and a NaN area here.
var _v35L1_ti = _v35L1_tri(0, 0, 0, 0x7FF0000000000000, 0, 0, 0, F64_ONE, 0);
assert_eq(HVec3_z(geo_triangle_normal(_v35L1_ti)), 0x7FF0000000000000,
  "geo_triangle_normal: an infinite vertex, plain z");
assert_eq(HVec3_y(geo_triangle_normal(_v35L1_ti)), 0xFFF8000000000000,
  "geo_triangle_normal: an infinite vertex, plain y");
assert_eq(geo_triangle_area(_v35L1_ti), 0xFFF8000000000000, "geo_triangle_area: an infinite vertex -> NaN");

# ================================================================
test_group("3.5.0 L1: the slab routines answer a hit past DBL_MAX as +Inf, the family's convention");
# ================================================================
# Oracle: the exact slab crossings in Fractions. Every ray routine now answers a hit whose t passes
# DBL_MAX with +Inf, its rounding; through 3.4.2 the AABB and OBB slabs alone answered the miss 0.
var _v35L1_fo = alloc(16);
fn _v35L1_box(lx, ly, lz, hx, hy, hz) {
    var b = alloc(16);
    GeoAabb_set_min(b, hvec3_new(lx, ly, lz));
    GeoAabb_set_max(b, hvec3_new(hx, hy, hz));
    return b;
}
# x in [1e308, 1.5e308] and y in [0.5e308, 1.2e308] from 0 along (1e-10, 1e-10, 0): entry 1e318 on
# face 0, exit 1.2e318 on y. Every crossing reads +Inf; the exact order finds the hit.
# [measured: exact slab crossings in Python Fractions, scratch aabb/obb drivers, 2026-11-14]
var _v35L1_ra = _v35L1_ray(0, 0, 0, 0x3DDB7CDFD9D7BDBB, 0x3DDB7CDFD9D7BDBB, 0);
var _v35L1_bh = _v35L1_box(0x7FE1CCF385EBC8A0, 0x7FD1CCF385EBC8A0, f64_neg(F64_ONE), 0x7FEAB36D48E1ACF0,
  0x7FE55C576D815726, F64_ONE);
assert_eq(geo_ray_aabb_face(_v35L1_ra, _v35L1_bh, _v35L1_fo), 0x7FF0000000000000,
  "geo_ray_aabb_face: a hit at 1e318, every crossing +Inf -> +Inf (3.4.2: the miss)");
assert_eq(load64(_v35L1_fo), 0, "geo_ray_aabb_face: ... on face 0, the x min plane");
assert_eq(load64(_v35L1_fo + 8), 0, "geo_ray_aabb_face: ... no tie");
assert_eq(geo_ray_aabb(_v35L1_ra, _v35L1_bh), 0x7FF0000000000000, "geo_ray_aabb: the same hit -> +Inf");
# y in [1e308, 1.1e308] along (1e-10, 0.5e-10, 0): entry 2e318 on y after the x exit 1.5e318, a miss
# that the +Inf readings cannot tell from the hit above.
# [measured: exact slab crossings in Python Fractions, scratch aabb/obb drivers, 2026-11-14]
var _v35L1_rm = _v35L1_ray(0, 0, 0, 0x3DDB7CDFD9D7BDBB, 0x3DCB7CDFD9D7BDBB, 0);
var _v35L1_bm = _v35L1_box(0x7FE1CCF385EBC8A0, 0x7FE1CCF385EBC8A0, f64_neg(F64_ONE), 0x7FEAB36D48E1ACF0,
  0x7FE394A579B68FE3, F64_ONE);
assert_eq(geo_ray_aabb_face(_v35L1_rm, _v35L1_bm, _v35L1_fo), 0,
  "geo_ray_aabb_face: entry 2e318 after exit 1.5e318, every crossing +Inf -> the miss");
assert_eq(load64(_v35L1_fo), GEO_FACE_NONE, "geo_ray_aabb_face: ... GEO_FACE_NONE");
# A zero direction from inside crosses nothing: the +Inf it starts from stays the miss (2.10.1).
assert_eq(geo_ray_aabb_face(_v35L1_ray(F64_HALF, F64_HALF, F64_HALF, 0, 0, 0), _v35L1_box(0, 0, 0, F64_ONE, F64_ONE,
      F64_ONE), _v35L1_fo), 0, "geo_ray_aabb_face: a zero direction from inside -> the miss, not +Inf");
# An exit whose numerator is finite and whose quotient alone passes DBL_MAX: from the centre of [-1, 1]^3
# along (2^-1074, 0, 0), the exit at 2^1074 on face 1 (3.4.2: the miss).
var _v35L1_bu = _v35L1_box(f64_neg(F64_ONE), f64_neg(F64_ONE), f64_neg(F64_ONE), F64_ONE, F64_ONE, F64_ONE);
assert_eq(geo_ray_aabb_face(_v35L1_ray(0, 0, 0, 1, 0, 0), _v35L1_bu, _v35L1_fo), 0x7FF0000000000000,
  "geo_ray_aabb_face: an exit quotient past DBL_MAX from inside -> +Inf (3.4.2: the miss)");
assert_eq(load64(_v35L1_fo), 1, "geo_ray_aabb_face: ... on face 1");
assert_eq(geo_ray_obb_face(_v35L1_ray(0, 0, 0, 1, 0, 0), geo_obb_new(hvec3_zero(), hvec3_one(), hquat_identity()),
    _v35L1_fo), 0x7FF0000000000000, "geo_ray_obb_face: an exit quotient past DBL_MAX from inside -> +Inf (3.4.2: 0)");
assert_eq(load64(_v35L1_fo), 1, "geo_ray_obb_face: ... on face 1");
# OBBs with the same crossings to within a rounding (centre 1.25e308, half-extents 0.25e308 on x; identity).
# [measured: exact slab crossings in Python Fractions, scratch aabb/obb drivers, 2026-11-14]
var _v35L1_oh = geo_obb_new(hvec3_new(0x7FE640306766BAC8, 0x7FDE42D130773B76, 0),
  hvec3_new(0x7FC1CCF385EBC8A0, 0x7FC8EBBB5516E5AD, F64_ONE), hquat_identity());
assert_eq(geo_ray_obb_face(_v35L1_ra, _v35L1_oh, _v35L1_fo), 0x7FF0000000000000,
  "geo_ray_obb_face: a hit past DBL_MAX, every crossing +Inf -> +Inf (3.4.2: the miss)");
assert_eq(load64(_v35L1_fo), 0, "geo_ray_obb_face: ... on face 0");
assert_eq(geo_ray_obb(_v35L1_ra, _v35L1_oh), 0x7FF0000000000000, "geo_ray_obb: the same hit -> +Inf");
var _v35L1_om = geo_obb_new(hvec3_new(0x7FE640306766BAC8, 0x7FE2B0CC7FD12C42, 0),
  hvec3_new(0x7FC1CCF385EBC8A0, 0x7F9C7B1F3CAC7433, F64_ONE), hquat_identity());
assert_eq(geo_ray_obb_face(_v35L1_rm, _v35L1_om, _v35L1_fo), 0,
  "geo_ray_obb_face: entry after exit past DBL_MAX, every crossing +Inf -> the miss");
assert_eq(geo_ray_obb_face(_v35L1_ray(F64_HALF, F64_HALF, F64_HALF, 0, 0, 0),
    geo_obb_new(hvec3_zero(), hvec3_one(), hquat_identity()), _v35L1_fo), 0,
  "geo_ray_obb_face: a zero direction from inside -> the miss, not +Inf");

# ================================================================
test_group("3.5.0 L1: rays past the sphere's and capsule's limits (GEO7 F2, F3)");
# ================================================================
fn _v35L1_sph(ox, oy, oz, dx, dy, dz, cx, cy, cz, r) {
    var s = alloc(16);
    GeoSphere_set_center(s, hvec3_new(cx, cy, cz));
    GeoSphere_set_radius(s, r);
    return geo_ray_sphere(_v35L1_ray(ox, oy, oz, dx, dy, dz), s);
}
# |d| r near 2^512 and |oc| / r past 2^41: the re-formed a (r^2 - |f|^2) overflowed and the hit read the
# miss. Exact t = 2.6830082738970630e-138 (Decimal), whose rounding is 235FF35F4C212924; the unit-size
# copy answers 0.80 ulp from it.
assert_eq(_v35L1_sph(0xC334AC4181898235, 0xC33D789FCDDC4080, 0x4336DD4D5AB19BD7, 0x5FC4B46D24FA8A47, 0x5FCD8445A33F19C4,
    0xDFC6E656BBA18F7C, 0xC017C19EE3B2E9A0, 0x4016A8E3BB00A470, 0xC00D3F5E370B2872, 0x4008A9A02004B682),
  0x235FF35F4C212925, "geo_ray_sphere: the re-formed big_d overflows -> the unit-size copy's t (3.4.2: the miss)");
# A capsule exit at segment coordinate 1 - 1.5e-16, t = 6.66e386 past DBL_MAX: +Inf on the barrel
# (3.4.2: the miss with GEO_FACE_NONE).
var _v35L1_cr = _v35L1_ray(0x5F9B49D262E1C6DF, 0xDFB524D82FC50B2B, 0xDFAF6D3B22120EF2, 0x0F3050074235D302,
  0x8F10BDD9FCABA0A0, 0x8EFFBA06520A6780);
var _v35L1_cc = geo_capsule_new(hvec3_new(0x5F693BDBF04DCD5E, 0xDFAE9AE8A57227D2, 0x5F6277873D06C7CA),
  hvec3_new(0x5F792FF99E3CDA7C, 0xDFB54F37A2AE41A0, 0x5F70A4A4A5890D7F), 0x5FB2802CD828B9DA);
store64(_v35L1_fo, 0 - 7);
assert_eq(geo_ray_capsule_branch(_v35L1_cr, _v35L1_cc, _v35L1_fo), 0x7FF0000000000000,
  "geo_ray_capsule_branch: a barrel exit past DBL_MAX by an end plane -> +Inf (3.4.2: the miss)");
assert_eq(load64(_v35L1_fo), GEO_CAP_CYLINDER, "geo_ray_capsule_branch: ... on the barrel");
assert_eq(geo_ray_capsule(_v35L1_cr, _v35L1_cc), 0x7FF0000000000000, "geo_ray_capsule: the same exit -> +Inf");

# ==================================================================================================
# 3.5.0 — collision, CGA, half-edge meshes, spatial structures, SDFs (geo_advanced, collision_mesh, spatial)
# ==================================================================================================
# (Written as tests/v35_L2.tcyr; every global and fn below is prefixed _v35L2_.)

alloc_init();

# ---- shared helpers ----
var _v35L2_NAN = 0x7FF8000000000000;
var _v35L2_PINF = 0x7FF0000000000000;
var _v35L2_NINF = 0xFFF0000000000000;
fn _v35L2_isnan(x) { return 1 - f64_eq(x, x); }

# The support functions allocate their answer only, once, so that a refused allocation is their 0
# (which hisab reads as a refusal) and never a read through a 0 vector of their own.
# c + r dir / |dir| for a ball of radius r about (cx, cy, cz); the point itself for r = 0.
fn _v35L2_ball(cx, cy, cz, r, dir) {
    var len = hvec3_length(dir);
    var s = 0;
    if (f64_gt(len, 0) == 1) { s = f64_div(r, len); }
    return hvec3_new(f64_add(cx, f64_mul(HVec3_x(dir), s)), f64_add(cy, f64_mul(HVec3_y(dir), s)),
      f64_add(cz, f64_mul(HVec3_z(dir), s)));
}
# Sphere: shape = HVec4 (cx, cy, cz, r).
fn _v35L2_sup_sphere(shape, dir) {
    return _v35L2_ball(HVec4_x(shape), HVec4_y(shape), HVec4_z(shape), HVec4_w(shape), dir);
}
# Axis-aligned box: shape = [cx, cy, cz, hx, hy, hz].
fn _v35L2_box_axis(c, h, d) {
    if (f64_lt(d, 0) == 1) { return f64_sub(c, h); }
    return f64_add(c, h);
}
fn _v35L2_sup_box(shape, dir) {
    var rx = _v35L2_box_axis(load64(shape), load64(shape + 24), HVec3_x(dir));
    var ry = _v35L2_box_axis(load64(shape + 8), load64(shape + 32), HVec3_y(dir));
    var rz = _v35L2_box_axis(load64(shape + 16), load64(shape + 40), HVec3_z(dir));
    return hvec3_new(rx, ry, rz);
}
fn _v35L2_mkbox(cx, cy, cz, hx, hy, hz) {
    var s = alloc(48);
    store64(s, cx); store64(s + 8, cy); store64(s + 16, cz);
    store64(s + 24, hx); store64(s + 32, hy); store64(s + 40, hz);
    return s;
}
# Capsule: shape = [ax, ay, az, bx, by, bz, r]; the end along dir plus the ball's support.
fn _v35L2_sup_capsule(shape, dir) {
    var abx = f64_sub(load64(shape + 24), load64(shape));
    var aby = f64_sub(load64(shape + 32), load64(shape + 8));
    var abz = f64_sub(load64(shape + 40), load64(shape + 16));
    var dt = f64_add(f64_add(f64_mul(abx, HVec3_x(dir)), f64_mul(aby, HVec3_y(dir))), f64_mul(abz, HVec3_z(dir)));
    var e = shape;
    if (f64_ge(dt, 0) == 1) { e = shape + 24; }
    return _v35L2_ball(load64(e), load64(e + 8), load64(e + 16), load64(shape + 48), dir);
}
fn _v35L2_mkcap(ax, ay, az, bx, by, bz, r) {
    var s = alloc(56);
    store64(s, ax); store64(s + 8, ay); store64(s + 16, az);
    store64(s + 24, bx); store64(s + 32, by); store64(s + 40, bz); store64(s + 48, r);
    return s;
}

# ================================================================
test_group("3.5.0 L2: K003 -- the iteration and layout constants are enum members");
# Through 3.4.2 these were `public var`, and a consumer's GJK_MAX_ITER = 0 took effect. As enum
# members a write is a compile error (scratch probe: a consumer program assigning each one is
# refused by cycc 6.7.18 against the regenerated bundle); their values are unchanged.
assert_eq(GJK_MAX_ITER, 64, "GJK_MAX_ITER = 64");
assert_eq(EPA_MAX_ITER, 64, "EPA_MAX_ITER = 64");
assert_eq(CGA_NUM_BLADES, 32, "CGA_NUM_BLADES = 32");
assert_eq(CGA_MV_SIZE, 256, "CGA_MV_SIZE = 256");
assert_eq(HALFEDGE_NONE, 0x7FFFFFFFFFFFFFFF, "HALFEDGE_NONE = 2^63 - 1");

# The seams the enums needed (tests reach another cap only through them).
# _epa_refine takes EPA's cap (its last argument): two boxes, the first EPA round reads 0.5 + 13 ulp and the
# cap-64 run the exact 0.5 (B overlaps A by 1 + 1 - 1.5 = 0.5 along x).
var _v35L2_kb1 = _v35L2_mkbox(0, 0, 0, F64_ONE, F64_TWO, 0x4008000000000000);
var _v35L2_kb2 = _v35L2_mkbox(0x3FF8000000000000, 0x3FF0000000000000, 0x3FE0000000000000, F64_ONE, F64_ONE, F64_ONE);
var _v35L2_ks4 = alloc(32);
var _v35L2_kn = alloc(8);
var _v35L2_kd = alloc(8);
assert_eq(_epa_seed_portal(&_v35L2_sup_box, _v35L2_kb1, &_v35L2_sup_box, _v35L2_kb2, _v35L2_ks4), 1,
  "_epa_seed_portal: the box pair has a portal");
assert_eq(_epa_refine(&_v35L2_sup_box, _v35L2_kb1, &_v35L2_sup_box, _v35L2_kb2, _v35L2_ks4, _v35L2_kn,
    _v35L2_kd, 2), 1, "_epa_refine: cap 2 answers");
# 3.5.0 (W3, F-CO8-2): 0x3FE000000000000D -> 0x3FE0000000000000: after two rounds the deep snap's face form,
# 13 ulp lower than EPA's, is now taken, the exact 0.5 (B overlaps A by 1 + 1 - 1.5 along x).
assert_eq(load64(_v35L2_kd), 0x3FE0000000000000, "_epa_refine: ... with two rounds' depth, the exact 0.5");
assert_eq(_epa_refine(&_v35L2_sup_box, _v35L2_kb1, &_v35L2_sup_box, _v35L2_kb2, _v35L2_ks4, _v35L2_kn,
    _v35L2_kd, EPA_MAX_ITER), 1, "_epa_refine: cap EPA_MAX_ITER answers");
assert_eq(load64(_v35L2_kd), 0x3FE0000000000000, "_epa_refine: ... the exact 0.5");
# _epa_seed_portal_x takes the discovery rounds (its last argument): one round finds no portal for this box and
# sphere, two do.
var _v35L2_ksp = hvec4_new(0x3FF8000000000000, 0x3FF0000000000000, 0x3FE0000000000000, F64_ONE);
assert_eq(_epa_seed_portal_x(&_v35L2_sup_box, _v35L2_kb1, &_v35L2_sup_sphere, _v35L2_ksp, _v35L2_ks4, 1), 0,
  "_epa_seed_portal_x: one discovery round, no portal");
assert_eq(_epa_seed_portal_x(&_v35L2_sup_box, _v35L2_kb1, &_v35L2_sup_sphere, _v35L2_ksp, _v35L2_ks4, 2), 1,
  "_epa_seed_portal_x: two discovery rounds, a portal");

# ================================================================
test_group("3.5.0 L2: sdf_smooth_union and sdf_capsule at infinite distances and radii");
# Where h clamps to 0 or 1 the blend is d2 or d1 exactly; two equal infinities are that
# infinity for every finite k (the smooth union lies in [min - k/4, min]). Through 3.4.2 every
# infinite operand gave NaN (Inf - Inf, or Inf * 0).
assert_eq(sdf_smooth_union(_v35L2_PINF, _v35L2_PINF, F64_ONE), _v35L2_PINF,
  "sdf_smooth_union(+Inf, +Inf, 1) = +Inf (3.4.2: NaN)");
assert_eq(sdf_smooth_union(_v35L2_NINF, _v35L2_NINF, F64_ONE), _v35L2_NINF,
  "sdf_smooth_union(-Inf, -Inf, 1) = -Inf (3.4.2: NaN)");
assert_eq(sdf_smooth_union(_v35L2_PINF, F64_TWO, F64_ONE), F64_TWO, "sdf_smooth_union(+Inf, 2, 1) = 2 (3.4.2: NaN)");
assert_eq(sdf_smooth_union(F64_TWO, _v35L2_PINF, F64_ONE), F64_TWO, "sdf_smooth_union(2, +Inf, 1) = 2 (3.4.2: NaN)");
assert_eq(sdf_smooth_union(_v35L2_PINF, _v35L2_NINF, F64_ONE), _v35L2_NINF,
  "sdf_smooth_union(+Inf, -Inf, 1) = -Inf (3.4.2: NaN)");
assert_eq(sdf_smooth_union(_v35L2_NINF, _v35L2_PINF, F64_ONE), _v35L2_NINF,
  "sdf_smooth_union(-Inf, +Inf, 1) = -Inf (3.4.2: NaN)");
assert_eq(sdf_smooth_union(_v35L2_PINF, _v35L2_PINF, 0xC000000000000000), _v35L2_PINF,
  "sdf_smooth_union(+Inf, +Inf, -2) = +Inf: |k| finite, the blend's interval is [d, d - k/4]");
assert_eq(_v35L2_isnan(sdf_smooth_union(_v35L2_PINF, _v35L2_PINF, _v35L2_PINF)), 1,
  "sdf_smooth_union(+Inf, +Inf, +Inf) stays NaN (Inf - Inf/4 has no value)");
assert_eq(_v35L2_isnan(sdf_smooth_union(_v35L2_NAN, _v35L2_PINF, F64_ONE)), 1,
  "sdf_smooth_union(NaN, +Inf, 1) stays NaN");
assert_eq(_v35L2_isnan(sdf_smooth_union(_v35L2_PINF, _v35L2_PINF, _v35L2_NAN)), 1,
  "sdf_smooth_union(+Inf, +Inf, NaN) stays NaN");
assert_eq(sdf_smooth_union(f64_from(5), 0x8000000000000000, F64_ONE), 0x8000000000000000,
  "sdf_smooth_union(5, -0, 1) = min = -0, d2 as it stands (3.4.2: +0, the formula's rounding)");
assert_eq(sdf_smooth_union(F64_TWO, 0x4004000000000000, F64_ONE), 0x3FFF000000000000,
  "sdf_smooth_union(2, 2.5, 1) = 1.9375 exactly: the blend itself, h = 3/4 (control)");
# sdf_capsule: a finite point whose distance passes DBL_MAX, an infinite radius. d is finite
# (2 DBL_MAX), so d - Inf is -Inf and d - (-Inf) is +Inf; the overflowed product d m read +Inf.
var _v35L2_dm = hvec3_new(0x7FEFFFFFFFFFFFFF, 0, 0);
var _v35L2_dn = hvec3_new(0xFFEFFFFFFFFFFFFF, 0, 0);
assert_eq(sdf_capsule(_v35L2_dm, _v35L2_dn, _v35L2_dn, _v35L2_PINF), _v35L2_NINF,
  "sdf_capsule: 2 DBL_MAX from a point capsule, radius +Inf -> -Inf (3.4.2: NaN)");
assert_eq(sdf_capsule(_v35L2_dm, _v35L2_dn, hvec3_new(0xFFEFFFFFFFFFFFFF, F64_ONE, 0), _v35L2_PINF), _v35L2_NINF,
  "sdf_capsule: ... and from a short segment there -> -Inf (3.4.2: NaN)");
assert_eq(sdf_capsule(_v35L2_dm, _v35L2_dn, _v35L2_dn, _v35L2_NINF), _v35L2_PINF,
  "sdf_capsule: ... radius -Inf -> +Inf");
assert_eq(_v35L2_isnan(sdf_capsule(hvec3_new(_v35L2_PINF, 0, 0), _v35L2_dn, _v35L2_dn, _v35L2_PINF)), 1,
  "sdf_capsule: an infinite point less an infinite radius stays NaN (Inf - Inf)");
assert_eq(sdf_capsule(hvec3_new(f64_from(3), f64_from(4), 0), hvec3_zero(), hvec3_zero(), _v35L2_PINF), _v35L2_NINF,
  "sdf_capsule: an ordinary distance less +Inf -> -Inf (control, the float path)");

# ================================================================
test_group("3.5.0 L2: the octree's centre at the top of the range (LIE2 F3)");
# (min + max) * 0.5 overflowed for two corners near DBL_MAX of one sign. The oracle: the exact
# midpoint, correctly rounded (python3 Fractions); the plain form's sum, where it does not
# overflow, is the same bits (the last two rows).
var _v35L2_omn = hvec3_zero();
var _v35L2_omx = hvec3_zero();
var _v35L2_obox = alloc(16);
store64(_v35L2_obox, _v35L2_omn);
store64(_v35L2_obox + 8, _v35L2_omx);
var _v35L2_oc: i64[3];
fn _v35L2_mid(a, b) {
    HVec3_set_x(_v35L2_omn, a);
    HVec3_set_x(_v35L2_omx, b);
    _ot_center_into(_v35L2_obox, &_v35L2_oc);
    return HVec3_x(&_v35L2_oc);
}
assert_eq(_v35L2_mid(0x7FE8000000000000, 0x7FEC000000000000), 0x7FEA000000000000,
  "_ot_center_into: 7FE8.. and 7FEC.. -> 7FEA.. (3.4.2: +Inf)");
assert_eq(_v35L2_mid(0xFFEC000000000000, 0xFFE8000000000000), 0xFFEA000000000000,
  "_ot_center_into: FFEC.. and FFE8.. -> FFEA.. (3.4.2: -Inf)");
assert_eq(_v35L2_mid(0x7FEFFFFFFFFFFFFF, 0x7FEFFFFFFFFFFFFD), 0x7FEFFFFFFFFFFFFE,
  "_ot_center_into: DBL_MAX and its second predecessor");
assert_eq(_v35L2_mid(0x7FEFFFFFFFFFFFFF, 0x7FE0000000000001), 0x7FE8000000000000,
  "_ot_center_into: DBL_MAX and 2^1023 + ulp");
assert_eq(_v35L2_mid(0x7FE123456789ABCD, 0x7FEFEDCBA9876543), 0x7FE8888888888888, "_ot_center_into: a top-binade pair");
assert_eq(_v35L2_mid(0x7FEFFFFFFFFFFFFF, 0x7FDFFFFFFFFFFFFF), 0x7FE7FFFFFFFFFFFF,
  "_ot_center_into: DBL_MAX and DBL_MAX / 2");
assert_eq(_v35L2_mid(0xFFEFFFFFFFFFFFFF, 0xFFEFFFFFFFFFFFFF), 0xFFEFFFFFFFFFFFFF, "_ot_center_into: -DBL_MAX twice");
assert_eq(_v35L2_mid(0x3FF0000000000000, 0x4008000000000000), 0x4000000000000000,
  "_ot_center_into: 1 and 3 -> 2 (the plain sum)");
assert_eq(_v35L2_mid(1, 3), 2, "_ot_center_into: 2^-1074 and 3 2^-1074 -> 2 2^-1074 (the plain sum)");
assert_eq(_v35L2_isnan(_v35L2_mid(_v35L2_PINF, _v35L2_NINF)), 1, "_ot_center_into: +Inf and -Inf stay NaN");
# The consequence: the box [7FE8.., 7FEC..]^3 splits its nine points by octant. Through 3.4.2 the
# centre was +Inf on every axis, all nine went to octant 0, and each split kept them together
# down to max_depth.
var _v35L2_lo = 0x7FE9000000000000;
var _v35L2_hi = 0x7FEB000000000000;
var _v35L2_ot = octree_new(hvec3_new(0x7FE8000000000000, 0x7FE8000000000000, 0x7FE8000000000000),
  hvec3_new(0x7FEC000000000000, 0x7FEC000000000000, 0x7FEC000000000000), 1075);
var _v35L2_obad = 0;
for (var _v35L2_oi = 0; _v35L2_oi < 8; _v35L2_oi = _v35L2_oi + 1) {
    var _v35L2_ox = _v35L2_lo;
    var _v35L2_oy = _v35L2_lo;
    var _v35L2_oz = _v35L2_lo;
    if ((_v35L2_oi & 1) != 0) { _v35L2_ox = _v35L2_hi; }
    if ((_v35L2_oi & 2) != 0) { _v35L2_oy = _v35L2_hi; }
    if ((_v35L2_oi & 4) != 0) { _v35L2_oz = _v35L2_hi; }
    var _v35L2_oit, _v35L2_oiv = octree_insert(_v35L2_ot, hvec3_new(_v35L2_ox, _v35L2_oy, _v35L2_oz), _v35L2_oi);
    if (is_ok(_v35L2_oit) == 0) { _v35L2_obad = _v35L2_obad + 1; }
}
var _v35L2_ou0 = alloc_used();
var _v35L2_ot9, _v35L2_ov9 = octree_insert(_v35L2_ot, hvec3_new(0x7FE8800000000000, _v35L2_lo, _v35L2_lo), 8);
var _v35L2_ou1 = alloc_used();
assert_eq(_v35L2_obad == 0 && is_ok(_v35L2_ot9) == 1, 1, "octree_insert: the nine top-binade points are stored");
var _v35L2_oroot = load64(_v35L2_ot);
assert_eq(_ot_node_is_split(_v35L2_oroot), 1, "octree: the root split at the ninth point");
assert_eq(vec_len(_ot_node_points(_ot_node_child(_v35L2_oroot, 7))), 2,
  "octree: octant 7 holds its one point (3.4.2: none)");
assert_eq(vec_len(_ot_node_points(_ot_node_child(_v35L2_oroot, 0))), 4,
  "octree: octant 0 holds its two points (3.4.2: all nine, split again)");
assert_eq(_ot_node_is_split(_ot_node_child(_v35L2_oroot, 0)), 0,
  "octree: octant 0 is a leaf (3.4.2: a chain to max_depth)");
assert_lt(_v35L2_ou1 - _v35L2_ou0, 4096,
  "octree: the split took under 4 KB (3.4.2: a 1,075-level chain, 6 KB a level)");
var _v35L2_oq = octree_query(_v35L2_ot, hvec3_new(0x7FEA000000000000, 0x7FEA000000000000, 0x7FEA000000000000),
  hvec3_new(0x7FEC000000000000, 0x7FEC000000000000, 0x7FEC000000000000));
assert_eq(vec_len(_v35L2_oq) == 1 && vec_get(_v35L2_oq, 0) == 7, 1,
  "octree_query: the upper octant's box returns point 7 alone");

# ================================================================
test_group("3.5.0 L2: the quadtree's centre at the top of the range (the octree's pair)");
# The same (min + max) * 0.5 on the quadtree's side: _qt_bounds_cx / _qt_bounds_cy, with the
# octree's oracle values.
var _v35L2_qb = alloc(32);
fn _v35L2_qmid(a, b) {
    store64(_v35L2_qb, a); store64(_v35L2_qb + 8, b);
    store64(_v35L2_qb + 16, b); store64(_v35L2_qb + 24, a);
    return _qt_bounds_cx(_v35L2_qb);
}
fn _v35L2_qmidy(a, b) {
    store64(_v35L2_qb, b); store64(_v35L2_qb + 8, a);
    store64(_v35L2_qb + 16, a); store64(_v35L2_qb + 24, b);
    return _qt_bounds_cy(_v35L2_qb);
}
assert_eq(_v35L2_qmid(0x7FE8000000000000, 0x7FEC000000000000), 0x7FEA000000000000,
  "_qt_bounds_cx: 7FE8.. and 7FEC.. -> 7FEA.. (3.4.2: +Inf)");
assert_eq(_v35L2_qmidy(0x7FE8000000000000, 0x7FEC000000000000), 0x7FEA000000000000,
  "_qt_bounds_cy: 7FE8.. and 7FEC.. -> 7FEA.. (3.4.2: +Inf)");
assert_eq(_v35L2_qmid(0xFFEC000000000000, 0xFFE8000000000000), 0xFFEA000000000000,
  "_qt_bounds_cx: FFEC.. and FFE8.. -> FFEA.. (3.4.2: -Inf)");
assert_eq(_v35L2_qmidy(0xFFEC000000000000, 0xFFE8000000000000), 0xFFEA000000000000,
  "_qt_bounds_cy: FFEC.. and FFE8.. -> FFEA.. (3.4.2: -Inf)");
assert_eq(_v35L2_qmid(0x7FE123456789ABCD, 0x7FEFEDCBA9876543), 0x7FE8888888888888, "_qt_bounds_cx: a top-binade pair");
assert_eq(_v35L2_qmid(0x3FF0000000000000, 0x4008000000000000), 0x4000000000000000,
  "_qt_bounds_cx: 1 and 3 -> 2 (the plain sum)");
assert_eq(_v35L2_qmidy(1, 3), 2, "_qt_bounds_cy: 2^-1074 and 3 2^-1074 -> 2 2^-1074 (the plain sum)");
# The consequence: [7FE8.., 7FEC..]^2 splits its nine points by quadrant, two each and a third
# in SW. Through 3.4.2 the centre was (+Inf, +Inf), all nine went to SW, and each split kept
# them together down to max_depth.
var _v35L2_qt = quadtree_new(0x7FE8000000000000, 0x7FE8000000000000, 0x7FEC000000000000, 0x7FEC000000000000,
  1075);
var _v35L2_qbad = 0;
for (var _v35L2_qi = 0; _v35L2_qi < 8; _v35L2_qi = _v35L2_qi + 1) {
    var _v35L2_qx = _v35L2_lo;
    var _v35L2_qy = _v35L2_lo;
    if ((_v35L2_qi & 1) != 0) { _v35L2_qx = _v35L2_hi; }
    if ((_v35L2_qi & 2) != 0) { _v35L2_qy = _v35L2_hi; }
    var _v35L2_qit, _v35L2_qiv = quadtree_insert(_v35L2_qt, _v35L2_qx, _v35L2_qy, _v35L2_qi);
    if (is_ok(_v35L2_qit) == 0) { _v35L2_qbad = _v35L2_qbad + 1; }
}
var _v35L2_qu0 = alloc_used();
var _v35L2_qt9, _v35L2_qv9 = quadtree_insert(_v35L2_qt, _v35L2_lo, _v35L2_lo, 8);
var _v35L2_qu1 = alloc_used();
assert_eq(_v35L2_qbad == 0 && is_ok(_v35L2_qt9) == 1, 1, "quadtree_insert: the nine top-binade points are stored");
var _v35L2_qroot = load64(_v35L2_qt);
assert_eq(_qt_node_is_split(_v35L2_qroot), 1, "quadtree: the root split at the ninth point");
assert_eq(vec_len(_qt_node_points(_qt_node_child(_v35L2_qroot, 1))), 6,
  "quadtree: NE holds its two points (3.4.2: none)");
assert_eq(vec_len(_qt_node_points(_qt_node_child(_v35L2_qroot, 2))), 9,
  "quadtree: SW holds its three points (3.4.2: all nine, split again)");
assert_eq(_qt_node_is_split(_qt_node_child(_v35L2_qroot, 2)), 0,
  "quadtree: SW is a leaf (3.4.2: a chain to max_depth)");
assert_lt(_v35L2_qu1 - _v35L2_qu0, 4096,
  "quadtree: the split took under 4 KB (3.4.2: a 1,075-level chain)");
var _v35L2_qq = quadtree_query(_v35L2_qt, 0x7FEA000000000000, 0x7FEA000000000000, 0x7FEC000000000000,
  0x7FEC000000000000);
assert_eq(vec_len(_v35L2_qq) == 2 && vec_get(_v35L2_qq, 0) == 3 && vec_get(_v35L2_qq, 1) == 7, 1,
  "quadtree_query: the NE box returns points 3 and 7 alone");

# ================================================================
test_group("3.5.0 L2: the kd-tree's plane test and its scale (LIE4 F1 / F2, LIE3 F2)");
# _kd_plane_past without the factor 1 - 2^-50: best (1, 0, 0) from the origin (D = 1 exactly), a
# plane at d = 1 + 2^-48 + 2^-52: fl(d^2) = 1 + 2^-47 + 2^-51 is past _kd_scmp's 1 + 2^-47
# margin, so the plane is certainly no nearer (3.4.2, d times 1 - 2^-50 first: 0, cannot tell);
# at d = 1 + 2^-48 fl(d^2) is the margin itself, and the answer is 0 in both.
# [measured: scratch L2 probe of _kd_plane_past, this tree and the 3.4.2 factor (mutant M08), 2026-11-14]
var _v35L2_kp = alloc(8);
store64(_v35L2_kp, hvec3_new(F64_ONE, 0, 0));
var _v35L2_kq = hvec3_zero();
assert_eq(_kd_plane_past(_v35L2_kp, 0, _v35L2_kq, 0, 0xBFF0000000000011), 1,
  "_kd_plane_past: d = 1 + 2^-48 + 2^-52 is past (3.4.2: 0)");
assert_eq(_kd_plane_past(_v35L2_kp, 0, _v35L2_kq, 0, 0xBFF0000000000010), 0,
  "_kd_plane_past: d = 1 + 2^-48 is at the margin: 0");
# A query with no distance to any finite point encloses nothing at a finite radius, and the
# walk is not run: the points array below holds 0 handles, which any leaf would read.
var _v35L2_kpts = alloc(4 * 8);
for (var _v35L2_ki = 0; _v35L2_ki < 4; _v35L2_ki = _v35L2_ki + 1) {
    store64(_v35L2_kpts + _v35L2_ki * 8, hvec3_new(f64_from(_v35L2_ki), 0, 0));
}
var _v35L2_kt = kdtree_build(_v35L2_kpts, 4);
var _v35L2_kz = alloc(4 * 8);
var _v35L2_kw1 = kdtree_within_radius(_v35L2_kt, _v35L2_kz, hvec3_new(_v35L2_NAN, 0, 0), f64_from(10));
assert_eq(_v35L2_kw1 != 0 && vec_len(_v35L2_kw1) == 0, 1,
  "kdtree_within_radius: a NaN query, the empty vec, no point read");
var _v35L2_kw2 = kdtree_within_radius(_v35L2_kt, _v35L2_kz, hvec3_new(0, _v35L2_PINF, 0), f64_from(10));
assert_eq(_v35L2_kw2 != 0 && vec_len(_v35L2_kw2) == 0, 1,
  "kdtree_within_radius: an infinite query, finite r, the empty vec, no point read");
var _v35L2_kw3 = kdtree_within_radius(_v35L2_kt, _v35L2_kz, hvec3_new(0, 0, _v35L2_NAN), _v35L2_PINF);
assert_eq(_v35L2_kw3 != 0 && vec_len(_v35L2_kw3) == 0, 1,
  "kdtree_within_radius: a NaN query at r = +Inf, the empty vec, no point read");
var _v35L2_kw4 = kdtree_within_radius(_v35L2_kt, _v35L2_kpts, hvec3_new(0, _v35L2_PINF, 0), _v35L2_PINF);
assert_eq(vec_len(_v35L2_kw4), 4,
  "kdtree_within_radius: an infinite query at r = +Inf takes every finite point (control)");
# The float path on the best's scale: three points 2^600 out on the axes, the query at 0. The
# best's scale is 2^600 (the exponent of its largest difference) and hi is finite, where 3.4.2
# left it NaN and sent every later leaf to the scaled comparison.
var _v35L2_kfp = alloc(3 * 8);
store64(_v35L2_kfp, hvec3_new(0x6578000000000000, 0, 0));          # 1.5 2^600
store64(_v35L2_kfp + 8, hvec3_new(0, 0x6574000000000000, 0));      # 1.25 2^600
store64(_v35L2_kfp + 16, hvec3_new(0, 0, 0x657C000000000000));     # 1.75 2^600
var _v35L2_kft = kdtree_build(_v35L2_kfp, 3);
assert_eq(kdtree_nearest(_v35L2_kft, _v35L2_kfp, hvec3_zero()), 1, "kdtree_nearest: 1.25 2^600 is nearest the origin");
var _v35L2_kb: i64[5];
store64(&_v35L2_kb, 0 - 1);
store64(&_v35L2_kb + 8, _v35L2_PINF);
store64(&_v35L2_kb + 16, _v35L2_PINF);
store64(&_v35L2_kb + 24, _v35L2_NAN);
store64(&_v35L2_kb + 32, 0);
_kd_nearest_rec(_v35L2_kft, _v35L2_kfp, hvec3_zero(), &_v35L2_kb);
assert_eq(load64(&_v35L2_kb), 1, "_kd_nearest_rec: the best is point 1");
assert_eq(load64(&_v35L2_kb + 32), 600, "_kd_nearest_rec: on the best's scale, 2^600 (3.4.2: unscaled)");
assert_eq(load64(&_v35L2_kb + 8), 0x3FF9000000000000, "_kd_nearest_rec: the best's scaled distance 1.5625 = 1.25^2");
assert_eq(load64(&_v35L2_kb + 24), 0x3FF9000000000040, "_kd_nearest_rec: hi 64 ulps above it, finite (3.4.2: NaN)");
# On a scale above 1 a plane whose d overflows, and a leaf whose difference overflows, are
# decided exactly: best (2^1021, 1.5 2^1023, 1.5 2^1023) at 2.75 2^1023 from the query
# (-1.5 2^1023, 0, 0) with a finite difference, (2^1023, 0, 0) at 2.5 2^1023 behind the plane
# x = 0.625 2^1023, whose d and difference both overflow. The nearer one is behind it.
var _v35L2_kop = alloc(2 * 8);
store64(_v35L2_kop, hvec3_new(0x7FC0000000000000, 0x7FE8000000000000, 0x7FE8000000000000));
store64(_v35L2_kop + 8, hvec3_new(0x7FE0000000000000, 0, 0));
var _v35L2_kot = kdtree_build(_v35L2_kop, 2);
assert_eq(kdtree_nearest(_v35L2_kot, _v35L2_kop, hvec3_new(0xFFE8000000000000, 0, 0)), 1,
  "kdtree_nearest: the point behind an overflowing plane, nearer than a best on the 2^1023 scale");
# The radius on its own scale: points 1, 1.5 and 2 times 2^600 on x, r = 1.5 2^600 (the second on
# the sphere, inside), and the same at 2^-600. 3.4.2: every leaf to _kd_within (r^2 overflows /
# flushes); the answers are the same, the path is the float one.
var _v35L2_krp = alloc(3 * 8);
store64(_v35L2_krp, hvec3_new(0x6570000000000000, 0, 0));
store64(_v35L2_krp + 8, hvec3_new(0x6578000000000000, 0, 0));
store64(_v35L2_krp + 16, hvec3_new(0x6580000000000000, 0, 0));
var _v35L2_krt = kdtree_build(_v35L2_krp, 3);
var _v35L2_kr1 = kdtree_within_radius(_v35L2_krt, _v35L2_krp, hvec3_zero(), 0x6578000000000000);
assert_eq(vec_len(_v35L2_kr1), 2, "kdtree_within_radius: r = 1.5 2^600 holds two points");
assert_eq(vec_len(_v35L2_kr1) == 2 && vec_get(_v35L2_kr1, 0) + vec_get(_v35L2_kr1, 1) == 1, 1,
  "kdtree_within_radius: ... points 0 and 1");
var _v35L2_krm = alloc(3 * 8);
store64(_v35L2_krm, hvec3_new(0x1A70000000000000, 0, 0));
store64(_v35L2_krm + 8, hvec3_new(0x1A78000000000000, 0, 0));
store64(_v35L2_krm + 16, hvec3_new(0x1A80000000000000, 0, 0));
var _v35L2_krmt = kdtree_build(_v35L2_krm, 3);
var _v35L2_kr2 = kdtree_within_radius(_v35L2_krmt, _v35L2_krm, hvec3_zero(), 0x1A78000000000000);
assert_eq(vec_len(_v35L2_kr2), 2, "kdtree_within_radius: r = 1.5 2^-600 holds two points");
var _v35L2_kr3 = kdtree_within_radius(_v35L2_krt, _v35L2_krp, hvec3_zero(), 0x6577FFFFFFFFFFFF);
assert_eq(vec_len(_v35L2_kr3), 1, "kdtree_within_radius: r one ulp under 1.5 2^600 holds one");
# r = 0 keeps every leaf on the exact test (no scale exists for it): the point the query sits on.
var _v35L2_kr4 = kdtree_within_radius(_v35L2_krt, _v35L2_krp, hvec3_new(0x6578000000000000, 0, 0), 0);
assert_eq(vec_len(_v35L2_kr4) == 1 && vec_get(_v35L2_kr4, 0) == 1, 1,
  "kdtree_within_radius: r = 0 on point 1 holds point 1");
# _ot_mid1 where an operand is infinite: the infinity (both forms agree).
assert_eq(_ot_mid1(_v35L2_PINF, 0xFFEFFFFFFFFFFFFF), _v35L2_PINF, "_ot_mid1(+Inf, -DBL_MAX) = +Inf");

# ================================================================
test_group("3.5.0 L2: halfedge_is_boundary -- isolated and bowtie vertices (AU2-G5-F8, CO F4)");
# Boundary: a vertex with a twinless half-edge in or out, on any of its fans, or one no
# triangle uses (OpenMesh's is_boundary(VertexHandle) and CGAL's is_border(v) answer true).
var _v35L2_ht = vec_new();
vec_push(_v35L2_ht, 0); vec_push(_v35L2_ht, 1); vec_push(_v35L2_ht, 2);
var _v35L2_hm = halfedge_from_triangles(_v35L2_ht, 1, 4);
var _v35L2_h1t, _v35L2_h1v = halfedge_is_boundary(_v35L2_hm, 3);
assert_eq(is_ok(_v35L2_h1t) == 1 && _v35L2_h1v == 1, 1,
  "halfedge_is_boundary: an isolated vertex is boundary, Ok(1) (3.4.2: Ok(0))");
# The octahedron around vertex 0 (closed), then one more triangle (0, 6, 7): vertex 0's first
# fan is closed, its second open. 3.4.2 read the first only: Ok(0).
fn _v35L2_oct(t, h, o) {
    # an octahedron with apexes h and o and equator 1..4 offset by o's base index
    vec_push(t, h); vec_push(t, o + 1); vec_push(t, o + 2);
    vec_push(t, h); vec_push(t, o + 2); vec_push(t, o + 3);
    vec_push(t, h); vec_push(t, o + 3); vec_push(t, o + 4);
    vec_push(t, h); vec_push(t, o + 4); vec_push(t, o + 1);
    vec_push(t, o + 5); vec_push(t, o + 2); vec_push(t, o + 1);
    vec_push(t, o + 5); vec_push(t, o + 3); vec_push(t, o + 2);
    vec_push(t, o + 5); vec_push(t, o + 4); vec_push(t, o + 3);
    vec_push(t, o + 5); vec_push(t, o + 1); vec_push(t, o + 4);
    return 0;
}
var _v35L2_hb = vec_new();
_v35L2_oct(_v35L2_hb, 0, 0);
vec_push(_v35L2_hb, 0); vec_push(_v35L2_hb, 6); vec_push(_v35L2_hb, 7);
var _v35L2_hbm = halfedge_from_triangles(_v35L2_hb, 9, 8);
var _v35L2_h2t, _v35L2_h2v = halfedge_is_boundary(_v35L2_hbm, 0);
assert_eq(is_ok(_v35L2_h2t) == 1 && _v35L2_h2v == 1, 1,
  "halfedge_is_boundary: a bowtie vertex with an open second fan is boundary (3.4.2: Ok(0))");
var _v35L2_h3t, _v35L2_h3v = halfedge_is_boundary(_v35L2_hbm, 1);
assert_eq(is_ok(_v35L2_h3t) == 1 && _v35L2_h3v == 0, 1,
  "halfedge_is_boundary: ... the octahedron's other vertices are interior");
var _v35L2_h4t, _v35L2_h4v = halfedge_is_boundary(_v35L2_hbm, 6);
assert_eq(is_ok(_v35L2_h4t) == 1 && _v35L2_h4v == 1, 1,
  "halfedge_is_boundary: ... the lone triangle's vertex is boundary");
# Two octahedra sharing vertex 0: two closed fans, no edge of one triangle at it: Ok(0).
var _v35L2_hc = vec_new();
_v35L2_oct(_v35L2_hc, 0, 0);
_v35L2_oct(_v35L2_hc, 0, 5);
var _v35L2_hcm = halfedge_from_triangles(_v35L2_hc, 16, 11);
var _v35L2_h5t, _v35L2_h5v = halfedge_is_boundary(_v35L2_hcm, 0);
assert_eq(is_ok(_v35L2_h5t) == 1 && _v35L2_h5v == 0, 1,
  "halfedge_is_boundary: two closed fans at one vertex: Ok(0), no boundary edge");
# The twin reading, not "an edge in one triangle": the octahedron with (0, 2, 3) flipped to
# (0, 3, 2). Every edge still lies in exactly two triangles, but the flipped face runs each of
# its three edges the same way as its neighbour, so those six half-edges have no twin, and the
# face's vertices are boundary; a vertex none of them touches is interior.
var _v35L2_hf = vec_new();
fn _v35L2_tri(t, a, b, c) {
    vec_push(t, a); vec_push(t, b); vec_push(t, c);
    return 0;
}
_v35L2_tri(_v35L2_hf, 0, 1, 2); _v35L2_tri(_v35L2_hf, 5, 2, 1); _v35L2_tri(_v35L2_hf, 0, 3, 2);
_v35L2_tri(_v35L2_hf, 5, 3, 2); _v35L2_tri(_v35L2_hf, 0, 3, 4); _v35L2_tri(_v35L2_hf, 5, 4, 3);
_v35L2_tri(_v35L2_hf, 0, 4, 1); _v35L2_tri(_v35L2_hf, 5, 1, 4);
var _v35L2_hfm = halfedge_from_triangles(_v35L2_hf, 8, 6);
var _v35L2_h6t, _v35L2_h6v = halfedge_is_boundary(_v35L2_hfm, 0);
assert_eq(is_ok(_v35L2_h6t) == 1 && _v35L2_h6v == 1, 1,
  "halfedge_is_boundary: a flipped face's vertex is boundary though its edges lie in two triangles");
var _v35L2_h7t, _v35L2_h7v = halfedge_is_boundary(_v35L2_hfm, 4);
assert_eq(is_ok(_v35L2_h7t) == 1 && _v35L2_h7v == 0, 1,
  "halfedge_is_boundary: ... a vertex no twinless half-edge touches is interior (control)");
# The vertex records an outgoing half-edge with no twin where it has one: here the lone
# triangle's 0 -> 6, half-edge 24.
assert_eq(vec_get(HalfEdgeMesh_vertex_edge(_v35L2_hbm), 0), 24,
  "halfedge_from_triangles: vertex 0 records its open half-edge 0 -> 6");
assert_eq(vec_get(HalfEdgeMesh_vertex_edge(_v35L2_hcm), 0), 0,
  "halfedge_from_triangles: a vertex with none keeps its first (control)");

# ================================================================
test_group("3.5.0 L2: cga_rotor about a zero axis (AU2 2b)");
# A zero axis names no direction: where sin(angle / 2) is exactly 0 the rotor is cos(angle / 2)
# alone; otherwise it is a NaN axis's rotor, cos(angle / 2) beside a NaN bivector, bit for bit
# (su2_from_axis_angle's convention, the same row).
fn _v35L2_mv_nz(mv) {
    var c = 0;
    for (var i = 0; i < 32; i = i + 1) { if (cga_mv_get(mv, i) != 0) { c = c + 1; } }
    return c;
}
fn _v35L2_mv_same(a, b) {
    var c = 0;
    for (var i = 0; i < 32; i = i + 1) { if (cga_mv_get(a, i) != cga_mv_get(b, i)) { c = c + 1; } }
    return c;
}
var _v35L2_r1 = cga_rotor(0, 0, 0, F64_PI_2);
var _v35L2_rn = cga_rotor(_v35L2_NAN, _v35L2_NAN, _v35L2_NAN, F64_PI_2);
assert_eq(cga_mv_get(_v35L2_r1, 0), 0x3FE6A09E667F3BCD,
  "cga_rotor(0, 0, 0, pi/2): scalar cos(pi/4), which no axis enters (3.4.2: 1, the identity)");
assert_eq(_v35L2_isnan(cga_mv_get(_v35L2_r1, 6)) && _v35L2_isnan(cga_mv_get(_v35L2_r1, 7))
  && _v35L2_isnan(cga_mv_get(_v35L2_r1, 10)), 1, "cga_rotor(0, 0, 0, pi/2): e12, e13 and e23 NaN, no direction");
assert_eq(_v35L2_mv_same(_v35L2_r1, _v35L2_rn), 0,
  "cga_rotor(0, 0, 0, pi/2) is a quiet-NaN axis's rotor in all 32 slots, bit for bit");
var _v35L2_r2 = cga_rotor(0, 0, 0, 0);
assert_eq(cga_mv_get(_v35L2_r2, 0) == F64_ONE && _v35L2_mv_nz(_v35L2_r2) == 1, 1,
  "cga_rotor(0, 0, 0, 0) is the identity rotor");
var _v35L2_r3 = cga_rotor(0, 0, 0, 0x8000000000000000);
assert_eq(cga_mv_get(_v35L2_r3, 0) == F64_ONE && _v35L2_mv_nz(_v35L2_r3) == 1, 1,
  "cga_rotor(0, 0, 0, -0) is the identity rotor");
var _v35L2_r4 = cga_rotor(0, 0, 0, _v35L2_NAN);
assert_eq(_v35L2_isnan(cga_mv_get(_v35L2_r4, 0)) && _v35L2_isnan(cga_mv_get(_v35L2_r4, 10)), 1,
  "cga_rotor(0, 0, 0, NaN): the NaN angle reaches the scalar and the bivector");
assert_eq(cga_mv_get(cga_rotor(0, 0, F64_ONE, F64_PI_2), 0), 0x3FE6A09E667F3BCD,
  "cga_rotor: a unit axis at pi/2, cos(pi/4) (control)");

# ================================================================
test_group("3.5.0 L2: _ga_inside_proven clears _GA_NEAR_V on its exact-origin exit (INS6 F1)");
# Two point shapes at the origin: the distance query's first support is the origin itself, its
# exact-origin exit (1 with no tetrahedron). The support function stands for a query run inside
# it, leaving _GA_NEAR_V set; through 3.4.2 that value survived the exit and _ga_near_ring read it.
var _v35L2_nvp = hvec3_new(F64_ONE, F64_TWO, 0x4008000000000000);
fn _v35L2_sup_poison(shape, dir) {
    _GA_NEAR_V = _v35L2_nvp;
    return hvec3_zero();
}
var _v35L2_n4 = alloc(32);
var _v35L2_nip = _ga_inside_proven(&_v35L2_sup_poison, 0, &_v35L2_sup_poison, 0, _v35L2_n4, 0);
assert_eq(_v35L2_nip, 0, "_ga_inside_proven: the exact-origin exit answers 0 (no tetrahedron)");
assert_eq(_GA_NEAR_V, 0, "_ga_inside_proven: ... and leaves _GA_NEAR_V 0, not a nested query's point");

# ================================================================
test_group("3.5.0 L2: the collision entries' failure channel, every allocation refused in turn (INS5 F1, AU2 2b)");
# A counting allocator in hisab's scope refuses the k-th request (mode 0) or the k-th and every
# later one (mode 1). Each _checked entry must answer Err(HSB_ERR_ALLOC) or the open heap's answer
# bit for bit, and its plain form 0 where the _checked one is Err, else that same answer. The
# fixtures include deep capsule contacts (the paths whose refusal exits no suite reached: the
# roadmap's "four refusal mutants unproven").
var _v35L2_k = 0;
var _v35L2_n = 0;
var _v35L2_mode = 0;
var _v35L2_hits = 0;
# The requests it grants come from a growable arena, which each sweep below rewinds at every refusal
# point (a point's armed runs share it until the point is scored). Served from the global heap, every
# run's allocations stayed, and this group alone held 5.6 GB resident at the end.
# [measured: scratch vmpeak.py and a per-group VmRSS trace of the modules_d binary, 2026-11-14]
var _v35L2_ar = arena_new_growable(1048576);
fn _v35L2_al(state, size) {
    _v35L2_n = _v35L2_n + 1;
    if (_v35L2_k != 0) {
        if (_v35L2_n == _v35L2_k || (_v35L2_mode == 1 && _v35L2_n > _v35L2_k)) {
            _v35L2_hits = _v35L2_hits + 1;
            return 0;
        }
    }
    return arena_alloc(_v35L2_ar, size);
}
fn _v35L2_re(state, p, osz, nsz) {
    var q = _v35L2_al(state, nsz);
    if (q != 0 && p != 0) {
        var m = osz;
        if (nsz < m) { m = nsz; }
        for (var i = 0; i < m; i = i + 1) { store8(q + i, load8(p + i)); }
    }
    return q;
}
fn _v35L2_fr(state, p) { return 0; }
fn _v35L2_rs(state) { return 0; }
var _v35L2_A = allocator_new(&_v35L2_al, &_v35L2_re, &_v35L2_fr, &_v35L2_rs, 0);
fn _v35L2_arm(k, mode) {
    _v35L2_k = k;
    _v35L2_mode = mode;
    _v35L2_n = 0;
    _v35L2_hits = 0;
    return hisab_alloc_scope(_v35L2_A);
}
fn _v35L2_disarm(prev) {
    hisab_alloc_scope(prev);
    _v35L2_k = 0;
    return 0;
}
# Oriented box: shape = [cx, cy, cz, hx, hy, hz, u0, u1, u2] (15 words); c + sum +-h_i u_i.
fn _v35L2_sup_obb(shape, dir) {
    var x = load64(shape);
    var y = load64(shape + 8);
    var z = load64(shape + 16);
    for (var oi = 0; oi < 3; oi = oi + 1) {
        var ux = load64(shape + 48 + oi * 24);
        var uy = load64(shape + 56 + oi * 24);
        var uz = load64(shape + 64 + oi * 24);
        var hh = load64(shape + 24 + oi * 8);
        var dd = f64_add(f64_add(f64_mul(HVec3_x(dir), ux), f64_mul(HVec3_y(dir), uy)), f64_mul(HVec3_z(dir), uz));
        if (f64_lt(dd, 0) == 1) { hh = f64_neg(hh); }
        x = f64_add(x, f64_mul(ux, hh));
        y = f64_add(y, f64_mul(uy, hh));
        z = f64_add(z, f64_mul(uz, hh));
    }
    return hvec3_new(x, y, z);
}
fn _v35L2_w15(p) {
    var s = alloc(120);
    for (var i = 0; i < 15; i = i + 1) { store64(s + i * 8, load64(p + i * 8)); }
    return s;
}
# The fixtures.
var _v35L2_cbox = _v35L2_mkbox(0, 0, 0, F64_ONE, F64_ONE, F64_ONE);
var _v35L2_csph = hvec4_new(0x3FF8000000000000, 0x3FD0000000000000, 0, F64_ONE);
var _v35L2_cfar = hvec4_new(f64_from(10), 0, 0, F64_ONE);
var _v35L2_cmov = hvec4_new(f64_from(0 - 5), 0x3FD0000000000000, 0, F64_HALF);
var _v35L2_ccap = _v35L2_mkcap(f64_from(0 - 2), 0, 0, F64_TWO, 0x3FC0000000000000, 0, F64_ONE);
var _v35L2_cin = hvec4_new(0x3FE0000000000000, 0x3FC999999999999A, 0x3FB999999999999A, F64_HALF);
var _v35L2_ccap2 = _v35L2_mkcap(0x3FD0000000000000, f64_from(0 - 2), 0x3FC0000000000000, 0xBFC0000000000000,
  F64_TWO, 0x3FD0000000000000, 0x3FE8000000000000);
var _v35L2_cbx2 = _v35L2_mkbox(0x3FF8000000000000, 0x3FD0000000000000, 0, F64_ONE, F64_HALF, F64_HALF);
# A ball off the centre of a thin oriented box (tests/modules.tcyr's _c37_f8 / _c37_g8): EPA on
# the core, the snap and the crease walk; and two capsules crossing 1e-6 deep.
var _v35L2_c8w: i64[15];
store64(&_v35L2_c8w, 0xBFCF84E7AA9FA3F0); store64(&_v35L2_c8w + 8, 0xBFCF74BF6FE5B850);
store64(&_v35L2_c8w + 16, 0x3FC84604AD7B3830); store64(&_v35L2_c8w + 24, 0x3F8B523657B55369);
store64(&_v35L2_c8w + 32, 0x3FD59B5CE8D5CB11); store64(&_v35L2_c8w + 40, 0x3FBDA3BD92CC68FB);
store64(&_v35L2_c8w + 48, 0xBFE72AFF42F4747C); store64(&_v35L2_c8w + 56, 0x3FE5F8318C5309B1);
store64(&_v35L2_c8w + 64, 0xBFB1220B629A8FF9); store64(&_v35L2_c8w + 72, 0xBFE5F5EAA9E317B3);
store64(&_v35L2_c8w + 80, 0xBFE6A07555925350); store64(&_v35L2_c8w + 88, 0x3FC5D2302276FE31);
store64(&_v35L2_c8w + 96, 0x3FB1D90BCB6481D1); store64(&_v35L2_c8w + 104, 0x3FC5AD656A6F0B89);
store64(&_v35L2_c8w + 112, 0x3FEF7571487E248B);
var _v35L2_cobb = _v35L2_w15(&_v35L2_c8w);
var _v35L2_cob = hvec4_new(0xBFCF28CEB3BAE0F3, 0xBFD03EB48EE1A16A, 0x3FC199B690E487A9, 0x40113AF060BA10A0);
var _v35L2_ccap3 = _v35L2_mkcap(0x3FD0000000000000, f64_from(0 - 2), 0x3FFBFFFFFFEF39A0, 0xBFC0000000000000, F64_TWO,
  0x3FFBFFFFFFEF39A0, 0x3FE8000000000000);
var _v35L2_vz = hvec3_zero();
var _v35L2_vx = hvec3_new(f64_from(4), 0, 0);
# Case c, checked (pl 0) or plain (pl 1): out = [kind (1 Ok, 2 Err, 3 plain), value, nx, ny, nz, d].
fn _v35L2_case(c, pl, out) {
    var nb = alloc(8);
    var db = alloc(8);
    store64(nb, 0x1234);
    store64(db, 0x5678);
    var t = 0;
    var v = 0;
    if (c == 0 || c == 1 || c == 2) {
        var sb = _v35L2_csph;
        if (c == 1) { sb = _v35L2_cfar; }
        if (pl == 1) {
            if (c == 2) { v = mpr_intersect(&_v35L2_sup_box, _v35L2_cbox, &_v35L2_sup_sphere, sb); }
            else { v = gjk_intersect_3d(&_v35L2_sup_box, _v35L2_cbox, &_v35L2_sup_sphere, sb); }
        } elif (c == 2) {
            var t2, v2 = mpr_intersect_checked(&_v35L2_sup_box, _v35L2_cbox, &_v35L2_sup_sphere, sb);
            t = t2;
            v = v2;
        } else {
            var t1, v1 = gjk_intersect_3d_checked(&_v35L2_sup_box, _v35L2_cbox, &_v35L2_sup_sphere, sb);
            t = t1;
            v = v1;
        }
    } elif (c == 5 || c == 10) {
        var fa = &_v35L2_sup_box;
        var sa = _v35L2_cbox;
        var sb5 = _v35L2_cmov;
        if (c == 10) {
            fa = &_v35L2_sup_capsule;
            sa = _v35L2_ccap;
            sb5 = _v35L2_cin;
        }
        if (pl == 1) {
            v = time_of_impact(fa, sa, _v35L2_vz, &_v35L2_sup_sphere, sb5, _v35L2_vx, F64_TWO, db, nb);
        } else {
            var t5, v5 = time_of_impact_checked(fa, sa, _v35L2_vz, &_v35L2_sup_sphere, sb5, _v35L2_vx, F64_TWO, db, nb);
            t = t5;
            v = v5;
        }
    } else {
        var fa6 = &_v35L2_sup_box;
        var sa6 = _v35L2_cbox;
        var fb6 = &_v35L2_sup_sphere;
        var sb6 = _v35L2_csph;
        if (c == 6 || c == 7 || c == 8 || c == 9 || c == 11) { fa6 = &_v35L2_sup_capsule; sa6 = _v35L2_ccap; }
        if (c == 6 || c == 7) { sb6 = _v35L2_cin; }
        if (c == 8 || c == 11) { fb6 = &_v35L2_sup_capsule; sb6 = _v35L2_ccap2; }
        if (c == 9) { fb6 = &_v35L2_sup_box; sb6 = _v35L2_cbx2; }
        if (c == 12) { fa6 = &_v35L2_sup_obb; sa6 = _v35L2_cobb; sb6 = _v35L2_cob; }
        if (c == 13) { fa6 = &_v35L2_sup_capsule; sa6 = _v35L2_ccap; fb6 = &_v35L2_sup_capsule; sb6 = _v35L2_ccap3; }
        var mp = (c == 4 || c == 7 || c == 11);
        if (pl == 1) {
            if (mp == 1) { v = mpr_penetration(fa6, sa6, fb6, sb6, nb, db); }
            else { v = gjk_epa_3d(fa6, sa6, fb6, sb6, nb, db); }
        } elif (mp == 1) {
            var t7, v7 = mpr_penetration_checked(fa6, sa6, fb6, sb6, nb, db);
            t = t7;
            v = v7;
        } else {
            var t6, v6 = gjk_epa_3d_checked(fa6, sa6, fb6, sb6, nb, db);
            t = t6;
            v = v6;
        }
    }
    store64(out, 3);
    if (pl == 0) {
        store64(out, 2);
        if (is_ok(t) == 1) { store64(out, 1); }
    }
    store64(out + 8, v);
    var n = load64(nb);
    if (n == 0x1234) {
        store64(out + 16, 0x1234); store64(out + 24, 0x1234); store64(out + 32, 0x1234);
    } elif (n == 0) {
        store64(out + 16, 0); store64(out + 24, 0); store64(out + 32, 0);
    } else {
        store64(out + 16, HVec3_x(n)); store64(out + 24, HVec3_y(n)); store64(out + 32, HVec3_z(n));
    }
    store64(out + 40, load64(db));
    return 0;
}
var _v35L2_NC = 14;
var _v35L2_open: i64[84];
var _v35L2_cw: i64[6];
var _v35L2_pw: i64[6];
fn _v35L2_same(a, b) {
    for (var i = 1; i < 6; i = i + 1) { if (load64(a + i * 8) != load64(b + i * 8)) { return 0; } }
    return 1;
}
# 1 when out is the designed refusal of case c: Err(HSB_ERR_ALLOC), and the out-params as the
# plain form leaves them on its 0 (epa / mpr: unit_x or a 0 normal, depth +0; toi: unwritten).
fn _v35L2_refusal(c, out) {
    if (load64(out) != 2 || load64(out + 8) != HSB_ERR_ALLOC) { return 0; }
    if (c == 0 || c == 1 || c == 2) { return 1; }
    if (c == 5 || c == 10) { return load64(out + 16) == 0x1234 && load64(out + 40) == 0x5678; }
    var nx = load64(out + 16);
    var nok = (nx == F64_ONE && load64(out + 24) == 0 && load64(out + 32) == 0) || nx == 0;
    return nok == 1 && load64(out + 40) == 0;
}
for (var _v35L2_c = 0; _v35L2_c < _v35L2_NC; _v35L2_c = _v35L2_c + 1) {
    _v35L2_case(_v35L2_c, 0, &_v35L2_open + _v35L2_c * 48);
}
# The open answers: contacts but for the far sphere; the moving sphere's front at -4.5 + 4 t meets
# the box face x = -1 at t = 0.875, and the deep capsule pair is in contact at t = 0.
var _v35L2_okv = 0;
for (var _v35L2_c = 0; _v35L2_c < _v35L2_NC; _v35L2_c = _v35L2_c + 1) {
    var _v35L2_want = 1;
    if (_v35L2_c == 1) { _v35L2_want = 0; }
    var _v35L2_ow = &_v35L2_open + _v35L2_c * 48;
    if (load64(_v35L2_ow) == 1 && load64(_v35L2_ow + 8) == _v35L2_want) { _v35L2_okv = _v35L2_okv + 1; }
}
assert_eq(_v35L2_okv, _v35L2_NC,
  "the _checked entries' open answers: Ok(1) for each contact, Ok(0) for the far sphere");
assert_eq(load64(&_v35L2_open + 5 * 48 + 40), 0x3FEC000000000000,
  "time_of_impact_checked: the sphere meets the box at t = 0.875");
# The sweep.
var _v35L2_sw_bad = 0;
var _v35L2_sw_err = 0;
var _v35L2_sw_pts = 0;
var _v35L2_sw_ends = 0;
for (var _v35L2_c = 0; _v35L2_c < _v35L2_NC; _v35L2_c = _v35L2_c + 1) {
    # The deep fixtures (about 3,000 requests each) take one refusal at a time only, the mode that
    # reaches past a refusal into the code after it; the rest take both.
    # [measured: scratch L2 sw.cyr, the k each case's sweep ended at, 2026-11-14]
    var _v35L2_modes = 2;
    if (_v35L2_c >= 12 || _v35L2_c == 6 || _v35L2_c == 7 || _v35L2_c == 10) { _v35L2_modes = 1; }
    for (var _v35L2_md = 0; _v35L2_md < _v35L2_modes; _v35L2_md = _v35L2_md + 1) {
        var _v35L2_kk = 1;
        var _v35L2_done = 0;
        while (_v35L2_done == 0 && _v35L2_kk < 100000) {
            arena_reset(_v35L2_ar);
            var _v35L2_pv = _v35L2_arm(_v35L2_kk, _v35L2_md);
            _v35L2_case(_v35L2_c, 0, &_v35L2_cw);
            var _v35L2_hit = _v35L2_hits;
            _v35L2_disarm(_v35L2_pv);
            _v35L2_pv = _v35L2_arm(_v35L2_kk, _v35L2_md);
            _v35L2_case(_v35L2_c, 1, &_v35L2_pw);
            _v35L2_disarm(_v35L2_pv);
            if (_v35L2_hit == 0) {
                _v35L2_done = 1;
                _v35L2_sw_ends = _v35L2_sw_ends + 1;
            }
            _v35L2_sw_pts = _v35L2_sw_pts + 1;
            if (_v35L2_refusal(_v35L2_c, &_v35L2_cw) == 1) {
                _v35L2_sw_err = _v35L2_sw_err + 1;
                if (load64(&_v35L2_pw + 8) != 0) { _v35L2_sw_bad = _v35L2_sw_bad + 1; }
            } elif (load64(&_v35L2_cw) == 1 && _v35L2_same(&_v35L2_cw, &_v35L2_open + _v35L2_c * 48) == 1) {
                if (_v35L2_same(&_v35L2_pw, &_v35L2_open + _v35L2_c * 48) == 0) { _v35L2_sw_bad = _v35L2_sw_bad + 1; }
            } else {
                _v35L2_sw_bad = _v35L2_sw_bad + 1;
            }
            _v35L2_kk = _v35L2_kk + 1;
        }
    }
}
assert_eq(_v35L2_sw_ends, 2 * _v35L2_NC - 5, "the sweep reached every case's open answer in its modes");
assert_eq(_v35L2_sw_bad, 0, "every refusal point: Err(HSB_ERR_ALLOC) and the plain 0, or the open answer bit for bit");
assert_eq(_v35L2_sw_err > 1000, 1, "the sweep's refusal points answered Err more than 1,000 times");

# ================================================================
test_group("3.5.0 L2: triangulate_polygon / delaunay_2d -- a refused working vec is 0, never a mesh (REV-AL N4)");
# The empty vec is an answer for both (no ear, fewer than 3 points, a collinear set), so a
# refused allocation must not read as one. Each allocation of the call refused in turn, once and
# from there on, under the counting allocator above: every answer is 0 or the open heap's list.
# Re-verified on this tree: both already answer 0 (lanes CO2 and CO4, 3.4.1).
var _v35L2_tp = vec_new();
for (var _v35L2_i = 0; _v35L2_i < 20; _v35L2_i = _v35L2_i + 1) {
    # a 20-point star, radii alternating 2 and 1 (concave: ten reflex vertices)
    var _v35L2_ang = f64_div(f64_mul(f64_from(_v35L2_i), 0x401921FB54442D18), f64_from(20));
    var _v35L2_rad = F64_TWO;
    if ((_v35L2_i & 1) == 1) { _v35L2_rad = F64_ONE; }
    vec_push(_v35L2_tp, hvec2_new(f64_mul(_v35L2_rad, f64_cos(_v35L2_ang)), f64_mul(_v35L2_rad, f64_sin(_v35L2_ang))));
}
var _v35L2_dp = vec_new();
for (var _v35L2_i = 0; _v35L2_i < 20; _v35L2_i = _v35L2_i + 1) {
    vec_push(_v35L2_dp, hvec2_new(f64_from(_v35L2_i * _v35L2_i % 17), f64_from(_v35L2_i * 7 % 13)));
}
fn _v35L2_same_vec(a, b) {
    if (a == 0 || b == 0) { return 0; }
    if (vec_len(a) != vec_len(b)) { return 0; }
    for (var i = 0; i < vec_len(a); i = i + 1) { if (vec_get(a, i) != vec_get(b, i)) { return 0; } }
    return 1;
}
fn _v35L2_mesh(w) {
    if (w == 0) { return triangulate_polygon(_v35L2_tp, 20); }
    return delaunay_2d(_v35L2_dp, 20);
}
var _v35L2_tri_open = _v35L2_mesh(0);
var _v35L2_del_open = _v35L2_mesh(1);
assert_eq(vec_len(_v35L2_tri_open), 54, "triangulate_polygon: the star's open answer is complete, 3(n - 2) indices");
assert_eq(vec_len(_v35L2_del_open) > 0, 1, "delaunay_2d: the scattered sites' open answer has triangles");
var _v35L2_tm_bad = 0;
var _v35L2_tm_zero = 0;
var _v35L2_tm_ends = 0;
var _v35L2_tm_hitpts = 0;
for (var _v35L2_w = 0; _v35L2_w < 2; _v35L2_w = _v35L2_w + 1) {
    var _v35L2_mopen = _v35L2_tri_open;
    if (_v35L2_w == 1) { _v35L2_mopen = _v35L2_del_open; }
    for (var _v35L2_md = 0; _v35L2_md < 2; _v35L2_md = _v35L2_md + 1) {
        var _v35L2_kk = 1;
        var _v35L2_done = 0;
        while (_v35L2_done == 0 && _v35L2_kk < 100000) {
            arena_reset(_v35L2_ar);
            var _v35L2_pv = _v35L2_arm(_v35L2_kk, _v35L2_md);
            var _v35L2_res = _v35L2_mesh(_v35L2_w);
            var _v35L2_hit = _v35L2_hits;
            _v35L2_disarm(_v35L2_pv);
            if (_v35L2_hit == 0) {
                _v35L2_done = 1;
                _v35L2_tm_ends = _v35L2_tm_ends + 1;
            } else {
                _v35L2_tm_hitpts = _v35L2_tm_hitpts + 1;
            }
            if (_v35L2_res == 0) {
                _v35L2_tm_zero = _v35L2_tm_zero + 1;
            } elif (_v35L2_same_vec(_v35L2_res, _v35L2_mopen) == 0) {
                _v35L2_tm_bad = _v35L2_tm_bad + 1;
            }
            _v35L2_kk = _v35L2_kk + 1;
        }
    }
}
assert_eq(_v35L2_tm_ends, 4, "the sweep reached both meshes' open answers in both modes");
assert_eq(_v35L2_tm_bad, 0, "triangulate_polygon / delaunay_2d: no refusal point answered an empty or partial list");
assert_eq(_v35L2_tm_zero == _v35L2_tm_hitpts && _v35L2_tm_zero >= 100, 1,
  "triangulate_polygon / delaunay_2d: every one of the 100 refusal points answered 0");

# ================================================================

# ==================================================================================================
# 3.5.0 — linear algebra: condition number, eigen_power, cofactor normal matrix (linalg_ext, mat3)
# ==================================================================================================
# (Written as tests/v35_L3.tcyr; every global and fn below is prefixed _v35L3_.)

# A row-major n x n stdlib matrix from n^2 words.
fn _v35L3_mat(n, p) {
    var M = ganita_mat_new(n, n);
    for (var r = 0; r < n; r = r + 1) {
        for (var c = 0; c < n; c = c + 1) { ganita_mat_set(M, r, c, load64(p + (r * n + c) * 8)); }
    }
    return M;
}
fn _v35L3_m2(a, b, c, d) {
    var M = ganita_mat_new(2, 2);
    ganita_mat_set(M, 0, 0, a);  ganita_mat_set(M, 0, 1, b);
    ganita_mat_set(M, 1, 0, c);  ganita_mat_set(M, 1, 1, d);
    return M;
}

# === 3.5.0 L3: eigen_power's certificate, with an exponent for every entry ===
# Roadmap [3.5.0], "eigen_power: Ok on a wrong eigenvalue, because underflow reads as nilpotence"
# (R4-CERT N1) and "eigen_power's certificate reads A through a frame that flushes entries below
# 2^-1074 of max|A|" (LA F2, R2A n5). A block upper-bidiagonal chain: diagonal blocks
# l/4 [[2,1,1],[1,2,1],[1,1,2]] (eigenvalues l, l/4, l/4, exactly), coupling blocks all 2^c, so
# rho(A) = max l, the oracle.
fn _v35L3_chain(nb, c, l0, l1, l2) {
    var A = ganita_mat_new(3 * nb, 3 * nb);
    var ls: i64[3];
    store64(&ls, l0); store64(&ls + 8, l1); store64(&ls + 16, l2);
    for (var k = 0; k < nb; k = k + 1) {
        var l4 = f64_mul(load64(&ls + k * 8), 0x3FD0000000000000);   # l / 4
        for (var r = 0; r < 3; r = r + 1) {
            for (var cc = 0; cc < 3; cc = cc + 1) {
                var v = l4;
                if (r == cc) { v = f64_add(l4, l4); }
                ganita_mat_set(A, 3 * k + r, 3 * k + cc, v);
                if (k + 1 < nb) { ganita_mat_set(A, 3 * k + r, 3 * k + 3 + cc, (1023 + c) << 52); }
            }
        }
    }
    return A;
}
var _v35L3_ev = alloc(8);
var _v35L3_vv = alloc(16 * 8);
fn _v35L3_ep_val(A, n) {
    store64(_v35L3_ev, 0x7FF8000000000BAD);
    var t, e = eigen_power(A, n, 1000, _v35L3_ev, _v35L3_vv);
    if (is_ok(t) == 1) { return load64(_v35L3_ev); }
    return e;
}
test_group("3.5.0 L3: eigen_power's certificate keeps every entry's exponent");
# rho = 2 (the last block), the iteration's answer 1.9000000000059638 (the first block's l, its
# eigenvector holding none of the last block's 2^-2000 components)
var _v35L3_A9 = _v35L3_chain(3, 1000, 0x3FFE666666666666, 0x3FF8000000000000, 0x4000000000000000);
assert_eq(_v35L3_ep_val(_v35L3_A9, 9), HSB_ERR_NO_CONVERGENCE,
  "eigen_power: the 9 x 9 chain at 2^1000 -> NO_CONVERGENCE (3.4.2: Ok(3FFE66666666CF51), rho 2)");
# right answers whose certificate needs the squarings past the f64 frame's underflow: rho = the first
# block's l, answered within 1.7e-11 of it (the iteration's), certified through the wide squarings
assert_eq(_v35L3_ep_val(_v35L3_chain(3, 682, 0x3FF204F800000000, 0x3FF8298600000000, 0x3FF3C5FD00000000), 9),
  0x3FF8298600004049, "eigen_power: chain at 2^682, rho 3FF8298600000000 -> Ok, 3.7e-12 off (wide squarings)");
assert_eq(_v35L3_ep_val(_v35L3_chain(3, 144, 0x3FF13E9D00000000, 0x3FFFE93200000000, 0x3FFC7DFD00000000), 9),
  0x3FFFE93200011C4C, "eigen_power: chain at 2^144, rho 3FFFE93200000000 -> Ok, 1.6e-11 off (wide squarings)");
# The certificate itself (`_lext_gelfand`), on A = [[2^-200, 2^1023], [0, 2^-199]]: rho = 2^-199. For
# lam = 2^-200 with v = e_0 the frame B' has its diagonal 2^-1162 under its coupling, which the f64
# frame flushed: B' read as nilpotent and lam certified (3.4.2: 1). Formed wide from A it is refused,
# and the right lam = 2^-199 is certified (its eigenvector (1, 2^-1223) is e_0 in doubles).
var _v35L3_gT = alloc(4 * 8);
var _v35L3_gz = alloc(2 * 8);
var _v35L3_gs = alloc(2 * 8);
var _v35L3_gv = alloc(2 * 8);
store64(_v35L3_gv, F64_ONE);
store64(_v35L3_gv + 8, 0);
var _v35L3_Af = _v35L3_m2(0x3370000000000000, 0x7FE0000000000000, 0, 0x3380000000000000);
assert_eq(_lext_gelfand(_v35L3_Af, 2, 0x3370000000000000, _v35L3_gv, _v35L3_gT, _v35L3_gz, _v35L3_gs), 0,
  "_lext_gelfand: lam = 2^-200 under rho = 2^-199, frame past 2^1074 -> refused (3.4.2: certified)");
assert_eq(_lext_gelfand(_v35L3_Af, 2, 0x3380000000000000, _v35L3_gv, _v35L3_gT, _v35L3_gz, _v35L3_gs), 1,
  "_lext_gelfand: lam = 2^-199 = rho, the same frame -> certified (the wide frame)");
# The squarings (`_lext_gf_loop`, d = 0) on M = B' 2^-e0 with rho(B') = 2: refused either way, where the
# f64 squares lost the diagonal and read the rest as nilpotent (each 1 without its switch).
var _v35L3_gM = alloc(4 * 8);
# old -> new (3.5.0 W4): the certificate's helpers take its rounding bound R after M (0: M exact)
fn _v35L3_gloop(a, b, e0) {
    store64(_v35L3_gM, a); store64(_v35L3_gM + 8, b); store64(_v35L3_gM + 16, 0); store64(_v35L3_gM + 24, a);
    store64(_v35L3_gz, F64_ONE); store64(_v35L3_gz + 8, F64_ONE);
    return _lext_gf_loop(_v35L3_gM, 0, _v35L3_gT, 2, 0, 0, _v35L3_gz, _v35L3_gs, e0, 0x3F57A013FACA6C6B, 24);
}
assert_eq(_v35L3_gloop(0x1A70000000000000, 0x5F30000000000000, 601), 0,
  "_lext_gf_loop: [[2^-600, 2^500], [0, 2^-600]] 2^601 -> refused (its square would flush the diagonal)");
assert_eq(_v35L3_gloop(0x39B0000000000000, 0x7E70000000000000, 101), 0,
  "_lext_gf_loop: [[2^-100, 2^1000], [0, 2^-100]] 2^101 -> refused (renormalising its square would flush it)");
assert_eq(_v35L3_gloop(0x39B0000000000000, 0x7E70000000000000, 99), 1,
  "_lext_gf_loop: the same at 2^99 (rho 1/2) -> certified");
# a nilpotent B' read wide: [[0, 2^-600, 0], [0, 0, 2^-600], [0, 0, 0]] 2^1000 (its square's 2^-1200
# kept, the next square exactly 0)
var _v35L3_n3M = alloc(9 * 8);
var _v35L3_n3T = alloc(9 * 8);
var _v35L3_n3z = alloc(3 * 8);
var _v35L3_n3s = alloc(3 * 8);
store64(_v35L3_n3M + 8, 0x1A70000000000000);
store64(_v35L3_n3M + 40, 0x1A70000000000000);
store64(_v35L3_n3z, F64_ONE); store64(_v35L3_n3z + 8, F64_ONE); store64(_v35L3_n3z + 16, F64_ONE);
# old -> new (3.5.0 W4): the certificate's helpers take its rounding bound R after M (0: M exact)
assert_eq(_lext_gf_loop(_v35L3_n3M, 0, _v35L3_n3T, 3, 0, 0, _v35L3_n3z, _v35L3_n3s, 1000, 0x3F57A013FACA6C6B, 24), 1,
  "_lext_gf_loop: a nilpotent 3 x 3 at 2^-600 2^1000, read wide -> certified (rho 0)");
# `_lext_gf_risk`: a product of two non-zero entries below 2^-1022 possible, on the boundary
fn _v35L3_risk1(x) {
    store64(_v35L3_gM, x);
    return _lext_gf_risk(_v35L3_gM, 1);
}
assert_eq(_v35L3_risk1(0x2000000000000000), 0, "_lext_gf_risk: [2^-511] (its square 2^-1022, normal) -> 0");
assert_eq(_v35L3_risk1(0x1FFFFFFFFFFFFFFF), 1, "_lext_gf_risk: [2^-511 - ulp] (square below 2^-1022) -> 1");
assert_eq(_v35L3_risk1(1), 1, "_lext_gf_risk: [2^-1074] -> 1");
assert_eq(_v35L3_risk1(0), 0, "_lext_gf_risk: [0] -> 0");
store64(_v35L3_gM, F64_ONE); store64(_v35L3_gM + 8, 0x1A70000000000000);
store64(_v35L3_gM + 16, 0x20B0000000000000); store64(_v35L3_gM + 24, F64_ONE);
assert_eq(_lext_gf_risk(_v35L3_gM, 2), 1, "_lext_gf_risk: m10 m01 = 2^-500 2^-600 -> 1");
store64(_v35L3_gM + 8, 0x2010000000000000);
assert_eq(_lext_gf_risk(_v35L3_gM, 2), 0, "_lext_gf_risk: m10 m01 = 2^-500 2^-510 -> 0");
# ... and on the boundary itself, which a 1 x 1 cannot reach (its exponent sum is even): [[0, 2^-511],
# [2^-512, 0]] squares to a product 2^-1023, below DBL_MIN; [[0, 2^-511], [2^-511, 0]] to 2^-1022
store64(_v35L3_gM, 0); store64(_v35L3_gM + 8, 0x2000000000000000);
store64(_v35L3_gM + 16, 0x1FF0000000000000); store64(_v35L3_gM + 24, 0);
assert_eq(_lext_gf_risk(_v35L3_gM, 2), 1, "_lext_gf_risk: m01 m10 = 2^-511 2^-512 = 2^-1023 -> 1");
store64(_v35L3_gM + 16, 0x2000000000000000);
assert_eq(_lext_gf_risk(_v35L3_gM, 2), 0, "_lext_gf_risk: m01 m10 = 2^-511 2^-511 = 2^-1022 -> 0");
# a subnormal entry counts at 2^-1074, in its column and in its row
store64(_v35L3_gM, F64_ONE); store64(_v35L3_gM + 8, 0); store64(_v35L3_gM + 16, 1); store64(_v35L3_gM + 24, 0);
assert_eq(_lext_gf_risk(_v35L3_gM, 2), 1, "_lext_gf_risk: [[1, 0], [2^-1074, 0]] -> 1 (column 0)");
store64(_v35L3_gM + 8, 1); store64(_v35L3_gM + 16, 0);
assert_eq(_lext_gf_risk(_v35L3_gM, 2), 1, "_lext_gf_risk: [[1, 2^-1074], [0, 0]] -> 1 (row 0)");
# the wide squarings' two bounds: rho(B') = 2 carried by row 1 alone (row 0 at 2^-600), refused; and
# a symmetric rank-1 block (u u^T, u = (0.6, 0.8): row sum 1.12, Frobenius 1) beside 2^-600, certified
# in 6 squarings by the Frobenius bound (the row sums alone need 7)
var _v35L3_w3M = alloc(9 * 8);
# old -> new (3.5.0 W4): the certificate's helpers take its rounding bound R after M (0: M exact)
fn _v35L3_w3(a00, a01, a10, a11, kmax) {
    for (var q = 0; q < 9; q = q + 1) { store64(_v35L3_w3M + q * 8, 0); }
    store64(_v35L3_w3M, a00); store64(_v35L3_w3M + 8, a01); store64(_v35L3_w3M + 24, a10);
    store64(_v35L3_w3M + 32, a11); store64(_v35L3_w3M + 64, 0x1A70000000000000);
    store64(_v35L3_n3z, F64_ONE); store64(_v35L3_n3z + 8, F64_ONE); store64(_v35L3_n3z + 16, F64_ONE);
    return _lext_gf_loop(_v35L3_w3M, 0, _v35L3_n3T, 3, 0, 0, _v35L3_n3z, _v35L3_n3s, 0, 0x3F57A013FACA6C6B, kmax);
}
assert_eq(_v35L3_w3(0x1A70000000000000, 0, 0, 0x4000000000000000, 24), 0,
  "_lext_gf_loop: diag(2^-600, 2, 2^-600), wide -> refused (rho 2 in row 1)");
assert_eq(_v35L3_w3(0x3FD70A3D70A3D70A, 0x3FDEB851EB851EB8, 0x3FDEB851EB851EB8, 0x3FE47AE147AE147B, 6), 1,
  "_lext_gf_loop: [[0.36, 0.48], [0.48, 0.64]] (+) [2^-600], wide, 6 squarings -> certified");
# `_lext_gfw_sq` keeps a term far below its entry's largest: after an exact cancellation it is the
# whole entry. M = [[1, 1, x], [-1, 0, 0], [x, 0, 0]] wide (each m 1/2): T_00 = 1 - 1 + x^2. With x =
# 2^-30 the term sits 2^-60 under the largest (T_00 = 2^-60, m 1/2, e -59); with x = 2^-525, 2^-1050
# under it, a subnormal at the sum's scale (T_00 = 2^-1050, e -1049)
var _v35L3_wm = alloc(9 * 8);
var _v35L3_we = alloc(9 * 8);
var _v35L3_tm = alloc(9 * 8);
var _v35L3_te = alloc(9 * 8);
fn _v35L3_wsq(ex) {
    for (var q = 0; q < 9; q = q + 1) { store64(_v35L3_wm + q * 8, 0); store64(_v35L3_we + q * 8, 0); }
    store64(_v35L3_wm, F64_HALF); store64(_v35L3_we, 1);
    store64(_v35L3_wm + 8, F64_HALF); store64(_v35L3_we + 8, 1);
    store64(_v35L3_wm + 24, 0xBFE0000000000000); store64(_v35L3_we + 24, 1);
    store64(_v35L3_wm + 16, F64_HALF); store64(_v35L3_we + 16, ex);
    store64(_v35L3_wm + 48, F64_HALF); store64(_v35L3_we + 48, ex);
    _lext_gfw_sq(_v35L3_wm, _v35L3_we, _v35L3_tm, _v35L3_te, 3);
    return 0;
}
_v35L3_wsq(0 - 29);
assert_eq(load64(_v35L3_tm), F64_HALF, "_lext_gfw_sq: 1 - 1 + 2^-60 -> m 1/2 (the small term kept)");
assert_eq(load64(_v35L3_te), 0 - 59, "_lext_gfw_sq: 1 - 1 + 2^-60 -> e -59");
_v35L3_wsq(0 - 524);
assert_eq(load64(_v35L3_tm), F64_HALF, "_lext_gfw_sq: 1 - 1 + 2^-1050 -> m 1/2 (kept, subnormal at the sum's scale)");
assert_eq(load64(_v35L3_te), 0 - 1049, "_lext_gfw_sq: 1 - 1 + 2^-1050 -> e -1049");
# `_lext_lowest`
store64(_v35L3_gM, 0); store64(_v35L3_gM + 8, 0x3FA0000000000000);
store64(_v35L3_gM + 16, 0xC008000000000000); store64(_v35L3_gM + 24, 3);
assert_eq(_lext_lowest(_v35L3_gM, 4), 0 - 1074, "_lext_lowest: (0, 2^-5, -3, 3 2^-1074) -> -1074");
assert_eq(_lext_lowest(_v35L3_gM, 3), 0 - 5, "_lext_lowest: (0, 2^-5, -3) -> -5");
assert_eq(_lext_lowest(_v35L3_gM, 1), 1 << 40, "_lext_lowest: (0) -> 2^40");
# `_lext_deflate` declines (M untouched) where M_rc x_c can fall below DBL_MIN: x = (1, 2^-10) against
# M_01 = 2^-1020 (1 + 2^-52) (3.4.2 deflated, M_10 = 1/4 - 2^-11)
var _v35L3_dM = alloc(9 * 8);
var _v35L3_dv = alloc(3 * 8);
var _v35L3_dd = alloc(3 * 8);
var _v35L3_dy = alloc(9 * 8);
store64(_v35L3_dM, F64_ONE); store64(_v35L3_dM + 8, 0x0030000000000001);
store64(_v35L3_dM + 16, 0x3FD0000000000000); store64(_v35L3_dM + 24, F64_HALF);
store64(_v35L3_dv, F64_ONE); store64(_v35L3_dv + 8, 0x3F50000000000000);
store64(_v35L3_dd, F64_ONE); store64(_v35L3_dd + 8, F64_ONE);
# old -> new (3.5.0 W4): `_lext_deflate` takes the rounding bound R last (0: none)
assert_eq(_lext_deflate(_v35L3_dM, 2, _v35L3_dv, F64_ONE, _v35L3_dd, _v35L3_dy, 0), 0,
  "_lext_deflate: M_01 x_1 = 2^-1030 (1 + 2^-52) -> declined (3.4.2: deflated)");
assert_eq(load64(_v35L3_dM + 16), 0x3FD0000000000000, "_lext_deflate: declined, M untouched (3.4.2: 1/4 - 2^-11)");
# M_rc x_c below DBL_MIN where no x_r M_pc is: x = (1, 2^-500), M_11 = 2^-600 (3.4.2 deflated, M_11 =
# 2^-600 - 2^-501)
store64(_v35L3_dM, F64_ONE); store64(_v35L3_dM + 8, F64_HALF);
store64(_v35L3_dM + 16, 0x3FD0000000000000); store64(_v35L3_dM + 24, 0x1A70000000000000);
store64(_v35L3_dv, F64_ONE); store64(_v35L3_dv + 8, 0x20B0000000000000);
assert_eq(_lext_deflate(_v35L3_dM, 2, _v35L3_dv, F64_ONE, _v35L3_dd, _v35L3_dy, 0), 0,
  "_lext_deflate: M_11 x_1 = 2^-1100 -> declined");
assert_eq(load64(_v35L3_dM + 24), 0x1A70000000000000, "_lext_deflate: declined, M_11 untouched");
# and deflated where nothing can: x = e_0 beside a subnormal M_01 (x_1 = 0: no product with it), and
# x = (1, 2^-30) beside M_00 = 2^-1000 (replaced by y_p, in no product x_r M_pc)
store64(_v35L3_dM, F64_ONE); store64(_v35L3_dM + 8, 3);
store64(_v35L3_dM + 16, 0); store64(_v35L3_dM + 24, F64_HALF);
store64(_v35L3_dv, F64_ONE); store64(_v35L3_dv + 8, 0);
assert_eq(_lext_deflate(_v35L3_dM, 2, _v35L3_dv, F64_ONE, _v35L3_dd, _v35L3_dy, 0), 1,
  "_lext_deflate: x = e_0, M_01 = 3 2^-1074 -> deflated");
store64(_v35L3_dM, 0x0170000000000000); store64(_v35L3_dM + 8, F64_HALF);
store64(_v35L3_dM + 16, 0x3FD0000000000000); store64(_v35L3_dM + 24, F64_HALF);
store64(_v35L3_dv, F64_ONE); store64(_v35L3_dv + 8, 0x3E10000000000000);
assert_eq(_lext_deflate(_v35L3_dM, 2, _v35L3_dv, F64_ONE, _v35L3_dd, _v35L3_dy, 0), 1,
  "_lext_deflate: M_00 = 2^-1000, x_1 = 2^-30 -> deflated");
# x_r M_pc below DBL_MIN where no M_rc x_c is: x = (1, 2^-500, 1), M_02 = 2^-600 (3.4.2 deflated,
# M_21 = 1/4 - 1/2)
store64(_v35L3_dM, F64_ONE); store64(_v35L3_dM + 8, F64_HALF); store64(_v35L3_dM + 16, 0x1A70000000000000);
store64(_v35L3_dM + 24, 0x3FD0000000000000); store64(_v35L3_dM + 32, F64_HALF);
store64(_v35L3_dM + 40, 0x3FD0000000000000); store64(_v35L3_dM + 48, 0x3FD0000000000000);
store64(_v35L3_dM + 56, 0x3FD0000000000000); store64(_v35L3_dM + 64, F64_HALF);
store64(_v35L3_dv, F64_ONE); store64(_v35L3_dv + 8, 0x20B0000000000000); store64(_v35L3_dv + 16, F64_ONE);
store64(_v35L3_dd + 16, F64_ONE);
assert_eq(_lext_deflate(_v35L3_dM, 3, _v35L3_dv, F64_ONE, _v35L3_dd, _v35L3_dy, 0), 0,
  "_lext_deflate: x_1 M_02 = 2^-1100 -> declined");
assert_eq(load64(_v35L3_dM + 56), 0x3FD0000000000000, "_lext_deflate: declined, M_21 untouched (3.4.2: -1/4)");
# x_1 y_p below DBL_MIN where every M_rc x_c is not: x = (1, 2^-30), M row 0 = (2^-992 (1 + 2^-52),
# -2^-962), so y_p = 2^-1044 by an exact cancellation and x_1 y_p = 2^-1074
store64(_v35L3_dM, 0x01F0000000000001); store64(_v35L3_dM + 8, 0x83D0000000000000);
store64(_v35L3_dM + 16, 0x01F0000000000000); store64(_v35L3_dM + 24, 0x01F0000000000000);
store64(_v35L3_dv, F64_ONE); store64(_v35L3_dv + 8, 0x3E10000000000000);
assert_eq(_lext_deflate(_v35L3_dM, 2, _v35L3_dv, F64_ONE, _v35L3_dd, _v35L3_dy, 0), 0,
  "_lext_deflate: y_p = 2^-1044 against x_1 = 2^-30 -> declined");
assert_eq(load64(_v35L3_dM + 8), 0x83D0000000000000, "_lext_deflate: declined there too, M untouched");
# the balancing power of two stops where a non-zero entry of row p would fall below DBL_MIN:
# M = [[1, 1/2, 2^-200], [0, 1/4, 0], [0, 0, 1/8]], v = e_0 (exact: the residual column is 0)
store64(_v35L3_dM, F64_ONE); store64(_v35L3_dM + 8, F64_HALF); store64(_v35L3_dM + 16, 0x3370000000000000);
store64(_v35L3_dM + 24, 0); store64(_v35L3_dM + 32, 0x3FD0000000000000); store64(_v35L3_dM + 40, 0);
store64(_v35L3_dM + 48, 0); store64(_v35L3_dM + 56, 0); store64(_v35L3_dM + 64, 0x3FC0000000000000);
store64(_v35L3_dv, F64_ONE); store64(_v35L3_dv + 8, 0); store64(_v35L3_dv + 16, 0);
store64(_v35L3_dd, F64_ONE); store64(_v35L3_dd + 8, F64_ONE); store64(_v35L3_dd + 16, F64_ONE);
assert_eq(_lext_deflate(_v35L3_dM, 3, _v35L3_dv, F64_ONE, _v35L3_dd, _v35L3_dy, 0), 1,
  "_lext_deflate: e_0 -> deflated");
assert_eq(load64(_v35L3_dM + 16), 0x0010000000000000,
  "_lext_deflate: row p's 2^-200 scaled to 2^-1022, not past it (3.4.2: 2^-900 more, flushed to 0)");
assert_eq(load64(_v35L3_dM + 8), 0x0C80000000000000, "_lext_deflate: row p's 1/2 scaled by the same 2^-822");

# === 3.5.0 L3: matrix_condition_number past cond = 1/u, and its 1 x 1 ===
# Roadmap [3.5.0], "matrix_condition_number / cmat_inverse past cond ~ 2^53" (LA F2) and
# "matrix_condition_number([2147483629]) = 3FEFFFFFFFFFFFFF" (LA F3). Oracle: Python Fractions,
# ||A||_F^2 ||A^-1||_F^2 exactly, its square root correctly rounded (80-digit Decimal, then the
# neighbours compared exactly).
test_group("3.5.0 L3: matrix_condition_number past cond = 1/u, exactly; its 1 x 1");
fn _v35L3_cn(n, p) { return matrix_condition_number(_v35L3_mat(n, p)); }
var _v35L3_cb = alloc(49 * 8);
fn _v35L3_put(i, x) { store64(_v35L3_cb + i * 8, x); return 0; }
# a pivot the elimination loses (det -2^-104): 3.4.2 answered -1
assert_eq(matrix_condition_number(_v35L3_m2(F64_ONE, 0x3FF0000000000001, 0x3FF0000000000001, 0x3FF0000000000002)),
  0x4690000000000002, "cond: [[1, 1 + u], [1 + u, 1 + 2u]] -> 2^106 (1 + 2^-51), correctly rounded (3.4.2: -1)");
assert_eq(matrix_condition_number(_v35L3_m2(0x4330000000000000, 0x4330000000000001, 0x432FFFFFFFFFFFFE,
      0x4330000000000000)),
  0x4690000000000000, "cond: [[2^52, 2^52 + 1], [2^52 - 1, 2^52]] (det 1) -> 2^106, exactly (3.4.2: -1)");
assert_eq(matrix_condition_number(_v35L3_m2(0xC022000000000000, 0x4000000000000000, 0xC03B000000000000,
      0x4018000000000001)),
  0x43779C71C71C71C7, "cond: [[-9, 2], [-27, 6 + 4u]] -> correctly rounded (3.4.2: -1)");
assert_eq(matrix_condition_number(_v35L3_m2(0x2660000000000001, 0x2667FFFFFFFFFFFD, 0x2658000000000001,
      0x2661FFFFFFFFFFFE)),
  0x43603FFFFFFFFFFF, "cond: a rank-1-plus-ulps 2 x 2 at 2^-410 -> correctly rounded (3.4.2: -1)");
assert_eq(matrix_condition_number(_v35L3_m2(0xC010000000000000, 0, 0xC010000000000000, 1)), F64_POS_INF,
  "cond: [[-4, 0], [-4, 2^-1074]] -> +Inf (exact 2^1077-ish, past DBL_MAX; 3.4.2: -1)");
_v35L3_put(0, 0x401C000000000000); _v35L3_put(1, 0xC018000000000000); _v35L3_put(2, 0xC008000000000000);
_v35L3_put(3, 0xC022000000000000); _v35L3_put(4, 0xC020000000000000); _v35L3_put(5, 0x3FF0000000000000);
_v35L3_put(6, 0x4043800000000000); _v35L3_put(7, 0xC000000000000000); _v35L3_put(8, 0xC025FFFFFFFFFFFF);
# old -> new (3.5.0 W4): ...FFEF -> ...FFEE (the exact tier's sum in double-doubles: correctly rounded)
assert_eq(_v35L3_cn(3, _v35L3_cb), 0x43755FFB0D0CFFEE,
  "cond: a lost-pivot integer 3 x 3 -> correctly rounded (3.4.2: -1)");
_v35L3_put(0, 0xC000000000000000); _v35L3_put(1, 0x4022000000000000); _v35L3_put(2, 0xC020000000000000);
_v35L3_put(3, 0xC020000000000000); _v35L3_put(4, 0xC022000000000000); _v35L3_put(5, 0);
_v35L3_put(6, 0xC03BFFFFFFFFFFFF); _v35L3_put(7, 0xC022000000000000); _v35L3_put(8, 0xC030000000000000);
assert_eq(_v35L3_cn(3, _v35L3_cb), 0x43701B64516F71CF,
  "cond: a lost-pivot 3 x 3 with a zero -> correctly rounded (3.4.2: -1)");
var _v35L3_c5: i64[25];
fn _v35L3_c5_fill() {
    store64(&_v35L3_c5 + 0, 0xC67332DD330907F1); store64(&_v35L3_c5 + 8, 0x28BBB2313E0ED67C);
    store64(&_v35L3_c5 + 16, 0x33578E4B9884B280); store64(&_v35L3_c5 + 24, 0x553727D8359DFC54);
    store64(&_v35L3_c5 + 32, 0xD517CDC97A4EF6F1); store64(&_v35L3_c5 + 40, 0x3E4F47AEBDF2F3A0);
    store64(&_v35L3_c5 + 48, 0xB573870380344DF1); store64(&_v35L3_c5 + 56, 0x340325B55CACEBED);
    store64(&_v35L3_c5 + 64, 0x4DF9FC2D0BF8728E); store64(&_v35L3_c5 + 72, 0xCDDAB66528B97D53);
    store64(&_v35L3_c5 + 80, 0xD0B7ABEC53D1828E); store64(&_v35L3_c5 + 88, 0x2C5CCB573D4948BE);
    store64(&_v35L3_c5 + 96, 0xD47E8E7278C6EE28); store64(&_v35L3_c5 + 104, 0xB257A605A9C72C73);
    store64(&_v35L3_c5 + 112, 0xD46E59D6C468340A); store64(&_v35L3_c5 + 120, 0x3C3CA04C79458D1C);
    store64(&_v35L3_c5 + 128, 0xD52CD02C5FE46FC8); store64(&_v35L3_c5 + 136, 0x5687691B06CD8292);
    store64(&_v35L3_c5 + 144, 0xB1DB98C67C515594); store64(&_v35L3_c5 + 152, 0x567740CD321592FA);
    store64(&_v35L3_c5 + 160, 0xCCB070D7104D63A0); store64(&_v35L3_c5 + 168, 0x304CE76E9F4FCCA5);
    store64(&_v35L3_c5 + 176, 0x3D5A842BC1DFFBBE); store64(&_v35L3_c5 + 184, 0xAF58C74FC118B8E2);
    store64(&_v35L3_c5 + 192, 0x4CD0ACC94DAFB58D);
    return 0;
}
_v35L3_c5_fill();
assert_eq(_v35L3_cn(5, &_v35L3_c5), 0x4C15A2AE98F39B64,
  "cond: 5 x 5, entries 2^+-400, last column a rounded combination of the others -> correctly rounded");
var _v35L3_c7: i64[49];
fn _v35L3_c7_fill() {
    store64(&_v35L3_c7 + 0, 0x36367FD5494FDE9E); store64(&_v35L3_c7 + 8, 0x51B7BB1D131D5945);
    store64(&_v35L3_c7 + 16, 0x5011EA772255AC9A); store64(&_v35L3_c7 + 24, 0xC6F133E6146A6E44);
    store64(&_v35L3_c7 + 32, 0x43E8CE621E70A726); store64(&_v35L3_c7 + 40, 0x43BFF18FE384BC22);
