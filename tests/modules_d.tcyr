# Case p's answer from a child process: its exit status, or 100 + the signal that ended it.
fn _w2W8_iso(p) {
    var pid = sys_fork();
    if (pid == 0) {
        # PR_SET_DUMPABLE (4) = 0: a fault here leaves no core file. Only that is at stake, so its
        # answer is not read.
        var nd = sys_prctl(4, 0, 0, 0, 0);
        sys_exit_group(_w2W8_case(p));
    }
    var st: i64[1];
    sys_waitpid(pid, &st, 0);
    if ((load64(&st) & 0x7F) != 0) { return 100 + (load64(&st) & 0x7F); }
    return (load64(&st) >> 8) & 0xFF;
}
