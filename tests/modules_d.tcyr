_v35L3_c7_fill();
# old -> new (3.5.0 W4): ...8B18 -> ...8B15 (certified extended precision, `_lext_inv_hp`: correctly rounded)
assert_eq(_v35L3_cn(7, &_v35L3_c7), 0x59FB151212C88B15,
  "cond: the same at 7 x 7 -> correctly rounded (3.4.2: -1)");
# 1 x 1: |x| |1 / x| = 1 (3.4.2: p fl(1/p) for p = 2147483629, 1 ulp under)
var _v35L3_one = alloc(8);
store64(_v35L3_one, 0x41DFFFFFFB400000);
assert_eq(_v35L3_cn(1, _v35L3_one), F64_ONE, "cond: [2147483629] -> 1 (3.4.2: 3FEFFFFFFFFFFFFF)");
store64(_v35L3_one, 1);
assert_eq(_v35L3_cn(1, _v35L3_one), F64_ONE, "cond: [2^-1074] -> 1");
store64(_v35L3_one, 0x8000000000000000);
assert_eq(_v35L3_cn(1, _v35L3_one), 0xBFF0000000000000, "cond: [-0] -> -1 (singular)");
# cond_F >= n: a rotation is exactly 2 (3.4.2 rounded under it on 62 of 2,000 angles)
# [measured: scratch_L3 rot.tcyr (angles 0.001 k, k = 1..2000), base and this tree, 2026-11-14]
assert_eq(matrix_condition_number(_v35L3_m2(0x3FEFFFAB10DFF4E7, 0xBF826E873E9EE5ED, 0x3F826E873E9EE5ED,
      0x3FEFFFAB10DFF4E7)), 0x4000000000000000, "cond: a rotation at 0.009 rad -> 2 (3.4.2: 3FFFFFFFFFFFFFFE)");
# matrix_condition_number_checked: the failures told apart
fn _v35L3_cnc(A) {
    var t, v = matrix_condition_number_checked(A);
    if (is_ok(t) == 1) { return v; }
    return 0x7FF8000000000000 + (0 - v);   # a NaN that carries the code
}
assert_eq(_v35L3_cnc(_v35L3_m2(F64_ONE, 0x3FF0000000000001, 0x3FF0000000000001, 0x3FF0000000000002)),
  0x4690000000000002, "cond_checked: the lost pivot -> Ok(2^106 (1 + 2^-51))");
assert_eq(_v35L3_cnc(_v35L3_m2(0x3D3C25C268497682, 0, 0, F64_ONE)), 0x42A2309CE5400000,
  "cond_checked: diag(1e-13, 1) -> Ok(1e13), as matrix_condition_number");
assert_eq(_v35L3_cnc(0), 0x7FF8000000000000 + 10, "cond_checked: null -> Err(INVALID_INPUT)");
assert_eq(_v35L3_cnc(ganita_mat_new(2, 3)), 0x7FF8000000000000 + 10, "cond_checked: 2 x 3 -> Err(INVALID_INPUT)");
assert_eq(_v35L3_cnc(_v35L3_m2(F64_ONE, 0, 0, 0x7FF8000000000000)), 0x7FF8000000000000 + 10,
  "cond_checked: a NaN entry -> Err(INVALID_INPUT)");
assert_eq(_v35L3_cnc(_v35L3_m2(F64_ONE, 0x4000000000000000, 0x4000000000000000, 0x4010000000000000)),
  0x7FF8000000000000 + 2, "cond_checked: [[1, 2], [2, 4]] -> Err(SINGULAR_MATRIX)");
store64(_v35L3_one, 0);
assert_eq(_v35L3_cnc(_v35L3_mat(1, _v35L3_one)), 0x7FF8000000000000 + 2, "cond_checked: [0] -> Err(SINGULAR_MATRIX)");
# `_lext_bn_divx`: q y / y = q, for y even and odd, signs mixed, across limbs
var _v35L3_bx = alloc(64 * 8);
var _v35L3_by = alloc(64 * 8);
var _v35L3_bq = alloc(64 * 8);
var _v35L3_bp = alloc(64 * 8);
var _v35L3_bo = alloc(64 * 8);
var _v35L3_bw = alloc(200 * 8);
fn _v35L3_bneq(a, b) {   # 0 when the two integers are equal
    if (load64(a) != load64(b) || load64(a + 8) != load64(b + 8)) { return 1; }
    for (var i = 0; i < load64(a + 8); i = i + 1) {
        if (load64(a + 16 + i * 8) != load64(b + 16 + i * 8)) { return 1; }
    }
    return 0;
}
fn _v35L3_divchk(qm, qs, ym, ys) {
    _lext_bn_set(_v35L3_bq, qm, qs);
    _lext_bn_set(_v35L3_by, ym, ys);
    _lext_bn_mul(_v35L3_bq, _v35L3_by, _v35L3_bx);
    _lext_bn_mul(_v35L3_bx, _v35L3_bx, _v35L3_bp);   # a wide dividend: (q y)^2 / y = q^2 y
    _lext_bn_divx(_v35L3_bp, _v35L3_by, _v35L3_bo, _v35L3_bw);
    _lext_bn_mul(_v35L3_bq, _v35L3_bx, _v35L3_by);   # q (q y)
    return _v35L3_bneq(_v35L3_bo, _v35L3_by);
}
assert_eq(_v35L3_divchk(0x1F_FFFF_FFFF_FFFF, 0, 0x1F_FFFF_FFFF_FFFD, 0), 0,
  "_lext_bn_divx: odd divisor, 53-bit factors");
assert_eq(_v35L3_divchk(0x12345678ABCDEF1, 77, 0x3B9ACA07, 31), 0, "_lext_bn_divx: an even divisor (2^31 x odd)");
assert_eq(_v35L3_divchk(0 - 0x76543210FEDCBA9, 5, 0x40000001, 0), 0, "_lext_bn_divx: a negative quotient");
assert_eq(_v35L3_divchk(0x3FFFFFFF, 300, 0 - 0x3FFFFFFF, 290), 0, "_lext_bn_divx: limbs of all ones, both shifted");
assert_eq(_v35L3_divchk(1, 0, 0x3FFF_FFFF_FFFF_FFFF, 0), 0, "_lext_bn_divx: a 62-bit divisor, quotient its own");
_lext_bn_set(_v35L3_bp, 0, 0);
_lext_bn_set(_v35L3_by, 7, 0);
_lext_bn_divx(_v35L3_bp, _v35L3_by, _v35L3_bo, _v35L3_bw);
assert_eq(load64(_v35L3_bo + 8), 0, "_lext_bn_divx: 0 / 7 -> 0");

# `_lext_inv_frob_exact` through a zero leading entry (a row swap): [[0, 2], [3, 0]], ||A^-1||_F =
# sqrt(1/4 + 1/9) = sqrt(13) / 6 = 0.6009252125773316 (m, e = that, 0)
var _v35L3_ie: i64[2];
store64(_v35L3_cb, 0); store64(_v35L3_cb + 8, 0x4000000000000000);
store64(_v35L3_cb + 16, 0x4008000000000000); store64(_v35L3_cb + 24, 0);
assert_eq(_lext_inv_frob_exact(_v35L3_cb, 2, &_v35L3_ie), 0, "_lext_inv_frob_exact: [[0, 2], [3, 0]] -> 0");
assert_eq(load64(&_v35L3_ie), 0x3FE33AC782EB914D, "_lext_inv_frob_exact: its m, sqrt(13) / 6 correctly rounded");
assert_eq(load64(&_v35L3_ie + 8), 0, "_lext_inv_frob_exact: its e");

# ... and on the Sylvester-Hadamard 64 x 64 (+-1), whose determinant 2^192 meets Hadamard's bound: the
# integers reach the capacity that bound sizes. H^-1 = H^T / 64, ||H^-1||_F = 1 (m, e = 1/2, 1).
var _v35L3_H64 = alloc(64 * 64 * 8);
for (var _v35L3_hr = 0; _v35L3_hr < 64; _v35L3_hr = _v35L3_hr + 1) {
    for (var _v35L3_hc = 0; _v35L3_hc < 64; _v35L3_hc = _v35L3_hc + 1) {
        var _v35L3_hb = _v35L3_hr & _v35L3_hc;
        var _v35L3_hp = 0;
        while (_v35L3_hb != 0) { _v35L3_hp = _v35L3_hp ^ (_v35L3_hb & 1); _v35L3_hb = _v35L3_hb >> 1; }
        var _v35L3_hx = F64_ONE;
        if (_v35L3_hp == 1) { _v35L3_hx = 0xBFF0000000000000; }
        store64(_v35L3_H64 + (_v35L3_hr * 64 + _v35L3_hc) * 8, _v35L3_hx);
    }
}
assert_eq(_lext_inv_frob_exact(_v35L3_H64, 64, &_v35L3_ie), 0, "_lext_inv_frob_exact: Hadamard 64 -> 0");
assert_eq(load64(&_v35L3_ie), F64_HALF, "_lext_inv_frob_exact: Hadamard 64, m = 1/2");
assert_eq(load64(&_v35L3_ie + 8), 1, "_lext_inv_frob_exact: Hadamard 64, e = 1 (||H^-1||_F = 1)");

# === 3.5.0 L3: m3_normal_matrix_cof past 2^997 - 2^970 keeps the compensated tier's certificate ===
# Roadmap [3.5.0], "m3_normal_matrix_cof's cliff at 2^997 - 2^970" (R3-MAT N3). A near-rank-1 m whose
# row 0 lies in [2^997, 2^998): 3.4.2's wide tier declined it (the bracket could not pin an entry) and
# the exact path answered; the certificate `_m3_cof_comp` takes below the threshold keeps it now.
# The answer is the same bits (the exact cofactors' nearest), and its twin with row 0 halved, below
# the threshold, is the same answer scaled: rows 1 and 2 of the cofactor matrix halve.
test_group("3.5.0 L3: m3_normal_matrix_cof's cliff at 2^997 - 2^970");
fn _v35L3_m3(a0, a1, a2, a3, a4, a5, a6, a7, a8) {
    var m = m3_new();
    store64(m, a0); store64(m + 8, a1); store64(m + 16, a2); store64(m + 24, a3); store64(m + 32, a4);
    store64(m + 40, a5); store64(m + 48, a6); store64(m + 56, a7); store64(m + 64, a8);
    return m;
}
fn _v35L3_m3eq(r, a0, a1, a2, a3, a4, a5, a6, a7, a8) {   # the number of entries of r not as given
    var e = _v35L3_m3(a0, a1, a2, a3, a4, a5, a6, a7, a8);
    var bad = 0;
    for (var i = 0; i < 9; i = i + 1) { if (load64(r + i * 8) != load64(e + i * 8)) { bad = bad + 1; } }
    return bad;
}
var _v35L3_mk = _v35L3_m3(0x7E3E228CDE83EF4D, 0x3FE0D123223CD675, 0x3FC9ED568A1B532C, 0x7E477A9A3A4DA4E4,
  0x3FEA347BE63F8817, 0x3FD43351A976802D, 0x7DD9C254389698C9, 0x3F7CBFFC6FDDB769, 0x3F6629899D2DFE91);
assert_eq(_m3_cof_wide(_v35L3_mk, 1, m3_new()), 1, "_m3_cof_wide: near rank 1, row 0 past 2^997 -> kept (3.4.2: 0)");
assert_eq(_v35L3_m3eq(m3_normal_matrix_cof(_v35L3_mk), 0xBCDED86C2C218FA3, 0x7B6CC167DE09064B, 0xFB8069294A5D5962,
    0x3CD5156291BAD7BC, 0xFB6297A37F223514, 0x7B750E433E910956, 0xBD02CB1210909E46, 0x7B602CD68BDCBDA7,
    0x7B2B862A8CE97808), 0, "m3_normal_matrix_cof: its answer, the exact path's bits (3.4.2's)");
var _v35L3_mh = _v35L3_m3(0x7E2E228CDE83EF4D, 0x3FE0D123223CD675, 0x3FC9ED568A1B532C, 0x7E377A9A3A4DA4E4,
  0x3FEA347BE63F8817, 0x3FD43351A976802D, 0x7DC9C254389698C9, 0x3F7CBFFC6FDDB769, 0x3F6629899D2DFE91);
assert_eq(_v35L3_m3eq(m3_normal_matrix_cof(_v35L3_mh), 0xBCDED86C2C218FA3, 0x7B5CC167DE09064B, 0xFB7069294A5D5962,
    0x3CD5156291BAD7BC, 0xFB5297A37F223514, 0x7B650E433E910956, 0xBD02CB1210909E46, 0x7B502CD68BDCBDA7,
    0x7B1B862A8CE97808), 0, "m3_normal_matrix_cof: the twin below the threshold, the same answer scaled");
var _v35L3_md = _v35L3_m3(0x7E48B49EA9CE5477, 0x3FEBAD5DADE46472, 0x3FB2771FA688FF6A, 0x7E42795B3AF93D08,
  0x3FE4B2380E9B724D, 0x3FAB9D987D27AA5B, 0x7E05E56F872ACAB9, 0x3FA887AD0C6B89C6, 0x3F705D97FEBF486C);
assert_eq(_m3_cof_wide(_v35L3_md, 1, m3_new()), 0, "_m3_cof_wide: minors cancelling past 2^54 of G -> declined");
assert_eq(_v35L3_m3eq(m3_normal_matrix_cof(_v35L3_md), 0xBC13D3DB6087B46A, 0x7A2A64B8EE7D6060, 0x7AA94AB89D3C4116,
    0x3C251BBC324AD5E4, 0xFA67A319F9607598, 0xFAB3626D288378A8, 0xBC4A7E8743FD4A7C, 0x7AA214E479D8DCA6,
    0x7AC0B101C628C1D8), 0, "m3_normal_matrix_cof: ... and answered by the exact path, as 3.4.2");

# The uniform pass on a matrix where only minor 0 cancels: F73 F71 - F72^2 = 1 (Fibonacci), so
# x11 x22 - x21 x12 = 2^500 against products near 2^598, every other minor exact and at most 2^450:
# its own G decides, past 2^54 of the largest entry, and the pass declines.
fn _v35L3_wu(m) {
    var kv: i64[10];
    for (var i = 0; i < 9; i = i + 1) { store64(&kv + i * 8, 0 - 28); }
    store64(&kv + 72, 0 - 84);
    return _m3_cof_wpass(m, 1, m3_new(), &kv);
}
var _v35L3_mf = _v35L3_m3(0x39B0000000000000, 0, 0, 0, 0x6246EC2C3ED37188, 0x42FC5575E509F600, 0, 0x623C5575E509F600,
  0x42F182E2989CED10);
assert_eq(_v35L3_wu(_v35L3_mf), 0, "_m3_cof_wpass: minor 0 alone cancels past 2^54 of the largest -> declined");
# ... and with that minor moved to every slot (columns 0 <-> C and rows 0 <-> R swapped): each slot's
# bracket line fails there, and the certificate declines
fn _v35L3_sw(i, k) {   # the swap 0 <-> k applied to the index i
    if (i == 0) { return k; }
    if (i == k) { return 0; }
    return i;
}
fn _v35L3_perm(src, C, R) {   # src with entries 0 <-> C of the first index and 0 <-> R of the second swapped
    var mp = m3_new();
    for (var q = 0; q < 9; q = q + 1) {
        store64(mp + (_v35L3_sw(q / 3, C) * 3 + _v35L3_sw(q % 3, R)) * 8, load64(src + q * 8));
    }
    return mp;
}
for (var _v35L3_C = 0; _v35L3_C < 3; _v35L3_C = _v35L3_C + 1) {
    for (var _v35L3_R = 0; _v35L3_R < 3; _v35L3_R = _v35L3_R + 1) {
        assert_eq(_v35L3_wu(_v35L3_perm(_v35L3_mf, _v35L3_C, _v35L3_R)), 0,
          "_m3_cof_wpass: the cancelling minor at one slot -> declined");
    }
}
# A bracket that fails on ONE side, where the certificate fails too (3.5.0 second review): minor 0 is
# 2b x22 - x21 x12 cancelling to 2^-49 of its products (c~ = -7.975e-52 after the 2^-28: s + (u + d)
# leaves c~, s + (u - d) keeps it); minor 8 is the exact 0 of a rank-1 2 x 2 [[a, b], [2a, 2b]] at the
# largest scale (G = 1.114, its bracket holds); the rest are far from cancelling and below 2^-54 G, so
# `_m3_cof_wcert` declines. Each slot's line must reject it (written with && it is kept), and the
# swaps move that one-sided minor through all nine slots (each placement checked against a Python
# emulation of the pass: one slot one-sided, none two-sided, the certificate failing).
# [measured: scratch_L3 py/brk.py, search.py seed 1, perm.py, 2026-11-14]
var _v35L3_m1s = _v35L3_m3(0xC1A815A47CC965A5, 0x41A7AF027A7C486A, 0xBDE6A107B7545943, 0xC1B815A47CC965A5,
  0x41B7AF027A7C486A, 0x3DE5DFBD3D18FC26, 0xBDE1622BD6E0BF94, 0x3DEC74803E53D043, 0x3A1A47E5AC612DDC);
for (var _v35L3_C1 = 0; _v35L3_C1 < 3; _v35L3_C1 = _v35L3_C1 + 1) {
    for (var _v35L3_R1 = 0; _v35L3_R1 < 3; _v35L3_R1 = _v35L3_R1 + 1) {
        assert_eq(_v35L3_wu(_v35L3_perm(_v35L3_m1s, _v35L3_C1, _v35L3_R1)), 0,
          "_m3_cof_wpass: a bracket failing on one side, the certificate failing -> declined");
    }
}
# `_m3_cof_wcert` itself: each side's largest by exponent, then significand, against the 2^54 margin
var _v35L3_wr = alloc(9 * 8);
var _v35L3_wg = alloc(9 * 8);
var _v35L3_wk = alloc(10 * 8);
fn _v35L3_wc(g0, g1, c0, c1, k1) {
    for (var i = 0; i < 9; i = i + 1) {
        store64(_v35L3_wr + i * 8, 0); store64(_v35L3_wg + i * 8, 0); store64(_v35L3_wk + i * 8, 0);
    }
    store64(_v35L3_wg, g0); store64(_v35L3_wg + 8, g1);
    store64(_v35L3_wr, c0); store64(_v35L3_wr + 8, c1);
    store64(_v35L3_wk + 8, k1);
    return _m3_cof_wcert(_v35L3_wr, _v35L3_wg, _v35L3_wk);
}
assert_eq(_v35L3_wc(0x4350000000000000, 0, 0x3FF0000000000000, 0, 0), 1, "_m3_cof_wcert: G = 2^54 max|c| -> 1");
assert_eq(_v35L3_wc(0x4350000000000001, 0, 0x3FF0000000000000, 0, 0), 0, "_m3_cof_wcert: G one ulp past it -> 0");
assert_eq(_v35L3_wc(0x4360000000000000, 0, 0x3FF0000000000000, 0, 0), 0, "_m3_cof_wcert: G = 2^55 max|c| -> 0");
assert_eq(_v35L3_wc(0x434FFFFFFFFFFFFF, 0, 0x3FF0000000000000, 0, 0), 1, "_m3_cof_wcert: G just under 2^54 -> 1");
assert_eq(_v35L3_wc(0x4350000000000000, 0x4358000000000000, 0xBFF4000000000000, 0, 0), 0,
  "_m3_cof_wcert: the larger of two G's at one exponent (1.5 2^54 against 1.25) -> 0");
assert_eq(_v35L3_wc(0x4354000000000000, 0, 0x3FF0000000000000, 0xBFF8000000000000, 0), 1,
  "_m3_cof_wcert: the larger of two c's at one exponent (1.25 2^54 against 1.5) -> 1");
assert_eq(_v35L3_wc(0x4350000000000000, 0x4350000000000000, 0x3FF0000000000000, 0, 1), 0,
  "_m3_cof_wcert: slot 1's G at 2^kv = 2 -> 0");
assert_eq(_v35L3_wc(0x4350000000000000, 0, 0, 0x3FE0000000000000, 1), 1,
  "_m3_cof_wcert: slot 1's c = 1/2 at 2^kv = 2 -> 1");
assert_eq(_v35L3_wc(0x4350000000000000, 0, 0, 0, 0), 0, "_m3_cof_wcert: every c~ zero -> 0");
assert_eq(_m3_wg(0x3FF0000000000000, 0xC000000000000000), 0x4000000000000000, "_m3_wg: |q| the larger");
assert_eq(_m3_wg(0xC008000000000000, 0x4000000000000000), 0x4008000000000000, "_m3_wg: |p| the larger");

# ==================================================================================================
# 3.5.0 — symbolic algebra and autodiff (symbolic, symbolic_ext, autodiff)
# ==================================================================================================
# (Written as tests/v35_L4.tcyr; every global and fn below is prefixed _v35L4_.)

# The Ok payload of a Result-returning call, or a signalling NaN no Ok value of these calls has
# when it is an Err; and the Err's code, 0 for an Ok.
var _V35L4_NOV = 0x7FF4_0000_0000_0B0B;
var _v35L4_rt = 0;
var _v35L4_rv = 0;
fn _v35L4_keep(t, v) {
    _v35L4_rt = t;
    _v35L4_rv = v;
    return 0;
}
fn _v35L4_okv() {
    if (is_ok(_v35L4_rt) == 1) { return _v35L4_rv; }
    return _V35L4_NOV;
}
fn _v35L4_errc() {
    if (is_ok(_v35L4_rt) == 1) { return 0; }
    return _v35L4_rv;
}
# 1 when the words of the block p, n of them, all hold w.
fn _v35L4_all(p, n, w) {
    for (var i = 0; i < n; i = i + 1) {
        if (load64(p + i * 8) != w) { return 0; }
    }
    return 1;
}

# ================================================================
test_group("3.5.0 L4: AD_NONE and AD_FULL are enum members");
# K003: they were `public var`s a consumer could assign (scratch probe p1: `AD_FULL = 0` compiled
# against the 3.4.2 bundle, and a full tape then answered 0). An enum member cannot be assigned;
# what is checked here is that the values are the ones every op and test reads.
assert_eq(AD_NONE, 0 - 1, "AD_NONE is -1");
assert_eq(AD_FULL, 0 - 2, "AD_FULL is -2");
var _v35L4_ft = ad_tape_new(1);
var _v35L4_f0 = ad_var(_v35L4_ft, F64_ONE);
assert_eq(ad_var(_v35L4_ft, F64_TWO), AD_FULL, "a full tape's next op answers AD_FULL");
assert_eq(load64(_ad_node(_v35L4_ft, _v35L4_f0) + 24), AD_NONE, "a variable's first input is AD_NONE");

# ================================================================
test_group("3.5.0 L4: a hand-set tape is refused, not written past");
# R2-SYM N9: AdTape's setters are public, and the sweep wrote n words of adj (cap words) and
# followed an edge at or above its node "plainly", bounded only below. Each tape here is built by
# ad_* and then corrupted by hand; a canary allocated right after its adj catches any write past.
var _v35L4_cw = 0x5555_5555_5555_5555;
fn _v35L4_tape2(cap) {
    var t = ad_tape_new(cap);
    var x = ad_var(t, F64_TWO);
    var y = ad_mul(t, x, x);
    return t;
}
fn _v35L4_canary(t) {
    var c = alloc(256);
    for (var i = 0; i < 32; i = i + 1) { store64(c + i * 8, _v35L4_cw); }
    if (c != AdTape_adj(t) + AdTape_cap(t) * 8) { return 0; }
    return c;
}
# (a) a length set past the capacity: refused before any write.
var _v35L4_ta = _v35L4_tape2(4);
var _v35L4_ca = _v35L4_canary(_v35L4_ta);
assert_neq(_v35L4_ca, 0, "fixture: the canary sits right after adj");
AdTape_set_n(_v35L4_ta, 12);
var _v35L4_k1t, _v35L4_k1v = ad_grad(_v35L4_ta, 1);
_v35L4_keep(_v35L4_k1t, _v35L4_k1v);
assert_eq(_v35L4_errc(), HSB_ERR_INVALID_INPUT, "n past cap: ad_grad -> Err(INVALID_INPUT) (3.4.2: Ok)");
assert_eq(_v35L4_all(_v35L4_ca, 32, _v35L4_cw), 1, "n past cap: no word past adj written (3.4.2: 8 cleared)");
assert_eq(ad_ok(_v35L4_ta, 4), 0, "n past cap: index 4 = cap is no node, whatever n says");
assert_eq(ad_ok(_v35L4_ta, 3), 1, "n past cap: index 3 < cap and < n is one");
var _v35L4_k2t, _v35L4_k2v = ad_val_checked(_v35L4_ta, 5);
_v35L4_keep(_v35L4_k2t, _v35L4_k2v);
assert_eq(_v35L4_errc(), HSB_ERR_INVALID_INPUT, "n past cap: ad_val_checked(5) refuses, no read past the nodes");
# (b) an edge past the capacity, in the compensated sweep (root < 4,096).
# [measured: src/autodiff.cyr's _AD_LO_SLOTS, 4,096, and the assertions below, lane L4 tree, 2026-11-14]
var _v35L4_tb = _v35L4_tape2(4);
var _v35L4_cb = _v35L4_canary(_v35L4_tb);
store64(_ad_node(_v35L4_tb, 1) + 24, 7);
var _v35L4_k3t, _v35L4_k3v = ad_grad(_v35L4_tb, 1);
_v35L4_keep(_v35L4_k3t, _v35L4_k3v);
assert_eq(_v35L4_errc(), HSB_ERR_INVALID_INPUT, "edge to 7 on a 4-node tape: Err (3.4.2: added plainly)");
assert_eq(_v35L4_all(_v35L4_cb, 32, _v35L4_cw), 1, "edge to 7: adj[7], past adj, not written");
assert_eq(ad_grad_of(_v35L4_tb, 0), 0x7FF8_0000_0000_0000, "a refused sweep leaves every adjoint a quiet NaN");
assert_eq(ad_grad_of(_v35L4_tb, 1), 0x7FF8_0000_0000_0000, "... the root's too, not its seed 1");
# (c) an edge to the node itself, (d) to a later node inside the tape, (e) i2 out of order,
# (f) a marked i1 that decodes to an index at or above its node.
var _v35L4_tc = _v35L4_tape2(4);
store64(_ad_node(_v35L4_tc, 1) + 24, 1);
var _v35L4_k4t, _v35L4_k4v = ad_grad(_v35L4_tc, 1);
_v35L4_keep(_v35L4_k4t, _v35L4_k4v);
assert_eq(_v35L4_errc(), HSB_ERR_INVALID_INPUT, "an edge from node 1 to itself: Err");
var _v35L4_td = _v35L4_tape2(4);
var _v35L4_d2 = ad_add(_v35L4_td, 1, 0);
store64(_ad_node(_v35L4_td, 1) + 24, 2);
var _v35L4_k5t, _v35L4_k5v = ad_grad(_v35L4_td, 2);
_v35L4_keep(_v35L4_k5t, _v35L4_k5v);
assert_eq(_v35L4_errc(), HSB_ERR_INVALID_INPUT,
  "node 1's edge to node 2, inside the tape: Err (3.4.2: a gradient missing it)");
var _v35L4_te = _v35L4_tape2(4);
var _v35L4_ce = _v35L4_canary(_v35L4_te);
store64(_ad_node(_v35L4_te, 1) + 32, 6);
var _v35L4_k6t, _v35L4_k6v = ad_grad(_v35L4_te, 1);
_v35L4_keep(_v35L4_k6t, _v35L4_k6v);
assert_eq(_v35L4_errc(), HSB_ERR_INVALID_INPUT, "i2 = 6 on a 4-node tape: Err");
assert_eq(_v35L4_all(_v35L4_ce, 32, _v35L4_cw), 1, "i2 = 6: adj[6] not written");
var _v35L4_tf = _v35L4_tape2(4);
var _v35L4_cf = _v35L4_canary(_v35L4_tf);
store64(_ad_node(_v35L4_tf, 1) + 24, _AD_MARK - 5);
var _v35L4_k7t, _v35L4_k7v = ad_grad(_v35L4_tf, 1);
_v35L4_keep(_v35L4_k7t, _v35L4_k7v);
assert_eq(_v35L4_errc(), HSB_ERR_INVALID_INPUT, "a marked i1 decoding to 5: Err, the index tested after decoding");
assert_eq(_v35L4_all(_v35L4_cf, 32, _v35L4_cw), 1, "marked i1 -> 5: adj[5] not written");
# (g) the uncompensated sweep, from a root at 4,096.
# [measured: the fixture assertion below, lane L4 tree, 2026-11-14]
var _v35L4_tg = ad_tape_new(4100);
var _v35L4_gx = ad_var(_v35L4_tg, F64_ONE);
var _v35L4_gf = _v35L4_gx;
for (var i = 0; i < 4096; i = i + 1) { _v35L4_gf = ad_add(_v35L4_tg, _v35L4_gf, _v35L4_gx); }
assert_eq(_v35L4_gf, 4096, "fixture: the root sits at 4,096, past the compensated sweep's buffer");
var _v35L4_k8t, _v35L4_k8v = ad_grad(_v35L4_tg, _v35L4_gf);
_v35L4_keep(_v35L4_k8t, _v35L4_k8v);
assert_eq(_v35L4_okv(), 0, "the 4,097-node chain sweeps Ok");
assert_eq(ad_grad_of(_v35L4_tg, _v35L4_gx), f64_from(4097), "d/dx = 4,097 exactly");
store64(_ad_node(_v35L4_tg, 4096) + 24, 4099);
var _v35L4_k9t, _v35L4_k9v = ad_grad(_v35L4_tg, _v35L4_gf);
_v35L4_keep(_v35L4_k9t, _v35L4_k9v);
assert_eq(_v35L4_errc(), HSB_ERR_INVALID_INPUT, "root 4,096 with an edge to 4,099: Err in the plain sweep");
store64(_ad_node(_v35L4_tg, 4096) + 24, 4095);
store64(_ad_node(_v35L4_tg, 4096) + 32, 4096);
var _v35L4_k10t, _v35L4_k10v = ad_grad(_v35L4_tg, _v35L4_gf);
_v35L4_keep(_v35L4_k10t, _v35L4_k10v);
assert_eq(_v35L4_errc(), HSB_ERR_INVALID_INPUT, "root 4,096 with i2 = 4,096 (itself): Err in the plain sweep");
# (i) an i2 below AD_NONE that is not a constant's mark: no edge ad_* writes, read as none through
# the second pass, so d(x * x)/dx at 2 came back 2. Both sweeps; a constant's i2 still sweeps.
var _v35L4_ti = _v35L4_tape2(4);
store64(_ad_node(_v35L4_ti, 1) + 32, 0 - 5);
var _v35L4_n1t, _v35L4_n1v = ad_grad(_v35L4_ti, 1);
_v35L4_keep(_v35L4_n1t, _v35L4_n1v);
assert_eq(_v35L4_errc(), HSB_ERR_INVALID_INPUT, "x * x with i2 = -5: Err (3.4.2: Ok, d/dx = 2 for 4)");
store64(_ad_node(_v35L4_ti, 1) + 32, 0 - 2);
var _v35L4_n2t, _v35L4_n2v = ad_grad(_v35L4_ti, 1);
_v35L4_keep(_v35L4_n2t, _v35L4_n2v);
assert_eq(_v35L4_errc(), HSB_ERR_INVALID_INPUT, "... i2 = -2, the mark's value, which i2 never holds: Err");
var _v35L4_tk = ad_tape_new(4);
var _v35L4_kx = ad_var(_v35L4_tk, F64_TWO);
var _v35L4_kf = ad_mul(_v35L4_tk, _v35L4_kx, ad_const(_v35L4_tk, 0x4008_0000_0000_0000));
assert_eq(load64(_ad_node(_v35L4_tk, 1) + 32), _AD_CONST_NODE, "fixture: the constant's i2 is _AD_CONST_NODE");
var _v35L4_n3t, _v35L4_n3v = ad_grad(_v35L4_tk, _v35L4_kf);
_v35L4_keep(_v35L4_n3t, _v35L4_n3v);
assert_eq(_v35L4_okv(), 0, "x * const(3): Ok");
assert_eq(ad_grad_of(_v35L4_tk, _v35L4_kx), 0x4008_0000_0000_0000, "... d/dx = 3");
var _v35L4_n4t, _v35L4_n4v = ad_grad(_v35L4_tk, 1);
_v35L4_keep(_v35L4_n4t, _v35L4_n4v);
assert_eq(_v35L4_okv(), 0, "the constant as the root, its i2 swept: Ok");
assert_eq(ad_grad_of(_v35L4_tk, _v35L4_kx), 0, "... d(3)/dx = 0");
var _v35L4_tj = ad_tape_new(4100);
var _v35L4_jx = ad_var(_v35L4_tj, F64_ONE);
var _v35L4_jf = _v35L4_jx;
for (var i = 0; i < 4095; i = i + 1) { _v35L4_jf = ad_add(_v35L4_tj, _v35L4_jf, _v35L4_jx); }
var _v35L4_jk = ad_const(_v35L4_tj, F64_TWO);
assert_eq(_v35L4_jk, 4096, "fixture: a constant at 4,096");
var _v35L4_n5t, _v35L4_n5v = ad_grad(_v35L4_tj, _v35L4_jk);
_v35L4_keep(_v35L4_n5t, _v35L4_n5v);
assert_eq(_v35L4_okv(), 0, "the constant at 4,096 as the root: Ok in the plain sweep");
store64(_ad_node(_v35L4_tj, 4096) + 24, 4095);
store64(_ad_node(_v35L4_tj, 4096) + 32, 0 - 5);
var _v35L4_n7t, _v35L4_n7v = ad_grad(_v35L4_tj, _v35L4_jk);
_v35L4_keep(_v35L4_n7t, _v35L4_n7v);
assert_eq(_v35L4_errc(), HSB_ERR_INVALID_INPUT, "root 4,096 with i2 = -5: Err in the plain sweep");
# (h) a corrupted node the root does not reach is no reason to refuse: guard what fails.
var _v35L4_th = ad_tape_new(8);
var _v35L4_hx = ad_var(_v35L4_th, F64_TWO);
var _v35L4_hz = ad_mul(_v35L4_th, _v35L4_hx, _v35L4_hx);
var _v35L4_hw = ad_add(_v35L4_th, _v35L4_hx, _v35L4_hx);
store64(_ad_node(_v35L4_th, _v35L4_hz) + 24, 99);
var _v35L4_k11t, _v35L4_k11v = ad_grad(_v35L4_th, _v35L4_hw);
_v35L4_keep(_v35L4_k11t, _v35L4_k11v);
assert_eq(_v35L4_okv(), 0, "a corrupted node the root does not reach: Ok");
assert_eq(ad_grad_of(_v35L4_th, _v35L4_hx), F64_TWO, "... and d(x + x)/dx = 2");

# ================================================================
test_group("3.5.0 L4: ad_val_checked and ad_grad_of_checked");
var _v35L4_at = ad_tape_new(8);
var _v35L4_ax = ad_var(_v35L4_at, 0x4008_0000_0000_0000);
var _v35L4_af = ad_mul(_v35L4_at, _v35L4_ax, _v35L4_ax);
var _v35L4_k12t, _v35L4_k12v = ad_grad(_v35L4_at, _v35L4_af);
_v35L4_keep(_v35L4_k12t, _v35L4_k12v);
var _v35L4_k13t, _v35L4_k13v = ad_val_checked(_v35L4_at, _v35L4_ax);
_v35L4_keep(_v35L4_k13t, _v35L4_k13v);
assert_eq(_v35L4_okv(), 0x4008_0000_0000_0000, "ad_val_checked(x) -> Ok(3)");
var _v35L4_k14t, _v35L4_k14v = ad_val_checked(_v35L4_at, _v35L4_af);
_v35L4_keep(_v35L4_k14t, _v35L4_k14v);
assert_eq(_v35L4_okv(), 0x4022_0000_0000_0000, "ad_val_checked(x * x) -> Ok(9)");
var _v35L4_k15t, _v35L4_k15v = ad_val_checked(_v35L4_at, AD_FULL);
_v35L4_keep(_v35L4_k15t, _v35L4_k15v);
assert_eq(_v35L4_errc(), HSB_ERR_INVALID_INPUT, "ad_val_checked(AD_FULL) -> Err(INVALID_INPUT) (ad_val: 0)");
var _v35L4_k16t, _v35L4_k16v = ad_val_checked(_v35L4_at, 2);
_v35L4_keep(_v35L4_k16t, _v35L4_k16v);
assert_eq(_v35L4_errc(), HSB_ERR_INVALID_INPUT, "ad_val_checked(n) -> Err");
var _v35L4_k17t, _v35L4_k17v = ad_grad_of_checked(_v35L4_at, _v35L4_ax);
_v35L4_keep(_v35L4_k17t, _v35L4_k17v);
assert_eq(_v35L4_okv(), 0x4018_0000_0000_0000, "ad_grad_of_checked(x) -> Ok(6)");
var _v35L4_k18t, _v35L4_k18v = ad_grad_of_checked(_v35L4_at, _v35L4_af);
_v35L4_keep(_v35L4_k18t, _v35L4_k18v);
assert_eq(_v35L4_okv(), F64_ONE, "ad_grad_of_checked(root) -> Ok(1)");
var _v35L4_k19t, _v35L4_k19v = ad_grad_of_checked(_v35L4_at, AD_NONE);
_v35L4_keep(_v35L4_k19t, _v35L4_k19v);
assert_eq(_v35L4_errc(), HSB_ERR_INVALID_INPUT, "ad_grad_of_checked(AD_NONE) -> Err (ad_grad_of: 0)");
var _v35L4_k20t, _v35L4_k20v = ad_grad_of_checked(_v35L4_at, 2);
_v35L4_keep(_v35L4_k20t, _v35L4_k20v);
assert_eq(_v35L4_errc(), HSB_ERR_INVALID_INPUT, "ad_grad_of_checked(n) -> Err");
# ad_grad_write refuses an id that is no node, before writing anything.
var _v35L4_ids = alloc(16);
var _v35L4_out = alloc(16);
store64(_v35L4_ids, _v35L4_ax);
store64(_v35L4_ids + 8, AD_FULL);
store64(_v35L4_out, 0x4053_4000_0000_0000);
store64(_v35L4_out + 8, 0x4053_4000_0000_0000);
var _v35L4_k21t, _v35L4_k21v = ad_grad_write(_v35L4_at, _v35L4_ids, 2, _v35L4_out);
_v35L4_keep(_v35L4_k21t, _v35L4_k21v);
assert_eq(_v35L4_errc(), HSB_ERR_INVALID_INPUT, "ad_grad_write with AD_FULL second -> Err (3.4.2: Ok, 0 written)");
assert_eq(_v35L4_all(_v35L4_out, 2, 0x4053_4000_0000_0000), 1, "... and slot 0 untouched too: checked before written");
store64(_v35L4_ids + 8, 2);
var _v35L4_k22t, _v35L4_k22v = ad_grad_into(_v35L4_at, _v35L4_af, _v35L4_ids, 2, _v35L4_out);
_v35L4_keep(_v35L4_k22t, _v35L4_k22v);
assert_eq(_v35L4_errc(), HSB_ERR_INVALID_INPUT, "ad_grad_into with an id at n -> the write's Err");
assert_eq(_v35L4_all(_v35L4_out, 2, 0x4053_4000_0000_0000), 1, "... out untouched");
store64(_v35L4_ids + 8, _v35L4_af);
var _v35L4_k23t, _v35L4_k23v = ad_grad_write(_v35L4_at, _v35L4_ids, 2, _v35L4_out);
_v35L4_keep(_v35L4_k23t, _v35L4_k23v);
assert_eq(_v35L4_okv(), 0, "ad_grad_write with two nodes -> Ok");
assert_eq(load64(_v35L4_out), 0x4018_0000_0000_0000, "slot 0 <- 6");
assert_eq(load64(_v35L4_out + 8), F64_ONE, "slot 1 <- 1");

# ================================================================
test_group("3.5.0 L4: expr_eval_checked tells a refusal from a tree");
# INS7: one flag stood for "no value" and "no memory", so both answered INVALID_INPUT. A refusing
# allocator is set as hisab's scope (src/heap.cyr): test_allocator refuses after n allocations.
fn _v35L4_chain(leaf, n) {
    var e = leaf;
    for (var i = 0; i < n; i = i + 1) { e = expr_add(e, expr_const(F64_ONE)); }
    return e;
}
var _v35L4_xs = str_from("x");
var _v35L4_x = expr_var(_v35L4_xs);
var _v35L4_vx = vec_new();
vec_push(_v35L4_vx, expr_bind(_v35L4_xs, 0));
var _v35L4_deep = _v35L4_chain(_v35L4_x, 400);
var _v35L4_deepq = _v35L4_chain(expr_var(str_from("q")), 400);
var _v35L4_mixq = expr_add(expr_var(str_from("q")), _v35L4_deep);
var _v35L4_ta0 = test_allocator();
test_allocator_fail_after(_v35L4_ta0, 0);
var _v35L4_sc = hisab_alloc_scope(_v35L4_ta0);
var _v35L4_e1t, _v35L4_e1v = expr_eval_checked(_v35L4_deep, _v35L4_vx);
var _v35L4_e2t, _v35L4_e2v = expr_eval_checked(_v35L4_mixq, _v35L4_vx);
var _v35L4_e3t, _v35L4_e3v = expr_eval_checked(_v35L4_deepq, _v35L4_vx);
hisab_alloc_scope(_v35L4_sc);
var _v35L4_e4t, _v35L4_e4v = expr_eval_checked(_v35L4_deep, _v35L4_vx);
assert_eq(is_err_result(_v35L4_e1t), 1, "a 400-deep sum under a refusing scope: Err");
assert_eq(_v35L4_e1v, HSB_ERR_ALLOC, "... HSB_ERR_ALLOC: its stack could not grow (3.4.2: INVALID_INPUT)");
assert_eq(_v35L4_e2v, HSB_ERR_INVALID_INPUT, "q unbound beside it: INVALID_INPUT, seen before the refusal");
assert_eq(_v35L4_e3v, HSB_ERR_ALLOC, "q unbound at the bottom, past the refusal: ALLOC, the walk met no q first");
assert_eq(_v35L4_e4v, f64_from(400), "the scope restored: Ok(400)");
assert_eq(is_ok(_v35L4_e4t), 1, "... an Ok");
# A right-deep sum grows the value stack too: the frame stack's block granted, the value stack's
# refused.
var _v35L4_rd = _v35L4_x;
for (var i = 0; i < 400; i = i + 1) { _v35L4_rd = expr_add(expr_const(F64_ONE), _v35L4_rd); }
var _v35L4_ta1 = test_allocator();
test_allocator_fail_after(_v35L4_ta1, 1);
_v35L4_sc = hisab_alloc_scope(_v35L4_ta1);
var _v35L4_e5t, _v35L4_e5v = expr_eval_checked(_v35L4_rd, _v35L4_vx);
hisab_alloc_scope(_v35L4_sc);
assert_eq(_v35L4_e5v, HSB_ERR_ALLOC, "a right-deep sum, its value stack refused: ALLOC");
# The memo walk's refusals (a shared tree, "Sharing" in symbolic.cyr): its table, then its stack.
var _v35L4_v3e = vec_new();
vec_push(_v35L4_v3e, expr_bind(_v35L4_xs, 0x4008_0000_0000_0000));
var _v35L4_m25 = _v35L4_x;
for (var i = 0; i < 25; i = i + 1) { _v35L4_m25 = expr_add(_v35L4_m25, _v35L4_m25); }
var _v35L4_m25s = _v35L4_m25;
for (var i = 0; i < 100; i = i + 1) { _v35L4_m25s = expr_sin(_v35L4_m25s); }
var _v35L4_ta2 = test_allocator();
test_allocator_fail_after(_v35L4_ta2, 0);
_v35L4_sc = hisab_alloc_scope(_v35L4_ta2);
var _v35L4_e6t, _v35L4_e6v = expr_eval_checked(_v35L4_m25, _v35L4_v3e);
hisab_alloc_scope(_v35L4_sc);
assert_eq(_v35L4_e6v, HSB_ERR_ALLOC, "x doubled 25, the memo walk's table refused: ALLOC");
var _v35L4_ta3 = test_allocator();
test_allocator_fail_after(_v35L4_ta3, 1);
_v35L4_sc = hisab_alloc_scope(_v35L4_ta3);
var _v35L4_e7t, _v35L4_e7v = expr_eval_checked(_v35L4_m25s, _v35L4_v3e);
hisab_alloc_scope(_v35L4_sc);
assert_eq(_v35L4_e7v, HSB_ERR_ALLOC, "sin^100 over it, the memo walk's stack refused: ALLOC");
var _v35L4_e8t, _v35L4_e8v = expr_eval_checked(_v35L4_m25s, _v35L4_v3e);
var _v35L4_c25 = expr_const(0x4198_0000_0000_0000);   # 3 x 2^25
for (var i = 0; i < 100; i = i + 1) { _v35L4_c25 = expr_sin(_v35L4_c25); }
var _v35L4_e9t, _v35L4_e9v = expr_eval_checked(_v35L4_c25, _v35L4_v3e);
assert_eq(_v35L4_e8v, _v35L4_e9v,
  "... and with the heap open, sin^100(3 x 2^25), as the plain walk of its constant");

# ================================================================
test_group("3.5.0 L4: the renderers refuse a tag no constructor writes");
# SYM F6: such a node rendered "?" (expr_to_str) and "\text{?}" (sym_to_latex), where
# expr_eval_checked and expr_diff refuse it.
fn _v35L4_bad(tag) {
    var b = alloc(24);
    store64(b, tag);
    store64(b + 8, expr_const(F64_ONE));
    store64(b + 16, expr_const(F64_ONE));
    return b;
}
assert_eq(expr_to_str(_v35L4_bad(77)), 0, "expr_to_str(<tag 77>) -> 0 (3.4.2: \"?\")");
assert_eq(expr_to_str(_v35L4_bad(EXPR_LN + 1)), 0, "expr_to_str(<tag 10>) -> 0");
assert_eq(expr_to_str(expr_add(_v35L4_x, _v35L4_bad(EXPR_LN + 1))), 0,
  "expr_to_str(x + <tag 10>) -> 0 (3.4.2: \"(x + ?)\")");
assert_eq(expr_to_str(expr_add(_v35L4_x, _v35L4_bad(0 - 1))), 0, "expr_to_str(x + <tag -1>) -> 0");
assert_eq(str_eq_cstr(expr_to_str(expr_add(_v35L4_x, expr_const(F64_ONE))), "(x + 1)"), 1,
  "expr_to_str(x + 1), the control");
assert_eq(sym_to_latex(_v35L4_bad(77)), 0, "sym_to_latex(<tag 77>) -> 0 (3.4.2: \"\\text{?}\")");
assert_eq(sym_to_latex(expr_add(_v35L4_x, _v35L4_bad(EXPR_LN + 1))), 0, "sym_to_latex(x + <tag 10>) -> 0");
var _v35L4_bl = _v35L4_bad(77);
for (var i = 0; i < 300; i = i + 1) { _v35L4_bl = expr_sin(_v35L4_bl); }
assert_eq(sym_to_latex(_v35L4_bl), 0, "sym_to_latex(sin^300(<tag 77>)): the iterative writer refuses it too");
assert_eq(str_eq_cstr(sym_to_latex(expr_add(_v35L4_x, expr_const(F64_ONE))), "x + 1"), 1,
  "sym_to_latex(x + 1), the control");

# ================================================================
test_group("3.5.0 L4: constants fold exactly");
# SYM-F2, AU2-G6-F2/F3, Decisions owed #12(a): a constant within an absolute 1e-15 of 0 or 1 was
# folded as 0 or 1, and two within 1e-15 matched as one. The oracle of a fold is the IEEE
# operation (Python's float product, 2026-11-14); of a zero or a one, the value itself.
# [measured: python3 -I float products and struct bit patterns, and the 3.4.2 tree's answers, 2026-11-14]
var _v35L4_c20 = expr_const(0x3BC7_9CA1_0C92_4223);   # 1e-20
var _v35L4_f1 = expr_simplify(expr_mul(_v35L4_c20, expr_const(0x4629_3E59_39A0_8CEA)));   # 1e30
assert_eq(expr_tag(_v35L4_f1), EXPR_CONST, "1e-20 * 1e30 folds to a constant");
assert_eq(expr_const_val(_v35L4_f1), 0x4202_A05F_2000_0000, "... 1e10, the IEEE product (3.4.2: 0)");
var _v35L4_kb = expr_simplify(expr_mul(expr_const(0x3B30_B0E6_D55E_647C), _v35L4_x));   # k_B, J/K
assert_eq(expr_tag(_v35L4_kb), EXPR_MUL, "k_B * x stays a product (3.4.2: the constant 0)");
assert_eq(expr_const_val(expr_left(_v35L4_kb)), 0x3B30_B0E6_D55E_647C, "... with k_B's bits");
var _v35L4_vx3 = vec_new();
vec_push(_v35L4_vx3, expr_bind(_v35L4_xs, 0x4008_0000_0000_0000));
var _v35L4_dq = expr_simplify(expr_diff(expr_mul(_v35L4_c20, expr_pow(_v35L4_x, expr_const(F64_TWO))), _v35L4_xs));
var _v35L4_dqt, _v35L4_dqv = expr_eval_checked(_v35L4_dq, _v35L4_vx3);
assert_eq(_v35L4_dqv, 0x3BF1_B578_C96D_B19A, "simplify(d/dx 1e-20 x^2) at 3: 1e-20 * (2 * 3) (3.4.2: 0)");
# The fixtures of 3.3.0's sym_const_eq assertions, now on the rules that used it.
assert_eq(expr_tag(expr_simplify(expr_mul(expr_const(0x3CC2_03AF_9EE7_5616), _v35L4_x))), EXPR_MUL,
  "5e-16 * x stays a product (3.4.2: 0)");
assert_eq(expr_tag(expr_simplify(expr_add(_v35L4_x, expr_const(0x3CD0_3684_7569_CD7A)))), EXPR_ADD,
  "x + 9e-16 stays a sum (3.4.2: x)");
assert_eq(expr_tag(expr_simplify(expr_pow(_v35L4_x, expr_const(0x3CD2_03AF_9EE7_5615)))), EXPR_POW,
  "x^pred(1e-15) stays a power (3.4.2: 1)");
assert_eq(expr_tag(expr_simplify(expr_pow(_v35L4_x, expr_const(0x3FEF_FFFF_FFFF_FFFF)))), EXPR_POW,
  "x^(1 - 2^-53) stays a power (3.4.2: x)");
assert_eq(expr_tag(expr_simplify(expr_mul(expr_const(0x3FF0_0000_0000_0001), _v35L4_x))), EXPR_MUL,
  "(1 + 2^-52) * x stays a product (3.4.2: x)");
# The exact values still fold, a zero of either sign.
var _v35L4_z0 = expr_simplify(expr_mul(expr_const(0x8000_0000_0000_0000), _v35L4_x));
assert_eq(expr_tag(_v35L4_z0), EXPR_CONST, "-0 * x folds");
assert_eq(expr_const_val(_v35L4_z0), 0, "... to the constant +0");
assert_eq(expr_simplify(expr_add(_v35L4_x, expr_const(0x8000_0000_0000_0000))), _v35L4_x, "x + -0 -> x");
assert_eq(expr_simplify(expr_mul(expr_const(F64_ONE), _v35L4_x)), _v35L4_x, "1 * x -> x");
assert_eq(expr_simplify(expr_pow(_v35L4_x, expr_const(F64_ONE))), _v35L4_x, "x^1 -> x");
assert_eq(expr_const_val(expr_simplify(expr_pow(_v35L4_x, expr_const(0)))), F64_ONE, "x^0 -> 1");
# Two constants fold first, as the evaluator computes them: the rules above hold for a finite
# operand, and 0 * +Inf is NaN. Each fold against expr_eval_checked of the tree it folds.
fn _v35L4_fold(e) {
    var s = expr_simplify(e);
    if (expr_tag(s) != EXPR_CONST) { return 0; }
    var t, v = expr_eval_checked(e, 0);
    if (is_ok(t) == 0) { return 0; }
    if (expr_const_val(s) != v) { return 0; }
    return 1;
}
var _v35L4_inf = expr_const(F64_POS_INF);
var _v35L4_zero = expr_const(0);
var _v35L4_mz = expr_const(0x8000_0000_0000_0000);
var _v35L4_qn = expr_const(0x7FF8_0000_0000_0000);
var _v35L4_f2 = expr_simplify(expr_mul(_v35L4_zero, _v35L4_inf));
assert_eq(expr_const_val(_v35L4_f2), 0xFFF8_0000_0000_0000, "simplify(0 * +Inf): f64_mul's NaN (3.4.2: +0)");
assert_eq(_v35L4_fold(expr_mul(_v35L4_inf, _v35L4_zero)), 1, "+Inf * 0: the evaluator's bits");
assert_eq(_v35L4_fold(expr_mul(_v35L4_zero, _v35L4_qn)), 1, "0 * NaN: the evaluator's bits");
assert_eq(_v35L4_fold(expr_mul(_v35L4_zero, expr_const(0xC014_0000_0000_0000))), 1,
  "0 * -5: -0, the evaluator's bits (3.4.2: +0)");
assert_eq(expr_const_val(expr_simplify(expr_neg(_v35L4_zero))), 0x8000_0000_0000_0000, "-(+0): -0 (3.4.2: +0)");
assert_eq(_v35L4_fold(expr_neg(_v35L4_mz)), 1, "-(-0): +0, the evaluator's bits");
assert_eq(expr_const_val(expr_simplify(expr_add(_v35L4_zero, _v35L4_mz))), 0, "+0 + -0: +0 (3.4.2: -0)");
assert_eq(_v35L4_fold(expr_add(_v35L4_mz, _v35L4_mz)), 1, "-0 + -0: -0");
assert_eq(_v35L4_fold(expr_add(_v35L4_zero, _v35L4_qn)), 1, "0 + NaN");
assert_eq(expr_const_val(expr_simplify(expr_pow(_v35L4_qn, expr_const(F64_ONE)))), 0xFFF8_0000_0000_0000,
  "NaN^1: ganita_f64_pow's NaN, the evaluator's (3.4.2: the NaN itself, x^1 = x)");
assert_eq(_v35L4_fold(expr_pow(_v35L4_inf, _v35L4_zero)), 1, "+Inf^0: the evaluator's bits");
assert_eq(_v35L4_fold(expr_pow(expr_const(F64_TWO), expr_const(0x4008_0000_0000_0000))), 1, "2^3");
# The matcher: equal and finite, +0 and -0 one number.
var _v35L4_m1t, _v35L4_m1v = sym_match_checked(pat_const(0), expr_const(0x3CC2_03AF_9EE7_5616));
assert_eq(_v35L4_m1v, 0, "pat 0 against 5e-16: Ok(0) (3.4.2: 1)");
var _v35L4_m2t, _v35L4_m2v = sym_match_checked(pat_const(0), expr_const(0x8000_0000_0000_0000));
assert_eq(_v35L4_m2v, 1, "pat 0 against -0: Ok(1)");
var _v35L4_m3t, _v35L4_m3v = sym_match_checked(pat_const(0x43AB_C16D_674E_C800), expr_const(0x43AB_C16D_674E_C801));
assert_eq(_v35L4_m3v, 0, "pat 1e18 against the next double: Ok(0)");
var _v35L4_m4t, _v35L4_m4v = sym_match_checked(pat_const(F64_POS_INF), expr_const(F64_POS_INF));
assert_eq(_v35L4_m4v, 0, "pat +Inf against +Inf: Ok(0), no infinity equals anything");
var _v35L4_m5t, _v35L4_m5v = sym_match_checked(pat_const(0x3CC2_03AF_9EE7_5616), expr_const(0x3CC2_03AF_9EE7_5616));
assert_eq(_v35L4_m5v, 1, "pat 5e-16 against 5e-16: Ok(1)");
# The rewriter: a + neg(a) no longer takes 1e-16 + neg(2e-16) for 0.
var _v35L4_rw0 = expr_add(expr_const(0x3C9C_D2B2_97D8_89BC), expr_neg(expr_const(0x3CAC_D2B2_97D8_89BC)));
assert_eq(sym_rewrite(_v35L4_rw0, sym_default_rules()), _v35L4_rw0, "1e-16 + neg(2e-16) is a fixpoint (3.4.2: 0)");
# sym_integrate's -1: exact.
var _v35L4_in1 = sym_integrate(expr_pow(_v35L4_x, expr_const(0xBFEF_FFFF_FFFF_FFFE)), _v35L4_xs);
assert_eq(expr_tag(_v35L4_in1), EXPR_MUL, "integral of x^(-1 + 2^-52): the power rule (3.4.2: ln x)");
assert_eq(expr_const_val(expr_left(_v35L4_in1)), 0x4330_0000_0000_0000, "... 1 / 2^-52 = 2^52 exactly");
# The renderers keep their tolerance: their text is lossy by design, and unchanged.
assert_eq(str_eq_cstr(sym_to_latex(expr_pow(_v35L4_x, expr_const(0xBFEF_FFFF_FFFF_FFFE))), "\\frac{1}{x}"), 1,
  "sym_to_latex(x^(-1 + 2^-52)) is still \\frac{1}{x}");
assert_eq(str_eq_cstr(sym_to_latex(expr_pow(_v35L4_x, expr_const(0x3FE0_0000_0000_0001))), "\\sqrt{x}"), 1,
  "sym_to_latex(x^(0.5 + 2^-53)) is still \\sqrt{x}");

# ================================================================
test_group("3.5.0 L4: sym_integrate's forms free of x, and ln(x)");
# D076: these answered 0, "unsupported". The text is the tree; each antiderivative's derivative
# is its integrand (checked symbolically and at 40 digits, decimal module, 2026-11-14).
fn _v35L4_int(e) {
    var r = sym_integrate(e, _v35L4_xs);
    if (r == 0) { return 0; }
    return expr_to_str(r);
}
fn _v35L4_txt(e, want) {
    var s = _v35L4_int(e);
    if (s == 0) { return 0; }
    return str_eq_cstr(s, want);
}
var _v35L4_y = expr_var(str_from("y"));
var _v35L4_two = expr_const(F64_TWO);
assert_eq(_v35L4_txt(expr_ln(_v35L4_x), "((x * ln(x)) + -x)"), 1, "ln(x) -> x ln(x) - x");
assert_eq(_v35L4_txt(expr_sin(_v35L4_y), "(sin(y) * x)"), 1, "sin(y) -> sin(y) x");
assert_eq(_v35L4_txt(expr_cos(_v35L4_y), "(cos(y) * x)"), 1, "cos(y) -> cos(y) x");
assert_eq(_v35L4_txt(expr_exp(_v35L4_y), "(exp(y) * x)"), 1, "exp(y) -> exp(y) x");
assert_eq(_v35L4_txt(expr_ln(_v35L4_two), "(ln(2) * x)"), 1, "ln(2) -> ln(2) x");
assert_eq(_v35L4_txt(expr_pow(_v35L4_y, _v35L4_two), "((y^2) * x)"), 1, "y^2 -> y^2 x");
assert_eq(_v35L4_txt(expr_pow(_v35L4_x, _v35L4_y), "((x^(y + 1)) * ((y + 1)^-1))"), 1, "x^y -> x^(y+1) / (y+1)");
assert_eq(_v35L4_txt(expr_pow(_v35L4_two, _v35L4_x), "((2^x) * (ln(2)^-1))"), 1, "2^x -> 2^x / ln 2");
assert_eq(_v35L4_txt(expr_pow(_v35L4_y, _v35L4_x), "((y^x) * (ln(y)^-1))"), 1, "y^x -> y^x / ln y");
assert_eq(_v35L4_txt(expr_pow(expr_const(F64_ONE), _v35L4_x), "((1^x) * x)"), 1, "1^x -> 1^x x, which is x");
# A constant base with no real antiderivative of a^x: still 0.
assert_eq(_v35L4_int(expr_pow(expr_const(0), _v35L4_x)), 0, "0^x -> 0");
assert_eq(_v35L4_int(expr_pow(expr_const(0xC000_0000_0000_0000), _v35L4_x)), 0, "(-2)^x -> 0");
assert_eq(_v35L4_int(expr_pow(expr_const(F64_POS_INF), _v35L4_x)), 0, "(+Inf)^x -> 0");
assert_eq(_v35L4_int(expr_pow(expr_const(0x7FF8_0000_0000_0000), _v35L4_x)), 0, "NaN^x -> 0");
assert_neq(_v35L4_int(expr_pow(expr_const(0x0000_0000_0000_0001), _v35L4_x)), 0,
  "(5e-324)^x: the least base > 0 takes the form");
# What holds x inside a function or a power is still unsupported.
assert_eq(_v35L4_int(expr_sin(expr_mul(_v35L4_two, _v35L4_x))), 0, "sin(2x) -> 0");
assert_eq(_v35L4_int(expr_ln(expr_ln(_v35L4_x))), 0, "ln(ln x) -> 0");
assert_eq(_v35L4_int(expr_pow(_v35L4_x, _v35L4_x)), 0, "x^x -> 0");
assert_eq(_v35L4_int(expr_pow(expr_mul(_v35L4_two, _v35L4_x), _v35L4_two)), 0, "(2x)^2 -> 0");
assert_eq(_v35L4_int(expr_pow(_v35L4_two, expr_mul(_v35L4_two, _v35L4_x))), 0, "2^(2x) -> 0");
assert_eq(_v35L4_int(expr_exp(expr_neg(_v35L4_x))), 0, "exp(-x) -> 0");
assert_eq(_v35L4_int(expr_cos(expr_neg(_v35L4_x))), 0, "cos(-x) -> 0");
# Values: at x = 1, x ln x - x is exactly -1; at 2, 2 ln 2 - 2 rounds once (Sterbenz), the
# correctly rounded 0xBFE3A37A020B8C22 of the 40-digit value; 2^3 / ln 2 is 8 / ln 2's nearest.
var _v35L4_ln = sym_integrate(expr_ln(_v35L4_x), _v35L4_xs);
var _v35L4_v1 = vec_new();
vec_push(_v35L4_v1, expr_bind(_v35L4_xs, F64_ONE));
var _v35L4_l1t, _v35L4_l1v = expr_eval_checked(_v35L4_ln, _v35L4_v1);
assert_eq(_v35L4_l1v, 0xBFF0_0000_0000_0000, "integral of ln at x = 1: -1");
var _v35L4_v2 = vec_new();
vec_push(_v35L4_v2, expr_bind(_v35L4_xs, F64_TWO));
var _v35L4_l2t, _v35L4_l2v = expr_eval_checked(_v35L4_ln, _v35L4_v2);
assert_eq(_v35L4_l2v, 0xBFE3_A37A_020B_8C22, "integral of ln at x = 2: 2 ln 2 - 2");
var _v35L4_v3 = vec_new();
vec_push(_v35L4_v3, expr_bind(_v35L4_xs, 0x4008_0000_0000_0000));
var _v35L4_p2t, _v35L4_p2v = expr_eval_checked(sym_integrate(expr_pow(_v35L4_two, _v35L4_x), _v35L4_xs), _v35L4_v3);
assert_eq(_v35L4_p2v, 0x4027_1547_652B_82FE, "integral of 2^x at x = 3: 8 / ln 2");
var _v35L4_i1x = sym_integrate(expr_pow(expr_const(F64_ONE), _v35L4_x), _v35L4_xs);
var _v35L4_p1t, _v35L4_p1v = expr_eval_checked(_v35L4_i1x, _v35L4_v3);
assert_eq(_v35L4_p1v, 0x4008_0000_0000_0000, "integral of 1^x at x = 3: 3");
# An exponent or base free of every variable, written as a tree, takes a constant's branch by its
# value (3.4.2: 0 for all of them). The generic forms are the wrong answer here, at their poles:
# x^(neg(1)) would be a tree +Inf at every x, (neg(2))^x one NaN at every x.
var _v35L4_c1 = expr_const(F64_ONE);
var _v35L4_ch = expr_const(F64_HALF);
assert_eq(_v35L4_txt(expr_pow(_v35L4_x, expr_neg(_v35L4_c1)), "ln(x)"), 1, "x^(neg(1)) -> ln(x)");
assert_eq(_v35L4_txt(expr_pow(_v35L4_x, expr_add(_v35L4_c1, expr_const(0xC000_0000_0000_0000))), "ln(x)"), 1,
  "x^(1 + -2) -> ln(x)");
var _v35L4_ixa = sym_integrate(expr_pow(_v35L4_x, expr_add(_v35L4_c1, _v35L4_c1)), _v35L4_xs);
var _v35L4_ixb = sym_integrate(expr_pow(_v35L4_x, _v35L4_two), _v35L4_xs);
assert_eq(str_eq(expr_to_str(_v35L4_ixa), expr_to_str(_v35L4_ixb)), 1, "x^(1 + 1): x^2's tree, (1/3) x^3");
var _v35L4_ixat, _v35L4_ixav = expr_eval_checked(_v35L4_ixa, _v35L4_v3);
var _v35L4_ixbt, _v35L4_ixbv = expr_eval_checked(_v35L4_ixb, _v35L4_v3);
assert_eq(_v35L4_ixav, _v35L4_ixbv, "... and its bits at 3");
assert_eq(_v35L4_txt(expr_pow(expr_add(_v35L4_ch, _v35L4_ch), _v35L4_x), "(((0.500000 + 0.500000)^x) * x)"), 1,
  "(0.5 + 0.5)^x, a = 1 -> a^x x");
var _v35L4_iht, _v35L4_ihv = expr_eval_checked(sym_integrate(expr_pow(expr_add(_v35L4_ch, _v35L4_ch), _v35L4_x),
    _v35L4_xs), _v35L4_v3);
assert_eq(_v35L4_ihv, 0x4008_0000_0000_0000, "... at x = 3: 3 (the generic form: +Inf)");
assert_eq(_v35L4_int(expr_pow(expr_neg(_v35L4_two), _v35L4_x)), 0, "(neg(2))^x -> 0, a < 0 (the generic form: NaN)");
assert_eq(_v35L4_int(expr_pow(expr_mul(_v35L4_zero, _v35L4_two), _v35L4_x)), 0, "(0 * 2)^x -> 0, a = 0");
assert_eq(_v35L4_int(expr_pow(expr_exp(expr_const(0x408F_4000_0000_0000)), _v35L4_x)), 0,
  "(exp(1000))^x -> 0, a = +Inf");
assert_eq(_v35L4_int(expr_pow(expr_ln(expr_neg(_v35L4_c1)), _v35L4_x)), 0, "(ln(neg(1)))^x -> 0, a NaN");
var _v35L4_i2x = sym_integrate(expr_pow(expr_add(_v35L4_c1, _v35L4_c1), _v35L4_x), _v35L4_xs);
assert_eq(str_eq_cstr(expr_to_str(_v35L4_i2x), "(((1 + 1)^x) * (ln((1 + 1))^-1))"), 1, "(1 + 1)^x -> a^x / ln a");
var _v35L4_i2xt, _v35L4_i2xv = expr_eval_checked(_v35L4_i2x, _v35L4_v3);
assert_eq(_v35L4_i2xv, 0x4027_1547_652B_82FE, "... at x = 3: 2^x's 8 / ln 2");
# Holding another variable, the generic forms stay.
assert_eq(_v35L4_txt(expr_pow(_v35L4_x, expr_add(_v35L4_y, _v35L4_c1)), "((x^((y + 1) + 1)) * (((y + 1) + 1)^-1))"),
  1, "x^(y + 1) -> the generic form");
assert_eq(_v35L4_txt(expr_pow(expr_add(_v35L4_y, _v35L4_c1), _v35L4_x), "(((y + 1)^x) * (ln((y + 1))^-1))"), 1,
  "(y + 1)^x -> the generic form");
# The value is the evaluator's, at every tag, in sym_integrate's plain walk and its memo walk
# (white-box: _sym_int_cval against expr_eval_checked of the same tree, which holds no variable).
var _v35L4_cvo: i64[1];
fn _v35L4_cvb(b, deep) {
    _sx_call_open(b, b + 136, 0x7FFF_FFFF_FFFF_FFFF);
    if (deep == 1) {
        _sx_memo_open(b);
        store64(b + _SX_B_DEEP, 1);
    }
    store64(&_v35L4_cvo, _V35L4_NOV);
    return 0;
}
fn _v35L4_cval(e, deep) {
    var b: i64[785];
    _v35L4_cvb(&b, deep);
    return _sym_int_cval(e, &b, &_v35L4_cvo);
}
fn _v35L4_cvd(e) {
    var t, v = expr_eval_checked(e, 0);
    if (is_ok(t) == 0) { return 0; }
    if (_v35L4_cval(e, 0) != 1) { return 0; }
    if (load64(&_v35L4_cvo) != v) { return 0; }
    if (_v35L4_cval(e, 1) != 1) { return 0; }
    if (load64(&_v35L4_cvo) != v) { return 0; }
    return 1;
}
var _v35L4_c3 = expr_const(0x4008_0000_0000_0000);
assert_eq(_v35L4_cvd(expr_add(_v35L4_two, _v35L4_c3)), 1, "value of 2 + 3");
assert_eq(_v35L4_cvd(expr_mul(_v35L4_two, _v35L4_c3)), 1, "value of 2 * 3");
assert_eq(_v35L4_cvd(expr_pow(_v35L4_two, _v35L4_c3)), 1, "value of 2^3, not 3^2");
assert_eq(_v35L4_cvd(expr_neg(_v35L4_two)), 1, "value of neg(2)");
assert_eq(_v35L4_cvd(expr_sin(_v35L4_c3)), 1, "value of sin(3)");
assert_eq(_v35L4_cvd(expr_cos(_v35L4_c3)), 1, "value of cos(3)");
assert_eq(_v35L4_cvd(expr_exp(_v35L4_ch)), 1, "value of exp(0.5)");
assert_eq(_v35L4_cvd(expr_ln(_v35L4_c3)), 1, "value of ln(3)");
assert_eq(_v35L4_cvd(expr_pow(expr_add(_v35L4_two, expr_neg(_v35L4_ch)), expr_mul(_v35L4_c3, expr_sin(_v35L4_two)))),
  1, "value of (2 + neg(0.5))^(3 sin 2)");
assert_eq(_v35L4_cvd(expr_neg(expr_mul(_v35L4_zero, _v35L4_inf))), 1, "value of neg(0 * +Inf), a NaN's bits");
assert_eq(_v35L4_cvd(expr_neg(_v35L4_zero)), 1, "value of neg(0): -0");
assert_eq(_v35L4_cval(expr_add(_v35L4_two, _v35L4_y), 0), 0, "2 + y holds a variable: 0");
assert_eq(_v35L4_cval(expr_add(_v35L4_y, _v35L4_two), 1), 0, "y + 2, the memo walk: 0");
assert_eq(_v35L4_cval(expr_neg(expr_sin(_v35L4_y)), 0), 0, "neg(sin(y)): 0");
assert_eq(_v35L4_cval(expr_add(_v35L4_two, _v35L4_bad(77)), 0), 0 - 1, "a tag no constructor writes: -1");
var _v35L4_ch0 = alloc(24);
store64(_v35L4_ch0, EXPR_ADD);
store64(_v35L4_ch0 + 8, _v35L4_c1);
store64(_v35L4_ch0 + 16, 0);
assert_eq(_v35L4_cval(_v35L4_ch0, 1), 0 - 1, "1 + <0>: -1");
# A shared tree: (1 doubled 30 times) is 2^30, 2^30 operators as a tree. The plain walk gives up
# past 2^20 of them; the memo walk answers, and sym_integrate takes it.
var _v35L4_g30 = _v35L4_edbl(_v35L4_c1, 30);
assert_eq(_v35L4_cval(_v35L4_g30, 0), 0 - 1, "1 doubled 30 times, plain: gives up past 2^20 operators");
assert_eq(_v35L4_cval(_v35L4_g30, 1), 1, "... the memo walk: no variable");
assert_eq(load64(&_v35L4_cvo), 0x41D0_0000_0000_0000, "... 2^30");
var _v35L4_ig30 = sym_integrate(expr_pow(_v35L4_x, _v35L4_g30), _v35L4_xs);
assert_eq(expr_const_val(expr_left(_v35L4_ig30)), 0x3E0F_FFFF_FF80_0000, "x^(1 doubled 30): 1 / (2^30 + 1) x^...");
assert_eq(expr_const_val(expr_right(expr_right(_v35L4_ig30))), 0x41D0_0000_0040_0000, "... x^(2^30 + 1)");
# Kept answers are read again in one call: a chain 100 deep, read twice, with a variable at its
# bottom and without.
fn _v35L4_cv2(e) {
    var b: i64[785];
    _v35L4_cvb(&b, 1);
    var r1 = _sym_int_cval(e, &b, &_v35L4_cvo);
    var r2 = _sym_int_cval(e, &b, &_v35L4_cvo);
    return r1 * 10 + r2;
}
var _v35L4_cy = _v35L4_y;
var _v35L4_cc = _v35L4_c1;
var _v35L4_cy63 = 0;
var _v35L4_cc32 = 0;
for (var i = 0; i < 100; i = i + 1) {
    _v35L4_cy = expr_add(_v35L4_cy, _v35L4_c1);
    _v35L4_cc = expr_add(_v35L4_cc, _v35L4_c1);
    if (i == 62) { _v35L4_cy63 = _v35L4_cy; }
    if (i == 31) { _v35L4_cc32 = _v35L4_cc; }
}
assert_eq(_v35L4_cv2(_v35L4_cy), 0, "y + 1 + ... 100 deep, twice in one memo walk: 0, 0");
assert_eq(_v35L4_cv2(_v35L4_cc), 11, "1 + 1 + ... 100 deep, twice: 1, 1");
assert_eq(load64(&_v35L4_cvo), 0x4059_4000_0000_0000, "... 101 the second time, from the kept answers");
# What is kept, by "The memo"'s rule: the node where a walk's visits reach 64. Down the y chain the
# walk takes left operands only, so the 63rd sum; down the 1 chain both, so the 32nd, which is 33.
fn _v35L4_kept(e, n, key) {
    var b: i64[785];
    _v35L4_cvb(&b, 1);
    _sym_int_cval(e, &b, &_v35L4_cvo);
    var h = _sx_memo_get(&b, n, key);
    if (h == 0) { return _V35L4_NOV; }
    return load64(h + 16);
}
assert_eq(_v35L4_kept(_v35L4_cy, _v35L4_cy63, _SX_KEY_VVAR), 1, "the y chain keeps its 63rd sum as holding a variable");
assert_eq(_v35L4_kept(_v35L4_cc, _v35L4_cc32, _SX_KEY_VAL), 0x4040_8000_0000_0000,
  "the 1 chain keeps its 32nd sum, 33");
# A sum of x^g_k over g_k = g_(k-1) + 1, 3,000 terms, each exponent a tree sharing the last: the
# plain walk passes 2^20 operators and the memo walk answers; the text is the constant exponents'.
# [measured: the fixture assertion below, lane L4 tree, 2026-11-14]
var _v35L4_sg = expr_add(_v35L4_c1, _v35L4_c1);
var _v35L4_sa = expr_pow(_v35L4_x, _v35L4_sg);
var _v35L4_sb = expr_pow(_v35L4_x, _v35L4_two);
for (var i = 1; i < 3000; i = i + 1) {
    _v35L4_sg = expr_add(_v35L4_sg, _v35L4_c1);
    _v35L4_sa = expr_add(_v35L4_sa, expr_pow(_v35L4_x, _v35L4_sg));
    _v35L4_sb = expr_add(_v35L4_sb, expr_pow(_v35L4_x, expr_const(f64_from(i + 2))));
}
var _v35L4_sbk: i64[17];
store64(&_v35L4_sbk + _SX_B_VISITS, 0);
store64(&_v35L4_sbk + _SX_B_DEEP, 0);
_sym_int_rec(_v35L4_sa, _v35L4_xs, 0, &_v35L4_sbk);
assert_eq(load64(&_v35L4_sbk + _SX_B_VISITS) > _SX_MEMO_WALK, 1, "fixture: the plain walk gives up on the sum");
assert_eq(str_eq(expr_to_str(sym_integrate(_v35L4_sa, _v35L4_xs)), expr_to_str(sym_integrate(_v35L4_sb, _v35L4_xs))),
  1, "the 3,000 terms' integral: the constant exponents' text");

# ================================================================
test_group("3.5.0 L4: sym_match_checked refuses with a code");
# The sym half of the roadmap's AL row and INS5 F1: sym_match / sym_match_bindings answered 0,
# "no match", for a refused binding allocation and for a 0 node. The _checked forms answer
# Ok(1) / Ok(0), and Err(ALLOC) or Err(INVALID_INPUT).
var _v35L4_pa = pat_wildcard(str_from("a"));
var _v35L4_pb = pat_wildcard(str_from("b"));
var _v35L4_x1 = expr_add(_v35L4_x, expr_const(F64_ONE));
var _v35L4_s1t, _v35L4_s1v = sym_match_checked(pat_add(_v35L4_pa, _v35L4_pb), _v35L4_x1);
assert_eq(is_ok(_v35L4_s1t), 1, "a + b against x + 1: Ok");
assert_eq(_v35L4_s1v, 1, "... 1");
var _v35L4_s2t, _v35L4_s2v = sym_match_checked(pat_mul(_v35L4_pa, _v35L4_pb), _v35L4_x1);
assert_eq(is_ok(_v35L4_s2t), 1, "a * b against x + 1: Ok");
assert_eq(_v35L4_s2v, 0, "... 0");
var _v35L4_s3t, _v35L4_s3v = sym_match_bindings_checked(pat_add(_v35L4_pa, _v35L4_pb), _v35L4_x1);
assert_eq(vec_len(_v35L4_s3v), 2, "bindings: two names");
assert_eq(load64(vec_get(_v35L4_s3v, 0) + 8), _v35L4_x, "a is bound to x, the node itself");
assert_eq(load64(vec_get(_v35L4_s3v, 1) + 8), expr_right(_v35L4_x1), "b to the 1");
var _v35L4_s4t, _v35L4_s4v = sym_match_bindings_checked(pat_mul(_v35L4_pa, _v35L4_pb), _v35L4_x1);
assert_eq(is_ok(_v35L4_s4t), 1, "bindings, no match: Ok");
assert_eq(_v35L4_s4v, 0, "... Ok(0)");
var _v35L4_s5t, _v35L4_s5v = sym_match_bindings_checked(pat_const(F64_TWO), expr_const(F64_TWO));
assert_eq(vec_len(_v35L4_s5v), 0, "bindings of a match that binds nothing: Ok(an empty vec), not 0");
# 0 inputs and 0 nodes: INVALID_INPUT, in the recursion, the deep walk and the memo walk.
var _v35L4_i1t, _v35L4_i1v = sym_match_checked(0, _v35L4_x);
assert_eq(_v35L4_i1v, HSB_ERR_INVALID_INPUT, "sym_match_checked(0, x) -> Err(INVALID_INPUT) (3.4.2: 0)");
var _v35L4_i2t, _v35L4_i2v = sym_match_checked(_v35L4_pa, 0);
assert_eq(_v35L4_i2v, HSB_ERR_INVALID_INPUT, "sym_match_checked(a, 0) -> Err(INVALID_INPUT)");
var _v35L4_i3t, _v35L4_i3v = sym_match_bindings_checked(0, _v35L4_x);
assert_eq(_v35L4_i3v, HSB_ERR_INVALID_INPUT, "sym_match_bindings_checked(0, x) -> Err(INVALID_INPUT)");
var _v35L4_hole = alloc(24);
store64(_v35L4_hole, EXPR_ADD);
store64(_v35L4_hole + 8, _v35L4_x);
store64(_v35L4_hole + 16, 0);
var _v35L4_i4t, _v35L4_i4v = sym_match_checked(pat_add(_v35L4_pa, _v35L4_pb), _v35L4_hole);
assert_eq(_v35L4_i4v, HSB_ERR_INVALID_INPUT, "a + b against x + <0>: Err(INVALID_INPUT)");
var _v35L4_nv = alloc(16);
store64(_v35L4_nv, EXPR_VAR);
store64(_v35L4_nv + 8, 0);
var _v35L4_i5t, _v35L4_i5v = sym_match_checked(pat_var(_v35L4_xs), _v35L4_nv);
assert_eq(_v35L4_i5v, HSB_ERR_INVALID_INPUT, "pat x against a variable named 0: Err(INVALID_INPUT)");
var _v35L4_pd = pat_var(_v35L4_xs);
var _v35L4_ed = _v35L4_nv;
var _v35L4_eh = _v35L4_hole;
var _v35L4_ph = pat_add(_v35L4_pa, _v35L4_pb);
for (var i = 0; i < 300; i = i + 1) {
    _v35L4_pd = pat_neg(_v35L4_pd);
    _v35L4_ed = expr_neg(_v35L4_ed);
    _v35L4_ph = pat_neg(_v35L4_ph);
    _v35L4_eh = expr_neg(_v35L4_eh);
}
var _v35L4_i6t, _v35L4_i6v = sym_match_checked(_v35L4_pd, _v35L4_ed);
assert_eq(_v35L4_i6v, HSB_ERR_INVALID_INPUT, "300 negations deep, a variable named 0: Err(INVALID_INPUT), deep walk");
var _v35L4_i7t, _v35L4_i7v = sym_match_checked(_v35L4_ph, _v35L4_eh);
assert_eq(_v35L4_i7v, HSB_ERR_INVALID_INPUT, "300 negations deep, x + <0>: Err(INVALID_INPUT), deep walk");
# Past 2^20 pairs the attempt is the memo walk's: P + x against D + <bad>, P and D doubled 21 times.
fn _v35L4_pdbl(p, n) {
    var q = p;
    for (var i = 0; i < n; i = i + 1) { q = pat_add(q, q); }
    return q;
}
fn _v35L4_edbl(e, n) {
    var q = e;
    for (var i = 0; i < n; i = i + 1) { q = expr_add(q, q); }
    return q;
}
var _v35L4_pm = pat_add(_v35L4_pdbl(pat_var(_v35L4_xs), 21), pat_var(_v35L4_xs));
var _v35L4_i8t, _v35L4_i8v = sym_match_checked(_v35L4_pm, expr_add(_v35L4_edbl(_v35L4_x, 21), _v35L4_nv));
assert_eq(_v35L4_i8v, HSB_ERR_INVALID_INPUT,
  "doubled 21 times, then a variable named 0: Err(INVALID_INPUT), memo walk");
var _v35L4_h2 = alloc(24);
store64(_v35L4_h2, EXPR_ADD);
store64(_v35L4_h2 + 8, _v35L4_edbl(_v35L4_x, 21));
store64(_v35L4_h2 + 16, 0);
var _v35L4_i9t, _v35L4_i9v = sym_match_checked(_v35L4_pm, _v35L4_h2);
assert_eq(_v35L4_i9v, HSB_ERR_INVALID_INPUT, "doubled 21 times, then <0>: Err(INVALID_INPUT), memo walk");
var _v35L4_iat, _v35L4_iav = sym_match_checked(_v35L4_pm, expr_add(_v35L4_edbl(_v35L4_x, 21), _v35L4_x));
assert_eq(_v35L4_iav, 1, "the same with x: Ok(1), the control");
# A name bound twice is compared, and a 0 node or a variable named 0 the comparison meets is
# INVALID_INPUT too (3.4.2's sym_match: 0, "no match"), in the recursion, the deep walk and the memo
# walk; it stops at the first difference, left before right. A name bound once is not read: Ok(1).
fn _v35L4_mc(p, e) {
    var t, v = sym_match_checked(p, e);
    return v;
}
var _v35L4_paa = pat_add(_v35L4_pa, _v35L4_pa);
var _v35L4_hb = alloc(24);
store64(_v35L4_hb, EXPR_ADD);
store64(_v35L4_hb + 8, _v35L4_x);
store64(_v35L4_hb + 16, 0);
var _v35L4_hy = alloc(24);
store64(_v35L4_hy, EXPR_ADD);
store64(_v35L4_hy + 8, expr_var(str_from("y")));
store64(_v35L4_hy + 16, 0);
var _v35L4_qnan = expr_const(0x7FF8_0000_0000_0000);
assert_eq(_v35L4_mc(_v35L4_paa, expr_add(_v35L4_hole, _v35L4_hole)), HSB_ERR_INVALID_INPUT,
  "a + a against (x + <0>) + (x + <0>), one node: Err(INVALID_INPUT) (3.4.2: 0)");
assert_eq(_v35L4_mc(_v35L4_paa, expr_add(_v35L4_hole, _v35L4_hb)), HSB_ERR_INVALID_INPUT,
  "... two such nodes: Err(INVALID_INPUT)");
assert_eq(_v35L4_mc(_v35L4_paa, expr_add(_v35L4_nv, _v35L4_nv)), HSB_ERR_INVALID_INPUT,
  "a + a against two variables named 0: Err(INVALID_INPUT)");
assert_eq(_v35L4_mc(_v35L4_paa, expr_add(_v35L4_hole, _v35L4_hy)), 0,
  "(x + <0>) against (y + <0>): x and y differ first, Ok(0)");
assert_eq(_v35L4_mc(_v35L4_pa, _v35L4_hole), 1, "a against x + <0>: bound once, not read, Ok(1)");
assert_eq(_v35L4_mc(_v35L4_paa, expr_add(_v35L4_qnan, _v35L4_qnan)), 0, "a + a against NaN + NaN: Ok(0), the control");
var _v35L4_nh = _v35L4_hole;
var _v35L4_nn = _v35L4_nv;
for (var i = 0; i < 300; i = i + 1) {
    _v35L4_nh = expr_neg(_v35L4_nh);
    _v35L4_nn = expr_neg(_v35L4_nn);
}
assert_eq(_v35L4_mc(_v35L4_paa, expr_add(_v35L4_nh, _v35L4_nh)), HSB_ERR_INVALID_INPUT,
  "a + a, the <0> 300 levels down: Err(INVALID_INPUT), the comparison's deep walk");
assert_eq(_v35L4_mc(_v35L4_paa, expr_add(_v35L4_nn, _v35L4_nn)), HSB_ERR_INVALID_INPUT,
  "... a variable named 0 300 levels down: Err(INVALID_INPUT)");
var _v35L4_e21 = _v35L4_edbl(_v35L4_x, 21);
var _v35L4_th1 = expr_add(_v35L4_e21, _v35L4_hole);
var _v35L4_th2 = expr_add(_v35L4_e21, _v35L4_nv);
var _v35L4_th3 = expr_add(_v35L4_e21, _v35L4_x);
assert_eq(_v35L4_mc(_v35L4_paa, expr_add(_v35L4_th1, _v35L4_th1)), HSB_ERR_INVALID_INPUT,
  "a + a, each (x doubled 21) + <0>: Err(INVALID_INPUT), the comparison's memo walk");
assert_eq(_v35L4_mc(_v35L4_paa, expr_add(_v35L4_th2, _v35L4_th2)), HSB_ERR_INVALID_INPUT,
  "... + a variable named 0: Err(INVALID_INPUT)");
assert_eq(_v35L4_mc(_v35L4_paa, expr_add(_v35L4_th3, _v35L4_th3)), 1, "... + x: Ok(1), the control");
# The match's memo walk keeps a pair under which a new binding is unequal to itself as bad, and
# walks it again when it meets it again, so the comparison there answers as in the plain walk:
# Err for a <0>, Ok(0) for a NaN, whichever comes first. W = D7 + a is met twice under D21.
var _v35L4_d7 = _v35L4_pdbl(pat_var(_v35L4_xs), 7);
var _v35L4_e7 = _v35L4_edbl(_v35L4_x, 7);
var _v35L4_w1 = pat_add(_v35L4_d7, _v35L4_pa);
var _v35L4_w2 = pat_add(pat_add(_v35L4_d7, _v35L4_pa), _v35L4_pb);
var _v35L4_x1h = expr_add(_v35L4_e7, _v35L4_hole);
var _v35L4_x1n = expr_add(_v35L4_e7, _v35L4_qnan);
var _v35L4_x2a = expr_add(expr_add(_v35L4_e7, _v35L4_qnan), _v35L4_hole);
var _v35L4_x2b = expr_add(expr_add(_v35L4_e7, _v35L4_hole), _v35L4_qnan);
var _v35L4_p21 = _v35L4_pdbl(pat_var(_v35L4_xs), 21);
fn _v35L4_mtwice(w, e, big) {
    if (big == 0) { return _v35L4_mc(pat_add(w, w), expr_add(e, e)); }
    return _v35L4_mc(pat_add(pat_add(_v35L4_p21, w), w), expr_add(expr_add(_v35L4_e21, e), e));
}
assert_eq(_v35L4_mtwice(_v35L4_w1, _v35L4_x1h, 0), HSB_ERR_INVALID_INPUT, "W + W, a bound to x + <0>: plain, Err");
assert_eq(_v35L4_mtwice(_v35L4_w1, _v35L4_x1h, 1), HSB_ERR_INVALID_INPUT,
  "... under D21, the memo walk: Err (3.4.2: 0, a bad pair answered 0)");
assert_eq(_v35L4_mtwice(_v35L4_w1, _v35L4_x1n, 0), 0, "W + W, a bound to NaN: plain, Ok(0)");
assert_eq(_v35L4_mtwice(_v35L4_w1, _v35L4_x1n, 1), 0, "... the memo walk: Ok(0)");
assert_eq(_v35L4_mtwice(_v35L4_w2, _v35L4_x2a, 0), 0, "a bound to NaN before b to <0>: plain, Ok(0)");
assert_eq(_v35L4_mtwice(_v35L4_w2, _v35L4_x2a, 1), 0, "... the memo walk: Ok(0)");
assert_eq(_v35L4_mtwice(_v35L4_w2, _v35L4_x2b, 0), HSB_ERR_INVALID_INPUT, "a to <0> before b to NaN: plain, Err");
assert_eq(_v35L4_mtwice(_v35L4_w2, _v35L4_x2b, 1), HSB_ERR_INVALID_INPUT, "... the memo walk: Err");
# sym_rewrite's change test (same = 1) still reads a variable named 0 as unequal, as through 3.4.2:
# {a -> y} on it changes it to y, then y to y, a fixpoint.
var _v35L4_rr = vec_new();
vec_push(_v35L4_rr, sym_rule(_v35L4_pa, pat_var(str_from("y"))));
var _v35L4_rv0 = sym_rewrite(_v35L4_nv, _v35L4_rr);
