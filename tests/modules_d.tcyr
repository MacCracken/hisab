assert_eq(_w2W3_nc(0), 0xBFEB12334F3B32ED, "gjk_epa_3d: ... its normal 2.0e-16 rad off the axis (x)");
# A ball over a cap 6.4e-15 R inside its rim (r 5.3e-8, 2.1 eps deep, exact 6.6847700885146615e-14): the polished
# depth in nd, 0.0045 eps below EPA's answer, is a reading, and EPA's stands: 8.0e-17 rad off, 0.0004 eps below
# the exact. Taken where lower at all (the first wave-2 form), the polish: 0x3D32C5BB98DC0000, 3.49e-5 rad off.
# [measured: scratch W3 fix probe/fx.txt, py/chk.py (80-digit Decimal), this tree, the merged one, mutants; 2026-11-14]
_w2W3_cyl(0xBFEFB3E1ACF6B6AC, 0xBF85657D8094A100, 0xBFEBA984B0752848, 0x3FB389BF40C0C208, 0xBFECA89498267458,
  0x3FDC0D3D8908CD5B, 0x3FEEE69E5C0BAB72, 0x3FEBCFF5F2D99868);
_w2W3_ball(0xBFEC04A34741AD06, 0xBFF359C544E04E0E, 0xBFF59F33D89275DC, 0x3E6C5CE2609909BF);
assert_eq(_w2W3_q(0), 0x3D32D00000000000, "gjk_epa_3d: a ball 2.1 eps deep by a rim: a reading does not win a tie");
assert_eq(_w2W3_nc(0), 0x3FB389BF40C0C204, "gjk_epa_3d: ... EPA's normal, 8.0e-17 rad off the axis (x)");
# A cone: base disc of radius R at c, apex c + hz u (the support of tests/modules.tcyr's review pass CO8 group).
fn _w2W3_sup_cone(sh, d) {
    var ux = load64(sh + 24);
    var uy = load64(sh + 32);
    var uz = load64(sh + 40);
    var r = load64(sh + 48);
    var hh = load64(sh + 56);
    var dx = HVec3_x(d);
    var dy = HVec3_y(d);
    var dz = HVec3_z(d);
    var du = f64_add(f64_add(f64_mul(dx, ux), f64_mul(dy, uy)), f64_mul(dz, uz));
    var px = f64_sub(dx, f64_mul(du, ux));
    var py = f64_sub(dy, f64_mul(du, uy));
    var pz = f64_sub(dz, f64_mul(du, uz));
    var dp = f64_add(f64_add(f64_mul(px, ux), f64_mul(py, uy)), f64_mul(pz, uz));
    px = f64_sub(px, f64_mul(dp, ux));
    py = f64_sub(py, f64_mul(dp, uy));
    pz = f64_sub(pz, f64_mul(dp, uz));
    var pl = f64_sqrt(f64_add(f64_add(f64_mul(px, px), f64_mul(py, py)), f64_mul(pz, pz)));
    var cx = load64(sh);
    var cy = load64(sh + 8);
    var cz = load64(sh + 16);
    if (f64_gt(f64_mul(du, hh), f64_mul(pl, r)) == 1) {
        return hvec3_new(f64_add(cx, f64_mul(ux, hh)), f64_add(cy, f64_mul(uy, hh)), f64_add(cz, f64_mul(uz, hh)));
    }
    var k = 0;
    if (f64_gt(pl, f64_mul(f64_sqrt(hvec3_dot(d, d)), 0x3CF0000000000000)) == 1) { k = f64_div(r, pl); }  # 2^-48
    return hvec3_new(f64_add(cx, f64_mul(px, k)), f64_add(cy, f64_mul(py, k)), f64_add(cz, f64_mul(pz, k)));
}
# The review's ball 4.0e-12 past a cone's base rim and 3.0e-8 below the base (r 3.0e-8, 1,272 eps deep, exact
# 5.4604598924181080e-11, its normal 1.334e-4 rad off the cone's axis, where h is flat: 0.006 eps above the depth
# on the axis). Inside the section's closing (_epa_round_core) the deep snap's face form, the base's normal, is 0.135
# eps below the reading it starts from, a tie, and no minimiser of h (the origin's foot is off the base), so it is
# refused and the section's other end answers, as in 3.4.2: 2.85e-8 rad off, 0.021 eps above the exact. Taken (the
# first wave-2 form), the base's normal: 0x3DCE04E780000000, 1.334e-4 rad off.
# [measured: scratch W3 fix probe/fx.txt, py/chk.py (80-digit Decimal), this tree, the merged one, mutants; 2026-11-14]
_w2W3_cyl(0x3FD3C07E91A6500C, 0x3FD27653E4DB6D68, 0x3FEBA75C3C1DD85C, 0x3FED157D6F0BA30F, 0x3FDA063DAE8542C1,
  0xBFB7BDC9395507D0, 0x3FF11A9EB721DF05, 0x3FFCF314A8128329);
_w2W3_ball(0x3FD9D66CF2A5B194, 0x3FD46535D0F25B33, 0x3FFEDB30251F5686, 0x3E601F513B1CECAB);
assert_eq(gjk_epa_3d(&_w2W3_sup_cone, _w2W3_c, &_w2W3_sup_ball, _w2W3_b, _w2W3_n, _w2W3_d), 1,
  "gjk_epa_3d: a ball by a cone's base rim is a contact");
assert_eq(load64(_w2W3_d), 0x3DCE0509E17C8140, "gjk_epa_3d: ... 0.021 eps above the exact, 3.4.2's bits");
assert_eq(_w2W3_nc(0), 0xBFED15648724A913, "gjk_epa_3d: ... its normal 2.85e-8 rad off the exact (x), not the base's");
# _epa_off_min directly (tol 2^-47, 2^-49 of a scale of 4): from the base's normal h falls towards the rim, by the
# 4.0e-12 the origin's foot lies off the base; on the concentric parallelepiped's face form it does not (the
# face's midpoint is the foot).
_GA_MINK_S = F64_ONE;
_GA_MINK_AXES = 0;
_GA_CORE_RHO = 0;
var _w2W3_mb = hvec3_new(0xBFED157D6F0BA30F, 0xBFDA063DAE8542BF, 0x3FB7BDC9395507E6);
var _w2W3_tl = 0x3D00000000000000;  # 2^-47
assert_eq(_epa_off_min(&_w2W3_sup_cone, _w2W3_c, &_w2W3_sup_ball, _w2W3_b, hvec3_zero(), _w2W3_mb, _w2W3_tl), 1,
  "_epa_off_min: the cone's base normal, past its rim, is no minimiser");
_w2W3_par(0x3FC98D93E9FECDA8, 0x3FCA1CF3D94491D8, 0xBFE36B44DCEBD2BC, 0x3FC59F978719FCEF, 0x3FAA1EC832492661,
  0x3FC415FBDF9581FC);
_w2W3_axes(0xBFD4E1DEB0437ACC, 0xBFEAD7161C113012, 0x3FDBE61DAD346E0D, 0x3FE119C20D62D48E, 0x3FCBBD62EE36575C,
  0x3FEA24B3637F7211, 0xBFE8F3733380285E, 0x3FDFF82CD413790E, 0x3FD8293276F4E81A);
store64(&_w2W3_sw, 0x3FC98D93E9FECDA8);
store64(&_w2W3_sw + 8, 0x3FCA1CF3D94491D8);
store64(&_w2W3_sw + 16, 0xBFE36B44DCEBD2BC);
store64(&_w2W3_sw + 24, 0x400F54426F36165A);
store64(_w2W3_n, hvec3_new(0x3FE119C20D62D245, 0x3FCBBD62EE365D33, 0x3FEA24B3637F732D));
store64(_w2W3_d, 0x400FBCBD8FFF3B11);
assert_eq(_epa_snap_deep(&_w2W3_sup_par, &_w2W3_pp, &_w2W3_sup_sph, &_w2W3_sw, _w2W3_n, _w2W3_d), 1,
  "_epa_snap_deep: the concentric parallelepiped's face form, 27 ulp below and a minimiser, is taken");
var _w2W3_mf = load64(_w2W3_n);
assert_eq(_epa_off_min(&_w2W3_sup_par, &_w2W3_pp, &_w2W3_sup_sph, &_w2W3_sw, hvec3_zero(), _w2W3_mf, _w2W3_tl), 0,
  "_epa_off_min: ... it is a minimiser");

# ==================================================================================================
# 3.5.0 wave 2 — the certified extended tier, cmat_inverse, eigen_power's rounding bound (linalg_ext)
# ==================================================================================================
# (Written as tests/w2_W4.tcyr; every global and fn below is prefixed _w2W4_.)

# ==================================================================================================
# === 3.5.0 W4: matrix_condition_number past cond = 1/u, in certified extended precision ===
# Roadmap [3.5.0], "matrix_condition_number / cmat_inverse past cond ~ 2^53" (LA F2), wave 2: the exact
# tier wave 1 added costs about n^5 (150 s at n = 96 on a dense block beside a lost-pivot 2 x 2), so a
# lost pivot now goes to Gauss-Jordan at 30 P bits (`_lext_hf_gj`), accepted only under a proved bound
# on ||X - A^-1||_F (`_lext_hf_cert`), with the exact tier kept where its integers are no wider.
# `_lext_cond`'s st names the path: [0] the limbs of the certified attempt (0: the exact tier), [1] the
# extended-precision attempts (matrix_condition_number is `_lext_cond` with st = 0).
# [measured: scratch_W4 ab96.sh, merged tree, taskset -c 12, 3 runs, load 4 to 8 (noisy), 2026-11-14]
test_group("3.5.0 W4: matrix_condition_number past cond = 1/u, certified extended precision");
# (m + 2) x (m + 2): B_ij = ((7 i + 13 j) mod 17 - 8) / 16 (+ 4 on the diagonal), cpl = 1 adds the
# coupling ((5 i + 3 j) mod 11 - 5) / 8 in B's rows over C's columns, C the bottom-right 2 x 2
fn _w2W4_mk(m, c00, c01, c10, c11, cpl) {
    var n = m + 2;
    var M = ganita_mat_new(n, n);
    for (var i = 0; i < n; i = i + 1) {
        for (var j = 0; j < n; j = j + 1) {
            var x = f64_from(0);
            if (i < m && j < m) {
                x = f64_div(f64_from((i * 7 + j * 13) % 17 - 8), f64_from(16));
                if (i == j) { x = f64_add(x, f64_from(4)); }
            }
            if (i < m && j >= m && cpl == 1) { x = f64_div(f64_from((i * 5 + j * 3) % 11 - 5), f64_from(8)); }
            store64(M + 16 + (i * n + j) * 8, x);
        }
    }
    store64(M + 16 + (m * n + m) * 8, c00);
    store64(M + 16 + (m * n + m + 1) * 8, c01);
    store64(M + 16 + ((m + 1) * n + m) * 8, c10);
    store64(M + 16 + ((m + 1) * n + m + 1) * 8, c11);
    return M;
}
var _w2W4_st: i64[2];
fn _w2W4_cn(M) {
    store64(&_w2W4_st, 0 - 1);
    store64(&_w2W4_st + 8, 0 - 1);
    var v: i64[1];
    var rc = _lext_cond(M, &v, &_w2W4_st);
    if (rc != 0) { return 0x7FF8000000000000 + (0 - rc); }   # a NaN that carries the code
    return load64(&v);
}
# [[1, 1 + u], [1 + u, 1 + 2u]] (u = 2^-52, det -2^-104): the f64 elimination loses its pivot
var _w2W4_lp = _w2W4_mk(22, F64_ONE, 0x3FF0000000000001, 0x3FF0000000000001, 0x3FF0000000000002, 0);
assert_eq(_w2W4_cn(_w2W4_lp), 0x46C3E912DC0DC510,
  "cond: B (22 x 22) beside the lost-pivot 2 x 2 -> correctly rounded (merged tree: the same, at 119 ms)");
assert_eq(matrix_condition_number(_w2W4_lp), 0x46C3E912DC0DC510, "cond: matrix_condition_number gives the same");
assert_eq(load64(&_w2W4_st), 6, "cond: that one is certified at 6 limbs");
assert_eq(load64(&_w2W4_st + 8), 1, "cond: ... on the first attempt");
var _w2W4_lc = _w2W4_mk(22, F64_ONE, 0x3FF0000000000001, 0x3FF0000000000001, 0x3FF0000000000002, 1);
assert_eq(_w2W4_cn(_w2W4_lc), 0x46C6ADE4EF574CF7, "cond: the same with B's rows coupled to C -> correctly rounded");
assert_eq(load64(&_w2W4_st), 6, "cond: coupled, certified at 6 limbs");
# a 6 x 6 whose first attempt is refused and whose second, at 8 limbs, is certified
var _w2W4_h6: i64[36];
fn _w2W4_h6_fill() {
    store64(&_w2W4_h6 + 0, 0x4012D15DDDE790B1); store64(&_w2W4_h6 + 8, 0xBFE70C04DC869E96);
    store64(&_w2W4_h6 + 16, 0x3FE05EDE139FA870); store64(&_w2W4_h6 + 24, 0x3FE70A59792D1F7C);
    store64(&_w2W4_h6 + 32, 0xBFE7A619C2358CDE); store64(&_w2W4_h6 + 40, 0xBFEE697900DE0573);
    store64(&_w2W4_h6 + 48, 0xBFEBA288FA6FDFDA); store64(&_w2W4_h6 + 56, 0x400B533130F353D5);
    store64(&_w2W4_h6 + 64, 0x3FEDBEA477184D90); store64(&_w2W4_h6 + 72, 0x3FE91BA9EFB8C495);
    store64(&_w2W4_h6 + 80, 0xBFE527F1DEA05D8C); store64(&_w2W4_h6 + 88, 0x3FE6B01633C29789);
    store64(&_w2W4_h6 + 96, 0xBFEAF2570ED9055D); store64(&_w2W4_h6 + 104, 0xBFE09F177238E9CA);
    store64(&_w2W4_h6 + 112, 0x400A3235A59F9B8A); store64(&_w2W4_h6 + 120, 0xBFED10C722CCDEAF);
    store64(&_w2W4_h6 + 128, 0xBFEE9146C96B9709); store64(&_w2W4_h6 + 136, 0x3FEE8F638439C71E);
    store64(&_w2W4_h6 + 144, 0x3FE8E5CC3D49B1F5); store64(&_w2W4_h6 + 152, 0x3FE741E217467B0A);
    store64(&_w2W4_h6 + 160, 0x3FE95E04DEFF39A0); store64(&_w2W4_h6 + 168, 0x4013BDB916B18A74);
    store64(&_w2W4_h6 + 176, 0x3FE618E9A50A8AEE); store64(&_w2W4_h6 + 184, 0x3FE574C2466037ED);
    for (var q = 24; q < 36; q = q + 1) { store64(&_w2W4_h6 + q * 8, 0); }
    store64(&_w2W4_h6 + 224, 0x4576BCC3EB493828); store64(&_w2W4_h6 + 232, 0x4576BCC3EB49382B);
    store64(&_w2W4_h6 + 272, 0x4576BCC3EB493827); store64(&_w2W4_h6 + 280, 0x4576BCC3EB49382A);
    return 0;
}
_w2W4_h6_fill();
fn _w2W4_mat(n, src) {
    var M = ganita_mat_new(n, n);
    for (var q = 0; q < n * n; q = q + 1) { store64(M + 16 + q * 8, load64(src + q * 8)); }
    return M;
}
assert_eq(_w2W4_cn(_w2W4_mat(6, &_w2W4_h6)), 0x4687B1C1543A26EE,
  "cond: a 6 x 6 (dense 4 x 4, lost-pivot 2 x 2 at 2^88) -> correctly rounded");
assert_eq(load64(&_w2W4_st), 8, "cond: that 6 x 6 is certified at 8 limbs");
assert_eq(load64(&_w2W4_st + 8), 2, "cond: ... on the second attempt (the first, at 6, refused)");
# a 4 x 4 whose one attempt is refused, the exact tier then cheaper than the next
var _w2W4_h4: i64[16];
fn _w2W4_h4_fill() {
    store64(&_w2W4_h4 + 0, 0); store64(&_w2W4_h4 + 8, 0x415ACF7D24F8C258);
    store64(&_w2W4_h4 + 16, 0); store64(&_w2W4_h4 + 24, 0x415ACF7D24F8C255);
    store64(&_w2W4_h4 + 32, 0x4012AA0365840C34); store64(&_w2W4_h4 + 40, 0x3FEDB8E20FA2DCCA);
    store64(&_w2W4_h4 + 48, 0xBFE3369E191ACE5B); store64(&_w2W4_h4 + 56, 0xBFEE0D35B912493C);
    store64(&_w2W4_h4 + 64, 0); store64(&_w2W4_h4 + 72, 0x415ACF7D24F8C256);
    store64(&_w2W4_h4 + 80, 0); store64(&_w2W4_h4 + 88, 0x415ACF7D24F8C253);
    store64(&_w2W4_h4 + 96, 0xBFEA5D45A73199DD); store64(&_w2W4_h4 + 104, 0x3FE824A633DB5463);
    store64(&_w2W4_h4 + 112, 0x401297FA2CE1F048); store64(&_w2W4_h4 + 120, 0x3FE363C865BCC35B);
    return 0;
}
_w2W4_h4_fill();
assert_eq(_w2W4_cn(_w2W4_mat(4, &_w2W4_h4)), 0x467F493400E1AD11, "cond: a lost-pivot 4 x 4 -> correctly rounded");
assert_eq(load64(&_w2W4_st), 0, "cond: that 4 x 4 is answered by the exact tier ...");
assert_eq(load64(&_w2W4_st + 8), 1, "cond: ... after one extended attempt");
# the 2 x 2 alone: the exact tier at once (its integers are no wider than 8 limbs)
assert_eq(_w2W4_cn(_w2W4_mk(0, F64_ONE, 0x3FF0000000000001, 0x3FF0000000000001, 0x3FF0000000000002, 0)),
  0x4690000000000002, "cond: the lost-pivot 2 x 2 -> 2^106 (1 + 2^-51), correctly rounded");
assert_eq(load64(&_w2W4_st + 8), 0, "cond: the 2 x 2 goes to the exact tier with no extended attempt");
# past DBL_MAX through the extended tier: C scaled by 2^-1000, its inverse's entries near 2^1104
assert_eq(_w2W4_cn(_w2W4_mk(22, 0x0170000000000000, 0x0170000000000001, 0x0170000000000001, 0x0170000000000002, 1)),
  F64_POS_INF, "cond: that coupled 24 x 24 with C at 2^-1000 -> +Inf (exact: past DBL_MAX)");
assert_eq(load64(&_w2W4_st), 6, "cond: ... certified at 6 limbs, then rounded past DBL_MAX");
# one attempt at a given precision, on the coupled 24 x 24: refused at 4 limbs with the loss unmeasured
# (|R| too large), refused at 5 with the 123 bits it lost (150 - 123 < 70), certified at 6; the uncoupled
# one is certified at 3, since Gauss-Jordan at 90 bits inverts its 2 x 2 exactly
var _w2W4_n = 24;
var _w2W4_xn: i64[3];
var _w2W4_ls: i64[1];
assert_eq(_lext_hf_try(_w2W4_lc + 16, _w2W4_n, 4, &_w2W4_xn, 0, &_w2W4_ls), 0, "_lext_hf_try: coupled, 4 limbs -> 0");
assert_eq(load64(&_w2W4_ls), 0 - 1, "_lext_hf_try: coupled, 4 limbs: |R| too large to measure a loss (-1)");
assert_eq(_lext_hf_try(_w2W4_lc + 16, _w2W4_n, 5, &_w2W4_xn, 0, &_w2W4_ls), 0, "_lext_hf_try: coupled, 5 limbs -> 0");
assert_eq(load64(&_w2W4_ls), 123, "_lext_hf_try: coupled, 5 limbs: 123 bits lost (more than 150 - 70)");
assert_eq(_lext_hf_try(_w2W4_lc + 16, _w2W4_n, 6, &_w2W4_xn, 0, &_w2W4_ls), 1, "_lext_hf_try: coupled, 6 limbs -> 1");
assert_eq(_lext_hf_try(_w2W4_lp + 16, _w2W4_n, 3, &_w2W4_xn, 0, &_w2W4_ls), 1, "_lext_hf_try: uncoupled, 3 limbs -> 1");
# the certificate itself: Gauss-Jordan at 8 limbs on the uncoupled 24 x 24, then Y's (23, 22) (2^104 in
# size) moved by 2^-80 and by 2^-66. R = I - M Y moves by M's column 23 times that, |Y| |R| by about
# 2^104 times it, against 2^-70 ||X||_F, about 2^34: 2^-80 stays certified, 2^-66 is refused (the
# transition sits between 2^-73 and 2^-72, scratch probe2.tcyr). (The true error 2^-66 is far below
# 2^-70 ||X||_F: a residual bound pays cond(M) for an error placed in Y, which Gauss-Jordan's own
# errors do not escape either.)
var _w2W4_P = 8;
var _w2W4_S = (_w2W4_P + 3) * 8;
var _w2W4_G = alloc(2 * _w2W4_n * _w2W4_n * _w2W4_S);
var _w2W4_rp = alloc(_w2W4_n * 8);
var _w2W4_sc = alloc(_w2W4_n * 8);
var _w2W4_ws = alloc((10 * _w2W4_P + 29) * 8);
var _w2W4_dd = alloc(40 * 8);
var _w2W4_dw = alloc(40 * 8);
assert_eq(_lext_hf_try(_w2W4_lp + 16, _w2W4_n, 8, &_w2W4_xn, 0, &_w2W4_ls), 1, "_lext_hf_try: uncoupled, 8 limbs -> 1");
fn _w2W4_gj() {
    for (var r = 0; r < _w2W4_n; r = r + 1) {
        var mx = f64_from(0);
        for (var c = 0; c < _w2W4_n; c = c + 1) {
            var a = f64_abs(load64(_w2W4_lp + 16 + (r * _w2W4_n + c) * 8));
            if (f64_gt(a, mx) == 1) { mx = a; }
        }
        store64(_w2W4_sc + r * 8, 0 - _lext_xexp(mx));
    }
    return _lext_hf_gj(_w2W4_lp + 16, _w2W4_n, _w2W4_P, _w2W4_sc, _w2W4_G, _w2W4_rp, _w2W4_ws);
}
fn _w2W4_cert() { return _lext_hf_cert(_w2W4_lp + 16, _w2W4_n, _w2W4_P, _w2W4_sc, _w2W4_rp, &_w2W4_xn, &_w2W4_ls); }
fn _w2W4_ybump(de) {
    var y = load64(_w2W4_rp + 23 * 8) + (_w2W4_n + 22) * _w2W4_S;
    _lext_hf_f64(_w2W4_dd, F64_ONE, de);
    _lext_hf_acc(y, _w2W4_dd, 0, _w2W4_P, _w2W4_dw);
    return 0;
}
assert_eq(_w2W4_gj(), 0, "_lext_hf_gj: the 24 x 24 at 8 limbs -> 0");
assert_eq(_w2W4_cert(), 1, "_lext_hf_cert: its Y -> 1, certified");
_w2W4_ybump(0 - 80);
assert_eq(_w2W4_cert(), 1, "_lext_hf_cert: Y's (23, 22) moved by 2^-80 -> still 1");
assert_eq(_w2W4_gj(), 0, "_lext_hf_gj: the 24 x 24 at 8 limbs, again -> 0");
_w2W4_ybump(0 - 66);
assert_eq(_w2W4_cert(), 0, "_lext_hf_cert: Y's (23, 22) moved by 2^-66 -> 0, refused");
assert_eq(load64(&_w2W4_ls), 177, "_lext_hf_cert: ... the loss it reports, 177 bits (240 - 177 < 70)");
# Y halved: R = I - M Y / 2 = I / 2 to rounding, so ||R||_inf is about 1/2, past the 1/4 the bound needs
# (rho / (1 - rho) <= 2 rho): refused with the loss unmeasured
fn _w2W4_yscale(f) {
    for (var i = 0; i < _w2W4_n; i = i + 1) {
        for (var j = 0; j < _w2W4_n; j = j + 1) {
            var y = load64(_w2W4_rp + i * 8) + (_w2W4_n + j) * _w2W4_S;
            if (load64(y + 16) != 0) {
                _lext_hf_f64(_w2W4_dd, f, 0);
                _lext_bn_mul(y + 8, _w2W4_dd + 8, _w2W4_dw + 8);
                store64(_w2W4_dw, load64(y) + load64(_w2W4_dd));
                _lext_hf_cut(_w2W4_dw, y, _w2W4_P);
            }
        }
    }
    return 0;
}
assert_eq(_w2W4_gj(), 0, "_lext_hf_gj: the 24 x 24 at 8 limbs, a third time -> 0");
_w2W4_yscale(F64_HALF);
assert_eq(_w2W4_cert(), 0, "_lext_hf_cert: Y / 2 -> 0, refused");
assert_eq(load64(&_w2W4_ls), 0 - 1, "_lext_hf_cert: Y / 2 -> its loss unmeasured (-1: ||R|| near 1/2)");
# every entry of Y set to 2^89 (top limb 2^29 at limb 2): every residual entry is a same-sign sum of up to 24
# such products, 2^93 and more, which needs the grid's two limbs of headroom above its largest product
fn _w2W4_yfill() {
    for (var i = 0; i < _w2W4_n; i = i + 1) {
        for (var j = 0; j < _w2W4_n; j = j + 1) {
            _lext_hf_f64(load64(_w2W4_rp + i * 8) + (_w2W4_n + j) * _w2W4_S, 0x4580000000000000, 0);   # 2^89
        }
    }
    return 0;
}
_w2W4_yfill();
assert_eq(_w2W4_cert(), 0, "_lext_hf_cert: Y = 2^89 everywhere (a coherent residual near 2^93) -> 0, refused");
# _lext_fdiv: a floor, also for a negative numerator
assert_eq(_lext_fdiv(0 - 7, 2), 0 - 4, "_lext_fdiv: -7 / 2 -> -4 (floor; an i64 division gives -3)");
assert_eq(_lext_fdiv(0 - 6, 2), 0 - 3, "_lext_fdiv: -6 / 2 -> -3");
assert_eq(_lext_fdiv(7, 2), 3, "_lext_fdiv: 7 / 2 -> 3");
# a zero column: no pivot at all
var _w2W4_z = _w2W4_mat(2, &_w2W4_h4);
store64(_w2W4_z + 16, F64_ONE); store64(_w2W4_z + 24, 0); store64(_w2W4_z + 32, F64_ONE); store64(_w2W4_z + 40, 0);
store64(_w2W4_sc, 0); store64(_w2W4_sc + 8, 0);
assert_eq(_lext_hf_gj(_w2W4_z + 16, 2, 6, _w2W4_sc, _w2W4_G, _w2W4_rp, _w2W4_ws), 1,
  "_lext_hf_gj: [[1, 0], [1, 0]] -> 1");

# === 3.5.0 W4: the extended tier's arithmetic ===
test_group("3.5.0 W4: the extended tier's arithmetic (hf values, the reciprocal, the root)");
var _w2W4_x = alloc(40 * 8);
var _w2W4_t = alloc(40 * 8);
var _w2W4_w = alloc(40 * 8);
var _w2W4_r = alloc(40 * 8);
var _w2W4_wr = alloc(200 * 8);
fn _w2W4_is(b, e, s, nl, top) {   # 1 when b is [e, s, nl] with top limb `top` and every lower limb 0
    if (load64(b) != e || load64(b + 8) != s || load64(b + 16) != nl) { return 0; }
    if (nl == 0) { return 1; }
    if (load64(b + 24 + (nl - 1) * 8) != top) { return 0; }
    for (var i = 0; i < nl - 1; i = i + 1) {
        if (load64(b + 24 + i * 8) != 0) { return 0; }
    }
    return 1;
}
_lext_hf_f64(_w2W4_x, F64_ONE, 0);
assert_eq(_w2W4_is(_w2W4_x, 0 - 2, 1, 3, 1), 1, "_lext_hf_f64: 1 -> 2^60 2^(30 (-2)), three limbs");
_lext_hf_f64(_w2W4_x, f64_from(3), 0);
_lext_hf_f64(_w2W4_t, f64_from(3), 0);
_lext_hf_acc(_w2W4_x, _w2W4_t, 1, 6, _w2W4_w);
assert_eq(_w2W4_is(_w2W4_x, 0, 0, 0, 0), 1, "_lext_hf_acc: 3 - 3 -> 0 (sign 0, no limbs)");
_lext_hf_f64(_w2W4_x, F64_ONE, 0);
_lext_hf_acc(_w2W4_x, _w2W4_t, 1, 6, _w2W4_w);
assert_eq(_w2W4_is(_w2W4_x, 0 - 2, 0 - 1, 3, 2), 1, "_lext_hf_acc: 1 - 3 -> -2 (the two's complement path)");
_lext_hf_f64(_w2W4_x, 0, 0);
_lext_hf_f64(_w2W4_t, f64_from(5), 0);
_lext_hf_acc(_w2W4_x, _w2W4_t, 1, 6, _w2W4_w);
assert_eq(_w2W4_is(_w2W4_x, 0 - 2, 0 - 1, 3, 5), 1, "_lext_hf_acc: 0 - 5 -> -5");
_lext_hf_f64(_w2W4_x, 0x41D0000000000000, 0);
_lext_hf_f64(_w2W4_t, 0x41D0000004000000, 0);
_lext_hf_acc(_w2W4_x, _w2W4_t, 1, 6, _w2W4_w);
assert_eq(_w2W4_is(_w2W4_x, 0 - 1, 0 - 1, 2, 0x10), 1,
  "_lext_hf_acc: 2^30 - (2^30 + 16) -> -16, a borrow across limbs");
# 1 + 2^-200 kept to 6 limbs (180 bits: the 2^-200 dropped) and to 8 (kept)
_lext_hf_f64(_w2W4_x, F64_ONE, 0);
_lext_hf_f64(_w2W4_t, 0x3370000000000000, 0);
_lext_hf_acc(_w2W4_x, _w2W4_t, 0, 6, _w2W4_w);
assert_eq(_w2W4_is(_w2W4_x, 0 - 5, 1, 6, 1), 1, "_lext_hf_acc: 1 + 2^-200 at 6 limbs -> 1, the rest truncated");
_lext_hf_f64(_w2W4_x, F64_ONE, 0);
_lext_hf_acc(_w2W4_x, _w2W4_t, 0, 8, _w2W4_w);
assert_eq(load64(_w2W4_x), 0 - 7, "_lext_hf_acc: 1 + 2^-200 at 8 limbs, e = -7");
assert_eq(load64(_w2W4_x + 16), 8, "_lext_hf_acc: ... 8 limbs");
assert_eq(load64(_w2W4_x + 24), 0x400, "_lext_hf_acc: ... the lowest 2^10 (2^-200 = 2^10 2^(30 (-7)))");
assert_eq(load64(_w2W4_x + 80), 1, "_lext_hf_acc: ... the top 1");
# 1/3 at 6 limbs: every limb 0x15555555 = floor(2^30 / 3), so 1 - 3 r = 2^-180 exactly
_lext_hf_f64(_w2W4_t, f64_from(3), 0);
_lext_hf_recip(_w2W4_t, _w2W4_r, 6, _w2W4_wr);
assert_eq(load64(_w2W4_r), 0 - 6, "_lext_hf_recip: 1/3, e = -6");
assert_eq(load64(_w2W4_r + 16), 6, "_lext_hf_recip: 1/3, 6 limbs");
assert_eq(load64(_w2W4_r + 24), 0x15555555, "_lext_hf_recip: 1/3, its lowest limb");
assert_eq(load64(_w2W4_r + 64), 0x15555555, "_lext_hf_recip: 1/3, its top limb");
_lext_bn_mul(_w2W4_t + 8, _w2W4_r + 8, _w2W4_w + 8);
store64(_w2W4_w, load64(_w2W4_t) + load64(_w2W4_r));
_lext_hf_f64(_w2W4_x, F64_ONE, 0);
_lext_hf_acc(_w2W4_x, _w2W4_w, 1, 7, _w2W4_wr);
assert_eq(_w2W4_is(_w2W4_x, 0 - 8, 1, 3, 1), 1, "_lext_hf_recip: 1 - 3 r = 2^-180 (2^60 2^(30 (-8)))");
# _lext_hf_up: an upper bound, one subnormal unit past DBL_MIN's floor
_lext_hf_f64(_w2W4_x, f64_from(3), 0);
assert_eq(_lext_hf_up(_w2W4_x, 0), 0x4008000000000018, "_lext_hf_up: 3 -> 3 (1 + 2^-48), exact");
assert_eq(_lext_hf_up(_w2W4_x, 2000), 1, "_lext_hf_up: 3 2^-2000 -> 2^-1074 (flushed, then one unit up)");
# the root of a double-double: x = 1 + 2^-52 + 2^-53 + 2^-60, x^2 = h + l with h = 1 + 3 2^-52
# (3FF0000000000003) and l = 3C40000000000122: sqrt(h) rounds to 1 + 2^-52, sqrt(h + l) = x to 1 + 2^-51
var _w2W4_sw: i64[3];
var _w2W4_so: i64[2];
store64(&_w2W4_sw, 0x3FE0000000000003); store64(&_w2W4_sw + 8, 0x3C30000000000122); store64(&_w2W4_sw + 16, 1);
_lext_w_sqrt(&_w2W4_sw, &_w2W4_so);
assert_eq(load64(&_w2W4_so), 0x3FE0000000000002,
  "_lext_w_sqrt: x^2 -> m = (1 + 2^-51) / 2 (sqrt of the high part alone: ...001)");
assert_eq(load64(&_w2W4_so + 8), 1, "_lext_w_sqrt: ... e = 1");
store64(&_w2W4_sw, F64_HALF); store64(&_w2W4_sw + 8, 0); store64(&_w2W4_sw + 16, 2);
_lext_w_sqrt(&_w2W4_sw, &_w2W4_so);
assert_eq(load64(&_w2W4_so), 0x3FE6A09E667F3BCD, "_lext_w_sqrt: 2 -> sqrt(2) / 2, correctly rounded");
assert_eq(load64(&_w2W4_so + 8), 1, "_lext_w_sqrt: 2 -> e = 1");
# `_lext_inv_exact`'s entries: [[0, 2], [3, 0]]^-1 = [[0, 1/3], [1/2, 0]]
var _w2W4_e2: i64[4];
var _w2W4_eo: i64[4];
var _w2W4_ew: i64[3];
store64(&_w2W4_e2, 0); store64(&_w2W4_e2 + 8, 0x4000000000000000);
store64(&_w2W4_e2 + 16, 0x4008000000000000); store64(&_w2W4_e2 + 24, 0);
assert_eq(_lext_inv_exact(&_w2W4_e2, 2, &_w2W4_ew, &_w2W4_eo), 0, "_lext_inv_exact: [[0, 2], [3, 0]] -> 0");
assert_eq(load64(&_w2W4_eo + 8), 0x3FD5555555555555, "_lext_inv_exact: its (0, 1) = 1/3, correctly rounded");
assert_eq(load64(&_w2W4_eo + 16), F64_HALF, "_lext_inv_exact: its (1, 0) = 1/2");
assert_eq(load64(&_w2W4_eo), 0, "_lext_inv_exact: its (0, 0) = +0");

# === 3.5.0 W4: cmat_inverse past cond = 1/u, and cmat_inverse_checked ===
# The real form [[Re m, -Im m], [Im m, Re m]] of an m whose elimination lost a pivot is inverted in the
# extended tier; through 3.5.0 wave 1 cmat_inverse answered 0 (as singular) on every one.
test_group("3.5.0 W4: cmat_inverse past cond = 1/u; cmat_inverse_checked");
fn _w2W4_c2(ar, ai, br, bi, cr, ci, dr, di) {
    var m = cmat_new(2, 2);
    var md = load64(m + 16);
    store64(md, ar); store64(md + 8, ai); store64(md + 16, br); store64(md + 24, bi);
    store64(md + 32, cr); store64(md + 40, ci); store64(md + 48, dr); store64(md + 56, di);
    return m;
}
fn _w2W4_ce(X, n, i, j, im) {
    if (X == 0) { return 0x7FF8000000000BAD; }   # (a refused inverse: a NaN no entry here can be)
    return load64(load64(X + 16) + (i * n + j) * 16 + im * 8);
}
# [[1, 1 + u], [1 + u, 1 + 2u]]^-1 = -2^104 [[1 + 2u, -(1 + u)], [-(1 + u), 1]], every entry a double
var _w2W4_ci = cmat_inverse(_w2W4_c2(F64_ONE, 0, 0x3FF0000000000001, 0, 0x3FF0000000000001, 0, 0x3FF0000000000002, 0));
assert_neq(_w2W4_ci, 0, "cmat_inverse: the lost-pivot 2 x 2 is answered (merged tree: 0)");
assert_eq(_w2W4_ce(_w2W4_ci, 2, 0, 0, 0), 0xC670000000000002, "cmat_inverse: (0, 0) = -2^104 (1 + 2u)");
assert_eq(_w2W4_ce(_w2W4_ci, 2, 0, 1, 0), 0x4670000000000001, "cmat_inverse: (0, 1) = 2^104 (1 + u)");
assert_eq(_w2W4_ce(_w2W4_ci, 2, 1, 0, 0), 0x4670000000000001, "cmat_inverse: (1, 0) = 2^104 (1 + u)");
assert_eq(_w2W4_ce(_w2W4_ci, 2, 1, 1, 0), 0xC670000000000000, "cmat_inverse: (1, 1) = -2^104");
assert_eq(_w2W4_ce(_w2W4_ci, 2, 1, 1, 1), 0, "cmat_inverse: (1, 1) im = +0 (its sign as the real form's 0 gives it)");
# (1 + i) times it: the inverse is (1 - i) / 2 times the one above
var _w2W4_cj = cmat_inverse(_w2W4_c2(F64_ONE, F64_ONE, 0x3FF0000000000001, 0x3FF0000000000001, 0x3FF0000000000001,
    0x3FF0000000000001, 0x3FF0000000000002, 0x3FF0000000000002));
assert_eq(_w2W4_ce(_w2W4_cj, 2, 0, 0, 0), 0xC660000000000002, "cmat_inverse: (1 + i) A, (0, 0) re = -2^103 (1 + 2u)");
assert_eq(_w2W4_ce(_w2W4_cj, 2, 0, 0, 1), 0x4660000000000002, "cmat_inverse: (1 + i) A, (0, 0) im = 2^103 (1 + 2u)");
assert_eq(_w2W4_ce(_w2W4_cj, 2, 1, 0, 1), 0xC660000000000001, "cmat_inverse: (1 + i) A, (1, 0) im = -2^103 (1 + u)");
# 4 x 4: complex B (2 x 2) coupled to the real lost-pivot C; its 8 x 8 real form certified at 8 limbs
fn _w2W4_ck(m) {
    var n = m + 2;
    var M = cmat_new(n, n);
    var md = load64(M + 16);
    for (var i = 0; i < n; i = i + 1) {
        for (var j = 0; j < n; j = j + 1) {
            var xr = f64_from(0);
            var xi = f64_from(0);
            if (i < m && j < m) {
                xr = f64_div(f64_from((i * 7 + j * 13) % 17 - 8), f64_from(16));
                if (i == j) { xr = f64_add(xr, f64_from(4)); }
                xi = f64_div(f64_from((i * 3 + j * 5) % 13 - 6), f64_from(16));
            }
            if (i < m && j >= m) {
                xr = f64_div(f64_from((i * 5 + j * 3) % 11 - 5), f64_from(8));
                xi = f64_div(f64_from((i + j) % 7 - 3), f64_from(8));
            }
            store64(md + (i * n + j) * 16, xr);
            store64(md + (i * n + j) * 16 + 8, xi);
        }
    }
    store64(md + (m * n + m) * 16, F64_ONE);
    store64(md + (m * n + m + 1) * 16, 0x3FF0000000000001);
    store64(md + ((m + 1) * n + m) * 16, 0x3FF0000000000001);
    store64(md + ((m + 1) * n + m + 1) * 16, 0x3FF0000000000002);
    return M;
}
fn _w2W4_cinv(m) {
    store64(&_w2W4_st, 0 - 1);
    store64(&_w2W4_st + 8, 0 - 1);
    var v: i64[1];
    if (_lext_cinv(m, &v, &_w2W4_st) != 0) { return 0; }
    return load64(&v);
}
var _w2W4_ck4 = _w2W4_cinv(_w2W4_ck(2));
assert_eq(load64(&_w2W4_st), 8, "cmat_inverse: the coupled 4 x 4's real form is certified at 8 limbs");
assert_eq(_w2W4_ce(_w2W4_ck4, 4, 0, 0, 0), 0x3FD20C6B75FCE0E2, "cmat_inverse: coupled 4 x 4, (0, 0) re");
assert_eq(_w2W4_ce(cmat_inverse(_w2W4_ck(2)), 4, 0, 0, 0), 0x3FD20C6B75FCE0E2,
  "cmat_inverse: the same through the API");
assert_eq(_w2W4_ce(_w2W4_ck4, 4, 0, 0, 1), 0x3F9DAA6F287555B0, "cmat_inverse: coupled 4 x 4, (0, 0) im");
assert_eq(_w2W4_ce(_w2W4_ck4, 4, 0, 2, 0), 0xC637B6BAE188F82F, "cmat_inverse: coupled 4 x 4, (0, 2) re");
assert_eq(_w2W4_ce(_w2W4_ck4, 4, 0, 2, 1), 0xC626A93DAE305D34, "cmat_inverse: coupled 4 x 4, (0, 2) im");
assert_eq(_w2W4_ce(_w2W4_ck4, 4, 1, 3, 0), 0x463A2BD239E6BFAC, "cmat_inverse: coupled 4 x 4, (1, 3) re");
assert_eq(_w2W4_ce(_w2W4_ck4, 4, 1, 3, 1), 0x46226094FBEDBFB9, "cmat_inverse: coupled 4 x 4, (1, 3) im");
assert_eq(_w2W4_ce(_w2W4_ck4, 4, 2, 2, 0), 0xC670000000000002, "cmat_inverse: coupled 4 x 4, (2, 2) re = C^-1's");
# a 6 x 6 (dense complex 4 x 4 coupled to a complex lost-pivot 2 x 2, from a generator) whose first
# attempt at 6 limbs loses every bit (the loss unmeasured), so the second takes 2 P = 12 limbs
var _w2W4_c6: i64[72];
fn _w2W4_c6_fill() {
    store64(&_w2W4_c6 + 0, 0x4012E7FEC53DC9CF); store64(&_w2W4_c6 + 8, 0x3FE0FF0357F0C0D4);
    store64(&_w2W4_c6 + 16, 0x3FEE82DAFEF88024); store64(&_w2W4_c6 + 24, 0xBFEC29DF0A64FB10);
    store64(&_w2W4_c6 + 32, 0x3FE568EB8165F674); store64(&_w2W4_c6 + 40, 0xBFE43101B7C0BAC6);
