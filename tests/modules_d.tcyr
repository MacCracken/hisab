# ==================================================================================================
# 3.5.0 wave 2 — collision: the rim ring, the deep snap, the refusal sweep (geo_advanced)
# ==================================================================================================
# (Written as tests/w2_W3.tcyr; every global and fn below is prefixed _w2W3_.)

# ==================================================================================================
test_group("3.5.0 W3: a ball over a cylinder's cap by its rim is a contact (F-CO7-2)");
# The cylinder and ball supports of tests/modules.tcyr's review pass CO8 group (a cylinder about any unit
# axis u, half height hz along it; the ball through its centre plus r d / |d|), on which the roadmap's
# repro reads a miss. Scenes: the roadmap's, then families of balls over a cap with 1 - rho/R from
# 1e-12 to 1e-6, the centre inside the rim's circle ("in") or past it ("out"), depths 5 to 90 eps
# (eps = 2^-46 M, M the largest |coordinate| of either shape). Each was a miss or a depth past 4 eps
# under one of the repair's parts removed (the mutant named), and every pinned depth is this tree's,
# within 0.009 eps of the exact depth: r - (|z| - hz |u|) over a cap (the support's caps are c +- hz u),
# r - sqrt((rho - R)^2 + (|z| - hz |u|)^2) past the rim, in 120-digit Decimal from the f64 inputs. Through
# the wave-2 review these messages' exact depths took the half height as hz, up to 1.3e-16 off.
# [measured: scratch W3 py/fam1.py, dump.py and disc.py (seeds 1 and 4), this tree and its mutants; 2026-11-14]
# [measured: scratch W3 fix py/pinerr.py (120-digit Decimal, M exact) on this group's scenes; 2026-11-14]
var _w2W3_calls = 0;
fn _w2W3_sup_ball(sh, d) {
    _w2W3_calls = _w2W3_calls + 1;
    var l = f64_sqrt(hvec3_dot(d, d));
    var k = 0;
    if (f64_gt(l, 0) == 1) { k = f64_div(load64(sh + 24), l); }
    return hvec3_new(f64_add(load64(sh), f64_mul(HVec3_x(d), k)), f64_add(load64(sh + 8), f64_mul(HVec3_y(d), k)),
      f64_add(load64(sh + 16), f64_mul(HVec3_z(d), k)));
}
fn _w2W3_sup_cyl(sh, d) {
    _w2W3_calls = _w2W3_calls + 1;
    var ux = load64(sh + 24);
    var uy = load64(sh + 32);
    var uz = load64(sh + 40);
    var dx = HVec3_x(d);
    var dy = HVec3_y(d);
    var dz = HVec3_z(d);
    var du = f64_add(f64_add(f64_mul(dx, ux), f64_mul(dy, uy)), f64_mul(dz, uz));
    var px = f64_sub(dx, f64_mul(du, ux));
    var py = f64_sub(dy, f64_mul(du, uy));
    var pz = f64_sub(dz, f64_mul(du, uz));
    var dp = f64_add(f64_add(f64_mul(px, ux), f64_mul(py, uy)), f64_mul(pz, uz));
    px = f64_sub(px, f64_mul(dp, ux));
    py = f64_sub(py, f64_mul(dp, uy));
    pz = f64_sub(pz, f64_mul(dp, uz));
    var pl = f64_sqrt(f64_add(f64_add(f64_mul(px, px), f64_mul(py, py)), f64_mul(pz, pz)));
    var k = 0;
    if (f64_gt(pl, f64_mul(f64_sqrt(hvec3_dot(d, d)), 0x3CF0000000000000)) == 1) {  # 2^-48
        k = f64_div(load64(sh + 48), pl);
    }
    var h = load64(sh + 56);
    if (f64_lt(du, 0) == 1) { h = f64_neg(h); }
    return hvec3_new(f64_add(f64_add(load64(sh), f64_mul(ux, h)), f64_mul(px, k)),
      f64_add(f64_add(load64(sh + 8), f64_mul(uy, h)), f64_mul(py, k)),
      f64_add(f64_add(load64(sh + 16), f64_mul(uz, h)), f64_mul(pz, k)));
}
var _w2W3_c = alloc(64);
var _w2W3_b = alloc(32);
var _w2W3_n = alloc(8);
var _w2W3_d = alloc(8);
var _w2W3_t = alloc(8);
fn _w2W3_cyl(c0, c1, c2, u0, u1, u2, r, hz) {
    store64(_w2W3_c, c0);
    store64(_w2W3_c + 8, c1);
    store64(_w2W3_c + 16, c2);
    store64(_w2W3_c + 24, u0);
    store64(_w2W3_c + 32, u1);
    store64(_w2W3_c + 40, u2);
    store64(_w2W3_c + 48, r);
    store64(_w2W3_c + 56, hz);
    return 0;
}
fn _w2W3_ball(b0, b1, b2, r) {
    store64(_w2W3_b, b0);
    store64(_w2W3_b + 8, b1);
    store64(_w2W3_b + 16, b2);
    store64(_w2W3_b + 24, r);
    return 0;
}
# Entry 0 gjk_epa_3d, 1 mpr_penetration (the depth's bits, -1 for a miss); 2 gjk_intersect_3d, 3
# mpr_intersect (the verdict); 4 time_of_impact at rest (1 for an impact at t = +0, else -1). The
# cylinder first; 5 is gjk_epa_3d with the ball first.
fn _w2W3_q(entry) {
    var z = hvec3_zero();
    store64(_w2W3_d, 0);
    if (entry == 2) { return gjk_intersect_3d(&_w2W3_sup_cyl, _w2W3_c, &_w2W3_sup_ball, _w2W3_b); }
    if (entry == 3) { return mpr_intersect(&_w2W3_sup_cyl, _w2W3_c, &_w2W3_sup_ball, _w2W3_b); }
    if (entry == 4) {
        if (time_of_impact(&_w2W3_sup_cyl, _w2W3_c, z, &_w2W3_sup_ball, _w2W3_b, z, F64_ONE, _w2W3_t, _w2W3_n) == 1) {
            if (load64(_w2W3_t) == 0) { return 1; }
        }
        return 0 - 1;
    }
    var k = 0;
    if (entry == 0) { k = gjk_epa_3d(&_w2W3_sup_cyl, _w2W3_c, &_w2W3_sup_ball, _w2W3_b, _w2W3_n, _w2W3_d); }
    if (entry == 1) { k = mpr_penetration(&_w2W3_sup_cyl, _w2W3_c, &_w2W3_sup_ball, _w2W3_b, _w2W3_n, _w2W3_d); }
    if (entry == 5) { k = gjk_epa_3d(&_w2W3_sup_ball, _w2W3_b, &_w2W3_sup_cyl, _w2W3_c, _w2W3_n, _w2W3_d); }
    if (k != 1) { return 0 - 1; }
    return load64(_w2W3_d);
}
# The roadmap's scene: R 0.9529, hz 1.30, 1 - rho/R 1.27e-9, exact depth 2.4151475988380264e-11 (rounds to
# 0x3DBA8E09408F5BA6), answered 0x3DBA8E0680000000, 0.002 eps below it (the first wave-2 form, taking the
# lower of a tie: 0x3DBA8D8A00000000, 0.078 eps below). 3.4.2: a miss from all five entries, both orders.
# Without the rim ring (both calls) every answer here is a miss.
# [measured: scratch W3 py/t1.py and r1/r1.cyr (120-digit Decimal), base and this tree; 2026-11-14]
_w2W3_cyl(0, 0, 0, 0x3FDEC52278832907, 0x3FEBF3777A16626A, 0xBFB3A95058ECC51E, 0x3FEE7E8EA65106AC,
  0x3FF4CCBB9D4EA828);
_w2W3_ball(0xBFF1AE7133FE37DC, 0xBFEE6E9C63A92831, 0xBFE67A6B12AD89CC, 0x3F807A643D37EE23);
assert_eq(_w2W3_q(2), 1, "gjk_intersect_3d: the roadmap's ball over a cap 1.27e-9 R inside its rim is a contact");
assert_eq(_w2W3_q(3), 1, "mpr_intersect: ... a contact");
assert_eq(_w2W3_q(4), 1, "time_of_impact: ... an impact at t = 0");
