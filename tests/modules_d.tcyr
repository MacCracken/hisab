# (mixed seed 5 row 1171: exact 0x3FCE324B33C18B96; 3.4.2 and base 0x3FCE324B33C18B95, 0.66 ulp)
var _w2W2_d_r = _w2W2_ray(0x40228FBD9B8F61DD, 0xC01CFCDE9EE0DEA3, 0xBFEDBE2B9FF7B9EA, 0xC020B84B2349D887,
  0xBFF13363B697D79C, 0xC013F40CB649E349);
