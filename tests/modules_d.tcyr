# (the sweep alone: NaN). Forward mode gives 3.
fn _w2W6_own(cut) {
    var t = ad_tape_new(64);
    var y = ad_var(t, 0);
    var z = ad_var(t, 0);
    var x = ad_var(t, 0x01A56E1FC2F8F359);    # 1e-300
