# (spread2 seed 1 row 594: exact 0x16487D32E4820EDC; 3.4.2 and base 0x0000000000000000, 6893056976621276.00 ulp)
var _w2W2_h_r = _w2W2_ray(0x342A806E8099FC48, 0x233D63FC362825CE, 0x2396F7F24EF931A8, 0x61453778AAF55550,
  0x5C84D4E89AE75F2A, 0x67FD491DFA287E5D);
