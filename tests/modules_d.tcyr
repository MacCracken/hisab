    store64(&_w2W4_c6 + 96, 0xBFE1BF194F16F5CB); store64(&_w2W4_c6 + 104, 0xBFED2D73C86E3426);
    store64(&_w2W4_c6 + 112, 0x40086E827FDCEBB5); store64(&_w2W4_c6 + 120, 0x3FE9A9DCB40F6A86);
    store64(&_w2W4_c6 + 128, 0x3FEBDB638A7A15A6); store64(&_w2W4_c6 + 136, 0x3FE38079266DBDDF);
    store64(&_w2W4_c6 + 144, 0xBFE50526FB1019D3); store64(&_w2W4_c6 + 152, 0xBFEA3470C0BA2072);
    store64(&_w2W4_c6 + 160, 0xBFEAC476C32C1396); store64(&_w2W4_c6 + 168, 0xBFE095E1B5BA600A);
    store64(&_w2W4_c6 + 176, 0x3FE8B12EACE95466); store64(&_w2W4_c6 + 184, 0x3FE2AD352AF1911A);
    store64(&_w2W4_c6 + 192, 0xBFE5757F191E4906); store64(&_w2W4_c6 + 200, 0x3FEF76256C5BD696);
    store64(&_w2W4_c6 + 208, 0x3FEC98537F2C1F3F); store64(&_w2W4_c6 + 216, 0x3FE11189999C7D6A);
    store64(&_w2W4_c6 + 224, 0x4009396E810DB908); store64(&_w2W4_c6 + 232, 0x3FEF0853D371802C);
    store64(&_w2W4_c6 + 240, 0xBFE0A3876A04EF84); store64(&_w2W4_c6 + 248, 0xBFEA0EAAAD97DE56);
    store64(&_w2W4_c6 + 256, 0x3FEE5C9DF79E3CEA); store64(&_w2W4_c6 + 264, 0x3FED931CCC379D75);
    store64(&_w2W4_c6 + 272, 0x3FE08B9526719C19); store64(&_w2W4_c6 + 280, 0xBFE9023E36CB3BC0);
    store64(&_w2W4_c6 + 288, 0xBFEC41830D1A199E); store64(&_w2W4_c6 + 296, 0xBFE4B16156620044);
    store64(&_w2W4_c6 + 304, 0x3FEE228AF4E8808C); store64(&_w2W4_c6 + 312, 0xBFEC4525918766DA);
    store64(&_w2W4_c6 + 320, 0x3FE6C50BC7780DD2); store64(&_w2W4_c6 + 328, 0xBFEA63E9FF1C07F5);
    store64(&_w2W4_c6 + 336, 0x4013C7114D06DE2F); store64(&_w2W4_c6 + 344, 0xBFE0BDDF4AA26D85);
    store64(&_w2W4_c6 + 352, 0x3FE4AAD472DDC481); store64(&_w2W4_c6 + 360, 0xBFED6535DC36AC71);
    store64(&_w2W4_c6 + 368, 0x3FE631FC5F719DE4); store64(&_w2W4_c6 + 376, 0xBFE9A16B5B8981AE);
    store64(&_w2W4_c6 + 384, 0); store64(&_w2W4_c6 + 392, 0);
    store64(&_w2W4_c6 + 400, 0); store64(&_w2W4_c6 + 408, 0);
    store64(&_w2W4_c6 + 416, 0); store64(&_w2W4_c6 + 424, 0);
    store64(&_w2W4_c6 + 432, 0); store64(&_w2W4_c6 + 440, 0);
    store64(&_w2W4_c6 + 448, 0x3FEF96BA62796B31); store64(&_w2W4_c6 + 456, 0x3FEF83EFEEE1BDAF);
    store64(&_w2W4_c6 + 464, 0x3FEF96BA62796B33); store64(&_w2W4_c6 + 472, 0x3FEF83EFEEE1BDB1);
    store64(&_w2W4_c6 + 480, 0); store64(&_w2W4_c6 + 488, 0);
    store64(&_w2W4_c6 + 496, 0); store64(&_w2W4_c6 + 504, 0);
    store64(&_w2W4_c6 + 512, 0); store64(&_w2W4_c6 + 520, 0);
    store64(&_w2W4_c6 + 528, 0); store64(&_w2W4_c6 + 536, 0);
    store64(&_w2W4_c6 + 544, 0x3FEF96BA62796B33); store64(&_w2W4_c6 + 552, 0x3FEF83EFEEE1BDB1);
    store64(&_w2W4_c6 + 560, 0x3FEF96BA62796B35); store64(&_w2W4_c6 + 568, 0x3FEF83EFEEE1BDB3);
    return 0;
}
_w2W4_c6_fill();
fn _w2W4_cm(n, src) {
    var M = cmat_new(n, n);
    var md = load64(M + 16);
    for (var q = 0; q < 2 * n * n; q = q + 1) { store64(md + q * 8, load64(src + q * 8)); }
    return M;
}
var _w2W4_ci6 = _w2W4_cinv(_w2W4_cm(6, &_w2W4_c6));
assert_eq(load64(&_w2W4_st), 12, "cmat_inverse: the 6 x 6's real form is certified at 12 limbs ...");
assert_eq(load64(&_w2W4_st + 8), 2, "cmat_inverse: ... on the second attempt (the first lost every bit)");
assert_eq(_w2W4_ce(_w2W4_ci6, 6, 4, 4, 0), 0xC65F83EFEEE1BDB3, "cmat_inverse: the 6 x 6, (4, 4) re");
assert_eq(_w2W4_ce(_w2W4_ci6, 6, 4, 4, 1), 0x465F96BA62796B35, "cmat_inverse: the 6 x 6, (4, 4) im");
assert_eq(_w2W4_ce(_w2W4_ci6, 6, 3, 5, 0), 0xC619BFFFD4EEE8F4, "cmat_inverse: the 6 x 6, (3, 5) re");
assert_eq(_w2W4_ce(_w2W4_ci6, 6, 3, 5, 1), 0x462D6974A7829851, "cmat_inverse: the 6 x 6, (3, 5) im");

# cmat_inverse_checked: the failures told apart
fn _w2W4_cic(m) {
    var t, v = cmat_inverse_checked(m);
    if (is_ok(t) == 1) { return 1; }
    return v;
}
assert_eq(_w2W4_cic(_w2W4_c2(F64_ONE, 0, 0x3FF0000000000001, 0, 0x3FF0000000000001, 0, 0x3FF0000000000002, 0)), 1,
  "cmat_inverse_checked: the lost pivot -> Ok");
fn _w2W4_cio(m) {
    var t, v = cmat_inverse_checked(m);
    if (is_ok(t) == 1) { return _w2W4_ce(v, 2, 0, 0, 0); }
    return 0;
}
assert_eq(_w2W4_cio(_w2W4_c2(F64_ONE, 0, 0x3FF0000000000001, 0, 0x3FF0000000000001, 0, 0x3FF0000000000002, 0)),
  0xC670000000000002, "cmat_inverse_checked: Ok holds the inverse, (0, 0) = -2^104 (1 + 2u)");
assert_eq(_w2W4_cic(0), HSB_ERR_INVALID_INPUT, "cmat_inverse_checked: null -> Err(INVALID_INPUT)");
assert_eq(_w2W4_cic(cmat_new(2, 3)), HSB_ERR_INVALID_INPUT, "cmat_inverse_checked: 2 x 3 -> Err(INVALID_INPUT)");
assert_eq(_w2W4_cic(_w2W4_c2(F64_ONE, 0, 0, 0x7FF8000000000000, 0, 0, F64_ONE, 0)), HSB_ERR_INVALID_INPUT,
  "cmat_inverse_checked: a NaN part -> Err(INVALID_INPUT)");
assert_eq(_w2W4_cic(_w2W4_c2(F64_ONE, 0, 0x4000000000000000, 0, 0x4000000000000000, 0, 0x4010000000000000, 0)),
  HSB_ERR_SINGULAR_MATRIX, "cmat_inverse_checked: [[1, 2], [2, 4]] -> Err(SINGULAR_MATRIX)");
var _w2W4_c1 = cmat_new(1, 1);
store64(load64(_w2W4_c1 + 16), 1);
assert_eq(_w2W4_cic(_w2W4_c1), HSB_ERR_OUT_OF_RANGE, "cmat_inverse_checked: [2^-1074] -> Err(OUT_OF_RANGE) (2^1074)");
assert_eq(_w2W4_cic(_w2W4_c2(0x0170000000000000, 0, 0x0170000000000001, 0, 0x0170000000000001, 0,
      0x0170000000000002, 0)),
  HSB_ERR_OUT_OF_RANGE, "cmat_inverse_checked: the lost pivot at 2^-1000 -> Err(OUT_OF_RANGE) (entries near 2^1104)");
assert_eq(cmat_inverse(_w2W4_c2(0x0170000000000000, 0, 0x0170000000000001, 0, 0x0170000000000001, 0,
      0x0170000000000002, 0)), 0, "cmat_inverse: the same -> 0");
assert_eq(_w2W4_cic(cmat_new(182, 182)), HSB_ERR_ALLOC,
  "cmat_inverse_checked: n = 182, past the kept cap -> Err(ALLOC)");

# === 3.5.0 W4: eigen_power's certificate bounds its powers' rounding ===
# Roadmap [3.5.0], "eigen_power: Ok on a wrong eigenvalue, because underflow reads as nilpotence", its
# rounding half: an f64 sum absorbs a term below 2^-53 of it, and when the rest cancels the term is gone
# from every later power. A = [[1, a, a, 0], [c, 0, 0, 0], [-c, 0, 0, 0], [0, 0, h, 3/4]] (a = 1.3 2^e,
# c = 1.7 2^e, h = 1.1 2^e; rho 1) squares its (0, 0) entry to 1 + ac - ac = 0, and the merged tree
# answered Ok(3/4) for every e from 30 to 590. The squarings now carry an entrywise bound R on the
# distance to the exact powers (`_lext_gf_loop`, `_lext_gfw_loop`, `_lext_deflate`), and every bound is
# formed on |T| + R. Oracle: rho from the exact characteristic polynomial (Schur-Cohn test, Fractions).
test_group("3.5.0 W4: eigen_power's certificate bounds its powers' rounding");
fn _w2W4_ep4(e) {
    var A = ganita_mat_new(4, 4);
    var a = f64_mul(0x3FF4CCCCCCCCCCCD, (1023 + e) << 52);   # 1.3 2^e
    var c = f64_mul(0x3FFB333333333333, (1023 + e) << 52);   # 1.7 2^e
    var h = f64_mul(0x3FF199999999999A, (1023 + e) << 52);   # 1.1 2^e
    ganita_mat_set(A, 0, 0, F64_ONE); ganita_mat_set(A, 0, 1, a); ganita_mat_set(A, 0, 2, a);
    ganita_mat_set(A, 1, 0, c); ganita_mat_set(A, 2, 0, f64_neg(c));
    ganita_mat_set(A, 3, 2, h); ganita_mat_set(A, 3, 3, 0x3FE8000000000000);
    var v = alloc(4 * 8);
    var l = alloc(8);
    var t, er = eigen_power(A, 4, 5000, l, v);
    if (is_ok(t) == 1) { return load64(l); }
    return er;
}
assert_eq(_w2W4_ep4(30), HSB_ERR_NO_CONVERGENCE,
  "eigen_power: the 4 x 4 at e = 30 -> NO_CONVERGENCE (merged tree: Ok(3/4))");
assert_eq(_w2W4_ep4(100), HSB_ERR_NO_CONVERGENCE, "eigen_power: ... at e = 100 -> NO_CONVERGENCE (Ok(3/4))");
assert_eq(_w2W4_ep4(590), HSB_ERR_NO_CONVERGENCE,
  "eigen_power: ... at e = 590, through the wide squarings -> NO_CONVERGENCE (Ok(3/4))");
# e = 10: the iteration's 1.000000000065125 is right, but its powers are bounded only through 1 + ac - ac
# with ac near 2^21, which doubles cannot resolve: refused now (merged tree: Ok(3FF00000000479B1))
assert_eq(_w2W4_ep4(10), HSB_ERR_NO_CONVERGENCE,
  "eigen_power: ... at e = 10 -> NO_CONVERGENCE, a right answer the squarings cannot prove (merged tree: Ok)");
# the 3 x 3 [[1, a, a], [c, 0, 0], [-c, 0, 0]] at e = 30 (eigenvalues 0, 0, 1): lam = 1/2 from v = e_0 or
# (1, 1, 1) was certified through a power read as 0
var _w2W4_g3 = ganita_mat_new(3, 3);
ganita_mat_set(_w2W4_g3, 0, 0, F64_ONE);
ganita_mat_set(_w2W4_g3, 0, 1, f64_mul(0x3FF4CCCCCCCCCCCD, (1023 + 30) << 52));
ganita_mat_set(_w2W4_g3, 0, 2, f64_mul(0x3FF4CCCCCCCCCCCD, (1023 + 30) << 52));
ganita_mat_set(_w2W4_g3, 1, 0, f64_mul(0x3FFB333333333333, (1023 + 30) << 52));
ganita_mat_set(_w2W4_g3, 2, 0, f64_mul(0xBFFB333333333333, (1023 + 30) << 52));
var _w2W4_g3v = alloc(3 * 8);
var _w2W4_g3T = alloc(9 * 8);
var _w2W4_g3z = alloc(3 * 8);
var _w2W4_g3s = alloc(3 * 8);
store64(_w2W4_g3v, F64_ONE);
assert_eq(_lext_gelfand(_w2W4_g3, 3, F64_HALF, _w2W4_g3v, _w2W4_g3T, _w2W4_g3z, _w2W4_g3s), 0,
  "_lext_gelfand: the 3 x 3, lam = 1/2 from e_0 -> refused (merged tree: certified)");
store64(_w2W4_g3v + 8, F64_ONE); store64(_w2W4_g3v + 16, F64_ONE);
assert_eq(_lext_gelfand(_w2W4_g3, 3, F64_HALF, _w2W4_g3v, _w2W4_g3T, _w2W4_g3z, _w2W4_g3s), 0,
  "_lext_gelfand: the 3 x 3, lam = 1/2 from (1, 1, 1) -> refused (merged tree: certified)");
# `_lext_deflate`'s bound with no incoming error (R = 0): M = [[1, 1/2], [1/4, 1/2]], v = (1, 1/2), so p = 0,
# x = (1, 1/2), y = M x = (5/4, 1/2): R_00 = (n + 2) 2^-51 (|M| |x|)_0 = 2^-49 5/4, R_11 = 2^-51 (|M_11| + |x_1
# M_01|) = 2^-51 3/4, R_10 = R_11 / 2 + 2^-49 9/8 + 2^-51 9/8, each times 1 + 12 2^-52, then column 0 times
# 2 and row 0 times 1/2 (the balancing power of two): R_01 stays 0
var _w2W4_dM = alloc(4 * 8);
var _w2W4_dR = alloc(4 * 8);
var _w2W4_dv = alloc(2 * 8);
var _w2W4_dd = alloc(2 * 8);
var _w2W4_dy = alloc(4 * 8);
store64(_w2W4_dM, F64_ONE); store64(_w2W4_dM + 8, F64_HALF);
store64(_w2W4_dM + 16, 0x3FD0000000000000); store64(_w2W4_dM + 24, F64_HALF);
store64(_w2W4_dv, F64_ONE); store64(_w2W4_dv + 8, F64_HALF);
store64(_w2W4_dd, F64_ONE); store64(_w2W4_dd + 8, F64_ONE);
assert_eq(_lext_deflate(_w2W4_dM, 2, _w2W4_dv, F64_ONE, _w2W4_dd, _w2W4_dy, _w2W4_dR), 1, "_lext_deflate: deflated");
assert_eq(load64(_w2W4_dM + 16), 0xBFD0000000000000, "_lext_deflate: M_10 = 2 (1/2 - 5/8) = -1/4");
assert_eq(load64(_w2W4_dR), 0x3CE400000000000F, "_lext_deflate: R_00 = 2^-49 5/4 (1 + 12 2^-52)");
assert_eq(load64(_w2W4_dR + 8), 0, "_lext_deflate: R_01 = 0 (row p is copied)");
assert_eq(load64(_w2W4_dR + 16), 0x3CF8000000000013, "_lext_deflate: R_10, doubled with column p");
assert_eq(load64(_w2W4_dR + 24), 0x3CB8000000000012, "_lext_deflate: R_11 = 2^-51 3/4 (1 + 12 2^-52)");
# ... and an incoming bound moves through the similarity: R = 2^-40 everywhere adds 2^-40 (1 + |x_1|) to
# R_11 and 2^-40 (1 + |x_1| + (1 + |x_1|) |x_1|) to R_10 before the doubling
store64(_w2W4_dM, F64_ONE); store64(_w2W4_dM + 8, F64_HALF);
store64(_w2W4_dM + 16, 0x3FD0000000000000); store64(_w2W4_dM + 24, F64_HALF);
for (var _w2W4_q = 0; _w2W4_q < 4; _w2W4_q = _w2W4_q + 1) { store64(_w2W4_dR + _w2W4_q * 8, 0x3D70000000000000); }
assert_eq(_lext_deflate(_w2W4_dM, 2, _w2W4_dv, F64_ONE, _w2W4_dd, _w2W4_dy, _w2W4_dR), 1,
  "_lext_deflate: deflated again");
assert_eq(load64(_w2W4_dR + 24), 0x3D78018000000012, "_lext_deflate: R_11 = (2^-40 3/2 + 2^-51 3/4)(1 + 12 2^-52)");
assert_eq(load64(_w2W4_dR + 16), 0x3D92060000000012,
  "_lext_deflate: R_10 with the incoming 2^-40 (2^-40 9/4 and the roundings, doubled)");
assert_eq(load64(_w2W4_dR + 8), 0x3D60000000000000, "_lext_deflate: R_01 = 2^-40, halved with row p");
assert_eq(load64(_w2W4_dR), 0x3D780A0000000012,
  "_lext_deflate: R_00 = 2^-40 + 2^-40 |x_1| + 2^-49 5/4, then rounded up");
# `_lext_cw` on |T| + R: [[1, 2], [3, 4]] + 1 = [[2, 3], [4, 5]] (rho 7.772001872658765), five steps from (1, 1)
var _w2W4_cT = alloc(4 * 8);
var _w2W4_cR = alloc(4 * 8);
var _w2W4_cz = alloc(4 * 8);
store64(_w2W4_cT, F64_ONE); store64(_w2W4_cT + 8, F64_TWO);
store64(_w2W4_cT + 16, f64_from(3)); store64(_w2W4_cT + 24, f64_from(4));
for (var _w2W4_q2 = 0; _w2W4_q2 < 4; _w2W4_q2 = _w2W4_q2 + 1) { store64(_w2W4_cR + _w2W4_q2 * 8, F64_ONE); }
store64(_w2W4_cz, F64_ONE); store64(_w2W4_cz + 8, F64_ONE);
assert_eq(_lext_cw(_w2W4_cT, _w2W4_cR, 2, _w2W4_cz, _w2W4_cz + 16), 0x401D1984A65A0535,
  "_lext_cw: |[[1, 2], [3, 4]]| + 1, five steps from (1, 1) -> 7.7748 (rho 7.7720)");
# `_lext_gf_loop` itself, on an exact M (R = 0): B' = 2 [[1, a, a], [c, 0, 0], [-c, 0, 0]] at e = 30 (rho 2,
# lam = 1/2), M = B' 2^-32. M's square absorbs its (0, 0) term (2^-62 against 1.3 1.7 / 4) and cancels the
# rest, so 3.4.2 read the powers as nilpotent; the product's own rounding bound (g |M| |M|) keeps it
var _w2W4_lM = alloc(9 * 8);
var _w2W4_lR = alloc(9 * 8);
var _w2W4_lT = alloc(9 * 8);
var _w2W4_lz = alloc(3 * 8);
var _w2W4_ls2 = alloc(3 * 8);
fn _w2W4_lzero() {
    for (var q = 0; q < 9; q = q + 1) {
        store64(_w2W4_lM + q * 8, 0);
        store64(_w2W4_lR + q * 8, 0);
    }
    store64(_w2W4_lz, F64_ONE); store64(_w2W4_lz + 8, F64_ONE); store64(_w2W4_lz + 16, F64_ONE);
    return 0;
}
_w2W4_lzero();
store64(_w2W4_lM, 0x3E00000000000000);   # 2^-31
store64(_w2W4_lM + 8, 0x3FE4CCCCCCCCCCCD); store64(_w2W4_lM + 16, 0x3FE4CCCCCCCCCCCD);   # 1.3 / 2
store64(_w2W4_lM + 24, 0x3FEB333333333333); store64(_w2W4_lM + 48, 0xBFEB333333333333);   # +-1.7 / 2
# (review) 3, not 0: refused on its rounding bound where T alone (read as 0) would certify, the caller's
# cue to take the squarings again in double-double (`_lext_gfd_loop`, which refuses it: see the next group)
assert_eq(_lext_gf_loop(_w2W4_lM, 0, _w2W4_lT, 3, 0, 0, _w2W4_lz, _w2W4_ls2, 32, 0x3F57A013FACA6C6B, 24), 3,
  "_lext_gf_loop: 2 [[1, a, a], [c, 0, 0], [-c, 0, 0]] 2^-32 (rho 2), exact -> refused, T alone certifying (3)");
# ... and the same M squared wide (`_lext_gfw_from`, its exponents kept): the same absorption, refused
_w2W4_lzero();
store64(_w2W4_lM, 0x3E00000000000000);   # 2^-31
store64(_w2W4_lM + 8, 0x3FE4CCCCCCCCCCCD); store64(_w2W4_lM + 16, 0x3FE4CCCCCCCCCCCD);   # 1.3 / 2
store64(_w2W4_lM + 24, 0x3FEB333333333333); store64(_w2W4_lM + 48, 0xBFEB333333333333);   # +-1.7 / 2
assert_eq(_lext_gfw_from(_w2W4_lM, 0, 3, 0, 0, 0, 32, 1, 0x3F57A013FACA6C6B, 24), 0,
  "_lext_gfw_from: the same 3 x 3, exact, wide -> refused");
# an incoming bound that closes a cycle only through |M| R: M = 8 e_0 e_1^T, R = e_1 e_2^T + e_2 e_0^T. Some
# X with |X - M| <= R has rho(X)^3 = 8 (X = M + R), and X^2's cycle 0 -> 2 -> 1 -> 0 needs M R's (0, 2) entry:
# R |M| and R R alone leave a nilpotent pattern that the squarings would read as 0
_w2W4_lzero();
store64(_w2W4_lM + 8, 0x4020000000000000);   # 8
store64(_w2W4_lR + 40, F64_ONE); store64(_w2W4_lR + 48, F64_ONE);
assert_eq(_lext_gf_loop(_w2W4_lM, _w2W4_lR, _w2W4_lT, 3, 0, 0, _w2W4_lz, _w2W4_ls2, 0, 0x3F57A013FACA6C6B, 24), 3,
  "_lext_gf_loop: 8 e_0 e_1^T within R = e_1 e_2^T + e_2 e_0^T (rho up to 2) -> refused, T alone (0) certifying (3)");
# ... and the same M with R = 0 is exactly nilpotent: certified (rho 0) through a power and bound both 0
_w2W4_lzero();
store64(_w2W4_lM + 8, 0x4020000000000000);
assert_eq(_lext_gf_loop(_w2W4_lM, 0, _w2W4_lT, 3, 0, 0, _w2W4_lz, _w2W4_ls2, 0, 0x3F57A013FACA6C6B, 24), 1,
  "_lext_gf_loop: 8 e_0 e_1^T exact -> certified (its square and its bound are both 0)");
# `_lext_up2`: an upper bound, one subnormal unit up where it lands below DBL_MIN
assert_eq(_lext_up2(F64_ONE, 0 - 1), F64_HALF, "_lext_up2: 1 2^-1 -> 1/2 exactly");
assert_eq(_lext_up2(1, 0 - 1), 1, "_lext_up2: 2^-1074 2^-1 -> 2^-1074 (rounded to 0, then one unit up)");
assert_eq(_lext_up2(0x0018000000000000, 0 - 1), 0x000C000000000001, "_lext_up2: 1.5 2^-1022 / 2 -> one unit up");
assert_eq(_lext_up2(0, 0 - 5), 0, "_lext_up2: 0 -> 0");

# ==================================================================================================
# === 3.5.0 W4 (review): eigen_power's squarings again in double-double where the rounding bound refused ===
# The f64 rounding bound refused right answers on signed non-normal matrices with a slowly decaying
# subdominant eigenvalue (50 of 897 that 3.4.2 certified on the review's families); `_lext_gfd_loop` takes
# the squarings again with every power a double-double wherever the bound 3.4.2 formed from the computed
# powers alone certifies (`_lext_gf_loop` returns 3), and certifies 30 of the 50 again.
# [measured: scratch_W4 fam.sh (gap seeds 2, 3; gapc 5; gapn 4), base, first pass and this tree, 2026-11-14]
test_group("3.5.0 W4: eigen_power, Gelfand's squarings in double-double (review)");
# the review's 4 x 4 (eigenvalues 0.9999999999999988, 0.995, 0.24875000000000053, -0.12437499999999967: exact
# bisection on its Fraction characteristic polynomial, second review)
var _w2W4_r4 = ganita_mat_new(4, 4);
var _w2W4_r4h: i64[16];
store64(&_w2W4_r4h + 0, 0xC019431E31E31E32); store64(&_w2W4_r4h + 8, 0x3FADEA78411DAB74);
store64(&_w2W4_r4h + 16, 0xC004461AC812E795); store64(&_w2W4_r4h + 24, 0xC015F10EF755DBC4);
store64(&_w2W4_r4h + 32, 0x40122AAAAAAAAAAB); store64(&_w2W4_r4h + 40, 0x3FE13A06D3A06D3A);
store64(&_w2W4_r4h + 48, 0x4002333333333333); store64(&_w2W4_r4h + 56, 0x400B333333333333);
store64(&_w2W4_r4h + 64, 0x400E867F9B2CE602); store64(&_w2W4_r4h + 72, 0x3FD277BAAEDE2115);
store64(&_w2W4_r4h + 80, 0x3FFC934C67F9B2CE); store64(&_w2W4_r4h + 88, 0x4006DD319FE6CB3A);
store64(&_w2W4_r4h + 96, 0x401B41B4E81B4E82); store64(&_w2W4_r4h + 104, 0xBFCDA740DA740DA7);
store64(&_w2W4_r4h + 112, 0x4005428F5C28F5C3); store64(&_w2W4_r4h + 120, 0x40187147AE147AE1);
for (var _w2W4_q4 = 0; _w2W4_q4 < 16; _w2W4_q4 = _w2W4_q4 + 1) {
    ganita_mat_set(_w2W4_r4, _w2W4_q4 / 4, _w2W4_q4 % 4, load64(&_w2W4_r4h + _w2W4_q4 * 8));
}
fn _w2W4_epv(A, n) {
    var l = alloc(8);
    var v = alloc(n * 8);
    var t, er = eigen_power(A, n, 40000, l, v);
    if (is_ok(t) == 1) { return load64(l); }
    return er;
}
assert_eq(_w2W4_epv(_w2W4_r4, 4), 0x3FF00000000015E4,
  "eigen_power: the review's 4 x 4 -> Ok(1 + 1.24e-12), certified in double-double (first pass: NO_CONVERGENCE)");
# `_lext_gelfand` with no vector to deflate by (v = 0, so D = I): the f64 frame's squarings return 3 and
# the double-double ones certify
var _w2W4_g4v = alloc(4 * 8);
assert_eq(_lext_gelfand(_w2W4_r4, 4, 0x3FF00000000015E4, _w2W4_g4v, alloc(16 * 8), alloc(4 * 8), alloc(4 * 8)), 1,
  "_lext_gelfand: the 4 x 4 at its lam, no deflation -> certified through the double-double squarings");
# `_lext_gfd` itself, D = I: at lam and lam / 1.0005 no eigenvalue passes 1.001 lam, so both certify;
# at lam / 1.0012 rho = 1.0012 lam passes it, so no bound may certify
var _w2W4_g1 = alloc(4 * 8);
for (var _w2W4_q5 = 0; _w2W4_q5 < 4; _w2W4_q5 = _w2W4_q5 + 1) { store64(_w2W4_g1 + _w2W4_q5 * 8, F64_ONE); }
assert_eq(_lext_gfd(_w2W4_r4, 4, 0x3FF00000000015E4, _w2W4_g1, 0x3F57A013FACA6C6B, 24), 1,
  "_lext_gfd_loop: the 4 x 4 at lam -> certified");
assert_eq(_lext_gfd(_w2W4_r4, 4, 0x3FEFFBE7F2B20085, _w2W4_g1, 0x3F57A013FACA6C6B, 24), 1,
  "_lext_gfd_loop: the 4 x 4 at lam / 1.0005 -> certified");
assert_eq(_lext_gfd(_w2W4_r4, 4, 0x3FEFF62E6F12E336, _w2W4_g1, 0x3F57A013FACA6C6B, 24), 0,
  "_lext_gfd_loop: the 4 x 4 at lam / 1.0012 (rho past 1.001 lam) -> refused");
# the cancellation family [[1, a, a, 0], [c, 0, 0, 0], [-c, 0, 0, 0], [0, 0, h, 3/4]] (rho 1): 3/4 is refused
# at every e, where the f64 squarings read 1 + ac - ac as 0 (e = 30) and where double-doubles do too (e =
# 55: ac near 2^110); lam = 1 is certified where double-doubles hold the cancellation (e = 2)
fn _w2W4_c4(e) {
    var A = ganita_mat_new(4, 4);
    var p = (1023 + e) << 52;
    ganita_mat_set(A, 0, 0, F64_ONE);
    ganita_mat_set(A, 0, 1, f64_mul(0x3FF4CCCCCCCCCCCD, p));
    ganita_mat_set(A, 0, 2, f64_mul(0x3FF4CCCCCCCCCCCD, p));
    ganita_mat_set(A, 1, 0, f64_mul(0x3FFB333333333333, p));
    ganita_mat_set(A, 2, 0, f64_mul(0xBFFB333333333333, p));
    ganita_mat_set(A, 3, 2, f64_mul(0x3FF199999999999A, p));
    ganita_mat_set(A, 3, 3, 0x3FE8000000000000);
    return A;
}
assert_eq(_lext_gfd(_w2W4_c4(2), 4, F64_ONE, _w2W4_g1, 0x3F57A013FACA6C6B, 24), 1,
  "_lext_gfd_loop: the cancellation 4 x 4 at e = 2, lam = 1 -> certified");
assert_eq(_lext_gfd(_w2W4_c4(2), 4, 0x3FE8000000000000, _w2W4_g1, 0x3F57A013FACA6C6B, 24), 0,
  "_lext_gfd_loop: ... e = 2, lam = 3/4 -> refused");
assert_eq(_lext_gfd(_w2W4_c4(30), 4, 0x3FE8000000000000, _w2W4_g1, 0x3F57A013FACA6C6B, 24), 0,
  "_lext_gfd_loop: ... e = 30, lam = 3/4 -> refused");
assert_eq(_lext_gfd(_w2W4_c4(55), 4, 0x3FE8000000000000, _w2W4_g1, 0x3F57A013FACA6C6B, 24), 0,
  "_lext_gfd_loop: ... e = 55, lam = 3/4 (the cancellation past double-doubles) -> refused");
# an exactly nilpotent A: its square and that square's bound are both 0, so rho = 0 certifies any lam
var _w2W4_n3 = ganita_mat_new(3, 3);
ganita_mat_set(_w2W4_n3, 0, 1, 0x4020000000000000);   # 8
assert_eq(_lext_gfd(_w2W4_n3, 3, F64_ONE, _w2W4_g1, 0x3F57A013FACA6C6B, 24), 1,
  "_lext_gfd_loop: 8 e_0 e_1^T -> certified (an exact zero square)");

# `_lext_gfd_sq`, one double-double square, exact here: M = [[1 + 2^-26, 3 + 2^-40 + 2^-60], [5 + 5 2^-35,
# 7]] with the 2^-60 in Ml; every entry of M M is a double-double (Fractions), and each part of the
# product is needed for it (TwoSum's error: 2^-52 in (0, 0); Dekker's; the two cross terms)
var _w2W4_w2 = _lext_gfd_ws(2);
var _w2W4_wh = _lext_gfd_blk(_w2W4_w2, 2, _LGFD_MH);
store64(_w2W4_wh, 0x3FF0000004000000); store64(_w2W4_wh + 8, 0x4008000000000800);
store64(_w2W4_wh + 16, 0x4014000000028000); store64(_w2W4_wh + 24, 0x401C000000000000);
store64(_lext_gfd_blk(_w2W4_w2, 2, _LGFD_ML) + 8, 0x3C30000000000000);   # 2^-60
_lext_gfd_sq(_w2W4_w2, 2);
var _w2W4_wt = _lext_gfd_blk(_w2W4_w2, 2, _LGFD_TH);
var _w2W4_wl = _lext_gfd_blk(_w2W4_w2, 2, _LGFD_TL);
assert_eq(load64(_w2W4_wt), 0x403000000081E500, "_lext_gfd_sq: (M M)_00, high part");
assert_eq(load64(_w2W4_wl), 0x3CB05000A0000A00, "_lext_gfd_sq: (M M)_00, low part");
assert_eq(load64(_w2W4_wt + 8), 0x4038000000C00800, "_lext_gfd_sq: (M M)_01, high part");
assert_eq(load64(_w2W4_wl + 8), 0x3C60080000800000, "_lext_gfd_sq: (M M)_01, low part");
assert_eq(load64(_w2W4_wt + 16), 0x4044000000A28000, "_lext_gfd_sq: (M M)_10, high part");
assert_eq(load64(_w2W4_wl + 16), 0x3C44000000000000, "_lext_gfd_sq: (M M)_10, low part");
assert_eq(load64(_w2W4_wt + 24), 0x4050000000007940, "_lext_gfd_sq: (M M)_11, high part");
assert_eq(load64(_w2W4_wl + 24), 0x3C54002800028000, "_lext_gfd_sq: (M M)_11, low part");
# ... and one square of `_lext_gfd_loop` on the same M (lam = 1, rho near 8.9: not certified) leaves the
# next M = T 2^-7 (the bound's largest row sum is in [64, 128)), low parts and all
store64(_lext_gfd_blk(_w2W4_w2, 2, _LGFD_ML) + 8, 0x3C30000000000000);
assert_eq(_lext_gfd_loop(_w2W4_w2, 2, f64_from(0), 0, 0x3F57A013FACA6C6B, 1), 0,
  "_lext_gfd_loop: the 2 x 2 at lam = 1, one square -> not certified");
var _w2W4_wm = _lext_gfd_blk(_w2W4_w2, 2, _LGFD_ML);
assert_eq(load64(_w2W4_wh), 0x3FC000000081E500, "_lext_gfd_loop: M_00 = (M M)_00 2^-7, high part");
assert_eq(load64(_w2W4_wm), 0x3C405000A0000A00, "_lext_gfd_loop: M_00, low part kept");
assert_eq(load64(_w2W4_wm + 8), 0x3BF0080000800000, "_lext_gfd_loop: M_01, low part kept");
assert_eq(load64(_w2W4_wm + 16), 0x3BD4000000000000, "_lext_gfd_loop: M_10, low part kept");
assert_eq(load64(_w2W4_wm + 24), 0x3BE4002800028000, "_lext_gfd_loop: M_11, low part kept");
# `_lext_gfd_loop` on M = 8 e_0 e_1^T within R = e_1 e_2^T + e_2 e_0^T, lam = 1: M + R has rho 2, through
# the cycle 0 -> 2 -> 1 -> 0 that needs each of |M| R, R |M| and R R in the first square's bound
var _w2W4_w3 = _lext_gfd_ws(3);
store64(_lext_gfd_blk(_w2W4_w3, 3, _LGFD_MH) + 8, 0x4020000000000000);   # 8
store64(_lext_gfd_blk(_w2W4_w3, 3, _LGFD_R) + 40, F64_ONE);
store64(_lext_gfd_blk(_w2W4_w3, 3, _LGFD_R) + 48, F64_ONE);
assert_eq(_lext_gfd_loop(_w2W4_w3, 3, f64_from(0), 0, 0x3F57A013FACA6C6B, 24), 0,
  "_lext_gfd_loop: 8 e_0 e_1^T within R = e_1 e_2^T + e_2 e_0^T, lam = 1 -> refused");
# a frame entry that flushes: [[0, 2^1000], [2^-90, 0]] (rho 2^455) at lam = 2^454. F 2^-1000 has 2^-1090,
# below the subnormals, where its bound (one subnormal unit) is all that keeps the cycle
var _w2W4_fz = ganita_mat_new(2, 2);
ganita_mat_set(_w2W4_fz, 0, 1, 0x7E70000000000000);   # 2^1000
ganita_mat_set(_w2W4_fz, 1, 0, 0x3A50000000000000);   # 2^-90
assert_eq(_lext_gfd(_w2W4_fz, 2, 0x5C50000000000000, _w2W4_g1, 0x3F57A013FACA6C6B, 24), 0,
  "_lext_gfd: [[0, 2^1000], [2^-90, 0]] at lam = 2^454 (rho 2 lam), a flushed frame entry -> refused");

# ==================================================================================================
# === 3.5.0 W4 (second review): the squarings' subnormal floor goes only where a term can be non-zero ===
# The floor (n 2^-1071 in `_lext_gf_loop`, that and (16 n + 16) 2^-1074 in `_lext_gfd_loop`) went on every
# entry of U, a structural zero included. On a block-triangular chain whose diagonal blocks sit about 2^500
# below the coupling it closed a false cycle through the zero block, which outgrew the true blocks: of 150
# chains 3.4.2 answered right (coupled at 2^380 to 2^630), 58 were NO_CONVERGENCE, every one coupled at
# 2^420 to 2^560. It now goes where some term X_rl X_lc can be non-zero (`_lext_gf_pat`, `_lext_gf_prow`): an
# entry each of whose terms has a zero factor is 0 exactly, computed, exact and bounded alike.
# [measured: scratch_W4 r2 gen.py (sweep; rand seed 11) + cmp.py, 3.4.2, pre-wave-2, merged and this tree, 2026-11-14]
test_group("3.5.0 W4: eigen_power's subnormal floor, only where a term can be non-zero (second review)");
# the chain [[B1, C], [0, B2]], B_l = l / 4 [[2, 1, 1], [1, 2, 1], [1, 1, 2]] (l = 1.5, 1.2), C = 2^cp ones:
# rho = 1.5 exactly (a block-triangular A's eigenvalues are its blocks', and B1's largest is 1.5)
fn _w2W4_ch(cp) {
    var A = ganita_mat_new(6, 6);
    for (var i = 0; i < 3; i = i + 1) {
        for (var j = 0; j < 3; j = j + 1) {
            var a = 0x3FD8000000000000;   # 0.375
            var b = 0x3FD3333333333333;   # 0.3
            if (i == j) {
                a = 0x3FE8000000000000;   # 0.75
                b = 0x3FE3333333333333;   # 0.6
            }
            ganita_mat_set(A, i, j, a);
            ganita_mat_set(A, 3 + i, 3 + j, b);
            ganita_mat_set(A, i, 3 + j, (1023 + cp) << 52);
        }
    }
    return A;
}
assert_eq(_w2W4_epv(_w2W4_ch(500), 6), 0x3FF8000000005C58,
  "eigen_power: the chain coupled at 2^500 -> Ok(1.5 + 5.2e-12), 3.4.2's answer (merged tree: NO_CONVERGENCE)");
assert_eq(_w2W4_epv(_w2W4_ch(300), 6), 0x3FF8000000005C58, "eigen_power: ... coupled at 2^300 -> the same");
var _w2W4_g6 = alloc(6 * 8);
for (var _w2W4_q6 = 0; _w2W4_q6 < 6; _w2W4_q6 = _w2W4_q6 + 1) { store64(_w2W4_g6 + _w2W4_q6 * 8, F64_ONE); }
assert_eq(_lext_gfd(_w2W4_ch(500), 6, 0x3FF8000000000000, _w2W4_g6, 0x3F57A013FACA6C6B, 24), 1,
  "_lext_gfd_loop: the chain at 2^500, lam = 1.5 -> certified (merged tree: refused, the floor's false cycle)");
assert_eq(_lext_gfd(_w2W4_ch(500), 6, 0x3FF7F8A2D34E099D, _w2W4_g6, 0x3F57A013FACA6C6B, 24), 0,
  "_lext_gfd_loop: ... lam = 1.5 / 1.0012 (rho past 1.001 lam) -> refused");
# ... and the floor is still where a term can be non-zero. `_lext_gf_loop` on M = 2^-500 e_0 e_1^T within R =
# 2^-600 (e_1 e_2^T + e_2 e_0^T), e0 = 600: some X has the cycle 0 -> 1 -> 2 -> 0, rho(X) = 2^-566.7, so
# rho(B') = 2^33.3. Every term of X^2's bound (2^-1100, 2^-1200) flushes, T = M M = 0, and only the floor on
# that cycle's three entries keeps the bound from reading X^2 as 0: refused, T alone (0) certifying (3)
_w2W4_lzero();
store64(_w2W4_lM + 8, 0x20B0000000000000);   # 2^-500
store64(_w2W4_lR + 40, 0x1A70000000000000); store64(_w2W4_lR + 48, 0x1A70000000000000);   # 2^-600
assert_eq(_lext_gf_loop(_w2W4_lM, _w2W4_lR, _w2W4_lT, 3, 0, 0, _w2W4_lz, _w2W4_ls2, 600, 0x3F57A013FACA6C6B, 24), 3,
  "_lext_gf_loop: 2^-500 e_0 e_1^T within 2^-600 (e_1 e_2^T + e_2 e_0^T), e0 = 600 -> refused (3), the floor kept");
# `_lext_gfd` on [[0, 1, 0], [0, 0, 2^-540], [2^-540, 0, 0]] (rho 2^-360) at lam = 2^-400: the square's (1, 0)
# term 2^-1080 flushes, and only its floor keeps the cycle
var _w2W4_f3 = ganita_mat_new(3, 3);
ganita_mat_set(_w2W4_f3, 0, 1, F64_ONE);
ganita_mat_set(_w2W4_f3, 1, 2, 0x1E30000000000000);   # 2^-540
ganita_mat_set(_w2W4_f3, 2, 0, 0x1E30000000000000);
assert_eq(_lext_gfd(_w2W4_f3, 3, 0x26F0000000000000, _w2W4_g1, 0x3F57A013FACA6C6B, 24), 0,
  "_lext_gfd_loop: [[0, 1, 0], [0, 0, 2^-540], [2^-540, 0, 0]] at lam = 2^-400 (rho 2^-360) -> refused");
# ... and both again at n = 67 with the cycle on 64 -> 65 -> 66 -> 64, every entry of X^2 it reaches past
# the first word of a row's pattern
var _w2W4_bM = alloc(67 * 67 * 8);
var _w2W4_bR = alloc(67 * 67 * 8);
var _w2W4_bT = alloc(67 * 67 * 8);
var _w2W4_bz = alloc(67 * 8);
var _w2W4_bs = alloc(67 * 8);
for (var _w2W4_q8 = 0; _w2W4_q8 < 67; _w2W4_q8 = _w2W4_q8 + 1) { store64(_w2W4_bz + _w2W4_q8 * 8, F64_ONE); }
store64(_w2W4_bM + (64 * 67 + 65) * 8, 0x20B0000000000000);   # 2^-500
store64(_w2W4_bR + (65 * 67 + 66) * 8, 0x1A70000000000000);   # 2^-600
store64(_w2W4_bR + (66 * 67 + 64) * 8, 0x1A70000000000000);
assert_eq(_lext_gf_loop(_w2W4_bM, _w2W4_bR, _w2W4_bT, 67, 0, 0, _w2W4_bz, _w2W4_bs, 600, 0x3F57A013FACA6C6B, 24), 3,
  "_lext_gf_loop: the same cycle at n = 67, on 64 -> 65 -> 66 -> 64 -> refused (3), the floor kept");
for (var _w2W4_q9 = 0; _w2W4_q9 < 67; _w2W4_q9 = _w2W4_q9 + 1) { store64(_w2W4_bz + _w2W4_q9 * 8, F64_ONE); }
var _w2W4_f67 = ganita_mat_new(67, 67);
ganita_mat_set(_w2W4_f67, 64, 65, F64_ONE);
ganita_mat_set(_w2W4_f67, 65, 66, 0x1E30000000000000);   # 2^-540
ganita_mat_set(_w2W4_f67, 66, 64, 0x1E30000000000000);
assert_eq(_lext_gfd(_w2W4_f67, 67, 0x26F0000000000000, _w2W4_bz, 0x3F57A013FACA6C6B, 24), 0,
  "_lext_gfd_loop: the 3-cycle at n = 67 on 64 -> 65 -> 66 -> 64, lam = 2^-400 -> refused");
# the patterns themselves, n = 70 (two words a row): row 0 has |M| at columns 63 and 64, row 1 R at 69, row 2
# R at 4 and a -0 at 3 (no bit); row 3's X^2 row is row 0's | row 2's (its own entries at 0 and, in R, 2; a -0
# at 1 picks nothing)
var _w2W4_pA = alloc(70 * 70 * 8);
var _w2W4_pR = alloc(70 * 70 * 8);
var _w2W4_pB = alloc(70 * 2 * 8);
var _w2W4_po = alloc(2 * 8);
store64(_w2W4_pA + 63 * 8, F64_ONE); store64(_w2W4_pA + 64 * 8, F64_ONE);
store64(_w2W4_pR + (70 + 69) * 8, F64_ONE);
store64(_w2W4_pR + (140 + 4) * 8, F64_ONE); store64(_w2W4_pA + (140 + 3) * 8, 0x8000000000000000);
store64(_w2W4_pA + 210 * 8, F64_ONE); store64(_w2W4_pR + (210 + 2) * 8, F64_ONE);
store64(_w2W4_pA + (210 + 1) * 8, 0x8000000000000000);
_lext_gf_pat(_w2W4_pA, _w2W4_pR, 70, 2, _w2W4_pB);
assert_eq(load64(_w2W4_pB), 0x8000000000000000, "_lext_gf_pat: row 0, columns 0 - 63: column 63");
assert_eq(load64(_w2W4_pB + 8), 1, "_lext_gf_pat: row 0, columns 64 - 69: column 64");
assert_eq(load64(_w2W4_pB + 16), 0, "_lext_gf_pat: row 1, columns 0 - 63: none");
assert_eq(load64(_w2W4_pB + 24), 32, "_lext_gf_pat: row 1, columns 64 - 69: column 69, from R");
assert_eq(load64(_w2W4_pB + 32), 16, "_lext_gf_pat: row 2: column 4, from R (the -0 at 3 is not a bit)");
assert_eq(load64(_w2W4_pB + 48), 5, "_lext_gf_pat: row 3: columns 0 and 2 (the -0 at 1 is not a bit)");
_lext_gf_prow(_w2W4_pA, _w2W4_pR, 70, 2, _w2W4_pB, 3, _w2W4_po);
assert_eq(load64(_w2W4_po), 0x8000000000000010, "_lext_gf_prow: row 3 of X^2, columns 0 - 63: row 0's | row 2's");
assert_eq(load64(_w2W4_po + 8), 1, "_lext_gf_prow: row 3 of X^2, columns 64 - 69: row 0's (not row 1's, via a -0)");
# The T-alone gate follows the bound on |T| + U while U stays under |T| (review): this 5 x 5 (rho =
# 12.509742016180189 by exact bisection on its characteristic polynomial; its other eigenvalues -12.4195, 0
# and a complex pair, all inside rho by the Schur-Cohn test) is certified only because the gate does not
# return at once when T alone first certifies (second review: returning there gives NO_CONVERGENCE)
var _w2W4_r5 = ganita_mat_new(5, 5);
var _w2W4_r5h: i64[25];
store64(&_w2W4_r5h + 0, 0x3FF0000000000000); store64(&_w2W4_r5h + 8, 0x407BBE249B966148);
store64(&_w2W4_r5h + 16, 0x407BBE249B966148); store64(&_w2W4_r5h + 24, 0xBFB972717597216E);
store64(&_w2W4_r5h + 32, 0x8000000000000000); store64(&_w2W4_r5h + 40, 0x407B37CB44A44706);
store64(&_w2W4_r5h + 64, 0x3FB59542BEA32A82); store64(&_w2W4_r5h + 72, 0x3FD4941B77FA7FAC);
store64(&_w2W4_r5h + 80, 0xC07B37CB44A44706); store64(&_w2W4_r5h + 112, 0x8000000000000000);
store64(&_w2W4_r5h + 120, 0x8000000000000000); store64(&_w2W4_r5h + 128, 0x8000000000000000);
store64(&_w2W4_r5h + 144, 0x8000000000000000); store64(&_w2W4_r5h + 152, 0x8000000000000000);
store64(&_w2W4_r5h + 160, 0xBFEC8CCF3231007D); store64(&_w2W4_r5h + 168, 0x8000000000000000);
store64(&_w2W4_r5h + 176, 0xBFD8D76BD0E3D604);
for (var _w2W4_q7 = 0; _w2W4_q7 < 25; _w2W4_q7 = _w2W4_q7 + 1) {
    ganita_mat_set(_w2W4_r5, _w2W4_q7 / 5, _w2W4_q7 % 5, load64(&_w2W4_r5h + _w2W4_q7 * 8));
}
assert_eq(_w2W4_epv(_w2W4_r5, 5), 0x402904FCE7D0387A,
  "eigen_power: the review's 5 x 5 -> Ok(12.509742015998416, 1.5e-11 below rho), as 3.4.2");

# ==================================================================================================
# 3.5.0 wave 2 — the ODE certificate reads the slope into the path (ode)
# ==================================================================================================
# (Written as tests/w2_W5.tcyr; every global and fn below is prefixed _w2W5_.)

# ==================================================================================================
test_group("3.5.0 W5: the ODE certificate reads g' at the answer");
# y' = A tri(B y) + D, tri(u) = |((u - 1) mod 4) - 2| - 1, evaluated as the scratch set did (in doubles,
# in this order), so the steps below are that set's. The branch roots are exact: f is piecewise linear,
# so the branch walk and the roots are rationals over the doubles given (Python Fractions).
var _w2W5_A = 0;
var _w2W5_B = 0;
var _w2W5_D = 0;
var _w2W5_N = 0;
fn _w2W5_tri(u) {
    var v = f64_sub(u, 0x3FF0000000000000);
    var m = f64_sub(v, f64_mul(0x4010000000000000, f64_floor(f64_div(v, 0x4010000000000000))));
    return f64_sub(f64_abs(f64_sub(m, 0x4000000000000000)), 0x3FF0000000000000);
}
fn _w2W5_ftri(t, y) {
    _w2W5_N = _w2W5_N + 1;
    return f64_add(f64_mul(_w2W5_A, _w2W5_tri(f64_mul(_w2W5_B, y))), _w2W5_D);
}
var _w2W5_o = alloc(8);

# (1) Backward Euler, tol 1e-12: the merged tree was Ok on another root 0.0028 past the branch's, inside
# the samples' last gap (69 evaluations), where g falls. The slope refuses it, and the continuation
# reaches the branch's root, correctly rounded: exact 1.8895277161813639169915654505010577510.
_w2W5_A = 0x401B0E3202D4401C;
_w2W5_B = 0x401FBB1740DE6CD5;
_w2W5_D = 0x401D9AAD03D022C4;
_w2W5_N = 0;
store64(_w2W5_o, 0x7FF4000000000001);
var _w2W5_t1, _w2W5_v1 = ode_backward_euler_checked(&_w2W5_ftri, 0, 0x3FF63E23D9EC6080, 0x3FE6786A04CEF18B,
  0x3D719799812DEA11, 50, _w2W5_o);
assert_eq(is_ok(_w2W5_t1), 1, "backward Euler, tri, tol 1e-12 -> Ok");
assert_eq(load64(_w2W5_o), 0x3FFE3B816A1E2707,
  "backward Euler, tri, tol 1e-12 -> the branch root, correctly rounded (merged tree: 0x3FFE471A607A9550)");
assert_eq(_w2W5_N, 157, "backward Euler, tri, tol 1e-12 -> 157 evaluations (merged tree: 69)");

# (2) Backward Euler, tol 1e-8: Ok on another root 0.172 past the branch's; now 1.8e-9 from the root,
# exact 14.022017948276747286426803783716484535, inside tol / g' of it.
_w2W5_A = 0xBFF2E0E6BC8D31C8;
_w2W5_B = 0x3FE480F36E8BEA08;
_w2W5_D = 0x4021B954B9B53B26;
_w2W5_N = 0;
var _w2W5_t2, _w2W5_v2 = ode_backward_euler_checked(&_w2W5_ftri, 0, 0xBFC352B3CA414000, 0x3FFD72EBBD8749C6,
  0x3E45798EE2308C3A, 50, _w2W5_o);
assert_eq(is_ok(_w2W5_t2), 1, "backward Euler, tri, tol 1e-8 -> Ok");
assert_eq(load64(_w2W5_o), 0x402C0B45EFCF6564,
  "backward Euler, tri, tol 1e-8 -> 1.8e-9 from the branch root (merged tree: 0x402C636A94A3D993, another root)");
assert_eq(_w2W5_N, 82, "backward Euler, tri, tol 1e-8 -> 82 evaluations (merged tree: 69)");

# (3) Backward Euler, tol 1e-8: Ok on another root 0.0076 past the branch's 18.287428100849415650901282;
# the continuation cannot reach the branch's root either, so the step fails, `out` untouched.
_w2W5_A = 0x40164A16B19CADA6;
_w2W5_B = 0x4015386AE3C428B2;
_w2W5_D = 0xC022F07EE7121C73;
_w2W5_N = 0;
store64(_w2W5_o, 0x7FF4000000000001);
var _w2W5_t3, _w2W5_v3 = ode_backward_euler_checked(&_w2W5_ftri, 0, 0x4033062E38B5C75C, 0x3FC7A2EF000CB25F,
  0x3E45798EE2308C3A, 50, _w2W5_o);
assert_eq(_w2W5_v3, HSB_ERR_NO_CONVERGENCE,
  "backward Euler, tri, tol 1e-8 -> NO_CONVERGENCE (merged tree: Ok 0x403247A058DDBF50, another root)");
assert_eq(load64(_w2W5_o), 0x7FF4000000000001, "backward Euler, tri, tol 1e-8, refused -> out untouched");
assert_eq(_w2W5_N, 60, "backward Euler, tri, tol 1e-8, refused -> 60 evaluations (merged tree: 67)");

# (4) BDF-2, tol 0.1: the predictor meets |g| < tol, and the merged tree returned it unread (1 evaluation),
# 0.108 above the branch's root 11.644073618290910246, nearer another root, where g falls.
_w2W5_A = 0xC0170923ACFCA7CA;
_w2W5_B = 0x401E761EF89489D5;
_w2W5_D = 0x3FFD8FB48B966D48;
_w2W5_N = 0;
store64(_w2W5_o, 0x7FF4000000000001);
var _w2W5_t4, _w2W5_v4 = ode_bdf2_checked(&_w2W5_ftri, 0, 0x4027763FCDB5328C, 0x40275524F1287FE4,
  0x3FB47CF0FE3B0F64, 0x3FB999999999999A, _w2W5_o);
assert_eq(_w2W5_v4, HSB_ERR_NO_CONVERGENCE,
  "bdf2, tri, tol 0.1, the predictor -> NO_CONVERGENCE (merged tree: Ok 0x40278148C1E418C4, unread)");
assert_eq(load64(_w2W5_o), 0x7FF4000000000001, "bdf2, tri, tol 0.1, refused -> out untouched");
# 3.5.0 W5 (second review): 18 -> 19, at z = s no path lies behind the predictor, so the first secant ahead
# does not refuse alone: both fall (g' < 0 ahead and behind), read over 2^-26 |z| each.
assert_eq(_w2W5_N, 19, "bdf2, tri, tol 0.1, refused -> 19 evaluations (merged tree: 1)");

# (5) An exact equilibrium is the root at every sigma: y' = 4 (y - 1/2) from 1/2, dt 1, where c f' = 4 and
# g' = -3. Ok(1/2) unread, Newton's 2 evaluations, as the merged tree.
fn _w2W5_unst(t, y) {
    _w2W5_N = _w2W5_N + 1;
    return f64_mul(0x4010000000000000, f64_sub(y, 0x3FE0000000000000));   # 4 (y - 0.5)
}
_w2W5_N = 0;
var _w2W5_t5, _w2W5_v5 = ode_backward_euler_checked(&_w2W5_unst, 0, 0x3FE0000000000000, F64_ONE,
  0x3D719799812DEA11, 50, _w2W5_o);
assert_eq(is_ok(_w2W5_t5), 1, "backward Euler at an unstable equilibrium, f(y) = 0 exactly -> Ok");
assert_eq(load64(_w2W5_o), 0x3FE0000000000000, "backward Euler at an unstable equilibrium -> y itself, 0.5");
assert_eq(_w2W5_N, 2, "backward Euler at an unstable equilibrium -> Newton's 2 evaluations, the slope unread");

# (7) BDF-2 from rest with f(0) = 2^-40 != 0: the predictor 0 meets |g| < tol, and g' = 1 - (2/3) 3 = -1 there
# (y' = 3 y + 2^-40, dt 1, c = 2/3): the root, -c f(0) / (1 - 3 c), lies behind the direction the branch
# leaves 0 in, and the branch z(sigma) = sigma c f(0) / (1 - 3 sigma c) runs to infinity as sigma rises to
# 1/2, so it has no root at sigma = 1. The slope is read along c f(0), the move the branch starts with.
fn _w2W5_rest(t, y) {
    _w2W5_N = _w2W5_N + 1;
    return f64_add(f64_mul(0x4008000000000000, y), 0x3D70000000000000);   # 3 y + 2^-40
}
_w2W5_N = 0;
store64(_w2W5_o, 0x7FF4000000000001);
var _w2W5_t7, _w2W5_v7 = ode_bdf2_checked(&_w2W5_rest, 0, 0, 0, F64_ONE, 0x3DDB7CDFD9D7BDBB, _w2W5_o);
assert_eq(_w2W5_v7, HSB_ERR_NO_CONVERGENCE,
  "bdf2 from rest, f(0) = 2^-40, g'(0) = -1 -> NO_CONVERGENCE (merged tree: Ok 0)");
assert_eq(load64(_w2W5_o), 0x7FF4000000000001, "bdf2 from rest, refused -> out untouched");

# (6) _ode_gsec directly: g' = 1 - c f_y read as the secant over [z, z + h], h of either sign: 1 where it is
# positive and resolved (2^-24 (1 + |c f_y|)) or +Inf, 0 where it is read and is neither, 2 where it is not read.
var _w2W5_K = 0;
fn _w2W5_lin(t, y) {
    _w2W5_N = _w2W5_N + 1;
    return f64_mul(_w2W5_K, y);
}
fn _w2W5_wall(t, y) {
    if (f64_lt(F64_ONE, y) == 1) { return F64_POS_INF; }
    return y;
}
_w2W5_K = 0x4008000000000000;                                                   # 3: g' = -2
assert_eq(_ode_gsec(&_w2W5_lin, 0, F64_ONE, 0x4008000000000000, F64_ONE, 0x3E50000000000000), 0,
  "_ode_gsec: f = 3y, c = 1, h = 2^-26 -> g' = -2, 0");
_w2W5_K = 0xBFF0000000000000;                                                   # -1: g' = 2
assert_eq(_ode_gsec(&_w2W5_lin, 0, F64_ONE, 0xBFF0000000000000, F64_ONE, 0xBE50000000000000), 1,
  "_ode_gsec: f = -y, c = 1, h = -2^-26 -> g' = 2, 1");
# f = K (y - 1) at z = 1: f(1) = 0 and f(1 + 2^-26) = K 2^-26, both exact, so the difference reads K exactly.
fn _w2W5_lin1(t, y) { return f64_mul(_w2W5_K, f64_sub(y, F64_ONE)); }
_w2W5_K = 0x3FEFFFFFFF800000;                                                   # 1 - 2^-30: g' = 2^-30
assert_eq(_ode_gsec(&_w2W5_lin1, 0, F64_ONE, 0, F64_ONE, 0x3E50000000000000), 0,
  "_ode_gsec: g' = 2^-30, under 2^-24 (1 + |c f_y|) -> not resolved, 0");
_w2W5_K = 0x3FEFFFFE00000000;                                                   # 1 - 2^-20: g' = 2^-20
assert_eq(_ode_gsec(&_w2W5_lin1, 0, F64_ONE, 0, F64_ONE, 0x3E50000000000000), 1,
  "_ode_gsec: g' = 2^-20, over the margin -> 1");
_w2W5_K = 0xFE37E43C8800759C;                                                   # -1e300
assert_eq(_ode_gsec(&_w2W5_lin, 0, F64_ONE, 0xFE37E43C8800759C, 0x4202A05F20000000, 0x3E50000000000000), 1,
  "_ode_gsec: c f_y = 1e10 (-1e300) = -Inf -> g' = +Inf, 1");
assert_eq(_ode_gsec(&_w2W5_wall, 0, F64_ONE, F64_ONE, 0x4008000000000000, 0x3E50000000000000), 2,
  "_ode_gsec: f infinite past z at every step tried -> no slope read, 2");

# ==================================================================================================
test_group("3.5.0 W5: the slope is read into the path, at two scales");
# _ode_zslope(f, t, z, fz, c, m, onp), m the way from z into the step's path, onp = 1 where |m| is the path's
# length (z != s). f below is continuous and piecewise linear with one kink at ZK, slope S1 at or below it and S2
# above, and _w2W5_SG = -1 mirrors it (f(-y) negated), so every case can be read in both orientations. With c = 1,
# g' = 1 - S on each piece; every difference below is exact. The first secant is over hc = 2^-26 max(|z|, |m|)
# (2^-26 |z| in every case of this group) into the path, the second over hc out of it, and the third, where the
# two disagree, over hf = 2^-26 |m| (at least 2^-52 |z|, at most |m|) into the path.
var _w2W5_SG = 0x3FF0000000000000;
var _w2W5_ZK = 0;
var _w2W5_S1 = 0;
var _w2W5_S2 = 0;
fn _w2W5_kink(t, y) {
    _w2W5_N = _w2W5_N + 1;
    var yy = f64_mul(_w2W5_SG, y);
    var sl = _w2W5_S2;
    if (f64_le(yy, _w2W5_ZK) == 1) { sl = _w2W5_S1; }
    return f64_mul(_w2W5_SG, f64_mul(sl, f64_sub(yy, _w2W5_ZK)));
}
# One reading of _ode_zslope at SG z, way SG m: its verdict, with the evaluations in _w2W5_N.
fn _w2W5_zs(z, m) {
    var zz = f64_mul(_w2W5_SG, z);
    var fz = _w2W5_kink(0, zz);
    _w2W5_N = 0;
    return _ode_zslope(&_w2W5_kink, 0, zz, fz, F64_ONE, f64_mul(_w2W5_SG, m), 1);
}
var _w2W5_sg = 0;
while (_w2W5_sg < 2) {
    _w2W5_SG = 0x3FF0000000000000;
    if (_w2W5_sg == 1) { _w2W5_SG = 0xBFF0000000000000; }
    # A kink at z = 1: g' = 2 below it, -2 above.
    _w2W5_ZK = F64_ONE;
    _w2W5_S1 = 0xBFF0000000000000;
    _w2W5_S2 = 0x4008000000000000;
    assert_eq(_w2W5_zs(F64_ONE, F64_HALF), 0, "_ode_zslope: path above z, g falls into z -> 0");
    assert_eq(_w2W5_N, 1, "_ode_zslope: ... refused by the first secant alone, on the path (1 evaluation)");
    assert_eq(_w2W5_zs(F64_ONE, 0xBFE0000000000000), 1,
      "_ode_zslope: path below z, g rises into z and falls past it -> 1 (the first 3.5.0 form, above z: 0)");
    assert_eq(_w2W5_N, 3, "_ode_zslope: ... the two secants disagree, hf = 2^-27 decides (3 evaluations)");
    assert_eq(_w2W5_zs(F64_ONE, 0xBFF0000000000000), 1, "_ode_zslope: ... with |m| = |z| -> 1");
    assert_eq(_w2W5_N, 2, "_ode_zslope: ... hf = hc, no finer step: the first secant decides (2 evaluations)");
    # The second root of a pair 2^-10 wide at z = 2^20, path below: hc = 2^-6 reaches past the pair's first
    # root and its secant rises (g' = 2 there); out of the path g' = -2; hf = 2^-26 reads g' = -2.
    _w2W5_ZK = 0x412FFFFFFF800000;                                              # 2^20 - 2^-10
    assert_eq(_w2W5_zs(0x4130000000000000, 0xBFF0000000000000), 0,
      "_ode_zslope: the second root of a pair narrower than 2^-26 |z|, wider than 2^-26 |m| -> 0");
    assert_eq(_w2W5_N, 3, "_ode_zslope: ... refused by the reading over hf (3 evaluations)");
    # A move of 2^-30 at z = 1, shorter than hc = 2^-26: the secants over hc reach past s.
    _w2W5_K = 0x4008000000000000;
    var _w2W5_lz = f64_mul(_w2W5_SG, F64_ONE);
    var _w2W5_lf = _w2W5_lin(0, _w2W5_lz);
    _w2W5_N = 0;
    assert_eq(_ode_zslope(&_w2W5_lin, 0, _w2W5_lz, _w2W5_lf, F64_ONE, f64_mul(_w2W5_SG, 0xBE10000000000000), 1), 0,
      "_ode_zslope: f = 3y, a move of 2^-30 -> 0, g falls on both sides");
    assert_eq(_w2W5_N, 2, "_ode_zslope: ... the first secant reached past s, so the second was read (2)");
    _w2W5_ZK = 0x3FEFFFFFFE000000;                                              # 1 - 2^-28, past s
    _w2W5_S1 = 0x4008000000000000;
    _w2W5_S2 = 0xBFF0000000000000;
    assert_eq(_w2W5_zs(F64_ONE, 0xBE10000000000000), 1,
      "_ode_zslope: a move of 2^-30, g falls past s and rises from s through z -> 1");
    assert_eq(_w2W5_N, 3, "_ode_zslope: ... read again over hf = 2^-52, the next double (3 evaluations)");
    _w2W5_S1 = 0xBFF0000000000000;
    _w2W5_S2 = 0x4008000000000000;
    assert_eq(_w2W5_zs(F64_ONE, 0xBE10000000000000), 0,
      "_ode_zslope: a move of 2^-30, g rises past s and falls from s through z -> 0");
    assert_eq(_w2W5_N, 3, "_ode_zslope: ... refused over hf = 2^-52 (2^-56 is no step at all)");
    _w2W5_sg = _w2W5_sg + 1;
}
# hf at most |m|: a move of 2^-53 below z = 1. f = 1 - y on the move, 3 (y - 1) above, and -1e-10 below it: the
# first secant rises off the path, the second falls, and over hf = 2^-53 (not 2^-52, which reaches past s,
# where g' < 0) g' = 2.
fn _w2W5_cap(t, y) {
    _w2W5_N = _w2W5_N + 1;
    if (f64_lt(F64_ONE, y) == 1) { return f64_mul(0x4008000000000000, f64_sub(y, F64_ONE)); }
    if (f64_le(0x3FEFFFFFFFFFFFFF, y) == 1) { return f64_sub(F64_ONE, y); }
    return 0xBDDB7CDFD9D7BDBB;                                                  # -1e-10
}
_w2W5_N = 0;
assert_eq(_ode_zslope(&_w2W5_cap, 0, F64_ONE, 0, F64_ONE, 0xBCA0000000000000, 1), 1,
  "_ode_zslope: a move of 2^-53 -> 1, hf held to |m|");
assert_eq(_w2W5_N, 3, "_ode_zslope: ... 3 evaluations");

# Backward Euler (dt 1, max_newton 50) on f(t, y) = SG ((SG y - S) - G(SG y - Y0)), so the step's g(z) is
# G(z - Y0) mirrored by SG. Case A: G(u) = 2u for u >= k = -1e-4, and G(k) - 50 (u - k) below, from S = Y0 + 10:
# the branch's root is u = 0, and a second root u = k - 4e-6, 1.04e-4 past it, where |g| peaks at 2e-4 (20 tol)
# between them. At Y0 = 1e6, hc = 0.0149 spans the pair and hf = 1.5e-7 does not.
# [measured: closed form of G; the steps it gives, tests/modules_d.tcyr, below]
var _w2W5_Y0 = 0;
var _w2W5_S = 0;
var _w2W5_CB = 0;
fn _w2W5_ga(u) {
    if (f64_le(0xBF1A36E2EB1C432D, u) == 1) { return f64_mul(0x4000000000000000, u); }
    return f64_sub(f64_mul(0x4000000000000000, 0xBF1A36E2EB1C432D),
      f64_mul(0x4049000000000000, f64_sub(u, 0xBF1A36E2EB1C432D)));
}
# Case B: G(u) = u / 2 up to u = 1e-7, and G(1e-7) - 50 (u - 1e-7) above: g turns back 1e-7 past the branch's
# root u = 0 and crosses 0 again at 1.01e-7.
# [measured: closed form of G; the steps it gives, tests/modules_d.tcyr, below]
fn _w2W5_gb(u) {
    if (f64_le(u, 0x3E7AD7F29ABCAF48) == 1) { return f64_mul(F64_HALF, u); }
    return f64_sub(f64_mul(F64_HALF, 0x3E7AD7F29ABCAF48), f64_mul(0x4049000000000000, f64_sub(u, 0x3E7AD7F29ABCAF48)));
}
fn _w2W5_fab(t, y) {
    _w2W5_N = _w2W5_N + 1;
    var yy = f64_mul(_w2W5_SG, y);
    var u = f64_sub(yy, _w2W5_Y0);
    var gg = _w2W5_ga(u);
    if (_w2W5_CB == 1) { gg = _w2W5_gb(u); }
    return f64_mul(_w2W5_SG, f64_sub(f64_sub(yy, _w2W5_S), gg));
}
fn _w2W5_step(cb, y0, s, sg, tol) {
    _w2W5_CB = cb;
    _w2W5_Y0 = y0;
    _w2W5_S = s;
    _w2W5_SG = sg;
    _w2W5_N = 0;
    store64(_w2W5_o, 0x7FF4000000000001);
    var t, v = ode_backward_euler_checked(&_w2W5_fab, 0, f64_mul(sg, s), F64_ONE, tol, 50, _w2W5_o);
    return v;
}
var _w2W5_ya = 0x412E848000000000;                                              # 1e6
var _w2W5_sa = 0x412E849400000000;                                              # 1e6 + 10
var _w2W5_va = _w2W5_step(0, _w2W5_ya, _w2W5_sa, F64_ONE, 0x3EE4F8B588E368F1);
assert_eq(_w2W5_va, 0, "case A at 1e6, tol 1e-5, moving down -> Ok (merged tree: Ok on the second root)");
assert_eq(load64(_w2W5_o), 0x412E848000000000,
  "case A ... -> 1e6, the branch's root (merged tree and the first 3.5.0 form: 0x412E847FFFF25E57)");
assert_eq(_w2W5_N, 133, "case A ... -> 133 evaluations: Newton's answer refused, the continuation's certified");
_w2W5_va = _w2W5_step(0, _w2W5_ya, _w2W5_sa, 0xBFF0000000000000, 0x3EE4F8B588E368F1);
# The mirror's certificate refuses Newton's second root as well; the continuation that follows reads its own
# slopes 2^-26 |z| above each point, across the pair, and stops short: the roadmap row "The ODE continuation's
# guard slopes read only above each point" (carried from 3.5.0). Its repair is expected to turn the three
# assertions below into Ok(-1e6).
assert_eq(_w2W5_va, HSB_ERR_NO_CONVERGENCE,
  "case A mirrored, moving up -> NO_CONVERGENCE (merged tree: Ok on the second root, -0x412E847FFFF25E57)");
assert_eq(load64(_w2W5_o), 0x7FF4000000000001, "case A mirrored -> out untouched");
assert_eq(_w2W5_N, 153, "case A mirrored -> 153 evaluations");
# The certificate's slope at the pair's two roots, both orientations: refused at the second, passed at the first.
var _w2W5_r2 = 0x412E847FFFF25E57;
_w2W5_sg = 0;
while (_w2W5_sg < 2) {
    _w2W5_SG = 0x3FF0000000000000;
    if (_w2W5_sg == 1) { _w2W5_SG = 0xBFF0000000000000; }
    _w2W5_CB = 0;
    _w2W5_Y0 = _w2W5_ya;
    _w2W5_S = _w2W5_sa;
    var _w2W5_zr = f64_mul(_w2W5_SG, _w2W5_r2);
    var _w2W5_fr = _w2W5_fab(0, _w2W5_zr);
    var _w2W5_m2 = f64_mul(_w2W5_SG, f64_sub(_w2W5_sa, _w2W5_r2));
    assert_eq(_ode_zslope(&_w2W5_fab, 0, _w2W5_zr, _w2W5_fr, F64_ONE, _w2W5_m2, 1), 0,
      "case A: the slope at the second root -> 0, either orientation (the first 3.5.0 form: 1 moving down)");
    _w2W5_zr = f64_mul(_w2W5_SG, _w2W5_ya);
    _w2W5_fr = _w2W5_fab(0, _w2W5_zr);
    assert_eq(_ode_zslope(&_w2W5_fab, 0, _w2W5_zr, _w2W5_fr, F64_ONE, f64_mul(_w2W5_SG, 0x4024000000000000), 1), 1,
      "case A: the slope at the branch's root -> 1, either orientation (reading only out of the path: 0)");
    _w2W5_sg = _w2W5_sg + 1;
}
# Case B, from Y0 - 10 at tol 1e-10, Y0 = 10 and 1e6, both orientations: Ok on the branch's root Y0 exactly. The
# first 3.5.0 form read g' 2^-26 |z| above z and refused it moving up (NO_CONVERGENCE after 12 evaluations).
_w2W5_va = _w2W5_step(1, 0x4024000000000000, 0, F64_ONE, 0x3DDB7CDFD9D7BDBB);
assert_eq(_w2W5_va, 0, "case B at 10, moving up -> Ok (the first 3.5.0 form: NO_CONVERGENCE)");
assert_eq(load64(_w2W5_o), 0x4024000000000000, "case B at 10 -> 10, the branch's root");
assert_eq(_w2W5_N, 69, "case B at 10 -> 69 evaluations: Newton's 4, the slope's 2 and 63 samples (merged: 67)");
_w2W5_va = _w2W5_step(1, 0x4024000000000000, 0, 0xBFF0000000000000, 0x3DDB7CDFD9D7BDBB);
assert_eq(_w2W5_va, 0, "case B at 10 mirrored, moving down -> Ok");
assert_eq(load64(_w2W5_o), 0xC024000000000000, "case B at 10 mirrored -> -10");
assert_eq(_w2W5_N, 69, "case B at 10 mirrored -> 69 evaluations");
_w2W5_va = _w2W5_step(1, _w2W5_ya, 0x412E846C00000000, F64_ONE, 0x3DDB7CDFD9D7BDBB);
assert_eq(_w2W5_va, 0, "case B at 1e6, moving up -> Ok (the first 3.5.0 form: NO_CONVERGENCE)");
assert_eq(load64(_w2W5_o), 0x412E848000000000, "case B at 1e6 -> 1e6, the branch's root");
assert_eq(_w2W5_N, 70, "case B at 1e6 -> 70 evaluations: the secants disagree, hf decides");
_w2W5_va = _w2W5_step(1, _w2W5_ya, 0x412E846C00000000, 0xBFF0000000000000, 0x3DDB7CDFD9D7BDBB);
assert_eq(_w2W5_va, 0, "case B at 1e6 mirrored, moving down -> Ok");
assert_eq(load64(_w2W5_o), 0xC12E848000000000, "case B at 1e6 mirrored -> -1e6");
assert_eq(_w2W5_N, 70, "case B at 1e6 mirrored -> 70 evaluations");

# The first secant is over 2^-26 |z|, not 2^-26 of the move. Backward Euler on y' = sin(y - 1e5) from 1e5 - 1
# ulp, dt 1, tol 1e-8: g = u - u0 - sin u (u = z - 1e5) has g' = 1 - cos u >= 0, one root (u near -4.4e-4) and
# |g| < 1.5e-11 from Newton's answer to it, so that answer is right. g'(z) is about u^2 / 2, 4e-22, which a
# difference over 2^-26 of the move (2^-26 of 1.5e-11) reads as 0 within its rounding; over 2^-26 |z| it
# reads the curvature, 3.7e-7, above the margin.
fn _w2W5_sinc(t, y) {
    _w2W5_N = _w2W5_N + 1;
    return f64_sin(f64_sub(y, 0x40F86A0000000000));
}
_w2W5_N = 0;
store64(_w2W5_o, 0x7FF4000000000001);
var _w2W5_ts, _w2W5_vs = ode_backward_euler_checked(&_w2W5_sinc, 0, 0x40F869FFFFFFFFFF, F64_ONE,
  0x3E45798EE2308C3A, 50, _w2W5_o);
assert_eq(is_ok(_w2W5_ts), 1, "backward Euler, sin(y - 1e5) from 1e5 - 1 ulp -> Ok (a step over 2^-26 |m|: Err)");
assert_eq(load64(_w2W5_o), 0x40F869FFFFFFFFFE, "backward Euler, sin(y - 1e5) -> 1e5 - 2 ulps, the merged tree's");
assert_eq(_w2W5_N, 6, "backward Euler, sin(y - 1e5) -> 6 evaluations: Newton's 2, the slope's 2, 2 doubles");

# The edges of the two-scale reading, each a case a slip in one of them would turn.
# A reach exactly as long as the move ends on s, so it is on the path: f = 3y at z = 1, a move of 2^-26 below.
_w2W5_K = 0x4008000000000000;
_w2W5_N = 0;
assert_eq(_ode_zslope(&_w2W5_lin, 0, F64_ONE, 0x4008000000000000, F64_ONE, 0xBE50000000000000, 1), 0,
  "_ode_zslope: f = 3y, hc = |m| = 2^-26 -> 0");
assert_eq(_w2W5_N, 1, "_ode_zslope: ... refused by the first secant, its reach on the path (1 evaluation)");
# The finest step is at least 2^-52 |z|: at z = 1 with the path above, 2^-53 rounds back onto 1 (a tie to even).
# A move of 2^-30 above z = 1, a kink 2^-28 above it: g' = -2 up to the kink, 2 past it.
_w2W5_SG = 0x3FF0000000000000;
_w2W5_ZK = 0x3FF0000001000000;                                                  # 1 + 2^-28
_w2W5_S1 = 0x4008000000000000;
_w2W5_S2 = 0xBFF0000000000000;
assert_eq(_w2W5_zs(F64_ONE, 0x3E10000000000000), 0,
  "_ode_zslope: a move of 2^-30 above z = 1, g falls from s through z -> 0, read over 2^-52 (2^-53: no step)");
assert_eq(_w2W5_N, 3, "_ode_zslope: ... 3 evaluations");
# A fine reading that cannot be read says nothing: f is NaN on (z - 2^-20, z), z = 2^20, path below. The coarse
# secants disagree (a kink at z: g' = 2 below, -2 above), and over 2^-26, 2^-52 and 2^-78 f is NaN or z itself.
fn _w2W5_hole(t, y) {
    if (f64_lt(y, 0x4130000000000000) == 1 && f64_lt(0x412FFFFFFFFFE000, y) == 1) { return 0x7FF8000000000000; }
    return _w2W5_kink(t, y);
}
_w2W5_ZK = 0x4130000000000000;
_w2W5_S1 = 0xBFF0000000000000;
_w2W5_S2 = 0x4008000000000000;
assert_eq(_ode_zslope(&_w2W5_hole, 0, 0x4130000000000000, 0, F64_ONE, 0xBFF0000000000000, 1), 1,
  "_ode_zslope: the reading over hf finds no finite difference -> 1, the samples decide");
# z = s: the slope is read along c f(t, s), the way the branch leaves s. BDF-2 from y = y_prev = 1 (the
# predictor 1), dt 1.5, tol 0.1, f = 0.01 + S (y - 1), S = -1 below 1 and 3 above: g(1) = -0.01 meets tol, and
# g' = 2 behind s, -2 ahead, so g has no root at all and the branch folds at sigma = 1/3. Read behind s (the
# other way), the slope would pass s, as the merged tree returned it unread.
fn _w2W5_zs1(t, y) {
    _w2W5_N = _w2W5_N + 1;
    var sl = 0x4008000000000000;
    if (f64_le(y, F64_ONE) == 1) { sl = 0xBFF0000000000000; }
    return f64_add(0x3F847AE147AE147B, f64_mul(sl, f64_sub(y, F64_ONE)));
}
_w2W5_N = 0;
store64(_w2W5_o, 0x7FF4000000000001);
var _w2W5_tz, _w2W5_vz = ode_bdf2_checked(&_w2W5_zs1, 0, F64_ONE, F64_ONE, 0x3FF8000000000000, 0x3FB999999999999A,
  _w2W5_o);
assert_eq(_w2W5_vz, HSB_ERR_NO_CONVERGENCE, "bdf2, the predictor in tol, g falls ahead of it -> NO_CONVERGENCE");
assert_eq(load64(_w2W5_o), 0x7FF4000000000001,
  "bdf2, the predictor in tol, g falls ahead of it -> out untouched (merged tree: Ok 1, unread)");

# ==================================================================================================
test_group("3.5.0 W5: the slope's first reach, and the answer at s");
# The second wave-2 review. Through it the first secants spanned 2^-26 |z|: at an answer nearer 0 than the move
# that is below f's own rounding, which scales with c f(z), about |m|. And at z = s the first secant ahead
# refused on its own, though c f(s) is not the way to the branch's root. Every root, pair and fold below is
# exact (f is piecewise linear; Python Fractions over the doubles given).
# [measured: closed form of each f; the steps it gives, tests/modules_d.tcyr, below]
fn _w2W5_half(t, y) {
    _w2W5_N = _w2W5_N + 1;
    return f64_add(F64_ONE, f64_mul(F64_HALF, y));                              # 1 + y/2
}
# y' = 1 + y/2 by backward Euler from y = -1 + 4.0e-9 (dt 1, tol 1e-12): one root, 2 (y + 1) = 8.0000004e-9, and
# g' = 1/2 everywhere. Newton's answer is 1.8e-12 below the root, |g| = 9.1e-13 < tol. There |z| = 8e-9 and the move
# is about 1: a secant over 2^-26 |z| = 1.2e-16 moves f by 6e-17, under half an ulp of f, and read g' = -0.86 into
# the path, so the second 3.5.0 form refused the step. Over 2^-26 |m| both secants read 1/2.
_w2W5_N = 0;
store64(_w2W5_o, 0x7FF4000000000001);
var _w2W5_th, _w2W5_vh = ode_backward_euler_checked(&_w2W5_half, 0, 0xBFEFFFFFFDDA3E81, F64_ONE, 0x3D719799812DEA11,
  50, _w2W5_o);
assert_eq(is_ok(_w2W5_th), 1, "y' = 1 + y/2, backward Euler, the root near 0 -> Ok (the second 3.5.0 form: Err)");
assert_eq(load64(_w2W5_o), 0x3E412D0BFC000000, "y' = 1 + y/2, backward Euler -> 3.4.2's bits, inside tol of the root");
assert_eq(_w2W5_N, 93, "y' = 1 + y/2, backward Euler -> 93 evaluations: Newton's 28, the slope's 2, 63 samples");
_w2W5_N = 0;
var _w2W5_th2, _w2W5_vh2 = ode_bdf2_checked(&_w2W5_half, 0, 0xBFEFFFFFFDDA3E81, 0xBFEFFFFFFDDA3E81,
  0x3FF8000000000000, 0x3D719799812DEA11, _w2W5_o);
assert_eq(is_ok(_w2W5_th2), 1, "y' = 1 + y/2, bdf2, dt 1.5 -> Ok (the second 3.5.0 form: Err)");
assert_eq(load64(_w2W5_o), 0x3E412D0BFC000000, "y' = 1 + y/2, bdf2 -> 3.4.2's bits");
assert_eq(_w2W5_N, 92, "y' = 1 + y/2, bdf2 -> 92 evaluations");
var _w2W5_zh = 0x3E412D0BFC000000;
var _w2W5_fh = _w2W5_half(0, _w2W5_zh);
_w2W5_N = 0;
assert_eq(_ode_zslope(&_w2W5_half, 0, _w2W5_zh, _w2W5_fh, F64_ONE, f64_sub(0xBFEFFFFFFDDA3E81, _w2W5_zh), 1), 1,
  "_ode_zslope: at the answer of y' = 1 + y/2 -> 1, read over 2^-26 |m| (over 2^-26 |z|: 0)");
assert_eq(_w2W5_N, 2, "_ode_zslope: ... both secants read g' = 1/2 (2 evaluations)");

# A pair 0.002 wide whose second root is at 1.0e-12: backward Euler (dt 1, tol 1e-10) on f(t, y) = SG ((SG y + 1) -
# G(SG y)) from SG (-1), so g = G mirrored: G rises with slope 2 through R1 = -0.002, the branch's root, and falls
# with slope -2 past ZP. Newton reaches 4.16e-11, past the second root, cut off from R1 by |g| up to 0.002 (2e7 tol).
# The second 3.5.0 form's secants over 2^-26 |z| = 6.2e-19 saw f unchanged and passed it; over 2^-26 |m| the first
# secant reads g' = -2 on the path, and the continuation answers R1 (6.3e-12 past it, g = 0.13 tol). Mirrored,
# Newton reaches R1 itself, as in the second form.
# [measured: exact roots in Fractions over these doubles (scratch w5p orc.py); the steps, tests/modules_d.tcyr, below]
fn _w2W5_g2(u) {
    if (f64_le(u, 0xBF50624DD2CE7AC9) == 1) { return f64_mul(0x4000000000000000, f64_sub(u, 0xBF60624DD2F1A9FC)); }
    return f64_sub(f64_mul(0x4000000000000000, f64_sub(0xBF50624DD2CE7AC9, 0xBF60624DD2F1A9FC)),
      f64_mul(0x4000000000000000, f64_sub(u, 0xBF50624DD2CE7AC9)));
}
fn _w2W5_fp(t, y) {
    _w2W5_N = _w2W5_N + 1;
    var yy = f64_mul(_w2W5_SG, y);
    return f64_mul(_w2W5_SG, f64_sub(f64_add(yy, F64_ONE), _w2W5_g2(yy)));
}
_w2W5_SG = F64_ONE;
_w2W5_N = 0;
var _w2W5_tp, _w2W5_vp = ode_backward_euler_checked(&_w2W5_fp, 0, 0xBFF0000000000000, F64_ONE, 0x3DDB7CDFD9D7BDBB, 50,
  _w2W5_o);
assert_eq(is_ok(_w2W5_tp), 1, "a pair 0.002 wide at 1e-12, backward Euler -> Ok");
assert_eq(load64(_w2W5_o), 0xBF60624DD214C865,
  "a pair 0.002 wide -> the branch's root -0.002 (the second 3.5.0 form: 0x3DC6DAFF2C3B8380, the second root)");
assert_eq(_w2W5_N, 174, "a pair 0.002 wide -> 174 evaluations: Newton's answer refused, the continuation's certified");
_w2W5_N = 0;
var _w2W5_fz2 = _w2W5_fp(0, 0x3DC6DAFF2C3B8380);
var _w2W5_mz2 = f64_sub(0xBFF0000000000000, 0x3DC6DAFF2C3B8380);
_w2W5_N = 0;
assert_eq(_ode_zslope(&_w2W5_fp, 0, 0x3DC6DAFF2C3B8380, _w2W5_fz2, F64_ONE, _w2W5_mz2, 1), 0,
  "_ode_zslope: at the pair's second root -> 0 (over 2^-26 |z|: 1)");
assert_eq(_w2W5_N, 1, "_ode_zslope: ... the first secant falls on the path (1 evaluation)");
_w2W5_SG = 0xBFF0000000000000;
_w2W5_N = 0;
var _w2W5_tp2, _w2W5_vp2 = ode_backward_euler_checked(&_w2W5_fp, 0, F64_ONE, F64_ONE, 0x3DDB7CDFD9D7BDBB, 50, _w2W5_o);
assert_eq(is_ok(_w2W5_tp2), 1, "a pair 0.002 wide mirrored -> Ok");
assert_eq(load64(_w2W5_o), 0x3F60624DD2F19B2D, "a pair 0.002 wide mirrored -> 0.002, 1.6e-15 from the root");

# z = s. BDF-2 from y = y_prev = SG 1 (dt 1.5, so c = 1; tol 1e-6) on f = PC SG (1e-7 - 99 (SG y - 1)) up to SG y = K,
# and slope 1000 past it. At K = 1 + 1.35e-9: g = 100 (z - 1) - 1e-7 rises from the predictor 1 (|g| = 1e-7 < tol) to
# the branch's root 1 + 1e-9, turns at K and falls through a second root at 1 + 1.385e-9. 1 is right: |g| <= 1e-7
# all the way to the root, which is nearer than any other. c f(1) = 1e-7 overstates the way to the root 100 times,
# so the first secant ahead over 2^-26 = 1.5e-8 crosses both roots and reads g' = -900, and the second 3.5.0 form
# refused on it alone (NO_CONVERGENCE after 19; mirrored, the continuation's 0xBFF00000003C83B0 after 89). Behind 1
# g' = 100; ahead over 2^-26 c f(1) = 1.5e-15 g' = 100, and Newton's step from 1 at that slope lands on the root.
# [measured: exact roots in Fractions over these doubles (scratch w5p orc.py); the steps, tests/modules_d.tcyr, below]
var _w2W5_PA = 0;
var _w2W5_PS1 = 0;
var _w2W5_PS2 = 0;
var _w2W5_PK = 0;
var _w2W5_PC = F64_ONE;
fn _w2W5_pw(t, y) {
    _w2W5_N = _w2W5_N + 1;
    var yy = f64_mul(_w2W5_SG, y);
    var v = f64_add(_w2W5_PA, f64_mul(_w2W5_PS1, f64_sub(yy, F64_ONE)));
    if (f64_lt(_w2W5_PK, yy) == 1) {
        v = f64_add(f64_add(_w2W5_PA, f64_mul(_w2W5_PS1, f64_sub(_w2W5_PK, F64_ONE))),
          f64_mul(_w2W5_PS2, f64_sub(yy, _w2W5_PK)));
    }
    return f64_mul(_w2W5_PC, f64_mul(_w2W5_SG, v));
}
# One BDF-2 step from SG 1 at dt, tol 1e-6: its code, with the answer in _w2W5_o and the evaluations in _w2W5_N.
fn _w2W5_zstep(sg, dt) {
    _w2W5_SG = sg;
    _w2W5_N = 0;
    store64(_w2W5_o, 0x7FF4000000000001);
    var t, v = ode_bdf2_checked(&_w2W5_pw, 0, sg, sg, dt, 0x3EB0C6F7A0B5ED8D, _w2W5_o);
    return v;
}
_w2W5_PA = 0x3E7AD7F29ABCAF48;                                                  # 1e-7
_w2W5_PS1 = 0xC058C00000000000;                                                 # -99
_w2W5_PS2 = 0x408F400000000000;                                                 # 1000
_w2W5_PK = 0x3FF00000005CC573;                                                  # K, j = 1 below
assert_eq(_w2W5_zstep(F64_ONE, 0x3FF8000000000000), 0, "z = s, the root before g turns -> Ok (the second form: Err)");
assert_eq(load64(_w2W5_o), F64_ONE, "z = s, the root before g turns -> the predictor 1, 3.4.2's answer");
assert_eq(_w2W5_N, 5, "z = s, the root before g turns -> 5 evaluations: f(s), two secants, the reading over hf, f(q)");
assert_eq(_w2W5_zstep(0xBFF0000000000000, 0x3FF8000000000000), 0, "z = s, the root before g turns, mirrored -> Ok");
assert_eq(load64(_w2W5_o), 0xBFF0000000000000, "z = s, mirrored -> -1 (the second form: 0xBFF00000003C83B0)");
assert_eq(_w2W5_N, 5, "z = s, mirrored -> 5 evaluations");
# c = 2^-10 (dt 1.5 2^-10) with f scaled by 2^10: the same g, so the same verdict, read along c f(s), not f(s).
_w2W5_PC = 0x4090000000000000;
assert_eq(_w2W5_zstep(F64_ONE, 0x3F58000000000000), 0, "z = s, c = 2^-10 -> Ok, the move c f(s) = 1e-7");
assert_eq(load64(_w2W5_o), F64_ONE, "z = s, c = 2^-10 -> the predictor 1");
_w2W5_PC = F64_ONE;
# K = 1 + 1e-9 (1 + 0.35 j), j = 1 .. 35: the root before g turns each time, both orientations.
var _w2W5_jz = 1;
var _w2W5_okz = 0;
while (_w2W5_jz <= 35) {
    var _w2W5_kj = f64_add(F64_ONE, f64_mul(0x3FD6666666666666, f64_from(_w2W5_jz)));     # 1 + 0.35 j
    _w2W5_PK = f64_add(F64_ONE, f64_mul(0x3E112E0BE826D695, _w2W5_kj));
    if (_w2W5_zstep(F64_ONE, 0x3FF8000000000000) == 0 && load64(_w2W5_o) == F64_ONE) { _w2W5_okz = _w2W5_okz + 1; }
    if (_w2W5_zstep(0xBFF0000000000000, 0x3FF8000000000000) == 0 && load64(_w2W5_o) == 0xBFF0000000000000) {
        _w2W5_okz = _w2W5_okz + 1;
    }
    _w2W5_jz = _w2W5_jz + 1;
}
assert_eq(_w2W5_okz, 70, "z = s, K = 1 + 1e-9 (1 + 0.35 j), j = 1 .. 35, both ways -> Ok at s, 70 (second form: 0)");
# K = 1 + 1e-10, before the root: g reaches -9e-8 there and falls with slope -999 past it, and behind 1 g is below
# -1e-7, so g has no root and the branch folds at K. The reading over hf rises, but Newton's step from 1 lands past
# K, where g is -9.9e-7, farther from 0 than g(1): refused (3.4.2: Ok 1, unread; a reading over hf alone: Ok 1).
# [measured: exact roots in Fractions over these doubles (scratch w5p orc.py); the steps, tests/modules_d.tcyr, below]
_w2W5_PK = 0x3FF000000006DF38;                                                  # 1 + 1e-10
assert_eq(_w2W5_zstep(F64_ONE, 0x3FF8000000000000), HSB_ERR_NO_CONVERGENCE,
  "z = s, g turns before a root -> refused");
assert_eq(load64(_w2W5_o), 0x7FF4000000000001, "z = s, g turns before a root -> out untouched");
assert_eq(_w2W5_N, 22, "z = s, g turns before a root -> 22 evaluations: f(s), the slope's 4, the continuation's 17");
assert_eq(_w2W5_zstep(0xBFF0000000000000, 0x3FF8000000000000), HSB_ERR_NO_CONVERGENCE,
  "z = s, g turns before a root, mirrored -> refused");
assert_eq(load64(_w2W5_o), 0x7FF4000000000001, "z = s, g turns before a root, mirrored -> out untouched");

# _ode_zslope's edges at the new scale and at z = s. f = 3y at z = 1 (g' = -2): on the path a falling first
# secant refuses alone; at z = s (onp = 0) the second is read too.
_w2W5_K = 0x4008000000000000;
_w2W5_N = 0;
assert_eq(_ode_zslope(&_w2W5_lin, 0, F64_ONE, 0x4008000000000000, F64_ONE, 0xBF50000000000000, 1), 0,
  "_ode_zslope: f = 3y, a move of 2^-10 on the path -> 0");
assert_eq(_w2W5_N, 1, "_ode_zslope: ... the first secant alone (1 evaluation)");
_w2W5_N = 0;
assert_eq(_ode_zslope(&_w2W5_lin, 0, F64_ONE, 0x4008000000000000, F64_ONE, 0xBF50000000000000, 0), 0,
  "_ode_zslope: f = 3y, z = s, the move 2^-10 -> 0");
assert_eq(_w2W5_N, 2, "_ode_zslope: ... no path behind s: both secants read (2 evaluations)");
# The first reach is 2^-26 |m| at z = 2^-30 on a move of 1 (path below): g' = 2 for 1.5 2^-27 below z, then -7, so
# the secant over 2^-26 falls (g' = -0.25, every value exact) and refuses on the path; over 2^-27 it would rise.
_w2W5_SG = F64_ONE;
_w2W5_ZK = 0xBE46000000000000;                                                  # -11 2^-30
_w2W5_S1 = 0x4020000000000000;                                                  # 8
_w2W5_S2 = 0xBFF0000000000000;
assert_eq(_w2W5_zs(0x3E10000000000000, 0xBFF0000000000000), 0,
  "_ode_zslope: z = 2^-30, a move of 1, g turns 1.5 2^-27 into the path -> 0, read over 2^-26 |m|");
assert_eq(_w2W5_N, 1, "_ode_zslope: ... the first secant alone (1 evaluation)");
# A move of 3/4 of hc = 2^-26: the first secant reaches past s, so it does not refuse alone.
_w2W5_N = 0;
assert_eq(_ode_zslope(&_w2W5_lin, 0, F64_ONE, 0x4008000000000000, F64_ONE, 0xBE48000000000000, 1), 0,
  "_ode_zslope: f = 3y, a move of 0.75 2^-26 -> 0");
assert_eq(_w2W5_N, 2, "_ode_zslope: ... hc past s, both secants read (2 evaluations)");
# z = s with |c f(s)| = 2 > |s| = 1: hc = hf = 2^-25, so the first secant ahead decides where the two disagree.
# f = 2 - (y - 1) up to 1 and 2 + 3 (y - 1) past it: g' = 2 behind, -2 ahead.
_w2W5_SG = F64_ONE;
_w2W5_PA = 0x4000000000000000;
_w2W5_PS1 = 0xBFF0000000000000;
_w2W5_PS2 = 0x4008000000000000;
_w2W5_PK = F64_ONE;
_w2W5_N = 0;
assert_eq(_ode_zslope(&_w2W5_pw, 0, F64_ONE, 0x4000000000000000, F64_ONE, 0x4000000000000000, 0), 0,
  "_ode_zslope: z = s, |m| > |s|, g falls ahead and rises behind -> 0, no finer step");
assert_eq(_w2W5_N, 2, "_ode_zslope: ... 2 evaluations");
# The first secant unread (f infinite past z at 2^-26, 2^-52 and 2^-78 of it), the second rising: 1 at once.
fn _w2W5_wh(t, y) {
    _w2W5_N = _w2W5_N + 1;
    if (f64_lt(F64_ONE, y) == 1) { return F64_POS_INF; }
    return f64_mul(F64_HALF, y);
}
_w2W5_N = 0;
assert_eq(_ode_zslope(&_w2W5_wh, 0, F64_ONE, F64_HALF, F64_ONE, F64_HALF, 1), 1,
  "_ode_zslope: the first secant unread, the second rising -> 1");
assert_eq(_w2W5_N, 4, "_ode_zslope: ... no finer reading (4 evaluations: 3 unread, 1)");
# _ode_gsec at g' = 2^-25, between the margin's 2^-24 (1 + |c f_y|) and 2^-26 (1 + |c f_y|).
_w2W5_K = 0x3FEFFFFFF0000000;                                                   # 1 - 2^-25
assert_eq(_ode_gsec(&_w2W5_lin1, 0, F64_ONE, 0, F64_ONE, 0x3E50000000000000), 0,
  "_ode_gsec: g' = 2^-25, under 2^-24 (1 + |c f_y|) -> not resolved, 0");

# z = s where g rises over hc ahead and falls behind: the reading over hf ahead decides, with no Newton step. BDF-2
# from 1 (c = 1, tol 1e-6) on f = 1e-7 + 1.005 (y - 1) behind 1, 1e-7 - 99 (y - 1) up to K = 1 + 1e-11, and slope
# 0.99 past K: g' = -0.005 behind, 100, then 0.01. g rises from -1e-7 through the branch's root at 1 + 9.90001e-6,
# nearer than the root behind at 1 - 2e-5, so 1 is right; Newton's step at g' = 100 lands where g is -9.9e-8.
# [measured: exact roots in Fractions over these doubles (scratch w5p orc.py); the steps, tests/modules_d.tcyr, below]
fn _w2W5_p3(t, y) {
    _w2W5_N = _w2W5_N + 1;
    var u = f64_sub(y, F64_ONE);
    if (f64_lt(u, 0) == 1) { return f64_add(0x3E7AD7F29ABCAF48, f64_mul(0x3FF0147AE147AE14, u)); }
    if (f64_le(u, 0x3DA5FD7FE1796495) == 1) { return f64_add(0x3E7AD7F29ABCAF48, f64_mul(0xC058C00000000000, u)); }
    var fk = f64_add(0x3E7AD7F29ABCAF48, f64_mul(0xC058C00000000000, 0x3DA5FD7FE1796495));
    return f64_add(fk, f64_mul(0x3FEFAE147AE147AE, f64_sub(u, 0x3DA5FD7FE1796495)));
}
_w2W5_N = 0;
store64(_w2W5_o, 0x7FF4000000000001);
var _w2W5_t3p, _w2W5_v3p = ode_bdf2_checked(&_w2W5_p3, 0, F64_ONE, F64_ONE, 0x3FF8000000000000, 0x3EB0C6F7A0B5ED8D,
  _w2W5_o);
assert_eq(is_ok(_w2W5_t3p), 1, "z = s, g rises over hc ahead and falls behind -> Ok");
assert_eq(load64(_w2W5_o), F64_ONE, "z = s, g rises over hc ahead and falls behind -> the predictor 1");
assert_eq(_w2W5_N, 4, "z = s, g rises over hc ahead and falls behind -> 4 evaluations: f(s), two secants, hf");

# The same root and turn ahead of 1 as above, with g' = 1 behind 1 (f = 1e-7 behind it): the reading over hf is
# taken ahead, along c f(s), where g' = 100, so Newton's step lands on the root; read behind (g' = 1) it would land
# 1e-7 ahead, past the turn. Both orientations.
# [measured: exact roots in Fractions over these doubles (scratch w5p orc.py); the steps, tests/modules_d.tcyr, below]
fn _w2W5_q3(t, y) {
    _w2W5_N = _w2W5_N + 1;
    var yy = f64_mul(_w2W5_SG, y);
    if (f64_lt(yy, F64_ONE) == 1) { return f64_mul(_w2W5_SG, 0x3E7AD7F29ABCAF48); }
    _w2W5_N = _w2W5_N - 1;
    return _w2W5_pw(t, y);
}
_w2W5_PA = 0x3E7AD7F29ABCAF48;
_w2W5_PS1 = 0xC058C00000000000;
_w2W5_PS2 = 0x408F400000000000;
_w2W5_PK = 0x3FF00000005CC573;
_w2W5_sg = 0;
while (_w2W5_sg < 2) {
    _w2W5_SG = F64_ONE;
    if (_w2W5_sg == 1) { _w2W5_SG = 0xBFF0000000000000; }
    _w2W5_N = 0;
    store64(_w2W5_o, 0x7FF4000000000001);
    var _w2W5_tq, _w2W5_vq = ode_bdf2_checked(&_w2W5_q3, 0, _w2W5_SG, _w2W5_SG, 0x3FF8000000000000, 0x3EB0C6F7A0B5ED8D,
      _w2W5_o);
    assert_eq(load64(_w2W5_o), _w2W5_SG, "z = s, g' = 1 behind s, the root before g turns ahead -> Ok at s");
    assert_eq(_w2W5_N, 5, "z = s, g' = 1 behind s -> 5 evaluations");
    _w2W5_sg = _w2W5_sg + 1;
}
_w2W5_SG = F64_ONE;

# _ode_sfirst(f, t, s, f(s), c, m, hf) directly: f as _w2W5_pw, c = 1, so m = f(s) = SG PA at s = SG 1.
fn _w2W5_sf(sg, hf) {
    _w2W5_SG = sg;
    var m = f64_mul(sg, _w2W5_PA);
    _w2W5_N = 0;
    return _ode_sfirst(&_w2W5_pw, 0, sg, m, F64_ONE, m, hf);
}
# g(s) = -2^-40, 2^12 ulps of s, and g' = 2^14: Newton's step, 2^-54, rounds onto s, which is then the double
# nearest the root (g(q) read at s would be g(s) itself, not halfway to 0).
_w2W5_PK = 0x4000000000000000;                                                  # no kink before 2
_w2W5_PA = 0x3D70000000000000;                                                  # 2^-40
_w2W5_PS1 = 0xC0CFFF8000000000;                                                 # -16383: g' = 2^14
assert_eq(_w2W5_sf(F64_ONE, 0x3CB0000000000000), 1, "_ode_sfirst: Newton's step 2^-54 rounds onto s -> 1");
assert_eq(_w2W5_N, 1, "_ode_sfirst: ... f(q) not read (1 evaluation)");
_w2W5_PA = 0x3F50000000000000;                                                  # 2^-10
_w2W5_PK = 0x3FF0010000000000;                                                  # 1 + 2^-12
# Over hf = 2^-36, g' = 2: q = s + 2^-11, past the kink. Each case in both orientations.
_w2W5_sg = 0;
while (_w2W5_sg < 2) {
    var _w2W5_ss = F64_ONE;
    if (_w2W5_sg == 1) { _w2W5_ss = 0xBFF0000000000000; }
    # g' = 0 past the kink: g(q) = -2^-11, exactly halfway from g(s) = -2^-10.
    _w2W5_PS1 = 0xBFF0000000000000;
    _w2W5_PS2 = F64_ONE;
    assert_eq(_w2W5_sf(_w2W5_ss, 0x3DB0000000000000), 1, "_ode_sfirst: g(q) exactly halfway to 0 -> 1");
    assert_eq(_w2W5_N, 2, "_ode_sfirst: ... 2 evaluations");
    # g' = -2^-8 past the kink: g(q) = -(2^-11 + 2^-20), short of halfway.
    _w2W5_PS2 = 0x3FF0100000000000;                                             # 1 + 2^-8
    assert_eq(_w2W5_sf(_w2W5_ss, 0x3DB0000000000000), 0, "_ode_sfirst: g(q) short of halfway -> 0");
    # g' = 1 up to the kink and 10 past it: g(q) = 27 2^-12, past 0 by more than |g(s)| / 2.
    _w2W5_PS1 = 0;
    _w2W5_PS2 = 0xC022000000000000;                                             # -9
    assert_eq(_w2W5_sf(_w2W5_ss, 0x3DB0000000000000), 1, "_ode_sfirst: g(q) past 0 -> 1");
    _w2W5_sg = _w2W5_sg + 1;
}
# f NaN past the kink: g(q) is NaN -> 0.
_w2W5_PS1 = 0xBFF0000000000000;
_w2W5_PS2 = 0x7FF8000000000000;
assert_eq(_w2W5_sf(F64_ONE, 0x3DB0000000000000), 0, "_ode_sfirst: f(q) NaN -> 0");
# The reading over hf falls (g' = -2): 0 before q is read.
_w2W5_PS1 = 0x4008000000000000;
assert_eq(_w2W5_sf(F64_ONE, 0x3DB0000000000000), 0, "_ode_sfirst: g falls at s over hf -> 0");
assert_eq(_w2W5_N, 1, "_ode_sfirst: ... 1 evaluation");
_w2W5_SG = F64_ONE;
# No finite difference over hf: nothing is read, 1. And c f_y = -Inf (g' = +Inf): 1.
_w2W5_N = 0;
assert_eq(_ode_sfirst(&_w2W5_wh, 0, F64_ONE, F64_HALF, F64_ONE, F64_HALF, 0x3E40000000000000), 1,
  "_ode_sfirst: no finite difference over hf -> 1");
assert_eq(_w2W5_N, 3, "_ode_sfirst: ... 3 evaluations");
_w2W5_K = 0xFE37E43C8800759C;                                                   # -1e300
var _w2W5_ci = 0x4202A05F20000000;                                              # 1e10
assert_eq(_ode_sfirst(&_w2W5_lin, 0, F64_ONE, _w2W5_K, _w2W5_ci, 0x3F50000000000000, 0x3DB0000000000000), 1,
  "_ode_sfirst: c f_y = 1e10 (-1e300) = -Inf -> 1");

# ==================================================================================================
# 3.5.0 wave 2 — autodiff misses and cut edges; the memo walks (autodiff, symbolic)
# ==================================================================================================
# (Written as tests/w2_W6.tcyr; every global and fn below is prefixed _w2W6_.)

# ==================================================================================================
# 3.5.0 W6 — autodiff: a power with no real function behind it is a domain miss
# ==================================================================================================
# Roadmap [3.5.0], "Autodiff answers with no real function behind them" (SYM4 F3, F4). The expected
# values are IEEE facts or closed forms: _AD_NAN is the miss's NaN pattern, pow(-0, 1.5) = +0,
# pow(NaN, 0) = 1, pow(+0, -0.5) = +Inf, 1.5 * (2^-1074)^0.5 = 1.5 * 2^-537 exactly.
test_group("3.5.0 W6: a power with no real function is a miss");
var _w2W6_NAN = 0x7FF8000000000A0D;    # _AD_NAN, the moving miss's NaN: bits, not a value
var _w2W6_HALF = 0x3FE0000000000000;   # 0.5
var _w2W6_T15 = 0x3FF8000000000000;    # 1.5
var _w2W6_MONE = 0xBFF0000000000000;   # -1
var _w2W6_E200 = 0x16687E92154EF7AC;   # 1e-200
var _w2W6_P200 = 0x6974E718D7D7625A;   # 1e200, the correctly rounded 1 / 1e-200
# d(root)/d(x) on t after one sweep from r.
fn _w2W6_tg(t, r, x) {
    var gt, gv = ad_grad(t, r);
    return ad_grad_of(t, x);
}
# (-|x|)^1.5 is a real function at x = 0 alone: 3.4.2 read -0 in both modes.
var _w2W6_p1 = dual_pow(dual_neg(dual_abs(dual_var(0))), _w2W6_T15);
assert_eq(Dual_val(_w2W6_p1), 0, "forward: (-|x|)^1.5 at 0, value pow(-0, 1.5) = +0");
assert_eq(Dual_deriv(_w2W6_p1), _w2W6_NAN, "forward: (-|x|)^1.5 at 0 -> the miss's NaN (3.4.2: -0)");
var _w2W6_t = ad_tape_new(64);
var _w2W6_x = ad_var(_w2W6_t, 0);
var _w2W6_r = ad_pow(_w2W6_t, ad_neg(_w2W6_t, ad_abs(_w2W6_t, _w2W6_x)), _w2W6_T15);
assert_eq(ad_val(_w2W6_t, _w2W6_r), 0, "tape: the same value");
assert_eq(_ad_tainted(_ad_node(_w2W6_t, _w2W6_r)), 1, "tape: the power is a miss, marked");
assert_eq(_w2W6_tg(_w2W6_t, _w2W6_r, _w2W6_x), _w2W6_NAN, "tape: (-|x|)^1.5 at 0 -> NaN (3.4.2: -0)");
# The stated cost: x^1.5 at 0 (right derivative 0) and (x^2)^1.5 = |x|^3 at 0 (derivative 0) are misses
# too; x^0.5 at 0 now reads as sqrt(x) at 0 (3.4.2: +Inf beside sqrt's NaN); x^-0.5 keeps pow's +Inf.
assert_eq(Dual_deriv(dual_pow(dual_var(0), _w2W6_T15)), _w2W6_NAN, "forward: x^1.5 at 0 -> NaN (3.4.2: -0)");
assert_eq(Dual_deriv(dual_pow(dual_var(0x8000000000000000), _w2W6_T15)), _w2W6_NAN, "forward: x^1.5 at -0 -> NaN");
var _w2W6_xx = dual_var(0);
assert_eq(Dual_deriv(dual_pow(dual_mul(_w2W6_xx, _w2W6_xx), _w2W6_T15)), _w2W6_NAN,
  "forward: (x^2)^1.5 at 0 -> NaN, the stated cost (3.4.2: -0)");
assert_eq(Dual_deriv(dual_pow(dual_var(0), _w2W6_HALF)), Dual_deriv(dual_sqrt(dual_var(0))),
  "forward: x^0.5 at 0 reads as sqrt(x) at 0");
assert_eq(Dual_deriv(dual_pow(dual_var(0), _w2W6_HALF)), _w2W6_NAN, "forward: ... the miss's NaN (3.4.2: +Inf)");
var _w2W6_p2 = dual_pow(dual_var(0), 0xBFE0000000000000);
assert_eq(Dual_val(_w2W6_p2), 0x7FF0000000000000, "forward: x^-0.5 at 0, value pow's +Inf");
assert_eq(Dual_deriv(_w2W6_p2), _w2W6_NAN, "forward: ... and the miss's NaN (3.4.2: -Inf)");
# x^NaN at 0: pow(0, NaN) is a NaN value, which the 3.4.0 rule gives an ordinary NaN, not the miss's.
var _w2W6_p3 = dual_pow(dual_var(0), 0x7FF8000000000000);
assert_eq(f64_eq(Dual_val(_w2W6_p3), Dual_val(_w2W6_p3)), 0, "forward: x^NaN at 0, value pow(0, NaN): NaN");
assert_eq(f64_eq(Dual_deriv(_w2W6_p3), Dual_deriv(_w2W6_p3)), 0, "forward: ... tangent NaN");
assert_eq(_ad_missed(Dual_deriv(_w2W6_p3)), 0, "forward: ... an ordinary NaN: a NaN value is no miss");
ad_tape_reset(_w2W6_t);
_w2W6_x = ad_var(_w2W6_t, 0);
_w2W6_r = ad_pow(_w2W6_t, _w2W6_x, _w2W6_T15);
assert_eq(_w2W6_tg(_w2W6_t, _w2W6_r, _w2W6_x), _w2W6_NAN, "tape: x^1.5 at 0 -> NaN (3.4.2: +0)");
ad_tape_reset(_w2W6_t);
_w2W6_x = ad_var(_w2W6_t, 0);
_w2W6_r = ad_pow(_w2W6_t, _w2W6_x, 0x7FF8000000000000);
assert_eq(_ad_tainted(_ad_node(_w2W6_t, _w2W6_r)), 0, "tape: x^NaN at 0 is no miss, not marked");
var _w2W6_g0 = _w2W6_tg(_w2W6_t, _w2W6_r, _w2W6_x);
assert_eq(f64_eq(_w2W6_g0, _w2W6_g0), 0, "tape: x^NaN at 0, d/dx NaN");
assert_eq(_ad_missed(_w2W6_g0), 0, "tape: ... an ordinary NaN, as forward");
# What stays: an integer power at a zero base, a positive base however small, a constant base.
assert_eq(Dual_deriv(dual_pow(dual_var(0), 0x4008000000000000)), 0x8000000000000000,
  "forward: x^3 at 0 -> -0, a moving zero, not a miss");
assert_eq(Dual_deriv(dual_pow(dual_var(0x8000000000000000), F64_TWO)), 0x8000000000000000,
  "forward: x^2 at -0 -> -0, not a miss");
ad_tape_reset(_w2W6_t);
_w2W6_x = ad_var(_w2W6_t, 0);
_w2W6_r = ad_pow(_w2W6_t, _w2W6_x, 0x4008000000000000);
assert_eq(_w2W6_tg(_w2W6_t, _w2W6_r, _w2W6_x), 0, "tape: x^3 at 0 -> +0 (IEEE's sign), not a miss");
ad_tape_reset(_w2W6_t);
_w2W6_x = ad_var(_w2W6_t, 0x4010000000000000);
_w2W6_r = ad_pow(_w2W6_t, _w2W6_x, _w2W6_T15);
assert_eq(_w2W6_tg(_w2W6_t, _w2W6_r, _w2W6_x), 0x4008000000000000, "tape: x^1.5 at 4 -> 3, not a miss");
assert_eq(Dual_deriv(dual_pow(dual_var(1), _w2W6_T15)), 0x1E68000000000000,
  "forward: x^1.5 at 2^-1074 -> 1.5 * 2^-537, exact: a positive base is no miss");
assert_eq(Dual_deriv(dual_pow(dual_var(0x4010000000000000), _w2W6_T15)), 0x4008000000000000,
  "forward: x^1.5 at 4 -> 3");
assert_eq(Dual_deriv(dual_pow(dual_const(0), _w2W6_T15)), 0, "forward: (const 0)^1.5 is a constant: +0");
ad_tape_reset(_w2W6_t);
_w2W6_r = ad_pow(_w2W6_t, ad_const(_w2W6_t, 0), _w2W6_T15);
assert_eq(_ad_isk(_ad_node(_w2W6_t, _w2W6_r)), 1, "tape: (const 0)^1.5 records a constant");
# x^0 of a base with no value: (x^0.5)^0 at -0.5 read the constant 1 through pow(NaN, 0) = 1.
var _w2W6_p4 = dual_pow(dual_pow(dual_var(0xBFE0000000000000), _w2W6_HALF), 0);
assert_eq(Dual_val(_w2W6_p4), F64_ONE, "forward: (x^0.5)^0 at -0.5, value pow(NaN, 0) = 1");
assert_eq(Dual_deriv(_w2W6_p4), _w2W6_NAN, "forward: ... and the miss's NaN (3.4.2: +0, the constant 1)");
assert_eq(Dual_deriv(dual_mul(dual_const(0), _w2W6_p4)), _w2W6_NAN,
  "forward: 0 (x^0.5)^0 at -0.5: a constant zero does not cut it (3.4.2: +0)");
var _w2W6_p5 = dual_pow(dual_var(0xBFE0000000000000), _w2W6_HALF);
assert_eq(f64_eq(Dual_val(_w2W6_p5), Dual_val(_w2W6_p5)), 0, "forward: x^0.5 at -0.5 has no value: NaN, as before");
assert_eq(_ad_missed(Dual_deriv(_w2W6_p5)), 0, "forward: ... and the machine's NaN tangent, not a miss");
assert_eq(Dual_deriv(dual_pow(dual_var(F64_TWO), 0)), 0, "forward: x^0 at 2 is the constant 1: +0");
assert_eq(Dual_deriv(dual_pow(dual_var(0), 0)), 0, "forward: x^0 at 0 too: 0 has a value");
ad_tape_reset(_w2W6_t);
_w2W6_x = ad_var(_w2W6_t, 0xBFE0000000000000);
_w2W6_r = ad_pow(_w2W6_t, ad_pow(_w2W6_t, _w2W6_x, _w2W6_HALF), 0);
assert_eq(ad_val(_w2W6_t, _w2W6_r), F64_ONE, "tape: (x^0.5)^0 at -0.5, value 1");
assert_eq(load64(_ad_node(_w2W6_t, _w2W6_r) + 8), _w2W6_NAN, "tape: its partial is the miss's NaN");
assert_eq(_w2W6_tg(_w2W6_t, _w2W6_r, _w2W6_x), _w2W6_NAN, "tape: d/dx is the miss's NaN (3.4.2: +0)");
ad_tape_reset(_w2W6_t);
_w2W6_x = ad_var(_w2W6_t, F64_TWO);
_w2W6_r = ad_pow(_w2W6_t, _w2W6_x, 0);
assert_eq(_ad_isk(_ad_node(_w2W6_t, _w2W6_r)), 1, "tape: x^0 at 2 records the constant 1");

# ==================================================================================================
# 3.5.0 W6 — autodiff: the tape's per-input cut at a marked zero
# ==================================================================================================
# Roadmap [3.5.0], "A moving miss's NaN on the tape reaches an input it should not" (SYM5). At
# (y, z, x) = (0, 0, 1e-200), sqrt(y) is a moving miss along y and the constant 0 along z and x, and
# x^-1 has the slope -1e400 = -Inf. Forward mode, one seed per input, is the oracle: along x the
# constant zero cuts the product (+0); along y and z a miss is under it (the miss's NaN).
test_group("3.5.0 W6: a marked zero cuts its partner along the inputs it does not move with");
# kind 0: sqrt(y) (sqrt(z) + x^-1); 1: sqrt(y) / (sqrt(z) + x^-1); 2: sqrt(y) (sqrt(z) + (x^-1 - 1e200)),
# both factors zero; 3: (sqrt(y) + (x - 1e-200)) (sqrt(z) + x^-1), the zero moving along x; 4: kind 0
# from a root past 4,096; 5: kind 0 with a node the root does not reach, its edge out of order; 6
# and 7: kinds 0 and 3 with the factors swapped, the zero second; 8: kind 0 to the power 2/3, a miss
# at the root (a zero base), whose NaN the sweep sends down through the zero's edge; 9: kind 0 with
# a node the root does not reach that is marked, with two zero partials and edges a billion nodes
# past the tape (read, it faults); 10: kind 0 with a node the root does not reach whose cut would
# make x a variable not to cut, sqrt(x - 1e-200) (sqrt(z) + x). j: 0 y, 1 z, 2 x.
# [measured: tests/modules_d.tcyr, this group's assertions]
fn _w2W6_cut(kind, j) {
    var t = ad_tape_new(8192);
    if (kind == 4) {
        for (var i = 0; i < 4100; i = i + 1) { var c = ad_const(t, F64_ONE); }
    }
    var y = ad_var(t, 0);
    var z = ad_var(t, 0);
    var x = ad_var(t, _w2W6_E200);
    var a = ad_sqrt(t, y);
    if (kind == 3 || kind == 7) { a = ad_add(t, a, ad_sub(t, x, ad_const(t, _w2W6_E200))); }
    var u = ad_pow(t, x, _w2W6_MONE);
    if (kind == 2) { u = ad_sub(t, u, ad_const(t, _w2W6_P200)); }
    if (kind == 5) {
        var w = ad_sin(t, x);
        store64(_ad_node(t, w) + 24, w + 1);
    }
    if (kind == 9) {
        var w9 = ad_mul(t, ad_sqrt(t, y), ad_sqrt(t, z));
        store64(_ad_node(t, w9) + 24, _AD_MARK - 1000000000);
        store64(_ad_node(t, w9) + 32, 1000000001);
    }
    if (kind == 10) {
        var s10 = ad_sqrt(t, ad_sub(t, x, ad_const(t, _w2W6_E200)));
        var w10 = ad_mul(t, s10, ad_add(t, ad_sqrt(t, z), x));
    }
    var b = ad_add(t, ad_sqrt(t, z), u);
    var r = ad_mul(t, a, b);
    if (kind == 1) { r = ad_div(t, a, b); }
    if (kind == 6 || kind == 7) { r = ad_mul(t, b, a); }
    if (kind == 8) { r = ad_pow(t, r, 0x3FE5555555555555); }    # ^(2/3)
    var gt, gv = ad_grad(t, r);
    if (j == 0) { return ad_grad_of(t, y); }
    if (j == 1) { return ad_grad_of(t, z); }
    return ad_grad_of(t, x);
}
# The same programs forward, seeded along j.
fn _w2W6_cutf(kind, j) {
    var sy = 0;
    var sz = 0;
    var sx = 0;
    if (j == 0) { sy = F64_ONE; }
    if (j == 1) { sz = F64_ONE; }
    if (j == 2) { sx = F64_ONE; }
    var x = dual_new(_w2W6_E200, sx);
    var a = dual_sqrt(dual_new(0, sy));
    if (kind == 3 || kind == 7) { a = dual_add(a, dual_sub(x, dual_const(_w2W6_E200))); }
    var u = dual_pow(x, _w2W6_MONE);
    if (kind == 2) { u = dual_sub(u, dual_const(_w2W6_P200)); }
    var b = dual_add(dual_sqrt(dual_new(0, sz)), u);
    if (kind == 1) { return Dual_deriv(dual_div(a, b)); }
    if (kind == 6 || kind == 7) { return Dual_deriv(dual_mul(b, a)); }
    if (kind == 8) { return Dual_deriv(dual_pow(dual_mul(a, b), 0x3FE5555555555555)); }
    return Dual_deriv(dual_mul(a, b));
}
assert_eq(_w2W6_cutf(0, 2), 0, "forward: sqrt(y) (sqrt(z) + x^-1) along x: +0, the constant zero cuts");
assert_eq(_w2W6_cut(0, 2), 0, "tape: the same along x: +0 (3.4.2: NaN, 0 * -Inf)");
assert_eq(_w2W6_cutf(0, 0), _w2W6_NAN, "forward: along y, the miss's NaN");
assert_eq(_w2W6_cut(0, 0), _w2W6_NAN, "tape: along y, the miss's NaN");
assert_eq(_w2W6_cutf(0, 1), _w2W6_NAN, "forward: along z, b's miss under a constant zero: NaN");
assert_eq(_w2W6_cut(0, 1), _w2W6_NAN, "tape: along z: NaN, b's edge taken because b is a miss there");
assert_eq(_w2W6_cutf(1, 2), 0, "forward: sqrt(y) / (sqrt(z) + x^-1) along x: +0");
assert_eq(_w2W6_cut(1, 2), 0, "tape: the quotient along x: +0 (3.4.2: NaN)");
assert_eq(_w2W6_cut(1, 0), _w2W6_NAN, "tape: the quotient along y: NaN");
assert_eq(_w2W6_cut(1, 1), _w2W6_NAN, "tape: the quotient along z: NaN");
assert_eq(_w2W6_cutf(2, 2), 0, "forward: both factors zero, along x: +0");
assert_eq(_w2W6_cut(2, 2), 0, "tape: both factors zero, along x: +0 (3.4.2: NaN)");
assert_eq(_w2W6_cut(2, 0), _w2W6_NAN, "tape: both zero, along y: NaN");
assert_eq(_w2W6_cut(2, 1), _w2W6_NAN, "tape: both zero, along z: NaN");
var _w2W6_c3f = _w2W6_cutf(3, 2);
var _w2W6_c3t = _w2W6_cut(3, 2);
assert_eq(f64_eq(_w2W6_c3f, _w2W6_c3f), 0, "forward: the zero moving along x meets -Inf: NaN, not cut");
assert_eq(f64_eq(_w2W6_c3t, _w2W6_c3t), 0, "tape: the same, NaN: its edge is taken along x");
assert_eq(_w2W6_cutf(6, 2), 0, "forward: the factors swapped, along x: +0");
assert_eq(_w2W6_cut(6, 2), 0, "tape: the factors swapped, along x: +0 (3.4.2: NaN)");
assert_eq(_w2W6_cut(6, 1), _w2W6_NAN, "tape: the factors swapped, along z: NaN");
var _w2W6_c7 = _w2W6_cut(7, 2);
assert_eq(f64_eq(_w2W6_c7, _w2W6_c7), 0, "tape: swapped, the zero moving along x: NaN, not cut");
assert_eq(_w2W6_cutf(8, 2), 0, "forward: (sqrt(y) (sqrt(z) + x^-1))^(2/3) along x: +0, a constant's power");
assert_eq(_w2W6_cut(8, 2), 0, "tape: the same: +0, the root's miss NaN not taken (3.4.2: NaN)");
assert_eq(_w2W6_cutf(8, 0), _w2W6_NAN, "forward: ... along y: the miss's NaN");
assert_eq(_w2W6_cut(8, 0), _w2W6_NAN, "tape: ... along y: the miss's NaN");
var _w2W6_c4 = _w2W6_cut(4, 2);
assert_eq(f64_eq(_w2W6_c4, _w2W6_c4), 0, "tape: from a root past 4,096 the pass does not run: NaN (the stated step)");
assert_eq(_w2W6_cut(4, 0), _w2W6_NAN, "tape: ... the miss's NaN there along y");
# A node the root does not reach is not read, whatever it holds (the sweep checked only the nodes the
# root reaches): an edge out of order, edges past the tape, a cut that would change x's answer.
assert_eq(_w2W6_cut(5, 2), 0, "tape: a node out of order the root does not reach: not read, x cut (+0)");
assert_eq(_w2W6_cut(5, 0), _w2W6_NAN, "tape: ... and y keeps its NaN");
assert_eq(_w2W6_cut(9, 2), 0, "tape: a marked node with edges past the tape, not reached: not read, x +0");
assert_eq(_w2W6_cut(9, 1), _w2W6_NAN, "tape: ... z keeps its NaN");
assert_eq(_w2W6_cut(10, 2), 0, "tape: a cuttable node the root does not reach labels nothing: x +0");
# The pass answers for variables only: sin(x) at x = 2^-1074 under ln (slope 2^1074 = +Inf) keeps the
# sweep's 0 * Inf = NaN, the adjoint d(root)/d(sin x) through a zero, while x itself is cut (+0).
# [measured: tests/modules_d.tcyr, the two assertions below]
var _w2W6_t2 = ad_tape_new(64);
var _w2W6_y2 = ad_var(_w2W6_t2, 0);
var _w2W6_z2 = ad_var(_w2W6_t2, 0);
var _w2W6_x2 = ad_var(_w2W6_t2, 1);
var _w2W6_s2 = ad_sin(_w2W6_t2, _w2W6_x2);
var _w2W6_b2 = ad_add(_w2W6_t2, ad_sqrt(_w2W6_t2, _w2W6_z2), ad_ln(_w2W6_t2, _w2W6_s2));
var _w2W6_r2 = ad_mul(_w2W6_t2, ad_sqrt(_w2W6_t2, _w2W6_y2), _w2W6_b2);
assert_eq(_w2W6_tg(_w2W6_t2, _w2W6_r2, _w2W6_x2), 0, "tape: sqrt(y) (sqrt(z) + ln(sin x)) along x: +0");
var _w2W6_g2 = ad_grad_of(_w2W6_t2, _w2W6_s2);
assert_eq(f64_eq(_w2W6_g2, _w2W6_g2), 0, "tape: the node sin(x) keeps the sweep's NaN: not a variable");
# A miss through a quotient's second edge: sqrt(w) (x / y) at (0, 1, 0), x / y a miss in x and in y.
# Along y the miss is b's, through the divisor's edge, so the zero's partner is taken: NaN.
ad_tape_reset(_w2W6_t2);
var _w2W6_w3 = ad_var(_w2W6_t2, 0);
var _w2W6_x3 = ad_var(_w2W6_t2, F64_ONE);
var _w2W6_y3 = ad_var(_w2W6_t2, 0);
_w2W6_r2 = ad_mul(_w2W6_t2, ad_sqrt(_w2W6_t2, _w2W6_w3), ad_div(_w2W6_t2, _w2W6_x3, _w2W6_y3));
assert_eq(_w2W6_tg(_w2W6_t2, _w2W6_r2, _w2W6_y3), _w2W6_NAN, "tape: sqrt(w) (x / y) at y = 0 along y: NaN");
assert_eq(ad_grad_of(_w2W6_t2, _w2W6_x3), _w2W6_NAN, "tape: ... along x: NaN");
# The cut is a marked zero's (SYM5's rule): an unmarked zero, an ad_var at 0, still moves along every
# input on the tape (item (3) of the block above dual_div), here beside a cut that runs the pass.
ad_tape_reset(_w2W6_t2);
var _w2W6_y4 = ad_var(_w2W6_t2, 0);
var _w2W6_z4 = ad_var(_w2W6_t2, 0);
var _w2W6_x4 = ad_var(_w2W6_t2, _w2W6_E200);
var _w2W6_v4 = ad_var(_w2W6_t2, 0);
var _w2W6_b4 = ad_add(_w2W6_t2, ad_sqrt(_w2W6_t2, _w2W6_z4), ad_pow(_w2W6_t2, _w2W6_x4, _w2W6_MONE));
_w2W6_r2 = ad_add(_w2W6_t2, ad_mul(_w2W6_t2, ad_sqrt(_w2W6_t2, _w2W6_y4), _w2W6_b4),
  ad_mul(_w2W6_t2, _w2W6_v4, _w2W6_b4));
var _w2W6_g4 = _w2W6_tg(_w2W6_t2, _w2W6_r2, _w2W6_x4);
assert_eq(f64_eq(_w2W6_g4, _w2W6_g4), 0, "tape: + v (sqrt(z) + x^-1) at v = 0 along x: NaN, v moves (forward: 0)");
# A NaN that no cut made stays as the sweep left it, and an input's answer does not depend on a cut
# elsewhere. x = 1e300: d = x 1e-200 1e-200 1e200 1e200 and d2 = x (-1e-200) 1e-200 1e200 5e199, each
# factor a constant, have d(d + d2)/dx = 0.49999999999999994 (exact, then rounded), and the sweep's
# adjoints overflow (1e400) and meet as Inf - Inf: NaN. Forward mode's tangents underflow (1e-400)
# instead and answer 0, a wrong finite number. The first draft of the pass (a forward tangent per NaN
# input) replaced x's NaN by that 0 once a term in y and z alone, or a cut on x, was added.
fn _w2W6_rng(extra) {
    var t = ad_tape_new(128);
    var x = ad_var(t, 0x7E37E43C8800759C);    # 1e300
    var y = ad_var(t, 0);
    var z = ad_var(t, 0);
    var d = ad_mul(t, ad_mul(t, x, ad_const(t, _w2W6_E200)), ad_const(t, _w2W6_E200));
    d = ad_mul(t, ad_mul(t, d, ad_const(t, _w2W6_P200)), ad_const(t, _w2W6_P200));
    var d2 = ad_mul(t, ad_mul(t, x, ad_const(t, 0x96687E92154EF7AC)), ad_const(t, _w2W6_E200));    # -1e-200
    d2 = ad_mul(t, ad_mul(t, d2, ad_const(t, _w2W6_P200)), ad_const(t, 0x6964E718D7D7625A));    # 5e199
    var r = ad_add(t, d, d2);
    if (extra == 1) { r = ad_add(t, r, ad_mul(t, ad_sqrt(t, y), ad_add(t, ad_sqrt(t, z), ad_const(t, F64_ONE)))); }
    if (extra == 2) {
        var u = ad_pow(t, x, _w2W6_MONE);
        r = ad_add(t, r, ad_mul(t, ad_sqrt(t, y), ad_add(t, ad_sqrt(t, z), u)));
    }
    var gt, gv = ad_grad(t, r);
    return ad_grad_of(t, x);
}
var _w2W6_rg0 = _w2W6_rng(0);
assert_eq(f64_eq(_w2W6_rg0, _w2W6_rg0), 0, "fixture: d + d2 at 1e300 overflows in the sweep: NaN");
assert_eq(_w2W6_rng(1), _w2W6_rg0, "tape: + sqrt(y) (sqrt(z) + 1): x's NaN unchanged, bit for bit (first draft: 0)");
var _w2W6_rg2 = _w2W6_rng(2);
assert_eq(f64_eq(_w2W6_rg2, _w2W6_rg2), 0, "tape: + sqrt(y) (sqrt(z) + x^-1), a cut on x: the sweep's NaN (draft: 0)");
# A cut can leave a miss's NaN where the sweep left the machine's: sqrt(x - 1e-200) is a miss in x
# itself, recorded before x^-1, so the sweep adds x^-1's 0 * -Inf first and keeps its NaN. Forward
# mode answers the miss's NaN, and so does the cut.
fn _w2W6_mm(cut) {
    var t = ad_tape_new(64);
    var y = ad_var(t, 0);
    var z = ad_var(t, 0);
    var x = ad_var(t, _w2W6_E200);
    var s = ad_sqrt(t, ad_sub(t, x, ad_const(t, _w2W6_E200)));
    var u = ad_pow(t, x, _w2W6_MONE);
    var a = ad_const(t, 0);
    if (cut == 1) { a = ad_sqrt(t, y); }
    var r = ad_add(t, ad_mul(t, a, ad_add(t, ad_sqrt(t, z), u)), s);
    var gt, gv = ad_grad(t, r);
    return ad_grad_of(t, x);
}
var _w2W6_dmm = dual_new(_w2W6_E200, F64_ONE);
var _w2W6_fmm = dual_add(dual_mul(dual_const(0), dual_add(dual_const(0), dual_pow(_w2W6_dmm, _w2W6_MONE))),
  dual_sqrt(dual_sub(_w2W6_dmm, dual_const(_w2W6_E200))));
assert_eq(Dual_deriv(_w2W6_fmm), _w2W6_NAN,
  "forward: sqrt(y) (sqrt(z) + x^-1) + sqrt(x - 1e-200) along x: the miss's NaN");
assert_eq(_w2W6_mm(1), _w2W6_NAN, "tape: the same: the miss's NaN, the cut's (3.4.2: the machine's 0 * -Inf)");
assert_eq(_w2W6_mm(0), _w2W6_NAN, "tape: with a constant 0 for sqrt(y), a cut node: the miss's NaN");
# One edge whose zero partial is a constant's: 0 b, 0 / b, b 0, b^0 with b = sqrt(y) + x^-1 at
# (y, x) = (0, 1e-200). The constant zero never moves, so forward mode cuts b's term along every input
# b is not a miss on: +0 along x, the miss's NaN along y. The tape records a cut node (_AD_CUT_NODE).
fn _w2W6_one(kind, j) {
    var t = ad_tape_new(64);
    var y = ad_var(t, 0);
    var x = ad_var(t, _w2W6_E200);
    var b = ad_add(t, ad_sqrt(t, y), ad_pow(t, x, _w2W6_MONE));
    var r = ad_pow(t, b, 0);
    if (kind == 0) { r = ad_mul(t, ad_const(t, 0), b); }
    if (kind == 1) { r = ad_div(t, ad_const(t, 0), b); }
    if (kind == 2) { r = ad_mul(t, b, ad_const(t, 0x8000000000000000)); }
    if (j == 2) { return load64(_ad_node(t, r) + 32); }
    var gt, gv = ad_grad(t, r);
    if (j == 0) { return ad_grad_of(t, y); }
    return ad_grad_of(t, x);
}
fn _w2W6_onef(kind, j) {
    var sy = 0;
    var sx = 0;
    if (j == 0) { sy = F64_ONE; } else { sx = F64_ONE; }
    var b = dual_add(dual_sqrt(dual_new(0, sy)), dual_pow(dual_new(_w2W6_E200, sx), _w2W6_MONE));
    if (kind == 0) { return Dual_deriv(dual_mul(dual_const(0), b)); }
    if (kind == 1) { return Dual_deriv(dual_div(dual_const(0), b)); }
    if (kind == 2) { return Dual_deriv(dual_mul(b, dual_const(0x8000000000000000))); }
    return Dual_deriv(dual_pow(b, 0));
}
for (var _w2W6_k1 = 0; _w2W6_k1 < 4; _w2W6_k1 = _w2W6_k1 + 1) {
    assert_eq(_w2W6_one(_w2W6_k1, 2), _AD_CUT_NODE, "tape: 0 b, 0 / b, b (-0), b^0 with b marked: a cut node");
    assert_eq(_w2W6_onef(_w2W6_k1, 1), 0, "forward: ... along x: +0, the constant zero cuts");
    assert_eq(_w2W6_one(_w2W6_k1, 1), 0, "tape: ... along x: +0 (3.4.2: NaN, 0 * -Inf)");
    assert_eq(_w2W6_onef(_w2W6_k1, 0), _w2W6_NAN, "forward: ... along y: the miss's NaN");
    assert_eq(_w2W6_one(_w2W6_k1, 0), _w2W6_NAN, "tape: ... along y: the miss's NaN");
}
# A cut node is an edge and no second edge to both sweeps: past 4,096 nodes the uncompensated sweep
# takes it (an i2 of -4 was refused before cut nodes), and no cut is taken there.
# [measured: tests/modules_d.tcyr, the two assertions below]
var _w2W6_t5 = ad_tape_new(4200);
for (var _w2W6_i5 = 0; _w2W6_i5 < 4100; _w2W6_i5 = _w2W6_i5 + 1) { var _w2W6_c = ad_const(_w2W6_t5, F64_ONE); }
var _w2W6_y5 = ad_var(_w2W6_t5, 0);
var _w2W6_r5 = ad_mul(_w2W6_t5, ad_const(_w2W6_t5, 0), ad_add(_w2W6_t5, ad_sqrt(_w2W6_t5, _w2W6_y5), _w2W6_y5));
var _w2W6_gt5, _w2W6_gv5 = ad_grad(_w2W6_t5, _w2W6_r5);
assert_eq(_w2W6_gt5, 0, "tape: a cut node at index 4,100: the uncompensated sweep answers Ok");
assert_eq(ad_grad_of(_w2W6_t5, _w2W6_y5), _w2W6_NAN, "tape: ... y's miss through it: NaN");
# THE STATED LIMIT: an input under one edge to cut and one not keeps the sweep's NaN. sqrt(v) + sin x
# - sin x is a marked zero that moves along x (tangent -0), so its partner's edge is taken along x;
