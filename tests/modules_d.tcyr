assert_eq(f64_eq(_w2W6_g6b, _w2W6_g6b), 0, "tape: x under a cut and an edge it moves: NaN (the stated limit)");
var _w2W6_dx6 = dual_new(_w2W6_E200, F64_ONE);
var _w2W6_ds6 = dual_sin(_w2W6_dx6);
var _w2W6_fe6 = dual_mul(dual_sub(dual_add(dual_const(0), _w2W6_ds6), _w2W6_ds6), dual_add(dual_const(0), _w2W6_dx6));
var _w2W6_fb6 = dual_mul(dual_const(0), dual_add(dual_const(0), dual_pow(_w2W6_dx6, _w2W6_MONE)));
