# (spread2 seed 1 row 5313: exact 0x3FEF4CE6EA92E60F; 3.4.2 and base 0x3FEF4CB2C2C359F8, 224006212630.58 ulp)
var _w2W2_i_r = _w2W2_ray(0x68FBF12BE3FA0BDE, 0x7BF461B814D75036, 0x479D58C5686F3C7A, 0x7B58191724003585,
