  "d . u past DBL_MAX, a capsule 2^-499 of its radius long: 0.42 ulp");
assert_eq(load64(_w2W2_br), GEO_CAP_START_CAP, "... the start cap (3.4.2 and base: the barrel) (spread2 5313)");
# (spread2 seed 1 row 1269: exact 0x400996CC731F2583; 3.4.2 and base 0x400996CC731F2584, 1.13 ulp)
