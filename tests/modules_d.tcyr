# tests/modules_d.tcyr's seam for EPA's cap (_epa_refine's last argument) read the cap from the depth: two rounds
# gave 0.5 + 13 ulp and 64 the exact 0.5. The deep snap now closes the two-round answer to 0.5 as well, so the cap is
# read from the path: after two rounds the certificate is open and the answer goes to the polish (654 support
# calls), after 64 it closes (6 calls).
# [measured: scratch W3 seam.cyr, this tree; 2026-11-14]
var _w2W3_kb1 = _w2W3_w8b(0, 0, 0, F64_ONE, F64_TWO, 0x4008000000000000);
var _w2W3_kb2 = _w2W3_w8b(0x3FF8000000000000, F64_ONE, F64_HALF, F64_ONE, F64_ONE, F64_ONE);
var _w2W3_ks4 = alloc(32);
_epa_seed_portal(&_w2W3_sup_box, _w2W3_kb1, &_w2W3_sup_box, _w2W3_kb2, _w2W3_ks4);
var _w2W3_pc = _GA_EPA_POLISH_COUNT;
_epa_refine(&_w2W3_sup_box, _w2W3_kb1, &_w2W3_sup_box, _w2W3_kb2, _w2W3_ks4, _w2W3_n, _w2W3_d, 2);
assert_eq(_GA_EPA_POLISH_COUNT - _w2W3_pc, 1, "_epa_refine: cap 2 leaves the certificate open, the polish answers");
_w2W3_pc = _GA_EPA_POLISH_COUNT;
_epa_refine(&_w2W3_sup_box, _w2W3_kb1, &_w2W3_sup_box, _w2W3_kb2, _w2W3_ks4, _w2W3_n, _w2W3_d, EPA_MAX_ITER);
assert_eq(_GA_EPA_POLISH_COUNT - _w2W3_pc, 0, "_epa_refine: cap EPA_MAX_ITER closes it");

