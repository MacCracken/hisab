  "1/8 .. 1/4 of the axis, hit from outside (base 0.66, a lucky rounding): 1.66 ulp");
assert_eq(load64(_w2W2_br), GEO_CAP_CYLINDER, "... on the barrel (mixed 1171)");

# ==================================================================================================
test_group("3.5.0 W2: capsule rays the float path cannot place, solved exactly");
